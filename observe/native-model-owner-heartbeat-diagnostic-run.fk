; native-model-owner-heartbeat-diagnostic-run.fk — bounded framebuffer
; exchanges for the owner-heartbeat crossing.
;
; Payloads are numeric state codes and source-presence bits only.
;
; preludes: form/form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn nmohd-has (path needle)
        (if (ge (str_find (read_file path) needle 0) 0) 1 0))
    (defn nmohd-apply-revise (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound)
                                 (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    (framebuffer-clear)

    ; 4301: the live probe named a nonexistent telemetry reader.
    ; 4302: it uses the membrane's actual current-snapshot read door.
    (let outbound (bfc-envelope 0 90401 0 4301 4302))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let applied (nmohd-apply-revise outbound inbound 4301 4302))
    (let read-reobserved (if (eq applied 4302)
        (nmohd-has "observe/native-model-owner-heartbeat-live-run.fk"
            "fgtm-read-current") 0))
    (let outbound2 (bfc-envelope 0 90402 0 read-reobserved 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))

    ; 4311: a declarative high-grammar interface was invoked as a Form
    ; executable. 4312 selects its executable section [form.bml] body.
    (let outbound3 (bfc-envelope 0 90403 0 4311 4312))
    (let out-event3 (bfc-record-out outbound3 5))
    (let inbound3 (bfc-control outbound3 2))
    (let in-event3 (bfc-record-in inbound3 6))
    (let applied3 (nmohd-apply-revise outbound3 inbound3 4311 4312))
    (let path-reobserved (if (eq applied3 4312)
        (if (and
            (eq (nmohd-has
                "form/form-stdlib/bml/native-model-dual-telemetry.bml"
                "section [form.bml]") 0)
            (eq (nmohd-has
                "form/form-stdlib/native-model-dual-telemetry.bml"
                "section [form.bml]") 1)) 1 0) 0))
    (let outbound4 (bfc-envelope 0 90404 0 path-reobserved 0))
    (let out-event4 (bfc-record-out outbound4 7))
    (let inbound4 (bfc-control outbound4 0))
    (let in-event4 (bfc-record-in inbound4 8))

    ; 4321: malformed self identity could reach model open.
    ; 4322: positive PID correlation gates both model opens.
    (let outbound5 (bfc-envelope 0 90405 0 4321 4322))
    (let out-event5 (bfc-record-out outbound5 9))
    (let inbound5 (bfc-control outbound5 2))
    (let in-event5 (bfc-record-in inbound5 10))
    (let applied5 (nmohd-apply-revise outbound5 inbound5 4321 4322))
    (let resident-source
        (read_file "observe/native-model-dual-resident-live-run.fk"))
    (let pid-at (str_find resident-source
        "owner-pid-unavailable-before-model-open" 0))
    (let open-at (str_find resident-source
        "(let slot (q4s-open prefix 128))" 0))
    (let gate-reobserved (if (eq applied5 4322)
        (if (and (ge pid-at 0) (gt open-at pid-at)) 1 0) 0))
    (let outbound6 (bfc-envelope 0 90406 0 gate-reobserved 0))
    (let out-event6 (bfc-record-out outbound6 11))
    (let inbound6 (bfc-control outbound6 0))
    (let in-event6 (bfc-record-in inbound6 12))

    ; 4331: a foreign-dialect `if not(eq(...))` reached the direct Form owner.
    ; 4332: the predicate is a normal parenthesized Form call and can compile
    ; before any model mapping is attempted.
    (let outbound7 (bfc-envelope 0 90407 0 4331 4332))
    (let out-event7 (bfc-record-out outbound7 13))
    (let inbound7 (bfc-control outbound7 2))
    (let in-event7 (bfc-record-in inbound7 14))
    (let applied7 (nmohd-apply-revise outbound7 inbound7 4331 4332))
    (let syntax-reobserved (if (eq applied7 4332)
        (if (and
            (eq (nmohd-has
                "observe/native-model-dual-resident-live-run.fk"
                "(if not(eq(nmdt-owner-correlation?") 0)
            (eq (nmohd-has
                "observe/native-model-dual-resident-live-run.fk"
                "(if (not (eq (nmdt-owner-correlation? correlation) 1))") 1))
            1 0) 0))
    (let outbound8 (bfc-envelope 0 90408 0 syntax-reobserved 0))
    (let out-event8 (bfc-record-out outbound8 15))
    (let inbound8 (bfc-control outbound8 0))
    (let in-event8 (bfc-record-in inbound8 16))

    (list "native-model-owner-heartbeat-diagnostic"
        "reader" 4301 "applied" applied "reobserved" read-reobserved
        "path" 4311 "applied" applied3 "reobserved" path-reobserved
        "gate" 4321 "applied" applied5 "reobserved" gate-reobserved
        "syntax" 4331 "applied" applied7 "reobserved" syntax-reobserved
        "framebuffer-events" (len (framebuffer-events))))
