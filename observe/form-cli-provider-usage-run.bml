// stdin: owned thread ID, owned turn ID, captured App Server stdout path.
// Emits only usage and source coordinates, never prompt or answer text.
// preludes: form-stdlib/bml/form-cli-provider-notification.bml
section [form.bml] {
 let thread = read_line(); let turn = read_line(); let path = read_line();
 print_str(json-emit(fpn-read(path,thread,turn)));
 0;
}
