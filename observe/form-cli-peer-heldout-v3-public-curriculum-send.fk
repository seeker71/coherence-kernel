; form-cli-peer-heldout-v3-public-curriculum-send.fk — one held-out question
; through a public BML context.  The context is an observable in-context
; adaptation only; it never claims a gradient, a fused weight, or source RAG.
;
; stdin: task spool, fifo bell, turn, held-out row id.
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk
; preludes: form-stdlib/bml/form-cli-public-curriculum-transfer.bml

(do
    (defn fch3p-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn fch3p-int (name value) (fch3p-line name (int_to_str value)))
    (defn fch3p-refusal (reason)
        (do (fch3p-line "signal" "choice") (fch3p-line "reason" reason) 0))
    (defn fch3p-send (spool bell turn row-id)
        (do
            (let rows (fkh3-rows))
            (let row (fkh3-find-row row-id rows))
            (if (not (str_eq (fkh3-dataset-sha256 rows) (fkh3-dataset-seal)))
                (fch3p-refusal "heldout-dataset-seal-mismatch")
                (if (eq (fkh3-row? row) 0)
                    (fch3p-refusal "heldout-row-absent")
                    (if (eq (fkh3-row-current? row) 0)
                        (fch3p-refusal "heldout-row-stale")
                        (if (le turn 0)
                            (fch3p-refusal "turn-not-positive")
                            (do
                                (let task (fcpt-prompt (fkh3-prompt row)))
                                (if (nothing? task)
                                    (fch3p-refusal "public-context-task-absent")
                                    (do
                                        (let frame (str_concat
                                            (fcpa-task-frame turn "direct-answer" task) "\n"))
                                        (let appended (sbt-append spool frame))
                                        (if (lt appended 0)
                                            (fch3p-refusal "task-append-refused")
                                            (do
                                                (let rung (sbt-ring bell))
                                                (fch3p-line "signal" (if (lt rung 0) "choice" "value"))
                                                (fch3p-line "reason" (if (lt rung 0) "wake-edge-refused" "public-context-task-durable"))
                                                (fch3p-line "dataset-sha256" (fkh3-dataset-seal))
                                                (fch3p-line "row" (fkh3-id row))
                                                (fch3p-line "family" (fkh3-family row))
                                                (fch3p-line "adaptation-kind" (fcpt-kind))
                                                (fch3p-line "profile-sha256" (nmfe-sha256 (fcpt-profile)))
                                                (fch3p-int "profile-bytes" (fcpt-profile-bytes))
                                                (fch3p-line "question-sha256" (nmfe-sha256 (fkh3-prompt row)))
                                                (fch3p-line "task-sha256" (nmfe-sha256 task))
                                                (fch3p-int "appended-bytes" appended)
                                                (fch3p-int "ring-result" rung)
                                                (if (lt rung 0) 0 1))))))))))))
    (let spool (read_line))
    (let bell (read_line))
    (let turn (str_to_int (read_line)))
    (let row-id (read_line))
    (if (or (or (nothing? spool) (nothing? bell))
            (or (str_eq spool "") (or (str_eq bell "") (str_eq row-id ""))))
        (fch3p-refusal "sender-input-absent")
        (fch3p-send spool bell turn row-id)))
