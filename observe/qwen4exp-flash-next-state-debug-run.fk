; Bounded pure diagnostic for the resident state band.
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form/form-stdlib/qwen4exp-flash-next-state.bml

(do
    (defn q4sdb-states (n acc)
        (if (ge n 48) (reverse acc)
            (q4sdb-states (add n 1) (cons (list (add 100 n) (add 200 n) (add 300 n) (add 400 n)) acc))))
    (defn q4sdb-bufs (n acc)
        (if (ge n 49) (reverse acc) (q4sdb-bufs (add n 1) (cons (add 900 n) acc))))
    (let ctx (list 0 0 0 (q4sdb-bufs 0 (empty)) 0 0 (q4sdb-states 0 (empty)) 16))
    (let slot (q4s-slot "fixture-" ctx 16 3 13 12 (list 10 11 12) 13 "fixture"))
    (list
        (q4s-prefix-lookup slot (list 10 11 12))
        (q4s-prefix-lookup slot (list 10 11 12 13 14))
        (q4s-prefix-lookup slot (list 10 99))
        (q4s-state-lookup slot 7 "gdn")
        (q4s-state-lookup slot 7 "key")
        (q4s-state-lookup slot 0 "ple-history")
        (q4s-state-lookup slot 0 "position")
        (q4s-state-lookup slot 99 "key")))
