; tkz-encode-cost-run.fk — what does it cost to encode one injected observation?
;
; tkz-id-of is "ONE streaming pass over the whole vocab" per symbol, and the
; vocabulary is 248,320 entries. An injected observation is about 1072 bytes.
;
; Effectful: reads the GGUF header window. Do not preflight.
; preludes: form-stdlib/qwen35-tokenizer.fk form-stdlib/model-registry.bml

(do
    (defn tec-line (k v) (print_str (str_concat "enc " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn tec-int (k v) (tec-line k (int_to_str v)))
    (defn tec-rep (s n acc) (if (le n 0) acc (tec-rep s (sub n 1) (str_concat acc s))))

    (let path (mr-path (mr-find "qwen38-q8")))
    (let src (eqr-of-file path 0 40000000))
    (tec-int "vocab-n" (gmt-vocab-n src))

    ; a short one first, so a long one is not the only datum
    (let short "status=hit anchor=@1.2.99.7 source-path=WELCOME.md")
    (let t0 (now_unix_ms))
    (let a (q35-encode src short))
    (let t1 (now_unix_ms))
    (tec-int "short-bytes" (str_len short))
    (tec-int "short-tokens" (len a))
    (tec-int "short-ms" (sub t1 t0))

    ; an observation-sized one
    (let obs (tec-rep "status=hit anchor=@1.2.99.7 source-path=WELCOME.md answer:This project is called Sema. " 11 ""))
    (let t2 (now_unix_ms))
    (let b (q35-encode src obs))
    (let t3 (now_unix_ms))
    (tec-int "obs-bytes" (str_len obs))
    (tec-int "obs-tokens" (len b))
    (tec-int "obs-ms" (sub t3 t2))
    (tec-int "obs-ms-per-token" (if (gt (len b) 0) (div (sub t3 t2) (len b)) 0))
    0)
