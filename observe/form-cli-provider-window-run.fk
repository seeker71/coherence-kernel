; form-cli-provider-window-run.fk — one bounded provider-evidence observation.
; The bound rollout and its existing durable cursor supply the only file
; authority. BML owns frame recognition, quantity parsing, and the redacted
; result; this entry only crosses the already-granted read boundary.
;
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(do
    (defn fcpwr-min (a b) (if (lt a b) a b))
    (let path (fctel-bound-path))
    (let progress (fctel-read-progress))
    (if (or (str_eq path "") (not (eq (len progress) 24)))
        (do (print_str "provider-window=withheld no-selected-cursor\n") 0)
        (do
            (let cursor (str_to_int (nth progress 1)))
            (let size (file_size path))
            (if (or (lt cursor 0) (ge cursor size))
                (do (print_str "provider-window=withheld exhausted-cursor\n") 0)
                (do
                    (let end (fcpwr-min size (add cursor 400000)))
                    (let tally (frte-provider-call-window
                        (read_file_slice path cursor (sub end cursor))))
                    (print_str (frte-window-frame cursor (sub end cursor) tally))
                    0)))))
