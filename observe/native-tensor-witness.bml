// Retains each preflight, execution, answer, error stream and elapsed time.
// preludes: observe/native-jit-retirement-witness.bml
section [form.bml] {
 class NativeTensorWitness {
  def ntw-cases() = list(
   list("form/form-stdlib/tests/native-tensor-behavior-band.fk", "1"),
   list("form/form-stdlib/tests/native-tensor-image-band.fk", "127"),
   list("form/form-stdlib/tests/native-tensor-lifecycle-band.fk", "1023"),
   list("form/form-stdlib/tests/native-tensor-derived-band.fk", "1073741823"),
   list("form/form-stdlib/tests/native-tensor-files-band.fk", "127"),
   list("form/form-stdlib/tests/native-tensor-q8-band.fk", "63"),
   list("form/form-stdlib/tests/native-tensor-kquant-band.fk", "63"),
   list("form/form-stdlib/tests/native-tensor-home-band.fk", "255"),
   list("form/form-stdlib/tests/native-tensor-matmul-band.fk", "63"),
   list("form/form-stdlib/tests/native-tensor-softmax-band.fk", "63"),
   list("form/form-stdlib/tests/form-cli-gpu-band.fk", "1023"),
   list("form/form-stdlib/tests/form-cli-tensor-ir-band.fk", "1023"),
   list("form/form-stdlib/tests/form-cli-tensor-nodeid-fallback-band.fk", "16383"),
   list("observe/form-cli-tensor-nodeid-fallback-live-run.fk", "4095"),
   list("form/form-stdlib/tests/form-cli-live-band.fk", "255"),
   list("form/form-stdlib/tests/form-glass-observer-band.fk", "67108863"),
   list("form/form-stdlib/tests/form-glass-staged-startup-band.fk", "262143"),
   list("form/form-stdlib/tests/form-glass-wait-band.fk", "255"),
   list("form/form-stdlib/tests/form-glass-observation-v2-band.fk", "2097151"),
   list("form/form-stdlib/tests/form-glass-live-band.fk", "2147483647"),
   list("form/form-stdlib/tests/form-recipe-exec-token-band.fk", "1048575"),
   list("observe/tests/form-membrane-runtime-census-band.fk", "8191"),
   list("observe/tests/carrier-mass-band.fk", "16383"));
  def ntw-run() {
   let root = str_concat(".hearth/native-tensor-check-", int_to_str(host_pid()));
   let made = host_dir_mkdir(root);
   if not(eq(made, 1)) then form_error("tensor witness evidence directory refused") else ntw-start(root);
  }
  def ntw-start(root) {
   let head = host_capture(list("git", "rev-parse", "HEAD"));
   let tree = host_capture(list("git", "write-tree"));
   let diff = host_capture(list("git", "diff", "--name-only"));
   let binary = host_capture(list("git", "hash-object", "fkwu"));
   let meta = json-emit(json-node-object(list(json-node-pair("observed_unix_ms", json-node-int(now_unix_ms())), json-node-pair("head", json-node-string(lx-strip(head))), json-node-pair("index_tree", json-node-string(lx-strip(tree))), json-node-pair("binary", json-node-string(lx-strip(binary))), json-node-pair("unstaged_paths", json-node-string(diff)))));
   let kept = write_file(str_concat(root, "/source.json"), str_concat(meta, "\n"));
   print(meta);
   ntw-finish(root, njw-rows(root, ntw-cases(), 0, 0), head);
  }
  def ntw-finish(root, failures, before) {
   print(list("evidence", root, "cases", len(ntw-cases()), "failures", failures));
   if not(str_eq(before, host_capture(list("git", "rev-parse", "HEAD")))) then form_error("tensor witness HEAD moved") else if eq(failures, 0) then 1 else form_error("tensor witness failed; inspect retained rows");
  }
 }
 0;
}
