; session-neutral-semantic-frequency-live.fk — visible session token witness.
; witnessed: 2026-08-24 -> request 46/46; prior response 651/657 candidate
; preludes: cognition/session-neutral-semantic-frequency.fk

(do
  (defn snsfl-print-candidate (candidate)
    (do
      (print "      address=") (print (snsf-c-address candidate))
      (print " label=") (print (snsf-c-label candidate))
      (print " definition-kind=") (print (snsf-c-definition-kind candidate))
      (print " source=") (print (snsf-c-source candidate))
      (print " occurrence-frequency=")
      (print (int_to_str (snsf-c-occurrence-frequency candidate)))
      (print " sense-count=") (print (int_to_str (snsf-c-sense-count candidate)))
      (print " field-state=") (print (snsf-c-field-state candidate))
      (print " field-evidence=") (print (snsf-c-field-evidence candidate))
      (print " field=") (print (snsf-c-field candidate))
      (print "\n") 0))
  (defn snsfl-print-candidates (candidates)
    (if (eq (len candidates) 0) 0
      (do (snsfl-print-candidate (head candidates))
          (snsfl-print-candidates (tail candidates)))))
  (defn snsfl-print-row (row)
    (do
      (print "  token[") (print (int_to_str (snsf-t-ordinal row)))
      (print "] surface=") (print (snsf-t-surface row))
      (print " kind=") (print (snsf-t-kind row))
      (print " locale=") (print (snsf-t-locale row))
      (print " state=") (print (snsf-t-state row))
      (print " expression-symbol=") (print (snsf-t-expression-case row))
      (print " expression-case=")
      (print (snsf-expression-label (snsf-t-expression-case row)))
      (print " expression-description=")
      (print (snsf-expression-description (snsf-t-expression-case row)))
      (print " candidate-count=")
      (print (int_to_str (len (snsf-t-candidates row))))
      (print "\n")
      (snsfl-print-candidates (snsf-t-candidates row))))
  (defn snsfl-print-rows (rows)
    (if (eq (len rows) 0) 0
      (do (snsfl-print-row (head rows)) (snsfl-print-rows (tail rows)))))
  (defn snsfl-print-residue (rows)
    (if (eq (len rows) 0) 0
      (do
        (if (eq (snsf-token-residue? (head rows)) 1)
          (do (print " ") (print (snsf-t-surface (head rows))) 0) 0)
        (snsfl-print-residue (tail rows)))))
  (defn snsfl-print-coverage (name coverage)
    (do
      (print "\ncoverage=") (print name)
      (print " total=") (print (int_to_str (snsf-cov-total coverage)))
      (print " observed=") (print (int_to_str (snsf-cov-observed coverage)))
      (print " observed-bp=") (print (int_to_str (snsf-cov-observed-bp coverage)))
      (print " candidate-semantic=") (print (int_to_str (snsf-cov-semantic coverage)))
      (print " candidate-semantic-bp=") (print (int_to_str (snsf-cov-semantic-bp coverage)))
      (print " field=") (print (int_to_str (snsf-cov-field coverage)))
      (print " field-bp=") (print (int_to_str (snsf-cov-field-bp coverage)))
      (print " residue=") (print (int_to_str (snsf-cov-residue coverage)))
      (print " words=") (print (int_to_str (snsf-cov-words coverage)))
      (print " symbols=") (print (int_to_str (snsf-cov-symbols coverage)))
      (print " numbers=") (print (int_to_str (snsf-cov-numbers coverage)))
      (print " self-centered=")
      (print (int_to_str (snsf-expression-count (snsf-cov-rows coverage)
        (snsf-expression-self))))
      (print " field-centered=")
      (print (int_to_str (snsf-expression-count (snsf-cov-rows coverage)
        (snsf-expression-field))))
      (print " context-carried=")
      (print (int_to_str (snsf-expression-count (snsf-cov-rows coverage)
        (snsf-expression-context))))
      (print " uncased-script=")
      (print (int_to_str (snsf-expression-count (snsf-cov-rows coverage)
        (snsf-expression-uncased))))
      (print "\nresidue-surfaces=")
      (snsfl-print-residue (snsf-cov-rows coverage))
      (print "\n") 0))
  (defn snsfl-print-open-symbol-descriptions (groups)
    (if (eq (len groups) 0) 0
      (do
        (if (eq (rwfd-desc-closed? (snsf-sg-desc (head groups))) 0)
          (do (print " open-symbol-description=")
              (print (snsf-sg-recipe (head groups)))
              (print ":") (print (snsf-sg-desc (head groups)))
              (print "\n") 0) 0)
        (snsfl-print-open-symbol-descriptions (tail groups)))))
  (defn snsfl-int-in? (wanted ids)
    (if (eq (len ids) 0) 0
      (if (eq wanted (head ids)) 1 (snsfl-int-in? wanted (tail ids)))))
  (defn snsfl-locale-roundtrip-count (runtime codes concept-id count)
    (if (eq (len codes) 0) count
      (do
        (let code (head codes))
        (let surface (cnl13-runtime-generate (snsf-rt-nl runtime) concept-id code))
        (let ids (snsf-candidate-ids runtime code surface))
        (snsfl-locale-roundtrip-count runtime (tail codes) concept-id
          (add count (if (and (gt (str_len surface) 0)
                              (eq (snsfl-int-in? concept-id ids) 1)) 1 0))))))

  (let runtime (snsf-open))
  (let prose (snsf-resolve-text runtime "en"
    "Can we extend this dictionary to words, symbols, tokens, trust, vitality, flow, and response coverage?"))
  (let program (snsf-resolve-text runtime "en" "(x===108)->!"))
  (let current-request (snsf-resolve-text runtime "en"
    "can we extend this to all symbols to words in most sessions so that we can have better response coverage of the words we are using to ask and respond with a native semantic frequency understanding of which words / symbols / tokens we are using"))
  (let prior-response (snsf-resolve-text runtime "en"
    (read_file "observe/fixtures/2026-08-22-form-native-dialogue-response.txt")))
  (let id-ya (snsf-resolve-one runtime "id" "ya" 0))
  (let lower-trust (head (snsf-resolve-text runtime "en" "trust")))
  (let mixed-trust (head (snsf-resolve-text runtime "en" "Trust")))
  (let upper-trust (head (snsf-resolve-text runtime "en" "TRUST")))
  (let sa-trust-surface (fwfl-generate-in (snsf-rt-nl runtime)
    (fwfl-symbol 7) (fwfl-sa)))
  (let sa-trust (snsf-resolve-one runtime "sa" sa-trust-surface 0))

  (print "session-neutral-semantic-frequency\n")
  (print "pipeline=token -> exact surface -> complete neutral candidates -> definition -> field evidence\n")
  (print "observation-and-semantic-coverage-are-distinct-even-when-counts-coincide\n")
  (print "corpus-occurrence-frequency-is-not-semantic-frequency\n")
  (print "field=13-axis-per-mille-affinity; definition-projection-v1-is-computed-and-not-speaker-reviewed\n")
  (print "lexical-substrate=10000 concepts x 13 locales; symbol-groups=")
  (print (int_to_str (len (snsf-symbol-groups))))
  (print " symbol-descriptions-core-closed=")
  (print (int_to_str (snsf-symbol-descriptions-closed? (snsf-symbol-groups))))
  (print " printable-ascii-symbols-covered=")
  (print (int_to_str (snsf-ascii-symbols-covered?)))
  (print " common-unicode-symbol-aliases=")
  (print (int_to_str (snsf-unicode-symbol-alias-count)))
  (print "\n")
  (snsfl-print-open-symbol-descriptions (snsf-symbol-groups))
  (snsfl-print-coverage "representative-natural-language" (snsf-coverage prose))
  (snsfl-print-coverage "representative-program-structure" (snsf-coverage program))
  (snsfl-print-coverage "current-user-request" (snsf-coverage current-request))
  (snsfl-print-coverage "prior-response-fixture" (snsf-coverage prior-response))
  (let trust-record (c10-detect-text-in (snsf-rt-ranked runtime)
    (snsf-rt-lexical runtime) "trust"))
  (print "\ntrust-locale-roundtrip=")
  (print (int_to_str (snsfl-locale-roundtrip-count runtime
    (cnl13-locale-codes) (c10-concept-id trust-record) 0)))
  (print "/") (print (int_to_str (len (cnl13-locale-codes)))) (print "\n")
  (print "\nrepresentative-natural-language-rows\n")
  (snsfl-print-rows prose)
  (print "\nprogram-rows\n")
  (snsfl-print-rows program)
  (print "\nambiguity-witness Indonesian-ya\n")
  (snsfl-print-row id-ya)
  (print "\ncasing-witness same-neutral-concept\n")
  (snsfl-print-row lower-trust)
  (snsfl-print-row mixed-trust)
  (snsfl-print-row upper-trust)
  (print "\nlocale-only-witness Sanskrit surface=") (print sa-trust-surface)
  (print "\n")
  (snsfl-print-row sa-trust)
  0)
