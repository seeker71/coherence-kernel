; Native read-only parity/timing witness. No model admission or GPU forward.
; Prelude and artifact bytes remain on this machine. A missing artifact is
; explicit attention, never a passing token-equivalence claim.
; preludes: form-stdlib/bml/form-cli-code-session.bml
(do
 (let path (mr-path (mr-find "qwen38-q8")))
 (let crystal (qsx-load path))
 (if (not (eq (head crystal) 1))
  (print (list "attention" "qwen-crystal-unavailable"))
  (do
   (let s (fcms-session "live" "encoding-only" path (fcmg-src path) (list) (list) 8192 100 (nth crystal 2) 1 10 20 0 0))
   (let text "{\"role\":\"implement\",\"observation\":\"native tools: naïve 日本語 0123\"}")
   (let old-start (host_monotonic_ms))
   (let old (fcms-observation-ids s text))
   (let old-ms (sub (host_monotonic_ms) old-start))
   (let new-start (host_monotonic_ms))
   (let walked (fcacs-ids s text crystal))
   (let ids (reverse (nth walked 2)))
   (let new-ms (sub (host_monotonic_ms) new-start))
   (print (list "token-ids-equal" (if (and (str_eq (head walked) "done") (value_eq old ids)) 1 0) "ids" (len ids) "scanner-ms" old-ms "indexed-ms" new-ms))))
 0)
