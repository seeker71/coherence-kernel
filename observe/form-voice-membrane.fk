; form-voice-membrane.fk -- a native, content-blind offer between Form and a voice.
;
; The carrier supplies only an opaque prompt digest and an exchange id. Form
; chooses an action, the voice acts outside the process, and only a later
; correlated receipt may produce a re-observed state. Raw prompt/response
; bytes never enter this cell.
; preludes: form-stdlib/core.fk

(do
    (defn fvm-id? (s) (if (gt (str_len s) 0) 1 0))
    (defn fvm-digest? (s)
        (if (eq (str_len s) 64) 1 0))
    (defn fvm-action (missing)
        (if (eq missing 1) "request-evidence" "continue"))
    (defn fvm-open (exchange prompt-digest missing)
        (if (and (eq (fvm-id? exchange) 1) (eq (fvm-digest? prompt-digest) 1))
            (str_concat "schema=form-voice-membrane-v1\nphase=outbound\nexchange_id="
                (str_concat exchange
                    (str_concat "\nprompt_sha256="
                        (str_concat prompt-digest
                            (str_concat "\naction="
                                (str_concat (fvm-action missing)
                                    "\nstate=awaiting-external-return\n"))))))
            "schema=form-voice-membrane-v1\nphase=refused\nstate=invalid-offer\n"))
    (defn fvm-close (exchange prompt-digest action returned-exchange acted)
        (if (and (eq (fvm-id? exchange) 1)
                 (and (eq (fvm-digest? prompt-digest) 1)
                      (and (str_eq exchange returned-exchange)
                           (str_eq action "request-evidence"))))
            (if (eq acted 1)
                "schema=form-voice-membrane-v1\nphase=reobserved\nstate=external-action-received\nclosed=1\n"
                "schema=form-voice-membrane-v1\nphase=reobserved\nstate=external-action-not-received\nclosed=0\n")
            "schema=form-voice-membrane-v1\nphase=refused\nstate=uncorrelated-return\n"))
    0)
