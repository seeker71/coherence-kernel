// stopped-tissue-run.bml — the glass processes that have stood stopped for days leave.
//
//   ./fkwu observe/stopped-tissue-run.bml </dev/null                       what would leave (a dry reading)
//   print -r -- release | ./fkwu observe/stopped-tissue-run.bml            let them leave
//
// A stopped process works no more than a dead one and holds what it held: six days after a stop the host still carried 18 glass
// processes (six doors, three stacks each), flagged DUPLICATE by observe/process-census-run.bml, every one of them older than the role
// singleton that now makes a new stack yield to an elder (form-stdlib/bml/role-singleton.bml). The census reads the process table's run
// state (host_process word 7: 2 stopped); this door acts on exactly that and on nothing wider:
//   - the process stands stopped (state 2), not running, not a zombie;
//   - it has stood for more than 24 hours (its start is older than a day);
//   - its door is a glass door (the second word of its command line starts with observe/form-glass or names a form-resource-governor-glass door).
// Each is read again immediately before it is signalled (a pid the host handed out again since is not it: the start must still be the one read),
// and a stopped process is ended with SIGKILL (a stop holds a TERM pending until a continue, and a continue would let an old stack run).
// Without `release` on stdin nothing is signalled. A running process, a process younger than a day, any other door: never.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class StoppedTissue {
  def st-day-ms() = 86400000;
  def st-row(l) = host_process(l[0]);
  def st-rows() = filter(r => (String) value_kind(r) == "list", map(l => st-row(l), host_processes("fkwu")));
  def st-door(r) = (Comparable) len(r[4]) >= 2 ? r[4][1] : "";
  def st-glass?(door) = str_find(door, "observe/form-glass", 0) == 0 || (str_find(door, "form-resource-governor-glass", 0) >= 0);
  def st-state(r) = (Comparable) len(r) > 7 ? r[7] : 0;
  def st-old?(r) = r[5] > 0 && (now_unix_ms() - r[5]) > st-day-ms();
  def st-leaving?(r) = (Comparable) st-state(r) == 2 && st-old?(r) && st-glass?(st-door(r));
  def st-line(r) = str-join(["pid ", r[0].str(), "  stopped ", ((now_unix_ms() - r[5]) / 3600000).str(), " h  ", st-door(r)]);
  // read again, still the same process and still stopped, then end it
  def st-release(r) {
   let again = host_process(r[0]);
   (String) value_kind(again) == "list" && (Comparable) again[5] == r[5] && st-leaving?(again) ? { let sent = host_signal(r[0], 9); str-join(["ended  ", st-line(r)]); } : str-join(["kept   ", st-line(r), "  (it is not the process read)"]);
  }
  def st-run() {
   let leaving = filter(r => st-leaving?(r), st-rows());
   let release = trim(stdin-text() ?? "") == "release";
   map(r => print_str(release ? st-release(r) : str-join(["would end  ", st-line(r)])), leaving);
   print_str(str-join([release ? "ended " : "would end ", len(leaving).str(), " stopped glass process(es) older than a day; ", len(st-rows()).str(), " kernels in all"]));
   0;
  }
 }
 st-run();
}
