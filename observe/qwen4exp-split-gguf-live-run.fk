; Live split-carrier witness over the exact downloaded UD-Q2_K_XL shards.
; It reads header windows only. Tensor payloads remain mmap-able in place.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/equireach-gguf.fk form-stdlib/gguf-meta.fk form-stdlib/mxfp4-plane-dequant.fk form-stdlib/mxfp8-plane-dequant.fk form-stdlib/gguf-manifest.fk form-stdlib/qwen4exp-split-gguf.bml form-stdlib/qwen4exp-split-gguf.fk

(do
    (defn q4sl-root () "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-")
    (defn q4sl-path (part) (str_concat (q4sl-root) (str_concat part "-of-00003.gguf")))
    (let paths (list (q4sl-path "00001") (q4sl-path "00002") (q4sl-path "00003")))
    (let src1 (eqr-of-file (nth paths 0) 0 16000000))
    (let src2 (eqr-of-file (nth paths 1) 0 16000000))
    (let src3 (eqr-of-file (nth paths 2) 0 16000000))
    (let ple (q4sg-locate paths src2 src3 "per_layer_token_embd.weight"))
    (let moe (q4sg-locate paths src2 src3 "blk.0.ffn_gate_exps.weight"))
    (let absent (q4sg-locate paths src2 src3 "not.a.real.tensor"))
    (let verdict
        (if (eq (egg-tensor-count src1) 0)
            (if (eq (egg-tensor-count src2) 503)
                (if (eq (egg-tensor-count src3) 721)
                    (if (eq (q4s-record-complete ple) 1)
                        (if (eq (q4s-record-type ple) 20)
                            (if (eq (q4s-record-complete moe) 1)
                                (if (eq (q4s-record-status absent) 0) 127 0) 0) 0) 0) 0) 0) 0))
    (list "qwen4exp-split-gguf-live"
        (list "metadata-tensors" (egg-tensor-count src1)
              "shard2-tensors" (egg-tensor-count src2)
              "shard3-tensors" (egg-tensor-count src3))
        (list "ple-shard" (q4s-record-shard ple) "type" (q4s-record-type ple)
              "absolute" (q4s-record-absolute ple) "bytes" (q4s-record-bytes ple))
        (list "moe-shard" (q4s-record-shard moe) "type" (q4s-record-type moe)
              "absolute" (q4s-record-absolute moe) "bytes" (q4s-record-bytes moe))
        (list "absent-status" (q4s-record-status absent))
        (list "verdict" verdict)))
