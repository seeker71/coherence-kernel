// preflight-exec: forbidden
// One manifest path on stdin. Read-only evaluations, one admitted model.
// preludes: form-stdlib/bml/form-cli-response-resident.bml
section [form.bml] {
 let path = read_line();
 if or(le(file_size(path),0),gt(file_size(path),FatMaxBytes())) then form_error("resident response manifest unavailable or oversized") else 0;
 let raw = read_file(path);
 if not(faj-valid(raw)) then form_error("resident response manifest is not JSON") else 0;
 print_str(frsr-run(parse-json("resident-response-manifest",raw)));
 0;
}
