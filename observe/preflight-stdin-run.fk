; preflight-stdin-run.fk — concurrency-safe runnable preflight door.
; preflight-exec: forbidden
;
; One target path arrives as one stdin line.  Unlike preflight-run.fk's
; compatibility file, this process owns its input, so parallel agents cannot
; replace one another's target between write and read.
;
; PROOF LEVEL: FOURTH-ARM ONLY — preflight shells out to compare kernels.
; preludes: form-stdlib/core.fk observe/preflight.fk

(do
    (defn pfsi-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n")
                (pfsi-trim-loop s (sub n 1))
                (substring s 0 n))))
    (defn pfsi-target (raw)
        (if (nothing? raw) "" (pfsi-trim-loop raw (str_len raw))))
    (let target (pfsi-target (read_line)))
    ;; The page first, then the exit code that agrees with it — the same pair
    ;; the fixed-path door carries, for the same reason: a door whose whole job
    ;; is to say whether a verdict can be trusted cannot itself answer 0 to
    ;; everything. `pf-scan` computes both from one fresh compile.
    (let scan (if (eq (str_len target) 0)
                  (list "preflight-stdin-run: send one target path on stdin" 0)
                  (pf-scan target)))
    (print_str (nth scan 0))
    (if (eq (nth scan 1) 1) 0
        (form_error "preflight: no readable verdict — read the chain line above")))
