// preflight-exec: forbidden
// Native model transport: no subprocess model engine and no adapter minting.
// Admission may refuse; generation output is a proposal, never a repair verdict.
// preludes: form-stdlib/bml/form-cli-heal-flow.bml
section [form.bml] {
    class FormCliHealModel {
        def fhm-inventory(rows) = nil?(rows) ? 0 : fhm-inventory-row(rows);
        def fhm-base(model, path, prompt, output) {
            let session = fcms-open(path, prompt, 4096);
            let result = fcms-live?(session) ? fhf-run(fcms-ctx(session), fcms-sts(session), fcms-src(session), list(), "", model, path, output, fcms-pending(session), fcms-pos(session), fcms-prompt-ids(session), fcms-maxpos(session)) : list(fcms-reason(session), 0);
            let released = fcms-release-ok?(session);
            ((Comparable) released == 1) && ((String) head(result) == "eos") ? write_file(output, read_file(output ++ ".partial")) : print(list("native-incomplete", head(result), "released", released));
        }
        def fhm-adapted-open(model, path, prompt, output, adapter, artifact) {
            let src = fcmg-src(path);
            let ids = q35-chat-ids(src, prompt);
            ((Comparable) len(ids) == 0) || (len(ids) > 3584) ? list("adapter-context-refused") : fhm-adapted-context(model, path, output, adapter, src, ids, artifact);
        }
        def fhm-adapted(model, path, prompt, output, artifact) = !((Comparable) qaf-seal-verdict(path) == 1) ? list("adapter-base-unsealed") : fhm-adapter-admit(model, path, prompt, output, artifact);
        def fhm-main() {
            let mode = read_line();
            (String) mode == "inventory" ? fhm-inventory(mr-registry()) : fhm-request(mode);
        }
        def fhm-inventory-row(rows) {
            let row = head(rows);
            print_str(mr-name(row) ++ "\t" ++ mr-path(row) ++ "\t" ++ mr-roles(row) ++ "\t" ++ fhm-readiness(row) ++ "\n");
            fhm-inventory(tail(rows));
        }
        def fhm-readiness(row) {
            let repairRole = mr-has-role?(row, "answer") || (mr-has-role?(row, "fast-answer") || mr-has-role?(row, "code"));
            let arch = repairRole && mr-file?(mr-path(row)) ? mr-arch(row) : "not-probed-for-repair";
            mr-readiness(row) ++ " native=" ++ int_to_str(mr-wired?(arch)) ++ " arch=" ++ arch;
        }
        def fhm-adapted-generate(output, adapter, src, ids, ctx, model, path, artifact) {
            let sts = q38-new-state(ctx[2]);
            let stops = fcmg-q35-stops(src);
            let pref = q38-prefill-adapted(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], adapter, ids, 0);
            let result = fhf-run(ctx, sts, src, adapter, artifact, model, path, output, pref[0], pref[1], len(ids), 4096);
            let expected = q38-close-expected(ctx, sts);
            let released = q38-close(ctx, sts);
            ((Comparable) released == expected) && ((String) head(result) == "eos") ? write_file(output, read_file(output ++ ".partial")) : list("adapter-generation-incomplete", head(result));
        }
        def fhm-adapted-context(model, path, output, adapter, src, ids, artifact) {
            let ctx = q38-open(path, 4096);
            len(ctx) < 10 ? list("adapter-model-unavailable") : fhm-adapted-generate(output, adapter, src, ids, ctx, model, path, artifact);
        }
        def fhm-adapter-admit(model, path, prompt, output, artifact) {
            let adapter = qlh-admit(artifact);
            let result = (Comparable) qlh-admitted?(adapter) == 1 ? fhm-adapted-open(model, path, prompt, output, adapter, artifact) : list("adapter-shape-unavailable");
            let released = qlh-close(adapter);
            result;
        }
        def fhm-request(mode) {
            let entered = q38oo-stage("model-runner-admission-door-" ++ int_to_str(kernel_stat(15)), 8388626);
            let model = mr-find(read_line());
            let prompt = read_file(read_line());
            let output = read_line();
            let artifact = read_line();
            ((String) mr-path(model) == "") || nothing?(prompt) ? list("native-request-unavailable") : (String) mode == "adapter" ? fhm-adapted(mr-name(model), mr-path(model), prompt, output, artifact) : fhm-base(mr-name(model), mr-path(model), prompt, output);
        }

    }
    fhm-main();
}
