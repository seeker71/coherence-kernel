// preflight-exec: forbidden
// Native model transport: no subprocess model engine and no adapter minting.
// Admission may refuse; generation output is a proposal, never a repair verdict.
// preludes: form-stdlib/bml/form-cli-heal-flow.bml
section [form.bml] {
    class FormCliHealModel {
        def fhm-inventory(rows) = if nil?(rows) then 0 else fhm-inventory-row(rows);
        def fhm-base(model, path, prompt, output) {
            let session = fcms-open(path, prompt, 4096);
            let result = if fcms-live?(session) then fhf-run(fcms-ctx(session), fcms-sts(session), fcms-src(session), list(), "", model, path, output, fcms-pending(session), fcms-pos(session), fcms-prompt-ids(session), fcms-maxpos(session)) else list(fcms-reason(session), 0);
            let released = fcms-release-ok?(session);
            if and(eq(released, 1), str_eq(head(result), "eos")) then write_file(output, read_file(str_concat(output, ".partial"))) else print(list("native-incomplete", head(result), "released", released));
        }
        def fhm-adapted-open(model, path, prompt, output, adapter, artifact) {
            let src = fcmg-src(path);
            let ids = q35-chat-ids(src, prompt);
            if or(eq(len(ids), 0), gt(len(ids), 3584)) then list("adapter-context-refused") else fhm-adapted-context(model, path, output, adapter, src, ids, artifact);
        }
        def fhm-adapted(model, path, prompt, output, artifact) = if not(eq(qaf-seal-verdict(path), 1)) then list("adapter-base-unsealed") else fhm-adapter-admit(model, path, prompt, output, artifact);
        def fhm-main() {
            let mode = read_line();
            if str_eq(mode, "inventory") then fhm-inventory(mr-registry()) else fhm-request(mode);
        }
        def fhm-inventory-row(rows) {
            let row = head(rows);
            print_str(str_concat(mr-name(row), str_concat("\t", str_concat(mr-path(row), str_concat("\t", str_concat(mr-roles(row), str_concat("\t", str_concat(fhm-readiness(row), "\n"))))))));
            fhm-inventory(tail(rows));
        }
        def fhm-readiness(row) {
            let repairRole = or(mr-has-role?(row, "answer"), or(mr-has-role?(row, "fast-answer"), mr-has-role?(row, "code")));
            let arch = if and(repairRole, mr-file?(mr-path(row))) then mr-arch(row) else "not-probed-for-repair";
            str_concat(mr-readiness(row), str_concat(" native=", str_concat(int_to_str(mr-wired?(arch)), str_concat(" arch=", arch))));
        }
        def fhm-adapted-generate(output, adapter, src, ids, ctx, model, path, artifact) {
            let sts = q38-new-state(nth(ctx, 2));
            let stops = fcmg-q35-stops(src);
            let pref = q38-prefill-adapted(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), sts, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), adapter, ids, 0);
            let result = fhf-run(ctx, sts, src, adapter, artifact, model, path, output, nth(pref, 0), nth(pref, 1), len(ids), 4096);
            let expected = q38-close-expected(ctx, sts);
            let released = q38-close(ctx, sts);
            if and(eq(released, expected), str_eq(head(result), "eos")) then write_file(output, read_file(str_concat(output, ".partial"))) else list("adapter-generation-incomplete", head(result));
        }
        def fhm-adapted-context(model, path, output, adapter, src, ids, artifact) {
            let ctx = q38-open(path, 4096);
            if lt(len(ctx), 10) then list("adapter-model-unavailable") else fhm-adapted-generate(output, adapter, src, ids, ctx, model, path, artifact);
        }
        def fhm-adapter-admit(model, path, prompt, output, artifact) {
            let adapter = qlh-admit(artifact);
            let result = if eq(qlh-admitted?(adapter), 1) then fhm-adapted-open(model, path, prompt, output, adapter, artifact) else list("adapter-shape-unavailable");
            let released = qlh-close(adapter);
            result;
        }
        def fhm-request(mode) {
            let entered = q38oo-stage(str_concat("model-runner-admission-door-", int_to_str(kernel_stat(15))), 8388626);
            let model = mr-find(read_line());
            let prompt = read_file(read_line());
            let output = read_line();
            let artifact = read_line();
            if or(str_eq(mr-path(model), ""), nothing?(prompt)) then list("native-request-unavailable") else if str_eq(mode, "adapter") then fhm-adapted(mr-name(model), mr-path(model), prompt, output, artifact) else fhm-base(mr-name(model), mr-path(model), prompt, output);
        }

    }
    fhm-main();
}
