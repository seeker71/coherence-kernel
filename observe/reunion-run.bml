// reunion-run.bml — the body goes and gets what origin gained, and brings its
// own work home.
//
// stdin: nothing, or one JSON object naming what the caller can draw again:
//   {"draws":["docs/rent-ladder.html"],"redraw":"<a command that remakes them>"}
// Rivers are recognised by reading them, so nothing needs naming there. A kind
// the body has not learned keeps both banks under .form-heal/reunion-unlearned,
// lets the attempt go, and is said rather than refused.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-reunion.bml
section [form.bml] {
 class Reunion {
  def rr-draws() = list("docs/rent-ladder.html");
  def rr-redraw() = "./fkwu observe/rent-ladder-page-run.bml </dev/null >/dev/null 2>&1";
  def rr-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def rr-values(doc, key) = if json-object-has?(doc, key) then oh-values(json-array-elements(json-object-get(doc, key))) else list();
  def rr-go() {
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let request = if str_eq(line, "") then json-node-object(list()) else parse-json("reunion-request", line);
   let draws = if nil?(rr-values(request, "draws")) then rr-draws() else rr-values(request, "draws");
   let redraw = if str_eq(rr-str(request, "redraw"), "") then rr-redraw() else rr-str(request, "redraw");
   let r = fcr-reunion(redraw, draws);
   print_str(json-emit-precise(json-node-object(list(
    fhn-s("reunion", nth(r, 0)),
    fhn-s("said", nth(r, 1)),
    fhn-s("push", trim(nth(r, 2)))))));
  }
 }
 rr-go();
}
