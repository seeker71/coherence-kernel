// Observe exact native arithmetic, repeated residency and owned release.
// The independent arithmetic specimen covers every E4M3 and E8M0 byte.
// preludes: form-stdlib/bml/native-fp64-matrix.bml form-stdlib/bml/native-fp64-reference.bml form-stdlib/organ-health.bml
section [form.bml] {
 class NativeFp64Observation {
  def nfw-data(at,left,bins) = if ((Comparable) left == 0) then fbc-finish(bins,"") else nfw-data((at + 1),(left - 1),fbc-put(bins,byte_to_str((((at * 73) + ((at / 256) * 19)) % 256))));
  def nfw-scales(at,left,bins) = if ((Comparable) left == 0) then fbc-finish(bins,"") else nfw-scales((at + 1),(left - 1),fbc-put(bins,byte_to_str((at % 256))));
  def nfw-vector(at,left,acc) = if ((Comparable) left == 0) then reverse(acc) else nfw-vector((at + 1),(left - 1),cons(((((at * 29) % 97) - 48) * 0.00390625),acc));
  def nfw-repeat(owner,data,scales,x,region,n) = if ((Comparable) n == 0) then 1 else if ((Comparable) nfm-mx8-run(owner,data,scales,x,32,region) == 32) then nfw-repeat(owner,data,scales,x,region,(n - 1)) else 0;
  def nfw-report(job,aspect,ok,details) = nfm-observe(job,aspect,ok,details,"observe/native-fp64-matrix-run.bml");
  def nfw-run() {
   let job = str_concat("fp64-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(now_unix_ms()))));
   let unused = nfm-open(); let unusedClosed = nfm-close(unused); let unusedStale = nothing?(jit_leaf_inram(record_get(unused,"request"),0));
   let owner = nfm-open(); let region = nfm-output(owner,32); let data = nfw-data(0,8192,list()); let scales = nfw-scales(0,256,list()); let x = nfw-vector(0,256,list()); let vector = nfm-vector(x);
   let premature = nothing?(nfm-close(owner)); let ran = nfm-mx8-run(owner,data,scales,vector,32,region); let raw = nfm-output-raw(region,0,32,list());
   let reference = nfr-rows(data,scales,256,0,32,x,list()); let parity = (((Comparable) ran == 32) && ((String) raw == nfm-pack(reference,list())));
   nfw-report(job,"ordered-arithmetic",parity,list(json-node-pair("rows",json-node-int(32)),json-node-pair("columns",json-node-int(256)),json-node-pair("raw-bytes",json-node-int(str_len(raw))),json-node-pair("exact",json-node-int(parity))));
   let before = kernel_stat(8); let boxed0 = kernel_stat(45); let capacity0 = kernel_stat(56); let maps0 = len(record_get(record_get(owner,"memory"),"regions")); let calls0 = kernel_stat(47); let started = now_unix_ms();
   let repeated = nfw-repeat(owner,data,scales,vector,region,256); let elapsed = (now_unix_ms() - started); let calls1 = kernel_stat(47); let after = kernel_stat(8); let boxed1 = kernel_stat(45); let capacity1 = kernel_stat(56); let maps1 = len(record_get(record_get(owner,"memory"),"regions"));
   let stable = ((String) raw == nfm-output-raw(region,0,32,list())); let residency = (((Comparable) (calls1 - calls0) == 256) && (repeated && (stable && (((Comparable) before == after) && (((Comparable) boxed0 == boxed1) && (((Comparable) capacity0 == capacity1) && ((Comparable) maps0 == maps1)))))));
   nfw-report(job,"reused-residency",residency,list(json-node-pair("repetitions",json-node-int(256)),json-node-pair("native-calls",json-node-int((calls1 - calls0))),json-node-pair("elapsed-ms",json-node-int(elapsed)),json-node-pair("boxed-intermediates",json-node-int((boxed1 - boxed0))),json-node-pair("float-growth",json-node-int((after - before))),json-node-pair("regions",json-node-int(maps1))));
   let foreignOwner = nfm-open(); let foreign = nfm-output(foreignOwner,32);
   let refused = (nothing?(nfm-mx8-run(owner,data,scales,vector,32,foreign)) && (nothing?(nfm-mx8-run(owner,data,scales,vector,32.5,region)) && nothing?(nfm-mx8-run(owner,substring(data,0,32),scales,vector,32,region))));
   let foreignMapClosed = npd-region-close(foreign); let foreignClosed = nfm-close(foreignOwner); let mapClosed = npd-region-close(region); let stale = nothing?(nfm-mx8-run(owner,data,scales,vector,32,region)); let closed = nfm-close(owner); let rawStale = nothing?(jit_leaf_inram(record_get(owner,"request"),0));
   let ownership = (((Comparable) unusedClosed == 1) && (unusedStale && (premature && (refused && (((Comparable) foreignMapClosed == 0) && (((Comparable) foreignClosed == 1) && (((Comparable) mapClosed == 0) && (stale && (((Comparable) closed == 1) && rawStale)))))))));
   nfw-report(job,"release-and-refusal",ownership,list(json-node-pair("unused-released",json-node-int(unusedClosed)),json-node-pair("map-released",json-node-int(((Comparable) mapClosed == 0))),json-node-pair("owner-released",json-node-int(closed)),json-node-pair("stale-refused",json-node-int((stale && rawStale)))));
   1;
  }
 }
 nfw-run();
}
