; Bounded native exchange: a cached refusal requests a fresh, detailed compile.
; Diagnostic payload is compiler status only; no private speech enters the frame.
; preludes: observe/preflight.fk observe/say.fk observe/bidirectional-framebuffer-channel.fk
(do
  (let target "form/form-stdlib/tests/form-glass-awareness-evolve-band.fk")
  (let observation (bfc-envelope 0 9701 0 (list "cached-refusal" target) "keep-evidence"))
  (let sent (bfc-record-out observation 0))
  (let control (bfc-control observation 5))
  (let received (bfc-record-in control 1))
  (let action (bfc-apply observation control "keep-evidence" "fresh-diagnostic"))
  (let output (if (str_eq action "fresh-diagnostic") (pf-fresh target) "no-action"))
  (let printed (say-line output))
  (let again (bfc-envelope 0 9702 0 (list "reobserved" (pf-errors output) (pf-warnings output) (len (pf-unresolved output))) "keep-evidence"))
  (let recorded (bfc-record-out again 2))
  0)
