; preflight-exec: forbidden
; Native 3B checkpoint, full LoRA update, byte-verified save and text generation.
; Only the public fixture "Hello, world!" is learned. Output stays under .hearth.
; preludes: form-stdlib/native-llama-voice.bml form-stdlib/native-lora-checkpoint.bml observe/bidirectional-framebuffer-channel.fk
(do
 (let dir ".hearth/native-llama-homecoming")
 (fs-mkdir dir)
 (let start (host_monotonic_ms))
 (let base (mr-path (mr-find "llama32-3b-mlx-4bit")))
 (let adapter "form/form-stdlib/adapters/llama-3.2-3b-voice")
 (let session (nlg-open base adapter))
 (let opened (host_monotonic_ms))
 (let model (head session)) (let tk (nth session 1))
 (print (list "schema" "native-llama-homecoming-v1" "model" base "model-bytes" (file_size (str_concat base "/model.safetensors")) "adapter" adapter "pairs" (nll-pair-count (nth model 1)) "open-ms" (sub opened start)))
 (let answer (nlg-ask session "Say hello in one short sentence." 40 "" "" (str_concat dir "/events.jsonl")))
 (print (list "voice" answer "voice-ms" (sub (host_monotonic_ms) opened)))
 (let tokens (append (list (nlt-special tk "<|begin_of_text|>")) (nlt-encode tk "Hello, world!")))
 (let inputs (take (sub (len tokens) 1) tokens)) (let targets (tail tokens))
 (let ctx (nll-context model (len tokens))) (let state (nlb-state model))
 (let before-model (nlb-health state 0 0 0.0))
 (let t0 (host_monotonic_ms)) (let g0 (metal_live))
 (let r (nll-forward model ctx inputs 0 1))
 (let t1 (host_monotonic_ms)) (let g1 (metal_live))
 (let before (nlb-backward model r targets state 1.0))
 (let t2 (host_monotonic_ms)) (let g2 (metal_live))
 (nll-forward-close r)
 (let observation (bfc-envelope 0 91033 0 (list before (len state) (sub t1 t0) (sub t2 t1)) -1))
 (bfc-record-out observation 0)
 (let control (bfc-control observation 6)) (bfc-record-in control 1)
 (let update (if (eq (bfc-payload control) 6) (nlb-safe-step state 0.00001 1 1.0) (form_error "native update was not selected")))
 (let r2 (nll-forward model ctx inputs 0 1))
 (let after (nlb-loss model r2 targets)) (nll-forward-close r2)
 (print (list "learning" "full-LoRA" "tokens" (len inputs) "loss-before" before "loss-after" after "forward-ms" (sub t1 t0) "backward-ms" (sub t2 t1) "forward-gpu-us" (sub (nth g1 11) (nth g0 11)) "backward-gpu-us" (sub (nth g2 11) (nth g1 11)) "update" update "parameters-before" before-model "parameters-after" (nlb-health state 0 0 0.0)))
 (let saveStart (host_monotonic_ms))
 (let saved (nlc-save (str_concat dir "/adapters.safetensors") (nlc-adapter-rows (nlb-pairs (nth model 1))) base 1))
 (let optimizer (nlc-save (str_concat dir "/optimizer.safetensors") (nlc-optimizer-rows state) base 1))
 (print (list "checkpoint" saved "optimizer" optimizer "save-ms" (sub (host_monotonic_ms) saveStart)))
 (nlb-state-close state) (nll-context-close ctx) (nlg-close session)
 (print (list "retained-buffers" (nth (metal_live) 2) "total-ms" (sub (host_monotonic_ms) start)))
 1)
