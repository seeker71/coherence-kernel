; model-compare-run.fk — one model through the SAME session door the
; hearth is born through: admit with a fixed prompt, generate a fixed
; budget, release cleanly. Prints admit-ms, generate-ms, per-token pace
; and the answer text, so two models witnessed by this door compare as
; likes. Effectful: opens the model, touches the GPU. Do not preflight.
; stdin line 1: model NAME from the registry (a raw gguf path is also
; honored for artifacts not yet rowed). line 2: token budget.
; preludes: form-stdlib/core.fk form-stdlib/form-cli-model-session.fk
(do
    (defn mc-line (k v) (print_str (str_concat "compare " (str_concat k (str_concat "=" (str_concat v (byte_to_str 10)))))))
    (defn mc-int (k v) (mc-line k (int_to_str v)))
    (let who (read_line))
    (let row (mr-find who))
    (let path (if (gt (str_len (mr-name row)) 0) (mr-path row) who))
    (let e0 (mc-line "model" (if (gt (str_len (mr-name row)) 0) (mr-name row) who)))
    (let e1 (if (gt (str_len (mr-name row)) 0) (mc-line "readiness" (mr-readiness row)) 0))
    (let budget (str_to_int (read_line)))
    (let t0 (now_unix_ms))
    (let s (fcms-open path "In one sentence: what does the tide leave on the shore?" 1024))
    (let t1 (now_unix_ms))
    (mc-line "status" (fcms-status s))
    (mc-line "reason" (fcms-reason s))
    (if (not (eq (fcms-live? s) 1))
        (mc-line "verdict" "refused")
        (do
            (mc-int "admit-ms" (sub t1 t0))
            (mc-int "admit-pos" (fcms-pos s))
            (let g (fcms-generate s budget))
            (let t2 (now_unix_ms))
            (mc-int "generate-ms" (sub t2 t1))
            (mc-int "ms-per-token" (div (sub t2 t1) budget))
            (mc-line "text" (fcms-generation-text g))
            (let released (fcms-release-ok? (fcms-generation-session g)))
            (mc-int "release-ok" released)))
    0)
