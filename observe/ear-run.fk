; ear-run.fk — hear the room through the ear's own principal: writes the
; request, launches Sema Ear.app through LaunchServices (the microphone grant
; binds to the bundle, never to a terminal — the one crossing here), waits
; with the caller's patience for the bundle's answer, prints it.
; stdin line 1: seconds (blank -> 5); line 2: language hint (blank -> auto).
; preflight-exec: forbidden
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk
(do
    (defn er-trim (s) (if (nothing? s) "" (trim s)))
    (defn er-text (t) (if (nothing? t) "" t))
    (defn er-wait (waited) (if (or (eq (fs-exists? ".hearth/ear.done") 1) (ge waited (hearth-review-wait-s))) waited (do (let r (hearth-rest-s (hearth-review-tick-s))) (er-wait (add waited (hearth-review-tick-s))))))
    (let seconds (do (let l (er-trim (read_line))) (if (eq (str_len l) 0) "5" l)))
    (let hint (er-trim (read_line)))
    (let mk (fs-mkdir ".hearth"))
    (let cleared (fs-remove-file ".hearth/ear.done"))
    (let req (write_file_text ".hearth/ear.request" (str_concat seconds (str_concat "\n" (str_concat hint "\n\n")))))
    (let launched (host-exec "open -n 'Sema Ear.app' 2>&1 && echo launched" ""))
    (print_str (str_concat "ear launch=" (str_concat (trim (er-text launched)) "\n")))
    (let waited (er-wait 0))
    (print_str (str_concat "ear waited-s=" (str_concat (int_to_str waited) (str_concat " done=" (str_concat (int_to_str (fs-exists? ".hearth/ear.done")) "\n")))))
    (print_str (er-text (read_file ".hearth/ear.out")))
    0)
