// One JSON stdin line: {"source":"a.fkb","target":"b.fkb","json":"optional/report.json"}.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/formbin-artifacts.bml form-stdlib/organ-health.bml
section [form.bml] {
 class ArtifactDiffDoor {
  def fbad-string(request, key) = if json-object-has?(request, key) then node_value(json-object-get(request, key)) else "";
  def fbad-field(request, key) = if json-object-has?(request, key) then eq(node_type(json-object-get(request, key)), 2) else 0;
  def fbad-refuse(reason) {
   let row = oh-reading("formbin-artifacts", "request", "request-admission", json-node-string("typed artifact path request"), json-node-string(reason), json-node-int(0), list(oh-need("artifact-request", json-node-string(reason))), list("retain-inputs"), json-node-null());
   oh-voice(row);
   let response = oh-response(row, "retain-inputs");
   oh-voice(response);
   let selected = oh-select(row, response, "retain-inputs");
   oh-voice(oh-applied(row, selected, json-node-object(list(fba-n("files_changed", 0)))));
   form_error(reason);
  }
  def fbad-admit(text) = if nothing?(text) then fbad-refuse("artifact diff needs a JSON request") else if not(jwa-valid(text)) then fbad-refuse("artifact diff request JSON invalid") else fbad-checked(parse-json("artifact-diff-request", text));
  def fbad-checked(request) = if and(fbad-field(request, "source"), and(fbad-field(request, "target"), if json-object-has?(request, "json") then fbad-field(request, "json") else 1)) then fbad-run(request) else fbad-refuse("artifact diff needs source and target path strings");
  def fbad-run(request) {
   let result = fba-diff(fbad-string(request, "source"), fbad-string(request, "target"));
   let rendered = fba-diff-render(result);
   let destination = fbad-string(request, "json");
   let row = oh-reading("formbin-artifacts", fbad-string(request, "source"), "structural-read", json-node-int(1), json-node-int(fbc-good(result)), json-node-int(fbc-good(result)), if fbc-good(result) then list() else list(oh-need("readable-artifacts", json-node-string(fbc-error(result)))), list("publish-report", "retain-inputs"), json-node-object(list(fba-s("source", fbad-string(request, "source")), fba-s("target", fbad-string(request, "target")))));
   oh-voice(row);
   let response = oh-response(row, if fbc-good(result) then "publish-report" else "retain-inputs");
   oh-voice(response);
   let selected = oh-select(row, response, "retain-inputs");
   let written = if not(str_eq(selected, "publish-report")) then eq(str_len(destination), 0) else if eq(str_len(destination), 0) then 1 else if fba-ensure-parent(destination) then eq(write_file(destination, str_concat(rendered, "\n")), add(str_len(rendered), 1)) else 0;
   oh-voice(oh-applied(row, selected, json-node-int(written)));
   oh-voice(oh-reading("formbin-artifacts", fbad-string(request, "source"), "report", json-node-int(1), json-node-int(written), json-node-int(written), list(), list("retain-inputs"), json-node-object(list(fba-s("report", destination)))));
   print(rendered);
   if not(fbc-good(result)) then form_error("artifact diff refused unreadable structure")
   else if not(written) then form_error("artifact diff report write incomplete")
   else if not(node_value(json-object-get(fbc-value(result), "structurally_equal"))) then form_error("artifacts differ structurally")
   else 0;
  }
 }
 fbad-admit(read_line());
}
