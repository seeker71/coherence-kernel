; jungle-ear-probe.fk — one line per 100 ms of the real room, in this organ's own
; coordinates. This is where a gate gets its number: from the jungle, not from taste.
;
; It writes nothing and learns nothing. It only shows what the mic gives, so the
; open gate, the close gate and the tolerances can be set by looking.
;
; stdin: one line, how many SECONDS (default 20).
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/jungle-ear.bml
(do
    (defn jep-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (jep-cat (tail xs)))))
    (defn jep-line () (do (let l (read_line)) (if (nothing? l) "" l)))
    (defn jep-secs () (do (let l (jep-line)) (if (eq (str_len l) 0) 20 (str_to_int l))))
    (defn jep-step (floor bed n endMs)
        (do (let now (now_unix_ms))
            (if (ge now endMs) n
              (do (let raw (sense_mic_stream_read 3200 200))
                  (let f (if (nothing? raw) (list) (je-frame raw now)))
                  (if (eq (len f) 0) (jep-step floor bed n endMs)
                    (do (let first (eq n 0))
                        (let fl (if first (je-f-db f) (je-floor-next floor (je-f-db f))))
                        (let bd (if first (je-f-db f) (je-bed-next bed (je-f-db f))))
                        (print (jep-cat (list
                            "db=" (int_to_str (je-db (je-f-db f)))
                            " flr=" (int_to_str (je-db fl))
                            " bed=" (int_to_str (je-db bd))
                            " overbed=" (int_to_str (div (sub (je-f-db f) bd) 10))
                            " overflr=" (int_to_str (div (sub (je-f-db f) fl) 10))
                            " br=" (int_to_str (je-f-br f)) "Hz"
                            " cr=" (int_to_str (je-f-cr f))
                            " mod=" (int_to_str (je-f-mod f))
                            " beats=" (int_to_str (je-f-beats f))
                            " tilt=" (int_to_str (je-f-tilt f)))))
                        (jep-step fl bd (add n 1) endMs)))))))
    (let secs (jep-secs))
    (let mic (sense_mic_stream_start))
    (let n (jep-step -500 -500 0 (add (now_unix_ms) (mul secs 1000))))
    (let stopped (sense_mic_stream_stop))
    (print (str_concat "frames=" (int_to_str n)))
    n)
