; zvec-grep-run.fk — stdin door for the Form-native zg search cell.
; stdin lines: root, route (rg|fts|vector|hybrid), query, limit.
; Blank root/route/limit use ., hybrid, and 7.
;
; preludes: form-stdlib/bml/zvec-grep.bml

(do
    (let root0 (read_line))
    (let route0 (read_line))
    (let query (read_line))
    (let limit0 (str_to_int (read_line)))
    (let root (if (str_eq root0 "") "." root0))
    (let route (if (str_eq route0 "") (ZgRouteHybrid) route0))
    (print_str (zg-render (zg-query-at root route query limit0)))
    0)
