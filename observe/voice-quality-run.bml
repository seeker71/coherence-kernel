// voice-quality-run.bml — text overlap against a retained source packet.
//
// stdin, one line per answer: <name>|<answer path>|<packet path, optional>
// Each line prints one reading and appends it to receipts/voice-quality-ledger.jsonl.
// Missing source and undefined percentages remain null. Claim support is not
// measured by digit overlap. Historical ledger rows retain their old schema.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-voice-quality.bml
section [form.bml] {
 class VoiceQuality {
  def vqr-ledger() = "receipts/voice-quality-ledger.jsonl";
  def vqr-field(parts,i) = if lt(len(parts),add(i,1)) then "" else trim(nth(parts,i));
  def vqr-line(line) {
   let parts = split-on(line,"|");
   let name = vqr-field(parts,0);
   let row = vq-reading(name,vqr-field(parts,1),vqr-field(parts,2));
   let appended = fhn-append(vqr-ledger(),str_concat(json-emit(row),"\n"));
   print_str(str_concat(json-emit-precise(row),"\n"));
  }
  def vqr-go() {
   let line0 = read_line();
   if nothing?(line0) then 0 else vqr-next(trim(line0));
  }
  def vqr-next(line) = if str_eq(line,"") then vqr-go() else vqr-then(vqr-line(line));
  def vqr-then(printed) = vqr-go();
 }
 vqr-go();
}
