// local-run-band.bml — form-stdlib/bml/local-run.bml records every ask where it is made, and the session measure counts it.
// No model runs: the results are the exact shape fcnv-ask returns, written to a scratch ledger. Last line: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/local-run.bml form-stdlib/bml/session-progress.bml
section [form.bml] {
 class LocalRunBand {
  def lrb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def lrb-path() = ".hearth/local-run-band.jsonl";
  def lrb-run() {
   let made = fs_mkdir(".hearth");
   let cleared = write_file_text(lrb-path(), "");
   let answered = ["answered", "text", 120, 300, "/m/model.gguf", 1, 1, "answered", "raw", [1, 2], ""];
   let spoken = ["answered", "text", 40, 10, "/m/base", 1, 1, "answered", "raw", [], "form/form-stdlib/adapters/x"];
   let refused = ["unavailable", "", 0, 0, "/m/none", 0, 1, "registry-model-artifact-absent", "", [], ""];
   let a1 = local-run-record-at(lrb-path(), answered);
   let a2 = local-run-record-at(lrb-path(), spoken);
   let a3 = local-run-record-at(lrb-path(), refused);
   let rows = ledger-rows(lrb-path(), "LocalRun");
   let r1 = lrb-row("each ask lands one row", ((String) a1 == "appended") && ((String) a2 == "appended") && ((String) a3 == "appended") && (len(rows) == 3));
   let r2 = lrb-row("a row keeps the IDs the prompt and the answer took", (row-get(rows[0], "prompt_ids") == 120) && (row-get(rows[0], "generated_ids") == 300));
   let r3 = lrb-row("a registry-weights ask and a lora ask are told apart", ((String) row-get(rows[0], "lane") == "registry-weights") && ((String) row-get(rows[1], "lane") == "native-metal-lora"));
   let r4 = lrb-row("a refused ask is a row too, with nothing generated", ((String) row-get(rows[2], "status") == "unavailable") && (row-get(rows[2], "generated_ids") == 0));
   let session = sp-session-now();
   let r5 = lrb-row("the host names the session that asked", len(session) > 0 && ((String) row-get(rows[0], "session") == session));
   let r6 = lrb-row("a session's rows are the ones it asked", len(local-run-of(rows, session)) == 3 && len(local-run-of(rows, "someone-else")) == 0);
   let r7 = lrb-row("the voice's count outweighs a smaller legacy count", sp-known-local(5, rows) == 310);
   let r8 = lrb-row("a larger legacy count is kept (an ask a draft made is in both)", sp-known-local(1000, rows) == 1000);
   let r9 = lrb-row("with no recorded runs the legacy count stands", sp-known-local(7, []) == 7);
   print_str("[local-run-band] " ++ value_str(r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9) ++ " of 9");
  }
 }
 lrb-run();
}
