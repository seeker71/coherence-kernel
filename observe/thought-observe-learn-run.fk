; Thought observe closes into learning-loop without a GGUF.
; preludes: form-stdlib/local-generate-organ.fk
(do
    (let a (lg-observe "Compute (add 2 3) then (mul 6 7)." (empty)))
    (let b (lg-observe "What is the square of 7?" (nth a 1)))
    (str_concat "thought-eval="
    (str_concat (nth a 3)
    (str_concat "\nstructure-wins="
    (str_concat (int_to_str (ll-wins (nth a 1) 1))
    (str_concat "\nsoft-trials="
    (str_concat (int_to_str (ll-trials (nth b 1) 2))
    (str_concat "\nchampion="
    (str_concat (int_to_str (nth b 2))
    (str_concat "\nsoft-default-empty="
                (int_to_str (eq (len (lg-think "What is the square of 7?")) 0))))))))))))
)
