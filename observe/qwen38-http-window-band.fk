; qwen38-http-window-band.fk — prove the native HTTPS carrier can return an
; actual Qwen3.8 range larger than its former 65,535-byte response ceiling.
;
; preludes: form-stdlib/core.fk form-stdlib/kernel-http.fk

(do
    (let url "https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-Q8_0.gguf?download=true")
    (let hs (list (kh-header "Range" "bytes=0-131071")))
    (let first (http_get url hs 120000))
    (let first-headers (_get first "headers"))
    (let location (kh-header-value-or first-headers "Location" ""))
    (let second (http_get location hs 120000))
    (let second-headers (_get second "headers"))
    (let body (_get second "body"))
    (list
        (_get first "status_code")
        (str_len location)
        (kh-header-value-or first-headers "X-Linked-Size" "")
        (kh-header-value-or first-headers "X-Linked-ETag" "")
        (_get second "status_code")
        (str_len body)
        (substring body 0 4)
        (kh-header-value-or second-headers "Content-Range" "")
        (_get second "error")))
