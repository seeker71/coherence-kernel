; qwen38-http-window-band.fk — native HTTPS still answers a Qwen3.8
; redirect, inside the seed's 65,535-byte body ceiling.
;
; The rescue branch grew runtime/fkwu-uni.c's SSL buffer to 256 MB so a
; 128 KiB range would fit. That C-seed growth is refused at this landing:
; curl remains the 29 GB byte carrier (Form owns the offset ledger), and
; the seed's body ceiling stays 65,535 until a Form streaming organ writes
; ranges into the mapped file without enlarging the walker.
;
; This cell asks for 4 KiB, which fits today. A 128 KiB native window is
; named, not claimed.
;
; preludes: form-stdlib/core.fk form-stdlib/kernel-http.fk

(do
    (let url "https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-Q8_0.gguf?download=true")
    (let hs (list (kh-header "Range" "bytes=0-4095")))
    (let first (http_get url hs 120000))
    (let first-headers (_get first "headers"))
    (let location (kh-header-value-or first-headers "Location" ""))
    (let second (http_get location hs 120000))
    (let second-headers (_get second "headers"))
    (let body (_get second "body"))
    (list
        (_get first "status_code")
        (str_len location)
        (kh-header-value-or first-headers "X-Linked-Size" "")
        (kh-header-value-or first-headers "X-Linked-ETag" "")
        (_get second "status_code")
        (str_len body)
        (substring body 0 4)
        (kh-header-value-or second-headers "Content-Range" "")
        (_get second "error")))
