// form-find-ask.bml — ask the form-find service one question: one wire JSON on stdin, the wire's JSON answer on stdout.
//
// This is the cold-start client: `./fkwu observe/form-find-ask.bml` is a whole process (the runtime opened, the closure read), which is the
// cost the zero-process form avoids. The agents' normal lookup is the shell's own redirect into the spool, with no process begun:
//
//   SP=/tmp/form-find/$UID; printf '%s' '{"command":"defs fat-wire-call"}' > $SP/ask.$$.json
//   until [ -s $SP/ans.$$.json ]; do :; done; cat $SP/ans.$$.json; rm -f $SP/ans.$$.json     (docs/form-native-agent-tools.md)
//
// This door does the same in Form: it writes ask.<pid>-<ms>.json into the spool, waits with host_sleep_ms up to a deadline
// (FORM_FIND_DEADLINE_MS, default 3000) for ans.<pid>-<ms>.json, prints it and removes it. A service that is not there (no status.json,
// or one whose beat is older than 10 s) is not waited for: the question is answered by the cold door, an index this process builds for
// itself (fnd-cold: seconds, once), never by a host tool. A service that stands but does not answer in time is a named refusal.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-find.bml form-stdlib/bml/stdin-source.bml
import form-stdlib/bml/form-find.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class FormFindAsk {
  def ffa-deadline() = fat-natural(host_getenv("FORM_FIND_DEADLINE_MS") ?? "") ? str_to_int(host_getenv("FORM_FIND_DEADLINE_MS") ?? "") : 3000;
  def ffa-name() = host_pid().str() ++ "-" ++ host_monotonic_ms().str();
  def ffa-beat-age(dir) = (String) value_kind(host_file_identity(dir ++ "/status.json")) == "list" ? now_unix_ms() - host_file_identity(dir ++ "/status.json")[1] : 1000000000;
  def ffa-standing?(dir) = ffa-beat-age(dir) < 10000;
  def ffa-wait(path, until) {
   let text = read_file(path);
   (!nothing?(text) && len(text) > 0) ? text : host_monotonic_ms() >= until ? nothing() : ffa-nap(path, until);
  }
  def ffa-nap(path, until) {
   let z = host_sleep_ms(10);
   ffa-wait(path, until);
  }
  def ffa-ask(dir, line) {
   let name = ffa-name();
   let ask = dir ++ "/ask." ++ name ++ ".json";
   let ans = dir ++ "/ans." ++ name ++ ".json";
   let z = write_file_text(ask, line);
   let got = ffa-wait(ans, host_monotonic_ms() + ffa-deadline());
   let z2 = host_path_remove(ans);
   nothing?(got) ? fat-wire-refusal("form-find-service-silent: no answer in " ++ ffa-deadline().str() ++ " ms; the service beats but did not answer") : got;
  }
  def ffa-line() = fat-trim(stdin-text());
  def ffa-run() {
   let dir = fnd-spool();
   let line = ffa-line();
   print_str(ffa-standing?(dir) ? ffa-ask(dir, line) : fnd-cold(line));
  }
 }
 ffa-run();
}
