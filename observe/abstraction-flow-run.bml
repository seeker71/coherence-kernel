// Empty stdin refreshes the guide. First line: source path. Optional second
// line: the workload's stdin file (otherwise /dev/null). Runs real effects.
import form-stdlib/bml/abstraction-flow.bml;
section [form.bml] {
 let owner = read_line();
 if nothing?(owner) || owner == "" then print_str(af-guide()) else {
  let input = read_line();
  af-round(owner,nothing?(input) || input == "" ? "/dev/null" : input);
 };
}
