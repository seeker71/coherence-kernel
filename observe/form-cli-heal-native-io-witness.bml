// Source protection exercised in disposable files, never in production cells.
// preludes: form-stdlib/bml/form-cli-heal-native-io.bml
section [form.bml] {
 class HealNativeIOWitness {
  def hni-main() {
   let root = fhn-unique(fhn-at(fhn-root(), ".form-heal"), "io-native-witness-", 0);
   let spool = fs_mkdir(fhn-at(root, ".form-heal"));
   let job = fhn-unique(fhn-at(root, ".form-heal"), "attempt-", 0);
   let source = write_file(fhn-at(root, "source.fk"), "(add 1 1)\n");
   let checker = write_file(fhn-at(root, "checker.fk"), "2\n");
   let paths = list("source.fk", "checker.fk");
   let names = write_file(fhn-at(job, "names.txt"), fhn-lines(paths));
   let nuls = write_file(fhn-at(job, "names.nul"), fhn-nuls(paths));
   let sealed = fhn-prepare-sealed(job, root, "source.fk", "checker.fk", paths);
   let sealOk = and(str_eq(sealed, job), str_eq(fhn-guard(job), "clean"));
   let badChecker = write_file(fhn-at(job, "work/checker.fk"), "999\n");
   let guardOk = str_eq(fhn-guard(job), "changed:checker.fk");
   let reset = fhn-reset(job);
   let resetOk = and(str_eq(reset, "ready"), str_eq(fhn-read(fhn-at(job, "work/checker.fk")), "2\n"));
   let badLive = write_file(fhn-at(root, "source.fk"), "(add 3 3)\n");
   let staleOk = fh-has(fhn-reset(job), "refused:stale-input");
   let restored = write_file(fhn-at(root, "source.fk"), "(add 1 1)\n");
   let proposed = write_file(fhn-at(job, "candidate"), "(add 2 2)\n");
   let checked = write_file(fhn-at(job, "work/source.fk"), "(add 2 2)\n");
   let raced = write_file(fhn-at(job, "candidate"), "(add 9 9)\n");
   let raceOk = fh-has(fhn-commit(job, fhn-at(job, "candidate")), "refused:");
   let replaced = write_file(fhn-at(job, "candidate"), "(add 2 2)\n");
   let committed = fhn-commit(job, fhn-at(job, "candidate"));
   let commitOk = and(str_eq(committed, "applied"), str_eq(fhn-read(fhn-at(root, "source.fk")), "(add 2 2)\n"));
   let finish = fhn-finish(job);
   let released = and(str_eq(finish, "snapshot-released;evidence-retained"), lt(file_size(fhn-at(job, "source.tar")), 0));
   print_str(str_concat("evidence=", str_concat(job, "\n")));
   list("native-io-witness", sealOk, guardOk, resetOk, staleOk, raceOk, commitOk, released);
  }
 }
 hni-main();
}
