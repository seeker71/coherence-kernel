// Send a retained, unchanged organ JSONL path on stdin. The source is read only.
// Observe the production command, not a second projection implementation.
// preludes: form-stdlib/bml/form-core-care.bml
section [form.bml] {
 class CareViewWitness {
  def cvw-assert(ok,meaning) = if ok then 1 else form_error(meaning);
  def cvw-repeat(owner,arg,count,bytes) = if eq(count,0) then bytes else cvw-repeat(owner,arg,sub(count,1),add(bytes,str_len(occ-command-at(owner,arg))));
  // Collection is driven by the live heap, so a fixed number of commands is
  // not evidence that it happened. This observation stops after a real cycle;
  // its finite exercise budget is separate from the reader's runtime policy.
  def cvw-exercise(owner,arg,before,strings,commands,bytes) = if and(ge(commands,128),and(gt(nth(kernel_live(host_pid()),21),before),gt(kernel_stat(51),strings))) then list(commands,bytes) else if ge(commands,4096) then form_error("care witness exercise budget ended before observed collection") else cvw-exercise(owner,arg,before,strings,add(commands,128),cvw-repeat(owner,arg,128,bytes));
  def cvw-run(path) {
   let input = read_file(path);
   cvw-assert(and(not(nothing?(input)),gt(str_len(input),0)),"care view witness needs a nonempty retained event source");
   let owner = ohc-open();
   let request = json-node-object(list(json-node-pair("sources",json-node-array(list(json-node-string(path)))),oh-n("budget_bytes",str_len(input))));
   cvw-assert(ohc-request-valid(request),"care view witness needs a valid source path");
   let arg = json-emit-precise(request);
   let first = parse-json("care-view-first",occ-command-at(owner,arg));
   cvw-assert(eq(json-int-value(oh-get(first,"read_bytes")),str_len(input)),"first care command consumes the retained event bytes");
   cvw-assert(gt(len(json-array-elements(oh-get(first,"signals"))),0),"retained source supplies actual organ observations");
   let retained = occ-view-request-at(owner,request); let text = jv-emit(retained);
   let before = nth(kernel_live(host_pid()),21); let strings = kernel_stat(51); let start = host_monotonic_ms(); let minted = kernel_stat(53);
   let exercised = cvw-exercise(owner,arg,before,strings,0,0);
   let commands = head(exercised); let bytes = nth(exercised,1);
   let growth = sub(kernel_stat(53),minted); let elapsed = sub(host_monotonic_ms(),start);
   let cycles = sub(nth(kernel_live(host_pid()),21),before); let reclaimed = sub(kernel_stat(51),strings);
   cvw-assert(eq(growth,0),"warmed retained care command including serialization mints no primary nodes");
   cvw-assert(and(gt(cycles,0),gt(reclaimed,0)),"this observation must cross collection and reclaim temporary strings");
   cvw-assert(str_eq(jv-emit(retained),text),"retained projection remains exact through collection");
   cvw-assert(str_eq(json-emit-precise(jv-materialize(retained)),text),"explicit node admission preserves exact serialized value");
   cvw-assert(str_eq(read_file(path),input),"retained event input stayed unchanged");
   json-emit-precise(json-node-object(list(oh-s("schema","care-view-lifetime-witness-v1"),oh-n("accepted",1),oh-n("commands",commands),oh-n("primary_mints",growth),oh-n("collector_cycles",cycles),oh-n("reclaimed_strings",reclaimed),oh-n("emitted_bytes",bytes),oh-n("elapsed_ms",elapsed),oh-n("retained_view_exact",1),oh-n("explicit_node_exact",1),oh-s("scope","warmed explicit-source commands; first admission excluded; current collector and event nodes remain seed-backed"))));
  }
 }
 let input = read_line();
 if or(nothing?(input),str_eq(trim(input),"")) then 0 else cvw-run(trim(input));
}
