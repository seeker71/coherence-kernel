; qwen-teach-glass-run.fk — the Qwen weight adaptation the body carries
; today, present and witnessed on the shared glass: the teach layer is an
; OVERLAY (a small written slot, base tensors bit-identical), not a gradient
; delta — the organ says so itself; LoRA on Qwen stays unclaimed until an
; MLX-format Qwen or the native writer stands. Publisher voice.qwen.
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-adapter.bml form/form-stdlib/form-cli-qwen-teach-layer.fk form/form-stdlib/symbol-voice.bml
(do
    (defn qtg-row (id purpose n lifecycle epoch) (fgtm-sample id (fgtm-absent) "qwen-teach" "form" "voice.qwen" "voice" purpose (fgtm-absent) (fgtm-present n) lifecycle (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "form-cli-qwen-teach-layer" (la-tags)))
    (let epoch (now_unix_ms))
    (let applied (fqt-adapter-applied?))
    (let observed (fqt-adapter-observed?))
    (let pairs (fqt-corpus-pairs))
    (let rows (list
        (qtg-row "voice.qwen.adapter" (str_concat "kind-" (fqt-adapter-kind)) (fqt-dim) (if (eq applied 1) "active" "stored") epoch)
        (qtg-row "voice.qwen.applied" (if (eq applied 1) "applied" "not-applied") applied (if (eq applied 1) "active" "idle") epoch)
        (qtg-row "voice.qwen.observed" (if (eq observed 1) "observed" "not-observed") observed (if (eq observed 1) "ready" "idle") epoch)
        (qtg-row "voice.qwen.corpus-pairs" "teach-pairs" pairs "stored" epoch)
        (qtg-row "voice.qwen.lora" "unclaimed-no-mlx-qwen-no-native-writer" 0 "idle" epoch)))
    (let published (fgtm-publish-snapshot (hearth-telemetry-root) "voice.qwen" epoch rows))
    (let sym (la-cat (list "you BE qwen adapter:" (fqt-adapter-kind) " applied:" (int_to_str applied) " observed:" (int_to_str observed) " pairs:" (int_to_str pairs) " dim:" (int_to_str (fqt-dim)) " glass:" (nth published 1) " | seam lora:unclaimed")))
    (print_str (str_concat "symbols: " (str_concat sym "\n")))
    (print_str (str_concat "expanded: " (str_concat (sv-say sym) "\n")))
    0)
