; qwen38-rms-span-parity-run.fk — the model-width RMS radius asked on the device.
;
; Two 5120-wide rows (all 1s and all 2s) cross both defined paths:
;   - q38-rms, which must select the serial attestant beyond n=4096;
;   - form_rmsnorm_span_f32, one independent serial thread per token row.
; The outputs are compared byte-for-byte with each other and with the exact all-1
; normalized row. This is effectful: it JIT-compiles MSL and dispatches Metal.
; Do not preflight; run it directly.
;
; preludes: form/native/metal/qwen35-dense-token-handle.fk

(do
    (defn qrsp-u32 (n)
        (str_concat
            (str_concat (byte_to_str (mod n 256))
                        (byte_to_str (mod (div n 256) 256)))
            (str_concat (byte_to_str (mod (div n 65536) 256))
                        (byte_to_str (mod (div n 16777216) 256)))))
    (defn qrsp-rep32 (bits n acc)
        (if (eq n 0) acc
            (qrsp-rep32 bits (sub n 1) (str_concat acc (qrsp-u32 bits)))))
    (defn qrsp-line (k v) (print (str_concat k (str_concat "=" v))))
    (defn qrsp-int (k v) (qrsp-line k (int_to_str v)))

    (let d 5120)
    (let ntok 2)
    (let row-bytes (mul d 4))
    (let ones (qrsp-rep32 1065353216 d ""))
    (let twos (qrsp-rep32 1073741824 d ""))
    (let span-in (str_concat ones twos))
    (let x0 (metal_buf_alloc row-bytes))
    (let x1 (metal_buf_alloc row-bytes))
    (let xs (metal_buf_alloc (mul ntok row-bytes)))
    (let g (metal_buf_alloc row-bytes))
    (let y0 (metal_buf_alloc row-bytes))
    (let y1 (metal_buf_alloc row-bytes))
    (let ys (metal_buf_alloc (mul ntok row-bytes)))
    (let w0 (metal_buf_write x0 0 ones))
    (let w1 (metal_buf_write x1 0 twos))
    (let ws (metal_buf_write xs 0 span-in))
    (let wg (metal_buf_write g 0 ones))
    (let ps (q38-pipes (q38-msl)))
    (let gtv (list g 1 d 0))
    (let eps (md-f32-bits 0.0))
    (metal_batch_concurrent)
    (let e0 (q38-rms ps x0 gtv y0 d eps 0))
    (let e1 (q38-rms ps x1 gtv y1 d eps 0))
    (let es (q38-rms-span ps xs gtv ys d eps ntok 0))
    (let r0 (metal_buf_read y0 0 row-bytes))
    (let r1 (metal_buf_read y1 0 row-bytes))
    (let rs (metal_buf_read ys 0 (mul ntok row-bytes)))
    (let rs0 (substring rs 0 row-bytes))
    (let rs1 (substring rs row-bytes (mul ntok row-bytes)))
    (let row0-parity (if (str_eq r0 rs0) 1 0))
    (let row1-parity (if (str_eq r1 rs1) 1 0))
    (let row0-truth (if (str_eq r0 ones) 1 0))
    (let row1-truth (if (str_eq r1 ones) 1 0))
    (let status (metal_status))
    (let clean (if (ge (str_find status "last_error=none" 0) 0) 1 0))
    (let opened (if (and (gt x0 0) (and (gt x1 0) (and (gt xs 0)
                    (and (gt g 0) (and (gt y0 0) (and (gt y1 0) (gt ys 0))))))) 1 0))
    (let wrote (if (and (eq w0 row-bytes) (and (eq w1 row-bytes)
                    (and (eq ws (mul ntok row-bytes)) (eq wg row-bytes)))) 1 0))
    (let enqueued (if (and (eq e0 1) (and (eq e1 1) (eq es 1))) 1 0))
    (let verdict (sum (list opened (mul wrote 2) (mul enqueued 4)
                    (mul row0-parity 8) (mul row1-parity 16)
                    (mul row0-truth 32) (mul row1-truth 64) (mul clean 128))))
    (qrsp-int "width" d)
    (qrsp-int "tokens" ntok)
    (qrsp-int "cooperative-selected" (if (q38-rms-cooperative? d) 1 0))
    (qrsp-int "buffers-opened" opened)
    (qrsp-int "writes-complete" wrote)
    (qrsp-int "dispatches-enqueued" enqueued)
    (qrsp-int "row0-byte-parity" row0-parity)
    (qrsp-int "row1-byte-parity" row1-parity)
    (qrsp-int "row0-truth" row0-truth)
    (qrsp-int "row1-truth" row1-truth)
    (qrsp-int "verdict" verdict)
    (qrsp-line "last-error-none" (if (eq clean 1) "yes" "no"))
    (metal_buf_free x0)
    (metal_buf_free x1)
    (metal_buf_free xs)
    (metal_buf_free g)
    (metal_buf_free y0)
    (metal_buf_free y1)
    (metal_buf_free ys)
    (if (eq verdict 255) 0 (sub 0 1)))
