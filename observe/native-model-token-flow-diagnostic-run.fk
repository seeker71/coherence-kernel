; native-model-token-flow-diagnostic-run.fk — bounded physical Metal flow.
;
; This opens a new 16-byte fixture only.  It neither touches nor describes the
; internals of a standing model owner.  Expert fields are absent because this
; dense fixture has no MoE router; absence is retained through the typed wire.
; Four framebuffer events carry only numeric stage state, never prompt text.
;
; preludes: form/form-stdlib/native-model-token-flow.bml form/form-stdlib/metal-door.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn nmtfp-msl ()
        "#include <metal_stdlib>\nusing namespace metal; kernel void form_flow_copy_u32(device uint* d [[buffer(0)]], constant uint& n [[buffer(1)]], uint i [[thread_position_in_grid]]) { if (i < n) d[i] = d[i] + 1u; }")
    (defn nmtfp-status-int (status name)
        (do (let key (str_concat name "="))
            (let at (str_find status key 0))
            (if (lt at 0) -1
                (do (let start (add at (str_len key)))
                    (let stop (str_find status "\n" start))
                    (if (lt stop 0) -1 (str_to_int (substring status start stop)))))))
    (defn nmtfp-fields (token-pos token-id layer tensor bytes expert weight pipeline handle fb start end duration)
        (list token-pos token-id layer tensor bytes expert weight pipeline handle fb start end duration))
    (defn nmtfp-blank ()
        (nmtfp-fields (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent) (fgtm-absent)))
    (defn nmtfp-event (stage seq parent fields epoch evidence)
        (nmtf-event (nmtf-form-event-node-id "model-flow-fixture" "model-flow-fixture.flow-1" stage seq)
            parent "model-flow-fixture" "model-flow-fixture.flow-1" stage seq
            "bounded-probe" "bounded-metal-fixture"
            (nth fields 0) (nth fields 1) (nth fields 2) (nth fields 3)
            (nth fields 4) (nth fields 5) (nth fields 6) (nth fields 7)
            (nth fields 8) (nth fields 9) (nth fields 10) (nth fields 11)
            (nth fields 12) epoch "active" evidence "bounded-metal-probe"))
    (defn nmtfp-publish-prefix (events)
        (do (let result (nmtf-publish-events "/tmp/form-glass-telemetry" "model-flow-fixture" (now_unix_ms) events))
            (let waited (host-exec "/bin/sleep 0.25" ""))
            result))

    (let absent (fgtm-absent))
    (let fb-before (len (framebuffer-events)))
    (let repair-out (bfc-envelope 0 420 0 (list 1 0) -1))
    (let d0 (bfc-record-out repair-out 1))
    (let repair-in (bfc-control repair-out 2))
    (let d1 (bfc-record-in repair-in 2))
    (let repair-state (if (eq (bfc-payload repair-in) 2) 1 0))
    (let buffer (metal_buf_alloc 16))
    (let wrote (metal_buf_write buffer 0 (str_concat (md-le32 7) (str_concat (md-le32 11) (str_concat (md-le32 13) (md-le32 17))))))
    (let pipeline (metal_pipeline (nmtfp-msl) "form_flow_copy_u32"))
    (let before (metal_status))
    (let start-ms (now_unix_ms))
    (let queued (metal_enqueue pipeline (md-bind (list buffer) (list 4)) 4))
    (let readback (metal_buf_read buffer 0 16))
    (let end-ms (now_unix_ms))
    (let after (metal_status))
    (let gpu-us (sub (nmtfp-status-int after "gpu_busy_us_total") (nmtfp-status-int before "gpu_busy_us_total")))
    (let wall-us (mul (sub end-ms start-ms) 1000))
    (let verify-out (bfc-envelope 0 421 0 (list queued 0) -1))
    (let d2 (bfc-record-out verify-out 3))
    (let verify-in (bfc-control verify-out 0))
    (let d3 (bfc-record-in verify-in 4))

    (let q (nmtfp-event "request" 1 absent (nmtfp-blank) (now_unix_ms) "physical-live"))
    (let t (nmtfp-event "token" 2 (fgtm-present (nmtf-event-node-id q)) (nmtfp-fields (fgtm-present 0) (fgtm-present 7) absent absent absent absent absent absent absent absent absent absent absent) (now_unix_ms) "physical-live"))
    (let l (nmtfp-event "layer" 3 (fgtm-present (nmtf-event-node-id t)) (nmtfp-fields absent absent (fgtm-present 0) absent absent absent absent absent absent absent absent absent absent) (now_unix_ms) "physical-live"))
    (let x (nmtfp-event "tensor" 4 (fgtm-present (nmtf-event-node-id l)) (nmtfp-fields absent absent (fgtm-present 0) (fgtm-present "fixture.input.u32") (fgtm-present 16) absent absent absent absent absent absent absent absent) (now_unix_ms) "physical-live"))
    (let e (nmtfp-event "expert" 5 (fgtm-present (nmtf-event-node-id x)) (nmtfp-fields absent absent (fgtm-present 0) absent absent absent absent absent absent absent absent absent absent) (now_unix_ms) "physical-live"))
    (let m (nmtfp-event "metal" 6 (fgtm-present (nmtf-event-node-id e)) (nmtfp-fields absent absent (fgtm-present 0) absent absent absent absent (fgtm-present "form_flow_copy_u32") (fgtm-present buffer) absent (fgtm-present (mul start-ms 1000)) (fgtm-present (mul end-ms 1000)) (fgtm-present wall-us)) (now_unix_ms) "physical-live"))
    (let f (nmtfp-event "framebuffer" 7 (fgtm-present (nmtf-event-node-id m)) (nmtfp-fields absent absent absent absent absent absent absent absent absent (fgtm-present (node_inst d2)) absent absent absent) (now_unix_ms) "physical-live"))
    (let g (nmtfp-event "glass" 8 (fgtm-present (nmtf-event-node-id f)) (nmtfp-blank) (now_unix_ms) "physical-live"))

    (let p1 (nmtfp-publish-prefix (list q)))
    (let p2 (nmtfp-publish-prefix (list q t)))
    (let p3 (nmtfp-publish-prefix (list q t l)))
    (let p4 (nmtfp-publish-prefix (list q t l x)))
    (let p5 (nmtfp-publish-prefix (list q t l x e)))
    (let p6 (nmtfp-publish-prefix (list q t l x e m)))
    (let p7 (nmtfp-publish-prefix (list q t l x e m f)))
    (let final (nmtf-publish-events "/tmp/form-glass-telemetry" "model-flow-fixture" (now_unix_ms) (list q t l x e m f g)))
    (let fb-delta (sub (len (framebuffer-events)) fb-before))
    (let freed (metal_buf_free buffer))
    (print_str "model=bounded-metal-fixture standing-owner-internals=unclaimed")
    (print_str (str_concat "events=8 cadence-ms=250 publish=" (nth final 1)))
    (print_str (str_concat "metal-buffer=" (int_to_str buffer)))
    (print_str (str_concat "metal-pipeline=" (int_to_str pipeline)))
    (print_str (str_concat "wall-us=" (int_to_str wall-us)))
    (print_str (str_concat "gpu-us=" (int_to_str gpu-us)))
    (print_str "expert-index=absent expert-weight=absent reason=dense-fixture")
    (print_str (str_concat "framebuffer-events=" (int_to_str fb-delta)))
    (print_str "node-shape=u16.u16.u16.u32 type=operator-family instance=operation")
    (sum (list
        (if (gt buffer 0) 1 0)
        (if (gt pipeline 0) 2 0)
        (if (eq wrote 16) 4 0)
        (if (eq queued 1) 8 0)
        (if (and (eq (str_len readback) 16) (eq (str_byte_at readback 0) 8)) 16 0)
        (if (ge gpu-us 0) 32 0)
        (if (str_eq (nth final 1) "published") 64 0)
        (if (and (eq fb-delta 4) (and (eq repair-state 1) (eq freed 1))) 128 0))))
