// jit-node-witness-run.bml — step 1 of docs/bml-direct-nodes-jit.md: a Form producer builds code nodes with jit_node(["node", t, c1, c2, c3]) and
// walks one with jit_node(["run", k]); the built node must answer as the text route's does (add 40 2 -> 42), a string literal node runs as its text,
// and a tag outside 1..4095 is refused as nothing.
//   ./fkwu observe/jit-node-witness-run.bml
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NodeProbe {
  def np-text() = 40 + 2;
  def np-run() {
   let a = jit_node(["node", 1, 40]);
   let b = jit_node(["node", 1, 2]);
   let c = jit_node(["node", 3, a, b]);
   let s = jit_node(["node", 24, "hello"]);
   print_str("[node-probe] built add 40 2 -> " ++ value_str(jit_node(["run", c])) ++ " ; text route -> " ++ np-text().str());
   print_str("[node-probe] string node runs as " ++ value_str(jit_node(["run", s])) ++ " ; word " ++ value_str(jit_node(["word", s])));
   print_str("[node-probe] refused tag 0 -> " ++ value_str(jit_node(["node", 0, 1])));
   print_str("[node-probe] refused a fifth element -> " ++ value_str(jit_node(["node", 3, a, b, 0, 9])));
   print_str("[node-probe] three children kept whole -> " ++ value_str(nothing?(jit_node(["node", 3, a, b, 0])) ? "nothing" : "a node"));
  }
 }
 np-run();
}
