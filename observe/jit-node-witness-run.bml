// jit-node-witness-run.bml — steps 1 and 2 of docs/bml-direct-nodes-jit.md: a Form producer builds code nodes with jit_node(["node", t, c1, c2, c3]), registers a function
// with ["defn", name, arity] and ["body", idx, node], and walks nodes with ["run", k]; what it built must answer as the text route does, and every refusal is named
// (["why"]) instead of being read short, padded or fatal.
//   ./fkwu observe/jit-node-witness-run.bml
// One line a claim, then "[node-witness] held N of M". preflight-exec: forbidden
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NodeWitness {
  def nw-text(x) = x + 1;
  def nw-shape(x) = nothing?(x) ? 0 : x * 3 + 1;
  def nw-spin(n, arg, acc) = n == 0 ? acc : nw-spin(n - 1, arg, acc + nw-shape(arg));
  // a recipe that answers nothing on one branch and a list on the other (every reader's commonest shape), and a search over two string parameters: the crystallizer takes both
  def nw-pick(x) = x > 0 ? [x] : nothing();
  def nw-pick-run(k, acc) = k == 0 ? acc : nw-pick-run(k - 1, acc + (nothing?(nw-pick(k % 3)) ? 100 : len(nw-pick(k % 3))));
  def nw-sf(h, n, f) = str_find(h, n, f) + 1;
  def nw-sf-run(k, acc) = k == 0 ? acc : nw-sf-run(k - 1, acc + nw-sf("alpha beta gamma beta", "beta", k % 30) + nw-sf("abc", "", k % 5) + nw-sf("abc", "zz", 0) + nw-sf("abc", "c", 0 - k));
  // a loop over a string parameter that cuts a substring in the middle of its body and compares it to another string parameter (the shape of every reader that matches a word at an offset)
  def nw-cnt(t, w, p, lim, acc) = p >= lim ? acc : nw-cnt(t, w, p + 1, lim, acc + ((String) substring(t, p, p + 4) == w ? 1 : 0));
  def nw-cnt-run(k, acc) = k == 0 ? acc : nw-cnt-run(k - 1, acc + nw-cnt("alpha beta gamma beta", "beta", 0, 21, 0));
  // every bit door in one recipe: the first call (cold, the walker's own answer) is the reference the hot calls (the crystallizer's) must repeat
  def nw-bitmix(a, b) = band(a, b) + bor(a, b) + bxor(a, b) + shl_u32(a, b % 40) + shr_u32(a, b % 7) + rotr_u32(a, b % 35) + add_u32(a, b * 1000000) + bnot_u32(a);
  def nw-bitmix-run(k, a, acc) = k == 0 ? acc : nw-bitmix-run(k - 1, a, acc + nw-bitmix(a + k % 3, 678 + k % 5));
  // a recipe whose parameters are a record and a node (words of no kind a leaf reads by itself): carried raw, read through the walker's own doors (record_has/record_get, node_children/node_value, str_eq of a field)
  def nw-opget(r, k) = record_has(r, k) ? record_get(r, k) : 0 - 1;
  def nw-opget-run(k, r, acc) = k == 0 ? acc : nw-opget-run(k - 1, r, acc + nw-opget(r, "alpha") + nw-opget(r, "zz"));
  def nw-opnode(nd) = node_value(head(node_children(nd)));
  def nw-opnode-run(k, nd, acc) = k == 0 ? acc : nw-opnode-run(k - 1, nd, acc + (nothing?(nw-opnode(nd)) ? 1 : 2));
  // lets inside the arms of an if (two in a row, one inside another arm), and a list index (nth) answering a word: the reference sums are worked out by hand
  def nw-nl(x, s) = x > 0 ? { let y = x * 3; let z = y + str_byte_at(s, 0); z * 2 + y; } : 0;
  def nw-nl2(x) = x > 0 ? { let y = x * 3; y > 10 ? { let w = y - 10; w + y; } : y; } : 0;
  def nw-nl-run(k, acc) = k == 0 ? acc : nw-nl-run(k - 1, acc + nw-nl(k % 7, "abc") + nw-nl2(k % 9));
  def nw-nth(l, i) = nth(l, i) + 1;
  def nw-nth-run(k, l, acc) = k == 0 ? acc : nw-nth-run(k - 1, l, acc + nw-nth(l, k % 3));
  def nw-native(name) = foldl((a, r) => (String) r[1] == name ? r[7] : a, 0, kernel_page_hot(host_pid(), 400));
  def nw-n(t, a, b, c) = jit_node(["node", t, a, b, c]);
  def nw-chain(n, leaf) = n <= 0 ? leaf : nw-n(27, nw-chain(n - 1, leaf), leaf, 0);
  def nw-claim(label, ok) { print_str("[node-witness] " ++ (ok ? "held " : "FAILED ") ++ label); ok ? 1 : 0; }
  def nw-run() {
   // a built add 40 2 answers as the text route does
   let a = nw-n(1, 40, 0, 0);
   let b = nw-n(1, 2, 0, 0);
   let c = nw-n(3, a, b, 0);
   let c1 = nw-claim("a built add 40 2 answers 42, the text route's answer", jit_node(["run", c]) == 42);
   // a string literal node runs as its text and its word is whole
   let s = jit_node(["node", 24, "hello", 0, 0]);
   let c2 = nw-claim("a string literal node runs as its text", jit_node(["run", s]) == "hello");
   // refusals are named
   let r0 = jit_node(["node", 0, 1, 0, 0]);
   let w0 = jit_node(["why"]);
   let r1 = jit_node(["node", 300, 0, 0, 0]);
   let w1 = jit_node(["why"]);
   let r2 = jit_node(["node", 3, a, b, 0, 9]);
   let w2 = jit_node(["why"]);
   let r3 = jit_node(["node", 3, a]);
   let w3 = jit_node(["why"]);
   let c3 = nw-claim("a tag outside the walker's 1..255 is refused, why 2 (tag 0 and tag 300)", nothing?(r0) && w0 == 2 && nothing?(r1) && w1 == 2);
   let c4 = nw-claim("a fifth element is refused, why 3", nothing?(r2) && w2 == 3);
   let c5 = nw-claim("a short spec is refused, never padded, why 4", nothing?(r3) && w3 == 4);
   // a word longer than any the door knows answers nothing and the process lives
   let r4 = jit_node(["inlineXXXXXXXXXXXX", 1]);
   let c6 = nw-claim("a word longer than eight bytes is an unknown word, why 1, the process lives", nothing?(r4) && jit_node(["why"]) == 1);
   // more than sixteen leaves are kept whole
   let leaf = nw-n(1, 7, 0, 0);
   let long = nw-chain(19, leaf);
   let kids = jit_node(["kids", long]);
   let c7 = nw-claim("a str_concat chain of 20 leaves answers all 20 (the buffer grew, nothing dropped)", !nothing?(kids) && len(kids) == 20);
   // a function built from rows: f(x) = x + 1, called with 5, answers 6 like the text route
   let idx = jit_node(["defn", "nw-built-f", 1]);
   let slot0 = nw-n(1, 0, 0, 0);
   let read0 = nw-n(110, slot0, 0, 0);
   let one = nw-n(1, 1, 0, 0);
   let sum = nw-n(3, read0, one, 0);
   let bound = jit_node(["body", idx, sum]);
   let five = nw-n(1, 5, 0, 0);
   let cell = nw-n(242, five, -1, 0);
   let call = nw-n(241, idx, cell, 0);
   let c8 = nw-claim("a registered function reads its arity and a second body is refused", jit_node(["arity", idx]) == 1 && nothing?(jit_node(["body", idx, sum])) && jit_node(["why"]) == 9);
   let c9 = nw-claim("a function built from rows, called with 5, answers 6 as the text route does (" ++ nw-text(5).str() ++ ")", jit_node(["run", call]) == 6 && nw-text(5) == 6);
   let found = jit_node(["lookup", "nw-built-f"]);
   let c10 = nw-claim("lookup finds the registered name, and an unregistered name is refused, why 10", found == idx && nothing?(jit_node(["lookup", "nw-no-such-fn"])) && jit_node(["why"]) == 10);
   // a refusal is a verdict on one parameter shape: a recipe run first over nothing, then over numbers, is asked again for the numbers (kernel_stat 92) and answers as the walker does
   let first = nw-spin(3000, nothing(), 0);
   let second = nw-spin(6000, 7, 0);
   let c11 = nw-claim("a recipe run over nothing, then over numbers, answers both right (reasked " ++ kernel_stat(92).str() ++ ")", first == 0 && second == 132000);
   // nothing as one arm of an if (answered raw beside a list): the same sum the walker gives (k%3 == 0 -> nothing -> 100, else a one-element list -> 1), and the recipe stands native
   let pr = nw-pick-run(6000, 0);
   let c12 = nw-claim("a recipe answering nothing or a list answers as the walker does (" ++ pr.str() ++ ") and stands native (column " ++ nw-native("nw-pick").str() ++ ")", pr == 2000 * 100 + 4000 * 1 && nw-native("nw-pick") == 1);
   let sr = nw-sf-run(5000, 0);
   let c13 = nw-claim("a search over two string parameters answers as the walker does (" ++ sr.str() ++ ") and stands native (column " ++ nw-native("nw-sf").str() ++ ")", sr == 66242 && nw-native("nw-sf") == 1);
   let cr = nw-cnt-run(3000, 0);
   let c14 = nw-claim("a loop cutting a substring in its body and comparing it to a string parameter answers as the walker does (" ++ cr.str() ++ ") and stands native (column " ++ nw-native("nw-cnt").str() ++ ")", cr == 6000 && nw-native("nw-cnt") > 0);
   // the reference: the same sum summed cold, each term evaluated once by the walker before the recipe is ever hot (nw-bitmix-run over a short run stays under the heat boundary)
   let ref-sum = nw-bitmix-run(30, 12345, 0);
   let bm = nw-bitmix-run(3000, 12345, 0);
   let c15 = nw-claim("every bit door in one recipe answers as the walker does (" ++ bm.str() ++ " against " ++ (ref-sum * 100).str() ++ ") and its loop, with the doors inlined, stands native (column " ++ nw-native("nw-bitmix-run").str() ++ ")", bm == ref-sum * 100 && nw-native("nw-bitmix-run") > 0);
   let rec = record_set(record_set(record_new(0), "alpha", 5), "beta", 7);
   let og = nw-opget-run(5000, rec, 0);
   let nd = intern_node(intern_trivial_string("cat"), [intern_trivial_int(7), intern_trivial_int(2)]);
   let on = nw-opnode-run(5000, nd, 0);
   let c16 = nw-claim("a recipe over a record answers as the walker does (" ++ og.str() ++ ") and stands native with its loop (columns " ++ nw-native("nw-opget").str() ++ ", " ++ nw-native("nw-opget-run").str() ++ ")", og == 20000 && nw-native("nw-opget") == 1 && nw-native("nw-opget-run") > 0);
   let c17 = nw-claim("a recipe over a node (children, head, value) answers as the walker does (" ++ on.str() ++ ") and its loop stands native (column " ++ nw-native("nw-opnode-run").str() ++ ")", on == 10000 && nw-native("nw-opnode-run") > 0);
   let nlr = nw-nl-run(5000, 0);
   let c18 = nw-claim("lets inside the arms of an if answer as worked by hand (" ++ nlr.str() ++ " of 1048649) and the loop stands native (column " ++ nw-native("nw-nl-run").str() ++ ")", nlr == 1048649 && nw-native("nw-nl-run") > 0);
   let ntr = nw-nth-run(6000, [10, 20, 30], 0);
   let c19 = nw-claim("a list index answers as the walker does (" ++ ntr.str() ++ " of 126000 = 2000 cycles of 11 + 21 + 31 + 0) and the loop stands native (column " ++ nw-native("nw-nth-run").str() ++ ")", ntr == 126000 && nw-native("nw-nth-run") > 0);
   let held = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19;
   print_str("[node-witness] held " ++ held.str() ++ " of 19");
   held;
  }
 }
 nw-run();
}
