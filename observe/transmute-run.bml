// transmute-run.bml — the door: an event in, the body's reading of which of its ideas the event serves, told by its own
// voice, with the source kept whole and the register and resonance measured.
//
//   printf '%s\n%s\n%s\n%s\n%s\n' "$SOURCE" "$MODEL" "$IDEAS_INDEX" "$CONCEPTS_INDEX" "$EVENT" | ./fkwu observe/transmute-run.bml
//
// stdin, five parts: line 1 the source (a URL or a name, may be empty); line 2 the model — "0" reads without the voice,
// blank asks the registry's answer model, a registry id asks that one (qwen38-q4 when the Q8 would not fit beside
// another session's lease: the memory governor decides); line 3 a path to the field's ideas index (ideas/INDEX.md rows,
// may be empty); line 4 a path to the concepts index (docs/vision-kb/INDEX.md lines with Hz, may be empty); every line
// after is the event. With no seeds at all the door falls back to the passage transmutation of the first slice.
// Prints the reading line, the resonant seeds the body chose, the lifted words, and the voice's five layers; appends
// one TransmuteRow to receipts/transmute-ledger.jsonl with the ideas the voice named that the seeds hold.
// The organ is form-stdlib/bml/transmute.bml; the voice is form-stdlib/bml/form-cli-native-voice.bml, rent 0.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/transmute.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint TransmuteRow { at_unix_ms: int, source: string, bytes_in: int, bytes_out: int, lifts: int, register_before: int, register_after: int, seeds: int, resonant: int, ideas_served: list<string>, voice: string }
 class TransmuteRun {
  def tmr-ledger() = "receipts/transmute-ledger.jsonl";
  def tmr-shown-concepts() = 24;
  def tmr-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def tmr-rest-go(acc) { let l = read_line(); nothing?(l) ? acc : tmr-rest-go(acc ++ l ++ "\n"); }
  def tmr-ids(ss) = map(s => tm-sid(s), ss);
  def tmr-join(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ ", " ++ tmr-join(xs[1:]);
  def tmr-run() {
   let source = tmr-line();
   let flag = tmr-line();
   let ideasPath = tmr-line();
   let conceptsPath = tmr-line();
   let passage = trim(tmr-rest-go(""));
   let lifts = tm-lifts(passage);
   let before = tm-register(passage);
   let seeds = tm-seeds-at(ideasPath, conceptsPath);
   let resonant = tm-resonance(seeds, passage);
   let shown = tm-shown(seeds, resonant, tmr-shown-concepts());
   let packet = nil?(seeds) ? tm-packet(source, passage, lifts) : tm-event-packet(source, passage, lifts, shown);
   let request = (Comparable) len(flag) == 0 ? json-node-object([]) : (String) flag == "lora" ? json-node-object([oh-s("lane", "lora")]) : json-node-object([oh-s("model", flag)]);
   let asked = (String) flag == "0" ? ["not-asked", ""] : fcnv-ask(packet, request);
   let answer = (String) asked[0] == "answered" ? trim(asked[1]) : "";
   let after = tm-register(answer);
   let served = tm-served(answer, seeds);
   let said = print_str("[transmute] source=" ++ ((Comparable) len(source) == 0 ? "(none)" : source) ++ " · " ++ len(passage).str() ++ " bytes in · seeds " ++ len(seeds).str() ++ " · resonant " ++ len(resonant).str() ++ " · words lifted " ++ len(lifts).str() ++ " · register before " ++ before.str() ++ " after " ++ after.str() ++ " · ideas served " ++ len(served).str() ++ ((Comparable) len(served) == 0 ? "" : " (" ++ tmr-join(tmr-ids(served)) ++ ")") ++ " · voice=" ++ asked[0] ++ "\n");
   let resonated = nil?(resonant) ? 0 : print_str("the body's own resonance read (shared words · seed):\n" ++ tm-resonant-lines(tm-take(resonant, 8)));
   let lifted = (Comparable) len(lifts) == 0 ? 0 : print_str("lifted:\n" ++ tm-lift-lines(lifts));
   let told = len(answer) > 0 ? print_str("\n" ++ answer ++ "\n") : 0;
   let kept = ledger-append(tmr-ledger(), TransmuteRow{at_unix_ms: now_unix_ms(), source: source, bytes_in: len(passage), bytes_out: len(answer), lifts: len(lifts), register_before: before, register_after: after, seeds: len(seeds), resonant: len(resonant), ideas_served: tmr-ids(served), voice: asked[0]});
   0;
  }
 }
 tmr-run();
}
