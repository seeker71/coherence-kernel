// transmute-run.bml — the door: a passage in, the body's own voice out, the source kept whole, the register measured.
//
//   printf 'https://example.org/story\n\nThe passage text...\n' | ./fkwu observe/transmute-run.bml
//
// stdin: line 1 the source (a URL or a name, may be empty); line 2 "0" to read without asking the voice, blank to ask
// the registry's answer model, or a registry model id (qwen38-q4 when the Q8 would not fit beside another session's
// lease — the memory governor decides); every line after is the passage. Prints the reading line, the lifted words,
// and the transmutation; appends one
// TransmuteRow to receipts/transmute-ledger.jsonl. The organ is form-stdlib/bml/transmute.bml; the voice is the
// registry's answer model inside the fkwu session (form-stdlib/bml/form-cli-native-voice.bml), rent 0.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/transmute.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint TransmuteRow { at_unix_ms: int, source: string, bytes_in: int, bytes_out: int, lifts: int, register_before: int, register_after: int, voice: string }
 class TransmuteRun {
  def tmr-ledger() = "receipts/transmute-ledger.jsonl";
  def tmr-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def tmr-rest-go(acc) { let l = read_line(); nothing?(l) ? acc : tmr-rest-go(acc ++ l ++ "\n"); }
  def tmr-run() {
   let source = tmr-line();
   let flag = tmr-line();
   let passage = trim(tmr-rest-go(""));
   let lifts = tm-lifts(passage);
   let before = tm-register(passage);
   let request = (Comparable) len(flag) == 0 ? json-node-object([]) : json-node-object([oh-s("model", flag)]);
   let asked = (String) flag == "0" ? ["not-asked", ""] : fcnv-ask(tm-packet(source, passage, lifts), request);
   let answer = (String) asked[0] == "answered" ? trim(asked[1]) : "";
   let after = tm-register(answer);
   let said = print_str("[transmute] source=" ++ ((Comparable) len(source) == 0 ? "(none)" : source) ++ " · " ++ len(passage).str() ++ " bytes in · words lifted " ++ len(lifts).str() ++ " · register before " ++ before.str() ++ " after " ++ after.str() ++ " · voice=" ++ asked[0] ++ "\n");
   let lifted = (Comparable) len(lifts) == 0 ? 0 : print_str("lifted:\n" ++ tm-lift-lines(lifts));
   let told = len(answer) > 0 ? print_str("\n" ++ answer ++ "\n") : 0;
   let kept = ledger-append(tmr-ledger(), TransmuteRow{at_unix_ms: now_unix_ms(), source: source, bytes_in: len(passage), bytes_out: len(answer), lifts: len(lifts), register_before: before, register_after: after, voice: asked[0]});
   0;
  }
 }
 tmr-run();
}
