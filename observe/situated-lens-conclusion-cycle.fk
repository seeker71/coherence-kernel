; situated-lens-conclusion-cycle.fk — a missing or ambiguous time/lens
; relation opens a bounded bidirectional framebuffer exchange, applies a real
; control action, and re-observes the conclusion.
;
; The cycle never creates evidence. request-evidence can admit one
; caller-offered, source-attributed row only when it is valid, exactly matches
; the missing coordinate, and would not create ambiguity.
;
; Policy:
;   settled value -> continue (0)
;   invalid       -> revise (2)
;   ambiguous     -> abstain (3)
;   missing       -> request evidence (4)
;
; State after actuation:
;   [field, selected-node, action, accepted]
;
; A successful evidence request selects the offered row's source node.
; Abstention selects the outbound alternative node and leaves the field
; untouched. Missing/mismatched control also selects the alternative.
;
; The policy/actuator crosses four-way in
; form-stdlib/tests/situated-lens-conclusion-control-band.fk. This cell is the
; honest fkwu binding because the actual framebuffer carrier is not a
; proof-sibling operation.
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk observe/bidirectional-framebuffer-channel.fk
; witnessed: 2026-07-26 -> 131071 on fkwu;
; pure controller/actuator 65535 four-way

(do
    (defn slcc-outbound
        (exchange outcome field time lens alternative)
        (bfc-envelope 0 exchange 0
            (slcc-payload outcome field time lens)
            alternative))
    (defn slcc-control (outbound outcome)
        (bfc-control outbound (slcc-action outcome)))

    (defn slcc-correlated-control? (outbound inbound)
        (if (or (nothing? inbound)
            (or (not (eq (bfc-direction inbound) 1))
            (or (not (eq (bfc-kind inbound) 1))
                (not (eq (bfc-exchange outbound)
                         (bfc-exchange inbound)))))) 0 1))
    (defn slcc-apply
        (outbound inbound field offered time lens current-node)
        (if (eq (slcc-correlated-control? outbound inbound) 0)
            (slcc-state field (bfc-alternative outbound) -1 0)
            (slcc-apply-action (bfc-payload inbound)
                field offered time lens current-node
                (bfc-alternative outbound))))

    ; [before, outbound-1, inbound-1, applied-state,
    ;  after, outbound-2, inbound-2, frames-added]
    (defn slcc-cycle
        (exchange scope offered-word inquiry base margin field
            time lens inner offered-row alternative)
        (do
            (let frames-before (len (framebuffer-events)))
            (let before (slc-settle-situated
                scope offered-word inquiry base margin field time lens inner))
            (let outbound-1
                (slcc-outbound exchange before field time lens alternative))
            (let out-event-1
                (bfc-record-out outbound-1 (mul exchange 2)))
            (let inbound-1 (slcc-control outbound-1 before))
            (let in-event-1
                (bfc-record-in inbound-1 (add (mul exchange 2) 1)))
            (let state (slcc-apply outbound-1 inbound-1 field offered-row
                time lens (slc-o-node before)))
            (let field-after (slcc-s-field state))
            (let after (slc-settle-situated
                scope offered-word inquiry base margin
                field-after time lens inner))
            (let exchange-2 (add exchange 1))
            (let outbound-2
                (slcc-outbound exchange-2 after
                    field-after time lens alternative))
            (let out-event-2
                (bfc-record-out outbound-2 (mul exchange-2 2)))
            (let inbound-2 (slcc-control outbound-2 after))
            (let in-event-2
                (bfc-record-in inbound-2 (add (mul exchange-2 2) 1)))
            (list before outbound-1 inbound-1 state
                after outbound-2 inbound-2
                (sub (len (framebuffer-events)) frames-before))))

    (defn slcc-c-before (cycle) (nth cycle 0))
    (defn slcc-c-outbound-1 (cycle) (nth cycle 1))
    (defn slcc-c-inbound-1 (cycle) (nth cycle 2))
    (defn slcc-c-state (cycle) (nth cycle 3))
    (defn slcc-c-after (cycle) (nth cycle 4))
    (defn slcc-c-outbound-2 (cycle) (nth cycle 5))
    (defn slcc-c-inbound-2 (cycle) (nth cycle 6))
    (defn slcc-c-frames (cycle) (nth cycle 7))

    0)
