// What a Qwen session of 12288 positions asks for, beside the flat margin.
import form-stdlib/form-cli-model-session.fk;
import form-stdlib/bml/memory-governor.bml;
section [form.bml] {
 def qpb-toy() = [4, 8, 1, 2, 2, 2, 0, 0, 1, 1, 4, 4, 2, 1, 2, 2, 0, 0, 8, 10, 2, 4, 2, 3];
 def qpb-run() = {
  let toy = q38-private-bytes(qpb-toy(), 1);
  print_str("toy");
  print_str(toy.str());
  let path = mr-path(mr-find("qwen38-q4"));
  let src = fcmg-src(path);
  let geo = q38-geo(src, 12288);
  let private = fcms-qwen-private(src, 12288);
  let weights = fcms-weights-bytes(path);
  let verdict = mg-ask((weights + private));
  print_str("layers");
  print_str(geo[21].str());
  print_str("interval");
  print_str(geo[22].str());
  print_str("private");
  print_str(private.str());
  print_str("weights");
  print_str(weights.str());
  print_str(verdict[1]);
  toy;
 };
 qpb-run();
}
