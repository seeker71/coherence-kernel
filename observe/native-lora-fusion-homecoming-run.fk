; Native standalone model built from the existing 16-layer authoring adapter.
; Public one-word probe before/after; model stays under .hearth.
; preflight-exec: forbidden
; preludes: learn/train-loop-execute.fk
(do
 (let base (tlp-base-model)) (let adapter (tlp-authoring-adapter))
 (let out (str_concat ".hearth/native-fusion-" (int_to_str (host_pid))))
 (let prompt "Answer with one word only. what does the body mean by cragmoor? If it is not a word the body holds, reply exactly: nothing.")
 (let before (nlg-once base adapter prompt 0 "" "" ".hearth/native-fusion-before.jsonl"))
 (print (list "before" before))
 (let fused (tle-fuse adapter out)) (print (list "fusion" fused))
 (if (not (str_eq (tloa-report-value fused "exit") "0")) (form_error "native fusion worker failed") 0)
 (let generation (nfg-resolve out))
 (print (read_file (str_concat generation "/fusion-receipt.json")))
 (let reuse-start (host_monotonic_ms)) (let reused (tle-fuse adapter out))
 (print (list "reuse-ms" (sub (host_monotonic_ms) reuse-start) "reuse" reused "worker-result" (read_file (str_concat (tloa-report-value reused "log") "/stdout.log"))))
 (if (not (and (str_eq (tloa-report-value reused "exit") "0") (str_eq generation (nfg-resolve out)))) (form_error "native fusion reuse failed") 0)
 (let after (nlg-once generation "" prompt 0 "" "" (str_concat generation "/generation-events.jsonl")))
 (print (list "after" after "same-text" (str_eq (head before) (head after)) "retained" (nth (metal_live) 2)))
 (if (and (eq (str_len (nth before 1)) 0) (eq (str_len (nth after 1)) 0)) 1 (form_error "native fusion probe did not complete")))
