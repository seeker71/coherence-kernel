// ear-live-native.fk — the ear's live lane, the body's own: the native microphone stream
// (sense_mic_stream_read, 200 ms at a time), a window of the audio since the last commit (at
// most 8 s), the body's own whisper pass on every arrival once speech is heard — whisper-tiny by
// default, or the registry's native large-v3-turbo when .hearth/ear.model reads "turbo" (its live line
// is the plain no-timestamps pass) — one frame per pass into the ear spool. A standing .hearth/ear.cadence
// passes on everything and closes only on the full window, for a room whose steady sound (a song) the
// floor would otherwise learn as quiet. Speech is a level above the
// room's own quiet, with a two-hop soft onset; the decoder's own end timestamp, a real pause at the mic, or a
// full window commits the line: a heard frame naming which of the three closed it, and
// one line for the tongue lane (t_end, tongue, text). While the line grows, every
// pass that changes it hands the tongue lane the line as it stands (a "live" segment line, so
// the tongues grow with the words). No host tool, no python:
// the crossings are the microphone and the model files. The window is held as the list of the
// mic's own chunks, oldest first: a hop appends one and drops what is past 8 s, the level reads the
// last three, and the window is joined into one string only for a pass. stdin: run seconds,
// reserved language line, optional owner lease. Blank owner keeps the standalone door.
// preflight-exec: forbidden
import form/form-stdlib/spool-bell-transport.fk;
import form/form-stdlib/hearth.bml;
import form/form-stdlib/bml/ear-worker-life.bml;
import form/form-stdlib/bml/ear-acoustic-review.bml;
import form/form-stdlib/native-whisper.bml;
section [form.bml] {
    def el-spool() = ".hearth/ear.spool";
    def el-segs() = ".hearth/ear.spool.segments";
    def el-stop() = ".hearth/ear.spool.stop";
    def el-window() = ELWindowBytes();
    // the ear's model is a standing choice: .hearth/ear.model reads "turbo" for the registry's native
    // large-v3-turbo through nws-open (the same st shape), anything else for whisper-tiny's npz. Turbo's live
    // pass is the plain no-timestamps line (eac-open-plain); tiny keeps its timestamp-prompted line.
    def el-model() = file_size(".hearth/ear.model") < 0 ? "" : trim(en-text(read_file(".hearth/ear.model")));
    def el-turbo?() = (String) el-model() == "turbo";
    // cadence: a standing .hearth/ear.cadence file asks the lane to pass on everything it hears and to close a
    // line only when the window is full — for a room whose steady sound (a song) the floor follower would
    // otherwise learn as quiet, and whose pauses would cut the line into sub-second pieces
    def el-cadence?() = file_size(".hearth/ear.cadence") >= 0;
    // a pass that takes longer than a chunk must not let the microphone pile up behind it: after the
    // waited read, everything already buffered is taken at once, so the window stays at the present
    def el-drain(acc) = len(acc) < 3200 ? acc : {
        let more = sense_mic_stream_read(3200, 0);
        (Comparable) len(more) == 0 ? acc : el-drain(((String) acc + more));
    };
    // how often this lane writes a frame whether or not the line moved: its own pulse,
    // and the only thing a watcher can read to tell a lane that is thinking from one that is gone
    def el-beat() = 800;
    def el-cat(xs) = (Comparable) len(xs) == 0 ? "" : ((String) xs[0] + el-cat(xs[1:]));
    def el-nl() = byte_to_str(10);
    def el-kv(k, v) = el-cat([k, "=", v, el-nl()]);
    def el-emit(kind, db, live, livelang, livems, heard, lang, heardms, nsp) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", kind), el-kv("db", db.str()), el-kv("live", live), el-kv("livelang", livelang), el-kv("livems", livems.str()), el-kv("heard", heard), el-kv("lang", lang), el-kv("nsp", nsp.str()), el-kv("heardms", heardms.str()), "<|/ear:frame|>", el-nl()]));
        w;
    };
    // the window: chunks oldest first; a push appends the fresh chunk and cuts the front to the last 8 s
    def el-wlen(win) = (Comparable) len(win) == 0 ? 0 : (Number) len(win[0]) + (Number) el-wlen(win[1:]);
    def el-cut-front(win, excess) = excess <= 0 || (Comparable) len(win) == 0 ? win : excess >= len(win[0]) ? el-cut-front(win[1:], excess - len(win[0])) : cons(substring(win[0], excess, len(win[0])), win[1:]);
    def el-push(win, fresh) = {
        let w1 = append(win, [fresh]);
        el-cut-front(w1, el-wlen(w1) - el-window());
    };
    // level: rms over the last 300 ms (the newest chunks up to 9600 bytes), every fourth sample; dBFS from the thresholds 32768 * 10^(dB/20)
    def el-s16(s, i) = {
        let v = (Number) str_byte_at(s, i) + (Number) (256 * str_byte_at(s, (Number) i + (Number) 1));
        v >= 32768 ? v - 65536 : v;
    };
    def el-sumsq(s, i, end, acc) = i >= end ? acc : {
        let v = el-s16(s, i);
        el-sumsq(s, (Number) i + (Number) 8, end, (Number) acc + (Number) (v * v));
    };
    def el-newest(rwin, need, acc) = need <= 0 || (Comparable) len(rwin) == 0 ? acc : el-newest(rwin[1:], need - len(rwin[0]), cons(rwin[0], acc));
    def el-sumsq-all(xs, acc) = (Comparable) len(xs) == 0 ? acc : el-sumsq-all(xs[1:], el-sumsq(xs[0], 0, len(xs[0]), acc));
    def el-rms(win) = {
        let xs = el-newest(reverse(win), 9600, []);
        let cnt = el-wlen(xs) / 8;
        cnt <= 0 ? 0 : el-isqrt(el-sumsq-all(xs, 0) / cnt, 0, 32768);
    };
    def el-isqrt(v, lo, hi) = lo >= hi ? lo : {
        let mid = ((Number) lo + (Number) ((Number) hi + (Number) 1)) / 2;
        mid * mid > v ? el-isqrt(v, lo, mid - 1) : el-isqrt(v, mid, hi);
    };
    def el-db(rms) = elp-db(rms);
    // The BML listening policy owns onset, hysteresis, pre-roll, and bounded gain.
    // This displayed gate admits candidates; the ASR doubt and word checks still decide words.
    def el-gate(fl) = elp-enter(fl);
    // Tag filtering, repetition handling, and both acoustic views share one BML organ.
    // eac-open crops the PCM and peak metadata at the same phrase cut before
    // encoding. Its first timestamp is the front padding in that encoder buffer;
    // the newest sample still stands at the eight-second buffer's end.
    // ── what closes a line, and what each close costs ─────────────────────────────────────────
    // Because the buffer's end IS the newest sample, the decoder's own last timestamp read against
    // that end says how much silence WHISPER heard at the tail: its own voice-activity judgment, at
    // 20 ms resolution, over the audio it just encoded, for no extra pass. That is an earlier and
    // truer end than a wall clock over a level gate, and it is what closes a line now — the decoder
    // placed its end at least el-decoder-pause before the newest sample AND the words have not
    // changed since the previous pass. Failing that, a real pause at the mic; failing that, the
    // window filling. The heard frame names WHICH of the three closed it, so what each one costs
    // is read off the spool instead of argued.
    def el-ticks() = el-window() / 640;
    def el-tail-sil(ids) = {
        let e = enw-last-ts(ids);
        e < 0 ? 0 - 1 : 20 * (el-ticks() - e);
    };
    // a live pass that changed the line: the live frame for the glass, and the line as it stands for the
    // tongue lane ("live", the segment's cut, the last sample's time, tongue, text).
    // the live frame carries what the line is AND how settled it is: `stable` counts the passes in
    // a row that have said the same words, so a reader can paint a line as settled long before it
    // is closed; `gate` and `floor` are the room's own quiet and the level standing over it — the
    // one instrument that would have found today's wound in a single look.
    def el-quality-fields(h) = el-cat([el-kv("avglp", h[9].str()), el-kv("gainmilli", h[10].str()), el-kv("revision", "open-phrase")]);
    def el-review-fields(review) = (Comparable) len(review) == 0 ? "" : (Comparable) len(review[1]) == 0 ? "" : el-cat([el-kv("review", review[1]), el-kv("reviewms", review[2].str()), el-kv("firstlp", review[3].str()), el-kv("reviewlp", review[4].str())]);
    def el-emit-live(db, h, livems, tend, seg, stable, fl) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", "live"), el-kv("db", db.str()), el-kv("live", h[1]), el-kv("livelang", h[0]), el-kv("livems", livems.str()), el-kv("encms", h[2].str()), el-kv("decms", h[3].str()), el-kv("ntok", h[4].str()), el-kv("heard", ""), el-kv("lang", ""), el-kv("nsp", h[7].str()), el-kv("heardms", "0"), el-kv("stable", stable.str()), el-kv("floor", fl.str()), el-kv("gate", el-gate(fl).str()), el-kv("tags", h[8]), el-quality-fields(h), "<|/ear:frame|>", el-nl()]));
        let seg = sbt-append(el-segs(), el-cat(["live", byte_to_str(9), seg.str(), byte_to_str(9), tend.str(), byte_to_str(9), h[0], byte_to_str(9), h[1], el-nl()]));
        seg;
    };
    // the closed line, with the reason it closed and the two numbers that reason cost: the silence
    // the decoder itself heard at the tail, and the passes the words held still for
    def el-emit-heard(db, best, why, closems, stable, tsil, settled, review) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", "heard"), el-kv("db", db.str()), el-kv("live", ""), el-kv("livelang", ""), el-kv("livems", "0"), el-kv("heard", best[1]), el-kv("lang", best[0]), el-kv("nsp", best[7].str()), el-kv("heardms", closems.str()), el-kv("why", why), el-kv("stable", stable.str()), el-kv("tailsil", tsil.str()), el-kv("settled", settled.str()), el-kv("tags", best[8]), el-quality-fields(best), el-review-fields(review), "<|/ear:frame|>", el-nl()]));
        w;
    };
    // ── settled, long before closed ───────────────────────────────────────────────────────────
    // Measured on this room (the ear path table): a line's words were already final 1.0 to
    // 2.5 seconds before anything closed it. The close waits for the room, and it should — a
    // speaker mid-thought is not finished. But the READER does not have to wait for the room. So
    // the instant the words have held still for el-settled passes, they are given once as settled:
    // the same text, marked, with the wait it saved measured on the frame. It stays an open line —
    // if the speaker says more, the live frames simply keep moving.
    // It is given to the spool only. The tongue lane reads two segment shapes and a third would be
    // misread as a closed line, and the tongues are already following the live line word by word.
    def el-settled() = 3;
    // ── and a line the pass did not believe either ────────────────────────────────────────────
    // The doubt the model reports is about the WINDOW — whether anyone spoke at all — and a
    // confident hallucination passes it easily. Its average log-probability is about the WORDS,
    // and on five lines measured in this room it separated them cleanly: the one line nobody said
    // (", and the other side of the screen,") read -2311 per-mille where the four real ones read
    // -86, -311, -431 and -1098 — the last of those a Persian sentence the tiny model heard badly
    // but really. The reference implementation refuses a segment under -1000; that number would
    // have thrown away the real Persian line, so the line here is drawn where this room's own
    // readings separate, and it is five lines in one room, not a law.
    def el-emit-stable(db, h, saved, stable, fl) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", "stable"), el-kv("db", db.str()), el-kv("live", h[1]), el-kv("livelang", h[0]), el-kv("livems", "0"), el-kv("heard", ""), el-kv("lang", ""), el-kv("nsp", h[7].str()), el-kv("heardms", "0"), el-kv("stable", stable.str()), el-kv("savedms", saved.str()), el-kv("floor", fl.str()), el-kv("gate", el-gate(fl).str()), el-quality-fields(h), "<|/ear:frame|>", el-nl()]));
        w;
    };
    // the room, when nobody is speaking. It carries the gate: that row is the instrument that
    // finds a gate standing on the noise floor, and a room is quiet most of the time, so an
    // instrument only present mid-sentence is an instrument that is not there when it is needed.
    def el-emit-quiet(db, fl) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", "quiet"), el-kv("db", db.str()), el-kv("live", ""), el-kv("livelang", ""), el-kv("livems", "0"), el-kv("heard", ""), el-kv("lang", ""), el-kv("nsp", "0"), el-kv("heardms", "0"), el-kv("floor", fl.str()), el-kv("gate", el-gate(fl).str()), "<|/ear:frame|>", el-nl()]));
        w;
    };
    // a pass that heard nothing BUT a tag: the room's own sound, named. It is never a line, never
    // reaches the tongues, and is not silence either — so it travels as its own kind.
    def el-emit-phantom(db, tags, nsp) = el-emit-refusal(db, tags, nsp, []);
    def el-emit-refusal(db, tags, nsp, review) = {
        let w = sbt-append(el-spool(), el-cat(["<|ear:frame|>", el-nl(), el-kv("t", now_unix_ms().str()), el-kv("kind", "phantom"), el-kv("db", db.str()), el-kv("live", ""), el-kv("livelang", ""), el-kv("livems", "0"), el-kv("heard", ""), el-kv("lang", ""), el-kv("nsp", nsp.str()), el-kv("heardms", "0"), el-kv("tags", tags), el-review-fields(review), "<|/ear:frame|>", el-nl()]));
        w;
    };
    def el-loop(st, win, total, cut, speech, lastvoice, lastquiet, deadline, live, lasth, lang, p1, p2, stable, listening, annt, tst) = !ewl-running?(deadline) || file_size(el-stop()) >= 0 ? live : {
        let fresh = el-drain(sense_mic_stream_read(3200, 120));
        let tend = now_unix_ms();
        (Comparable) len(fresh) == 0 ? el-loop(st, win, total, cut, speech, lastvoice, lastquiet, deadline, live, lasth, lang, p1, p2, stable, listening, annt, tst) : {
            let total1 = (Number) total + (Number) len(fresh);
            let w1 = el-push(win, fresh);
            let rms = el-rms(w1);
            let db = el-db(rms);
            let measured = elp-stats(fresh);
            let decision = elp-step(listening, measured[0], measured[1], len(fresh), speech);
            let listening1 = decision[0];
            let heard? = decision[1];
            let fl1 = elp-floor(listening1);
            let speech1 = el-cadence?() ? 1 : (Comparable) heard? == 1 ? 1 : speech;
            let lastvoice1 = (Comparable) heard? == 1 ? tend : lastvoice;
            (Comparable) speech1 == 1 && total1 - cut >= 9600 ? {
                let h = el-turbo?() ? eac-open-plain(st, w1, total1, cut, (Number) 8 + (Number) ((total1 - cut) / 2000), listening1) : eac-open(st, w1, total1, cut, (Number) 8 + (Number) ((total1 - cut) / 2000), listening1);
                !ewl-running?(deadline) ? live : {
                    let now = now_unix_ms();
                    let changed = (Comparable) len(lasth) == 0 ? 1 : (String) h[1] == lasth[1] ? 0 : 1;
                    let stable1 = len(lasth) > 0 && (String) h[1] == lasth[1] ? (Number) stable + (Number) 1 : 0;
                    let tags = h[8];
                    let words? = el-has-words(h[1]);
                    let phantom? = (Comparable) words? == 0 && len(tags) > 0 ? 1 : 0;
                    // The beat. A frame used to be written here only when the line CHANGED, so a
                    // line whose words held still — the ordinary case while someone is mid-sentence
                    // and whisper keeps agreeing with itself — left the lane writing nothing at all
                    // for as long as it held. A watcher reading this lane's newest frame as its
                    // pulse then read a living lane as a dead one and stood a new one over it. So
                    // the line as it stands is written again every el-beat ms whether or not it
                    // moved, and a pass that found no words at all beats quiet: this lane's stamp
                    // now advances while it lives, which is the only thing that makes it a clock.
                    let beat = now - lastquiet > el-beat() ? 1 : 0;
                    let wrote = (Comparable) words? == 1 ? (Comparable) changed == 1 || (Comparable) beat == 1 ? 1 : 0 : (Comparable) phantom? == 1 ? (Comparable) beat == 1 ? 3 : 0 : (Comparable) beat == 1 ? 2 : 0;
                    let e = (Comparable) wrote == 1 ? el-emit-live(db, h, now - tend, tend, cut, stable1, fl1) : (Comparable) wrote == 2 ? el-emit-quiet(db, fl1) : (Comparable) wrote == 3 ? el-emit-phantom(db, tags, h[7]) : 0;
                    let lq1 = wrote > 0 ? now : lastquiet;
                    // settled: the words have held still long enough to be worth reading,
                    // and they are given once, the moment that becomes true
                    let fresh? = (Comparable) words? == 1 && (stable1 >= el-settled() && (Comparable) ((String) h[1] == annt) == 0) ? 1 : 0;
                    let es = (Comparable) fresh? == 1 ? el-emit-stable(db, h, 0, stable1, fl1) : 0;
                    let annt1 = (Comparable) fresh? == 1 ? h[1] : (Comparable) words? == 1 && (String) h[1] == annt ? annt : "";
                    let tst1 = (Comparable) fresh? == 1 ? now : (Comparable) len(annt1) == 0 ? 0 : tst;
                    let best = (Comparable) words? == 0 ? lasth : h;
                    // the three closes, in the order of how early they can fire. The decoder's own
                    // end is first because it is looking at the audio: it costs one comparison on a
                    // number the pass already answered with.
                    let tsil = el-tail-sil(h[6]);
                    let why1 = el-cadence?() ? total1 - cut >= el-window() ? "full" : "" : elp-close(now - lastvoice1, tsil, (Comparable) words? == 1 ? stable1 : 0, total1 - cut >= el-window());
                    len(why1) > 0 ? {
                        let review = eac-close(st, w1, total1, cut, (Number) 8 + (Number) ((total1 - cut) / 2000), h[10], best);
                        let final = review[0];
                        // A retired owner cannot publish after its second model pass.
                        !ewl-running?(deadline) ? live : !eac-credible?(final) ? {
                            let ep = eac-words?(final) ? el-emit-refusal(db, final[1], final[7], review) : 0;
                            el-loop(st, w1, total1, total1 - 3200, 0, lastvoice1, lq1, deadline, (Number) live + (Number) 1, [], 0 - 1, [], [], 0, listening1, "", 0);
                        } : {
                            let e2 = el-emit-heard(db, final, why1, now_unix_ms() - tend, stable1, tsil, tst1 > 0 && (String) final[1] == annt1 ? now - tst1 : 0 - 1, review);
                            let seg = sbt-append(el-segs(), el-cat([tend.str(), byte_to_str(9), final[0], byte_to_str(9), final[1], el-nl()]));
                            el-loop(st, w1, total1, total1 - 3200, 0, lastvoice1, now_unix_ms(), deadline, (Number) live + (Number) 1, [], 0 - 1, [], [], 0, listening1, "", 0);
                        };
                    } : el-loop(st, w1, total1, cut, speech1, lastvoice1, lq1, deadline, (Number) live + (Number) 1, best, h[5], [h[5], h[6]], len(p1) > 0 && (Comparable) h[5] == p1[0] ? p1[1] : [], stable1, listening1, annt1, tst1);
                };
            } : {
                let q = tend - lastquiet > 1000 ? el-emit-quiet(db, fl1) : 0;
                el-loop(st, w1, total1, (Comparable) speech1 == 1 ? cut : elp-quiet-cut(total1), speech1, lastvoice1, tend - lastquiet > 1000 ? tend : lastquiet, deadline, live, lasth, lang, p1, p2, stable, listening1, annt, tst);
            };
        };
    };
    // a door feeds these seconds; a sensor stands the lane with no stdin at all, and it stands until it is stopped
    def el-first-line() = {
        let l = read_line();
        nothing?(l) ? "" : trim(l);
    };
    def el-start(secs, owner) = {
        let snap = ("/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" + trim(en-text(read_file("/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main"))));
        let st = el-turbo?() ? nws-open(nws-base(), nws-tokenizer()) : enw-open((snap + "/weights.npz"), enw-tokenizer-path());
        let mic = ewl-owned?(owner) ? sense_mic_stream_start() : -1;
        let born = ewl-owned?(owner) ? el-emit("born", -120, "", "", 0, "", "", 0, 0) : 0;
        // the lane names its own birth in its own log, so the glass reads who is standing
        // from the lane's mouth and not only from the sensor's bookkeeping
        let said = print_str(el-cat(["live lane open, pid ", host_pid().str(), ", mic ", mic.str(), ", standing ", secs.str(), " s"]));
        // The first real chunk initializes the noise estimate; pre-roll keeps its audio available.
        let frames = el-loop(st, [], 0, 0, 0, 0, now_unix_ms(), ewl-session((Number) now_unix_ms() + (Number) (1000 * secs), owner), 0, [], 0 - 1, [], [], 0, elp-born(), "", 0);
        let stopmic = sense_mic_stream_stop();
        let done = ewl-owned?(owner) ? el-emit("done", -120, "", "", 0, "", "", 0, 0) : 0;
        let segdone = ewl-owned?(owner) ? sbt-append(el-segs(), ("done" + el-nl())) : 0;
        print_str(("live frames=" + frames.str()));
        0;
    };
    let secs = {
        let l = el-first-line();
        (Comparable) len(l) == 0 ? 86400 : str_to_int(l);
    };
    let reservedCodes = el-first-line();
    let owner = el-first-line();
    ewl-owned?(owner) ? el-start(secs, owner) : print("ear live: owner retired before admission");
}
