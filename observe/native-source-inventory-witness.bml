// Private real files and children witness complete inventory ownership.
// Git supplies a real NUL filename list; Form preserves spaces and newlines,
// reads unknown-suffix shebangs, retains refusal evidence and re-observes care.
// preludes: form-stdlib/bml/native-source-inventory.bml observe/carrier-mass.bml form-stdlib/bml/native-authoring-guide.bml
section [form.bml] {
 class NativeSourceInventoryWitness {
  def nsiw-put(path,text) = if ne(write_file(path,text),str_len(text)) then form_error("inventory witness write incomplete") else path;
  def nsiw-check(job,aspect,ok) {
   let row = oh-reading("source-inventory-witness",job,aspect,json-node-int(1),json-node-int(ok),json-node-int(ok),list(),list("request-evidence","defer"),oh-reference(job));
   oh-voice(row);
   if ok then 1 else form_error("native source inventory witness refused");
  }
  def nsiw-double(text,left) = if le(left,0) then text else nsiw-double(str_concat(text,text),sub(left,1));
  def nsiw-large(job) {
   let text = nsiw-double(str_concat("a",byte_to_str(0)),20);
   let path = nsiw-put(nsi-path(job,"large.nul"),text);
   let capture = nsi-capture(list("/bin/cat",path));
   nsiw-check(job,"complete-output-above-one-megabyte",and(nsi-admitted?(capture),and(eq(str_len(nsi-text(capture)),2097152),str_eq(nsi-text(capture),text))));
  }
  def nsiw-git(job) {
   let repo = nsi-directory(job,"repository-",0);
   let made = nsi-command(list("git","-C",repo,"init","-q"));
   let vacant = nsi-capture(list("git","-C",repo,"ls-files","-z","--cached","--others","--exclude-standard"));
   let source = nsiw-put(nsi-path(repo,"with space\nand newline.cs"),"one\ntwo\nlast");
   let script = nsiw-put(nsi-path(repo,"named.tool"),"#!/bin/sh\nexit 0\n");
   let names = nsi-capture(list("git","-C",repo,"ls-files","-z","--cached","--others","--exclude-standard"));
   let paths = split-on(nsi-text(names),byte_to_str(0));
   let reading = cm-scan(list(source,script),list(),list(),list(),list(),list());
   nsiw-check(job,"git-filenames-and-source-bytes",and(eq(made,0),and(nsi-admitted?(vacant),and(str_eq(nsi-text(vacant),""),and(nsi-admitted?(names),and(oh-has(paths,"with space\nand newline.cs"),and(oh-has(paths,"named.tool"),and(eq(len(head(reading)),2),and(nil?(nth(reading,4)),and(eq(nth(head(head(reading)),1),2),eq(nth(nth(head(reading),1),1),2)))))))))));
  }
  def nsiw-partial(job) {
   let source = nsi-path(job,"failed-child.bml");
   let body = "section [form.bml] {\n write_file(\"/dev/stdout\",str_concat(\"partial\",byte_to_str(0)));\n form_error(\"inventory child refuses after partial bytes\");\n}\n";
   nsiw-put(source,body);
   let failed = nsi-capture(list("./fkwu",source));
   let bytes = nsiw-put(nsi-path(job,"unterminated"),"last-path-without-nul");
   let partial = nsi-capture(list("/bin/cat",bytes));
   let absent = nsi-capture(list(nsi-path(job,"absent-executable")));
   let ok = and(eq(nsi-status(failed),1),and(nsi-nuls?(nsi-text(failed)),and(not(nsi-admitted?(failed)),and(nsi-ok(partial),and(not(nsi-admitted?(partial)),not(nsi-ok(absent)))))));
   nsiw-check(job,"failed-partial-and-unterminated-capture",ok);
  }
  def nsiw-recovery(job) {
   let path = nsi-path(job,"recovered.c");
   let before = cm-scan(list(path),list(),list(),list(),list(),list());
   let needs = oh-reference(path);
   let row = oh-reading("source-inventory",job,"readable-source",json-node-int(0),json-node-int(len(nth(before,4))),json-node-int(0),list(oh-need("readable-current-source",needs)),list("revise","defer"),needs);
   oh-voice(row);
   let response = oh-response(row,"revise");
   oh-voice(response);
   let action = oh-select(row,response,"defer");
   if str_eq(action,"revise") then nsiw-put(path,"int current;\n") else form_error("inventory recovery was not selected");
   oh-voice(oh-applied(row,action,oh-reference(path)));
   let after = cm-scan(list(path),list(),list(),list(),list(),list());
   nsiw-check(job,"source-reobserved-after-repair",and(eq(len(nth(before,4)),1),and(nil?(nth(after,4)),eq(len(head(after)),1))));
  }
  def nsiw-publication(job) {
   let path = nsi-path(job,"report with space.json");
   let old = nsiw-put(path,"old report");
   let payload = "{\"complete\":true}\n";
   let retained = nrg-publish(path,payload);
   let blocked = nsi-directory(job,"occupied-output-",0);
   let source = nsi-path(job,"refused-publication.bml");
   let body = str_concat("// preludes: form-stdlib/bml/native-authoring-guide.bml\nsection [form.bml] {\n nrg-publish(",str_concat(json-emit(json-node-string(blocked)),",\"payload\");\n print_str(\"publication-success\");\n}\n"));
   nsiw-put(source,body);
   let refused = nsi-capture(list("./fkwu",source));
   let error = read_file(nsi-path(nsi-evidence(refused),"stderr"));
   let ok = and(str_eq(retained,path),and(str_eq(read_file(path),payload),and(eq(nsi-status(refused),1),and(not(nsi-ok(refused)),and(not(cm-has(nsi-text(refused),"publication-success")),and(cm-has(error,"report publication incomplete"),fs_is_dir(blocked)))))));
   nsiw-check(job,"exact-report-publication-and-refused-rename",ok);
  }
  def nsiw-run() {
   let job = nsi-job();
   let large = nsiw-large(job);
   let git = nsiw-git(job);
   let partial = nsiw-partial(job);
   let recovery = nsiw-recovery(job);
   let publication = nsiw-publication(job);
   print(str_concat("native source inventory evidence=",job));
   add(large,add(git,add(partial,add(recovery,publication))));
  }
 }
 nsiw-run();
}
