; native-model-form-action-healing-run.fk — a blocked local-model action is a
; typed observation, a correlated branch control, an applied sibling route,
; and a fresh ready observation. Payloads contain state codes and model ids,
; never private prompt or answer content.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/native-model-control-plane.fk form/form-stdlib/native-model-control-plane-eval.fk form/form-stdlib/form-teach-layer.fk form/form-stdlib/native-model-form-token-envelope.bml form/form-stdlib/form-agent-protocol.fk form/form-stdlib/native-model-form-action-protocol.bml observe/bidirectional-framebuffer-channel.fk

(do
    (defn nmfah-apply-branch (outbound inbound current-model)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound) (bfc-exchange inbound))))))
            current-model
            (if (eq (bfc-payload inbound) 1) (bfc-alternative outbound) current-model)))
    (framebuffer-clear)
    (let blocked-model "st.llama32-3b-mlx-4bit")
    (let sibling-model (NMFTEQwen))
    (let blocked (nmfap-proposal blocked-model "eval" "{}" "31.2.0.9" "native-model-form" (NMFAPWire) 1))
    (let before (nmfap-healing blocked))
    ; 610 = unavailable, 611 = branch to an admitted sibling.
    (let outbound (bfc-envelope 0 86101 0 610 sibling-model))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 1))
    (let in-event (bfc-record-in inbound 2))
    (let selected-model (nmfah-apply-branch outbound inbound blocked-model))
    (let revised (nmfap-proposal selected-model "eval" "{}" "31.2.0.9" "native-model-form" (NMFAPWire) 1))
    (let after (nmfap-healing revised))
    ; The new state is observed before the channel selects continue.
    (let outbound2 (bfc-envelope 0 86102 0 (nmfap-admit? revised) 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))
    (list "native-model-form-action-healing"
        "before" (nmfap-healing-signal before)
        "control" (bfc-payload inbound)
        "selected-model" selected-model
        "after" (nmfap-healing-signal after)
        "admitted" (nmfap-admit? revised)
        "next" (nmfap-healing-next after)
        "framebuffer-events" (len (framebuffer-events))
        "prompt-content-in-framebuffer" 0))
