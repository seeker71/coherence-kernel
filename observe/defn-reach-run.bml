// defn-reach-run.bml — the definitions of a unit that only one root reaches.
//
// Before a reader leaves, the definitions that leave with it have to be known exactly. This mirror reads a
// Form unit's (defn ...) forms and the names each one's body mentions, follows the root's reach, then keeps
// back every definition something else still reaches: a definition of the unit outside that reach, or any
// other .fk or .bml source under the search root (receipts and hidden trees aside) that names it. Mentions
// of the root itself are set aside, since they are the call sites that change when the root leaves, and the
// sources that make them are named. A mention in a comment or a string counts as a use, so the set
// under-reports on purpose: what it names can leave together.
// The root word `dead-tops` asks for the definitions nothing names: not another definition, not the unit's
// own top-level text (its `(let NAME ...)` forms), not any other source. Run it to a fixed point, since a
// cut can orphan what the cut definition alone named. Names built at run time are invisible to it, and only
// .fk and .bml sources are read: a name a .c file, a doc or a band string spells is not seen, so compile
// and run the bands after every cut.
// stdin: one line: the unit's path, the root definition (or `dead-tops`), and optionally the directory to
// search (default ".") and the word `cut`, which writes the unit back without the definitions that leave.
// preflight-exec: forbidden
// preludes: form-stdlib/meaning-codes.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class DefnReach {
  def dr-words(s) {
   let sp = str_find(s, " ", 0);
   str_len(s) == 0 ? list() : sp < 0 ? list(s) : cons(substring(s, 0, sp), dr-words(trim(substring(s, sp + 1, str_len(s)))));
  }
  // a Form name runs until whitespace, a paren, a quote or a comment
  def dr-name-byte?(b) = !((b <= 32) || eq(b, 40) || eq(b, 41) || eq(b, 34) || eq(b, 59));
  def dr-name-end(s, i) = (i < str_len(s)) && dr-name-byte?(str_byte_at(s, i)) ? dr-name-end(s, i + 1) : i;
  // the byte after the form that opens at i: strings and ; comments carry no parens
  def dr-close(s, i, depth) {
   i >= str_len(s) ? i
   : eq(str_byte_at(s, i), 34) ? dr-close(s, dr-string-end(s, i + 1), depth)
   : eq(str_byte_at(s, i), 59) ? dr-close(s, dr-line-end(s, i), depth)
   : eq(str_byte_at(s, i), 40) ? dr-close(s, i + 1, depth + 1)
   : eq(str_byte_at(s, i), 41) ? (eq(depth, 1) ? (i + 1) : dr-close(s, i + 1, depth - 1))
   : dr-close(s, i + 1, depth);
  }
  def dr-string-end(s, i) = i >= str_len(s) ? i : eq(str_byte_at(s, i), 92) ? dr-string-end(s, i + 2) : eq(str_byte_at(s, i), 34) ? (i + 1) : dr-string-end(s, i + 1);
  def dr-line-end(s, i) = (i >= str_len(s)) || eq(str_byte_at(s, i), 10) ? i : dr-line-end(s, i + 1);
  // every (defn name ...) of the unit as (name start end), read past comments and strings (a comment may
  // say "(defn" too); a defn inside a defn is its own
  def dr-defns(s, i) {
   i >= str_len(s) ? list()
   : eq(str_byte_at(s, i), 59) ? dr-defns(s, dr-line-end(s, i))
   : eq(str_byte_at(s, i), 34) ? dr-defns(s, dr-string-end(s, i + 1))
   : eq(str_byte_at(s, i), 40) && str_eq(substring(s, i, i + 6), "(defn ") ? dr-defn-at(s, i)
   : dr-defns(s, i + 1);
  }
  def dr-defn-at(s, at) {
   let name-start = at + 6;
   let end = dr-close(s, at, 0);
   cons(list(substring(s, name-start, dr-name-end(s, name-start)), at, end), dr-defns(s, end));
  }
  // the unit's names each body mentions
  def dr-index(defs, i, tab) = nil?(defs) ? tab : dr-index(tail(defs), i + 1, record_set(tab, head(head(defs)), i + 1));
  def dr-mentions(s, i, end, names, seen, out) {
   i >= end ? out
   : dr-name-byte?(str_byte_at(s, i)) ? dr-mention(s, i, dr-name-end(s, i), end, names, seen, out)
   : eq(str_byte_at(s, i), 34) ? dr-mentions(s, dr-string-end(s, i + 1), end, names, seen, out)
   : dr-mentions(s, i + 1, end, names, seen, out);
  }
  def dr-mention(s, i, e, end, names, seen, out) {
   let w = substring(s, i, e);
   let known = !eq(record_get(names, w), 0);
   let fresh = eq(record_get(seen, w), 0);
   known && fresh ? dr-mentions(s, e, end, names, record_set(seen, w, 1), cons(w, out)) : dr-mentions(s, e, end, names, seen, out);
  }
  def dr-edges(s, defs, names, tab) = nil?(defs) ? tab : dr-edges(s, tail(defs), names, record_set(tab, head(head(defs)), dr-mentions(s, head(defs)[1] + 6, head(defs)[2], names, record_new(0), list())));
  // the names reached from a frontier, never entering the root when it is fenced
  def dr-reach(edges, frontier, fence, seen) {
   nil?(frontier) ? seen
   : (str_eq(head(frontier), fence) || !eq(record_get(seen, head(frontier)), 0)) ? dr-reach(edges, tail(frontier), fence, seen)
   : dr-reach(edges, append(dr-out(edges, head(frontier)), tail(frontier)), fence, record_set(seen, head(frontier), 1));
  }
  def dr-out(edges, n) { let o = record_get(edges, n); eq(o, 0) ? list() : o; }
  def dr-in?(tab, n) = !eq(record_get(tab, n), 0);
  def dr-outside(defs, reach) = nil?(defs) ? list() : dr-in?(reach, head(head(defs))) ? dr-outside(tail(defs), reach) : cons(head(head(defs)), dr-outside(tail(defs), reach));
  def dr-names(defs) = defs |> map(it => head(it));
  def dr-members(xs, tab) = xs |> filter(x => dr-in?(tab, x));
  def dr-without(xs, tab) = nil?(xs) ? list() : dr-in?(tab, head(xs)) ? dr-without(tail(xs), tab) : cons(head(xs), dr-without(tail(xs), tab));
  // a whole-name mention of n in text: the bytes on either side cannot continue a name
  def dr-named?(text, n, from) {
   let at = str_find(text, n, from);
   at < 0 ? false
   : (at == 0 || !dr-name-byte?(str_byte_at(text, at - 1))) && (((at + str_len(n)) >= str_len(text)) || !dr-name-byte?(str_byte_at(text, at + str_len(n)))) ? true
   : dr-named?(text, n, at + 1);
  }
  def dr-named-in(text, xs) = xs |> filter(x => dr-named?(text, x, 0));
  def dr-skips() = list("receipts", ".git", ".hearth", ".claude", ".cache", ".obsidian", "node_modules", "target", "dist");
  def dr-sources(root) = append(source_inventory(root, ".fk", dr-skips()), source_inventory(root, ".bml", dr-skips()));
  def dr-path(root, rel) = str_eq(root, ".") ? rel : (root ++ "/" ++ rel);
  // the candidates other sources name, and the sources that name the root
  def dr-external(root, rows, unit, cands, rootName, named, callers) {
   nil?(rows) ? list(named, callers)
   : dr-external-at(root, tail(rows), unit, cands, rootName, named, callers, dr-path(root, head(head(rows))));
  }
  def dr-external-at(root, rest, unit, cands, rootName, named, callers, path) {
   let text = str_eq(path, unit) || (file_size(path) < 1) ? "" : read_file(path);
   let hits = dr-named-in(text, cands);
   let calls = (str_len(text) > 0) && dr-named?(text, rootName, 0) ? cons(path, callers) : callers;
   dr-external(root, rest, unit, cands, rootName, dr-mark(hits, named), calls);
  }
  def dr-mark(xs, tab) = nil?(xs) ? tab : dr-mark(tail(xs), record_set(tab, head(xs), 1));
  def dr-lines(xs) = nil?(xs) ? "" : ("\n  " ++ head(xs) ++ dr-lines(tail(xs)));
  // cut: the leaving definitions leave the unit, each with the comment lines directly above it and the
  // blank lines that followed it
  def dr-bol(s, i) = i <= 0 ? 0 : eq(str_byte_at(s, i - 1), 10) ? i : dr-bol(s, i - 1);
  def dr-spaces-end(s, i) = (i < str_len(s)) && eq(str_byte_at(s, i), 32) ? dr-spaces-end(s, i + 1) : i;
  def dr-comment-above(s, bol) {
   let above = bol <= 0 ? 0 : dr-bol(s, bol - 1);
   let first = dr-spaces-end(s, above);
   (bol > 0) && (first < bol) && eq(str_byte_at(s, first), 59) ? dr-comment-above(s, above) : bol;
  }
  def dr-cut-start(s, at) {
   let bol = dr-bol(s, at);
   dr-spaces-end(s, bol) < at ? at : dr-comment-above(s, bol);
  }
  def dr-blank-through(s, i) {
   let e = dr-spaces-end(s, i);
   (e < str_len(s)) && eq(str_byte_at(s, e), 10) ? dr-blank-through(s, e + 1) : i;
  }
  def dr-cut-end(s, end) {
   let e = dr-spaces-end(s, end);
   e >= str_len(s) ? e : eq(str_byte_at(s, e), 10) ? dr-blank-through(s, e + 1) : end;
  }
  def dr-cut(s, defs, gone, pos, acc) {
   nil?(defs) ? mc-cat(reverse(cons(substring(s, pos, str_len(s)), acc)))
   : dr-in?(gone, head(head(defs))) ? dr-cut-one(s, tail(defs), gone, pos, acc, dr-cut-start(s, head(defs)[1]), dr-cut-end(s, head(defs)[2]))
   : dr-cut(s, tail(defs), gone, pos, acc);
  }
  def dr-cut-one(s, rest, gone, pos, acc, from, to) = dr-cut(s, rest, gone, to, cons(substring(s, pos, from), acc));
  // the root word `dead-tops` asks for the dead tops: definitions no other definition of the unit and no other source names
  def dr-called(defs, edges, tab) = nil?(defs) ? tab : dr-called(tail(defs), edges, dr-mark(dr-without(dr-out(edges, head(head(defs))), dr-mark(list(head(head(defs))), record_new(0))), tab));
  def dr-dead-tops(unit, searchRoot, defs, edges, top) {
   let all = dr-names(defs);
   let named = dr-mark(dr-named-in(top, all), head(dr-external(searchRoot, dr-sources(searchRoot), unit, all, "dead-tops", record_new(0), list())));
   dr-unused(all, dr-called(defs, edges, record_new(0)), named);
  }
  def dr-unused(all, called, named) = nil?(all) ? list() : dr-in?(called, head(all)) || dr-in?(named, head(all)) ? dr-unused(tail(all), called, named) : cons(head(all), dr-unused(tail(all), called, named));
  // the unit's own text outside every defn: a top-level (let ...) or call that names a definition keeps it
  def dr-outside-text(s, defs, pos, acc) = nil?(defs) ? mc-cat(reverse(cons(substring(s, pos, str_len(s)), acc))) : dr-outside-text(s, tail(defs), head(defs)[2], cons(substring(s, pos, head(defs)[1]), acc));
  def dr-run() {
   let args = dr-words(trim(stdin-text()));
   let [unit, rootName] = args;
   let searchRoot = ((len(args) > 2) && !str_eq(args[2], "cut")) ? args[2] : ".";
   let cutting = str_eq(args[len(args) - 1], "cut");
   let s = read_file(unit);
   let defs = dr-defns(s, 0);
   let names = dr-index(defs, 0, record_new(0));
   let edges = dr-edges(s, defs, names, record_new(0));
   let reach = dr-reach(edges, list(rootName), "", record_new(0));
   let cands = dr-without(dr-members(dr-names(defs), reach), dr-mark(list(rootName), record_new(0)));
   let ext = dr-external(searchRoot, dr-sources(searchRoot), unit, cands, rootName, record_new(0), list());
   let topNamed = dr-mark(dr-named-in(dr-outside-text(s, defs, 0, list()), dr-names(defs)), head(ext));
   let kept = dr-reach(edges, append(dr-outside(defs, reach), dr-members(cands, topNamed)), rootName, record_new(0));
   let leaving = str_eq(rootName, "dead-tops") ? dr-dead-tops(unit, searchRoot, defs, edges, dr-outside-text(s, defs, 0, list())) : cons(rootName, dr-without(cands, kept));
   print_str("[defn-reach] " ++ unit ++ " defns=" ++ int_to_str(len(defs)) ++ " root=" ++ rootName ++ " reaches=" ++ int_to_str(len(cands) + 1) ++ " leaves-with-it=" ++ int_to_str(len(leaving)) ++ " kept=" ++ int_to_str(len(cands) + 1 - len(leaving)));
   print_str("[defn-reach] sources that name the root (their call sites change first):" ++ dr-lines(ext[1]));
   print_str("[defn-reach] leaving with it:" ++ dr-lines(leaving));
   let out = cutting ? dr-cut(s, defs, dr-mark(leaving, record_new(0)), 0, list()) : s;
   let wrote = cutting ? write_file(unit, out) : 0;
   cutting ? print_str("[defn-reach] cut: " ++ int_to_str(str_len(s)) ++ " -> " ++ int_to_str(wrote) ++ " bytes") : 0;
   len(leaving);
  }
 }
 dr-run();
}
