// offline-exam-witness-run.bml — the denial's witness: begun under the exam's profile, it dials the port the parent holds open on loopback and says what the host answered. stdin: the port.
// The parent's own dial to that port stands outside the profile, so a refusal here reads the profile, not an empty port. Prints [witness] refused or [witness] connected.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/stdin-source.bml
section [form.bml] {
 let dialed = socket_connect("127.0.0.1", str_to_int(trim(stdin-text())));
 print_str(dialed < 0 ? "[witness] refused" : "[witness] connected");
 0;
}
