; Real supervised training and Adam continuation on the pinned 3B voice adapter.
; Public fixture only. Two runs publish under .hearth; the active adapter is untouched.
; preflight-exec: forbidden
; preludes: form-stdlib/native-lora-worker.bml
(do
 (let root ".hearth/native-training-homecoming") (fs-mkdir root)
 (nag-write (str_concat root "/train.jsonl") "{\"messages\":[{\"role\":\"user\",\"content\":\"Say hello.\"},{\"role\":\"assistant\",\"content\":\"Hello.\"}]}\n{\"prompt\":\"Say goodbye.\",\"completion\":\"Goodbye.\"}\n")
 (nag-write (str_concat root "/valid.jsonl") "{\"prompt\":\"Give a greeting.\",\"completion\":\"Hello.\"}\n")
 (let request (ntr-request (mr-path (mr-find "llama32-3b-mlx-4bit")) "form/form-stdlib/adapters/llama-3.2-3b-voice" root (str_concat root "/adapter") 1 2 0.00001 1 8))
 (let first (nlw-run request root)) (print first)
 (if (not (eq (nth first 1) 0)) (form_error "native training fixture first run failed") 0)
 (let second (nlw-run request root)) (print second)
 (if (not (eq (nth second 1) 0)) (form_error "native training fixture resume failed") 0)
 (print (list "published" (nag-resolve (str_concat root "/adapter")) "status" (nlw-status root)))
 0)
