; open-cost-probe.fk — the long chain BEFORE the first token, timed link by
; link. The generate probe's 33 s of non-GPU non-seal walker had to live
; somewhere; the forward probes already alibied the forward itself (~10 ms).
;
; preludes: form-stdlib/qwen35-artifact-fetch.fk form-stdlib/qwen35-tokenizer.fk native/metal/qwen35-dense-token-handle.fk

(do
    (defn ocp-ms (label t0 t1)
        (do (print label) (print (int_to_str (sub t1 t0))) (print "\n") 0))
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let t0 (now_unix_ms))
    (let verdict (qaf-seal-verdict path))
    (let t1 (now_unix_ms))
    (let src (eqr-of-file path 0 40000000))
    (let t2 (now_unix_ms))
    (let ids (q35-chat-ids src "Reply with exactly: LOCAL FORM ALIVE"))
    (let t3 (now_unix_ms))
    (let req (q38-required-size src (egg-data-base src 32)))
    (let t4 (now_unix_ms))
    (let ctx (q38-open path 128))
    (let t5 (now_unix_ms))
    (ocp-ms "seal_ms=" t0 t1)
    (ocp-ms "header_read_ms=" t1 t2)
    (ocp-ms "tokenize_ms=" t2 t3)
    (ocp-ms "required_size_ms=" t3 t4)
    (ocp-ms "open_ms=" t4 t5)
    (print (str_concat "seal_verdict=" (int_to_str verdict)))
    (print (str_concat "  prompt_ids=" (int_to_str (len ids))))
    (print (str_concat "  ctx_len=" (int_to_str (len ctx))))
    (print "\n")
    0)
