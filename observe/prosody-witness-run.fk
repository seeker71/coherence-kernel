; prosody-witness-run.fk — hold the prosody organ open on the real room and say what it read.
;
; stdin line 1: how many tenths of a second to listen. Line 2 (optional): a label for the run.
; It opens the mic itself, advances the organ frame by frame, prints one line every half second
; while it listens, and closes with the reading as it stood at the end -- the last three seconds
; of the room, on all seven axes. This is the door that witnesses; the sensor door is
; observe/form-glass-prosody-live.fk.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/room-prosody.bml

(do
    (defn pw-nl () (byte_to_str 10))
    (defn pw-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (pw-cat (tail xs)))))
    (defn pw-out (s) (print_str (str_concat s (pw-nl))))
    (defn pw-n (v) (if (eq v (RPRAbsent)) "—" (int_to_str v)))
    (defn pw-line (r)
        (pw-cat (list "db " (int_to_str (div (rpr-r-db r) 10))
                      "  peak " (int_to_str (div (rpr-r-peak r) 10))
                      "  line " (int_to_str (div (rpr-r-line r) 10))
                      "  hz " (if (eq (rpr-r-voiced r) 1) (int_to_str (rpr-r-hz r)) "—")
                      "  span " (pw-n (rpr-r-span r))
                      "  move " (rpr-move-word (rpr-r-move r))
                      "  rate " (int_to_str (rpr-r-rate r))
                      "  pause " (int_to_str (rpr-r-pause r))
                      "  sdLvl " (pw-n (rpr-r-sdlevel r))
                      "  sdHz " (pw-n (rpr-r-sdpitch r))
                      "  still " (int_to_str (rpr-r-still r))
                      "  since " (int_to_str (rpr-r-since r))
                      "  decay " (pw-n (rpr-r-decay r))
                      "  tilt " (pw-n (rpr-r-tilt r))
                      "  voiced " (int_to_str (rpr-r-nvoiced r)))))
    (defn pw-chunk () (do (let f (sense_mic_stream_read 3200 150)) (if (nothing? f) "" f)))
    ; the fullest reading of the run: the one holding the most voiced frames, ties going to the
    ; louder peak. A stimulus that ends before the window does would otherwise be judged on the
    ; silence after it, and two runs of different lengths could never be set beside each other.
    (defn pw-fuller (a b)
        (if (eq (len a) 0) b
            (if (gt (rpr-r-nvoiced b) (rpr-r-nvoiced a)) b
                (if (and (eq (rpr-r-nvoiced b) (rpr-r-nvoiced a)) (gt (rpr-r-peak b) (rpr-r-peak a))) b a))))
    (defn pw-loop (st n i best)
        (if (ge i n) (list st best)
            (do (let st1 (rpr-advance st (pw-chunk)))
                (let r (rpr-reading st1))
                (let shown (if (eq (mod i 5) 4) (pw-out (str_concat "  " (pw-line r))) 0))
                (pw-loop st1 n (add i 1) (pw-fuller best r)))))
    (defn pw-first () (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    (let tenths (do (let l (pw-first)) (if (eq (str_len l) 0) 60 (str_to_int l))))
    (let label (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    (let opened (sense_mic_stream_start))
    (let head1 (pw-out (pw-cat (list "listening " (int_to_str tenths) " tenths — " label))))
    (let run (pw-loop (rpr-state0) tenths 0 (list)))
    (let closed (sense_mic_stream_stop))
    (pw-out (str_concat "FINAL   " (pw-line (rpr-reading (head run)))))
    (let full (nth run 1))
    (pw-out (if (eq (len full) 0) "FULLEST nothing was heard" (str_concat "FULLEST " (pw-line full))))
    0)
