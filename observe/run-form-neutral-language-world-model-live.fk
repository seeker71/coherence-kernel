; Printable live reading of the bounded form-neutral language world model.
import "../model/form-neutral-language-world-model.fk"

(do
  (let runtime (cnl13-runtime-open))
  (let graph (fnwm-crossing runtime))
  (str_concat "form-neutral-language-world-model\n"
    (str_concat "  packed-envelope-bytes="
    (str_concat (int_to_str (fnwm-graph-size graph))
    (str_concat "\n  active-budget-bytes="
    (str_concat (int_to_str (fnwm-graph-budget graph))
    (str_concat "\n  compared-llm-resident-bytes="
    (str_concat (int_to_str (dtrs-dsv4-default-bytes))
    (str_concat "\n  semantic-symbols="
    (str_concat (int_to_str (len (fnwm-symbols graph)))
    (str_concat "\n  directed-relations="
    (str_concat (int_to_str (len (fnwm-relations graph)))
    (str_concat "\n  projection-mappings="
    (str_concat (int_to_str (len (fnwm-mappings graph)))
    (str_concat "\n  world-meaning-entities="
    (str_concat (int_to_str
      (fnwm-world-meaning-count graph 7 "language-organ" 100))
      "\n")))))))))))))))
)