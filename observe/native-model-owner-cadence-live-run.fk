; native-model-owner-cadence-live-run.fk — four-hertz OS owner liveness.
; preflight-exec: forbidden
;
; This observer never opens, steps, closes, signals, or restarts a model.  It
; publishes only the current OS lifetime of the uniquely matched owner PID.
; The old in-process model snapshot remains old and Glass continues to age it.
;
; preludes: form/form-stdlib/native-model-owner-cadence.bml

(do
    (defn nmdocl-next (correlation step)
        (if (eq (nmdoc-step-alive? step) 1)
            (nmdoc-step-correlation step)
            (do
                ; A dead target is a signal to discover the current owner.
                ; The observer lifetime stays stable; only its target binding
                ; advances, so a new resident owner never inherits old liveness.
                (let discovered (nmdoc-discover
                    (nmdoc-observer-pid correlation)
                    (nmdoc-observer-started correlation)
                    (add (nmdoc-sequence correlation) 1)))
                (if (eq (nmdoc-correlation? discovered) 1)
                    discovered
                    (nmdoc-step-correlation step)))))
    (defn nmdocl-loop (correlation)
        (do
            (let step (nmdoc-step correlation (NMDOCGlassRoot)))
            (let waited (host-exec "/bin/sleep 0.25" ""))
            (nmdocl-loop (nmdocl-next correlation step))))
    (let started (now_unix_ms))
    (let pid (nmdoc-self-pid))
    (let correlation (nmdoc-discover pid started 1))
    (if (not (eq (nmdoc-correlation? correlation) 1))
        (list "native-model-owner-cadence-refused" "discovery")
        (do
            (print (list "native-model-owner-cadence-live"
                "observer-pid" pid
                "target-pid" (nmdoc-target-pid correlation)
                "target-publisher" (nmdoc-target-publisher correlation)
                "target-binding" (nmdoc-target-binding correlation)
                "target-hz" 4
                "model-readiness-renewed" 0
                "node-id-claimed" 0))
            (nmdocl-loop correlation))))
