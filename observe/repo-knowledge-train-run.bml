// preflight-exec: forbidden
// One JSON stdin line: {"steps":2,"batch":2}. Empty stdin uses those defaults.
// preludes: learn/repo-knowledge-train.bml
section [form.bml] {
 let input = read_line();
 let options = if or(nothing?(input),str_eq(trim(input),"")) then json-node-object(list()) else parse-json("repo-knowledge-training",input);
 print_str(str_concat(json-emit-precise(rkt-run(options)),"\n"));
}
