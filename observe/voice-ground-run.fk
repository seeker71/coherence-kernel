; voice-ground-run.fk — lookup stands before speech. A question arrives;
; the corpus locates it natively by its own tokens (exact, never a guess);
; a found row answers with its word at no rented cost. Only when the corpus
; holds nothing is the local adapter asked, and its word is admitted only
; if the corpus already carries it — otherwise it is [word?], an offer.
; stdin: line 1 data folder (blank -> the native one), line 2 the question.
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-voice.bml form/form-stdlib/symbol-voice.bml
(do
    (defn vg-trim (s) (if (nothing? s) "" (trim s)))
    (defn vg-lower (s i acc) (if (ge i (str_len s)) acc (vg-lower s (add i 1) (str_concat acc (byte_to_str (if (and (ge (str_byte_at s i) 65) (le (str_byte_at s i) 90)) (add (str_byte_at s i) 32) (str_byte_at s i)))))))
    (defn vg-word? (c) (or (and (ge c 97) (le c 122)) (or (and (ge c 48) (le c 57)) (eq c 45))))
    (defn vg-tokens (s i cur acc) (if (ge i (str_len s)) (reverse (if (gt (str_len cur) 0) (cons cur acc) acc)) (if (vg-word? (str_byte_at s i)) (vg-tokens s (add i 1) (str_concat cur (byte_to_str (str_byte_at s i))) acc) (vg-tokens s (add i 1) "" (if (gt (str_len cur) 0) (cons cur acc) acc)))))
    (defn vg-suffix? (q r) (if (gt (len r) (len q)) 0 (if (eq (len r) 0) 1 (vg-suffix-go q r (sub (len q) (len r))))))
    (defn vg-suffix-go (q r i) (if (eq (len r) 0) 1 (if (str_eq (nth q i) (head r)) (vg-suffix-go q (tail r) (add i 1)) 0)))
    (defn vg-locate (rows q) (if (eq (len rows) 0) (list) (if (eq (vg-suffix? q (nth (head rows) 2)) 1) (head rows) (vg-locate (tail rows) q))))
    (defn vg-first-word (s) (do (let ws (vg-tokens (vg-lower s 0 "") 0 "" (list))) (if (eq (len ws) 0) "" (head ws))))
    (defn vg-corpus-has? (rows w) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 4) w) 1 (vg-corpus-has? (tail rows) w))))
    (let data0 (vg-trim (read_line)))
    (let data (if (eq (str_len data0) 0) (LVData) data0))
    (let q (vg-trim (read_line)))
    (let toks (vg-tokens (vg-lower q 0 "") 0 "" (list)))
    (let row (vg-locate (hdc-rows) toks))
    (if (gt (len row) 0)
        (print_str (str_concat "grounded: " (str_concat (nth row 4) (str_concat " row=" (str_concat (int_to_str (nth row 1)) (str_concat " cost=native\n" (sv-say (str_concat "you SEE " (nth row 4)))))))))
        (do (let said (vg-first-word (if (nothing? (lv-ask data q 1)) "" (lv-ask data q 1))))
            (print_str (str_concat "proposed: " (str_concat said (str_concat (if (eq (vg-corpus-has? (hdc-rows) said) 1) " admitted=corpus-carries-it" " admitted=0 [word?]") " cost=local-adapter\n"))))))
    0)
