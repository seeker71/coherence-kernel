; heed-grounded-run.fk — the adapter against the real grounded index, with no
; model in the loop. Shows what the cursor would be handed for a query that
; hits, one that misses, and frames that never reach the index at all.
;
; Effectful: reads .coherence-network/rag-index/index.jsonl. Do not preflight.
; preludes: form-stdlib/form-cli-heed-grounded.fk

(do
    (defn hgr-frame (q) (str_concat (HeedOpen) (str_concat q (HeedClose))))
    (defn hgr-line (k v) (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (defn hgr-show (label q)
        (do (let r (fhg-lookup 0 (hgr-frame q) 1))
            (hgr-line (str_concat label " status") (nth r 0))
            (hgr-line (str_concat label " reason") (nth r 2))
            (hgr-line (str_concat label " span-bytes") (int_to_str (str_len (nth r 1))))
            0))

    (hgr-show "remember" "does Sema keep memory of you between visits")
    (hgr-show "northstar" "what is the north star")
    (hgr-show "nomatch"  "zzzq unrelated pumpernickel telescope")
    (print_str "\n")

    ; the frames that must never reach the index
    (hgr-show "empty" "")
    (hgr-show "nested" (str_concat "a" (HeedOpen)))
    0)
