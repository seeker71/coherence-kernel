; bml-demand-jit-diagnostic-run.fk -- bounded response to compile and time signals.
; Payload is counts/times only; no source, prompt, or answer content crosses.
; preludes: form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (framebuffer-clear)
    (let syntax (bfc-envelope 0 4921 0 (list 1 1 0) 4921099))
    (let revise-syntax (bfc-control syntax 2))
    (let so (bfc-record-out syntax 1))
    (let si (bfc-record-in revise-syntax 2))
    (let dependencies (bfc-envelope 0 4922 0 (list 0 1 1) 4922099))
    (let revise-dependencies (bfc-control dependencies 2))
    (let do1 (bfc-record-out dependencies 3))
    (let di1 (bfc-record-in revise-dependencies 4))
    (let compile-time (bfc-envelope 0 4923 0 (list 5430 6170 5000) 4923099))
    (let retain-cache (bfc-control compile-time 0))
    (let to (bfc-record-out compile-time 5))
    (let ti (bfc-record-in retain-cache 6))
    (let reobserved (bfc-envelope 0 4924 0 (list 0 0 130 410) 4924099))
    (let continue (bfc-control reobserved 0))
    (let ro (bfc-record-out reobserved 7))
    (let ri (bfc-record-in continue 8))
    (list "bml-demand-jit-diagnostic"
        (list "syntax-applied" (bfc-apply syntax revise-syntax 4921000 4921099))
        (list "dependency-applied" (bfc-apply dependencies revise-dependencies 4922000 4922099))
        (list "first-ms" 5430 6170 "attention-ms" 5000)
        (list "reuse-ms" 130 410 "errors" 0 "unresolved" 0)
        (list "framebuffer-events" (len (framebuffer-events)))))
