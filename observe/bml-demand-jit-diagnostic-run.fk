; bml-demand-jit-diagnostic-run.fk -- bounded physical evidence request and
; one real continue-specialization action.  No prompt, answer, or source body
; crosses the framebuffer; only fixture timing, route, cache, and file-stat
; observations do.
; preflight-exec: forbidden
; preludes: form-stdlib/bml-demand-jit.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn bdjd-program ()
        (list (list 1 7) (list 2) (list 1 3) (list 5 1 2)
            (list 3 3 0)))
    (defn bdjd-field (field)
        (if (eq (bdj-field-present? field) 1)
            (list "present" (bdj-field-value field))
            (list "absent" (bdj-field-reason field))))
    (defn bdjd-file (label path)
        (if (lt (file_mtime path) 0)
            (list label "absent")
            (list label "present" "bytes" (file_size path)
                "mtime" (file_mtime path))))
    (defn bdjd-topology ()
        (list
            (bdjd-file "live-wrapper-image"
                "observe/bml-demand-jit-live-run.fkb")
            (bdjd-file "compatibility-door-image"
                "form/form-stdlib/bml-demand-jit.fkb")
            (bdjd-file "authority-adjacent-image"
                "form/form-stdlib/bml/bml-demand-jit.bml.fkb")
            (bdjd-file "glass-adjacent-image"
                "form/form-stdlib/bml/bml-demand-jit-glass.bml.fkb")
            (bdjd-file "leaf-disk-image"
                "/tmp/bml-demand-jit-diagnostic/leaf.cache")))
    (defn bdjd-stage (step)
        (do (let stage (bdj-step-stage step))
            (list "cache" (bdj-stage-cache-disposition stage)
                "cache-age-ms" (bdjd-field (bdj-stage-cache-age stage))
                "inspect-ms" (bdj-stage-inspect-ms stage)
                "materialize" (bdj-stage-materialize-action stage)
                "materialize-ms" (bdj-stage-materialize-ms stage)
                "install-challenge-ms"
                    (bdj-stage-install-challenge-ms stage)
                "publish-ms" (bdj-stage-publish-ms stage)
                "total-ms" (bdj-stage-total-ms stage)
                "unattributed-ms" (bdj-stage-unattributed-ms stage))))

    (framebuffer-clear)
    (let root "/tmp/bml-demand-jit-diagnostic")
    (let source "/tmp/bml-demand-jit-diagnostic/source.bml")
    (let cache "/tmp/bml-demand-jit-diagnostic/leaf.cache")
    (let made (if (lt (file_mtime root) 0) (fs-mkdir root) 0))
    (let wrote (if (lt (file_mtime source) 0)
        (write_file_text source "section [form.bml] { 0; }") 0))

    ; The inbound request-evidence control becomes a physical action only at
    ; this conditional file-stat read.  bfc-apply merely validates and selects.
    (let topology-before (bdjd-topology))
    (let evidence-out (bfc-envelope 0 4925 0
        (list (len topology-before)) 4925099))
    (let evidence-in (bfc-control evidence-out 4))
    (let eo (bfc-record-out evidence-out 1))
    (let ei (bfc-record-in evidence-in 2))
    (let evidence-selection (bfc-apply evidence-out evidence-in 4 -1))
    (let topology-inspected (if (eq evidence-selection 4)
        (bdjd-topology) (nothing)))
    (let evidence-after (bfc-envelope 0 4926 0
        (if (nothing? topology-inspected) (list)
            (list (len topology-inspected))) 4926099))
    (let evidence-continue (bfc-control evidence-after 0))
    (let eao (bfc-record-out evidence-after 3))
    (let eai (bfc-record-in evidence-continue 4))

    ; Continue means something here: run the pending physical JIT step, then
    ; make one request through the resulting retained registry and reobserve.
    (let first-start (now_unix_ms))
    (let first (bdj-request (bdj-empty 9002) source cache
        (bdjd-program) 4 5))
    (let first-ms (sub (now_unix_ms) first-start))
    (let flow-out (bfc-envelope 0 4927 0
        (list first-ms (bdj-receipt-status first)) 4927099))
    (let flow-in (bfc-control flow-out 0))
    (let fo (bfc-record-out flow-out 5))
    (let fi (bfc-record-in flow-in 6))
    (let flow-selection (bfc-apply flow-out flow-in 1 -1))
    (let step (if (eq flow-selection 1)
        (bdj-step (bdj-receipt-state first)) (nothing)))
    (let retained (if (nothing? step) (nothing)
        (bdj-request (bdj-step-state step) source cache
            (bdjd-program) 4 10)))
    (let flow-after (bfc-envelope 0 4928 0
        (if (nothing? step) (list)
            (list (bdj-step-ms step) (bdj-step-status step)
                (if (nothing? retained) "none"
                    (bdj-receipt-route retained)))) 4928099))
    (let flow-continue (bfc-control flow-after 0))
    (let fao (bfc-record-out flow-after 7))
    (let fai (bfc-record-in flow-continue 8))

    (list "bml-demand-jit-diagnostic"
        (list "fixture-root" (if (lt (file_mtime root) 0)
            "absent" "present") "source" (if (lt (file_mtime source) 0)
            "absent" "present"))
        (list "evidence-control-selected" (bfc-payload evidence-in)
            "action-performed" (if (nothing? topology-inspected)
                "none" "bounded-file-stat-read")
            "before" topology-before "reobserved" topology-inspected)
        (list "flow-control-selected" (bfc-payload flow-in)
            "action-performed" (if (nothing? step) "none"
                "pending-jit-step")
            "first-answer-ms" first-ms
            "step" (if (nothing? step) (list "absent")
                (bdjd-stage step))
            "reobserved-route" (if (nothing? retained) "absent"
                (bdj-receipt-route retained)))
        (list "framebuffer-events" (len (framebuffer-events)))))
