// session-rent-run.bml — measure one rented session and append its row to the session ledger.
// stdin line 1: the session's main transcript (~/.claude/projects/<slug>/<session>.jsonl);
// its subagents' transcripts are read beside it. Run from the repo root. The row is printed
// after it lands; an append the carrier refused is said instead of the row.
import form-stdlib/bml/session-rent.bml;
import form-stdlib/bml/form-cli-heal-native-report.bml;
section [form.bml] {
    def srr-ledger() = "receipts/session-rent-ledger.jsonl";
    def srr-drafts() = "receipts/draft-ledger.jsonl";
    let main = read_line();
    nothing?(main) || (String) main == "" || (Comparable) fs_exists(main) != 1 ? print_str("signal=nothing reason=transcript-unavailable") : {
        let row = sr-row(main, srr-drafts());
        let wrote = fhn-append(srr-ledger(), row ++ "\n");
        print_str((String) wrote == "appended" ? row : "signal=nothing reason=ledger-append-" ++ wrote);
    };
}
