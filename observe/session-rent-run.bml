// session-rent-run.bml — close the session: measure every session of this repo that needs it, then show the
// progression they make (form-stdlib/bml/session-progress.bml). It finds its own ground: this session's id from the
// host, every checkout's project directory, every main transcript; a session whose transcripts have not changed since
// its last row is kept, one that grew or was never read is measured and its row lands in receipts/session-rent-ledger.jsonl.
// stdin line 1: blank for every session (the closing measure); a transcript path
// (~/.claude/projects/<slug>/<session>.jsonl) to measure that one alone. Run from the repo root.
// preludes: form-stdlib/bml/session-progress.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
    let given = read_line();
    let path = nothing?(given) ? "" : trim(given);
    (String) path == "" ? sp-close() : sp-close-one(path);
}
