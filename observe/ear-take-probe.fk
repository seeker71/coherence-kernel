; ear-take-probe.fk — read the ear the way the GLASS reads it, not the way the spool holds it.
;
; The lane writes frames; the sensor folds them into the current body's scoped ear gift.
; Everything between those two is where a row can be lost, and a spool that looks right proves
; nothing about what a reader receives. So this takes the published frame the same two calls the
; glass makes — fgsr-take then fgsr-rows-or-absent — and prints every axis with its evidence.
; Stand observe/form-glass-ear-live.fk in one shell and run this in another while it stands.
; A publisher that is not standing is named absent rather than guessed at.
; preludes: form/form-stdlib/form-glass-sensor-rows.bml
(do
    (defn etp-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (etp-cat (tail xs)))))
    (defn etp-pad (s n) (if (ge (str_len s) n) s (etp-pad (str_concat s " ") n)))
    (defn etp-val (row) (if (eq (fgo-present? row) 0) (str_concat "(absent) " (fgo-source row))
        (if (str_eq (fgo-value-kind row) "int")
            (str_concat (int_to_str (fgo-int-value row)) (if (eq (str_len (fgo-unit row)) 0) "" (str_concat " " (fgo-unit row))))
            (fgo-text-value row))))
    (defn etp-show (rows) (if (eq (len rows) 0) 0
        (do (let r (head rows))
            (print_str (etp-cat (list (etp-pad (fgo-id r) 18) (etp-pad (fgo-lifecycle r) 8) (etp-val r))))
            (etp-show (tail rows)))))
    (let standing (fgsr-standing? "ear"))
    (let p (print_str (etp-cat (list "publisher " (fgsr-publisher "ear") " standing=" (int_to_str standing)))))
    (let held (fgsr-take "ear" (list)))
    (let rows (fgsr-rows-or-absent "ear" held))
    (let s (etp-show rows))
    (print_str (str_concat "rows=" (int_to_str (len rows))))
    (len rows))
