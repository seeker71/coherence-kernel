; form-local-offline-axioms-actuator.fk -- exact pair-bound health actuator.
;
; This is the pure membrane around one physical function supplied by a caller.
; The attempt category alone is never executable authority: both the selected
; health identity and fmcl-attempt-category must match before `runf` is called.
;
; A physical call and its outcome are separate facts.  Once runf is entered,
; the apply result is `applied` even when the returned crossing is `nothing`,
; malformed, or present-but-not-ready.  The next state retains that outcome;
; re-observation promotes only an independently validated crossing to 1.
;
; State = [tag, rows, model-path, model-id, outcome, crossing, attempts]
; Outcome = unattempted | nothing | refused | not-yet | ready
;
; preludes: observe/form-local-offline-self-direction.fk
; preludes: form-stdlib/form-nodeid-mastery-cell-categories.fk

import "form-local-offline-self-direction.fk"
import "../form/form-stdlib/form-nodeid-mastery-cell-categories.fk"

(do
    (defn flosda-target () "axioms-resident-one-family-crossing")

    (defn flosda-state (rows path model-id outcome crossing attempts)
        (list "form-local-offline-axioms-actuator-state-v1" rows path model-id
            outcome crossing attempts))
    (defn flosda-rows (state) (nth state 1))
    (defn flosda-path (state) (nth state 2))
    (defn flosda-model-id (state) (nth state 3))
    (defn flosda-outcome (state) (nth state 4))
    (defn flosda-crossing (state) (nth state 5))
    (defn flosda-attempts (state) (nth state 6))

    (defn flosda-outcome-name? (name)
        (if (or (str_eq name "unattempted")
            (or (str_eq name "nothing")
            (or (str_eq name "refused")
            (or (str_eq name "not-yet")
                (str_eq name "ready"))))) 1 0))
    (defn flosda-state-valid? (state)
        (if (nothing? state) 0
            (if (not (eq (len state) 7)) 0
                (if (not (str_eq (nth state 0)
                        "form-local-offline-axioms-actuator-state-v1")) 0
                    (if (le (str_len (flosda-path state)) 0) 0
                        (if (le (str_len (flosda-model-id state)) 0) 0
                            (if (lt (flosda-attempts state) 0) 0
                                (flosda-outcome-name?
                                    (flosda-outcome state)))))))))

    (defn flosda-selected? (selected)
        (if (eq (flohm-row-valid? selected) 0) 0
            (if (not (str_eq (flohm-identity selected)
                    (flosda-target))) 0
                (if (node_eq (flohm-action-token selected)
                        (fmcl-attempt-category)) 1 0))))

    ; Stage the public crossing shell before an injected validator may inspect
    ; nested evidence.  The production validator is fka1-crossing-valid?.
    (defn flosda-crossing-shape? (crossing)
        (if (nothing? crossing) 0
            (if (not (eq (len crossing) 19)) 0
                (if (str_eq (nth crossing 0)
                        "axioms-one-family-crossing-v1") 1 0))))
    (defn flosda-output-outcome (validf crossing)
        (if (nothing? crossing) "nothing"
            (if (eq (flosda-crossing-shape? crossing) 0) "refused"
                (if (eq (validf crossing) 1) "ready" "not-yet"))))
    (defn flosda-outcome-reason (outcome)
        (if (str_eq outcome "nothing") "physical-attempt-returned-nothing"
        (if (str_eq outcome "refused") "physical-attempt-returned-malformed"
        (if (str_eq outcome "ready") "physical-attempt-crossing-ready"
            "physical-attempt-crossing-not-yet"))))

    (defn flosda-row-state (outcome)
        (if (str_eq outcome "ready") 1 0))
    (defn flosda-row-detail (outcome)
        (if (str_eq outcome "nothing")
            "latest exact pair-bound physical attempt returned nothing"
        (if (str_eq outcome "refused")
            "latest exact pair-bound physical attempt returned malformed crossing"
        (if (str_eq outcome "not-yet")
            "latest exact pair-bound physical attempt returned crossing not-yet"
        (if (str_eq outcome "ready")
            "latest exact pair-bound physical attempt returned valid crossing"
            "no pair-bound physical attempt observed in this state")))))

    (defn flosda-observe-rows (rows stamp outcome)
        (if (nil? rows) (empty)
            (do
                (let row (head rows))
                (let next (flosda-observe-rows (tail rows) stamp outcome))
                (if (str_eq (flohm-identity row) (flosda-target))
                    (cons (if (str_eq outcome "unattempted") row
                        (flohm-organ (flohm-identity row)
                            (flosda-row-state outcome)
                            (flohm-impact row) (flohm-leverage row) stamp
                            (flohm-source row) (flohm-action-token row)
                            (flosda-row-detail outcome))) next)
                    (cons row next)))))

    ; The validator is injected so pure bands never need the physical Qwen
    ; closure, while production supplies fka1-crossing-valid? directly.
    (defn flosda-observe-with (validf state stamp)
        (if (eq (flosda-state-valid? state) 0) (nothing)
            (do
                (let observed-outcome (if (eq (flosda-attempts state) 0)
                    "unattempted"
                    (flosda-output-outcome validf
                        (flosda-crossing state))))
                (flohm-map stamp (flosda-observe-rows
                    (flosda-rows state) stamp observed-outcome)))))

    (defn flosda-apply-with (runf validf state selected before)
        (if (eq (flosda-state-valid? state) 0)
            (flosd-apply-result "refused" "axioms-actuator-state-invalid"
                (if (eq (flohm-row-valid? selected) 1)
                    (flohm-identity selected) (nothing))
                (if (eq (flohm-row-valid? selected) 1)
                    (flohm-action-token selected) (nothing)) state 0)
            (if (eq (flosda-selected? selected) 0)
                (flosd-apply-result "refused" "exact-identity-action-pair-required"
                    (if (eq (flohm-row-valid? selected) 1)
                        (flohm-identity selected) (nothing))
                    (if (eq (flohm-row-valid? selected) 1)
                        (flohm-action-token selected) (nothing)) state 0)
                (do
                    ; Sole physical call: production binds runf=fka1l-run.
                    (let crossing (runf (flosda-path state)
                        (flosda-model-id state)))
                    (let outcome (flosda-output-outcome validf crossing))
                    (let next-state (flosda-state (flosda-rows state)
                        (flosda-path state) (flosda-model-id state) outcome
                        crossing (add (flosda-attempts state) 1)))
                    (flosd-apply-result "applied"
                        (flosda-outcome-reason outcome)
                        (flohm-identity selected) (flohm-action-token selected)
                        next-state 1)))))
    0)
