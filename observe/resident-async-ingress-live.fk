; resident-async-ingress-live.fk — physical append-only ingress witness.
;
; This does not manufacture external concurrency.  It proves the exact carrier
; the resident loop can poll between compute quanta: file_size sees no movement
; without blocking; read_file_slice crosses only newly appended bytes; a second
; logical channel remains independent; framebuffer receives an opaque event.
;
; Input lines: first channel path, second channel path.  The files are never
; written here: another local participant may append BMF/BML frames while this
; process remains resident.  One pass is intentionally bounded and immediate.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/substrate-phase.fk form/form-stdlib/form-eval-full.fk form/form-stdlib/resident-async-ingress.fk

(do
    (let first-path (read_line))
    (let second-path (read_line))
    (let first "@0.2.0.200")
    (let second "@0.2.0.201")
    (let first-size (file_size first-path))
    (let second-size (file_size second-path))
    (let organ (rai-organ
        (list (rai-channel first 16 64 (if (lt first-size 0) 0 first-size))
              (rai-channel second 16 64 (if (lt second-size 0) 0 second-size))) 32))
    (let p1 (rai-poll-file organ first first-path 1 "bmf-bytes" "first-idle" -1))
    (let p2 (rai-poll-file (nth p1 0) second second-path 2 "bmf-bytes" "second-idle" -1))
    (let y (rai-yield (nth p2 0) (now_unix_ms)))
    (let recorded (rai-record-framebuffer (nth y 0) first 1))
    (print_str (str_concat "resident-async-ingress signal=" (nth y 2)))
    (print_str (str_concat " first-delta=" (int_to_str (nth p1 3))))
    (print_str (str_concat " second-delta=" (int_to_str (nth p2 3))))
    (print_str (str_concat " framebuffer-events="
        (int_to_str (len (framebuffer-events)))))
    (print_str (str_concat " inspection-cost=" (int_to_str (rai-inspection-cost))))
    (print (list (rai-inspect-channel (nth y 0) first)
                 (rai-inspect-channel (nth y 0) second)))
    0)
