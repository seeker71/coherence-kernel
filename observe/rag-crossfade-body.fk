; rag-crossfade-body.fk — the crossfade over the body's OWN cells, both ears real.
;
; PROOF LEVEL: METAL-LINKED fkwu ONLY (a 274 MB GGUF on disk, metal_* through the handle door).
;
; rag-crossfade-band.bml proves the flow over two hand-built ears; rag-crossfade-live.fk runs it
; over six sentences. This runs it over the body: twenty-one cells, each carried by its own header
; title line read off disk. The old ear is rag-embed.fk's lexical re-vec of that line; the new ear
; is nomic-embed-text-v1.5 on Metal over the same line, unit-normalized and quantized to the rag
; lane. Three questions, each with its relevant cluster declared before the run.
;
; Witnessed 2026-09-10 (M4 Max, 175 s: 21 texts through the ear, then three asks):
;
;   "show the body's health on the terminal glass"
;     old ear   dashboard, vitals, membrane, qwen38-embedding, channel-interface
;     new ear   vitals, dashboard, membrane, voice-frequency, FLOW-UI
;     containment 600 per mille, curve (3 151) (5 151) (8 151) (12 -18), reading gas
;   The new ear found form-glass-flow-ui.bml, which the lexical ear missed entirely at every
;   depth: its title says "bounded observed-frame flow shard" and carries neither "health" nor
;   "glass" as the query spells them. That is the whole case for the crossfade in one row.
;
;   "compile a hot recipe to native code on demand"
;     curve (3 0) (5 -202) (8 -202) (12 -181), observed depth at eps 0 -> 3
;   The gap goes NEGATIVE past depth 3: the crossfade scored better than the native new ear.
;   Not an error. A bounded candidate pool is a filter, and the old ear's filter kept noise out
;   that the new ear ranked in. A curve that only ever falls would be the suspicious one.
;
;   "embed a text and find the nearest document"
;     containment 400, curve (3 492) (5 301) (8 316) (12 278), depth at eps 0 -> 0 (never reached)
;   Non-monotonic: 8 is worse than 5. The honest reading is that no walked depth closed the gap,
;   and rcf-observed-depth answers 0 rather than picking the smallest number on the curve.
;
; Every number here is per mille of nDCG (rcf-ndcg), the relevant clusters are below, and the
; curve is computed at run time — nothing in this header is a constant the cell does not compute.
; preludes: native/metal/nomic-embed-form.fk form-stdlib/rag-embed.fk form-stdlib/bml/rag-crossfade.bml
;
(do
    (let path "/Users/ursmuff/.ollama/models/blobs/sha256-970aa74c0a90ef7482477cf803618e776e173c007bf957f635f1015bfcfef0e6")
    (let src (nbf-src path))
    (let offs (nwp-offs src))
    (defn bcr-rev (in out) (if (eq (len in) 0) out (bcr-rev (tail in) (cons (head in) out))))
    (defn bcr-q-go (xs norm acc)
        (if (eq (len xs) 0) (bcr-rev acc (empty))
            (bcr-q-go (tail xs) norm (cons (math_floor (add 500.0 (mul 500.0 (div (head xs) norm)))) acc))))
    (defn bcr-embed (path src offs text)
        (do (let facts (nbf-embed-text path src offs text))
            (if (eq facts 0) (empty)
                (do (let xs (head facts))
                    (bcr-q-go xs (nbf-norm xs) (empty))))))
    ; the first line of a file that carries more than a banner: strip leading ; / and spaces
    (defn bcr-strip (s i n)
        (if (ge i n) ""
            (do (let c (substring s i (add i 1)))
                (if (or (str_eq c ";") (or (str_eq c "/") (str_eq c " "))) (bcr-strip s (add i 1) n) (substring s i n)))))
    (defn bcr-line-end (s i n) (if (ge i n) n (if (str_eq (substring s i (add i 1)) "\n") i (bcr-line-end s (add i 1) n))))
    (defn bcr-title-go (s i n)
        (if (ge i n) ""
            (do (let e (bcr-line-end s i n))
                (let line (bcr-strip (substring s i e) 0 (sub e i)))
                (if (gt (str_len line) 12) (if (gt (str_len line) 160) (substring line 0 160) line) (bcr-title-go s (add e 1) n)))))
    (defn bcr-title (file) (do (let s (read_file file)) (bcr-title-go s 0 (str_len s))))
    (let files (list
        "form/form-stdlib/rag-embed.fk" "form/form-stdlib/rag-retrieve.fk" "form/form-stdlib/nearest-shape.fk"
        "form/form-stdlib/embedding-as-recipe.fk" "form/form-stdlib/feature-vector.fk" "form/form-stdlib/living-vector.fk"
        "form/native/metal/nomic-embed-form.fk" "form/form-stdlib/bml/qwen38-embedding.bml"
        "form/form-stdlib/form-glass-vitals.bml" "form/form-stdlib/form-glass-flow-ui.bml"
        "form/form-stdlib/bml/form-glass-telemetry-membrane.bml" "form/form-stdlib/form-glass-dashboard.bml"
        "form/form-stdlib/bml/bml-demand-jit.bml" "form/form-stdlib/bml/bml-demand-jit-owner.bml" "form/form-stdlib/bml/direct-source-jit-discovery.bml"
        "form/form-stdlib/channel-flow.fk" "form/form-stdlib/kernel-http.fk" "form/form-stdlib/channel-interface.fk"
        "observe/voice-frequency.fk" "form/form-stdlib/core-lexicon.fk" "form/form-stdlib/sha256.fk"))
    (defn bcr-titles (fs) (if (eq (len fs) 0) (empty) (cons (list (head fs) (bcr-title (head fs))) (bcr-titles (tail fs)))))
    (let titled (bcr-titles files))
    (defn bcr-index (ts) (if (eq (len ts) 0) (empty) (cons (rag-entry (nth (head ts) 0) (re-vec (nth (head ts) 1))) (bcr-index (tail ts)))))
    (defn bcr-ear (path src offs ts) (if (eq (len ts) 0) (empty) (cons (rag-entry (nth (head ts) 0) (bcr-embed path src offs (nth (head ts) 1))) (bcr-ear path src offs (tail ts)))))
    (let t0 (now_unix_ms))
    (let index (bcr-index titled))
    (let ear (bcr-ear path src offs titled))
    (let t1 (now_unix_ms))
    (let contract (rcf-contract "nomic-embed-text-v1.5" "gguf-970aa74c" 768 "mean"))
    (defn bcr-ask (path src offs index ear contract q relevant)
        (do (let sq (re-vec q))
            (let tq (bcr-embed path src offs q))
            (let a1 (rcf-serve sq tq index (empty) contract ear 5 2 (empty)))
            (let b1 (rcf-materialize (rcf-answer-cache a1) contract ear (rcf-answer-queue a1) 16))
            (let a2 (rcf-serve sq tq index (rcf-breath-cache b1) contract ear 5 2 (rcf-breath-queue b1)))
            (let curve (rcf-curve sq tq index ear relevant 5 (list 3 5 8 12)))
            (list q
                  (list "old-ear" (rag-topk sq index 5))
                  (list "new-ear" (rcf-native tq ear 5))
                  (list "answer-1" (rcf-answer-state a1) (rcf-answer-ranked a1) (rcf-answer-encoded a1) (rcf-answer-queued a1))
                  (list "answer-2" (rcf-answer-state a2) (rcf-answer-ranked a2))
                  (list "containment-k5" (rcf-containment (rag-topk sq index 5) (rcf-native tq ear 5) 5))
                  (list "curve" curve "depth-eps0" (rcf-observed-depth curve 0) "depth-eps100" (rcf-observed-depth curve 100))
                  (list "reading-k5" (rcf-read sq tq index ear 5 12 5) "k8" (rcf-read sq tq index ear 8 12 5)))))
    (let r1 (bcr-ask path src offs index ear contract "embed a text and find the nearest document"
                (list "form/form-stdlib/rag-embed.fk" "form/form-stdlib/rag-retrieve.fk" "form/form-stdlib/nearest-shape.fk" "form/form-stdlib/embedding-as-recipe.fk" "form/form-stdlib/feature-vector.fk" "form/native/metal/nomic-embed-form.fk" "form/form-stdlib/bml/qwen38-embedding.bml")))
    (let r2 (bcr-ask path src offs index ear contract "show the body's health on the terminal glass"
                (list "form/form-stdlib/form-glass-vitals.bml" "form/form-stdlib/form-glass-flow-ui.bml" "form/form-stdlib/bml/form-glass-telemetry-membrane.bml" "form/form-stdlib/form-glass-dashboard.bml")))
    (let r3 (bcr-ask path src offs index ear contract "compile a hot recipe to native code on demand"
                (list "form/form-stdlib/bml/bml-demand-jit.bml" "form/form-stdlib/bml/bml-demand-jit-owner.bml" "form/form-stdlib/bml/direct-source-jit-discovery.bml")))
    (let t2 (now_unix_ms))
    (print_str (str_concat "titles: " (int_to_str (len titled))))
    (print_str (str_concat "ear-build-ms: " (int_to_str (sub t1 t0))))
    (print_str (str_concat "ask-ms: " (int_to_str (sub t2 t1))))
    (list titled r1 r2 r3))
