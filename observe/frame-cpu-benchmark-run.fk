; Explicit CPU-native cold/warm observations over one captured synthetic frame.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/frame-cpu.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (defn fcbm-one (version capture)
  (do (let calls0 (kernel_stat 47))
      (let t0 (host_monotonic_ms))
      (let row (fc-stat version capture (flm-default-policy)))
      (let t1 (host_monotonic_ms))
      (list row (sub t1 t0) (sub (kernel_stat 47) calls0))))
 (let bytes (flmb-uniform 1024 342 120))
 (let t0 (host_monotonic_ms))
 (let capture (fc-capture bytes))
 (let t1 (host_monotonic_ms))
 (let version (fc-open "frame-cpu-benchmark-v1" (fc-max-pixels)))
 (let t2 (host_monotonic_ms))
 (let first (fcbm-one version capture))
 (let second (fcbm-one version capture))
 (let third (fcbm-one version capture))
 (let oracle0 (host_monotonic_ms))
 (let oracle (flm-stat bytes))
 (let oracle1 (host_monotonic_ms))
 (let released (fc-release version))
 (list "frame-cpu-benchmark-v1" (str_len bytes)
       "validate-ms" (sub t1 t0) "emit-admit-ms" (sub t2 t1)
       "row/wall-ms/native-calls" first second third
       "oracle-row/ms" oracle (sub oracle1 oracle0)
       "released" released "logical-pixel-bytes-per-run" (mul 1024 (mul 342 3))
       "input-delivery" "existing synchronous borrowed-string span"
       "pixel-scope" "three disjoint column regions per run"))
