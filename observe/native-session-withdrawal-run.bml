// preflight-exec: forbidden
// One JSON line: session, event, reason. Retires only the latest completed,
// unpromoted lesson; preserves its evidence and reselects its sealed parent.
// preludes: form-stdlib/native-session-withdrawal.bml
section [form.bml] {
 let request = parse-json("session-withdrawal",read_line());
 let result = nsw-withdraw(hearth-session-learning(),request);
 let shown = print_str(str_concat(json-emit-precise(result),"\n"));
 if eq(nsm-num(result,"ok"),1) then 0 else form_error("session withdrawal refused; evidence preserved");
}
