; session-neutral-phrase-graph-live.fk — actual session turns become dynamic
; two/three-token expression cells and a bidirectional repeated-expression graph.
; witnessed: 2026-08-24 -> 1152 active, 118 repeated, 397 repeated-graph edges
; preludes: cognition/session-neutral-phrase-graph.fk

(do
  (defn snspl-print-repeated (cells remaining)
    (if (or (eq (len cells) 0) (le remaining 0)) 0
      (do
        (print " surfaces=") (print (snsp-c-surfaces (head cells)))
        (print " count=") (print (int_to_str (snsp-c-count (head cells))))
        (print " state=")
        (print (snsp-expression-state (head cells) (empty)))
        (snspl-print-repeated (tail cells) (sub remaining 1)))))
  (let runtime (snsf-open))
  (let request (snsf-resolve-text runtime "en"
    "can we extend this to all symbols to words in most sessions so that we can have better response coverage of the words we are using to ask and respond with a native semantic frequency understanding of which words / symbols / tokens we are using"))
  (let response (snsf-resolve-text runtime "en"
    (read_file "observe/fixtures/2026-08-22-form-native-dialogue-response.txt")))
  (let latest (snsf-resolve-text runtime "en"
    "forget about claude, that was for another session. continue"))
  (let request-cells (snsp-span-cells request 2 3))
  (let response-cells (snsp-span-cells response 2 3))
  (let latest-cells (snsp-span-cells latest 2 3))
  (let active-1 (snsp-observe (empty) request 2 3))
  (let active-2 (snsp-observe active-1 response 2 3))
  (let active-3 (snsp-observe active-2 latest 2 3))
  (let repeated (snsp-repeated active-3))
  (let repeated-graph (snsp-graph repeated (empty)))
  (let latest-first (head latest-cells))
  ; A deliberately small binding witness: three locale expressions are offered
  ; the same closed trust recipe. This proves the dynamic door, not the
  ; translations; the evidence label keeps that distinction visible.
  (let demo-en (snsf-resolve-tokens runtime "en" (list "yes" "trust")))
  (let demo-de (snsf-resolve-tokens runtime "de" (list "ja" "vertrauen")))
  (let demo-zh (snsf-resolve-tokens runtime "zh" (list "是" "信任")))
  (let demo-dict-en (snsr-rebase (empty) demo-en))
  (let demo-dict-de (snsr-rebase demo-dict-en demo-de))
  (let demo-dictionary (snsr-rebase demo-dict-de demo-zh))
  (let demo-phrases-en (snsp-observe (empty) demo-en 2 2))
  (let demo-phrases-de (snsp-observe demo-phrases-en demo-de 2 2))
  (let demo-phrases (snsp-observe demo-phrases-de demo-zh 2 2))
  (let demo-meaning (snsp-meaning demo-dictionary
    (list (snsf-concept-address 490))))
  (let demo-evidence (list (snsf-structure-address 14)))
  (let demo-bind-en (snsp-binding demo-phrases
    (snsp-c-address (head (snsp-span-cells demo-en 2 2))) demo-meaning
    demo-evidence "authored-demonstration-not-speaker-reviewed"))
  (let demo-bind-de (snsp-binding demo-phrases
    (snsp-c-address (head (snsp-span-cells demo-de 2 2))) demo-meaning
    demo-evidence "authored-demonstration-not-speaker-reviewed"))
  (let demo-bind-zh (snsp-binding demo-phrases
    (snsp-c-address (head (snsp-span-cells demo-zh 2 2))) demo-meaning
    demo-evidence "authored-demonstration-not-speaker-reviewed"))
  (let demo-bindings-1 (snsp-add-binding (empty) demo-bind-en))
  (let demo-bindings-2 (snsp-add-binding demo-bindings-1 demo-bind-de))
  (let demo-bindings (snsp-add-binding demo-bindings-2 demo-bind-zh))
  (print "session-neutral-phrase-graph\n")
  (print "phrase-table=0 dynamic-computation=actual-adjacent-arrivals\n")
  (print "recurrence-does-not-mint-meaning=1\n")
  (print "turn-1-generated=") (print (int_to_str (len request-cells)))
  (print " active=") (print (int_to_str (len active-1)))
  (print "\nturn-2-generated=") (print (int_to_str (len response-cells)))
  (print " active=") (print (int_to_str (len active-2)))
  (print "\nturn-3-generated=") (print (int_to_str (len latest-cells)))
  (print " active=") (print (int_to_str (len active-3)))
  (print "\nrepeated-expressions=") (print (int_to_str (len repeated)))
  (print " max-observed-count=") (print (int_to_str (snsp-max-count active-3 0)))
  (print "\nrepeated-expression-graph-edges=")
  (print (int_to_str (len repeated-graph)))
  (print "\nlatest-first-state=")
  (print (snsp-expression-state latest-first (empty)))
  (print "\nlatest-first-neutral-recipe=") (print (snsp-c-recipe latest-first))
  (print "\nshared-neutral-meaning-address=")
  (print (snsp-m-address demo-meaning))
  (print "\nlocale-expressions-bound-to-shared-meaning=")
  (print (int_to_str (len (snsp-bindings-by-meaning demo-bindings
    (snsp-m-address demo-meaning)))))
  (print " evidence-recipe=") (print demo-evidence)
  (print " evidence-state=authored-demonstration-not-speaker-reviewed")
  (print "\nrepeated-samples")
  (snspl-print-repeated repeated 5)
  (print "\n")
  0)
