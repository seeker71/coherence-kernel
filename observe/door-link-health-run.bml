//////////////////////////////////////////////////////////////////////
//
// door-link-health-run.bml
//
// Executable BML. The runnable door for observe/door-link-health.fk:
// re-witness every link the door ring claims, print the field code
// beside its parts, and answer the number that matters at a gate —
// broken. 0 means every door a document names is answered by a cell
// at that path. The reach row follows: every name a cell loads reaches
// one tracked file.
//
//   ./fkwu observe/door-link-health-run.bml
//
// prints  door-link-health doors=<d> links=<l> broken=<b> code=<d*10^6+l*10^3+b>
// then the rows observe/prelude-reach.bml prints (its summary line is
//   prelude-reach lines=<l> tokens=<t> homes=<h> missing=<m> untracked=<u> shadow=<s> pending=<p>)
// and answers <b> plus what the reach row answers. gate/drift-gates.bml
// carries this door as a row that wants 0.
//
// preludes: form-stdlib/core.fk form/form-stdlib/line-grammar.fk observe/door-link-health.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormDoorLinkHealthRun {
        thought door-link-health-run-pattern = list("doors-are-claims", "broken-is-the-answer", "code-beside-its-parts");

        def dlhr-code(doors, links, broken) = ((doors * 1000000) + ((links * 1000) + broken));
        def dlhr-line(doors, links, broken) = str_concat("door-link-health doors=", str_concat(int_to_str(doors), str_concat(" links=", str_concat(int_to_str(links), str_concat(" broken=", str_concat(int_to_str(broken), str_concat(" code=", int_to_str(dlhr-code(doors, links, broken)))))))));
        def dlhr-report() {
            let r = dlh-lint();
            let doors = len(dlh-doors());
            print(dlhr-line(doors, nth(r, 0), nth(r, 1)));
            (nth(r, 1) + dlh-reach());
        }
    }
    dlhr-report();
}
