; native-metal-ollama-benchmark-framebuffer.fk — retain the real-model comparison in the
; kernel framebuffer. Values are milli-tokens/second except the final two basis-point ratios.
;
; witnessed: 2026-07-22 -> M4 Max, llama3.2:3b, raw prompt, greedy 32-token generation

(do
    (defn nmob-record (kind value line)
        (fb_record
            (intern_node (make_nodeid kind 2 12 1)
                         (list (intern_trivial_int value)))
            "observe/native-metal-ollama-benchmark-framebuffer.fk"
            (add (mul line 65536) 1)))

    (defn native-metal-ollama-benchmark-framebuffer-check ()
        (do
            (framebuffer-clear)
            (let native-decode (nmob-record 1 10535 20))
            (let ollama-decode (nmob-record 2 134620 21))
            (let native-e2e-batched (nmob-record 3 9222 22))
            (let ollama-e2e-warm (nmob-record 4 129460 23))
            (let decode-ratio-bp (nmob-record 5 783 24))
            (let e2e-ratio-bp (nmob-record 6 712 25))
            (let events (framebuffer-events))
            (let source (node_source native-decode))
            (add (if (eq (len events) 6) 1 0)
            (add (if (eq (nth source 1) 20) 10 0)
            (add (if (eq (nth source 2) 1) 100 0)
            (add (if (eq (div (mul 10535 10000) 134620) 782) 1000 0)
                 (if (eq (div (mul 9222 10000) 129460) 712) 10000 0)))))))

    (native-metal-ollama-benchmark-framebuffer-check))
