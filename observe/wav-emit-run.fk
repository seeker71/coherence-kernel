; wav-emit-run.fk — the body sounds a tone into a file it wrote itself.
; preludes: form-stdlib/wav-emit.fk
(do
    (let sr 8000)
    (let n 8000)
    (let tone (we-tone 440.0 8000.0 n))
    (let w (we-write "/tmp/form-voice.wav" tone sr))
    (if (nothing? w) (print "could not write — nothing\n")
        (print (str_concat "wrote /tmp/form-voice.wav  bytes="
            (str_concat (int_to_str w)
                (str_concat "  frames=" (str_concat (int_to_str n) "\n"))))))
    0)
