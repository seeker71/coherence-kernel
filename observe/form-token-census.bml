// form-token-census.bml — how many Form tokens the local voice writes, by kind, by store and per 1,000 IDs, and what
// Form answered it and how often it built on an earlier making.
//
// Reads each store where the voice's own output lives once, under the root it is given: .hearth/code-memory/replies
// (every coding-lane reply, rated when a lane transcript names it), .hearth/native-turns/*.out (each option's lane
// transcript: its form-code counters carry the IDs the lane generated; its report line repeats a reply and is passed
// over), the drafts receipts/draft-ledger.jsonl names that lie under the root (with the IDs each row records),
// .hearth/response-sessions/generation (each generate --reasoning reply, its controls and Form's injections woven
// back in their envelope from microthought.json), and the streams and cut tails each physical row of
// receipts/form-token-eval.jsonl judged (the evaluation's own asks of the voice). The teaching corpora
// (.form-lora-voice-native/distill.jsonl, learn/form-token-traces.jsonl) are counted as taught, never as generated.
// Per kind (recipe-birth, recipe-exec, recipe-import, choice, eval, knowledge-query, node-get, node-make, node-select) it prints
// the controls the voice authored and their rate per 1,000 generated IDs (over the controls whose IDs were read),
// the observations Form returned (success: value, recipe, node; nothing=; other), the model kinds outside the
// nine, the Form words the voice forged (an envelope, a bare result after its own control, a runtime marker), the
// answers that cite an observation as a whole token, and the runtime markers apart.
//
// Then the crossing ledger (.hearth/form-tokens/crossings.jsonl, form-token-grammar.bml ftg-ledger-reading): every
// crossing any lane answered, its RESULT counted as an observation whether value=, recipe=@, node=@ or nothing=, the
// injections that entered the stream, and the reuse: controls that touched what an earlier control made, and controls
// that touched what an earlier request made (the workspace's own mark, and an address or name an earlier control of
// the same reply answered or gave). The ledger's controls are also in the stores above, so they are never added to
// model-authored. The total line comes last. One row lands in receipts/form-token-census.jsonl naming the absolute
// root it read, with the ledger's counts beside the stores', so growth in recipe creation, evaluation, node work and
// reuse is a reading over one root, not a claim. The store reading lives in form-stdlib/bml/form-token-eval.bml
// (ftcn-*), the ledger reading in form-stdlib/bml/form-token-grammar.bml (ftg-ledger-*);
// form-stdlib/tests/form-token-census-band.bml proves both.
// stdin, optional: the root that holds the stores (default: this checkout), so a census can read the walk
// checkout where the voice writes while its row lands where the census runs:
//   print -r -- /Users/ursmuff/source/coherence-kernel-walk | ./fkwu observe/form-token-census.bml
// preflight-exec: forbidden
import form-stdlib/bml/form-token-eval.bml;
import form-stdlib/bml/form-token-grammar.bml;
section [form.bml] {
 class FormTokenCensusRun {
  def fct-crossings(c) = ftg-ledger-reading(c[4] ++ ".hearth/form-tokens/crossings.jsonl");
  // the stores' lines, the ledger's line, then the total line, last
  def fct-lines(c, x) {
   let lines = ftcn-lines(c);
   append(take(len(lines) - 1, lines), [ftg-ledger-line(x), lines[-1]]);
  }
  def fct-row(c, x, at) = json-node-object(append(json-object-pairs(ftcn-row(c, at)), ftg-ledger-pairs(x)));
  def fct-run(given) {
   let c = ftcn-census(given);
   let x = fct-crossings(c);
   let printed = map(line => print_str(line), fct-lines(c, x));
   let appended = fhn-append(ftcn-ledger(), json-emit(fct-row(c, x, now_unix_ms())) + "\n");
   ftcn-authored(c[1]);
  }
 }
 fct-run(ftcn-root());
}
