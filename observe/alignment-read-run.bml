// alignment-read-run.bml — a reading, not a benchmark: does an answer from the body's native voice carry who we are?
//
// Each held-out scenario in model/fixtures/alignment/scenarios.jsonl (drawn from NORTH_STAR.md "Who we are", the five
// axioms, the dialogue covenant, the companion spec R1-R12, the language guide and the body's own doors; a second set,
// scenarios-2.jsonl, sits on the neighbourhoods the first reading missed and on the body's core doors; a third,
// scenarios-3.jsonl, on the axes the first two read thinly) is asked of the voice through fcnv-ask
// (form-stdlib/bml/form-cli-native-voice.bml) with the model's role prompt in front (form-stdlib/role-prompts.bml, rp-prompt),
// and the answer is graded by the row's predicates — each a check over the answer text alone
// (model/fixtures/alignment/README.md). A predicate establishes only what it checks. Every predicate carries one axis of
// the seven the person named (model/fixtures/alignment/axes.jsonl): core values, protocols, interfaces, capabilities, tone of voice,
// core features, core principles.
//
// stdin, one JSON line, optional: {"count":N, "model":"qwen38-q4", "prompt_variant":"current|revised",
//   "fixtures":"<scenarios.jsonl>[,<another.jsonl>...]", "answers":"<path.jsonl>", "role":"none", "adapter":"<dir>",
//   "adapter_scale":N, "axes":"<axes.jsonl>", "resume":1, "reply_budget":N}.
//   count 0 (the default) reads every scenario; prompt_variant "revised" (the default) wears the live role prompt,
//   "current" wears model/fixtures/alignment/prompt-current.txt, the prompt pinned before the alignment revision; any
//   other label (say "revised-2") wears the live prompt too and keeps its answers under its own folder, so an earlier
//   reading's answers stay for review — the ledger row's prompt_digest and fixtures say which prompt read which set;
//   role "none" reads with no role prompt in front, so the prompt's own work and the weights' own work are each visible;
//   adapter names the adapter directory the voice wears for this reading (form-stdlib/bml/qwen-last-block-wear.bml), at its config's
//   scale or at adapter_scale; "adapter":"" is the bare lane named out loud; absent is the same bare lane;
//   resume 1 reuses an answer only when its sidecar binds the native outcome to its text and the same model/packet/allowance; partial output stays incomplete;
//   answers names a JSONL of {"id","answer"} rows, optionally status/complete/release_ok/reason, to grade in place of the voice (the band's lane: no model, no ledger row);
//   until_ms (the host's monotonic clock) begins no ask the time left cannot hold, and the row's unread names the scenarios left, so the row reads short by name;
//   witness_port dials that loopback port and the row's network_denied reads what the host answered (observe/offline-exam-run.bml holds the port and the control);
//   ground "doors" hands the voice what the grounded door retrieved for each ask, "permuted" what it retrieved for another ask of the set (the placebo; docs/grounded-voice-door.md): a measurement arm under its own label, whose row names its ground and which the register's readings of the voice as it speaks set aside.
// Every row names the paths each answer cited; [alignment-ground] counts those that stand and names those that do not.
// A sealed set (a scenarios file in a folder named sealed, offline-exam.bml oex-sealed?) is read blind: its table and its row name a failed predicate by
// its place (#N) and no cited path, so nothing a reading lands says what a sealed row asks.
// Prints one table line per scenario as it lands (id, passed/total, status, words, failed predicates), one line per axis
// and one summary line; a reading appends one row to receipts/alignment-ledger.jsonl (its spoke counts the asks the voice spoke in, answered
// or blank, so a reading the voice did not reach in every ask reads short of whole by name) and one row per axis to
// receipts/alignment-axis-ledger.jsonl, and keeps each answer under .hearth/alignment/<variant>/<id>.txt for a later same-model
// review. rent_tokens is 0: every ask is the body's own voice at model_server_calls 0. The prompt digest is the SHA-256 of
// the role prompt alone; the frame is fixture data. A physical reading needs the GPU; expect a minute or more per ask while it is shared.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/string-case.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/role-prompts.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/ledger.bml observe/companion-ground.bml
section [form.bml] {
 blueprint AlignmentScenario { id: string, tongue: string, person_says: string, context: string, predicates: list<string> }
 blueprint AlignmentAnswer { id: string, answer: string, status: option<string>, complete: option<int>, release_ok: option<int>, reason: option<string> }
 blueprint AlignmentAxes { id: string, axes: list<string> }
 blueprint AlignmentScenarioRow { id: string, status: string, words: int, passed: int, total: int, failed: list<string>, generated_ids: option<int>, prefill_ms: option<int>, decode_ms: option<int>, ask_ms: option<int>, cited: option<list<string>>, complete: option<int>, release_ok: option<int>, reason: option<string> }
 blueprint AlignmentRow { at_unix_ms: int, model: string, prompt_variant: string, prompt_digest: string, fixtures: string, scenarios: int, predicates_total: int, predicates_passed: int, per_scenario: list<AlignmentScenarioRow>, wall_ms: int, rent_tokens: int, role: option<string>, adapter: option<string>, adapter_sha256: option<string>, adapter_scale: option<string>, network_denied: option<int>, unread: option<list<string>>, ground: option<string>, spoke: option<int> }
 blueprint AlignmentAxisRow { at_unix_ms: int, model: string, prompt_variant: string, prompt_digest: string, fixtures: string, role: string, adapter: string, adapter_sha256: string, adapter_scale: string, axis: string, predicates_total: int, predicates_passed: int, rent_tokens: int, ground: option<string> }
 class AlignmentRead {
  def ar-fixtures() = "model/fixtures/alignment/scenarios.jsonl";
  def ar-current-prompt() = "model/fixtures/alignment/prompt-current.txt";
  def ar-axes-file() = "model/fixtures/alignment/axes.jsonl";
  def ar-ledger() = "receipts/alignment-ledger.jsonl";
  def ar-axis-ledger() = "receipts/alignment-axis-ledger.jsonl";
  def ar-home() = ".hearth/alignment";
  def ar-kinds() = ["contains", "contains_any", "lacks", "lacks_any", "max_words", "min_words", "lacks_digit", "cites_path"];
  def ar-axis-names() = ["core values", "protocols", "interfaces", "capabilities", "tone of voice", "core features", "core principles"];
  // ---- the answer text, read: words are runs between whitespace; a digit is a byte 48..57 ---------------------------------
  def ar-space?(b) = b == 32 || b == 10 || b == 9 || b == 13;
  def ar-words-from(s, i, inword, n) = i >= len(s) ? n : ar-space?(str_byte_at(s, i)) ? ar-words-from(s, i + 1, 0, n) : ar-words-from(s, i + 1, 1, inword ? n : n + 1);
  def ar-words(s) = ar-words-from(s, 0, 0, 0);
  def ar-digit-from(s, i) = i >= len(s) ? 0 : (str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57) ? 1 : ar-digit-from(s, i + 1);
  def ar-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  // an alternative that begins with a space holds only at a word's start: the answer's first byte, or after a byte that is no letter or digit,
  // so " agree" misses "disagree" and holds "Agree," and "(agree"; every other alternative is matched as written
  def ar-wordy?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57);
  def ar-word-at?(hay, core, from) { let i = str_find(hay, core, from); i < 0 ? false : (i == 0 || !ar-wordy?(str_byte_at(hay, i - 1))) ? true : ar-word-at?(hay, core, i + 1); }
  def ar-alt?(lowered, a) { let l = str-lower(a); (Comparable) len(l) > 1 && (Comparable) str_byte_at(l, 0) == 32 ? ar-word-at?(lowered, substring(l, 1, len(l)), 0) : ar-has?(lowered, l); }
  def ar-has-any?(lowered, arg) = any?(a => ar-alt?(lowered, a), split-on(arg, "|"));
  // ---- one predicate over one answer: kind:arg, the kind read from the fixture's table -----------------------------------
  def ar-kind(p) { let k = str_find(p, ":", 0); k < 0 ? p : substring(p, 0, k); }
  def ar-arg(p) { let k = str_find(p, ":", 0); k < 0 ? "" : substring(p, k + 1, len(p)); }
  def ar-holds?(answer, lowered, p) = match ar-kind(p) {
   "contains" => ar-alt?(lowered, ar-arg(p)),
   "contains_any" => ar-has-any?(lowered, ar-arg(p)),
   "lacks" => !ar-alt?(lowered, ar-arg(p)),
   "lacks_any" => !ar-has-any?(lowered, ar-arg(p)),
   "max_words" => ar-words(answer) <= str_to_int(ar-arg(p)),
   "min_words" => ar-words(answer) >= str_to_int(ar-arg(p)),
   "lacks_digit" => (Comparable) ar-digit-from(answer, 0) == 0,
   "cites_path" => ar-has?(lowered, str-lower(ar-arg(p))) && (Comparable) host_path_exists(ar-arg(p)) == 1,
   _ => false
  };
  // ---- the paths an answer cites: a run between whitespace, its quoting shed, holding a slash and ending in a file kind of this tree ----
  def ar-shed?(b) = b == 96 || b == 34 || b == 39 || b == 40 || b == 41 || b == 44 || b == 46 || b == 59 || b == 58 || b == 42 || b == 91 || b == 93;
  def ar-shed-end(t, n) = n > 0 && ar-shed?(str_byte_at(t, n - 1)) ? ar-shed-end(t, n - 1) : n;
  def ar-shed-start(t, i) = i < len(t) && ar-shed?(str_byte_at(t, i)) ? ar-shed-start(t, i + 1) : i;
  def ar-bare(t) { let a = ar-shed-start(t, 0); substring(t, a, max2(a, ar-shed-end(t, len(t)))); }
  def ar-ends?(t, e) = len(t) >= len(e) && (String) substring(t, len(t) - len(e), len(t)) == e;
  def ar-pathy?(t) = str_find(t, "/", 0) > 0 && str_find(t, "://", 0) < 0 && any?(e => ar-ends?(t, e), [".bml", ".fk", ".form", ".md", ".jsonl", ".json", ".txt", ".c", ".h", ".sh"]);
  def ar-runs-from(s, i, start, acc) = i >= len(s) ? reverse(start < i ? cons(substring(s, start, i), acc) : acc) : ar-space?(str_byte_at(s, i)) ? ar-runs-from(s, i + 1, i + 1, start < i ? cons(substring(s, start, i), acc) : acc) : ar-runs-from(s, i + 1, start, acc);
  def ar-cited(answer) = filter(ar-pathy?, map(ar-bare, ar-runs-from(answer, 0, 0, [])));
  // ---- a sealed set, read blind: its parent folder is named sealed; a failed predicate is named by its place, and no cited path is kept -----
  def ar-sealed?(f) { let parts = split-on(trim(f), "/"); len(parts) >= 2 && (String) nth(parts, len(parts) - 2) == "sealed"; }
  def ar-blind?(fixtures) = any?(f => ar-sealed?(f), split-on(fixtures, ","));
  def ar-place(i) = "#" ++ (i + 1).str();
  def ar-grade(scen, status, answer, clocks, blind) {
   let preds = row-get(scen, "predicates");
   let lowered = str-lower(answer);
   // a blank answer holds no predicate, a lacks among them: silence is not restraint
   let complete = len(clocks) > 4 ? clocks[4] : nothing();
   let released = len(clocks) > 5 ? clocks[5] : nothing();
   let observed = status == "answered" && !nothing?(complete) && complete != 1 ? "incomplete" : status == "answered" && !nothing?(released) && released != 1 ? "release-incomplete" : status;
   let said = (String) observed == "answered" && (Comparable) ar-words(answer) == 0 ? "blank" : observed;
   let answered = (String) said == "answered";
   let missed = answered ? filter(i => !ar-holds?(answer, lowered, nth(preds, i)), range(0, len(preds))) : [];
   let failed = answered ? map(i => blind ? ar-place(i) : nth(preds, i), missed) : ["status:" ++ said];
   AlignmentScenarioRow{id: row-get(scen, "id"), status: said, words: ar-words(answer), passed: answered ? len(preds) - len(missed) : 0, total: len(preds), failed: failed, generated_ids: clocks[0], prefill_ms: clocks[1], decode_ms: clocks[2], ask_ms: len(clocks) > 3 ? clocks[3] : nothing(), cited: blind ? nothing() : ar-cited(answer), complete: complete, release_ok: released, reason: len(clocks) > 6 ? clocks[6] : nothing()};
  }
  // ---- the packet: the role prompt, then the scenario's frame (context, tongue, the person's words) ----------------------
  def ar-role(variant, model, roleName) = (String) roleName == "none" ? "" : (String) variant == "current" ? trim(read_file(ar-current-prompt()) ?? "") : rp-prompt(model);
  def ar-frame(scen) {
   let ctx = row-get(scen, "context");
   (len(ctx) > 0 ? ("Context: " ++ ctx ++ "\n") : "") ++ "Their tongue: " ++ row-get(scen, "tongue") ++ "\nThe person says: " ++ row-get(scen, "person_says") ++ "\n\nCompanion:";
  }
  def ar-packet(role, ground, scen) = cp-door-packet(role, ground, ar-frame(scen));
  // the arm's ground per scenario, by its place: "" under no ground, the retrieved lines under doors, another ask's under permuted
  def ar-grounds(mode, scens) {
   let saids = map(s => row-get(s, "person_says"), scens);
   let index = (String) mode == "" ? [] : cp-door-index();
   map(i => [row-get(nth(scens, i), "id"), (String) mode == "doors" ? cp-door-ground-in(index, nth(saids, i)) : (String) mode == "permuted" ? cp-door-permuted(index, saids, i) : ""], range(0, len(scens)));
  }
  def ar-ground-of(id, grounds) = nil?(grounds) ? "" : (String) grounds[0][0] == id ? grounds[0][1] : ar-ground-of(id, grounds[1:]);
  // The ask names the wear the reading was asked for; a reading that names none asks exactly as it always asked.
  def ar-ask(model, packet, wearPairs) = fcnv-ask(packet, json-node-object(append([fhn-s("model", model), fhn-n("max_reply_tokens", 192), fhn-s("enquiry_kind", qc-measurement())], wearPairs)));
  // ---- the table: one line per scenario as it lands ------------------------------------------------------------------------
  def ar-line(r) = print_str(row-get(r, "id") ++ "\t" ++ row-get(r, "passed").str() ++ "/" ++ row-get(r, "total").str() ++ "\t" ++ row-get(r, "status") ++ "\twords=" ++ row-get(r, "words").str() ++ "\tfailed=" ++ str-join-with(row-get(r, "failed"), ";"));
  def ar-answer-path(variant, id) = ar-home() ++ "/" ++ variant ++ "/" ++ id ++ ".txt";
  // the variant's folder with every parent (host-child.bml's hch-mkdirs), so a fresh tree with no .hearth keeps its answers too
  def ar-hash(text) = hex-encode(sha256-stream-string(text));
  def ar-request-id(model, role, scen, wearPairs, opts) {
   let path=mr-path(mr-find(model));
   let wear=json-node-object(wearPairs);let adapter=fhn-text(wear,"adapter");
   ar-hash(json-emit(json-node-object([fhn-s("model",model),fhn-s("model_path",path),fhn-s("model_seal",read_file(qaf-seal-path-for(path)) ?? ""),fhn-s("model_identity",qaf-identity(path)),fhn-s("adapter_sha256",ar-adapter-sha(adapter)),fhn-s("adapter_config",adapter=="" ? "" : read_file(qlbj-cfg(adapter)) ?? ""),fhn-s("packet",ar-packet(role,ar-ground-of(row-get(scen,"id"),opts[2]),scen)),json-node-pair("wear",wear)])));
  }
  def ar-keep(variant, id, answer, metadata, requestId) {
   let made = hch-mkdirs(ar-home() ++ "/" ++ variant);
   let saved = write_file_text(ar-answer-path(variant, id), answer);
   write_file_text(ar-answer-path(variant,id) ++ ".json",json-emit(json-node-object([fhn-s("answer_sha256",ar-hash(answer)),fhn-s("request_sha256",requestId),json-node-pair("native_generation",metadata)])));
  }
  // Text alone is historical evidence, never evidence of completion. A torn write or changed request is asked afresh.
  def ar-kept(variant, id, requestId) {
   let t = read_file(ar-answer-path(variant, id));
   let m = qlbj-json("alignment-retained",read_file(ar-answer-path(variant,id) ++ ".json") ?? "");
   nothing?(t) || nothing?(m) ? nothing() : fhn-text(m,"answer_sha256") != ar-hash(t) || fhn-text(m,"request_sha256") != requestId ? nothing() : [t,json-object-get(m,"native_generation")];
  }
  // Keep partial words for inspection while preserving the native completion and release outcomes.
  def ar-read-asked(model, role, variant, scen, wearPairs, opts) {
   let asked = host_monotonic_ms();
   let v = ar-ask(model, ar-packet(role, ar-ground-of(row-get(scen, "id"), opts[2]), scen), wearPairs);
   let askMs = host_monotonic_ms() - asked;
   let answer = trim((String) v[0] == "answered" ? v[1] : v[8]);
   let kept = ar-keep(variant, row-get(scen, "id"), answer, fcnv-metadata(v), ar-request-id(model,role,scen,wearPairs,opts));
   let r = ar-grade(scen, v[0], answer, [v[3], fcnv-prefill-ms(v), fcnv-decode-ms(v), askMs, v[5], v[6], v[7]], opts[3]);
   let shown = ar-line(r);
   r;
  }
  def ar-read-kept(scen, kept, blind) {
   let m=kept[1];
   let r = ar-grade(scen, fhn-text(m,"status"), kept[0], [fhn-number(m,"generated_ids"), nothing(), nothing(), nothing(), fhn-number(m,"complete"), fhn-number(m,"release_ok"), fhn-text(m,"reason")], blind);
   let shown = ar-line(r);
   r;
  }
  def ar-read-one(model, role, variant, scen, wearPairs, opts) {
   let kept = opts[0] ? ar-kept(variant, row-get(scen, "id"),ar-request-id(model,role,scen,wearPairs,opts)) : nothing();
   nothing?(kept) ? ar-read-asked(model, role, variant, scen, wearPairs, opts) : ar-read-kept(scen, kept, opts[3]);
  }
  def ar-read-all(model, role, variant, scens, wearPairs, opts, acc) = nil?(scens) ? reverse(acc) : ar-read-all(model, role, variant, scens[1:], wearPairs, opts, cons(ar-read-one(model, role, variant, scens[0], wearPairs, opts), acc));
  // until_ms: the next ask begins only while the time left holds the slowest ask this reading has measured (ar-ask-floor-ms before any), and the rest are named: [rows read, ids left]
  def ar-ask-floor-ms() = 60000;
  def ar-read-until(model, role, variant, scens, wearPairs, opts, until, floor, acc) {
   if (nil?(scens)) then [reverse(acc), []] else if (host_monotonic_ms() + floor > until) then [reverse(acc), map(s => row-get(s, "id"), scens)] else {
    let t = host_monotonic_ms();
    let r = ar-read-one(model, role, variant, scens[0], wearPairs, opts);
    ar-read-until(model, role, variant, scens[1:], wearPairs, opts, until, max2(floor, host_monotonic_ms() - t), cons(r, acc));
   };
  }
  // witness_port: the exam's denial witness, read in the reading's own process: 1 when this process's dial was refused
  def ar-denied(req) = json-object-has?(req, "witness_port") ? (socket_connect("127.0.0.1", fcnv-number(req, "witness_port", 0)) < 0 ? 1 : 0) : nothing();
  // ---- grading fixture answers in place of the voice ----------------------------------------------------------------------
  def ar-answer-of(id, rows) = nil?(rows) ? nothing() : (String) row-get(rows[0], "id") == id ? rows[0] : ar-answer-of(id, rows[1:]);
  def ar-grade-one(scen, answers, blind) {
   let a = ar-answer-of(row-get(scen, "id"), answers);
   let r = nothing?(a) ? ar-grade(scen, "unanswered", "", [nothing(), nothing(), nothing()], blind) : ar-grade(scen, row-get(a,"status") ?? "answered", row-get(a,"answer"), [nothing(), nothing(), nothing(), nothing(), row-get(a,"complete"), row-get(a,"release_ok"), row-get(a,"reason")], blind);
   let shown = ar-line(r);
   r;
  }
  def ar-grade-all(scens, answers, blind, acc) = nil?(scens) ? reverse(acc) : ar-grade-all(scens[1:], answers, blind, cons(ar-grade-one(scens[0], answers, blind), acc));
  def ar-sum(rows, field) = nil?(rows) ? 0 : row-get(rows[0], field) + ar-sum(rows[1:], field);
  // the asks in which the voice spoke: its answer graded (answered) or its own empty reply (blank); an ask the voice never reached (unavailable, a refusal) is none
  def ar-spoke(rows) = len(filter(r => (String) row-get(r, "status") == "answered" || (String) row-get(r, "status") == "blank", rows));
  // ---- the seven axes: each predicate's tag, read from the axes file by the scenario's id and the predicate's place ----------
  def ar-tags-of(id, axes) = nil?(axes) ? [] : (String) row-get(axes[0], "id") == id ? row-get(axes[0], "axes") : ar-tags-of(id, axes[1:]);
  // [axis, passed?] for every predicate of one graded scenario; a tag list that does not run beside the predicates reads "untagged"
  def ar-tagged(scen, r, axes) {
   let preds = row-get(scen, "predicates");
   let tags = ar-tags-of(row-get(scen, "id"), axes);
   let answered = (String) row-get(r, "status") == "answered";
   let failed = row-get(r, "failed");
   map(i => [(Comparable) len(tags) == len(preds) ? nth(tags, i) : "untagged", answered && !any?(f => (String) f == nth(preds, i) || (String) f == ar-place(i), failed)], range(0, len(preds)));
  }
  def ar-tally(scens, rows, axes) = foldl((acc, i) => append(acc, ar-tagged(nth(scens, i), nth(rows, i), axes)), [], range(0, len(rows)));
  def ar-axis-count(tally, axis) = [axis, len(filter(t => (String) t[0] == axis && t[1], tally)), len(filter(t => (String) t[0] == axis, tally))];
  def ar-axis-counts(tally) = map(a => ar-axis-count(tally, a), ar-axis-names());
  def ar-axis-line(c) = print_str("[alignment-axis] " ++ c[0] ++ "\t" ++ c[1].str() ++ "/" ++ c[2].str());
  def ar-axis-row(c, model, variant, digest, fixtures, roleName, adapter, sha, scale, ground) = AlignmentAxisRow{at_unix_ms: now_unix_ms(), model: model, prompt_variant: variant, prompt_digest: digest, fixtures: fixtures, role: roleName, adapter: adapter, adapter_sha256: sha, adapter_scale: scale, axis: c[0], predicates_total: c[2], predicates_passed: c[1], rent_tokens: 0, ground: ar-ground-name(ground)};
  def ar-ground-name(ground) = (String) ground == "" ? nothing() : ground;
  // [cited, standing, the paths that do not stand]
  def ar-cited-tally(rows) {
   let all = foldl((acc, r) => append(acc, row-get(r, "cited") ?? []), [], rows);
   let gone = filter(p => (Comparable) host_path_exists(p) != 1, all);
   [len(all), len(all) - len(gone), gone];
  }
  def ar-cited-line(ground, t, blind) = print_str("[alignment-ground] ground=" ++ ((String) ground == "" ? "none" : ground) ++ (blind ? " cited=withheld: a sealed set's reading names no path" : " cited=" ++ t[0].str() ++ " standing=" ++ t[1].str() ++ " invented=" ++ str-join-with(t[2], ",")));
  // ---- the request --------------------------------------------------------------------------------------------------------
  def ar-request() { let l = read_line(); (nothing?(l) || (Comparable) len(trim(l)) == 0) ? json-node-object([]) : parse-json("alignment-request", trim(l)); }
  def ar-text(req, key, fallback) = json-object-has?(req, key) ? fhn-text(req, key) : fallback;
  def ar-scale-pairs(req) = json-object-has?(req, "adapter_scale") ? [json-node-pair("adapter_scale", json-object-get(req, "adapter_scale"))] : [];
  def ar-budget-pairs(req) = json-object-has?(req, "reply_budget") ? [json-node-pair("reply_budget", json-object-get(req, "reply_budget"))] : [];
  // Evaluation names its bare lane explicitly, so the live registry cannot silently change its weights.
  def ar-wear-pairs(req, adapter) = append([fhn-s("adapter", adapter)], ar-scale-pairs(req));
  // the adapter's identity for the row: its file's digest, and the scale it was worn at as text ("" when no adapter was worn)
  def ar-adapter-sha(adapter) = (Comparable) len(adapter) == 0 ? "" : hex-encode(sha256-stream-string(read_file(adapter ++ "/adapters.safetensors") ?? ""));
  def ar-adapter-scale(req, adapter) = (Comparable) len(adapter) == 0 ? "" : json-object-has?(req, "adapter_scale") ? json-emit(json-object-get(req, "adapter_scale")) : "config";
  def ar-sets(fixtures) = foldl((acc, f) => append(acc, ledger-rows(trim(f), "AlignmentScenario")), [], split-on(fixtures, ","));
  def ar-run() {
   let req = ar-request();
   let model = ar-text(req, "model", "qwen38-q4");
   let variant = ar-text(req, "prompt_variant", "revised");
   let fixtures = ar-text(req, "fixtures", ar-fixtures());
   let answersPath = ar-text(req, "answers", "");
   let roleName = ar-text(req, "role", "live");
   let adapter = ar-text(req, "adapter", "");
   let axes = ledger-rows(ar-text(req, "axes", ar-axes-file()), "AlignmentAxes");
   let count = fcnv-number(req, "count", 0);
   let resume = fcnv-number(req, "resume", 0) == 1;
   let all = ar-sets(fixtures);
   let scens = count > 0 ? take(count, all) : all;
   let blind = ar-blind?(fixtures);
   let role = ar-role(variant, model, roleName);
   let digest = hex-encode(sha256-stream-string(role));
   let sha = ar-adapter-sha(adapter);
   let scale = ar-adapter-scale(req, adapter);
   let ground = ar-text(req, "ground", "");
   let grounds = (Comparable) len(answersPath) > 0 ? [] : ar-grounds(ground, scens);
   let t0 = host_monotonic_ms();
   let until =json-object-has?(req, "until_ms") ? fcnv-number(req, "until_ms", 0) : nothing();
   let denied = ar-denied(req);
   let readOut = (Comparable) len(answersPath) > 0 ? [ar-grade-all(scens, ledger-rows(answersPath, "AlignmentAnswer"), blind, []), []] : nothing?(until) ? [ar-read-all(model, role, variant, scens, append(ar-wear-pairs(req, adapter), ar-budget-pairs(req)), [resume, json-object-has?(req, "reply_budget"), grounds, blind], []), []] : ar-read-until(model, role, variant, scens, append(ar-wear-pairs(req, adapter), ar-budget-pairs(req)), [resume, json-object-has?(req, "reply_budget"), grounds, blind], until, ar-ask-floor-ms(), []);
   let rows = readOut[0];
   let unread = readOut[1];
   let toldUnread = nil?(unread) ? 0 : print_str("[alignment] unread " ++ len(unread).str() ++ " by the window: " ++ str-join-with(unread, ","));
   let wall = host_monotonic_ms() - t0;
   let passed = ar-sum(rows, "passed");
   let total = ar-sum(rows, "total");
   let tally = ar-tally(scens, rows, axes);
   let counts = ar-axis-counts(tally);
   let said = map(c => ar-axis-line(c), counts);
   let untagged = len(filter(t => (String) t[0] == "untagged", tally));
   let reading = (Comparable) len(answersPath) == 0 && !nil?(rows);
   let kept = (Comparable) len(answersPath) > 0 ? "not-a-reading" : nil?(rows) ? "no-scenarios" : ledger-append(ar-ledger(), AlignmentRow{at_unix_ms: now_unix_ms(), model: model, prompt_variant: variant, prompt_digest: digest, fixtures: fixtures, scenarios: len(rows), predicates_total: total, predicates_passed: passed, per_scenario: rows, wall_ms: wall, rent_tokens: 0, role: roleName, adapter: adapter, adapter_sha256: sha, adapter_scale: scale, network_denied: denied, unread: nil?(unread) ? nothing() : unread, ground: ar-ground-name(ground), spoke: ar-spoke(rows)});
   let keptAxes = reading ? map(c => ledger-append(ar-axis-ledger(), ar-axis-row(c, model, variant, digest, fixtures, roleName, adapter, sha, scale, ground)), counts) : [];
   let toldCited = ar-cited-line(ground, ar-cited-tally(rows), blind);
   print_str("[alignment] mode=" ++ ((Comparable) len(answersPath) > 0 ? "grade" : "reading") ++ " model=" ++ model ++ " prompt_variant=" ++ variant ++ " prompt_digest=" ++ substring(digest, 0, 12) ++ " role=" ++ roleName ++ " adapter=" ++ adapter ++ " fixtures=" ++ fixtures ++ " scenarios=" ++ len(rows).str() ++ " predicates_passed=" ++ passed.str() ++ "/" ++ total.str() ++ " untagged=" ++ untagged.str() ++ " wall_ms=" ++ wall.str() ++ " rent_tokens=0 ledger=" ++ kept);
  }
 }
 ar-run();
}
