; stall-resolver-run.fk — the gift the organ verses point at. Reads the same
; census: an owner down is reborn here when the host has room (free pages
; against the model's bytes, hearth-metal-deadline handed before admission);
; more than one live glass renderer is named with its pids as the frame-rate
; cut (those screens are the sitter's to close); the school's stall is read
; from its own log. Publishes voice.resolver; prints name=value lines.
; stdin line 1: "resolve" to act, anything else to only read.
; preflight-exec: forbidden
; preludes: form/form-stdlib/rumi-glass.bml
(do
    (defn sr-say (k v) (print_str (str_concat "resolver " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn sr-trim (s) (if (nothing? s) "" (trim s)))
    (defn sr-int (cmd) (str_to_int (trim (rg-text (host-exec cmd "")))))
    (defn sr-free-gib () (div (mul (sr-int "vm_stat | awk '/Pages free/ {gsub(\"\\\\.\",\"\",$3); print $3}'") 16384) 1073741824))
    (defn sr-model-gib () (div (file_size "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf") 1073741824))
    (defn sr-renderers () (rg-text (host-exec "ps -axo pid=,tty=,etime=,command= | awk '$4 ~ /(^|\\/)fkwu$/ && $5 ~ /glass-live-run/ {printf \"%s@%s:%s \", $1, $2, $3}'" "")))
    (defn sr-birth-owner () (rg-text (host-exec "( /usr/bin/nice -n 10 ./fkwu observe/native-model-dual-resident-live-run.fk > .hearth/owner.out 2>&1 ) >/dev/null 2>&1 & echo launched" "")))
    (defn sr-state (organs name) (if (eq (len organs) 0) "" (if (str_eq (head (head organs)) name) (nth (head organs) 1) (sr-state (tail organs) name))))
    (let mode (sr-trim (read_line)))
    (let organs (rg-organs))
    (let owner (sr-state organs "owner"))
    (let school (sr-state organs "school"))
    (let renderers (sr-renderers))
    (let ncount (rg-ps-count "glass-live-run"))
    (let free (sr-free-gib))
    (let need (add (sr-model-gib) 8))
    (sr-say "owner" (rg-cat (list owner " free-gib=" (int_to_str free) " need-gib=" (int_to_str need))))
    (let born (if (and (str_eq mode "resolve") (and (str_eq owner "down") (ge free need))) (sr-birth-owner) (if (str_eq owner "down") "held (room or mode)" "standing")))
    (sr-say "owner-rebirth" (trim born))
    (sr-say "renderers" (rg-cat (list (int_to_str ncount) " " (trim renderers) (if (gt ncount 1) " -> frame-rate cut: keep one; the second doubles every frame's cost (observer contention receipt, 6.9x)" ""))))
    (sr-say "school" (rg-cat (list school " log-age-s=" (int_to_str (rg-age-s ".form-lora-voice-native/train.log")) (if (str_eq school "stalled") " -> the loop honours its stop file or the trainer was cut; harvest what stands" ""))))
    (let epoch (now_unix_ms))
    (let published (fgtm-publish-snapshot (hearth-telemetry-root) "voice.resolver" epoch (list (fgtm-sample "resolver.owner" (fgtm-absent) "resolver" "form" "voice.resolver" "voice" (if (str_eq (trim born) "launched") "reborn" owner) (fgtm-absent) (fgtm-present free) (if (str_eq owner "down") "failed" "ready") (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "stall-resolver" (list "all" "we" "mesh" "voice")) (fgtm-sample "resolver.renderers" (fgtm-absent) "resolver" "form" "voice.resolver" "voice" (if (gt ncount 1) "contention" "single") (fgtm-absent) (fgtm-present ncount) (if (gt ncount 1) "failed" "ready") (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "stall-resolver" (list "all" "we" "mesh" "voice")))))
    (sr-say "glass" (nth published 1))
    0)
