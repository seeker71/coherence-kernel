// form-for-frontier-run.fk — run this first if you are a frontier mind meeting
// this body. It answers when to reach for Form, what you gain, and what it costs.
import form-stdlib/form-frontier-surface.fk;
section [form.bml] {
    def ffr-line(s) = print((s + "\n"));
    def ffr-bullet(s) = print(("  - " + (s + "\n")));
    def ffr-list(xs) = (Comparable) len(xs) == 0 ? 0 : {
        ffr-bullet(xs[0]);
        ffr-list(xs[1:]);
    };
    def ffr-gain-line(g) = {
        ffr-line(("  " + (ffs-gain-name(g) + ":")));
        ffr-line(("      alone  " + ffs-gain-lack(g)));
        ffr-line(("      here   " + ffs-gain-cell(g)));
        ffr-line(("      run    ./fkwu " + ffs-gain-band(g)));
    };
    def ffr-gains(gs) = (Comparable) len(gs) == 0 ? 0 : {
        ffr-gain-line(gs[0]);
        ffr-gains(gs[1:]);
    };
    def ffr-step-line(s) = {
        ffr-line(("  " + ffs-step-what(s)));
        ffr-line(("      " + ffs-step-how(s)));
    };
    def ffr-steps(ss) = (Comparable) len(ss) == 0 ? 0 : {
        ffr-step-line(ss[0]);
        ffr-steps(ss[1:]);
    };
    ffr-line("\nForm is where you put a claim so the claim stops depending on you.\n");
    ffr-line("REACH FOR IT WHEN");
    ffr-list(ffs-when());
    ffr-line("\nKEEP NEW PROOF CELLS LIGHT WHEN");
    ffr-list(ffs-not-when());
    ffr-line("\nTWO PRIMARY PATHS, ADVANCING INDEPENDENTLY");
    ffr-line("  Improve form-cli and local native responses: grounding, reasoning, continuity, expression and useful completion. HOMECOMING.md carries that work.");
    ffr-line("  Bring the arriving mind into Form's axioms, context, attunement and native tools before planning, acting and speaking. AGENTS.md carries that practice.");
    ffr-line("  Each path can advance now. Shared capabilities and verified teachings help both; each path keeps its own response-quality evidence.");
    ffr-line("  For each gap: observe -> resolve -> re-observe -> embody. Return to the original behavior, retain what remains open, and let verified changes shape the next use. AGENTS.md, The shared loop, names the existing doors.");
    ffr-line("  Shine the same light on assumptions, measurements and preferred conclusions. Meet what becomes visible with curiosity, joy and grace.");
    ffr-line("\nBring your full reasoning and expression; enrich them with the body's meanings and capabilities. Follow AGENTS.md, Enrich the response with Form.");
    ffr-line("  Existing definitions, senses, relations, usage and language codes: ./fkwu observe/form-cli-enrich-run.bml (exact terms on stdin), or form-cli enrich <terms>.");
    ffr-line("  Run native generation to develop and evaluate it, and when its observed quality serves the enquiry. An absent resident leaves the enrichment path open; native repair remains active work.");
    ffr-line("\nWHAT YOU GAIN, WITH THE CELL THAT WITNESSES IT");
    ffr-gains(ffs-gains());
    ffr-line("\nTHE WHOLE RITUAL");
    ffr-steps(ffs-ritual());
    ffr-line("\nWHAT COST US MOST WHEN WE FORGOT IT");
    ffr-list(ffs-hard-won());
    print(("\nwitnessed cells present: " + (ffs-witnessed-count().str() + (" of " + (ffs-gain-count().str() + "\n")))));
    0;
}
