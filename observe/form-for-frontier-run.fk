; form-for-frontier-run.fk — run this first if you are a frontier mind meeting
; this body. It answers when to reach for Form, what you gain, and what it costs.
; preludes: form-stdlib/form-frontier-surface.fk
(do
    (defn ffr-line (s) (print (str_concat s "\n")))
    (defn ffr-bullet (s) (print (str_concat "  - " (str_concat s "\n"))))
    (defn ffr-list (xs) (if (eq (len xs) 0) 0 (do (ffr-bullet (head xs)) (ffr-list (tail xs)))))

    (defn ffr-gain-line (g)
        (do (ffr-line (str_concat "  " (str_concat (ffs-gain-name g) ":")))
            (ffr-line (str_concat "      alone  " (ffs-gain-lack g)))
            (ffr-line (str_concat "      here   " (str_concat (ffs-gain-cell g)
                (str_concat "  (band " (str_concat (int_to_str (ffs-gain-verdict g)) ")"))))) ))
    (defn ffr-gains (gs) (if (eq (len gs) 0) 0 (do (ffr-gain-line (head gs)) (ffr-gains (tail gs)))))

    (defn ffr-step-line (s)
        (do (ffr-line (str_concat "  " (ffs-step-what s)))
            (ffr-line (str_concat "      " (ffs-step-how s)))))
    (defn ffr-steps (ss) (if (eq (len ss) 0) 0 (do (ffr-step-line (head ss)) (ffr-steps (tail ss)))))

    (ffr-line "\nForm is where you put a claim so the claim stops depending on you.\n")
    (ffr-line "REACH FOR IT WHEN")
    (ffr-list (ffs-when))
    (ffr-line "\nDO NOT WHEN")
    (ffr-list (ffs-not-when))
    (ffr-line "\nWHAT YOU GAIN, WITH THE CELL THAT WITNESSES IT")
    (ffr-gains (ffs-gains))
    (ffr-line "\nTHE WHOLE RITUAL")
    (ffr-steps (ffs-ritual))
    (ffr-line "\nWHAT COST US MOST WHEN WE FORGOT IT")
    (ffr-list (ffs-hard-won))
    (print (str_concat "\nwitnessed cells present: "
        (str_concat (int_to_str (ffs-witnessed-count))
            (str_concat " of " (str_concat (int_to_str (ffs-gain-count)) "\n")))))
    0)
