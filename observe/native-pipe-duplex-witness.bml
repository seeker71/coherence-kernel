// Real >8191-byte duplex input/stdout/stderr acceptance.
// preludes: form/form-stdlib/bml/native-pipe-darwin.bml
section [form.bml] {
 class NativePipeDuplex {
  def nppd-payload(n,text) = if eq(n,0) then text else nppd-payload(sub(n,1),str_concat(text,text));
  def nppd-wait(owner,job,until) {
   npp-pump(owner,10);
   if npp-done(owner,job) then 1 else if gt(host_monotonic_ms(),until) then npp-refuse(owner,"duplex deadline") else nppd-wait(owner,job,until);
  }
  def nppd-run() {
   let owner = npp-open(); let job = npp-spawn(owner,list("./fkwu","observe/native-pipe-echo-run.bml"));
   let payload = npp-frame(nppd-payload(14,str_concat("Form",str_concat(byte_to_str(0),"RAM\n"))));
   let submitted = npp-submit(owner,job,payload); npp-half-close(owner,job);
   nppd-wait(owner,job,add(host_monotonic_ms(),20000));
   let output = npp-take(owner,job,"stdout"); let errors = npp-take(owner,job,"stderr");
   let ok = and(submitted,and(eq(record_get(job,"status"),0),and(str_eq(payload,output),str_eq(payload,errors))));
   print(list("bytes",str_len(payload),"stdout",str_len(output),"stderr",str_len(errors),"status",record_get(job,"status"),"error",record_get(job,"error"),"partial-writes",record_get(owner,"partial-writes"),"would-block",record_get(owner,"would-block"),"calls",record_get(owner,"calls"),"reads",record_get(owner,"reads"),"ok",ok));
   let closed = npp-close(owner); if not(and(ok,closed)) then form_error("duplex bytes or release refused") else 1;
  }
 }
 nppd-run();
}
