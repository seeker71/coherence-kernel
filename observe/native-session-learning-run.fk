// preflight-exec: forbidden
// Shell-free session worker. Input: mode, home, request JSON (one line).
import form-stdlib/native-session-learning.bml;
section [form.bml] {
    let mode = read_line();
    let home = read_line();
    let request = read_line();
    (String) mode == "supervise" ? {
        let rc = nsm-supervise(home);
        (Comparable) rc == 0 ? 0 : form_error("session learner failed; actual exit and stderr retained");
    } : (String) mode == "drain" ? nsl-worker(home) : (String) mode == "status" ? print_str(json-emit-precise(nsm-status(home))) : (String) mode == "ask" ? {
        nsl-ask(home, parse-json("session-ask", request));
        0;
    } : form_error("unknown session learning mode");
}
