; preflight-exec: forbidden
; Shell-free session worker. Input: mode, home, request JSON (one line).
; preludes: form-stdlib/native-session-learning.bml
(do
 (let mode (read_line)) (let home (read_line)) (let request (read_line))
 (if (str_eq mode "supervise") (do (let rc (nsm-supervise home)) (if (eq rc 0) 0 (form_error "session learner failed; actual exit and stderr retained")))
 (if (str_eq mode "drain") (nsl-worker home)
  (if (str_eq mode "status") (print_str (json-emit-precise (nsm-status home)))
   (if (str_eq mode "ask") (do (nsl-ask home (parse-json "session-ask" request)) 0)
    (form_error "unknown session learning mode"))))))
