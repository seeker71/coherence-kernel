// Current source/artifact identities, hashed by Form's ARM64 SHA program.
// preflight-exec: forbidden
// preludes: form-stdlib/form-asm.fk form-stdlib/metal-door.fk form-stdlib/form-fs.fk native/metal/sha256-arm64-jit.fk form-stdlib/str-byte-at.fk form-stdlib/hex.fk form-stdlib/json-precise.bml
section [form.bml] {
 class FkwuCurrentIdentity {
  def fki-hex(raw, offset) = if ge(offset, str_len(raw)) then "" else str_concat(hex-byte-to-pair(str_byte_at(raw, offset)), fki-hex(raw, add(offset, 1)));
  def fki-row(path) {
   let size = file_size(path);
   let digest = if lt(size, 0) then "" else saj-file-digest-any-tail(path, size);
   if not(eq(str_len(digest), 32)) then form_error("current identity admission refused") else 0;
   let encoded = fki-hex(digest, 0);
   if not(eq(str_len(encoded), 64)) then form_error("current identity encoding refused") else 0;
   json-node-object(list(
    json-node-pair("path", json-node-string(path)),
    json-node-pair("bytes", json-node-int(size)),
    json-node-pair("sha256", json-node-string(encoded))));
  }
  def fki-rows(paths) = if nil?(paths) then list() else cons(fki-row(head(paths)), fki-rows(tail(paths)));
  def fki-run() {
   let paths = list("runtime/fkwu-uni.c", "fkwu",
    "form/native/metal/fk-metal-carrier.m", "form/native/metal/fk-metal-carrier.dylib",
    "form/form-stdlib/hati-os-kernel.fk", "form/form-stdlib/bml/form-runtime-context.bml",
    "form/form-stdlib/bml/native-lifetime-health.bml", "form/form-stdlib/bml/frame-cpu.bml",
    "form/form-stdlib/bml/frame-metal.bml", "form/form-stdlib/bml/metal-jit.bml",
    "form/form-stdlib/spool-bell-transport.fk", "form/form-stdlib/organ-health.bml",
    "form/form-stdlib/bml/form-cli-heal-native-io.bml", "form/form-stdlib/bml/form-cli-heal-flow.bml",
    "observe/native-lifetime-health-transport-run.bml",
    "form/form-stdlib/bootstrap/form-cli.generation.attestation",
    ".hearth/fkwu-current/form-cli", "os/hati-os/kernel.c", "os/hati-os/guest-native.bml",
    "form/scripts/build_hati_os.sh", ".hearth/fkwu-current/guest/kernel.bin");
   let doc = json-node-array(fki-rows(paths));
   let saved = write_file("docs/evidence/fkwu/identities.json", str_concat(json-emit-precise(doc), "\n"));
   if gt(saved, 0) then len(paths) else form_error("current identity publication refused");
  }
 }
 fki-run();
}
