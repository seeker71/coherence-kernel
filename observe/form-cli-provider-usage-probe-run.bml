// A schema path on stdin. No provider, model, network or state writes.
// preludes: form-stdlib/bml/form-cli-provider-usage-probe.bml
section [form.bml] {
 let path = read_line(); let raw = read_file(path);
 if not(jwa-valid(raw)) then form_error("usage probe needs a complete JSON schema") else 0;
 let report = fpup-run(parse-json(path,raw));
 if le(fpn-num(report,"declared_fields"),0) then form_error("usage probe found no TokenUsageBreakdown properties") else 0;
 print_str(json-emit(report));
 0;
}
