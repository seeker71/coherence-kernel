; we-glass-ask.fk — the shared glass answers a query for any symbol or
; node offered: one word or id on stdin; rows name where it stands.
;   vocab     which channel grammars define it (as a word) and every frame
;             whose body or id carries it: kind, from, turn — its flow
;   corpus    the corpus rows that carry it (a fresh word's row)
;   bus       every glass sample whose id carries it: publisher, lifecycle, evidence
;   primitive the native op manifest row when it names an op
; A node id is asked by its hex prefix; a word by itself. Nothing found
; is said as nothing, never as an empty success.
; stdin lines: the symbol or id; the channel root (blank -> the hearth seat).
; preflight-exec: forbidden
; preludes: form/form-stdlib/we-glass.bml
(do
    (defn wga-say (k v) (print_str (str_concat "ask " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn wga-trim (s) (if (nothing? s) "" (trim s)))
    (defn wga-or (s d) (if (eq (str_len s) 0) d s))
    (defn wga-has (text needle) (ge (str_find text needle 0) 0))
    (defn wga-frames (root name) (append (cc-spool-frames root name (cc-a root name)) (append (cc-spool-frames root name (cc-b root name)) (cc-spool-frames root name (cc-field-name)))))
    (defn wga-frame-rows (name frames q n)
        (if (eq (len frames) 0) n
            (if (or (wga-has (cc-frame-body (head frames)) q) (eq (str_find (cc-frame-id (head frames)) q 0) 0))
                (do (wga-say "flow" (wg-cat (list name " #" (int_to_str (cc-frame-turn (head frames))) " " (cc-frame-kind (head frames)) " from=" (cc-frame-from (head frames)) " id=" (cc-short (cc-frame-id (head frames))) " ms=" (int_to_str (cc-frame-ms (head frames))))))
                    (wga-frame-rows name (tail frames) q (add n 1)))
                (wga-frame-rows name (tail frames) q n))))
    (defn wga-channels (root names q n)
        (if (eq (len names) 0) n
            (do (let g (cc-grammar-current root (head names)))
                (let defined (cc-member? (cc-names-after g (cc-defn-mark)) q))
                (let said (if (eq defined 1) (wga-say "vocab" (wg-cat (list (head names) " defines " q " grammar=" (cc-short (cc-grammar-id g))))) 0))
                (wga-channels root (tail names) q (add (add n defined) (wga-frame-rows (head names) (wga-frames root (head names)) q 0))))))
    (defn wga-bus (troot q)
        (do (let inv (fgtm-inventory troot))
            (if (not (str_eq (nth inv 2) "current")) 0 (wga-bus-readings (nth inv 4) q 0))))
    (defn wga-bus-readings (readings q n)
        (if (eq (len readings) 0) n
            (wga-bus-readings (tail readings) q (add n (wga-bus-samples (nth (head readings) 1) (if (str_eq (fgtm-read-state-status (head readings)) "current") (fgtm-snapshot-samples (fgtm-field-value (fgtm-read-state-value (head readings)))) (list)) q 0)))))
    (defn wga-bus-samples (publisher samples q n)
        (if (eq (len samples) 0) n
            (if (wga-has (fgtm-sample-id (head samples)) q)
                (do (wga-say "bus" (wg-cat (list publisher " " (fgtm-sample-id (head samples)) " " (fgtm-sample-lifecycle (head samples)) " " (fgtm-sample-evidence (head samples)) " " (fgtm-sample-purpose (head samples)))))
                    (wga-bus-samples publisher (tail samples) q (add n 1)))
                (wga-bus-samples publisher (tail samples) q n))))
    (defn wga-op (rows q) (if (eq (len rows) 0) 0 (if (str_eq (head (head rows)) q) (do (wga-say "primitive" (wg-cat (list q " tag=" (int_to_str (nth (head rows) 2)) " arity=" (int_to_str (nth (head rows) 1)) " class=" (nth (head rows) 3)))) 1) (wga-op (tail rows) q))))
    (defn wga-corpus (q)
        (do (let hit (wg-text (host-exec (wg-cat (list "grep -n '\"" q "\"' " (WGCorpusPath) " | head -3")) "")))
            (if (eq (str_len (trim hit)) 0) 0 (do (wga-say "corpus" (trim hit)) 1))))
    (let q (wga-trim (read_line)))
    (let root (wga-or (wga-trim (read_line)) (cc-root-default)))
    (if (eq (str_len q) 0) (wga-say "signal" "nothing reason=empty-query")
        (do (wga-say "query" q)
            (let n (add (wga-channels root (cc-mesh-names root) q 0) (add (wga-bus (hearth-telemetry-root) q) (add (wga-op (nom-ops) q) (wga-corpus q)))))
            (wga-say "found" (if (eq n 0) "nothing" (int_to_str n)))
            0)))
