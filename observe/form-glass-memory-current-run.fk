; Read-only non-demo memory frames; no sensor publication, owner poke or admission.
; preludes: form/form-stdlib/form-glass-live.bml
(do
  (let epoch (now_unix_ms))
  (let inventory (fgtm-inventory (FGLRoot)))
  (let external (fgl-external-samples (fgl-inventory-samples-at inventory epoch)))
  (let samples (append (fgl-owner-derived-ledger-samples external epoch) external))
  (let metrics (fgo-age-rows-at (append
    (fgo-observe-rows (append (fgo-kernel-rows) (fgo-host-rows (host_vm_stat))) epoch 0)
    (append (fgsr-rows-or-absent-at "owner" (fgsr-take "owner" (list)) epoch)
      (fgsr-rows-or-absent-at "storage" (fgsr-take "storage" (list)) epoch))) epoch))
  (let observations (fgl-inspection-observations epoch samples))
  (print (list "memory-current-v1" "epoch" epoch "scope" "probe-process+host+published-owner"))
  (print (list "memory-observation-gaps" (len (fglui-seam-observations (fglui-view-observations observations "memory")))) )
  (print_str (ftc-ansi-segment-lines (fglui-body 160 36 epoch "memory" "all" "all" 0 metrics samples (list) observations)))
  (print_str (ftc-ansi-segment-lines (fglui-body 80 20 epoch "memory" "all" "all" 0 metrics samples (list) observations)))
  0)
