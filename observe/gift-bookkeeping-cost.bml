// Bounded ledger cost after actual map/release churn. Counts, not payloads.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class GiftBookkeepingCost {
  def gbc-churn(name, n) = if le(n, 0) then 0 else gbc-closed(name, sub(n, 1), shm_receive(name));
  def gbc-closed(name, n, h) {
   let released = shm_release(h);
   gbc-churn(name, n);
  }
  def gbc-read(n, sum) = if le(n, 0) then sum else gbc-read(sub(n, 1), add(sum, kernel_stat(41)));
  def gbc-timed() {
   let started = now_unix_ms();
   let value = gbc-read(20000, 0);
   list(sub(now_unix_ms(), started), value);
  }
  def gbc-run() {
   let name = str_concat("/fg-cost-", int_to_str(host_pid()));
   let h = shm_offer(name, 4096);
   let before = gbc-timed();
   let churn = gbc-churn(name, 20000);
   let after = gbc-timed();
   let closed = shm_release(h);
   list("gift-bookkeeping-cost", "reads", 20000, "retired-handles", 20000, "before-ms", head(before), "after-ms", head(after), "same-count", eq(nth(before, 1), nth(after, 1)), "closed", closed);
  }
 }
 gbc-run();
}
