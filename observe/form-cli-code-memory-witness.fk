; Local Qwen continuity witness over public fixture data. No source publication.
; stdin: isolated memory directory, checkpoint id (empty = fresh job), model.
; "seed" instead of checkpoint writes an explicitly injected failing candidate.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/form-cli-code-repair-fixture.bml
(do
 (let root (read_line))
 (let resume (read_line))
 (let model (read_line))
 (let initial (fcap-open (fcrf-goal) (fcrf-docs) (list "calc.form")))
 (let checks (json-emit (json-node-array (fcrf-contract))))
 (let prepared (fcam-prepare root initial checks (if (str_eq resume "seed") "" resume) (fcrf-checker)))
 (if (str_eq resume "seed")
  (do
   (let failed (fcam-with (fcrf-failure) (fcam-context prepared)))
   (let saved (fcam-save failed))
   (list "seeded-failure" (fcap-failures failed) "checks" (fcap-checks failed) "checkpoint-written" saved "checkpoint-id" (fcam-id failed)))
  (do
   (print (list "starting-role" (fcap-stage prepared) "prior-turns" (fcap-turns prepared) "lessons-recalled" (fcam-hits prepared)))
   (let result (fcac-admit model prepared (fcrf-checker) 8192 (add (fcap-turns prepared) 30)))
   (print_str (str_concat (fcaq-result result) "\n")))))
