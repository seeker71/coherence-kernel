; conflict-mark-scan-run.fk — the runnable door for observe/conflict-mark-scan.fk.
;
; Direct-source Form does not read argv, so the paths arrive in a file, one per
; line. That is the same shape validate.sh already has to hand:
;
;   git ls-files > /tmp/conflict-mark-target
;   ./fkwu observe/conflict-mark-scan-run.fk
;
; THE TARGET PATH IS SHARED GROUND. A sibling agent running this at the same
; moment writes the same /tmp file, and you would then scan THEIR list against
; YOUR tree and read the result as yours. If more than one lane is live, write
; a distinct target and change the one line below rather than trusting the
; collision not to happen.
;
; WHAT IT PRINTS. One line per file that holds anything, whichever it holds:
;
;   conflict <path>:<line>     a live open AND a live close mark — resolve it
;   cited    <path> n=<count>  citedmarks only — testimony, nothing to resolve
;
; A citedmark is REPORTED, not suppressed. A body that records a syntax holds
; instances of it, and the honest reading is to say so and say it is quoted.
; Silence would make this scan indistinguishable from one that simply cannot
; see them.
;
; The last line is the tally, and the exit reading is the conflict count — zero
; citedmarks can ever change it.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: observe/conflict-mark-scan.fk

(do
    (defn cmsr-target-file () "/tmp/conflict-mark-target")

    (defn cmsr-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n") (cmsr-trim-loop s (sub n 1))
                (substring s 0 n))))

    (defn cmsr-line (name value)
        (print_str (str_concat name (str_concat value "\n"))))

    ; Walk the list without materializing it: one path at a time, from the
    ; previous newline to the next.
    (defn cmsr-walk (text from conflicts citeds)
        (if (ge from (str_len text)) (list conflicts citeds)
            (do
                (let nl (str_find text "\n" from))
                (let end (if (lt nl 0) (str_len text) nl))
                (let path (substring text from end))
                (let next (add end 1))
                (if (eq (str_len path) 0)
                    (cmsr-walk text next conflicts citeds)
                    (do
                        (let s (cms-scan-file path))
                        (if (eq (cms-conflicted? s) 1)
                            (do (cmsr-line "conflict "
                                    (str_concat path
                                        (str_concat ":" (int_to_str (cms-first-line s)))))
                                (cmsr-walk text next (add conflicts 1) citeds))
                            (if (gt (cms-citedmarks s) 0)
                                (do (cmsr-line "cited    "
                                        (str_concat path
                                            (str_concat " n=" (int_to_str (cms-citedmarks s)))))
                                    (cmsr-walk text next conflicts (add citeds 1)))
                                (cmsr-walk text next conflicts citeds))))))))

    (defn cmsr-run ()
        (if (eq (fs_exists (cmsr-target-file)) 0)
            (do (cmsr-line "conflict-mark-scan-run: write the paths, one per line, to "
                           (cmsr-target-file))
                -1)
            (do
                (let raw (read_file (cmsr-target-file)))
                (let r (cmsr-walk (cmsr-trim-loop raw (str_len raw)) 0 0 0))
                (cmsr-line "files with live conflicts  " (int_to_str (nth r 0)))
                (cmsr-line "files with citedmarks only " (int_to_str (nth r 1)))
                (nth r 0))))

    (cmsr-run))
