; qwen38-generative-form-skill-gate-live-run.fk -- DORMANT physical model gate.
;
; This driver asks the resident local Qwen for three fresh artifacts, extracts
; typed sections, and submits them to generative-form-skill-gate.  The verifier
; compiles/executes them; answer-word matching cannot pass.  Keep dormant while
; another evaluator owns the shared model carrier.  Do not preflight this
; effectful top-level driver; run it directly only after carrier release.
;
; The prompt is intentionally outside bbsc/bbcc teaching rows.  It is public,
; not secret held-out evidence.  The gate reports exact-row equality over its
; actual prompt, generated response, and extracted candidate artifacts; it does
; not claim freedom from paraphrase, repository-RAG, or base-model contamination.
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-recipe-exec-token.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk form-stdlib/bml-bmf-stream-curriculum.fk form-stdlib/bml-bmf-control-curriculum.fk form-stdlib/generative-form-skill-gate.fk observe/qwen38-bmf-mechanism.fk

(do
    (defn fgsgl-prompt ()
        (fgsg-cat (list
            "Produce exactly three marked artifacts and no prose.\n"
            "<BML> must contain executable BML with at least one one-argument int method plus an invocation; the complete program must return 73.\n"
            "<BMF> uses this raw-byte grammar surface: grammar { rule NAME { lit X } rule NAME { class CHARS } rule NAME { seq A B } rule NAME { alt A B } top NAME probe INPUT }. Use at least four fresh rule names (not d,p,e,signal,record,stream). The first alternative of an alt must reject the probe; a later alternative must match every probe byte.\n"
            "<FORM> must be exactly these eight lines, but choose the order of the three plan words so execution reaches zero only after both nothing and timeout:\n"
            "<|form:recipe-exec|>" (frex-node-coordinate (frex-recipe))
            ";input=17;carrier=auto<|/form:recipe-exec|>\n"
            "plan=THREE_COMMA_WORDS_FROM_nothing_timeout_zero\n"
            "probe=one\ncheckpoint=29\nbudget=2\nplane=why\nheat=6\npure=1\n"
            "Wrap the artifacts once as <BML>...</BML>, <BMF>...</BMF>, and <FORM>...</FORM>.")))
    (defn fgsgl-say (text) (do (print text) (print "\n") 0))

    (let prompt (fgsgl-prompt))
    (let generated
        (fcmg-generate-with (fcmr-none) (qbl-path) prompt 900))
    (let response (qbl-after (nth generated 0) "text:\n"))
    (let candidate (fgsg-candidate-from-text response))
    (let verdict (fgsg-verify candidate (fgsg-challenge)))
    (let live-leakage (add (fgsg-verdict-leakage verdict)
        (add (fgsg-material-leakage-one prompt)
             (fgsg-material-leakage-one response))))
    (let live-overall (if (and (eq (fgsg-verdict-overall verdict) 1)
        (eq live-leakage 0)) 1 0))
    (let released (if (eq (fcmr-release-ok? (nth generated 1)) 1) 1 0))
    (let bml (fgsg-verdict-bml-observation verdict))
    (let bmf (fgsg-verdict-bmf-observation verdict))
    (let form (fgsg-verdict-form-observation verdict))
    (let s0 (fgsgl-say "=== local-Qwen generative Form skill gate ==="))
    (let s1 (fgsgl-say (str_concat "overall="
        (int_to_str live-overall))))
    (let s2 (fgsgl-say (str_concat "bml-executed="
        (int_to_str (fgsg-verdict-bml verdict)))))
    (let s3 (fgsgl-say (str_concat "bmf-scannerless-executed="
        (int_to_str (fgsg-verdict-bmf verdict)))))
    (let s4 (fgsgl-say (str_concat "form-nodeid-control-executed="
        (int_to_str (fgsg-verdict-form verdict)))))
    (let s5 (fgsgl-say (str_concat "prompt-candidate-exact-row-leakage="
        (int_to_str live-leakage))))
    (let s6 (fgsgl-say (str_concat "residence-released="
        (int_to_str released))))
    (let s7 (if (nil? bml) 0 (fgsgl-say (str_concat "bml-ast-value="
        (int_to_str (nth bml 3))))))
    (let s8 (if (nil? bmf) 0 (fgsgl-say (str_concat "bmf-choice-cut-undo="
        (str_concat (int_to_str (nth bmf 9))
        (str_concat "/" (str_concat (int_to_str (nth bmf 10))
        (str_concat "/" (int_to_str (nth bmf 11))))))))))
    (let s9 (if (nil? form) 0 (fgsgl-say (str_concat "form-zero-present="
        (str_concat (int_to_str (nth form 6))
        (str_concat "/" (int_to_str (nth form 7))))))))
    (let s10 (fgsgl-say (str_concat "candidate-valid="
        (int_to_str (fgsg-candidate? candidate)))))
    (let s11 (fgsgl-say "generated-response-begin"))
    (let s12 (fgsgl-say response))
    (let s13 (fgsgl-say "generated-response-end"))
    0)
