// preflight-exec: forbidden
// Same fresh instruction with current quantities and attributed historical sections.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 let root = ".hearth/response-parity/attributed-comparison-v1";
 fs-mkdir(".hearth"); fs-mkdir(".hearth/response-parity");
 let sourcePath = "receipts/artifacts/2026-09-20-source-restored-provider-source.json";
 let domain = fcr-attributed-domain(parse-json(sourcePath,read_file(sourcePath))); let source = fcr-fresh-domain(domain);
 let packet = fcr-fresh-packet(domain);
 if fs_exists(str_concat(root,"/result.json")) then {
  fcr-need(str_eq(fcr-packet(str_concat(root,"/packet.json")),packet),"retained fresh-comparison packet differs; inspect before a new experiment");
  print_str(json-emit(json-node-object(list(nsm-n("native_model_calls_new",0),nsm-s("native_usage_event",root),json-node-pair("retained_result",parse-json("retained-result",read_file(str_concat(root,"/result.json"))))))));
 } else {
  fcr-need(eq(host_dir_mkdir(root),1),"fresh native comparison already admitted; inspect its owned process");
  frsh-frozen(str_concat(root,"/source.json"),json-emit(source));
  frsh-frozen(str_concat(root,"/packet.json"),json-emit(json-node-object(list(nsm-s("packet",packet)))));
  frsh-frozen(str_concat(root,"/rubric.md"),"Frozen before generation: compare with the scoped-composition answer. Instruction, enquiry, current measurements, concepts, coverage, Qwen base, profile, context and output allowance stay fixed. Historical author commentary alone changes: selected verbatim qualitative sections carry explicit attribution, omitted sections are named, and the original source identity remains available. Inspect actual token totals and their scope, output sizes, citations, attribution, proposed versus completed work, and the practical conclusion. This changes both selection and organization; a single observation cannot isolate their effects or establish parity. No evaluation training.\n");
  let observation = oh-reading("native-voice",root,"historical-attribution",json-node-string("current-measurements-and-attributed-judgments"),json-node-string("historical-prose-overrides-current-quantities-and-broadens-judgments"),json-node-int(0),list(),list("compose-from-current-sources"),oh-reference("receipts/artifacts/2026-09-20-scoped-native-comparison-answer.md"));
  let control = oh-response(observation,"compose-from-current-sources");
  fcr-need(str_eq(oh-select(observation,control,""),"compose-from-current-sources"),"fresh composition control did not correlate");
  oh-emit(str_concat(root,"/events.jsonl"),observation); oh-emit(str_concat(root,"/events.jsonl"),control);
  let started = now_unix_ms(); let generated = fcnv-run(packet,mr-path(mr-find("qwen38-q8")),12288,2048);
  let elapsed = sub(now_unix_ms(),started); fcnv-retain(root,generated);
  let raw = nth(generated,8); let valid = and(str_eq(nth(generated,0),"answered"),faj-valid(raw));
  let parsed = if valid then parse-json("fresh-answer",raw) else json-node-object(list());
  let answer = if valid then fcap-string(parsed,"answer") else "";
  let result = json-node-object(list(nsm-s("answer_source","Qwen3.8-27B-Q8_0 through fkwu knowledge-query"),nsm-s("source_sha256",fcam-hash(json-emit(source))),nsm-n("elapsed_ms",elapsed),json-node-pair("generation",fcnv-metadata(generated)),nsm-n("valid_json",valid),nsm-n("answer_nonempty",not(str_eq(trim(answer),""))),nsm-n("training",0),json-node-pair("semantic_quality",json-node-null()),json-node-pair("human_resonance",json-node-null()),nsm-s("scope","Same fresh instruction and current evidence as scoped composition; historical commentary selected and organized with per-section attribution. Preparation, compilation, retention, learning and coordinator excluded. One paired answer is not evidence of stable quality or overall parity.")));
  frsh-frozen(str_concat(root,"/result.json"),json-emit(result));
  let prefix = "receipts/artifacts/2026-09-20-attributed-native-comparison";
  frsh-frozen(str_concat(prefix,"-source.json"),json-emit(source));
  frsh-frozen(str_concat(prefix,"-packet.json"),read_file(str_concat(root,"/packet.json")));
  frsh-frozen(str_concat(prefix,"-raw.txt"),raw); frsh-frozen(str_concat(prefix,"-answer.md"),answer);
  frsh-frozen(str_concat(prefix,"-result.json"),json-emit(result));
  frsh-frozen(str_concat(prefix,"-coordinator-cost.json"),json-emit(ftc-read()));
  oh-emit(str_concat(root,"/events.jsonl"),oh-applied(observation,"compose-from-current-sources",result));
  print_str(json-emit(json-node-object(list(nsm-n("native_model_calls_new",1),nsm-s("native_usage_event",root),json-node-pair("retained_result",result)))));
 };
 1;
}
