; native-model-glass-build-diagnostic-run.fk — bounded causal exchange for
; the BML lowering surprise found while seating the model glass.
;
; No prompt or answer content enters this window. The payloads name only the
; compile-state codes and the re-observation checks the revised source.
;
; preludes: form/form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn nmgbd-has (path needle)
        (if (ge (str_find (read_file path) needle 0) 0) 1 0))
    (defn nmgbd-apply-revise (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound)
                                 (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    (framebuffer-clear)
    ; 3901: an inline comment inside a list expression survived BML lowering
    ; as an unresolved `//` call. 3902 moves commentary outside that expression.
    (let outbound (bfc-envelope 0 83901 0 3901 3902))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let applied (nmgbd-apply-revise outbound inbound 3901 3902))
    (let source-witness
        (if (eq (nmgbd-has "form/form-stdlib/native-model-glass.bml"
                    "// The native world is part of the running Form image") 0)
            1 0))
    (let reobserved (if (eq applied 3902) source-witness 0))
    (let outbound2 (bfc-envelope 0 84001 0 reobserved 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))
    ; 3911: the Qwen subshell returned successfully, then the route script
    ; fell through into the legacy Ollama switch. 3912 exits with the direct
    ; branch's status before that switch can run.
    (let outbound3 (bfc-envelope 0 83902 0 3911 3912))
    (let out-event3 (bfc-record-out outbound3 5))
    (let inbound3 (bfc-control outbound3 2))
    (let in-event3 (bfc-record-in inbound3 6))
    (let applied3 (nmgbd-apply-revise outbound3 inbound3 3911 3912))
    (let route-source-witness
        (if (eq (nmgbd-has "form/scripts/native_model_route.sh"
                    "qwen_status=$?") 1)
            (if (eq (nmgbd-has "form/scripts/native_model_route.sh"
                        "exit \"$qwen_status\"") 1) 1 0)
            0))
    (let reobserved3 (if (eq applied3 3912) route-source-witness 0))
    (let outbound4 (bfc-envelope 0 84002 0 reobserved3 0))
    (let out-event4 (bfc-record-out outbound4 7))
    (let inbound4 (bfc-control outbound4 0))
    (let in-event4 (bfc-record-in inbound4 8))
    ; 3921: a compile preflight executes the just-built cell with EOF stdin;
    ; the first stable runner treated that as a model prefix and entered the
    ; expensive evaluator. 3922 refuses missing control lines before q4s-open.
    (let outbound5 (bfc-envelope 0 83903 0 3921 3922))
    (let out-event5 (bfc-record-out outbound5 9))
    (let inbound5 (bfc-control outbound5 2))
    (let in-event5 (bfc-record-in inbound5 10))
    (let applied5 (nmgbd-apply-revise outbound5 inbound5 3921 3922))
    (let eof-source-witness
        (nmgbd-has "observe/qwen4exp-flash-next-glass-route-run.fk"
            "missing-control-lines"))
    (let reobserved5 (if (eq applied5 3922) eof-source-witness 0))
    (let outbound6 (bfc-envelope 0 84003 0 reobserved5 0))
    (let out-event6 (bfc-record-out outbound6 11))
    (let inbound6 (bfc-control outbound6 0))
    (let in-event6 (bfc-record-in inbound6 12))
    ; 3931: on this fkwu, read_line("abc") is [nothing?=0, lt-zero=1].
    ; The copied REPL sentinel therefore rejected every real control line.
    ; 3932 uses nothing? plus the explicit empty-string check only.
    (let outbound7 (bfc-envelope 0 83904 0 3931 3932))
    (let out-event7 (bfc-record-out outbound7 13))
    (let inbound7 (bfc-control outbound7 2))
    (let in-event7 (bfc-record-in inbound7 14))
    (let applied7 (nmgbd-apply-revise outbound7 inbound7 3931 3932))
    (let line-source-witness
        (if (eq (nmgbd-has
                    "observe/qwen4exp-flash-next-glass-route-run.fk"
                    "(if (lt line 0) 1") 0) 1 0))
    (let reobserved7 (if (eq applied7 3932) line-source-witness 0))
    (let outbound8 (bfc-envelope 0 84004 0 reobserved7 0))
    (let out-event8 (bfc-record-out outbound8 15))
    (let inbound8 (bfc-control outbound8 0))
    (let in-event8 (bfc-record-in inbound8 16))
    (list "native-model-glass-build-diagnostic"
        "before" 3901 "applied" applied "reobserved" reobserved
        "route-before" 3911 "route-applied" applied3
        "route-reobserved" reobserved3
        "eof-before" 3921 "eof-applied" applied5
        "eof-reobserved" reobserved5
        "line-before" 3931 "line-applied" applied7
        "line-reobserved" reobserved7
        "framebuffer-events" (len (framebuffer-events))))
