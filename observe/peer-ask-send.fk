// peer-ask-send.fk — generic parallel client for the resident peer: one
// task frame appended to the shared spool, one ring. (first hearth patch: applied by the servant, 2026-08-31) Many of these run
// concurrently against ONE resident; the transport's length-safe frames
// and the bell's drain-all-present law are what make parallel submission
// safe without a server restart.
// stdin lines: task spool, fifo bell, turn, kind, body text.
import form-stdlib/spool-bell-transport.fk;
import form-stdlib/form-cli-peer-agent.fk;
section [form.bml] {
    let spool = read_line();
    let bell = read_line();
    let turn = str_to_int(read_line());
    let kind = read_line();
    let body = read_line();
    let frame = (fcpa-task-frame(turn, kind, body) + "\n");
    let appended = sbt-append(spool, frame);
    let rung = sbt-ring(bell);
    print(("turn=" + (turn.str() + (" appended=" + (appended.str() + (" rung=" + rung.str()))))));
    0;
}
