; peer-ask-send.fk — generic parallel client for the resident peer: one
; task frame appended to the shared spool, one ring. Many of these run
; concurrently against ONE resident; the transport's length-safe frames
; and the bell's drain-all-present law are what make parallel submission
; safe without a server restart.
; stdin lines: task spool, fifo bell, turn, kind, body text.
; preludes: form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk
(do
    (let spool (read_line))
    (let bell (read_line))
    (let turn (str_to_int (read_line)))
    (let kind (read_line))
    (let body (read_line))
    (let frame (str_concat (fcpa-task-frame turn kind body) "\n"))
    (let appended (sbt-append spool frame))
    (let rung (sbt-ring bell))
    (print (str_concat "turn=" (str_concat (int_to_str turn)
        (str_concat " appended=" (str_concat (int_to_str appended)
        (str_concat " rung=" (int_to_str rung)))))))
    0)
