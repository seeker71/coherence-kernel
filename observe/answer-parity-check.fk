// answer-parity-check.fk — the structural floor for "equal or better" on an
// answer to the pinned enquiry: one form-cli call, equal or better than the guided flow.
// apc-floor reads one answer text and returns
//   (axes-named-of-nine receipts-cited receipts-existing names-limits bytes)
// Structure is the floor; the reading of the answer stays with the person.
// No model, provider or socket is opened. The flows that read this floor are
// form/form-stdlib/bml/form-cli-native-compare.bml and form-cli-voice-walk.bml;
// the contest rows live in receipts/parity-contest-ledger.jsonl.
// witnessed: 2026-09-18 -> observed
import form-stdlib/core.fk;
section [form.bml] {
    def apc-axes() = ["quality", "volume", "frequency", "vitality", "trust", "traceability", "sovereignty", "resonance", "rent"];
    // an axis counts once whether the answer writes it lowercase or as a heading
    def apc-axes-cap() = ["Quality", "Volume", "Frequency", "Vitality", "Trust", "Traceability", "Sovereignty", "Resonance", "Rent"];
    def apc-count-axes(text, axes) = apc-count-axes-2(text, axes, apc-axes-cap());
    def apc-count-axes-2(text, axes, caps) = nil?(axes) ? 0 : (Number) (str_find(text, axes[0], 0) < 0 && (nil?(caps) || str_find(text, caps[0], 0) < 0) ? 0 : 1) + (Number) apc-count-axes-2(text, axes[1:], nil?(caps) ? caps : caps[1:]);
    def apc-member?(xs, x) = nil?(xs) ? 0 : (String) xs[0] == x ? 1 : apc-member?(xs[1:], x);
    def apc-cited(text, from, acc) = {
        let at = str_find(text, "receipts/2026-", from);
        at < 0 ? acc : {
            let end = str_find(text, ".md", at);
            end < 0 ? acc : {
                let path = substring(text, at, (Number) end + (Number) 3);
                // a path broken by a space or a line wrap is not a citation
                let clean = str_find(path, " ", 0) >= 0 || str_find(path, "\n", 0) >= 0 ? 0 : 1;
                apc-cited(text, (Number) end + (Number) 3, (Comparable) clean == 0 || (Comparable) apc-member?(acc, path) == 1 ? acc : append(acc, [path]));
            };
        };
    };
    def apc-existing(paths) = nil?(paths) ? 0 : (Number) (fs_exists(paths[0]) ? 1 : 0) + (Number) apc-existing(paths[1:]);
    // the ways an answer admits a limit; each phrase is an admission, none a claim
    def apc-limit-phrases() = ["not establish", "pending", "not measured", "unmeasured", "cannot", "can't", "does not define", "nothing in these", "no exact entr", "no receipt", "not supported", "not defined", "Pending", "Not establish", "Cannot", "Unmeasured", "Not measured"];
    def apc-any?(text, phrases) = nil?(phrases) ? 0 : str_find(text, phrases[0], 0) >= 0 ? 1 : apc-any?(text, phrases[1:]);
    def apc-limits(text) = apc-any?(text, apc-limit-phrases());
    def apc-floor(text) = {
        let cited = apc-cited(text, 0, []);
        [apc-count-axes(text, apc-axes()), len(cited), apc-existing(cited), apc-limits(text), len(text)];
    };
    def apc-text(path) = (String) path == "" ? "" : {
        let text = read_file(path);
        nothing?(text) ? "" : text;
    };
    0;
}
