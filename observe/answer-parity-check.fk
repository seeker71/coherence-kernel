; answer-parity-check.fk — the structural floor for "equal or better" on an
; answer to the pinned enquiry of docs/single-call-parity-goal.form.
; apc-floor reads one answer text and returns
;   (axes-named-of-nine receipts-cited receipts-existing names-limits bytes)
; Structure is the floor; the reading of the answer stays with the person.
; No model, provider or socket is opened. The runnable door is
; observe/answer-parity-check-run.fk; the contest door is
; observe/parity-contest-run.bml.
; witnessed: 2026-09-18 -> observed
; preludes: form-stdlib/core.fk

(do
    (defn apc-axes ()
        (list "quality" "volume" "frequency" "vitality" "trust" "traceability"
              "sovereignty" "resonance" "rent"))
    (defn apc-count-axes (text axes)
        (if (nil? axes) 0
            (add (if (lt (str_find text (head axes) 0) 0) 0 1)
                 (apc-count-axes text (tail axes)))))
    (defn apc-member? (xs x)
        (if (nil? xs) 0 (if (str_eq (head xs) x) 1 (apc-member? (tail xs) x))))
    (defn apc-cited (text from acc)
        (do
            (let at (str_find text "receipts/2026-" from))
            (if (lt at 0) acc
                (do
                    (let end (str_find text ".md" at))
                    (if (lt end 0) acc
                        (do
                            (let path (substring text at (add end 3)))
                            ; a path broken by a space or a line wrap is not a citation
                            (let clean (if (or (ge (str_find path " " 0) 0)
                                               (ge (str_find path "\n" 0) 0)) 0 1))
                            (apc-cited text (add end 3)
                                (if (or (eq clean 0) (eq (apc-member? acc path) 1)) acc
                                    (append acc (list path))))))))))
    (defn apc-existing (paths)
        (if (nil? paths) 0
            (add (if (fs_exists (head paths)) 1 0) (apc-existing (tail paths)))))
    ; the ways an answer admits a limit; each phrase is an admission, none a claim
    (defn apc-limit-phrases ()
        (list "not establish" "pending" "not measured" "unmeasured" "cannot"
              "can't" "does not define" "nothing in these" "no exact entr"
              "no receipt" "not supported" "not defined"))
    (defn apc-any? (text phrases)
        (if (nil? phrases) 0
            (if (ge (str_find text (head phrases) 0) 0) 1
                (apc-any? text (tail phrases)))))
    (defn apc-limits (text) (apc-any? text (apc-limit-phrases)))
    (defn apc-floor (text)
        (do
            (let cited (apc-cited text 0 (list)))
            (list (apc-count-axes text (apc-axes))
                  (len cited)
                  (apc-existing cited)
                  (apc-limits text)
                  (str_len text))))
    (defn apc-text (path)
        (if (str_eq path "") ""
            (do
                (let text (read_file path))
                (if (nothing? text) "" text))))
    0)
