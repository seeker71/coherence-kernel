; form-glass-ear-live.fk — the ear as a sensor of the living glass, giving a point on many axes.
;
; The ear organ's two lanes (observe/ear-live-native.fk, the mic and the body's
; own whisper pass; observe/ear-tongue-native.fk, the dense lane's tongues)
; write frames to .hearth/ear.spool. This process drains that spool by
; watermark and gives the newest of each kind — not as a row of text, but as a
; POINT: the room's level and which way it moves, the ear's own state word, the
; line as it grows and as it closed, the tongue and the pass's doubt, every
; tongue the dense lane offered, the symbols the line resolves to with their
; node ids, the verse the state touches, each stage's own latency, the phase
; the ear's own rows sit in, and behind the point the moments themselves,
; newest first. The axes live in form/form-stdlib/ear-axes.bml; this cell is
; the file end of them: drain, fold, give, rest.
;
; What costs a file read — the meaning table and the verse table — is walked
; ONCE at birth into ea-sense (185 ms measured on this Mac) and never again;
; a give folds strings already in hand (3 ms for 34 rows).
;
; The ear sleeps until it is wanted: while .hearth/ear.wanted is absent it gives
; two rows saying so and costs a level read every half second. When the marker
; appears it stands its two lanes up (once) and gives the room; when the marker
; goes it stops them at their own door and lets them end. The tongues it offers
; are the marker's own text, whisper codes separated by spaces (blank: en pt fa id).
;
; A lane that has gone is re-stood. The live lane writes a quiet frame at least
; once a second while it lives, so a spool that has not grown in four seconds
; while the ear is wanted is a lane that ended (its own deadline, a crash, or
; the "done" that closes the tongue lane with it) — the sensor lets both go and
; stands them again rather than giving an empty room as if it were a silent one.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/ear-axes.bml form/form-stdlib/hearth.bml form/form-stdlib/spool-bell-transport.fk form/form-stdlib/line-grammar.fk

(do
    (defn fge-spool () ".hearth/ear.spool")
    (defn fge-wanted () ".hearth/ear.wanted")
    (defn fge-stop () ".hearth/ear.spool.stop")
    (defn fge-patience () 4000)
    ; the frames the two lanes wrote since the last watermark; the newest of each kind is the point
    (defn fge-drain (mark live heard said)
        (do (let sz (file_size (fge-spool)))
            (if (le sz mark) (list mark live heard said)
                (fge-drain-text mark live heard said (ea-text (read_file_slice (fge-spool) mark (sub sz mark)))))))
    (defn fge-drain-text (mark live heard said text)
        (do (let th (ea-through text 0 0))
            (if (eq th 0) (list mark live heard said)
                (fge-drain-newest mark th (ea-newest (ea-frames (substring text 0 th) 0 (list)) live heard said)))))
    (defn fge-drain-newest (mark th n) (list (add mark th) (head n) (nth n 1) (nth n 2)))
    (defn fge-wanted-text () (if (lt (file_size (fge-wanted)) 0) "" (trim (ea-text (read_file (fge-wanted))))))
    (defn fge-awake? () (ge (file_size (fge-wanted)) 0))
    ; the two lanes, stood up once while the ear is wanted and let go when it sleeps
    (defn fge-stand (pid cell) (if (gt pid 0) pid (host_spawn_quiet (list "./fkwu" cell))))
    (defn fge-lanes-up (livePid tonguePid) (list (fge-stand livePid "observe/ear-live-native.fk") (fge-stand tonguePid "observe/ear-tongue-native.fk")))
    (defn fge-stop-one (pid) (if (gt pid 0) (do (let k (host_kill pid)) (let w (host_wait pid)) 0) 0))
    (defn fge-lanes-down (livePid tonguePid) (do (let a (fge-stop-one livePid)) (let b (fge-stop-one tonguePid)) (list 0 0)))
    ; the lanes wait at these bells, and end at this marker; the door that used to stand them made
    ; both, so the sensor makes the bells on waking and clears the marker the last sleep left behind
    (defn fge-bells () (host-exec "[ -p .hearth/ear.spool.bell ] || mkfifo .hearth/ear.spool.bell; [ -p .hearth/ear.spool.seg.bell ] || mkfifo .hearth/ear.spool.seg.bell; echo ok" ""))
    (defn fge-open (livePid) (if (gt livePid 0) 0 (do (let b (fge-bells)) (let s (fs-remove-file (fge-stop))) 0)))
    (defn fge-close (livePid) (if (le livePid 0) 0 (do (let w (write_file_text (fge-stop) "sleep")) 0)))
    ; A lane that ended. The spool is the WRONG clock here: the tongue lane keeps writing said
    ; frames after the live lane is gone, so a growing spool can sit over a dead mic. The live
    ; lane's own frames carry the clock — it writes a quiet frame at least once a second while it
    ; lives — so silence past fge-patience in THAT stamp is the lane ending, and nothing else is.
    (defn fge-heard-at (live lastGrew) (if (eq (str_len live) 0) lastGrew (ea-int live "t")))
    (defn fge-gone? (awake livePid live lastGrew now) (if (or (eq awake 0) (le livePid 0)) 0 (if (gt (sub now (fge-heard-at live lastGrew)) (fge-patience)) 1 0)))
    ; a lane just stood: its clock starts now, not at whatever the last sleep left behind
    (defn fge-grew (pid live lastGrew now) (if (le pid 0) now (fge-heard-at live lastGrew)))
    (defn fge-pids (awake gone livePid tonguePid)
        (if (eq awake 0) (fge-lanes-down livePid tonguePid)
            (if (eq gone 1) (fge-lanes-up 0 0) (fge-lanes-up livePid tonguePid))))
    (defn fge-restand (gone livePid tonguePid) (if (eq gone 1) (fge-lanes-down livePid tonguePid) (list livePid tonguePid)))
    (defn fge-step (mark live heard said livePid tonguePid sense lastGrew)
        (do (let awake (fge-awake?))
            (let now (now_unix_ms))
            (let gone (fge-gone? awake livePid live lastGrew now))
            (let closed (if (eq awake 1) (if (eq gone 1) (fge-close livePid) 0) (fge-close livePid)))
            (let released (fge-restand gone livePid tonguePid))
            (let opened (if (eq awake 1) (fge-open (head released)) 0))
            (let pids (fge-pids awake gone (head released) (nth released 1)))
            (let d (if (eq awake 1) (fge-drain mark live heard said) (list mark live heard said)))
            (let next (if (eq awake 1) (ea-sense-step sense (nth d 1) (nth d 2) (nth d 3) awake) sense))
            (let rows (if (eq awake 1) (ea-rows next (nth d 1) (nth d 2) (nth d 3) (fge-wanted-text) 1 now) (ea-asleep-rows)))
            (let given (fgsr-give "ear" now (fgo-observe-rows rows now 0)))
            (let rested (host_sleep_ms (if (eq awake 1) 100 500)))
            (fge-step (head d) (nth d 1) (nth d 2) (nth d 3) (head pids) (nth pids 1) next (fge-grew (head released) (nth d 1) lastGrew now))))
    ; the tables are walked once, here, before the first give
    (fge-step 0 "" "" "" 0 0 (ea-sense-born) (now_unix_ms)))
