; form-glass-ear-live.fk — the ear as a sensor of the living glass.
;
; The ear organ's two lanes (observe/ear-live-native.fk, the mic and the body's
; own whisper pass; observe/ear-tongue-native.fk, the dense lane's tongues)
; write frames to .hearth/ear.spool. This process drains that spool by
; watermark and gives the newest of each kind as rows into the shared sensor
; frame the glass takes every tick, so a live transcript stands in the glass's
; own frame beside the machine and the organs rather than in a window of its own.
;
; The ear sleeps until it is wanted: while .hearth/ear.wanted is absent it gives
; one row saying so and costs a level read every half second. When the marker
; appears it stands its two lanes up (once) and gives the room; when the marker
; goes it lets them end. The tongues it offers are the marker's own text, whisper
; codes separated by spaces (blank: en pt fa id).
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/form-glass-observer.bml form/form-stdlib/hearth.bml form/form-stdlib/spool-bell-transport.fk form/form-stdlib/line-grammar.fk

(do
    (defn fge-spool () ".hearth/ear.spool")
    (defn fge-wanted () ".hearth/ear.wanted")
    (defn fge-text (t) (if (nothing? t) "" t))
    (defn fge-cat (parts) (if (eq (len parts) 0) "" (str_concat (head parts) (fge-cat (tail parts)))))
    (defn fge-line-end (s i) (if (ge i (str_len s)) i (if (eq (str_byte_at s i) 10) i (fge-line-end s (add i 1)))))
    (defn fge-field (s key) (do (let at (str_find s (str_concat (byte_to_str 10) (str_concat key "=")) 0)) (if (lt at 0) "" (substring s (add at (add (str_len key) 2)) (fge-line-end s (add at (add (str_len key) 2)))))))
    (defn fge-int (s key) (do (let v (fge-field s key)) (if (eq (str_len v) 0) 0 (str_to_int v))))
    ; the frames the two lanes wrote since the last watermark; the newest of each kind is what the glass wants
    (defn fge-frames (text from acc) (do (let o (str_find text "<|ear:frame|>" from)) (if (lt o 0) (reverse acc) (do (let c (str_find text "<|/ear:frame|>" o)) (if (lt c 0) (reverse acc) (fge-frames text (add c 14) (cons (substring text o (add c 14)) acc)))))))
    (defn fge-through (text from last) (do (let c (str_find text "<|/ear:frame|>" from)) (if (lt c 0) last (fge-through text (add c 14) (add c 14)))))
    (defn fge-said? (f) (or (str_eq (fge-field f "kind") "said") (str_eq (fge-field f "kind") "saying")))
    (defn fge-heard? (f) (or (str_eq (fge-field f "kind") "heard") (fge-said? f)))
    (defn fge-newest (frames live heard said) (if (eq (len frames) 0) (list live heard said) (do (let f (head frames)) (fge-newest (tail frames) (if (fge-heard? f) live f) (if (str_eq (fge-field f "kind") "heard") f heard) (if (fge-said? f) f said)))))
    (defn fge-drain (mark live heard said)
        (do (let sz (file_size (fge-spool)))
            (if (le sz mark) (list mark live heard said)
                (do (let text (fge-text (read_file_slice (fge-spool) mark (sub sz mark))))
                    (let th (fge-through text 0 0))
                    (if (eq th 0) (list mark live heard said)
                        (do (let n (fge-newest (fge-frames (substring text 0 th) 0 (list)) live heard said))
                            (list (add mark th) (head n) (nth n 1) (nth n 2))))))))
    ; a row the glass paints: text under the ear domain, physical-live, the ear's own channel
    (defn fge-row (id label value note) (fgo-text "ear" id label value "organ" "physical-live" "ear-organ" "live" "voice" note))
    (defn fge-int-row (id label value unit note) (fgo-int "ear" id label value unit 0 "organ" "physical-live" "ear-organ" "live" "voice" note))
    (defn fge-tongue-rows (said codes) (if (eq (len codes) 0) (list) (cons (fge-row (str_concat "ear.tongue." (head codes)) (fge-cat (list "said in " (head codes))) (fge-field said (str_concat "t_" (head codes))) "the dense lane's own words") (fge-tongue-rows said (tail codes)))))
    (defn fge-codes (said wanted) (do (let t (fge-field said "tongues")) (if (gt (str_len t) 0) (split-on t " ") (if (gt (str_len wanted) 0) (split-on wanted " ") (list "en" "pt" "fa" "id")))))
    (defn fge-heard-text (heard) (do (let l (fge-field heard "lang")) (if (eq (str_len l) 0) (fge-field heard "heard") (fge-cat (list l "  " (fge-field heard "heard"))))))
    (defn fge-live-text (live) (do (let l (fge-field live "livelang")) (if (eq (str_len l) 0) (fge-field live "live") (fge-cat (list l "  " (fge-field live "live"))))))
    (defn fge-rows (live heard said wanted)
        (append (list (fge-int-row "ear.level" "the room's level" (fge-int live "db") "dbfs" "the mic organ's own measure")
                      (fge-row "ear.live" "the line as it grows" (fge-live-text live) "the body's whisper pass, every hop")
                      (fge-row "ear.heard" "the line when it closed" (fge-heard-text heard) "committed at a pause or a full window")
                      (fge-int-row "ear.latency" "last sample to this row" (fge-int live "livems") "ms" "the ear's own hop"))
                (fge-tongue-rows said (fge-codes said wanted))))
    (defn fge-asleep-rows () (list (fge-row "ear.state" "the ear" "asleep — write .hearth/ear.wanted to wake it" "the mic opens only when it is wanted")))
    (defn fge-wanted-text () (if (lt (file_size (fge-wanted)) 0) "" (trim (fge-text (read_file (fge-wanted))))))
    (defn fge-awake? () (ge (file_size (fge-wanted)) 0))
    ; the two lanes, stood up once while the ear is wanted and let go when it sleeps
    (defn fge-stand (pid cell) (if (gt pid 0) pid (host_spawn_quiet (list "./fkwu" cell))))
    (defn fge-lanes-up (livePid tonguePid) (list (fge-stand livePid "observe/ear-live-native.fk") (fge-stand tonguePid "observe/ear-tongue-native.fk")))
    (defn fge-stop (pid) (if (gt pid 0) (do (host_kill pid) (host_wait pid) 0) 0))
    (defn fge-lanes-down (livePid tonguePid) (do (let a (fge-stop livePid)) (let b (fge-stop tonguePid)) (list 0 0)))
    ; the lanes wait at these bells; the door that used to stand them made them, so the sensor makes them now
    (defn fge-bells () (host-exec "[ -p .hearth/ear.spool.bell ] || mkfifo .hearth/ear.spool.bell; [ -p .hearth/ear.spool.seg.bell ] || mkfifo .hearth/ear.spool.seg.bell; echo ok" ""))
    (defn fge-step (mark live heard said livePid tonguePid)
        (do (let awake (fge-awake?))
            (let rung (if (and (eq awake 1) (le livePid 0)) (fge-bells) ""))
            (let pids (if (eq awake 1) (fge-lanes-up livePid tonguePid) (fge-lanes-down livePid tonguePid)))
            (let d (if (eq awake 1) (fge-drain mark live heard said) (list mark live heard said)))
            (let now (now_unix_ms))
            (let rows (if (eq awake 1) (fge-rows (nth d 1) (nth d 2) (nth d 3) (fge-wanted-text)) (fge-asleep-rows)))
            (let given (fgsr-give "ear" now (fgo-observe-rows rows now 0)))
            (let rested (host_sleep_ms (if (eq awake 1) 100 500)))
            (fge-step (head d) (nth d 1) (nth d 2) (nth d 3) (head pids) (nth pids 1))))
    (fge-step 0 "" "" "" 0 0))
