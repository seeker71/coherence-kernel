// form-glass-ear-live.fk — the ear as a sensor of the living glass, giving a point on many axes.
//
// The ear organ's two lanes (observe/ear-live-native.fk, the mic and the body's
// own whisper pass; observe/ear-tongue-native.fk, the dense lane's tongues)
// write frames to .hearth/ear.spool. This process drains that spool by
// watermark and gives the newest of each kind — not as a row of text, but as a
// POINT: the room's level and which way it moves, the ear's own state word, the
// line as it grows and as it closed, the tongue and the pass's doubt, every
// tongue the dense lane offered, the symbols the line resolves to with their
// node ids, the verse the state touches, each stage's own latency, the phase
// the ear's own rows sit in, and behind the point the moments themselves,
// newest first. The axes live in form/form-stdlib/ear-axes.bml; this cell is
// the file end of them: drain, fold, give, rest.
//
// What costs a file read — the meaning table and the verse table — is walked
// ONCE at birth into ea-sense (185 ms measured on this Mac) and never again;
// a give folds strings already in hand (3 ms for 34 rows).
//
// The ear sleeps until it is wanted: while .hearth/ear.wanted is absent it gives
// two rows saying so and costs a level read every half second. When the marker
// appears it stands its two lanes up (once) and gives the room; when the marker
// goes it stops them at their own door and lets them end. The tongues it offers
// are the marker's own text, whisper codes separated by spaces (blank: en pt fa id).
//
// ── HOW A LANE IS BORN, AND WHY IT IS BORN THIS WAY ────────────────────────
//
// host_spawn_quiet sends the child's stdout and stderr to /dev/null and hands
// it the PARENT'S OWN STDIN. Both lanes read their first line from stdin, so a
// lane born from a sensor whose stdin is a terminal sits at that read forever:
// 0.0% cpu, no model opened, no mic, not one byte of spool — and every axis
// above then reads awake, level 0, silent, which is a true measurement of a lane
// that never started and a lie about the room. Witnessed on this Mac: a lane
// given a stdin that neither delivers nor closes wrote nothing in thirty
// seconds; the same lane given /dev/null was born in two.
//
// So a lane is stood through host_spawn_at, the door that places a child's three
// standard streams where the caller says:
//
//     (host_spawn_at (list "./fkwu" <cell>) (list (ewl-input-path) <log> <log>))
//
// The seed forks and execs the argument list itself, so the pid the sensor holds
// IS the lane and a kill reaches it; the placed input supplies the owner lease
// and ends the birth wait at once; the log is the lane's own voice — its warnings, its open line, its
// last error, the line it prints as it ends. Output and error land in the one
// log and the door opens it APPEND, so the sensor's birth mark and every life
// the lane has had stay under the newest one. A lane that cannot be born at all
// says so at birth: the door answers a negative refusal instead of a pid, the
// sensor writes that number into the log, and ear.voice carries it to the glass.
//
// ── WHEN A LANE COUNTS AS GONE ─────────────────────────────────────────────
//
// Two clocks and one probe, because one of them alone was wrong three ways.
// The live lane writes a quiet frame at least once a second while it lives, so
// silence in that stamp past fge-patience is a lane that ended. But that stamp
// belongs to whichever lane wrote it, and it does NOT reset when a lane is
// stood: a sensor reading the dead lane's last stamp declares the newborn gone
// on the next tick and kills it before it can compile — a re-stand spin at the
// tick rate that no lane can ever escape. So the clock is the LATER of that
// stamp and the lane's own birth, and a lane that has not yet spoken since its
// birth is measured against fge-birth-patience instead: a whisper pass opens a
// model, and a model whose weights are not in the page cache takes far longer
// than a living lane's silence is allowed to.
//
// The probe closes what neither clock can see. The tongue lane is legitimately
// silent for minutes at a time — it speaks only when a line closes — so it has
// no clock at all, and a live lane that exits in its first half second would
// otherwise wait out the whole birth patience. Once every fge-probe-ms the
// sensor asks host_alive whether each pid still answers — a signal of zero,
// delivered to nobody, and no process born to ask it — and reads each log's
// tail. Nothing in this loop forks now, on the give path or off it.
//
// preflight-exec: forbidden
import form/form-stdlib/form-glass-sensor-rows.bml;
import form/form-stdlib/ear-axes.bml;
import form/form-stdlib/hearth.bml;
import form/form-stdlib/spool-bell-transport.fk;
import form/form-stdlib/line-grammar.fk;
import form/form-stdlib/bml/ear-worker-life.bml;
import form/form-stdlib/born-under.bml;
section [form.bml] {
    def fge-spool() = ".hearth/ear.spool";
    def fge-wanted() = ".hearth/ear.wanted";
    def fge-stop() = ".hearth/ear.spool.stop";
    def fge-log-live() = ".hearth/ear.lane.live.log";
    def fge-log-tongue() = ".hearth/ear.lane.tongue.log";
    // A living lane's silence is five of the live lane's own beats. A newborn's is far
    // wider because birth is not silence: measured on this Mac, the live lane reaches its
    // first frame in about two seconds with the whisper weights in the page cache and had
    // written nothing at fourteen without them, and the tongue lane's own log reports
    // "open ... after 20449 ms" on a cold dense model against 2032 ms on a warm one. A
    // patience under that kills a lane in the middle of opening, forever.
    // And silence from a lane the host says is STILL ANSWERING is not death, it is a
    // stall. Witnessed: with the corpus band and the eleven drift gates running beside
    // them — kernel builds, whole-tree compiles — the lanes were
    // starved past four seconds and re-stood every hundred, each time paying the dense
    // model's reopen and losing the tongue lane's mark. A busy machine is not a dead
    // lane. So the probe's answer chooses the patience: gone by silence at fge-patience
    // only while the host has not vouched for the pid, and at fge-stall-patience when it
    // has — long enough that a lane wedged forever is still eventually re-stood, and far
    // past anything a loaded machine does to a living one.
    def fge-patience() = 4000;
    def fge-stall-patience() = 60000;
    def fge-birth-patience() = 120000;
    def fge-probe-ms() = 2000;
    def fge-tail-bytes() = 512;
    // the frames the two lanes wrote since the last watermark; the newest of each kind is the point
    def fge-drain(mark, live, heard, said, ghost) = {
        let sz = file_size(fge-spool());
        sz <= mark ? [mark, live, heard, said, ghost] : fge-drain-text(mark, live, heard, said, ghost, ea-text(read_file_slice(fge-spool(), mark, sz - mark)));
    };
    def fge-drain-text(mark, live, heard, said, ghost, text) = {
        let th = ea-through(text, 0, 0);
        (Comparable) th == 0 ? [mark, live, heard, said, ghost] : fge-drain-newest(mark, th, ea-newest(ea-frames(substring(text, 0, th), 0, []), live, heard, said, ghost));
    };
    def fge-drain-newest(mark, th, n) = [(Number) mark + (Number) th, n[0], n[1], n[2], n[3]];
    def fge-wanted-text() = file_size(fge-wanted()) < 0 ? "" : trim(ea-text(read_file(fge-wanted())));
    def fge-awake?() = file_size(fge-wanted()) >= 0;
    // ── the lanes: stood with a stdin the sensor owns and a log that is their voice ──
    def fge-mark-birth(log) = sbt-append(log, ea-cat(["--- stood at ", now_unix_ms().str(), " ---", byte_to_str(10)]));
    // A refusal is not a pid. The door judges the argv and the three redirects before
    // it forks, so a lane that cannot be born answers -1, -2, -3 or -4 and never looks
    // alive for a patience. The number goes into the lane's own log, where ear.voice
    // reads it, and the sensor answers 0; the lanes stand again once fge-resting? lets them.
    def fge-say-refusal(pid, log) = sbt-append(log, ea-cat(["refused at birth: ", pid.str(), byte_to_str(10)]));
    def fge-born(pid, log) = pid > 0 ? pid : {
        let s = fge-say-refusal(pid, log);
        0;
    };
    def fge-stand(pid, cell, log) = pid > 0 ? pid : {
        let b = fge-mark-birth(log);
        fge-born(host_spawn_at(["./fkwu", cell], [ewl-input-path(), log, log]), log);
    };
    def fge-lanes-up(livePid, tonguePid) = [fge-stand(livePid, "observe/ear-live-native.fk", fge-log-live()), fge-stand(tonguePid, "observe/ear-tongue-native.fk", fge-log-tongue())];
    def fge-stop-one(pid) = pid > 0 ? {
        let k = host_kill(pid);
        let w = host_wait(pid);
        0;
    } : 0;
    def fge-lanes-down(livePid, tonguePid) = {
        let a = fge-stop-one(livePid);
        let b = fge-stop-one(tonguePid);
        [0, 0];
    };
    // The lanes wait at these bells, and end at this marker. A bell is a fifo, and
    // `mkfifo` on a path that already holds a REGULAR file fails without changing
    // anything — which is exactly what a ring into an absent bell leaves behind
    // (`printf x > bell` creates a one-byte file). Both bells were found in that
    // state. So a path that is not a fifo is removed before the fifo is made.
    // fs_mkfifo reports what IS there — 1 it made one, 0 a fifo already stands, -1 the
    // path holds something else — and it never removes a path on its own, so the
    // removal is this cell's decision and lives here where it can be read.
    def fge-bell-again(p, made) = made >= 0 ? made : {
        let r = fs-remove-file(p);
        fs_mkfifo(p);
    };
    def fge-bell(p) = fge-bell-again(p, fs_mkfifo(p));
    def fge-bells() = [fge-bell(".hearth/ear.spool.bell"), fge-bell(".hearth/ear.spool.seg.bell")];
    def fge-open(livePid) = livePid > 0 ? 0 : {
        let b = fge-bells();
        let s = fs-remove-file(fge-stop());
        0;
    };
    def fge-close(livePid) = livePid <= 0 ? 0 : {
        let w = write_file_text(fge-stop(), "sleep");
        0;
    };
    // ── the watch: does each pid still answer, and what did each lane last say ──
    // host_alive answers one pid — 1 it answers, 0 it is gone, -1 none was given — with
    // no process born to ask. The marks are the ones fge-alive? already reads, and the
    // leading mark is the ASKED mark: an answer carrying no lane mark says both lanes
    // are gone, an EMPTY answer says nothing was asked. Those are different readings and
    // taking one for the other kills a newborn on its first tick.
    def fge-probe-part(pid, mark) = pid <= 0 ? "" : (Comparable) host_alive(pid) == 1 ? mark : "";
    def fge-alive(a, b) = a <= 0 && b <= 0 ? "" : ("?" + ((String) fge-probe-part(a, "L") + fge-probe-part(b, "T")));
    def fge-tail-of(path, sz) = {
        let from = sz > fge-tail-bytes() ? sz - fge-tail-bytes() : 0;
        ea-text(read_file_slice(path, from, sz - from));
    };
    def fge-tail(path) = {
        let sz = file_size(path);
        sz <= 0 ? "" : fge-tail-of(path, sz);
    };
    def fge-last-go(xs, acc) = (Comparable) len(xs) == 0 ? acc : fge-last-go(xs[1:], fge-last-keep(trim(xs[0]), acc));
    def fge-last-keep(l, acc) = (Comparable) len(l) == 0 ? acc : (Comparable) str_byte_at(l, 0) == 45 ? acc : l;
    def fge-last-line(s) = fge-last-go(split-on(s, byte_to_str(10)), "");
    def fge-voice-of(a, b) = (Comparable) len(a) == 0 ? (Comparable) len(b) == 0 ? "" : ("tongue: " + b) : (Comparable) len(b) == 0 ? ("live: " + a) : ea-cat(["live: ", a, "   ·   tongue: ", b]);
    def fge-voice() = fge-voice-of(fge-last-line(fge-tail(fge-log-live())), fge-last-line(fge-tail(fge-log-tongue())));
    def fge-watch(at, alive, voice) = [at, alive, voice];
    def fge-watch-at(w) = w[0];
    def fge-watch-alive(w) = w[1];
    def fge-watch-voice(w) = w[2];
    def fge-watch-next(w, livePid, tonguePid, now) = now - fge-watch-at(w) < fge-probe-ms() ? w : fge-watch(now, fge-alive(livePid, tonguePid), fge-voice());
    // ── gone: the probe first, then the later of the frame stamp and the birth ──
    // 1 the host says this pid answers, 0 the host says it is gone, -1 no answer to go on.
    // A pid of 0 is -1 and not 0 on purpose: fge-stand already stands a zero pid on its own
    // next tick, so calling it dead would take the OTHER lane down with it for nothing.
    def fge-alive?(watch, pid, mark) = pid <= 0 ? 0 - 1 : (Comparable) len(fge-watch-alive(watch)) == 0 ? 0 - 1 : str_find(fge-watch-alive(watch), mark, 0) >= 0 ? 1 : 0;
    // The live lane's pulse is the newest frame IT wrote, and it writes two kinds: the
    // growing line (live, quiet, born, done) and the line when it closed (heard). Only the
    // first lands in the live slot — a commit is a commit — so a lane busy closing line after
    // line advanced the heard stamp alone and read as silent on the live one. The pulse is the
    // later of the two. The said stamp is NOT in it: that frame belongs to the tongue lane,
    // which the probe watches instead, and taking it here would let one lane vouch for another.
    def fge-stamp(f) = (Comparable) len(f) == 0 ? 0 : ea-int(f, "t");
    def fge-frame-t(live, heard) = {
        let a = fge-stamp(live);
        let b = fge-stamp(heard);
        a > b ? a : b;
    };
    def fge-mute?(patience, ft, born, now) = ft > born ? now - ft > patience ? 1 : 0 : now - born > fge-birth-patience() ? 1 : 0;
    def fge-gone-of(alive, tongueAlive, ft, born, now) = (Comparable) alive == 0 ? 1 : (Comparable) tongueAlive == 0 ? 1 : fge-mute?((Comparable) alive == 1 ? fge-stall-patience() : fge-patience(), ft, born, now);
    def fge-gone?(awake, livePid, tonguePid, live, heard, born, now, watch) = (Comparable) awake == 0 || livePid <= 0 ? 0 : fge-gone-of(fge-alive?(watch, livePid, "L"), fge-alive?(watch, tonguePid, "T"), fge-frame-t(live, heard), born, now);
    def fge-pids(awake, gone, livePid, tonguePid) = (Comparable) awake == 0 ? fge-lanes-down(livePid, tonguePid) : (Comparable) gone == 1 ? fge-lanes-up(0, 0) : fge-lanes-up(livePid, tonguePid);
    def fge-restand(gone, livePid, tonguePid) = (Comparable) gone == 1 ? fge-lanes-down(livePid, tonguePid) : [livePid, tonguePid];
    // a lane just stood: its clock starts now, and the standing is counted
    def fge-born-next(releasedLive, born, now) = releasedLive <= 0 ? now : born;
    def fge-stands-next(awake, releasedLive, stands) = (Comparable) awake == 1 && releasedLive <= 0 ? (Number) stands + (Number) 1 : stands;
    // Lanes that ended without writing a frame are stood again once the birth patience has passed since
    // their standing, not at the next tick. A live lane whose Metal carrier cannot load ends at birth; while
    // host_alive took the unreaped pid for a living one, that death went unseen until the birth patience
    // ran out. Now that it is seen within a probe, standing at once would start a kernel every two seconds
    // to hear nothing. Lanes that spoke before they ended are stood again at once.
    def fge-resting?(awake, releasedLive, stands, born, ft, now) = (Comparable) awake == 0 || releasedLive > 0 ? 0 : (Comparable) stands == 0 || ft > born ? 0 : now - born < fge-birth-patience() ? 1 : 0;
    // The carrier that started the ear is asked after at the watch's own cadence; once it is no longer the
    // ear's parent, the lanes go down and the ear ends (born-under.bml).
    def fge-orphaned?(watch, carrier) = now_unix_ms() - fge-watch-at(watch) < fge-probe-ms() ? 0 : (Comparable) bun-held?(carrier) == 1 ? 0 : 1;
    def fge-step(mark, live, heard, said, ghost, livePid, tonguePid, sense, born, stands, watch, owner, transcripts, carrier) = !ewl-owned?(owner) || (Comparable) fge-orphaned?(watch, carrier) == 1 ? fge-lanes-down(livePid, tonguePid) : {
        let awake = fge-awake?();
        let now = now_unix_ms();
        let w1 = fge-watch-next(watch, livePid, tonguePid, now);
        let gone = fge-gone?(awake, livePid, tonguePid, live, heard, born, now, w1);
        let closed = (Comparable) awake == 1 ? (Comparable) gone == 1 ? fge-close(livePid) : 0 : fge-close(livePid);
        let released = fge-restand(gone, livePid, tonguePid);
        let resting = fge-resting?(awake, released[0], stands, born, fge-frame-t(live, heard), now);
        let opened = (Comparable) awake == 1 && (Comparable) resting == 0 ? fge-open(released[0]) : 0;
        let pids = (Comparable) resting == 1 ? released : fge-pids(awake, gone, released[0], released[1]);
        let born1 = (Comparable) resting == 1 ? born : fge-born-next(released[0], born, now);
        let stands1 = (Comparable) resting == 1 ? stands : fge-stands-next(awake, released[0], stands);
        let lanes = ea-lanes(pids[0], pids[1], now - born1, stands1, fge-watch-voice(w1));
        let d = (Comparable) awake == 1 ? fge-drain(mark, live, heard, said, ghost) : [mark, live, heard, said, ghost];
        let next = (Comparable) awake == 1 ? ea-sense-step(sense, d[1], d[2], d[3], awake) : sense;
        let freshText = (Comparable) awake == 1 ? etr-flow(transcripts, ea-transcript-rows(d[1], d[2], d[3], fge-wanted-text())) : [];
        let rows = (Comparable) awake == 1 ? append(fgo-observe-rows(ea-rows(next, d[1], d[2], d[3], fge-wanted-text(), 1, now, lanes, d[4]), now, 0), fgo-age-rows-at(freshText, now)) : fgo-observe-rows(ea-asleep-rows(lanes), now, 0);
        let given = fgsr-give("ear", now, rows);
        let rested = host_sleep_ms((Comparable) awake == 1 ? 100 : 500);
        fge-step(d[0], d[1], d[2], d[3], d[4], pids[0], pids[1], next, born1, stands1, w1, owner, freshText, carrier);
    };
    // the tables are walked once, here, before the first give
    let owner = ewl-token(host_pid(), now_unix_ms());
    ewl-claim(owner) ? fge-step(0, "", "", "", "", 0, 0, ea-sense-born(), now_unix_ms(), 0, fge-watch(0, "", ""), owner, [], bun-parent()) : print("ear owner lease could not be written");
}
