; mirror-name-read.fk — ask the mirror lens about names you can name.
;
; observe/mirror-census-run.fk reads the whole tree and gives the panel worst-first,
; which is the reading you want when you do not yet know where the wound is. This
; door answers the other question: a hand that has just added a name, and wants to
; know which of that name's nine mirrors stand before it lands. The panel cannot
; answer it — a name with no wounds never reaches the top of a worst-first list, so
; a well name and an unread one look identical from there.
;
; Names arrive on this process's own stdin, one per line, so siblings sharing a
; machine cannot replace the question between the write and the read.
;
;     printf 'host_spawn_at\nhost_alive\nfs_mkfifo\n' | ./fkwu observe/mirror-name-read.fk
;
; The three ways to be well are `whole`, `rewrite` (reached through fk_rwtab, so no
; arm and no manifest row are owed — the shape every leaf-door mode has) and
; `no-native-here` (no mirror carries this name at all, which is a fact about the
; name, not a wound in the body). A `?` mirror is MCSUnread: a tag-keyed mirror
; asked about a name that has no tag anywhere answers "I have not looked", never a
; confident absence.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/mirror-census.bml form/form-stdlib/line-grammar.fk
(do
    (defn mnr-mirror-names () (list "manifest" "flt-ops" "row" "arm" "fkc" "rw" "go" "rust" "ts" "jit" "abi"))
    (defn mnr-mark (v) (if (eq v 1) "+" (if (eq v 0) "-" "?")))
    (defn mnr-show (labels vals acc)
        (if (eq (len labels) 0) acc
            (mnr-show (tail labels) (tail vals)
                (str_concat acc (str_concat " " (str_concat (mnr-mark (head vals)) (head labels)))))))
    (defn mnr-join (xs acc) (if (eq (len xs) 0) acc (mnr-join (tail xs) (str_concat acc (str_concat " " (head xs))))))
    (defn mnr-one (b n)
        (do (let r (mcs-reading b n))
            (print_str (str_concat n (str_concat "  verdict=" (nth r 7))))
            (print_str (str_concat "   mirrors:" (mnr-show (mnr-mirror-names) (nth r 4) "")))
            (print_str (str_concat "   wounds: " (if (eq (len (nth r 5)) 0) "none" (trim (mnr-join (nth r 5) "")))))
            0))
    ; the end of stdin is `nothing`, and nothing has no length — asked before measured
    (defn mnr-loop (b n) (mnr-next b n (read_line)))
    (defn mnr-next (b n raw)
        (if (nothing? raw) n
            (mnr-line b n (trim raw))))
    (defn mnr-line (b n line)
        (if (eq (str_len line) 0) n
            (do (let s (mnr-one b line)) (mnr-loop b (add n 1)))))
    (let b (mcs-live))
    (mnr-loop b 0))
