; Live-readable pure observation for the error-derived rank-1 update.
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/lora-modality.fk cognition/error-loving-attention.fk
; preludes: cognition/error-absorption-kernel.fk

(do
    (let o (eak-observe))
    (print_str (str_concat "train=" (str_concat (int_to_str (nth o 0)) "\n")))
    (print_str (str_concat "error=" (str_concat (int_to_str (nth o 1)) "\n")))
    (print_str (str_concat "sealed=" (str_concat (int_to_str (nth o 2)) "\n")))
    (print_str (str_concat "base-error=" (str_concat (int_to_str (nth o 4)) "\n")))
    (print_str (str_concat "base-sealed=" (str_concat (int_to_str (nth o 5)) "\n")))
    (print_str (str_concat "adapted-error=" (str_concat (int_to_str (nth o 6)) "\n")))
    (print_str (str_concat "adapted-sealed=" (str_concat (int_to_str (nth o 7)) "\n")))
    (print_str (str_concat "error-corrected=" (str_concat (int_to_str (nth o 8)) "\n")))
    (print_str (str_concat "sealed-transfer=" (str_concat (int_to_str (nth o 9)) "\n")))
    (print_str (str_concat "behavior-distinction=" (str_concat (int_to_str (nth o 10)) "\n")))
    (print_str (str_concat "attention=" (str_concat (int_to_str (nth o 11)) "\n")))
    0)
