; form-glass-flow-current-run.fk — one bounded physical Flow frame.
;
; It shares collectors, typed inventory, and rendering with the resident Glass
; but never starts another dashboard process.
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let frame (fgl-bounded-current-frame "flow" 120 32))
    (print_str (fgd-segment-project frame))
    0)
