// bml-surface-lift-run.bml — the surface the cursor already reads becomes the surface the source is written in.
//
//   list(a, b) -> [a, b]      nth(xs, i) -> xs[i]      range(a, b) -> (a .. b)
//
// The walk is form-source-lift's own (fsl-surface-walk, one cursor over each contract section); a section is
// rewritten only while its recipes come out identical, so a rewrite that would move meaning stays as written.
// stdin, one line: `check` or `apply`, then paths.
// preludes: form-stdlib/bml/bml-compact-rewrite.bml form-stdlib/bml/form-source-lift.bml
section [form.bml] {
 class BmlSurfaceLift {
  def bsl-reading(body) = try fsc-rec-do(fbl-section-recipes(body, 1)) else nothing();
  def bsl-same?(body, out) {
   let base = bsl-reading(body);
   !nothing?(base) && base == bsl-reading(out);
  }
  def bsl-body(body) {
   let out = fsl-surface-walk(form-bml-grammar(), cursor-str(body), "", []);
   str_eq(out, body) ? [body, "same"] : bsl-same?(body, out) ? [out, "whole"] : [body, "stop"];
  }
  def bsl-run() {
   let words = bcr-words(trim(stdin-text()));
   bcr-files(tail(words), str_eq(words[0], "apply"), bsl-body);
  }
 }
 bsl-run();
}
