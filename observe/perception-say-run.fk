; perception-say-run.fk — say what this body perceives right now, in symbols, and
; in any tongue the locale rows carry.
;
; The words the ear closes on already become symbols and node ids (ear.symbols,
; ear.nodes). Everything ELSE the room gives — what kind of sound it is, the colour
; of its own quiet, the ear's own condition, and each voice-manner axis that carries
; a reading — becomes symbols here, so the whole perception is one line the body can
; address, compare and speak.
;
; stdin line 1: the code kinds to say it in, separated by spaces — persian german
;   french portuguese romanian, or `nl` for the body's own English. Blank means nl.
;   A kind the rows do not carry for a symbol says [symbol?] rather than inventing a
;   word for it.
; stdin line 2 (optional): a whisper code (de, fa, pt, ...) to speak the line ALOUD in
;   this Mac's own mouth. Blank speaks nothing.
;
; It stands nothing and writes nothing: the ear, room and prosody frames are read
; where their sensors already give them, so running this door beside a live glass
; costs the glass one shared-memory read and disturbs no measurement.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/perception-symbols.bml form/form-stdlib/meaning-codes.bml form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/voice-say.bml

(do
    (defn psr-trim (s) (if (nothing? s) "" (trim s)))
    (defn psr-line (s) (print_str (str_concat s "\n")))
    ; through fgsr-rows-or-absent, never fgsr-held-rows: that is the door that marks a frame
    ; whose publisher stopped giving as silent, and a silent frame's confident numbers never
    ; become this body's perception of the room it is in
    (defn psr-rows (sensor) (fgsr-rows-or-absent sensor (fgsr-take sensor (list))))
    ; the ear's own state row is the honest mark: a marker over a lane writing nothing is deaf
    (defn psr-mark (rows)
        (do (let state (ps-state-of (ps-text rows "ear.state")))
            (if (eq (str_len state) 0) "the ear gives no row: no sensor is standing"
                (str_concat "the ear: " (str_concat state (str_concat " — " (ps-nl state)))))))
    (defn psr-seen-line (s)
        (str_concat "  " (str_concat (ps-seen-sym s)
            (str_concat "  " (str_concat (mc-anchor (ps-seen-sym s))
                (str_concat "  " (str_concat (ps-seen-family s)
                    (str_concat "  ← " (str_concat (ps-seen-door s)
                        (str_concat "  = " (ps-seen-reading s)))))))))))
    (defn psr-each (seen) (if (eq (len seen) 0) 0 (do (psr-line (psr-seen-line (head seen))) (psr-each (tail seen)))))
    (defn psr-nodes (syms) (if (eq (len syms) 0) (list) (cons (mc-anchor (head syms)) (psr-nodes (tail syms)))))
    (defn psr-in-each (syms kinds)
        (if (eq (len kinds) 0) 0
            (do (psr-line (str_concat "  " (str_concat (head kinds) (str_concat ":  " (mc-line-in syms (head kinds))))))
                (psr-in-each syms (tail kinds)))))
    (defn psr-words (rows)
        (do (let heard (ps-text rows "ear.heard"))
            (if (eq (str_len heard) 0) "no line has closed in this ear's lifetime" heard)))

    (let want (psr-trim (read_line)))
    (let aloud (psr-trim (read_line)))
    (let kinds (if (eq (str_len want) 0) (list "nl") (split-on want " ")))
    (let rows (append (psr-rows "ear") (append (psr-rows "room") (psr-rows "prosody"))))
    (let seen (ps-perceive rows))
    (let syms (ps-syms seen))
    (let unsensed (ps-unsensed rows))

    (psr-line (psr-mark rows))
    (psr-line "")
    (psr-line (str_concat "the words:      " (psr-words rows)))
    (psr-line (str_concat "their symbols:  " (ps-text rows "ear.symbols")))
    (psr-line (str_concat "their nodes:    " (ps-text rows "ear.nodes")))
    (psr-line "")
    (psr-line (str_concat "the perception: " (ps-line seen)))
    (psr-line (str_concat "its nodes:      " (ps-join (psr-nodes syms) " ")))
    (psr-line "")
    (psr-line "each perceived thing — symbol, node, family, the door it was read at, what it read:")
    (psr-each seen)
    (psr-line "")
    (psr-line "said in:")
    (psr-in-each syms kinds)
    (psr-line "")
    (psr-line (if (eq (len unsensed) 0) "every voice-manner axis carries a reading"
        (str_concat "not sensed now (no reading at their own rows): " (ps-join unsensed " "))))
    (if (eq (str_len aloud) 0) 0
        (do (psr-line "")
            (psr-line (str_concat "aloud in " (str_concat aloud ":")))
            (psr-line (vs-say-tongues aloud (mc-line-in syms (if (eq (len kinds) 0) "nl" (head kinds)))))))
    0)
