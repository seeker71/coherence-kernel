; form-glass-raster-focus-run.fk — one bounded Form offer selects the
; resource x observed-frame raster only when the standing Glass returns the
; correlated physical acknowledgement.
; preflight-exec: forbidden
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (defn fgrfr-matching-ack (read offer)
        (if (or (lt (len read) 4) (not (str_eq (nth read 2) "ack"))) (list)
            (if (not (eq (fgtm-field-present? (nth read 3)) 1)) (list)
                (do (let ack (fgtm-field-value (nth read 3)))
                    (if (and (eq (fgtm-ack-valid? ack) 1)
                             (and (str_eq (fgtm-ack-offer-id ack) (fgtm-offer-id offer))
                                  (and (str_eq (fgtm-ack-disposition ack) "applied")
                                       (and (str_eq (fgtm-ack-evidence ack) "physical-live")
                                            (and (str_eq (fgtm-ack-source ack) "glass.monitor")
                                                 (ge (fgtm-ack-epoch ack) (fgtm-offer-epoch offer)))))))
                        ack (list))))))
    (defn fgrfr-await (offer attempts)
        (do (let read (fgtm-read-control-ack (FGLRoot) (FGLControlChannel)))
            (let ack (fgrfr-matching-ack read offer))
            (if (gt (len ack) 0)
                (list "glass-raster-focus-v1" "applied" offer ack)
                (if (le attempts 0)
                    (list "glass-raster-focus-v1" "timeout" offer read)
                    (do (let waited (fgl-sleep-ms 250))
                        (fgrfr-await offer (sub attempts 1)))))))
    (let epoch (now_unix_ms))
    (let offer (fgtm-control-offer (FGLControlChannel)
        (str_concat "offer.raster." (int_to_str epoch)) epoch "focus"
        (fgtm-present "raster") "declared" "terminal.operator"))
    (let wrote (fgtm-offer-control (FGLRoot) offer))
    (print (if (and (ge (len wrote) 2) (str_eq (nth wrote 1) "offered"))
        (fgrfr-await offer 8)
        (list "glass-raster-focus-v1" "not-offered" offer wrote))))
