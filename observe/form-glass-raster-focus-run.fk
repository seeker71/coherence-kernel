; form-glass-raster-focus-run.fk — one bounded Form offer selects the
; resource x observed-frame raster only when the standing Glass returns the
; correlated physical acknowledgement.
; preflight-exec: forbidden
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let epoch (now_unix_ms))
    (let offer (fgtm-control-offer (FGLControlChannel)
        (str_concat "offer.raster." (int_to_str epoch)) epoch "focus"
        (fgtm-present "raster") "declared" "terminal.operator"))
    (print (fgl-control-offer-and-await offer)))
