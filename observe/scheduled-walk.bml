// scheduled-walk.bml — the body's night: engineering turns, drafts for our reading, and one movement, with no
// rented mind anywhere in it.
//
// launchd (docs/launchd/earth.hati.rent-walk.plist) runs this door from the walk checkout at 03:30; a second job
// (earth.hati.rent-walk-retry, 03:40) retries a first start that never began, informed by why. The steps it
// shares with the day's turns live in the parts host-walk-<seam>.bml that form-stdlib/bml/host-walk.bml imports. It
// first begins (hw-begin, host-walk-began.bml): a start that finds its own slot stamped inside the last 25 minutes (the
// first slot began; .hearth/walk.began) ends at once with the [walk-lock] line "already began", and one that finds no
// such stamp claims the checkout (hw-claim-at, host-walk-lock.bml) and stamps its slot: while
// a day turn still walks here, the night ends at once with the [walk-lock] line naming it. A candidate a killed turn
// left in the tree returns to its checkpoint (hw-heal), the branch then follows main with the tree's own rows carried
// across (only rows that merge as a union; any other change is named dirty and stays, never stashed; a replay that
// stops on a river of rows or the drawn page is settled and read "healed:", and one that stops on any other file takes
// no turn), the kernel and the Metal carrier rebuild when their sources are newer, and the landing fast-forwards main
// itself. After its sync, build and carrier the door begins itself again (form-stdlib/bml/host-walk-renew.bml hw-walk-door):
// its own argv, on the kernel the build placed, compiled from the tree the sync left. That renewed start takes the walk (the
// lock and the slot stamp name it) and walks every step below with the code the sync brought; the launched start waits on it
// and ends with it. The door walks only as the entry (observe/scheduled-walk.bml, as launchd's launcher, the retry and the
// renewal begin it from the checkout); imported, it names its steps and walks nothing.
// The night's window is two hours from its start (03:30 to 05:30). It first sits the exam with the network denied (observe/offline-exam-run.bml, inside half of what the window leaves; form-stdlib/bml/host-walk-exam.bml). It takes one native turn, and a second
// when the time left still holds an option and the first was not idle, each after the host's other checkouts let
// the GPU go and each reading the window's end as its wall deadline (hw-turns). Drafts and the movement
// yield first (hw-yield) so another checkout's model can finish; a queue with no open gap is first
// planned by the local planner (observe/local-plan-run.bml) within the window, and a gap it queued is turned at once
// and lands with the movement. It then drafts six of the person's
// newest prompts and redraws the reading page. Then the body learns from what it drafted (form-stdlib/bml/host-walk-learn.bml): a
// bounded native reading of its drafts inside the window (no reading when the governor refuses, named on its line), the
// rows from our readings and from its own, the 3B lift when eight new rows stand since the last (judged on held-out rows we
// accepted), the 27B's larger lift only after that lift read better and with the window's time and the machine's room for it (or a line saying why not),
// the rent meter, the exit proof, the gap register, one frontier word and the pinned review cases from the voice (host-walk-self.bml) and the offers the open rows make, each read as a line. It then makes the
// one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page
// redrawn from the ledgers, the landing, which carries the receipts the learning wrote (hw-learned; the rows hold the person's words and stay here, hw-words).
// The transcript is empty on purpose: there is no arriving mind to meter, and the absent flow row is the witness
// that none coordinated the walk.
// stdin: nothing from launchd (its job has none; a terminal reads as no stdin, so a hand start waits on no one). {"again":1} starts a night inside the 25 minutes of one that began, and
// {"safe":1} takes no model door (heal, sync, build, carrier and carry stand; the exam, turns, drafts, page, reading, rows, lift, rent, proof,
// gaps, steer and movement are skipped): the retry job's door (observe/walk-retry.bml, docs/launchd/earth.hati.rent-walk-retry.plist at 03:40) begins
// this door as its child with these, after reading why the first slot did not begin. {"renewal":{...}} is the one line the launched
// start hands its renewed self: the window's end, the day, the slot hour, the safe flag, the branch and the sync, build and carrier lines.
// Prints the lock and the heal when there was one; then the renewed start's lock line, the sync, build and carrier readings, each window
// reading and turn, the drafts (and their need line when the person's home was not found) and page, the reading, rows, lift, proof
// and register lines, the movement's line, the carry of a landing that stood on the branch (hw-carry), then the release; and last the
// launched start's [walk-renew] line. The renewed start holds the job's own streams and no deadline, as the launcher's child does. Every child the night itself
// begins (the turns, the planner, the review, the drafts, the page, the reading, the rows, the lift, the proof, the register, the gates, the movement, git) is an argv spawned
// through form-stdlib/bml/host-child.bml, each with a deadline that stops it and its lineage (a turn, a plan, a reading and a lift at
// their window's end plus half an hour, the other steps at two hours, git at half an hour), so a hung child does not
// hold the lock; the full output of each step's last run stays under .hearth/walk-io/<step>.out. The movement's own
// landing keeps one shell crossing (the drift-gates launch), named in form-stdlib/bml/form-cli-landing.bml; the
// movement's backstop reaches it.
// The day and the hour that name the night come from the host's zone and the unix clock (hw-day, hw-hhmm), with no
// child; an hour that did not read is 0, which is no on-hour.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk form-stdlib/bml/disk-steward.bml form-stdlib/bml/kernel-steward.bml
section [form.bml] {
 class ScheduledWalk {
  def sw-window-ms() = 7200000;
  def sw-take(deadline, n) = hw-native-turn(24, deadline);
  def sw-turns(until) = hw-turns(until, 2, hw-ready, sw-take, turn => "");
  def sw-yield(until) = hw-yield(until);
  // six of the person's newest prompts drafted by the body's own voice, for our reading (observe/prompt-draft-run.bml);
  // a need line the drafts spoke (the person's home not found) stays in the night's log beside the count. The drafts stay a
  // program of their own, on purpose (docs/in-process-cells.md, class C): the answer model is a session that holds the one
  // Metal client for minutes per draft, so the walk waits on it and ends it by pid rather than lending it this process.
  def sw-drafts() = hw-line(hch-with(hch-said(hch-run("drafts", ["./fkwu", "observe/prompt-draft-run.bml"], "{\"count\":6}\n", hch-by(hch-step-backstop-ms()))), ["[draft] need", "[draft] drafted"]));
  // the drafts redrawn on one page for our reading (observe/draft-page-run.bml): pure Form, a cell called in this process
  def sw-page() = hw-line(hch-cell-line(hch-cell("page", "observe/draft-page-run.bml", "", hch-by(hch-step-backstop-ms()))));
  // a walk begun outside its 03:25 to 03:45 window (a hand start) names itself off-schedule, so the WALK bit never reads it
  // as the host's own
  def sw-on-hour?(hhmm) = (hhmm >= 325) && (hhmm <= 345);
  def sw-request(day, hhmm) = json-node-object([
   fhn-s("movement", (sw-on-hour?(hhmm) ? "scheduled " : "off-schedule walk ") ++ day),
   fhn-s("transcript", ""),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", "Scheduled movement " ++ day ++ ": the body walks with no rented mind"),
   fhn-s("body", "Walked by launchd (earth.hati.rent-walk) from the walk checkout through observe/scheduled-walk.bml in one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing. No rented mind coordinated this movement; there is no flow row because there was no transcript to read.")]);
  def sw-run() {
   let opts = hw-stdin();
   hw-walk-door("scheduled-walk", opts, sw-prologue, sw-steps);
  }
  // the launched start: the hour and the window's end read first, then its claim and slot stamp; nothing() when it holds no walk
  def sw-prologue(opts) {
   let began = hw-hhmm();
   let until = host_monotonic_ms() + sw-window-ms();
   let lock = hw-begin("scheduled-walk", opts);
   let said = print_str(lock[1]);
   (Comparable) lock[0] == 1 ? sw-walk(began, until, hw-safe?(opts)) : nothing();
  }
  // the prologue's walk: the heal, the disk and the kernels tended, the sync, the build and the carrier; what it read is the
  // pairs the renewed start walks with
  def sw-walk(began, until, safe) {
   let branch = hw-branch();
   let day = hw-day();
   let healed = hw-say(hw-heal-noted());
   let tended = hw-say(ds-tend(".", 1));
   let kernels = hw-say(ks-tend(1));
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   hw-renewal-pairs(until, day, began, safe, branch, sync, build, carrier);
  }
  // the renewed start: every step below is the code the sync brought. A safe start (the retry door's, after a crash) keeps the
  // checkout whole and landed and begins no model door: the carry stands; the exam, the turns, the drafts, the page, what learns
  // from them and the movement are skipped
  def sw-steps(r) = sw-handed(r, sw-walked);
  // the renewal as the steps take it, each pair in its own place of walked (sw-walked's): the slot hour, the window's end, the
  // safe flag, the branch, the day and the sync, build and carrier lines
  def sw-handed(r, walked) = walked(hw-row-int(r, "hhmm"), hw-row-int(r, "until_ms"), (Comparable) hw-row-int(r, "safe") == 1, hw-row-str(r, "branch"), hw-row-str(r, "day"), hw-row-str(r, "sync"), hw-row-str(r, "build"), hw-row-str(r, "carrier"));
  def sw-walked(began, until, safe, branch, day, sync, build, carrier) {
   print_str("[walk] " ++ day ++ " branch=" ++ branch ++ " " ++ sync ++ " " ++ build ++ " " ++ carrier);
   hw-safe-skips?(safe, "exam") ? 0 : hw-say(hw-exam(until));
   let turned = hw-safe-skips?(safe, "turns") ? 0 : hw-conflicted?(sync) ? hw-held-turns(sync) : sw-turns(hw-turns-until(until));
   hw-safe-skips?(safe, "drafts") ? 0 : (hw-say(sw-yield(until)); hw-say(sw-drafts()));
   hw-safe-skips?(safe, "page") ? 0 : hw-say(sw-page());
   hw-safe-skips?(safe, "reading") ? 0 : hw-say(hw-reading(until));
   hw-safe-skips?(safe, "rows") ? 0 : hw-say(hw-rows());
   let lifted = hw-safe-skips?(safe, "lift") ? "" : hw-lift(until);
   hw-say(lifted);
   hw-safe-skips?(safe, "lift") ? 0 : hw-say(hw-lift-27b(until, lifted));
   hw-safe-skips?(safe, "rent") ? 0 : hw-say(hw-rent());
   hw-safe-skips?(safe, "proof") ? 0 : hw-say(hw-proof());
   hw-safe-skips?(safe, "gaps") ? 0 : hw-say(hw-gaps());
   hw-safe-skips?(safe, "distill") ? 0 : hw-say(hw-distill(until));
   hw-safe-skips?(safe, "review") ? 0 : hw-say(hw-self-review(until));
   hw-safe-skips?(safe, "steer") ? 0 : hw-say(hw-steer());
   hw-safe-skips?(safe, "movement") ? print_str("[walk] safe: no model door was begun (exam, turns, drafts, page, reading, rows, lift, rent, proof, gaps, distill, review, steer, movement)") : (hw-say(sw-yield(until)); print_str(hw-line(hw-movement(sw-request(day, began)))));
   print_str(hw-carry(branch));
   print_str(hw-release());
  }
 }
 let entry = cell_path();
 entry == "observe/scheduled-walk.bml" || entry == host_cwd() ++ "/observe/scheduled-walk.bml" ? sw-run() : nothing();
}
