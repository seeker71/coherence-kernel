// scheduled-walk.bml — the body's night: engineering turns, drafts for our reading, and one movement, with no
// rented mind anywhere in it.
//
// launchd (docs/launchd/earth.hati.rent-walk.plist) runs this door from the walk checkout at 03:30. The steps it
// shares with the day's turns live in form-stdlib/bml/host-walk.bml: the branch follows main, the kernel and the
// Metal carrier rebuild when their sources are newer, and the landing fast-forwards main itself. The night takes
// one native turn, and a second when the first ends before 05:30; drafts six of the person's newest prompts and
// redraws the reading page; then makes the one movement call (observe/movement-run.bml): the native voice in the
// fkwu model session, the native single call, the page redrawn from the ledgers, the landing. The transcript is
// empty on purpose: there is no arriving mind to meter, and the absent flow row is the witness that none
// coordinated the walk.
// stdin: nothing. Prints the sync, build and carrier readings, the turns, drafts and page, the movement's line, then
// the carry of a landing that stood on the branch (hw-carry).
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class ScheduledWalk {
  def sw-native-turns() {
   let first = hw-native-turn(24);
   let again = hw-hhmm() < 530 ? hw-native-turn(24) : "[native-turn] one turn tonight: the first ended after 05:30";
   first ++ "\n" ++ again;
  }
  // six of the person's newest prompts drafted by the body's own voice, for our reading (observe/prompt-draft-run.bml)
  def sw-drafts() = hw-line(host-exec("./fkwu observe/prompt-draft-run.bml 2>&1 | grep -F '[draft] drafted' | tail -1", "{\"count\":6}\n"));
  // the drafts redrawn on one page for our reading (observe/draft-page-run.bml)
  def sw-page() = hw-line(host-exec("./fkwu observe/draft-page-run.bml 2>&1 | grep -F '[draft-page]' | tail -1", ""));
  // a walk begun outside its 03:30 window (a hand start) names itself off-schedule, so the WALK bit never reads it
  // as the host's own
  def sw-on-hour?(hhmm) = (hhmm >= 325) && (hhmm <= 345);
  def sw-request(day, hhmm) = json-node-object(list(
   fhn-s("movement", (sw-on-hour?(hhmm) ? "scheduled " : "off-schedule walk ") ++ day),
   fhn-s("transcript", ""),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", "Scheduled movement " ++ day ++ ": the body walks with no rented mind"),
   fhn-s("body", "Walked by launchd (earth.hati.rent-walk) from the walk checkout through observe/scheduled-walk.bml in one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing. No rented mind coordinated this movement; there is no flow row because there was no transcript to read.")));
  def sw-run() {
   let began = hw-hhmm();
   let branch = hw-branch();
   let day = hw-day();
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   print_str("[walk] " ++ day ++ " branch=" ++ branch ++ " " ++ sync ++ " " ++ build ++ " " ++ carrier ++ "\n");
   print_str(sw-native-turns() ++ "\n");
   print_str(sw-drafts() ++ "\n");
   print_str(sw-page() ++ "\n");
   print_str(hw-movement(sw-request(day, began)));
   print_str(hw-carry(branch));
  }
 }
 sw-run();
}
