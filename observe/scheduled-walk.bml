// scheduled-walk.bml — the body walks one movement of docs/rent-to-zero-goal.form
// with no rented mind anywhere in it.
//
// launchd (docs/launchd/earth.hati.rent-walk.plist) runs this door from the walk
// checkout, a worktree that owns the branch. The door brings the branch to its
// origin head, rebuilds the kernel into a fresh inode when its source is newer,
// builds the Metal carrier when its source is newer, and makes the one movement
// call (observe/movement-run.bml) as a child kernel: the native voice in the
// fkwu model session, the native single call, the page redrawn from the ledgers,
// the landing. The transcript is empty on purpose: there is no arriving mind to
// meter, and the absent flow row is the witness that none coordinated the walk.
// stdin: nothing. Prints the sync, build and carrier readings, then the
// movement's own line.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class ScheduledWalk {
  def sw-source() = "observe/scheduled-walk.bml";
  def sw-line(text) = trim(if nothing?(text) then "" else text);
  def sw-branch() = sw-line(host-exec("git rev-parse --abbrev-ref HEAD", ""));
  def sw-day() = sw-line(host-exec("date +%F", ""));
  def sw-sync(branch) = sw-line(host-exec(mc-cat(list("git fetch -q origin ", branch, " && git merge -q --ff-only origin/", branch, "; echo sync=$?")), ""));
  def sw-build() = sw-line(host-exec("if [ fkwu -nt runtime/fkwu-uni.c ]; then echo build=fresh; else cc -O2 -o fkwu.next runtime/fkwu-uni.c && mv fkwu.next fkwu; echo build=$?; fi", ""));
  def sw-carrier() = sw-line(host-exec("if [ form/native/metal/fk-metal-carrier.dylib -nt form/native/metal/fk-metal-carrier.m ]; then echo carrier=fresh; else cc -O2 -dynamiclib -o form/native/metal/fk-metal-carrier.dylib form/native/metal/fk-metal-carrier.m -framework Metal -framework Foundation -fobjc-arc; echo carrier=$?; fi", ""));
  def sw-request(day) = json-node-object(list(
   fhn-s("movement", mc-cat(list("scheduled ", day))),
   fhn-s("transcript", ""),
   fhn-s("subject", mc-cat(list("Scheduled movement ", day, ": the body walks with no rented mind"))),
   fhn-s("body", "Walked by launchd (earth.hati.rent-walk) from the walk checkout through observe/scheduled-walk.bml in one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing. No rented mind coordinated this movement; there is no flow row because there was no transcript to read.")));
  def sw-movement(day) = host-exec("./fkwu observe/movement-run.bml 2>&1", mc-cat(list(json-emit(sw-request(day)), "\n")));
  def sw-run() {
   let branch = sw-branch();
   let day = sw-day();
   let sync = sw-sync(branch);
   let build = sw-build();
   let carrier = sw-carrier();
   print_str(mc-cat(list("[walk] ", day, " branch=", branch, " ", sync, " ", build, " ", carrier, "\n")));
   print_str(sw-movement(day));
  }
 }
 sw-run();
}
