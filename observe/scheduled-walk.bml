// scheduled-walk.bml — the body's night: engineering turns, drafts for our reading, and one movement, with no
// rented mind anywhere in it.
//
// launchd (docs/launchd/earth.hati.rent-walk.plist) runs this door from the walk checkout at 03:30. The steps it
// shares with the day's turns live in form-stdlib/bml/host-walk.bml. It first claims the checkout (hw-claim): while
// a day turn still walks here, the night ends at once with the [walk-lock] line naming it. A candidate a killed turn
// left in the tree returns to its checkpoint (hw-heal), the branch then follows main with the tree's own rows carried
// across, the kernel and the Metal carrier rebuild when their sources are newer, and the landing fast-forwards main
// itself. The night's window is two hours from its start (03:30 to 05:30). It takes one native turn, and a second
// when the time left still holds an option and the first was not idle, each after the host's other checkouts let
// the GPU go and each reading the window's end as its wall deadline (hw-turns). It then drafts six of the person's
// newest prompts and redraws the reading page, and makes the one movement call (observe/movement-run.bml): the
// native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing.
// The transcript is empty on purpose: there is no arriving mind to meter, and the absent flow row is the witness
// that none coordinated the walk.
// stdin: nothing. Prints the lock, the heal when there was one, the sync, build and carrier readings, each window
// reading and turn, the drafts (and their need line when the person's home was not found) and page, the movement's
// line, the carry of a landing that stood on the branch (hw-carry), then the release.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class ScheduledWalk {
  def sw-window-ms() = 7200000;
  def sw-take(deadline, n) = hw-native-turn(24, deadline);
  def sw-turns(until) = hw-turns(until, 2, hw-ready, sw-take, turn => "");
  // six of the person's newest prompts drafted by the body's own voice, for our reading (observe/prompt-draft-run.bml);
  // a need line the drafts spoke (the person's home not found) stays in the night's log beside the count
  def sw-drafts() = hw-line(host-exec("./fkwu observe/prompt-draft-run.bml 2>&1 | grep -F -e '[draft] need' -e '[draft] drafted'", "{\"count\":6}\n"));
  // the drafts redrawn on one page for our reading (observe/draft-page-run.bml)
  def sw-page() = hw-line(host-exec("./fkwu observe/draft-page-run.bml 2>&1 | grep -F '[draft-page]' | tail -1", ""));
  // a walk begun outside its 03:30 window (a hand start) names itself off-schedule, so the WALK bit never reads it
  // as the host's own
  def sw-on-hour?(hhmm) = (hhmm >= 325) && (hhmm <= 345);
  def sw-request(day, hhmm) = json-node-object([
   fhn-s("movement", (sw-on-hour?(hhmm) ? "scheduled " : "off-schedule walk ") ++ day),
   fhn-s("transcript", ""),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", "Scheduled movement " ++ day ++ ": the body walks with no rented mind"),
   fhn-s("body", "Walked by launchd (earth.hati.rent-walk) from the walk checkout through observe/scheduled-walk.bml in one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing. No rented mind coordinated this movement; there is no flow row because there was no transcript to read.")]);
  def sw-run() {
   let began = hw-hhmm();
   let until = host_monotonic_ms() + sw-window-ms();
   let lock = hw-claim("scheduled-walk");
   let said = print_str(lock[1]);
   (Comparable) lock[0] == 1 ? sw-walk(began, until) : 0;
  }
  def sw-walk(began, until) {
   let branch = hw-branch();
   let day = hw-day();
   let healed = hw-say(hw-heal());
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   print_str("[walk] " ++ day ++ " branch=" ++ branch ++ " " ++ sync ++ " " ++ build ++ " " ++ carrier);
   let turned = hw-conflicted?(sync) ? hw-held-turns(sync) : sw-turns(until);
   hw-say(sw-drafts());
   hw-say(sw-page());
   print_str(hw-line(hw-movement(sw-request(day, began))));
   print_str(hw-carry(branch));
   print_str(hw-release());
  }
 }
 sw-run();
}
