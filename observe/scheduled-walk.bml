// scheduled-walk.bml — the body's night: engineering turns, drafts for our reading, and one movement, with no
// rented mind anywhere in it.
//
// launchd (docs/launchd/earth.hati.rent-walk.plist) runs this door from the walk checkout at 03:30, and again at 03:40
// as the retry slot of a first start the machine killed at launch. The steps it
// shares with the day's turns live in the parts host-walk-<seam>.bml that form-stdlib/bml/host-walk.bml imports. It
// first begins (hw-begin, host-walk-began.bml): a start that finds its own slot stamped inside the last 25 minutes (the
// first slot began; .hearth/walk.began) ends at once with the [walk-lock] line "already began", and one that finds no
// such stamp claims the checkout (hw-claim-at, host-walk-lock.bml) and stamps its slot: while
// a day turn still walks here, the night ends at once with the [walk-lock] line naming it. A candidate a killed turn
// left in the tree returns to its checkpoint (hw-heal), the branch then follows main with the tree's own rows carried
// across (only rows that merge as a union; any other change is named dirty and stays, never stashed; a replay that
// stops on a river of rows or the drawn page is settled and read "healed:", and one that stops on any other file takes
// no turn), the kernel and the Metal carrier rebuild when their sources are newer, and the landing fast-forwards main
// itself. The night's window is two hours from its start (03:30 to 05:30). It takes one native turn, and a second
// when the time left still holds an option and the first was not idle, each after the host's other checkouts let
// the GPU go and each reading the window's end as its wall deadline (hw-turns); a queue with no open gap is first
// planned by the local planner (observe/local-plan-run.bml) within the window, and a gap it queued is turned at once
// and lands with the movement. It then drafts six of the person's
// newest prompts and redraws the reading page, and makes the one movement call (observe/movement-run.bml): the
// native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing.
// The transcript is empty on purpose: there is no arriving mind to meter, and the absent flow row is the witness
// that none coordinated the walk.
// stdin: nothing from launchd; a hand start inside the 25 minutes of a begun night reads {"again":1} to start anyway.
// Prints the lock, the heal when there was one, the sync, build and carrier readings, each window
// reading and turn, the drafts (and their need line when the person's home was not found) and page, the movement's
// line, the carry of a landing that stood on the branch (hw-carry), then the release. Every child the night itself
// begins (the turns, the planner, the review, the drafts, the page, the gates, the movement, git) is an argv spawned
// through form-stdlib/bml/host-child.bml, each with a deadline that stops it and its lineage (a turn and a plan at
// their window's end plus half an hour, the other steps at two hours, git at half an hour), so a hung child does not
// hold the lock; the full output of each step's last run stays under .hearth/walk-io/<step>.out. The movement's own
// landing keeps one shell crossing (the drift-gates launch), named in form-stdlib/bml/form-cli-landing.bml; the
// movement's backstop reaches it.
// The day and the hour that name the night come from the host's zone and the unix clock (hw-day, hw-hhmm), with no
// child; an hour that did not read is 0, which is no on-hour.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class ScheduledWalk {
  def sw-window-ms() = 7200000;
  def sw-take(deadline, n) = hw-native-turn(24, deadline);
  def sw-turns(until) = hw-turns(until, 2, hw-ready, sw-take, turn => "");
  // six of the person's newest prompts drafted by the body's own voice, for our reading (observe/prompt-draft-run.bml);
  // a need line the drafts spoke (the person's home not found) stays in the night's log beside the count
  def sw-drafts() = hw-line(hch-with(hch-said(hch-run("drafts", ["./fkwu", "observe/prompt-draft-run.bml"], "{\"count\":6}\n", hch-by(hch-step-backstop-ms()))), ["[draft] need", "[draft] drafted"]));
  // the drafts redrawn on one page for our reading (observe/draft-page-run.bml)
  def sw-page() = hw-line(hch-last(hch-said(hch-run("page", ["./fkwu", "observe/draft-page-run.bml"], "", hch-by(hch-step-backstop-ms()))), "[draft-page]"));
  // a walk begun outside its 03:25 to 03:45 window (a hand start) names itself off-schedule, so the WALK bit never reads it
  // as the host's own
  def sw-on-hour?(hhmm) = (hhmm >= 325) && (hhmm <= 345);
  def sw-request(day, hhmm) = json-node-object([
   fhn-s("movement", (sw-on-hour?(hhmm) ? "scheduled " : "off-schedule walk ") ++ day),
   fhn-s("transcript", ""),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", "Scheduled movement " ++ day ++ ": the body walks with no rented mind"),
   fhn-s("body", "Walked by launchd (earth.hati.rent-walk) from the walk checkout through observe/scheduled-walk.bml in one movement call (observe/movement-run.bml): the native voice in the fkwu model session, the native single call, the page redrawn from the ledgers, the landing. No rented mind coordinated this movement; there is no flow row because there was no transcript to read.")]);
  def sw-run() {
   let began = hw-hhmm();
   let until = host_monotonic_ms() + sw-window-ms();
   let lock = hw-begin("scheduled-walk");
   let said = print_str(lock[1]);
   (Comparable) lock[0] == 1 ? sw-walk(began, until) : 0;
  }
  def sw-walk(began, until) {
   let branch = hw-branch();
   let day = hw-day();
   let healed = hw-say(hw-heal());
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   print_str("[walk] " ++ day ++ " branch=" ++ branch ++ " " ++ sync ++ " " ++ build ++ " " ++ carrier);
   let turned = hw-conflicted?(sync) ? hw-held-turns(sync) : sw-turns(until);
   hw-say(sw-drafts());
   hw-say(sw-page());
   print_str(hw-line(hw-movement(sw-request(day, began))));
   print_str(hw-carry(branch));
   print_str(hw-release());
  }
 }
 sw-run();
}
