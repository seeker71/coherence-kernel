; covenant-census-live.fk — run the claim battery on every embodiment and
; winnow covenant from accident, live.
;
; Sixteen small claims (absence equality and ordering, truthiness of
; absence and float zero, the 4-slot let seam, empty-list floors, string
; and word equality, float promotion) each run on fkwu, go, rust and ts
; through host-exec; each arm reduces to (answer rc); the pure classifier
; (form-stdlib/covenant-census.fk, four-way proven) names the class. The
; dated ledger lands in learn/covenant-atlas.txt; when a claim's class
; differs from the ledger's, the run prints DRIFT — the aged-stamp wound of
; 2026-08-27, closed by making re-witness one run instead of one
; archaeology.
;
; Effectful (spawns sibling kernels read-only, writes the atlas and its own
; probe dir); fkwu host-io door. Run with stdin closed.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/str-byte-at.fk
; preludes: form-stdlib/covenant-census.fk

(do
    (defn ccl-claims ()
        (list
            (list "eq-nothing-int"    "(eq (nothing) 0)")
            (list "eq-nothing-self"   "(eq (nothing) (nothing))")
            (list "eq-nothing-float"  "(eq (nothing) 0.0)")
            (list "ne-nothing-int"    "(ne (nothing) 0)")
            (list "lt-nothing-int"    "(lt (nothing) 1)")
            (list "gt-nothing-int"    "(gt (nothing) 1)")
            (list "if-nothing"        "(if (nothing) 7 9)")
            (list "if-float-zero"     "(if 0.0 7 9)")
            (list "if-float-half"     "(if 0.5 7 9)")
            (list "let4-value-pos"    "(add (let x 5 (mul x 2)) 100)")
            (list "head-empty"        "(head (list))")
            (list "len-tail-empty"    "(len (tail (list)))")
            (list "eq-str-str"        "(eq \"a\" \"a\")")
            (list "str-eq-control"    "(str_eq \"ab\" \"ab\")")
            (list "mul-float-promote" "(eq (mul 2.5 4) 10)")
            (list "eq-int-covenant"   "(eq 42 42)")))

    (defn ccl-last-rc-go (s from best)
        (do (let at (str_find s "rc=" from))
            (if (lt at 0) best (ccl-last-rc-go s (add at 3) at))))
    ; run one command -> (answer-text rc); rc rides the last rc= line so the
    ; host-exec stdout-only door still carries the exit status.
    (defn ccl-run (command)
        (do (let out (host-exec command ""))
            (let at (ccl-last-rc-go out 0 -1))
            (if (lt at 0) (cvc-result out 999)
                (cvc-result (substring out 0 (sub at 0))
                    (str_to_int (cvc-trim
                        (substring out (add at 3) (str_len out))))))))

    (defn ccl-fkwu (probe)
        (str_concat "./fkwu " (str_concat probe
            " </dev/null 2>/dev/null; echo rc=$?")))
    (defn ccl-host (binary probe)
        (str_concat "cd form && " (str_concat binary
            (str_concat " form-stdlib/core.fk " (str_concat probe
                " 2>/dev/null; echo rc=$?")))))
    ; the ts arm has two doors (validate.sh's own order): the esbuild bundle
    ; when it exists, else node's strip-types run of the source — probed at
    ; run time, never configured.
    (defn ccl-ts (probe)
        (str_concat "cd form && if [ -f form-kernel-ts/dist/main.mjs ]; then node form-kernel-ts/dist/main.mjs form-stdlib/core.fk "
            (str_concat probe
                (str_concat " 2>/dev/null; else node --experimental-strip-types form-kernel-ts/src/main.ts form-stdlib/core.fk "
                    (str_concat probe " 2>/dev/null; fi; echo rc=$?")))))

    ; -> (name class answers drift-old)
    (defn ccl-claim-run (dir atlas name source)
        (do (let probe (str_concat dir (str_concat "/"
                (str_concat name ".fk"))))
            (write_file probe (str_concat
                "; preludes: form-stdlib/core.fk\n"
                (str_concat source "\n")))
            (let a (ccl-run (ccl-fkwu probe)))
            (let b (ccl-run (ccl-host "./form-kernel-go/bin-go" probe)))
            (let c (ccl-run (ccl-host
                "./form-kernel-rust/target/release/form-kernel-rust" probe)))
            (let d (ccl-run (ccl-ts probe)))
            (let class (cvc-class a b c d))
            (list name class (cvc-answers a b c d)
                (cvc-drift atlas name class))))

    (defn ccl-count (rows class)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (nth (head rows) 1) class) 1 0)
                (ccl-count (tail rows) class))))
    (defn ccl-drifts (rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (nth (head rows) 3) "") 0 1)
                (ccl-drifts (tail rows)))))

    (defn ccl-print-rows (rows)
        (if (eq (len rows) 0) 0
            (do (let r (head rows))
                (print "claim " (nth r 0) " class=" (nth r 1) "  "
                    (nth r 2))
                (if (str_eq (nth r 3) "") 0
                    (print "DRIFT " (nth r 0) " " (nth r 3) " -> "
                        (nth r 1)))
                (ccl-print-rows (tail rows)))))

    (defn ccl-atlas-text (rows stamp acc)
        (if (eq (len rows) 0) acc
            (ccl-atlas-text (tail rows) stamp
                (str_concat acc (cvc-atlas-row (nth (head rows) 0)
                    (nth (head rows) 1) (nth (head rows) 2) stamp)))))

    (defn ccl-battery (dir atlas claims acc)
        (if (eq (len claims) 0) acc
            (ccl-battery dir atlas (tail claims)
                (append acc (list (ccl-claim-run dir atlas
                    (nth (head claims) 0) (nth (head claims) 1)))))))

    (let pid (cvc-trim (host-exec "echo $PPID" "")))
    (let dir (str_concat "/tmp/form-field/cvc-" pid))
    (host-exec (str_concat "mkdir -p " dir) "")
    (let atlas-read (read_file "learn/covenant-atlas.txt"))
    (let atlas (if (nothing? atlas-read) "" atlas-read))
    (let rows (ccl-battery dir atlas (ccl-claims) (list)))
    (ccl-print-rows rows)
    (print "counts covenant=" (ccl-count rows "covenant")
        " split=" (ccl-count rows "split")
        " partial=" (ccl-count rows "partial")
        " refused=" (ccl-count rows "refused")
        " drift=" (ccl-drifts rows)
        (if (str_eq atlas "") "  (first ledger — nothing to drift against)"
            ""))
    (write_file "learn/covenant-atlas.txt"
        (ccl-atlas-text rows (now_unix_ms) ""))
    (host-exec (str_concat "rm -rf " dir) "")
    0)
