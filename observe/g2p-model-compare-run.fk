// g2p-model-compare-run.fk — two phoneme tables for the same words, compared exactly (no normalisation).
//
//   printf '<tsv a>\n<tsv b>\n' | ./fkwu observe/g2p-model-compare-run.fk
//
// Each file is `word<TAB>phonemes`. Prints how many words both hold, how many are byte-equal, how many differ,
// how many only one file holds, and the first twelve differences. It is how the body's native T5 is held against a
// torch oracle's table over every word of a tongue (the oracle is a one-off, named in form/form-stdlib/tests/native-t5-band.fk).
// preflight-exec: forbidden
import form/form-stdlib/line-grammar.fk;
section [form.bml] {
    def gmc-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def gmc-tab() = byte_to_str(9);
    def gmc-lines(path) = file_size(path) > 0 ? split-on(read_file(path), byte_to_str(10)) : [];
    def gmc-load(rows, rec) {
        nil?(rows) ? rec : gmc-load(rows[1:], gmc-add(rows[0], rec));
    }
    def gmc-add(row, rec) {
        let at = str_find(row, gmc-tab(), 0);
        at < 1 ? rec : record_set(rec, substring(row, 0, at), substring(row, at + 1, len(row)));
    }
    // state: [both equal differ only-a shown]
    def gmc-walk(ws, a, b, st) = nil?(ws) ? st : gmc-walk(ws[1:], a, b, gmc-one(ws[0], a, b, st));
    def gmc-one(w, a, b, st) = record_has(b, w) ? gmc-pair(w, record_get(a, w), record_get(b, w), st) : [st[0], st[1], st[2], st[3] + 1, st[4]];
    def gmc-pair(w, x, y, st) = ((String) x == y) ? [st[0] + 1, st[1] + 1, st[2], st[3], st[4]] : [st[0] + 1, st[1], st[2] + 1, st[3], gmc-show(w, x, y, st[4])];
    def gmc-show(w, x, y, shown) {
        let p = shown < 12 ? print_str("  differs: " + w + "  a=" + x + "  b=" + y) : 0;
        shown + 1;
    }
    let pa = gmc-line();
    let pb = gmc-line();
    (len(pa) == 0 || len(pb) == 0) ? form_error("usage: <tsv a> / <tsv b> on stdin") : 0;
    let a = gmc-load(gmc-lines(pa), record_new(0));
    let b = gmc-load(gmc-lines(pb), record_new(0));
    let st = gmc-walk(record_keys(a), a, b, [0, 0, 0, 0, 0]);
    print_str("a=" + pa);
    print_str("b=" + pb);
    print_str("words_in_both=" + st[0].str() + " equal=" + st[1].str() + " differ=" + st[2].str() + " only_in_a=" + st[3].str() + " only_in_b=" + (len(record_keys(b)) - st[0]).str());
    0;
}
