; twin-census-run.fk — which of this body's doors is a private copy of a warm one.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/twin-glass.bml form/form-stdlib/meaning-codes.bml
;
; The sister door is observe/bearing-census-run.fk, and this cell is its inverse.
; The bearing census ranks by HEAT, so it names a cold door only once something
; drives it hard: `nth-rec` waited under sha256.fk until a locale walk entered it
; seventy-six million times. This census finds its pairs in the SOURCE, so a door
; nothing has driven yet is named all the same — which is the whole reason it
; exists (corpus row 1351, coldtwin).
;
; The workload is the same locale-row walk, run IN THIS PROCESS, for one reason
; only: the heat overlay that colours a pair cold or warm belongs to the process
; that walked. Take the workload away and the pairs are all still found; take it
; away and every pair reads `no-warm-side`, which is the honest word for a
; measure that was not taken.
;
; The order is the whole method: WORK, then SNAPSHOT the ledger, then think.
; Every step this census takes lands after the snapshot.

(do
    ; the units whose doors are compared. A hot row's unit names the RESOLUTION FRAME
    ; and not always the file, so the files are handed in by name and each door is
    ; found by walking them — the same caution bearing-census.bml carries.
    (defn tcr-sources ()
        (list "form/form-stdlib/core.fk"
              "form/form-stdlib/line-grammar.fk"
              "form/form-stdlib/meaning-codes.bml"
              "form/form-stdlib/sha256.fk"
              "form/form-stdlib/rag-key.bml"))
    (defn tcr-label () "the locale-row walk")
    (defn tcr-hold-ms () 20000)

    (let t0 (now_unix_ms))
    (let round (mc-all-round? (mc-meanings)))
    (let t1 (now_unix_ms))
    (let rows (kernel_hot_rows (TWCTopN)))
    (let walked (bgl-walked))

    (let coldest (twg-witness rows walked (sub t1 t0) (tcr-label) (tcr-sources)))
    (let said (print (str_concat "  every meaning round-tripped: " (int_to_str round))))
    (let held (host_sleep_ms (tcr-hold-ms)))
    coldest)
