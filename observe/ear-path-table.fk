; ear-path-table.fk — the whole path in one table, read off the ear's own spool.
;
; For every line the ear closed it answers: when the mouth handed the room its last sample, when
; the words FIRST stood on the glass at all, when they last changed (the instant the line was
; already right), when the lane committed them, what closed it, and what the pass thought of them
; — its doubt over the window and its own average log-probability over the words. The two waits
; that matter fall straight out of it: settle = the words were already final this long before the
; close, and mouth = the whole path, the body's own mouth to the committed line.
;
; The mouth needs no instrument of its own: voice-say writes a "spoke" frame into this same spool
; carrying the instant AND the line it said, in the ear's own clock — so what was SAID stands
; beside what was HEARD, and every phantom the lane refused is named rather than merely absent.
; preludes: form/form-stdlib/ear-axes.bml form/form-stdlib/line-grammar.fk
(do
    (defn ept-spool () ".hearth/ear.spool")
    (defn ept-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (ept-cat (tail xs)))))
    (defn ept-nl () (byte_to_str 10))
    (defn ept-pad (s n) (if (ge (str_len s) n) s (ept-pad (str_concat s " ") n)))
    (defn ept-t (f) (str_to_int (ea-field f "t")))
    ; the earliest live frame in this line's own run that already carried the words it closed with
    (defn ept-first-eq (pend txt) (if (eq (len pend) 0) 0 (if (and (str_eq (ea-field (head pend) "kind") "live") (str_eq (ea-field (head pend) "live") txt)) (ept-t (head pend)) (ept-first-eq (tail pend) txt))))
    (defn ept-first-live (pend) (if (eq (len pend) 0) 0 (if (str_eq (ea-field (head pend) "kind") "live") (ept-t (head pend)) (ept-first-live (tail pend)))))
    (defn ept-spoke (pend best) (if (eq (len pend) 0) best (ept-spoke (tail pend) (if (str_eq (ea-field (head pend) "kind") "spoke") (head pend) best))))
    (defn ept-ms (a b) (if (eq a 0) "?" (int_to_str (sub b a))))
    (defn ept-row (f pend n)
        (do (let t (ept-t f))
            (let txt (ea-field f "heard"))
            (let t0 (ept-first-live pend))
            (let tf (ept-first-eq pend txt))
            (let sp (ept-spoke pend (list)))
            (let p (print_str (ept-cat (list
                (ept-pad (int_to_str n) 3)
                (ept-pad (ea-field f "lang") 4)
                (ept-pad (ea-field f "why") 9)
                (ept-pad (str_concat "open=" (ept-ms t0 t)) 12)
                (ept-pad (str_concat "settle=" (ept-ms tf t)) 13)
                (ept-pad (if (eq (len sp) 0) "mouth=?" (str_concat "mouth+" (int_to_str (sub t (ept-t sp))))) 13)
                (ept-pad (str_concat "stable=" (ea-field f "stable")) 11)
                (ept-pad (str_concat "tail=" (ea-field f "tailsil")) 11)
                (ept-pad (str_concat "commit=" (ea-field f "heardms")) 11)
                (ept-pad (str_concat "doubt=" (ea-field f "nsp")) 11)
                (ept-pad (str_concat "avglp=" (ea-field f "avglp")) 13)
                txt))))
            (if (eq (len sp) 0) 0 (print_str (ept-cat (list (ept-pad "" 7) (ept-pad "said" 9) (ea-field sp "line")))))))
    (defn ept-phantom (f n)
        (print_str (ept-cat (list (ept-pad (int_to_str n) 3) (ept-pad "--" 4) (ept-pad "refused" 9)
                                  (ept-pad (str_concat "doubt=" (ea-field f "nsp")) 12) (ea-field f "tags")))))
    (defn ept-walk (fs pend n ghosts)
        (if (eq (len fs) 0) (list n ghosts)
            (do (let f (head fs))
                (let k (ea-field f "kind"))
                (if (str_eq k "heard")
                    (do (let r (ept-row f pend n)) (ept-walk (tail fs) (list) (add n 1) ghosts))
                    (if (str_eq k "phantom")
                        (do (let r (ept-phantom f n)) (ept-walk (tail fs) pend n (add ghosts 1)))
                        (if (or (str_eq k "live") (str_eq k "spoke"))
                            (ept-walk (tail fs) (append pend (list f)) n ghosts)
                            (ept-walk (tail fs) pend n ghosts)))))))
    (let text (ea-text (read_file (ept-spool))))
    (let hdr (print_str "  #  ln  why      open        settle       mouth        stable     tail       commit     doubt      avglp        line"))
    (let r (ept-walk (ea-frames text 0 (list)) (list) 1 0))
    (print_str (ept-cat (list "lines=" (int_to_str (sub (head r) 1)) "  refused=" (int_to_str (nth r 1)))))
    0)
