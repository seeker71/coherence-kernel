; voice-track-wav-run.fk — every rendered piece of a track gets a RIFF header, so the body's ear can hear it back.
; NNNN.pcm (raw 16-bit mono, 22050 Hz) -> NNNN.wav beside it, header from the master's own builder. No device is touched.
; Proof: pending.
; preludes: form/form-stdlib/voice-track.bml
(do
    (defn vt-say (code n) (print_str (str_concat code (str_concat " wav " (int_to_str n)))))
    (vt-say "en" (vtr-wav-all "en"))
    (vt-say "pt" (vtr-wav-all "pt"))
    (vt-say "fa" (vtr-wav-all "fa"))
    (vt-say "id" (vtr-wav-all "id"))
    0)
