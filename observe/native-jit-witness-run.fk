; Form emits machine code, executes it, and refuses a malformed image.
; preludes: form-stdlib/bml/native-jit-route.bml
(do
    (let image (njr-image))
    (let answer (jit_leaf_inram image 5))
    (let replay (jit_leaf_inram image 9))
    (let refused (nothing? (jit_leaf_inram (list 1 2 3) 0)))
    (print (list "owner" (njr-owner) "image-bytes" (len image)
        "answer" answer "replay" replay "malformed-refused" refused))
    (if (and (eq answer 22) (and (eq replay 34) refused)) 1
        (form_error "Form native JIT witness failed")))
