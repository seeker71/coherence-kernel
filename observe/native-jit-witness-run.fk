// Form emits machine code, executes it, and refuses a malformed image.
import form-stdlib/bml/native-jit-route.bml;
section [form.bml] {
    let image = njr-image();
    let answer = jit_leaf_inram(image, 5);
    let replay = jit_leaf_inram(image, 9);
    let refused = nothing?(jit_leaf_inram([1, 2, 3], 0));
    print(["owner", njr-owner(), "image-bytes", len(image), "answer", answer, "replay", replay, "malformed-refused", refused]);
    (Comparable) answer == 22 && ((Comparable) replay == 34 && refused) ? 1 : form_error("Form native JIT witness failed");
}
