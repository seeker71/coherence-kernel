; inquiry-loop.fk — the whole chain as ONE recipe, run inside its own framebuffer.
;
; Urs, 2026-07-23 08:38: doing it all inside a single Form recipe allows full tracing and
; live observation of diagnostics via the framebuffer — to call into reality what we wanted
; to see, so the inquiry lane has information based on current observed truth.
;
; The night built the blocks as separate cells. This is the recipe that runs them as one
; walk, wrapped in framebuffer-runtime-observation so the diagnostic is not bolted on beside
; the computation — it IS the computation, counted by the kernel that runs it. What fires,
; how many nodes it interns, how many dispatches it costs: those are read from the same fkwu
; that produced the answer, in the same window. The trace is not a report about the run; it
; is the run, observed from inside.
;
; The chain, in order, each step a block proven on its own band:
;   READ   — a sensor frame becomes derived state (still / held / moving / dark)
;   ASK    — the state selects which questions compose right now
;   GROUND — the selected question is tagged with the observed truth it stands on, so no
;            inquiry lane ever runs on a state nobody witnessed
; and the whole thing runs between fbro-open and fbro-close, so its own execution is the
; live observation.
;
; THE HONEST FRAME kept here: the input is the last witnessed frame, 2026-07-23 00:39
; (motion 14, tilt out-of-domain, light 3 -> held), because at 08:38 the phone is off the
; cable and unreachable — adb reports 'device not found'. That absence is itself a reading:
; the loop runs on a STORED frame and says so, rather than on a live one it does not have.
; A recipe that traces itself carries the freshness of what it traces, or its own diagnostic
; becomes a confident record of a stale truth — bit 128 is where that stays honest.
;
; preludes: form-stdlib/core.fk observe/live-inquiry.fk observe/open-questions.fk observe/framebuffer-runtime-observation.fk

(do
    ; ── one frame: (motion tilt light freshness) ──
    ; freshness: 1 live, 0 stored. The loop carries it so the answer knows its own ground.
    (defn il-frame (motion tilt light fresh) (list motion tilt light fresh))
    (defn ilp-motion (f) (nth f 0))
    (defn ilp-tilt   (f) (nth f 1))
    (defn ilp-light  (f) (nth f 2))
    (defn ilp-fresh  (f) (nth f 3))

    ; ── READ: frame -> derived state (reusing live-inquiry's li-state) ──
    (defn ilp-read (f) (li-state (ilp-motion f) (ilp-tilt f) (ilp-light f)))

    ; ── ASK: state -> the question that heads the queue for that state ──
    (defn ilp-ask (state) (li-first-askable (li-questions) state))
    (defn ilp-ask-count (state) (li-count-askable (li-questions) state))

    ; ── GROUND: bind the question to the state AND its freshness, so a lane that acts on it
    ; can see whether it stands on a live truth or a stored one. A stored frame does not stop
    ; the loop; it stamps the answer. ──
    (defn ilp-ground (f)
        (do (let state (ilp-read f))
            (list "grounded"
                  "state" state
                  "question" (ilp-ask state)
                  "questions-available" (ilp-ask-count state)
                  "witnessed" (if (eq (ilp-fresh f) 1) "live" "stored"))))
    (defn ilg-state    (g) (nth g 2))
    (defn ilg-question (g) (nth g 4))
    (defn ilg-count    (g) (nth g 6))
    (defn ilg-witness  (g) (nth g 8))

    ; ── the whole loop as ONE traced recipe ──
    ; opens a framebuffer window, runs read->ask->ground, closes it, and returns BOTH the
    ; grounded inquiry and the execution trace. The caller gets the answer and the diagnostic
    ; as one value, which is the point: current observed truth includes the cost of observing.
    (defn inquiry-loop (f)
        (do (let w (fbro-open "inquiry-loop" "sema" "witness"
                      "run the sense-to-question chain and observe its own execution"
                      "one frame becomes one grounded question"
                      (len f) "observe/inquiry-loop.fk" 1 1))
            (let grounded (ilp-ground f))
            (let r (fbro-close w (ilg-witness grounded) 1 "observe/inquiry-loop.fk" 1 1))
            (list "inquiry-loop-run" grounded r)))
    (defn ilr-grounded (run) (nth run 1))
    (defn ilr-trace    (run) (nth run 2))

    ; ── the last witnessed frame, 2026-07-23 00:39, stored (phone unreachable at 08:38) ──
    (defn ilp-last-frame () (il-frame 14 42000 3 0))
    ; a hypothetical live moving frame, for the band to show the loop tracks state change
    (defn ilp-moving-frame () (il-frame 900 1374 3 1))

    ; ── self-check ──
    (defn ilpk (cond bit) (if cond bit 0))
    (defn ilp-reads-held ()  (ilpk (str_eq (ilp-read (ilp-last-frame)) "held") 1))
    (defn ilp-reads-moving () (ilpk (str_eq (ilp-read (ilp-moving-frame)) "moving") 2))
    ; held's first askable is the ANY-state question, which precedes the held-specific one in
    ; the queue — the loop offers the most broadly-answerable question first, not the most
    ; state-specific. (Asserting the held-specific one was the author's wrong expectation; the
    ; band refused it. The queue order is the spec, not the intuition about it.)
    (defn ilp-grounds ()
        (ilpk (str_eq (ilg-question (ilp-ground (ilp-last-frame)))
                      "which direction is the music arriving from?") 4))
    (defn ilp-stamps-stored ()
        (ilpk (str_eq (ilg-witness (ilp-ground (ilp-last-frame))) "stored") 8))
    (defn ilp-stamps-live ()
        (ilpk (str_eq (ilg-witness (ilp-ground (ilp-moving-frame))) "live") 16))
    ; the traced run returns a grounded inquiry AND a framebuffer report
    (defn ilp-run-grounds ()
        (ilpk (str_eq (nth (ilr-grounded (inquiry-loop (ilp-last-frame))) 0) "grounded") 32))
    (defn ilp-run-traces ()
        (ilpk (str_eq (nth (ilr-trace (inquiry-loop (ilp-last-frame))) 0)
                      "framebuffer-runtime-observation") 64))
    ; and the trace's outcome carries the freshness the ground carried — the observation
    ; inherits the honesty of what it observed
    ; fbro-outcome returns the PAIR ("outcome" <value>); the value is element 1. Reading the
    ; pair as the value would be the use-mention slip 857 named — the accessor mentions the
    ; outcome, it is not the outcome.
    (defn ilp-trace-outcome (run) (nth (fbro-outcome (ilr-trace run)) 1))
    (defn ilp-trace-honest ()
        (ilpk (str_eq (ilp-trace-outcome (inquiry-loop (ilp-last-frame))) "stored") 128))
    (defn inquiry-loop-check ()
        (add (add (add (ilp-reads-held) (ilp-reads-moving))
                  (add (ilp-grounds) (ilp-stamps-stored)))
        (add (add (ilp-stamps-live) (ilp-run-grounds))
             (add (ilp-run-traces) (ilp-trace-honest)))))
)
