; roster-census-run.fk — how many kernels this host runs, how many the roster sees, and which it cannot.
;
; Two reads half a second apart; a kernel counts as untracked, stale, orphaned, unpaged or on an errand only
; when both reads agree, so one that was starting or ending in between is not reported. The first line gives
; how many processes the host's name read named, how many living kernels the pages showed, and how many the
; roster holds; the lists (unseen where a read the list stands on did not answer); how many processes the name
; read could not name, the pages it could not read and the kernel rows the host withheld; and the reads (1 when
; the name read answered a list, the roster holds this census, the walk found this census's own page). Then
; one line per kernel, the cells more than one kernel runs,
; and the organ-health readings of the roster (kernel-roster.bml) and of the live pages (kernel-pages.bml).
; The census reads; care acts only on the pids a caller names: observe/kernel-roster-adopt-run.bml gives
; untracked kernels a slot, observe/kernel-pages-bury-run.bml buries ended pages.
;
;   ./fkwu observe/roster-census-run.fk
;
; preludes: form-stdlib/core.fk form/form-stdlib/kernel-pages.bml form/form-stdlib/kernel-roster.bml
(do
    (let s (rce-settled 500))
    (print (list "host-fkwu" (len (rce-s-named s)) "kernels" (len (rce-s-kernels s)) "roster" (len (rce-s-roster s)) "untracked" (krs-seen-or (krs-untracked-missing s) (rce-s-untracked s)) "stale" (krs-seen-or (krs-stale-missing s) (rce-s-stale s)) "orphans" (krs-seen-or (krs-orphans-missing s) (rce-s-orphans s)) "errands" (krs-seen-or (krs-errands-missing s) (rce-s-errands s)) "unpaged" (krs-seen-or (krs-unpaged-missing s) (rce-s-unpaged s)) "unread-names" (len (rce-s-unread-names s)) "unread-pages" (rce-s-unread-pages s) "unread-rows" (rce-s-unread-rows s) "reads" (list (rce-s-host-read s) (rce-s-roster-read s) (rce-s-page-read s))))
    ; one line per kernel, from the second read: (pid cell cwd exe owner owner-pid kernel-parent withheld)
    (defn rcr-say (ks) (if (eq (len ks) 0) 0 (do (print (head ks)) (rcr-say (tail ks)))))
    (let ks (rce-s-kernels s))
    (let said (rcr-say ks))
    (print (list "duplicates" (rce-duplicates ks)))
    ; the roster and the live pages speak as organ-health readings
    (let roster-said (oh-voice-all (krs-readings s)))
    (let pages-said (oh-voice-all (kpg-observe)))
    0)
