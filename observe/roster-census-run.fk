; roster-census-run.fk — how many kernels this host runs, how many the roster sees, and which it cannot.
;
; Two reads half a second apart; a kernel counts as untracked (or stale) only when both reads agree, so one
; that was starting or ending in between is not reported as missing.
;
;   ./fkwu observe/roster-census-run.fk
;
; preludes: form-stdlib/core.fk form/form-stdlib/roster-census.bml
(do
    (let s (rce-settled 500))
    (print (list "host-fkwu" (nth s 0) "roster" (nth s 1) "untracked" (nth s 2) "stale" (nth s 3) "orphans" (nth s 4)))
    (let adopted (rce-adopt (nth s 2)))
    (let after (rce-take))
    (print (list "adopted" adopted "roster-now" (nth after 1) "untracked-now" (nth after 2)))
    ; one line per kernel: (pid cell cwd exe owner owner-pid)
    (defn rcr-say (ks) (if (eq (len ks) 0) 0 (do (print (head ks)) (rcr-say (tail ks)))))
    (let ks (rce-kernels))
    (let said (rcr-say ks))
    (print (list "duplicates" (rce-duplicates ks)))
    ; pages of kernels that have ended, read and never unlinked: burial is kernel_page_bury pid, one pid at a time
    (print (list "pages-ended" (len (rce-ended))))
    0)
