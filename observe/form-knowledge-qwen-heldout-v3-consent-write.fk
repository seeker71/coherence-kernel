; form-knowledge-qwen-heldout-v3-consent-write.fk — per-run act.
; Writes the dataset-bound token. Does not print it. Gitignored path.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk

(do
    (write_file_text (fkh3-consent-path) (fkh3-consent-token))
    (if (eq (fkh3-consent-valid? (read_file (fkh3-consent-path))) 1) 1 0))
