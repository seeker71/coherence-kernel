; Soft propose → verify → equivalence → commit|refuse (no GGUF).
; preludes: form-stdlib/local-generate-organ.fk
(do
    (let ok (lg-soft "(mul 7 7)" "(mul 7 7)"))
    (let bad (lg-soft "(mul 7 7)" "(mul 6 7)"))
    (let silent (lg-soft "the square is forty-nine" "(mul 7 7)"))
    (let live
        (lg-observe-soft "What is the square of 7?" "(mul 7 7)" "(mul 7 7)" (empty)))
    (let line1 (str_concat "ok-status=" (str_concat (lg-soft-status ok) (str_concat " ok-equivalent=" (int_to_str (lg-soft-equivalent ok))))))
    (let line2 (str_concat "bad-status=" (str_concat (lg-soft-status bad) (str_concat " bad-equivalent=" (int_to_str (lg-soft-equivalent bad))))))
    (let line3 (str_concat "silent-status=" (lg-soft-status silent)))
    (let line4 (str_concat "live-status=" (str_concat (nth live 4) (str_concat " live-eval=" (str_concat (nth live 3) (str_concat " soft-wins=" (int_to_str (ll-wins (nth live 1) 2))))))))
    (str_concat line1 (str_concat "\n" (str_concat line2 (str_concat "\n" (str_concat line3 (str_concat "\n" line4)))))))
