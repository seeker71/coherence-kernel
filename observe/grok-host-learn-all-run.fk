; preflight-exec: forbidden
; Retain every pair json in a directory, then drain the learner.
; stdin: pair-dir then home, two lines. Defaults: .hearth/grok-host-pairs and
; .hearth/grok-host-learn. Stdout: counts only. Never prompt/completion.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/json.fk
; preludes: form-stdlib/native-session-memory.bml
; preludes: form-stdlib/grok-host-learn.fk
(do
    (let pair-dir-in (read_line))
    (let home-in (read_line))
    (let pair-dir (if (or (nothing? pair-dir-in) (eq (str_len (trim pair-dir-in)) 0))
        ".hearth/grok-host-pairs" (trim pair-dir-in)))
    (let home (if (or (nothing? home-in) (eq (str_len (trim home-in)) 0))
        ".hearth/grok-host-learn" (trim home-in)))
    (fs-mkdir ".hearth")
    (fs-mkdir home)
    (let rows (ghl-record-dir home pair-dir))
    (let pending-before (len (nsm-pending home (nsm-dirs home))))
    (let settled (ghl-embody home))
    (print (list "schema" "grok-host-learn-all-v1"
        "can" (ghl-can)
        "pairs" (len rows)
        "pending-before-drain" pending-before
        "pending-after" (len (nsm-pending home (nsm-dirs home)))
        "worker" (nsm-worker-state home)
        "prose-stdout" 0))
    (len rows))
