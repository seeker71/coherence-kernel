// One original task prompt. The native planner owns source and contract discovery.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-task.bml;
section [form.bml] {
 let input=cell_input();
 value_kind(input) == "string" || value_kind(input) == "node_id" ? fct-command(input) : {
  let line=read_line() ?? "";
  let request=faj-valid(line) ? parse-json("native-task-request",line) : line;
  fct-render(fct-command(request));
 };
}
