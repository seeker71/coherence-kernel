; process-field-live.fk — the live census of the body's own process field:
; sister fkwu processes (with the cell each carries), agent shells and python,
; CPU hogs anywhere on the host, zombies with the parent that owes the reap,
; wait edges, system-wide GPU pressure, and the presence noticeboard — live
; residences, ghosts of dead ones, and unannounced siblings.
;
; stdin line 1 (optional): presence directory ("" -> /tmp/form-field).
;
; Host observation is the narrow job where host-exec serves rather than
; recursively outsourcing Form reasoning (the form-host-membrane-census
; teaching); every crossing is enclosed by form-membrane-runtime-census, so
; the observer names its own local-process crossings. Privacy stance: command
; arguments are retained ONLY for fkwu rows (repo-local cells, the
; coordination fact agents need); every other process is named by executable
; and numbers alone. GPU utilization is read system-wide from IOAccelerator's
; PerformanceStatistics — the read this fkwu's own metal_status cannot make
; about other processes; when the host offers no such row, the line says
; pending rather than zero.
;
; Effectful (read-only host census); fkwu host-io door. The pure
; classification underneath is four-way proven by
; form-stdlib/tests/process-field-band.fk.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/str-byte-at.fk
; preludes: form-stdlib/process-field.fk
; preludes: observe/form-membrane-runtime-census.fk

(do
    (defn pfl-here () "observe/process-field-live.fk")
    (defn pfl-field-command ()
        "ps -axwwo pid=,ppid=,stat=,pcpu=,comm= | awk '{pid=$1; ppid=$2; stat=$3; cpu=$4; line=$0; sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/,\"\",line); comm=line; base=comm; sub(/^.*\\//,\"\",base); row[pid]=pid\"|\"ppid\"|\"stat\"|\"cpu\"|\"comm\"|\"; par[pid]=ppid; keep=(base==\"fkwu\"||base==\"bash\"||base==\"zsh\"||base==\"sh\"||base==\"python\"||base==\"python3\"||cpu+0>=25||stat~/^Z/); if(keep)k[pid]=1} END{for(p in k){print row[p]; pp=par[p]; if((pp in row)&&!(pp in k))x[pp]=1} for(p in x)if(!(p in k))print row[p]}'")
    (defn pfl-cells-command ()
        "ps -axwwo pid=,args= | awk '{pid=$1; line=$0; sub(/^[[:space:]]*[0-9]+[[:space:]]+/,\"\",line); if(line ~ /(^|\\/)fkwu( |$)/) print pid\"|\"line}'")
    (defn pfl-gpu-command ()
        "ioreg -rc IOAccelerator -d 1 | awk '/\"PerformanceStatistics\" =/ {if(match($0,/\"Device Utilization %\"=[0-9]+/)){s=substr($0,RSTART,RLENGTH);sub(/^.*=/,\"\",s);d=s} if(match($0,/\"Renderer Utilization %\"=[0-9]+/)){s=substr($0,RSTART,RLENGTH);sub(/^.*=/,\"\",s);r=s} if(match($0,/\"Tiler Utilization %\"=[0-9]+/)){s=substr($0,RSTART,RLENGTH);sub(/^.*=/,\"\",s);t=s} print \"gpu|device=\"d\"|renderer=\"r\"|tiler=\"t; exit}'")
    (defn pfl-presence-command (dir)
        (str_concat "cat " (str_concat dir "/*.presence 2>/dev/null; true")))

    ; one read-only crossing, membrane-enclosed -> (output closed-window)
    (defn pfl-observe (trace purpose command line)
        (do (let window (fmrc-open trace purpose (pfl-here) line 1))
            (let output (host-exec command ""))
            (let closed (fmrc-close window "observed" (pfl-here) (add line 1) 1))
            (list output closed)))
    (defn pfl-output (result) (nth result 0))
    (defn pfl-crossings (result)
        (fmrc-delta-plane-total
            (fmrc-result-deltas (nth result 1)) "local-process"))

    ; ── printing ───────────────────────────────────────────────────────────
    (defn pfl-cell-pairs-go (text from acc)
        (if (ge from (str_len text)) acc
            (do (let end (fpf-line-end text from))
                (let line (substring text from end))
                (let bar (str_find line "|" 0))
                (pfl-cell-pairs-go text (add end 1)
                    (if (lt bar 0) acc
                        (append acc (list (list
                            (str_to_int (substring line 0 bar))
                            (substring line (add bar 1)
                                (str_len line))))))))))
    (defn pfl-cell-of (pairs pid)
        (if (eq (len pairs) 0) ""
            (if (eq (nth (head pairs) 0) pid) (nth (head pairs) 1)
                (pfl-cell-of (tail pairs) pid))))

    (defn pfl-print-fkwu (rows pairs self)
        (if (eq (len rows) 0) 0
            (do (let r (head rows))
                (print "fkwu pid=" (fpf-row-pid r) " ppid=" (fpf-row-ppid r)
                    " stat=" (fpf-row-stat r) " cpu-tenths=" (fpf-row-cpu r)
                    " cell=" (pfl-cell-of pairs (fpf-row-pid r))
                    (if (eq (fpf-row-pid r) self) "  <- this census" ""))
                (pfl-print-fkwu (tail rows) pairs self))))
    (defn pfl-print-owed (owed)
        (if (eq (len owed) 0) 0
            (do (let z (head owed))
                (print "zombie pid=" (nth z 0) " comm=" (nth z 1)
                    " reap-owed-by=" (nth z 2) " (" (nth z 3) ")")
                (pfl-print-owed (tail owed)))))
    (defn pfl-print-hogs (hogs)
        (if (eq (len hogs) 0) 0
            (do (let r (head hogs))
                (print "hog pid=" (fpf-row-pid r) " comm=" (fpf-row-comm r)
                    " cpu-tenths=" (fpf-row-cpu r))
                (pfl-print-hogs (tail hogs)))))
    (defn pfl-print-edges (edges)
        (if (eq (len edges) 0) 0
            (do (let e (head edges))
                (print "wait " (nth e 0) " (" (nth e 1) ") -> " (nth e 2)
                    " (" (nth e 3) ") " (nth e 4))
                (pfl-print-edges (tail edges)))))
    (defn pfl-print-live (frames)
        (if (eq (len frames) 0) 0
            (do (let f (head frames))
                (print "presence pid=" (fpf-presence-pid f) " role="
                    (fpf-presence-field f "role") " task="
                    (fpf-presence-field f "task") " bell="
                    (fpf-presence-field f "bell"))
                (pfl-print-live (tail frames)))))
    (defn pfl-print-ghosts (frames)
        (if (eq (len frames) 0) 0
            (do (let f (head frames))
                (print "ghost pid=" (fpf-presence-pid f) " role="
                    (fpf-presence-field f "role")
                    " (sweepable: observe/process-field-sweep.fk)")
                (pfl-print-ghosts (tail frames)))))
    (defn pfl-print-pids (name pids)
        (if (eq (len pids) 0) 0
            (do (print name " pid=" (head pids))
                (pfl-print-pids name (tail pids)))))

    (defn pfl-trim (s)
        (if (eq (str_len s) 0) s
            (if (eq (str-byte-at s (sub (str_len s) 1)) 10)
                (substring s 0 (sub (str_len s) 1)) s)))

    (let dir-line (read_line))
    (let dir (if (or (nothing? dir-line) (str_eq dir-line ""))
        "/tmp/form-field" dir-line))
    (let self-read (pfl-observe "self-pid" "own-pid-through-host-shell-parent"
        "echo $PPID" 44))
    (let self (str_to_int (pfl-trim (pfl-output self-read))))
    (let field (pfl-observe "process-field"
        "read-only-process-field-census" (pfl-field-command) 33))
    (let cells (pfl-observe "fkwu-cells" "read-only-fkwu-argument-census"
        (pfl-cells-command) 36))
    (let gpu (pfl-observe "gpu-pressure" "read-only-accelerator-utilization"
        (pfl-gpu-command) 38))
    (let presence (pfl-observe "presence-board"
        "read-only-presence-noticeboard" (pfl-presence-command dir) 40))

    (let rows (fpf-rows (pfl-output field)))
    (let pairs (pfl-cell-pairs-go (pfl-output cells) 0 (list)))
    (let frames (fpf-presences (pfl-output presence)))
    (let counts (fpf-census rows))

    (print "process-field self-pid=" self " field-dir=" dir)
    (pfl-print-fkwu (fpf-of-kind rows "fkwu") pairs self)
    (pfl-print-owed (fpf-reap-owed rows))
    (pfl-print-hogs (fpf-hogs rows))
    (pfl-print-edges (fpf-wait-edges rows))
    (if (eq (str_len (pfl-output gpu)) 0)
        (print "gpu witness pending on this host (no IOAccelerator "
            "PerformanceStatistics row)\n")
        (print_str (pfl-output gpu)))
    (pfl-print-live (fpf-live-presences frames rows))
    (pfl-print-ghosts (fpf-ghosts frames rows))
    (pfl-print-pids "unannounced-fkwu" (fpf-unannounced rows frames self))
    (print "counts fkwu=" (nth counts 0) " shells=" (nth counts 1)
        " python=" (nth counts 2) " zombies=" (nth counts 3)
        " hogs=" (nth counts 4))
    (print "observer-local-process-crossings="
        (add (pfl-crossings self-read)
        (add (pfl-crossings field)
        (add (pfl-crossings cells)
        (add (pfl-crossings gpu) (pfl-crossings presence))))))
    0)
