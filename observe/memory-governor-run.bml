// memory-governor-run.bml — how much RAM the machine can give right now, and whether a heavy open may take more.
//
//   ./fkwu observe/memory-governor-run.bml </dev/null                       the machine's reading, one line
//   echo '{"need_gib":40,"who":"walk"}' | ./fkwu observe/memory-governor-run.bml
//   echo '{"need_gib":40,"who":"walk","wait_ms":600000}' | ./fkwu observe/memory-governor-run.bml
//
// stdin, optional, one JSON line: need_gib (what the caller is about to take; a model's weights plus its KV margin),
// who (named in the line), wait_ms (ask again with growing naps for this long before answering held; 0 or absent
// asks once). It prints the machine's reading (mg-status-line) and, when a need is named, the verdict: a line
// that starts "[memory] granted" or "[memory] held". A caller that is a shell reads that line (grep -c
// "^\[memory\] granted"); a caller in Form calls mg-ask / mg-wait of form-stdlib/bml/memory-governor.bml itself.
// The reading is the machine's, not this process's: see memory-governor.bml for what it counts and why.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml
section [form.bml] {
 class MemoryGovernorRun {
  def mgr-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def mgr-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def mgr-options() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("memory-options", line) : json-node-object([]);
  }
  def mgr-run() {
   let opts = mgr-options();
   let said = print_str(mg-status-line(mg-sense()));
   let need = mgr-int(opts, "need_gib", 0) * mg-gib();
   let who = mgr-text(opts, "who", "caller");
   let wait = mgr-int(opts, "wait_ms", 0);
   need > 0 ? print_str(mg-line(who, need, wait > 0 ? mg-wait(who, need, host_monotonic_ms() + wait) : mg-ask(need))) : 0;
  }
 }
 mgr-run();
}
