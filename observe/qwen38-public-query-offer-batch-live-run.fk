; qwen38-public-query-offer-batch-live-run.fk -- dormant local RAG school.
;
; One answer-free source-bound query offer for each public Form family is
; generated by the local Qwen body.  The exact live-cursor context need is
; measured before the model opens and scheduled largest-first, so one weights
; residence can serve the batch when the observed ceiling permits it.  Every
; generation still owns a fresh stream state and must release that state.
;
; The query offer contains no expected answer.  Raw generated bytes are sealed
; before the public scoring row exposes its answer.  Every resulting row is
; supervised-rag credit and exactly zero canonical-heldout credit.
;
; Running this file without the plan-bound action token only prints the token;
; it does not touch the model or crystal.  To make the physical observation,
; place that exact value in .form-knowledge-public-query-offer-batch-consent
; and run this cell once.
;
; preludes: form-stdlib/form-knowledge-public-query-offer-batch.fk
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn fkpqol-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkpqol-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit")
    (defn fkpqol-action-path ()
        ".form-knowledge-public-query-offer-batch-consent")
    (defn fkpqol-action-token ()
        (str_concat "run-local-qwen-public-query-offer-batch-v1:"
            (str_concat (fkpqo-plan-sha)
                (str_concat ":model="
                    (str_concat (fkpqol-model-id)
                        (str_concat ":families="
                            (int_to_str (fkpqo-family-total))))))))
    (defn fkpqol-action-bound? ()
        (do
            (let supplied (read_file (fkpqol-action-path)))
            (if (str_eq supplied (fkpqol-action-token)) 1
                (if (str_eq supplied
                        (str_concat (fkpqol-action-token) "\n")) 1 0))))

    ; This mirrors fcmg-fresh-at-budgeted-hinted for the exact effective
    ; prompt.  A current qtf2 crystal yields a segment upper bound without
    ; creating a whole prompt token list; scanner encoding remains recovery.
    (defn fkpqol-context-need (path src crystal offer)
        (do
            (let prompt (fqt-bound-source-knowledge-prompt
                (fkpqo-rehearsal-prompt offer)))
            (let thoughts (lg-think-all prompt))
            (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
            (let thought-n (fcmg-id-count thought-lists 0))
            (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
            (let gap-total (mul gap-n
                (if (gt (len thoughts) 1) (sub (len thoughts) 1) 0)))
            (let iced (if (eq (nth crystal 0) 1) 1 0))
            (let segments (if (eq iced 1)
                (fcmg-chat-segments-profile prompt "knowledge-query" crystal)
                (empty)))
            (let cursor (if (eq iced 1)
                (fcmg-chat-cursor-profile path prompt "knowledge-query" crystal)
                (qtlc-open-index
                    (list "absent" "crystal-absent" "" 0 0 0 0 0 0 0)
                    (empty))))
            (let live-cursor (if (str_eq (qtlc-status cursor) "open") 1 0))
            (let ids (if (eq live-cursor 1) (empty)
                (fcmg-chat-ids-profile src prompt "knowledge-query")))
            (let prompt-bound (if (eq live-cursor 1)
                (qtlc-segments-upper-bound segments 0) (len ids)))
            (fcmg-context-need prompt-bound thought-n gap-total 0
                (fcmg-current-source-query-budget)
                (fcmg-current-source-answer-reserve))))

    (defn fkpqol-schedule-loop (offers path src crystal acc)
        (if (eq (len offers) 0)
            (fkpqo-schedule-sort acc (list))
            (do
                (let offer (head offers))
                (let item (fkpqo-scheduled offer
                    (fkpqol-context-need path src crystal offer)))
                (fkpqol-schedule-loop (tail offers) path src crystal
                    (cons item acc)))))

    (defn fkpqol-same-residence? (before after)
        (if (not (eq (fcmr-live? after) 1)) 0
            (if (eq (fcmr-live? before) 0) 1
                (fkpfm-equal? before after))))
    (defn fkpqol-open-delta (before after)
        (if (and (eq (fcmr-live? before) 0)
                 (eq (fcmr-live? after) 1)) 1 0))
    (defn fkpqol-reopen-delta (before after)
        (if (and (eq (fcmr-live? before) 1)
                 (eq (fcmr-live? after) 1))
            (if (eq (fkpfm-equal? before after) 1) 0 1)
            (if (and (eq (fcmr-live? before) 1)
                     (eq (fcmr-live? after) 0)) 1 0)))
    (defn fkpqol-generation-executed? (raw)
        (if (and (gt (fkpqo-report-int raw "generated_tokens") 0)
                 (gt (fkpqo-report-int raw "forward_passes") 0)) 1 0))
    (defn fkpqol-progress (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))

    ; loop = tag reversed-observations residence opens reopens
    (defn fkpqol-loop-result (observations residence opens reopens)
        (list "public-query-offer-live-loop-v1" observations residence
              opens reopens))
    (defn fkpqol-loop
        (scheduled residence path model-id plan-sha run-id residence-id
         observations opens reopens)
        (if (eq (len scheduled) 0)
            (fkpqol-loop-result observations residence opens reopens)
            (do
                (let offer (fkpqo-scheduled-offer (head scheduled)))
                (let _start (fkpqol-progress "family-start"
                    (fkpqo-offer-family offer)))
                (let before-ms (now_unix_ms))
                ; No expected answer is reachable on this side of the call.
                (let generated (fcmg-generate-current-source-resident-at
                    residence path (fkpqo-rehearsal-prompt offer)
                    (fkpqo-offer-path offer)))
                (let after-ms (now_unix_ms))
                (let raw (nth generated 0))
                (let next-residence (nth generated 1))
                ; Seal the physical bytes before fkpqo-observation reaches the
                ; scoring row.  That constructor retains raw and its digest.
                (let raw-sha (nmfe-sha256 raw))
                (let same-residence
                    (fkpqol-same-residence? residence next-residence))
                (let observation (fkpqo-observation offer plan-sha run-id
                    model-id residence-id raw same-residence 1 0
                    (fkpqol-generation-executed? raw)
                    (sub after-ms before-ms)))
                (let _done (fkpqol-progress "family-done"
                    (fkpqo-offer-family offer)))
                (let _raw (fkpqol-progress "family-raw-sha256" raw-sha))
                (let _transport (fkpqol-progress "family-transport"
                    (if (nothing? observation) "0"
                        (int_to_str (fkpqo-obs-transport observation)))))
                (let _answer (fkpqol-progress "family-answer95"
                    (if (nothing? observation) "0"
                        (int_to_str (fkpqo-obs-answer95 observation)))))
                (fkpqol-loop (tail scheduled) next-residence path model-id
                    plan-sha run-id residence-id
                    (cons observation observations)
                    (add opens (fkpqol-open-delta residence next-residence))
                    (add reopens
                        (fkpqol-reopen-delta residence next-residence))))))

    (defn fkpqol-run-live ()
        (do
            (let path (fkpqol-model-path))
            (let model-id (fkpqol-model-id))
            (let plan-sha (fkpqo-plan-sha))
            (let offers (fkpqo-offers))
            (let src (fcmg-src path))
            ; Freeze is local qtf2 preparation, never a model open or tokenizer
            ; pre-step.  If it cannot sit, the exact scanner recovery lane is
            ; reflected in each context need and in the physical report.
            (let crystal0 (qsx-load path))
            (let crystal (if (eq (nth crystal0 0) 1) crystal0
                (do (let _heat (qsx-freeze path)) (qsx-load path))))
            (let scheduled
                (fkpqol-schedule-loop offers path src crystal (list)))
            (let run-id (nmfe-sha256 (nmfe-fields
                (list "public-query-offer-local-run-v1" plan-sha model-id
                      (int_to_str (now_unix_ms))))))
            (let residence-id (nmfe-sha256 (nmfe-fields
                (list "public-query-offer-residence-v1" plan-sha run-id
                      model-id))))
            (let looped (fkpqol-loop scheduled (fcmr-none) path model-id
                plan-sha run-id residence-id (list) 0 0))
            (let observations (nmfe-reverse (nth looped 1)))
            (let residence (nth looped 2))
            (let release-ok (fcmr-release-ok? residence))
            (let result (fkpqo-finalize observations (nth looped 3)
                (nth looped 4) release-ok))
            (fkpqol-progress "plan-sha256" plan-sha)
            (fkpqol-progress "run-id" run-id)
            (fkpqol-progress "residence-id" residence-id)
            (fkpqol-progress "opens" (int_to_str (nth looped 3)))
            (fkpqol-progress "reopens" (int_to_str (nth looped 4)))
            (fkpqol-progress "release-ok" (int_to_str release-ok))
            (fkpqol-progress "complete"
                (if (nothing? result) "0"
                    (int_to_str (fkpqo-result-complete result))))
            (fkpqol-progress "ready"
                (if (nothing? result) "0"
                    (int_to_str (fkpqo-result-ready result))))
            (print result)
            0))

    (if (eq (fkpqol-action-bound?) 1)
        (fkpqol-run-live)
        (do
            (print_str "local-Qwen public query-offer batch is dormant; run-bound action token absent\n")
            (print_str (str_concat "required-token="
                (str_concat (fkpqol-action-token) "\n")))
            0)))
