// preflight-exec: forbidden
// Two real native fitting rounds; shared serving adapters remain unchanged.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-heal-learning.bml
section [form.bml] {
 class HealNativeLearningWitness {
  def hnl-round(job, stage, observation) {
   let input = fhn-stage-path(job, stage, ".request");
   let wrote = write_file(input, fh-cat(list(job, "\n", stage, "\n", fhl-row(stage, "observed-transport-verification", observation), "\n")));
   fhn-run(job, stage, 0, "root", input, list("./fkwu", "observe/form-cli-heal-native-learning-run.bml"));
  }
  def hnl-main() {
   let root = fhn-root();
   let job = fhn-unique(fhn-at(root, ".form-heal"), "learning-native-witness-", 0);
   let snapshot = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let notice = print_str(str_concat("evidence=", str_concat(job, "\n")));
   let first = hnl-round(job, "native-learning-one", "The native process witness passed exit capture, timeout, dynamic continuation, cancellation, and private-output separation.");
   let second = hnl-round(job, "native-learning-two", "The native source witness passed snapshot identity, changed-checker detection, restoration, stale-live-input refusal, candidate-race refusal, and guarded replacement.");
   let rows = fhn-json-rows(split-on(fhn-read(fhn-at(job, "learning.jsonl")), "\n"));
   let report = print_str(fhn-report(job));
   let complete = if not(eq(len(rows), 2)) then 0 else and(str_eq(fhn-string(head(rows), "state"), "candidate-updated"), and(str_eq(fhn-string(nth(rows, 1), "state"), "candidate-updated"), str_eq(fhn-string(head(rows), "sha256"), fhn-string(nth(rows, 1), "parent_sha256"))));
   list("native-learning-witness", first, second, complete);
  }
 }
 hnl-main();
}
