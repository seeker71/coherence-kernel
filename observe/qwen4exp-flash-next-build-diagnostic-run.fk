; qwen4exp-flash-next-build-diagnostic-run.fk — bounded causal exchanges for
; the build surprises that changed the native qwen4exp path.
;
; No prompt or answer content enters the framebuffer.  Payloads are stable
; stage codes; each correlated revise action is checked against the changed
; source and followed by a second outbound observation.
;
; preludes: form/form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn q4bd-has (path needle)
        (if (ge (str_find (read_file path) needle 0) 0) 1 0))
    (defn q4bd-apply (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound) (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    ; exchange = [before-code, applied, after-source-witness, event-delta].
    (defn q4bd-exchange (exchange before-code after-code after-source-witness)
        (do
            (let n0 (len (framebuffer-events)))
            (let outbound (bfc-envelope 0 exchange 0 before-code after-code))
            (let out-event (bfc-record-out outbound (mul exchange 2)))
            (let inbound (bfc-control outbound 2))
            (let in-event (bfc-record-in inbound (add (mul exchange 2) 1)))
            (let applied (q4bd-apply outbound inbound before-code after-code))
            (let reobserved (if (eq applied after-code) after-source-witness 0))
            (let outbound2 (bfc-envelope 0 (add exchange 100) 0 reobserved 0))
            (let out-event2 (bfc-record-out outbound2 (mul (add exchange 100) 2)))
            (let inbound2 (bfc-control outbound2 0))
            (let in-event2 (bfc-record-in inbound2 (add (mul (add exchange 100) 2) 1)))
            (list before-code applied reobserved
                  (sub (len (framebuffer-events)) n0))))

    ; 2001: GGML type 20 was wrongly read as IQ4_XS; revised to IQ4_NL.
    (let iq4 (q4bd-exchange 83101 2001 2002
        (q4bd-has "form/form-stdlib/gguf-manifest.fk"
            "(if (eq t 20) (gm-blk n 32 18)")))
    ; 2101: layer 8 expert 490 crossed a short type-20 mapping; revised bytes
    ; now price all 32-value/18-byte blocks and name type 23 separately.
    (let mapping (q4bd-exchange 83102 2101 2102
        (q4bd-has "form/form-stdlib/gguf-manifest.fk"
            "(if (eq t 23) (gm-blk n 256 136)")))
    ; 2201: cooperative head barriers were refused in a serial batch; revised
    ; scheduler opens a bounded concurrent batch after layer completion.
    (let barrier (q4bd-exchange 83103 2201 2202
        (q4bd-has "form/native/metal/qwen4exp-flash-next-token-handle.fk"
            "(metal_batch_concurrent)")))
    ; 2301: a single-expression BML body was refused; revised to `= expr`.
    (let bml (q4bd-exchange 83104 2301 2302
        (q4bd-has "form/form-stdlib/native-model-side-by-side.bml"
            "def nmss-print-report() = print_str(nmss-report());")))
    ; 2401: block-valued else-if was refused by BML; named append/miss
    ; actuators now leave the choice as one total expression.
    (let state-bml (q4bd-exchange 83105 2401 2402
        (q4bd-has "form/form-stdlib/qwen4exp-flash-next-state.bml"
            "else if str_eq(status, \"append\") then q4s-evaluate-append(slot, lookup)")))
    ; 2501: the first optimized Q5_K transcription was numerically wrong;
    ; the differential observer forced a simpler four-row quant-block lane.
    (let q5 (q4bd-exchange 83106 2501 2502
        (q4bd-has "form/form-stdlib/qk-matvec-lane.fk"
            "uint r0=(gid/32u)*4u")))
    ; 2601: cancelling the router's full-softmax normalization changed the
    ; second greedy token; the parity boundary restored index-order softmax.
    (let route (q4bd-exchange 83107 2601 2602
        (q4bd-has "form/native/metal/qwen4exp-flash-next-graph-jit.fk"
            "for(uint i=0u;i<ne;++i)s+=p[i]")))
    ; 2701: ten expert ranks caused fifty launches per layer; one all-rank
    ; quantized batch now carries each of the three expert projections.
    (let experts (q4bd-exchange 83108 2701 2702
        (q4bd-has "form/native/metal/qwen4exp-flash-next-token-handle.fk"
            "(defn q4t-experts-batch")))
    ; 2801: omitting the full head changed 271 to 353.  The differential
    ; retained only the five-dispatch head mixer and restored parity while the
    ; vocabulary projection remained absent from non-final prompt tokens.
    (let prefill (q4bd-exchange 83109 2801 2802
        (q4bd-has "form/native/metal/qwen4exp-flash-next-token-handle.fk"
            "live differential showed that its scratch image")))
    (list iq4 mapping barrier bml state-bml q5 route experts prefill
        (if (and (eq (nth iq4 2) 1)
                 (and (eq (nth mapping 2) 1)
                      (and (eq (nth barrier 2) 1)
                           (and (eq (nth bml 2) 1)
                                (and (eq (nth state-bml 2) 1)
                                     (and (eq (nth q5 2) 1)
                                          (and (eq (nth route 2) 1)
                                               (and (eq (nth experts 2) 1)
                                                    (eq (nth prefill 2) 1))))))))) 511 0)))
