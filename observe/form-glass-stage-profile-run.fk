; form-glass-stage-profile-run.fk — bounded per-stage physical Glass cost.
;
; This constructs one real frame through the same collectors as Glass.  It
; emits only stage durations and cardinalities; no synthetic samples enter.
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let frame 0)
    (let epoch (now_unix_ms))
    (let t0 (now_unix_ms))
    (let hostRows (fgl-host-rows frame (list)))
    (let t1 (now_unix_ms))
    (let queueRows (fgl-queue-rows frame (list)))
    (let t2 (now_unix_ms))
    (let storageRows (fgl-storage-rows frame (list)))
    (let t3 (now_unix_ms))
    (let heatRows (fgl-heat-rows frame (list)))
    (let t4 (now_unix_ms))
    (let fastRows (fgl-fast-rows frame (list) heatRows))
    (let t5 (now_unix_ms))
    (let metrics (append fastRows (append hostRows (append queueRows storageRows))))
    (let governorRefresh (fgl-refresh-governor frame))
    (let t6 (now_unix_ms))
    (let inventory (fgtm-inventory (FGLRoot)))
    (let externalSamples (fgl-external-samples (fgl-inventory-samples-at inventory epoch)))
    (let samples (fgl-local-samples externalSamples epoch))
    (let publishers (fgl-external-publishers (fgl-inventory-publishers inventory)))
    (let t7 (now_unix_ms))
    (let observations (fgl-v2-observations epoch frame))
    (let t8 (now_unix_ms))
    (let point (fgl-flow-point-current-full epoch metrics observations samples))
    (let history (list point))
    (let control (fgl-control-start-state (fgtm-read-control-ack (FGLRoot) (FGLControlChannel))))
    (let t9 (now_unix_ms))
    (let width (fgl-terminal-width))
    (let t10 (now_unix_ms))
    (let height (fgl-terminal-height))
    (let t11 (now_unix_ms))
    (let glassFrame (fgl-dashboard-frame width height epoch (FGLQuietHz) frame control metrics samples publishers history observations))
    (let t12 (now_unix_ms))
    (list "form-glass-stage-profile-v1"
          "epoch" epoch "width" width "height" height
          "host-ms" (sub t1 t0) "host-rows" (len hostRows)
          "queue-ms" (sub t2 t1) "queue-rows" (len queueRows)
          "storage-ms" (sub t3 t2) "storage-rows" (len storageRows)
          "heat-ms" (sub t4 t3) "heat-rows" (len heatRows)
          "fast-ms" (sub t5 t4) "fast-rows" (len fastRows)
          "governor-ms" (sub t6 t5)
          "inventory-ms" (sub t7 t6) "samples" (len samples) "publishers" (len publishers)
          "observations-ms" (sub t8 t7) "observations" (len observations)
          "flow-control-ms" (sub t9 t8)
          "width-ms" (sub t10 t9) "height-ms" (sub t11 t10)
          "render-build-ms" (sub t12 t11) "segments" (len (fgd-segment-frame-lines glassFrame))
          "total-ms" (sub t12 t0)))
