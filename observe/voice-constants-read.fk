; voice-constants-read.fk — every scalar an exported voice folded into a constant, read by the body.
;
; A pass must not TYPE IN an epsilon, a tail bound or a 1/sqrt(d): the export wrote each of them
; into the file as its own float, and the number that ships is the number that runs. This prints
; every initializer whose shape is a scalar or a short vector, so a hand can take the constants
; from the model instead of from a paper.
; preludes: form/form-stdlib/voice-native.bml
(do
    (defn vk-default () "en_GB-jenny_dioco-medium")
    (defn vk-voice ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vk-default) (if (eq (str_len (trim t)) 0) (vk-default) (trim t)))))
    (defn vk-n (r) (vo-count (vo-dims r)))
    (defn vk-text (p r)
        (if (eq (vo-dtype r) 1)
            (vo-floats-text (vo-floats p r 0 (vk-n r)))
            (if (eq (vo-dtype r) 7) (vo-dims-text (vo-i64s p r 0 (vk-n r))) "?")))
    (defn vk-go (p rows)
        (if (eq (len rows) 0) 0
            (do (if (le (vk-n (head rows)) 8)
                    (print (str_concat (vo-name (head rows))
                            (str_concat "  [" (str_concat (vo-dtype-name (vo-dtype (head rows)))
                            (str_concat " " (str_concat (int_to_str (vk-n (head rows)))
                            (str_concat "]  " (vk-text p (head rows)))))))))
                    0)
                (vk-go p (tail rows)))))
    (let p (vp-model-path (vk-voice)))
    (vk-go p (vo-table p))
    0)
