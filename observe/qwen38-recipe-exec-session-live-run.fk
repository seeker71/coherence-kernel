; qwen38-recipe-exec-session-live-run.fk — a local model requests a NodeID
; micro-thought, Form generates and runs Metal at the closing byte, injects the
; typed observation, and the same resident Qwen stream continues.
;
; Effectful: run only while no sibling owns the local Qwen/Metal carrier.
; The prompt is local and synthetic. Model, Form, and injected bytes are printed
; in separate lanes. No private payload enters framebuffer telemetry.
; Do not preflight this driver: preflight's fresh fkwu probe reaches top-level
; effects on this lane. Preflight the mechanism and its pure band instead, then
; run this driver once intentionally when the carrier is free.
;
; preludes: form-stdlib/form-cli-recipe-exec-session.fk form-stdlib/model-registry.bml

(do
    (defn qres-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn qres-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn qres-int (name value) (qres-line name (int_to_str value)))
    (defn qres-prompt ()
        (do
            (let surface (frex-surface (frex-recipe) 5 "auto"))
            (str_concat
                "You are in one resident local Form execution session. "
            (str_concat
                "Recipe NodeID "
            (str_concat (frex-node-coordinate (frex-recipe))
            (str_concat
                " is a signed-i32 micro-thought y=(3*x)+7. Request its physical execution for input 5 by outputting exactly this one control frame, with no prose before it:\n"
            (str_concat surface
                "\nWhen Form returns a typed tool observation, do not request again. Read its value, carrier, observation-node and lifecycle fields, then answer one concise ASCII line beginning `observed ` followed by those facts.")))))))
    (defn qres-bit (ok bit) (if ok bit 0))

    (let started (now_unix_ms))
    (let opened (fcms-open (qres-path) (qres-prompt) 1024))
    (let open-ms (sub (now_unix_ms) started))
    (if (not (eq (fcms-live? opened) 1))
        (do
            (qres-line "status" (fcms-status opened))
            (qres-line "reason" (fcms-reason opened))
            (qres-int "open-ms" open-ms)
            0)
        (do
            (let moved (frxs-run opened 128))
            (let ended (now_unix_ms))
            (let s (frxs-session moved))
            (let c (frxs-cursor moved))
            (let result (frxc-result c))
            (qres-line "model-before" (frxs-before-text moved))
            (qres-line "form-injected" (frxs-injected-text moved))
            (qres-line "model-after" (frxs-after-text moved))
            (qres-int "open-ms" open-ms)
            (qres-int "movement-ms" (sub ended (add started open-ms)))
            (qres-int "prompt-ids" (fcms-prompt-ids s))
            (qres-int "model-before-ids" (len (frxs-before-ids moved)))
            (qres-int "model-after-ids" (len (frxs-after-ids moved)))
            (qres-int "model-bytes" (frxs-model-bytes moved))
            (qres-int "injected-ids" (fcms-injected-ids s))
            (qres-int "injected-bytes" (frxs-injected-bytes moved))
            (qres-int "observation-count" (fcms-observations s))
            (qres-int "callback-calls" (frxs-callback-calls moved))
            (qres-int "carrier-executed" (frxs-carrier-executed? moved))
            (qres-int "native-code-generated"
                (frxs-native-code-generated? moved))
            (qres-int "model-executed-form" (frxs-model-executed-form? moved))
            (qres-line "status" (frxc-status c))
            (qres-line "reason" (frxc-reason c))
            (qres-line "carrier" (frxc-carrier c))
            (qres-int "value-present" (frxc-value-present? c))
            (qres-int "value" (frxc-value c))
            (qres-line "lifecycle" (frex-trace-actions (frxc-trace c)))
            (qres-line "generated-id-policy" (fcms-generated-id-policy))
            (qres-line "resume-encode-scope" (fcms-resume-encode-scope))
            (let release-ok (fcms-release-ok? s))
            (qres-int "release-ok" release-ok)
            (sum (list
                (qres-bit (eq (frxs-crossed? moved) 1) 1)
                (qres-bit (eq (frxs-callback-calls moved) 1) 2)
                (qres-bit (str_eq (frxc-status c) "value") 4)
                (qres-bit (and (eq (frxc-value-present? c) 1)
                               (eq (frxc-value c) 22)) 8)
                (qres-bit (eq (frxs-carrier-executed? moved) 1) 16)
                (qres-bit (eq (frxs-native-code-generated? moved) 1) 32)
                (qres-bit (eq (frxs-model-executed-form? moved) 0) 64)
                (qres-bit (and (eq (fcms-observations s) 1)
                               (gt (fcms-injected-ids s) 0)) 128)
                (qres-bit (ge (str_find (frxs-before-text moved)
                    (frex-open) 0) 0) 256)
                (qres-bit (ge (str_find (frxs-after-text moved) "22" 0) 0) 512)
                (qres-bit (and (ge (str_find (fcms-generated-id-policy)
                                             "original" 0) 0)
                    (lt (str_find (fcms-generated-id-policy) "re-encode" 0) 0))
                    1024)
                (qres-bit (eq release-ok 1) 2048))))))
