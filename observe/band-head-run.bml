// band-head-run.bml — the door for observe/band-head.bml: each stdin line is one question of a band
// file or of the verdict manifest, and each is answered by one line, in order: one word, or an empty
// line when there is no answer, or `?` and the reason when the question is not one this door knows.
// One line in, one line out, so a sweep that has many questions asks them in one run.
//
// Run from anywhere (paths are read as given; a line is needed, stdin closed asks nothing):
//
//   printf 'level <band>\n'              | ./fkwu observe/band-head-run.bml   -> its PROOF LEVEL word
//   printf 'carrier <band>\n'            | ./fkwu observe/band-head-run.bml   -> its STAGED CARRIER path
//   printf 'door <band>\n'               | ./fkwu observe/band-head-run.bml   -> its STAGED CARRIER DOOR command
//   printf 'pin <band>\n'                | ./fkwu observe/band-head-run.bml   -> its head Verdict digits
//   printf 'row-name <manifest> <stem>\n' | ./fkwu observe/band-head-run.bml   -> the stem when the manifest names it
//   printf 'row-pin <manifest> <stem>\n'  | ./fkwu observe/band-head-run.bml   -> the stem's registered verdict
//
// preludes: observe/band-head.bml

section [form.bml] {
    def bhr-go(acc, first) {
        let l = read_line();
        nothing?(l) ? acc
        : (Comparable) first == 1 ? bhr-go(bh-line-answer(lx-strip-nl(l)), 0)
        : bhr-go(acc ++ "\n" ++ bh-line-answer(lx-strip-nl(l)), 0);
    }
    bhr-go("", 1);
}
