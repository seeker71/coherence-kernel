// band-head-run.bml — the door for observe/band-head.bml: one question of a band file or of the
// verdict manifest arrives as one stdin line, one word (or nothing) is answered.
//
// Run from anywhere (paths are read as given; stdin closed is not a question, so a line is needed):
//
//   printf 'level <band>\n'              | ./fkwu observe/band-head-run.bml   -> its PROOF LEVEL word
//   printf 'carrier <band>\n'            | ./fkwu observe/band-head-run.bml   -> its STAGED CARRIER path
//   printf 'door <band>\n'               | ./fkwu observe/band-head-run.bml   -> its STAGED CARRIER DOOR command
//   printf 'pin <band>\n'                | ./fkwu observe/band-head-run.bml   -> its head Verdict digits
//   printf 'row-name <manifest> <stem>\n' | ./fkwu observe/band-head-run.bml   -> the stem when the manifest names it
//   printf 'row-pin <manifest> <stem>\n'  | ./fkwu observe/band-head-run.bml   -> the stem's registered verdict
//
// preludes: observe/band-head.bml

section [form.bml] {
    def bhr-line() {
        let l = read_line();
        nothing?(l) ? "" : lx-strip-nl(l);
    }
    bh-line-answer(bhr-line());
}
