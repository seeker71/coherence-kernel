; voice-pass-stage-probe.fk — the pass with every stage's own reading, so a disagreement with the
; reference can be located rather than argued about. Shape, absolute sum and the first three values
; at each point in the chain; the timing beside them.
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-pass.bml
(do
    (defn vq-default () "en_GB-jenny_dioco-medium")
    (defn vq-voice ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vq-default) (if (eq (str_len (trim t)) 0) (vq-default) (trim t)))))
    (defn vq-ids () (list 1 0 41 0 59 0 3 0 15 0 120 0 52 0 17 0 74 0 119 0 3 0 74 0 38 0 3 0 24 0 120 0 62 0 122 0 26 0 74 0 44 0 3 0 32 0 59 0 3 0 31 0 28 0 120 0 21 0 122 0 23 0 10 0 2))
    ; a fold with an accumulator: the same sum written as a non-tail recursion walks a million
    ; frames of walker stack and hits the eval wall, which is the wall doing its job
    (defn vq-fabs-go (xs acc) (if (eq (len xs) 0) acc (vq-fabs-go (tail xs) (add acc (vv-abs (head xs))))))
    (defn vq-fabs (xs) (vq-fabs-go xs 0.0))
    ; and the reading is capped: a stage of half a million cells is sampled, not folded whole
    (defn vq-cap () 20000)
    (defn vq-look (t) (vv-read t 0 (if (gt (vv-tn t) (vq-cap)) (vq-cap) (vv-tn t))))
    (defn vq-ftext (xs) (if (eq (len xs) 0) "" (str_concat (float_to_str (head xs)) (str_concat (if (eq (len (tail xs)) 0) "" " ") (vq-ftext (tail xs))))))
    (defn vq-say (what t)
        (do (let sy (metal_sync))
            (print (str_concat what (str_concat "  " (str_concat (int_to_str (vv-tc t)) (str_concat "x" (str_concat (int_to_str (vv-tl t))
                (str_concat "  |sum| over first cells " (str_concat (float_to_str (vq-fabs (vq-look t)))
                (str_concat "  first " (vq-ftext (vv-read t 0 3)))))))))))
            t))

    (let path (vp-model-path (vq-voice)))
    (let ids (vq-ids))
    (let st (vv-open path))
    (print (str_concat "voice  " (vq-voice)))
    (print (str_concat "door   " (if (eq (vv-open-ok? st) 1) "open" (vv-open-why st))))
    (let enc (vv-enc st ids))
    (let e1 (vq-say "encoder x " (head enc)))
    (let e2 (vq-say "m_p      " (nth enc 1)))
    (let logw (vv-logw st (head enc)))
    (let durs (vv-durs logw 1.0))
    (let idx (vv-idx-go durs 0 (list)))
    (print (str_concat "frames    " (int_to_str (len idx))))
    (let zp (vv-take-rows st (nth enc 1) idx))
    (let e3 (vq-say "z_p      " zp))
    (let z (vv-flow st zp))
    (let e4 (vq-say "flow z   " z))
    (let pre (vv-conv st "/dec/conv_pre/Conv" z -1))
    (let e5 (vq-say "conv_pre " pre))
    (let s0 (vv-dec-stage st 0 (div (vv-nres st 0) (vv-nups st 0)) pre))
    (let e6 (vq-say "dec up 0 " s0))
    (let s1 (vv-dec-stage st 1 (div (vv-nres st 0) (vv-nups st 0)) s0))
    (let e7 (vq-say "dec up 1 " s1))
    (let o (vv-dec st z))
    (let e8 (vq-say "samples  " o))
    0)
