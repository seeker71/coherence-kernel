; process-field-sweep.fk — clear ghost presences from the field noticeboard.
;
; A presence file whose pid no longer answers ps is the residue of a residence
; that died without releasing (observe/process-field-live.fk names these
; ghosts). This door removes exactly those files — by the <pid>.presence
; naming convention the resident door writes — and keeps every live one.
; stdin line 1 (optional): presence directory ("" -> /tmp/form-field).
;
; Effectful (removes ghost files in the field directory only); fkwu host-io
; door. Ghost/live separation is four-way proven by
; form-stdlib/tests/process-field-band.fk.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/process-field.fk

(do
    (defn pfs-line (name value)
        (print_str (str_concat "process-field-sweep "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))

    ; membership in the newline-separated pid text, exact-token
    (defn pfs-listed? (pids-text pid)
        (if (ge (str_find pids-text
            (str_concat "\n" (str_concat (int_to_str pid) "\n")) 0) 0) 1 0))

    (defn pfs-walk (frames pids-text dir swept kept)
        (if (eq (len frames) 0) (list swept kept)
            (do (let pid (fpf-presence-pid (head frames)))
                (if (eq (pfs-listed? pids-text pid) 1)
                    (do (pfs-line "kept" (int_to_str pid))
                        (pfs-walk (tail frames) pids-text dir swept
                            (add kept 1)))
                    (do (host-exec (str_concat "rm -f " (str_concat dir
                            (str_concat "/" (str_concat (int_to_str pid)
                                ".presence")))) "")
                        (pfs-line "swept-ghost" (int_to_str pid))
                        (pfs-walk (tail frames) pids-text dir
                            (add swept 1) kept))))))

    (let dir-line (read_line))
    (let dir (if (or (nothing? dir-line) (str_eq dir-line ""))
        "/tmp/form-field" dir-line))
    (let frames (fpf-presences (host-exec
        (str_concat "cat " (str_concat dir "/*.presence 2>/dev/null; true"))
        "")))
    (let pids-text (str_concat "\n"
        (host-exec "ps -axo pid= | awk '{print $1}'" "")))
    (let result (pfs-walk frames pids-text dir 0 0))
    (pfs-line "swept" (int_to_str (nth result 0)))
    (pfs-line "kept" (int_to_str (nth result 1)))
    (nth result 0))
