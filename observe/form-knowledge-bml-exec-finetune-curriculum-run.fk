; Emits compact current corpus evidence without starting a model or carrier.
; preludes: form-stdlib/core.fk form-stdlib/json.fk
; preludes: form-stdlib/form-knowledge-bml-exec-finetune-curriculum.fk

(do
    (print_str (str_concat "train-rows="
        (str_concat (int_to_str (len (fkbef-train-rows))) "\n")))
    (print_str (str_concat "valid-rows="
        (str_concat (int_to_str (len (fkbef-valid-rows))) "\n")))
    (print_str (str_concat "test-rows="
        (str_concat (int_to_str (len (fkbef-test-rows))) "\n")))
    (print_str (str_concat "train-jsonl-bytes="
        (str_concat (int_to_str (str_len (fkbef-jsonl "train"))) "\n")))
    (print_str "supplied-api-composition-rows=12\n")
    (print_str "challenge-source-identifiers-admitted=0\n")
    (print_str "replay-heldout-credit=0\n")
    0)
