; review-panel.fk — the outside-review doors, as data the body can read.
;
; tools/review-panel.sh is the hand; this is the body knowing it has one.
; Before 2026-07-28 the body could not say which reviewers it could reach, so
; "get this reviewed" was an arrangement rather than a habit. A door named here
; is one that was MEASURED on the host, not one that ought to work.
;
; THE MISTAKE THAT MADE THIS CELL NECESSARY
;   Asked for a review, the prior turn grepped the REPOSITORY for API endpoints,
;   found none, and reported "no door exists". Four CLIs were installed on the
;   machine the whole time. The search was thorough inside the space it chose
;   and the space was the wrong one — and the conclusion was reported as a fact
;   about the world rather than a fact about where it had looked. That is why
;   every row below carries the measurement, not the expectation.
;
; THE DISCIPLINE
;   A reviewer is asked to READ and OPINE. cursor-agent is given --trust (so it
;   does not block on a prompt) and never --force or --yolo, which would let it
;   execute. Each door runs from a scratch directory holding only a copy of the
;   artifact, never from the repo, so a door that writes anyway writes nowhere
;   that matters. The artifact travels as TEXT inside the prompt: a reviewer
;   needs no filesystem reach to do the work asked of it.
;
; Proof: observe/tests/review-panel-band.fk — 511 on Go / Rust / TS / fkwu.
;
; preludes: form-stdlib/core.fk

(do
    ;; (name invocation state note) — state is "open" or "closed"
    (defn rp-door (name invocation state note) (list name invocation state note))
    (defn rp-name  (d) (nth d 0))
    (defn rp-inv   (d) (nth d 1))
    (defn rp-state (d) (nth d 2))
    (defn rp-note  (d) (nth d 3))

    ;; observed working 2026-07-28, each by running it. This list is the CLAIM;
    ;; ra-doors-match? in review-ask.fk is what tests it against the host.
    (defn rp-doors ()
        (list
        (rp-door "grok"   "grok -p <prompt>" "open"
                 "answered first try")
        (rp-door "claude" "claude -p <prompt>" "open"
                 "answered first try")
        (rp-door "codex"  "codex exec --skip-git-repo-check <prompt>" "open"
                 "needed three repairs: outside a git repo it refuses without --skip-git-repo-check; ~/.codex/models_cache.json was malformed (missing supports_reasoning_summaries) and was moved aside to regenerate; and v0.142.5 could not serve the configured gpt-5.6-sol, so codex update took it to 0.145.0")
        (rp-door "cursor" "cursor-agent -p --trust <prompt>" "open"
                 "needs --trust or it blocks on a workspace-trust prompt; --force and --yolo are refused here on purpose, a reviewer reads and opines")
        (rp-door "gemini" "none" "closed"
                 "the CLI is refused with IneligibleTierError (no longer supported for Gemini Code Assist for individuals), it was replaced by Antigravity, and /Applications/Antigravity.app ships no command line at all — no bin directory, no agent binary in the bundle. No headless Gemini on this host until GEMINI_API_KEY is set or Antigravity ships a CLI")))

    (defn rp-count () (len (rp-doors)))
    (defn rp-open? (d) (if (str_eq (rp-state d) "open") 1 0))
    (defn rp-open-loop (ds) (if (eq (len ds) 0) 0
        (add (rp-open? (head ds)) (rp-open-loop (tail ds)))))
    (defn rp-open-count () (rp-open-loop (rp-doors)))
    (defn rp-closed-count () (sub (rp-count) (rp-open-count)))

    ;; an open door names how to call it; a closed one names why it is shut.
    ;; Neither may be silent — a door with no note is a door nobody can act on.
    (defn rp-honest? (d)
        (if (eq (rp-open? d) 1)
            (if (gt (str_len (rp-inv d)) 8) 1 0)
            (if (gt (str_len (rp-note d)) 60) 1 0)))
    (defn rp-honest-loop (ds) (if (eq (len ds) 0) 1
        (if (eq (rp-honest? (head ds)) 1) (rp-honest-loop (tail ds)) 0)))
    (defn rp-all-honest? () (rp-honest-loop (rp-doors)))

    ;; every door carries a note, open or closed — the measurement, not a hope
    (defn rp-noted-loop (ds) (if (eq (len ds) 0) 1
        (if (gt (str_len (rp-note (head ds))) 0) (rp-noted-loop (tail ds)) 0)))
    (defn rp-all-noted? () (rp-noted-loop (rp-doors)))

    (defn rp-find-loop (ds n)
        (if (eq (len ds) 0) (list "" "" "" "")
            (if (str_eq (rp-name (head ds)) n) (head ds) (rp-find-loop (tail ds) n))))
    (defn rp-find (n) (rp-find-loop (rp-doors) n))
    (defn rp-is-open? (n) (rp-open? (rp-find n)))

    ;; a closed door is KEPT, never deleted — an absence that is not written down
    ;; stops being an absence and becomes a thing nobody remembers wanting
    (defn rp-closed-kept? () (if (eq (rp-is-open? "gemini") 0)
        (if (gt (str_len (rp-note (rp-find "gemini"))) 60) 1 0) 0))

    (defn rp-check ()
        (add (if (eq (rp-count) 5) 1 0)
        (add (if (eq (rp-open-count) 4) 2 0)
        (add (if (eq (rp-closed-count) 1) 4 0)
        (add (if (eq (rp-all-honest?) 1) 8 0)
        (add (if (eq (rp-all-noted?) 1) 16 0)
        (add (if (eq (rp-is-open? "grok") 1) 32 0)
        (add (if (eq (rp-is-open? "codex") 1) 64 0)
        (add (if (eq (rp-is-open? "gemini") 0) 128 0)
        (add (if (eq (rp-closed-kept?) 1) 256 0)
             0))))))))))

    0)
