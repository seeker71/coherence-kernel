; aware-glass-take-run.fk — a taker of the aware sensor's own frame.
;
; The glass takes every sensor the same way: ask the frame's sequence, re-read the
; cells only when it moved. This door does exactly that for publisher
; glass.sensor.aware and prints what came back, so the sensor's rows are proven
; READABLE by a taker before anyone wires them into the glass's roster. A sensor
; not standing is named absent, never silently empty.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-sensor-rows.bml
(do
    (defn agt-pad (s n) (if (ge (str_len s) n) s (agt-pad (str_concat s " ") n)))
    (defn agt-value (row) (if (str_eq (nth row 4) "text") (nth row 6) (int_to_str (nth row 5))))
    (defn agt-say (rows)
        (if (eq (len rows) 0) 0
            (do (let r (head rows))
                (print_str (str_concat "  " (str_concat (agt-pad (nth r 2) 24) (str_concat (agt-pad (agt-value r) 40) (nth r 3)))))
                (agt-say (tail rows)))))
    (let standing (fgsr-standing? "aware"))
    (print_str (str_concat "aware sensor standing: " (int_to_str standing)))
    (let held (fgsr-take "aware" (list)))
    (let now (now_unix_ms))
    (let rows (fgsr-rows-or-absent-at "aware" held now))
    (print_str (str_concat "seq=" (str_concat (int_to_str (fgsr-held-seq held)) (str_concat " epoch=" (str_concat (int_to_str (fgsr-held-epoch held)) (str_concat " rows=" (int_to_str (len rows))))))))
    (agt-say rows)
    (len rows))
