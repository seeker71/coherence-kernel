// blueprint-literal-band.bml — form-stdlib/bml/blueprint-literal.bml reads a composite literal to one cell, in one
// canonical order, and rejects what does not fit its declaration. Last line: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/blueprint-literal.bml
section [form.bml] {
 class BlueprintLiteralBand {
  def bb-decls() = "blueprint LineItem { sku: string, qty: int } blueprint Order { id: int, items: list<LineItem>, meta: map<string,float>, tags: set<string>, note: option<string>, at: tuple<int,int> }";
  def bb-decls-wider() = "blueprint LineItem { sku: string, qty: float } blueprint Order { id: int, items: list<LineItem>, meta: map<string,float>, tags: set<string>, note: option<string>, at: tuple<int,int> }";
  def bb-order() = "Order{ id: 7, items: [LineItem{sku: \"a\", qty: 2}, LineItem{sku: \"b\", qty: 1}], meta: map{\"w\": 1.5, \"h\": 2.0}, tags: set[\"y\", \"x\"], note: some(\"rush\"), at: tuple[3, 4] }";
  def bb-order-shuffled() = "Order{ at: tuple[3, 4], note: some(\"rush\"), tags: set[\"x\", \"y\", \"x\"], meta: map{\"h\": 2.0, \"w\": 1.5}, items: [LineItem{qty: 2, sku: \"a\"}, LineItem{sku: \"b\", qty: 1}], id: 7 }";
  def bb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def bb-run() {
   let defs = bl-defs(bb-decls());
   let wider = bl-defs(bb-decls-wider());
   let a = bb-row("two blueprints declared", len(defs) == 2);
   let c = bl-read(bb-order(), defs);
   let d = bl-read(bb-order-shuffled(), defs);
   let b1 = bb-row("a composite literal reads to a cell", !nothing?(c));
   let b2 = bb-row("the same value written in another order is the same NodeID", !nothing?(c) && !nothing?(d) && eq(c, d));
   let canon = bl-show(c, defs);
   let b3 = bb-row("show writes the canonical literal", !nothing?(canon) && ((String) canon == "Order{id: 7, items: [LineItem{sku: \"a\", qty: 2}, LineItem{sku: \"b\", qty: 1}], meta: map{\"h\": 2.0, \"w\": 1.5}, tags: set[\"x\", \"y\"], note: some(\"rush\"), at: tuple[3, 4]}"));
   let b4 = bb-row("text to cell to text is a fixed point", !nothing?(canon) && eq(c, bl-read(canon, defs)) && ((String) bl-show(bl-read(canon, defs), defs) == (String) canon));
   let none-text = "Order{id: 1, items: [], meta: map{}, tags: set[], at: tuple[0, 0]}";
   let none-text2 = "Order{id: 1, items: [], meta: map{}, tags: set[], note: nothing(), at: tuple[0, 0]}";
   let b5 = bb-row("an absent option field is none", !nothing?(bl-read(none-text, defs)) && eq(bl-read(none-text, defs), bl-read(none-text2, defs)));
   let b6 = bb-row("a field of the wrong type reads as nothing", nothing?(bl-read("LineItem{sku: \"a\", qty: \"2\"}", defs)));
   let b7 = bb-row("an undeclared field reads as nothing", nothing?(bl-read("LineItem{sku: \"a\", qty: 2, extra: 1}", defs)));
   let b8 = bb-row("a missing required field reads as nothing", nothing?(bl-read("LineItem{sku: \"a\"}", defs)));
   let b9 = bb-row("a repeated map key reads as nothing", nothing?(bl-read("map{\"a\": 1, \"a\": 2}", defs)));
   let b10 = bb-row("an unknown blueprint reads as nothing", nothing?(bl-read("Nope{x: 1}", defs)));
   let b11 = bb-row("malformed text reads as nothing", nothing?(bl-read("Order{id: 7", defs)));
   let b12 = bb-row("read-as accepts the type it names", !nothing?(bl-read-as("list<LineItem>", "[LineItem{sku: \"a\", qty: 2}]", defs)));
   let b13 = bb-row("read-as rejects another type", nothing?(bl-read-as("list<int>", "[LineItem{sku: \"a\", qty: 2}]", defs)));
   let b14 = bb-row("read-as nested generic type", !nothing?(bl-read-as("map<string,list<int>>", "map{\"a\": [1, 2], \"b\": []}", defs)));
   let m1 = bl-read("map{3: \"c\", 1: \"a\"}", defs);
   let b15 = bb-row("a map with int keys is in key order", !nothing?(m1) && ((String) bl-show(m1, defs) == "map{1: \"a\", 3: \"c\"}"));
   let b16 = bb-row("a map is one cell whatever its written order", eq(m1, bl-read("map{1: \"a\", 3: \"c\"}", defs)));
   let b17 = bb-row("a bool is a cell that keeps its kind", (String) bl-show(bl-read("[true, false, 1]", defs), defs) == "[true, false, 1]");
   let b18 = bb-row("a float keeps its point", (String) bl-show(bl-read("[7.0, 7]", defs), defs) == "[7.0, 7]");
   let b19 = bb-row("a nested map in a list in a tuple", (String) bl-show(bl-read("tuple[map{\"k\": [some(1), nothing()]}, \"s\"]", defs), defs) == "tuple[map{\"k\": [some(1), nothing()]}, \"s\"]");
   let b20 = bb-row("a string keeps its escapes", (String) bl-show(bl-read("\"a\\nb\\\"c\"", defs), defs) == "\"a\\nb\\\"c\"");
   let same = bl-read(bb-order(), bl-defs(bb-decls()));
   let b21 = bb-row("the same declaration made again is the same blueprint", eq(c, same));
   let other = bl-read(bb-order(), wider);
   let b22 = bb-row("a changed declaration is a different blueprint", nothing?(other));
   let wide-item = bl-read("LineItem{sku: \"a\", qty: 2.0}", wider);
   let narrow-item = bl-read("LineItem{sku: \"a\", qty: 2}", defs);
   let b23 = bb-row("a LineItem of the wider declaration is not the narrow one", !nothing?(wide-item) && !nothing?(narrow-item) && !eq(wide-item, narrow-item));
   let registry = bl-registry(defs);
   let wire = encode(c, registry);
   let b24 = bb-row("the cell crosses the JSON codec and returns the same NodeID", eq(c, decode(wire, registry)));
   let b25 = bb-row("core cells cross the JSON codec", eq(m1, decode(encode(m1, registry), registry)));
   print_str("[blueprint-literal-band] " ++ value_str(a + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15 + b16 + b17 + b18 + b19 + b20 + b21 + b22 + b23 + b24 + b25) ++ " of 26");
  }
 }
 bb-run();
}
