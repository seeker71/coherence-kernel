; preludes: form/form-stdlib/core.fk form/form-stdlib/metal-door.fk
;
; mint-price-run — what a Metal pipeline costs this host, measured BY THE BODY.
;
; Every performance number in this tree had been taken from outside it — a shell `time`, an external
; harness — which means the body could report its own speed only by being told. It cannot hold a claim
; it cannot read. `host_monotonic_ms` and `host_cpu_us` have been doors the whole time; the reason the
; numbers came from the shell is that nobody asked the body first.
;
; THE QUESTION: the twoprice teaching (corpus row 1375) says the same kernel text costs wildly
; different amounts minutes apart, and no door says which price is about to be paid. This measures the
; two prices from inside a single process, where a shell timing cannot reach at all: shell timing sees
; process totals, so it cannot separate the FIRST mint of a text from the second in the same run.
;
; A fresh text per run is minted by threading the monotonic reading into the kernel's own name and a
; literal in its body, so this host's shader cache has never seen it. Then the SAME text is minted
; again in this same process. Then a THIRD text, fresh again, to show the cold price is repeatable
; rather than a first-touch artifact of the Metal device coming up.
;
; Nothing here is a verdict. It is a reading, and it prints what it read.

(defn mp-src (n)
  (str_concat "kernel void mp_" (str_concat n
  (str_concat "(device float* o [[buffer(0)]], constant uint& c [[buffer(1)]], uint i [[thread_position_in_grid]]) { if (i >= c) return; float acc = 0.0f; for (uint k = 0u; k < 64u; ++k) { acc = acc + float(k) * "
  (str_concat n ".0f; } o[i] = acc + float(i); }")))))

(defn mp-name (n) (str_concat "mp_" n))

; one mint, in milliseconds of wall time and microseconds of cpu
(defn mp-time (src name)
  (do (let w0 (host_monotonic_ms))
      (let c0 (host_cpu_us))
      (let h (metal_pipeline src name))
      (list h (sub (host_monotonic_ms) w0) (sub (host_cpu_us) c0))))

(defn mp-say (label r)
  (do (print label)
      (print (str_concat "  handle    " (int_to_str (nth r 0))))
      (print (str_concat "  wall ms   " (int_to_str (nth r 1))))
      (print (str_concat "  cpu us    " (int_to_str (nth r 2))))))

(do
  ; a device warm-up that is not part of any measurement: the first Metal touch in a process
  ; carries device creation, and charging that to the first kernel would report it as compile cost.
  (let warm (metal_pipeline "kernel void mp_warm(device float* o [[buffer(0)]], uint i [[thread_position_in_grid]]) { o[i] = 1.0f; }" "mp_warm"))
  (print (str_concat "device warm-up handle " (int_to_str warm)))

  (let n1 (int_to_str (host_monotonic_ms)))
  (mp-say "COLD  — this host has never seen this text" (mp-time (mp-src n1) (mp-name n1)))
  (mp-say "WARM  — the SAME text, same process"        (mp-time (mp-src n1) (mp-name n1)))
  (mp-say "WARM  — the same text a third time"         (mp-time (mp-src n1) (mp-name n1)))

  (let n2 (str_concat (int_to_str (host_monotonic_ms)) "7"))
  (mp-say "COLD  — a second never-seen text"           (mp-time (mp-src n2) (mp-name n2)))
  (mp-say "WARM  — that second text again"             (mp-time (mp-src n2) (mp-name n2)))
  0)
