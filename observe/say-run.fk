; say-run.fk — the body speaks, in its own mouth, on this Mac.
; stdin line 1: the tongue's whisper code (fa, en, ...); line 2 and on: what to say.
; Line 1 may name several tongues — "en pt fa id" — and the line is then spoken
; in each of them in turn, in the order written.
; Line 1 alone as "?" (with nothing after it) lists the mouths the body holds.
; A tongue with no voice yet says so and names the ones that do.
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-say.bml
(do
    (defn sr-trim (s) (if (nothing? s) "" (trim s)))
    (defn sr-rest (acc) (do (let l (read_line)) (if (nothing? l) acc (sr-rest (if (eq (str_len acc) 0) (trim l) (str_concat acc (str_concat " " (trim l))))))))
    (let code (sr-trim (read_line)))
    (let text (sr-rest ""))
    (let tongue (if (eq (str_len code) 0) "en" code))
    (if (str_eq tongue "?")
        (print_str (str_concat (vs-mouths) (str_concat "\n" (str_concat (int_to_str (vs-mouth-count)) " mouths"))))
        (print_str (vs-say-tongues tongue text)))
    0)
