; carrier-recovery.fk — when a named command is not on PATH, the body senses
; candidate carriers before declaring the capability absent.
;
; The caller supplies candidates in preference order. Selection is computed
; from live host observations; a missing PATH binding is an input state, never
; an existence verdict. No candidate observed means no-result plus an explicit
; alternate node, so the framebuffer has somewhere to move next.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; witnessed: 2026-07-23 -> repo-local form-run selected after PATH miss

(do
    ; (carrier-recovery path-state selected status alternate probes)
    (defn cr-receipt (path-state selected status alternate probes)
        (list "carrier-recovery" path-state selected status alternate probes))
    (defn cr-path-state (r) (nth r 1))
    (defn cr-selected (r) (nth r 2))
    (defn cr-status (r) (nth r 3))
    (defn cr-alternate (r) (nth r 4))
    (defn cr-probes (r) (nth r 5))

    (defn cr-probe-loop (candidates observations)
        (if (eq (len candidates) 0)
            (cr-receipt "path-miss" "" "no-result" "discover-carrier" (reverse observations))
            (do
                (let candidate (head candidates))
                (let present (host-abi-file-exists? candidate))
                (if (eq present 1)
                    (cr-receipt "path-miss" candidate "pivot" "execute-selected" 
                        (reverse (cons (list candidate present) observations)))
                    (cr-probe-loop (tail candidates)
                        (cons (list candidate present) observations))))))

    (defn carrier-recover (candidates)
        (cr-probe-loop candidates (list)))

    (defn cr-live-form-run ()
        (carrier-recover
            (list "./form-run"
                  "/tmp/coherence-inquiry-relation/form-run")))
)
