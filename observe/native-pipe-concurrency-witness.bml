// Three independent fixed children, reusable framed requests and exact streams.
// preludes: form/form-stdlib/bml/native-pipe-darwin.bml
section [form.bml] {
 class NativePipeThree {
  def nppt-repeat(n,text) = if eq(n,0) then text else nppt-repeat(sub(n,1),str_concat(text,text));
  def nppt-need(owner,good,aspect) = if good then 1 else npp-refuse(owner,aspect);
  def nppt-wait(owner,job,until) {
   npp-pump(owner,10); if npp-done(owner,job) then 1 else if gt(host_monotonic_ms(),until) then npp-refuse(owner,"three children deadline") else nppt-wait(owner,job,until);
  }
  def nppt-sent(owner,jobs,until) {
   npp-pump(owner,10); if nppt-all-sent(jobs) then 1 else if gt(host_monotonic_ms(),until) then npp-refuse(owner,"request acceptance deadline") else nppt-sent(owner,jobs,until);
  }
  def nppt-all-sent(jobs) = if nil?(jobs) then 1 else and(eq(str_len(record_get(head(jobs),"pending")),0),nppt-all-sent(tail(jobs)));
  def nppt-exact(owner,job,bytes) {
   let output = npp-take(owner,job,"stdout"); let errors = npp-take(owner,job,"stderr");
   print(list("child",record_get(job,"pid"),"bytes",str_len(bytes),"stdout",str_len(output),"stderr",str_len(errors),"status",record_get(job,"status")));
   and(eq(record_get(job,"status"),0),and(str_eq(output,bytes),str_eq(errors,bytes)));
  }
  def nppt-ends-dead(owner,ends) = if nil?(ends) then 1 else and(eq(npp-call(owner,list(2,record_get(head(ends),"fd"),1,0)),-9),nppt-ends-dead(owner,tail(ends)));
  def nppt-run() {
   let owner = npp-open(); let argv = list("./fkwu","observe/native-pipe-echo-run.bml");
   let a = npp-spawn(owner,argv); let b = npp-spawn(owner,argv); let c = npp-spawn(owner,argv);
   let x = npp-frame(nppt-repeat(14,str_concat("A",byte_to_str(0)))); let y = npp-frame(nppt-repeat(16,"B")); let z = str_concat(npp-frame(""),npp-frame(nppt-repeat(15,"C"))); let second = npp-frame(nppt-repeat(13,"again\n"));
   nppt-need(owner,and(npp-submit(owner,a,x),and(npp-submit(owner,b,y),npp-submit(owner,c,substring(z,0,3)))),"three submissions");
   nppt-sent(owner,list(c),add(host_monotonic_ms(),20000)); nppt-need(owner,npp-submit(owner,c,substring(z,3,str_len(z))),"split header continuation");
   npp-half-close(owner,a); nppt-wait(owner,a,add(host_monotonic_ms(),20000));
   let isolatedEOF = and(eq(record_get(b,"reaped"),0),eq(record_get(c,"reaped"),0));
   nppt-need(owner,isolatedEOF,"first EOF while sibling workers remain resident");
   nppt-sent(owner,list(b,c),add(host_monotonic_ms(),20000));
   nppt-need(owner,npp-submit(owner,b,second),"resident second request"); npp-half-close(owner,b); npp-half-close(owner,c);
   nppt-wait(owner,b,add(host_monotonic_ms(),20000)); nppt-wait(owner,c,add(host_monotonic_ms(),20000));
   let exactA = nppt-exact(owner,a,x); let exactB = nppt-exact(owner,b,str_concat(y,second)); let exactC = nppt-exact(owner,c,z);
   let settled = npp-settle(owner,list(a,b,c)); let dead = nppt-ends-dead(owner,record_get(owner,"ends"));
   print(list("isolated-eof",isolatedEOF,"all-exact",and(exactA,and(exactB,exactC)),"all-reaped",settled,"all-fds-EBADF",dead,"partial-writes",record_get(owner,"partial-writes"),"EAGAIN",record_get(owner,"would-block"),"reads",record_get(owner,"reads"),"read-bytes",record_get(owner,"read-bytes")));
   let closed = npp-close(owner); if and(closed,and(dead,and(exactA,and(exactB,exactC)))) then 1 else form_error("three pipe ownership refused");
  }
 }
 nppt-run();
}
