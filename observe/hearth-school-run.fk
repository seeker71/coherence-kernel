; hearth-school-run.fk — known tasks for the local model: held-out corpus
; questions whose answers the body already holds, sent to the standing
; resident through the hearth, graded on the first word of each reply,
; published to the glass as voice.hearth, written to the hearth-school
; ledger. stdin line 1: how many questions (blank -> 2); line 2: data folder
; (blank -> .form-lora-voice-native). Patience: hearth-review-wait-s per run.
; preflight-exec: forbidden
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/lane-motion.bml form/form-stdlib/voice-school.bml
(do
    (defn hs-say (k v) (print_str (str_concat "hearth-school " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn hs-trim (s) (if (nothing? s) "" (trim s)))
    (defn hs-or (s d) (if (eq (str_len s) 0) d s))
    (defn hs-text (t) (if (nothing? t) "" t))
    ; the reply body of one turn: after its turn= line, past the response mark, first word
    (defn hs-reply-word (rsp turn)
        (do (let at (str_find rsp (str_concat "turn=" (str_concat (int_to_str turn) "\n")) 0))
            (let m (if (lt at 0) (sub 0 1) (str_find rsp (lms-mark-response) at)))
            (let body (if (lt m 0) "" (substring rsp (add m (str_len (lms-mark-response))) (str_len rsp))))
            (let t (str_find body "</think>" 0))
            (let said (if (lt t 0) body (substring body (add t 8) (str_len body))))
            (if (lt m 0) "" (vs-lower (vs-first-word said) 0 ""))))
    (defn hs-send-all (lines turn acc)
        (if (eq (len lines) 0) (reverse acc)
            (do (let sent (hearth-send turn (hearth-kind-answer) (str_concat "/no_think Answer with one word only. " (vs-question (head lines)))))
                (hs-send-all (tail lines) (add turn 1) (cons (list turn (vs-lower (vs-first-word (vs-answer (head lines))) 0 "")) acc)))))
    (defn hs-all-answered? (rsp asks) (if (eq (len asks) 0) 1 (if (eq (str_len (hs-reply-word rsp (head (head asks)))) 0) 0 (hs-all-answered? rsp (tail asks)))))
    (defn hs-wait (asks waited) (if (or (eq (hs-all-answered? (hs-text (read_file (hearth-reply))) asks) 1) (ge waited (hearth-review-wait-s))) waited (do (let r (hearth-rest-s (hearth-review-tick-s))) (hs-wait asks (add waited (hearth-review-tick-s))))))
    (defn hs-grade (rsp asks hits) (if (eq (len asks) 0) hits (do (let got (hs-reply-word rsp (head (head asks)))) (let want (nth (head asks) 1)) (hs-say "answer" (str_concat "turn=" (str_concat (int_to_str (head (head asks))) (str_concat " want=" (str_concat want (str_concat " got=" got)))))) (hs-grade rsp (tail asks) (add hits (if (str_eq got want) 1 0))))))
    (defn hs-sample (id purpose n lifecycle epoch) (fgtm-sample id (fgtm-absent) "hearth-school" "form" "voice.hearth" "voice" purpose (fgtm-absent) (fgtm-present n) lifecycle (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-present (hearth-board-pid)) "never" "physical-live" "hearth-school" (vs-tags)))
    (let n (str_to_int (hs-or (hs-trim (read_line)) "2")))
    (let data (hs-or (hs-trim (read_line)) ".form-lora-voice-native"))
    (if (eq (hearth-standing) 0) (hs-say "signal" "nothing reason=no-standing-hearth")
        (do (let lines (vs-corpus-lines (split-on (hs-text (read_file (str_concat data "/valid.jsonl"))) (byte_to_str 10)) n))
            (let turn0 (add (lms-max-turn (read_file (hearth-task))) 1))
            (let asks (hs-send-all lines turn0 (list)))
            (let waited (hs-wait asks 0))
            (let rsp (hs-text (read_file (hearth-reply))))
            (let hits (hs-grade rsp asks 0))
            (let epoch (now_unix_ms))
            (let published (fgtm-publish-snapshot (hearth-telemetry-root) "voice.hearth" epoch (list (hs-sample "voice.hearth.heldout" (str_concat "hits-of-" (int_to_str (len asks))) hits "ready" epoch) (hs-sample "voice.hearth.waited-s" "seconds-for-all" waited "completed" epoch))))
            (let ledger (sbt-append "receipts/hearth-school-ledger.md" (vs-cat (list "| " (trim (hs-text (host-exec "date +%Y-%m-%d-%H:%M" ""))) " | resident pid " (int_to_str (hearth-board-pid)) " | " (int_to_str hits) "/" (int_to_str (len asks)) " | " (int_to_str waited) " s |" (byte_to_str 10)))))
            (hs-say "grade" (vs-cat (list "hits=" (int_to_str hits) "/" (int_to_str (len asks)) " waited=" (int_to_str waited) "s glass=" (nth published 1))))
            0)))
