; qwen38-tokenizer-live-cursor-full-equivalence.fk -- full teach-overlay parity.
;
; No model or GPU handle opens.  This compares the currently admitted full
; system+user ChatML sequence against the live qtf2/BMF cursor and reports only
; equality, extent, cursor metrics, timing, and release.
;
; preludes: form-stdlib/form-teach-layer.fk form-stdlib/qwen35-tokenizer-live-cursor.fk form-stdlib/model-registry.bml

(do
    (defn qtlcfe-ids-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (head a) (head b))
                    (qtlcfe-ids-eq (tail a) (tail b)) 0))))
    (defn qtlcfe-reference (src prompt system-text x)
        (tkz-cat (list (nth x 1))
        (tkz-cat (q35-encode src "system\n")
        (tkz-cat (q35-encode src system-text)
        (tkz-cat (list (nth x 2))
        (tkz-cat (nth x 6)
                 (qsx-chat-ids src prompt x)))))))
    (let path (mr-path (mr-find "qwen38-q8")))
    (let prompt "In Form, distinguish nothing from the numeric values 0 and 1.")
    (let system-text (ftl-system-text))
    (let x (qsx-load path))
    (let src (eqr-of-file path 0 40000000))
    (let t0 (now_unix_ms))
    (let reference (qtlcfe-reference src prompt system-text x))
    (let t1 (now_unix_ms))
    (let segments (qtlc-full-chat-segments prompt system-text x))
    (let cursor (qtlc-open path (qsx-seal-line path) segments))
    (let t2 (now_unix_ms))
    (let drained (qtlc-drain cursor))
    (let t3 (now_unix_ms))
    (let ids (nth drained 1))
    (let final (nth drained 2))
    (print_str (str_concat "reference_ms="
        (str_concat (int_to_str (sub t1 t0)) "\n")))
    (print_str (str_concat "cursor_open_ms="
        (str_concat (int_to_str (sub t2 t1)) "\n")))
    (print_str (str_concat "cursor_drain_ms="
        (str_concat (int_to_str (sub t3 t2)) "\n")))
    (print_str (str_concat "cursor_final_status="
        (str_concat (qtlc-status final) "\n")))
    (print_str (str_concat "system_bytes="
        (str_concat (int_to_str (str_len system-text)) "\n")))
    (print_str (str_concat "upper_bound="
        (str_concat (int_to_str (qtlc-segments-upper-bound segments 0)) "\n")))
    (print_str (str_concat "reference_tokens="
        (str_concat (int_to_str (len reference)) "\n")))
    (print_str (str_concat "cursor_tokens="
        (str_concat (int_to_str (len ids)) "\n")))
    (print_str (str_concat "cursor_pieces="
        (str_concat (int_to_str (qtlc-pieces final)) "\n")))
    (print_str (str_concat "cursor_probes="
        (str_concat (int_to_str (qtlc-probes final)) "\n")))
    (print_str (str_concat "cursor_released="
        (str_concat (int_to_str (qtlc-released? final)) "\n")))
    (print_str (str_concat "ids_equal="
        (str_concat (int_to_str (qtlcfe-ids-eq reference ids)) "\n")))
    (if (and (str_eq (nth drained 0) "done")
             (and (eq (qtlc-released? final) 1)
                  (eq (qtlcfe-ids-eq reference ids) 1))) 1 0))
