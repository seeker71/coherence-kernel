// A miss compiles in RAM and runs that pipeline before any file exists.
// Publication copies that archive. It does not compile again and it does not
// load the file it just wrote. The next process loads the file.
// preflight-exec: forbidden
import form-stdlib/bml/metal-jit.bml;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class MetalCacheReturn {
  def mcr-dir() = "/tmp/sema-metal-cache-return";
  def mcr-entry() = "form_jit_f";
  def mcr-nl() = byte_to_str(10);
  def mcr-source() {
   let n = mcr-nl();
   "#include <metal_stdlib>" ++ n ++ "using namespace metal;" ++ n ++ "kernel void form_jit_f(device uint *a [[buffer(0)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] * 3 + 7; }" ++ n;
  }
  def mcr-count(key) {
   let text = metal_status();
   let mark = key ++ "=";
   let start = str_find(text, mark, 0);
   start < 0 ? -1 : mcr-int(text, start + len(mark));
  }
  def mcr-int(text, from) {
   let nl = str_find(text, mcr-nl(), from);
   str_to_int(substring(text, from, nl < 0 ? len(text) : nl));
  }
  def mcr-u32(bytes) = str_byte_at(bytes, 0) + str_byte_at(bytes, 1) * 256 + str_byte_at(bytes, 2) * 65536 + str_byte_at(bytes, 3) * 16777216;
  def mcr-absent?(path) {
   let n = file_size(path);
   nothing?(n) || n < 0;
  }
  def mcr-eval(version) {
   let buf = metal_buf_alloc(4);
   let wrote = buf > 0 ? metal_buf_write(buf, 0, md-le32(5)) : 0;
   let enq = wrote == 4 ? metal_enqueue(mj-handle(version), md-bind([buf], []), 1) : 0;
   let sync = enq > 0 ? metal_sync() : -1;
   let res = sync >= 0 ? metal_buf_read(buf, 0, 4) : "";
   let freed = buf > 0 ? metal_buf_free(buf) : 0;
   (Comparable) len(res) == 4 ? mcr-u32(res) : -1;
  }
  def mcr-load() {
   let compiles = mcr-count("metal_jit_source_compiles");
   let version = mj-cached(mcr-source(), mcr-entry(), mcr-dir());
   let value = nothing?(version) ? -1 : mcr-eval(version);
   let after = mcr-count("metal_jit_source_compiles");
   let reads = mcr-count("metal_jit_archive_reads");
   print(["load-compiles", compiles, "after", after, "reads", reads, "value", value]);
   (Comparable) value == 22 && after == compiles && reads >= 1 ? "load-ok" : form_error("metal cache load failed");
  }
  def mcr-return() {
   let path = mj-cache-path(mcr-dir(), mcr-source(), mcr-entry());
   let removed = nothing?(path) ? 0 : host_path_remove(path);
   let compiles = mcr-count("metal_jit_source_compiles");
   let writes = mcr-count("metal_jit_archive_writes");
   let version = nothing?(path) ? nothing() : mj-cached(mcr-source(), mcr-entry(), mcr-dir());
   let held = !nothing?(version) && mcr-absent?(path) && mcr-count("metal_jit_archive_writes") == writes && mcr-count("metal_jit_source_compiles") == compiles + 1;
   let observed = held ? mcr-eval(version) : -1;
   let again = observed == 22 ? mj-cached(mcr-source(), mcr-entry(), mcr-dir()) : nothing();
   let reused = observed == 22 && mj-handle(again) == mj-handle(version) && mcr-count("metal_jit_source_compiles") == compiles + 1 && mcr-absent?(path);
   let published = reused && mj-publish-held() == 1 && !mcr-absent?(path) && mcr-count("metal_jit_archive_writes") > writes && mcr-count("metal_jit_source_compiles") == compiles + 1;
   let compiles_after = mcr-count("metal_jit_source_compiles");
   let still = published ? mcr-eval(version) : -1;
   let child = still == 22 ? hch-run("metal-cache-load", ["./fkwu", "observe/metal-cache-return-run.bml"], "load", hch-by(120000)) : nothing();
   let loaded = !nothing?(child) && hch-ok?(child) && str_find(hch-said(child), "load-ok", 0) >= 0;
   print(["held", held, "observed", observed, "reused", reused, "compiles", compiles_after, "published", published, "still", still, "loaded", loaded, "path", path]);
   held && observed == 22 && reused && published && still == 22 && loaded ? 1 : form_error("metal cache return-before-publish failed");
  }
  def mcr-main() = trim(stdin-text()) == "load" ? mcr-load() : mcr-return();
 }
 mcr-main();
}
