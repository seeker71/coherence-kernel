; nvr-local-share-live.fk — one line per prompt, then the jungle read.
;
; preludes: form-stdlib/core.fk form-stdlib/form-first-router.fk form-stdlib/native-vs-rented.fk observe/nvr-metric.fk observe/nvr-corpus.fk observe/nvr-local-share.fk

(do
    (defn nvrll-line (id)
        (do (let r (nvrl-row id))
            (print "nvrl ")
            (print (int_to_str (nth r 0)))
            (print " native=")
            (print (int_to_str (nth r 2)))
            (print " net=")
            (print (int_to_str (nth r 3)))
            (print " ")
            (print (nth r 1))
            (print "\n")
            0))
    (nvrll-line 0)
    (nvrll-line 1)
    (nvrll-line 2)
    (nvrll-line 3)
    (nvrll-line 4)
    (nvrll-line 5)
    (nvrll-line 6)
    (nvrll-line 7)
    (print "nvrl emit-old=")
    (print (nvrl-old-emit))
    (print " emit-now=nothing saved=")
    (print (int_to_str (nvrl-saved-remote?)))
    (print "\n")
    (print "nvrl jungle-ready=")
    (print (int_to_str (nvrl-jungle-ready?)))
    (print " check=")
    (print (int_to_str (nvrl-check)))
    (print "\n")
    0)
