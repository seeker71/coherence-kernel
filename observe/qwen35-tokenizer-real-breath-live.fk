; qwen35-tokenizer-real-breath-live.fk -- one real, bounded vocabulary breath.
;
; EFFECTFUL DRIVER: do not preflight.  It opens only a 40 MB equireach window
; over the real local Qwen3.8-27B GGUF header, clears one exact Form temp root,
; and asks the committed bounded tokenizer bridge for exactly one 64-record
; vocabulary breath.  Each record is appended to its two-byte bucket and
; released before the next.  No whole vocabulary/merge list, model tensor,
; model forward, flatten table, or C/Claude artifact is made here.
;
; The SHA below is an observed input from the existing tiny Form seal and the
; prior whole-file witness recorded in receipts/2026-08-17-qwen38-form-native-floor.md.
; This driver checks the 86-byte seal text and current file size; it deliberately
; does not hash 29 GB again.  Same-size source substitution remains outside this
; breath's observation and is named in the receipt.
;
; preludes: form-stdlib/qwen35-tokenizer-bounded-bridge.fk form-stdlib/model-registry.bml

(do
    (defn q35trb-source-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn q35trb-source-size-observed () 29047086048)
    (defn q35trb-source-sha-observed ()
        "a680f44a06920e5d689774823782006aa3acc8db95750323373b24139b67e348")
    (defn q35trb-source-seal-path ()
        (str_concat (q35trb-source-path) ".form-seal"))
    (defn q35trb-source-seal-observed ()
        (str_concat "qaf-seal1:29047086048:" (q35trb-source-sha-observed)))
    (defn q35trb-source-window-bytes () 40000000)
    (defn q35trb-requested-records () 64)
    (defn q35trb-root ()
        (fs-path-join (fs-temp-dir) "qwen35-tokenizer-real-breath-live"))
    (defn q35trb-seal-input-current? ()
        (if (eq (fs-exists? (q35trb-source-seal-path)) 0) 0
            (if (str_eq (fs-read-text (q35trb-source-seal-path))
                        (q35trb-source-seal-observed)) 1 0)))
    (defn q35trb-bit (ok bit) (if ok bit 0))

    (let path (q35trb-source-path))
    (let source-exists (fs-is-file? path))
    (let source-size (fs-stat-size path))
    (let source-mtime (fs-stat-mtime path))
    (let seal-input-current (q35trb-seal-input-current?))
    (let root (q35trb-root))
    (let cleared (fs-remove-tree root))
    (let absent-after-clear (if (eq (fs-exists? root) 0) 1 0))
    (let made (fs-mkdir root))
    (let directory-born (fs-is-dir? root))

    (if (not (and (eq source-exists 1)
                  (and (eq source-size (q35trb-source-size-observed))
                       (and (gt source-mtime 0)
                            (and (eq seal-input-current 1)
                                 (and (eq absent-after-clear 1)
                                      (eq directory-born 1)))))))
        (do
            (print (list "qwen35-tokenizer-real-breath"
                "status" "refused-before-open"
                "source" path
                "source-exists" source-exists
                "source-size" source-size
                "source-mtime" source-mtime
                "source-sha-observed-input" (q35trb-source-sha-observed)
                "source-seal-input-current" seal-input-current
                "root" root
                "remove-result" cleared
                "mkdir-result" made
                "absent-after-clear" absent-after-clear
                "directory-born" directory-born
                "model-forward" 0))
            0)
        (do
            ; One bounded host string contains the metadata/tokenizer header.
            ; The bridge reaches individual records in place and retains no array.
            (let src (eqr-of-file path 0 (q35trb-source-window-bytes)))
            (let magic-ok (egg-magic-ok? src))
            (let version (egg-version src))
            (let vocab-total (gmt-vocab-n src))
            (let merges-total (tkz-merges-n src))
            ; This is the one and only authorized real-source breath.
            (let breath (q35tbb-breath root src source-size source-mtime
                                       (q35trb-requested-records)))
            (let progress (q35tbb-breath-progress breath))
            (let progress-path (fs-path-join root (q35tba-progress-name)))
            (let progress-persisted (fs-is-file? progress-path))

            (print (list "qwen35-tokenizer-real-breath"
                "status" (q35tbb-breath-status breath)
                "source" path
                "source-size" source-size
                "source-mtime" source-mtime
                "source-sha-observed-input" (q35trb-source-sha-observed)
                "source-sha-provenance" "existing-form-seal-and-2026-08-17-receipt"
                "source-rehashed-this-run" 0
                "source-seal-input-current" seal-input-current
                "gguf-magic" magic-ok
                "gguf-version" version
                "vocab-total" vocab-total
                "merges-total" merges-total
                "root" root
                "fresh-after-clear" absent-after-clear
                "directory-born" directory-born
                "phase" (q35tbb-progress-phase progress)
                "next-index" (q35tbb-progress-next-index progress)
                "next-source-offset" (q35tbb-progress-next-off progress)
                "vocab-built" (q35tbb-progress-vocab-built progress)
                "merge-built" (q35tbb-progress-merge-built progress)
                "progress-persisted" progress-persisted
                "progress-bytes" (fs-stat-size progress-path)
                "requested" (q35tbb-breath-requested breath)
                "processed" (q35tbb-breath-processed breath)
                "appended-bytes" (q35tbb-breath-appended breath)
                "peak-row-bytes" (q35tbb-breath-max-row breath)
                "source-window-bytes" (q35trb-source-window-bytes)
                "artifact-cursor-window-bytes" (q35tbb-breath-window breath)
                "max-breath-records" (q35tba-max-breath-rows)
                "os-peak-rss-in-form" (q35tbb-breath-os-peak-rss breath)
                "choices" (q35tbb-breath-choices breath)
                "cuts" (q35tbb-breath-cuts breath)
                "undos" (q35tbb-breath-undos breath)
                "timeouts" (q35tbb-breath-timeouts breath)
                "failures" (q35tbb-breath-failures breath)
                "refinements" (q35tbb-breath-refinements breath)
                "releases" (q35tbb-breath-releases breath)
                "reason" (q35tbb-breath-reason breath)
                "whole-vocab-list" 0
                "whole-merge-list" 0
                "model-tensors-opened" 0
                "model-forward" 0
                "source-window-release" "process-exit"
                "artifact-lifecycle" "fresh-temp-left-for-inspection"))

            (sum (list
                (q35trb-bit (eq magic-ok 1) 1)
                (q35trb-bit (eq version 3) 2)
                (q35trb-bit (eq vocab-total 248320) 4)
                (q35trb-bit (gt merges-total 0) 8)
                (q35trb-bit (str_eq (q35tbb-breath-status breath) "progress") 16)
                (q35trb-bit (eq (q35tbb-breath-requested breath) 64) 32)
                (q35trb-bit (eq (q35tbb-breath-processed breath) 64) 64)
                (q35trb-bit (eq (q35tbb-progress-vocab-built progress) 64) 128)
                (q35trb-bit (eq (q35tbb-progress-merge-built progress) 0) 256)
                (q35trb-bit (eq (q35tbb-breath-releases breath) 64) 512)
                (q35trb-bit (eq (q35tbb-breath-failures breath) 0) 1024)
                (q35trb-bit (eq progress-persisted 1) 2048)
                (q35trb-bit (le (q35tbb-breath-max-row breath)
                                 (q35tba-max-row-bytes)) 4096)
                (q35trb-bit (eq (q35tbb-breath-window breath) 256) 8192)
                (q35trb-bit (and (eq seal-input-current 1)
                                  (eq source-size (q35trb-source-size-observed))) 16384))))))
