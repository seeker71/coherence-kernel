// transmute-grow-run.bml — the door: a passage in, its words the grammar does not hold yet drafted, offered to the
// circle, and the affirmed ones admitted with the reading the voice drafts for them.
//
//   printf '%s\n%s\n%s\n%s\n' "$SOURCE" "$ACKS" "$MODEL" "$PASSAGE" | ./fkwu observe/transmute-grow-run.bml
//
// stdin, four parts: line 1 the source (may be empty); line 2 the circle's acks, one per draft in the order the door
// lists them, as the satsang kinds with a space between (0 nothing, 1 zero, 2 one, 3 node) — blank offers the drafts
// and admits none, and a draft with no ack beside it stays pending; line 3 the model — "0" admits without asking the
// voice, blank asks the registry's answer model, a registry id asks that one; every line after is the passage.
// Prints each draft with its place and the words it arrived in, the admitted words, and the register read before and
// after over the affirmed rows only (tm-grow-with). Each admitted row is appended to learn/purify-admitted.jsonl and
// one TransmuteGrowRow to receipts/transmute-grow-ledger.jsonl. A word admitted in an earlier reading is not drafted again.
// The lifts of an admitted row stay unassigned: trust, sov and vit are authored coordinates, not the door's to give.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk ingest/satsang-transmute.fk form-stdlib/bml/transmute.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint PurifyAdmitted { at_unix_ms: int, source: string, word: string, common: string, purified: string }
 blueprint TransmuteGrowRow { at_unix_ms: int, source: string, bytes_in: int, offered: list<string>, admitted: list<string>, known: int, register_before: int, register_after: int, voice: string }
 class TransmuteGrowRun {
  def tgr-admitted() = "learn/purify-admitted.jsonl";
  def tgr-ledger() = "receipts/transmute-grow-ledger.jsonl";
  def tgr-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def tgr-rest-go(acc) { let l = read_line(); nothing?(l) ? acc : tgr-rest-go(acc ++ l ++ "\n"); }
  def tgr-kinds(line) = map(w => tm-int(w), filter(w => len(w) > 0, split-on(line, " ")));
  def tgr-words(ds) = map(d => wfp-word(d), ds);
  def tgr-known() = map(r => row-get(r, "word"), ledger-rows(tgr-admitted(), "PurifyAdmitted"));
  def tgr-packet(d) = dc-card-core() ++ "\nThe word \"" ++ wfp-word(d) ++ "\" arrived in these words: \"" ++ wfp-common(d) ++ "\". In one short line, say how this word reads at its highest in this field, keeping what it reports true. Answer with that line only.";
  def tgr-ask(d, flag) = fcnv-ask(tgr-packet(d), (Comparable) len(flag) == 0 ? json-node-object([]) : json-node-object([oh-s("model", flag)]));
  def tgr-purified(d, flag) {
   let asked = (String) flag == "0" ? ["not-asked", ""] : tgr-ask(d, flag);
   (String) asked[0] == "answered" ? trim(asked[1]) : "";
  }
  def tgr-admit(source, d, flag) {
   let row = wfp-filled(d, tgr-purified(d, flag), nothing(), nothing(), nothing());
   let kept = ledger-append(tgr-admitted(), PurifyAdmitted{at_unix_ms: now_unix_ms(), source: source, word: wfp-word(row), common: wfp-common(row), purified: wfp-purified(row)});
   row;
  }
  def tgr-draft-lines(ds) = foldl((a, i) => a ++ "  " ++ i.str() ++ "  " ++ wfp-word(ds[i]) ++ " — arrived in: " ++ wfp-common(ds[i]) ++ "\n", "", 0 .. len(ds));
  def tgr-row-lines(rs) = foldl((a, r) => a ++ "  " ++ wfp-word(r) ++ " — here: " ++ ((Comparable) len(wfp-purified(r)) == 0 ? "(no reading drafted)" : wfp-purified(r)) ++ "\n", "", rs);
  def tgr-run() {
   let source = tgr-line();
   let acks = tgr-line();
   let flag = tgr-line();
   let passage = trim(tgr-rest-go(""));
   let known = tgr-known();
   let drafts = filter(d => !tm-in?(wfp-word(d), known), wfp-drafts(wfp-tokens(wfp-lower(passage))));
   let kept = stx-affirmed(drafts, tgr-kinds(acks));
   let rows = map(d => tgr-admit(source, d, flag), kept);
   let read = tm-grow-with(passage, rows);
   let said = print_str("[transmute-grow] source=" ++ ((Comparable) len(source) == 0 ? "(none)" : source) ++ " · " ++ len(passage).str() ++ " bytes in · drafts " ++ len(drafts).str() ++ " · admitted " ++ len(rows).str() ++ " · known from earlier readings " ++ len(known).str() ++ " · declined " ++ len(stx-declined(drafts, tgr-kinds(acks))).str() ++ " · still waiting " ++ len(stx-pending(drafts, tgr-kinds(acks))).str() ++" · " ++ tm-grow-line(read));
   let offered = nil?(drafts) ? 0 : print_str("offered (place · word · where it arrived):\n" ++ tgr-draft-lines(drafts));
   let told = nil?(rows) ? 0 : print_str("admitted:\n" ++ tgr-row-lines(rows));
   let kept2 = ledger-append(tgr-ledger(), TransmuteGrowRow{at_unix_ms: now_unix_ms(), source: source, bytes_in: len(passage), offered: tgr-words(drafts), admitted: tgr-words(rows), known: len(known), register_before: read[0], register_after: read[1], voice: (String) flag == "0" ? "not-asked" : "asked"});
   0;
  }
 }
 tgr-run();
}
