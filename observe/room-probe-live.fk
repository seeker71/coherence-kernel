; room-probe-live.fk — the organ's own frame cell over the live room, one line per
; 100 ms. This is where a threshold gets its number: from the room, not from taste.
; preludes: form/form-stdlib/room-sense.bml
(do
    (defn rpl-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (rpl-cat (tail xs)))))
    (defn rpl-line (n)
        (do (let raw (sense_mic_stream_read 3200 200))
            (let f (rs-frame raw (now_unix_ms) -500))
            (if (eq (len f) 0) 0 (print (rpl-cat (list
                "db=" (int_to_str (rs-db (rs-f-db f)))
                " vcd=" (int_to_str (rs-f-voiced f))
                " hz=" (int_to_str (rs-f-hz f))
                " r=" (int_to_str (rs-f-r f))
                " half=" (int_to_str (rs-f-half f))
                " tilt=" (int_to_str (rs-f-tilt f))
                " crest=" (int_to_str (rs-f-crest f))
                " mod=" (int_to_str (rs-f-mod f))))))
            (if (le n 1) 0 (rpl-line (sub n 1)))))
    (let mic (sense_mic_stream_start))
    (let r (rpl-line 130))
    (let s (sense_mic_stream_stop))
    66)
