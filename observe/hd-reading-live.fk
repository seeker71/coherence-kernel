; hd-reading-live.fk — one door: a birth moment in, a whole bodygraph out,
; computed here and said in the body's own closed vocabulary.
;
; stdin, one value per line: year, month, day, UT hour, UT minute.
; (Local time must already be converted to UT by the caller — the body holds no
; timezone table, and inventing one would be a guess wearing a number.)
;
; Everything below is DERIVED, not recalled: Keplerian elements solved for each
; planet, a Newton walk back to the moment the Sun sat 88 degrees behind its
; natal place, longitudes placed on the rave mandala wheel, channels read off
; the activated gates, and Type / Authority / Definition derived from the graph.
; The descriptions come from hd-core-words.fk, which is checked closed against
; core-lexicon.fk's 64 self-defining words.
;
; HONEST FLOOR, printed by the door itself rather than hidden in a comment:
; Pluto has no element row (JPL removed it from the table when it was
; reclassified), so two of the twenty-six activations are missing and a channel
; that only Pluto would complete cannot be seen. Moon and planet LINES are
; indicative at this ephemeris's accuracy; Sun and Earth lines are solid.
;
; preludes: form-stdlib/genekey-profile.fk
; preludes: form-stdlib/hd-bodygraph.fk
; preludes: form-stdlib/hd-core-words.fk

(do
    (defn hrl-int () (str_to_int (read_line)))
    (defn hrl-act (label lon)
        (print label " gate " (gate-at-longitude lon) "." (hgp-line lon)
               "   lon " lon))
    (defn hrl-gates-of (nf)
        (list (gate-at-longitude (hgp-sun nf))
              (gate-at-longitude (hgp-earth nf))
              (gate-at-longitude (hgp-moon nf))
              (gate-at-longitude (hgp-planet (mercury-elements) nf))
              (gate-at-longitude (hgp-planet (venus-elements) nf))
              (gate-at-longitude (hgp-planet (mars-elements) nf))
              (gate-at-longitude (hgp-planet (jupiter-elements) nf))
              (gate-at-longitude (hgp-planet (saturn-elements) nf))
              (gate-at-longitude (hgp-planet (uranus-elements) nf))
              (gate-at-longitude (hgp-planet (neptune-elements) nf))
              (gate-at-longitude (fnorm360 (node-omega-raw nf)))
              (gate-at-longitude (fnorm360 (add (node-omega-raw nf) 180.0)))))
    (defn hrl-app (a b) (if (eq (len a) 0) b (cons (head a) (hrl-app (tail a) b))))
    (defn hrl-column (tag nf)
        (do (print "-- " tag " --")
            (hrl-act "sun     " (hgp-sun nf))
            (hrl-act "earth   " (hgp-earth nf))
            (hrl-act "moon    " (hgp-moon nf))
            (hrl-act "mercury " (hgp-planet (mercury-elements) nf))
            (hrl-act "venus   " (hgp-planet (venus-elements) nf))
            (hrl-act "mars    " (hgp-planet (mars-elements) nf))
            (hrl-act "jupiter " (hgp-planet (jupiter-elements) nf))
            (hrl-act "saturn  " (hgp-planet (saturn-elements) nf))
            (hrl-act "uranus  " (hgp-planet (uranus-elements) nf))
            (hrl-act "neptune " (hgp-planet (neptune-elements) nf))
            (hrl-act "n-node  " (fnorm360 (node-omega-raw nf)))
            (hrl-act "s-node  " (fnorm360 (add (node-omega-raw nf) 180.0)))
            0))
    (defn hrl-say-centres (cl gs)
        (if (eq (len cl) 0) 0
            (do (let c (head cl))
                (print "  " (hdb-centre-name c)
                       (if (eq (hdb-centre-defined? gs c) 1) "  DEFINED  " "  open     ")
                       (hcw-sentence (hcw-k-centre) (hdb-centre-name c)))
                (hrl-say-centres (tail cl) gs))))

    (let y (hrl-int)) (let mo (hrl-int)) (let d (hrl-int))
    (let uth (hrl-int)) (let utm (hrl-int))
    (let nb (hgp-n y mo d uth utm))
    (let nd (hgp-design-n nb))
    (print "=== bodygraph, derived ===")
    (hrl-column "personality (birth)" nb)
    (hrl-column "design (88 deg of solar arc earlier)" nd)
    (let gs (hrl-app (hrl-gates-of nb) (hrl-gates-of nd)))
    (print "activated gates: " gs)
    (print "defined channels: " (hdb-defined-channels gs))
    (print "=== the nine centres ===")
    (hrl-say-centres (hdb-centres) gs)
    (let ty (hdb-type gs))
    (let au (hdb-authority gs))
    (print "=== the reading ===")
    (print "type       " ty "   :  " (hcw-sentence (hcw-k-type) ty))
    (print "authority  " au "   :  " (hcw-sentence (hcw-k-authority) au))
    (print "definition " (hdb-definition-name gs)
           "  (" (hdb-definition-count gs) " pieces)")
    (print "profile    " (hgp-line (hgp-sun nb)) "/" (hgp-line (hgp-sun nd)))
    (print "cross      " (gate-at-longitude (hgp-sun nb)) "/"
           (gate-at-longitude (hgp-earth nb)) " | "
           (gate-at-longitude (hgp-sun nd)) "/"
           (gate-at-longitude (hgp-earth nd)))
    (print "floor      pluto absent (no element row); moon and planet lines indicative")
    0)
