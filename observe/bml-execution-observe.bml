// preflight-exec: forbidden
// JSON stdin: home, action, condition, adapter; feedback also takes parent condition.
// Grade executes the proposals; inspect those files before requesting it.
// preludes: learn/bml-execution-observation.bml
section [form.bml] {
 def beo-run(raw) {
 let request = parse-json("BML observation request",raw);
 let home = nsm-str(request,"home"); let action = nsm-str(request,"action");
 if str_eq(action,"generate") then beo-generate(home,nsm-str(request,"condition"),nsm-str(request,"adapter"))
 else if str_eq(action,"ground") then beo-ground(home,nsm-str(request,"condition"),nsm-str(request,"adapter"))
 else if str_eq(action,"feedback") then beo-feedback(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),nsm-str(request,"parent"))
 else if str_eq(action,"focus") then beo-focus(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),nsm-str(request,"parent"))
 else if str_eq(action,"grade") then beo-grade(home,nsm-str(request,"condition"))
 else if str_eq(action,"enqueue") then beo-enqueue(home)
 else if str_eq(action,"status") then beo-status(home)
 else if str_eq(action,"report") then beo-report(home)
 else form_error("BML observation action requires generate, ground, feedback, focus, grade, enqueue, status or report");
 }
 beo-run(read_line());
 0;
}
