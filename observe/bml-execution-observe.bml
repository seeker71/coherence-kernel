// preflight-exec: forbidden
// JSON stdin: home, action, condition, adapter; feedback also takes parent condition.
// Grade executes the proposals; inspect those files before requesting it.
// preludes: learn/bml-execution-observation.bml
section [form.bml] {
 def beo-run(raw) {
 let request = parse-json("BML observation request",raw);
 let home = nsm-str(request,"home"); let action = nsm-str(request,"action");
 (String) action == "generate" ? beo-generate(home,nsm-str(request,"condition"),nsm-str(request,"adapter"))
 : (String) action == "ground" ? beo-ground(home,nsm-str(request,"condition"),nsm-str(request,"adapter"))
 : (String) action == "feedback" ? beo-feedback(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),nsm-str(request,"parent"))
 : (String) action == "focus" ? beo-focus(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),nsm-str(request,"parent"))
 : (String) action == "grade" ? beo-grade(home,nsm-str(request,"condition"))
 : (String) action == "enqueue" ? beo-enqueue(home)
 : (String) action == "status" ? beo-status(home)
 : (String) action == "report" ? beo-report(home)
 : form_error("BML observation action requires generate, ground, feedback, focus, grade, enqueue, status or report");
 }
 beo-run(read_line());
 0;
}
