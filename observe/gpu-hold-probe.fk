; gpu-hold-probe.fk — a deliberately BARE long Metal-touching hold, for
; announced organlease discriminator slots (corpus rows 1093 organlease,
; 1105 doubledelta, 1114 bareprobe).
;
; The probe stays plain-launched on purpose: wrapping it in setsid would
; protect the process and blind the experiment — its exposure IS the
; measurement. Pair it with an equally bare, equally long CPU-only fkwu
; spin so the pair differs in exactly ONE axis (Metal), per doubledelta.
; Read the outcome from rc files, never from the processes
; (reference-detached-processes-need-setsid.md): rc present = survived;
; process gone without rc = killed externally.
;
; Iterations arrive in /tmp/gpu-hold-probe-iters (one integer, NO trailing
; newline: printf '%s' N > file). SHARED GROUND caveat, same as
; conflict-mark-scan-run.fk: if another lane is live, write a distinct
; file and change the one line below. Absent file -> 1 iteration (a quick
; self-test; expect 22).
;
; fkwu-only by nature: the metal door lane does not exist on the proof
; walkers; preflight reports those names as lane seams, not typos.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/metal-door.fk form-stdlib/language-model.fk form-stdlib/form-cli-jit.bml

(do
    (defn ghp-iters-file () "/tmp/gpu-hold-probe-iters")
    (defn ghp-iters ()
        (if (eq (fs_exists (ghp-iters-file)) 0) 1
            (str_to_int (read_file (ghp-iters-file)))))
    (defn ghp-loop (n last)
        (if (le n 0) last
            (ghp-loop (sub n 1) (fjit-apply (Metal) (Sample)))))
    (ghp-loop (ghp-iters) 0))
