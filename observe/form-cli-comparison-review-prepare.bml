// preflight-exec: forbidden
// Prepare only: no provider or local model is admitted by this door.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let packet = fcr-packet(fcr-original-review());
 let original = fcr-body(packet); let restored = fcr-grounded(original);
 let goal = fcr-goal(packet); let manifest = fcr-manifest(restored,goal);
 fcr-need(frsy-valid(manifest),"restored comparison manifest refused");
 fcr-need(frsy-sources(node_children(json-object-get(manifest,"cases"))),"comparison source assertion failed");
 let root = ".hearth/response-parity/source-restored-v1";
 fs-mkdir(".hearth/response-parity"); fs-mkdir(root);
 frsh-frozen(str_concat(root,"/manifest.json"),json-emit(manifest));
 frsh-frozen(str_concat(root,"/source.json"),json-emit(restored));
 let normalized = fcr-manifest(original,goal);
 let result = json-node-object(list(nsm-s("manifest_path",str_concat(root,"/manifest.json")),nsm-n("normalized_prior_prompt_bytes",str_len(frsy-prompt(normalized))),nsm-n("restored_prompt_bytes",str_len(frsy-prompt(manifest))),nsm-n("historical_sections",len(node_children(json-object-get(json-object-get(json-object-get(restored,"evidence"),"candidate_historical_grounding"),"source_sections")))),nsm-n("provider_calls",0),nsm-n("local_model_calls",0),nsm-n("training",0)));
 frsh-frozen(str_concat(root,"/preparation.json"),json-emit(result));
 print_str(json-emit(result));
 1;
}
