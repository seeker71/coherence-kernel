// q38-session-spec-run.bml — the model session lane's greedy walk, plain and speculative, through the session API (fcms-open-*, fcms-generate).
//
//   echo '{}' | ./fkwu observe/q38-session-spec-run.bml            the plan. Opens nothing.
//   echo '{"go":1,"which":"code","n":64}' | ./fkwu observe/q38-session-spec-run.bml
//                                                                  a session is opened (its default walk is the speculative one), says a warm-up walk (untimed: pipelines compiled, weight
//                                                                  pages in, the drafter's rows hot), then n tokens timed; the verify path's own greedy decode of the same prompt is the reference
//                                                                  for those ids; then a second session says the same two walks by the plain planned walk (fcms-generate-plain): tok/s of each.
//   echo '{"go":1,"mode":"tapab","reps":3}' | ./fkwu observe/q38-session-spec-run.bml
//                                                                  what capturing the tapped hidden states costs inside the prefill: the same ~330-token prompt through the session's prefill
//                                                                  slices with the tap and without it, alternated on fresh states; the first predicted token must be the same.
// stdin, one JSON line, all optional: go, mode (walk | tapab), which (sky | code | prose | json | long | a prompt text via "prompt"), n (64), warm (8), spec (1), plain (1), ref (1), reps (1).
// The reference needs a prompt of at most 64 tokens (the session's scratch is as wide as its prompt, capped at 64): the door says so and skips it otherwise.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/form-cli-model-session.fk form-stdlib/bml/qwen38-spec-witness.bml form-stdlib/lora-adapter.bml form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class Q38SessionSpecRun {
  def qss-file() = "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
  def qss-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def qss-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def qss-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("q38-session-spec", line) : json-node-object([]);
  }
  def qss-say(s) = print_str("[q38-session-spec] " ++ s);
  def qss-idstr(xs) = foldl((acc, x) => acc ++ x.str() ++ " ", "", xs);
  def qss-prompt(which) = which == "sky" ? "Explain in two sentences why the sky is blue." : which == "code" ? "Write a Python function that checks whether a string is a palindrome." : which == "prose" ? "Write a short paragraph about autumn in a quiet mountain village." : which == "json" ? "Reply with only a JSON array of four objects, each with the keys \"tool\" and \"args\", that call the tool read_file on src/main.rs, src/lib.rs, Cargo.toml and README.md." : which == "long" ? "Write a Python class that implements a binary search tree with insert, search and in-order traversal methods." : which;
  def qss-rate10(n, ms) = ms <= 0 ? 0 : (n * 10000) / ms;
  def qss-rate(n, ms) = (qss-rate10(n, ms) / 10).str() ++ "." ++ (qss-rate10(n, ms) % 10).str();
  def qss-same-go(a, b, i, same) = i >= len(a) || i >= len(b) ? same : qss-same-go(a, b, i + 1, a[i] == b[i] ? same + 1 : same);
  def qss-open(path, prompt, n) = fcms-open-reserved(path, prompt, n + 64, "knowledge-query");
  // one walk of n tokens, timed: [ids, ms, the generation's spec note, the session after it]
  def qss-walk(s, n, spec) {
   let t0 = host_monotonic_ms();
   let g = spec == 1 ? fcms-generate(s, n) : fcms-generate-plain(s, n);
   let t1 = host_monotonic_ms();
   [fcms-generation-ids(g), t1 - t0, fcms-generation-spec(g), fcms-generation-session(g)];
  }
  // the verify path's greedy decode of the prompt: the lane prefill's first token, then n - 1 one-row checks
  def qss-ref(s, ids, n) {
   let o = fcsp-owner(s);
   let ctx = fcms-ctx(s);
   let sx = q38s-open(ctx, 8, 8);
   let sts = q38-new-state(ctx[2]);
   let r = q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
   let a = q38sw-ref-go(ctx, record_get(o, "qs"), sts, sx, r[0], len(ids), n - 1, [], []);
   let f1 = q38-free-state(sts);
   let f2 = q38s-close(sx);
   cons(r[0], a[0]);
  }
  def qss-refused(s) {
   qss-say("the session did not open: " ++ fcms-reason(s));
   [[], 0, "", []];
  }
  // a session: the warm-up walk, the timed walk, the reference of the timed walk's ids: [ids, ms, note, reference slice, open ms]
  def qss-session(path, prompt, ids, n, warm, spec, ref) {
   let t0 = host_monotonic_ms();
   let s = qss-open(path, prompt, n + warm);
   let open-ms = host_monotonic_ms() - t0;
   !((Comparable) fcms-live?(s) == 1) ? qss-refused(s) : qss-session-live(s, ids, n, warm, spec, ref, open-ms);
  }
  def qss-session-live(s, ids, n, warm, spec, ref, open-ms) {
   let o = fcsp-owner(s);
   qss-say((spec == 1 ? "spec  " : "plain ") ++ "session open in " ++ open-ms.str() ++ " ms: spec owner " ++ (q38x-on?(o) == 1 ? "on" : "off: " ++ (String) record_get(o, "reason")) ++ ", committed " ++ (q38x-on?(o) == 1 ? record_get(o, "committed").str() : "-") ++ " of pos " ++ fcms-pos(s).str() ++ (q38x-on?(o) == 1 ? "; spec open ms [pipelines, drafter, scratch] " ++ record_get(o, "open-ms").str() : ""));
   let w1 = warm > 0 ? qss-walk(s, warm, spec) : [[], 0, "", s];
   let w2 = qss-walk(w1[3], n, spec);
   let start = warm > 0 ? warm - 1 : 0;
   let rf = ref == 1 && len(ids) <= 64 ? qss-ref(w2[3], ids, n + warm) : [];
   ref == 1 && len(ids) > 64 ? qss-say("reference skipped: the prompt is " ++ len(ids).str() ++ " tokens (scratch holds 64)") : 0;
   let released = fcms-release-ok?(w2[3]);
   released == 1 ? 0 : qss-say("RELEASE INCOMPLETE");
   [w2[0], w2[1], w2[2], take(len(w2[0]), drop(start, rf)), open-ms];
  }
  def qss-show(label, n, r) {
   qss-say(label ++ ": " ++ len(r[0]).str() ++ " tokens in " ++ r[1].str() ++ " ms = " ++ qss-rate(len(r[0]), r[1]) ++ " tok/s; " ++ (String) r[2]);
   len(r[3]) > 0 ? qss-say(label ++ " ids vs the verify path's greedy decode: " ++ (qss-idstr(r[0]) == qss-idstr(r[3]) ? "IDENTICAL" : "DIFFER") ++ " (" ++ qss-same-go(r[0], r[3], 0, 0).str() ++ " of " ++ len(r[0]).str() ++ ")") : 0;
   r;
  }
  def qss-reps(path, prompt, ids, n, warm, spec, ref, reps, label, acc) = reps <= 0 ? acc : qss-reps(path, prompt, ids, n, warm, spec, ref, reps - 1, label, append(acc, [qss-show(label, n, qss-session(path, prompt, ids, n, warm, spec, ref))]));
  def qss-best(rows) = foldl((m, r) => (m < 0 || r[1] < m) ? r[1] : m, 0 - 1, rows);
  def qss-walks(path, which, prompt, n, warm, spec, plain, ref, reps) {
   let src = fcmg-src(path);
   let ids = q35-chat-ids(src, prompt);
   qss-say("prompt " ++ which ++ ": " ++ len(ids).str() ++ " tokens; warm-up " ++ warm.str() ++ ", timed " ++ n.str());
   let rs = spec == 1 ? qss-reps(path, prompt, ids, n, warm, 1, ref, reps, "spec ", []) : [];
   let rp = plain == 1 ? qss-reps(path, prompt, ids, n, warm, 0, 0, reps, "plain", []) : [];
   spec == 1 && len(rs) > 0 ? qss-say("spec  ids: " ++ qss-idstr(rs[0][0])) : 0;
   plain == 1 && len(rp) > 0 ? qss-say("plain ids: " ++ qss-idstr(rp[0][0])) : 0;
   spec == 1 && plain == 1 && len(rs) > 0 && len(rp) > 0 ? qss-say("spec ids vs plain walk ids: " ++ qss-same-go(rs[0][0], rp[0][0], 0, 0).str() ++ " of " ++ len(rs[0][0]).str() ++ " positions agree; best of " ++ reps.str() ++ ": spec " ++ qss-best(rs).str() ++ " ms = " ++ qss-rate(n, qss-best(rs)) ++ " tok/s, plain " ++ qss-best(rp).str() ++ " ms = " ++ qss-rate(n, qss-best(rp)) ++ " tok/s, ratio " ++ ((qss-best(rp) * 100) / (qss-best(rs) <= 0 ? 1 : qss-best(rs))).str() ++ "/100") : 0;
   1;
  }
  // ── what the tap costs in the prefill ──
  def qss-long() = "Read this carefully and then summarise it in one sentence. The kernel keeps its state in a few resident places: the weights, one stream of keys and values, and a small recurrent state per layer. A turn of work adds observations to the stream and reads the model's next words from it. When the stream grows long the body renews it and starts a fresh one over the same weights. Every tool the agent calls returns bytes that enter the stream as an observation, and the agent answers with a plan, an edit, or a check. The drafter proposes a block of tokens at once, the model checks the block in a single pass over its weights, and what the model accepts is bandwidth the wall did not charge for. A session that opened plainly keeps speaking plainly; a session that opened with a drafter speaks faster while its prompt lasts. Summarise.";
  def qss-pf(ctx, ids, tap) {
   let sts = q38-new-state(ctx[2]);
   let t0 = host_monotonic_ms();
   let r = fcmo-prefill-t(ctx, sts, ids, 0, tap);
   let t1 = host_monotonic_ms();
   let f = q38-free-state(sts);
   [t1 - t0, r[0], r[1]];
  }
  def qss-tapab-go(ctx, ids, tap, reps, acc) = reps <= 0 ? acc : {
   let a = qss-pf(ctx, ids, nothing());
   let b = qss-pf(ctx, ids, tap);
   qss-say("prefill " ++ len(ids).str() ++ " tokens: without the tap " ++ a[0].str() ++ " ms, with it " ++ b[0].str() ++ " ms; first predicted token " ++ a[1].str() ++ " / " ++ b[1].str());
   qss-tapab-go(ctx, ids, tap, reps - 1, append(acc, [[a[0], b[0], a[1] == b[1] ? 1 : 0]]));
  };
  def qss-min-col(rows, k) = foldl((m, r) => (m < 0 || r[k] < m) ? r[k] : m, 0 - 1, rows);
  def qss-tapab(path, reps) {
   let src = fcmg-src(path);
   let ids = q35-chat-ids(src, qss-long());
   let s = qss-open(path, qss-long(), 16);
   !((Comparable) fcms-live?(s) == 1) ? qss-say("the session did not open: " ++ fcms-reason(s)) : qss-tapab-live(s, ids, reps);
  }
  def qss-tapab-live(s, ids, reps) {
   let o = fcsp-owner(s);
   qss-say("open: spec owner " ++ (q38x-on?(o) == 1 ? "on" : "off: " ++ (String) record_get(o, "reason")) ++ ", prompt " ++ len(ids).str() ++ " tokens, prefill slice " ++ q38-ctx-span(fcms-ctx(s)).str());
   let rows = qss-tapab-go(fcms-ctx(s), ids, q38x-tap(o), reps + 1, []);
   let kept = drop(1, rows);
   qss-say("tap cost over the prefill (best of " ++ len(kept).str() ++ ", the first pair is warm-up): without " ++ qss-min-col(kept, 0).str() ++ " ms, with " ++ qss-min-col(kept, 1).str() ++ " ms; same first token every pair: " ++ (foldl((a, r) => a * r[2], 1, kept)).str());
   let released = fcms-release-ok?(s);
   qss-say("released " ++ released.str());
   1;
  }
  // ── pairs: two sessions of one prompt open together (one speculative, one plain), asked in turn a chunk at a time ──
  // The machine's weather changes the speed of everything by 2x and more from one minute to the next, so what is compared is a PAIR of walks taken a moment apart:
  // the speculative session's chunk, then the plain session's, round after round. The ratio of a pair is the speedup of that moment; the best of each is the clean-window figure.
  def qss-pair-go(sa, sb, chunk, rounds, i, acc) {
   i >= rounds ? acc : qss-pair-round(sa, sb, chunk, rounds, i, acc);
  }
  def qss-pair-round(sa, sb, chunk, rounds, i, acc) {
   let wa = qss-walk(sa, chunk, 1);
   let wb = qss-walk(sb, chunk, 0);
   let ratio = (wb[1] * len(wa[0]) * 100) / ((wa[1] <= 0 ? 1 : wa[1]) * (len(wb[0]) <= 0 ? 1 : len(wb[0])));
   qss-say("round " ++ i.str() ++ ": spec " ++ len(wa[0]).str() ++ " tokens in " ++ wa[1].str() ++ " ms = " ++ qss-rate(len(wa[0]), wa[1]) ++ " tok/s; plain " ++ len(wb[0]).str() ++ " in " ++ wb[1].str() ++ " ms = " ++ qss-rate(len(wb[0]), wb[1]) ++ " tok/s; ratio " ++ ratio.str() ++ "/100; " ++ (String) wa[2]);
   qss-pair-go(wa[3], wb[3], chunk, rounds, i + 1, append(acc, [[wa[1], len(wa[0]), wb[1], len(wb[0]), ratio]]));
  }
  def qss-insert(x, xs) = len(xs) == 0 ? [x] : x <= xs[0] ? cons(x, xs) : cons(xs[0], qss-insert(x, xs[1:]));
  def qss-sorted(xs) = foldl((acc, x) => qss-insert(x, acc), [], xs);
  def qss-pairs(path, which, prompt, chunk, rounds, warm) {
   qss-say("pairs: prompt " ++ which ++ ", " ++ rounds.str() ++ " rounds of " ++ chunk.str() ++ " tokens, warm-up " ++ warm.str());
   let sa = qss-open(path, prompt, chunk * rounds + warm + 32);
   let sb = qss-open(path, prompt, chunk * rounds + warm + 32);
   !((Comparable) fcms-live?(sa) == 1) || !((Comparable) fcms-live?(sb) == 1) ? qss-say("a session did not open: " ++ fcms-reason(sa) ++ " / " ++ fcms-reason(sb)) : qss-pairs-live(sa, sb, chunk, rounds, warm);
  }
  def qss-pairs-live(sa, sb, chunk, rounds, warm) {
   qss-say("spec session: owner " ++ (q38x-on?(fcsp-owner(sa)) == 1 ? "on" : "off: " ++ (String) record_get(fcsp-owner(sa), "reason")));
   let wa = warm > 0 ? qss-walk(sa, warm, 1) : [[], 0, "", sa];
   let wb = warm > 0 ? qss-walk(sb, warm, 0) : [[], 0, "", sb];
   let rows = qss-pair-go(wa[3], wb[3], chunk, rounds, 0, []);
   let ratios = qss-sorted(map(r => r[4], rows));
   let bs = foldl((m, r) => (m < 0 || r[0] * 1000 / (r[1] <= 0 ? 1 : r[1]) < m) ? r[0] * 1000 / (r[1] <= 0 ? 1 : r[1]) : m, 0 - 1, rows);
   let bp = foldl((m, r) => (m < 0 || r[2] * 1000 / (r[3] <= 0 ? 1 : r[3]) < m) ? r[2] * 1000 / (r[3] <= 0 ? 1 : r[3]) : m, 0 - 1, rows);
   qss-say("pairs summary: ratio median " ++ ratios[len(ratios) / 2].str() ++ "/100, lowest " ++ ratios[0].str() ++ "/100, highest " ++ ratios[len(ratios) - 1].str() ++ "/100; best spec " ++ (bs / 1000).str() ++ "." ++ ((bs % 1000) / 100).str() ++ " ms a token = " ++ qss-rate(1000, bs) ++ " tok/s, best plain " ++ (bp / 1000).str() ++ "." ++ ((bp % 1000) / 100).str() ++ " ms a token = " ++ qss-rate(1000, bp) ++ " tok/s; best-pair ratio " ++ ((bp * 100) / (bs <= 0 ? 1 : bs)).str() ++ "/100");
   let ra = fcms-release-ok?(sa);
   let rb = fcms-release-ok?(sb);
   qss-say("released " ++ ra.str() ++ " " ++ rb.str());
   1;
  }
  // ── plainab: the session's plain walks, the planned step against the token-wise forward, a chunk each in turn on ONE session (both are plain: the drafter is not asked) ──
  def qss-unplanned(s, n) {
   let t0 = host_monotonic_ms();
   let walked = fcms-walk-by(fcms-forward, s, fcms-pending(s), fcms-pos(s), n, fcmo-stops(s), [], 1, 1, 0);
   let t1 = host_monotonic_ms();
   let next = fcms-with-stream(s, walked[2], walked[1], walked[3], fcms-generated-ids(s) + len(walked[0]), fcms-injected-ids(s), fcms-observations(s));
   [walked[0], t1 - t0, "unplanned", next];
  }
  def qss-plainab-go(s, chunk, rounds, i) = i >= rounds ? 1 : qss-plainab-round(s, chunk, rounds, i, qss-walk(s, chunk, 0));
  def qss-plainab-round(s, chunk, rounds, i, wp) {
   let wu = qss-unplanned(wp[3], chunk);
   qss-say("round " ++ i.str() ++ ": planned " ++ len(wp[0]).str() ++ " tokens in " ++ wp[1].str() ++ " ms = " ++ (wp[1] / (len(wp[0]) <= 0 ? 1 : len(wp[0]))).str() ++ " ms a token; unplanned " ++ len(wu[0]).str() ++ " in " ++ wu[1].str() ++ " ms = " ++ (wu[1] / (len(wu[0]) <= 0 ? 1 : len(wu[0]))).str() ++ " ms a token");
   qss-plainab-go(wu[3], chunk, rounds, i + 1);
  }
  def qss-plainab(path, prompt, chunk, rounds) {
   let s = qss-open(path, prompt, chunk * rounds * 2 + 48);
   !((Comparable) fcms-live?(s) == 1) ? qss-say("the session did not open: " ++ fcms-reason(s)) : qss-plainab-live(s, chunk, rounds);
  }
  def qss-plainab-live(s, chunk, rounds) {
   let w = qss-walk(s, 8, 0);
   qss-plainab-go(w[3], chunk, rounds, 0);
   let released = fcms-release-ok?(w[3]);
   1;
  }
  // ── rowab: what ONE token costs three ways, a chunk each in turn: the session's speculative walk held to one-row checks (no draft: the matrix-unit verify of the pending token alone),
  // the plain planned step, the plain token-wise forward. The first on a session of its own (its drafter has to hold every position), the other two on a second session ──
  def qss-rowab-go(sa, sb, chunk, rounds, i) = i >= rounds ? 1 : qss-rowab-round(sa, sb, chunk, rounds, i, qss-walk(sa, chunk, 1));
  def qss-rowab-round(sa, sb, chunk, rounds, i, wa) {
   let wp = qss-walk(sb, chunk, 0);
   let wu = qss-unplanned(wp[3], chunk);
   qss-say("round " ++ i.str() ++ " ms a token: one-row check " ++ (wa[1] / (len(wa[0]) <= 0 ? 1 : len(wa[0]))).str() ++ ", plain planned " ++ (wp[1] / (len(wp[0]) <= 0 ? 1 : len(wp[0]))).str() ++ ", plain token-wise " ++ (wu[1] / (len(wu[0]) <= 0 ? 1 : len(wu[0]))).str() ++ " (" ++ (String) wa[2] ++ ")");
   qss-rowab-go(wa[3], wu[3], chunk, rounds, i + 1);
  }
  def qss-rowab(path, prompt, chunk, rounds) {
   let sa = qss-open(path, prompt, chunk * rounds + 48);
   let sb = qss-open(path, prompt, chunk * rounds * 2 + 48);
   !((Comparable) fcms-live?(sa) == 1) || !((Comparable) fcms-live?(sb) == 1) ? qss-say("a session did not open") : qss-rowab-live(sa, sb, chunk, rounds);
  }
  def qss-rowab-live(sa, sb, chunk, rounds) {
   let o = fcsp-owner(sa);
   record_set(o, "kcur", 0);
   let w0 = qss-walk(sa, 8, 1);
   let w1 = qss-walk(sb, 8, 0);
   qss-rowab-go(w0[3], w1[3], chunk, rounds, 0);
   let ra = fcms-release-ok?(w0[3]);
   let rb = fcms-release-ok?(w1[3]);
   1;
  }
  // ── quanta: the code lane's own decode loop (form-cli-code-session.bml): a quantum of fcac-quantum IDs, then the boundary forward (fcacs-next), until `target` IDs are said.
  // Two sessions of one prompt, the first as the lane takes it by default (speculative while its drafter holds the stream), the second held plain (its owner's mode set to plain: the
  // lane's token-wise quanta of four); a round is a chunk of each, in turn ──
  def qss-quanta-go(s, stops, target, said, ms) = said >= target || fcms-stopped?(s) || !((Comparable) fcms-live?(s) == 1) ? [s, said, ms] : qss-quanta-step(s, stops, target, said, ms, host_monotonic_ms());
  def qss-quanta-step(s, stops, target, said, ms, t0) {
   let o = fcsp-owner(s);
   let wide = !nothing?(o) && record_has(o, "width") ? record_get(o, "width") : fcac-quantum(s);
   let g = fcacs-quantum(s, stops, wide);
   let s1 = fcms-generation-session(g);
   let s2 = fcms-stopped?(s1) || !((Comparable) fcms-live?(s1) == 1) ? s1 : fcacs-next(s1, stops);
   qss-quanta-go(s2, stops, target, said + len(fcms-generation-ids(g)), ms + (host_monotonic_ms() - t0));
  }
  def qss-quanta-round(sa, sb, target, rounds, i) {
   i >= rounds ? 1 : qss-quanta-pair(sa, sb, target, rounds, i, qss-quanta-go(sa, fcmo-stops(sa), target, 0, 0));
  }
  def qss-quanta-pair(sa, sb, target, rounds, i, ra) {
   let rb = qss-quanta-go(sb, fcmo-stops(sb), target, 0, 0);
   let ratio = (rb[2] * ra[1] * 100) / ((ra[2] <= 0 ? 1 : ra[2]) * (rb[1] <= 0 ? 1 : rb[1]));
   qss-say("round " ++ i.str() ++ ": lane default " ++ ra[1].str() ++ " ids in " ++ ra[2].str() ++ " ms = " ++ qss-rate(ra[1], ra[2]) ++ " tok/s (quantum " ++ fcac-quantum(ra[0]).str() ++ "); held plain " ++ rb[1].str() ++ " ids in " ++ rb[2].str() ++ " ms = " ++ qss-rate(rb[1], rb[2]) ++ " tok/s (quantum " ++ fcac-quantum(rb[0]).str() ++ "); ratio " ++ ratio.str() ++ "/100; spec " ++ (String) fcms-spec-why(ra[0], 2));
   qss-quanta-round(ra[0], rb[0], target, rounds, i + 1);
  }
  def qss-quanta(path, prompt, target, rounds, width) {
   let sa = qss-open(path, prompt, target * rounds + 64);
   let sb = qss-open(path, prompt, target * rounds + 64);
   !((Comparable) fcms-live?(sa) == 1) || !((Comparable) fcms-live?(sb) == 1) ? qss-say("a session did not open") : qss-quanta-live(sa, sb, target, rounds, width);
  }
  def qss-quanta-live(sa, sb, target, rounds, width) {
   width > 0 ? record_set(fcsp-owner(sa), "width", width) : 0;
   record_set(fcsp-owner(sb), "mode", "plain");
   record_set(fcsp-owner(sb), "reason", "spec-off:held-plain-by-the-door");
   qss-quanta-round(sa, sb, target, rounds, 0);
   let ra = fcms-release-ok?(sa);
   let rb = fcms-release-ok?(sb);
   qss-say("released " ++ ra.str() ++ " " ++ rb.str());
   1;
  }
  def qss-main() {
   let opts = qss-opts();
   let which = qss-text(opts, "which", "sky");
   let mode = qss-text(opts, "mode", "walk");
   qss-int(opts, "go", 0) != 1 ? qss-say("plan: go=1 opens a session on " ++ qss-file() ++ " and says n tokens speculatively (the session's default walk), against the verify path's greedy decode and the plain planned walk; mode tapab times the prefill with and without the tap; mode pairs alternates a speculative and a plain session a chunk at a time") : mode == "quanta" ? qss-quanta(qss-file(), qss-text(opts, "prompt", qss-prompt(which)), qss-int(opts, "target", 32), qss-int(opts, "rounds", 4), qss-int(opts, "width", 0)) : mode == "rowab" ? qss-rowab(qss-file(), qss-text(opts, "prompt", qss-prompt(which)), qss-int(opts, "chunk", 16), qss-int(opts, "rounds", 4)) : mode == "plainab" ? qss-plainab(qss-file(), qss-text(opts, "prompt", qss-prompt(which)), qss-int(opts, "chunk", 16), qss-int(opts, "rounds", 4)) : mode == "pairs" ? qss-pairs(qss-file(), which, qss-text(opts, "prompt", qss-prompt(which)), qss-int(opts, "chunk", 32), qss-int(opts, "rounds", 4), qss-int(opts, "warm", 8)) : mode == "tapab" ? qss-tapab(qss-file(), qss-int(opts, "reps", 3)) : qss-walks(qss-file(), which, qss-text(opts, "prompt", qss-prompt(which)), qss-int(opts, "n", 64), qss-int(opts, "warm", 8), qss-int(opts, "spec", 1), qss-int(opts, "plain", 1), qss-int(opts, "ref", 1), qss-int(opts, "reps", 1));
  }
 }
 qss-main();
}
