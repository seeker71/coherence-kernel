; qwen38-chat-ids-identity-run.fk — the wired lane's identity witness at the
; chat-ids level: reference fcmg composition vs the indexed lane, both
; profiles' hot path (knowledge-query), element-wise, plus the four special
; ids implicitly. Run once per wiring change.
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (defn qci-path () "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn qci-prompt ()
        "You are steering this body's next step. The measured state right now: the build chain is rebuilding form-cli in the background; ten frontier rows just landed in the corpus (band 32767 full); the v3 audit scored 13 of 30 with axioms, learn, teachings, control, ingest at zero; the census counted 5960 sources. Choose exactly ONE door to run now and say why in one sentence.\n\ndoor 1: run the corpus band (verify the ten new rows hold)\ndoor 2: probe axioms retrieval (the zero family; retrieval speed matters for teaching)\ndoor 3: count the census sources (fresh denominator)\n\nAnswer with the door number first.")
    (defn qci-same (a b i)
        (if (not (eq (len a) (len b))) 0
            (if (eq i (len a)) 1
                (if (eq (nth a i) (nth b i)) (qci-same a b (add i 1)) 0))))

    (let path (qci-path))
    (let src (fcmg-src path))
    (let tfx (qtf2-load (qtf2-root-for path) (qsx-seal-line path)))
    (print (str_concat "index_status=" (qtf2-index-status tfx)))
    (let a0 (now_unix_ms))
    (let ref (q35-chat-ids src (qci-prompt)))
    (let a1 (now_unix_ms))
    (print (str_concat "reference_chat_ms=" (int_to_str (sub a1 a0))))
    (let b0 (now_unix_ms))
    (let idx (qei-chat-ids-profile src tfx (qci-prompt) "knowledge-query"))
    (let b1 (now_unix_ms))
    (print (str_concat "indexed_chat_ms=" (int_to_str (sub b1 b0))))
    (print (str_concat "reference_n=" (int_to_str (len ref))))
    (print (str_concat "indexed_n=" (int_to_str (len idx))))
    (print (str_concat "identical=" (int_to_str (qci-same ref idx 0))))
    0)
