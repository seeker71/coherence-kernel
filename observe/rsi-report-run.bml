// rsi-report-run.bml — one run of Terminal-RSI's rounds read back from receipts/rsi-rounds.jsonl as a table.
//   printf '{"run":"rsi-..."}' | ./fkwu observe/rsi-report-run.bml      (no run: the last run the receipts hold)
// Each eval line carries its change against round 0's eval; each train line its critic calibration and its lessons.
// preflight-exec: forbidden
import form-stdlib/bml/rsi-rounds.bml;
section [form.bml] {
 rsi-report(dop-doc("rsi-report", stdin-text(), [["run", "str"], ["receipts", "str"]]));
 0;
}
