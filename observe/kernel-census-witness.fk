; kernel-census-witness.fk — the roots, the floats and the node census, moving under real work.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-live.bml form/form-stdlib/meaning-codes.bml
;
; The band proves the arithmetic. This proves the lanes are alive: it reads the census, does
; real work, and reads the census again. Nothing here is synthetic; the deltas are whatever
; the body did. Two workloads, because they answer differently and the difference is the
; teaching:
;
;   A  the locale-row walk -- every meaning round-tripping through every code, the workload
;      observe/bearing-census-locale-run.fk leans on. Seconds of string work.
;   B  the glass observing itself -- forty frames of the row build fgl-loop runs.
;   C  attributed interning -- intern_node_at, the only door that records a root.
;
; A and B move NOTHING in this census, and that is the finding: seconds of string work and
; thousands of observation rows never touch the value-node table. The table fills at COMPILE,
; and it fills again when a cell is interned; run this with the shared field closed
; (fkwu.conf: FK_FIELD_OFF 1) to watch a cold body fill from zero instead of reading the
; two million cells every kernel on this host already shares.
;
; The order is the method: READ, WORK, READ, and say what moved.

(do
    (defn kcw-say (label v) (print_str (str_concat (str_concat label " ") (int_to_str v))))
    (defn kcw-delta (label before after)
        (print_str (str_concat (str_concat label " ")
            (str_concat (int_to_str before) (str_concat " -> " (str_concat (int_to_str after)
                (str_concat "   (" (str_concat (int_to_str (sub after before)) ")"))))))))
    ; the glass's own frame work: build the kernel rows and give each one an observation
    ; node, exactly as fgl-loop does every frame. This is where the body mints.
    (defn kcw-frames (i n)
        (if (gt i n) 0
            (do
                (let built (fgo-observe-rows (fgl-kernel-rows) (now_unix_ms) i))
                (if (gt i n) 0 (add (len built) (kcw-frames (add i 1) n))))))
    (defn kcw-interns (i n cat)
        (if (gt i n) 0
            (do
                (intern_node_at cat (list (mul i 13)) "observe/kernel-census-witness.fk" 7 (mod i 40))
                (kcw-interns (add i 1) n cat))))
    (defn kcw-home ()
        (if (gt (kernel_stat 60) 0) "ice (the shared field, /fg-field-*)"
            (if (gt (kernel_stat 59) 0) "water (the per-pid store, /fg-c<pid>-*)"
                (if (gt (kernel_stat 58) 0) "gas (the private heap)" "no population yet"))))

    (let nodes0 (kernel_stat 4))
    (let gas0 (kernel_stat 58))
    (let water0 (kernel_stat 59))
    (let ice0 (kernel_stat 60))
    (let arena0 (kernel_stat 61))
    (let priv0 (kernel_stat 62))
    (let rec0 (kernel_stat 9))
    (let std0 (kernel_stat 54))
    (let ent0 (kernel_stat 12))
    (let fill0 (kernel_stat 8))
    (let fcap0 (kernel_stat 56))
    (let ffld0 (kernel_stat 57))
    (let mint0 (kernel_stat 53))

    (let s1 (print_str (str_concat "home: " (kcw-home))))
    (let s2 (print_str "A: every meaning round-tripping through every code..."))
    (let t0 (now_unix_ms))
    (let round (mc-all-round? (mc-meanings)))
    (let t1 (now_unix_ms))
    (let s3 (kcw-say "  round-tripped:" round))
    (let s4 (kcw-say "  milliseconds:" (sub t1 t0)))
    (let s4a (kcw-say "  nodes minted by A:" (sub (kernel_stat 53) mint0)))
    (let s4b (kcw-say "  roots recorded by A:" (sub (kernel_stat 9) rec0)))
    (let s4c (print_str "B: the glass observing itself, forty frames of its own row build..."))
    (let t2 (now_unix_ms))
    (let framed (kcw-frames 1 40))
    (let t3 (now_unix_ms))
    (let s4d (kcw-say "  rows built:" framed))
    (let s4e (kcw-say "  milliseconds:" (sub t3 t2)))
    (let s4f (kcw-say "  nodes minted by A+B:" (sub (kernel_stat 53) mint0)))
    (let s4g (kcw-say "  roots recorded by A+B:" (sub (kernel_stat 9) rec0)))
    (let s4h (print_str "C: three thousand attributed interns, the one door that records a root..."))
    (let t4 (now_unix_ms))
    (let interned (kcw-interns 1 3000 (bp "kernel-census-witness-root")))
    (let t5 (now_unix_ms))
    (let s4i (kcw-say "  milliseconds:" (sub t5 t4)))

    (let s5 (print_str "-- the node census by home --"))
    (let s6 (kcw-delta "  nodes, all homes   " nodes0 (kernel_stat 4)))
    (let s7 (kcw-delta "  gas   (private RAM)" gas0 (kernel_stat 58)))
    (let s8 (kcw-delta "  water (per-pid shm)" water0 (kernel_stat 59)))
    (let s9 (kcw-delta "  ice   (shared field)" ice0 (kernel_stat 60)))
    (let s10 (kcw-delta "  arena bytes        " arena0 (kernel_stat 61)))
    (let s11 (kcw-delta "  private bytes      " priv0 (kernel_stat 62)))
    (let s12 (kcw-delta "  nodes minted       " mint0 (kernel_stat 53)))

    (let s13 (print_str "-- the framebuffer roots --"))
    (let s14 (kcw-delta "  recorded           " rec0 (kernel_stat 9)))
    (let s15 (kcw-delta "  standing in ring   " std0 (kernel_stat 54)))
    (let s16 (kcw-say  "  ring capacity      " (kernel_stat 55)))
    (let s17 (kcw-say  "  dropped from ring  " (sub (kernel_stat 9) (kernel_stat 54))))
    (let s18 (kcw-delta "  attributions       " ent0 (kernel_stat 12)))
    (let s19 (kcw-say  "  refused            " (kernel_stat 11)))

    (let s20 (print_str "-- the float pool --"))
    (let s21 (kcw-delta "  values standing    " fill0 (kernel_stat 8)))
    (let s22 (kcw-delta "  pool capacity      " fcap0 (kernel_stat 56)))
    (let s23 (kcw-delta "  in the shared field" ffld0 (kernel_stat 57)))
    (let s24 (kcw-say  "  boxes minted       " (kernel_stat 45)))
    (let s25 (kcw-say  "  boxes read         " (kernel_stat 46)))
    (let s26 (kcw-say  "  defns crystallized " (kernel_stat 48)))

    (sub (kernel_stat 4) nodes0))
