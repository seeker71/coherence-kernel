// preludes: observe/concept-translation-witness.bml
section [form.bml] {
 class NativeHttpFramingWitness {
  def nhw-prefixes(wire,at) = if eq(at,str_len(wire)) then 1 else and(not(nhr-good(nhr-parse(substring(wire,0,at)))),nhw-prefixes(wire,add(at,1)));
  def nhw-run() {
   let state = cmm-state(".","form-sha256");
   let fixed = "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nhéllo";
   let chunks = "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3 \t; x=\"y\"\r\nhé\r\n3\r\nllo\r\n0\r\nX-Trace: held\r\n\r\n";
   ctw-http(state,"framed-complete",fixed,200,"héllo");
   ctw-http(state,"chunk-whitespace-and-trailer",chunks,200,"héllo");
   ctw-check(state,"every-fixed-prefix-refused",nhw-prefixes(fixed,0));
   ctw-check(state,"every-chunked-prefix-refused",nhw-prefixes(chunks,0));
   ctw-check(state,"status-delimiter-required",not(nhr-good(nhr-parse("HTTP/1.1 200\r\nContent-Length: 0\r\n\r\n"))));
   print(list("HTTP-framing","incomplete-prefixes",add(str_len(fixed),str_len(chunks)),"observations",record_get(state,"observations")));
   1;
  }
 }
 nhw-run();
}
