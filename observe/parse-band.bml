// parse-band.bml — form-stdlib/bml/parse.bml reads each kind, and says nothing() for text that is not its kind.
// Each row: a label, what the reader gave, what it should give. The last line is the verdict: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/wire-registry.fk form-stdlib/bml/parse.bml
section [form.bml] {
 class ParseBand {
  def pb-row(label, got, want) {
   let ok = (nothing?(got) && nothing?(want)) || (!nothing?(got) && !nothing?(want) && ((String) value_str(got) == (String) value_str(want))) ? 1 : 0;
   let said = print_str((ok == 1 ? "ok   " : "FAIL ") ++ label ++ " got=" ++ (nothing?(got) ? "nothing" : value_str(got)) ++ " want=" ++ (nothing?(want) ? "nothing" : value_str(want)));
   ok;
  }
  def pb-trip(label, v, registry) {
   let d = decode(encode(v, registry), registry);
   let same = (nothing?(v) && nothing?(d)) || (!nothing?(v) && !nothing?(d) && ((String) value_kind(v) == (String) value_kind(d)) && ((String) encode(v, registry) == (String) encode(d, registry)) && (((String) value_kind(v) != "node_id") || eq(v, d))) ? 1 : 0;
   let said = print_str((same == 1 ? "ok   " : "FAIL ") ++ label ++ " text=" ++ encode(v, registry));
   same;
  }
  def pb-run() {
   let r1 = pb-row("int 42", parse-int("42"), 42);
   let r2 = pb-row("int -7", parse-int("-7"), 0 - 7);
   let r3 = pb-row("int +3", parse-int("+3"), 3);
   let r4 = pb-row("int padded", parse-int("  15 "), 15);
   let r5 = pb-row("int empty", parse-int(""), nothing());
   let r6 = pb-row("int word", parse-int("abc"), nothing());
   let r7 = pb-row("int float-text", parse-int("3.5"), nothing());
   let r8 = pb-row("int lone sign", parse-int("-"), nothing());
   let r9 = pb-row("float 3.5", parse-float("3.5"), 3.5);
   let r10 = pb-row("float exp", parse-float("2E+1"), 20.0);
   let r11 = pb-row("float whole", parse-float("7"), 7.0);
   let r12 = pb-row("float bad exp", parse-float("1e"), nothing());
   let r13 = pb-row("float word", parse-float("x1.5"), nothing());
   let r14 = pb-row("number int", parse-number("9"), 9);
   let r15 = pb-row("number float", parse-number("0.25"), 0.25);
   let r16 = pb-row("number word", parse-number("nine"), nothing());
   let r17 = pb-row("bool true", parse-bool("true"), 1);
   let r18 = pb-row("bool false", parse-bool(" False "), 0);
   let r19 = pb-row("bool word", parse-bool("yes"), nothing());
   let r20 = pb-row("as int", parse-as("int", "11", []), 11);
   let r21 = pb-row("as string", parse-as("string", " keep ", []), " keep ");
   let r22 = pb-row("as unknown kind", parse-as("tensor", "1", []), nothing());
   let r23 = pb-row("any nothing", parse-any("nothing", []), nothing());
   let r24 = pb-row("any int", parse-any(" 12 ", []), 12);
   let r25 = pb-row("any float", parse-any("1.5", []), 1.5);
   let r26 = pb-row("any bool", parse-any("true", []), 1);
   let r27 = pb-row("any text", parse-any("hello", []), "hello");
   let k1 = pb-row("kind of parse-int", value_kind(parse-int("7")), "int");
   let k2 = pb-row("kind of parse-float", value_kind(parse-float("7")), "float");
   let k3 = pb-row("kind of parse-number 7", value_kind(parse-number("7")), "int");
   let k4 = pb-row("kind of parse-number 7.0", value_kind(parse-number("7.0")), "float");
   let j1 = pb-row("json object reads", nothing?(parse-as("json", "{\"a\":1}", [])) ? 0 : 1, 1);
   let outer = make_nodeid(1, 2, 99, 1777);
   let inner = make_nodeid(1, 2, 99, 1778);
   let registry = [wr-entry("OUTER", outer), wr-entry("INNER", inner)];
   let original = intern_node(outer, [intern_node(inner, [intern_trivial_int(1), intern_trivial_int(2)]), intern_trivial_int(3)]);
   let text = cell-to-json(original, registry);
   let c1 = pb-row("cell round-trips to the same NodeID", eq(original, parse-as("cell", text, registry)) ? 1 : 0, 1);
   let c2 = pb-row("any finds the cell by its shape", eq(original, parse-any(text, registry)) ? 1 : 0, 1);
   let nul = wr-make-null();
   let c3 = pb-row("null cell keeps its identity", eq(nul, parse-as("cell", cell-to-json(nul, registry), registry)) ? 1 : 0, 1);
   let t1 = pb-trip("trip int", 3, registry);
   let t2 = pb-trip("trip negative int", 0 - 7, registry);
   let t3 = pb-trip("trip float", 3.5, registry);
   let t4 = pb-trip("trip whole float", 7.0, registry);
   let t5 = pb-trip("trip string with quote newline backslash", "he said \"hi\"\nline2\\end", registry);
   let t6 = pb-trip("trip empty string", "", registry);
   let t7 = pb-trip("trip nothing", nothing(), registry);
   let t8 = pb-trip("trip nested list", [1, "a", [2.5, "b,c"], []], registry);
   let t9 = pb-trip("trip cell", original, registry);
   let rows = [3, 7.0, "two\nlines", [1, 2.5], nothing(), original];
   let stored = encode-lines(rows, registry);
   let back = decode-lines(stored, registry);
   let l1 = pb-row("lines keep every row on one line", len(split-on(stored, "\n")) == 7 ? 1 : 0, 1);
   let l2 = pb-row("lines read back the same count", len(back) == 6 ? 1 : 0, 1);
   let l3 = pb-row("lines read back the cell", eq(original, back[5]) ? 1 : 0, 1);
   let v1 = pb-row("convert float to int", convert(3.9, "int", registry), 3);
   let v2 = pb-row("convert int to float kind", value_kind(convert(3, "float", registry)), "float");
   let v3 = pb-row("convert string to int", convert("21", "int", registry), 21);
   let v4 = pb-row("convert int to string", convert(21, "string", registry), "21");
   let v5 = pb-row("convert int to bool", convert(5, "bool", registry), 1);
   let v6 = pb-row("convert string to bool", convert("false", "bool", registry), 0);
   let v7 = pb-row("convert string to list", convert("[1,2]", "list", registry)[1], 2);
   let v8 = pb-row("convert cell to text and back", eq(original, convert(convert(original, "text", registry), "cell", registry)) ? 1 : 0, 1);
   let v9 = pb-row("convert nothing stays nothing", convert(nothing(), "int", registry), nothing());
   let v10 = pb-row("convert bad string stays nothing", convert("abc", "float", registry), nothing());
   let sum = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + l1 + l2 + l3 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + r1 + r2+ r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17 + r18 + r19 + r20 + r21 + r22 + r23 + r24 + r25 + r26 + r27 + k1 + k2 + k3 + k4 + j1 + c1 + c2 + c3;
   print_str("[parse-band] " ++ value_str(sum) ++ " of 57");
  }
 }
 pb-run();
}
