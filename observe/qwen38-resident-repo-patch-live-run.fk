; qwen38-resident-repo-patch-live-run.fk — one physical local-model witness of
; a repo-patch frame intercepted on the decoded-byte edge, guarded by a
; request-owned capability, journaled before effect, and observed back into the
; same Qwen/KV residence.
;
; stdin: sealed q38 GGUF path, optional generation budget.
; The target is a disposable fixture under the Form temp directory.  This is
; intentionally not ambient authority over the checkout.
;
; Effectful live witness; no HTTP, llama-server, Ollama, flattening or remote
; model participates.
; preludes: form-stdlib/form-cli-peer-agent.fk

(do
    (defn qrrpl-line (name value)
        (print_str (str_concat "resident-patch "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn qrrpl-int (name value) (qrrpl-line name (int_to_str value)))
    (defn qrrpl-root ()
        (fs-path-join (fs-temp-dir) "qwen38-resident-repo-patch-live"))
    (defn qrrpl-path () "form/a.fk")
    (defn qrrpl-full () (fs-path-join (qrrpl-root) (qrrpl-path)))
    (defn qrrpl-journal () (fs-path-join (qrrpl-root) "patch.journal"))
    (defn qrrpl-v1 () "(do 1)\n")
    (defn qrrpl-v2 () "(do 2)\n")
    (defn qrrpl-route ()
        (intern_node (intern_trivial_string "resident-patch-live-route")
            (list (intern_trivial_string "fixture"))))
    (defn qrrpl-cap ()
        (farc-capability (qrrpl-root) "form/" 512 (qrrpl-route)))
    (defn qrrpl-verify (ctx route candidate)
        (if (and (farp-coordinate-eq? route (qrrpl-route))
                 (eq (str_find candidate "(do " 0) 0))
            (farc-test-result "value" "fixture-source-shaped" 1 1)
            (farc-test-result "failure" "fixture-source-shaped" 1 0)))
    (defn qrrpl-test (ctx route path)
        (if (and (farp-coordinate-eq? route (qrrpl-route))
                 (str_eq (fs-read-text path) (qrrpl-v2)))
            (farc-test-result "value" "fixture-v2-observed" 1 1)
            (farc-test-result "failure" "fixture-v2-observed" 1 0)))

    (let model-path (read_line))
    (let budget-line (read_line))
    (let budget (if (or (nothing? budget-line) (str_eq budget-line ""))
        160 (str_to_int budget-line)))
    (fs-remove-tree (qrrpl-root))
    (fs-mkdir (qrrpl-root))
    (fs-mkdir (fs-path-join (qrrpl-root) "form"))
    (fs-write-text (qrrpl-full) (qrrpl-v1))
    (let cap (qrrpl-cap))
    (let grant (farc-capability-token cap))
    (let patch-frame (farp-frame cap (qrrpl-path) (qrrpl-v1) (qrrpl-v2)))
    (let task-ref (fcpa-task-ref "repo-patch" patch-frame))
    (let action-ref (fcpa-action-ref "emit-exact-frame"))
    (let task-surface (fcpa-task-ref-surface task-ref action-ref))
    (let bootstrap (str_concat (fcpa-bootstrap)
        (str_concat " Held task "
        (str_concat (frex-node-coordinate task-ref)
        (str_concat " means this exact repo-patch frame: "
        (str_concat patch-frame
        (str_concat " Held action "
        (str_concat (frex-node-coordinate action-ref)
        (str_concat " means emit those exact held bytes with no prose. When the next task is "
        (str_concat task-surface " perform that held action."))))))))))
    (let opened (fcms-open model-path bootstrap 2048))
    (if (not (eq (fcms-live? opened) 1))
        (do
            (qrrpl-line "signal" "nothing")
            (qrrpl-line "reason" (fcms-reason opened))
            (fs-remove-tree (qrrpl-root))
            0)
        (do
            (let boot (fcms-generate opened 24))
            (let resident (fcms-generation-session boot))
            (let task (fcpa-observe-task-ref resident 1 "repo-patch"
                task-ref action-ref))
            (let ctx (farp-context cap grant qrrpl-verify qrrpl-test 0
                (qrrpl-journal) (now_unix_ms) (add (now_unix_ms) 600000)))
            (let result (fcpa-run-patch task budget ctx))
            (let source (fs-read-text (qrrpl-full)))
            (let journal (fs-read-text (qrrpl-journal)))
            (let injected-id-delta (sub
                (fcms-injected-ids (fcpa-session result))
                (fcms-injected-ids task)))
            (let observation (farp-cursor-observation (fcpa-cursor result)))
            ; Counterfactual token count for the former tool-role return on the
            ; same exact observation. The completed frame contributes one
            ; pending non-stop ID and the role crossing supplies its close.
            (let tool-role-ids (add 2
                (len (fcms-tool-tail-ids (fcms-src task) observation))))
            (qrrpl-line "bootstrap" (fcms-generation-text boot))
            (qrrpl-line "task-surface" task-surface)
            (qrrpl-int "task-bytes" (str_len task-surface))
            (qrrpl-line "route" (fcpa-route result))
            (qrrpl-line "status" (fcpa-tool-status result))
            (qrrpl-int "contribution" (fcpa-contribution result))
            (qrrpl-int "callback-calls" (fcpa-callback-calls result))
            (qrrpl-int "injected-bytes" (fcpa-injected-bytes result))
            (qrrpl-int "injected-ids" injected-id-delta)
            (qrrpl-int "counterfactual-tool-role-ids" tool-role-ids)
            (qrrpl-line "source-v2"
                (if (str_eq source (qrrpl-v2)) "1" "0"))
            (qrrpl-line "intent-durable"
                (if (ge (str_find journal "phase=intent" 0) 0) "1" "0"))
            (qrrpl-line "terminal-durable"
                (if (ge (str_find journal "phase=terminal" 0) 0) "1" "0"))
            (qrrpl-line "response" (fcpa-response result))
            (let released (fcms-release-ok? (fcpa-session result)))
            (qrrpl-int "release-ok" released)
            (fs-remove-tree (qrrpl-root))
            (if (and (eq (fcpa-contribution result) 1)
                     (str_eq source (qrrpl-v2))) 1 0))))
