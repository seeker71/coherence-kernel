; form-cli-peer-agent-live.fk -- one long-lived local Form peer over stdin.
;
; stdin line 1: an existing sealed qwen35 GGUF path.
; later lines: tasks; `release`, `quit`, EOF or nothing closes every handle.
; The process admits/prefills once, keeps weights and KV in RAM, and opens one
; fresh scannerless recipe cursor per task. No HTTP, llama-server or Ollama.
;
; Effectful: run only while no sibling owns the local Qwen/Metal lane.
; preludes: form-stdlib/form-cli-peer-direct-answer-action.fk form-stdlib/form-cli-peer-local-source-answer.fk form-stdlib/form-cli-peer-grounded-symbol-answer.fk form-stdlib/form-cli-peer-grounded-weave-answer.fk form-stdlib/form-cli-peer-live-framebuffer.fk

(do
    (defn fcpal-line (name value)
        (print_str (str_concat "form-peer "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fcpal-int (name value) (fcpal-line name (int_to_str value)))

    (defn fcpal-report (turn result)
        (do
            (fcpal-int "turn" turn)
            (fcpal-line "signal" (fcpa-signal (fcpa-session result)))
            (fcpal-int "elapsed-ms" (fcpa-elapsed-ms result))
            (fcpal-int "contribution" (fcpa-contribution result))
            (fcpal-line "route" (fcpa-route result))
            (fcpal-int "callback-calls" (fcpa-callback-calls result))
            (fcpal-line "tool-status" (fcpa-tool-status result))
            (fcpal-int "value-present" (fcpa-value-present? result))
            (fcpal-int "value" (fcpa-value result))
            (fcpal-line "response-begin" "")
            (print_str (fcpa-response result))
            (print_str "\n")
            (fcpal-line "response-end" "")
            (fcpal-line "ready" "1")
            0))

    ; One observed local control failure may be reframed once in the same KV
    ; residence.  The retry is a task frame, not a hidden prompt rewrite, and a
    ; second failure remains a local result for the caller to observe.
    (defn fcpal-direct-run (session turn task)
        (do
            ; Direct answers own a user-turn crossing; recipe/source actions
            ; retain fcpa-observe-task's tool-observation crossing.
            (let first (fcpdaa-run session
                "direct-answer" task
                (fcpdaa-remaining-capacity session)))
            (if (and (eq (fcpalg-retry? (fcpdaa-signal first)) 1)
                     (eq (fcpdaa-retryable? first) 1))
                (do
                    (let retry-task (fcpalg-retry-task task))
                    (fcpdaa-run (fcpdaa-session first)
                        "direct-answer" retry-task
                        (fcpdaa-remaining-capacity (fcpdaa-session first))))
                first)))

    (defn fcpal-loop (session source-ctx turn accepted)
        (do
            (let line (read_line))
            (if (or (nothing? line)
                    (or (str_eq line "release") (str_eq line "quit")))
                (do
                    (let released (fcms-release-ok? session))
                    (fcpal-int "accepted-contributions" accepted)
                    (fcpal-int "release-ok" released)
                    released)
                (do
                    (let kind (fcpalg-kind line))
                    (let task (fcpalg-body line))
                    (let task-frame (fcplf-record turn "task-begin" "ready"))
                    (let result (if (str_eq kind "recipe")
                        (do
                            (let moved (fcpa-observe-task session turn kind task))
                            (fcpa-run moved 160))
                        (if (str_eq kind "grounded-weave")
                            (fcpagw-peer (fcpagw-run session task source-ctx turn))
                            (if (str_eq kind "grounded-answer")
                                (fcpagsa-peer (fcpagsa-run session task source-ctx turn))
                                (if (eq (fcpalsa-source-task? kind) 1)
                                    (fcpalsa-peer (fcpalsa-run session kind task
                                        source-ctx turn))
                                    (fcpdaa-peer (fcpal-direct-run session turn task)))))))
                    (let terminal-frame (fcplf-record turn "task-terminal"
                        (fcpa-signal (fcpa-session result))))
                    (fcpal-report turn result)
                    (fcpal-loop (fcpa-session result) source-ctx (add turn 1)
                        (add accepted (fcpa-contribution result)))))))

    (let path (read_line))
    ; Resolve authority once at peer birth.  Subsequent `source ` tasks retain
    ; this caller-born context; neither task bytes nor model output may choose
    ; a different root or artifact.
    (let source-ctx (fcpalsa-live-source-context))
    (let started (now_unix_ms))
    (let opened (if (or (nothing? path) (str_eq path ""))
        (fcms-none "model-path-absent")
        (fcms-open-resident-agent path (fcpa-bootstrap))))
    (if (not (eq (fcms-live? opened) 1))
        (do
            (fcpal-line "signal" (fcpa-signal opened))
            (fcpal-line "reason" (fcms-reason opened))
            (fcpal-int "release-ok" (fcms-release-ok? opened))
            0)
        (do
            ; Consume the bootstrap reply once, retaining its IDs and KV.
            (let boot (fcms-generate opened 24))
            (let resident (fcms-generation-session boot))
            (let prefill-frame (fcplf-record 0 "prefill-ready" "ready"))
            (fcpal-int "admit-prefill-ms" (sub (now_unix_ms) started))
            (fcpal-line "bootstrap" (fcms-generation-text boot))
            (fcpal-line "ready" "1")
            (fcpal-loop resident source-ctx 1 0))))
