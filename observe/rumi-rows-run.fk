// rumi-rows-run.fk — the body writes Rumi as teacher rows: for every poem
// file the fetch left (verse lines, title first), each line becomes a
// continuation row — the line before as the question, the line as the
// answer — in <data>/rumi.jsonl, which the emitter folds into train at the
// school's next cycle. Persian originals, public domain; no rented token.
// stdin line 1: data folder (blank -> the native one).
// preflight-exec: forbidden
import form/form-stdlib/lora-voice.bml;
section [form.bml] {
    def rr-say(k, v) = print_str(("rumi-rows " + (k + ("=" + (v + "\n")))));
    def rr-trim(s) = nothing?(s) ? "" : trim(s);
    def rr-text(t) = nothing?(t) ? "" : t;
    def rr-root() = "form/form-stdlib/locale-rows/rumi";
    def rr-lines(path) = split-on(rr-text(read_file(path)), byte_to_str(10));
    def rr-title(lines) = (Comparable) len(lines) == 0 ? "" : len(lines[0]) > 2 && (Comparable) str_byte_at(lines[0], 0) == 35 ? trim(substring(lines[0], 1, len(lines[0]))) : "";
    def rr-pairs(data, title, prev, lines, n) = (Comparable) len(lines) == 0 ? n : len(trim(lines[0])) < 4 ? rr-pairs(data, title, prev, lines[1:], n) : {
        let wrote = (Comparable) len(prev) == 0 ? 0 : sbt-append((data + "/rumi.jsonl"), lv-row(lv-cat(["Mowlana, ", title, ". After the line: ", prev, " — speak the next line."]), trim(lines[0])));
        rr-pairs(data, title, trim(lines[0]), lines[1:], (Number) n + (Number) ((Comparable) len(prev) == 0 ? 0 : 1));
    };
    def rr-poem(data, path, n) = {
        let ls = rr-lines(path);
        rr-pairs(data, rr-title(ls), "", len(rr-title(ls)) > 0 ? ls[1:] : ls, n);
    };
    def rr-cat(data, cat, names, n) = (Comparable) len(names) == 0 ? n : rr-cat(data, cat, names[1:], str_find(names[0], ".txt", 0) >= 0 ? rr-poem(data, fs-path-join(cat, names[0]), n) : n);
    def rr-cats(data, cats, n) = (Comparable) len(cats) == 0 ? n : rr-cats(data, cats[1:], (Comparable) fs-is-dir?(fs-path-join(rr-root(), cats[0])) == 1 ? rr-cat(data, fs-path-join(rr-root(), cats[0]), fs-list(fs-path-join(rr-root(), cats[0])), n) : n);
    let d0 = rr-trim(read_line());
    let data = (Comparable) len(d0) == 0 ? LVData() : d0;
    let cleared = fs-remove-file((data + "/rumi.jsonl"));
    let n = rr-cats(data, fs-list(rr-root()), 0);
    rr-say("rows", (n.str() + (" into " + (data + "/rumi.jsonl"))));
    0;
}
