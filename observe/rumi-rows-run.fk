; rumi-rows-run.fk — the body writes Rumi as teacher rows: for every poem
; file the fetch left (verse lines, title first), each line becomes a
; continuation row — the line before as the question, the line as the
; answer — in <data>/rumi.jsonl, which the emitter folds into train at the
; school's next cycle. Persian originals, public domain; no rented token.
; stdin line 1: data folder (blank -> the native one).
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-voice.bml
(do
    (defn rr-say (k v) (print_str (str_concat "rumi-rows " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn rr-trim (s) (if (nothing? s) "" (trim s)))
    (defn rr-text (t) (if (nothing? t) "" t))
    (defn rr-root () "form/form-stdlib/locale-rows/rumi")
    (defn rr-lines (path) (split-on (rr-text (read_file path)) (byte_to_str 10)))
    (defn rr-title (lines) (if (eq (len lines) 0) "" (if (and (gt (str_len (head lines)) 2) (eq (str_byte_at (head lines) 0) 35)) (trim (substring (head lines) 1 (str_len (head lines)))) "")))
    (defn rr-pairs (data title prev lines n)
        (if (eq (len lines) 0) n
            (if (lt (str_len (trim (head lines))) 4) (rr-pairs data title prev (tail lines) n)
                (do (let wrote (if (eq (str_len prev) 0) 0 (sbt-append (str_concat data "/rumi.jsonl") (lv-row (lv-cat (list "Mowlana, " title ". After the line: " prev " — speak the next line.")) (trim (head lines))))))
                    (rr-pairs data title (trim (head lines)) (tail lines) (add n (if (eq (str_len prev) 0) 0 1)))))))
    (defn rr-poem (data path n) (do (let ls (rr-lines path)) (rr-pairs data (rr-title ls) "" (if (gt (str_len (rr-title ls)) 0) (tail ls) ls) n)))
    (defn rr-cat (data cat names n) (if (eq (len names) 0) n (rr-cat data cat (tail names) (if (ge (str_find (head names) ".txt" 0) 0) (rr-poem data (fs-path-join cat (head names)) n) n))))
    (defn rr-cats (data cats n) (if (eq (len cats) 0) n (rr-cats data (tail cats) (if (eq (fs-is-dir? (fs-path-join (rr-root) (head cats))) 1) (rr-cat data (fs-path-join (rr-root) (head cats)) (fs-list (fs-path-join (rr-root) (head cats))) n) n))))
    (let d0 (rr-trim (read_line)))
    (let data (if (eq (str_len d0) 0) (LVData) d0))
    (let cleared (fs-remove-file (str_concat data "/rumi.jsonl")))
    (let n (rr-cats data (fs-list (rr-root)) 0))
    (rr-say "rows" (str_concat (int_to_str n) (str_concat " into " (str_concat data "/rumi.jsonl"))))
    0)
