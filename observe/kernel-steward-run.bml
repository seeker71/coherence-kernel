// kernel-steward-run.bml — the body reads its own kernels on this host and stops the one class that works for no one.
//
//   ./fkwu observe/kernel-steward-run.bml </dev/null        read: every running kernel, the orphans, the heavy unleased
//   printf 'act 1\n' | ./fkwu observe/kernel-steward-run.bml  stop the orphans (a kernel whose source file is gone)
//
// The organ is form-stdlib/bml/kernel-steward.bml (ks-tend). Heavy kernels without a governor lease are reported,
// never stopped: a sibling's live session may stand without a lease, and the person or the owning session decides.
// stdin: `act N`   (frw-options)
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/form-rows.bml form-stdlib/bml/stdin-source.bml form-stdlib/bml/kernel-steward.bml
section [form.bml] {
 class KernelStewardRun {
  def ksr-run() = ksr-with(frw-options(stdin-text() ?? ""));
  def ksr-with(o) {
   if (String) o[0] != "ok" then print_str("[kernels] the options were refused at line " ++ o[2].str() ++ ": " ++ o[1] ++ "\n")
   else print_str(ks-tend(frw-int(o[1], "act", 0)));
  }
 }
 ksr-run();
}
