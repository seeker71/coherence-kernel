; Public recording, long recording, silence and cancellation on the actual model.
; stdin: new output directory (default: unique directory below .hearth).
; preflight-exec: forbidden
; preludes: form-stdlib/native-whisper-witness.bml
(do (let input (read_line))
 (let dir (if (or (nothing? input) (eq (str_len (trim input)) 0))
  (str_concat ".hearth/native-whisper-witness-" (str_concat (int_to_str (now_unix_ms)) (str_concat "-" (int_to_str (host_pid))))) (trim input)))
 (print_str (str_concat "evidence=" dir))
 (nww-run dir))
