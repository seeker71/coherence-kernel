// Public recording, long recording, silence and cancellation on the actual model.
// stdin: new output directory (default: unique directory below .hearth).
// preflight-exec: forbidden
import form-stdlib/native-whisper-witness.bml;
section [form.bml] {
    let input = read_line();
    let dir = nothing?(input) || (Comparable) len(trim(input)) == 0 ? (".hearth/native-whisper-witness-" + (now_unix_ms().str() + ("-" + host_pid().str()))) : trim(input);
    print_str(("evidence=" + dir));
    nww-run(dir);
}
