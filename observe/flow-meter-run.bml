// flow-meter-run.bml — the body reads the arriving mind's flow from its
// transcript and rows it. The reading itself is form-stdlib/bml/form-cli-flow-meter.bml,
// so a movement reads the flow inside its own call.
// stdin line 1: the transcript path; line 2, optional: the movement name that
// takes the row into receipts/flow-ledger.jsonl.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-flow-meter.bml
section [form.bml] {
 fm-run();
}
