; lora-voice-glass-run.fk — the adapter the body trained, read by the body,
; on the shared glass; the line spoken in symbols and expanded locally.
; stdin line 1: data folder (blank -> .form-lora-voice).
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-adapter.bml form/form-stdlib/symbol-voice.bml
(do
    (defn lvg-trim (s) (if (nothing? s) "" (trim s)))
    (let d0 (lvg-trim (read_line)))
    (let data (if (eq (str_len d0) 0) ".form-lora-voice" d0))
    (let path (str_concat data "/adapter/adapters.safetensors"))
    (let census (if (eq (fs-exists? path) 1) (la-census path) (list "lora-census-v1" 0 (sub 0 1) "absent" (sub 0 1) (sub 0 1) 0 0)))
    (let line (la-last-iter-line (la-text (read_file (str_concat data "/train.log")))))
    (let published (la-publish (hearth-telemetry-root) census line (now_unix_ms)))
    (let sym (la-cat (list "you SEE adapter pairs:" (int_to_str (nth census 1)) " rank:" (int_to_str (nth census 2)) " dtype:" (nth census 3) " layers:" (int_to_str (nth census 4)) "-" (int_to_str (nth census 5)) " bytes:" (int_to_str (nth census 6)) (if (eq (nth census 7) 1) " whole*" " whole?") " | you DO lora iter:" (int_to_str (la-iter line)) " loss:" (la-loss line) " tokens-sec:" (int_to_str (la-tokens-sec line)) " glass:" (nth published 1))))
    (print_str (str_concat "symbols: " (str_concat sym "\n")))
    (print_str (str_concat "expanded: " (str_concat (sv-say sym) "\n")))
    0)
