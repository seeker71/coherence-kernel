; ear-tongue-fork-cost.fk — what a fork costs a process by what it has TOUCHED, not by what it has
; mapped. Ten host-exec calls before the weights are opened, after `dm-open` has mapped them, and
; after eight decode steps have walked the whole blob. The tongue lane's bell rests on this reading:
; a shell forked per frame cost the lane more than the four decode steps behind the frame.
; preludes: form/form-stdlib/ear-tongue.fk
(do
    (defn p (k v) (print_str (str_concat k (str_concat "=" (int_to_str v)))))
    (defn etf-forks (n) (if (le n 0) 0 (do (host-exec "( true ) >/dev/null 2>&1 &" "") (etf-forks (sub n 1)))))
    (defn etf-rep (n v) (if (le n 0) (list) (cons v (etf-rep (sub n 1) v))))
    (defn etf-steps (st m id pos n) (if (le n 0) 0 (do (dm-step st (etf-rep m id) (etf-rep m pos)) (etf-steps st m id (add pos 1) (sub n 1)))))
    ; the first host-exec of a process pays for the shell itself; it is not part of the reading
    (host-exec "( true ) >/dev/null 2>&1 &" "")
    (let a0 (now_unix_ms))
    (etf-forks 10)
    (let a1 (now_unix_ms))
    (p "ten_forks_before_open_ms" (sub a1 a0))
    (let ml (et-mlane-open 4))
    (let b0 (now_unix_ms))
    (etf-forks 10)
    (let b1 (now_unix_ms))
    (p "ten_forks_after_open_ms" (sub b1 b0))
    (etf-steps (nth ml 0) (nth ml 8) (nth ml 1) 0 8)
    (let c0 (now_unix_ms))
    (etf-forks 10)
    (let c1 (now_unix_ms))
    (p "ten_forks_after_decode_ms" (sub c1 c0))
    (let d0 (now_unix_ms))
    (etf-forks 10)
    (let d1 (now_unix_ms))
    (p "ten_forks_again_ms" (sub d1 d0))
    1)
