; ear-tongue-native.fk — the ear's tongue lane, the body's own: woken by the segment bell, it
; takes each committed line (t_end, tongue, text) and offers the tongues not heard through the
; native llama lane (ear-tongue), writing one said frame per line into the ear spool and
; ringing the door's bell. Off the live path by being its own process. The lane's state (the
; index, the file's end ids, what the KV cache holds) is opened once and carried line to line.
; stdin line 1: run seconds.
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-tongue.fk form/form-stdlib/spool-bell-transport.fk form/form-stdlib/hearth.bml form/form-stdlib/line-grammar.fk
(do
    (defn tl-spool () ".hearth/ear.spool")
    (defn tl-bell () ".hearth/ear.spool.bell")
    (defn tl-segs () ".hearth/ear.spool.segments")
    (defn tl-segbell () ".hearth/ear.spool.seg.bell")
    (defn tl-text (t) (if (nothing? t) "" t))
    (defn tl-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (tl-cat (tail xs)))))
    (defn tl-nl () (byte_to_str 10))
    (defn tl-ring (bell) (host-exec (tl-cat (list "( tools/ftimeout 5 sh -c 'printf x > " bell "' ) >/dev/null 2>&1 &")) ""))
    (defn tl-kv (k v) (tl-cat (list k "=" v (tl-nl))))
    (defn tl-emit (heard lang heardms en fa pt saidms)
        (do (let w (sbt-append (tl-spool) (tl-cat (list "<|ear:frame|>" (tl-nl) (tl-kv "t" (int_to_str (now_unix_ms))) (tl-kv "kind" "said") (tl-kv "heard" heard) (tl-kv "lang" lang) (tl-kv "nsp" "0") (tl-kv "heardms" (int_to_str heardms)) (tl-kv "en" en) (tl-kv "fa" fa) (tl-kv "pt" pt) (tl-kv "saidms" (int_to_str saidms)) "<|/ear:frame|>" (tl-nl)))))
            (tl-ring (tl-bell))))
    (defn tl-known? (l) (et-known? l))
    ; (text lane): the heard tongue is its own text; another tongue goes through the lane
    (defn tl-say (lane text from to) (if (str_eq from to) (list text lane) (et-say lane text (if (tl-known? from) from "en") to 20)))
    ; every chosen tongue in turn; answers ((code text) ...) and the lane
    (defn tl-tongues (lane text lang codes acc) (if (eq (len codes) 0) (list (reverse acc) lane) (do (let r (tl-say lane text lang (head codes))) (tl-tongues (nth r 1) text lang (tail codes) (cons (list (head codes) (head r)) acc)))))
    (defn tl-pick (pairs code) (if (eq (len pairs) 0) "" (if (str_eq (head (head pairs)) code) (nth (head pairs) 1) (tl-pick (tail pairs) code))))
    (defn tl-fields (pairs) (if (eq (len pairs) 0) "" (str_concat (tl-kv (str_concat "t_" (head (head pairs))) (nth (head pairs) 1)) (tl-fields (tail pairs)))))
    (defn tl-join (codes) (if (eq (len codes) 0) "" (if (eq (len (tail codes)) 0) (head codes) (str_concat (head codes) (str_concat " " (tl-join (tail codes)))))))
    (defn tl-emit2 (heard lang heardms codes pairs saidms)
        (do (let w (sbt-append (tl-spool) (tl-cat (list "<|ear:frame|>" (tl-nl) (tl-kv "t" (int_to_str (now_unix_ms))) (tl-kv "kind" "said") (tl-kv "heard" heard) (tl-kv "lang" lang) (tl-kv "nsp" "0") (tl-kv "heardms" (int_to_str heardms)) (tl-kv "en" (tl-pick pairs "en")) (tl-kv "fa" (tl-pick pairs "fa")) (tl-kv "pt" (tl-pick pairs "pt")) (tl-kv "tongues" (tl-join codes)) (tl-fields pairs) (tl-kv "saidms" (int_to_str saidms)) "<|/ear:frame|>" (tl-nl)))))
            (tl-ring (tl-bell))))
    (defn tl-line (lane codes line)
        (do (let a (str_find line (byte_to_str 9) 0))
            (let b (str_find line (byte_to_str 9) (add a 1)))
            (let tend (str_to_int (substring line 0 a)))
            (let lang (substring line (add a 1) b))
            (let text (substring line (add b 1) (str_len line)))
            (let r (tl-tongues lane text lang codes (list)))
            (let e (tl-emit2 text lang 0 codes (head r) (sub (now_unix_ms) tend)))
            (nth r 1)))
    ; (done lane)
    (defn tl-lines (lane codes lines) (if (eq (len lines) 0) (list 0 lane) (if (eq (str_len (head lines)) 0) (tl-lines lane codes (tail lines)) (if (str_eq (head lines) "done") (list 1 lane) (tl-lines (tl-line lane codes (head lines)) codes (tail lines))))))
    (defn tl-loop (lane codes mark deadline)
        (if (gt (now_unix_ms) deadline) 0
            (do (let sz (file_size (tl-segs)))
                (if (le sz mark)
                    (do (let woke (sbt-bell-wait (tl-segbell))) (tl-loop lane codes mark deadline))
                    (do (let text (tl-text (read_file_slice (tl-segs) mark (sub sz mark))))
                        (let r (tl-lines lane codes (split-on text (tl-nl))))
                        (if (eq (head r) 1) 0 (tl-loop (nth r 1) codes sz deadline)))))))
    (let secs (str_to_int (trim (read_line))))
    (let codes (do (let l (trim (read_line))) (split-on (if (eq (str_len l) 0) "en pt fa id" l) " ")))
    (let lane (et-lane-open))
    (let mark (if (lt (file_size (tl-segs)) 0) 0 (file_size (tl-segs))))
    (let patience (host-exec (tl-cat (list "( sleep " (int_to_str (add secs 60)) "; printf x > " (tl-segbell) " ) >/dev/null 2>&1 &")) ""))
    (tl-loop lane codes mark (add (now_unix_ms) (mul 1000 (add secs 60)))))
