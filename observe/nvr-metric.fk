// nvr-metric.fk — the eval metric, registered before any ≥ rented claim.
//
// HOMECOMING rung 6 was blocked: native-vs-rented.fk compares two scalars,
// and no one had said what those scalars ARE. A later-chosen metric is a
// fake-in-waiting. This cell names the metric now, while no native
// summary exists to fit.
//
// A judge scores a summary on two axes, 0..10:
//   faithfulness — does it say what the source says, and nothing else?
//   fluency      — can a reader receive it?
// Faithfulness is weighted twice. Invention is the unforgivable move.
// Native and rented are scored in the same batch, blind to source.
// The rented output is the VERIFY alternative, never laundered as native.
//
// earns-observed only when:
//   the registered metric was used (not a post-hoc substitute)
//   a held-out corpus exists (n >= floor)
//   native score >= rented score  (equal counts)
//
// Honest floor: tonight the corpus is empty. The metric is registered.
// A ≥ rented claim is still pending. That is the point of registering first.
//
import form-stdlib/core.fk;
import form-stdlib/native-vs-rented.fk;
//
// Proven by: observe/tests/nvr-metric-band.fk
// witnessed: 2026-08-14 -> band 511
section [form.bml] {
    def nvrm-faith-weight() = 2;
    def nvrm-corpus-floor() = 8;
    def nvrm-id() = 20260814;
    def nvrm-score(faith, fluent) = (Number) (faith * nvrm-faith-weight()) + (Number) fluent;
    def nvrm-pair(nf, nl, rf, rl) = [nvrm-score(nf, nl), nvrm-score(rf, rl)];
    def nvrm-native(p) = p[0];
    def nvrm-rented(p) = p[1];
    def nvrm-beats?(p) = nvr-at-least-as-good?([nvrm-native(p), nvrm-rented(p)]);
    // A run: (metric-id corpus-n used-registered)
    def nvrm-run(mid, n, used) = [mid, n, used];
    def nvrm-run-id(r) = r[0];
    def nvrm-run-n(r) = r[1];
    def nvrm-run-used(r) = r[2];
    def nvrm-corpus-ready?(n) = n >= nvrm-corpus-floor() ? 1 : 0;
    def nvrm-metric-held?(mid, used) = (Comparable) mid == nvrm-id() && (Comparable) used == 1 ? 1 : 0;
    // The claim may enter only when metric, corpus, and score all hold.
    def nvrm-earns?(p, r) = (Comparable) nvrm-metric-held?(nvrm-run-id(r), nvrm-run-used(r)) == 0 ? 0 : (Comparable) nvrm-corpus-ready?(nvrm-run-n(r)) == 0 ? 0 : nvrm-beats?(p);
    def nvrmk(cond, bit) = cond ? bit : 0;
    def nvrm-check() = {
        let win = nvrm-pair(9, 5, 8, 5);
        let tie = nvrm-pair(8, 4, 8, 4);
        let lose = nvrm-pair(8, 1, 7, 4);
        let empty = nvrm-run(nvrm-id(), 0, 1);
        let full = nvrm-run(nvrm-id(), 8, 1);
        let other = nvrm-run(19990101, 8, 1);
        (Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) nvrmk((Comparable) nvrm-score(8, 1) == 17, 1) + (Number) nvrmk((Comparable) nvrm-beats?(win) == 1, 2)) + (Number) nvrmk((Comparable) nvrm-beats?(tie) == 1, 4)) + (Number) nvrmk((Comparable) nvrm-beats?(lose) == 0, 8)) + (Number) nvrmk((Comparable) nvrm-corpus-ready?(0) == 0, 16)) + (Number) nvrmk((Comparable) nvrm-earns?(win, empty) == 0, 32)) + (Number) nvrmk((Comparable) nvrm-earns?(win, full) == 1, 64)) + (Number) nvrmk((Comparable) nvrm-earns?(win, other) == 0, 128)) + (Number) nvrmk((Comparable) nvrm-metric-held?(nvrm-id(), 1) == 1, 256);
    };
    0;
}
