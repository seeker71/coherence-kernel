; nvr-metric.fk — the eval metric, registered before any ≥ rented claim.
;
; HOMECOMING rung 6 was blocked: native-vs-rented.fk compares two scalars,
; and no one had said what those scalars ARE. A later-chosen metric is a
; fake-in-waiting. This cell names the metric now, while no native
; summary exists to fit.
;
; A judge scores a summary on two axes, 0..10:
;   faithfulness — does it say what the source says, and nothing else?
;   fluency      — can a reader receive it?
; Faithfulness is weighted twice. Invention is the unforgivable move.
; Native and rented are scored in the same batch, blind to source.
; The rented output is the VERIFY alternative, never laundered as native.
;
; earns-observed only when:
;   the registered metric was used (not a post-hoc substitute)
;   a held-out corpus exists (n >= floor)
;   native score >= rented score  (equal counts)
;
; Honest floor: tonight the corpus is empty. The metric is registered.
; A ≥ rented claim is still pending. That is the point of registering first.
;
; preludes: form-stdlib/core.fk form-stdlib/native-vs-rented.fk
;
; Proven by: observe/tests/nvr-metric-band.fk
; witnessed: 2026-08-14 -> band 511

(do
    (defn nvrm-faith-weight () 2)
    (defn nvrm-corpus-floor () 8)
    (defn nvrm-id () 20260814)

    (defn nvrm-score (faith fluent)
        (add (mul faith (nvrm-faith-weight)) fluent))

    (defn nvrm-pair (nf nl rf rl)
        (list (nvrm-score nf nl) (nvrm-score rf rl)))

    (defn nvrm-native (p) (nth p 0))
    (defn nvrm-rented (p) (nth p 1))

    (defn nvrm-beats? (p)
        (nvr-at-least-as-good? (list (nvrm-native p) (nvrm-rented p))))

    ; A run: (metric-id corpus-n used-registered)
    (defn nvrm-run (mid n used)
        (list mid n used))
    (defn nvrm-run-id   (r) (nth r 0))
    (defn nvrm-run-n    (r) (nth r 1))
    (defn nvrm-run-used (r) (nth r 2))

    (defn nvrm-corpus-ready? (n)
        (if (ge n (nvrm-corpus-floor)) 1 0))

    (defn nvrm-metric-held? (mid used)
        (if (and (eq mid (nvrm-id)) (eq used 1)) 1 0))

    ; The claim may enter only when metric, corpus, and score all hold.
    (defn nvrm-earns? (p r)
        (if (eq (nvrm-metric-held? (nvrm-run-id r) (nvrm-run-used r)) 0) 0
            (if (eq (nvrm-corpus-ready? (nvrm-run-n r)) 0) 0
                (nvrm-beats? p))))

    (defn nvrmk (cond bit) (if cond bit 0))
    (defn nvrm-check ()
        (do
            (let win (nvrm-pair 9 5 8 5))
            (let tie (nvrm-pair 8 4 8 4))
            (let lose (nvrm-pair 8 1 7 4))
            (let empty (nvrm-run (nvrm-id) 0 1))
            (let full (nvrm-run (nvrm-id) 8 1))
            (let other (nvrm-run 19990101 8 1))
            (add (add (add (add (add (add (add (add
                (nvrmk (eq (nvrm-score 8 1) 17) 1)
                (nvrmk (eq (nvrm-beats? win) 1) 2))
                (nvrmk (eq (nvrm-beats? tie) 1) 4))
                (nvrmk (eq (nvrm-beats? lose) 0) 8))
                (nvrmk (eq (nvrm-corpus-ready? 0) 0) 16))
                (nvrmk (eq (nvrm-earns? win empty) 0) 32))
                (nvrmk (eq (nvrm-earns? win full) 1) 64))
                (nvrmk (eq (nvrm-earns? win other) 0) 128))
                (nvrmk (eq (nvrm-metric-held? (nvrm-id) 1) 1) 256))))

    0)
