// band-pin-run.bml — pin the bands that answer their own head comment.
//
// validate.sh enforces a band's first `; Verdict <n>`; a head line `; Expected: <n>` states a claim nothing
// checks. This door runs each band named on stdin through ./fkwu and, where the last line it prints equals the
// stated number, rewrites that head line to `; Verdict <n>` (the text after the number stays). A band that
// answers otherwise stays as written and is named with what it answered.
// stdin: first line `check` (read only) or `apply`, then one repo-relative band path per line; run from the
// repository root.
// stdout: per band `pin <path> <n>`, `keep <path> answered=<x> stated=<n>` or `none <path>` (no head claim),
// then `band-pin pinned=<a> kept=<b>`. The answer is <b>, the bands left as written.
// preludes: observe/prelude-reach.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class BandPin {
  def bpn-digit?(b) = b >= 48 && b <= 57;
  def bpn-digits-end(s, i) = i < str_len(s) && bpn-digit?(str_byte_at(s, i)) ? bpn-digits-end(s, i + 1) : i;
  def bpn-head?(src, at) = at >= 0 && (str_find(src, "\n(", 0) < 0 || at < str_find(src, "\n(", 0));
  def bpn-last(text) {
   let lines = prch-lines(text);
   nil?(lines) ? "" : head(reverse(lines));
  }
  def bpn-rest(src, end) {
   let rest = substring(src, end, str_len(src));
   str_len(rest) > 1 && str_eq(substring(rest, 0, 2), ".\n") ? substring(rest, 1, str_len(rest)) : rest;
  }
  def bpn-pinned(src, at, end) = substring(src, 0, at) ++ "; Verdict " ++ substring(src, at + 12, end) ++ bpn-rest(src, end);

  def bpn-claimed(path, src, at, apply) {
   let end = bpn-digits-end(src, at + 12);
   let stated = substring(src, at + 12, end);
   let answered = bpn-last(host_capture(list("./fkwu", path)) ?? "");
   let agree = end > at + 12 && str_eq(answered, stated);
   let out = bpn-pinned(src, at, end);
   let wrote = apply && agree ? write_file(path, out) : 0;
   let kept = apply && agree ? str_eq(read_file(path), out) : true;
   print_str(agree ? "pin " ++ path ++ " " ++ stated : "keep " ++ path ++ " answered=" ++ answered ++ " stated=" ++ stated);
   agree && kept ? 1 : 0;
  }
  def bpn-band(path, apply) {
   let src = read_file(path) ?? "";
   let at = str_find(src, "; Expected: ", 0);
   bpn-head?(src, at) ? bpn-claimed(path, src, at, apply) : print_str("none " ++ path) * 0;
  }
  def bpn-walk(paths, apply, done) = nil?(paths) ? done : bpn-walk(tail(paths), apply, done + bpn-band(head(paths), apply));

  def bpn-run() {
   let lines = prch-lines(stdin-text()) |> map(l => bml-source-trim(l));
   let apply = !nil?(lines) && str_eq(head(lines), "apply");
   let paths = nil?(lines) ? list() : tail(lines);
   let pinned = bpn-walk(paths, apply, 0);
   print_str("band-pin pinned=" ++ int_to_str(pinned) ++ " kept=" ++ int_to_str(len(paths) - pinned));
   len(paths) - pinned;
  }
 }
 bpn-run();
}
