// preflight-exec: forbidden
// Same-source/task evidence and distinct provider usage events, with no new call.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 class ComparisonPairAudit {
  def fcpa-read(path) = parse-json(path,read_file(path));
  def fcpa-sum(rows,key) = if nil?(rows) then 0 else {
   let usage = json-object-get(head(rows),"provider_usage"); let value = pmu-number(usage,key);
   fcr-need(and(str_eq(fcap-string(usage,"status"),"observed"),not(nothing?(value))),"provider usage quantity unavailable");
   add(value,fcpa-sum(tail(rows),key));
  };
 }
 let nativePrefix = "receipts/artifacts/2026-09-20-attributed-native-comparison";
 let prefix = "receipts/artifacts/2026-09-20-attributed-provider-comparison";
 let source = read_file(str_concat(nativePrefix,"-source.json"));
 fcr-need(str_eq(source,read_file(str_concat(prefix,"-source.json"))),"paired source bytes differ");
 let manifest = fcpa-read(str_concat(prefix,"-manifest.json"));
 let request = json-object-get(head(node_children(json-object-get(manifest,"cases"))),"request");
 let packet = fcr-packet(str_concat(nativePrefix,"-packet.json"));
 fcr-need(str_eq(fcap-string(request,"goal"),substring(packet,0,str_find(packet,"\n\n{",0))),"paired task instructions differ");
 fcr-need(str_eq(fcap-string(head(node_children(json-object-get(request,"documents"))),"text"),source),"provider document differs from native evidence");
 let first = fcpa-read("receipts/artifacts/2026-09-20-form-owned-provider-result.json");
 let second = fcpa-read("receipts/artifacts/2026-09-20-source-restored-provider-result.json");
 let current = fcpa-read(str_concat(prefix,"-result.json")); let reports = list(first,second,current);
 let a = fcap-string(first,"usage_event"); let b = fcap-string(second,"usage_event"); let c = fcap-string(current,"usage_event");
 fcr-need(and(gt(str_len(a),0),and(gt(str_len(b),0),and(gt(str_len(c),0),and(not(str_eq(a,b)),and(not(str_eq(a,c)),not(str_eq(b,c))))))),"provider usage event absent or duplicated");
 let input = fcpa-sum(reports,"input_tokens"); let cached = fcpa-sum(reports,"cached_input_tokens"); let output = fcpa-sum(reports,"output_tokens");
 let report = json-node-object(list(nsm-n("same_source_bytes",1),nsm-n("same_instruction",1),nsm-s("source_sha256",fcam-hash(source)),nsm-n("distinct_provider_events",len(reports)),nsm-n("provider_input_tokens",input),nsm-n("provider_cached_input_tokens",cached),nsm-n("provider_uncached_input_tokens",sub(input,cached)),nsm-n("provider_output_tokens",output),nsm-n("provider_total_tokens",add(input,output)),nsm-n("new_model_calls",0),nsm-n("evaluation_training",0),nsm-s("scope","Three retained comparison provider runs: original review, restored-source review and attributed fresh composition. Count each usage event once. Other earlier sessions and coordinating turns remain separate. Only the latest native/provider pair shares this exact source and task; model and carrier envelopes differ. Semantic quality and human resonance require separate readings.")));
 frsh-frozen(str_concat(prefix,"-pair-audit.json"),json-emit(report)); print_str(json-emit(report));
 1;
}
