// prompt-draft-run.bml — the body's own agent drafts what it would answer to the person's own prompts.
//
// Reads the prompts the harness captured (/Users/ursmuff/source/coherence-kernel/.hearth/prompt-capture.jsonl:
// cwd, prompt, session, t), keeps the person's own words (system-reminder blocks removed; notifications, hook
// feedback and prompts under 16 characters left out), and drafts the newest `count` not yet drafted through the
// registry's answer model in this process (form-stdlib/bml/form-cli-native-voice.bml). Each draft lands under
// .hearth/drafts/<id>.md, and one row in receipts/draft-ledger.jsonl with reading "pending"; our reading is
// recorded beside it by observe/draft-reading-run.bml. The draft text never enters the ledger.
// stdin, optional: {"count":2,"max_reply_tokens":900}
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class PromptDraft {
  def pd-capture() = "/Users/ursmuff/source/coherence-kernel/.hearth/prompt-capture.jsonl";
  def pd-ledger() = "receipts/draft-ledger.jsonl";
  def pd-dir() = ".hearth/drafts";
  def pd-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def pd-num(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def pd-int(doc, key, d) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else d;
  def pd-starts?(s, p) = and(ge(str_len(s), str_len(p)), str_eq(substring(s, 0, str_len(p)), p));
  def pd-strip(s) {
   let a = str_find(s, "<system-reminder>", 0);
   let b = if lt(a, 0) then -1 else str_find(s, "</system-reminder>", a);
   if or(lt(a, 0), lt(b, 0)) then s else pd-strip(str_concat(substring(s, 0, a), substring(s, add(b, 18), str_len(s))));
  }
  def pd-own(raw) {
   let s = trim(pd-strip(raw));
   if or(lt(str_len(s), 16), or(pd-starts?(s, "<"), or(pd-starts?(s, "Stop hook feedback"), ge(str_find(s, "<task-notification>", 0), 0)))) then "" else s;
  }
  def pd-nonempty(xs) = if nil?(xs) then list() else if eq(str_len(trim(head(xs))), 0) then pd-nonempty(tail(xs)) else cons(head(xs), pd-nonempty(tail(xs)));
  def pd-parse(xs) = if nil?(xs) then list() else cons(parse-json("capture-row", head(xs)), pd-parse(tail(xs)));
  def pd-rows(path) = if lt(file_size(path), 1) then list() else pd-parse(pd-nonempty(split-on(fhn-read(path), "\n")));
  def pd-id(r) = mc-cat(list(pd-str(r, "session"), "-", int_to_str(pd-num(r, "t"))));
  def pd-drafted?(id, rows) = if nil?(rows) then 0 else if str_eq(pd-str(head(rows), "draft"), id) then 1 else pd-drafted?(id, tail(rows));
  // newest first: the capture rows reversed, the person's own words, not yet drafted
  def pd-pick(rows, done, n, acc) = if or(nil?(rows), le(n, 0)) then reverse(acc) else if and(gt(str_len(pd-own(pd-str(head(rows), "prompt"))), 0), eq(pd-drafted?(pd-id(head(rows)), done), 0)) then pd-pick(tail(rows), done, sub(n, 1), cons(head(rows), acc)) else pd-pick(tail(rows), done, n, acc);
  def pd-packet(prompt) = mc-cat(list("You are this body's own agent, speaking for the coherence-kernel body on its own Mac. The person below asked the body to do something or to answer something. Write the answer or the concrete plan you would give them, as the body would act on it: plainly, specifically, naming the files, doors or steps you would use when the request is about the body's work, and saying what you do not know rather than guessing.\n\nThe person asked:\n", prompt, "\n\nYour answer or plan:"));
  def pd-one(r, opts) {
   let id = pd-id(r);
   let prompt = pd-own(pd-str(r, "prompt"));
   let started = now_unix_ms();
   let v = fcnv-ask(pd-packet(prompt), json-node-object(list(fhn-n("max_reply_tokens", pd-int(opts, "max_reply_tokens", 900)))));
   let text = if str_eq(head(v), "answered") then nth(v, 1) else "";
   let path = mc-cat(list(fhn-root(), "/", pd-dir(), "/", id, ".md"));
   let wrote = write_file_text(path, mc-cat(list("# The person asked\n\n", prompt, "\n\n# The body's draft\n\n", text, "\n")));
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-n("prompt_t", pd-num(r, "t")), fhn-s("session", pd-str(r, "session")), fhn-s("path", path), fhn-s("voice", head(v)), fhn-n("generated", nth(v, 3)), fhn-n("wall_ms", sub(now_unix_ms(), started)), fhn-s("reading", "pending")));
   let appended = fhn-append(pd-ledger(), str_concat(json-emit(row), "\n"));
   print_str(mc-cat(list("[draft] ", id, " voice=", head(v), " generated=", int_to_str(nth(v, 3)), " -> ", path, "\n")));
  }
  def pd-all(rows, opts) = if nil?(rows) then 0 else pd-all-next(pd-one(head(rows), opts), tail(rows), opts);
  def pd-all-next(done, rest, opts) = pd-all(rest, opts);
  def pd-run() {
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let opts = if str_eq(line, "") then json-node-object(list()) else parse-json("draft-options", line);
   let made = fs_mkdir(pd-dir());
   let picked = pd-pick(reverse(pd-rows(pd-capture())), pd-rows(pd-ledger()), pd-int(opts, "count", 2), list());
   let done = pd-all(picked, opts);
   print_str(mc-cat(list("[draft] drafted ", int_to_str(len(picked)), "\n")));
  }
 }
 pd-run();
}
