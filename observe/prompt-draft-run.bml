// prompt-draft-run.bml — the body's own agent drafts what it would answer to the person's own prompts.
//
// Reads the prompts the harness captured (/Users/ursmuff/source/coherence-kernel/.hearth/prompt-capture.jsonl:
// cwd, prompt, session, t), keeps the person's own words (system-reminder blocks removed; notifications, hook
// feedback and prompts under 16 characters left out), and drafts the newest `count` not yet drafted through the
// registry's answer model in this process (form-stdlib/bml/form-cli-native-voice.bml), given the turn before the
// prompt from its own session transcript (form-stdlib/bml/session-transcript.bml). Each draft lands under that same
// hearth, .hearth/drafts/<id>.md, and one row in receipts/draft-ledger.jsonl with reading "pending"; our reading is
// recorded beside it by observe/draft-reading-run.bml. The draft text never enters the ledger.
// stdin, optional: {"count":2,"max_reply_tokens":900,"redraft":0,"repair":0}; redraft 1 rewrites pending drafts
// written without the turn before them. repair 1 rewrites drafts whose latest reading is revised, and the packet
// carries that reading's note so the next draft can remove the miss.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/session-transcript.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class PromptDraft {
  // one hearth for every checkout: the capture and the drafts live beside each other in the main checkout
  def pd-hearth() = "/Users/ursmuff/source/coherence-kernel/.hearth";
  def pd-capture() = pd-hearth() ++ "/prompt-capture.jsonl";
  def pd-ledger() = "receipts/draft-ledger.jsonl";
  def pd-dir() = pd-hearth() ++ "/drafts";
  def pd-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def pd-num(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def pd-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def pd-starts?(s, p) = (str_len(s) >= str_len(p)) && ((String) substring(s, 0, str_len(p)) == p);
  def pd-strip(s) {
   let a = str_find(s, "<system-reminder>", 0);
   let b = a < 0 ? -1 : str_find(s, "</system-reminder>", a);
   (a < 0) || (b < 0) ? s : pd-strip(substring(s, 0, a) ++ substring(s, b + 18, str_len(s)));
  }
  def pd-own(raw) {
   let s = trim(pd-strip(raw));
   (str_len(s) < 16) || (pd-starts?(s, "<") || (pd-starts?(s, "Stop hook feedback") || (str_find(s, "<task-notification>", 0) >= 0))) ? "" : s;
  }
  def pd-nonempty(xs) = nil?(xs) ? list() : (Comparable) str_len(trim(head(xs))) == 0 ? pd-nonempty(tail(xs)) : cons(head(xs), pd-nonempty(tail(xs)));
  def pd-parse(xs) = nil?(xs) ? list() : cons(parse-json("capture-row", head(xs)), pd-parse(tail(xs)));
  def pd-rows(path) = file_size(path) < 1 ? list() : pd-parse(pd-nonempty(split-on(fhn-read(path), "\n")));
  def pd-id(r) = pd-str(r, "session") ++ "-" ++ int_to_str(pd-num(r, "t"));
  def pd-drafted?(id, rows) = nil?(rows) ? 0 : (String) pd-str(head(rows), "draft") == id ? 1 : pd-drafted?(id, tail(rows));
  // the latest row of a draft that carries its path, and the latest reading naming it
  def pd-draft-row(id, rows, acc) = nil?(rows) ? acc : pd-draft-row(id, tail(rows), ((String) pd-str(head(rows), "draft") == id) && (str_len(pd-str(head(rows), "path")) > 0) ? head(rows) : acc);
  def pd-reading(id, rows, acc) = nil?(rows) ? acc : pd-reading(id, tail(rows), (String) pd-str(head(rows), "draft") == id ? pd-str(head(rows), "reading") : acc);
  def pd-note(id, rows, acc) = nil?(rows) ? acc : pd-note(id, tail(rows), ((String) pd-str(head(rows), "draft") == id) && (str_len(pd-str(head(rows), "note")) > 0) ? pd-str(head(rows), "note") : acc);
  def pd-revised?(id, rows) = (String) pd-reading(id, rows, "") == "revised";
  // redraft: a draft still pending that was written blind, or that was cut or missed its turn before under an older
  // packet, or cut before cut answers were kept (its row carries no "cut"); a whole grounded answer stands
  def pd-redraft?(id, rows) = (String) pd-reading(id, rows, "") == "pending" ? pd-stale?(pd-draft-row(id, rows, json-node-object(list()))) : 0;
  def pd-stale?(row) = pd-version(row) < 3 ? 1 : !json-object-has?(row, "cut") ? ((String) pd-str(row, "voice") == "incomplete" ? 1 : 0) : (pd-version(row) < pd-packet-version()) && (((String) pd-str(row, "voice") == "incomplete") || ((Comparable) json-int-value(json-object-get(row, "context_chars")) == 0)) ? 1 : 0;
  def pd-want?(r, done, mode) = (Comparable) mode == 2 ? pd-revised?(pd-id(r), done) : (Comparable) mode == 1 ? pd-redraft?(pd-id(r), done) : (Comparable) pd-drafted?(pd-id(r), done) == 0 ? 1 : 0;
  // newest first: the capture rows reversed, the person's own words, not yet drafted (or, redrafting, drafted blind)
  def pd-pick(rows, done, n, redraft, acc) = nil?(rows) || (n <= 0) ? reverse(acc) : (str_len(pd-own(pd-str(head(rows), "prompt"))) > 0) && ((Comparable) pd-want?(head(rows), done, redraft) == 1) ? pd-pick(tail(rows), done, n - 1, redraft, cons(head(rows), acc)) : pd-pick(tail(rows), done, n, redraft, acc);
  def pd-tail(s, n) = str_len(s) <= n ? s : substring(s, str_len(s) - n, str_len(s));
  // the files a prompt names, read so the voice answers from the body rather than asking for it
  def pd-root() = "/Users/ursmuff/source/coherence-kernel";
  // a named file is read from the checkout the person asked in, else from the checkout this door runs in
  def pd-in?(c, set) = str_find(set, c, 0) >= 0;
  def pd-ltrim(w) = (str_len(w) > 0) && pd-in?(substring(w, 0, 1), "`'\"([{<") ? pd-ltrim(substring(w, 1, str_len(w))) : w;
  def pd-rtrim(w) = (str_len(w) > 0) && pd-in?(substring(w, str_len(w) - 1, str_len(w)), "`'\")]}>,.:;!?") ? pd-rtrim(substring(w, 0, str_len(w) - 1)) : w;
  def pd-word(w) = pd-rtrim(pd-ltrim(trim(w)));
  def pd-at(root, w) = pd-starts?(w, "/") ? w : root ++ "/" ++ w;
  def pd-find(w, roots) = nil?(roots) ? "" : file_size(pd-at(head(roots), w)) > 0 ? pd-at(head(roots), w) : pd-find(w, tail(roots));
  def pd-named?(w) = (str_len(w) > 3) && ((str_find(w, "/", 0) >= 0) && ((!pd-starts?(w, "/")) || pd-starts?(w, pd-root())));
  def pd-words(lines) = nil?(lines) ? list() : append(split-on(head(lines), " "), pd-words(tail(lines)));
  def pd-has?(w, xs) = nil?(xs) ? 0 : (String) head(xs) == w ? 1 : pd-has?(w, tail(xs));
  def pd-files(words, roots, n, acc) = nil?(words) || (n <= 0) ? reverse(acc) : pd-files-at(pd-word(head(words)), tail(words), roots, n, acc);
  def pd-files-at(w, rest, roots, n, acc) = pd-named?(w) ? pd-files-found(pd-find(w, roots), rest, roots, n, acc) : pd-files(rest, roots, n, acc);
  def pd-files-found(p, rest, roots, n, acc) = (str_len(p) > 0) && ((Comparable) pd-has?(p, acc) == 0) ? pd-files(rest, roots, n - 1, cons(p, acc)) : pd-files(rest, roots, n, acc);
  def pd-head(s, n) = str_len(s) <= n ? s : substring(s, 0, n);
  def pd-lines(xs) = nil?(xs) ? "" : head(xs) ++ "\n" ++ pd-lines(tail(xs));
  def pd-file-text(ws) = nil?(ws) ? "" : ("The file " ++ head(ws) ++ " reads (its first 2500 characters):\n" ++ pd-head(fhn-read(head(ws)), 2500) ++ "\n\n" ++ pd-file-text(tail(ws)));
  def pd-read-if(path) = (Comparable) str_len(path) == 0 ? "" : file_size(path) > 0 ? fhn-read(path) : "";
  // the packet's form: 0 blind, 1 the turn before, 3 the turn before and the files the prompt names (read from the
  // checkout the person asked in), 4 with a word budget and only the files shown named, 5 with prompts given mid-turn
  // found in the transcript
  def pd-packet-version() = 5;
  def pd-version(row) = json-object-has?(row, "packet") ? json-int-value(json-object-get(row, "packet")) : 0;
  // the turn before the prompt in its own conversation, so a short prompt keeps its meaning
  def pd-context(before) = ((Comparable) str_len(head(before)) == 0) && ((Comparable) str_len(trim(before[1])) == 0) ? "" : ("The person asked just before: " ++ pd-tail(head(before), 800) ++ "\n\nThe answer they received: " ++ pd-tail(before[1], 3000));
  def pd-packet(prompt, context, files) = "You are this body's own agent, speaking for the coherence-kernel body on its own Mac. The person below asked the body to do something or to answer something. Write the answer or the concrete plan you would give them, as the body would act on it: plainly, specifically, naming the files, doors or steps you would use when the request is about the body's work, and saying what you do not know rather than guessing. You cannot run anything while you draft: when the request asks for something to be run or checked, name the door you would run and the reading that would mean it is done. Keep the answer or plan within about 250 words. Name only files and doors you were shown here or that the conversation names; where you would need to look something up, say what you would look for instead of naming a file you have not seen.\n\n" ++ ((Comparable) str_len(context) == 0 ? "" : context ++ "\n\n") ++ files ++ "The person asks now:\n" ++ prompt ++ "\n\nYour answer or plan:";
  def pd-repair-packet(prompt, context, files, note, prior) = pd-packet(prompt, context, files) ++ "\n\nA reading of your previous draft said revised. The miss: " ++ note ++ "\nWrite the answer again. Keep what heard the person. Remove that miss. Name only files and doors already in the turn before, the files above, or your previous draft. About 250 words.\n\nPrevious draft:\n" ++ pd-tail(prior, 1600) ++ "\n";
  def pd-one(r, opts) {
   let id = pd-id(r);
   let prompt = pd-own(pd-str(r, "prompt"));
   let started = now_unix_ms();
   let context = pd-context(st-before(st-find(pd-str(r, "session")), prompt));
   let named = pd-files(pd-words(split-on(prompt, "\n")), list(pd-str(r, "cwd"), fhn-root()), 2, list());
   let files = pd-file-text(named);
   let ledger = pd-rows(pd-ledger());
   let note = (Comparable) pd-int(opts, "repair", 0) == 1 ? pd-note(id, ledger, "") : "";
   let prior-path = pd-str(pd-draft-row(id, ledger, json-node-object(list())), "path");
   let prior = (Comparable) str_len(note) == 0 ? "" : pd-read-if(prior-path);
   let packet = str_len(note) > 0 ? pd-repair-packet(prompt, context, files, note, prior) : pd-packet(prompt, context, files);
   let v = fcnv-ask(packet, json-node-object(list(fhn-n("max_reply_tokens", pd-int(opts, "max_reply_tokens", 900)))));
   // an answer cut at the reply budget is still what the voice would say; it is kept and marked as cut
   let text = (String) head(v) == "answered" ? v[1] : ((String) head(v) == "incomplete") && (str_len(trim(v[8])) > 0) ? (trim(v[8]) ++ "\n\n(cut at the reply budget of " ++ int_to_str(pd-int(opts, "max_reply_tokens", 900)) ++ " tokens)") : "";
   let path = pd-dir() ++ "/" ++ id ++ ".md";
   let seen = ((Comparable) str_len(context) == 0 ? "" : ("\n# The turn before (what the voice was given)\n\n" ++ context ++ "\n")) ++ (nil?(named) ? "" : ("\n# Files the voice read\n\n" ++ pd-lines(named) ++ "\n"));
   let wrote = write_file_text(path, "# The person asked\n\n" ++ prompt ++ "\n\n# The body's draft\n\n" ++ text ++ "\n" ++ seen);
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-n("prompt_t", pd-num(r, "t")), fhn-s("session", pd-str(r, "session")), fhn-s("path", path), fhn-n("packet", str_len(note) > 0 ? 6 : pd-packet-version()), fhn-n("context_chars", str_len(context)), fhn-n("files", len(named)), fhn-n("cut", (String) head(v) == "incomplete" ? 1 : 0), fhn-s("voice", head(v)), fhn-n("generated", v[3]), fhn-n("wall_ms", now_unix_ms() - started), fhn-s("reading", "pending")));
   let appended = fhn-append(pd-ledger(), json-emit(row) ++ "\n");
   print_str("[draft] " ++ id ++ " voice=" ++ head(v) ++ " generated=" ++ int_to_str(v[3]) ++ " -> " ++ path ++ "\n");
  }
  def pd-all(rows, opts) = nil?(rows) ? 0 : pd-all-next(pd-one(head(rows), opts), tail(rows), opts);
  def pd-all-next(done, rest, opts) = pd-all(rest, opts);
  def pd-run() {
   let line0 = read_line();
   let line = nothing?(line0) ? "" : trim(line0);
   let opts = (String) line == "" ? json-node-object(list()) : parse-json("draft-options", line);
   let made = fs_mkdir(pd-dir());
   let mode = (Comparable) pd-int(opts, "repair", 0) == 1 ? 2 : pd-int(opts, "redraft", 0);
   let picked = pd-pick(reverse(pd-rows(pd-capture())), pd-rows(pd-ledger()), pd-int(opts, "count", 2), mode, list());
   let done = pd-all(picked, opts);
   print_str("[draft] drafted " ++ int_to_str(len(picked)) ++ "\n");
  }
 }
 pd-run();
}
