; preflight-exec: forbidden
; Caller supplies a fresh private evidence directory, or empty stdin selects one.
; preludes: form-stdlib/bml/form-local-autonomy-eval.bml
(do (let offered (read_line))
 (let home (if (or (nothing? offered) (str_eq offered "")) (str_concat ".hearth/local-autonomy-" (nsm-id)) offered))
 (if (fs-exists? home) (form_error "autonomy evaluation requires a fresh evidence directory")
  (do (print_str (str_concat "evaluation-home=" home)) (print_str (json-emit-precise (flae-run home))) 0)))
