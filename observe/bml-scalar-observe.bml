// preflight-exec: forbidden
// Grade executes proposals; inspect them first. Only practice may teach.
// preludes: learn/bml-scalar-observation.bml
section [form.bml] {
 def bso-run(raw) {
  let request = parse-json("BML scalar request",raw); let home = nsm-str(request,"home"); let action = nsm-str(request,"action");
  (String) action == "prepare" ? bsp-prepare(home)
  : (String) action == "test" ? bso-condition(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),"test")
  : (String) action == "practice" ? bso-condition(home,nsm-str(request,"condition"),"","practice")
  : (String) action == "teacher-test" ? bso-teacher-test(home,nsm-str(request,"condition"))
  : (String) action == "grade" ? bso-grade(home,nsm-str(request,"condition"),nsm-str(request,"kind"))
  : (String) action == "extract" ? bso-extract(home,nsm-str(request,"condition"),nsm-str(request,"parent"))
  : form_error("Scalar action requires prepare, test, teacher-test, practice, grade or extract");
 }
 bso-run(read_line());
 0;
}
