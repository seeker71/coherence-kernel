// preflight-exec: forbidden
// Grade executes proposals; inspect them first. Only practice may teach.
// preludes: learn/bml-scalar-observation.bml
section [form.bml] {
 def bso-run(raw) {
  let request = parse-json("BML scalar request",raw); let home = nsm-str(request,"home"); let action = nsm-str(request,"action");
  if str_eq(action,"prepare") then bsp-prepare(home)
  else if str_eq(action,"test") then bso-condition(home,nsm-str(request,"condition"),nsm-str(request,"adapter"),"test")
  else if str_eq(action,"practice") then bso-condition(home,nsm-str(request,"condition"),"","practice")
  else if str_eq(action,"teacher-test") then bso-teacher-test(home,nsm-str(request,"condition"))
  else if str_eq(action,"grade") then bso-grade(home,nsm-str(request,"condition"),nsm-str(request,"kind"))
  else if str_eq(action,"extract") then bso-extract(home,nsm-str(request,"condition"),nsm-str(request,"parent"))
  else form_error("Scalar action requires prepare, test, teacher-test, practice, grade or extract");
 }
 bso-run(read_line());
 0;
}
