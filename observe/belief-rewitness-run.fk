// belief-rewitness-run.fk — the runnable door for observe/belief-rewitness.bml.
//
// Direct-source Form does not read argv, so the target arrives in a file, the
// same convention observe/preflight-run.fk carries:
//
//   echo path/to/owed-cell.fk > /tmp/belief-rewitness-target
//   ./fkwu observe/belief-rewitness-run.fk
//
// REQUIRES: fkwu — belief-rewitness.bml is BML; the .bml floor compiles on fkwu.
//
import form-stdlib/core.fk;
import observe/belief-rewitness.bml;
section [form.bml] {
    def brwr-target-file() = "/tmp/belief-rewitness-target";
    def brwr-trim-loop(s, n) = n <= 0 ? "" : (String) substring(s, n - 1, n) == "\n" ? brwr-trim-loop(s, n - 1) : substring(s, 0, n);
    def brwr-target() = (Comparable) fs_exists(brwr-target-file()) == 0 ? "" : brwr-trim-loop(read_file(brwr-target-file()), len(read_file(brwr-target-file())));
    {
        let t = brwr-target();
        (Comparable) len(t) == 0 ? {
            print_str("belief-rewitness-run: write the target path to /tmp/belief-rewitness-target first");
            "";
        } : brw-report(t);
    };
}
