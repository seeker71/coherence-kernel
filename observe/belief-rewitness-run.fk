; belief-rewitness-run.fk — the runnable door for observe/belief-rewitness.bml.
;
; Direct-source Form does not read argv, so the target arrives in a file, the
; same convention observe/preflight-run.fk carries:
;
;   echo path/to/owed-cell.fk > /tmp/belief-rewitness-target
;   ./fkwu observe/belief-rewitness-run.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY — belief-rewitness.bml is BML; the .bml floor
; compiles on fkwu only regardless of what the primitives it calls bind on
; (host-exec itself binds go+fkwu, pf-arm-mask 9, per preflight.fk).
;
; preludes: form-stdlib/core.fk observe/belief-rewitness.bml

(do
    (defn brwr-target-file () "/tmp/belief-rewitness-target")
    (defn brwr-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n") (brwr-trim-loop s (sub n 1))
                (substring s 0 n))))
    (defn brwr-target ()
        (if (eq (fs_exists (brwr-target-file)) 0) ""
            (brwr-trim-loop (read_file (brwr-target-file))
                             (str_len (read_file (brwr-target-file))))))
    (do (let t (brwr-target))
        (if (eq (str_len t) 0)
            (do (print_str "belief-rewitness-run: write the target path to /tmp/belief-rewitness-target first")
                "")
            (brw-report t))))
