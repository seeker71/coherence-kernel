// The real terminal refusal path retires native owners before worker exit.
// preludes: form/form-stdlib/bml/native-pipe-darwin.bml
section [form.bml] {
 class TranslationRefusalWitness {
  def ctrf-wait(owner,job,until) {
   npp-pump(owner,10); if npp-done(owner,job) then 1 else if gt(host_monotonic_ms(),until) then npp-refuse(owner,"terminal translation cleanup deadline") else ctrf-wait(owner,job,until);
  }
  def ctrf-lines(lines,out) = if nil?(lines) then reverse(out) else if str_eq(head(lines),"") then ctrf-lines(tail(lines),out) else ctrf-line(head(lines),tail(lines),out);
  def ctrf-line(line,rest,out) {
   let prefix = "form-organ health ";
   if ne(str_find(line,prefix,0),0) then form_error("unexpected terminal translation diagnostic") else ctrf-lines(rest,cons(parse-json("terminal-translation-health",substring(line,str_len(prefix),str_len(line))),out));
  }
  def ctrf-triple(rows,organ) {
   let a = head(rows); let b = nth(rows,1); let c = nth(rows,2);
   let stages = and(str_eq(oh-str(a,"stage"),"observe"),and(str_eq(oh-str(b,"stage"),"response"),str_eq(oh-str(c,"stage"),"applied")));
   let identity = and(str_eq(oh-str(a,"id"),oh-str(b,"id")),str_eq(oh-str(a,"id"),oh-str(c,"id")));
   and(stages,and(identity,and(str_eq(oh-str(a,"organ"),organ),str_eq(oh-select(a,b,"retain"),oh-str(c,"selected")))));
  }
  def ctrf-fds(owner,ends) = if nil?(ends) then 1 else and(eq(npp-call(owner,list(2,record_get(head(ends),"fd"),1,0)),-9),ctrf-fds(owner,tail(ends)));
  def ctrf-run() {
   let owner = npp-open(); let job = npp-spawn(owner,list("./fkwu","observe/concept-translation-refusal-worker.bml"));
   npp-submit(owner,job,npp-frame("")); npp-half-close(owner,job); ctrf-wait(owner,job,add(host_monotonic_ms(),20000));
   let output = npp-take(owner,job,"stdout"); let errors = npp-take(owner,job,"stderr"); let rows = ctrf-lines(split-on(errors,"\n"),list()); let current = oh-current(rows,list());
   let chains = and(eq(len(rows),7),and(eq(len(current),3),and(ctrf-triple(rows,"concept-translation"),ctrf-triple(drop(3,rows),"native-pipe"))));
   let released = and(eq(json-int-value(oh-get(nth(rows,5),"result")),1),and(str_eq(oh-str(nth(rows,6),"aspect"),"owned-resource-release"),eq(json-int-value(oh-get(nth(rows,6),"health")),1)));
   let settled = npp-settle(owner,list(job)); let dead = ctrf-fds(owner,record_get(owner,"ends")); let status = record_get(job,"status"); let closed = npp-close(owner);
   print(list("terminal-translation-status",status,"stdout-bytes",str_len(output),"stderr-bytes",str_len(errors),"health-rows",len(rows),"ordered-chains",chains,"worker-owner-released",released,"parent-reaped",settled,"all-fds-EBADF",dead,"parent-owner-released",closed));
   if and(eq(status,256),and(eq(str_len(output),0),and(chains,and(released,and(settled,and(dead,closed)))))) then 1 else form_error("terminal translation ownership witness refused");
  }
 }
 ctrf-run();
}
