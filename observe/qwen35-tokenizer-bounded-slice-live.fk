; qwen35-tokenizer-bounded-slice-live.fk -- one small file-backed slice.
;
; EFFECTFUL DRIVER: do not preflight.  It creates a tiny complete synthetic
; tokenizer artifact under /tmp, reads it through 256-byte BMF file cursors,
; runs exact merge -> vocab prompt encoding, observes stale and timeout paths,
; and leaves the slice for inspection.  It never opens the 29 GB Qwen model,
; Claude's partial tokenizer artifact, or any whole vocabulary/merge reference.
;
; preludes: form-stdlib/qwen35-tokenizer-bounded-bridge.fk

(do
    (defn q35tbl-root ()
        (fs-path-join (fs-temp-dir) "qwen35-tokenizer-bounded-slice-live"))
    (defn q35tbl-source-size () 1000)
    (defn q35tbl-source-mtime () 2000)
    (defn q35tbl-put-vocab (root id mode ty bytes)
        (do
            (let text (q35tba-vocab-row-text id mode ty bytes))
            (q35tbb-append-ascii (q35tba-vocab-path root bytes) text)))
    (defn q35tbl-put-merge (root rank left right)
        (do
            (let text (q35tba-merge-row-text rank left right))
            (q35tbb-append-ascii (q35tba-merge-path root left) text)))
    (defn q35tbl-bit (ok bit) (if ok bit 0))

    (let root (q35tbl-root))
    (let cleared (fs-remove-tree root))
    (let empty-after-clear (if (eq (fs-exists? root) 0) 1 0))
    (let made (fs-mkdir root))
    (let directory-born (fs-is-dir? root))
    ; Token ids 0 and 1 are deliberately real present values in this slice.
    (let wa (q35tbl-put-vocab root 0 0 1 (list 97)))
    (let wb (q35tbl-put-vocab root 1 0 1 (list 98)))
    (let wab (q35tbl-put-vocab root 2 0 1 (list 97 98)))
    (let ws (q35tbl-put-vocab root 3 0 3 (q35tbb-string-bytes "<x>")))
    (let wm (q35tbl-put-merge root 0 (list 97) (list 98)))
    (let progress (q35tbb-progress 1 (q35tbl-source-size) (q35tbl-source-mtime)
        (q35tbb-phase-done) 1 0 4 1
        (add (add wa wb) (add (add wab ws) wm))
        24 4))
    (let progress-saved (q35tbb-save-progress root progress))
    (let progress-loaded (q35tbb-load-progress root ""
        (q35tbl-source-size) (q35tbl-source-mtime) 4))
    (let seal (q35tba-seal 1 (q35tbl-source-size) (q35tbl-source-mtime)
        4 1 4 1 1 1 (q35tba-window-bytes) 4 24))
    (let seal-wrote (fs-write-text (fs-path-join root (q35tba-seal-name))
                                   (q35tba-seal-text seal)))

    (let id0 (q35tba-vocab-lookup root (q35tbl-source-size) (q35tbl-source-mtime)
                                   (list 97) 0 1 0 10000))
    (let id1 (q35tba-vocab-lookup root (q35tbl-source-size) (q35tbl-source-mtime)
                                   (list 98) 0 1 0 10000))
    (let rank0 (q35tba-merge-lookup root (q35tbl-source-size) (q35tbl-source-mtime)
                                     (list 97) (list 98) 10000))
    (let missing (q35tba-vocab-lookup root (q35tbl-source-size) (q35tbl-source-mtime)
                                      (list 99) 0 1 0 10000))
    (let special (q35tbb-special-id root (q35tbl-source-size) (q35tbl-source-mtime)
                                     "<x>" 10000))
    (let encoded (q35tbb-encode root (q35tbl-source-size) (q35tbl-source-mtime)
                                 "ab" 10000))
    (let stale (q35tbb-encode root (add (q35tbl-source-size) 1)
                               (q35tbl-source-mtime) "ab" 10000))
    (let timed (q35tba-vocab-cursor-lookup
        (cursor-file-window (q35tba-vocab-path root (list 97))
                            (q35tba-window-bytes))
        (list 97) 0 1 0 1))

    (print (list "slice" root
        "window" (q35tba-window-bytes)
        "breath-max" (q35tba-max-breath-rows)
        "progress" (q35tbb-progress-result-status progress-loaded)
        "empty-after-clear" empty-after-clear
        "directory-born" directory-born
        "appended-bytes" (q35tbb-progress-appended-bytes progress)
        "peak-row-upper-bound" (q35tbb-progress-peak-row progress)
        "os-peak-rss-in-form" (nothing)
        "id0" (q35tba-outcome-value id0) (q35tba-outcome-present? id0)
        "id1" (q35tba-outcome-value id1) (q35tba-outcome-present? id1)
        "rank0" (q35tba-outcome-value rank0) (q35tba-outcome-present? rank0)
        "missing-is-nothing" (nothing? (q35tba-outcome-value missing))
        "special" (q35tba-outcome-value special)
        "encoded" (q35tbb-encode-ids encoded)
        "encoded-status" (q35tbb-encode-status encoded)
        "stale-status" (q35tbb-encode-status stale)
        "timeout-status" (q35tba-outcome-status timed)
        "choice-cut-undo-timeout-refine-release"
        (list (q35tba-outcome-choices timed) (q35tba-outcome-cuts timed)
              (q35tba-outcome-undos timed) (q35tba-outcome-timeouts timed)
              (q35tba-outcome-refinements timed) (q35tba-outcome-released? timed))))

    (sum (list
        (q35tbl-bit (and (eq (q35tba-outcome-value id0) 0)
                           (eq (q35tba-outcome-present? id0) 1)) 1)
        (q35tbl-bit (and (eq (q35tba-outcome-value id1) 1)
                           (eq (q35tba-outcome-present? id1) 1)) 2)
        (q35tbl-bit (and (eq (q35tba-outcome-value rank0) 0)
                           (eq (q35tba-outcome-present? rank0) 1)) 4)
        (q35tbl-bit (and (eq (q35tba-outcome-present? missing) 0)
                           (nothing? (q35tba-outcome-value missing))) 8)
        (q35tbl-bit (eq (q35tba-outcome-value special) 3) 16)
        (q35tbl-bit (and (str_eq (q35tbb-encode-status encoded) "ok")
                           (q35tba-list-eq (q35tbb-encode-ids encoded) (list 2))) 32)
        (q35tbl-bit (str_eq (q35tbb-encode-status stale) "stale") 64)
        (q35tbl-bit (and (str_eq (q35tba-outcome-status timed) "timeout")
                           (nothing? (q35tba-outcome-value timed))) 128)
        (q35tbl-bit (eq progress-saved 1) 256)
        (q35tbl-bit (str_eq (q35tbb-progress-result-status progress-loaded) "ok") 512)
        (q35tbl-bit (and (gt seal-wrote 0)
                           (eq (q35tba-outcome-released? id0) 1)) 1024)
        (q35tbl-bit (and (eq (q35tba-window-bytes) 256)
                           (eq (q35tba-max-breath-rows) 64)) 2048)
        (q35tbl-bit (and (eq empty-after-clear 1)
                      (and (eq directory-born 1)
                      (and (eq (q35tbb-encode-released? encoded) 1)
                           (eq (q35tba-outcome-refinements stale) 1)))) 4096))))
