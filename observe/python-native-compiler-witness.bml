// Public compiler and emitted program observations, including actual refusals.
// Every Python source is retained as fixture data; completed launch carriers release.
// preludes: form-stdlib/bml/python-specimen-compiler.bml
section [form.bml] {
 class PythonCompilerCases {
  def pnc-home() {
   let path = fhn-at(fhn-root(),".hearth/python-native-compiler");
   fs_mkdir(path);
   path;
  }
  def pnc-same-process(job) {
   let lines = split-on(fhn-read(fhn-stage-path(job,"compile",".out")),"\n");
   let result = pnc-result(lines);
   let evidence = fhn-string(result,"evidence");
   let metadata = parse-json("compiler-native-observation",read_file(fhn-at(evidence,"compilation.json")));
   let process = parse-json("compiler-public-process",read_file(fhn-stage-path(job,"compile",".process.json")));
   and(str_eq(fhn-string(metadata,"state"),"ready"),and(str_eq(fhn-string(metadata,"compiler"),"fkwu-in-process"),and(eq(fhn-number(metadata,"pid"),fhn-number(process,"pid")),and(str_eq(fhn-string(metadata,"source"),fhn-string(result,"source")),eq(fhn-number(metadata,"bytes"),file_size(fhn-string(result,"output")))))));
  }
  def pnc-result(lines) = if nil?(lines) then json-node-null() else if and(eq(str_byte_at(head(lines),0),123),ge(str_find(head(lines),"\"evidence\"",0),0)) then parse-json("compiler-result",head(lines)) else pnc-result(tail(lines));
  def pnc-health-rows(lines) = if nil?(lines) then list() else if eq(str_find(head(lines),"form-organ health ",0),0) then cons(parse-json("compiler-health",substring(head(lines),18,str_len(head(lines)))),pnc-health-rows(tail(lines))) else pnc-health-rows(tail(lines));
  def pnc-refusal-health(job) {
   let rows = reverse(pnc-health-rows(split-on(fhn-read(fhn-stage-path(job,"compile",".out")),"\n")));
   if lt(len(rows),3) then 0 else and(str_eq(oh-str(nth(rows,0),"stage"),"applied"),and(str_eq(oh-str(nth(rows,1),"stage"),"response"),and(str_eq(oh-str(nth(rows,2),"stage"),"observe"),and(str_eq(oh-str(nth(rows,0),"id"),oh-str(nth(rows,1),"id")),and(str_eq(oh-str(nth(rows,1),"id"),oh-str(nth(rows,2),"id")),str_eq(oh-str(nth(rows,0),"selected"),"abstain"))))));
  }
  def pnc-run(label, source, expected, ready) {
   let job = fhn-unique(pnc-home(), str_concat(label, "-"), 0);
   let fixtures = fhn-at(job,"fixtures");
   fs_mkdir(fixtures);
   let input = psc-write(fhn-at(fixtures, "source.py"), source);
   let output = psc-write(fhn-at(job, "compiled.fk"), "retained-before-refusal");
   let request = psc-write(fhn-at(job, "request.txt"),str_concat(json-emit-precise(json-node-object(list(fhn-s("source",input),fhn-s("output",output)))),"\n"));
   let compiled = fhn-run-start(job, "compile", 120, fhn-root(), request, list(fhn-at(fhn-root(), "fkwu"),fhn-at(fhn-root(),"observe/python-specimen-compile-run.bml")));
   psc-release-launch(job,"compile");
   let executed = if and(ready, str_eq(compiled, "0")) then fhn-run-start(job, "execute", 120, fhn-root(), "/dev/null", list(fhn-at(fhn-root(), "fkwu"), output)) else "unrun";
   if not(str_eq(executed,"unrun")) then psc-release-launch(job,"execute") else 0;
   let actual = if str_eq(executed, "unrun") then "" else fhn-read(fhn-stage-path(job, "execute", ".out"));
   let compileError = fhn-read(fhn-stage-path(job,"compile",".err"));
   let executeError = if str_eq(executed,"unrun") then "" else fhn-read(fhn-stage-path(job,"execute",".err"));
   let ok = if ready then and(str_eq(compiled, "0"),and(pnc-same-process(job),and(str_eq(compileError,""),and(str_eq(executeError,""),and(str_eq(executed, "0"), str_eq(actual, str_concat(expected, "\n"))))))) else and(str_eq(compiled,"1"),and(pnc-refusal-health(job),and(ge(str_find(compileError,expected,0),0),str_eq(read_file(output), "retained-before-refusal"))));
   print(list(label, "compile", compiled, "execute", executed, "actual", actual, "ok", ok, "evidence", job));
   ok;
  }
  def pnc-evidence(lines) = if nil?(lines) then "" else if eq(str_find(head(lines),"process-evidence=",0),0) then substring(head(lines),17,str_len(head(lines))) else pnc-evidence(tail(lines));
  def pnc-publication-refusal(label,missing) {
   let job = fhn-unique(pnc-home(),str_concat(label,"-"),0);
   let fixtures = fhn-at(job,"fixtures"); fs_mkdir(fixtures);
   let input = psc-write(fhn-at(fixtures,"source.py"),"42\n");
   let out = if missing then fhn-at(job,"missing/output.fk") else fhn-at(job,"output.fk");
   if missing then 0 else fs_mkdir(out);
   let preserved = if missing then "" else psc-write(fhn-at(out,"retained.txt"),"retained-directory");
   let request = psc-write(fhn-at(job,"request.txt"),str_concat(json-emit-precise(json-node-object(list(fhn-s("source",input),fhn-s("output",out)))),"\n"));
   let status = fhn-run-start(job,"compile",120,fhn-root(),request,list(fhn-at(fhn-root(),"fkwu"),fhn-at(fhn-root(),"observe/python-specimen-compile-run.bml")));
   psc-release-launch(job,"compile");
   let evidence = pnc-evidence(split-on(fhn-read(fhn-stage-path(job,"compile",".out")),"\n"));
   let saved = parse-json("publication-refusal",read_file(fhn-at(evidence,"publication.json")));
   let ok = and(str_eq(status,"1"),and(pnc-refusal-health(job),and(str_eq(fhn-string(saved,"state"),"refused"),and(str_eq(fhn-string(saved,"cleanup"),if missing then "not-created" else "released"),and(lt(file_size(fhn-string(saved,"owned-stage")),0),if missing then lt(file_size(out),0) else str_eq(read_file(preserved),"retained-directory"))))));
   print(list(label,"ok",ok,"evidence",job));
   ok;
  }
  def pnc-runtime-refusal(label,source,reason) {
   let job = fhn-unique(pnc-home(),str_concat(label,"-"),0);
   let fixtures = fhn-at(job,"fixtures"); fs_mkdir(fixtures);
   let input = psc-write(fhn-at(fixtures,"source.py"),source);
   let output = fhn-at(job,"compiled.fk");
   let request = psc-write(fhn-at(job,"request.txt"),str_concat(json-emit-precise(json-node-object(list(fhn-s("source",input),fhn-s("output",output)))),"\n"));
   let compiled = fhn-run-start(job,"compile",120,fhn-root(),request,list(fhn-at(fhn-root(),"fkwu"),fhn-at(fhn-root(),"observe/python-specimen-compile-run.bml")));
   psc-release-launch(job,"compile");
   if not(and(str_eq(compiled,"0"),and(pnc-same-process(job),str_eq(fhn-read(fhn-stage-path(job,"compile",".err")),"")))) then form_error("runtime refusal specimen did not compile") else 0;
   let executed = fhn-run-start(job,"execute",120,fhn-root(),"/dev/null",list(fhn-at(fhn-root(),"fkwu"),output));
   psc-release-launch(job,"execute");
   let diagnostics = fhn-read(fhn-stage-path(job,"execute",".err"));
   let ok = and(str_eq(executed,"1"),ge(str_find(diagnostics,reason,0),0));
   print(list(label,"compile",compiled,"execute",executed,"refused",ok,"evidence",job));
   if ok then 1 else form_error("native runtime refusal absent");
  }
  def pnc-cases() {
   let literal = pnc-run("literal", "42\n", "42", 1);
   let arithmetic = pnc-run("arithmetic", "7 + 3\n", "10", 1);
   let utf8 = pnc-run("utf8", "\"é Ω\"\n", "é Ω", 1);
   let function = pnc-run("function", "def twice(x):\n    return x * 2\ntwice(21)\n", "42", 1);
   let classCase = pnc-run("class", "class C:\n    def __init__(self, x):\n        self.x = x\n    def plus(self, y):\n        return self.x + y\n    def twice(self):\n        return self.x * 2\nc = C(5)\nc.plus(2) + c.twice()\n", "17", 1);
   let inherited = pnc-run("inheritance", "class A:\n    def __init__(self, x):\n        self.x = x\n    def plus(self, y):\n        return self.x + y\n    def twice(self):\n        return self.x * 2\nclass B(A):\n    def __init__(self, x):\n        super().__init__(x)\n        self.x = x + 1\n        self.y = 3\n    def plus(self, y):\n        return super().plus(y) * 2\nb = B(5)\nb.plus(2) + b.twice() + b.y\n", "31", 1);
   let dynamic = pnc-run("dynamic-receiver", "class A:\n    def plus(self, y):\n        return 5 + y\nclass B:\n    def plus(self, y):\n        return 40 + y\ndef invoke(obj):\n    return obj.plus(2)\ninvoke(A()) + invoke(B())\n", "49", 1);
   let demo = pnc-run("demo", read_file("form/form-kernel-ts/seedbank/python-adapter/examples/python_demo.py"), "40949", 1);
   let refused = pnc-run("unsupported", "{1, 2}\n", "lift-primary: unsupported token kind py-op", 0);
   let arity = pnc-runtime-refusal("wrong-arity","class C:\n    def plus(self, y):\n        return 1 + y\nc = C()\nc.plus()\n","native method argument count refused");
   let missingMethod = pnc-runtime-refusal("missing-method","class C:\n    def plus(self, y):\n        return 1 + y\nc = C()\nc.absent()\n","native method lineage exhausted");
   let missingField = pnc-runtime-refusal("missing-field","class C:\n    def get(self):\n        return self.absent\nc = C()\nc.get()\n","native record field not found");
   let methodLambda = pnc-run("method-lambda","class C:\n    def apply(self, f):\n        return f(41)\nc = C()\nc.apply(lambda x: x + 1)\n","42",1);
   let classAppend = pnc-run("class-append","class C:\n    def append(self, x):\n        return 40 + x\nc = C()\nc.append(2)\n","42",1);
   let listAppend = pnc-run("list-append","xs = [1, 2]\nxs.append(3)\nlen(xs)\n","3",1);
   let listAppendFunction = pnc-run("list-append-function","def f():\n    xs = [1]\n    xs.append(2)\n    return len(xs)\nf()\n","2",1);
   let annotations = pnc-run("annotations","def add_one(x: int) -> int:\n    return x + 1\nadd_one(41)\n","42",1);
   let expressionTail = pnc-run("expression-tail","41 @ 99\n","lift-expression: unconsumed tokens",0);
   let returnTail = pnc-run("return-tail","def f():\n    return 41 @ 99\nf()\n","lift-expression: unconsumed tokens",0);
   let assignTail = pnc-run("assignment-tail","x = 41 @ 99\nx\n","lift-expression: unconsumed tokens",0);
   let subscriptIndexTail = pnc-run("subscript-index-tail","x = [1]\nx[0 @ 99] = 42\n","lift-expression: unconsumed tokens",0);
   let subscriptValueTail = pnc-run("subscript-value-tail","x = [1]\nx[0] = 42 @ 99\n","lift-expression: unconsumed tokens",0);
   let conditionTail = pnc-run("condition-tail","if 41 @ 99:\n    pass\n","lift-expression: unconsumed tokens",0);
   let iterableTail = pnc-run("iterable-tail","for x in [1] @ 99:\n    pass\n","lift-expression: unconsumed tokens",0);
   let missingOperand = pnc-run("missing-operand","41 +\n","lift-primary: expression required",0);
   let multipleBases = pnc-run("multiple-bases","class A:\n    def a(self):\n        return 1\nclass B:\n    def b(self):\n        return 2\nclass C(A, B):\n    def value(self):\n        return self.a()\nC().value()\n","lift-class: unsupported class header",0);
   let defaultParam = pnc-run("default-parameter","def f(x=1):\n    return x\nf()\n","lift-def: unsupported parameter shape",0);
   let annotatedDefault = pnc-run("annotated-default","def f(x: int=1):\n    return x\nf()\n","lift-def: default parameters unsupported",0);
   let starredParam = pnc-run("starred-parameter","def f(*args):\n    return 1\nf()\n","lift-def: unsupported parameter shape",0);
   let keywordParam = pnc-run("keyword-parameter","def f(*, x):\n    return x\nf(1)\n","lift-def: unsupported parameter shape",0);
   let lambdaDefault = pnc-run("lambda-default","f = lambda x=1: x\nf()\n","lift-lambda: unsupported parameter shape",0);
   let groupMissing = pnc-run("group-missing-closer","(41 + 1\n","lift-primary: closing parenthesis required",0);
   let publishDirectory = pnc-publication-refusal("publication-directory",0);
   let publishMissing = pnc-publication-refusal("publication-parent-missing",1);
   let results = list(literal, arithmetic, utf8, function, classCase, inherited, dynamic, demo, refused,arity,missingMethod,missingField,methodLambda,classAppend,listAppend,listAppendFunction,annotations,expressionTail,returnTail,assignTail,subscriptIndexTail,subscriptValueTail,conditionTail,iterableTail,missingOperand,multipleBases,defaultParam,annotatedDefault,starredParam,keywordParam,lambdaDefault,groupMissing,publishDirectory,publishMissing);
   print(results);
   if pnc-all(results) then len(results) else form_error("native compiler case failed");
  }
  def pnc-all(xs) = if nil?(xs) then 1 else and(head(xs),pnc-all(tail(xs)));
 }
 pnc-cases();
}
