; form-nodeid-mastery-cell-loop-live-PROPOSED.fk
;
; DORMANT PROPOSAL. Do not preflight this file: `fmclp-public-lookup` opens the
; persisted public-source registry when a caller explicitly invokes it. There
; is no top-level call, model run, persistence write, channel transport, mesh
; broadcast, Metal work, or native recipe execution here.
;
; The proposal joins the generic mastery mechanism to the strict routed
; NodeID knowledge query. A missing concept-route bucket is typed nothing;
; this adapter never opens the linear registry fallback. Execution evidence is
; not invented: a caller must
; supply an already-observed answer/verdict record. `model-executed=1` is only
; accepted when that record also supplies the real local-Qwen observation
; NodeID whose provenance the live boundary receipts.
;
; imports: form-nodeid-knowledge-routed-query.fk
; imports: form-nodeid-mastery-cell-loop.fk

import "../form/form-stdlib/core.fk"
import "../form/form-stdlib/str-byte-at.fk"
import "../form/form-stdlib/bmf-core.fk"
import "../form/form-stdlib/form-nodeid-knowledge-routed-query.fk"
import "../form/form-stdlib/form-nodeid-mastery-cell-loop.fk"

(do
    ; public context = root registry-artifact local-ready
    (defn fmclp-public-context (root artifact local-ready)
        (list root artifact local-ready))
    (defn fmclp-public-root (ctx) (nth ctx 0))
    (defn fmclp-public-artifact (ctx) (nth ctx 1))
    (defn fmclp-public-local-ready (ctx) (nth ctx 2))

    ; DORMANT EFFECTFUL CALLBACK: exactly one strict concept-route bucket.
    (defn fmclp-public-lookup (ctx request)
        (do
            (let attempt (fmcl-request-attempt request))
            (let key (fmcl-concept-key (fmcl-attempt-concept attempt)))
            (let result (fknqr-execute-strict-at
                (fmclp-public-root ctx) (fmclp-public-artifact ctx)
                (fmclp-public-artifact ctx)
                (fknq-concept-surface key) (fmclp-public-local-ready ctx)
                (fknq-max-frame-bytes)))
            (fmcl-retrieval-evidence
                (fknq-status result) (fknq-reason result)
                (if (str_eq (fknq-status result) "hit")
                    (fknq-source-original-of result) (nothing))
                (if (str_eq (fknq-status result) "hit")
                    (fknq-entry-original-of result) (nothing))
                (fknq-observation result) (fknq-lookup-count result))))

    ; supplied answer record:
    ; status reason answer verdict-present verdict-value surprise failure
    ; model-executed local-qwen-observation execution-count timeout-spent
    ;
    ; This adapter performs no model work. It merely hands supplied evidence to
    ; the mechanism's validator, which refuses model-executed=1 when the Qwen
    ; observation is `nothing`.
    (defn fmclp-observed-execution (record state)
        (fmcl-execution-evidence
            (nth record 0) (nth record 1) (nth record 2) (nth record 3)
            (nth record 4) (nth record 5) (nth record 6) (nth record 7)
            (nth record 8) (nth record 9) (nth record 10)))

    ; Proposed live movement. Calling this would perform the one public lookup;
    ; it still does not run Qwen. `observed-record` must already exist.
    (defn fmclp-proposed-movement
        (public-context concept-key attempt-label observed-record budget
         persistence channel mesh)
        (do
            (let continuation (fmcl-continuation-none channel mesh))
            (let discovered (fmcl-discover concept-key budget persistence
                continuation channel mesh))
            (let chosen (fmcl-choose discovered attempt-label))
            (let surface (fmcl-request-surface concept-key attempt-label))
            (let addressed (fmcl-address chosen surface
                "fknqr-execute-strict-at"
                "supplied-local-answer-observation"))
            (let retrieved (fmcl-retrieve-with public-context
                fmclp-public-lookup addressed))
            (let attempted (fmcl-begin-attempt retrieved))
            (let observed (fmcl-execute-with observed-record
                fmclp-observed-execution attempted))
            (fmcl-decide observed)))

    0)
