; tree-balance.fk — every cell in the tree, asked whether its forms close.
;
; WHY AN ORGAN AND NOT A ONE-OFF. Four cells were found unbalanced this week,
; each by accident, each only when something refused to run — and one of them
; (neutral-rule-mdl-admission.fk) had been that way since its only commit while
; its header claimed band 65535. A class that is only ever found by accident is
; a class that is mostly not found. Swept 2026-08-09: 116 cells in the tree do
; not close, 115 of them paren-surface. Ten were put to fkwu and all ten agreed.
;
; THE COUNT IS PINNED so it can only go down. This is not a gate that blocks —
; it is a number that would have to be edited by hand to hide a new one.
;
; AND THE HONEST LIMIT, paid for the same day: balance is NOT structure. Closing
; a form at the end of a file makes the parens balance and can still nest the
; body wrongly — the MDL cell balanced, parsed, and crashed until the closer
; moved from the list tail to the `(let ...)` it belonged to. So this cell
; COUNTS and LOCATES; it never repairs. The repair needs the cell's own verdict
; to land on before it can be believed.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the sweep walks the tree through host-exec.
;
; USE
;   (tb-unbalanced-n)     ; how many cells in the tree do not close
;   (tb-list)             ; the paths, one per line, with their depth
;
; preludes: form-stdlib/core.fk

(do
    ;; The walk is a find; the balance is Form's. A cell's depth is computed
    ;; here, in the body, from its own bytes — the shell only supplies the list
    ;; of paths, which is the one thing Form has no native door for.
    (defn tb-paths ()
        (host-exec "find . -name '*.fk' -not -path './.git/*' | sort" ""))

    (defn tb-eol (s i n)
        (if (ge i n) n (if (str_eq (substring s i (add i 1)) "\n") i (tb-eol s (add i 1) n))))
    (defn tb-depth-loop (s i n d instr)
        (if (ge i n) d
            (do (let c (substring s i (add i 1)))
                (if (eq instr 1)
                    (tb-depth-loop s (add i 1) n d (if (str_eq c "\"") 0 1))
                    (if (str_eq c "\"") (tb-depth-loop s (add i 1) n d 1)
                    (if (str_eq c ";") (tb-depth-loop s (tb-eol s (add i 1) n) n d 0)
                    (if (str_eq c "(") (tb-depth-loop s (add i 1) n (add d 1) 0)
                    (if (str_eq c ")") (tb-depth-loop s (add i 1) n (sub d 1) 0)
                        (tb-depth-loop s (add i 1) n d 0)))))))))
    (defn tb-depth (path)
        (do (let s (read_file path)) (tb-depth-loop s 0 (str_len s) 0 0)))

    (defn tb-line-at (s i n)
        (do (let e (tb-eol s i n)) (substring s i e)))
    (defn tb-walk (s i n acc count)
        (if (ge i n) (list acc count)
            (do (let p (tb-line-at s i n))
                (let nx (add (tb-eol s i n) 1))
                (if (eq (str_len p) 0) (tb-walk s nx n acc count)
                    (do (let d (tb-depth p))
                        (if (eq d 0) (tb-walk s nx n acc count)
                            (tb-walk s nx n
                                (str_concat acc (str_concat (int_to_str d)
                                    (str_concat "\t" (str_concat p "\n"))))
                                (add count 1))))))))
    (defn tb-sweep () (do (let s (tb-paths)) (tb-walk s 0 (str_len s) "" 0)))
    (defn tb-list () (nth (tb-sweep) 0))
    (defn tb-unbalanced-n () (nth (tb-sweep) 1))

    0)
