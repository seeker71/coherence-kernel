// tree-balance.fk — every cell in the tree, asked whether its forms close.
//
// WHY AN ORGAN AND NOT A ONE-OFF. Four cells were found unbalanced this week,
// each by accident, each only when something would not run — and one of them
// (a neutral-rule admission cell) had been that way since its only commit while
// its header claimed band 65535. A class that is only ever found by accident is
// a class that is mostly not found. Swept 2026-08-09: 116 cells in the tree do
// not close, 115 of them paren-surface. Ten were put to fkwu and all ten agreed.
//
// The count is pinned so it can only go down. Nothing here stops anyone; it is
// a number someone would have to edit by hand to hide a new opening.
//
// AND THE HONEST LIMIT, paid for the same day: balance is NOT structure. Closing
// a form at the end of a file makes the parens balance and can still nest the
// body wrongly — the MDL cell balanced, parsed, and crashed until the closer
// moved from the list tail to the `(let ...)` it belonged to. So this cell
// COUNTS and LOCATES; it never repairs. The repair needs the cell's own verdict
// to land on before it can be believed.
//
// PROOF LEVEL: FOURTH-ARM + GO — the sweep walks the tree through host-exec, which binds on go and fkwu (pf-arm-mask 9, probed 2026-09-03; tests/tree-heal-band.fk answers 255 on both).
//
// USE
//   (tb-unbalanced-n)     ; how many cells in the tree do not close
//   (tb-list)             ; the paths, one per line, with their depth
//
import form-stdlib/core.fk;
section [form.bml] {
    //; The walk is a find; the balance is Form's. A cell's depth is computed
    //; here, in the body, from its own bytes — the shell only supplies the list
    //; of paths, which is the one thing Form has no native door for.
    def tb-paths() = host-exec("find . -name '*.fk' -not -path './.git/*' | sort", "");
    def tb-eol(s, i, n) = i >= n ? n : (String) substring(s, i, (Number) i + (Number) 1) == "\n" ? i : tb-eol(s, (Number) i + (Number) 1, n);
    //; THE ESCAPE, and it is why the first count was wrong.
    //; This scanner left a string on ANY quote, including an escaped one, so a
    //; cell containing \" appeared to end its string early and every paren in
    //; the remaining text was counted as code. It reported 182 where the truth
    //; was 115 — and all 67 of the disputed cells contained an escaped quote,
    //; while fkwu compiled them clean. The disagreement between two counters is
    //; what found it; a single counter would have been believed.
    def tb-depth-loop(s, i, n, d, instr) = i >= n ? d : {
        let c = substring(s, i, (Number) i + (Number) 1);
        (Comparable) instr == 2 ? tb-depth-loop(s, (Number) i + (Number) 1, n, d, 1) : (Comparable) instr == 1 ? (String) c == "\\" ? tb-depth-loop(s, (Number) i + (Number) 1, n, d, 2) : tb-depth-loop(s, (Number) i + (Number) 1, n, d, (String) c == "\"" ? 0 : 1) : (String) c == "\"" ? tb-depth-loop(s, (Number) i + (Number) 1, n, d, 1) : (String) c == ";" ? tb-depth-loop(s, tb-eol(s, (Number) i + (Number) 1, n), n, d, 0) : (String) c == "(" ? tb-depth-loop(s, (Number) i + (Number) 1, n, (Number) d + (Number) 1, 0) : (String) c == ")" ? tb-depth-loop(s, (Number) i + (Number) 1, n, d - 1, 0) : tb-depth-loop(s, (Number) i + (Number) 1, n, d, 0);
    };
    def tb-depth(path) = {
        let s = read_file(path);
        tb-depth-loop(s, 0, len(s), 0, 0);
    };
    def tb-line-at(s, i, n) = {
        let e = tb-eol(s, i, n);
        substring(s, i, e);
    };
    def tb-walk(s, i, n, acc, count) = i >= n ? [acc, count] : {
        let p = tb-line-at(s, i, n);
        let nx = (Number) tb-eol(s, i, n) + (Number) 1;
        (Comparable) len(p) == 0 ? tb-walk(s, nx, n, acc, count) : {
            let d = tb-depth(p);
            (Comparable) d == 0 ? tb-walk(s, nx, n, acc, count) : tb-walk(s, nx, n, (acc + (d.str() + ("\t" + (p + "\n")))), (Number) count + (Number) 1);
        };
    };
    def tb-sweep() = {
        let s = tb-paths();
        tb-walk(s, 0, len(s), "", 0);
    };
    def tb-list() = tb-sweep()[0];
    def tb-unbalanced-n() = tb-sweep()[1];
    0;
}
