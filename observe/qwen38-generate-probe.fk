; qwen38-generate-probe.fk — run the Form-native Qwen3.8 generate door on fkwu,
; so the emitted form-cli binary is not in the way of the reading.
;
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let t0 (now_unix_ms))
    (let out (fcmg-generate path "Reply with exactly: LOCAL FORM ALIVE" 24))
    (let t1 (now_unix_ms))
    (print out)
    (print (str_concat "probe_wall_ms=" (int_to_str (sub t1 t0))))
    (print (metal_status))
    0)
