; qwen-lora-head-mint-run.fk — mint and admit the local untrained Qwen seed.
;
; Its framebuffer event is a local physical artifact/admission receipt, not a
; claim that the voice evaluation has passed.
; preludes: form/form-stdlib/qwen-lora-head.fk

(do
    (let path (qlh-path))
    (let bytes (qlh-write path (qlh-source)))
    (let adapter (qlh-admit path))
    (let admitted (qlh-admitted? adapter))
    (let whole (qlh-whole? path))
    (framebuffer-clear)
    (fb_record (intern_trivial_string "qwen-lora-head-artifact-local")
               "form/form-stdlib/qwen-lora-head.fk" whole)
    (fb_record (intern_trivial_string "qwen-lora-head-device-admitted")
               "form/native/metal/qwen35-dense-token-handle.fk" admitted)
    (print (list "qwen-lora-head" "artifact" whole "bytes" bytes
                 "device-admitted" admitted "voice-home" 0
                 "events" (len (framebuffer-events))))
    (qlh-close adapter)
    (if (and (eq whole 1) (eq admitted 1)) 1 0))
