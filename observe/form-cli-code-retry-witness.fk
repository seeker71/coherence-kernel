; Explicit real-model recovery witness. Seeds a known wrong candidate, not a
; claimed model mistake. Reads the local Qwen registry name from stdin.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/form-cli-code-repair-fixture.bml
(do
 (let model (read_line))
 (let failed (fcrf-failure))
 (if (and (str_eq (fcap-stage failed) "repair") (eq (fcap-checks failed) 1))
  (do
   (let result (fcac-admit model failed (fcrf-checker) 8192 30))
   (print (list "seeded-policy-turns" (fcap-turns failed)
    "local-model-replies" (sub (fcap-turns (head result)) (fcap-turns failed))))
   (print_str (str_concat (fcaq-result result) "\n")))
  (print "native-fault-injection-did-not-fail-as-required")))
