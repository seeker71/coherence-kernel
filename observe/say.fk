; say.fk — a voice mid-program, on every arm, through a door that was already open.
;
; preludes: form/form-stdlib/core.fk
;
; WHY THIS EXISTS. `print` is a native on Go, Rust and TypeScript and is ABSENT on fkwu,
; where the call recovers to nothing under axiom-5 and simply does not happen. Counted
; 2026-07-26, with comments and string literals stripped so the number means something:
;
;     print   751 real call sites in 104 cells
;
; Seven hundred and fifty-one places where this body says something on three kernels and
; is silent on the fourth, without a single error to mark it. That is the largest absent
; -name population in the tree, and it is the quiet kind.
;
; THE DOOR. fkwu has no `print`, but it has `write_file_text`, and stdout is a file:
;
;     (write_file_text "/dev/stdout" "hello\n")
;
; Measured on all four arms — fkwu, Go, Rust, TypeScript — each prints the text and then
; its own final value. The capability was never missing. Only the name was.
;
; WHY A NEW NAME. Defining Form `print` would be the mistake this session already
; measured: on Go and Rust a user `defn` takes the name away from a present native, so a
; Form `print` would REPLACE working output on two arms to fix a fourth. `say` is a name
; no native owns, checked before it was chosen — the same shape as `fol-bp`.
;
; See receipts/2026-07-26-a-voice-through-a-door-that-was-open.md.
; Proven by observe/tests/say-band.fk.

(do
    ; ── the door, named ─────────────────────────────────────────────────────
    (defn say-stdout-path () "/dev/stdout")

    ; say — write text as it is, no newline added. Answers the byte count, so a
    ; caller can tell that it happened.
    (defn say (s) (write_file_text (say-stdout-path) s))

    ; say-line — the common case.
    (defn say-line (s) (say (str_concat s "\n")))

    ; say-to — the same act aimed somewhere durable. The band uses this, because a
    ; band that proved itself by writing to stdout would be proving it by being read.
    (defn say-to (path s) (write_file_text path s))
    (defn say-line-to (path s) (say-to path (str_concat s "\n")))

    ; say-count — a label and a number, the shape most diagnostics want.
    ; NOTE the trap this session found: (int_to_str 10.5) answers "" on fkwu, "10" on
    ; go and rust, "10.5" on ts. Hand this integers. A fraction will go quiet here on
    ; exactly one arm, which is how it hid the first time.
    (defn say-count (label n) (say-line (str_concat label (str_concat " " (int_to_str n)))))

    0)
