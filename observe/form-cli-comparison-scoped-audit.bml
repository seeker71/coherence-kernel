// preflight-exec: forbidden
// Compare the retained packets and count the seventh native attempt once.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let prefix = "receipts/artifacts/2026-09-20-scoped-native-comparison";
 let result = parse-json("scoped-result",read_file(str_concat(prefix,"-result.json")));
 let generation = json-object-get(result,"generation");
 let prior = parse-json("prior-audit",read_file("receipts/artifacts/2026-09-20-fresh-native-comparison-audit.json"));
 let source = parse-json("scoped-source",read_file(str_concat(prefix,"-source.json")));
 let original = parse-json("original-source",read_file("receipts/artifacts/2026-09-20-source-restored-provider-source.json"));
 let fresh = parse-json("fresh-source",read_file("receipts/artifacts/2026-09-20-fresh-native-comparison-source.json"));
 fcr-need(str_eq(read_file(str_concat(prefix,"-source.json")),json-emit(fcr-fresh-domain(fcr-scoped-domain(original)))),"retained scoped source differs from the runner's native selection and field order");
 let packet = fcr-packet(str_concat(prefix,"-packet.json"));
 let previous = fcr-packet("receipts/artifacts/2026-09-20-fresh-native-comparison-packet.json");
 fcr-need(str_eq(packet,fcr-fresh-packet(source)),"retained scoped packet differs from prepared task");
 fcr-need(str_eq(substring(packet,0,str_find(packet,"\n\n{",0)),substring(previous,0,str_find(previous,"\n\n{",0))),"fresh composition instruction changed");
 fcr-need(node_eq(json-object-get(source,"original_enquiry"),json-object-get(fresh,"original_enquiry")),"enquiry changed");
 let evidence = json-object-get(source,"evidence"); let oldEvidence = json-object-get(fresh,"evidence");
 fcr-need(node_eq(oh-set(evidence,"route_usage",json-node-null()),oh-set(oldEvidence,"route_usage",json-node-null())),"evidence other than route usage changed");
 let report = json-node-object(list(nsm-n("scoped_source_verified",1),nsm-n("instruction_unchanged",1),nsm-n("non_usage_evidence_unchanged",1),nsm-n("native_calls",add(nsm-num(prior,"native_calls"),1)),nsm-n("prompt_ids",add(nsm-num(prior,"prompt_ids"),nsm-num(generation,"prompt_ids"))),nsm-n("generated_ids",add(nsm-num(prior,"generated_ids"),nsm-num(generation,"generated_ids"))),nsm-n("execution_ms",add(nsm-num(prior,"execution_ms"),nsm-num(result,"elapsed_ms"))),nsm-n("provider_calls",0),nsm-n("evaluation_training",0),nsm-s("scope","Seven retained native comparison attempts including unsuccessful outputs: citation trial, focused contrast, sectioned draft, two reviews, fresh composition and scoped composition. Native execution windows only; earlier Sep19 generation, preparation, compilation, retention, learning and coordinator are separate. Scoped and fresh composition use the same instruction and non-usage evidence; a single paired observation does not prove stable quality.")));
 frsh-frozen(str_concat(prefix,"-audit.json"),json-emit(report));
 print_str(json-emit(report));
 1;
}
