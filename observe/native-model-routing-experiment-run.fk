; native-model-routing-experiment-run.fk — print the bounded policy replay.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/native-model-control-plane.fk form/form-stdlib/native-model-control-plane-eval.fk form/form-stdlib/form-teach-layer.fk form/form-stdlib/native-model-form-token-envelope.bml form/form-stdlib/native-model-routing-experiment.bml

(do
    (nmre-print-report)
    (list "native-model-routing-experiment" "cases" (len (nmre-cases))
        "champion" (nmre-champion)
        "physical-baseline" (len (nmre-physical-baseline))
        "physical-after" (len (nmre-physical-after))))
