// stdin: one JSON line with body_path, optional turn (0 selects the next),
// and optional kind (direct-answer). The complete file is the task body.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/hearth-client.bml
section [form.bml] {
 hc-send-file(parse-json("hearth-file-request",read_line()));
}
