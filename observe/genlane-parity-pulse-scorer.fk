; genlane-parity-pulse-scorer.fk — the parity pulse's pure scorer, in its
; own cell so the band can witness it without waking a model.
;
; Score ONLY the answer text after the "text:" marker — the fcmg span
; carries telemetry fields before it, and a needle can match a FIELD NAME
; instead of the answer (witnessed on the first live verdict, 2026-08-30:
; "othing" matched heed_nothings=0 and lit T1 falsely, verdict 3 where the
; answers earn 2). A missing marker scores as an empty answer, never as
; the whole span.
;
; preludes: form-stdlib/core.fk

(do
    (defn glp-answer (reply)
        (do
            (let at (str_find reply "text:" 0))
            (if (lt at 0) ""
                (substring reply (add at (str_len "text:")) (str_len reply)))))
    (defn glp-hit? (reply needle)
        (if (ge (str_find (glp-answer reply) needle 0) 0) 1 0))

    ; ── the high-grammar authority ─────────────────────────────────────────
    ; The BML lawface of the whole pulse — three tasks, the answer seam, the
    ; budget floor, the start line, the falling verdict — lives beside the
    ; other high authorities: the .bml is the readable law, this cell is its
    ; living mirror, the band is its witness.
    (defn glp-authority-path () "form/form-stdlib/bml/genlane-parity.bml")
    (defn glp-authority-kind () "high-bml-class-template-field")
    (defn FormGenlaneParityAuthority ()
        (list "abstraction" "FormGenlaneParityAuthority" (list) (list)
            (list "glp-authority-path" "glp-authority-kind") (list) (list)))
    0)
