; Bounded real-model witness for the crystallized layer plan.  Opens the
; configured DS4 GGUF, embeds two valid vocabulary ids, executes layer 0 for
; both positions through one reused plan, and closes the same native session.
; preludes: native/metal/dsv4-native-session.fk

(do
    (dns-open)
    (dlw-live-prefill (list 0 1) 1)
    ; The caller adjudicates the complete captured receipt: this marker alone
    ; cannot turn an earlier FAIL into success.
    (print_str "CANDIDATE dsv4-layer-plan-two-position-live")
    (print_str "positions=2")
    (print_str "layers=1")
    (print_str "network=0")
    (print_str "remote=0")
    (print_str "rewitness-offer=dsv4-layer-plan-two-position-live")
    (print_str (metal_model_close)))
