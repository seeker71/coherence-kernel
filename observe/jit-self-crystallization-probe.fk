; jit-self-crystallization-probe.fk — named cold/hot observations for the
; compiler-on-compiler specialization.  No file, process, model or Metal crossing.
; preludes: form/form-stdlib/core.fk form/form-stdlib/form-asm.fk form/form-stdlib/form-lower.fk form/form-stdlib/jit-self-crystallization.fk
(do
    (defn jscp-walk-form (h i n acc)
        (if (ge i n) acc
            (jscp-walk-form h (add i 1) n
                (add acc (jssc-interpreted h (mod i 5))))))
    (defn jscp-walk-native (h i n acc)
        (if (ge i n) acc
            (jscp-walk-native h (add i 1) n
                (add acc (jssc-apply-at h (jssc-handle-identity h) (mod i 5))))))
    (let t0 (now_unix_ms))
    (let values (jssc-lo-cmp-values))
    (let t1 (now_unix_ms))
    (let built (jssc-build values))
    (let t2 (now_unix_ms))
    (let image (lo-compile-fn (nth built 0) (nth built 1)))
    (let t3 (now_unix_ms))
    (let born (jssc-birth values))
    (let t4 (now_unix_ms))
    (let born2 (jssc-birth values))
    (let changed (jssc-birth (cons 9 (tail values))))
    (let t5 (now_unix_ms))
    (let form-sum (jscp-walk-form born 0 1000 0))
    (let t6 (now_unix_ms))
    (let native-sum (jscp-walk-native born 0 1000 0))
    (let t7 (now_unix_ms))
    (list
        (list "observed-values" (len values))
        (list "program-rows" (len (nth built 0)))
        (list "root-row" (nth built 1))
        (list "image-bytes" (len image))
        (list "observe-ms" (sub t1 t0))
        (list "program-birth-ms" (sub t2 t1))
        (list "lower-ms" (sub t3 t2))
        (list "handle-birth-ms" (sub t4 t3))
        (list "two-more-births-ms" (sub t5 t4))
        (list "form-1000-ms" (sub t6 t5))
        (list "native-nodeid-1000-ms" (sub t7 t6))
        (list "form-native-sum-agree" (eq form-sum native-sum))
        (list "carrier-live" (jssc-handle-carrier-live? born))
        (list "same-source-same-nodeid"
            (node_eq (jssc-handle-identity born) (jssc-handle-identity born2)))
        (list "changed-source-changed-nodeid"
            (not (node_eq (jssc-handle-identity born)
                          (jssc-handle-identity changed))))))
