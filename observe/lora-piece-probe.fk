; lora-piece-probe.fk — the pieces behind a list of token ids, read through the body's own index.
; stdin line 1: space-separated ids
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-tongue.fk
(do
    (defn lpp-t (x) (if (nothing? x) "" x))
    (defn lpp-nums-go (s i acc cur have)
        (if (ge i (str_len s))
            (if (eq have 1) (reverse (cons cur acc)) (reverse acc))
            (do (let b (str_byte_at s i))
                (if (and (ge b 48) (le b 57))
                    (lpp-nums-go s (add i 1) acc (add (mul cur 10) (sub b 48)) 1)
                    (if (eq have 1) (lpp-nums-go s (add i 1) (cons cur acc) 0 0) (lpp-nums-go s (add i 1) acc 0 0))))))
    (defn lpp-nums (s) (lpp-nums-go s 0 (list) 0 0))
    (defn lpp-show (pp ip n ids)
        (if (eq (len ids) 0) 0
            (do (print_str (str_concat (int_to_str (head ids)) (str_concat " |" (str_concat (et-piece-of pp ip n (head ids)) "|\n"))))
                (lpp-show pp ip n (tail ids)))))
    (let ids (lpp-nums (lpp-t (read_line))))
    (let lane (et-lane-open))
    (lpp-show (nth lane 5) (nth lane 6) (nth lane 7) ids)
    0)
