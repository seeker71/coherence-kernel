; qwen38-layer-split-run.fk — how many layers are full attention, how many linear?
; kth-full? is (l+1) mod interval == 0. That ratio decides everything left.
; preludes: form/form-stdlib/form-cli-model-generate.fk
(do
    (defn ls-int (k v) (print_str (str_concat "split " (str_concat k (str_concat "=" (str_concat (int_to_str v) "\n"))))))
    (defn ls-count (l n interval acc)
        (if (ge l n) acc
            (ls-count (add l 1) n interval (add acc (if (kth-full? l interval) 1 0)))))
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let src (fcmg-src path))
    (let geo (q38-geo src 1024))
    (ls-int "layers" (nth geo 21))
    (ls-int "interval" (nth geo 22))
    (ls-int "full-attention-layers" (ls-count 0 (nth geo 21) (nth geo 22) 0))
    (ls-int "linear-attention-layers" (sub (nth geo 21) (ls-count 0 (nth geo 21) (nth geo 22) 0)))
    0)
