; merge-no-result-framebuffer-round6.fk — turn the failed merge into a live
; framebuffer decision before editing: unresolved call -> local native emitter.
import "thought-framebuffer.fk"
; witnessed: 2026-07-21 -> before [nothing,0,1,6101,5,1,1,1,1,1];
; after [nothing,0,1,6101,0,0,1,1,0,1,1,1,1].
(do
  (defn mnf6-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (mnf6-match s i p (add j 1)) 0))))
  (defn mnf6-count (s p i n) (if (gt (add i (str_len p)) (str_len s)) n
    (if (eq (mnf6-match s i p 0) 1)
      (mnf6-count s p (add i (str_len p)) (add n 1))
      (mnf6-count s p (add i 1) n))))
  (let source (read_file "cognition/core-model-merge-round6.fk"))
  (let unresolved-sites (mnf6-count source "int_to_str" 0 0))
  (let state-absent (if (eq (str_len (read_file ".form-core-model-v6.state")) 0) 1 0))
  (let state-present (if (eq state-absent 0) 1 0))
  (let before (list (fb-frame 0 1 1)
    (fb-no-result-frame 1 "unresolved-call" "local-native-int-emitter")))
  (let after (list (fb-frame 0 1 1) (fb-frame 1 state-present 1)))
  (framebuffer-clear)
  (let event (fb_record (intern_trivial_int unresolved-sites)
    "merge-no-result-framebuffer-round6.fk" 1))
  (let runtime-frames (len (framebuffer-events)))
  (let choose-alternate (if (and (gt unresolved-sites 0) (eq state-absent 1)) 1 0))
  (let learned (if (and (eq unresolved-sites 0)
    (and (eq state-present 1) (eq (thinking-changed? before after) 1))) 1 0))
  (list (nothing) 0 1 6101 unresolved-sites state-absent state-present
    (fb-no-result? (head (tail before))) choose-alternate learned
    (diverge before after) runtime-frames
    (if (and (eq learned 1) (eq runtime-frames 1)) 1 0)))
