// prompt-lookup-run.bml — does copying drafts from the prompt make the local decode faster, and is it the same reply?
//
// The physical half of prompt-lookup drafting (form-stdlib/bml/form-cli-model-draft.bml). Everything that needs no
// model is held by form-stdlib/tests/form-cli-model-draft-band.bml (524287, the verdict gate and this door's row
// included) and the matmul claim by form-stdlib/tests/q8-0-mma-prefix-band.fk (63). This door reads the rest on the
// real model, one command, on a quiet machine (about 35 minutes for three timed sessions, the first estimate and
// not a measurement; this door times five and warms two):
//
//   printf 'physical\n' | ./fkwu observe/prompt-lookup-run.bml
//
// On a fixture coding prompt that carries a file (form/form-stdlib/closure-lines.fk) and asks for it back with one
// line added, fresh qwen38-q8 sessions each decode `ids` IDs (64) in the code lane's quanta of 4, through the lane's
// own fcacs-quantum and fcacs-next. One session is resident at a time: each is released as soon as its arm is read.
//   warm       two untimed sessions on a short prompt (token-wise, then drafted), so the weights are read from disk and
//              the pipelines are built before anything is timed
//   tokenwise  the lane as it runs today (ps[29] matvec per position)
//   k3         the drafted lane with copied drafts of up to 3 IDs
//   k0         the drafted lane with nothing drafted: every position a span of 1 through the verify
//   k3, tokenwise again
// The timed order is tokenwise, k3, k0, k3, tokenwise: the two arms the gate compares are measured on either side of
// the one in the middle, so first-use cost and drift do not fall on one of them. The k0 session then reads the same 8
// IDs at one position under four splits of the span (one of 8, eight of 1, 3 then 5, 5 then 3), marked and
// restored, and compares the logits bytes the head wrote.
//
// One row is appended to receipts/prompt-lookup.jsonl (fcmdr-row): at_unix_ms, model, fixture, ids_n, width, kmax;
// full (every timed arm produced exactly ids_n IDs in a measured time); identical (both k3 replies equal the k0
// reply ID for ID); split_equal (the logits bytes are equal across the four splits) and split_digest;
// tokenwise_ids_n and tokenwise_agree (positions where the first token-wise and the k0 IDs agree; reported, not
// gated, since the span matmul and the decode matvec are two arithmetics); ms_*; tok_s_milli_* (IDs per second,
// times 1000, the token-wise and k3 ones over both of their arms); margin_pct; the draft counters of the k3 arms
// summed (steps, verifies, drafted, accepted, reruns, marks, lookups, found, refused); faster (k3 decoded more IDs
// per second than token-wise by margin_pct); offered (drafts were offered and accepted and no k3 or k0 step was
// refused); released (all seven sessions released clean); verdict "open" when full, identical, split_equal, faster,
// offered and released all read 1, else "hold" (fcmdr-judge). The lane stays off (fcmdr-live,
// form-cli-model-draft.bml) until a row reads "open" and a landing reads it.
//
// Before the model opens the door reads the host's fkwu and form-cli processes: while a door that holds a model
// runs (form-cli-code-run, native-turn-run, day-turn, scheduled-walk, native-lora, form-token-eval-run, another
// prompt-lookup-run) or a form-cli verb that asks a local model, it names them, appends no row and stops with exit
// status 1. It does not wait. The day-turn walk holds the GPU from 12:30 to 15:00 and its own check
// (fte-holder-doors, form-stdlib/bml/form-token-eval.bml) does not name this door yet, so a run started before
// 12:30 meets the walk's model while it holds its own: do not start this door so late that it can still be running
// at 12:30 until "prompt-lookup-run" stands in that list.
//
// Anything but a `physical` line on stdin (a terminal, /dev/null, empty) loads no model: it reads the receipts and
// says what is pending.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-code-session.bml;
import form-stdlib/bml/form-token-eval.bml;
import form-stdlib/bml/form-cli-heal-native-io.bml;
import form-stdlib/model-registry.bml;
section [form.bml] {
 class PromptLookupRun {
  def plr-model() = "qwen38-q8";
  def plr-ledger() = "receipts/prompt-lookup.jsonl";
  def plr-file() = "form/form-stdlib/closure-lines.fk";
  def plr-ids() = 64;
  def plr-warm-ids() = 8;
  def plr-width() = 4;
  def plr-profile() = "knowledge-query";
  def plr-prompt() = "Below is a Form file. Reply with the whole file again, exactly as it is, with one line added at the top: ; reviewed\n\n" ++ (read_file(plr-file()) ?? "");
  def plr-warm-prompt() = "Reply with the single word ok.";
  // ── the rows so far ──
  def plr-rows() = file_size(plr-ledger()) < 1 ? [] : filter(l => len(trim(l)) > 0, split-on(fhn-read(plr-ledger()), "\n"));
  def plr-pending() {
   let rows = plr-rows();
   print_str("prompt-lookup-run rows=" ++ len(rows).str() ++ " last_verdict=" ++ fcmdr-last-verdict(rows) ++ " live=" ++ fcmdr-live().str() ++ " (a quiet machine: printf 'physical\\n' | ./fkwu observe/prompt-lookup-run.bml)");
   0;
  }
  // ── the GPU gate: [pid, what it holds] for each other process that holds a model ──
  def plr-holding(argv, cli) {
   let door = fte-holding(argv, cli);
   (String) door != "" ? door : foldl((found, w) => ((String) found == "") && ((String) value_kind(w) == "string") && (str_find(w, "prompt-lookup-run", 0) >= 0) ? "prompt-lookup-run" : found, "", (String) value_kind(argv) == "list" ? argv : []);
  }
  def plr-holder(row, cli) = (String) value_kind(row) != "list" ? [0, ""] : len(row) < 5 ? [0, ""] : (Comparable) row[0] == host_pid() ? [0, ""] : [row[0], plr-holding(row[4], cli)];
  def plr-processes(name) {
   let pids = host_processes(name);
   (String) value_kind(pids) != "list" ? [] : map(p => host_process(p[0]), pids);
  }
  def plr-held() = filter(h => !((String) h[1] == ""), append(map(r => plr-holder(r, false), plr-processes("fkwu*")), map(r => plr-holder(r, true), plr-processes("form-cli*"))));
  // Names the holders and stops: no row, exit status 1 (form_error), so a script that reads the status reads a run that did not happen.
  def plr-wait(held) {
   print_str("[prompt-lookup-run] the GPU is held by " ++ str-join-with(map(h => h[1] ++ " (pid " ++ h[0].str() ++ ")", held), ", ") ++ ": no row appended; run again on a quiet GPU");
   form_error("prompt-lookup-run: the GPU is held");
  }
  // ── one arm: a fresh session on a prompt, decoded by the lane's own quantum and boundary, then released ──
  // kmax < 0 is the lane as it runs today; 0 and up attach the draft owner at that width. The probe runs on the
  // live session after the arm was timed and read, and before it is released.
  def plr-open(path, prompt, kmax) {
   let opened = fcms-open-with-profile(path, prompt, 4096, plr-profile());
   kmax < 0 ? opened : fcacs-attach-draft-with(opened, prompt, plr-profile(), kmax);
  }
  def plr-decode(s, stops, n, out) {
   let g = fcacs-quantum(s, stops, plr-width());
   let s2 = fcms-generation-session(g);
   let out2 = append(out, fcms-generation-ids(g));
   len(out2) >= n || fcms-stopped?(s2) || !fcms-live?(s2) ? [take(n, out2), s2] : plr-decode(fcacs-next(s2, stops), stops, n, out2);
  }
  def plr-counts(owner) {
   let c = fcmdr-counts(owner);
   nil?(c) ? [0, 0, 0, 0, 0, 0, 0, 0, 0] : c;
  }
  // fcms-release-ok? answers a number or a truth value by the branch it takes: the run reads 1 or 0.
  def plr-released(s) = fcms-release-ok?(s) ? 1 : 0;
  def plr-no-probe(s) = 0;
  def plr-arm(path, name, kmax, prompt, n, probe) {
   let s = plr-open(path, prompt, kmax);
   let began = now_unix_ms();
   let r = fcms-live?(s) ? plr-decode(s, fcacs-stops(s, qsx-load(fcms-path(s))), n, []) : [[], s];
   let ms = now_unix_ms() - began;
   let counts = plr-counts(fcmdr-owner(r[1]));
   let probed = fcms-live?(r[1]) ? probe(r[1]) : [];
   fcmdr-arm(name, r[0], ms, plr-released(r[1]), counts, probed);
  }
  def plr-warm(path, name, kmax) = plr-arm(path, name, kmax, plr-warm-prompt(), plr-warm-ids(), plr-no-probe);
  def plr-timed(path, name, kmax, probe) = plr-arm(path, name, kmax, plr-prompt(), plr-ids(), probe);
  // ── span-split invariance across the stack, on the k0 session, marked and restored around each split ──
  def plr-split(s, chunks) {
   let owner = fcmdr-owner(s);
   q38dv-mark(fcms-ctx(s), fcms-sts(s), fcmdr-spare(owner));
   let bytes = q38dv-logits(fcms-ctx(s), fcms-sts(s), fcmd-carrier(s), chunks, fcms-pos(s));
   q38dv-restore(fcms-ctx(s), fcms-sts(s), fcmdr-spare(owner));
   bytes;
  }
  def plr-splits(s, ids) = nothing?(fcmdr-owner(s)) ? [] : map(c => plr-split(s, c), fcmdr-chunks(take(8, ids)));
  def plr-list?(x) = (String) value_kind(x) == "list";
  def plr-split-equal(split) = plr-list?(split) ? fcmdr-bytes-equal(split) : 0;
  def plr-digest(split) = !plr-list?(split) ? "" : nil?(split) ? "" : nothing?(split[0]) ? "" : hex-encode(sha256-stream-string(split[0]));
  // ── the row ──
  def plr-physical() {
   let path = mr-path(mr-find(plr-model()));
   let warm0 = plr-warm(path, "warm-tokenwise", -1);
   let warm1 = plr-warm(path, "warm-k3", fcmdr-width());
   let tw1 = plr-timed(path, "tokenwise", -1, plr-no-probe);
   let k3a = plr-timed(path, "k3", fcmdr-width(), plr-no-probe);
   let k0 = plr-timed(path, "k0", 0, s => plr-splits(s, fcmdr-arm-ids(tw1)));
   let k3b = plr-timed(path, "k3", fcmdr-width(), plr-no-probe);
   let tw2 = plr-timed(path, "tokenwise", -1, plr-no-probe);
   plr-report([tw1, tw2], k0, [k3a, k3b], [warm0, warm1]);
  }
  def plr-report(tws, k0, k3s, warm) {
   let split = fcmdr-arm-probe(k0);
   let judged = fcmdr-judge(plr-ids(), tws, k0, k3s, plr-split-equal(split), warm);
   let row = fcmdr-row(now_unix_ms(), plr-model(), plr-file(), plr-width(), plr-ids(), tws, k0, k3s, plr-digest(split), judged);
   print_str("prompt-lookup-row " ++ json-emit(row));
   let appended = fhn-append(plr-ledger(), json-emit(row) ++ "\n");
   print_str("prompt-lookup-verdict " ++ fcmdr-last-verdict([json-emit(row)]) ++ " " ++ appended);
   0;
  }
  def plr-run() {
   let ask = isatty() == 1 ? nothing() : read_line();
   nothing?(ask) || trim(ask) != "physical" ? plr-pending() : plr-gated(plr-held());
  }
  def plr-gated(held) = nil?(held) ? plr-physical() : plr-wait(held);
 }
 plr-run();
}
