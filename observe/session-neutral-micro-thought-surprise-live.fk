; session-neutral-micro-thought-surprise-live.fk — several recorded
; arrival-seeded symbol micro-thoughts realized into natural-language surfaces.
; witnessed: 2026-08-24 -> seed 865196398, lift 16300, 76 graph edges
; preludes: cognition/session-neutral-micro-thought.fk

(do
  (defn snmtl-take (values count)
    (if (or (le count 0) (eq (len values) 0)) (empty)
      (cons (head values) (snmtl-take (tail values) (sub count 1)))))
  (defn snmtl-drop (values count)
    (if (or (le count 0) (eq (len values) 0)) values
      (snmtl-drop (tail values) (sub count 1))))
  (defn snmtl-realizations (runtime dictionary round)
    (snmt-realize-locales runtime dictionary (snmt-r-recipe round)
      (list "en" "de" "zh" "fr" "ban" "sa")))
  (defn snmtl-total-lift (rounds)
    (if (eq (len rounds) 0) 0
      (add (snmt-r-surprise-lift (head rounds))
        (snmtl-total-lift (tail rounds)))))
  (defn snmtl-print-round (ordinal round realizations)
    (do
      (print "\nround=") (print (int_to_str ordinal))
      (print " candidate-events=") (print (snmt-r-draws round))
      (print " candidate-surprise=") (print (snmt-r-scores round))
      (print " chosen-event=") (print (snmt-e-draw (snmt-r-event round)))
      (print " surprise-lift-over-first-event=")
      (print (int_to_str (snmt-r-surprise-lift round)))
      (print " neutral-symbols=") (print (snmt-r-recipe round))
      (print " axis-ids=") (print (snmt-symbol-ids (snmt-r-recipe round)))
      (print " observer-labels=")
      (print (snmt-observer-labels (snmt-r-recipe round)))
      (print " surprise-shape=")
      (print (snmt-c-surprise (snmt-r-chosen round)))
      (print " locale-surfaces=")
      (print (snmt-realized-surfaces realizations))
      (print " graph-edges=")
      (print (int_to_str (len (snmt-graph round realizations))))))

  (let opened (snmt-open))
  (let runtime (snmt-o-runtime opened))
  (let dictionary (snmt-o-dictionary opened))
  ; Millisecond arrival and current framebuffer population make a varying live
  ; seed. The exact seed and every derived event are printed for replay.
  (let seed (snmt-positive
    (bxor (now_unix_ms) (add (kernel_stat 0) (kernel_stat 6)))))
  (let draws (snmt-draw-stream seed 12))
  (let round-1 (snmt-round (empty) (snmtl-take draws 3)))
  (let round-2 (snmt-round (snmt-r-recipe round-1)
    (snmtl-take (snmtl-drop draws 3) 3)))
  (let round-3 (snmt-round (snmt-r-recipe round-2)
    (snmtl-take (snmtl-drop draws 6) 3)))
  (let round-4 (snmt-round (snmt-r-recipe round-3)
    (snmtl-take (snmtl-drop draws 9) 3)))
  (let real-1 (snmtl-realizations runtime dictionary round-1))
  (let real-2 (snmtl-realizations runtime dictionary round-2))
  (let real-3 (snmtl-realizations runtime dictionary round-3))
  (let real-4 (snmtl-realizations runtime dictionary round-4))
  (let joined-graph
    (snsp-unique-edges
      (append (snmt-graph round-1 real-1)
        (append (snmt-graph round-2 real-2)
          (append (snmt-graph round-3 real-3)
            (snmt-graph round-4 real-4))))))
  (print "session-neutral-micro-thought-surprise")
  (print "\nvariation-lane=arrival-seeded-pseudo-random-recorded")
  (print "\nseed=") (print (int_to_str seed))
  (snmtl-print-round 1 round-1 real-1)
  (snmtl-print-round 2 round-2 real-2)
  (snmtl-print-round 3 round-3 real-3)
  (snmtl-print-round 4 round-4 real-4)
  (print "\njoined-reversible-graph-edges=")
  (print (int_to_str (len joined-graph)))
  (print " total-surprise-lift-over-first-events=")
  (print (int_to_str (snmtl-total-lift
    (list round-1 round-2 round-3 round-4))))
  (print "\n")
  0)
