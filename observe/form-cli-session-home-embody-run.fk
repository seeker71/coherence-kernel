// preflight-exec: forbidden
// Return the session's verified teaching to the shared learner. cell_input()
// carries its native node; terminal stdin accepts JSON: prompt, completion, session, event.
// With no input, drain retained experience and report actual current state.
import form-stdlib/native-session-memory.bml;
section [form.bml] {
    let native = cell_input();
    let input = nothing?(native) ? read_line() : native;
    let absent = nothing?(input) || ((String) value_kind(input) == "string" && (String) input == "");
    let home = hearth-session-learning();
    let offered = absent ? nsm-kick(home) : nsm-teach(home, input);
    nothing?(native) ? print_str(absent ? offered : nsm-teach-report(offered)) : nothing();
    nothing?(native) ? print_str("\n") : nothing();
    // Native delivery retains the worker's continuation; terminal drain waits.
    let settled = nothing?(native) ? nsm-settle(home) : nsm-status(home);
    nothing?(native) ? print_str(json-emit-precise(settled)) : nothing();
    // A retained teaching the learner could not take is a failed exit, not a quiet 0.
    let exit = nsm-settle-exit(settled);
    nothing?(native) ? exit : record_new(0,"teaching",offered,"learning",settled);
}
