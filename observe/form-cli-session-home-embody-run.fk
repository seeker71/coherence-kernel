; preflight-exec: forbidden
; Return the session's verified teaching to the shared learner. Optional stdin
; is one explicit correction JSON: prompt, completion, session, event.
; With no input, drain retained experience and report actual current state.
; preludes: form-stdlib/native-session-memory.bml
(do
 (let input (read_line))
 (let home (hearth-session-learning))
 (let offered (if (or (nothing? input) (str_eq input "")) (nsm-kick home) (nsm-teach-report (nsm-teach home input))))
 (print_str offered)
 (print_str "\n")
 (let settled (nsm-settle home))
 (print_str (json-emit-precise settled))
 ; A retained teaching the learner could not take is a failed exit, not a quiet 0.
 (if (and (eq (str_find (nsm-str settled "worker_status") "failed-" 0) 0) (gt (nsm-num settled "pending") 0))
     (form_error "session learner failed; retained examples stay pending; worker_stderr names the cause")
     0))
