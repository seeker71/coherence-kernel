; nd-geometry-read.fk — one door for fold, project, transform, bridge-string.
; preludes: form-stdlib/core.fk form-stdlib/nd-geometry.fk
(do
    (let p4 (list 1 2 3 4))
    (let bridge (nd-bridge (list 0 0 0) (list 0 0 6) 3))
    (print (list "schema" "nd-geometry-read-v1"
        "project-axis-4d-3d" (nd-project-axis p4)
        "fold-last" (nd-fold-last p4)
        "project-onto-x" (nd-project (list 3 4) (list 1 0))
        "turn-90" (nd-transform (list (list 0 (sub 0 1)) (list 1 0)) (list 1 0))
        "bridge-3d" bridge
        "perp2" (nd-perp2 (list 3 4))
        "cross3" (nd-cross3 (list 1 0 0) (list 0 1 0))
        "tensor-4d" (nd-tensor2 (list 1 2) (list 3 4))
        "homog" (nd-from-homog (list 4 6 2))
        "area2" (nd-area2 (list 3 0) (list 0 4))
        "embed-4d" (nd-embed (list 1 2) 4)
        "interleave" (nd-interleave (list 1 2) (list 3 4))
        "elbow" (nd-elbow (list 0 0) (list 4 2))
        "string-theory" 0))
    0)
