// preflight-exec: forbidden
// Structural observation and organ health; no prompt or answer text is carried.
// preludes: form-stdlib/bml/form-cli-composition-witness.bml form-stdlib/organ-health.bml
section [form.bml] {
 let report = fccw-observe();
 let passed = fccw-passed(report);
 let observed = json-object-get(report,"observed");
 let healthEvent = oh-reading("composition-witness","native-response-grounding","retained-composition",fccw-expected(),observed,json-node-int(passed),if passed then list() else list(oh-need("native-composition-evidence",observed)),list("continue","request-evidence"),json-object-get(report,"source"));
 oh-voice(healthEvent);
 let response = oh-response(healthEvent,if passed then "continue" else "request-evidence");
 oh-voice(response);
 let selected = oh-select(healthEvent,response,"request-evidence");
 if not(and(passed,str_eq(selected,"continue"))) then form_error("composition witness differs from its expected observations") else 0;
 print_str(json-emit(report));
 print_str("\n");
 oh-voice(oh-applied(healthEvent,selected,json-node-string("published the observed composition report")));
 1;
}
