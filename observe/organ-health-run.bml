// Read the current organ observations and outstanding needs from an event flow.
// Empty or absent evidence remains an empty reading, never an all-healthy claim.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class OrganHealthRead {
  def ohr-run() {
   let path = read_line();
   print_str(json-emit-precise(json-node-object(list(oh-s("source",path),json-node-pair("current",json-node-array(oh-read(path)))))));
  }
 }
 ohr-run();
}
