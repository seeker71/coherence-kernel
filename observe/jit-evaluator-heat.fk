; jit-evaluator-heat.fk -- live evaluator heat as Form data, without a fixed
; function or operation table.
;
; The fourth arm already counts every evaluator tag in kernel_stat(100+tag).
; This cell reads the complete live counter surface (0..255), subtracts the
; observer traversal measured in an adjacent empty interval, and returns only
; positive excess movement.  The small open/close call-frame floor remains
; visible rather than being named workload.  Tags are observed coordinates,
; never execution authority.  The result retains every equally-hot coordinate
; as a choice; it does not invent a privileged first winner.
;
; A window is deliberately synchronous and tiny: open immediately before the
; work and close immediately after it.  Snapshotting is bounded by the
; carrier's 256 counter slots.  The kernel_stat coordinate itself (127) is
; absent from heat rows because observation manufactures that movement.
;
; Exact signal distinctions:
;   absent coordinate -> nothing
;   observed coordinate with no excess -> absent from the positive rows
;   positive excess -> integer count (including a legitimate count of 1)
;
; preludes: form/form-stdlib/core.fk
; Proven by: observe/tests/jit-evaluator-heat-band.fk

(do
    (defn jeh-counter-slots () 256)
    (defn jeh-observer-tag () 127)

    (defn jeh-snapshot-go (tag)
        (if (ge tag (jeh-counter-slots)) (empty)
            (cons (kernel_stat (add 100 tag))
                  (jeh-snapshot-go (add tag 1)))))
    (defn jeh-snapshot () (jeh-snapshot-go 0))

    ; window = schema, calibration-start, calibration-end
    (defn jeh-open ()
        (do
            (let before (jeh-snapshot))
            (let calibrated (jeh-snapshot))
            (list "jit-evaluator-heat-window-v1" before calibrated)))
    (defn jeh-window? (window)
        (if (nothing? window) 0
            (if (not (eq (len window) 3)) 0
                (if (not (str_eq (nth window 0)
                                  "jit-evaluator-heat-window-v1")) 0
                    (if (not (eq (len (nth window 1))
                                 (jeh-counter-slots))) 0
                        (if (eq (len (nth window 2))
                                (jeh-counter-slots)) 1 0))))))
    (defn jeh-window-before (window) (nth window 1))
    (defn jeh-window-calibrated (window) (nth window 2))

    ; row = tag, calibrated positive excess, empty-observer cost, work interval
    (defn jeh-row (tag excess observer work)
        (list tag excess observer work))
    (defn jeh-row-tag (row) (nth row 0))
    (defn jeh-row-excess (row) (nth row 1))
    (defn jeh-row-observer (row) (nth row 2))
    (defn jeh-row-work (row) (nth row 3))

    (defn jeh-positive-go (before calibrated after tag)
        (if (or (nil? before) (or (nil? calibrated) (nil? after)))
            (empty)
            (do
                (let observer (sub (head calibrated) (head before)))
                (let work (sub (head after) (head calibrated)))
                (let excess (sub work observer))
                (let rest (jeh-positive-go
                    (tail before) (tail calibrated) (tail after) (add tag 1)))
                (if (and (not (eq tag (jeh-observer-tag))) (gt excess 0))
                    (cons (jeh-row tag excess observer work) rest)
                    rest))))

    (defn jeh-hottest-score (rows)
        (if (nil? rows) 0
            (max2 (jeh-row-excess (head rows))
                  (jeh-hottest-score (tail rows)))))
    (defn jeh-hottest-at-go (rows score)
        (if (nil? rows) (empty)
            (do
                (let rest (jeh-hottest-at-go (tail rows) score))
                (if (eq (jeh-row-excess (head rows)) score)
                    (cons (head rows) rest)
                    rest))))
    (defn jeh-hottest (rows)
        (if (nil? rows) (empty)
            (jeh-hottest-at-go rows (jeh-hottest-score rows))))

    ; receipt = schema, all positive rows, all tied hottest rows, sample slots
    (defn jeh-close (window)
        (if (eq (jeh-window? window) 0) (nothing)
            (do
                (let after (jeh-snapshot))
                (let rows (jeh-positive-go
                    (jeh-window-before window)
                    (jeh-window-calibrated window)
                    after 0))
                (list "jit-evaluator-heat-receipt-v1" rows
                      (jeh-hottest rows) (jeh-counter-slots)))))
    (defn jeh-receipt? (receipt)
        (if (nothing? receipt) 0
            (if (not (eq (len receipt) 4)) 0
                (if (str_eq (nth receipt 0)
                            "jit-evaluator-heat-receipt-v1") 1 0))))
    (defn jeh-rows (receipt) (nth receipt 1))
    (defn jeh-choices (receipt) (nth receipt 2))
    (defn jeh-sampled-slots (receipt) (nth receipt 3))

    ; An unobserved tag is exact nothing, not a fabricated zero row.
    (defn jeh-at (rows tag)
        (if (nil? rows) (nothing)
            (if (eq (jeh-row-tag (head rows)) tag) (head rows)
                (jeh-at (tail rows) tag))))
    (defn jeh-all-score? (rows score)
        (if (nil? rows) 1
            (if (eq (jeh-row-excess (head rows)) score)
                (jeh-all-score? (tail rows) score) 0)))
)
