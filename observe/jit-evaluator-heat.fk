// jit-evaluator-heat.fk -- live evaluator heat as Form data, without a fixed
// function or operation table.
//
// fkwu already counts every evaluator tag in kernel_stat(100+tag).
// This cell reads the complete live counter surface (0..255), subtracts the
// observer traversal measured in an adjacent empty interval, and returns only
// positive excess movement.  The small open/close call-frame floor remains
// visible rather than being named workload.  Tags are observed coordinates,
// never execution authority.  The result retains every equally-hot coordinate
// as a choice; it does not invent a privileged first winner.
//
// A window is deliberately synchronous and tiny: open immediately before the
// work and close immediately after it.  Snapshotting is bounded by the
// carrier's 256 counter slots.  The kernel_stat coordinate itself (127) is
// absent from heat rows because observation manufactures that movement.
//
// Exact signal distinctions:
//   absent coordinate -> nothing
//   observed coordinate with no excess -> absent from the positive rows
//   positive excess -> integer count (including a legitimate count of 1)
//
import form/form-stdlib/core.fk;
// Proven by: observe/tests/jit-evaluator-heat-band.fk
section [form.bml] {
    def jeh-counter-slots() = 256;
    def jeh-observer-tag() = 127;
    def jeh-snapshot-go(tag) = tag >= jeh-counter-slots() ? empty() : cons(kernel_stat((Number) 100 + (Number) tag), jeh-snapshot-go((Number) tag + (Number) 1));
    def jeh-snapshot() = jeh-snapshot-go(0);
    // window = schema, calibration-start, calibration-end
    def jeh-open() = {
        let before = jeh-snapshot();
        let calibrated = jeh-snapshot();
        ["jit-evaluator-heat-window-v1", before, calibrated];
    };
    def jeh-window?(window) = nothing?(window) ? 0 : !((Comparable) len(window) == 3) ? 0 : !((String) window[0] == "jit-evaluator-heat-window-v1") ? 0 : !((Comparable) len(window[1]) == jeh-counter-slots()) ? 0 : (Comparable) len(window[2]) == jeh-counter-slots() ? 1 : 0;
    def jeh-window-before(window) = window[1];
    def jeh-window-calibrated(window) = window[2];
    // row = tag, calibrated positive excess, empty-observer cost, work interval
    def jeh-row(tag, excess, observer, work) = [tag, excess, observer, work];
    def jeh-row-tag(row) = row[0];
    def jeh-row-excess(row) = row[1];
    def jeh-row-observer(row) = row[2];
    def jeh-row-work(row) = row[3];
    def jeh-positive-go(before, calibrated, after, tag) = nil?(before) || (nil?(calibrated) || nil?(after)) ? empty() : {
        let observer = calibrated[0] - before[0];
        let work = after[0] - calibrated[0];
        let excess = work - observer;
        let rest = jeh-positive-go(before[1:], calibrated[1:], after[1:], (Number) tag + (Number) 1);
        !((Comparable) tag == jeh-observer-tag()) && excess > 0 ? cons(jeh-row(tag, excess, observer, work), rest) : rest;
    };
    def jeh-hottest-score(rows) = nil?(rows) ? 0 : max2(jeh-row-excess(rows[0]), jeh-hottest-score(rows[1:]));
    def jeh-hottest-at-go(rows, score) = nil?(rows) ? empty() : {
        let rest = jeh-hottest-at-go(rows[1:], score);
        (Comparable) jeh-row-excess(rows[0]) == score ? cons(rows[0], rest) : rest;
    };
    def jeh-hottest(rows) = nil?(rows) ? empty() : jeh-hottest-at-go(rows, jeh-hottest-score(rows));
    // receipt = schema, all positive rows, all tied hottest rows, sample slots
    def jeh-close(window) = (Comparable) jeh-window?(window) == 0 ? nothing() : {
        let after = jeh-snapshot();
        let rows = jeh-positive-go(jeh-window-before(window), jeh-window-calibrated(window), after, 0);
        ["jit-evaluator-heat-receipt-v1", rows, jeh-hottest(rows), jeh-counter-slots()];
    };
    def jeh-receipt?(receipt) = nothing?(receipt) ? 0 : !((Comparable) len(receipt) == 4) ? 0 : (String) receipt[0] == "jit-evaluator-heat-receipt-v1" ? 1 : 0;
    def jeh-rows(receipt) = receipt[1];
    def jeh-choices(receipt) = receipt[2];
    def jeh-sampled-slots(receipt) = receipt[3];
    // An unobserved tag is exact nothing, not a fabricated zero row.
    def jeh-at(rows, tag) = nil?(rows) ? nothing() : (Comparable) jeh-row-tag(rows[0]) == tag ? rows[0] : jeh-at(rows[1:], tag);
    def jeh-all-score?(rows, score) = nil?(rows) ? 1 : (Comparable) jeh-row-excess(rows[0]) == score ? jeh-all-score?(rows[1:], score) : 0;
}
