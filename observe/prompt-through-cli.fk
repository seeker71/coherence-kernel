; observe/prompt-through-cli.fk — every session prompt flows through the
; body, at least as training substance. The standing wire (the harness's
; UserPromptSubmit hook) pipes each prompt here; this door appends ONE
; length-safe fcpa frame (kind prompt-capture-v1) to the training spool,
; so the form-cli teach lane can learn to perform tomorrow what the
; rented mind performed today. Capture is unconditional and durable —
; no standing hearth required; the live-ask lane stays hearth-ask-send.
;
; stdin: the prompt text, all lines to EOF.
; spool: .hearth/prompt-training.spool (append-only, atomic per frame).
; Read it back with observe/prompt-training-lens.fk.
;
; preludes: form-stdlib/core.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/spool-bell-transport.fk form-stdlib/peer-task-frame.fk

(do
    (defn ptc-drain (acc)
        (do
            (let line (read_line))
            (if (nothing? line) acc
                (ptc-drain (str_concat acc (str_concat line "\n"))))))
    (defn ptc-spool () ".hearth/prompt-training.spool")
    (let body (ptc-drain ""))
    (if (eq (str_len body) 0)
        (do (print_str "prompt-through-cli: empty prompt, nothing captured\n") 0)
        (do
            (let turn (add (lms-max-turn (read_file (ptc-spool))) 1))
            (let frame (str_concat
                (fcpa-task-frame turn "prompt-capture-v1" body) "\n"))
            (let put (sbt-append (ptc-spool) frame))
            (print_str (str_concat "captured turn="
                (str_concat (int_to_str turn)
                (str_concat " bytes=" (str_concat (int_to_str (str_len body)) "\n")))))
            0)))
