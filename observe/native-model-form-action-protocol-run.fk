; native-model-form-action-protocol-run.fk — show ready and healing paths.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/native-model-control-plane.fk form/form-stdlib/native-model-control-plane-eval.fk form/form-stdlib/form-teach-layer.fk form/form-stdlib/native-model-form-token-envelope.bml form/form-stdlib/form-agent-protocol.fk form/form-stdlib/native-model-form-action-protocol.bml

(do
    (let ready (nmfap-proposal (NMFTEQwen) "crystalize" "{}" "31.2.0.8" "native-model-form" (NMFAPWire) 1))
    (let blocked (nmfap-proposal "st.llama32-3b-mlx-4bit" "eval" "{}" "31.2.0.9" "native-model-form" (NMFAPWire) 1))
    (print (nmfap-plan ready))
    (print (nmfap-plan blocked))
    (list "native-model-form-action-protocol" "native-words" (len (nmfte-native-vocabulary))
        "qwen-admitted" (nmfap-count-admitted-words (NMFTEQwen) (nmfte-native-vocabulary))
        "threeb-admitted" (nmfap-count-admitted-words (NMFTEThreeB) (nmfte-native-vocabulary))))
