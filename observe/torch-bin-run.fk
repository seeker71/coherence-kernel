// torch-bin-run.fk — the tensor table of a PyTorch checkpoint, read by the body.
//
//   ./fkwu observe/torch-bin-run.fk </dev/null
//   printf '<checkpoint path>\n<config.json path>\n' | ./fkwu observe/torch-bin-run.fk
//
// Stdin is optional: line one is the checkpoint (default: the charsiu g2p ByT5 on this host), line two a T5
// config.json to check the names and shapes against (default: the one beside the checkpoint).
// One row per tensor — name, dtype, shape, storage key, byte offset in the file, byte length — then the
// zip's own account (members, deflated members), the tensor count, the parameter total and the T5 name
// table verdict. It touches no GPU: a tensor's bytes are never read here, only located.
// preflight-exec: forbidden
import form/form-stdlib/torch-bin.bml;
section [form.bml] {
    def tbr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def tbr-or(v, dflt) = len(v) == 0 ? dflt : v;
    def tbr-last-slash(p, from, last) {
        let at = str_find(p, "/", from);
        at < 0 ? last : tbr-last-slash(p, at + 1, at);
    }
    def tbr-dir(p) = substring(p, 0, tbr-last-slash(p, 0, 0 - 1) + 1);
    def tbr-print(rows) = nil?(rows) ? 0 : tbr-print-one(rows);
    def tbr-print-one(rows) {
        print_str(tb-row-text(rows[0]));
        tbr-print(rows[1:]);
    }
    def tbr-print-problems(ps) = nil?(ps) ? 0 : tbr-print-problem(ps);
    def tbr-print-problem(ps) {
        print_str("  problem: " + ps[0]);
        tbr-print-problems(ps[1:]);
    }
    let path = tbr-or(tbr-line(), "/Users/ursmuff/models/g2p-byt5-small-100/pytorch_model.bin");
    let cfgpath = tbr-or(tbr-line(), tbr-dir(path) + "config.json");
    let ms = tb-members(path);
    let rows = tb-tensors(path);
    print_str("# torch-bin " + path + "  (" + file_size(path).str() + " bytes)");
    print_str("# name  dtype  shape  key  @offset-in-file  +bytes");
    tbr-print(rows);
    print_str("members=" + len(ms).str() + " deflated=" + tb-deflated(ms).str());
    print_str("tensors=" + len(rows).str() + " params=" + tb-params(rows).str() + " unique-params=" + tb-params-unique(rows).str() + " bytes=" + tb-total-bytes(rows).str());
    let problems = tb-t5-problems(rows, tb-t5-config(cfgpath));
    print_str("t5-name-table problems=" + len(problems).str());
    tbr-print-problems(problems);
    nil?(problems) ? 0 : form_error("the checkpoint does not match its T5 config");
}
