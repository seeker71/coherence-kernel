; form-glass-room-live.fk — the ROOM as a sensor of the living glass.
;
; The ear gives what was said. Prosody gives how one voice said it. This process
; gives the space around both: how many timbres are turning, how long the silence
; between them ran, whether a breath opened a line, whether the room's own floor
; moved while nobody spoke, how near the voice stood, and whether a person is at
; this machine at all.
;
; It sleeps until it is wanted: while .hearth/room.wanted is absent the mic stays
; shut, one row says so, and the process costs a level read every half second.
; When the marker appears it opens the mic and gives the room every hundred
; milliseconds; when the marker goes it closes the mic and forgets what it heard.
;
; Nothing of the sound is retained: the organ holds two seconds of integers and a
; minute of turn boundaries. No sample, no word, no name. The camera is not opened
; -- room.camera is a row that says so and why.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/room-sense.bml form/form-stdlib/form-glass-sensor-rows.bml

(do
    (defn rl-wanted () ".hearth/room.wanted")
    (defn rl-awake? () (ge (file_size (rl-wanted)) 0))
    (defn rl-open (mic) (if (eq mic 1) 1 (do (let m (sense_mic_stream_start)) 1)))
    (defn rl-close (mic) (if (eq mic 0) 0 (do (let s (sense_mic_stream_stop)) 0)))
    ; the room's rows, given under this process's own publisher at its own declared cadence:
    ; 200 ms awake (a frame is 100 ms and the read may wait), 500 ms asleep, so a taker
    ; that sees no give past three cadences is right to call the frame silent
    (defn rl-give (rows now cadence) (fgsr-give-at "room" now (fgo-observe-rows rows now 0) cadence))
    (defn rl-sleep-step (st)
        (do (let now (now_unix_ms))
            (let given (rl-give (rs-asleep-rows) now 500))
            (let rested (host_sleep_ms 500))
            (rs-empty)))
    (defn rl-wake-step (st)
        (do (let fresh (sense_mic_stream_read 3200 200))
            (let now (now_unix_ms))
            (if (lt (str_len fresh) 3200)
                (do (let rested (host_sleep_ms 20)) st)
                (do (let st1 (rs-machine-step (rs-step st fresh now) now))
                    (let given (rl-give (rs-rows st1 now) now 200))
                    st1))))
    (defn rl-step (st mic)
        (do (let awake (rl-awake?))
            (let mic1 (if (eq awake 1) (rl-open mic) (rl-close mic)))
            (let st1 (if (eq awake 1) (rl-wake-step st) (rl-sleep-step st)))
            (rl-step st1 mic1)))
    (rl-step (rs-empty) 0))
