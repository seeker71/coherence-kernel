// where-we-are-run.bml — the organs that already measured this place say where we are.
//
// Ground is the sum bootstrap/ground.fk runs. Freshness is the band.
// The share is the attended evidence. A model is not asked to remember it.
// preludes: form-stdlib/form-cli-turn-evidence-grok.bml form-stdlib/tests/binary-freshness-band.fk
section [form.bml] {
 class WhereWeAre {
  def wwa-ground() = add(40, 2);
  def wwa-cat(xs) = if nil?(xs) then "" else str_concat(head(xs), wwa-cat(tail(xs)));
  def wwa-open?(e) = fcte-total-tokens(e) == 0 && fcte-remote-events(e) > 0;
  def wwa-attendance(e) = if wwa-open?(e) then " Provider usage is an open attendance because the token total is empty." else "";
  def wwa-share(e) {
   let share = fcte-boundary-share(e);
   wwa-cat(list("The share is published: native share ", int_to_str(nth(share, 0)), ", local share ", int_to_str(nth(share, 1)), ", remote share ", int_to_str(nth(share, 2)), ", from ", int_to_str(fcte-native-commands(e)), " fkwu commands.", wwa-attendance(e)));
  }
  def wwa-place() = wwa-cat(list("We are here. Ground is ", int_to_str(wwa-ground()), ". Freshness is ", int_to_str(binary-freshness-band()), ". "));
  def wwa-say() {
   let attended = fctg-attend-unbound();
   let path = fctel-observed-row-path();
   let evidence = if file_size(path) <= 0 then fcte-parse("unmeasured") else fcte-parse(fctel-trim-end(read_file(path)));
   let share = if fcte-valid?(evidence) == 1 then wwa-share(evidence) else "The share has not arrived as a reading.";
   print_str(wwa-cat(list(wwa-place(), share, " The native share grows when more of the work runs on fkwu.\n")));
  }
 }
 wwa-say();
}
