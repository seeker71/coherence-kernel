// where-we-are-run.bml — the organs that already measured this place say where we are.
//
// Ground is the sum bootstrap/ground.fk runs. Freshness is the band.
// The share is the attended evidence. A model is not asked to remember it.
// preludes: form-stdlib/form-cli-turn-evidence-grok.bml form-stdlib/tests/binary-freshness-band.fk
section [form.bml] {
 class WhereWeAre {
  def wwa-ground() = 40 + 2;
  def wwa-cat(xs) = nil?(xs) ? "" : xs[0] ++ wwa-cat(xs[1:]);
  def wwa-open?(e) = fcte-total-tokens(e) == 0 && fcte-remote-events(e) > 0;
  def wwa-attendance(e) = wwa-open?(e) ? " Provider usage is an open attendance because the token total is empty." : "";
  def wwa-share(e) {
   let share = fcte-boundary-share(e);
   wwa-cat(["The share is published: native share ", share[0].str(), ", local share ", share[1].str(), ", remote share ", share[2].str(), ", from ", fcte-native-commands(e).str(), " fkwu commands.", wwa-attendance(e)]);
  }
  def wwa-place(ground, fresh) = wwa-cat(["We are here. Ground is ", ground.str(), ". Freshness is ", fresh.str(), ". "]);
  def wwa-note(ground, fresh, native, local, remote) {
   let place = fb_record(intern_trivial_int(ground), "where-we-are", fresh);
   let share = fb_record(intern_trivial_int(native), "where-we-are:share", local);
   let far = fb_record(intern_trivial_int(remote), "where-we-are:remote", 0);
   place;
  }
  def wwa-say() {
   let attended = fctg-attend-unbound();
   let path = fctel-observed-row-path();
   let evidence = file_size(path) <= 0 ? fcte-parse("unmeasured") : fcte-parse(fctel-trim-end(read_file(path)));
   let ground = wwa-ground();
   let fresh = binary-freshness-band();
   let valid = fcte-valid?(evidence) == 1;
   let nums = valid ? fcte-boundary-share(evidence) : [0, 0, 0];
   let noted = wwa-note(ground, fresh, nums[0], nums[1], nums[2]);
   let share = valid ? wwa-share(evidence) : "The share has not arrived as a reading.";
   print_str(wwa-cat([wwa-place(ground, fresh), share, " The native share grows when more of the work runs on fkwu.\n"]));
  }
 }
 wwa-say();
}
