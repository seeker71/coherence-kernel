// Fixed terminal-failure witness: no provider call or fabricated response.
// preflight-exec: forbidden
// preludes: form/form-stdlib/bml/concept-translation-worker.bml
section [form.bml] {
 class TranslationRefusalWorker {
  def ctrw-refuse(pipe,output,errors,bytes) {
   let owner = ctt-owner("terminal-refusal-witness",1,0,0);
   record_set(owner,"pipe-owner",pipe); record_set(owner,"health-pipe",errors);
   ctt-observe(owner,"requested-terminal-refusal",0,"request-evidence",0,0,0);
   ctt-refused(owner,"requested terminal refusal witness");
  }
 }
 nppc-run-with(ctrw-refuse);
}
