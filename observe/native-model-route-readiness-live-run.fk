; native-model-route-readiness-live-run.fk — read-only live route assessment.
;
; This does not open, prefill, step, close, or signal a model.  It binds the
; newest owner state snapshot to the singleton physical owner process and
; reports retained-route readiness as derived from current PID/start liveness.
;
; preludes: form/form-stdlib/native-model-route-readiness.bml form/form-stdlib/native-model-owner-cadence.bml

(do
    (defn nmrrl-qwen-id () "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
    (defn nmrrl-threeb-id () "model.llama-3.2-3b-instruct")
    (let now (now_unix_ms))
    (let observerPid (nmdoc-self-pid))
    (let correlation (nmdoc-discover observerPid now 1))
    (let correlated (nmdoc-correlation? correlation))
    ; Read the exact publisher whose PID/start binding was checked above.
    ; A second inventory selection could race an owner handoff and lend the
    ; prior owner's liveness evidence to the next owner's snapshot.
    (let publisher (if (eq correlated 1)
        (nmdoc-target-publisher correlation) ""))
    (let reading (if (eq (str_len publisher) 0) (list) (fgtm-read-current (NMDOCGlassRoot) publisher)))
    (let snapshot (if (eq (len reading) 0) (list) (nmdoc-reading-snapshot reading)))
    (let alive (if (eq correlated 1) (nmdoc-target-alive? correlation) 0))
    (let binding (if (eq correlated 1) (nmdoc-target-binding correlation) "unavailable"))
    (let targetPid (if (eq correlated 1) (nmdoc-target-pid correlation) 0))
    (let targetStarted (if (eq correlated 1) (nmdoc-target-publisher-started correlation) -1))
    (let sourceMtimeMs (mul (fs-stat-mtime "observe/native-model-dual-resident-live-run.fk") 1000))
    (let targetPidField (if (eq correlated 1) (fgtm-present targetPid) (fgtm-absent)))
    (let aliveField (if (eq correlated 1) (fgtm-present alive) (fgtm-absent)))
    (let bindingField (if (eq correlated 1) (fgtm-present binding) (fgtm-absent)))
    (let targetStartedField (if (gt targetStarted 0) (fgtm-present targetStarted) (fgtm-absent)))
    (let sourceMtimeField (if (gt sourceMtimeMs 0) (fgtm-present sourceMtimeMs) (fgtm-absent)))
    (let sourceNewerField (if (and (gt sourceMtimeMs 0) (gt targetStarted 0)) (fgtm-present (gt sourceMtimeMs targetStarted)) (fgtm-absent)))
    (let snapshotAgeField (if (eq (fgtm-snapshot-valid? snapshot) 1)
        (fgtm-present (nmrr-snapshot-age snapshot now)) (fgtm-absent)))
    (list "native-model-route-readiness-live-v2"
        "target-pid" targetPidField
        "process-alive" aliveField
        "owner-binding" bindingField
        "owner-started" targetStartedField
        "source-mtime-ms" sourceMtimeField
        "source-newer-than-owner" sourceNewerField
        "snapshot-age-ms" snapshotAgeField
        "assessment" (nmrr-assess snapshot alive binding now (nmrrl-qwen-id) (nmrrl-threeb-id))))
