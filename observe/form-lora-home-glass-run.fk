; form-lora-home-glass-run.fk — observe the local reversible adapter and say
; its fixed Glass symbols without rented inference or corpus host lookup.
; preludes: form/form-stdlib/form-fs.fk form/form-stdlib/form-cli-qwen-teach-layer.fk form/form-stdlib/form-cli-lora-writer.bml form/form-stdlib/qwen-lora-head.fk form/form-stdlib/symbol-voice.bml
(do
    (let path (flw-path))
    (let written (flw-written path))
    (let ready (flw-ready path))
    (let applied (fqt-adapter-applied?))
    ; This names only the durable Qwen-width artifact.  Its presence is not a
    ; trained-voice claim; the trainer and held-out evaluator own that truth.
    (let qwen-head-artifact (qlh-whole? (qlh-path)))
    (let said (sv-say "us DO admit* | glass G* T:64"))
    (framebuffer-clear)
    (fb_record (intern_trivial_string "lora-adapter-local") "form/form-stdlib/form-cli-lora-writer-run.fk" 1)
    (fb_record (intern_trivial_string "symbol-expansion-local") "form/form-stdlib/symbol-voice.bml" 1)
    (print (list "lora-home-glass" "adapter" written "ready" ready "applied" applied
                 "qwen-weight-adapter" 0 "qwen-head-artifact" qwen-head-artifact
                 "voice-home" 0 "symbols" said "events" (len (framebuffer-events))))
    (if (and (eq written 1) (and (eq ready 1) (eq applied 1))) 1 0))
