; mirror-census-take.fk — read the mirror sensor's frame the way the glass reads it.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/mirror-glass.bml
;
; The census gives its rows into a gift frame under its own publisher and states
; its cadence INSIDE the frame, so no roster edit is owed for a new sensor. This
; door is the proof of the other half: the rows a taker gets back are the same
; cells the census built, seq-first, no wire and no parser between.
;
; A frame nobody is giving is named absent, not empty — the same honesty the
; census keeps about a mirror it could not read. Run the census door first; it
; holds its frame open for twenty seconds:
;
;     ./fkwu observe/mirror-census-run.fk &
;     ./fkwu observe/mirror-census-take.fk

(do
    (defn mct-value (r)
        (if (str_eq (fgo-value-kind r) "text") (fgo-text-value r) (int_to_str (fgo-int-value r))))
    (defn mct-row (r)
        (print (mcs-cat (list "  " (fgo-id r) "  " (mct-value r) " " (fgo-unit r) "   " (fgo-label r)))))
    (defn mct-rows (rs)
        (if (nil? rs) 0 (do (let said (mct-row (head rs))) (mct-rows (tail rs)))))

    (let standing (fgsr-standing? (MCSSensor)))
    (let held (fgsr-take (MCSSensor) (fgsr-held -1 -1 (list))))
    (let rows (fgsr-held-rows held))
    (let a (print ""))
    (if (eq standing 0)
        (print (str_concat "  no mirror frame standing under " (fgsr-publisher (MCSSensor))))
        (do (let b (print (mcs-cat (list "  mirror frame " (fgsr-publisher (MCSSensor))
                                         "  seq " (int_to_str (fgsr-held-seq held))
                                         "  cadence " (int_to_str (fgsr-held-cadence held)) " ms"
                                         "  " (int_to_str (len rows)) " rows"))))
            (let c (print ""))
            (mct-rows rows)))
    (len rows))
