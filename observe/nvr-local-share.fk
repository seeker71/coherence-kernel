; nvr-local-share.fk — for each seated prompt: how much is native, and
; how we stop paying the network.
;
; The jungle floor: Starlink is a subscription, not a law. What already
; sits in this checkout + ./fkwu needs no external resource. A miss
; used to escalate (form-first-router). Offline, a miss is nothing —
; axiom-1 silence — not a remote call. That is how remote share falls
; without faking a native summary.
;
; Surfaces (same names as the membrane, held as ints):
;   0 native-recipe   — stayed in Form, no OS, no net
;   2 local-oracle    — disk/GPU on this machine (offline, sovereign)
;   3 remote-oracle   — needs the network
;   4 nothing         — timeout / decline / not yet; not a crossing
;
; Two asks per prompt:
;   what  — "what does this source say?"  structural + grounded → relay
;   emit  — "write a new NL summary"      frontier, no native emitter
;
; what is already 100 native. emit used to be remote. emit is now nothing.
; Complete pairs stay 0. A ≥ rented claim still cannot earn.
;
; preludes: form-stdlib/core.fk form-stdlib/form-first-router.fk observe/native-vs-rented.fk observe/nvr-metric.fk observe/nvr-corpus.fk
;
; Proven by: observe/tests/nvr-local-share-band.fk
; witnessed: 2026-08-14 -> band 1023

(do
    (defn nvrl-native () 0)
    (defn nvrl-local  () 2)
    (defn nvrl-remote () 3)
    (defn nvrl-nothing () 4)

    (defn nvrl-what () 0)
    (defn nvrl-emit () 1)

    ; form-first query for this prompt + ask kind
    (defn nvrl-q (kind)
        (if (eq kind (nvrl-what)) (list "structural" 1)
            (list "frontier" 0)))

    ; Jungle route: a hit relays; a miss is silence, never Starlink.
    (defn nvrl-route (kind)
        (if (eq (ffr-hit? (nvrl-q kind)) 1) (nvrl-native)
            (nvrl-nothing)))

    (defn nvrl-needs-net? (kind)
        (if (eq (nvrl-route kind) (nvrl-remote)) 1 0))

    ; Shares of the answer that actually happened. nothing is not a share.
    (defn nvrl-native-share (kind)
        (if (eq (nvrl-route kind) (nvrl-native)) 100 0))

    ; What the default router would have done with emit: escalate.
    (defn nvrl-old-emit () (ffr-path (nvrl-q (nvrl-emit))))
    (defn nvrl-saved-remote? ()
        (if (and (str_eq (nvrl-old-emit) "escalate")
                 (eq (nvrl-route (nvrl-emit)) (nvrl-nothing))) 1 0))

    (defn nvrl-row (id)
        (do (let p (nth (nvrc-seed) id))
            (list id (nvrc-src p)
                  (nvrl-native-share (nvrl-what))
                  (nvrl-needs-net? (nvrl-what))
                  (nvrl-route (nvrl-emit)))))

    (defn nvrl-net-loop (i n acc)
        (if (eq i n) acc
            (nvrl-net-loop (add i 1) n
                (add acc (nvrl-needs-net? (nvrl-what))))))

    (defn nvrl-what-net ()
        (nvrl-net-loop 0 (len (nvrc-seed)) 0))

    (defn nvrl-jungle-ready? ()
        (if (and (eq (nvrl-what-net) 0)
                 (eq (nvrl-needs-net? (nvrl-emit)) 0)) 1 0))

    (defn nvrlk (cond bit) (if cond bit 0))
    (defn nvrl-check ()
        (do
            (let r0 (nvrl-row 0))
            (add (add (add (add (add (add (add (add (add
                (nvrlk (eq (len (nvrc-seed)) 8) 1)
                (nvrlk (eq (nvrl-native-share (nvrl-what)) 100) 2))
                (nvrlk (eq (nvrl-what-net) 0) 4))
                (nvrlk (eq (nvrl-native-share (nvrl-emit)) 0) 8))
                (nvrlk (eq (nvrl-route (nvrl-emit)) (nvrl-nothing)) 16))
                (nvrlk (str_eq (nvrl-old-emit) "escalate") 32))
                (nvrlk (eq (nvrl-saved-remote?) 1) 64))
                (nvrlk (eq (nvrl-jungle-ready?) 1) 128))
                (nvrlk (eq (nth r0 3) 0) 256))
                (nvrlk (eq (nvrc-complete-n (nvrc-seed)) 0) 512))))

    0)
