; mlx-bandwidth-probe.fk — the MLX organ's own stream ceiling, measured the same
; way the Metal probe measures its own: bytes moved over wall time, on this device.
;
; `iota` writes N int32 and `sum` reads them back, so one pass is 8N bytes of
; traffic. The wall clock includes MLX graph construction and eval; there is no
; device-side busy counter in the MLX door, and that difference is stated rather
; than hidden — this reading is a floor for MLX, not its silicon ceiling.
;
; preludes: form-stdlib/core.fk

(do
    (defn mbp-one (n)
        (do
            (let prog (str_concat (int_to_str n) " iota sum i32"))
            (let t0 (now_unix_ms))
            (let v (mlx_run prog))
            (let t1 (now_unix_ms))
            (let ms (sub t1 t0))
            (let bytes (mul 8 n))
            (let gbps-x10 (if (gt ms 0) (div (mul bytes 10) (mul ms 1000000)) 0))
            (do (print (str_concat "lanes=" (int_to_str n)))
                (print (str_concat "  traffic_bytes=" (int_to_str bytes)))
                (print (str_concat "  wall_ms=" (int_to_str ms)))
                (print (str_concat "  gbps_x10=" (int_to_str gbps-x10)))
                (print "\n")
                0)))
    (let a (mbp-one 16777216))
    (let b (mbp-one 67108864))
    (let c (mbp-one 268435456))
    (let d (mbp-one 268435456))
    (print (mlx_status))
    0)
