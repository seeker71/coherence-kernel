// Disposable files exercise the real native reader, lowerer, and report writer.
// preludes: form-stdlib/bml/fourth-arm-gap-analysis.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class FourthArmGapWitness {
  def fgaw-at(root, name) = fga-under(root, name);
  def fgaw-number(doc, key) = json-int-value(json-object-get(doc, key));
  def fgaw-string(doc, key) = json-string-value(json-object-get(doc, key));
  def fgaw-read(path) = parse-json("gap-witness", read_file(path));
  def fgaw-save(root, name, report, detail) {
   let a = write_file(fgaw-at(root, str_concat(name, ".json")), read_file(report));
   write_file(fgaw-at(root, str_concat(name, ".tsv")), read_file(detail));
  }
  def fgaw-k(name, ok, bit) {
   print(list(name, ok));
   if ok then bit else 0;
  }
  def fgaw-run() {
   let root = str_concat(HearthDir(), str_concat("/fourth-gap-witness-", int_to_str(host_pid())));
   let made = host_dir_mkdir(root);
   if not(eq(made, 1)) then "fresh witness directory unavailable" else fgaw-cases(root);
  }
  def fgaw-cases(root) {
   let d1 = fs_mkdir(fgaw-at(root, "form"));
   let d2 = fs_mkdir(fgaw-at(root, "form/form-stdlib"));
   let d3 = fs_mkdir(fgaw-at(root, "form/form-stdlib/tests"));
   let flat = fgaw-at(root, "form/form-stdlib/form-flatten.fk");
   let shim = fgaw-at(root, "form/form-stdlib/fourth-shim.fk");
   let c1 = write_file(flat, read_file("form/form-stdlib/form-flatten.fk"));
   let c2 = write_file(shim, read_file("form/form-stdlib/fourth-shim.fk"));
   let module = "section [form.bml] {\n class Shared {\n  def shared(x) = add(x, 1);\n }\n}\n";
   let m = write_file(fgaw-at(root, "form/form-stdlib/shared.bml"), module);
   let effect = fgaw-at(root, "band-was-executed");
   let alpha = str_concat(str_concat("; pre", "ludes: form-stdlib/shared.bml\n(do (shared 1) (owed-one 2) (owed-two 3) (write_file "), str_concat(json-emit(json-node-string(effect)), " \"unexpected\"))\n"));
   let a = write_file(fgaw-at(root, "form/form-stdlib/tests/alpha-band.fk"), alpha);
   let b = write_file(fgaw-at(root, "form/form-stdlib/tests/beta-band.fk"), "(owed-one 4)\n");
   let c = write_file(fgaw-at(root, "form/form-stdlib/tests/clean-band.fk"), "(add 1 1)\n");
   let broken = write_file(fgaw-at(root, "form/form-stdlib/tests/broken-band.fk"), "(owed-three\n");
   let input = fgaw-at(root, "survey.tsv");
   let report = fgaw-at(root, "report.json");
   let detail = fgaw-at(root, "missing.tsv");
   let survey = "alpha\tsingle-mismatch\t1\t0\nbeta\tbml-flatten-empty\t1\t-\nclean\tsingle-mismatch\t1\t0\nignored\tsingle-pass\t1\t1\n";
   let s = write_file(input, survey);
   // An absent survey selects a separate fixture rehearsal. Its partial result
   // cannot silently become the live survey's answer.
   let absent = fga-run-at(root, fgaw-at(root, "absent.tsv"), report, detail);
   let absentDoc = fgaw-read(report);
   let savedAbsent = fgaw-save(root, "unavailable", report, detail);
   let out = bfc-envelope(0, host_pid(), 0, list(absent, 0), "retain-unavailable");
   let outgoing = bfc-record-out(out, 1);
   let control = bfc-control(out, 5);
   let incoming = bfc-record-in(control, 2);
   let selected = bfc-apply(out, control, "retain-unavailable", input);
   let full = fga-run-at(root, selected, report, detail);
   let fullDoc = fgaw-read(report);
   let ranking = json-array-elements(json-object-get(fullDoc, "ranking"));
   let fullTsv = read_file(detail);
   let savedFull = fgaw-save(root, "full", report, detail);
   let after = bfc-record-out(bfc-envelope(0, host_pid(), 0, list(full, fgaw-number(fullDoc, "analyzed")), "retain-evidence"), 3);
   let choice = write_file(fgaw-at(root, "choice.json"), json-emit(json-node-object(list(fga-jn("exchange", host_pid()), fga-js("observation", "survey-unavailable"), fga-js("offered", "retain-unavailable or rehearse separate fixture"), fga-jn("selected_action", bfc-payload(control)), fga-js("applied_input", selected), fga-jn("before_value", absent), fga-jn("after_fixture_value", full), fga-js("boundary", "fixture result does not replace unavailable live survey")))));
   let k1 = fgaw-k("unavailable stays explicit", and(eq(absent, 0), str_eq(fgaw-string(absentDoc, "state"), "survey-unavailable")), 1);
   let k2 = fgaw-k("native BML and current vocabulary", and(eq(full, 1), and(eq(fgaw-number(fullDoc, "analyzed"), 3), and(eq(len(ranking), 2), and(str_eq(fgaw-string(head(ranking), "op"), "owed-one"), eq(fgaw-number(head(ranking), "blocked_bands"), 2))))), 2);
   let k3 = fgaw-k("complete per-band detail", str_eq(fullTsv, "alpha\towed-one owed-two\nbeta\towed-one\nclean\t\n"), 4);
   let changed = write_file(fgaw-at(root, "form/form-stdlib/tests/beta-band.fk"), "(owed-two 4)\n");
   let fresh = fga-run-at(root, input, report, detail);
   let freshRanking = json-array-elements(json-object-get(fgaw-read(report), "ranking"));
   let savedChanged = fgaw-save(root, "changed", report, detail);
   let k4 = fgaw-k("source change changes ranking", and(eq(fresh, 1), and(str_eq(fgaw-string(head(freshRanking), "op"), "owed-two"), eq(fgaw-number(head(freshRanking), "blocked_bands"), 2))), 8);
   let p = write_file(input, str_concat(survey, "broken\tsingle-mismatch\nabsent\tsingle-mismatch\n../escape\tsingle-mismatch\nalpha\tsingle-mismatch\n"));
   let partial = fga-run-at(root, input, report, detail);
   let partialDoc = fgaw-read(report);
   let savedPartial = fgaw-save(root, "partial", report, detail);
   let k5 = fgaw-k("unread malformed duplicate visible", and(eq(partial, 0), and(eq(fgaw-number(partialDoc, "analyzed"), 3), eq(fgaw-number(partialDoc, "unread_or_invalid"), 4))), 16);
   let badVocabulary = write_file(flat, "(broken\n");
   let noVocabulary = fga-run-at(root, input, report, detail);
   let savedVocabulary = fgaw-save(root, "vocabulary-unavailable", report, detail);
   let k6 = fgaw-k("broken vocabulary cannot look clean", and(eq(noVocabulary, 0), str_eq(fgaw-string(fgaw-read(report), "state"), "vocabulary-unavailable")), 32);
   let noOutput = fga-run-at(root, input, fgaw-at(root, "missing-directory/out.json"), detail);
   let k7 = fgaw-k("write failure visible and bands unexecuted", and(eq(noOutput, -1), and(lt(file_size(effect), 0), str_eq(read_file(fgaw-at(root, "form/form-stdlib/shared.bml")), module))), 64);
   print(str_concat("evidence=", root));
   add(k1, add(k2, add(k3, add(k4, add(k5, add(k6, k7))))));
  }
 }
 fgaw-run();
}
