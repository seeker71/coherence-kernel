; voice-graph-read.fk — the voice's own PROGRAM, read by the body: every node whose name
; carries a given prefix, with what it eats, what it names, and how it is set.
;
; The census in `voice-onnx-run.fk` counts operators; this prints the graph itself, which is
; what a pass needs. Point it with two lines in /tmp/voice-graph-target: the voice, then the
; node-name prefix ("/flow/flows.0/" or "/dec/" or "" for all).
; preludes: form/form-stdlib/voice-native.bml
(do
    (defn vg-default-voice () "en_GB-jenny_dioco-medium")
    (defn vg-lines () (do (let t (read_file "/tmp/voice-graph-target")) (if (nothing? t) (list) (split-on t (byte_to_str 10)))))
    (defn vg-at (xs i d) (if (le (len xs) i) d (if (eq (str_len (trim (nth xs i))) 0) d (trim (nth xs i)))))
    (defn vg-starts? (s p) (if (eq (str_len p) 0) 1 (if (lt (str_len s) (str_len p)) 0 (str_eq (substring s 0 (str_len p)) p))))
    (defn vg-go (path fs pre n)
        (if (eq (len fs) 0) n
            (if (vg-starts? (vo-n-name path (head fs)) pre)
                (do (print (vo-node-text path (head fs)))
                    (let a (vo-n-attrs path (head fs)))
                    (if (eq (len a) 0) 0 (print (vo-attrs-text a)))
                    (vg-go path (tail fs) pre (add n 1)))
                (vg-go path (tail fs) pre n))))
    (let ls (vg-lines))
    (let voice (vg-at ls 0 (vg-default-voice)))
    (let pre (vg-at ls 1 ""))
    (let p (vp-model-path voice))
    (let n (vg-go p (vo-nodes p) pre 0))
    (print (str_concat "  nodes shown  " (int_to_str n)))
    0)
