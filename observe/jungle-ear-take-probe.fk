; jungle-ear-take-probe.fk — a taker of my own: does what the jungle ear GIVES come
; back as the same cells, readable by anyone holding form-glass-sensor-rows?
;
; Run observe/jungle-ear-listen.fk in one shell and this in another while it runs.
; A publisher that is not standing is named absent rather than guessed at.
;
; preludes: form/form-stdlib/jungle-ear.bml
(do
    (defn jet-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (jet-cat (tail xs)))))
    (defn jet-pad (s n) (if (ge (str_len s) n) s (jet-pad (str_concat s " ") n)))
    (defn jet-val (row) (if (eq (fgo-present? row) 0) "(absent)"
        (if (str_eq (fgo-value-kind row) "int")
            (str_concat (int_to_str (fgo-int-value row)) (if (eq (str_len (fgo-unit row)) 0) "" (str_concat " " (fgo-unit row))))
            (fgo-text-value row))))
    (defn jet-show (rows) (if (eq (len rows) 0) 0
        (do (let r (head rows))
            (print (jet-cat (list (jet-pad (fgo-id r) 20) (jet-pad (fgo-evidence r) 17) (jet-val r))))
            (jet-show (tail rows)))))
    (let standing (fgsr-standing? (JESensor)))
    (print (jet-cat (list "publisher glass.sensor." (JESensor) " standing=" (int_to_str standing))))
    (let held (fgsr-take (JESensor) (list)))
    (let rows (fgsr-rows-or-absent (JESensor) held))
    (jet-show rows)
    (print (str_concat "rows=" (int_to_str (len rows))))
    (len rows))
