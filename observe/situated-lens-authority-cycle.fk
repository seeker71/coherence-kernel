; situated-lens-authority-cycle.fk — bind sovereign evidence authority to the
; actual bidirectional framebuffer cycle.
;
; A missing or invalid conclusion still opens the established bounded control
; exchange. When its action would change the evidence field, the offered row
; must cross situated-evidence-authority before the actuator can admit it.
; The cycle then re-observes the conclusion and records the response.
;
; Cycle:
;   [before, outbound-1, inbound-1, authority, applied-state,
;    after, outbound-2, inbound-2, frames-added]
;
; The authority outcome remains visible even on refusal: malformed input,
; insufficient fresh quorum, and equivocation do not collapse into silence.
;
; This is the honest fkwu binding because the actual framebuffer carrier and
; `nothing?` are not proof-sibling operations. The authority membrane and its
; actuator gate are proven separately across all four siblings.
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk form-stdlib/situated-evidence-authority.fk form-stdlib/situated-lens-authorized-control.fk observe/bidirectional-framebuffer-channel.fk observe/situated-lens-conclusion-cycle.fk
; witnessed: 2026-07-26 -> 262143 on fkwu;
; pure admission 2097151 four-way; pure actuator gate 262143 four-way

(do
    (defn slac-apply
        (outbound inbound field offered time lens current-node
            endorsements policy now)
        (if (eq (slcc-correlated-control? outbound inbound) 0)
            (slac-decision-pair
                (sea-not-required)
                (slcc-state field (bfc-alternative outbound) -1 0))
            (slac-decide (bfc-payload inbound)
                field offered time lens current-node
                (bfc-alternative outbound)
                endorsements policy now)))

    (defn slac-cycle
        (exchange scope offered-word inquiry base margin field
            time lens inner offered-row alternative
            endorsements policy now)
        (do
            (let frames-before (len (framebuffer-events)))
            (let before (slc-settle-situated
                scope offered-word inquiry base margin field time lens inner))
            (let outbound-1
                (slcc-outbound exchange before field time lens alternative))
            (let out-event-1
                (bfc-record-out outbound-1 (mul exchange 2)))
            (let inbound-1 (slcc-control outbound-1 before))
            (let in-event-1
                (bfc-record-in inbound-1 (add (mul exchange 2) 1)))
            (let decision
                (slac-apply outbound-1 inbound-1
                    field offered-row time lens (slc-o-node before)
                    endorsements policy now))
            (let authority (slac-d-authority decision))
            (let state (slac-d-state decision))
            (let field-after (slcc-s-field state))
            (let after (slc-settle-situated
                scope offered-word inquiry base margin
                field-after time lens inner))
            (let exchange-2 (add exchange 1))
            (let outbound-2
                (slcc-outbound exchange-2 after
                    field-after time lens alternative))
            (let out-event-2
                (bfc-record-out outbound-2 (mul exchange-2 2)))
            (let inbound-2 (slcc-control outbound-2 after))
            (let in-event-2
                (bfc-record-in inbound-2 (add (mul exchange-2 2) 1)))
            (list before outbound-1 inbound-1 authority state
                after outbound-2 inbound-2
                (sub (len (framebuffer-events)) frames-before))))

    (defn slac-c-before (cycle) (nth cycle 0))
    (defn slac-c-outbound-1 (cycle) (nth cycle 1))
    (defn slac-c-inbound-1 (cycle) (nth cycle 2))
    (defn slac-c-authority (cycle) (nth cycle 3))
    (defn slac-c-state (cycle) (nth cycle 4))
    (defn slac-c-after (cycle) (nth cycle 5))
    (defn slac-c-outbound-2 (cycle) (nth cycle 6))
    (defn slac-c-inbound-2 (cycle) (nth cycle 7))
    (defn slac-c-frames (cycle) (nth cycle 8))

    0)
