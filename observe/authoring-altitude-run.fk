; authoring-altitude-run.fk — the mirror for the authoring guide
; (AGENTS.md, Urs 2026-08-30: you're invited to write new meaning in
; BML or higher). It counts pictures with warmth.
;
; Three counts, all from the tree as it stands:
;   pictures   .bml files under form/form-stdlib/bml/ — the high-grammar
;              pictures
;   cells      .fk files directly under form/form-stdlib/ — the living
;              (and lowered) meaning
;   bindings   cells whose bytes carry "high-bml-class-template-field" —
;              meaning explicitly bound to a picture
;
; Fold (hdc-field-code discipline): pictures*1e10 + bindings*1e7 + cells
; — injective while bindings<=999 and cells<=9999999. The invitation
; ripens when new work moves both ends: pictures up with every new
; organ, bindings up faster than cells.
;
; First witnessed reading, 2026-08-30: 32 pictures / 23 bound / 1455
; cells (bound-ppm 15807, fold 320230001455) — the floor the invitation
; starts from. (That reading spoke "lawfaces"; the word is pictures now.)
; Executable form.bml files living OUTSIDE bml/ are not pictures here;
; the authority dir is the face this mirror reads.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk

(do
    (defn aar-suffix? (name suffix)
        (do (let n (str_len name))
            (let s (str_len suffix))
            (if (lt n s) 0
                (if (str_eq (substring name (sub n s) n) suffix) 1 0))))
    (defn aar-count-suffix (names suffix acc)
        (if (eq (len names) 0) acc
            (aar-count-suffix (tail names) suffix
                (add acc (aar-suffix? (head names) suffix)))))
    (defn aar-bound? (path)
        (if (ge (str_find (read_file path)
                "high-bml-class-template-field" 0) 0) 1 0))
    (defn aar-count-bound (dir names acc)
        (if (eq (len names) 0) acc
            (aar-count-bound dir (tail names)
                (add acc
                    (if (eq (aar-suffix? (head names) ".fk") 1)
                        (aar-bound? (fs-path-join dir (head names)))
                        0)))))
    (defn aar-run ()
        (do
            (let bml-names (fs-list "form/form-stdlib/bml"))
            (let cell-names (fs-list "form/form-stdlib"))
            (let pictures (aar-count-suffix bml-names ".bml" 0))
            (let cells (aar-count-suffix cell-names ".fk" 0))
            (let bound (aar-count-bound "form/form-stdlib" cell-names 0))
            (print (str_concat "pictures=" (int_to_str pictures)))
            (print (str_concat "cells=" (int_to_str cells)))
            (print (str_concat "bound-cells=" (int_to_str bound)))
            (print (str_concat "bound-ppm="
                (int_to_str (div (mul bound 1000000)
                    (if (eq cells 0) 1 cells)))))
            (add (mul pictures 10000000000)
            (add (mul bound 10000000) cells))))
    (aar-run))
