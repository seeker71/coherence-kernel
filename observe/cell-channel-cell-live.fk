; cell-channel-cell-live.fk — one resident CELL on a channel.
;
; It drains everything present (the field's spool first, so an admitted
; word is known before the peer's next frame is heard; then the peer's
; spool), hears every say/tell through the gate and the body's own
; evaluator, answers on its own spool, and only then blocks on its own
; bell in the kernel's read. A `release` frame from the peer or a
; `release` byte on the bell ends it cleanly; the pid file it wrote at
; birth leaves with it. It never applies an offer it reads from the
; peer: the grammar it holds is the seed plus the field's admits that it
; re-observed itself and agreed with, and nothing else. Every heard symbol
; crosses the evaluation membrane (a child under hearth-channel-eval-s), so
; nothing a peer says can kill or hang this cell.
;
; stdin lines: channel root, channel name, this cell's name.
; Effectful (appends to its own spool, writes/removes its pid file).
; preflight-exec: forbidden
; preludes: form/form-stdlib/cell-channel.bml
(do
    (defn ccl-line (k v) (print_str (str_concat "cell-live " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn ccl-trim (s) (if (nothing? s) "" (if (eq (str_len s) 0) "" (if (eq (str_byte_at s (sub (str_len s) 1)) 10) (substring s 0 (sub (str_len s) 1)) s))))
    (defn ccl-root-of (s) (if (eq (str_len s) 0) (cc-root-default) s))

    ; state = (peer-reader field-reader grammar gid heard refused released)
    (defn ccl-state (rp rf grammar gid heard refused released) (list rp rf grammar gid heard refused released))
    (defn ccl-rp (st) (nth st 0))
    (defn ccl-rf (st) (nth st 1))
    (defn ccl-grammar (st) (nth st 2))
    (defn ccl-gid (st) (nth st 3))
    (defn ccl-heard (st) (nth st 4))
    (defn ccl-refused (st) (nth st 5))
    (defn ccl-released (st) (nth st 6))

    (defn ccl-has-release? (frames) (gt (len (cc-frames-of-kind frames "release")) 0))

    ; hear every hearable frame, answering each on our own spool
    (defn ccl-hear-all (root name me st frames)
        (if (eq (len frames) 0) st
            (if (eq (cc-hearable? (head frames)) 0)
                (ccl-hear-all root name me st (tail frames))
                (do (let answer (cc-hear-through (cc-eval-path root name me) (ccl-grammar st) (ccl-gid st) (head frames) (hearth-channel-eval-s)))
                    (let sent (cc-send root name me (cc-answer-kind answer) (cc-answer-body answer)))
                    (let said (ccl-line (cc-answer-kind answer) (str_concat "to=" (str_concat (int_to_str (cc-frame-turn (head frames))) (str_concat " turn=" (int_to_str (cc-sent-turn sent)))))))
                    (ccl-hear-all root name me
                        (ccl-state (ccl-rp st) (ccl-rf st) (ccl-grammar st) (ccl-gid st)
                            (add (ccl-heard st) (if (str_eq (cc-answer-kind answer) "heard") 1 0))
                            (add (ccl-refused st) (if (str_eq (cc-answer-kind answer) "refuse") 1 0))
                            (ccl-released st))
                        (tail frames))))))

    ; fold the field's admits one by one, each re-observed by THIS cell against
    ; its own grammar first (a second witness): agreement folds and answers
    ; `folded grammar=<id>` on our spool — the acceptance ack the crown theorem
    ; asks for; disagreement answers `witness divergent ...` and folds nothing
    (defn ccl-fold-one (root name me st frame)
        (if (eq (cc-admit-agrees? (ccl-grammar st) frame) 1)
            (do (let grammar (cc-grammar-fold (ccl-grammar st) (list (cc-frame-body frame))))
                (let gid (cc-grammar-id grammar))
                (let sent (cc-send root name me "folded" (str_concat "grammar=" (str_concat gid (str_concat " admit=" (cc-frame-id frame))))))
                (let said (ccl-line "folded" (str_concat (cc-short gid) (str_concat " admit=" (cc-short (cc-frame-id frame))))))
                (ccl-state (ccl-rp st) (ccl-rf st) grammar gid (ccl-heard st) (ccl-refused st) (ccl-released st)))
            (do (let sent (cc-send root name me "witness" (str_concat "divergent admit=" (str_concat (cc-frame-id frame) (str_concat " reason=" (cc-admit-divergence (ccl-grammar st) frame))))))
                (let said (ccl-line "divergent" (cc-admit-divergence (ccl-grammar st) frame)))
                st)))
    (defn ccl-fold-field (root name me st frames)
        (if (eq (len frames) 0) st
            (if (str_eq (cc-frame-kind (head frames)) "admit")
                (ccl-fold-field root name me (ccl-fold-one root name me st (head frames)) (tail frames))
                (ccl-fold-field root name me st (tail frames)))))

    ; one pass: field first, then peer; answers (state, moved?)
    (defn ccl-pass (root name me st)
        (do (let df (cc-drain (ccl-rf st)))
            (let st1 (ccl-fold-field root name me (ccl-state (ccl-rp st) (cc-drained-reader df) (ccl-grammar st) (ccl-gid st) (ccl-heard st) (ccl-refused st) (ccl-released st)) (cc-drained-frames df)))
            (let dp (cc-drain (ccl-rp st1)))
            (let frames (cc-drained-frames dp))
            (let st2 (ccl-state (cc-drained-reader dp) (ccl-rf st1) (ccl-grammar st1) (ccl-gid st1) (ccl-heard st1) (ccl-refused st1)
                         (if (or (ccl-has-release? frames) (ccl-has-release? (cc-drained-frames df))) 1 (ccl-released st1))))
            (let st3 (ccl-hear-all root name me st2 frames))
            (list st3 (if (gt (add (len frames) (len (cc-drained-frames df))) 0) 1 0))))

    ; drain while anything moves; then wait on the bell; a release ends it
    (defn ccl-loop (root name me bell st)
        (do (let passed (ccl-pass root name me st))
            (let st1 (nth passed 0))
            (if (eq (ccl-released st1) 1) st1
            (if (eq (nth passed 1) 1) (ccl-loop root name me bell st1)
                (do (let wake (cc-bell-wait bell))
                    (if (eq (cc-released? wake) 1) st1
                        (ccl-loop root name me bell st1)))))))

    (let root (ccl-root-of (ccl-trim (read_line))))
    (let name (ccl-trim (read_line)))
    (let me (ccl-trim (read_line)))
    (if (eq (cc-open? root name) 0)
        (do (ccl-line "signal" "nothing") (ccl-line "reason" "channel-not-open") 0)
        (do
            (let pid (cc-self-pid))
            (let wrote (cc-pid-write root name me pid))
            (let peer (cc-peer-cell root name me))
            (let grammar (cc-grammar-current root name))
            (let born (ccl-line "born" (str_concat me (str_concat " pid=" (str_concat (int_to_str pid) (str_concat " peer=" (str_concat peer (str_concat " grammar=" (cc-grammar-id grammar)))))))))
            (let final (ccl-loop root name me (cc-bell root name me)
                (ccl-state (cc-reader root name peer) (cc-reader root name (cc-field-name)) grammar (cc-grammar-id grammar) 0 0 0)))
            (let cleared (cc-pid-clear root name me))
            (ccl-line "released" (str_concat me (str_concat " heard=" (str_concat (int_to_str (ccl-heard final)) (str_concat " refused=" (str_concat (int_to_str (ccl-refused final)) (str_concat " grammar=" (ccl-gid final))))))))
            0)))
