; form-cli-cell-mesh-sovereign-glass-run.fk — project the native mesh event stream into
; the kernel framebuffer that Form Glass already observes.
;
; This is an fkwu-only observation bridge: the channel itself is pure four-way
; Form, while fb_record gives each resulting event a source-attributed root.
; It opens no process, file, network, or host-command membrane.
;
; Verdict 15: the demo has open/send/adapted events (1), all three are recorded
; as framebuffer roots (2), roots are visible (4), and their source is the mesh
; organ (8).
; preludes: form/form-stdlib/bml/form-cli-cell-mesh-sovereign.bml
(do
    (defn fcmg-record (events line)
        (if (eq (len events) 0)
            0
            (do
                (fb_record
                    (intern_trivial_string (fcm-event-kind (head events)))
                    "form/form-stdlib/bml/form-cli-cell-mesh-sovereign.bml"
                    (add (mul line 65536) 1))
                (add 1 (fcmg-record (tail events) (add line 1))))))
    (defn fcmg-bit (condition bit) (if condition bit 0))
    (let channel (fcm-demo-channel))
    (let stream (fcm-channel-events channel))
    (framebuffer-clear)
    (let recorded (fcmg-record stream 1))
    (let visible (framebuffer-events))
    (let source (node_source (head visible)))
    (sum (list
        (fcmg-bit (and (eq (len stream) 3)
            (and (str_eq (fcm-event-kind (head stream)) "open")
                (str_eq (fcm-event-kind (nth stream 2)) "adapted"))) 1)
        (fcmg-bit (eq recorded 3) 2)
        (fcmg-bit (eq (len visible) 3) 4)
        (fcmg-bit (str_eq (nth source 0) "form/form-stdlib/bml/form-cli-cell-mesh-sovereign.bml") 8))))
