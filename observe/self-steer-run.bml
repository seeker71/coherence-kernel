// self-steer-run.bml — the register's open rows, offered: each row whose `next` names a band becomes a queue or finding offer, and one row lands in receipts/self-steer-ledger.jsonl.
//
//   ./fkwu observe/self-steer-run.bml </dev/null
//
// stdin, optional, one JSON line: gaps, register, ledger, root. Offers only: no queue row is written. form-stdlib/bml/self-steer.bml holds the reading.
// preflight-exec: forbidden
import form-stdlib/bml/self-steer.bml;
section [form.bml] {
 ss-run(ss-opts());
}
