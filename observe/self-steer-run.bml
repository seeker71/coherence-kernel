// self-steer-run.bml — the register's open rows, offered: each row whose `next` names a band becomes a queue or finding offer, and one row lands in receipts/self-steer-ledger.jsonl.
//
//   ./fkwu observe/self-steer-run.bml </dev/null
//
// stdin, optional, one JSON line: gaps, register, ledger, root, queue, deadline_ms. Offers only unless the option queue names the queue file
// (echo '{"queue":"learn/native-turn-queue.jsonl"}' | ./fkwu observe/self-steer-run.bml): then each queue offer whose band reads below its full and
// whose id no row holds becomes one queue row. form-stdlib/bml/self-steer.bml holds the reading.
// preflight-exec: forbidden
import form-stdlib/bml/self-steer.bml;
section [form.bml] {
 ss-run(ss-opts());
}
