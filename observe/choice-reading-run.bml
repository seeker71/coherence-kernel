// choice-reading-run.bml — where the body's code meets surprise with a code, and where with a choice.
//
// A mirror, not a gate (teachings/surprise-is-a-choice-point.md): it counts, across the tracked .bml and .fk
// sources outside receipts/, the places a failure is returned as -1 ("then -1 else", "else -1"), and the places
// code offers options to Form's own control invites (oac-choice, oac-backtrack, oac-try, oac-cut, oac-undo,
// oac-lanes, oac-timeout-walk). It prints both totals and the files that carry the most -1 returns, so the next
// movement can take one of them home to choice. A count is attention; the writer decides.
// stdin: nothing, or one line with how many files to show (default 12).
// preludes: form-stdlib/meaning-codes.bml
section [form.bml] {
 class ChoiceReading {
  def cr-line(t) = trim(if nothing?(t) then "" else t);
  def cr-count(pattern) = cr-line(host-exec(mc-cat(list("git grep -c -E '", pattern, "' -- '*.bml' '*.fk' ':!receipts' ':!control' | awk -F: '{s+=$2; f+=1} END {print s+0, f+0}'")), ""));
  def cr-top(pattern, n) = host-exec(mc-cat(list("git grep -c -E '", pattern, "' -- '*.bml' '*.fk' ':!receipts' ':!control' | sort -t: -k2 -rn | head -", int_to_str(n), " | awk -F: '{print \"  \" $2 \"  \" $1}'")), "");
  def cr-codes() = "then -1 else|else -1[;)]";
  def cr-choices() = "oac-(choice|backtrack|backtrack-walk|try|cut|undo|lanes|timeout-walk)[ (]";
  def cr-run() {
   let arg = cr-line(read_line());
   let n = if eq(str_len(arg), 0) then 12 else str_to_int(arg);
   let codes = cr-count(cr-codes());
   let choices = cr-count(cr-choices());
   print_str(mc-cat(list("[choice-reading] -1 returns (sites files): ", codes, "\n")));
   print_str(mc-cat(list("[choice-reading] control-invite uses outside control/ (sites files): ", choices, "\n")));
   print_str(mc-cat(list("[choice-reading] files carrying the most -1 returns:\n", cr-top(cr-codes(), n))));
  }
 }
 cr-run();
}
