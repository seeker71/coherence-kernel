// choice-reading-run.bml — where the body's code meets surprise with a code, and where with a choice.
//
// A mirror, not a gate (teachings/surprise-is-a-choice-point.md). It walks the tree with the kernel's own
// source_inventory (receipts/, control/, hidden trees and itself skipped), reads each .bml and .fk in Form, and
// counts the places a failure is returned as -1 ("then -1 else", "else -1;", "else -1)") and the places code offers
// options to Form's control invites (oac-choice, oac-backtrack, oac-backtrack-walk, oac-try, oac-cut, oac-undo,
// oac-lanes, oac-timeout-walk). It prints both totals and the files carrying the most -1 returns, so the next
// movement can take one of them home to choice. A count is attention; the writer decides.
// stdin: nothing, or one line with how many files to show (default 12).
// preludes: form-stdlib/meaning-codes.bml
section [form.bml] {
 class ChoiceReading {
  def cr-line(t) = trim(if nothing?(t) then "" else t);
  // the mirror's own patterns are not code meeting surprise, so it skips itself too
  def cr-skips() = list("receipts", "control", ".git", ".hearth", ".claude", ".obsidian", "node_modules", "choice-reading-run.bml");
  def cr-sources() = append(source_inventory(".", ".bml", cr-skips()), source_inventory(".", ".fk", cr-skips()));
  def cr-count-at(text, pat, from, n) { let i = str_find(text, pat, from); if (i < 0) then n else cr-count-at(text, pat, (i + str_len(pat)), (n + 1)); }
  def cr-count-all(text, pats) = if nil?(pats) then 0 else (cr-count-at(text, head(pats), 0, 0) + cr-count-all(text, tail(pats)));
  def cr-codes() = list("then -1 else", "else -1;", "else -1)");
  def cr-invite-names() = list("oac-choice", "oac-backtrack", "oac-backtrack-walk", "oac-try", "oac-cut", "oac-undo", "oac-lanes", "oac-timeout-walk");
  def cr-invite-pats(names) = if nil?(names) then list() else cons(str_concat(head(names), "("), cons(str_concat(head(names), " "), cr-invite-pats(tail(names))));
  def cr-read(path) = if (file_size(path) < 1) then "" else read_file(path);
  // rows of (path codes invites) for every source that carries either
  def cr-rows(sources, invitePats) = if nil?(sources) then list() else cr-row-then(head(head(sources)), tail(sources), invitePats);
  def cr-row-then(path, rest, invitePats) {
   let text = cr-read(path);
   let codes = cr-count-all(text, cr-codes());
   let invites = cr-count-all(text, invitePats);
   if (((Comparable) codes == 0) && ((Comparable) invites == 0)) then cr-rows(rest, invitePats) else cons(list(path, codes, invites), cr-rows(rest, invitePats));
  }
  def cr-sum(rows, k) = if nil?(rows) then 0 else (nth(head(rows), k) + cr-sum(tail(rows), k));
  def cr-files(rows, k) = if nil?(rows) then 0 else ((if (nth(head(rows), k) > 0) then 1 else 0) + cr-files(tail(rows), k));
  // the n rows with the most -1 returns, most first: a bounded insertion
  def cr-insert(row, top) = if nil?(top) then list(row) else if (nth(row, 1) > nth(head(top), 1)) then cons(row, top) else cons(head(top), cr-insert(row, tail(top)));
  def cr-top(rows, n, top) = if nil?(rows) then top else cr-top(tail(rows), n, if (nth(head(rows), 1) > 0) then take(n, cr-insert(head(rows), top)) else top);
  def cr-lines(top) = if nil?(top) then "" else mc-cat(list("  ", int_to_str(nth(head(top), 1)), "  ", nth(head(top), 0), "\n", cr-lines(tail(top))));
  def cr-run() {
   let arg = cr-line(read_line());
   let n = if ((Comparable) str_len(arg) == 0) then 12 else str_to_int(arg);
   let rows = cr-rows(cr-sources(), cr-invite-pats(cr-invite-names()));
   print_str(mc-cat(list("[choice-reading] -1 returns (sites files): ", int_to_str(cr-sum(rows, 1)), " ", int_to_str(cr-files(rows, 1)), "\n")));
   print_str(mc-cat(list("[choice-reading] control-invite uses outside control/ (sites files): ", int_to_str(cr-sum(rows, 2)), " ", int_to_str(cr-files(rows, 2)), "\n")));
   print_str(mc-cat(list("[choice-reading] files carrying the most -1 returns:\n", cr-lines(cr-top(rows, n, list())))));
  }
 }
 cr-run();
}
