// band-truth-run.bml — does each band's declared full match the most its claims can sum to.
//
// The gates (the band sweep, the drift-gate sweep, the native turn's green test, the voice admission) believe a
// band's number against the `; Verdict n` its head declares. This door reads that declared full and the
// claims behind it for every band the band sweep walks, without running one: the band's own `live-claims(`
// list, else the head's inline list, else the head's table rows. It also reads the second copies of a full
// (learn/native-turn-queue.jsonl rows, form/band-verdicts.txt rows) against the head pin, and names each
// gap the native-turn ledger saw read above its full. The rules, the flaw classes and the formats it can and
// cannot read are in form-stdlib/bml/band-truth.bml. It runs in about a second.
//
//   ./fkwu observe/band-truth-run.bml          (run from the repository root; reads no stdin)
//
// stdout: one line per flaw (`flaw <class> <path> pin=<n> max=<m> <detail>`), one line per band it cannot
// read (`unreadable <path> reason=<why>`), one per gap the ledger saw above its full (`seen read-above-full
// ...`, history that no flaw count carries), then
//   band-truth formats code-list=<a> head-inline=<b> head-table=<c> off-table=<o> mask-only=<d> no-table=<e> inline-unparsed=<f> unpinned=<g> absent=<h>
//   band-truth bands=<n> readable=<r> unreadable=<u> absent=<a> seen=<s> flaws=<k>
// Exit 0 when nothing is flagged (the answer 0 follows the summary). A flagged tree ends in form_error after
// its summary line, so its exit reads 1 and stderr carries `band-truth: <k> flaw(s) flagged`. A band it
// cannot read is named, never counted fine; unreadable and seen do not move the exit. A sweep that lists no
// band (git missing, or not run from the repository root) is itself a flaw (`flaw empty-sweep`), so a door
// that read nothing never exits 0. A band that keeps a decimal-digit fold or a count of ones on purpose
// says `; FOLD: decimal` or `; FOLD: count` on a line of its head, which silences that kind's bad-bits line.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/band-truth.bml
section [form.bml] {
 class BandTruthRun {
  // the bands the band sweep walks (bsw-all in band-sweep.bml): every form/form-stdlib/tests/*.fk and *-band.bml except
  // a -child, -fixture or -run door, and every other home's tests/*-band.fk and *-band.bml; a path that
  // starts with `.` is not swept
  def btr-base(path) = substring(path, 23, len(path));
  def btr-stdlib?(path) = bt-starts?(path, "form/form-stdlib/tests/") && !bt-has?(btr-base(path), "/");
  def btr-door?(path) = bt-ends?(path, "-child.fk") || bt-ends?(path, "-fixture.fk") || bt-ends?(path, "-run.fk")
   || bt-ends?(path, "-child.bml") || bt-ends?(path, "-fixture.bml") || bt-ends?(path, "-run.bml");
  def btr-swept?(path) = len(path) > 0 && str_byte_at(path, 0) != 46
   && (btr-stdlib?(path) ? (bt-ends?(path, ".fk") || bt-ends?(path, "-band.bml")) && !btr-door?(path)
       : !bt-starts?(path, "form/form-stdlib/tests/") && (bt-ends?(path, "-band.fk") || bt-ends?(path, "-band.bml")));
  def btr-paths() {
   let listed = host_capture(["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", "*/tests/*.fk", "*/tests/*.bml"]) ?? "";
   filter(p => btr-swept?(p), filter(l => len(l) > 0, split-on(listed, "\n")));
  }
  def btr-run() {
   let flaws = bt-report(btr-paths(), append(bt-copies(), bt-history()));
   bt-finish(flaws);
  }
 }
 btr-run();
}
