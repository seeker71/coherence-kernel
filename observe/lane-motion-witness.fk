// lane-motion-witness.fk — sample every glass data point, hold, sample
// again, and report per-point MOVED/held. Motion is observed, never
// claimed; a held point shows its value because stillness is data too.
// stdin line 1: seconds to hold between the two samples.
import form-stdlib/hearth.bml;
import form-stdlib/hearth-glass.bml;
import form-stdlib/lane-motion.bml;
section [form.bml] {
    let w = str_to_int(read_line());
    let a = lms-snap();
    let za = print_str(("sample-a taken, holding " + (w.str() + ("s" + tg-nl()))));
    let z = hearth-rest-s(w);
    print_str(lms-report(a, lms-snap()));
}
