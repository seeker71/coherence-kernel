; floor-lens-run.fk — every lane beside the floor its hardware gives it, measured here and now:
; this Mac's bandwidth by reading a real blob through the handle door, its arithmetic rate by six
; independent chains of fused multiply-adds, then each lane run warm. A lane's floor is whichever
; is higher — the bytes one pass must move over the bandwidth, or the arithmetic it must do over
; the rate — and the frame names which one holds it. The bytes and the flops are the models' own:
; tensor bytes summed from their tables, activation traffic and arithmetic named term by term.
; preflight-exec: forbidden
; preludes: form/form-stdlib/floor-lens.bml form/form-stdlib/ear-native.fk native/metal/dense-token-handle.fk native/metal/dense-multi.fk
(do
    (defn flr-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (flr-zeros (str_concat s s) n)))
    (defn flr-snap () (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (defn flr-encodes (st pcm n) (if (le n 0) 0 (do (let Te (enw-encode st pcm)) (flr-encodes st pcm (sub n 1)))))
    (defn flr-steps (st pos Te n) (if (le n 0) 0 (do (let id (enw-step2 st 1033 pos Te)) (flr-steps st (add pos 1) Te (sub n 1)))))
    (defn flr-tokens (st id pos n) (if (le n 0) 0 (do (let nid (dth-forward (nth st 0) (nth st 1) (nth st 2) (nth st 3) (nth st 4) (nth st 5) (nth st 6) (nth st 7) (nth st 8) id pos)) (flr-tokens st nid (add pos 1) (sub n 1)))))
    (defn flr-bump (poss) (if (eq (len poss) 0) (list) (cons (add (head poss) 1) (flr-bump (tail poss)))))
    (defn flr-msteps (st ids poss n) (if (le n 0) 0 (do (let nids (dm-step st ids poss)) (flr-msteps st nids (flr-bump poss) (sub n 1)))))
    (defn flr-side (rows side acc) (if (eq (len rows) 0) acc (flr-side (tail rows) side (if (eq (str_find (head (head rows)) side 0) 0) (add acc (en-bytes (head rows))) acc))))
    (let blob (mr-path (mr-find "llama32-1b")))
    (let blob3 (mr-path (mr-find "llama32-3b")))
    (let bw (fl-measure-bw blob))
    (let gbs (fl-gbs bw))
    (let tfl (fl-tflops (fl-measure-flops)))
    (let npz (str_concat (flr-snap) "/weights.npz"))
    (let st (enw-open npz (enw-tokenizer-path)))
    (let table (en-table npz))
    (let encbytes (flr-side table "encoder." 0))
    (let decbytes (flr-side table "decoder." 0))
    (let bytes (en-text (read_file "form/form-stdlib/tests/fixtures/ear-okay-2s.wav")))
    (let pcm (str_concat (substring bytes 44 (str_len bytes)) (flr-zeros (byte_to_str 0) (sub 256000 (sub (str_len bytes) 44)))))
    (let warm (enw-encode st pcm))
    (let e0 (now_unix_ms))
    (let encs (flr-encodes st pcm 20))
    (let e1 (now_unix_ms))
    (let Te (enw-encode st pcm))
    (let w2 (enw-step2 st 1033 3 Te))
    (let d0 (now_unix_ms))
    (let steps (flr-steps st 4 Te 200))
    (let d1 (now_unix_ms))
    (let dst (dth-open blob 256 (sub 0 1)))
    (let warm2 (flr-tokens dst 128000 0 2))
    (let t0 (now_unix_ms))
    (let toks (flr-tokens dst 791 2 40))
    (let t1 (now_unix_ms))
    (let dst3 (dth-open blob3 256 (sub 0 1)))
    (let warm3 (flr-tokens dst3 128000 0 2))
    (let u0 (now_unix_ms))
    (let toks3 (flr-tokens dst3 791 2 20))
    (let u1 (now_unix_ms))
    (let mst (dm-open blob 256 4))
    (let mwarm (flr-msteps mst (list 128000 128000 128000 128000) (list 0 0 0 0) 4))
    (let m0 (now_unix_ms))
    (let msteps (flr-msteps mst (list 791 791 791 791) (list 4 4 4 4) 20))
    (let m1 (now_unix_ms))
    ; the shapes an 8 s window runs through, and what each pass must move and compute
    (let Tf 800)
    (let Tw 400)
    (let D 384)
    (let F 1536)
    (let a1 256000)
    (let a2 (mul (mul Tf 201) 8))
    (let a3 (mul (mul Tf 80) 16))
    (let a4 (mul (mul Tf D) 8))
    (let a5 (mul (mul Tw D) 8))
    (let a6 (mul 4 (mul (mul Tw D) 100)))
    (let act (add a1 (add a2 (add a3 (add a4 (add a5 a6))))))
    (let c1 (mul (mul (mul (mul 2 Tf) 201) 400) 4))
    (let c2 (mul (mul (mul (mul 2 Tf) D) 80) 3))
    (let c3 (mul (mul (mul (mul 2 Tw) D) D) 3))
    (let c4 (mul 4 (mul (mul (mul (mul 2 Tw) D) D) 4)))
    (let c5 (mul 4 (mul (mul (mul (mul 2 Tw) D) F) 2)))
    (let c6 (mul 4 (mul (mul (mul (mul 4 6) Tw) Tw) 64)))
    (let encflops (add c1 (add c2 (add c3 (add c4 (add c5 c6))))))
    (let decflops (mul (mul 2 51865) D))
    (let flops1b (mul 2 1200000000))
    (let flops3b (mul 2 3200000000))
    (let r1 (fl-row2 "encode" (add encbytes act) encflops (sub e1 e0) 20 gbs tfl))
    (let r2 (fl-row2 "wtoken" decbytes decflops (sub d1 d0) 200 gbs tfl))
    (let r3 (fl-row2 "1btoken" (file_size blob) flops1b (sub t1 t0) 40 gbs tfl))
    (let r4 (fl-row2 "3btoken" (file_size blob3) flops3b (sub u1 u0) 20 gbs tfl))
    (let r5 (fl-row2 "4in1" (div (file_size blob) 4) flops1b (sub m1 m0) 80 gbs tfl))
    (print_str (fl-frame gbs (list r1 r2 r3 r4 r5)))
    (print_str (str_concat "arithmetic rate measured: " (str_concat (float_to_str tfl) " TFLOPS")))
    0)
