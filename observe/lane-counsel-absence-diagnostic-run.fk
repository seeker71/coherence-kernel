; lane-counsel-absence-diagnostic-run.fk — turn false green zeroes into
; typed absence when no serving hearth is standing.
;
; The framebuffer carries only state codes and source-presence bits.
;
; preludes: form/form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn lcad-has (path needle)
        (if (ge (str_find (read_file path) needle 0) 0) 1 0))
    (defn lcad-apply-revise (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound)
                                 (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    (framebuffer-clear)
    ; 4201: absent hearth files were folded into green numeric zeroes.
    ; 4202: hearth-dependent lanes carry a reasoned gap; process-derived
    ; orphan count remains independently observable.
    (let outbound (bfc-envelope 0 90301 0 4201 4202))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let applied (lcad-apply-revise outbound inbound 4201 4202))
    (let source-witness (if (and
        (eq (lcad-has "form/form-stdlib/lane-counsel.bml"
            "no-standing-hearth") 1)
        (eq (lcad-has "form/form-stdlib/lane-counsel.bml"
            "no all-good verdict") 1)) 1 0))
    (let reobserved (if (eq applied 4202) source-witness 0))
    (let outbound2 (bfc-envelope 0 90302 0 reobserved 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))
    (list "lane-counsel-absence-diagnostic"
        "before" 4201 "applied" applied "source-reobserved" reobserved
        "framebuffer-events" (len (framebuffer-events))))
