; form-universe-speak-live.fk — local Qwen speaks Form's tongue.
; Overlay already wraps generate. Seed A/B from the form-neutral gloss.
; fqt-lora? stays 0. Not a sealed row. Play.
;
; preludes: form-stdlib/form-cli-model-generate.fk
; preludes: form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-lora-writer.bml form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let sample (fqt-pair-gloss "form-neutral-dictionary"))
    (let pair (flw-from-sample sample (fqt-dim)))
    (let _w (flw-write (flw-path) (nth pair 0) (nth pair 1)))
    (let prompt "Reply with exactly: BML CHOICE FAIL NOTHING HOME")
    (let t0 (now_unix_ms))
    (let out (fcmg-generate path prompt 24))
    (let t1 (now_unix_ms))
    (print_str (str_concat "universe_wall_ms=" (str_concat (int_to_str (sub t1 t0)) "\n")))
    (print_str (str_concat "universe_lora_written=" (str_concat (int_to_str (flw-written (flw-path))) "\n")))
    (print_str (str_concat "universe_lora_applied=" (str_concat (int_to_str (fqt-adapter-applied?)) "\n")))
    (print_str (str_concat "universe_lora_flag=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "universe_n=" (str_concat (int_to_str (fqt-n)) "\n")))
    (print_str (str_concat "universe_has_BML="
        (str_concat (int_to_str (if (ge (str_find out "BML" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "universe_has_CHOICE="
        (str_concat (int_to_str (if (ge (str_find out "CHOICE" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "universe_has_FAIL="
        (str_concat (int_to_str (if (ge (str_find out "FAIL" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "universe_has_NOTHING="
        (str_concat (int_to_str (if (ge (str_find out "NOTHING" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "universe_has_HOME="
        (str_concat (int_to_str (if (ge (str_find out "HOME" 0) 0) 1 0)) "\n")))
    (print out)
    0)
