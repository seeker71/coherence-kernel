//////////////////////////////////////////////////////////////////////
//
// observe/source-counsel.bml — per-source lane counsel over a NAMED
// heat reading.
//
// The heat board writes ".fkwu-heat.<pid>" as "count name" lines —
// named since 2026-09-02 (the writer joined heat's fn-index space to
// the symbol rows through fk_fnidx; before that every line carried an
// empty name and no counsel could speak). This cell reads one heat
// file and answers, worst-first by heat, WHICH source recipes carry
// the run and WHERE each should live:
//
//   crystallize — offer to the glass (jit_arm64_u32_leaf) when the
//                 recipe is a pure int fold; the heat gate is the
//                 door, jit-self-crystallization.fk the actuator;
//   carrier     — mlx_run / metal lanes when the recipe is tensor-
//                 shaped (form-cli-gpu-run.fk names those programs);
//   native      — string/io/structure recipes stay with the walker.
//
// The counsel names candidates; the shape test (pure int->int for the
// u32 leaf) belongs to the actuator that compiles them. Advice is
// data, worst-first, the lane-counsel pattern.
//
// Door: the house observe pattern (voice-frequency's) — write the heat
// path to /tmp/source-counsel-target, then run this cell:
//   echo .fkwu-heat.<pid> > /tmp/source-counsel-target
//   ./fkwu observe/source-counsel.bml
// (Composed callers prelude this unit and call sc-report directly.)
//
// preludes: form-stdlib/core.fk

section [form.bml] {
    def sc-nl() = byte_to_str(10);

    def sc-parse(text, from, acc) {
        let nl = str_find(text, sc-nl(), from);
        if lt(nl, 0) then acc
        else sc-parse(text, add(nl, 1), sc-take(acc, substring(text, from, nl)));
    }

    def sc-take(acc, line) {
        let sp = str_find(line, " ", 0);
        if lt(sp, 0) then acc
        else cons(list(str_to_int(substring(line, 0, sp)),
                       substring(line, add(sp, 1), str_len(line))), acc);
    }

    def sc-hotter(a, b) = if gt(nth(a, 0), nth(b, 0)) then a else b;

    def sc-max(pairs, best) =
        if eq(len(pairs), 0) then best
        else sc-max(tail(pairs), sc-hotter(head(pairs), best));

    def sc-drop(pairs, one, acc) =
        if eq(len(pairs), 0) then acc
        else if value_eq(head(pairs), one) then sc-drop(tail(pairs), one, acc)
        else sc-drop(tail(pairs), one, cons(head(pairs), acc));

    def sc-total(pairs, acc) =
        if eq(len(pairs), 0) then acc
        else sc-total(tail(pairs), add(acc, nth(head(pairs), 0)));

    def sc-name-of(p) = nth(p, 1);

    def sc-advice(name) =
        str_concat("crystallize candidate (glass jit_arm64_u32_leaf if pure int fold; ",
            "tensor-shaped -> mlx_run/metal via form-cli-gpu-run; else native stays): ");

    def sc-row(rank, p) =
        str_concat(int_to_str(rank),
        str_concat(". ",
        str_concat(int_to_str(nth(p, 0)),
        str_concat("  ",
        str_concat(sc-advice(sc-name-of(p)), sc-name-of(p))))));

    def sc-rank(pairs, rank, acc) {
        let best = sc-max(pairs, list(sub(0, 1), "-"));
        if eq(len(pairs), 0) then acc
        else sc-rank(sc-drop(pairs, best, empty), add(rank, 1),
            str_concat(acc, str_concat(sc-row(rank, best), sc-nl())));
    }

    def sc-report(path) {
        let text = read_file(path);
        if nothing?(text)
        then str_concat("source counsel: no heat reading at ", path)
        else sc-report-of(path, sc-parse(text, 0, empty));
    }

    def sc-target() {
        let t = read_file("/tmp/source-counsel-target");
        if nothing?(t) then ""
        else if lt(str_find(t, sc-nl(), 0), 0) then t
        else substring(t, 0, str_find(t, sc-nl(), 0));
    }

    def sc-report-of(path, pairs) =
        str_concat("source counsel - worst first, by heat (",
        str_concat(path,
        str_concat(")",
        str_concat(sc-nl(),
        str_concat("dispatches observed: ",
        str_concat(int_to_str(sc-total(pairs, 0)),
        str_concat(sc-nl(), sc-rank(pairs, 1, ""))))))));

    print_str(sc-report(sc-target()));
    0;
}
