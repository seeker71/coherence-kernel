; network-pulse-live.fk — core-native live observation of the production network pulse.
;
; The c-bootstrap fkwu walks TLS itself (http_get), so this cell reads the two public
; pulse doors — the witness (pulse.coherencycoin.com) and the instance
; (api.coherencycoin.com/api/pulse/now) — and names the overall breath plus every organ
; not breathing, with no shell, no curl, no jq: one recipe over str_byte_at / str_concat /
; http_get. Root value = total organs not breathing across both doors (0 = whole body
; breathing); a dark door prints door-dark and counts as one.
;
; Carrier (live socket I/O), no four-way band — the proven parts are the byte-walk
; primitives it composes; kin: host-probe's hp-reachable, observe/door-link-health.fk.
;
; Run:  ./fkwu --src observe/network-pulse-live.fk
(do
    ; does needle match body at position i?
    (defn np-match-at (body i needle j)
        (if (ge j (str_len needle)) 1
            (if (eq (str_byte_at body (add i j)) (str_byte_at needle j))
                (np-match-at body i needle (add j 1))
                0)))
    ; index of needle in body at/after i, or -1
    (defn np-find (body i needle)
        (if (gt (add i (str_len needle)) (str_len body)) (sub 0 1)
            (if (eq (np-match-at body i needle 0) 1) i
                (np-find body (add i 1) needle))))
    ; the quoted value starting at i (first byte of value), up to the closing quote
    (defn np-quoted (body i acc)
        (do (let b (str_byte_at body i))
            (if (eq b 34) acc
                (np-quoted body (add i 1) (str_concat acc (byte_to_str b))))))
    ; value of "key":"..." at/after i, or ""
    (defn np-value (body i key)
        (do (let k (str_concat (str_concat "\"" key) "\":\""))
            (let p (np-find body i k))
            (if (lt p 0) "" (np-quoted body (add p (str_len k)) ""))))
    ; walk organ entries: capture each "name", read its "status", print the not-breathing
    (defn np-organs (body i quiet)
        (do (let p (np-find body i "\"name\":\""))
            (if (lt p 0) quiet
                (do (let name (np-quoted body (add p 8) ""))
                    (let st (np-value body p "status"))
                    (if (eq (str_eq st "breathing") 1)
                        (np-organs body (add p 8) quiet)
                        (do (print_str (str_concat (str_concat (str_concat "  organ " name) " ") st))
                            (print_str "\n")
                            (np-organs body (add p 8) (add quiet 1))))))))
    ; one door: print overall + not-breathing organs, return their count (dark door = 1)
    (defn np-observe (label url)
        (do (let r (http_get url (list) 6000))
            (let code (_get r "status_code"))
            (if (eq code 200)
                (do (let body (_get r "body"))
                    (print_str (str_concat (str_concat (str_concat label " overall ") (np-value body 0 "overall")) "\n"))
                    (np-organs body 0 0))
                (do (print_str (str_concat label " door-dark\n")) 1))))
    (let w (np-observe "witness " "https://pulse.coherencycoin.com/pulse/now"))
    (let i (np-observe "instance" "https://api.coherencycoin.com/api/pulse/now"))
    (add w i))
