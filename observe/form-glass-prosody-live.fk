; form-glass-prosody-live.fk — the prosody organ as a sensor of the living glass.
;
; The ear gives the glass WHAT was said. This process gives it HOW: seven axes
; measured off the same room, in the same shared sensor frame, at the same
; hundred-millisecond cadence, so the two arrive side by side and a reader never
; has to line up two clocks.
;
; It sleeps until it is wanted. While .hearth/prosody.wanted is absent it holds
; the mic closed, gives one row saying so, and costs a file-size read every four
; hundred milliseconds. When the marker appears it opens the mic once, and every
; frame it reads (3200 bytes, one hundred milliseconds of s16le mono 16 kHz)
; advances the organ's rolling window and gives a fresh reading. When the marker
; goes it closes the mic and forgets the window -- an organ that kept measuring a
; room nobody asked about would be a listening device, not a sense.
;
; The mic paces this loop: sense_mic_stream_read waits for its hundred
; milliseconds, so no sleep is needed while awake.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/room-prosody.bml form/form-stdlib/form-glass-sensor-rows.bml

(do
    (defn fgp-wanted () ".hearth/prosody.wanted")
    (defn fgp-awake? () (if (ge (file_size (fgp-wanted)) 0) 1 0))
    (defn fgp-asleep-rows ()
        (list (fgo-text "prosody" "prosody.state" "the prosody organ"
                        "asleep — write .hearth/prosody.wanted to wake it"
                        "organ" "physical-live" "room-prosody" "live" "voice"
                        "seven axes of how a thing was said; the mic opens only when it is wanted, and the window is forgotten while it sleeps")))
    (defn fgp-open (mic) (if (eq mic 1) 1 (do (let m (sense_mic_stream_start)) 1)))
    (defn fgp-close (mic) (if (eq mic 1) (do (let m (sense_mic_stream_stop)) 0) 0))
    (defn fgp-chunk () (do (let f (sense_mic_stream_read 3200 120)) (if (nothing? f) "" f)))
    (defn fgp-step (st mic)
        (do (let awake (fgp-awake?))
            (let mic1 (if (eq awake 1) (fgp-open mic) (fgp-close mic)))
            (let st1 (if (eq mic1 1) (rpr-advance st (fgp-chunk)) (rpr-state0)))
            (let now (now_unix_ms))
            (let rows (if (eq awake 1) (rpr-rows (rpr-reading st1)) (fgp-asleep-rows)))
            (let given (fgsr-give-at "prosody" now (fgo-observe-rows rows now 0) (RPRCadenceMs)))
            (let rested (if (eq awake 1) 0 (host_sleep_ms 400)))
            (fgp-step st1 mic1)))
    (fgp-step (rpr-state0) 0))
