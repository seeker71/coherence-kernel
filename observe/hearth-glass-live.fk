; hearth-glass-live.fk — the living glass: each second, take ONE sample
; of every data point (lane-motion's snap), append normalized events to
; the ledger, and fold a lane list through the generic terminal
; graphics engine. Every lane wears the age of its own source; motion
; and stillness both show as what they are. On its own source change
; the glass ends quietly and its supervisor loop reborns it warm —
; the ledger keeps the event, the panel just repaints.
; stdin line 1: number of ticks.
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/spool-bell-transport.fk
(do
    (defn hgl-ledger-add (kind detail)
        (sbt-append (hearth-ledger) (gl-ledger-line kind (now_unix_ms) detail)))
    (defn hgl-int (s name) (fmv-field s name))
    (defn hgl-word (s name) (gl-word-field s name))
    (defn hgl-age (path nowms) (sub nowms (mul (file_mtime path) 1000)))
    (defn hgl-board-mend (living)
        (do (let bt (hearth-board-read))
            (let nl (str_find bt (byte_to_str 10) 0))
            (let rest (substring bt (add nl 1) (str_len bt)))
            (let w (write_file_text (hearth-board) (str_concat (hearth-kv "pid" (int_to_str living)) rest)))
            (let e (hgl-ledger-add "board-mended" (str_concat "pid=" (int_to_str living))))
            living))
    (defn hgl-board-heal ()
        (do (let living (fmv-last-int (host-exec "pgrep -f form-cli-peer-contribution-live | head -1" "")))
            (if (gt living 0) (hgl-board-mend living) 0)))
    (defn hgl-take (xs n) (if (or (eq n 0) (eq (len xs) 0)) (empty) (cons (head xs) (hgl-take (tail xs) (sub n 1)))))
    (defn hgl-sources ()
        (str_concat (read_file "observe/hearth-glass-live.fk")
        (str_concat (read_file "form/form-stdlib/hearth-glass.bml")
        (str_concat (read_file "form/form-stdlib/hearth.bml")
        (str_concat (read_file "form/form-stdlib/lane-motion.bml")
                    (read_file "form/form-stdlib/term-graphics.bml"))))))
    (defn hgl-lanes (s tick spark kv-state sibwork age-board age-task age-reply age-out)
        (do (let lastms (hgl-int s "lastms"))
            (let kvpos (hgl-int s "kvpos"))
            (let kvpct (div (mul kvpos 100) (hearth-maxpos)))
            (let tpot (hgl-int s "tpot"))
            (list
                (tg-lane "HEARTH  pid=" (str_concat (hgl-word s "pid") (if (str_eq (hgl-word s "alive") "1") " standing" " DOWN")) (if (str_eq (hgl-word s "alive") "1") "plain" "bad") age-board)
                (tg-lane "tick    " (str_concat (int_to_str tick) (str_concat " " (tg-shade (add 1 (mod tick 4))))) "plain" (sub 0 1))
                (tg-lane "tasks   " (str_concat (hgl-word s "taskb") " bytes") "plain" age-task)
                (tg-lane "replies " (str_concat (hgl-word s "replyb") " bytes") "plain" age-reply)
                (tg-lane (str_concat (gl-sym-prefill) " prefills ") (hgl-word s "pf") "plain" age-out)
                (tg-lane (str_concat (gl-sym-decode) " checkpoints ") (hgl-word s "cp") "plain" age-out)
                (tg-lane "last-serve " (str_concat (tg-dur lastms) (str_concat " " (tg-ramp (div lastms 1000)))) (tg-scale lastms (hearth-lat-lo) (hearth-lat-hi)) age-reply)
                (tg-lane "hopper  " (str_concat "waiting=" (hgl-word s "hopper")) "plain" age-task)
                (tg-lane "kv-fill " (str_concat (tg-bar (div (add kvpct 5) 10) 10) (str_concat " " (str_concat (int_to_str kvpct) (str_concat "% pos=" (int_to_str kvpos))))) (tg-scale kvpct (hearth-fill-lo) (hearth-fill-hi)) age-reply)
                (tg-lane "tpot/tok " (tg-dur tpot) (tg-scale tpot (hearth-lat-lo) (hearth-lat-hi)) age-reply)
                (tg-lane "direct  " (str_concat (hgl-word s "direct") (str_concat " " (tg-dur (hgl-int s "directage")))) (if (str_eq (hgl-word s "direct") "none") "plain" (tg-scale (hgl-int s "directage") (hearth-lat-lo) (hearth-lat-hi))) age-out)
                (tg-lane "e2e p50/p95 " (str_concat (tg-dur (hgl-int s "p50")) (str_concat "/" (tg-dur (hgl-int s "p95")))) "plain" age-reply)
                (tg-lane "flight  " (str_concat "waiting:" (str_concat (hgl-word s "waiting") (str_concat "  served:" (hgl-word s "served")))) "plain" age-task)
                (tg-lane "phase   " (gl-phase-line (hgl-int s "gas") (hgl-int s "water") (hgl-int s "ice")) "plain" (sub 0 1))
                (tg-lane "signal  " (str_concat (hgl-word s "sig") (str_concat "  choice=" (str_concat (hgl-word s "choices") (str_concat " fail=" (str_concat (hgl-word s "fails") (str_concat " timeout=" (hgl-word s "touts"))))))) "plain" age-reply)
                (tg-lane "kv      " (str_concat (if (str_eq kv-state "") "-" kv-state) (str_concat "  ice-miss=" (str_concat (hgl-word s "icemiss") " (silence is hit)"))) "plain" age-reply)
                (tg-lane "field   " (str_concat "sibling-fkwu=" (str_concat (hgl-word s "siblings") (str_concat "  last-land=" (hgl-word s "lastland")))) "plain" (sub 0 1))
                (tg-lane "doing   " sibwork "dim" (sub 0 1))
                (tg-lane (str_concat (gl-sym-decode) " flow ") (tg-spark spark) "plain" (sub 0 1))
                (tg-lane (str_concat (gl-sym-served) " ledger ") (hearth-ledger) "plain" (sub 0 1)))))
    (defn hgl-tick (n tick prev-task prev-reply prev-pf prev-cp spark birth-src prev-alive)
        (if (not (str_eq (hgl-sources) birth-src))
            (do (let e (hgl-ledger-add "glass-reborn" "source-changed"))
                0)
        (if (gt tick n) 0
            (do
                (let s (lms-snap))
                (let pid0 (hgl-int s "pid"))
                (let alive0 (hgl-int s "alive"))
                (let mended (if (eq alive0 0) (hgl-board-heal) 0))
                (let alive (if (gt mended 0) 1 alive0))
                (let taskb (hgl-int s "taskb"))
                (let replyb (hgl-int s "replyb"))
                (let pf (hgl-int s "pf"))
                (let cp (hgl-int s "cp"))
                (let nowms (now_unix_ms))
                (let kv-state (if (gt replyb prev-reply) (if (gt pf prev-pf) "miss" "hit") ""))
                (let e5 (if (str_eq kv-state "") 0 (hgl-ledger-add "kv" kv-state)))
                (let e1 (if (gt pf prev-pf) (hgl-ledger-add "prefill" (str_concat "count=" (int_to_str pf))) 0))
                (let e2 (if (gt taskb prev-task) (hgl-ledger-add "request" (str_concat "task-bytes=" (int_to_str taskb))) 0))
                (let e3 (if (gt replyb prev-reply) (hgl-ledger-add "reply" (str_concat "elapsed-ms=" (int_to_str (hgl-int s "lastms")))) 0))
                (let e4 (if (eq alive 0) (if (eq prev-alive 1) (hgl-ledger-add "restart-needed" "pid-down") 0) 0))
                (let sibwork (host-exec "pgrep -fl 'fkwu ' | grep -v hearth-glass | awk '{printf \"%s %s; \", $1, $NF}' | head -c 170" ""))
                (let spark2 (hgl-take (cons (sub cp prev-cp) spark) 12))
                (let put (print_str (tg-frame (hgl-lanes s tick spark2 kv-state sibwork
                    (hgl-age (hearth-board) nowms) (hgl-age (hearth-task) nowms)
                    (hgl-age (hearth-reply) nowms) (hgl-age (hearth-out) nowms)))))
                (let z (host-exec "sleep 1" ""))
                (hgl-tick n (add tick 1) taskb replyb pf cp spark2 birth-src alive)))))
    (let n (str_to_int (read_line)))
    (let born (hgl-ledger-add "glass-on" (str_concat "ticks=" (int_to_str n))))
    (hgl-tick n 1 0 0 0 0 (list 0) (hgl-sources) 1))
