; hearth-glass-live.fk — the living glass: each second, diff the hearth's
; durable sources, APPEND normalized events to the ledger (restart,
; prefill, request, reply, checkpoint), and repaint one ANSI frame
; through the framebuffer voice. Phases longer than a second appear as
; shade ramps of one-second steps; latency wears its color; the organs
; wear their symbols.
; stdin line 1: number of ticks.
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/spool-bell-transport.fk
(do
    (defn hgl-count (text needle) (hgl-count-go text needle 0 0))
    (defn hgl-count-go (text needle from acc)
        (do (let at (str_find text needle from))
            (if (lt at 0) acc (hgl-count-go text needle (add at (str_len needle)) (add acc 1)))))
    (defn hgl-ledger-add (kind detail)
        (sbt-append ".hearth/ledger" (gl-ledger-line kind (now_unix_ms) detail)))
    (defn hgl-frame (pid alive taskb replyb pf cp lastms spark tick waits kvpct kvpos tpot lats waiting-list servedn s-gas s-water s-ice sig choices fails touts ice-miss kv-state siblings lastland)
        (str_concat (gl-home)
        (str_concat (gl-line "HEARTH  pid=" (str_concat (int_to_str pid) (if (eq alive 1) " standing" " DOWN")))
        (str_concat (gl-line "tick    " (int_to_str tick))
        (str_concat (gl-line "tasks   " (str_concat (int_to_str taskb) " bytes"))
        (str_concat (gl-line "replies " (str_concat (int_to_str replyb) " bytes"))
        (str_concat (gl-line (str_concat (gl-sym-prefill) " prefills ") (int_to_str pf))
        (str_concat (gl-line (str_concat (gl-sym-decode) " checkpoints ") (int_to_str cp))
        (str_concat (gl-lat-line "last-serve " lastms)
        (str_concat (gl-line "hopper  " (str_concat "waiting=" (int_to_str waits)))
        (str_concat (gl-line "kv-fill " (str_concat (gl-pct-color kvpct) (str_concat (gl-gauge kvpct) (str_concat " " (str_concat (int_to_str kvpct) (str_concat "% pos=" (str_concat (int_to_str kvpos) (gl-reset))))))))
        (str_concat (gl-lat-line "tpot/tok " tpot)
        (str_concat (gl-line "e2e p50/p95 " (str_concat (int_to_str (gl-pct lats 50)) (str_concat "/" (str_concat (int_to_str (gl-pct lats 95)) "ms"))))
        (str_concat (gl-line "flight  " (str_concat "waiting:" (str_concat (gl-turns-line waiting-list) (str_concat "  served:" (int_to_str servedn)))))
        (str_concat (gl-line "phase   " (str_concat (gl-phase-line s-gas s-water s-ice) (str_concat "  requests: q=" (str_concat (int_to_str (len waiting-list)) (str_concat " served=" (int_to_str servedn))))))
        (str_concat (gl-line "signal  " (str_concat sig (str_concat "  choice=" (str_concat (int_to_str choices) (str_concat " fail=" (str_concat (int_to_str fails) (str_concat " timeout=" (int_to_str touts))))))))
        (str_concat (gl-line "kv      " (str_concat (if (str_eq kv-state "") "-" kv-state) (str_concat "  ice-miss=" (str_concat (int_to_str ice-miss) " (silence is hit)"))))
        (str_concat (gl-line "field   " (str_concat "sibling-fkwu=" (str_concat (int_to_str siblings) (str_concat "  last-land=" lastland))))
        (str_concat (gl-line (str_concat (gl-sym-decode) " flow ") (gl-spark spark))
        (gl-line (str_concat (gl-sym-served) " ledger ") ".hearth/ledger")))))))))))))))))))) 
    (defn hgl-take (xs n) (if (or (eq n 0) (eq (len xs) 0)) (empty) (cons (head xs) (hgl-take (tail xs) (sub n 1)))))
    (defn hgl-sources ()
        (str_concat (read_file "observe/hearth-glass-live.fk")
            (str_concat (read_file "form/form-stdlib/hearth-glass.bml")
                (read_file "form/form-stdlib/hearth.bml"))))
    (defn hgl-census ()
        (host-exec "printf 'ice=%s water=%s src=%s' \"$(find . -name '*.fkb' -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . -name '*.fkb' -mmin -60 -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . \\( -name '*.fk' -o -name '*.bml' \\) -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\""))
    (defn hgl-tick (n tick prev-task prev-reply prev-pf prev-cp spark birth-src census)
        (if (not (str_eq (hgl-sources) birth-src))
            (do (let e (hgl-ledger-add "glass-reborn" "source-changed"))
                (print_str (str_concat (gl-nl) "glass source changed - stepping down for rebirth"))
                0)
        (if (gt tick n) 0
            (do
                (let out (read_file ".hearth/server.out"))
                (let pf (hgl-count out "prefill-complete"))
                (let cp (hgl-count out "decode-checkpoint"))
                (let taskb (file_size ".hearth/task.spool"))
                (let replyb (file_size ".hearth/reply.spool"))
                (let pid (hearth-board-pid))
                (let alive (hearth-alive pid))
                (let rsp (read_file ".hearth/reply.spool"))
                (let lastms (fmv-field rsp "elapsed-ms"))
                (let waits (sub (hgl-count (read_file ".hearth/task.spool") "turn=") (hgl-count rsp "turn=")))
                (let kvpos (gl-newest (gl-collect rsp "pos")))
                (let kvpct (div (mul kvpos 100) 4096))
                (let lats (gl-collect rsp "elapsed-ms"))
                (let toks (gl-newest (gl-collect rsp "tokens")))
                (let tpot (if (gt toks 0) (div lastms toks) 0))
                (let task-text (read_file ".hearth/task.spool"))
                (let waiting-list (gl-waiting-turns (gl-collect task-text "turn") (gl-collect rsp "turn")))
                (let servedn (hgl-count rsp "turn="))
                (let census2 (if (eq (mod tick 10) 1) (hgl-census) census))
                (let s-ice (fmv-field census2 "ice"))
                (let s-water (fmv-field census2 "water"))
                (let s-src (fmv-field census2 "src"))
                (let s-gas (sub s-src s-ice))
                (let sig (gl-word-field rsp "signal"))
                (let fails (gl-count-of rsp "error=1"))
                (let choices (gl-count-of rsp "signal=choice"))
                (let touts (gl-count-of out "decode-timeout"))
                (let ice-miss (add (gl-count-of out "rebuilding from source") (gl-count-of out "stale .fkb")))
                (let kv-state (if (gt replyb prev-reply) (if (gt pf prev-pf) "miss" "hit") ""))
                (let e5 (if (str_eq kv-state "") 0 (hgl-ledger-add "kv" kv-state)))
                (let e6 (if (gt fails 0) (hgl-ledger-add "fail" (int_to_str fails)) 0))
                (let siblings (sub (gl-count-of (host-exec "pgrep -fl fkwu") "fkwu") 1))
                (let lastland (gl-word-field (host-exec "git log -1 --format=who=%an-%ar main") "who"))
                (let e1 (if (gt pf prev-pf) (hgl-ledger-add "prefill" (str_concat "count=" (int_to_str pf))) 0))
                (let e2 (if (gt taskb prev-task) (hgl-ledger-add "request" (str_concat "task-bytes=" (int_to_str taskb))) 0))
                (let e3 (if (gt replyb prev-reply) (hgl-ledger-add "reply" (str_concat "elapsed-ms=" (int_to_str lastms))) 0))
                (let e4 (if (eq alive 0) (hgl-ledger-add "restart-needed" "pid-down") 0))
                (let spark2 (hgl-take (cons (sub cp prev-cp) spark) 12))
                (let put (print_str (hgl-frame pid alive taskb replyb pf cp (if (lt lastms 0) 0 lastms) spark2 tick waits kvpct kvpos tpot lats waiting-list servedn s-gas s-water s-ice sig choices fails touts ice-miss kv-state siblings lastland)))
                (let z (host-exec "sleep 1"))
                (hgl-tick n (add tick 1) taskb replyb pf cp spark2 birth-src census2)))))
    (let n (str_to_int (read_line)))
    (let born (hgl-ledger-add "glass-on" (str_concat "ticks=" (int_to_str n))))
    (hgl-tick n 1 0 0 0 0 (list 0) (hgl-sources) ""))
