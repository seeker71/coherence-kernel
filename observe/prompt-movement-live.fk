; prompt-movement-live.fk — a raw natural-language prompt runs through the
; body: the resident local model receives the prompt and a door menu,
; chooses; each chosen door RUNS natively in this process; its telemetry
; re-enters the next turn; on LAND the model composes the closing report
; itself. The rented mind's role collapses to staging the prompt and
; reading this stream — the 10-percent goal's real door, flow-steer's
; proven shape widened from one choice to a steered movement.
;
; stdin line 1: path to the staged prompt text.
;
; preludes: observe/qwen38-bmf-mechanism.fk form-stdlib/form-cli-movement.bml

(do
    (defn pml-rows ()
        (list
            (fmv-row "gate/tests/structural-gate-band.fk" 8191)
            (fmv-row "form/form-stdlib/tests/nodeid-interning-band.fk" 127)
            (fmv-row "form/form-stdlib/tests/form-cli-rest-answer-bml-band.fk" 15)
            (fmv-row "form/form-stdlib/tests/form-cli-rest-force-bml-band.fk" 31)
            (fmv-row "form/form-stdlib/tests/form-cli-offer-ask-bml-band.fk" 65535)
            (fmv-row "form/form-stdlib/tests/form-cli-author-altitude-band.fk" 783)))
    (defn pml-door (n)
        (if (eq n 1)
            (str_concat "[door1] six-band walk agreement bits="
                (int_to_str (fmv-whole (pml-rows))))
        (if (eq n 2)
            (str_concat "[door2] census-sources="
                (int_to_str (fmv-ask-field "form/form-stdlib/form-knowledge-integration-census-run.fk" "census-sources")))
        (if (eq n 3)
            (str_concat "[door3] corpus-reach="
                (str_concat (int_to_str (fmv-ask-field "observe/native-reach-run.fk" "corpus-reach"))
                (str_concat " miss=" (int_to_str (fmv-ask-field "observe/native-reach-run.fk" "corpus-miss")))))
        (if (eq n 4)
            (str_concat "[door4] pictures="
                (str_concat (int_to_str (fmv-ask-field "observe/authoring-altitude-run.fk" "pictures"))
                (str_concat " bound-cells=" (int_to_str (fmv-ask-field "observe/authoring-altitude-run.fk" "bound-cells")))))
            "[door-none] no such door")))))
    (defn pml-turn-prompt (prompt gathered)
        (str_concat (str_concat "You are this body steering its own work. The task, verbatim from the human:" (pm-nl))
        (str_concat prompt
        (str_concat (str_concat (pm-nl) (str_concat "What you have measured so far this movement:" (pm-nl)))
        (str_concat (if (str_eq gathered "") (str_concat "nothing yet" (pm-nl)) gathered)
        (str_concat (str_concat (pm-nl) (str_concat "Choose exactly ONE door. Answer with the door number first, one short reason after." (pm-nl)))
                    (pm-menu)))))))
    (defn pml-loop (session prompt gathered step)
        (if (gt step 5)
            (list gathered session)
            (do
                (let t0 (now_unix_ms))
                (let g (qbl-gen session (pml-turn-prompt prompt gathered) 90))
                (let t1 (now_unix_ms))
                (let choice (pm-parse (nth g 0)))
                (let s1 (qbl-say (str_concat "=== step " (str_concat (int_to_str step)
                    (str_concat " model chose door " (str_concat (int_to_str choice)
                    (str_concat " turn_ms=" (int_to_str (sub t1 t0)))))))))
                (let s2 (qbl-say (nth g 0)))
                (if (eq choice 5)
                    (list gathered (nth g 1))
                    (do
                        (let t2 (now_unix_ms))
                        (let out (pml-door choice))
                        (let t3 (now_unix_ms))
                        (let s3 (qbl-say (str_concat "[executed] " (str_concat out
                            (str_concat " door_ms=" (int_to_str (sub t3 t2)))))))
                        (pml-loop (nth g 1) prompt
                            (str_concat gathered (str_concat out (pm-nl)))
                            (add step 1)))))))
    (let prompt-path (read_line))
    (let prompt (read_file prompt-path))
    (let s0 (qbl-say "=== prompt-movement: the body takes the prompt ==="))
    (let walked (pml-loop (fcmr-none) prompt "" 1))
    (let closing-prompt (str_concat (str_concat "The task, verbatim from the human:" (pm-nl))
        (str_concat prompt
        (str_concat (str_concat (pm-nl) (str_concat "Every measurement this movement gathered:" (pm-nl)))
        (str_concat (nth walked 0)
        (str_concat (pm-nl) "Compose the closing floor report yourself: state how far the floor moved toward the north star, in this body plain honest voice, five sentences at most."))))))
    (let gfinal (qbl-gen (nth walked 1) closing-prompt 220))
    (let s4 (qbl-say "=== the body's own closing report ==="))
    (let s5 (qbl-say (nth gfinal 0)))
    (let rel (fcmr-release-ok? (nth gfinal 1)))
    (let s6 (qbl-say (str_concat "residence_released=" (int_to_str rel))))
    0)
