// alignment-echo-run.bml — what the grounded door scores with no voice: the floor beside any grounded reading (docs/grounded-voice-door.md).
//
// No model. Writes three answer files under .hearth/alignment-echo/ from what the door retrieves for each ask of a set:
// whole pastes the ground, paths lists the offered paths, first names only the top path. Each is graded by the reader's
// own answers lane, which lands no ledger row:
//   printf '{"answers":".hearth/alignment-echo/paths.jsonl","fixtures":"model/fixtures/alignment/scenarios-5.jsonl"}' | ./fkwu observe/alignment-read-run.bml
// stdin, optional: the fixtures path.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/ledger.bml observe/companion-packet.bml
section [form.bml] {
 blueprint AlignmentEchoScenario { id: string, tongue: string, person_says: string, context: string, predicates: list<string> }
 class AlignmentEcho {
  def ae-home() = ".hearth/alignment-echo";
  def ae-paths(index, said) = cp-door-named?(said) ? map(r => r[1], cp-door-rows(index, said)) : [];
  def ae-file(arm, rows, f) {
   let lines = map(s => json-emit(json-node-object([fhn-s("id", row-get(s, "id")), fhn-s("answer", f(row-get(s, "person_says")))])), rows);
   write_file_text(ae-home() ++ "/" ++ arm ++ ".jsonl", str-join-with(lines, "\n") ++ "\n");
  }
  def ae-go() {
   let l = read_line();
   let fixtures = nothing?(l) || (Comparable) len(trim(l)) == 0 ? "model/fixtures/alignment/scenarios-5.jsonl" : trim(l);
   let rows = ledger-rows(fixtures, "AlignmentEchoScenario");
   let index = cp-door-index();
   let made = fs_mkdir(ae-home());
   let a = ae-file("whole", rows, said => cp-door-ground-in(index, said));
   let b = ae-file("paths", rows, said => str-join-with(ae-paths(index, said), " "));
   let c = ae-file("first", rows, said => str-join-with(take(1, ae-paths(index, said)), " "));
   print_str("[alignment-echo] asks=" ++ len(rows).str() ++ " carrying=" ++ len(filter(s => cp-door-named?(row-get(s, "person_says")), rows)).str() ++ " home=" ++ ae-home());
  }
 }
 ae-go();
}
