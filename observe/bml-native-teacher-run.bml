// preflight-exec: forbidden
// JSON stdin: home, condition, model, context_capacity. Proposals await inspection/execution.
// preludes: learn/bml-native-teacher.bml
section [form.bml] {
 def bnt-run(raw) {
  let request = parse-json("BML teacher request",raw);
  bnt-generate(nsm-str(request,"home"),nsm-str(request,"condition"),nsm-str(request,"model"),nsm-num(request,"context_capacity"));
 }
 bnt-run(read_line());
 0;
}
