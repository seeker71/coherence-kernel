// Observe real directory admission and failure through the structural gate.
// Owned temporary permissions are restored before cleanup or the final verdict.
// preflight-exec: forbidden
// preludes: gate/structural-gate.fk
section [form.bml] {
 class StructuralSourceWitness {
  def sgw-write(path,text) = eq(write_file(path,text),str_len(text));
  def sgw-probe(job,name,root) {
   let source = nsi-path(job,str_concat(name,".bml"));
   let quoted = json-emit-precise(json-node-string(root));
   let text = str_concat("// preludes: gate/structural-gate.fk\nsection [form.bml] {\n sg-audit(",str_concat(quoted,");\n}\n"));
   if not(sgw-write(source,text)) then form_error("structural directory witness source write refused") else nsi-capture(list("./fkwu",source));
  }
  def sgw-refused(capture) = and(ne(nsi-status(capture),0),gt(file_size(nsi-path(nsi-evidence(capture),"stderr")),0));
  def sgw-row(name,accepted,evidence) {
   let row = oh-reading("structural-source-reader","owned-directory-witness",name,json-node-int(1),json-node-int(accepted),json-node-int(accepted),if accepted then list() else list(oh-need("directory-admission-evidence",evidence)),list("request-evidence","defer"),evidence);
   oh-voice(row);
   accepted;
  }
  def sgw-run() {
   let job = nsi-directory(".hearth","structural-reader-witness-",0);
   let emptyRoot = nsi-path(job,"empty");
   let locked = nsi-path(job,"denied");
   let tree = nsi-path(job,"tree");
   let tests = nsi-path(tree,"tests");
   let ignored = nsi-path(tree,".git");
   let made = nsi-command(list("/bin/mkdir","-p",emptyRoot,locked,tests,ignored));
   let plain = nsi-path(job,"plain");
   let wrote = and(sgw-write(plain,"ordinary file"),and(sgw-write(nsi-path(locked,"unclassified.py"),"specimen"),and(sgw-write(nsi-path(tests,"line\nbreak.py"),"specimen"),sgw-write(nsi-path(ignored,"hidden.py"),"specimen"))));
   let emptyRead = sgw-probe(job,"empty-read",emptyRoot);
   let missingRead = sgw-probe(job,"missing-read",nsi-path(job,"absent"));
   let fileRead = sgw-probe(job,"file-read",plain);
   let held = nsi-command(list("/bin/chmod","000",locked));
   let deniedTraversal = sga-capture(locked,sg-git-dir(),sg-claude-dir());
   let directoryStands = fs_is_dir(locked);
   let deniedRead = sgw-probe(job,"denied-read",locked);
   let restored = nsi-command(list("/bin/chmod","700",locked));
   let treeRead = sgw-probe(job,"tree-read",tree);
   let emptyOkay = and(eq(nsi-status(emptyRead),0),str_eq(trim(nsi-text(emptyRead)),"[0, 0, 0, 0, 0, 0, 0]"));
   let treeOkay = and(eq(nsi-status(treeRead),0),str_eq(trim(nsi-text(treeRead)),"[1, 0, 0, 0, 0, 0, 1]"));
   let deniedOkay = and(eq(held,0),and(directoryStands,and(ne(nsi-status(deniedTraversal),0),sgw-refused(deniedRead))));
   let checks = list(sgw-row("valid-empty-directory",emptyOkay,oh-reference(nsi-evidence(emptyRead))),sgw-row("missing-directory-refused",sgw-refused(missingRead),oh-reference(nsi-evidence(missingRead))),sgw-row("file-is-not-a-directory",sgw-refused(fileRead),oh-reference(nsi-evidence(fileRead))),sgw-row("unreadable-directory-refused",deniedOkay,oh-reference(nsi-evidence(deniedTraversal))),sgw-row("nul-filename-and-pruned-history",treeOkay,oh-reference(nsi-evidence(treeRead))));
   let removed = if eq(restored,0) then nsi-command(list("/bin/rm","-rf",job)) else -1;
   let released = and(eq(removed,0),not(fs_is_dir(job)));
   let okay = and(and(eq(made,0),wrote),and(eq(restored,0),and(released,sgw-all(checks))));
   sgw-row("owned-permissions-restored-and-tree-released",released,oh-reference(job));
   if okay then 1 else form_error("structural source directory witness refused");
  }
  def sgw-all(values) = if nil?(values) then 1 else and(head(values),sgw-all(tail(values)));
 }
 sgw-run();
}
