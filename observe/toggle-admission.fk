; toggle-admission.fk — change is what admits a sensor. Without it, trust waits outside.
;
; Urs, 2026-07-22 22:20, after an evening in which six readings misled in six different
; ways: "only trust a sensor that is allowed to change, so, change is required to enter
; otherwise trust is left at the door."
;
; This is the runnable form of that. It is not a correctness test — a stuck sensor may be
; reporting the truth, and this cell never claims otherwise. It is an ADMISSION test, and
; the thing it settles is narrower and more useful: whether a reading carries information
; at all. A value that has never been observed to vary distinguishes nothing, so no amount
; of it adds up to evidence. Silicon verification has practiced this for decades under the
; name TOGGLE COVERAGE: a signal counts as covered only when it has been seen in both
; states, and a line that never toggles is untested however right its constant looks.
;
; Two things admit a sensor, and both are required:
;   TOGGLED — at least two distinct values in the window. The sensor CAN move.
;   FRESH   — that demonstration is inside the horizon. It moved recently enough that the
;             demonstration still stands. (The freshness half is belief-freshness.fk's
;             discipline applied to instruments instead of beliefs: a proven thing is
;             proven for now, and only for now.)
;
; An unadmitted sensor reads -1. That is a THIRD value, and it is worth keeping distinct
; from the other two it could be confused with:
;   -1 here does NOT mean "no signal"   (that would be a witnessed absence)
;   -1 here does NOT mean "the value is false" (it may well be true)
;   -1 here means "this instrument has not shown it can move, so its reading is not
;                  admissible as evidence" — trust left at the door, per the source.
;
; The companion half, learned the same night: admission is a property of the SENSOR, and
; never of a sample. A sensor admitted precisely BECAUSE it changes is a sensor whose old
; sample has already expired — toggling earns entry and forfeits shelf life in the same
; stroke. ta-sample-stands? is that half made checkable, and bit 512 of the band is it
; demonstrated: the SemaCompanion binary is admitted AND its 21:29 reading no longer
; stands at 21:44. This paragraph carried an imperative until 22:25, which is how it was
; found — the sentence was ordering the reader to do what the cell could not yet show.
;
; preludes: form-stdlib/core.fk

(do
    ; --- distinct values in a window ---
    (defn ta-contains (xs v)
        (if (eq (len xs) 0) 0
            (if (eq (head xs) v) 1 (ta-contains (tail xs) v))))
    (defn ta-distinct (xs)
        (if (eq (len xs) 0) 0
            (add (if (eq (ta-contains (tail xs) (head xs)) 1) 0 1)
                 (ta-distinct (tail xs)))))

    ; --- TOGGLED: the sensor has been seen to move ---
    (defn ta-toggled? (xs) (if (ge (ta-distinct xs) 2) 1 0))

    ; --- FRESH: the demonstration still stands, ages in the caller's own unit ---
    (defn ta-fresh? (age horizon) (if (le age horizon) 1 0))

    ; --- ADMITTED: both, or neither ---
    (defn ta-admitted? (xs age horizon)
        (if (eq (ta-toggled? xs) 1) (ta-fresh? age horizon) 0))

    ; --- the reading, and the door ---
    (defn ta-read (xs value age horizon)
        (if (eq (ta-admitted? xs age horizon) 1) value (sub 0 1)))

    ; --- the companion half, checkable: admission is the INSTRUMENT's, and buys no shelf
    ; life for anything it already produced. A sample stands only while it is younger than
    ; the horizon the caller is willing to act on. Separate from ta-fresh?, which ages the
    ; sensor's CREDENTIAL; this ages the SAMPLE. ---
    (defn ta-sample-stands? (sample-age horizon) (if (le sample-age horizon) 1 0))

    ; why a sensor was turned away — so the caller can say WHICH, not merely that
    (defn ta-why (xs age horizon)
        (if (eq (ta-toggled? xs) 0) 1                      ; 1 = never seen to move
            (if (eq (ta-fresh? age horizon) 0) 2 0)))      ; 2 = moved, but long ago

    ; --- witnessed windows from the evening this cell came from ---
    ; the mac ear, pitch in Hz over ~45 s — many values, seconds old
    (defn ta-ear ()   (list 187 164 169 187 164 169 178 168))
    ; the phone's media playhead, ms, sampled at 20:59:14 / :40 / :48
    (defn ta-playhead () (list 814 814 814))
    ; the phone's step counter — it moved at 16:40 and has not moved since
    (defn ta-steps () (list 33283 33952 34458 35020 35385 36340))
    ; the SemaCompanion binary, bytes, read at 21:29 and again at 21:44
    (defn ta-binary () (list 1337200 1350064))

    ; --- self-check ---
    (defn tak (cond bit) (if cond bit 0))
    (defn ta-ear-distinct () (tak (eq (ta-distinct (ta-ear)) 5) 1))
    (defn ta-ear-in ()       (tak (eq (ta-read (ta-ear) 168 5 300) 168) 2))
    (defn ta-play-flat ()    (tak (eq (ta-distinct (ta-playhead)) 1) 4))
    (defn ta-play-out ()     (tak (eq (ta-read (ta-playhead) 814 34 300) (sub 0 1)) 8))
    (defn ta-play-why ()     (tak (eq (ta-why (ta-playhead) 34 300) 1) 16))
    ; the step counter DID move — but five hours ago, so it is turned away for age, not
    ; for stillness, and the two reasons stay different numbers
    (defn ta-steps-moved ()  (tak (eq (ta-toggled? (ta-steps)) 1) 32))
    (defn ta-steps-out ()    (tak (eq (ta-read (ta-steps) 36340 18000 300) (sub 0 1)) 64))
    (defn ta-steps-why ()    (tak (eq (ta-why (ta-steps) 18000 300) 2) 128))
    (defn ta-binary-in ()    (tak (eq (ta-read (ta-binary) 1350064 60 300) 1350064) 256))
    ; and the companion half: that same admitted binary's 21:29 sample, 900 s old by 21:44,
    ; does NOT stand at a 60 s horizon. Admitted instrument, expired sample, both at once.
    (defn ta-binary-stale ()
        (tak (and (eq (ta-admitted? (ta-binary) 60 300) 1)
                  (eq (ta-sample-stands? 900 60) 0)) 512))
    (defn toggle-admission-check ()
        (add (add (add (ta-ear-distinct) (ta-ear-in)) (add (ta-play-flat) (ta-play-out)))
        (add (add (add (ta-play-why) (ta-steps-moved)) (add (ta-steps-out) (ta-steps-why)))
             (add (ta-binary-in) (ta-binary-stale)))))
)
