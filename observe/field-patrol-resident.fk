; field-patrol-resident.fk — observe over and over to find missing
; stones: each beat sweeps every living fkwu walker (CPU seconds and
; cell name), and any interpreted burn past the patrol threshold that
; is NOT already in the stones ledger is appended ONCE — a missing
; stone named by the field itself, deduplicated by name so the ledger
; is a worklist, not a scream. The counsel's worst lane joins the same
; ledger on transition to bad. The glass shows the newest stone.
; stdin line 1: number of beats (one beat ~20s).
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
(do
    (defn fpr-stones () ".hearth/stones")
    (defn fpr-threshold-s () 60)
    (defn fpr-census-cmd ()
        "pgrep -f 'fkwu ' | while read p; do t=$(ps -o cputime= -p $p | tr -d ' '); n=$(ps -o command= -p $p | awk '{print $2}'); [ -n \"$t\" ] && echo \"$t $n\" | awk -F'[: ]' '{if (NF>=4) print ($1*3600)+($2*60)+$3, $4; else print ($1*60)+$2, $3}'; done 2>/dev/null")
    (defn fpr-read (path) (do (let t (read_file path)) (if (nothing? t) "" t)))
    (defn fpr-known? (ledger name) (if (ge (str_find ledger name 0) 0) 1 0))
    (defn fpr-add (kind name detail)
        (sbt-append (fpr-stones)
            (str_concat "t=" (str_concat (int_to_str (now_unix_ms))
                (str_concat " stone=" (str_concat kind
                    (str_concat " name=" (str_concat name
                        (str_concat " " (str_concat detail (byte_to_str 10)))))))))))
    (defn fpr-walk-lines (text ledger from found)
        (do (let nl (str_find text (byte_to_str 10) from))
            (if (lt nl 0) found
                (do (let secs (fmv-field-int text from 0 0))
                    (let sp (str_find text " " from))
                    (let name (if (and (ge sp 0) (lt sp nl)) (substring text (add sp 1) nl) ""))
                    (let hit (if (and (ge secs (fpr-threshold-s)) (gt (str_len name) 0))
                        (if (eq (fpr-known? ledger name) 0)
                            (do (let a (fpr-add "long-walker" name (str_concat "cpu-s=" (int_to_str secs)))) 1)
                            0) 0))
                    (fpr-walk-lines text ledger (add nl 1) (add found hit))))))
    (defn fpr-beat (n tick)
        (if (gt tick n) 0
            (do
                (let census (host-exec (fpr-census-cmd) ""))
                (let ledger (fpr-read (fpr-stones)))
                (let found (fpr-walk-lines census ledger 0 0))
                (let z (host-exec "sleep 20" ""))
                (fpr-beat n (add tick 1)))))
    (let n (str_to_int (read_line)))
    (let born (fpr-add "patrol-on" "field-patrol" (str_concat "beats=" (int_to_str n))))
    (fpr-beat n 1))
