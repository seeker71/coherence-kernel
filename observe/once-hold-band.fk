; once-hold-band.fk — a top-level let binds a VALUE, not a recipe for one.
; Witnessed 2026-09-02 before the heal: fkwu spliced the initializer node
; into every reference (call-by-name — "built" printed three times, the Go
; arm printed once, and one cold .bml compile paid 31.6M dispatches
; rebuilding the bp table per lookup). The once-hold (tag 190) gives every
; reference one shared hold node whose first read computes and holds.
;
; A child kernel runs observe/once-hold-child.fk in a scratch cwd; its
; .fkwu-heat is the build counter (tick dispatches 150001 per build), read
; with the same lms-heat readers the glass wears.
;
; bits (power-of-two weights):
;    1  child run exits 0
;    2  child's answer is 21 (three reads of the held list still read 7)
;    4  heat carries exactly "150001 tick" — ONE build
;    8  the old triple-build count 450003 is absent
;   16  lms-heat-max names tick the hottest
; Verdict 31.
; PROOF LEVEL: FKWU-ONLY — this band witnesses fkwu's own hold; the Go
; arm already builds once (witnessed by cost, 2026-09-02).
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
(do
    (let d (str_concat "/tmp/fkwu-once-hold-band-" (int_to_str (now_unix_ms))))
    (let cmd (str_concat "mkdir -p " (str_concat d (str_concat " && cd " (str_concat d " && \"$OLDPWD/fkwu\" \"$OLDPWD/observe/once-hold-child.fk\" 2>/dev/null; echo rc=$?")))))
    (let out (host-exec cmd ""))
    (let heat (lms-heat-of (read_file (str_concat d "/.fkwu-heat"))))
    (let hm (lms-heat-max heat))
    (let b1 (if (str_eq (gl-word-field out "rc") "0") 1 0))
    (let b2 (if (ge (str_find out (str_concat "21" (byte_to_str 10)) 0) 0) 2 0))
    (let b4 (if (ge (str_find heat "150001 tick" 0) 0) 4 0))
    (let b8 (if (lt (str_find heat "450003" 0) 0) 8 0))
    (let b16 (if (str_eq (nth hm 1) "tick") 16 0))
    (let sweep (host-exec (str_concat "rm -rf " d) ""))
    (add b1 (add b2 (add b4 (add b8 b16)))))
