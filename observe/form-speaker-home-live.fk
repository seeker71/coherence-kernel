; form-speaker-home-live.fk — local Qwen speaks through the planner speaker.
; fcmg-teach is the speaker prompt. fqt-lora? stays 0. Not a sealed row.
;
; preludes: form-stdlib/form-cli-model-generate.fk
; preludes: form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-planner-mint-xtal.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk
; preludes: form-stdlib/form-cli-speaker-home-xtal.fk

(do
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let pair (flw-from-sample (fspk-fuel) (fqt-dim)))
    (let _w (flw-write (flw-path) (nth pair 0) (nth pair 1)))
    (let prompt "Reply with exactly: GROUND WALK TOOL HOME")
    (let t0 (now_unix_ms))
    (let out (fcmg-generate path prompt 24))
    (let t1 (now_unix_ms))
    (print_str (str_concat "speaker_wall_ms=" (str_concat (int_to_str (sub t1 t0)) "\n")))
    (print_str (str_concat "speaker_home=" (str_concat (int_to_str (fspk-home)) "\n")))
    (print_str (str_concat "speaker_lora_flag=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "speaker_has_GROUND="
        (str_concat (int_to_str (if (ge (str_find out "GROUND" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "speaker_has_WALK="
        (str_concat (int_to_str (if (ge (str_find out "WALK" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "speaker_has_TOOL="
        (str_concat (int_to_str (if (ge (str_find out "TOOL" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "speaker_has_HOME="
        (str_concat (int_to_str (if (ge (str_find out "HOME" 0) 0) 1 0)) "\n")))
    (print out)
    0)
