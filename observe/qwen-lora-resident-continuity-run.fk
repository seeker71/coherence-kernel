; qwen-lora-resident-continuity-run.fk — two local cells, one Qwen lifetime.
;
; This is the physical continuity witness for the standing resident: two direct
; Form token symbols cross the same ctx, state, and admitted adapter. No model
; or adapter is reopened between them. Do not preflight this effectful runner.
; preludes: form/form-stdlib/qwen-lora-resident.fk

(do
    (defn qlrc-one (ctx sts adapter token pos)
        (do
            (let geo (nth ctx 2))
            (if (eq (qlr-room? pos (list token) 1 (nth geo 17)) 0)
                (list -1 pos)
                (list (q38-forward-adapted
                    (nth ctx 0) (nth ctx 1) geo (nth ctx 3) sts
                    (nth ctx 4) (nth ctx 5) (nth ctx 6) adapter token pos)
                    (add pos 1)))))
    (let path (mr-path (mr-find "qwen38-q8")))
    (let artifact (qlh-path))
    (let adapter (qlh-admit artifact))
    (let ctx (q38-open path 16))
    (if (if (eq (qlh-admitted? adapter) 0) 1 (lt (len ctx) 10))
        (do
            (print (list "qwen-lora-continuity" "refused" 1 "voice-home" (vhome-now)))
            (qlh-close adapter)
            0)
        (do
            (let sts (q38-new-state (nth ctx 2)))
            (let first (qlrc-one ctx sts adapter 100 0))
            (let second (qlrc-one ctx sts adapter 101 (nth first 1)))
            (let closed (q38-close ctx sts))
            (let released (qlh-close adapter))
            (framebuffer-clear)
            (fb_record (intern_trivial_string "qwen-lora-resident-continuity")
                "observe/qwen-lora-resident-continuity-run.fk"
                (if (if (ge (nth first 0) 0) (ge (nth second 0) 0) 0) 1 0))
            (print (list "qwen-lora-continuity" "same-context" 1
                         "first-token" (nth first 0) "second-token" (nth second 0)
                         "position" (nth second 1) "released" (if (and (gt closed 0) (gt released 0)) 1 0)
                         "voice-home" (vhome-now) "events" (len (framebuffer-events))))
            (if (if (ge (nth first 0) 0) (ge (nth second 0) 0) 0) 1 0))))
