; form-cli-peer-source-symbol-index-live-run.fk -- read-only timing witness for
; the future resident's caller-born source-definition cache. No model opens.
;
; preludes: form-stdlib/form-cli-peer-contribution-turnwheel.fk

(do
    (defn fcpssil-line (key value)
        (print_str (str_concat "form-peer-source-index "
            (str_concat key (str_concat "=" (str_concat value "\n"))))))
    (defn fcpssil-int (key value) (fcpssil-line key (int_to_str value)))
    (let epoch 1)
    (let built-at (now_unix_ms))
    (let context (fcpct-live-source-context epoch))
    (let build-ended (now_unix_ms))
    (let snapshot (fcpct-source-context-index context))
    (let query-started (now_unix_ms))
    (let query (sof-snapshot-query snapshot epoch "fcpct-task-key"))
    (let query-ended (now_unix_ms))
    (fcpssil-int "context-present" (if (nothing? context) 0 1))
    (fcpssil-int "snapshot-present" (if (eq (sof-snapshot? snapshot) 1) 1 0))
    (fcpssil-int "index-rows" (if (eq (sof-snapshot? snapshot) 1)
        (sof-size (sof-snapshot-index snapshot)) 0))
    (fcpssil-int "cold-build-ms" (sub build-ended built-at))
    (fcpssil-line "query-signal" (sof-query-signal query))
    (fcpssil-line "query-reason" (sof-query-reason query))
    (fcpssil-int "hot-query-ms" (sub query-ended query-started))
    0)
