; bearing-census-take.fk — read the bearing sensor's frame the way the glass reads it.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/bearing-glass.bml
;
; The census gives its rows into a gift frame under its own publisher, and states
; its cadence INSIDE the frame — so no roster edit is owed for a new sensor. This
; door is the proof of the other half: the rows a taker gets back are the same
; cells the census built, seq-first, no wire and no parser between.
;
; A frame nobody is giving is named absent, not empty — the same honesty the census
; itself keeps about a door it could not measure. Run either census door first; each
; holds its frame open for twenty seconds:
;
;     ./fkwu observe/bearing-census-locale-run.fk &
;     ./fkwu observe/bearing-census-take.fk

(do
    (defn bct-value (r)
        (if (str_eq (fgo-value-kind r) "text") (fgo-text-value r) (int_to_str (fgo-int-value r))))
    (defn bct-row (r)
        (print (bcs-cat (list "  " (fgo-id r) "  " (bct-value r) " " (fgo-unit r) "   " (fgo-label r)))))
    (defn bct-rows (rs)
        (if (nil? rs) 0 (do (let said (bct-row (head rs))) (bct-rows (tail rs)))))

    (let standing (fgsr-standing? (BCSSensor)))
    (let held (fgsr-take (BCSSensor) (fgsr-held -1 -1 (list))))
    (let rows (fgsr-held-rows held))
    (let a (print ""))
    (if (eq standing 0)
        (print (str_concat "  no bearing frame standing under " (fgsr-publisher (BCSSensor))))
        (do (let b (print (bcs-cat (list "  bearing frame " (fgsr-publisher (BCSSensor))
                                         "  seq " (int_to_str (fgsr-held-seq held))
                                         "  cadence " (int_to_str (fgsr-held-cadence held)) " ms"
                                         "  " (int_to_str (len rows)) " rows"))))
            (let c (print ""))
            (bct-rows rows)))
    (len rows))
