; hearth-scripts-run.fk — the standing resident fills the body's scripts:
; the symbol voice's phrases in Hebrew, Chinese and Japanese, one pipe row
; per phrase under the header english|hebrew|chinese|japanese, stored in
; form-stdlib/locale-rows/symbol-scripts.rows as tree ice; resident-recalled.
; stdin line 1: words per ask (blank -> 8). All local; no rented token.
; preflight-exec: forbidden
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/lane-motion.bml form/form-stdlib/voice-school.bml form/form-stdlib/meaning-codes.bml
(do
    (defn hsc-say (k v) (print_str (str_concat "hearth-scripts " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn hsc-trim (s) (if (nothing? s) "" (trim s)))
    (defn hsc-text (t) (if (nothing? t) "" t))
    (defn hsc-after-last (s tag) (do (let at (str_find s tag 0)) (if (lt at 0) s (hsc-after-last (substring s (add at (str_len tag)) (str_len s)) tag))))
    (defn hsc-strip (s tag) (do (let at (str_find s tag 0)) (if (lt at 0) s (hsc-strip (str_concat (substring s 0 at) (substring s (add at (str_len tag)) (str_len s))) tag))))
    (defn hsc-body (rsp turn) (do (let at (str_find rsp (str_concat "turn=" (str_concat (int_to_str turn) "\n")) 0)) (let m (if (lt at 0) (sub 0 1) (str_find rsp (lms-mark-response) at))) (let body (if (lt m 0) "" (substring rsp (add m (str_len (lms-mark-response))) (str_len rsp)))) (let said (hsc-strip (hsc-after-last body "</think>") "<think>")) (let e (str_find said "<|" 0)) (trim (if (lt e 0) said (substring said 0 e)))))
    (defn hsc-phrases (syms) (if (eq (len syms) 0) (list) (do (let p (mc-nl (head syms))) (if (eq (str_len p) 0) (hsc-phrases (tail syms)) (cons p (hsc-phrases (tail syms)))))))
    (defn hsc-take (xs n) (if (or (eq n 0) (eq (len xs) 0)) (list) (cons (head xs) (hsc-take (tail xs) (sub n 1)))))
    (defn hsc-drop (xs n) (if (or (eq n 0) (eq (len xs) 0)) xs (hsc-drop (tail xs) (sub n 1))))
    (defn hsc-join (xs) (if (eq (len xs) 0) "" (if (eq (len (tail xs)) 0) (head xs) (str_concat (head xs) (str_concat "; " (hsc-join (tail xs)))))))
    (defn hsc-task (words) (mc-cat (list "/no_think Translate each English phrase into Hebrew (Hebrew script), Chinese (simplified characters) and Japanese (kanji/kana). Answer ONLY one line per phrase, exactly this shape, no numbering, no notes, the english phrase copied verbatim first: english|hebrew|chinese|japanese. Phrases: " (hsc-join words))))
    (defn hsc-send (words per turn acc) (if (eq (len words) 0) (reverse acc) (do (let sent (hearth-send turn (hearth-kind-answer) (hsc-task (hsc-take words per)))) (hsc-send (hsc-drop words per) per (add turn 1) (cons turn acc)))))
    (defn hsc-all-in? (rsp asks) (if (eq (len asks) 0) 1 (if (eq (str_len (hsc-body rsp (head asks))) 0) 0 (hsc-all-in? rsp (tail asks)))))
    (defn hsc-wait (asks waited) (if (or (eq (hsc-all-in? (hsc-text (read_file (hearth-reply))) asks) 1) (ge waited (mul 2 (hearth-review-wait-s)))) waited (do (let r (hearth-rest-s (hearth-review-tick-s))) (hsc-wait asks (add waited (hearth-review-tick-s))))))
    (defn hsc-store (rsp asks n) (if (eq (len asks) 0) n (do (let body (hsc-body rsp (head asks))) (let wrote (if (lt (str_len body) 8) 0 (sbt-append (MCScripts) (str_concat body (byte_to_str 10))))) (hsc-store rsp (tail asks) (add n (if (lt (str_len body) 8) 0 1))))))
    (let per (str_to_int (do (let l (hsc-trim (read_line))) (if (eq (str_len l) 0) "8" l))))
    (if (eq (hearth-standing) 0) (hsc-say "signal" "nothing reason=no-standing-hearth")
        (do (let started (if (eq (fs-exists? (MCScripts)) 1) 0 (write_file_text (MCScripts) (str_concat "english|hebrew|chinese|japanese" (byte_to_str 10)))))
            (let asks (hsc-send (hsc-phrases (mc-meanings)) per (add (lms-max-turn (read_file (hearth-task))) 1) (list)))
            (let waited (hsc-wait asks 0))
            (let stored (hsc-store (hsc-text (read_file (hearth-reply))) asks 0))
            (hsc-say "stored" (mc-cat (list "asks=" (int_to_str stored) "/" (int_to_str (len asks)) " waited=" (int_to_str waited) "s rows=" (MCScripts))))
            0)))
