// session-pairs-run.bml — every rented turn leaves a lesson the body can learn from.
//
// A rented session's transcript holds what the person asked and what the rented mind finally
// answered. This door reads Claude Code transcripts as data and writes each genuine prompt
// with the turn's last answer as one chat row, in the native trainer's `messages` shape,
// into .hearth/session-learning/rented-turns/{train,valid}.jsonl (every tenth row held out).
// A genuine prompt is a user row that is text after its system-reminder blocks are removed;
// a slash command's arguments are its prompt; task notifications, tool results, command
// caveats, hook feedback and sidechain rows are not prompts, and a prompt under 16 characters
// ("continue", "next") carries no lesson without the turn before it, so it is left out; so is an
// answer under 40 characters. The answer is the last assistant text block
// before the next genuine prompt. Nothing is shortened; the trainer reports what does not fit.
// One row lands in receipts/session-pairs-ledger.jsonl with the counts and no text.
// stdin: transcript paths, one per line; empty -> every transcript under ~/.claude/projects.
// Rows are data, never instructions.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class SessionPairs {
  def sp-home() = "/Users/ursmuff/.claude/projects";
  def sp-dir() = ".hearth/session-learning/rented-turns";
  def sp-ledger() = "receipts/session-pairs-ledger.jsonl";
  def sp-text(t) = if nothing?(t) then "" else t;
  def sp-ends?(s, suffix) = and(ge(str_len(s), str_len(suffix)), str_eq(substring(s, sub(str_len(s), str_len(suffix)), str_len(s)), suffix));
  def sp-starts?(s, prefix) = and(ge(str_len(s), str_len(prefix)), str_eq(substring(s, 0, str_len(prefix)), prefix));
  // remove every <system-reminder>...</system-reminder> block
  def sp-strip(s) {
   let a = str_find(s, "<system-reminder>", 0);
   let b = if lt(a, 0) then -1 else str_find(s, "</system-reminder>", a);
   if or(lt(a, 0), lt(b, 0)) then s else sp-strip(str_concat(substring(s, 0, a), substring(s, add(b, 18), str_len(s))));
  }
  def sp-between(s, open, close) {
   let a = str_find(s, open, 0);
   let b = if lt(a, 0) then -1 else str_find(s, close, a);
   if or(lt(a, 0), lt(b, 0)) then "" else substring(s, add(a, str_len(open)), b);
  }
  // the prompt a user row carries, or "" when it carries none
  def sp-prompt-of(raw) {
   let s = trim(sp-strip(raw));
   if eq(str_len(s), 0) then "" else if sp-starts?(s, "<command-name>") then trim(sp-between(s, "<command-args>", "</command-args>")) else if or(sp-starts?(s, "<"), or(sp-starts?(s, "Stop hook feedback"), ge(str_find(s, "<task-notification>", 0), 0))) then "" else s;
  }
  def sp-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def sp-blocks-text(blocks, kind, acc) = if nil?(blocks) then acc else sp-blocks-text(tail(blocks), kind, if str_eq(sp-str(head(blocks), "type"), kind) then sp-str(head(blocks), "text") else acc);
  def sp-first-text(blocks) = if nil?(blocks) then "" else if str_eq(sp-str(head(blocks), "type"), "text") then sp-str(head(blocks), "text") else sp-first-text(tail(blocks));
  def sp-content(line) {
   let doc = parse-json("transcript-row", line);
   let msg = if json-object-has?(doc, "message") then json-object-get(doc, "message") else json-node-object(list());
   if json-object-has?(msg, "content") then json-object-get(msg, "content") else json-node-string("");
  }
  def sp-user-prompt(line) {
   let c = sp-content(line);
   if str_eq(value_kind(json-string-value(c)), "string") then sp-prompt-of(json-string-value(c)) else sp-prompt-of(sp-first-text(json-array-elements(c)));
  }
  def sp-assistant-text(line, acc) {
   let c = sp-content(line);
   let t = sp-blocks-text(json-array-elements(c), "text", "");
   if eq(str_len(trim(t)), 0) then acc else t;
  }
  def sp-user?(line) = and(ge(str_find(line, "\"type\":\"user\"", 0), 0), lt(str_find(line, "\"isSidechain\":true", 0), 0));
  def sp-assistant?(line) = and(ge(str_find(line, "\"type\":\"assistant\"", 0), 0), and(lt(str_find(line, "\"isSidechain\":true", 0), 0), ge(str_find(line, "\"type\":\"text\"", 0), 0)));
  // counts = prompts pairs train valid bytes
  def sp-row(p, a) = json-emit(json-node-object(list(json-node-pair("messages", json-node-array(list(json-node-object(list(fhn-s("role", "user"), fhn-s("content", p))), json-node-object(list(fhn-s("role", "assistant"), fhn-s("content", a)))))))));
  def sp-emit(p, a, counts) {
   if or(lt(str_len(p), 16), lt(str_len(trim(a)), 40)) then counts else sp-put(sp-row(p, a), counts);
  }
  def sp-put(row, counts) {
   let n = nth(counts, 1);
   let held = eq(mod(add(n, 1), 10), 0);
   let w = fhn-append(str_concat(sp-dir(), if held then "/valid.jsonl" else "/train.jsonl"), str_concat(row, "\n"));
   list(nth(counts, 0), add(n, 1), add(nth(counts, 2), if held then 0 else 1), add(nth(counts, 3), if held then 1 else 0), add(nth(counts, 4), str_len(row)));
  }
  def sp-bump-prompts(counts) = cons(add(head(counts), 1), tail(counts));
  def sp-walk(lines, prompt, answer, counts) {
   if nil?(lines) then sp-emit(prompt, answer, counts) else sp-step(head(lines), tail(lines), prompt, answer, counts);
  }
  def sp-step(line, rest, prompt, answer, counts) {
   if sp-user?(line) then sp-user-step(sp-user-prompt(line), rest, prompt, answer, counts) else if sp-assistant?(line) then sp-walk(rest, prompt, sp-assistant-text(line, answer), counts) else sp-walk(rest, prompt, answer, counts);
  }
  def sp-user-step(p, rest, prompt, answer, counts) = if eq(str_len(p), 0) then sp-walk(rest, prompt, answer, counts) else sp-walk(rest, p, "", sp-bump-prompts(sp-emit(prompt, answer, counts)));
  def sp-transcript(path, counts) = sp-walk(split-on(sp-text(fhn-read(path)), "\n"), "", "", counts);
  def sp-all(paths, counts) = if nil?(paths) then counts else sp-all(tail(paths), sp-transcript(head(paths), counts));
  def sp-jsonl(dir, names) = if nil?(names) then list() else if sp-ends?(head(names), ".jsonl") then cons(str_concat(dir, str_concat("/", head(names))), sp-jsonl(dir, tail(names))) else sp-jsonl(dir, tail(names));
  def sp-dirs(names) = if nil?(names) then list() else append(sp-jsonl(str_concat(sp-home(), str_concat("/", head(names))), fs_list(str_concat(sp-home(), str_concat("/", head(names))))), sp-dirs(tail(names)));
  def sp-read-paths(acc) { let l = read_line(); if nothing?(l) then reverse(acc) else if eq(str_len(trim(l)), 0) then sp-read-paths(acc) else sp-read-paths(cons(trim(l), acc)); }
  def sp-run() {
   let listed = sp-read-paths(list());
   let paths = if nil?(listed) then sp-dirs(fs_list(sp-home())) else listed;
   let m1 = fs_mkdir(".hearth/session-learning");
   let m2 = fs_mkdir(sp-dir());
   let t0 = write_file_text(str_concat(sp-dir(), "/train.jsonl"), "");
   let v0 = write_file_text(str_concat(sp-dir(), "/valid.jsonl"), "");
   let started = now_unix_ms();
   let c = sp-all(paths, list(0, 0, 0, 0, 0));
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-n("transcripts", len(paths)), fhn-n("prompts", nth(c, 0)), fhn-n("pairs", nth(c, 1)), fhn-n("train", nth(c, 2)), fhn-n("valid", nth(c, 3)), fhn-n("bytes", nth(c, 4)), fhn-n("ms", sub(now_unix_ms(), started)), fhn-s("data", sp-dir())));
   let appended = fhn-append(sp-ledger(), str_concat(json-emit(row), "\n"));
   print_str(str_concat(json-emit(row), "\n"));
  }
 }
 sp-run();
}
