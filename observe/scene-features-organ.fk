// Scene readings carry the number of detailed blocks in a supplied luminance grid.
// preludes: form-stdlib/scene-features.fk observe/sensor-organ-template.fk
section [form.bml] {
 class SceneFeaturesOrgan {
  def scene-organ() = so-organ("scene","what","camera");
  def sf-feature(sample) = len(sf-objects(nth(sample,0),nth(sample,1),nth(sample,2)));
  def scene-route(sample,confidence) = so-route(scene-organ(),sf-feature,sample,confidence);
 }
 0;
}
