// Room readings use network overlap; fusion groups devices sharing a context.
// preludes: form-stdlib/same-room.fk observe/sensor-organ-template.fk
section [form.bml] {
 class SameRoomOrgan {
  def same-room-organ() = so-organ("same-room","where","wifi");
  def sr-feature(sample) = sr-same?(nth(sample,0),nth(sample,1),nth(sample,2));
  def sr-fusion(devicesAndFloor) = sr-grouping(nth(devicesAndFloor,0),nth(devicesAndFloor,1));
  def same-room-route(sample,confidence) = so-route(same-room-organ(),sr-feature,sample,confidence);
 }
 0;
}
