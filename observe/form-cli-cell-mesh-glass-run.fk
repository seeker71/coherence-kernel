; form-cli-cell-mesh-glass-run.fk — open a live two-cell mesh, stream one
; interned symbol, publish protocol from the shared observer, and write a
; Glass snapshot the atlas can inventory.
;
; preludes: form/form-stdlib/form-cli-cell-mesh.fk form/form-stdlib/hearth.bml

(do
    (let root (fs-path-join (fs-temp-dir) "form-cli-cell-mesh-live"))
    (let _mk (fs-mkdir root))
    (let opened (fccm-open root "cell-a" "cell-b" "observer"))
    (let sent (fccm-send-string opened "cell-a" "cell-b" "form-native-symbol" (m-offer)))
    (let published (fccm-publish-protocol sent "observer" 2 "form-symbols-v2" "intern-node"))
    (let adopted (fccm-adopt-protocol published "cell-a" 2 "form-symbols-v2" "intern-node"))
    (let adoptedB (fccm-adopt-protocol adopted "cell-b" 2 "form-symbols-v2" "intern-node"))
    (let glass (fccm-publish-glass adoptedB (hearth-telemetry-root) (now_unix_ms)))
    (print (list "form-cli-cell-mesh-glass"
        "status" (nth glass 1)
        "publisher" "form-cli.cell-mesh"
        "cells" (fccm-cells adoptedB)
        "protocol" (fccm-protocol-version adoptedB)
        "honors" (fccm-honors adoptedB)
        "invasions" (fccm-invasions adoptedB)
        "field" (fccm-field-count adoptedB)))
    (if (str_eq (nth glass 1) "published") 1 0))
