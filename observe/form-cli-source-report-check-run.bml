// preflight-exec: forbidden
// JSON or @request-file on stdin; all queries execute in native Form.
// preludes: form-stdlib/bml/form-cli-source-report-check.bml
section [form.bml] {
 let line = read_line(); let offered = if nothing?(line) then "" else line;
 let file = and(gt(str_len(offered),0),str_eq(substring(offered,0,1),"@"));
 let path = if file then substring(offered,1,str_len(offered)) else "";
 let raw = if file then if or(le(file_size(path),0),gt(file_size(path),FatMaxBytes())) then "" else read_file(path) else offered;
 print_str(json-emit(fsrc-report(fsrc-request(raw))));
}
