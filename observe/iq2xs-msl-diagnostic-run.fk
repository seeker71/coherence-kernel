; iq2xs-msl-diagnostic-run.fk — bounded emitted-text counts after a shape-band surprise.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq2xxs-dequant.fk form-stdlib/iq2xxs-msl.fk form-stdlib/iq2xs-layout.bml form-stdlib/iq2xs-dequant.fk form-stdlib/iq2xs-msl.fk form-stdlib/tests/iq2xs-msl-band.fk

(do
    (let unit (iq2xsm-msl-unit "form_iq2xs_dequant_f32" "form_iq2xs_matvec_f32" "form_iq2xs_matvec_simd_f32" "form_iq2xs_matvec_slot4_f32"))
    (print_str (str_concat "COUNT4096 " (int_to_str (iq2xmb-count unit "4096"))))
    (print_str (str_concat "COUNT512U " (int_to_str (iq2xmb-count unit "512u"))))
    (print_str (str_concat "COUNT128 " (int_to_str (iq2xmb-count unit "128"))))
    (print_str (str_concat "COUNTSIMDSUM " (int_to_str (iq2xmb-count unit "simd_sum"))))
    (print_str (str_concat "COUNTBARRIER " (int_to_str (iq2xmb-count unit "threadgroup_barrier"))))
    (print_str (str_concat "COUNTPARTIAL " (int_to_str (iq2xmb-count unit "threadgroup float partial[8]"))))
    (print_str (str_concat "COUNTJ256 " (int_to_str (iq2xmb-count unit "j += 256u"))))
    (print_str (str_concat "COUNT74U " (int_to_str (iq2xmb-count unit "74u"))))
    (print_str (str_concat "COUNTRRBOUNDS " (int_to_str (iq2xmb-count unit "r0 + rr < rows"))))
    (print_str (str_concat "UNIT_BYTES " (int_to_str (str_len unit))))
    0)
