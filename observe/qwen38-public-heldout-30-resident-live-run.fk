; qwen38-public-heldout-30-resident-live-run.fk -- dormant public evaluator.
;
; DO NOT PREFLIGHT OR RUN THIS CELL while reviewing its structure.  Its top
; level is intentionally effectful after an explicit public-dataset consent
; token.  It was authored without opening the model or carrier.
;
; Thirty sealed presentations are two fresh stream states for each of the
; fifteen public heldout challenges.  The exact context need for every prompt
; is computed first and sorted largest-first, so one Qwen residence can serve
; the whole run without a later size-driven reopen.  The residence owns the
; model context; every generation still creates and releases its own state.
;
; Only the public prompt enters generation.  Raw output is sealed before the
; canonical row (and therefore its expected answer) is reached for scoring.
; The final public export deliberately carries those raw model bytes, their
; recomputable digest, family/challenge/run nonce, and nonce+content digest.
;
; To run deliberately, place exactly the value printed by fkp30l-consent-token
; in .form-knowledge-public-heldout-30-consent, then execute this cell once.
;
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn fkp30l-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkp30l-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit")
    (defn fkp30l-consent-path ()
        ".form-knowledge-public-heldout-30-consent")

    (defn fkp30l-plan-sha-loop (presentations acc)
        (if (eq (len presentations) 0) acc
            (do
                (let p (head presentations))
                (fkp30l-plan-sha-loop (tail presentations)
                    (nmfe-sha256
                        (nmfe-fields
                            (list "public-heldout-30-plan-step-v1" acc
                                  (fkp30-presentation-trial-id p)
                                  (fkp30-presentation-row-id p)
                                  (fkp30-presentation-lane p)
                                  (fkp30-presentation-family p)
                                  (fkp30-presentation-source-sha p)
                                  (fkp30-presentation-prompt-sha p)
                                  (fkp30-presentation-challenge-sha p)
                                  (fkp30-presentation-effective-sha p)))))))
    (defn fkp30l-plan-sha ()
        (fkp30l-plan-sha-loop (fkp30-presentations)
            (nmfe-sha256 "public-heldout-30-plan-root-v1")))
    (defn fkp30l-consent-token ()
        (str_concat "run-local-qwen-public-heldout-30-v1:"
            (str_concat (fkhe-dataset-seal)
                (str_concat ":" (fkp30l-plan-sha)))))
    (defn fkp30l-consented? ()
        (do
            (let supplied (read_file (fkp30l-consent-path)))
            (if (str_eq supplied (fkp30l-consent-token)) 1
                (if (str_eq supplied
                        (str_concat (fkp30l-consent-token) "\n")) 1 0))))

    ; Mirrors fcmg-fresh-at-budgeted-hinted exactly, but observes only the need;
    ; admission and generation remain in the single live loop below.
    (defn fkp30l-context-need (src presentation)
        (do
            (let effective (fqt-knowledge-prompt
                                (fkp30-presentation-prompt presentation)))
            (let thoughts (lg-think-all effective))
            (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
            (let thought-n (fcmg-id-count thought-lists 0))
            (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
            (let gap-total (mul gap-n
                (if (gt (len thoughts) 1) (sub (len thoughts) 1) 0)))
            (let ids (fcmg-chat-ids-profile src effective "knowledge-query"))
            (fcmg-context-need (len ids) thought-n gap-total 0
                (fcmg-current-source-query-budget)
                (fcmg-current-source-answer-reserve))))
    (defn fkp30l-schedule-loop (presentations src acc)
        (if (eq (len presentations) 0)
            (fkp30-schedule-sort acc (list))
            (do
                (let p (head presentations))
                (fkp30l-schedule-loop (tail presentations) src
                    (cons (fkp30-scheduled p
                              (fkp30l-context-need src p)) acc)))))

    (defn fkp30l-same-residence? (before after)
        (if (not (eq (fcmr-live? after) 1)) 0
            (if (eq (fcmr-live? before) 0) 1
                (fkpfm-equal? before after))))
    (defn fkp30l-open-delta (before after)
        (if (and (eq (fcmr-live? before) 0)
                 (eq (fcmr-live? after) 1)) 1 0))
    (defn fkp30l-reopen-delta (before after)
        (if (and (eq (fcmr-live? before) 1)
                 (eq (fcmr-live? after) 1))
            (if (eq (fkpfm-equal? before after) 1) 0 1)
            (if (and (eq (fcmr-live? before) 1)
                     (eq (fcmr-live? after) 0)) 1 0)))
    (defn fkp30l-state-released (raw)
        (if (ge (str_find raw "\nstate_released=1\n" 0) 0) 1 0))
    (defn fkp30l-progress (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))

    ; loop-result = tag reversed-trials residence opens reopens
    (defn fkp30l-loop-result (trials residence opens reopens)
        (list "public-heldout-30-live-loop-v1" trials residence opens reopens))
    (defn fkp30l-loop
        (scheduled residence path model-id run-id session-id trials opens reopens)
        (if (eq (len scheduled) 0)
            (fkp30l-loop-result trials residence opens reopens)
            (do
                (let item (head scheduled))
                (let p (fkp30-scheduled-presentation item))
                (let _start (fkp30l-progress "trial-start"
                    (fkp30-presentation-trial-id p)))
                (let before-ms (now_unix_ms))
                ; The expected answer is not reachable on this side of the call.
                (let generated (fcmg-generate-current-source-resident-at
                    residence path (fkp30-presentation-prompt p)
                    (fkp30-presentation-source p)))
                (let after-ms (now_unix_ms))
                (let raw (nth generated 0))
                (let next-residence (nth generated 1))
                ; Seal raw bytes before finding the scoring row.
                (let output-sha (nmfe-sha256 raw))
                (let family-nonce
                    (fkp30-trial-nonce-for run-id session-id p))
                (let content-sha
                    (fkp30-content-sha-for family-nonce raw))
                (let parsed (fkhe-parse-resident-output raw))
                (let row (fkhe-find-row (fkp30-presentation-row-id p)
                                        (fkhe-rows)))
                (let score (fkhe-score row
                    (fqt-knowledge-prompt (fkhe-prompt row)) parsed
                    (sub after-ms before-ms)))
                (let observation (fkhe-score-observation score))
                (let error (nmfe-obs-error observation))
                (let present (if (eq error 0) 1 0))
                (let zero (if (and (eq present 1)
                                   (str_eq (nth score 8)
                                           (nmfe-sha256 "0"))) 1 0))
                (let one (if (and (eq present 1)
                                  (str_eq (nth score 8)
                                          (nmfe-sha256 "1"))) 1 0))
                (let trial
                    (fkp30-trial p score model-id run-id session-id raw
                        output-sha family-nonce content-sha 1 0
                        (fht-report-int raw "heed_model_executed")
                        (fkp30l-state-released raw)
                        (fkp30l-same-residence? residence next-residence)
                        (if (eq present 1) "value" "nothing") present zero one
                        (fht-report-int raw "heed_query_tokens")
                        (fht-report-int raw "heed_answer_tokens")
                        (fht-report-int raw "generated_tokens")
                        (fht-report-int raw "heed_hits")
                        (fht-report-int raw "heed_misses")
                        (fht-report-int raw "heed_nothings")
                        (fht-report-int raw "heed_decode_timeout")
                        (fht-report-int raw "heed_frame_refusals")
                        (sub after-ms before-ms)))
                (let _done (fkp30l-progress "trial-done"
                    (fkp30-presentation-trial-id p)))
                (let _output (fkp30l-progress "trial-output-sha256" output-sha))
                (fkp30l-loop (tail scheduled) next-residence path model-id
                    run-id session-id (cons trial trials)
                    (add opens (fkp30l-open-delta residence next-residence))
                    (add reopens
                        (fkp30l-reopen-delta residence next-residence))))))

    (defn fkp30l-run-live ()
        (do
            (let path (fkp30l-model-path))
            (let model-id (fkp30l-model-id))
            (let src (fcmg-src path))
            (let scheduled
                (fkp30l-schedule-loop (fkp30-presentations) src (list)))
            (let run-id
                (nmfe-sha256
                    (nmfe-fields
                        (list "public-heldout-30-local-run-v1"
                              (fkhe-dataset-seal) (fkp30l-plan-sha)
                              model-id (int_to_str (now_unix_ms))))))
            (let session-id (fkp30-session-id-for run-id model-id))
            (let looped (fkp30l-loop scheduled (fcmr-none) path model-id
                            run-id session-id (list) 0 0))
            (let trials (nmfe-reverse (nth looped 1)))
            (let residence (nth looped 2))
            (let release-ok (fcmr-release-ok? residence))
            (let result (fkp30-result trials (nth looped 3)
                            (nth looped 4) release-ok))
            (let export (fkp30-export result))
            (fkp30l-progress "dataset-sha256" (fkhe-dataset-seal))
            (fkp30l-progress "plan-sha256" (fkp30l-plan-sha))
            (fkp30l-progress "run-id" run-id)
            (fkp30l-progress "session-id" session-id)
            (fkp30l-progress "opens" (int_to_str (nth looped 3)))
            (fkp30l-progress "reopens" (int_to_str (nth looped 4)))
            (fkp30l-progress "release-ok" (int_to_str release-ok))
            (fkp30l-progress "complete"
                (int_to_str (fkp30-result-complete? result)))
            (fkp30l-progress "ready95"
                (int_to_str (fkp30-result-ready95? result)))
            (print export)
            0))

    (if (eq (fkp30l-consented?) 1)
        (fkp30l-run-live)
        (do
            (print_str "local-Qwen public heldout-30 run refused: explicit dataset-bound consent token absent\n")
            (print_str (str_concat "required-token="
                (str_concat (fkp30l-consent-token) "\n")))
            0))))
