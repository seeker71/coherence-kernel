; form-cli-peer-stage-egress-live.fk — native live-channel witness for one
; content-free resident stage.  It opens no model, server, HTTP channel, or
; second process: the current fkwu writes its own append-only Form channel.
;
; PROOF LEVEL: FKWU NATIVE EFFECT LANE (print_str pf-arm-mask 8, file_append_bytes 15; probed 2026-09-03). `print_str` and atomic
; `file_append_bytes` are live carrier primitives; the portable turnwheel band
; proves the same frame/replay shape without invoking either effect.
;
; Expected: 1
; preludes: form-stdlib/form-cli-peer-agent.fk

(do
    (let path (str_concat (temp_dir) "/form-cli-peer-stage-egress-live.spool"))
    (let cleared (fs_remove path))
    (let ctx (fcpa-knowledge-stage-egress-context path "@0.2.0.25" "1/1"))
    (let event (fcpa-knowledge-stage-observer-with-context
        ctx "run" "begin" (fknsc-fresh) 0))
    (let delivered (read_file path))
    (let observed (if (and
        (ge (str_find delivered "<|form:peer-stage|>" 0) 0)
        (and (ge (str_find delivered "\nroute=source-knowledge\n" 0) 0)
        (and (ge (str_find delivered "\ntask-node=@0.2.0.25\n" 0) 0)
        (and (ge (str_find delivered "\ntask-key=1/1\n" 0) 0)
        (and (lt (str_find delivered "\nexchange=" 0) 0)
             (lt (str_find delivered "\nturn=" 0) 0)))))) 1 0))
    (let removed (fs_remove path))
    observed)
