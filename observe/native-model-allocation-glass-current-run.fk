; native-model-allocation-glass-current-run.fk — bounded physical Glass view
; of the current dual-owner tensor-profile admission boundary.
;
; This uses the same inventory and local-sample composition as resident Glass.
; It neither opens nor closes a model and never reads tensor contents.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (defn nmag-field-text (field)
        (if (eq (fgtm-field-present? field) 1)
            (int_to_str (fgtm-field-value field)) "absent"))
    (defn nmag-row (sample epoch)
        (if (eq (len sample) 0)
            (list "missing-sample")
            (list (fgtm-sample-id sample)
                "plane" (fgtm-sample-plane sample)
                "bytes" (nmag-field-text (fgtm-sample-bytes sample))
                "handles" (nmag-field-text (fgtm-sample-capacity sample))
                "lifecycle" (fgtm-sample-lifecycle sample)
                "purpose" (fgtm-sample-purpose sample)
                "evidence" (fgtm-sample-evidence sample)
                "source" (fgtm-sample-source sample)
                "age-ms" (if (eq (fgtm-field-present?
                    (fgtm-sample-read-epoch sample)) 1)
                    (sub epoch (fgtm-field-value
                        (fgtm-sample-read-epoch sample))) -1))))
    (defn nmag-print-ids(samples ids epoch)
        (if (eq (len ids) 0) 0
            (do
                (print (nmag-row (fgl-find-sample samples (head ids)) epoch))
                (nmag-print-ids samples (tail ids) epoch))))
    (defn nmag-kind (samples kind)
        (if (eq (len samples) 0) (list)
            (if (str_eq (fgtm-sample-kind (head samples)) kind)
                (head samples) (nmag-kind (tail samples) kind))))
    (defn nmag-ids ()
        (list "tensor.owner.artifact-join" "mlx.owner.model-path"))
    (let epoch (now_unix_ms))
    (let inventory (fgtm-inventory (FGLRoot)))
    (let external (fgl-external-samples
        (fgl-inventory-samples-at inventory epoch)))
    (let samples (fgl-local-samples external epoch))
    (let gap (fgl-find-sample samples "tensor.owner.artifact-join"))
    (let promoted (fgl-find-sample samples "tensor.owner.mapped"))
    (let mlx (fgl-find-sample samples "mlx.owner.model-path"))
    (let heartbeat (nmag-kind external "owner-heartbeat"))
    (print (list "native-model-allocation-glass-current-v1"
        "epoch" epoch "rows" (len (nmag-ids))))
    (let printed (nmag-print-ids samples (nmag-ids) epoch))
    (let held (if (and (eq (len promoted) 0)
        (and (str_eq (fgtm-sample-purpose gap)
                "open-time-artifact-identity-not-published")
         (and (str_eq (fgtm-sample-source gap)
                "model.owner.open-artifact-identity")
          (and (eq (fgtm-field-present? (fgtm-sample-bytes gap)) 0)
           (and (str_eq (fgtm-sample-purpose mlx)
                    "not-on-owner-model-path")
                (eq (fgtm-field-present?
                    (fgtm-sample-capacity mlx)) 0)))))) 1 0))
    (print (list "exact-profile-withheld" held
        "resident-owner-pid" (if (and (gt (len heartbeat) 0)
            (eq (fgtm-field-present? (fgtm-sample-handle heartbeat)) 1))
            (fgtm-field-value (fgtm-sample-handle heartbeat)) -1)))
    held)
