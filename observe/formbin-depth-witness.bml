// Real proof-carrier decoding from bytes authored by the native body.
// preludes: observe/formbin-depth-fixtures.bml form-stdlib/json.fk gate/lens-text.bml
section [form.bml] {
 class FormbinDepthWitness {
  def fbw-scalars(root) {
   let source = str_concat(root, "/scalars.fk");
   let artifact = str_concat(root, "/scalars.fkb");
   let written = write_file(source, "(list \"hello\" 1.25 4294967296)\n");
   let emitted = host_wait(host_spawn_at(list("form/form-kernel-go/bin-go", "--emit-binary", artifact, source), list("/dev/null", str_concat(root, "/scalar-emit.out"), str_concat(root, "/scalar-emit.err"))));
   let out = str_concat(root, "/scalars.out");
   let err = str_concat(root, "/scalars.err");
   let read = host_wait(host_spawn_at(list("form/form-kernel-go/bin-go", "--binary", artifact), list("/dev/null", out, err)));
   let saved = write_file(str_concat(root, "/scalars.json"), json-emit(json-node-object(list(json-node-pair("emit_exit", json-node-int(emitted)), json-node-pair("read_exit", json-node-int(read)), json-node-pair("stdout", json-node-string(read_file(out))), json-node-pair("stderr", json-node-string(read_file(err)))))));
   and(eq(emitted, 0), and(eq(read, 0), str_eq(read_file(out), "[hello, 1.25, 4294967296]\n")));
  }
  def fbw-run(depth) {
   let root = str_concat(".hearth/formbin-depth-", int_to_str(host_pid()));
   let made = host_dir_mkdir(root);
   if not(eq(made, 1)) then "fresh evidence directory unavailable" else fbw-files(root, depth);
  }
  def fbw-files(root, depth) {
   let source = str_concat(root, "/deep.fkb");
   let written = write_file(source, fbw-artifact(depth));
   let out = str_concat(root, "/decode.out");
   let err = str_concat(root, "/decode.err");
   let begin = host_monotonic_ms();
   let pid = host_spawn_at(list("form/form-kernel-go/bin-go", "--binary", source), list("/dev/null", out, err));
   let status = host_wait(pid);
   let elapsed = sub(host_monotonic_ms(), begin);
   let stderr = read_file(err);
   let at = str_find(stderr, "evidence=", 0);
   let rest = if lt(at, 0) then "" else substring(stderr, add(at, 9), str_len(stderr));
   let end = str_find(rest, "\n", 0);
   let trace = if lt(end, 0) then rest else substring(rest, 0, end);
   let events = if str_eq(trace, "") then "" else read_file(trace);
   let saved = write_file(str_concat(root, "/attention.jsonl"), events);
   let report = json-emit(json-node-object(list(json-node-pair("depth", json-node-int(depth)), json-node-pair("exit", json-node-int(status)), json-node-pair("elapsed_ms", json-node-int(elapsed)), json-node-pair("stdout", json-node-string(read_file(out))), json-node-pair("stderr", json-node-string(stderr)), json-node-pair("attention_path", json-node-string(str_concat(root, "/attention.jsonl"))))));
   let kept = write_file(str_concat(root, "/result.json"), report);
   print(report);
   print(str_concat("evidence=", root));
   let scalars = fbw-scalars(root);
   print(list("scalar-roundtrip", scalars));
   if and(eq(status, 0), and(str_eq(read_file(out), "42\n"), scalars)) then 1 else 0;
  }
 }
 0;
}
