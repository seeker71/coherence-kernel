// jit-sample-run.bml — what a running kernel's hottest recipes are doing NOW, and whether each runs native or walked, sampled mid-run from its live page: no wait for the run to end.
//
//   echo '{"pid":12345,"every_ms":2000,"samples":8,"top":8}' | ./fkwu observe/jit-sample-run.bml
//
// Each sample prints the kernel's current phase and defn (kernel_page_hot pid 0) and its hottest rows (kernel_page_hot pid top) as: name, heat, native, boxes, unboxes, mints, folds. A recipe whose heat grows
// while its native column stays 0 is walked, not compiled: that is the reading that says where a long stall is not yet JIT. A kernel with no page to read answers nothing and the sample says so.
// stdout: one line a sample and one line a row.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/serve-sched.bml
section [form.bml] {
 class JitSample {
  def js-spec() = [["pid", "int"], ["every_ms", "int"], ["samples", "int"], ["top", "int"]];
  def js-row(r) = "    " ++ r[1].str() ++ "  heat " ++ r[0].str() ++ "  native " ++ r[7].str() ++ "  boxes " ++ r[5].str() ++ "  unboxes " ++ r[6].str() ++ "  mints " ++ r[8].str() ++ "  folds " ++ r[9].str();
  def js-take(pid, top, k) {
   let now = kernel_page_hot(pid, 0);
   let rows = kernel_page_hot(pid, top);
   let said = print_str("[jit-sample " ++ k.str() ++ "] now " ++ (nothing?(now) ? "nothing (no page)" : value_str(now)));
   nothing?(rows) ? 0 : len(map(r => print_str(js-row(r)), rows));
  }
  def js-loop(pid, every, top, n, k) {
   let a = js-take(pid, top, k);
   k + 1 >= n ? 0 : { host_sleep_ms(every); js-loop(pid, every, top, n, k + 1); };
  }
  def js-run() {
   let o = dop-doc("jit-sample", stdin-text(), js-spec());
   js-loop(svs-int(o, "pid", 0), svs-int(o, "every_ms", 2000), svs-int(o, "top", 8), svs-int(o, "samples", 8), 0);
  }
 }
 js-run();
}
