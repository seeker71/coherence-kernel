; ear-live-gap-probe.fk — the two encode doors on the SAME real window, hop by hop, mic open.
; The live lane holds its window as the mic's own 3200-byte chunks and joins them into one padded
; string for the pass; this walks the identical window shape and runs BOTH doors on each hop, so
; the before and the after are not two runs of a room but one. stdin line 1: run seconds.
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn lp-window () 256000)
    (defn lp-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (lp-cat (tail xs)))))
    (defn lp-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (lp-zeros (str_concat s s) n)))
    (defn lp-front (s) (if (ge (str_len s) (lp-window)) s (str_concat (lp-zeros (byte_to_str 0) (sub (lp-window) (str_len s))) s)))
    (defn lp-wlen (win) (if (eq (len win) 0) 0 (add (str_len (head win)) (lp-wlen (tail win)))))
    (defn lp-cut-front (win excess)
        (if (or (le excess 0) (eq (len win) 0)) win
            (if (ge excess (str_len (head win))) (lp-cut-front (tail win) (sub excess (str_len (head win))))
                (cons (substring (head win) excess (str_len (head win))) (tail win)))))
    (defn lp-push (win fresh) (do (let w1 (append win (list fresh))) (lp-cut-front w1 (sub (lp-wlen w1) (lp-window)))))
    (defn lp-s16 (s i) (do (let v (add (str_byte_at s i) (mul 256 (str_byte_at s (add i 1))))) (if (ge v 32768) (sub v 65536) v)))
    (defn lp-sumsq (s i end acc) (if (ge i end) acc (do (let v (lp-s16 s i)) (lp-sumsq s (add i 8) end (add acc (mul v v))))))
    (defn lp-newest (rwin need acc) (if (or (le need 0) (eq (len rwin) 0)) acc (lp-newest (tail rwin) (sub need (str_len (head rwin))) (cons (head rwin) acc))))
    (defn lp-sumsq-all (xs acc) (if (eq (len xs) 0) acc (lp-sumsq-all (tail xs) (lp-sumsq (head xs) 0 (str_len (head xs)) acc))))
    (defn lp-isqrt (v lo hi) (if (ge lo hi) lo (do (let mid (div (add lo (add hi 1)) 2)) (if (gt (mul mid mid) v) (lp-isqrt v lo (sub mid 1)) (lp-isqrt v mid hi)))))
    (defn lp-rms (win) (do (let xs (lp-newest (reverse win) 9600 (list))) (let cnt (div (lp-wlen xs) 8)) (if (le cnt 0) 0 (lp-isqrt (div (lp-sumsq-all xs 0) cnt) 0 32768))))
    (defn lp-say (hop old new dec ntok wl text)
        (print_str (str_concat "hop " (str_concat (int_to_str hop)
            (str_concat "  joined=" (str_concat (int_to_str old)
            (str_concat "ms  pieces=" (str_concat (int_to_str new)
            (str_concat "ms  decode=" (str_concat (int_to_str dec)
            (str_concat "ms  ntok=" (str_concat (int_to_str ntok)
            (str_concat "  win=" (str_concat (int_to_str (div wl 32)) (str_concat "ms  " text)))))))))))))))
    (defn lp-loop (st win deadline hop)
        (if (gt (now_unix_ms) deadline) hop
            (do (let fresh (sense_mic_stream_read 3200 120))
                (if (eq (str_len fresh) 0) (lp-loop st win deadline hop)
                    (do (let w1 (lp-push win fresh))
                        (let rms (lp-rms w1))
                        (if (or (le rms 58) (lt (lp-wlen w1) 9600)) (lp-loop st w1 deadline hop)
                            (do (let t0 (now_unix_ms))
                                (let TeA (enw-encode st (lp-front (lp-cat w1))))
                                (let t1 (now_unix_ms))
                                (let TeB (enw-encode-parts st w1 (lp-window)))
                                (let t2 (now_unix_ms))
                                (let r (enw-transcribe-from2 st TeB 0 24 (sub 0 1) (list)))
                                (let t3 (now_unix_ms))
                                (let s (lp-say hop (sub t1 t0) (sub t2 t1) (sub t3 t2) (len (nth r 1)) (lp-wlen w1) (trim (enw-text st (nth r 1)))))
                                (lp-loop st w1 deadline (add hop 1)))))))))
    (defn lp-first-line () (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    (let secs (do (let l (lp-first-line)) (if (eq (str_len l) 0) 20 (str_to_int l))))
    (let snap (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (let st (enw-open (str_concat snap "/weights.npz") (enw-tokenizer-path)))
    (let mic (sense_mic_stream_start))
    (let hops (lp-loop st (list) (add (now_unix_ms) (mul 1000 secs)) 0))
    (let stop (sense_mic_stream_stop))
    (print_str (str_concat "hops=" (int_to_str hops)))
    (print 0))
