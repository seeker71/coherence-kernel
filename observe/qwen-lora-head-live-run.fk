; qwen-lora-head-live-run.fk — one actual local Qwen token through the seed.
;
; Effectful: opens the sealed 29GB Qwen GGUF and drives Metal.  It runs one
; q38-forward-adapted call, whose entry refuses before state advance unless the
; Qwen-width local A/B buffers are admitted.  This is a route receipt, not a
; voice-quality evaluation.  Do not preflight.
; preludes: form/form-stdlib/qwen-lora-head.fk form/form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let artifact (qlh-path))
    (let bytes (qlh-write artifact (qlh-source)))
    (let adapter (qlh-admit artifact))
    (let admitted (qlh-admitted? adapter))
    (let ctx (q38-open path 2))
    (if (if (eq admitted 0) 1 (lt (len ctx) 10))
        (do
            (print (list "qwen-lora-live" "refused" 1 "artifact" (qlh-whole? artifact)
                         "device-admitted" admitted "voice-home" 0))
            (qlh-close adapter)
            0)
        (do
            (let sts (q38-new-state (nth ctx 2)))
            (let token (q38-forward-adapted
                (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                (nth ctx 4) (nth ctx 5) (nth ctx 6) adapter 100 0))
            (let free-state (q38-free-state sts))
            (let close-ctx (q38-close ctx (empty)))
            (let close-adapter (qlh-close adapter))
            (framebuffer-clear)
            (fb_record (intern_trivial_string "qwen-lora-head-local-forward")
                       "form/native/metal/qwen35-dense-token-handle.fk"
                       (if (ge token 0) 1 0))
            (print (list "qwen-lora-live" "local-forward" (if (ge token 0) 1 0)
                         "token" token "artifact-bytes" bytes "device-admitted" admitted
                         "released" (if (and (gt free-state 0) (gt close-adapter 0)) 1 0)
                         "voice-home" 0 "events" (len (framebuffer-events))))
            (if (ge token 0) 1 0))))
