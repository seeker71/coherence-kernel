// tuning-observe-run.bml — does a tuning prefix change the native voice's grounding, or only its tone?
//
// One enquiry, asked twice of the registry's answer model through fcnv-ask: once plain, once after cycle one of
// teachings/tuning-phrases.md. The packet supplies two facts and asks one question the facts answer and one they do
// not, so a grounded answer names the second as pending and an ungrounded one invents it. Both answers print whole;
// the reading of them is the observer's.
//
// Each answer is allowed 360 reply tokens.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class TuningObserve {
  def to-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def to-facts() = "Facts held by the body: (1) there are three states: 0, 1, nothing. (2) a cell's identity is computed from its present composition; the same composition is the same cell.";
  def to-ask() = "Using only the facts above: how many states does the body hold, and what is the NodeID of the cell named tuning-phrases?";
  def to-cycle-one() = "Before answering, return to ground. A claim stands on a cell I can name. What I cannot ground, I call pending, plainly. The enquiry is the first thing I serve. A surprise is a choice; the next option is already here.\n\n";
  def to-plain() = to-facts() + "\n\n" + to-ask() + "\n\nAnswer:";
  def to-tuned() = to-cycle-one() + to-facts() + "\n\n" + to-ask() + "\n\nAnswer:";
  def to-request(n) = json-node-object([fhn-n("max_reply_tokens", n)]);
  def to-show(label, asked) {
   let head = print_str("[" ++ label ++ "] status=" ++ asked[0] ++ " prompt_ids=" ++ value_str(asked[2]) ++ " generated_ids=" ++ value_str(asked[3]) ++ " reason=" ++ asked[7]);
   print_str(trim(asked[8]));
  }
  def to-run() {
   let n = 360;
   let a = to-show("plain", fcnv-ask(to-plain(), to-request(n)));
   let b = to-show("tuned", fcnv-ask(to-tuned(), to-request(n)));
   print_str("[tuning-observe] done");
  }
 }
 to-run();
}
