; Exact scalar metadata used by the native token/state path.
;
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-flash-next-q2")))
    (let src (eqr-of-file path 0 12000000))
    (list "qwen4exp-flash-next-metadata"
        (list "architecture" (gmt-str src "general.architecture"))
        (list "eos" (gmt-u32 src "tokenizer.ggml.eos_token_id")
              "bos" (gmt-u32 src "tokenizer.ggml.bos_token_id")
              "add-bos" (gmt-u32 src "tokenizer.ggml.add_bos_token"))
        (list "context" (gmt-u32 src "qwen4exp.context_length")
              "rope-base-bits" (md-f32-bits (gmt-f32 src "qwen4exp.rope.freq_base"))
              "eps-bits" (md-f32-bits (gmt-f32 src "qwen4exp.attention.layer_norm_rms_epsilon")))
        (list "verdict" (if (str_eq (gmt-str src "general.architecture") "qwen4exp") 31 0))))
