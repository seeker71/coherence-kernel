// forbidden-tools-audit-run.bml — which commands the agents of this repo ran that ran sed, awk, perl or python, read from their transcripts.
//
//   ./fkwu observe/forbidden-tools-audit-run.bml </dev/null                      every transcript of this repo's checkouts
//   printf '{"since_hours":6}' | ./fkwu observe/forbidden-tools-audit-run.bml    only the commands of the last six hours
//   printf '{"session":"39d16a37"}' | ./fkwu observe/forbidden-tools-audit-run.bml   the sessions and agents whose id holds it
//   printf '{"scope":"all","top":20}' | ./fkwu observe/forbidden-tools-audit-run.bml  every project under ~/.claude/projects; the 20 newest rows
//
// stdin is one JSON object, every key optional (an empty stdin is {}): since_hours (the commands' own time, from the transcript row),
// session (a substring of the session id or of <session>/<agent>), scope ("repo", the default: this repo's checkouts, or "all"),
// top (the newest N rows; the totals count every row). Output, newest session first: one line per session or agent with commands
// (`session <id> (<checkout>) commands=C flagged=F`, `agent <session>/<agent> ...`), under each flagged row its flagged commands
// newest first (`<time> [<names>] <command, trimmed to 160 bytes, line breaks as " ; ">`), then the totals line, then the note
// (`note: forbidden-tool commands since last breath: N`, against the previous breath's reading kept at hearth-readings), and the
// last line is the reading itself: flagged + 1, because the land cadence's lens reads 0 as "no reading" (a clean tree reads 1).
// This is the fourth lens of the land cadence's readings beside the gates (form-stdlib/land-cadence.fk lr-lenses): the slip tally
// is observed by the body each breath, never kept by hand. A reading that did not arrive (no home, no transcripts) is the reading 1
// with no row; the door never stops work. The reading is form-stdlib/bml/forbidden-tools-audit.bml.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/forbidden-tools-audit.bml
section [form.bml] {
 class ForbiddenToolsAuditRun {
  def ftr-int(text, n, key) {
   let v = jip-get(text, n, 0, key);
   v < 0 ? nothing() : parse-int(substring(text, v, jip-scalar(text, n, v)));
  }
  def ftr-str(text, n, key) = jip-field(text, n, 0, key) ?? "";
  def ftr-print(lines) = foldl((acc, l) => print_str(l), 0, lines);
 }
 let input = trim(stdin-text());
 let n = len(input);
 let hours = n == 0 ? nothing() : ftr-int(input, n, "since_hours");
 let session = n == 0 ? "" : ftr-str(input, n, "session");
 let scope = n == 0 ? "repo" : ((String) ftr-str(input, n, "scope") == "all" ? "all" : "repo");
 let top = n == 0 ? 0 : (ftr-int(input, n, "top") ?? 0);
 let since = nothing?(hours) ? 0 : now_unix_ms() - hours * 3600000;
 let rows = fta-run(scope, session, since);
 let shown = ftr-print(fta-lines(rows, top));
 let totals = print_str(fta-totals(rows));
 let note = print_str(fta-since-note(rows, read_file(hearth-readings())));
 fta-code(rows);
}
