// forbidden-tools-audit-run.bml — which commands the agents of this repo ran that ran sed, awk, perl or python, read from their transcripts.
//
//   printf '{"breath":1}' | ./fkwu observe/forbidden-tools-audit-run.bml        the commands since the last breath (the land cadence's lens)
//   ./fkwu observe/forbidden-tools-audit-run.bml </dev/null                      every transcript of this repo's checkouts (the total, on demand)
//   printf '{"since_hours":6}' | ./fkwu observe/forbidden-tools-audit-run.bml    only the commands of the last six hours
//   printf '{"session":"39d16a37"}' | ./fkwu observe/forbidden-tools-audit-run.bml   the sessions and agents whose id holds it
//   printf '{"scope":"all","top":20}' | ./fkwu observe/forbidden-tools-audit-run.bml  every project under ~/.claude/projects; the 20 newest rows
//
// stdin is one JSON object, every key optional (an empty stdin is {}): breath (1 reads the window since the last breath and then moves the
// stamp; stamp names another stamp file than the hearth's), since_hours (the commands' own time, from the transcript row), session (a substring of the session id or of <session>/<agent>),
// scope ("repo", the default: this repo's checkouts, or "all"), top (the newest N rows; the totals count every row). Output, newest session
// first: one line per session or agent with commands (`session <id> (<checkout>) commands=C flagged=F`, `agent <session>/<agent> ...`),
// under each flagged row its flagged commands newest first (`<time> [<names>] <command, trimmed to 160 bytes, line breaks as " ; ">`), then
// the totals line, then the note, and the last line is the reading itself: flagged + 1, because the land cadence's lens reads 0 as "no
// reading" (a clean window reads 1).
//
// THE BREATH. The land cadence breathes every landing, so its lens must cost what the breath's own window costs, not every transcript there
// is (94 s and growing). A breath reads from the stamp the last breath left, `.hearth/forbidden-breath` (the time that breath began reading),
// to now; with no stamp (the first breath) it reads the last six hours. Only files written inside the window are opened, and each command
// counts by its own row time, so the reading is the slips of the window: it does not move when old transcripts are deleted. The note says
// `forbidden-tool commands since last breath: N (<from> to <to>)`. The stamp is moved only by {"breath":1}; every other reading leaves it.
//
// This is the fourth lens of the land cadence's readings beside the gates (form-stdlib/land-cadence.fk lr-lenses): the slip tally is observed
// by the body each breath, never kept by hand. A reading that did not arrive (no home, no transcripts) is the reading 1 with no row; the door
// never stops work. The reading is form-stdlib/bml/forbidden-tools-audit.bml.
// A request that does not read (malformed JSON, an unknown key, a key of the wrong kind, a scope that is neither, a breath with a window of its
// own) is refused by name with exit 1 (door-options.bml); a typo is never the default reading.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/forbidden-tools-audit.bml
section [form.bml] {
 class ForbiddenToolsAuditRun {
  def ftr-print(lines) = foldl((acc, l) => print_str(l), 0, lines);
  def ftr-has(doc, key) = json-object-has?(doc, key);
  def ftr-str(doc, key) = ftr-has(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def ftr-int(doc, key, fallback) = ftr-has(doc, key) ? json-int-value(json-object-get(doc, key)) : fallback;
  // the values the keys may hold: a scope is "repo" or "all"; hours and rows are not negative; a breath has its own window
  def ftr-value-why(doc) = ftr-has(doc, "scope") && (String) ftr-str(doc, "scope") != "repo" && (String) ftr-str(doc, "scope") != "all" ? "key \"scope\" must be \"repo\" or \"all\""
   : ftr-int(doc, "since_hours", 0) < 0 ? "key \"since_hours\" must not be negative"
   : ftr-int(doc, "top", 0) < 0 ? "key \"top\" must not be negative"
   : ftr-int(doc, "breath", 0) != 0 && ftr-int(doc, "breath", 0) != 1 ? "key \"breath\" must be 1 (or absent)"
   : ftr-int(doc, "breath", 0) == 1 && ftr-has(doc, "since_hours") ? "a breath reads from the last breath's stamp: it takes no \"since_hours\""
   : "";
  // the stamp lives in the hearth beside the readings; "stamp" names another file (a band stands a scratch one in)
  def ftr-stamp-path(doc) = len(ftr-str(doc, "stamp")) > 0 ? ftr-str(doc, "stamp") : substring(hearth-readings(), 0, len(hearth-readings()) - len("readings")) ++ "forbidden-breath";
 }
 let doc = dop-doc("forbidden-tools-audit", stdin-text(), [["breath", "int"], ["stamp", "str"], ["since_hours", "int"], ["session", "str"], ["scope", "str"], ["top", "int"]]);
 let why = ftr-value-why(doc);
 let refused = len(why) > 0 ? dop-refuse("forbidden-tools-audit", why) : 0;
 let breath = ftr-int(doc, "breath", 0) == 1;
 let now = now_unix_ms();
 let stamp = breath ? fta-stamp-of(read_file(ftr-stamp-path(doc))) : nothing();
 let first = breath && fta-breath-first?(stamp, now);
 let hours = ftr-has(doc, "since_hours") ? ftr-int(doc, "since_hours", 0) : nothing();
 let since = breath ? fta-breath-since(stamp, now) : nothing?(hours) ? 0 : now - hours * 3600000;
 let mode = breath ? "breath" : nothing?(hours) ? "all" : "hours";
 let rows = fta-run((String) ftr-str(doc, "scope") == "all" ? "all" : "repo", ftr-str(doc, "session"), since);
 let shown = ftr-print(fta-lines(rows, ftr-int(doc, "top", 0)));
 let totals = print_str(fta-totals(rows));
 let note = print_str(fta-window-note(rows, mode, since, now, first));
 let moved = breath ? write_file(ftr-stamp-path(doc), now.str() ++ "\n") : 0;
 fta-code(rows);
}
