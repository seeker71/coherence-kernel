; heed-observation-budget-run.fk — where do the 385 injected tokens actually go?
;
; The injected observation is 76% of the positions in a grounded turn: 385 of
; 506. Every dispatch-count and barrier repair so far has been chasing the other
; 24%. This measures the dominant term instead — byte by byte, field by field —
; so the biggest slice is chosen from arithmetic rather than from habit.
;
; Effectful: reads the grounded index. Do not preflight.
; preludes: form-stdlib/form-cli-heed-grounded.fk

(do
    (defn hob-line (k v) (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (defn hob-int (k v) (hob-line k (int_to_str v)))
    (defn hob-frame (q) (str_concat (HeedOpen) (str_concat q (HeedClose))))

    (let r (fhg-lookup 0 (hob-frame "does Sema keep memory of you between visits") 1))
    (let span (nth r 1))
    (hob-int "span-bytes-total" (str_len span))

    ; the answer itself — the only part carrying knowledge
    (defn hob-after (s marker)
        (do (let i (str_find s marker 0))
            (if (lt i 0) "" (substring s (add i (str_len marker)) (str_len s)))))
    (defn hob-upto (s marker)
        (do (let i (str_find s marker 0))
            (if (lt i 0) s (substring s 0 i))))

    (let answer (hob-upto (hob-after span "\nanswer:") (ObsClose)))
    (hob-int "answer-bytes" (str_len answer))
    (hob-int "envelope-and-fields-bytes" (sub (str_len span) (str_len answer)))

    ; the two 64-hex digests the model cannot use for anything
    (let key (hob-upto (hob-after span "\nsource-key=") "\n"))
    (let akey (hob-upto (hob-after span "\nanswer-key=") "\n"))
    (hob-int "source-key-bytes" (str_len key))
    (hob-int "answer-key-bytes" (str_len akey))
    (hob-int "digest-bytes-total" (add (str_len key) (str_len akey)))

    ; the anchors, which ARE load-bearing: they name which cell answered
    (let anchor (hob-upto (hob-after span "\nanchor=") "\n"))
    (let canchor (hob-upto (hob-after span "\ncontent-anchor=") "\n"))
    (let spath (hob-upto (hob-after span "\nsource-path=") "\n"))
    (hob-int "anchor-bytes" (add (str_len anchor) (str_len canchor)))
    (hob-int "source-path-bytes" (str_len spath))

    ; what a model-facing observation would be: marks, status, anchor, path, answer
    (let lean
        (str_concat (ObsOpen)
        (str_concat "\nstatus=hit\nanchor=" (str_concat anchor
        (str_concat "\nsource-path=" (str_concat spath
        (str_concat "\nanswer:" (str_concat answer
                    (str_concat "\n" (ObsClose))))))))))
    (hob-int "lean-span-bytes" (str_len lean))
    (hob-int "bytes-saved" (sub (str_len span) (str_len lean)))
    (hob-int "percent-saved" (div (mul (sub (str_len span) (str_len lean)) 100) (str_len span)))
    0)
