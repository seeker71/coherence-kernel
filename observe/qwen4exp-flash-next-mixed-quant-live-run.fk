; Live Metal compilation and zero-write dispatch for the three importance
; quants of UD-Q2_K_XL. The pure bands independently prove their byte decodes.
;
; preludes: form/native/metal/qwen4exp-flash-next-quant-jit.fk

(do
    (defn q4mql-repeat (v n acc)
        (if (le n 0) acc (q4mql-repeat v (sub n 1) (str_concat acc (byte_to_str v)))))
    (defn q4mql-fill-f32 (h i n bits)
        (if (ge i n) 1
            (if (eq (metal_buf_write h (mul i 4) (md-le32 bits)) 4)
                (q4mql-fill-f32 h (add i 1) n bits) 0)))
    (defn q4mql-zero? (s i)
        (if (ge i (str_len s)) 1
            (if (eq (str_byte_at s i) 0) (q4mql-zero? s (add i 1)) 0)))
    (defn q4mql-pipes? (ps)
        (if (eq (len ps) 0) 1
            (if (gt (head ps) 0) (q4mql-pipes? (tail ps)) 0)))
    (defn q4mql-run-zero (ps ty qh xh yh rows cols)
        (do
            (q4mql-fill-f32 yh 0 rows 1065353216)
            (let enq (q4eq-all-mv ps qh xh yh ty rows cols 0 0))
            (let sync (metal_sync))
            (let raw (metal_buf_read yh 0 (mul rows 4)))
            (list enq sync (q4mql-zero? raw 0))))
    (defn q4mql-ok (r)
        (if (gt (nth r 0) 0) (if (gt (nth r 1) 0) (nth r 2) 0) 0))

    (let rows 4)
    (let cols 256)
    (let qh (metal_buf_alloc (q4eq-all-bytes 20 (mul rows cols))))
    (let xh (metal_buf_alloc (mul cols 4)))
    (let yh (metal_buf_alloc (mul rows 4)))
    (let qw (metal_buf_write qh 0 (q4mql-repeat 0 (q4eq-all-bytes 20 (mul rows cols)) "")))
    (let xw (q4mql-fill-f32 xh 0 cols 1065353216))
    (let unit (q4eq-all-msl))
    (let ps (q4eq-all-pipes unit))
    (let r17 (q4mql-run-zero ps 17 qh xh yh rows cols))
    (let r18 (q4mql-run-zero ps 18 qh xh yh rows cols))
    (let r20 (q4mql-run-zero ps 20 qh xh yh rows cols))
    (let verdict
        (if (md-door-live?)
            (if (eq (q4mql-pipes? ps) 1)
                (if (eq qw 544)
                    (if (eq xw 1)
                        (if (eq (q4mql-ok r17) 1)
                            (if (eq (q4mql-ok r18) 1)
                                (if (eq (q4mql-ok r20) 1) 127 0) 0) 0) 0) 0) 0) 0))
    (metal_buf_free qh)
    (metal_buf_free xh)
    (metal_buf_free yh)
    (list "qwen4exp-flash-next-mixed-quant-live"
        (list "pipelines" (len ps) "all-live" (q4mql-pipes? ps))
        (list "iq2-xs" r17 "iq3-xxs" r18 "iq4-xs" r20)
        (list "metal-status" (metal_status))
        (list "verdict" verdict)))
