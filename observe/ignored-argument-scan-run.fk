// ignored-argument-scan-run.fk — the standing lint for the argument-dropping bug class, over the voice, native-whisper,
// native-t5 and jit units: every CALL whose result is passed as an argument the callee never reads.
//
//   ./fkwu observe/ignored-argument-scan-run.fk </dev/null
//
// Prints `[caller callee parameter-index defined-by]` per site, then the scan's counts, and ends on the number of
// sites (0 = clean). The rule and the repair are in form-stdlib/bml/ignored-argument-scan.bml: the callee should read the
// result, so each link takes the previous link's result and no lane can drop the call.
//
// preflight-exec: forbidden
import form-stdlib/bml/ignored-argument-scan.bml;
import form-stdlib/voice-chunk.bml;
import form-stdlib/voice-diarize.fk;
import form-stdlib/voice-g2p-bridge.bml;
import form-stdlib/voice-g2p.bml;
import form-stdlib/voice-master.bml;
import form-stdlib/voice-measure.bml;
import form-stdlib/voice-msl.bml;
import form-stdlib/voice-onnx.bml;
import form-stdlib/voice-pass.bml;
import form-stdlib/voice-phoneme.bml;
import form-stdlib/voice-say.bml;
import form-stdlib/voice-school.bml;
import form-stdlib/voice-score.bml;
import form-stdlib/voice-synth.fk;
import form-stdlib/voice-traits.fk;
import form-stdlib/native-t5.bml;
import form-stdlib/native-tensor.bml;
import form-stdlib/native-wav.bml;
import form-stdlib/native-whisper-decode.bml;
import form-stdlib/native-whisper-transcribe.bml;
import form-stdlib/native-whisper-witness.bml;
import form-stdlib/native-whisper.bml;
import form-stdlib/native-llama-voice.bml;
import form-stdlib/jit-once-born.fk;
import form-stdlib/jit-heat-gate.fk;
import form-stdlib/jit-decision.fk;
import form-stdlib/rest-force-jit.fk;
import form-stdlib/bml/bml-demand-jit.bml;
import form-stdlib/bml/anf-shadow.bml;
import form-stdlib/bml/native-jit-route.bml;
section [form.bml] {
    def ias-print-sites(sites) = nil?(sites) ? 0 : { let shown = print(sites[0]); ias-print-sites(sites[1:]); };
    def ias-standing-set() = ["voice-chunk.bml", "voice-diarize.fk", "voice-g2p-bridge.bml", "voice-g2p.bml", "voice-master.bml", "voice-measure.bml", "voice-msl.bml", "voice-onnx.bml", "voice-pass.bml", "voice-phoneme.bml", "voice-say.bml", "voice-school.bml", "voice-score.bml", "voice-synth.fk", "voice-traits.fk", "native-t5.bml", "native-tensor.bml", "native-wav.bml", "native-whisper-decode.bml", "native-whisper-transcribe.bml", "native-whisper-witness.bml", "native-whisper.bml", "native-llama-voice.bml", "jit-once-born.fk", "jit-heat-gate.fk", "jit-decision.fk", "rest-force-jit.fk", "bml/bml-demand-jit.bml", "bml/anf-shadow.bml", "bml/native-jit-route.bml"];
    def ias-standing-paths(names) = nil?(names) ? [] : cons("form/form-stdlib/" + names[0], ias-standing-paths(names[1:]));
    let scan = ias-scan-files(ias-standing-paths(ias-standing-set()));
    let listed = ias-print-sites(scan[2]);
    let counts = print(["ignored-argument-scan", "defns scanned", scan[0], "declined by anf-lower", scan[1], "sites", len(scan[2])]);
    len(scan[2]);
}
