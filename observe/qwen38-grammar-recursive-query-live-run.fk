; qwen38-grammar-recursive-query-live-run.fk -- re-observe the one physical miss.
;
; The 15-family batch showed Qwen refine the offered grammar query after its
; first source observation.  This dormant door runs only that public grammar
; offer through the same local Qwen/Metal current-source cursor, now with the
; BML-authored two-heed bound and fresh answer fuel after each typed hit.
;
; The offer contains no expected answer.  Raw output is sealed before the
; public scorer is reached.  This remains supervised RAG evidence and grants
; no canonical-heldout or learned-weight credit.
;
; preludes: form-stdlib/form-knowledge-public-query-offer-batch.fk
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (defn fkgq-model-path ()
        "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn fkgq-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit")
    (defn fkgq-family () "grammars")
    (defn fkgq-action-path () ".form-knowledge-grammar-recursive-query-consent")
    (defn fkgq-find-offer (offers)
        (if (nil? offers) (nothing)
            (if (str_eq (fkpqo-offer-family (head offers)) (fkgq-family))
                (head offers) (fkgq-find-offer (tail offers)))))
    (defn fkgq-offer () (fkgq-find-offer (fkpqo-offers)))
    (defn fkgq-action-token ()
        (str_concat "run-local-qwen-grammar-recursive-query-v1:"
            (str_concat (fkpqo-offer-key (fkgq-offer))
                (str_concat ":model=" (fkgq-model-id)))))
    (defn fkgq-action-bound? ()
        (do
            (let supplied (read_file (fkgq-action-path)))
            (if (str_eq supplied (fkgq-action-token)) 1
                (if (str_eq supplied (str_concat (fkgq-action-token) "\n"))
                    1 0))))
    (defn fkgq-progress (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn fkgq-generation-executed? (raw)
        (if (and (gt (fkpqo-report-int raw "generated_tokens") 0)
                 (gt (fkpqo-report-int raw "forward_passes") 0)) 1 0))

    (defn fkgq-run-live ()
        (do
            (let offer (fkgq-offer))
            (let plan-sha (fkpqo-plan-sha))
            (let run-id (nmfe-sha256 (nmfe-fields
                (list "grammar-recursive-query-local-run-v1" plan-sha
                      (fkgq-model-id) (int_to_str (now_unix_ms))))))
            (let residence-id (nmfe-sha256 (nmfe-fields
                (list "grammar-recursive-query-residence-v1" plan-sha run-id
                      (fkgq-model-id)))))
            (let before-ms (now_unix_ms))
            ; The expected answer remains unreachable across this call.
            (let generated (fcmg-generate-current-source-resident-at
                (fcmr-none) (fkgq-model-path)
                (fkpqo-rehearsal-prompt offer) (fkpqo-offer-path offer)))
            (let after-ms (now_unix_ms))
            (let raw (nth generated 0))
            (let residence (nth generated 1))
            (let same-residence (fcmr-live? residence))
            (let observation (fkpqo-observation offer plan-sha run-id
                (fkgq-model-id) residence-id raw same-residence 1 0
                (fkgq-generation-executed? raw) (sub after-ms before-ms)))
            (let release-ok (fcmr-release-ok? residence))
            (let parsed (fkhe-parse-resident-output raw))
            (let model-text (fkhe-output-generated parsed))
            (let frames (fkpqo-generated-frames model-text))
            (fkgq-progress "family" (fkgq-family))
            (fkgq-progress "run-id" run-id)
            (fkgq-progress "residence-id" residence-id)
            (fkgq-progress "raw-sha256" (nmfe-sha256 raw))
            (fkgq-progress "frame-scan-valid"
                (int_to_str (fkpqo-frame-scan-valid frames)))
            (fkgq-progress "frame-count"
                (int_to_str (fkpqo-frame-scan-count frames)))
            (fkgq-progress "heed-lookups"
                (int_to_str (fkpqo-report-int raw "heed_lookups")))
            (fkgq-progress "heed-hits"
                (int_to_str (fkpqo-report-int raw "heed_hits")))
            (fkgq-progress "heed-close-commits"
                (int_to_str (fkpqo-report-int raw "heed_close_commits")))
            (fkgq-progress "heed-bound-source-matches"
                (int_to_str (fkpqo-report-int raw
                    "heed_bound_source_matches")))
            (fkgq-progress "heed-bound-source-mismatches"
                (int_to_str (fkpqo-report-int raw
                    "heed_bound_source_mismatches")))
            (fkgq-progress "heed-answer-fuel-cut"
                (int_to_str (fkpqo-report-int raw "heed_answer_fuel_cut")))
            (fkgq-progress "transport"
                (if (nothing? observation) "0"
                    (int_to_str (fkpqo-obs-transport observation))))
            (fkgq-progress "answer95"
                (if (nothing? observation) "0"
                    (int_to_str (fkpqo-obs-answer95 observation))))
            (fkgq-progress "release-ok" (int_to_str release-ok))
            (print_str "generated:\n")
            (print_str model-text)
            (print_str "\n")
            0))

    (if (eq (fkgq-action-bound?) 1)
        (fkgq-run-live)
        (do
            (print_str "local-Qwen grammar recursive query is dormant; run-bound action token absent\n")
            (print_str (str_concat "required-token="
                (str_concat (fkgq-action-token) "\n")))
            0)))
