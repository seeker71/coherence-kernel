; lane-motion-drive.fk — the body drives its own observation: real asks
; through the hearth's send capability (one of them a kind never
; announced, so the refusal lane speaks too), the drain awaited by the
; arrival-order law, and every data point's motion reported by the
; lane-motion witness. Turn numbers are asked from the body, never
; minted by hand.
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/lane-drive.bml
(do
    (let base (ld-next-turn))
    (let rows (list
        (ld-row base (hearth-kind-answer) "Name the four proof kernels in one line.")
        (ld-row (add base 1) (hearth-kind-answer) "What is ice, in one sentence?")
        (ld-row (add base 2) (str_concat (hearth-kind-answer) "-never-announced") "This kind was never announced at birth.")
        (ld-row (add base 3) (hearth-kind-answer) "Describe every organ of the hearth in one paragraph.")))
    (print_str (ld-drive rows 240)))
