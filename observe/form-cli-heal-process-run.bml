// Run one caller-supplied argv through the native process organ. Its normal
// execution emits health, needs, token flow, choices and timing observations,
// and the runner's care answers them: when a fkwu cell's compile names a binding
// a unit in the tree defines, the unit joins the cell's preludes and stays only
// when the compile-only door confirms it. After a kept edit this door runs the
// argv again, so the healed run is observed too.
// stdin: {"argv":[...],"seconds":0,"input":"/dev/null"}
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliProcess {
  def fhpr-run() {
   let request = parse-json("native-process-request",read_line());
   let argv = oh-values(json-array-elements(json-object-get(request,"argv")));
   let seconds = json-object-has?(request,"seconds") ? fhn-number(request,"seconds") : 0;
   nil?(argv) || (seconds < 0) ? form_error("native process needs argv and a nonnegative caller deadline") : fhpr-start(request,argv,seconds);
  }
  def fhpr-start(request,argv,seconds) {
   let root = fhn-root();
   let spool = fhn-at(root,".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool,"process-",0);
   nothing?(job) ? form_error("native process evidence directory unavailable") : 0;
   let saved = fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(fhn-s("root",root))));
   let input = json-object-has?(request,"input") ? fhn-string(request,"input") : "-";
   let status = fhn-run(job,"process",seconds,"root",input,argv);
   let healed = fkbc-kept?(job);
   let rerun = healed ? fhn-run(job,"rerun",seconds,"root",input,argv) : "";
   let report = fhn-report(job);
   let health = append(oh-read(fhn-stage-path(job,"process",".events.jsonl")),append(healed ? oh-read(fhn-stage-path(job,"rerun",".events.jsonl")) : list(),oh-read(fhn-at(job,"health.jsonl"))));
   print_str(json-emit-precise(json-node-object(list(fhn-s("status",status),fhn-s("rerun_status",rerun),fhn-s("evidence",job),fhn-a("health",health)))));
  }
 }
 fhpr-run();
}
