// Run one caller-supplied argv through the native process organ. Its normal
// execution emits health, needs, token flow, choices and timing observations.
// The door asks for binding care: when a fkwu cell's compile names a binding a
// unit in the tree defines, the provider adds that unit to the cell's preludes,
// keeps the edit only when a fresh compile confirms it, and the door runs the
// argv again so the healed run is observed too.
// stdin: {"argv":[...],"seconds":0,"input":"/dev/null"}
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliProcess {
  def fhpr-run() {
   let request = parse-json("native-process-request",read_line());
   let argv = oh-values(json-array-elements(json-object-get(request,"argv")));
   let seconds = if json-object-has?(request,"seconds") then fhn-number(request,"seconds") else 0;
   if or(nil?(argv),lt(seconds,0)) then form_error("native process needs argv and a nonnegative caller deadline") else fhpr-start(request,argv,seconds);
  }
  def fhpr-start(request,argv,seconds) {
   let root = fhn-root();
   let spool = fhn-at(root,".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool,"process-",0);
   let saved = fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(fhn-s("root",root),fhn-a("care",fhn-strings(list("binding"))))));
   let input = if json-object-has?(request,"input") then fhn-string(request,"input") else "-";
   let status = fhn-run(job,"process",seconds,"root",input,argv);
   let healed = fkbc-kept?(job);
   let rerun = if healed then fhn-run(job,"rerun",seconds,"root",input,argv) else "";
   let report = fhn-report(job);
   let health = append(oh-read(fhn-stage-path(job,"process",".events.jsonl")),append(if healed then oh-read(fhn-stage-path(job,"rerun",".events.jsonl")) else list(),oh-read(fhn-at(job,"health.jsonl"))));
   print_str(json-emit-precise(json-node-object(list(fhn-s("status",status),fhn-s("rerun_status",rerun),fhn-s("evidence",job),fhn-a("health",health)))));
  }
 }
 fhpr-run();
}
