; hearth-locale-run.fk — the standing resident fills the body's tongues:
; the symbol voice's fixed words in six locales (en fa de fr pt ro) as one
; pipe row per word, and Rumi verses in the Persian original with a Latin
; transliteration and a plain gloss, three lines each. The rows are stored
; in form-stdlib/locale-rows/ as tree ice; a later organ reads them for
; sv-say-in. What the resident recalls is labelled resident-recalled, never
; claimed as a critical edition. stdin: line 1 words per ask (blank -> 8),
; line 2 verses (blank -> 6). All local; no rented token.
; preflight-exec: forbidden
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/lane-motion.bml form/form-stdlib/voice-school.bml
(do
    (defn hl-say (k v) (print_str (str_concat "hearth-locale " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn hl-trim (s) (if (nothing? s) "" (trim s)))
    (defn hl-or (s d) (if (eq (str_len s) 0) d s))
    (defn hl-text (t) (if (nothing? t) "" t))
    (defn hl-after-last (s tag) (do (let at (str_find s tag 0)) (if (lt at 0) s (hl-after-last (substring s (add at (str_len tag)) (str_len s)) tag))))
    (defn hl-strip (s tag) (do (let at (str_find s tag 0)) (if (lt at 0) s (hl-strip (str_concat (substring s 0 at) (substring s (add at (str_len tag)) (str_len s))) tag))))
    (defn hl-body (rsp turn)
        (do (let at (str_find rsp (str_concat "turn=" (str_concat (int_to_str turn) "\n")) 0))
            (let m (if (lt at 0) (sub 0 1) (str_find rsp (lms-mark-response) at)))
            (let body (if (lt m 0) "" (substring rsp (add m (str_len (lms-mark-response))) (str_len rsp))))
            (let said (hl-strip (hl-after-last body "</think>") "<think>"))
            (let e (str_find said "<|" 0))
            (trim (if (lt e 0) said (substring said 0 e)))))
    (defn hl-words () (list "the body" "Urs" "this sitting" "the sittings of today" "the collective" "did" "stands" "observed" "said" "told" "offered" "admitted" "refused" "folded" "witnessed" "released" "not yet" "a node" "gas" "water" "ice" "the patience was spent" "landed on main" "on the glass" "the most surprising teaching" "discomfort became gold" "an honest seam" "the next stone" "a gift" "a step" "a cell" "a request" "the adapter" "training loss" "structurally whole" "low-rank pairs" "the word for" "sovereign" "vitality" "home"))
    (defn hl-take (xs n) (if (or (eq n 0) (eq (len xs) 0)) (list) (cons (head xs) (hl-take (tail xs) (sub n 1)))))
    (defn hl-drop (xs n) (if (or (eq n 0) (eq (len xs) 0)) xs (hl-drop (tail xs) (sub n 1))))
    (defn hl-join (xs) (if (eq (len xs) 0) "" (if (eq (len (tail xs)) 0) (head xs) (str_concat (head xs) (str_concat "; " (hl-join (tail xs)))))))
    (defn hl-word-task (words) (vs-cat (list "/no_think Translate each English phrase into Persian (Farsi script), German, French, Portuguese and Romanian. Answer ONLY with one line per phrase, exactly this shape, no numbering, no notes: english|persian|german|french|portuguese|romanian. Phrases: " (hl-join words))))
    (defn hl-verse-task (i) (vs-cat (list "/no_think Give one short verse of Rumi (Mowlana Jalal ad-Din Balkhi) in the original Persian, chosen as verse number " (int_to_str i) " of your own list of well-known ones. Answer ONLY three lines, exactly: fa: <the Persian original>  then  tr: <a Latin transliteration>  then  en: <a plain literal gloss in your own words>. No commentary.")))
    (defn hl-send-words (words per turn acc) (if (eq (len words) 0) (reverse acc) (do (let sent (hearth-send turn (hearth-kind-answer) (hl-word-task (hl-take words per)))) (hl-send-words (hl-drop words per) per (add turn 1) (cons (list turn "words") acc)))))
    (defn hl-send-verses (i n turn acc) (if (gt i n) (reverse acc) (do (let sent (hearth-send turn (hearth-kind-answer) (hl-verse-task i))) (hl-send-verses (add i 1) n (add turn 1) (cons (list turn "verse") acc)))))
    (defn hl-all-in? (rsp asks) (if (eq (len asks) 0) 1 (if (eq (str_len (hl-body rsp (head (head asks)))) 0) 0 (hl-all-in? rsp (tail asks)))))
    (defn hl-wait (asks waited) (if (or (eq (hl-all-in? (hl-text (read_file (hearth-reply))) asks) 1) (ge waited (mul 2 (hearth-review-wait-s)))) waited (do (let r (hearth-rest-s (hearth-review-tick-s))) (hl-wait asks (add waited (hearth-review-tick-s))))))
    (defn hl-store (rsp asks nw nv)
        (if (eq (len asks) 0) (list nw nv)
            (do (let body (hl-body rsp (head (head asks))))
                (let kind (nth (head asks) 1))
                (let path (if (str_eq kind "words") "form/form-stdlib/locale-rows/symbol-words.rows" "form/form-stdlib/locale-rows/rumi-resident-recalled.rows"))
                (let wrote (if (lt (str_len body) 8) 0 (sbt-append path (str_concat body (str_concat (byte_to_str 10) (if (str_eq kind "verse") (str_concat "--" (byte_to_str 10)) ""))))))
                (hl-store rsp (tail asks) (add nw (if (and (str_eq kind "words") (ge (str_len body) 8)) 1 0)) (add nv (if (and (str_eq kind "verse") (ge (str_len body) 8)) 1 0))))))
    (let per (str_to_int (hl-or (hl-trim (read_line)) "8")))
    (let verses (str_to_int (hl-or (hl-trim (read_line)) "6")))
    (if (eq (hearth-standing) 0) (hl-say "signal" "nothing reason=no-standing-hearth")
        (do (let turn0 (add (lms-max-turn (read_file (hearth-task))) 1))
            (let asks1 (hl-send-words (hl-words) per turn0 (list)))
            (let asks2 (hl-send-verses 1 verses (add turn0 (len asks1)) (list)))
            (let asks (append asks1 asks2))
            (let waited (hl-wait asks 0))
            (let rsp (hl-text (read_file (hearth-reply))))
            (let stored (hl-store rsp asks 0 0))
            (let epoch (now_unix_ms))
            (let published (fgtm-publish-snapshot (hearth-telemetry-root) "voice.locale" epoch (list (fgtm-sample "voice.locale.word-rows" (fgtm-absent) "locale" "form" "voice.locale" "voice" "six-tongues-resident-recalled" (fgtm-absent) (fgtm-present (nth stored 0)) "stored" (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-present (hearth-board-pid)) "never" "physical-live" "hearth-locale" (vs-tags)) (fgtm-sample "voice.locale.rumi-verses" (fgtm-absent) "locale" "form" "voice.locale" "voice" "persian-resident-recalled" (fgtm-absent) (fgtm-present (nth stored 1)) "stored" (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-present (hearth-board-pid)) "never" "physical-live" "hearth-locale" (vs-tags)))))
            (hl-say "stored" (vs-cat (list "word-asks=" (int_to_str (nth stored 0)) "/" (int_to_str (len asks1)) " verses=" (int_to_str (nth stored 1)) "/" (int_to_str verses) " waited=" (int_to_str waited) "s glass=" (nth published 1))))
            0)))
