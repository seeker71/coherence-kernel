// torch-bin-convert-run.fk — a PyTorch checkpoint held in the body's own weight format, once.
//
//   ./fkwu observe/torch-bin-convert-run.fk </dev/null
//   printf '<checkpoint>\n<model.safetensors>\n<all|write|verify>\n' | ./fkwu observe/torch-bin-convert-run.fk
//
// Line one is the checkpoint (default: the charsiu g2p ByT5 on this host), line two the safetensors file to write
// (default: model.safetensors beside it), line three the mode: `write` converts, `verify` only reads the file back
// and compares it with the checkpoint, `all` (default) does both.
//
// WRITE. torch-bin.bml reads the zip and the pickle as data (nothing executes); the tied embedding views
// (encoder.embed_tokens.weight, decoder.embed_tokens.weight: one storage with shared.weight) are dropped exactly as
// HF's save_pretrained drops them, each checked to be a true alias first; safetensors-write.bml lays the file out in
// Form and gathers the tensor ranges on Metal into one buffer, read once and written once — to <path>.tmp, verified
// byte for byte against the checkpoint, then renamed over <path>, so a crash never leaves a torn model. The header's
// __metadata__ carries provenance: source repository, license, converter, the checkpoint's size and its content
// seal (native-content-seal.bml's tree digest: sha256 over 64 KiB leaves on the device, not the flat file sha).
//
// VERIFY, twice, every byte on the device (a kernel counts the words that differ; zero is the only pass):
//   1. the file's own header (safetensors-index.bml, the reader the body already uses) against the checkpoint's ranges;
//   2. the T5 weight loader (t5-weights.bml: the rows and handles native-t5.bml asks for) against the same ranges,
//      plus the T5 name table against config.json beside the file.
// Then the file's content seal, the figure the registry row records.
//
// GPU etiquette: this opens the Metal carrier, so the door holds the GPU lease (/tmp/form-gpu.lock, machine-wide,
// form/form-stdlib/gpu-lease.bml) from before the carrier opens until the run is done, and prints it, taken and
// given back, as `lease  ...` lines. A live holder is waited for (20 minutes), a dead holder's lease is taken over,
// and a refused take stops the door before it touches the device.
// preflight-exec: forbidden
import form/form-stdlib/gpu-lease.bml;
import form/form-stdlib/torch-bin.bml;
import form/form-stdlib/safetensors-write.bml;
import form/form-stdlib/t5-weights.bml;
import form/form-stdlib/native-content-seal.bml;
section [form.bml] {
    def tcv-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def tcv-or(v, dflt) = len(v) == 0 ? dflt : v;
    def tcv-last-slash(p, from, last) {
        let at = str_find(p, "/", from);
        at < 0 ? last : tcv-last-slash(p, at + 1, at);
    }
    def tcv-dir(p) = substring(p, 0, tcv-last-slash(p, 0, 0 - 1) + 1);
    def tcv-drops() = ["encoder.embed_tokens.weight", "decoder.embed_tokens.weight"];
    // the aliases the checkpoint actually carries
    def tcv-present(rows, names) = nil?(names) ? [] : (nil?(tb-find(rows, names[0])) ? tcv-present(rows, names[1:]) : cons(names[0], tcv-present(rows, names[1:])));
    def tcv-meta(src, rows, drops, kept) = [["format", "pt"], ["source_repo", "charsiu/g2p_multilingual_byT5_small_100"], ["license", "MIT"], ["architecture", "T5ForConditionalGeneration (ByT5-small, byte vocabulary)"], ["converted_by", "coherence-kernel body: torch-bin.bml reads the checkpoint as data, safetensors-write.bml gathers the ranges on Metal; no torch, no python"], ["source_file", "pytorch_model.bin"], ["source_bytes", file_size(src).str()], ["source_seal", ncs-file(src)], ["tensors_in_source", len(rows).str()], ["tensors_written", len(kept).str()], ["tensors_dropped_as_aliases", sw-join(drops, ",")], ["parameters_unique", tb-params-unique(rows).str()], ["dtype", "F32"]];
    def tcv-ranges(src, rows, out, trows, names) = nil?(names) ? [] : cons(tcv-range(src, tb-find(rows, names[0]), out, t5w-find(trows, names[0])), tcv-ranges(src, rows, out, trows, names[1:]));
    def tcv-range(src, srow, out, drow) = [src, tb-off(srow), out, t5w-off(drow), tb-bytes(srow)];
    def tcv-names(es) = nil?(es) ? [] : cons(sw-name(es[0]), tcv-names(es[1:]));
    def tcv-print-problems(ps) = nil?(ps) ? 0 : tcv-print-problem(ps);
    def tcv-print-problem(ps) {
        print_str("  problem: " + ps[0]);
        tcv-print-problems(ps[1:]);
    }
    def tcv-write(ps, src, out, rows, es, drops) {
        let kept = sw-why(sw-drop(es, drops));
        let r = sw-write(out, kept, tcv-meta(src, rows, drops, kept));
        print_str("write: " + (sw-ok?(r) ? "ok " + sw-why(r)[0].str() + " bytes, " + sw-why(r)[1].str() + " tensors, data starts at " + sw-why(r)[2].str() : "REFUSED " + sw-why(r)));
        sw-ok?(r) ? 0 : form_error("conversion refused");
    }
    def tcv-verify(ps, src, out, rows, es, drops) {
        let kept = sw-why(sw-drop(es, drops));
        let v = sw-verify(ps, out, kept);
        print_str("verify (file header reader, every byte on the device): " + (sw-ok?(v) ? "ok " + sw-why(v)[0].str() + " tensors, " + sw-why(v)[1].str() + " bytes equal" : "FAILED " + sw-why(v)));
        let trows = t5w-tensors(out);
        let counts = sw-compare(ps,tcv-ranges(src, rows, out, trows, tcv-names(kept)));
        print_str("verify (t5-weights loader rows, every byte on the device): tensors=" + len(counts).str() + " words-differing=" + sw-total(counts).str());
        let probs = t5w-problems(trows, t5w-config(tcv-dir(out) + "config.json"));
        print_str("t5-name-table problems=" + len(probs).str() + " params=" + t5w-params(trows).str() + " bytes=" + t5w-total-bytes(trows).str());
        tcv-print-problems(probs);
        print_str("seal " + ncs-file(out));
        (sw-ok?(v) && (sw-total(counts) == 0) && nil?(probs)) ? 0 : form_error("the safetensors file does not equal the checkpoint");
    }
    let src = tcv-or(tcv-line(), "/Users/ursmuff/models/g2p-byt5-small-100/pytorch_model.bin");
    let out = tcv-or(tcv-line(), tcv-dir(src) + "model.safetensors");
    let mode = tcv-or(tcv-line(), "all");
    let rows = tb-tensors(src);
    let es = sw-from-torch(src, rows);
    let drops = tcv-present(rows, tcv-drops());
    let lease = gpu-lease-door-held("torch-bin-convert-run");
    let opened = sw-open();
    print_str("# " + src + "  ->  " + out + "  (" + len(rows).str() + " tensors, dropping " + len(drops).str() + " aliases)");
    sw-ok?(opened) ? 0 : form_error("metal: " + sw-why(opened));
    let w = ((String) mode == "verify") ? 0 : tcv-write(sw-why(opened), src, out, rows, es, drops);
    let v = ((String) mode == "write") ? 0 : tcv-verify(sw-why(opened), src, out, rows, es, drops);
    let gave = gpu-lease-door-end(lease);
    print_str("done mode=" + mode);
    0;
}
