; qwen38-axioms-supervised-exemplar-live-run.fk -- focused public rehearsal.
;
; This dormant local-only door asks Qwen to embody the public challenge-derived
; exemplar after the already-observed independent miss. It is a rehearsal,
; never heldout or independent-generative evidence. Output retains only
; verifier axes, hashes, counters, cursor and release signals. A thin invoke is
; the intentional physical owner.
;
; preludes: observe/qwen38-axioms-one-family-complete-live-run.fk

(do
    (defn fka1sel-run (path model-id)
    (do
    (let plan (fkg15-plan-for (fka1-family)))
    (let packet (fka1l-curriculum-packet))
    (let prior (fkg15-check plan "observed-independent-miss"))
    (let prompt (fka1l-curriculum-repair-prompt plan prior packet))
    (let started (now_unix_ms))
    (let generated (fcmg-generate-with-at-budgeted-hinted
        (fcmr-none) path prompt (fka1l-max-generative) 0 0 "full"
        (fkg15-plan-source plan)))
    (let report (nth generated 0))
    (let raw (fka1l-after report "text:\n"))
    (let check (fkg15-check plan raw))
    (let verdict (fkg15-check-verdict check))
    (let candidate (fkg15-check-candidate check))
    (let live-cursor (if (ge (str_find report
        "prompt_cursor=bmf-qtf2-live-v1\n" 0) 0) 1 0))
    (let state-release (fkg15-report-state-released report))
    (let residence-release (fcmr-release-ok? (nth generated 1)))
    (let score (sum (list
        (if (eq (fgsg-candidate? candidate) 1) 1 0)
        (if (eq (fkg15-check-pass? check) 1) 2 0)
        (if (eq (fgsg-verdict-bml verdict) 1) 4 0)
        (if (eq (fgsg-verdict-bmf verdict) 1) 8 0)
        (if (eq (fgsg-verdict-form verdict) 1) 16 0)
        (if (eq live-cursor 1) 32 0)
        (if (eq state-release 1) 64 0)
        (if (eq residence-release 1) 128 0)
        (if (gt (fht-report-int report "generated_tokens") 0) 256 0)
        (if (gt (fht-report-int report "forward_passes") 0) 512 0))))
    (fka1l-line "status" (if (eq score 1023)
        "axioms-supervised-exemplar-embodied" "not-yet"))
    (fka1l-line "model-id" model-id)
    (fka1l-line "raw-sha" (fkg15-check-raw-sha check))
    (fka1l-line "check-sha" (fkg15-check-sha check))
    (fka1l-int "candidate-valid" (fgsg-candidate? candidate))
    (fka1l-int "bml-pass" (fgsg-verdict-bml verdict))
    (fka1l-int "bmf-pass" (fgsg-verdict-bmf verdict))
    (fka1l-int "form-pass" (fgsg-verdict-form verdict))
    (fka1l-int "live-cursor" live-cursor)
    (fka1l-int "generated-tokens"
        (fht-report-int report "generated_tokens"))
    (fka1l-int "forward-passes"
        (fht-report-int report "forward_passes"))
    (fka1l-int "state-release" state-release)
    (fka1l-int "residence-release" residence-release)
    (fka1l-int "latency-ms" (sub (now_unix_ms) started))
    score))

    0)
