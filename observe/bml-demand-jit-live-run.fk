; bml-demand-jit-live-run.fk -- physical bounded specialization and reuse.
; No model is opened and no resident owner is disturbed.
; preludes: form-stdlib/bml-demand-jit.fk form-stdlib/bml/bml-demand-jit-glass.bml

(do
    (defn bdjl-program ()
        (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (let root "/tmp/bml-demand-jit-live")
    (let source "/tmp/bml-demand-jit-live/source.bml")
    (let cache "/tmp/bml-demand-jit-live/leaf.cache")
    ; Leave the cache in place: a second fkwu process must physically consume
    ; the first process's published image.  Source is written only at birth so
    ; observation itself never invalidates the artifact it intends to test.
    (let made (if (lt (file_mtime root) 0) (fs-mkdir root) 0))
    (let wrote (if (lt (file_mtime source) 0)
        (write_file_text source "section [form.bml] { 0; }") 0))
    (let first-start (now_unix_ms))
    (let first (bdj-request (bdj-empty 9001) source cache (bdjl-program) 4 5))
    (let first-ms (sub (now_unix_ms) first-start))
    (let step (bdj-step (bdj-receipt-state first)))
    (let second (bdj-request (bdj-step-state step) source cache
        (bdjl-program) 4 10))
    (let published (bdjg-publish (now_unix_ms) first-ms first step
        (if (lt (file_size cache) 0) 0 (file_size cache))))
    (list "bml-demand-jit-live"
        (list "first-frame-ms" first-ms "value" (bdj-receipt-value first)
              "route" (bdj-receipt-route first) "cache"
              (bdj-receipt-cache-state first))
        (list "specialization-ms" (bdj-step-ms step) "attention"
              (bdj-step-attention step) "status" (bdj-step-status step))
        (list "same-process-value" (bdj-receipt-value second) "route"
              (bdj-receipt-route second) "born" (bdj-receipt-born second))
        (list "glass" (bdjg-publish-status published) "publisher"
              (BDJGPublisher))
        (list "nodeid-policy" (BDJNodeIdPolicy) "wider-frontier"
              (BDJWiderFrontier))))
