// q6k-decode-rate-run.bml — how fast the Q6_K decode matvec (pipeline 58) reads its bytes against the kernel it replaced,
// on synthetic tensors only: the door the rates in form-stdlib/bml/qwen38-decode-quant.bml cite.
//
//   ./fkwu observe/q6k-decode-rate-run.bml
//
// The door takes the GPU lease itself (gpu-lease-door-held: a live holder is waited for) and gives it back before it
// ends, so it runs straight from the shell, never under observe/gpu-lease-run.fk (that door's lease would hold this one's
// take for its whole wait). Synthetic Q6_K filled on the device (q38dq-fill: no model file, no memory lease), d subnormal
// of either sign (q38dq-fill class 2: a real Q6_K row's d), at two shapes: 5120 x 17408 (an ffn_down, 73 MB) as
// qkr-copies() copies read in turn, dispatch j of a round reading copy j mod qkr-copies() (292 MB in all, so no dispatch
// reads the bytes the one before it read), and the head 248320 x 5120 (1.04 GB, one copy); Q4_K's pipeline 57 is timed
// beside them on the first shape, d normal and positive (class 0), as many copies in turn. The previous kernel is
// origin/main 7b217aa91's eight-weight, pair-of-rows text, verbatim but for its names, compiled in this door only. Beside
// the kernels on each shape runs a plain read of the same Q6_K bytes (qkr_read: a uint4 a thread, no arithmetic): the rate
// the device gives a bare load of them, under the same conditions. A round times every entry once, n dispatches to one
// sync, by the device's own busy time (metal_live word 11: GPUEndTime - GPUStartTime of the round's command buffer); round
// k starts the list at entry k mod n, so over n rounds every entry is timed once in every position, and each keeps its best
// round at each position (qkr-rounds-per-position rounds a position). A rate is the tensor's bytes times n over that best,
// printed beside the plain read's fastest and the bandwidth Apple states for the chip (qkr-wires, found by the brand string
// sysctl reports and the gpu-core-count ioreg reports) as shares, not judged: a kernel that reads at the memory's own rate
// meets a plain read within the spread of the reads themselves, and the stated figure is no ceiling for this clock (both
// readings in form-stdlib/bml/qwen38-decode-quant.bml). Beside the reading: the load averages before and after
// (host_load_avg), the lease directory and its live leases (mg-lease-view), the GPU lock (gpl-judge: held by this door, or
// by another), the fkwu peers carrying a GPU marker (gpl-peers), the other fkwu processes (this door's own ancestors
// aside), and host_gpu_utilization before the first dispatch (and after a 1.5 s rest past the last, which still carries the
// tail of this door's own work: printed, not judged). The reading is called NOISY when a memory lease, a lock not this
// door's, a peer or any other fkwu process is live before or after, or the device read at least qkr-busy() percent busy
// before the first dispatch; otherwise quiet. The previous and the lane's outputs are compared row by row (both kernels'
// last dispatch of a round reads copy (n - 1) mod qkr-copies()).
// THE VERDICT, against two named bounds. Bit 1, the clock every rate rests on: over one long plain read
// (qkr-clock-dispatches() dispatches of the 292 MB, about a quarter second, to one sync), the device's busy time sits at or
// under the host's wall time around that sync and at least (100 - qkr-clock-slack()) % of it, the host's millisecond ticks
// granted one each way, so no rate here stands more than that slack past the host's own clock. Bit 2, the gain: on both
// shapes the lane's slowest position reads faster than the previous kernel's fastest. Verdict 3 when both land; a short
// verdict or a unit that did not compile is a form_error (exit 1), said after the lease is given back.
// preflight-exec: forbidden
// preludes: native/metal/qwen35-dense-token-handle.fk form-stdlib/f16-decode.fk form-stdlib/lora-adapter.bml form-stdlib/bml/memory-governor.bml form-stdlib/gpu-lease.bml
section [form.bml] {
 class Q6kDecodeRateRun {
  def qkr-say(s) = print_str("[q6k-rate] " ++ s);
  def qkr-busy() = 10;
  def qkr-rounds-per-position() = 6;
  def qkr-copies() = 4;
  def qkr-clock-dispatches() = 2000;
  def qkr-clock-slack() = 5;
  // the stated figure, GB/s: [brand string, GPU cores, the bandwidth Apple states for that part]
  def qkr-wires() = [["Apple M4 Max", 40, 546]];
  def qkr-wire(chip, cores, ws) = nil?(ws) ? nothing() : ((String) ws[0][0] == chip && (Comparable) ws[0][1] == cores ? ws[0][2] : qkr-wire(chip, cores, ws[1:]));
  def qkr-wire-text(wire) = nothing?(wire) ? "none in qkr-wires" : wire.str() ++ " GB/s";
  def qkr-line(s) = (Comparable) str_find(s, byte_to_str(10), 0) < 0 ? s : substring(s, 0, str_find(s, byte_to_str(10), 0));
  def qkr-chip() = qkr-line(host_capture(["sysctl", "-n", "machdep.cpu.brand_string"]) ?? "");
  def qkr-int-or-0(v) = (String) value_kind(v) == "int" ? v : 0;
  def qkr-cores-in(s, at) = at < 0 ? 0 : qkr-int-or-0(str_to_int(qkr-line(substring(s, at + 19, len(s)))));
  def qkr-cores() {
   let s = host_capture(["ioreg", "-rd1", "-c", "IOGPU"]) ?? "";
   qkr-cores-in(s, str_find(s, "\"gpu-core-count\" = ", 0));
  }
  // the previous kernel: origin/main 7b217aa91's q38dq-q6-quant-msl and q38dq-q6-wide-msl, q38dq_q6 named qkr_prev_q6
  def qkr-prev-msl() = "static inline float qkr_prev_q6(uint a, uint e, uint s, uint nsh, uint hsh) { return float(int(((a >> (s + nsh)) & 15u) | (((e >> (s + hsh)) & 3u) << 4u)) - 32); } " ++ "kernel void qkr_prev_f32" ++ q38dq-sig-msl() ++ "uint sg = (uint)tiisg / 2u; uint p = (uint)tiisg - sg * 2u; uint h = sg / 8u; uint rem = sg - h * 8u; uint g = rem / 2u; uint is = rem - g * 2u; uint l0 = is * 16u + p * 8u; uint qloff = h * 64u + l0 + (g & 1u) * 32u; uint qhoff = 128u + h * 32u + l0; uint scoff = 192u + h * 8u + is + 2u * g; uint nsh = (g / 2u) * 4u; uint hsh = 2u * g; uint xoff = h * 128u + g * 32u + l0; for (uint ib = (uint)sgitg; ib < nb; ib += nsg) { device const float* xp = x + ib * 256u + xoff; packed_float4 ya = *(device const packed_float4*)(xp); packed_float4 yc = *(device const packed_float4*)(xp + 4); for (ushort row = 0u; row < 2u; ++row) { uint r = r0 + (uint)row; if (r >= rows) continue; device const uchar* b = qb + ((ulong)r * (ulong)nb + (ulong)ib) * 210ul; packed_ushort4 ql = *(device const packed_ushort4*)(b + qloff); packed_ushort4 qh = *(device const packed_ushort4*)(b + qhoff); ushort hd = (ushort)b[208] | ((ushort)b[209] << 8); float gsc = float(as_type<half>(hd)) * float(q6k_s8(int(b[scoff]))); uint a0 = uint(ql.x); uint a1 = uint(ql.y); uint a2 = uint(ql.z); uint a3 = uint(ql.w); uint e0 = uint(qh.x); uint e1 = uint(qh.y); uint e2 = uint(qh.z); uint e3 = uint(qh.w); float qd = 0.0f; qd = metal::fma(qkr_prev_q6(a0, e0, 0u, nsh, hsh), ya.x, qd); qd = metal::fma(qkr_prev_q6(a0, e0, 8u, nsh, hsh), ya.y, qd); qd = metal::fma(qkr_prev_q6(a1, e1, 0u, nsh, hsh), ya.z, qd); qd = metal::fma(qkr_prev_q6(a1, e1, 8u, nsh, hsh), ya.w, qd); qd = metal::fma(qkr_prev_q6(a2, e2, 0u, nsh, hsh), yc.x, qd); qd = metal::fma(qkr_prev_q6(a2, e2, 8u, nsh, hsh), yc.y, qd); qd = metal::fma(qkr_prev_q6(a3, e3, 0u, nsh, hsh), yc.z, qd); qd = metal::fma(qkr_prev_q6(a3, e3, 8u, nsh, hsh), yc.w, qd); float part = gsc * qd; if (row == 0u) sumf0 = sumf0 + part; else sumf1 = sumf1 + part; } } " ++ q38dq-epilogue-msl();
  // its record: a pair of rows a 256-thread group, as the lane dispatched it
  def qkr-prev-rec(p, w, x, y, rows, cols) = [p, md-bind16([w, x, y], [rows, cols], 256, 0, 1, 0), (rows + 1) / 2];
  // the plain read: thread i loads uint4 i of the tensor and folds it to one word, stored only when it equals one 32-bit
  // value, so the load stands and the store almost never runs; its record, bytes / 16 threads
  def qkr-read-msl() = "kernel void qkr_read(device const uint4* w [[buffer(0)]], device uint* out [[buffer(1)]], constant uint& n [[buffer(2)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; uint4 v = w[i]; uint t = (v.x ^ v.y) ^ (v.z ^ v.w); if (t == 2654435769u) out[0] = i; }";
  def qkr-read-rec(p, w, ob, bytes) = [p, md-bind16([w, ob], [bytes / 16], 256, 0, 0, 0), bytes / 16];
  // k copies of a rows x cols tensor of `type`, filled with salts s, s + 1, ... in d class dcls
  def qkr-fill-copies(pfill, type, rows, cols, s, dcls, k) = k <= 0 ? [] : {
   let w = metal_buf_alloc(rows * (cols / 256) * q38dq-fill-stride(type));
   let f = q38dq-fill(pfill, type, w, rows, cols, s, dcls);
   cons(w, qkr-fill-copies(pfill, type, rows, cols, s + 1, dcls, k - 1));
  };
  // x exact in f32: multiples of 2^-10 in [-1, 1], 256 a chunk (a rate does not read x's value)
  def qkr-xv(i) = (1.0 * (((i * 37) % 2049) - 1024)) / 1024.0;
  def qkr-xs-chunk(lo, hi, acc) = lo >= hi ? acc : qkr-xs-chunk(lo + 1, hi, acc ++ md-le32(md-f32-bits(qkr-xv(lo))));
  def qkr-xs(n, lo, acc) = lo >= n ? acc : qkr-xs(n, lo + 256, acc ++ qkr-xs-chunk(lo, lo + 256 > n ? n : lo + 256, ""));
  // n dispatches, dispatch j running the record recs[j mod len], to one sync: the device's busy us
  def qkr-n(recs, n, j) = j >= n ? 1 : {
   let r = recs[j % len(recs)];
   let e = metal_enqueue(r[0], r[1], r[2]);
   qkr-n(recs, n, j + 1);
  };
  def qkr-once(recs, n) {
   let b0 = metal_live();
   let sent = qkr-n(recs, n, 0);
   let s = metal_sync();
   let b1 = metal_live();
   b1[11] - b0[11];
  }
  // the same, with the host's wall ms around the sync beside the busy us (the carrier commits the batch at the sync, so
  // the device starts after the host clock does): [busy us, wall ms]
  def qkr-clock(recs, n) {
   let b0 = metal_live();
   let sent = qkr-n(recs, n, 0);
   let t0 = now_unix_ms();
   let s = metal_sync();
   let t1 = now_unix_ms();
   let b1 = metal_live();
   [b1[11] - b0[11], t1 - t0];
  }
  def qkr-clock-ok?(c) = (Comparable) c[0] <= 1000 * (c[1] + 1) && (Comparable) 100 * c[0] >= 1000 * (c[1] - 1) * (100 - qkr-clock-slack());
  // one round in `order` (indices of es): [index, us] pairs, timed in that order
  def qkr-time(es, n, order) = nil?(order) ? [] : {
   let us = qkr-once(es[order[0]][1], n);
   let rest = qkr-time(es, n, order[1:]);
   cons([order[0], us], rest);
  };
  def qkr-find(pairs, i) = nil?(pairs) ? 0 - 1 : ((Comparable) pairs[0][0] == i ? pairs[0][1] : qkr-find(pairs[1:], i));
  def qkr-min(a, b) = (Comparable) a < 0 ? b : ((Comparable) b < a ? b : a);
  // round k's order: the entries from k mod n on, so entry i is timed at position (i - k) mod n
  def qkr-rot(n, k, j) = j >= n ? [] : cons((k + j) % n, qkr-rot(n, k, j + 1));
  def qkr-pos(i, k, n) = (i + n - k % n) % n;
  // bests: per entry, its best us at each position
  def qkr-keep(b, p, us, j) = j >= len(b) ? [] : cons((Comparable) j == p ? qkr-min(b[j], us) : b[j], qkr-keep(b, p, us, j + 1));
  def qkr-merge(bests, got, k, i) = i >= len(bests) ? [] : cons(qkr-keep(bests[i], qkr-pos(i, k, len(bests)), qkr-find(got, i), 0), qkr-merge(bests, got, k, i + 1));
  def qkr-rounds(es, n, k, rounds, bests) = k >= rounds ? bests : {
   let got = qkr-time(es, n, qkr-rot(len(es), k % len(es), 0));
   qkr-rounds(es, n, k + 1, rounds, qkr-merge(bests, got, k, 0));
  };
  def qkr-row(n) = n <= 0 ? [] : cons(0 - 1, qkr-row(n - 1));
  def qkr-fresh-k(n, k) = k <= 0 ? [] : cons(qkr-row(n), qkr-fresh-k(n, k - 1));
  def qkr-fresh(n) = qkr-fresh-k(n, n);
  def qkr-gbs(bytes, n, us) = (Comparable) us <= 0 ? 0.0 : (1.0 * bytes * n) / (1000.0 * us);
  def qkr-1dp(x) = (float_to_int(x * 10.0 + 0.5) / 10).str() ++ "." ++ (float_to_int(x * 10.0 + 0.5) % 10).str();
  def qkr-rates(bytes, n, b, j) = j >= len(b) ? [] : cons(qkr-gbs(bytes, n, b[j]), qkr-rates(bytes, n, b, j + 1));
  def qkr-lo(xs) = foldl((a, x) => x < a ? x : a, xs[0], xs);
  def qkr-hi(xs) = foldl((a, x) => x > a ? x : a, xs[0], xs);
  def qkr-at(b, g, j) = j >= len(b) ? "" : (j > 0 ? "; " : "") ++ "at " ++ (j + 1).str() ++ " " ++ b[j].str() ++ " us = " ++ qkr-1dp(g[j]) ++ " GB/s" ++ qkr-at(b, g, j + 1);
  // per entry [least, most, the rates by position] GB/s
  def qkr-spans(es, bests, n, i) = i >= len(es) ? [] : {
   let g = qkr-rates(es[i][2], n, bests[i], 0);
   cons([qkr-lo(g), qkr-hi(g), g], qkr-spans(es, bests, n, i + 1));
  };
  def qkr-share(s, of, what) = qkr-1dp(100.0 * s[0] / of) ++ " .. " ++ qkr-1dp(100.0 * s[1] / of) ++ " % of " ++ what;
  // one line an entry: its rate at each position, its least and most as shares of the plain read's fastest (the last
  // entry) and of the stated figure
  def qkr-report(shape, es, bests, spans, n, wire, i) = i >= len(es) ? 0 : {
   let plain = spans[len(spans) - 1][1];
   let said = qkr-say(shape ++ " " ++ es[i][0] ++ ": best of " ++ qkr-rounds-per-position().str() ++ " rounds of " ++ n.str() ++ " dispatches at each position, " ++ qkr-at(bests[i], spans[i][2], 0) ++ " (" ++ qkr-share(spans[i], plain, "the plain read's fastest") ++ (nothing?(wire) ? "" : ", " ++ qkr-share(spans[i], wire, "the stated " ++ wire.str())) ++ ")");
   qkr-report(shape, es, bests, spans, n, wire, i + 1);
  };
  // max |a_r - b_r|, the rows whose bits differ and the largest |b_r|, 1024 rows a chunk: [max, count, largest]
  def qkr-f(s, i) = ln-f32-decode(ln-u32-le(s, 4 * i));
  def qkr-abs(v) = v < 0.0 ? 0.0 - v : v;
  def qkr-dmax-go(a, b, i, end, acc) = i >= end ? acc : {
   let dv = qkr-abs(qkr-f(a, i) - qkr-f(b, i));
   let same = (String) substring(a, 4 * i, 4 * i + 4) == substring(b, 4 * i, 4 * i + 4);
   qkr-dmax-go(a, b, i + 1, end, [dv > acc[0] ? dv : acc[0], same ? acc[1] : acc[1] + 1, qkr-abs(qkr-f(b, i)) > acc[2] ? qkr-abs(qkr-f(b, i)) : acc[2]]);
  };
  def qkr-dmax(a, b, i, n, acc) = i >= n ? acc : qkr-dmax(a, b, i + 1024, n, qkr-dmax-go(a, b, i, i + 1024 > n ? n : i + 1024, acc));
  def qkr-compare(shape, yp, yl, rows) {
   let d = qkr-dmax(metal_buf_read(yp, 0, 4 * rows), metal_buf_read(yl, 0, 4 * rows), 0, rows, [0.0, 0, 0.0]);
   qkr-say(shape ++ " previous vs lane: max |d| " ++ d[0].str() ++ ", rows whose bits differ " ++ d[1].str() ++ " of " ++ rows.str() ++ ", largest |lane| " ++ d[2].str());
  }
  def qkr-kin() = cons(host_pid(), gpl-ancestors(host_pid(), 16));
  def qkr-others() = filter(r => (Comparable) gpl-in?(r[0], qkr-kin()) == 0, host_processes("fkwu") ?? []);
  // the lock as noise: live and held by a process that is not this door
  def qkr-lock-other?(j) = (String) j[0] == "live" && (Comparable) j[1][2] != host_pid();
  def qkr-lock-text(j) = (String) j[0] != "live" ? j[0] : ((Comparable) j[1][2] == host_pid() ? "held by this door" : "live, pid " ++ j[1][2].str());
  def qkr-pids(rows) = foldl((acc, r) => acc ++ r[0].str() ++ " ", "", rows);
  def qkr-names(xs) = foldl((acc, x) => acc ++ x.str() ++ " ", "", xs);
  def qkr-frees(ws) = foldl((a, w) => a + metal_buf_free(w), 0, ws);
  def qkr-load(l) = (l[0] / 1000).str() ++ "." ++ ((l[0] % 1000) / 10).str() ++ " " ++ (l[1] / 1000).str() ++ "." ++ ((l[1] % 1000) / 10).str() ++ " " ++ (l[2] / 1000).str() ++ "." ++ ((l[2] % 1000) / 10).str();
  // the whole door: the stated figure found, the lease taken, the device's work, the lease given back, then the verdict
  def qkr-run() {
   let chip = qkr-chip();
   let cores = qkr-cores();
   let wire = qkr-wire(chip, cores, qkr-wires());
   let lease = gpu-lease-door-held("q6k-decode-rate-run");
   let v = qkr-device(chip, cores, wire);
   let gave = gpu-lease-door-end(lease);
   (Comparable) v[0] == 3 ? 3 : form_error("q6k-rate: " ++ ((Comparable) len(v[1]) > 0 ? v[1] : "verdict " ++ v[0].str() ++ " of 3"));
  }
  // every dispatch of the door, under the lease: [verdict, why it did not run ("" when it ran)]
  def qkr-device(chip, cores, wire) {
   let msl = q38-msl() ++ qkr-prev-msl() ++ qkr-read-msl() ++ q38dq-fill-msl();
   let ps = q38-pipes(msl);
   let pprev = metal_pipeline(msl, "qkr_prev_f32");
   let pread = metal_pipeline(msl, "qkr_read");
   let pfill = metal_pipeline(msl, "q38dq_fill");
   (Comparable) ps[57] <= 0 || (Comparable) ps[58] <= 0 || (Comparable) pprev <= 0 || (Comparable) pread <= 0 || (Comparable) pfill <= 0 ? [0, "the unit did not compile (57, 58, the previous kernel, the plain read or the fill is 0)"] : qkr-timed(chip, cores, wire, ps, pprev, pread, pfill);
  }
  def qkr-timed(chip, cores, wire, ps, pprev, pread, pfill) {
   let load0 = host_load_avg();
   let names = host_dir_list(mg-lease-dir()) ?? [];
   let leases = mg-lease-view(mg-lease-dir());
   let lock = gpl-judge(gpu-lease-path());
   let peers = gpl-peers(gpu-lease-path(), gpl-markers());
   let others = qkr-others();
   let u0 = host_gpu_utilization();
   let said0 = qkr-say("beside: " ++ chip ++ ", " ++ cores.str() ++ " GPU cores, stated bandwidth " ++ qkr-wire-text(wire) ++ "; load " ++ qkr-load(load0) ++ "; lease dir " ++ mg-lease-dir() ++ " holds [" ++ qkr-names(names) ++ "], live leases " ++ len(leases).str() ++ "; gpu lock " ++ qkr-lock-text(lock) ++ "; gpu peers [" ++ qkr-names(peers) ++ "]; other fkwu [" ++ qkr-pids(others) ++ "]; gpu utilization " ++ u0.str());
   let ob = metal_buf_alloc(16);
   // ---- 5120 x 17408, qkr-copies() copies in turn: the previous kernel, pipeline 58, Q4_K's pipeline 57, the plain read ----
   let ra = 5120;
   let ca = 17408;
   let b6 = ra * (ca / 256) * 210;
   let b4 = ra * (ca / 256) * 144;
   let w6s = qkr-fill-copies(pfill, 14, ra, ca, 7, 2, qkr-copies());
   let w4s = qkr-fill-copies(pfill, 12, ra, ca, 11, 0, qkr-copies());
   let xa = metal_buf_alloc(4 * ca);
   let xw = metal_buf_write(xa, 0, qkr-xs(ca, 0, ""));
   let yp = metal_buf_alloc(4 * (ra + 4));
   let yl = metal_buf_alloc(4 * (ra + 4));
   let y4 = metal_buf_alloc(4 * (ra + 4));
   let sa = metal_sync();
   let ea = [["previous Q6_K (7b217aa91)", map(w => qkr-prev-rec(pprev, w, xa, yp, ra, ca), w6s), b6], ["lane Q6_K pipeline 58", map(w => q38dq-rec(ps, 14, w, xa, yl, ra, ca, 0), w6s), b6], ["Q4_K pipeline 57", map(w => q38dq-rec(ps, 12, w, xa, y4, ra, ca, 0), w4s), b4], ["plain read", map(w => qkr-read-rec(pread, w, ob, b6), w6s), b6]];
   let warma = qkr-rounds(ea, 2, 0, 1, qkr-fresh(len(ea)));
   let besta = qkr-rounds(ea, 20, 0, len(ea) * qkr-rounds-per-position(), qkr-fresh(len(ea)));
   let ga = qkr-spans(ea, besta, 20, 0);
   let ra1 = qkr-report("5120x17408 x" ++ qkr-copies().str(), ea, besta, ga, 20, wire, 0);
   let cmpa = qkr-compare("5120x17408", yp, yl, ra);
   // ---- the clock: one long plain read of the copies, the device's busy us against the host's wall ms ----
   let clk = qkr-clock(ea[3][1], qkr-clock-dispatches());
   let saidc = qkr-say("clock: " ++ qkr-clock-dispatches().str() ++ " dispatches of the plain read to one sync, device busy " ++ clk[0].str() ++ " us = " ++ qkr-1dp(qkr-gbs(b6, qkr-clock-dispatches(), clk[0])) ++ " GB/s, host wall " ++ clk[1].str() ++ " ms = " ++ qkr-1dp(qkr-gbs(b6, qkr-clock-dispatches(), 1000 * clk[1])) ++ " GB/s");
   let freeda = qkr-frees(w6s) + qkr-frees(w4s) + metal_buf_free(xa) + metal_buf_free(yp) + metal_buf_free(yl) + metal_buf_free(y4);
   // ---- the head shape 248320 x 5120: the previous kernel, pipeline 58, the plain read ----
   let rh = 248320;
   let ch = 5120;
   let bh = rh * (ch / 256) * 210;
   let wh = metal_buf_alloc(bh);
   let fh = q38dq-fill(pfill, 14, wh, rh, ch, 23, 2);
   let xh = metal_buf_alloc(4 * ch);
   let xhw = metal_buf_write(xh, 0, qkr-xs(ch, 0, ""));
   let yhp = metal_buf_alloc(4 * (rh + 4));
   let yhl = metal_buf_alloc(4 * (rh + 4));
   let sh = metal_sync();
   let eh = [["previous Q6_K (7b217aa91)", [qkr-prev-rec(pprev, wh, xh, yhp, rh, ch)], bh], ["lane Q6_K pipeline 58", [q38dq-rec(ps, 14, wh, xh, yhl, rh, ch, 0)], bh], ["plain read", [qkr-read-rec(pread, wh, ob, bh)], bh]];
   let warmh = qkr-rounds(eh, 1, 0, 1, qkr-fresh(len(eh)));
   let besth = qkr-rounds(eh, 4, 0, len(eh) * qkr-rounds-per-position(), qkr-fresh(len(eh)));
   let gh = qkr-spans(eh, besth, 4, 0);
   let rh1 = qkr-report("248320x5120", eh, besth, gh, 4, wire, 0);
   let cmph = qkr-compare("248320x5120", yhp, yhl, rh);
   let freedh = metal_buf_free(wh) + metal_buf_free(xh) + metal_buf_free(yhp) + metal_buf_free(yhl) + metal_buf_free(ob);
   let rest = host_sleep_ms(1500);
   let u1 = host_gpu_utilization();
   let load1 = host_load_avg();
   let leases1 = mg-lease-view(mg-lease-dir());
   let lock1 = gpl-judge(gpu-lease-path());
   let others1 = qkr-others();
   let noisy = len(leases) > 0 || len(leases1) > 0 || qkr-lock-other?(lock) || qkr-lock-other?(lock1) || len(peers) > 0 || len(others) > 0 || len(others1) > 0 || (Comparable) u0 >= qkr-busy();
   qkr-say((noisy ? "NOISY" : "quiet") ++ ": live leases " ++ len(leases).str() ++ " -> " ++ len(leases1).str() ++ ", gpu lock " ++ qkr-lock-text(lock) ++ " -> " ++ qkr-lock-text(lock1) ++ ", gpu peers " ++ len(peers).str() ++ ", other fkwu " ++ len(others).str() ++ " -> " ++ len(others1).str() ++ " [" ++ qkr-pids(others1) ++ "], gpu utilization before " ++ u0.str() ++ " (after the rest, this door's tail included: " ++ u1.str() ++ "), load " ++ qkr-load(load0) ++ " -> " ++ qkr-load(load1) ++ "; buffers freed " ++ (freeda + freedh).str() ++ " of " ++ (2 * qkr-copies() + 9).str() ++ ", live " ++ metal_live()[2].str());
   // ---- the verdict: the busy clock within the host's (1), the lane's slowest position past the previous kernel's fastest (2) ----
   let clockok = qkr-clock-ok?(clk);
   let faster = ga[1][0] > ga[0][1] && gh[1][0] > gh[0][1];
   let verdict = (clockok ? 1 : 0) + (faster ? 2 : 0);
   qkr-say("verdict " ++ verdict.str() ++ " of 3: the device's busy clock " ++ (clockok ? "within" : "OUTSIDE") ++ " " ++ qkr-clock-slack().str() ++ " % of the host's (" ++ clk[0].str() ++ " us busy, " ++ clk[1].str() ++ " ms wall); the lane's slowest position " ++ qkr-1dp(ga[1][0]) ++ " and " ++ qkr-1dp(gh[1][0]) ++ " GB/s against the previous kernel's fastest " ++ qkr-1dp(ga[0][1]) ++ " and " ++ qkr-1dp(gh[0][1]) ++ (faster ? ", faster on both shapes" : ", NOT faster on both shapes") ++ "; the plain read's fastest " ++ qkr-1dp(ga[3][1]) ++ " and " ++ qkr-1dp(gh[2][1]) ++ " GB/s (" ++ (noisy ? "NOISY" : "quiet") ++ ")");
   [verdict, ""];
  }
 }
 qkr-run();
}
