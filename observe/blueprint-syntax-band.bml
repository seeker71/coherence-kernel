// blueprint-syntax-band.bml — the language itself: `blueprint` declares, Name{...} map{...} set[...] tuple[...] build
// cells, and (as T) converts, in BML source (grammars/form-bml.fk). Last line: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/blueprint-literal.bml
section [form.bml] {
 blueprint LineItem { sku: string, qty: int }
 blueprint Order { id: int, items: list<LineItem>, meta: map<string,float>, tags: set<string>, note: option<string>, at: tuple<int,int> }
 class BlueprintSyntaxBand {
  def sb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def sb-text() = "Order{id: 7, items: [LineItem{sku: \"a\", qty: 2}], meta: map{\"w\": 1.5, \"h\": 2.0}, tags: set[\"y\", \"x\"], note: some(\"rush\"), at: tuple[3, 4]}";
  def sb-run() {
   let from-text = bl-read(sb-text(), bl-now());
   let lit = Order{id: 7, items: [LineItem{sku: "a", qty: 2}], meta: map{"w": 1.5, "h": 2.0}, tags: set["y", "x"], note: "rush", at: tuple[3, 4]};
   let shuffled = Order{at: tuple[3, 4], note: "rush", tags: set["x", "y", "x"], meta: map{"h": 2.0, "w": 1.5}, items: [LineItem{qty: 2, sku: "a"}], id: 7};
   let a1 = sb-row("two blueprints declared at load", len(bl-now()) == 2);
   let a2 = sb-row("a source literal is a cell", !nothing?(lit));
   let a3 = sb-row("the source literal is the cell the text literal reads to", !nothing?(from-text) && eq(lit, from-text));
   let a4 = sb-row("fields and members in another order are the same NodeID", !nothing?(shuffled) && eq(lit, shuffled));
   let a5 = sb-row("a map is one cell whatever its written order", eq(map{"b": 1, "a": 2}, map{"a": 2, "b": 1}));
   let a6 = sb-row("a set drops repeats and keeps one order", eq(set[3, 1, 2, 1], set[1, 2, 3]));
   let a7 = sb-row("a tuple keeps its order", !eq(tuple[1, 2], tuple[2, 1]));
   let a8 = sb-row("an absent option field is none", eq(Order{id: 1, items: [], meta: map{}, tags: set[], at: tuple[0, 0]}, Order{id: 1, items: [], meta: map{}, tags: set[], note: nothing(), at: tuple[0, 0]}));
   let a9 = sb-row("a field of the wrong type is nothing", nothing?(LineItem{sku: 1, qty: 2}));
   let a10 = sb-row("an undeclared field is nothing", nothing?(LineItem{sku: "a", qty: 2, extra: 1}));
   let a11 = sb-row("a missing required field is nothing", nothing?(LineItem{sku: "a"}));
   let a12 = sb-row("an undeclared blueprint is nothing", nothing?(Nope{x: 1}));
   let a13 = sb-row("a repeated map key is nothing", nothing?(map{"a": 1, "a": 2}));
   let a14 = sb-row("show writes the literal back", (String) bl-show(lit, bl-now()) == "Order{id: 7, items: [LineItem{sku: \"a\", qty: 2}], meta: map{\"h\": 2.0, \"w\": 1.5}, tags: set[\"x\", \"y\"], note: some(\"rush\"), at: tuple[3, 4]}");
   let c1 = sb-row("(as int) reads a string", (as int) "42" == 42);
   let c2 = sb-row("(as int) of text that is not a number is nothing", nothing?((as int) "abc"));
   let c3 = sb-row("(as float) reads a string", (as float) "2.5" == 2.5);
   let c4 = sb-row("(as int) of a float drops the fraction", (as int) 3.9 == 3);
   let c5 = sb-row("(as float) of an int keeps its kind", (String) value_kind((as float) 3) == "float");
   let c6 = sb-row("(as string) of an int", (String) ((as string) 21) == "21");
   let c7 = sb-row("(as bool) reads a string", (as bool) "true" == 1);
   let c8 = sb-row("(as bool) of a string that is not a bool is nothing", nothing?((as bool) "yes"));
   let stored = (as text) lit;
   let c9 = sb-row("(as text) writes a cell as typed JSON", len(stored) > 0 && (String) value_kind(stored) == "string");
   let c10 = sb-row("(as any) reads that text back to the same NodeID", eq(lit, (as any) stored));
   let c11 = sb-row("(as any) reads a number out of text", (as any) "12" == 12);
   let c12 = sb-row("(as any) reads a list out of text", len((as any) ((as text) [1, 2, 3])) == 3);
   let c13 = sb-row("nothing converts to nothing", nothing?((as int) nothing()));
   let wide = bl-defs("blueprint Order { id: int, items: list<LineItem> } blueprint LineItem { sku: string, qty: float }");
   let narrow = bl-defs("blueprint LineItem { sku: string, qty: int } blueprint Order { id: int, items: list<LineItem> }");
   let n1 = sb-row("a declaration may come before the blueprint it names", !nothing?(wide) && len(wide) == 2);
   let n2 = sb-row("a reference that never resolves is nothing", nothing?(bl-defs("blueprint Order { items: list<Ghost> }")));
   let n3 = sb-row("a cycle is nothing", nothing?(bl-defs("blueprint A { b: B } blueprint B { a: A }")));
   let n4 = sb-row("a changed LineItem is a changed Order", !nothing?(wide) && !nothing?(narrow) && !eq(bl-find("Order", wide)[1], bl-find("Order", narrow)[1]));
   let n5 = sb-row("the same declarations in another order are the same blueprints", eq(bl-find("Order", narrow)[1], bl-find("Order", bl-defs("blueprint Order { id: int, items: list<LineItem> } blueprint LineItem { sku: string, qty: int }"))[1]));
   let k1 = bl-cast-cell(42, "int", "string");
   let k2 = bl-cast-cell("2.5", "string", "float");
   let k3 = sb-row("a conversion is a cell", !nothing?(k1) && !nothing?(k2));
   let k4 = sb-row("running the cast cell does the conversion", ((String) bl-cast-run(k1) == "42") && (bl-cast-run(k2) == 2.5));
   let k5 = sb-row("the same conversion of the same value is the same NodeID", eq(k1, bl-cast-cell(42, "int", "string")));
   let k6 = sb-row("another value or another cast is another NodeID", !eq(k1, bl-cast-cell(43, "int", "string")) && !eq(bl-cast-cell(1, "int", "string"), bl-cast-cell(1, "int", "float")));
   let k7 = sb-row("a cast the body names no blueprint for is nothing", nothing?(bl-cast-cell([1], "list", "int")));
   let k8 = sb-row("a conversion cell crosses the JSON codec and still runs", (String) bl-cast-run(decode(encode(k1, bl-registry-now()), bl-registry-now())) == "42");
   let k9 = sb-row("a cell that is not a cast runs as nothing", nothing?(bl-cast-run(lit)) && nothing?(bl-cast-run(5)));
   print_str("[blueprint-syntax-band] " ++ value_str(a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + n1 + n2 + n3 + n4 + n5 + k3 + k4 + k5 + k6 + k7 + k8 + k9) ++ " of 39");
  }
 }
 sb-run();
}
