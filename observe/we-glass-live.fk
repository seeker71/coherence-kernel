; we-glass-live.fk — WE on glass as a living panel: one census per tick
; (hearth-glass-tick-s), repainted when any row moved plus a slow
; heartbeat, published to the shared bus each tick so the living Form
; Glass carries the same rows under the `we` tag.
;
; stdin lines: transcript path (blank -> newest of this checkout), channel
; root (blank -> the hearth seat), number of ticks (blank -> 1).
; preflight-exec: forbidden
; preludes: form/form-stdlib/we-glass.bml
(do
    (defn wgl-trim (s) (if (nothing? s) "" (trim s)))
    (defn wgl-or (s d) (if (eq (str_len s) 0) d s))
    (defn wgl-rows-text (rows) (if (eq (len rows) 0) "" (str_concat (int_to_str (wg-value (head rows))) (str_concat "," (wgl-rows-text (tail rows))))))
    (defn wgl-census (transcript root epoch)
        (do (let procRows (wg-process-rows (wg-ps-text)))
            (let tx (wg-transcript-text transcript))
            (let prompts (if (eq (str_len tx) 0) (sub 0 1) (wg-int tx "prompts")))
            (let edits (if (eq (str_len tx) 0) (sub 0 1) (wg-int tx "edits")))
            (let probes (if (eq (str_len tx) 0) (sub 0 1) (wg-int tx "probes")))
            (let sittingAge (if (eq (str_len tx) 0) (sub 0 1) (sub epoch (mul (file_mtime transcript) 1000))))
            (let receiptNames (wg-receipts-today (fs-list "receipts") (wg-today)))
            (let prims (wg-primitives (hearth-telemetry-root)))
            (let ownerTotal (if (eq (len prims) 0) (sub 0 1) (wg-prim-count (head prims))))
            (let rows (wg-census-of procRows ownerTotal prompts edits probes sittingAge (wg-landings-today) (len receiptNames) (wg-count-of-mode procRows "be") (wg-ledger "released") (wg-ledger "open") (wg-corpus-rows)))
            (list rows (wg-cpu-shares procRows) (wg-tool-shares (if (lt edits 0) 0 edits) (if (lt probes 0) 0 probes)) prims (wg-choices root) (wg-witness-line (wg-receipt-witnesses "receipts" receiptNames) (wg-distinct (wg-receipt-witnesses "receipts" receiptNames) (list))))))
    (defn wgl-tick (transcript root n tick prev)
        (if (gt tick n) 0
            (do (let epoch (now_unix_ms))
                (let c (wgl-census transcript root epoch))
                (let key (wgl-rows-text (nth c 0)))
                (let moved (if (str_eq key prev) 0 1))
                (let put (if (or (eq moved 1) (eq (mod tick 10) 1)) (print_str (wg-frame (nth c 0) (nth c 1) (nth c 2) (nth c 3) (nth c 4) (nth c 5))) 0))
                (let published (fgtm-publish-snapshot (hearth-telemetry-root) (WGPublisher) epoch (wg-samples (nth c 0) (nth c 1) (nth c 2) (nth c 3) (nth c 4) epoch)))
                (let held (hearth-rest-s (hearth-glass-tick-s)))
                (wgl-tick transcript root n (add tick 1) key))))
    (let transcript (wgl-or (wgl-trim (read_line)) (wg-transcript-default)))
    (let root (wgl-or (wgl-trim (read_line)) (cc-root-default)))
    (let n (str_to_int (wgl-or (wgl-trim (read_line)) "1")))
    (wgl-tick transcript root n 1 "-"))
