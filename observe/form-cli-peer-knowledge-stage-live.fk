; form-cli-peer-knowledge-stage-live.fk — drive the resident peer's strict
; source executor without opening a model, and stream its content-free stages
; while the lookup is moving.
;
; This is the CPU-only diagnostic door used when another residence holds Metal.
; It performs the same strict current-source executor call the live peer offers,
; emits begin/end lines through print_str's flushed event door, retains the same
; nodes in the framebuffer, and reports the fresh lookup count and elapsed time.
; No prompt, answer, or source bytes enter either channel.
;
; preludes: form-stdlib/form-cli-peer-agent.fk

(do
    (defn fcpks-live (concept)
        (do
            (framebuffer-clear)
            (let root (fhcs-default-root))
            (if (str_eq root "")
                (list "nothing" "body-root-unresolved" 0 0 0)
                (do
                    (let ctx (fknsc-public-context root
                        (fknq-default-artifact) 0 (fknq-max-frame-bytes)))
                    (let started (now_unix_ms))
                    (let result (fcpa-knowledge-executor ctx
                        (fknq-concept-surface concept)))
                    (let elapsed (sub (now_unix_ms) started))
                    (let events (framebuffer-events))
                    (print_str (str_concat
                        "form-peer stage-summary status="
                        (str_concat (fknq-status result)
                        (str_concat " lookups="
                        (str_concat (int_to_str (fknq-lookup-count result))
                        (str_concat " events="
                        (str_concat (int_to_str (len events))
                        (str_concat " elapsed-ms="
                        (str_concat (int_to_str elapsed) "\n")))))))))
                    (list (fknq-status result) (fknq-reason result)
                        (fknq-lookup-count result) (len events) elapsed)))))
    (fcpks-live "defn-psci-schema"))
