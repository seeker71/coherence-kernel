// thought-framebuffer.fk — the body watches a thought form, and learns how a change
// to the model changes the thinking.
//
// The cornerstone Urs and Sema named: a framebuffer over an LLM WHILE it thinks, so the
// body can self-learn how editing the model edits cognition — observe, change, observe
// the difference, learn. Over native thought execution on metal (transformer-generate.fk
// -> form-asm bytes) and streaming over any open channel, this is the body's
// access to its OWN information about its own processing — its sense of its sense.
//
// A frame is one step of a forming thought: which token was chosen, and the MARGIN by
// which it won (top-1 minus top-2) — how DECIDED the mind was at that step. A trace is
// the framebuffer of one whole thought. From it the body reads where it was sure
// (conviction) and where it wavered (hesitation) — self-observation of thinking itself.
//
// The self-LEARNING core: run the same input through two models (A, then A with one
// weight changed) and DIFF their traces. The first step where the token stream diverges
// is exactly WHERE changing the model changed the thinking. That causal link — edit ->
// cognition-change, localized to a step — is what makes the body able to teach itself.
//
// Composes the native forward pass (transformer-generate.fk) as the source of frames,
// and the frames-over-time shape of a temporal sense. All pure; proof: pending
// (no band reads this cell in this tree).
//
import form-stdlib/core.fk;
section [form.bml] {
    // ── a frame: one step of a forming thought ──
    def fb-frame(step, token, margin) = ["frame", step, token, margin];
    def fb-step(f) = f[1];
    def fb-token(f) = f[2];
    // the token id the thought chose
    def fb-margin(f) = f[3];
    // top-1 minus top-2 — how decided the mind was
    // A no-result is retained as a real frame, not erased. Token 0 is the
    // language-neutral no-result symbol; the blocked and alternate node labels
    // remain available for the next inquiry.
    def fb-stall-frame(step, blocked-node, alternate-node, top-margin, next-margin) = ["frame", step, 0, top-margin - next-margin, "no-result", blocked-node, alternate-node];
    def fb-no-result?(f) = (Comparable) fb-token(f) == 0;
    // Learning is witnessed only when the retained no-result becomes a
    // different executable choice in the replayed trace.
    def fb-alternate-learned?(before, after) = (Comparable) diverge(before, after) == 0 - 1 ? 0 : 1;
    // ── hesitation: the step the thought was LEAST sure (min margin) ──
    def hesit(trace, best-step, best-margin) = (Comparable) len(trace) == 0 ? best-step : best-margin > fb-margin(trace[0]) ? hesit(trace[1:], fb-step(trace[0]), fb-margin(trace[0])) : hesit(trace[1:], best-step, best-margin);
    def hesitation(trace) = hesit(trace[1:], fb-step(trace[0]), fb-margin(trace[0]));
    // ── conviction: the step the thought was MOST sure (max margin) ──
    def convic(trace, best-step, best-margin) = (Comparable) len(trace) == 0 ? best-step : fb-margin(trace[0]) > best-margin ? convic(trace[1:], fb-step(trace[0]), fb-margin(trace[0])) : convic(trace[1:], best-step, best-margin);
    def conviction(trace) = convic(trace[1:], fb-step(trace[0]), fb-margin(trace[0]));
    // ── divergence: the first step where two traces' tokens differ. -1 if identical.
    // this is WHERE changing the model changed the thinking. ──
    def diverge(a, b) = (Comparable) len(a) == 0 || (Comparable) len(b) == 0 ? 0 - 1 : (Comparable) fb-token(a[0]) == fb-token(b[0]) ? diverge(a[1:], b[1:]) : fb-step(a[0]);
    // did the edit change cognition at all?
    def thinking-changed?(a, b) = (Comparable) diverge(a, b) == 0 - 1 ? 0 : 1;
    // ── self-check: a thought forming, and a model edit that changes it at one step ──
    // trace A: 4 steps; margins say it wavered at step 1, was most sure at step 2.
    def tfb-trace-a() = [fb-frame(0, 5, 40), fb-frame(1, 8, 12), fb-frame(2, 3, 90), fb-frame(3, 7, 55)];
    // trace B: same model EXCEPT the edit flips the chosen token at step 3 (5->9 there).
    def tfb-trace-b() = [fb-frame(0, 5, 40), fb-frame(1, 8, 12), fb-frame(2, 3, 90), fb-frame(3, 9, 33)];
    def tfk(cond, bit) = cond ? bit : 0;
    def thought-framebuffer-check() = (Number) tfk((Comparable) len(tfb-trace-a()) == 4, 1) + (Number)     // a thought was captured, frame by frame
((Number) tfk((Comparable) hesitation(tfb-trace-a()) == 1, 10) + (Number)     // it wavered at step 1
((Number) tfk((Comparable) conviction(tfb-trace-a()) == 2, 100) + (Number)     // it was most sure at step 2
((Number) tfk((Comparable) diverge(tfb-trace-a(), tfb-trace-a()) == 0 - 1, 1000) + (Number)     // same model -> no change in thinking
tfk((Comparable) diverge(tfb-trace-a(), tfb-trace-b()) == 3, 10000))));
}
