; Warm substage profile for the two dominant qwen4exp layer organs.
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form/native/metal/model-bandwidth.fk

(do
    (defn q4hmp-drain (name before)
        (do (let n (metal_sync))
            (let after (mbw-status-int (metal_status) "gpu_busy_us_total"))
            (list (list name (sub after before) n) after)))
    (let prefix "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-")
    (let ctx (q4t-open prefix 16))
    (let warm (q4t-forward ctx 9419 0 248046 248046))
    (let aps (nth ctx 0)) (let qps (nth ctx 1)) (let gps (nth ctx 2))
    (let bs (nth ctx 3)) (let lay (nth (nth ctx 4) 0))
    (q4t-embed qps gps bs (nth (nth ctx 5) 0) warm)
    (metal_sync)
    (let t0 (mbw-status-int (metal_status) "gpu_busy_us_total"))

    (q4gj-hc-norm gps (nth bs 1) (q4tv-h (nth lay 0)) (nth bs 2) (q4t-eps-bits))
    (let a0 (q4hmp-drain "hc-norm" t0))
    (q4t-mv qps (nth lay 1) (nth bs 2) (nth bs 3))
    (let a1 (q4hmp-drain "hc-down-q8" (nth a0 1)))
    (q4gj-low-act gps (nth bs 3))
    (let a2 (q4hmp-drain "hc-silu" (nth a1 1)))
    (q4t-mv qps (nth lay 2) (nth bs 3) (nth bs 4))
    (let a3 (q4hmp-drain "hc-up-q8" (nth a2 1)))
    (q4gj-hc-mix gps (nth bs 2) (nth bs 4) (nth bs 5))
    (let a4 (q4hmp-drain "hc-gated-mean" (nth a3 1)))
    (q4t-mv qps (nth lay 3) (nth bs 2) (nth bs 6))
    (let a5 (q4hmp-drain "hc-inject-f32" (nth a4 1)))

    (q4t-mv qps (nth lay 8) (nth bs 5) (nth bs 21))
    (let m0a (q4hmp-drain "moe-route-f32" (nth a5 1)))
    (q4gj-route gps (nth bs 21) (nth bs 22) (nth bs 23))
    (let m0 (q4hmp-drain "moe-route-top10" (nth m0a 1)))
    (q4t-experts-batch aps qps gps bs lay)
    (let m1 (q4hmp-drain "moe-routed-10-batch" (nth m0 1)))
    (q4t-mv qps (nth lay 13) (nth bs 5) (nth bs 29))
    (q4t-mv qps (nth lay 14) (nth bs 5) (nth bs 30))
    (metal_enqueue (nth aps 18)
        (q4t-b16 (list (nth bs 29) (nth bs 30) (nth bs 31)) (list 640)) 640)
    (q4t-mv qps (nth lay 15) (nth bs 31) (nth bs 32))
    (q4t-mv qps (nth lay 12) (nth bs 5) (nth bs 33))
    (metal_enqueue (nth aps 23)
        (q4t-b16 (list (nth bs 32) (nth bs 28) (nth bs 33)) (list 2560)) 2560)
    (let m2 (q4hmp-drain "moe-shared" (nth m1 1)))
    (let status (metal_status))
    (q4t-close ctx)
    (list "qwen4exp-hc-moe-profile" (nth a0 0) (nth a1 0) (nth a2 0)
          (nth a3 0) (nth a4 0) (nth a5 0) (nth m0a 0) (nth m0 0)
          (nth m1 0) (nth m2 0) status))
