; qwen4exp-flash-next-glass-route-run.fk — stable no-server Qwen route with
; framebuffer/glass state around real open, prefill, decode, and release.
;
; stdin lines: model shard prefix, mode-600 prompt path, max positions, budget.
; Prompt and answer bytes never enter framebuffer nodes.
;
; preludes: form/form-stdlib/qwen4exp-flash-next-generate.bml form/form-stdlib/native-model-glass.bml

(do
    (defn q4gr-missing-line? (line)
        (if (nothing? line) 1
            (if (str_eq line "") 1 0)))

    (defn q4gr-run-resident (prompt-path budget loading src slot handle)
        (do
            (let loaded (nmg-qwen-loaded loading))
            (let _loaded-frame (nmg-glass-write-physical loaded (NMGQwen) handle "weight-open-returned"))
            (let prompt (read_file prompt-path))
            (let ids (q4tk-chat-ids src prompt))
            (let prefilling (nmg-qwen-prefilling loaded 0))
            (let _prefill-frame (nmg-glass-write-physical prefilling (NMGQwen) handle "prefix-evaluate-entered"))
            (let prefill (q4s-evaluate slot ids))
            (let resident (q4s-result-slot prefill))
            (let reasoning (nmg-qwen-reasoning prefilling (q4s-pos resident)))
            (let _reason-frame (nmg-glass-write-physical reasoning (NMGQwen) handle "prefill-returned"))
            (let result (q4x-from-prefill src prefill budget (len ids)))
            (let done (nmg-qwen-finished reasoning
                (q4s-pos (q4x-result-slot result))))
            (let _done-frame (nmg-glass-write-physical done (NMGQwen) handle "generation-returned"))
            (print_str "<|form:qwen38-answer|>\n")
            (print_str (q4x-result-text result))
            (print_str "\n<|/form:qwen38-answer|>\n")
            (let closed (q4x-close result))
            (if (not (eq closed 1))
                (list "native-qwen38-route" "failed" "close-not-confirmed"
                    "residency-handle" handle "closed" closed)
                (do
                    (let released (nmg-release done (NMGQwen)))
                    (let _released-frame (nmg-glass-write-physical-release released (NMGQwen) handle closed))
                    (list "native-qwen38-route" "server" "none"
                        "evidence" "physical" "residency-handle" handle
                        "generated" (q4x-result-generated result)
                        "stop" (q4x-result-reason result)
                        "closed" closed
                        "framebuffer-events" (len (framebuffer-events)))))))

    (defn q4gr-run (prefix prompt-path maxpos budget)
        (do
            (framebuffer-clear)
            (let native (nmg-begin-native (nmg-initial)))
            (let selected (nmg-finish-native native "request-evidence"))
            (let loading (nmg-qwen-loading selected))
            (let _loading-frame (nmg-glass-write loading))
            (let path (str_concat prefix "00001-of-00003.gguf"))
            (let src (eqr-of-file path 0 12000000))
            (let slot (q4s-open prefix maxpos))
            (let handle (q4s-residency-handle slot))
            (if (eq (q4s-resident? slot) 1)
                (q4gr-run-resident prompt-path budget loading src slot handle)
                (do
                    (let closed (q4s-close slot))
                    (list "native-qwen38-route" "refused" "no-live-weight-handle"
                        "residency-handle" handle "closed" closed)))))

    (let prefix (read_line))
    (let prompt-path (read_line))
    (let maxpos-line (read_line))
    (let budget-line (read_line))
    (let maxpos (str_to_int maxpos-line))
    (let budget (str_to_int budget-line))
    (if (or (eq (q4gr-missing-line? prefix) 1)
            (or (eq (q4gr-missing-line? prompt-path) 1)
                (or (eq (q4gr-missing-line? maxpos-line) 1)
                    (eq (q4gr-missing-line? budget-line) 1))))
        (list "native-qwen38-route" "refused" "missing-control-lines")
        (if (or (le maxpos 0) (le budget 0))
            (list "native-qwen38-route" "refused" "invalid-control-numbers")
            (q4gr-run prefix prompt-path maxpos budget))))
