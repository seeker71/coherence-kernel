; micro-thought-run.fk — what a thought costs to mint, to find and to run, and
; what a lookup costs against the walk it replaces, on artifacts this body holds.
;
; Every number here is measured in THIS process on THIS host, warm (each timed
; stretch is preceded by the same work untimed), and reported as a total over a
; repeat count large enough for a millisecond clock to see it. Four sessions share
; this GPU today, so a mint's wall time carries their weather too; where that is
; what is being measured the line says so.
;
; Read the floor first — `observe/floor-lens-run.fk` — and put its two numbers
; beside these. The machine has been seen at both 12.88 and 25.77 TFLOPS this week
; and a mint is a compile, not a dispatch, so it is the CPU's mood that moves it.
;
; preludes: form/form-stdlib/micro-thought.bml form/form-stdlib/jit-tensor-emit.fk form/form-stdlib/metal-door.fk form/form-stdlib/voice-onnx.bml form/form-stdlib/voice-phoneme.bml
(do
    (defn mr-line (k v) (print (str_concat k (str_concat "  " v))))
    (defn ms () (host_monotonic_ms))
    (defn us () (host_cpu_us))
    (defn cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (cat (tail xs)))))
    (defn n (x) (int_to_str x))

    (print "")
    (print "THOUGHT   a compiled thing, addressed by its shape")
    (mr-line "door" (if (md-door-live?) "metal handle door live" "NOT LIVE — every mint number below is void"))

    ; ---- what it costs to MINT ---------------------------------------------------
    ; N distinct texts, so one compile is visible to a millisecond clock. Each name
    ; is different, so each is a real compile and none is the carrier's cache.
    (defn mr-names (base i n acc) (if (ge i n) acc (mr-names base (add i 1) n (cons (str_concat base (int_to_str i)) acc))))
    (defn mr-emit (names acc) (if (eq (len names) 0) acc (mr-emit (tail names) (cons (list (head names) (tir-matvec-msl-fmt (head names) "f32")) acc))))
    (defn mr-mint-all (xs t) (if (eq (len xs) 0) t (mr-mint-all (tail xs) (mt-mint t (mt-address (list "matvec" "msl" "f32" (nth (head xs) 0))) (nth (head xs) 1) (nth (head xs) 0)))))

    (let warm-names (mr-names "mr_warm_" 0 4 (list)))
    (let warm (mr-mint-all (mr-emit warm-names (list)) (mt-table)))   ; untimed: device + first library

    ; A mint has TWO prices and they are two orders of magnitude apart, so this
    ; door measures both rather than quoting whichever it happened to get. macOS
    ; keeps its own on-disk cache of compiled shader source, so a kernel text this
    ; HOST has never seen is compiled for real, and the same text in any later
    ; process is handed back. Names carrying the clock are new to the host by
    ; construction; the fixed names below were compiled by the previous run.
    (let stamp (int_to_str (host_monotonic_ms)))
    (let fresh-names (mr-names (str_concat "mr_new_" (str_concat stamp "_")) 0 32 (list)))
    (let fresh-texts (mr-emit fresh-names (list)))
    (let x0 (ms))
    (let fresh-minted (mr-mint-all fresh-texts (mt-table)))
    (let x1 (ms))

    (let names (mr-names "mr_mv_" 0 32 (list)))
    (let e0 (us))
    (let texts (mr-emit names (list)))
    (let e1 (us))
    (let m0 (ms))
    (let minted (mr-mint-all texts (mt-table)))
    (let m1 (ms))
    (mr-line "emit" (cat (list (n (div (sub e1 e0) 32)) " us each, " (n (str_len (nth (head texts) 1))) " bytes of MSL (32 emitted)")))
    (mr-line "mint first" (cat (list (n (div (mul (sub x1 x0) 1000) 32)) " us — 32 kernel texts this HOST has never seen, compiled in " (n (sub x1 x0)) " ms")))
    (mr-line "mint again" (cat (list (n (div (mul (sub m1 m0) 1000) 32)) " us — the same 32 texts a previous PROCESS compiled, handed back by the system's own shader cache in " (n (sub m1 m0)) " ms")))

    ; ---- what it costs to FIND ---------------------------------------------------
    ; The fast path: the shape row is known before anything is emitted, so a find
    ; costs one native scan over interned keys and NO emission at all.
    (defn mr-find-n (t a i k acc) (if (ge i k) acc (mr-find-n t a (add i 1) k (add acc (mt-recall t a)))))
    (let a0 (mt-address (list "matvec" "msl" "f32" "mr_mv_0")))
    (let w (mr-find-n minted a0 0 1000 0))
    (let f0 (ms))
    (let fr (mr-find-n minted a0 0 100000 0))
    (let f1 (ms))
    (mr-line "find" (cat (list (n (div (mul (sub f1 f0) 1000000) 100000)) " ns against a table of 32 thoughts (100000 asks in " (n (sub f1 f0)) " ms), and NO emission")))
    (mr-line "crossover" "the FIRST reuse, in both regimes. A find is a two-hundredth of the cheapest mint and a forty-thousandth of the dearest, so an address that is asked twice has already paid for itself.")
    (mr-line "why own it" "the two mint prices above are the same texts. Which one a process gets is the host's cache's business, not this body's — both were measured here today. A table the body holds is the one number it can promise.")

    ; ---- what it costs to RUN ----------------------------------------------------
    ; A dispatch of the found thought, so "run" is a measured number and not a claim.
    (let buf-w (metal_buf_alloc 65536))
    (let buf-x (metal_buf_alloc 4096))
    (let buf-y (metal_buf_alloc 4096))
    (defn mr-run-n (h b i k) (if (ge i k) 0 (do (let e (metal_enqueue h b 64)) (mr-run-n h b (add i 1) k))))
    (let h0 (mt-recall minted a0))
    (let bind (md-bind (list buf-w buf-x buf-y) (list 64 64)))
    (let rw (mr-run-n h0 bind 0 100))
    (let sw (metal_sync))
    (let r0 (ms))
    (let rr (mr-run-n h0 bind 0 1000))
    (let sy (metal_sync))
    (let r1 (ms))
    (mr-line "run" (cat (list (n (div (mul (sub r1 r0) 1000) 1000)) " us each — 1000 dispatches of a 64x64 matvec in " (n (sub r1 r0)) " ms, one sync (this is the shared GPU's number, four sessions deep)")))

    ; ---- the port ----------------------------------------------------------------
    (print "")
    (print "PORT      the voice's graph, addressed instead of counted")
    (defn mr-repeat (op k acc) (if (le k 0) acc (mr-repeat op (sub k 1) (cons (mt-address (list op "msl" "f32")) acc))))
    (defn mr-rows (census acc) (if (eq (len census) 0) acc (mr-rows (tail census) (mr-repeat (head (head census)) (nth (head census) 1) acc))))
    (let vpath (vp-model-path "en_GB-jenny_dioco-medium"))
    (let census (if (eq (vo-model? vpath) 1) (vo-op-census vpath) (list)))
    (let rows (mr-rows census (list)))
    (let thoughts (mt-collapse rows))
    (let first-us (div (mul (sub x1 x0) 1000) 32))
    (let again-us (div (mul (sub m1 m0) 1000) 32))
    (let find-ns (div (mul (sub f1 f0) 1000000) 100000))
    (mr-line "nodes" (cat (list (n (len rows)) " nodes in the graph, over " (n (len census)) " distinct operators")))
    (mr-line "thoughts" (cat (list (n thoughts) " — the address collapses the node census to the mint census")))
    (mr-line "once" (cat (list "first sighting on this host: " (n (div (mul (len rows) first-us) 1000)) " ms a node at a time, " (n (div (mul thoughts first-us) 1000)) " ms addressed. Paid once, ever.")))
    (mr-line "per pass" (cat (list "a pass that visits all " (n (len rows)) " nodes and asks the carrier each time costs " (n (div (mul (len rows) again-us) 1000)) " ms in pipeline asks alone; through the table it is "
                                  (n (div (mul (len rows) find-ns) 1000)) " us. That one is not paid once — it is paid every utterance.")))
    (mr-line "honest" "the collapse is the emitter's promise, not the address's: it holds exactly as far as the shape row is injective, which is what mt-agrees? is for.")

    ; ---- the lookup --------------------------------------------------------------
    (print "")
    (print "LOOKUP    a real table, by address and by walk")
    (let d0 (ms))
    (let inits (vo-inits vpath))
    (let d1 (ms))
    (defn mr-name-rows (rs acc) (if (eq (len rs) 0) acc (mr-name-rows (tail rs) (cons (vo-name (head rs)) acc))))
    (let names2 (mr-name-rows inits (list)))
    (let i0 (ms))
    (let idx (ai-build names2))
    (let i1 (ms))
    (defn mr-at-n (t k i c acc) (if (ge i c) acc (mr-at-n t k (add i 1) c (add acc (str_len (ai-at t k))))))
    (defn mr-walk-n (rs k i c acc) (if (ge i c) acc (mr-walk-n rs k (add i 1) c (add acc (str_len (vo-name (vo-find rs k)))))))
    (let mid (vo-name (nth inits (div (len inits) 2))))
    (let ww (mr-at-n idx mid 0 100 0))
    (let g0 (ms))
    (let gg (mr-at-n idx mid 0 20000 0))
    (let g1 (ms))
    (let vv (mr-walk-n inits mid 0 20 0))
    (let k0 (ms))
    (let kk (mr-walk-n inits mid 0 2000 0))
    (let k1 (ms))
    (mr-line "rows" (cat (list (n (len inits)) " tensor rows, read off the voice's own 62 MB in " (n (sub d1 d0)) " ms")))
    (mr-line "index" (cat (list "built once in " (n (sub i1 i0)) " ms")))
    (mr-line "by address" (cat (list (n (div (mul (sub g1 g0) 1000000) 20000)) " ns (20000 asks in " (n (sub g1 g0)) " ms)")))
    (mr-line "by walk" (cat (list (n (div (mul (sub k1 k0) 1000000) 2000)) " ns (2000 asks in " (n (sub k1 k0)) " ms) — the door the body uses today")))
    (mr-line "by re-read" (cat (list (n (mul (sub d1 d0) 1000)) " us — opening the file again for one row")))
    (mr-line "refusal" (cat (list "a name the index does not hold answers [" (ai-at idx "no-such-tensor") "], never a neighbouring row")))
    (print "")
    0)
