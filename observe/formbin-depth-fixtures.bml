// Owned FORMBIN2 fixtures; source is data and no surveyed cell is executed.
// preludes: form-stdlib/bml/formbin-depth.bml
section [form.bml] {
 class FormbinDepthFixtures {
  def fbw-word(n) = str_concat(byte_to_str(mod(div(n, 16777216), 256)), str_concat(byte_to_str(mod(div(n, 65536), 256)), str_concat(byte_to_str(mod(div(n, 256), 256)), byte_to_str(mod(n, 256)))));
  def fbw-leaf(level, type, value) = str_concat(fbw-word(0), str_concat(fbw-word(1), str_concat(fbw-word(level), str_concat(fbw-word(type), fbw-word(value)))));
  def fbw-repeat(s, n) {
   if eq(n, 0) then "" else if eq(n, 1) then s else fbw-repeat-pair(s, n, fbw-repeat(s, div(n, 2)));
  }
  def fbw-repeat-pair(s, n, half) = str_concat(str_concat(half, half), if eq(mod(n, 2), 1) then s else "");
  def fbw-body(depth) = str_concat(fbw-repeat(str_concat(fbw-word(1), str_concat(fbw-leaf(2, 9, 1), fbw-word(1))), depth), fbw-leaf(1, 1, 42));
  def fbw-artifact(depth) = str_concat(str_concat("FORMBIN2", fbw-word(0)), fbw-body(depth));
  def fbw-row-count(rows, n) = if nil?(rows) then n else fbw-row-count(fbd-rest(rows), add(n, 1));
  def fbw-finish(source, st, quantum, rows) {
   if ge(nth(st, 4), 2) then list(st, rows) else fbw-next(source, quantum, rows, fbd-slice(source, st, quantum));
  }
  def fbw-next(source, quantum, rows, step) = fbw-finish(source, head(step), quantum, add(rows, fbw-row-count(nth(step, 1), 0)));
 }
 0;
}
