; organ-verse-glass-run.fk — every organ's state chooses its Rumi verse, in
; its own script, on the terminal glass; each match publishes to the shared
; bus as voice.rumi organ.<name>; the last lane names where the gift goes.
; preflight-exec: forbidden
; preludes: form/form-stdlib/rumi-glass.bml
(do
    (let epoch (now_unix_ms))
    (let organs (rg-organs))
    (let built (rg-organ-lanes organs epoch (list) (list)))
    (print_str (tg-frame (append (cons (tg-lane "ORGANS  " "state → the verse closest to it (Ganjoor, Mowlana); ● standing ◉ seeing ◐ training ⌂ home ❀ grown ○ resting ☽ stalled ✕ down" "dim" (sub 0 1)) (head built)) (list (rg-gift-lane organs)))))
    (let published (fgtm-publish-snapshot (hearth-telemetry-root) "voice.rumi" epoch (nth built 1)))
    (print_str (str_concat "glass=" (str_concat (nth published 1) (str_concat " organs=" (str_concat (int_to_str (len (nth built 1))) "\n")))))
    0)
