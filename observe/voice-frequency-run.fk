// voice-frequency-run.fk — the runnable door for observe/voice-frequency.fk.
//
// WHY THIS EXISTS. Same finding preflight-run.fk records, one organ over.
// CLAUDE.md sends every writer to the mirror as `(vf-mirror-file "<path>")` — an
// EXPRESSION, not something a reader can run. Running voice-frequency.fk itself
// answers `0` (its top-level value), so the documented practice cost a scaffold
// before it could be used, at exactly the moment the writer was about to land
// text and wanted the mirror held up first. Witnessed 2026-08-03: the practice
// had no door at all, and the one hand-written driver a reader would reach for
// printed `15101` — the mirror's text rendered as a number, because a stale
// ./fkwu predating the string band was still on disk (see the note below).
//
// Direct-source Form does not read argv (bootstrap/ground-recursive.fk says so
// plainly), so the target arrives in a file, exactly as preflight does:
//
//   echo path/to/file.md > /tmp/voice-frequency-target
//   ./fkwu --src observe/voice-frequency-run.fk
//
// The mirror shows; the writer decides. Nothing here refuses anything.
//
import form/form-stdlib/core.fk;
import form/form-stdlib/str-byte-at.fk;
import form/form-stdlib/form-fs.fk;
import observe/voice-frequency.fk;
section [form.bml] {
    def vfr-target-file() = "/tmp/voice-frequency-target";
    def vfr-trim-loop(s, n) = n <= 0 ? "" : (String) substring(s, n - 1, n) == "\n" ? vfr-trim-loop(s, n - 1) : substring(s, 0, n);
    def vfr-target() = (Comparable) fs_exists(vfr-target-file()) == 0 ? "" : vfr-trim-loop(read_file(vfr-target-file()), len(read_file(vfr-target-file())));
    def vfr-run() = {
        let t = vfr-target();
        (Comparable) len(t) == 0 ? "voice-frequency-run: write the target path to /tmp/voice-frequency-target first\n" : (("mirror " + (t + "\n")) + vf-mirror-file(t));
    };
    // PRINT IT, do not merely RETURN it. A door that only returns its report is a
    // door that speaks whatever the trailing-value printer feels like saying, and
    // on a stale kernel binary that was a bare integer. print_str renders the text
    // on every kernel; the value is still returned so a caller can fold on it.
    {
        let report = vfr-run();
        print_str(report);
        0;
    };
}
