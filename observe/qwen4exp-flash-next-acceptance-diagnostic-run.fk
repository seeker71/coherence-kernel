; Bounded framebuffer exchange for the acceptance contract's first 111/127.
; Payloads contain only verdict bits; no prompt or model answer enters the channel.
import "../form/form-stdlib/core.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let failed (bfc-envelope 0 4181 0 (list 111 127 16) 4181099))
  (let revise (bfc-control failed 2))
  (bfc-record-out failed 1)
  (bfc-record-in revise 2)
  ; The selected repair makes the third refusal test return witness 1 rather
  ; than returning the refused runtime value. Re-observation is the fresh band.
  (let healed (bfc-envelope 0 4182 0 (list 127 127 0) 4182099))
  (let continue (bfc-control healed 0))
  (bfc-record-out healed 3)
  (bfc-record-in continue 4)
  (list "qwen4exp-acceptance-diagnostic"
    (list "observed" 111 "expected" 127 "missing-bit" 16)
    (list "selected-action" (bfc-payload revise)
          "repair-node" (bfc-apply failed revise 4181202 4181205))
    (list "reobserved" 127 "expected" 127
          "selected-action" (bfc-payload continue)
          "healthy-node" (bfc-apply healed continue 4182000 4182005))
    (list "framebuffer-events" (len (framebuffer-events)))))
