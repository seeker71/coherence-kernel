; qwen4exp-flash-next-tensor-map-run.fk — shard-header tensor names, shapes and types.
;
; This is a bounded diagnostic companion to the aggregate census. It reads only
; the first 16 MB of each payload shard, where GGUF keeps the tensor-info table;
; tensor bytes may still be downloading. Rows are deliberately flat so a caller
; can select a tensor family without holding the whole table in a Form list.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/equireach-gguf.fk form-stdlib/model-registry.bml

(do
    (defn q4tm-root ()
        (mr-flash-next-prefix))
    (defn q4tm-path (part) (str_concat (q4tm-root) (str_concat part "-of-00003.gguf")))
    (defn q4tm-name (src off)
        (substring src (add off 8) (add (add off 8) (egg-ti-namelen src off))))
    (defn q4tm-dim (src off nd axis)
        (if (gt nd axis) (egg-ti-dim src off axis) 1))
    (defn q4tm-row (src off)
        (do
            (let nd (egg-ti-ndims src off))
            (let s0 (str_concat "T " (q4tm-name src off)))
            (let s1 (str_concat s0 (str_concat " " (int_to_str (egg-ti-type src off)))))
            (let s2 (str_concat s1 (str_concat " " (int_to_str nd))))
            (let s3 (str_concat s2 (str_concat " " (int_to_str (q4tm-dim src off nd 0)))))
            (let s4 (str_concat s3 (str_concat " " (int_to_str (q4tm-dim src off nd 1)))))
            (let s5 (str_concat s4 (str_concat " " (int_to_str (q4tm-dim src off nd 2)))))
            (let s6 (str_concat s5 (str_concat " " (int_to_str (q4tm-dim src off nd 3)))))
            (print_str s6)
            0))
    (defn q4tm-rows (src off n)
        (if (eq n 0) 0
            (do (q4tm-row src off)
                (q4tm-rows src (egg-ti-next src off) (sub n 1)))))
    (defn q4tm-shard (part)
        (do
            (let src (eqr-of-file (q4tm-path part) 0 16000000))
            (print_str (str_concat "SHARD " part))
            (q4tm-rows src (egg-tinfo-start src) (egg-tensor-count src))))
    (q4tm-shard "00002")
    (q4tm-shard "00003")
    0)
