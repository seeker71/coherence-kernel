// turn-meter-run.bml — what each turn of a conversation cost the body.
//
// stdin line 1: the transcript path (a Claude Code JSONL). One JSON line out:
// the whole reading and a row per turn — a turn opens at a person's own message
// and holds every provider message that answered it, counted once per message id,
// with the subagent transcripts it opened shown apart. The transcripts read are the
// ones observe/session-rent-run.bml reads, so the turns sum to the session's reading.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-turn-meter.bml
section [form.bml] {
 class TurnMeter {
  def tmr-go() {
   let line0 = read_line();
   let path = nothing?(line0) ? "" : trim(line0);
   print_str(json-emit-precise(ftm-reading(path)));
  }
 }
 tmr-go();
}
