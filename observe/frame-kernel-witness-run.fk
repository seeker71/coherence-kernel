; Reproduce current runtime checks with actual child exit statuses.
; Each child retains stdout/stderr/process evidence in the printed private job.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/form-cli-heal-native-process.bml
(do
 (defn fkw-check (job root stage path expected directory)
  (fkw-check-output job root stage path expected directory 0 "-"))
 (defn fkw-check-last-line (job root stage path expected directory)
  (fkw-check-output job root stage path expected directory 1 "-"))
 (defn fkw-check-input (job root stage path expected directory input)
  (fkw-check-output job root stage path expected directory 0 input))
 (defn fkw-health-line? (line)
  (if (eq (str_find line "form-organ health " 0) 0)
   (oh-valid (parse-json "runtime-health-event" (substring line 18 (str_len line)))) 0))
 (defn fkw-value-lines (lines)
  (if (nil? lines) ""
   (if (fkw-health-line? (head lines))
    (fkw-value-lines (tail lines))
    (str_concat (head lines) (if (nil? (tail lines)) "" (str_concat "\n" (fkw-value-lines (tail lines))))))))
 (defn fkw-check-output (job root stage path expected directory last-line input)
  (do
   (let rc (fhn-run-start job stage 120 directory input (list (fhn-at root "fkwu") (fhn-at root path))))
   (let out (fh-trim (fhn-read (fhn-stage-path job stage ".out"))))
   (let value (fh-trim (fkw-value-lines (split-on out "\n"))))
   (let verdict (if last-line (head (reverse (split-on value "\n"))) value))
   (list stage rc verdict expected (and (str_eq rc "0") (str_eq verdict expected)))))
 (defn fkw-all (rows) (if (nil? rows) 1 (and (nth (head rows) 4) (fkw-all (tail rows)))))
 (defn fkw-json (rows)
  (if (nil? rows) (list)
   (cons (json-node-object (list (fhn-s "stage" (nth (head rows) 0))
       (fhn-s "returncode" (nth (head rows) 1)) (fhn-s "observed" (nth (head rows) 2))
       (fhn-s "expected" (nth (head rows) 3)) (fhn-n "passed" (nth (head rows) 4))))
     (fkw-json (tail rows)))))
 (let root (fhn-root))
 (let job (fhn-unique (temp_dir) "frame-kernel-witness-" 0))
 (if (str_eq job "") (form_error "cannot allocate witness directory") 0)
 (print_str (str_concat "process-evidence=" (str_concat job "\n")))
 (fhn-command (list "/bin/ln" "-s" (fhn-at root "form") (fhn-at job "form")))
 (let archive (fhn-unique "/tmp" "fkwu-metal-cache." 0))
 (if (str_eq archive "") (form_error "cannot allocate private archive directory") 0)
 (let input (fhn-at job "archive-input.txt"))
 (if (gt (write_file input (str_concat archive "\n")) 0) 1 (form_error "cannot write archive input"))
 (let rows (list
  (fkw-check job root "ground" "bootstrap/ground.fk" "42" root)
  (fkw-check job root "recursive" "bootstrap/ground-recursive.fk" "55" root)
  (fkw-check job root "freshness" "form/form-stdlib/tests/binary-freshness-band.fk" "31" root)
  (fkw-check job root "numeric-list" "bootstrap/ground-numeric-list.fk" "[1, 2.5, [3, 4]]" root)
  (fkw-check job root "frame-reference" "form/form-stdlib/tests/frame-luma-band.fk" "127" root)
  (fkw-check job root "runtime-contexts" "form/form-stdlib/tests/form-runtime-context-band.fk" "524287" root)
  (fkw-check job root "cpu-owned-images" "form/form-stdlib/tests/jit-owned-images-band.fk" "2047" root)
  (fkw-check job root "cpu-resident-abi" "form/form-stdlib/tests/jit-resident-nodeid-band.fk" "16383" root)
  (fkw-check job root "frame-cpu" "form/form-stdlib/tests/frame-cpu-band.fk" "65535" root)
  (fkw-check job root "frame-cpu-admissions" "form/form-stdlib/tests/frame-cpu-admission-band.fk" "255" root)
  (fkw-check job root "frame-file" "form/form-stdlib/tests/frame-read-dynamic-band.fk" "127" job)
  (fkw-check job root "frame-async" "form/form-stdlib/tests/frame-metal-band.fk" "65535" root)
  (fkw-check job root "frame-shapes" "form/form-stdlib/tests/frame-metal-shape-band.fk" "1023" root)
  (fkw-check job root "frame-deadline" "form/form-stdlib/tests/frame-metal-deadline-band.fk" "511" root)
  (fkw-check job root "frame-failures" "form/form-stdlib/tests/frame-metal-failure-band.fk" "255" root)
  (fkw-check job root "frame-contexts" "form/form-stdlib/tests/frame-metal-context-band.fk" "131071" root)
  (fkw-check job root "frame-release-retry" "form/form-stdlib/tests/frame-metal-release-retry-band.fk" "4095" root)
  (fkw-check job root "pipeline-admissions" "form/native/metal/tests/pipeline-admission-lifetime-band.fk" "4095" root)
  (fkw-check job root "metal-live-versions" "form/form-stdlib/tests/metal-jit-live-band.fk" "4095" root)
  (fkw-check job root "metal-policy-thoughts" "form/form-stdlib/tests/metal-jit-choice-band.fk" "262143" root)
  (fkw-check-input job root "archive-capture" "form/form-stdlib/tests/metal-jit-cache-band.fk" "cache-stage=archive-capture\n63" root input)
  (fkw-check-input job root "archive-required-reuse" "form/form-stdlib/tests/metal-jit-cache-band.fk" "cache-stage=archive-hit-required\n63" root input)
  (fkw-check-input job root "archive-refusals" "form/form-stdlib/tests/metal-jit-refusal-band.fk" "127" root input)
  (fkw-check job root "buffer-dependencies" "form/native/metal/tests/buffer-dependency-isolation-band.fk" "4095" root)
  (fkw-check-last-line job root "metal-deadline" "form/form-stdlib/tests/metal-deadline-band.fk" "511" root)
  (fkw-check job root "mapped-view" "form/form-stdlib/tests/metal-mapped-view-band.fk" "255" root)
  (fkw-check job root "closure-roots" "form/form-stdlib/tests/closure-capture-melt-band.fk" "31" root)
  (fkw-check job root "buffer-growth" "form/form-stdlib/tests/metal-resource-lifetime-band.fk" "63" root)
  (fkw-check job root "guest-native-image" "os/hati-os/guest-native-band.fk" "255" root)))
 (let saved (fhn-write-json "docs/evidence/fkwu/checks.json" (json-node-array (fkw-json rows))))
 (print rows)
 (if (gt saved 0) 1 (form_error "cannot write current runtime witness"))
 (if (fkw-all rows) 1 (form_error "frame kernel witness refused; inspect retained stage output")))
