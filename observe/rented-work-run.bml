// One JSON line: action begin/mark/read/close, session; begin also needs
// transcript and role. Mark settles the previous phase before changing role.
// Required diagnosis/guidance is work; optional independent review is review.
// action activity publishes explicit public metadata: session, contributor,
// purpose, step, completed, needs, status working/waiting/complete. No transcript.
// preflight-exec: forbidden
import form-stdlib/bml/rented-work.bml;
section [form.bml] {
 let line=read_line();
 nothing?(line) || !jwa-valid(line) ? form_error("rented work needs a complete JSON request") : {
  let request=jvp-admitted(line);
  print_str(jv-emit(jv-str(request,"action") == "activity" ? rw-activity-request(request) : rw-report(rw-request(request))));
 };
}
