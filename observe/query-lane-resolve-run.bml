// One offline pass over the lane asks. The substrate answers when a
// recipe holds. Exploration names the chosen model and does not speak for it.
import form-stdlib/query-lane-resolve.bml;
section [form.bml] {
    def qlrr-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : qlrr-rev(xs[1:], cons(xs[0], acc));
    def qlrr-show(rows) = (Comparable) len(rows) == 0 ? 0 : {
        print(qlr-line(rows[0]));
        qlrr-show(rows[1:]);
    };
    def qlrr-main() = {
        let batch = qlr-batch();
        qlrr-show(qlrr-rev(batch[4], []));
        print("requests=" + (len(qlr-requests()).str() + (" substrate=" + (batch[0].str() + (" model=" + (batch[1].str() + (" recipe=" + (batch[2].str() + (" lanes=" + batch[3].str())))))))));
        0;
    };
    qlrr-main();
}
