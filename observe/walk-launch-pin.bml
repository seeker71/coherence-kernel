// walk-launch-pin.bml — the deliberate, witnessed pin of launchd's program and its door: the kernel and the launcher door
// that stand in this checkout are copied to launch/, the pair every walk job names, once the copies have carried a probe
// door together.
//
//   ./fkwu observe/walk-launch-pin.bml
//
// A person runs it in the walk checkout: once before the stable plists are installed (docs/launchd/README.md), and again
// only when the launcher must change. launchd holds each job to the program it spawned, matched by that program's content,
// so the jobs name launch/fkwu and the walk's build writes ./fkwu alone; the jobs read launch/walk-launch.fk, so a door main
// moved in observe/ can never fail a job at launch (form/form-stdlib/bml/host-walk-seal.bml). This door is the one writer
// of that pair: hw-pin-at copies ./fkwu to launch/fkwu.next and observe/walk-launch.fk to launch/walk-launch.next.fk,
// witnesses the pair begin a probe door as its child (the probe's line, the launcher's "ended 0", exit 0), places the pair
// only then, door first and kernel last, and says the kernel's cdhash before and after. A pin that changes the kernel's
// bytes changes the program the jobs name, so each job's next spawn is killed once while launchd records the new
// requirement (the spawn after it runs) and the repair posts a "can run in the background" notification to the person: a
// pin is chosen, never a step of the walk.
// It prints "[walk-launch-pin] pin=0 cdhash <before> -> <after>" (absent before the first pin), or "[walk-launch-pin]
// pin=refused: <why> cdhash <before> -> <after>" and ends 1 with launch/fkwu as it stood (and the door, unless the line says
// otherwise); either way it appends the row {at_unix_ms, dir, said} to .hearth/walk-launch-pin.jsonl. It reads no stdin.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/host-walk-seal.bml
section [form.bml] {
 class WalkLaunchPin {
  def wlp-run() {
   let said = hw-pin-at(hch-dir(), ".", hw-launch-door());
   let made = hch-mkdirs(".hearth");
   let kept = fhn-append(hw-pin-record(), hw-pin-row(now_unix_ms(), host_cwd(), said));
   let shown = print_str("[walk-launch-pin] " ++ said);
   let noted = (String) kept == "appended" ? 0 : print_str("[walk-launch-pin] the row was not kept in " ++ hw-pin-record() ++ ": " ++ kept);
   hw-starts?(said, "pin=0 ") ? 0 : form_error("[walk-launch-pin] refused: launch/fkwu stands as it stood");
  }
 }
 wlp-run();
}
