; native-reach-run.fk — how much can the body answer with ZERO remote
; tokens and ZERO model decode, measured by running every question it
; holds through its own live answering door.
;
; Reach here is not a shelf count: each corpus row's QUESTION goes through
; kra-corpus-word — the same door the selfheed lookup consults live — and
; counts only if the door returns that row's own fresh word. A row that
; cannot round-trip (renumber drift, token mismatch, door regression) is
; a visible miss, never silently included. Beside it, the two smaller
; native families are counted by their own doors: the rest registry
; (kra-registry) and the NL catalog (lg-catalog).
;
; The fold (hdc-field-code discipline, positional decimal):
;   reach*1e6 + misses*1e4 + registry*1e2 + catalog
;
; Born 2026-08-30 (the native-expansion focus). Vitality reading: this
; number can only grow by landing rows that ANSWER, and it shrinks the
; day a door regresses — aliveness, not completion.
;
; preludes: form-stdlib/knowledge-rest-answer.fk

(do
    (defn nrr-tokens-to-surface (ts acc first)
        (if (eq (len ts) 0) acc
            (nrr-tokens-to-surface (tail ts)
                (if (eq first 1) (head ts)
                    (str_concat acc (str_concat " " (head ts)))) 0)))
    (defn nrr-row-reach (r)
        (do (let w (kra-corpus-word
                (nrr-tokens-to-surface (hdc-q r) "" 1)))
            (if (nothing? w) 0
                (if (str_eq w (hdc-fresh r)) 1 0))))
    (defn nrr-walk (rows hits misses)
        (if (eq (len rows) 0) (list hits misses)
            (if (eq (nrr-row-reach (head rows)) 1)
                (nrr-walk (tail rows) (add hits 1) misses)
                (nrr-walk (tail rows) hits (add misses 1)))))
    (defn nrr-run ()
        (do
            (let reach (nrr-walk (hdc-rows) 0 0))
            (print (str_concat "corpus-reach=" (int_to_str (nth reach 0))))
            (print (str_concat "corpus-miss=" (int_to_str (nth reach 1))))
            (print (str_concat "registry-rows=" (int_to_str (len (kra-registry)))))
            ; The organ's reunion (2026-08-30) moved NL rows OFF the default
            ; path — "a frozen catalog of knowledge was a canary" — so the
            ; default-path catalog contribution is honestly 0 and the seed
            ; rows are printed as what they now are: rehearsal, earned back
            ; onto the path only through the soft door's equivalence gate.
            (print (str_concat "catalog-rows=" (int_to_str (len (lg-catalog)))))
            (print (str_concat "seed-rows=" (int_to_str (len (lg-seed-rows)))))
            (add (mul (nth reach 0) 1000000)
            (add (mul (nth reach 1) 10000)
            (add (mul (len (kra-registry)) 100)
                 (len (lg-catalog)))))))
    (nrr-run))
