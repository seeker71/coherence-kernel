; preludes: form/form-stdlib/core.fk form/form-stdlib/jit-tensor-emit.fk form/form-stdlib/metal-door.fk
; A probe, not a band: mint every MSL family this body emits and speak the handle. A handle > 0 is a
; kernel this host's Metal accepted; a 0 is a refusal and metal_status carries the compiler's own words.
(defn probe (label src)
  (let h (metal_pipeline src "p_k")
    (do (print label) (print h)
        (if (gt h 0) (print "ok") (print (metal_status))))))
(do
  (probe "matvec-f32"       (jte-matvec-msl-fmt "p_k" "f32"))
  (probe "matvec-f16"       (jte-matvec-msl-fmt "p_k" "f16"))
  (probe "affine-train"     (jte-affine-train-msl-fmt "p_k" "f32"))
  (probe "attn-train"       (jte-attn-train-msl-fmt "p_k" "f32"))
  (probe "block-fwd"        (jte-block-fwd-msl "p_k"))
  (probe "gqa-attn"         (jte-gqa-attn-msl "p_k"))
  (probe "ffn-fwd"          (jte-mlp-fwd-msl-fmt "p_k" "f32"))
  (probe "mlp-train"        (jte-mlp-train-msl-fmt "p_k" "f32"))
  (probe "resid-train"      (jte-resid-train-msl-fmt "p_k" "f32"))
  (probe "llama-block-fwd"  (jte-llama-block-fwd-msl "p_k"))
  (probe "llama-blk-causal" (jte-llama-block-fwd-causal-msl "p_k"))
  (probe "gqa-blk-causal"   (jte-gqa-llama-block-fwd-causal-msl "p_k"))
  (probe "llama-decode"     (jte-llama-block-decode-step-msl "p_k"))
  (probe "gqa-decode"       (jte-gqa-llama-block-decode-step-msl "p_k")))
