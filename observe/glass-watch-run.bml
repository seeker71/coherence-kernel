// glass-watch-run.bml — watch one sensor frame of the glass and print each change of one row, with the frame's
// sequence and epoch, so a value that flips is read as it flips. The glass window takes these same frames.
// stdin: one line, "<sensor> <row-name> <ms>" (ear ear.state 20000 watches the ear's state word for 20 s).
// A name that gives through the telemetry space instead (the organs do) is read there with glass-read-run.bml; the
// watch says so, with how long ago that publisher gave, rather than call an unfed sensor frame stale.
// preludes: form-stdlib/form-glass-sensor-rows.bml form-stdlib/hearth.bml form-stdlib/form-glass-telemetry-membrane.bml
section [form.bml] {
 class GlassWatch {
  // a row names itself in any of its first fields; "?" shows the frame's first two rows whole
  def gw-names?(row, name) = (String) value_kind(row) == "list" && any?(f => (String) value_kind(f) == "string" && (String) f == name, row);
  def gw-row(rows, name) = (String) name == "?" ? value_str(rows) : nil?(rows) ? "(no " + name + " row)" : gw-names?(rows[0], name) ? value_str(rows[0]) : gw-row(rows[1:], name);
  def gw-cut(v) = len(v) > 240 ? substring(v, 0, 240) : v;
  // A row's value without its last field (the cell's own address, new on every give), so a give that says the same
  // thing again is no change.
  def gw-said(v) {
   let at = str_find(v, ", @", 0);
   at < 0 ? v : substring(v, 0, at);
  }
  // [changes, gives, first epoch, last epoch, held]
  def gw-loop(sensor, name, until, held, last, seen) {
   let h = fgsr-take(sensor, held);
   let v = gw-said(gw-row(fgsr-held-rows(h), name));
   let fresh = fgsr-held-epoch(h) != fgsr-held-epoch(held);
   let said = (String) v == last ? 0 : print_str(now_unix_ms().str() + " seq=" + fgsr-held-seq(h).str() + " epoch=" + fgsr-held-epoch(h).str() + " " + gw-cut(v) + "\n");
   let next = [seen[0] + ((String) v == last ? 0 : 1), seen[1] + (fresh ? 1 : 0), seen[2] < 0 && fresh ? fgsr-held-epoch(h) : seen[2], fresh ? fgsr-held-epoch(h) : seen[3], h];
   let rested = host_sleep_ms(25);
   now_unix_ms() >= until ? next : gw-loop(sensor, name, until, h, v, next);
  }
  // the frame's own cadence against the interval its gives were seen at: past three cadences the glass reads it stale
  // fewer than two gives in the watch is an interval of the whole watch, never "no interval": a frame that gave once
  // or not at all in a watch longer than three cadences reads stale on the surface
  def gw-cadence-line(sensor, seen, ms) {
   let gives = seen[1];
   let interval = gives < 2 ? ms : (seen[3] - seen[2]) / (gives - 1);
   let cadence = fgsr-held-cadence(seen[4]);
   let said = gives < 2 ? gives.str() + " give(s) in " + ms.str() + " ms" : gives.str() + " give(s), every " + interval.str() + " ms";
   let spoke = fgtm-spoke-of(fgtm-spoken-in-space(gift_roster_names(), hearth-telemetry-root()), sensor);
   gives < 2 && spoke >= 0 ? "glass-watch " + sensor + ": its sensor frame is unfed; " + sensor + " gives through the telemetry space, last " + (now_unix_ms() - spoke).str() + " ms ago (read it with glass-read-run.bml)\n" : "glass-watch " + sensor + ": " + said + "; the frame declares " + cadence.str() + " ms" + (interval > 3 * cadence ? ": the glass reads it stale between gives" : ": in step") + "\n";
  }
 }
 let words = split-on(trim(read_line() ?? ""), " ");
 let sensor = len(words) > 0 && (String) words[0] != "" ? words[0] : "ear";
 let name = len(words) > 1 ? words[1] : "ear.state";
 let ms = len(words) > 2 ? str_to_int(words[2]) : 20000;
 let seen = gw-loop(sensor, name, now_unix_ms() + ms, [], "", [0, 0, 0 - 1, 0 - 1, []]);
 print_str("glass-watch " + sensor + " " + name + ": " + seen[0].str() + " change(s) in " + ms.str() + " ms\n" + gw-cadence-line(sensor, seen, ms));
 0;
}
