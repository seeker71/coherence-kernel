; qwen38-bmf-mechanism.fk — the shared mechanism of the live BMF crossings:
; scannerless readers over bmf-core's byte cursor, incremental lowering with
; per-element telemetry, and the instrumented matcher whose choice / cut /
; undo / timeout / strict-nothing observables are counters in the actual
; path. Defns only — the run drivers (qwen38-bmf-live-run.fk, spend baseline;
; qwen38-bmf-live-reuse-run.fk, id+KV reuse) prelude this and move.
;
; preludes: form/form-stdlib/bmf-core.fk form-stdlib/form-cli-model-generate.fk form/form-stdlib/model-registry.bml

(do
    (defn qbl-path () (mr-path (mr-find "qwen38-q8")))

    ; ---- text extraction ---------------------------------------------------
    (defn qbl-after (s marker)
        (do (let at (str_find s marker 0))
            (if (lt at 0) "" (substring s (add at (str_len marker)) (str_len s)))))
    (defn qbl-find-last-go (s marker from best)
        (do (let at (str_find s marker from))
            (if (lt at 0) best (qbl-find-last-go s marker (add at 1) at))))
    (defn qbl-find-last (s marker) (qbl-find-last-go s marker 0 (sub 0 1)))

    ; ---- byte predicates ---------------------------------------------------
    (defn qbl-ws? (b) (if (eq b 32) 1 (if (eq b 10) 1 (if (eq b 13) 1 (if (eq b 9) 1 0)))))
    (defn qbl-stop? (b) (if (lt b 0) 1 (if (qbl-ws? b) 1 (if (eq b 123) 1 (if (eq b 125) 1 0)))))

    ; ---- scannerless readers over the bmf-core cursor ---------------------
    (defn qbl-skip-ws (c)
        (if (eq (qbl-ws? (cur-peek c)) 1) (qbl-skip-ws (cur-advance c 1)) c))
    (defn qbl-word-go (c acc)
        (if (eq (qbl-stop? (cur-peek c)) 1) (list acc c)
            (qbl-word-go (cur-advance c 1) (str_concat acc (cur-peek-char c)))))
    ; braces are single-byte words of their own; everything else reads to a stop
    (defn qbl-word (c)
        (do (let c1 (qbl-skip-ws c))
            (let b (cur-peek c1))
            (if (if (eq b 123) 1 (if (eq b 125) 1 0))
                (list (cur-peek-char c1) (cur-advance c1 1))
                (qbl-word-go c1 ""))))
    (defn qbl-bytes-to-brace-go (c acc)
        (do (let b (cur-peek c))
            (if (lt b 0) (list acc c)
                (if (eq b 125) (list acc c)
                    (if (eq (qbl-ws? b) 1) (qbl-bytes-to-brace-go (cur-advance c 1) acc)
                        (qbl-bytes-to-brace-go (cur-advance c 1) (append acc (list b))))))))
    ; collects names and CONSUMES the closing brace it stops on
    (defn qbl-words-to-brace-go (c acc)
        (do (let w (qbl-word c))
            (if (str_eq (nth w 0) "}") (list acc (nth w 1))
                (if (eq (str_len (nth w 0)) 0) (list acc (nth w 1))
                    (qbl-words-to-brace-go (nth w 1) (append acc (list (nth w 0))))))))
    (defn qbl-line-to-end-go (c acc)
        (do (let b (cur-peek c))
            (if (lt b 0) (list acc c)
                (if (eq b 10) (list acc c)
                    (qbl-line-to-end-go (cur-advance c 1) (str_concat acc (cur-peek-char c)))))))
    (defn qbl-expect (c word)
        (do (let w (qbl-word c))
            (if (str_eq (nth w 0) word) (list 1 (nth w 1)) (list 0 (nth w 1)))))

    ; ---- incremental lowering ---------------------------------------------
    ; each lowered element prints its own telemetry line the moment it exists.
    ; grammar state g = (list rules top probe); rule row = (name kind data)
    (defn qbl-lower-rule (c)
        (do (let name-w (qbl-word c))
            (let name (nth name-w 0))
            (let ob (qbl-expect (nth name-w 1) "{"))
            (if (eq (nth ob 0) 0) (list "err" "rule-brace" (nth ob 1) (empty))
                (do (let kind-w (qbl-word (nth ob 1)))
                    (let kind (nth kind-w 0))
                    (let c2 (nth kind-w 1))
                    (if (str_eq kind "lit")
                        (do (let bs (qbl-bytes-to-brace-go c2 (empty)))
                            (let cb (qbl-expect (nth bs 1) "}"))
                            (if (eq (len (nth bs 0)) 1)
                                (list "ok" (list name "lit" (head (nth bs 0))) (nth cb 1) (empty))
                                (list "err" "lit-arity" (nth cb 1) (empty))))
                    (if (str_eq kind "class")
                        (do (let bs (qbl-bytes-to-brace-go c2 (empty)))
                            (let cb (qbl-expect (nth bs 1) "}"))
                            (if (ge (len (nth bs 0)) 1)
                                (list "ok" (list name "class" (nth bs 0)) (nth cb 1) (empty))
                                (list "err" "class-empty" (nth cb 1) (empty))))
                    (if (str_eq kind "seq")
                        (do (let ws (qbl-words-to-brace-go c2 (empty)))
                            (list "ok" (list name "seq" (nth ws 0)) (nth ws 1) (empty)))
                    (if (str_eq kind "alt")
                        (do (let ws (qbl-words-to-brace-go c2 (empty)))
                            (list "ok" (list name "alt" (nth ws 0)) (nth ws 1) (empty)))
                        (list "err" (str_concat "kind-" kind) c2 (empty))))))))))
    (defn qbl-say (s) (do (print s) (print "\n") 0))
    (defn qbl-lower-go (c rules top probe budget)
        (if (le budget 0) (list "to" rules top probe)
            (do (let w (qbl-word c))
                (let kw (nth w 0))
                (let c1 (nth w 1))
                (if (str_eq kw "}") (list "ok" rules top probe)
                (if (str_eq kw "") (list "err-unclosed" rules top probe)
                (if (str_eq kw "rule")
                    (do (let r (qbl-lower-rule c1))
                        (if (str_eq (nth r 0) "ok")
                            (do (let row (nth r 1))
                                (let t (qbl-say (str_concat "[lower] rule="
                                    (str_concat (nth row 0)
                                    (str_concat " kind=" (str_concat (nth row 1)
                                    (str_concat " at_byte=" (int_to_str (cur-pos (nth r 2))))))))))
                                (qbl-lower-go (nth r 2) (append rules (list row)) top probe (sub budget 1)))
                            (do (let t (qbl-say (str_concat "[lower] error=" (nth r 1))))
                                (list (str_concat "err-" (nth r 1)) rules top probe))))
                (if (str_eq kw "top")
                    (do (let tw (qbl-word c1))
                        (let t (qbl-say (str_concat "[lower] top=" (nth tw 0))))
                        (qbl-lower-go (nth tw 1) rules (nth tw 0) probe (sub budget 1)))
                (if (str_eq kw "probe")
                    (do (let pw (qbl-line-to-end-go (qbl-skip-ws c1) ""))
                        (let t (qbl-say (str_concat "[lower] probe=" (nth pw 0))))
                        (qbl-lower-go (nth pw 1) rules top (nth pw 0) (sub budget 1)))
                    (list (str_concat "err-word-" kw) rules top probe)))))))))
    (defn qbl-lower (text)
        (do (let at (qbl-find-last text "grammar"))
            (if (lt at 0) (list "err-no-grammar" (empty) "" "")
                (do (let c (cur-advance (cursor-str text) (add at 7)))
                    (let ob (qbl-expect c "{"))
                    (if (eq (nth ob 0) 0) (list "err-open-brace" (empty) "" "")
                        (qbl-lower-go (nth ob 1) (empty) "" "" 32))))))

    ; ---- the instrumented matcher ------------------------------------------
    ; st = (steps choices cuts undos); result = (tag cur st), tag ok|no|to
    (defn qbl-rule-of (rules name)
        (if (nil? rules) (empty)
            (if (str_eq (nth (head rules) 0) name) (head rules)
                (qbl-rule-of (tail rules) name))))
    (defn qbl-member (b bs)
        (if (nil? bs) 0 (if (eq (head bs) b) 1 (qbl-member (tail bs) b))))
    (defn qbl-st-step (st)
        (list (sub (nth st 0) 1) (nth st 1) (nth st 2) (nth st 3)))
    (defn qbl-st-choice (st)
        (list (nth st 0) (add (nth st 1) 1) (nth st 2) (nth st 3)))
    (defn qbl-st-cut (st)
        (list (nth st 0) (nth st 1) (add (nth st 2) 1) (nth st 3)))
    (defn qbl-st-undo (st)
        (list (nth st 0) (nth st 1) (nth st 2) (add (nth st 3) 1)))
    (defn qbl-m-seq (rules names c st)
        (if (nil? names) (list "ok" c st)
            (do (let r (qbl-m-ref rules (head names) c st))
                (if (str_eq (nth r 0) "ok")
                    (qbl-m-seq rules (tail names) (nth r 1) (nth r 2))
                    r))))
    ; choice: each alternative tried from the SAME immutable cursor; a failed
    ; branch's cursor is simply not carried forward — that discard is the undo.
    (defn qbl-m-alt (rules names c st)
        (if (nil? names) (list "no" c st)
            (do (let r (qbl-m-ref rules (head names) c (qbl-st-choice st)))
                (if (str_eq (nth r 0) "ok")
                    (list "ok" (nth r 1) (qbl-st-cut (nth r 2)))
                    (if (str_eq (nth r 0) "to") r
                        (qbl-m-alt rules (tail names) c (qbl-st-undo (nth r 2))))))))
    (defn qbl-m-ref (rules name c st)
        (if (le (nth st 0) 0) (list "to" c st)
            (do (let row (qbl-rule-of rules name))
                (if (nil? row) (list "no" c (qbl-st-step st))
                    (do (let st1 (qbl-st-step st))
                        (let kind (nth row 1))
                        (if (str_eq kind "lit")
                            (if (eq (cur-peek c) (nth row 2))
                                (list "ok" (cur-advance c 1) st1) (list "no" c st1))
                        (if (str_eq kind "class")
                            (if (eq (qbl-member (cur-peek c) (nth row 2)) 1)
                                (list "ok" (cur-advance c 1) st1) (list "no" c st1))
                        (if (str_eq kind "seq") (qbl-m-seq rules (nth row 2) c st1)
                        (if (str_eq kind "alt") (qbl-m-alt rules (nth row 2) c st1)
                            (list "no" c st1))))))))))

    ; verdict: STRICT nothing vs 0 vs 1. nothing = the budget died (timeout);
    ; 0 = the grammar answered no (or left bytes unconsumed); 1 = full match.
    (defn qbl-verdict (tag c)
        (if (str_eq tag "to") (nothing)
            (if (str_eq tag "ok") (if (eq (cur-eof? c) 1) 1 0) 0)))
    (defn qbl-verdict-str (v)
        (if (nothing? v) "nothing" (int_to_str v)))
    (defn qbl-run-match (rules top probe budget)
        (do (let r (qbl-m-ref rules top (cursor-str probe) (list budget 0 0 0)))
            (let st (nth r 2))
            (let v (qbl-verdict (nth r 0) (nth r 1)))
            (let t1 (qbl-say (str_concat "[match] tag=" (str_concat (nth r 0)
                (str_concat " verdict=" (str_concat (qbl-verdict-str v)
                (str_concat " verdict_is_nothing=" (str_concat (if (nothing? v) "1" "0")
                (str_concat " steps_used=" (str_concat (int_to_str (sub budget (nth st 0)))
                (str_concat " choice=" (str_concat (int_to_str (nth st 1))
                (str_concat " cut=" (str_concat (int_to_str (nth st 2))
                (str_concat " undo=" (str_concat (int_to_str (nth st 3))
                (str_concat " leftover_bytes=" (int_to_str
                    (if (str_eq (nth r 0) "ok")
                        (sub (str_len probe) (cur-pos (nth r 1))) (sub 0 0))))))))))))))))))))
            (list v st)))

    ; typed feedback for the model, built from what actually happened
    (defn qbl-feedback (low mres)
        (if (not (str_eq (nth low 0) "ok"))
            (str_concat "[form] lower_status=" (nth low 0))
            (do (let v (nth mres 0))
                (let st (nth mres 1))
                (str_concat "[form] lower_status=ok rules="
                (str_concat (int_to_str (len (nth low 1)))
                (str_concat " top=" (str_concat (nth low 2)
                (str_concat " probe=" (str_concat (nth low 3)
                (str_concat " match_verdict=" (str_concat (qbl-verdict-str v)
                (str_concat " choice=" (str_concat (int_to_str (nth st 1))
                (str_concat " cut=" (str_concat (int_to_str (nth st 2))
                (str_concat " undo=" (int_to_str (nth st 3))))))))))))))))))

    (defn qbl-prompt1 ()
        "You are writing in a tiny grammar meta-language. The surface is:\ngrammar {\n  rule NAME { lit X }\n  rule NAME { class ABC }\n  rule NAME { seq A B }\n  rule NAME { alt A B }\n  top NAME\n  probe INPUT\n}\nlit matches exactly one character X. class matches one character from the given set. seq matches its rules in order. alt tries its rules in order and takes the first that matches. top names the start rule. probe is one input line your grammar should match completely.\nExample, do not repeat it:\ngrammar {\n  rule d { class 0123456789 }\n  rule p { lit + }\n  rule e { seq d p d }\n  top e\n  probe 1+2\n}\nInvent a DIFFERENT tiny grammar now: different rule names, at least one alt rule, and a probe line your grammar matches completely. Output only the grammar block.")

    (defn qbl-gen (r prompt n)
        (do (let out (fcmg-generate-with r (qbl-path) prompt n))
            (let text (qbl-after (nth out 0) "text:\n"))
            (list text (nth out 1))))

    0)
