; limitation-freshness-ledger.fk — executable lifecycle for non-axiomatic gaps.
;
; A limitation is not scripture and never becomes an axiom. It is an inspected,
; dated observation whose usefulness expires. Every row carries:
;   id/node, attempted offer, observation arm, dependency inspection,
;   interface inspection, alternatives, witnessed date, and current validity.
;
; Status: 2=fresh, 1=OWED re-witness, 0=lapsed. A failed re-witness lapses
; without erasing the attempted offer, inspection, alternatives, or date.
; witnessed: 2026-07-21 -> lifecycle [2,1,0,2,1,0,3,1]; public four-arm vectors live

(do
  (defn lfl-entry (id attempted offer observation dependencies interface alternatives date valid)
    (list id attempted offer observation dependencies interface alternatives date valid))
  (defn lfl-id (r) (nth r 0))
  (defn lfl-attempted? (r) (nth r 1))
  (defn lfl-offer (r) (nth r 2))
  (defn lfl-observation (r) (nth r 3))
  (defn lfl-dependencies (r) (nth r 4))
  (defn lfl-interface (r) (nth r 5))
  (defn lfl-alternatives (r) (nth r 6))
  (defn lfl-date (r) (nth r 7))
  (defn lfl-valid (r) (nth r 8))

  (defn lfl-offer-arm (v)
    (if (eq v (nothing)) 0
      (if (eq v 0) 1 (if (eq v 1) 2 3))))
  (defn lfl-inspected? (r)
    (if (gt (len (lfl-dependencies r)) 0)
      (if (gt (len (lfl-interface r)) 0)
        (if (gt (len (lfl-alternatives r)) 0) 1 0) 0) 0))
  (defn lfl-grounded? (r)
    (if (eq (lfl-attempted? r) 1)
      (if (eq (lfl-observation r) 1) (lfl-inspected? r) 0) 0))

  (defn lfl-status (r epoch)
    (if (eq (lfl-valid r) 0) 0
      (if (eq (lfl-grounded? r) 0) 1
        (if (ge (lfl-date r) epoch) 2 1))))
  (defn lfl-rewitness (r date observed)
    (lfl-entry (lfl-id r) (lfl-attempted? r) (lfl-offer r) observed
      (lfl-dependencies r) (lfl-interface r) (lfl-alternatives r)
      date observed))

  ; Public transport makes the four acknowledgement arms observable without
  ; confusing nothing, zero, one, and a content-addressed node.
  (defn lfl-public-vector (r)
    (list (lfl-offer r) 0 1 (lfl-id r)))
)
