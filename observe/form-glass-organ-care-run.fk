// Glass reads the same current care exchange as the core interface.
// preludes: form-stdlib/bml/form-core-care.bml
section [form.bml] {
 class GlassLiveOrganCare {
  def gloc-frame(rows) = if nil?(rows) then 0 else { ohv-frame(head(rows)); gloc-frame(tail(rows)); };
 }
 let owner = ohc-open();
 let reading = occ-view-request-at(owner,json-node-object(list()));
 ohc-close(owner);
 gloc-frame(jv-items(jv-get(reading,"unease")));
 jv-emit(reading);
}
