; form-glass-organ-care-run.fk — one readable current care receipt on Glass.
;
; Scope is the declared local/offline health census, not every source file in
; the repository.  An empty attention list is intentional: this runner never
; pretends a gap has been tended.  A living care responder supplies matching
; fgoc-attention receipts and the next run makes that receipt visible.
;
; preludes: form/form-stdlib/bml/form-glass-organ-care.bml observe/form-local-offline-health-pulse.fk
(do
    (defn fgocr-from-health-row (row)
        (fgoc-organ (flohm-identity row) (flohm-state row) (flohm-source row)
            (flohm-detail row) (flohm-detail row) (flohm-gap-score row)))
    (defn fgocr-readings (rows)
        (if (eq (len rows) 0)
            (list)
            (cons (fgocr-from-health-row (head rows)) (fgocr-readings (tail rows)))))
    (defn fgocr-ids (rows)
        (if (eq (len rows) 0)
            (list)
            (cons (flohm-identity (head rows)) (fgocr-ids (tail rows)))))
    (defn fgocr-record (rows attentions line)
        (if (eq (len rows) 0)
            0
            (do
                (fb_record (intern_trivial_string (fgoc-status (head rows) attentions))
                    "form/form-stdlib/bml/form-glass-organ-care.bml" line)
                (add 1 (fgocr-record (tail rows) attentions (add line 1))))))
    (let raw (flohp-rows))
    (let readings (fgocr-readings raw))
    (let census (fgoc-census (fgocr-ids raw)))
    (let attentions (list))
    (let next (fgoc-first-status readings attentions "asking"))
    (framebuffer-clear)
    (let events (fgocr-record readings attentions 1))
    (print (list "glass-organ-care"
        "scope" "declared-local-offline-census"
        "coverage" (fgoc-coverage census readings)
        "organs" (len readings)
        "healthy" (fgoc-status-count readings attentions "healthy")
        "asking" (fgoc-status-count readings attentions "asking")
        "attention-received" (fgoc-status-count readings attentions "attention-received")
        "attention-applied" (fgoc-status-count readings attentions "attention-applied")
        "unobserved" (fgoc-status-count readings attentions "unobserved")
        "all-held" (fgoc-all-held? census readings attentions)
        "next" (if (eq (len next) 0) "nothing" (fgoc-organ-id next))
        "events" events))
    (if (eq (fgoc-coverage-complete? census readings) 1) 1 0))
