// Glass reads the same current care exchange as the core interface.
// preludes: form-stdlib/bml/form-core-care.bml
section [form.bml] {
 class GlassLiveOrganCare {
  def gloc-frame(rows) = if nil?(rows) then 0 else { oh-frame(head(rows)); gloc-frame(tail(rows)); };
 }
 let reading = occ-request-at(ohc-open(),json-node-object(list()));
 gloc-frame(json-array-elements(oh-get(reading,"unease")));
 json-emit-precise(reading);
}
