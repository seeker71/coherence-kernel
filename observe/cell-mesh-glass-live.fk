; cell-mesh-glass-live.fk — the mesh on a terminal: every channel under
; the root as a lane list folded by the terminal graphics engine, one
; sample per tick (hearth-glass-tick-s), repainted only when the census
; moved plus a slow heartbeat, and published to the glass bus each tick
; so the living Form Glass carries the same rows under the `mesh` tag.
;
; stdin lines: channel root (blank -> the hearth default), number of ticks.
; preflight-exec: forbidden
; preludes: form/form-stdlib/cell-channel-glass.bml
(do
    (defn cmg-trim (s) (if (nothing? s) "" (if (eq (str_len s) 0) "" (if (eq (str_byte_at s (sub (str_len s) 1)) 10) (substring s 0 (sub (str_len s) 1)) s))))
    (defn cmg-or (s d) (if (eq (str_len s) 0) d s))
    (defn cmg-census-text (stats)
        (if (eq (len stats) 0) ""
            (str_concat (cc-cat (list (cc-stat-name (head stats)) ":" (int_to_str (cc-stat-a-frames (head stats))) "/" (int_to_str (cc-stat-b-frames (head stats))) "/" (int_to_str (cc-stat-field-frames (head stats))) "/" (cc-stat-grammar-id (head stats)) " "))
                        (cmg-census-text (tail stats)))))
    (defn cmg-tick (root n tick prev)
        (if (gt tick n) 0
            (do (let census (cmg-census-text (cc-mesh root)))
                (let nowms (now_unix_ms))
                (let moved (if (str_eq census prev) 0 1))
                (let put (if (or (eq moved 1) (eq (mod tick 10) 1)) (print_str (ccg-mesh-frame root tick nowms)) 0))
                (let published (ccg-publish-mesh root nowms))
                (let held (hearth-rest-s (hearth-glass-tick-s)))
                (cmg-tick root n (add tick 1) census))))
    (let root (cmg-or (cmg-trim (read_line)) (cc-root-default)))
    (let n (str_to_int (cmg-or (cmg-trim (read_line)) "1")))
    (cmg-tick root n 1 "-"))
