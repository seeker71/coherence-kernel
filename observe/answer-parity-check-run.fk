; answer-parity-check-run.fk — the runnable door for observe/answer-parity-check.fk.
; stdin line 1: the answer's path. Prints how many of the nine axes the answer
; names, the receipt paths it cites and how many of them exist on disk, whether
; it names what it does not establish, and its bytes. Structure is the floor;
; the reading of the answer stays with the person.
; witnessed: 2026-09-18 -> observed
; preludes: observe/answer-parity-check.fk

(do
    (defn apcr-line (k v)
        (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (let path0 (read_line))
    (let path (if (nothing? path0) "" path0))
    (let floor (apc-floor (apc-text path)))
    (apcr-line "answer" path)
    (apcr-line "bytes" (int_to_str (nth floor 4)))
    (apcr-line "axes-named" (int_to_str (nth floor 0)))
    (apcr-line "receipts-cited" (int_to_str (nth floor 1)))
    (apcr-line "receipts-existing" (int_to_str (nth floor 2)))
    (apcr-line "names-limits" (int_to_str (nth floor 3)))
    0)
