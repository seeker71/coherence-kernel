; answer-parity-check-run.fk — the structural floor for "equal or better" on the
; pinned enquiry of docs/single-call-parity-goal.form.
; stdin line 1: the answer's path. Prints how many of the nine axes the answer
; names, the receipt paths it cites and how many of them exist on disk, whether
; it names what it does not establish, and its bytes. Structure is the floor;
; the reading of the answer stays with the person. No model, provider or
; socket is opened.
; witnessed: 2026-09-18 -> observed
; preludes: form-stdlib/core.fk

(do
    (defn apc-axes ()
        (list "quality" "volume" "frequency" "vitality" "trust" "traceability"
              "sovereignty" "resonance" "rent"))
    (defn apc-count-axes (text axes)
        (if (nil? axes) 0
            (add (if (lt (str_find text (head axes) 0) 0) 0 1)
                 (apc-count-axes text (tail axes)))))
    (defn apc-member? (xs x)
        (if (nil? xs) 0 (if (str_eq (head xs) x) 1 (apc-member? (tail xs) x))))
    (defn apc-cited (text from acc)
        (do
            (let at (str_find text "receipts/2026-" from))
            (if (lt at 0) acc
                (do
                    (let end (str_find text ".md" at))
                    (if (lt end 0) acc
                        (do
                            (let path (substring text at (add end 3)))
                            (apc-cited text (add end 3)
                                (if (eq (apc-member? acc path) 1) acc
                                    (append acc (list path))))))))))
    (defn apc-existing (paths)
        (if (nil? paths) 0
            (add (if (fs_exists (head paths)) 1 0) (apc-existing (tail paths)))))
    (defn apc-line (k v)
        (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (let path0 (read_line))
    (let path (if (nothing? path0) "" path0))
    (let text0 (if (str_eq path "") "" (read_file path)))
    (let text (if (nothing? text0) "" text0))
    (let cited (apc-cited text 0 (list)))
    (apc-line "answer" path)
    (apc-line "bytes" (int_to_str (str_len text)))
    (apc-line "axes-named" (int_to_str (apc-count-axes text (apc-axes))))
    (apc-line "receipts-cited" (int_to_str (len cited)))
    (apc-line "receipts-existing" (int_to_str (apc-existing cited)))
    (apc-line "names-limits"
        (if (or (ge (str_find text "not establish" 0) 0)
                (ge (str_find text "pending" 0) 0)) "1" "0"))
    0)
