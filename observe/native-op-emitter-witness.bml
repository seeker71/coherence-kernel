// Real publish/check/restore observations in a private disposable directory.
// preludes: form-stdlib/bml/native-op-emitter.bml form-stdlib/hearth.bml
section [form.bml] {
 class NativeOpEmitterWitness {
  def noew-try(root, name, proposed, expected) {
   let path = str_concat(root, str_concat("/", str_concat(name, ".fk")));
   let stage = str_concat(path, ".staged");
   let original = "; original bytes\n42\n";
   let a = write_file(path, original);
   let b = write_file(stage, proposed);
   let result = noe-observe-at(path, stage, original, str_concat("./fkwu ", path));
   let held = str_eq(read_file(path), if expected then proposed else original);
   print(list(name, held, result));
  }
  def noew-run() {
   let root = str_concat(HearthDir(), str_concat("/native-op-witness-", int_to_str(host_pid())));
   let made = host_dir_mkdir(root);
   if not(eq(made, 1)) then "witness directory already exists; no files changed" else noew-cases(root);
  }
  def noew-cases(root) {
   let a = noew-try(root, "compile-error", "(call_missing_native_witness)\n", 0);
   let b = noew-try(root, "value-not-one", "0\n", 0);
   let c = noew-try(root, "observed-one", "1\n", 1);
   let path = str_concat(root, "/untouched.fk");
   let original = write_file(path, "42\n");
   let missing = noe-observe-at(path, str_concat(root, "/absent"), "42\n", "./fkwu bootstrap/ground.fk");
   let fourth = print(list("missing-stage", str_eq(read_file(path), "42\n"), missing));
   str_concat("evidence=", root);
  }
 }
 noew-run();
}
