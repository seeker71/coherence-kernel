// order-band.bml — form-stdlib/bml/order.bml orders text by bytes and sorts stably. Last line: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/order.bml
section [form.bml] {
 class OrderBand {
  def ob-row(label, got, want) {
   let ok = (String) value_str(got) == (String) value_str(want) ? 1 : 0;
   let said = print_str((ok == 1 ? "ok   " : "FAIL ") ++ label ++ " got=" ++ value_str(got) ++ " want=" ++ value_str(want));
   ok;
  }
  def ob-run() {
   let a = ob-row("less", str-compare("apple", "banana"), 0 - 1);
   let b = ob-row("greater", str-compare("b", "a"), 1);
   let c = ob-row("equal", str-compare("same", "same"), 0);
   let d = ob-row("prefix first", str-compare("ab", "abc"), 0 - 1);
   let e = ob-row("empty first", str-compare("", "a"), 0 - 1);
   let f = ob-row("bytes not locale", str-compare("Z", "a"), 0 - 1);
   let g = ob-row("lt?", str-lt?("a", "b") ? 1 : 0, 1);
   let h = ob-row("sort strings", sort-strings(["pear", "apple", "fig", "apple", "Zed"]), ["Zed", "apple", "apple", "fig", "pear"]);
   let i = ob-row("sort empty", sort-strings([]), []);
   let j = ob-row("sort one", sort-strings(["x"]), ["x"]);
   let k = ob-row("sort keyed is stable", sort-keyed([["b", 1], ["a", 2], ["b", 3], ["a", 4]]), [["a", 2], ["a", 4], ["b", 1], ["b", 3]]);
   let l = ob-row("dedupe", dedupe-sorted(sort-strings(["b", "a", "b", "c", "a"])), ["a", "b", "c"]);
   print_str("[order-band] " ++ value_str(a + b + c + d + e + f + g + h + i + j + k + l) ++ " of 12");
  }
 }
 ob-run();
}
