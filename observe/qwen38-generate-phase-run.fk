; qwen38-generate-phase-run.fk — where the wall clock of one `generate` actually
; goes.  Effectful: do not preflight.
;
; MEASURED (Apple M4 Max, 2026-08-19, Qwen3.8-27B-Q8_0, one run):
;   seal re-verification (SHA-256 over 29,047,086,048 bytes)   13,362 ms
;   tokenize 54 prompt tokens                                  13,586 ms
;   open (tensor views, kernels, tables)                       15,615 ms
;   state allocation                                                8 ms
; against 7,397 ms of GPU work for the whole generation.  Setup was four times
; the inference, which is what sent residence into the standard door
; (receipts/2026-08-19-omlx-in-the-standard-path.md).  It closes what it opened.
;
; preludes: form/form-stdlib/form-cli-model-generate.fk

(do
    (let p "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let t0 (now_unix_ms))
    (let v (qaf-verify-sealed-file p))
    (let t1 (now_unix_ms))
    (let src (fcmg-src p))
    (let ids (q35-chat-ids src (fcmg-teach "Say one short sentence about the sky.")))
    (let t2 (now_unix_ms))
    (let ctx (q38-open p (add (len ids) 32)))
    (let t3 (now_unix_ms))
    (let sts (q38-new-state (nth ctx 2)))
    (let t4 (now_unix_ms))
    (print_str (str_concat "seal_verify_ms " (int_to_str (sub t1 t0))))
    (print_str (str_concat "seal_ok " (int_to_str v)))
    (print_str (str_concat "tokenize_ms " (int_to_str (sub t2 t1))))
    (print_str (str_concat "prompt_tokens " (int_to_str (len ids))))
    (print_str (str_concat "open_ms " (int_to_str (sub t3 t2))))
    (print_str (str_concat "state_ms " (int_to_str (sub t4 t3))))
    (print_str (str_concat "closed " (int_to_str (q38-close ctx sts))))
    (print_str (str_concat "close_expected " (int_to_str (q38-close-expected ctx sts))))
    0)
