; Live combined-library witness for qwen4exp graph, mixed quants and inherited
; GDN/attention/MoE pipelines. No model payload is mapped in this kernel KAT.
;
; preludes: form/native/metal/qwen4exp-flash-next-graph-jit.fk

(do
    (defn q4gjl-fill (h i n bits)
        (if (ge i n) 1
            (if (eq (metal_buf_write h (mul i 4) (md-le32 bits)) 4)
                (q4gjl-fill h (add i 1) n bits) 0)))
    (defn q4gjl-live? (ps)
        (if (eq (len ps) 0) 1
            (if (gt (head ps) 0) (q4gjl-live? (tail ps)) 0)))
    (defn q4gjl-positive? (xs)
        (if (eq (len xs) 0) 1
            (if (gt (head xs) 0) (q4gjl-positive? (tail xs)) 0)))
    (defn q4gjl-f32-first (h)
        (ewl-f32 (eqr-of-string (metal_buf_read h 0 4)) 0))
    (let d 2560)
    (let hd 10240)
    (let unit (q4gj-msl))
    (let aps (q38-pipes unit))
    (let qps (q4eq-all-pipes unit))
    (let gps (q4gj-pipes unit))
    (let emb (metal_buf_alloc (mul d 4)))
    (let hc (metal_buf_alloc (mul hd 4)))
    (let gamma (metal_buf_alloc (mul hd 4)))
    (let xn (metal_buf_alloc (mul hd 4)))
    (let low (metal_buf_alloc (mul 320 4)))
    (let gate (metal_buf_alloc (mul hd 4)))
    (let mixed (metal_buf_alloc (mul d 4)))
    (let inject (metal_buf_alloc 16))
    (let block (metal_buf_alloc (mul d 4)))
    (let plehist (metal_buf_alloc (mul (mul hd 9) 4)))
    (let plex (metal_buf_alloc (mul hd 4)))
    (let plew (metal_buf_alloc (mul (mul hd 4) 4)))
    (let pleg (metal_buf_alloc (mul hd 4)))
    (q4gjl-fill emb 0 d 1065353216)
    (q4gjl-fill gamma 0 hd 1065353216)
    (q4gjl-fill low 0 320 0)
    (q4gjl-fill gate 0 hd 0)
    (q4gjl-fill inject 0 4 0)
    (q4gjl-fill block 0 d 1065353216)
    (q4gjl-fill plehist 0 (mul hd 9) 0)
    (q4gjl-fill plex 0 hd 0)
    (q4gjl-fill plew 0 (mul hd 4) 0)
    (q4gjl-fill pleg 0 hd 0)
    (let e0 (q4gj-hc-repeat gps emb hc))
    (let e1 (q4gj-hc-norm gps hc gamma xn (md-f32-bits 0.000001)))
    (let e2 (q4gj-low-act gps low))
    (let e3 (q4gj-hc-mix gps xn gate mixed))
    (let e4 (q4gj-hc-combine gps hc block inject))
    (let e5 (q4gj-ple-conv gps plehist plex plew pleg hc))
    (let sync (metal_sync))
    (let mixv (round (mul 1000.0 (q4gjl-f32-first mixed))))
    (let hcv (round (mul 1000.0 (q4gjl-f32-first hc))))
    (let verdict
        (if (eq (q4gjl-live? aps) 1)
            (if (eq (q4gjl-live? qps) 1)
                (if (eq (q4gjl-live? gps) 1)
                    (if (eq (q4gjl-positive? (list e0 e1 e2 e3 e4 e5 sync)) 1)
                        (if (eq mixv 500) (if (eq hcv 2000) 511 0) 0)
                        0)
                    0)
                0)
            0))
    (metal_buf_free emb) (metal_buf_free hc) (metal_buf_free gamma)
    (metal_buf_free xn) (metal_buf_free low) (metal_buf_free gate)
    (metal_buf_free mixed) (metal_buf_free inject) (metal_buf_free block)
    (metal_buf_free plehist) (metal_buf_free plex) (metal_buf_free plew)
    (metal_buf_free pleg)
    (list "qwen4exp-flash-next-graph-jit-live"
        (list "attention-pipelines" (len aps) "mixed-quant-pipelines" (len qps)
              "graph-pipelines" (len gps))
        (list "mixed-x1000" mixv "combined-x1000" hcv)
        (list "metal-status" (metal_status))
        (list "verdict" verdict)))
