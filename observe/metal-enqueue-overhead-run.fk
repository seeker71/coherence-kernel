; metal-enqueue-overhead-run.fk — separate Form-to-carrier enqueue cost from
; device work using one prebuilt binding and 4096 one-thread dispatches.
;
; preludes: form-stdlib/metal-door.fk

(do
    (defn meor-msl ()
        "#include <metal_stdlib>\nusing namespace metal; kernel void form_enqueue_probe(device uint* x [[buffer(0)]], uint i [[thread_position_in_grid]]) { if (i == 0u) x[0] = x[0] + 1u; }")
    (defn meor-go (p binding n)
        (if (le n 0) 0
            (do (metal_enqueue p binding 1)
                (meor-go p binding (sub n 1)))))
    (defn meor-go-dynamic (p b n)
        (if (le n 0) 0
            (do (metal_enqueue p (md-bind16 (list b) (list n) 1 0 0 0) 1)
                (meor-go-dynamic p b (sub n 1)))))
    (let n 4096)
    (let b (metal_buf_alloc 4))
    (let p (metal_pipeline (meor-msl) "form_enqueue_probe"))
    (let binding (md-bind16 (list b) (list) 1 0 0 0))
    (let t0 (now_unix_ms))
    (let enqueued (meor-go p binding n))
    (let t1 (now_unix_ms))
    (let synced (metal_sync))
    (let t2 (now_unix_ms))
    (let dynamic (meor-go-dynamic p b n))
    (let t3 (now_unix_ms))
    (let synced-dynamic (metal_sync))
    (let t4 (now_unix_ms))
    (list "metal-enqueue-overhead" "dispatches" n
          "enqueue-ms" (sub t1 t0) "sync-ms" (sub t2 t1)
          "drained" synced "dynamic-bind-enqueue-ms" (sub t3 t2)
          "dynamic-sync-ms" (sub t4 t3) "dynamic-drained" synced-dynamic
          "status" (metal_status)))
