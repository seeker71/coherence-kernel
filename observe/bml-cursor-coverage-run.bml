// bml-cursor-coverage-run.bml — how much of the body's BML the cursor reads whole, and where it stops.
//
// The cursor (grammars/form-bml.fk) is the one reader of a form.bml, form.route or form.action section: it
// reads the body as one source with direct backtracking and the compiler lowers what it read. This mirror
// walks every .bml and .fk under a root with the kernel's own source_inventory, finds each such section
// with the compiler's own section finder, and asks the cursor to admit the body whole. An admitted body is
// lowered and passed through the comparison contract pass; a body that reads and lowers is `read`. A
// refused body is read again as far as its statements carry, and the first word the cursor could not
// read is counted, so the next rule is chosen by what the body actually writes. The cursor's own time
// over the admitted sections rides beside the counts (wall-clock: read it on a quiet machine). A count
// is attention; the writer decides.
// stdin: nothing, or one line: the root to walk (default "."), how many first words to show
// (default 16), and `all` to print every section the cursor does not read and lower whole.
// preludes: form-stdlib/source-compiler.fk form-stdlib/meaning-codes.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class BmlCursorCoverage {
  def bcc-skips() = list(".git", ".hearth", ".claude", ".cache", ".obsidian", "node_modules", "target", "dist");
  def bcc-read(path) = file_size(path) < 1 ? "" : read_file(path);
  def bcc-path(root, rel) = str_eq(root, ".") ? rel : mc-cat(list(root, "/", rel));

  // every section body the cursor reads (form.bml, form.route, form.action), found the way the
  // compiler finds it, in a .bml or a .fk that carries one
  def bcc-bodies(src, i) {
   let pos = fsc-find-section-open(src, i);
   pos < 0 ? list() : bcc-body-at(src, pos);
  }
  def bcc-body-at(src, pos) {
   let dend = fsc-find-char-from(src, "]", pos + 9);
   let dialect = fsc-sub(src, pos + 9, dend);
   let brace = fsc-find-char-from(src, "{", dend);
   let close = fsc-high-level-form-dialect?(dialect) ? fsc-bml-block-end(src, brace + 1, 0) : fsc-section-end(src, brace + 1);
   let rest = bcc-bodies(src, fsc-section-after(src, close));
   fsc-bml-contract-dialect?(dialect) ? cons(fsc-sub(src, brace + 1, close), rest) : rest;
  }

  def bcc-failed?(n) = node_eq(n, intern_trivial_string("PARSE-FAIL"));
  // how far the section's statements carry before the cursor meets a word it does not read
  def bcc-stop(body) {
   let rr = g-match-rule(form-bml-section-grammar(), "section", cursor-str(body));
   rok?(rr) ? cur-pos(skip-ws(rok-cur(rr))) : 0;
  }
  def bcc-word-end(s, i, n) = (i >= str_len(s)) || (n >= 24) ? i : cp-in-class?(str_byte_at(s, i), "bmlname") ? bcc-word-end(s, i + 1, n + 1) : i;
  def bcc-word(body, pos) {
   let e = bcc-word-end(body, pos, 0);
   e > pos ? fsc-sub(body, pos, e) : fsc-sub(body, pos, pos + 1);
  }
  def bcc-snippet(body, pos) {
   let nl = str_find(body, "\n", pos);
   let e = (nl < 0) || (nl > (pos + 72)) ? min2(str_len(body), pos + 72) : nl;
   fsc-sub(body, pos, e);
  }
  def min2(a, b) = a < b ? a : b;

  // one section's reading: (kind word snippet cursor-ms) — kind 2 read whole, 1 admitted but stops
  // in lowering, 0 refused
  def bcc-reading(body) {
   let t0 = host_monotonic_ms();
   let parsed = try g-parse-full(form-bml-section-grammar(), body) else intern_trivial_string("PARSE-FAIL");
   let t1 = host_monotonic_ms();
   bcc-failed?(parsed) ? append(bcc-refusal(body), list(0)) : bcc-admitted(body, parsed, t1 - t0);
  }
  def bcc-refusal(body) {
   let top = bcc-stop(body);
   let pos = bcc-descend(body, top, 0);
   let within = eq(pos, top) ? "" : bcc-word(body, top) ++ ">";
   list(0, within ++ bcc-word(body, pos), bcc-snippet(body, pos));
  }
  // a refused class or def block is read again from its brace, member by member or
  // statement by statement, to the first one the cursor does not read
  def bcc-at(body, i) = cur-advance(cursor-str(body), i);
  def bcc-rule-stop(rule, c) {
   let rr = g-match-rule(form-bml-section-grammar(), rule, c);
   rok?(rr) ? bcc-rule-stop(rule, rok-cur(rr)) : cur-pos(skip-ws(c));
  }
  def bcc-descend(body, pos, depth) {
   let w = bcc-word(body, pos);
   depth > 3 ? pos
   : str_eq(w, "class") ? bcc-descend-into(body, pos, str_find(body, "{", pos), "member", depth)
   : str_eq(w, "def") ? bcc-descend-def(body, pos, str_find(body, ")", pos), depth)
   : pos;
  }
  def bcc-descend-def(body, pos, close, depth) {
   let after = close < 0 ? -1 : fsc-bml-skip-trivia(body, close + 1, str_len(body));
   (after >= 0) && str_eq(fsc-sub(body, after, after + 1), "{") ? bcc-descend-into(body, pos, after, "blockstmt", depth) : pos;
  }
  def bcc-descend-into(body, pos, brace, rule, depth) {
   let p2 = brace < 0 ? pos : bcc-rule-stop(rule, bcc-at(body, brace + 1));
   p2 > pos ? bcc-descend(body, p2, depth + 1) : pos;
  }
  // the cursor's lowering passes through the comparison-contract pass, where a contract's spelling
  // (x: Number or x:Number) has become its meaning; a body that reaches its typed tree is read
  def bcc-typed(recipe) = head(fsc-bml-typed(recipe, list(), list()));
  def bcc-typed-or(parsed) = try bcc-typed(fbl-lower(parsed)) else nothing;
  def bcc-admitted(body, parsed, parse-ms) {
   let t0 = host_monotonic_ms();
   let typed = bcc-typed-or(parsed);
   let t1 = host_monotonic_ms();
   append(bcc-verdict(body, typed), list(parse-ms + (t1 - t0)));
  }
  def bcc-verdict(body, typed) = nothing?(typed) ? list(1, "(cursor-stops)", bcc-snippet(body, fsc-bml-skip-trivia(body, 0, str_len(body)))) : list(2, "", "");

  // tallies: (files sections read stops refused cursor-ms) and (word count path snippet) rows
  def bcc-tally(t, r) = list(t[0], t[1] + 1, t[2] + (eq(r[0], 2) ? 1 : 0), t[3] + (eq(r[0], 1) ? 1 : 0), t[4] + (eq(r[0], 0) ? 1 : 0), t[5] + r[3]);
  def bcc-word-row(words, word, path, snippet) = nil?(words) ? list(list(word, 1, path, snippet)) : str_eq(head(words)[0], word) ? cons(list(word, head(words)[1] + 1, head(words)[2], head(words)[3]), tail(words)) : cons(head(words), bcc-word-row(tail(words), word, path, snippet));
  def bcc-sections(v, path, bodies, t, words) = nil?(bodies) ? list(t, words) : bcc-section-then(v, path, bcc-reading(head(bodies)), tail(bodies), t, words);
  def bcc-section-then(v, path, r, rest, t, words) {
   let shown = (v && !eq(r[0], 2)) ? print_str(mc-cat(list("  ", r[1], "  ", path, "\n      ", r[2]))) : 0;
   bcc-sections(v, path, rest, bcc-tally(t, r), eq(r[0], 2) ? words : bcc-word-row(words, r[1], path, r[2]));
  }
  def bcc-files(v, root, rows, t, words) = nil?(rows) ? list(t, words) : bcc-file-then(v, root, bcc-path(root, head(head(rows))), tail(rows), t, words);
  // a source whose sections the compiler's own finder cannot bound is one refused reading
  def bcc-file-then(v, root, path, rest, t, words) {
   let bodies = try bcc-bodies(bcc-read(path), 0) else nothing;
   let t1 = list(t[0] + 1, t[1], t[2], t[3], t[4], t[5]);
   let got = nothing?(bodies) ? bcc-section-then(v, path, list(0, "(unbounded)", "the compiler's section finder stops here too", 0), list(), t1, words) : bcc-sections(v, path, bodies, t1, words);
   bcc-files(v, root, rest, head(got), got[1]);
  }

  def bcc-insert(row, top) = nil?(top) ? list(row) : row[1] > head(top)[1] ? cons(row, top) : cons(head(top), bcc-insert(row, tail(top)));
  def bcc-top(words, top) = nil?(words) ? top : bcc-top(tail(words), bcc-insert(head(words), top));
  def bcc-lines(top, n) = nil?(top) || (n < 1) ? "" : mc-cat(list("\n  ", int_to_str(head(top)[1]), "  ", head(top)[0], "  ", head(top)[2], "  | ", head(top)[3], bcc-lines(tail(top), n - 1)));

  // the stdin line's space-separated words
  def bcc-args(s) {
   let sp = str_find(s, " ", 0);
   str_len(s) == 0 ? list() : sp < 0 ? list(s) : cons(fsc-sub(s, 0, sp), bcc-args(trim(fsc-sub(s, sp + 1, str_len(s)))));
  }
  def bcc-run() {
   let words = bcc-args(trim(stdin-text()));
   let root = nil?(words) ? "." : head(words);
   let n = len(words) < 2 ? 16 : str_to_int(words[1]);
   let v = len(words) < 3 ? false : str_eq(words[2], "all");
   let got = bcc-files(v, root, append(source_inventory(root, ".bml", bcc-skips()), source_inventory(root, ".fk", bcc-skips())), list(0, 0, 0, 0, 0, 0), list());
   let t = head(got);
   print_str(mc-cat(list("[bml-cursor-coverage] files=", int_to_str(t[0]), " sections=", int_to_str(t[1]), " read=", int_to_str(t[2]), " stops=", int_to_str(t[3]), " refused=", int_to_str(t[4]), " cursor-ms=", int_to_str(t[5]))));
   print_str(mc-cat(list("[bml-cursor-coverage] first words the cursor does not read (count word first-path | there):", bcc-lines(bcc-top(got[1], list()), n))));
   t[2];
  }
 }
 bcc-run();
}
