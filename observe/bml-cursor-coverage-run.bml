// bml-cursor-coverage-run.bml — how much of the body's form.bml the cursor reads whole, and where it stops.
//
// The source compiler reads a form.bml section statement by statement over text; the cursor
// (grammars/form-bml.fk) reads it as one source with direct backtracking. This mirror walks every
// .bml under a root with the kernel's own source_inventory, finds each form.bml section with the
// compiler's own section finder, and asks the cursor to admit the body whole. An admitted body is
// lowered and compared NodeID for NodeID with the compiler's recipes, both through the comparison
// contract pass they share. A refused body is read again as far as its statements carry, and the
// first word the cursor could not read is counted, so the next rule is chosen by what the body
// actually writes. Each reader's own time over the admitted sections rides beside the counts
// (wall-clock: read it on a quiet machine). A count is attention; the writer decides.
// stdin: nothing, or one line: the root to walk (default "."), how many first words to show
// (default 16), and `all` to print every section the cursor does not yet read as the compiler does.
// preludes: form-stdlib/source-compiler.fk form-stdlib/meaning-codes.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class BmlCursorCoverage {
  def bcc-skips() = list(".git", ".hearth", ".claude", ".cache", ".obsidian", "node_modules", "target", "dist");
  def bcc-read(path) = if (file_size(path) < 1) then "" else read_file(path);
  def bcc-path(root, rel) = if str_eq(root, ".") then rel else mc-cat(list(root, "/", rel));

  // every form.bml section body of a source, found the way the compiler finds it
  def bcc-bodies(src, i) {
   let pos = fsc-find-section-open(src, i);
   if (pos < 0) then list() else bcc-body-at(src, pos);
  }
  def bcc-body-at(src, pos) {
   let dend = fsc-find-char-from(src, "]", (pos + 9));
   let dialect = fsc-sub(src, (pos + 9), dend);
   let brace = fsc-find-char-from(src, "{", dend);
   let close = if fsc-high-level-form-dialect?(dialect) then fsc-bml-block-end(src, (brace + 1), 0) else fsc-section-end(src, (brace + 1));
   let rest = bcc-bodies(src, fsc-section-after(src, close));
   if str_eq(dialect, "form.bml") then cons(fsc-sub(src, (brace + 1), close), rest) else rest;
  }

  def bcc-failed?(n) = node_eq(n, intern_trivial_string("PARSE-FAIL"));
  // how far the section's statements carry before the cursor meets a word it does not read
  def bcc-stop(body) {
   let rr = g-match-rule(form-bml-section-grammar(), "section", cursor-str(body));
   if rok?(rr) then cur-pos(skip-ws(rok-cur(rr))) else 0;
  }
  def bcc-word-end(s, i, n) = if ((i >= str_len(s)) || (n >= 24)) then i else if cp-in-class?(str_byte_at(s, i), "bmlname") then bcc-word-end(s, (i + 1), (n + 1)) else i;
  def bcc-word(body, pos) {
   let e = bcc-word-end(body, pos, 0);
   if (e > pos) then fsc-sub(body, pos, e) else fsc-sub(body, pos, (pos + 1));
  }
  def bcc-snippet(body, pos) {
   let nl = str_find(body, "\n", pos);
   let e = if ((nl < 0) || (nl > (pos + 72))) then min2(str_len(body), (pos + 72)) else nl;
   fsc-sub(body, pos, e);
  }
  def min2(a, b) = if (a < b) then a else b;

  // one section's reading: (kind word snippet) — kind 2 parity, 1 admitted apart, 0 refused
  def bcc-reading(body) {
   let t0 = host_monotonic_ms();
   let parsed = try g-parse-full(form-bml-section-grammar(), body) else intern_trivial_string("PARSE-FAIL");
   let t1 = host_monotonic_ms();
   if bcc-failed?(parsed) then append(bcc-refusal(body), list(0, 0)) else bcc-admitted(body, parsed, (t1 - t0));
  }
  def bcc-refusal(body) {
   let top = bcc-stop(body);
   let pos = bcc-descend(body, top, 0);
   let within = if eq(pos, top) then "" else str_concat(bcc-word(body, top), ">");
   list(0, str_concat(within, bcc-word(body, pos)), bcc-snippet(body, pos));
  }
  // a refused class or def block is read again from its brace, member by member or
  // statement by statement, to the first one the cursor does not read
  def bcc-at(body, i) = cur-advance(cursor-str(body), i);
  def bcc-rule-stop(rule, c) {
   let rr = g-match-rule(form-bml-section-grammar(), rule, c);
   if rok?(rr) then bcc-rule-stop(rule, rok-cur(rr)) else cur-pos(skip-ws(c));
  }
  def bcc-descend(body, pos, depth) {
   let w = bcc-word(body, pos);
   if (depth > 3) then pos
   else if str_eq(w, "class") then bcc-descend-into(body, pos, str_find(body, "{", pos), "member", depth)
   else if str_eq(w, "def") then bcc-descend-def(body, pos, str_find(body, ")", pos), depth)
   else pos;
  }
  def bcc-descend-def(body, pos, close, depth) {
   let after = if (close < 0) then -1 else fsc-bml-skip-trivia(body, (close + 1), str_len(body));
   if ((after >= 0) && str_eq(fsc-sub(body, after, (after + 1)), "{")) then bcc-descend-into(body, pos, after, "blockstmt", depth) else pos;
  }
  def bcc-descend-into(body, pos, brace, rule, depth) {
   let p2 = if (brace < 0) then pos else bcc-rule-stop(rule, bcc-at(body, (brace + 1)));
   if (p2 > pos) then bcc-descend(body, p2, (depth + 1)) else pos;
  }
  // both readings pass through the comparison-contract pass they share, where a contract's
  // spelling (x: Number or x:Number) has become its meaning
  def bcc-typed(recipe) = head(fsc-bml-typed(recipe, list(), list()));
  def bcc-typed-try(recipe) = try bcc-typed(recipe) else nothing;
  def bcc-typed-or(recipe) = if nothing?(recipe) then nothing else bcc-typed-try(recipe);
  // each reader's own time rides the reading: the cursor's parse and lowering, the
  // statement walker's recipes (the contract pass they share is not either's)
  def bcc-admitted(body, parsed, parse-ms) {
   let t0 = host_monotonic_ms();
   let lowered = try fbl-lower(parsed) else nothing;
   let t1 = host_monotonic_ms();
   let walked = try fsc-rec-do(fsc-form-bml-lines-recipes-loop(body, 0, list())) else nothing;
   let t2 = host_monotonic_ms();
   append(bcc-verdict(body, bcc-typed-or(lowered), bcc-typed-or(walked)), list((parse-ms + (t1 - t0)), (t2 - t1)));
  }
  def bcc-verdict(body, cursor, compiler) {
   if nothing?(cursor) then list(1, "(cursor-stops)", bcc-snippet(body, fsc-bml-skip-trivia(body, 0, str_len(body))))
   else if nothing?(compiler) then list(1, "(compiler-stops)", bcc-snippet(body, fsc-bml-skip-trivia(body, 0, str_len(body))))
   else if node_eq(cursor, compiler) then list(2, "", "")
   else bcc-apart(node_children(cursor), node_children(compiler), 0);
  }
  // the first statement where the two lowerings part, each emitted by the compiler's own printer
  def bcc-emit(r) = bcc-clip(try fsc-source-emit-recipe(r) else "(unprintable)", 150);
  def bcc-clip(s, n) = if (str_len(s) > n) then str_concat(fsc-sub(s, 0, n), "...") else s;
  def bcc-apart(cs, ps, k) {
   if (nil?(cs) && nil?(ps)) then list(1, "(apart)", "same statements, different root")
   else if nil?(cs) then list(1, "(apart-cursor-short)", mc-cat(list(int_to_str(k), " compiler: ", bcc-emit(head(ps)))))
   else if nil?(ps) then list(1, "(apart-compiler-short)", mc-cat(list(int_to_str(k), " cursor: ", bcc-emit(head(cs)))))
   else if node_eq(head(cs), head(ps)) then bcc-apart(tail(cs), tail(ps), (k + 1))
   else list(1, "(apart)", mc-cat(list(int_to_str(k), " cursor: ", bcc-emit(head(cs)), "\n      compiler: ", bcc-emit(head(ps)))));
  }

  // tallies: (files sections parity apart refused cursor-ms walker-ms) and
  // (word count path snippet) rows
  def bcc-tally(t, r) = list(nth(t, 0), (nth(t, 1) + 1), (nth(t, 2) + (if eq(nth(r, 0), 2) then 1 else 0)), (nth(t, 3) + (if eq(nth(r, 0), 1) then 1 else 0)), (nth(t, 4) + (if eq(nth(r, 0), 0) then 1 else 0)), (nth(t, 5) + nth(r, 3)), (nth(t, 6) + nth(r, 4)));
  def bcc-word-row(words, word, path, snippet) = if nil?(words) then list(list(word, 1, path, snippet)) else if str_eq(nth(head(words), 0), word) then cons(list(word, (nth(head(words), 1) + 1), nth(head(words), 2), nth(head(words), 3)), tail(words)) else cons(head(words), bcc-word-row(tail(words), word, path, snippet));
  def bcc-sections(v, path, bodies, t, words) = if nil?(bodies) then list(t, words) else bcc-section-then(v, path, bcc-reading(head(bodies)), tail(bodies), t, words);
  def bcc-section-then(v, path, r, rest, t, words) {
   let shown = if (v && !eq(nth(r, 0), 2)) then print_str(mc-cat(list("  ", nth(r, 1), "  ", path, "\n      ", nth(r, 2)))) else 0;
   bcc-sections(v, path, rest, bcc-tally(t, r), if eq(nth(r, 0), 2) then words else bcc-word-row(words, nth(r, 1), path, nth(r, 2)));
  }
  def bcc-files(v, root, rows, t, words) = if nil?(rows) then list(t, words) else bcc-file-then(v, root, bcc-path(root, head(head(rows))), tail(rows), t, words);
  // a source whose sections the compiler's own finder cannot bound is one refused reading
  def bcc-file-then(v, root, path, rest, t, words) {
   let bodies = try bcc-bodies(bcc-read(path), 0) else nothing;
   let t1 = list((nth(t, 0) + 1), nth(t, 1), nth(t, 2), nth(t, 3), nth(t, 4), nth(t, 5), nth(t, 6));
   let got = if nothing?(bodies) then bcc-section-then(v, path, list(0, "(unbounded)", "the compiler's section finder stops here too", 0, 0), list(), t1, words) else bcc-sections(v, path, bodies, t1, words);
   bcc-files(v, root, rest, head(got), nth(got, 1));
  }

  def bcc-insert(row, top) = if nil?(top) then list(row) else if (nth(row, 1) > nth(head(top), 1)) then cons(row, top) else cons(head(top), bcc-insert(row, tail(top)));
  def bcc-top(words, top) = if nil?(words) then top else bcc-top(tail(words), bcc-insert(head(words), top));
  def bcc-lines(top, n) = if (nil?(top) || (n < 1)) then "" else mc-cat(list("\n  ", int_to_str(nth(head(top), 1)), "  ", nth(head(top), 0), "  ", nth(head(top), 2), "  | ", nth(head(top), 3), bcc-lines(tail(top), (n - 1))));

  // the stdin line's space-separated words
  def bcc-args(s) {
   let sp = str_find(s, " ", 0);
   if (str_len(s) == 0) then list() else if (sp < 0) then list(s) else cons(fsc-sub(s, 0, sp), bcc-args(trim(fsc-sub(s, (sp + 1), str_len(s)))));
  }
  def bcc-run() {
   let words = bcc-args(trim(stdin-text()));
   let root = if nil?(words) then "." else head(words);
   let n = if (len(words) < 2) then 16 else str_to_int(nth(words, 1));
   let v = if (len(words) < 3) then false else str_eq(nth(words, 2), "all");
   let got = bcc-files(v, root, source_inventory(root, ".bml", bcc-skips()), list(0, 0, 0, 0, 0, 0, 0), list());
   let t = head(got);
   print_str(mc-cat(list("[bml-cursor-coverage] files=", int_to_str(nth(t, 0)), " sections=", int_to_str(nth(t, 1)), " parity=", int_to_str(nth(t, 2)), " apart=", int_to_str(nth(t, 3)), " refused=", int_to_str(nth(t, 4)), " cursor-ms=", int_to_str(nth(t, 5)), " walker-ms=", int_to_str(nth(t, 6)))));
   print_str(mc-cat(list("[bml-cursor-coverage] first words the cursor does not read (count word first-path | there):", bcc-lines(bcc-top(nth(got, 1), list()), n))));
   nth(t, 2);
  }
 }
 bcc-run();
}
