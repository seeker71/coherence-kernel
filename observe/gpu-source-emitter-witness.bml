// Exercise generated code and publication on private files. Numerical device
// execution has separate CUDA/Vulkan witnesses; this observes source bytes.
// preludes: form-stdlib/bml/gpu-source-emitter.bml form-stdlib/bml/form-cli-heal-native-process.bml
section [form.bml] {
 class GpuSourceEmitterWitness {
  def gsew-child(job,stage,input,argv) {
   let status = fhn-run-start(job,stage,30,fhn-root(),input,argv);
   let process = fhn-json(fhn-stage-path(job,stage,".process.json"));
   let settled = and(str_eq(fhn-string(process,"state"),"finished"),str_eq(fhn-string(json-object-get(process,"cleanup"),"state"),"released"));
   if not(settled) then form_error("GPU witness child still owns resources") else if ne(fs_remove(fhn-stage-path(job,stage,".launch.sh")),0) then form_error("GPU witness launch transport release failed") else status;
  }
  def gsew-run-child(job,stage,source,expected) {
   let path = fhn-at(job,str_concat(stage,".bml"));
   let wrote = write_file(path,source);
   if ne(wrote,str_len(source)) then form_error("GPU witness source write incomplete") else 0;
   let status = gsew-child(job,stage,"-",list("./fkwu",path));
   let output = fh-trim(fhn-read(fhn-stage-path(job,stage,".out")));
   let ok = and(str_eq(status,"0"),str_eq(output,expected));
   let row = oh-reading("gpu-source",job,stage,json-node-string(expected),json-node-string(output),json-node-int(ok),if ok then list() else list(oh-need("generated-source",oh-reference(path))),list("request-evidence","defer"),oh-reference(fhn-stage-path(job,stage,".process.json")));
   oh-voice(row);
   if ok then 1 else form_error("GPU generated-code witness refused");
  }
  def gsew-fixture(job) {
   let text = "before\r\nentry \\\"after\\\"\tend\r";
   let normalized = gse-normalize(text);
   let part = gse-recipe("gpu-example","entry",normalized);
   let unit = gse-wrap(part);
   if not(head(unit)) then form_error("GPU fixture generation refused") else 0;
   let body = str_concat(nth(unit,1),str_concat("\nsection [form.bml] {\n str_eq(gpu-example(\"chosen\"),",str_concat(json-quote-string(ne-replace-first(normalized,"entry","chosen")),");\n}\n")));
   gsew-run-child(job,"generated-escaping",body,"1");
  }
  def gsew-refusals(job) {
   let template = fhn-at(job,"source.ptx");
   let put = write_file(template,"entry entry\n");
   let entry = list("gpu-probe","entry",template);
   let absent = gse-unit(list(list("gpu-probe","missing",template)));
   let missing = gse-unit(list(list("gpu-probe","entry",fhn-at(job,"absent.ptx"))));
   let duplicate = gse-unit(list(entry,entry));
   let invalid = gse-recipe("name);evil()","entry","entry");
   let keyword = gse-recipe("if","entry","entry");
   let primitive = gse-recipe("add","entry","entry");
   let emptyMarker = gse-recipe("gpu-probe","","entry");
   let control = gse-recipe("gpu-probe","entry",str_concat("entry",byte_to_str(0)));
   let repeated = gse-recipe("gpu-probe","entry","entry entry");
   let refused = gsew-all-refused(list(absent,missing,duplicate,invalid,keyword,primitive,emptyMarker,control));
   if not(and(refused,head(repeated))) then form_error("GPU input refusal contract failed") else 0;
   let body = str_concat(nth(gse-wrap(repeated),1),"\nsection [form.bml] {\n str_eq(gpu-probe(\"chosen\"),\"chosen entry\");\n}\n");
   gsew-run-child(job,"first-marker-only",body,"1");
  }
  def gsew-all-refused(rows) = if nil?(rows) then 1 else and(not(head(head(rows))),gsew-all-refused(tail(rows)));
  def gsew-preserve(job) {
   let path = fhn-at(job,"preserved.bml");
   let original = "// existing source\n42\n";
   let wrote = write_file(path,original);
   let input = fhn-at(job,"refused.input");
   let request = write_file(input,str_concat("unknown-kind\n",str_concat(path,"\n")));
   let status = gsew-child(job,"refused-publication",input,list("./fkwu","observe/gpu-source-emitter-run.bml"));
   let ok = and(str_eq(status,"1"),and(str_eq(read_file(path),original),ge(str_find(fhn-read(fhn-stage-path(job,"refused-publication",".err")),"GPU source generation refused",0),0)));
   let reserved = gsew-preserve-name(job,path,original);
   let held = and(ok,reserved);
   oh-voice(oh-reading("gpu-source",job,"refusal-preserves-source",json-node-int(1),json-node-int(held),json-node-int(held),list(),list("request-evidence","defer"),oh-reference(path)));
   if held then 1 else form_error("GPU refused publication changed existing source or lost refusal");
  }
  def gsew-preserve-name(job,path,original) {
   let driver = fhn-at(job,"reserved-name.bml");
   let prefix = "// preludes: form-stdlib/bml/gpu-source-emitter.bml\nsection [form.bml] {\n gse-publish(list(list(\"if\",\"entry\",";
   let body = str_concat(prefix,str_concat(json-quote-string(fhn-at(job,"source.ptx")),str_concat(")),",str_concat(json-quote-string(path),");\n}\n"))));
   let wrote = write_file(driver,body);
   let status = gsew-child(job,"reserved-name","-",list("./fkwu",driver));
   and(str_eq(status,"1"),and(str_eq(read_file(path),original),ge(str_find(fhn-read(fhn-stage-path(job,"reserved-name",".err")),"GPU source generation refused",0),0)));
  }
  def gsew-band(job,stage,path,expected) {
   let input = fhn-at(job,str_concat(stage,".input"));
   let wrote = write_file(input,str_concat(path,"\n"));
   let preflight = gsew-child(job,str_concat(stage,"-preflight"),input,list("./fkwu","observe/preflight-stdin-run.fk"));
   if not(str_eq(preflight,"0")) then form_error("GPU source preflight refused") else 0;
   let status = gsew-child(job,stage,"-",list("./fkwu",path));
   let output = fh-trim(fhn-read(fhn-stage-path(job,stage,".out")));
   let ok = and(str_eq(status,"0"),str_eq(output,expected));
   oh-voice(oh-reading("gpu-source",job,stage,json-node-string(expected),json-node-string(output),json-node-int(ok),list(),list("request-evidence","defer"),oh-reference(path)));
   if ok then 1 else form_error("GPU source canonical byte comparison failed");
  }
  def gsew-run() {
   let job = fhn-unique(".hearth","gpu-source-witness-",0);
   if str_eq(job,"") then form_error("GPU witness directory unavailable") else 0;
   let escapes = gsew-fixture(job);
   let refusal = gsew-refusals(job);
   let preserved = gsew-preserve(job);
   let ptx = gsew-band(job,"ptx","form/form-stdlib/tests/form-ptx-band.fk","8191");
   let block = gsew-band(job,"ptx-block","form/form-stdlib/tests/form-ptx-block-band.fk","3");
   let glsl = gsew-band(job,"glsl","form/form-stdlib/tests/form-glsl-band.fk","7");
   let ffn = gsew-band(job,"glsl-ffn","form/form-stdlib/tests/form-glsl-ffn-fwd-band.fk","7");
   print(str_concat("GPU source evidence=",job));
   add(escapes,add(refusal,add(preserved,add(ptx,add(block,add(glsl,ffn))))));
  }
 }
 gsew-run();
}
