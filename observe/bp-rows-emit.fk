; bp-rows-emit: the body emits its own bootstrap-rows data file from the
; LIVE table — no hand transcription can drift what a walk wrote. Pass
; the target path on stdin line 1; the emitted shape is one row per
; line, "name pkg level ty inst", the exact fields fol-bp-row holds.
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
(do
    (defn bre-row-line (r)
        (str_concat (nth r 0)
        (str_concat " " (str_concat (int_to_str (nth r 1))
        (str_concat " " (str_concat (int_to_str (nth r 2))
        (str_concat " " (str_concat (int_to_str (nth r 3))
        (str_concat " " (str_concat (int_to_str (nth r 4)) (byte_to_str 10)))))))))))
    (defn bre-lines (rows acc)
        (if (eq (len rows) 0) acc
            (bre-lines (tail rows) (str_concat acc (bre-row-line (head rows))))))
    (let target (read_line))
    (let w (write_file_text target (bre-lines FOL-BP-ROWS "")))
    (list (len FOL-BP-ROWS) w))
