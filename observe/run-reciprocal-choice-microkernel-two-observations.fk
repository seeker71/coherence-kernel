; Runs the two linked observations and records offer/ack directions in the
; framebuffer. Payloads carry only ids and measurements, never prompt content.
import "../cognition/reciprocal-choice-microkernel.fk"
import "../cognition/reciprocal-choice-microkernel-observations.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let o1 (rcmo-observation-one))
  (let out1 (bfc-envelope 0 1 0
    (list (rcm-choice-mode (rcm-o-receiver o1))
          (rcm-o-budget o1) (rcm-o-output o1) (rcm-o-provenance o1))
    (rcm-o-next-point o1)))
  (let in1 (bfc-control out1 0))
  (bfc-record-out out1 1)
  (bfc-record-in in1 2)

  (let o2 (rcmo-observation-two))
  (let out2 (bfc-envelope 0 2 0
    (list (rcm-choice-mode (rcm-o-receiver o2))
          (rcm-o-budget o2) (rcm-o-output o2) (rcm-o-provenance o2))
    (rcm-o-next-point o2)))
  (let in2 (bfc-control out2 0))
  (bfc-record-out out2 3)
  (bfc-record-in in2 4)

  (list
    "reciprocal-choice-two-observations"
    (list "observation-1" o1
      "receiver-source" (rcm-source-name (rcm-choice-source (rcm-o-receiver o1)))
      "declared-charge-policy-selected" (rcm-selected-from-declared-charges? (rcm-o-receiver o1))
      "fixture-outcome-predicate-met" (rcm-fixture-outcome-predicate-met? o1)
      "state-expression" (rcm-state-expression (rcm-choice-state (rcm-o-receiver o1)))
      "next-choice-point" (rcm-o-next-choice-point o1))
    (list "observation-2" o2
      "offerer-source" (rcm-source-name (rcm-choice-source (rcm-o-offerer o2)))
      "receiver-source" (rcm-source-name (rcm-choice-source (rcm-o-receiver o2)))
      "declared-charge-policy-selected" (rcm-selected-from-declared-charges? (rcm-o-receiver o2))
      "fixture-outcome-predicate-met" (rcm-fixture-outcome-predicate-met? o2)
      "state-expression" (rcm-state-expression (rcm-choice-state (rcm-o-receiver o2)))
      "next-choice-point" (rcm-o-next-choice-point o2))
    (list "mode-switched" (rcm-mode-switched? o1 o2)
      "receiver-budget-changed" (rcm-receiver-budget-changed? o1 o2)
      "channel-budget-changed" (rcm-channel-budget-changed? o1 o2))
    (list "framebuffer-events" (len (framebuffer-events)))
    (if (and (eq (rcm-mode-switched? o1 o2) 1)
      (and (eq (rcm-channel-budget-changed? o1 o2) 1)
           (eq (len (framebuffer-events)) 4))) 1 0)))
