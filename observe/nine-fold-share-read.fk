; nine-fold-share-read.fk — fold this sitting's share event counts as a reading.
; Presented census, not a target. Not a law. Not physics.
; preludes: form-stdlib/core.fk form-stdlib/nine-fold.fk
;
; Native/local/remote event counts from form-cli-share-run on this host,
; written here as the sitting's own reading so the fold meets living numbers.

(do
    (let native 211)
    (let local 353)
    (let remote 27)
    (let reading (nf-read native local remote))
    (print (list "schema" "nine-fold-share-read-v1"
        "events" (list native local remote)
        "folded" reading
        "law?" 0))
    reading)
