// Passive observation utilities shared by the care and health lifetime witnesses.
// preludes: form-stdlib/bml/form-core-care.bml form-stdlib/qwen35-artifact-seal-reader.fk
section [form.bml] {
 class CareWitnessCommon {
  def ccw-assert(ok,message) = if ok then 1 else form_error(message);
  def ccw-write(path,text) = ccw-assert(eq(write_file(path,text),str_len(text)),"changing care witness write incomplete");
  def ccw-pad(n) = if le(n,0) then "" else if eq(n,1) then " " else { let half = ccw-pad(div(n,2)); str_concat(half,str_concat(half,if eq(mod(n,2),1) then " " else "")); };
  def ccw-source(root,path,generation) = oh-set(oh-set(ohc-source(root,path),"publisher",json-node-string("changing-care-witness")),"generation",json-node-string(generation));
  def ccw-discovery(source) = json-node-object(list(oh-s("coverage","owned-local-source"),json-node-pair("sources",json-node-array(list(source)))));
  def ccw-event(root,index) {
   let payload = str_concat("native care write ",int_to_str(index)); let data = str_concat(root,"/payload");
   ccw-write(data,payload); let actual = read_file(data); let exact = str_eq(actual,payload);
   let id = str_concat(root,str_concat(":",int_to_str(index))); let at = now_unix_ms();
   let row = jv-object(list(jv-s("schema","organ-health-v1"),jv-s("id",id),jv-s("organ","care-changing-witness"),jv-s("flow",root),jv-s("aspect","local-write-readback"),jv-s("stage","observe"),jv-n("expected",str_len(payload)),jv-n("observed",str_len(actual)),jv-n("health",exact),jv-n("surprise",not(exact)),jv-pair("needs",jv-array(list())),jv-pair("offers",jv-array(list())),jv-s("selected",""),jv-pair("evidence",jv-object(list(jv-s("path",data)))),jv-n("observed_at_ms",at),jv-n("at_ms",at)));
   ccw-assert(exact,"actual payload readback differed");
   let text = str_concat(jv-emit(row),"\n");
   ccw-assert(eq(sbt-append-count(str_concat(root,"/observations.jsonl"),text),str_len(text)),"observed event retention incomplete");
   list(id,text);
  }
  def ccw-sum(rows,stage,key) = if nil?(rows) then 0 else add(jv-str(jv-get(head(rows),stage),key),ccw-sum(tail(rows),stage,key));
  def ccw-stage(rows,stage) = jv-object(list(jv-n("primary_mints",ccw-sum(rows,stage,"primary_mints")),jv-n("record_constructor_dispatches",ccw-sum(rows,stage,"record_constructor_dispatches")),jv-n("float_boxes",ccw-sum(rows,stage,"float_boxes")),jv-n("elapsed_ms",ccw-sum(rows,stage,"elapsed_ms")),jv-n("read_bytes",ccw-sum(rows,stage,"read_bytes")),jv-n("emitted_bytes",ccw-sum(rows,stage,"emitted_bytes"))));
  def ccw-bind(path) = jv-object(list(jv-s("path",path),jv-n("bytes",file_size(path)),jv-s("sha256",qaf-string-hex(saj-file-digest-any-tail(path,file_size(path))))));
  def ccw-bindings(paths) = if nil?(paths) then list() else cons(ccw-bind(head(paths)),ccw-bindings(tail(paths)));
 }
 0;
}
