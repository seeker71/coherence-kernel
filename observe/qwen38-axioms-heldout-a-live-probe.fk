; qwen38-axioms-heldout-a-live-probe.fk -- bounded witness around the exact
; heldout-A seam of the complete axioms crossing.
;
; This deliberately stops before heldout-B, curriculum, generative Form, and
; native recipe execution.  It prints immediately before and after the
; source-bound resident call, then exposes only typed counters/hashes and
; releases the returned residence.  If the after row never appears, the fault
; is inside fka1l-heldout rather than its downstream crossing validation.
;
; Effectful run cell: invoke directly; do not preflight.
; preludes: observe/qwen38-axioms-one-family-complete-live-run.fk

(do
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let model-id "qwen3.8-27b-q8_0-form-native-metal-jit")
    (let started (now_unix_ms))
    (let binding (fkfne-binding-for-family (fka1-family) "metal"))
    (let run-id (fka1l-run-id started model-id binding))
    (fka1l-line "probe-stage" "before-context-open")
    (let residence0 (fka1l-open-residence path (fka1l-maxpos)))
    (let open-live (fcmr-live? residence0))
    (fka1l-int "probe-context-live" open-live)
    (if (not (eq open-live 1))
        (do
            (fka1l-line "probe-status" "context-open-refused")
            (nothing))
        (do
            (let row (fkhe-find-row "h01" (fkhe-rows)))
            (let presentation (head (fkp30-presentations-row row)))
            (let session-id (fkp30-session-id-for run-id model-id))
            (fka1l-line "probe-stage" "before-heldout-a")
            (let heldout (fka1l-heldout presentation residence0 path model-id
                run-id session-id))
            (fka1l-line "probe-stage" "after-heldout-a")
            (let trial (fka1l-heldout-trial heldout))
            (let residence1 (fka1l-heldout-residence heldout))
            (fka1l-line "probe-output-sha" (fkp30-trial-output-sha trial))
            (fka1l-int "probe-generated-tokens"
                (fkp30-trial-generated-tokens trial))
            (fka1l-int "probe-state-released"
                (fkp30-trial-state-released trial))
            (fka1l-int "probe-present" (fkp30-trial-present trial))
            (fka1l-int "probe-trial-valid" (fkp30-trial-valid? trial))
            (fka1l-int "probe-score95" (fka1-trial-score95? trial))
            (fka1l-int "probe-issue" (fka1l-heldout-issue trial))
            (fka1l-int "probe-latency-ms" (fka1l-heldout-latency heldout))
            (let released (fcmr-release-ok? residence1))
            (fka1l-int "probe-release-ok" released)
            (print (metal_status))
            0)))
