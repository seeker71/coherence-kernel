; Real DS4 descriptor lookup baseline: resolve the actual layer-0 plan eight
; times, matching the old per-position ownership shape without opening a
; second Metal session.
; preludes: native/metal/dsv4-layer-walk.fk

(do
    (defn dlwp-before-repeat (src descs remaining checksum)
        (if (eq remaining 0) checksum
            (do
                (let plan (dlw-layer-plan src descs 0))
                (dlwp-before-repeat src descs (sub remaining 1)
                    (add checksum (dlp-view (nth plan 1)))))))
    (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
    (let base (egg-data-base src (gm-alignment)))
    (let descs (dlp-collect src base (egg-tinfo-start src) (egg-tensor-count src)))
    (print_str (str_concat "REAL before-checksum="
        (int_to_str (dlwp-before-repeat src descs 8 0)))))
