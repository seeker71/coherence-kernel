; Distinguishes model-wide cold residency from a per-layer first-touch cost.
; Two token positions cross layers 0 and 1 in one native Metal session.
; preludes: native/metal/dsv4-native-session.fk

(do
    (dns-open)
    (dlw-live-prefill (list 0 1) 2)
    (print_str "CANDIDATE dsv4-layer-plan-two-layer-live")
    (print_str "positions=2")
    (print_str "layers=2")
    (print_str "network=0")
    (print_str "remote=0")
    (print_str "rewitness-offer=dsv4-layer-plan-two-layer-live")
    (print_str (metal_model_close)))
