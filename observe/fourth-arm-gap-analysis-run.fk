// Survey path on stdin; blank/EOF uses the historical survey path.
// Reads and lowers source only. Final 1 = complete selected source slice;
// 0 = unavailable/partial; -1 = report write failed. No band pass is implied.
import form-stdlib/bml/fourth-arm-gap-analysis.bml;
section [form.bml] {
    fga-run(read_line());
}
