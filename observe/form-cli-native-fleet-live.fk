; form-cli-native-fleet-live.fk -- physical BML witness for two native local
; model contexts.  It emits no prompt or answer bytes, only admission, one
; token-per-seat evidence, positions, and release.
;
; stdin: alpha GGUF, beta GGUF, bootstrap, direct task, max positions, gas.
; preludes: form-stdlib/bml/form-cli-native-fleet-live.bml

(do
    (defn fcnflr-line (name value)
        (print_str (str_concat "form-fleet "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fcnflr-int (name value) (fcnflr-line name (int_to_str value)))
    (let alpha-path (read_line))
    (let beta-path (read_line))
    (let bootstrap (read_line))
    (let task (read_line))
    (let maxpos-line (read_line))
    (let gas-line (read_line))
    (let maxpos (if (or (nothing? maxpos-line) (str_eq maxpos-line "")) 256
        (str_to_int maxpos-line)))
    (let gas (if (or (nothing? gas-line) (str_eq gas-line "")) 1
        (str_to_int gas-line)))
    (let before (metal_status))
    (let result (fcnfl-run alpha-path beta-path bootstrap task maxpos gas))
    (let alpha (fcnfl-alpha result))
    (let beta (fcnfl-beta result))
    (let after (metal_status))
    (fcnflr-line "status" (fcnfl-status result))
    (fcnflr-line "reason" (fcnfl-reason result))
    (fcnflr-int "admitted-seats" (fcmf-seat-count (fcnfl-fleet result)))
    (fcnflr-int "alpha-live" (if (nothing? alpha) 0 (fcdq-live? alpha)))
    (fcnflr-int "beta-live" (if (nothing? beta) 0 (fcdq-live? beta)))
    (fcnflr-int "alpha-token-count" (if (nothing? alpha) 0 (fcnfl-token-count alpha)))
    (fcnflr-int "beta-token-count" (if (nothing? beta) 0 (fcnfl-token-count beta)))
    (fcnflr-int "alpha-pos" (if (nothing? alpha) 0 (fcms-pos (fcdq-session alpha))))
    (fcnflr-int "beta-pos" (if (nothing? beta) 0 (fcms-pos (fcdq-session beta))))
    (fcnflr-int "released" (fcnfl-released result))
    (fcnflr-line "metal-before" before)
    (fcnflr-line "metal-after" after)
    0)
