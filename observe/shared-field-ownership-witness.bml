// First admissions use fresh identities; no later canonical construction can mask a lost tail.
// preludes: form/form-stdlib/bml/shared-field-ownership.bml
section [form.bml] {
 class SharedTailIndependent {
  def sti-run() {
   let category = intern_trivial_string(str_concat("shared-tail-independent-",int_to_str(host_pid())));
   let source = intern_node(category,list(intern_trivial_int(11),intern_trivial_int(22),intern_trivial_int(33)));
   let shared = node_children(source);
   let mixed = cons(intern_trivial_int(44),cons(intern_trivial_int(55),shared));
   let received = node_children(intern_node(category,mixed));
   sht-check("two-local-prefix-cells",and(eq(len(received),5),value_eq(received,mixed)),5,len(received));
   let nested = list(mixed,shared,source);
   let observed = node_children(intern_node(category,nested));
   sht-check("nested-local-shared-list",and(eq(len(observed),3),value_eq(head(observed),mixed)),5,len(head(observed)));
   sht-check("nested-shared-list",value_eq(nth(observed,1),shared),3,len(nth(observed,1)));
   sht-check("nested-node-retained",node_eq(nth(observed,2),source),1,node_eq(nth(observed,2),source));
   let scalarPrefix = cons("owned string",cons(1.25,cons(-7,shared)));
   let scalars = node_children(intern_node(category,scalarPrefix));
   sht-check("scalar-prefix-and-shared-tail",value_eq(scalars,scalarPrefix),6,len(scalars));
   let other = intern_trivial_string(str_concat("shared-tail-other-",int_to_str(host_pid())));
   let onlyShared = node_children(intern_node(other,shared));
   sht-check("already-shared-list",value_eq(onlyShared,shared),3,len(onlyShared));
   let local = list(91,92,93,94);
   let localObserved = node_children(intern_node(category,local));
   sht-check("all-local-list",value_eq(localObserved,local),4,len(localObserved));
   let vacant = node_children(intern_node(category,list()));
   sht-check("empty-list",nil?(vacant),0,len(vacant));
   1;
  }
 }
 sht-run();
 sti-run();
}
