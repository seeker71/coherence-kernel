; qwen38-precrystallize-run.fk — the PRE door: freeze the open's crystal ahead
; of any generate, instead of waiting for the first ask's heat. The heat door
; lives in fcmg-fresh; both call the same qsx-freeze.
;
;   ./fkwu observe/qwen38-precrystallize-run.fk
;
; stdin line 1: registry model name (or a raw gguf path for artifacts
; not yet rowed) — one crystal door for every model.
; preludes: native/metal/qwen35-crystal.fk form-stdlib/model-registry.bml

(do
    (let who (read_line))
    (let row (mr-find who))
    (let path (if (gt (str_len (mr-name row)) 0) (mr-path row) who))
    (let t0 (now_unix_ms))
    (let wrote (qsx-freeze path))
    (let t1 (now_unix_ms))
    (let x (qsx-load path))
    (print (str_concat "freeze_ms=" (int_to_str (sub t1 t0))))
    (print (str_concat "  wrote=" (int_to_str wrote)))
    (print (str_concat "  loaded=" (int_to_str (nth x 0))))
    (print (str_concat "  layers=" (int_to_str (if (eq (nth x 0) 1) (nth x 10) 0))))
    (print (str_concat "  required=" (int_to_str (if (eq (nth x 0) 1) (qsx-required x) 0))))
    (print "\n")
    0)
