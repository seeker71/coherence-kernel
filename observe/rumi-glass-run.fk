; rumi-glass-run.fk — a Rumi verse for a symbol, on glass. The symbol's
; Persian word comes from the locale rows the resident filled (a seed row
; stands in where none does); the verse files the fetch left are searched
; natively for the first couplet carrying it; the couplet, its poem and
; source paint on the terminal glass, and the match publishes to the shared
; bus as voice.rumi (labels and numbers cross; the verse stays on the panel).
; stdin line 1: the symbol (e.g. gift, home, release, glass, love, light).
; preflight-exec: forbidden
; preludes: form/form-stdlib/symbol-voice.bml form/form-stdlib/form-fs.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml form/form-stdlib/term-graphics.bml
(do
    (defn rg-trim (s) (if (nothing? s) "" (trim s)))
    (defn rg-text (t) (if (nothing? t) "" t))
    (defn rg-root () "form/form-stdlib/locale-rows/rumi")
    (defn rg-seed (sym) (if (str_eq sym "gift") "هدیه" (if (str_eq sym "home") "خانه" (if (str_eq sym "release") "رها" (if (str_eq sym "glass") "آینه" (if (str_eq sym "love") "عشق" (if (str_eq sym "light") "نور" (if (str_eq sym "water") "آب" (if (str_eq sym "friend") "یار" "")))))))))
    ; the resident's rows: english|persian|de|fr|pt|ro ; key by the symbol's own words or the symbol
    (defn rg-row-word (lines key) (if (eq (len lines) 0) "" (do (let f (split-on (head lines) "|")) (if (and (ge (len f) 2) (str_eq (trim (head f)) key)) (trim (nth f 1)) (rg-row-word (tail lines) key)))))
    (defn rg-first-word (s) (do (let sp (str_find s " " 0)) (if (lt sp 0) s (substring s 0 sp))))
    (defn rg-persian (sym)
        (do (let rows (split-on (rg-text (read_file "form/form-stdlib/locale-rows/symbol-words.rows")) (byte_to_str 10)))
            (let w1 (rg-row-word rows (sv-fixed sym)))
            (let w2 (if (gt (str_len w1) 0) w1 (rg-row-word rows sym)))
            (if (gt (str_len w2) 0) (list w2 "resident-recalled") (list (rg-seed sym) "seed"))))
    (defn rg-line-start (s at) (if (le at 0) 0 (if (eq (str_byte_at s (sub at 1)) 10) at (rg-line-start s (sub at 1)))))
    (defn rg-line-end (s at) (if (ge at (str_len s)) at (if (eq (str_byte_at s at) 10) at (rg-line-end s (add at 1)))))
    (defn rg-couplet (text at)
        (do (let a (rg-line-start text at)) (let e1 (rg-line-end text at)) (let e2 (rg-line-end text (add e1 1)))
            (list (substring text a e1) (if (ge (add e1 1) (str_len text)) "" (substring text (add e1 1) e2)))))
    (defn rg-title (text) (do (let e (rg-line-end text 0)) (if (and (gt e 1) (eq (str_byte_at text 0) 35)) (trim (substring text 1 e)) "")))
    (defn rg-search-files (dir names word)
        (if (eq (len names) 0) (list)
            (if (lt (str_find (head names) ".txt" 0) 0) (rg-search-files dir (tail names) word)
                (do (let path (fs-path-join dir (head names)))
                    (let text (rg-text (read_file path)))
                    (let at (str_find text word 0))
                    (if (or (lt at 0) (lt at (rg-line-end text 0))) (rg-search-files dir (tail names) word)
                        (list path (rg-title text) (rg-couplet text at) at))))))
    (defn rg-search (cats word) (if (eq (len cats) 0) (list) (do (let dir (fs-path-join (rg-root) (head cats))) (let hit (if (eq (fs-is-dir? dir) 1) (rg-search-files dir (fs-list dir) word) (list))) (if (gt (len hit) 0) hit (rg-search (tail cats) word)))))
    (defn rg-name-of (path) (fs-path-basename path))
    (let sym (rg-trim (read_line)))
    (let pw (rg-persian sym))
    (let word (head pw))
    (let hit (if (eq (str_len word) 0) (list) (rg-search (fs-list (rg-root)) word)))
    (let hit2 (if (or (gt (len hit) 0) (eq (str_len word) 0)) hit (rg-search (fs-list (rg-root)) (rg-first-word word))))
    (let lanes (if (eq (len hit2) 0)
        (list (tg-lane "RUMI    " (str_concat sym " -> ") "dim" (sub 0 1)) (tg-lane "persian " (if (eq (str_len word) 0) "no word yet (ask the resident)" (str_concat word " : no verse carrying it yet")) "warn" (sub 0 1)))
        (list (tg-lane "RUMI    " (str_concat sym (str_concat " -> " (str_concat word (str_concat "  (" (str_concat (nth pw 1) ")"))))) "good" (sub 0 1))
              (tg-lane "verse   " (head (nth hit2 2)) "plain" (sub 0 1))
              (tg-lane "        " (nth (nth hit2 2) 1) "plain" (sub 0 1))
              (tg-lane "poem    " (nth hit2 1) "dim" (sub 0 1))
              (tg-lane "source  " (str_concat "ganjoor " (nth hit2 0)) "dim" (sub 0 1))
              (tg-lane "symbol  " (sv-say (str_concat "you SEE " sym)) "dim" (sub 0 1)))))
    (print_str (tg-frame lanes))
    (let epoch (now_unix_ms))
    (let published (if (eq (len hit2) 0) (list "glass-publish-v1" "nothing")
        (fgtm-publish-snapshot (hearth-telemetry-root) "voice.rumi" epoch (list (fgtm-sample (str_concat "rumi." sym) (fgtm-absent) "rumi-verse" "form" "voice.rumi" "voice" (str_concat "poem-" (substring (rg-name-of (nth hit2 0)) 0 (sub (str_len (rg-name-of (nth hit2 0))) 4))) (fgtm-absent) (fgtm-present (nth hit2 3)) "stored" (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "ganjoor.mowlana" (list "all" "we" "mesh" "voice")))))) 
    (print_str (str_concat "glass=" (str_concat (nth published 1) "\n")))
    0)
