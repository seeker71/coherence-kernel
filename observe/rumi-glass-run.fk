; rumi-glass-run.fk — a Rumi verse for a symbol, on glass, through the one
; organ that owns the search (rumi-glass.bml): the symbol's Persian word from
; the resident's locale rows or a seed row, the first couplet carrying it,
; painted on the terminal glass and published to the shared bus as voice.rumi.
; stdin line 1: the symbol (e.g. gift, home, release, glass, love, light).
; preflight-exec: forbidden
; preludes: form/form-stdlib/rumi-glass.bml
(do
    (defn rgr-trim (s) (if (nothing? s) "" (trim s)))
    (let sym (rgr-trim (read_line)))
    (let found (rg-find sym))
    (let pw (head found))
    (let h (nth found 1))
    (let lanes (if (eq (len h) 0)
        (list (tg-lane "RUMI    " (str_concat sym " -> ") "dim" (sub 0 1)) (tg-lane "persian " (if (eq (str_len (head pw)) 0) "no word yet (ask the resident)" (str_concat (head pw) " : no verse carrying it yet")) "warn" (sub 0 1)))
        (list (tg-lane "RUMI    " (rg-cat (list sym " -> " (head pw) "  (" (nth pw 1) ")")) "good" (sub 0 1))
              (tg-lane "verse   " (rg-hit-line1 h) "plain" (sub 0 1))
              (tg-lane "        " (rg-hit-line2 h) "plain" (sub 0 1))
              (tg-lane "poem    " (rg-hit-title h) "dim" (sub 0 1))
              (tg-lane "source  " (str_concat "ganjoor " (rg-hit-path h)) "dim" (sub 0 1))
              (tg-lane "symbol  " (sv-say (str_concat "you SEE " sym)) "dim" (sub 0 1)))))
    (print_str (tg-frame lanes))
    (let published (if (eq (len h) 0) (list "glass-publish-v1" "nothing") (fgtm-publish-snapshot (hearth-telemetry-root) "voice.rumi" (now_unix_ms) (list (rg-sample (str_concat "rumi." sym) (str_concat "poem-" (rg-poem-id h)) h "ganjoor.mowlana" (now_unix_ms))))))
    (print_str (str_concat "glass=" (str_concat (nth published 1) "\n")))
    0)
