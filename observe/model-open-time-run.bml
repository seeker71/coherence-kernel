// model-open-time-run.bml — where the seconds of opening the native Llama voice go.
//
//   ./fkwu observe/model-open-time-run.bml
//
// The trainer's admitted event once read open_ms 52 to 62 seconds, a run's second largest fixed cost after the baseline
// validation. This opens the model the way the trainer does, in the pieces the open is made of, and prints the milliseconds of
// each: the safetensors header, the geometry check, the first Metal compile, the layers (the mapped weights' views and the
// adapter's low-rank pairs), the tokenizer in its own parts (the 17 MB JSON parsed, the vocabulary, decoder and merge records,
// the Unicode ranges), the Adam state, the corpus read and its digest, and nlg-open as a whole. The GPU need not be quiet: none
// of it dispatches. (2026-10-11: the tokenizer was 41 of the 52 seconds, built in a Form-level ordered index; records hashed in
// fkwu took it to 6.)
// preflight-exec: forbidden
import form-stdlib/native-lora-train.bml;
import form-stdlib/native-llama-metal.bml;
import form-stdlib/model-registry.bml;
import form-stdlib/metal-carrier.bml;
section [form.bml] {
 class ModelOpenTimeRun {
  def mot-dir() = mr-path(mr-find("llama32-3b-mlx-4bit"));
  def mot-adapter() = "form/form-stdlib/adapters/llama-3.2-3b-voice-native";
  def mot-say(t, t0) = print_str("[model-open-time] " ++ t ++ ": " ++ (host_monotonic_ms() - t0).str() ++ " ms");
  // the tokenizer's parts; its locals die with this call
  def mot-tokenizer(dir) {
   let path = dir + "/tokenizer.json";
   let p0 = host_monotonic_ms();
   let text = read_file(path);
   let q0 = mot-say("tokenizer.json read (" ++ (len(text) / 1000000).str() ++ " MB)", p0);
   let p1 = host_monotonic_ms();
   let root = parse-json(path, text);
   let q1 = mot-say("tokenizer.json parsed", p1);
   let model = json-object-get(root, "model");
   let vocab = json-object-pairs(json-object-get(model, "vocab"));
   let p3 = host_monotonic_ms();
   let vrec = nlt-vocab(vocab, record_new(0));
   let q3 = mot-say("vocabulary record (" ++ len(vocab).str() ++ " keys)", p3);
   let p4 = host_monotonic_ms();
   let drec = nlt-decoder(vocab, record_new(0));
   let q4 = mot-say("decoder record", p4);
   let merges = json-array-elements(json-object-get(model, "merges"));
   let p6 = host_monotonic_ms();
   let mrec = nlt-merges(merges, 0, record_new(0));
   let q6 = mot-say("merge record (" ++ len(merges).str() ++ " keys)", p6);
   let p7 = host_monotonic_ms();
   let cats = nlt-category-lines(split-on(read_file("form/form-stdlib/data/DerivedGeneralCategory-15.1.0.txt") ?? "", byte_to_str(10)), []);
   mot-say("Unicode category ranges", p7);
  }
  def mot-run() {
   let a = mca-admit(".hearth/carrier.log", ".hearth/carrier.err");
   let dir = mot-dir();
   let t0 = host_monotonic_ms();
   let cfg = nll-config(dir);
   let geo = nll-geo(cfg);
   let s0 = mot-say("config", t0);
   let t1 = host_monotonic_ms();
   let base = sti-open(dir + "/model.safetensors");
   let s1 = mot-say("safetensors header", t1);
   let t2 = host_monotonic_ms();
   let checked = nll-check-metadata(base, geo);
   let s2 = mot-say("geometry check", t2);
   let t3 = host_monotonic_ms();
   let pipe = nam-pipe("nam_affine");
   let s3 = mot-say("first Metal compile of the affine unit", t3);
   let t5 = host_monotonic_ms();
   let layers = nll-layers(base, [], [], 0, geo[6], geo[8]);
   let s5 = mot-say("layers, no adapter (views of the mapped weights)", t5);
   let t6 = host_monotonic_ms();
   let model = nll-open(dir, mot-adapter());
   let s6 = mot-say("the whole open with the adapter", t6);
   let parts = mot-tokenizer(dir);
   let t7 = host_monotonic_ms();
   let tk = nlt-open(dir);
   let s7 = mot-say("the tokenizer, whole", t7);
   let t8 = host_monotonic_ms();
   let state = nlb-state(model);
   let s8 = mot-say("the Adam state of the adapter (" ++ len(state).str() ++ " pairs)", t8);
   let t9 = host_monotonic_ms();
   let text = read_file("learn/form-token-traces.rows") ?? "";
   let rows = nld-lines(text);
   let s9 = mot-say("read and split the corpus (" ++ len(rows).str() ++ " rows)", t9);
   let t10 = host_monotonic_ms();
   let bound = nlp-bind(text, len(rows), 1);
   let s10 = mot-say("bind the corpus (its digest)", t10);
   let t11 = host_monotonic_ms();
   let session = nlg-open(dir, mot-adapter());
   let s11 = mot-say("nlg-open: the model and tokenizer together", t11);
   0;
  }
 }
 mot-run();
}
