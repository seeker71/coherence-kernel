// flow-watch-run.bml — the subscription to the flow's signal surface (form-stdlib/bml/flow-signal.bml): shared memory, no polling, one packed integer to unpack.
//
//   echo '{"snapshot":1}' | ./fkwu observe/flow-watch-run.bml     the framebuffer: one picture row per standing flow (lights, stage, counts, run and quiet time), then ends
//   echo '{"all":0}'       | ./fkwu observe/flow-watch-run.bml     attach to the bell and every flow frame, sleep on their seq words, and print each new cell the
//                                                                  moment a flow gives it (discomfort, repairs, partial passes, ends; all:1 prints every cell)
// A wake is the kernel's: host_sleep_ms over the frame handles ends when a frame's seq word moves, so a quiet flow costs nothing and a cell costs
// one wake. idle_ms (default 1800000) ends the watch when no flow has given a cell for that long. stdout: one line a cell, "<slot> <request> <cell>".
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/flow-signal.bml
section [form.bml] {
 class FlowWatch {
  def fw-spec() = [["slots", "int"], ["all", "int"], ["snapshot", "int"], ["idle_ms", "int"]];
  def fw-int(o, key, d) = json-object-has?(o, key) ? json-int-value(json-object-get(o, key)) : d;
  def fw-range(i, n) = i >= n ? [] : cons(i, fw-range(i + 1, n));
  def fw-handle(i) = shm_receive(fsg-name(i));
  def fw-text(h) = nothing?(h) ? "" : (shm_read(h) ?? "");
  // A frame is five words, "<request> <state> <t0> <tlast> <why>" (flow-signal.bml): the state is one integer, unpacked by division. A frame of any other shape (an older frame, a slot nobody wrote) names no flow.
  def fw-words(text) = split-on(trim(text), " ");
  def fw-flow?(w) = len(w) == 5;
  def fw-ms(v) = v < 1000 ? v.str() ++ "ms" : v < 120000 ? (v / 1000).str() ++ "s" : (v / 60000).str() ++ "m";
  // what a reader shows of a frame: the lights, the stage and kind, the repairs and counts, how long the flow has run, and how long it has been quiet (both read from the host's clock now, so a flow that stopped giving cells shows a quiet that grows)
  def fw-view(i, w) {
   let u = fsg-unpack(str_to_int(w[1]));
   let now = host_monotonic_ms();
   fsg-pad(i.str(), 2) ++ " " ++ fsg-pad(w[0], 28) ++ " [" ++ fsg-glyph-line(u[0]) ++ "] " ++ fsg-pad(fsg-name-at(fsg-stages(), u[1]), 5) ++ " " ++ fsg-pad(fsg-name-at(fsg-kinds(), u[2]), 4) ++ " " ++ fsg-pad(w[4], 16) ++ " rep=" ++ u[3].str() ++ " got=" ++ u[4].str() ++ " miss=" ++ u[5].str() ++ " run=" ++ fw-ms(now - str_to_int(w[2])) ++ " quiet=" ++ fw-ms(now - str_to_int(w[3]));
  }
  def fw-notable?(w, all) {
   let u = fsg-unpack(str_to_int(w[1]));
   all == 1 || u[2] != 1 || u[1] == 4 || u[1] == 5;
  }
  // one look at every slot: prints a frame that moved since the last look (when it is notable) and answers the frame it saw
  def fw-scan(hs, seen, all) = map(i => fw-scan-slot(i, hs[i], seen[i], all), fw-range(0, len(hs)));
  def fw-scan-slot(i, h, last, all) {
   let text = fw-text(h);
   let w = fw-words(text);
   let said = text != last && fw-flow?(w) && fw-notable?(w, all) ? print_str(fw-view(i, w) ++ "\n") : 0;
   text;
  }
  def fw-live(hs) = filter(h => !nothing?(h), hs);
  def fw-reattach(hs) = map(i => nothing?(hs[i]) ? fw-handle(i) : hs[i], fw-range(0, len(hs)));
  def fw-snapshot(hs) = foldl((acc, i) => fw-flow?(fw-words(fw-text(hs[i]))) ? print_str(fw-view(i, fw-words(fw-text(hs[i]))) ++ "\n") : acc, 0, fw-range(0, len(hs)));
  // A flow that starts after this watch did offers its frame afresh, and a handle taken before holds the old object, so the rest is bounded: a wake is the kernel's
  // (a seq word moved), and a rest that ran out re-attaches every slot to the frame that stands now. idle is [the idle_ms asked, what is left of it]; a scan that saw a new cell gives it back.
  def fw-rest-ms() = 2000;
  def fw-fresh(hs) {
   let dropped = map(h => nothing?(h) ? 0 : shm_release(h), hs);
   map(i => fw-handle(i), fw-range(0, len(hs)));
  }
  def fw-watch(hs, bell, seen, all, idle) {
   let woke = host_sleep_ms(cons(fw-rest-ms(), cons(bell, fw-live(hs))));
   woke[1] != -1 ? fw-go(fw-reattach(hs), bell, seen, all, [idle[0], idle[0]]) : idle[1] <= fw-rest-ms() ? "idle: no flow gave a cell for " ++ idle[0].str() ++ " ms" : fw-go(fw-fresh(hs), bell, seen, all, [idle[0], idle[1] - fw-rest-ms()]);
  }
  // a rest is armed against the seq words at its entry, so a cell given between the scan and the rest would be slept through:
  // the words are read before the scan and again after it, and a word that moved sends the watch round again instead of to rest
  def fw-seqs(hs, bell) = value_str(map(h => nothing?(h) ? 0 : shm_seq(h), cons(bell, hs)));
  def fw-go(hs, bell, seen, all, idle) {
   let before = fw-seqs(hs, bell);
   let now = fw-scan(hs, seen, all);
   (String) before != (String) fw-seqs(hs, bell) ? fw-go(hs, bell, now, all, idle) : fw-watch(hs, bell, now, all, (String) value_str(now) != (String) value_str(seen) ? [idle[0], idle[0]] : idle);
  }
  def fw-run() {
   let o = dop-doc("flow-watch", stdin-text(), fw-spec());
   let n = fw-int(o, "slots", 32);
   let hs = map(i => fw-handle(i), fw-range(0, n));
   let bell = fsg-open-handle(fsg-bell-name());
   fw-int(o, "snapshot", 0) == 1 ? fw-snapshot(hs) : print_str(fw-go(hs, bell, map(i => "", fw-range(0, n)), fw-int(o, "all", 0), [fw-int(o, "idle_ms", 1800000), fw-int(o, "idle_ms", 1800000)]) ++ "\n");
  }
 }
 fw-run();
}
