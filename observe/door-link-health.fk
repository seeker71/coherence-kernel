// door-link-health.fk — the claim lint. Every path a living document names is a CLAIM that a
// tracked cell answers there: a markdown link target, or a code span that is one path word ending
// in a kind the body tracks. This organ re-witnesses those claims (axiom-4: observation makes a
// claim real) and names each one no cell answers, so a cut or a move that leaves a document
// pointing at nothing is seen at the gate it lands through, not by the next reader.
//
// Living documents: the root door ring and every tracked docs/*.md and docs/*.form. Receipts are
// dated history and are not read.
//
// Resolution, in order: the claim as a tracked path or directory; joined to the document's own
// directory; under form/ (documents name form-stdlib/... as the kernels read it); under
// form/form-stdlib/ (bml/..., grammars/..., tests/...); and, for a claim with no slash, any tracked
// file of that name. Not claims: external ("://", "mailto:"), in-page ("#..."), directories
// ("--/"), absolute paths, a link target with neither "." nor "/", runtime state (any leading "."),
// the section tag form.bml, a run's own output (a .json/.jsonl/.txt span with no slash, or any span
// whose first directory no tracked tree holds), and spans holding a space, a glob, a placeholder or
// code punctuation (* < > { } $ | ( ) , = ' " @).
//
// Layers:
//   - scan (dlh-link-claims / dlh-span-claims): pure string walking over find-from/substring.
//   - claim (dlh-answered? / dlh-check-doc): one lookup per claim in a record of tracked paths and
//     directories and one of tracked names, built once from `git ls-files` (prch-git).
//   - reach (dlh-reach): the same claim for dependencies (observe/prelude-reach.bml).
//
import form-stdlib/core.fk;
import form/form-stdlib/line-grammar.fk;
import observe/prelude-reach.bml;
section [form.bml] {
    def dlh-root-doors() = ["AGENTS.md", "BOOTSTRAP.md", "CLAUDE.md", "CURRENT_FLOOR.md", "HOMECOMING.md", "MANIFEST.md", "NORTH_STAR.md", "README.md", "WELCOME.md"];
    def dlh-kinds() = [".bml", ".fk", ".md", ".form", ".jsonl", ".json", ".c", ".h", ".sh", ".txt", ".html", ".go", ".rs", ".ts", ".mjs", ".plist", ".spool"];
    // ── scan layer (pure strings over find-from/substring) ─────────────────
    def dlh-ends?(s, k) = len(s) > len(k) ? (String) substring(s, len(s) - len(k), len(s)) == k : 0;
    def dlh-has?(s, needle) = find-from(s, needle, 0) >= 0;
    def dlh-ends-slash?(t) = (Comparable) len(t) == 0 ? 0 : (String) substring(t, len(t) - 1, len(t)) == "/" ? 1 : 0;
    def dlh-skip?(t) = (Comparable) len(t) == 0 ? 1 : find-from(t, "://", 0) >= 0 ? 1 : (String) substring(t, 0, 1) == "#" ? 1 : (String) substring(t, 0, 1) == "/" ? 1 : (Comparable) find-from(t, "mailto:", 0) == 0 ? 1 : !(dlh-has?(t, ".") || dlh-has?(t, "/")) ? 1 : dlh-ends-slash?(t);
    def dlh-strip-anchor(t) = {
        let k = find-from(t, "#", 0);
        k < 0 ? t : substring(t, 0, k);
    };
    // bytes that make a span code or a pattern rather than one path word
    def dlh-loud-byte?(b) = any?(c => (Comparable) c == b, [32, 9, 10, 42, 60, 62, 123, 125, 36, 124, 40, 41, 44, 61, 39, 34, 64]);
    def dlh-word?(s, i) = i >= len(s) ? 1 : dlh-loud-byte?(str_byte_at(s, i)) ? 0 : dlh-word?(s, i + 1);
    // a run's output named by its file: data kinds with no directory
    def dlh-output?(t) = !dlh-has?(t, "/") && (dlh-ends?(t, ".json") || (dlh-ends?(t, ".jsonl") || dlh-ends?(t, ".txt")));
    def dlh-span-shape?(t) = (len(t) > 0) && (len(t) < 200) ? (dlh-word?(t, 0) ? (any?(k => dlh-ends?(t, k), dlh-kinds()) ? ((Comparable) str_byte_at(t, 0) != 46 ? !dlh-has?(t, "://") : 0) : 0) : 0) : 0;
    def dlh-span-claim?(t) = dlh-span-shape?(t) ? !((String) t == "form.bml" || dlh-output?(t)) : 0;
    // link targets, anchors stripped, in source order
    def dlh-link-claims(text, from, acc) = {
        let i = find-from(text, "](", from);
        i < 0 ? reverse(acc) : dlh-link-at(text, i + 2, find-from(text, ")", i + 2), acc);
    };
    def dlh-link-at(text, s, j, acc) = j < 0 ? reverse(acc) : dlh-link-claims(text, j + 1, (Comparable) dlh-skip?(substring(text, s, j)) == 1 ? acc : cons(dlh-strip-anchor(substring(text, s, j)), acc));
    // code spans that are one path word of a tracked kind, in source order
    def dlh-span-claims(text, from, acc) = {
        let i = find-from(text, "`", from);
        i < 0 ? reverse(acc) : dlh-span-at(text, i + 1, find-from(text, "`", i + 1), acc);
    };
    def dlh-span-at(text, s, j, acc) = j < 0 ? reverse(acc) : dlh-span-claims(text, j + 1, dlh-span-claim?(substring(text, s, j)) ? cons(substring(text, s, j), acc) : acc);
    def dlh-claims(text) = append(dlh-link-claims(text, 0, []), dlh-span-claims(text, 0, []));
    // ── claim layer (the tracked world, read once) ─────────────────────────
    def dlh-dir-at(p, i) = i < 0 ? "" : (Comparable) str_byte_at(p, i) == 47 ? substring(p, 0, i + 1) : dlh-dir-at(p, i - 1);
    def dlh-dir(p) = dlh-dir-at(p, len(p) - 1);
    def dlh-base(p) = substring(p, len(dlh-dir(p)), len(p));
    def dlh-fill-dirs(paths, p, i) = i <= 0 ? 0 : (Comparable) str_byte_at(p, i) == 47 ? dlh-fill-dir(paths, p, i) : dlh-fill-dirs(paths, p, i - 1);
    def dlh-fill-dir(paths, p, i) = {
        record_set(paths, substring(p, 0, i), 1);
        dlh-fill-dirs(paths, p, i - 1);
    };
    def dlh-fill(xs, paths, names) = nil?(xs) ? 0 : {
        record_set(paths, xs[0], 1);
        dlh-fill-dirs(paths, xs[0], len(xs[0]) - 1);
        record_set(names, dlh-base(xs[0]), 1);
        dlh-fill(xs[1:], paths, names);
    };
    // [paths-and-dirs, names, tracked]
    def dlh-world() = {
        let tracked = prch-lines(prch-git(["ls-files"]));
        let paths = record_new(0);
        let names = record_new(0);
        dlh-fill(tracked, paths, names);
        [paths, names, tracked];
    };
    def dlh-tracked?(world, p) = (Comparable) record_has(world[0], p) == 1;
    def dlh-homes(doc) = ["", dlh-dir(doc), "form/", "form/form-stdlib/"];
    def dlh-home-hit?(world, doc, t) = any?(h => dlh-tracked?(world, prch-norm(h ++ t)), dlh-homes(doc));
    // a slashed span whose first directory no home holds names a run's own layout, not the tree
    def dlh-first-dir(t) = substring(t, 0, find-from(t, "/", 0));
    def dlh-rooted?(world, doc, t) = !dlh-has?(t, "/") || any?(h => dlh-tracked?(world, prch-norm(h ++ dlh-first-dir(t))), dlh-homes(doc));
    def dlh-answered?(world, doc, t) = dlh-home-hit?(world, doc, t) || (!dlh-has?(t, "/") && (Comparable) record_has(world[1], t) == 1);
    def dlh-living?(p) = any?(d => (String) d == p, dlh-root-doors()) || ((Comparable) find-from(p, "docs/", 0) == 0 && (dlh-ends?(p, ".md") || dlh-ends?(p, ".form")));
    def dlh-docs(world) = filter(p => dlh-living?(p), world[2]);
    def dlh-say-broken(doc, xs) = nil?(xs) ? 0 : {
        print("door-link-broken " ++ doc ++ " " ++ xs[0]);
        dlh-say-broken(doc, xs[1:]);
    };
    // one document: [claims, broken], each broken claim named on its own line
    def dlh-check-doc(world, doc) = {
        let text = read_file(doc) ?? "";
        let claims = append(dlh-link-claims(text, 0, []), filter(t => dlh-rooted?(world, doc, t), dlh-span-claims(text, 0, [])));
        let broken = filter(t => !dlh-answered?(world, doc, t), claims);
        dlh-say-broken(doc, broken);
        [len(claims), len(broken)];
    };
    def dlh-lint-loop(world, ds, found, broken) = nil?(ds) ? [found, broken] : {
        let r = dlh-check-doc(world, ds[0]);
        dlh-lint-loop(world, ds[1:], found + r[0], broken + r[1]);
    };
    // [documents, claims, broken]
    def dlh-lint() = {
        let world = dlh-world();
        let docs = dlh-docs(world);
        let r = dlh-lint-loop(world, docs, 0, 0);
        [len(docs), r[0], r[1]];
    };
    // the reach row: prints its own summary row and answers missing + untracked
    // + shadow, so 0 means every loaded name reaches one tracked file
    def dlh-reach() = prch-report();
    // ── self-check over the scan layer ─────────────────────────────────────
    def dlhk(ok, bit) = ok ? bit : 0;
    def door-link-health-check() = dlhk(len(dlh-claims("no links here")) == 0, 1) + (dlhk(len(dlh-claims("[a](https://x.y/) [b](#top) [c](mailto:u@h) [d](docs/) [e](/abs.md)")) == 0, 2) + (dlhk((String) dlh-claims("[a](AGENTS.md#seam) `observe/x.bml` `x.fk`")[0] == "AGENTS.md", 4) + (dlhk(len(dlh-claims("`a b.fk` `<file>.fk` `(f x.fk)` `.hearth/x.json` `*.bml` `name`")) == 0, 8) + dlhk(len(dlh-claims("[a](AGENTS.md#seam) `observe/x.bml` `x.fk`")) == 3, 16))));
    0;
}
