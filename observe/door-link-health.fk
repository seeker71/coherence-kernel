// door-link-health.fk — the door ring's lint organ. Every markdown link a
// door names is a CLAIM that a cell answers at that path; this organ
// re-witnesses those claims (axiom-4: observation makes a claim real;
// observe/belief-freshness.fk: witness ages, links age with it). It is the
// body's own form of the "lint" operation in Karpathy's llm-wiki pattern
// (gist 442a6bf5..., 2026-04-04): where his lint hunts contradictions and
// orphan pages, this first floor hunts BROKEN DOORS — links whose target no
// cell answers.
//
// Two layers, the native-edit.fk seam split:
//   - scan layer (dlh-skip? / dlh-strip-anchor / dlh-scan): pure string
//     walking on find-from/substring, the body's one string engine —
//     four-way-ABLE, not yet four-way-run (floor named).
//   - door layer (dlh-check-door / dlh-lint / dlh-field-code): fkwu-carrier
//     (read_file), run from the repo root; observe/door-link-health-run.bml
//     is its runnable door and gate/drift-gates.bml carries it as a row.
//
//   - reach layer (dlh-reach): the same claim for dependencies. Every token a
//     cell loads by name answers at a tracked path, and the disk and the
//     index pick the same file for it (observe/prelude-reach.bml).
//
// Scope floor (named, next shells): lints the top-level door ring only —
// targets there are repo-root-relative. Nested doors (a receipt linking a
// receipt) need dir-relative path joining; targets inside code fences are
// scanned like any text; ":line" suffixes are not stripped (only "#anchor"s).
//
// skip rule: external ("://", "mailto:"), in-page ("#..."), directory ("--/")
// and empty targets are not checkable path-claims here — in neither column.
//
// fold: doors*10^6 + links*10^3 + broken — injective while links<=999 and
// broken<=999 (the hdc-field-code discipline: positional decimal, digit-wide).
//
import form-stdlib/core.fk;
import form/form-stdlib/line-grammar.fk;
import observe/prelude-reach.bml;
// witnessed: 2026-09-29 -> self-check 31; door ring 9107000 (9 doors, 107
//   links, 0 broken).
section [form.bml] {
    // the door ring — the entry documents whose links this floor re-witnesses
    def dlh-doors() = ["AGENTS.md", "BOOTSTRAP.md", "CLAUDE.md", "CURRENT_FLOOR.md", "HOMECOMING.md", "MANIFEST.md", "NORTH_STAR.md", "README.md", "WELCOME.md"];
    // ── scan layer (pure strings over find-from/substring) ─────────────────
    def dlh-ends-slash?(t) = (Comparable) len(t) == 0 ? 0 : (String) substring(t, len(t) - 1, len(t)) == "/" ? 1 : 0;
    def dlh-skip?(t) = (Comparable) len(t) == 0 ? 1 : find-from(t, "://", 0) >= 0 ? 1 : (String) substring(t, 0, 1) == "#" ? 1 : (Comparable) find-from(t, "mailto:", 0) == 0 ? 1 : dlh-ends-slash?(t);
    def dlh-strip-anchor(t) = {
        let k = find-from(t, "#", 0);
        k < 0 ? t : substring(t, 0, k);
    };
    // a path-claim is answered when a cell answers at that path. A missing
    // file answers nothing (2026-08-27); a present-but-empty cell answers "".
    // Both read as not-answering here, and the absence is named before measured.
    def dlh-exists?(p) = {
        let s = read_file(p);
        nothing?(s) ? 0 : len(s) > 0 ? 1 : 0;
    };
    // walk `text` from `from`, counting checkable link targets and the broken
    // among them; returns (list found broken)
    def dlh-scan(text, from, found, broken) = {
        let i = find-from(text, "](", from);
        i < 0 ? [found, broken] : {
            let s = (Number) i + (Number) 2;
            let j = find-from(text, ")", s);
            j < 0 ? [found, broken] : {
                let t = substring(text, s, j);
                (Comparable) dlh-skip?(t) == 1 ? dlh-scan(text, (Number) j + (Number) 1, found, broken) : dlh-scan(text, (Number) j + (Number) 1, (Number) found + (Number) 1, (Number) broken + (Number) (1 - dlh-exists?(dlh-strip-anchor(t))));
            };
        };
    };
    // ── door layer (fkwu-carrier; run from the repo root) ──────────────────
    def dlh-check-door(p) = dlh-scan(read_file(p), 0, 0, 0);
    def dlh-lint-loop(ds, found, broken) = (Comparable) len(ds) == 0 ? [found, broken] : {
        let r = dlh-check-door(ds[0]);
        dlh-lint-loop(ds[1:], (Number) found + (Number) r[0], (Number) broken + (Number) r[1]);
    };
    def dlh-lint() = dlh-lint-loop(dlh-doors(), 0, 0);
    def dlh-field-code() = {
        let r = dlh-lint();
        (Number) (len(dlh-doors()) * 1000000) + (Number) ((Number) (r[0] * 1000) + (Number) r[1]);
    };
    // the reach row: prints its own summary row and answers missing + untracked
    // + shadow, so 0 means every loaded name reaches one tracked file
    def dlh-reach() = prch-report();
    // ── self-check (c3/c5 stand on live root files — fkwu-carrier, honest) ──
    def dlhk(ok, bit) = ok ? bit : 0;
    def door-link-health-check() = (Number) dlhk((Comparable) dlh-scan("no links here", 0, 0, 0)[0] == 0, 1) + (Number) ((Number) dlhk((Comparable) dlh-scan("[a](https://x.y/) [b](#top) [c](mailto:u@h) [d](docs/)", 0, 0, 0)[0] == 0, 2) + (Number) ((Number) dlhk((Comparable) dlh-scan("[a](README.md)", 0, 0, 0)[1] == 0, 4) + (Number) ((Number) dlhk((Comparable) dlh-scan("[a](door-that-never-was.md)", 0, 0, 0)[1] == 1, 8) + (Number) dlhk((Comparable) dlh-scan("[a](AGENTS.md#the-honest-seam)", 0, 0, 0)[1] == 0, 16))));
    0;
}
