// Actual registered GGUF, raw prompt, twelve predictions and explicit release.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/metal-ask.bml
section [form.bml] {
 class MetalAskLive {
  def mal-equal(a,b) = if not(eq(len(a),len(b))) then 0 else if nil?(a) then 1 else and(eq(head(a),head(b)),mal-equal(tail(a),tail(b)));
  def mal-run() {
   let before = metal_live();
   let prompt = "The capital of France is";
   let owner = ma-ask(ma-blob(),ma-model(),prompt,12);
   let after = metal_live();
   let expected = list(12366,13,578,6864,315,15704,374,22463,13,578,6864,315);
   let path = str_concat(temp_dir(),str_concat("/metal-ask-",int_to_str(host_pid())));
   let published = ma-publish(owner,path);
   let bound = if published then anl-ready-at(path,prompt) else 0;
   let unbound = if published then eq(anl-ready-at(path,"a different question"),0) else 0;
   let removed = if published then fs_remove(path) else -1;
   let verdict = sum(list(
    if eq(record_get(owner,"ok"),1) then 1 else 0,
    if mal-equal(record_get(owner,"ids"),expected) then 2 else 0,
    if str_eq(record_get(owner,"text")," Paris. The capital of Italy is Rome. The capital of") then 4 else 0,
    if eq(record_get(owner,"identity-stable"),1) then 8 else 0,
    if and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3))) then 16 else 0,
    if and(eq(record_get(owner,"dispatches"),8177),eq(record_get(owner,"syncs"),17)) then 32 else 0,
    if and(bound,unbound) then 64 else 0,
    if and(eq(removed,0),str_eq(record_get(owner,"reason"),"cap")) then 128 else 0));
   print_str(str_concat(record_get(owner,"receipt"),"\n"));
   print(list("resources-before",nth(before,2),nth(before,3),"resources-after",nth(after,2),nth(after,3),"held-buffers",len(record_get(owner,"buffers")),"held-pipelines",len(record_get(owner,"pipelines"))));
   print(verdict);
   if eq(verdict,255) then 0 else form_error(str_concat("metal ask live failed: ",record_get(owner,"reason")));
  }
 }
 mal-run();
}
