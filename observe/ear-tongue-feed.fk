; etp-feed.fk — a room without a mic: the segment lines a live ear would hand the tongue lane,
; a line growing in whisper-sized steps and then closing, so `ear.said` can be measured without
; contending for the microphone a sibling's sensor holds. Writes the same lines
; `observe/ear-live-native.fk` writes and rings the same bell.
; preludes: form/form-stdlib/spool-bell-transport.fk form/form-stdlib/line-grammar.fk
(do
    (defn ef-segs () ".hearth/ear.spool.segments")
    (defn ef-segbell () ".hearth/ear.spool.seg.bell")
    (defn ef-nl () (byte_to_str 10))
    (defn ef-tab () (byte_to_str 9))
    (defn ef-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (ef-cat (tail xs)))))
    (defn ef-ring () (host-exec (ef-cat (list "printf x > " (ef-segbell) " &")) ""))
    (defn ef-live (seg tend text) (do (sbt-append (ef-segs) (ef-cat (list "live" (ef-tab) (int_to_str seg) (ef-tab) (int_to_str tend) (ef-tab) "en" (ef-tab) text (ef-nl)))) (ef-ring)))
    (defn ef-closed (tend text) (do (sbt-append (ef-segs) (ef-cat (list (int_to_str tend) (ef-tab) "en" (ef-tab) text (ef-nl)))) (ef-ring)))
    (defn ef-done () (do (sbt-append (ef-segs) (ef-cat (list "done" (ef-nl)))) (ef-ring)))
    ; a line as whisper hands it over: five renderings about 250 ms apart, then the close
    (defn ef-parts () (list "The body" "The body observed" "The body observed the glass," "The body observed the glass, water and ice" "The body observed the glass, water and ice and gas."))
    (defn ef-grow (seg parts gap)
        (if (eq (len parts) 0) 0
            (do (ef-live seg (now_unix_ms) (head parts))
                (host_sleep_ms gap)
                (ef-grow seg (tail parts) gap))))
    (defn ef-line (seg gap hold)
        (do (ef-grow seg (ef-parts) gap)
            (ef-closed (now_unix_ms) "The body observed the glass, water and ice and gas.")
            (host_sleep_ms hold)
            1))
    (let gap (do (let l (read_line)) (if (nothing? l) 250 (str_to_int (trim l)))))
    (let hold (do (let l (read_line)) (if (nothing? l) 6000 (str_to_int (trim l)))))
    (let n (do (let l (read_line)) (if (nothing? l) 1 (str_to_int (trim l)))))
    (defn ef-lines (seg n gap hold) (if (le n 0) 0 (do (ef-line seg gap hold) (ef-lines (add seg 1) (sub n 1) gap hold))))
    (ef-lines 1 n gap hold)
    (ef-done)
    (print_str "fed")
    1)
