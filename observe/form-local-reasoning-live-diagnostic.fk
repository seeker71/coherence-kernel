; form-local-reasoning-live-diagnostic.fk -- one bounded error-attention
; exchange in the local Form-knowledge homecoming.
;
; The family denominator is read from the body when this cell runs; no family
; count is encoded as a target.  The diagnostic carries only public synthetic
; class observations and aggregate stage state.  No prompt, answer, consent,
; model bytes, or private evidence enters the framebuffer.
;
; The first crossing retains a measured base error and selects an absorption
; movement.  Only after that correlated control does the rank-one movement run
; and a distinct sealed surface get re-observed.  If either the teaching error
; or sealed transfer remains unresolved, rehearse-ground returns the original
; attended error; no target, threshold, or observation is repainted.
;
; preludes: observe/bidirectional-framebuffer-channel.fk
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/lora-modality.fk
; preludes: cognition/error-loving-attention.fk
; preludes: cognition/error-absorption-kernel.fk

(do
    (framebuffer-clear)
    (let census (len (fkpfm-family-ids)))
    (let target (eak-target-index))
    (let error-surface (eak-row-surface (eak-error-row)))
    (let sealed-surface (eak-row-surface (eak-sealed-row)))
    (let base-error (eak-base-prediction error-surface))
    (let base-sealed (eak-base-prediction sealed-surface))
    (let error-signal
        (ela-signal "error" target base-error
                    "error-absorption/error-teaching"))
    (let attended (ela-attend error-signal))
    (let timeout
        (ela-attend
            (ela-signal "timeout" target (nothing)
                        "error-absorption/control-timeout")))

    ; payload = fresh-family-denominator, expected-class, base-error-class,
    ;           base-sealed-class, attention-health, attention-movement-count
    (let outbound (bfc-envelope 0 715 0
        (list census target base-error base-sealed
              (ela-health error-signal)
              (len (ela-movement error-signal)))
        timeout))
    (let out-event (bfc-record-out outbound 1))
    (let branch
        (bfc-control outbound
            (if (eq (ela-health error-signal) 1) 1 4)))
    (let in-event (bfc-record-in branch 2))
    (let selected (bfc-apply outbound branch attended attended))
    (let selected-signal (nth selected 0))
    (let error-retained
        (if (and (str_eq (ela-kind selected-signal) "error")
             (and (eq (ela-prediction selected-signal) target)
             (and (eq (ela-observation selected-signal) base-error)
                  (str_eq (ela-source selected-signal)
                          "error-absorption/error-teaching")))) 1 0))

    ; This movement is downstream of the correlated branch, not precomputed.
    (let adapted-error (eak-adapted-prediction error-surface))
    (let adapted-sealed (eak-adapted-prediction sealed-surface))
    (let error-corrected (if (eq adapted-error target) 1 0))
    (let sealed-transfer (if (eq adapted-sealed target) 1 0))
    (let absorbed (if (and (eq error-corrected 1)
                           (eq sealed-transfer 1)) 1 0))
    (let observed-kind (if (eq absorbed 1) "resolved" "error"))
    (let observed-signal
        (ela-signal observed-kind target adapted-error
                    "error-absorption/heldout-reobserve"))
    (let observed-attention (ela-attend observed-signal))

    ; payload = retained-error, adapted-error-class, adapted-sealed-class,
    ;           teaching-corrected, sealed-transfer, resolved-attention-health
    (let reobserved (bfc-envelope 0 716 0
        (list error-retained adapted-error adapted-sealed
              error-corrected sealed-transfer
              (ela-health observed-signal))
        attended))
    (let re-out-event (bfc-record-out reobserved 3))
    ; Continue only after both the teaching and sealed observations moved.
    ; Otherwise action 5 rehearses the original attended error.
    (let continue
        (bfc-control reobserved (if (eq absorbed 1) 0 5)))
    (let re-in-event (bfc-record-in continue 4))
    (let held
        (bfc-apply reobserved continue observed-attention attended))

    (list "form-local-reasoning-live-diagnostic-v2"
        (bfc-payload outbound)
        (bfc-payload branch)
        selected
        (bfc-payload reobserved)
        (bfc-payload continue)
        held
        (len (framebuffer-events))
        (if (and (not (eq base-error target))
             (and (eq error-retained 1)
             (and (eq (ela-release? selected) 0)
             (and (eq absorbed 1)
             (and (eq (ela-release? held) 1)
             (and (eq (bfc-exchange outbound) 715)
             (and (eq (bfc-exchange branch) 715)
             (and (eq (bfc-exchange reobserved) 716)
             (and (eq (bfc-exchange continue) 716)
                  (eq (len (framebuffer-events)) 4)))))))))) 1 0)))
