; qwen38-family-native-exec-teach-check-live-run.fk -- observed physical
; family-bound local-Qwen request -> generated Metal -> mastery evidence.
;
; EFFECTFUL. DO NOT PREFLIGHT. DO NOT RUN while another sibling owns the local
; model/Metal carrier. The pure organ and adversarial band are the preflight
; surfaces. This driver is checked only for lexical balance until an intentional
; carrier window opens.
;
; One run opens Qwen once, teaches one canonical family/source/challenge
; binding, captures one complete generated reply, and requires that reply to be
; byte-identical to the binding's canonical recipe-exec query. Only then does
; Form call frexl-execute-request. That existing door generates MSL from the
; recipe NodeID, JIT-compiles, executes, reads one i32, and releases its buffer.
; The physically flagged compact frex observation is injected into the same
; resident Qwen state, generation resumes, and the context/state are released.
;
; The default binding is the canonical `bootstrap` family; its mastery
; challenge supplies input -2 and the affine recipe result is integer 1.
; Other canonical bindings can reuse the pure organ. CPU/MLX are not selected
; here: their frex-compatible concrete
; generated-native executors do not yet exist.
;
; No registry, remote call, flattening, operations table, or C growth occurs.
; witnessed: 2026-08-25 -> 32767 on the first crossing; the production live
; cursor admission adds bit 32768, so its complete verdict is 65535.
; preludes: form-stdlib/form-knowledge-family-native-exec-teach-check.fk form-stdlib/form-cli-model-session.fk

(do
    (defn qfne-path ()
        "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn qfne-model-id () "Qwen3.8-27B-Q8_0-local")
    (defn qfne-family () "bootstrap")
    (defn qfne-input () (fkpfm-family-native-input (qfne-family)))
    (defn qfne-carrier () "metal")
    (defn qfne-receipt-path ()
        "receipts/2026-08-25-family-native-exec-teach-check-PENDING.md")
    ; This is the observed SHA-256 of the now-frozen committed receipt source.
    ; Re-walking its 6.9 KB through sovereign Form SHA before every physical
    ; attempt spent more than ten minutes without reaching model-open.  The
    ; literal is a cached content address, not an authentication claim; a
    ; source change owes a fresh host/file seal and a new follow-up receipt.
    (defn qfne-receipt-source-sha ()
        "1482a686b738f0d9653dc655eaf7ca0a286d27eec5522466b6492c563ab3eeaf")
    ; This is a content address for the declared start, canonical binding and
    ; frozen receipt source. It does not authenticate a GPU, model, or carrier.
    (defn qfne-run-id (started binding receipt-source-sha)
        (nmfe-sha256 (nmfe-fields (list
            "family-native-physical-run-v2" (int_to_str started)
            (fkfne-binding-sha binding) (qfne-receipt-path)
            receipt-source-sha))))
    (defn qfne-binding ()
        (fkfne-binding-for-family (qfne-family) (qfne-carrier)))
    (defn qfne-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn qfne-int (name value) (qfne-line name (int_to_str value)))
    (defn qfne-stage (name) (qfne-line "stage" name))
    (defn qfne-bit (held weight) (if held weight 0))
    (defn qfne-prompt (binding)
        ; The caller already paid for this exact source/challenge-bound value.
        ; Rebuilding it here repeated the sovereign SHA walk before model-open.
        (fkfne-cat (list
            "You are in one resident local Form family execution lesson. "
            "Read the typed binding below. Your first reply must be exactly "
            "the requested recipe-exec query: no thinking, prose, markdown, "
            "leading byte, trailing byte, or duplicate frame. Form will parse "
            "raw decoded bytes and execute; the model does not execute Form.\n"
            (fkfne-teach-frame binding)
            "\nAfter the typed frex observation arrives, do not request again. "
            "Reply with one concise ASCII line beginning `native-held ` and "
            "name family, carrier, value-present, value, and lifecycle.")))
    (defn qfne-same-residence? (opened resumed)
        (if (and (node_eq (head (fcms-ctx opened))
                          (head (fcms-ctx resumed)))
                 (node_eq (head (fcms-sts opened))
                          (head (fcms-sts resumed)))) 1 0))

    (qfne-stage "binding-begin")
    (let binding (qfne-binding))
    (qfne-stage "binding-ready")
    (let started (now_unix_ms))
    (let receipt-source-sha (qfne-receipt-source-sha))
    (qfne-stage "receipt-seal-ready")
    (let run-id (qfne-run-id started binding receipt-source-sha))
    (qfne-stage "run-id-ready")
    (qfne-stage "model-open-begin")
    (let opened
        ; 2513 is the observed conservative byte-derived upper bound for this
        ; typed lesson. 3072 keeps that bound plus the resident reply crossing.
        (fcms-open (qfne-path) (qfne-prompt binding) 3072))
    (let open-ms (sub (now_unix_ms) started))
    (qfne-stage "model-open-returned")
    (if (not (eq (fcms-live? opened) 1))
        (do
            (qfne-line "status" (fcms-status opened))
            (qfne-line "reason" (fcms-reason opened))
            (qfne-int "open-ms" open-ms)
            (qfne-int "release-ok" (fcms-release-ok? opened))
            0)
        (do
            ; Generation completes before the carrier is offered. This is what
            ; makes no-leading/no-trailing exactness physically enforceable.
            (qfne-stage "first-generation-begin")
            (let generated (fcms-generate opened 128))
            (qfne-stage "first-generation-returned")
            (let generated-session (fcms-generation-session generated))
            (let emitted (fcms-generation-text generated))
            (let prep (fkfne-prepare binding emitted))
            (qfne-stage "scannerless-preparation-ready")
            (let prepared (fkfne-preparation-valid? prep))
            (let executable (fkfne-carrier-executable-now?
                (fkfne-binding-carrier binding)))
            (qfne-stage "carrier-begin")
            (let live
                (if (and (eq prepared 1) (eq executable 1))
                    (frexl-execute-request (fkfne-prep-request prep)
                        (frexl-cursor-bytes (fkfne-prep-cursor prep)))
                    (nothing)))
            (qfne-stage "carrier-returned")
            (let compact
                (if (nothing? live)
                    (frex-choice (fkfne-prep-request prep) (empty))
                    (frexl-result-as-frex (fkfne-prep-request prep) live)))
            (let typed (frex-render compact))
            (qfne-stage "observation-begin")
            (let observed (fcms-observe generated-session typed))
            (qfne-stage "observation-returned")
            (qfne-stage "resume-generation-begin")
            (let resumed-generation (fcms-generate observed 96))
            (qfne-stage "resume-generation-returned")
            (let resumed (fcms-generation-session resumed-generation))
            (let same-residence (qfne-same-residence? opened resumed))
            (let carrier-release
                (if (nothing? live) 0
                    (frexl-result-buffer-released? live)))
            (let native-generated
                (if (nothing? live) 0
                    (frexl-result-native-code-generated? live)))
            (let carrier-executed
                (if (nothing? live) 0 (frexl-result-executed? live)))
            (let ended (now_unix_ms))
            (qfne-stage "session-release-begin")
            (let session-release (fcms-release-ok? resumed))
            (qfne-stage "session-release-returned")
            (let release-ok
                (if (and (eq carrier-release 1)
                         (eq session-release 1)) 1 0))
            (let check (fkfne-check binding prep compact
                (qfne-model-id) run-id 0 release-ok))
            (let check-valid (fkfne-check-valid? check))
            (let evidence (fkfne-check-evidence check))
            (let structured-receipt (fkfne-check-receipt check))
            (let evidence-valid
                (if (nothing? evidence) 0
                    (fkpfm-execution-valid? evidence)))
            (qfne-stage "evidence-check-ready")

            (qfne-line "status"
                (if (eq check-valid 1) "family-native-admitted" "not-yet"))
            (qfne-line "family" (fkfne-binding-family binding))
            (qfne-line "source-sha" (fkfne-binding-source-sha binding))
            (qfne-line "challenge-sha"
                (fkfne-binding-challenge-sha binding))
            (qfne-line "binding-sha" (fkfne-binding-sha binding))
            (qfne-line "run-id" run-id)
            (qfne-line "receipt-source-sha" receipt-source-sha)
            (if (eq (fkpfm-receipt-valid? structured-receipt) 1)
                (qfne-line "structured-receipt-sha"
                    (fkpfm-receipt-sha structured-receipt)) 0)
            (qfne-line "expected-query" (fkfne-binding-query binding))
            (qfne-line "model-query" emitted)
            (qfne-int "open-ms" open-ms)
            (qfne-int "movement-ms" (sub ended (add started open-ms)))
            (qfne-int "open-count" 1)
            (qfne-line "open-reason" (fcms-reason opened))
            (qfne-int "same-context-state" same-residence)
            (qfne-int "exact-query" (fkfne-prep-exact? prep))
            (qfne-int "scannerless" (fkfne-prep-scannerless? prep))
            (qfne-int "pretokenized" (fkfne-prep-pretokenized? prep))
            (qfne-int "model-requested"
                (fkfne-prep-model-requested? prep))
            (qfne-int "remote-calls" 0)
            (qfne-int "native-code-generated" native-generated)
            (qfne-int "carrier-executed" carrier-executed)
            (qfne-int "model-executed" (frex-result-model-executed? compact))
            (qfne-line "carrier" (frex-result-carrier compact))
            (qfne-line "result-status" (frex-result-status compact))
            (qfne-int "value-present"
                (frex-result-value-present? compact))
            (qfne-int "value" (frex-result-value compact))
            (qfne-line "lifecycle"
                (frex-trace-actions (frex-result-trace compact)))
            (qfne-line "typed-frex-observation" typed)
            (qfne-line "model-after-observation"
                (fcms-generation-text resumed-generation))
            (qfne-int "carrier-release-ok" carrier-release)
            (qfne-int "session-release-ok" session-release)
            (qfne-int "check-valid" check-valid)
            (qfne-int "fkpfm-execution-valid" evidence-valid)
            (if (eq evidence-valid 1)
                (qfne-line "execution-output-sha" (nth evidence 5)) 0)
            (qfne-line "carrier-seam" (fkfne-carrier-seam))
            (sum (list
                (qfne-bit (eq (fkfne-binding-valid? binding) 1) 1)
                (qfne-bit (eq prepared 1) 2)
                (qfne-bit (and (eq (fkfne-prep-scannerless? prep) 1)
                    (eq (fkfne-prep-pretokenized? prep) 0)) 4)
                (qfne-bit (eq (fkfne-prep-model-requested? prep) 1) 8)
                (qfne-bit (eq executable 1) 16)
                (qfne-bit (eq native-generated 1) 32)
                (qfne-bit (eq carrier-executed 1) 64)
                (qfne-bit (eq (frex-result-model-executed? compact) 0) 128)
                (qfne-bit (eq (frex-result-value-present? compact) 1) 256)
                (qfne-bit (and (eq (frex-result-value compact) 1)
                    (eq (frex-result-value compact)
                        (frexl-recipe-expected (frex-recipe)
                            (qfne-input)))) 512)
                (qfne-bit (and
                    (eq (frex-trace-has? (frex-result-trace compact)
                        "choice") 1)
                    (and (eq (frex-trace-has? (frex-result-trace compact)
                        "dissolve") 1)
                         (eq (frex-trace-has? (frex-result-trace compact)
                            "release") 1))) 1024)
                (qfne-bit (eq (frxc-observation-valid? typed) 1) 2048)
                (qfne-bit (eq same-residence 1) 4096)
                (qfne-bit (and (eq check-valid 1)
                               (eq evidence-valid 1)) 8192)
                (qfne-bit (and (eq carrier-release 1)
                               (eq session-release 1)) 16384)
                (qfne-bit (str_eq (fcms-reason opened)
                                   "opened-live-cursor") 32768))))))
