; Compact live door for the adaptive health map.  Counts always come from the
; current rows; this file holds no denominator or target.
; preludes: observe/form-local-offline-health-pulse.fk

(do
    (let pulse (flohp-run))
    (let map (nth pulse 1))
    (print_str "observed=")
    (print_str (int_to_str (flohm-valid-count map)))
    (print_str " ready=")
    (print_str (int_to_str (flohm-ready-count map)))
    (print_str " gaps=")
    (print_str (int_to_str (flohm-gap-count map)))
    (print_str " unknown=")
    (print_str (int_to_str (flohm-unknown-count map)))
    (print_str " invalid=")
    (print_str (int_to_str (flohm-invalid-count map)))
    (print_str " health_permille=")
    (print_str (int_to_str (flohm-health-permille map)))
    (print_str "\nselected=")
    (print_str (if (nothing? (flohm-priority-identity map)) "nothing"
        (flohm-priority-identity map)))
    (print_str "\n")
    (flohm-health-permille map))
