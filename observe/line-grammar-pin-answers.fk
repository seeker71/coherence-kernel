; line-grammar-pin-answers.fk — the literal answers of the body's search and
; trim doors, printed so a heal underneath them can be checked against paper
; rather than against a band that a change could quietly re-teach.
;
; preflight-exec: forbidden
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
(do
    (defn pa-row () "said|گفت|sagte|dit|disse|spuse")
    (defn pa-h () "abcdefghijklmn")
    (defn pa-join (xs) (if (eq (len xs) 0) "" (str_concat (str_concat "<" (str_concat (head xs) ">")) (pa-join (tail xs)))))
    (let a (list
        (str_find (pa-h) "" 99)
        (str_find "abc" "" 0)
        (str_find "abc" "" 3)
        (str_find "abc" "" 4)
        (str_find "" "abc" 0)
        (str_find "" "" 0)
        (str_find "" "" 5)
        (str_find "abc" "c" 0)
        (str_find "abc" "abcd" 0)
        (str_find "aaaa" "aa" 0)
        (str_find "aaaa" "aa" 1)
        (str_find (pa-row) "گفت" 0)
        (str_find (pa-row) "|" 5)
        (str_find (pa-row) "spuse" 0)
        (str_find (pa-row) "zzz" 0)))
    (let b (list
        (find-from (pa-h) "" 99)
        (find-from "abc" "" 0)
        (find-from "abc" "" 3)
        (find-from "abc" "" 4)
        (find-from "" "abc" 0)
        (find-from "" "" 0)
        (find-from "" "" 5)
        (find-from "abc" "c" 0)
        (find-from "abc" "abcd" 0)
        (find-from "aaaa" "aa" 0)
        (find-from "aaaa" "aa" 1)
        (find-from (pa-row) "گفت" 0)
        (find-from (pa-row) "|" 5)
        (find-from (pa-row) "spuse" 0)
        (find-from (pa-row) "zzz" 0)
        (find-from (pa-row) "|" (sub 0 3))))
    (let p2 (print a))
    (let p3 (print b))
    (let p4 (print (pa-join (split-on (pa-row) "|"))))
    (let p5 (print (pa-join (split-on "" "|"))))
    (let p6 (print (pa-join (split-on "|||" "|"))))
    ; NOT ASKED: (split-on s "") never returns — find-from answers `i`, the loop
    ; advances by (str_len sep) = 0 and asks the same position forever. That is
    ; true of the allocating find-loop and of the byte-wise one alike; it is the
    ; splitter's own shape, not the search's, and it is left exactly as it stands.
    (let p8 (print (pa-join (list (trim "  \t x y \n ") (trim "   ") (trim "") (trim "x") (trim-leading-ws "  گفت  ") (trim-trailing-ws "  گفت  ")))))
    (let p9 (print (list (str_len (trim "  \t x y \n ")) (str_len (trim "   ")) (if (is-blank? "  \n\t ") 1 0) (if (is-blank? " x ") 1 0))))
    0)
