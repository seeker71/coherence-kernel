// kernel-pages-bury-run.bml — bury the standing pages a caller names, as the care the census offered.
//
// stdin: one line of pids, chosen from a census reading by Urs or a hand with his word. Only pids the census
// reads as ended are touched, each through kernel_page_bury's guard. The readings, the response, the applied
// burial (per pid: 1 buried, 0 declined) and a fresh reading all speak as organ-health events.
//
//   echo "<pid> <pid>" | ./fkwu observe/kernel-pages-bury-run.bml
//
// preludes: form-stdlib/core.fk form/form-stdlib/kernel-pages.bml
section [form.bml] {
 class KernelPagesBuryRun {
  def kpbr-pids(words) = if nil?(words) then list() else if eq(str_len(head(words)), 0) then kpbr-pids(tail(words)) else cons(str_to_int(head(words)), kpbr-pids(tail(words)));
  def kpbr-chosen(line) = if nothing?(line) then list() else kpbr-pids(split-on(line, " "));
  def kpbr-run() = print_str(str_concat(json-emit-precise(json-node-array(kpg-bury(kpbr-chosen(read_line())))), "\n"));
 }
 kpbr-run();
}
