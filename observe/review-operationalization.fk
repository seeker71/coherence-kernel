// review-operationalization.fk — a measured refusal may enter the native floor.
//
import form-stdlib/core.fk;
//
// A review row is form-neutral data:
//   (meaning-symbol primary-expected primary-observed primary-seen
//                   control-expected control-observed control-seen fresh)
//
// The meaning symbol is numeric and carries no locale. A row is determinate only
// when its primary probe and negative control were both observed freshly, with
// the primary expected to hold and the control expected not to hold.
//
// Verdict symbols:
//   -1  a fresh probe/control pair witnessed a mismatch
//    0  the evidence cannot yet determine a verdict
//    1  every declared meaning has one unique, fresh, matching pair
section [form.bml] {
    def ro-revise() = -1;
    def ro-open() = 0;
    def ro-pass() = 1;
    def ro-row(symbol, p-expect, p-observe, p-seen, c-expect, c-observe, c-seen, fresh) = [symbol, p-expect, p-observe, p-seen, c-expect, c-observe, c-seen, fresh];
    def ro-symbol(row) = row[0];
    def ro-primary-expect(row) = row[1];
    def ro-primary-observe(row) = row[2];
    def ro-primary-seen(row) = row[3];
    def ro-control-expect(row) = row[4];
    def ro-control-observe(row) = row[5];
    def ro-control-seen(row) = row[6];
    def ro-fresh(row) = row[7];
    def ro-row-determinate?(row) = (Comparable) ro-fresh(row) == 1 ? (Comparable) ro-primary-seen(row) == 1 ? (Comparable) ro-control-seen(row) == 1 ? (Comparable) ro-primary-expect(row) == 1 ? (Comparable) ro-control-expect(row) == 0 ? 1 : 0 : 0 : 0 : 0 : 0;
    def ro-row-matches?(row) = (Comparable) ro-row-determinate?(row) == 1 ? (Comparable) ro-primary-expect(row) == ro-primary-observe(row) ? (Comparable) ro-control-expect(row) == ro-control-observe(row) ? 1 : 0 : 0 : 0;
    def ro-row-refuses?(row) = (Comparable) ro-row-determinate?(row) == 1 ? (Comparable) ro-row-matches?(row) == 1 ? 0 : 1 : 0;
    def ro-any-refusal?(rows) = (Comparable) len(rows) == 0 ? 0 : (Comparable) ro-row-refuses?(rows[0]) == 1 ? 1 : ro-any-refusal?(rows[1:]);
    def ro-all-match?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) ro-row-matches?(rows[0]) == 1 ? ro-all-match?(rows[1:]) : 0;
    def ro-symbol-in?(symbol, rows) = (Comparable) len(rows) == 0 ? 0 : (Comparable) symbol == ro-symbol(rows[0]) ? 1 : ro-symbol-in?(symbol, rows[1:]);
    def ro-symbols-unique?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) ro-symbol-in?(ro-symbol(rows[0]), rows[1:]) == 1 ? 0 : ro-symbols-unique?(rows[1:]);
    def ro-covered?(rows, declared-count) = declared-count > 0 ? (Comparable) len(rows) == declared-count ? ro-symbols-unique?(rows) : 0 : 0;
    // One witnessed mismatch is enough to revise. PASS needs complete coverage.
    // Everything else stays open for a probe or an outside review.
    def ro-verdict(rows, declared-count) = (Comparable) ro-any-refusal?(rows) == 1 ? ro-revise() : (Comparable) ro-covered?(rows, declared-count) == 1 ? (Comparable) ro-all-match?(rows) == 1 ? ro-pass() : ro-open() : ro-open();
    0;
}
