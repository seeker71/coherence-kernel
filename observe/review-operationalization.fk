; review-operationalization.fk — a measured refusal may enter the native floor.
;
; preludes: form-stdlib/core.fk
;
; A review row is form-neutral data:
;   (meaning-symbol primary-expected primary-observed primary-seen
;                   control-expected control-observed control-seen fresh)
;
; The meaning symbol is numeric and carries no locale. A row is determinate only
; when its primary probe and negative control were both observed freshly, with
; the primary expected to hold and the control expected not to hold.
;
; Verdict symbols:
;   -1  a fresh probe/control pair witnessed a mismatch
;    0  the evidence cannot yet determine a verdict
;    1  every declared meaning has one unique, fresh, matching pair

(do
    (defn ro-revise () -1)
    (defn ro-open () 0)
    (defn ro-pass () 1)

    (defn ro-row (symbol p-expect p-observe p-seen c-expect c-observe c-seen fresh)
        (list symbol p-expect p-observe p-seen c-expect c-observe c-seen fresh))

    (defn ro-symbol (row) (nth row 0))
    (defn ro-primary-expect (row) (nth row 1))
    (defn ro-primary-observe (row) (nth row 2))
    (defn ro-primary-seen (row) (nth row 3))
    (defn ro-control-expect (row) (nth row 4))
    (defn ro-control-observe (row) (nth row 5))
    (defn ro-control-seen (row) (nth row 6))
    (defn ro-fresh (row) (nth row 7))

    (defn ro-row-determinate? (row)
        (if (eq (ro-fresh row) 1)
            (if (eq (ro-primary-seen row) 1)
                (if (eq (ro-control-seen row) 1)
                    (if (eq (ro-primary-expect row) 1)
                        (if (eq (ro-control-expect row) 0) 1 0)
                        0)
                    0)
                0)
            0))

    (defn ro-row-matches? (row)
        (if (eq (ro-row-determinate? row) 1)
            (if (eq (ro-primary-expect row) (ro-primary-observe row))
                (if (eq (ro-control-expect row) (ro-control-observe row)) 1 0)
                0)
            0))

    (defn ro-row-refuses? (row)
        (if (eq (ro-row-determinate? row) 1)
            (if (eq (ro-row-matches? row) 1) 0 1)
            0))

    (defn ro-any-refusal? (rows)
        (if (eq (len rows) 0) 0
            (if (eq (ro-row-refuses? (head rows)) 1) 1
                (ro-any-refusal? (tail rows)))))

    (defn ro-all-match? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (ro-row-matches? (head rows)) 1)
                (ro-all-match? (tail rows))
                0)))

    (defn ro-symbol-in? (symbol rows)
        (if (eq (len rows) 0) 0
            (if (eq symbol (ro-symbol (head rows))) 1
                (ro-symbol-in? symbol (tail rows)))))

    (defn ro-symbols-unique? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (ro-symbol-in? (ro-symbol (head rows)) (tail rows)) 1) 0
                (ro-symbols-unique? (tail rows)))))

    (defn ro-covered? (rows declared-count)
        (if (gt declared-count 0)
            (if (eq (len rows) declared-count)
                (ro-symbols-unique? rows)
                0)
            0))

    ; One witnessed mismatch is enough to revise. PASS needs complete coverage.
    ; Everything else stays open for a probe or an outside review.
    (defn ro-verdict (rows declared-count)
        (if (eq (ro-any-refusal? rows) 1) (ro-revise)
            (if (eq (ro-covered? rows declared-count) 1)
                (if (eq (ro-all-match? rows) 1) (ro-pass) (ro-open))
                (ro-open))))

    0)
