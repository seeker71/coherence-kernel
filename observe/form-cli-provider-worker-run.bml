// preflight-exec: forbidden
// Internal worker; call through form-cli-provider-session-run for supervision.
// preludes: form-stdlib/bml/form-cli-provider-worker.bml form-stdlib/bml/form-cli-provider-session.bml
section [form.bml] {
 let path = read_line(); let raw = read_file(path);
 if not(fps-packet-valid(raw)) then form_error("worker request file is incomplete or oversized;provider not started") else 0;
 let request = parse-json("owned-provider-request",raw);
 if not(and(fps-valid(request),str_eq(path,frsh-path(nsm-str(request,"root"),"request.json")))) then form_error("worker request contract differs from its owned file;provider not started") else 0;
 fpw-run(request);
}
