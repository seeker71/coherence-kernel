; native-ask-run.fk — the body asks its own mind on its own metal, no crossing.
;
; stdin line 1: the ask (a literal \n becomes a line break; blank -> a short standing question)
; stdin line 2: how many new tokens to allow (blank -> the cell's own number)
; stdin line 3: "chat" (the model's own headers, the default) or "raw" (bare completion)
;
; Effectful: it opens the GPU.
; preflight-exec: forbidden
; preludes: form/form-stdlib/native-ask.bml
(do
    (defn nar-say (k v) (print_str (str_concat "native-ask " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn nar-t (x) (if (nothing? x) "" x))
    (defn nar-or (s d) (if (eq (str_len s) 0) d s))
    (defn nar-unesc (s i acc)
        (if (ge i (str_len s)) acc
            (if (and (eq (str_byte_at s i) 92) (and (lt (add i 1) (str_len s)) (eq (str_byte_at s (add i 1)) 110)))
                (nar-unesc s (add i 2) (str_concat acc (byte_to_str 10)))
                (nar-unesc s (add i 1) (str_concat acc (byte_to_str (str_byte_at s i)))))))
    (let raw (nar-or (nar-t (read_line)) "Say in one short sentence what a room is."))
    (let nraw (trim (nar-t (read_line))))
    (let shape (nar-or (trim (nar-t (read_line))) "chat"))
    (let maxnew (if (eq (str_len nraw) 0) (NAMaxNew) (str_to_int nraw)))
    (let ask (nar-unesc raw 0 ""))
    (nar-say "model" (na-model-path))
    (nar-say "shape" shape)
    (let r (if (str_eq shape "raw") (na-ask ask maxnew) (na-chat-ask ask maxnew)))
    (if (eq (na-answered? r) 1)
        (nar-say "said" (str_concat "|" (str_concat (na-said r) "|")))
        (nar-say "refused" (na-why r)))
    0)
