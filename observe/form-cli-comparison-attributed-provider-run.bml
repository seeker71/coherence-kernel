// preflight-exec: forbidden
// One explicitly offered Form-owned provider call on the retained native task.
// frsy owns admission and replay; interrupted claims never silently restart.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let root = ".hearth/response-parity/attributed-provider-v1";
 let prefix = "receipts/artifacts/2026-09-20-attributed-provider-comparison";
 let nativePrefix = "receipts/artifacts/2026-09-20-attributed-native-comparison";
 let sourceText = read_file(str_concat(nativePrefix,"-source.json"));
 let source = parse-json("native-source",sourceText);
 let packet = fcr-packet(str_concat(nativePrefix,"-packet.json"));
 fcr-need(str_eq(packet,fcr-fresh-packet(source)),"native task and source do not reconcile");
 let instruction = substring(packet,0,str_find(packet,"\n\n{",0));
 let initial = fcr-request(source,instruction);
 let request = oh-set(initial,"report_checks",json-node-array(list(head(node_children(json-object-get(initial,"report_checks"))))));
 let comparison = json-node-object(list(nsm-s("id","comparison-fresh"),json-node-pair("request",request)));
 let provider = parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}");
 let manifest = json-node-object(list(nsm-s("session","comparison-attributed-2026-09-20"),json-node-pair("cases",json-node-array(list(comparison))),json-node-pair("provider",provider)));
 fcr-need(and(frsy-valid(manifest),frsy-sources(node_children(json-object-get(manifest,"cases")))),"provider comparison source checks failed before admission");
 fs-mkdir(".hearth/response-parity"); fs-mkdir(root);
 frsh-frozen(str_concat(root,"/manifest.json"),json-emit(manifest));
 frsh-frozen(str_concat(root,"/rubric.md"),"Frozen before provider admission: identical retained source and task instruction to native attributed composition. Carrier envelopes and models differ. Inspect current totals, partial coverage, call-count scope, output sizes, attribution, citations, proposed repair and useful justified conclusion. Read complete answers; shape checks do not decide quality. Human resonance unmeasured. Count every provider attempt once and keep failed outputs. No evaluation training.\n");
 if fs_exists(str_concat(root,"/result.json")) then print_str(json-emit(frsy-run(manifest))) else {
  let started = now_unix_ms(); let result = frsy-run(manifest); let elapsed = sub(now_unix_ms(),started);
  fcr-need(eq(nsm-num(result,"checked"),1),"provider result incomplete or unchecked; inspect owned process without restarting");
  let raw = read_file(fcap-string(result,"answer_path"));
  fcr-need(faj-valid(raw),"provider output is not JSON; retained by synthesis owner");
  let parsed = parse-json("provider-report",raw);
  let answer = fcap-string(json-object-get(head(node_children(json-object-get(parsed,"results"))),"report"),"answer");
  let usage = json-object-get(result,"provider_usage");
  let report = json-node-object(append(json-object-pairs(result),list(nsm-n("native_driver_ms",elapsed),nsm-n("uncached_input_tokens",sub(nsm-num(usage,"input_tokens"),nsm-num(usage,"cached_input_tokens"))),nsm-s("source_sha256",fcam-hash(sourceText)),nsm-n("instruction_unchanged",1),nsm-n("source_unchanged",1),nsm-n("local_model_calls",0),nsm-n("training",0),json-node-pair("semantic_quality",json-node-null()),json-node-pair("human_resonance",json-node-null()))));
  frsh-frozen(str_concat(root,"/result.json"),json-emit(report));
  frsh-frozen(str_concat(prefix,"-result.json"),json-emit(report));
  frsh-frozen(str_concat(prefix,"-report.json"),raw);
  frsh-frozen(str_concat(prefix,"-answer.md"),answer);
  frsh-frozen(str_concat(prefix,"-source.json"),sourceText);
  frsh-frozen(str_concat(prefix,"-manifest.json"),json-emit(manifest));
  print_str(json-emit(report));
 };
 1;
}
