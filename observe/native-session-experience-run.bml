// Private experience recall. JSON stdin: query, optional skill and home.
// preludes: form-stdlib/native-session-experience.bml
section [form.bml] {
 class NativeSessionExperienceRun {
  def nsxr-run() {
   let raw = read_line();
   if (nothing?(raw) || ((String) raw == "")) then print_str("JSON stdin: query, optional skill and home. Recall stays private; stdout names its reading.\n") else nsxr-request(parse-json("experience-recall",raw));
  }
  def nsxr-request(request) {
   let home = nsm-str(request,"home");
   let result = nsx-recall(if ((String) home == "") then hearth-session-learning() else home,nsm-str(request,"query"),nsm-str(request,"skill"));
   print_str(str_concat(json-emit-precise(nsx-report(result)),"\n"));
  }
 }
 nsxr-run();
}
