// query-coverage-run.bml — how much of what was asked the body answered from itself, by kind of enquiry.
//
//   printf '' | ./fkwu observe/query-coverage-run.bml                        every row of receipts/query-coverage-ledger.jsonl
//   printf '{"since_ms":1793000000000}' | ./fkwu observe/query-coverage-run.bml   only the rows whose own time is at or after that unix ms
//   printf '{"path":".hearth/x.jsonl"}' | ./fkwu observe/query-coverage-run.bml   another ledger of the same rows
//
// The ledger is written where the answer is made (form-stdlib/bml/form-cli-grounded-synthesis.bml, one QueryCoverageRow per fgs-answer).
// A row is native when it was answered and its source is the substrate or the in-process fkwu model session; a provider answer and an
// unanswered enquiry both count in `all` and not in `native`. One line per kind (lookup, structural, prose, code, plan), then `all`:
// `[query-coverage] <kind>: <native> native of <all> (<percent>%)`; a kind with no rows says so. Reads only; the ledger is not touched.
// stdin: one JSON object, every key optional (an empty stdin is {}): since_ms (int), path (str). A request that does not read is refused by name.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/form-cli-grounded-synthesis.bml
section [form.bml] {
 class QueryCoverageRun {
  def qcr-tag() = "[query-coverage] ";
  def qcr-line(row) = qcr-tag() ++ row[0] ++ ": " ++ row[1].str() ++ " native of " ++ row[2].str() ++ (row[2] == 0 ? " (no rows)" : " (" ++ fgs-coverage-percent(row[1], row[2]).str() ++ "%)");
  def qcr-run() {
   let doc = dop-doc("query-coverage", stdin-text(), [["since_ms", "int"], ["path", "str"]]);
   let since = json-object-has?(doc, "since_ms") ? fhn-number(doc, "since_ms") : 0;
   let path = json-object-has?(doc, "path") ? fhn-text(doc, "path") : fgs-coverage-ledger();
   let rows = fgs-coverage-since(fgs-coverage-rows(path), since);
   let shown = map(row => print_str(qcr-line(row)), fgs-coverage-table(rows));
   print_str(qcr-tag() ++ path ++ ": " ++ len(rows).str() ++ " row(s)" ++ (since > 0 ? " since " ++ since.str() : ""));
  }
 }
 qcr-run();
 0;
}
