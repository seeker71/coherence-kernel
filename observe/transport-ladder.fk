; observe/transport-ladder.fk — the reachability ladder over EVERY mesh transport,
; so two organs connect whether or not they share a network. mesh-sense-7w.fk already
; weights a channel by FITNESS-for-a-plane (which channel best answers "who" vs
; "where"); this cell answers the prior question: of all the channels that COULD carry
; the mesh, which are actually reachable right now, and which is best to use.
;
; A transport is (rank reachable implemented):
;   rank        1..8, lower = preferred. The order prefers direct/local/offline-capable
;               channels (cheap, private, no infra) and falls back to the cloud proxy
;               (works across ANY network with internet) so the mesh survives being apart.
;   reachable   0/1 — is this channel up right now (a carrier runtime probe fills it).
;   implemented 0/1 — is the carrier code for this channel REAL yet. THE HONEST FLOOR:
;               a transport that is reachable but not implemented is NOT usable — the
;               ladder refuses to route over a channel we have only named, never built.
;               This is the never-fabricate discipline compiled into the picker.
;
; The eight transports (Urs's full list + LAN), by rank:
;   1 wifi-direct   (peer radio, no router)          pending
;   2 wifi-mesh     (multi-hop peer)                  pending
;   3 bluetooth     (short-range radio)               pending
;   4 nfc           (touch)                           pending
;   5 acoustic      (speaker <-> mic)                 pending
;   6 optical       (screen <-> camera, QR)           pending
;   7 lan-mdns      (same-network direct)             WIRED (NsdManager+socket, proven no-cloud)
;   8 cloud-proxy   (phone-network => public api)     LIVE  <- the only built one today,
;                   and the one that already makes the mesh work cross-network (proven
;                   2026-07-08: phone at Hati Suci and Mac both present on the deployed
;                   membrane, phone reaching api.coherencycoin.com over its own link).
;
;   tl-pick    -> the rank of the best USABLE transport, or 0 (honest offline) if none.
;   tl-count   -> how many transports are usable now = the mesh's RESILIENCE (independent
;                 ways to connect; a mesh with two is anastomotic — reroutes if one dies).
;
; preludes: form-stdlib/core.fk

(do
    (defn tl-t (rank reach impl) (list rank reach impl))
    (defn tl-rank (t) (nth t 0))
    (defn tl-reach (t) (nth t 1))
    (defn tl-impl (t) (nth t 2))
    ; usable = reachable AND implemented (an un-built channel is never usable, no matter how reachable)
    (defn tl-usable (t) (if (eq (tl-reach t) 1) (tl-impl t) 0))
    (defn tl-cand (t) (if (eq (tl-usable t) 1) (tl-rank t) 999))
    (defn tl-pick-loop (ts best)
        (if (eq (len ts) 0) best
            (tl-pick-loop (tail ts)
                (if (lt (tl-cand (head ts)) best) (tl-cand (head ts)) best))))
    (defn tl-pick-from (r) (if (eq r 999) 0 r))
    (defn tl-pick (ts) (tl-pick-from (tl-pick-loop ts 999)))
    (defn tl-count (ts) (if (eq (len ts) 0) 0 (add (tl-usable (head ts)) (tl-count (tail ts)))))

    ; today's honest ladder — only cloud-proxy is built; it is reachable wherever there
    ; is internet, which is why the mesh already works across networks.
    ; lan-mdns (rank 7) is now WIRED (impl 1); its static reach stays 0 here — this
    ; snapshot models organs APART (no same-network peer), so the pick is cloud (8).
    ; When co-present, the carrier probe flips lan reach to 1 and the ladder prefers it.
    (defn tl-today ()
        (list (tl-t 1 0 0) (tl-t 2 0 0) (tl-t 3 0 0) (tl-t 4 0 0)
              (tl-t 5 0 0) (tl-t 6 0 0) (tl-t 7 0 1) (tl-t 8 1 1)))
    0)
