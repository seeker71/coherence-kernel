; qwen38-sliced-prefill-proof-run.fk — two doors, one truth: the same id
; sequence prefilled through the proven per-token walker and through the
; span-sliced batched door, on two fresh stream states over ONE opened
; context. The witness is the returned (first-pending-token, position)
; pair — equality across doors on real weights is the argmax of the whole
; head agreeing, plus the wall-time of each door. Effectful: opens the
; model, touches the GPU. Do not preflight.
; preludes: form-stdlib/core.fk native/metal/qwen35-dense-token-handle.fk
(do
    (defn sp-line (k v) (print_str (str_concat "proof " (str_concat k (str_concat "=" (str_concat v (byte_to_str 10)))))))
    (defn sp-int (k v) (sp-line k (int_to_str v)))
    (defn sp-ids-go (i n acc) (if (ge i n) acc (sp-ids-go (add i 1) n (cons (add 100 (mul i 37)) acc))))
    (defn sp-ids (n) (reverse (sp-ids-go 0 n (empty))))
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let ctx (q38-open-span path 1024 384))
    (if (lt (len ctx) 10)
        (sp-line "refused" (metal_status))
        (do
            (let ps (nth ctx 0))
            (let bs (nth ctx 1))
            (let geo (nth ctx 2))
            (let lays (nth ctx 3))
            (let ids (sp-ids 96))
            (let sts1 (q38-new-state geo))
            (let t0 (now_unix_ms))
            (let pf1 (q38-prefill ps bs geo lays sts1 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0))
            (let t1 (now_unix_ms))
            (let f1 (q38-free-state sts1))
            (let sts2 (q38-new-state geo))
            (let t2 (now_unix_ms))
            (let pf2 (q38-prefill-span-sliced ps bs geo lays sts2 (nth ctx 4) (nth ctx 5) (nth ctx 6) ids 0 384))
            (let t3 (now_unix_ms))
            (let f2 (q38-free-state sts2))
            (sp-int "walker-first" (nth pf1 0))
            (sp-int "walker-pos" (nth pf1 1))
            (sp-int "walker-ms" (sub t1 t0))
            (sp-int "sliced-first" (nth pf2 0))
            (sp-int "sliced-pos" (nth pf2 1))
            (sp-int "sliced-ms" (sub t3 t2))
            (sp-int "doors-agree" (if (and (eq (nth pf1 0) (nth pf2 0)) (eq (nth pf1 1) (nth pf2 1))) 1 0))
            (let closed (q38-close ctx (empty)))
            0)))
