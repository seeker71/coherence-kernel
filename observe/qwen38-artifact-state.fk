; preludes: form-stdlib/qwen35-artifact-fetch.fk

(do
    (let spec (qaf-default-spec))
    (let state-text (fs-read-text (qaf-spec-state-path spec)))
    (list
        (qaf-committed-offset spec)
        (substring state-text 0 (if (lt (str_len state-text) 16) (str_len state-text) 16))
        (str_len (qaf-state-hash-of state-text))
        (fs-exists? (qaf-spec-target spec))
        (if (eq (fs-exists? (qaf-spec-target spec)) 1)
            (fs-stat-size (qaf-spec-target spec)) 0)))
