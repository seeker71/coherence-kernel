// preflight-exec: forbidden
// JSON stdin: home, teacher, condition, adapter, case. Practice targets only.
// preludes: learn/bml-token-observation.bml
section [form.bml] {
 def bto-door(raw) {
  let request = parse-json("BML token observation",raw);
  bto-run(nsm-str(request,"home"),nsm-str(request,"teacher"),nsm-str(request,"condition"),nsm-str(request,"adapter"),nsm-str(request,"case"));
 }
 bto-door(read_line());
 0;
}
