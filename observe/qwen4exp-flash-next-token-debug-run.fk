; Bounded tensor-parity probe for the first native qwen4exp token.
; It stops after layer zero and reads only named scratch buffers so the first
; divergent operation can be compared with llama.cpp's eval callback oracle.
;
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form-stdlib/model-registry.bml

(do
    (defn q4td-word (s i)
        (add (str_byte_at s (mul i 4))
        (add (mul (str_byte_at s (add (mul i 4) 1)) 256)
        (add (mul (str_byte_at s (add (mul i 4) 2)) 65536)
             (mul (str_byte_at s (add (mul i 4) 3)) 16777216)))))
    (defn q4td-f32 (s i) (fd-value (q4td-word s i) 8 23))
    (defn q4td-sum-go (s i n acc)
        (if (ge i n) acc
            (q4td-sum-go s (add i 1) n (add acc (q4td-f32 s i)))))
    (defn q4td-summary (h n)
        (do
            (let s (metal_buf_read h 0 (mul n 4)))
            (list (q4td-f32 s 0) (q4td-f32 s 1) (q4td-f32 s 2)
                  (q4td-f32 s (sub n 3)) (q4td-f32 s (sub n 2))
                  (q4td-f32 s (sub n 1)) (q4td-sum-go s 0 n 0.0))))
    (defn q4td-u32s-go (s i n acc)
        (if (ge i n) (reverse acc)
            (q4td-u32s-go s (add i 1) n (cons (q4td-word s i) acc))))
    (defn q4td-u32s (h n)
        (do (let s (metal_buf_read h 0 (mul n 4))) (q4td-u32s-go s 0 n (empty))))
    (defn q4td-f32s-go (s i n acc)
        (if (ge i n) (reverse acc)
            (q4td-f32s-go s (add i 1) n (cons (q4td-f32 s i) acc))))
    (defn q4td-f32s (h n)
        (do (let s (metal_buf_read h 0 (mul n 4))) (q4td-f32s-go s 0 n (empty))))
    (defn q4td-bytes-go (s i n acc)
        (if (ge i n) (reverse acc)
            (q4td-bytes-go s (add i 1) n (cons (str_byte_at s i) acc))))
    (defn q4td-bytes (h off n)
        (do (let s (metal_buf_read h off n)) (q4td-bytes-go s 0 n (empty))))
    (defn q4td-iq4nl-first (h logical)
        (do
            (let raw (q4td-bytes h (mul (div logical 32) 18) 18))
            (list (take 16 raw)
                  (iq4nl-d raw 0)
                  (iq4nl-quant-code raw 0 (mod logical 32))
                  (iq4nl-at-flat raw 0 (mod logical 32)))))

    (let prefix (mr-flash-next-prefix))
    (let ctx (q4t-open prefix 16))
    (let aps (nth ctx 0)) (let qps (nth ctx 1)) (let gps (nth ctx 2))
    (let bs (nth ctx 3)) (let lays (nth ctx 4)) (let model (nth ctx 5))
    (let sts (nth ctx 6)) (let lay (nth lays 0)) (let st (nth sts 0))

    (q4t-embed qps gps bs (nth model 0) 9419)
    (let emb (q4td-summary (nth bs 0) 2560))
    (let init (q4td-summary (nth bs 1) 10240))
    (q4t-hc-mix qps gps bs lay 0)
    (let hcnorm (q4td-summary (nth bs 2) 10240))
    (let low (q4td-summary (nth bs 3) 320))
    (let hcgatepre (q4td-summary (nth bs 4) 10240))
    (let mixed (q4td-summary (nth bs 5) 2560))
    (let inject (q4td-summary (nth bs 6) 4))
    (q4t-linear aps qps gps bs lay st)
    (let qkv (q4td-summary (nth bs 8) 10240))
    (let linear (q4td-summary (nth bs 7) 2560))
    (q4gj-hc-combine gps (nth bs 1) (nth bs 7) (nth bs 6))
    (let combined (q4td-summary (nth bs 1) 10240))
    (q4t-hc-mix qps gps bs lay 4)
    (let ffnmixed (q4td-summary (nth bs 5) 2560))
    (q4t-mv qps (nth lay 8) (nth bs 5) (nth bs 21))
    (metal_enqueue (nth aps 20)
        (q4t-b16 (list (nth bs 21) (nth bs 22) (nth bs 23)) (list 512 10)) 1)
    (let route-logits (q4td-summary (nth bs 21) 512))
    (let route-ids (q4td-u32s (nth bs 22) 10))
    (let route-wts (q4td-f32s (nth bs 23) 10))
    (q4t-mv-selected qps (nth lay 9) (nth bs 5) (nth bs 24) (nth bs 22) 0)
    (q4t-mv-selected qps (nth lay 10) (nth bs 5) (nth bs 25) (nth bs 22) 0)
    (let expert0-gate (q4td-summary (nth bs 24) 640))
    (let expert0-up (q4td-summary (nth bs 25) 640))
    (metal_enqueue (nth aps 18)
        (q4t-b16 (list (nth bs 24) (nth bs 25) (nth bs 26)) (list 640)) 640)
    (let expert0-act (q4td-summary (nth bs 26) 640))
    (q4t-mv-selected qps (nth lay 11) (nth bs 26) (nth bs 27) (nth bs 22) 0)
    (let expert0-down (q4td-summary (nth bs 27) 2560))
    (q4eq-all-mv qps (q4tv-h (nth lay 11)) (nth bs 26) (nth bs 27)
        (q4tv-ty (nth lay 11)) (q4tv-r (nth lay 11)) (q4tv-c (nth lay 11))
        (mul 434 (mul (q4tv-r (nth lay 11)) (q4tv-c (nth lay 11)))) 0)
    (let expert0-down-offset (q4td-summary (nth bs 27) 2560))
    (let down-logical (mul 434 (mul (q4tv-r (nth lay 11)) (q4tv-c (nth lay 11)))))
    (let down-first-weight (q4td-iq4nl-first (q4tv-h (nth lay 11)) down-logical))
    (metal_enqueue (nth aps 21)
        (q4t-b16 (list (nth bs 27) (nth bs 28) (nth bs 23)) (list 0 2560)) 2560)
    (q4t-experts-go aps qps bs lay 1)
    (let routed (q4td-summary (nth bs 28) 2560))
    (q4t-mv qps (nth lay 13) (nth bs 5) (nth bs 29))
    (q4t-mv qps (nth lay 14) (nth bs 5) (nth bs 30))
    (metal_enqueue (nth aps 18)
        (q4t-b16 (list (nth bs 29) (nth bs 30) (nth bs 31)) (list 640)) 640)
    (q4t-mv qps (nth lay 15) (nth bs 31) (nth bs 32))
    (q4t-mv qps (nth lay 12) (nth bs 5) (nth bs 33))
    (let shared (q4td-summary (nth bs 32) 2560))
    (let shared-gate (q4td-f32s (nth bs 33) 1))
    (metal_enqueue (nth aps 23)
        (q4t-b16 (list (nth bs 32) (nth bs 28) (nth bs 33)) (list 2560)) 2560)
    (let ffn (q4td-summary (nth bs 28) 2560))
    (q4gj-hc-combine gps (nth bs 1) (nth bs 28) (nth bs 6))
    (let llast (q4td-summary (nth bs 1) 10240))
    (let live (metal_status))
    (q4t-close ctx)
    (list "qwen4exp-flash-next-token-debug"
        (list "embedding" emb) (list "hc-init" init)
        (list "hc-norm-0" hcnorm) (list "hc-low-0" low)
        (list "hc-gate-pre-0" hcgatepre) (list "hc-mixed-0" mixed)
        (list "hc-inject-0" inject) (list "qkv-0" qkv)
        (list "linear-out-0" linear) (list "hc-combine-attn-0" combined)
        (list "hc-mixed-ffn-0" ffnmixed)
        (list "route-logits-0" route-logits) (list "route-ids-0" route-ids)
        (list "route-weights-0" route-wts)
        (list "expert0-gate" expert0-gate) (list "expert0-up" expert0-up)
        (list "expert0-act" expert0-act) (list "expert0-down" expert0-down)
        (list "expert0-down-offset" expert0-down-offset)
        (list "expert0-down-shape" (list (q4tv-ty (nth lay 11))
            (q4tv-r (nth lay 11)) (q4tv-c (nth lay 11)) down-logical))
        (list "expert0-down-first-weight" down-first-weight)
        (list "routed-out-0" routed)
        (list "shared-out-0" shared) (list "shared-gate-0" shared-gate)
        (list "ffn-out-0" ffn)
        (list "l-last-0" llast) (list "metal-status" live)
        (list "after-close" (metal_status))))
