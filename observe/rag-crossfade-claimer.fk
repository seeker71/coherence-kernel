; rag-crossfade-claimer.fk — a worker that claims a batch off a durable crossfade journal and
; then does not come back. It is the death in observe/rag-crossfade-durable-run.fk's proof.
;
; PROOF LEVEL: FKWU ONLY — host IO (a journal on disk, this process's pid, a rest).
;
; One journal path arrives as one stdin line, so the parent's path is this process's own and no
; sibling agent can replace it between the write and the read. The cell claims two ids under its
; own pid, prints what it won, and then rests. It never releases and never fails: whatever the
; parent does to it next, the journal is left holding a claim with a live-looking owner — which is
; exactly the state a worker killed mid-batch leaves behind.
;
; The rest is bounded so a parent that never kills it leaves no orphan: it exits on its own after
; a minute. A claim it still holds at that exit is recovered by the next rcs-open like any other.
;
; preludes: form-stdlib/bml/rag-crossfade-spool.bml
(do
    (defn rcc-trim (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n")
                (rcc-trim s (sub n 1))
                (substring s 0 n))))
    (defn rcc-line (raw) (if (nothing? raw) "" (rcc-trim raw (str_len raw))))
    (let journal (rcc-line (read_line)))
    (if (eq (str_len journal) 0)
        (print_str "rag-crossfade-claimer: send one journal path on stdin")
        (do (let owner (rcs-me))
            (let rows (rcs-claim journal 2 owner))
            (print_str (str_concat "claimed by " (str_concat owner (str_concat " -> " (int_to_str (len (rcq-held rows owner)))))))
            (let rested (host_sleep_ms 60000))
            (print_str "claimer rested out")))
    0)
