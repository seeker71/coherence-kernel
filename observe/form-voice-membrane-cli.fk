; stdin: phase, exchange id, prompt digest, then open: missing; close: action, returned exchange, acted.
; preludes: form-stdlib/core.fk observe/form-voice-membrane.fk

(do
    (let phase (read_line))
    (let exchange (read_line))
    (let prompt-digest (read_line))
    (if (str_eq phase "open")
        (print_str (fvm-open exchange prompt-digest (str_to_int (read_line))))
        (if (str_eq phase "close")
            (print_str (fvm-close exchange prompt-digest (read_line) (read_line)
                (str_to_int (read_line))))
            (print_str "schema=form-voice-membrane-v1\nphase=refused\nstate=unknown-phase\n")))
    0)
