// movement-run.bml — a whole movement of the rent path in one native call.
//
// One process, one census window, no child kernel: the body composes its own
// answer and floors it (form-stdlib/bml/form-cli-native-compare.bml), speaks
// that composition through its own model session on this metal, wearing its
// own trained adapter when the caller names the lora lane
// (form-stdlib/bml/form-cli-voice-walk.bml), reads the arriving mind's flow
// (form-stdlib/bml/form-cli-flow-meter.bml), redraws the page from the
// ledgers (form-stdlib/bml/form-cli-rent-ladder-page.bml) and lands
// (form-stdlib/bml/form-cli-landing.bml: restart, gates, commit, push). The
// composition never travels through a pipe and the model is admitted once, in
// this call's own process. No provider is asked anywhere in it. The crossings
// that remain are the landing's: git, and the drift gates in their own fresh
// kernel so a warm image cannot vouch for the tree. The arriving mind makes
// one call and relays one line; every crossing is counted and printed.
//
// stdin: one JSON object, every field optional
//   {"movement":"<name>", "voice":1, "compare":1, "transcript":"<path or empty>",
//    "lane":"lora", "adapter":"<dir>", "model":"qwen38-q8", "max_reply_tokens":1536,
//    "land":1, "restart":"", "main":0, "paths":["extra", ...], "subject":"...", "body":"..."}
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-turn-meter.bml form-stdlib/meaning-codes.bml form-stdlib/bml/form-cli-voice-walk.bml form-stdlib/bml/form-cli-flow-meter.bml form-stdlib/bml/form-cli-rent-ladder-page.bml form-stdlib/bml/form-cli-landing.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class Movement {
  def mv-source() = "observe/movement-run.bml";
  def mv-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def mv-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def mv-flag(doc, key, fallback) = json-object-has?(doc, key) ? ((Comparable) json-int-value(json-object-get(doc, key)) == 1) : fallback;
  def mv-values(doc, key) = json-object-has?(doc, key) ? oh-values(json-array-elements(json-object-get(doc, key))) : list();
  def mv-nodes(xs) = xs |> map(json-node-string);
  def mv-first-line(text) { let at = str_find(text, "\n", 0); at < 0 ? text : substring(text, 0, at); }
  def mv-doc(text) = (String) trim(text) == "" ? json-node-object(list()) : parse-json("child-line", mv-first-line(text));
  def mv-row(doc) = json-object-has?(doc, "row") ? json-object-get(doc, "row") : json-node-object(list());
  def mv-grep-line(text, mark) { let at = str_find(text, mark, 0); at < 0 ? "" : mv-first-line(substring(text, at, str_len(text))); }
  def mv-planes(planes, rows) = nil?(planes) ? "" : (head(planes) ++ "=" ++ int_to_str(fmrc-delta-plane-total(rows, head(planes))) ++ (nil?(tail(planes)) ? "" : " ") ++ mv-planes(tail(planes), rows));
  def mv-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh");
  def mv-ledger-paths() = list("receipts/rent-ledger.jsonl", "receipts/parity-contest-ledger.jsonl", "receipts/flow-ledger.jsonl", "receipts/crossings-ledger.jsonl", "docs/rent-ladder.html");
  def mv-crossings() = "receipts/crossings-ledger.jsonl";
  // What the rented mind spent on the turn this movement belongs to, read from
  // its own transcript. The goal's ledger asks for rent beside every movement;
  // without this the second column is a number a person types afterwards. Cache
  // reads are left out: uncached tokens are what a turn actually cost to make.
  def mv-coordinating-rent(transcript) = mv-rent-of(transcript, mv-coordination());
  def mv-rent-of(transcript, c) = (Comparable) c[2] == 0 ? 0 : (String) transcript == "" ? (0 - 1) : mv-last-turn(ftm-turns(file_size(transcript) > 0 ? fhn-read(transcript) : ""));
  def mv-last-turn(turns) = nil?(turns) ? 0 : nil?(tail(turns)) ? ftm-uncached(head(turns)) : mv-last-turn(tail(turns));
  // Who started this movement, read from the host's own process table rather
  // than declared by the caller. The goal's exit proof asks for a movement with
  // no rented mind coordinating it and for that to be checkable from the rows
  // alone; a walk the host's scheduler began has launchd for a parent, and a
  // walk a session began carries that session's own binary. The body says which
  // it was, and says it about itself.
  def mv-row-of(value) = (String) value_kind(value) == "int" ? list() : value;
  def mv-self() = mv-row-of(host_process(host_pid()));
  def mv-parent(me) = len(me) < 2 ? list() : mv-row-of(host_process(me[1]));
  def mv-exe(row) = len(row) < 3 ? "" : row[2];
  def mv-tail(path, i) = i <= 0 ? path : (Comparable) str_byte_at(path, i - 1) == 47 ? substring(path, i, str_len(path)) : mv-tail(path, i - 1);
  def mv-base(path) = (String) path == "" ? "" : mv-tail(path, str_len(path));
  def mv-keeper?(exe) = (String) mv-base(exe) == "launchd";
  // The coordinator is the first ancestor that is neither the body nor a shell: a scheduled walk is
  // launchd -> fkwu scheduled-walk -> sh -> fkwu movement, and reading only the direct parent named
  // the shell and called three unattended walks (2026-09-23..25) a session with a rented mind.
  def mv-glue?(exe) = ((String) mv-base(exe) == "fkwu") || (((String) mv-base(exe) == "sh") || (((String) mv-base(exe) == "zsh") || (((String) mv-base(exe) == "bash") || ((String) mv-base(exe) == "form-run"))));
  def mv-climb(row, hops) = (len(row) < 3) || (hops <= 0) ? row : mv-glue?(mv-exe(row)) ? mv-climb(mv-parent(row), hops - 1) : row;
  def mv-coordination() = mv-coordination-of(mv-exe(mv-climb(mv-parent(mv-self()), 8)));
  def mv-coordination-of(exe) = list((String) exe == "" ? "unread" : mv-keeper?(exe) ? "host-schedule" : "session", exe, mv-keeper?(exe) ? 0 : 1);
  def mv-coordination-node(c) = json-node-object(list(fhn-s("by", c[0]), fhn-s("parent", c[1]), fhn-n("rented_mind", c[2])));
  // one row per movement, written after the census closes and before the page redraw and the landing, so the page draws it and the landing carries it; the page and landing child kernels come after the row and are not in it: the movement door's own planes and the voice and compare doors' dispatches, read from their printed census
  def mv-crossings-row(name, rows, request) = mv-crossings-row-at(name, rows, mv-coordination(), request);
  def mv-crossings-row-at(name, rows, c, request) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", name),
   fhn-s("coordinated_by", c[0]),
   fhn-s("coordinator", c[1]),
   fhn-n("rented_mind", c[2]),
   fhn-n("coordinating_rent", mv-coordinating-rent(mv-str(request, "transcript"))),
   fhn-n("movement_dispatches", fmrc-delta-total(rows)),
   fhn-n("movement_stdio", fmrc-delta-plane-total(rows, "stdio")),
   fhn-n("movement_filesystem", fmrc-delta-plane-total(rows, "filesystem")),
   fhn-n("movement_local_process", fmrc-delta-plane-total(rows, "local-process")),
   fhn-n("movement_network", fmrc-delta-plane-total(rows, "network-address-unknown")),
   fhn-n("voice_dispatches", 0),
   fhn-n("voice_network", 0),
   fhn-n("compare_dispatches", 0),
   fhn-n("voice_and_compare_in_movement_window", 1)));
  def mv-with(doc, request, key) = json-object-has?(request, key) ? json-node-object(append(json-object-pairs(doc), list(json-node-pair(key, json-object-get(request, key))))) : doc;
  // Every door speaks its own state; the movement gathers what they said, keeps
  // it in the body's own spool and carries the count in its line, so one call
  // shows where healing is wanted without any gate standing in the way.
  def mv-health-spool() = ".form-heal/movement-health.jsonl";
  // A walk says that it began, before it does anything that takes time. A walk
  // that never returns used to leave nothing at all: on 2026-09-23 the keeper's
  // own walk ran sixteen hours and the only trace was a process. Now a began
  // with no close beside it is a walk still out, or a walk that did not come
  // home — either way something a reader can see.
  def mv-began(name, c) = oh-emit(mv-health-spool(), oh-voice(oh-reading("movement", name, "walk", json-node-string("closes"), json-node-string("began"), json-node-null(), list(), list("wait", "read-the-log", "end-the-walk"), oh-reference(mv-health-spool()))));
  def mv-unease(readings) = nil?(readings) ? 0 : ((oh-unease(head(readings)) ? 1 : 0) + mv-unease(tail(readings)));
  def mv-keep(readings) = nil?(readings) ? 0 : mv-keep(mv-kept(oh-emit(mv-health-spool(), head(readings)), tail(readings)));
  def mv-kept(emitted, rest) = rest;
  def mv-readings(voiceOut, flowOut, pageOut, landOut) = append(mv-slot(voiceOut, 3), append(mv-slot(flowOut, 2), append(mv-slot(pageOut, 1), mv-slot(landOut, 1))));
  def mv-slot(walked, i) = nil?(walked) || (len(walked) < (i + 1)) ? list() : walked[i];
  def mv-voice-request(name, composition, request) = mv-with(mv-with(mv-with(mv-with((String) composition == "" ? json-node-object(list(fhn-s("movement", name))) : json-node-object(list(fhn-s("movement", name), fhn-s("composition", composition))), request, "lane"), request, "adapter"), request, "model"), request, "max_reply_tokens");
  // the voice and the compare run inside this call's own census window: one process, no pipe, no child kernel
  def mv-voice-walk(name, on, composition, request) = on ? nvw-walk(mv-voice-request(name, composition, request)) : list(json-node-object(list()), "", "", list());
  def mv-compare(on) = on ? fnc-walk() : list("", list(0, 0, 0, 0, 0), "");
  def mv-flow(name, transcript) = (String) transcript == "" ? list(json-node-object(list()), "", list()) : fm-reading(transcript, name);
  def mv-page() = rlp-walk();
  def mv-land-request(request, name) = json-node-object(list(
   fhn-s("restart", mv-str(request, "restart")),
   fhn-n("main", mv-int(request, "main")),
   fhn-s("witness", ""),
   fhn-a("paths", mv-nodes(append(mv-ledger-paths(), mv-values(request, "paths")))),
   fhn-s("subject", (String) mv-str(request, "subject") == "" ? ("Movement " ++ name ++ ": rows and the redrawn ladder") : mv-str(request, "subject")),
   fhn-s("body", (String) mv-str(request, "body") == "" ? "Walked by the body in one call (observe/movement-run.bml): the native voice through the in-process model, the native single call, the flow meter, the page redrawn from the ledgers." : mv-str(request, "body"))));
  def mv-land(request, name, on) = on ? ld-land(mv-land-request(request, name)) : list("", list());
  def mv-run() {
   let window = fmrc-open("movement", "voice compare flow page land", mv-source(), 1, 1);
   let line0 = read_line();
   let line = nothing?(line0) ? "" : trim(line0);
   let request = (String) line == "" ? json-node-object(list()) : parse-json("movement-request", line);
   let name = (String) mv-str(request, "movement") == "" ? "movement" : mv-str(request, "movement");
   let announced = mv-began(name, mv-coordination());
   let compared = mv-compare(mv-flag(request, "compare", true));
   let compare = fnc-floor-line(compared[1], compared[2]);
   let voiceWalk = mv-voice-walk(name, mv-flag(request, "voice", true), compared[0], request);
   let voice = head(voiceWalk);
   let flowWalk = mv-flow(name, mv-str(request, "transcript"));
   let flow = head(flowWalk);
   let result0 = fmrc-close(window, "observed", mv-source(), 2, 1);
   let rows0 = fmrc-result-deltas(result0);
   let crossed = fhn-append(mv-crossings(), json-emit(mv-crossings-row(name, rows0, request)) ++ "\n");
   let pageWalk = mv-page();
   let page = head(pageWalk);
   let landWalk = mv-land(request, name, mv-flag(request, "land", true));
   let landed = head(landWalk);
   let readings = mv-readings(voiceWalk, flowWalk, pageWalk, landWalk);
   let keptHealth = mv-keep(readings);
   let result = result0;
   let rows = rows0;
   print_str(json-emit-precise(json-node-object(list(
    fhn-s("movement", name),
    json-node-pair("coordinated", json-node-object(append(json-object-pairs(mv-coordination-node(mv-coordination())), list(fhn-n("coordinating_rent", mv-coordinating-rent(mv-str(request, "transcript"))))))),
    json-node-pair("voice", json-node-object(list(
     fhn-s("source", mv-str(voice, "source")),
     fhn-s("model", mv-str(voice, "oracle_model")),
     fhn-n("predicted", mv-int(voice, "oracle_tokens_predicted")),
     fhn-n("axes", mv-int(voice, "answer_axes")),
     fhn-n("receipts_cited", mv-int(voice, "answer_receipts_cited")),
     fhn-n("ms", mv-int(voice, "oracle_ms")),
     fhn-s("answer", mv-str(voice, "answer"))))),
    fhn-s("compare", compare),
    json-node-pair("flow", json-node-object(list(
     fhn-n("provider_calls", mv-int(flow, "provider_calls")),
     fhn-n("native_fkwu_calls", mv-int(flow, "native_fkwu_calls")),
     fhn-n("non_form_calls", mv-int(flow, "non_form_calls"))))),
    fhn-n("page_bytes", mv-int(page, "bytes")),
    fhn-s("landing", mv-grep-line(landed, "[landing]")),
    fhn-s("push", mv-grep-line(landed, "[push]")),
    json-node-pair("health", json-node-object(list(fhn-n("readings", len(readings)), fhn-n("unease", mv-unease(readings)), fhn-s("spool", mv-health-spool())))),
    fhn-s("census", fmrc-result-status(result)),
    fhn-n("dispatches", fmrc-delta-total(rows)),
    fhn-s("planes", mv-planes(mv-plane-names(), rows))))));
  }
 }
 mv-run();
}
