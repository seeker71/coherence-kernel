// movement-run.bml — a whole movement of the rent path in one native call.
//
// Inside one census window the body walks its own doors as child kernels:
// the native single call that floors itself (observe/form-cli-compare-run.bml),
// the native voice through the loopback oracle (observe/native-voice-run.bml),
// handed the compare door's composition so it is composed once per movement,
// the flow meter on the arriving mind's transcript (observe/flow-meter-run.bml),
// the page redrawn from the ledgers (observe/rent-ladder-page-run.bml), and
// the landing (observe/land-run.bml: restart, gates, commit, push). No
// provider is asked anywhere in it. The arriving mind makes one call and
// relays one line; every crossing is counted and printed.
//
// stdin: one JSON object, every field optional
//   {"movement":"<name>", "voice":1, "compare":1, "transcript":"<path or empty>",
//    "land":1, "restart":"", "paths":["extra", ...], "subject":"...", "body":"..."}
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class Movement {
  def mv-source() = "observe/movement-run.bml";
  def mv-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def mv-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def mv-flag(doc, key, fallback) = if json-object-has?(doc, key) then eq(json-int-value(json-object-get(doc, key)), 1) else fallback;
  def mv-values(doc, key) = if json-object-has?(doc, key) then oh-values(json-array-elements(json-object-get(doc, key))) else list();
  def mv-nodes(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)), mv-nodes(tail(xs)));
  def mv-first-line(text) { let at = str_find(text, "\n", 0); if lt(at, 0) then text else substring(text, 0, at); }
  def mv-doc(text) = if str_eq(trim(text), "") then json-node-object(list()) else parse-json("child-line", mv-first-line(text));
  def mv-row(doc) = if json-object-has?(doc, "row") then json-object-get(doc, "row") else json-node-object(list());
  def mv-grep-line(text, mark) { let at = str_find(text, mark, 0); if lt(at, 0) then "" else mv-first-line(substring(text, at, str_len(text))); }
  def mv-planes(planes, rows) = if nil?(planes) then "" else mc-cat(list(head(planes), "=", int_to_str(fmrc-delta-plane-total(rows, head(planes))), if nil?(tail(planes)) then "" else " ", mv-planes(tail(planes), rows)));
  def mv-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh");
  def mv-ledger-paths() = list("receipts/rent-ledger.jsonl", "receipts/parity-contest-ledger.jsonl", "receipts/flow-ledger.jsonl", "receipts/crossings-ledger.jsonl", "docs/rent-ladder.html");
  def mv-crossings() = "receipts/crossings-ledger.jsonl";
  def mv-digit?(ch) = and(eq(str_len(ch), 1), ge(str_find("0123456789", ch, 0), 0));
  def mv-digits(text, i, acc) = if and(lt(i, str_len(text)), mv-digit?(substring(text, i, add(i, 1)))) then mv-digits(text, add(i, 1), add(mul(acc, 10), str_find("0123456789", substring(text, i, add(i, 1)), 0))) else acc;
  def mv-int-after(text, key) { let at = str_find(text, key, 0); if lt(at, 0) then 0 else mv-digits(text, add(at, str_len(key)), 0); }
  // one row per movement, written after the census closes and before the page redraw and the landing, so the page draws it and the landing carries it; the page and landing child kernels come after the row and are not in it: the movement door's own planes and the voice and compare doors' dispatches, read from their printed census
  def mv-crossings-row(name, rows, voiceOut, compareOut) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", name),
   fhn-n("movement_dispatches", fmrc-delta-total(rows)),
   fhn-n("movement_stdio", fmrc-delta-plane-total(rows, "stdio")),
   fhn-n("movement_filesystem", fmrc-delta-plane-total(rows, "filesystem")),
   fhn-n("movement_local_process", fmrc-delta-plane-total(rows, "local-process")),
   fhn-n("movement_network", fmrc-delta-plane-total(rows, "network-address-unknown")),
   fhn-n("voice_dispatches", mv-int-after(voiceOut, "\"dispatches\":")),
   fhn-n("voice_network", mv-int-after(voiceOut, "network-address-unknown=")),
   fhn-n("compare_dispatches", mv-int-after(compareOut, "dispatches="))));
  // the composition is the compare door's text up to its floor line; composed once per movement, handed to the voice
  def mv-composition(compareOut) { let at = str_find(compareOut, "[floor of this output]", 0); if lt(at, 0) then "" else substring(compareOut, 0, at); }
  def mv-voice-request(name, composition) = if str_eq(composition, "") then json-node-object(list(fhn-s("movement", name))) else json-node-object(list(fhn-s("movement", name), fhn-s("composition", composition)));
  def mv-voice-out(name, on, composition) = if on then host-exec("./form-run ./fkwu observe/native-voice-run.bml 2>/dev/null | head -n 1", mc-cat(list(json-emit(mv-voice-request(name, composition)), "\n"))) else "";
  def mv-compare-out(on) = if on then host-exec("./fkwu observe/form-cli-compare-run.bml </dev/null 2>/dev/null", "") else "";
  def mv-flow(name, transcript) = if str_eq(transcript, "") then json-node-object(list()) else mv-row(mv-doc(host-exec("./fkwu observe/flow-meter-run.bml 2>/dev/null | head -n 1", mc-cat(list(transcript, "\n", name, "\n")))));
  def mv-page() = mv-doc(host-exec("./fkwu observe/rent-ladder-page-run.bml </dev/null 2>/dev/null | head -n 1", ""));
  def mv-land-request(request, name) = json-node-object(list(
   fhn-s("restart", mv-str(request, "restart")),
   fhn-s("witness", ""),
   fhn-a("paths", mv-nodes(append(mv-ledger-paths(), mv-values(request, "paths")))),
   fhn-s("subject", if str_eq(mv-str(request, "subject"), "") then mc-cat(list("Movement ", name, ": rows and the redrawn ladder")) else mv-str(request, "subject")),
   fhn-s("body", if str_eq(mv-str(request, "body"), "") then "Walked by the body in one call (observe/movement-run.bml): the native voice through the loopback oracle, the native single call, the flow meter, the page redrawn from the ledgers." else mv-str(request, "body"))));
  def mv-land(request, name, on) = if on then host-exec("./fkwu observe/land-run.bml 2>/dev/null", mc-cat(list(json-emit(mv-land-request(request, name)), "\n"))) else "";
  def mv-run() {
   let window = fmrc-open("movement", "voice compare flow page land", mv-source(), 1, 1);
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let request = if str_eq(line, "") then json-node-object(list()) else parse-json("movement-request", line);
   let name = if str_eq(mv-str(request, "movement"), "") then "movement" else mv-str(request, "movement");
   let compareOut = mv-compare-out(mv-flag(request, "compare", true));
   let compare = mv-grep-line(compareOut, "[floor of this output]");
   let voiceOut = mv-voice-out(name, mv-flag(request, "voice", true), mv-composition(compareOut));
   let voice = mv-row(mv-doc(voiceOut));
   let flow = mv-flow(name, mv-str(request, "transcript"));
   let result0 = fmrc-close(window, "observed", mv-source(), 2, 1);
   let rows0 = fmrc-result-deltas(result0);
   let crossed = fhn-append(mv-crossings(), str_concat(json-emit(mv-crossings-row(name, rows0, voiceOut, compareOut)), "\n"));
   let page = mv-page();
   let landed = mv-land(request, name, mv-flag(request, "land", true));
   let result = result0;
   let rows = rows0;
   print_str(json-emit-precise(json-node-object(list(
    fhn-s("movement", name),
    json-node-pair("voice", json-node-object(list(
     fhn-s("source", mv-str(voice, "source")),
     fhn-s("model", mv-str(voice, "oracle_model")),
     fhn-n("predicted", mv-int(voice, "oracle_tokens_predicted")),
     fhn-n("axes", mv-int(voice, "answer_axes")),
     fhn-n("receipts_cited", mv-int(voice, "answer_receipts_cited")),
     fhn-n("ms", mv-int(voice, "oracle_ms")),
     fhn-s("answer", mv-str(voice, "answer"))))),
    fhn-s("compare", compare),
    json-node-pair("flow", json-node-object(list(
     fhn-n("provider_calls", mv-int(flow, "provider_calls")),
     fhn-n("native_fkwu_calls", mv-int(flow, "native_fkwu_calls")),
     fhn-n("non_form_calls", mv-int(flow, "non_form_calls"))))),
    fhn-n("page_bytes", mv-int(page, "bytes")),
    fhn-s("landing", mv-grep-line(landed, "[landing]")),
    fhn-s("push", mv-grep-line(landed, "[push]")),
    fhn-s("census", fmrc-result-status(result)),
    fhn-n("dispatches", fmrc-delta-total(rows)),
    fhn-s("planes", mv-planes(mv-plane-names(), rows))))));
  }
 }
 mv-run();
}
