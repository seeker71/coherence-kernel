// Repeat and local retry execute on the same owned queue; BMF shares its boundary.
// preludes: form/form-stdlib/grammar-chars.fk form/form-stdlib/bml/native-events-darwin.bml
// preflight-exec: forbidden
section [form.bml] {
 class NativeRepeatWitness {
  def nrw-check(name,actual,expected) { print(list(name,actual,expected)); if ((Value) actual == expected) then 1 else form_error(name); }
  def nrw-cursor(event) = record_get(record_get(nve-event-watch(event),"repeat"),"cursor");
  def nrw-trace(context,event) {
   let at = nrw-cursor(event); let trace = record_get(context,"trace");
   record_set(trace,"text",str_concat(record_get(trace,"text"),str_concat(record_get(context,"name"),int_to_str(at))));
   if (at < record_get(context,"until")) then nve-repeat-next((at + 1)) else 0;
  }
  def nrw-fails(context,event) {
   let at = nrw-cursor(event); record_set(context,"effects",(record_get(context,"effects") + 1));
   if (at < record_get(context,"until")) then form_error("attempt needs its next local choice") else 0;
  }
  def nrw-repair(offered) {
   let args = oac-option-args(offered); let context = nth(args,1); let event = nth(args,2);
   record_set(context,"repairs",(record_get(context,"repairs") + 1));
   nve-repeat-again(offered,(nrw-cursor(event) + 1));
  }
  def nrw-decline(offered) {
   nve-repeat-again(offered,99); oac-node(intern_trivial_string("declined proposal retained as a finding"));
  }
  def nrw-unchanged(offered) = nve-repeat-again(offered,nrw-cursor(nth(oac-option-args(offered),2)));
  def nrw-informed(offered) {
   let args = oac-option-args(offered); let context = nth(args,1);
   record_set(context,"memory",len(oac-option-memory(offered)));
   record_set(context,"seen-cursor",nrw-cursor(nth(args,2))); nrw-repair(offered);
  }
  def nrw-resource-repair(offered) {
   let event = nth(oac-option-args(offered),2);
   if nil?(nve-wake-events(nve-event-watch(event))) then oac-zero() else nrw-repair(offered);
  }
  def nrw-resource-wait(offered) {
   let args = oac-option-args(offered); let owner = head(args); let event = nth(args,2);
   nve-follow(owner,nve-event-watch(event),list(nve-timer(owner,1)),list(nrw-resource-repair)); oac-zero();
  }
  def nrw-stall(context,event) = nve-repeat-next(nrw-cursor(event));
  def nrw-absent(context,event) = nothing();
  def nrw-count(context,event) = if (nrw-cursor(event) < 19999) then nve-repeat-next((nrw-cursor(event) + 1)) else 0;
  def nrw-release(owner,watch) = oac-one?(nve-hear(owner,watch,oh-response(nve-care-reading(watch),"release-event"),list()));
  def nrw-bmf() {
   let chars = list("char","x"); let text = mk-cstream("xx!");
   let matched = cm-match-multi-match(chars,1,nothing(),text,list(),list(),0);
   nrw-check("bmf-one-to-many",list(cmatch?(matched),cs-index(cmatch-rest(matched)),len(ccap-get(cmatch-caps(matched),"items"))),list(1,2,2));
   let missing = cm-match-multi-match(chars,1,4,mk-cstream("!"),list(),list(),0);
   nrw-check("bmf-minimum",list(cfail?(missing),nth(missing,1)),list(1,"multi-match minimum not reached"));
   let stalled = cm-match-multi-match(list("nil"),1,4,text,list(),list(),0);
   nrw-check("bmf-no-progress",list(cfail?(stalled),nth(stalled,1)),list(1,"multi-match made no progress"));
   let zero = cm-match-multi-match(list("fail"),0,0,text,list(),list(),0);
   nrw-check("zero-is-an-empty-allowance",list(cmatch?(zero),cs-index(cmatch-rest(zero))),list(1,0));
   let cut = cm-match-multi-match(list("sequence",list("cut"),list("fail")),0,4,text,list(),list(),0);
   nrw-check("bmf-cut-remains-a-cut",cfail-cut?(cut),1);
  }
  def nrw-run() {
   nrw-bmf();
   let owner = nve-open(); let trace = record_new(0,"text",""); let before = record_get(owner,"calls");
   let a = nve-repeat(owner,nrw-trace,record_new(0,"trace",trace,"name","A","until",2),0,list());
   let b = nve-repeat(owner,nrw-trace,record_new(0,"trace",trace,"name","B","until",1),0,list());
   nrw-check("repeat-passes-return-to-the-queue",nve-run(owner,10),5);
   nrw-check("peer-work-progresses-between-passes",record_get(trace,"text"),"A0B0A1B1A2");
   nrw-check("zero-is-a-completed-value",list(record_get(record_get(a,"repeat"),"done"),record_get(record_get(a,"repeat"),"value")),list(1,0));
   let absent = nve-repeat(owner,nrw-absent,0,0,list()); nve-run(owner,1);
   nrw-check("nothing-can-complete-without-retry",list(record_get(record_get(absent,"repeat"),"done"),nothing?(record_get(record_get(absent,"repeat"),"value"))),list(1,1));
   let context = record_new(0,"until",2,"effects",0,"repairs",0,"memory",0,"seen-cursor",-1);
   let repaired = nve-repeat(owner,nrw-fails,context,0,list(nrw-decline,nrw-unchanged,nrw-informed));
   nrw-check("failed-attempt-unwinds-before-retry",nve-run(owner,1),1);
   nrw-check("proposals-do-not-change-committed-cursor",list(record_get(context,"effects"),record_get(context,"seen-cursor"),record_get(record_get(repaired,"repeat"),"cursor"),record_get(repaired,"queued")),list(1,0,0,1));
   nrw-check("failure-and-declined-choice-are-retained",record_get(context,"memory"),2);
   nrw-check("same-owner-retries-finish",nve-run(owner,10),2);
   nrw-check("same-context-effects-and-repairs",list(record_get(context,"effects"),record_get(context,"repairs"),record_get(record_get(repaired,"repeat"),"attempts"),record_get(record_get(repaired,"repeat"),"passes")),list(3,2,3,1));
   nrw-check("later-failure-sees-earlier-findings",record_get(context,"memory"),4);
   let stall = nve-repeat(owner,nrw-stall,0,7,list(nrw-unchanged)); nve-run(owner,1);
   nrw-check("unchanged-checkpoint-rests-in-care",list(nve-run(owner,100),record_get(stall,"queued"),record_get(record_get(stall,"repeat"),"done")),list(0,0,0));
   nrw-check("held-stall-can-release",nrw-release(owner,stall),1);
   let cancelContext = record_new(0,"until",2,"effects",0,"repairs",0);
   let cancelled = nve-repeat(owner,nrw-fails,cancelContext,0,list(nrw-repair)); nve-run(owner,1); nrw-release(owner,cancelled);
   nrw-check("cancelled-retry-never-admits-its-cursor",list(nve-run(owner,10),record_get(record_get(cancelled,"repeat"),"cursor"),record_get(cancelContext,"effects")),list(0,0,1));
   let many = nve-repeat(owner,nrw-count,0,0,list());
   nrw-check("twenty-thousand-passes-without-recursive-reentry",nve-run(owner,20000),20000);
   nrw-check("repeat-count",record_get(record_get(many,"repeat"),"attempts"),20000);
   nrw-check("repeat-adds-no-event-image-crossings",record_get(owner,"calls") - before,0);
   let resourceContext = record_new(0,"until",1,"effects",0,"repairs",0);
   let waiting = nve-repeat(owner,nrw-fails,resourceContext,0,list(nrw-resource-wait)); nve-run(owner,1);
   nrw-check("resource-retry-waits-without-ready-spin",nve-run(owner,100),0); nve-turn(owner,1000);
   nrw-check("resource-event-resumes-original-repeat-context",list(record_get(resourceContext,"effects"),record_get(resourceContext,"repairs"),record_get(record_get(waiting,"repeat"),"done")),list(2,1,1));
   nrw-check("all-local-work-released",list(len(nve-pending(owner)),len(record_get(owner,"watches"))),list(0,0));
   nrw-check("event-owner-release",nve-close(owner),1); 1;
  }
 }
 nrw-run();
}
