; live-silence-inquiry.fk — silence is an invitation to look, not a verdict.
;
; A caller CAN sample the live carrier and feed the observations here before
; deciding whether to wait, stop, or pivot. The cell does not impose a timer.
; It distinguishes active work, visible progress, deliberate silence, a
; dropped failure signal, an explicit stop/offline signal, and unknown silence.
;
; preludes: form-stdlib/core.fk
; witnessed: 2026-07-23 -> recursive fk_walk classified active-without-output

(do
    ; (silence-observation cpu-active output-grew failure-signal silence-signal stop-signal context)
    (defn lsi-observation (cpu-active output-grew failure-signal silence-signal stop-signal context)
        (list "silence-observation" cpu-active output-grew failure-signal silence-signal stop-signal context))
    (defn lsi-cpu-active (o) (nth o 1))
    (defn lsi-output-grew (o) (nth o 2))
    (defn lsi-failure-signal (o) (nth o 3))
    (defn lsi-silence-signal (o) (nth o 4))
    (defn lsi-stop-signal (o) (nth o 5))
    (defn lsi-context (o) (nth o 6))

    ; (silence-reading state next-inquiry evidence)
    (defn lsi-reading (state next-inquiry evidence)
        (list "silence-reading" state next-inquiry evidence))
    (defn lsi-state (r) (nth r 1))
    (defn lsi-next (r) (nth r 2))
    (defn lsi-evidence (r) (nth r 3))

    (defn lsi-inquire (o)
        (if (eq (lsi-stop-signal o) 1)
            (lsi-reading "stop-or-offline" "preserve-frame-and-release-carrier" o)
        (if (eq (lsi-failure-signal o) 1)
            (lsi-reading "dropped-failure" "surface-failure-and-pivot" o)
        (if (eq (lsi-silence-signal o) 1)
            (lsi-reading "deliberate-silence" "honor-silence-and-keep-channel-observable" o)
        (if (eq (lsi-output-grew o) 1)
            (lsi-reading "progress-visible" "continue-and-observe-next-frame" o)
        (if (eq (lsi-cpu-active o) 1)
            (lsi-reading "active-without-output" "inspect-stack-and-progress-emission" o)
            (lsi-reading "unknown-silence" "inspect-carrier-dependencies-and-alternate-node" o)))))))
)
