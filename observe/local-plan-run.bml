  def lpr-declined?(answer) = (!nothing?(answer)) && fcgp-present?(answer, "status") && ((String) fcgp-str(answer, "status") == "declined");
  def lpr-walks(req, opts, voices, queue) {
   let answer = lpr-walk(req, opts, voices, queue);
   let more = (lpr-declined?(answer) && ((Comparable) lpr-int(opts, "next", 0) == 1) && (!lpr-closed?(fcgp-num(opts, "until_ms"), lpr-floor(opts)))) ? lpr-pick(opts, queue) : nothing();
