  }
  def lpr-steer-req() = parse-json("live-steer", "{\"id\":\"live-steer\",\"title\":\"three copies\",\"needs\":\"lpdf-rows answers three copies\",\"files\":[\"form/form-stdlib/tests/fixtures/local-plan-door-flow.bml\"],\"evidence\":\"the fixture returns two copies\"}");
  def lpr-steer-earned() = map(r => ["", "", "", "", "", r, 0, 0], [lpr-steer-row("attempt", "a1", "o1"), lpr-steer-row("lens", "a2", "o2"), lpr-steer-row("lens", "a3", "o3"), lpr-steer-row("voice", "a4", "o4"), lpr-steer-row("decode", "a5", "o5"), lpr-steer-row("context", "a6", "o6"), lpr-steer-row("local-guide", "a7", "o7"), lpr-steer-row("lens", "a8", "o2"), lpr-steer-row("lens", "a9", "o3"), lpr-steer-row("local-guide", "a10", "o4"), lpr-steer-row("lens", "a11", "o5")]);
  def lpr-steer-row(rung, a, o) = json-node-object([fhn-s("gap", "g"), fhn-s("rung", rung), fhn-s("approach_digest", a), fhn-s("outcome_digest", o), fhn-n("local_generated_ids", 1), fhn-n("local_injected_ids", 0), fhn-n("band_green", 0)]);
  def lpr-steer-question(req) = mc-cat([flp-guide-question(), "\n\nThe request:\n", flp-request-text(req), "\n", flp-files-block(req), "The writable path is form/form-stdlib/tests/fixtures/local-plan-door-flow.bml. Today's fixture still returns two copies and stays there. A verified scratch candidate already returns three copies. It holds lpdf-rows(1) = [1, 1, 1], lpdf-rows(\"a\") = [\"a\", \"a\", \"a\"], and lpdf-rows(0) = [0, 0, 0]. Two streams on one residence then answered 2 and 5, and the affine kernel committed 13 and 22. Keep the three-copy reference and those three cases, and add one case whose argument is neither 1 nor \"a\" nor 0.\n"]);
  def lpr-steer-safe?(text) {
