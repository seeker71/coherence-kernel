   }
  }
  def lpr-kernel-two() {
   if (lpr-device-held?() || (((String) lpr-steer-disk() == "tight") || ((String) lpr-steer-memory(flp-kernel-need()) == "tight"))) then { print_str(mc-cat(["[local-plan:kernel] not-run lease=", lpr-steer-lease(), " disk=", lpr-steer-disk(), " memory=", lpr-steer-memory(flp-kernel-need()), " device=", lpr-device-held?() ? "held" : "free"])); ["", ""]; } else {
    let pair = gpu-lease-turn("affine pair", () => flp-metal-two(4, 19));
    let seated = flp-seat-two(4, 19);
    let agree = ((String) pair[0] == seated[0]) && ((String) pair[1] == seated[1]) ? "1" : "0";
    print_str(mc-cat(["[local-plan:kernel] pair input=4,19 value=", pair[0], ",", pair[1], " seated=", seated[0], ",", seated[1], " agree=", agree, " handles=", seated[2], " model-executed=0"]));
    pair;
   }
  }
  def lpr-kernel-text(text) {
   let n = flp-first-int(text);
   if (n < 0) then { print_str("[local-plan:kernel] not-run no-integer"); ""; } else lpr-kernel-once(n);
  }
  // One integer is dispatched as the kernel token, and kept when the GPU writes the committed value.
  // Two integers are one launch, kept when both threads match the pair.
  def lpr-kernel-committed(text) {
   let n = flp-first-int(text);
   if (n < 0) then "" else {
    let kernel = n * 3 + 7;
    flp-keep-metal(lpr-kernel-once(kernel), (kernel * 3 + 7).str());
   }
  }
  def lpr-kernel-pair-of(text) {
   let a = flp-first-int(text);
   let b = flp-second-int(text);
   if ((a < 0) || (b < 0)) then "" else if (lpr-device-held?() || (((String) lpr-steer-disk() == "tight") || ((String) lpr-steer-memory(flp-kernel-need()) == "tight"))) then "" else {
    let pair = gpu-lease-turn("affine pair", () => flp-metal-two(a, b));
    flp-keep-metal(mc-cat([pair[0], ",", pair[1]]), flp-pair-token(text));
   }
  }
  def lpr-steer-metal(text) {
   if ((String) text == "") then "" else if (flp-second-int(text) >= 0) then lpr-kernel-pair-of(text) else lpr-kernel-committed(text);
  }
  // The standing witness keeps its name. A later landing of the same local plan takes a new band and does not rewrite it.
  def lpr-rename-plan(text, id) {
   let from = "\"id\": \"live-steer\"";
   let at = str_find(text, from, 0);
   at < 0 ? text : mc-cat([substring(text, 0, at), "\"id\": \"", id, "\"", substring(text, at + len(from), len(text))]);
  }
  def lpr-fresh-plan(text) = lpr-rename-plan(text, "live-steer-metal");
  // The local plan already on disk is steered again with the GPU pair of its first two integers. No model is opened.
  def lpr-metal-steer() {
   let text = fhn-read(flp-dir() ++ "/live-steer-1794221128012.reply.txt");
   if nothing?(text) || ((String) trim(text) == "") then { print_str("[local-plan:steer] metal not-run no-reply"); nothing(); } else {
    let channel = flp-plan-channel(lpr-fresh-plan(text));
    let metal = lpr-steer-metal(channel);
    print_str(mc-cat(["[local-plan:steer] metal=", metal, " expected=", flp-pair-token(channel)]));
    if ((String) metal == "") then nothing() else {
     let root = flp-dir() ++ "/live-steer-metal";
     let steered = flp-with-steer(flp-ctx((packet, name, n, lens) => ["answered", "not a plan", 0, 0], ["qwen38-q8"], 1, root ++ "/queue.jsonl", "", root ++ "/scratch", root ++ "/ledger.jsonl", 120000), (question, id) => [channel, 2, 0]);
     let ctx = flp-with-metal(steered, metal);
     let walked = flp-after-decline(lpr-steer-req-id("live-steer-metal"), ctx, lpr-steer-earned());
     print_str(mc-cat(["[local-plan:steer] verify ", walked[0]]));
     walked;
    }
    }
  }
  // The reply is already on disk. A new band name lands it. The model stays closed.
  def lpr-land-reply(id) {
   let text = fhn-read(mc-cat([flp-dir(), "/", id, ".reply.txt"]));
   if (nothing?(text) || ((String) trim(text) == "")) then { print_str(mc-cat(["[local-plan:steer] land not-run no-reply id=", id])); nothing(); } else {
    let channel = flp-plan-channel(lpr-rename-plan(text, id));
    if (!lpr-steer-safe?(channel)) then { print_str(mc-cat(["[local-plan:steer] land not-run unsafe id=", id])); nothing(); } else {
     let metal = lpr-steer-metal(channel);
     print_str(mc-cat(["[local-plan:steer] land metal=", metal, " expected=", flp-kept-token(channel), " device=", lpr-device-held?() ? "held" : "free", " id=", id]));
     let walked = lpr-steer-verify(["reply-on-disk"], channel, 0, 0, metal, id);
     let formed = mc-cat([flp-dir(), "/", id, "/scratch/form/form-stdlib/tests/fixtures/local-plan-door-flow.bml"]);
     let ran = flp-exists?(formed) ? flp-band-run(formed, 120000) : [nothing(), 0, ""];
     print_str(mc-cat(["[local-plan:formed] reading=", flp-show(ran[0]), " path=", formed]));
     walked;
    }
   }
  }
  def lpr-run() {
   let input = cell_input();
   let line = fat-wire-object?(input) ? "" : trim(stdin-text());
   let opts = fat-wire-object?(input) ? input : fcgp-object-line?(line) ? parse-json("local-plan-options", line) : json-node-object([]);
   let window = ftg-window-until();
   let windowed = ftg-window-at(fcgp-num(opts, "until_ms"));
   defer ftg-window-at(window);
   let queue = lpr-queue(opts);
   let req = lpr-pick(opts, queue);
   let queued = if nothing?(req) then nothing() else flp-request-row(queue, flp-req-id(req));
   let voices = lpr-voices(opts);
   if fcgp-present?(opts, "ask-gate") then lpr-ask-line(opts) else if fcgp-present?(opts, "two-streams") then lpr-two-streams(opts) else if fcgp-present?(opts, "streams") then lpr-stream-line(opts) else if fcgp-present?(opts, "peers") then lpr-peer-line() else if fcgp-present?(opts, "memory") then lpr-memory-line() else if fcgp-present?(opts, "seat") then lpr-seat-line() else if fcgp-present?(opts, "land") then lpr-land-reply(fcgp-str(opts, "land")) else if fcgp-present?(opts, "metal-steer") then lpr-metal-steer() else if fcgp-present?(opts, "kernel-two") then lpr-kernel-two() else if fcgp-present?(opts, "kernel-text") then lpr-kernel-text(fcgp-str(opts, "kernel-text")) else if fcgp-present?(opts, "kernel") then lpr-kernel-once(lpr-int(opts, "kernel", 19)) else if ((Comparable) lpr-int(opts, "steer", 0) == 1) then lpr-steer-live(opts) else if nothing?(req) then { print_str(mc-cat(["[local-plan] no request to plan in ", lpr-source(opts), ": none stands open, or each reads parked until what it stands on moves"])); nothing(); } else if fcgp-present?(opts,"reply") then lpr-recheck(req,opts,queue) else if (!nothing?(queued)) then { print_str(mc-cat(["[local-plan] request ", flp-req-id(req), " is already queued as ", flp-text(queued, "id"), " in ", queue, "; a request is planned once, and no model opens"])); queued; } else if nil?(voices) then { print_str("[local-plan] no plan voice has its weights on disk"); nothing(); } else if ((Comparable) lpr-int(opts, "dry", 0) == 1) then { lpr-dry(req, voices, queue); nothing(); } else lpr-walks(req, opts, voices, queue);
  }
  def lpr-recheck(req,opts,queue) {
   let ctx=flp-ctx(nothing(),[],0,queue,"",flp-dir() + "/scratch",flp-dir() + "/ledger.jsonl",lpr-int(opts,"deadline_ms",flp-deadline-ms()));
   let result=flp-recheck(req,ctx,fcgp-str(opts,"reply"));
   let said=print_str(json-emit(json-node-object([fhn-s("request",flp-req-id(req)),fhn-s("status",result[0]),fhn-s("reason",result[2])])));
   result[0]=="queued" ? result[1][1] : nothing();
  }
  def lpr-dry(req, voices, queue) {
   let said = print_str(mc-cat(["[local-plan:dry] request ", flp-req-id(req), " voices ", flp-join(voices, ","), "; the first packet:"]));
   print_str(flp-packet(req, flp-lenses()[0], "", "", queue));
  }
 }
 lpr-run();
}
