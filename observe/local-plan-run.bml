  }
  // The earned question joins the resident admission on the chosen voice. A matching
  // adapter is worn. A mismatched one is not opened. No provider call is made.
  def lpr-local-steer(voices, question, id) {
   let model = lpr-steer-model(voices);
   if (((String) flp-steer-route(voices, flp-gpu-holders()) == "none") || ((Comparable) lpr-ask-open?(model) != 1)) then nothing() else {
    let worn = lpr-steer-worn(model);
    if ((String) worn[0] == "mismatch") then nothing() else {
     let answer = lpr-ask-anywhere(question, lpr-steer-request(model, id, worn), "planner-steer");
     (String) answer[0] == "answered" && len(trim(answer[1])) > 0 ? [answer[1], answer[3], answer[2]] : nothing();
    }
   }
  }
  // {"lenses":1} asks the guide of three parallel lenses of the local model first (local-focus-lenses.bml: one prefix, three lenses, one weight
  // pass a step, each read by the rules below, the surest valid one written where this guide reads it). A standing resident server is asked one request a lens;
  // with none standing it opens the model and closes it before the voice below opens it. A request whose focus the lenses wrote is then guided and the single ask is skipped; no valid lens leaves the ask as it was.
  def lpr-lens-focus(req) = print_str("[local-plan:lenses] " ++ lfl-run(req, 48) ++ "\n");
  def lpr-focus-guide(req,opts) {
   let named=any?(name=>flp-mentioned?(flp-text(req,"needs"),name,0),flp-source-names(flp-req-files(req)));
   let lensed=(lpr-int(opts,"lenses",0) == 1 && !named && nil?(flp-guided-focus(req))) ? lpr-lens-focus(req) : 0;
   named || !nil?(flp-guided-focus(req)) || lpr-closed?(fcgp-num(opts,"until_ms"),lpr-floor-of(mr-chain-names("triage")[0])) || ((Comparable) lpr-ask-open?(mr-chain-names("triage")[0]) != 1) ? 0 : {
    let model=mr-chain-names("triage")[0];
    let prompt=flp-focus-prompt(req);
    let answer=lpr-ask-anywhere(prompt,json-node-object([fhn-s("model",model),fhn-n("max_reply_tokens",1024),fhn-s("enquiry",lpr-enquiry(flp-req-id(req),-1)),fhn-s("enquiry_kind","prose")]),"planner-guide");
    let made=flp-mkdirs(flp-dir()+"/focus");
    let kept=write_file_text(flp-focus-path(req),json-emit(json-node-object([fhn-s("prompt",prompt),fhn-s("model",model),fhn-s("status",answer[0]),fhn-s("text",answer[1]),fhn-n("prompt_ids",answer[2]),fhn-n("generated_ids",answer[3]),fhn-n("complete",answer[5]),fhn-n("released",answer[6]),fhn-s("reason",answer[7]),fhn-s("raw",answer[8])])));
    print_str("[local-plan:guide] " + json-emit(json-node-object([fhn-s("request",flp-req-id(req)),fhn-s("status",answer[0]),fhn-n("prompt_ids",answer[2]),fhn-n("generated_ids",answer[3]),fhn-s("reason",answer[7]),fhn-s("evidence",flp-focus-path(req))])));
   };
  }
  def lpr-walk(req, opts, voices, queue) {
   if ((Comparable) lpr-ask-open?(lpr-steer-model(voices)) != 1) then { print_str(mc-cat(["[local-plan] not-opened device=", lpr-device-held?() ? "held" : "free", " disk=", lpr-steer-disk(), " memory=", lpr-steer-memory(flp-model-need()), " model=", lpr-steer-model(voices)])); nothing(); } else {
   let walked = now_unix_ms();
   let made = flp-mkdirs(flp-dir());
   let attempts = lpr-int(opts, "attempts", flp-attempts());
   let memory = lpr-memory(req, opts);
   let parked = flp-parked?(req, memory, voices) || ((!nil?(memory)) && flp-park-marked?(req, flp-dir() ++ "/ledger.jsonl"));
   let focused = parked ? 0 : lpr-focus-guide(req,opts);
   let spent = if ((Comparable) lpr-int(opts, "fresh", 0) == 1) then 0 else lpr-spent(lpr-tried(attempts), flp-req-id(req));
   let left = json-object-has?(opts,"attempts") ? lpr-left(attempts, spent) : nothing();
    let base = flp-ctx(lpr-voice(flp-dir(), flp-safe-id(req), flp-req-id(req), lpr-int(opts, "context", nothing()), lpr-int(opts, "max_reply_tokens", 3072), fcgp-num(opts, "reply_budget"), fcgp-num(opts, "until_ms")), voices, left, queue, "", flp-dir() ++ "/scratch", flp-dir() ++ "/ledger.jsonl", lpr-int(opts, "deadline_ms", flp-deadline-ms()));
     let cared=flp-with-admission-care(flp-with-reference-care(base,(request,context,said,refusal)=>lpr-closed?(fcgp-num(opts,"until_ms"),lpr-floor(opts)) ? nothing() : lrpr-repair(request,context,said,refusal,opts)),lpr-release-said);
     let steered=flp-with-steer(cared,(question,id)=>lpr-local-steer(voices,question,id));
     let ctx=(String) lpr-steer-lease() == "held-elsewhere" ? flp-with-lease(steered, "held-elsewhere") : steered;
   let resumed = if ((spent == 0) && nil?(memory)) then 0 else print_str(mc-cat(["[local-plan] resuming ", flp-req-id(req), ": ", spent.str(), " option(s) spent, ", len(memory).str(), " refused row(s) retained; ", nothing?(left) ? "native choices continue" : left.str()+" caller option(s) left"]));
   let care=parked ? nothing() : lrpr-resume(req,ctx,memory);
   let r=nothing?(care) ? flp-walk-from(req,ctx,memory) : care[0]==1 ? flp-ended(["queued",care[1]],memory) : care[0]==3 ? flp-ended(["moot",care[1]],memory) : flp-walk-from(req,ctx,append(memory,[care[1]]));
   let covered = lpr-covered(walked);
   let mooted = if ((String) r[0] == "moot") then print_str(flp-record-moot(req, r, lpr-source(opts))) else 0;
   let result=flp-result(req,r);
