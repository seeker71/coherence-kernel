  }
  def lpr-steer-req-id(id) = parse-json(id, mc-cat(["{\"id\":\"", id, "\",\"title\":\"three copies\",\"needs\":\"lpdf-rows answers three copies\",\"files\":[\"form/form-stdlib/tests/fixtures/local-plan-door-flow.bml\"],\"evidence\":\"the fixture returns two copies\"}"]));
  def lpr-steer-verify(voices, text, generated, prompt, metal, id) {
