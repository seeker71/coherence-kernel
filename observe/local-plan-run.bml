   let free = lpr-free-bytes(room);
   print_str(mc-cat(["[local-plan:memory] available=", available.str(), " free=", free.str(), " kernel=", flp-steer-memory(free, flp-kernel-need()), " model=", flp-steer-memory(free, flp-model-need())]));
