// local-plan-run.bml — the local planner: one request becomes a band-first gap, written by a local voice and verified
// by Form before it is queued (form-stdlib/bml/form-cli-local-plan.bml). The voice
// owns admission and release from its actual weights and KV geometry.
//
// stdin, one JSON line:
//   a request itself: {"id","title","problem","needs","where","files","evidence"}; or
//   {"request":"<id>"} or {"next":1}: a request read from learn/local-requests.jsonl, the file the feeder door
//   (observe/findings-to-requests-run.bml) writes; {"requests":"<path>"} reads another file. next takes the first
//   pending request that no queue row names, whose walks have not spent its attempts (an option is spent once its
//   voice opens; a walk that ended held resumes with the options left) and no review refuted, one Form source
//   under form/, observe/, gate/ or learn/ first, then one file of any kind, then any; when none is pending, the
//   first moved request by the same three tiers (the code its where cites changed since its review: its fixborn).
//   A statement, context, answered, handed, moot or closed row is never taken. A request whose ways are spent on what it
//   stands on reads parked and is passed over (flp-parked?): its last ledger row's source_digest keys it, and one option
//   reads it again when that digest moves. A next walk that declined goes on to the next open request inside the window.
// A walk whose option shows a moved request moot (the band the voice wrote reads its full on today's files and below
// it under both of rung 3's stubs, and the plan names the definition the request's fixborn stands in) ends there with
// status moot, and the door writes that witness on the request's row in the requests file: the row reads moot while
// its fixborn stands, and no later walk takes it. A band over any other definition, or a request with no fixborn,
// ends gap-closed and the row stays as it was.
// A request the queue already carries (a row whose "request" is its id) is planned once: the door says which gap
// carries it and opens no model. {"queue":"<path>"} reads and lands in another queue (default
// learn/native-turn-queue.jsonl).
// Beside either, optional: "attempts" (explicit caller allowance; absent continues locally), "voices" (else the registry's plan chain, each voice whose weights are on
// disk), "context" (initial allocation; otherwise prompt plus initial reserve), "max_reply_tokens" (3072, generation-progress signal), "reply_budget" (absent: the generation is open and ends where its envelope closes; named, the ids one reply may spend), "deadline_ms" (600000, one band run), "until_ms" (the
// caller's window on the host's monotonic clock: no voice opens once the time left cannot hold the median option
// the ledger measured, and the walk ends held), "dry":1 prints the first packet the voice would read and opens no
// model. A request an earlier walk left refused resumes from the options its ledger rows keep (their findings and
// replies), with the attempts it has left; "fresh":1 starts it clean.
// A reference refusal offers retained references, then the zero-token native choice. A refusal that read its cases goes
// back to the voice as focused feedback (flp-focus-packet); one with no case reading takes native reference-only coding
// before another whole-plan generation. Repair retains the proposal's local voice;
// repair_model explicitly selects another. repair_turns (8) is each entry's allowance of coding turns. Source and witness
// fingerprints bind its checkpoint; only released, reverified candidates land.
// Installed voices meet actual native admission at execution. A refusal returns
// its evidence to the local choice; the caller's window still bounds new options.
// The voice speaks in this process (form-stdlib/bml/form-cli-native-voice.bml: registry weights on this Mac), one
// reply at a time, each ask naming its enquiry as a plan whose coverage row waits for the verdict (receipts/query-coverage-ledger.jsonl
// holds one kind "plan" row per option, source local-plan, answered only when verified), and the band runs begin only after its session is released. No prompt leaves the machine by
// construction: the voice is in-process. A declined walk that earned a guide asks that same local voice
// one question through admission, sharing a resident session's mapped weights; the packet stays a file, and no door here sends it. Each packet and reply is kept under .hearth/local-plans, each option whose voice opened is marked in
// .hearth/local-plans/began.jsonl, each reply is owned the moment it is heard by a mark in .hearth/local-plans/heard.jsonl,
// each option's row lands in .hearth/local-plans/ledger.jsonl, and a verified plan lands its band at its path and one row at the end of the
// queue, where the night's walk takes it. A physical run: it needs the local GPU and a quiet machine.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-local-plan.bml;
import form-stdlib/bml/form-cli-native-voice.bml;
import form-stdlib/model-registry.bml;
import form-stdlib/gpu-lease.bml;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/bml/host-walk.bml;
import form-stdlib/bml/formbin-codec.bml;
import form-stdlib/bml/q38-multi.bml;
import form-stdlib/bml/q38-lenses.bml;
import form-stdlib/bml/serve-client.bml;
import form-stdlib/bml/local-focus-lenses.bml;
import ./local-plan-repair-run.bml;
section [form.bml] {
 class LocalPlanRun {
  def lpr-int(doc, key, d) = fcgp-num(doc, key) ?? d;
  def lpr-request?(doc) = fcgp-present?(doc, "title") || (fcgp-present?(doc, "problem") || fcgp-present?(doc, "needs"));
  def lpr-source(opts) = if fcgp-present?(opts, "requests") then fcgp-str(opts, "requests") else flp-requests();
  def lpr-queue(opts) = if fcgp-present?(opts, "queue") then fcgp-str(opts, "queue") else flp-queue();
  // next: a pending request no queue row names, whose options are not spent and no review refuted; one Form source
  // first (a band measures Form definitions), then one file of any kind, then any. A moved request (the code its
  // where cites changed since the tree its review read: findings-requests.bml) comes after every pending one, by the
  // same three tiers; a statement, a context row, a moot or a closed one is never taken
  def lpr-moved?(r) = fcgp-present?(r, "status") && ((String) fcgp-str(r, "status") == "moved");
  def lpr-pending?(r) = (!fcgp-present?(r, "status")) || (((String) fcgp-str(r, "status") == "pending") || lpr-moved?(r));
  def lpr-refuted?(r) = (String) fcgp-str(r, "verdict") == "refuted";
  // An option is spent once its voice opens: the door marks it in .hearth/local-plans/began.jsonl before the voice
  // speaks, so an option that ended the planner before its ledger row was written counts too. tried: [the request of
  // each began mark, the request of each refused ledger row (the walks before the marks), the walk's attempts]. A
  // request is tried once its spent options reach attempts; a walk that ended held (the GPU stayed another door's,
  // or the window could not hold an option) spent fewer, so next takes it again with the options it has left
  def lpr-began-path() = flp-dir() ++ "/began.jsonl";
  def lpr-requests-in(path, keep) = map(r => flp-text(r, "request"), filter(keep, flp-queue-rows(path)));
  def lpr-tried(attempts) = [lpr-requests-in(lpr-began-path(), r => true), lpr-requests-in(flp-dir() ++ "/ledger.jsonl", r => ((String) flp-text(r, "verdict") == "refused")), attempts];
  def lpr-count(xs, x) = foldl((n, y) => if ((String) y == x) then (n + 1) else n, 0, xs);
  def lpr-most(a, b) = if (a > b) then a else b;
  def lpr-spent(tried, id) = lpr-most(lpr-count(tried[0], id), lpr-count(tried[1], id));
  def lpr-spent?(tried, id) = !nothing?(tried[2]) && lpr-spent(tried, id) >= tried[2];
  // a pick also hands the ledger's rows (tried[3]) and the voices (tried[4]): a request whose ways are spent on what it
  // stands on is passed over, and {"fresh":1} hands no rows, so nothing reads parked
  def lpr-parked?(r, tried) = (len(tried) > 4) && (!nil?(tried[3])) && (flp-park-marked?(r, flp-dir() ++ "/ledger.jsonl") || flp-parked?(r, flp-memory-of(tried[3], flp-req-id(r), p => lpr-read(p)), tried[4]));
  // a walk takes the options its request has left; a request asked for by id whose options were spent takes
  // attempts afresh
  def lpr-left(attempts, spent) = nothing?(attempts) ? nothing() : if (spent < attempts) then (attempts - spent) else attempts;
  def lpr-open?(r, queue, tried) = ((Comparable) len(flp-req-id(r)) > 0) && (lpr-pending?(r) && ((!lpr-refuted?(r)) && (nothing?(flp-request-row(queue, flp-req-id(r))) && ((!lpr-spent?(tried, flp-req-id(r))) && (!lpr-parked?(r, tried))))));
  def lpr-one?(r) = (Comparable) len(flp-req-files(r)) == 1;
  def lpr-form-source?(r) = lpr-one?(r) && (flp-under-roots?(flp-req-files(r)[0]) && ((flp-ends?(flp-req-files(r)[0], ".fk") || flp-ends?(flp-req-files(r)[0], ".bml")) && (!flp-band-like?(flp-req-files(r)[0]))));
  def lpr-tier?(r, queue, tried, moved) = lpr-open?(r, queue, tried) && (if moved then lpr-moved?(r) else (!lpr-moved?(r)));
  def lpr-tier(rows, queue, tried, moved) = flp-first(rows, r => (lpr-tier?(r, queue, tried, moved) && lpr-form-source?(r))) ?? (flp-first(rows, r => (lpr-tier?(r, queue, tried, moved) && lpr-one?(r))) ?? flp-first(rows, r => lpr-tier?(r, queue, tried, moved)));
  def lpr-next(rows, queue, tried) = lpr-tier(rows, queue, tried, false) ?? lpr-tier(rows, queue, tried, true);
  def lpr-pick(opts, queue) {
   let rows = flp-queue-rows(lpr-source(opts));
   let want = fcgp-str(opts, "request");
   if lpr-request?(opts) then opts else if ((Comparable) len(want) > 0) then flp-first(rows, r => ((String) flp-req-id(r) == want)) else lpr-next(rows, queue, append(lpr-tried(fcgp-present?(opts,"attempts") ? lpr-int(opts,"attempts",0) : nothing()), [((Comparable) lpr-int(opts, "fresh", 0) == 1) ? [] : flp-queue-rows(flp-dir() ++ "/ledger.jsonl"), lpr-voices(opts)]));
  }
  def lpr-voices(opts) {
   let offered = if fcgp-present?(opts, "voices") then flp-strs(opts, "voices") else filter(n => ((Comparable) mr-file?(mr-path(mr-find(n))) == 1), mr-chain-names("plan"));
   // a standing server answers every ask with the weights it holds: the options name that voice, not another the file cannot give
   let held = filter(n => mr-path(mr-find(n)) == qlz-file(), offered);
   lpr-served?() && !nil?(held) ? held : offered;
  }
  // The voice opens while the caller's window ("until_ms" on the host's monotonic
  // clock; nothing when no window was given) still holds an option: the median real option of that voice on the
  // planner's ledger (hw-option-floor-of over .hearth/local-plans/ledger.jsonl; every voice's while it has none; half an
  // hour before any is measured). The walk's own checks read the first voice it offers. A reply still decoding at the
  // window's end ends there (ftg-window-at, set by lpr-run) and its row's voice_status reads window-end. The packet is
  // kept before it is read and the reply after, so a review reads every step; unavailable memory or a window that
  // cannot hold an option answers "held", and the walk ends with no row
  def lpr-floor-of(voice) = hw-option-floor-at(flp-dir() ++ "/ledger.jsonl", voice);
  def lpr-floor(opts) = lpr-floor-of(nil?(lpr-voices(opts)) ? "" : lpr-voices(opts)[0]);
  def lpr-latest(until, floor) = until - floor[0];
  def lpr-closed?(until, floor) = (!nothing?(until)) && (host_monotonic_ms() > lpr-latest(until, floor));
  def lpr-window-line(until, floor) = mc-cat(["[local-plan:window] ", hw-minutes(hw-left(until, host_monotonic_ms())), " left cannot hold an option of ", hw-minutes(floor[0]), " (", floor[1], "); no model opens"]);
  def lpr-began(rid, name, n) = fhn-append(lpr-began-path(), json-emit(json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("request", rid), fhn-n("option", n), fhn-s("voice", name)])) ++ "\n");
  // a voice whose file the registry holds is leased by its path (the weights are one promise for every process that
  // maps the file); a voice the registry does not hold is asked as the walk asks a turn
  def lpr-ask(dir, id, rid, packet, name, n, lens, context, limit, budget, until) {
   // The window must hold the measured option floor and the measured reading of this packet (flp-read-ms): no byte limit stands on the packet.
   let base = lpr-floor-of(name);
   let floor = [base[0] + flp-read-ms(packet, flp-rates()), base[1] ++ "; reading this packet at the lately measured prefill rate"];
   let open = !lpr-closed?(until, floor);
   // The voice admits its actual weights and KV geometry. A second guessed
   // scratch lease can refuse a model whose real allocation fits.
   let marked = open ? lpr-began(rid, name, n) : 0;
   open ? lpr-spoken(dir, id, rid, packet, name, n, lens, context, limit, budget) : ["held", lpr-window-line(until, floor), 0, 0, ""];
  }
  // The reply is owned the moment it is heard: one mark in .hearth/local-plans/heard.jsonl (the request, the option, the
  // voice and its lens, the voice's status, its ids and the reply's path), written before any band runs. An option's
  // ledger row lands after its verification; a planner that ended between the reply and that row (2026-10-28: the
  // verification never returned) left a reply no row owned, and the recheck ({"reply":...}) refused it: "No retained
  // local-model result owns this request and both proposal parts." The mark is that ownership (flp-reply-owner), so no
  // local generation is lost to the end of the process that heard it.
  def lpr-heard-path() = flp-heard-path();
  // Each ask names its own enquiry (the request to fcnv-ask carries "enquiry") and coverage "after-verdict": a plan is
  // answered once it verifies, so the voice door lands no coverage row for the ask, and lpr-covered lands one per option
  // row this walk added, kind "plan", source local-plan, answered 1 only for verdict "verified". The focus guide (option
  // -1, the triage voice) names a focus, never a plan: its ask is kind "prose" at the voice door.
  def lpr-enquiry(rid, n) = mc-cat(["plan request ", rid, " option ", n.str(), ": the steps and the witness of one gap"]);
  // one coverage row per option the voice spoke, landed after the verdict (local-run.bml qc-plan-covered-at): the
  // options of a walk the window ended land with the next walk
  def lpr-plan-row(r) = [fcgp-str(r, "request"), fcgp-num(r, "option") ?? 0, fcgp-str(r, "rung"), fcgp-str(r, "verdict"), fcgp-str(r, "voice"), fcgp-num(r, "at_unix_ms") ?? 0, fcgp-num(r, "wall_ms") ?? 0];
  def lpr-covered(walked) = qc-plan-covered-at(map(lpr-plan-row, fcgp-rows(flp-dir() ++ "/ledger.jsonl")), qc-ledger(), walked);
  def lpr-heard(rid, name, n, lens, v, reply) = fhn-append(lpr-heard-path(), json-emit(json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("request", rid), fhn-n("option", n), fhn-s("voice", name), fhn-s("lens", lens), fhn-s("voice_status", v[0]), fhn-n("local_injected_ids", v[2]), fhn-n("local_generated_ids", v[3]), fhn-s("reply", reply),json-node-pair("admission",lpr-admission(v))])) ++ "\n");
  // The reply is asked inside its envelope and within its budget (flp-voice-request, form-cli-local-plan.bml); a reply
  // the envelope ended inside a block carries that refusal into its row.
   def lpr-admission(v) = json-node-object([fhn-s("status",v[0]),fhn-s("model",v[4]),fhn-n("complete",v[5]),fhn-n("released",v[6]),fhn-s("reason",v[7]),fhn-s("ownership",fcnv-ownership(v)),fhn-s("continuation",fcnv-continuation(v))]);
   def lpr-release-said(req,row,n) {
    let key=fcgp-str(flp-row-admission(row),"continuation");
    let source=fcgp-str(row,"reply");let settled=fbc-load(source+".release.txt.fkb");
    let saved=fbc-good(settled) ? settled : fbc-load(source+".fkb");
    let retained=fbc-good(saved) ? fbc-data-value(fbc-value(saved)) : nothing();
    let v=key=="" ? nothing() : fcnv-resume-retained(key,retained);
    if nothing?(v) || fcnv-ownership(v)=="release-incomplete" then nothing() else {
     let text=v[0]=="answered" ? v[1] : len(trim(v[8]))>0 ? trim(v[8]) : v[7];
     let path=source+".release.txt";
     write_file_text(path,text);
     read_file(path)!=text ? form_error("native planner released-text retention failed") : 0;
     let kept=fbc-dump(path+".fkb",fbc-data(v));
     !fbc-good(kept) ? form_error("native planner released-result retention failed") : 0;
     let accounted=append(append(take(2,v),[0,0]),v[4:]);
     lpr-heard(flp-req-id(req),fcgp-str(row,"voice"),n,fcgp-str(row,"lens"),accounted,path);
     fcnv-ack-release(v);
     [v[0],text,0,0,path,flp-envelope-refusal(fcnv-envelope-of(v)),0,lpr-admission(v)];
    };
   }
   def lpr-spoken(dir, id, rid, packet, name, n, lens, context, limit, budget) {
   let stem = mc-cat([dir, "/", id, "-", n.str(), "-", now_unix_ms().str()]);
   let kept = write_file_text(stem ++ ".packet.txt", packet);
   let request = flp-voice-request(name, limit, budget, lpr-enquiry(rid,n), context);
   // a standing resident server answers the ask (observe/qwen-serve-run.bml, form-stdlib/bml/serve-client.bml); none standing, the reason is named and this process's own session asks
   // the count the planner names (max_reply_tokens, 3072) is the in-process session's progress signal, not an end: sent to the server it would cut a plan that is still being written
   // (witnessed 2026-11-11: status length at 3072 ids of a plan whose full reply is 5966), so the server is asked with the reply_budget when one is named and otherwise with none
   // the first option is greedy; every later option draws at temperature 0.7 from the option's own seed: a greedy retry of a refused plan answers the same plan again (witnessed
   // 2026-11-11: three options, three byte-identical replies), and a draw is still the same text for the same packet and seed
   let served = svc-voice-drawn(packet, (String) value_kind(budget) == "int" ? budget : 0, "planner", n > 1 ? 700 : 0, n);
   let asked = nothing?(served) ? fcnv-ask(packet, request) : served;
   // a reply cut at the window's end names itself: its status is the window's word, not unavailable
   let v = (String) asked[7] == ftg-window-end() ? append([ftg-window-end()], asked[1:]) : asked;
   let text = v[0] == "answered" ? v[1] : len(trim(v[8])) > 0 ? trim(v[8]) : v[7];
   let heard = write_file_text(stem ++ ".reply.txt", text);
   read_file(stem+".reply.txt")!=text ? form_error("native planner reply retention failed") : 0;
   let evidence=fbc-dump(stem+".reply.txt.fkb",fbc-data(v));
   !fbc-good(evidence) ? form_error("native planner result retention failed") : 0;
   let accounted=fcnv-current-usage(v);
   let owned = lpr-heard(rid, name, n, lens, accounted, stem ++ ".reply.txt");
   let said = print_str(mc-cat(["[local-plan:voice] ", name, " option ", n.str(), " ", v[0], " prompt_ids=", v[2].str(), " generated_ids=", v[3].str(), " reply=", stem, ".reply.txt"]));
    [v[0], text, accounted[2], accounted[3], stem ++ ".reply.txt", flp-envelope-refusal(fcnv-envelope-of(v)),0,lpr-admission(v)];
  }
  def lpr-voice(dir, id, rid, context, limit, budget, until) = (packet, name, n, lens) => lpr-ask(dir, id, rid, packet, name, n, lens, context, limit, budget, until);
  def lpr-read(path) = if ((String) path == "") then "" else fhn-read(path);
  // an earlier walk of this request left its refused options in the ledger; the walk resumes from them unless
  // {"fresh":1} asks for a clean start
  def lpr-memory(req, opts) = if ((Comparable) lpr-int(opts, "fresh", 0) == 1) then [] else flp-memory-of(flp-queue-rows(flp-dir() ++ "/ledger.jsonl"), flp-req-id(req), p => lpr-read(p));
  // A voice already mapped by a live process is warm and is chosen first. A cold voice
  // is chosen only when its file plus an 8 GiB reserve fits the memory still free.
  def lpr-steer-bytes(name) {
   let n = file_size(mr-path(mr-find(name)));
   n < 1 ? -1 : n;
  }
  def lpr-steer-model(voices) {
   let rows = map(name => [name, lpr-steer-bytes(name)], voices);
   // a standing resident server (observe/qwen-serve-run.bml) holds its model's weights for the whole machine: the voice whose file it opened is warm, whatever memory is free
   let served = lpr-served?();
   let warm = filter(name => served ? mr-path(mr-find(name)) == qlz-file() : adm-held-already?(mr-path(mr-find(name))), voices);
   flp-steer-model(rows, warm, lpr-free-bytes(lpr-sense()), 8 * flp-disk-gib());
  }
  def lpr-steer-lease() = flp-steer-lease(gpl-judge(gpu-lease-path()), host_pid());
  def lpr-peer-rows() {
   let rows = host_processes("fkwu*");
   (String) value_kind(rows) == "list" ? rows : [];
  }
  def lpr-named-held?(rows) {
   if nil?(rows) then 0 else if ((Comparable) rows[0][0] == host_pid()) then lpr-named-held?(rows[1:]) else {
    let row = host_process(rows[0][0]);
    let text = (String) value_kind(row) == "list" && len(row) >= 5 && (String) value_kind(row[4]) == "list" ? flp-join(row[4], " ") : "";
    (Comparable) flp-named-peer?(text) == 1 ? 1 : lpr-named-held?(rows[1:]);
   }
  }
  def lpr-peer-held?() = (Comparable) flp-rss-held?(lpr-peer-rows(), host_pid(), flp-kernel-need()) == 1 ? 1 : lpr-named-held?(lpr-peer-rows());
  def lpr-model-path(model) = mr-path(mr-find(model));
  def lpr-model-shared?(model) {
   let path = lpr-model-path(model);
   (String) path != "" && adm-held-already?(path) ? "shared" : "cold";
  }
  def lpr-cold-need(model) = flp-cold-need(lpr-steer-bytes(model), 8 * flp-disk-gib());
  // A resident server (observe/qwen-serve-run.bml) that stands holds the lease and the weights for the whole machine: the ask is routed to it (svc-voice in lpr-spoken), so the
  // device is not held against the ask and the voice's weights are shared; with none standing the lease and the memory are read as they were
  // every ask of this door goes to the standing server when one stands (a session of its own would open beside the server's lease and wait on it for good: witnessed 2026-11-11, the
  // focus guide's 197-id ask held a planner ten minutes), else to this process's own session; the server reads no count, it ends the reply at the model's end of turn
  def lpr-ask-anywhere(prompt, request, who) {
   let served = svc-voice(prompt, 0, who);
   nothing?(served) ? fcnv-ask(prompt, request) : served;
  }
  def lpr-served?() = (String) svc-standing(svc-default-dir())[0] == "standing";
  def lpr-ask-device() = lpr-served?() ? "free" : (String) lpr-steer-lease() == "held-elsewhere" ? "held" : "free";
  def lpr-ask-shared(model) = lpr-served?() ? "shared" : lpr-model-shared?(model);
  def lpr-ask-memory(model) = (String) lpr-ask-shared(model) == "shared" ? "room" : lpr-steer-memory(lpr-cold-need(model));
  def lpr-ask-open?(model) = flp-ask-open?(lpr-ask-device(), lpr-steer-disk(), lpr-ask-memory(model), model, lpr-ask-shared(model));
  def lpr-ask-line(opts) {
   let model = lpr-steer-model(lpr-voices(opts));
   print_str(mc-cat(["[local-plan:ask] open=", lpr-ask-open?(model).str(), " model=", model, " share=", lpr-ask-shared(model), " device=", lpr-ask-device(), " disk=", lpr-steer-disk(), " memory=", lpr-ask-memory(model), " cold=", lpr-cold-need(model).str()]));
   lpr-ask-open?(model);
  }
  // The header names one extra stream's KV. A held lease stays closed. No weights are mapped here.
  def lpr-stream-line(opts) {
   let model = lpr-steer-model(lpr-voices(opts));
   let path = lpr-model-path(model);
   let shared = (String) lpr-model-shared?(model) == "shared" ? 1 : 0;
   let weight = lpr-steer-bytes(model);
   let geo = (String) path == "" ? [] : q38-geo(eqr-of-file(path, 0, 40000000), 2048);
   let state = len(geo) < 24 ? -1 : q38-state-bytes(geo);
   let scratch = len(geo) < 24 ? -1 : q38-scratch-bytes(geo, 1);
   let need = flp-residence-need(weight < 1 ? 0 : weight, scratch < 1 ? 0 : scratch, state < 1 ? 0 : state, 8 * flp-disk-gib(), shared);
   let free = lpr-free-bytes(lpr-sense());
   let device = lpr-device-held?() ? "held" : "free";
   print_str(mc-cat(["[local-plan:streams] open=", flp-stream-open?(device, free, need).str(), " model=", model, " share=", shared.str(), " device=", device, " free=", free.str(), " scratch=", scratch.str(), " state=", state.str(), " need=", need.str()]));
   flp-stream-open?(device, free, need);
  }
  def lpr-state-handle(row) {
   if (row[0] > 0) then row[0] else if (row[1] > 0) then row[1] else if (row[2] > 0) then row[2] else row[3];
  }
  // One token on a stream this process already opened. The position is that stream's own cache slot. No second lease take.
  def lpr-one-token(ctx, sts, id, pos) {
   let moved = q38-forward-state(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], id, pos);
   let head = q38-head(ctx[0], ctx[1], ctx[2], ctx[5], ctx[6]);
   kth-u32at(metal_buf_read(ctx[1][31], 0, 4), 0);
  }
  // One weight open and two KV streams. Both read token 1 at position 0, then each reads a different token at position 1.
  // When those answers differ, both read token 4 at position 2. A different answer there is the cache, not the input.
  // After the weights close, the same lease runs the affine kernel on those two answers. Every buffer is freed before the lease returns.
  def lpr-two-open(path) {
   let ctx = q38-open-span-owned(path, 2048, 1);
   if (len(ctx) < 10) then ["", "", "0", "", "", "0", "0", "", "", "0", "", "", "0", "", ""] else {
    let a = q38-new-state(ctx[2]);
    let b = q38-new-state(ctx[2]);
    let ha = lpr-state-handle(a[0]);
    let hb = lpr-state-handle(b[0]);
    let distinct = ((Comparable) q38-state-ok?(a) == 1) && ((Comparable) q38-state-ok?(b) == 1) && (ha > 0) && ((Comparable) ha != hb) ? "1" : "0";
    let fa = (String) distinct == "1" ? (try [1, lpr-one-token(ctx, a, 1, 0)] catch [0, -1]) : [0, -1];
    let fb = (String) distinct == "1" && ((Comparable) fa[0] == 1) ? (try [1, lpr-one-token(ctx, b, 1, 0)] catch [0, -1]) : [0, -1];
    let agree = ((Comparable) fa[0] == 1) && ((Comparable) fb[0] == 1) && ((Comparable) fa[1] == fb[1]) ? "1" : "0";
    let sa = (String) agree == "1" ? (try [1, lpr-one-token(ctx, a, 2, 1)] catch [0, -1]) : [0, -1];
    let sb = (String) agree == "1" && ((Comparable) sa[0] == 1) ? (try [1, lpr-one-token(ctx, b, 3, 1)] catch [0, -1]) : [0, -1];
    let diverge = ((Comparable) sa[0] == 1) && ((Comparable) sb[0] == 1) && ((Comparable) sa[1] != sb[1]) ? "1" : "0";
    let ta = (String) diverge == "1" ? (try [1, lpr-one-token(ctx, a, 4, 2)] catch [0, -1]) : [0, -1];
    let tb = (String) diverge == "1" && ((Comparable) ta[0] == 1) ? (try [1, lpr-one-token(ctx, b, 4, 2)] catch [0, -1]) : [0, -1];
    let isolate = ((Comparable) ta[0] == 1) && ((Comparable) tb[0] == 1) && ((Comparable) ta[1] != tb[1]) ? "1" : "0";
    let tokensA = ((Comparable) fa[0] == 1 ? 1 : 0) + ((Comparable) sa[0] == 1 ? 1 : 0) + ((Comparable) ta[0] == 1 ? 1 : 0);
    let tokensB = ((Comparable) fb[0] == 1 ? 1 : 0) + ((Comparable) sb[0] == 1 ? 1 : 0) + ((Comparable) tb[0] == 1 ? 1 : 0);
    let framed = print_str(mc-cat(["<|form:resident-stage|>\nid=1\nphase=prefill\nstatus=live\ngas=0\ntokens=", tokensA.str(), "\n<|/form:resident-stage|>\n<|form:resident-stage|>\nid=2\nphase=prefill\nstatus=live\ngas=0\ntokens=", tokensB.str(), "\n<|/form:resident-stage|>\n"]));
    let freed = q38-free-state(a) + q38-free-state(b);
    let closed = q38-close(ctx, []);
    let kernel = ((Comparable) ta[0] == 1) && ((Comparable) tb[0] == 1) ? flp-metal-two(ta[1], tb[1]) : ["", ""];
    [ha.str(), hb.str(), distinct, fa[1].str(), fb[1].str(), agree, closed.str(), sa[1].str(), sb[1].str(), diverge, ta[1].str(), tb[1].str(), isolate, kernel[0], kernel[1]];
   }
  }
  def lpr-two-streams(opts) {
   let model = lpr-steer-model(lpr-voices(opts));
   let path = lpr-model-path(model);
   let shared = (String) lpr-model-shared?(model) == "shared" ? 1 : 0;
   let weight = lpr-steer-bytes(model);
   let geo = (String) path == "" ? [] : q38-geo(eqr-of-file(path, 0, 40000000), 2048);
   let state = len(geo) < 24 ? -1 : q38-state-bytes(geo);
   let scratch = len(geo) < 24 ? -1 : q38-scratch-bytes(geo, 1);
   let need = flp-residence-need(weight < 1 ? 0 : weight, scratch < 1 ? 0 : scratch, state < 1 ? 0 : state, 8 * flp-disk-gib(), shared);
   let free = lpr-free-bytes(lpr-sense());
   let device = lpr-device-held?() ? "held" : "free";
   if ((Comparable) flp-stream-open?(device, free, need) != 1) then { print_str(mc-cat(["[local-plan:streams] live not-run model=", model, " device=", device, " free=", free.str(), " need=", need.str()])); nothing(); } else {
    let opened = gpu-lease-turn("two streams", () => lpr-two-open(path));
    print_str(mc-cat(["[local-plan:streams] live model=", model, " handles=", opened[0], ",", opened[1], " distinct=", opened[2], " tokens=", opened[3], ",", opened[4], " agree=", opened[5], " second=", opened[7], ",", opened[8], " diverge=", opened[9], " third=", opened[10], ",", opened[11], " isolate=", opened[12], " kernel=", opened[13], ",", opened[14], " closed=", opened[6]]));
