; prosody-take-probe.fk — read the prosody sensor's frame the way the glass reads it.
;
; The organ is only wired when a TAKER can see it. This asks fgsr-take for the "prosody" publisher,
; exactly as the glass's own tick does, and prints what came back: whether a sensor stands at all,
; the frame's sequence and epoch, and every row's id, kind and value. A row that says absent prints
; its reason, because an absent row read back as absent is the proof that honesty crossed the frame.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/form-glass-observer.bml

(do
    (defn tp-out (s) (print_str (str_concat s (byte_to_str 10))))
    (defn tp-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (tp-cat (tail xs)))))
    (defn tp-value (row)
        (if (eq (fgo-present? row) 0) (str_concat "absent — " (fgo-note row))
            (if (str_eq (fgo-value-kind row) "text") (fgo-text-value row)
                (str_concat (int_to_str (fgo-int-value row)) (str_concat " " (fgo-unit row))))))
    (defn tp-rows (rows i)
        (if (eq (len rows) 0) 0
            (do (let r (head rows))
                (tp-out (tp-cat (list "  " (int_to_str i) "  " (fgo-id r) "   " (tp-value r))))
                (tp-rows (tail rows) (add i 1)))))
    (tp-out (str_concat "standing: " (int_to_str (fgsr-standing? "prosody"))))
    (let held (fgsr-take "prosody" (list)))
    (tp-out (tp-cat (list "publisher " (fgsr-publisher "prosody")
                          "  seq " (int_to_str (fgsr-held-seq held))
                          "  epoch " (int_to_str (fgsr-held-epoch held))
                          "  cadence " (int_to_str (fgsr-held-cadence held)) " ms"
                          "  rows " (int_to_str (len (fgsr-held-rows held))))))
    (tp-rows (fgsr-held-rows held) 1)
    (tp-out (str_concat "frame row: " (fgo-note (fgsr-frame-row "prosody" held))))
    0)
