; Bidirectional diagnostic opened after a direct proof-walker invocation failed:
; Go/Rust binaries were absent and TypeScript treated source `import` as an
; unbound identifier. Rehearse by probing actual primitives, apply the narrower
; lane, then re-observe the native band. No prompt/answer content is recorded.
import "../form/form-stdlib/core.fk"
import "preflight.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let failed (bfc-round 71 (list 3 0 0 0)
    7100 7101 7199))
  (let action-one (bfc-payload (nth failed 1)))
  (let selected-one (nth failed 2))

  (let masks (list
    (pf-arm-mask "nothing")
    (pf-arm-mask "intern_trivial_int")
    (pf-arm-mask "node_category")))

  ; The second observation has more supported primitive probes than failed
  ; direct walker invocations, so the framebuffer continues on the probed lane.
  (let observed (bfc-round 72 (list 0 3 0 0)
    7200 7201 7299))
  (list "reciprocal-choice-lane-diagnostic"
    (list "failed-method-action" action-one "selected" selected-one)
    (list "arm-masks-go-rust-ts-fkwu" masks)
    (list "reobserve-action" (bfc-payload (nth observed 1))
          "selected" (nth observed 2))
    (list "framebuffer-events" (len (framebuffer-events)))))
