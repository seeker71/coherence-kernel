; form-cli-peer-heldout-v3-one-send.fk — one unassisted sealed question to
; an already-live Form peer.  It never opens a model: the caller supplies the
; resident's existing spool and bell.  The expected answer stays inside the
; evaluator cell and never crosses into the task frame.
;
; stdin lines: task spool, fifo bell, turn, held-out row id.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk

(do
    (defn fch3s-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn fch3s-int (name value) (fch3s-line name (int_to_str value)))
    (defn fch3s-refusal (reason)
        (do
            (fch3s-line "signal" "choice")
            (fch3s-line "reason" reason)
            0))
    (defn fch3s-send (spool bell turn row-id)
        (do
            (let rows (fkh3-rows))
            (let row (fkh3-find-row row-id rows))
            ; The batch gate checks every row and the leakage surface.  A
            ; one-row turn checks its sealed manifest plus this row's exact
            ; source hash; otherwise a single question repeats 30 full file
            ; hashes before it can even ring the already-warm resident.
            (if (not (str_eq (fkh3-dataset-sha256 rows)
                             (fkh3-dataset-seal)))
                (fch3s-refusal "heldout-dataset-seal-mismatch")
                (if (eq (fkh3-row? row) 0)
                    (fch3s-refusal "heldout-row-absent")
                    (if (eq (fkh3-row-current? row) 0)
                        (fch3s-refusal "heldout-row-stale")
                        (if (le turn 0)
                            (fch3s-refusal "turn-not-positive")
                            (do
                                ; The raw question is intentional.  This is a
                                ; memory receipt: no source-query envelope or
                                ; expected answer is supplied to the resident.
                                ; `research` is the existing old-resident
                                ; ingress verb for the model effect.  The
                                ; attempted `heldout` verb stays a durable
                                ; typed choice in that process image; a
                                ; successor can expose a more specific verb,
                                ; but this sender does not pretend it exists
                                ; retroactively.
                                (let frame (str_concat
                                    (fcpa-task-frame turn "research"
                                        (fkh3-prompt row)) "\n"))
                                (let appended (sbt-append spool frame))
                                (if (lt appended 0)
                                    (fch3s-refusal "task-append-refused")
                                    (do
                                        (let rung (sbt-ring bell))
                                        (fch3s-line "signal"
                                            (if (lt rung 0) "choice" "value"))
                                        (fch3s-line "reason"
                                            (if (lt rung 0)
                                                "wake-edge-refused"
                                                "heldout-task-durable"))
                                        (fch3s-line "dataset-sha256"
                                            (fkh3-dataset-seal))
                                        (fch3s-line "row" (fkh3-id row))
                                        (fch3s-line "family" (fkh3-family row))
                                        (fch3s-line "prompt-sha256"
                                            (nmfe-sha256 (fkh3-prompt row)))
                                        (fch3s-int "appended-bytes" appended)
                                        (fch3s-int "ring-result" rung)
                                        (if (lt rung 0) 0 1))))))))))

    (let spool (read_line))
    (let bell (read_line))
    (let turn (str_to_int (read_line)))
    (let row-id (read_line))
    (if (or (or (nothing? spool) (nothing? bell))
            (or (str_eq spool "") (or (str_eq bell "")
                (str_eq row-id ""))))
        (fch3s-refusal "sender-input-absent")
        (fch3s-send spool bell turn row-id)))
