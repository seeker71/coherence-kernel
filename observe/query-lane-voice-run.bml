// The one ask the claims do not hold. Ask the wired voice once, keep the
// reply, and read it back from the ledger. An empty or refused reply is
// not stored.
import form-stdlib/query-lane-resolve.bml;
import form-stdlib/bml/form-cli-native-voice.bml;
section [form.bml] {
 def qlv-path() = "learn/query-recipes.jsonl";
 def qlv-ask() = "Who carries the landing onto origin when the gates are green?";
 def qlv-show(kind, text) = {
  print_str(kind);
  print_str(text);
  0;
 };
 def qlv-keep(before, who, answer) = {
  let kept = qlr-serve-voice(before, qlv-ask(), who + (": " + trim(answer)));
  let wrote = write_file_text(qlv-path(), kept);
  let again = qlr-serve(kept, qlv-ask());
  print_str("kept");
  print_str(again[0][3]);
  print_str(again[0][4]);
  0;
 };
 def qlv-q4() = json-node-object([json-node-pair("model", json-node-string("qwen38-q4")), json-node-pair("max_reply_tokens", json-node-int(128))]);
 def qlv-lora() = json-node-object([json-node-pair("lane", json-node-string("lora")), json-node-pair("max_reply_tokens", json-node-int(128))]);
 def qlv-once(before, request, who) = {
  let spoken = fcnv-ask(qlv-ask(), request);
  (String) spoken[0] == "answered" && (Comparable) len(trim(spoken[1])) > 0 ? qlv-keep(before, who, spoken[1]) : spoken[7];
 };
 def qlv-ask-voice(before) = {
  let q4 = qlv-once(before, qlv-q4(), "qwen38-q4");
  (String) q4 == "0" ? 0 : str_find(q4, "queued", 0) >= 0 ? qlv-show("qwen38-q4", q4) : {
   print_str("qwen38-q4");
   print_str(q4);
   let small = qlv-once(before, qlv-lora(), "llama32-3b");
   (String) small == "0" ? 0 : qlv-show("llama32-3b", small);
  };
 };
 def qlv-run() = {
  let before = read_file(qlv-path()) ?? "";
  let first = qlr-serve(before, qlv-ask());
  (String) first[0][3] == "local-model" ? qlv-ask-voice(before) : qlv-show(first[0][3], first[0][4]);
 };
 qlv-run();
}
