// Real child processes in a private spool; fixture token counts are synthetic.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class HealNativeProcessWitness {
  def hnw-ok(job, stage, status) {
   let doc = fhn-json(fhn-stage-path(job, stage, ".process.json"));
   and(eq(fhn-number(doc, "status"), status), and(str_eq(fhn-string(doc, "state"), "finished"), str_eq(fhn-string(json-object-get(doc, "cleanup"), "state"), "released")));
  }
  def hnw-main() {
   let root = fhn-root();
   let job = fhn-unique(fhn-at(root, ".form-heal"), "process-native-witness-", 0);
   let snapshot = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let entered = print_str(str_concat("evidence=", str_concat(job, "\n")));
   let quick = fhn-run(job, "quick", 3, "root", "-", list("/bin/sh", "-c", "printf 'private-token-bytes\n'; printf 'form-peer stage route=healing phase=sample-ready status=value stamp-ms=1\n' >&2; exit 7"));
   let quickOk = and(str_eq(quick, "7"), and(hnw-ok(job, "quick", 7), fh-has(fhn-read(fhn-stage-path(job, "quick", ".events.jsonl")), "sample-ready")));
   let timeout = fhn-run(job, "timeout", 1, "root", "-", list("/bin/sh", "-c", "sleep 20 & wait"));
   let timeoutOk = and(str_eq(timeout, "124"), hnw-ok(job, "timeout", 124));
   let dynamic = fhn-run(job, "dynamic", 0, "root", "-", list("/bin/sleep", "2"));
   let dynamicOk = and(str_eq(dynamic, "0"), and(hnw-ok(job, "dynamic", 0), fh-has(fhn-read(fhn-at(job, "choices.jsonl")), "observed-progress-gap")));
   let control = write_file(fhn-stage-path(job, "cancel", ".control"), "stop\n");
   let cancel = fhn-run(job, "cancel", 0, "root", "-", list("/bin/sleep", "20"));
   let cancelOk = and(str_eq(cancel, "130"), hnw-ok(job, "cancel", 130));
   let retained = fhn-read(fhn-stage-path(job, "quick", ".out"));
   let privateOk = and(fh-has(retained, "private-token-bytes"), not(fh-has(fhn-read(fhn-stage-path(job, "quick", ".events.jsonl")), "private-token-bytes")));
   let nested = fhn-run(job, "nested", 1, "root", "-", list("/bin/sh", "-c", fh-cat(list("set -m\nsleep 20 &\nprintf '%s' $! > ", fh-quote(fhn-at(job, "detached.pid")), "\nwait\n"))));
   let nestedPid = str_to_int(fhn-read(fhn-at(job, "detached.pid")));
   let nestedOk = and(str_eq(nested, "124"), and(gt(nestedPid, 0), and(not(fhn-alive(nestedPid)), fhn-group-empty(nestedPid))));
   let row = json-node-object(list(fhn-s("phase", "generated"), fhn-s("route", "fixture"), fhn-s("model", "synthetic"), fhn-s("model_path", "fixture"), fhn-s("base_seal_sha256", ""), fhn-s("adapter_path", ""), fhn-s("adapter_sha256", ""), fhn-s("adapter_state", "absent"), fhn-n("input_tokens", 3), fhn-n("output_tokens", 3), fhn-n("position", 6), fhn-n("stamp_ms", 1)));
   let producer = fh-cat(list("printf '%s\\n' ", fh-quote(str_concat("form-heal flow ", json-emit(row))), "\nsleep 1\n[ -s ", fh-quote(fhn-stage-path(job, "stream", ".flow.jsonl")), " ] || exit 8\nsleep 20\n"));
   let streamed = fhn-run(job, "stream", 2, "root", "-", list("/bin/sh", "-c", producer));
   let flows = fhn-json-rows(split-on(fhn-read(fhn-stage-path(job, "stream", ".flow.jsonl")), "\n"));
   let flowOk = and(str_eq(streamed, "124"), and(eq(len(flows), 1), eq(fhn-number(head(flows), "output_tokens"), 3)));
   let schemaOk = and(not(fhn-flow-valid(fhn-put(row, "private", json-node-string("private-token-bytes")))), and(not(fhn-flow-valid(fhn-put(row, "output_tokens", json-node-int(-1)))), not(fhn-flow-valid(fhn-put(row, "output_tokens", json-node-bool(true))))));
   let report = fhn-report(job);
   let timingOk = eq(fhn-number(fhn-json(fhn-at(job, "timing-report.json")), "timing_reconciled"), 1);
   list("native-process-witness", quickOk, timeoutOk, dynamicOk, cancelOk, privateOk, nestedOk, flowOk, schemaOk, timingOk);
  }
 }
 hnw-main();
}
