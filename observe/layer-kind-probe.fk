; layer-kind-probe.fk — one command buffer per layer KIND, 48 repetitions each,
; on live state: GDN block alone, full-attention block alone, ffn alone. The
; forward's 43 ms of non-matvec GPU lives in one of these three; this says which.
;
; preludes: native/metal/qwen35-dense-token-handle.fk form-stdlib/model-registry.bml

(do
    (defn lkp-status-int (status name)
        (do (let key (str_concat name "="))
            (let at (str_find status key 0))
            (if (lt at 0) -1
                (do (let start (add at (str_len key)))
                    (let stop (str_find status "\n" start))
                    (if (lt stop 0) -1 (str_to_int (substring status start stop)))))))
    (defn lkp-gpu () (lkp-status-int (metal_status) "gpu_busy_us_total"))
    (defn lkp-gdn (ps bs geo lay stt rem)
        (if (le rem 0) 0
            (do (let one (q38-linear-attn ps bs geo lay stt))
                (lkp-gdn ps bs geo lay stt (sub rem 1)))))
    (defn lkp-full (ps bs geo lay stt pos rem)
        (if (le rem 0) 0
            (do (let one (q38-full-attn ps bs geo lay stt pos))
                (lkp-full ps bs geo lay stt pos (sub rem 1)))))
    (defn lkp-ffn (ps bs geo lay rem)
        (if (le rem 0) 0
            (do (let one (q38-ffn ps bs geo lay))
                (lkp-ffn ps bs geo lay (sub rem 1)))))
    (defn lkp-time (label thunk-done)
        (do (let sy (metal_sync))
            (let g1 (lkp-gpu))
            (do (print label)
                (print (str_concat " gpu_us_total_delta=" (int_to_str (sub g1 thunk-done))))
                (print "\n") 0)))
    (let st (q38-open (mr-path (mr-find "qwen38-q8")) 256))
    (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2)) (let lays (nth st 3))
    (let embTv (nth st 4))
    (let sts (q38-new-state geo))
    ; warm one advance so state and pages are live (pos 0)
    (let warm (q38-advance ps bs geo lays sts embTv 100 0))
    ; GDN layer 0 is linear (interval 4: layers 0,1,2 linear; 3 full)
    (let arm1 (metal_batch_concurrent))
    (let g0 (lkp-gpu))
    (let arm1b (metal_batch_concurrent))
    (let r1 (lkp-gdn ps bs geo (nth lays 0) (nth sts 0) 48))
    (let s1 (metal_sync))
    (let g1 (lkp-gpu))
    (print (str_concat "gdn_block_x48_gpu_us=" (int_to_str (sub g1 g0))))
    (print (str_concat "  per_block=" (int_to_str (div (sub g1 g0) 48))))
    (print "\n")
    (let arm2 (metal_batch_concurrent))
    (let r2 (lkp-full ps bs geo (nth lays 3) (nth sts 3) 40 48))
    (let s2 (metal_sync))
    (let g2 (lkp-gpu))
    (print (str_concat "full_attn_x48_gpu_us=" (int_to_str (sub g2 g1))))
    (print (str_concat "  per_block=" (int_to_str (div (sub g2 g1) 48))))
    (print "\n")
    (let arm3 (metal_batch_concurrent))
    (let r3 (lkp-ffn ps bs geo (nth lays 0) 48))
    (let s3 (metal_sync))
    (let g3 (lkp-gpu))
    (print (str_concat "ffn_x48_gpu_us=" (int_to_str (sub g3 g2))))
    (print (str_concat "  per_block=" (int_to_str (div (sub g3 g2) 48))))
    (print "\n")
    0)
