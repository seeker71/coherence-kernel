// form-cli-compare-run.bml — the single native form-cli call for the pinned
// enquiry of docs/single-call-parity-goal.form. Its raw output is the answer.
//
// Zero provider, zero oracle, zero calls that leave the body. It reads what
// the body has measured (receipts/rent-ledger.jsonl,
// receipts/parity-contest-ledger.jsonl, the route rows of the pinned receipt),
// the enrich seeds for the enquiry's terms, the dated receipt index, and its
// own membrane crossings inside a census window, then prints the comparison
// axis by axis with what is pending named. The arriving mind runs it once and
// relays the output; that is the flow this goal measures against the guided one.
// stdin: nothing.
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml observe/form-membrane-runtime-census.fk observe/answer-parity-check.fk
section [form.bml] {
 class FormCliCompare {
  def cmp-source() = "observe/form-cli-compare-run.bml";
  def cmp-enquiry() = "receipts/artifacts/2026-09-18-form-cli-enquiry.txt";
  def cmp-terms() = "quality volume frequency vitality trust traceability sovereignty resonance rented membrane";
  def cmp-receipt() = "receipts/2026-09-18-direct-vs-guided-form-cli.md";
  def cmp-rent-ledger() = "receipts/rent-ledger.jsonl";
  def cmp-contest-ledger() = "receipts/parity-contest-ledger.jsonl";
  def cmp-opening() = 160;
  def cmp-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def cmp-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def cmp-nonempty(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then cmp-nonempty(tail(xs)) else cons(head(xs), cmp-nonempty(tail(xs)));
  def cmp-parse(xs) = if nil?(xs) then list() else cons(parse-json("ledger-row", head(xs)), cmp-parse(tail(xs)));
  def cmp-rows(path) = cmp-parse(cmp-nonempty(split-on(fhn-read(path), "\n")));
  def cmp-walk-line(r) = mc-cat(list("  ", cmp-str(r, "movement"), " | source=", cmp-str(r, "source"), " | rent=", int_to_str(cmp-int(r, "rent_tokens")), " | oracle=", cmp-str(r, "oracle"), " | receipts-in-packet=", int_to_str(cmp-int(r, "receipts_in_packet")), "\n"));
  def cmp-walk-lines(rows) = if nil?(rows) then "" else mc-cat(list(cmp-walk-line(head(rows)), cmp-walk-lines(tail(rows))));
  def cmp-contest-line(r) = mc-cat(list("  ", cmp-str(r, "movement"), " | source=", cmp-str(r, "single_source"), " | rent=", int_to_str(cmp-int(r, "single_rent_tokens")), " | left-the-body=", int_to_str(cmp-int(r, "single_non_form_calls")), " | receipts=", int_to_str(cmp-int(r, "single_receipts_existing")), " | floor=", int_to_str(cmp-int(r, "floor_parity")), " | reading=", cmp-str(r, "reading"), "\n"));
  def cmp-contest-lines(rows) = if nil?(rows) then "" else mc-cat(list(cmp-contest-line(head(rows)), cmp-contest-lines(tail(rows))));
  def cmp-min-rent(rows, best) = if nil?(rows) then best else cmp-min-rent(tail(rows), if and(eq(cmp-int(head(rows), "floor_parity"), 1), or(eq(best, 0), lt(cmp-int(head(rows), "single_rent_tokens"), best))) then cmp-int(head(rows), "single_rent_tokens") else best);
  def cmp-planes(planes, rows) = if nil?(planes) then "" else mc-cat(list("  ", head(planes), "=", int_to_str(fmrc-delta-plane-total(rows, head(planes))), "\n", cmp-planes(tail(planes), rows)));
  def cmp-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh", "metal-device", "mlx-runtime", "cpu-jit", "cuda-device", "physical-sense");
  // one step along the seeded relations: what each seeded term points at, and what that is
  def cmp-relations(terms) = if nil?(terms) then "" else mc-cat(list(cmp-relation(head(terms), fwf-forward(head(terms))), cmp-relations(tail(terms))));
  def cmp-relation(term, edges) = if nil?(edges) then "" else mc-cat(list("  ", term, " -> ", fwf-surface(fwf-at(fwf-edge-to(head(edges)))), ": ", fce-join(fwf-desc(fwf-at(fwf-edge-to(head(edges))))), "\n", cmp-relation(term, tail(edges))));
  // the native rung measures itself into the contest ledger, rent 0, nothing left the body
  def cmp-self-row(single, guided) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", "native compare call"),
   fhn-s("enquiry", cmp-enquiry()),
   fhn-s("single_source", "native"),
   fhn-s("single_oracle", "not-asked"),
   fhn-s("single_answer", "receipts/artifacts/2026-09-18-native-compare-answer.txt"),
   fhn-n("single_rent_tokens", 0),
   fhn-n("single_non_form_calls", 0),
   fhn-n("single_axes", nth(single, 0)),
   fhn-n("single_receipts_cited", nth(single, 1)),
   fhn-n("single_receipts_existing", nth(single, 2)),
   fhn-n("single_limits", nth(single, 3)),
   fhn-n("single_bytes", nth(single, 4)),
   fhn-s("guided_answer", cmp-receipt()),
   fhn-n("guided_rent_tokens", 2544568),
   fhn-n("guided_non_form_calls", 78),
   fhn-n("guided_axes", nth(guided, 0)),
   fhn-n("guided_receipts_existing", nth(guided, 2)),
   fhn-n("guided_limits", nth(guided, 3)),
   fhn-n("floor_parity", if and(ge(nth(single, 0), nth(guided, 0)), and(ge(nth(single, 2), nth(guided, 2)), ge(nth(single, 3), nth(guided, 3)))) then 1 else 0),
   fhn-n("rent_ratio_bps", 0),
   fhn-n("rent_under_1pct", 1),
   fhn-n("zero_non_form", 1),
   fhn-s("reading", "pending")));
  def cmp-text(enrichment, index, walks, contests, guided) = mc-cat(list(
   "form-cli compare | source=native | provider=0 oracle=0 calls-left-the-body=0\n",
   "enquiry: ", cmp-enquiry(), "\n",
   "the body answers from its own rows, seeds and receipts; the person's reading is the judge of quality and resonance.\n\n",
   "[rented] tokens per answer to this enquiry, from the body's own rows\n",
   "  guided flow (the arriving mind, ", cmp-receipt(), "): rent 2,544,568 through provider call 21; 78 calls left the body (57 host tool calls, 21 provider calls)\n",
   "  direct (one organ call, unbounded provider loop inside): rent 648,411; 29 calls left the body\n",
   "  bounded (one provider turn carrying an enrich reading): rent 44,495; 1 call left the body\n",
   "  this call (native): rent 0; 0 calls left the body\n",
   "  minimum rent with the floor met among provider contests: ", int_to_str(cmp-min-rent(contests, 0)), "\n\n",
   "[walks] ", cmp-rent-ledger(), "\n", cmp-walk-lines(walks), "\n",
   "[contests] ", cmp-contest-ledger(), " (a rung with a provider inside; not this flow)\n", cmp-contest-lines(contests), "\n",
   "[quality] structural floor of the guided answer: axes=", int_to_str(nth(guided, 0)), " receipts-cited=", int_to_str(nth(guided, 2)), " limits-named=", int_to_str(nth(guided, 3)), " bytes=", int_to_str(nth(guided, 4)), "; floors of the contest answers are in their rows; the person's reading decides: pending\n",
   "[volume] this output is the body's own composition; packet sizes and answer bytes are in the rows above\n",
   "[frequency] calls that left the body per answer: guided 78, direct 29, bounded 1, provider contests 1, this call 0\n",
   "[vitality] doors that stand for this enquiry: observe/form-cli-grounded-synthesis-run.bml, observe/rent-walk-run.bml, observe/parity-contest-run.bml, observe/answer-parity-check.fk, observe/form-cli-native-call-census-run.fk, this door\n",
   "[trust] every rent figure above is a provider's own usage record; where the share meter's token-pressure lane read the same call it agreed (13,222 on 2026-09-18); this call's figures are the body's own counters\n",
   "[traceability] each row names its evidence path; the receipt names its artifacts; this output names its own crossings below\n",
   "[sovereignty] who decided each answer: guided = a rented mind at every step; direct = a rented mind inside one organ call; bounded and contests = the body chose the packet, a provider wrote once; this call = the body alone\n",
   "[resonance] not a number the body has; pending: the person's reading of the answers side by side\n",
   "[membrane] the planes this call crossed while composing (its own census window) follow the ground below\n\n",
   "[native ground] one in-process enrich reading of the terms\n", enrichment, "\n",
   "[one step along the seeded relations] what each seeded term points at, and what that is\n", cmp-relations(fgs-clean(split-on(cmp-terms(), " "))), "\n",
   "[receipts by name] terms matched first, then date, newest first; openings of ", int_to_str(cmp-opening()), " bytes\n", index,
   "[pending] felt resonance; a native voice on this host (no Metal, no admitted model); the loopback oracle answering (permission or a host where it stands); the share meter settling a completed-turn coordinate on this transcript shape\n"));
  def cmp-run() {
   let window = fmrc-open("form-cli-compare", "one native comparison call", cmp-source(), 1, 1);
   let enrichment = fce-command(cmp-terms());
   let index = fgs-index(fgs-top(fgs-rank(fs_list("receipts"), fgs-clean(split-on(cmp-terms(), " "))), 8), cmp-opening());
   let walks = cmp-rows(cmp-rent-ledger());
   let contests = cmp-rows(cmp-contest-ledger());
   let guided = apc-floor(apc-text(cmp-receipt()));
   let text = cmp-text(enrichment, index, walks, contests, guided);
   let self = apc-floor(text);
   let ledger = fhn-append(cmp-contest-ledger(), str_concat(json-emit(cmp-self-row(self, guided)), "\n"));
   let result = fmrc-close(window, "observed", cmp-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(text);
   print_str(mc-cat(list("[floor of this output] axes=", int_to_str(nth(self, 0)), " receipts-cited=", int_to_str(nth(self, 1)), " receipts-existing=", int_to_str(nth(self, 2)), " limits-named=", int_to_str(nth(self, 3)), " bytes=", int_to_str(nth(self, 4)), "; contest ledger row ", ledger, "\n")));
   print_str(mc-cat(list("[crossings of this call] census-status=", fmrc-result-status(result), " dispatches=", int_to_str(fmrc-delta-total(rows)), "\n", cmp-planes(cmp-plane-names(), rows))));
  }
 }
 cmp-run();
}
