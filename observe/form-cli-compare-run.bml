// form-cli-compare-run.bml — the single native form-cli call for the pinned
// enquiry of docs/single-call-parity-goal.form. Its raw output is the answer.
//
// Zero provider, zero oracle, zero calls that leave the body. The composition
// is form-stdlib/bml/form-cli-native-compare.bml: the body's measured rows,
// the enrich seeds, one step along the seeded relations, the dated receipt
// index, axis by axis with what is pending named. This door prints it inside
// a census window, floors it, and leaves one row in the contest ledger. The
// arriving mind runs it once and relays the output; that is the flow the
// parity goal measures against the guided one.
// stdin: nothing.
// preludes: form-stdlib/bml/form-cli-native-compare.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class FormCliCompare {
  def cmp-source() = "observe/form-cli-compare-run.bml";
  def cmp-planes(planes, rows) = if nil?(planes) then "" else mc-cat(list("  ", head(planes), "=", int_to_str(fmrc-delta-plane-total(rows, head(planes))), "\n", cmp-planes(tail(planes), rows)));
  def cmp-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh", "metal-device", "mlx-runtime", "cpu-jit", "cuda-device", "physical-sense");
  def cmp-run() {
   let window = fmrc-open("form-cli-compare", "one native comparison call", cmp-source(), 1, 1);
   let text = fnc-compose();
   let guided = fnc-guided-floor();
   let self = apc-floor(text);
   let ledger = fhn-append(fnc-contest-ledger(), str_concat(json-emit(fnc-self-row(self, guided)), "\n"));
   let result = fmrc-close(window, "observed", cmp-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(text);
   print_str(mc-cat(list("[floor of this output] axes=", int_to_str(nth(self, 0)), " receipts-cited=", int_to_str(nth(self, 1)), " receipts-existing=", int_to_str(nth(self, 2)), " limits-named=", int_to_str(nth(self, 3)), " bytes=", int_to_str(nth(self, 4)), "; contest ledger row ", ledger, "\n")));
   print_str(mc-cat(list("[crossings of this call] census-status=", fmrc-result-status(result), " dispatches=", int_to_str(fmrc-delta-total(rows)), "\n", cmp-planes(cmp-plane-names(), rows))));
  }
 }
 cmp-run();
}
