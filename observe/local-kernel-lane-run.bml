// local-kernel-lane-run.bml — the local model writes a kernel the lane really runs; the machine runs it beside the lane's own and keeps it only when they agree.
//
//   echo '{"go":1}' | ./fkwu observe/local-kernel-lane-run.bml
//
// The kernel is the surprise reader of the multi-stream head (form-stdlib/bml/q38-multi.bml, q38m-lp-msl): one threadgroup of 256 threads a
// row; out[row] = uint(clamp(log(sum exp(logit - max)) * 1e6, 0, 4e9)), the micro-nats the model is unsure of its greedy token by. Three lenses
// of the model (q38-lenses.bml, as chat turns with an empty think block) each write it from the spec below; each text is cut at its closing
// fence, compiled with metal_pipeline, dispatched under the GPU lease over two rows of 1024 real floats and compared word for word with
// the lane's handwritten kernel on the same data (agreement within 0.5% or 2000 micro-nats: the sums run in different orders). Of the lenses
// that agree, the one the model was surest of (least surprise a token) is kept at .hearth/local-kernels/form_lp_model.metal.
// A round whose kernels none agreed is followed by another in which each lens is shown the failed source and the compiler's own words
// (the carrier's last_error), up to three rounds. At 480 tokens the kernels were cut off mid-body ("expected '}'"); 820 holds one.
// stdin, one JSON line: go (without it only the plan is said), gen (820 tokens a lens).
// A physical run: it needs the local GPU.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/q38-multi.bml form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/q38-lenses.bml native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-dense-spec.fk
section [form.bml] {
 class LocalKernelLaneRun {
  def lkl-say(t) = print_str("[local-kernel-lane] " ++ t ++ "\n");
  def lkl-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("local-kernel-lane", line) : json-node-object([]);
  }
  def lkl-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def lkl-name() = "form_lp_model";
  def lkl-spec() = "Write one Metal Shading Language compute kernel named form_lp_model with exactly this signature: kernel void form_lp_model (device const float* lg [[buffer(0)]], device uint* out [[buffer(1)]], constant uint& vocab [[buffer(2)]], uint row [[threadgroup_position_in_grid]], uint lid [[thread_position_in_threadgroup]]). It runs one threadgroup of 256 threads per row; row r reads vocab floats from lg + r * vocab. It must compute m = the maximum of the row, s = the sum over the row of exp(x - m), and write out[row] = uint(clamp(log(s) * 1000000.0f, 0.0f, 4000000000.0f)). Use threadgroup memory for the two reductions (a threadgroup float array of 256), with threadgroup barriers. Answer with the kernel only, inside a metal code fence.";
  def lkl-header() = "#include <metal_stdlib>\nusing namespace metal;\n";
  def lkl-open() = "```metal\n" ++ lkl-header();
  // the text up to the closing fence
  def lkl-cut-at(text, i) = i + 2 >= len(text) ? text : (str_byte_at(text, i) == 96 && str_byte_at(text, i + 1) == 96 && str_byte_at(text, i + 2) == 96) ? substring(text, 0, i) : lkl-cut-at(text, i + 1);
  def lkl-source(text) = lkl-header() ++ lkl-cut-at(text, 0);
  // two rows of 1024 floats from small integers, deterministic: x = ((i * 37 + row * 11) % 101 - 50) / 8
  def lkl-vocab() = 1024;
  def lkl-rows() = 2;
  def lkl-floats() = map(k => ((k * 37 + (k / lkl-vocab()) * 11) % 101 - 50) * 0.125, range(0, lkl-vocab() * lkl-rows()));
  def lkl-words(raw, i, n) = i >= n ? [] : cons(kth-u32at(raw, i), lkl-words(raw, i + 1, n));
  // dispatch a compiled pipeline over the data; answers the out words
  def lkl-dispatch(pipe) {
   let lg = metal_buf_alloc(lkl-vocab() * lkl-rows() * 4);
   let ob = metal_buf_alloc(64);
   let w = metal_buf_write(lg, 0, foldl((a, x) => a ++ md-le32(md-f32-bits(x)), "", lkl-floats()));
   let z = metal_buf_write(ob, 0, md-le32(0) ++ md-le32(0));
   let ran = gpu-lease-turn("local lane kernel", () => {
    let batch = metal_batch_concurrent();
    let q = metal_enqueue(pipe, md-bind16([lg, ob], [lkl-vocab()], 256, 0, 1, 1), lkl-rows());
    metal_sync();
   });
   let got = lkl-words(metal_buf_read(ob, 0, 8), 0, lkl-rows());
   let f = q38-free-handle(lg) + q38-free-handle(ob);
   got;
  }
  def lkl-near?(a, b) = (a - b < 0 ? b - a : a - b) <= (b / 200 > 2000 ? b / 200 : 2000);
  def lkl-compile(source, name) = try metal_pipeline(source, name) catch 0;
  // [valid, what]
  def lkl-try(source, reference) {
   let pipe = lkl-compile(source, lkl-name());
   !(pipe > 0) ? [0, "did not compile: " ++ lkl-compiler-words()] : lkl-judge(lkl-dispatch(pipe), reference);
  }
  // The carrier keeps the compiler's own diagnostic as last_error in its status; the model is shown those words, not a summary of them.
  def lkl-compiler-words() {
   let status = metal_status();
   let at = str_find(status, "last_error=", 0);
   at < 0 ? "no diagnostic" : lkl-clip(substring(status, at + 11, len(status)), 700);
  }
  def lkl-clip(s, n) = len(s) > n ? substring(s, 0, n) : s;
  def lkl-judge(got, reference) = all?(i => lkl-near?(got[i], reference[i]), range(0, lkl-rows())) ? [1, "agrees " ++ got.str() ++ " vs " ++ reference.str()] : [0, "disagrees " ++ got.str() ++ " vs " ++ reference.str()];
  def lkl-best(rows, i, best) = i >= len(rows) ? best : lkl-best(rows, i + 1, (rows[i][0] == 1 && (best < 0 || rows[i][1] < rows[best][1])) ? i : best);
  def lkl-run() {
   let o = lkl-opts();
   lkl-int(o, "go", 0) != 1 ? lkl-say("plan: go=1 asks three lenses of the local model for the lane's surprise kernel, runs each beside the lane's own on two rows of 1024 floats, keeps the surest that agrees") : lkl-go(lkl-int(o, "gen", 820));
  }
  // The model hears what the machine saw. A round whose kernels none agreed is followed by another in which each lens is shown the failed
  // source of the round's surest lens and told the compiler or the comparison refused it (the verdict word, nothing more), up to three rounds.
  def lkl-tasks(failed, why) = len(failed) == 0 ? ["", "Prefer the simplest correct version.", "Mind the barriers between the reduction steps."] : map(h => "A previous attempt at this kernel was refused (" ++ why ++ "). Its source was:\n```metal\n" ++ failed ++ "\n```\nWrite a corrected kernel with the same name and signature. " ++ h, ["", "Change as little as you must.", "Check every line you write against the Metal Shading Language."]);
  def lkl-go(gen) {
   let ctx = qlz-open(2048);
   let ref = lkl-dispatch(lkl-compile(lkl-header() ++ q38m-lp-msl(lkl-name()), lkl-name()));
   let said = lkl-say("the lane's own kernel reads " ++ ref.str());
   let out = lkl-round(ctx, ref, gen, 1, "", "");
   let closed = qlz-close(ctx);
   out;
  }
  def lkl-round(ctx, ref, gen, round, failed, why) {
   let r = qlz-run-ids(ctx, qlz-chat-prefix(ctx, lkl-spec()), map(t => qlz-chat-lens(ctx, t, lkl-open()), lkl-tasks(failed, why)), gen);
   let sources = map(t => lkl-source(t), r[0]);
   let tried = map(s => lkl-try(s, ref), sources);
   let a = lkl-say("round " ++ round.str() ++ ": prefix " ++ len(r[2]).str() ++ " ids; " ++ gen.str() ++ " tokens x " ++ len(sources).str() ++ " lenses " ++ r[3][2].str() ++ " ms");
   let b = map(i => lkl-say("lens " ++ i.str() ++ " valid " ++ tried[i][0].str() ++ " (" ++ tried[i][1] ++ ") surprise " ++ r[1][i].str() ++ " micro-nats a token"), range(0, len(sources)));
   let best = lkl-best(map(i => [tried[i][0], r[1][i]], range(0, len(sources))), 0, 0 - 1);
   let surest = foldl((s, i) => r[1][i] < r[1][s] ? i : s, 0, range(0, len(sources)));
   if (best >= 0) then lkl-keep(sources[best], best, round) else if (round >= 3) then lkl-say("no lens wrote a kernel that agrees with the lane's in three rounds: nothing kept") else lkl-round(ctx, ref, gen, round + 1, lkl-cut-at(r[0][surest], 0), tried[surest][1]);
  }
  def lkl-keep(source, lens, round) {
   let made = host_mkdir_mode(".hearth/local-kernels", 493);
   let kept = write_file_text(".hearth/local-kernels/" ++ lkl-name() ++ ".metal", source);
   lkl-say("kept lens " ++ lens.str() ++ " of round " ++ round.str() ++ " at .hearth/local-kernels/" ++ lkl-name() ++ ".metal (" ++ len(source).str() ++ " bytes)");
  }
 }
 lkl-run();
}
