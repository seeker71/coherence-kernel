// preludes: form/form-stdlib/bml/native-node-word.bml
section [form.bml] {
 let source = nnw-header();
 let written = write_file("runtime/fkwu-node-word.h", source);
 let same = str_eq(read_file("runtime/fkwu-node-word.h"), source);
 print(list("native-node-word", nnw-total-bits(), "bytes-written", written, "readback", same));
 if and(eq(nnw-total-bits(), 64), same) then 0 else form_error("native node word generation failed");
}
