; qwen4exp-flash-next-router-run.fk — bounded observer for the exact router shape.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q6k-msl.fk form-stdlib/transformer-numerics.fk form-stdlib/moe-msl.fk form-stdlib/qwen4exp-flash-next-router-xtal.fk

(do
    (print_str (str_concat "CHECK " (int_to_str (q4r-check))))
    (print_str (str_concat "LOGIT63 " (float_to_str (q4r-logit 63))))
    (print_str (str_concat "LOGIT64 " (float_to_str (q4r-logit 64))))
    (print_str (str_concat "LOGIT65 " (float_to_str (q4r-logit 65))))
    (let expected (q4r-expected-ids))
    (let actual (q4r-ids))
    (let weights (q4r-weights))
    (print_str (str_concat "EXPECTED-FIRST " (int_to_str (head expected))))
    (print_str (str_concat "EXPECTED-LAST " (int_to_str (nth expected 9))))
    (print_str (str_concat "ACTUAL-FIRST " (int_to_str (head actual))))
    (print_str (str_concat "ACTUAL-LAST " (int_to_str (nth actual 9))))
    (print_str (str_concat "WEIGHT-FIRST " (float_to_str (head weights))))
    (print_str (str_concat "WEIGHT-LAST " (float_to_str (nth weights 9))))
    0)
