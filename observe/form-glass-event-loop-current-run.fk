; form-glass-event-loop-current-run.fk — bounded physical buffer/gap witness.
;
; This reads two real telemetry inventories without starting another dashboard,
; stages their structural counts through the same front/back state used by the
; resident loop, and reports only counts and carrier availability.  It does not
; claim a monotonic wait: the current kernel does not expose one.
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let observed-at (now_unix_ms))
    (let first-inventory (fgtm-inventory (FGLRoot)))
    (let first-samples (fgl-inventory-samples-at first-inventory observed-at))
    (let first (list "physical-glass-frame-v1" observed-at
        (len (fgl-inventory-publishers first-inventory))
        (len first-samples)))
    (let first-buffer (fgel-buffer-commit
        (fgel-buffer-stage (fgel-buffer-empty) first)))
    (let second-at (now_unix_ms))
    (let second-inventory (fgtm-inventory (FGLRoot)))
    (let second-samples (fgl-inventory-samples-at second-inventory second-at))
    (let second (list "physical-glass-frame-v1" second-at
        (len (fgl-inventory-publishers second-inventory))
        (len second-samples)))
    (let staged (fgel-buffer-stage first-buffer second))
    (let committed (fgel-buffer-commit staged))
    (let event-source (read_file "form/form-stdlib/form-glass-event-loop.bml"))
    (let live-source (read_file "form/form-stdlib/form-glass-live.bml"))
    (list "physical-form-glass-event-loop-v1"
          "observed-wall-epoch-ms" observed-at
          "publishers-before" (nth (fgel-buffer-front first-buffer) 2)
          "samples-before" (nth (fgel-buffer-front first-buffer) 3)
          "publishers-staged" (nth (fgel-buffer-back staged) 2)
          "samples-staged" (nth (fgel-buffer-back staged) 3)
          "publishers-after" (nth (fgel-buffer-front committed) 2)
          "samples-after" (nth (fgel-buffer-front committed) 3)
          "presented-generation" (fgel-buffer-presented committed)
          "staged-generation" (fgel-buffer-staged committed)
          "new-event-module-host-exec" (if (lt (str_find event-source
              "host-exec(" 0) 0) 0 1)
          "live-compat-sleep-present" (if (ge (str_find live-source
              "host-exec(fgl-sleep-ms-command" 0) 0) 1 0)
          "carrier-gap" (fgel-carrier-gap)))
