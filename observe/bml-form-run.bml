// Runs real BML sources through the native compiler's fkwu lowering
// (form-stdlib/bml/bml-form-lower.bml): each source lowers to Form defns that
// fkwu compiles and runs itself. Each source declares its own answer in its
// head, "Answer: N"; an answer that holds a space is quoted. "Units: a.bml b.bml"
// names the units a source links, files beside it.
// stdin: source paths, one per line; with none, every fixture under
// form/form-stdlib/tests/fixtures that declares an answer.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk form-stdlib/bml/bml-form-lower.bml
section [form.bml] {
 class BmlFormRun {
  def bfr-fixtures-dir() = "form/form-stdlib/tests/fixtures";
  def bfr-after(text,marker) = if lt(str_find(text,marker,0),0) then "" else substring(text,add(str_find(text,marker,0),str_len(marker)),str_len(text));
  def bfr-stop?(c) = or(eq(c,32),or(eq(c,10),or(eq(c,44),or(eq(c,13),eq(c,9)))));
  def bfr-token-end(s,i,n) = if ge(i,n) then n else if bfr-stop?(str_byte_at(s,i)) then i else bfr-token-end(s,add(i,1),n);
  def bfr-token(s) = substring(s,0,bfr-token-end(s,0,str_len(s)));
  def bfr-trim-dot(t) = if and(gt(str_len(t),0),eq(str_byte_at(t,sub(str_len(t),1)),46)) then substring(t,0,sub(str_len(t),1)) else t;
  def bfr-unquote(t) = if and(ge(str_len(t),2),eq(str_byte_at(t,0),34)) then substring(t,1,sub(str_len(t),1)) else t;
  def bfr-quote-end(s,i,n) = if ge(i,n) then n else if eq(str_byte_at(s,i),34) then i else bfr-quote-end(s,add(i,1),n);
  def bfr-quoted(raw) = substring(raw,1,bfr-quote-end(raw,1,str_len(raw)));
  def bfr-clean(raw) = if and(gt(str_len(raw),0),eq(str_byte_at(raw,0),34)) then bfr-quoted(raw) else bfr-unquote(bfr-trim-dot(bfr-token(raw)));
  def bfr-declared(text) {
   let raw = bfr-after(text,"Answer: ");
   if eq(str_len(raw),0) then "" else bfr-clean(raw);
  }

  def bfr-line-end(s,i,n) = if ge(i,n) then n else if eq(str_byte_at(s,i),10) then i else bfr-line-end(s,add(i,1),n);
  def bfr-line(raw) = substring(raw,0,bfr-line-end(raw,0,str_len(raw)));
  def bfr-slash(s,i) = if lt(i,0) then -1 else if eq(str_byte_at(s,i),47) then i else bfr-slash(s,sub(i,1));
  def bfr-beside(path,name) = if lt(bfr-slash(path,sub(str_len(path),1)),0) then name else str_concat(substring(path,0,add(bfr-slash(path,sub(str_len(path),1)),1)),name);
  def bfr-unit-nodes(path,names) = if nil?(names) then list() else if eq(str_len(head(names)),0) then bfr-unit-nodes(path,tail(names)) else cons(bml-source-exec-parse-node(bml-source-file-parse-executable(bfr-beside(path,head(names)))),bfr-unit-nodes(path,tail(names)));
  def bfr-units(path) {
   let raw = bfr-after(read_file(path),"Units: ");
   if eq(str_len(raw),0) then list() else bfr-unit-nodes(path,split-on(bfr-line(raw)," "));
  }
  def bfr-value(path) {
   let node = bml-source-exec-parse-node(bml-source-file-parse-executable(path));
   let healed = bml-scope-heal-imports(node,bfr-units(path),empty());
   bfk-run-unit-value-at(path,node,nth(healed,0));
  }
  def bfr-row(state,path,detail) = str_concat(state,str_concat(" ",str_concat(path,str_concat(" ",detail))));
  def bfr-run(path) {
   let declared = bfr-declared(read_file(path));
   if eq(str_len(declared),0) then "" else bfr-judge(path,declared,value_str(bfr-value(path)));
  }
  def bfr-judge(path,declared,got) = if str_eq(got,declared) then bfr-row("ok",path,got) else bfr-row("differs",path,str_concat(got,str_concat(" declared ",declared)));

  def bfr-stdin-paths(acc) {
   let line = read_line();
   if or(nothing?(line),str_eq(line,"")) then reverse-list(acc) else bfr-stdin-paths(cons(line,acc));
  }
  def bfr-fixture?(name) = and(eq(str_find(name,"bml-",0),0),gt(str_find(name,".bml",0),0));
  def bfr-fixture-paths(names) = if nil?(names) then list() else if bfr-fixture?(head(names)) then cons(str_concat(bfr-fixtures-dir(),str_concat("/",head(names))),bfr-fixture-paths(tail(names))) else bfr-fixture-paths(tail(names));
  def bfr-rows(paths) = if nil?(paths) then list() else bfr-rows-then(bfr-run(head(paths)),tail(paths));
  def bfr-rows-then(row,rest) = if eq(str_len(row),0) then bfr-rows(rest) else cons(row,bfr-rows(rest));
  def bfr-say(rows) = if nil?(rows) then 0 else bfr-say-then(print(head(rows)),tail(rows));
  def bfr-say-then(said,rest) = bfr-say(rest);
  def bfr-count(rows,state) = if nil?(rows) then 0 else add(if eq(str_find(head(rows),str_concat(state," "),0),0) then 1 else 0,bfr-count(tail(rows),state));
  def bfr-main() {
   let given = bfr-stdin-paths(list());
   let paths = if nil?(given) then bfr-fixture-paths(fs_list(bfr-fixtures-dir())) else given;
   let rows = bfr-rows(paths);
   bfr-say(rows);
   str_concat(int_to_str(bfr-count(rows,"ok")),str_concat(" ok of ",int_to_str(len(rows))));
  }
 }
 bfr-main();
}
