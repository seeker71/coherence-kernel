// band-cover-run.bml — which bands read an edited file.
//
// A band runs the files its `; preludes:` lines and imports name, and those files' own preludes in turn.
// This door reads the same tokens through the body's own reader (prelude-reach's prch-* over
// bml-source-dependencies and bml-source-resolve), turns each edge around, and walks from every named
// file back up to the tests that load it. The walk covers what a prelude line or an import states. A unit
// the runtime loads by name (form-stdlib/home-index.txt) is reported as `home-unit` with its names: the
// bands that meet those names are the ones that mention them. A door another door spawns is no edge: a
// file only a spawned door reads answers `bands=0` and counts as unread, so the drift gate is the check
// that covers it.
// stdin: nothing (the working tree's changes against HEAD, and new files), `since <rev>` (changes
// against that revision), or one repo-relative path per line.
// stdout: per source file `cover <file> reaches=<files> bands=<n>` and its bands (a band under form/
// prints as validate.sh takes it, from form/), then `band-cover files=<f> bands=<union> unread=<k>`.
// The answer is <k>, the source files no band and no home name reads; run from the repository root.
// preludes: observe/prelude-reach.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class BandCover {
  def bcv-has?(s, part) = str_find(s, part, 0) >= 0;
  def bcv-ends?(s, tail) = (len(s) >= len(tail)) && ((String) substring(s, len(s) - len(tail), len(s)) == tail);
  def bcv-source?(path) = bcv-ends?(path, ".fk") || bcv-ends?(path, ".bml") || bcv-ends?(path, ".form");
  def bcv-band?(path) = bcv-source?(path) && bcv-has?(path, "tests/") && !bcv-has?(path, "fixture");
  def bcv-hint(path) = ((String) substring(path, 0, 5) == "form/") ? substring(path, 5, len(path)) : path;

  def bcv-add(rev, dep, owner) {
   let held = record_get(rev, dep);
   record_set(rev, dep, cons(owner, ((Comparable) held == 0) ? [] : held));
  }
  def bcv-dep(owner, token, rev) {
   let hit = bml-source-resolve(owner, token);
   nothing?(hit) ? rev : bcv-add(rev, prch-norm(hit), owner);
  }
  def bcv-deps(owner, tokens, rev) = nil?(tokens) ? rev : bcv-deps(owner, tokens[1:], bcv-dep(owner, tokens[0], rev));
  def bcv-rows(rows, rev) {
   nil?(rows) ? rev
   : len(rows[0]) < 5 ? bcv-rows(rows[1:], rev)
   : bcv-rows(rows[1:], bcv-deps(prch-owner(rows[0]), prch-tokens(prch-owner(rows[0]), prch-content(rows[0])), rev));
  }

  def bcv-owners(rev, path) {
   let held = record_get(rev, path);
   ((Comparable) held == 0) ? [] : held;
  }
  def bcv-reach(rev, frontier, seen, out) {
   nil?(frontier) ? out
   : !((Comparable) record_get(seen, frontier[0]) == 0) ? bcv-reach(rev, frontier[1:], seen, out)
   : bcv-reach(rev, append(bcv-owners(rev, frontier[0]), frontier[1:]), record_set(seen, frontier[0], 1), cons(frontier[0], out));
  }

  def bcv-homes(lines, file, out) {
   let unit = nil?(lines) ? nothing() : prch-home-unit(lines[0]);
   let hit = nothing?(unit) ? nothing() : bml-source-resolve("form/form-stdlib/home-index.txt", unit);
   nil?(lines) ? reverse(out)
   : !nothing?(hit) && ((String) prch-norm(hit) == file) ? bcv-homes(lines[1:], file, cons(bml-source-words(lines[0])[0], out))
   : bcv-homes(lines[1:], file, out);
  }

  def bcv-join(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ " " ++ bcv-join(xs[1:]);
  def bcv-show(bands) = nil?(bands) ? 0 : print_str("  " ++ bcv-hint(bands[0])) + bcv-show(bands[1:]);

  // one file: its bands, its home names, and whether anything reads it (list(bands, read))
  def bcv-cover(rev, homes, file) {
   let reached = bcv-reach(rev, [file], record_new(0), []);
   let bands = reverse(reached |> filter(p => bcv-band?(p)));
   let names = bcv-homes(homes, file, []);
   print_str("cover " ++ file ++ " reaches=" ++ (len(reached) - 1).str() ++ " bands=" ++ len(bands).str());
   bcv-show(bands);
   nil?(names) ? 0 : print_str("  home-unit " ++ bcv-join(names));
   [bands, !nil?(bands) || !nil?(names)];
  }
  def bcv-union(bands, seen, out) {
   nil?(bands) ? out
   : !((Comparable) record_get(seen, bands[0]) == 0) ? bcv-union(bands[1:], seen, out)
   : bcv-union(bands[1:], record_set(seen, bands[0], 1), cons(bands[0], out));
  }
  def bcv-walk(rev, homes, files, seen, out, unread) {
   let got = nil?(files) ? nothing() : bcv-cover(rev, homes, files[0]);
   nil?(files) ? [out, unread]
   : bcv-walk(rev, homes, files[1:], seen, bcv-union(got[0], seen, out), unread + (got[1] ? 0 : 1));
  }

  def bcv-inputs(text) {
   let lines = prch-lines(text) |> map(l => bml-source-trim(l));
   nil?(lines) ? append(prch-lines(prch-git(["diff", "--name-only", "HEAD"])), prch-lines(prch-git(["ls-files", "--others", "--exclude-standard"])))
   : ((String) substring(lines[0], 0, 6) == "since ") ? prch-lines(prch-git(["diff", "--name-only", substring(lines[0], 6, len(lines[0]))]))
   : lines;
  }
  def bcv-run() {
   let files = bcv-inputs(stdin-text()) |> filter(p => bcv-source?(p));
   let rev = bcv-rows(prch-lines(prch-git(["grep", "-a", "-n", "-E", prch-pattern(), "--", "*.fk", "*.bml"])), record_new(0));
   let homes = prch-lines(prch-text(read_file("form/form-stdlib/home-index.txt")));
   let got = bcv-walk(rev, homes, files, record_new(0), [], 0);
   print_str("band-cover files=" ++ len(files).str() ++ " bands=" ++ len(got[0]).str() ++ " unread=" ++ got[1].str());
   got[1];
  }
 }
 bcv-run();
}
