; form-local-plan-resident-live.fk — two next-step decisions through one held
; Form-native Qwen/Metal residence. No remote provider or HTTP membrane exists.
;
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let t0 (now_unix_ms))
    (let first (fcmg-local-plan-resident (fcmr-none) path
        "A changed Form cell has not yet been compiled or observed."))
    (let t1 (now_unix_ms))
    (let second (fcmg-local-plan-resident (nth first 1) path
        "The changed Form cell compiled and its focused band returned the complete verdict."))
    (let t2 (now_unix_ms))
    (let held (fcmr-live? (nth second 1)))
    (let released (fcmr-release-ok? (nth second 1)))
    (print_str (str_concat "first-wall-ms=" (str_concat (int_to_str (sub t1 t0)) "\n")))
    (print_str (str_concat "second-wall-ms=" (str_concat (int_to_str (sub t2 t1)) "\n")))
    (print_str (str_concat "residence-held-before-release="
        (str_concat (int_to_str held) "\n")))
    (print_str (str_concat "released=" (str_concat (int_to_str released) "\n")))
    (print_str (str_concat "first:\n" (str_concat (nth first 0) "\n")))
    (print_str (str_concat "second:\n" (str_concat (nth second 0) "\n")))
    0)
