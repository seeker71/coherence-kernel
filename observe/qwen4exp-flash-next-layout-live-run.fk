; Live mapping of every qwen4exp tensor view across both data shards.
;
; preludes: form/native/metal/qwen4exp-flash-next-layout.fk

(do
    (defn q4gll-root () "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-")
    (defn q4gll-path (part) (str_concat (q4gll-root) (str_concat part "-of-00003.gguf")))
    (defn q4gll-tvs-live? (xs)
        (if (eq (len xs) 0) 1
            (if (gt (q4tv-h (head xs)) 0) (q4gll-tvs-live? (tail xs)) 0)))
    (defn q4gll-lays-live? (lays)
        (if (eq (len lays) 0) 1
            (if (eq (q4gll-tvs-live? (head lays)) 1) (q4gll-lays-live? (tail lays)) 0)))
    (defn q4gll-count (lays acc)
        (if (eq (len lays) 0) acc (q4gll-count (tail lays) (add acc (len (head lays))))))
    (defn q4gll-all? (xs)
        (if (eq (len xs) 0) 1
            (if (eq (head xs) 1) (q4gll-all? (tail xs)) 0)))
    (defn q4gll-shape (tv) (list (q4tv-r tv) (q4tv-c tv) (q4tv-ty tv) (q4tv-slices tv)))
    (let paths (list (q4gll-path "00001") (q4gll-path "00002") (q4gll-path "00003")))
    (let src2 (eqr-of-file (nth paths 1) 0 16000000))
    (let src3 (eqr-of-file (nth paths 2) 0 16000000))
    (let lays (q4gl-layers paths src2 src3))
    (let model (q4gl-model paths src2 src3))
    (let count (q4gll-count lays 0))
    (let verdict
        (if (eq (q4gll-all? (list
                (eq (len lays) 48)
                (eq count 1212)
                (eq (len model) 12)
                (q4gll-lays-live? lays)
                (q4gll-tvs-live? model)
                (eq (q4tv-ty (nth (nth lays 0) 9)) 17)
                (eq (q4tv-ty (nth (nth lays 0) 11)) 20)
                (eq (q4tv-ty (nth (nth lays 2) 9)) 18)
                (eq (q4tv-ty (nth (nth lays 3) 22)) 30)
                (eq (q4tv-ty (nth model 5)) 20))) 1)
            1023 0))
    (let before (metal_status))
    (q4gl-free-layers lays)
    (q4gl-free-list model)
    (list "qwen4exp-flash-next-layout-live"
        (list "layers" (len lays) "tensor-views" count "model-views" (len model))
        (list "layer0-expert-types" (q4tv-ty (nth (nth lays 0) 9)) (q4tv-ty (nth (nth lays 0) 11))
              "layer2-gate-type" (q4tv-ty (nth (nth lays 2) 9))
              "indexer-bf16-type" (q4tv-ty (nth (nth lays 3) 22)))
        (list "layer0-common-shapes" (q4gll-shape (nth (nth lays 0) 0))
              (q4gll-shape (nth (nth lays 0) 1)) (q4gll-shape (nth (nth lays 0) 2))
              (q4gll-shape (nth (nth lays 0) 8)) (q4gll-shape (nth (nth lays 0) 9))
              (q4gll-shape (nth (nth lays 0) 10)) (q4gll-shape (nth (nth lays 0) 11)))
        (list "layer0-linear-shapes" (q4gll-shape (nth (nth lays 0) 16))
              (q4gll-shape (nth (nth lays 0) 17)) (q4gll-shape (nth (nth lays 0) 18))
              (q4gll-shape (nth (nth lays 0) 19)) (q4gll-shape (nth (nth lays 0) 20))
              (q4gll-shape (nth (nth lays 0) 21)) (q4gll-shape (nth (nth lays 0) 22))
              (q4gll-shape (nth (nth lays 0) 23)) (q4gll-shape (nth (nth lays 0) 24)))
        (list "layer3-full-shapes" (q4gll-shape (nth (nth lays 3) 16))
              (q4gll-shape (nth (nth lays 3) 17)) (q4gll-shape (nth (nth lays 3) 18))
              (q4gll-shape (nth (nth lays 3) 19)) (q4gll-shape (nth (nth lays 3) 20))
              (q4gll-shape (nth (nth lays 3) 21)) (q4gll-shape (nth (nth lays 3) 22))
              (q4gll-shape (nth (nth lays 3) 23)) (q4gll-shape (nth (nth lays 3) 24))
              (q4gll-shape (nth (nth lays 3) 25)))
        (list "model-shapes" (q4gll-shape (nth model 0)) (q4gll-shape (nth model 1))
              (q4gll-shape (nth model 2)) (q4gll-shape (nth model 3))
              (q4gll-shape (nth model 4)) (q4gll-shape (nth model 5))
              (q4gll-shape (nth model 6)) (q4gll-shape (nth model 7)))
        (list "mapped-status" before)
        (list "after-free" (metal_status))
        (list "verdict" verdict)))
