// Real child refusals, private source repair and independently owned CPU SHA.
// The canonical checkout is read only; every changed byte belongs to the job.
// preludes: form-stdlib/bml/concept-source-audit.bml form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class ConceptSourceAuditWitness {
  def caw-put(path,text) = if and(eq(write_file(path,text),str_len(text)),str_eq(read_file(path),text)) then path else form_error("concept audit witness write refused");
  def caw-state(root) = record_new(0,"root",root,"files",list(),"observations",0,"hash","arm64-sha256");
  def caw-check(state,aspect,ok,evidence) = csa-check(state,aspect,ok,evidence);
  def caw-q(text) = json-emit-precise(json-node-string(text));
  def caw-child(job,name,body) {
   let path = caw-put(nsi-path(job,str_concat(name,".bml")),str_concat("// preludes: form-stdlib/bml/concept-source-audit.bml\nsection [form.bml] {\n",str_concat(body,";\n}\n")));
   nsi-capture(list("./fkwu",path));
  }
  def caw-request(job,name,text) = caw-child(job,name,str_concat("csa-request(",str_concat(caw-q(text),")")));
  def caw-audit(job,name,root,engine) = caw-request(job,name,json-emit-precise(json-node-object(list(oh-s("root",root),oh-s("hash",engine)))));
  def caw-pains(lines,held) = if nil?(lines) then reverse(held) else caw-pain-line(head(lines),tail(lines),held);
  def caw-pain-line(line,rest,held) {
   let prefix = "form-organ health ";
   if not(str_eq(substring(line,0,str_len(prefix)),prefix)) then caw-pains(rest,held) else caw-pain-row(parse-json("concept-audit-observation",substring(line,str_len(prefix),str_len(line))),rest,held);
  }
  def caw-pain-row(row,rest,held) = caw-pains(rest,if and(oh-valid(row),oh-pain(row)) then cons(row,held) else held);
  def caw-refused(capture,aspect) {
   let rows = caw-pains(split-on(nsi-text(capture),"\n"),list());
   if not(and(eq(nsi-status(capture),1),eq(len(rows),3))) then 0 else and(str_eq(oh-str(head(rows),"aspect"),aspect),and(str_eq(oh-str(head(rows),"stage"),"observe"),and(str_eq(oh-str(nth(rows,1),"stage"),"response"),and(str_eq(oh-str(nth(rows,2),"stage"),"applied"),and(str_eq(oh-str(head(rows),"id"),oh-str(nth(rows,1),"id")),str_eq(oh-str(head(rows),"id"),oh-str(nth(rows,2),"id")))))));
  }
  def caw-hash-case(text) {
   let before = metal_live();
   let owner = sob-hash(text);
   let after = metal_live();
   and(str_eq(record_get(owner,"reason"),"ready"),and(str_eq(sob-hex(record_get(owner,"digest"),0),hex-encode(sha256-stream-string(text))),and(nil?(record_get(owner,"buffers")),and(eq(record_get(owner,"pipeline"),0),and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3)))))));
  }
  def caw-repeat(text,left) = if le(left,0) then text else caw-repeat(str_concat(text,text),sub(left,1));
  def caw-hashes(xs) = if nil?(xs) then 1 else and(caw-hash-case(head(xs)),caw-hashes(tail(xs)));
  def caw-hash(state) {
   let text = caw-repeat("a",7);
   let shared = mj-memory(saj-code(),"form_cpu_jit");
   let cases = list("","abc",substring(text,0,55),substring(text,0,56),substring(text,0,63),substring(text,0,64),substring(text,0,65),substring(text,0,127),text,str_concat("梅; ",str_concat(byte_to_str(0),"\r\n")),caw-repeat("a",21));
   let checked = caw-hashes(cases);
   let owner = sob-hash(42);
   let before = metal_live();
   let unknown = sob-hash-in(sob-observed(nothing()),"abc");
   let unsupported = sob-hash-in(sob-observed(0),"abc");
   let stale = sob-context();
   record_set(stale,"pid",sub(host_pid(),1));
   let expired = sob-hash-in(stale,"abc");
   let after = metal_live();
   let refused = and(str_eq(record_get(unknown,"reason"),"host-isa-unobserved"),and(str_eq(record_get(unsupported,"reason"),"host-isa-unobserved"),str_eq(record_get(expired,"reason"),"host-isa-unobserved")));
   caw-check(state,"unknown-unsupported-stale-isa-refusal",and(refused,and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3)))),"no buffer or raw image admission without a current process capability");
   let released = mj-release-handle(mj-handle(shared));
   caw-check(state,"owned-byte-hash-and-padding",and(checked,and(str_eq(record_get(owner,"reason"),"bytes-required"),eq(released,1))),"11 exact portable SHA comparisons, 2 MiB bytes, independent image lifetime and typed refusal");
  }
  def caw-copy(state,root,paths) = if nil?(paths) then 1 else caw-copy-next(state,root,head(paths),tail(paths));
  def caw-copy-next(state,root,path,rest) {
   let target = fs-path-join(root,path);
   fs_mkdir(fs-path-dirname(target));
   caw-put(target,csa-file(state,path));
   caw-copy(state,root,rest);
  }
  def caw-care(state,aspect,path,bytes,capture) {
   let row = oh-reading("concept-source-witness",record_get(state,"root"),aspect,json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("current-owned-source",oh-reference(path))),list("revise","defer"),oh-reference(nsi-path(nsi-evidence(capture),"stdout")));
   oh-voice(row);
   let response = oh-response(row,"revise");
   oh-voice(response);
   let selected = oh-select(row,response,"defer");
   if str_eq(selected,"revise") then caw-put(path,bytes) else form_error("concept source repair not selected");
   oh-voice(oh-applied(row,selected,oh-reference(path)));
   1;
  }
  def caw-snapshot(state,job) {
   let current = caw-state(".");
   csa-primary(current); csa-stable-ids(current);
   let root = nsi-directory(job,"snapshot-",0);
   caw-copy(current,root,record_get(current,"files"));
   let missingPath = "cognition/concept-nl-semantic-13-sources.dat";
   let target = fs-path-join(root,missingPath);
   fs_remove(target);
   let absent = caw-audit(job,"missing-source",root,"arm64-sha256");
   caw-check(state,"missing-source-correlated-refusal",caw-refused(absent,"complete-file-read"),nsi-evidence(absent));
   caw-care(state,"restore-missing-source",target,csa-file(current,missingPath),absent);
   let changedPath = "model/concept-10000-ranked.dat";
   let changed = fs-path-join(root,changedPath);
   let bytes = csa-file(current,changedPath);
   caw-put(changed,str_concat("!",substring(bytes,1,str_len(bytes))));
   let corrupt = caw-audit(job,"changed-label",root,"arm64-sha256");
   caw-check(state,"changed-label-correlated-refusal",caw-refused(corrupt,"english-stable-id"),nsi-evidence(corrupt));
   caw-care(state,"restore-ranked-label",changed,bytes,corrupt);
   let healed = caw-audit(job,"restored-source",root,"arm64-sha256");
   caw-check(state,"actual-restored-source-audit",and(nsi-ok(healed),ge(str_find(nsi-text(healed),"cells, 130000, stable-ids, 111, files, 16",0),0)),nsi-evidence(healed));
   3;
  }
  def caw-requests(state,job,rows,index) {
   if nil?(rows) then index else caw-request-case(state,job,head(rows),tail(rows),index);
  }
  def caw-request-case(state,job,text,rest,index) {
   let capture = caw-request(job,str_concat("request-",int_to_str(index)),text);
   caw-check(state,"request-correlated-refusal",caw-refused(capture,"request-admission"),nsi-evidence(capture));
   caw-requests(state,job,rest,add(index,1));
  }
  def caw-run() {
   let job = nsi-job(); let state = caw-state(job);
   let hashes = caw-hash(state);
   let snapshot = caw-snapshot(state,job);
   let requests = caw-requests(state,job,list("{","[]","null","{\"root\":4}","{\"hash\":null}","{\"hash\":\"arm64-sha256\",\"hash\":\"form-sha256\"}","{\"unknown\":\"field\"}"),0);
   print(list("concept-source-witness","hash-cases",11,"source-transitions",snapshot,"request-refusals",requests,"evidence",job));
   add(hashes,add(snapshot,requests));
  }
 }
 caw-run();
}
