; Scripted witness of the ordinary form-cli state path.  The repository command
; framebuffer closes captured stdin after one turn, so this cell drives the same
; fc-turn handler and the same root/selection values that repl carries between
; `models`, `use`, `model-bandwidth`, and `generate`.
; preludes: form/form-stdlib/form-cli-repl.fk

; Each turn is handed what the session holds and answers with what it should keep
; holding, exactly as repl threads it.  Only `generate` admits a model, so the
; residence appears at that turn and is released here at the end of the script.
(do
    (let root "/Users/ursmuff/models/qwen38-27b")
    (let models-line (str_concat "models " root))
    (let models-said (fc-turn models-line root "" (fcmr-none)))
    (let selected (fc-pick root "0"))
    (let use-said (fc-turn "use 0" root selected (nth models-said 1)))
    (let bandwidth-said (fc-turn "model-bandwidth" root selected (nth use-said 1)))
    (let generate-said
        (fc-turn "generate Reply with exactly: hello" root selected (nth bandwidth-said 1)))
    (let released (fcmr-release-ok? (nth generate-said 1)))
    (list
        (list "models" (nth models-said 0))
        (list "selected" selected)
        (list "use" (nth use-said 0))
        (list "model-bandwidth" (nth bandwidth-said 0))
        (list "generate" (nth generate-said 0))
        (list "residence-held" (fcmr-live? (nth generate-said 1)))
        (list "released" released)))
