// gpu-lease-run.fk — run one fkwu cell (a band, a door) under the GPU lease.
//
//   printf '<cell path>\n[<stdin file for the cell>]\n' | ./fkwu observe/gpu-lease-run.fk
//
// Line one is the cell, run as `./fkwu <cell>`; line two, if given, is a file fed to the cell as its stdin (else
// /dev/null). The cell's own stdout and stderr are this door's. The door takes the GPU lease (/tmp/form-gpu.lock,
// form/form-stdlib/gpu-lease.bml) first -- a live holder is waited for, a dead holder's lease is taken over -- lends it to
// the cell it runs, runs the cell to its end, gives the lease back and prints the cell's exit code as `exit  N`. The
// cell's own holds and turns (the Qwen lane takes one a turn: the open, a prefill, each token) inherit the lent lease and
// answer ["inherited" token]; a cell that takes the lease itself (gpu-lease-door-held) still waits on this door, so it
// runs bare. A refused take stops the door before the cell starts. The lease is held by this door, the Metal user is its
// child: a door killed with -9 leaves a dead owner's lease behind and the next client takes it over (the child's own next
// turn among them: a lend reaches only a living parent's child), but its child (if it lives) is still on the device; end
// the child too.
//
// preflight-exec: forbidden
import form/form-stdlib/gpu-lease.bml;
import form/form-stdlib/line-grammar.fk;
section [form.bml] {
    def glr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def glr-run(cell, input, lease) {
        let pid = host_spawn_at(["./fkwu", cell], [(Comparable) len(input) == 0 ? "/dev/null" : input, "", ""]);
        let rc = host_wait(pid);
        let gave = gpu-lease-door-end(lease);
        print_str("exit  " + rc.str());
    }
    // a lend that was not written would leave the cell's turns waiting on this door: the lease goes back and the door stops aloud
    def glr-unlent(lease) {
        let gave = gpu-lease-door-end(lease);
        form_error("gpu-lease-run: the lease could not be lent to the cell, which was not run");
    }
    let cell = glr-line();
    let input = glr-line();
    (Comparable) len(cell) == 0 ? form_error("usage: <cell path> / [stdin file] on stdin") : 0;
    let lease = gpu-lease-door-held("gpu-lease-run " + cell);
    let lent = gpu-lease-lend(lease);
    (Comparable) lent < 0 ? glr-unlent(lease) : glr-run(cell, input, lease);
    0;
}
