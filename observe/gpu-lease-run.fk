// gpu-lease-run.fk — run one fkwu cell (a band, a door that does not take the lease itself) under the GPU lease.
//
//   printf '<cell path>\n[<stdin file for the cell>]\n' | ./fkwu observe/gpu-lease-run.fk
//
// Line one is the cell, run as `./fkwu <cell>`; line two, if given, is a file fed to the cell as its stdin (else
// /dev/null). The cell's own stdout and stderr are this door's. The door takes the GPU lease (.hearth/gpu.lock,
// form/form-stdlib/gpu-lease.bml) first -- a live holder is waited for, a dead holder's lease is taken over -- runs
// the cell to its end, gives the lease back and prints the cell's exit code as `exit  N`. A refused take stops the
// door before the cell starts. The lease is held by this door, the Metal user is its child: a door killed with -9
// leaves a dead owner's lease behind and the next client takes it over, but its child (if it lives) is still on the
// device; end the child too.
//
// preflight-exec: forbidden
import form/form-stdlib/gpu-lease.bml;
import form/form-stdlib/line-grammar.fk;
section [form.bml] {
    def glr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def glr-run(cell, input, lease) {
        let pid = host_spawn_at(["./fkwu", cell], [(Comparable) len(input) == 0 ? "/dev/null" : input, "", ""]);
        let rc = host_wait(pid);
        let gave = gpu-lease-door-end(lease);
        print_str("exit  " + rc.str());
    }
    let cell = glr-line();
    let input = glr-line();
    (Comparable) len(cell) == 0 ? form_error("usage: <cell path> / [stdin file] on stdin") : 0;
    let lease = gpu-lease-door-held("gpu-lease-run " + cell);
    glr-run(cell, input, lease);
    0;
}
