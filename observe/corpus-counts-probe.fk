; corpus-counts-probe.fk — ask the corpus for its own counts, in one cell.
;
; The three pins in learn/tests/homecoming-distillation-corpus-band.fk are a count, an admissible
; count and one folded field code, and a hand that counts rows by eye gets them wrong — the field
; code alone is 760074821368 and every digit of it is a separate claim. So the corpus answers for
; itself, and a landing hand reads the four numbers it is about to pin rather than deriving them.
; preludes: learn/homecoming-distillation-corpus.fk
(do
    (defn ccp-line (k v) (print_str (str_concat k (str_concat " " (int_to_str v)))))
    (let a (ccp-line "rows        " (hdc-count (hdc-rows))))
    (let b (ccp-line "admissible  " (hdc-count-admissible (hdc-rows))))
    (let c (ccp-line "foundings   " (hdc-foundings)))
    (let d (ccp-line "max-mid     " (hdc-max-mid (hdc-rows))))
    (let e (ccp-line "field-code  " (hdc-field-code)))
    0)
