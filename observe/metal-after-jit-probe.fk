; metal-after-jit-probe.fk — does a CPU-JIT pipeline poison the Metal pipelines
; that follow it in the same process? form-cli verifies the artifact seal (SHA-256
; on the CPU JIT lane) before it maps a tensor; fkwu's bandwidth probe does not.
; Same cell, two orders.
; preludes: native/metal/model-bandwidth.fk form-stdlib/qwen35-artifact-fetch.fk form-stdlib/model-registry.bml
(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (print "seal first, then the stream probe\n")
    (print (str_concat "seal_ok=" (int_to_str (qaf-verify-sealed-file path))))
    (print "\n")
    (print (mbw-run path))
    0)
