// preflight-exec: forbidden
// prepare binds already executed local teacher practice; run retains one native model.
// JSON stdin: action, home; prepare also takes teacher, parent, learning_rate.
// Each round observes generated practice, learns once if needed, and observes again.
// A nonempty fit/cancel file retains the last complete checkpoint and releases ownership.
// preludes: learn/bml-practice-fit.bml
section [form.bml] {
 def bpf-door(raw) {
  let request = parse-json("BML practice fit",raw); let home = nsm-str(request,"home");
  if str_eq(nsm-str(request,"action"),"prepare") then bpf-prepare(home,nsm-str(request,"teacher"),nsm-str(request,"parent"),nsm-num(request,"learning_rate"))
  else if str_eq(nsm-str(request,"action"),"run") then bpf-run(home)
  else if str_eq(nsm-str(request,"action"),"enqueue") then bpf-enqueue(home,nsm-str(request,"teacher"))
  else form_error("Fit action requires prepare, run or enqueue");
 }
 bpf-door(read_line());
 0;
}
