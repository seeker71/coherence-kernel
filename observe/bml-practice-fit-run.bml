// preflight-exec: forbidden
// The native BML practice door: one JSON line on stdin, "lane" names the practice (default "fit"), the rest is that lane's own request.
//   fit        action prepare|run|enqueue, home; prepare also teacher, parent, learning_rate. Each round observes generated practice,
//              learns once if needed, and observes again; a nonempty fit/cancel file retains the last complete checkpoint.
//   status     home. Read-only status of the fit's scalar evidence.
//   teacher    home, condition, model, context_capacity. Proposals await inspection and execution.
//   practice   home. A fresh private evidence directory: prepares and executes references only.
//   execution  action generate|ground|feedback|focus|grade|enqueue|status|report, home, condition, adapter; feedback and focus also parent.
//   scalar     action prepare|test|teacher-test|practice|grade|extract, home, condition; test adapter; grade kind; extract parent.
//   token      home, teacher, condition, adapter, case. Practice targets only.
//   compact    action prepare|enqueue, home. Prepare executes every compact reference; enqueue offers only that practice.
// Grade executes proposals; inspect them first. Only practice may teach.
// preludes: learn/bml-practice-fit.bml learn/bml-practice-fit-observation.bml learn/bml-native-teacher.bml learn/bml-execution-practice.bml learn/bml-execution-observation.bml learn/bml-scalar-observation.bml learn/bml-token-observation.bml learn/bml-compact-practice.bml
section [form.bml] {
 def bpd-is(a, b) = (String) a == b;
 def bpd-fit(request, action, home) =
  bpd-is(action, "prepare") ? bpf-prepare(home, nsm-str(request, "teacher"), nsm-str(request, "parent"), nsm-num(request, "learning_rate"))
  : bpd-is(action, "run") ? bpf-run(home)
  : bpd-is(action, "enqueue") ? bpf-enqueue(home, nsm-str(request, "teacher"))
  : form_error("Fit action requires prepare, run or enqueue");
 def bpd-execution(request, action, home) {
  let condition = nsm-str(request, "condition"); let adapter = nsm-str(request, "adapter"); let parent = nsm-str(request, "parent");
  bpd-is(action, "generate") ? beo-generate(home, condition, adapter)
  : bpd-is(action, "ground") ? beo-ground(home, condition, adapter)
  : bpd-is(action, "feedback") ? beo-feedback(home, condition, adapter, parent)
  : bpd-is(action, "focus") ? beo-focus(home, condition, adapter, parent)
  : bpd-is(action, "grade") ? beo-grade(home, condition)
  : bpd-is(action, "enqueue") ? beo-enqueue(home)
  : bpd-is(action, "status") ? beo-status(home)
  : bpd-is(action, "report") ? beo-report(home)
  : form_error("Execution action requires generate, ground, feedback, focus, grade, enqueue, status or report");
 }
 def bpd-scalar(request, action, home) {
  let condition = nsm-str(request, "condition");
  bpd-is(action, "prepare") ? bsp-prepare(home)
  : bpd-is(action, "test") ? bso-condition(home, condition, nsm-str(request, "adapter"), "test")
  : bpd-is(action, "practice") ? bso-condition(home, condition, "", "practice")
  : bpd-is(action, "teacher-test") ? bso-teacher-test(home, condition)
  : bpd-is(action, "grade") ? bso-grade(home, condition, nsm-str(request, "kind"))
  : bpd-is(action, "extract") ? bso-extract(home, condition, nsm-str(request, "parent"))
  : form_error("Scalar action requires prepare, test, teacher-test, practice, grade or extract");
 }
 def bpd-compact(action, home) = bpd-is(action, "prepare") ? bcp-prepare(home) : bpd-is(action, "enqueue") ? bcp-enqueue(home) : form_error("Compact action requires prepare or enqueue");
 def bpd-door(raw) {
  let request = parse-json("BML practice", raw);
  let lane = nsm-str(request, "lane"); let action = nsm-str(request, "action"); let home = nsm-str(request, "home");
  bpd-is(lane, "") || bpd-is(lane, "fit") ? bpd-fit(request, action, home)
  : bpd-is(lane, "status") ? bpo-status(home)
  : bpd-is(lane, "teacher") ? bnt-generate(home, nsm-str(request, "condition"), nsm-str(request, "model"), nsm-num(request, "context_capacity"))
  : bpd-is(lane, "practice") ? bep-prepare(home)
  : bpd-is(lane, "execution") ? bpd-execution(request, action, home)
  : bpd-is(lane, "scalar") ? bpd-scalar(request, action, home)
  : bpd-is(lane, "token") ? bto-run(home, nsm-str(request, "teacher"), nsm-str(request, "condition"), nsm-str(request, "adapter"), nsm-str(request, "case"))
  : bpd-is(lane, "compact") ? bpd-compact(action, home)
  : form_error("Practice lane requires fit, status, teacher, practice, execution, scalar, token or compact");
 }
 bpd-door(read_line());
 0;
}
