; form-local-offline-self-direction-seam.fk -- execute today's exact local floor.
;
; This pulse runs one due local map/select/control/re-observe movement.  The
; current priority exposes an fmcl category NodeID, not a bound recipe, so the
; actuator returns typed nothing and the health state remains unchanged.  No
; Codex/Claude scheduler participates, and no hourly wake is claimed.
;
; preludes: observe/form-local-offline-health-pulse.fk
; preludes: observe/form-local-offline-self-direction.fk

import "form-local-offline-health-pulse.fk"
import "form-local-offline-self-direction.fk"

(do
    (defn flosds-observe (state stamp) (flohm-map stamp state))
    (defn flosds-control (outbound) (bfc-control outbound 0))
    (defn flosds-unbound-category (state selected before)
        (flosd-apply-result "nothing" "selected-action-category-has-no-executable-recipe-binding"
            (flohm-identity selected) (flohm-action-token selected) state 0))
    (defn flosds-run ()
        (do
            (framebuffer-clear)
            (flosd-tick flosds-observe flosds-control flosds-unbound-category
                (flohp-rows) (flohp-stamp) 2026082571 (now_unix_ms) 0)))
    (defn flosds-evidence (result)
        (list "form-local-offline-self-direction-seam-v1"
            (nth result 1) (nth result 2) (nth result 4) (nth result 5)
            (nth result 10) (nth result 11) (nth result 12)
            (nth result 13) (nth result 14) (nth result 15) (nth result 16)
            0 (nth result 18) (nth result 19) (len (framebuffer-events))))
    (flosds-evidence (flosds-run)))
