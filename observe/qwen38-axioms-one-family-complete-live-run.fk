; qwen38-axioms-one-family-complete-live-run.fk -- DORMANT physical door.
;
; This cell defines one serialized local movement for the first selected family
; window, `axioms`: public heldout lanes a/b in fresh states, one independent
; public-generative attempt with at most one executed supervised repair, and
; one exact model-requested Metal recipe crossing whose typed frex result is
; injected into the same native-request state before generation resumes.
;
; One q38 context/weights residence is opened explicitly and shared by every
; fresh state.  Live values flow directly into fkav-result and fka1-crossing;
; progress text is never parsed back into evidence.  The final projection is
; re-observed from the current family census; `axioms` is a first window, not a
; permanent target and the current census count is not legislated.
;
; A bounded framebuffer window opens before the model context. Every phase
; emits an opaque, content-free observation. Surprise, nothing, timeout and
; refusal receive a correlated synchronous Form control whose branch, revise,
; request-evidence or abstain state changes the actual next physical step; the
; changed state is then re-observed. Prompt and answer bytes never enter the
; framebuffer: only stage ids, counters, hashes and source coordinates do.
;
; DORMANT: there is no top-level call to fka1l-run.  Do not preflight or invoke
; this door during review.  The pure organ and adversarial band are the proof
; surfaces.  An intentional carrier owner calls `(fka1l-run path model-id)`.
;
; No remote call, C growth, flattening, operations table, registry mutation or
; private evaluator exists on this path.
;
; preludes: form-stdlib/form-knowledge-axioms-one-family-crossing.fk
; preludes: form-stdlib/form-cli-model-generate.fk
; preludes: form-stdlib/form-cli-model-session.fk
; preludes: form-stdlib/form-knowledge-axioms-public-curriculum.fk
; preludes: observe/framebuffer-runtime-live-stream.fk

(do
    (defn fka1l-maxpos () 4096)
    (defn fka1l-max-generative () 900)
    (defn fka1l-max-native-request () 128)
    (defn fka1l-max-native-resume () 96)
    (defn fka1l-trace-id () "qwen38-axioms-one-family-complete")
    (defn fka1l-stream-stage
        (stage parent before after metric value outcome line)
        (do
            (let event (fbro-stage-observed-stream (fka1l-trace-id) stage
                parent "Sema" "embodies-one-family-window"
                "observe-teach-execute-reinject-release-and-reproject"
                "opaque-stage-counters-and-hashes" before after metric value
                outcome
                "observe/qwen38-axioms-one-family-complete-live-run.fk"
                line 7))
            (let separator (print_str "\n"))
            event))
    (defn fka1l-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn fka1l-int (name value) (fka1l-line name (int_to_str value)))
    (defn fka1l-after (source marker)
        (do
            (let at (str_find source marker 0))
            (if (lt at 0) ""
                (substring source (add at (str_len marker))
                    (str_len source)))))
    (defn fka1l-run-id (started model-id binding)
        (nmfe-sha256 (nmfe-fields (list
            "axioms-one-family-complete-physical-run-v1"
            (int_to_str started) model-id (fkhe-dataset-seal)
            (fkg15-plan-seal) (fkfne-binding-sha binding)))))
    (defn fka1l-curriculum-packet ()
        ; `states/direct` is the first public axioms curriculum window. The
        ; packet itself carries the concept, variation and live provenance.
        (fkap-source-bound-hook "states" 0))
    (defn fka1l-curriculum-repair-prompt (plan first-check packet)
        ; The exact answer appears only after an independent candidate has
        ; failed and revise selected one supervised repair. It is never part
        ; of heldout or independent-attempt evidence.
        (fkg15-cat (list
            (fkg15-repair-prompt plan first-check)
            "\nTyped public-source curriculum packet follows."
            "\npacket-node=" (nth packet 2)
            "\nnothing-alternative-node=" (nth packet 4)
            "\nsource-bound-query=" (nth packet 8)
            "\npath-query=" (nth packet 9)
            "\npublic-prompt=" (nth packet 10)
            "\npublic-answer=" (nth packet 11)
            "\nsource=" (nth packet 12)
            "\nsource-id=" (nth packet 13)
            "\nconcept=" (nth packet 14)
            "\nvariation=" (nth packet 15))))

    ; diagnostic state = tag phases observations controls reobservations
    (defn fka1l-ds (phases observations controls reobservations)
        (list "axioms-live-diagnostic-state-v1" phases observations
              controls reobservations))
    (defn fka1l-ds-phases (d) (nth d 1))
    (defn fka1l-ds-observations (d) (nth d 2))
    (defn fka1l-ds-controls (d) (nth d 3))
    (defn fka1l-ds-reobservations (d) (nth d 4))
    ; diagnostic result = tag selected-next diagnostic-state
    (defn fka1l-diagnostic-result (next state)
        (list "axioms-live-diagnostic-result-v1" next state))
    (defn fka1l-diagnostic-next (r) (nth r 1))
    (defn fka1l-diagnostic-state (r) (nth r 2))
    (defn fka1l-diagnostic
        (state exchange phase issue source-sha observed-sha before after
         current alternative)
        (do
            (let out (fka1-diag-out exchange phase issue source-sha
                observed-sha before after alternative))
            (let out-event (bfc-record-out out (mul exchange 4)))
            (let observed (add (fka1l-ds-observations state) 1))
            (let phases (add (fka1l-ds-phases state) 1))
            (if (eq issue 0)
                (fka1l-diagnostic-result current
                    (fka1l-ds phases observed
                        (fka1l-ds-controls state)
                        (fka1l-ds-reobservations state)))
                (do
                    (let in (fka1-diag-in out phase issue))
                    (let in-event (bfc-record-in in (add (mul exchange 4) 1)))
                    (let selected (fka1-diag-next out in phase current alternative))
                    (let next (if (str_eq selected "request-evidence")
                        alternative selected))
                    (fka1l-diagnostic-result next
                        (fka1l-ds phases observed
                            (add (fka1l-ds-controls state) 1)
                            (fka1l-ds-reobservations state)))))))
    ; This is deliberately separate from decision. A caller invokes it only
    ; after the selected branch/revise/evidence/abstain state has gated or
    ; performed the next physical action.
    (defn fka1l-reobserve-after-action
        (state exchange phase source-sha observed-sha before after selected)
        (do
            (let out (fka1-diag-out (add exchange 5000) phase 0
                source-sha observed-sha before after selected))
            (let event (bfc-record-out out (add (mul exchange 4) 2)))
            (fka1l-ds (fka1l-ds-phases state)
                (add (fka1l-ds-observations state) 1)
                (fka1l-ds-controls state)
                (add (fka1l-ds-reobservations state) 1))))

    ; One explicit residence. fcmg owns each heldout/generative stream state,
    ; but it does not own or reopen this already-admitted context.
    (defn fka1l-open-residence (path maxpos)
        (do
            (let verdict (qaf-seal-verdict path))
            (if (not (eq verdict 1)) (fcmr-none)
                (do
                    (let src (fcmg-src path))
                    (let arch (fcmg-arch src))
                    (if (not (str_eq arch "qwen35")) (fcmr-none)
                        (do
                            (let ctx (q38-open path maxpos))
                            (if (not (eq (q38-context-ok? ctx) 1))
                                (do
                                    (let closed (if (lt (len ctx) 10) 0
                                        (q38-close ctx (empty))))
                                    (fcmr-none))
                                (fcmr path maxpos ctx src arch))))))))
    (defn fka1l-same-residence? (before after)
        (if (and (eq (fcmr-live? before) 1)
                 (eq (fcmr-live? after) 1))
            (fkpfm-equal? before after) 0))
    (defn fka1l-state-released-from-report (raw)
        (if (ge (str_find raw "\nstate_released=1\n" 0) 0) 1 0))

    ; ---- heldout lane ------------------------------------------------
    ; result = tag trial next-residence latency
    (defn fka1l-heldout-result (trial residence latency)
        (list "axioms-live-heldout-result-v1" trial residence latency))
    (defn fka1l-heldout-trial (r) (nth r 1))
    (defn fka1l-heldout-residence (r) (nth r 2))
    (defn fka1l-heldout-latency (r) (nth r 3))
    (defn fka1l-heldout
        (presentation residence path model-id run-id heldout-session-id)
        (do
            (let before-ms (now_unix_ms))
            (let generated (fcmg-generate-current-source-resident-at
                residence path (fkp30-presentation-prompt presentation)
                (fkp30-presentation-source presentation)))
            (let after-ms (now_unix_ms))
            (let raw (nth generated 0))
            (let next-residence (nth generated 1))
            ; Raw bytes are sealed before the expected row is reached.
            (let output-sha (nmfe-sha256 raw))
            (let nonce (fkp30-trial-nonce-for run-id heldout-session-id
                presentation))
            (let content-sha (fkp30-content-sha-for nonce raw))
            (let parsed (fkhe-parse-resident-output raw))
            (let row (fkhe-find-row
                (fkp30-presentation-row-id presentation) (fkhe-rows)))
            (let latency (sub after-ms before-ms))
            (let score (fkhe-score row
                (fqt-knowledge-prompt (fkhe-prompt row)) parsed latency))
            (let observation (fkhe-score-observation score))
            (let present (if (eq (nmfe-obs-error observation) 0) 1 0))
            (let zero (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "0"))) 1 0))
            (let one (if (and (eq present 1)
                (str_eq (nth score 8) (nmfe-sha256 "1"))) 1 0))
            (let trial (fkp30-trial presentation score model-id run-id
                heldout-session-id raw output-sha nonce content-sha 1 0
                (fht-report-int raw "heed_model_executed")
                (fka1l-state-released-from-report raw)
                (fka1l-same-residence? residence next-residence)
                (if (eq present 1) "value" "nothing") present zero one
                (fht-report-int raw "heed_query_tokens")
                (fht-report-int raw "heed_answer_tokens")
                (fht-report-int raw "generated_tokens")
                (fht-report-int raw "heed_hits")
                (fht-report-int raw "heed_misses")
                (fht-report-int raw "heed_nothings")
                (fht-report-int raw "heed_decode_timeout")
                (fht-report-int raw "heed_frame_refusals") latency))
            (fka1l-heldout-result trial next-residence latency)))
    (defn fka1l-heldout-issue (trial)
        (if (gt (fkp30-trial-timeout trial) 0) 3
        (if (eq (fkp30-trial-present trial) 0) 2
        (if (not (eq (fkp30-trial-valid? trial) 1)) 4
        (if (not (eq (fka1-trial-score95? trial) 1)) 1 0)))))

    ; ---- one generative attempt + optional repair -------------------
    ; result = tag attempt next-residence latency
    (defn fka1l-generative-result (attempt residence latency)
        (list "axioms-live-generative-result-v1" attempt residence latency))
    (defn fka1l-generative-attempt (r) (nth r 1))
    (defn fka1l-generative-residence (r) (nth r 2))
    (defn fka1l-generative-latency (r) (nth r 3))
    (defn fka1l-generate-attempt
        (plan index role lane parent prompt residence path model-id run-id
         generative-session-id)
        (do
            (let before-ms (now_unix_ms))
            (let generated (fcmg-generate-with-at-budgeted-hinted
                residence path prompt (fka1l-max-generative) 0 0 "full"
                (fkg15-plan-source plan)))
            (let after-ms (now_unix_ms))
            (let report (nth generated 0))
            (let raw (fka1l-after report "text:\n"))
            (let next-residence (nth generated 1))
            (let generated-tokens (fht-report-int report "generated_tokens"))
            (let forward-passes (fht-report-int report "forward_passes"))
            (let executed (if (and (gt generated-tokens 0)
                                   (gt forward-passes 0)) 1 0))
            (let latency (sub after-ms before-ms))
            (let attempt (fkg15-attempt plan index role lane parent prompt raw
                model-id run-id generative-session-id 1 0 executed
                (fkg15-report-state-released report)
                (fka1l-same-residence? residence next-residence) latency
                report generated-tokens forward-passes))
            (fka1l-generative-result attempt next-residence latency)))

    ; ---- native session shares the same context ---------------------
    (defn fka1l-native-prompt (binding)
        (fkfne-cat (list
            "You are in the native execution phase of the axioms window. "
            "Your first reply must be exactly the request bytes in this typed "
            "binding, with no leading/trailing byte, prose or duplicate frame.\n"
            (fkfne-teach-frame binding)
            "\nAfter the typed frex observation arrives, do not request again. "
            "Reply with one concise ASCII line beginning `native-held `.")))
    (defn fka1l-session-from-residence (residence prompt)
        (if (not (eq (fcmr-live? residence) 1))
            (fcms-none "residence-not-live")
            (do
                (let src (fcmr-src residence))
                (let ids (fcmg-chat-ids src prompt))
                (if (or (eq (len ids) 0)
                        (ge (len ids) (fcmr-maxpos residence)))
                    (fcms-none "native-initial-turn-refused")
                    (do
                        (let ctx (fcmr-ctx residence))
                        (let sts (q38-new-state (nth ctx 2)))
                        (if (not (eq (q38-state-ok? sts) 1))
                            (do
                                (let closed (q38-free-state sts))
                                (fcms-none "native-stream-state-refused"))
                            (do
                                (let pf (q38-prefill
                                    (nth ctx 0) (nth ctx 1) (nth ctx 2)
                                    (nth ctx 3) sts (nth ctx 4) (nth ctx 5)
                                    (nth ctx 6) ids 0))
                                (fcms-session "live" "shared-residence-opened"
                                    (fcmr-path residence) src ctx sts
                                    (fcmr-maxpos residence) (nth pf 1)
                                    (nth pf 0) 0 (len ids) 0 0 0))))))))
    (defn fka1l-partial-release
        (window residence run-id state phase pending-exchange pending-phase
         observed-sha)
        (do
            (let release-before (fbro-snapshot))
            (let released (fcmr-release-ok? residence))
            (let release-after (fbro-snapshot))
            (let release-stream (fka1l-stream-stage "partial-release" phase
                release-before release-after "release-ok" released
                (if (eq released 1) "released" "release-refused") 260))
            (let after-pending (if (gt pending-exchange 0)
                (fka1l-reobserve-after-action state pending-exchange
                    pending-phase (fkpfm-family-source-sha (fka1-family))
                    observed-sha 0 released "release") state))
            (let d (fka1l-diagnostic after-pending 1099 phase
                (if (eq released 1) 0 4)
                (fkpfm-family-source-sha (fka1-family))
                (nmfe-sha256 (int_to_str released)) 0 released
                "released" "release"))
            (let closed-state (if (eq released 1)
                (fka1l-diagnostic-state d)
                (fka1l-reobserve-after-action
                    (fka1l-diagnostic-state d) 1099 phase
                    (fkpfm-family-source-sha (fka1-family))
                    (nmfe-sha256 (int_to_str released)) released released
                    "release")))
            (fka1l-line "status" phase)
            (fka1l-line "run-id" run-id)
            (fka1l-int "release-ok" released)
            (let stream-report (fbro-close-stream window phase 0
                "observe/qwen38-axioms-one-family-complete-live-run.fk"
                271 7))
            (let stream-separator (print_str "\n"))
            (fka1l-int "framebuffer-events" (len (framebuffer-events)))
            (nothing)))
    (defn fka1l-run (path model-id)
        (do
            (let window (fbro-open-stream (fka1l-trace-id) "Sema"
                "embodies-one-family-window"
                "observe-teach-execute-reinject-release-and-reproject"
                "opaque-stage-counters-and-hashes" (file_size path)
                "observe/qwen38-axioms-one-family-complete-live-run.fk"
                279 7))
            (let open-separator (print_str "\n"))
            (let started (now_unix_ms))
            (let ds0 (fka1l-ds 0 0 0 0))
            (let binding (fkfne-binding-for-family (fka1-family) "metal"))
            (let curriculum-packet (fka1l-curriculum-packet))
            (let curriculum-valid (fkap-packet-valid? curriculum-packet))
            (let run-id (fka1l-run-id started model-id binding))
            (let open-before (fbro-snapshot))
            (let residence0 (fka1l-open-residence path (fka1l-maxpos)))
            (let open-after (fbro-snapshot))
            (let open-live (fcmr-live? residence0))
            (let open-stream (fka1l-stream-stage "context-open" "trace-begin"
                open-before open-after "context-live" open-live
                (if (eq open-live 1) "opened" "refused") 291))
            (let dopen (fka1l-diagnostic ds0 1001 "context-open"
                (if (eq open-live 1) 0 4)
                (fkfne-binding-source-sha binding)
                (nmfe-sha256 (if (eq open-live 1) "value" "nothing"))
                0 open-live "continue" "release"))
            (let ds1 (fka1l-diagnostic-state dopen))
            (if (not (eq open-live 1))
                (do
                    (let closed-ds (fka1l-reobserve-after-action ds1 1001
                        "context-open" (fkfne-binding-source-sha binding)
                        (nmfe-sha256 "nothing") 0 0 "release"))
                    (fka1l-line "status" "context-open-refused")
                    (fka1l-line "run-id" run-id)
                    (let stream-report (fbro-close-stream window
                        "context-open-refused" 0
                        "observe/qwen38-axioms-one-family-complete-live-run.fk"
                        307 7))
                    (let stream-separator (print_str "\n"))
                    (fka1l-int "framebuffer-events" (len (framebuffer-events)))
                    (nothing))
                (do
                    (let row (fkhe-find-row "h01" (fkhe-rows)))
                    (let presentations (fkp30-presentations-row row))
                    (let heldout-session-id
                        (fkp30-session-id-for run-id model-id))

                    (let ha-before (fbro-snapshot))
                    (let ha (fka1l-heldout (head presentations) residence0
                        path model-id run-id heldout-session-id))
                    (let ha-after (fbro-snapshot))
                    (let trial-a (fka1l-heldout-trial ha))
                    (let ha-stream (fka1l-stream-stage "heldout-a"
                        "context-open" ha-before ha-after "generated-tokens"
                        (fkp30-trial-generated-tokens trial-a)
                        (if (eq (fka1l-heldout-issue trial-a) 0)
                            "observed" "surprise") 329))
                    (let residence1 (fka1l-heldout-residence ha))
                    (let da (fka1l-diagnostic ds1 1002 "heldout-a"
                        (fka1l-heldout-issue trial-a) (fkhe-source-sha row)
                        (fkp30-trial-output-sha trial-a) 0
                        (fka1-trial-score95? trial-a)
                        "heldout-b" "heldout-b+curriculum"))
                    (let ds2 (fka1l-diagnostic-state da))
                    (let route-a (fka1-heldout-learning-route "heldout-a"
                        (fka1l-heldout-issue trial-a) curriculum-valid))

                    (let hb-before (fbro-snapshot))
                    (let hb (fka1l-heldout (nth presentations 1) residence1
                        path model-id run-id heldout-session-id))
                    (let hb-after (fbro-snapshot))
                    (let trial-b (fka1l-heldout-trial hb))
                    (let hb-stream (fka1l-stream-stage "heldout-b"
                        "heldout-a" hb-before hb-after "generated-tokens"
                        (fkp30-trial-generated-tokens trial-b)
                        (if (eq (fka1l-heldout-issue trial-b) 0)
                            "observed" "surprise") 349))
                    (let residence2 (fka1l-heldout-residence hb))
                    ; Lane b is the material next action selected after lane-a
                    ; surprise; only now can lane a be re-observed.
                    (let ds2a (if (eq (fka1l-heldout-issue trial-a) 0) ds2
                        (fka1l-reobserve-after-action ds2 1002 "heldout-a"
                            (fkhe-source-sha row)
                            (fkp30-trial-output-sha trial-b)
                            (fka1-trial-score95? trial-a)
                            (fka1-trial-score95? trial-b)
                            route-a)))
                    (let db (fka1l-diagnostic ds2a 1003 "heldout-b"
                        (fka1l-heldout-issue trial-b) (fkhe-source-sha row)
                        (fkp30-trial-output-sha trial-b) 0
                        (fka1-trial-score95? trial-b)
                        "generative" "curriculum"))
                    (let ds3 (fka1l-diagnostic-state db))
                    (let route-b (fka1-heldout-learning-route "heldout-b"
                        (fka1l-heldout-issue trial-b) curriculum-valid))
                    (let route-before (fbro-snapshot))
                    (let curriculum-selected (if (or
                        (ge (str_find route-a "curriculum" 0) 0)
                        (str_eq route-b "curriculum")) 1 0))
                    (let heldout-active (if (and
                        (not (str_eq route-a "release"))
                        (not (str_eq route-b "release"))) 1 0))
                    (let route-after (fbro-snapshot))
                    (let route-stream (fka1l-stream-stage
                        "heldout-control-actuated" "heldout-b" route-before
                        route-after "curriculum-selected" curriculum-selected
                        (if (eq heldout-active 1)
                            "learning-experiment" "release") 370))
                    (if (not (eq heldout-active 1))
                        (fka1l-partial-release window residence2 run-id ds3
                            "heldout-abstained"
                            (if (eq (fka1l-heldout-issue trial-b) 0) 0 1003)
                            "heldout-b" (fkp30-trial-output-sha trial-b))
                        (do
                    (let plan (fkg15-plan-for (fka1-family)))
                    (let generative-session-id
                        (fkg15-session-id-for run-id model-id))
                    (let gfirst-before (fbro-snapshot))
                    (let gfirst-result (fka1l-generate-attempt plan 1
                        "candidate" (fkg15-independent-lane)
                        (fkg15-plan-nonce plan) (fkg15-plan-prompt plan)
                        residence2 path model-id run-id generative-session-id))
                    (let gfirst-after (fbro-snapshot))
                    (let gfirst (fka1l-generative-attempt gfirst-result))
                    (let residence3 (fka1l-generative-residence gfirst-result))
                    (let first-pass
                        (fkg15-check-pass? (fkg15-attempt-check gfirst)))
                    (let gfirst-stream (fka1l-stream-stage
                        "generative-attempt" "heldout-b" gfirst-before
                        gfirst-after "generated-tokens"
                        (fkg15-attempt-generated-tokens gfirst)
                        (if (eq first-pass 1) "held" "repair-offered") 385))
                    ; Lane-b branch/request-evidence is re-observed only after
                    ; the selected learning experiment actually generated and
                    ; its candidate verifier ran.
                    (let ds3a (if (eq (fka1l-heldout-issue trial-b) 0) ds3
                        (fka1l-reobserve-after-action ds3 1003 "heldout-b"
                            (fkhe-source-sha row)
                            (fkg15-attempt-raw-sha gfirst)
                            (fka1-trial-score95? trial-b) first-pass route-b)))
                    (let dg (fka1l-diagnostic ds3a 1004
                        "generative-attempt" (if (eq first-pass 1) 0 4)
                        (fkg15-plan-source-sha plan)
                        (fkg15-attempt-raw-sha gfirst) 0 first-pass
                        "continue" "repair"))
                    (let ds4 (fka1l-diagnostic-state dg))
                    (let repair-selected
                        (if (and
                            (str_eq (fka1l-diagnostic-next dg) "repair")
                            (eq curriculum-valid 1)) 1 0))
                    (let grepair-before (fbro-snapshot))
                    (let grepair-result
                        (if (eq repair-selected 1)
                            (fka1l-generate-attempt plan 2 "repair"
                                (fkg15-supervised-lane)
                                (fkg15-check-sha (fkg15-attempt-check gfirst))
                                (fka1l-curriculum-repair-prompt plan
                                    (fkg15-attempt-check gfirst)
                                    curriculum-packet)
                                residence3 path model-id run-id
                                generative-session-id)
                            (nothing)))
                    (let grepair-after (fbro-snapshot))
                    (let grepair (if (nothing? grepair-result)
                        (nothing) (fka1l-generative-attempt grepair-result)))
                    (let residence4 (if (nothing? grepair-result)
                        residence3 (fka1l-generative-residence grepair-result)))
                    (let repair-pass (if (nothing? grepair) first-pass
                        (fkg15-check-pass? (fkg15-attempt-check grepair))))
                    (let grepair-stream (fka1l-stream-stage
                        (if (eq repair-selected 1) "generative-repair"
                            "generative-repair-skipped")
                        "generative-attempt" grepair-before grepair-after
                        "repair-executed" repair-selected
                        (if (eq repair-pass 1) "held" "refused") 423))
                    ; A revise control is re-observed only after the supervised
                    ; repair actually generated and its verifier ran.
                    (let ds4a (if (eq first-pass 1) ds4
                        (fka1l-reobserve-after-action ds4 1004
                            "generative-attempt" (fkg15-plan-source-sha plan)
                            (if (nothing? grepair)
                                (fkg15-attempt-raw-sha gfirst)
                                (fkg15-attempt-raw-sha grepair))
                            first-pass repair-pass
                            (fka1l-diagnostic-next dg))))
                    (let dr (fka1l-diagnostic ds4a 1005
                        (if (eq repair-selected 1)
                            "generative-repair" "generative-repair-skipped")
                        (if (and (eq repair-pass 1)
                                 (eq curriculum-valid 1)) 0 4)
                        (fkg15-plan-source-sha plan)
                        (if (nothing? grepair)
                            (fkg15-attempt-raw-sha gfirst)
                            (fkg15-attempt-raw-sha grepair))
                        first-pass repair-pass "continue" "release"))
                    (let ds5 (fka1l-diagnostic-state dr))
                    (let generative-row
                        (if (eq first-pass 1)
                            (fkg15-row plan gfirst (nothing)
                                (fkg15-independent-lane) 1)
                            (fkg15-row plan gfirst grepair
                                (fkg15-supervised-lane) 2)))
                    (let school-active (if
                        (str_eq (fka1l-diagnostic-next dr) "release") 0 1))
                    (if (not (eq school-active 1))
                        (fka1l-partial-release window residence4 run-id ds5
                            "generative-abstained"
                            (if (eq repair-pass 1) 0 1005)
                            "generative-repair"
                            (if (nothing? grepair)
                                (fkg15-attempt-raw-sha gfirst)
                                (fkg15-attempt-raw-sha grepair)))
                        (do
                    (let native-open-before (fbro-snapshot))
                    (let native-open (fka1l-session-from-residence residence4
                        (fka1l-native-prompt binding)))
                    (let native-open-after (fbro-snapshot))
                    (let native-open-stream (fka1l-stream-stage
                        "native-state-open" "generative-repair"
                        native-open-before native-open-after "state-live"
                        (fcms-live? native-open)
                        (if (eq (fcms-live? native-open) 1)
                            "opened" "refused") 458))
                    (let dnopen (fka1l-diagnostic ds5 1006
                        "native-state-open"
                        (if (eq (fcms-live? native-open) 1) 0 4)
                        (fkfne-binding-source-sha binding)
                        (nmfe-sha256 (fcms-status native-open)) 0
                        (fcms-live? native-open) "continue" "release"))
                    (let ds6 (fka1l-diagnostic-state dnopen))
                    (let native-active0 (if
                        (str_eq (fka1l-diagnostic-next dnopen) "release") 0 1))
                    (let native-generated (if (eq native-active0 1)
                        (fcms-generate native-open
                            (fka1l-max-native-request))
                        (fcms-generation "" (empty) native-open)))
                    ; The state-open refusal is re-observed only after the
                    ; selected release action has physically gated generation.
                    (let ds6a (if (eq (fcms-live? native-open) 1) ds6
                        (fka1l-reobserve-after-action ds6 1006
                            "native-state-open"
                            (fkfne-binding-source-sha binding)
                            (nmfe-sha256 "native-generation-gated") 1
                            native-active0 "release")))
                    (let native-generated-session
                        (fcms-generation-session native-generated))
                    (let emitted (fcms-generation-text native-generated))
                    (let parse-before (fbro-snapshot))
                    (let prep (fkfne-prepare binding emitted))
                    (let parse-after (fbro-snapshot))
                    (let prepared (fkfne-preparation-valid? prep))
                    (let parse-stream (fka1l-stream-stage "native-parse"
                        "native-state-open" parse-before parse-after
                        "scannerless-bytes" (str_len emitted)
                        (if (eq prepared 1) "exact" "refused") 493))
                    (let dp (fka1l-diagnostic ds6a 1007 "native-parse"
                        (if (eq native-active0 0) 0
                        (if (eq prepared 1) 0
                            (if (eq (str_len emitted) 0) 2 4)))
                        (fkfne-binding-source-sha binding)
                        (fkfne-prep-emitted-sha prep) (str_len emitted)
                        prepared (if (eq native-active0 1)
                            "continue" "release") "release"))
                    (let ds7 (fka1l-diagnostic-state dp))
                    (let native-active1 (if (and (eq native-active0 1)
                        (not (str_eq (fka1l-diagnostic-next dp) "release"))) 1 0))
                    (let executable (if (eq native-active1 1)
                        (fkfne-carrier-executable-now?
                            (fkfne-binding-carrier binding)) 0))
                    ; A parse refusal is re-observed only after the carrier
                    ; capability probe has been gated off.
                    (let ds7a (if (or (eq native-active0 0)
                                     (eq prepared 1)) ds7
                        (fka1l-reobserve-after-action ds7 1007 "native-parse"
                            (fkfne-binding-source-sha binding)
                            (fkfne-prep-emitted-sha prep) 1 native-active1
                            "release")))
                    (let dj (fka1l-diagnostic ds7a 1008 "native-jit"
                        (if (eq native-active1 0) 0
                            (if (and (eq prepared 1)
                                     (eq executable 1)) 0 4))
                        (fkfne-binding-source-sha binding)
                        (fkfne-binding-sha binding) prepared executable
                        (if (eq native-active1 1) "continue" "release")
                        "release"))
                    (let ds8 (fka1l-diagnostic-state dj))
                    (let native-active2 (if (and (eq native-active1 1)
                        (not (str_eq (fka1l-diagnostic-next dj) "release"))) 1 0))
                    ; The carrier is reachable only after exact raw-byte prep.
                    (let carrier-before (fbro-snapshot))
                    (let live (if (and (eq native-active2 1)
                        (and (eq prepared 1) (eq executable 1)))
                        (frexl-execute-request (fkfne-prep-request prep)
                            (frexl-cursor-bytes (fkfne-prep-cursor prep)))
                        (nothing)))
                    (let carrier-after (fbro-snapshot))
                    ; A JIT refusal is re-observed only after execution has
                    ; been materially skipped by native-active2.
                    (let ds8a (if (or (eq native-active1 0)
                        (and (eq prepared 1) (eq executable 1))) ds8
                        (fka1l-reobserve-after-action ds8 1008 "native-jit"
                            (fkfne-binding-source-sha binding)
                            (fkfne-binding-sha binding) 1 native-active2
                            "release")))
                    (let compact (if (nothing? live)
                        (frex-choice (fkfne-prep-request prep) (empty))
                        (frexl-result-as-frex (fkfne-prep-request prep) live)))
                    (let executed (if (nothing? live) 0
                        (frexl-result-executed? live)))
                    (let carrier-stream (fka1l-stream-stage
                        "native-jit+execute" "native-parse" carrier-before
                        carrier-after "carrier-executed" executed
                        (if (eq executed 1) "generated-and-executed"
                            "gated-or-refused") 544))
                    (let de (fka1l-diagnostic ds8a 1009 "native-execute"
                        (if (eq native-active2 0) 0
                        (if (nothing? live) 2
                            (if (str_eq (frex-result-status compact)
                                    "timeout") 3
                            (if (eq executed 1) 0 4))))
                        (fkfne-binding-source-sha binding)
                        (nmfe-sha256 (frex-render compact)) 0 executed
                        (if (eq native-active2 1) "continue" "release")
                        "release"))
                    (let ds9 (fka1l-diagnostic-state de))
                    (let native-active3 (if (and (eq native-active2 1)
                        (not (str_eq (fka1l-diagnostic-next de) "release"))) 1 0))
                    (let typed (frex-render compact))
                    (let inject-before (fbro-snapshot))
                    (let observed (if (eq native-active3 1)
                        (fcms-observe native-generated-session typed)
                        native-generated-session))
                    (let inject-after (fbro-snapshot))
                    (let reinjected (if (and (eq (fcms-live? observed) 1)
                        (gt (fcms-injected-ids observed) 0)) 1 0))
                    (let inject-stream (fka1l-stream-stage "native-reinject"
                        "native-jit+execute" inject-before inject-after
                        "injected-ids" (fcms-injected-ids observed)
                        (if (eq reinjected 1) "reinserted" "gated-or-refused")
                        584))
                    ; Execution failure is re-observed after reinjection was
                    ; physically gated, never from the pre-actuation frame.
                    (let ds9a (if (or (eq native-active2 0)
                                     (eq executed 1)) ds9
                        (fka1l-reobserve-after-action ds9 1009
                            "native-execute" (fkfne-binding-source-sha binding)
                            (nmfe-sha256 (frex-render compact)) 1
                            native-active3 "release")))
                    (let di (fka1l-diagnostic ds9a 1010 "native-reinject"
                        (if (eq native-active3 0) 0
                            (if (eq reinjected 1) 0 4))
                        (fkfne-binding-source-sha binding)
                        (nmfe-sha256 typed) 0 reinjected
                        (if (eq native-active3 1) "continue" "release")
                        "release"))
                    (let ds10 (fka1l-diagnostic-state di))
                    (let native-active4 (if (and (eq native-active3 1)
                        (not (str_eq (fka1l-diagnostic-next di) "release"))) 1 0))
                    (let resume-before (fbro-snapshot))
                    (let resumed-generation (if (eq native-active4 1)
                        (fcms-generate observed (fka1l-max-native-resume))
                        (fcms-generation "" (empty) observed)))
                    (let resume-after (fbro-snapshot))
                    (let resumed (fcms-generation-session resumed-generation))
                    (let native-same-context (if (and
                        (eq (fcms-resident? native-open) 1)
                        (eq (fcms-resident? resumed) 1))
                        (if (node_eq (head (fcmr-ctx residence4))
                                     (head (fcms-ctx resumed))) 1 0) 0))
                    (let native-same-state (if (and
                        (eq (fcms-resident? native-open) 1)
                        (eq (fcms-resident? resumed) 1))
                        (if (node_eq (head (fcms-sts native-open))
                                     (head (fcms-sts resumed))) 1 0) 0))
                    (let resumed-ok (if (gt (len
                        (fcms-generation-ids resumed-generation)) 0) 1 0))
                    (let resume-stream (fka1l-stream-stage "native-resume"
                        "native-reinject" resume-before resume-after
                        "generated-ids"
                        (len (fcms-generation-ids resumed-generation))
                        (if (eq resumed-ok 1) "resumed" "gated-or-nothing")
                        623))
                    ; Reinjection refusal is re-observed after the resume call
                    ; was gated, with the observed zero/nonzero id count.
                    (let ds10a (if (or (eq native-active3 0)
                                      (eq reinjected 1)) ds10
                        (fka1l-reobserve-after-action ds10 1010
                            "native-reinject"
                            (fkfne-binding-source-sha binding)
                            (nmfe-sha256 typed) 1 native-active4 "release")))
                    (let dm (fka1l-diagnostic ds10a 1011 "native-resume"
                        (if (eq native-active4 0) 0
                            (if (eq resumed-ok 1) 0 2))
                        (fkfne-binding-source-sha binding)
                        (nmfe-sha256 (fcms-generation-text resumed-generation))
                        0 resumed-ok
                        (if (eq native-active4 1) "continue" "release")
                        "release"))
                    (let ds11 (fka1l-diagnostic-state dm))

                    (let release-before (fbro-snapshot))
                    (let carrier-release (if (nothing? live) 0
                        (frexl-result-buffer-released? live)))
                    ; Once the native fcms state adopts the fcmr context it is
                    ; the final owner: fcms releases state+context together and
                    ; fcmr-release must not touch that context again. If state
                    ; adoption itself failed, fcmr still owns and releases it.
                    (let native-adopted (fcms-resident? native-open))
                    (let session-release (if (eq native-adopted 1)
                        (fcms-release-ok? resumed)
                        (fcmr-release-ok? residence4)))
                    (let release-ok (if (and (eq carrier-release 1)
                                             (eq session-release 1)) 1 0))
                    (let release-after (fbro-snapshot))
                    (let release-stream (fka1l-stream-stage "release"
                        "native-resume" release-before release-after
                        "release-ok" release-ok
                        (if (eq release-ok 1) "released" "refused") 665))
                    (let ds11a (if (or (eq native-active4 0)
                                      (eq resumed-ok 1)) ds11
                        (fka1l-reobserve-after-action ds11 1011
                            "native-resume" (fkfne-binding-source-sha binding)
