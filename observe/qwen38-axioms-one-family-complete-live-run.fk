                                         (eq native-same-state 1)) 1 0)
                                native-adopted session-release))
                        (list
                            (fka1-residence-transition "heldout-a"
                                (fkp30-trial-same-residence trial-a) 1
                                (fkp30-trial-state-released trial-a))
                            (fka1-residence-transition "heldout-b"
                                (fkp30-trial-same-residence trial-b) 1
                                (fkp30-trial-state-released trial-b))
                            (fka1-residence-transition "generative-attempt"
                                (fkg15-attempt-same-residence gfirst) 1
                                (fkg15-attempt-state-released gfirst))
                            (fka1-residence-transition "native-request"
                                (if (and (eq native-same-context 1)
                                         (eq native-same-state 1)) 1 0)
                                native-adopted session-release))))
                    (let residence-witness (fka1-residence-witness model-id
                        run-id residence-transitions opens reopens release-ok))
                    (let stream-report (fbro-close-stream window
                        (if (and (eq (fkav-result-ready? vertical) 1)
                                 (and (eq release-ok 1)
                                 (and (eq census-valid 1)
                                      (eq (fka1-residence-witness-valid?
                                          residence-witness) 1))))
                            "axioms-window-complete" "not-yet")
                        (nth census 2)
                        "observe/qwen38-axioms-one-family-complete-live-run.fk"
                        795 7))
                    (let stream-separator (print_str "\n"))
                    (let frames (len (fbro-events stream-report)))
                    (let diagnostics (fka1-diag-summary
                        (fka1l-ds-phases ds13a)
                        (fka1l-ds-observations ds13a)
                        (fka1l-ds-controls ds13a)
