                        (fkfne-binding-source-sha binding)
                        (nmfe-sha256 (nmfe-fields (list
                            (int_to_str carrier-release)
                            (int_to_str native-adopted)
                            (int_to_str session-release))))
                        0 release-ok "continue" "release"))
                    (let ds12 (fka1l-diagnostic-state dl))
                    (let ds12a (if (eq release-ok 1) ds12
                        (fka1l-reobserve-after-action ds12 1012 "release"
                            (fkfne-binding-source-sha binding)
                            (nmfe-sha256 "finalization-gated")
                            release-ok 0 "release")))

                    ; Projection is freshly read after release. Its exact ids,
                    ; total, source and source freshness are digest-bound; the
                    ; result names a denominator window, never a fixed target.
                    (let projection-before (fbro-snapshot))
                    (let census (fka1-census-snapshot))
                    (let projection-after (fbro-snapshot))
                    (let census-valid (fka1-census-snapshot-valid? census))
                    (let projection-sha (nth census 5))
                    (let projection-stream (fka1l-stream-stage
                        "projection-reobserve" "release" projection-before
                        projection-after "current-family-count" (nth census 2)
                        (if (eq census-valid 1)
                            "current-census-observed" "source-stale-or-refused")
                        708))
                    (let dproj (fka1l-diagnostic ds12a 1013
                        "projection-reobserve"
                        (if (eq census-valid 1) 0 4)
                        (nth census 4) projection-sha 0 (nth census 2)
                        "complete" "release"))
                    (let ds13 (fka1l-diagnostic-state dproj))
                    ; A stale/refused projection gates finalization; only that
                    ; material gate is then re-observed.
                    (let ds13a (if (eq census-valid 1) ds13
                        (fka1l-reobserve-after-action ds13 1013
                            "projection-reobserve" (nth census 4)
                            projection-sha 1 0 "release")))

                    (let generative-evidence
                        (fkg15-evidence-for-row generative-row release-ok))
                    (let native-check (fkfne-check binding prep compact
                        model-id run-id 0 release-ok))
                    (let execution-evidence
                        (fkfne-check-evidence native-check))
                    (let heldout (fka1-heldout-input trial-a trial-b))
                    (let vertical (fkav-result (list trial-a trial-b)
                        generative-evidence execution-evidence))
                    (let same-residence-all (fkfne-all? (list
                        (eq (fka1l-same-residence? residence0 residence1) 1)
                        (eq (fka1l-same-residence? residence1 residence2) 1)
                        (eq (fka1l-same-residence? residence2 residence3) 1)
                        (eq (fka1l-same-residence? residence3 residence4) 1)
                        (eq native-same-context 1)
                        (eq native-same-state 1))))
                    (let reopens (if (eq same-residence-all 1) 0 1))
                    (let opens (add 1 reopens))
                    ; This transition ledger is constructed from live trial,
                    ; attempt and native state/release values. Optional repair
                    ; has its own transition and cannot be replayed as attempt.
                    (let residence-transitions (if (eq repair-selected 1)
                        (list
                            (fka1-residence-transition "heldout-a"
                                (fkp30-trial-same-residence trial-a) 1
                                (fkp30-trial-state-released trial-a))
                            (fka1-residence-transition "heldout-b"
                                (fkp30-trial-same-residence trial-b) 1
                                (fkp30-trial-state-released trial-b))
                            (fka1-residence-transition "generative-attempt"
