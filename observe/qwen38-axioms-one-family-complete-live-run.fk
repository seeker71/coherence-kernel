                    (fka1l-line "status" (if (eq
                        (fka1-crossing-valid? crossing) 1)
                        "axioms-window-complete" "not-yet"))
                    (fka1l-line "run-id" run-id)
                    (fka1l-line "heldout-a-sha"
                        (fkp30-trial-output-sha trial-a))
                    (fka1l-line "heldout-b-sha"
                        (fkp30-trial-output-sha trial-b))
                    (fka1l-int "generative-repair-executed" repair-selected)
                    (fka1l-line "curriculum-packet-node" (nth curriculum-packet 2))
                    (fka1l-line "curriculum-source-id" (nth curriculum-packet 13))
                    (fka1l-int "curriculum-valid" curriculum-valid)
                    (fka1l-line "generative-final-sha"
                        (fkg15-attempt-raw-sha
                            (fkg15-row-final-attempt generative-row)))
                    (fka1l-line "native-request-sha"
                        (fkfne-prep-emitted-sha prep))
                    (fka1l-line "native-result-sha"
                        (nmfe-sha256 typed))
                    (fka1l-int "model-context-opens" opens)
                    (fka1l-int "model-context-reopens" reopens)
                    (fka1l-int "native-same-context" native-same-context)
                    (fka1l-int "native-same-state" native-same-state)
                    (fka1l-int "remote-calls" 0)
                    (fka1l-int "release-ok" release-ok)
                    (fka1l-int "framebuffer-events" frames)
                    (fka1l-int "framebuffer-controls"
                        (fka1l-ds-controls ds13a))
                    (fka1l-int "framebuffer-reobservations"
                        (fka1l-ds-reobservations ds13a))
                    (fka1l-line "residence-witness-sha"
                        (nth residence-witness 9))
                    (fka1l-line "residence-auth-seam"
                        (fka1-residence-auth-seam))
                    (fka1l-int "current-family-count" (nth census 2))
                    (fka1l-line "current-census-source" (nth census 3))
                    (fka1l-line "current-census-freshness" (nth census 4))
                    (fka1l-line "projection-sha" projection-sha)
                    (fka1l-int "fkav-valid" (fkav-result-valid? vertical))
                    (fka1l-int "fkav-ready" (fkav-result-ready? vertical))
                    (fka1l-int "crossing-valid"
                        (fka1-crossing-valid? crossing))
                    crossing))))))))

    ; Intentionally dormant. A carrier owner invokes fka1l-run explicitly.
    0)
