// Prints the six ask lanes with the concept frequency and the token ids
// the standing answer model actually uses.
import form-stdlib/query-lane-native.bml;
import form-stdlib/model-registry.bml;
section [form.bml] {
    def qlnr-src() = eqr-of-file(mr-path(mr-find("qwen38-q8")), 0, 40000000);
    def qlnr-print(src, ls) = (Comparable) len(ls) == 0 ? 0 : {
        print(qln-line(src, ls[0]));
        qlnr-print(src, ls[1:]);
    };
    def qlnr-main() = {
        let src = qlnr-src();
        qlnr-print(src, qln-lanes());
        print("aligned=" + (qln-aligned?().str() + (" vocab-tokens=" + qln-vocab-tokens?(src).str())));
        0;
    };
    qlnr-main();
}
