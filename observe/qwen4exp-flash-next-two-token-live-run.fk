; Two resident tokens separate first-touch paging from warm decode.
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk form-stdlib/model-registry.bml

(do
    (let prefix (mr-flash-next-prefix))
    (let t0 (now_unix_ms))
    (let ctx (q4t-open prefix 16))
    (let t1 (now_unix_ms))
    (let out1 (q4t-forward ctx 9419 0 248046 248046))
    (let t2 (now_unix_ms))
    (let status1 (metal_status))
    (let out2 (q4t-forward ctx out1 1 9419 248046))
    (let t3 (now_unix_ms))
    (let status2 (metal_status))
    (q4t-close ctx)
    (list "qwen4exp-two-token"
        (list "open-ms" (sub t1 t0))
        (list "token1" out1 "ms" (sub t2 t1))
        (list "token2" out2 "ms" (sub t3 t2))
        (list "status-after-token1" status1)
        (list "status-after-token2" status2)))
