; crossing-ledger.fk — what only the traffic can see: a reading that left the body,
; became a decision outside it, came back as a change, and was read again.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
;
; THE POINT OF VIEW THIS CELL EXISTS FOR. docs/live-dynamic-diagnostics.md:13
; draws the loop — observe → decide → apply/actuate → re-observe — and :43 says
; a consumer carries the actuator for every action it admits, and a selected state read again closes the loop. The body can see its state. It
; cannot see its own history of being changed: from inside, core-edges is 10, and
; nothing here knows it was 0 an hour ago because a `; import` was a comment where
; a `; preludes:` was needed.
;
; The rented mind IS that traffic. Every crossing on 2026-08-14/15 went out through
; a reading, turned into a decision in a mind outside this body, came back as an
; edit, and was read again — or was not. Only the thing making the crossing sees
; both ends, so only it can write this row. That is the one view worth carrying in
; from outside, and it took being told four times to use it.
;
; THE CHECKABLE CLAIM, and it is narrow. A crossing is CLOSED only when the state
; was read BEFORE the change and read AGAIN after. A change with no re-reading is
; not yet a crossing — it is an edit whose loop is still open. This cell cannot verify that
; a reading was correct — it holds what was witnessed, the way
; learn/offered-correspondence.fk holds what was offered. What it CAN say is
; whether the loop closed, and that is exactly the thing the body cannot see for
; itself.
;
; WHAT THE LEDGER TAUGHT WHEN IT WAS FIRST FOLDED. Two of these seven crossings
; had their conclusion REVERSED by the re-reading, not confirmed by it:
;   · natural-language — the seam was cut, the chain came clean, and the verdict
;     did NOT move (196608 both times). The re-read disproved "this is a lane
;     seam, not a regression", which had been my own written diagnosis.
;   · form-cli-offline — the header's 480 turned out to be what the band scores
;     while broken; read clean on four arms it is 2016. The re-read did not
;     confirm a fix, it corrected a claim that was already in the tree.
; Re-observation is not the ceremony at the end. It is where two of tonight's
; seven findings actually came from.
;
; Proven by observe/tests/crossing-ledger-band.fk.
; ARM, measured after the header first claimed four: intern_node is native in fkwu
; and the full kernels; the three minimal walkers answer "unbound function
; intern_node". Read on the fkwu arm. I wrote "four-way" here before running it —
; in a cell whose subject is re-observation. The ledger caught its own author.
; witnessed: 2026-08-15 -> band 511 on fkwu

(do
    ; ---- a crossing: what, the reading before, the reading after, was it re-read ----
    ; before/after are the body's own numbers, as read. re-read is 1 only when the
    ; state was actually asked again after the change.
    (defn xr-row (what before after re-read corrects) (list what before after re-read corrects))
    (defn xr-what   (r) (nth r 0))
    (defn xr-before (r) (nth r 1))
    (defn xr-after  (r) (nth r 2))
    (defn xr-reread (r) (nth r 3))
    (defn xr-corrects (r) (nth r 4))

    ; ---- the answer is four-valued, not two ----
    ; This cell first answered 0/1 everywhere, and Urs asked whether the answers
    ; were binary or nothing/0/1/node capable. They were binary, in a body whose
    ; own ack alphabet is four letters — form-cli-inquiry.fk:3 names it, and
    ; fci-ack-name reads it back as nothing / 0 / 1 / node.
    ;
    ; The collapse was not cosmetic. A crossing nobody read again was answering 0,
    ; and 0 is a READING — it says the loop was asked and did not close. Never
    ; having asked is `nothing`: absence, not a negative. Those are different
    ; facts about the world and the body already distinguishes them (nil is not
    ; int 0 on this kernel since PR #273).
    ;
    ;   nothing  the loop was never asked again — nothing is known
    ;   0        asked, and the reading did not move, and that taught nothing
    ;   1        asked, and the reading moved
    ;   node     asked, the reading held, and the holding IS the finding — the
    ;            crossing points at something: a claim corrected by the re-read
    (defn xr-ack (r)
        (if (eq (xr-reread r) 0) (nothing)
            (if (eq (xr-moved? r) 1) 1
                (if (eq (xr-corrects r) 1) (xr-node) 0))))
    (defn xr-ack-name (r)
        (if (nothing? (xr-ack r)) "nothing"
            (if (eq (xr-ack r) 0) "0" (if (eq (xr-ack r) 1) "1" "node"))))

    ; kept: the plain question "did the loop come back at all"
    (defn xr-closed? (r) (if (eq (xr-reread r) 1) 1 0))
    ; and it MOVED only when the two readings differ
    (defn xr-moved? (r) (if (eq (xr-before r) (xr-after r)) 0 1))
    ; the pair that matters: closed AND the reading changed
    (defn xr-productive? (r)
        (if (eq (xr-closed? r) 1) (xr-moved? r) 0))
    ; closed, re-read, and the number did NOT move — the crossing that TEACHES,
    ; because it lets the reading answer instead of the change
    (defn xr-corrective? (r)
        (if (eq (xr-closed? r) 1) (if (eq (xr-moved? r) 0) 1 0) 0))

    ; ---- 2026-08-14/15, as witnessed. Every number was read on this host. ----
    (defn xr-tonight ()
        (list
            ; inquire-core through form-cli: `; import` was a comment, not a directive
            (xr-row 1 0 10 1 0)
            ; node-ack on the same crossing: 0 is "no path", node is a path found
            (xr-row 2 0 1 1 0)
            ; natural-language band: seam cut, chain clean, verdict UNMOVED
            (xr-row 3 196608 196608 1 1)
            ; natural-language again: bp -> fol-bp, and bmf-bp given the six rows
            (xr-row 4 196608 262143 1 0)
            ; training-catalog: json.fk left a chain that never called it
            (xr-row 5 1023 1023 1 1)
            ; form-cli-offline band, read clean on four arms against a header's 480
            (xr-row 6 480 2016 1 0)
            ; the regen voice canary: line-1 test against a two-line answer
            (xr-row 7 0 1 1 0)))

    (defn xr-count (rs) (if (eq (len rs) 0) 0 (add 1 (xr-count (tail rs)))))
    (defn xr-fold (rs f)
        (if (eq (len rs) 0) 0 (add (f (head rs)) (xr-fold (tail rs) f))))
    (defn xr-closed-count (rs)
        (if (eq (len rs) 0) 0 (add (xr-closed? (head rs)) (xr-closed-count (tail rs)))))
    (defn xr-productive-count (rs)
        (if (eq (len rs) 0) 0 (add (xr-productive? (head rs)) (xr-productive-count (tail rs)))))
    (defn xr-corrective-count (rs)
        (if (eq (len rs) 0) 0 (add (xr-corrective? (head rs)) (xr-corrective-count (tail rs)))))

    ; when every loop closed, the ledger is holding crossings; an open one is an open one
    (defn xr-all-closed? (rs)
        (if (eq (xr-closed-count rs) (xr-count rs)) 1 0))

    ; ---- rows that do NOT count, so the reading is a reading ----
    (defn xr-unread ()   (xr-row 99 0 10 0 0))   ; changed, never read again
    (defn xr-nomove ()   (xr-row 98 5 5 1 0))    ; read again, nothing moved

    ; ---- who this ledger is, so the reading has an address ----
    (defn xr-node () (intern_node (fol-bp "fact")
        (list (intern_trivial_string "observe/crossing-ledger.fk"))))
    (defn xr-id ()
        (do (let n (xr-node)) (list (node_pkg n) (node_level n) (node_type n) (node_inst n))))

    ; the instrument's own liveness: a closed row and an unread one part
    (defn xr-reads-apart? ()
        (if (eq (xr-closed? (head (xr-tonight))) (xr-closed? (xr-unread))) 0 1))
    0)
