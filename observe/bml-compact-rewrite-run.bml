// bml-compact-rewrite-run.bml — the long spellings become the compact surface, one NodeID at a time.
//
// Inside each contract section (form.bml, form.route, form.action) this door rewrites
//   c  str_concat(a, b)                     ->  a ++ b
//   i  nth(xs, i)                           ->  xs[i]
//   o  lt gt le ge add sub mul div mod and or not calls  ->  the operator (eq stays: == is value_eq)
//   t  if c then a else b                   ->  c ? a : b      (layout kept: only the keywords change)
//   n  if nothing?(x) then d else x         ->  x ?? d
//   p  a group (e) standing where a delimiter stands  ->  e
//   m  mc-cat(list(a, b, c)) (also sv-cat, rg-cat)  ->  a ++ b ++ c   (runs alone)
// and keeps a rewritten section only when it lowers to the very NodeID the old spelling lowered to.
// Pass m keeps a section when it lowers to the NodeID of the same text written as the right fold the
// cat functions define, str_concat(a, str_concat(b, c)); the empty string that fold ends on is a
// string ++ "" and drops away, so the bands own that one step.
// A section whose whole rewrite lowers differently is retried one pass at a time, so one stubborn
// site never holds the rest. The passes read through masks: strings, characters and comments are
// never touched, an operand that carries a comment leaves its site as it was, and a name standing
// after def is a definition, never a call.
//
// stdin, one line: `check` or `apply`, the pass letters (order-free, e.g. cionpt), then paths.
//                  `probe <letters>` then a section body on the following lines prints the rewrite.
// preludes: form-stdlib/source-compiler.fk form-stdlib/meaning-codes.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class BmlCompactRewrite {
  // ---- bytes and classes
  def bcr-byte(s, i) = (i >= 0 && i < str_len(s)) ? str_byte_at(s, i) : 0;
  def bcr-ws?(c) = c == 32 || c == 9 || c == 10 || c == 13;
  def bcr-alnum?(c) = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
  def bcr-name?(c) = bcr-alnum?(c) || c == 45 || c == 63 || c == 33;
  def bcr-before-name?(c) = bcr-alnum?(c) || c == 45 || c == 63 || c == 46 || c == 36;
  def bcr-oper?(c) = c == 124 || c == 62 || c == 63 || c == 38 || c == 61 || c == 33 || c == 60 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 46 || c == 58;
  def bcr-min(a, b) = (a < 0) ? b : (b < 0) ? a : (a < b) ? a : b;
  def bcr-on?(on, letter) = str_find(on, letter, 0) >= 0;
  def bcr-name-end(sk, i, hi) = (i < hi && bcr-name?(bcr-byte(sk, i))) ? bcr-name-end(sk, (i + 1), hi) : i;
  def bcr-oper-end(sk, i, hi) = (i < hi && bcr-oper?(bcr-byte(sk, i))) ? bcr-oper-end(sk, (i + 1), hi) : i;
  def bcr-fwd-ws(sk, i) = (i < str_len(sk) && bcr-ws?(bcr-byte(sk, i))) ? bcr-fwd-ws(sk, (i + 1)) : i;
  def bcr-back-ws(sk, k) = (k < 0) ? -1 : bcr-ws?(bcr-byte(sk, k)) ? bcr-back-ws(sk, (k - 1)) : k;
  def bcr-trim-end(sk, lo, hi) = (hi <= lo) ? lo : bcr-ws?(bcr-byte(sk, (hi - 1))) ? bcr-trim-end(sk, lo, (hi - 1)) : hi;

  // ---- the skeleton: same length as the text; strings and characters read `a`, comments read `#`
  def bcr-rep(ch, n) {
   let half = (n > 1) ? bcr-rep(ch, (n / 2)) : "";
   (n <= 0) ? "" : (n == 1) ? ch : (half ++ half ++ ((n % 2 == 1) ? ch : ""));
  }
  def bcr-event(s, i) = bcr-min(bcr-min(str_find(s, "\"", i), str_find(s, "'", i)), bcr-min(str_find(s, "//", i), str_find(s, "/*", i)));
  def bcr-backslashes(s, k, floor) = (k > floor && bcr-byte(s, k) == 92) ? (1 + bcr-backslashes(s, (k - 1), floor)) : 0;
  def bcr-quote-from(s, i, floor) {
   let q = str_find(s, "\"", i);
   (q < 0) ? str_len(s) : (bcr-backslashes(s, (q - 1), floor) % 2 == 1) ? bcr-quote-from(s, (q + 1), floor) : (q + 1);
  }
  def bcr-char-end(s, e) {
   let q = str_find(s, "'", (e + ((bcr-byte(s, (e + 1)) == 92) ? 3 : 2)));
   (q < 0) ? str_len(s) : (q + 1);
  }
  def bcr-line-end(s, e) {
   let q = str_find(s, "\n", e);
   (q < 0) ? str_len(s) : q;
  }
  def bcr-block-end(s, e) {
   let q = str_find(s, "*/", (e + 2));
   (q < 0) ? str_len(s) : (q + 2);
  }
  def bcr-skel-at(s, i, e, pieces) {
   let c = str_byte_at(s, e);
   let x = (c == 34) ? bcr-quote-from(s, (e + 1), e) : (c == 39) ? bcr-char-end(s, e) : (bcr-byte(s, (e + 1)) == 47) ? bcr-line-end(s, e) : bcr-block-end(s, e);
   let ch = (c == 34 || c == 39) ? "a" : "#";
   bcr-skel-go(s, x, cons(bcr-rep(ch, (x - e)), cons(fsc-sub(s, i, e), pieces)));
  }
  def bcr-skel-go(s, i, pieces) {
   let e = bcr-event(s, i);
   (e < 0) ? cons(fsc-sub(s, i, str_len(s)), pieces) : bcr-skel-at(s, i, e, pieces);
  }
  def bcr-skel(s) = str-join-reversed(bcr-skel-go(s, 0, list()));

  // ---- groups: the index of the closer that matches the opener at i (hi when there is none)
  def bcr-close-go(sk, i, hi, depth) {
   let c = bcr-byte(sk, i);
   (i >= hi) ? hi
   : (c == 40 || c == 91 || c == 123) ? bcr-close-go(sk, (i + 1), hi, (depth + 1))
   : (c == 41 || c == 93 || c == 125) ? ((depth == 1) ? i : bcr-close-go(sk, (i + 1), hi, (depth - 1)))
   : bcr-close-go(sk, (i + 1), hi, depth);
  }
  def bcr-close-any(sk, i, hi) = bcr-close-go(sk, (i + 1), hi, 1);
  def bcr-commas(sk, i, hi, depth, acc) {
   let c = bcr-byte(sk, i);
   (i >= hi) ? reverse(acc)
   : (c == 40 || c == 91 || c == 123) ? bcr-commas(sk, (i + 1), hi, (depth + 1), acc)
   : (c == 41 || c == 93 || c == 125) ? bcr-commas(sk, (i + 1), hi, (depth - 1), acc)
   : (c == 44 && depth == 0) ? bcr-commas(sk, (i + 1), hi, depth, cons(i, acc))
   : bcr-commas(sk, (i + 1), hi, depth, acc);
  }

  // ---- the strength of a text's outermost operator: 99 an atom, 20 unary, 2..18 an operator,
  //      0 a ternary/lambda/keyword form, -1 not one expression (a comment, a comma, a stray byte)
  def bcr-op-prec(op) = str_eq(op, "|>") ? 2 : str_eq(op, "??") ? 4 : str_eq(op, "||") ? 6 : str_eq(op, "&&") ? 8 : (str_eq(op, "==") || str_eq(op, "!=")) ? 10 : (str_eq(op, "<") || str_eq(op, ">") || str_eq(op, "<=") || str_eq(op, ">=")) ? 12 : str_eq(op, "..") ? 14 : (str_eq(op, "+") || str_eq(op, "-")) ? 16 : str_eq(op, "++") ? 17 : (str_eq(op, "*") || str_eq(op, "/") || str_eq(op, "%")) ? 18 : str_eq(op, ".") ? 100 : 0;
  def bcr-op-of(w) = str_eq(w, "lt") ? "<" : str_eq(w, "gt") ? ">" : str_eq(w, "le") ? "<=" : str_eq(w, "ge") ? ">=" : str_eq(w, "add") ? "+" : str_eq(w, "sub") ? "-" : str_eq(w, "mul") ? "*" : str_eq(w, "div") ? "/" : str_eq(w, "mod") ? "%" : str_eq(w, "and") ? "&&" : str_eq(w, "or") ? "||" : "";
  def bcr-keyword-lead?(sk, lo, hi) = str_find(" if try choose choice match let defer using ", (" " ++ fsc-sub(sk, lo, bcr-name-end(sk, lo, hi)) ++ " "), 0) >= 0;
  def bcr-prec-op(sk, i, lo, hi, best) {
   let r = bcr-oper-end(sk, i, hi);
   let op = fsc-sub(sk, i, r);
   let p = bcr-op-prec(op);
   (str_eq(op, "!") && i == lo) ? bcr-prec-go(sk, r, lo, hi, ((20 < best) ? 20 : best))
   : (p == 100) ? bcr-prec-go(sk, r, lo, hi, best)
   : (p == 0) ? 0
   : bcr-prec-go(sk, r, lo, hi, ((p < best) ? p : best));
  }
  def bcr-prec-go(sk, i, lo, hi, best) {
   let c = bcr-byte(sk, i);
   (i >= hi) ? best
   : bcr-ws?(c) ? bcr-prec-go(sk, (i + 1), lo, hi, best)
   : bcr-alnum?(c) ? bcr-prec-go(sk, bcr-name-end(sk, i, hi), lo, hi, best)
   : (c == 40 || c == 91 || c == 123) ? bcr-prec-go(sk, (bcr-close-any(sk, i, hi) + 1), lo, hi, best)
   : bcr-oper?(c) ? bcr-prec-op(sk, i, lo, hi, best)
   : -1;
  }
  def bcr-prec(t) {
   let sk = bcr-skel(t);
   let lo = bcr-fwd-ws(sk, 0);
   let hi = bcr-trim-end(sk, lo, str_len(sk));
   (hi <= lo) ? -1 : bcr-keyword-lead?(sk, lo, hi) ? 0 : bcr-prec-go(sk, lo, lo, hi, 99);
  }
  def bcr-fits?(p, op, right) {
   (p < 0) ? false
   : (op == 17) ? (right ? (p == 17 || p >= 18) : p >= 18)
   : (op == 16) ? (right ? p >= 18 : (p == 16 || p >= 18))
   : (op == 10 || op == 12) ? p > op
   : right ? p > op : p >= op;
  }

  // ---- operands
  def bcr-unparen(t) {
   let sk = bcr-skel(t);
   let n = str_len(sk);
   (n >= 2 && bcr-byte(sk, 0) == 40 && bcr-close-any(sk, 0, n) == (n - 1) && bcr-prec(fsc-sub(t, 1, (n - 1))) >= 0) ? bcr-unparen(trim(fsc-sub(t, 1, (n - 1)))) : t;
  }
  def bcr-fit(t, op, right) {
   let u = bcr-unparen(t);
   bcr-fits?(bcr-prec(u), op, right) ? u : ("(" ++ u ++ ")");
  }
  def bcr-cond(t) {
   let u = bcr-unparen(t);
   (bcr-prec(u) >= 1) ? u : ("(" ++ u ++ ")");
  }
  def bcr-branch(t) = (bcr-prec(t) <= 0) ? ("(" ++ t ++ ")") : t;
  def bcr-gap(w) = (str_find(w, "\n", 0) >= 0) ? w : " ";
  def bcr-operand-text(t) = (bcr-prec(t) < 0) ? nothing() : t;
  def bcr-operand(s, sk, on, a, b) {
   let lo = bcr-fwd-ws(sk, a);
   let hi = bcr-trim-end(sk, lo, b);
   (lo >= b || hi <= lo || bcr-byte(sk, (hi - 1)) == 35) ? nothing() : bcr-operand-text(bcr-rw(fsc-sub(s, lo, hi), on));
  }

  // ---- the context of a site: may a compound text stand there without parentheses?
  def bcr-kw-before?(sk, k) {
   let m = bcr-word-start(sk, k);
   let w = fsc-sub(sk, m, (k + 1));
   str_eq(w, "then") || str_eq(w, "else") || str_eq(w, "if");
  }
  def bcr-word-start(sk, k) = (k > 0 && bcr-name?(bcr-byte(sk, (k - 1)))) ? bcr-word-start(sk, (k - 1)) : k;
  def bcr-kw-at?(sk, k) {
   let w = fsc-sub(sk, k, bcr-name-end(sk, k, str_len(sk)));
   str_eq(w, "then") || str_eq(w, "else");
  }
  def bcr-open-ctx?(sk, i) {
   let k = bcr-back-ws(sk, (i - 1));
   let c = bcr-byte(sk, k);
   let d = bcr-byte(sk, (k - 1));
   (k < 0) ? true
   : (c == 40 || c == 44 || c == 91 || c == 59) ? true
   : (c == 61) ? !(d == 61 || d == 33 || d == 60 || d == 62)
   : (c == 62) ? (d == 61)
   : bcr-name?(c) ? bcr-kw-before?(sk, k)
   : false;
  }
  def bcr-close-ctx?(sk, e) {
   let k = bcr-fwd-ws(sk, e);
   let c = bcr-byte(sk, k);
   (k >= str_len(sk)) ? true
   : (c == 41 || c == 44 || c == 93 || c == 125 || c == 59) ? true
   : bcr-alnum?(c) ? bcr-kw-at?(sk, k)
   : false;
  }
  // a rewritten site as (text, end): parenthesised where its neighbours would misread it,
  // and left alone (nothing) where a chain continues straight after it
  def bcr-finish(sk, i, end, text, atom) {
   let nxt = bcr-byte(sk, end);
   (nxt == 46 || nxt == 91 || nxt == 40) ? (atom ? list(text, end) : nothing())
   : (atom || (bcr-open-ctx?(sk, i) && bcr-close-ctx?(sk, end))) ? list(text, end)
   : list(("(" ++ text ++ ")"), end);
  }

  // ---- call sites: str_concat, the operator names, not, nth
  def bcr-binary-args(sk, i, close, op, l, r) {
   (nothing?(l) || nothing?(r)) ? nothing()
   : bcr-finish(sk, i, (close + 1), (bcr-fit(l, bcr-op-prec(op), false) ++ " " ++ op ++ " " ++ bcr-fit(r, bcr-op-prec(op), true)), false);
  }
  def bcr-binary(s, sk, on, i, j, op) {
   let n = str_len(sk);
   let close = bcr-close-any(sk, j, n);
   let cs = bcr-commas(sk, (j + 1), close, 0, list());
   (str_eq(op, "") || close >= n || len(cs) != 1) ? nothing()
   : bcr-binary-args(sk, i, close, op, bcr-operand(s, sk, on, (j + 1), head(cs)), bcr-operand(s, sk, on, (head(cs) + 1), close));
  }
  def bcr-index-args(sk, i, close, base, idx) {
   let bu = nothing?(base) ? "" : bcr-unparen(base);
   (nothing?(base) || nothing?(idx) || bcr-prec(bu) != 99 || bcr-byte(bu, 0) == 40) ? nothing()
   : bcr-finish(sk, i, (close + 1), (bu ++ "[" ++ bcr-unparen(idx) ++ "]"), true);
  }
  def bcr-index(s, sk, on, i, j) {
   let n = str_len(sk);
   let close = bcr-close-any(sk, j, n);
   let cs = bcr-commas(sk, (j + 1), close, 0, list());
   (close >= n || len(cs) != 1) ? nothing()
   : bcr-index-args(sk, i, close, bcr-operand(s, sk, on, (j + 1), head(cs)), bcr-operand(s, sk, on, (head(cs) + 1), close));
  }
  def bcr-not-arg(sk, i, close, a) {
   (nothing?(a)) ? nothing()
   : bcr-finish(sk, i, (close + 1), ("!" ++ ((bcr-prec(bcr-unparen(a)) == 99) ? bcr-unparen(a) : ("(" ++ bcr-unparen(a) ++ ")"))), false);
  }
  def bcr-not(s, sk, on, i, j) {
   let n = str_len(sk);
   let close = bcr-close-any(sk, j, n);
   (close >= n || !nil?(bcr-commas(sk, (j + 1), close, 0, list()))) ? nothing()
   : bcr-not-arg(sk, i, close, bcr-operand(s, sk, on, (j + 1), close));
  }

  // ---- if c then a else b: the ends of c, a and b found at their own depth, nested ifs counted off
  //      mode 1 finds our then, mode 2 our else, mode 3 the end of the else branch
  def bcr-kw-word(sk, i, n, pt, pe, mode) {
   let j = bcr-name-end(sk, i, n);
   let span = j - i;
   let w = (span >= 2 && span <= 4) ? fsc-sub(sk, i, j) : "";
   (bcr-byte(sk, (i - 1)) == 46) ? bcr-kw-scan(sk, j, n, 0, pt, pe, mode)
   : str_eq(w, "if") ? bcr-kw-scan(sk, j, n, 0, (pt + 1), (pe + 1), mode)
   : str_eq(w, "try") ? bcr-kw-scan(sk, j, n, 0, pt, (pe + 1), mode)
   : str_eq(w, "then") ? ((pt > 0) ? bcr-kw-scan(sk, j, n, 0, (pt - 1), pe, mode) : (mode == 1 || mode == 3) ? i : -1)
   : str_eq(w, "else") ? ((pe > 0) ? bcr-kw-scan(sk, j, n, 0, pt, (pe - 1), mode) : (mode == 2 || mode == 3) ? i : -1)
   : bcr-kw-scan(sk, j, n, 0, pt, pe, mode);
  }
  def bcr-kw-scan(sk, i, n, depth, pt, pe, mode) {
   let c = bcr-byte(sk, i);
   (i >= n) ? ((mode == 3) ? n : -1)
   : (c == 40 || c == 91 || c == 123) ? bcr-kw-scan(sk, (i + 1), n, (depth + 1), pt, pe, mode)
   : (c == 41 || c == 93 || c == 125) ? ((depth == 0) ? ((mode == 3) ? i : -1) : bcr-kw-scan(sk, (i + 1), n, (depth - 1), pt, pe, mode))
   : (depth == 0 && (c == 44 || c == 59)) ? ((mode == 3) ? i : -1)
   : (depth == 0 && bcr-alnum?(c)) ? bcr-kw-word(sk, i, n, pt, pe, mode)
   : bcr-kw-scan(sk, (i + 1), n, depth, pt, pe, mode);
  }
  def bcr-plain(w) = (w != "" && bcr-alpha?(bcr-byte(w, 0)) && bcr-all-name?(w, 0)) ? w : "";
  def bcr-alpha?(c) = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
  def bcr-all-name?(w, i) = (i >= str_len(w)) ? true : bcr-name?(bcr-byte(w, i)) && bcr-all-name?(w, (i + 1));
  def bcr-nothing-arg(t) {
   let n = str_len(t);
   (n > 10 && str_eq(fsc-sub(t, 0, 9), "nothing?(") && bcr-byte(t, (n - 1)) == 41) ? bcr-plain(trim(fsc-sub(t, 9, (n - 1)))) : "";
  }
  def bcr-if-text(s, sk, on, th, el, alo, ahi, blo, bhi, c, a, b) {
   let name = bcr-nothing-arg(bcr-unparen(c));
   (bcr-on?(on, "n") && name != "" && str_eq(name, bcr-unparen(b))) ? list((name ++ " ?? " ++ bcr-fit(a, 4, true)), bhi)
   : !bcr-on?(on, "t") ? nothing()
   : list((bcr-cond(c) ++ bcr-gap(fsc-sub(s, bcr-trim-end(sk, 0, th), th)) ++ "?" ++ bcr-gap(fsc-sub(s, (th + 4), alo)) ++ bcr-branch(a) ++ bcr-gap(fsc-sub(s, ahi, el)) ++ ":" ++ bcr-gap(fsc-sub(s, (el + 4), blo)) ++ b), bhi);
  }
  def bcr-if-parts(s, sk, on, j, th, el, en) {
   let c = bcr-operand(s, sk, on, j, th);
   let a = bcr-operand(s, sk, on, (th + 4), el);
   let b = bcr-operand(s, sk, on, (el + 4), en);
   let alo = bcr-fwd-ws(sk, (th + 4));
   let blo = bcr-fwd-ws(sk, (el + 4));
   (nothing?(c) || nothing?(a) || nothing?(b)) ? nothing()
   : bcr-if-text(s, bcr-blank-to(sk, j, th), on, th, el, alo, bcr-trim-end(sk, alo, el), blo, bcr-trim-end(sk, blo, en), c, a, b);
  }
  def bcr-blank-to(sk, j, th) = fsc-sub(sk, j, th);
  def bcr-if(s, sk, on, i, j) {
   let n = str_len(sk);
   let th = bcr-kw-scan(sk, j, n, 0, 0, 0, 1);
   let el = (th < 0) ? -1 : bcr-kw-scan(sk, (th + 4), n, 0, 0, 0, 2);
   let en = (el < 0) ? -1 : bcr-kw-scan(sk, (el + 4), n, 0, 0, 0, 3);
   (en < 0) ? nothing() : bcr-if-parts(s, sk, on, j, th, el, en);
  }

  // ---- mc-cat(list(a, b, c)): pass m writes the chain, pass M the right fold the chain must equal
  def bcr-cat-word?(w) = str_find(" mc-cat sv-cat rg-cat ", (" " ++ w ++ " "), 0) >= 0;
  def bcr-cat-list(sk, j) {
   let lo = bcr-fwd-ws(sk, (j + 1));
   str_eq(fsc-sub(sk, lo, (lo + 5)), "list(") ? (lo + 4) : -1;
  }
  def bcr-cat-operands(s, sk, on, a, cs, inner) {
   let b = nil?(cs) ? inner : head(cs);
   let got = bcr-operand(s, sk, on, a, b);
   let text = nothing?(got) ? "" : got;
   nil?(cs) ? list(text) : cons(text, bcr-cat-operands(s, sk, on, (b + 1), tail(cs), inner));
  }
  def bcr-cat-whole?(ops) = nil?(ops) ? true : (str_len(head(ops)) > 0 && bcr-cat-whole?(tail(ops)));
  def bcr-cat-chain(ops) = nil?(tail(ops)) ? bcr-fit(head(ops), 17, true) : (bcr-fit(head(ops), 17, false) ++ " ++ " ++ bcr-cat-chain(tail(ops)));
  def bcr-cat-fold(ops) = nil?(tail(ops)) ? head(ops) : ("str_concat(" ++ head(ops) ++ ", " ++ bcr-cat-fold(tail(ops)) ++ ")");
  def bcr-cat-parts(sk, i, outer, twin, ops) {
   (!bcr-cat-whole?(ops)) ? nothing()
   : bcr-finish(sk, i, (outer + 1), (twin ? bcr-cat-fold(ops) : bcr-cat-chain(ops)), false);
  }
  def bcr-cat-spans(s, sk, on, i, twin, lp, outer, inner) {
   let cs = bcr-commas(sk, (lp + 1), inner, 0, list());
   (nil?(cs) || bcr-fwd-ws(sk, (inner + 1)) != outer) ? nothing()
   : bcr-cat-parts(sk, i, outer, twin, bcr-cat-operands(s, sk, on, (lp + 1), cs, inner));
  }
  def bcr-cat(s, sk, on, i, j, twin) {
   let n = str_len(sk);
   let lp = bcr-cat-list(sk, j);
   let outer = bcr-close-any(sk, j, n);
   let inner = (lp < 0) ? n : bcr-close-any(sk, lp, n);
   (lp < 0 || outer >= n || inner >= outer) ? nothing() : bcr-cat-spans(s, sk, on, i, twin, lp, outer, inner);
  }

  // ---- the scan: every word at a token boundary that opens a rewritable site
  def bcr-site(s, sk, on, w, i, j) {
   let open = bcr-byte(sk, j) == 40;
   str_eq(w, "if") ? ((bcr-on?(on, "t") || bcr-on?(on, "n")) ? bcr-if(s, sk, on, i, j) : nothing())
   : !open ? nothing()
   : bcr-cat-word?(w) ? (bcr-on?(on, "m") ? bcr-cat(s, sk, on, i, j, false) : bcr-on?(on, "M") ? bcr-cat(s, sk, on, i, j, true) : nothing())
   : str_eq(w, "str_concat") ? (bcr-on?(on, "c") ? bcr-binary(s, sk, on, i, j, "++") : nothing())
   : str_eq(w, "nth") ? (bcr-on?(on, "i") ? bcr-index(s, sk, on, i, j) : nothing())
   : !bcr-on?(on, "o") ? nothing()
   : str_eq(w, "not") ? bcr-not(s, sk, on, i, j)
   : bcr-binary(s, sk, on, i, j, bcr-op-of(w));
  }
  def bcr-site-word?(w) = bcr-cat-word?(w) || str_find(" if str_concat nth lt gt le ge add sub mul div mod and or not ", (" " ++ w ++ " "), 0) >= 0;
  def bcr-def-head?(sk, i) {
   let k = bcr-back-ws(sk, (i - 1));
   let m = bcr-word-start(sk, k);
   k >= 0 && k < (i - 1) && str_eq(fsc-sub(sk, m, (k + 1)), "def");
  }
  def bcr-scan-word(s, sk, on, i, j, from, pieces) {
   let w = fsc-sub(sk, i, j);
   let site = (bcr-site-word?(w) && !bcr-before-name?(bcr-byte(sk, (i - 1))) && !bcr-def-head?(sk, i)) ? bcr-site(s, sk, on, w, i, j) : nothing();
   nothing?(site) ? bcr-scan(s, sk, on, j, from, pieces)
   : bcr-scan(s, sk, on, site[1], site[1], cons(site[0], cons(fsc-sub(s, from, i), pieces)));
  }
  def bcr-scan(s, sk, on, i, from, pieces) {
   let n = str_len(sk);
   (i >= n) ? cons(fsc-sub(s, from, n), pieces)
   : bcr-alnum?(bcr-byte(sk, i)) ? bcr-scan-word(s, sk, on, i, bcr-name-end(sk, i, n), from, pieces)
   : bcr-scan(s, sk, on, (i + 1), from, pieces);
  }
  def bcr-rw(text, on) = str-join-reversed(bcr-scan(text, bcr-skel(text), on, 0, 0, list()));

  // ---- groups (e) where a delimiter stands on both sides lose their parentheses
  def bcr-pgroup(t, sk, i, from, pieces) {
   let n = str_len(sk);
   let j = bcr-close-any(sk, i, n);
   (j >= n || bcr-byte(sk, j) != 41) ? bcr-pscan(t, sk, (i + 1), from, pieces)
   : bcr-pgroup-inner(t, sk, i, j, from, pieces, bcr-parens(fsc-sub(t, (i + 1), j)));
  }
  def bcr-pgroup-inner(t, sk, i, j, from, pieces, inner) {
   let strip = bcr-close-ctx?(sk, (j + 1)) && bcr-prec(inner) >= 1;
   bcr-pscan(t, sk, (j + 1), (j + 1), cons((strip ? trim(inner) : ("(" ++ inner ++ ")")), cons(fsc-sub(t, from, i), pieces)));
  }
  def bcr-pscan(t, sk, i, from, pieces) {
   let n = str_len(sk);
   (i >= n) ? cons(fsc-sub(t, from, n), pieces)
   : (bcr-byte(sk, i) == 40 && bcr-open-ctx?(sk, i)) ? bcr-pgroup(t, sk, i, from, pieces)
   : bcr-pscan(t, sk, (i + 1), from, pieces);
  }
  def bcr-parens(t) = str-join-reversed(bcr-pscan(t, bcr-skel(t), 0, 0, list()));
  def bcr-apply(body, on) {
   let scanned = bcr-rw(body, on);
   bcr-on?(on, "p") ? bcr-parens(scanned) : scanned;
  }

  // ---- one section body: rewritten as far as its reading holds
  def bcr-typed(body) = head(fsc-bml-typed(fbl-lower(g-parse-full(form-bml-section-grammar(), body)), list(), list()));
  def bcr-reading(body) = try bcr-typed(body) else intern_trivial_string("BCR-STOP");
  def bcr-stop?(r) = node_eq(r, intern_trivial_string("BCR-STOP"));
  def bcr-holds?(base, text) = node_eq(base, bcr-reading(text));
  def bcr-each(body, base, order, i, on, cur) {
   let letter = fsc-sub(order, i, (i + 1));
   let cand = bcr-apply(body, (on ++ letter));
   (i >= str_len(order)) ? list(cur, ((on == "") ? "same" : ("part " ++ on)))
   : (!str_eq(cand, cur) && bcr-holds?(base, cand)) ? bcr-each(body, base, order, (i + 1), (on ++ letter), cand)
   : bcr-each(body, base, order, (i + 1), on, cur);
  }
  def bcr-body-try(body, base, passes) {
   let all = bcr-apply(body, passes);
   str_eq(all, body) ? list(body, "same")
   : bcr-holds?(base, all) ? list(all, "whole")
   : bcr-each(body, base, bcr-order(passes, "ncioptm", 0), 0, "", body);
  }
  def bcr-order(passes, canon, i) = (i >= str_len(canon)) ? "" : ((bcr-on?(passes, fsc-sub(canon, i, (i + 1))) ? fsc-sub(canon, i, (i + 1)) : "") ++ bcr-order(passes, canon, (i + 1)));
  def bcr-body(body, passes) {
   let base = bcr-reading(bcr-on?(passes, "m") ? bcr-apply(body, "M") : body);
   bcr-stop?(base) ? list(body, "stop") : bcr-body-try(body, base, passes);
  }

  // ---- files: every contract section, everything else as it was
  def bcr-note-count(notes, kind) = nil?(notes) ? 0 : ((str_find(head(notes), kind, 0) == 0) ? 1 : 0) + bcr-note-count(tail(notes), kind);
  def bcr-section(src, i, pos, pieces, notes, passes) {
   let dend = fsc-find-char-from(src, "]", (pos + 9));
   let dialect = fsc-sub(src, (pos + 9), dend);
   let brace = fsc-find-char-from(src, "{", dend);
   let close = fsc-high-level-form-dialect?(dialect) ? fsc-bml-block-end(src, (brace + 1), 0) : fsc-section-end(src, (brace + 1));
   let lead = cons(fsc-sub(src, i, (brace + 1)), pieces);
   fsc-bml-contract-dialect?(dialect) ? bcr-section-body(src, close, lead, notes, passes, bcr-body(fsc-sub(src, (brace + 1), close), passes))
   : bcr-source(src, close, cons(fsc-sub(src, (brace + 1), close), lead), notes, passes);
  }
  def bcr-section-body(src, close, lead, notes, passes, got) = bcr-source(src, close, cons(got[0], lead), cons(got[1], notes), passes);
  def bcr-source(src, i, pieces, notes, passes) {
   let pos = fsc-find-section-open(src, i);
   (pos < 0) ? list(cons(fsc-sub(src, i, str_len(src)), pieces), notes) : bcr-section(src, i, pos, pieces, notes, passes);
  }
  def bcr-report(path, src, out, notes, verb) = print_str("[bml-compact] " ++ path ++ " sections=" ++ int_to_str(len(notes)) ++ " whole=" ++ int_to_str(bcr-note-count(notes, "whole")) ++ " part=" ++ int_to_str(bcr-note-count(notes, "part")) ++ " same=" ++ int_to_str(bcr-note-count(notes, "same")) ++ " stop=" ++ int_to_str(bcr-note-count(notes, "stop")) ++ " bytes=" ++ int_to_str(str_len(src)) ++ ">" ++ int_to_str(str_len(out)) ++ verb);
  def bcr-file(path, apply, passes) {
   let src = read_file(path);
   let got = bcr-source(src, 0, list(), list(), passes);
   let out = str-join-reversed(got[0]);
   let changed = !str_eq(out, src);
   let wrote = (apply && changed) ? write_file(path, out) : 0;
   let kept = (apply && changed) ? str_eq(read_file(path), out) : true;
   bcr-report(path, src, out, got[1], ((apply && changed) ? (kept ? " written" : " WRITE-DIFFERS") : ""));
   changed ? 1 : 0;
  }
  def bcr-files(paths, apply, passes) = nil?(paths) ? 0 : (bcr-file(head(paths), apply, passes) + bcr-files(tail(paths), apply, passes));
  def bcr-words(s) {
   let sp = str_find(s, " ", 0);
   (str_len(s) == 0) ? list() : (sp < 0) ? list(s) : cons(fsc-sub(s, 0, sp), bcr-words(trim(fsc-sub(s, (sp + 1), str_len(s)))));
  }
  def bcr-probe(passes, body) {
   let got = bcr-body(body, passes);
   print_str(got[0]);
   print_str("-- " ++ got[1]);
   0;
  }
  def bcr-run() {
   let text = stdin-text();
   let nl = str_find(text, "\n", 0);
   let first = (nl < 0) ? trim(text) : trim(fsc-sub(text, 0, nl));
   let words = bcr-words(first);
   str_eq(words[0], "probe") ? bcr-probe(words[1], fsc-sub(text, (nl + 1), str_len(text)))
   : bcr-files(tail(tail(words)), str_eq(words[0], "apply"), words[1]);
  }
 }
 bcr-run();
}
