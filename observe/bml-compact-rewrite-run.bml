// bml-compact-rewrite-run.bml — the long spellings become the compact surface, one NodeID at a time.
// The passes and their gate live in form-stdlib/bml/bml-compact-rewrite.bml.
//
// stdin, one line: `check` or `apply`, the pass letters (order-free, e.g. cionpt), then paths.
//                  `probe <letters>` then a section body on the following lines prints the rewrite.
// preludes: form-stdlib/bml/bml-compact-rewrite.bml
section [form.bml] {
 bcr-run();
}
