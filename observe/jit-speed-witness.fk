; jit-speed-witness.fk — how fast is the JIT optimizing, measured live.
; (altitude note: a standalone observe cell in the .fk running idiom;
; the stdlib mechanism it measures stays BML/Form.)
;
; One recipe, two bodies: the walker's Form twin and the arm64 leaf
; door's SSA rows (tags 1..5, u32 domain — the door's declared coverage,
; from jit-arm64-leaf-band). poly(n) = ((n*n+3n)*n - 7)*n + 11, nine
; rows, the leaf band's own example: poly(n) = ((n²+3)·n − 7)·n + 11.
;
; Answers list(walker-ms, jit-first-ms, jit-hot-ms, calls,
;              speedup-x10, worklist-covered):
;   walker-ms    N interpreted calls
;   jit-first-ms first crystallized call (build + run)
;   jit-hot-ms   N hot calls through the kept page
;   speedup-x10  walker-ms*10 / jit-hot-ms (integer, 10 = 1.0x)
;   worklist-covered  how many of today's .fkwu-heat hot recipes the
;                     door could take (str ops are outside tags 1..5,
;                     so this reads 0 until lowering coverage grows —
;                     the number IS the frontier, printed not implied)
; preludes: form-stdlib/core.fk
(do
    (defn jsw-poly (n)
        (add (mul (sub (mul (add (mul n n) 3) n) 7) n) 11))
    (defn jsw-prog ()
        (list (list 2) (list 5 0 0) (list 1 3) (list 3 1 2) (list 5 3 0)
              (list 1 7) (list 4 4 5) (list 5 6 0) (list 1 11) (list 3 7 8)))
    (defn jsw-walk-loop (i n acc)
        (if (ge i n) acc (jsw-walk-loop (add i 1) n (add acc (jsw-poly (mod i 97))))))
    (defn jsw-jit-loop (i n acc prog)
        (if (ge i n) acc (jsw-jit-loop (add i 1) n (add acc (jit_arm64_u32_leaf prog 9 (mod i 97))) prog)))
    (defn jsw-covered (heat) 0)
    (let calls 400000)
    (let t0 (now_unix_ms))
    (let wsum (jsw-walk-loop 0 calls 0))
    (let t1 (now_unix_ms))
    (let first (jit_arm64_u32_leaf (jsw-prog) 9 5))
    (let t2 (now_unix_ms))
    (let jsum (jsw-jit-loop 0 calls 0 (jsw-prog)))
    (let t3 (now_unix_ms))
    (let wms (sub t1 t0))
    (let jms (sub t3 t2))
    (list wms (sub t2 t1) jms calls
          (div (mul wms 10) (if (le jms 0) 1 jms))
          (if (eq wsum jsum) (jsw-covered "") -1)))
