; hearth-ask-send.fk — the discovering client: reads the BOARD, verifies
; the server stands, and sends — no paths told, no session knowledge.
; stdin lines: turn, kind, body text. A turn of 0 (or blank) asks the
; BODY for the next number (max turn on the task spool + 1) — hand-minted
; numbers collided when a killed sender's frame already sat on the spool
; (witnessed 2026-09-01, turn 9701 answered twice-asked).
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk
(do
    (let turn0 (str_to_int (read_line)))
    (let turn (if (le turn0 0) (add (lms-max-turn (read_file (hearth-task))) 1) turn0))
    (let kind (read_line))
    (let body (read_line))
    (if (eq (hearth-standing) 0)
        (do (print "signal=nothing") (print "reason=no-standing-hearth") 0)
        (do
            (let frame (str_concat (fcpa-task-frame turn kind body) "\n"))
            (let appended (sbt-append (hearth-task) frame))
            (let rung (sbt-ring (hearth-bell)))
            (print (str_concat "sent turn=" (str_concat (int_to_str turn)
                (str_concat " to-pid=" (int_to_str (hearth-board-pid))))))
            0)))
