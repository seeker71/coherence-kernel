; hearth-ask-send.fk — the discovering client: reads the BOARD, verifies
; the server stands, and sends — no paths told, no session knowledge.
; stdin lines: turn, kind, body text.
; preludes: form-stdlib/hearth.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk
(do
    (let turn (str_to_int (read_line)))
    (let kind (read_line))
    (let body (read_line))
    (if (eq (hearth-standing) 0)
        (do (print "signal=nothing") (print "reason=no-standing-hearth") 0)
        (do
            (let frame (str_concat (fcpa-task-frame turn kind body) "\n"))
            (let appended (sbt-append (hearth-task) frame))
            (let rung (sbt-ring (hearth-bell)))
            (print (str_concat "sent turn=" (str_concat (int_to_str turn)
                (str_concat " to-pid=" (int_to_str (hearth-board-pid))))))
            0)))
