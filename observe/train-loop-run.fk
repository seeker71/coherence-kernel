; train-loop-run.fk — the whole loop, one run: the body observes its own
; model, decides by its own rules, and executes its own directive.
; preludes: learn/train-loop-observe.fk learn/train-loop-execute.fk
(do
    (defn tlrun-say (k v) (print (str_concat k (str_concat v "\n"))))
    (let adapter "/Users/ursmuff/.coherence-network/form-train-runs/homecoming-corpus-adapter-20260826-2030-calibrated")
    (let fused "/Users/ursmuff/.coherence-network/form-train-runs/form-llama-3b-fused-20260826")
    (print "observing (the body asks its own model)...\n")
    (let o (tlo-observe adapter 6))
    (if (nothing? o) (print "observe: nothing — model unreachable\n")
        (do
            (tlrun-say "  format-pm  " (int_to_str (tlr-format o)))
            (tlrun-say "  facts-pm   " (int_to_str (tlr-facts o)))
            (tlrun-say "  fabri-pm   " (int_to_str (tlr-fabri o)))
            (tlrun-say "  abstain-pm " (int_to_str (tlr-abstain o)))
            (let d (tlr-decide o))
            (if (nothing? d) (print "decide: nothing — a mind is needed here\n")
                (do (tlrun-say "decide     " d)
                    (let r (tle-execute d adapter fused))
                    (if (nothing? r) (print "execute: nothing (no emitter for this directive)\n")
                        (tlrun-say "execute    " r))))))
    0)
