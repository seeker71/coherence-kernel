; qwen38-bmf-live-run.fk — the SPEND-baseline live crossing (2026-08-24,
; witnessed: 9m55.7s, S1=1 S2=1 S3=abstain S4=1, choice=3 cut=2 undo=1).
; Every turn re-encodes the whole transcript and re-admits the file; the
; ledger of that double-spend lives in the receipts. The reuse driver
; (qwen38-bmf-live-reuse-run.fk) runs the same movement without it.
;
; preludes: observe/qwen38-bmf-mechanism.fk

(do
    ; ---- the live movement -------------------------------------------------
    (let t0 (now_unix_ms))
    (let g1 (qbl-gen (fcmr-none) (qbl-prompt1) 220))
    (let t1 (now_unix_ms))
    (let text1 (nth g1 0))
    (let s0 (qbl-say "=== turn 1: the model's grammar, verbatim ==="))
    (let s1 (qbl-say text1))
    (let s2 (qbl-say (str_concat "turn1_wall_ms=" (int_to_str (sub t1 t0)))))
    (let low1 (qbl-lower text1))
    (let m1 (if (str_eq (nth low1 0) "ok")
                (qbl-run-match (nth low1 1) (nth low1 2) (nth low1 3) 500)
                (list (nothing) (list 500 0 0 0))))
    (let fb1 (qbl-feedback low1 m1))
    (let s3 (qbl-say (str_concat "[feedback->model] " fb1)))
    (let prompt2 (str_concat (qbl-prompt1)
                 (str_concat "\n\nYou wrote:\n" (str_concat text1
                 (str_concat "\n\nForm observed:\n" (str_concat fb1
                 "\n\nIf the observation shows a defect, output only the corrected grammar block. If your grammar is already correct, or you cannot correct it, reply with exactly: abstain"))))))
    (let t2 (now_unix_ms))
    (let g2 (qbl-gen (nth g1 1) prompt2 220))
    (let t3 (now_unix_ms))
    (let text2 (nth g2 0))
    (let s4 (qbl-say "=== turn 2: the model's reply, verbatim ==="))
    (let s5 (qbl-say text2))
    (let s6 (qbl-say (str_concat "turn2_wall_ms=" (int_to_str (sub t3 t2)))))
    (let abstained (if (ge (str_find text2 "abstain" 0) 0) 1 0))
    (let low2 (if (eq abstained 1) (list "abstained" (empty) "" "") (qbl-lower text2)))
    (let m2 (if (str_eq (nth low2 0) "ok")
                (qbl-run-match (nth low2 1) (nth low2 2) (nth low2 3) 500)
                (list (nothing) (list 500 0 0 0))))
    (let rel (if (eq (fcmr-release-ok? (nth g2 1)) 1) 1 0))
    (let s7 (qbl-say "=== scored observation (not a law) ==="))
    (let s8 (qbl-say (str_concat "S1_turn1_lowered="
        (if (str_eq (nth low1 0) "ok") "1" (nth low1 0)))))
    (let s9 (qbl-say (str_concat "S2_turn1_verdict=" (qbl-verdict-str (nth m1 0)))))
    (let s10 (qbl-say (str_concat "S3_turn2="
        (if (eq abstained 1) "abstain"
            (if (str_eq (nth low2 0) "ok")
                (str_concat "corrected_verdict=" (qbl-verdict-str (nth m2 0)))
                (nth low2 0))))))
    (let s11 (qbl-say (str_concat "S4_residence_released=" (int_to_str rel))))
    0)
