; walk-home-glass-run.fk — put the observed walk on Glass.
; preludes: form/form-stdlib/walk-home.fk form/form-stdlib/form-fs.fk form/form-stdlib/hearth.bml

(do
    (let epoch (now_unix_ms))
    (let glass (wh-publish-glass (hearth-telemetry-root) epoch))
    (print (list "walk-home-glass"
        "status" (nth glass 1)
        "publisher" "walk-home"
        "samples" (nth glass 3)
        "economy" (wh-walk-economy (wh-this-walk))
        "body-home" (wh-home-body?)
        "voice-home" (wh-home-voice?)))
    (if (str_eq (nth glass 1) "published") 1 0))
