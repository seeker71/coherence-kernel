; framebuffer-runtime-live-stream.fk -- the bounded live-stream subset of
; framebuffer-runtime-observation.fk.
;
; The complete observation/report/bottleneck body remains in
; observe/framebuffer-runtime-observation.fk. This cell extracts only the five
; public calls needed while an expensive resident movement is underway:
; fbro-snapshot, fbro-open-stream, fbro-stage-observed-stream,
; fbro-close-stream and fbro-events. Event and report shapes match the complete
; body. This cell carries only what a live movement reads, so the Qwen
; physical closure preludes the door without the analysis tail. No runtime
; meaning moved into C.
;
; preludes: form/form-stdlib/core.fk

(do
    (defn fbrols-cat (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (fbrols-cat (tail parts)))))
    (defn fbrols-io-count ()
        (sum (list
            (kernel_stat 160) (kernel_stat 161) (kernel_stat 162)
            (kernel_stat 163) (kernel_stat 204) (kernel_stat 205)
            (kernel_stat 207) (kernel_stat 218) (kernel_stat 219)
            (kernel_stat 220) (kernel_stat 221) (kernel_stat 222)
            (kernel_stat 223) (kernel_stat 224) (kernel_stat 225)
            (kernel_stat 226) (kernel_stat 233) (kernel_stat 234)
            (kernel_stat 235) (kernel_stat 236) (kernel_stat 302)
            (kernel_stat 305) (kernel_stat 306) (kernel_stat 307)
            (kernel_stat 308) (kernel_stat 309) (kernel_stat 310)
            (kernel_stat 311) (kernel_stat 312) (kernel_stat 313)
            (kernel_stat 314) (kernel_stat 316) (kernel_stat 317)
            (kernel_stat 318) (kernel_stat 319) (kernel_stat 320)
            (kernel_stat 321) (kernel_stat 322) (kernel_stat 323)
            (kernel_stat 334) (kernel_stat 335) (kernel_stat 336)
            (kernel_stat 337))))
    ; Exact complete-body snapshot shape: time, dispatch, distinct, hottest,
    ; nodes, strings, arena, stack, floats, observable I/O.
    (defn fbro-snapshot ()
        (do
            (let time (now_unix_ms))
            (let distinct (kernel_stat 1))
            (let hot-tag (kernel_stat 2))
            (let hot-count (kernel_stat 3))
            (let nodes (kernel_stat 4))
            (let strings (kernel_stat 5))
            (let arena (kernel_stat 6))
            (let stack (kernel_stat 7))
            (let floats (kernel_stat 8))
            (let io (fbrols-io-count))
            (let dispatches (kernel_stat 0))
            (list time dispatches distinct hot-tag hot-count nodes strings
                arena stack floats io)))
    (defn fbrols-marker
        (phase trace actor relation why offer stamp file line col)
        (intern_node_at (bp "FRAMEBUFFER-RUNTIME-EVENT")
            (list (intern_trivial_string phase)
                  (intern_trivial_string trace)
                  (intern_trivial_string actor)
                  (intern_trivial_string relation)
                  (intern_trivial_string why)
                  (intern_trivial_string offer)
                  (intern_trivial_int stamp)) file line col))
    (defn fbro-open-stream
        (trace actor relation why offer input-bytes file line col)
        (do
            (framebuffer-clear)
            (let before (fbro-snapshot))
            (let begin (fbrols-marker "begin" trace actor relation why offer
                (nth before 0) file line col))
            (let window (list "framebuffer-window" trace actor relation why
                offer input-bytes file line col before begin))
            (print_str (fbrols-cat (list
                "FRAMEBUFFER BEGIN trace=" trace " actor=" actor
                " relation=" relation " why=" why " offer=" offer
                " source=" file ":" (int_to_str line) ":"
                (int_to_str col) " input-bytes="
                (int_to_str input-bytes))))
            window))
    (defn fbro-stage-observed-stream
        (trace stage parent actor relation why offer before after metric value
         outcome file line col)
        (do
            (let event (intern_node_at
                (bp "FRAMEBUFFER-RUNTIME-STAGE-OBSERVED")
                (list (intern_trivial_string "stage")
                      (intern_trivial_string trace)
                      (intern_trivial_string stage)
                      (intern_trivial_string parent)
                      (intern_trivial_string actor)
                      (intern_trivial_string relation)
                      (intern_trivial_string why)
                      (intern_trivial_string offer)
                      (intern_trivial_int (nth before 0))
                      (intern_trivial_int (nth after 0))
                      (intern_trivial_int (sub (nth after 0) (nth before 0)))
                      (intern_trivial_string metric)
                      (intern_trivial_int value)
                      (intern_trivial_string outcome)
                      (intern_trivial_string "duration-ms")
                      (intern_trivial_int (sub (nth after 0) (nth before 0)))
                      (intern_trivial_string "dispatches")
                      (intern_trivial_int (sub (nth after 1) (nth before 1)))
                      (intern_trivial_string "interned-nodes")
                      (intern_trivial_int (sub (nth after 5) (nth before 5)))
                      (intern_trivial_string "string-pool")
                      (intern_trivial_int (sub (nth after 6) (nth before 6)))
                      (intern_trivial_string "arena-cons")
                      (intern_trivial_int (sub (nth after 7) (nth before 7)))
                      (intern_trivial_string "value-stack-high-water")
                      (intern_trivial_int (sub (nth after 8) (nth before 8)))
                      (intern_trivial_string "boxed-floats")
                      (intern_trivial_int (sub (nth after 9) (nth before 9)))
                      (intern_trivial_string "io-sense-dispatches")
                      (intern_trivial_int (sub (nth after 10) (nth before 10))))
                file line col))
            (print_str (fbrols-cat (list
                "FRAMEBUFFER STAGE trace=" trace " stage=" stage
                " parent=" parent " actor=" actor " relation=" relation
                " why=" why " duration-ms="
                (int_to_str (sub (nth after 0) (nth before 0)))
                " dispatches="
                (int_to_str (sub (nth after 1) (nth before 1)))
                " boxed-floats="
                (int_to_str (sub (nth after 9) (nth before 9)))
                " io-sense="
                (int_to_str (sub (nth after 10) (nth before 10)))
                " outcome=" outcome)))
            event))
    (defn fbrols-node-values (children)
        (if (eq (len children) 0) (empty)
            (cons (node_value (head children))
                  (fbrols-node-values (tail children)))))
    (defn fbrols-event-row (node)
        (do
            (let source (node_source node))
            (list "framebuffer-event"
                (if (eq (len source) 3) source (list "" 0 0))
                (node_type (node_category node))
                (fbrols-node-values (node_children node)))))
    (defn fbrols-event-rows (nodes)
        (if (eq (len nodes) 0) (empty)
            (cons (fbrols-event-row (head nodes))
                  (fbrols-event-rows (tail nodes)))))
    (defn fbro-close-stream (window outcome output-units file line col)
        (do
            (let after (fbro-snapshot))
            (let finish (fbrols-marker "end" (nth window 1) (nth window 2)
                (nth window 3) (nth window 4) (nth window 5) (nth after 0)
                file line col))
            (let events (framebuffer-events))
            (let before (nth window 10))
            (let report (list "framebuffer-runtime-observation"
                (list "what" (nth window 1) "events" (len events))
                (list "where" (list (nth window 7) (nth window 8)
                    (nth window 9)) (list file line col))
                (list "with" (nth window 2) "relation" (nth window 3))
                (list "why" (nth window 4) "causal-parent-offer"
                    (nth window 5))
                (list "when" (nth before 0) "ended" (nth after 0)
                    "duration-ms" (sub (nth after 0) (nth before 0)))
                (list "resources"
                    "dispatches" (sub (nth after 1) (nth before 1))
                    "interned-nodes" (sub (nth after 5) (nth before 5))
                    "string-pool" (sub (nth after 6) (nth before 6))
                    "arena-cons" (sub (nth after 7) (nth before 7))
                    "boxed-floats" (sub (nth after 9) (nth before 9))
                    "io-sense-dispatches"
                        (sub (nth after 10) (nth before 10))
                    "input-bytes" (nth window 6)
                    "output-units" output-units
                    "observer-overhead"
                        "included; calibrate-with-empty-window")
                (list "outcome" outcome)
                (fbrols-event-rows events)
                (list "native" "fkwu-kernel-stat+framebuffer-events+node_source"
                    "per-function-dispatch-source" 0 "honest-floor"
                    "explicit source markers + exact whole-window counters")))
            (print_str (fbrols-cat (list
                "FRAMEBUFFER END trace=" (nth window 1)
                " duration-ms="
                (int_to_str (sub (nth after 0) (nth before 0)))
                " dispatches="
                (int_to_str (sub (nth after 1) (nth before 1)))
                " boxed-floats="
                (int_to_str (sub (nth after 9) (nth before 9)))
                " io-sense="
                (int_to_str (sub (nth after 10) (nth before 10)))
                " outcome=" outcome)))
            report))
    (defn fbro-events (report) (nth report 8))
    0)
