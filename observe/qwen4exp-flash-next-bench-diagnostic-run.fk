; Bounded framebuffer exchange for the silent 5,632-token llama-bench exit 143.
; Payload: [exit, seconds-before-exit, memory-free-percent, prompt-tokens].
; Selected state: [prompt-tokens, generated-tokens, verbose, progress].
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let observed (list 143 114 66 5632))
  (let original (list 5632 128 0 0))
  (let rehearsed (list 5632 0 1 1))
  (let outbound (bfc-envelope 0 3801 0 observed 3801099))
  (let out-event (bfc-record-out outbound 1))
  (let inbound (bfc-control outbound 5))
  (let in-event (bfc-record-in inbound 2))
  (let selected (bfc-apply outbound inbound original rehearsed))
  ; Re-observation payload: [exit, prompt-tokens-per-second-x100,
  ; prompt-tokens, generated-tokens].
  (let reobserved (list 0 31883 5632 0))
  (let second-outbound (bfc-envelope 0 3802 0 reobserved 3802099))
  (let second-out-event (bfc-record-out second-outbound 3))
  (let second-inbound (bfc-control second-outbound 0))
  (let second-in-event (bfc-record-in second-inbound 4))
  (list observed (bfc-payload inbound) selected
    reobserved (bfc-payload second-inbound)
    (bfc-apply second-outbound second-inbound selected rehearsed)
    (len (framebuffer-events))))
