// pg-wire-live-witness.bml — pg-wire against a live Postgres, on every kernel this checkout has built.
// preludes: form-stdlib/core.fk
//
// form-stdlib/pg-wire.fk speaks the Postgres v3 wire protocol in Form over the kernels' socket doors.
// This cell is its live witness. It makes a scratch cluster of its own under .hearth/ (initdb, trust
// auth, 127.0.0.1 on a port taken from its pid, no unix socket), writes pg-wire's own composition as a
// cell, runs that cell as a child on fkwu and on each proof sibling that is built, and stops the
// server. Only the cluster's data directory is removed afterwards; each child's exit, stdout and
// stderr stay beside the server log as evidence. It needs initdb and pg_ctl on PATH, nothing else.
//
// Verdict bits: 1 the cluster was made, 2 the server started, 4 fkwu reads the row, 8 go reads it,
// 16 rust reads it, 32 ts reads it, 64 the server stopped. A kernel that is not built reads 0 and
// says absent.
section [form.bml] {
 class PgWireLiveWitness {
  def pwl-at(root, name) = str_concat(root, str_concat("/", name));
  def pwl-run(root, name, script) {
   let base = pwl-at(root, name);
   let written = write_file(str_concat(base, ".in"), "");
   let started = host_monotonic_ms();
   let pid = host_spawn_at(list("sh", "-c", script), list(str_concat(base, ".in"), str_concat(base, ".out"), str_concat(base, ".err")));
   let status = if gt(pid, 0) then host_wait(pid) else -1;
   let elapsed = sub(host_monotonic_ms(), started);
   print(list(name, status, elapsed));
   list(status, read_file(str_concat(base, ".out")));
  }
  def pwl-ok(row) = eq(nth(row, 0), 0);
  // pg-wire's own composition, as its header gives it, against this cell's port
  def pwl-cell(port) {
   let head = str_concat("; pre", "ludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/pg-wire.fk\n(do\n    (let conn (socket_connect \"127.0.0.1\" ");
   let body = "))\n    (let s1 (socket_send conn (pw-startup \"form\" \"postgres\")))\n    (let hs (socket_recv conn 65535))\n    (let s2 (socket_send conn (pw-query \"SELECT 'witness:' || (20 + 22)::text\")))\n    (let r (socket_recv conn 65535))\n    (let c (socket_close conn))\n    (pw-first-value r))\n";
   str_concat(head, str_concat(int_to_str(port), body));
  }
  // one kernel reading the cell from its own directory; absent when this checkout has not built it
  def pwl-read(root, dir, name, binary, command, cell, bit) {
   let built = ge(file_size(pwl-at(dir, binary)), 0);
   let script = str_concat("cd ", str_concat(dir, str_concat(" && exec perl -e 'alarm 30; exec @ARGV' ", str_concat(command, str_concat(" ", cell)))));
   let row = if built then pwl-run(root, name, script) else list(-1, "absent\n");
   print(list(name, nth(row, 1)));
   if and(pwl-ok(row), str_eq(nth(row, 1), "witness:42\n")) then bit else 0;
  }
  def pwl-start() {
   let cwd = host_cwd();
   let root = pwl-at(cwd, str_concat(".hearth/pg-wire-live-", int_to_str(host_pid())));
   let made = host_dir_mkdir(root);
   if not(eq(made, 1)) then "fresh witness directory unavailable" else pwl-cases(root, cwd);
  }
  def pwl-cases(root, cwd) {
   let port = add(50000, mod(host_pid(), 10000));
   let data = pwl-at(root, "data");
   let init = pwl-run(root, "initdb", str_concat("exec initdb -D ", str_concat(data, " -A trust -U form")));
   let options = str_concat(" -o \"-p ", str_concat(int_to_str(port), " -c listen_addresses=127.0.0.1 -c unix_socket_directories=''\" -l "));
   let start = pwl-run(root, "start", str_concat("exec pg_ctl -D ", str_concat(data, str_concat(options, str_concat(pwl-at(root, "pg.log"), " -w start")))));
   let cell = pwl-at(root, "read.fk");
   let wrote = write_file(cell, pwl-cell(port));
   let form = pwl-at(cwd, "form");
   let k1 = pwl-read(root, cwd, "fkwu", "fkwu", "./fkwu", cell, 4);
   let k2 = pwl-read(root, form, "go", "form-kernel-go/bin-go", "form-kernel-go/bin-go", cell, 8);
   let k3 = pwl-read(root, form, "rust", "form-kernel-rust/target/release/form-kernel-rust", "form-kernel-rust/target/release/form-kernel-rust", cell, 16);
   let k4 = pwl-read(root, form, "ts", "form-kernel-ts/dist/main.mjs", "node form-kernel-ts/dist/main.mjs", cell, 32);
   let stop = pwl-run(root, "stop", str_concat("exec pg_ctl -D ", str_concat(data, " -m fast -w stop")));
   let cleared = pwl-run(root, "clear-data", str_concat("exec rm -rf ", data));
   let b1 = if pwl-ok(init) then 1 else 0;
   let b2 = if pwl-ok(start) then 2 else 0;
   let b7 = if pwl-ok(stop) then 64 else 0;
   print(str_concat("evidence=", root));
   add(b1, add(b2, add(k1, add(k2, add(k3, add(k4, b7))))));
  }
 }
 0;
}
