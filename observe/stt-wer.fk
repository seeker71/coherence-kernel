// stt-wer.fk -- sequence-aligned word error rate for native STT promotion.
//
// Set-overlap agreement scoring is useful but blind to word order.
// This cell adds the next stricter signal: Levenshtein edit distance over word
// lists, then WER = edits * 100 / truth length. It is intentionally small and
// integer-only so fkwu can witness it directly.
//
import form-stdlib/core.fk;
section [form.bml] {
    def sw-min2(a, b) = a <= b ? a : b;
    def sw-min3(a, b, c) = sw-min2(sw-min2(a, b), c);
    def sw-cost(a, b) = (String) a == b ? 0 : 1;
    def sw-distance(hyp, truth) = (Comparable) len(hyp) == 0 ? len(truth) : (Comparable) len(truth) == 0 ? len(hyp) : sw-min3((Number) 1 + (Number) sw-distance(hyp[1:], truth), (Number) 1 + (Number) sw-distance(hyp, truth[1:]), (Number) sw-cost(hyp[0], truth[0]) + (Number) sw-distance(hyp[1:], truth[1:]));
    def sw-denom(truth) = (Comparable) len(truth) == 0 ? 1 : len(truth);
    def sw-wer(hyp, truth) = sw-distance(hyp, truth) * 100 / sw-denom(truth);
    def sw-accept?(hyp, truth, max-wer) = sw-wer(hyp, truth) <= max-wer ? 1 : 0;
    // The compact recursive distance above is clear and works for tiny witness
    // bands, but it is exponential. Real ASR transcripts need the same metric
    // computed with a bounded dynamic-programming row walk.
    def swb-range-row(j, n) = j > n ? empty() : cons(j, swb-range-row((Number) j + (Number) 1, n));
    def swb-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : swb-rev(xs[1:], cons(xs[0], acc));
    def swb-row-loop(h, truth, prev, j, m, prevdiag, left, acc) = j > m ? swb-rev(acc, empty()) : {
        let above = nth(prev, j);
        let diag = prevdiag;
        let t = nth(truth, j - 1);
        let v = sw-min3((Number) above + (Number) 1, (Number) left + (Number) 1, (Number) diag + (Number) sw-cost(h, t));
        swb-row-loop(h, truth, prev, (Number) j + (Number) 1, m, above, v, cons(v, acc));
    };
    def swb-next-row(h, truth, prev, i) = swb-row-loop(h, truth, prev, 1, len(truth), prev[0], i, [i]);
    def swb-distance-loop(hyp, truth, prev, i) = (Comparable) len(hyp) == 0 ? nth(prev, len(truth)) : {
        let row = swb-next-row(hyp[0], truth, prev, i);
        swb-distance-loop(hyp[1:], truth, row, (Number) i + (Number) 1);
    };
    def sw-distance-bounded(hyp, truth) = swb-distance-loop(hyp, truth, swb-range-row(0, len(truth)), 1);
    def sw-wer-bounded(hyp, truth) = sw-distance-bounded(hyp, truth) * 100 / sw-denom(truth);
    def sw-accept-bounded?(hyp, truth, max-wer) = sw-wer-bounded(hyp, truth) <= max-wer ? 1 : 0;
    // Compact tokenizer helpers keep broad prelude bands below the current seed's function-table ceiling.
    def sw-reverse-onto(xs, acc) = (Comparable) len(xs) == 0 ? acc : sw-reverse-onto(xs[1:], cons(xs[0], acc));
    def sw-slice-loop(source, i, end, acc) = i >= end ? acc : sw-slice-loop(source, (Number) i + (Number) 1, end, ((String) acc + byte_to_str(str_byte_at(source, i))));
    def sw-token-loop(source, i, n, cur, acc) = i >= n ? sw-reverse-onto((String) cur == "" ? acc : cons(cur, acc), empty()) : {
        let b0 = str_byte_at(source, i);
        b0 >= 48 && b0 <= 57 || (b0 >= 65 && b0 <= 90 || b0 >= 97 && b0 <= 122) ? sw-token-loop(source, (Number) i + (Number) 1, n, ((String) cur + byte_to_str(b0 >= 65 && b0 <= 90 ? (Number) b0 + (Number) 32 : b0)), acc) : b0 < 128 ? sw-token-loop(source, (Number) i + (Number) 1, n, "", (String) cur == "" ? acc : cons(cur, acc)) : {
            let size = b0 >= 192 && b0 <= 223 ? 2 : b0 >= 224 && b0 <= 239 ? 3 : b0 >= 240 && b0 <= 247 ? 4 : 1;
            let b1 = (Number) i + (Number) 1 < n ? str_byte_at(source, (Number) i + (Number) 1) : 0;
            let b2 = (Number) i + (Number) 2 < n ? str_byte_at(source, (Number) i + (Number) 2) : 0;
            let unit = sw-slice-loop(source, i, (Number) i + (Number) size, "");
            let flushed = (String) cur == "" ? acc : cons(cur, acc);
            (Comparable) b0 == 226 && ((Comparable) b1 == 128 && (b2 >= 144 && b2 <= 191)) || ((Comparable) b0 == 227 && ((Comparable) b1 == 128 && (b2 >= 128 && b2 <= 191)) || ((Comparable) b0 == 239 && ((Comparable) b1 == 188 && (b2 >= 128 && b2 <= 159)) || (Comparable) b0 == 216 && ((Comparable) b1 == 140 || ((Comparable) b1 == 155 || (Comparable) b1 == 159)))) ? sw-token-loop(source, (Number) i + (Number) size, n, "", flushed) : b0 >= 228 && b0 <= 233 ? sw-token-loop(source, (Number) i + (Number) size, n, "", cons(unit, flushed)) : sw-token-loop(source, (Number) i + (Number) size, n, ((String) cur + unit), acc);
        };
    };
    def sw-dj-loop(s, i, n, acc) = i >= n ? acc : {
        let b0 = str_byte_at(s, i);
        let b1 = (Number) i + (Number) 1 < n ? str_byte_at(s, (Number) i + (Number) 1) : 0;
        let b2 = (Number) i + (Number) 2 < n ? str_byte_at(s, (Number) i + (Number) 2) : 0;
        (Comparable) b0 == 226 && ((Comparable) b1 == 128 && ((Comparable) b2 == 140 || (Comparable) b2 == 141)) ? sw-dj-loop(s, (Number) i + (Number) 3, n, acc) : sw-dj-loop(s, (Number) i + (Number) 1, n, ((String) acc + byte_to_str(b0)));
    };
    def sw-drop-joiners(s) = sw-dj-loop(s, 0, len(s), "");
    def sw-tokens(text) = let(cleaned, sw-drop-joiners(text), sw-token-loop(cleaned, 0, len(cleaned), "", empty()));
    0;
}
