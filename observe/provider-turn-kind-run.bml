// provider-turn-kind-run.bml — the share meter's reading of one provider turn's own transcript: kind=observed only when the collector settles a valid turn from it.
//
//   cd <a directory of this turn's own, holding .form-cli-turn-rollout> && <root>/fkwu <root>/observe/provider-turn-kind-run.bml
//
// The collector keeps its cursor in .form-cli-turn-* files of the working directory, so a directory of the turn's own keeps another turn's or a live session's
// reading out. It prints one line: kind=observed scope=previous-completed-turn source=<the collector's> turn=<id> total=<provider tokens>, or kind=unknown reason=<why>.
// It publishes nothing to Glass. provider-turn.bml begins it as a child and reads that line.
// preflight-exec: forbidden
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/form-cli-turn-evidence.fk;
import form-stdlib/form-cli-turn-evidence-live.fk;
import form-stdlib/bml/form-cli-turn-evidence-cursor.bml;
section [form.bml] {
 class ProviderTurnKind {
  def ptk-slices() = 64;
  def ptk-observed(e) = "kind=observed scope=previous-completed-turn source=" ++ fcte-source(e) ++ " turn=" ++ fcte-turn-id(e) ++ " total=" ++ fcte-total-tokens(e).str();
  def ptk-walk(n, last) {
   let e = fctel-evidence();
   (Comparable) fcte-valid?(e) == 1 ? ptk-observed(e) : str_find(last, "=unavailable", 0) >= 0 ? "kind=unknown reason=" ++ ptk-reason(last) : n <= 0 ? "kind=unknown reason=unsettled" : ptk-walk(n - 1, trim(fctec-refresh-bound()));
  }
  def ptk-reason(last) { let at = str_find(last, "reason=", 0); at < 0 ? last : substring(last, at + 7, len(last)); }
  def ptk-read() = (String) fctel-bound-path() == "" ? "kind=unknown reason=no-transcript" : ptk-walk(ptk-slices(), "");
 }
 print_str(ptk-read());
 0;
}
