; qwen38-flow-steer-run.fk — the first LOCAL steering crossing: the local
; Qwen receives this hour's MEASURED health map and a fixed door menu, its
; choice is parsed off the raw output bytes, and the chosen door is RUN.
; The door's real telemetry re-enters the same residence-threaded stream,
; and the model either confirms its choice served the gap or redirects.
;
; MECHANISM (observation, not law):
;   The rented mind has held the flow-wheel because every prior door pointed
;   the local model at ANSWERING, never at CHOOSING-with-consequence. This
;   cell is the choice-lane shape from the control family applied to the
;   body's own flow: a bounded menu (choice), one commitment (cut), the
;   door actually executed, typed telemetry back, and an explicit second
;   turn where redirection is possible (undo of intent, not of effect).
;
;   The menu doors are real Form cells with observable verdicts. Nothing
;   here is fabricated for the model's benefit: door 1 runs a real band,
;   door 2 a real probe, door 3 a real census count. The model's choice
;   decides which one THIS run actually performs.
;
; preludes: observe/qwen38-bmf-mechanism.fk learn/homecoming-distillation-corpus.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/form-knowledge-integration-census.fk

(do
    (defn qfs-path () (qbl-path))

    ; ---- the door menu: each row = (number, name, what-it-closes) ---------
    (defn qfs-menu-text ()
        "door 1: run the corpus band (verifies the ten just-landed frontier rows still hold)\ndoor 2: probe axioms retrieval (the family v3 scored 0; retrieval was fast this hour, re-witness it)\ndoor 3: count the census sources (the offline-knowledge denominator, fresh)")

    ; ---- execute the chosen door, answer typed telemetry ------------------
    (defn qfs-run-door (n)
        (if (eq n 1)
            (str_concat "[door1] corpus band verdict="
                (int_to_str (hdc-field-code)))
        (if (eq n 2)
            (do (let t0 (now_unix_ms))
                (let r (fkss-search-at "axioms" (list "axiom" "nothing")))
                (let t1 (now_unix_ms))
                (str_concat "[door2] axioms retrieval schema="
                    (str_concat (nth r 0)
                    (str_concat " ms=" (int_to_str (sub t1 t0))))))
        (if (eq n 3)
            (str_concat "[door3] census sources="
                (int_to_str (len (fki-live-source-units))))
            "[door?] no such door — nothing ran"))))

    ; ---- parse the model's choice off raw bytes ---------------------------
    ; the first byte in {'1','2','3'} after the word "door" — scannerless.
    (defn qfs-choice-go (s i n)
        (if (ge i n) 0
            (do (let at (str_find s "door" i))
                (if (lt at 0) 0
                    (do (let j (add at 4))
                        (let b (if (lt j n) (str_byte_at s (add j (if (eq (str_byte_at s j) 32) 1 0))) 0))
                        (if (if (ge b 49) (le b 51) 0) (sub b 48)
                            (qfs-choice-go s (add at 4) n)))))))
    (defn qfs-choice (s)
        (do (let c (qfs-choice-go s 0 (str_len s)))
            (if (gt c 0) c
                ; fallback: the first bare digit 1-3 anywhere
                (qfs-digit-go s 0 (str_len s)))))
    (defn qfs-digit-go (s i n)
        (if (ge i n) 0
            (do (let b (str_byte_at s i))
                (if (if (ge b 49) (le b 51) 0) (sub b 48)
                    (qfs-digit-go s (add i 1) n)))))

    ; ---- turn 1: the measured map + menu, the model chooses ---------------
    (defn qfs-prompt1 ()
        "You are steering this body's next step. The measured state right now: the build chain is rebuilding form-cli in the background; ten frontier rows just landed in the corpus (band 32767 full); the v3 audit scored 13 of 30 with axioms, learn, teachings, control, ingest at zero; the census counted 5960 sources. Choose exactly ONE door to run now and say why in one sentence.\n\ndoor 1: run the corpus band (verify the ten new rows hold)\ndoor 2: probe axioms retrieval (the zero family; retrieval speed matters for teaching)\ndoor 3: count the census sources (fresh denominator)\n\nAnswer with the door number first.")

    (let t0 (now_unix_ms))
    (let g1 (qbl-gen (fcmr-none) (qfs-prompt1) 120))
    (let t1 (now_unix_ms))
    (let text1 (nth g1 0))
    (let s1 (qbl-say "=== the model's choice, verbatim ==="))
    (let s2 (qbl-say text1))
    (let choice (qfs-choice text1))
    (let s3 (qbl-say (str_concat "parsed_choice=" (str_concat (int_to_str choice)
        (str_concat " turn1_ms=" (int_to_str (sub t1 t0)))))))

    ; ---- the cut: the chosen door RUNS ------------------------------------
    (let t2 (now_unix_ms))
    (let outcome (qfs-run-door choice))
    (let t3 (now_unix_ms))
    (let s4 (qbl-say (str_concat "[executed] " (str_concat outcome
        (str_concat " door_ms=" (int_to_str (sub t3 t2)))))))

    ; ---- turn 2: telemetry re-enters; confirm or redirect -----------------
    (let prompt2 (str_concat (qfs-prompt1)
                 (str_concat "\n\nYou chose and the door ran. Its telemetry:\n"
                 (str_concat outcome
                 "\n\nDid this serve the gap you named? Answer CONFIRM, or name a different door number for the next hour."))))
    (let t4 (now_unix_ms))
    (let g2 (qbl-gen (nth g1 1) prompt2 100))
    (let t5 (now_unix_ms))
    (let text2 (nth g2 0))
    (let s5 (qbl-say "=== the model's review of its own steering ==="))
    (let s6 (qbl-say text2))
    (let s7 (qbl-say (str_concat "turn2_ms=" (int_to_str (sub t5 t4)))))
    (let confirmed (if (ge (str_find text2 "CONFIRM" 0) 0) 1 0))
    (let rel (if (eq (fcmr-release-ok? (nth g2 1)) 1) 1 0))
    (let s8 (qbl-say "=== scored observation (not a law) ==="))
    (let s9 (qbl-say (str_concat "S1_choice_parsed=" (int_to_str (if (gt choice 0) 1 0)))))
    (let s10 (qbl-say (str_concat "S2_door_executed=" (int_to_str (if (gt choice 0) 1 0)))))
    (let s11 (qbl-say (str_concat "S3_review=" (if (eq confirmed 1) "confirmed" "redirected"))))
    (let s12 (qbl-say (str_concat "S4_residence_released=" (int_to_str rel))))
    0)
