; form-glass-string-growth-profile-run.fk — compare persistent Glass render paths.
;
; The scene builder is identical in both arms.  The byte arm projects directly
; to integer byte lists; the legacy arm materializes ANSI strings.  Reported
; deltas therefore isolate projection strings from dynamic semantic row text.
;
; preludes: form-stdlib/form-glass-live.bml

(do
    (defn fglsg-metrics (epoch frame)
        (list
            (fgo-int "framebuffer" "events" "event roots" frame "roots" frame "cpu-arena" "physical-live" "fixture.counter" "live" "framebuffer" "changing fixture")
            (fgo-int "memory" "cells" "interned cells" (add 200 frame) "cells" (add 200 frame) "cpu-arena" "physical-live" "fixture.counter" "live" "cell" "changing fixture")
            (fgo-int "memory" "cons" "arena cons" (add 6000 frame) "cons" (add 6000 frame) "cpu-arena" "physical-live" "fixture.counter" "live" "list" "changing fixture")
            (fgo-int "request" "queue-depth" "request queue" 0 "requests" 0 "membrane" "physical-live" "fixture.queue" "idle" "queue" "measured empty queue")
            (fgo-int "host" "memory-free" "memory free" (sub 90 (mod frame 10)) "percent" 100 "os-memory" "physical-live" "fixture.host" "live" "health" "changing fixture")))
    (defn fglsg-samples (epoch frame)
        (list (fgtm-sample "model.fixture" (fgtm-absent) "model" "metal" "fixture.owner" "reasoning" "profile"
            (fgtm-present 1048576) (fgtm-present (add 2048 frame)) "active"
            (fgtm-present 1000) (fgtm-present 1000) (fgtm-present frame)
            (fgtm-present 7) "never" "physical-live" "fixture.model" (list "memory" "model" "metal"))))
    (defn fglsg-frame (epoch frame control)
        (fgl-dashboard-frame 80 24 epoch 4 frame control
            (fglsg-metrics epoch frame) (fglsg-samples epoch frame) (list "fixture.owner") (list) (list)))

    (defn fglsg-data-run (remaining epoch frame held)
        (if (le remaining 0)
            held
            (fglsg-data-run (sub remaining 1) (add epoch 250) (add frame 1)
                (list (fglsg-metrics epoch frame) (fglsg-samples epoch frame)))))
    (defn fglsg-pulse-run (remaining epoch frame held)
        (if (le remaining 0)
            held
            (fglsg-pulse-run (sub remaining 1) (add epoch 250) (add frame 1)
                (fglui-pulse-line epoch 4 frame (list) (fglsg-metrics epoch frame) 80))))
    (defn fglsg-atlas-run (remaining epoch frame held)
        (if (le remaining 0)
            held
            (fglsg-atlas-run (sub remaining 1) (add epoch 250) (add frame 1)
                (fglat-lines-budget (fglsg-metrics epoch frame) (fglsg-samples epoch frame)
                    (list) (list) epoch 80 20))))
    (defn fglsg-frame-run (remaining epoch frame control held)
        (if (le remaining 0)
            held
            (fglsg-frame-run (sub remaining 1) (add epoch 250) (add frame 1) control
                (fglsg-frame epoch frame control))))
    (defn fglsg-right-run (remaining epoch frame held)
        (if (le remaining 0)
            held
            (fglsg-right-run (sub remaining 1) (add epoch 250) (add frame 1)
                (fglui-right "atlas" 80 (fglsg-metrics epoch frame)))))

    (defn fglsg-run (remaining epoch frame epochStep frameStep control prior useBytes emitted)
        (if (le remaining 0)
            (list prior emitted)
            (fglsg-run-next remaining epoch frame epochStep frameStep control prior useBytes emitted
                (fglsg-frame epoch frame control))))

    (defn fglsg-run-next (remaining epoch frame epochStep frameStep control prior useBytes emitted nextFrame)
        (do
            (let projection (if (eq useBytes 1)
                (if (eq (fgl-frame-same-size? prior nextFrame) 1)
                    (ftcb-segment-lines-diff (fgd-segment-frame-lines prior) (fgd-segment-frame-lines nextFrame))
                    (ftcb-full-frame (fgd-segment-frame-lines nextFrame)))
                (fgl-frame-patch prior nextFrame)))
            (fglsg-run (sub remaining 1) (add epoch epochStep) (add frame frameStep)
                epochStep frameStep control nextFrame useBytes (add emitted (len projection)))))

    (let control (fgl-control-state "all" "none" 0 "held"))
    (let warmBytes (fglsg-run 2 1000 1 250 1 control (list) 1 0))
    (let byteStringsBefore (kernel_stat 5))
    (let byteNodesBefore (kernel_stat 4))
    (let byteRun (fglsg-run 16 10000 10 250 1 control (head warmBytes) 1 0))
    (let byteStringsAfter (kernel_stat 5))
    (let byteNodesAfter (kernel_stat 4))

    (let warmLegacy (fglsg-run 2 100000 100 250 1 control (list) 0 0))
    (let legacyStringsBefore (kernel_stat 5))
    (let legacyNodesBefore (kernel_stat 4))
    (let legacyRun (fglsg-run 16 200000 200 250 1 control (head warmLegacy) 0 0))
    (let legacyStringsAfter (kernel_stat 5))
    (let legacyNodesAfter (kernel_stat 4))

    (let warmData (fglsg-data-run 1 300000 300 (list)))
    (let dataStringsBefore (kernel_stat 5))
    (let heldData (fglsg-data-run 16 310000 310 warmData))
    (let dataStringsAfter (kernel_stat 5))
    (let warmPulse (fglsg-pulse-run 1 400000 400 (list)))
    (let pulseStringsBefore (kernel_stat 5))
    (let heldPulse (fglsg-pulse-run 16 410000 410 warmPulse))
    (let pulseStringsAfter (kernel_stat 5))
    (let warmAtlas (fglsg-atlas-run 1 500000 500 (list)))
    (let atlasStringsBefore (kernel_stat 5))
    (let heldAtlas (fglsg-atlas-run 16 510000 510 warmAtlas))
    (let atlasStringsAfter (kernel_stat 5))
    (let warmFrameOnly (fglsg-frame-run 1 600000 600 control (list)))
    (let frameOnlyStringsBefore (kernel_stat 5))
    (let heldFrameOnly (fglsg-frame-run 16 610000 610 control warmFrameOnly))
    (let frameOnlyStringsAfter (kernel_stat 5))
    (let warmRight (fglsg-right-run 1 700000 700 (list)))
    (let rightStringsBefore (kernel_stat 5))
    (let heldRight (fglsg-right-run 16 710000 710 warmRight))
    (let rightStringsAfter (kernel_stat 5))

    (list "form-glass-string-growth-profile-v1"
        (list "frames" 16)
        (list "byte-projection-emitted" (nth byteRun 1))
        (list "byte-projection-string-growth" (sub byteStringsAfter byteStringsBefore))
        (list "byte-projection-nodeid-growth" (sub byteNodesAfter byteNodesBefore))
        (list "legacy-projection-emitted" (nth legacyRun 1))
        (list "legacy-projection-string-growth" (sub legacyStringsAfter legacyStringsBefore))
        (list "legacy-projection-nodeid-growth" (sub legacyNodesAfter legacyNodesBefore))
        (list "data-construction-string-growth" (sub dataStringsAfter dataStringsBefore))
        (list "pulse-string-growth" (sub pulseStringsAfter pulseStringsBefore))
        (list "atlas-body-string-growth" (sub atlasStringsAfter atlasStringsBefore))
        (list "full-scene-string-growth" (sub frameOnlyStringsAfter frameOnlyStringsBefore))
        (list "right-panel-string-growth" (sub rightStringsAfter rightStringsBefore))))
