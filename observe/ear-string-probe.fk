; ear-string-probe.fk — which string door costs the 44 ms inside a doubling zero-fill.
; enw-zeros builds 192000 bytes with ~19 str_concats and one substring and measured 44.25 ms,
; while el-cat copied 10.4 MB through 80 str_concats in 18 ms. Fewer calls, far more time: the
; cost is not per byte and not per call, so it is one of the three doors. This asks each alone.
; preflight-exec: forbidden
; preludes: form/form-stdlib/str-byte-at.fk
(do
    (defn sp-dbl (s n) (if (ge (str_len s) n) s (sp-dbl (str_concat s s) n)))
    (defn sp-dbl-n (n acc) (if (eq n 0) acc (sp-dbl-n (sub n 1) (add acc (str_len (sp-dbl (byte_to_str 0) 192000))))))
    (defn sp-sub-n (s n acc) (if (eq n 0) acc (sp-sub-n s (sub n 1) (add acc (str_len (substring s 0 192000))))))
    (defn sp-len-n (s n acc) (if (eq n 0) acc (sp-len-n s (sub n 1) (add acc (str_len s)))))
    (defn sp-cat2-n (a b n acc) (if (eq n 0) acc (sp-cat2-n a b (sub n 1) (add acc (str_len (str_concat a b))))))
    (defn sp-say (label ms n) (print_str (str_concat label (str_concat " per=" (str_concat (int_to_str (div (mul ms 100) n)) "/100 ms")))))
    (let big (sp-dbl (byte_to_str 0) 262144))
    (let a0 (now_unix_ms)) (let a (sp-dbl-n 20 0)) (let a1 (now_unix_ms))
    (let sa (sp-say "doubling concat to 256k" (sub a1 a0) 20))
    (let b0 (now_unix_ms)) (let b (sp-sub-n big 20 0)) (let b1 (now_unix_ms))
    (let sb (sp-say "substring 192k of 256k " (sub b1 b0) 20))
    (let c0 (now_unix_ms)) (let c (sp-len-n big 200 0)) (let c1 (now_unix_ms))
    (let sc (sp-say "str_len of a 256k      " (sub c1 c0) 200))
    (let half (substring big 0 131072))
    (let d0 (now_unix_ms)) (let d (sp-cat2-n half half 20 0)) (let d1 (now_unix_ms))
    (let sd (sp-say "ONE concat 128k+128k   " (sub d1 d0) 20))
    (let k (substring big 0 3200))
    (let e0 (now_unix_ms)) (let e (sp-cat2-n k k 200 0)) (let e1 (now_unix_ms))
    (let se (sp-say "ONE concat 3.2k+3.2k   " (sub e1 e0) 200))
    (print (str_len big)))
