// voice-measure-run.fk — the acoustic measures of a whole spoken track, taken by the body on its own Metal.
//
// stdin: the path of one RIFF WAV (any length; 60 million samples is a handful of dispatches).
// stdout: one `name  value` line per measure (see form/form-stdlib/voice-measure.bml for what each is),
// then the elapsed milliseconds.
//
// GPU etiquette: this opens the Metal carrier, so the door holds the GPU lease (/tmp/form-gpu.lock, machine-wide,
// form/form-stdlib/gpu-lease.bml) for the run and prints it, taken and given back, as `lease  ...` lines. A live
// holder is waited for (20 minutes), a dead holder's lease is taken over, and a refused take means the door did not run.
//
// preflight-exec: forbidden
import form-stdlib/voice-measure.bml;
import form/form-stdlib/gpu-lease.bml;
section [form.bml] {
    def vmr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def vmr-run(path, lease) {
        let started = host_monotonic_ms();
        let rows = vmz-measure(path);
        let shown = vmz-report(rows);
        let ms = host_monotonic_ms() - started;
        let timed = print_str("elapsed_ms  " + ms.str());
        let left = print_str("retained_buffers  " + metal_live()[2].str());
        gpu-lease-door-end(lease);
    }
    let path = vmr-line();
    let lease = gpu-lease-door("voice-measure-run");
    (Comparable) gpu-lease-held?(lease) == 1 ? vmr-run(path, lease) : print_str("voice-measure-run  not run");
    0;
}
