; native-model-dual-owner-command-run.fk — atomic future-owner command door.
; preflight-exec: forbidden
;
; stdin: publisher, then heartbeat|status|qwen-step|3b-step|quit
; preludes: form/form-stdlib/native-model-owner-cadence.bml

(do
    (let publisher (read_line))
    (let command (read_line))
    (if (or (nothing? publisher) (nothing? command))
        (list "native-model-owner-command" "refused" "input")
        (nmdoc-offer-command publisher command)))
