// day-turn.bml — one engineering turn by the body's own loop in the day, landed with no rented mind.
//
// launchd (docs/launchd/earth.hati.day-turn.plist) runs this door from the walk checkout. It shares the night's
// steps (form-stdlib/bml/host-walk.bml): the branch follows main, the kernel and carrier rebuild when their sources
// are newer. It takes one native turn on the open gap with the fewest attempts (observe/native-turn-run.bml) and
// lands the turn's row, and its edit when the band went green, through the movement door with no voice and no
// compare ("native-turn <day> <hhmm>", so the night's walk count stays the night's); the landing fast-forwards main.
// A queue with no open gap lands nothing. At the end, a landing that stood on the branch is carried to main (hw-carry).
// stdin: nothing. Prints the sync, build and carrier readings, the turn, the movement's line, then the carry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class DayTurn {
  def dt-pad(n) = if (n < 10) then str_concat("000", int_to_str(n)) else if (n < 100) then str_concat("00", int_to_str(n)) else if (n < 1000) then str_concat("0", int_to_str(n)) else int_to_str(n);
  def dt-request(day, hhmm) = json-node-object(list(
   fhn-s("movement", mc-cat(list("native-turn ", day, " ", hhmm))),
   fhn-s("transcript", ""),
   fhn-n("voice", 0),
   fhn-n("compare", 0),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", mc-cat(list("Native turn ", day, " ", hhmm, ": the body's own loop, no rented mind"))),
   fhn-s("body", "One engineering turn by the body's own loop (observe/native-turn-run.bml over learn/native-turn-queue.jsonl), begun by launchd (earth.hati.day-turn) from the walk checkout through observe/day-turn.bml and landed by the movement door with no voice. The row says whether the band went green; a green band's edit lands with it.")));
  def dt-run() {
   let branch = hw-branch();
   let day = hw-day();
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   print_str(mc-cat(list("[day-turn] ", day, " branch=", branch, " ", sync, " ", build, " ", carrier, "\n")));
   let turn = hw-native-turn(24);
   print_str(mc-cat(list(turn, "\n")));
   let hhmm = dt-pad(hw-hhmm());
   print_str(if hw-turned?(turn) then hw-movement(dt-request(day, hhmm)) else "[day-turn] no open gap; nothing to land\n");
   print_str(hw-carry(branch));
  }
 }
 dt-run();
}
