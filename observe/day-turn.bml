// day-turn.bml — one engineering turn by the body's own loop in the day, landed with no rented mind.
//
// launchd (docs/launchd/earth.hati.day-turn.plist) runs this door from the walk checkout. It shares the night's
// steps (form-stdlib/bml/host-walk.bml): the branch follows main, the kernel and carrier rebuild when their sources
// are newer. It takes native turns on the open gap with the fewest attempts (observe/native-turn-run.bml) while
// a gap stays open and its window (two and a half hours, so the 12:30 and 19:00 slots never meet the next) has
// time left, and lands each turn's row, and its edit when the band went green, through the movement door with no
// voice and no compare ("native-turn <day> <hhmm>", so the night's walk count stays the night's); each landing
// fast-forwards main. A queue with no open gap lands nothing. At the end, a landing that stood on the branch is
// carried to main (hw-carry).
// stdin: nothing. Prints the sync, build and carrier readings, the turn, the movement's line, then the carry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/host-walk.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class DayTurn {
  def dt-pad(n) = n < 10 ? "000" ++ n.str() : n < 100 ? "00" ++ n.str() : n < 1000 ? "0" ++ n.str() : n.str();
  def dt-request(day, hhmm) = json-node-object([
   fhn-s("movement", "native-turn " ++ day ++ " " ++ hhmm),
   fhn-s("transcript", ""),
   fhn-n("voice", 0),
   fhn-n("compare", 0),
   fhn-n("main", 1),
   json-node-pair("paths", json-node-array(hw-paths())),
   fhn-s("subject", "Native turn " ++ day ++ " " ++ hhmm ++ ": the body's own loop, no rented mind"),
   fhn-s("body", "One engineering turn by the body's own loop (observe/native-turn-run.bml over learn/native-turn-queue.jsonl), begun by launchd (earth.hati.day-turn) from the walk checkout through observe/day-turn.bml and landed by the movement door with no voice. The row says whether the band went green; a green band's edit lands with it.")]);
  def dt-window-ms() = 9000000;
  def dt-turns(day, until, landed) {
   let turn = hw-native-turn(24);
   print_str(turn ++ "\n");
   hw-turned?(turn) ? dt-land(day, until, landed) : landed;
  }
  def dt-land(day, until, landed) {
   print_str(hw-movement(dt-request(day, dt-pad(hw-hhmm()))));
   host_monotonic_ms() < until ? dt-turns(day, until, landed + 1) : landed + 1;
  }
  def dt-run() {
   let branch = hw-branch();
   let day = hw-day();
   let sync = hw-sync(branch);
   let build = hw-build();
   let carrier = hw-carrier();
   print_str("[day-turn] " ++ day ++ " branch=" ++ branch ++ " " ++ sync ++ " " ++ build ++ " " ++ carrier ++ "\n");
   let landed = dt-turns(day, host_monotonic_ms() + dt-window-ms(), 0);
   print_str((Comparable) landed == 0 ? "[day-turn] no open gap; nothing to land\n" : "[day-turn] turns landed " ++ landed.str() ++ "\n");
   print_str(hw-carry(branch));
  }
 }
 dt-run();
}
