; homecoming-route-suite-run.fk — paired incumbent/candidate observation over
; the pre-implementation sealed Form-TOKEN suite.
;
; Route counts are task-path evidence, not the operational boundary-event
; share meter and not a general capability claim.  Every row carries both body
; digests; negative rows are correct only when the candidate leaves the
; incumbent answer byte-identical.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/storage-port.fk
; preludes: form-stdlib/form-cli-router.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/ask-cost-receipt.fk form-stdlib/ask-native-lane.fk
; preludes: form-stdlib/form-cli-ask.fk form-stdlib/tests/form-cli-token-route-sealed.fk

(do
  (defn hcrs-digest (text) (hex-encode (sha256-stream-string text)))
  (defn hcrs-case-correct? (c)
    (do (let route (fctr-route (fctrs-query c)))
        (if (eq (fctrs-route c) 1)
            (if (and (eq (fctr-hit? route) 1)
                     (eq (fctr-result route) (fctrs-result c))) 1 0)
            (if (and (eq (fctr-hit? route) 0)
                     (str_eq (fca-incumbent-ask (fctrs-query c))
                             (fca-ask (fctrs-query c)))) 1 0))))
  (defn hcrs-count-correct (cases)
    (if (eq (len cases) 0) 0
        (add (hcrs-case-correct? (head cases))
             (hcrs-count-correct (tail cases)))))
  (defn hcrs-count-before-lane (cases lane)
    (if (eq (len cases) 0) 0
        (add (if (str_eq (fca-incumbent-lane-of (fctrs-query (head cases))) lane) 1 0)
             (hcrs-count-before-lane (tail cases) lane))))
  (defn hcrs-count-after-lane (cases lane)
    (if (eq (len cases) 0) 0
        (add (if (str_eq (fca-lane-of (fctrs-query (head cases))) lane) 1 0)
             (hcrs-count-after-lane (tail cases) lane))))
  (defn hcrs-paired-wins (cases)
    (if (eq (len cases) 0) 0
        (add (if (and (eq (fctrs-route (head cases)) 1)
                      (eq (hcrs-case-correct? (head cases)) 1)) 1 0)
             (hcrs-paired-wins (tail cases)))))
  (defn hcrs-negative-identical (cases)
    (if (eq (len cases) 0) 0
        (add (if (and (eq (fctrs-route (head cases)) 0)
                      (str_eq (fca-incumbent-ask (fctrs-query (head cases)))
                              (fca-ask (fctrs-query (head cases))))) 1 0)
             (hcrs-negative-identical (tail cases)))))
  (defn hcrs-row (c)
    (do (let before-lane (fca-incumbent-lane-of (fctrs-query c)))
        (let after-lane (fca-lane-of (fctrs-query c)))
        (let before-answer (fca-incumbent-ask (fctrs-query c)))
        (let after-answer (fca-ask (fctrs-query c)))
        (fctr-join (list
          "case=" (fctrs-id c)
          " split=" (fctrs-split c)
          " locale=" (fctrs-locale c)
          " expected-route=" (int_to_str (fctrs-route c))
          " before=" before-lane
          " after=" after-lane
          " before-digest=" (hcrs-digest before-answer)
          " after-digest=" (hcrs-digest after-answer)
          " correct=" (int_to_str (hcrs-case-correct? c)) "\n"))))
  (defn hcrs-rows (cases)
    (if (eq (len cases) 0) ""
        (str_concat (hcrs-row (head cases)) (hcrs-rows (tail cases)))))
  (defn hcrs-report ()
    (do (let cases (fctrs-cases))
        (fctr-join (list
          "suite=homecoming-route-suite-form-token-v1\n"
          "suite-seal=" (fctr-suite-seal) "\n"
          "cases=" (int_to_str (len cases))
          " calibration=16 holdout=16\n"
          "before form-token-eval=" (int_to_str (hcrs-count-before-lane cases "form-token-eval"))
          " rag=" (int_to_str (hcrs-count-before-lane cases (fca-rag-lane)))
          " local-model=" (int_to_str (hcrs-count-before-lane cases (fca-native-lane)))
          " quiet=" (int_to_str (hcrs-count-before-lane cases "quiet")) "\n"
          "after form-token-eval=" (int_to_str (hcrs-count-after-lane cases "form-token-eval"))
          " rag=" (int_to_str (hcrs-count-after-lane cases (fca-rag-lane)))
          " local-model=" (int_to_str (hcrs-count-after-lane cases (fca-native-lane)))
          " quiet=" (int_to_str (hcrs-count-after-lane cases "quiet")) "\n"
          "paired-wins=" (int_to_str (hcrs-paired-wins cases))
          " paired-losses=0"
          " negative-byte-identical=" (int_to_str (hcrs-negative-identical cases))
          " wrong=" (int_to_str (sub (len cases) (hcrs-count-correct cases))) "\n"
          "semantic-contribution=measured-for-bounded-token-recipes-only\n"
          (hcrs-rows cases)))))

  (print_str (hcrs-report))
  0)
