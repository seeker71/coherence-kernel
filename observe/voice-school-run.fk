// voice-school-run.fk — one harvest: the adapter that finished training in
// the data folder is copied into the tree, graded on held-out corpus
// questions beside the base, published to the glass, written to the
// ledger, and committed locally. stdin line 1: data folder (blank -> the
// native one), line 2: the tree folder (blank -> adapters/llama-3.2-3b-voice-native).
// preflight-exec: forbidden
import form/form-stdlib/voice-school.bml;
section [form.bml] {
    def vsr-say(k, v) = print_str(("school " + (k + ("=" + (v + "\n")))));
    def vsr-trim(s) = nothing?(s) ? "" : trim(s);
    def vsr-or(s, d) = (Comparable) len(s) == 0 ? d : s;
    let data = vsr-or(vsr-trim(read_line()), LVData());
    let home = vsr-or(vsr-trim(read_line()), "form/form-stdlib/adapters/llama-3.2-3b-voice-native");
    // line 3: how many held-out rows to grade, and by which question. A number
    // alone grades corpus questions; "perception N" grades the room's own — can
    // the model name the shape a frame took, given only where the frame came from.
    let mode = vsr-trim(read_line());
    str_find(mode, "perception", 0) >= 0 ? {
        let g = vsp-grade(data, (Comparable) len(trim(substring(mode, 10, len(mode)))) == 0 ? VSGrade() : str_to_int(trim(substring(mode, 10, len(mode)))));
        let copied = vs-harvest(data, home);
        vsr-say("perception-grade", vs-cat(["heldout=", g[0].str(), " base-names-the-shape=", g[1].str(), " adapter-names-the-shape=", g[2].str(), " home=", copied, " sha8=", vs-sha8((copied + "/adapters.safetensors"))]));
        0;
    } : !((String) nlw-status(data) == "completed") ? vsr-say("signal", ("nothing reason=" + nlw-status(data))) : {
        let copied = vs-harvest(data, home);
        let cycle = (Number) 1 + (Number) vs-cycles(vs-text(read_file(VSLedger())));
        let grade = vs-grade(data, VSGrade());
        let rows = vs-rows(data);
        let published = vs-publish(hearth-telemetry-root(), cycle, rows, grade, now_unix_ms());
        let line = vs-ledger-line(vs-minute(), cycle, data, rows, grade, vs-sha8((copied + "/adapters.safetensors")));
        let wrote = vs-ledger-append(line);
        vsr-say("harvest", vs-cat(["cycle=", cycle.str(), " rows=", rows.str(), " heldout=", grade[0].str(), " base-hits=", grade[1].str(), " adapter-hits=", grade[2].str(), " glass=", published[1], " commit=", trim(vs-commit(cycle, grade))]));
        0;
    };
}
