; voice-school-run.fk — one harvest: the adapter that finished training in
; the data folder is copied into the tree, graded on held-out corpus
; questions beside the base, published to the glass, written to the
; ledger, and committed locally. stdin line 1: data folder (blank -> the
; native one), line 2: the tree folder (blank -> adapters/llama-3.2-3b-voice-native).
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-school.bml
(do
    (defn vsr-say (k v) (print_str (str_concat "school " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn vsr-trim (s) (if (nothing? s) "" (trim s)))
    (defn vsr-or (s d) (if (eq (str_len s) 0) d s))
    (let data (vsr-or (vsr-trim (read_line)) (LVData)))
    (let home (vsr-or (vsr-trim (read_line)) "form/form-stdlib/adapters/llama-3.2-3b-voice-native"))
    (if (eq (fs-exists? (str_concat data "/train.rc")) 0) (vsr-say "signal" "nothing reason=training-not-finished")
        (do (let copied (host-exec (vs-cat (list "mkdir -p " home " && cp " data "/adapter/adapters.safetensors " data "/adapter/adapter_config.json " home "/ && echo copied")) ""))
            (let cycle (add 1 (vs-cycles (vs-text (read_file (VSLedger))))))
            (let grade (vs-grade data (VSGrade)))
            (let rows (vs-rows data))
            (let published (vs-publish (hearth-telemetry-root) cycle rows grade (now_unix_ms)))
            (let line (vs-ledger-line (trim (vs-text (host-exec "date +%Y-%m-%d-%H:%M" ""))) cycle data rows grade (vs-sha8 (str_concat home "/adapters.safetensors"))))
            (let wrote (vs-ledger-append line))
            (vsr-say "harvest" (vs-cat (list "cycle=" (int_to_str cycle) " rows=" (int_to_str rows) " heldout=" (int_to_str (head grade)) " base-hits=" (int_to_str (nth grade 1)) " adapter-hits=" (int_to_str (nth grade 2)) " glass=" (nth published 1) " commit=" (trim (vs-commit cycle grade)))))
            0)))
