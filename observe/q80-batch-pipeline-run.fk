; q80-batch-pipeline-run.fk — does the batched Q8_0 matmul actually compile on
; THIS device? The cheapest decisive question in the carry: no weights, no 29GB
; seal, just Form emitting MSL and the Metal carrier JIT-compiling it for
; whatever metal_status answered.
;
; Stone 7 (metal_batched_prefill.sh, 2026-07-21, 5 gates) proved one batched pass
; bit-exact against P lane matvecs on the K-quant lane. The Qwen lane never
; inherited it: the generator hardcoded a 256-weight superblock and Q8_0's block
; is 32 weights in 34 bytes. qmb-batch-msl-n now takes the block size, so the
; kernel can be instantiated for this quant at all.
;
; What this run answers is COMPILATION, not correctness. Bit-exactness against
; the Q8_0 lane kernel is a separate claim and needs the harness.
;
; Effectful: touches the GPU. Do not preflight.
; preludes: form/native/metal/qwen35-dense-token-handle.fk

(do
    (defn qbp-line (k v) (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (let msl (q38-msl))
    (qbp-line "device" (metal_status))
    (qbp-line "msl-bytes" (int_to_str (str_len msl)))
    (qbp-line "has-batch-kernel"
        (if (ge (str_find msl "form_q8_0_matmul_batch_f32" 0) 0) "1" "0"))
    (qbp-line "has-q8_0-decode"
        (if (ge (str_find msl "q8_0_wi(" 0) 0) "1" "0"))
    (let p (metal_pipeline msl "form_q8_0_matmul_batch_f32"))
    (qbp-line "batch-pipeline" (int_to_str p))
    (let c (metal_pipeline msl "form_copy_soff_f32"))
    (qbp-line "copy-soff-pipeline" (int_to_str c))
    (let r (metal_pipeline msl "form_rmsnorm_span_f32"))
    (qbp-line "rms-span-pipeline" (int_to_str r))
    (qbp-line "compiled" (if (gt p 0) (if (gt c 0) (if (gt r 0) "yes" "no") "no") "no"))
    (qbp-line "status-after" (metal_status))
    0)
