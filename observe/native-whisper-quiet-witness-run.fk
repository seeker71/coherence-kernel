; preflight-exec: forbidden
; Re-observe large-v3-turbo on the quiet two-second fixture. Disagreement
; with the tiny pin is the claim. Do not rewrite the pin.
; preludes: form-stdlib/native-whisper-quiet-witness.bml
; preludes: ingest/name-build-observe.fk
(do
    (if (eq (nwwq-fixture) 0)
        (do (print (list "quiet-witness" "nothing" "reason" "no-fixture"))
            0)
        (if (le (file_size (str_concat (nws-base) "/weights.safetensors")) 0)
            (do (print (list "quiet-witness" "nothing" "reason" "no-local-checkpoint"))
                0)
            (do
                (let start (host_monotonic_ms))
                (let dir ".hearth/native-whisper-quiet-witness")
                (fs-mkdir ".hearth")
                (fs-mkdir dir)
                (let r (nwwq-run (str_concat dir "/events.jsonl")))
                (let tiny (nwwq-tiny))
                (let large (nwwq-text r))
                (let disagreed (nwwq-disagreed tiny large))
                (print (list "schema" "native-whisper-quiet-witness-v1"
                    "status" (nwwq-status r)
                    "tiny-pin" tiny
                    "large-text" large
                    "disagreed" disagreed
                    "nbo-disagreement" (nbo-enter (list 1 1 disagreed))
                    "retained-buffers" (nth (metal_live) 2)
                    "total-ms" (sub (host_monotonic_ms) start)))
                disagreed))))
