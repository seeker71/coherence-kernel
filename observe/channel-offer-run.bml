// channel-offer-run.bml — a bounded offer into a channel's bell, begun detached by cell-channel.bml (cc-ring, cc-release, cc-patience).
//
// A bell is a fifo; a write into it blocks until a reader opens it. An offer is a gift with bounded patience: this door writes the word
// into the bell by a child (`tee <bell>` fed the word), waits the hearth's crossing window for a reader, and then ends
// the child, so an offer toward a cell that has released never lingers as a blocked process (three did, 2026-09-04).
//
// stdin is the request, one JSON object (cell-channel emits it with the body's JSON emitter into a file the door is begun on, and the
// door removes the file once it has read it):
//   {"request":"<this file>","bell":"<fifo path>","word":"x","seconds":5,"after_ms":0,"only_if":""}
// request names the file the door is begun on. after_ms waits first (a patience as data); only_if names a file that must still stand
// when the wait is over (a cell that already released is never rung by a stale patience). Output: none; the answer is the bell's word
// read, or nothing at all. A request that does not read (malformed JSON, an unknown key, a key of the wrong kind) is refused by name with
// exit 1 (door-options.bml) and its file is left where it was written, as evidence of the writer that made it. Run detached: it prints
// nothing for an offer and its exit is not read.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/host-child.bml
section [form.bml] {
 class ChannelOfferRun {
  def cor-spec() = [["request", "str"], ["bell", "str"], ["word", "str"], ["seconds", "int"], ["after_ms", "int"], ["only_if", "str"]];
  def cor-int(doc, key, fallback) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : fallback;
  def cor-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  // the writer is `tee <bell>` fed the word from a file: tee opens the fifo itself, so it is the child that blocks in open() until a
  // reader comes (a redirect would be opened by this door, which would wait with it and have no deadline); the deadline ends it
  def cor-offer(bell, word, ms) {
   let wordfile = temp_dir() ++ "/channel-offer-" ++ host_pid().str() ++ ".word";
   let w = write_file(wordfile, word);
   let pid = host_spawn_at(["/usr/bin/tee", bell], [wordfile, "/dev/null", "/dev/null"]);
   let done = pid > 0 ? hch-wait(pid, hch-by(ms)) : 0;
   host_path_remove(wordfile);
  }
  def cor-go(doc) {
   let bell = cor-str(doc, "bell");
   let word = cor-str(doc, "word");
   let only = cor-str(doc, "only_if");
   let request = cor-str(doc, "request");
   let taken = len(request) > 0 ? host_path_remove(request) : 0;
   let rested = host_sleep_ms(cor-int(doc, "after_ms", 0));
   len(bell) == 0 || len(word) == 0 || (len(only) > 0 && (Comparable) file_size(only) < 0) ? 0 : cor-offer(bell, word, cor-int(doc, "seconds", 5) * 1000);
  }
 }
 let doc = dop-doc("channel-offer", stdin-text(), cor-spec());
 let done = cor-go(doc);
 0;
}
