// channel-offer-run.bml — a bounded offer into a channel's bell, begun detached by cell-channel.bml (cc-ring, cc-release, cc-patience).
//
// A bell is a fifo; a write into it blocks until a reader opens it. An offer is a gift with bounded patience: this door writes the word
// into the bell by a child (`tee <bell>` fed the word), waits the hearth's crossing window for a reader, and then ends
// the child, so an offer toward a cell that has released never lingers as a blocked process (three did, 2026-09-04). It replaces the
// shell's `( ftimeout N sh -c 'printf x > bell' ) &` and `( sleep N; [ -e pid ] && printf timeout > bell ) &`.
//
// stdin is the request, one JSON object (cell-channel writes it to a file the door is begun on and the door removes it):
//   {"request":"<this file>","bell":"<fifo path>","word":"x","seconds":5,"after_ms":0,"only_if":""}
// request names the file the door is begun on: the door removes it once read.
// after_ms waits first (a patience as data); only_if names a file that must still stand when the wait is over (a cell that already
// released is never rung by a stale patience). Output: none; the answer is the bell's word read, or nothing at all. A request that
// does not read is dropped. Run detached: it prints nothing and its exit is not read.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/json-in-place.bml form-stdlib/bml/host-child.bml form-stdlib/bml/parse.bml
section [form.bml] {
 class ChannelOfferRun {
  def cor-int(text, n, key, fallback) {
   let v = jip-get(text, n, 0, key);
   v < 0 ? fallback : (parse-int(substring(text, v, jip-scalar(text, n, v))) ?? fallback);
  }
  def cor-str(text, n, key) = jip-field(text, n, 0, key) ?? "";
  // the writer is `tee <bell>` fed the word from a file: tee opens the fifo itself, so it is the child that blocks in open() until a
  // reader comes (a redirect would be opened by this door, which would wait with it and have no deadline); the deadline ends it
  def cor-offer(bell, word, ms) {
   let wordfile = temp_dir() ++ "/channel-offer-" ++ host_pid().str() ++ ".word";
   let w = write_file(wordfile, word);
   let pid = host_spawn_at(["/usr/bin/tee", bell], [wordfile, "/dev/null", "/dev/null"]);
   let done = pid > 0 ? hch-wait(pid, hch-by(ms)) : 0;
   host_path_remove(wordfile);
  }
  def cor-go(text) {
   let n = len(text);
   let bell = cor-str(text, n, "bell");
   let word = cor-str(text, n, "word");
   let only = cor-str(text, n, "only_if");
   let request = cor-str(text, n, "request");
   let taken = len(request) > 0 ? host_path_remove(request) : 0;
   let rested = host_sleep_ms(cor-int(text, n, "after_ms", 0));
   len(bell) == 0 || len(word) == 0 || (len(only) > 0 && (Comparable) file_size(only) < 0) ? 0 : cor-offer(bell, word, cor-int(text, n, "seconds", 5) * 1000);
  }
 }
 let request = stdin-text();
 let done = cor-go(request);
 0;
}
