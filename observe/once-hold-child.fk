; once-hold-child: the witness workload for once-hold-band. A top-level
; let builds a value by spinning tick exactly 150001 dispatches; three
; references then read it. Under the once-hold, tick's heat reads 150001
; at exit; under the old call-by-name splice it read 450003 — the heat
; door is the build counter, so no debug build can race the reading.
(defn tick (n) (if (le n 0) 0 (tick (sub n 1))))
(defn build () (do (let z (tick 150000)) (list 7)))
(let HELD (build))
(defn use () (head HELD))
(add (use) (add (use) (use)))
