; prosody-voicing-probe.fk — what correlation does this room's noise reach, and what does a voice reach?
; The voicing threshold is a number that must be MEASURED against both, never assumed. stdin: tenths to listen.
; preflight-exec: forbidden
; preludes: form/form-stdlib/room-prosody.bml

(do
    (defn pv-out (s) (print_str (str_concat s (byte_to_str 10))))
    (defn pv-chunk () (do (let f (sense_mic_stream_read 3200 150)) (if (nothing? f) "" f)))
    (defn pv-loop (n i)
        (if (ge i n) 0
            (do (let c (pv-chunk))
                (let e (rpr-env-of c))
                (let db (if (eq (len e) 0) -1200 (rpr-fmax e -1200)))
                (let rs (if (lt (str_len c) (RPRPitchBytes)) (list) (rpr-rlist (rpr-centred c) (rpr-lag-first) (list))))
                (let p (if (eq (len rs) 0) (list 0 0.0) (rpr-pitch-peak (rpr-centred c) rs)))
                (pv-out (str_concat "db " (str_concat (int_to_str (div db 10)) (str_concat "  r " (str_concat (float_to_str (nth p 1)) (str_concat "  hz " (int_to_str (head p))))))))
                (pv-loop n (add i 1)))))
    (defn pv-first () (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    (let tenths (do (let l (pv-first)) (if (eq (str_len l) 0) 30 (str_to_int l))))
    (let opened (sense_mic_stream_start))
    (let r (pv-loop tenths 0))
    (let closed (sense_mic_stream_stop))
    0)
