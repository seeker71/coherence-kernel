; open-questions.fk — keep two or three questions live, and let a hand answer them.
;
; Urs, 2026-07-23 00:52: "I prefer that you have at least 2 to 3 open questions for me at
; any given time, and offers for interface changes that I can select with a hand gesture we
; can learn together."
;
; So the standing request becomes a checkable invariant rather than an intention: never
; fewer than two open, never more than three. Fewer and he is being led; more and he is
; being interrogated. The band fails if the queue drifts out of that range, which is the
; only way a preference stated once at midnight survives the session that heard it.
;
; THE GESTURE CHANNEL, measured 2026-07-23 00:50 on R5CW20DK17A. Three candidates polled
; four times over twenty seconds:
;   TMD4913 Proximity ........ frozen at 07-20 20:41 — three days stale, no subscriber
;   TMD4913 Light CCT ........ frozen at 07-22 23:51 — no subscriber
;   TMD4913 Auto Brightness .. 00:50:01, 00:50:06, 00:50:19, 00:50:23 — LIVE
; The live one is event-driven rather than periodic (the gaps are 5, 13 and 4 seconds — it
; reports when the value CHANGES), needs no permission, and carries an ordinal level. A
; hand shadowing the sensor is therefore a working one-bit input, today, with no app and no
; consent dialog. Its cost is latency: an event arrives when the OS notices, not when the
; hand moves, so the protocol counts SHADOWS rather than timing them.
;
; Each question carries what would answer it, so an open question is never merely a mood.
; A choice with no gesture assigned cannot be offered — an option a hand cannot reach is
; not on the interface, the same discipline sensing-playbook.fk holds for blocked recipes.
;
; preludes: form-stdlib/core.fk

(do
    (defn oq-min () 2)
    (defn oq-max () 3)

    ; a question = (text kind answered-by gesture status)
    ;   kind      "signal" needs him | "probe" I can measure | "choice" an interface offer
    ;   gesture   how many shadows select it; 0 means not gesture-reachable
    ;   status    1 open, 0 answered
    (defn oq-q (text kind answered-by gesture status)
        (list text kind answered-by gesture status))
    (defn oq-text (q) (nth q 0))
    (defn oq-kind (q) (nth q 1))
    (defn oq-by   (q) (nth q 2))
    (defn oq-gest (q) (nth q 3))
    (defn oq-open? (q) (nth q 4))

    (defn oq-queue ()
        (list
            (oq-q "which readout does your eye land on first — the placement, or the questions?"
                  "signal" "a word, or a button on the panel" 0 1)
            (oq-q "should the ear window drop from 3000 ms, or is transcription worth the spatial ceiling?"
                  "signal" "one shadow for spatial, two for words" 1 1)
            (oq-q "wire the knobs to the real sensors, or keep them as a thinking surface?"
                  "choice" "three shadows to wire them" 3 1)
            (oq-q "does the auto-brightness channel survive a hand at arm's length?"
                  "probe" "poll while you wave; I can answer this one alone" 0 0)))

    (defn oq-count-open (qs)
        (if (eq (len qs) 0) 0
            (add (oq-open? (head qs)) (oq-count-open (tail qs)))))
    (defn oq-in-range? (qs)
        (if (ge (oq-count-open qs) (oq-min))
            (if (le (oq-count-open qs) (oq-max)) 1 0) 0))

    ; every open question names what would answer it — an open question with no answer
    ; route is a complaint, not a question
    (defn oq-routed? (q) (if (eq (oq-open? q) 1) (if (gt (str_len (oq-by q)) 0) 1 0) 1))
    (defn oq-all-routed (qs)
        (if (eq (len qs) 0) 1
            (if (eq (oq-routed? (head qs)) 1) (oq-all-routed (tail qs)) 0)))

    ; a choice is offerable only if a hand can reach it
    (defn oq-offerable? (q)
        (if (str_eq (oq-kind q) "choice") (if (gt (oq-gest q) 0) 1 0) 1))
    (defn oq-count-offerable (qs)
        (if (eq (len qs) 0) 0
            (add (if (eq (oq-open? (head qs)) 1) (oq-offerable? (head qs)) 0)
                 (oq-count-offerable (tail qs)))))

    ; the gesture channel, named and dated so a later reader can re-witness it
    (defn oq-channel () "auto_brightness")
    (defn oq-channel-live? () 1)
    (defn oq-shadows-for (q) (oq-gest q))

    ; --- self-check ---
    (defn oqk (cond bit) (if cond bit 0))
    (defn oq-three ()   (oqk (eq (oq-count-open (oq-queue)) 3) 1))
    (defn oq-range ()   (oqk (eq (oq-in-range? (oq-queue)) 1) 2))
    (defn oq-too-few () (oqk (eq (oq-in-range? (list (oq-q "x" "signal" "y" 0 1))) 0) 4))
    (defn oq-too-many ()
        (oqk (eq (oq-in-range? (list (oq-q "a" "signal" "y" 0 1) (oq-q "b" "signal" "y" 0 1)
                                     (oq-q "c" "signal" "y" 0 1) (oq-q "d" "signal" "y" 0 1))) 0) 8))
    (defn oq-routed ()  (oqk (eq (oq-all-routed (oq-queue)) 1) 16))
    (defn oq-offer ()   (oqk (eq (oq-count-offerable (oq-queue)) 3) 32))
    ; a choice nobody can reach by hand is not offerable
    (defn oq-unreachable ()
        (oqk (eq (oq-offerable? (oq-q "z" "choice" "nothing" 0 1)) 0) 64))
    (defn oq-chan ()    (oqk (str_eq (oq-channel) "auto_brightness") 128))
    (defn open-questions-check ()
        (add (add (add (oq-three) (oq-range)) (add (oq-too-few) (oq-too-many)))
        (add (add (oq-routed) (oq-offer)) (add (oq-unreachable) (oq-chan)))))
)
