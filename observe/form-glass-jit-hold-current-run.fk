; Physical producer-to-Glass witness for the exact JIT refusal membrane.
; A real demand-JIT request is deliberately denied its runtime identity once,
; Glass writes the resulting fault frame and holds, the still-available Form
; path answers, and the automatic cause-bound retry publishes the exact heal.
; The isolated telemetry/cache root is removed after observation.
; preludes: form-stdlib/bml-demand-jit.fk form-stdlib/bml/bml-demand-jit-glass.bml form-stdlib/form-glass-live.bml observe/say.fk

(do
    (defn fgjhw-program ()
        (list (list 1 7) (list 2) (list 1 3)
            (list 5 1 2) (list 3 3 0)))
    (let root "/tmp/form-glass-jit-hold-witness")
    (let source "/tmp/form-glass-jit-hold-witness/source.bml")
    (let cache "/tmp/form-glass-jit-hold-witness/leaf.cache")
    (let publisher (FGLJitPublisher))
    (let final-path (fgtm-snapshot-path root publisher))
    (let candidate-path (fgtm-snapshot-candidate-path root publisher))
    (let prior-lock (bdj-release-publish-lock cache))
    (let prior-cache (fs-remove-file cache))
    (let prior-source (fs-remove-file source))
    (let prior-final (fs-remove-file final-path))
    (let prior-candidate (fs-remove-file candidate-path))
    (let clean-before (fs-remove-tree root))
    (let made (fs-mkdir root))
    (let wrote-source (write_file_text source "section [form.bml] { 0; }"))

    ; This is the actual refusal: the runtime identity required to install a
    ; callable page is absent. The fault is produced by bdj, not the witness.
    (let first (bdj-request (bdj-empty (now_unix_ms)) source cache
        (fgjhw-program) 4 3))
    (let fault-step (bdj-step-with-runtime (bdj-receipt-state first) ""))
    (let fault-state (bdj-step-state fault-step))
    (let fault-epoch (now_unix_ms))
    (let fault-publish (bdjg-publish-comparison-at root publisher fault-epoch
        0 first fault-step 0 0 first fault-step 0))
    (let fault-read (fgl-jit-current-samples-at root))
    (let selected (fgl-jit-fault-sample fault-read (list)))

    ; Use the real frame/event-loop path. A successful stdout write commits the
    ; fault frame into the front buffer and disposition becomes heal-hold.
    (let fault-frame (fgd-segment-frame 88 12 fault-epoch "jit"
        (list) fault-read (list publisher) "JIT HEALING P1000"))
    (let empty-buffer (fgel-buffer-empty))
    (let held-plan (fgel-plan-wake
        (fgel-schedule-start fault-epoch 250) empty-buffer
        (fgl-jit-fault-wake selected) fault-frame))
    (let planned-buffer (fgel-plan-buffer held-plan))
    (let write-result (fgl-render-frame
        (fgel-buffer-front empty-buffer)
        (fgel-buffer-front planned-buffer)))
    (let shown-buffer (fgl-render-commit
        write-result empty-buffer planned-buffer))

    ; Optimization failure cannot deny the request. The original pending graph
    ; remains in the state while Form answers this request directly.
    (let during (bdj-request fault-state source cache
        (fgjhw-program) 4 1))
    (let same-pending (str_eq
        (bdj-pending-program-wire (bdj-state-pending fault-state))
        (bdj-pending-program-wire
            (bdj-state-pending (bdj-receipt-state during)))))

    ; The next bdj step automatically re-observes the physical runtime identity.
    ; Only successful install plus point challenge can create this healed row.
    (let heal-step (bdj-step (bdj-receipt-state during)))
    (let heal-epoch (now_unix_ms))
    (let heal-publish (bdjg-publish-comparison-at root publisher heal-epoch
        0 first fault-step 0 0 first heal-step (file_size cache)))
    (let heal-read (fgl-jit-current-samples-at root))
    (let healed (fgl-jit-healed-for heal-read selected))
    (let resumed (fgel-resume-held held-plan
        (fgl-jit-healed-wake healed)))

    (let checks (sum (list
        (if (str_eq (bdjg-publish-status fault-publish) "published") 1 0)
        (if (str_eq (bdj-step-status fault-step) "jit-fault-attention") 2 0)
        (if (gt (len selected) 0) 4 0)
        (if (str_eq (fgel-plan-disposition held-plan) "heal-hold") 8 0)
        (if (eq (fgel-buffer-presented shown-buffer) 1) 16 0)
        (if (str_eq (bdj-receipt-status during)
                "jit-healing-form-answer") 32 0)
        (if (str_eq (bdj-receipt-route during) "form-attention") 64 0)
        (if (eq same-pending 1) 128 0)
        (if (str_eq (bdj-step-status heal-step) "jit-healed") 256 0)
        (if (str_eq (bdjg-publish-status heal-publish) "published") 512 0)
        (if (gt (len healed) 0) 1024 0)
        (if (str_eq (fgel-plan-disposition resumed) "present") 2048 0))))
    (let observed (eq checks 4095))
    (let clean-cache-lock (bdj-release-publish-lock cache))
    (let clean-cache (fs-remove-file cache))
    (let clean-source (fs-remove-file source))
    (let clean-final (fs-remove-file final-path))
    (let clean-candidate (fs-remove-file candidate-path))
    (let clean-after (fs-remove-tree root))
    (say-line (ftc-cat (list
        "glass-jit-hold-current observed=" (if observed "yes" "no")
        " checks=" (int_to_str checks) "/4095"
        " fault=" (bdj-step-status fault-step)
        " priority=" (if (eq (len selected) 0) "absent"
            (int_to_str (fgtm-field-value (fgtm-sample-capacity selected))))
        " frame=" (fgel-plan-disposition held-plan)
        " write=" (int_to_str write-result)
        " committed=" (int_to_str (fgel-buffer-presented shown-buffer))
        " form=" (bdj-receipt-status during)
        " pending=" (if same-pending "preserved" "changed")
        " heal=" (bdj-step-status heal-step)
        " resume=" (fgel-plan-disposition resumed)
        " isolated-clean=" (if (eq (fs-exists? root) 0) "yes" "no"))))
    (if observed 0 1))
