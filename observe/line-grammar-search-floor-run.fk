; line-grammar-search-floor-run.fk — the allocating line floor and the healed
; one, run against each other in ONE process, in the same second, on the same
; rows. The machine's mood is the loudest thing in a wall-clock reading on this
; host right now (corpus row 1321), and two runs of one cell cannot subtract it.
; Two loops inside one process can: whatever the machine is doing, it is doing
; it to both.
;
; The workload is the body's own: the locale rows, split on "|" and trimmed,
; the shape meaning-codes walks a quarter of a million times per round.
;
; preflight-exec: forbidden
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk

(do
    ; ── the line-grammar.fk bodies as they stood before 2026-09-08 ──────────
    (defn lgsf-ref-find-loop (s needle i)
        (if (gt (add i (str_len needle)) (str_len s)) (sub 0 1)
            (if (str_eq (substring s i (add i (str_len needle))) needle) i
                (lgsf-ref-find-loop s needle (add i 1)))))
    (defn lgsf-ref-find-from (s needle start) (lgsf-ref-find-loop s needle start))
    (defn lgsf-ref-split-loop (s sep i acc)
        (do (let pos (lgsf-ref-find-from s sep i))
            (if (lt pos 0)
                (reverse-acc (cons (substring s i (str_len s)) acc))
                (lgsf-ref-split-loop s sep (add pos (str_len sep))
                                     (cons (substring s i pos) acc)))))
    (defn lgsf-ref-split-on (s sep) (lgsf-ref-split-loop s sep 0 (empty)))
    (defn lgsf-ref-trim-leading (s)
        (if (eq (str_len s) 0) s
            (if (is-ws-cp (ord (char_at s 0)))
                (lgsf-ref-trim-leading (substring s 1 (str_len s))) s)))
    (defn lgsf-ref-trim-trailing (s)
        (if (eq (str_len s) 0) s
            (if (is-ws-cp (ord (char_at s (sub (str_len s) 1))))
                (lgsf-ref-trim-trailing (substring s 0 (sub (str_len s) 1))) s)))
    (defn lgsf-ref-trim (s) (lgsf-ref-trim-leading (lgsf-ref-trim-trailing s)))
    (defn lgsf-ref-lines-loop (s i start line acc)
        (if (eq i (str_len s))
            (if (gt i start)
                (reverse-acc (cons (list (substring s start i) line) acc))
                (reverse-acc acc))
            (if (eq (ord (char_at s i)) 10)
                (lgsf-ref-lines-loop s (add i 1) (add i 1) (add line 1)
                                     (cons (list (substring s start i) line) acc))
                (lgsf-ref-lines-loop s (add i 1) start line acc))))
    (defn lgsf-ref-lines (s) (lgsf-ref-lines-loop s 0 0 1 (empty)))
    (defn lgsf-ref-starts-with? (text prefix)
        (if (lt (str_len text) (str_len prefix)) false
            (str_eq (substring text 0 (str_len prefix)) prefix)))

    ; ── the rows ────────────────────────────────────────────────────────────
    (defn lgsf-texts (lns)
        (if (eq (len lns) 0) (empty)
            (cons (line-text (head lns)) (lgsf-texts (tail lns)))))
    (defn lgsf-rows (path) (lgsf-texts (lines-from-source (read_file path))))
    (defn lgsf-pad (rows)
        (if (eq (len rows) 0) (empty)
            (cons (str_concat "      " (str_concat (head rows) "   \t "))
                  (lgsf-pad (tail rows)))))
    (defn lgsf-bytes (rows acc)
        (if (eq (len rows) 0) acc
            (lgsf-bytes (tail rows) (add acc (str_len (head rows))))))

    ; ── four loops, two shapes ──────────────────────────────────────────────
    (defn lgsf-new-pass (rows acc)
        (if (eq (len rows) 0) acc
            (lgsf-new-pass (tail rows) (add acc (len (split-on (head rows) "|"))))))
    (defn lgsf-new-reps (rows n acc)
        (if (le n 0) acc (lgsf-new-reps rows (sub n 1) (lgsf-new-pass rows acc))))
    (defn lgsf-ref-pass (rows acc)
        (if (eq (len rows) 0) acc
            (lgsf-ref-pass (tail rows) (add acc (len (lgsf-ref-split-on (head rows) "|"))))))
    (defn lgsf-ref-reps (rows n acc)
        (if (le n 0) acc (lgsf-ref-reps rows (sub n 1) (lgsf-ref-pass rows acc))))

    (defn lgsf-tnew-pass (rows acc)
        (if (eq (len rows) 0) acc
            (lgsf-tnew-pass (tail rows) (add acc (str_len (trim (head rows)))))))
    (defn lgsf-tnew-reps (rows n acc)
        (if (le n 0) acc (lgsf-tnew-reps rows (sub n 1) (lgsf-tnew-pass rows acc))))
    (defn lgsf-tref-pass (rows acc)
        (if (eq (len rows) 0) acc
            (lgsf-tref-pass (tail rows) (add acc (str_len (lgsf-ref-trim (head rows)))))))
    (defn lgsf-tref-reps (rows n acc)
        (if (le n 0) acc (lgsf-tref-reps rows (sub n 1) (lgsf-tref-pass rows acc))))

    ; ── a whole file, one search, the degrading case core.fk named ──────────
    (defn lgsf-tail-needle () "no-such-token-anywhere-in-this-file")

    ; ── the two other per-byte cutters in the same file ─────────────────────
    (defn lgsf-lnew-reps (s n acc)
        (if (le n 0) acc (lgsf-lnew-reps s (sub n 1) (add acc (len (lines-from-source s))))))
    (defn lgsf-lref-reps (s n acc)
        (if (le n 0) acc (lgsf-lref-reps s (sub n 1) (add acc (len (lgsf-ref-lines s))))))
    (defn lgsf-snew-pass (rows mark acc)
        (if (eq (len rows) 0) acc
            (lgsf-snew-pass (tail rows) mark (add acc (if (starts-with? (head rows) mark) 1 0)))))
    (defn lgsf-snew-reps (rows mark n acc)
        (if (le n 0) acc (lgsf-snew-reps rows mark (sub n 1) (lgsf-snew-pass rows mark acc))))
    (defn lgsf-sref-pass (rows mark acc)
        (if (eq (len rows) 0) acc
            (lgsf-sref-pass (tail rows) mark (add acc (if (lgsf-ref-starts-with? (head rows) mark) 1 0)))))
    (defn lgsf-sref-reps (rows mark n acc)
        (if (le n 0) acc (lgsf-sref-reps rows mark (sub n 1) (lgsf-sref-pass rows mark acc))))

    (defn lgsf-cat (xs)
        (if (eq (len xs) 0) "" (str_concat (head xs) (lgsf-cat (tail xs)))))
    (defn lgsf-say (what refms newms bytes)
        (print (lgsf-cat (list what "  allocating " (int_to_str refms)
                               " ms   routed " (int_to_str newms)
                               " ms   bytes walked " (int_to_str bytes)))))

    (let reps 6000)
    (let rows (append (lgsf-rows "form/form-stdlib/locale-rows/symbol-words.rows")
                      (lgsf-rows "form/form-stdlib/locale-rows/symbol-perception.rows")))
    (let padded (lgsf-pad rows))
    (let rowbytes (lgsf-bytes rows 0))
    (let corpus (read_file "learn/homecoming-distillation-corpus.fk"))

    ; warm both shapes once so neither pays a first-touch the other does not
    (let w1 (lgsf-new-reps rows 1 0))
    (let w2 (lgsf-ref-reps rows 1 0))
    (let w3 (lgsf-tnew-reps padded 1 0))
    (let w4 (lgsf-tref-reps padded 1 0))

    (let a0 (now_unix_ms))
    (let refsplit (lgsf-ref-reps rows reps 0))
    (let a1 (now_unix_ms))
    (let newsplit (lgsf-new-reps rows reps 0))
    (let a2 (now_unix_ms))

    (let b0 (now_unix_ms))
    (let reftrim (lgsf-tref-reps padded reps 0))
    (let b1 (now_unix_ms))
    (let newtrim (lgsf-tnew-reps padded reps 0))
    (let b2 (now_unix_ms))

    (let c0 (now_unix_ms))
    (let refscan (lgsf-ref-find-from corpus (lgsf-tail-needle) 0))
    (let c1 (now_unix_ms))
    (let newscan (find-from corpus (lgsf-tail-needle) 0))
    (let c2 (now_unix_ms))

    (let d0 (now_unix_ms))
    (let reflines (lgsf-lref-reps corpus 3 0))
    (let d1 (now_unix_ms))
    (let newlines (lgsf-lnew-reps corpus 3 0))
    (let d2 (now_unix_ms))

    (let e0 (now_unix_ms))
    (let refsw (lgsf-sref-reps rows "(row " reps 0))
    (let e1 (now_unix_ms))
    (let newsw (lgsf-snew-reps rows "(row " reps 0))
    (let e2 (now_unix_ms))

    (let s1 (lgsf-say "split-on over the locale rows " (sub a1 a0) (sub a2 a1) (mul rowbytes reps)))
    (let s2 (lgsf-say "trim over padded locale rows  " (sub b1 b0) (sub b2 b1) (mul (lgsf-bytes padded 0) reps)))
    (let s3 (lgsf-say "one miss over the whole corpus" (sub c1 c0) (sub c2 c1) (str_len corpus)))
    (let s5 (lgsf-say "lines-from-source, whole corpus" (sub d1 d0) (sub d2 d1) (mul (str_len corpus) 3)))
    (let s6 (lgsf-say "starts-with? miss on real rows" (sub e1 e0) (sub e2 e1) (mul rowbytes reps)))
    (let s7 (print (lgsf-cat (list "  same answers: lines " (int_to_str reflines) " / " (int_to_str newlines)
                                   "   starts-with? " (int_to_str refsw) " / " (int_to_str newsw)))))
    (let s4 (print (lgsf-cat (list "  same answers: splits "
                                  (int_to_str refsplit) " / " (int_to_str newsplit)
                                  "   trims " (int_to_str reftrim) " / " (int_to_str newtrim)
                                  "   scan " (int_to_str refscan) " / " (int_to_str newscan)))))
    (if (and (and (eq refsplit newsplit) (eq reflines newlines))
            (and (eq refsw newsw) (and (eq reftrim newtrim) (eq refscan newscan)))) 1 0))
