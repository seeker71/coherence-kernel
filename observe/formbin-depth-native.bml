// The native process retains the continuation. The proof carrier receives only
// postorder node rows and sends measured elapsed time and GC activity back.
// preludes: form-stdlib/bml/formbin-depth.bml
section [form.bml] {
 class FormbinNative {
  def fbn-numbers(xs) = nil?(xs) ? 0 : fbn-number-step(xs);
  def fbn-number-step(xs) {
   print(xs[0]);
   fbn-numbers(xs[1:]);
  }
  def fbn-rows(rows) = nil?(rows) ? print("") : fbn-row-step(rows);
  def fbn-row-step(rows) {
   let row = rows[0];
   print(row[0].str() ++ " " ++ row[1].str() ++ " " ++ row[2].str());
   fbn-rows(fbd-rest(rows));
  }
  def fbn-loop(source, state, quantum, watermark, attention, exchange, round) {
   let began = host_monotonic_ms();
   let step = fbd-slice(source, state, quantum);
   let elapsed = host_monotonic_ms() - began;
   let st = step[0];
   fbn-numbers([st[0], st[2], st[3], st[4]]);
   print(st[5]);
   fbn-numbers([st[6], elapsed]);
   fbn-rows(step[1]);
   let carrierElapsed = str_to_int(read_line());
   let collections = str_to_int(read_line());
   let decision = fbd-control-row([st[3], watermark, quantum, fbd-max(elapsed, carrierElapsed), attention, collections], exchange, round);
   fbn-numbers(decision);
   st[4] >= 2 ? 0 :
    (String) read_line() == "continue" ? fbn-loop(source, st, decision[3], decision[2], attention, exchange, round + 1) : 0;
  }
  def fbn-run() {
   let path = read_line();
   nothing?(path) || ((String) path == "") ? 0 : fbn-open(path);
  }
  def fbn-open(path) {
   let start = str_to_int(read_line());
   let exchange = str_to_int(read_line());
   let source = read_file(path);
   let initial = fbd-initial-attention();
   fbn-numbers(initial);
   fbn-loop(source, fbd-start(start), initial[0], initial[1], initial[2], exchange, 0);
  }
 }
 0;
}
