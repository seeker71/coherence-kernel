// The native process retains the continuation. The proof carrier receives only
// postorder node rows and sends measured elapsed time and GC activity back.
// preludes: form-stdlib/bml/formbin-depth.bml
section [form.bml] {
 class FormbinNative {
  def fbn-numbers(xs) = if nil?(xs) then 0 else fbn-number-step(xs);
  def fbn-number-step(xs) {
   print(head(xs));
   fbn-numbers(tail(xs));
  }
  def fbn-rows(rows) = if nil?(rows) then print("") else fbn-row-step(rows);
  def fbn-row-step(rows) {
   let row = head(rows);
   print(str_concat(int_to_str(head(row)), str_concat(" ", str_concat(int_to_str(nth(row, 1)), str_concat(" ", int_to_str(nth(row, 2)))))));
   fbn-rows(fbd-rest(rows));
  }
  def fbn-loop(source, state, quantum, watermark, attention, exchange, round) {
   let began = host_monotonic_ms();
   let step = fbd-slice(source, state, quantum);
   let elapsed = sub(host_monotonic_ms(), began);
   let st = head(step);
   fbn-numbers(list(nth(st, 0), nth(st, 2), nth(st, 3), nth(st, 4)));
   print(nth(st, 5));
   fbn-numbers(list(nth(st, 6), elapsed));
   fbn-rows(nth(step, 1));
   let carrierElapsed = str_to_int(read_line());
   let collections = str_to_int(read_line());
   let decision = fbd-control-row(list(nth(st, 3), watermark, quantum, fbd-max(elapsed, carrierElapsed), attention, collections), exchange, round);
   fbn-numbers(decision);
   if ge(nth(st, 4), 2) then 0 else
    if str_eq(read_line(), "continue") then fbn-loop(source, st, nth(decision, 3), nth(decision, 2), attention, exchange, add(round, 1)) else 0;
  }
  def fbn-run() {
   let path = read_line();
   if or(nothing?(path), str_eq(path, "")) then 0 else fbn-open(path);
  }
  def fbn-open(path) {
   let start = str_to_int(read_line());
   let exchange = str_to_int(read_line());
   let source = read_file(path);
   let initial = fbd-initial-attention();
   fbn-numbers(initial);
   fbn-loop(source, fbd-start(start), head(initial), nth(initial, 1), nth(initial, 2), exchange, 0);
  }
 }
 0;
}
