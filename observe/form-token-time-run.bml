// form-token-time-run.bml — where a training run's time goes, read from the run's own events.
//
//   printf 'events .hearth/form-token-lora/llama-1791695568140/training-events.fkb\n' | ./fkwu observe/form-token-time-run.bml
//   printf 'events EVENTS.fkb\nledger LEDGER.fkb\n' | ./fkwu observe/form-token-time-run.bml        the cycle's stage walls as well
//
// The trainer writes an event for every phase it walks (training-events.fkb, a ledger of Form nodes, form-value-nodes.bml; a path
// ending .rows is read as form-rows text, the older checkouts' and a person's): the open of
// the model, the baseline validation, the assessment, and for every row its forward and backward milliseconds and the device's own
// busy microseconds, for every round its tokenize, training, update and checkpoint milliseconds. This reads them back and says,
// in one block, where the wall clock went: each phase's milliseconds and its share of the run, a row's forward and backward
// against the device's busy time (the rest is dispatch, sync and the walker's own work), and the milliseconds a token costs each
// way. The cycle's ledger (ledger.rows), when given, adds each stage's wall (refresh, census, carrier, train, evaluation, usage).
// stdin: `events PATH` and, optionally, `ledger PATH` (frw-options). Reads only; opens no model.
// preflight-exec: forbidden
import form-stdlib/bml/form-rows.bml;
import form-stdlib/bml/form-value-nodes.bml;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class FormTokenTimeRun {
  def ftt-of(rows, stage) = filter(r => (String) frw-str(r, "stage", "") == stage, rows);
  def ftt-n(r, key) = frw-int(r, key, 0);
  def ftt-sum(rows, key) = foldl((a, r) => a + ftt-n(r, key), 0, rows);
  def ftt-max(rows, key) = foldl((m, r) => ftt-n(r, key) > m ? ftt-n(r, key) : m, 0, rows);
  def ftt-mean(rows, key) = len(rows) == 0 ? 0 : ftt-sum(rows, key) / len(rows);
  def ftt-max0(x) = x < 0 ? 0 : x;
  def ftt-pct(part, whole) = whole <= 0 ? "-" : ((part * 1000) / whole / 10).str() ++ "." ++ (((part * 1000) / whole) % 10).str() ++ "%";
  def ftt-s(ms) = (ms / 1000).str() ++ "." ++ ((ms % 1000) / 100).str() ++ " s";
  def ftt-say(t) = print_str("[form-token-time] " ++ t);
  def ftt-span(rows) = ftt-max(rows, "at_ms") - foldl((m, r) => ftt-n(r, "at_ms") < m ? ftt-n(r, "at_ms") : m, ftt-max(rows, "at_ms"), rows);
  def ftt-phase(name, ms, whole) = ftt-say(name ++ ": " ++ ftt-s(ms) ++ " (" ++ ftt-pct(ms, whole) ++ " of the run)");
  // the rows of a file, or none (said) when it is absent or refused
  def ftt-rows(path) = ftt-rows-of(path, fvn-rows-of(path));
  def ftt-rows-of(path, r) = (String) r[0] == "ok" ? r[1] : ftt-refused(path, r);
  def ftt-refused(path, r) {
   let said = ftt-say(path ++ " was refused at line " ++ r[2].str() ++ ": " ++ r[1]);
   [];
  }
  def ftt-report(rows) {
   let opened = ftt-sum(ftt-of(rows, "admitted"), "open_ms");
   let checks = ftt-of(rows, "validation");
   let validBefore = ftt-sum(filter(r => ftt-n(r, "optimizer_step") == 0, checks), "wall_ms");
   let validAfter = ftt-sum(filter(r => ftt-n(r, "optimizer_step") != 0, checks), "wall_ms");
   let valid = validBefore + validAfter;
   let assess = ftt-sum(ftt-of(rows, "assessment-before"), "wall_ms") + ftt-sum(ftt-of(rows, "assessment-after"), "wall_ms");
   let rounds = ftt-of(rows, "round");
   let walks = ftt-of(rows, "row");
   let run = ftt-span(rows) + opened;
   let training = ftt-sum(rounds, "training_ms");
   let update = ftt-sum(rounds, "update_ms");
   let token = ftt-sum(rounds, "tokenize_ms");
   let check = ftt-sum(rounds, "checkpoint_ms");
   let fwd = ftt-sum(walks, "forward_ms");
   let bwd = ftt-sum(walks, "backward_ms");
   let fgpu = ftt-sum(walks, "forward_gpu_us") / 1000;
   let bgpu = ftt-sum(walks, "backward_gpu_us") / 1000;
   let tokens = ftt-sum(walks, "input_tokens");
   let said = ftt-say("run " ++ ftt-s(run) ++ ": " ++ len(rounds).str() ++ " round(s), " ++ len(walks).str() ++ " row(s), " ++ tokens.str() ++ " input tokens");
   let a = ftt-phase("open the model", opened, run);
   let b = ftt-phase("held-out validation before training (the baseline, remembered when nothing moved)", validBefore, run);
   let b2 = ftt-phase("held-out validation after training", validAfter, run);
   // the device's own busy milliseconds against the phase's wall (events written before 2026-10-13 carry none)
   let b3 = any?(r => frw-has?(r, "device_busy_ms"), checks) ? ftt-say("validation: the device busy " ++ ftt-s(ftt-sum(checks, "device_busy_ms")) ++ " of " ++ ftt-s(valid) ++ " (" ++ ftt-pct(ftt-sum(checks, "device_busy_ms"), valid) ++ "); the rest is the host, the sync and the neighbours") : 0;
   let b4 = any?(r => frw-has?(r, "host_gpu_busy_ms"), checks) ? ftt-say("validation: the whole GPU was busy " ++ ftt-s(ftt-sum(checks, "host_gpu_busy_ms")) ++ " (" ++ ftt-pct(ftt-sum(checks, "host_gpu_busy_ms"), valid) ++ "), this process " ++ ftt-s(ftt-sum(checks, "device_busy_ms")) ++ ": the neighbours' share was " ++ ftt-s(ftt-max0(ftt-sum(checks, "host_gpu_busy_ms") - ftt-sum(checks, "device_busy_ms"))) ++ " of it") : 0;
   let c = ftt-phase("assessments", assess, run);
   let d = ftt-phase("rounds: training", training, run);
   let e = ftt-phase("rounds: update (Adam, adapter write)", update, run);
   let f = ftt-phase("rounds: tokenize + checkpoint", token + check, run);
   let g = ftt-phase("not accounted (between phases)", run - opened - valid - assess - training - update - token - check, run);
   let h = ftt-say("a row: forward " ++ ftt-s(ftt-mean(walks, "forward_ms")) ++ " mean, " ++ ftt-s(ftt-max(walks, "forward_ms")) ++ " worst; backward " ++ ftt-s(ftt-mean(walks, "backward_ms")) ++ " mean, " ++ ftt-s(ftt-max(walks, "backward_ms")) ++ " worst");
   let i = ftt-say("the device's own busy time: forward " ++ ftt-pct(fgpu, fwd) ++ " of its wall, backward " ++ ftt-pct(bgpu, bwd) ++ " (the rest is dispatch, sync and the walker)");
   let j = ftt-say("per input token: forward " ++ (tokens == 0 ? 0 : fwd * 100 / tokens).str() ++ " centi-ms, backward " ++ (tokens == 0 ? 0 : bwd * 100 / tokens).str() ++ " centi-ms; dispatches a row " ++ ftt-mean(walks, "dispatches").str());
   0;
  }
  def ftt-ledger(path) {
   let rows = ftt-rows(path);
   let said = map(r => ftt-say("stage " ++ frw-str(r, "stage", "") ++ ": " ++ ftt-s(ftt-n(r, "wall_ms")) ++ ((String) frw-str(r, "stopped", "") == "" ? "" : " STOPPED " ++ frw-str(r, "stopped", ""))), rows);
   0;
  }
  def ftt-run() = ftt-with(frw-options(stdin-text() ?? ""));
  def ftt-with(o) {
   if (String) o[0] != "ok" then ftt-say("the options were refused at line " ++ o[2].str() ++ ": " ++ o[1])
   else if !frw-has?(o[1], "events") then ftt-say("give `events PATH` (a run's training-events.fkb) and, after it, `ledger PATH` for the cycle's stage walls")
   else {
    let r = ftt-report(ftt-rows(frw-str(o[1], "events", "")));
    frw-has?(o[1], "ledger") ? ftt-ledger(frw-str(o[1], "ledger", "")) : 0;
   };
  }
 }
 ftt-run();
}
