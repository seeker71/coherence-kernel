// flow-run.bml — one open request carried through the whole flow in ONE pass over the resident server's spool: plan -> candidate -> apply -> band -> land.
//
//   echo '{"request":"frq-080c39296b126850","slot":0}' | ./fkwu observe/flow-run.bml
//
// stdin, one JSON line, strict: request (the id in learn/local-requests.jsonl; absent: the best ranked request the triage pass left in the ledger that no flow has carried), slot (0..13: the signal frame /fgn-flow-NN this flow gives its cells into),
// dir (the spool, default /tmp/form-serve), land (1: a band-full candidate lands through observe/land-run.bml with main:1; default 0), plan (0: a request the
// queue does not carry is not planned; default 1), repairs (the micro-repairs a stage may fail before it passes forward, default 2).
//
// Offline: every generation is the resident server's (rent_tokens 0). PARTIAL RESULTS PASS FORWARD: a stage that cannot finish says so in a cell and the next
// stage runs with what stands (a refused plan runs the candidate from the request's own words and reads the compile as its witness), so one run shows many
// issues, and nothing here refuses to continue: no GPU-minute pre-check, no retry that replays the same plan.
// What the flow meets is a CELL in shared memory (form-stdlib/bml/flow-signal.bml: the frame and its picture row; observe/flow-watch-run.bml subscribes), never a
// ledger row per step. The NERVOUS SYSTEM is fl-react: a discomfort cell (compile error, unresolved name, arity miss, stray token, a case that failed by printing its
// form, an edit whose old text is not there, no edit blocks) is answered where it was felt with the smallest repair for its kind, without ending the flow:
// a deterministic one where the body knows one (the old text found by trimmed lines; the missing prelude named in the file's header from where the name is
// defined), else ONE small scoped ask of the local voice through the spool with the compiler's words and the nearby definitions. Each repair is its own cell
// (kind fix, its ms, the file's length before>after). Two failed micro-repairs pass the stage forward as partial.
// Disk gets ONE sparse row at the end (receipts/local-plan-ledger.jsonl, rung "flow"), and the edits of a candidate that did not land are put back.
// stdout: one JSON line, the end: request, verdict (landed | green | partial | ended), cause, got, missed, repairs, ms, rent_tokens 0.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/serve-sched.bml form-stdlib/bml/serve-client.bml form-stdlib/bml/flow-signal.bml form-stdlib/bml/host-child.bml form-stdlib/bml/cell-said.bml form-stdlib/bml/string-join.bml form-stdlib/bml/def-window.bml form-stdlib/spool-bell-transport.fk
import form-stdlib/gpu-lease.bml;
section [form.bml] {
 class FlowRun {
  def fl-spec() = [["request", "str"], ["slot", "int"], ["dir", "str"], ["land", "int"], ["plan", "int"], ["repairs", "int"], ["loop", "int"], ["counsel", "int"], ["ledger", "str"], ["isolated", "int"]];
  def fl-queue() = "learn/native-turn-queue.jsonl";
  def fl-requests() = "learn/local-requests.jsonl";
  def fl-planner-ledger() = ".hearth/local-plans/ledger.jsonl";
  // the ranked rows the flow picks from and the end row it leaves: one file by the path the launcher names (the source tree's), whatever tree the flow works in
  def fl-ledger-of(o) = svs-str(o, "ledger", "receipts/local-plan-ledger.jsonl");
  def fl-band-ms() = 600000;
  // no answer cap: the voice ends its own turn (an edit block cut mid-way is work destroyed); the server's context is the only bound
  // No count bounds an answer: the voice ends its own turn, and the server reads every sequence's tail for a repeating period and answers it inline (a draw to leave the greedy
  // attractor, then, if it persists, an end named adapted-repeat that delivers what was said; serve-sched.bml svs-loop-react)
  def fl-ask-tokens(packet) = 0;
  // ── reading rows and files ──
  // A path that is a stretch of the compiler's words (a newline, or longer than any path the body holds) names no file: handed to the host door it overran fk_cstr and ended the whole flow pass (2026-11-15)
  def fl-path?(p) = len(p) > 0 && len(p) < 512 && str_find(p, "\n", 0) < 0;
  def fl-text(path) = fl-path?(path) ? (read_file(path) ?? "") : "";
  def fl-last-line(lines, needle) = foldl((acc, l) => str_find(l, needle, 0) >= 0 ? l : acc, "", lines);
  def fl-row(path, needle) {
   let line = fl-last-line(split-on(fl-text(path), "\n"), needle);
   len(line) == 0 ? nothing() : try parse-json("flow-row", line) catch nothing();
  }
  def fl-strs(row, key) = !nothing?(row) && json-object-has?(row, key) ? map(n => json-string-value(n), json-array-elements(json-object-get(row, key))) : [];
  def fl-cat(parts) = str-join(parts);
  def fl-head(s, n) = len(s) <= n ? s : substring(s, 0, n);
  def fl-line(s) = fl-head(trim(s), 24);
  // ── the flow's state: one record, the signal frame inside it ──
  def fl-new(o, id) = record_new(0, "F", fsg-new(svs-int(o, "slot", 0), id), "id", id, "dir", svs-str(o, "dir", svc-default-dir()), "land", svs-int(o, "land", 0), "plan", svs-int(o, "plan", fl-arm(id)), "allow", svs-int(o, "repairs", 5), "seen", [], "names", [], "counsel", svs-int(o, "counsel", 0), "isolated", svs-int(o, "isolated", 0), "ledger", fl-ledger-of(o), "oldasks", 0, "oasks", 0, "t0", host_monotonic_ms(),
   "row", nothing(), "req", nothing(), "goal", "", "paths", [], "band", "", "full", 0, "orig", [], "got", 0, "miss", 0, "fails", 0, "reply", "", "ask0", "", "thread", "", "red", [], "outs", "", "cause", "", "verdict", "ended", "applied", 0, "green", 0, "landed", 0, "said", "", "mf", [], "contrasted", 0, "unweakened", 0, "grounded", 0, "words", "", "temp", 0, "last", "");
  def fl-emit(S, stage, kind, got, missed, why, ids, ms) = fsg-emit(record_get(S, "F"), stage, kind, got, missed, why, ids, ms);
  def fl-since(t) = host_monotonic_ms() - t;
  // ── 1. plan ──
  def fl-plan(S) {
   let id = record_get(S, "id");
   let req = fl-row(fl-requests(), "\"id\":\"" ++ id ++ "\"");
   let z = record_set(S, "req", req);
   let row = fl-row(fl-queue(), "\"request\":\"" ++ id ++ "\"");
   nothing?(req) ? fl-plan-gone(S) : !nothing?(row) ? fl-plan-have(S, row, "queued") : fl-kernel-only?(req) ? fl-plan-kernel(S) : fl-formless?(req) ? fl-plan-refused(S, "formless") : record_get(S, "plan") == 0 ? fl-plan-refused(S, "plan-off") : fl-plan-walk(S, id);
  }
  // A request whose every file is a kernel's source (a sibling kernel under form/form-kernel-*, or runtime/) has no Form band the local voice can write a plan or a reference for (its reference must hold a Form definition of
  // each name it plans, and a kernel door is C, Rust, Go or TypeScript): the planner spent 10 to 28 minutes of GPU on each and ended "reference-missing" (27 of the 136 ranked requests, 2026-11-15). It ends at once, named, and
  // the minutes go to a request the voice can land; the request stays open for the hand that holds the kernels.
  def fl-kernel-file?(p) = str_find(p, "form/form-kernel-", 0) == 0 || str_find(p, "runtime/", 0) == 0;
  def fl-kernel-only?(req) { let fs = fl-strs(req, "files"); len(fs) > 0 && all?(p => fl-kernel-file?(p), fs); }
  // A request with no Form or BML file (a README, a script, a walker's source) has no definition for the planner's <reference> to hold either: it ended "reference-missing" on readme_clause after 388 s. The flow takes it directly:
  // the voice edits the file and the text band (or the compile) is the witness, as for the requests it has already landed that way (29 of the 136 ranked, 2026-11-15).
  def fl-formless?(req) { let fs = fl-strs(req, "files"); len(fs) > 0 && !any?(p => fl-ends?(p, ".bml") || fl-ends?(p, ".fk"), fs); }
  def fl-plan-kernel(S) {
   let a = record_set(S, "cause", "kernel-source-hand");
   fl-emit(S, "plan", "part", 0, 1, "kernel-source-hand", record_get(S, "id"), 0);
  }
  def fl-plan-gone(S) {
   let a = fl-emit(S, "plan", "disc", 0, 1, "no-such-request", record_get(S, "id"), 0);
   record_set(S, "cause", "no-such-request");
  }
  def fl-plan-have(S, row, how) {
   let a = record_set(S, "row", row);
   let b = record_set(S, "goal", svs-str(row, "goal", ""));
   let w = record_set(S, "words", svs-str(row, "goal", ""));
   let c = record_set(S, "paths", fl-strs(row, "writable"));
   let d = record_set(S, "band", svs-str(row, "band", ""));
   let e = record_set(S, "full", svs-int(row, "full", 0));
   fl-emit(S, "plan", "ok", 1, 0, how, svs-str(row, "band", ""), 0);
  }
  // the planner is a door: it runs here as a cell in this process and asks the standing server through the spool (lpr-served?), so its voice is the server's
  def fl-plan-walk(S, id) {
   let t = host_monotonic_ms();
   let a = fl-emit(S, "plan", "go", 0, 0, "planning", id, 0);
   let rec = cell_run("observe/local-plan-run.bml", 0, 3600000, ["{\"request\":\"" ++ id ++ "\",\"attempts\":1}"]);
   let row = fl-row(fl-queue(), "\"request\":\"" ++ id ++ "\"");
   let said = record_set(S, "said", fl-tail(nothing?(rec) ? "" : cs-stdout(rec)));
   !nothing?(row) ? fl-plan-have(S, row, "planned") : fl-plan-refused(S, fl-planner-why(id, rec));
  }
  def fl-tail(text) {
   let ls = filter(l => len(trim(l)) > 0, split-on(text, "\n"));
   nil?(ls) ? "" : trim(ls[len(ls) - 1]);
  }
  def fl-planner-why(id, rec) {
   let led = fl-row(fl-planner-ledger(), "\"request\":\"" ++ id ++ "\"");
   !nothing?(led) ? svs-str(led, "kind", svs-str(led, "verdict", "refused")) : nothing?(rec) ? "planner-did-not-run" : !nothing?(record_get(rec, "stopped")) ? "planner-stopped-" ++ fl-slug(fl-head(fl-stop-words(record_get(rec, "stopped")), 56)) ++ "-said-" ++ fl-slug(fl-head(trim(cs-stderr(rec)), 160)) : "planner-said-nothing";
  }
  // the stop is a record: its kind and its message are the words
  def fl-stop-words(st) = (String) value_kind(st) == "record" ? trim(value_str(record_get(st, "kind") ?? "") ++ " " ++ value_str(record_get(st, "message") ?? "")) : trim(value_str(st));
  // a stop's words as one cause word: letters and digits stay, every other run of bytes becomes one hyphen, so the cause is safe in a JSON row and a frame cell
  def fl-slug(s) = fl-slug-at(s, 0, "");
  def fl-slug-at(s, i, acc) {
   let b = i >= len(s) ? 0 : str_byte_at(s, i);
   let keep = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
   i >= len(s) ? acc : fl-slug-at(s, i + 1, keep ? acc ++ byte_to_str(b) : (len(acc) > 0 && substring(acc, len(acc) - 1, len(acc)) != "-" ? acc ++ "-" : acc));
  }
  // A cited file that does not stand yet (frq-0c660dafd6047aac cites form/validate.sh, which this checkout does not carry) is a file to create where its directory stands: the voice is offered it as an empty file
  // and an edit block with an empty OLD creates it (fl-apply-missing). Dropped as absent, the request ended plan-planner-said-nothing in 0.9 s with no file to show.
  def fl-base(p) { let ps = split-on(p, "/"); ps[len(ps) - 1]; }
  def fl-parent-of(p) = len(p) > len(fl-base(p)) ? substring(p, 0, len(p) - len(fl-base(p)) - 1) : "";
  def fl-creatable?(p) = file_size(p) <= 0 && len(fl-parent-of(p)) > 0 && !nothing?(fs_list(fl-parent-of(p)));
  // a refused plan is partial, not an end: the candidate runs from the request's own words and its files, and the compile is its witness
  def fl-plan-refused(S, why) {
   let req = record_get(S, "req");
   let goal = fl-cat([svs-str(req, "title", ""), "\n\n", svs-str(req, "problem", ""), "\n\n", svs-str(req, "needs", "")]);
   // only what the voice may write is shown and edited: a request whose files are all bands, gates or notes ends at once as no-writable-file, with no pass spent
   let files = fl-resolve(filter(p => (file_size(p) > 0 || fl-creatable?(p)) && fl-root-ok?(p), fl-strs(req, "files")), goal);
   let a = record_set(S, "goal", goal);
   let w = record_set(S, "words", goal);
   let b = record_set(S, "paths", files);
   let c = record_set(S, "cause", (String) why == "plan-off" ? "" : "plan-" ++ why);
   fl-emit(S, "plan", "part", 0, 1, why, len(record_get(S, "said")) > 0 ? fl-line(record_get(S, "said")) : fl-line(svs-str(req, "title", "")), 0);
  }
  // ── 1b. the manifest (form-stdlib/bml/flow-signal.bml fsg-mf-*) ──
  // A request that names no definitions ended in three refusals (no-change, no-behavioural-witness, band-unbound-name): the voice had no small thing to build, so it built nothing, built what no band called, or called what it
  // had invented. Its plan, when it carries no "Definition manifest:" line, gets one here: one short ask reads the request's own words for the definitions to add or change, each with its signature and one fixture call with the
  // value the words give. The rows go to the candidate in its goal, become the witness band after the edit (fl-manifest-band: one claim per fixture, written by the flow, so no name is the voice's to invent), and answer an unbound name.
  def fl-mf-source(S) = filter(p => fl-form?(p) && !fl-band-file?(p), record_get(S, "paths"));
  def fl-mf-sigs(S) = fl-cat(map(p => fl-cat(["FILE ", p, " defines (name and parameters):\n", str-join-with(take(60, fl-sigs-of(fl-text(p))), "\n"), "\n\n"]), fl-mf-source(S)));
  def fl-mf-packet(S) = fl-cat([fl-mf-sigs(S), "REQUEST:\n", record_get(S, "goal"), "\n\nFrom the request's own words only, list the definitions to add (one to four; a definition the files above already hold is called by your fixtures, never rewritten, unless the words ask to change it), one to a line, exactly:\nname(param, param) :: name(literal, literal) == literal\nThe call uses short literal arguments (numbers, \"strings\", [lists]) and the value after == is the one the request's words give; a definition whose value the request does not give is left out. Fixtures are taken over PURE definitions only (no ledger write, no print, no file or host call): the call is run again and again by the band. When the request names a side-effecting door (one that writes a row or prints), add a pure helper that door calls (a reading-kind classifier: reading in, kind out) and give the fixture over that helper, not over the door. Give each definition TWO lines whose calls hand it different arguments and whose values differ, one value not among the arguments its call hands it (a classifier: two readings of two kinds): a constant, or a definition that hands back its argument, cannot answer both. Answer with the lines only."]);
  def fl-manifest(S) = str_find(record_get(S, "goal"), "Definition manifest:", 0) >= 0 || nil?(fl-mf-source(S)) ? 0 : fl-manifest-read(S, host_monotonic_ms());
  def fl-manifest-read(S, t) {
   let g = fl-emit(S, "cand", "go", 0, 0, "manifest", record_get(S, "id"), 0);
   let packet = fl-mf-packet(S);
   let said = fl-ask(S, packet, "repair-manifest-" ++ record_get(S, "id"));
   let rows = fl-mf-contrasted(S, fsg-mf-rows(said), fl-cat([packet, "\n\nYou answered:\n", said]));
   let a = record_set(S, "mf", rows);
   let b = record_set(S, "goal", record_get(S, "goal") ++ fsg-mf-block(rows));
   fl-emit(S, "cand", nil?(rows) ? "disc" : "ok", len(rows), nil?(rows) ? 1 : 0, nil?(rows) ? "manifest-none" : "manifest", fl-head(fsg-mf-join(map(r => r[0], rows), ","), 40), fl-since(t));
  }
  // A definition whose fixtures hold no contrast (fsg-mf-flat: one value, or values its calls hand it) is asked for the missing line in the same thread, its prefix already the server's: the body knows what is missing, so it asks
  def fl-mf-contrasted(S, rows, prior) = nil?(rows) || nil?(fsg-mf-flat(rows)) ? rows : fl-mf-contrast-ask(S, rows, fsg-mf-flat(rows), prior, host_monotonic_ms());
  def fl-mf-contrast-ask(S, rows, flat, prior, t) {
   let more = fsg-mf-rows(fl-ask(S, fl-cat([prior, "\n\n", fsg-mf-contrast-ask(rows, flat)]), "repair-manifest-" ++ record_get(S, "id") ++ "-contrast"));
   let merged = fsg-mf-merge(rows, more);
   let c = fl-emit(S, "cand", nil?(fsg-mf-flat(merged)) ? "fix" : "disc", len(rows), len(merged), "manifest-contrast", fl-head(fsg-mf-join(fsg-mf-flat(merged), ","), 40), fl-since(t));
   merged;
  }
  // the band beside the edited file: its tests directory when it has one. Its preludes are the edited files and what they load.
  def fl-mf-band-path(S) {
   let p = fl-mf-source(S)[0];
   let dir = fl-parent-of(p);
   let base = fl-base(p);
   fl-cat([nothing?(fs_list(fl-cat([dir, "/tests"]))) ? dir : fl-cat([dir, "/tests"]), "/", substring(base, 0, str_find(base, ".", 0)), "-", substring(record_get(S, "id"), 4, 12), "-manifest-band.bml"]);
  }
  def fl-preludes-of(p) {
   let T = fl-text(p);
   let at = str_find(T, "preludes:", 0);
   let eol = at < 0 ? -1 : str_find(T, "\n", at);
   at < 0 || eol < 0 ? [] : filter(w => fl-ends?(w, ".fk") || fl-ends?(w, ".bml"), split-on(substring(T, at + 9, eol), " "));
  }
  def fl-mf-preludes(S) = str-join-with(fl-uniq(filter(w => w != "form-stdlib/core.fk" && w != "form-stdlib/bml/live.bml", foldl((acc, p) => append(append(acc, fl-preludes-of(p)), [fl-prelude-rel(p)]), [], fl-mf-source(S)))), " ");
  def fl-manifest-band(S) {
   let rows = record_get(S, "mf");
   nil?(rows) || len(record_get(S, "band")) > 0 || nil?(fl-mf-source(S)) ? 0 : fl-manifest-band-write(S, rows, fl-mf-band-path(S));
  }
  def fl-manifest-band-write(S, rows, path) {
   let r = fl-remember(S, path, fl-text(path));
   let w = write_file_text(path, fsg-mf-band(fl-base(path), fl-mf-preludes(S), rows));
   let a = record_set(S, "paths", append(record_get(S, "paths"), [path]));
   let b = record_set(S, "band", path);
   record_set(S, "full", fsg-mf-full(rows));
  }
  // ── 2. candidate: the voice (the server) answers edit blocks ──
  // The files a request lists were true when it was written; a definition moves. The names the request speaks of (hyphenated words: hw-conflicted?, hw-sync) are looked up where they are
  // DEFINED now (git grep for "def name("), and a file that defines one the listed files do not is shown to the voice first. The voice that was shown a file without the definition wrote Ruby
  // and "...." for the old text (frq-080c…, three attempts the same): the cause was the packet, so the packet is what is healed. No count bounds the files shown; fl-window keeps each readable.
  def fl-goal-names(goal) = filter(w => str_find(w, "-", 0) > 0, fl-words(goal));
  def fl-ends?(s, suf) = len(s) >= len(suf) && (String) substring(s, len(s) - len(suf), len(s)) == suf;
  def fl-definers(name) = filter(p => len(p) > 0 && (fl-ends?(p, ".bml") || fl-ends?(p, ".fk")) && fl-root-ok?(p) && file_size(p) > 0 && file_size(p) < 400000, split-on(hch-said(fl-git("grep", ["grep", "-l", "-F", "-e", fl-cat(["def ", name, "("]), "--", "form", "observe", "learn", "cognition", "control"])), "\n"));
  def fl-defined-in?(files, name) = any?(p => str_find(fl-text(p), fl-cat(["def ", name, "("]), 0) >= 0, files);
  def fl-uniq(xs) = foldl((acc, x) => any?(y => y == x, acc) ? acc : append(acc, [x]), [], xs);
  def fl-resolve(files, goal) {
   let names = fl-uniq(fl-goal-names(goal));
   let missing = filter(n => !fl-defined-in?(files, n), names);
   let found = fl-uniq(foldl((acc, n) => append(acc, fl-definers(n)), [], missing));
   append(found, filter(p => !any?(q => q == p, found), files));
  }
  def fl-def-names(goal, from) {
   let at = str_find(goal, "def ", from);
   at < 0 ? [] : fl-def-name-at(goal, at + 4);
  }
  def fl-name-end(s, i) = i >= len(s) || str_byte_at(s, i) == 40 || str_byte_at(s, i) == 32 || str_byte_at(s, i) == 10 || str_byte_at(s, i) == 123 || str_byte_at(s, i) == 61 ? i : fl-name-end(s, i + 1);
  def fl-def-name-at(goal, from) {
   let e = fl-name-end(goal, from);
   e > from ? cons(substring(goal, from, e), fl-def-names(goal, e)) : fl-def-names(goal, from + 1);
  }
  // a file too big for the prompt is read through the definitions its task names (each from its "def" to the next one) and its head
  // a definition runs from its first word to the next definition's, in either spelling the body writes (BML "def NAME(", Form "(defn NAME ")
  // A file is read through its definitions by structure, never by a count of characters (form-stdlib/bml/def-window.bml, shared with the planner): the head before its first definition, the definitions the task
  // names whole however long, then every definition's name and parameters.
  def fl-region(text, name) = fdw-region(text, name);
  // the first paragraph of a text: up to its first blank line
  def fl-first-block(text) {
   let t = trim(text);
   let e = str_find(t, "\n\n", 0);
   e < 0 ? t : substring(t, 0, e);
  }
  def fl-window-names(goal) = fl-uniq(append(fl-def-names(goal, 0), fl-goal-names(goal)));
  // No length decides what the voice reads. A task that names definitions the file holds is read through them; a task that names none is asked of the voice by name and parameters (fl-pick-names, below), and the
  // definitions it names are `extra`. Measured 2026-11-14 on the resident Q4 voice: whole files made a 13401-id candidate packet (177 s of prefill at 75 ids a second, the 1024 ids it wrote at 11 a second); the named
  // definitions made 4756 ids for the same request and the same band verdict, in 215 s instead of 465.
  def fl-window(text, goal, extra) = fdw-window(text, append(fl-window-names(goal), extra), [], 1);
  def fl-sigs-of(text) = fdw-sigs-of(text);
  def fl-names-held?(text, goal) = fdw-held?(text, fl-window-names(goal));
  def fl-file-block(path, goal, extra) = fl-cat(["FILE ", path, " (current text):\n", fl-window(fl-text(path), goal, extra), "\n\n"]);
  // A task that names no definition of a file the flow may write is not answered by showing the whole file (measured 2026-11-14: a request over files of 128019 bytes was a packet of about 43000 ids, a prefill of
  // 15 to 30 minutes at the server's 25 to 50 ids a second). The voice is asked which definitions the task is about, shown each such file's definitions by name and parameters only (that list comes first, so
  // the server's prefix cache serves it to every later request on the file); its answer names the definitions the packet then shows whole.
  def fl-lens-files(S) = filter(p => !fl-names-held?(fl-text(p), record_get(S, "goal")), record_get(S, "paths"));
  def fl-sig-block(p) = fl-cat(["FILE ", p, " defines (name and parameters):\n", str-join-with(fl-sigs-of(fl-text(p)), "\n"), "\n\n"]);
  def fl-pick-names(S) {
   let files = fl-lens-files(S);
   len(files) == 0 ? [] : fl-names-of(fl-ask-names(S, files));
  }
  def fl-ask-names(S, files) {
   let g = fl-emit(S, "cand", "go", 0, 0, "names", record_get(S, "id"), 0);
   fl-ask(S, fl-cat([fl-cat(map(p => fl-sig-block(p), files)), "TASK:\n", record_get(S, "goal"), "\n\nWhich of these definitions must change for the task? Answer with their names only, one to a line."]), "lens-names-" ++ record_get(S, "id"));
  }
  def fl-names-of(text) = filter(n => len(n) > 0, map(l => fl-clean-path(l), split-on(text, "\n")));
  def fl-format() = "Answer with edit blocks and nothing else. Each block is exactly:\nFILE: <path>\n<<<<<<< OLD\n<the existing lines to replace, copied exactly, enough lines to be unique>\n=======\n<the new lines>\n>>>>>>> NEW\nKeep every other line of the file as it is. Form is read as written: copy names and arities from the text above, never invent a definition.";
  def fl-band-line(S) = len(record_get(S, "band")) == 0 ? "No witness band stands; the edit must compile." : "The band " ++ record_get(S, "band") ++ " must read " ++ record_get(S, "full").str() ++ " (every claim true).";
  // The files come first and the task after them: the server keeps the ids of a prefix it has read (its prefix cache), so a file read once is not read again by the next request that shows it the same way (a
  // task first would make every packet differ from its first id). The window of a file depends on the task's named definitions, so a task that names the same definitions shares the whole prefix.
  def fl-packet(S) = fl-cat(["You are editing Form/BML source in a repository.\n\n", fl-cat(map(p => fl-file-block(p, record_get(S, "goal"), record_get(S, "names")), record_get(S, "paths"))), "TASK:\n", record_get(S, "goal"), "\n\n", fl-band-line(S), "\n\nYou may edit only these files: ", str-join-with(record_get(S, "paths"), ", "), ".\n\n", fl-format()]);
  // The one number that says why a wait is long: the GiB the host's compressor holds (host_vm_stat word 17 pages of word 0 bytes). A voice that decodes 12 tokens a second calm decoded 2 while this read 42 (2026-11-15):
  // the frame's got count carries it on every ask's "go" cell, so a reader sees a paging host the moment the ask begins, with no model and no text.
  def fl-stored-gib() { let vm = host_vm_stat(); (String) value_kind(vm) == "list" && len(vm) >= 18 ? vm[17] * vm[0] / 1073741824 : 0; }
  // a stage that asks the server gives a "go" cell first, naming the ask and how many prompt ids it is (a third of the bytes), so a long wait is not silence in the frame
  def fl-ask(S, packet, who) {
   let g = fl-emit(S, str_find(who, "-fix", 0) >= 0 ? "band" : "cand", "go", fl-stored-gib(), 0, "ask-" ++ fl-head(who, 11), "ids~" ++ (len(packet) / 3).str(), 0);
   let opening = fl-opening-for(S, who);
   let tm = record_get(S, "temp");
   let sd = 1 + len(record_get(S, "thread"));
   let r = len(opening) > 0 ? svc-voice-opened(record_get(S, "dir"), packet, opening, fl-ask-tokens(packet), who, tm, sd) : svc-voice-at(record_get(S, "dir"), packet, fl-ask-tokens(packet), who, tm, sd);
   nothing?(r) || (String) r[0] != "answered" ? "" : opening ++ r[1];
  }
  // The stages that answer in edit blocks begin the assistant's turn inside the block ("FILE: <path>" and its OLD marker when one file may be written, "FILE: " when several): measured 2026-11-14, the
  // voice's answers of 3541 to 4919 ids began in prose ("Looking at the code, the bug is ...") before any block, at 11 to 13 ids a second. The opening is put back on the text, so everything after reads the whole answer.
  def fl-opening-for(S, who) = str_find(who, "flow-", 0) == 0 ? fl-cat(["FILE: ", len(record_get(S, "paths")) == 1 ? fl-cat([record_get(S, "paths")[0], "\n<<<<<<< OLD\n"]) : ""]) : "";
  def fl-candidate(S) {
   let t = host_monotonic_ms();
   len(record_get(S, "paths")) == 0 ? fl-no-files(S) : fl-already-name(S) != "" ? fl-already(S, fl-already-name(S)) : fl-candidate-ask(S, t);
  }
  // A request that asks to add a definition the shown files already hold is done: asking the voice would only have it restate what stands (frq-ca38… was retried for it). The name is read
  // from the request's own words ("add def NAME") and looked up in the files the packet carries; the end is the counted kind already-defined, no model call, no retry by a door's change.
  def fl-already-name(S) {
   let goal = record_get(S, "goal");
   let names = filter(n => len(n) > 0 && str_find(goal, fl-cat(["dd def ", n]), 0) >= 0 && fl-defined-in?(record_get(S, "paths"), n), fl-uniq(fl-add-def-names(goal, 0)));
   len(names) == 0 ? "" : names[0];
  }
  def fl-add-def-names(goal, from) {
   let at = str_find(goal, "dd def ", from);
   at < 0 ? [] : cons(substring(goal, at + 7, fl-name-end(goal, at + 7)), fl-add-def-names(goal, at + 7));
  }
  def fl-already(S, name) {
   let a = fl-emit(S, "cand", "ok", 1, 0, "already-defined", name, 0);
   record_set(S, "cause", "already-defined");
  }
  def fl-no-files(S) {
   let a = fl-emit(S, "cand", "disc", 0, 1, "no-writable-file", "", 0);
   record_set(S, "cause", len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "no-writable-file");
  }
  // The counsel stream: with counsel 1 the flow asks the server's counsel lane one short question about the request first (who "counsel-..." routes by the registry's counsel chain,
  // under the same lease and spool as every ask), and the candidate ask carries what it said.
  def fl-counsel(S) {
   let g = fl-emit(S, "cand", "go", 0, 0, "counsel", record_get(S, "id"), 0);
   fl-ask(S, fl-cat(["In two sentences: which definition should change for this request, and what is the smallest change?\n\n", record_get(S, "goal")]), "counsel-" ++ record_get(S, "id"));
  }
  // The lens stream: with counsel 2 the flow also asks the server's lens lane (who "lens-..." routes to the registry's lens role) to read the request through one narrow lens; the same lease and spool.
  def fl-lens(S) {
   let g = fl-emit(S, "cand", "go", 0, 0, "lens", record_get(S, "id"), 0);
   fl-ask(S, fl-cat(["Read this request through one narrow lens: the single file and single definition it touches. Name them in one sentence.\n\n", record_get(S, "goal")]), "lens-" ++ record_get(S, "id"));
  }
  def fl-hint(S) {
   let h = record_get(S, "counsel") >= 1 ? fl-counsel(S) : "";
   let l = record_get(S, "counsel") == 2 ? fl-lens(S) : "";
   fl-cat([len(h) == 0 ? "" : fl-cat(["\n\nA counsel read of the request says: ", h]), len(l) == 0 ? "" : fl-cat(["\n\nA lens read of the request says: ", l]), fl-done-note(S)]);
  }
  // A request is written against the code as it stood, and may be asked after another landing did its change: "change `A` to `B`" where the file already holds B and no longer holds A is done, and the voice that is not told redoes
  // it the wrong way round (frq-ad4bee6e579991bc: asked to drop a ../ from an import the file no longer had, it added one, 2026-11-15, reverted f426beec9). The note names what already stands and asks for the rest of the request only.
  def fl-ticks(s) { let ps = split-on(s, "`"); filter(x => len(x) > 0, map(i => ps[i], filter(i => i % 2 == 1, range(0, len(ps))))); }
  def fl-done-pair(S, ts) {
   let T = fl-cat(map(p => fl-text(p), record_get(S, "paths")));
   len(ts) >= 2 && str_find(T, ts[1], 0) >= 0 && str_find(T, ts[0], 0) < 0 ? fl-cat(["\n\nThe request asks to change `", ts[0], "` to `", ts[1], "`: the file already holds the second and no longer the first, so that change is DONE; do not redo it or reverse it. Edit only what the request still asks beyond it, or answer an edit block with no change if nothing else is asked."]) : "";
  }
  def fl-done-note(S) {
   let req = record_get(S, "req");
   let needs = nothing?(req) ? "" : svs-str(req, "needs", "");
   str_find(needs, "change `", 0) >= 0 ? fl-done-pair(S, fl-ticks(needs)) : "";
  }
  def fl-candidate-ask(S, t) {
   let picked = record_set(S, "names", fl-pick-names(S));
   let packet = fl-cat([fl-packet(S), fl-hint(S), fl-prior(S)]);
   let kept = record_set(S, "ask0", packet);
   let text = fl-ask(S, packet, "flow-" ++ record_get(S, "id"));
   let a = record_set(S, "reply", text);
   len(text) == 0 ? fl-emit(S, "cand", "disc", 0, 1, "no-reply", "", fl-since(t)) : fl-blocks-in(S, text, t);
  }
  def fl-blocks-in(S, text, t) {
   let bs = fl-blocks(text, 0);
   nil?(bs) ? fl-react-noblocks(S, text, t) : fl-seq(fl-emit(S, "cand", "ok", len(bs), 0, "blocks", record_get(S, "id"), fl-since(t)), fl-apply-all(S, bs));
  }
  def fl-seq(first, second) = second;
  def fl-unused() {
   0;
  }
  // ── the edit blocks ──
  def fl-clean-path(p) = trim(fl-strip(fl-strip(trim(p), "`"), "*"));
  def fl-strip(s, ch) = len(s) > 0 && substring(s, 0, 1) == ch ? fl-strip(substring(s, 1, len(s)), ch) : len(s) > 0 && substring(s, len(s) - 1, len(s)) == ch ? fl-strip(substring(s, 0, len(s) - 1), ch) : s;
  def fl-blocks(t, from) {
   let a = str_find(t, "FILE:", from);
   a < 0 ? [] : fl-block-at(t, a);
  }
  def fl-block-at(t, a) {
   let nl = str_find(t, "\n", a);
   let o = nl < 0 ? -1 : str_find(t, "<<<<<<<", nl);
   let os = o < 0 ? -1 : str_find(t, "\n", o) + 1;
   let sep = os < 1 ? -1 : str_find(t, "\n=======", os - 1);
   let se = sep < 0 ? -1 : str_find(t, "\n", sep + 1) + 1;
   let e = se < 1 ? -1 : str_find(t, "\n>>>>>>>", se - 1);
   e < 0 ? fl-blocks(t, a + 5) : cons([fl-clean-path(substring(t, a + 5, nl)), os > sep ? "" : substring(t, os, sep), e >= se ? substring(t, se, e) : ""], fl-blocks(t, e + 1));
  }
  def fl-apply-all(S, bs) = foldl((acc, b) => fl-seq(acc, fl-apply(S, b)), 0, bs);
  def fl-remember(S, path, text) {
   let known = filter(o => (String) o[0] == path, record_get(S, "orig"));
   nil?(known) ? record_set(S, "orig", append(record_get(S, "orig"), [[path, text]])) : 0;
  }
  def fl-splice(T, at, n, new) = substring(T, 0, at) ++ new ++ substring(T, at + n, len(T));
  def fl-write(S, path, text) {
   let a = write_file_text(path, text);
   record_set(S, "applied", record_get(S, "applied") + 1);
  }
  // The local voice writes the body's own Form (form/, observe/, gate/, learn/, cognition/, control/); the seed (runtime/) and anything outside are not its to edit.
  // A band and a gate are the witness, never the candidate: the voice does not write the tests that judge it.
  // The voice writes no kernel source, in a request of any shape: a mixed request let it rewrite fkwu's own output in runtime/fkwu-uni.c ("nothing" to "null"), and a landing there renews the runtime.
  def fl-root-ok?(p) = fl-path?(p) && !fl-kernel-file?(p) && any?(r => str_find(p, r, 0) == 0, ["form/", "observe/", "learn/", "gate/", "cognition/", "control/", "docs/", "runtime/", "teachings/", "axioms/", "presence/", "surface/", "gpu/", "model/", "ingest/", "plugin/", "grammars/", "bootstrap/", "flatten/", "AGENTS.md", "CURRENT_FLOOR.md", "MANIFEST.md", "HOMECOMING.md", "NORTH_STAR.md", "README.md", "WELCOME.md", "BOOTSTRAP.md"]);
  // An edit to a path the flow may not write is answered inline: the packet names the files it may edit, and the voice that wrote elsewhere (a gate, a band, a notes file) is told which file it
  // wrote to and asked once for the edit block again on the file that holds the code. It had cost a whole pass (300 s) to be refused at the end; the refusal is a counted end only when the ask does not help.
  def fl-apply-outside(S, b) {
   let a = fl-emit(S, "appl", "disc", 0, 1, "outside-roots", b[0], 0);
   record_get(S, "oasks") < 1 ? fl-outside-ask(S, b) : fl-outside-passed(S, b);
  }
  def fl-outside-ask(S, b) {
   let t = host_monotonic_ms();
   let a = record_set(S, "oasks", record_get(S, "oasks") + 1);
   let again = fl-ask(S, fl-cat([fl-packet(S), "\n\nYour edit was to ", b[0], ", which this flow may not write. The file that holds the code to change is one of: ", str-join-with(record_get(S, "paths"), ", "), ". Answer the edit block again, on that file."]), fl-cat(["flow-", record_get(S, "id"), "-out"]));
   let bs = fl-blocks(again, 0);
   nil?(bs) ? fl-outside-passed(S, b) : fl-seq(fl-emit(S, "appl", "fix", len(bs), 0, "outside-reask", b[0], fl-since(t)), fl-apply-all(S, bs));
  }
  def fl-outside-passed(S, b) {
   let c = record_set(S, "cause", len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "outside-roots");
   fl-emit(S, "appl", "part", 0, 1, "outside-roots", b[0], 0);
  }
  def fl-apply(S, b) {
   let path = b[0];
   let T = read_file(path);
   !fl-root-ok?(path) ? fl-apply-outside(S, b) : nothing?(T) ? fl-apply-missing(S, b) : fl-apply-in(S, b, T);
  }
  def fl-apply-missing(S, b) {
   len(b[1]) == 0 && len(b[0]) > 0 ? fl-seq(fl-emit(S, "appl", "ok", 1, 0, "new-file", b[0], 0), fl-new-file(S, b)) : fl-emit(S, "appl", "disc", 0, 1, "no-such-file", b[0], 0);
  }
  def fl-new-file(S, b) {
   let r = fl-remember(S, b[0], "");
   fl-write(S, b[0], b[2]);
  }
  // An empty old text over a file with nothing in it is the voice's way to say "this file is to be written": it is written (a request that names a file that does not stand yet is offered the file empty, and the voice answers
  // with an empty OLD; the apply refused it as "old text not found" and ended the request, 2026-11-15)
  def fl-apply-in(S, b, T) {
   let at = len(b[1]) == 0 ? -1 : str_find(T, b[1], 0);
   len(b[1]) == 0 && len(trim(T)) == 0 ? fl-seq(fl-emit(S, "appl", "ok", 1, 0, "new-file", b[0], 0), fl-new-file(S, b)) : at >= 0 ? fl-apply-at(S, b, T, at, len(b[1])) : fl-react-oldmiss(S, b, T);
  }
  def fl-apply-at(S, b, T, at, n) {
   let r = fl-remember(S, b[0], T);
   let w = fl-write(S, b[0], fl-splice(T, at, n, b[2]));
   fl-emit(S, "appl", "ok", 1, 0, "applied", b[0], 0);
  }
  // ── the nervous system: a discomfort cell is answered where it was felt ──
  // an edit whose old text is not in the file: the deterministic repair finds it by trimmed lines (the voice copied it with other indentation or a changed blank line)
  def fl-trim-lines(text) = map(l => trim(l), split-on(text, "\n"));
  def fl-edge-blank(ls) = !nil?(ls) && len(ls[0]) == 0 ? fl-edge-blank(ls[1:]) : ls;
  def fl-wanted(old) = reverse(fl-edge-blank(reverse(fl-edge-blank(fl-trim-lines(old)))));
  def fl-match-at(lines, i, want, k) = k >= len(want) ? true : trim(lines[i + k]) == want[k] && fl-match-at(lines, i, want, k + 1);
  def fl-find-window(lines, want, i) = len(want) == 0 || i + len(want) > len(lines) ? -1 : fl-match-at(lines, i, want, 0) ? i : fl-find-window(lines, want, i + 1);
  def fl-offset(lines, i) = i <= 0 ? 0 : len(lines[0]) + 1 + fl-offset(lines[1:], i - 1);
  def fl-span(lines, i, n) = n <= 0 ? 0 : len(lines[i]) + (n > 1 ? 1 : 0) + fl-span(lines, i + 1, n - 1);
  def fl-react-oldmiss(S, b, T) {
   let t = host_monotonic_ms();
   let lines = split-on(T, "\n");
   let want = fl-wanted(b[1]);
   let i = fl-find-window(lines, want, 0);
   let a = fl-emit(S, "appl", "disc", 0, 1, "old-not-found", b[0], 0);
   i < 0 ? (record_get(S, "oldasks") < 1 ? fl-oldmiss-ask(S, b, T) : fl-oldmiss-passed(S, b)) : fl-oldmiss-fixed(S, b, T, lines, i, len(want), t);
  }
  // The voice's old text is in no window of the file even by trimmed lines: ONE scoped ask shows it the lines the file really has near where it meant (the line its old text begins with), and the edit it answers is applied.
  def fl-first-at(lines, first, i) = i >= len(lines) ? -1 : trim(lines[i]) == first ? i : fl-first-at(lines, first, i + 1);
  // When no line of the file is the first line of the voice's old text, the excerpt was the top of the file: not where the voice meant. The line it meant is the one that shares the most words
  // (four letters or more) with any line of its old text, scored over the whole file; the excerpt opens there, so the re-ask shows the real lines of the real place.
  def fl-alnum?(b) = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 63;
  def fl-wgo(s, i, cur, acc) = i >= len(s) ? (len(cur) >= 4 ? append(acc, [cur]) : acc) : fl-alnum?(str_byte_at(s, i)) ? fl-wgo(s, i + 1, cur ++ substring(s, i, i + 1), acc) : fl-wgo(s, i + 1, "", len(cur) >= 4 ? append(acc, [cur]) : acc);
  def fl-words(s) = fl-wgo(s, 0, "", []);
  def fl-score(line, words) = foldl((n, w) => str_find(line, w, 0) >= 0 ? n + 1 : n, 0, words);
  def fl-nearest-at(lines, want) {
   let words = fl-words(str-join-with(want, " "));
   let scores = map(i => fl-score(lines[i], words), range(0, len(lines)));
   let best = foldl((b, i) => scores[i] > scores[b] ? i : b, 0, range(0, len(lines)));
   scores[best] > 1 ? best : -1;
  }
  def fl-excerpt(T, old) {
   let lines = split-on(T, "\n");
   let want = fl-wanted(old);
   let exact = len(want) == 0 ? -1 : fl-first-at(lines, want[0], 0);
   let at = exact >= 0 || len(want) == 0 ? exact : fl-nearest-at(lines, want);
   let from = at > 3 ? at - 3 : 0;
   let to = at < 0 ? (len(lines) > 24 ? 24 : len(lines)) : (from + len(want) + 10 > len(lines) ? len(lines) : from + len(want) + 10);
   str-join-with(lines[from:to], "\n");
  }
  def fl-oldmiss-ask(S, b, T) {
   let t = host_monotonic_ms();
   let a = record_set(S, "oldasks", record_get(S, "oldasks") + 1);
   let again = fl-ask(S, fl-cat([fl-packet(S), "\n\nThe old text of your edit to ", b[0], " is not in the file. The file reads, near where you meant:\n", fl-excerpt(T, b[1]), "\n\nAnswer that one edit block again, with the old text copied exactly from these lines."]), "flow-" ++ record_get(S, "id") ++ "-old");
   let bs = fl-blocks(again, 0);
   nil?(bs) ? fl-oldmiss-passed(S, b) : fl-seq(fl-emit(S, "appl", "fix", len(bs), 0, "old-reask", b[0], fl-since(t)), fl-apply-all(S, bs));
  }
  def fl-oldmiss-fixed(S, b, T, lines, i, n, t) {
   let at = fl-offset(lines, i);
   let r = fl-remember(S, b[0], T);
   let w = fl-write(S, b[0], fl-splice(T, at, fl-span(lines, i, n), trim(b[2]) == b[2] ? b[2] : b[2]));
   fl-emit(S, "appl", "fix", 1, 0, "trimmed-lines", fl-cat([b[0]]), fl-since(t));
  }
  def fl-oldmiss-passed(S, b) {
   let a = record_set(S, "fails", record_get(S, "fails") + 1);
   let c = record_set(S, "cause", "edit-old-text-not-found");
   fl-emit(S, "appl", "part", 0, 1, "old-not-found", b[0], 0);
  }
  // no edit blocks in the reply: ONE re-ask names the format and shows the voice its own first words
  def fl-react-noblocks(S, text, t) {
   let a = fl-emit(S, "cand", "disc", 0, 1, "no-edit-blocks", fl-line(text), fl-since(t));
   let t2 = host_monotonic_ms();
   let again = fl-ask(S, fl-cat([fl-packet(S), "\n\nYour last answer had no edit block. It began: ", fl-first-block(text), "\nAnswer again with the blocks only."]), "flow-" ++ record_get(S, "id") ++ "-fmt");
   let bs = fl-blocks(again, 0);
   nil?(bs) ? fl-noblocks-passed(S) : fl-seq(fl-emit(S, "cand", "fix", len(bs), 0, "format-reask", "", fl-since(t2)), fl-apply-all(S, bs));
  }
  def fl-noblocks-passed(S) {
   let c = record_set(S, "cause", "no-edit-blocks");
   fl-emit(S, "cand", "part", 0, 1, "no-edit-blocks", "", 0);
  }
  // ── 3. the band: the witness the plan wrote, else the compile ──
  // A reading is the record the cell answered, kept as rows: value (the band's number, or nothing), said (the compiler's diag rows as cell_run gave them, and the flow's own findings in the same shape: observed, path, line,
  // name, detail), printed (what the band printed). Nothing is rendered to a stderr's words and read back: the kind, the file, the line and the name a repair needs are fields of a row. The flow rendered the rows to text and
  // parsed its own text back (fl-err-path took the file from the first "fkwu: ", a cache note's, 2026-11-19); the voice alone reads text, and only in the packet it is handed.
  def fl-reading(v, said, printed) = record_new(0, "value", v, "said", said, "printed", printed);
  def fl-finding(observed, path, line, name, detail) = record_new(0, "organ", "flow", "observed", observed, "path", path, "line", line, "name", name, "detail", detail);
  def fl-said-of(rec) = nothing?(rec) ? [fl-finding("no-cell", "", 0, "", "the cell did not run")] : append(filter(g => (String) cs-observed(g) != "compile-warning", record_get(rec, "diag") ?? []), nothing?(record_get(rec, "stopped")) ? [] : [fl-finding("stopped", "", 0, "", cs-say(record_get(rec, "stopped")))]);
  def fl-v(r) = record_get(r, "value");
  def fl-said(r) = record_get(r, "said");
  def fl-run-band(path) {
   let rec = cell_run(path, 0, fl-band-ms(), nothing());
   let ran = !nothing?(rec) && nothing?(record_get(rec, "stopped")) && record_get(rec, "errors") == 0;
   let v = nothing?(rec) ? nothing() : record_get(rec, "value");
   fl-reading(ran && (String) value_kind(v) == "int" ? v : nothing(), fl-said-of(rec), nothing?(rec) ? "" : cs-stdout(rec));
  }
  def fl-run-compile(paths) {
   let rs = map(p => cell_run(p, 0, "check", nothing()), paths);
   fl-reading(all?(r => cs-compiled?(r), rs) ? 1 : nothing(), foldl((acc, r) => cs-compiled?(r) ? acc : append(acc, fl-said-of(r)), [], rs), "");
  }
  // a row's fields: the compiler's path carries " (lowered text)" after the file
  def fl-g(g, k) = cs-say(record_get(g, k));
  def fl-row-path(g) { let p = fl-g(g, "path"); let a = str_find(p, " (", 0); a < 0 ? p : substring(p, 0, a); }
  def fl-row-line(g) = (String) value_kind(record_get(g, "line")) == "int" ? record_get(g, "line") : 0;
  def fl-first(said) = nil?(said) ? fl-finding("none", "", 0, "", "") : said[0];
  def fl-unbound-row(said) { let u = filter(g => (String) cs-observed(g) == "binding-missing", said); nil?(u) ? fl-first(said) : u[0]; }
  // the rows as the voice reads them: one line a row, the file and line, the kind, the compiler's own sentence
  def fl-said-text(said) = str-join-with(map(g => fl-cat([fl-row-path(g), fl-row-line(g) > 0 ? ":" ++ fl-row-line(g).str() : "", len(fl-row-path(g)) > 0 ? ": " : "", cs-observed(g), ": ", fl-g(g, "detail")]), said), "\n");
  // A band that reads full over a file that no longer compiles is not green: landing-health-band read 7 while observe/native-turn-run.bml had 2 compile errors (0 before the edit), and the landing broke the native turn (reverted aca6dca2a,
  // 2026-11-15). Every Form file the edit touched is asked to compile after the band is read, and an error is the reading, so the repair loop meets it like any compile error.
  // The same name with the same number of parameters twice in one file is no overload: the last one wins and the first is silently gone. Two landings of one request added a duplicate el-owner-pid to ear-yield.bml (the compile band
  // read it as loaded), the lease lookup read pid 0 and the ear stopped yielding to the resident (repaired 6dfb140b8, 2026-11-15). A duplicate is the reading, named, like a compile error.
  def fl-sig-key(s) {
   let a = str_find(s, "(", 0);
   let b = a < 0 ? -1 : str_find(s, ")", a);
   let inner = a < 0 || b < 0 ? "" : trim(substring(s, a + 1, b));
   a < 0 ? s : fl-cat([substring(s, 0, a), "/", (len(inner) == 0 ? 0 : len(split-on(inner, ",")) ).str()]);
  }
  def fl-dup-in(keys) = nil?(keys) ? "" : any?(k => (String) k == (String) keys[0], keys[1:]) ? keys[0] : fl-dup-in(keys[1:]);
  def fl-dups-of(p) = fl-ends?(p, ".bml") ? fl-dup-in(map(s => fl-sig-key(s), fl-sigs-of(fl-text(p)))) : "";
  def fl-first-dup(paths) = nil?(paths) ? "" : len(fl-dups-of(paths[0])) > 0 ? fl-cat([paths[0], ": ", fl-dups-of(paths[0])]) : fl-first-dup(paths[1:]);
  def fl-and-compile(S, r) {
   let forms = filter(p => fl-form?(p), record_get(S, "paths"));
   let c = nothing?(fl-v(r)) ? fl-reading(1, [], "") : fl-run-compile(forms);
   let dup = nothing?(fl-v(r)) || nothing?(fl-v(c)) ? "" : fl-first-dup(forms);
   nothing?(fl-v(r)) ? r : nothing?(fl-v(c)) ? fl-reading(nothing(), fl-said(c), record_get(r, "printed")) : len(dup) > 0 ? fl-reading(nothing(), [fl-finding("duplicate-definition", "", 0, dup, fl-cat(["the same name and parameter count twice: ", dup]))], record_get(r, "printed")) : r;
  }
  // A band the edit changed is its own witness: it is read and must say what it said before the edit (the same number, read from the file as it stood). A candidate that renumbered kernel-laws-band's claims and left its verdict
  // at a number it no longer reaches compiled clean and landed (980e80a31, 2026-11-17, read 64961380351 of 68719476735, reverted b09f8c297): the compile alone cannot see a band that reads short.
  def fl-band-file?(p) = fl-form?(p) && str_find(p, "-band.", 0) >= 0;
  def fl-self-orig(S, p) { let o = filter(x => (String) x[0] == (String) p, record_get(S, "orig")); len(o) == 0 ? "" : o[0][1]; }
  def fl-self-read(S, p) {
   let copy = fl-cat(["/tmp/form-flow-orig-", record_get(S, "id"), fl-ends?(p, ".bml") ? ".bml" : ".fk"]);
   let w = write_file_text(copy, fl-self-orig(S, p));
   let before = fl-run-band(copy);
   let now = fl-run-band(p);
   nothing?(fl-v(now)) ? now : nothing?(fl-v(before)) || fl-v(now) == fl-v(before) ? now : fl-reading(nothing(), [fl-finding("band-moved", p, 0, "", fl-cat(["reads ", fl-v(now).str(), " and read ", fl-v(before).str(), " before the edit; a band an edit changed says what it said"]))], record_get(now, "printed"));
  }
  def fl-band-read(S) = len(record_get(S, "band")) > 0 && file_size(record_get(S, "band")) > 0 ? fl-and-compile(S, fl-run-band(record_get(S, "band"))) : fl-band-read-own(S, filter(p => fl-band-file?(p), record_get(S, "paths")));
  def fl-band-read-own(S, bands) = len(bands) > 0 ? fl-and-compile(S, fl-self-read(S, bands[0])) : fl-run-compile(filter(p => fl-form?(p), record_get(S, "paths")));
  def fl-form?(p) = str_find(p, ".bml", 0) == len(p) - 4 || str_find(p, ".fk", 0) == len(p) - 3;
  // nothing Form was written and no band stands over it: nothing was compiled, so nothing is green
  def fl-band-nowitness(S) {
   let c = record_set(S, "cause", len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "no-witness");
   fl-emit(S, "band", "part", 0, 1, "no-witness", "", 0);
  }
  def fl-band(S) {
   let t = host_monotonic_ms();
   let w = record_get(S, "applied") == 0 ? 0 : fl-manifest-band(S);
   record_get(S, "applied") == 0 ? fl-band-skip(S) : len(record_get(S, "band")) == 0 && nil?(filter(p => fl-form?(p), record_get(S, "paths"))) ? fl-band-nowitness(S) : fl-band-pass(S, t, 0);
  }
  def fl-band-skip(S) {
   let c = record_set(S, "cause", len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "nothing-applied");
   fl-emit(S, "band", "part", 0, 1, "nothing-applied", "", 0);
  }
  def fl-band-pass(S, t, tries) {
   let g = fl-emit(S, "band", "go", 0, 0, "reading", record_get(S, "band"), 0);
   let r = fl-band-read(S);
   let a = record_set(S, "red", fl-said(r));
   let b = record_set(S, "outs", record_get(r, "printed"));
   fl-band-judge(S, r, t, tries);
  }
  // the kind is the rows' own: a missing binding, a sentence of arity, any other compiler row, else the cell stopped
  def fl-said-kind(said) = any?(g => (String) cs-observed(g) == "binding-missing", said) ? "unbound-name" : any?(g => str_find(fl-g(g, "detail"), "arity", 0) >= 0 || str_find(fl-g(g, "detail"), "expects", 0) >= 0, said) ? "arity" : any?(g => (String) cs-observed(g) != "stopped" && (String) cs-observed(g) != "no-cell", said) ? "compile-error" : "stopped";
  def fl-judge-kind(S, r) = nothing?(fl-v(r)) ? fl-said-kind(fl-said(r)) : len(record_get(S, "band")) == 0 ? "ok" : fl-v(r) == record_get(S, "full") ? "ok" : "claims-short";
  def fl-band-judge(S, r, t, tries) {
   let kind = fl-judge-kind(S, r);
   kind == "ok" ? fl-band-green(S, r, t) : fl-band-hurt(S, r, kind, t, tries);
  }
  def fl-band-green(S, r, t) {
   let a = record_set(S, "green", 1);
   let b = record_set(S, "got", nothing?(fl-v(r)) ? 0 : fl-v(r));
   let c = record_set(S, "miss", 0);
   fl-emit(S, "band", "ok", nothing?(fl-v(r)) ? 0 : fl-v(r), 0, len(record_get(S, "band")) == 0 ? "compiles" : "full", record_get(S, "band"), fl-since(t));
  }
  def fl-band-hurt(S, r, kind, t, tries) {
   let got = nothing?(fl-v(r)) ? 0 : fl-v(r);
   let miss = nothing?(fl-v(r)) ? record_get(S, "full") : record_get(S, "full") - fl-v(r);
   let a = record_set(S, "got", got);
   let b = record_set(S, "miss", miss < 0 ? 0 : miss);
   let c = fl-emit(S, "band", "disc", got, miss < 0 ? 0 : miss, kind, fl-line(fl-g(fl-first(fl-said(r)), "detail")), fl-since(t));
   // what the red reading said, as the pass's own words on its stdout: a person watching the pass reads the compiler's line beside the cell that named it
   let p = print_str("[flow:red] " ++ kind ++ " got " ++ got.str() ++ ": " ++ fl-head(fl-said-text(take(2, fl-said(r))), 300) ++ "\n[flow:red] the edit that was applied:\n" ++ fl-head(record_get(S, "reply"), 900) ++ "\n");
   fl-repair-ends?(S, kind, got, tries, fl-said-text(take(2, fl-said(r)))) ? (record_get(S, "temp") == 0 ? fl-band-drawn(S, r, kind, t, tries) : fl-band-passed(S, kind)) : fl-band-repair(S, r, kind, t, tries);
  }
  // A repair that leaves the reading as it was (same-again) is asked once more with its tokens drawn at a temperature (0.7, a seed from the thread's length): at temperature zero the same words in return were the same answer
  // (frq-eeb0d49777e34ace ended same-again on one compile error, 2026-11-19). The rest of the pass draws too; a repeat after that ends the pass as it did.
  def fl-band-drawn(S, r, kind, t, tries) {
   let a = record_set(S, "temp", 700);
   fl-band-repair(S, r, kind, t, tries);
  }
  // A band that is still hurt is repaired again until a repair teaches nothing: the reading (its kind, the claims it held, the files' length) is one this request has read before, so the voice is going round, not
  // forward. A caller that names a number of repairs (repairs > 0 in the request) keeps its own number; none named, five repairs or the repeated reading is the end (a pass ran 17 repairs over 56 minutes on one request, 2026-11-16: the compiler's first words changed each time, so no reading repeated).
  // The reading is the kind, the claims held and the compiler's own first words: a repair that changes the file and leaves the compiler saying the same thing has taught nothing (the file's length changed with every repair, so a
  // reading keyed on it never repeated: a pass spent 30 minutes and five repairs of ~5 minutes each on one red claim, 2026-11-15)
  def fl-repair-ends?(S, kind, got, tries, errs) {
   let sig = fl-cat([kind, ":", got.str(), ":", fl-head(errs, 120)]);
   let seen = record_get(S, "seen");
   let noted = record_set(S, "seen", cons(sig, seen));
   (record_get(S, "allow") > 0 && tries >= record_get(S, "allow")) || any?(x => (String) x == sig, seen);
  }
  def fl-band-passed(S, kind) {
   let c = record_set(S, "cause", "band-" ++ kind);
   fl-emit(S, "band", "part", record_get(S, "got"), record_get(S, "miss"), kind, "", 0);
  }
  // the repair of a band's discomfort, then the band is read again from this same stage
  def fl-band-repair(S, r, kind, t, tries) {
   let t2 = host_monotonic_ms();
   let before = fl-edited-len(S);
   let did = fl-repair(S, r, kind);
   let c = fl-emit(S, "band", did == 1 ? "fix" : "disc", before, fl-edited-len(S), did == 1 ? fl-fix-name(kind) : "repair-none", "", fl-since(t2));
   did == 1 ? fl-band-pass(S, t, tries + 1) : fl-band-passed(S, kind);
  }
  def fl-fix-name(kind) = kind == "unbound-name" ? "prelude-or-ask" : kind == "claims-short" ? "ask-with-printed" : "ask-with-compiler";
  def fl-edited-len(S) = foldl((acc, p) => acc + len(fl-text(p)), 0, record_get(S, "paths"));
  // the repair for a kind: a deterministic one where the body knows one, else one small scoped ask
  def fl-repair(S, r, kind) = kind == "unbound-name" ? fl-repair-unbound(S, r) : fl-repair-ask(S, r, kind);
  // the place a repair looks: the row's own file, its file relative to the body when the compiler named it absolute
  def fl-rel(p) { let root = fl-cat([trim(hch-said(fl-git("rev-parse", ["rev-parse", "--show-toplevel"]))), "/"]); len(root) > 1 && str_find(p, root, 0) == 0 ? substring(p, len(root), len(p)) : p; }
  def fl-said-path(said) = fl-rel(fl-row-path(fl-unbound-row(said)));
  def fl-said-line(said) = fl-row-line(fl-unbound-row(said));
  def fl-said-name(said) { let u = filter(g => (String) cs-observed(g) == "binding-missing", said); nil?(u) ? "" : fl-g(u[0], "name"); }
  // what a short band did not hold: a manifest band's claim i is fixture i, so the verdict's missing bits name the fixtures; a band the plan wrote is shown what it printed
  def fl-short-text(S, r) = nil?(record_get(S, "mf")) || (String) record_get(S, "band") != (String) fl-mf-band-path(S) ? fl-head(record_get(r, "printed"), 1800) : fl-cat(["These fixtures do not hold (each is one claim of the band):\n", fsg-mf-join(map(f => fl-cat(["- ", f[2], " == ", f[3]]), fsg-mf-failing(record_get(S, "mf"), nothing?(fl-v(r)) ? 0 : fl-v(r))), "\n"), "\n\nThe definitions those fixtures call, as they stand now:\n", fl-cat(map(n => fl-def-head(n), fl-uniq(map(f => f[0], fsg-mf-failing(record_get(S, "mf"), nothing?(fl-v(r)) ? 0 : fl-v(r))))))]);
  // A name the compiler cannot resolve and no file of the body defines was invented by the voice (frq-eeb0d49777e34ace: wfp-unknown-words, wfp-draft-rows, wfp-affirm-rows called, none defined): the repair
  // is shown the names that do stand with the same stem in the files it may edit, so it calls what exists or writes the definition
  def fl-stem(name) { let a = str_find(name, "-", 0); a < 0 ? name : substring(name, 0, a + 1); }
  def fl-stem-sigs(S, name) = take(40, filter(s => str_find(s, fl-stem(name), 0) == 0, foldl((acc, p) => append(acc, fl-sigs-of(fl-text(p))), [], record_get(S, "paths"))));
  def fl-name-note(S, name) {
   let p = len(name) == 0 ? "" : fl-find-def(name);
   len(name) == 0 ? "" : len(p) > 0 ? fl-def-head(name) : fl-cat([name, " is defined nowhere in the body. ", fsg-mf-note(record_get(S, "mf"), name), "The names that stand with its stem:\n", str-join-with(fl-stem-sigs(S, name), "\n"), "\nCall only names that stand, or write the definition in the file you edit.\n\n"]);
  }
  // where a name is defined: the body's own directories, read once per repair
  def fl-roots() = ["form/form-stdlib/bml", "form/form-stdlib", "observe", "gate", "cognition", "control", "learn"];
  def fl-source?(n) = str_find(n, ".bml", 0) == len(n) - 4 || str_find(n, ".fk", 0) == len(n) - 3;
  def fl-defines?(path, name) = str_find(fl-text(path), "def " ++ name ++ "(", 0) >= 0 || str_find(fl-text(path), "defn " ++ name ++ " ", 0) >= 0;
  def fl-find-in(root, name) = foldl((acc, n) => len(acc) > 0 ? acc : fl-source?(n) && fl-defines?(root ++ "/" ++ n, name) ? root ++ "/" ++ n : "", "", fs_list(root) ?? []);
  def fl-find-def(name) = len(name) == 0 ? "" : foldl((acc, root) => len(acc) > 0 ? acc : fl-find-in(root, name), "", fl-roots());
  def fl-prelude-rel(p) = str_find(p, "form/", 0) == 0 ? substring(p, 5, len(p)) : p;
  def fl-has-prelude?(T, rel) = str_find(T, rel, 0) >= 0;
  def fl-add-prelude(T, rel) {
   let at = str_find(T, "preludes:", 0);
   let eol = at < 0 ? -1 : str_find(T, "\n", at);
   at < 0 || eol < 0 ? "// preludes: " ++ rel ++ "\n" ++ T : substring(T, 0, eol) ++ " " ++ rel ++ substring(T, eol, len(T));
  }
  def fl-repair-unbound(S, r) {
   let name = fl-said-name(fl-said(r));
   let where = fl-find-def(name);
   let target = fl-said-path(fl-said(r));
   let T = len(target) == 0 ? "" : fl-text(target);
   len(where) > 0 && len(T) > 0 && !fl-has-prelude?(T, fl-prelude-rel(where)) && target != where ? fl-prelude-fix(S, target, T, where) : fl-repair-ask(S, r, "unbound-name");
  }
  def fl-prelude-fix(S, target, T, where) {
   let r = fl-remember(S, target, T);
   let w = fl-write(S, target, fl-add-prelude(T, fl-prelude-rel(where)));
   1;
  }
  // else ONE small scoped ask: the compiler's words, the lines around the place it names, the definition of the name it could not find, what the band printed
  def fl-around(path, line) {
   let ls = split-on(fl-text(path), "\n");
   let from = line > 8 ? line - 9 : 0;
   let to = line + 8 < len(ls) ? line + 8 : len(ls);
   len(path) == 0 || line < 1 ? "" : fl-cat(["Lines ", (from + 1).str(), " to ", to.str(), " of ", path, ":\n", str-join-with(take(to - from, drop(from, ls)), "\n"), "\n\n"]);
  }
  def fl-def-head(name) {
   let p = fl-find-def(name);
   len(p) == 0 ? "" : fl-cat(["Where ", name, " is defined (", p, "):\n", fl-region(fl-text(p), name), "\n\n"]);
  }
  // The repair continues the first ask: its packet is the prefix the server already holds (cached_ids 5586 of 5587), so only the voice's answer and the compiler's words are new. Measured 2026-11-15 on the server's ledger:
  // a repair packet that began afresh was 9098 ids with cached_ids 0, and a cold prefill runs near 20 ids a second, so one repair waited over seven minutes in prefill while the frame showed "go".
  def fl-red-text(S, r, kind) = kind == "claims-short" ? fl-cat(["The band read a short number. ", fl-short-text(S, r)]) : fl-cat(["The compiler said:\n", fl-head(fl-said-text(fl-said(r)), 1800), "\n\n", fl-edit-view(S, fl-said-text(fl-said(r)))]);
  // The compiler's line is a line of the unit the band loads, not of the band file (frq-eeb0d49777e34ace: line 3370 of a flattened unit, the voice shown 18 lines of a 12-line band): the voice is shown the file where its own
  // last edit stands, as the edit left it. The latest answer is the one applied last (S "last"; the first answer until a repair has been asked).
  def fl-edit-view(S, stop) {
   let said = len(record_get(S, "last")) > 0 ? record_get(S, "last") : record_get(S, "reply");
   let bs = len(said) == 0 ? [] : fl-blocks(said, 0);
   len(bs) == 0 ? "" : fl-cat([fl-edit-view-of(bs[0]), fl-use(fl-arity-name(stop), fl-text(bs[0][0]), bs[0][0])]);
  }
  // "unknown value member or member arity: filter" names a call the voice made the wrong way (frq-7e2c33f4a9b16d58): the first line where the edited file or its preludes call that name is shown beside the stop.
  def fl-ident-byte?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 45 || b == 63 || b == 95;
  def fl-ident-end(s, i) = i < len(s) && fl-ident-byte?(str_byte_at(s, i)) ? fl-ident-end(s, i + 1) : i;
  def fl-arity-name(text) { let at = str_find(text, "member arity: ", 0); at < 0 ? "" : substring(text, at + 14, fl-ident-end(text, at + 14)); }
  def fl-prelude-files(T) {
   let ls = filter(l => str_find(l, "preludes:", 0) >= 0, split-on(T, "\n"));
   len(ls) == 0 ? [] : map(p => file_size(fl-cat(["form/", p])) > 0 ? fl-cat(["form/", p]) : p, take(10, filter(p => len(p) > 4, split-on(substring(ls[0], str_find(ls[0], "preludes:", 0) + 9, len(ls[0])), " "))));
  }
  def fl-use-in(name, text) {
   let hits = filter(l => str_find(l, fl-cat([name, "("]), 0) >= 0 && str_find(l, fl-cat(["def ", name]), 0) < 0 && len(l) < 200, map(l => trim(l), split-on(text, "\n")));
   len(hits) == 0 ? "" : hits[0];
  }
  def fl-use(name, T, path) {
   let hit = len(name) == 0 ? "" : foldl((acc, f) => len(acc) > 0 ? acc : fl-use-in(name, fl-text(f)), "", cons(path, fl-prelude-files(T)));
   len(hit) == 0 ? "" : fl-cat(["\nThe body calls ", name, " like this:\n", hit, "\n"]);
  }
  def fl-edit-view-of(b) {
   let T = fl-text(b[0]);
   let nl = str_find(b[2], "\n", 0);
   let key = trim(nl > 0 ? substring(b[2], 0, nl) : b[2]);
   let at = len(key) == 0 ? -1 : str_find(T, key, 0);
   at < 0 ? "" : fl-cat(["The file as your edit left it:\n", fl-around(b[0], len(split-on(substring(T, 0, at), "\n"))), fl-idiom(T)]);
  }
  // The body's own words for a choice, borrowed from the file being edited (frq-6d1b22e3f8a05c47: the voice wrote 'if w = x then ... else ...', which the compiler stops at as 'w (wanted: reclit)'): the first conditional the file already writes.
  def fl-idiom(T) {
   let hits = filter(l => str_find(l, " ? ", 0) > 0 && str_find(l, " : ", 0) > 0 && str_find(l, " == ", 0) > 0 && len(l) < 220, map(l => trim(l), split-on(T, "\n")));
   len(hits) == 0 ? "" : fl-cat(["\nThis file writes a choice as `cond ? a : b` and equality as `==`, for example:\n", hits[0], "\n"]);
  }
  def fl-continued-packet(S, r, kind, path) {
   let said = fl-said(r);
   fl-cat([record_get(S, "ask0"), "\n\nYour answer was applied:\n", fl-head(record_get(S, "reply"), 1500), record_get(S, "thread"), "\n\nThe check is still red. ", fl-red-text(S, r, kind), "\n\n", fl-around(path, fl-said-line(said)), fl-name-note(S, fl-said-name(said)), "Give the smallest edit that heals the one red thing above, in the same block format."]);
  }
  def fl-scoped-packet(S, r, kind) {
   let said = fl-said(r);
   let path = fl-said-path(said);
   len(record_get(S, "ask0")) > 0 ? fl-continued-packet(S, r, kind, path) : fl-cat(["A Form/BML edit was applied and the check is red.\n\n", fl-red-text(S, r, kind), "\n\n", fl-around(path, fl-said-line(said)), fl-name-note(S, fl-said-name(said)), fl-cat(map(p => fl-file-block(p, record_get(S, "goal"), record_get(S, "names")), record_get(S, "paths"))), "TASK:\n", fl-head(record_get(S, "goal"), 2500), "\n\n", fl-band-line(S), "\nGive the smallest edit that heals the one red thing above.\n", fl-format()]);
  }
  def fl-repair-ask(S, r, kind) {
   let text = fl-ask(S, fl-scoped-packet(S, r, kind), "flow-" ++ record_get(S, "id") ++ "-fix");
   let latest = record_set(S, "last", text);
   // each repair joins the thread the next one continues: the same packet at temperature zero is the same answer, so a repair that does not heal and is asked again unchanged only repeats itself (five asks of ~220 s each, 2026-11-15)
   let kept = record_set(S, "thread", fl-cat([record_get(S, "thread"), "\n\nYour repair, applied:\n", fl-head(text, 800)]));
   let bs = len(text) == 0 ? [] : fl-blocks(text, 0);
   let before = record_get(S, "applied");
   let done = fl-apply-all(S, bs);
   record_get(S, "applied") > before ? 1 : 0;
  }
  // ── 4. land ──
  // Prose has no band that can fail: the text band the flow writes for a document asks that the file is not empty, and any non-empty document passes it (HOMECOMING.md took two redundant mid-sentence parentheticals and kernel-interface.md
  // lost three true facts as landings, 2026-11-15; both were read and one reverted by hand). An edit whose every file is a document is kept as a patch beside the claim and ends "prose-needs-review": the hand that reads it lands it.
  def fl-prose?(S) = len(record_get(S, "paths")) > 0 && all?(p => fl-ends?(p, ".md") || fl-ends?(p, ".txt"), record_get(S, "paths"));
  // A candidate that is green (its changed files compile, or the band the plan named holds) lands when its code differs from what stood: a change of comments alone is no observable change, the request is done (the counted kind no-change)
  // and the text goes back. 34 of the flow's first 98 landings changed comments only, and one request was reworded eight times.
  // A comment is a comment unless it is a directive: in this body a comment line can choose the validation lane (PROOF LEVEL), name a band's verdict (Expected, Verdict), load a file (preludes:) or name its proof.
  def fl-directive?(l) = str_find(l, "preludes:", 0) >= 0 || str_find(l, "PROOF LEVEL", 0) >= 0 || str_find(l, "Expected:", 0) >= 0 || str_find(l, "Verdict", 0) >= 0 || str_find(l, "preflight-exec", 0) >= 0 || str_find(l, "Proven by", 0) >= 0;
  def fl-comment?(l) = (str_find(l, "//", 0) == 0 || str_find(l, ";", 0) == 0) && !fl-directive?(l);
  def fl-code-of(t) = str-join-with(filter(l => len(l) > 0 && !fl-comment?(l), map(l => trim(l), split-on(t, "\n"))), "\n");
  def fl-code-changed?(S) = nil?(record_get(S, "orig")) || any?(o => !fl-form?(o[0]) || (String) fl-code-of(o[1]) != (String) fl-code-of(fl-text(o[0])), record_get(S, "orig"));
  def fl-land-comments(S) {
   let c = record_set(S, "cause", "no-change");
   fl-emit(S, "land", "part", 0, 0, "comments-only", "", 0);
  }
  // A changed definition lands only over a behavioural reading (fsg-witness): a compile is no answer. Without one the pass ends partial, the edits go back, and the cause names what a band must call: the definitions the edit added.
  def fl-added-names(S) = foldl((acc, o) => !fl-form?(o[0]) ? acc : append(acc, map(s => substring(s, 0, str_find(s, "(", 0)), filter(s => str_find(s, "(", 0) > 0 && !any?(t => (String) t == (String) s, fl-sigs-of(o[1])), fl-sigs-of(fl-text(o[0]))))), [], record_get(S, "orig"));
  def fl-witnessed?(S) = (String) fsg-witness(record_get(S, "band"), record_get(S, "full"), any?(p => fl-band-file?(p), record_get(S, "paths"))) == "behavioural";
  def fl-land-unwitnessed(S) {
   let a = record_set(S, "cause", "no-behavioural-witness");
   let b = record_set(S, "green", 0);
   fl-emit(S, "land", "part", 0, 1, "no-behavioural-witness", fl-head(str-join-with(fl-added-names(S), ","), 40), 0);
  }
  // An edit to a definition that already stood may not stop calling what it called (fsg-wk-weakened, form-stdlib/bml/flow-signal.bml): frq-4b09fbf1b6cca1f0 turned its fixture by rewriting dcc-reply-lands? and dropping three of its
  // four covenant checks (95b3e19d7, reverted 25542ec9c). The pass ends partial, kind weakens-existing, the text goes back (fl-end) and the cause names the definition and what it stopped calling.
  def fl-weakened(S) = foldl((acc, o) => !fl-form?(o[0]) || len(o[1]) == 0 ? acc : append(acc, fsg-wk-weakened(o[1], fl-text(o[0]), record_get(S, "goal"))), [], record_get(S, "orig"));
  def fl-weakens-note(ws) = str-join-with(map(w => w[0] ++ ":" ++ str-join-with(w[1], "+"), ws), ",");
  // A weakened definition is taught, not refused: the voice is told what its edit stopped calling and asks again once for the smallest edit that restores those calls and keeps its change; the band is read again from
  // the start and the landing checks run again. Only an answer that applies nothing, or a second weakening, ends partial, kind weakens-existing.
  def fl-land-weakens(S, ws) = record_get(S, "unweakened") == 0 ? fl-weakens-heal(S, ws, host_monotonic_ms()) : fl-land-weakens-flat(S, ws);
  def fl-weakens-heal(S, ws, t) {
   let a = record_set(S, "unweakened", 1);
   let text = fl-ask(S, fl-cat(["A Form/BML edit was applied and it weakens a definition that already stood: it stopped calling ", fl-weakens-note(ws), " (definition: what it no longer calls). Those calls were part of what the definition does, so put them back and keep the change you made.\n\n", fl-cat(map(p => fl-file-block(p, record_get(S, "goal"), record_get(S, "names")), record_get(S, "paths"))), "TASK:\n", fl-head(record_get(S, "goal"), 2500), "\n\n", fl-band-line(S), "\nGive the smallest edit that restores those calls.\n", fl-format()]), "flow-" ++ record_get(S, "id") ++ "-weakens");
   let before = record_get(S, "applied");
   let done = len(text) == 0 ? 0 : fl-apply-all(S, fl-blocks(text, 0));
   record_get(S, "applied") > before ? fl-weakens-band(S, t) : fl-land-weakens-flat(S, ws);
  }
  def fl-weakens-band(S, t) {
   let a = record_set(S, "green", 0);
   let e = fl-emit(S, "land", "fix", 0, 0, "weakens-heal", "", fl-since(t));
   let d = fl-band-pass(S, t, 0);
   fl-land(S);
  }
  def fl-land-weakens-flat(S, ws) {
   let a = record_set(S, "cause", "weakens-existing");
   let b = record_set(S, "green", 0);
   fl-emit(S, "land", "part", 0, 1, "weakens-existing", fl-head(fl-weakens-note(ws), 120), 0);
  }
  // A fixture a definition only repeats is no witness (fsg-mf-constant): 7c128c84e added two classifiers answering one constant whatever they were handed, ea3f6f608 an echo dr-reading-kind(k) = k, and each generated band
  // read full. That is not met by putting the work back: what is missing is a fixture that tells two inputs apart. The contrast is asked once, the manifest band is written again with it, and the band stage reads again from
  // the start, so its own repairs (claims-short: the voice is shown the fixture it fails) teach the definition. Only a contrast that does not come, or a band the flow did not write, ends partial, kind constant-fixture.
  def fl-constants(S) = foldl((acc, o) => !fl-form?(o[0]) ? acc : append(acc, fsg-mf-constant(o[1], fl-text(o[0]), record_get(S, "mf"))), [], record_get(S, "orig"));
  def fl-land-constant(S, cs) = record_get(S, "contrasted") == 0 && (String) record_get(S, "band") == (String) fl-mf-band-path(S) ? fl-contrast-heal(S, cs, host_monotonic_ms()) : fl-land-flat(S, cs);
  def fl-contrast-heal(S, cs, t) {
   let a = record_set(S, "contrasted", 1);
   let rows = record_get(S, "mf");
   let more = fsg-mf-rows(fl-ask(S, fl-cat([fl-mf-packet(S), "\n\n", fsg-mf-contrast-ask(rows, cs)]), "repair-manifest-" ++ record_get(S, "id") ++ "-contrast"));
   let merged = fsg-mf-merge(rows, more);
   len(merged) == len(rows) ? fl-land-flat(S, cs) : fl-contrast-band(S, merged, t);
  }
  def fl-contrast-band(S, rows, t) {
   let a = record_set(S, "mf", rows);
   let w = write_file_text(record_get(S, "band"), fsg-mf-band(fl-base(record_get(S, "band")), fl-mf-preludes(S), rows));
   let b = record_set(S, "full", fsg-mf-full(rows));
   let c = record_set(S, "green", 0);
   let e = fl-emit(S, "land", "fix", len(rows), 0, "contrast", fl-head(fsg-mf-join(fsg-mf-names(rows), ","), 40), fl-since(t));
   let d = fl-band-pass(S, t, 0);
   fl-land(S);
  }
  def fl-land-flat(S, cs) {
   let a = record_set(S, "cause", "constant-fixture");
   let b = record_set(S, "green", 0);
   fl-emit(S, "land", "part", 0, 1, "constant-fixture", fl-head(str-join-with(cs, ","), 120), 0);
  }
  def fl-land-witness(S) = fl-witnessed?(S) ? fl-land-go(S) : fl-land-unwitnessed(S);
  def fl-land-checked(S, ws) = len(ws) > 0 ? fl-land-weakens(S, ws) : fl-land-constants(S, fl-constants(S));
  def fl-land-constants(S, cs) = len(cs) > 0 ? fl-land-constant(S, cs) : fl-land-grounding(S, fl-invented(S));
  // A fixture whose value the edit invented (fsg-mf-invented) is not a witness of the request: asked for again once with the source the value must come from, the band is written again and read from the start
  // (claims-short then teaches the definition toward what the request said); only an answer that brings no fixture, or a second invention, ends partial, kind ungrounded-fixture.
  def fl-invented(S) = nil?(record_get(S, "mf")) || (String) record_get(S, "band") != (String) fl-mf-band-path(S) ? [] : foldl((acc, o) => !fl-form?(o[0]) ? acc : append(acc, fsg-mf-invented(record_get(S, "mf"), record_get(S, "words"), o[1], fl-text(o[0]))), [], record_get(S, "orig"));
  // An earlier manifest band over the same file is a claim already landed, and the request's own band does not read it: frq-0aae08039590a06d's edit (f65f327e9) made dr-reading-kind answer counsel where the landed
  // claim dr-reading-kind("counsel") == "" held, the combined band fell 63 to 55 and the landing read green. Every <file>-*-manifest-band.bml beside an edited file (its tests directory when it has one) is read after the
  // apply: a band of mf-c-N claims reads full at 2^N - 1, and one that no longer does ends the pass partial, kind contradicts-landed-claim, the text goes back (fl-end), the cause names the bands.
  def fl-sib-claims(path) = len(split-on(fl-text(path), "def mf-c-")) - 1;
  def fl-sib-full(n) = foldl((a, i) => a * 2 + 1, 0, range(0, n));
  def fl-sib-dir(p) = nothing?(fs_list(fl-cat([fl-parent-of(p), "/tests"]))) ? fl-parent-of(p) : fl-cat([fl-parent-of(p), "/tests"]);
  def fl-sib-file(p, n) = str_find(n, fl-cat([substring(fl-base(p), 0, str_find(fl-base(p), ".", 0)), "-"]), 0) == 0 && fl-ends?(n, "-manifest-band.bml");
  def fl-sib-bands(S) = fl-uniq(foldl((acc, o) => !fl-form?(o[0]) ? acc : append(acc, map(n => fl-cat([fl-sib-dir(o[0]), "/", n]), filter(n => fl-sib-file(o[0], n), fs_list(fl-sib-dir(o[0])) ?? []))), [], record_get(S, "orig")));
  def fl-sib-held?(b) { let v = fl-v(fl-run-band(b)); !nothing?(v) && v == fl-sib-full(fl-sib-claims(b)); }
  def fl-sib-hurt(S) = filter(b => (String) b != (String) record_get(S, "band") && fl-sib-claims(b) > 0 && !fl-sib-held?(b), fl-sib-bands(S));
  def fl-land-siblings(S) { let hs = fl-sib-hurt(S); len(hs) == 0 ? fl-land-witness(S) : fl-land-contradicts(S, hs); }
  def fl-land-contradicts(S, hs) {
   let a = record_set(S, "cause", "contradicts-landed-claim");
   let b = record_set(S, "green", 0);
   fl-emit(S, "land", "part", 0, 1, "contradicts-landed-claim", fl-head(str-join-with(map(h => fl-base(h), hs), ","), 120), 0);
  }
  def fl-land-grounding(S, inv) = len(inv) == 0 ? fl-land-siblings(S) : record_get(S, "grounded") == 0 ? fl-ground-heal(S, inv, host_monotonic_ms()) : fl-land-ungrounded(S, inv);
  def fl-ground-heal(S, inv, t) {
   let a = record_set(S, "grounded", 1);
   let rows = record_get(S, "mf");
   let more = fsg-mf-rows(fl-ask(S, fl-cat([fl-mf-packet(S), "\n\n", fsg-mf-invented-ask(inv)]), "repair-manifest-" ++ record_get(S, "id") ++ "-ground"));
   let kept = filter(r => !any?(x => (String) x[2] == (String) r[2], inv), rows);
   // an answer that gives the invented fixtures again is no answer: the same calls are dropped from it (the landing of 5e887d3be carried 60 and 3000 through the heal because the merge took them back)
   let fresh = filter(r => !any?(x => (String) x[2] == (String) r[2], inv), more);
   let merged = fsg-mf-merge(kept, fresh);
   len(merged) == len(kept) ? fl-land-ungrounded(S, inv) : fl-contrast-band(S, merged, t);
  }
  def fl-land-ungrounded(S, inv) {
   let a = record_set(S, "cause", "ungrounded-fixture");
   let b = record_set(S, "green", 0);
   fl-emit(S, "land", "part", 0, 1, "ungrounded-fixture", fl-head(fsg-mf-join(map(r => r[2], inv), ","), 120), 0);
  }
  def fl-land(S) = record_get(S, "green") == 1 && record_get(S, "land") == 1 && !fl-prose?(S) ? (fl-code-changed?(S) ? fl-land-checked(S, fl-weakened(S)) : fl-land-comments(S)) : fl-land-held(S);
  def fl-land-held(S) {
   let prose = record_get(S, "green") == 1 && record_get(S, "land") == 1 && fl-prose?(S);
   let kept = prose ? fl-git("diff", append(["diff", fl-cat(["--output=", fl-claim(record_get(S, "id")), ".patch"]), "--"], record_get(S, "paths"))) : 0;
   let c = prose ? record_set(S, "cause", "prose-needs-review") : record_get(S, "green") == 1 ? record_set(S, "cause", "land-not-asked") : 0;
   let why = prose ? "prose-needs-review" : record_get(S, "green") == 1 ? "land-not-asked" : "not-green";
   fl-emit(S, "land", "part", 0, 0, why, "", 0);
  }
  // The flow lands its own change. The paths it wrote are committed alone (--only: whatever else stands in the tree stays where it is) and pushed as a fast-forward; the witness it carries is the
  // band's verdict it just read. No door stands between: the drift gates are the body's mirror and read main after the fact (the walk), and a main that moved leaves the commit ahead for the walk's follow.
  def fl-git(step, args) = hch-git-in(hch-dir(), ".", step, args);
  def fl-ran?(run) = !nothing?(run[0]) && run[0] == 0;
  def fl-subject(S) = fl-cat(["The flow landed ", record_get(S, "id"), ": the local voice's candidate ", len(record_get(S, "band")) > 0 ? fl-cat(["turned the band ", record_get(S, "band"), " to its verdict ", record_get(S, "full").str()]) : "compiled clean over the files it changed", ", no rented token"]);
  // In a tree of its own the flow carries its one commit over a main that moved (rebase on the clean tree) and pushes the fast-forward; a rebase that conflicts is undone and the commit stays local, named.
  def fl-push-rebased() {
   let a = fl-git("fetch", ["fetch", "-q", "origin", "main"]);
   let b = fl-git("rebase", ["rebase", "-q", "origin/main"]);
   fl-ran?(b) ? fl-git("push", ["push", "-q", "origin", "HEAD:main"]) : fl-git("rebase", ["rebase", "--abort"]);
  }
  def fl-land-go(S) {
   let t = host_monotonic_ms();
   let g = fl-emit(S, "land", "go", 0, 0, "landing", record_get(S, "id"), 0);
   let paths = filter(p => fl-root-ok?(p), record_get(S, "paths"));
   let added = fl-git("add", append(["add", "--"], paths));
   let made = fl-git("commit", append(["commit", "-q", "--only", "-m", fl-cat([fl-subject(S), "\n\nPlan, candidate, apply, band and land ran in one pass of observe/flow-direct-run.bml; the witness is ", len(record_get(S, "band")) > 0 ? fl-cat([record_get(S, "band"), " reading ", record_get(S, "full").str()]) : "the compile of the changed files", ". rent_tokens 0."]), "--"], paths));
   let sent = !fl-ran?(made) ? made : record_get(S, "isolated") == 1 ? fl-push-rebased() : fl-git("push", ["push", "-q", "origin", "HEAD:main"]);
   let ok = fl-ran?(made);
   let a = record_set(S, "landed", ok ? 1 : 0);
   let nc = !ok && (str_find(hch-said(made), "nothing to commit", 0) >= 0 || str_find(hch-said(made), "no changes added", 0) >= 0 || str_find(hch-said(made), "nothing added to commit", 0) >= 0);
   let b = nc ? record_set(S, "cause", "no-change") : ok ? 0 : record_set(S, "cause", "commit-refused");
   fl-emit(S, "land", ok ? "ok" : "disc", ok ? 1 : 0, ok ? 0 : 1, ok ? (fl-ran?(sent) ? "landed" : "landed-ahead") : nc ? "no-change" : "commit-refused", fl-line(hch-said(made)), fl-since(t));
  }
  // ── the end ──
  // a file the pass made (its orig text empty) goes with it when it does not land: git removes it while it is untracked, so a band the flow wrote is not left blank in the tree
  def fl-restore(S) {
   let a = record_get(S, "landed") == 1 ? 0 : foldl((acc, o) => acc + write_file_text(o[0], o[1]), 0, record_get(S, "orig"));
   let b = record_get(S, "landed") == 1 ? 0 : foldl((acc, o) => len(o[1]) == 0 ? acc + (fl-ran?(fl-git("clean", ["clean", "-fq", "--", o[0]])) ? 1 : 0) : acc, 0, record_get(S, "orig"));
   a;
  }
  def fl-verdict(S) = record_get(S, "landed") == 1 ? "landed" : record_get(S, "green") == 1 ? "green" : record_get(S, "applied") > 0 ? "partial" : "ended";
  // A green pass keeps the cause the land step already named. Folding every unlanded green pass into band-full-not-landed hid a pass that was never asked to land, and that kind is not carried again, so the request stopped short of its landing.
  def fl-cause(S) = record_get(S, "landed") == 1 ? "landed" : record_get(S, "green") == 1 ? (len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "band-full-not-landed") : len(record_get(S, "cause")) > 0 ? record_get(S, "cause") : "unknown";
  def fl-end(S) {
   let v = fl-verdict(S);
   let c0 = fl-cause(S);
   let c = c0 != "landed" && c0 != "no-change" && c0 != "band-full-not-landed" && c0 != "land-not-asked" && c0 != "kernel-source-hand" && c0 != "prose-needs-review" && fl-again?(S, c0) ? "same-again" : c0;
   let ms = fl-since(record_get(S, "t0"));
   let rep = record_get(record_get(S, "F"), "rep");
   let a = fl-emit(S, "end", v == "landed" || v == "green" ? "ok" : v == "partial" ? "part" : "disc", record_get(S, "got"), record_get(S, "miss"), v ++ ":" ++ c, record_get(S, "id"), ms);
   let kept = fl-saw-keep(S);
   let endrow = fl-door-stamp(fsg-end-row(record_get(S, "id"), v, c, record_get(S, "got"), record_get(S, "miss"), rep, ms), S);
   let b = sbt-append-count(record_get(S, "ledger"), endrow ++ "\n");
   let side = write_file_text(fl-end-path(record_get(S, "id")), endrow ++ "\n");
   let reset = write_file_text(fl-tries-path(record_get(S, "id")), "0");
   let r = fl-restore(S);
   print_str(fl-cat(["{\"request\":\"", record_get(S, "id"), "\",\"verdict\":\"", v, "\",\"cause\":\"", c, "\",\"got\":", record_get(S, "got").str(), ",\"missed\":", record_get(S, "miss").str(), ",\"repairs\":", rep.str(), ",\"ms\":", ms.str(), ",\"rent_tokens\":0}\n"]));
  }
  // No request named: the next is the best ranked row the triage pass (observe/local-plan-run.bml {"triage":1}) left in the ledger, one the flow
  // has not carried yet (every flowed one only when none is left), so the GPU minutes go to the requests a local voice can land.
  def fl-after(l, key) {
   let a = str_find(l, key, 0);
   a < 0 ? "" : substring(l, a + len(key), len(l));
  }
  def fl-line-id(l) { let t = fl-after(l, "\"request\":\""); let e = str_find(t, "\"", 0); e < 0 ? "" : substring(t, 0, e); }
  def fl-line-at(l) { let t = fl-after(l, "\"at_unix_ms\":"); let e = str_find(t, ",", 0); e < 0 ? 0 : (try str_to_int(substring(t, 0, e)) catch 0); }
  def fl-line-got(l) { let t = fl-after(l, "\"got\":"); let e = str_find(t, ",", 0); e < 0 ? 0 : (try str_to_int(substring(t, 0, e)) catch 0); }
  // the k-th best of the pool by score (slot k of a flow that loops takes the k-th, so flows running side by side do not carry the same request)
  def fl-best(pool) = foldl((b, l) => fl-line-got(l) > fl-line-got(b) ? l : b, pool[0], pool);
  // The rows of a pool may share an id (one request, several triage rows): taking the best out removes all of them, and a slot deeper than the pool's distinct requests keeps the last one it reached, so a slot never picks nothing while a request is live.
  def fl-kth(pool, k) = len(pool) == 0 ? "" : k <= 0 || len(pool) == 1 ? fl-line-id(fl-best(pool)) : fl-kth-rest(pool, k, filter(l => fl-line-id(l) != fl-line-id(fl-best(pool)), pool));
  def fl-kth-rest(pool, k, rest) = len(rest) == 0 ? fl-line-id(fl-best(pool)) : fl-kth(rest, k - 1);
  // One small git answer a request (a hash or nothing): the whole subject list of 800 commits overran the host door's string buffer and every pass of a loop failed with fk_cstr (2026-11-15)
  def fl-landed-in-git?(id) = len(id) > 0 && len(trim(hch-said(fl-git("log", ["log", "-1", "--format=%h", "--fixed-strings", fl-cat(["--grep=The flow landed ", id])])))) > 0;
  // Who the git question serves: the one request the flow is about to carry. It is asked of that request alone (one small answer), and a request the commits say landed leaves the choice and the choice is made again:
  // asked of every live request it was ~100 child processes and ~20 s before any work began (measured 2026-11-15).
  def fl-next-in(lines, anyok, slot) = fl-next-skip(lines, anyok, slot, []);
  def fl-next-skip(lines, anyok, slot, skip) {
   let id = fl-next-pick(lines, anyok, slot, skip);
   len(id) > 0 && fl-landed-in-git?(id) ? fl-next-skip(lines, anyok, slot, cons(id, skip)) : id;
  }
  def fl-next-pick(lines, anyok, slot, skip) {
   let tri = filter(l => str_find(l, "\"rung\":\"triage\"", 0) >= 0, lines);
   // A request is live when its LATEST triage row is ranked: an older row that ended it (owned-elsewhere, no-writable-file, source-absent: kinds triage no longer ends anything by) does not hold it back
   // once triage has ranked it again. Read by the old rule, 60 of 136 ranked requests were never offered and one partial request was carried five passes in a row.
   let live = filter(l => str_find(l, "\"verdict\":\"ranked\"", 0) >= 0 && !(any?(m => fl-line-id(m) == fl-line-id(l) && str_find(m, "\"verdict\":\"ranked\"", 0) < 0 && fl-line-at(m) > fl-line-at(l), tri)), tri);
   let door = fl-door();
   // A request a flow already landed (or found already satisfied) is done, under any door: taking "any live row" when no fresh one is left re-landed the same request six times in a loop (2026-11-14,
   // frq-b92a022b37c3e92b), and a request landed under another door's hash was still "fresh" and was carried again as no-change (frq-18a217c14066768a). Done requests leave the live set before anything is chosen.
   // The ledger row is sparse (written when a flow's kind or score moved), so a landing can leave none: the commit subjects are the other record, "The flow landed <id>", read once here
   let notdone = filter(l => !any?(s => (String) s == fl-line-id(l), skip) && !any?(r => str_find(r, "\"verdict\":\"landed\"", 0) >= 0 || str_find(r, "\"kind\":\"no-change\"", 0) >= 0 || str_find(r, "\"kind\":\"same-again\"", 0) >= 0, fl-flow-rows(lines, fl-line-id(l))), live);
   let fresh = filter(l => fl-takeable?(lines, fl-line-id(l), door), notdone);
   // A request no flow has carried goes before one that already ended partial: frq-67ea33f0b543fa03 ended band-compile-error and same-again four passes in a row while 130 requests had never been tried
   let untouched = filter(l => len(fl-flow-rows(lines, fl-line-id(l))) == 0, fresh);
   let pool = len(untouched) > 0 ? untouched : len(fresh) > 0 ? fresh : anyok ? notdone : [];
   fl-kth(pool, slot);
  }
  def fl-next(lines) = fl-next-in(lines, true, 0);
  // One request through the whole flow in one pass; with loop 1 the flow goes on to the next fresh ranked request itself (nothing outside drives it) and ends when none is left.
  // A request is carried once: its claim is a small untracked file written when the flow takes it, so no git step erases it (the tracked ledger's appends did not survive a landing) and two flows never take the same request.
  // The claim is shared by every flow whatever tree it works in (a fixed place outside any checkout).
  def fl-claim(id) = "/tmp/form-flow-claims/" ++ id;
  // A request ends in a counted kind, and the flow that ended it is a version of this door (the git blob of observe/flow-direct-run.bml at the tree's head, stamped on the end row as "door" and
  // written into the claim). When the door improves, a request that ended in a kind the door can heal (the voice's answer applied nothing, its blocks did not match the file, the band did not
  // compile, the planner stopped, or the witness held and the landing did not) is the next fresh request for the new door and no one has to say so: the loop takes it by itself. A request the current door already ended, or landed, stays ended.
  def fl-door() = fl-head(trim(hch-said(fl-git("rev-parse", ["rev-parse", "HEAD:observe/flow-direct-run.bml"]))), 12);
  def fl-healable() = ["nothing-applied", "no-edit-blocks", "edit-old-text-not-found", "band-compile-error", "band-unbound-name", "band-stopped", "plan-planner-stopped", "voice-unread", "land-not-asked", "commit-refused", "band-full-not-landed"];
  // What an attempt saw is carried, never repeated blind: the end row keeps the head of the voice's last answer (saw), and the next attempt of the same request is told how the last one ended and
  // how its answer began, so it answers differently. When an attempt ends in the same kind the last one did (the voice words its answers differently each time, so the kind is the signal, not the words), the loop has learnt nothing by trying again: the
  // request ends as "same-again", a disc cell names it, and it is no longer healable by a door's change: it is the rented guidance's, seen through the signal frame.
  // The voice's words are kept as they came, in a file beside the claim: nothing escapes them into a JSON row (five passes over the text) and nothing scans them back out of one. The ledger row carries the door only.
  def fl-saw-path(id) = fl-cat([fl-claim(id), ".saw"]);
  def fl-saw-keep(S) = write_file_text(fl-saw-path(record_get(S, "id")), fl-head(fl-first-block(record_get(S, "reply") ?? ""), 400));
  // The end row names the voice's rows: every ask of this pass is a local-run row whose "who" begins with this stem (lens-names-<id>, flow-<id>, flow-<id>-fix), so the end row and its asks join by name, not by time.
  def fl-door-stamp(row, S) = substring(row, 0, len(row) - 1) ++ ",\"door\":\"" ++ fl-door() ++ "\",\"planned\":" ++ record_get(S, "plan").str() ++ ",\"who\":\"flow-" ++ record_get(S, "id") ++ "\"}";
  // The planner is 45% of the voice's time (121,127 of 266,487 s) and 892 of 1,287 s in the one landed run read end to end; whether a plan raises the landing is not recorded anywhere. Requests alternate by the last hex digit
  // of their id (odd: planned, even: the request's own words and files), and the end row says which arm it ran; a caller that names plan keeps its own. Thirty requests of each arm answer it.
  def fl-hexval(c) = c >= 97 ? c - 87 : c - 48;
  def fl-arm(id) { let v = len(id) == 0 ? 1 : fl-hexval(str_byte_at(id, len(id) - 1)); v - 2 * (v / 2); }
  def fl-last-flow-row(S) { let rows = fl-flow-rows(split-on(fl-text(record_get(S, "ledger")), "\n"), record_get(S, "id")); len(rows) == 0 ? "" : rows[len(rows) - 1]; }
  def fl-again?(S, kind) {
   let last = fl-last-flow-row(S);
   len(last) > 0 && fl-row-kind(last) == kind;
  }
  def fl-prior(S) {
   let last = fl-last-flow-row(S);
   len(last) == 0 ? "" : fl-cat(["\n\nA previous attempt of this request ended as ", fl-row-kind(last), "; its answer began: ", fl-text(fl-saw-path(record_get(S, "id"))), "\nDo not answer the same way; read the file text above again and answer differently."]);
  }
  // A request's last end is also kept beside its claim (outside git): a landing resets the tracked ledger, so the rows a pass appended were gone by the next pick, and a request that ended band-compile-error was carried again
  // every time the door's hash moved (four passes of ~22 minutes on frq-d5ecc30c374ddb85, 2026-11-15). The sidecar is the same row the ledger got.
  def fl-end-path(id) = fl-cat([fl-claim(id), ".end"]);
  def fl-flow-rows(lines, id) {
   let own = filter(m => str_find(m, "\"rung\":\"flow\"", 0) >= 0 && fl-line-id(m) == id, lines);
   let side = trim(fl-text(fl-end-path(id)));
   len(side) > 0 && !any?(r => (String) r == (String) side, own) ? append(own, [side]) : own;
  }
  def fl-row-kind(m) { let t = fl-after(m, "\"kind\":\""); let e = str_find(t, "\"", 0); e < 0 ? "" : substring(t, 0, e); }
  def fl-healable?(rows, door) { let last = rows[len(rows) - 1]; len(rows) > 0 && any?(k => k == fl-row-kind(last), fl-healable()) && str_find(last, fl-cat(["\"door\":\"", door]), 0) < 0; }
  def fl-claim-of-door?(id, door) = file_size(fl-claim(id)) >= 0 && str_find(fl-text(fl-claim(id)), door, 0) == 0;
  def fl-takeable?(lines, id, door) {
   let rows = fl-flow-rows(lines, id);
   len(rows) == 0 ? !fl-claim-live?(id) : fl-healable?(rows, door) && !(fl-claim-of-door?(id, door) && fl-claim-live?(id));
  }
  // A claim is held while the flow that wrote it lives: its token carries the pid (door slot-pid-time). A claim whose process is gone (a flow killed by a restart, a crash) holds nothing:
  // it blocked ten requests for hours and the loops exited with thirteen still ranked. The claim's own pid is read from the process table, no clock and no count.
  def fl-claim-pid(id) {
   let parts = split-on(trim(fl-text(fl-claim(id))), " ");
   let seg = len(parts) < 2 ? [] : split-on(parts[1], "-");
   len(seg) < 2 ? 0 : (try str_to_int(seg[1]) catch 0);
  }
  def fl-claim-live?(id) {
   let pid = fl-claim-pid(id);
   file_size(fl-claim(id)) >= 0 && pid > 0 && (String) value_kind(host_process(pid)) == "list";
  }
  // Each flow works in a tree of its own (a git worktree per slot, made by the launcher) and starts every request from main as it stands: nothing a neighbour is editing is ever read or committed,
  // and nothing is left over from the request before.
  def fl-sync() {
   let a = fl-git("fetch", ["fetch", "-q", "origin", "main"]);
   fl-git("checkout", ["checkout", "-q", "-f", "--detach", "origin/main"]);
  }
  // A request is taken by one flow: the claim carries the door and a token (slot, pid, time); the last writer of a claim wins, and after a settle every flow that wrote it reads it back, so
  // the ones whose token is not there yield at once to the next fresh request (two loops picked the same request in the same second and spent a pass each).
  def fl-token(o) = fl-cat([fl-door(), " ", svs-int(o, "slot", 0).str(), "-", host_pid().str(), "-", host_monotonic_ms().str()]);
  // A pass that dies (fkwu segfaulted four seconds into every pass that picked one request, 2026-11-15, exit 139) leaves no end row, so the next pass took the same request and died again, for ever. Each take counts itself
  // beside the claim and a normal end sets the count back to zero: a request taken a fourth time with no end behind it ends as "fkwu-crashed", named, and the loop goes on to the next.
  def fl-tries-path(id) = fl-cat([fl-claim(id), ".tries"]);
  def fl-tries(id) = (try str_to_int(trim(fl-text(fl-tries-path(id)))) catch 0);
  def fl-crashed(o, id) {
   let row = fsg-end-row(id, "ended", "fkwu-crashed", 0, 0, 0, 0);
   let stamped = substring(row, 0, len(row) - 1) ++ ",\"door\":\"" ++ fl-door() ++ "\"}";
   let a = sbt-append-count(fl-ledger-of(o), stamped ++ "\n");
   let b = write_file_text(fl-end-path(id), stamped ++ "\n");
   let c = write_file_text(fl-tries-path(id), "0");
   print_str(fl-cat(["{\"request\":\"", id, "\",\"verdict\":\"ended\",\"cause\":\"fkwu-crashed\",\"got\":0,\"missed\":0,\"repairs\":0,\"ms\":0,\"rent_tokens\":0}\n"]));
  }
  def fl-one(o, id) {
   let made = fs-mkdir("/tmp/form-flow-claims");
   let n = fl-tries(id) + 1;
   let counted = write_file_text(fl-tries-path(id), n.str());
   n > 3 && file_size(fl-end-path(id)) < 0 ? fl-crashed(o, id) : fl-one-claimed(o, id);
  }
  def fl-one-claimed(o, id) {
   let tok = fl-token(o);
   let claimed = write_file_text(fl-claim(id), tok ++ "\n");
   let settle = host_sleep_ms(300);
   trim(fl-text(fl-claim(id))) == tok ? fl-one-run(o, id) : 0;
  }
  def fl-one-run(o, id) {
   let synced = svs-int(o, "isolated", 0) == 1 ? fl-sync() : 0;
   let S = fl-new(o, id);
   let a = fl-emit(S, "start", "ok", 0, 0, "begin", record_get(S, "id"), 0);
   let b = fl-plan(S);
   let m = fl-manifest(S);
   let c = fl-candidate(S);
   let d = fl-band(S);
   let e = fl-land(S);
   fl-end(S);
  }
  def fl-loop(o, id) {
   let done = fl-one(o, id);
   let nx = svs-int(o, "loop", 0) == 1 ? fl-next-in(split-on(fl-text(fl-ledger-of(o)), "\n"), false, svs-int(o, "slot", 0)) : "";
   len(nx) > 0 && (String) nx != id ? fl-loop(o, nx) : done;
  }
  def fl-run() {
   let o = dop-doc("flow", stdin-text(), fl-spec());
   let named = svs-str(o, "request", "");
   let lease = gpl-role(gpu-lease-path());
   let leased = print_str(fl-cat(["[flow:lease] pid ", host_pid().str(), " ", nothing?(lease) ? "no resident stands" : fl-cat([(String) lease[0], " of the resident on the device (token ", (String) lease[1], ")"])]));
   fl-loop(o, len(named) > 0 ? named : fl-next-in(split-on(fl-text(fl-ledger-of(o)), "\n"), true, svs-int(o, "slot", 0)));
  }
 }
 fl-run();
}
