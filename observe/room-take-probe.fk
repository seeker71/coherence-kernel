; room-take-probe.fk — a taker of my own: does what the room sensor GAVE come back
; as the same cells, readable by anyone holding form-glass-sensor-rows?
; preludes: form/form-stdlib/form-glass-sensor-rows.bml
(do
    (defn rt-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (rt-cat (tail xs)))))
    (defn rt-pad (s n) (if (ge (str_len s) n) s (rt-pad (str_concat s " ") n)))
    (defn rt-val (row) (if (eq (fgo-present? row) 0) "(absent)" (if (str_eq (fgo-value-kind row) "int") (str_concat (int_to_str (fgo-int-value row)) (if (eq (str_len (fgo-unit row)) 0) "" (str_concat " " (fgo-unit row)))) (fgo-text-value row))))
    (defn rt-show (rows) (if (eq (len rows) 0) 0
        (do (let r (head rows))
            (print (rt-cat (list (rt-pad (fgo-id r) 22) (rt-pad (fgo-evidence r) 16) (rt-val r))))
            (rt-show (tail rows)))))
    (let held (fgsr-take "room" (list)))
    (let rows (fgsr-rows-or-absent "room" held))
    (print (str_concat "standing=" (int_to_str (fgsr-standing? "room"))))
    (rt-show rows)
    (print (str_concat "rows=" (int_to_str (len rows))))
    (len rows))
