; qwen38-axioms-query-rehearsal-live-run.fk -- focused public RAG transfer.
;
; This intentionally effectful local-only door gives Qwen one public
; source-bound query token but never the curriculum answer or independent
; evaluator answer. The qtf2/BMF cursor streams the prompt; a distinct bounded
; Heed cursor recognizes the model-generated query. Form parses it, performs
; the source lookup, injects the typed observation, and resumes answer
; generation. This is answer-task-disjoint supervised RAG, not unassisted
; heldout evidence. Transport embodiment and answer quality are reported as
; separate axes. Output retains only scores, hashes, counters, cursor and
; release signals.
;
; preludes: observe/qwen38-axioms-one-family-complete-live-run.fk

import "./qwen38-axioms-one-family-complete-live-run.fk"

(do
    (defn fkaqrl-run-with-query (path model-id selected-query)
    (do
    (let seed-row (fkhe-find-row "h01" (fkhe-rows)))
    (let presentation (head (fkp30-presentations-row seed-row)))
    (let question (fkp30-presentation-prompt presentation))
    ; The selected bytes may come from a bounded query-memory data cell.  Parse
    ; them through the existing scannerless grammar; only its admitted anchor
    ; can construct the source-bound offer.  No source module is imported for
    ; the selected memory and the frame never contains the expected answer.
    (let selected (fkqt-parse selected-query))
    (let anchor (if (eq (fkqt-request-ready? selected) 1)
        (fkqt-request-query selected) ""))
    (let offer (fkap-rag-query-offer
        (fkp30-presentation-source presentation) anchor question))
    (let prompt (fkap-query-rehearsal-prompt offer question))
    (let expected-frame (nth offer 3))
    (let effective (if (nothing? prompt) ""
        (fqt-bound-source-knowledge-prompt prompt)))
    (let admitted (if (and (eq (fkp30-presentation-valid? presentation) 1)
        (and (eq (fkqt-request-ready? selected) 1)
        (and (eq (fkap-rag-query-offer-valid? offer question) 1)
        (and (not (nothing? prompt))
        (and (str_eq (nth offer 3) selected-query)
        (and (str_eq (nth offer 4)
                     (fkp30-presentation-source presentation))
             (eq (str_len expected-frame) (str_len (fhc-frame
                 expected-frame))))))))) 1 0))
    (let binding-sha (nmfe-sha256 (nmfe-fields (list
        "axioms-query-rehearsal-binding-v1"
        (fkp30-presentation-row-id presentation)
        (fkp30-presentation-source presentation)
        (fkp30-presentation-source-sha presentation)
        (nmfe-sha256 question) (nmfe-sha256 expected-frame)
        (nmfe-sha256 effective)))))
    (let started (now_unix_ms))
    (let generated (if (eq admitted 1)
        (fcmg-generate-current-source-resident-at
            (fcmr-none) path prompt
            (fkp30-presentation-source presentation))
        (list "rehearsal refused before model open" (fcmr-none))))
    (let raw (nth generated 0))
    (let raw-sha (nmfe-sha256 raw))
    ; Release ownership before any later parser/scorer dereference can refuse.
    (let residence-release (fcmr-release-ok? (nth generated 1)))
    (let parsed (fkhe-parse-resident-output raw))
    (let generated-text (fkhe-output-generated parsed))
    (let actual-frame (fhc-frame generated-text))
    (let query-at (str_find generated-text expected-frame 0))
    (let query-repeat (if (lt query-at 0) -1
        (str_find generated-text expected-frame
            (add query-at (str_len expected-frame)))))
    ; The seed row is constructed before generation, but its expected bytes are
    ; never placed in the model context. Generated bytes are sealed before the
    ; expected value is used for this separate answer-quality observation.
    (let row (fkhe-find-row (fkp30-presentation-row-id presentation)
        (fkhe-rows)))
    (let score (fkhe-score row effective parsed
        (sub (now_unix_ms) started)))
    (let observation (fkhe-score-observation score))
    (let live-cursor (if (ge (str_find raw
        "prompt_cursor=bmf-qtf2-live-v1\n" 0) 0) 1 0))
    (let state-release (fka1l-state-released-from-report raw))
    (let promotion (if (eq (nmfe-obs-error observation) 0)
        (nmfe-obs-promotion observation) 0))
    (let answer-score95 (if (ge promotion 950000) 1 0))
    (let answer-key (fcmg-span-field raw "heed_answer_key"))
    (let transport-bits (sum (list
        (if (eq admitted 1) 1 0)
        (if (eq live-cursor 1) 2 0)
        (if (str_eq actual-frame expected-frame) 4 0)
        (if (eq query-at 0) 8 0)
        (if (lt query-repeat 0) 16 0)
        (if (str_eq (fcmg-span-field raw "heed_cursor")
                    "bounded-current-source-v1") 32 0)
        (if (eq (fht-report-int raw "heed_lookups") 1) 64 0)
        (if (eq (fht-report-int raw "heed_source_searches") 1) 128 0)
        (if (eq (fht-report-int raw "heed_honored") 1) 256 0)
        (if (eq (fht-report-int raw "heed_hits") 1) 512 0)
        (if (eq (fht-report-int raw "heed_close_commits") 1) 1024 0)
        (if (eq (fht-report-int raw "heed_misses") 0) 2048 0)
        (if (eq (fht-report-int raw "heed_nothings") 0) 4096 0)
        (if (eq (fht-report-int raw "heed_spent") 0) 8192 0)
        (if (eq (fht-report-int raw "heed_injection_refusals") 0) 16384 0)
        (if (eq (fht-report-int raw "heed_decode_timeout") 0) 32768 0)
        (if (eq (fht-report-int raw "heed_frame_refusals") 0) 65536 0)
        (if (gt (fht-report-int raw "heed_injected_tokens") 0) 131072 0)
        (if (str_eq (fcmg-span-field raw "heed_evidence_status")
                    "hit") 262144 0)
        (if (str_eq (fcmg-span-field raw "heed_evidence_reason")
                    "current-source-context-path-hit") 524288 0)
        (if (and (str_eq (fcmg-span-field raw "heed_source_path")
                         (fkp30-presentation-source presentation))
                 (and (str_eq (nth offer 4)
                              (fkp30-presentation-source presentation))
                      (str_eq (fcmg-span-field raw "heed_source_artifact")
                              (nth offer 5)))) 1048576 0)
        (if (eq (nmfe-sha256? answer-key) 1) 2097152 0)
        (if (eq (fht-report-int raw "heed_model_executed") 0) 4194304 0)
        (if (eq state-release 1) 8388608 0)
        (if (eq residence-release 1) 16777216 0)
        (if (and (gt (fht-report-int raw "generated_tokens") 0)
                 (gt (fht-report-int raw "heed_answer_tokens") 0)) 33554432 0)
        (if (gt (fht-report-int raw "forward_passes") 0) 67108864 0))))
    (fka1l-line "status" (if (eq transport-bits 134217727)
        "axioms-query-rehearsal-observed" "transport-not-yet"))
    (fka1l-line "model-id" model-id)
    (fka1l-line "binding-sha" binding-sha)
    (fka1l-line "effective-prompt-sha" (nmfe-sha256 effective))
    (fka1l-line "expected-frame-sha" (nmfe-sha256 expected-frame))
    (fka1l-line "actual-frame-sha" (nmfe-sha256 actual-frame))
    (fka1l-line "raw-sha" raw-sha)
    (fka1l-line "answer-sha" (nmfe-sha256 (fkhe-output-answer parsed)))
    (fka1l-line "answer-key" answer-key)
    (fka1l-line "reported-source-artifact"
        (fcmg-span-field raw "heed_source_artifact"))
    (fka1l-line "source-sha"
        (fkp30-presentation-source-sha presentation))
    (fka1l-int "live-cursor" live-cursor)
    (fka1l-int "query-frame-exact" (if
        (str_eq actual-frame expected-frame) 1 0))
    (fka1l-int "query-frame-at-zero" (if (eq query-at 0) 1 0))
    (fka1l-int "query-frame-once" (if (lt query-repeat 0) 1 0))
    (fka1l-int "query-tokens" (fht-report-int raw "heed_query_tokens"))
    (fka1l-int "answer-tokens" (fht-report-int raw "heed_answer_tokens"))
    (fka1l-int "hits" (fht-report-int raw "heed_hits"))
    (fka1l-int "misses" (fht-report-int raw "heed_misses"))
    (fka1l-int "nothings" (fht-report-int raw "heed_nothings"))
    (fka1l-int "frame-refusals"
        (fht-report-int raw "heed_frame_refusals"))
    (fka1l-int "generated-tokens"
        (fht-report-int raw "generated_tokens"))
    (fka1l-int "forward-passes"
        (fht-report-int raw "forward_passes"))
    (fka1l-int "exact-ppm" (nmfe-obs-exact observation))
    (fka1l-int "f1-ppm" (nmfe-obs-f1 observation))
    (fka1l-int "sequence-ppm" (nmfe-obs-sequence observation))
    (fka1l-int "promotion-ppm" promotion)
    (fka1l-int "answer-score95" answer-score95)
    (fka1l-int "error" (nmfe-obs-error observation))
    (fka1l-int "state-release" state-release)
    (fka1l-int "residence-release" residence-release)
    (fka1l-int "latency-ms" (sub (now_unix_ms) started))
    transport-bits))

    ; Compatibility door for the original supervised rehearsal.  New rotated
    ; memories call fkaqrl-run-with-query with their admitted data-cell bytes.
    (defn fkaqrl-run (path model-id)
        (fkaqrl-run-with-query path model-id
            "<|form:knowledge-query|>resting point<|/form:knowledge-query|>"))

    ; Intentionally dormant. A carrier owner invokes fkaqrl-run explicitly.
    0)
