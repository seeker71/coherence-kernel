; walk-home-atlas-run.fk — Glass atlas of the walk only: steps, trusted
; cells, unique offerings, body home, voice still coming.
;
; preludes: form/form-stdlib/walk-home.fk form/form-stdlib/form-glass-live-ui.bml form/form-stdlib/hearth.bml

(do
    (let epoch (now_unix_ms))
    (let published (wh-publish-glass (hearth-telemetry-root) epoch))
    (let reading (fgtm-read-current (hearth-telemetry-root) "walk-home"))
    (let snap (if (str_eq (fgtm-read-state-status reading) "current")
                  (fgtm-field-value (fgtm-read-state-value reading))
                  (list)))
    (let samples (if (eq (len snap) 0) (list) (fgtm-snapshot-samples snap)))
    (let frame (fgd-live-segment-frame 80 24 epoch 2 0 "atlas" "all" "all" "none" 0
        (list) samples (list "walk-home") "held" (list) (list) "walk-home atlas"))
    (print_str (fgd-segment-project frame))
    (if (and (str_eq (nth published 1) "published") (gt (len samples) 0)) 1 0))
