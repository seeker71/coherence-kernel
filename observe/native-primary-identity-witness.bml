// Actual primary-column import; expected words come from existing semantic doors.
// preludes: form-stdlib/bml/native-primary-identity.bml
section [form.bml] {
 def npit-need(ok,why) = if ok then 1 else form_error(str_concat("primary identity witness: ",why));
 def npit-more(index) = if eq(index,16) then list() else cons(make_nodeid(31,7001,2026,add(900000,index)),npit-more(add(index,1)));
 def npit-nodes() = append(list(make_nodeid(63,8191,4095,4294967295),make_nodeid(0,0,0,0),make_nodeid(1,1,1,4611686018427387903),make_nodeid(1,1,1,-4611686018427387904),make_nodeid(1,1,1,-1),intern_trivial_int(42),intern_trivial_string("primary-identity-native-reader"),intern_trivial_float("3.25"),intern_node(make_nodeid(32,7000,2026,617),list(intern_trivial_int(7)))),npit-more(0));
 def npit-word(node) {
  let p = node_pkg(node); let l = node_level(node); let t = node_type(node); let i = node_inst(node);
  if and(eq(p,1),and(eq(l,1),eq(t,1))) then if ge(i,0) then nfm-low(i,8) else {
   let biased = add(add(i,4611686018427387903),1); str_concat(nfm-low(biased,7),byte_to_str(add(64,div(biased,72057594037927936))));
  } else str_concat(nfm-low(i,4),nfm-low(add(2147483648,add(mul(p,33554432),add(mul(l,4096),t))),4));
 }
 def npit-expected(nodes) = if nil?(nodes) then "" else str_concat(npit-word(head(nodes)),npit-expected(tail(nodes)));
 def npit-queries(nodes) = if nil?(nodes) then "" else str_concat(str_concat(nfm-low(npi-slot(head(nodes)),8),nfm-low(0,8)),npit-queries(tail(nodes)));
 def npit-bytes(region,offset,bytes) = nfm-bytes-list(npd-bytes(region,offset,bytes),"");
 def npit-fill(count) = if eq(count,0) then "" else str_concat(byte_to_str(165),npit-fill(sub(count,1)));
 def npit-private() {
  let source = npi-open(); let directory = ndi-open(); let node = make_nodeid(31,7001,2026,900000);
  npit-need(not(npi-home?()),"private kernel is a different node home"); npit-need(nothing?(npi-import(source,directory,list(node))),"private handle cannot read unrelated shared slot");
  npit-need(eq(record_get(source,"calls"),1),"private refusal precedes shared object open"); npit-need(eq(record_get(directory,"generation"),0),"private refusal publishes nothing");
  npit-need(eq(npi-close(source),1),"private importer closes"); npit-need(eq(ndi-close(directory),1),"private directory closes"); print(list("primary-identity","private-home-refused",1,"released",1)); 1;
 }
 def npit-run() {
  let nodes = npit-nodes(); let expected = npit-expected(nodes); let queries = npit-queries(nodes); let source = npi-open(); let directory = ndi-open();
  npit-need(npi-home?(),"actual kernel owns shared-field nodes"); let before = record_get(directory,"generation");
  npit-need(eq(npi-import(source,directory,cons(head(nodes),nodes)),len(nodes)),"published handles deduplicate and import in one publication");
  npit-need(eq(record_get(directory,"generation"),add(before,1)),"whole known-handle batch publishes once");
  npit-need(npd-regions-closed(record_get(record_get(source,"memory"),"regions")),"source maps and stat spans released before publication returns");
  let reader = ndi-acquire(directory); let output = npd-region(ndi-memory(directory),add(str_len(expected),16));
  let sentinel = npit-fill(add(str_len(expected),16)); npit-need(eq(ndi-write(directory,output,sentinel),str_len(sentinel)),"complete nonzero output guard admitted");
  npit-need(eq(ndi-project(reader,queries,output,8),len(nodes)),"actual primary IDs served by native directory");
  npit-need(str_eq(npit-bytes(output,8,str_len(expected)),expected),"every raw bit matches independent coordinate encoding");
  npit-need(str_eq(npit-bytes(output,0,8),npit-fill(8)),"leading output guard intact"); npit-need(str_eq(npit-bytes(output,add(8,str_len(expected)),8),npit-fill(8)),"trailing output guard intact");
  let generation = record_get(directory,"generation"); let count = record_get(source,"imported");
  npit-need(nothing?(npi-import(source,directory,list(head(nodes)))),"existing identity range is not reassigned");
  npit-need(nothing?(npi-import(source,directory,list(-2))),"ordinary negative integer cannot become a node slot");
  npit-need(eq(npi-import(source,directory,list()),0),"empty import changes no generation");
  npit-need(and(eq(record_get(directory,"generation"),generation),eq(record_get(source,"imported"),count)),"refused imports retain current directory and count");
  npit-need(eq(npi-close(source),1),"all native importer mappings, fds and code retired");
  npit-need(eq(ndi-project(reader,queries,output,8),len(nodes)),"owned identity generation survives source-map owner close");
  npit-need(str_eq(npit-bytes(output,8,str_len(expected)),expected),"retained primary identities remain exact");
  let segments = len(ndi-current-segments(directory)); let nativeCalls = record_get(record_get(directory,"carrier"),"calls");
  ndi-release(reader); npit-need(eq(npd-region-close(output),0),"native output released"); npit-need(eq(ndi-close(directory),1),"identity directory fully retired");
  print(list("primary-identity","published-handles",len(nodes),"segments",segments,"generations",generation,"raw-bytes",str_len(expected),"native-carrier-calls",nativeCalls,"exact",1,"released",1)); 1;
 }
 let mode = read_line(); if str_eq(mode,"run") then npit-run() else if str_eq(mode,"private") then npit-private() else 0;
}
