; room-sense-probe.fk — the organ over SYNTHETIC frames: does it compile, and does it
; answer a tone a tone, a hiss a noise, and silence still, with no mic in the room.
; preludes: form/form-stdlib/room-sense.bml
(do
    (defn rsp-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (rsp-cat (tail xs)))))
    ; one s16le sample, little endian, as two bytes
    (defn rsp-samp (v) (do (let u (if (lt v 0) (add v 65536) v)) (str_concat (byte_to_str (sub u (mul 256 (div u 256)))) (byte_to_str (div u 256)))))
    ; a triangle wave of period p samples at 16 kHz, amplitude a
    (defn rsp-tri (i p a) (do (let ph (sub i (mul p (div i p)))) (let h (div p 2)) (if (lt ph h) (sub (div (mul 2 (mul a ph)) h) a) (sub a (div (mul 2 (mul a (sub ph h))) h)))))
    (defn rsp-tone (i n p a acc) (if (ge i n) acc (rsp-tone (add i 1) n p a (str_concat acc (rsp-samp (rsp-tri i p a))))))
    ; a deterministic pseudo-random walk: white-ish noise, no host entropy
    (defn rsp-lcg (s) (do (let x (add (mul s 1103515245) 12345)) (sub x (mul 2147483648 (div x 2147483648)))))
    (defn rsp-noise (i n s a acc) (if (ge i n) acc (do (let s1 (rsp-lcg s)) (rsp-noise (add i 1) n s1 a (str_concat acc (rsp-samp (sub (sub (div s1 65536) (mul a (div (div s1 65536) a))) (div a 2))))))))
    (defn rsp-zeros (i n acc) (if (ge i n) acc (rsp-zeros (add i 1) n (str_concat acc (rsp-samp 0)))))
    (defn rsp-show (name f) (print (rsp-cat (list name
        "  db=" (int_to_str (rs-db (rs-f-db f)))
        " zc=" (int_to_str (rs-f-zc f))
        " tilt=" (int_to_str (rs-f-tilt f))
        " lag=" (int_to_str (rs-f-lag f))
        " r=" (int_to_str (rs-f-r f))
        " half=" (int_to_str (rs-f-half f))
        " voiced=" (int_to_str (rs-f-voiced f))
        " hz=" (int_to_str (rs-f-hz f))))))
    ; 100 Hz at 16 kHz = period 160 samples ; 200 Hz = 80
    (let tone160 (rsp-tone 0 1600 160 8000 ""))
    (let tone80 (rsp-tone 0 1600 80 8000 ""))
    (let hiss (rsp-noise 0 1600 7 6000 ""))
    (let quiet (rsp-zeros 0 1600 ""))
    (print (str_concat "bytes-per-frame=" (int_to_str (str_len tone160))))
    (rsp-show "tone-100hz" (rs-frame tone160 1000 -500))
    (rsp-show "tone-200hz" (rs-frame tone80 1000 -500))
    (rsp-show "hiss      " (rs-frame hiss 1000 -500))
    (rsp-show "silence   " (rs-frame quiet 1000 -500))
    (print (str_concat "db10-of-32768=" (int_to_str (rs-db10 32768))))
    (print (str_concat "db10-of-2000=" (int_to_str (rs-db10 2000))))
    (print (str_concat "db10-of-100=" (int_to_str (rs-db10 100))))
    (print (str_concat "rows-asleep=" (int_to_str (len (rs-asleep-rows)))))
    (print (str_concat "rows-empty-state=" (int_to_str (len (rs-rows (rs-empty) 1000)))))
    77)
