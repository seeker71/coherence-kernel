// preflight-exec: forbidden
// Prepare executes every compact reference. Enqueue offers only that practice.
// preludes: learn/bml-compact-practice.bml
section [form.bml] {
 def bco-run(raw) {
  let request = parse-json("BML compact request",raw); let home = nsm-str(request,"home"); let action = nsm-str(request,"action");
  (String) action == "prepare" ? bcp-prepare(home)
  : (String) action == "enqueue" ? bcp-enqueue(home)
  : form_error("Compact action requires prepare or enqueue");
 }
 bco-run(read_line());
 0;
}
