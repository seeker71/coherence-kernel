; signal-floor-table-run.fk — readings once, then project.
; preludes: form-stdlib/form-knowledge-signal-floor-render.fk
(do
    (let rs (fksfr-readings (fksfr-banked-2026-08-26)))
    (print (fksfr-table rs))
    (print (str_concat "\ncarrying evidence: "
        (str_concat (int_to_str (fksfr-evidential-count rs))
            (str_concat " of " (int_to_str (len rs))))))
    0)
