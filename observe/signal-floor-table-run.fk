; signal-floor-table-run.fk — print the floor table.
; preludes: form-stdlib/form-knowledge-signal-floor-render.fk
(do
    (print (fksfr-table))
    (print (str_concat "\ncarrying evidence: "
        (str_concat (int_to_str (fksfr-evidential-count))
            (str_concat " of " (int_to_str (fksfr-count))))))
    0)
