// preflight-exec: forbidden
// stdin: a fresh private evidence directory. Prepares and executes references only.
// preludes: learn/bml-execution-practice.bml
section [form.bml] {
 def bep-prepare-run(home) {
 bep-prepare(home);
 print_str("prepared=" ++ home ++ "/manifest.json\n");
 }
 bep-prepare-run(read_line());
 0;
}
