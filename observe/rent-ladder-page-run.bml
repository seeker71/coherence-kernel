// rent-ladder-page-run.bml — the body draws its own progress from its own
// ledgers into docs/rent-ladder.html. The drawing itself is
// form-stdlib/bml/form-cli-rent-ladder-page.bml, so a movement redraws the
// page inside its own call.
// stdin: nothing. Prints one JSON line naming the page and the row counts.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-rent-ladder-page.bml
section [form.bml] {
 rlp-run();
}
