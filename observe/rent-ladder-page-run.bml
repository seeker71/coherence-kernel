// rent-ladder-page-run.bml — the body draws its own progress.
//
// Reads receipts/parity-contest-ledger.jsonl, receipts/rent-ledger.jsonl and
// receipts/flow-ledger.jsonl, plus the pinned route rows of the 2026-09-18
// receipt, and fills docs/rent-ladder.template.html at its /*DATA*/ mark with
// one JSON object; the filled page is written to docs/rent-ladder.html. No
// provider, no oracle, nothing leaves the body. A page is a receipt with a
// picture: every number in it is a row the body wrote.
// stdin: nothing. Prints one JSON line naming the page and the row counts.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class RentLadderPage {
  def rlp-template() = "docs/rent-ladder.template.html";
  def rlp-page() = "docs/rent-ladder.html";
  def rlp-contest() = "receipts/parity-contest-ledger.jsonl";
  def rlp-rent() = "receipts/rent-ledger.jsonl";
  def rlp-flow() = "receipts/flow-ledger.jsonl";
  def rlp-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def rlp-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def rlp-nonempty(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then rlp-nonempty(tail(xs)) else cons(head(xs), rlp-nonempty(tail(xs)));
  def rlp-parse(xs) = if nil?(xs) then list() else cons(parse-json("ledger-row", head(xs)), rlp-parse(tail(xs)));
  def rlp-rows(path) = rlp-parse(rlp-nonempty(split-on(fhn-read(path), "\n")));
  def rlp-join(parts, sep) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else mc-cat(list(head(parts), sep, rlp-join(tail(parts), sep)));
  def rlp-swap(s, needle, replacement) = rlp-join(split-on(s, needle), replacement);
  def rlp-pad(n) = if lt(n, 10) then mc-cat(list("0", int_to_str(n))) else int_to_str(n);
  def rlp-hhmm(ms) {
   let secs = div(ms, 1000);
   let day = sub(secs, mul(div(secs, 86400), 86400));
   mc-cat(list(rlp-pad(div(day, 3600)), ":", rlp-pad(div(sub(day, mul(div(day, 3600), 3600)), 60))));
  }
  def rlp-entry(name, v, note) = json-node-object(list(fhn-s("name", name), fhn-n("v", v), fhn-s("note", note)));
  // the pinned route rows of the receipt: measured once, not in a ledger
  def rlp-pins() = list(
   rlp-entry("guided flow, first answer", 2544568, "the arriving mind, 21 provider calls, 57 host tool calls"),
   rlp-entry("direct, unbounded loop inside", 648411, "one organ call, 9 provider calls, 0 Form cells executed"),
   rlp-entry("bounded, one turn", 44495, "enrich reading in the prompt, 0 receipts cited"),
   rlp-entry("native call, fresh rented relay", 26751, "a fresh session ran the one call and relayed it: 2 provider calls"));
  def rlp-contest-entries(rows) = if nil?(rows) then list() else cons(rlp-entry(mc-cat(list(rlp-str(head(rows), "movement"), if str_eq(rlp-str(head(rows), "single_source"), "native") then "" else "")), rlp-int(head(rows), "single_rent_tokens"), mc-cat(list("source ", rlp-str(head(rows), "single_source"), ", receipts ", int_to_str(rlp-int(head(rows), "single_receipts_existing")), ", floor ", int_to_str(rlp-int(head(rows), "floor_parity"))))), rlp-contest-entries(tail(rows)));
  def rlp-rent-entries(rows) = if nil?(rows) then list() else if str_eq(rlp-str(head(rows), "source"), "none") then rlp-rent-entries(tail(rows)) else cons(rlp-entry(rlp-str(head(rows), "movement"), rlp-int(head(rows), "rent_tokens"), mc-cat(list("source ", rlp-str(head(rows), "source"), ", oracle ", rlp-str(head(rows), "oracle")))), rlp-rent-entries(tail(rows)));
  def rlp-calls() = list(
   json-node-object(list(fhn-s("name", "guided flow"), fhn-n("v", 78))),
   json-node-object(list(fhn-s("name", "direct"), fhn-n("v", 29))),
   json-node-object(list(fhn-s("name", "bounded"), fhn-n("v", 1))),
   json-node-object(list(fhn-s("name", "one provider turn inside"), fhn-n("v", 1))),
   json-node-object(list(fhn-s("name", "native single call"), fhn-n("v", 0))));
  def rlp-flow-point(t, label, p, n, o) = json-node-object(list(fhn-s("t", t), fhn-s("label", label), fhn-n("p", p), fhn-n("n", n), fhn-n("o", o)));
  def rlp-flow-entries(rows) = if nil?(rows) then list() else cons(rlp-flow-point(rlp-hhmm(rlp-int(head(rows), "at_unix_ms")), rlp-str(head(rows), "movement"), rlp-int(head(rows), "provider_calls"), rlp-int(head(rows), "native_fkwu_calls"), rlp-int(head(rows), "non_form_calls")), rlp-flow-entries(tail(rows)));
  def rlp-moves(rows) = if or(nil?(rows), nil?(tail(rows))) then list() else cons(json-node-object(list(fhn-s("name", rlp-str(head(tail(rows)), "movement")), fhn-n("n", sub(rlp-int(head(tail(rows)), "native_fkwu_calls"), rlp-int(head(rows), "native_fkwu_calls"))), fhn-n("o", sub(rlp-int(head(tail(rows)), "non_form_calls"), rlp-int(head(rows), "non_form_calls"))))), rlp-moves(tail(rows)));
  def rlp-tile(label, from, to, note) = json-node-object(list(fhn-s("label", label), fhn-s("from", from), fhn-s("to", to), fhn-s("note", note)));
  def rlp-rung(t, d, m, s) = json-node-object(list(fhn-s("t", t), fhn-s("d", d), fhn-s("m", m), fhn-s("s", s)));
  def rlp-rungs() = list(
   rlp-rung("Guided flow measured", "The arriving mind's own first turn on the enquiry, receipted as the baseline.", "2,544,568 tokens · 78 calls left the body", "done"),
   rlp-rung("Direct rung measured", "One organ call with an unbounded provider loop inside; it read the body as a filesystem.", "648,411 · 29", "rung"),
   rlp-rung("Bounded rung measured", "One provider turn carrying a native enrich reading.", "44,495 · 1", "rung"),
   rlp-rung("Grounded door landed", "Native grounding, then one turn; own session identity; the walker writes its row.", "13,285 · 1", "done"),
   rlp-rung("Knobs read by contest", "Effort and opening bytes; an explicit effort flag removed the thinking tokens.", "9,428 at the least · 1", "done"),
   rlp-rung("Native single call landed", "The body answers from its rows, seeds, receipts and its own census; raw output is the answer.", "0 by the body · 26,751 when a fresh rented mind relays it", "done"),
   rlp-rung("One door for any enquiry", "Terms drawn from the enquiry's own words; the same call for any question.", "0 · 0 · 20 filesystem dispatches", "done"),
   rlp-rung("The body reads its own flow", "The flow meter counts provider, native and leaving calls from the transcript and leaves a ledger row.", "rows in receipts/flow-ledger.jsonl", "done"),
   rlp-rung("A movement is one call", "The landing door writes, edits, witnesses, gates, commits, pushes and restarts, crossings in its own census.", "5 calls → 1", "done"),
   rlp-rung("The body draws its progress", "This page is rendered from the ledgers by observe/rent-ladder-page-run.bml.", "no provider, no oracle, nothing leaves the body", "done"),
   rlp-rung("Oracle at rent zero", "The loopback lane is band-proven and waits on a host where a llama.cpp server stands.", "pending", "pend"),
   rlp-rung("Native voice speaks the answer", "On a Metal host the resident model takes the native call's output as its packet.", "pending", "pend"),
   rlp-rung("Your reading", "Equal or better, written into the ledger row after reading both answers side by side.", "pending", "pend"));
  def rlp-run() {
   let contests = rlp-rows(rlp-contest());
   let rents = rlp-rows(rlp-rent());
   let flows = rlp-rows(rlp-flow());
   let firstFlow = rlp-flow-point("02:16", "first turn's floor", 21, 22, 57);
   let ladder = append(rlp-pins(), append(rlp-rent-entries(rents), rlp-contest-entries(contests)));
   let data = json-node-object(list(
    fhn-s("generated", mc-cat(list("rendered at ", rlp-hhmm(now_unix_ms()), " UTC from ", int_to_str(len(contests)), " contest rows, ", int_to_str(len(rents)), " rent rows, ", int_to_str(len(flows)), " flow rows"))),
    fhn-a("tiles", list(
     rlp-tile("Rented tokens per answer", "2,544,568", "26,751", "guided flow's first answer → a fresh rented session running the one native call and relaying it. The call itself: 0."),
     rlp-tile("Calls that leave the body per answer", "78", "0", "host tool calls and provider calls → none"),
     rlp-tile("Calls per movement, from the arriving mind", "5", "1", "write, run, gates, commit, push → one landing call"))),
    fhn-a("ladder", ladder),
    fhn-a("calls", rlp-calls()),
    fhn-a("flow", cons(firstFlow, rlp-flow-entries(flows))),
    fhn-a("moves", rlp-moves(flows)),
    fhn-a("rungs", rlp-rungs())));
   let page = rlp-swap(fhn-read(rlp-template()), "/*DATA*/", json-emit(data));
   let wrote = write_file_text(rlp-page(), page);
   print_str(json-emit-precise(json-node-object(list(fhn-s("page", rlp-page()), fhn-n("bytes", str_len(page)), fhn-n("contest_rows", len(contests)), fhn-n("rent_rows", len(rents)), fhn-n("flow_rows", len(flows))))));
  }
 }
 rlp-run();
}
