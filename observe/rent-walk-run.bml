// rent-walk-run.bml — one step of docs/rent-to-zero-goal.form, walked by the
// body with no rented mind between the doors.
//
// It answers the goal's pinned enquiry through the grounded synthesis door
// (native grounding, then the in-process model at rent 0, else one provider
// turn only when this request allows it) and appends one row to the path
// ledger, receipts/rent-ledger.jsonl: when, which movement, which voice
// answered, what it cost in rent, what the oracle spent locally, how many
// receipts the packet carried, and where the answer lies. The answer text
// never enters the ledger. Landing stays with the body's cadence
// (form/form-stdlib/land-cadence-live.fk); this door only walks and writes.
//
// stdin, optional: {"movement":"<name>","provider":{"allowed":0},"oracle":1}
// With empty stdin the provider is not asked, so an unattended run can never
// spend rent by default.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml
section [form.bml] {
 class RentWalk {
  def rw-enquiry-path() = "receipts/artifacts/2026-09-18-form-cli-enquiry.txt";
  def rw-terms() = "quality volume frequency vitality trust traceability sovereignty resonance rented membrane";
  def rw-ledger-path() = "receipts/rent-ledger.jsonl";
  def rw-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def rw-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def rw-request(options) = json-node-object(list(
   fhn-s("enquiry", read_file(rw-enquiry-path())),
   fhn-s("terms", rw-terms()),
   fhn-n("seconds", 600),
   fhn-n("receipts", 8),
   fhn-n("oracle", if json-object-has?(options, "oracle") then rw-int(options, "oracle") else 1),
   json-node-pair("provider", if json-object-has?(options, "provider") then json-object-get(options, "provider") else json-node-object(list(fhn-n("allowed", 0))))));
  def rw-row(options, report) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", if json-object-has?(options, "movement") then rw-str(options, "movement") else "rent-walk"),
   fhn-s("enquiry", rw-enquiry-path()),
   fhn-s("source", rw-str(report, "source")),
   fhn-s("oracle", rw-str(report, "oracle")),
   fhn-n("rent_tokens", rw-int(report, "rent_tokens")),
   fhn-n("oracle_tokens_evaluated", rw-int(report, "oracle_tokens_evaluated")),
   fhn-n("oracle_tokens_predicted", rw-int(report, "oracle_tokens_predicted")),
   fhn-s("oracle_model", rw-str(report, "oracle_model")),
   fhn-n("receipts_in_packet", len(json-array-elements(json-object-get(report, "receipts")))),
   fhn-n("packet_bytes", rw-int(report, "packet_bytes")),
   fhn-n("answer_bytes", rw-int(report, "answer_bytes")),
   fhn-n("grounding_ms", rw-int(report, "grounding_ms")),
   fhn-n("oracle_ms", rw-int(report, "oracle_ms")),
   fhn-n("provider_ms", rw-int(report, "provider_ms")),
   fhn-s("answer", rw-str(report, "answer")),
   fhn-s("evidence", rw-str(report, "evidence"))));
  def rw-walk() {
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let options = if str_eq(line, "") then json-node-object(list()) else parse-json("rent-walk-options", line);
   let report = fgs-answer(rw-request(options));
   let row = rw-row(options, report);
   let appended = fhn-append(rw-ledger-path(), str_concat(json-emit(row), "\n"));
   print_str(json-emit-precise(json-node-object(list(json-node-pair("row", row), fhn-s("ledger", appended)))));
  }
 }
 rw-walk();
}
