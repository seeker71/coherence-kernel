; nvr-metric-live.fk — the metric is registered; the corpus is not; no ≥ claim.
;
; preludes: form-stdlib/core.fk form-stdlib/native-vs-rented.fk observe/nvr-metric.fk

(do
    (print "nvrm-live id=")
    (print (int_to_str (nvrm-id)))
    (print " floor=")
    (print (int_to_str (nvrm-corpus-floor)))
    (print "\n")
    (print "nvrm-live empty-corpus-earns=")
    (print (int_to_str (nvrm-earns? (nvrm-pair 9 5 8 5) (nvrm-run (nvrm-id) 0 1))))
    (print " full-corpus-earns=")
    (print (int_to_str (nvrm-earns? (nvrm-pair 9 5 8 5) (nvrm-run (nvrm-id) 8 1))))
    (print "\n")
    (print "nvrm-live check=")
    (print (int_to_str (nvrm-check)))
    (print "\n")
    0)
