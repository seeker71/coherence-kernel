// nvr-metric-live.fk — the metric is registered; the corpus is not; no ≥ claim.
//
import form-stdlib/core.fk;
import form-stdlib/native-vs-rented.fk;
import observe/nvr-metric.fk;
section [form.bml] {
    print("nvrm-live id=");
    print(nvrm-id().str());
    print(" floor=");
    print(nvrm-corpus-floor().str());
    print("\n");
    print("nvrm-live empty-corpus-earns=");
    print(nvrm-earns?(nvrm-pair(9, 5, 8, 5), nvrm-run(nvrm-id(), 0, 1)).str());
    print(" full-corpus-earns=");
    print(nvrm-earns?(nvrm-pair(9, 5, 8, 5), nvrm-run(nvrm-id(), 8, 1)).str());
    print("\n");
    print("nvrm-live check=");
    print(nvrm-check().str());
    print("\n");
    0;
}
