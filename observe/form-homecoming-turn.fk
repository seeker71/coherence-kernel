; form-homecoming-turn.fk — one local breath: native returns, then stop.
; The speaker's prompt is the cell's integers, not a sealed question.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-local-ready-xtal.fk
; preludes: form-stdlib/form-cli-one-turn-xtal.fk
; preludes: form-stdlib/equivalence-collapse.fk form-stdlib/knowledge-ingest.fk
; preludes: ingest/name-build-observe.fk
; preludes: form-stdlib/form-cli-ingest-exec-xtal.fk

(do
    (defn fht-obs ()
        (str_concat (fie-observe (DepthPath))
            (str_concat " ; " (fie-observe (CollapsePath)))))
    (defn fht-prompt ()
        (str_concat "The body already ran Form. Observation: "
            (str_concat (fht-obs)
                ". Reply with exactly: HOME then those integers. Nothing else.")))
    (defn fht-drop () (fot-next-drop 1 1 0))
    (defn fht-bit (ok bit) (if ok bit 0))
    (defn fht-check ()
        (add (fht-bit (ge (str_find (fht-obs) "3=1" 0) 0) 1)
        (add (fht-bit (ge (str_find (fht-obs) "same=1" 0) 0) 2)
        (add (fht-bit (ge (str_find (fht-prompt) "HOME" 0) 0) 4)
             (fht-bit (eq (fht-drop) (NextStop)) 8)))))
    0)
