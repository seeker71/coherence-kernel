; qwen35-tokenizer-resident-four-breaths-live.fk -- four bounded real breaths.
;
; EFFECTFUL DEFINITIONS: safe to preflight because the live function is not
; invoked at top level.  The tiny `-run.fk` door is NEVER preflighted.  A live
; invocation opens one 40 MB equireach window over the local Qwen3.8 GGUF and carries one progress value through four
; 64-row vocabulary breaths in the same process.  It clears only its exact
; Form temp root.  Every row is checkpointed and released by the committed
; bounded bridge.  It does not construct vocabulary/merge lists or a joined
; tokenizer, open model tensors, run a model forward, hash 29 GB, flatten, or
; enter any Metal/MLX operation lane.
;
; preludes: form-stdlib/qwen35-tokenizer-resident-breaths.fk

(do
    (defn q35tr4-source-path ()
        "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn q35tr4-source-size-observed () 29047086048)
    (defn q35tr4-source-sha-observed ()
        "a680f44a06920e5d689774823782006aa3acc8db95750323373b24139b67e348")
    (defn q35tr4-source-seal-path ()
        (str_concat (q35tr4-source-path) ".form-seal"))
    (defn q35tr4-source-seal-observed ()
        (str_concat "qaf-seal1:29047086048:" (q35tr4-source-sha-observed)))
    (defn q35tr4-source-window-bytes () 40000000)
    (defn q35tr4-requested-breaths () 4)
    (defn q35tr4-rows-per-breath () 64)
    (defn q35tr4-root ()
        (fs-path-join (fs-temp-dir) "qwen35-tokenizer-resident-four-breaths-live"))
    (defn q35tr4-seal-input-current? ()
        (if (eq (fs-exists? (q35tr4-source-seal-path)) 0) 0
            (if (str_eq (fs-read-text (q35tr4-source-seal-path))
                        (q35tr4-source-seal-observed)) 1 0)))
    (defn q35tr4-bit (ok bit) (if ok bit 0))

    (defn q35tr4-live ()
      (do
    (let path (q35tr4-source-path))
    (let source-exists (fs-is-file? path))
    (let source-size (fs-stat-size path))
    (let source-mtime (fs-stat-mtime path))
    (let seal-input-current (q35tr4-seal-input-current?))
    (let root (q35tr4-root))
    (let cleared (fs-remove-tree root))
    (let absent-after-clear (if (eq (fs-exists? root) 0) 1 0))
    (let made (fs-mkdir root))
    (let directory-born (fs-is-dir? root))
    (let progress-path (fs-path-join root (q35tba-progress-name)))
    (let progress-existed-before (fs-is-file? progress-path))
    (let progress-bytes-before (fs-stat-size progress-path))

    (if (not (and (eq source-exists 1)
                  (and (eq source-size (q35tr4-source-size-observed))
                       (and (gt source-mtime 0)
                            (and (eq seal-input-current 1)
                                 (and (eq absent-after-clear 1)
                                      (eq directory-born 1)))))))
        (do
            (print (list "qwen35-tokenizer-resident-four-breaths"
                "status" "refused-before-open"
                "source" path
                "source-exists" source-exists
                "source-size" source-size
                "source-mtime" source-mtime
                "source-sha-observed-input" (q35tr4-source-sha-observed)
                "source-seal-input-current" seal-input-current
                "root" root
                "remove-result" cleared
                "mkdir-result" made
                "absent-after-clear" absent-after-clear
                "directory-born" directory-born
                "model-forward" 0))
            0)
        (do
            ; This is the only real-source construction.  The same bounded
            ; source value is passed through the whole resident recursion.
            (let started-ms (now_unix_ms))
            (let src (eqr-of-file path 0 (q35tr4-source-window-bytes)))
            (let magic-ok (egg-magic-ok? src))
            (let version (egg-version src))
            (let vocab-total (gmt-vocab-n src))
            (let merges-total (tkz-merges-n src))
            (let resident (q35trm-run root src source-size source-mtime
                                      (q35tr4-requested-breaths)
                                      (q35tr4-rows-per-breath)))
            (let ended-ms (now_unix_ms))
            (let elapsed-ms (q35tba-max 1 (sub ended-ms started-ms)))
            (let initial (q35trm-initial-progress resident))
            (let final (q35trm-final-progress resident))
            (let acc (q35trm-accumulation resident))
            (let progress-persisted (fs-is-file? progress-path))
            (let progress-bytes-after (fs-stat-size progress-path))
            (let artifact-byte-delta
                (sub (q35tbb-progress-appended-bytes final)
                     (q35tbb-progress-appended-bytes initial)))
            (let progress-byte-delta
                (sub progress-bytes-after (q35tba-max 0 progress-bytes-before)))
            (let rows-per-second-floor
                (div (mul (q35trm-acc-processed acc) 1000) elapsed-ms))
            (let incomplete-seal-absent
                (if (eq (fs-exists? (fs-path-join root (q35tba-seal-name))) 0) 1 0))

            (print (list "qwen35-tokenizer-resident-four-breaths"
                "status" (q35trm-status resident)
                "source" path
                "source-size" source-size
                "source-mtime" source-mtime
                "source-sha-observed-input" (q35tr4-source-sha-observed)
                "source-sha-provenance" "existing-form-seal-and-2026-08-17-receipt"
                "source-rehashed-this-run" 0
                "source-seal-input-current" seal-input-current
                "gguf-magic" magic-ok
                "gguf-version" version
                "vocab-total" vocab-total
                "merges-total" merges-total
                "root" root
                "fresh-after-clear" absent-after-clear
                "directory-born" directory-born
                "source-window-loads" (q35trm-source-windows resident)
                "source-window-bytes" (q35tr4-source-window-bytes)
                "progress-loads" (q35trm-progress-loads resident)
                "progress-existed-before" progress-existed-before
                "progress-bytes-before" progress-bytes-before
                "progress-bytes-after" progress-bytes-after
                "progress-byte-delta" progress-byte-delta
                "initial-phase" (q35tbb-progress-phase initial)
                "initial-index" (q35tbb-progress-next-index initial)
                "initial-source-offset" (q35tbb-progress-next-off initial)
                "initial-appended-bytes" (q35tbb-progress-appended-bytes initial)
                "final-phase" (q35tbb-progress-phase final)
                "final-index" (q35tbb-progress-next-index final)
                "final-source-offset" (q35tbb-progress-next-off final)
                "vocab-built" (q35tbb-progress-vocab-built final)
                "merge-built" (q35tbb-progress-merge-built final)
                "artifact-appended-bytes" (q35tbb-progress-appended-bytes final)
                "artifact-byte-delta" artifact-byte-delta
                "requested-breaths" (q35trm-requested-breaths resident)
                "completed-breaths" (q35trm-acc-breaths acc)
                "rows-per-breath" (q35trm-rows-per-breath resident)
                "processed" (q35trm-acc-processed acc)
                "peak-row-bytes" (q35trm-acc-max-row acc)
                "choices" (q35trm-acc-choices acc)
                "cuts" (q35trm-acc-cuts acc)
                "undos" (q35trm-acc-undos acc)
                "timeouts" (q35trm-acc-timeouts acc)
                "failures" (q35trm-acc-failures acc)
                "refinements" (q35trm-acc-refinements acc)
                "releases" (q35trm-acc-releases acc)
                "state-handoffs" (q35trm-acc-state-handoffs acc)
                "monotonic-progress" (q35trm-acc-monotonic? acc)
                "elapsed-ms" elapsed-ms
                "rows-per-second-floor" rows-per-second-floor
                "artifact-cursor-window-bytes" (q35tba-window-bytes)
                "progress-persisted" progress-persisted
                "incomplete-seal-absent" incomplete-seal-absent
                "whole-vocab-list" 0
                "whole-merge-list" 0
                "tokenizer-monolith" 0
                "model-tensors-opened" 0
                "model-forward" 0
                "metal-or-mlx-ops" 0
                "source-window-release" "process-exit"
                "artifact-lifecycle" "fresh-incomplete-temp-left-for-inspection"))

            (sum (list
                (q35tr4-bit (eq source-exists 1) 1)
                (q35tr4-bit (eq source-size (q35tr4-source-size-observed)) 2)
                (q35tr4-bit (eq seal-input-current 1) 4)
                (q35tr4-bit (and (eq absent-after-clear 1) (eq directory-born 1)) 8)
                (q35tr4-bit (eq magic-ok 1) 16)
                (q35tr4-bit (eq version 3) 32)
                (q35tr4-bit (eq vocab-total 248320) 64)
                (q35tr4-bit (gt merges-total 0) 128)
                (q35tr4-bit (str_eq (q35trm-status resident) "resident-complete") 256)
                (q35tr4-bit (eq (q35trm-requested-breaths resident) 4) 512)
                (q35tr4-bit (eq (q35trm-acc-breaths acc) 4) 1024)
                (q35tr4-bit (eq (q35trm-rows-per-breath resident) 64) 2048)
                (q35tr4-bit (eq (q35trm-acc-processed acc) 256) 4096)
                (q35tr4-bit (and (eq (q35tbb-progress-vocab-built final) 256)
                                  (eq (q35tbb-progress-merge-built final) 0)) 8192)
                (q35tr4-bit (eq (q35trm-acc-releases acc) 256) 16384)
                (q35tr4-bit (and (eq (q35trm-acc-undos acc) 0)
                    (and (eq (q35trm-acc-timeouts acc) 0)
                    (and (eq (q35trm-acc-failures acc) 0)
                         (eq (q35trm-acc-refinements acc) 0)))) 32768)
                (q35tr4-bit (and (eq (q35trm-acc-choices acc) 256)
                                  (eq (q35trm-acc-cuts acc) 4)) 65536)
                (q35tr4-bit (eq (q35trm-acc-state-handoffs acc) 3) 131072)
                (q35tr4-bit (eq (q35trm-acc-monotonic? acc) 1) 262144)
                (q35tr4-bit (and (eq (q35trm-progress-loads resident) 1)
                                  (eq (q35trm-source-windows resident) 1)) 524288)
                (q35tr4-bit (eq (sub (q35tbb-progress-next-index final)
                                     (q35tbb-progress-next-index initial)) 256) 1048576)
                (q35tr4-bit (gt (q35tbb-progress-next-off final)
                                 (q35tbb-progress-next-off initial)) 2097152)
                (q35tr4-bit (and (eq artifact-byte-delta (q35trm-acc-appended acc))
                                  (gt artifact-byte-delta 0)) 4194304)
                (q35tr4-bit (and (eq progress-persisted 1)
                    (and (eq incomplete-seal-absent 1)
                    (and (eq (q35tba-window-bytes) 256)
                         (le (q35trm-acc-max-row acc) (q35tba-max-row-bytes)))))
                    8388608)))))
      ))

    0)
