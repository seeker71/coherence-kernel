// Held source semantics, with no JavaScript execution or external acquisition.
// preludes: form/form-stdlib/bml/concept-wiktionary-meaning.bml form-stdlib/organ-health.bml
section [form.bml] {
 class ConceptWiktionaryWitness {
  def cww-check(name,accepted) {
   let observation = oh-reading("wiktionary-meaning","held-byte-interpretation",name,json-node-int(1),json-node-int(accepted),json-node-int(accepted),list(),list("continue","request-evidence"),json-node-object(list(oh-s("source","local constructed fixture or retained evidence definition"),oh-s("externalAcquisition","not-observed"))));
   oh-voice(observation);
   let response = oh-response(observation,if accepted then "continue" else "request-evidence"); oh-voice(response);
   let selected = oh-select(observation,response,"request-evidence");
   oh-voice(oh-applied(observation,selected,json-node-object(list(oh-s("publication","none"),oh-s("action",if accepted then "advance to next source boundary" else "withhold parser claim")))));
   if accepted then 1 else form_error(str_concat("Wiktionary interpretation differs at ",name));
  }
  def cww-english(name,source,expected) {
   let result = cwm-english(source);
   cww-check(name,and(ctr-good(result),str_eq(ctr-value(result),expected)));
  }
  def cww-meaning(name,source,section,definition) {
   let result = cwm-source(source); let value = ctr-value(result);
   cww-check(name,and(ctr-good(result),and(not(nothing?(value)),and(str_eq(head(value),section),str_eq(nth(value,1),definition)))));
  }
  def cww-none(name,source) {
   let result = cwm-source(source);
   cww-check(name,and(ctr-good(result),nothing?(ctr-value(result))));
  }
  def cww-score(name,text,expected) = cww-check(name,eq(cwm-substance(text,0,0),expected));
  def cww-spaces(values,total) = if nil?(values) then total else cww-space(head(values),tail(values),total);
  def cww-space(pair,rest,total) {
   let text = nth(pair,1); let code = head(pair);
   let a = cww-check(str_concat("ecmascript-space-",int_to_str(code)),and(eq(cwm-code(text,0),code),and(cwm-space(code),str_eq(cwm-trim(str_concat(text,str_concat("abcd",text))),"abcd"))));
   cww-spaces(rest,add(total,a));
  }
  def cww-inflections(names,total) = if nil?(names) then total else cww-inflection(head(names),tail(names),total);
  def cww-inflection(name,rest,total) {
   let source = str_concat("==English==\n===Noun===\n# {{en-",str_concat(name,"|test}} deliberately skipped\n# retained meaning\n"));
   let a = cww-meaning(str_concat("inflection-",name),source,"Noun","retained meaning");
   cww-inflections(rest,add(total,a));
  }
  def cww-held(lines,total) = if nil?(lines) then total else if str_eq(head(lines),"") then cww-held(tail(lines),total) else if not(jwa-valid(head(lines))) then form_error("held definition JSON is incomplete") else cww-held-row(parse-json("held-definition",head(lines)),tail(lines),total);
  def cww-held-row(row,rest,total) {
   let section = json-string-value(json-object-get(row,"section")); let definition = json-string-value(json-object-get(row,"definition"));
   let text = str_concat("==English==\n===",str_concat(section,str_concat("===\n# ",str_concat(definition,"\n"))));
   let a = cww-meaning(str_concat("retained-definition-",int_to_str(json-int-value(json-object-get(row,"id")))),text,section,definition);
   cww-held(rest,add(total,a));
  }
  def cww-repeat(text,count) = if eq(count,0) then text else cww-repeat(str_concat(text,text),sub(count,1));
  def cww-run() {
   let sections = add(add(add(cww-english("exact-language-boundary","==English==\n===Noun===\n# meaning\n==French==\nignored","===Noun===\n# meaning"),cww-english("marker-needs-line-start","x==English==\nmeaning","")),add(cww-english("marker-needs-lf","==English== meaning",""),cww-english("later-valid-marker","==English== no\n==English==\nyes","yes"))),add(add(cww-english("greedy-whitespace-last-lf","==English==\n \t\n  ===Noun===\n# meaning\n","  ===Noun===\n# meaning\n"),cww-english("deeper-heading-retained","==English==\n===Noun===\n# word\n====Sub====","===Noun===\n# word\n====Sub====")),add(cww-english("terminal-incomplete-heading","==English==\nword\n==","word\n=="),cww-english("lowercase-language-refused","==english==\nword",""))));
   let meaning = add(add(add(cww-meaning("first-substantive","==English==\n===Noun===\n# first meaning\n# second meaning","Noun","first meaning"),cww-meaning("case-preserving-heading","==English==\n====  aDjEcTiVe  ====\n# meaning","aDjEcTiVe","meaning")),add(cww-none("proper-noun-excluded","==English==\n===Proper noun===\n# proper meaning"),cww-none("empty-heading-clears","==English==\n===Noun===\n===   ===\n# meaning"))),add(add(cww-meaning("malformed-heading-preserves","==English==\n===Noun===\n=======Verb=======\n# meaning","Noun","meaning"),cww-meaning("mismatched-heading-preserves","==English==\n===Noun===\n====Verb===\n# meaning","Noun","meaning")),add(cww-meaning("definition-markers","==English==\n===Noun===\n## ignored\n#* ignored\n#: ignored\n# accepted","Noun","accepted"),cww-none("missing-section","==English==\n# meaning"))));
   let syntax = add(add(add(cww-meaning("ascii-trim-preserve-interior","==English==\n===Noun===\n# \t two  words \t\r\n","Noun","two  words"),cww-none("interior-cr-is-not-dot","==English==\n===Noun===\n# first\rsecond")),add(cww-meaning("inflection-ascii-case","==English==\n===Verb===\n# {{ EN-PlUrAl Of|word}} rejected\n# accepted","Verb","accepted"),cww-meaning("inflection-word-boundary","==English==\n===Noun===\n# {{plural ofx|word}} accepted","Noun","{{plural ofx|word}} accepted"))),add(add(cww-none("template-and-punctuation-only","==English==\n===Noun===\n# {{label|en}} .'\"(),;:!?-"),cww-meaning("utf16-two-supplementary","==English==\n===Noun===\n# 😀😀","Noun","😀😀")),add(cww-none("utf16-three-units","==English==\n===Noun===\n# 😀a"),cww-meaning("link-markers-remove-only-brackets","==English==\n===Noun===\n# [[abcd]]","Noun","[[abcd]]"))));
   let score = add(add(add(cww-score("template-nonempty","{{x}}",0),cww-score("empty-template-keeps-braces","{{}}",4)),add(cww-score("nested-opening-in-template","{{a{{b}}",0),cww-score("single-close-keeps-template","{{a}x}}",7))),add(add(cww-score("punctuation-deletion",".'\"(),;:!?-",0),cww-score("utf16-supplementary-count","😀ab",4)),add(cww-score("link-content-retained","[[a|bc]]",4),cww-score("nonbreaking-space-removed","a b",2))));
   let unicode = cww-spaces(list(list(9,"\t"),list(10,"\n"),list(11,byte_to_str(11)),list(12,byte_to_str(12)),list(13,"\r"),list(32," "),list(160," "),list(5760," "),list(8192," "),list(8193," "),list(8194," "),list(8195," "),list(8196," "),list(8197," "),list(8198," "),list(8199," "),list(8200," "),list(8201," "),list(8202," "),list(8232," "),list(8233," "),list(8239," "),list(8287," "),list(12288,"　"),list(65279,"﻿")),0);
   let excludes = add(add(cww-check("next-line-not-whitespace",not(cwm-space(133))),cww-check("mongolian-vowel-separator-not-whitespace",not(cwm-space(6158)))),add(cww-check("zero-width-space-not-whitespace",not(cwm-space(8203))),cww-none("interior-unicode-line-separator","==English==\n===Noun===\n# first second")));
   let inflections = cww-inflections(cwm-inflection-names(),0);
   let refusals = add(cww-check("non-string-refusal",not(ctr-good(cwm-source(3)))),cww-check("malformed-utf8-refusal",not(ctr-good(cwm-source(byte_to_str(255))))));
   let boundaries = add(add(cww-english("unicode-whitespace-after-language","==English== \n　===Noun===\n# meaning","　===Noun===\n# meaning"),cww-meaning("unicode-heading-definition-edges","==English==\n=== Noun﻿===\n#  meaning　","Noun","meaning")),add(cww-meaning("source-beyond-128k",str_concat(cww-repeat("x",17),"\n==English==\n===Noun===\n# untruncated meaning\n==French==\nignored"),"Noun","untruncated meaning"),cww-meaning("nul-is-source-data",str_concat("==English==\n===Noun===\n# abcd",str_concat(byte_to_str(0),"efgh")),"Noun",str_concat("abcd",str_concat(byte_to_str(0),"efgh")))));
   let path = "model/concept-10000-substantive-repair-evidence.jsonl"; let read = fbc-read-exact(path,0);
   if not(fbc-good(read)) then form_error("held definition source read is incomplete") else 0;
   let bytes = fbc-value(read);
   let held = cww-held(tail(ctr-lines(bytes,0,0,list())),0);
   let stable = cww-check("held-file-exact-and-unchanged",and(eq(file_size(path),str_len(bytes)),str_eq(read_file(path),bytes)));
   print(list("language-boundaries",sections,"meaning-boundaries",meaning,"definition-boundaries",syntax,"substance-rules",score,"unicode-spaces",unicode,"unicode-exclusions",excludes,"inflection-forms",inflections,"typed-refusals",refusals,"byte-boundaries",boundaries,"held-definitions",held,"held-source-stable",stable));
   if eq(held,111) then 1 else form_error("held definition cardinality differs");
  }
 }
 cww-run();
}
