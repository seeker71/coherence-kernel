; offline-recovery-inventory-live.fk -- bounded local-Mac recovery witness.
;
; This runner performs read-only local probes.  It does not use the network,
; execute a model or Metal/MLX program, rewrite git metadata, copy an artifact,
; or inspect any private evaluator/consent material.  Host commands emit only a
; one-bit status, except for the bounded `garbage`/`size-garbage` aggregate;
; no path supplied by a model or caller enters the shell.
;
; Effectful host-observation carrier: preflight the pure inventory and band,
; then execute this file directly.
; preludes: form-stdlib/offline-recovery-inventory.fk form-stdlib/model-registry.bml

import "../form/form-stdlib/offline-recovery-inventory.fk"

(do
    (defn oril-stamp () 2026082502)
    (defn oril-present? (path) (if (gt (file_size path) 0) 1 0))
    (defn oril-command-state (command)
        (if (str_eq (host-exec command "") "1") 1 0))
    (defn oril-text-has? (text needle)
        (if (ge (str_find text needle 0) 0) 1 0))
    (defn oril-all3-present? (a b c)
        (if (and (eq (oril-present? a) 1)
                 (and (eq (oril-present? b) 1)
                      (eq (oril-present? c) 1))) 1 0))
    (defn oril-all4-present? (a b c d)
        (if (and (eq (oril-present? a) 1)
                 (and (eq (oril-present? b) 1)
                      (and (eq (oril-present? c) 1)
                           (eq (oril-present? d) 1)))) 1 0))

    (defn oril-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn oril-model-size () 29047086048)
    (defn oril-model-sha ()
        "a680f44a06920e5d689774823782006aa3acc8db95750323373b24139b67e348")
    (defn oril-seal-receipt () "receipts/2026-08-17-qwen38-form-native-floor.md")

    (defn oril-steps ()
        (list
            (ori-step 1 "protect-current-movement"
                "review git status --short and commit each coherent public movement; never include private consent/evaluator files"
                "git status --short shows only intentionally retained local state")
            (ori-step 2 "diagnose-without-stale-commit-graph"
                "git -c core.commitGraph=false fsck --full --strict --no-progress --no-dangling"
                "command exits 0 before any repair leans on the object database")
            (ori-step 3 "rewrite-reachable-commit-graph"
                "git commit-graph write --reachable"
                "git commit-graph verify exits 0; then ordinary git fsck --full --strict --no-progress --no-dangling exits 0")
            (ori-step 4 "rebuild-one-fkwu"
                "cc -O2 -o fkwu runtime/fkwu-uni.c form/native/metal/fk-metal-carrier.m form/native/mlx/fk-mlx-carrier.c -framework Metal -framework Foundation -fobjc-arc -I/opt/homebrew/include -L/opt/homebrew/lib -lmlxc -Wl,-rpath,/opt/homebrew/lib"
                "otool -L ./fkwu names Metal.framework and libmlxc.dylib")
            (ori-step 5 "rehearse-direct-source-ground"
                "./fkwu bootstrap/ground.fk; ./fkwu bootstrap/ground-recursive.fk 10; ./fkwu form/form-stdlib/tests/binary-freshness-band.fk; ./fkwu bootstrap/ground-numeric-list.fk"
                "answers are 42, 55, 31, and [1, 2.5, [3, 4]] with exit 0")
            (ori-step 6 "reverify-qwen-whole-file-seal"
                "./fkwu observe/qwen38-seal-check-run.fk"
                "size is 29047086048 and SHA-256 is a680f44a06920e5d689774823782006aa3acc8db95750323373b24139b67e348")
            (ori-step 7 "rehearse-local-voice-after-seal"
                "./fkwu observe/qwen38-generate-probe.fk"
                "local Form-native generation completes, releases resources, and reports no remote lane")
            (ori-step 8 "birth-independent-offline-copy-when-authorized"
                "choose a separately powered local volume; copy a git bundle, restoration instructions, fkwu sources, and sealed Qwen artifact"
                "restore into a fresh directory while offline; rerun git fsck, bootstrap/freshness, seal-check, and local generation before counting the copy healthy")))

    (defn oril-rows ()
        (do
            (let seal-text (read_file (oril-seal-receipt)))
            (let model-size (file_size (oril-model-path)))
            (let git-storage (host-exec
                "git count-objects -vH 2>/dev/null | grep -E '^(garbage|size-garbage):' | paste -sd, -" ""))
            (list
                (ori-row "repository" "reachable-git-objects"
                    (oril-command-state
                        "git -c core.commitGraph=false fsck --full --strict --no-progress --no-dangling >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "git object database with commit-graph disabled"
                    "reachable object fsck exit status"
                    "run the diagnosis step before rewriting acceleration metadata")
                (ori-row "repository" "commit-graph"
                    (oril-command-state
                        "git commit-graph verify >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "git commit-graph verify"
                    "commit-graph verification exit status"
                    "after current movement is durable, write the reachable graph and verify it")
                (ori-row "repository" "git-object-storage-garbage"
                    (oril-command-state
                        "git count-objects -v 2>/dev/null | grep -q '^garbage: 0$' && printf 1 || printf 0")
                    (oril-stamp) "git count-objects aggregate" git-storage
                    "after protecting current movement, prune only through a reviewed git maintenance rehearsal")
                (ori-row "repository" "uncommitted-movement-in-object-store"
                    (oril-command-state
                        "test -z \"$(git status --porcelain=v1)\" && printf 1 || printf 0")
                    (oril-stamp) "git status porcelain, content withheld"
                    "whether current work is already represented by commits"
                    "review and commit coherent public files without staging private material")
                (ori-row "repository" "independent-repository-copy-rehearsed" 0
                    (oril-stamp) "this bounded movement created and restored no independent copy"
                    "observed gap in this movement, not a claim about every disk"
                    "make and restore-test a git bundle on a separately powered local volume")
                (ori-row "kernel" "fkwu-source"
                    (oril-present? "runtime/fkwu-uni.c") (oril-stamp)
                    "runtime/fkwu-uni.c" (int_to_str (file_size "runtime/fkwu-uni.c"))
                    "rebuild the one binary from committed source")
                (ori-row "kernel" "fkwu-local-binary"
                    (oril-present? "fkwu") (oril-stamp)
                    "fkwu" (int_to_str (file_size "fkwu"))
                    "use the AGENTS.md Darwin carrier command if absent")
                (ori-row "kernel" "native-carrier-sources"
                    (oril-all3-present? "runtime/fkwu-uni.c"
                        "form/native/metal/fk-metal-carrier.m"
                        "form/native/mlx/fk-mlx-carrier.c")
                    (oril-stamp) "C seed plus Metal and MLX carrier source"
                    "three local source files"
                    "restore tracked sources, then rebuild without growing the seed")
                (ori-row "model" "qwen38-q8-artifact-size"
                    (if (eq model-size (oril-model-size)) 1 0) (oril-stamp)
                    (oril-model-path) (int_to_str model-size)
                    "restore the exact sealed artifact from an independent local copy")
                (ori-row "model" "qwen38-public-seal-evidence"
                    (if (and (eq (oril-text-has? seal-text (oril-model-sha)) 1)
                             (eq (oril-text-has? seal-text
                                (int_to_str (oril-model-size))) 1)) 1 0)
                    (oril-stamp) (oril-seal-receipt) (oril-model-sha)
                    "retain this public receipt beside the artifact and re-run the seal check")
                (ori-row "model" "qwen38-current-whole-file-seal" (nothing)
                    (oril-stamp) "whole-file rehash deliberately omitted from this bounded probe"
                    "unobserved now; the historical public seal does not impersonate a fresh hash"
                    "run qwen38-seal-check-run.fk before trusting restored weights")
                (ori-row "model" "independent-qwen-copy-rehearsed" 0
                    (oril-stamp) "this bounded movement created and restored no independent model copy"
                    "single observed canonical artifact on this Mac"
                    "copy to a separately powered volume and verify its whole-file seal after restore")
                (ori-row "native-linkage" "metal-framework-linked"
                    (oril-command-state
                        "otool -L ./fkwu 2>/dev/null | grep -q Metal.framework && printf 1 || printf 0")
                    (oril-stamp) "otool -L fkwu" "Metal.framework linkage"
                    "rebuild fkwu with -framework Metal -framework Foundation")
                (ori-row "native-linkage" "mlx-library-linked"
                    (oril-command-state
                        "otool -L ./fkwu 2>/dev/null | grep -q libmlxc.dylib && printf 1 || printf 0")
                    (oril-stamp) "otool -L fkwu" "libmlxc.dylib linkage"
                    "rebuild fkwu with the local mlx-c include, library, and rpath")
                (ori-row "native-linkage" "mlx-library-present"
                    (oril-present? "/opt/homebrew/lib/libmlxc.dylib") (oril-stamp)
                    "/opt/homebrew/lib/libmlxc.dylib"
                    (int_to_str (file_size "/opt/homebrew/lib/libmlxc.dylib"))
                    "restore the local mlx-c installation before rebuilding")
                (ori-row "toolchain" "form-run"
                    (oril-command-state
                        "command -v form-run >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "command -v form-run" "local command availability"
                    "restore the local Form command wrapper")
                (ori-row "toolchain" "git"
                    (oril-command-state
                        "command -v git >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "command -v git" "local command availability"
                    "restore Git before repository recovery")
                (ori-row "toolchain" "cc"
                    (oril-command-state
                        "command -v cc >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "command -v cc" "local command availability"
                    "restore Apple command-line tools before rebuilding fkwu")
                (ori-row "toolchain" "metal-compiler"
                    (oril-command-state
                        "xcrun --find metal >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "xcrun --find metal" "local Metal toolchain availability"
                    "restore the Apple Metal toolchain")
                (ori-row "toolchain" "otool"
                    (oril-command-state
                        "command -v otool >/dev/null 2>&1 && printf 1 || printf 0")
                    (oril-stamp) "command -v otool" "local linkage inspector availability"
                    "restore Apple command-line tools")
                (ori-row "critical-body" "ground-and-homecoming-docs"
                    (oril-all4-present? "AGENTS.md" "HOMECOMING.md"
                        "bootstrap/ground.fk" "form/form-stdlib/core.fk")
                    (oril-stamp) "four local public files" "direct-source grounding set"
                    "restore these tracked files before interpreting any higher receipt")
                (ori-row "critical-body" "local-reasoning-organs"
                    (oril-all4-present?
                        "form/form-stdlib/form-cli-model-generate.fk"
                        "form/form-stdlib/form-nodeid-knowledge-query.fk"
                        "form/form-stdlib/bmf-byte-cursor.fk"
                        "form/form-stdlib/form-cli-jit-run.fk")
                    (oril-stamp) "four local public source organs"
                    "generation, query, streaming cursor, and native JIT sources"
                    "restore from git, then preflight and run their direct-source bands")
                (ori-row "critical-body" "public-recovery-receipts"
                    (oril-all3-present? (oril-seal-receipt)
                        "receipts/2026-08-22-the-direct-lane.md"
                        "receipts/2026-08-24-nodeid-metal-returned-inside-one-resident-qwen-context.md")
                    (oril-stamp) "three public receipts"
                    "weight seal, direct-source lane, and resident NodeID/Metal crossing"
                    "restore the receipts with git; treat each freshness stamp as rehearse-required"))))

    (defn oril-run ()
        (ori-report (oril-stamp) (oril-rows) (oril-steps)))

    (oril-run))
