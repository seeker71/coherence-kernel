; jit-lower-self-crystallized-probe.fk — named timing and route observations for
; one retained specialization across repeated complete lowering flows.
; No file, process, model, network or Metal crossing.
; preludes: form/form-stdlib/jit-lower-self-crystallized.fk

(do
    (defn jlscp-source ()
        (list
            (fk-if (fk-le (fk-arg) (fk-lit 10))
                (fk-if (fk-le (fk-lit 0) (fk-arg))
                    (fk-lit 1) (fk-lit 0))
                (fk-lit 0))
            (fk-add (fk-lit 40) (fk-lit 2))
            (fk-bmf-lowered (fk-add (fk-lit 40) (fk-lit 2)))))
    (defn jlscp-native-many (handle source i n)
        (if (ge i n) (jlsc-lower-fns handle source source)
            (do (let observed (jlsc-lower-fns handle source source))
                (jlscp-native-many handle source (add i 1) n))))
    (defn jlscp-form-many (source i n)
        (if (ge i n) (jit-lower-program source)
            (do (let observed (jit-lower-program source))
                (jlscp-form-many source (add i 1) n))))
    (let source (jlscp-source))
    (let t0 (now_unix_ms))
    (let handle (jlsc-birth))
    (let t1 (now_unix_ms))
    (let form-result (jlscp-form-many source 0 100))
    (let t2 (now_unix_ms))
    (let native-result (jlscp-native-many handle source 0 100))
    (let t3 (now_unix_ms))
    (list
        (list "shape-values" (len (jssc-handle-values handle)))
        (list "program-rows" (len (jssc-handle-program handle)))
        (list "image-bytes" (len (jssc-handle-image handle)))
        (list "birth-ms" (sub t1 t0))
        (list "form-100-flows-ms" (sub t2 t1))
        (list "native-nodeid-100-flows-ms" (sub t3 t2))
        (list "flow-parity" (value_eq form-result native-result))
        (list "route" (nth (jlsc-shape-route handle 77) 0))
        (list "births-per-retained-flow" 0)))
