// Complete attributed projection, executable metadata and owned publication.
// preludes: form-stdlib/bml/concept-human-reindex.bml form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class ConceptHumanReindexWitness {
  def chrw-put(path,bytes) = if and(eq(write_file(path,bytes),str_len(bytes)),str_eq(read_file(path),bytes)) then path else form_error("corpus witness exact write refused");
  def chrw-mkdir(path) = if fs_is_dir(path) then 1 else chrw-make(path,fs-path-dirname(path));
  def chrw-make(path,parent) {
   if or(str_eq(path,parent),str_eq(path,"")) then form_error("corpus witness directory root refused") else 0;
   chrw-mkdir(parent); if and(eq(fs_mkdir(path),1),fs_is_dir(path)) then 1 else form_error("corpus witness directory refused");
  }
  def chrw-copy(state,root,paths) = if nil?(paths) then 1 else chrw-copy-one(state,root,head(paths),tail(paths));
  def chrw-copy-one(state,root,path,rest) {
   let target = fs-path-join(root,path); chrw-mkdir(fs-path-dirname(target)); chrw-put(target,csa-file(state,path)); chrw-copy(state,root,rest);
  }
  def chrw-child(job,name,preludes,body) {
   let path = chrw-put(nsi-path(job,str_concat(name,".bml")),str_concat("// preludes: ",str_concat(preludes,str_concat("\nsection [form.bml] {\n",str_concat(body,"\n}\n")))));
   nsi-capture(list("./fkwu",path));
  }
  def chrw-runtime(job,name,metadata,offsets) = chrw-child(job,name,str_concat(metadata,str_concat(" ",offsets)),"list(hcnl13-row-count(),hcnl13-locale-count(),hcnl13-domain-count(),hcnl13-open-count(),hcnl13-ambiguity-count(),hcnl13-negative-count(),hcnl13-detection-count(),hcnl13-unique-concept-count(),hcnl13-attributed-count(),hcnl13-human-reviewed-count(),hcnl13-data-path(),hcnl13-manifest-path(),hcnl13-data-sha256(),hcnl13-manifest-sha256(),hcnl13-locale-stats(),hcnl13-offsets());");
  def chrw-equal(root,outputs) = if nil?(outputs) then 1 else and(str_eq(read_file(fs-path-join(root,head(head(outputs)))),nth(head(outputs),1)),chrw-equal(root,tail(outputs)));
  def chrw-provenance(old,next) = if nil?(old) then nil?(next) else if nil?(next) then 0 else and(chrw-attribution(csa-fields(head(old)),csa-fields(head(next))),chrw-provenance(tail(old),tail(next)));
  def chrw-attribution(old,next) = and(str_eq(csa-join(chr-take(old,8),"\t"),csa-join(chr-take(next,8),"\t")),str_eq(csa-join(chr-drop(old,14),"\t"),csa-join(chr-drop(next,14),"\t")));
  def chrw-group(surface,ids) = record_new(0,"surface",surface,"width",str_len(surface),"ids",ids,"count",len(ids));
  def chrw-add(tree,groups) = if nil?(groups) then 1 else chrw-add-one(tree,head(groups),tail(groups));
  def chrw-add-one(tree,group,rest) {
   if not(fbc-utf8(record_get(group,"surface"),0)) then form_error("invalid witness pattern") else 0;
   chr-add(tree,record_get(tree,"root"),chr-fold(record_get(group,"surface")),0,group); chrw-add(tree,rest);
  }
  def chrw-tree(lens,groups) {
   let tree = chr-tree(lens); chrw-add(tree,groups); chr-build-tree(tree); tree;
  }
  def chrw-surfaces(groups) = if nil?(groups) then list() else cons(record_get(head(groups),"surface"),chrw-surfaces(tail(groups)));
  def chrw-match(tree,s) {
   if not(fbc-utf8(s,0)) then form_error("invalid witness sentence") else 0;
   let found = chr-match(tree,s); list(record_get(found,"ids"),chrw-surfaces(record_get(found,"surfaces")));
  }
  def chrw-matcher(state) {
   let tree = chrw-tree(8,list(chrw-group("b",list(8,9)),chrw-group("Ab",list(2,7)),chrw-group("ab",list(3)),chrw-group("é",list(4)),chrw-group("xé",list(5)),chrw-group("😀",list(6)),chrw-group("a😀",list(1))));
   let found = chr-match(tree,"zAB!xé a😀");
   chr-check(state,"match-order-own-before-suffix-and-fold-ties",str_eq(csa-join(chrw-surfaces(record_get(found,"surfaces")),"|"),"Ab|ab|b|xé|é|a😀|😀"));
   chr-check(state,"complete-ascending-id-union",str_eq(chr-id-text(record_get(found,"ids")),"1,2,3,4,5,6,7,8,9"));
   chr-check(state,"first-collision-is-first-observed",str_eq(record_get(chr-collision(record_get(found,"surfaces")),"surface"),"Ab"));
   let bounded = chrw-tree(0,list(chrw-group("a",list(1)),chrw-group("é",list(2)),chrw-group("😀",list(3)),chrw-group("i",list(4))));
   chr-check(state,"ascii-fold-and-nonascii-boundaries",str_eq(chr-id-text(record_get(chr-match(bounded,"[A]_a! é 😀 I"),"ids")),"1,2,3,4"));
   chr-check(state,"utf8-adjacency-is-word-material",nil?(record_get(chr-match(bounded,"éa aé 😀a a😀 á İ"),"ids")));
   chr-check(state,"fold-does-not-change-nonascii",str_eq(chr-fold("AÉİẞ😀Z"),"aÉİẞ😀z"));
   chr-check(state,"malformed-utf8-refused",and(not(fbc-utf8(str_concat(byte_to_str(192),byte_to_str(175)),0)),not(fbc-utf8(str_concat(byte_to_str(237),str_concat(byte_to_str(160),byte_to_str(128))),0)))); 7;
  }
  def chrw-hashes(job,metadata) {
   let path = chrw-put(nsi-path(job,"hash-bytes"),"abc");
   let body = csa-join(list("list(hcnl13-artifacts-valid?(),hcnl13-hash-valid?(",crb-quoted(path),",\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"),hcnl13-hash-valid?(",crb-quoted(str_concat(path,"-absent")),",\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"));"),"");
   chrw-child(job,"portable-metadata-hashes",metadata,body);
  }
  def chrw-refusals(job,state,root) {
   let owner = "form-stdlib/bml/concept-human-reindex.bml";
   let tiny = "let s = cmm-state(\".\",\"form-sha256\"); let tree = chr-tree(0); let group = record_new(0,\"surface\",\"a\",\"width\",1,\"ids\",list(1),\"count\",1); chr-add(tree,record_get(tree,\"root\"),\"a\",0,group); chr-build-tree(tree); let w = record_new(0,\"tree:0\",tree); chr-row(s,w,list(\"en\",\"eng\",\"1\",\"author\",\"date\",\"date\",\"license\",\"url\",\"domain\",\"test\",\"9999\",\"\",\"0\",\"\",\"review\",\"hash\",\"a\"),0);";
   let absent = chrw-child(job,"domain-id-refusal",owner,tiny);
   chr-check(state,"domain-id-refusal",and(eq(nsi-status(absent),1),ge(str_find(nsi-text(absent),"human-reindex-domain-expected-id-observed",0),0)));
   let manifest = fs-path-join(root,chr-manifest()); let before = read_file(manifest);
   let body = csa-join(list("let work = chr-complete(chr-prepare(",crb-quoted(root),",\"arm64-sha256\")); let path = ",crb-quoted(manifest),"; let bytes = str_concat(read_file(path),\"changed\"); if ne(write_file(path,bytes),str_len(bytes)) then form_error(\"changed-source write refused\") else 0; chr-publish(work);"),"");
   let changed = chrw-child(job,"held-manifest-refusal",owner,body);
   chrw-put(manifest,before);
   chr-check(state,"fresh-source-refusal-and-restoration",and(eq(nsi-status(changed),1),and(ge(str_find(nsi-text(changed),"source-changed-before-publication",0),0),ge(str_find(nsi-text(changed),"private-stages-after-refusal",0),0)))); 2;
  }
  def chrw-released(root) {
   let stages = nsi-require-nuls(nsi-capture(list("find",root,"-name","*.stage-*","-print0")));
   eq(str_len(nsi-text(stages)),0);
  }
  def chrw-spaces(job,state,root) {
   let path = fs-path-join(root,chr-data()); let held = read_file(path);
   let altered = str_concat(substring(held,0,chr-lf-end(held,str_len(held))),"   \n"); chrw-put(path,altered);
   let body = csa-join(list("class CorpusTerminalSpaces {\n def cts-run() {\n  let work = chr-prepare(",crb-quoted(root),",\"arm64-sha256\");\n  let same = str_eq(record_get(work,\"snapshot\"),read_file(",crb-quoted(path),"));\n  if not(same) then form_error(\"terminal sentence spaces changed\") else 1;\n }\n}\ncts-run();"),"");
   let result = chrw-child(job,"terminal-sentence-spaces","form-stdlib/bml/concept-human-reindex.bml",body);
   chrw-put(path,held);
   chr-check(state,"last-sentence-spaces-preserved-and-restored",and(nsi-ok(result),str_eq(read_file(path),held))); 1;
  }
  def chrw-run() {
   let job = nsi-job(); let start = host_monotonic_ms(); let before = metal_live();
   let work = chr-complete(chr-prepare(".","arm64-sha256")); let state = record_get(work,"input"); let built = sub(host_monotonic_ms(),start);
   chr-check(state,"entire-attributed-tsv-byte-parity",str_eq(record_get(work,"snapshot"),csa-file(state,chr-data())));
   chr-check(state,"all-source-attribution-review-hash-fields",chrw-provenance(tail(chr-lines(csa-file(state,chr-data()))),tail(chr-lines(record_get(work,"snapshot")))));
   chrw-matcher(state);
   let old = chrw-runtime(job,"current-runtime",chr-path("-metadata.fk"),chr-path("-offsets.fk"));
   let root = nsi-directory(job,"attributed-",0);
   chrw-copy(state,root,append(chr-inputs(),list(chr-path("-offsets.fk"),chr-path("-metadata.fk")))); record_set(state,"root",root);
   chr-check(state,"actual-three-artifact-publication",eq(chr-publish(work),1));
   chr-check(state,"published-artifacts-byte-parity",chrw-equal(root,record_get(work,"outputs")));
   let metadata = fs-path-join(root,chr-path("-metadata.fk")); let offsets = fs-path-join(root,chr-path("-offsets.fk"));
   let current = chrw-runtime(job,"generated-runtime",metadata,offsets);
   chr-check(state,"all-1301-offsets-and-runtime-metadata",and(nsi-ok(old),and(nsi-ok(current),str_eq(nsi-text(old),nsi-text(current)))));
   let hash = chrw-hashes(job,metadata);
   chr-check(state,"portable-sha-existing-and-missing-files",and(nsi-ok(hash),str_eq(trim(nsi-text(hash)),"[1, 1, 0]")));
   let repeated = chrw-child(job,"portable-republication","form-stdlib/bml/concept-human-reindex.bml",csa-join(list("chr-run(",crb-quoted(root),",\"form-sha256\");"),""));
   chr-check(state,"portable-idempotence",and(nsi-ok(repeated),chrw-equal(root,record_get(work,"outputs"))));
   chrw-spaces(job,state,root);
   chrw-refusals(job,state,root);
   chr-check(state,"refusal-physically-released-all-stages",chrw-released(root));
   chr-check(state,"refused-publication-keeps-output-bytes",chrw-equal(root,record_get(work,"outputs")));
   let after = metal_live(); chr-check(state,"cpu-resource-release",and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3))));
   print(list("human-corpus-reindex","rows",record_get(work,"rows"),"detections",record_get(work,"detections"),"unique",record_get(work,"unique-ids-count"),"roles",crb-count-values(work,chr-roles()),"bytes",str_len(record_get(work,"snapshot")),"build-ms",built,"evidence",job)); 1;
  }
 }
 chrw-run();
}
