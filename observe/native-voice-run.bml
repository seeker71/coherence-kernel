// native-voice-run.bml — the body's local voice speaks the body's own answer.
//
// The packet is not a seed list with receipt openings; it is the native
// compare composition itself (form-stdlib/bml/form-cli-native-compare.bml):
// the enquiry, the measured ledger rows, the axes, the seeds, one step along
// the relations, the dated receipt index. The in-process fkwu model session
// turns that composition into sentences using registry weights as input data.
// No provider or model server is asked here.
// The walk leaves one row in receipts/rent-ledger.jsonl with movement
// native-voice, the local token counts, completion, release, structural floor
// and its evidence path; the answer text never enters the ledger.
// stdin, optional: {"movement":"<name>","composition":"<the native compare text, already composed>",
//                   "model":"qwen38-q8","context":12288,"max_reply_tokens":1536}
// With a composition given, the door does not compose again: the movement door
// composes once through the compare door and hands the text here, so this
// door retains the packet, raw generation, generated IDs, metadata and row.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-compare.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class NativeVoice {
  def nv-source() = "observe/native-voice-run.bml";
  def nv-ledger() = "receipts/rent-ledger.jsonl";
  def nv-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def nv-planes(planes, rows) = if nil?(planes) then "" else mc-cat(list(head(planes), "=", int_to_str(fmrc-delta-plane-total(rows, head(planes))), if nil?(tail(planes)) then "" else " ", nv-planes(tail(planes), rows)));
  def nv-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh");
  def nv-packet(composition) = mc-cat(list(
   read_file(fnc-enquiry()), "\n\n",
   "[The body's own measured answer follows. Every number in it is a row the body wrote.]\n",
   composition, "\n",
   "This turn has no tools and no file access; everything usable is in this message. Speak the comparison above in plain sentences, axis by axis in the order given, using its numbers and ledger rows, and say only what the composition states: add no judgment of your own, and where an axis carries no number or verdict, say so. Cite receipts by the paths given. After the answer, say plainly what the material does not establish and what remains pending.\n"));
  def nv-row(options, job, packet, answer, floor, oracle, groundingMs, oracleMs) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", if json-object-has?(options, "movement") then nv-str(options, "movement") else "native-voice"),
   fhn-s("enquiry", fnc-enquiry()),
   fhn-s("source", if str_eq(nth(oracle, 0), "answered") then "fkwu-model-session" else "none"),
   json-node-pair("native_generation",fcnv-metadata(oracle)),
   fhn-s("oracle", nth(oracle, 0)),
   fhn-n("rent_tokens", 0),
   fhn-n("oracle_tokens_evaluated", nth(oracle, 2)),
   fhn-n("oracle_tokens_predicted", nth(oracle, 3)),
   fhn-s("oracle_model", nth(oracle, 4)),
   fhn-n("receipts_in_packet", fnc-receipt-limit()),
   fhn-n("packet_bytes", str_len(packet)),
   fhn-n("answer_bytes", str_len(answer)),
   fhn-n("answer_axes", nth(floor, 0)),
   fhn-n("answer_receipts_cited", nth(floor, 1)),
   fhn-n("answer_receipts_existing", nth(floor, 2)),
   fhn-n("answer_limits", nth(floor, 3)),
   fhn-n("grounding_ms", groundingMs),
   fhn-n("oracle_ms", oracleMs),
   fhn-n("provider_ms", 0),
   fhn-s("answer", fhn-at(job, "answer.md")),
   fhn-s("evidence", job)));
  def nv-run() {
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let options = if str_eq(line, "") then json-node-object(list()) else parse-json("native-voice-options", line);
   let window = fmrc-open("native-voice", "the body's composition spoken by its in-process model session", nv-source(), 1, 1);
   let started = now_unix_ms();
   let spool = fhn-at(fhn-root(), ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "native-voice-", 0);
   let composition = if json-object-has?(options, "composition") then nv-str(options, "composition") else fnc-compose();
   let packet = nv-packet(composition);
   let wrotePacket = write_file_text(fhn-at(job, "packet.txt"), packet);
   let grounded = now_unix_ms();
   let oracle = fcnv-ask(packet,options);
   let retained = fcnv-retain(job,oracle);
   let spoken = now_unix_ms();
   let answer = nth(oracle, 1);
   let wroteAnswer = write_file_text(fhn-at(job, "answer.md"), answer);
   let floor = apc-floor(answer);
   let row = nv-row(options, job, packet, answer, floor, oracle, sub(grounded, started), sub(spoken, grounded));
   let appended = fhn-append(nv-ledger(), str_concat(json-emit(row), "\n"));
   let result = fmrc-close(window, "observed", nv-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(json-emit-precise(json-node-object(list(json-node-pair("row", row), fhn-s("ledger", appended), fhn-s("census", fmrc-result-status(result)), fhn-n("dispatches", fmrc-delta-total(rows)), fhn-s("planes", nv-planes(nv-plane-names(), rows))))));
  }
 }
 nv-run();
}
