; qwen38-resident-recipe-birth-exec-live-run.fk — EFFECTFUL LIVE DRIVER.
;
; DO NOT PREFLIGHT THIS FILE. Preflight executes top-level forms on this lane.
; Run once only after coordinating the resident Qwen + Metal carrier window.
;
; preludes: form-stdlib/form-cli-resident-recipe-birth-exec.fk

(do
    (defn qrbe-path ()
        "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn qrbe-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn qrbe-int (name value)
        (qrbe-line name (int_to_str value)))
    (defn qrbe-bit (ok bit) (if ok bit 0))
    (defn qrbe-prompt ()
        (frbe-cat (list
            "You are in one resident local Form recipe-birth and execution session. "
            "Invent one bounded signed-i32 affine micro-thought by choosing mul from -3..3 and add from -7..7. "
            "First output exactly one control frame, with no prose before it: "
            "<|form:recipe-birth|>affine-i32;mul=M;add=A<|/form:recipe-birth|> where M and A are your chosen canonical integers. "
            "Form will return a typed birth observation containing the born recipe-node. "
            "Then invoke that exact born NodeID for input 5 by outputting exactly "
            "<|form:recipe-exec|>@p.l.t.i;input=5;carrier=auto<|/form:recipe-exec|> with @p.l.t.i replaced by the observed recipe-node. "
            "Do not invoke any other NodeID. Form will return a typed physical execution observation. "
            "After it arrives, do not emit another control frame. Answer one concise ASCII line beginning observed and name status, value, carrier, and execution-observation-node.")))

    (let started (now_unix_ms))
    (let opened (fcms-open (qrbe-path) (qrbe-prompt) 2048))
    (let open-ms (sub (now_unix_ms) started))
    (if (not (eq (fcms-live? opened) 1))
        (do
            (qrbe-line "status" (fcms-status opened))
            (qrbe-line "reason" (fcms-reason opened))
            (qrbe-int "open-ms" open-ms)
            0)
        (do
            (let moved (frbe-run opened 256))
            (let ended (now_unix_ms))
            (let session (frbe-movement-session moved))
            (let request (frbe-movement-request moved))
            (let result (frbe-movement-result moved))
            (let born-observation
                (frbe-movement-birth-observation moved))
            (let has-result (if (nothing? result) 0 1))
            (let expected (if (eq has-result 1)
                (frexl-recipe-expected (frbe-result-recipe result)
                    (frbe-request-input request)) 0))

            (qrbe-line "model-birth" (frbe-movement-birth-model moved))
            (qrbe-line "form-birth-injected"
                (frbe-movement-birth-injected moved))
            (qrbe-line "model-invoke" (frbe-movement-invoke-model moved))
            (qrbe-line "form-execution-injected"
                (frbe-movement-exec-injected moved))
            (qrbe-line "model-answer" (frbe-movement-answer-model moved))
            (qrbe-int "open-ms" open-ms)
            (qrbe-int "movement-ms" (sub ended (add started open-ms)))
            (qrbe-int "phase" (frbe-movement-phase moved))
            (qrbe-int "crossings" (frbe-movement-crossings moved))
            (qrbe-int "prompt-ids" (fcms-prompt-ids session))
            (qrbe-int "birth-model-ids"
                (len (frbe-movement-birth-ids moved)))
            (qrbe-int "invoke-model-ids"
                (len (frbe-movement-invoke-ids moved)))
            (qrbe-int "answer-model-ids"
                (len (frbe-movement-answer-ids moved)))
            (qrbe-int "model-bytes" (frbe-movement-model-bytes moved))
            (qrbe-int "injected-ids" (fcms-injected-ids session))
            (qrbe-int "injected-bytes"
                (frbe-movement-injected-bytes moved))
            (qrbe-int "observation-count" (fcms-observations session))
            (qrbe-line "birth-observation-node"
                (str_concat "@" (frbt-node-key born-observation)))
            (if (eq has-result 1)
                (do
                    (qrbe-line "status" (frbe-result-status result))
                    (qrbe-line "reason" (frbe-result-reason result))
                    (qrbe-line "recipe-node" (str_concat "@"
                        (frex-node-key (frbe-result-recipe result))))
                    (qrbe-line "request-node" (str_concat "@"
                        (frex-node-key (frbe-request-token request))))
                    (qrbe-line "request-observation-node" (str_concat "@"
                        (frex-node-key
                            (frbe-result-request-observation result))))
                    (qrbe-line "code-node" (str_concat "@"
                        (frex-node-key (frbe-result-code result))))
                    (qrbe-line "code-observation-node" (str_concat "@"
                        (frex-node-key
                            (frbe-result-code-observation result))))
                    (qrbe-line "execution-node" (str_concat "@"
                        (frex-node-key (frbe-result-execution result))))
                    (qrbe-line "execution-observation-node" (str_concat "@"
                        (frex-node-key (frbe-result-observation result))))
                    (qrbe-line "carrier" (frbe-result-carrier result))
                    (qrbe-int "value-present"
                        (frbe-result-value-present? result))
                    (qrbe-int "value" (frbe-result-value result))
                    (qrbe-int "expected" expected)
                    (qrbe-int "source-generated"
                        (frbe-result-source-generated? result))
                    (qrbe-int "native-code-generated"
                        (frbe-result-native-code-generated? result))
                    (qrbe-int "executed" (frbe-result-executed? result))
                    (qrbe-int "model-executed"
                        (frbe-result-model-executed? result))
                    (qrbe-int "pipeline-created"
                        (frbe-result-pipeline-created? result))
                    (qrbe-int "buffer-released"
                        (frbe-result-buffer-released? result))
                    (qrbe-line "request-lifecycle" (frbe-trace-actions
                        (frbe-request-observation-trace
                            (frbe-request-observation request))))
                    (qrbe-line "execution-lifecycle" (frbe-trace-actions
                        (frbe-result-trace result))))
                (qrbe-line "status" "nothing"))
            (qrbe-line "generated-id-policy" (fcms-generated-id-policy))
            (qrbe-line "resume-encode-scope" (fcms-resume-encode-scope))
            (let release-ok (fcms-release-ok? session))
            (qrbe-int "release-ok" release-ok)
            (if (not (eq has-result 1)) 0
                (sum (list
                    (qrbe-bit (eq (frbe-movement-crossings moved) 2) 1)
                    (qrbe-bit (gt (str_len
                        (frbe-movement-birth-injected moved)) 0) 2)
                    (qrbe-bit (eq (frbe-request-ready? request) 1) 4)
                    (qrbe-bit (eq (frbt-recipe-shape?
                        (frbe-result-recipe result)) 1) 8)
                    (qrbe-bit (str_eq (frbe-result-status result) "value") 16)
                    (qrbe-bit (eq (frbe-result-value-present? result) 1) 32)
                    (qrbe-bit (eq (frbe-result-value result) expected) 64)
                    (qrbe-bit (eq (frbe-result-source-generated? result) 1) 128)
                    (qrbe-bit
                        (eq (frbe-result-native-code-generated? result) 1) 256)
                    (qrbe-bit (eq (frbe-result-executed? result) 1) 512)
                    (qrbe-bit (eq (frbe-result-model-executed? result) 0) 1024)
                    (qrbe-bit (and (eq (fcms-observations session) 2)
                                   (gt (fcms-injected-ids session) 0)) 2048)
                    (qrbe-bit (and (ge (str_find (fcms-generated-id-policy)
                                             "original" 0) 0)
                        (lt (str_find (fcms-generated-id-policy)
                                     "re-encode" 0) 0)) 4096)
                    (qrbe-bit (and
                        (not (node_eq born-observation
                                     (frbe-result-request-observation result)))
                        (and (not (node_eq
                            (frbe-result-request-observation result)
                            (frbe-result-code-observation result)))
                             (not (node_eq
                                (frbe-result-execution result)
                                (frbe-result-observation result))))) 8192)
                    (qrbe-bit (and (eq (frbe-trace-has?
                            (frbe-result-trace result) "crystallize") 1)
                         (eq (frbe-trace-has?
                            (frbe-result-trace result) "release") 1)) 16384)
                    (qrbe-bit (eq (frbe-result-buffer-released? result) 1) 32768)
                    (qrbe-bit (eq release-ok 1) 65536)))))))
