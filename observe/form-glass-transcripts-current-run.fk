; Read-only live projection witness: counts/codes/kinds, never transcript text.
; Does not start an ear, a model, a publisher or a second Glass renderer.
; preludes: form/form-stdlib/form-glass-meaning-ui.bml form/form-stdlib/form-glass-sensor-rows.bml
(do
  (defn gtr-kinds (rows) (if (eq (len rows) 0) (list) (cons (list (etr-code (head rows)) (etr-kind (head rows)) (fgo-evidence (head rows))) (gtr-kinds (tail rows)))))
  (let rows (fgsr-rows-or-absent "ear" (fgsr-take "ear" (list))))
  (let transcripts (fglm-transcripts rows))
  (print (list "glass-transcripts-observed-v1" (now_unix_ms) "rows" (len transcripts) "languages" (fglm-published-codes transcripts (list)) "kinds" (gtr-kinds transcripts) "ear" (fglm-state rows)))
)
