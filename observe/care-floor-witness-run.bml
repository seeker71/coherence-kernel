// care-floor-witness-run.bml — reads the care floor's self-check and lands it as a row
// (receipts/care-floor-ledger.jsonl: verdict and full), the row docs/local-agent-goal.form's CARE bit reads.
// stdin: nothing.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/care-floor.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class CareFloorWitness {
  def cfw-run() {
   let verdict = cf-self-check();
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-n("verdict", verdict), fhn-n("full", 255), fhn-s("unit", "form/form-stdlib/bml/care-floor.bml")));
   let appended = fhn-append("receipts/care-floor-ledger.jsonl", str_concat(json-emit(row), "\n"));
   print_str(str_concat(json-emit(row), "\n"));
  }
 }
 cfw-run();
}
