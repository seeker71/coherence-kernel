; form-resident-pif-core-live.fk -- standing stdin proof of post-startup
; interpreted recipe birth, NodeID invocation, and replacement without restart.
;
; Commands:
;   any Form expression/defn line
;   invoke P L T I ARG
;   release
;
; A defn response prints the new content NodeID coordinates.  Feed those exact
; coordinates to invoke.  `read_line` blocks inside this same fkwu PID, making
; later recipe source genuinely absent at compile/startup time.
;
; preludes: form-stdlib/form-resident-pif-core-eval.fk

(do
    (defn frpcl-line (name value)
        (print_str (str_concat "resident-pif "
            (str_concat name (str_concat "=" value)))))
    (defn frpcl-int (name value) (frpcl-line name (int_to_str value)))
    (defn frpcl-node (identity)
        (do
            (frpcl-int "node-p" (node_pkg identity))
            (frpcl-int "node-l" (node_level identity))
            (frpcl-int "node-t" (node_type identity))
            (frpcl-int "node-i" (node_inst identity))))
    (defn frpcl-space (line start) (str_find line " " start))
    (defn frpcl-invoke (state line)
        (do
            (let s1 (frpcl-space line 7))
            (let s2 (frpcl-space line (add s1 1)))
            (let s3 (frpcl-space line (add s2 1)))
            (let s4 (frpcl-space line (add s3 1)))
            (let identity (make_nodeid
                (str_to_int (substring line 7 s1))
                (str_to_int (substring line (add s1 1) s2))
                (str_to_int (substring line (add s2 1) s3))
                (str_to_int (substring line (add s3 1) s4))))
            (let receipt (frpce-invoke-one state identity
                (str_to_int (substring line (add s4 1) (str_len line)))))
            (frpcl-line "status" (frpce-receipt-status receipt))
            (frpcl-line "reason" (frpce-receipt-reason receipt))
            (frpcl-line "signal" (frpce-signal
                (frpce-receipt-value receipt)))
            (frpcl-line "value" (int_to_str
                (frpce-receipt-value receipt)))
            (frpcl-int "output-count" (frpce-receipt-output receipt))
            (frpcl-line "trace" (frpce-receipt-trace receipt))
            state))
    (defn frpcl-source (state line)
        (do
            (let next (frpce-eval state line))
            (frpcl-line "status" (frpce-status next))
            (frpcl-line "value" (int_to_str (frpce-value next)))
            (if (nothing? (frpce-identity next)) 0
                (frpcl-node (frpce-identity next)))
            next))
    (defn frpcl-loop (state turns)
        (do
            (frpcl-line "ready" "1")
            (let line (read_line))
            (if (or (nothing? line) (str_eq line "release"))
                (do
                    (frpcl-int "turns" turns)
                    (frpcl-line "release" "1")
                    1)
            (if (eq (str_find line "invoke " 0) 0)
                (frpcl-loop (frpcl-invoke state line) (add turns 1))
                (frpcl-loop (frpcl-source state line) (add turns 1))))))
    (frpcl-line "pid-stable-process" "1")
    (frpcl-loop (frpce-empty) 0))
