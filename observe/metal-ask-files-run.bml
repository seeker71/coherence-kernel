// Environment/argv adapters put exact values in private files. One directory
// path arrives on stdin. Form reads, validates and owns the entire ask.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/metal-ask.bml
section [form.bml] {
 class MetalAskFiles {
  def maf-read(dir,key) = read_file(str_concat(dir,str_concat("/",key)));
  def maf-or(value,default) = if eq(str_len(value),0) then default else value;
  def maf-digits(s,i) = if ge(i,str_len(s)) then gt(i,0) else and(ge(str_byte_at(s,i),48),and(le(str_byte_at(s,i),57),maf-digits(s,add(i,1))));
  def maf-run(dir) {
   let capText = maf-read(dir,"cap");
   let cap = if maf-digits(capText,0) then str_to_int(capText) else 0;
   let owner = ma-ask(maf-or(maf-read(dir,"blob"),ma-blob()),maf-or(maf-read(dir,"model"),ma-model()),maf-read(dir,"prompt"),cap);
   let artifact = str_concat(maf-or(maf-read(dir,"stage"),fs-path-dirname(anl-artifact-path())),"/answer.txt");
   if ma-publish(owner,artifact) then print_str(ma-artifact(owner)) else ma-voice-refusal(owner);
  }
 }
 maf-run(read_line());
}
