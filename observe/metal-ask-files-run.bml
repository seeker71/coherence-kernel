// Environment/argv adapters put exact values in private files. One directory
// path arrives on stdin. Form reads, validates and owns the entire ask.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/metal-ask.bml
section [form.bml] {
 class MetalAskFiles {
  def maf-read(dir,key) = read_file(dir ++ "/" ++ key);
  def maf-or(value,default) = (Comparable) str_len(value) == 0 ? default : value;
  def maf-digits(s,i) = i >= str_len(s) ? (i > 0) : ((str_byte_at(s,i) >= 48) && ((str_byte_at(s,i) <= 57) && maf-digits(s,i + 1)));
  def maf-run(dir) {
   let capText = maf-read(dir,"cap");
   let cap = maf-digits(capText,0) ? str_to_int(capText) : 0;
   let owner = ma-ask(maf-or(maf-read(dir,"blob"),ma-blob()),maf-or(maf-read(dir,"model"),ma-model()),maf-read(dir,"prompt"),cap);
   let artifact = maf-or(maf-read(dir,"stage"),fs-path-dirname(anl-artifact-path())) ++ "/answer.txt";
   ma-publish(owner,artifact) ? print_str(ma-artifact(owner)) : ma-voice-refusal(owner);
  }
 }
 maf-run(read_line());
}
