; preludes: form/form-stdlib/bml/copy-census.bml form/form-stdlib/line-grammar.fk
;
; copy-census-run — the body looks for its own copies. stdin line 1 names the root to walk
; (default: the whole tree); line 2 the substance floor, in significant bytes (default 24).
;
; It found itself on its first run — cpc-f-sl and cpc-r-to are one shape under two names in
; this very lens — which is the right temperament for a census: it is not above what it reads.
(do
    (defn cr-trim (s) (if (nothing? s) "" (trim s)))
    (let root0 (cr-trim (read_line)))
    (let floor0 (cr-trim (read_line)))
    (let root (if (eq (str_len root0) 0) "." root0))
    (let flr (if (eq (str_len floor0) 0) 24 (str_to_int floor0)))
    (let t0 (now_unix_ms))
    (let ps (cpc-walk root (list)))
    (let tab (cpc-census ps))
    (let fs (cpc-families tab))
    (let big (cpc-weighty fs flr (list)))
    (let t1 (now_unix_ms))
    (print_str (str_concat "walked " (str_concat root (str_concat "  files " (str_concat (int_to_str (len ps)) (str_concat "  ms " (int_to_str (sub t1 t0))))))))
    (print_str (str_concat "copy families " (str_concat (int_to_str (len fs))
               (str_concat "   definitions held more than once " (int_to_str (cpc-extra fs))))))
    (print_str (str_concat "with real substance (>= " (str_concat (int_to_str flr)
               (str_concat " significant bytes): " (str_concat (int_to_str (len big))
               (str_concat " families, " (str_concat (int_to_str (cpc-extra big)) " extra copies")))))))
    (print_str "")
    (cpc-say-fams big 25)
    (print_str "")
    (let nt (cpc-name-census ps))
    (let ms (cpc-multi-names nt))
    (print_str (str_concat "one NAME in more than one file: " (str_concat (int_to_str (len ms))
               " — not wrong by itself, a shim SHOULD mirror; every one is a place drift is silent")))
    (cpc-say-names ms 15)
    (len big))
