// Read only the resident's last acknowledged terminal write and cadence.
// No collectors, kernel census, terminal repaint, or model admission.
// preludes: form-stdlib/form-glass-live.bml
section [form.bml] {
 class FormGlassPresentationCurrent {
  def fgpc-read() {
   let reading = fgl-last-take("presentation");
   let cadence = fgl-cadence-last-load();
   if nothing?(reading) then list("glass-presentation", "unobserved") else if not(eq(len(reading), 6)) then list("glass-presentation", "invalid") else list("glass-presentation", "age-ms", sub(now_unix_ms(), nth(reading, 2)), "frame-to-write-ms", nth(reading, 3), "terminal-write-ms", nth(reading, 4), "generation", nth(reading, 5), "work-wait-target-ms", cadence, "scope", "terminal-write-ack;not-display-photon-time");
  }
 }
 fgpc-read();
}
