// ear-truth-set-run.bml — the ear's ground truth, spoken by this Mac's own voices.
//
// Reads model/fixtures/ear-truth/sentences.tsv (locale, id, sentence), speaks each sentence with the first
// local voice of its locale through `say` into .hearth/ear-truth/<id>.aiff, converts it to 16 kHz mono
// PCM16 (<id>.wav, the shape both ears read), writes the sentence to <id>.txt, and writes
// .hearth/ear-truth/manifest.tsv (wav, txt) for observe/stt-wer-fixtures-run.fk and voices.tsv naming the
// voice each clip was spoken in. No network; the host's own voices and converter are the body's hands here.
// stdin: nothing. Prints the count of clips spoken and any sentence that could not be.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class EarTruthSet {
  def et-table() = "model/fixtures/ear-truth/sentences.tsv";
  def et-dir() = ".hearth/ear-truth";
  def et-join(parts, sep) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else mc-cat(list(head(parts), sep, et-join(tail(parts), sep)));
  def et-quote(s) = mc-cat(list("'", et-join(split-on(s, "'"), "'\\''"), "'"));
  // the first natural voice of the locale: macOS also ships novelty voices (Albert, Zarvox, Bells ...) whose
  // timbre is a toy, and a ground truth spoken by a toy would measure the toy
  def et-novelty() = "Albert Bad Bahh Bells Boing Bubbles Cellos Good Jester Organ Superstar Trinoids Whisper Wobble Zarvox Fred Junior Kathy Ralph";
  def et-voice(locale) = trim(host-exec(mc-cat(list("say -v '?' | awk -v skip=\"", et-novelty(), "\" 'BEGIN{n=split(skip,s,\" \"); for(i=1;i<=n;i++) bad[s[i]]=1} $2==\"", locale, "\" && !($1 in bad) {print $1; exit}'")), ""));
  def et-speak(locale, id, text) {
   let voice = et-voice(locale);
   let aiff = mc-cat(list(et-dir(), "/", id, ".aiff"));
   let wav = mc-cat(list(et-dir(), "/", id, ".wav"));
   let said = host-exec(mc-cat(list("say -v ", et-quote(voice), " -o ", et-quote(aiff), " ", et-quote(text), " && afconvert -f WAVE -d LEI16@16000 -c 1 ", et-quote(aiff), " ", et-quote(wav), " && rm -f ", et-quote(aiff), " && echo ok")), "");
   let txt = write_file_text(mc-cat(list(et-dir(), "/", id, ".txt")), text);
   list(str_eq(trim(said), "ok"), voice, wav);
  }
  def et-rows(lines, n, missed) {
   if nil?(lines) then list(n, missed) else et-row(split-on(head(lines), "\t"), tail(lines), n, missed);
  }
  def et-row(cols, rest, n, missed) {
   if lt(len(cols), 3) then et-rows(rest, n, missed) else et-said(et-speak(head(cols), nth(cols, 1), nth(cols, 2)), nth(cols, 1), rest, n, missed);
  }
  def et-said(r, id, rest, n, missed) {
   let m = if head(r) then fhn-append(mc-cat(list(et-dir(), "/manifest.tsv")), mc-cat(list(nth(r, 2), "\t", et-dir(), "/", id, ".txt\n"))) else "";
   let v = fhn-append(mc-cat(list(et-dir(), "/voices.tsv")), mc-cat(list(id, "\t", nth(r, 1), "\n")));
   et-rows(rest, if head(r) then add(n, 1) else n, if head(r) then missed else cons(id, missed));
  }
  def et-run() {
   let made = fs_mkdir(et-dir());
   let m0 = write_file_text(mc-cat(list(et-dir(), "/manifest.tsv")), "");
   let v0 = write_file_text(mc-cat(list(et-dir(), "/voices.tsv")), "");
   let lines = split-on(fhn-read(et-table()), "\n");
   let r = et-rows(lines, 0, list());
   print_str(mc-cat(list("ear-truth spoken=", int_to_str(head(r)), " missed=", et-join(reverse(nth(r, 1)), ","), " manifest=", et-dir(), "/manifest.tsv\n")));
  }
 }
 et-run();
}
