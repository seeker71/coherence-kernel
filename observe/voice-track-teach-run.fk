; voice-track-teach-run.fk — the oracle's one visit: every taught line and word lands in the body's own tables.
; Needs the pieces cut by voice-track-prepare-run.fk. Resumable: a row already taught is not asked again.
; Prints, per tongue, the rows taught this visit and then how often the word walk alone reproduces the taught
; line (same, of lines) — the number the body reads to know how far its word table already carries a tongue.
; Proof: pending (the band for the tables is tests/voice-g2p-band.fk).
; preludes: form/form-stdlib/voice-g2p-teach.bml
(do
    (defn vt-path (code) (str_concat ".hearth/voice-track/" (str_concat code "-chunks.txt")))
    (defn vt-say (code what a b) (print_str (str_concat code (str_concat what (str_concat (int_to_str a) (str_concat " / " (int_to_str b)))))))
    (defn vt-teach (code)
        (do (let r (vgt-teach code (vt-path code)))
            (vt-say code " taught lines / words " (nth r 0) (nth r 1))
            (let f (vgt-fidelity code (vt-path code)))
            (vt-say code " word walk reproduces taught line, of lines " (nth f 0) (nth f 1))))
    (vt-teach "en") (vt-teach "pt") (vt-teach "fa") (vt-teach "id")
    0)
