; serve-the-core.fk — inverting the default: the store answers first, the rented mind last.
;
; Urs, 2026-07-23 09:08: look at it high level — how the flow fits the lookup and how we use
; tokens, and invert the default instinct so we are in service of a core that knows more for
; itself. We do not convince, we do not advise. We prove from a store that relates to us and
; is trusted from self-experience, timeless and relevant to the inquiry lane under observation.
;
; THE INVERSION, as control flow rather than sentiment. The rented mind's default instinct is
; GENERATE-FIRST: meet a question by producing an answer (convince, advise). The store's
; instinct is RETRIEVE-FIRST: meet a question by locating what the body already knows from its
; own experience. This cell makes the second the default and the first the fallback.
;
;   1. a question arrives as tokens.
;   2. hdc-locate resolves it against the corpus — 875 rows the body earned, each a question it
;      could not answer once, answered, and kept. A hit is the body's OWN truth: timeless (a
;      resolved frontier word does not decay), trusted (it survived its band), and free (zero
;      rented tokens — the store answers for itself).
;   3. only a MISS is owed to the rented mind. And the rented answer is provisional until it is
;      deposited as a row, at which point it stops being rented and becomes the body's own.
;
; The doctrine is SUBSIDIARITY: a matter is handled by the lowest competent authority, and the
; central power acts only where the local one cannot. The body is local and self-knowing; the
; rented mind is central and subsidiary; and every deposit moves a question from central to
; local, permanently. Self-sufficiency is therefore MEASURABLE and MONOTONE — it only rises.
;
; HOW WE USE TOKENS falls straight out: a hit costs zero rented tokens because the store
; answers; a miss costs one rental plus one deposit. As the store grows, the rented-token cost
; per inquiry falls toward zero, and the store is a cache that never expires because its
; entries are timeless. The cheapest inquiry is the one the body already lived through.
;
; preludes: form-stdlib/core.fk learn/homecoming-distillation-corpus.fk

(do
    ; ── the lookup, wrapped as an inversion decision ──
    ; hdc-locate returns a meaning-id (>0) on hit, 0 on miss. That single number is the whole
    ; inversion: nonzero means the body serves itself, zero means the rented mind is invoked.
    (defn stc-serves-self? (tokens) (if (gt (hdc-locate tokens) 0) 1 0))
    (defn stc-owed-to-rent? (tokens) (if (eq (hdc-locate tokens) 0) 1 0))

    ; ── the answer's PROVENANCE, which is the thing the default hides ──
    ; "body" — retrieved from the store, timeless, trusted, zero rented tokens
    ; "rented" — generated, provisional, owed a deposit before it can be trusted
    (defn stc-provenance (tokens)
        (if (eq (stc-serves-self? tokens) 1) "body" "rented"))

    ; a body answer carries the word the body already holds; a rented one carries nothing yet
    (defn stc-answer (tokens)
        (if (eq (stc-serves-self? tokens) 1) (hdc-word-for-id (hdc-locate tokens)) ""))

    ; ── token cost, in the currency that matters: rented tokens ──
    ; a hit is 0 (the store answered). a miss is 1 rental + 1 deposit = 2, and the deposit is
    ; what makes the SAME question cost 0 next time. paying twice once to pay nothing forever.
    (defn stc-rent-cost (tokens) (if (eq (stc-serves-self? tokens) 1) 0 2))

    ; ── the trust test: an answer is trustworthy iff it is the body's own OR has been
    ; deposited. the rented mind's fresh output is never trustworthy on arrival — it is a
    ; candidate, and 869 source-monitoring is exactly why: it cannot tell its own inventions
    ; from measurements, so nothing it produces is trusted until the store has taken it. ──
    (defn stc-trusted? (tokens deposited)
        (if (eq (stc-serves-self? tokens) 1) 1 (if (eq deposited 1) 1 0)))

    ; ── self-sufficiency over a set of inquiries: the fraction the body serves itself, and it
    ; only rises as the store grows (a deposited miss becomes a future hit; a hit never
    ; becomes a miss). measured in tenths so integer math holds. ──
    (defn stc-served (qs)
        (if (eq (len qs) 0) 0
            (add (stc-serves-self? (head qs)) (stc-served (tail qs)))))
    (defn stc-sufficiency-x10 (qs)
        (if (eq (len qs) 0) 0 (div (mul (stc-served qs) 10) (len qs))))

    ; ── witnessed inquiries. the two the corpus band already proves (601 hit, unknown miss),
    ; plus a fresh word the body now owns after last night (insonation, row 853). ──
    (defn stc-q-known ()
        (list "what" "is" "an" "edge" "called" "that" "appears" "in" "the"
              "meaning" "graph" "from" "a" "shared" "surface" "token"
              "rather" "than" "a" "shared" "meaning"))
    (defn stc-q-insonation ()
        (list "what" "one" "word" "names" "sound" "entering" "tissue"
              "as" "distinct" "from" "being" "heard"))
    (defn stc-q-unknown () (list "what" "is" "the" "airspeed" "of" "an" "unladen" "swallow"))

    ; ── self-check ──
    (defn stck (cond bit) (if cond bit 0))
    (defn stc-known-self ()  (stck (eq (stc-serves-self? (stc-q-known)) 1) 1))
    (defn stc-known-body ()  (stck (str_eq (stc-provenance (stc-q-known)) "body") 2))
    (defn stc-known-free ()  (stck (eq (stc-rent-cost (stc-q-known)) 0) 4))
    ; a word the body earned only last night now answers for itself — insonation, row 853
    (defn stc-inson-self ()  (stck (str_eq (stc-answer (stc-q-insonation)) "insonation") 8))
    ; the unknown is owed to the rented mind, and costs a rental + a deposit
    (defn stc-unk-rent ()    (stck (eq (stc-owed-to-rent? (stc-q-unknown)) 1) 16))
    (defn stc-unk-cost ()    (stck (eq (stc-rent-cost (stc-q-unknown)) 2) 32))
    ; the rented answer is NOT trusted on arrival, and IS once deposited
    (defn stc-unk-untrusted () (stck (eq (stc-trusted? (stc-q-unknown) 0) 0) 64))
    (defn stc-unk-deposited () (stck (eq (stc-trusted? (stc-q-unknown) 1) 1) 128))
    ; two known and one unknown -> the body serves two of three, 6 in tenths
    (defn stc-suff ()
        (stck (eq (stc-sufficiency-x10 (list (stc-q-known) (stc-q-insonation) (stc-q-unknown))) 6) 256))
    (defn serve-the-core-check ()
        (add (add (add (stc-known-self) (stc-known-body)) (add (stc-known-free) (stc-inson-self)))
        (add (add (add (stc-unk-rent) (stc-unk-cost)) (add (stc-unk-untrusted) (stc-unk-deposited)))
             (stc-suff))))
)
