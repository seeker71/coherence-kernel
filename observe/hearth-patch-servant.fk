; hearth-patch-servant.fk — the hearth's second organ, same binary: a
; form-cli servant that serves kind=repo-patch task frames from the
; shared spool. Discipline mirrors the guarded farp law: append-only
; INTENT (exact preimage span + proposal) journaled and read back
; before any write; apply; readback verify; TERMINAL journaled; on any
; mismatch nothing is written and the reply is a typed refusal. Full
; farp authority-grant integration is the named next; this servant is
; its transport-facing porch.
; task field grammar: path|find|replace   (find must occur exactly once)
; stdin line 1: max turns to serve (0 = drain once).
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/spool-bell-transport.fk
(do
    (defn hps-line-end (s i) (if (ge i (str_len s)) i (if (eq (ord (char_at s i)) 10) i (hps-line-end s (add i 1)))))
    (defn hps-line-field (s name)
        (do (let marker (str_concat name "="))
            (let at (str_find s marker 0))
            (if (lt at 0) ""
                (substring s (add at (str_len marker)) (hps-line-end s (add at (str_len marker)))))))
    (defn hps-split3 (s)
        (do (let a (str_find s "|" 0))
            (let b (str_find s "|" (add a 1)))
            (list (substring s 0 a) (substring s (add a 1) b) (substring s (add b 1) (str_len s)))))
    (defn hps-count (text needle) (gl-count-of text needle))
    (defn hps-reply (turn status detail)
        (sbt-append (hearth-reply)
            (str_concat "turn=" (str_concat (int_to_str turn)
            (str_concat "\nroute=repo-patch\nsignal=" (str_concat status
            (str_concat "\n" (str_concat detail "\n"))))))))
    (defn hps-journal (kind turn detail)
        (sbt-append ".hearth/patch-journal"
            (gl-ledger-line kind (now_unix_ms) (str_concat "turn=" (str_concat (int_to_str turn) (str_concat " " detail))))))
    (defn hps-apply (turn spec)
        (do (let parts (hps-split3 spec))
            (let path (nth parts 0))
            (let find (nth parts 1))
            (let repl (nth parts 2))
            (let text (read_file path))
            (if (eq (str_len text) 0)
                (do (let j (hps-journal "refuse" turn "empty-or-missing-file")) (hps-reply turn "nothing" "reason=empty-or-missing-file"))
            (if (not (eq (hps-count text find) 1))
                (do (let j (hps-journal "refuse" turn (str_concat "find-count=" (int_to_str (hps-count text find))))) (hps-reply turn "choice" "reason=find-not-unique"))
                (do
                    (let at (str_find text find 0))
                    (let j1 (hps-journal "intent" turn (str_concat path (str_concat " at=" (str_concat (int_to_str at) (str_concat " old-len=" (int_to_str (str_len find))))))))
                    (let jr (read_file ".hearth/patch-journal"))
                    (if (lt (str_find jr "intent" 0) 0)
                        (hps-reply turn "nothing" "reason=journal-unreadable")
                        (do
                            (let out (str_concat (substring text 0 at) (str_concat repl (substring text (add at (str_len find)) (str_len text)))))
                            (let w (write_file_text path out))
                            (let back (read_file path))
                            (if (not (eq (hps-count back repl) (add (hps-count text repl) 1)))
                                (do (let j2 (hps-journal "undo" turn "readback-mismatch")) (let u (write_file_text path text)) (hps-reply turn "nothing" "reason=readback-mismatch-undone"))
                                (do (let j3 (hps-journal "applied" turn path))
                                    (hps-reply turn "applied" (str_concat "path=" path)))))))))))
    (defn hps-last-turn-go (frames at from best)
        (do (let f (str_find frames "turn=" from))
            (if (or (lt f 0) (ge f at)) best (hps-last-turn-go frames at (add f 5) (fmv-field-int frames (add f 5) 0 0)))))
    (defn hps-last-turn (frames at) (hps-last-turn-go frames at 0 (sub 0 1)))
    (defn hps-serve-loop (frames done)
        (do (let at (str_find frames "kind=repo-patch" 0))
            (if (lt at 0) done
                (do
                    (let seg (substring frames at (str_len frames)))
                    (let turn2 (hps-last-turn frames at))
                    (let spec (hps-line-field seg "task"))
                    (let served (read_file (hearth-reply)))
                    (if (ge (str_find served (str_concat "turn=" (int_to_str turn2)) 0) 0)
                        (hps-serve-loop (substring seg 15 (str_len seg)) done)
                        (do (let r (hps-apply turn2 spec))
                            (hps-serve-loop (substring seg 15 (str_len seg)) (add done 1))))))))
    (let maxn (str_to_int (read_line)))
    (let frames (read_file (hearth-task)))
    (let n (hps-serve-loop frames 0))
    (print (str_concat "patches-served=" (int_to_str n)))
    0)
