; preludes: form/form-stdlib/bml/wall-census.bml form/form-stdlib/line-grammar.fk
;
; wall-census-run — every limit this body has written down, and whether anyone ran it.
; stdin line 1 names the root to walk (default: the whole tree).
;
; The question is never "is this limit true" — the lens cannot know that. It is the one
; question that separates a measurement from a sentence: does it carry a witness?
(do
    (defn wr-trim (s) (if (nothing? s) "" (trim s)))
    (let root0 (wr-trim (read_line)))
    (let root (if (eq (str_len root0) 0) "." root0))
    (let t0 (now_unix_ms))
    (let ps (wln-files root (list)))
    (let rs (wln-walk ps (list)))
    (let bare (wln-bare rs (list)))
    (let t1 (now_unix_ms))
    (print_str (str_concat "walked " (str_concat root (str_concat "  files " (str_concat (int_to_str (len ps)) (str_concat "  ms " (int_to_str (sub t1 t0))))))))
    (print_str (str_concat "limits written down: " (str_concat (int_to_str (len rs))
               (str_concat "   with a witness beside them: " (str_concat (int_to_str (wln-count-wit rs))
               (str_concat "   with none: " (int_to_str (len bare))))))))
    (print_str "")
    (print_str "the ones nobody has pushed:")
    (wln-say bare 20)
    (len bare))
