; qmx-resident-answer-live-run.fk — the live door: one request token crosses to
; a resident lookup and a resident answer, and prints every stage transition.
;
; WHAT THIS RUNS AGAINST. An ALREADY-RUNNING server on 127.0.0.1:8080. This cell
; launches nothing and owns no model. If the peer is absent the ask and answer
; stages report `nothing` and the earlier stages keep their observations, which
; is the point of printing the transitions rather than a verdict.
;
;   ./fkwu observe/qmx-resident-answer-live-run.fk
;
; It writes a small typed index into the host temp directory, crosses once, and
; removes the fixture. No model is loaded here, no Metal or MLX is opened, and
; no logit performs the retrieval — the body looks the answer up and the
; resident peer is asked to speak only from what the body found.
;
; preludes: form-stdlib/form-knowledge-query-memory-resident.fk

(do
    (defn qral-host () "127.0.0.1")
    (defn qral-port () 8080)
    (defn qral-predict () 320)

    (defn qral-bytes-loop (s i n out)
        (if (ge i n) out (qral-bytes-loop s (add i 1) n (cons (str-byte-at s i) out))))
    (defn qral-rev (xs out)
        (if (eq (len xs) 0) out (qral-rev (tail xs) (cons (head xs) out))))
    (defn qral-bytes (s) (qral-rev (qral-bytes-loop s 0 (str_len s) (empty)) (empty)))
    (defn qral-sha (s) (hex-encode (sha256-stream-string s)))

    ; the answer the index holds, and the question that should reach it
    (defn qral-answer ()
        "Kernel deployment is live and verified by current production evidence.")
    (defn qral-question ()
        "Is the kernel deployment verified? Answer in one short clause.")
    (defn qral-anchor () "deployed proof kernel")

    (defn qral-index-line ()
        (ric-emit-grounded "@1.1.9.41" "@8.4.4.12" "docs/deployment.form" "cell"
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            (hex-encode (sha256 (qral-bytes (qral-answer))))
            (hex-encode (qral-bytes (qral-answer)))
            (qral-answer)
            (re-semantic-vec
                "deployment evidence kernel production verified witness")))

    ; one builder, one request, built from data — no registry, no defn per memory
    (defn qral-offer ()
        (intern_node (fkqmx-offer-category)
            (list (intern_trivial_string (fkqmx-offer-schema))
                  (intern_trivial_string "live-source")
                  (intern_trivial_string
                      (str_concat (fkqmx-open-mark)
                          (str_concat (qral-anchor) (fkqmx-close-mark))))
                  (intern_trivial_string (qral-sha (qral-anchor))))))
    (defn qral-mem (tag)
        (intern_node (make_nodeid 31 2 0 127) (list (intern_trivial_string tag))))
    (defn qral-request ()
        (do (let m (qral-mem "live-m"))
            (let b (qral-mem "live-b"))
            (let r (intern_node (fkqmrt-recipe-category)
                (list (intern_trivial_string (fkqmrt-recipe-schema))
                      m b (qral-offer)
                      (intern_trivial_string (qral-sha "live-q"))
                      (intern_trivial_string (qral-sha "live-src"))
                      (intern_trivial_string (qral-sha "live-pres"))
                      (intern_trivial_string (qral-sha "live-query"))
                      (intern_trivial_string "live")
                      (intern_trivial_string "live-lane")
                      (intern_trivial_int 1) (intern_trivial_int 1)
                      (intern_trivial_int 0) (intern_trivial_int 0)
                      (intern_trivial_int 0) (intern_trivial_int 0))))
            (intern_node (fkqmrt-request-category)
                (list (intern_trivial_string (fkqmrt-request-schema))
                      (fkqmrt-action-node) r m b
                      (intern_trivial_string "live")
                      (intern_trivial_string "live-lane")
                      (intern_trivial_int 0) (intern_trivial_int 1)))))

    (defn qral-clip (s n) (if (le (str_len s) n) s (substring s 0 n)))
    (defn qral-line (a b) (print_str (str_concat a (str_concat b "\n"))))

    (defn qral-show (frames i)
        (if (ge i (len frames)) 0
            (do (let f (nth frames i))
                (qral-line
                    (str_concat "  " (str_concat (fqmr-frame-stage f)
                        (str_concat " -> " (fqmr-frame-state f))))
                    (str_concat "   " (qral-clip (fqmr-frame-detail f) 96)))
                (qral-show frames (add i 1)))))

    (defn qral-run ()
        (do
            (let path (str_concat (temp_dir) "/qmx-resident-answer-live.jsonl"))
            (let wrote (write_file path (qral-index-line)))
            (qral-line "index-bytes=" (int_to_str wrote))
            (qral-line "peer=" (str_concat (qral-host)
                (str_concat ":" (int_to_str (qral-port)))))
            (let frames (fqmr-cross path (qral-request) (qral-question)
                            (qral-host) (qral-port) (qral-predict)))
            (qral-line "stages=" (int_to_str (len frames)))
            (qral-show frames 0)
            (let answer (fqmr-answer-of frames))
            (qral-line "answer-present=" (if (nothing? answer) "nothing" "1"))
            (qral-line "answer=" (if (nothing? answer) "" answer))
            (qral-line "model-executed=" (int_to_str (fqmr-model-executed)))
            (let cleaned (fs_remove path))
            (qral-line "fixture-removed=" (if (eq cleaned 0) "1" "0"))
            (if (nothing? answer) 0 1)))

    (qral-run))
