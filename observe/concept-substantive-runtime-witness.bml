// Execute the actual generated Form authorities against independently read evidence.
// preludes: form-stdlib/bml/concept-substantive-builder.bml model/concept-10000-substantive-repair-data.fk cognition/concept-10000-substantive-repair-111-nl-data.fk
section [form.bml] {
 class SubstantiveGeneratedRuntime {
  def csbr-assert(ok,aspect) = if ok then 1 else form_error(str_concat("generated substantive runtime refused: ",aspect));
  def csbr-evidence(rows,state,ids,ranks) {
   if nil?(rows) then list(reverse(ids),reverse(ranks)) else csbr-row(parse-json("independent-runtime-evidence",head(rows)),tail(rows),state,ids,ranks);
  }
  def csbr-row(row,rest,state,ids,ranks) {
   let id = csb-num(row,"id"); let rank = csb-num(row,"sourceRank");
   record_set(state,int_to_str(id),rank);
   csbr-evidence(rest,state,cons(id,ids),cons(rank,ranks));
  }
  def csbr-list(left,right) = if nil?(left) then nil?(right) else if nil?(right) then 0 else and(eq(head(left),head(right)),csbr-list(tail(left),tail(right)));
  def csbr-id(state,id) {
   if eq(id,10000) then id else csbr-id-value(state,id,record_get(state,int_to_str(id)));
  }
  def csbr-id-value(state,id,rank) {
   let present = gt(rank,10000); let current = add(id,1);
   csbr-assert(and(eq(csr111-repaired-id?(id),present),eq(csr111-effective-rank(id,current),if present then rank else current)),"complete-rank-and-repair-query");
   csbr-id(state,add(id,1));
  }
  def csbr-boundaries(ids) = if nil?(ids) then 1 else if and(eq(csr111-repaired-id?(head(ids)),0),eq(csr111-effective-rank(head(ids),-777),-777)) then csbr-boundaries(tail(ids)) else csbr-assert(0,"outside-stable-id-domain");
  def csbr-offsets(bytes,values,previous,count) {
   if nil?(values) then if eq(previous,str_len(bytes)) then count else csbr-assert(0,"complete-overlay-offsets") else csbr-offset(bytes,values,previous,count,str_find(bytes,"\n",previous));
  }
  def csbr-offset(bytes,values,previous,count,newline) {
   csbr-assert(and(ge(newline,previous),eq(head(values),add(newline,1))),"exact-overlay-row-boundary");
   csbr-offsets(bytes,tail(values),head(values),add(count,1));
  }
  def csbr-run() {
   let root = ".";
   let state = record_new(0);
   let expected = csbr-evidence(tail(csa-lines(read_file(fs-path-join(root,csb-path("-evidence.jsonl"))))),state,list(),list());
   csbr-assert(and(eq(csr111-count(),111),and(csbr-list(csr111-ids(),head(expected)),csbr-list(csr111-source-ranks(),nth(expected,1)))),"complete-generated-id-and-rank-lists");
   let queried = csbr-id(state,0);
   csbr-boundaries(list(-1,10000,999999));
   csbr-assert(and(str_eq(csr111-alias-index-path(),csb-path("-alias-index.dat")),and(str_eq(csr111-semantic-index-path(),csb-path("-semantic-index.dat")),and(str_eq(csr111-semantic-payload-path(),csb-path("-semantic-payload.dat")),and(str_eq(csr111-migration-path(),csb-path("-migration.tsv")),and(str_eq(csr111-evidence-path(),csb-path("-evidence.jsonl")),and(str_eq(csr111-nl-data-path(),csb-nl(".tsv")),str_eq(csr111-nl-sources-path(),csb-nl("-sources.dat")))))))),"all-generated-path-doors");
   let offsets = csr111-nl-offsets();
   csbr-assert(and(eq(len(offsets),112),eq(head(offsets),0)),"overlay-zero-and-cardinality");
   let count = csbr-offsets(read_file(fs-path-join(root,csb-nl(".tsv"))),tail(offsets),0,1);
   print(list("generated-runtime","queried-ids",queried,"boundary-ids",3,"overlay-offsets",count,"rank-list",len(head(expected))));
   csbr-assert(and(eq(queried,10000),eq(count,112)),"complete-runtime");
  }
 }
 csbr-run();
}
