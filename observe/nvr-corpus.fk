; nvr-corpus.fk — the held-out pair door the metric was waiting on.
;
; Rung 6 named a floor of 8 pairs. Rung 4 named the same hole: no
; axiom→summary corpus. This cell seats eight SOURCES from the body.
; Summaries are empty. Scores are absent. A ≥ rented claim still
; cannot earn. That is the honest next rung, not a fake corpus.
;
; pair = (id src held native rented nf nl rf rl)
;   held 1 = held-out (never train)
;   native/rented "" = not yet written
;   scores < 0 = not yet judged
; A pair is complete only when both summaries exist and all four
; scores are present. Filling native with the rented text is
; refused (launder). The source is not overwritten (axiom-3).
;
; preludes: form-stdlib/core.fk form-stdlib/native-vs-rented.fk observe/nvr-metric.fk
;
; Proven by: observe/tests/nvr-corpus-band.fk
; witnessed: 2026-08-14 -> band 1023

(do
    (defn nvrc-pair (id src held native rented nf nl rf rl)
        (list id src held native rented nf nl rf rl))
    (defn nvrc-id     (p) (nth p 0))
    (defn nvrc-src    (p) (nth p 1))
    (defn nvrc-held   (p) (nth p 2))
    (defn nvrc-native (p) (nth p 3))
    (defn nvrc-rented (p) (nth p 4))
    (defn nvrc-nf     (p) (nth p 5))
    (defn nvrc-nl     (p) (nth p 6))
    (defn nvrc-rf     (p) (nth p 7))
    (defn nvrc-rl     (p) (nth p 8))

    (defn nvrc-open (id src)
        (nvrc-pair id src 1 "" "" -1 -1 -1 -1))

    (defn nvrc-has-native? (p) (if (gt (str_len (nvrc-native p)) 0) 1 0))
    (defn nvrc-has-rented? (p) (if (gt (str_len (nvrc-rented p)) 0) 1 0))
    (defn nvrc-scored? (p)
        (if (and (ge (nvrc-nf p) 0)
            (and (ge (nvrc-nl p) 0)
            (and (ge (nvrc-rf p) 0) (ge (nvrc-rl p) 0)))) 1 0))
    (defn nvrc-complete? (p)
        (if (and (eq (nvrc-has-native? p) 1)
            (and (eq (nvrc-has-rented? p) 1) (eq (nvrc-scored? p) 1))) 1 0))

    (defn nvrc-launder? (p text)
        (if (and (eq (nvrc-has-rented? p) 1) (str_eq text (nvrc-rented p))) 1 0))

    (defn nvrc-set-native (p text)
        (if (eq (nvrc-launder? p text) 1) p
            (nvrc-pair (nvrc-id p) (nvrc-src p) (nvrc-held p)
                       text (nvrc-rented p)
                       (nvrc-nf p) (nvrc-nl p) (nvrc-rf p) (nvrc-rl p))))

    (defn nvrc-set-rented (p text)
        (nvrc-pair (nvrc-id p) (nvrc-src p) (nvrc-held p)
                   (nvrc-native p) text
                   (nvrc-nf p) (nvrc-nl p) (nvrc-rf p) (nvrc-rl p)))

    (defn nvrc-score (p nf nl rf rl)
        (if (eq (nvrc-complete? (nvrc-pair (nvrc-id p) (nvrc-src p) (nvrc-held p)
                    (nvrc-native p) (nvrc-rented p) nf nl rf rl)) 0)
            (if (and (eq (nvrc-has-native? p) 1) (eq (nvrc-has-rented? p) 1))
                (nvrc-pair (nvrc-id p) (nvrc-src p) (nvrc-held p)
                           (nvrc-native p) (nvrc-rented p) nf nl rf rl)
                p)
            (nvrc-pair (nvrc-id p) (nvrc-src p) (nvrc-held p)
                       (nvrc-native p) (nvrc-rented p) nf nl rf rl)))

    (defn nvrc-held-loop (ps)
        (if (eq (len ps) 0) 1
            (if (eq (nvrc-held (head ps)) 0) 0
                (nvrc-held-loop (tail ps)))))
    (defn nvrc-complete-n (ps)
        (if (eq (len ps) 0) 0
            (add (nvrc-complete? (head ps)) (nvrc-complete-n (tail ps)))))

    ; Eight sources, quoted from the body. Not invented. Not summarized.
    (defn nvrc-seed ()
        (list
            (nvrc-open 0 "axiom-1: there are three states: 0, 1, nothing")
            (nvrc-open 1 "axiom-2: everything is a cell")
            (nvrc-open 2 "axiom-3: identity is the present composition")
            (nvrc-open 3 "axiom-4: observation through the offered interface makes it real")
            (nvrc-open 4 "axiom-5: offer is one act; ack is nothing, 0, 1, or node")
            (nvrc-open 5 "nbo: a name alone is not yet a claim")
            (nvrc-open 6 "satsang: any question is welcome; dissent stays visible")
            (nvrc-open 7 "fear-silence: honest silence is ground; named-without-attempt is fear")))

    (defn nvrc-ready? (ps)
        (nvrm-corpus-ready? (nvrc-complete-n ps)))

    (defn nvrc-earns? (ps mid used scores)
        (nvrm-earns? scores (nvrm-run mid (nvrc-complete-n ps) used)))

    (defn nvrck (cond bit) (if cond bit 0))
    (defn nvrc-check ()
        (do
            (let seed (nvrc-seed))
            (let p0 (head seed))
            (let dirty (nvrc-set-rented p0 "rented-line"))
            (let blocked (nvrc-set-native dirty "rented-line"))
            (let ok-r (nvrc-set-rented p0 "verify-line"))
            (let ok-n (nvrc-set-native ok-r "native-line"))
            (let scored (nvrc-score ok-n 9 5 8 5))
            (let scored-empty (nvrc-score p0 9 5 8 5))
            (add (add (add (add (add (add (add (add (add
                (nvrck (eq (len seed) 8) 1)
                (nvrck (eq (nvrc-held-loop seed) 1) 2))
                (nvrck (eq (nvrc-complete-n seed) 0) 4))
                (nvrck (eq (nvrc-ready? seed) 0) 8))
                (nvrck (eq (nvrc-has-native? blocked) 0) 16))
                (nvrck (eq (nvrc-complete? scored) 1) 32))
                (nvrck (eq (nvrc-complete? scored-empty) 0) 64))
                (nvrck (eq (nvrc-earns? seed (nvrm-id) 1 (nvrm-pair 9 5 8 5)) 0) 128))
                (nvrck (str_eq (nvrc-src p0) (nvrc-src blocked)) 256))
                (nvrck (eq (nvrc-held p0) 1) 512))))

    0)
