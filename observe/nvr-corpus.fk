// nvr-corpus.fk — the held-out pair door the metric was waiting on.
//
// Rung 6 named a floor of 8 pairs. Rung 4 named the same hole: no
// axiom→summary corpus. This cell seats eight SOURCES from the body.
// Summaries are empty. Scores are absent. A ≥ rented claim still
// cannot earn. That is the honest next rung, not a fake corpus.
//
// pair = (id src held native rented nf nl rf rl)
//   held 1 = held-out (never train)
//   native/rented "" = not yet written
//   scores < 0 = not yet judged
// A pair is complete only when both summaries exist and all four
// scores are present. Filling native with the rented text is
// refused (launder). The source is not overwritten (axiom-3).
//
import form-stdlib/core.fk;
import form-stdlib/native-vs-rented.fk;
import observe/nvr-metric.fk;
//
// Proven by: observe/tests/nvr-corpus-band.fk
// witnessed: 2026-08-14 -> band 1023
section [form.bml] {
    def nvrc-pair(id, src, held, native, rented, nf, nl, rf, rl) = [id, src, held, native, rented, nf, nl, rf, rl];
    def nvrc-id(p) = p[0];
    def nvrc-src(p) = p[1];
    def nvrc-held(p) = p[2];
    def nvrc-native(p) = p[3];
    def nvrc-rented(p) = p[4];
    def nvrc-nf(p) = p[5];
    def nvrc-nl(p) = p[6];
    def nvrc-rf(p) = p[7];
    def nvrc-rl(p) = p[8];
    def nvrc-open(id, src) = nvrc-pair(id, src, 1, "", "", -1, -1, -1, -1);
    def nvrc-has-native?(p) = len(nvrc-native(p)) > 0 ? 1 : 0;
    def nvrc-has-rented?(p) = len(nvrc-rented(p)) > 0 ? 1 : 0;
    def nvrc-scored?(p) = nvrc-nf(p) >= 0 && (nvrc-nl(p) >= 0 && (nvrc-rf(p) >= 0 && nvrc-rl(p) >= 0)) ? 1 : 0;
    def nvrc-complete?(p) = (Comparable) nvrc-has-native?(p) == 1 && ((Comparable) nvrc-has-rented?(p) == 1 && (Comparable) nvrc-scored?(p) == 1) ? 1 : 0;
    def nvrc-launder?(p, text) = (Comparable) nvrc-has-rented?(p) == 1 && (String) text == nvrc-rented(p) ? 1 : 0;
    def nvrc-set-native(p, text) = (Comparable) nvrc-launder?(p, text) == 1 ? p : nvrc-pair(nvrc-id(p), nvrc-src(p), nvrc-held(p), text, nvrc-rented(p), nvrc-nf(p), nvrc-nl(p), nvrc-rf(p), nvrc-rl(p));
    def nvrc-set-rented(p, text) = nvrc-pair(nvrc-id(p), nvrc-src(p), nvrc-held(p), nvrc-native(p), text, nvrc-nf(p), nvrc-nl(p), nvrc-rf(p), nvrc-rl(p));
    def nvrc-score(p, nf, nl, rf, rl) = (Comparable) nvrc-complete?(nvrc-pair(nvrc-id(p), nvrc-src(p), nvrc-held(p), nvrc-native(p), nvrc-rented(p), nf, nl, rf, rl)) == 0 ? (Comparable) nvrc-has-native?(p) == 1 && (Comparable) nvrc-has-rented?(p) == 1 ? nvrc-pair(nvrc-id(p), nvrc-src(p), nvrc-held(p), nvrc-native(p), nvrc-rented(p), nf, nl, rf, rl) : p : nvrc-pair(nvrc-id(p), nvrc-src(p), nvrc-held(p), nvrc-native(p), nvrc-rented(p), nf, nl, rf, rl);
    def nvrc-held-loop(ps) = (Comparable) len(ps) == 0 ? 1 : (Comparable) nvrc-held(ps[0]) == 0 ? 0 : nvrc-held-loop(ps[1:]);
    def nvrc-complete-n(ps) = (Comparable) len(ps) == 0 ? 0 : (Number) nvrc-complete?(ps[0]) + (Number) nvrc-complete-n(ps[1:]);
    // Eight sources, quoted from the body. Not invented. Not summarized.
    def nvrc-seed() = [nvrc-open(0, "axiom-1: there are three states: 0, 1, nothing"), nvrc-open(1, "axiom-2: everything is a cell"), nvrc-open(2, "axiom-3: identity is the present composition"), nvrc-open(3, "axiom-4: observation through the offered interface makes it real"), nvrc-open(4, "axiom-5: offer is one act; ack is nothing, 0, 1, or node"), nvrc-open(5, "nbo: a name alone is not yet a claim"), nvrc-open(6, "satsang: any question is welcome; dissent stays visible"), nvrc-open(7, "fear-silence: honest silence is ground; named-without-attempt is fear")];
    def nvrc-ready?(ps) = nvrm-corpus-ready?(nvrc-complete-n(ps));
    def nvrc-earns?(ps, mid, used, scores) = nvrm-earns?(scores, nvrm-run(mid, nvrc-complete-n(ps), used));
    def nvrck(cond, bit) = cond ? bit : 0;
    def nvrc-check() = {
        let seed = nvrc-seed();
        let p0 = seed[0];
        let dirty = nvrc-set-rented(p0, "rented-line");
        let blocked = nvrc-set-native(dirty, "rented-line");
        let ok-r = nvrc-set-rented(p0, "verify-line");
        let ok-n = nvrc-set-native(ok-r, "native-line");
        let scored = nvrc-score(ok-n, 9, 5, 8, 5);
        let scored-empty = nvrc-score(p0, 9, 5, 8, 5);
        (Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) nvrck((Comparable) len(seed) == 8, 1) + (Number) nvrck((Comparable) nvrc-held-loop(seed) == 1, 2)) + (Number) nvrck((Comparable) nvrc-complete-n(seed) == 0, 4)) + (Number) nvrck((Comparable) nvrc-ready?(seed) == 0, 8)) + (Number) nvrck((Comparable) nvrc-has-native?(blocked) == 0, 16)) + (Number) nvrck((Comparable) nvrc-complete?(scored) == 1, 32)) + (Number) nvrck((Comparable) nvrc-complete?(scored-empty) == 0, 64)) + (Number) nvrck((Comparable) nvrc-earns?(seed, nvrm-id(), 1, nvrm-pair(9, 5, 8, 5)) == 0, 128)) + (Number) nvrck((String) nvrc-src(p0) == nvrc-src(blocked), 256)) + (Number) nvrck((Comparable) nvrc-held(p0) == 1, 512);
    };
    0;
}
