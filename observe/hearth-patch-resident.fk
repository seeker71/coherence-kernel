; hearth-patch-resident.fk — the patch servant, standing: each beat runs
; the guarded one-shot servant over the shared task spool (intent
; journal, readback, apply, readback-verify, typed refusal on any
; mismatch), ledgers any patches served, and rests a breath. With this
; door open, the field serves tree changes as well as answers: any
; agent appends a kind=repo-patch frame (task = path|find|replace,
; find unique) and rings the bell.
; stdin line 1: number of beats.
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/spool-bell-transport.fk
(do
    (defn hpr-ledger (kind detail)
        (sbt-append (hearth-ledger) (gl-ledger-line kind (now_unix_ms) detail)))
    (defn hpr-beat (n tick)
        (if (gt tick n) 0
            (do (let out (host-exec "printf '99\\n' | ./fkwu observe/hearth-patch-servant.fk" ""))
                (let served (fmv-field out "patches-served"))
                (let e (if (gt served 0)
                    (hpr-ledger "patch" (str_concat "served=" (int_to_str served))) 0))
                (let z (host-exec "sleep 5" ""))
                (hpr-beat n (add tick 1)))))
    (let n (str_to_int (read_line)))
    (let born (hpr-ledger "patch-resident-on" (str_concat "beats=" (int_to_str n))))
    (hpr-beat n 1))
