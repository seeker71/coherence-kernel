; form-homecoming-turn-live.fk — local Qwen speaks the native integers.
; One generate, remote absent. Not a sealed row. Play.
;
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let obs "native ki-deep? 3=1 1=0 ; native ec-cells2 same=1 different=2")
    (let prompt
        (str_concat "The body already ran Form. Observation: "
            (str_concat obs
                ". Reply with exactly: HOME then those integers. Nothing else.")))
    (let t0 (now_unix_ms))
    (let out (fcmg-generate path prompt 32))
    (let t1 (now_unix_ms))
    (print_str (str_concat "homecoming_wall_ms=" (str_concat (int_to_str (sub t1 t0)) "\n")))
    (print_str (str_concat "homecoming_has_HOME="
        (str_concat (int_to_str (if (ge (str_find out "HOME" 0) 0) 1 0)) "\n")))
    (print_str (str_concat "homecoming_has_1="
        (str_concat (int_to_str (if (ge (str_find out "1" 0) 0) 1 0)) "\n")))
    (print out)
    0)
