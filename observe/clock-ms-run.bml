//////////////////////////////////////////////////////////////////////
//
// clock-ms-run.bml — the body's wall clock for a shell carrier.
//
// One line: now, in unix milliseconds. A carrier times a host step by
// reading this door before and after it; the difference is integer
// arithmetic the shell carries itself, so nothing but the body stands
// between the clock and the number.
//
//   ./fkwu observe/clock-ms-run.bml
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    now_unix_ms();
}
