// glass-read-run.bml — what the glass sees, as text: every publisher in the live telemetry space, how long ago it last
// gave, and its samples with identity, state, scope and evidence. Readability is not liveness. The glass window and its organs read these same frames; this
// door lets the rented mind and the voice read them too, while a lane works, instead of a ledger afterwards.
// stdin, optional: one line, a publisher prefix to keep (qwen.coding keeps the voice's coding lanes); empty keeps all.
// preludes: form-stdlib/hearth.bml form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/form-glass-dashboard.bml form-stdlib/bml/rented-work.bml form-stdlib/form-glass-sensor-rows.bml
section [form.bml] {
 class GlassRead {
  def gr-field(f) = (String) value_kind(f) == "list" && len(f) == 3 && (String) value_kind(f[0]) == "string" && (String) f[0] == "glass-field-v1" ? (f[1] == 1 ? value_str(f[2]) : "-") : value_str(f);
  def gr-sample(s) = fgd-cat(["\n  id=", fgtm-sample-id(s), " kind=", fgtm-sample-kind(s), " reported-state=", fgtm-sample-lifecycle(s),
   "\n    owner=", fgtm-sample-owner(s), " lane=", fgtm-sample-lane(s), " purpose=", fgtm-sample-purpose(s),
   "\n    value=", gr-field(fgtm-sample-capacity(s)), " bytes=", gr-field(fgtm-sample-bytes(s)), " plane=", fgtm-sample-plane(s), " parent=", gr-field(fgtm-sample-parent(s)),
   "\n    reported-evidence=", fgtm-sample-evidence(s), " source=", fgtm-sample-source(s), " read-epoch=", gr-field(fgtm-sample-read-epoch(s)), " write-epoch=", gr-field(fgtm-sample-write-epoch(s)),
   "\n    selector=", fgtm-sample-selection-id(s), " channels=", value_str(fgtm-sample-channels(s)),
   if ((String) fgtm-sample-kind(s) == "work-session") && rw-activity?(fgtm-sample-cell(s)) then ("\n    public-activity=" + value_str(fgtm-sample-cell(s))) else if ((String) fgtm-sample-lane(s) == "care") && fgsr-care-cell?(fgtm-sample-cell(s)) then ("\n    public-care=" + jv-emit(fgtm-sample-cell(s)[1]) + " source-state=" + fgtm-sample-cell(s)[2] + " evidence-source=" + fgtm-sample-cell(s)[3] + " care-state=" + fgtm-sample-cell(s)[4]) else ""]);
  def gr-samples(xs) = foldl((acc, s) => acc + gr-sample(s), "", xs);
  def gr-frame(root, row, now) {
   let read = fgtm-read-current(root, row[0]);
   let head = fgd-cat(["publisher=", row[0], " last-published=", fgd-format-age-ms(fgtm-read-age(read, now)), " ago transport=", read[2], " (readable does not prove a live owner)"]);
   (String) read[2] != "current" ? head : head + "\n    shared-root=" + value_str(fgtm-read-root-id(read)) + " publication-ownership=" + value_str(fgtm-read-ownership(read)) + gr-samples(fgtm-snapshot-samples(fgtm-field-value(read[3])));
  }
  def gr-kept?(row, want) = fgtm-control-frame-name?(row[0]) == 0 && ((String) want == "" || str_find(row[0], want, 0) == 0);
 }
 let want = trim(read_line() ?? "");
 let root = hearth-telemetry-root();
 let now = now_unix_ms();
 let rows = filter(r => gr-kept?(r, want), fgtm-spoken-in-space(gift_roster_names(), root));
 print_str(nil?(rows) ? "glass: no publisher" + ((String) want == "" ? "" : " under " + want) + " in " + root + "\n" : foldl((acc, r) => acc + gr-frame(root, r, now) + "\n", "", rows));
 0;
}
