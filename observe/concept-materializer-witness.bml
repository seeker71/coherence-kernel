// Actual publication and release under an owned private canonical source tree.
// preludes: form-stdlib/bml/concept-materializer.bml form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class ConceptMaterializerWitness {
  def cmw-owner() = "form-stdlib/bml/concept-materializer.bml";
  def cmw-q(text) = json-emit-precise(json-node-string(text));
  def cmw-put(path,text) = if and(eq(write_file(path,text),str_len(text)),str_eq(read_file(path),text)) then path else form_error("materializer witness write refused");
  def cmw-child(job,name,preludes,body) {
   let path = cmw-put(nsi-path(job,str_concat(name,".bml")),str_concat("// preludes: ",str_concat(preludes,str_concat("\nsection [form.bml] {\n",str_concat(body,"\n}\n")))));
   nsi-capture(list("./fkwu",path));
  }
  def cmw-rows(text) = cmw-parse-rows(split-on(text,"\n"),list());
  def cmw-parse-rows(lines,rows) {
   if nil?(lines) then reverse(rows) else cmw-parse-line(head(lines),tail(lines),rows);
  }
  def cmw-parse-line(line,rest,rows) {
   let prefix = "form-organ health ";
   if str_eq(substring(line,0,str_len(prefix)),prefix) then cmw-parse-rows(rest,cons(parse-json("materializer-health",substring(line,str_len(prefix),str_len(line))),rows)) else cmw-parse-rows(rest,rows);
  }
  def cmw-aspect(rows,aspect,stage) = if nil?(rows) then nothing() else if and(str_eq(oh-str(head(rows),"aspect"),aspect),str_eq(oh-str(head(rows),"stage"),stage)) then head(rows) else cmw-aspect(tail(rows),aspect,stage);
  def cmw-refusal(capture,aspect,published) {
   let rows = cmw-rows(nsi-text(capture));
   let reading = cmw-aspect(rows,aspect,"observe");
   let response = cmw-aspect(rows,aspect,"response");
   let applied = cmw-aspect(rows,aspect,"applied");
   let after = cmw-aspect(rows,"private-stages-after-refusal","observe");
   and(eq(nsi-status(capture),1),and(not(nothing?(reading)),and(str_eq(oh-select(reading,response,"unbound"),"release-private-stages"),and(str_eq(oh-str(reading,"id"),oh-str(applied,"id")),and(eq(json-int-value(oh-get(applied,"result")),1),and(eq(json-int-value(oh-get(after,"health")),1),eq(json-int-value(oh-get(after,"evidence")),published)))))));
  }
  def cmw-copy(input,root,paths) {
   if nil?(paths) then 1 else cmw-copy-next(input,root,head(paths),tail(paths));
  }
  def cmw-copy-next(input,root,path,rest) {
   let target = fs-path-join(root,path);
   fs_mkdir(fs-path-dirname(target));
   cmw-put(target,csa-file(input,path));
   cmw-copy(input,root,rest);
  }
  def cmw-output-equal(root,outputs) = if nil?(outputs) then 1 else and(str_eq(read_file(fs-path-join(root,head(head(outputs)))),nth(head(outputs),1)),cmw-output-equal(root,tail(outputs)));
  def cmw-artifact-runtime(job,name,root) = cmw-child(job,name,str_concat(fs-path-join(root,cmm-path("-offsets.fk")),str_concat(" ",fs-path-join(root,cmm-path("-metadata.fk")))),"print(list(cnl13-offsets(),cnl13-source-meta(),cnl13-substantive-repair-meta(),cnl13-machine-source-meta(),cnl13-locale-meta-rows()));\n1;");
  def cmw-materialize(job,name,root,engine) = cmw-child(job,name,cmw-owner(),str_concat("cmm-run(",str_concat(cmw-q(root),str_concat(",",str_concat(cmw-q(engine),");")))));
  def cmw-state(root) = cmm-state(root,"arm64-sha256");
  def cmw-health(state,aspect,ok,capture) = csa-check(state,aspect,ok,nsi-evidence(capture));
  def cmw-publication-cases(state,job) {
   let branch = nsi-directory(job,"publication-",0);
   let first = cmw-put(nsi-path(branch,"first"),"old-first");
   let blocked = cmw-put(nsi-path(branch,"blocked"),"parent-is-file");
   let firstStage = nsi-path(branch,"first.stage");
   let badStage = nsi-path(blocked,"second.stage");
   let base = str_concat("let input = record_new(0,\"root\",",str_concat(cmw-q(branch),",\"observations\",0,\"owned-stages\",list(),\"published\",0);\n"));
   let stages = str_concat("let stages = list(list(",str_concat(cmw-q(first),str_concat(",",str_concat(cmw-q(firstStage),str_concat(",\"new-first\"),list(\"unused\",",str_concat(cmw-q(badStage),",\"new-second\"));\n"))))));
   let refusedStage = cmw-child(job,"stage-write-refused",cmw-owner(),str_concat(base,str_concat(stages,"cmm-stage-all(input,stages);")));
   cmw-health(state,"after-first-stage-write-refusal",and(cmw-refusal(refusedStage,"stage-write",0),and(not(fs_exists(firstStage)),and(not(fs_exists(badStage)),str_eq(read_file(first),"old-first")))),refusedStage);
   let secondStage = nsi-path(branch,"second.stage");
   let directory = nsi-path(branch,"occupied-directory");
   fs_mkdir(directory); cmw-put(nsi-path(directory,"keep"),"owned-fixture");
   let renameStages = str_concat("let stages = list(list(",str_concat(cmw-q(first),str_concat(",",str_concat(cmw-q(firstStage),str_concat(",\"new-first\"),list(",str_concat(cmw-q(directory),str_concat(",",str_concat(cmw-q(secondStage),",\"new-second\"));\n"))))))));
   let refusedRename = cmw-child(job,"second-rename-refused",cmw-owner(),str_concat(base,str_concat(renameStages,"cmm-stage-all(input,stages);\ncmm-publish-all(input,stages,0);")));
   cmw-health(state,"after-first-publication-refusal",and(cmw-refusal(refusedRename,"publish-rename",1),and(str_eq(read_file(first),"new-first"),and(not(fs_exists(firstStage)),and(not(fs_exists(secondStage)),str_eq(read_file(nsi-path(directory,"keep")),"owned-fixture"))))),refusedRename);
   2;
  }
  def cmw-stale-case(state,job,root) {
   let target = fs-path-join(root,"model/concept-10000-substantive-repair-semantic-payload.dat");
   let original = read_file(target);
   let body = str_concat("let prepared = cmm-validate(cmm-prepare(",str_concat(cmw-q(root),str_concat(",\"arm64-sha256\"));\nwrite_file(",str_concat(cmw-q(target),",\"changed after validation\");\ncmm-publish(prepared);"))));
   let refused = cmw-child(job,"changed-validation-source",cmw-owner(),body);
   let rows = cmw-rows(nsi-text(refused));
   let reading = cmw-aspect(rows,"materialize-source-still-held","observe");
   cmw-health(state,"changed-validation-dependency-refused",and(eq(nsi-status(refused),1),not(nothing?(reading))),refused);
   let care = oh-reading("concept-materializer-witness",target,"restore-owned-source",json-node-int(1),json-node-int(0),json-node-int(0),list(),list("revise"),oh-reference(nsi-path(nsi-evidence(refused),"stdout")));
   oh-voice(care); let response = oh-response(care,"revise"); oh-voice(response);
   cmw-put(target,original);
   oh-voice(oh-applied(care,oh-select(care,response,"defer"),oh-reference(target)));
   1;
  }
  def cmw-header-case(state,job,root) {
   let target = fs-path-join(root,cmm-path("-omw.tsv"));
   let original = read_file(target);
   cmw-put(target,str_concat(" \n",original));
   let refused = cmw-materialize(job,"leading-header-whitespace",root,"arm64-sha256");
   let rows = cmw-rows(nsi-text(refused));
   cmw-health(state,"exact-header-whitespace-refusal",and(eq(nsi-status(refused),1),not(nothing?(cmw-aspect(rows,"materialize-source-shapes","observe")))),refused);
   let care = oh-reading("concept-materializer-witness",target,"restore-exact-header",json-node-int(1),json-node-int(0),json-node-int(0),list(),list("revise"),oh-reference(nsi-path(nsi-evidence(refused),"stdout")));
   oh-voice(care); let response = oh-response(care,"revise"); oh-voice(response);
   cmw-put(target,original);
   oh-voice(oh-applied(care,oh-select(care,response,"defer"),oh-reference(target)));
   1;
  }
  def cmw-run() {
   let job = nsi-job(); let state = cmw-state(job);
   let before = metal_live();
   let prepared = cmm-freeze(cmm-validate(cmm-prepare(".","arm64-sha256")));
   let root = nsi-directory(job,"canonical-",0);
   cmw-copy(record_get(prepared,"input"),root,record_get(record_get(prepared,"input"),"files"));
   let currentRuntime = cmw-artifact-runtime(job,"current-artifacts",".");
   let header = cmw-header-case(state,job,root);
   let stale = cmw-stale-case(state,job,root);
   let first = cmw-materialize(job,"first-materialization",root,"arm64-sha256");
   cmw-health(state,"all-five-published-artifacts",and(nsi-ok(first),cmw-output-equal(root,record_get(prepared,"outputs"))),first);
   let generatedRuntime = cmw-artifact-runtime(job,"generated-artifacts",root);
   cmw-health(state,"all-runtime-offsets-and-metadata",and(nsi-ok(currentRuntime),and(nsi-ok(generatedRuntime),str_eq(nsi-text(currentRuntime),nsi-text(generatedRuntime)))),generatedRuntime);
   let second = cmw-materialize(job,"portable-idempotent-materialization",root,"form-sha256");
   cmw-health(state,"portable-full-idempotence",and(nsi-ok(second),cmw-output-equal(root,record_get(prepared,"outputs"))),second);
   let failures = cmw-publication-cases(state,job);
   let after = metal_live();
   csa-check(state,"materializer-cpu-resources",and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3))),"entry resource counts restored");
   print(list("concept-materializer-witness","published-artifacts",5,"runtime-offsets",10001,"locale-rows",13,"publication-refusals",failures,"source-restorations",add(stale,header),"evidence",job));
   8;
  }
 }
 cmw-run();
}
