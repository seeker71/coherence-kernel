// rows-from-json-run.bml — a foreign JSON-lines file, written once as Form rows. The body's one door that reads JSON text for it.
//
//   printf 'from receipts/form-token-eval.jsonl\nto receipts/form-token-eval.rows\n' | ./fkwu observe/rows-from-json-run.bml
//
// The Form-token loop's ledgers, events and corpus are Form rows now (form-rows.bml); this carries a JSON-lines file written
// before that (a receipts ledger, a copy from another checkout, rows another tool wrote) across, once. Every line is read as a JSON
// object (the JSON node reader of the body, parse-json), written as a Form record in the same key order, floats keeping their bits,
// and the target is written whole or not at all: a line that does not read as JSON stops the door before anything is written, and
// it says which line. `from` is read, never changed; `to` must not exist unless `append 1` is given (then the rows are added after
// what it holds). Prints one line: the rows written and the bytes.
// stdin: `from PATH`  `to PATH`  [`append 1`]   (frw-options)
// preflight-exec: forbidden
import form-stdlib/bml/form-rows-bridge.bml;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class RowsFromJsonRun {
  def rfj-say(t) = print_str("[rows-from-json] " ++ t);
  def rfj-lines(path) = filter(l => len(trim(l)) > 0, split-on(read_file(path) ?? "", byte_to_str(10)));
  // the rows' text, or a refusal naming the first line that is no JSON object
  def rfj-convert(lines, n, acc) {
   if nil?(lines) then ["ok", str-join(reverse(acc))]
   else if !fcgp-object-line?(trim(lines[0])) then ["refused", n]
   else rfj-convert(lines[1:], n + 1, cons(frb-row-text(parse-json("rows-from-json", trim(lines[0]))), acc));
  }
  def rfj-run() = rfj-with(frw-options(stdin-text() ?? ""));
  def rfj-with(o) {
   if (String) o[0] != "ok" then rfj-say("the options were refused at line " ++ o[2].str() ++ ": " ++ o[1])
   else if !frw-has?(o[1], "from") || !frw-has?(o[1], "to") then rfj-say("give `from PATH` (the JSON-lines file) and `to PATH` (the rows file)")
   else rfj-go(frw-str(o[1], "from", ""), frw-str(o[1], "to", ""), frw-int(o[1], "append", 0) == 1);
  }
  def rfj-go(from, to, append) {
   if file_size(from) < 1 then rfj-say(from ++ " is absent or empty: nothing was written")
   else if file_size(to) > 0 && !append then rfj-say(to ++ " exists: nothing was written (give `append 1` to add after it)")
   else rfj-write(rfj-convert(rfj-lines(from), 1, []), to, append);
  }
  def rfj-write(r, to, append) {
   if (String) r[0] != "ok" then rfj-say("line " ++ r[1].str() ++ " is no JSON object: nothing was written")
   else rfj-put(r[1], to, append);
  }
  def rfj-put(text, to, append) {
   let kept = append ? (read_file(to) ?? "") : "";
   let wrote = write_file_text(to, kept ++ text);
   rfj-say(to ++ ": " ++ len(filter(l => len(l) > 0, split-on(text, byte_to_str(10)))).str() ++ " row(s), " ++ len(text).str() ++ " bytes");
  }
 }
 rfj-run();
}
