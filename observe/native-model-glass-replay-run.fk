; native-model-glass-replay-run.fk — bounded route-state rehearsal.
;
; This door never opens weights and never emits FORM-MODEL-CARRIER-V1.
; The primary native-model-glass-run.fk is the physical Qwen crossing.
;
; preludes: form/form-stdlib/native-model-glass.bml

(do
    (framebuffer-clear)
    (let s0 (nmg-initial))
    (let s1 (nmg-begin-input s0 "nl"))
    (let _f1 (nmg-glass-write s1))
    (let s2 (nmg-finish-ingress s1 1 23))
    (let s3 (nmg-begin-native s2))
    (let _f2 (nmg-glass-write s3))
    (let s4 (nmg-finish-native s3 "request-evidence"))
    (let _f3 (nmg-glass-write s4))
    (let s5 (nmg-qwen-loading s4))
    (let _f4 (nmg-glass-write s5))
    (list "native-model-glass-replay" "no-weight-open" "carrier-events" 0
        "framebuffer-events" (len (framebuffer-events)) "final" s5))
