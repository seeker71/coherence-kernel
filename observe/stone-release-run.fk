; stone-release-run.fk — release a ledgered stone whose burn a fresh
; observation found gone. The ledger is a worklist, not a fossil bed:
; a release carries its witness, and the patrol can stone the same name
; again the moment it re-heats (sl-standing? counts additions against
; releases). Run from the field's own directory, like the patrol.
;   echo "<name as ledgered>" >  /tmp/stone-release-target
;   echo "<witness detail>"   >> /tmp/stone-release-target
;   ./fkwu observe/stone-release-run.fk
; preludes: form-stdlib/spool-bell-transport.fk form-stdlib/stone-ledger.fk
(do
    (defn srr-stones () ".hearth/stones")
    (defn srr-read (path)
        (do (let t (read_file path)) (if (nothing? t) "" t)))
    (defn srr-line-at (text from)
        (do (let nl (str_find text (byte_to_str 10) from))
            (if (lt nl 0) (substring text from (str_len text))
                (substring text from nl))))
    (let target (srr-read "/tmp/stone-release-target"))
    (let name (srr-line-at target 0))
    (let after (add (str_len name) 1))
    (let detail (if (lt after (str_len target)) (srr-line-at target after) ""))
    (let ledger (srr-read (srr-stones)))
    (if (eq (str_len name) 0)
        (print_str "stone-release: no name in /tmp/stone-release-target\n")
        (if (eq (sl-standing? ledger name) 0)
            (print_str (str_concat "stone-release: not standing, nothing to release: "
                (str_concat name (byte_to_str 10))))
            (do
                (let a (sbt-append (srr-stones)
                    (str_concat "t=" (str_concat (int_to_str (now_unix_ms))
                        (str_concat " stone=released name=" (str_concat name
                            (str_concat " " (str_concat detail (byte_to_str 10)))))))))
                (print_str (str_concat "released " (str_concat name
                    (str_concat " standing-after="
                        (str_concat (int_to_str (sl-standing?
                            (srr-read (srr-stones)) name)) (byte_to_str 10))))))))))
