; crossing-record.fk — the membrane writes its own line when it is crossed.
;
; preludes: form-stdlib/core.fk
;
; host-exec is the body's aperture outward (runtime/fkwu-uni.c:4968). It returns a
; string and forgets, so every crossing this session made left no trace and
; crossing-ledger.fk's rows had to be typed by hand. xc-exec is that aperture with
; a memory: same contract, and it appends one line first.
;
; THE LINE: <unix-seconds>\t<cmd-bytes>\t<out-bytes>. The command TEXT is
; deliberately not written — a command can carry a question, a path or a secret,
; and a ledger quietly accumulating them would be worse than the gap it closes.
; Extent, not content.
;
; WHAT IT DOES NOT DO: it records that a crossing happened and how big it was, not
; why, and it cannot know whether the answer was any good. The four-valued reading
; in crossing-ledger.fk is a judgement over these rows, not something the door
; stamps.
;
; THE CLAIMS ARE BITS. tests/crossing-record-band.fk:
;   b1,b2,b3  rows counted; nothing recorded is nothing counted
;   b4,b5     the two columns read APART
;   b6,b7     a line carries three fields; the command text is not among them
;   b8        one row and two rows count apart
;
; witnessed: 2026-08-15 -> band 255 on fkwu.

(do
    (defn xc-ledger () "observe/.crossings.tsv")
    (defn xc-tab () (byte_to_str 9))
    (defn xc-nl () (byte_to_str 10))
    (defn xc-now () (div (now_unix_ms) 1000))

    (defn xc-int (n) (if (lt n 10) (byte_to_str (add 48 n))
        (str_concat (xc-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))

    (defn xc-line (secs cmd-bytes out-bytes)
        (str_concat (xc-int secs)
        (str_concat (xc-tab)
        (str_concat (xc-int cmd-bytes)
        (str_concat (xc-tab)
        (str_concat (xc-int out-bytes) (xc-nl)))))))

    (defn xc-append (line)
        (write_file (xc-ledger) (str_concat (read_file (xc-ledger)) line)))

    ; THE DOOR WITH A MEMORY. Same contract as host-exec — command in, output out.
    ; The row is written by the crossing, so a caller cannot forget to record one.
    (defn xc-exec (cmd input)
        (do (let out (host-exec cmd input))
            (xc-append (xc-line (xc-now) (str_len cmd) (str_len out)))
            out))

    ; ---- reading the ledger back, walked in Form ----
    (defn xc-count-loop (t n i acc)
        (if (ge i n) acc
            (if (eq (str_byte_at t i) 10)
                (xc-count-loop t n (add i 1) (add acc 1))
                (xc-count-loop t n (add i 1) acc))))
    (defn xc-count-text (t) (xc-count-loop t (str_len t) 0 0))
    (defn xc-count () (xc-count-text (read_file (xc-ledger))))

    ; total bytes that came back across every recorded crossing — the third column
    (defn xc-field-loop (t n i col want acc cur)
        (if (ge i n) acc
            (do (let b (str_byte_at t i))
                (if (eq b 10)
                    (xc-field-loop t n (add i 1) 0 want (add acc (if (eq col want) cur 0)) 0)
                    (if (eq b 9)
                        (xc-field-loop t n (add i 1) (add col 1) want
                            (add acc (if (eq col want) cur 0)) 0)
                        (if (and (ge b 48) (le b 57))
                            (xc-field-loop t n (add i 1) col want acc (add (mul cur 10) (sub b 48)))
                            (xc-field-loop t n (add i 1) col want acc cur)))))))
    (defn xc-sum-text (t col) (xc-field-loop t (str_len t) 0 0 col 0 0))
    (defn xc-bytes-out () (xc-sum-text (read_file (xc-ledger)) 1))
    (defn xc-bytes-in  () (xc-sum-text (read_file (xc-ledger)) 2))

    ; ---- fixtures, so the walk is checked on text it was not fitted to ----
    (defn xc-fx () "1000\t12\t400\n1001\t8\t68\n")
    0)
