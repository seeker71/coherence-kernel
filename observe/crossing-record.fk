// crossing-record.fk — the membrane writes its own line when it is crossed.
//
import form-stdlib/core.fk;
import form-stdlib/bml/spawn-guard.bml;
//
// host-exec is the body's aperture outward (runtime/fkwu-uni.c:4968). It returns a
// string and forgets, so every crossing this session made left no trace and
// the crossing ledger's rows had to be typed by hand. xc-exec is that aperture with
// a memory: same contract, and it appends one line first.
//
// THE LINE: <unix-seconds>\t<cmd-bytes>\t<out-bytes>. The command TEXT is
// deliberately not written — a command can carry a question, a path or a secret,
// and a ledger quietly accumulating them would be worse than the gap it closes.
// Extent, not content.
//
// WHAT IT DOES NOT DO: it records that a crossing happened and how big it was, not
// why, and it cannot know whether the answer was any good. A four-valued reading
// of the crossing ledger is a judgement over these rows, not something the door
// stamps.
//
// THE CLAIMS ARE BITS (the band that reads them is pending in this tree):
//   b1,b2,b3  rows counted; nothing recorded is nothing counted
//   b4,b5     the two columns read APART
//   b6,b7     a line carries three fields; the command text is not among them
//   b8        one row and two rows count apart
//
// witnessed: 2026-08-15 -> band 255 on fkwu.
section [form.bml] {
    def xc-ledger() = "observe/.crossings.tsv";
    def xc-tab() = byte_to_str(9);
    def xc-nl() = byte_to_str(10);
    def xc-now() = now_unix_ms() / 1000;
    def xc-int(n) = n < 10 ? byte_to_str((Number) 48 + (Number) n) : ((String) xc-int(n / 10) + byte_to_str((Number) 48 + (Number) (n % 10)));
    def xc-line(secs, cmd-bytes, out-bytes) = (xc-int(secs) + (xc-tab() + (xc-int(cmd-bytes) + (xc-tab() + ((String) xc-int(out-bytes) + xc-nl())))));
    // a ledger that never was answers nothing (2026-08-27) — name it, then
    // the first append starts from "".
    def xc-read(p) = {
        let s = read_file(p);
        nothing?(s) ? "" : s;
    };
    def xc-append(line) = write_file(xc-ledger(), ((String) xc-read(xc-ledger()) + line));
    // THE DOOR WITH A MEMORY. Same contract as host-exec — command in, output out.
    // The row is written by the crossing, so a caller cannot forget to record one.
    def xc-exec(cmd, input) = {
        let out = sg-exec(cmd, input);
        xc-append(xc-line(xc-now(), len(cmd), len(out ?? "")));
        out;
    };
    // ---- reading the ledger back, walked in Form ----
    def xc-count-loop(t, n, i, acc) = i >= n ? acc : (Comparable) str_byte_at(t, i) == 10 ? xc-count-loop(t, n, (Number) i + (Number) 1, (Number) acc + (Number) 1) : xc-count-loop(t, n, (Number) i + (Number) 1, acc);
    def xc-count-text(t) = xc-count-loop(t, len(t), 0, 0);
    def xc-count() = xc-count-text(xc-read(xc-ledger()));
    // total bytes that came back across every recorded crossing — the third column
    def xc-field-loop(t, n, i, col, want, acc, cur) = i >= n ? acc : {
        let b = str_byte_at(t, i);
        (Comparable) b == 10 ? xc-field-loop(t, n, (Number) i + (Number) 1, 0, want, (Number) acc + (Number) ((Comparable) col == want ? cur : 0), 0) : (Comparable) b == 9 ? xc-field-loop(t, n, (Number) i + (Number) 1, (Number) col + (Number) 1, want, (Number) acc + (Number) ((Comparable) col == want ? cur : 0), 0) : b >= 48 && b <= 57 ? xc-field-loop(t, n, (Number) i + (Number) 1, col, want, acc, (Number) (cur * 10) + (Number) (b - 48)) : xc-field-loop(t, n, (Number) i + (Number) 1, col, want, acc, cur);
    };
    def xc-sum-text(t, col) = xc-field-loop(t, len(t), 0, 0, col, 0, 0);
    def xc-bytes-out() = xc-sum-text(xc-read(xc-ledger()), 1);
    def xc-bytes-in() = xc-sum-text(xc-read(xc-ledger()), 2);
    // ---- fixtures, so the walk is checked on text it was not fitted to ----
    def xc-fx() = "1000\t12\t400\n1001\t8\t68\n";
    0;
}
