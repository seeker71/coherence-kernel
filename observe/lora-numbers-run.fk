; lora-numbers-run.fk — the real adapter's first numbers, read by the body:
; four floats of one lora_a and one lora_b tensor, and the norm of the delta
; the pair makes on a unit vector. stdin line 1: adapter path (blank -> the
; first voice adapter in the tree).
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-adapter.bml
(do
    (defn lnr-trim (s) (if (nothing? s) "" (trim s)))
    (defn lnr-show (xs) (if (eq (len xs) 0) "" (str_concat (float_to_str (head xs)) (str_concat " " (lnr-show (tail xs))))))
    (defn lnr-unit (n) (if (le n 0) (list) (cons 1.0 (lnr-unit (sub n 1)))))
    (let p0 (lnr-trim (read_line)))
    (let path (if (eq (str_len p0) 0) "form/form-stdlib/adapters/llama-3.2-3b-voice/adapters.safetensors" p0))
    (let h (la-header path))
    (let hlen (la-header-len path))
    (let a (ln-floats path hlen (ln-tensor-begin h "model.layers.20.self_attn.q_proj.lora_a") 4))
    (let b (ln-floats path hlen (ln-tensor-begin h "model.layers.20.self_attn.q_proj.lora_b") 4))
    (print_str (str_concat "lora_a[20.q_proj][0..3]: " (str_concat (lnr-show a) "\n")))
    (print_str (str_concat "lora_b[20.q_proj][0..3]: " (str_concat (lnr-show b) "\n")))
    (print_str (str_concat "delta-norm2 of the first four on a unit vector: " (str_concat (float_to_str (ln-norm2 (list (ln-dot a (lnr-unit 4))))) "\n")))
    0)
