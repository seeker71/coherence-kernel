; session-neutral-meaning-journey-live.fk — evidence, contextual offer,
; revision, and locale realization as one reversible walk.
; witnessed: 2026-08-24 -> 29 joined graph edges; offer changed after revision
; preludes: cognition/session-neutral-meaning-realization.fk

(do
  (let runtime (snsf-open))
  (let expression-rows (snsf-resolve-text runtime "en" "yes trust"))
  (let field-rows (snsf-resolve-text runtime "en" "trust flow vitality"))
  (let de-rows (snsf-resolve-tokens runtime "de" (list "Vertrauen" "Fluss")))
  (let zh-rows (snsf-resolve-tokens runtime "zh" (list "信任" "流动")))
  (let dictionary-1 (snsr-rebase (empty) expression-rows))
  (let dictionary-2 (snsr-rebase dictionary-1 field-rows))
  (let dictionary-3 (snsr-rebase dictionary-2 de-rows))
  (let dictionary (snsr-rebase dictionary-3 zh-rows))
  (let phrases (snsp-observe (empty) expression-rows 2 2))
  (let expression (snsp-c-address (head phrases)))
  (let trust-address (snsf-concept-address 490))
  (let flow-address (snsf-concept-address 3382))
  (let trust-meaning (snsp-meaning dictionary (list trust-address)))
  (let flow-meaning (snsp-meaning dictionary (list flow-address)))
  (let phrase-meaning (snsp-meaning dictionary (list trust-address flow-address)))
  (let binding-evidence (list (snsf-structure-address 14)))
  (let trust-binding (snsp-binding phrases expression trust-meaning
    binding-evidence "candidate"))
  (let flow-binding (snsp-binding phrases expression flow-meaning
    binding-evidence "candidate"))
  (let bindings (list trust-binding flow-binding))
  (let w1 (snsf-address 15 21))
  (let w2 (snsf-address 15 22))
  (let w3 (snsf-address 15 23))
  (let w4 (snsf-address 15 24))
  (let evidence (list expression (snsf-structure-address 14)))
  (let initial-events
    (list
      (snse-event w1 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1)
      (snse-event w2 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1)
      (snse-event w3 expression (snsp-m-address flow-meaning)
        (snse-support) evidence 1)
      (snse-event w4 expression (snsp-m-address flow-meaning)
        (snse-support) evidence 1)))
  (let initial-choice (snsc-choice dictionary (list flow-address)
    initial-events bindings 2))
  (let revision (snse-revision w3 flow-binding trust-binding evidence 2))
  (let revised-events (append initial-events revision))
  (let revised-choice (snsc-choice dictionary (list flow-address)
    revised-events bindings 2))
  (let en (snmr-realize runtime dictionary phrase-meaning "en"
    (snsf-expression-self)))
  (let de (snmr-realize runtime dictionary phrase-meaning "de"
    (snsf-expression-self)))
  (let zh (snmr-realize runtime dictionary phrase-meaning "zh"
    (snsf-expression-uncased)))
  (let fr (snmr-realize runtime dictionary phrase-meaning "fr"
    (snsf-expression-self)))
  (let phrase-graph (snsp-graph phrases bindings))
  (let evidence-graph (snse-events-graph revised-events))
  (let realization-graph
    (snsp-unique-edges
      (append (snmr-realization-edges en)
        (append (snmr-realization-edges de)
          (append (snmr-realization-edges zh)
            (snmr-realization-edges fr))))))
  (let journey-graph
    (snsp-unique-edges
      (append phrase-graph (append evidence-graph realization-graph))))
  (print "session-neutral-meaning-journey\n")
  (print "step-1-initial-trust-evidence=")
  (print (snse-summary initial-events trust-binding 2))
  (print "\nstep-1-initial-flow-evidence=")
  (print (snse-summary initial-events flow-binding 2))
  (print "\nstep-2-contextual-offer-before-revision=")
  (print (snsp-m-address (snsp-b-meaning (snsc-o-binding initial-choice))))
  (print " mode=") (print (snsc-o-mode initial-choice))
  (print "\nstep-2-contextual-offer-after-revision=")
  (print (snsp-m-address (snsp-b-meaning (snsc-o-binding revised-choice))))
  (print " mode=") (print (snsc-o-mode revised-choice))
  (print "\nstep-3-en=") (print (snmr-r-surfaces en))
  (print " provenance=") (print (snmr-r-option-sets en))
  (print "\nstep-3-de=") (print (snmr-r-surfaces de))
  (print " provenance=") (print (snmr-r-option-sets de))
  (print "\nstep-3-zh=") (print (snmr-r-surfaces zh))
  (print " provenance=") (print (snmr-r-option-sets zh))
  (print "\nstep-3-fr=") (print (snmr-r-surfaces fr))
  (print " provenance=") (print (snmr-r-option-sets fr))
  (print "\nneutral-meaning-unchanged=") (print (snsp-m-address phrase-meaning))
  (print "\njourney-graph-edges=") (print (int_to_str (len journey-graph)))
  (print " phrase=") (print (int_to_str (len phrase-graph)))
  (print " evidence=") (print (int_to_str (len evidence-graph)))
  (print " realization=") (print (int_to_str (len realization-graph)))
  (print "\nreverse-edges-into-trust-meaning=")
  (print (int_to_str (len (snsp-edges-to journey-graph
    (snsp-m-address trust-meaning)))))
  (print "\n")
  0)
