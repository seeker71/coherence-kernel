; form-knowledge-exec-grammar-prompt-run.fk -- exact source-bound grammar
; prompt bytes for the compatible local diagnostic carrier.
;
; This door owns no model.  It prints the prompt between stable markers so a
; bounded local carrier can consume the exact Form-produced bytes without a
; handwritten duplicate.
;
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk

(do
    (let prompt (fkegt-prompt))
    (if (nothing? prompt)
        (print_str "FKEGT_PROMPT_NOTHING")
        (do
            (print_str "FKEGT_PROMPT_BEGIN")
            (print_str prompt)
            (print_str "FKEGT_PROMPT_END")
            (print_str (str_concat "FKEGT_PROMPT_SHA="
                (fkegt-prompt-sha)))))
    0)
