; observe/prompt-training-lens.fk — the analysis half of the standing
; prompt wire: read the training spool the prompt door fills (plus the
; host shim's jsonl, from sessions where the body cell was absent) and
; answer what the teach lane has to work with — how many frames, and the
; newest one, so a training run knows its fuel before it starts. The
; pairing recipe for actual teach runs: each captured prompt pairs with
; the receipts its session committed (git log holds the outcome side);
; the mlx-lm LoRA lane (prefer-local-DS4 teaching) consumes the pairs.
;
; preludes: form-stdlib/core.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml form-stdlib/spool-bell-transport.fk

(do
    (defn ptl-count (text at acc)
        (do
            (let hit (str_find text "kind=prompt-capture-v1" at))
            (if (lt hit 0) acc
                (ptl-count text (add hit 1) (add acc 1)))))
    (defn ptl-lines (text at acc)
        (do
            (let hit (str_find text "\n" at))
            (if (lt hit 0) acc
                (ptl-lines text (add hit 1) (add acc 1)))))
    (let spool (read_file ".hearth/prompt-training.spool"))
    (let shim (read_file ".hearth/prompt-capture.jsonl"))
    (let n (if (nothing? spool) 0 (ptl-count spool 0 0)))
    (let m (if (nothing? shim) 0 (ptl-lines shim 0 0)))
    (print_str (str_concat "prompt-training frames (body spool): "
        (str_concat (int_to_str n)
        (str_concat "\nprompt-capture lines (host shim): "
        (str_concat (int_to_str m)
        (str_concat "\nnext turn: "
        (str_concat (int_to_str (add (lms-max-turn (if (nothing? spool) "" spool)) 1))
            "\n")))))))
    0)
