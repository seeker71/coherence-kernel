; membrane-heartbeat-run.fk — who in this body is actually alive?
;
; An age says how long ago a name spoke. It cannot say whether that name ever
; means to speak again, so a band that published once and finished and an organ
; that was meant to keep giving and stopped read exactly alike after an hour.
; This door asks two different questions and keeps them apart.
;
; FIRST, without any declaration: it takes two censuses a window apart and
; watches which stamps MOVE. That reading is one-sided and the print says so —
; movement proves alive, stillness proves nothing until the window is wider than
; the cadence being asked about. A publisher on a five-second cadence is
; perfectly well and will stand still through every three-second window.
;
; SECOND, against the declaration in form-glass-standing.bml: an organ that
; promised a cadence and has gone quiet past its own window is STOPPED, and that
; is the one reading here that is a wound. It names the cell that gives the
; organ, so the finding points at a door and not at a mood. A publisher that
; never promised is never called stopped.
;
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/form-glass-standing.bml

(do
    (defn show (ss)
        (if (eq (len ss) 0) 0
            (do (print (list (fgx-slot-name (head ss)) "last-spoke-s-ago" (div (fgx-slot-age (head ss)) 1000)))
                (show (tail ss)))))
    (defn show-readings (rs)
        (if (eq (len rs) 0) 0
            (do (print (list (fgst-reading-state (head rs)) (fgst-reading-publisher (head rs))
                             "silent-s" (if (lt (fgst-reading-age (head rs)) 0) -1 (div (fgst-reading-age (head rs)) 1000))
                             "promised-within-s" (div (fgst-reading-window (head rs)) 1000)
                             (fgst-reading-door (head rs))))
                (show-readings (tail rs)))))

    (let windowMs 3000)
    (let root (hearth-telemetry-root))
    (let before (fgx-roster-slots (now_unix_ms)))
    (let waited (host_sleep_ms windowMs))
    (let after (fgx-roster-slots (now_unix_ms)))
    (let beating (fgx-beating before after))
    (let still (fgx-still before after))

    (print (list "membrane-heartbeat" "window-ms" windowMs "slots" (len after)
                 "moved" (len beating) "did-not-move" (len still)))
    (print (list "by-time" (fgx-slots-by-time after (list))))
    (print "--- spoke inside the window: alive, witnessed ---")
    (show beating)

    (let readings (fgst-assess after root))
    (let unkept (fgst-unkept readings))
    (print (list "--- declared organs ---" "kept" (len (fgst-kept readings)) "unkept" (len unkept)))
    (show-readings readings)
    (len unkept))
