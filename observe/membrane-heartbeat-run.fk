// membrane-heartbeat-run.fk — how is the body?
//
// Ask the body first. observe/body-vitals-live.fk stands and watches every
// surface in the roster, letting each teach its own rhythm, and gives the
// reading back as the `vitals` frame. So the first thing this door does is take
// that frame: the body's own account of itself, in one row when nothing is
// wrong, plus one row per surface asking for attention. Nobody had to name an
// organ for that reading to exist.
//
// If no vitals organ is standing, the frame is absent — and saying "the body has
// no voice right now" is itself the finding, not a reason to invent one.
//
// Then two readings the signal does not carry:
//
//   the RAW heartbeat — two censuses a window apart, and a slot whose stamp
//   advanced spoke inside it. One-sided on purpose: movement proves alive,
//   stillness proves nothing until the window is wider than the cadence being
//   asked about.
//
//   the DECLARATION — form-glass-standing.bml names organs that must exist at
//   all. A watch can only learn the rhythm of something that has appeared; an
//   organ that never once registered is invisible to it, and only a declaration
//   can notice that absence.
//
import form/form-stdlib/hearth.bml;
import form/form-stdlib/form-glass-vitals.bml;
import form/form-stdlib/form-glass-standing.bml;
section [form.bml] {
    def show(ss) = (Comparable) len(ss) == 0 ? 0 : {
        print([fgx-slot-name(ss[0]), "last-spoke-s-ago", fgx-slot-age(ss[0]) / 1000]);
        show(ss[1:]);
    };
    def show-findings(fs) = (Comparable) len(fs) == 0 ? 0 : {
        print([fgv-finding-state(fs[0]), fgv-finding-name(fs[0]), "silent-s", fgv-finding-silence(fs[0]) / 1000, "own-bound-s", fgv-finding-bound(fs[0]) / 1000, "beats", fgv-finding-beats(fs[0])]);
        show-findings(fs[1:]);
    };
    def show-declared(rs) = (Comparable) len(rs) == 0 ? 0 : {
        print([fgst-reading-state(rs[0]), fgst-reading-publisher(rs[0]), "silent-s", fgst-reading-age(rs[0]) < 0 ? -1 : fgst-reading-age(rs[0]) / 1000, "promised-within-s", fgst-reading-window(rs[0]) / 1000, fgst-reading-door(rs[0])]);
        show-declared(rs[1:]);
    };
    let root = hearth-telemetry-root();
    // ---- the body's own voice
    let sig = fgv-signal-samples(fgv-take-signal(root));
    let body = fgv-signal-body(sig);
    let findings = fgv-signal-findings(sig);
    (Comparable) len(sig) == 0 ? print("the body has no voice right now: no vitals frame stands. observe/body-vitals-live.fk") : print(["vitals", "watched", fgv-body-watched(body), "beating", fgv-body-beating(body), "faltering", fgv-body-faltering(body), "resting", fgv-body-resting(body), "watching-s", fgv-body-watching-ms(body) / 1000]);
    show-findings(findings);
    // ---- the raw instrument, owed to nobody's declaration
    let windowMs = 3000;
    let before = fgx-roster-slots(now_unix_ms());
    let waited = host_sleep_ms(windowMs);
    let after = fgx-roster-slots(now_unix_ms());
    let beating = fgx-beating(before, after);
    print(["heartbeat", "window-ms", windowMs, "slots", len(after), "moved", len(beating), "by-time", fgx-slots-by-time(after, [])]);
    show(beating);
    // ---- what must exist at all
    let declared = fgst-assess(after, root);
    let unkept = fgst-unkept(declared);
    print(["declared", "kept", len(fgst-kept(declared)), "unkept", len(unkept)]);
    show-declared(declared);
    (Number) len(findings) + (Number) len(unkept);
}
