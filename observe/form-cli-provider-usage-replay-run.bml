// preflight-exec: forbidden
// One JSON request, or @file for a longer retained proposal, on stdin.
// This door performs native replay; it starts no model or provider.
// preludes: form-stdlib/bml/form-cli-provider-usage-replay.bml
section [form.bml] {
 let line = read_line();
 let offered = if nothing?(line) then "" else line;
 let external = and(gt(str_len(offered),0),str_eq(substring(offered,0,1),"@"));
 let path = if external then substring(offered,1,str_len(offered)) else "";
 let bytes = if external then if lt(file_size(path),0) then nothing() else read_file_slice(path,0,add(fpur-max-bytes(),1)) else offered;
 print_str(json-emit(if nothing?(bytes) then fpur-invalid("request-file-unavailable") else fpur-read(bytes)));
}
