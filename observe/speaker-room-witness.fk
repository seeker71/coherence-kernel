; speaker-room-witness.fk — the body speaks through its own door and hears itself back.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/core.fk
;
; A band proves a door's MEANING. It cannot prove that a door moves air, because a
; band that made a sound would stain the room it measures. So the meaning lives in
; form/form-stdlib/tests/speaker-doors-band.fk, silent, and the air lives here.
;
; Both halves of this run are the seed's own: the tone is built in Form as s16le mono
; 16 kHz bytes, handed to sense_speaker_stream_write, and read back through
; sense_mic_stream_read while it is still sounding. No afplay, no ffmpeg, no wav file,
; no host process at all — one fkwu, two directions, one room.
;
; The room is measured BEFORE the tone with the ear's own door, so the number that
; matters is a DIFFERENCE and not a level: a loud room and a working mouth look the
; same in one reading. If the ear is held by a sibling (three of them drive it on a
; busy hour) the capture answers nothing and this cell says so rather than inventing
; a room.
;
;   ./fkwu observe/speaker-room-witness.fk

(do
    ; ── the tone, built by doubling: 16 samples up, 16 down = 32 samples = 500 Hz ──
    ; Amplitude 6000 of 32767. A square wave because it is the one shape that needs no
    ; arithmetic the seed would have to grow a door for, and it is unmistakable in the
    ; ear's peak.
    (defn sw-dbl (s n) (if (le n 0) s (sw-dbl (str_concat s s) (sub n 1))))
    (defn sw-samp (lo hi) (str_concat (byte_to_str lo) (byte_to_str hi)))
    (defn sw-up () (sw-dbl (sw-samp 112 23) 4))     ; +6000, sixteen of them
    (defn sw-down () (sw-dbl (sw-samp 144 232) 4))  ; -6000, sixteen of them
    (defn sw-period () (str_concat (sw-up) (sw-down)))
    (defn sw-tone (k) (sw-dbl (sw-period) k))       ; k=8 -> 16384 B = 8192 samples = 512 ms

    ; ── reading what came back, in the ear door's own units ──
    (defn sw-s16 (s i) (sw-signed (add (str_byte_at s i) (mul 256 (str_byte_at s (add i 1))))))
    (defn sw-signed (v) (if (ge v 32768) (sub v 65536) v))
    (defn sw-walk (s i end peak sum n)
        (if (ge i end) (list peak (if (le n 0) 0 (div sum n)) n)
            (sw-walk-at s i end peak sum n (abs (sw-s16 s i)))))
    (defn sw-walk-at (s i end peak sum n a)
        (sw-walk s (add i 8) end (if (gt a peak) a peak) (add sum a) (add n 1)))
    (defn sw-read (s) (sw-walk s 0 (sub (str_len s) 1) 0 0 0))  ; every 4th sample

    (defn sw-drain (acc n)
        (if (le n 0) acc (sw-drain (str_concat acc (sense_mic_stream_read 6400 250)) (sub n 1))))

    (defn sw-say (k v) (print_str (str_concat k (int_to_str v))))

    (defn sw-frame (label r)
        (print_str (str_concat label (str_concat "  peak=" (str_concat (int_to_str (head r))
            (str_concat "  mean-abs=" (str_concat (int_to_str (nth r 1))
                (str_concat "  samples=" (int_to_str (nth r 2))))))))))

    (let mouths (sense_speaker_count))
    (let mouth (sense_speaker_name 0))
    (let health (sense_speaker_health 0))
    (let a (print_str (str_concat "mouth: " (str_concat mouth (str_concat "  health=" (int_to_str health))))))
    (let b (sw-say "mouths=" mouths))

    (let tone (sw-tone 8))
    (let c (sw-say "tone bytes=" (str_len tone)))

    ; ONE ear session, TWO windows. A level says nothing on a busy hour — the room
    ; itself was measured at mean-abs 1306 while this was written. The same stream,
    ; the same measure, seconds apart, is what tells a mouth from a room.
    (let mstart (sense_mic_stream_start))
    (let before (sw-drain "" 3))
    (let sstart (sense_speaker_stream_start))
    (let wrote (sense_speaker_stream_write tone))
    (let during (sw-drain "" 3))
    (let sstop (sense_speaker_stream_stop))
    (let mstop (sense_mic_stream_stop))

    (let e (sw-say "mic-stream-start=" mstart))
    (let f (sw-say "speaker-stream-start=" sstart))
    (let g (sw-say "samples-accepted=" wrote))
    (let rb (sw-read before))
    (let rd (sw-read during))
    (let h (if (eq (str_len during) 0)
        (print_str "the ear gave nothing back — held elsewhere, or refused; no room is claimed here")
        (do (let p (sw-frame "silent window " rb))
            (let q (sw-frame "sounding window" rd))
            (sw-say "peak rise=" (sub (head rd) (head rb))))))
    (sub (head rd) (head rb)))
