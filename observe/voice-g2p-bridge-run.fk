// voice-g2p-bridge-run.fk — fit the model->voice symbol bridge, measure it held out, and ship the table.
//
//   printf '<eval|ship>\n<tongue codes, space divided>\n' | ./fkwu observe/voice-g2p-bridge-run.fk
//
// For each tongue the pairs are the taught word table (form/form-stdlib/data/g2p-<tongue>-word.tsv, each word once,
// file order) beside the native T5's answer for that word (the ledger form/form-stdlib/data/g2p-<tongue>-raw.tsv,
// which `observe/voice-g2p-grow-run.fk` writes in `taught` mode; the tag is voice-g2p-bridge.bml's `vgb-tag`).
//
//   eval  learn on the words whose index mod 5 is not 0, measure on the others (held out), and print per tongue:
//         the model's answer as it came ("before"), and through the bridge ("after"), on the held-out words and on
//         the training words, as exact-word matches and symbol edit rate (x10000, integers), plus rules kept and
//         the symbols the voice's table lacked and the bridge dropped.
//   show  print the first 40 held-out words the bridge still gets wrong, as  model | bridge | taught
//   ship  fit on ALL words, write form/form-stdlib/data/g2p-<tongue>-bridge.tsv, print the in-sample numbers.
//
// Measured against the taught symbols as they stand: stress, length and tie marks included (the voice speaks them),
// the pieces the teacher cut (a nasal vowel is a vowel and U+0303).
// preflight-exec: forbidden
import form/form-stdlib/voice-say.bml;
import form/form-stdlib/voice-g2p-bridge.bml;
section [form.bml] {
    def gbr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    def gbr-lines(path) = file_size(path) > 0 ? split-on(read_file(path), vg-nl()) : [];
    def gbr-rate(n, d) = d <= 0 ? 0 : ((n * 10000) / d);
    def gbr-show(label, st) = print_str("  " + label + " words=" + st[0].str() + " exact=" + st[1].str() + " exact_x10000=" + gbr-rate(st[1], st[0]).str() + " edits=" + st[2].str() + " symbols=" + st[3].str() + " edit_rate_x10000=" + gbr-rate(st[2], st[3]).str() + " dropped=" + st[4].str());
    def gbr-cfg-valid(code) = vgb-valid-of(vp-cfg(vs-voice(code)));
    def gbr-tongue(mode, code) {
        let tag = vgb-tag(code);
        let pairs = vgb-pairs-of(code);
        let valid = gbr-cfg-valid(code);
        let t0 = host_monotonic_ms();
        print_str("tongue " + code + " tag=" + tag + " pairs=" + len(pairs).str());
        (String) mode == "eval" ? gbr-eval(code, pairs, valid, t0) : ((String) mode == "show" ? gbr-look(code, pairs, valid) : gbr-ship(code, pairs, valid, t0));
    }
    // show: the held-out words the bridge still gets wrong, as  model | bridge | taught  (the first 40)
    def gbr-look(code, pairs, valid) {
        let sp = vgb-split(pairs);
        let tab = vgb-learn-table(sp[0]);
        gbr-look-go(tab, valid, sp[1], 40);
    }
    def gbr-look-go(tab, valid, held, n) = (n <= 0 || nil?(held)) ? 0 : gbr-look-one(tab, valid, held, n, vgb-map(tab, valid, held[0][0])[0], vgb-taught-syms(held[0][1]));
    def gbr-look-one(tab, valid, held, n, got, want) {
        let same = vgb-dist(want, got) == 0;
        let p = same ? 0 : print_str("  " + held[0][0] + " | " + vgb-join(got) + " | " + vgb-join(want));
        gbr-look-go(tab, valid, held[1:], same ? n : n - 1);
    }
    def gbr-eval(code, pairs, valid, t0) {
        let sp = vgb-split(pairs);
        let tab = vgb-learn-table(sp[0]);
        print_str("  split train=" + len(sp[0]).str() + " held=" + len(sp[1]).str() + " rules=" + (len(record_keys(tab)) / 2).str());
        let a = gbr-show("before held ", vgb-raw(sp[1]));
        let b = gbr-show("after  held ", vgb-eval(tab, valid, sp[1]));
        let c = gbr-show("before train", vgb-raw(sp[0]));
        let d = gbr-show("after  train", vgb-eval(tab, valid, sp[0]));
        print_str("  ms=" + (host_monotonic_ms() - t0).str());
        0;
    }
    def gbr-join-lines(rows) = nil?(rows) ? "" : (rows[0] + vg-nl() + gbr-join-lines(rows[1:]));
    def gbr-ship(code, pairs, valid, t0) {
        let rows = vgb-learn-rows(pairs);
        let tab = vgb-rows-add(record_new(0), rows);
        let w = write_file(vgb-path(code), gbr-join-lines(rows));
        let a = gbr-show("before all ", vgb-raw(pairs));
        let b = gbr-show("after  all ", vgb-eval(tab, valid, pairs));
        print_str("  shipped rules=" + len(rows).str() + " to " + vgb-path(code) + " ms=" + (host_monotonic_ms() - t0).str());
        0;
    }
    def gbr-each(mode, codes) = nil?(codes) ? 0 : gbr-after(mode, codes, gbr-tongue(mode, codes[0]));
    def gbr-after(mode, codes, done) = gbr-each(mode, codes[1:]);
    let mode = gbr-line();
    let codes = split-on(gbr-line(), " ");
    (len(mode) == 0 || nil?(codes)) ? form_error("usage: <eval|ship> / <tongue codes> on stdin") : 0;
    gbr-each(mode, codes);
}
