; ear-ground-hop-probe.fk — what one frame costs to LEAVE the ear, three ways.
;
; The live lane writes each frame to a spool file and then rings a fifo by forking a shell
; (`( tools/ftimeout 5 sh -c 'printf x > bell' ) &`). A fork is priced by what the forking
; process has touched (corpus row 1341, touchtoll), so this measures the three transports from
; inside a process that has actually opened the model — the price the live lane really pays,
; not the price a small process would.
;
; Three transports, same payload:
;   spool   host_file_append_bytes of the frame text
;   bell    the fork that rings the door
;   frame   the gift frame: shared memory, the cell crossing as a cell, a sequence a reader
;           checks before it reads
;
; No microphone here; safe to preflight, but it does open the model and write under .hearth.
; preludes: form/form-stdlib/ear-native.fk form/form-stdlib/spool-bell-transport.fk form/form-stdlib/form-glass-sensor-rows.bml
(do
    (defn eghp-snap ()
        (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/"
            (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (defn eghp-tok () (enw-tokenizer-path))
    (defn eghp-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (eghp-cat (tail xs)))))
    (defn eghp-nl () (byte_to_str 10))
    (defn eghp-spool () "/tmp/ear-ground-hop.spool")
    (defn eghp-bell () "/tmp/ear-ground-hop.bell")
    (defn eghp-say (label n ms) (print_str (eghp-cat (list label "  " (int_to_str n) " x  " (int_to_str ms) " ms total  " (int_to_str (div (mul ms 1000) n)) " us each"))))
    ; a frame the size the live lane actually writes
    (defn eghp-frame () (eghp-cat (list "<|ear:frame|>" (eghp-nl) "t=1788800000000" (eghp-nl) "kind=live" (eghp-nl) "db=-31" (eghp-nl)
        "live=The body observed the glass, water and ice and gas, and the witness told what stands" (eghp-nl)
        "livelang=en" (eghp-nl) "livems=41" (eghp-nl) "encms=5" (eghp-nl) "decms=30" (eghp-nl) "ntok=24" (eghp-nl)
        "heard=" (eghp-nl) "lang=" (eghp-nl) "nsp=12" (eghp-nl) "heardms=0" (eghp-nl) "<|/ear:frame|>" (eghp-nl))))
    (defn eghp-spool-go (s k) (if (le k 0) 0 (do (let w (sbt-append (eghp-spool) s)) (eghp-spool-go s (sub k 1)))))
    (defn eghp-bell-go (k) (if (le k 0) 0 (do (let r (host-exec (eghp-cat (list "( tools/ftimeout 5 sh -c 'printf x > " (eghp-bell) "' ) >/dev/null 2>&1 &")) "")) (eghp-bell-go (sub k 1)))))
    ; the gift frame the way a sensor gives it today: offer, write, release, every time
    (defn eghp-give-go (rows k) (if (le k 0) 0 (do (let g (fgsr-give "earhop" (now_unix_ms) rows)) (eghp-give-go rows (sub k 1)))))
    ; the gift frame over a handle the lane keeps open for its life
    (defn eghp-kept-go (h rows k) (if (le k 0) 0 (do (let g (fgsr-give-held h "earhop" (now_unix_ms) rows)) (eghp-kept-go h rows (sub k 1)))))

    (let path (str_concat (eghp-snap) "/weights.npz"))
    (let st (enw-open path (eghp-tok)))
    (print_str "the model is open; every price below is paid by a process that has touched it")
    (print_str "")
    (let s (eghp-frame))
    (print_str (str_concat "frame bytes " (int_to_str (str_len s))))
    ; the same payload as a sensor row, so the frame lane carries the same meaning
    (let rows (list (fgo-metric "ear" "ear.live" "the line as it stands" "text" 0 "" 0 "ok" 0 0 0 0
        "The body observed the glass, water and ice and gas, and the witness told what stands" "en" "live" "" "" "")))

    (let a0 (now_unix_ms))
    (let a (eghp-spool-go s 200))
    (let a1 (now_unix_ms))
    (eghp-say "spool  append the frame text " 200 (sub a1 a0))

    (let b0 (now_unix_ms))
    (let b (eghp-bell-go 50))
    (let b1 (now_unix_ms))
    (eghp-say "bell   fork a shell to ring  " 50 (sub b1 b0))

    (let c0 (now_unix_ms))
    (let c (eghp-give-go rows 200))
    (let c1 (now_unix_ms))
    (eghp-say "frame  offer, write, release " 200 (sub c1 c0))

    (let h (ggf-offer (fgsr-publisher "earhop") 262144))
    (let d0 (now_unix_ms))
    (let d (eghp-kept-go h rows 200))
    (let d1 (now_unix_ms))
    (eghp-say "frame  write on a kept handle" 200 (sub d1 d0))
    (let rel (ggf-release h))
    (let rm (host-exec (eghp-cat (list "rm -f " (eghp-spool) " " (eghp-bell))) ""))
    0)
