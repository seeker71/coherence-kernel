; qwen38-nodeid-knowledge-session-live-run.fk — PROPOSED live crossing:
; one local Qwen emits a path-free concept request, Form performs one persisted
; public-source lookup, injects the typed current-source observation as new
; bytes, and the same q38 stream/KV residence continues.
;
; EFFECTFUL. Do not preflight: preflight's fresh compile reaches top-level work.
; Run once intentionally only when no sibling owns the local Qwen carrier and
; the persisted public-source artifact is ready. The mechanism and pure band,
; not this driver, are the preflight targets.
;
; Expected physical envelope on Hati Suci:
;   - one mapping/open of the 29 GB Qwen3.8-27B-Q8_0 model;
;   - one q38 context/stream with maxpos=2048, retained across the crossing;
;   - at most 192 generated IDs total before + after the observation;
;   - one exact concept-key bucket lookup (its source bucket was born and
;     read back before this run), then one exact current-source observation;
;   - at most 768 answer bytes inside at most 2,048 injected typed bytes;
;   - no Metal/MLX operation, remote call, flattening, or operations table.
;
; preludes: form-stdlib/form-cli-nodeid-knowledge-session.fk
; preludes: form-stdlib/form-nodeid-knowledge-routed-query.fk form-stdlib/model-registry.bml

(do
    (defn qkns-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn qkns-concept () "defn-psci-schema")
    (defn qkns-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn qkns-int (name value) (qkns-line name (int_to_str value)))
    (defn qkns-bit (held weight) (if held weight 0))
    (defn qkns-has? (text fragment)
        (if (ge (str_find text fragment 0) 0) 1 0))
    (defn qkns-after-evidence? (moved result)
        (do
            (let text (fknss-after-text moved))
            (if (not (eq (str_find text "observed " 0) 0)) 0
                (if (not (eq (qkns-has? text (qkns-concept)) 1)) 0
                (if (not (eq (qkns-has? text (fknq-source-path result)) 1)) 0
                (if (not (eq (qkns-has? text
                    (fknq-node-key (fknq-source result))) 1)) 0
                (if (not (eq (qkns-has? text
                    (fknq-node-key (fknq-entry result))) 1)) 0
                (if (not (eq (qkns-has? text
                    (fknq-node-key (fknq-request result))) 1)) 0
                (if (not (eq (qkns-has? text
                    (fknq-node-key (fknq-executor result))) 1)) 0
                (if (not (eq (qkns-has? text
                    (fknq-node-key (fknq-observation result))) 1)) 0
                (if (not (eq (qkns-has? text (fknq-node-key
                    (fknq-existing-current-observation result))) 1)) 0
                    1)))))))))))
    (defn qkns-prompt ()
        (do
            (let surface (fknq-concept-surface (qkns-concept)))
            (fhcs-cat (list
                "You are in one resident local Form knowledge session. "
                "Request the current public Form definition indexed by concept `"
                (qkns-concept)
                "` by outputting exactly this one control frame with no prose before it:\n"
                surface
                "\nWhen Form returns the typed observation, do not request again. "
                "Use its answer, source path, source/entry/request/executor/observation "
                "NodeIDs, current-source observation NodeID, status and lifecycle. "
                "Reply with one concise ASCII line beginning `observed `."))))

    (let root (fhcs-default-root))
    (if (str_eq root "")
        (do
            (qkns-line "status" "failure")
            (qkns-line "reason" "body-root-unresolved")
            0)
        (do
            (let artifact (fknq-default-artifact))
            (let exec-ctx (fknsc-public-context root artifact 0
                (fknq-max-frame-bytes)))
            (let started (now_unix_ms))
            (let opened (fcms-open (qkns-path) (qkns-prompt) 2048))
            (let open-ms (sub (now_unix_ms) started))
            (if (not (eq (fcms-live? opened) 1))
                (do
                    (qkns-line "status" (fcms-status opened))
                    (qkns-line "reason" (fcms-reason opened))
                    (qkns-int "open-ms" open-ms)
                    0)
                (do
                    (let moved (fknss-run-with opened 192 exec-ctx
                        fknqr-public-strict-executor))
                    (let ended (now_unix_ms))
                    (let s (fknss-session moved))
                    (let c (fknss-cursor moved))
                    (qkns-line "model-before" (fknss-before-text moved))
                    (qkns-line "form-injected" (fknss-injected-text moved))
                    (qkns-line "model-after" (fknss-after-text moved))
                    (qkns-int "open-ms" open-ms)
                    (qkns-int "movement-ms" (sub ended (add started open-ms)))
                    (qkns-int "prompt-ids" (fcms-prompt-ids s))
                    (qkns-int "model-before-ids" (len (fknss-before-ids moved)))
                    (qkns-int "model-after-ids" (len (fknss-after-ids moved)))
                    (qkns-int "model-bytes" (fknss-model-bytes moved))
                    (qkns-int "injected-ids" (fcms-injected-ids s))
                    (qkns-int "injected-bytes" (fknss-injected-bytes moved))
                    (qkns-int "observation-count" (fcms-observations s))
                    (qkns-int "callback-calls" (fknss-callback-calls moved))
                    (qkns-int "lookup-count" (fknss-lookup-count moved))
                    (qkns-line "executor-policy"
                        "strict-concept-key-bucket-no-linear-fallback")
                    (qkns-int "model-executed-form"
                        (fknss-model-executed-form? moved))
                    (qkns-line "generated-id-policy"
                        (fcms-generated-id-policy))
                    (qkns-line "resume-encode-scope"
                        (fcms-resume-encode-scope))
                    (qkns-line "cursor-terminal" (fknsc-terminal c))
                    (let crossed (fknss-crossed? moved))
                    (if (eq crossed 1)
                        (do
                            (let result (fknss-bridge-result moved))
                            (qkns-line "status" (fknq-status result))
                            (qkns-line "reason" (fknq-reason result))
                            (qkns-line "source-node"
                                (fknq-node-key
                                    (fknq-source-original-of result)))
                            (qkns-line "entry-node"
                                (fknq-node-key
                                    (fknq-entry-original-of result)))
                            (qkns-line "bridge-source-node"
                                (fknq-node-key (fknq-source result)))
                            (qkns-line "bridge-entry-node"
                                (fknq-node-key (fknq-entry result)))
                            (qkns-line "request-node"
                                (fknq-node-key (fknq-request result)))
                            (qkns-line "request-kind"
                                (fknq-request-kind (fknq-request result)))
                            (qkns-line "request-coordinate"
                                (fknq-request-coordinate (fknq-request result)))
                            (qkns-line "executor-node"
                                (fknq-node-key (fknq-executor result)))
                            (qkns-line "observation-node"
                                (fknq-node-key (fknq-observation result)))
                            (qkns-line "current-source-observation-node"
                                (fknq-node-key
                                    (fknq-existing-current-observation result)))
                            (qkns-line "source-path"
                                (fknq-source-path result))
                            (qkns-line "lifecycle"
                                (fknq-trace-actions (fknq-trace result)))
                            (qkns-int "fresh" (fknq-fresh? result))
                            (qkns-int "rebuild-needed"
                                (fknq-rebuild? result))
                            (qkns-int "pretokenized"
                                (fknq-pretokenized? result))
                            (qkns-int "scannerless"
                                (fknq-scannerless? result))) 0)
                    (let release-ok (fcms-release-ok? s))
                    (qkns-int "release-ok" release-ok)
                    (if (not (eq crossed 1)) 0
                        (do
                            (let result (fknss-bridge-result moved))
                            (sum (list
                                (qkns-bit (eq crossed 1) 1)
                                (qkns-bit
                                    (eq (fknss-callback-calls moved) 1) 2)
                                (qkns-bit (eq (fknss-lookup-count moved) 1) 4)
                                (qkns-bit (str_eq (fknq-status result) "hit") 8)
                                (qkns-bit (and
                                    (node_eq (node_category (fknss-source moved))
                                             (fknq-source-category))
                                    (and
                                    (node_eq (node_category (fknss-entry moved))
                                             (fknq-entry-category))
                                    (and
                                    (node_eq (node_category (fknss-request moved))
                                             (fknq-request-category))
                                    (and
                                    (node_eq (node_category (fknss-executor moved))
                                             (fknq-executor-category))
                                    (node_eq (node_category
                                                (fknss-observation moved))
                                             (fknq-observation-category)))))) 16)
                                (qkns-bit (and
                                    (eq (psci-source-node-valid?
                                        (fknq-source-original-of result)) 1)
                                    (eq (psci-entry-valid?
                                        (fknq-entry-original-of result)) 1)) 32)
                                (qkns-bit (node_eq (node_category
                                    (fknss-current-observation moved))
                                    (fhcs-observation-category)) 64)
                                (qkns-bit (and
                                    (eq (fknq-model-executed? result) 0)
                                    (eq (fknss-model-executed-form? moved) 0))
                                    128)
                                (qkns-bit (and
                                    (eq (fcms-observations s) 1)
                                    (gt (fcms-injected-ids s) 0)) 256)
                                (qkns-bit (and
                                    (str_eq (fknq-request-kind
                                        (fknq-request result)) "concept")
                                    (str_eq (fknq-request-coordinate
                                        (fknq-request result))
                                        (qkns-concept))) 512)
                                (qkns-bit
                                    (eq (qkns-after-evidence? moved result) 1)
                                    1024)
                                (qkns-bit (and
                                    (node_eq (head (fcms-ctx opened))
                                             (head (fcms-ctx s)))
                                    (node_eq (head (fcms-sts opened))
                                             (head (fcms-sts s)))) 2048)
                                (qkns-bit (and
                                    (eq (fknq-pretokenized? result) 0)
                                    (eq (fknq-scannerless? result) 1)) 4096)
                                (qkns-bit (and
                                    (str_eq (fknq-source-path result)
                                        "form/form-stdlib/public-source-concept-index.fk")
                                    (gt (str_len (fknq-answer result)) 0)) 8192)
                                (qkns-bit (eq release-ok 1) 16384))))))))))
