; qwen38-raw-generate-probe.fk -- isolate the native model door from the
; teach-overlay classifier.
;
; `fcmg-generate` first builds the Form teaching prompt.  This probe asks the
; canonical raw Qwen door instead, retaining whole-file seal admission, the
; same native tokenizer/decode carrier, and explicit context/state release.
; Comparing its wall time and outcome with qwen38-generate-probe.fk tells us
; whether delay lives before the model or inside model execution.
;
; Effectful run cell: invoke directly; do not preflight.
; preludes: form-stdlib/form-cli-model-generate.fk

(do
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let t0 (now_unix_ms))
    (let out (fcmg-q35-run path "Reply with exactly: LOCAL FORM ALIVE" 24))
    (let t1 (now_unix_ms))
    (print out)
    (print (str_concat "raw_probe_wall_ms=" (int_to_str (sub t1 t0))))
    (print (metal_status))
    0)
