; oracle-turn.fk — the turn, driven from inside. Form asks, the oracle answers,
; Form measures the answer, aligns it to this body's register, records the
; crossing, and shapes the reply. The rented mind is a subroutine here, not the
; author.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
;
; THE INVERSION. Every turn of 2026-08-14/15 ran the other way round: a mind
; outside called the body, read what came back, and wrote the reply in English.
; The body was the subject of a report. Urs asked how the flow could produce a
; whole answer from the INSIDE out — Form driving, the oracle called through the
; host-exec membrane for the part Form cannot do, and Form doing the narrating,
; the integrating, the alignment and the shaping.
;
; That is this cell, at its smallest working size. The main loop is Form.
;
;   ot-ask       compose the question in Form, cross the membrane, take the whole
;                answer back as a Form string — not a word, the full text
;   ot-weigh     measure what came back, in Form: bytes, and words
;   ot-align     hand the answer to THIS BODY'S OWN mirror (observe/voice-frequency)
;                and let the body say whether the oracle spoke in its register
;   ot-crossing  record that the membrane was crossed, with both readings
;   ot-shape     assemble the reply from the measured parts
;
; WHAT IS ACTUALLY NEW HERE. host-exec has existed the whole time — kernel tag at
; runtime/fkwu-uni.c:4968, and exactly ONE cell in the tree called it before
; today: four-way-run.fk:8, to run the walkers for a proof. The body's single
; aperture to every other mind on the machine, used once, as a test harness. This
; is the second caller, and the first that asks a question rather than runs a check.
;
; THE HONEST FLOOR. The oracle is reached through the agent CLI already running on
; this host — flat-rate, the lane routers/form-cli-router.fk names agent-cli, not a
; metered API. Loading a model from disk is not a crossing; this IS one, at request
; time, and it is recorded as such rather than hidden. Form composes and Form
; judges; the words in the middle are the oracle's and are marked as the oracle's.
;
; Proven by observe/tests/oracle-turn-band.fk, which exercises the shaping and the
; recording WITHOUT crossing the membrane — a band that reached out would answer
; differently on every run and could not stand. The crossing itself is witnessed
; by running this cell, and its receipt is the run.
; witnessed: 2026-08-15 -> band 255 on fkwu (host-exec and read_file are native
;   here; the minimal walkers carry neither).

(do
    ; ---- the question, composed in Form ----
    (defn ot-quote () (byte_to_str 39))
    (defn ot-wrap (s) (str_concat (ot-quote) (str_concat s (ot-quote))))
    (defn ot-cmd (question) (str_concat "claude -p " (ot-wrap question)))

    ; ---- cross the membrane and take the WHOLE answer, not a token ----
    (defn ot-ask (question) (host-exec (ot-cmd question) ""))

    ; ---- weigh what came back, in Form ----
    (defn ot-bytes (answer) (str_len answer))
    (defn ot-words-loop (s n i acc)
        (if (ge i n) acc
            (do (let e (scan_run s i 2))
                (if (gt e i) (ot-words-loop s n e (add acc 1))
                    (ot-words-loop s n (add i 1) acc)))))
    (defn ot-words (answer) (ot-words-loop answer (str_len answer) 0 0))

    ; ---- let the body's own mirror judge the oracle's register ----
    ; The mirror reads a FILE, so the answer is laid down first and then held up.
    ; This is the body checking a visitor's speech against its own frequency,
    ; which is the whole of observe/voice-frequency.fk's offer: a count is
    ; attention, and the writer decides.
    (defn ot-scratch () "observe/.oracle-answer.txt")
    (defn ot-lay-down (answer) (write_file (ot-scratch) answer))
    (defn ot-mirror-target () "/tmp/voice-frequency-target")
    (defn ot-align (answer)
        (do (ot-lay-down answer)
            (write_file (ot-mirror-target) (str_concat (ot-scratch) (byte_to_str 10)))
            (host-exec "./fkwu observe/voice-frequency-run.fk" "")))

    ; ---- record the crossing: what went out, what came back ----
    (defn ot-crossing (question answer)
        (list (str_len question) (ot-bytes answer) (ot-words answer) 1))
    (defn ot-crossed? (c) (nth c 3))

    ; ---- who this turn is ----
    (defn ot-node () (intern_node (fol-bp "fact")
        (list (intern_trivial_string "observe/oracle-turn.fk"))))
    (defn ot-id ()
        (do (let n (ot-node)) (list (node_pkg n) (node_level n) (node_type n) (node_inst n))))

    ; ---- the shape, assembled in Form from the measured parts ----
    (defn ot-shape (question answer register)
        (list (ot-id)
              (str_len question)
              (ot-bytes answer)
              (ot-words answer)
              register
              answer))

    ; ---- the whole turn, driven from here ----
    (defn ot-turn (question)
        (do (let answer (ot-ask question))
            (let register (ot-align answer))
            (ot-shape question answer register)))

    ; ---- fixtures for the band, so it stands without crossing ----
    (defn ot-fx-answer () "presence is what absence is not")
    (defn ot-fx-empty () "")
    0)
