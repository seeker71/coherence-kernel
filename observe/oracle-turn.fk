; oracle-turn.fk — the turn, driven from inside. Form asks, the oracle answers,
; Form weighs it, aligns it, records the crossing, and shapes the reply.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk observe/crossing-record.fk
;
;   ot-cmd         the question, composed in Form and quoted for the host
;   ot-ask         crosses through xc-exec, so the crossing writes its own row
;   ot-bytes /
;   ot-alpha-runs  weigh what came back — bytes, and alpha runs (NOT words: the
;                  first real turn read 84 runs and 85 words, an em-dash apart)
;   ot-align       hand it to this body's own mirror and let the body read the
;                  visitor's register
;   ot-shape       assemble the reply from the measured parts
;
; host-exec is the body's aperture outward (runtime/fkwu-uni.c:4968). Before
; 2026-08-15 one cell in the tree called it — four-way-run.fk:8, to run the walkers
; for a proof. This is the second, and the first that asks rather than checks.
;
; The oracle is reached through the agent CLI already on this host — the flat-rate
; lane routers/form-cli-router.fk names agent-cli, not a metered API. Loading a
; model from disk is not a crossing; this IS one, at request time, and it is
; recorded as such.
;
; THE CLAIMS ARE BITS. tests/oracle-turn-band.fk, which does NOT cross — a band
; that reached out would answer differently every run:
;   b1,b2   the question is composed in Form and carries the verb that reaches out
;   b3,b4   an answer weighs what it weighs; nothing weighs nothing
;   b5,b6   the crossing records both sides and says it crossed
;   b7      the turn has an address
;   b8      two answers weigh apart
;
; WITNESSED BY RUNNING IT, 2026-08-15: 103 bytes out, 468 back, 84 alpha runs,
; register clear, id 0.2.99.3. The crossing is its own receipt.
; witnessed: 2026-08-15 -> band 255 on fkwu.

(do
    ; ---- the question, composed in Form ----
    (defn ot-quote () (byte_to_str 39))
    (defn ot-wrap (s) (str_concat (ot-quote) (str_concat s (ot-quote))))
    (defn ot-cmd (question) (str_concat "claude -p " (ot-wrap question)))

    ; ---- cross the membrane and take the WHOLE answer, not a token ----
    ; through xc-exec, not host-exec: the crossing writes its own row before the
    ; answer comes back, so the ledger stops being testimony.
    (defn ot-ask (question) (xc-exec (ot-cmd question) ""))

    ; ---- weigh what came back, in Form ----
    (defn ot-bytes (answer) (str_len answer))
    (defn ot-alpha-loop (s n i acc)
        (if (ge i n) acc
            (do (let e (scan_run s i 2))
                (if (gt e i) (ot-alpha-loop s n e (add acc 1))
                    (ot-alpha-loop s n (add i 1) acc)))))
    ; NAMED FOR WHAT IT COUNTS (2026-08-15). This was ot-words, and it counts
    ; ALPHA RUNS — scan_run class 2 — which is not the same as words. On the first
    ; real turn the answer read 84 runs and 85 words: the em-dash in "repairable —
    ; when" is a word to a plain counter and no alpha run at all. I reported 84 as
    ; a word count on the page and in the artifact. The header had said "alpha
    ; runs" the whole time; the caller renamed the number as it passed.
    (defn ot-alpha-runs (answer) (ot-alpha-loop answer (str_len answer) 0 0))

    ; ---- let the body's own mirror judge the oracle's register ----
    ; The mirror reads a FILE, so the answer is laid down first and then held up.
    ; This is the body checking a visitor's speech against its own frequency,
    ; which is the whole of observe/voice-frequency.fk's offer: a count is
    ; attention, and the writer decides.
    (defn ot-scratch () "observe/.oracle-answer.txt")
    (defn ot-lay-down (answer) (write_file (ot-scratch) answer))
    (defn ot-mirror-target () "/tmp/voice-frequency-target")
    (defn ot-align (answer)
        (do (ot-lay-down answer)
            (write_file (ot-mirror-target) (str_concat (ot-scratch) (byte_to_str 10)))
            (host-exec "./fkwu observe/voice-frequency-run.fk" "")))

    ; ---- record the crossing: what went out, what came back ----
    (defn ot-crossing (question answer)
        (list (str_len question) (ot-bytes answer) (ot-alpha-runs answer) 1))
    (defn ot-crossed? (c) (nth c 3))

    ; ---- who this turn is ----
    (defn ot-node () (intern_node (fol-bp "fact")
        (list (intern_trivial_string "observe/oracle-turn.fk"))))
    (defn ot-id ()
        (do (let n (ot-node)) (list (node_pkg n) (node_level n) (node_type n) (node_inst n))))

    ; ---- the shape, assembled in Form from the measured parts ----
    (defn ot-shape (question answer register)
        (list (ot-id)
              (str_len question)
              (ot-bytes answer)
              (ot-alpha-runs answer)
              register
              answer))

    ; ---- the whole turn, driven from here ----
    (defn ot-turn (question)
        (do (let answer (ot-ask question))
            (let register (ot-align answer))
            (ot-shape question answer register)))

    ; ---- fixtures for the band, so it stands without crossing ----
    (defn ot-fx-answer () "presence is what absence is not")
    (defn ot-fx-empty () "")
    0)
