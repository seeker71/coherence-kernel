; preludes: cognition/form-neutral-word-field.fk
; preludes: cognition/response-word-field-dictionary.fk

(do
    (print "semantic-field.axes=") (print (int_to_str (fwf-axis-count)))
    (print " seed-status=authored seed-check=") (print (int_to_str (fwf-check)))
    (print "\nresponse-field.cells=") (print (int_to_str (rwfd-count)))
    (print " lexical=") (print (int_to_str (rwfd-kind-count (rwfd-kind-lexical))))
    (print " functional=") (print (int_to_str (rwfd-kind-count (rwfd-kind-functional))))
    (print " carrier=") (print (int_to_str (rwfd-kind-count (rwfd-kind-carrier))))
    (print " inflection=") (print (int_to_str (rwfd-kind-count (rwfd-kind-inflection))))
    (print " unique-surfaces=") (print (int_to_str (rwfd-unique-count)))
    (print " ambiguous-surfaces=") (print (int_to_str (rwfd-ambiguous-count)))
    (print " closed=") (print (int_to_str (rwfd-all-desc-closed?)))
    (print " check=") (print (int_to_str (rwfd-check)))
    (print "\nlove->trust.wake=") (print (fwf-wake "love" "trust"))
    (print "\ntrust->love.wake=") (print (fwf-wake "trust" "love"))
    (print "\nnative->review.wake=") (print (rwfd-wake "native" "review"))
    (print "\n")
    0)
