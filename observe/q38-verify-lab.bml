// q38-verify-lab.bml — the matmul of the check span (8 tokens): the exact-association matvec (mvr), the lane's 64 x 32-token matrix-unit kernel
// (pipeline 62), the short-span staged kernels, their half-operand twins and the fragment kernels (qwen35-dense-mm.fk), raced on real tensors,
// best of rounds, in one process.
//
//   echo '{"go":1,"which":0,"cold":1,"set":"all"}' | ./fkwu observe/q38-verify-lab.bml
// stdin, one JSON line, all optional: go, which (0 gate, 1 down, 2 head, 3 an attention-sized 1024-row tensor, 4 the 5120-row qkv-sized one), rounds (8),
// cold (1: a different layer's tensor each dispatch, so the weights come from DRAM; 0: one tensor, hot), set (all, staged, half, frag), prompt.
// Every variant is timed in turn, round after round (the GPU changes speed between seconds); the best round is the reading. Outputs are compared
// word for word with pipeline 62's (staged kernels: same accumulation chain, expected 0 differing words) and by absolute gap (half, fragment).
// The pipeline table holds 128: the lab builds only its own kernels (the lane's 63, the spec's exact base, and the set asked for).
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/form-cli-model-session.fk native/metal/qwen35-dense-spec.fk native/metal/qwen35-dense-mm.fk
section [form.bml] {
 class Q38VerifyLab {
  def qvl-file() = "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
  def qvl-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def qvl-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def qvl-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("q38-verify-lab", line) : json-node-object([]);
  }
  def qvl-say(s) = print_str("[q38-verify-lab] " ++ s);
  def qvl-min(xs, m) = len(xs) == 0 ? m : qvl-min(xs[1:], xs[0] < m ? xs[0] : m);
  def qvl-times(n, f) = qvl-times-i(n, 0, f);
  def qvl-times-i(n, i, f) = i >= n ? 1 : {
   let done = f(i);
   qvl-times-i(n, i + 1, f);
  };
  // one round of one variant: 48 dispatches in one batch, ms
  def qvl-round(f) {
   metal_batch_concurrent();
   let t0 = host_monotonic_ms();
   let queued = qvl-times(48, f);
   let synced = metal_sync();
   host_monotonic_ms() - t0;
  }
  def qvl-one(vs, acc) = len(vs) == 0 ? acc : qvl-one(vs[1:], append(acc, [qvl-round(vs[0][1])]));
  def qvl-mins(rows, i, n, acc) = i >= n ? acc : qvl-mins(rows, i + 1, n, append(acc, [qvl-min(foldl((a, row) => append(a, [row[i]]), [], rows), 1000000)]));
  def qvl-race(vs, rounds, rows) = rounds <= 0 ? qvl-mins(rows, 0, len(vs), []) : qvl-race(vs, rounds - 1, append(rows, [qvl-one(vs, [])]));
  def qvl-report(vs, best) = len(vs) == 0 ? 1 : {
   qvl-say(vs[0][0] ++ ": " ++ ((best[0] * 1000) / 48).str() ++ " us each");
   qvl-report(vs[1:], best[1:]);
  };
  // words that differ between two float rows, widest gap in ulp
  def qvl-ulp-go(a, b, i, n, cnt, widest) = i >= n ? [cnt, widest] : {
   let wa = ln-u32-le(a, i * 4);
   let wb = ln-u32-le(b, i * 4);
   let d = wa > wb ? wa - wb : wb - wa;
   qvl-ulp-go(a, b, i + 1, n, d > 0 ? cnt + 1 : cnt, d > widest ? d : widest);
  };
  // the widest absolute gap between two float rows and the widest value of the reference
  def qvl-err-go(a, b, i, n, gap, top) = i >= n ? [gap, top] : {
   let fa = ln-f32-decode(ln-u32-le(a, i * 4));
   let fb = ln-f32-decode(ln-u32-le(b, i * 4));
   let d = fa > fb ? fa - fb : fb - fa;
   let m = fb > 0 - fb ? fb : 0 - fb;
   qvl-err-go(a, b, i + 1, n, d > gap ? d : gap, m > top ? m : top);
  };
  def qvl-err(label, ya, yb, n) {
   let r = qvl-err-go(metal_buf_read(ya, 0, n * 4), metal_buf_read(yb, 0, n * 4), 0, n, 0.0, 0.0);
   qvl-say(label ++ ": widest gap " ++ ((r[0] * 1000000.0) / 1).str() ++ " e-6, the reference's widest value " ++ r[1].str() ++ ", relative " ++ ((r[0] * 1000000.0) / (r[1] + 0.000001)).str() ++ " e-6");
  }
  def qvl-compare(label, ya, yb, n) {
   let ba = metal_buf_read(ya, 0, n * 4);
   let bb = metal_buf_read(yb, 0, n * 4);
   let r = qvl-ulp-go(ba, bb, 0, n, 0, 0);
   qvl-say(label ++ ": " ++ r[0].str() ++ " of " ++ n.str() ++ " words differ, widest " ++ r[1].str() ++ " ulp");
  }
  // the kernels of the lab, by set: staged [tn, kb, rt, fz], half [tn, kb, rt], fragment [ts, sgr, slices, fz]
  def qvl-fvars(set) = (String) set == "all" || (String) set == "staged" ? [[8, 1, 64, 0], [8, 2, 64, 0], [8, 1, 32, 0], [8, 1, 16, 0]] : [];
  def qvl-hvars(set) = (String) set == "all" || (String) set == "half" ? [[8, 1, 64], [8, 1, 16]] : [];
  def qvl-gvars(set) = (String) set == "all" || (String) set == "frag" ? [[4, 2, 1, 0], [4, 1, 4, 0], [2, 2, 2, 0], [2, 1, 4, 0], [4, 2, 1, 2], [4, 1, 4, 2], [2, 2, 2, 2], [2, 1, 4, 2], [4, 1, 2, 2], [4, 1, 8, 2]] : [];
  def qvl-ltext(set) = "#include <metal_stdlib>\n" ++ (q38m-msl-go(qvl-fvars(set)) ++ (q38m-hmsl-go(qvl-hvars(set)) ++ q38f-msl-go(qvl-gvars(set))));
  def qvl-lpipes(msl, set) = append(append(q38m-pipes-go(msl, qvl-fvars(set)), q38m-hpipes-go(msl, qvl-hvars(set))), q38f-pipes-go(msl, qvl-gvars(set)));
  def qvl-nf(set) = len(qvl-fvars(set));
  def qvl-nh(set) = len(qvl-hvars(set));
  def qvl-ng(set) = len(qvl-gvars(set));
  // tvf(i) is the tensor the i-th dispatch of a round reads: one tensor (hot) or a different layer's (cold)
  def qvl-variants(ctx, qs, ms, tvf, nt, ys, set) {
   let ps = ctx[0];
   let bs = ctx[1];
   let rows = kth-tv-r(tvf(0));
   let xh = bs[1];
   let nf = qvl-nf(set);
   let nh = qvl-nh(set);
   let fv = qvl-fvars(set);
   let hv = qvl-hvars(set);
   let gv = qvl-gvars(set);
   let base = [
    ["mvr (exact association, " ++ (q38s-rows-for(nt)).str() ++ " rows a group)", (i) => q38s-mv(ps, qs, tvf(i), xh, ys[0], nt, rows, 1)],
    ["mm64 (pipeline 62, the lane)", (i) => q38-mv-batch-y(ps, tvf(i), xh, ys[1], nt, rows, 1)],
    ["decode matvec (1 token)", (i) => q38-mv(ps, tvf(i), xh, ys[2], 1)]
   ];
   let staged = map(i => ["staged tn " ++ fv[i][0].str() ++ " kb " ++ fv[i][1].str() ++ " rt " ++ fv[i][2].str(), (j) => metal_enqueue(ms[i], md-bind16([kth-tv-h(tvf(j)), xh, ys[3 + i]], [rows, kth-tv-c(tvf(j)), nt, rows], 2 * fv[i][2], 0, 1, 1), q38m-groups(rows, nt, fv[i][0], fv[i][2]))], range(0, nf));
   let half = map(i => ["HALF kb " ++ hv[i][1].str() ++ " rt " ++ hv[i][2].str(), (j) => metal_enqueue(ms[nf + i], md-bind16([kth-tv-h(tvf(j)), xh, ys[3 + nf + i]], [rows, kth-tv-c(tvf(j)), nt, rows], 2 * hv[i][2], 0, 1, 1), q38m-groups(rows, nt, hv[i][0], hv[i][2]))], range(0, nh));
   let frag = map(i => ["FRAG" ++ (gv[i][3] >= 2 ? "-BS" : "") ++ " ts " ++ gv[i][0].str() ++ " sgr " ++ gv[i][1].str() ++ " slices " ++ gv[i][2].str(), (j) => metal_enqueue(ms[nf + nh + i], md-bind16([kth-tv-h(tvf(j)), xh, ys[3 + nf + nh + i]], [rows, kth-tv-c(tvf(j)), nt, rows], 32 * gv[i][1] * gv[i][2], 0, 1, 1), q38f-groups(rows, gv[i][0], gv[i][1]))], range(0, qvl-ng(set)));
   append(append(append(base, staged), half), frag);
  }
  def qvl-alloc(n, k) = k <= 0 ? [] : cons(metal_buf_alloc(n), qvl-alloc(n, k - 1));
  def qvl-tensor(ctx, which) = which == 0 ? nth(ctx, 3)[0][2] : (which == 1 ? nth(ctx, 3)[0][4] : (which == 2 ? ctx[6] : (which == 3 ? nth(ctx, 3)[3][6] : nth(ctx, 3)[0][5])));
  def qvl-lab(ctx, qs, ms, nt, which, rounds, cold, set) {
   let tv = qvl-tensor(ctx, which);
   let rows = kth-tv-r(tv);
   let iscold = cold == 1 && which < 2;
   qvl-say("tensor " ++ rows.str() ++ " x " ++ kth-tv-c(tv).str() ++ ", " ++ nt.str() ++ " tokens, " ++ (iscold ? "cold (a different layer's tensor each dispatch)" : "hot (one tensor)") ++ ", set " ++ set);
   let nf = qvl-nf(set);
   let nh = qvl-nh(set);
   let ys = qvl-alloc(rows * 16 * 4 + 4096, 3 + nf + nh + qvl-ng(set));
   let vs = qvl-variants(ctx, qs, ms, (i) => iscold ? nth(ctx[3], i % 64)[which == 0 ? 2 : 4] : tv, nt, ys, set);
   let warm = qvl-one(vs, []);
   let best = qvl-race(vs, rounds, []);
   let r = qvl-report(vs, best);
   let n = rows * nt;
   let cs = map(i => qvl-compare("staged " ++ qvl-fvars(set)[i][1].str() ++ "/" ++ qvl-fvars(set)[i][2].str() ++ " vs mm64", ys[3 + i], ys[1], n), range(0, nf));
   let ch = map(i => qvl-err("HALF " ++ qvl-hvars(set)[i][1].str() ++ "/" ++ qvl-hvars(set)[i][2].str() ++ " vs mm64 (fp32)", ys[3 + nf + i], ys[1], n), range(0, nh));
   let cg = map(i => qvl-err("FRAG" ++ (qvl-gvars(set)[i][3] >= 2 ? "-BS " : " ") ++ qvl-gvars(set)[i][0].str() ++ "/" ++ qvl-gvars(set)[i][1].str() ++ "/" ++ qvl-gvars(set)[i][2].str() ++ " vs mm64 (fp32)", ys[3 + nf + nh + i], ys[1], n), range(0, qvl-ng(set)));
   let freed = map(y => metal_buf_free(y), ys);
   1;
  }
  // which 9: the gate (cold), the down (cold), the head and an attention-sized 1024-row tensor (hot) in one open
  def qvl-many(ctx, qs, ms, nt, rounds, cold, set) {
   let a = qvl-lab(ctx, qs, ms, nt, 0, rounds, 1, set);
   let b = qvl-lab(ctx, qs, ms, nt, 1, rounds, 1, set);
   let c = qvl-lab(ctx, qs, ms, nt, 2, rounds, 0, set);
   let d = qvl-lab(ctx, qs, ms, nt, 3, rounds, 0, set);
   1;
  }
  def qvl-run-open(path, nt, which, rounds, prompt, cold, set) {
   let src = fcmg-src(path);
   let ids = q35-chat-ids(src, prompt);
   let maxpos = len(ids) + 16;
   let own = fcms-qwen-own(src, maxpos);
   let weights = fcms-weights-bytes(path);
   let granted = mg-lease("q38 verify lab", path, weights, own);
   !mg-granted?(granted) ? qvl-say("held: " ++ granted[1]) : {
    let ctx = q38-open-span(path, maxpos, len(ids) + 1);
    !((Comparable) q38-context-ok?(ctx) == 1) ? qvl-say("the context did not open") : {
     let qs = q38s-pipes-base(q38s-msl());
     let ltext = qvl-ltext(set);
     let ms = qvl-lpipes(ltext, set);
     let sts = q38-new-state(ctx[2]);
     let r = q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
     let lab = !kth-pipes-ok?(qs) ? qvl-say("spec pipelines did not compile") : (!kth-pipes-ok?(ms) ? qvl-say("lab pipelines did not compile: " ++ ms.str() ++ " " ++ metal_status()) : (which == 9 ? qvl-many(ctx, qs, ms, nt, rounds, cold, set) : qvl-lab(ctx, qs, ms, nt, which, rounds, cold, set)));
     let freed = q38-free-state(sts);
     let closed = q38-close(ctx, []);
     1;
    };
    let unleased = mg-release();
    qvl-say("released");
   };
  }
  def qvl-run() {
   let opts = qvl-opts();
   (Comparable) qvl-int(opts, "go", 0) == 1 ? qvl-run-open(qvl-file(), qvl-int(opts, "nt", 8), qvl-int(opts, "which", 0), qvl-int(opts, "rounds", 8), qvl-text(opts, "prompt", "Explain in two sentences why the sky is blue."), qvl-int(opts, "cold", 0), qvl-text(opts, "set", "all")) : qvl-say("plan: go=1 (cold 1: a different layer's tensor each dispatch; set all|staged|half|frag) races the check span's matmuls on a tensor at nt tokens");
  }
 }
 qvl-run();
}
