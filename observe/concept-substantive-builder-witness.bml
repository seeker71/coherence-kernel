// A complete private snapshot exercises the public deterministic workflow.
// preludes: form-stdlib/bml/concept-substantive-workflow.bml form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class SubstantivePublicWitness {
  def csws-assert(ok,aspect) = if ok then 1 else form_error(str_concat("public substantive witness refused: ",aspect));
  def csws-copy(input,root,paths) {
   if nil?(paths) then 1 else csws-copy-one(input,root,head(paths),tail(paths));
  }
  def csws-copy-one(input,root,path,rest) {
   let destination = nsi-path(root,path); let bytes = csa-file(input,path);
   if fs_exists(destination) then csws-assert(str_eq(read_file(destination),bytes),"same-held-snapshot-source") else csws-assert(eq(write_file(destination,bytes),str_len(bytes)),"complete-snapshot-write");
   let back = fbc-read-exact(destination,0);
   csws-assert(and(fbc-good(back),str_eq(fbc-value(back),bytes)),"exact-snapshot-readback");
   csws-copy(input,root,rest);
  }
  def csws-prepared() {
   let substantive = csb-prepare(".","arm64-sha256");
   let materialized = cmm-freeze(cmm-validate(cmm-prepare(".","arm64-sha256")));
   let roundtrip = crb-complete(crb-prepare(".","arm64-sha256"));
   cmm-freeze-outputs(record_get(roundtrip,"input"),record_get(roundtrip,"outputs"));
   let corpus = chr-complete(chr-prepare(".","arm64-sha256"));
   cmm-freeze-outputs(record_get(corpus,"input"),record_get(corpus,"outputs"));
   list(substantive,materialized,roundtrip,corpus);
  }
  def csws-snapshots(root,prepared) {
   if nil?(prepared) then 1 else csws-snapshot(root,head(prepared),tail(prepared));
  }
  def csws-snapshot(root,prepared,rest) {
   let input = record_get(prepared,"input"); let paths = record_get(input,"files");
   csws-assert(csa-fresh(input,paths),"source-fresh-before-snapshot");
   csws-copy(input,root,paths);
   csws-assert(csa-fresh(input,paths),"source-fresh-after-snapshot");
   csws-snapshots(root,rest);
  }
  def csws-outputs(root,outputs) = if nil?(outputs) then 0 else csws-output(root,head(outputs),tail(outputs));
  def csws-output(root,output,rest) {
   let back = fbc-read-exact(nsi-path(root,head(output)),0);
   csws-assert(and(fbc-good(back),str_eq(fbc-value(back),nth(output,1))),"exact-public-workflow-artifact");
   add(1,csws-outputs(root,rest));
  }
  def csws-all(root,prepared) = if nil?(prepared) then 0 else add(csws-outputs(root,record_get(head(prepared),"outputs")),csws-all(root,tail(prepared)));
  def csws-capture(target,request) {
   let job = nsi-job(); let input = nsi-path(job,"request.json");
   csws-assert(eq(write_file(input,request),str_len(request)),"complete-private-request");
   let output = nsi-path(job,"stdout"); let errors = nsi-path(job,"stderr");
   let pid = host_spawn_at(list("./fkwu",target),list(input,output,errors));
   let status = if or(nothing?(pid),le(pid,0)) then -1 else host_wait(pid);
   let text = read_file(output); let err = read_file(errors);
   let complete = and(nsi-exact(output,text),nsi-exact(errors,err));
   let report = json-emit-precise(json-node-object(list(oh-s("schema","substantive-public-capture-v1"),oh-n("pid",pid),oh-n("exit",status),oh-n("complete",complete),oh-n("stdout_bytes",file_size(output)),oh-n("stderr_bytes",file_size(errors)))));
   csws-assert(eq(write_file(nsi-path(job,"capture.json"),report),str_len(report)),"retained-child-status");
   print(list("public-workflow-capture",job,"exit",status,"complete",complete,"stderr",file_size(errors)));
   csws-assert(and(complete,and(eq(status,0),eq(file_size(errors),0))),"complete-successful-public-child");
   job;
  }
  def csws-runtime(root) {
   let state = cmm-state(root,"arm64-sha256");
   let template = read_file("observe/concept-substantive-runtime-witness.bml");
   let a = cmm-one(state,template," model/concept-10000-substantive-repair-data.fk ",str_concat(" ",str_concat(nsi-path(root,csb-path("-data.fk"))," ")));
   let b = cmm-one(state,a," cognition/concept-10000-substantive-repair-111-nl-data.fk\n",str_concat(" ",str_concat(nsi-path(root,csb-nl("-data.fk")),"\n")));
   let source = cmm-one(state,b,"let root = \".\";",str_concat("let root = ",str_concat(json-emit-precise(json-node-string(root)),";")));
   let path = nsi-path(root,"runtime.bml");
   csws-assert(eq(write_file(path,source),str_len(source)),"complete-runtime-witness-source");
   let capture = nsi-capture(list("./fkwu",path));
   print(list("generated-runtime-capture",nsi-evidence(capture),"exit",nsi-status(capture),"output",nsi-text(capture)));
   csws-assert(and(nsi-ok(capture),and(eq(file_size(nsi-path(nsi-evidence(capture),"stderr")),0),ge(str_find(nsi-text(capture),"queried-ids, 10000, boundary-ids, 3, overlay-offsets, 112, rank-list, 111",0),0))),"generated-runtime-executed");
   1;
  }
  def csws-run() {
   let prepared = csws-prepared();
   let root = nsi-directory(".hearth","concept-substantive-public-",0);
   csws-assert(eq(nsi-command(list("/bin/mkdir","-m","700",nsi-path(root,"model"),nsi-path(root,"cognition"),nsi-path(root,"cognition/fixtures"),nsi-path(root,"cognition/fixtures/human-corpus-13"))),0),"private-source-directories");
   csws-snapshots(root,prepared);
   let request = json-emit-precise(json-node-object(list(oh-s("root",root),oh-s("hash","arm64-sha256"))));
   let evidence = csws-capture("observe/concept-substantive-build-run.bml",request);
   let artifacts = csws-all(root,prepared);
   csws-runtime(root);
   let damaged = nsi-path(root,csb-path("-alias-index.dat")); let changed = "owned damaged derived alias";
   csws-assert(and(eq(write_file(damaged,changed),str_len(changed)),str_eq(read_file(damaged),changed)),"actual-derived-carrier-damage");
   let portable = csws-capture("observe/concept-substantive-build-run.bml",json-emit-precise(json-node-object(list(oh-s("root",root)))));
   let restored = csws-all(root,prepared);
   print(list("public-substantive-root",root,"artifacts",artifacts,"restored",restored,"capture",evidence,"portable-capture",portable));
   csws-assert(and(eq(artifacts,21),eq(restored,21)),"all-workflow-artifacts");
  }
 }
 csws-run();
}
