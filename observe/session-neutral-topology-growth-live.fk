; session-neutral-topology-growth-live.fk — live event-selected discourse shape.
; witnessed: 2026-08-24 -> seeds 870587320 timeout, 870612747 nothing,
; 870612836 node continuation; alternatives selected exactly on nothing
; preludes: cognition/session-neutral-topology-growth.fk

(do
  (defn sndtl-proposal-rows (proposals)
    (if (eq (len proposals) 0) (empty)
      (cons (list (sndg-p-draw (head proposals))
              (sndg-clause-role-row (sndg-p-clause (head proposals)))
              (sndg-p-vector (head proposals)))
        (sndtl-proposal-rows (tail proposals)))))
  (defn sndtl-round-rows (rounds)
    (if (eq (len rounds) 0) (empty)
      (cons (list (sndtl-proposal-rows (sndg-r-frontier (head rounds)))
              (sndg-r-selector (head rounds))
              (sndg-r-clause-roles (head rounds)))
        (sndtl-round-rows (tail rounds)))))
  (defn sndtl-sentence-relation-ids (sentences)
    (if (eq (len sentences) 0) (empty)
      (cons (sndtl-relation-ids (sndg-s-relations (head sentences)))
        (sndtl-sentence-relation-ids (tail sentences)))))
  (defn sndtl-relation-ids (relations)
    (if (eq (len relations) 0) (empty)
      (cons (nth (head relations) 2)
        (sndtl-relation-ids (tail relations)))))
  (defn sndtl-print-realizations (realizations)
    (if (eq (len realizations) 0) 0
      (do
        (print "\ncandidate-locale=") (print (sndg-gr-locale (head realizations)))
        (print " candidate-state=") (print (sndg-gr-state (head realizations)))
        (print "\n") (print (sndg-gr-surface (head realizations)))
        (sndtl-print-realizations (tail realizations)))))

  (let seed (snmt-positive
    (bxor (now_unix_ms) (add (kernel_stat 0) (kernel_stat 6)))))
  (let growth (sndt-grow seed))
  (let plan (sndt-w-plan growth))
  (let opened (snmt-open))
  (let runtime (snmt-o-runtime opened))
  (let dictionary (snmt-o-dictionary opened))
  (let paragraph (sndg-w-paragraph growth))
  (let control (sndt-control-result growth))
  (let realizations (sndt-realize-paragraphs runtime dictionary paragraph
    (list "en" "de" "zh" "fr" "ban" "sa")))
  (let graph (sndt-graph growth realizations))

  (print "session-neutral-topology-growth")
  (print "\nvariation-lane=arrival-seeded-pseudo-random-recorded")
  (print "\nseed=") (print (int_to_str seed))
  (print " draw-count=") (print (len (sndg-w-draws growth)))
  (print " clause-count=") (print (sndt-p-clause-count plan))
  (print " sentence-sizes=") (print (sndt-p-sizes plan))
  (print " paragraph-depth=") (print (len (sndg-w-sentences growth)))
  (print " perspective-mode=") (print (nth (sndt-p-perspective plan) 2))
  (print "\ncontrol-kind=") (print (sndt-p-control-kind plan))
  (print " step-budget=") (print (sndt-x-budget control))
  (print " steps-needed=") (print (sndt-x-steps control))
  (print " control-state=") (print (sndt-x-state control))
  (print " ack=")
  (print (if (eq (oac-nothing? (sndt-x-ack control)) 1) "nothing" "node"))
  (print " timed-out=") (print (sndt-x-timed-out control))
  (print " timeout-basis=step-budget-not-wall-clock")
  (print " alternatives-left=") (print (sndt-x-alternatives-left control))
  (print "\nalternative-node-id=") (print (sndt-x-alternative-node control))
  (print " selected-node-id=") (print (sndt-x-selected-node control))
  (print " surface-route=")
  (print (if (str_eq (sndt-x-state control) "continue")
    "active-candidate" "alternative-node"))
  (print " candidate-surfaces-retained-for-observation=1")
  (print "\nsentence-relation-ids=")
  (print (sndtl-sentence-relation-ids (sndg-w-sentences growth)))
  (print " paragraph-relation-ids=")
  (print (sndtl-relation-ids (sndg-g-relations paragraph)))
  (print "\nrounds=[frontier rows(draw roles guidance), selector, selected roles]=")
  (print (sndtl-round-rows (sndg-w-rounds growth)))
  (sndtl-print-realizations realizations)
  (print "\nreversible-graph-edges=") (print (len graph))
  (print " topology-edges=") (print (len (sndt-topology-edges growth)))
  (print " locale-surface-receipts=")
  (print (sndg-surface-receipts graph realizations))
  (print "\n")
  0)
