; train-loop-outcome-ack-live-run.fk — admit the already-created fused local
; authoring model once, then offer the same correlation again to prove that a
; duplicate is refused without a second ledger append.  No MLX/model/Metal or
; network process is opened; only local size/full-hash/size observations cross.
;
; preludes: learn/train-loop-outcome-ack.fk

(do
    (defn tloal-bit (ok bit) (if ok bit 0))
    (defn tloal-ledger () "learn/train-loop-ledger.txt")
    (defn tloal-invocation () "offline-fused-admit-20260826-v2")
    (defn tloal-rows ()
        (do
            (let s (read_file (tloal-ledger)))
            (tloa-count-rows (if (nothing? s) "" s))))

    (defn tloal-retained-row (text)
        (do
            (let at (str_find text (tloa-invocation-mark (tloal-invocation)) 0))
            (if (lt at 0) ""
                (do
                    (let end0 (str_find text "\n" at))
                    (substring text at
                        (if (lt end0 0) (str_len text) end0))))))
    (defn tloal-field (row key)
        (do
            (let mark (str_concat key "="))
            (let at (str_find row mark 0))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len mark)))
                    (let end0 (str_find row "|" start))
                    (substring row start
                        (if (lt end0 0) (str_len row) end0))))))

    (defn tloal-replay-live ()
        (do
            (let before (tloal-rows))
            (let duplicate
                (tloa-run-marker-at (tloal-ledger) (tloal-invocation)
                    "rest-and-fuse" (tlp-authoring-adapter) (tlp-authoring-fused)))
            (let after (tloal-rows))
            (let final-text (read_file (tloal-ledger)))
            (let retained (tloal-retained-row final-text))
            (print_str (tloa-row duplicate))
            (sum (list
                (tloal-bit (eq (tlp-base-ready?) 1) 1)
                (tloal-bit (eq (tlp-adapter-ready? (tlp-authoring-adapter)) 1) 2)
                (tloal-bit (eq (tlp-fused-ready? (tlp-authoring-fused)) 1) 4)
                (tloal-bit (ge (str_find retained "|status=returned|" 0) 0) 8)
                (tloal-bit (and (eq (tloa-ack-valid? duplicate) 1)
                                 (str_eq (tloa-ack-status duplicate) "refused")) 16)
                (tloal-bit (eq after before) 32)
                (tloal-bit (eq (tloa-count-invocation final-text
                                   (tloal-invocation)) 1) 64)
                (tloal-bit (and (ge (str_find retained "|exit=0|" 0) 0)
                                 (and (ge (str_find retained "|append=1|" 0) 0)
                                      (ge (str_find retained "|offline=1|" 0) 0))) 128)
                (tloal-bit (ge (str_find retained
                    (str_concat "|artifact_path=" (tlp-authoring-fused)) 0) 0) 256)
                (tloal-bit (ge (str_find retained "|artifact_size=1824757231|" 0) 0) 512)
                (tloal-bit (eq (nmfe-sha256?
                    (tloal-field retained "artifact_seal")) 1) 1024)
                (tloal-bit (and (lt (str_find retained "http" 0) 0)
                                 (lt (str_find retained "mlx-community/" 0) 0)) 2048)
                (tloal-bit (and (eq (tloa-ack-appended duplicate) 0)
                                 (str_eq (tloa-ack-reason duplicate)
                                         "duplicate-invocation")) 4096)))))

    (defn tloal-live ()
      (do
        (let before (tloal-rows))
        (let first
            (tloa-run-marker-at (tloal-ledger) (tloal-invocation)
                "rest-and-fuse" (tlp-authoring-adapter) (tlp-authoring-fused)))
        (let middle (tloal-rows))
        (let second
            (tloa-run-marker-at (tloal-ledger) (tloal-invocation)
                "rest-and-fuse" (tlp-authoring-adapter) (tlp-authoring-fused)))
        (let after (tloal-rows))
        (let final-text (read_file (tloal-ledger)))
        (let verdict
        (sum (list
            (tloal-bit (eq (tlp-base-ready?) 1) 1)
            (tloal-bit (eq (tlp-adapter-ready? (tlp-authoring-adapter)) 1) 2)
            (tloal-bit (eq (tlp-fused-ready? (tlp-authoring-fused)) 1) 4)
            (tloal-bit (and (eq (tloa-ack-valid? first) 1)
                            (str_eq (tloa-ack-status first) "returned")) 8)
            (tloal-bit (and (eq (tloa-ack-valid? second) 1)
                            (and (str_eq (tloa-ack-status second) "refused")
                                 (str_eq (tloa-ack-reason second)
                                         "duplicate-invocation"))) 16)
            (tloal-bit (eq middle (add before 1)) 32)
            (tloal-bit (eq after middle) 64)
            (tloal-bit (eq (tloa-count-invocation final-text
                               (tloal-invocation)) 1) 128)
            (tloal-bit (and (eq (tloa-ack-int first 5) 0)
                            (and (eq (tloa-ack-int first 10) 1)
                                 (eq (tloa-ack-int first 11) 1))) 256)
            (tloal-bit (eq (len (node_children (tloa-ack-child first 7))) 6) 512)
            (tloal-bit (and (gt (tloa-ack-int first 13) 1807496278)
                            (eq (nmfe-sha256? (tloa-ack-str first 14)) 1)) 1024)
            (tloal-bit (and (lt (str_find (tloa-row first) "http" 0) 0)
                            (lt (str_find (tloa-row first)
                                         "mlx-community/" 0) 0)) 2048)
            (tloal-bit (and (eq (tloa-ack-appended second) 0)
                            (not (node_eq first second))) 4096))))
        (print_str (str_concat (tloa-row first) (tloa-row second)))
        verdict))

    ; Compile/preflight has no authority to mutate the ledger.  Only the exact
    ; live gate on stdin opens the marker offer.
    (let gate (read_line))
    (if (str_eq gate "ADMIT-OFFLINE-FUSED-V2")
        (do
            (let current (read_file (tloal-ledger)))
            (if (gt (tloa-count-invocation current (tloal-invocation)) 0)
                (tloal-replay-live) (tloal-live)))
        0))
