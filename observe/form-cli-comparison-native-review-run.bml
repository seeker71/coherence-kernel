// preflight-exec: forbidden
// One local review of the exact restored provider source; no provider or training.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let root = ".hearth/response-parity/source-restored-native-v1";
 fs-mkdir(".hearth"); fs-mkdir(".hearth/response-parity");
 if fs_exists(str_concat(root,"/result.json")) then print_str(json-emit(json-node-object(list(nsm-n("native_model_calls_new",0),nsm-s("native_usage_event",root),json-node-pair("retained_result",parse-json("retained-native-review",read_file(str_concat(root,"/result.json")))))))) else {
  fcr-need(eq(host_dir_mkdir(root),1),"native review already admitted; inspect its owned process before resuming");
  let sourcePath = "receipts/artifacts/2026-09-20-source-restored-provider-source.json";
  let source = read_file(sourcePath); let domain = parse-json(sourcePath,source);
  let goal = fcr-goal(fcr-packet(fcr-original-review()));
  let manifest = fcr-manifest(domain,goal);
  fcr-need(frsy-sources(node_children(json-object-get(manifest,"cases"))),"restored review source assertion failed");
  let packet = str_concat(goal,str_concat("\n\n",source));
  frsh-frozen(str_concat(root,"/packet.json"),json-emit(json-node-object(list(nsm-s("packet",packet)))));
  frsh-frozen(str_concat(root,"/rubric.md"),"Before generation: compare the full answer and conclusion against the same question and restored provider source. Observe route identity, unchanged numeric facts, attribution and scopes, original output units, supplied paths, unresolved identity repair, missing-versus-contradicted evidence, and whether the practical conclusion follows. Schema and counts establish their narrow facts only; quality and human resonance remain separate. Expected findings and the provider answer are excluded from the prompt. Preserve failures and all costs; no evaluation training.\n");
  let observation = oh-reading("native-voice",root,"source-coverage-review",json-node-string("grounded-complete-answer"),json-node-string("prior-native-review-misread-counts-and-omitted-context"),json-node-int(0),list(),list("use-restored-source"),oh-reference(sourcePath));
  let control = oh-response(observation,"use-restored-source");
  fcr-need(str_eq(oh-select(observation,control,""),"use-restored-source"),"native source-review control did not correlate");
  oh-emit(str_concat(root,"/events.jsonl"),observation); oh-emit(str_concat(root,"/events.jsonl"),control);
  let started = now_unix_ms();
  let generated = fcnv-run(packet,mr-path(mr-find("qwen38-q8")),12288,2048);
  let elapsed = sub(now_unix_ms(),started);
  fcnv-retain(root,generated);
  let raw = nth(generated,8);
  let valid = and(str_eq(nth(generated,0),"answered"),faj-valid(raw));
  let parsed = if valid then parse-json("native-review",raw) else json-node-object(list());
  let answer = if valid then fcap-string(parsed,"answer") else "";
  let request = json-object-get(head(node_children(json-object-get(manifest,"cases"))),"request");
  let schema = if valid then head(frr-report(request,raw)) else 0;
  let result = json-node-object(list(nsm-s("answer_source","Qwen3.8-27B-Q8_0 through fkwu knowledge-query"),nsm-s("source_path",sourcePath),nsm-s("source_sha256",fcam-hash(source)),nsm-n("elapsed_ms",elapsed),json-node-pair("generation",fcnv-metadata(generated)),nsm-n("valid_json",valid),nsm-n("report_schema_passed",schema),nsm-n("answer_nonempty",not(str_eq(trim(answer),""))),nsm-n("training",0),json-node-pair("semantic_quality",json-node-null()),json-node-pair("human_resonance",json-node-null()),nsm-s("scope","Same domain source and review instruction as the retained provider run, different carrier envelope. One local generation; preparation and coordinator costs excluded.")));
  frsh-frozen(str_concat(root,"/answer.md"),answer);
  frsh-frozen(str_concat(root,"/result.json"),json-emit(result));
  let prefix = "receipts/artifacts/2026-09-20-source-restored-native";
  frsh-frozen(str_concat(prefix,"-packet.json"),read_file(str_concat(root,"/packet.json")));
  frsh-frozen(str_concat(prefix,"-raw.txt"),raw);
  frsh-frozen(str_concat(prefix,"-answer.md"),answer);
  frsh-frozen(str_concat(prefix,"-result.json"),json-emit(result));
  oh-emit(str_concat(root,"/events.jsonl"),oh-applied(observation,"use-restored-source",result));
  print_str(json-emit(json-node-object(list(nsm-n("native_model_calls_new",1),nsm-s("native_usage_event",root),json-node-pair("retained_result",result)))));
 };
 1;
}
