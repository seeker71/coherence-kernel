; jit-resident-nodeid-probe.fk — compare the same retained page through the
; legacy image-byte door and the NodeID-indexed resident request. The request
; is born once and retained outside both loops.
; preludes: form/form-stdlib/jit-lower-self-crystallized.fk

(do
    (defn jrnp-values () (jit-shape-table))
    (defn jrnp-request-many (request i n acc)
        (if (ge i n) acc
            (jrnp-request-many request (add i 1) n
                (add acc (jit_leaf_inram request (mod i 80))))))
    (defn jrnp-image-many (image i n acc)
        (if (ge i n) acc
            (jrnp-image-many image (add i 1) n
                (add acc (jit_leaf_inram image (mod i 80))))))
    (let h (jssc-birth (jrnp-values)))
    (let request (jssc-handle-request h))
    (let image (jssc-handle-image h))
    (let t0 (now_unix_ms))
    (let resident-sum (jrnp-request-many request 0 10000 0))
    (let t1 (now_unix_ms))
    (let image-sum (jrnp-image-many image 0 10000 0))
    (let t2 (now_unix_ms))
    (list
        (list "identity" (jssc-handle-identity h))
        (list "image-bytes" (len image))
        (list "resident-10000-ms" (sub t1 t0))
        (list "image-scan-10000-ms" (sub t2 t1))
        (list "parity" (eq resident-sum image-sum))
        (list "release-first" (jssc-release h))
        (list "release-again" (jssc-release h))))
