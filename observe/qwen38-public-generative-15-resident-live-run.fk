; qwen38-public-generative-15-resident-live-run.fk -- DORMANT physical school.
;
; DO NOT PREFLIGHT OR RUN THIS CELL while reviewing its structure.  Its top
; level becomes effectful only after an explicit plan-bound consent token.
; It was authored without opening the model or carrier.
;
; One local Qwen model context/weights residence serves all fifteen canonical
; public families.  Each family receives one independent generation.  Only
; after that exact raw reply is parsed and executed may one supervised repair
; be requested.  A repaired row is `supervised-embodiment`, never heldout.
; The complete generation report and its recomputable digest stay in every
; attempt beside the exact extracted reply, token/forward counters, state
; release, residence continuity, family source/challenge, and nonces.
;
; To run deliberately, place exactly the value printed by fkg15l-consent-token
; in .form-knowledge-public-generative-15-consent, then execute this cell once.
;
; preludes: form-stdlib/form-knowledge-public-generative-school.fk
; preludes: form-stdlib/form-cli-model-generate.fk
; preludes: observe/qwen38-bmf-mechanism.fk form-stdlib/model-registry.bml

(do
    (defn fkg15l-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkg15l-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit")
    (defn fkg15l-consent-path ()
        ".form-knowledge-public-generative-15-consent")
    (defn fkg15l-consent-token ()
        (fkg15-cat (list "run-local-qwen-public-generative-15-v1:"
            (fkg15-plan-seal) ":" (fkg15l-model-id)
            ":families=15:attempts=15..30:repair-limit=1")))
    (defn fkg15l-consented? ()
        (do
            (let supplied (read_file (fkg15l-consent-path)))
            (if (str_eq supplied (fkg15l-consent-token)) 1
                (if (str_eq supplied
                        (str_concat (fkg15l-consent-token) "\n")) 1 0))))

    ; The scheduler admits the largest independent prompt first.  A repair is
    ; expected to be smaller; the observed reopen counter remains the authority.
    (defn fkg15l-context-need (src plan prompt)
        (do
            (let thoughts (lg-think-all prompt))
            (let thought-lists (fcmg-encode-thoughts src thoughts (empty)))
            (let thought-n (fcmg-id-count thought-lists 0))
            (let gap-n (if (gt (len thoughts) 1) (lg-gap-default) 0))
            (let gap-total (mul gap-n
                (if (gt (len thoughts) 1) (sub (len thoughts) 1) 0)))
            (let ids (fcmg-chat-ids-profile src prompt "full"))
            (fcmg-context-need (len ids) thought-n gap-total 900 0 0)))
    (defn fkg15l-scheduled (plan need)
        (list "public-generative-live-scheduled-v1" plan need))
    (defn fkg15l-scheduled-plan (item) (nth item 1))
    (defn fkg15l-scheduled-need (item) (nth item 2))
    (defn fkg15l-insert (item sorted)
        (if (eq (len sorted) 0) (list item)
            (if (ge (fkg15l-scheduled-need item)
                    (fkg15l-scheduled-need (head sorted)))
                (cons item sorted)
                (cons (head sorted) (fkg15l-insert item (tail sorted))))))
    (defn fkg15l-schedule-loop (plans src sorted)
        (if (eq (len plans) 0) sorted
            (do
                (let plan (head plans))
                (let item (fkg15l-scheduled plan
                    (fkg15l-context-need src plan
                        (fkg15-plan-prompt plan))))
                (fkg15l-schedule-loop (tail plans) src
                    (fkg15l-insert item sorted)))))

    (defn fkg15l-same-residence? (before after)
        (if (not (eq (fcmr-live? after) 1)) 0
            (if (eq (fcmr-live? before) 0) 1
                (fkpfm-equal? before after))))
    (defn fkg15l-open-delta (before after)
        (if (and (eq (fcmr-live? before) 0)
                 (eq (fcmr-live? after) 1)) 1 0))
    (defn fkg15l-reopen-delta (before after)
        (if (and (eq (fcmr-live? before) 1)
                 (eq (fcmr-live? after) 1))
            (if (eq (fkpfm-equal? before after) 1) 0 1)
            (if (and (eq (fcmr-live? before) 1)
                     (eq (fcmr-live? after) 0)) 1 0)))
    (defn fkg15l-progress (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))

    ; generated = tag attempt next-residence open-delta reopen-delta
    (defn fkg15l-generate
        (plan index role lane parent prompt residence path model-id run-id
         session-id)
        (do
            (let _start (fkg15l-progress "generation-start"
                (fkg15-cat (list (fkg15-plan-family plan) ":" role))))
            (let before-ms (now_unix_ms))
            (let generated (fcmg-generate-with-at-budgeted-hinted
                residence path prompt 900 0 0 "full"
                (fkg15-plan-source plan)))
            (let after-ms (now_unix_ms))
            (let report (nth generated 0))
            (let reply (qbl-after report "text:\n"))
            (let next-residence (nth generated 1))
            (let generated-tokens (fht-report-int report "generated_tokens"))
            (let forward-passes (fht-report-int report "forward_passes"))
            (let executed (if (and (gt generated-tokens 0)
                                   (gt forward-passes 0)) 1 0))
            (let attempt (fkg15-attempt plan index role lane parent prompt
                reply model-id run-id session-id 1 0 executed
                (fkg15-report-state-released report)
                (fkg15l-same-residence? residence next-residence)
                (sub after-ms before-ms) report generated-tokens forward-passes))
            (let _done (fkg15l-progress "generation-done"
                (fkg15-cat (list (fkg15-plan-family plan) ":" role))))
            (let _sha (fkg15l-progress "generation-reply-sha256"
                (fkg15-attempt-raw-sha attempt)))
            (list "public-generative-live-generation-v1" attempt
                next-residence (fkg15l-open-delta residence next-residence)
                (fkg15l-reopen-delta residence next-residence))))

    ; loop = tag reversed-rows residence opens reopens
    (defn fkg15l-loop-result (rows residence opens reopens)
        (list "public-generative-live-loop-v1" rows residence opens reopens))
    (defn fkg15l-loop
        (scheduled residence path model-id run-id session-id rows opens reopens)
        (if (eq (len scheduled) 0)
            (fkg15l-loop-result rows residence opens reopens)
            (do
                (let plan (fkg15l-scheduled-plan (head scheduled)))
                (let first-generated (fkg15l-generate plan 1 "candidate"
                    (fkg15-independent-lane) (fkg15-plan-nonce plan)
                    (fkg15-plan-prompt plan) residence path model-id run-id
                    session-id))
                (let first (nth first-generated 1))
                (let after-first (nth first-generated 2))
                (let opens1 (add opens (nth first-generated 3)))
                (let reopens1 (add reopens (nth first-generated 4)))
                (if (eq (fkg15-check-pass? (fkg15-attempt-check first)) 1)
                    (fkg15l-loop (tail scheduled) after-first path model-id
                        run-id session-id
                        (cons (fkg15-row plan first (nothing)
                            (fkg15-independent-lane) 1) rows)
                        opens1 reopens1)
                    (do
                        (let repair-prompt
                            (fkg15-repair-prompt plan
                                (fkg15-attempt-check first)))
                        (let repaired (fkg15l-generate plan 2 "repair"
                            (fkg15-supervised-lane)
                            (fkg15-check-sha (fkg15-attempt-check first))
                            repair-prompt after-first path model-id run-id
                            session-id))
                        (let repair (nth repaired 1))
                        (let after-repair (nth repaired 2))
                        (fkg15l-loop (tail scheduled) after-repair path model-id
                            run-id session-id
                            (cons (fkg15-row plan first repair
                                (fkg15-supervised-lane) 2) rows)
                            (add opens1 (nth repaired 3))
                            (add reopens1 (nth repaired 4))))))))

    (defn fkg15l-run-live ()
        (do
            (let path (fkg15l-model-path))
            (let model-id (fkg15l-model-id))
            (let src (fcmg-src path))
            (let scheduled (fkg15l-schedule-loop (fkg15-plans) src (list)))
            (let run-id (nmfe-sha256 (nmfe-fields (list
                "public-generative-15-local-run-v1" (fkg15-plan-seal)
                model-id (int_to_str (now_unix_ms))))))
            (let session-id (fkg15-session-id-for run-id model-id))
            (let looped (fkg15l-loop scheduled (fcmr-none) path model-id
                run-id session-id (list) 0 0))
            (let rows (nmfe-reverse (nth looped 1)))
            (let residence (nth looped 2))
            (let release-ok (fcmr-release-ok? residence))
            (let result (fkg15-result rows (nth looped 3)
                (nth looped 4) release-ok))
            (let export (fkg15-export result))
            (fkg15l-progress "plan-sha256" (fkg15-plan-seal))
            (fkg15l-progress "run-id" run-id)
            (fkg15l-progress "session-id" session-id)
            (fkg15l-progress "opens" (int_to_str (nth looped 3)))
            (fkg15l-progress "reopens" (int_to_str (nth looped 4)))
            (fkg15l-progress "release-ok" (int_to_str release-ok))
            (fkg15l-progress "independent-generative"
                (int_to_str (nth result 16)))
            (fkg15l-progress "supervised-embodiment"
                (int_to_str (nth result 17)))
            (fkg15l-progress "complete"
                (int_to_str (fkg15-result-complete? result)))
            (fkg15l-progress "ready15"
                (int_to_str (fkg15-result-ready15? result)))
            (print export)
            0))

    (if (eq (fkg15l-consented?) 1)
        (fkg15l-run-live)
        (do
            (print_str "local-Qwen public generative-15 run refused: explicit full-plan consent token absent\n")
            (print_str (str_concat "required-token="
                (str_concat (fkg15l-consent-token) "\n")))
            0)))
