; Synthetic, one captured >1 MiB frame. No camera. Millisecond wall stages.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/frame-metal.bml form-stdlib/tests/frame-luma-fixture.fk
(do
 (defn fgb-counts () (list (kernel_stat 345) (kernel_stat 346) (kernel_stat 348)
     (kernel_stat 349) (kernel_stat 355) (kernel_stat 242) (kernel_stat 351)
     (kernel_stat 354) (kernel_stat 352)))
 (defn fgb-delta (before after)
  (if (nil? before) (list) (cons (sub (head after) (head before)) (fgb-delta (tail before) (tail after)))))
 (defn fgb-one (version bytes)
  (do
   (let crossings-before (fgb-counts))
   (let owner (fg-open version))
   (let t0 (host_monotonic_ms))
   (let frame (fg-capture owner bytes))
   (let t1 (host_monotonic_ms))
   (let job (fg-submit owner frame (flm-default-policy)))
   (let t2 (host_monotonic_ms))
   (let waited (fg-await-all owner))
   (let t3 (host_monotonic_ms))
   (let row (fg-result owner job))
   (let t4 (host_monotonic_ms))
   (let closed (fg-close owner))
   (list row waited closed (sub t1 t0) (sub t2 t1) (sub t3 t2) (sub t4 t3) (sub t4 t0)
     (fgb-delta crossings-before (fgb-counts)))))
 (let bytes (flmb-uniform 1024 342 120))
 (let t0 (host_monotonic_ms))
 (let version (fg-version 1024))
 (let t1 (host_monotonic_ms))
 (let first (fgb-one version bytes))
 (let second (fgb-one version bytes))
 (let third (fgb-one version bytes))
 (let status (metal_status))
 (list "frame-metal-benchmark-v2" (str_len bytes) "compile-ms" (sub t1 t0)
       "crossings=compile/alloc/write/enqueue/submit/fence/read/free/status"
       "row/wait/close/upload/submit/wait/read-total/end-to-end-ms" first second third
       "gpu-busy-us-total" (fg-status-number status "gpu_busy_us_total")))
