; ear-ground-read.fk — what a reader sees, including when there is nothing to see.
;
; This is the half of the ground that matters most. A resident that holds the microphone, the
; model and the frame is one point of failure, and this body has learned that a lane which dies
; quietly is worse than a slow one: a spawned part fails as ABSENCE, and absence is
; indistinguishable from a quiet room (mutebirth, corpus row 1339). So this reader never shows a
; line without the word that says whether the line is the room now.
;
;   absent    no frame is offered: nobody stood here
;   silent    a frame stands and its sequence has not moved: a ground that stood and STOPPED.
;             Its last line is still readable and is not the room. This is the dangerous one.
;   standing  the sequence moved within the cadence the ground declares
;
; It asks the sequence twice, EGCadenceMs apart, because a single reading cannot tell a living
; ground from a stopped one — only a sequence that moved can. Reading costs nothing: no fork,
; no parser, the cell arrives as the cell the ground built.
;
; stdin line 1: how many readings (default 1).
; preludes: form/form-stdlib/ear-ground.bml
(do
    (defn egr-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (egr-cat (tail xs)))))
    (defn egr-age (f) (do (let e (eg-frame-epoch f)) (if (lt e 0) 999999 (do (let d (sub (now_unix_ms) e)) (if (lt d 0) 0 d)))))
    (defn egr-show (word f seq)
        (do (let said (print_str (egr-cat (list "ear ground  " word "  —  " (eg-word-note word)))))
            (if (eq (eg-frame-valid? f) 0) 0
                (print_str (egr-cat (list "  seq " (int_to_str seq) "  pid " (int_to_str (eg-frame-pid f))
                    "  hops " (int_to_str (eg-frame-hops f)) "  closed " (int_to_str (eg-frame-closes f))
                    "  level " (int_to_str (eg-frame-level f)) " dBFS  " (eg-frame-reason f)
                    (if (eq (str_len (eg-frame-line f)) 0) "" (egr-cat (list "  [" (eg-frame-tongue f) "] " (eg-frame-line f))))))))))
    ; one reading: seq, hold, seq again, then the word from what moved
    (defn egr-once ()
        (do (let h (ggf-receive (eg-publisher)))
            (if (nothing? h) (egr-show "absent" (list) (sub 0 1))
                (do (let s0 (ggf-seq h))
                    (let w (host_sleep_ms (mul 2 (EGCadenceMs))))
                    (let s1 (ggf-seq h))
                    (let f (node_gift_read h))
                    (let rel (ggf-release h))
                    (let word (eg-standing 1 s1 s0 (egr-age f)))
                    (egr-show word f s1)))))
    (defn egr-go (k) (if (le k 0) 0 (do (let r (egr-once)) (egr-go (sub k 1)))))
    (defn egr-first-line () (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    (let n (do (let l (egr-first-line)) (if (eq (str_len l) 0) 1 (str_to_int l))))
    (let r (egr-go n))
    0)
