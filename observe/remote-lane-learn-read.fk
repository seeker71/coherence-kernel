; remote-lane-learn-read.fk — this sitting's remote lane as interned status.
; Presented census from form-cli-share-run. Not a transcript. Not a 3B train.
; preludes: form-stdlib/core.fk form-stdlib/nine-fold.fk
; preludes: form-stdlib/walk-home.fk form-stdlib/remote-lane-learn.fk
(do
    (let native 240)
    (let local 397)
    (let remote 32)
    (let reading (rll-read native local remote))
    (print (list "schema" "remote-lane-learn-v1"
        "events" (list native local remote)
        "share-remote" 5
        "folded" (nth reading 0)
        "remote-fold" (nth reading 1)
        "offer" (nth reading 2)
        "transcript" (nth reading 3)
        "host-intercept" 0
        "llama-train-this-sitting" 0))
    reading)
