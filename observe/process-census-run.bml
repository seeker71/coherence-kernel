// process-census-run.bml — the side processes, questioned: which doors run, how many of each, how many work and how many stand stopped.
//
//   ./fkwu observe/process-census-run.bml </dev/null
//
// One line a door: `<count> running <r> stopped <s> oldest <age> <door>`, a door with more than one process marked DUPLICATE (a role is one process:
// form-stdlib/bml/role-singleton.bml; a door that is meant to run once and runs twice costs memory, CPU and, for a gauge consumed by its reading, the
// truth). The census reads the host's process table through host_processes and host_process (argv, start, run state): no ps, no child process.
// A door is the second word of an `./fkwu <door>` command line; a kernel run any other way is counted under `(other)`.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
section [form.bml] {
 class ProcessCensus {
  def pc-row(l) = host_process(l[0]);
  def pc-door(row) = ((String) value_kind(row) != "list") ? "" : (((Comparable) len(row[4]) >= 2) ? row[4][1] : "(other)");
  def pc-rows() = filter(r => (String) value_kind(r) == "list", map(l => pc-row(l), host_processes("fkwu")));
  def pc-doors(rows) = foldl((acc, r) => (Comparable) len(filter(d => (String) d == pc-door(r), acc)) > 0 ? acc : append(acc, [pc-door(r)]), [], rows);
  def pc-of(rows, door) = filter(r => (String) pc-door(r) == door, rows);
  def pc-state(r) = (Comparable) len(r) > 7 ? r[7] : 0;
  def pc-count(rows, st) = len(filter(r => (Comparable) pc-state(r) == st, rows));
  def pc-oldest(rows) = foldl((m, r) => (m == 0 || (r[5] > 0 && r[5] < m)) ? r[5] : m, 0, rows);
  def pc-age-min(start) = start <= 0 ? 0 : (now_unix_ms() - start) / 60000;
  def pc-line(rows, door) {
   let mine = pc-of(rows, door);
   let n = len(mine);
   let note = n > 1 ? "  DUPLICATE" : "";
   n.str() ++ " running " ++ pc-count(mine, 1).str() ++ " stopped " ++ pc-count(mine, 2).str() ++ " oldest " ++ pc-age-min(pc-oldest(mine)).str() ++ " min  " ++ door ++ note;
  }
  def pc-run() {
   let rows = pc-rows();
   let doors = pc-doors(rows);
   let said = map(d => print_str(pc-line(rows, d)), doors);
   print_str("census  " ++ len(rows).str() ++ " kernels, " ++ len(doors).str() ++ " doors, " ++ len(filter(d => (Comparable) len(pc-of(rows, d)) > 1, doors)).str() ++ " doors with more than one");
   0;
  }
 }
 pc-run();
}
