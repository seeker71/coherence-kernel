; form-host-membrane-census.fk -- macOS crossings outside the current fkwu.
;
; `kernel_stat` is authoritative for effects dispatched by this fkwu, but it
; cannot see sibling applications. Host observation is the narrow job where
; host-exec serves rather than recursively outsourcing Form reasoning. Each
; read-only census is enclosed by form-membrane-runtime-census, so the observer
; names its own local-process crossing. Output is deliberately aggregate:
; process identity/count and listener address only; no command arguments,
; environment, prompts, payloads, or remote endpoint addresses are retained.
;
; preludes: observe/form-membrane-runtime-census.fk
; Proven by: observe/tests/form-host-membrane-census-band.fk

(do
    (defn fhmc-version () "form-host-membrane-census-v1")
    (defn fhmc-model-process-command ()
        "printf 'ollama='; pgrep -x ollama | awk 'END{print NR}'; printf 'llama-server='; pgrep -x llama-server | awk 'END{print NR}'")
    (defn fhmc-listener-command ()
        "lsof -nP -iTCP -sTCP:LISTEN | awk 'NR>1 {print $1 \"|\" $9}' | sort -u")
    (defn fhmc-established-command ()
        "lsof -nP -iTCP -sTCP:ESTABLISHED | awk 'NR>1 {count[$1]++} END {for (p in count) print p \"|\" count[p]}' | sort")
    (defn fhmc-command-private-safe? (command)
        (if (or (ge (str_find command "command=" 0) 0)
                (or (ge (str_find command "-o command" 0) 0)
                    (or (ge (str_find command "environ" 0) 0)
                        (ge (str_find command "->" 0) 0)))) 0 1))
    (defn fhmc-observe (trace purpose command line)
        (do
            (let window (fmrc-open trace purpose
                "observe/form-host-membrane-census.fk" line 1))
            (let output (host-exec command ""))
            (let closed (fmrc-close window "observed"
                "observe/form-host-membrane-census.fk" (add line 1) 1))
            (list output closed)))
    (defn fhmc-output (result) (nth result 0))
    (defn fhmc-membrane (result) (nth result 1))
    (defn fhmc-print-section (name text)
        (do
            (print_str (str_concat name "\n"))
            (print_str text)
            (if (or (eq (str_len text) 0)
                    (str_eq (substring text (sub (str_len text) 1)
                        (str_len text)) "\n")) 0 (print_str "\n"))))
    (defn fhmc-live ()
        (do
            (let model (fhmc-observe "host-model-processes"
                "read-only-model-process-census"
                (fhmc-model-process-command) 34))
            (let listeners (fhmc-observe "host-listeners"
                "read-only-listener-census" (fhmc-listener-command) 38))
            (let established (fhmc-observe "host-established-by-process"
                "read-only-established-process-census"
                (fhmc-established-command) 41))
            (fhmc-print-section "model-processes" (fhmc-output model))
            (fhmc-print-section "listeners" (fhmc-output listeners))
            (fhmc-print-section "established-by-process"
                (fhmc-output established))
            (print "observer-local-process-crossings="
                (add (fmrc-delta-plane-total
                        (fmrc-result-deltas (fhmc-membrane model))
                        "local-process")
                    (add (fmrc-delta-plane-total
                            (fmrc-result-deltas (fhmc-membrane listeners))
                            "local-process")
                         (fmrc-delta-plane-total
                            (fmrc-result-deltas (fhmc-membrane established))
                            "local-process"))) "\n")
            0))
    0)
