; qwen38-tokfast-freeze-run.fk — the PRE door for the tokenizer tables:
; freeze vocab + merges into <gguf>.form-tokfast ahead of any encode.
;
;   ./fkwu observe/qwen38-tokfast-freeze-run.fk
;
; preludes: form-stdlib/qwen35-tokfast.fk form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let t0 (now_unix_ms))
    (let wrote (qtf-freeze path))
    (let t1 (now_unix_ms))
    (let tf (qtf-load path))
    (print (str_concat "freeze_ms=" (int_to_str (sub t1 t0))))
    (print (str_concat "  bytes=" (int_to_str wrote)))
    (print (str_concat "  loaded=" (int_to_str (nth tf 0))))
    (print (str_concat "  vocab_blob=" (int_to_str (if (eq (nth tf 0) 1) (str_len (nth tf 1)) 0))))
    (print (str_concat "  merge_blob=" (int_to_str (if (eq (nth tf 0) 1) (str_len (nth tf 2)) 0))))
    (print "\n")
    0)
