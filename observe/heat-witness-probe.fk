; heat-witness-probe: run a hot self-tail spin, then ask the kernel
; which dispatch arms actually burned — from inside the same run, so
; no debug build and no race with our own edits can cloud the reading.
; kernel_stat 100+tag reads fk_arms[tag]:
;   106=if(6) 107=self0(7) 112=call1(12) 340=call2(240) 341=callN(241)
;   344=indirect(244) 144=closure(44); 0=total 2=busiest-tag
(defn spin (n) (if (le n 0) 0 (spin (sub n 1))))
(defn probe () (list (spin 300000)
  (kernel_stat 106) (kernel_stat 107) (kernel_stat 112)
  (kernel_stat 340) (kernel_stat 341) (kernel_stat 344)
  (kernel_stat 144) (kernel_stat 0) (kernel_stat 2)))
(probe)
