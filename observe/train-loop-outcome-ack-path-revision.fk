; train-loop-outcome-ack-path-revision.fk — the failed v1 artifact offer enters
; the bidirectional framebuffer as a signal, receives a correlated revise
; control, actuates the local executable path, and re-observes it before v2.
; No private/model content is retained.
;
; preludes: form-stdlib/core.fk learn/train-loop-local-paths.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn tloapr-apply (outbound inbound old-path)
        (if (or (nothing? inbound)
            (or (not (eq (bfc-direction inbound) 1))
                (not (eq (bfc-exchange outbound) (bfc-exchange inbound)))))
            old-path
            (if (eq (bfc-payload inbound) 2)
                (tlp-test-executable) old-path)))

    (framebuffer-clear)
    (let old-path "/usr/bin/test")
    (let old-present (if (gt (file_size old-path) 0) 1 0))
    (let alternative (intern_trivial_string "retain-failed-v1"))
    (let outbound (bfc-envelope 0 8262 0 (list 1 old-present) alternative))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let selected (tloapr-apply outbound inbound old-path))
    (let selected-present (if (gt (file_size selected) 0) 1 0))
    (let reobserved (bfc-envelope 0 8263 0 (list 0 selected-present) alternative))
    (let re-out-event (bfc-record-out reobserved 3))
    (let continue (bfc-control reobserved 0))
    (let re-in-event (bfc-record-in continue 4))
    (sum (list
        (if (eq old-present 0) 1 0)
        (if (eq (bfc-payload inbound) 2) 2 0)
        (if (str_eq selected "/bin/test") 4 0)
        (if (eq selected-present 1) 8 0)
        (if (eq (bfc-exchange outbound) (bfc-exchange inbound)) 16 0)
        (if (eq (bfc-payload continue) 0) 32 0)
        (if (eq (len (framebuffer-events)) 4) 64 0)
        (if (not (node_eq out-event in-event)) 128 0))))
