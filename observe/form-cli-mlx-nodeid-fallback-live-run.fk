; form-cli-mlx-nodeid-fallback-live-run.fk — intentional effectful witness.
;
; A NodeID coordinate is offered through the legacy MLX postfix door. MLX
; refuses that unknown temporary token; Form returns the existing execution
; request; the recipe children generate MSL on demand; Metal answers 22.
;
; NEVER PREFLIGHT THIS DRIVER. Do not run while another task owns GPU/model.
;
; Expected verdict 4095.
; preludes: form-stdlib/form-cli-mlx-nodeid-fallback-live.fk

(do
    (defn fmnflb-bit (ok bit) (if ok bit 0))
    (let recipe (frex-recipe))
    (let program (fmnf-node-program recipe 5))
    (let movement (fmnfl-run program recipe 5))
    (let attempt (fmnfl-result-attempt movement))
    (let request (fmnf-attempt-request attempt))
    (let live (fmnfl-result-live movement))
    (let settled (fmnfl-result-settled movement))
    (sum (list
        (fmnflb-bit (eq (fmnf-status-has? (fmnf-attempt-status attempt)
                                         (fmnf-linked-line)) 1) 1)
        (fmnflb-bit (eq (fmnf-attempt-value attempt) 0) 2)
        (fmnflb-bit (eq (fmnf-status-unknown?
                            (fmnf-attempt-status attempt)) 1) 4)
        (fmnflb-bit (eq (fmnf-attempt-request? attempt) 1) 8)
        (fmnflb-bit (and (eq (frex-request-ready? request) 1)
            (and (node_eq (frex-request-recipe request) recipe)
                 (eq (frex-request-input request) 5))) 16)
        (fmnflb-bit (and (str_eq
                            (frex-offer-status (fmnf-attempt-offer attempt))
                            "failure")
                         (str_eq
                            (frex-offer-carrier (fmnf-attempt-offer attempt))
                            "mlx")) 32)
        (fmnflb-bit (eq (frexl-result-source-generated? live) 1) 64)
        (fmnflb-bit (eq (frexl-result-native-code-generated? live) 1) 128)
        (fmnflb-bit (eq (frexl-result-pipeline-created? live) 1) 256)
        (fmnflb-bit (eq (frexl-result-executed? live) 1) 512)
        (fmnflb-bit (and (eq (frexl-result-value-present? live) 1)
                           (eq (frexl-result-value live) 22)) 1024)
        (fmnflb-bit (and (eq (frexl-result-buffer-released? live) 1)
            (and (eq (frex-result-attempts settled) 2)
            (and (eq (frex-result-model-executed? settled) 0)
            (and (eq (frex-trace-has? (frex-result-trace settled)
                                      "failure") 1)
                 (eq (frex-trace-has? (frex-result-trace settled)
                                      "crystallize") 1))))) 2048))))
