; mlx-newops-probe.fk — the five rows added 2026-08-24, read one at a time.
; preludes: form-stdlib/core.fk
(do
    (defn p (label v) (do (print label) (print (int_to_str v)) (print "\n") 0))
    (p "sin(0)x1000      = " (mlx_run "0 f32 sin 1000 mul 1 f32 2 div add i32"))
    (p "cos(0)x1000      = " (mlx_run "0 f32 cos 1000 mul 1 f32 2 div add i32"))
    (p "log(1)x1000      = " (mlx_run "1 f32 log 1000 mul 1 f32 2 div add i32"))
    (p "pow 2^3 via log  = " (mlx_run "2 f32 log 3 mul exp 1 f32 2 div add i32"))
    (p "gt 5>3           = " (mlx_run "5 3 gt i32"))
    (p "iota 5 sum       = " (mlx_run "5 iota sum i32"))
    (p "where(1>0,7,9)   = " (mlx_run "1 0 gt i32 dup 7 mul swap 1 swap -1 mul add 9 mul add i32"))
    (print (mlx_status))
    0)
