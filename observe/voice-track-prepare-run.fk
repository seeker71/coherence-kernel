; voice-track-prepare-run.fk — a spoken track's text, cut, in Form.
; Reads a track's lines per tongue (.hearth/voice-track/lines-<tongue>.txt, one line per line, aligned across
; tongues) and its paragraph flags (lines-para.txt, 1 where a paragraph ends), cuts every tongue into
; breathing pieces (voice-chunk.bml), writes .hearth/voice-track/<tongue>-chunks.txt and -map.txt. The words a
; piece holds that the body's tables do not are grown by observe/voice-g2p-grow-run.fk, which reads the chunks file.
; Proof: pending (the band for the cut is tests/voice-chunk-band.fk).
; preludes: form/form-stdlib/voice-chunk.bml form/form-stdlib/voice-g2p.bml
(do
    (let dir ".hearth/voice-track")
    (defn vt-lines (code) (vg-drop-empty (split-on (read_file (str_concat dir (str_concat "/lines-" (str_concat code ".txt")))) (byte_to_str 10))))
    (let flags (map (fn (s) (if (str_eq s "1") 1 0)) (vt-lines "para")))
    (defn vt-cut (code)
        (do (let rows (vc-all (vt-lines code) flags))
            (write_file (str_concat dir (str_concat "/" (str_concat code "-chunks.txt"))) (vc-lines-text (vc-texts rows)))
            (write_file (str_concat dir (str_concat "/" (str_concat code "-map.txt"))) (vc-lines-text (vc-rests rows)))
            (print_str (str_concat code (str_concat " pieces " (int_to_str (len rows)))))))
    (vt-cut "en") (vt-cut "pt") (vt-cut "fa") (vt-cut "id")
    0)
