// native-turn-run.bml — one engineering turn by the body's own loop: a queued gap, the native code lane, the band.
//
// Reads learn/native-turn-queue.jsonl (id, goal, writable, band, full, and optionally document_context "catalog"
// for a writable file larger than the voice's context) and takes the open gap with the fewest
// attempts in receipts/native-turn-ledger.jsonl. Runs the gap's band in its own fresh kernel; when it already
// reads full the gap is closed and nothing runs. Otherwise the turn is a backtrack walk (oac-backtrack-walk,
// control/choice-lane-core.fk) over two options for the same gap. The first hands the goal to the native code lane
// (observe/form-cli-code-run.fk: local Qwen in one native session, no rented fallback) with the writable sources
// as documents and the gap's own read-only checks, then runs the band again. An option whose band did not turn
// green is a backtrack point, not an end: it keeps its candidate under .hearth/native-turns, restores the source,
// and acks a node carrying what it saw (the band's reading, the lane's status, the candidate's diff, and the
// compiler's own words when the band did not read). The second
// option receives the same gap and that finding, and asks the lane again with the goal and what the first attempt
// saw, so the second choice is made in line with the first and nothing learned is lost. A green option keeps its
// edit for the landing and ends the walk. Each option lands its own row: gap, option, band before and after
// (null when the band printed no number), full, band_green, and who began the turn, read from the host's own
// process table (launchd is the host's schedule, anything else a session with a rented mind).
// A test turn ({"test":1}) writes its rows to .hearth/native-turns/test-ledger.jsonl and always restores the
// source, so a turn begun by a session can learn what the lane can do without closing a gap the nights must close.
// {"publish_from":"<lane output>"} publishes a result already on disk instead of asking the lane (a test of the path);
// {"candidate":"<file>"} publishes that file's text as the gap's first writable document (a test of one candidate).
// stdin, optional: {"gap":"<id>","dry":1,"test":1,"model":"qwen38-q8","context":16384,"turns":32}; dry skips the lane.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/bml/text-diff.bml form-stdlib/bml/stdin-source.bml
section [form.bml] {
 class NativeTurn {
  def nt-queue() = "learn/native-turn-queue.jsonl";
  def nt-ledger() = "receipts/native-turn-ledger.jsonl";
  def nt-dir() = ".hearth/native-turns";
  def nt-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def nt-int(doc, key, d) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else d;
  def nt-strs(doc, key) = if json-object-has?(doc, key) then nt-values(json-array-elements(json-object-get(doc, key))) else list();
  def nt-values(nodes) = if nil?(nodes) then list() else cons(json-string-value(head(nodes)), nt-values(tail(nodes)));
  def nt-nonempty(xs) = if nil?(xs) then list() else if ((Comparable) str_len(trim(head(xs))) == 0) then nt-nonempty(tail(xs)) else cons(head(xs), nt-nonempty(tail(xs)));
  def nt-parse(xs) = if nil?(xs) then list() else cons(parse-json("native-turn-row", head(xs)), nt-parse(tail(xs)));
  def nt-rows(path) = if (file_size(path) < 1) then list() else nt-parse(nt-nonempty(split-on(fhn-read(path), "\n")));
  def nt-green?(id, rows) = if nil?(rows) then 0 else if (((String) nt-str(head(rows), "gap") == id) && ((Comparable) nt-int(head(rows), "band_green", 0) == 1)) then 1 else nt-green?(id, tail(rows));
  // the open gap with the fewest real attempts, in queue order among equals, so one gap the lane cannot yet
  // close does not hold the others
  def nt-attempts(id, rows) = if nil?(rows) then 0 else ((if (((String) nt-str(head(rows), "gap") == id) && ((Comparable) nt-int(head(rows), "dry", 0) == 0)) then 1 else 0) + nt-attempts(id, tail(rows)));
  def nt-open(queue, done, want) = if nil?(queue) then list() else if ((((String) want == "") || ((String) nt-str(head(queue), "id") == want)) && ((Comparable) nt-green?(nt-str(head(queue), "id"), done) == 0)) then cons(head(queue), nt-open(tail(queue), done, want)) else nt-open(tail(queue), done, want);
  def nt-least(gaps, done, best) = if nil?(gaps) then best else nt-least(tail(gaps), done, if (nil?(best) || (nt-attempts(nt-str(head(gaps), "id"), done) < nt-attempts(nt-str(head(best), "id"), done))) then list(head(gaps)) else best);
  def nt-pick(queue, done, want) = nt-least(nt-open(queue, done, want), done, list());
  // a band reads its number only when its run exits 0; a nonzero exit is a fold over nothing and reads nothing
  // (axiom-1), never a number and never a -1 code. The compiler's own error lines stay beside the reading.
  def nt-band(path) {
   let made = fs_mkdir(nt-dir());
   let rc = trim(host-exec(mc-cat(list("./fkwu ", path, " > ", nt-dir(), "/band.out 2> ", nt-dir(), "/band.err; echo $?")), ""));
   let t = nt-last-line(split-on(nt-read(mc-cat(list(nt-dir(), "/band.out"))), "\n"), "");
   if ((!((String) rc == "0")) || ((Comparable) str_len(t) == 0)) then nothing() else str_to_int(t);
  }
  def nt-read(path) = if (file_size(path) < 1) then "" else fhn-read(path);
  def nt-last-line(lines, last) = if nil?(lines) then last else nt-last-line(tail(lines), if ((Comparable) str_len(trim(head(lines))) == 0) then last else trim(head(lines)));
  def nt-starts?(s, p) = ((str_len(s) >= str_len(p)) && ((String) substring(s, 0, str_len(p)) == p));
  def nt-error-lines(lines, n) = if (nil?(lines) || (n <= 0)) then list() else if ((str_find(head(lines), "error", 0) >= 0) && (!nt-starts?(head(lines), "form-organ"))) then cons(substring(head(lines), 0, if (str_len(head(lines)) > 300) then 300 else str_len(head(lines))), nt-error-lines(tail(lines), (n - 1))) else nt-error-lines(tail(lines), n);
  def nt-band-errors() = trim(nt-join(nt-error-lines(split-on(nt-read(mc-cat(list(nt-dir(), "/band.err"))), "\n"), 6)));
  // A live band (form-stdlib/bml/live-band.bml) speaks every claim as an organ-health reading on stderr.
  // The claims whose last observation did not hold are the backtracking signal the next option hears:
  // what each expected, what it observed, and the repairs the band already tried in its own run.
  def nt-health-prefix() = "form-organ health ";
  def nt-band-rows(lines) = if nil?(lines) then list() else if (nt-starts?(head(lines), nt-health-prefix()) && (str_find(head(lines), "\"organ\":\"band\"", 0) >= 0)) then cons(parse-json("band-reading", substring(head(lines), str_len(nt-health-prefix()), str_len(head(lines)))), nt-band-rows(tail(lines))) else nt-band-rows(tail(lines));
  def nt-row-str(row, key) = if json-object-has?(row, key) then json-string-value(json-object-get(row, key)) else "";
  def nt-observe?(row) = ((String) nt-row-str(row, "stage") == "observe");
  def nt-aspects(rows, seen) = if nil?(rows) then reverse(seen) else nt-aspects(tail(rows), if (nt-observe?(head(rows)) && ((Comparable) nt-has(seen, nt-row-str(head(rows), "aspect")) == 0)) then cons(nt-row-str(head(rows), "aspect"), seen) else seen);
  def nt-last-observed(rows, aspect, found) = if nil?(rows) then found else nt-last-observed(tail(rows), aspect, if (nt-observe?(head(rows)) && ((String) nt-row-str(head(rows), "aspect") == aspect)) then head(rows) else found);
  def nt-tried(rows, aspect) = if nil?(rows) then list() else if (((String) nt-row-str(head(rows), "stage") == "applied") && ((String) nt-row-str(head(rows), "aspect") == aspect)) then cons(nt-row-str(head(rows), "selected"), nt-tried(tail(rows), aspect)) else nt-tried(tail(rows), aspect);
  def nt-comma(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else mc-cat(list(head(xs), ", ", nt-comma(tail(xs))));
  def nt-claim-line(rows, aspect) {
   let last = nt-last-observed(rows, aspect, json-node-object(list()));
   let held = node_eq(json-object-get(last, "health"), json-node-int(1));
   let tried = nt-tried(rows, aspect);
   if held then "" else mc-cat(list("claim ", aspect, ": expected ", json-emit(json-object-get(last, "expected")), ", observed ", json-emit(json-object-get(last, "observed")), if nil?(tried) then "" else mc-cat(list("; the band already tried ", nt-comma(tried))), "\n"));
  }
  def nt-claim-lines(rows, aspects) = if nil?(aspects) then "" else str_concat(nt-claim-line(rows, head(aspects)), nt-claim-lines(rows, tail(aspects)));
  def nt-band-claims() {
   let rows = nt-band-rows(split-on(nt-read(mc-cat(list(nt-dir(), "/band.err"))), "\n"));
   trim(nt-claim-lines(rows, nt-aspects(rows, list())));
  }
  // who began this turn
  def nt-row-of(value) = if ((String) value_kind(value) == "int") then list() else value;
  def nt-self() = nt-row-of(host_process(host_pid()));
  def nt-parent(me) = if (len(me) < 2) then list() else nt-row-of(host_process(nth(me, 1)));
  def nt-exe(row) = if (len(row) < 3) then "" else nth(row, 2);
  def nt-tail(path, i) = if (i <= 0) then path else if ((Comparable) str_byte_at(path, (i - 1)) == 47) then substring(path, i, str_len(path)) else nt-tail(path, (i - 1));
  def nt-base(path) = if ((String) path == "") then "" else nt-tail(path, str_len(path));
  def nt-glue?(exe) = (((String) nt-base(exe) == "fkwu") || (((String) nt-base(exe) == "sh") || (((String) nt-base(exe) == "zsh") || (((String) nt-base(exe) == "bash") || ((String) nt-base(exe) == "form-run")))));
  def nt-climb(row, hops) = if ((len(row) < 3) || (hops <= 0)) then row else if nt-glue?(nt-exe(row)) then nt-climb(nt-parent(row), (hops - 1)) else row;
  def nt-coordinator() = nt-exe(nt-climb(nt-parent(nt-self()), 8));
  def nt-keeper?(exe) = ((String) nt-base(exe) == "launchd");
  // the request the native code lane reads
  def nt-doc(path) = json-node-object(list(fhn-s("id", nt-base(path)), fhn-s("path", path), fhn-s("text", fhn-read(path))));
  def nt-docs(paths) = if nil?(paths) then list() else cons(nt-doc(head(paths)), nt-docs(tail(paths)));
  def nt-check(path) = json-node-object(list(fhn-s("tool", "rehearse-bml"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("input", "")));
  def nt-bml?(path) = ((str_len(path) > 4) && ((String) substring(path, (str_len(path) - 4), str_len(path)) == ".bml"));
  def nt-checks(paths) = if nil?(paths) then list() else if nt-bml?(head(paths)) then cons(nt-check(head(paths)), nt-checks(tail(paths))) else nt-checks(tail(paths));
  def nt-strings(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)), nt-strings(tail(xs)));
  // every writable file keeps the paren and brace balance it had before the lane (the lane's read-only balance tool)
  def nt-count(text, i, n, open, close, d) = if (i >= n) then d else nt-count(text, (i + 1), n, open, close, if ((Comparable) str_byte_at(text, i) == open) then (d + 1) else if ((Comparable) str_byte_at(text, i) == close) then (d - 1) else d);
  def nt-balance-text(text) = mc-cat(list(int_to_str(nt-count(text, 0, str_len(text), 40, 41, 0)), " ", int_to_str(nt-count(text, 0, str_len(text), 123, 125, 0)), "\n"));
  def nt-balance(path) = json-node-object(list(fhn-s("tool", "balance"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("stdout", nt-balance-text(fhn-read(path)))));
  // every writable Form source is read against the arities fkwu's reader demands, in the lane's own session: a call
  // with the wrong count shows while the lane works, not after its band stops (form-stdlib/bml/form-agent-tools.bml)
  def nt-fk?(path) = (((str_len(path) > 3) && ((String) substring(path, (str_len(path) - 3), str_len(path)) == ".fk")) && (!nt-bml-surface?(nt-read(path))));
  def nt-bml-surface?(t) = (((str_len(t) >= 9) && ((String) substring(t, 0, 9) == "section [")) || (str_find(t, "\nsection [", 0) >= 0));
  def nt-arity(path) = json-node-object(list(fhn-s("tool", "arity"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("stdout", "")));
  def nt-balances(paths) = if nil?(paths) then list() else cons(nt-balance(head(paths)), if nt-fk?(head(paths)) then cons(nt-arity(head(paths)), nt-balances(tail(paths))) else nt-balances(tail(paths)));
  // a gap over a file larger than the voice's context names "document_context":"catalog": the lane then keeps the
  // text behind its read-only tools and works it by region, where "full" hands every writable document whole
  def nt-context(gap) = if json-object-has?(gap, "document_context") then nt-str(gap, "document_context") else "full";
  def nt-request(gap, opts, goal) = json-node-object(list(fhn-s("goal", goal), json-node-pair("documents", json-node-array(nt-docs(nt-strs(gap, "writable")))), json-node-pair("writable", json-node-array(nt-strings(nt-strs(gap, "writable")))), json-node-pair("checks", json-node-array(append(if json-object-has?(gap, "checks") then json-array-elements(json-object-get(gap, "checks")) else nt-checks(nt-strs(gap, "writable")), nt-balances(nt-strs(gap, "writable"))))), fhn-s("model", if json-object-has?(opts, "model") then nt-str(opts, "model") else "qwen38-q8"), fhn-n("context", nt-int(opts, "context", 16384)), fhn-n("turns", nt-int(opts, "turns", 32)), fhn-s("document_context", nt-context(gap))));
  def nt-quote(s) = mc-cat(list("'", s, "'"));
  // the lane keeps its documents in its own session and the caller publishes them: find the result line, write each
  // final document whose path is writable, and read the lane's status beside it
  def nt-marker() = "\"schema\":\"form-native-code-v1\"";
  def nt-result(lines, found) = if nil?(lines) then found else nt-result(tail(lines), if (str_find(head(lines), nt-marker(), 0) >= 0) then head(lines) else found);
  def nt-result-of(outPath) { let r = nt-result(split-on(if (file_size(outPath) < 1) then "" else fhn-read(outPath), "\n"), ""); if ((String) r == "") then json-node-object(list()) else parse-json("code-result", r); }
  def nt-has(xs, x) = if nil?(xs) then 0 else if ((String) head(xs) == x) then 1 else nt-has(tail(xs), x);
  def nt-publish(docs, writable, n) = if nil?(docs) then n else nt-publish(tail(docs), writable, if ((Comparable) nt-has(writable, nt-str(head(docs), "path")) == 1) then nt-publish-one(head(docs), n) else n);
  def nt-publish-one(doc, n) { let w = write_file_text(nt-str(doc, "path"), nt-str(doc, "text")); (n + 1); }
  // {"candidate":"<path>"}: the text at <path> stands as the lane's document for the gap's first writable file
  def nt-candidate-result(gap, path) = json-node-object(list(fhn-s("status", "candidate"), json-node-pair("documents", json-node-array(list(json-node-object(list(fhn-s("path", head(nt-strs(gap, "writable"))), fhn-s("text", nt-read(path)))))))));
  def nt-docs-of(result) = if json-object-has?(result, "documents") then json-array-elements(json-object-get(result, "documents")) else list();
  // the checkpoint is a value (oac-store): each writable file's text as it stood before the lane
  def nt-texts(paths) = if nil?(paths) then list() else cons(nt-read(head(paths)), nt-texts(tail(paths)));
  // keep the candidate beside the turn, then return each file to its checkpoint (oac-restore)
  def nt-keep(paths, originals, stamp) = if nil?(paths) then 0 else nt-keep-next(write_file_text(mc-cat(list(nt-dir(), "/", stamp, "-", nt-base(head(paths)), ".candidate")), nt-read(head(paths))), write_file_text(head(paths), head(originals)), paths, originals, stamp);
  def nt-keep-next(kept, restored, paths, originals, stamp) = (1 + nt-keep(tail(paths), tail(originals), stamp));
  def nt-run() {
   let line = trim(stdin-text());
   let opts = if ((String) line == "") then json-node-object(list()) else parse-json("native-turn-options", line);
   let picked = nt-pick(nt-rows(nt-queue()), nt-rows(nt-ledger()), nt-str(opts, "gap"));
   if nil?(picked) then print_str("[native-turn] no open gap\n") else nt-turn(head(picked), opts);
  }
  def nt-turn(gap, opts) {
   let id = nt-str(gap, "id");
   let full = nt-int(gap, "full", 0);
   let band = nt-str(gap, "band");
   let before = nt-band(band);
   let coordinator = nt-coordinator();
   if ((Comparable) before == full) then print_str(mc-cat(list("[native-turn] ", id, " already reads ", int_to_str(full), "\n"))) else nt-walk(gap, opts, id, full, band, before, coordinator);
  }
  // the turn is a backtrack walk over two options for the same gap; the second receives what the first saw
  def nt-walk(gap, opts, id, full, band, before, coordinator) {
   let w = oac-backtrack-walk(list(nt-option-first, nt-option-again), list(gap, opts, id, full, band, before, coordinator), list());
   let landed = ((Comparable) oac-one?(oac-backtrack-ack(w)) == 1);
   let carried = len(oac-backtrack-memory(w));
   print_str(mc-cat(list("[native-turn:walk] ", id, if landed then " green after " else " declined after ", int_to_str(if landed then (carried + 1) else carried), " option(s); findings carried forward: ", int_to_str(carried), "\n")));
  }
  def nt-option-first(offered) = nt-option(offered, 1);
  def nt-option-again(offered) = nt-option(offered, 2);
  def nt-option(offered, n) {
   let a = oac-option-args(offered);
   let memory = oac-option-memory(offered);
   let gap = nth(a, 0);
   let goal = if nil?(memory) then nt-str(gap, "goal") else nt-refine-goal(nt-str(gap, "goal"), memory);
   let r = nt-attempt(gap, nth(a, 1), nth(a, 2), nth(a, 3), nth(a, 4), nth(a, 5), nth(a, 6), goal, n);
   if ((Comparable) head(r) == 1) then oac-one(nth(r, 1)) else oac-node(nth(r, 2));
  }
  def nt-join(xs) = if nil?(xs) then "" else mc-cat(list(head(xs), "\n", nt-join(tail(xs))));
  def nt-refine-goal(goal, memory) = mc-cat(list(goal, "\n\nThis goal was tried before in this turn. What those attempts saw (keep what served the band, change what did not):\n", nt-join(memory)));
  // a band reading as text: a band that printed no number reads nothing — the file did not compile or the band stopped
  def nt-reading-text(v) = if nothing?(v) then "nothing (the band printed no number: the source did not compile or the band stopped)" else int_to_str(v);
  def nt-reading(key, v) = if nothing?(v) then json-node-pair(key, json-node-null()) else fhn-n(key, v);
  // the candidate's change against its checkpoint, read in Form (form-stdlib/bml/text-diff.bml)
  def nt-diff(paths, originals) = if nil?(paths) then "" else mc-cat(list(nt-diff-one(head(paths), head(originals)), nt-diff(tail(paths), tail(originals))));
  def nt-diff-one(path, original) { let d = td-diff(original, nt-read(path), 1, 2400); if ((String) d == "") then "" else mc-cat(list("--- ", path, "\n", d)); }
  def nt-finding(n, before, after, full, said, status, published, diff, errors, claims) = mc-cat(list("Attempt ", int_to_str(n), ": the band read ", nt-reading-text(after), " of ", int_to_str(full), " (it began at ", nt-reading-text(before), "); the lane said ", trim(said), if ((String) status == "") then "" else mc-cat(list(" with status ", status)), if ((Comparable) published == 0) then "; it published no document." else mc-cat(list("; its candidate changed:\n", diff)), if ((Comparable) str_len(errors) == 0) then "" else mc-cat(list("\nThe band did not read; the compiler said:\n", errors)), if ((Comparable) str_len(claims) == 0) then "" else mc-cat(list("\nThe band's claims that did not hold:\n", claims))));
  // one option: ask the lane, publish, read the band; returns (list green row finding)
  def nt-attempt(gap, opts, id, full, band, before, coordinator, goal, n) {
   let made = fs_mkdir(nt-dir());
   let stamp = mc-cat(list(id, "-", int_to_str(now_unix_ms())));
   let reqPath = mc-cat(list(nt-dir(), "/", stamp, ".json"));
   let wrote = write_file_text(reqPath, json-emit(nt-request(gap, opts, goal)));
   let started = now_unix_ms();
   let dry = ((Comparable) nt-int(opts, "dry", 0) == 1);
   let outPath = if json-object-has?(opts, "publish_from") then nt-str(opts, "publish_from") else mc-cat(list(nt-dir(), "/", stamp, ".out"));
   let said = if (dry || (json-object-has?(opts, "publish_from") || json-object-has?(opts, "candidate"))) then "not-run" else host-exec(mc-cat(list("./fkwu observe/form-cli-code-run.fk > ", nt-quote(outPath), " 2> ", nt-quote(mc-cat(list(outPath, ".err"))), "; echo lane-exit=$?")), mc-cat(list("@", reqPath, "\n")));
   let result = if dry then json-node-object(list()) else if json-object-has?(opts, "candidate") then nt-candidate-result(gap, nt-str(opts, "candidate")) else nt-result-of(outPath);
   let originals = nt-texts(nt-strs(gap, "writable"));
   let published = nt-publish(nt-docs-of(result), nt-strs(gap, "writable"), 0);
   let after = nt-band(band);
   let errors = if nothing?(after) then nt-band-errors() else "";
   let green = (((Comparable) after == full) && (!((Comparable) before == full)));
   let test = ((Comparable) nt-int(opts, "test", 0) == 1);
   let claims = if green then "" else nt-band-claims();
   let finding = if green then "" else nt-finding(n, before, after, full, said, nt-str(result, "status"), published, nt-diff(nt-strs(gap, "writable"), originals), errors, claims);
   let kept = if (green && (!test)) then 0 else nt-keep(nt-strs(gap, "writable"), originals, stamp);
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("gap", id), fhn-n("option", n), nt-reading("band_before", before), nt-reading("band_after", after), fhn-n("full", full), fhn-n("band_green", if green then 1 else 0), fhn-n("dry", if dry then 1 else 0), fhn-n("test", if test then 1 else 0), fhn-s("coordinated_by", if nt-keeper?(coordinator) then "host-schedule" else "session"), fhn-s("coordinator", coordinator), fhn-n("rented_mind", if nt-keeper?(coordinator) then 0 else 1), fhn-s("request", reqPath), fhn-s("lane", trim(said)), fhn-s("lane_status", nt-str(result, "status")), fhn-n("lane_check_runs", nt-int(result, "check_runs", -1)), fhn-n("lane_turns", nt-int(result, "turns", -1)), fhn-n("published", published), fhn-n("wall_ms", (now_unix_ms() - started))));
   let appended = fhn-append(if test then mc-cat(list(nt-dir(), "/test-ledger.jsonl")) else nt-ledger(), str_concat(json-emit(row), "\n"));
   let shown = print_str(mc-cat(list("[native-turn] ", json-emit(row), "\n")));
   list(if green then 1 else 0, row, finding);
  }
 }
 nt-run();
}
