  // keep the candidate beside the turn, then return each file to its checkpoint (oac-restore)
  def nt-keep(paths, originals, stamp) = nil?(paths) ? 0 : nt-keep-next(write_file_text(nt-dir() ++ "/" ++ stamp ++ "-" ++ nt-base(head(paths)) ++ ".candidate", nt-read(head(paths))), write_file_text(head(paths), head(originals)), paths, originals, stamp);
  def nt-keep-next(kept, restored, paths, originals, stamp) = 1 + nt-keep(tail(paths), tail(originals), stamp);
  def nt-run() {
