  def nt-candidate-result(gap, path) = json-node-object(list(fhn-s("status", "candidate"), json-node-pair("documents", json-node-array(list(json-node-object(list(fhn-s("path", head(nt-strs(gap, "writable"))), fhn-s("text", nt-read(path)))))))));
  def nt-docs-of(result) = json-object-has?(result, "documents") ? json-array-elements(json-object-get(result, "documents")) : list();
