// native-turn-run.bml — one engineering turn by the body's own loop: a queued gap, the native code lane, the band.
//
// Reads learn/native-turn-queue.jsonl (id, goal, writable, band, full, and optionally document_context "catalog"
// for a writable file larger than the voice's context) and takes the open gap with the fewest
// attempts in receipts/native-turn-ledger.jsonl. Runs the gap's band in its own fresh kernel; when it already
// reads full the gap is closed and nothing runs. Otherwise the turn is a backtrack walk (oac-backtrack-walk,
// control/choice-lane-core.fk) over two options for the same gap. The first hands the goal to the native code lane
// (observe/form-cli-code-run.fk: local Qwen in one native session, no rented fallback) with the writable sources
// as documents and the gap's own read-only checks, then runs the band again. An option whose band did not turn
// green is a backtrack point, not an end: it keeps its candidate under .hearth/native-turns, restores the source,
// and acks a node carrying what it saw (the band's reading, the lane's status, the candidate's diff, and the
// compiler's own words when the band did not read). The second
// option receives the same gap and that finding, and asks the lane again with the goal and what the first attempt
// saw, so the second choice is made in line with the first and nothing learned is lost. A green option keeps its
// edit for the landing and ends the walk. Each option lands its own row: gap, option, band before and after
// (null when the band printed no number), full, band_green, and who began the turn, read from the host's own
// process table (launchd is the host's schedule, anything else a session with a rented mind).
// A test turn ({"test":1}) writes its rows to .hearth/native-turns/test-ledger.jsonl and always restores the
// source, so a turn begun by a session can learn what the lane can do without closing a gap the nights must close.
// {"publish_from":"<lane output>"} publishes a result already on disk instead of asking the lane (a test of the path);
// {"candidate":"<file>"} publishes that file's text as the gap's first writable document (a test of one candidate).
// stdin, optional: {"gap":"<id>","dry":1,"test":1,"model":"qwen38-q8","context":16384,"turns":32}; dry skips the lane.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/bml/text-diff.bml form-stdlib/bml/stdin-source.bml form-stdlib/bml/live.bml
section [form.bml] {
 class NativeTurn {
  def nt-queue() = "learn/native-turn-queue.jsonl";
  def nt-ledger() = "receipts/native-turn-ledger.jsonl";
  def nt-dir() = ".hearth/native-turns";
  def nt-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def nt-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def nt-maybe(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : nothing();
  def nt-strs(doc, key) = json-object-has?(doc, key) ? nt-values(json-array-elements(json-object-get(doc, key))) : list();
  def nt-values(nodes) = nil?(nodes) ? list() : cons(json-string-value(head(nodes)), nt-values(tail(nodes)));
  def nt-nonempty(xs) = nil?(xs) ? list() : (Comparable) str_len(trim(head(xs))) == 0 ? nt-nonempty(tail(xs)) : cons(head(xs), nt-nonempty(tail(xs)));
  def nt-parse(xs) = nil?(xs) ? list() : cons(parse-json("native-turn-row", head(xs)), nt-parse(tail(xs)));
  def nt-rows(path) = file_size(path) < 1 ? list() : nt-parse(nt-nonempty(split-on(fhn-read(path), "\n")));
  def nt-green?(id, rows) = nil?(rows) ? 0 : ((String) nt-str(head(rows), "gap") == id) && ((Comparable) nt-int(head(rows), "band_green", 0) == 1) ? 1 : nt-green?(id, tail(rows));
  // the open gap with the fewest real attempts, in queue order among equals, so one gap the lane cannot yet
  // close does not hold the others
  def nt-attempts(id, rows) = nil?(rows) ? 0 : ((((String) nt-str(head(rows), "gap") == id) && ((Comparable) nt-int(head(rows), "dry", 0) == 0) ? 1 : 0) + nt-attempts(id, tail(rows)));
  def nt-open(queue, done, want) = nil?(queue) ? list() : (((String) want == "") || ((String) nt-str(head(queue), "id") == want)) && ((Comparable) nt-green?(nt-str(head(queue), "id"), done) == 0) ? cons(head(queue), nt-open(tail(queue), done, want)) : nt-open(tail(queue), done, want);
  def nt-least(gaps, done, best) = nil?(gaps) ? best : nt-least(tail(gaps), done, nil?(best) || (nt-attempts(nt-str(head(gaps), "id"), done) < nt-attempts(nt-str(head(best), "id"), done)) ? list(head(gaps)) : best);
  def nt-pick(queue, done, want) = nt-least(nt-open(queue, done, want), done, list());
  // a band reads its number only when its run exits 0 with a number on its last line; anything else is a fold
  // over nothing and reads nothing (axiom-1), never a number and never a -1 code. The run is a live step
  // (form-stdlib/bml/live.bml), spoken as it lands against the gap's full; a band short of full needs code,
  // and the repair that meets it is this turn's own walk through the lane. The compiler's own error lines
  // stay beside the reading.
  def nt-out() = nt-dir() ++ "/band.out";
  def nt-err() = nt-dir() ++ "/band.err";
  def nt-number(t) = ((Comparable) str_len(t) > 0) && ((Comparable) nt-digits-end(t, 0) == str_len(t)) ? str_to_int(t) : nothing();
  def nt-digits-end(s, i) = (i < str_len(s)) && (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? nt-digits-end(s, i + 1) : i;
  def nt-last-line(lines, last) = nil?(lines) ? last : nt-last-line(tail(lines), (Comparable) str_len(trim(head(lines))) == 0 ? last : trim(head(lines)));
  def nt-band-run(ctx) {
   let gone = host_path_remove(nt-out());
   let pid = host_spawn_at(list("./fkwu", ctx[0]), list("/dev/null", nt-out(), nt-err()));
   let status = pid <= 0 ? nothing() : host_wait(pid);
   nothing?(status) || (!((Comparable) status == 0)) ? nothing() : nt-number(nt-last-line(split-on(nt-read(nt-out()), "\n"), ""));
  }
  def nt-full?(value, ctx) = nothing?(value) ? false : ((Comparable) value == ctx[1]);
  def nt-band(path, full) {
   let made = fs_mkdir(nt-dir());
   let heard = host_path_remove(nt-err());
   live-do("native-turn", path, list(path, full), nt-band-run, nt-full?, list())[1];
  }
  def nt-read(path) = file_size(path) < 1 ? "" : fhn-read(path);
  def nt-starts?(s, p) = (str_len(s) >= str_len(p)) && ((String) substring(s, 0, str_len(p)) == p);
  def nt-error-lines(lines, n) = nil?(lines) || (n <= 0) ? list() : (str_find(head(lines), "error", 0) >= 0) && (!nt-starts?(head(lines), "form-organ")) ? cons(substring(head(lines), 0, str_len(head(lines)) > 300 ? 300 : str_len(head(lines))), nt-error-lines(tail(lines), n - 1)) : nt-error-lines(tail(lines), n);
  def nt-band-errors() = trim(nt-join(nt-error-lines(split-on(nt-read(nt-dir() ++ "/band.err"), "\n"), 6)));
  // A band whose claims are live steps (form-stdlib/bml/live.bml) speaks each as an organ-health reading on
  // stderr. The steps whose last reading did not hold are the backtracking signal the next option hears:
  // what each answered, and the repairs the band already tried in its own run.
  def nt-health-prefix() = "form-organ health ";
  def nt-band-rows(lines) = nil?(lines) ? list() : nt-starts?(head(lines), nt-health-prefix()) && (str_find(head(lines), "\"organ\":\"live\"", 0) >= 0) ? cons(parse-json("band-reading", substring(head(lines), str_len(nt-health-prefix()), str_len(head(lines)))), nt-band-rows(tail(lines))) : nt-band-rows(tail(lines));
  def nt-row-str(row, key) = json-object-has?(row, key) ? json-string-value(json-object-get(row, key)) : "";
  def nt-observe?(row) = (String) nt-row-str(row, "stage") == "observe";
  def nt-aspects(rows, seen) = nil?(rows) ? reverse(seen) : nt-aspects(tail(rows), nt-observe?(head(rows)) && ((Comparable) nt-has(seen, nt-row-str(head(rows), "aspect")) == 0) ? cons(nt-row-str(head(rows), "aspect"), seen) : seen);
  def nt-last-observed(rows, aspect, found) = nil?(rows) ? found : nt-last-observed(tail(rows), aspect, nt-observe?(head(rows)) && ((String) nt-row-str(head(rows), "aspect") == aspect) ? head(rows) : found);
  def nt-tried(rows, aspect) = nt-tried-go(rows, aspect, list());
  def nt-tried-go(rows, aspect, seen) = nil?(rows) ? reverse(seen) : nt-tried-go(tail(rows), aspect, ((String) nt-row-str(head(rows), "stage") == "applied") && ((String) nt-row-str(head(rows), "aspect") == aspect) && ((Comparable) nt-has(seen, nt-row-str(head(rows), "selected")) == 0) ? cons(nt-row-str(head(rows), "selected"), seen) : seen);
  def nt-comma(xs) = nil?(xs) ? "" : nil?(tail(xs)) ? head(xs) : (head(xs) ++ ", " ++ nt-comma(tail(xs)));
  def nt-claim-line(rows, aspect) {
   let last = nt-last-observed(rows, aspect, json-node-object(list()));
   let held = node_eq(json-object-get(last, "health"), json-node-int(1));
   let tried = nt-tried(rows, aspect);
   held ? "" : ("claim " ++ aspect ++ " answered " ++ json-emit(json-object-get(last, "observed")) ++ " and did not hold" ++ (nil?(tried) ? "" : ("; the band already tried " ++ nt-comma(tried))) ++ "\n");
  }
  def nt-claim-lines(rows, aspects) = nil?(aspects) ? "" : nt-claim-line(rows, head(aspects)) ++ nt-claim-lines(rows, tail(aspects));
  def nt-band-claims() {
   let rows = nt-band-rows(split-on(nt-read(nt-err()), "\n"));
   trim(nt-claim-lines(rows, nt-aspects(rows, list())));
  }
  // who began this turn
  def nt-row-of(value) = (String) value_kind(value) == "int" ? list() : value;
  def nt-self() = nt-row-of(host_process(host_pid()));
  def nt-parent(me) = len(me) < 2 ? list() : nt-row-of(host_process(me[1]));
  def nt-exe(row) = len(row) < 3 ? "" : row[2];
  def nt-tail(path, i) = i <= 0 ? path : (Comparable) str_byte_at(path, i - 1) == 47 ? substring(path, i, str_len(path)) : nt-tail(path, i - 1);
  def nt-base(path) = (String) path == "" ? "" : nt-tail(path, str_len(path));
  def nt-glue?(exe) = ((String) nt-base(exe) == "fkwu") || (((String) nt-base(exe) == "sh") || (((String) nt-base(exe) == "zsh") || (((String) nt-base(exe) == "bash") || ((String) nt-base(exe) == "form-run"))));
  def nt-climb(row, hops) = (len(row) < 3) || (hops <= 0) ? row : nt-glue?(nt-exe(row)) ? nt-climb(nt-parent(row), hops - 1) : row;
  def nt-coordinator() = nt-exe(nt-climb(nt-parent(nt-self()), 8));
  def nt-keeper?(exe) = (String) nt-base(exe) == "launchd";
  // the request the native code lane reads
  def nt-doc(path) = json-node-object(list(fhn-s("id", nt-base(path)), fhn-s("path", path), fhn-s("text", fhn-read(path))));
  def nt-docs(paths) = nil?(paths) ? list() : cons(nt-doc(head(paths)), nt-docs(tail(paths)));
  def nt-check(path) = json-node-object(list(fhn-s("tool", "rehearse-bml"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("input", "")));
  def nt-bml?(path) = (str_len(path) > 4) && ((String) substring(path, str_len(path) - 4, str_len(path)) == ".bml");
  def nt-checks(paths) = nil?(paths) ? list() : nt-bml?(head(paths)) ? cons(nt-check(head(paths)), nt-checks(tail(paths))) : nt-checks(tail(paths));
  def nt-strings(xs) = nil?(xs) ? list() : cons(json-node-string(head(xs)), nt-strings(tail(xs)));
  // every writable file keeps the paren and brace balance it had before the lane (the lane's read-only balance tool)
  def nt-count(text, i, n, open, close, d) = i >= n ? d : nt-count(text, i + 1, n, open, close, (Comparable) str_byte_at(text, i) == open ? (d + 1) : (Comparable) str_byte_at(text, i) == close ? (d - 1) : d);
  def nt-balance-text(text) = int_to_str(nt-count(text, 0, str_len(text), 40, 41, 0)) ++ " " ++ int_to_str(nt-count(text, 0, str_len(text), 123, 125, 0)) ++ "\n";
  def nt-balance(path) = json-node-object(list(fhn-s("tool", "balance"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("stdout", nt-balance-text(fhn-read(path)))));
  // every writable Form source is read against the arities fkwu's reader demands, in the lane's own session: a call
  // with the wrong count shows while the lane works, not after its band stops (form-stdlib/bml/form-agent-tools.bml)
  def nt-fk?(path) = ((str_len(path) > 3) && ((String) substring(path, str_len(path) - 3, str_len(path)) == ".fk")) && (!nt-bml-surface?(nt-read(path)));
  def nt-bml-surface?(t) = ((str_len(t) >= 9) && ((String) substring(t, 0, 9) == "section [")) || (str_find(t, "\nsection [", 0) >= 0);
  def nt-arity(path) = json-node-object(list(fhn-s("tool", "arity"), json-node-pair("arguments", json-node-array(list(json-node-string(path)))), fhn-s("stdout", "")));
  def nt-balances(paths) = nil?(paths) ? list() : cons(nt-balance(head(paths)), nt-fk?(head(paths)) ? cons(nt-arity(head(paths)), nt-balances(tail(paths))) : nt-balances(tail(paths)));
  // a gap over a file larger than the voice's context names "document_context":"catalog": the lane then keeps the
  // text behind its read-only tools and works it by region, where "full" hands every writable document whole
  def nt-context(gap) = json-object-has?(gap, "document_context") ? nt-str(gap, "document_context") : "full";
  def nt-request(gap, opts, goal) = json-node-object(list(fhn-s("goal", goal), json-node-pair("documents", json-node-array(nt-docs(nt-strs(gap, "writable")))), json-node-pair("writable", json-node-array(nt-strings(nt-strs(gap, "writable")))), json-node-pair("checks", json-node-array(append(json-object-has?(gap, "checks") ? json-array-elements(json-object-get(gap, "checks")) : nt-checks(nt-strs(gap, "writable")), nt-balances(nt-strs(gap, "writable"))))), fhn-s("model", json-object-has?(opts, "model") ? nt-str(opts, "model") : "qwen38-q8"), fhn-n("context", nt-int(opts, "context", 16384)), fhn-n("turns", nt-int(opts, "turns", 32)), fhn-s("document_context", nt-context(gap))));
  def nt-quote(s) = "'" ++ s ++ "'";
  // the lane keeps its documents in its own session and the caller publishes them: find the result line, write each
  // final document whose path is writable, and read the lane's status beside it
  def nt-marker() = "\"schema\":\"form-native-code-v1\"";
  def nt-result(lines, found) = nil?(lines) ? found : nt-result(tail(lines), str_find(head(lines), nt-marker(), 0) >= 0 ? head(lines) : found);
  def nt-result-of(outPath) { let r = nt-result(split-on(file_size(outPath) < 1 ? "" : fhn-read(outPath), "\n"), ""); (String) r == "" ? json-node-object(list()) : parse-json("code-result", r); }
  def nt-has(xs, x) = nil?(xs) ? 0 : (String) head(xs) == x ? 1 : nt-has(tail(xs), x);
  def nt-publish(docs, writable, n) = nil?(docs) ? n : nt-publish(tail(docs), writable, (Comparable) nt-has(writable, nt-str(head(docs), "path")) == 1 ? nt-publish-one(head(docs), n) : n);
