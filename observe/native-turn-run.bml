  def nt-diff-one(path, original) { let d = td-diff(original, nt-read(path), 1, 2400); (String) d == "" ? "" : ("--- " ++ path ++ "\n" ++ d); }
  def nt-finding(n, before, after, full, said, status, published, diff, errors, claims) = "Attempt " ++ int_to_str(n) ++ ": the band read " ++ nt-reading-text(after) ++ " of " ++ int_to_str(full) ++ " (it began at " ++ nt-reading-text(before) ++ "); the lane said " ++ trim(said) ++ ((String) status == "" ? "" : (" with status " ++ status)) ++ ((Comparable) published == 0 ? "; it published no document." : ("; its candidate changed:\n" ++ diff)) ++ ((Comparable) str_len(errors) == 0 ? "" : ("\nThe band did not read; the compiler said:\n" ++ errors)) ++ ((Comparable) str_len(claims) == 0 ? "" : ("\nThe band's claims that did not hold:\n" ++ claims));
  // one option: ask the lane, publish, read the band; returns (list green row finding)
