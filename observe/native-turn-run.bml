   let kept = green && (!test) ? 0 : nt-keep(nt-strs(gap, "writable"), originals, stamp);
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("gap", id), fhn-n("option", n), nt-reading("band_before", before), nt-reading("band_after", after), fhn-n("full", full), fhn-n("band_green", green ? 1 : 0), fhn-n("dry", dry ? 1 : 0), fhn-n("test", test ? 1 : 0), fhn-s("coordinated_by", nt-keeper?(coordinator) ? "host-schedule" : "session"), fhn-s("coordinator", coordinator), fhn-n("rented_mind", nt-keeper?(coordinator) ? 0 : 1), fhn-s("request", reqPath), fhn-s("lane", trim(said)), fhn-s("lane_status", nt-str(result, "status")), nt-reading("lane_check_runs", nt-maybe(result, "check_runs")), nt-reading("lane_turns", nt-maybe(result, "turns")), fhn-n("published", published), fhn-n("wall_ms", now_unix_ms() - started)));
   let appended = fhn-append(test ? (nt-dir() ++ "/test-ledger.jsonl") : nt-ledger(), json-emit(row) ++ "\n");
   let shown = print_str("[native-turn] " ++ json-emit(row) ++ "\n");
   list(green ? 1 : 0, row, finding);
  }
 }
 nt-run();
}
