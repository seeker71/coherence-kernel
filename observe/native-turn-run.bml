// native-turn-run.bml — one engineering turn by the body's own loop: a queued gap, the native code lane, the band.
//
// Reads learn/native-turn-queue.jsonl (id, goal, writable, band, full, and optionally document_context "catalog"
// for a writable file larger than the voice's context) and takes the open gap with the fewest
// attempts in receipts/native-turn-ledger.jsonl. Runs the gap's band in its own fresh kernel; when it already
// reads full the gap is closed and nothing runs. Otherwise the turn is a backtrack walk (oac-backtrack-walk,
// control/choice-lane-core.fk) over two options for the same gap. The first hands the goal to the native code lane
// (observe/form-cli-code-run.fk: local Qwen in one native session, no rented fallback) with the writable sources
// as documents and the gap's own read-only checks, then runs the band again. An option whose band did not turn
// green is a backtrack point, not an end: it keeps its candidate under .hearth/native-turns, restores the source,
// and acks a node carrying what it saw (the band's reading, the lane's status, the candidate's diff, and the
// compiler's own words when the band did not read). The second
// option receives the same gap and that finding, and asks the lane again with the goal and what the first attempt
// saw, so the second choice is made in line with the first and nothing learned is lost. A green option keeps its
// edit for the landing and ends the walk. Each option lands its own row: gap, option, band before and after
// (null when the band printed no number), full, band_green, and who began the turn, read from the host's own
// process table (launchd is the host's schedule, anything else a session with a rented mind).
// A test turn ({"test":1}) writes its rows to .hearth/native-turns/test-ledger.jsonl and always restores the
// source, so a turn begun by a session can learn what the lane can do without closing a gap the nights must close.
// {"publish_from":"<lane output>"} publishes a result already on disk instead of asking the lane (a test of the path);
// {"candidate":"<file>"} publishes that file's text as the gap's first writable document (a test of one candidate).
// stdin, optional: {"gap":"<id>","dry":1,"test":1,"model":"qwen38-q8","context":16384,"turns":32}; dry skips the lane.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/bml/text-diff.bml form-stdlib/bml/stdin-source.bml form-stdlib/bml/live.bml
section [form.bml] {
 class NativeTurn {
  def nt-queue() = "learn/native-turn-queue.jsonl";
  def nt-ledger() = "receipts/native-turn-ledger.jsonl";
  def nt-dir() = ".hearth/native-turns";
  def nt-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def nt-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def nt-maybe(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : nothing();
  def nt-strs(doc, key) = json-object-has?(doc, key) ? nt-values(json-array-elements(json-object-get(doc, key))) : [];
  def nt-values(nodes) = nodes |> map(json-string-value);
  def nt-nonempty(xs) = nil?(xs) ? [] : (Comparable) len(trim(xs[0])) == 0 ? nt-nonempty(xs[1:]) : cons(xs[0], nt-nonempty(xs[1:]));
  def nt-parse(xs) = xs |> map(x => parse-json("native-turn-row", x));
  def nt-rows(path) = file_size(path) < 1 ? [] : nt-parse(nt-nonempty(split-on(fhn-read(path), "\n")));
  def nt-green?(id, rows) = nil?(rows) ? 0 : ((String) nt-str(rows[0], "gap") == id) && ((Comparable) nt-int(rows[0], "band_green", 0) == 1) ? 1 : nt-green?(id, rows[1:]);
  // the open gap with the fewest real attempts, in queue order among equals, so one gap the lane cannot yet
  // close does not hold the others
  def nt-attempts(id, rows) = nil?(rows) ? 0 : ((((String) nt-str(rows[0], "gap") == id) && ((Comparable) nt-int(rows[0], "dry", 0) == 0) ? 1 : 0) + nt-attempts(id, rows[1:]));
  def nt-open(queue, done, want) = nil?(queue) ? [] : (((String) want == "") || ((String) nt-str(queue[0], "id") == want)) && ((Comparable) nt-green?(nt-str(queue[0], "id"), done) == 0) ? cons(queue[0], nt-open(queue[1:], done, want)) : nt-open(queue[1:], done, want);
  def nt-least(gaps, done, best) = nil?(gaps) ? best : nt-least(gaps[1:], done, nil?(best) || (nt-attempts(nt-str(gaps[0], "id"), done) < nt-attempts(nt-str(best[0], "id"), done)) ? [gaps[0]] : best);
  def nt-pick(queue, done, want) = nt-least(nt-open(queue, done, want), done, []);
  // a band reads its number only when its run exits 0 with a number on its last line; anything else is a fold
  // over nothing and reads nothing (axiom-1), never a number and never a -1 code. The run is a live step
  // (form-stdlib/bml/live.bml), spoken as it lands against the gap's full; a band short of full needs code,
  // and the repair that meets it is this turn's own walk through the lane. The compiler's own error lines
  // stay beside the reading.
  def nt-out() = nt-dir() ++ "/band.out";
  def nt-err() = nt-dir() ++ "/band.err";
  def nt-number(t) = ((Comparable) len(t) > 0) && ((Comparable) nt-digits-end(t, 0) == len(t)) ? str_to_int(t) : nothing();
  def nt-digits-end(s, i) = (i < len(s)) && (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? nt-digits-end(s, i + 1) : i;
  def nt-last-line(lines, last) = nil?(lines) ? last : nt-last-line(lines[1:], (Comparable) len(trim(lines[0])) == 0 ? last : trim(lines[0]));
  def nt-band-run(ctx) {
   let gone = host_path_remove(nt-out());
   let pid = host_spawn_at(["./fkwu", ctx[0]], ["/dev/null", nt-out(), nt-err()]);
   let status = pid <= 0 ? nothing() : host_wait(pid);
   nothing?(status) || (!((Comparable) status == 0)) ? nothing() : nt-number(nt-last-line(split-on(nt-read(nt-out()), "\n"), ""));
  }
  def nt-full?(value, ctx) = nothing?(value) ? false : ((Comparable) value == ctx[1]);
  def nt-band(path, full) {
   let made = fs_mkdir(nt-dir());
   let heard = host_path_remove(nt-err());
   live-do("native-turn", path, [path, full], nt-band-run, nt-full?, [])[1];
  }
  def nt-read(path) = file_size(path) < 1 ? "" : fhn-read(path);
  def nt-starts?(s, p) = (len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
  def nt-error-lines(lines, n) = nil?(lines) || (n <= 0) ? [] : (str_find(lines[0], "error", 0) >= 0) && (!nt-starts?(lines[0], "form-organ")) ? cons(substring(lines[0], 0, len(lines[0]) > 300 ? 300 : len(lines[0])), nt-error-lines(lines[1:], n - 1)) : nt-error-lines(lines[1:], n);
  def nt-band-errors() = trim(nt-join(nt-error-lines(split-on(nt-read(nt-dir() ++ "/band.err"), "\n"), 6)));
  // A band whose claims are live steps (form-stdlib/bml/live.bml) speaks each as an organ-health reading on
  // stderr. The steps whose last reading did not hold are the backtracking signal the next option hears:
  // what each answered, and the repairs the band already tried in its own run.
  def nt-health-prefix() = "form-organ health ";
  def nt-band-rows(lines) = nil?(lines) ? [] : nt-starts?(lines[0], nt-health-prefix()) && (str_find(lines[0], "\"organ\":\"live\"", 0) >= 0) ? cons(parse-json("band-reading", substring(lines[0], len(nt-health-prefix()), len(lines[0]))), nt-band-rows(lines[1:])) : nt-band-rows(lines[1:]);
  def nt-row-str(row, key) = json-object-has?(row, key) ? json-string-value(json-object-get(row, key)) : "";
  def nt-observe?(row) = (String) nt-row-str(row, "stage") == "observe";
  def nt-aspects(rows, seen) = nil?(rows) ? reverse(seen) : nt-aspects(rows[1:], nt-observe?(rows[0]) && ((Comparable) nt-has(seen, nt-row-str(rows[0], "aspect")) == 0) ? cons(nt-row-str(rows[0], "aspect"), seen) : seen);
  def nt-last-observed(rows, aspect, found) = nil?(rows) ? found : nt-last-observed(rows[1:], aspect, nt-observe?(rows[0]) && ((String) nt-row-str(rows[0], "aspect") == aspect) ? rows[0] : found);
  def nt-tried(rows, aspect) = nt-tried-go(rows, aspect, []);
  def nt-tried-go(rows, aspect, seen) = nil?(rows) ? reverse(seen) : nt-tried-go(rows[1:], aspect, ((String) nt-row-str(rows[0], "stage") == "applied") && ((String) nt-row-str(rows[0], "aspect") == aspect) && ((Comparable) nt-has(seen, nt-row-str(rows[0], "selected")) == 0) ? cons(nt-row-str(rows[0], "selected"), seen) : seen);
  def nt-comma(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : (xs[0] ++ ", " ++ nt-comma(xs[1:]));
  def nt-claim-line(rows, aspect) {
   let last = nt-last-observed(rows, aspect, json-node-object([]));
   let held = node_eq(json-object-get(last, "health"), json-node-int(1));
   let tried = nt-tried(rows, aspect);
   held ? "" : ("claim " ++ aspect ++ " answered " ++ json-emit(json-object-get(last, "observed")) ++ " and did not hold" ++ (nil?(tried) ? "" : ("; the band already tried " ++ nt-comma(tried))) ++ "\n");
  }
  def nt-claim-lines(rows, aspects) = nil?(aspects) ? "" : nt-claim-line(rows, aspects[0]) ++ nt-claim-lines(rows, aspects[1:]);
  def nt-band-claims() {
   let rows = nt-band-rows(split-on(nt-read(nt-err()), "\n"));
   trim(nt-claim-lines(rows, nt-aspects(rows, [])));
  }
  // who began this turn
  def nt-row-of(value) = (String) value_kind(value) == "int" ? [] : value;
  def nt-self() = nt-row-of(host_process(host_pid()));
  def nt-parent(me) = len(me) < 2 ? [] : nt-row-of(host_process(me[1]));
  def nt-exe(row) = len(row) < 3 ? "" : row[2];
  def nt-tail(path, i) = i <= 0 ? path : (Comparable) str_byte_at(path, i - 1) == 47 ? substring(path, i, len(path)) : nt-tail(path, i - 1);
  def nt-base(path) = (String) path == "" ? "" : nt-tail(path, len(path));
  def nt-glue?(exe) = ((String) nt-base(exe) == "fkwu") || (((String) nt-base(exe) == "sh") || (((String) nt-base(exe) == "zsh") || (((String) nt-base(exe) == "bash") || ((String) nt-base(exe) == "form-run"))));
  def nt-climb(row, hops) = (len(row) < 3) || (hops <= 0) ? row : nt-glue?(nt-exe(row)) ? nt-climb(nt-parent(row), hops - 1) : row;
  def nt-coordinator() = nt-exe(nt-climb(nt-parent(nt-self()), 8));
  def nt-keeper?(exe) = (String) nt-base(exe) == "launchd";
  // the request the native code lane reads
  def nt-doc(path) = json-node-object([fhn-s("id", nt-base(path)), fhn-s("path", path), fhn-s("text", fhn-read(path))]);
  def nt-docs(paths) = paths |> map(nt-doc);
  def nt-check(path) = json-node-object([fhn-s("tool", "rehearse-bml"), json-node-pair("arguments", json-node-array([json-node-string(path)])), fhn-s("input", "")]);
  def nt-bml?(path) = (len(path) > 4) && ((String) substring(path, len(path) - 4, len(path)) == ".bml");
  def nt-checks(paths) = nil?(paths) ? [] : nt-bml?(paths[0]) ? cons(nt-check(paths[0]), nt-checks(paths[1:])) : nt-checks(paths[1:]);
  def nt-strings(xs) = xs |> map(json-node-string);
  // every writable file keeps the paren and brace balance it had before the lane (the lane's read-only balance tool)
  def nt-count(text, i, n, open, close, d) = i >= n ? d : nt-count(text, i + 1, n, open, close, (Comparable) str_byte_at(text, i) == open ? (d + 1) : (Comparable) str_byte_at(text, i) == close ? (d - 1) : d);
  def nt-balance-text(text) = nt-count(text, 0, len(text), 40, 41, 0).str() ++ " " ++ nt-count(text, 0, len(text), 123, 125, 0).str() ++ "\n";
  def nt-balance(path) = json-node-object([fhn-s("tool", "balance"), json-node-pair("arguments", json-node-array([json-node-string(path)])), fhn-s("stdout", nt-balance-text(fhn-read(path)))]);
  // every writable Form source is read against the arities fkwu's reader demands, in the lane's own session: a call
  // with the wrong count shows while the lane works, not after its band stops (form-stdlib/bml/form-agent-tools.bml)
  def nt-fk?(path) = ((len(path) > 3) && ((String) substring(path, len(path) - 3, len(path)) == ".fk")) && (!nt-bml-surface?(nt-read(path)));
  def nt-bml-surface?(t) = ((len(t) >= 9) && ((String) substring(t, 0, 9) == "section [")) || (str_find(t, "\nsection [", 0) >= 0);
  def nt-arity(path) = json-node-object([fhn-s("tool", "arity"), json-node-pair("arguments", json-node-array([json-node-string(path)])), fhn-s("stdout", "")]);
  def nt-balances(paths) = nil?(paths) ? [] : cons(nt-balance(paths[0]), nt-fk?(paths[0]) ? cons(nt-arity(paths[0]), nt-balances(paths[1:])) : nt-balances(paths[1:]));
  // a gap over a file larger than the voice's context names "document_context":"catalog": the lane then keeps the
  // text behind its read-only tools and works it by region, where "full" hands every writable document whole
  def nt-context(gap) = json-object-has?(gap, "document_context") ? nt-str(gap, "document_context") : "full";
  def nt-request(gap, opts, goal) = json-node-object([fhn-s("goal", goal), json-node-pair("documents", json-node-array(nt-docs(nt-strs(gap, "writable")))), json-node-pair("writable", json-node-array(nt-strings(nt-strs(gap, "writable")))), json-node-pair("checks", json-node-array(append(json-object-has?(gap, "checks") ? json-array-elements(json-object-get(gap, "checks")) : nt-checks(nt-strs(gap, "writable")), nt-balances(nt-strs(gap, "writable"))))), fhn-s("model", json-object-has?(opts, "model") ? nt-str(opts, "model") : "qwen38-q8"), fhn-n("context", nt-int(opts, "context", 16384)), fhn-n("turns", nt-int(opts, "turns", 32)), fhn-s("document_context", nt-context(gap))]);
  def nt-quote(s) = "'" ++ s ++ "'";
  // the lane keeps its documents in its own session and the caller publishes them: find the result line, write each
  // final document whose path is writable, and read the lane's status beside it
  def nt-marker() = "\"schema\":\"form-native-code-v1\"";
  def nt-result(lines, found) = nil?(lines) ? found : nt-result(lines[1:], str_find(lines[0], nt-marker(), 0) >= 0 ? lines[0] : found);
  def nt-result-of(outPath) { let r = nt-result(split-on(file_size(outPath) < 1 ? "" : fhn-read(outPath), "\n"), ""); (String) r == "" ? json-node-object([]) : parse-json("code-result", r); }
  def nt-has(xs, x) = nil?(xs) ? 0 : (String) xs[0] == x ? 1 : nt-has(xs[1:], x);
  def nt-publish(docs, writable, n) = nil?(docs) ? n : nt-publish(docs[1:], writable, (Comparable) nt-has(writable, nt-str(docs[0], "path")) == 1 ? nt-publish-one(docs[0], n) : n);
  def nt-publish-one(doc, n) { let w = write_file_text(nt-str(doc, "path"), nt-str(doc, "text")); n + 1; }
  // {"candidate":"<path>"}: the text at <path> stands as the lane's document for the gap's first writable file
  def nt-candidate-result(gap, path) = json-node-object([fhn-s("status", "candidate"), json-node-pair("documents", json-node-array([json-node-object([fhn-s("path", nt-strs(gap, "writable")[0]), fhn-s("text", nt-read(path))])]))]);
  def nt-docs-of(result) = json-object-has?(result, "documents") ? json-array-elements(json-object-get(result, "documents")) : [];
  // the checkpoint is a value: each writable file's text as it stood before the lane
  def nt-texts(paths) = store(paths |> map(nt-read));
  // keep the candidate beside the turn, then return each file to its checkpoint
  def nt-keep(paths, originals, stamp) = nil?(paths) ? 0 : nt-keep-next(write_file_text(nt-dir() ++ "/" ++ stamp ++ "-" ++ nt-base(paths[0]) ++ ".candidate", nt-read(paths[0])), write_file_text(paths[0], restore(originals[0])), paths, originals, stamp);
  def nt-keep-next(kept, restored, paths, originals, stamp) = 1 + nt-keep(paths[1:], originals[1:], stamp);
  def nt-run() {
   let line = trim(stdin-text());
   let opts = (String) line == "" ? json-node-object([]) : parse-json("native-turn-options", line);
   let picked = nt-pick(nt-rows(nt-queue()), nt-rows(nt-ledger()), nt-str(opts, "gap"));
   nil?(picked) ? print_str("[native-turn] no open gap\n") : nt-turn(picked[0], opts);
  }
  def nt-turn(gap, opts) {
   let id = nt-str(gap, "id");
   let full = nt-int(gap, "full", 0);
   let band = nt-str(gap, "band");
   let before = nt-band(band, full);
   let coordinator = nt-coordinator();
   (Comparable) before == full ? print_str("[native-turn] " ++ id ++ " already reads " ++ full.str() ++ "\n") : nt-walk(gap, opts, id, full, band, before, coordinator);
  }
  // the turn is a backtrack walk over two options for the same gap; the second receives what the first saw
  def nt-walk(gap, opts, id, full, band, before, coordinator) {
   let w = oac-backtrack-walk([nt-option-first, nt-option-again], [gap, opts, id, full, band, before, coordinator], []);
   let landed = (Comparable) oac-one?(oac-backtrack-ack(w)) == 1;
   let carried = len(oac-backtrack-memory(w));
   print_str("[native-turn:walk] " ++ id ++ (landed ? " green after " : " declined after ") ++ (landed ? (carried + 1) : carried).str() ++ " option(s); findings carried forward: " ++ carried.str() ++ "\n");
  }
  def nt-option-first(offered) = nt-option(offered, 1);
  def nt-option-again(offered) = nt-option(offered, 2);
  def nt-option(offered, n) {
   let a = oac-option-args(offered);
   let memory = oac-option-memory(offered);
   let gap = a[0];
   let goal = nil?(memory) ? nt-str(gap, "goal") : nt-refine-goal(nt-str(gap, "goal"), memory);
   let r = nt-attempt(gap, a[1], a[2], a[3], a[4], a[5], a[6], goal, n);
   (Comparable) r[0] == 1 ? oac-one(r[1]) : oac-node(r[2]);
  }
  def nt-join(xs) = nil?(xs) ? "" : (xs[0] ++ "\n" ++ nt-join(xs[1:]));
  def nt-refine-goal(goal, memory) = goal ++ "\n\nThis goal was tried before in this turn. What those attempts saw (keep what served the band, change what did not):\n" ++ nt-join(memory);
  // a band reading as text: a band that printed no number reads nothing — the file did not compile or the band stopped
  def nt-reading-text(v) = nothing?(v) ? "nothing (the band printed no number: the source did not compile or the band stopped)" : v.str();
  def nt-reading(key, v) = nothing?(v) ? json-node-pair(key, json-node-null()) : fhn-n(key, v);
  // the candidate's change against its checkpoint, read in Form (form-stdlib/bml/text-diff.bml)
  def nt-diff(paths, originals) = nil?(paths) ? "" : (nt-diff-one(paths[0], originals[0]) ++ nt-diff(paths[1:], originals[1:]));
  def nt-diff-one(path, original) { let d = td-diff(original, nt-read(path), 1, 2400); (String) d == "" ? "" : ("--- " ++ path ++ "\n" ++ d); }
  def nt-finding(n, before, after, full, said, status, published, diff, errors, claims) = "Attempt " ++ n.str() ++ ": the band read " ++ nt-reading-text(after) ++ " of " ++ full.str() ++ " (it began at " ++ nt-reading-text(before) ++ "); the lane said " ++ trim(said) ++ ((String) status == "" ? "" : (" with status " ++ status)) ++ ((Comparable) published == 0 ? "; it published no document." : ("; its candidate changed:\n" ++ diff)) ++ ((Comparable) len(errors) == 0 ? "" : ("\nThe band did not read; the compiler said:\n" ++ errors)) ++ ((Comparable) len(claims) == 0 ? "" : ("\nThe band's claims that did not hold:\n" ++ claims));
  // one option: ask the lane, publish, read the band; returns (list green row finding)
  def nt-attempt(gap, opts, id, full, band, before, coordinator, goal, n) {
   let made = fs_mkdir(nt-dir());
   let stamp = id ++ "-" ++ now_unix_ms().str();
   let reqPath = nt-dir() ++ "/" ++ stamp ++ ".json";
   let wrote = write_file_text(reqPath, json-emit(nt-request(gap, opts, goal)));
   let started = now_unix_ms();
   let dry = (Comparable) nt-int(opts, "dry", 0) == 1;
   let outPath = json-object-has?(opts, "publish_from") ? nt-str(opts, "publish_from") : (nt-dir() ++ "/" ++ stamp ++ ".out");
   let said = dry || (json-object-has?(opts, "publish_from") || json-object-has?(opts, "candidate")) ? "not-run" : host-exec("./fkwu observe/form-cli-code-run.fk > " ++ nt-quote(outPath) ++ " 2> " ++ nt-quote(outPath ++ ".err") ++ "; echo lane-exit=$?", "@" ++ reqPath ++ "\n");
   let result = dry ? json-node-object([]) : json-object-has?(opts, "candidate") ? nt-candidate-result(gap, nt-str(opts, "candidate")) : nt-result-of(outPath);
   let originals = nt-texts(nt-strs(gap, "writable"));
   let published = nt-publish(nt-docs-of(result), nt-strs(gap, "writable"), 0);
   let after = nt-band(band, full);
   let errors = nothing?(after) ? nt-band-errors() : "";
   let green = ((Comparable) after == full) && (!((Comparable) before == full));
   let test = (Comparable) nt-int(opts, "test", 0) == 1;
   let claims = green ? "" : nt-band-claims();
   let finding = green ? "" : nt-finding(n, before, after, full, said, nt-str(result, "status"), published, nt-diff(nt-strs(gap, "writable"), originals), errors, claims);
   let kept = green && (!test) ? 0 : nt-keep(nt-strs(gap, "writable"), originals, stamp);
   let row = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("gap", id), fhn-n("option", n), nt-reading("band_before", before), nt-reading("band_after", after), fhn-n("full", full), fhn-n("band_green", green ? 1 : 0), fhn-n("dry", dry ? 1 : 0), fhn-n("test", test ? 1 : 0), fhn-s("coordinated_by", nt-keeper?(coordinator) ? "host-schedule" : "session"), fhn-s("coordinator", coordinator), fhn-n("rented_mind", nt-keeper?(coordinator) ? 0 : 1), fhn-s("request", reqPath), fhn-s("lane", trim(said)), fhn-s("lane_status", nt-str(result, "status")), nt-reading("lane_check_runs", nt-maybe(result, "check_runs")), nt-reading("lane_turns", nt-maybe(result, "turns")), fhn-n("published", published), fhn-n("wall_ms", now_unix_ms() - started)]);
   let appended = fhn-append(test ? (nt-dir() ++ "/test-ledger.jsonl") : nt-ledger(), json-emit(row) ++ "\n");
   let shown = print_str("[native-turn] " ++ json-emit(row) ++ "\n");
   [green ? 1 : 0, row, finding];
  }
 }
 nt-run();
}
