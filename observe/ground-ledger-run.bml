// ground-ledger-run.bml — what stands on ground, and what stands on a guess.
//
// stdin, one JSON object per line, each a row:
//   {"subject":"...","cell":"...","claim":"...","kind":"witnessed"|"guessed",
//    "witness":"what stands behind it","test":"what would settle it","by":"rented-mind"}
// A witnessed row without its witness is refused; a guessed row without the
// observation that would settle it is refused. Empty stdin lists what stands.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-ground-ledger.bml
section [form.bml] {
 class GroundLedger {
  def gl-line(line) = gl-said(fgl-add(parse-json("ground-request", line)));
  def gl-said(added) = print_str(str_concat(json-emit-precise(head(added)), "\n"));
  def gl-go(seen) {
   let line0 = read_line();
   if nothing?(line0) then gl-end(seen) else gl-next(trim(line0), seen);
  }
  def gl-next(line, seen) = if str_eq(line, "") then gl-go(seen) else gl-go(add(seen, gl-kept(gl-line(line))));
  def gl-kept(printed) = 1;
  def gl-end(seen) = if gt(seen, 0) then seen else gl-list();
  def gl-list() {
   let rows = fgl-rows();
   print_str(json-emit-precise(json-node-object(list(
    fhn-s("ledger", fgl-ledger()),
    fhn-n("rows", fgl-count(rows)),
    fhn-n("witnessed", fgl-count(fgl-of-kind(rows, "witnessed"))),
    fhn-n("guessed", fgl-count(fgl-of-kind(rows, "guessed")))))));
  }
 }
 gl-go(0);
}
