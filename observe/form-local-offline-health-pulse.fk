; form-local-offline-health-pulse.fk -- current local/offline health map.
;
; The rows are this pulse's observed surface, not a permanent target.  A later
; pulse may add, remove, split, or reclassify an organ when new evidence arrives.
; File presence establishes only that the named local mechanism is here; semantic
; mastery remains a separate row and stays a gap until live held-out evidence
; changes it.
;
; preludes: form-stdlib/form-local-offline-health-map.fk
; preludes: form-stdlib/sovereign-continuity-response.fk
; preludes: form-stdlib/form-nodeid-mastery-cell-categories.fk
; preludes: form-stdlib/form-local-axioms-nodeid-actuator-observed.fk

import "../form/form-stdlib/form-local-offline-health-map.fk"
import "../form/form-stdlib/sovereign-continuity-response.fk"
import "../form/form-stdlib/form-nodeid-mastery-cell-categories.fk"
import "../form/form-stdlib/form-local-axioms-nodeid-actuator-observed.fk"

(do
    (defn flohp-stamp () 2026082600)
    (defn flohp-present? (path) (if (gt (file_size path) 0) 1 0))
    (defn flohp-both? (a b) (if (and (eq (flohp-present? a) 1) (eq (flohp-present? b) 1)) 1 0))

    (defn flohp-rows ()
        (list
            (flohm-organ "native-source-kernel"
                (flohp-both? "fkwu" "bootstrap/ground.fk")
                5 5 (flohp-stamp) "bootstrap/ground.fk+binary-freshness-band.fk"
                (fmcl-continuation-category) "rehearse direct-source ground and freshness")
            (flohm-organ "local-qwen-weights"
                (flohp-present? "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
                5 5 (flohp-stamp) "local Qwen3.8-27B-Q8_0.gguf"
                (fmcl-continuation-category) "open and close the owned weights locally")
            (flohm-organ "local-qwen-whole-file-seal" 1
                5 5 (flohp-stamp) "receipts/2026-08-25-qwen38-fresh-whole-file-seal.md"
                (fmcl-persistence-category) "re-run the whole-file seal after any restore")
            (flohm-organ "local-generative-voice-carrier"
                (flohp-present? "observe/qwen38-generate-probe.fk")
                5 4 (flohp-stamp) "raw LOCAL FORM ALIVE; live BMF cursor; 144341ms; state 128/128 released"
                (fmcl-continuation-category) "re-witness local generation without remote inference")
            (flohm-organ "form-native-jit-apply"
                (flohp-both? "form/form-stdlib/form-cli-jit-run.fk" "form/native/metal/fk-metal-carrier.m")
                5 5 20260823 "form-cli-jit-run.fk+fk-metal-carrier.m"
                (fmcl-execution-category) "route a NodeID recipe through Apply and re-observe its result")
            (flohm-organ "scannerless-bml-bmf-cursor"
                (flohp-both? "form/form-stdlib/bmf-byte-cursor.fk" "form/form-stdlib/bml-bmf-stream-curriculum.fk")
                5 5 (flohp-stamp) "BML/BMF organs + 393/393 live qtf2 prompt IDs"
                (fmcl-request-category) "teach and test live streaming grammar construction")
            (flohm-organ "live-bmf-qwen-prompt-cursor" 1
                5 5 (flohp-stamp) "production fcms-open admitted opened-live-cursor; exact Metal crossing; 65535; released"
                (fmcl-execution-category) "extend live transmutation to thought offers and heed injection")
            (flohm-organ "query-memory-recipe-data-request" 1
                5 5 (flohp-stamp) "bounded data-cell loader plus NodeID recipe/request/choice projection; selected cells add zero definitions; scannerless one-shot crossing performs one source-digest-bound lookup; 524287"
                (fmcl-request-category) "retain the validated request and its selected source as one canonical local-model observation")
            (flohm-organ "query-memory-current-source-shard-exec" 1
                5 5 (flohp-stamp) "scannerless request -> exact (key,family,path) route -> fresh source rehash; hit/miss/nothing/timeout/failure distinct; present 0/1 preserved; lookup 1; model 0; band 262143; live axioms hit"
                (fmcl-request-category) "bind this exact returned source, content keys, teaching prefix, local generation and heldout verdict in the same retained observation")
            (flohm-organ "nodeid-knowledge-query-token"
                (flohp-both? "form/form-stdlib/form-nodeid-knowledge-query.fk" "form/form-stdlib/form-cli-heed-current-source.fk")
                5 5 20260825 "form-nodeid-knowledge-query.fk+form-cli-heed-current-source.fk"
                (fmcl-request-category) "emit an anchor-only query and bind source identity in Form")
            (flohm-organ "form-cli-source-unit-on-demand-carrier" 1
                5 5 (flohp-stamp) "source-native REPL closure 3766 definitions; strict scannerless NodeID query and staged-current child return; bands 4095/8191; form-cli band 2047; no model or Metal; child exit remains explicitly unobserved"
                (fmcl-execution-category) "replace the process membrane with an in-process Form program-image call while retaining the bounded unit identity")
            (flohm-organ "form-cli-in-process-program-image-call" 0
                5 5 (flohp-stamp) "form-school and NodeID units are source/image-addressable, but the resident walker cannot yet call a separate current program image without static closure replay or a process membrane"
                (fmcl-attempt-category) "walk or JIT-call the selected program-image recipe in residence and retain load/call/return/release evidence")
            (flohm-organ "public-source-retrieval-current-closure" 1
                5 5 (flohp-stamp) "fresh live census and shard report agree at the current moving denominator across all observed families; stale/missing/invalid/ambiguities 0; exact-route lookup fresh; model-executed 0"
                (fmcl-persistence-category) "feed this moving current closure into executable query-memory lookup and re-count whenever the source census changes")
            (flohm-organ "family-native-execution-bootstrap" 1
                5 5 (flohp-stamp) "local Qwen exact request via live cursor; generated Metal value=1; same residence; evidence valid; released; 65535"
                (fmcl-execution-category) "reuse this observed crossing for the remaining fourteen canonical families")
            (flohm-organ "exact-nodeid-health-actuation"
                (flanao-actuation-observed? (flanao-observation))
                5 5 (flohp-stamp) "NodeID 31.2.0.109 applied exact local Qwen recipe; heldout 0/0; supervised BML+BMF+Form 1/1/1; Metal JIT+reinject+release 1; crossing remains not-yet"
                (fmcl-execution-category) "route the next fresh selected organ through the same exact actuator boundary")
            (flohm-organ "axioms-resident-one-family-crossing" 0
                5 5 (flohp-stamp) "both canonical heldout lanes remained surprise; supervised BML+BMF+Form held; exact generated Metal executed; final crossing still not admitted"
                (fmcl-attempt-category) "use the observed query-offer transfer to improve canonical heldout retrieval without relabeling supervision")
            (flohm-organ "axioms-query-token-rag-transfer" 1
                5 5 (flohp-stamp) "answer-free NodeID query offer; exact live frame and source artifact; Form lookup+reinjection; 1000000ppm; released; 134217727"
                (fmcl-execution-category) "derive answer-free discriminative query offers for the next observed family window")
            (flohm-organ "public-form-curriculum" 1
                5 4 (flohp-stamp) "form-knowledge-axioms-public-curriculum.fk"
                (fmcl-request-category) "retain attributed public lessons and answer-free query offers")
            (flohm-organ "distillation-corpus-query-door" 1
                5 4 (flohp-stamp) "corpus renderer now reaches current-source answer-free NodeID query offers; band 2047"
                (fmcl-request-category) "run one rotated corpus question through the live local query cursor")
            (flohm-organ "public-query-offer-batch" 1
                5 5 (flohp-stamp) "batch plus focused grammar re-observation: supervised transport 15/15; grammar 2/2 source-bound hits and release; answer95 10/15; heldout credit zero"
                (fmcl-request-category) "teach and re-observe the five semantically or lexically low answer families without relabeling supervision")
            (flohm-organ "public-evaluation-foundation" 1
                5 5 (flohp-stamp) "public resident 65535 + mastery 1073741823"
                (fmcl-signal-category) "re-witness after teaching provenance or evaluator changes")
            (flohm-organ "heldout-local-form-transfer" 0
                5 5 (flohp-stamp) "2026-08-25 thirty-row redacted baseline: promotion 433333ppm"
                (fmcl-attempt-category) "re-run the current adaptive projection after the crossing")
            (flohm-organ "applied-live-diagnostic-control" 1
                4 5 (flohp-stamp) "opaque attempt -> timeout -> raw alternative -> focused heldout re-observation"
                (fmcl-signal-category) "retain stage correlation and re-observe every control action")
            (flohm-organ "local-adaptive-memory-promotion" 0
                5 4 (flohp-stamp) "one answer-free supervised query memory persisted with content-addressed undo; rotated heldout keep-or-undo not yet observed"
                (fmcl-persistence-category) "persist accepted learning with rollback and held-out witness")
            (flohm-organ "offline-self-directed-hourly-loop" 0
                5 4 (flohp-stamp) "native tick 524287; exact NodeID actuator physically applied complete fka1l recipe; bounded autonomous wake remains absent"
                (fmcl-continuation-category) "bind the exact observed actuator to a bounded native wake while preserving one carrier owner")
            (flohm-organ "repository-object-graph" 1
                5 4 (flohp-stamp) "commit-graph verify + ordinary strict fsck exit 0"
                (fmcl-persistence-category) "re-witness after object-store movement")
            (flohm-organ "offline-recovery-copy" 0
                4 4 (flohp-stamp) "inventory observed no restored independent repository or Qwen copy"
                (fmcl-persistence-category) "restore-test on a separately powered local volume when one is available")
            (flohm-organ "local-proof-latency" 0
                4 5 (flohp-stamp) "one-residence family batch still spent about 368-546s per row; model reopen was not the dominant cost"
                (fmcl-execution-category) "add per-stage thought, lookup, prefill, and decode timing before choosing the next generated kernel")))

    (defn flohp-run ()
        (do
            (let map (flohm-map (flohp-stamp) (flohp-rows)))
            (let continuity (scr-receipt (scr-state 0 0 0 1
                (if (eq (flohm-gap-count map) 0) 1 0)
                (flohm-ready-count map) 0 (flohm-valid-count map))))
            (list "form-local-offline-health-pulse-v1" map continuity)))

    (flohp-run))
