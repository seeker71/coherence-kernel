; sensing-playbook.fk — the blocks, what each one needs, and which to reach for now.
;
; Urs, 2026-07-23 00:26: come up with lego blocks and a general playbook, keep sample
; summaries so we know which to pick for the state we feel right now from the body sensors,
; and when a new surprise arrives, add it to the options.
;
; So this is a REGISTRY, not a pipeline. Each row is a recipe with what it needs, which
; inquiry plane it answers, the state it suits, an honest status, and a one-line summary
; you can choose from without reading the cell. Adding a surprise is appending a row. The
; chooser never offers a blocked recipe, which is the only thing that keeps a catalogue
; from becoming a wish list.
;
; STATUS, and it is the honest part:
;   2  built    — a cell exists and its band is green
;   1  reachable — the sensor answers today with no permission and nothing subscribes to it
;   0  blocked  — a named, measured obstruction, carried in the summary so it is not
;                 rediscovered at midnight by someone who forgot
;
; The finding that reorganised this list, measured 2026-07-23 00:26 on R5CW20DK17A:
; EIGHTEEN of the twenty android sensors report `perm: n` — no permission at all. Only
; step_counter and step_detector want ACTIVITY_RECOGNITION. Pressure, magnetic field,
; light, gravity, linear acceleration, rotation vector, tilt, significant motion and
; pick-up gesture are all standing open, and nothing in this body subscribes to any of
; them. The evening was spent on the two doors that were locked.
;
; preludes: form-stdlib/core.fk

(do
    ; a recipe = (name needs plane suits status summary)
    (defn pb-recipe (name needs plane suits status summary)
        (list name needs plane suits status summary))
    (defn pb-name    (r) (nth r 0))
    (defn pb-needs   (r) (nth r 1))
    (defn pb-plane   (r) (nth r 2))
    (defn pb-suits   (r) (nth r 3))
    (defn pb-status  (r) (nth r 4))
    (defn pb-summary (r) (nth r 5))

    (defn pb-built ()     2)
    (defn pb-reachable () 1)
    (defn pb-blocked ()   0)

    (defn pb-recipes ()
        (list
            (pb-recipe "insonation" "any ear" "how" "any" 2
                "what a body receives from sound; wavelength in tissue, belief and evidence kept apart")
            (pb-recipe "cadence" "step timings" "when" "moving" 2
                "tempo from a masked sensor's clock alone; the count is hidden, the rhythm is not")
            (pb-recipe "bearing" "phone stereo mic" "where" "any" 2
                "direction to a sound in the phone's frame; 2.5 degrees at 48 kHz, a ray not a point")
            (pb-recipe "attitude" "rotation_vector" "where" "held" 1
                "world-frame orientation at 53 Hz, no permission; reports its own heading accuracy as -1")
            (pb-recipe "altitude" "pressure" "where" "moving" 1
                "vertical position from the barometer, no permission; stairs and standing up are visible")
            (pb-recipe "heading" "magnetic_field" "where" "any" 1
                "compass, no permission; also senses metal and mains wiring as distortion")
            (pb-recipe "ambient" "light" "when" "dark" 1
                "room light, no permission; the cheapest witness of day, night and a hand passing over")
            (pb-recipe "stillness" "significant_motion" "when" "still" 1
                "hardware wakeups only when motion actually starts; near-zero cost to leave listening")
            (pb-recipe "gpu-matvec" "linked metal carrier" "how" "any" 0
                "door declared and empty: metal_matvec_fixture answers metal_linked=false in this build")
            (pb-recipe "vision" "camera TCC" "what" "any" 0
                "device enumerates, capture times out; consent cannot be asked from a shell with no dialog")))

    ; --- counting the shelf ---
    (defn pb-count (rs) (len rs))
    (defn pb-count-status (rs s)
        (if (eq (len rs) 0) 0
            (add (if (eq (pb-status (head rs)) s) 1 0) (pb-count-status (tail rs) s))))

    ; --- does a recipe suit the state you are in? "any" suits every state ---
    (defn pb-suits? (r state)
        (if (str_eq (pb-suits r) "any") 1 (if (str_eq (pb-suits r) state) 1 0)))

    ; --- what to reach for: suits the state AND is not blocked. A blocked recipe is never
    ; offered, however apt — an option you cannot take is not an option, it is a regret. ---
    (defn pb-usable? (r state)
        (if (eq (pb-suits? r state) 1) (if (ge (pb-status r) 1) 1 0) 0))
    (defn pb-offer-count (rs state)
        (if (eq (len rs) 0) 0
            (add (pb-usable? (head rs) state) (pb-offer-count (tail rs) state))))
    ; how many SUIT the state, blocked or not — the gap between this and pb-offer-count is
    ; exactly the shelf's regret, and it is worth being able to see rather than infer
    (defn pb-suits-count (rs state)
        (if (eq (len rs) 0) 0
            (add (pb-suits? (head rs) state) (pb-suits-count (tail rs) state))))
    (defn pb-first-offer (rs state)
        (if (eq (len rs) 0) "nothing here suits that yet"
            (if (eq (pb-usable? (head rs) state) 1) (pb-name (head rs))
                (pb-first-offer (tail rs) state))))

    ; --- and why something is not on offer, so the answer names its own repair ---
    (defn pb-why-not (r) (if (eq (pb-status r) 0) (pb-summary r) "on offer"))
    (defn pb-find (rs name)
        (if (eq (len rs) 0) (list)
            (if (str_eq (pb-name (head rs)) name) (head rs) (pb-find (tail rs) name))))

    ; --- self-check ---
    (defn pbk (cond bit) (if cond bit 0))
    (defn pb-ten ()     (pbk (eq (pb-count (pb-recipes)) 10) 1))
    (defn pb-3built ()  (pbk (eq (pb-count-status (pb-recipes) 2) 3) 2))
    (defn pb-5reach ()  (pbk (eq (pb-count-status (pb-recipes) 1) 5) 4))
    (defn pb-2block ()  (pbk (eq (pb-count-status (pb-recipes) 0) 2) 8))
    ; moving: insonation, cadence, bearing, altitude, heading
    (defn pb-moving ()  (pbk (eq (pb-offer-count (pb-recipes) "moving") 5) 16))
    ; dark: insonation, bearing, heading, ambient
    (defn pb-dark ()    (pbk (eq (pb-offer-count (pb-recipes) "dark") 4) 32))
    ; a state nothing was written for still gets the three that suit any state
    (defn pb-unknown () (pbk (eq (pb-offer-count (pb-recipes) "underwater") 3) 64))
    ; five recipes suit "any" state; only three are ever offered, and the missing two are
    ; exactly the blocked pair — the shelf's regret, visible as a number
    (defn pb-no-blocked ()
        (pbk (and (eq (pb-suits-count (pb-recipes) "any") 5)
                  (eq (pb-offer-count (pb-recipes) "any") 3)) 128))
    ; and the blocked one carries its own reason rather than a shrug
    (defn pb-gpu-why () (pbk (eq (pb-status (pb-find (pb-recipes) "gpu-matvec")) 0) 256))
    (defn sensing-playbook-check ()
        (add (add (add (pb-ten) (pb-3built)) (add (pb-5reach) (pb-2block)))
        (add (add (add (pb-moving) (pb-dark)) (add (pb-unknown) (pb-no-blocked)))
             (pb-gpu-why))))
)
