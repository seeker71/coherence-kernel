// preflight-exec: forbidden
// Explicit provider evaluation after comparison-review-prepare. Reuse its claim.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 let root = ".hearth/response-parity/source-restored-v1";
 let manifest = parse-json("restored-manifest",read_file(str_concat(root,"/manifest.json")));
 if fs_exists(str_concat(root,"/result.json")) then print_str(json-emit(frsy-run(manifest))) else {
 let prior = parse-json("prior-result",read_file("receipts/artifacts/2026-09-20-form-owned-provider-result.json"));
 let oldRoot = fcap-string(prior,"evidence");
 let oldAvailable = and(fs_exists(str_concat(oldRoot,"/manifest.json")),fs_exists(str_concat(oldRoot,"/process.json")));
 let replayStart = now_unix_ms();
 let replay = if oldAvailable then frsy-run(parse-json("prior-manifest",read_file(str_concat(oldRoot,"/manifest.json")))) else frsy-brief("retained-process-unavailable",oldRoot);
 let replayMs = sub(now_unix_ms(),replayStart);
 if oldAvailable then fcr-need(and(eq(nsm-num(replay,"checked"),1),and(eq(nsm-num(replay,"provider_processes_new"),0),str_eq(fcap-string(replay,"usage_event"),fcap-string(prior,"usage_event")))),"prior review replay did not retain its checked zero-new-process identity") else 0;
 let observation = oh-reading("comparison-review",root,"source-coverage",json-node-string("antecedents-and-historical-grounding-present"),json-node-string("prior-excerpt-omitted-seam-and-candidate-grounding"),json-node-int(0),list(),list("restore-source-context"),oh-reference(fcr-original-review()));
 let control = oh-response(observation,"restore-source-context");
 fcr-need(str_eq(oh-select(observation,control,""),"restore-source-context"),"source-repair control did not correlate");
 oh-emit(str_concat(root,"/events.jsonl"),observation); oh-emit(str_concat(root,"/events.jsonl"),control);
 let start = now_unix_ms(); let result = frsy-run(manifest); let driverMs = sub(now_unix_ms(),start);
 let raw = read_file(fcap-string(result,"answer_path"));
 fcr-need(faj-valid(raw),"retained provider answer is not JSON; inspect owned process evidence");
 let answer = fcap-string(json-object-get(head(node_children(json-object-get(parse-json("provider-report",raw),"results"))),"report"),"answer");
 let usage = json-object-get(result,"provider_usage");
 let prepared = parse-json("prepared",read_file(str_concat(root,"/preparation.json")));
 let report = json-node-object(append(json-object-pairs(result),list(nsm-n("native_driver_ms",driverMs),nsm-n("uncached_input_tokens",sub(nsm-num(usage,"input_tokens"),nsm-num(usage,"cached_input_tokens"))),json-node-pair("previous_actual_prompt_bytes",if fs_exists(str_concat(oldRoot,"/prompt.txt")) then json-node-int(str_len(read_file(str_concat(oldRoot,"/prompt.txt")))) else json-node-null()),json-node-pair("preparation",prepared),json-node-pair("previous_replay_ms",if oldAvailable then json-node-int(replayMs) else json-node-null()),json-node-pair("previous_replay",replay),nsm-n("training",0))));
 frsh-frozen(str_concat(root,"/result.json"),json-emit(report));
 let prefix = "receipts/artifacts/2026-09-20-source-restored-provider";
 frsh-frozen(str_concat(prefix,"-review.json"),raw);
 frsh-frozen(str_concat(prefix,"-answer.md"),answer);
 frsh-frozen(str_concat(prefix,"-result.json"),json-emit(report));
 frsh-frozen(str_concat(prefix,"-source.json"),read_file(str_concat(root,"/source.json")));
 frsh-frozen(str_concat(prefix,"-coordinator-cost.json"),json-emit(ftc-read()));
 oh-emit(str_concat(root,"/events.jsonl"),oh-applied(observation,"restore-source-context",report));
 print_str(json-emit(report));
 };
 1;
}
