; native-science-read.fk — one door for the three native science surfaces.
; preludes: form-stdlib/core.fk form-stdlib/euclid.fk form-stdlib/basic-science.fk
(do
    (let hydrogen (list (list 1 2)))
    (let oxygen (list (list 8 2)))
    (let water (list (list 1 2) (list 8 1)))
    (let force (bsc-force (bsc-mass-kg 2.0) (bsc-accel-mps2 3.0)))
    (print (list "schema" "native-science-read-v1"
        "geometry" (list "3-4-5" (eu-right? 3 4 5) "dist2" (eu-dist2 (eu-point 0 0) (eu-point 3 4)))
        "chemistry" (list "water" (bsc-balanced-elements? (list (list 2 hydrogen) (list 1 oxygen)) (list (list 2 water)) (list 1 8)))
        "physics" (list "F=ma" (bsc-value force) "inv-sq-36/4" (eu-inv-sq 36 2))
        "vortex-cosmology" 0))
    0)
