//////////////////////////////////////////////////////////////////////
//
// prelude-reach.bml
//
// Executable BML. Every dependency a cell names answers at a tracked path.
// A prelude-line token, a bare import statement and a form-stdlib/home-index.txt
// unit each load a file when the runtime meets them; this door reads the same
// tokens through the body's own reader (bml-source-dependencies), resolves each
// through the body's own search order (bml-source-candidates), and asks two
// questions of the answer:
//
//   is the path in the git index?   a clean checkout carries only the index
//   is the path on disk?            a warm tree also carries derived files
//
//   OK              the disk winner is the tracked winner
//   MISSING         no candidate is tracked or on disk
//   PENDING         only a new, not-ignored file answers: it travels once added
//   UNTRACKED-ONLY  only an ignored or derived file answers: a clean checkout
//                   is numb, and adding it would not change that
//   INDEX-ONLY      only a tracked path answers (the file left the disk)
//   SHADOW          disk and index pick different winners for the token
//
// prch-report() runs from the repository root, prints one row per token that
// is not OK, then
//   prelude-reach lines=<l> tokens=<t> homes=<h> missing=<m> untracked=<u> shadow=<s> pending=<p>
// and answers missing + untracked + shadow, where untracked counts the
// UNTRACKED-ONLY and INDEX-ONLY rows. Pending is reported, never hidden, and
// reads 0 once the new file is added. observe/door-link-health.fk carries this
// as its reach row (dlh-reach); observe/door-link-health-run.bml prints it and
// gate/drift-gates.bml carries that door as the door-links row.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/bml-source.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class PreludeReach {
        thought prelude-reach-pattern = list("index-and-disk-both-asked", "one-reader-for-every-token", "absence-is-the-answer");

        def prch-text(v) = if nothing?(v) then "" else v;
        def prch-git(args) = prch-text(host_capture(cons("git", args)));
        def prch-drop-empty(xs) = if nil?(xs) then list() else if (str_len(head(xs)) < 1) then prch-drop-empty(tail(xs)) else cons(head(xs), prch-drop-empty(tail(xs)));
        def prch-lines(text) = prch-drop-empty(split-on(text, "\n"));
        def prch-in?(xs, s) = if nil?(xs) then 0 else if str_eq(head(xs), s) then 1 else prch-in?(tail(xs), s);
        def prch-join(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else str_concat(head(xs), str_concat("/", prch-join(tail(xs))));
        def prch-fold(parts, stack) {
            if nil?(parts) then reverse(stack)
            else if (str_eq(head(parts), "") || str_eq(head(parts), ".")) then prch-fold(tail(parts), stack)
            else if str_eq(head(parts), "..") then (if (nil?(stack) || str_eq(head(stack), "..")) then prch-fold(tail(parts), cons("..", stack)) else prch-fold(tail(parts), tail(stack)))
            else prch-fold(tail(parts), cons(head(parts), stack));
        }
        def prch-norm(path) = prch-join(prch-fold(split-on(path, "/"), list()));

        // the candidate row is "path:line:content" (git grep -n)
        def prch-owner(row) = substring(row, 0, str_find(row, ":", 0));
        def prch-lineno(row) {
            let a = str_find(row, ":", 0);
            let b = str_find(row, ":", (a + 1));
            substring(row, (a + 1), b);
        }
        def prch-content(row) {
            let a = str_find(row, ":", 0);
            let b = str_find(row, ":", (a + 1));
            substring(row, (b + 1), str_len(row));
        }
        def prch-bml?(path) = ((str_len(path) > 4) && str_eq(substring(path, (str_len(path) - 4), str_len(path)), ".bml"));
        def prch-tokens(owner, content) = bml-source-dependencies(content, if prch-bml?(owner) then 0 else 1);

        // world = (tracked paths, new paths git would add: untracked and not ignored)
        def prch-first-tracked(cands, tracked) {
            if nil?(cands) then nothing
            else if prch-in?(tracked, prch-norm(head(cands))) then prch-norm(head(cands))
            else prch-first-tracked(tail(cands), tracked);
        }
        def prch-status(owner, token, world) {
            let tr = prch-first-tracked(bml-source-candidates(owner, token), head(world));
            let dk = bml-source-resolve(owner, token);
            if (nothing?(tr) && nothing?(dk)) then list("MISSING", "")
            else if nothing?(tr) then list((if prch-in?(nth(world, 1), prch-norm(dk)) then "PENDING" else "UNTRACKED-ONLY"), prch-norm(dk))
            else if nothing?(dk) then list("INDEX-ONLY", tr)
            else if str_eq(prch-norm(dk), tr) then list("OK", tr)
            else list("SHADOW", str_concat(tr, str_concat(" | disk ", prch-norm(dk))));
        }
        // one result per token: (status owner line token detail)
        def prch-token-row(owner, lineno, token, world) {
            let s = prch-status(owner, token, world);
            list(head(s), owner, lineno, token, nth(s, 1));
        }
        def prch-token-rows(owner, lineno, tokens, world) = if nil?(tokens) then list() else cons(prch-token-row(owner, lineno, head(tokens), world), prch-token-rows(owner, lineno, tail(tokens), world));
        def prch-cand-rows(rows, world) {
            if nil?(rows) then list()
            else if (str_len(head(rows)) < 5) then prch-cand-rows(tail(rows), world)
            else append(prch-token-rows(prch-owner(head(rows)), prch-lineno(head(rows)), prch-tokens(prch-owner(head(rows)), prch-content(head(rows))), world), prch-cand-rows(tail(rows), world));
        }
        // home-index.txt: "<name> <unit>" per line; the unit resolves like a prelude token
        def prch-home-unit(line) {
            let words = bml-source-words(line);
            if ((len(words) < 2) || str_eq(substring(line, 0, 1), "#")) then nothing else nth(words, 1);
        }
        def prch-home-rows(lines, world) {
            if nil?(lines) then list()
            else if nothing?(prch-home-unit(head(lines))) then prch-home-rows(tail(lines), world)
            else cons(prch-token-row("form/form-stdlib/home-index.txt", "home", prch-home-unit(head(lines)), world), prch-home-rows(tail(lines), world));
        }
        def prch-count(rows, status) = if nil?(rows) then 0 else ((if str_eq(head(head(rows)), status) then 1 else 0) + prch-count(tail(rows), status));
        def prch-show-row(row) {
            print(str_concat(head(row), str_concat(" ", str_concat(nth(row, 1), str_concat(":", str_concat(nth(row, 2), str_concat(" ", str_concat(nth(row, 3), str_concat(" -> ", nth(row, 4))))))))));
            1;
        }
        def prch-show(rows) = if nil?(rows) then 0 else if str_eq(head(head(rows)), "OK") then prch-show(tail(rows)) else (prch-show-row(head(rows)) + prch-show(tail(rows)));
        def prch-kv(name, n) = str_concat(name, int_to_str(n));
        def prch-join-sp(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else str_concat(head(xs), str_concat(" ", prch-join-sp(tail(xs))));
        def prch-summary(l, t, h, m, u, s, p) = prch-join-sp(list(prch-kv("prelude-reach lines=", l), prch-kv("tokens=", t), prch-kv("homes=", h), prch-kv("missing=", m), prch-kv("untracked=", u), prch-kv("shadow=", s), prch-kv("pending=", p)));
        def prch-report() {
            let tracked = prch-lines(prch-git(list("ls-files")));
            let fresh = prch-lines(prch-git(list("ls-files", "--others", "--exclude-standard")));
            let world = list(tracked, fresh);
            let pat = str_concat("preludes:|^[[:space:];]*import[[:space:]", str_concat(byte_to_str(34), ":]"));
            let cands = prch-lines(prch-git(list("grep", "-a", "-n", "-E", pat, "--", "*.fk", "*.bml")));
            let rows = prch-cand-rows(cands, world);
            let homes = prch-home-rows(prch-lines(prch-text(read_file("form/form-stdlib/home-index.txt"))), world);
            let all = append(rows, homes);
            prch-show(all);
            let missing = prch-count(all, "MISSING");
            let untracked = (prch-count(all, "UNTRACKED-ONLY") + prch-count(all, "INDEX-ONLY"));
            let shadow = prch-count(all, "SHADOW");
            print(prch-summary(len(cands), len(rows), len(homes), missing, untracked, shadow, prch-count(all, "PENDING")));
            ((missing + untracked) + shadow);
        }
    }
}
