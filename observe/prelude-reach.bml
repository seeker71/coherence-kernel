//////////////////////////////////////////////////////////////////////
//
// prelude-reach.bml
//
// Executable BML. Every dependency a cell names answers at a tracked path.
// A prelude-line token, a bare import statement and a form-stdlib/home-index.txt
// unit each load a file when the runtime meets them; this door reads the same
// tokens through the body's own reader (bml-source-dependencies), resolves each
// through the body's own search order (bml-source-candidates), and asks two
// questions of the answer:
//
//   is the path tracked?            a clean checkout carries only the tracked set: tracked-files() (form-stdlib/bml/source-tree.bml),
//                                   the walk of the tree under its .gitignore files today, the native index later
//   is the path on disk?            a warm tree also carries derived files
//
//   OK              the disk winner is the tracked winner
//   MISSING         no candidate is tracked or on disk
//   PENDING         only a new, not-ignored file answers: it travels once added
//   UNTRACKED-ONLY  only an ignored or derived file answers: a clean checkout
//                   is numb, and adding it would not change that
//   INDEX-ONLY      only a tracked path answers (the file left the disk)
//   SHADOW          disk and index pick different winners for the token
//
// prch-report() runs from the repository root, prints one row per token that
// is not OK, then
//   prelude-reach lines=<l> tokens=<t> homes=<h> missing=<m> untracked=<u> shadow=<s> pending=<p>
// and answers missing + untracked + shadow, where untracked counts the
// UNTRACKED-ONLY and INDEX-ONLY rows. Pending is reported, never hidden, and
// reads 0 once the new file is added. observe/door-link-health.fk carries this
// as its reach row (dlh-reach); observe/door-link-health-run.bml prints it and
// gate/drift-gates.bml carries that door as the door-links row.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/bml-source.fk form/form-stdlib/bml/source-tree.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class PreludeReach {
        thought prelude-reach-pattern = ["index-and-disk-both-asked", "one-reader-for-every-token", "absence-is-the-answer"];

        def prch-text(v) = v ?? "";
        def prch-git(args) = prch-text(host_capture(cons("git", args)));
        def prch-drop-empty(xs) = nil?(xs) ? [] : len(xs[0]) < 1 ? prch-drop-empty(xs[1:]) : cons(xs[0], prch-drop-empty(xs[1:]));
        def prch-lines(text) = prch-drop-empty(split-on(text, "\n"));
        def prch-in?(xs, s) = nil?(xs) ? 0 : ((String) xs[0] == s) ? 1 : prch-in?(xs[1:], s);
        def prch-join(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ "/" ++ prch-join(xs[1:]);
        def prch-fold(parts, stack) {
            nil?(parts) ? reverse(stack)
            : ((String) parts[0] == "") || ((String) parts[0] == ".") ? prch-fold(parts[1:], stack)
            : ((String) parts[0] == "..") ? (nil?(stack) || ((String) stack[0] == "..") ? prch-fold(parts[1:], cons("..", stack)) : prch-fold(parts[1:], stack[1:]))
            : prch-fold(parts[1:], cons(parts[0], stack));
        }
        def prch-norm(path) = prch-join(prch-fold(split-on(path, "/"), []));

        // every line that names a dependency: a prelude line or an import statement
        def prch-pattern() = "preludes:|^[[:space:];]*import[[:space:]" ++ byte_to_str(34) ++ ":]";

        // the candidate row is "path:line:content" (git grep -n)
        def prch-owner(row) = substring(row, 0, str_find(row, ":", 0));
        def prch-lineno(row) {
            let a = str_find(row, ":", 0);
            let b = str_find(row, ":", a + 1);
            substring(row, a + 1, b);
        }
        def prch-content(row) {
            let a = str_find(row, ":", 0);
            let b = str_find(row, ":", a + 1);
            substring(row, b + 1, len(row));
        }
        def prch-bml?(path) = (len(path) > 4) && ((String) substring(path, len(path) - 4, len(path)) == ".bml");
        def prch-tokens(owner, content) = bml-source-dependencies(content, prch-bml?(owner) ? 0 : 1);

        // The source files and the dependency lines in them come from the body's own tree reader (form-stdlib/bml/source-tree.bml):
        // its walk and the one grep, no git. tracked-files() is the seam: today the walk (every file that is, or travels when added,
        // so a new file reads OK at once and `pending` stays 0); the native `git ls-files` answers it later and `pending` lives again.
        def prch-sources() = stw-pick(tracked-files(), [".fk", ".bml"]);
        def prch-candidates() = stw-grep-rows(["-a", "-n", "-E", prch-pattern()], prch-sources());
        // world = (tracked paths, new paths git would add: untracked and not ignored; none while the seam is the walk)
        def prch-first-tracked(cands, tracked) {
            nil?(cands) ? nothing
            : prch-in?(tracked, prch-norm(cands[0])) ? prch-norm(cands[0])
            : prch-first-tracked(cands[1:], tracked);
        }
        def prch-status(owner, token, world) {
            let tr = prch-first-tracked(bml-source-candidates(owner, token), world[0]);
            let dk = bml-source-resolve(owner, token);
            nothing?(tr) && nothing?(dk) ? ["MISSING", ""]
            : nothing?(tr) ? [(prch-in?(world[1], prch-norm(dk)) ? "PENDING" : "UNTRACKED-ONLY"), prch-norm(dk)]
            : nothing?(dk) ? ["INDEX-ONLY", tr]
            : ((String) prch-norm(dk) == tr) ? ["OK", tr]
            : ["SHADOW", tr ++ " | disk " ++ prch-norm(dk)];
        }
        // one result per token: (status owner line token detail)
        def prch-token-row(owner, lineno, token, world) {
            let s = prch-status(owner, token, world);
            [s[0], owner, lineno, token, s[1]];
        }
        def prch-token-rows(owner, lineno, tokens, world) = tokens |> map(token => prch-token-row(owner, lineno, token, world));
        def prch-cand-rows(rows, world) {
            nil?(rows) ? []
            : len(rows[0]) < 5 ? prch-cand-rows(rows[1:], world)
            : append(prch-token-rows(prch-owner(rows[0]), prch-lineno(rows[0]), prch-tokens(prch-owner(rows[0]), prch-content(rows[0])), world), prch-cand-rows(rows[1:], world));
        }
        // home-index.txt: "<name> <unit>" per line; the unit resolves like a prelude token
        def prch-home-unit(line) {
            let words = bml-source-words(line);
            (len(words) < 2) || ((String) substring(line, 0, 1) == "#") ? nothing : words[1];
        }
        def prch-home-rows(lines, world) {
            nil?(lines) ? []
            : nothing?(prch-home-unit(lines[0])) ? prch-home-rows(lines[1:], world)
            : cons(prch-token-row("form/form-stdlib/home-index.txt", "home", prch-home-unit(lines[0]), world), prch-home-rows(lines[1:], world));
        }
        def prch-count(rows, status) = nil?(rows) ? 0 : ((((String) rows[0][0] == status) ? 1 : 0) + prch-count(rows[1:], status));
        def prch-show-row(row) {
            print(row[0] ++ " " ++ row[1] ++ ":" ++ row[2] ++ " " ++ row[3] ++ " -> " ++ row[4]);
            1;
        }
        def prch-show(rows) = nil?(rows) ? 0 : ((String) rows[0][0] == "OK") ? prch-show(rows[1:]) : (prch-show-row(rows[0]) + prch-show(rows[1:]));
        def prch-kv(name, n) = name ++ n.str();
        def prch-join-sp(xs) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ " " ++ prch-join-sp(xs[1:]);
        def prch-summary(l, t, h, m, u, s, p) = prch-join-sp([prch-kv("prelude-reach lines=", l), prch-kv("tokens=", t), prch-kv("homes=", h), prch-kv("missing=", m), prch-kv("untracked=", u), prch-kv("shadow=", s), prch-kv("pending=", p)]);
        def prch-report() {
            let tracked = tracked-files();
            let world = [tracked, []];
            let cands = prch-candidates();
            let rows = prch-cand-rows(cands, world);
            let homes = prch-home-rows(prch-lines(prch-text(read_file("form/form-stdlib/home-index.txt"))), world);
            let all = append(rows, homes);
            prch-show(all);
            let missing = prch-count(all, "MISSING");
            let untracked = prch-count(all, "UNTRACKED-ONLY") + prch-count(all, "INDEX-ONLY");
            let shadow = prch-count(all, "SHADOW");
            print(prch-summary(len(cands), len(rows), len(homes), missing, untracked, shadow, prch-count(all, "PENDING")));
            (missing + untracked) + shadow;
        }
    }
}
