// Five ordinary constructor refusals, repeated in settled child processes.
// No field reset, capacity filling or shared layout mutation is performed.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
 def nnwr-one(source, index) {
  let path = str_concat(".hearth/native-node-refusal-", str_concat(int_to_str(host_pid()), str_concat("-", str_concat(int_to_str(index), ".fk"))));
  let written = write_file(path, source);
  let before = kernel_stat(4);
  let observed = host-exec(str_concat("./fkwu ", str_concat(path, " 2>&1; printf '\\nNATIVE_WORD_RC=%s\\n' \"$?\"")), "");
  let after = kernel_stat(4);
  let refusal = and(ge(str_find(observed, "coordinate is outside the native 64-bit node identity layout", 0), 0), ge(str_find(observed, "NATIVE_WORD_RC=1", 0), 0));
  // The shared population can move in other kernels; retain this observation
  // without assigning those allocations to the child being examined.
  print(list("constructor-refusal", index, "exit-and-reason", refusal, "nodes-before", before, "nodes-after", after));
  refusal;
 }
 let rows = list("(make_nodeid 64 0 0 0)\n", "(make_nodeid 0 8192 0 0)\n", "(make_nodeid 0 0 4096 0)\n", "(make_nodeid 0 0 0 4294967296)\n", "(make_nodeid 65535 65535 65535 4294967295)\n");
 def nnwr-all(rows, index) = if eq(len(rows), 0) then 1 else if nnwr-one(head(rows), index) then nnwr-all(tail(rows), add(index, 1)) else 0;
 if nnwr-all(append(rows, rows), 0) then 1 else form_error("native node word refusal contract failed");
}
