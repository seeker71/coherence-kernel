; ear-wake-run.fk — wake the ear that stands in the glass, or let it sleep.
; stdin line 1: the tongues to offer, whisper codes separated by spaces (blank -> en pt fa id),
; or the single word "sleep" to close the mic. The glass's ear sensor reads this marker every
; half second: awake it stands the mic and the tongues up, asleep it lets them go.
; preflight-exec: forbidden
; preludes: form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk
(do
    (defn ewr-trim (s) (if (nothing? s) "" (trim s)))
    (let want (ewr-trim (read_line)))
    (let mk (fs-mkdir ".hearth"))
    (if (str_eq want "sleep")
        ; the marker going is what the sensor watches, and the stop file is what the lanes
        ; themselves watch — both, so `sleep` closes the mic even when no sensor stands to kill them
        (do (let gone (fs-remove-file ".hearth/ear.wanted"))
            (let stop (write_file_text ".hearth/ear.spool.stop" "sleep"))
            (print_str "the ear sleeps; the mic is closed and any lane still standing ends at its own door"))
        (do (let w (write_file_text ".hearth/ear.wanted" (if (eq (str_len want) 0) "en pt fa id" want)))
            (print_str (str_concat "the ear is wanted in " (if (eq (str_len want) 0) "en pt fa id" want)))))
    0)
