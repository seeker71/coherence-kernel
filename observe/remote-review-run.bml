// remote-review-run.bml — record one remote review of local work, in its own column.
//
// A remote review of a step is free: it reads any rung's request, lane output, finding and ledger row, and
// it is not the work. Its row lands in receipts/remote-review.jsonl, apart from the remote guide and the
// remote work, and observe/local-flow-review.bml shows it per gap and per session. Unknown tokens stay null.
// stdin, one JSON line: {"gap":"<id>","option":3,"session":"<id>","reviewer":"<who>","verdict":"accept","tokens":1200}
// verdict is accept, reject or note. The row is printed after it lands.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class RemoteReviewRun {
  def rrr-verdicts() = ["accept", "reject", "note"];
  def rrr-run() {
   let line = trim(stdin-text());
   let doc = if fcgp-object-line?(line) then parse-json("remote-review", line) else json-node-object([]);
   let gap = fcgp-str(doc, "gap");
   let reviewer = fcgp-str(doc, "reviewer");
   let verdict = fcgp-str(doc, "verdict");
   if ((String) gap == "") then print_str("signal=nothing reason=gap-required") else if ((String) reviewer == "") then print_str("signal=nothing reason=reviewer-required") else if (!fcgp-member?(rrr-verdicts(), verdict)) then print_str("signal=nothing reason=verdict-is-accept-reject-or-note") else rrr-record(fcgp-review-row(gap, fcgp-num(doc, "option"), fcgp-str(doc, "session"), reviewer, verdict, fcgp-num(doc, "tokens")));
  }
  def rrr-record(row) {
   let wrote = fcgp-record(fcgp-review-ledger(), row);
   print_str(if ((String) wrote == "appended") then json-emit(row) else mc-cat(["signal=nothing reason=ledger-append-", wrote]));
  }
 }
 rrr-run();
}
