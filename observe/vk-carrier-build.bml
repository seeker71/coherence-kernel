// Build the Vulkan carrier (.hearth/vk/run_vk) from what this host holds, or name the piece
// it cannot find. The finding and the build live in form-stdlib/vk-carrier.bml.
// Run from the repository root: ./fkwu observe/vk-carrier-build.bml
// preludes: form-stdlib/vk-carrier.bml
section [form.bml] {
 class VulkanCarrierDoor {
  def vcd-run() = vcb-run();
 }
 vcd-run();
}
