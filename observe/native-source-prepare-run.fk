; stdin: absolute source path, temporary proof-input path.
; stdout: selected path (or failure reason), then final 1/0.
; The process status must be successful as well as the final value.
; preludes: form-stdlib/bml/native-source-prepare.bml
(do
 (let source (read_line))
 (let target (read_line))
 (let result (nsp-prepare source target))
 (print (head result))
 (nth result 1))
