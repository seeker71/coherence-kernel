; voice-room-witness.fk — the body renders its own sentence and hears it in its own room.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-pass.bml
;
; A band proves arithmetic. It cannot prove that air moved, because a band that made a sound
; would stain the room it measures (bandstain, corpus row 1193). So `voice-pass-band.fk` holds
; the numbers, silent, and the air lives here.
;
; EVERY STEP BUT ONE IS THIS SEED'S. The phonemes below came from the crossing — espeak-ng
; through piper, the half of the mouth that has not come home — and are written down rather than
; asked for, so this cell calls no host tool at all. From there: the ids are built by
; `voice-phoneme.bml` from the voice's own table, the model is read by `voice-onnx.bml`, the
; whole VITS is run by `voice-pass.bml` on this Mac's metal, the samples become signed 16-bit on
; the same device, and they leave through `sense_speaker_play_at`'s stream twin at the voice's
; OWN rate. No piper, no onnxruntime, no afplay, no wav file, no host process.
;
; The room is measured BEFORE the line and again while it sounds, because a level says nothing
; on a busy hour — a loud room and a working mouth read the same in one window. The number that
; means something is the DIFFERENCE. If the ear is held by a sibling the capture answers nothing
; and this cell says so rather than inventing a room.
;
;   ./fkwu observe/voice-room-witness.fk

(do
    (defn vw-default () "en_GB-jenny_dioco-medium")
    (defn vw-voice ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vw-default) (if (eq (str_len (trim t)) 0) (vw-default) (trim t)))))
    ; piper's phonemes for "the body is learning to speak." — the one crossing still standing
    (defn vw-phonemes () (list "ð" "ə" " " "b" "ˈ" "ɒ" "d" "ɪ" "ʲ" " " "ɪ" "z" " " "l" "ˈ" "ɜ" "ː" "n" "ɪ" "ŋ" " " "t" "ə" " " "s" "p" "ˈ" "i" "ː" "k" "."))

    (defn vw-signed (v) (if (ge v 32768) (sub v 65536) v))
    (defn vw-s16 (s i) (vw-signed (add (str_byte_at s i) (mul 256 (str_byte_at s (add i 1))))))
    (defn vw-walk (s i end peak sum n)
        (if (ge i end) (list peak (if (le n 0) 0 (div sum n)) n)
            (vw-walk-at s i end peak sum n (abs (vw-s16 s i)))))
    (defn vw-walk-at (s i end peak sum n a) (vw-walk s (add i 8) end (if (gt a peak) a peak) (add sum a) (add n 1)))
    (defn vw-read (s) (vw-walk s 0 (sub (str_len s) 1) 0 0 0))
    (defn vw-drain (acc n) (if (le n 0) acc (vw-drain (str_concat acc (sense_mic_stream_read 6400 250)) (sub n 1))))
    (defn vw-frame (label r)
        (print_str (str_concat label (str_concat "  peak=" (str_concat (int_to_str (head r))
            (str_concat "  mean-abs=" (str_concat (int_to_str (nth r 1))
                (str_concat "  samples=" (int_to_str (nth r 2))))))))))

    (let voice (vw-voice))
    (let cfg (vp-cfg voice))
    (let rate (vp-sample-rate cfg))
    (let ids (vp-ids cfg (vw-phonemes)))
    (let st (vv-open (vp-model-path voice)))
    (let ok (vv-open-ok? st))
    (let a0 (print_str (str_concat "voice " (str_concat voice (str_concat "  rate " (int_to_str rate))))))
    (let a1 (print_str (str_concat "ids   " (int_to_str (len ids)))))
    (let a2 (print_str (str_concat "door  " (if (eq ok 1) "open" (vv-open-why st)))))
    (if (eq ok 0) 0
        (do
            (let t0 (now_unix_ms))
            (let o (vv-render st ids 1.0))
            (let pcm (vv-pcm st o))
            (let t1 (now_unix_ms))
            (let a3 (print_str (str_concat "render " (str_concat (int_to_str (sub t1 t0))
                (str_concat " ms -> " (str_concat (int_to_str (vv-tn o))
                    (str_concat " samples, " (str_concat (int_to_str (str_len pcm)) " bytes"))))))))
            (let mstart (sense_mic_stream_start))
            (let before (vw-drain "" 3))
            (let sstart (sense_speaker_stream_start_at rate))
            (let wrote (sense_speaker_stream_write pcm))
            (let during (vw-drain "" 6))
            (let sstop (sense_speaker_stream_stop))
            (let mstop (sense_mic_stream_stop))
            (let a4 (print_str (str_concat "mouth accepted " (int_to_str wrote))))
            (let rb (vw-read before))
            (let rd (vw-read during))
            (if (eq (str_len during) 0)
                (print_str "the ear gave nothing back — held elsewhere, or refused; no room is claimed here")
                (do (let p (vw-frame "silent window " rb))
                    (let q (vw-frame "sounding window" rd))
                    (print_str (str_concat "peak rise=" (int_to_str (sub (head rd) (head rb)))))))
            (sub (head rd) (head rb)))))
