// dflash-msl-check.bml — the drafter's kernels compile? Each kernel alone (helpers + itself): its pipeline handle, 0 = the compiler said no.
//   echo '{}' | ./fkwu observe/dflash-msl-check.bml
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/form-cli-model-session.fk native/metal/qwen35-dense-dflash.fk
section [form.bml] {
 class DflashMslCheck {
  def dmc-head() = "#include <metal_stdlib>\n#pragma clang fp contract(off)\n";
  def dmc-one(name, body) = print_str("[dflash-msl] " ++ name ++ " " ++ metal_pipeline(dmc-head() ++ body, name).str());
  def dmc-run() {
   dmc-one("form_t_c1", "kernel void form_t_c1 (device uint* o [[buffer(0)]], uint tidx [[thread_index_in_threadgroup]], uint3 tgpig [[threadgroup_position_in_grid]]) { threadgroup uint sc[16]; sc[tidx % 16] = 1u; o[tgpig.x] = sc[tidx % 16]; }");
   dmc-one("form_t_c2", "kernel void form_t_c2 (device uint* o [[buffer(0)]], ushort lane [[thread_index_in_simdgroup]], ushort sg [[simdgroup_index_in_threadgroup]], uint3 tgpig [[threadgroup_position_in_grid]]) { o[tgpig.x] = lane + sg; }");
   dmc-one("form_t_c3", "kernel void form_t_c3 (device uint* o [[buffer(0)]], ushort tidx [[thread_position_in_threadgroup]], uint3 tgpig [[threadgroup_position_in_grid]]) { o[tgpig.x] = tidx; }");
   print_str("[dflash-msl] status " ++ metal_status());
  }
 }
 dmc-run();
}
