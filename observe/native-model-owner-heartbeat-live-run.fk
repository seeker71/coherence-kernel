; native-model-owner-heartbeat-live-run.fk — physical owner correlation door.
;
; This probe does not open, close, signal, or restart a model.  It asks the
; existing host-exec carrier for this Form process's PPID, constructs the same
; owner heartbeat a resident model process publishes, atomically publishes it
; under an isolated probe root, and reads the exact wire back.
;
; preludes: form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml

(do
    (let started (now_unix_ms))
    (let pidText (host-exec "printf '%s' \"$PPID\"" ""))
    (let pid (if (eq (fgtm-uint-text? pidText) 1) (str_to_int pidText) 0))
    (let ownerCommand (if (gt pid 0)
        (host-exec (str_concat "/bin/ps -p "
            (str_concat (int_to_str pid) " -o comm=")) "") ""))
    (let ownerAlive (if (ge (str_find ownerCommand "fkwu" 0) 0) 1 0))
    (let observed (now_unix_ms))
    (let publisher (nmdt-owner-publisher started))
    (let correlation (nmdt-owner-correlation publisher pid started
        (nmdt-owner-incarnation started) 1 observed))
    (let sample (nmdt-owner-heartbeat-sample correlation))
    (let published (if (eq (nmdt-owner-correlation? correlation) 1)
        (fgtm-publish-snapshot "/tmp/form-native-owner-heartbeat-probe"
            publisher observed (list sample))
        (list "glass-publish-v1" "refused" "owner-correlation")))
    (let readback (fgtm-read-current
        "/tmp/form-native-owner-heartbeat-probe" publisher))
    (print (list "native-model-owner-heartbeat-live"
        "pid" pid
        "owner-command-fkwu" ownerAlive
        "started" started
        "incarnation" (nmdt-owner-incarnation started)
        "sequence" 1
        "observed" observed
        "correlated" (nmdt-owner-correlation? correlation)
        "publish" (nth published 1)
        "readback" (fgtm-read-state-status readback)
        "resident-owner-preserved" 1))
    (if (and (eq ownerAlive 1)
        (and (eq (nmdt-owner-correlation? correlation) 1)
            (and (str_eq (nth published 1) "published")
                (str_eq (fgtm-read-state-status readback) "current"))))
        1 0))
