; form-resource-governor-run.fk — readable pure-policy observation.
;
; This door does not claim a carrier act.  It shows the exact transitions a
; carrier integration receives from the governor API.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-glass-observation-v2.bml form-stdlib/form-resource-governor.bml

(do
    (defn frgr-provenance ()
        (fgov2-provenance "physical-live" "observer.fixture"
            (fgov2-measured (fgov2-process-lifetime 4243 1700000000 "observer-4243"))
            (fgov2-measured 1) (fgov2-measured 1700000250) "observer.fixture"))
    (defn frgr-m (value) (frg-measured value 0 (frgr-provenance)))
    (defn frgr-resource (name capacity foreground reserve)
        (frg-resource name (frgr-m capacity) (frgr-m foreground) (frgr-m reserve)))
    (defn frgr-sample (active foreground latency pressure thermal low-power metal-inflight)
        (frg-sample (frgr-m active)
            (frgr-resource "cpu" 1000 100 100)
            (frgr-resource "gpu" 2000 200 200)
            (frgr-resource "memory" 10000 1000 1000)
            (frgr-m foreground) (frgr-m latency) (frgr-m pressure)
            (frgr-m thermal) (frgr-m low-power) (frgr-m metal-inflight)))
    (defn frgr-kv (key value)
        (str_concat key (str_concat "=" (str_concat value " "))))
    (defn frgr-cat (values)
        (if (eq (len values) 0) ""
            (str_concat (head values) (frgr-cat (tail values)))))
    (defn frgr-decision-line (name decision)
        (frgr-cat (list name " "
            (frgr-kv "reason" (frg-decision-reason decision))
            (frgr-kv "frame-ms" (int_to_str (frg-decision-frame decision)))
            (frgr-kv "cpu-target" (int_to_str (frg-decision-cpu-target decision)))
            (frgr-kv "cpu-grant" (int_to_str (frg-decision-cpu decision)))
            (frgr-kv "gpu-grant" (int_to_str (frg-decision-gpu decision)))
            (frgr-kv "memory-grant" (int_to_str (frg-decision-memory decision)))
            (frgr-kv "metal-submit" (int_to_str (frg-decision-metal-submit? decision))) "\n")))
    (let policy (frg-default-policy))
    (let target-state (frg-state 720 1440 7200 8 20))
    (let active (frg-tick policy target-state (frgr-sample 1 0 0 0 0 0 0)))
    (let warning (frg-tick policy target-state (frgr-sample 1 1 0 0 0 0 0)))
    (let critical (frg-tick policy target-state (frgr-sample 1 0 0 2 0 0 0)))
    (let recovery-one (frg-tick policy (frg-initial-state) (frgr-sample 0 0 0 0 0 0 0)))
    (let recovery-two (frg-tick policy (frg-decision-next-state recovery-one) (frgr-sample 0 0 0 0 0 0 0)))
    (let no-pressure (frg-pressure-release-plan policy (frgr-m 0) (frgr-m 100)
        (list (frg-release-unit "model.fixture" "inactive-whole-model" (frgr-m 100) (frgr-m 0) (frgr-m 0) (frgr-m 0) (frgr-m 42) "fixture"))))
    (print_str "form-resource-governor evidence=pure-policy; carrier-application=not-claimed\n")
    (print_str (frgr-decision-line "active" active))
    (print_str (frgr-decision-line "warning" warning))
    (print_str (frgr-decision-line "critical" critical))
    (print_str (frgr-decision-line "recovery-1" recovery-one))
    (print_str (frgr-decision-line "recovery-2" recovery-two))
    (print_str (str_concat "release "
        (str_concat (frgr-kv "status" (frg-release-plan-status no-pressure))
            (str_concat (frgr-kv "selected" (int_to_str (len (frg-release-plan-selected no-pressure)))) "\n"))))
    0)
