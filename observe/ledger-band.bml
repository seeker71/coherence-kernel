// ledger-band.bml — form-stdlib/bml/ledger.bml: a ledger row is a declared blueprint, one flat JSON line, a typed cell.
// Last line: rows that agree.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint CompanionRow { at_unix_ms: int, lang: string, said: string, answer: string, voice: string }
 blueprint Step { name: string, ok: bool }
 blueprint Turn { id: string, steps: list<Step>, note: option<string>, scores: map<string,float>, at: tuple<int,int> }
 class LedgerBand {
  def lb-row(label, ok) {
   let said = print_str((ok ? "ok   " : "FAIL ") ++ label);
   ok ? 1 : 0;
  }
  def lb-path() = ".hearth/ledger-band.jsonl";
  def lb-flat() = "{\"at_unix_ms\":123,\"lang\":\"en\",\"said\":\"hi\",\"answer\":\"hello\",\"voice\":\"answered\"}";
  def lb-run() {
   let made = fs_mkdir(".hearth");
   let cleared = write_file_text(lb-path(), "");
   let row = CompanionRow{at_unix_ms: 123, lang: "en", said: "hi", answer: "hello", voice: "answered"};
   let a1 = lb-row("a row is a cell", !nothing?(row));
   let a2 = lb-row("a row is one flat JSON line, the fields as declared", (String) row-json(row) == lb-flat());
   let a3 = lb-row("a line the body wrote before reads as the same cell", eq(row, row-cell("CompanionRow", lb-flat())));
   let a4 = lb-row("a field reads as the program's own value", ((String) row-get(row, "said") == "hi") && (row-get(row, "at_unix_ms") == 123));
   let a5 = lb-row("an unknown field reads as nothing", nothing?(row-get(row, "nope")));
   let p1 = ledger-append(lb-path(), row);
   let p2 = ledger-append(lb-path(), CompanionRow{at_unix_ms: 124, lang: "id", said: "halo", answer: "hai", voice: "answered"});
   let p3 = ledger-append(lb-path(), row);
   let rows = ledger-rows(lb-path(), "CompanionRow");
   let b1 = lb-row("a row appends", ((String) p1 == "appended") && ((String) p2 == "appended"));
   let b2 = lb-row("every appended row reads back", len(rows) == 3);
   let b3 = lb-row("a repeated row is the same NodeID", eq(rows[0], rows[2]) && !eq(rows[0], rows[1]));
   let b4 = lb-row("the file is plain lines of JSON", len(split-on(read_file(lb-path()), "\n")) == 4);
   let c1 = lb-row("a value of the wrong type reads as nothing", nothing?(row-cell("CompanionRow", "{\"at_unix_ms\":\"x\",\"lang\":\"en\",\"said\":\"a\",\"answer\":\"b\",\"voice\":\"c\"}")));
   let c2 = lb-row("an undeclared field reads as nothing", nothing?(row-cell("CompanionRow", "{\"at_unix_ms\":1,\"lang\":\"en\",\"said\":\"a\",\"answer\":\"b\",\"voice\":\"c\",\"extra\":1}")));
   let c3 = lb-row("a missing field reads as nothing", nothing?(row-cell("CompanionRow", "{\"at_unix_ms\":1,\"lang\":\"en\"}")));
   let c4 = lb-row("a line that is not JSON reads as nothing", nothing?(row-cell("CompanionRow", "{\"at_unix_ms\":1,")));
   let c5 = lb-row("an unknown blueprint reads as nothing", nothing?(row-cell("Ghost", lb-flat())));
   let turn = Turn{id: "t1", steps: [Step{name: "a", ok: true}, Step{name: "b", ok: false}], note: "kept", scores: map{"w": 1.5, "h": 2.0}, at: tuple[3, 4]};
   let text = row-json(turn);
   let d1 = lb-row("nested records, lists, options, maps and tuples write as JSON", !nothing?(text) && ((String) text == "{\"id\":\"t1\",\"steps\":[{\"name\":\"a\",\"ok\":true},{\"name\":\"b\",\"ok\":false}],\"note\":\"kept\",\"scores\":{\"h\":2.0,\"w\":1.5},\"at\":[3,4]}"));
   let d2 = lb-row("and read back to the same NodeID", !nothing?(text) && eq(turn, row-cell("Turn", text)));
   let bare = Turn{id: "t2", steps: [], scores: map{}, at: tuple[0, 0]};
   let d3 = lb-row("an absent option is null, and reads back as absent", !nothing?(bare) && eq(bare, row-cell("Turn", row-json(bare))) && nothing?(row-get(bare, "note")));
   let e1 = ledger-append(lb-path(), turn);
   let again = ledger-rows(lb-path(), "Turn");
   let e2 = lb-row("a ledger of another blueprint skips the rows that are not its own", len(again) == 1 && eq(again[0], turn));
   print_str("[ledger-band] " ++ value_str(a1 + a2 + a3 + a4 + a5 + b1 + b2 + b3 + b4 + c1 + c2 + c3 + c4 + c5 + d1 + d2 + d3 + e2) ++ " of 18");
  }
 }
 lb-run();
}
