; direct-source-jit-discovery-probe.fk -- named timing and correlation for one
; recursive direct-source function moving from discovery to the existing gate.
; No file, process, HTTP, model, Metal, SHA, flatten or fixed-table crossing.
; preludes: form/form-stdlib/direct-source-jit-discovery.fk

(do
    (defn dsjdp-offer-many (gate row argument remaining last)
        (if (eq remaining 0) (list gate last)
            (do
                (let receipt (dsjd-offer gate row argument))
                (dsjdp-offer-many (dsjd-offer-after receipt) row argument
                                  (sub remaining 1) receipt))))

    (let epoch 270827)
    (let gate0 (hg-gate epoch))
    (let discovery0 (dsjd-discovery epoch))
    (let t0 (now_unix_ms))
    (let recursive (dsjd-observe-sum-down discovery0 128 129))
    (let t1 (now_unix_ms))
    (let discovery (dsjd-result-discovery recursive))
    (let spec (dsjd-sum-spec epoch))
    (let function-id (dsjd-spec-function-id spec))
    (let candidate-id (dsjd-spec-candidate-id spec))
    (let row (dsjd-cut (dsjd-hot-choice discovery) function-id))
    (let cold4 (dsjdp-offer-many gate0 row 128 4 (nothing)))
    (let t2 (now_unix_ms))
    (let fifth (dsjd-offer (nth cold4 0) row 128))
    (let t3 (now_unix_ms))
    (let hot1000 (dsjdp-offer-many
        (dsjd-offer-after fifth) row 128 1000 fifth))
    (let t4 (now_unix_ms))
    (list
        (list "recursive-input" 128)
        (list "recursive-value" (dsjd-result-value recursive))
        (list "recursive-call-sites-observed" (dsjd-hits discovery function-id))
        (list "direct-source-discovery-ms" (sub t1 t0))
        (list "gate-fires-before-offer" (hg-fires gate0 candidate-id))
        (list "choice-width" (len (dsjd-hot-choice discovery)))
        (list "function-id" function-id)
        (list "candidate-id" candidate-id)
        (list "identities-distinct" (not (node_eq function-id candidate-id)))
        (list "first-four-form-ms" (sub t2 t1))
        (list "fifth-route" (nth fifth 1))
        (list "fifth-born" (dsjd-offer-born fifth))
        (list "fifth-birth-ms" (sub t3 t2))
        (list "hot-1000-ms" (sub t4 t3))
        (list "hot-last-route" (nth (nth hot1000 1) 1))
        (list "cold-challenger-agreement" (dsjd-offer-agrees? (nth hot1000 1)))
        (list "undo-fires" (hg-fires (dsjd-undo fifth) candidate-id))))
