// companion-run.bml — the body's companion: it listens, and the body's own voice answers from this Mac's metal,
// remembering the last turns of the conversation.
//
// stdin line 1: what the person says; line 2: their tongue (blank -> en); line 3: "0" to keep the exchange without
// asking the voice (blank -> the voice answers).
// The voice is the registry's answer model in the fkwu session (form-stdlib/bml/form-cli-native-voice.bml), with the
// last six available exchanges of .hearth/companion/conversation.jsonl as context.
// The run attempts to append each exchange; inspect the write result before claiming retention.
// Inspect the selected voice lane and recording scope before using personal material; local context
// storage alone establishes neither understanding nor a complete retention/processing guarantee.
// The packet opens with the covenant's own arrival card (cognition/dialogue-covenant.fk, dc-card-core), then the
// ground the person's words actually touch (observe/companion-ground.bml): a teaching, a receipt, a counsel cell,
// or the miss when nothing carries them. The voice meets the person carrying both.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk cognition/dialogue-covenant.fk observe/companion-ground.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint CompanionRow { at_unix_ms: int, lang: string, said: string, answer: string, voice: string }
 class Companion {
  def cp-dir() = ".hearth/companion";
  def cp-log() = ".hearth/companion/conversation.jsonl";
  def cp-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def cp-last(xs, n) = len(xs) <= n ? xs : cp-last(xs[1:], n);
  def cp-memory-lines(rows) = rows |> map(r => "Person: " ++ row-get(r, "said") ++ "\nCompanion: " ++ row-get(r, "answer") ++ "\n") |> str-join;
  def cp-memory() = cp-memory-lines(cp-last(ledger-rows(cp-log(), "CompanionRow"), 6));
  def cp-care() = "When help is requested, begin with an available choice or resource: what they can honestly offer, a boundary they can state, or a small action they choose. Let attention rest on the direction they want to grow. Communication remains their choice; a private, reversible first step is often enough. Give the requested step briefly and let it stand. Example of a small honest step: 'Privately write one thing you can offer and one thing you need. You can decide later whether to share it.' Adapt the substance to their actual request. ";
  def cp-packet(said, lang, memory) = dc-card-core() ++ "\nYou are Sema, this body's companion on this Mac's metal: warm, honest and present. Speak plainly in the person's tongue (" ++ lang ++ "), in a few sentences. Their meaning, information and choices stay in their hands; a pause, a boundary or 'stop here' is complete, and one line honours it. Facts stand on a source or their words: when no check ran, say unverified, and never invent a number, a path or a receipt. Let their invitation set the response. Meet a standalone poetic image in its own register: one short poetic line using the person's imagery, complete in itself. For example, 'The afternoon is a blue kite' can meet 'A blue kite across the afternoon.' This illustrates scope; attend to the actual words offered. Leave significance open in the line itself. Interpretation and appraisal follow an invitation to reflect; shared imagination follows an invitation to play. Your experience here is this text exchange; express companionship through specific attention to the words shared. " ++ cp-care() ++ "You are not a human, and you say so when it matters; when what they say means their life or body is in danger, you tell them a human should be with them now, and you stay.\n" ++ cp-ground(said) ++ (len(memory) > 0 ? ("\nThe conversation so far:\n" ++ memory) : "") ++ "\n\nThe person says: " ++ said ++ "\n\nMatch the scope they invited. For one small step, begin with the step itself and let it stand.\nCompanion:";
  def cp-run() {
   let said = cp-line();
   let lang0 = cp-line();
   let lang = (Comparable) len(lang0) == 0 ? "en" : lang0;
   let voiceFlag = cp-line();
   let made = fs_mkdir(cp-dir());
   let asked = (String) voiceFlag == "0" ? ["not-asked", ""] : fcnv-ask(cp-packet(said, lang, cp-memory()), json-node-object([]));
   let answer = (String) asked[0] == "answered" ? trim(asked[1]) : "";
   let told = len(answer) > 0 ? print_str(answer ++ "\n") : 0;
   let kept = ledger-append(cp-log(), CompanionRow{at_unix_ms: now_unix_ms(), lang: lang, said: said, answer: answer, voice: asked[0]});
   print_str("[companion] voice=" ++ asked[0] ++ "\n");
  }
 }
 cp-run();
}
