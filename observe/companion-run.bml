// companion-run.bml — successive words, language (blank -> en), voice flag
// (0 skips generation). Each answer stands; the next turn begins with the next
// offered words. EOF releases the native owner through its existing lifecycle.
// All exchanges stay in this process's context, without a guessed turn limit,
// automatic conversation archive, or training. Resource admission owns capacity.
// A standing resident serves through its existing disk transport; otherwise a
// typed turn uses the owned native residence. Guidance checkpoints retain their
// existing ownership; conversation context travels explicitly with each ask.
// `from-ear` reads the last closed utterance through the same available routes.
// Its completed answer is offered to the existing mouth folder for the vocoder.
// `from-ear-check` observes a synthetic fixture without generation.
// The packet carries the covenant and relevant source; its answer is read as an
// answer, without a lexical verdict pretending to establish how it lands.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk control/offer-ack-core.fk control/choice-lane-core.fk observe/companion-packet.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml form-stdlib/bml/serve-client.bml
section [form.bml] {
 blueprint CompanionRow { at_unix_ms: int, lang: string, said: string, answer: string, voice: string, reason: string, model: string }
 class Companion {
  def cp-dir() = ".hearth/companion";
  def cp-mouth() = ".hearth/companion/mouth";
  def cp-ear-segs() = ".hearth/ear.spool.segments";
  def cp-tab() = byte_to_str(9);
  def cp-ear-parts(line) = split-on(line, cp-tab());
  def cp-ear-closed?(line) {
   let p = cp-ear-parts(trim(line));
   (Comparable) len(p) >= 3 && (String) p[0] != "live" && (String) p[0] != "done";
  }
  def cp-ear-rest(p, i) = i >= len(p) ? "" : i == len(p) - 1 ? p[i] : p[i] ++ cp-tab() ++ cp-ear-rest(p, i + 1);
  def cp-ear-pair(line) {
   let p = cp-ear-parts(trim(line));
   [p[1], cp-ear-rest(p, 2)];
  }
  def cp-ear-last(lines, acc) = nil?(lines) ? acc : cp-ear-closed?(lines[0]) ? cp-ear-last(lines[1:], lines[0]) : cp-ear-last(lines[1:], acc);
  def cp-ear-of(text) {
   let line = cp-ear-last(split-on(text, "\n"), "");
   (Comparable) len(line) == 0 ? ["", ""] : cp-ear-pair(line);
  }
  def cp-ear-heard() = cp-ear-of(read_file(cp-ear-segs()) ?? "");
  def cp-ear-check() {
   let heard = cp-ear-of("live" ++ cp-tab() ++ "1" ++ cp-tab() ++ "2" ++ cp-tab() ++ "en" ++ cp-tab() ++ "hello there\n9" ++ cp-tab() ++ "en" ++ cp-tab() ++ "I am scared of the change\ndone\n");
   print([heard[0], heard[1], cp-present?(heard[1]) ? 1 : 0]);
  }
  def cp-present?(said) = (Comparable) len(trim(said)) > 0;
  def cp-private-dir() {
   fs_mkdir(cp-dir());
   host_chmod(cp-dir(),448);
  }
  def cp-offer(answer) {
   (Comparable) len(answer) == 0 ? 0 : {
    let made = cp-private-dir();
    let mouth = fs_mkdir(cp-mouth());
    let protected = host_chmod(cp-mouth(),448);
    let path = cp-mouth() ++ "/" ++ now_unix_ms().str() ++ ".txt";
    made != 0 || protected != 0 ? "refused:permissions" : {
     let wrote = write_file_text(path, answer);
     (read_file(path) ?? "") == answer && host_chmod(path,384) == 0 ? "written" : "refused:write";
    };
   };
  }
  def cp-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def cp-memory-lines(rows) = rows |> map(r => "Person: " ++ row-get(r, "said") ++ "\nCompanion outcome: " ++ row-get(r,"voice") ++ "; reason=" ++ row-get(r,"reason") ++ "; model=" ++ row-get(r,"model") ++ "\nCompanion: " ++ row-get(r, "answer") ++ "\n") |> str-join;
  def cp-memory(owner) = cp-memory-lines(record_get(owner,"conversation"));
  def cp-turn(owner,said) {
   let lang0 = cp-line();
   let lang = (Comparable) len(lang0) == 0 ? "en" : lang0;
   let voiceFlag = cp-line();
   !cp-present?(said) ? print_str("[companion] present=0") : cp-kept(owner,said,lang,false,voiceFlag == "0" ? ["not-asked", ""] : cp-ask(owner,said,lang,false));
  }
  def cp-ask(owner,said,lang,spoken) {
   record_set(owner,"route-result",nothing());
   let walk = oac-backtrack-walk([cp-server-option,cp-native-option],[owner,said,lang,spoken],[]);
   record_get(owner,"route-result") ?? fcnv-none("unavailable","",cp-findings(oac-backtrack-memory(walk)));
  }
  def cp-findings(memory) = str-join-with(map(finding => node_value(finding),memory),"; ");
  def cp-route-context(offered,served) {
   let args = oac-option-args(offered);
   let findings = cp-findings(oac-option-memory(offered));
   cp-context(args[1],args[2]) ++ cp-runtime-scope(served,args[3]) ++ (len(findings) > 0 ? "\nExecution observations from earlier choices: " ++ findings ++ "\n" : "");
  }
  def cp-route-answer(owner,answer) {
   record_set(owner,"route-result",answer);
   oac-one(intern_trivial_string(answer[0]));
  }
  def cp-server-option(offered) {
   let args = oac-option-args(offered);
   let standing = svc-standing(svc-default-dir());
   standing[0] != "standing" ? oac-node(intern_trivial_string(svc-reason(standing))) : !fcnv-residence-close(args[0]) ? cp-route-answer(args[0],fcnv-none("release-incomplete","","companion-route-release-incomplete")) : {
    let context = cp-route-context(offered,true);
    let answer = svc-voice-prio(cp-packet-from(context,args[1],cp-memory(args[0])),0,"companion",8);
    nothing?(answer) ? {
     let after = svc-standing(svc-default-dir());
     oac-node(intern_trivial_string("Resident transport returned no answer; " ++ (after[0] == "standing" ? "resident still stands" : svc-reason(after))));
    } : cp-route-answer(args[0],answer);
   };
  }
  def cp-native-option(offered) {
   let args = oac-option-args(offered);
   let context = cp-route-context(offered,false);
   let answer = fcnv-resident-ask-with-floor(args[0],cp-packet-from(context,args[1],cp-memory(args[0])),context,cp-prefix(args[2]),json-node-object([json-node-pair("interactive",json-node-bool(true))]));
   cp-route-answer(args[0],answer);
  }
  def cp-listen(owner) {
   let line=read_line();
   nothing?(line) ? 0 : { cp-turn(owner,trim(line)); cp-listen(owner); };
  }
  def cp-kept(owner,said,lang,spoken,asked) {
   let answer = (String) asked[0] == "answered" ? trim(asked[1]) : "";
   let partial = asked[0] != "answered" && len(asked) > 8 ? trim(asked[8]) : "";
   let reason = len(asked) > 7 && len(asked[7]) > 0 ? asked[7] : asked[0];
   let model = len(asked) > 4 ? asked[4] : "";
   let offered = spoken ? cp-offer(answer) : "text";
   let told = len(answer) > 0 ? print_str(answer ++ "\n") : 0;
   if len(partial) > 0 then print_str("[companion] unfinished reason=" ++ reason ++ "\n" ++ partial) else 0;
   let remembered = len(partial) > 0 ? "[unfinished reason=" ++ reason ++ "]\n" ++ partial : answer;
   let row = CompanionRow{at_unix_ms: now_unix_ms(), lang: lang, said: said, answer: remembered, voice: asked[0], reason: reason, model: model};
   record_set(owner,"conversation",append(record_get(owner,"conversation"),[row]));
   print_str("[companion] voice=" ++ asked[0] ++ " reason=" ++ reason ++ " model=" ++ model ++ " memory=session mouth=" ++ offered.str());
  }
  def cp-from-ear(owner) {
   let heard = cp-ear-heard();
   !cp-present?(heard[1]) ? print_str("[companion] present=0") : cp-kept(owner,heard[1],heard[0],true,cp-ask(owner,heard[1],heard[0],true));
  }
  def cp-reside(said) {
   let owner=fcnv-residence();
   record_set(owner,"conversation",[]);
   defer print(["companion-release",fcnv-residence-close(owner)]);
   said == "from-ear" ? cp-from-ear(owner) : cp-turn(owner, said);
   cp-listen(owner);
  }
  def cp-run() {
   let first = read_line();
   nothing?(first) ? 0 : (String) trim(first) == "from-ear-check" ? cp-ear-check() : cp-reside(trim(first));
  }
 }
 cp-run();
}
