// companion-run.bml — the body's companion: it listens, and the body's own voice answers from this Mac's metal,
// remembering the last turns of the conversation.
//
// stdin line 1: what the person says; line 2: their tongue (blank -> en); line 3: "0" to keep the exchange without
// asking the voice (blank -> the voice answers).
// The voice is the registry's answer model in the fkwu session (form-stdlib/bml/form-cli-native-voice.bml), with the
// last six exchanges of .hearth/companion/conversation.jsonl as its memory. It hears what the person means, and
// knows when a human is needed. Each exchange is kept there; nothing leaves the Mac.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class Companion {
  def cp-dir() = ".hearth/companion";
  def cp-log() = ".hearth/companion/conversation.jsonl";
  def cp-line() { let l = read_line(); if nothing?(l) then "" else trim(l); }
  def cp-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def cp-nonempty(xs) = if nil?(xs) then list() else if eq(str_len(trim(head(xs))), 0) then cp-nonempty(tail(xs)) else cons(head(xs), cp-nonempty(tail(xs)));
  def cp-last(xs, n) = if le(len(xs), n) then xs else cp-last(tail(xs), n);
  def cp-memory-lines(rows) = if nil?(rows) then "" else mc-cat(list("Person: ", cp-str(head(rows), "said"), "\nCompanion: ", cp-str(head(rows), "answer"), "\n", cp-memory-lines(tail(rows))));
  def cp-parse(xs) = if nil?(xs) then list() else cons(parse-json("companion-row", head(xs)), cp-parse(tail(xs)));
  def cp-memory() = if lt(file_size(cp-log()), 1) then "" else cp-memory-lines(cp-parse(cp-last(cp-nonempty(split-on(fhn-read(cp-log()), "\n")), 6)));
  def cp-packet(said, lang, memory) = mc-cat(list(
   "You are this body's companion: warm, honest and present. Listen closely for what the person means, reflect what you hear, ask one gentle question when it helps, and speak plainly in the person's own tongue (", lang, "). You are not a human, and you say so when it matters; when what they say means their life or body is in danger, you tell them a human should be with them now, and you stay. ",
   if gt(str_len(memory), 0) then mc-cat(list("\n\nThe conversation so far:\n", memory)) else "",
   "\n\nThe person says: ", said, "\n\nCompanion:"));
  def cp-run() {
   let said = cp-line();
   let lang0 = cp-line();
   let lang = if eq(str_len(lang0), 0) then "en" else lang0;
   let voiceFlag = cp-line();
   let made = fs_mkdir(cp-dir());
   let asked = if str_eq(voiceFlag, "0") then list("not-asked", "") else fcnv-ask(cp-packet(said, lang, cp-memory()), json-node-object(list()));
   let answer = if str_eq(head(asked), "answered") then trim(nth(asked, 1)) else "";
   let told = if gt(str_len(answer), 0) then print_str(mc-cat(list(answer, "\n"))) else 0;
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("lang", lang), fhn-s("said", said), fhn-s("answer", answer), fhn-s("voice", head(asked))));
   let kept = fhn-append(cp-log(), str_concat(json-emit(row), "\n"));
   print_str(mc-cat(list("[companion] voice=", head(asked), "\n")));
  }
 }
 cp-run();
}
