// companion-run.bml — the body's companion: it listens, and the body's own voice answers from this Mac's metal,
// remembering the last turns of the conversation.
//
// stdin line 1: what the person says; line 2: their tongue (blank -> en); line 3: space-separated options:
// "0" skips the voice; "retain" saves this turn; "recall" reads saved turns;
// "mouth" exports the answer; "spool" allows the resident's disk transport.
// Blank asks the voice with session-only memory. These permissions are per turn.
// /pause, /resume, /leave and /forget are standalone control lines between turns, without a triple.
// Pause releases the native owner and skips ordinary triples until resume; leave
// releases it and consumes no later input. Forget clears session memory, not disk.
// Further triples reuse the same
// native owner; EOF closes it. Each packet still carries only the last six
// available exchanges. The reusable checkpoint contains guidance and retrieved
// context; changed context returns to the guidance checkpoint, while changed
// language opens a fresh owner. Personal turns are
// supplied by the existing explicit memory packet, not by the checkpoint.
// A present word is what gets an answer. An empty line does not. With spool permission and a standing resident, the ask goes there
// at a priority above a draft, and this door does not open a model. A first line `from-ear` reads the ear spool's last closed line (time, tongue,
// text) and asks that server; with no server standing it waits, and does not open one. `from-ear-check` reads a
// fixture and does not ask. With mouth permission the answer is offered as a text file under
// .hearth/companion/mouth/; the vocoder pass reads that file when it is run, and this door does not open the vocoder.
// The voice is the registry's answer model in the fkwu session (form-stdlib/bml/form-cli-native-voice.bml), with the
// last six available exchanges in this process as context. Saved history is read
// only with recall. Retention and mouth writes report their actual outcomes.
// Inspect the selected voice lane and recording scope before using personal material; local context
// storage alone establishes neither understanding nor a complete retention/processing guarantee.
// When the person's words carry the counsel (difficult conversations), the reply is read against its predicate before it is
// offered to the mouth and the door prints "[companion] lands=1|0" beside it: a reading for the caller, never a gate on the answer.
// The packet opens with the covenant's own arrival card (cognition/dialogue-covenant.fk, dc-card-core), then the
// ground the person's words actually touch (observe/companion-ground.bml): a teaching, a receipt, a counsel cell,
// or the miss when nothing carries them. The voice meets the person carrying both.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk observe/companion-packet.bml form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml form-stdlib/bml/ledger.bml form-stdlib/bml/serve-client.bml
section [form.bml] {
 blueprint CompanionRow { at_unix_ms: int, lang: string, said: string, answer: string, voice: string }
 class Companion {
  def cp-dir() = ".hearth/companion";
  def cp-log() = ".hearth/companion/conversation.jsonl";
  def cp-mouth() = ".hearth/companion/mouth";
  def cp-ear-segs() = ".hearth/ear.spool.segments";
  def cp-tab() = byte_to_str(9);
  def cp-ear-parts(line) = split-on(line, cp-tab());
  def cp-ear-closed?(line) {
   let p = cp-ear-parts(trim(line));
   (Comparable) len(p) >= 3 && (String) p[0] != "live" && (String) p[0] != "done";
  }
  def cp-ear-rest(p, i) = i >= len(p) ? "" : i == len(p) - 1 ? p[i] : p[i] ++ cp-tab() ++ cp-ear-rest(p, i + 1);
  def cp-ear-pair(line) {
   let p = cp-ear-parts(trim(line));
   [p[1], cp-ear-rest(p, 2)];
  }
  def cp-ear-last(lines, acc) = nil?(lines) ? acc : cp-ear-closed?(lines[0]) ? cp-ear-last(lines[1:], lines[0]) : cp-ear-last(lines[1:], acc);
  def cp-ear-of(text) {
   let line = cp-ear-last(split-on(text, "\n"), "");
   (Comparable) len(line) == 0 ? ["", ""] : cp-ear-pair(line);
  }
  def cp-ear-heard() = cp-ear-of(read_file(cp-ear-segs()) ?? "");
  def cp-ear-check() {
   let heard = cp-ear-of("live" ++ cp-tab() ++ "1" ++ cp-tab() ++ "2" ++ cp-tab() ++ "en" ++ cp-tab() ++ "hello there\n9" ++ cp-tab() ++ "en" ++ cp-tab() ++ "I am scared of the change\ndone\n");
   print([heard[0], heard[1], cp-present?(heard[1]) ? 1 : 0]);
  }
  // the reading is printed only when there is one (print_str ends its text with a line)
  def cp-say-lands(said, answer) {
   let line = cp-lands-line(said, answer);
   (Comparable) len(line) > 0 ? print_str(trim(line)) : 0;
  }
  def cp-present?(said) = (Comparable) len(trim(said)) > 0;
  def cp-private-dir() {
   fs_mkdir(cp-dir());
   host_chmod(cp-dir(),448);
  }
  def cp-offer(answer) {
   (Comparable) len(answer) == 0 ? 0 : {
    let made = cp-private-dir();
    let mouth = fs_mkdir(cp-mouth());
    let protected = host_chmod(cp-mouth(),448);
    let path = cp-mouth() ++ "/" ++ now_unix_ms().str() ++ ".txt";
    made != 0 || protected != 0 ? "refused:permissions" : {
     let wrote = write_file_text(path, answer);
     (read_file(path) ?? "") == answer && host_chmod(path,384) == 0 ? "written" : "refused:write";
    };
   };
  }
  def cp-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def cp-last(xs, n) = len(xs) <= n ? xs : cp-last(xs[1:], n);
  def cp-memory-lines(rows) = rows |> map(r => "Person: " ++ row-get(r, "said") ++ "\nCompanion: " ++ row-get(r, "answer") ++ "\n") |> str-join;
  def cp-has?(options,name) = any?(o => (String) o == name,options);
  def cp-options(text) {
   let options = filter(o => len(o) > 0, split-on(trim(text)," "));
   all?(o => cp-has?(["0","retain","recall","mouth","spool"],o),options) ? options : nothing();
  }
  def cp-memory(owner,options) = cp-memory-lines(cp-last(append(cp-has?(options,"recall") ? ledger-rows(cp-log(),"CompanionRow") : [],record_get(owner,"conversation")),6));
  def cp-control?(said) = cp-has?(["/pause","/resume","/leave","/forget"],said);
  def cp-control(owner,said) {
   if said == "/forget" then {
    record_set(owner,"conversation",[]);
    let closed = fcnv-residence-close(owner);
    print_str("[companion] session-memory=cleared saved-history=unchanged release=" ++ (closed ? "released" : "incomplete"));
   } else if said == "/resume" then {
    let closed = fcnv-residence-close(owner);
    record_set(owner,"companion-state",closed ? "active" : "paused");
    print_str("[companion] state=" ++ record_get(owner,"companion-state"));
   } else {
    record_set(owner,"companion-state",said == "/leave" ? "left" : "paused");
    if said == "/leave" then record_set(owner,"conversation",[]) else 0;
    let closed = fcnv-residence-close(owner);
    print_str("[companion] state=" ++ record_get(owner,"companion-state") ++ " release=" ++ (closed ? "released" : "incomplete"));
   };
  }
  def cp-turn(owner,said) {
   cp-control?(said) ? cp-control(owner,said) : cp-asked(owner,said);
  }
  def cp-asked(owner,said) {
   let lang0 = cp-line();
   let lang = (Comparable) len(lang0) == 0 ? "en" : lang0;
   let options = cp-options(cp-line());
   if record_get(owner,"companion-state") == "paused" then print_str("[companion] state=paused")
   else if !cp-present?(said) then print_str("[companion] present=0")
   else if nothing?(options) then print_str("[companion] options=refused; use 0 retain recall mouth spool")
   else cp-kept(owner,said,lang,options,cp-ask(owner,said,lang,options));
  }
  def cp-ask(owner,said,lang,options) {
   if cp-has?(options,"0") then ["not-asked", ""] else {
    let served = svc-standing(svc-default-dir())[0] == "standing";
    if served && !cp-has?(options,"spool") then ["spool-permission-required",""] else {
     let context = cp-context(said,lang) ++ cp-runtime-scope(cp-has?(options,"retain"),cp-has?(options,"recall"),cp-has?(options,"mouth"),served);
     let packet = cp-packet-from(context,said,cp-memory(owner,options));
     served ? (svc-voice-prio(packet,0,"companion",8) ?? ["unserved",""]) : fcnv-resident-ask-with-floor(owner,packet,context,cp-prefix(lang),json-node-object([json-node-pair("interactive",json-node-bool(true))]));
    };
   };
  }
  def cp-listen(owner) {
   if record_get(owner,"companion-state") == "left" then 0 else {
    let line=read_line();
    nothing?(line) ? 0 : { cp-turn(owner,trim(line)); cp-listen(owner); };
   };
  }
  def cp-retain(row) {
   cp-private-dir() != 0 ? "refused:permissions" : {
    let kept = ledger-append(cp-log(),row);
    let protected = host_chmod(cp-log(),384);
    protected == 0 ? kept : "refused:permissions";
   };
  }
  def cp-kept(owner,said,lang,options,asked) {
   let answer = (String) asked[0] == "answered" ? trim(asked[1]) : "";
   let partial = asked[0] != "answered" && len(asked) > 8 ? trim(asked[8]) : "";
   let reason = len(asked) > 7 ? asked[7] : asked[0];
   let read = cp-say-lands(said, answer);
   let offered = cp-has?(options,"mouth") ? cp-offer(answer) : "not-requested";
   let told = len(answer) > 0 ? print_str(answer ++ "\n") : 0;
   if len(partial) > 0 then print_str("[companion] unfinished reason=" ++ reason ++ "\n" ++ partial) else 0;
   let remembered = len(partial) > 0 ? "[unfinished reason=" ++ reason ++ "]\n" ++ partial : answer;
   let row = CompanionRow{at_unix_ms: now_unix_ms(), lang: lang, said: said, answer: remembered, voice: asked[0]};
   record_set(owner,"conversation",cp-last(append(record_get(owner,"conversation"),[row]),6));
   let kept = cp-has?(options,"retain") ? cp-retain(row) : "not-requested";
   print_str("[companion] voice=" ++ asked[0] ++ " reason=" ++ reason ++ " retention=" ++ kept.str() ++ " mouth=" ++ offered.str());
  }
  def cp-from-ear(owner) {
   let heard = cp-ear-heard();
   let options = cp-options(cp-line());
   !cp-present?(heard[1]) ? print_str("[companion] present=0") : nothing?(options) ? print_str("[companion] options=refused") : cp-has?(options,"0") ? cp-kept(owner,heard[1],heard[0],options,["not-asked",""]) : !cp-has?(options,"spool") ? print_str("[companion] voice=spool-permission-required") : svc-standing(svc-default-dir())[0] != "standing" ? print_str("[companion] unserved: no server stands") : cp-kept(owner,heard[1],heard[0],options,cp-ask(owner,heard[1],heard[0],options));
  }
  def cp-reside(said) {
   let owner=fcnv-residence();
   record_set(owner,"conversation",[]);
   record_set(owner,"companion-state","active");
   defer print(["companion-release",fcnv-residence-close(owner)]);
   said == "from-ear" ? cp-from-ear(owner) : cp-turn(owner, said);
   cp-listen(owner);
  }
  def cp-run() {
   let first = read_line();
   nothing?(first) ? 0 : (String) trim(first) == "from-ear-check" ? cp-ear-check() : cp-reside(trim(first));
  }
 }
 cp-run();
}
