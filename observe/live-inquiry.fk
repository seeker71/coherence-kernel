; live-inquiry.fk — the body reading its own state and asking its own next question.
;
; Urs, 2026-07-23 00:36: do it live, with automatic questions, and new questions built from
; the lego blocks.
;
; Two moves. First, DERIVE the state from what the sensors say rather than being told it —
; still or moving from linear acceleration, flat or held from tilt, dark or lit from the
; light sensor. Second, COMPOSE: pair two recipes from sensing-playbook.fk and get a
; question neither of them asks alone, then keep only the pairs whose state is the state
; we are actually in.
;
; The composition that made this worth writing:
;
;   pressure alone is ambiguous. A barometer reading that drifts might be weather, or it
;   might be the phone climbing stairs, and the sensor cannot tell you which. Compose it
;   with STILLNESS and the ambiguity dissolves in both directions at once — a still phone's
;   pressure change IS the weather, and a moving phone's pressure change IS altitude. Same
;   sensor, opposite meanings, and the second sensor is what says which.
;
; That is the general shape and the reason to build blocks at all: a composed question is
; not two answers side by side, it is one answer that neither sensor could give. The
; playbook lists what each block can do; this cell is where they start doing it together.
;
; Every question carries the state it needs, so the chooser can be asked "what can be asked
; RIGHT NOW" and answer honestly rather than listing everything conceivable.
;
; preludes: form-stdlib/core.fk

(do
    ; ── deriving the state from live readings ──
    ; thresholds named once: 50 milli-m/s2 of residual motion is the still/moving line;
    ; 15 degrees of tilt separates lying-down from being held; light is the phone's own
    ; ordinal brightness, where 2 and below is a dark room.
    (defn li-still-floor () 50)
    (defn li-held-mdeg () 15000)
    (defn li-dark-max () 2)

    (defn li-state (motion-milli tilt-mdeg light)
        (if (ge motion-milli (li-still-floor)) "moving"
            (if (ge tilt-mdeg (li-held-mdeg)) "held"
                (if (le light (li-dark-max)) "dark" "still"))))

    ; ── a composed question: (text plane needs-state a b) ──
    (defn li-q (text plane state a b) (list text plane state a b))
    (defn li-text  (q) (nth q 0))
    (defn li-plane (q) (nth q 1))
    (defn li-state-of (q) (nth q 2))
    (defn li-a (q) (nth q 3))
    (defn li-b (q) (nth q 4))

    ; ── the compositions. Each is two blocks and a question neither asks alone. ──
    (defn li-questions ()
        (list
            (li-q "is that pressure drift the weather, or is this phone climbing?"
                  "where" "still" "altitude" "stillness")
            (li-q "how far has this accelerometer drifted since it was made?"
                  "how" "still" "bias" "stillness")
            (li-q "how much steel and wiring is standing around this phone?"
                  "where" "still" "heading" "stillness")
            (li-q "which direction is the music arriving from?"
                  "where" "any" "insonation" "bearing")
            (li-q "is this walking on the level, or up?"
                  "when" "moving" "cadence" "altitude")
            (li-q "does the moving start when the light changes?"
                  "when" "dark" "ambient" "stillness")
            (li-q "where in the WORLD is that sound, not just where beside the phone?"
                  "where" "held" "bearing" "attitude")))

    (defn li-askable? (q state)
        (if (str_eq (li-state-of q) "any") 1
            (if (str_eq (li-state-of q) state) 1 0)))
    (defn li-count-askable (qs state)
        (if (eq (len qs) 0) 0
            (add (li-askable? (head qs) state) (li-count-askable (tail qs) state))))
    (defn li-first-askable (qs state)
        (if (eq (len qs) 0) "nothing composes in this state yet"
            (if (eq (li-askable? (head qs) state) 1) (li-text (head qs))
                (li-first-askable (tail qs) state))))

    ; ── the live reading, 2026-07-23 00:32, from room-read.fk's own inputs ──
    (defn li-now-motion () 14)      ; milli-m/s2, gravity removed
    (defn li-now-tilt () 1374)      ; millidegrees off flat
    (defn li-now-light () 3)        ; the phone's ordinal brightness
    (defn li-now-state () (li-state (li-now-motion) (li-now-tilt) (li-now-light)))

    ; ── self-check ──
    (defn lik (cond bit) (if cond bit 0))
    (defn li-s-still ()  (lik (str_eq (li-state 14 1374 3) "still") 1))
    (defn li-s-moving () (lik (str_eq (li-state 900 1374 3) "moving") 2))
    (defn li-s-held ()   (lik (str_eq (li-state 14 42000 3) "held") 4))
    (defn li-s-dark ()   (lik (str_eq (li-state 14 1374 1) "dark") 8))
    ; the phone as it actually sits right now
    (defn li-now ()      (lik (str_eq (li-now-state) "still") 16))
    ; still composes four questions: the three still-only ones plus the any-state one
    (defn li-still-4 ()  (lik (eq (li-count-askable (li-questions) "still") 4) 32))
    ; and the first of them is the barometer's ambiguity, dissolved
    (defn li-first ()
        (lik (str_eq (li-first-askable (li-questions) "still")
                     "is that pressure drift the weather, or is this phone climbing?") 64))
    ; moving composes two, and they are not the same two
    (defn li-moving-2 () (lik (eq (li-count-askable (li-questions) "moving") 2) 128))
    ; seven compositions exist; no state offers all of them, which is the point
    (defn li-seven ()    (lik (eq (len (li-questions)) 7) 256))
    (defn live-inquiry-check ()
        (add (add (add (li-s-still) (li-s-moving)) (add (li-s-held) (li-s-dark)))
        (add (add (add (li-now) (li-still-4)) (add (li-first) (li-moving-2)))
             (li-seven))))
)
