; iq2xs-gpu-run.fk — emit the BML-grounded type-17 fixture, CPU truth, and Metal unit.
;
; This observer carries no benchmark verdict. The shell carrier binds these emitted bytes to Metal,
; checks GPU results against the CPU carver, and times the serial and SIMDgroup fused matvecs.
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/iq2xxs-dequant.fk form-stdlib/iq2xxs-msl.fk form-stdlib/iq2xs-layout-xtal.fk form-stdlib/iq2xs-dequant.fk form-stdlib/iq2xs-msl.fk form-stdlib/jit-tensor-emit.fk form-stdlib/qk-matvec-lane.fk

(do
    (defn iq2xg-cat (xs ys)
        (if (eq (len xs) 0) ys (cons (head xs) (iq2xg-cat (tail xs) ys))))
    (defn iq2xg-u16 (v) (list (iq2x-mod v 256) (div v 256)))
    (defn iq2xg-word (k)
        (add (iq2x-mod (mul 17 k) 512) (mul 512 (iq2x-mod (mul 13 k) 128))))
    (defn iq2xg-qbytes (k)
        (if (ge k 32) (empty)
            (iq2xg-cat (iq2xg-u16 (iq2xg-word k)) (iq2xg-qbytes (add k 1)))))
    (defn iq2xg-scales (i)
        (if (ge i 8) (empty)
            (cons (add i (mul 16 (sub 15 i))) (iq2xg-scales (add i 1)))))
    (defn iq2xg-block ()
        (iq2xg-cat (list 0 60) (iq2xg-cat (iq2xg-qbytes 0) (iq2xg-scales 0))))
    (defn iq2xg-print-ints (xs)
        (if (eq (len xs) 0) 0
            (do (print_str (int_to_str (head xs))) (iq2xg-print-ints (tail xs)))))
    (defn iq2xg-print-ref (block i)
        (if (ge i 256) 0
            (do (print (iq2xs-at block 0 i)) (iq2xg-print-ref block (add i 1)))))
    (defn iq2xg-emit ()
        (do
            (let block (iq2xg-block))
            (print_str "BLOCK")
            (iq2xg-print-ints block)
            (print_str "REF")
            (iq2xg-print-ref block 0)
            (print_str "MSL")
            (print_str (str_concat (qml-msl-header)
                (iq2xsm-msl-unit "form_iq2xs_dequant_f32" "form_iq2xs_matvec_f32" "form_iq2xs_matvec_simd_f32" "form_iq2xs_matvec_slot4_f32")))
            (print_str "END")
            0))
    (iq2xg-emit))
