// Retained repair runs become private experience without repeating execution.
// JSON stdin: optional root and home. No model is admitted by this door.
// preludes: form-stdlib/bml/form-cli-heal.bml
section [form.bml] {
 class FormCliHealExperienceRun {
  def fhex-count(rows) = if nil?(rows) then 0 else add(nsm-num(head(rows),"records"),fhex-count(tail(rows)));
  def fhex-run() {
   let raw = read_line();
   if or(nothing?(raw),str_eq(raw,"")) then print_str("JSON stdin: optional root and home. Recover completed repair observations into private experience.\n") else fhex-request(parse-json("recover-repair-experience",raw));
  }
  def fhex-request(request) {
   let home = nsm-str(request,"home"); let root = nsm-str(request,"root");
   let home = if str_eq(home,"") then hearth-session-learning() else home;
   let rows = fh-recover-experiences(home,if str_eq(root,"") then ".form-heal" else root);
   let made = nsm-init(home); let path = nsm-at(home,"recovered-repair-experience.json");
   let saved = nsm-write(path,json-node-array(rows));
   print_str(str_concat(json-emit-precise(json-node-object(list(nsm-s("path",path),nsm-n("jobs",len(rows)),nsm-n("records",fhex-count(rows)),nsm-n("model_calls",0)))),"\n"));
  }
 }
 fhex-run();
}
