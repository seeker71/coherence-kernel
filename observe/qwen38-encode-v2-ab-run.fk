; qwen38-encode-v2-ab-run.fk — the indexed encoder against the reference,
; byte-for-byte. Ground: the measured wall is tkz-cands (71.2 s for one
; pass over 127,741 merges, paid once per q35-encode call, seven calls per
; chat-ids = the 571 s turn price, 2026-08-25). The qtf2 sorted fixed-row
; index replaces that pass with binary probes per adjacent pair. This cell
; defines the indexed encoder and demands identity with q35-encode on the
; live steering prompt before any wiring.
;
; preludes: form-stdlib/qwen35-tokfast-v2.fk form/native/metal/qwen35-crystal.fk form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn qe2-path () (mr-path (mr-find "qwen38-q8")))
    (defn qe2-prompt ()
        "You are steering this body's next step. The measured state right now: the build chain is rebuilding form-cli in the background; ten frontier rows just landed in the corpus (band 32767 full); the v3 audit scored 13 of 30 with axioms, learn, teachings, control, ingest at zero; the census counted 5960 sources. Choose exactly ONE door to run now and say why in one sentence.\n\ndoor 1: run the corpus band (verify the ten new rows hold)\ndoor 2: probe axioms retrieval (the zero family; retrieval speed matters for teaching)\ndoor 3: count the census sources (fresh denominator)\n\nAnswer with the door number first.")

    ; ---- BPE over one piece through the index ---------------------------
    (defn qe2-bpe (x syms)
        (if (lt (len syms) 2) syms
            (do (let c (qtf2-best-pair-file x syms))
                (if (not (str_eq (qtf2-pair-choice-status c) "ok")) syms
                    (if (eq (qtf2-pair-choice-present? c) 0) syms
                        (qe2-bpe x (tkz-apply syms
                            (qtf2-pair-choice-position c))))))))

    ; ---- symbol -> id through the index (byte fallback on miss) ---------
    (defn qe2-ids-of-syms (src x syms acc)
        (if (eq (len syms) 0) acc
            (do (let o (qtf2-vocab-find-file x (head syms)))
                (qe2-ids-of-syms src x (tail syms)
                    (if (str_eq (qtf2-outcome-status o) "hit")
                        (append acc (list (qtf2-outcome-value o)))
                        (tkz-cat acc (tkz-ids-of-bytes src (head syms) 0)))))))

    ; ---- whole input: same piece split, indexed fold and lookup ---------
    (defn qe2-encode-from (src x inp L pos acc)
        (if (lt pos L)
            (do (let end (q35-next-piece inp L pos))
                (qe2-encode-from src x inp L end
                    (qe2-ids-of-syms src x
                        (qe2-bpe x (tkz-syms inp pos end)) acc)))
            acc))
    (defn qe2-encode (src x inp)
        (qe2-encode-from src x inp (str_len inp) 0 (empty)))

    ; ---- element-wise identity ------------------------------------------
    (defn qe2-same (a b i)
        (if (not (eq (len a) (len b))) 0
            (if (eq i (len a)) 1
                (if (eq (nth a i) (nth b i)) (qe2-same a b (add i 1)) 0))))

    (let path (qe2-path))
    (let src (fcmg-src path))
    (let seal (qsx-trim (read_file (qaf-seal-path-for path))))
    (let x (qtf2-load (qtf2-root-for path) seal))
    (print (str_concat "index_status=" (qtf2-index-status x)))
    (if (not (eq (qtf2-index-current? x) 1))
        (print "index not current — freeze first; nothing compared")
        (do
            (let inp (qe2-prompt))
            (let a0 (now_unix_ms))
            (let ref (q35-encode src inp))
            (let a1 (now_unix_ms))
            (print (str_concat "reference_ms=" (int_to_str (sub a1 a0))))
            (let b0 (now_unix_ms))
            (let v2 (qe2-encode src x inp))
            (let b1 (now_unix_ms))
            (print (str_concat "indexed_ms=" (int_to_str (sub b1 b0))))
            (print (str_concat "reference_n=" (int_to_str (len ref))))
            (print (str_concat "indexed_n=" (int_to_str (len v2))))
            (print (str_concat "identical=" (int_to_str (qe2-same ref v2 0))))
            0))
    0)
