// companion-ground.bml — what the companion may stand on, read before the voice is asked.
//
// The same ranking the grounded door uses: a teaching or a receipt whose name carries the
// person's words, plus a counsel cell whose own line carries them, plus an enrich reading
// that held an exact entry. A retrieval miss limits factual claims; it does
// not turn a metaphor, a game or a pause into a failed knowledge enquiry.
// preflight-exec: forbidden
import form-stdlib/core.fk;
import form-stdlib/bml/form-cli-grounded-synthesis.bml;
import form-stdlib/bml/form-cli-enrich.bml;
import form-stdlib/query-lane-resolve.bml;
import cognition/difficult-conversation-counsel.fk;
section [form.bml] {
  def cp-skip() = ["about", "would", "could", "their", "there", "after", "before", "which", "where", "while", "still", "never", "every", "other", "being", "going", "think", "thing"];
  def cp-keep?(w) = len(w) >= 5 && !any?(s => s == w, cp-skip());
  def cp-terms(said) = take(6, filter(cp-keep?, qlr-tokens(said)));
  def cp-at(dir, names) = nil?(names) ? [] : cons(dir ++ "/" ++ names[0], cp-at(dir, names[1:]));
  def cp-hits(dir, terms) = fgs-top(fgs-rank(cp-at(dir, fs_list(dir) ?? []), terms), 1);
  def cp-touch?(text, terms) = any?(t => str_find(text, t, 0) >= 0, terms);
  def cp-cell?(m, terms) = cp-touch?(dcc-name(m) ++ " " ++ dcc-teaching(m) ++ " " ++ dcc-cell(m), terms);
  def cp-cells(ms, terms) = nil?(ms) ? [] : cp-cell?(ms[0], terms) ? cons([1, dcc-cell(ms[0]), 1], cp-cells(ms[1:], terms)) : cp-cells(ms[1:], terms);
  def cp-seen?(path, rows) = any?(r => (String) r[1] == path, rows);
  def cp-add(rows, more) = nil?(more) ? rows : cp-seen?(more[0][1], rows) ? cp-add(rows, more[1:]) : cp-add(append(rows, [more[0]]), more[1:]);
  def cp-enrich-at(terms) = nil?(terms) ? "" : fce-held(terms[0]) ++ cp-enrich-at(terms[1:]);
  def cp-show(rows) = nil?(rows) ? "" : rows[0][1] ++ "\n" ++ fgs-opening(rows[0][1], 180) ++ "\n" ++ cp-show(rows[1:]);
  def cp-miss() = "Library lookup: no matching source. State that limit when a factual answer needs it. Their own words still ground acknowledgment, clearly framed play, or an accepted pause.\n";
  def cp-ground(said) {
   let terms = cp-terms(said);
   let rows = take(2, cp-add(cp-add([], cp-cells(dcc-body-moves(), terms)), append(cp-hits("teachings", terms), cp-hits("receipts", terms))));
   let enrich = cp-enrich-at(take(3, terms));
   if nil?(rows) && len(enrich) == 0 then cp-miss() else "Library context for relevant factual claims:\n" ++ enrich ++ cp-show(rows) ++ "Use a source only where it meets their request; offer its path when relevant or asked. Their own words also ground acknowledgment, clearly framed play, or an accepted pause. A library match does not establish their feelings or intended meaning.\n";
  }
  // ---- the doors (docs/grounded-voice-door.md): what the voice cannot know from weights, read from the doors' own names and head comments ----
  // A person's life holds doors, bodies, voices, rent, sessions and bands, and those words are theirs. An ask names the body only when it asks (a question, or an opening like "name" or "list"), speaks of no person ("I", "she", "someone"), and either holds a word that only the machine owns or sets an everyday noun doing the work after "which" ("which door closes"). Any other ask reads no file and its packet stays bare.
  def cp-door-possessive?(w) = len(w) > 2 && str_byte_at(w, len(w) - 1) == 115 && str_byte_at(w, len(w) - 2) == 39;
  def cp-door-stem(w) = cp-door-possessive?(w) ? substring(w, 0, len(w) - 2) : len(w) > 4 && str_byte_at(w, len(w) - 1) == 115 && str_byte_at(w, len(w) - 2) != 115 ? substring(w, 0, len(w) - 1) : w;
  def cp-door-machine() = ["fkwu", "kernel", "ledger", "axiom", "gpu", "cache"];
  def cp-door-everyday() = ["door", "band", "lane"];
  def cp-door-helpers() = ["do", "did", "does", "should", "can", "could", "will", "would", "must", "may", "might", "am", "is", "are", "was", "were", "have", "has", "had"];
  def cp-door-owners() = ["my", "our", "their", "your"];
  def cp-door-people() = ["i", "he", "she", "him", "her", "his", "hers", "someone", "somebody"];
  def cp-door-openers() = ["name", "list", "show", "tell", "find", "read"];
  def cp-door-in?(w, words) = any?(x => (String) x == w, words);
  def cp-door-asking?(said, ws) = !nil?(ws) && (str_find(said, "?", 0) >= 0 || cp-door-in?(ws[0], cp-door-openers()));
  def cp-door-machine?(w, prior) = !cp-door-in?(prior, cp-door-owners()) && (cp-door-in?(w, cp-door-machine()) || ((String) w == "register" && (String) prior == "gap"));
  def cp-door-doer?(w, prior, next) = (String) prior == "which" && cp-door-in?(w, cp-door-everyday()) && !cp-door-in?(next, cp-door-helpers());
  def cp-door-word-at(ws, prior) {
   if nil?(ws) then false else {
    let w = cp-door-stem(ws[0]);
    cp-door-machine?(w, prior) || cp-door-doer?(w, prior, len(ws) > 1 ? ws[1] : "") || cp-door-word-at(ws[1:], ws[0]);
   };
  }
  def cp-door-named?(said) { let ws = qlr-tokens(said); cp-door-asking?(said, ws) && !any?(w => cp-door-in?(w, cp-door-people()), ws) && cp-door-word-at(ws, ""); }
  def cp-door-skip() = ["door", "doors", "which", "what", "does", "this", "that", "from", "with", "have", "been", "body", "reads", "read", "tell", "tells", "show", "shows", "where", "when", "into", "only", "them", "about", "would", "could"];
  def cp-door-terms(said) = take(8, map(cp-door-stem, filter(w => len(w) >= 4 && !any?(s => s == w, cp-door-skip()), qlr-tokens(said))));
  def cp-door-head-bytes() = 240;
  // a door is source: the kernel's lowered caches beside it are no door, so the index reads the same in a clean tree and a used one
  def cp-door-ends?(n, e) = len(n) >= len(e) && (String) substring(n, len(n) - len(e), len(n)) == e;
  def cp-door-source?(n) = str_find(n, "-run.", 0) > 0 && (cp-door-ends?(n, ".bml") || cp-door-ends?(n, ".fk"));
  def cp-door-files() = append(map(n => "observe/" ++ n, filter(cp-door-source?, fs_list("observe") ?? [])), ["axioms/core-axioms.form"]);
  // a door's head begins at its first line holding a letter, so a ruled line spends none of the bytes the voice is shown
  def cp-door-lettered?(t, i, end) = i < end && ((str_byte_at(t, i) >= 97 && str_byte_at(t, i) <= 122) || cp-door-lettered?(t, i + 1, end));
  def cp-door-begin(t, i) {
   let nl = str_find(t, "\n", i);
   nl < 0 || cp-door-lettered?(t, i, nl) ? i : cp-door-begin(t, nl + 1);
  }
  def cp-door-head(path) { let t = read_file(path) ?? ""; let a = cp-door-begin(t, 0); substring(t, a, fgs-min(len(t), a + cp-door-head-bytes())); }
  // [path, head]: a path that does not stand on this disk is no door
  def cp-door-entry(path) = [path, cp-door-head(path)];
  def cp-door-index-of(paths) = map(cp-door-entry, filter(p => (Comparable) host_path_exists(p) == 1, paths));
  def cp-door-index() = cp-door-index-of(cp-door-files());
  // terms weigh by fgs-weight's rarity over the doors' names and heads. A word in the name counts three of a word in the head; the floor keeps one common word from offering a door
  def cp-door-score(e, weights) = foldl((acc, w) => acc + (str_find(e[0], w[0], 0) >= 0 ? w[1] * 3 : fgs-holds?(e[1], w[0]) ? w[1] : 0), 0, weights);
  def cp-door-floor() = 5;
  def cp-door-rows(index, said) {
   let hays = map(e => [e[0], e[0] ++ "\n" ++ e[1]], index);
   let weights = map(t => fgs-weight(hays, t), cp-door-terms(said));
   fgs-top(filter(r => r[0] >= cp-door-floor(), map(e => [cp-door-score(e, weights), e[0], cp-door-score(e, weights)], index)), 3);
  }
  def cp-door-miss() = "Door lookup: no door of this body meets these words. If the answer needs a door, say that plainly and name no path.\n";
  def cp-door-text(rows) = nil?(rows) ? cp-door-miss() : "Doors of this body that meet these words, each its path and its own head. Name a door only by a path written here; offer the one that fits, or say none does.\n" ++ str-join-with(map(r => r[1] ++ "\n" ++ cp-door-head(r[1]) ++ "\n", rows), "");
  def cp-door-ground-in(index, said) = cp-door-named?(said) ? cp-door-text(cp-door-rows(index, said)) : "";
  def cp-door-ground(said) = cp-door-named?(said) ? cp-door-ground-in(cp-door-index(), said) : "";
  // the placebo: the ground another ask of the set retrieved, sharing no path with this ask's true ground; an ask that names no door stays bare under it too
  def cp-door-apart?(a, b) = !any?(x => any?(y => (String) x[1] == y[1], b), a);
  def cp-door-wrong-at(index, saids, i, k, own) {
   if k >= len(saids) then cp-door-miss() else {
    let other = cp-door-rows(index, nth(saids, (i + k) % len(saids)));
    !nil?(other) && cp-door-apart?(own, other) ? cp-door-text(other) : cp-door-wrong-at(index, saids, i, k + 1, own);
   };
  }
  def cp-door-permuted(index, saids, i) = cp-door-named?(nth(saids, i)) ? cp-door-wrong-at(index, saids, i, 1, cp-door-rows(index, nth(saids, i))) : "";
  // the packet: the role prompt first and untouched, the ground beside the frame; an empty ground is the bare packet, byte for byte
  def cp-door-packet(role, ground, frame) = (String) role == "" ? ground ++ frame : role ++ "\n---\n" ++ ground ++ frame;
}
