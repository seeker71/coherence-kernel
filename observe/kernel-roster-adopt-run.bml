// kernel-roster-adopt-run.bml — give a roster slot to the untracked kernels a caller names, as the care the census offered.
//
// stdin: one line of pids, chosen from a census reading. Only pids the untracked reading names are touched, each
// through kernel_roster_adopt (per pid: 1 adopted, 0 already held, -1 no living kernel page, -2 no free slot). The
// readings, the response, the applied adoption and a fresh reading all speak as organ-health events.
//
//   echo "<pid> <pid>" | ./fkwu observe/kernel-roster-adopt-run.bml
//
// preludes: form-stdlib/core.fk form/form-stdlib/kernel-roster.bml
section [form.bml] {
 class KernelRosterAdoptRun {
  def krar-run() = print_str(str_concat(json-emit-precise(json-node-array(krs-adopt(oc-chosen(read_line())))), "\n"));
 }
 krar-run();
}
