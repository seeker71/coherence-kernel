// walk-sync-run.bml — the walk's own sync, run by hand on a named checkout from the code that heals.
//
//   echo '{"dir":"/Users/me/source/coherence-kernel-walk","branch":"claude/some-branch"}' | ./fkwu observe/walk-sync-run.bml
//
// A walk runs the host-walk parts of its OWN checkout. When that checkout stands behind main and its rebase meets
// a conflict the landed sync now heals (a drawn page, a ledger river: form-stdlib/bml/host-walk-sync.bml,
// form-cli-reunion.bml), the checkout's own older sync cannot heal itself: every turn would hold on the conflict.
// This door runs the landed sync (hw-sync-in) against that checkout once, from the tree that has the healing,
// so the checkout follows main and its next walk runs the healed code. It prints what the sync prints: the
// healed and redrawn lines, then "sync=0", or the conflict or dirty line and "sync=1" when it could not.
// stdin: one JSON line, dir (the checkout, absolute) and branch (its branch; absent: read from the checkout).
// The checkout's lock is read first (hw-claim names the walk or day turn that holds it): a held checkout is left alone.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/host-walk.bml
section [form.bml] {
 class WalkSyncRun {
  def wsr-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def wsr-options() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("walk-sync-options", line) : json-node-object([]);
  }
  def wsr-branch-of(dir) = hw-line(hch-read(["git", "-C", dir, "rev-parse", "--abbrev-ref", "HEAD"]));
  def wsr-run() {
   let opts = wsr-options();
   let dir = wsr-text(opts, "dir", "");
   (String) dir == "" ? print_str("[walk-sync] need: stdin names the checkout as {\"dir\":\"/absolute/path\"}") : wsr-in(dir, wsr-text(opts, "branch", wsr-branch-of(dir)));
  }
  // a checkout whose walk lock stands (a walk or day turn is in it, or a killed one left its owner file) is left alone
  // and named: the walk's own claim takes a stale lock, this door does not
  def wsr-owner(dir) = hw-owner(dir ++ "/" ++ hw-lock());
  def wsr-in(dir, branch) = (String) wsr-owner(dir) != "" ? print_str("[walk-sync] held: the checkout's walk lock stands, " ++ wsr-owner(dir)) : print_str(hw-line(hw-sync-in(dir, branch)));
 }
 wsr-run();
}
