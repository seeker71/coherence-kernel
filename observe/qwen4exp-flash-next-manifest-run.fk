; qwen4exp-flash-next-manifest-run.fk — read the exact Unsloth UD-Q2_K_XL
; metadata shard through the body's GGUF manifest, before any native admission.
;
; The three-shard artifact keeps its complete GGUF metadata and tensor table in
; shard one. This door names that physical boundary; it does not claim that the
; current single-file Metal model handle can bind the other two shards.
;
; preludes: form-stdlib/core.fk form-stdlib/gguf-manifest.fk form-stdlib/model-registry.bml

(gm-emit-manifest
    (mr-path (mr-find "qwen38-flash-next-q2")))
