; lora-voice-ask-run.fk — one question to the base model and to the adapter.
; stdin: line 1 the data folder (blank -> the native one), line 2 the question.
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-voice.bml
(do
    (defn lva-trim (s) (if (nothing? s) "" (trim s)))
    (let data0 (lva-trim (read_line)))
    (let data (if (eq (str_len data0) 0) (LVData) data0))
    (let q (lva-trim (read_line)))
    (print_str (str_concat "base: " (str_concat (if (nothing? (lv-ask data q 0)) "nothing" (lv-ask data q 0)) "\n")))
    (print_str (str_concat "adapter: " (str_concat (if (nothing? (lv-ask data q 1)) "nothing" (lv-ask data q 1)) "\n")))
    0)
