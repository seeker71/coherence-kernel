; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/tensor-ir.fk form-stdlib/jit-tensor-emit.fk form-stdlib/msl-mint-lens.bml
;
; msl-mint-run — every MSL family jit-tensor-emit.fk can emit, offered to this Mac's own Metal
; compiler, one at a time. No census by hand: the list below is the emitter's own entry points.
;
; Three states, no refusals. Form native heals and integrates, or it releases. A family the
; compiler took is WHOLE; one it did not take while naming the repair is UNHEALED and carries its
; healing in the machine's own word; one it did not take with nothing named is RELEASED, let go
; rather than kept as a standing no. The verdict is the count still waiting on the body.
(do
    (let rows (list
        (mm-try "matvec f32"                  (jte-matvec-msl-fmt "f_mv32" "f32") "f_mv32")
        (mm-try "matvec f16"                  (jte-matvec-msl-fmt "f_mv16" "f16") "f_mv16")
        (mm-try "matvec bf16"                 (jte-matvec-msl-fmt "f_mvbf" "bf16") "f_mvbf")
        (mm-try "matvec-T f32"               (jte-matvec-t-msl-fmt "f_mvbft" "f32") "f_mvbft")
        (mm-try "matvec-T f16"               (jte-matvec-t-msl-fmt "f_mvt16" "f16") "f_mvt16")
        (mm-try "matvec-T bf16"              (jte-matvec-t-msl-fmt "f_mvtbf" "bf16") "f_mvtbf")
        (mm-try "outer-acc f32"              (jte-outer-acc-msl-fmt "f_mvbfo" "f32") "f_mvbfo")
        (mm-try "outer-acc f16"              (jte-outer-acc-msl-fmt "f_oa16" "f16") "f_oa16")
        (mm-try "outer-acc bf16"             (jte-outer-acc-msl-fmt "f_oabf" "bf16") "f_oabf")
        (mm-try "affine-train f32"            (jte-affine-train-msl "f_aff") "f_aff")
        (mm-try "affine-train f16"            (jte-affine-train-msl-fmt "f_aff16" "f16") "f_aff16")
        (mm-try "affine-train bf16"           (jte-affine-train-msl-fmt "f_affbf" "bf16") "f_affbf")
        (mm-try "ffn-fwd f32"                 (jte-mlp-fwd-msl "f_ffn") "f_ffn")
        (mm-try "ffn-fwd f16"                 (jte-mlp-fwd-msl-fmt "f_ffn16" "f16") "f_ffn16")
        (mm-try "ffn-fwd bf16"                (jte-mlp-fwd-msl-fmt "f_ffnbf" "bf16") "f_ffnbf")
        (mm-try "mlp-train f32"               (jte-mlp-train-msl "f_mlp") "f_mlp")
        (mm-try "mlp-train f16"               (jte-mlp-train-msl-fmt "f_mlp16" "f16") "f_mlp16")
        (mm-try "mlp-train bf16"              (jte-mlp-train-msl-fmt "f_mlpbf" "bf16") "f_mlpbf")
        (mm-try "resid-train f32"             (jte-resid-train-msl "f_res") "f_res")
        (mm-try "resid-train f16"             (jte-resid-train-msl-fmt "f_res16" "f16") "f_res16")
        (mm-try "resid-train bf16"            (jte-resid-train-msl-fmt "f_resbf" "bf16") "f_resbf")
        (mm-try "attn-train f32"              (jte-attn-train-msl "f_att") "f_att")
        (mm-try "attn-train f16"              (jte-attn-train-msl-fmt "f_att16" "f16") "f_att16")
        (mm-try "attn-train bf16"             (jte-attn-train-msl-fmt "f_attbf" "bf16") "f_attbf")
        (mm-try "block-fwd"                   (jte-block-fwd-msl "f_blk") "f_blk")
        (mm-try "llama-block-fwd"             (jte-llama-block-fwd-msl "f_lbf") "f_lbf")
        (mm-try "llama-block-fwd-causal"      (jte-llama-block-fwd-causal-msl "f_lbc") "f_lbc")
        (mm-try "gqa-attn"                    (jte-gqa-attn-msl "f_gqa") "f_gqa")
        (mm-try "gqa-llama-block-fwd-causal"  (jte-gqa-llama-block-fwd-causal-msl "f_gbc") "f_gbc")
        (mm-try "llama-block-decode-step"     (jte-llama-block-decode-step-msl "f_lds") "f_lds")
        (mm-try "gqa-llama-block-decode-step" (jte-gqa-llama-block-decode-step-msl "f_gds") "f_gds")))
    (print_str "── MSL families, offered to this Mac's Metal compiler ──")
    (mm-report rows)
    (print_str (str_concat "families " (str_concat (int_to_str (len rows))
               (str_concat "   whole " (str_concat (int_to_str (mm-whole rows))
               (str_concat "   unhealed " (str_concat (int_to_str (mm-unhealed rows))
               (str_concat "   released " (int_to_str (mm-released rows))))))))))
    (add (mm-unhealed rows) (mm-released rows)))
