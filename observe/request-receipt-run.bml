// request-receipt-run.bml — one request's receipt, joined by its id from the ledgers themselves.
//
//   echo '{"request":"frq-7c8d9e0f1a2b3c4d"}' | ./fkwu observe/request-receipt-run.bml
//
// Every local voice stream that works for a request names it in its ledger row's who (planner-<id>, planner-guide-<id>,
// planner-lens-*-<id>, planner-repair-<id>, lens-names-<id>, counsel-<id>, repair-manifest-<id>, flow-<id>): the door reads
// receipts/local-run-ledger.jsonl, keeps the rows whose who holds the id, and prints ONE JSON line: each stream's who, model,
// wall_ms, generated_ids, surprise_micro_nats and rent_tokens, the sum of rent_tokens, and the request's last row of
// receipts/local-plan-ledger.jsonl (verdict, kind, repairs, ms, planned). The join is the key, never a time window; the line is
// the ledgers' own, nothing is typed by hand. A stream that carries no id (a request planned before the planner named it)
// is not here: the door says so by counting zero streams, it does not guess one.
// stdin, one JSON line: request (required). Read-only. Run from the repo root.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/draft-ledger.bml
section [form.bml] {
 class RequestReceiptRun {
  def rrr-rows(path) = file_size(path) < 1 ? [] : map(x => parse-json("receipt-row", x), filter(x => (Comparable) len(trim(x)) != 0, split-on(fhn-read(path), "\n")));
  // a ledger field may be null (a row with no who, a row with no model): read it as text only when it is text
  def rrr-str(r, key) { let v = fhn-text(r, key); (String) value_kind(v) == "string" ? v : ""; }
  def rrr-mine(rows, id) = filter(r => str_find(rrr-str(r, "who"), id, 0) >= 0, rows);
  def rrr-stream(r) = json-node-object([fhn-s("who", rrr-str(r, "who")), fhn-s("model", rrr-str(r, "model")), fhn-n("wall_ms", fhn-count(r, "wall_ms")), fhn-n("generated_ids", fhn-count(r, "generated_ids")), fhn-n("surprise_micro_nats", fhn-count(r, "surprise_micro_nats")), fhn-n("rent_tokens", fhn-count(r, "rent_tokens"))]);
  def rrr-end(rows, id) = foldl((acc, r) => (String) fhn-text(r, "request") == id ? r : acc, nothing(), rows);
  def rrr-end-node(r) = nothing?(r) ? json-node-object([]) : json-node-object([fhn-s("verdict", fhn-text(r, "verdict")), fhn-s("kind", fhn-text(r, "kind")), fhn-n("repairs", fhn-count(r, "repairs")), fhn-n("ms", fhn-count(r, "ms")), fhn-n("planned", fhn-count(r, "planned")), fhn-n("rent_tokens", fhn-count(r, "rent_tokens"))]);
  def rrr-say(id) {
   let mine = rrr-mine(rrr-rows("receipts/local-run-ledger.jsonl"), id);
   print_str(json-emit(json-node-object([fhn-s("request", id), fhn-n("streams", len(mine)), json-node-pair("rows", json-node-array(map(r => rrr-stream(r), mine))), fhn-n("rent_tokens", foldl((a, r) => a + fhn-count(r, "rent_tokens"), 0, mine)), json-node-pair("end", rrr-end-node(rrr-end(rrr-rows("receipts/local-plan-ledger.jsonl"), id)))])) ++ "\n");
  }
  def rrr-run() {
   let line = trim(stdin-text());
   let o = (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("receipt-options", line) : json-node-object([]);
   let id = fhn-text(o, "request");
   len(id) == 0 ? print_str("give {\"request\":\"frq-...\"}\n") : rrr-say(id);
  }
 }
 rrr-run();
}
