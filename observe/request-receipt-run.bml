// request-receipt-run.bml — one request's receipt, joined by its id from the ledgers themselves (form-stdlib/bml/request-receipt.bml).
//
//   echo '{"request":"frq-7c8d9e0f1a2b3c4d"}' | ./fkwu observe/request-receipt-run.bml
//
// Prints ONE JSON line: each local voice stream whose ledger who holds the id (planner, planner-guide, lens-names, counsel,
// repair-manifest, flow), its surprise and rent_tokens, and the request's last plan-ledger row. The flow lands the same line
// beside its end row (receipts/request-receipts.jsonl); this door prints it for any request, read-only.
// stdin, one JSON line: request (required). Run from the repo root.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/draft-ledger.bml form-stdlib/bml/request-receipt.bml
section [form.bml] {
 class RequestReceiptRun {
  def rrr-run() {
   let line = trim(stdin-text());
   let o = (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("receipt-options", line) : json-node-object([]);
   let id = fhn-text(o, "request");
   let set = fhn-text(o, "set");
   len(set) > 0 ? print_str(rr-set-line(set) ++ "\n") : len(id) == 0 ? print_str("give {\"request\":\"frq-...\"} or {\"set\":\"answered\"}\n") : print_str(rr-line(id) ++ "\n");
  }
 }
 rrr-run();
}
