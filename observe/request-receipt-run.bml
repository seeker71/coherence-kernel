// request-receipt-run.bml — one request's receipt, or a whole set's, joined by id from the ledgers themselves (form-stdlib/bml/request-receipt.bml).
//
//   echo 'request frq-7c8d9e0f1a2b3c4d' | ./fkwu observe/request-receipt-run.bml
//   echo 'set answered'                 | ./fkwu observe/request-receipt-run.bml
//
// Prints ONE form-rows line (a Form record on a line, no JSON): each local voice stream whose ledger who holds the id (planner,
// planner-guide, lens-names, counsel, repair-manifest, flow), its surprise and rent_tokens, the asks the flow bracketed with the GPU
// registry and their tenants, and the request's last plan-ledger row. `set STATUS` joins every request of that status in
// learn/local-requests.jsonl and sums them: requests, with_streams, keyless (ended before the ledgers keyed their streams),
// streams, surprise, rent_tokens and a row a request. The flow lands the single-request line beside its end row
// (receipts/request-receipts.rows); this door prints either for any request or set, read-only.
// stdin: `request ID` or `set STATUS` (frw-options). Run from the repo root.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/draft-ledger.bml form-stdlib/bml/form-rows.bml form-stdlib/bml/request-receipt.bml
section [form.bml] {
 class RequestReceiptRun {
  def rrr-say(t) = print_str(t ++ "\n");
  def rrr-with(o) {
   let id = frw-get(o, "request");
   let set = frw-get(o, "set");
   !nothing?(set) ? rrr-say(rr-set-line(set)) : nothing?(id) ? rrr-say("give `request ID` or `set STATUS`") : rrr-say(rr-line(id));
  }
  def rrr-run() {
   let o = frw-options(stdin-text() ?? "");
   (String) o[0] != "ok" ? rrr-say("the options were refused at line " ++ o[2].str() ++ ": " ++ o[1]) : rrr-with(o[1]);
  }
 }
 rrr-run();
}
