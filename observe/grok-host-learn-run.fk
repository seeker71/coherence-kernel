; preflight-exec: forbidden
; Record one host Grok pair into a private witness home. Stdout: identities
; only. Does not print prompt or completion. Does not kick the 3B worker.
; stdin: path to a pair json {session,event,prompt,completion}.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/json.fk
; preludes: form-stdlib/native-session-memory.bml
; preludes: form-stdlib/grok-host-learn.fk
(do
    (let input (read_line))
    (let path (if (or (nothing? input) (eq (str_len (trim input)) 0))
        "form/form-stdlib/tests/fixtures/grok-host-pair.json" (trim input)))
    (let home ".hearth/grok-host-learn")
    (fs-mkdir ".hearth")
    (fs-mkdir home)
    (let dir (ghl-record home path))
    (let rec (nsm-json (nsm-at dir "record.json")))
    (print (list "schema" "grok-host-learn-v1"
        "can" (ghl-can)
        "route" (ghl-route)
        "objective" (nsm-str rec "objective")
        "id" (nsm-str rec "id")
        "event" (nsm-str rec "event")
        "kicked" 0
        "prose-stdout" 0))
    1)
