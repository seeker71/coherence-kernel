; form-cli-native-call-census-run.fk — one native form-cli enrich call inside a
; membrane window: which physical planes does the body's own grounding step
; cross? stdin line 1: the exact terms, as the enrich door takes them.
; The window snapshots this process's dispatch counters (kernel_stat) before
; the call and after it; the deltas are the crossings the call itself made.
; The terms are read before the window opens and the report prints after it
; closes, so the observer's own stdio does not enter the count. No prompt,
; model, provider or subprocess is involved.
; witnessed: 2026-09-18 -> observed
; preludes: observe/form-membrane-runtime-census.fk form-stdlib/bml/form-cli-enrich.bml

(do
    (defn fcncc-source () "observe/form-cli-native-call-census-run.fk")
    (defn fcncc-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn fcncc-rows (rows)
        (if (nil? rows) 0
            (do
                (print_str (str_concat "crossing plane="
                    (str_concat (fmrc-delta-plane (head rows))
                    (str_concat " name="
                    (str_concat (fmrc-delta-name (head rows))
                    (str_concat " count="
                    (str_concat (int_to_str (fmrc-delta-count (head rows))) "\n")))))))
                (fcncc-rows (tail rows)))))
    (defn fcncc-planes (planes rows)
        (if (nil? planes) 0
            (do
                (fcncc-line (str_concat "plane-total " (head planes))
                    (int_to_str (fmrc-delta-plane-total rows (head planes))))
                (fcncc-planes (tail planes) rows))))
    (let terms (read_line))
    (let window (fmrc-open "native-form-cli-enrich" "one in-process enrich call"
        (fcncc-source) 31 1))
    (let text (fce-command terms))
    (let result (fmrc-close window "observed" (fcncc-source) 33 1))
    (let rows (fmrc-result-deltas result))
    (fcncc-line "enrichment-bytes" (int_to_str (str_len text)))
    (fcncc-line "census-status" (fmrc-result-status result))
    (fcncc-line "dispatches" (int_to_str (fmrc-delta-total rows)))
    (fcncc-rows rows)
    (fcncc-planes (list "stdio" "filesystem" "local-process"
        "network-address-unknown" "mesh" "metal-device" "mlx-runtime"
        "cpu-jit" "cuda-device" "physical-sense") rows)
    0)
