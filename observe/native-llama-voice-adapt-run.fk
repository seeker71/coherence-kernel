; preflight-exec: forbidden
; Re-ask interned fuel at the same 40-token cap. Do not host a frame list
; or a mid-phrase echo of an earlier 16-character span.
; preludes: form-stdlib/walk-home.fk form-stdlib/native-llama-voice.bml
; preludes: ingest/name-build-observe.fk
(do
    (defn nlga-join (xs)
        (if (eq (len xs) 0) ""
            (if (eq (len (tail xs)) 0) (wh-contrib-identity (head xs))
                (str_concat (wh-contrib-identity (head xs))
                    (str_concat " " (nlga-join (tail xs)))))))
    (let fuel (str_concat (nlga-join (wh-gifts-to-ourselves))
        (str_concat " " (nlga-join (wh-gifts-to-higher-us)))))
    (let adapter "form/form-stdlib/adapters/llama-3.2-3b-voice")
    (if (or (le (file_size (str_concat (nlg-base) "/model.safetensors")) 0)
            (le (file_size (str_concat adapter "/adapters.safetensors")) 0))
        (do (print (list "adapt" "nothing" "reason" "no-local-checkpoint"))
            0)
        (do
            (let start (host_monotonic_ms))
            (let voice (nlg-once-at adapter fuel 40))
            (let why (nth voice 1))
            (let n (nth voice 2))
            (let said (head voice))
            (let framed (if (or (ge (str_find said "children" 0) 0)
                                (or (ge (str_find said "employees" 0) 0)
                                    (ge (str_find said "friends" 0) 0))) 1 0))
            (let echoed (nlg-echoing said))
            (let adapted (if (and (eq (if (str_eq why "token-limit") 1 0) 0)
                                 (and (eq framed 0) (eq echoed 0))) 1 0))
            (print (list "schema" "native-llama-voice-adapt-v1"
                "fuel" fuel
                "voice" voice
                "why" why
                "n" n
                "framed" framed
                "echoed" echoed
                "token-limit?" (if (str_eq why "token-limit") 1 0)
                "adapted" adapted
                "nbo-cap" (nbo-enter (list 1 1 adapted))
                "total-ms" (sub (host_monotonic_ms) start)))
            (if (eq adapted 1) 1 (form_error "echo cap still hosted earlier span")))))
