// form-cli-ask-native-run.bml — one native form-cli call for any enquiry.
//
// stdin line 1: the enquiry, one line. The door draws the enquiry's own terms
// (its longer words, a few connectives dropped), reads the enrich seeds for
// them, indexes receipts whose names carry them (terms matched first, then
// date, newest first), reads the body's latest measured rows, and names what
// is pending; all inside a census window that reports the planes this call
// crossed. Provider 0, oracle 0, calls that leave the body 0. The raw output
// is the answer's ground; prose reasoning across it is the reader's, and the
// native voice's where a model stands.
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class FormCliAskNative {
  def fan-source() = "observe/form-cli-ask-native-run.bml";
  def fan-opening() = 160;
  def fan-min-term() = 5;
  def fan-max-terms() = 12;
  def fan-stop() = list("while", "which", "there", "their", "where", "about", "would", "could", "should", "these", "those", "other", "between", "because", "through", "single", "point", "please", "compare", "versus", "session", "query", "request", "against", "within", "without", "every");
  def fan-punct() = ",.?!:;/()[]{}\"'";
  def fan-strip(word) = if eq(str_len(word), 0) then word else if ge(str_find(fan-punct(), substring(word, sub(str_len(word), 1), str_len(word)), 0), 0) then fan-strip(substring(word, 0, sub(str_len(word), 1))) else if ge(str_find(fan-punct(), substring(word, 0, 1), 0), 0) then fan-strip(substring(word, 1, str_len(word))) else word;
  def fan-member?(xs, x) = if nil?(xs) then 0 else if str_eq(head(xs), x) then 1 else fan-member?(tail(xs), x);
  def fan-terms(words, acc) = if or(nil?(words), ge(len(acc), fan-max-terms())) then acc else {
   let w = fan-strip(trim(head(words)));
   if and(ge(str_len(w), fan-min-term()), and(eq(fan-member?(fan-stop(), w), 0), eq(fan-member?(acc, w), 0))) then fan-terms(tail(words), append(acc, list(w))) else fan-terms(tail(words), acc);
  };
  def fan-join(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else mc-cat(list(head(xs), " ", fan-join(tail(xs))));
  def fan-last-line(path) {
   let lines = fan-nonempty(split-on(fhn-read(path), "\n"));
   if nil?(lines) then "" else fan-last(lines);
  }
  def fan-last(xs) = if nil?(tail(xs)) then head(xs) else fan-last(tail(xs));
  def fan-nonempty(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then fan-nonempty(tail(xs)) else cons(head(xs), fan-nonempty(tail(xs)));
  def fan-planes(planes, rows) = if nil?(planes) then "" else mc-cat(list("  ", head(planes), "=", int_to_str(fmrc-delta-plane-total(rows, head(planes))), "\n", fan-planes(tail(planes), rows)));
  def fan-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh", "metal-device", "mlx-runtime", "cpu-jit", "cuda-device", "physical-sense");
  def fan-run() {
   let line0 = read_line();
   let enquiry = if nothing?(line0) then "" else trim(line0);
   if str_eq(enquiry, "") then print_str("form-cli ask-native | signal=nothing reason=enquiry-required-on-stdin\n") else fan-answer(enquiry);
  }
  def fan-answer(enquiry) {
   let window = fmrc-open("form-cli-ask-native", "one native answer call", fan-source(), 1, 1);
   let terms = fan-terms(split-on(enquiry, " "), list());
   let termLine = fan-join(terms);
   let enrichment = if nil?(terms) then "nothing: no term of five letters or more in the enquiry\n" else fce-command(termLine);
   let index = if nil?(terms) then "" else fgs-index(fgs-top(fgs-rank(fs_list("receipts"), terms), 8), fan-opening());
   let flowRow = fan-last-line("receipts/flow-ledger.jsonl");
   let rentRow = fan-last-line("receipts/rent-ledger.jsonl");
   let text = mc-cat(list(
    "form-cli ask-native | source=native | provider=0 oracle=0 calls-left-the-body=0\n",
    "enquiry: ", enquiry, "\n",
    "terms: ", termLine, "\n\n",
    "[native ground] one in-process enrich reading of the terms\n", enrichment, "\n",
    "[receipts by name] terms matched first, then date, newest first; openings of ", int_to_str(fan-opening()), " bytes\n", index, "\n",
    "[measured] the body's latest rows\n  flow: ", flowRow, "\n  rent: ", rentRow, "\n\n",
    "[pending] prose reasoning across this ground is the reader's; the native voice adds it where a model stands; felt resonance is the person's\n"));
   let result = fmrc-close(window, "observed", fan-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(text);
   print_str(mc-cat(list("[crossings of this call] census-status=", fmrc-result-status(result), " dispatches=", int_to_str(fmrc-delta-total(rows)), "\n", fan-planes(fan-plane-names(), rows))));
  }
 }
 fan-run();
}
