; jit-arm64-u32-leaf-carrier.fk -- Form-owned V1 arm64 leaf request.
;
; This is the successor to the temporary scalar add-one checkout witness.  The
; only native request is (program, root, u32 argument), passed to
; jit_arm64_u32_leaf.  No byte image crosses that public boundary: the carrier
; admits this exact V1 Form tree before it emits its own W^X image.
;
; Darwin/arm64 only.  Unsupported or malformed requests answer nothing.
; No multi-argument, branch, memory, I/O, float, model, resource, or shell path
; is admitted here.
;
; preludes: form-stdlib/core.fk
;
; Proven by: observe/tests/jit-arm64-u32-leaf-carrier-band.fk

(do
    (defn jau-u32? (x)
        (if (and (le 0 x) (le x 4294967295)) 1 0))
    (defn jau-u16? (x)
        (if (and (le 0 x) (le x 65535)) 1 0))
    (defn jau-u12? (x)
        (if (and (le 0 x) (le x 4095)) 1 0))
    (defn jau-child? (x owner)
        (if (le 0 x) (if (lt x owner) 1 0) 0))
    (defn jau-binary-tag? (tag)
        (if (eq tag 3) 1 (if (eq tag 4) 1 (if (eq tag 5) 1 0))))
    (defn jau-addsub-right? (prog tag right)
        (if (or (eq tag 3) (eq tag 4))
            (if (eq (nth (nth prog right) 0) 1)
                (jau-u12? (nth (nth prog right) 1))
                1)
            1))
    ; Exact V1 rows: LIT=[1,imm16], ARG=[2], and ADD/SUB/MUL=[tag,left,right].
    ; Earlier-child ownership makes malformed forward edges and cycles decline
    ; before anything can reach the native carrier or a Form lowerer.
    (defn jau-row? (prog row owner)
        (if (eq (len row) 1)
            (if (eq (nth row 0) 2) 1 0)
            (if (eq (len row) 2)
                (if (eq (nth row 0) 1) (jau-u16? (nth row 1)) 0)
                (if (eq (len row) 3)
                    (if (jau-binary-tag? (nth row 0))
                        (if (jau-child? (nth row 1) owner)
                            (if (jau-child? (nth row 2) owner)
                                (jau-addsub-right? prog (nth row 0) (nth row 2))
                                0)
                            0)
                        0)
                    0))))
    (defn jau-program-loop? (prog rows owner)
        (if (nil? rows)
            1
            (if (jau-row? prog (head rows) owner)
                (jau-program-loop? prog (tail rows) (add owner 1))
                0)))
    (defn jau-program? (prog)
        (if (and (le 1 (len prog)) (le (len prog) 64))
            (jau-program-loop? prog prog 0)
            0))
    (defn jau-request-shape? (prog root arg)
        (if (jau-program? prog)
            (if (and (le 0 root) (lt root (len prog)))
                (jau-u32? arg)
                0)
            0))
    (defn jit-arm64-u32-leaf (prog root arg)
        (if (eq (jau-request-shape? prog root arg) 1)
            (jit_arm64_u32_leaf prog root arg)
            (nothing)))

    ; f(n) = n + 1: ARG · LIT 1 · ADD(ARG,LIT), root=2.
    (defn jau-add1-prog ()
        (list (list 2) (list 1 1) (list 3 0 1)))
    (defn jau-add1 (arg)
        (jit-arm64-u32-leaf (jau-add1-prog) 2 arg))

    ; f(n) = n * 3 + 7: a second Form-authored V1 structural request.
    (defn jau-muladd-prog ()
        (list (list 1 7) (list 2) (list 1 3) (list 5 1 2) (list 3 3 0)))
    (defn jau-muladd (arg)
        (jit-arm64-u32-leaf (jau-muladd-prog) 4 arg))

    0)
