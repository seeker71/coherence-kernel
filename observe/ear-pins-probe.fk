; ear-pins-probe.fk — the six mel and six encoder floats the receipts carry, read back off both
; encode doors so a change to the pass has to answer for them.
; receipts/2026-09-06-the-shape-is-a-word.md: mel[0][0..5] -0.138096 0.33575 0.339695 0.272336
; 0.224791 0.152085; enc[0][0..5] on the 30 s window 0.170423 0.018257 -0.020125 0.121258
; 0.113597 -0.053409.
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn ep-f32 (b i) (do (let bits (en-u32 b i)) (let s (div bits 2147483648)) (let e (mod (div bits 8388608) 256)) (let m (mod bits 8388608)) (if (eq e 0) 0.0 (if (eq e 255) 99999.0 (mul (if (eq s 1) -1.0 1.0) (mul (add 1.0 (div (str_to_float (int_to_str m)) 8388608.0)) (fq-pow2 (sub e 127))))))))
    (defn ep-six (b i n) (if (ge i n) "" (str_concat " " (str_concat (float_to_str (ep-f32 b (mul 4 i))) (ep-six b (add i 1) n)))))
    (defn ep-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (ep-zeros (str_concat s s) n)))
    (defn ep-rep (n acc c) (if (eq n 0) acc (ep-rep (sub n 1) (cons c acc) c)))
    (defn ep-chunks (s i end acc) (if (ge i end) (reverse acc) (ep-chunks s (add i 3200) end (cons (substring s i (add i 3200)) acc))))
    (let snap (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (let st (enw-open (str_concat snap "/weights.npz") (enw-tokenizer-path)))
    (let bytes (en-text (read_file "form/form-stdlib/tests/fixtures/ear-okay-2s.wav")))
    (let pcm (substring bytes 44 (str_len bytes)))
    ; the receipts' own shape: the fixture at the FRONT of a 30 s window
    (let Te30 (enw-encode st (str_concat pcm (ep-zeros (byte_to_str 0) (sub 960000 (str_len pcm))))))
    (print_str (str_concat "Te30=" (int_to_str Te30)))
    (print_str (str_concat "mel[0][0..5] " (ep-six (en-text (metal_buf_read (enw-mel st) 0 24)) 0 6)))
    (print_str (str_concat "enc[0][0..5] " (ep-six (en-text (metal_buf_read (enw-b st 10) 0 24)) 0 6)))
    ; and the same 30 s window handed in pieces: the fixture's OWN successive 3200-byte chunks
    ; (not one chunk repeated — that is different audio and answers differently, correctly so),
    ; then silence to fill the window
    (let parts (append (ep-chunks pcm 0 (str_len pcm) (list)) (ep-rep 280 (list) (ep-zeros (byte_to_str 0) 3200))))
    (let TeP (enw-encode-parts st parts 960000))
    (print_str (str_concat "in pieces Te=" (int_to_str TeP)))
    (print_str (str_concat "mel[0][0..5] " (ep-six (en-text (metal_buf_read (enw-mel st) 0 24)) 0 6)))
    (print_str (str_concat "enc[0][0..5] " (ep-six (en-text (metal_buf_read (enw-b st 10) 0 24)) 0 6)))
    (print 0))
