; Bounded framebuffer exchange for the IQ3_XXS band's malformed c6 condition.
; Payloads contain only syntax counts and verdicts; no prompt or answer content.
import "../form/form-stdlib/core.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let failed (bfc-envelope 0 4311 0 (list 1 1 0) 4311099))
  (let revise (bfc-control failed 2))
  (bfc-record-out failed 1)
  (bfc-record-in revise 2)
  ; The authority check had put witness 64 inside a four-arm `if`, leaving
  ; iq3xb-bit without its bit argument. The repair restores the three-arm
  ; conditional and passes 64 as iq3xb-bit's second argument.
  (let healed (bfc-envelope 0 4312 0 (list 0 0 127) 4312099))
  (let continue (bfc-control healed 0))
  (bfc-record-out healed 3)
  (bfc-record-in continue 4)
  (list "iq3xxs-dequant-syntax-diagnostic"
    (list "observed-depth" 1 "compile-errors" 1 "verdict" 0)
    (list "selected-action" (bfc-payload revise)
          "repair-node" (bfc-apply failed revise 4311202 4311205))
    (list "reobserved-depth" 0 "compile-errors" 0 "verdict" 127
          "selected-action" (bfc-payload continue)
          "healthy-node" (bfc-apply healed continue 4312000 4312005))
    (list "framebuffer-events" (len (framebuffer-events)))))
