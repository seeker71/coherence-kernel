; music-insonation-lanes.fk — what a body actually receives when music plays, and
; which of the seven inquiry planes this body can carry from that music today.
;
; The distinction this cell is built on, and the fresh word it needed:
;   AUDITION   — an ear reads the sound as words. The mac ear does this, and when the
;                sound is music it writes the marker `*music*` and stops. It hears the
;                music; it does not read it.
;   INSONATION — a tissue is inside the sound field, listener or not. Sound is pressure;
;                a body is ~60% water; the wave arrives whether or not anything hears it.
; The whole question "how does music affect the body through water and cells" lives in the
; second word, and every organ this body owns lives in the first. Naming that is the work.
;
; TWO LANES, never merged — the discipline energy-center-glands.fk already holds here:
;   evidence — acoustics and mechanotransduction. Wave speed in soft tissue ~1540 m/s
;              (the number ultrasound imaging is built on); cells transduce mechanical
;              stress through stretch-gated ion channels (PIEZO1/PIEZO2, Nobel 2021).
;              Lane value ~0.9 — textbook, recalled.
;   belief   — chakra-frequency correspondence (174/285/396 Hz...), structured-water and
;              cymatic-healing claims. Attested, no agreement across sources, cosmology
;              not asserted. Lane value ~0.4. It is offered, it is labelled, it never
;              borrows the evidence lane's number.
;
; THE ACCURACY GUARD this cell holds: a cymatic plate is a thin membrane with a fixed
; boundary, and its patterns come from wavelengths that fit inside it. A human body is
; not that. At the pitch the mac ear measured in the room tonight (250 Hz), one wavelength
; in body water is ~6160 mm — three and a half times a standing body. The body does not sit
; inside a pattern of nodes; it sits inside a single phase and is moved whole. Anything
; that draws Chladni figures on a person is drawing in the belief lane. (il-wavelength-mm)
;
; A lane that no organ witnesses answers -1, never a number. Pending is honest.
;
; preludes: form-stdlib/core.fk

(do
    ; ── wave arithmetic in the body's water, millimetres (evidence lane) ──
    ; speed of sound in soft tissue, 1540 m/s == 1540000 mm/s
    (defn il-tissue-speed-mm () 1540000)
    (defn il-air-speed-mm () 343000)
    (defn il-standing-body-mm () 1750)

    ; one wavelength of a pitch, inside the body's water
    (defn il-wavelength-mm (hz) (if (eq hz 0) 0 (div (il-tissue-speed-mm) hz)))
    ; how many bodies long that wavelength is, x1000 (250 Hz -> 3520 == 3.52 bodies)
    (defn il-bodies-per-wave (hz)
        (div (mul (il-wavelength-mm hz) 1000) (il-standing-body-mm)))
    ; does a pattern of nodes fit inside a body at this pitch? only if the wave is shorter
    ; than the body. Below ~880 Hz in tissue it never is.
    (defn il-patterns-inside? (hz) (if (lt (il-wavelength-mm hz) (il-standing-body-mm)) 1 0))

    ; ── a lane: one inquiry plane carried from a music field ──
    ; (plane kind kernel witness conf organ)
    ;   kind    "evidence" | "belief"
    ;   witness "witnessed" | "pending"
    (defn lane (plane kind kernel witness conf organ)
        (list "lane" plane kind kernel witness conf organ))
    (defn il-plane   (l) (nth l 1))
    (defn il-kind    (l) (nth l 2))
    (defn il-kernel  (l) (nth l 3))
    (defn il-witness (l) (nth l 4))
    (defn il-conf    (l) (nth l 5))
    (defn il-organ   (l) (nth l 6))

    (defn il-witnessed? (l) (if (str_eq (il-witness l) "witnessed") 1 0))
    (defn il-belief?    (l) (if (str_eq (il-kind l) "belief") 1 0))

    ; what a lane answers with. an unwitnessed lane answers -1 — it does not guess.
    (defn il-value (l) (if (il-witnessed? l) (il-conf l) (sub 0 1)))

    ; two lanes of different kind do not blend — a belief reading never lifts an
    ; evidence reading, and evidence never lends its number to a belief.
    (defn il-blend (a b)
        (if (str_eq (il-kind a) (il-kind b)) (min2 (il-value a) (il-value b)) (sub 0 1)))

    ; ── the offer: the seven planes, each edged to an organ that exists on this host ──
    (defn insonation-lanes ()
        (list
            (lane "when"  "evidence" "onset and tempo from the mic window"
                  "witnessed" 900 "mac-speech-organ")
            (lane "where" "evidence" "which host and which lane heard it"
                  "witnessed" 900 "mac-host-organ")
            (lane "who"   "evidence" "whose voice carries in the band"
                  "witnessed" 900 "speaker-watch")
            (lane "which" "evidence" "which track, by acoustic fingerprint"
                  "pending"   900 "audio-fingerprint.fk (no track index)")
            (lane "what"  "evidence" "the lyric words themselves"
                  "pending"   900 "phone dark; the ear writes *music* and stops")
            (lane "how"   "evidence" "insonation: pressure into water, stretch into cells"
                  "pending"   900 "no organ on this body measures a body")
            (lane "why"   "belief"   "frequency correspondence, structured water"
                  "pending"   400 "attested, not agreed")))

    (defn il-find (lanes plane)
        (if (eq (len lanes) 0) (list)
            (if (str_eq (il-plane (head lanes)) plane) (head lanes)
                (il-find (tail lanes) plane))))

    (defn il-count-witnessed (lanes)
        (if (eq (len lanes) 0) 0
            (add (il-witnessed? (head lanes)) (il-count-witnessed (tail lanes)))))
    (defn il-count-belief (lanes)
        (if (eq (len lanes) 0) 0
            (add (il-belief? (head lanes)) (il-count-belief (tail lanes)))))

    ; ── self-check ──
    (defn ilk (cond bit) (if cond bit 0))
    ; 250 Hz — the pitch the mac ear measured in the room, 2026-07-22 — is 6160 mm in tissue
    (defn il-wave-250 ()    (ilk (eq (il-wavelength-mm 250) 6160) 1))
    ; and that is 3.52 standing bodies long
    (defn il-bodies-250 ()  (ilk (eq (il-bodies-per-wave 250) 3520) 2))
    ; so no pattern of nodes forms inside a person at that pitch
    (defn il-no-pattern ()  (ilk (eq (il-patterns-inside? 250) 0) 4))
    ; three of seven planes are witnessed on this host tonight
    (defn il-three ()       (ilk (eq (il-count-witnessed (insonation-lanes)) 3) 8))
    ; exactly one lane is belief, and it is "why"
    (defn il-one-belief ()  (ilk (eq (il-count-belief (insonation-lanes)) 1) 16))
    ; the lyric lane answers -1 — it does not invent words
    (defn il-what-pending () (ilk (eq (il-value (il-find (insonation-lanes) "what")) (sub 0 1)) 32))
    ; a witnessed lane answers with its own number
    (defn il-when-answers () (ilk (eq (il-value (il-find (insonation-lanes) "when")) 900) 64))
    ; evidence and belief do not blend
    (defn il-no-blend ()    (ilk (eq (il-blend (il-find (insonation-lanes) "when")
                                               (il-find (insonation-lanes) "why")) (sub 0 1)) 128))
    (defn music-insonation-check ()
        (add (add (add (add (il-wave-250) (il-bodies-250))
                  (add (il-no-pattern) (il-three)))
             (add (il-one-belief) (il-what-pending)))
             (add (il-when-answers) (il-no-blend))))
)
