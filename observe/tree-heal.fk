; tree-heal.fk — closing the forms that came apart.
;
; observe/tree-balance.fk names the cells whose forms do not close. Naming them
; is where the work stops being mine and starts being someone else's, so this
; cell does it: it looks for where the form came apart, closes it there, and
; asks the kernel whether the cell reads now.
;
; It puts the bytes back untouched unless the kernel is satisfied — zero
; diagnostics, exit 0, and the cell's band answering if it has one. So the edit
; is never the evidence; the reading is. That is what makes it safe to leave
; running: the quietest thing it can do is nothing.
;
; A cell may ask to be left open. `; DO NOT REPAIR: <why>` in its own head, and
; this cell leaves it whole and hands back the reason it gave. Some forms are
; open on purpose — a wound a band is built around, a lane still pending.
;
; WHERE IT LOOKS. A form that came apart shows up as depth drifting between one
; top-level definition and the next, so those are the places tried, in order,
; and the end of the file last. Three times by hand this week, now once.
;
; WHAT IT DOES NOT REACH, found on itself. Asked to close its own band — where
; the closer was missing inside a nine-term fold rather than between
; definitions — it tried, nothing satisfied the kernel, and it put the file
; back. That band was closed by hand. It tends the shape it can find and leaves
; the rest exactly as they were.
;
; Balance is not structure, which is why the reading decides and not the count:
; neutral-rule-mdl-admission.fk balanced, parsed, and died until the closer
; moved from the `(list ...)` tail to the `(let ...)` it belonged to.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the loop compiles through host-exec.
;
; USE
;   (th-heal "path/to/cell.fk")   ; 1 closed, 0 left as it was
;   (th-report)                   ; every open cell, and what happened to it
;
; preludes: form-stdlib/core.fk observe/tree-balance.fk

(do
    (defn th-run (cmd) (host-exec (str_concat cmd " 2>&1") ""))
    (defn th-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (th-cat (tail xs)))))
    (defn th-sub (s mark v)
        (do (let i (str_find s mark 0))
            (if (lt i 0) s
                (str_concat (substring s 0 i)
                    (str_concat v (substring s (add i (str_len mark)) (str_len s)))))))

    ;; ── asking the kernel ───────────────────────────────────────────
    ;; Fresh, always. A warm cache answers with a tally and drops the name, so a
    ;; closer could be kept on the strength of a run that never happened.
    (defn th-artifacts (p)
        (do (th-run (th-cat (list "rm -f " (th-sub p ".fk" ".fkb") " " (th-sub p ".fk" ".sym")))) 1))
    (defn th-compiles? (p)
        (do (th-artifacts p)
            (let out (th-run (th-cat (list "./fkwu " p " >/dev/null 2>/tmp/th.err; echo rc=$?; cat /tmp/th.err"))))
            (if (lt (str_find out "rc=0" 0) 0) 0
                (if (ge (str_find out "error" 0) 0) 0 1))))

    ;; a cell's band, if it has one: tests/<name>-band.fk beside it
    (defn th-band-path (p)
        (do (let i (str_find p "/" 0))
            (th-run (th-cat (list "d=$(dirname " p "); b=$(basename " p " .fk); "
                                  "f=$d/tests/$b-band.fk; [ -f \"$f\" ] && printf %s \"$f\"")))))
    (defn th-band-ok? (p)
        (do (let b (th-band-path p))
            (if (eq (str_len b) 0) 1
                (do (th-artifacts b)
                    (let out (th-run (th-cat (list "./fkwu " b " >/dev/null 2>&1; echo rc=$?"))))
                    (if (ge (str_find out "rc=0" 0) 0) 1 0)))))
    ;; The kernel reading the cell is the answer here, never the paren count.
    (defn th-accepts? (p) (if (eq (th-compiles? p) 1) (th-band-ok? p) 0))

    ;; ── where a form leaked ─────────────────────────────────────────
    ;; the byte offset at the end of each line whose top-level entry depth is
    ;; not 1 — the drift points, in order, then the end of file
    (defn th-eol (s i n)
        (if (ge i n) n (if (str_eq (substring s i (add i 1)) "\n") i (th-eol s (add i 1) n))))
    ;; THE DRIFT IS DETECTED ONE LINE LATE, and the repair belongs to the line
    ;; before it. The depth is read at the START of each top-level defn; the
    ;; defn that LEAKED is the previous one, so its end — `lastend` — is the
    ;; candidate, not the position where the drift was noticed. The first
    ;; version proposed the noticing line and healed nothing: every candidate
    ;; was one form too late, every candidate was reverted, and the file came
    ;; back untouched. The reading was doing its work; the search was not yet.
    (defn th-scan (s i n d instr acc prev lastend)
        (if (ge i n) acc
            (do (let e (th-eol s i n))
                (let line (substring s i e))
                (let d2 (tb-depth-loop line 0 (str_len line) d instr))
                (let top (if (ge (str_find line "(defn " 0) 0) 1 0))
                (th-scan s (add e 1) n d2 0
                    (if (eq top 1) (if (eq d prev) acc (cons lastend acc)) acc)
                    (if (eq top 1) d prev)
                    e))))
    (defn th-drifts (p)
        (do (let s (read_file p)) (th-scan s 0 (str_len s) 0 0 (list) 1 0)))

    (defn th-insert (s at) (str_concat (substring s 0 at) (str_concat ")" (substring s at (str_len s)))))

    ;; ── one cell ────────────────────────────────────────────────────
    (defn th-try-loop (p orig ps)
        (if (eq (len ps) 0) (do (write_file p orig) 0)
            (do (write_file p (th-insert orig (head ps)))
                (if (eq (th-accepts? p) 1) 1 (th-try-loop p orig (tail ps))))))

    ;; ── a cell asking to be left open ──────────────────────────────
    ;; Some forms are open on purpose. A cell says so in its own head and this
    ;; one leaves it whole, handing back the reason it gave rather than a
    ;; silence someone would have to go and look up.
    (defn th-stays-open? (p)
        (do (let s (read_file p))
            (if (ge (str_find s "; DO NOT REPAIR:" 0) 0) 1 0)))
    (defn th-stays-open-why (p)
        (do (let s (read_file p))
            (let i (str_find s "; DO NOT REPAIR:" 0))
            (if (lt i 0) ""
                (do (let b (add i (str_len "; DO NOT REPAIR:")))
                    (substring s b (th-eol s b (str_len s)))))))
    ;; TWO THINGS TO KNOW FIRST, both taught by the band on its first run.
    ;;
    ;; A cell whose forms already close is not a cell to tend. Without that,
    ;; this tried closers on a whole cell and one was kept — it had landed at
    ;; the end of the `; preludes:` comment, where a stray `)` is invisible to
    ;; the reader. The cell compiled, the reading came back fine, and a repair
    ;; was reported that had repaired nothing. An edit that touches nothing
    ;; passes every reading there is.
    ;;
    ;; And nothing is tried inside a comment. A place the reader never reads
    ;; will absorb any closer and leave the real opening exactly where it was.
    (defn th-in-comment? (s at)
        (do (let ls (th-line-start s at))
            (let line (substring s ls at))
            (if (ge (str_find line ";" 0) 0) 1 0)))
    (defn th-line-start (s at)
        (if (le at 0) 0
            (if (str_eq (substring s (sub at 1) at) "\n") at (th-line-start s (sub at 1)))))
    (defn th-keep (s ps)
        (if (eq (len ps) 0) (list)
            (if (eq (th-in-comment? s (head ps)) 1) (th-keep s (tail ps))
                (cons (head ps) (th-keep s (tail ps))))))
    (defn th-heal (p)
        (do (let orig (read_file p))
            (if (eq (th-stays-open? p) 1) 0
            (if (eq (tb-depth p) 0) 0
                (th-try-loop p orig
                    (th-keep orig (append (th-drifts p) (list (str_len orig)))))))))

    ;; ── every unbalanced cell ───────────────────────────────────────
    (defn th-line-at (s i n) (substring s i (th-eol s i n)))
    (defn th-after-tab (l)
        (do (let i (str_find l "\t" 0)) (if (lt i 0) l (substring l (add i 1) (str_len l)))))
    (defn th-sweep-loop (s i n healed left names)
        (if (ge i n) (list healed left names)
            (do (let l (th-line-at s i n))
                (let nx (add (th-eol s i n) 1))
                (if (eq (str_len l) 0) (th-sweep-loop s nx n healed left names)
                    (do (let p (th-after-tab l))
                        (if (eq (th-heal p) 1)
                            (th-sweep-loop s nx n (add healed 1) left
                                (str_concat names (str_concat "  healed  " (str_concat p "\n"))))
                            (th-sweep-loop s nx n healed (add left 1)
                                (str_concat names (str_concat "  left    " (str_concat p "\n"))))))))))
    (defn th-sweep () (do (let s (tb-list)) (th-sweep-loop s 0 (str_len s) 0 0 "")))
    (defn th-report ()
        (do (let r (th-sweep))
            (th-cat (list "tree-heal\n  healed  " (int_to_str (nth r 0))
                          "\n  left    " (int_to_str (nth r 1))
                          "\n" (nth r 2)))))

    0)
