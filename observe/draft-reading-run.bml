// draft-reading-run.bml — our reading of the body's drafts: the one judge the numbers do not replace.
//
// Empty stdin lists the drafts still pending in receipts/draft-ledger.jsonl (id, the draft's path) so they can
// be read. Lines "<id> accepted|revised|rejected [note]" record the reading as rows beside the draft's own; the
// latest reading of a draft is its reading, and docs/local-agent-goal.form's LOCAL SHARE bit counts them.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftReading {
  def dr-ledger() = "receipts/draft-ledger.jsonl";
  def dr-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def dr-nonempty(xs) = if nil?(xs) then list() else if eq(str_len(trim(head(xs))), 0) then dr-nonempty(tail(xs)) else cons(head(xs), dr-nonempty(tail(xs)));
  def dr-parse(xs) = if nil?(xs) then list() else cons(parse-json("draft-row", head(xs)), dr-parse(tail(xs)));
  def dr-rows() = if lt(file_size(dr-ledger()), 1) then list() else dr-parse(dr-nonempty(split-on(fhn-read(dr-ledger()), "\n")));
  def dr-latest(id, rows, acc) = if nil?(rows) then acc else dr-latest(id, tail(rows), if str_eq(dr-str(head(rows), "draft"), id) then dr-str(head(rows), "reading") else acc);
  // a redraft is the same draft: only its latest path row is listed
  def dr-later(id, rows) = if nil?(rows) then 0 else if and(str_eq(dr-str(head(rows), "draft"), id), gt(str_len(dr-str(head(rows), "path")), 0)) then 1 else dr-later(id, tail(rows));
  def dr-list(rows, all) = if nil?(rows) then 0 else dr-list-next(if and(gt(str_len(dr-str(head(rows), "path")), 0), and(eq(dr-later(dr-str(head(rows), "draft"), tail(rows)), 0), str_eq(dr-latest(dr-str(head(rows), "draft"), all, ""), "pending"))) then print_str(mc-cat(list(dr-str(head(rows), "draft"), "  ", dr-str(head(rows), "path"), "\n"))) else 0, tail(rows), all);
  def dr-list-next(done, rest, all) = dr-list(rest, all);
  def dr-word?(w) = or(str_eq(w, "accepted"), or(str_eq(w, "revised"), str_eq(w, "rejected")));
  def dr-record(line) {
   let parts = split-on(trim(line), " ");
   let id = head(parts);
   let reading = if lt(len(parts), 2) then "" else nth(parts, 1);
   let note = if lt(len(parts), 3) then "" else trim(substring(trim(line), add(add(str_len(id), str_len(reading)), 2), str_len(trim(line))));
   if not(dr-word?(reading)) then print_str(mc-cat(list("[reading] not recorded (use accepted, revised or rejected): ", line, "\n"))) else dr-land(id, reading, note);
  }
  def dr-land(id, reading, note) {
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-s("reading", reading), fhn-s("note", note)));
   let appended = fhn-append(dr-ledger(), str_concat(json-emit(row), "\n"));
   print_str(mc-cat(list("[reading] ", id, " ", reading, "\n")));
  }
  def dr-lines(n) { let l = read_line(); if nothing?(l) then n else if eq(str_len(trim(l)), 0) then dr-lines(n) else dr-lines-next(dr-record(l), n); }
  def dr-lines-next(done, n) = dr-lines(add(n, 1));
  def dr-run() {
   let n = dr-lines(0);
   if eq(n, 0) then dr-list(dr-rows(), dr-rows()) else 0;
  }
 }
 dr-run();
}
