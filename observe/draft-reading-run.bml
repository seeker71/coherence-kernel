// draft-reading-run.bml — our reading of the body's drafts: the one judge the numbers do not replace.
//
// Empty stdin lists the drafts still pending for us in receipts/draft-ledger.jsonl (id, the draft's path) so they can
// be read: this list reads our readings alone, and a native reading of a draft is a second reader beside it
// (form-stdlib/bml/draft-ledger.bml, the one reader and writer of the ledger's rows). Lines
// "<id> accepted|revised|rejected [note]" record the reading as rows beside the draft's own; the latest reading of a
// draft is its reading, and docs/local-agent-goal.form's drafts-read reading counts them. A first line
// {"ledger":"<path>"} reads and writes that ledger in place of the body's (the band's lane; door-options: an unknown key
// is refused by name).
// preflight-exec: forbidden
// preludes: form-stdlib/bml/draft-ledger.bml form-stdlib/bml/door-options.bml
section [form.bml] {
 class DraftReading {
  def dr-door() = "draft-reading";
  def dr-spec() = [["ledger", "str"]];
  def dr-options?(line) = (len(trim(line)) > 0) && ((Comparable) str_byte_at(trim(line), 0) == 123);
  def dr-ledger-of(line) {
   let opts = dop-doc(dr-door(), line, dr-spec());
   (Comparable) len(fhn-text(opts, "ledger")) > 0 ? fhn-text(opts, "ledger") : dl-ledger();
  }
  def dr-list(ledger) {
   let said = map(d => print_str(dl-id(d) ++ "  " ++ fhn-text(d, "path") ++ "\n"), dl-pending(dl-of-record(dl-rows(ledger))));
   0;
  }
  def dr-record(ledger, line) {
   let parts = split-on(trim(line), " ");
   let id = parts[0];
   let reading = len(parts) < 2 ? "" : parts[1];
   let note = len(parts) < 3 ? "" : trim(substring(trim(line), (len(id) + len(reading)) + 2, len(trim(line))));
   !dl-word?(reading) ? print_str("[reading] not recorded (use accepted, revised or rejected): " ++ line ++ "\n") : dr-land(ledger, id, reading, note);
  }
  def dr-land(ledger, id, reading, note) {
   let appended = dl-land(ledger, id, reading, note, []);
   print_str("[reading] " ++ id ++ " " ++ reading ++ "\n");
  }
  def dr-count(ledger, line, n) = (Comparable) len(trim(line)) == 0 ? n : dr-counted(dr-record(ledger, line), n);
  def dr-counted(done, n) = n + 1;
  def dr-lines(ledger, n) { let l = read_line(); nothing?(l) ? n : dr-lines(ledger, dr-count(ledger, l, n)); }
  def dr-run() {
   let first = read_line();
   let named = !nothing?(first) && dr-options?(first);
   let ledger = named ? dr-ledger-of(first) : dl-ledger();
   let n = dr-lines(ledger, nothing?(first) || named ? 0 : dr-count(ledger, first, 0));
   (Comparable) n == 0 ? dr-list(ledger) : 0;
  }
 }
 dr-run();
}
