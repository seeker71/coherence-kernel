// draft-reading-run.bml — our reading of the body's drafts: the one judge the numbers do not replace.
//
// Empty stdin lists the drafts still pending in receipts/draft-ledger.jsonl (id, the draft's path) so they can
// be read. Lines "<id> accepted|revised|rejected [note]" record the reading as rows beside the draft's own; the
// latest reading of a draft is its reading, and docs/local-agent-goal.form's drafts-read reading counts them.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftReading {
  def dr-ledger() = "receipts/draft-ledger.jsonl";
  def dr-nonempty(xs) = nil?(xs) ? [] : (Comparable) len(trim(xs[0])) == 0 ? dr-nonempty(xs[1:]) : cons(xs[0], dr-nonempty(xs[1:]));
  def dr-parse(xs) = xs |> map(x => parse-json("draft-row", x));
  def dr-rows() = file_size(dr-ledger()) < 1 ? [] : dr-parse(dr-nonempty(split-on(fhn-read(dr-ledger()), "\n")));
  def dr-latest(id, rows, acc) = nil?(rows) ? acc : dr-latest(id, rows[1:], (String) fhn-text(rows[0], "draft") == id ? fhn-text(rows[0], "reading") : acc);
  // a redraft is the same draft: only its latest path row is listed
  def dr-later(id, rows) = nil?(rows) ? 0 : ((String) fhn-text(rows[0], "draft") == id) && (len(fhn-text(rows[0], "path")) > 0) ? 1 : dr-later(id, rows[1:]);
  def dr-list(rows, all) = nil?(rows) ? 0 : dr-list-next((len(fhn-text(rows[0], "path")) > 0) && (((Comparable) dr-later(fhn-text(rows[0], "draft"), rows[1:]) == 0) && ((String) dr-latest(fhn-text(rows[0], "draft"), all, "") == "pending")) ? print_str(fhn-text(rows[0], "draft") ++ "  " ++ fhn-text(rows[0], "path") ++ "\n") : 0, rows[1:], all);
  def dr-list-next(done, rest, all) = dr-list(rest, all);
  def dr-word?(w) = ((String) w == "accepted") || (((String) w == "revised") || ((String) w == "rejected"));
  def dr-record(line) {
   let parts = split-on(trim(line), " ");
   let id = parts[0];
   let reading = len(parts) < 2 ? "" : parts[1];
   let note = len(parts) < 3 ? "" : trim(substring(trim(line), (len(id) + len(reading)) + 2, len(trim(line))));
   !dr-word?(reading) ? print_str("[reading] not recorded (use accepted, revised or rejected): " ++ line ++ "\n") : dr-land(id, reading, note);
  }
  def dr-land(id, reading, note) {
   let row = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-s("reading", reading), fhn-s("note", note)]);
   let appended = fhn-append(dr-ledger(), json-emit(row) ++ "\n");
   print_str("[reading] " ++ id ++ " " ++ reading ++ "\n");
  }
  def dr-lines(n) { let l = read_line(); nothing?(l) ? n : (Comparable) len(trim(l)) == 0 ? dr-lines(n) : dr-lines-next(dr-record(l), n); }
  def dr-lines-next(done, n) = dr-lines(n + 1);
  def dr-run() {
   let n = dr-lines(0);
   (Comparable) n == 0 ? dr-list(dr-rows(), dr-rows()) : 0;
  }
 }
 dr-run();
}
