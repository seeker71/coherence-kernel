// draft-reading-run.bml — our reading of the body's drafts: the one judge the numbers do not replace.
//
// Empty stdin lists the drafts still pending in receipts/draft-ledger.jsonl (id, the draft's path) so they can
// be read. Lines "<id> accepted|revised|rejected [note]" record the reading as rows beside the draft's own; the
// latest reading of a draft is its reading, and docs/local-agent-goal.form's drafts-read reading counts them.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftReading {
  def dr-ledger() = "receipts/draft-ledger.jsonl";
  def dr-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def dr-nonempty(xs) = nil?(xs) ? list() : (Comparable) str_len(trim(head(xs))) == 0 ? dr-nonempty(tail(xs)) : cons(head(xs), dr-nonempty(tail(xs)));
  def dr-parse(xs) = nil?(xs) ? list() : cons(parse-json("draft-row", head(xs)), dr-parse(tail(xs)));
  def dr-rows() = file_size(dr-ledger()) < 1 ? list() : dr-parse(dr-nonempty(split-on(fhn-read(dr-ledger()), "\n")));
  def dr-latest(id, rows, acc) = nil?(rows) ? acc : dr-latest(id, tail(rows), (String) dr-str(head(rows), "draft") == id ? dr-str(head(rows), "reading") : acc);
  // a redraft is the same draft: only its latest path row is listed
  def dr-later(id, rows) = nil?(rows) ? 0 : ((String) dr-str(head(rows), "draft") == id) && (str_len(dr-str(head(rows), "path")) > 0) ? 1 : dr-later(id, tail(rows));
  def dr-list(rows, all) = nil?(rows) ? 0 : dr-list-next((str_len(dr-str(head(rows), "path")) > 0) && (((Comparable) dr-later(dr-str(head(rows), "draft"), tail(rows)) == 0) && ((String) dr-latest(dr-str(head(rows), "draft"), all, "") == "pending")) ? print_str(dr-str(head(rows), "draft") ++ "  " ++ dr-str(head(rows), "path") ++ "\n") : 0, tail(rows), all);
  def dr-list-next(done, rest, all) = dr-list(rest, all);
  def dr-word?(w) = ((String) w == "accepted") || (((String) w == "revised") || ((String) w == "rejected"));
  def dr-record(line) {
   let parts = split-on(trim(line), " ");
   let id = head(parts);
   let reading = len(parts) < 2 ? "" : parts[1];
   let note = len(parts) < 3 ? "" : trim(substring(trim(line), (str_len(id) + str_len(reading)) + 2, str_len(trim(line))));
   !dr-word?(reading) ? print_str("[reading] not recorded (use accepted, revised or rejected): " ++ line ++ "\n") : dr-land(id, reading, note);
  }
  def dr-land(id, reading, note) {
   let row = json-node-object(list(fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-s("reading", reading), fhn-s("note", note)));
   let appended = fhn-append(dr-ledger(), json-emit(row) ++ "\n");
   print_str("[reading] " ++ id ++ " " ++ reading ++ "\n");
  }
  def dr-lines(n) { let l = read_line(); nothing?(l) ? n : (Comparable) str_len(trim(l)) == 0 ? dr-lines(n) : dr-lines-next(dr-record(l), n); }
  def dr-lines-next(done, n) = dr-lines(n + 1);
  def dr-run() {
   let n = dr-lines(0);
   (Comparable) n == 0 ? dr-list(dr-rows(), dr-rows()) : 0;
  }
 }
 dr-run();
}
