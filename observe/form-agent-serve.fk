; form-agent-serve.fk — historical external-MLX ask witness, v1, SEEN not
; the resident model path.  The canonical Form-native resident/KV peer is
; observe/form-cli-peer-agent-live.fk; this file remains as the first live
; three-ask/error receipt and should not be mistaken for that foundation.
;
; One resident fkwu process; typed asks arrive through the fifo
; door (the crossing's own discipline — block on the kernel's read, never
; sleep in a poll); the sealed local model answers through the body's
; hands; every exchange lands in a ledger row. Not yet resident-KV (the
; 27B residence join is a sibling's seam); the 3B fused lineage answers in
; ~1.6s per ask, which is a collaboration partner today rather than a
; faster one tomorrow.
;
; The reply contract is three-state at the door: an ask the model answers
; is text; an ask the model declines is "nothing" (its own trained word);
; a generate that never launched (the popen seam) is @launch-failure — a
; spoken token, never silence read as an answer.
;
; preludes: form-stdlib/core.fk
(do
    (defn fas-model ()
        "/Users/ursmuff/.coherence-network/form-train-runs/form-llama-3b-fused-authoring-20260826")
    (defn fas-fifo () "/tmp/form-agent/ask.fifo")
    (defn fas-ledger () "/tmp/form-agent/ledger.txt")
    (defn fas-shq-loop (s i n acc)
        (if (ge i n) acc
            (fas-shq-loop s (add i 1) n
                (str_concat acc (if (eq (str_byte_at s i) 39) "'\\''" (byte_to_str (str_byte_at s i)))))))
    (defn fas-shq (s) (str_concat "'" (str_concat (fas-shq-loop s 0 (str_len s) "") "'")))
    (defn fas-trim (s)
        (if (eq (str_len s) 0) s
            (if (eq (str_byte_at s (sub (str_len s) 1)) 10)
                (fas-trim (substring s 0 (sub (str_len s) 1))) s)))

    (defn fas-answer (ask)
        (do (let out (host-exec (str_concat
                "/Users/ursmuff/.local/bin/mlx_lm.generate --model "
                (str_concat (fas-model)
                (str_concat " --max-tokens 60 --temp 0 --prompt "
                (str_concat (fas-shq (str_concat
                    "You are form-agent, resident peer of the coherence-kernel body. Answer briefly and honestly; if the body does not hold an answer, reply exactly: nothing. Ask: " ask))
                " 2>/dev/null | awk '/^==========/{f=!f;next} f'; printf @done")))) ""))
            (if (lt (str_find out "@done" 0) 0) "@launch-failure"
                (fas-trim (substring out 0 (str_find out "@done" 0))))))

    (defn fas-append (line)
        (do (let prev (read_file (fas-ledger)))
            (write_file (fas-ledger)
                (str_concat (if (nothing? prev) "" prev) (str_concat line "\n")))))

    (defn fas-serve (n)
        (if (le n 0) (print "agent: ask budget spent; resting\n")
            (do (let ask (read_file (fas-fifo)))
                (if (nothing? ask) (print "agent: fifo closed; resting\n")
                    (do (let a (fas-trim ask))
                        (if (str_eq a "@rest")
                            (print "agent: asked to rest; resting\n")
                            (do (let ans (fas-answer a))
                                (fas-append (str_concat "ask: " (str_concat a
                                    (str_concat "\nanswer: " ans))))
                                (print (str_concat "served: " (str_concat a
                                    (str_concat " -> " (str_concat ans "\n")))))
                                (fas-serve (sub n 1)))))))))

    ; probe mode: preflight RUNS cells, and a blocking server would block the
    ; prover — touch /tmp/form-agent/probe and the cell proves its door then
    ; rests instead of serving
    (let probing (ge (file_size "/tmp/form-agent/probe") 0))
    (let mk (host-exec "mkdir -p /tmp/form-agent && rm -f /tmp/form-agent/ask.fifo && mkfifo /tmp/form-agent/ask.fifo && printf ready" ""))
    (if (lt (str_find mk "ready" 0) 0) (print "FAIL: fifo door could not open\n")
        (if (eq probing 1) (print "probe: door opens, cell compiles, serving skipped\n")
            (do (print "form-agent: resident; door /tmp/form-agent/ask.fifo; ledger /tmp/form-agent/ledger.txt\n")
                (fas-serve 12))))
    0)
