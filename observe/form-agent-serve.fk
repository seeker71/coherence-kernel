// Native 3B FIFO peer. The model and tokenizer remain resident between asks.
// /tmp/form-agent/model.txt contains MODEL or MODEL|ADAPTER. A changed model
// or newly published adapter generation is admitted before the next ask.
// @rest releases the owners. There is no fixed request or generation budget.
// preflight-exec: forbidden
import form-stdlib/native-llama-voice.bml;
import learn/train-loop-local-paths.fk;
section [form.bml] {
    def fas-spec() = {
        let text = read_file("/tmp/form-agent/model.txt");
        let parts = split-on(nothing?(text) ? tlp-authoring-fused() : trim(text), "|");
        [nfg-resolve(parts[0]), len(parts) > 1 ? nag-resolve(parts[1]) : ""];
    };
    def fas-answer(session, ask) = nlg-ask(session, ("You are form-agent, resident peer of the coherence-kernel body. Answer briefly and honestly; if the body does not hold an answer, reply exactly: nothing. Ask: " + ask), 0, "/tmp/form-agent/answer.stream", "/tmp/form-agent/cancel", "/tmp/form-agent/events.jsonl");
    def fas-serve(session, spec) = {
        let ask = read_file("/tmp/form-agent/ask.fifo");
        nothing?(ask) || (String) trim(ask) == "@rest" ? nlg-close(session) : fas-admit(session, spec, fas-spec(), trim(ask));
    };
    def fas-admit(session, old, current, ask) = (Value) old == current ? fas-reply(session, current, ask) : {
        nlg-close(session);
        fas-reply(nlg-open(current[0], current[1]), current, ask);
    };
    def fas-reply(session, spec, ask) = {
        let cleared = write_file_text("/tmp/form-agent/answer.stream", "");
        let result = fas-answer(session, ask);
        let line = (((Comparable) len(result[1]) == 0 ? "answer: " : ("partial reason=" + (result[1] + " answer: "))) + (result[0] + "\n"));
        sbt-append("/tmp/form-agent/ledger.txt", line);
        print_str(line);
        fas-serve(session, spec);
    };
    fs-mkdir("/tmp/form-agent");
    fs_mkfifo("/tmp/form-agent/ask.fifo") < 0 ? form_error("native peer FIFO unavailable") : {
        let spec = fas-spec();
        fas-serve(nlg-open(spec[0], spec[1]), spec);
    };
    0;
}
