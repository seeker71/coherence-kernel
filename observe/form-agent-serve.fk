; Native 3B FIFO peer. The model and tokenizer remain resident between asks.
; /tmp/form-agent/model.txt contains MODEL or MODEL|ADAPTER. A changed model
; or newly published adapter generation is admitted before the next ask.
; @rest releases the owners. There is no fixed request or generation budget.
; preflight-exec: forbidden
; preludes: form-stdlib/native-llama-voice.bml learn/train-loop-local-paths.fk
(do
 (defn fas-spec ()
  (do (let text (read_file "/tmp/form-agent/model.txt"))
   (let parts (split-on (if (nothing? text) (tlp-authoring-fused) (trim text)) "|"))
   (list (head parts) (if (gt (len parts) 1) (nag-resolve (nth parts 1)) ""))))
 (defn fas-answer (session ask)
  (nlg-ask session (str_concat "You are form-agent, resident peer of the coherence-kernel body. Answer briefly and honestly; if the body does not hold an answer, reply exactly: nothing. Ask: " ask) 0 "/tmp/form-agent/answer.stream" "/tmp/form-agent/cancel" "/tmp/form-agent/events.jsonl"))
 (defn fas-serve (session spec)
  (do (let ask (read_file "/tmp/form-agent/ask.fifo"))
   (if (or (nothing? ask) (str_eq (trim ask) "@rest")) (nlg-close session)
    (fas-admit session spec (fas-spec) (trim ask)))))
 (defn fas-admit (session old current ask)
  (if (value_eq old current) (fas-reply session current ask)
   (do (nlg-close session) (fas-reply (nlg-open (head current) (nth current 1)) current ask))))
 (defn fas-reply (session spec ask)
  (do (let cleared (write_file_text "/tmp/form-agent/answer.stream" ""))
   (let result (fas-answer session ask))
   (let line (str_concat (if (eq (str_len (nth result 1)) 0) "answer: " (str_concat "partial reason=" (str_concat (nth result 1) " answer: "))) (str_concat (head result) "\n")))
   (sbt-append "/tmp/form-agent/ledger.txt" line)
   (print_str line)
   (fas-serve session spec)))
 (fs-mkdir "/tmp/form-agent")
 (if (lt (fs_mkfifo "/tmp/form-agent/ask.fifo") 0) (form_error "native peer FIFO unavailable")
  (do (let spec (fas-spec)) (fas-serve (nlg-open (head spec) (nth spec 1)) spec)))
 0)
