; bind-cost-probe.fk — the binding blob, built and thrown away.
;
; An empty dispatch costs ~5.6 us of wall (dispatch-cost-probe). A generate
; spends ~452 us per dispatch OUTSIDE the GPU and outside the seal. If the
; difference is md-bind16 — Form building a binding blob out of lists for every
; dispatch — this loop will show it without a GPU in the picture at all.
;
; preludes: form-stdlib/core.fk form-stdlib/metal-door.fk

(do
    (defn bcp-loop (d rem acc)
        (if (le rem 0) acc
            (bcp-loop d (sub rem 1) (add acc (str_len (md-bind16 (list d) (list 256) 256 0 0 0))))))
    (defn bcp-run (n)
        (do
            (let d (metal_buf_alloc 4096))
            (let t0 (now_unix_ms))
            (let acc (bcp-loop d n 0))
            (let t1 (now_unix_ms))
            (let ms (sub t1 t0))
            (do (print (str_concat "binds=" (int_to_str n)))
                (print (str_concat "  wall_ms=" (int_to_str ms)))
                (print (str_concat "  us_per_bind=" (int_to_str (if (gt n 0) (div (mul ms 1000) n) 0))))
                (print (str_concat "  checksum=" (int_to_str acc)))
                (print "\n") 0)))
    (let a (bcp-run 1000))
    (let b (bcp-run 10000))
    (let c (bcp-run 20000))
    0)
