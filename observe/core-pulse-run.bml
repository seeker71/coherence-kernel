// core-pulse-run.bml — one ground step, then the core says what moved and what stayed still.
//
// The membrane census is the crossing reading. kernel_stat and kernel_hot_rows
// are the dispatch reading. Stillness here is this window. An organ that did
// not fire is named, and it stays until a wider reading shows it is unused.
// preludes: observe/form-membrane-runtime-census.fk

section [form.bml] {
 class CorePulse {
  def cp-cat(xs) = nil?(xs) ? "" : xs[0] ++ cp-cat(xs[1:]);
  def cp-row(row) = cp-cat(["  ", fmrc-delta-name(row), "  ", fmrc-delta-plane(row), "  ", fmrc-delta-count(row).str(), "\n"]);
  def cp-rows(rows) = nil?(rows) ? "" : cp-row(rows[0]) ++ cp-rows(rows[1:]);
  def cp-hot(cell) = len(cell) < 2 ? "" : cp-cat(["  ", cell[0].str(), "  ", cell[1], "\n"]);
  def cp-hots(rows) = nil?(rows) ? "" : cp-hot(rows[0]) ++ cp-hots(rows[1:]);
  def cp-say() {
   let window = fmrc-open("core-pulse", "ground-step", "observe/core-pulse-run.bml", 1, 1);
   let ground = 40 + 2;
   let sized = file_size("bootstrap/ground.fk");
   let closed = fmrc-close(window, "observed", "observe/core-pulse-run.bml", 2, 1);
   let moved = fmrc-result-deltas(closed);
   let still = fmrc-still(fmrc-window-snapshot(closed[2]), closed[5]);
   let hots = kernel_hot_rows(8);
   print_str(cp-cat([
    "core pulse\n",
    "map: ", fmrc-result-status(closed), "\n",
    "ground: ", ground.str(), "\n",
    "ground file bytes: ", sized.str(), "\n",
    "dispatches: ", kernel_stat(0).str(), "\n",
    "arms that fired: ", kernel_stat(1).str(), "\n",
    "hottest arm: ", kernel_stat(2).str(), "  count ", kernel_stat(3).str(), "\n",
    "hot defns:\n", cp-hots(hots),
    "membrane that moved:\n", cp-rows(moved),
    "membrane still: ", len(still).str(), "\n",
    cp-rows(still)]));
  }
 }
 cp-say();
}
