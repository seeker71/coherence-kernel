// rented-turn-meter-run.fk — the body reads the rented mind's own spend:
// retains one caller-bound BML cursor and sums only appended output_tokens
// after its first baseline. Receipts record the figure; consecutive readings
// give the per-prompt delta. Measure, observe, optimize — pointed at the mind
// that is costing.
// stdin line 1: transcript path — a Codex rollout or a Claude Code transcript.
// decided-through-byte trails rollout-bytes while a row is still being written;
// the next reading starts there and counts that row once, whole.
import form-stdlib/form-cli-movement.bml;
section [form.bml] {
    def rtmr-state-path() = ".form-cli-rented-turn-meter-state";
    def rtmr-measure(path) = {
        let size = file_size(path);
        let prior = rtm-state-from-text(read_file(rtmr-state-path()));
        let start = rtm-state-scan-start(prior, path, size);
        let read = rtm-file-go(path, size, start, rtm-state-base-total(prior, path, size), rtm-state-base-seen(prior, path, size), rtm-chunk());
        let total = read[0];
        let mode = (Comparable) start == 0 ? "baseline" : "delta";
        let saved = write_file_text(rtmr-state-path(), rtm-state-text(rtm-state(path, read[1], total, read[2])));
        print(("session-output-tokens=" + total.str()));
        print(("\nmeter-mode=" + mode));
        print(("\nscanned-from-byte=" + start.str()));
        print(("\ndecided-through-byte=" + read[1].str()));
        print(("\nrollout-bytes=" + size.str()));
        0;
    };
    let path = read_line();
    nothing?(path) ? print_str("signal=nothing reason=transcript-path-required") : (String) path == "" || !fs_exists(path) ? print_str("signal=nothing reason=transcript-unavailable") : rtmr-measure(path);
}
