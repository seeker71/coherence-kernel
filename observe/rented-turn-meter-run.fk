; rented-turn-meter-run.fk — the body reads the rented mind's own spend:
; retains one caller-bound BML cursor and sums only appended output_tokens
; after its first baseline. Receipts record the figure; consecutive readings
; give the per-prompt delta. Measure, observe, optimize — pointed at the mind
; that is costing.
; stdin line 1: transcript path.
; preludes: form-stdlib/form-cli-movement.bml
(do
    (defn rtmr-state-path () ".form-cli-rented-turn-meter-state")
    (let path (read_line))
    (let size (file_size path))
    (let prior (rtm-state-from-text (read_file (rtmr-state-path))))
    (let start (rtm-state-scan-start prior path size))
    (let first (rtm-state-scan-first prior path size))
    (let base (rtm-state-base-total prior path size))
    (let delta (rtm-file-go path size start 0 first))
    (let total (add base delta))
    (let mode (if (eq start 0) "baseline" "delta"))
    (let saved (write_file_text (rtmr-state-path)
        (rtm-state-text (rtm-state path size total))))
    (print (str_concat "session-output-tokens=" (int_to_str total)))
    (print (str_concat "\nmeter-mode=" mode))
    (print (str_concat "\nscanned-from-byte=" (int_to_str start)))
    (print (str_concat "\nrollout-bytes=" (int_to_str size)))
    0)
