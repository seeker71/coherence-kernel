; ear-glass-live.fk — the room transcribed live on glass, three tongues at
; once, in milliseconds, the body's own: the live lane (observe/ear-live-native.fk:
; the native microphone stream and the native whisper-tiny pass) and the tongue
; lane (observe/ear-tongue-native.fk: the native llama lane for the tongues not
; heard) are Form processes; each writes frames to the ear spool and rings this door's bell; the
; door wakes on the bell (no sleep on the live path), drains the spool by
; watermark, paints the newest frame — level, live line, heard line, the
; reference's own doubt, English, Persian, Brazilian Portuguese, and three
; latencies measured from the last audio sample — and publishes voice.ear.
; Full screen is the terminal that runs it: "Sema Ear Glass.command" opens
; one; bind a Shortcut to that file for a hot key.
; stdin line 1: run seconds (blank -> 30).
; preflight-exec: forbidden
; preludes: form/form-stdlib/hearth.bml form/form-stdlib/spool-bell-transport.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/term-graphics.bml
(do
    (defn eg-trim (s) (if (nothing? s) "" (trim s)))
    (defn eg-text (t) (if (nothing? t) "" t))
    (defn eg-cat (parts) (if (eq (len parts) 0) "" (str_concat (head parts) (eg-cat (tail parts)))))
    (defn eg-spool () ".hearth/ear.spool")
    (defn eg-bell () ".hearth/ear.spool.bell")
    (defn eg-line-end (s i) (if (ge i (str_len s)) i (if (eq (str_byte_at s i) 10) i (eg-line-end s (add i 1)))))
    (defn eg-field (s key) (do (let at (str_find s (str_concat (byte_to_str 10) (str_concat key "=")) 0)) (if (lt at 0) "" (substring s (add at (add (str_len key) 2)) (eg-line-end s (add at (add (str_len key) 2)))))))
    (defn eg-int (s key) (do (let v (eg-field s key)) (if (eq (str_len v) 0) 0 (str_to_int v))))
    ; only the newest whole frame matters to a live panel
    (defn eg-through (text from last) (do (let c (str_find text "<|/ear:frame|>" from)) (if (lt c 0) last (eg-through text (add c 14) (add c 14)))))
    (defn eg-drain (r) (do (let sz (file_size (sbt-path r))) (if (le sz (sbt-mark r)) (list (list) r) (do (let text (eg-text (read_file_slice (sbt-path r) (sbt-mark r) (sub sz (sbt-mark r))))) (let th (eg-through text 0 0)) (if (eq th 0) (list (list) r) (list (eg-frames (substring text 0 th) 0 (list)) (list (sbt-path r) (add (sbt-mark r) th))))))))
    (defn eg-bar (db) (tg-bar (div (add db 60) 6) 10))
    (defn eg-tongue (l) (if (eq (str_len l) 0) "" (eg-cat (list l "  "))))
    (defn eg-lanes (f h nowms n)
        (list (tg-lane "EAR     " (eg-cat (list "the room live, three tongues; frame #" (int_to_str n) " " (eg-field f "kind"))) "dim" (sub 0 1))
              (tg-lane "level   " (eg-cat (list (eg-bar (eg-int f "db")) " " (int_to_str (eg-int f "db")) " dBFS")) (if (lt (eg-int f "db") (sub 0 55)) "dim" "good") (sub 0 1))
              (tg-lane "live    " (eg-cat (list (eg-tongue (eg-field f "livelang")) (eg-field f "live"))) "plain" (sub nowms (eg-int f "t")))
              (tg-lane "heard   " (eg-cat (list (eg-tongue (eg-field h "lang")) (eg-field h "heard"))) "plain" (sub 0 1))
              (tg-lane "phantom?" (eg-cat (list (eg-bar (sub (eg-int h "nsp") 60)) " " (int_to_str (eg-int h "nsp")) "% the reference doubts speech was here")) (tg-scale (eg-int h "nsp") 30 60) (sub 0 1))
              (tg-lane "en      " (eg-field h "en") "plain" (sub 0 1))
              (tg-lane "fa      " (eg-field h "fa") "plain" (sub 0 1))
              (tg-lane "pt-br   " (eg-field h "pt") "plain" (sub 0 1))
              (tg-lane "stages  " (eg-cat (list "mic slice ≤100 ms · encode " (int_to_str (eg-int f "encms")) " ms · decode " (int_to_str (eg-int f "decms")) " ms for " (int_to_str (eg-int f "ntok")) " tokens · emit→glass " (int_to_str (sub nowms (eg-int f "t"))) " ms")) "dim" (sub 0 1))
              (tg-lane "latency " (eg-cat (list "live " (int_to_str (add (eg-int f "livems") (sub nowms (eg-int f "t")))) " ms · heard " (int_to_str (eg-int h "heardms")) " ms · said " (int_to_str (eg-int h "saidms")) " ms, from the last sample to this glass")) (tg-scale (add (eg-int f "livems") (sub nowms (eg-int f "t"))) 500 1000) (sub 0 1))))
    (defn eg-publish (f h epoch) (fgtm-publish-snapshot (hearth-telemetry-root) "voice.ear" epoch (list (fgtm-sample "ear.level" (fgtm-absent) "ear" "form" "voice.ear" "voice" "dbfs-below-zero" (fgtm-absent) (fgtm-present (sub 0 (eg-int f "db"))) (if (lt (eg-int f "db") (sub 0 55)) "idle" "active") (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "ear-organ" (list "all" "we" "mesh" "voice")) (fgtm-sample "ear.latency" (fgtm-absent) "ear" "form" "voice.ear" "voice" (if (eq (str_len (eg-field h "lang")) 0) "silence" (eg-field h "lang")) (fgtm-absent) (fgtm-present (eg-int h "heardms")) "completed" (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-absent) "never" "physical-live" "ear-organ" (list "all" "we" "mesh" "voice")))))
    ; two lanes write the spool: live/quiet/born/done frames from the live lane, heard/said from the commit lane; the panel keeps the newest of each
    (defn eg-frames (text from acc) (do (let o (str_find text "<|ear:frame|>" from)) (if (lt o 0) (reverse acc) (do (let c (str_find text "<|/ear:frame|>" o)) (if (lt c 0) (reverse acc) (eg-frames text (add c 14) (cons (substring text o (add c 14)) acc)))))))
    (defn eg-heard? (f) (or (str_eq (eg-field f "kind") "heard") (str_eq (eg-field f "kind") "said")))
    (defn eg-merge (frames live heard) (if (eq (len frames) 0) (list live heard) (if (eg-heard? (head frames)) (eg-merge (tail frames) live (head frames)) (eg-merge (tail frames) (head frames) heard))))
    (defn eg-paint (live heard n) (do (let now (now_unix_ms)) (let put (print_str (tg-frame (eg-lanes live heard now n)))) (if (eq (mod n 5) 0) (eg-publish live heard now) 0) n))
    (defn eg-loop (r live heard n deadline)
        (do (let d (eg-drain r))
            (let m (eg-merge (head d) live heard))
            (let shown (if (eq (len (head d)) 0) n (eg-paint (head m) (nth m 1) (add n 1))))
            (if (or (str_eq (eg-field (head m) "kind") "done") (gt (now_unix_ms) deadline)) shown
                (if (gt (len (head d)) 0) (eg-loop (nth d 1) (head m) (nth m 1) shown deadline)
                    (do (let woke (sbt-bell-wait (eg-bell))) (eg-loop (nth d 1) (head m) (nth m 1) shown deadline))))))
    (let secs (str_to_int (do (let l (eg-trim (read_line))) (if (eq (str_len l) 0) "30" l))))
    (let mk (fs-mkdir ".hearth"))
    (let cleared (fs-remove-file (str_concat (eg-spool) ".stop")))
    (let fifo (host-exec (eg-cat (list "[ -p " (eg-bell) " ] || mkfifo " (eg-bell) "; [ -p " (eg-spool) ".seg.bell ] || mkfifo " (eg-spool) ".seg.bell; echo ok")) ""))
    (let r0 (list (eg-spool) (if (lt (file_size (eg-spool)) 0) 0 (file_size (eg-spool)))))
    ; patience: one deferred ring past the run so a dead organ cannot hold the door
    (let patience (host-exec (eg-cat (list "( sleep " (int_to_str (add secs 40)) "; printf x > " (eg-bell) " ) >/dev/null 2>&1 & echo patient")) ""))
    (let launched (host-exec (eg-cat (list "( printf '" (int_to_str secs) "\n' | ./fkwu observe/ear-live-native.fk > .hearth/ear-live.log 2>&1 ) >/dev/null 2>&1 & ( printf '" (int_to_str secs) "\n' | ./fkwu observe/ear-tongue-native.fk > .hearth/ear-tongue.log 2>&1 ) >/dev/null 2>&1 & echo launched")) ""))
    (let shown (eg-loop r0 "" "" 0 (add (now_unix_ms) (mul 1000 (add secs 40)))))
    (let stop (write_file_text (str_concat (eg-spool) ".stop") "stop"))
    (print_str (str_concat "\near frames shown=" (str_concat (int_to_str shown) "\n")))
    0)
