; Ownership probe for the promoted model.  It opens every file-derived tensor
; view and all JIT pipelines, then closes them without generating a token.
; Effectful run cell: do not preflight.
; preludes: form/form-stdlib/form-cli-model-generate.fk form/form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (if (not (eq (qaf-verify-sealed-file path) 1))
        (list "refused" "canonical-artifact-is-not-sealed")
        (do
            (let src (fcmg-src path))
            (let ids (q35-chat-ids src "hello"))
            (let ctx (q38-open path (add (len ids) 1)))
            (if (lt (len ctx) 10)
                (list "refused" "context-open" (metal_status))
                (do
                    (let valid (q38-context-ok? ctx))
                    (let bytes (q38-forward-weight-bytes ctx))
                    (let expected (q38-close-expected ctx (empty)))
                    (let closed (q38-close ctx (empty)))
                    (list "open-close" valid expected closed bytes (metal_status))))))
)
