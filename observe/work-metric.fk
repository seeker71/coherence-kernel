; work-metric.fk — the metric for STONE WORK, registered before any student exists to fit it.
;
; Urs, 2026-08-18: training our native form model to do this work will be essential — new models
; will be released and we will need to do this again and again, without the rented remote mind.
; The law that makes that honest is nvr-metric.fk's, replayed one level up: REGISTER THE METRIC
; FIRST, while there is no native candidate whose strengths could bend it. A metric written after
; the student is a metric written for the student.
;
; WHAT A WORK-TRIAL IS. One attempt at one held-out case, by one worker (the rented mind today,
; the native student when it comes), recorded as rows a judge can fold without reading prose:
;
;   trial = (case-id worker predicted-verdict actual-verdict clock-ms clock-bound-ms steps)
;   step  = (kind move witness)
;
; The eight step KINDS are the stone method's own, distilled from the receipts that carried it
; (2026-08-18 the-rate-was-waiting-for-its-bound, the-graft-the-body-refused):
;   map         read the ground, grade PROVEN/OBSERVED/ABSENT
;   probe       ask the body a small question before believing (shadow probe, count probe)
;   hypothesize name separable mechanisms BEFORE measuring
;   variant     author one-mechanism candidates
;   measure     race them on real ground, runs and spread
;   land        write the winner into the body, laws evolved stated not slipped
;   band        preregister the predicted verdict, then witness it
;   receipt     close with surprise and discomfort-to-gold
;
; THE FOUR JUDGED AXES, all four required (conjunctive, like sema-graduation's families):
;   correctness — the actual band verdict equals the preregistered prediction;
;   process     — every step carries a nonempty witness (a claim without a witness is not a step),
;                 and every kind is one of the eight (an alien kind is a trial the metric cannot
;                 see, refused rather than half-scored);
;   clock       — the trial finished inside its bound. THE STALLRED LAW, landed at last as code
;                 rather than receipt prose: a trial with no verdict by its clock IS red — "no
;                 verdict yet" and "verdict pending forever" are the same observation, so the
;                 fold answers red, never waits;
;   honesty     — predicted-verdict was written before the run (carried as data; its truth is
;                 witnessed by the gold-ledger's (predicted actual) rows, not re-proven here).
;
; THE EARN. wm-earns? IS cc-promote? composed (champion-challenger.fk, never re-derived): the
; student earns the stone lane only when its scored trials reach the rented worker's over the
; same held-out cases, min-samples and margin honored. Retirement stays lane-by-lane
; (colearning-retire.fk); kin discipline for base-vs-fine-tune comparisons is
; lineage-discounted-vote.fk's and is NAMED here, wired when the first weight delta exists.
;
; THE HELD-OUT CASES are real future stones this body has already named and nobody has worked:
; their answers exist nowhere, so no worker can have memorized them. held=1 rows never train.
;
; preludes: form-stdlib/core.fk form-stdlib/champion-challenger.fk

(do
    (defn wm-metric-id () 20260818)

    ;; ── the shapes ──────────────────────────────────────────────────
    (defn wm-step (kind move witness) (list kind move witness))
    (defn wm-step-kind (s) (nth s 0))
    (defn wm-step-move (s) (nth s 1))
    (defn wm-step-wit  (s) (nth s 2))

    (defn wm-trial (case-id worker predicted actual clock-ms bound-ms steps)
        (list case-id worker predicted actual clock-ms bound-ms steps))
    (defn wm-case    (t) (nth t 0))
    (defn wm-worker  (t) (nth t 1))
    (defn wm-pred    (t) (nth t 2))
    (defn wm-act     (t) (nth t 3))
    (defn wm-clock   (t) (nth t 4))
    (defn wm-bound   (t) (nth t 5))
    (defn wm-steps   (t) (nth t 6))

    ;; ── the eight kinds, counted not waved through ──────────────────
    (defn wm-kinds ()
        (list "map" "probe" "hypothesize" "variant" "measure" "land" "band" "receipt"))
    (defn wm-kind-in (ks k)
        (if (eq (len ks) 0) 0
            (if (str_eq (head ks) k) 1 (wm-kind-in (tail ks) k))))
    (defn wm-kind-ok? (k) (wm-kind-in (wm-kinds) k))

    ;; ── the axes ────────────────────────────────────────────────────
    (defn wm-correct? (t) (if (eq (wm-pred t) (wm-act t)) 1 0))

    (defn wm-steps-ok (ss)
        (if (eq (len ss) 0) 1
            (if (eq (wm-kind-ok? (wm-step-kind (head ss))) 1)
                (if (gt (str_len (wm-step-wit (head ss))) 0)
                    (wm-steps-ok (tail ss))
                    0)
                0)))
    (defn wm-process? (t)
        (if (gt (len (wm-steps t)) 0) (wm-steps-ok (wm-steps t)) 0))

    ; the stallred law: past the bound, or carrying no verdict at all (actual 0
    ; is this schema's "no verdict"), the trial IS red — the fold never waits.
    (defn wm-clock? (t)
        (if (le (wm-clock t) (wm-bound t)) (if (gt (wm-act t) 0) 1 0) 0))

    ; the conjunctive score: one coin per trial, cc-shaped
    (defn wm-score (t)
        (if (eq (wm-correct? t) 1)
            (if (eq (wm-process? t) 1) (wm-clock? t) 0)
            0))

    ;; ── the earn: composed, never re-derived ────────────────────────
    ; history rows for cc: (champion-coin challenger-coin) per shared case
    (defn wm-earns? (history min-samples margin) (cc-promote? history min-samples margin))

    ;; ── the held-out cases: real named stones, unworked, held forever ─
    ; (case-id ask held)
    (defn wm-cases ()
        (list
            (list 1 "extend the halfdecode equality gate to the Q6_K d byte and land it beside q4k-halfdecode-band" 1)
            (list 2 "map where the token's remaining 4x lives now that the matvec no longer dominates, one mechanism per variant, and land the largest" 1)
            (list 3 "author the leakage-free held-out template set for the ds4 control adapter, refit, and either beat the majority baseline honestly or fail honestly" 1)
            (list 4 "carry the prompt-side tokenizer from longest-match to merge-order BPE with the band judging real llama3 vocab merges" 1)))
    (defn wm-case-held (c) (nth c 2))
    (defn wm-all-held (cs)
        (if (eq (len cs) 0) 1
            (if (eq (wm-case-held (head cs)) 1) (wm-all-held (tail cs)) 0)))

    ;; ── the first real trial row: the slot rung stone, 2026-08-18, rented worker ─
    ; witnesses are the session's own numbers, written after they were witnessed;
    ; the prediction 255 was written before the run (gold-ledger row slot-bound-bit
    ; holds the honest first-witness 191 and what it became). clock in minutes-ms
    ; from the session span (maps landed 07:41, band whole 08:05 -> ~24 min).
    (defn wm-first-trial ()
        (wm-trial 0 "rented-claude" 255 255 1440000 3600000
            (list
                (wm-step "map" "four explorers over the forward-pass, metal-door, models, wiring ground" "12/12-ids-0.855-tok/s-receipt-2026-08-04")
                (wm-step "probe" "does a later defn rebind an earlier call" "[2,2,2]")
                (wm-step "land" "llama-token-slot.fk rebinds lth-mv alone; twins dispatched 32-wide" "preflight-unresolved-0")
                (wm-step "band" "llama-token-slot-band preregistered 255; bound stated and checked on eight real rows" "191-then-255-exit-0")
                (wm-step "measure" "three witnessed runs" "281/283/289-ms-per-11-forwards")
                (wm-step "receipt" "the-rate-was-waiting-for-its-bound" "mirror-clear-0"))))

    ;; ── the second trial row: held-out case 3, worked 2026-08-18 by the rented worker ─
    ; This IS a held case: this trial row is the CHAMPION's coin for case 3, rowed for
    ; judging — and, per the hold law, this trial and its trace are excluded from any
    ; student training corpus, or the eval leaks into the student. Preregistered before
    ; the run: band 31, point estimate 100/150 (gold-ledger row fresh-heldout-correct
    ; holds the honest 65 and its shrinkage). Outcome: beats-majority-leakage-free,
    ; 65 vs baseline 30 — the generalization claim refused on 2026-08-09 is earned.
    (defn wm-case3-trial ()
        (wm-trial 3 "rented-claude" 31 31 2100000 3600000
            (list
                (wm-step "map" "four explorers over learning lanes, ds4 student, traces, judge floor" "adapter-door-installed-and-empty")
                (wm-step "probe" "re-witness the leaked floor" "142/150-overlap-150-refused")
                (wm-step "hypothesize" "held rows collapse into train's 60-combo template space; fresh sentences break it" "i-mod-12-x-i-mod-5")
                (wm-step "variant" "author 150 heldout-fresh rows: 12 new contexts x 5 new phrasings per class" "dcf-rows-original-sentences")
                (wm-step "measure" "fit train-only, eval fresh, audit overlap by the cell's own instrument" "correct-65-leak-0-baseline-30")
                (wm-step "band" "dsv4-control-fresh-band preregistered 31; bit 4 caught the adder's 900-for-750 pin" "27-then-31-exit-0")
                (wm-step "receipt" "the-adapter-earns-its-claim" "gold-row-shrinkage"))))
    0)
