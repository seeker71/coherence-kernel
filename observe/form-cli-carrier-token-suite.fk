; form-cli-carrier-token-suite.fk — the complete pre-sealed TOKEN route suite
; through the installed standalone carrier, not only the source runner.
;
; Verdict 31: 32/32 cases, 24 derived TOKEN executions, 8 unchanged quiet
; declines, and the carrier voice answers pong.
;
; preludes: form-stdlib/core.fk form-stdlib/tests/form-cli-token-route-sealed.fk

(do
  (defn fccts-run (query)
    ; host-exec's second argument is reserved and does not become child stdin.
    ; The query corpus is sealed and contains no quote characters, so the Form
    ; orchestrator can feed the carrier through one bounded printf pipeline.
    (host-exec
      (str_concat "printf '%s\\n' 'ask "
        (str_concat query "' 'quit' | ./form/form-cli")) ""))
  (defn fccts-result-marker (result)
    (str_concat "\nresult=" (str_concat (int_to_str result) "\n")))
  (defn fccts-case-ok? (c)
    (do (let output (fccts-run (fctrs-query c)))
        (if (eq (fctrs-route c) 1)
          (if (and (not (lt (str_find output
                "execution-lane=form-token-eval" 0) 0))
              (and (not (lt (str_find output
                (fccts-result-marker (fctrs-result c)) 0) 0))
                (and (not (lt (str_find output
                  "semantic-origin=authored-form" 0) 0))
                  (not (lt (str_find output
                    "content-grade=derived" 0) 0))))) 1 0)
          (if (and (not (lt (str_find output
                "[ask: native and local lanes are quiet]" 0) 0))
              (lt (str_find output "execution-lane=form-token-eval" 0) 0)) 1 0))))
  (defn fccts-pass-count (cases)
    (if (eq (len cases) 0) 0
      (add (fccts-case-ok? (head cases))
        (fccts-pass-count (tail cases)))))
  (defn fccts-expected-count (cases route)
    (if (eq (len cases) 0) 0
      (add (if (eq (fctrs-route (head cases)) route) 1 0)
        (fccts-expected-count (tail cases) route))))
  (defn form-cli-carrier-token-suite ()
    (do (let cases (fctrs-cases))
      (sum (list
        (if (eq (len cases) 32) 1 0)
        (if (eq (fccts-pass-count cases) 32) 2 0)
        (if (eq (fccts-expected-count cases 1) 24) 4 0)
        (if (eq (fccts-expected-count cases 0) 8) 8 0)
        (if (str_eq (host-exec
              "printf '%s\\n' 'ping' 'quit' | ./form/form-cli" "") "pong\n") 16 0)))))

  (form-cli-carrier-token-suite))
