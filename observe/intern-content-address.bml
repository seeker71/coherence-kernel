// intern-content-address.bml — does a large integer keep one identity, whoever interns it?
//
// preludes: form-stdlib/core.fk
//
// THE PROMISE THIS MEASURES. The substrate's whole claim is that identity comes from content:
// two semantically identical inputs intern to the SAME NodeID, on every kernel, so a Recipe
// proven on the Mac is the same Recipe the phone receives, verifiable by its address rather
// than by trust. embedding-as-recipe.fk states it outright.
//
// A trivial int is content-addressed into the NodeID's inst slot. Where that slot is 64 bits
// wide the value IS the address and nothing more is needed. Where it is 32 bits the value does
// not fit, so the kernel keeps a side table and the inst becomes a POSITION IN THAT TABLE —
// which is a function of what was interned before it, not of the value.
//
// Found 2026-09-10 while healing the source lens, which refused a literal past 2^31 outright.
// The refusal was the visible half; this is the other half, and it is quieter: nothing refuses,
// every value round-trips exactly, and the address is simply not the value's own.
//
// HOW IT ASKS. Two fixtures intern the same pair of large integers in opposite orders and each
// prints the seal's node_inst. A kernel that content-addresses prints one number twice. A kernel
// that indirects prints two. The question is put to whichever kernels are built; an absent
// binary is reported absent, never as a pass.
//
// WITNESSED 2026-09-10 on this M4 Max:
//     fkwu   501009504543  501009504543   content-stable   (inst is `long long`, the value fits)
//     go               0             1    order-dependent  (Inst is uint32, so a side table)
//     rust             0             1    order-dependent
//
// So two of the three proof siblings disagree with the runtime about a leaf's address, and with
// each other about nothing — they share the wound. Every value round-trips; only identity moves.
//
// THE REPAIR, AND THE CONSTRAINT THAT FORCES IT. A 32-bit slot cannot hold an int64, so there
// are exactly two honest ends and no third:
//   widen the sibling inst to 64 bits, as fkwu already has it, and the value becomes its own
//     address again — this restores the promise and touches every place a NodeID is written down;
//   or keep 32 bits and say plainly that for values past the ceiling the sibling NodeID is a
//     HANDLE, not an address — which means comparing one across two processes compares two
//     different things, and the places that do are the ones worth finding.
// Hashing the value into 32 bits is not a third way: it trades an address that moves for two
// different values sharing one, which is worse.
//
// This cell decides neither. It makes the question cost one command instead of a day, and it
// will say so the moment either end is taken.
//
// Run it:  ./fkwu observe/intern-content-address.bml
section [form.bml] {
    class InternContentAddress {
        def ica-first() = "observe/fixtures/intern-order-seal-first.fk";
        def ica-second() = "observe/fixtures/intern-order-seal-second.fk";
        def ica-core() = "form/form-stdlib/core.fk";

        def ica-stable() = "content-stable";
        def ica-moving() = "order-dependent";
        def ica-absent() = "not-built";

        def ica-present?(path) = if ge(file_size(path), 0) then 1 else 0;
        def ica-ask(cmd) = str_to_int(host-exec(cmd, ""));
        def ica-cmd(binary, unit) = str_concat(binary, str_concat(" ", str_concat(ica-core(), str_concat(" ", unit))));

        // one kernel, both orders: (name reading first second)
        def ica-verdict(name, a, b) = list(name, if eq(a, b) then ica-stable() else ica-moving(), a, b);
        def ica-run-both(name, binary) = ica-verdict(name, ica-ask(ica-cmd(binary, ica-first())), ica-ask(ica-cmd(binary, ica-second())));
        def ica-read(name, binary) = if eq(ica-present?(binary), 0) then list(name, ica-absent(), -1, -1) else ica-run-both(name, binary);
        // fkwu runs a unit without a core argument; it resolves its own preludes
        def ica-self-cmd(binary, unit) = str_concat(binary, str_concat(" ", unit));
        def ica-read-self(name, binary) = ica-verdict(name, ica-ask(ica-self-cmd(binary, ica-first())), ica-ask(ica-self-cmd(binary, ica-second())));
        def ica-name(r) = nth(r, 0);
        def ica-reading(r) = nth(r, 1);
        def ica-first-run(r) = nth(r, 2);
        def ica-second-run(r) = nth(r, 3);

        def ica-line(r) = print_str(str_concat("  ", str_concat(ica-name(r), str_concat("  ", str_concat(ica-reading(r), str_concat("  ", str_concat(int_to_str(ica-first-run(r)), str_concat(" ", int_to_str(ica-second-run(r))))))))));

        // how many BUILT kernels keep one identity, and how many were asked
        def ica-count(rs, want) = if eq(len(rs), 0) then 0 else add(if str_eq(ica-reading(head(rs)), want) then 1 else 0, ica-count(tail(rs), want));
        def ica-lines-go(said, rest) = ica-lines(rest);
        def ica-lines(rs) = if eq(len(rs), 0) then 0 else ica-lines-go(ica-line(head(rs)), tail(rs));
        def ica-readings() = list(
            ica-read-self("fkwu", "./fkwu"),
            ica-read("go  ", "form/form-kernel-go/bin-go"),
            ica-read("rust", "form/form-kernel-rust/target/release/form-kernel-rust"));
        def ica-report() {
            let rs = ica-readings();
            let head-line = print_str("intern-content-address: does one value keep one address?");
            let body = ica-lines(rs);
            let stable = ica-count(rs, ica-stable());
            let moving = ica-count(rs, ica-moving());
            let absent = ica-count(rs, ica-absent());
            let tail-line = print_str(str_concat("  stable=", str_concat(int_to_str(stable), str_concat(" order-dependent=", str_concat(int_to_str(moving), str_concat(" not-built=", int_to_str(absent)))))));
            // one number a reader can pin: stable*100 + moving*10 + absent
            add(mul(stable, 100), add(mul(moving, 10), absent));
        }
    }
    ica-report();
}
