; room-watch-probe.fk — watch the room's own frame from outside the sensor, the way
; the glass does: seq first, cells when it moved. One compact line per take.
; preludes: form/form-stdlib/form-glass-sensor-rows.bml
(do
    (defn rw-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (rw-cat (tail xs)))))
    (defn rw-find (rows id) (if (eq (len rows) 0) (list) (if (str_eq (fgo-id (head rows)) id) (head rows) (rw-find (tail rows) id))))
    (defn rw-txt (rows id) (do (let r (rw-find rows id)) (if (eq (len r) 0) "?" (if (str_eq (fgo-value-kind r) "int") (int_to_str (fgo-int-value r)) (fgo-text-value r)))))
    (defn rw-line (rows) (print (rw-cat (list
        "lvl=" (rw-txt rows "room.level") " flr=" (rw-txt rows "room.floor")
        " [" (rw-txt rows "room.kind") " " (rw-txt rows "room.kind-sure") "%]"
        " hz=" (rw-txt rows "room.pitch") " vcd=" (rw-txt rows "room.voiced") "%"
        " turns=" (rw-txt rows "room.turns") " gap=" (rw-txt rows "room.gap")
        " voices=" (rw-txt rows "room.voices") " near=" (rw-txt rows "room.nearness")
        " | " (rw-txt rows "room.turn")
        " | breath: " (rw-txt rows "room.breath")
        " | nonword: " (rw-txt rows "room.nonword")
        " | tone: " (rw-txt rows "room.tone")
        " | changed: " (rw-txt rows "room.tone-change")))))
    (defn rw-loop (n held) (if (le n 0) 0
        (do (let h (fgsr-take "room" held))
            (let rows (fgsr-rows-or-absent "room" h))
            (rw-line rows)
            (let rested (host_sleep_ms 700))
            (rw-loop (sub n 1) h))))
    (defn rw-first-line () (do (let l (read_line)) (if (nothing? l) "" l)))
    (let n (do (let l (rw-first-line)) (if (eq (str_len l) 0) 20 (str_to_int l))))
    (rw-loop n (list))
    88)
