// preludes: form-stdlib/bml/native-blueprint-float.bml form-stdlib/bml/metal-jit.bml form-stdlib/f16-decode.fk
section [form.bml] {
 def nbfw-require(ok,why) = if ok then 1 else form_error(str_concat("blueprint float witness: ",why));
 def nbfw-range(at,end,out) = if ((Comparable) at == end) then reverse(out) else nbfw-range((at + 1),end,cons(at,out));
 def nbfw-negative(xs,sign) = if nil?(xs) then list() else cons((head(xs) + sign),nbfw-negative(tail(xs),sign));
 def nbfw-cases(format) {
  let positive = if ((String) format == "f16") then list(0,1,2,511,512,1023,1024,1025,15360,15361,31743,31744,31745,32256,32767) else list(0,1,2,63,64,127,128,129,16256,16257,32639,32640,32641,32704,32767);
  if ((String) format == "e2m1") then nbfw-range(0,16,list()) else if (((String) format == "e4m3") || ((String) format == "e5m2")) then nbfw-range(0,256,list()) else append(positive,nbfw-negative(positive,32768));
 }
 def nbfw-raw(xs) = if nil?(xs) then "" else str_concat(nfm-low(head(xs),8),nbfw-raw(tail(xs)));
 def nbfw-special(row,code) {
  let eb = head(row); let mb = nth(row,1); let e = fd-exp(code,eb,mb); let m = fd-mant(code,mb); let policy = nth(row,3);
  if (((Comparable) policy == 1) && ((Comparable) e == (nbf-power(eb) - 1))) then if ((Comparable) m == 0) then 1 else 2 else if (((Comparable) policy == 2) && (((Comparable) e == (nbf-power(eb) - 1)) && ((Comparable) m == (nbf-power(mb) - 1)))) then 2 else 0;
 }
 def nbfw-f64(row,code) {
  let eb = head(row); let mb = nth(row,1); let sign = fd-sign(code,eb,mb); let special = nbfw-special(row,code);
  if (special > 0) then nfm-fields(if ((Comparable) special == 1) then 0 else 2251799813685248,2047,sign) else if ((Comparable) (code % nbf-power((eb + mb))) == 0) then nfm-fields(0,0,sign) else nfm-f64-image(fd-value(code,eb,mb));
 }
 def nbfw-f32(row,code) {
  let eb = head(row); let mb = nth(row,1); let sign = (fd-sign(code,eb,mb) * 2147483648); let special = nbfw-special(row,code); let value = abs(fd-value(code,eb,mb));
  md-le32((sign + (if (special > 0) then if ((Comparable) special == 1) then 2139095040 else 2143289344 else if (value < fq-pow2(-126)) then trunc((value * fq-pow2(149))) else md-f32-bits(value))));
 }
 def nbfw-expected(row,xs,gpu) = if nil?(xs) then "" else str_concat(if gpu then nbfw-f32(row,head(xs)) else nbfw-f64(row,head(xs)),nbfw-expected(row,tail(xs),gpu));
 def nbfw-image(format) {
  let rows = npd-cat(list(list(fa-add-x-imm(16,0,0),fa-add-x-imm(17,2,0),nfm-ubfx(15,1,3,63),npd-label("word"),fa-ldr(7,16,0)),nbf-cpu(format),
   // Resolve the same fragment twice inside one image; neither local branch
   // label may bind into the other fragment.
   list(fa-ldr(7,16,0)),nbf-cpu(format),list(fa-fmov-d-x(0,7),fa-str-d(0,17,0),fa-add-x-imm(16,16,8),fa-add-x-imm(17,17,8),fa-sub-x-imm(1,1,8),fa-cmp-x(1,0),npd-branch(1,"word"),fa-add-x-imm(0,15,0),fa-ret())));
  fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
 }
 def nbfw-one(memory,format) {
  let cases = nbfw-cases(format); let count = len(cases); let row = nbf-format(format); let raw = nbfw-raw(cases); let image = nbfw-image(format);
  let identity = intern_node(make_nodeid(31,2,0,207),list(intern_trivial_string("blueprint-float-witness"),intern_trivial_string(format),intern_trivial_int(memory),intern_trivial_string(nfm-bytes-list(image,""))));
  let region = npd-region(memory,(16 + (count * 8)));
  nbfw-require(((Comparable) jit_leaf_inram(list(0,identity,image),list(raw,npd-span(region,8,(count * 8)))) == count),"CPU native projection count");
  let cpu = nfm-output-raw(region,8,count,list());
  nbfw-require(((String) cpu == nbfw-expected(row,cases,0)),str_concat(format," CPU exact fp64 bits"));
  nbfw-require(((((Comparable) npd-peek(region,0,7) == 0) && ((Comparable) npd-peek(region,7,1) == 0)) && (((Comparable) npd-peek(region,(8 + (count * 8)),7) == 0) && ((Comparable) npd-peek(region,(15 + (count * 8)),1) == 0))),"full CPU output guards");
  let source = mj-source(str_concat(nbf-msl-helpers(),str_concat("kernel void project(device const uint *x [[buffer(0)]], device uint *y [[buffer(1)]], uint i [[thread_position_in_grid]]) { y[i] = as_type<uint>(",str_concat(nbf-msl(format,"x[i]"),"); }"))));
  let version = mj-memory(source,"project"); nbfw-require((mj-handle(version) > 0),"real Metal RAM admission");
  let input = metal_buf_alloc((count * 4)); let output = metal_buf_alloc((count * 4));
  nbfw-require(((input > 0) && (output > 0)),"Metal buffers");
  metal_buf_write(input,0,md-le32-list(cases,"")); nbfw-require(((Comparable) mj-enqueue(version,md-bind(list(input,output),list()),count) == 1),"Metal dispatch");
  let fence = metal_submit(); nbfw-require(((fence > 0) && ((Comparable) metal_fence_wait(fence) == 1)),"Metal completed fence");
  let gpu = metal_buf_read(output,0,(count * 4)); nbfw-require(((String) gpu == nbfw-expected(row,cases,1)),str_concat(format," GPU exact fp32 bits"));
  nbfw-require(((Comparable) metal_buf_free(input) == 1),"Metal input release"); nbfw-require(((Comparable) metal_buf_free(output) == 1),"Metal output release"); nbfw-require(((Comparable) mj-release(version) == 1),"Metal code release");
  nbfw-require(((Comparable) jit_leaf_inram(list(1,identity,list()),0) == 1),"CPU code release"); nbfw-require(((Comparable) npd-region-close(region) == 0),"CPU output release");
  print(list("blueprint-float",format,"cases",count,"cpu-fp64-exact",1,"metal-fp32-exact",1,"signed-zero-and-specials",1)); count;
 }
 def nbfw-run() {
  nbfw-require((nothing?(nbf-cpu("unknown")) && nothing?(nbf-msl("unknown","x"))),"unknown interpretation refused");
  let memory = npd-open(); let total = (nbfw-one(memory,"f16") + (nbfw-one(memory,"bf16") + (nbfw-one(memory,"e2m1") + (nbfw-one(memory,"e4m3") + nbfw-one(memory,"e5m2")))));
  nbfw-require(((Comparable) npd-close(memory) == 1),"all owned mappings released"); nbfw-require(((Comparable) total == 588),"complete bounded format cases");
  print(list("blueprint-float-total",total,"exact",1)); 1;
 }
 if ((String) read_line() == "run") then nbfw-run() else 0;
}
