; qwen-lora-resident-glass-run.fk — the shared observer for the local mouth.
;
; The resident writes one already-encoded, dynamically tagged Form event.
; Glass does not parse it: this cell relays the live bytes as its picture.
; preludes: form/form-stdlib/qwen-lora-cell-channel.fk

(do
    (let state (read_file (qch-glass-path)))
    (print_str state)
    (print_str "\n")
    (if (gt (str_len state) 0) 1 0))
