; qwen-lora-resident-glass-run.fk — the shared observer for the local mouth.
;
; The resident gives one dynamically tagged Form event through node_gift.
; Glass takes the cell itself: no text wire or parser stands between them.
; preludes: form/form-stdlib/qwen-lora-cell-channel.fk

(do
    (let event (qch-receive-event))
    (if (nothing? event)
        (do (print "qwen-lora-resident-glass=absent") 0)
        (do
            (let glass (qch-field-value (qch-event-get event "glass")))
            (let nl (qch-field-value (qch-event-get event "nl")))
            (print_str (str_concat (qch-render-event glass)
                (str_concat "\nnl=" (qch-clean nl))))
            1)))
