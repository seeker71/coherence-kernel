; qwen-lora-train-run.fk — form-native local Qwen adapter update.
;
; Effectful: opens the local Qwen Q8 file once, observes one normalized hidden
; state, writes the fitted Qwen-width rank-one artifact, and admits that exact
; artifact back to Metal.  It is intentionally not a held-out voice eval.
; Do not preflight this effectful runner.
; preludes: form/form-stdlib/qwen-lora-train.fk

(do
    (defn qltr-token () 100)
    (let path (mr-path (mr-find "qwen38-q8")))
    (let artifact (qlh-path))
    (let hidden (qlt-local-hidden path (qltr-token)))
    (if (not (eq (len hidden) (qlh-width)))
        (do
            (print (list "qwen-lora-train" "local-state" 0 "artifact" 0 "voice-home" 0))
            0)
        (do
            (let target (qlt-target))
            (let fit (qlt-write-fit artifact hidden))
            (let before (qlt-loss target (qlt-scale target 0.0) 0.0))
            (let after (qlt-loss target (nth fit 1) (nth fit 2)))
            (let adapter (qlh-admit artifact))
            (let admitted (qlh-admitted? adapter))
            (let released (qlh-close adapter))
            (framebuffer-clear)
            (fb_record (intern_trivial_string "qwen-lora-local-fit")
                       "form/form-stdlib/qwen-lora-train.fk"
                       (if (lt after before) 1 0))
            (print (list "qwen-lora-train" "local-state" 1
                         "loss-decreased" (if (lt after before) 1 0)
                         "loss-after" after "artifact" (qlh-whole? artifact)
                         "device-admitted" admitted "released" (if (gt released 0) 1 0)
                         "voice-home" 0 "events" (len (framebuffer-events))))
            (if (if (lt after before) (eq admitted 1) 0) 1 0))))
