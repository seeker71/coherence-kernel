// gpu-tenants-run.bml — who used the GPU over an interval, from the accelerator registry's per-client GPU time (form-stdlib/bml/gpu-clients.bml).
//
//   echo 'seconds 8' | ./fkwu observe/gpu-tenants-run.bml
//
// Snapshots every GPU client's accumulated GPU time, waits `seconds` (default 5, at most 120), snapshots again and prints ONE form-rows line (a Form record,
// no JSON): the interval in milliseconds, the clients counted, and every client whose GPU time grew by at least 1 ms as [name ms], the most first.
// Read-only; no privilege. The flow brackets each of its asks the same way (observe/flow-direct-run.bml, receipts/ask-tenants.rows).
// stdin: `seconds N` (frw-options), optional.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/form-rows.bml form-stdlib/bml/gpu-clients.bml
section [form.bml] {
 class GpuTenantsRun {
  def gtr-seconds(o) { let n = frw-get(o, "seconds"); (String) value_kind(n) != "int" || n <= 0 ? 5 : n > 120 ? 120 : n; }
  def gtr-run() {
   let r = frw-options(stdin-text() ?? "");
   (String) r[0] != "ok" ? print_str("the options were refused at line " ++ r[2].str() ++ ": " ++ r[1] ++ "\n") : gtr-with(r[1]);
  }
  def gtr-with(o) {
   let t0 = host_monotonic_ms();
   let before = gc-snapshot();
   let slept = host_sleep_ms(gtr-seconds(o) * 1000);
   let after = gc-snapshot();
   print_str(frw-emit(record_new(0, "interval_ms", host_monotonic_ms() - t0, "clients", len(after), "tenants", gc-tenants(gc-delta(before, after)))) ++ "\n");
  }
 }
 gtr-run();
}
