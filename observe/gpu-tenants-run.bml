// gpu-tenants-run.bml — who used the GPU over an interval, from the accelerator registry's per-client GPU time (form-stdlib/bml/gpu-clients.bml).
//
//   echo '{"seconds":8}' | ./fkwu observe/gpu-tenants-run.bml
//
// Snapshots every GPU client's accumulated GPU time, waits `seconds` (default 5, at most 120), snapshots again and prints ONE JSON line: the interval in
// milliseconds and every client whose GPU time grew by at least 1 ms, the most first. Read-only; no privilege. The flow brackets each of its asks the same way
// (observe/flow-direct-run.bml, receipts/ask-tenants.jsonl).
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/draft-ledger.bml form-stdlib/bml/gpu-clients.bml
section [form.bml] {
 class GpuTenantsRun {
  def gtr-seconds(o) { let n = fhn-count(o, "seconds"); n <= 0 ? 5 : n > 120 ? 120 : n; }
  def gtr-run() {
   let line = trim(stdin-text());
   let o = (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("tenant-options", line) : json-node-object([]);
   let t0 = host_monotonic_ms();
   let before = gc-snapshot();
   let slept = host_sleep_ms(gtr-seconds(o) * 1000);
   let after = gc-snapshot();
   print_str(json-emit(json-node-object([fhn-n("interval_ms", host_monotonic_ms() - t0), fhn-n("clients", len(after)), json-node-pair("tenants", gc-json(gc-delta(before, after)))])) ++ "\n");
  }
 }
 gtr-run();
}
