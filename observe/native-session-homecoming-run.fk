; preflight-exec: forbidden
; Public examples only. Two actual worker lifetimes share one candidate/Adam lineage.
; Input: a fresh evidence directory. No living serving pointer is overwritten.
; preludes: form-stdlib/native-session-learning.bml
(do
 (let path (read_line))
 (let home (if (or (nothing? path) (str_eq path "")) (str_concat ".hearth/session-homecoming-" (nsm-id)) path))
 (if (fs-exists? home) (form_error "session witness requires a fresh directory") 0)
 (let first (nsm-record home "first-session" "one" "public-fixture" "Say hello." "Hello." "caller-teaching" "public greeting fixture" 0))
 (let launch1 (nsm-kick home)) (let pid1 (str_to_int (nsm-text (nsm-at home "worker.pid"))))
 (if (not (str_eq launch1 "launched")) (form_error "first session worker not launched") 0)
 (let rc1 (host_wait pid1)) (let state1 (nsm-state home))
 (print (list "first" rc1 (nsm-str (nsm-json (nsm-at first "result.json")) "status") (nsm-num state1 "optimizer_step")))
 (if (not (eq rc1 0)) (form_error "first session worker failed; inspect worker.err") 0)
 (let second (nsm-record home "second-session" "one" "public-fixture" "Say goodbye." "Goodbye." "caller-teaching" "public farewell fixture" 0))
 (let launch2 (nsm-kick home)) (let pid2 (str_to_int (nsm-text (nsm-at home "worker.pid"))))
 (if (not (str_eq launch2 "launched")) (form_error "second session worker not launched") 0)
 (let rc2 (host_wait pid2)) (let state2 (nsm-state home))
 (let result1 (nsm-json (nsm-at first "result.json"))) (let result2 (nsm-json (nsm-at second "result.json")))
 (print (list "second" rc2 (nsm-str result2 "status") (nsm-num state2 "optimizer_step")))
 (let checks (list (eq rc1 0) (eq rc2 0) (eq (nsm-num state1 "optimizer_step") 1) (eq (nsm-num state2 "optimizer_step") 2)
   (str_eq (nsm-str (nsm-json (nsm-at second "before.json")) "parent") (nsm-str state1 "candidate"))
   (eq (len (nsm-pending home (nsm-dirs home))) 0) (eq (nth (metal_live) 2) 0)))
 (nsm-write (nsm-at home "witness.json") (json-node-object (list (nsm-s "home" home) (json-node-pair "first" result1) (json-node-pair "second" result2))))
 (print checks) (print home)
 (if (value_eq checks (list 1 1 1 1 1 1 1)) 127 (form_error "session worker continuation failed")))
