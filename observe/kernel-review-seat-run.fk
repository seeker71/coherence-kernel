; One independent AI board seat, supervised by Form with retained status/streams.
; stdin: reviewer name, absolute packet path. Output: unique evidence directory.
; Paid calls are explicit; preflight excludes execution of this door.
; preflight-exec: forbidden
; preludes: form-stdlib/bml/form-cli-heal-native-process.bml observe/review-panel.fk
(do
    (defn kr-argv (door prompt)
        (if (str_eq door "grok") (list "grok" "--permission-mode" "plan" "--no-subagents" "--disable-web-search" "-p" prompt)
        (if (str_eq door "claude") (list "claude" "-p" "--tools" "" "--no-session-persistence" prompt)
        (if (str_eq door "codex") (list "codex" "exec" "--skip-git-repo-check" "--sandbox" "read-only" "--ephemeral" prompt)
        (if (str_eq door "cursor") (list "cursor-agent" "-p" "--mode" "ask" "--trust" prompt) (list))))))
    (let door (read_line))
    (let packet (read_line))
    (if (or (nothing? door) (nothing? packet)) "refused:missing-input"
        (if (or (eq (rp-is-open? door) 0) (lt (file_size packet) 1)) "refused:review-contract"
            (do (let job (fhn-unique (temp_dir) "kernel-review-" 0))
                (if (str_eq job "") "refused:review-directory"
                    (do (let saved (write_file (fhn-at job "packet.md") (read_file packet)))
                        (print_str (str_concat job "\n"))
                        (fhn-run-start job door 1200 job "-" (kr-argv door (read_file packet)))))))))
