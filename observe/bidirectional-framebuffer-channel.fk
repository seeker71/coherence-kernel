// bidirectional-framebuffer-channel.fk — a typed observation/control exchange.
// The kernel framebuffer stays the attributed carrier; this Form membrane adds
// direction, correlation, an actuator, and a no-response alternative.
section [form.bml] {
    // [direction, exchange-id, kind, payload, alternative-node]
    // direction 0=outbound observation, 1=inbound control; kind 0=transition,
    // 1=control. Actions: 0 continue, 1 branch, 2 revise, 3 abstain,
    // 4 request-evidence, 5 rehearse-ground, 6 admit-candidate,
    // 7 defer-candidate, 8 reject-candidate.
    def bfc-envelope(direction, exchange, kind, payload, alternative) = [direction, exchange, kind, payload, alternative];
    def bfc-direction(m) = m[0];
    def bfc-exchange(m) = m[1];
    def bfc-kind(m) = m[2];
    def bfc-payload(m) = m[3];
    def bfc-alternative(m) = m[4];
    def bfc-adjudicate(outbound) = nothing?(outbound) || (!((Comparable) bfc-direction(outbound) == 0) || !((Comparable) bfc-kind(outbound) == 0)) ? nothing() : {
        let transitions = bfc-payload(outbound);
        let action = transitions[0] > transitions[1] ? 5 : 0;
        bfc-envelope(1, bfc-exchange(outbound), 1, action, bfc-alternative(outbound));
    };
    // Typed control constructor for organs whose adjudication policy is richer
    // than the transition-count policy above. Validation still happens at apply.
    def bfc-control(outbound, action) = nothing?(outbound) || !((Comparable) bfc-direction(outbound) == 0) ? nothing() : bfc-envelope(1, bfc-exchange(outbound), 1, action, bfc-alternative(outbound));
    // A correlated response changes the selected next state. Missing or mismatched
    // responses select the offered alternative instead of becoming silence.
    def bfc-apply(outbound, inbound, current-state, rehearsed-state) = nothing?(inbound) || (!((Comparable) bfc-direction(inbound) == 1) || (!((Comparable) bfc-kind(inbound) == 1) || !((Comparable) bfc-exchange(outbound) == bfc-exchange(inbound)))) ? bfc-alternative(outbound) : (Comparable) bfc-payload(inbound) == 5 ? rehearsed-state : current-state;
    def bfc-record-out(message, step) = fb_record(intern_trivial_int(bfc-exchange(message) * 10), "bidirectional-framebuffer-channel.fk", step);
    def bfc-record-in(message, step) = fb_record(intern_trivial_int((Number) (bfc-exchange(message) * 10) + (Number) 1), "bidirectional-framebuffer-channel.fk", step);
    def bfc-round(exchange, transitions, current-state, rehearsed-state, alternative) = {
        let outbound = bfc-envelope(0, exchange, 0, transitions, alternative);
        let out-event = bfc-record-out(outbound, exchange * 2);
        let inbound = bfc-adjudicate(outbound);
        let in-event = bfc-record-in(inbound, (Number) (exchange * 2) + (Number) 1);
        [outbound, inbound, bfc-apply(outbound, inbound, current-state, rehearsed-state)];
    };
    0;
}
