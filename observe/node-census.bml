//////////////////////////////////////////////////////////////////////
//
// observe/node-census.bml — the body reads its own tissue.
//
// Two histograms over the live value-node table, the ones asked for on
// 2026-09-02: WHICH blueprints' nodes occupy the body (category census),
// and WHERE nodes are created from (source-location census via each
// node's own attribution). Both ride the one census atom node_at
// (tag 147): the kernel hands Form the i-th node and Form folds its own
// meaning — the kernel never decides what a census is.
//
// Run directly: ./fkwu observe/node-census.bml
// The preludes below load a real body first so the census reads living
// tissue, not an empty room.
//
// Answer shape:
//   [ total-nodes,
//     [[category-node, count] ...],       — blueprint occupancy
//     [[[file, line], count] ...] ]       — allocation sites (attributed)
//
// preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk

section [form.bml] {
    def nc-bump(pairs, k) =
        if eq(len(pairs), 0) then cons(list(k, 1), empty)
        else if value_eq(head(head(pairs)), k)
            then cons(list(head(head(pairs)), add(nth(head(pairs), 1), 1)), tail(pairs))
            else cons(head(pairs), nc-bump(tail(pairs), k));

    def nc-cat-walk(i, n, acc) =
        if gt(i, n) then acc
        else nc-cat-walk(add(i, 1), n,
            nc-bump(acc, node_category(node_at(i))));

    def nc-loc-walk(i, n, acc) =
        if gt(i, n) then acc
        else nc-loc-walk(add(i, 1), n, nc-loc-fold(acc, node_source(node_at(i))));

    def nc-loc-fold(acc, src) =
        if nothing?(src) then acc
        else if eq(len(src), 0) then acc
        else nc-bump(acc, list(head(src), nth(src, 1)));

    def node-census() = nc-census-of(kernel_stat(4));

    def nc-census-of(n) =
        list(n,
             nc-cat-walk(1, n, empty),
             nc-loc-walk(1, n, empty));

    node-census();
}
