; form-resource-host-pressure-live-run.fk — physical retain/backoff witness.
;
; It refreshes the production governor snapshot, reads it through the Glass
; membrane, and correlates the projected pressure level with a new Darwin
; memory_pressure sample.  It never calls a model close/release door.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-glass-observation-v2.bml form-stdlib/form-glass-observer.bml form-stdlib/form-resource-governor.bml form-stdlib/form-resource-host-pressure.bml form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/hearth.bml

(do
    (defn frghpl-find (samples id)
        (if (eq (len samples) 0) (list)
            (if (str_eq (fgtm-sample-id (head samples)) id) (head samples)
                (frghpl-find (tail samples) id))))
    (defn frghpl-find-kind (samples kind)
        (if (eq (len samples) 0) (list)
            (if (str_eq (fgtm-sample-kind (head samples)) kind) (head samples)
                (frghpl-find-kind (tail samples) kind))))
    (defn frghpl-number (field fallback)
        (if (eq (fgtm-field-present? field) 1) (fgtm-field-value field) fallback))

    (let invocation-start (now_unix_ms))
    (let free-output (host-exec "/usr/bin/memory_pressure -Q" ""))
    (let free-percent (fgo-host-free-percent free-output))
    (let refreshed (host-exec "./fkwu observe/form-resource-governor-glass-current-run.fk" ""))
    (let reading (fgtm-read-current (hearth-telemetry-root) "resource.governor"))
    (let snapshot (if (and (str_eq (fgtm-read-state-status reading) "current")
                            (eq (fgtm-field-present? (fgtm-read-state-value reading)) 1))
                       (fgtm-field-value (fgtm-read-state-value reading)) (list)))
    (let samples (if (eq (len snapshot) 4) (fgtm-snapshot-samples snapshot) (list)))
    (let snapshot-epoch (if (eq (len snapshot) 4) (fgtm-snapshot-epoch snapshot) -1))
    (let pressure (frghpl-find samples "governor.pressure.memory"))
    (let release (frghpl-find-kind samples "release-plan"))
    (let level (if (eq (len pressure) 19) (frghpl-number (fgtm-sample-bytes pressure) -1) -1))
    (let publisher-pid (if (eq (len pressure) 19) (frghpl-number (fgtm-sample-handle pressure) -1) -1))
    (let publisher-start (if (eq (len pressure) 19) (frghpl-number (fgtm-sample-write-epoch pressure) -1) -1))
    (let selected (frghpl-find samples "governor.release.selection-count"))
    (let selected-count (if (eq (len selected) 19) (frghpl-number (fgtm-sample-bytes selected) -1) -1))
    (let expected-level (frghp-level (frghp-default-policy) free-percent))
    (let expected-release (if (eq expected-level 0) "measured-no-pressure" "required-bytes-not-current"))
    (let invocation-end (now_unix_ms))
    (let epoch-correlated (if (and (ge snapshot-epoch invocation-start)
                                    (le snapshot-epoch invocation-end)) 1 0))
    (let lifetime-correlated (if (and (gt publisher-pid 0)
                                       (and (gt publisher-start 0)
                                            (le publisher-start snapshot-epoch))) 1 0))
    (let consistent (if (and (eq epoch-correlated 1)
                              (and (eq lifetime-correlated 1)
                              (and (ge expected-level 0)
                                   (and (eq level expected-level)
                                        (and (str_eq (fgtm-sample-evidence pressure) "physical-live")
                                             (and (str_eq (fgtm-sample-purpose release) expected-release)
                                                  (eq selected-count 0))))))) 1 0))

    (print_str "form-resource-host-pressure evidence=physical-live no-model-actuation\n")
    (print_str (str_concat "memory.free-percent=" (int_to_str free-percent)))
    (print_str (str_concat " governor.level=" (int_to_str level)))
    (print_str (str_concat " pressure.evidence=" (if (eq (len pressure) 19) (fgtm-sample-evidence pressure) "absent")))
    (print_str (str_concat " release=" (if (eq (len release) 19) (fgtm-sample-purpose release) "absent")))
    (print_str (str_concat " selected=" (int_to_str selected-count)))
    (print_str (str_concat " snapshot-epoch=" (int_to_str snapshot-epoch)))
    (print_str (str_concat " invocation-start=" (int_to_str invocation-start)))
    (print_str (str_concat " invocation-end=" (int_to_str invocation-end)))
    (print_str (str_concat " publisher-pid=" (int_to_str publisher-pid)))
    (print_str (str_concat " publisher-start=" (int_to_str publisher-start)))
    (print_str "\nmodel-state=file-mapped/open is not upgraded to resident or prefilled\n")
    (print_str "metal-owner-working-set=unavailable; packed-expert/layer/partial-kv release=unsupported\n")
    (if (eq consistent 1) 0 1))
