// Canonical words meet collisions, growth, retained readers and actual release.
// preludes: form-stdlib/bml/native-identity-intern.bml
section [form.bml] {
 def niit-need(ok,why) = if ok then 1 else form_error(str_concat("native identity intern witness: ",why));
 def niit-repeat(text,count) = if eq(count,0) then "" else if eq(count,1) then text else { let half = niit-repeat(text,div(count,2)); str_concat(str_concat(half,half),if eq(mod(count,2),1) then text else ""); };
 def niit-bytes(region,offset,count) = nfm-bytes-list(npd-bytes(region,offset,count),"");
 def niit-words(numbers) = if nil?(numbers) then "" else str_concat(nfm-low(head(numbers),8),niit-words(tail(numbers)));
 def niit-range(first,count) = if eq(count,0) then list() else cons(first,niit-range(add(first,1),sub(count,1)));
 def niit-twice(numbers) = if nil?(numbers) then list() else cons(head(numbers),cons(head(numbers),niit-twice(tail(numbers))));
 def niit-query(row) = str_concat(nfm-low(row,8),nfm-low(0,8));
 def niit-queries(rows) = if nil?(rows) then "" else str_concat(niit-query(head(rows)),niit-queries(tail(rows)));
 def niit-mints() { let live = kernel_live(host_pid()); niit-need(ge(len(live),35),"process mint counter present"); nth(live,33); }
 // Independent base-65536 arithmetic for small inputs; no native emitter used.
 def niit-product(n,limbs,carry) = if nil?(limbs) then list() else { let value = add(mul(n,head(limbs)),carry); cons(mod(value,65536),niit-product(n,tail(limbs),div(value,65536))); };
 def niit-xor3(a,b,left,place) = if eq(left,0) then 0 else add(if eq(mod(a,2),mod(b,2)) then 0 else place,niit-xor3(div(a,2),div(b,2),sub(left,1),mul(place,2)));
 def niit-bucket(n) { let limbs = niit-product(n,list(31765,32586,31161,40503),0); niit-xor3(head(limbs),nth(limbs,2),3,1); }
 def niit-colliders(n,left) = if eq(left,0) then list() else if gt(n,4096) then form_error("collision search exceeded its witnessed scope") else if eq(niit-bucket(n),7) then cons(n,niit-colliders(add(n,1),sub(left,1))) else niit-colliders(add(n,1),left);
 def niit-endpoint() {
  let first = 4611686018427387901; let owner = nii-open(first,4,8); niit-need(nii-active?(owner),"endpoint owner admitted"); let arena = record_get(owner,"arena"); let output = npd-region(nii-memory(owner),40); let guards = niit-repeat(byte_to_str(165),40); nia-write(arena,output,guards);
  let input = niit-words(list(0,1,2)); let before = niit-mints(); let completed = nii-intern(owner,input,output,8); let minted = sub(niit-mints(),before);
  niit-need(eq(completed,2),"logical row end returns two exact completed rows");
  niit-need(str_eq(niit-bytes(output,8,16),niit-words(list(first,add(first,1)))),"full-width output rows preserve more than 56 bits"); niit-need(str_eq(niit-bytes(output,24,16),niit-repeat(byte_to_str(165),16)),"uncompleted output and trailing guard untouched");
  niit-need(and(eq(nii-word(owner,2),2),and(eq(nii-word(owner,7),2),eq(nii-word(owner,8),22))),"partial state reports exact prefix and errno");
  let reading = record_get(owner,"last-reading"); let response = oh-response(reading,"retain-prefix"); niit-need(str_eq(oh-select(reading,response,""),"retain-prefix"),"pressure response correlated"); oh-voice(response);
  let nativeInput = nfm-low(2,8); let nativeArgs = list(5,nia-root(arena),npd-span(record_get(owner,"control"),0,96),nativeInput,npd-span(output,24,8)); let beforeNative = niit-mints(); let nativeCompleted = nia-call(arena,nativeArgs); let nativeMints = sub(niit-mints(),beforeNative);
  niit-need(and(eq(nativeCompleted,0),eq(nativeMints,0)),"native pressure leaves the unfinished output and primary population unchanged"); niit-need(str_eq(niit-bytes(output,24,8),niit-repeat(byte_to_str(165),8)),"native pressure does not write an unavailable row");
  niit-need(eq(nii-collect(owner),1),"explicit index collection settles"); niit-need(eq(nii-word(owner,8),0),"successful collection records its own clean native result");
  let maps = nii-word(owner,4); niit-need(eq(nii-intern(owner,nfm-low(1,8),output,8),1),"existing identity remains available at logical row end"); niit-need(and(eq(nii-word(owner,4),maps),eq(nii-word(owner,2),2)),"duplicate lookup precedes capacity and allocation"); oh-voice(oh-applied(reading,"retain-prefix",nii-state(owner)));
  npd-region-close(output); niit-need(eq(nii-close(owner),1),"endpoint owner fully released"); print(list("native-identity-intern-pressure","completed-prefix",completed,"native-primary-mints",nativeMints,"wrapper-signal-primary-mints",minted,"released",1)); 1;
 }
 def niit-run() {
  niit-need(nothing?(nii-open(0,4,3)),"non-power-of-two index policy rejected before admission");
  let owner = nii-open(0,16,8); niit-need(nii-active?(owner),"owner admitted"); let arena = record_get(owner,"arena");
  niit-need(and(eq(nia-word(arena,7),0),eq(nii-word(owner,4),0)),"resident image precedes data and index maps");
  let output = npd-region(nii-memory(owner),33000); let guards = niit-repeat(byte_to_str(165),33000); nia-write(arena,output,guards);
  let collisions = niit-colliders(1,3); let collisionWords = niit-words(collisions);
  niit-need(eq(nii-intern(owner,collisionWords,output,8),3),"same-bucket keys admitted"); niit-need(str_eq(niit-bytes(output,8,24),niit-words(list(0,1,2))),"collision rows distinct and stable");
  niit-need(eq(nii-word(owner,6),6),"three colliding keys take one two and three probes");
  let table = nia-borrow(arena,nii-word(owner,0),160); niit-need(and(eq(nia-u62(table,152),1),and(eq(nia-u62(table,40),2),eq(nia-u62(table,56),3))),"collision probing wraps from last bucket to first");
  let old = nii-acquire(owner); let maximum = niit-repeat(byte_to_str(255),8); let high = str_concat(nfm-low(0,7),byte_to_str(128)); let special = str_concat(nfm-low(0,8),str_concat(maximum,high));
  let numbers = niit-range(10000,1024); let raw = str_concat(special,niit-words(niit-twice(numbers))); let expected = niit-words(append(list(3,4,5),niit-twice(niit-range(6,1024)))); let before = niit-mints(); let calls = record_get(arena,"calls"); let completed = nii-intern(owner,raw,output,8); let minted = sub(niit-mints(),before);
  niit-need(and(eq(completed,2051),eq(minted,0)),"large native interning batch mints no primary nodes"); niit-need(eq(sub(record_get(arena,"calls"),calls),1),"all keys cross one Form native entry"); niit-need(str_eq(niit-bytes(output,8,str_len(expected)),expected),"duplicates within the batch share exact rows");
  let unique = 1030; niit-need(and(eq(nii-word(owner,2),unique),eq(nia-word(arena,3),unique)),"only distinct words consume arena rows");
  let maps = nii-word(owner,4); niit-need(gt(maps,2),"repeated index growth executed"); niit-need(eq(nii-word(owner,5),sub(maps,1)),"obsolete index mappings released after rehash"); niit-need(eq(nii-word(owner,3),add(32,mul(nii-word(owner,1),16))),"only current index requested extent remains");
  let reverseWords = str_concat(niit-words(reverse(numbers)),str_concat(high,str_concat(maximum,str_concat(nfm-low(0,8),niit-words(reverse(collisions))))));
  let reverseRows = niit-words(reverse(niit-range(0,unique))); let uniqueWords = str_concat(collisionWords,str_concat(special,niit-words(numbers)));
  let beforeRepeat = niit-mints(); niit-need(eq(nii-intern(owner,reverseWords,output,8),unique),"reverse replay resolves every canonical word"); niit-need(eq(sub(niit-mints(),beforeRepeat),0),"duplicate-only replay mints no primary nodes"); niit-need(str_eq(niit-bytes(output,8,str_len(reverseRows)),reverseRows),"rehash preserved every existing row");
  niit-need(and(eq(nii-word(owner,2),unique),eq(nii-word(owner,4),maps)),"duplicate-only replay allocates no index or identity rows");
  niit-need(eq(nia-project(old,niit-query(3),output,8),0),"older prefix excludes new canonical rows"); niit-need(eq(nia-project(old,niit-queries(list(0,1,2)),output,8),3),"earlier view survives all index growth"); niit-need(str_eq(niit-bytes(output,8,24),collisionWords),"retained prefix bytes exact");
  nia-write(arena,output,guards); niit-need(eq(nii-find(owner,str_concat(nfm-low(0,8),str_concat(nfm-low(999999,8),maximum)),output,8),1),"lookup stops at its first absent word"); niit-need(and(eq(nia-u62(output,8),3),str_eq(niit-bytes(output,16,16),niit-repeat(byte_to_str(165),16))),"absence is separate from row zero and preserves later output");
  niit-need(nothing?(nii-intern(owner,"x",output,8)),"partial word input leaves state alone"); niit-need(nothing?(nii-intern(owner,nfm-low(0,8),record_get(owner,"control"),0)),"private index metadata cannot be output"); niit-need(eq(nii-word(owner,2),unique),"invalid input and output preserve canonical population");
  let other = nii-open(0,4,8); let otherOutput = npd-region(nii-memory(other),8); niit-need(eq(nii-intern(other,maximum,otherOutput,0),1),"second owner independently admits a word"); niit-need(eq(nia-u62(otherOutput,0),0),"row numbers have owner-local meaning"); npd-region-close(otherOutput); niit-need(eq(nii-close(other),1),"second owner closes independently");
  let current = nii-acquire(owner); let queries = niit-queries(niit-range(0,unique)); let directory = ndi-open(); niit-need(eq(nia-freeze(current,directory),unique),"canonical arena freezes unique rows into adaptive storage"); let frozen = ndi-acquire(directory); let retained = npd-region(ndi-memory(directory),str_len(uniqueWords));
  niit-need(nothing?(nii-close(owner)),"reader leases keep the whole interner alive"); let reading = record_get(owner,"last-reading"); let response = oh-response(reading,"release-reader"); niit-need(str_eq(oh-select(reading,response,""),"release-reader"),"reader care response correlated"); oh-voice(response); nia-release(old); nia-release(current); oh-voice(oh-applied(reading,"release-reader",nii-state(owner)));
  niit-need(nothing?(nii-close(owner)),"ordinary output keeps retirement pending"); niit-need(str_eq(niit-bytes(output,0,8),niit-repeat(byte_to_str(165),8)),"leading output guard intact"); npd-region-close(output);
  let indexBytes = nii-word(owner,3); let payloadBytes = nia-word(arena,6); niit-need(eq(nii-close(owner),1),"index arena code and carrier all retire"); let state = nii-state(owner); let index = oh-get(state,"index"); niit-need(and(eq(json-int-value(oh-get(index,"mapped_requested_bytes")),0),eq(json-int-value(oh-get(index,"maps")),json-int-value(oh-get(index,"unmaps")))),"every index mapping released and observable after close");
  niit-need(nothing?(nii-intern(owner,maximum,retained,0)),"closed owner stops before native code"); niit-need(eq(nii-close(owner),0),"duplicate close inert");
  niit-need(eq(ndi-project(frozen,queries,retained,0),unique),"frozen canonical words survive interner retirement"); niit-need(str_eq(niit-bytes(retained,0,str_len(uniqueWords)),uniqueWords),"frozen unsigned identity bytes exact"); ndi-release(frozen); npd-region-close(retained); niit-need(eq(ndi-close(directory),1),"frozen directory releases");
  niit-need(eq(niit-endpoint(),1),"partial progress and duplicate-at-limit observed");
  print(list("native-identity-intern","unique",unique,"batch-inputs",completed,"index-maps",maps,"index-requested-bytes",indexBytes,"arena-requested-bytes",payloadBytes,"hot-primary-mints",minted,"code-bytes",len(record_get(arena,"image")),"collision-wrap",1,"exact",1,"released",1)); 1;
 }
 if str_eq(read_line(),"run") then niit-run() else 0;
}
