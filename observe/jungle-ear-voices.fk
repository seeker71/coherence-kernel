; jungle-ear-voices.fk — read what this place has taught the body, without listening.
;
; No mic, no clock of its own: it opens the rows file, rebuilds every voice, and
; says each one the way it says itself -- a call sign, a content address, and
; either the name a person gave it or the coordinates it was measured on.
;
; It also prints the pairwise distance between voices in the same units the
; matcher uses, so the radius is chosen by looking at the room's own numbers
; rather than by taste. A pair under the radius would have merged; a pair far
; over it never could.
;
; preludes: form/form-stdlib/jungle-ear.bml form/form-stdlib/form-fs.fk
(do
    (defn jev-cat (xs) (if (eq (len xs) 0) "" (jev-cat2 xs)))
    (defn jev-cat2 (xs) (str_concat (head xs) (jev-cat (tail xs))))
    (defn jev-text (v) (if (nothing? v) "" v))
    (defn jev-pad (s n) (if (ge (str_len s) n) s (jev-pad (str_concat s " ") n)))
    (defn jev-coords (c) (jev-cat (list
        "br=" (int_to_str (je-c-mean c 0))
        " pd=" (int_to_str (je-c-mean c 1))
        " pr=" (int_to_str (je-c-mean c 2))
        " du=" (int_to_str (je-c-mean c 3))
        " cr=" (int_to_str (je-c-mean c 4))
        " bs=" (int_to_str (je-c-mean c 5))
        " lv=" (int_to_str (je-c-mean c 6)))))
    (defn jev-name (c) (if (eq (je-named? c) 1) (str_concat "  NAMED: " (je-c-name c)) "  (unnamed)"))
    (defn jev-show (cs)
        (if (eq (len cs) 0) 0
          (do (let c (head cs))
              (print (jev-cat (list (jev-pad (je-c-symbol c) 8) (je-node c) "  n=" (jev-pad (int_to_str (je-c-n c)) 4) (jev-coords c) (jev-name c))))
              (print (str_concat "         " (je-describe c)))
              (jev-show (tail cs)))))
    ; the distance from one voice to every voice after it in the list
    (defn jev-pairs-of (c cs)
        (if (eq (len cs) 0) 0
          (do (print (jev-cat (list "    " (je-c-symbol c) " <-> " (jev-pad (je-c-symbol (head cs)) 8)
                                    (int_to_str (je-dist (je-c-center c) (append (je-c-center (head cs)) (list 0 0))))
                                    (if (le (je-dist (je-c-center c) (append (je-c-center (head cs)) (list 0 0))) (JERadius)) "   WOULD MERGE" ""))))
              (jev-pairs-of c (tail cs)))))
    (defn jev-pairs (cs) (if (le (len cs) 1) 0 (do (jev-pairs-of (head cs) (tail cs)) (jev-pairs (tail cs)))))
    (defn jev-hours-line (hs h) (if (ge h 24) "" (str_concat (if (gt (nth hs h) 0) (str_concat (int_to_str h) "h ") "") (jev-hours-line hs (add h 1)))))
    (defn jev-when-show (cs)
        (if (eq (len cs) 0) 0
          (do (print (jev-cat (list "    " (jev-pad (je-c-symbol (head cs)) 8) "hours: " (jev-hours-line (je-c-hours (head cs)) 0))))
              (jev-when-show (tail cs)))))

    (let text (jev-text (read_file (JERowsPath))))
    (if (eq (str_len text) 0) (print "no voices yet -- this place has not been listened to. run observe/jungle-ear-listen.fk") 0)
    (let cs (if (eq (str_len text) 0) (list) (je-rows-of text)))
    (let sorted (je-sorted cs))
    (print (jev-cat (list "voices=" (int_to_str (len cs))
                          " recurring(3+)=" (int_to_str (len (je-recurring cs 3)))
                          " events=" (int_to_str (je-heard-total cs))
                          " named=" (int_to_str (je-named-count cs))
                          " radius=" (int_to_str (JERadius)))))
    (jev-show sorted)
    (print "  hours each voice keeps:")
    (jev-when-show sorted)
    (print "  pairwise distance, in the matcher's own units:")
    (jev-pairs sorted)
    (len cs))
