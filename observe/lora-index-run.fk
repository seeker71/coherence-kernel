; lora-index-run.fk — what the resident path would bind, read from the file.
;
; THIS REPORTER ONCE CONTRADICTED ITS OWN PARSER. It passed the JSON header
; substring to sfh-header-len, which takes the FILE. The first eight bytes of
; `{"__meta` read as a little-endian integer and overflowed to
; -2201022797451419013, printed beside a data start of 24136 that was correct.
; The parser was never wrong. The effectful surface was, and no hermetic bit
; could see it because no bit ran this file.
;
; The cell already knew how to refuse it — sfh-well-formed? tests (gt h 0) and
; a negative length fails that. The reporter simply never asked. So it asks
; now, before it prints anything, and a reading that does not cohere says so
; instead of printing a number that looks like an observation.
;
; preludes: form-stdlib/safetensors-header.fk
(do
    (defn lir-say (k v) (print (str_concat k (str_concat (int_to_str v) "\n"))))
    (let p "/Users/ursmuff/.coherence-network/form-train-runs/bml-exec-adapter-20260826-0330-v2/adapters.safetensors")
    (if (lt (file_size p) 0) (print "lora-present?  nothing (no file)\n")
        (do
            (let s (read_file p))
            (if (eq (sfh-well-formed? s) 0)
                (print "not safetensors-shaped — refusing to report an index\n")
                (do
                    (let hl (sfh-header-len s))
                    (let ds (sfh-data-start s))
                    (if (eq (sfh-reading-coherent? s hl ds) 0)
                        (print "incoherent reading — refusing to print\n")
                        (do
                            (lir-say "lora-present?  " (sfh-lora-present? p))
                            (let h (sfh-header s))
                            (lir-say "file bytes     " (str_len s))
                            (lir-say "header bytes   " hl)
                            (lir-say "data starts at " ds)
                            (let a "model.layers.12.mlp.down_proj.lora_a")
                            (let b "model.layers.12.mlp.down_proj.lora_b")
                            (lir-say "rank           " (sfh-shape-second h a))
                            (let ba (sfh-bind s h a))
                            (let bb (sfh-bind s h b))
                            (print "\nmetal_buf_from_file triples:\n")
                            (lir-say "  lora_a offset " (sfh-bind-offset ba))
                            (lir-say "  lora_a bytes  " (sfh-bind-bytes ba))
                            (lir-say "  lora_b offset " (sfh-bind-offset bb))
                            (lir-say "  lora_b bytes  " (sfh-bind-bytes bb))))))))
    0)
