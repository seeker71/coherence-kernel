; heat-door-band.fk — the per-recipe heat door, witnessed whole: a child
; fkwu burns observe/heat-witness-mutual.fk (30M mutual tail dispatches)
; in its own scratch cwd, and this band reads the child's .fkwu-heat with
; the SAME lms-heat readers the glass wears — writer format and reader
; parse proven against each other, never separately. The exact counts are
; asserted (15000001/15000000): the counter sits on the fn-indexed tag-241
; dispatch, so every call is one increment, tail jumps included.
;
; bits (power-of-two weights — verdicts stay exact past 2^53's shadow):
;    1  child run exits 0
;    2  child's .fkwu-heat exists and is non-empty
;    4  ping line carries exactly 15000001 dispatches
;    8  pong line carries exactly 15000000
;   16  lms-heat-max names ping the hottest
;   32  lms-heat-count reads 2 recipes
; Verdict 63.
; PROOF LEVEL: FKWU-ONLY — this band witnesses fkwu's own C heat door;
; the sibling kernels carry no .fkwu-heat writer to agree or disagree.
; preludes: form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
(do
    (let d (str_concat "/tmp/fkwu-heat-band-" (int_to_str (now_unix_ms))))
    (let cmd (str_concat "mkdir -p " (str_concat d (str_concat " && cd " (str_concat d " && \"$OLDPWD/fkwu\" \"$OLDPWD/observe/heat-witness-mutual.fk\" >/dev/null 2>&1; echo rc=$?")))))
    (let out (host-exec cmd ""))
    (let heat (lms-heat-of (read_file (str_concat d "/.fkwu-heat"))))
    (let hm (lms-heat-max heat))
    (let b1 (if (str_eq (gl-word-field out "rc") "0") 1 0))
    (let b2 (if (gt (str_len heat) 0) 2 0))
    (let b4 (if (ge (str_find heat "15000001 ping" 0) 0) 4 0))
    (let b8 (if (ge (str_find heat "15000000 pong" 0) 0) 8 0))
    (let b16 (if (str_eq (nth hm 1) "ping") 16 0))
    (let b32 (if (eq (lms-heat-count heat) 2) 32 0))
    (let sweep (host-exec (str_concat "rm -rf " d) ""))
    (add b1 (add b2 (add b4 (add b8 (add b16 b32))))))
