// walk-began-run.bml — the lens "hours since a walk began": the night's absence made observable.
//
//   ./fkwu observe/walk-began-run.bml </dev/null
//   echo '{"stamp":"<path>","retry":"<path>","now_ms":<unix ms>,"zone_ms":<ms east of UTC>}' | ./fkwu observe/walk-began-run.bml
//
// The walk doors (scheduled-walk.bml, day-turn.bml) stamp their slot into .hearth/walk.began of the walk checkout when
// their claim holds (hw-begin, form-stdlib/bml/host-walk-began.bml). This door reads that file (and this checkout's own,
// when it is another directory; the walk checkout is the day-turn schedule's WorkingDirectory, sr-walk-dir) and prints
// the lens of the land cadence (form-stdlib/land-cadence.fk lr-lenses): a line `note: hours since a walk began: N
// (<door> began <hh:mm> <today|yesterday|date>, M min ago)`, with `; [walk-gap] no walk began since <hh:mm>
// <today|yesterday|date>` after it when no slot began for ten hours (the longest quiet between two slots is nine), and
// `; walk retry <hh:mm> <day>: <class> -> <what it did>: <word>` after that when a retry job has recorded a row in
// .hearth/walk-retry.jsonl (observe/walk-retry.bml), then N as the last line (the door's value): the hours counted up, so
// a walk that began this hour reads 1 and 0 stays the cadence's word for no reading. A stamp that did not read, or a time
// that has not come, prints no hours note and ends 0; a retry record that did not read adds nothing.
// stdin, optional, one JSON line (a terminal reads as no stdin): stamp and retry (read this one file each instead), now_ms
// and zone_ms (read the clock as given; for a band). The door only reads.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/host-walk-record.bml form-stdlib/bml/session-rent.bml
section [form.bml] {
 class WalkBeganRun {
  def wb-doc() {
   let line = trim(hw-stdin());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("walk-began", line) : json-node-object([]);
  }
  // the walk checkout (the day-turn schedule's WorkingDirectory) and this one, each with the file asked for
  def wb-own(name) {
   let dir = sr-walk-dir();
   (String) dir == "" || (String) dir == host_cwd() ? [name] : [name, dir ++ "/" ++ name];
  }
  def wb-paths(doc, key, name) = (String) hw-row-str(doc, key) != "" ? [hw-row-str(doc, key)] : wb-own(name);
  def wb-said(lines) = nil?(lines) ? 0 : wb-said-next(print_str(lines[0]), lines[1:]);
  def wb-said-next(said, rest) = wb-said(rest);
  def wb-run() {
   let doc = wb-doc();
   let now = hw-row-int(doc, "now_ms") ?? now_unix_ms();
   let zone = hw-row-int(doc, "zone_ms") ?? hw-zone-ms();
   let row = hw-slot-latest-of(wb-paths(doc, "stamp", hw-slot-path()));
   let retry = hr-lens-line(hr-latest-row(wb-paths(doc, "retry", hr-record-path())), now, zone);
   let said = wb-said(hw-gap-lines(row, now, zone, retry));
   hw-gap-code(row, now);
  }
 }
 wb-run();
}
