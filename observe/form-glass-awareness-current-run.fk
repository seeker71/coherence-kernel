; One bounded observation; no sensor fleet, model admission or living-state write.
; Reads native Glass frames and rehearses ONLY this process's attention window.
;
; THE DOOR IS BOUNDED AND NOW SAYS SO. It shows eight findings. Measured
; 2026-09-10 on eight consecutive reads: the state held TWENTY-FOUR every time,
; and the eight shown rotated — glass/frame-cycle-ms in reads 1, 2 and 7;
; machine/gpu-utilization in 3, 5 and 8; glass/channel in 3 alone. Nothing was
; resolving and nothing was arriving. A reader watching this door saw findings
; appear and vanish, which is what a condition clearing looks like, and two
; thirds of the body's own attention was never on the glass at all.
;
; The bound is right — a door has a width, and eight findings are what fits.
; The silence about it was the wound. The summary line above already names what
; it did not read (unseen-publishers=); the findings had no such companion and
; have one now. Same voice, same honesty: a view that is partial says which
; part. The one number to trust as the whole is `held`, never the row count.
;
; preludes: observe/say.fk form/form-stdlib/hearth.bml form/form-stdlib/bml/form-glass-awareness.bml
(do
  (defn fgar-shown () 8)
  (defn fgar-events (events left)
    (if (or (eq (len events) 0) (le left 0)) 0
      (do (let e (head events))
        (let line (say-line (fgtm-cat (list "  " (fga-get e "source") "/" (fga-get e "id") ": " (fga-get e "reason") " -> " (fga-get e "action")))))
        (fgar-events (tail events) (sub left 1)))))
  (let start (now_unix_ms))
  (let state (fga-current (hearth-telemetry-root) start (fga-state-empty)))
  (let finish (now_unix_ms))
  (let events (fga-get state "events"))
  (let summary (say-line (fgtm-cat (list "glass-awareness rows=" (int_to_str (fga-get state "after")) " before=" (int_to_str (fga-get state "before")) " unread=" (int_to_str (fga-get state "unread-rows")) " unseen-publishers=" (int_to_str (fga-get state "unread-publishers")) " asks=" (int_to_str (len (fga-get state "asks"))) " recipes=" (int_to_str (len (fga-get state "recipes"))) " attention-gifts=" (int_to_str (fga-get state "gifts")) " elapsed-ms=" (int_to_str (sub finish start))))))
  (let shown (fgar-events events (fgar-shown)))
  ; the bound, named. A door that shows part of a thing says which part, or the
  ; part it showed is read as the whole.
  (let held (len events))
  (let rest (if (gt held (fgar-shown)) (sub held (fgar-shown)) 0))
  (let tail-line
    (say-line
      (if (eq rest 0)
        (fgtm-cat (list "  findings shown=" (int_to_str held) " held=" (int_to_str held) " (all)"))
        (fgtm-cat (list "  findings shown=" (int_to_str (fgar-shown)) " held=" (int_to_str held)
                        " not-shown=" (int_to_str rest)
                        " — which eight appear rotates with arrival order; a finding leaving this list did not resolve")))))
  0)
