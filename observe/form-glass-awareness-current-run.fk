; One bounded observation; no sensor fleet, model admission or living-state write.
; Reads native Glass frames and rehearses ONLY this process's attention window.
;
; THE DOOR IS BOUNDED, SAYS SO, AND THE BOUND IS THE SURFACE'S. It shows as many
; findings as the terminal has rows for, once its own two chrome lines are paid.
;
; Measured 2026-09-10 on this checkout: the state held TWENTY-FOUR, which is the
; awareness shard's own ceiling (FGAMaxEvents), not an accident of arrival. Every
; finding was at most 94 characters and so cost one row at the glass's own width
; of 100; the summary and tail lines cost 4 rows of a 30-row surface; all 24
; findings fit in the remaining 26 with two rows to spare. The door was showing
; eight. Which eight rotated, so a reader watched findings appear and vanish —
; what a condition clearing looks like — while two thirds of the body's own
; attention was never on the glass at all.
;
; The silence about the bound was healed first; this is the bound itself. A door
; has a height, and how much fits in it is read from the surface, the way
; sparkWidth is already read from the width. The one number to trust as the whole
; is `held`, never the row count — and the row that says so now also names the
; surface it fitted to, so a reader can tell a small terminal from a full state.
;
; preludes: observe/say.fk form/form-stdlib/hearth.bml form/form-stdlib/bml/form-glass-awareness.bml form/form-stdlib/form-glass-live.bml
(do
  (defn fgar-line (e)
    (fgtm-cat (list "  " (fga-get e "source") "/" (fga-get e "id") ": " (fga-get e "reason") " -> " (fga-get e "action"))))
  (defn fgar-lines (events)
    (if (eq (len events) 0) (list)
      (cons (fgar-line (head events)) (fgar-lines (tail events)))))
  (defn fgar-say (lines left)
    (if (or (eq (len lines) 0) (le left 0)) 0
      (do (let said (say-line (head lines)))
        (fgar-say (tail lines) (sub left 1)))))
  (defn fgar-tail-text (shown held rest width height)
    (if (eq rest 0)
      (fgtm-cat (list "  findings shown=" (int_to_str shown) " held=" (int_to_str held) " (all) — surface " (int_to_str width) "x" (int_to_str height)))
      (fgtm-cat (list "  findings shown=" (int_to_str shown) " held=" (int_to_str held)
                      " not-shown=" (int_to_str rest)
                      " — surface " (int_to_str width) "x" (int_to_str height) " holds no more; which appear rotates with arrival order, and a finding leaving this list did not resolve"))))
  (let start (now_unix_ms))
  (let state (fga-current (hearth-telemetry-root) start (fga-state-empty)))
  (let finish (now_unix_ms))
  (let events (fga-get state "events"))
  (let held (len events))
  (let lines (fgar-lines events))
  (let width (fgl-terminal-width))
  (let height (fgl-terminal-height))
  (let summary-text (fgtm-cat (list "glass-awareness rows=" (int_to_str (fga-get state "after")) " before=" (int_to_str (fga-get state "before")) " unread=" (int_to_str (fga-get state "unread-rows")) " unseen-publishers=" (int_to_str (fga-get state "unread-publishers")) " asks=" (int_to_str (len (fga-get state "asks"))) " recipes=" (int_to_str (len (fga-get state "recipes"))) " attention-gifts=" (int_to_str (fga-get state "gifts")) " elapsed-ms=" (int_to_str (sub finish start)))))
  ; the door's own chrome, measured rather than guessed: the summary as written,
  ; and the widest tail this read could produce. Measuring the widest tail means
  ; a rounding error costs one finding, never an overflowed screen.
  (let chrome (add (fga-rows-for (str_len summary-text) width)
                   (fga-rows-for (str_len (fgar-tail-text held held held width height)) width)))
  (let shown (fga-shown (fga-lengths lines) width height chrome))
  (let rest (if (gt held shown) (sub held shown) 0))
  (let summary (say-line summary-text))
  (let painted (fgar-say lines shown))
  ; the bound, named, and now the bound is the surface's own. A door that shows
  ; part of a thing says which part, or the part it showed is read as the whole.
  (let tail-line (say-line (fgar-tail-text shown held rest width height)))
  0)
