; block-kinds.fk — Urs: "some lego blocks can move and pivot and anchor and hold".
;
; Four kinds, and the claim this cell makes and checks: a measurement you can stand on
; needs all four, and naming which kind is missing names the repair.
;
;   ANCHOR — a fixed reference that does not move and is known independently. Gravity at
;            9.807, sound at 343 mm/ms, the sea-level datum. You compare against it; it
;            never reports. Without one you have readings and no truth to check them by.
;   PIVOT  — turns a value from one frame into another. The rotation vector taking the
;            phone's frame to the world's. Without one, a correct number answers a
;            different question than the one asked.
;   MOVE   — produces the change that makes a sensor admissible at all (860). Without it
;            a reading distinguishes nothing.
;   HOLD   — carries state across time so a second look is possible. The corpus, the
;            registry, a cached band. Without it every observation is the first one.
;
; Applied to this evening's own failure, 2026-07-23 00:42. Every command tonight was run
; as `cmd 2>&1 | tail -1`. Measured against `form-run` on a deliberately failing case:
;   the pipeline showed  ->  "0", rc 0
;   form-run showed      ->  @form fkwu 1 3 259 262, rc 1
; Exit 1 and 259 bytes of diagnostics, rendered as a clean zero. In this taxonomy the
; observation had MOVE (commands ran and produced output) and HOLD (receipts kept it), and
; was missing ANCHOR (no known-good exit status to compare against) and PIVOT (tail's exit
; status was read as fkwu's — the right number from the wrong frame, which is 857 again).
; Two of four. It produced true verdicts all night and could not have told anyone if it had
; not, and those are different properties.
;
; preludes: form-stdlib/core.fk

(do
    (defn bk-anchor () 1)
    (defn bk-pivot ()  2)
    (defn bk-move ()   4)
    (defn bk-hold ()   8)
    (defn bk-whole ()  15)

    ; a rig = the sum of the kinds it has
    (defn bk-has? (rig kind) (if (eq (band rig kind) kind) 1 0))
    (defn bk-missing (rig) (sub (bk-whole) (band rig (bk-whole))))
    (defn bk-whole? (rig) (if (eq (band rig (bk-whole)) (bk-whole)) 1 0))
    (defn bk-count (rig)
        (add (bk-has? rig (bk-anchor))
        (add (bk-has? rig (bk-pivot))
        (add (bk-has? rig (bk-move)) (bk-has? rig (bk-hold))))))

    ; name the first thing missing, so the answer carries its own repair
    (defn bk-repair (rig)
        (if (eq (bk-has? rig (bk-anchor)) 0) "needs an anchor: nothing known to compare against"
            (if (eq (bk-has? rig (bk-pivot)) 0) "needs a pivot: right number, wrong frame"
                (if (eq (bk-has? rig (bk-move)) 0) "needs a move: nothing has been seen to change"
                    (if (eq (bk-has? rig (bk-hold)) 0) "needs a hold: no second look is possible"
                        "whole")))))

    ; --- the rigs this evening actually built ---
    ; tonight's shell observation: move + hold only
    (defn bk-pipeline () 12)
    ; form-run: adds the anchor (a real exit status) and the pivot (the command's frame,
    ; not the pipeline's) — the same work, wholly witnessed
    (defn bk-form-run () 15)
    ; the bearing chain: anchor (343 mm/ms), pivot (attitude), move (mic pair) — no hold,
    ; nothing stores a fix so two bearings could ever be crossed into a point
    (defn bk-bearing () 7)

    ; --- self-check ---
    (defn bkk (cond bit) (if cond bit 0))
    (defn bk-pipe-2 ()   (bkk (eq (bk-count (bk-pipeline)) 2) 1))
    (defn bk-pipe-not () (bkk (eq (bk-whole? (bk-pipeline)) 0) 2))
    (defn bk-pipe-why () (bkk (str_eq (bk-repair (bk-pipeline))
                              "needs an anchor: nothing known to compare against") 4))
    (defn bk-pipe-miss () (bkk (eq (bk-missing (bk-pipeline)) 3) 8))
    (defn bk-fr-whole () (bkk (eq (bk-whole? (bk-form-run)) 1) 16))
    (defn bk-fr-says ()  (bkk (str_eq (bk-repair (bk-form-run)) "whole") 32))
    (defn bk-bear-3 ()   (bkk (eq (bk-count (bk-bearing)) 3) 64))
    (defn bk-bear-why () (bkk (str_eq (bk-repair (bk-bearing))
                              "needs a hold: no second look is possible") 128))
    (defn block-kinds-check ()
        (add (add (add (bk-pipe-2) (bk-pipe-not)) (add (bk-pipe-why) (bk-pipe-miss)))
        (add (add (bk-fr-whole) (bk-fr-says)) (add (bk-bear-3) (bk-bear-why)))))
)
