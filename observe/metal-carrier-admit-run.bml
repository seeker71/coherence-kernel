// metal-carrier-admit-run.bml — the Metal carrier is admitted on demand, never pre-generated.
//
// fkwu runs this once, from its own directory, when the first Metal call finds the dynamic carrier absent
// (runtime/fkwu-uni.c, fk_metal_dyn_admit), then loads what stands. The policy is the body's own:
// form-stdlib/metal-carrier.bml reads the artifact against its source and builds it through the host door onto
// a fresh inode, so a process holding an older carrier keeps its own mapping. Nothing is read from stdin.
// The build's own words land in .hearth/carrier.log and .hearth/carrier.err.
// preflight-exec: forbidden
// preludes: form-stdlib/metal-carrier.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 def mcar-run() {
  let home = host_dir_mkdir(".hearth");
  let seen = mca-admit(".hearth/carrier.log", ".hearth/carrier.err");
  print_str(mc-cat(["[metal-carrier] ", seen[0], " build_exit=", seen[1].str()]));
 }
 mcar-run();
}
