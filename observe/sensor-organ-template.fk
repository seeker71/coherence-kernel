// Shared sensor declaration, feature routing and caller-selected fusion.
// Observe the running source through observe/sensor-flow-run.bml.
// preludes: form-stdlib/world-sensor-floor.fk form-stdlib/bml/live.bml
section [form.bml] {
 class SensorOrgan {
  def so-organ(name,plane,carrier) = list("sensor-organ",name,plane,carrier);
  def so-name(organ) = nth(organ,1);
  def so-plane(organ) = nth(organ,2);
  def so-carrier(organ) = nth(organ,3);
  def so-port(organ) = wsf-sensor(so-carrier(organ),so-plane(organ));
  def so-read(organ,feature,sample) = feature(sample);
  def so-route(organ,feature,sample,confidence) = wsf-route(so-port(organ),so-read(organ,feature,sample),confidence);
  def so-route-all(organ,feature,samples,confidence) {
   def route(sample) = so-route(organ,feature,sample,confidence);
   map(route,samples);
  }
  def so-observe(organ,feature,fuse,samples,confidence) {
   def run(context) = fuse(so-route-all(organ,feature,samples,confidence));
   def completed(value,context) = !nothing?(value);
   // This signal establishes completion on supplied samples, not sensor accuracy.
   let observed = live-do(so-name(organ),"sample-fusion",empty,run,completed,empty);
   if head(observed) then nth(observed,1) else form_error(str_concat(so-name(organ),": sample fusion did not complete"));
  }
  def so-afferent?(organ) = wsf-afferent?(so-port(organ));
  def so-answers?(organ,plane) = ((String) so-plane(organ) == plane);
 }
 0;
}
