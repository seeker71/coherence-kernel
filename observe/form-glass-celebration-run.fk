; form-glass-celebration-run.fk — make shared celebration observable in Glass.
;
; The felt offer below is a fixture for this runner, not a claim about a person.
; Living callers offer their own felt word through the receipt interface.
; preludes: form/form-stdlib/bml/form-glass-celebration.bml

(do
    (defn fgcr-bit (condition bit) (if condition bit 0))
    (let change (fgc-change "walk-home" "economy" "8" "9"))
    (let ice (fgc-change "glass" "ice" "0" "1"))
    (let awaiting (fgc-receive change (list)))
    (let gift (fgc-receive ice (list)))
    (let fixture-felt (fgc-felt "fixture" "walk-home" "economy" "received"))
    (let celebrated (fgc-receive change fixture-felt))
    (framebuffer-clear)
    (fb_record (intern_trivial_string (fgc-receipt-state awaiting))
        "form/form-stdlib/bml/form-glass-celebration.bml" 1)
    (fb_record (intern_trivial_string (fgc-receipt-state gift))
        "form/form-stdlib/bml/form-glass-celebration.bml" 2)
    (fb_record (intern_trivial_string (fgc-receipt-state celebrated))
        "form/form-stdlib/bml/form-glass-celebration.bml" 3)
    (let events (framebuffer-events))
    (print (list "glass-celebration"
        "awaiting" (fgc-receipt-state awaiting)
        "gift" (fgc-receipt-state gift)
        "received" (fgc-receipt-state celebrated)
        "line" (fgc-line celebrated)
        "events" (len events)))
    (sum (list
        (fgcr-bit (str_eq (fgc-receipt-state awaiting) "awaiting-felt") 1)
        (fgcr-bit (str_eq (fgc-receipt-state gift) "gift-received") 2)
        (fgcr-bit (str_eq (fgc-receipt-state celebrated) "celebrated") 4)
        (fgcr-bit (eq (len events) 3) 8)
        (fgcr-bit (str_eq (nth (node_source (head events)) 0)
            "form/form-stdlib/bml/form-glass-celebration.bml") 16))))
