; qwen38-semantic-compression-map.fk — price resident task forms in the local
; Qwen tokenizer before spending a physical Metal turn.
;
; stdin: sealed Qwen3.8 GGUF path. This opens no model context and dispatches
; no Metal work. It maps exactly the external task-role crossing which begins
; after the resident's READY stop: one pending stop ID plus the role tail.
;
; The two-coordinate row remains a reachable comparison, not a promoted form.
; The reference/action values are interned dynamically; no symbol or function
; table allocates their identities.
; preludes: form-stdlib/form-cli-peer-agent.fk

(do
    (defn qscm-line (name value)
        (print_str (str_concat "semantic-map "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn qscm-int (name value) (qscm-line name (int_to_str value)))
    (defn qscm-task-role-ids (src text)
        ; READY is a stop ID. fcms-crossing-prefix-ids retains it and does not
        ; append another close before fcms-tool-tail-ids opens the next role.
        (add 1 (len (fcms-tool-tail-ids src text))))
    (defn qscm-two-coordinate-surface (task-ref action-ref)
        (do
            (let verb (node_value (head (node_children action-ref))) )
            (let task (frex-node-coordinate task-ref))
            (let action (frex-node-coordinate action-ref))
            (str_concat "(agent-task "
            (str_concat verb
            (str_concat " "
            (str_concat task
            (str_concat " "
            (str_concat action ")"))))))))

    (let path (read_line))
    (if (or (nothing? path) (str_eq path ""))
        (qscm-line "status" "nothing-model-path-absent")
        (do
            (let src (fcmg-src path))
            (let task-ref (fcpa-task-ref "repo-patch" "held-patch"))
            (let action-ref (fcpa-action-ref "emit-exact-frame"))
            (let two (qscm-two-coordinate-surface task-ref action-ref))
            (let one (fcpa-task-ref-surface task-ref action-ref))
            (qscm-line "status" "value")
            (qscm-line "two-surface" two)
            (qscm-int "two-bytes" (str_len two))
            (qscm-int "two-role-ids" (qscm-task-role-ids src two))
            (qscm-line "one-surface" one)
            (qscm-int "one-bytes" (str_len one))
            (qscm-int "one-role-ids" (qscm-task-role-ids src one))
            (qscm-int "bytes-saved" (sub (str_len two) (str_len one)))
            (qscm-int "ids-saved" (sub (qscm-task-role-ids src two)
                (qscm-task-role-ids src one)))
            1)))
