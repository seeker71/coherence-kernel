; form-glass-run.fk — the glass carrier. Run it in the terminal the glass should
; paint: ./fkwu observe/form-glass-run.fk
;
; It lowers its own priority, stands the two frame processes beside the glass
; (observe/form-glass-sensors-live.fk at its slow cadences, observe/form-glass-
; machine-live.fk every 50 ms), and runs the glass in a loop: staged startup,
; launch admission, governor refresh, the live loop; when the live loop ends
; the supervisor decides (fglu-supervisor-restart?, the same door
; observe/form-glass-supervisor-restart-run.fk answers alone) -- 0 abstains and
; ends the carrier, 1 rebirths after 250 ms. Every child is an argv spawned by
; the kernel itself; no shell reads any of it, and the frame processes are
; quiet so the terminal stays the glass's own. Ending the carrier ends both.
;
; preludes: form/form-stdlib/form-glass-launch.bml

(do
    (defn fgr-run (args) (host_wait (host_spawn args)))
    (defn fgr-step (args) (if (eq (fgr-run args) 0) 1 (do (host_sleep_ms 1000) 0)))
    (defn fgr-admit ()
        (if (eq (fgr-step (list "./fkwu" "observe/form-glass-staged-startup-run.fk")) 0) 0
            (if (eq (fgr-step (list "./fkwu" "form/form-stdlib/form-glass-launch.bml")) 0) 0
                (if (eq (fgr-step (list "./fkwu" "observe/form-glass-launch-run.fk")) 0) 0
                    (fgr-step (list "./fkwu" "observe/form-resource-governor-glass-current-run.fk"))))))
    (defn fgr-end (sensors machine) (do (host_kill sensors) (host_kill machine) 0))
    (defn fgr-loop (sensors machine)
        (if (eq (fgr-admit) 0) (fgr-loop sensors machine)
            (do (let lived (fgr-run (list "./fkwu" "observe/form-glass-live-run.fk")))
                (if (eq (fglu-supervisor-restart?) 0) (fgr-end sensors machine)
                    (do (print "Form Glass supervisor: rebirthing after 250ms")
                        (host_sleep_ms 250)
                        (fgr-loop sensors machine))))))
    (let niced (host_nice 19))
    (let sensors (host_spawn_quiet (list "./fkwu" "observe/form-glass-sensors-live.fk")))
    (let machine (host_spawn_quiet (list "./fkwu" "observe/form-glass-machine-live.fk")))
    (fgr-loop sensors machine))
