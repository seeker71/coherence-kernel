; form-glass-run.fk — the glass carrier. Run it in the terminal the glass should
; paint: ./fkwu observe/form-glass-run.fk
; preflight-exec: forbidden
;
; It wakes the ear unless someone chose otherwise (fgr-ear-wake: .hearth/ear.slept
; is that choice, written by the glass's z key), lowers its own priority, stands the
; three frame processes beside the glass
; (observe/form-glass-sensors-live.fk at its slow cadences, observe/form-glass-
; machine-live.fk every 50 ms, observe/form-glass-organs-live.fk every 500 ms),
; and runs the glass in a loop: staged startup,
; launch admission, governor refresh, the live loop; when the live loop ends
; the supervisor decides (fglu-supervisor-restart?, the same door
; observe/form-glass-supervisor-restart-run.fk answers alone) -- 0 abstains and
; ends the carrier, 1 rebirths after 250 ms. Every child is an argv spawned by
; the kernel itself; no shell reads any of it, and the frame processes are
; quiet so the terminal stays the glass's own. Ending the carrier ends all three.
;
; preludes: form/form-stdlib/form-glass-launch.bml

(do
    (defn fgr-run (args) (do (let pid (host_spawn args)) (if (gt pid 0) (host_wait pid) -1)))
    (defn fgr-step (args) (if (eq (fgr-run args) 0) 1 (do (host_sleep_ms 1000) 0)))
    (defn fgr-admit ()
        (if (eq (fgr-step (list "./fkwu" "observe/form-glass-staged-startup-run.fk")) 0) 0
            (if (eq (fgr-step (list "./fkwu" "form/form-stdlib/form-glass-launch.bml")) 0) 0
                (if (eq (fgr-step (list "./fkwu" "observe/form-glass-launch-run.fk")) 0) 0
                    (fgr-step (list "./fkwu" "observe/form-resource-governor-glass-current-run.fk"))))))
    ; A body that hears is the default. The ear sensor stands its mic while .hearth/ear.wanted is
    ; present, so the carrier writes that marker at birth -- unless .hearth/ear.slept stands, which
    ; is the mark a hand at the glass leaves when it presses z. A choice to be unheard persists
    ; across every rebirth, every login and every self-molt; the absence of that choice does not
    ; mean silence, it means nobody has asked for it.
    (defn fgr-ear-wake ()
        (do (let mk (fs-mkdir ".hearth"))
            (if (ge (file_size ".hearth/ear.slept") 0) 0
                (if (ge (file_size ".hearth/ear.wanted") 0) 1
                    (if (ge (write_file_text ".hearth/ear.wanted" "en pt fa id") 0) 1 0)))))
    (defn fgr-stop (pid) (if (gt pid 0) (do (host_kill pid) (host_wait pid)) -1))
    (defn fgr-end (sensors machine organs ear) (do (fgr-stop sensors) (fgr-stop machine) (fgr-stop organs) (fgr-stop ear) 0))
    (defn fgr-loop (sensors machine organs ear admitted)
        (if (eq (if admitted 1 (fgr-admit)) 0) (fgr-loop sensors machine organs ear 0)
            (do (let identity (fglu-dependency-manifest))
                (let lived (fgr-run (list "./fkwu" "observe/form-glass-live-run.fk")))
                (if (eq (fglu-supervisor-restart?) 0) (fgr-end sensors machine organs ear)
                    (do
                        (host_sleep_ms 250)
                        (if (str_eq identity (fglu-dependency-manifest))
                            (fgr-loop sensors machine organs ear 1)
                            (do (fgr-end sensors machine organs ear) (fgr-begin))))))))
    (defn fgr-begin ()
        (do
            (let sensors (host_spawn_quiet (list "./fkwu" "observe/form-glass-sensors-live.fk")))
            (let machine (host_spawn_quiet (list "./fkwu" "observe/form-glass-machine-live.fk")))
            (let organs (host_spawn_quiet (list "./fkwu" "observe/form-glass-organs-live.fk")))
            (let ear (host_spawn_quiet (list "./fkwu" "observe/form-glass-ear-live.fk")))
            (if (and (gt sensors 0) (and (gt machine 0) (and (gt organs 0) (gt ear 0))))
                (fgr-loop sensors machine organs ear 0)
                (do (print "Glass sensor spawn refused; retrying")
                    (fgr-end sensors machine organs ear) (host_sleep_ms 1000) (fgr-begin)))))
    (let niced (host_nice 19))
    (let hearing (fgr-ear-wake))
    (fgr-begin))
