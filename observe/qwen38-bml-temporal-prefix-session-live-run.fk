; qwen38-bml-temporal-prefix-session-live-run.fk -- EFFECTFUL LIVE CROSSING.
;
; A resident local Qwen prediction remains pending until the scannerless BMF
; cursor accepts its decoded bytes. Rejection restores the immutable BML
; checkpoint; semantic execution returns mechanically distinct nothing/zero/one
; movement. Attention arrives in renewable one-token pulses. A pulse is not a fixed
; target: correlated framebuffer control expands it until the physical model
; context or another observed terminal state answers.
;
; DO NOT PREFLIGHT THIS FILE. Preflight executes top-level forms on this lane.
; Run only while no sibling owns the local Qwen/Metal carrier. No prompt or
; candidate bytes enter framebuffer telemetry; stdout carries the embodied BML.
;
; preludes: form-stdlib/form-cli-bml-prefix-session.fk
; preludes: form-stdlib/form-knowledge-bml-temporal-challenge.fk
; preludes: form-stdlib/form-cli-bml-flow-control.fk
; preludes: observe/bidirectional-framebuffer-channel.fk
; preludes: observe/framebuffer-runtime-live-stream.fk
; preludes: observe/form-membrane-runtime-census.fk

(do
    (defn qbt-path ()
        "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (defn qbt-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn qbt-int (name value) (qbt-line name (int_to_str value)))
    (defn qbt-bit (ok bit) (if ok bit 0))

    ; Snapshot = wall time, exact Form kernel counters, Metal carrier status,
    ; MLX carrier status. The Qwen path is expected to move Metal and leave MLX
    ; at zero; observing that is stronger than inferring it from architecture.
    (defn qbt-snapshot ()
        (list (now_unix_ms) (fbro-snapshot) (metal_status) (mlx_status)))
    (defn qbt-metal-delta (before after field)
        (sub (mbw-status-int (nth after 2) field)
             (mbw-status-int (nth before 2) field)))
    (defn qbt-mlx-delta (before after field)
        (sub (mbw-status-int (nth after 3) field)
             (mbw-status-int (nth before 3) field)))
    (defn qbt-busy-permille (busy-us wall-ms)
        (if (le wall-ms 0) 0 (div busy-us wall-ms)))
    (defn qbt-stage
        (stage parent before after status metric value line)
        (do
            (let event (fbro-stage-observed-stream
                "qwen38-bml-temporal-prefix-v1" stage parent
                "local-qwen38+form" "resident-native-crossing"
                "observe-where-time-lives" "continue-from-same-checkpoint"
                (nth before 1) (nth after 1) metric value status
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                line 1))
            (print_str "\n")
            (let wall-ms (sub (nth after 0) (nth before 0)))
            (let gpu-us (qbt-metal-delta before after "gpu_busy_us_total"))
            (let cpu-jit-us
                (qbt-metal-delta before after "cpu_jit_busy_us_total"))
            (qbt-line "carrier-stage" (fbrols-cat (list
                "stage=" stage
                "|status=" status
                "|wall-ms=" (int_to_str wall-ms)
                "|metal-dispatch=" (int_to_str
                    (qbt-metal-delta before after "total_dispatch"))
                "|metal-sync=" (int_to_str
                    (qbt-metal-delta before after "total_sync"))
                "|gpu-busy-us=" (int_to_str gpu-us)
                "|gpu-wall-permille=" (int_to_str
                    (qbt-busy-permille gpu-us wall-ms))
                "|cpu-jit-dispatch=" (int_to_str
                    (qbt-metal-delta before after "cpu_jit_dispatch"))
                "|cpu-jit-busy-us=" (int_to_str cpu-jit-us)
                "|cpu-jit-wall-permille=" (int_to_str
                    (qbt-busy-permille cpu-jit-us wall-ms))
                "|mlx-dispatch=" (int_to_str
                    (qbt-mlx-delta before after "mlx_dispatch"))
                "|pipelines-after=" (int_to_str
                    (mbw-status-int (nth after 2) "pipelines")))))
            event))

    (defn qbt-membrane-delta-line (row index)
        (qbt-line "membrane-crossing" (fbrols-cat (list
            "index=" (int_to_str index)
            "|primitive=" (fmrc-delta-name row)
            "|tag=" (int_to_str (fmrc-delta-tag row))
            "|plane=" (fmrc-delta-plane row)
            "|dispatches=" (int_to_str (fmrc-delta-count row))
            "|before=" (int_to_str (fmrc-delta-before row))
            "|after=" (int_to_str (fmrc-delta-after row))))))
    (defn qbt-membrane-delta-lines (rows index)
        (if (nil? rows) 0
            (do
                (let line (qbt-membrane-delta-line (head rows) index))
                (qbt-membrane-delta-lines (tail rows) (add index 1)))))
    (defn qbt-membrane-close (window outcome line)
        (do
            (let observed (fmrc-close window outcome
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                line 1))
            (let deltas (fmrc-result-deltas observed))
            (qbt-line "membrane-stage" (fbrols-cat (list
                "trace=" (fmrc-window-trace window)
                "|purpose=" (fmrc-window-purpose window)
                "|status=" (fmrc-result-status observed)
                "|moved-primitives=" (int_to_str (len deltas))
                "|effect-dispatches=" (int_to_str
                    (fmrc-delta-total deltas)))))
            (qbt-membrane-delta-lines deltas 0)
            observed))

    (defn qbt-status-code (result)
        (if (str_eq (fcbps-status result) "complete") 1
        (if (str_eq (fcbps-status result) "bounded") 2
        (if (str_eq (fcbps-status result) "timeout") 3
        (if (str_eq (fcbps-status result) "failure") 4
        (if (str_eq (fcbps-status result) "nothing") 0 5))))))
    (defn qbt-control-action (result)
        (fcbfc-control-action result))
    (defn qbt-control (result exchange)
        (do
            (let signal (fcbfc-observe result))
            ; Aggregate movement only: no prompt, candidate, or decoded token.
            (let outbound (bfc-envelope 0 exchange 0
                (list (qbt-status-code result)
                    (fcbps-offers result) (fcbps-cuts result)
                    (fcbps-undos result) (fcbps-timeouts result)
                    (fcbps-failures result) (fcbps-refinements result)
                    (len (fcbps-attempt-ids result))
                    (fcbfc-period signal) (fcbfc-repetitions signal)) 0))
            (let out-event (bfc-record-out outbound (mul exchange 2)))
            (let inbound (bfc-control outbound (qbt-control-action result)))
            (let in-event (bfc-record-in inbound (add (mul exchange 2) 1)))
            (list outbound inbound
                (bfc-apply outbound inbound 1 0) signal)))

    (defn qbt-baseline (session)
        (fcbps-result "open" "prefill-complete" session "" (empty)
            0 0 0 0 0 0 0 (oac-tag-nothing) (empty)
            (blc-fresh 256 (fcbpc-default-material-cap))))
    (defn qbt-offer-live (result parser-fuel exchange)
        (do
            (let session (fcbps-session result))
            (let event (intern_node_at (bp "FRAMEBUFFER-BML-CURSOR-OFFER")
                (list
                    (intern_trivial_string "offer")
                    (intern_trivial_string (fcbps-status result))
                    (intern_trivial_string (fcbps-reason result))
                    (intern_trivial_int exchange)
                    (intern_trivial_int (fcms-pos session))
                    (intern_trivial_int (fcms-pending session))
                    (intern_trivial_int (str_len (fcbps-prefix result)))
                    (intern_trivial_int (blc-pos (fcbps-cursor result)))
                    (intern_trivial_int (blc-material-cap
                        (fcbps-cursor result)))
                    (intern_trivial_int parser-fuel))
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                118 1))
            (qbt-line "cursor-offer" (fbrols-cat (list
                "exchange=" (int_to_str exchange)
                "|status=" (fcbps-status result)
                "|reason=" (fcbps-reason result)
                "|session-pos=" (int_to_str (fcms-pos session))
                "|pending-token-id=" (int_to_str (fcms-pending session))
                "|prefix-bytes=" (int_to_str (str_len (fcbps-prefix result)))
                "|cursor-logical-pos=" (int_to_str
                    (blc-pos (fcbps-cursor result)))
                "|material-cap=" (int_to_str
                    (blc-material-cap (fcbps-cursor result)))
                "|parser-fuel=" (int_to_str parser-fuel))))
            event))
    (defn qbt-trace-frame-text (frame)
        (fbrols-cat (list
            (gsp-frame-kind frame) ":" (gsp-frame-name frame)
            "@" (int_to_str (gsp-frame-start frame))
            "-" (int_to_str (gsp-frame-finish frame))
            "[" (gsp-frame-status frame) "]")))
    (defn qbt-trace-text-go (trace left)
        (if (nil? trace) ""
            (if (le left 0) "..."
                (str_concat (qbt-trace-frame-text (head trace))
                    (if (nil? (tail trace)) ""
                        (str_concat ">"
                            (qbt-trace-text-go (tail trace)
                                (sub left 1))))))))
    (defn qbt-trace-text (trace)
        (if (nil? trace) "none" (qbt-trace-text-go trace 16)))
    (defn qbt-live-event (event exchange index)
        (do
            (let trace (fcbps-event-trace event))
            (let trace-text (qbt-trace-text trace))
            (let recorded (intern_node_at
                (bp "FRAMEBUFFER-BML-CURSOR-MOVEMENT")
                (list
                    (intern_trivial_string (fcbps-event-kind event))
                    (intern_trivial_string (fcbps-event-reason event))
                    (intern_trivial_int exchange)
                    (intern_trivial_int index)
                    (intern_trivial_int (fcbps-event-token event))
                    (intern_trivial_int (fcbps-event-prefix-bytes event))
                    (intern_trivial_int (len trace))
                    (intern_trivial_string trace-text))
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                143 1))
            (qbt-event-line event index)
            recorded))
    (defn qbt-live-new-events (events index exchange)
        (if (ge index (len events)) 0
            (do
                (let recorded (qbt-live-event (nth events index) exchange index))
                (qbt-live-new-events events (add index 1) exchange))))
    (defn qbt-movement-live (before after exchange)
        (do
            (let sb (fcbps-session before))
            (let sa (fcbps-session after))
            (let prefix-before (str_len (fcbps-prefix before)))
            (let prefix-after (str_len (fcbps-prefix after)))
            (let injected-delta
                (sub (fcms-injected-ids sa) (fcms-injected-ids sb)))
            (let observation-delta
                (sub (fcms-observations sa) (fcms-observations sb)))
            (let event (intern_node_at (bp "FRAMEBUFFER-BML-MOVEMENT-SUMMARY")
                (list
                    (intern_trivial_string (fcbps-status after))
                    (intern_trivial_string (fcbps-reason after))
                    (intern_trivial_int exchange)
                    (intern_trivial_int prefix-before)
                    (intern_trivial_int prefix-after)
                    (intern_trivial_int
                        (sub (fcbps-offers after) (fcbps-offers before)))
                    (intern_trivial_int
                        (sub (fcbps-cuts after) (fcbps-cuts before)))
                    (intern_trivial_int
                        (sub (fcbps-undos after) (fcbps-undos before)))
                    (intern_trivial_int
                        (sub (fcbps-timeouts after) (fcbps-timeouts before)))
                    (intern_trivial_int
                        (sub (fcbps-refinements after)
                             (fcbps-refinements before)))
                    (intern_trivial_int injected-delta)
                    (intern_trivial_int observation-delta))
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                180 1))
            (qbt-live-new-events (fcbps-events after)
                (len (fcbps-events before)) exchange)
            (qbt-line "cursor-move" (fbrols-cat (list
                "exchange=" (int_to_str exchange)
                "|status=" (fcbps-status after)
                "|reason=" (fcbps-reason after)
                "|prefix-before=" (int_to_str prefix-before)
                "|prefix-after=" (int_to_str prefix-after)
                "|offers-delta=" (int_to_str
                    (sub (fcbps-offers after) (fcbps-offers before)))
                "|cuts-delta=" (int_to_str
                    (sub (fcbps-cuts after) (fcbps-cuts before)))
                "|undos-delta=" (int_to_str
                    (sub (fcbps-undos after) (fcbps-undos before)))
                "|timeouts-delta=" (int_to_str
                    (sub (fcbps-timeouts after) (fcbps-timeouts before)))
                "|failures-delta=" (int_to_str
                    (sub (fcbps-failures after) (fcbps-failures before)))
                "|refinements-delta=" (int_to_str
                    (sub (fcbps-refinements after)
                         (fcbps-refinements before)))
                "|generated-ids-delta=" (int_to_str
                    (sub (fcms-generated-ids sa) (fcms-generated-ids sb)))
                "|injected-ids-delta=" (int_to_str injected-delta)
                "|observations-delta=" (int_to_str observation-delta)
                "|session-pos=" (int_to_str (fcms-pos sa))
                "|pending-token-id=" (int_to_str (fcms-pending sa)))))
            (if (gt observation-delta 0)
                (qbt-line "observation-crossing" (fbrols-cat (list
                    "exchange=" (int_to_str exchange)
                    "|injected-ids=" (int_to_str injected-delta)
                    "|observations=" (int_to_str observation-delta)
                    "|generated-id-retained=" (int_to_str
                        (sub (fcms-generated-ids sa)
                             (fcms-generated-ids sb)))
                    "|next-pending-token-id="
                        (int_to_str (fcms-pending sa))))) 0)
            event))

    ; No arbitrary global turn count lives here. Each continuation is newly
    ; correlated, while the physical context, candidate bytes and parser fuel
    ; remain visible state transitions rather than a hidden promise.
    (defn qbt-flow (result pulse material-cap parser-fuel exchange)
        (if (and (not (eq (fcbps-retryable? result) 1))
                 (and (not (eq (fcbps-expandable? result) 1))
                      (not (eq (fcbps-capacity-expandable? result) 1)))) result
            (do
                (let offer-event (qbt-offer-live result parser-fuel exchange))
                (let control (qbt-control result exchange))
                (let action (bfc-payload (nth control 1)))
                (if (eq action 4)
                    (do
                        (let held (fcbfc-timeout-hold result (nth control 3)))
                        (let movement-event
                            (qbt-movement-live result held exchange))
                        held)
                (if (not (eq (nth control 2) 1)) result
                    (do
                        (let membrane (fmrc-open
                            (str_concat "qwen38-bml-movement-"
                                (int_to_str exchange))
                            "token+bmf+movement"
                            "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                            272 1))
                        (let before (qbt-snapshot))
                        (let next (if (eq (fcbps-retryable? result) 1)
                            (fcbps-retry-timeout result pulse pulse material-cap
                                (mul parser-fuel 2) fktwt-judge)
                            (if (eq (fcbps-capacity-expandable? result) 1)
                                (fcbps-expand-material result
                                    (mul material-cap 2) pulse pulse
                                    parser-fuel fktwt-judge)
                                (fcbps-expand result pulse pulse material-cap
                                    parser-fuel fktwt-judge))))
                        (let after (qbt-snapshot))
                        (let membrane-observed (qbt-membrane-close membrane
                            (fcbps-status next) 284))
                        (let stage-event (qbt-stage "token+bmf+movement"
                            "open+prefill" before after (fcbps-status next)
                            "accepted-prefix-bytes" (str_len (fcbps-prefix next))
                            92))
                        (let movement-event
                            (qbt-movement-live result next exchange))
                        (qbt-flow next pulse
                            (if (eq (fcbps-capacity-expandable? result) 1)
                                (mul material-cap 2) material-cap)
                            (if (eq (fcbps-retryable? result) 1)
                                (mul parser-fuel 2) parser-fuel)
                            (add exchange 1))))))))

    (defn qbt-event-line (event index)
        (qbt-line "movement-event"
            (str_concat (int_to_str index)
            (str_concat "|kind="
            (str_concat (fcbps-event-kind event)
            (str_concat "|reason="
            (str_concat (fcbps-event-reason event)
            (str_concat "|token-id="
            (str_concat (int_to_str (fcbps-event-token event))
            (str_concat "|prefix-bytes="
            (str_concat (int_to_str (fcbps-event-prefix-bytes event))
            (str_concat "|bmf-trace-depth="
            (str_concat (int_to_str (len (fcbps-event-trace event)))
            (str_concat "|bmf-rule-stack="
                (qbt-trace-text (fcbps-event-trace event))))))))))))))))
    (defn qbt-events-from (events index)
        (if (ge index (len events)) 0
            (do
                (let line (qbt-event-line (nth events index) index))
                (qbt-events-from events (add index 1)))))
    (defn qbt-tail-start (events)
        (if (gt (len events) 32) (sub (len events) 32) 0))

    (framebuffer-clear)
    (let started (now_unix_ms))
    (let open-membrane (fmrc-open "qwen38-bml-open-prefill"
        "local-model-open+prefill"
        "observe/qwen38-bml-temporal-prefix-session-live-run.fk" 330 1))
    (let open-before (qbt-snapshot))
    (qbt-line "carrier-stage" "stage=open+prefill|status=begin")
    (let opened (fcms-open (qbt-path) (fktwt-prompt) 8192))
    (let open-after (qbt-snapshot))
    (let open-membrane-observed (qbt-membrane-close open-membrane
        (fcms-status opened) 337))
    (let open-event (qbt-stage "open+prefill" "start" open-before open-after
        (fcms-status opened) "prompt-ids" (fcms-prompt-ids opened) 151))
    (let open-ms (sub (now_unix_ms) started))
    (if (not (eq (fcms-live? opened) 1))
        (do
            (qbt-line "status" (fcms-status opened))
            (qbt-line "reason" (fcms-reason opened))
            (qbt-int "open-ms" open-ms)
            (qbt-int "release-ok" (fcms-release-ok? opened))
            0)
        (do
            (let pulse 1)
            (let material-cap (mul (fcms-maxpos opened) 16))
            (let baseline (qbt-baseline opened))
            (let first-offer (qbt-offer-live baseline 131072 825))
            (let first-membrane (fmrc-open "qwen38-bml-movement-825"
                "token+bmf+movement"
                "observe/qwen38-bml-temporal-prefix-session-live-run.fk"
                360 1))
            (let first-before (qbt-snapshot))
            (let first (fcbps-run opened pulse pulse material-cap 131072
                fktwt-judge))
            (let first-after (qbt-snapshot))
            (let first-membrane-observed (qbt-membrane-close first-membrane
                (fcbps-status first) 369))
            (let first-event (qbt-stage "token+bmf+movement" "open+prefill"
                first-before first-after (fcbps-status first)
                "accepted-prefix-bytes" (str_len (fcbps-prefix first)) 169))
            (let first-movement (qbt-movement-live baseline first 825))
            (let moved (qbt-flow first pulse material-cap 131072 826))
            ; The second correlated exchange is the required re-observation of
            ; the state after all authorized continuation/expansion actions.
            (let final-control (qbt-control moved 927))
            (let ended (now_unix_ms))
            (let session (fcbps-session moved))
            (let events (fcbps-events moved))
            (let candidate (fcbps-prefix moved))

            (qbt-line "status" (fcbps-status moved))
            (qbt-line "reason" (fcbps-reason moved))
            (qbt-line "semantic-kind" (fcbps-semantic-kind moved))
            (qbt-int "open-ms" open-ms)
            (qbt-int "movement-ms" (sub ended (add started open-ms)))
            (qbt-int "prompt-ids" (fcms-prompt-ids session))
            (qbt-int "generated-ids" (fcms-generated-ids session))
            (qbt-int "injected-ids" (fcms-injected-ids session))
            (qbt-int "observations" (fcms-observations session))
            (qbt-int "candidate-ids" (len (fcbps-attempt-ids moved)))
            (qbt-int "candidate-bytes" (str_len candidate))
            (qbt-int "offers" (fcbps-offers moved))
            (qbt-int "cuts" (fcbps-cuts moved))
            (qbt-int "undos" (fcbps-undos moved))
            (qbt-int "timeouts" (fcbps-timeouts moved))
            (qbt-int "failures" (fcbps-failures moved))
            (qbt-int "refinements" (fcbps-refinements moved))
            (qbt-int "derived-releases" (fcbps-releases moved))
            (qbt-int "movement-events" (len events))
            (qbt-int "framebuffer-events" (len (framebuffer-events)))
            (qbt-line "generated-id-policy" (fcms-generated-id-policy))
            (qbt-line "rejection-pending-policy"
                (fcms-rejection-pending-policy))
            (qbt-line "candidate-sha256"
                (if (eq (str_len candidate) 0) "none" (nmfe-sha256 candidate)))
            (print_str "candidate-bml-begin\n")
            (print_str candidate)
            (if (or (eq (str_len candidate) 0)
                    (str_eq (substring candidate (sub (str_len candidate) 1)
                        (str_len candidate)) "\n")) 0
                (print_str "\n"))
            (print_str "candidate-bml-end\n")
            (qbt-events-from events (qbt-tail-start events))
            (let release-ok (fcms-release-ok? session))
            (qbt-int "release-ok" release-ok)
            (sum (list
                (qbt-bit (eq release-ok 1) 1)
                (qbt-bit (str_eq (fcbps-status moved) "complete") 2)
                (qbt-bit (eq (fcbps-semantic-kind moved) (oac-tag-one)) 4)
                (qbt-bit (gt (fcbps-cuts moved) 0) 8)
                (qbt-bit (eq (fktwt-candidate-safe? candidate) 1) 16)
                (qbt-bit (eq (fcms-model-executed-form?) 0) 32)
                (qbt-bit (ge (len (framebuffer-events)) 2) 64))))))
