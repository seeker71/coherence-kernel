; qwen38-axioms-nodeid-actuator-live-run.fk -- minimal physical NodeID binding.
;
; The generic hourly tick remains a separate orchestration/wake concern.  This
; dormant carrier binds the exact axioms health identity plus action NodeID to
; the already-observed `fka1l-run` physical recipe without importing the health
; pulse graph.  The full recipe retains model, Metal, framebuffer, release and
; crossing-validation ownership.
;
; Running without the exact request-bound marker opens no model or carrier.
; No registry, ops table, flattening, remote lane, or C growth participates.
;
; preludes: form-stdlib/form-local-axioms-actuator-request.fk
; preludes: observe/qwen38-axioms-one-family-complete-live-run.fk form-stdlib/model-registry.bml

(do
    (defn fkan-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkan-model-id () "Qwen3.8-27B-Q8_0-local")
    (defn fkan-request ()
        (flar-request (flar-target) (flar-action)
            (fkan-model-path) (fkan-model-id)))
    (defn fkan-action-path () ".form-axioms-nodeid-actuator-consent")
    (defn fkan-action-token ()
        "run-local-qwen-axioms-nodeid-actuator-v1:identity=axioms-resident-one-family-crossing:node=31.2.0.109:model=Qwen3.8-27B-Q8_0-local")
    (defn fkan-action-bound? ()
        (do
            (let supplied (read_file (fkan-action-path)))
            (if (str_eq supplied (fkan-action-token)) 1
                (if (str_eq supplied (str_concat (fkan-action-token) "\n"))
                    1 0))))
    (defn fkan-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn fkan-run-live ()
        (do
            (let request (fkan-request))
            (if (eq (flar-request-valid? request) 0)
                (do (fkan-line "actuator-status" "refused") 0)
                (do
                    (fkan-line "actuator-identity" (flar-identity request))
                    (fkan-line "actuator-nodeid" "31.2.0.109")
                    (let crossing (fka1l-run (flar-path request)
                        (flar-model-id request)))
                    (fkan-line "actuator-status" "applied")
                    (fkan-line "actuator-crossing-present"
                        (if (nothing? crossing) "0" "1"))
                    (fkan-line "actuator-crossing-valid"
                        (if (nothing? crossing) "0"
                            (int_to_str (fka1-crossing-valid? crossing))))
                    0))))
    (if (eq (fkan-action-bound?) 1)
        (fkan-run-live)
        (do
            (print_str "local-Qwen axioms NodeID actuator is dormant; request-bound action token absent\n")
            (print_str (str_concat "required-token="
                (str_concat (fkan-action-token) "\n")))
            0)))
