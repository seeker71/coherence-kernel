; ear-ground-open-probe.fk — where the ear's open actually goes.
; The tongue lane's 20 s cold / 2 s warm is a reported whole; this cuts the EAR's own open into its
; four parts and times each on this machine, warm, so a claim about "a model open" names which part.
; Nothing here writes to the hearth and nothing opens the microphone: it is safe to preflight.
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn egop-snap ()
        (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/"
            (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (defn egop-tok () (enw-tokenizer-path))
    (defn egop-say (label ms) (print_str (str_concat label (str_concat " " (str_concat (int_to_str ms) " ms")))))
    ; the tiktoken index: 51865 lines split into a Form list, once per process
    (let w0 (now_unix_ms))
    (let toktext (en-text (read_file (egop-tok))))
    (let w1 (now_unix_ms))
    (let toklines (split-on toktext (byte_to_str 10)))
    (let w2 (now_unix_ms))
    ; the npz central directory walk
    (let path (str_concat (egop-snap) "/weights.npz"))
    (let rows (en-table path))
    (let w3 (now_unix_ms))
    ; the MSL unit and its sixteen pipelines
    (let unit (em-unit))
    (let w4 (now_unix_ms))
    (let ps (enw-pipes))
    (let w5 (now_unix_ms))
    ; the whole file mapped and each member copied on the device
    (let whole (metal_buf_from_file path 0 (file_size path)))
    (let w6 (now_unix_ms))
    (let hs (enw-map ps whole rows))
    (let sy (metal_sync))
    (let w7 (now_unix_ms))
    ; the activations
    (let bs (enw-bufs))
    (let w8 (now_unix_ms))
    (print_str "--- the ear's open, part by part ---")
    (egop-say "read the tiktoken file        " (sub w1 w0))
    (egop-say "split it into 51865 lines     " (sub w2 w1))
    (egop-say "npz central directory         " (sub w3 w2))
    (egop-say "build the MSL unit text       " (sub w4 w3))
    (egop-say "compile 16 metal pipelines    " (sub w5 w4))
    (egop-say "map the weights file          " (sub w6 w5))
    (egop-say "copy every member on device   " (sub w7 w6))
    (egop-say "allocate the activations      " (sub w8 w7))
    (egop-say "OPEN TOTAL                    " (sub w8 w0))
    (print_str (str_concat "tiktoken lines " (int_to_str (len toklines))))
    (print_str (str_concat "npz members    " (int_to_str (len rows))))
    (print_str (str_concat "msl unit bytes " (int_to_str (str_len unit))))
    ; and the cost the index charges EVERY token: nth over the line list
    (let n0 (now_unix_ms))
    (let l0 (nth toklines 50000))
    (let l1 (nth toklines 50000))
    (let l2 (nth toklines 50000))
    (let l3 (nth toklines 50000))
    (let l4 (nth toklines 50000))
    (let l5 (nth toklines 50000))
    (let l6 (nth toklines 50000))
    (let l7 (nth toklines 50000))
    (let l8 (nth toklines 50000))
    (let l9 (nth toklines 50000))
    (let n1 (now_unix_ms))
    (egop-say "ten nth of a late token line  " (sub n1 n0))
    0)
