; fullstack-matvec-probe.fk — every layer's gate/up/down matvec, all 65 layers,
; barriered in one command buffer: 18.5 GB of UNIQUE weight bytes, the same
; stream a real forward reads. The single-tensor chain probe answered 500 GB/s,
; but 64 passes over one 94.7 MB tensor can ride the SLC; a real forward never
; reads the same byte twice. This is the number the serial-chain probe could
; not give.
;
; preludes: native/metal/qwen35-dense-token-handle.fk form-stdlib/model-registry.bml

(do
    (defn fsp-status-int (status name)
        (do (let key (str_concat name "="))
            (let at (str_find status key 0))
            (if (lt at 0) -1
                (do (let start (add at (str_len key)))
                    (let stop (str_find status "\n" start))
                    (if (lt stop 0) -1 (str_to_int (substring status start stop)))))))
    (defn fsp-gpu () (fsp-status-int (metal_status) "gpu_busy_us_total"))
    (defn fsp-mv (ps tv xh yh)
        (metal_enqueue (nth ps 29)
            (md-bind16 (list (kth-tv-h tv) xh yh)
                       (list (kth-tv-r tv) (kth-tv-c tv)) 256 0 1 1)
            (div (add (kth-tv-r tv) 1) 2)))
    (defn fsp-bytes (tv) (mul (mul (kth-tv-r tv) (div (kth-tv-c tv) 32)) 34))
    (defn fsp-layers (ps lays xh yh acc)
        (if (eq (len lays) 0) acc
            (do (let l (head lays))
                (let a (fsp-mv ps (nth l 2) xh yh))
                (let b (fsp-mv ps (nth l 3) xh yh))
                (let c (fsp-mv ps (nth l 4) xh yh))
                (fsp-layers ps (tail lays) xh yh
                    (add acc (add (fsp-bytes (nth l 2))
                             (add (fsp-bytes (nth l 3)) (fsp-bytes (nth l 4)))))))))
    (let st (q38-open (mr-path (mr-find "qwen38-q8")) 256))
    (let ps (nth st 0)) (let lays (nth st 3))
    (let tv (nth (head lays) 2))
    (let xh (metal_buf_alloc (mul 17408 4)))
    (let yh (metal_buf_alloc (mul 17408 4)))
    (let warm1 (metal_batch_concurrent))
    (let warm2 (fsp-layers ps lays xh yh 0))
    (let warms (metal_sync))
    (let g0 (fsp-gpu))
    (let t0 (now_unix_ms))
    (let arm (metal_batch_concurrent))
    (let bytes (fsp-layers ps lays xh yh 0))
    (let sy (metal_sync))
    (let g1 (fsp-gpu))
    (let t1 (now_unix_ms))
    (let us (sub g1 g0))
    (print (str_concat "unique_bytes=" (int_to_str bytes)))
    (print (str_concat "  dispatches=" (int_to_str (mul 3 (len lays)))))
    (print (str_concat "  gpu_us=" (int_to_str us)))
    (print (str_concat "  wall_ms=" (int_to_str (sub t1 t0))))
    (print (str_concat "  gbps_x10=" (int_to_str (if (gt us 0) (div (mul bytes 10) (mul us 1000)) 0))))
    (print "\n")
    0)
