// local-counsel-run.bml — parallel local reasoning as a door any agent can ask: one question, N lenses, one weight pass per step for all of them.
//
//   echo '{"go":1,"question":"…","lenses":["Answer as a safety reviewer.","Answer as a speed engineer."],"gen":160}' | ./fkwu observe/local-counsel-run.bml
//
// The local 27B reads the question once (a user turn, prefilled on one stream), the state is forked by one micro-kernel into a slot per
// lens, and each lens's own text then closes the user turn and opens the assistant's with an empty think block; all lenses decode together,
// so N lines of thought cost one pass over the weights a step (form-stdlib/bml/q38-multi.bml, q38-lenses.bml). The door prints each lens's
// reply with the surprise the model had at its own greedy tokens (micro-nats a token: the confidence it read), and names the lens it was
// surest of. It chooses nothing for the asker: the confidence of a line is not its worth, and a caller who needs a verdict reads them
// itself (observe/local-focus-run.bml and observe/local-kernel-lane-run.bml check theirs by machine). Nothing leaves the machine.
// stdin, one JSON line: go (without it only the plan is said), question (required), lenses (a list of 2..8 strings; default three
// neutral lenses), gen (tokens a lens, default 160). A physical run: it needs the local GPU; another process holding it makes this one wait.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/q38-multi.bml form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/q38-lenses.bml form-stdlib/bml/serve-client.bml native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-dense-spec.fk
section [form.bml] {
 class LocalCounselRun {
  def lcr-say(t) = print_str("[local-counsel] " ++ t ++ "\n");
  def lcr-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("local-counsel", line) : json-node-object([]);
  }
  def lcr-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def lcr-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def lcr-lenses(o) = json-object-has?(o, "lenses") ? map(t => json-string-value(t), json-array-elements(json-object-get(o, "lenses"))) : ["Answer plainly.", "Answer by naming what could go wrong first.", "Answer by naming the smallest first step."];
  // the reply ends at the model's own end-of-turn; the tokens decoded after it (the pass runs the full count) are not part of it
  def lcr-reply(text) {
   let at = str_find(text, "<|im_end|>", 0);
   at < 0 ? text : substring(text, 0, at);
  }
  def lcr-best(sc, i, best) = i >= len(sc) ? best : lcr-best(sc, i + 1, sc[i] < sc[best] ? i : best);
  def lcr-run() {
   let o = lcr-opts();
   let question = lcr-str(o, "question");
   let lenses = lcr-lenses(o);
   len(question) == 0 ? lcr-say("no question: give {\"question\":\"…\"}") : (len(lenses) < 2 || len(lenses) > 8) ? lcr-say("give 2 to 8 lenses") : lcr-int(o, "go", 0) != 1 ? lcr-say("plan: go=1 reads a question of " ++ len(question).str() ++ " bytes through " ++ len(lenses).str() ++ " lenses") : lcr-go(question, lenses, lcr-int(o, "gen", 160));
  }
  // A resident server that stands (observe/qwen-serve-run.bml) holds the GPU lease and the weights: the lenses are asked of it, one request each, and decode beside every
  // other sequence it serves. With none standing the reason is named and this process opens a session of its own, as it always did. (Each lens's request reads the whole question
  // again on the server's prefill lane; a prefix the lenses share is read once only in this process's own session.)
  def lcr-go(question, lenses, gen) {
   let st = svc-standing(svc-default-dir());
   (String) st[0] == "standing" ? lcr-served(question, lenses, gen) : lcr-own(question, lenses, gen, "no server stands (" ++ st[1] ++ ")");
  }
  def lcr-served(question, lenses, gen) {
   let dir = svc-default-dir();
   let ids = map(i => svc-submit(dir, "k" ++ i.str(), svc-spec-json(question, lenses[i], 1, gen, [], 0, "counsel")), range(0, len(lenses)));
   let got = map(id => len(id) == 0 ? ["unserved", "the spool refused the request file"] : svc-wait(dir, id, 0), ids);
   let down = filter(g => (String) g[0] != "answered", got);
   nil?(down) ? lcr-served-say(lenses, map(g => g[1], got)) : lcr-own(question, lenses, gen, "the server did not answer (" ++ down[0][1] ++ ")");
  }
  def lcr-served-say(lenses, docs) {
   let a = lcr-say("served by the resident server: prompt " ++ svc-int(docs[0], "prompt_ids").str() ++ " ids a lens; queue " ++ svc-int(docs[0], "queue_ms").str() ++ " ms, prefill " ++ svc-int(docs[0], "prefill_ms").str() ++ " ms, " ++ svc-int(docs[0], "generated_ids").str() ++ " tokens at " ++ json-emit(json-object-get(docs[0], "decode_tok_s")) ++ " tok/s on lens 0");
   let b = map(i => lcr-say("lens " ++ i.str() ++ " (" ++ lenses[i] ++ ") surprise " ++ svc-int(docs[i], "surprise_micro_nats").str() ++ " micro-nats a token:\n" ++ svc-str(docs[i], "text")), range(0, len(lenses)));
   lcr-say("the model was surest of lens " ++ lcr-best(map(d => svc-int(d, "surprise_micro_nats"), docs), 0, 0).str());
  }
  def lcr-own(question, lenses, gen, why) {
   let said = lcr-say(why ++ "; this process opens a session of its own");
   lcr-go-own(question, lenses, gen);
  }
  def lcr-go-own(question, lenses, gen) {
   // The context is sized from what the call will hold: the question's ids, the longest lens, the generation. Opened small to read the ids, and
   // opened again at the size they need when the small one cannot hold them (a prefix past the positions the KV owns overruns the cache and hangs the GPU).
   let ctx0 = qlz-open(4096);
   let pre = qlz-chat-prefix(ctx0, question);
   let lids = map(t => qlz-chat-lens(ctx0, t, ""), lenses);
   let need = len(pre) + foldl((m, l) => len(l) > m ? len(l) : m, 0, lids) + gen + 64;
   let ctx = need <= 4096 ? ctx0 : { let shut = qlz-close(ctx0); qlz-open(need); };
   let r = qlz-run-ids(ctx, pre, lids, gen);
   let closed = qlz-close(ctx);
   let a = lcr-say("prefix " ++ len(r[2]).str() ++ " ids; prefill " ++ r[3][0].str() ++ " ms, fork " ++ r[3][1].str() ++ " ms, " ++ gen.str() ++ " tokens x " ++ len(lenses).str() ++ " lenses " ++ r[3][2].str() ++ " ms");
   let b = map(i => lcr-say("lens " ++ i.str() ++ " (" ++ lenses[i] ++ ") surprise " ++ r[1][i].str() ++ " micro-nats a token:\n" ++ lcr-reply(r[0][i])), range(0, len(lenses)));
   lcr-say("the model was surest of lens " ++ lcr-best(r[1], 0, 0).str());
  }
 }
 lcr-run();
}
