; sha-run.fk — current-source sha without leakage walk.
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk

(do
    (print_str (str_concat "ki=" (nmfe-sha256 (read_file "form/form-stdlib/knowledge-ingest.fk"))))
    (print_str "\n")
    (print_str (str_concat "current=" (int_to_str (fkh3-all-rows-current? (fkh3-rows)))))
    (print_str "\n")
    (print_str (str_concat "dataset=" (fkh3-dataset-sha256 (fkh3-rows))))
    (print_str "\n")
    0)
