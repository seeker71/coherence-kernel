; primitive-edge-contracts.fk — where the four arms stop agreeing, and vocabulary
; that does not depend on which one is running.
;
; preludes: form/form-stdlib/core.fk
;
; WHAT WAS MEASURED, 2026-07-26. Bands exercise nominal inputs, so the four-way has
; never asked the vocabulary what it does at the edges. Twenty-two edge probes over
; core.fk's surface, each run on fkwu, Go, Rust and TypeScript: fifteen agree, seven
; do not, and the seven are one pattern.
;
;   probe                          fkwu                go / rust / ts
;   (substring "abc" 1 99)         "bc"                out of range, dies
;   (substring "abc" 2 1)          ""                  out of range, dies
;   (substring "abc" -1 2)         "ab"                out of range, dies
;   (char_at   "abc" 9)            ""                  out of range, dies
;   (divide 7 0)                   nothing             dies
;   (int_to_str 10.5)              ""                  "10" / "10" / "10.5"
;   (maximum (list))               (list)              null
;
; **fkwu is the permissive arm.** Where the other three turn the call away, it answers something
; plausible — a clamped slice, an empty string, nothing — and does not say it did.
; The other three carry the contract the body itself declares: primitive-registry.fk
; says of `substring` and `char_at`, in its own words, *"out-of-range panics"*.
; Three arms keep that promise. The fourth quietly does not.
;
; This is not an accusation of fkwu. Clamping is a defensible choice and the panic is
; a defensible choice; what cannot stand is a recipe proven four-way on nominal input
; that goes off the end at run time — it will be truncated on one arm and dead on the
; other three, and only one of those tells you. That shape has already cost this body
; once: a font size written as 11.5 gave `font-size=""` on fkwu and a correct number
; everywhere else, and every band stayed green.
; See receipts/2026-07-26-where-the-arms-stop-agreeing.md.
;
; WHAT TO DO ABOUT IT — the part below. A bounds-checked accessor pair that answers
; the SAME thing on all four arms, because it never hands the native an argument the
; native would turn away. Reach for these wherever an index is computed rather than
; literal. Proven by observe/tests/primitive-edge-contracts-band.fk.

(do
    ; ── the recorded divergence, as data rather than prose ──────────────────
    ; 1 = the arms disagree at this edge, and the disagreement is measured above.
    (defn pec-edge-name (i)
        (if (eq i 0) "substring-past-end"
        (if (eq i 1) "substring-reversed"
        (if (eq i 2) "substring-negative"
        (if (eq i 3) "char-at-past-end"
        (if (eq i 4) "divide-by-zero"
        (if (eq i 5) "int-to-str-non-integer" "maximum-of-empty")))))))
    (defn pec-edge-count () 7)
    (defn pec-probes-run () 22)
    (defn pec-probes-agreeing () 15)

    ; ── clamping, said out loud ─────────────────────────────────────────────
    (defn pec-clamp (v lo hi) (if (lt v lo) lo (if (gt v hi) hi v)))

    ; pec-char-at — the i-th byte, or the empty string when i is outside the text.
    ; Never calls the native out of range, so every arm takes the same branch.
    (defn pec-char-at (s i)
        (if (lt i 0) ""
            (if (ge i (str_len s)) "" (char_at s i))))

    ; pec-substring — s[a:b) with both ends clamped into the text, and an empty
    ; string whenever the window has collapsed or inverted.
    (defn pec-substring (s a b)
        (do
            (let n (str_len s))
            (let a2 (pec-clamp a 0 n))
            (let b2 (pec-clamp b 0 n))
            (if (ge a2 b2) "" (substring s a2 b2))))

    ; pec-byte-at — the byte value, or -1 outside the text. -1 rather than 0,
    ; because 0 is a byte a string can genuinely hold.
    (defn pec-byte-at (s i)
        (do
            (let c (pec-char-at s i))
            (if (eq (str_len c) 0) (sub 0 1) (ord c))))

    ; ── a walk that runs off the end on purpose ─────────────────────────────
    ; The shape that breaks: a loop whose bound is computed, reading one past the
    ; text. With these accessors it terminates with the whole string on every arm.
    (defn pec-collect-loop (s i stop acc)
        (if (ge i stop) acc (pec-collect-loop s (add i 1) stop (str_concat acc (pec-char-at s i)))))
    (defn pec-collect-overrun (s extra)
        (pec-collect-loop s 0 (add (str_len s) extra) ""))

    0)
