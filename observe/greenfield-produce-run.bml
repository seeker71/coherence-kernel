// The greenfield carrier produces fkwu and form-cli. The fkwu it compiles
// from runtime/fkwu-uni.c answers the same ground as the standing bootstrap,
// and both fkwu binaries produce a form-cli.
// preflight-exec: forbidden
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class GreenfieldProduce {
  def gp-dir() = "/tmp/sema-greenfield-boot";
  def gp-main() {
   let made = hch-mkdirs(gp-dir());
   let cc = hch-run("greenfield-cc", ["cc", "-O2", "-o", gp-dir() ++ "/bboot", "runtime/membrane-boot.c", "runtime/membrane-witness.c"], "", hch-by(120000));
   let run = hch-ok?(cc) ? hch-run("greenfield-produce", [gp-dir() ++ "/bboot", "--produce"], "", hch-by(900000)) : nothing();
   let said = nothing?(run) ? hch-said(cc) : hch-said(run);
   let ok = !nothing?(run) && hch-ok?(run) && str_find(said, "produce-fails=0", 0) >= 0 && str_find(said, "ground-same=1", 0) >= 0 && str_find(said, "form-cli-produced=1", 0) >= 0 && str_find(said, "form-cli-standing=1", 0) >= 0;
   print(said);
   ok ? 1 : form_error("greenfield produce failed");
  }
 }
 gp-main();
}
