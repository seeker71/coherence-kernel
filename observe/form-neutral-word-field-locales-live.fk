; form-neutral-word-field-locales-live.fk — observe symbol -> recipe -> NL surface.
; preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/string-byte-fold-src-shim.fk form/form-stdlib/sha256.fk form/form-stdlib/hex.fk cognition/form-neutral-word-field.fk cognition/concept-nl-semantic-13-runtime.fk cognition/form-neutral-word-field-locales.fk

(do
  (defn fwfll-row (runtime symbol locale)
    (do
      (let recipe (fwfl-plan symbol locale))
      (let ref (fwfl-record-source-ref recipe))
      (print "  locale=") (print (fwfl-locale-tag locale))
      (print " recipe=") (print (fwfl-segments recipe))
      (print " realization=")
      (print (if (eq (fwfl-source recipe) 1) "runtime-corpus-lookup"
               "local-fragment-recipe"))
      (print " generated=") (print (fwfl-generate-in runtime symbol locale))
      (print " hypothesis=") (print (int_to_str (fwfl-hypothesis-id recipe)))
      (print " source=") (print (int_to_str (fwfl-source recipe)))
      (print " source-ref=") (print ref)
      (print " source-uri=")
      (print (if (eq (len ref) 0) "" (fwfl-source-uri (fwfl-ref-catalog ref))))
      (print " review=") (print (int_to_str (fwfl-review-state recipe)))
      (print " pos=") (print (int_to_str (fwfl-pos recipe)))
      (print " register=") (print (int_to_str (fwfl-register recipe)))
      (print " script=") (print (int_to_str (fwfl-script recipe)))
      (print " matching=") (print (int_to_str (fwfl-matching recipe)))
      (print " wake-distance=") (print (int_to_str (fwfl-wake-distance symbol locale)))
      (print " wake=") (print (fwfl-wake symbol locale))
      (print " reverse-symbol=")
      (print (fwfl-resolve-in runtime locale
        (fwfl-generate-in runtime symbol locale)))
      (print "\n")
      0))
  (defn fwfll-rows (runtime symbol locales)
    (if (eq (len locales) 0) 0
      (do (fwfll-row runtime symbol (head locales))
          (fwfll-rows runtime symbol (tail locales)))))
  (defn fwfll-symbol (runtime id)
    (do
      (let symbol (fwfl-symbol id))
      (print "\nneutral-symbol=") (print symbol)
      (print " base-shape=") (print (fwf-shape (fwf-at id)))
      (print "\n")
      (fwfll-rows runtime symbol (fwfl-locales))))
  (defn fwfll-surfaces (runtime locale id)
    (if (ge id (fwf-axis-count)) (list)
      (cons (fwfl-generate-in runtime (fwfl-symbol id) locale)
        (fwfll-surfaces runtime locale (add id 1)))))
  (defn fwfll-grid (runtime locales)
    (if (eq (len locales) 0) 0
      (do
        (print "  ") (print (fwfl-locale-tag (head locales)))
        (print "=") (print (fwfll-surfaces runtime (head locales) 0)) (print "\n")
        (fwfll-grid runtime (tail locales)))))

  (let runtime (fwfl-runtime))
  (print "locale-realization neutral-symbol-first\n")
  (print "pipeline=symbol -> candidate-sense -> source-policy -> indexed-corpus-or-local-recipe -> surface\n")
  (print "local-character-complete-static-bridges=")
  (print (int_to_str (fwfl-character-complete-bridge-count)))
  (print " runtime-corpus-lookups=")
  (print (int_to_str (fwfl-corpus-anchor-count)))
  (print " runtime-emitted-surfaces=")
  (print (int_to_str (fwfl-surface-count)))
  (print " local-composite-recipes=") (print (int_to_str (fwfl-composite-count)))
  (print " local-single-anchor-recipes=")
  (print (int_to_str (fwfl-single-anchor-count)))
  (print " productive-morphology-rules=") (print (int_to_str (fwfl-productive-rule-count)))
  (print "\ncorpus-row-keys-resolve=")
  (print (int_to_str (fwfl-body-refs-resolve? runtime (fwfl-locales))))
  (print " grid-sha256=") (print (fwfl-grid-sha256 runtime))
  (print "\nsource authored=") (print (int_to_str (fwfl-authored-source-count)))
  (print " body-corpus-anchor=") (print (int_to_str (fwfl-corpus-anchor-count)))
  (print " external-lexical-anchor=") (print (int_to_str (fwfl-external-anchor-count)))
  (print "\nreview speaker-unreviewed=") (print (int_to_str (fwfl-speaker-unreviewed-count)))
  (print " speaker-reviewed=") (print (int_to_str (fwfl-speaker-reviewed-count)))
  (print "\nhypothesis 0=no-numeric-delta-authored 1=reverent-awe 2=wondering-awe 3=startled-awe")
  (print " 4=mercy-grace 5=polysemous-grace 6=desire-love")
  (print " 7=life-force 8=harmony/coherence-overlap")
  (print " 9=relational-agency 10=clarify/assert 11=abstract-humor/joking\n")
  (print "source 0=authored 1=body-corpus 2=external-lexical-or-usage; review 0=unreviewed; matching 0=exact-codepoint-no-normalization\n")
  (print "\ngenerated-grid axis-order=0..12\n")
  (fwfll-grid runtime (fwfl-locales))

  ; Vitality, awe, sovereignty, grace and coherence expose the largest useful
  ; contrast: compounding, sense split, invariant agency, polysemy and overlap.
  (fwfll-symbol runtime 2)
  (fwfll-symbol runtime 4)
  (fwfll-symbol runtime 8)
  (fwfll-symbol runtime 9)
  (fwfll-symbol runtime 11)
  0)
