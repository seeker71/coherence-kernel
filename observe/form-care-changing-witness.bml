// Real local writes feed changing observations through the retained care reader.
// stdin: a new absolute directory beneath an existing parent. Evidence stays
// there. Empty stdin only admits the source. All work is local, without models.
// preludes: observe/form-care-witness-common.bml
section [form.bml] {
 class CareChangingWitness {
  def ccw-read(owner,root,discovery) {
   let minted = kernel_stat(53); let records = kernel_stat(164); let floats = kernel_stat(45); let heap = kernel_stat(6); let reclaimed = kernel_stat(51); let page = kernel_live(host_pid()); let start = host_monotonic_ms();
   let view = ohc-read-through(owner,root,discovery,65536,host_monotonic_ms(),occ-source-report,occ-view);
   let text = jv-emit(view);
   let elapsed = (host_monotonic_ms() - start); let growth = (kernel_stat(53) - minted); let created = (kernel_stat(164) - records); let boxed = (kernel_stat(45) - floats); let heapAfter = kernel_stat(6); let freed = (kernel_stat(51) - reclaimed); let cycles = (nth(kernel_live(host_pid()),21) - nth(page,21));
   list(view,text,jv-object(list(jv-n("primary_mints",growth),jv-n("record_constructor_dispatches",created),jv-n("float_boxes",boxed),jv-n("elapsed_ms",elapsed),jv-n("pair_slots_before",heap),jv-n("pair_slots_after",heapAfter),jv-n("reclaimed_strings",freed),jv-n("collector_cycles",cycles),jv-n("emitted_bytes",str_len(text)),jv-pair("read_bytes",jv-get(view,"read_bytes")))));
  }
  def ccw-current(result,id) {
   let signals = jv-items(jv-get(head(result),"signals"));
   ccw-assert((((Comparable) len(signals) == 1) && ((String) jv-str(head(signals),"id") == id)),"reader must hold exactly the new observation");
  }
  def ccw-round(owner,root,path,index) {
   let source = ccw-source(root,path,int_to_str(index)); let discovery = ccw-discovery(source);
   let appended = ccw-event(root,(index * 2));
   ccw-assert(((Comparable) sbt-append-count(path,nth(appended,1)) == str_len(nth(appended,1))),"actual append incomplete");
   let appendRead = ccw-read(owner,root,ccw-discovery(ccw-source(root,path,int_to_str((index - 1)))));
   ccw-current(appendRead,head(appended));
   ccw-assert(((Comparable) jv-str(head(appendRead),"read_bytes") == str_len(nth(appended,1))),"append reads only new bytes");
   ccw-assert(((Comparable) sbt-append-count(path,"bad\n") == 4),"malformed record append incomplete");
   let partial = str_concat("{\"unfinished_generation\":",int_to_str(index));
   ccw-assert(((Comparable) sbt-append-count(path,partial) == str_len(partial)),"partial append incomplete");
   let reader = ohc-stream(owner,source);
   let diagnosticMints = kernel_stat(53); let diagnosticRecords = kernel_stat(164);
   ohs-update(reader,65536);
   let diagnostic = jv-object(list(jv-n("primary_mints",(kernel_stat(53) - diagnosticMints)),jv-n("record_constructor_dispatches",(kernel_stat(164) - diagnosticRecords))));
   ccw-assert(((String) record_get(reader,"pending") == partial),"partial record retained until its generation ends");
   ccw-assert(((Comparable) record_get(reader,"invalid_records") == 1),"malformed complete event remains an observed admission gap");
   let extent = file_size(path); let event = ccw-event(root,((index * 2) + 1));
   ccw-assert((extent > str_len(nth(event,1))),"replacement has room for exact-size generation witness");
   ccw-write(path,str_concat(nth(event,1),str_concat(ccw-pad(((extent - str_len(nth(event,1))) - 1)),"\n")));
   ccw-assert(((Comparable) file_size(path) == extent),"generation replacement must have equal byte extent");
   let renewed = ccw-read(owner,root,discovery); ccw-current(renewed,head(event));
   let current = ohc-stream(owner,source);
   ccw-assert(((Value) reader == current),"publisher renewal must reuse its owned mutable reader");
   ccw-assert((((Comparable) record_get(current,"offset") == extent) && (((Comparable) str_len(record_get(current,"pending")) == 0) && ((Comparable) record_get(current,"invalid_records") == 0))),"new generation fully consumed without old partial state");
   let quiet = ccw-read(owner,root,discovery); ccw-current(quiet,head(event));
   ccw-assert(((Comparable) jv-str(head(quiet),"read_bytes") == 0),"unchanged generation keeps its cursor");
   ccw-assert((((Comparable) jv-str(nth(appendRead,2),"primary_mints") == 0) && ((Comparable) jv-str(nth(renewed,2),"primary_mints") == 0)),"changing event reads retain values without primary admission");
   ccw-assert(((Comparable) jv-str(diagnostic,"record_constructor_dispatches") == 0),"admission diagnostics reuse their reader owner");
   jv-object(list(jv-n("generation",index),jv-pair("append",nth(appendRead,2)),jv-pair("renew",nth(renewed,2)),jv-pair("quiet",nth(quiet,2)),jv-pair("admission_diagnostic",diagnostic),jv-n("retained_observations",len(record_get(current,"current"))),jv-n("pending_bytes",str_len(record_get(current,"pending")))));
  }
  def ccw-rounds(owner,root,path,index,end,rows) = if (index >= end) then reverse(rows) else ccw-rounds(owner,root,path,(index + 1),end,cons(ccw-round(owner,root,path,index),rows));
  def ccw-empty(reader,generation) = (((String) record_get(reader,"generation") == generation) && (((Comparable) record_get(reader,"offset") == 0) && (((String) record_get(reader,"pending") == "") && (nil?(record_get(reader,"current")) && (((String) record_get(reader,"state") == "unobserved") && (((Comparable) record_get(reader,"read_bytes") == 0) && (((Comparable) record_get(reader,"invalid_records") == 0) && ((Comparable) record_get(reader,"extent") == 0))))))));
  def ccw-lifecycle(root) {
   let path = str_concat(root,"/lifecycle.jsonl"); let event = ccw-event(root,900);
   ccw-write(path,nth(event,1)); let owner = ohc-open(); let source = ccw-source(root,path,"original");
   let reader = ohc-stream(owner,source); let stream = reader; ohc-sync-source(stream,source);
   ohs-update(reader,65536);
   let otherPath = str_concat(root,"/other.jsonl"); ccw-write(otherPath,nth(event,1));
   let otherSource = ccw-source(root,otherPath,"other"); let other = ohc-stream(owner,otherSource); ohc-sync-source(other,otherSource); ohs-update(other,65536);
   ccw-assert(((Comparable) sbt-append-count(otherPath,"{") == 1),"other source incomplete event append"); ohs-update(other,65536);
   let otherRows = record_get(other,"current"); let otherOffset = record_get(other,"offset"); let otherPending = record_get(other,"pending");
   let next = ccw-event(root,901); let cut = (str_len(nth(next,1)) / 2); let first = substring(nth(next,1),0,cut);
   ccw-assert(((Comparable) sbt-append-count(path,first) == str_len(first)),"shared source partial append"); ohs-update(reader,65536);
   let sharedOffset = record_get(reader,"offset"); let sharedRows = record_get(reader,"current");
   let shared = oh-set(oh-set(source,"publisher",json-node-string("joined-shared-writer")),"capabilities",json-node-array(list(json-node-string(ohd-shared-append-capability()))));
   ohc-sync-source(stream,shared);
   ccw-assert((((Value) ohc-stream(owner,source) == reader) && (((Comparable) record_get(reader,"offset") == sharedOffset) && (((String) record_get(reader,"pending") == first) && (((Value) record_get(reader,"current") == sharedRows) && ((String) record_get(reader,"generation") == "append-only-source"))))),"shared append writer preserves reader, current, pending and generation");
   let remainder = substring(nth(next,1),cut,str_len(nth(next,1))); ccw-assert(((Comparable) sbt-append-count(path,remainder) == str_len(remainder)),"shared writer completion"); ohs-update(reader,65536);
   ccw-assert((((Comparable) record_get(reader,"read_bytes") == str_len(remainder)) && ((String) ohv-str(head(record_get(reader,"current")),"id") == head(next))),"shared writer completion consumes only new bytes");
   ccw-assert(((Comparable) sbt-append-count(path,"bad\n{\"pending\":") == 15),"lifecycle incomplete record append");
   ohs-update(reader,65536);
   ccw-assert((((Comparable) record_get(reader,"invalid_records") == 1) && (str_len(record_get(reader,"pending")) > 0)),"reader owns malformed and incomplete evidence");
   let renewal = oh-set(shared,"generation",json-node-string("renewed"));
   let diagnosticIdentity = record_get(reader,"identity"); let diagnosticSequence = record_get(reader,"diagnostic_sequence");
   let constructions = kernel_stat(164); ohc-sync-source(stream,renewal); let restartCalls = (kernel_stat(164) - constructions);
   ccw-assert((((String) record_get(reader,"identity") == diagnosticIdentity) && ((Comparable) record_get(reader,"diagnostic_sequence") == diagnosticSequence)),"reader diagnostic identity and sequence outlive publisher generation");
   ccw-assert((((Comparable) restartCalls == 0) && (((Value) reader == ohc-stream(owner,source)) && ccw-empty(reader,"renewed"))),"restart reuses identity and releases all old mutable fields");
   ohs-update(other,65536);
   ccw-assert((((Value) record_get(other,"current") == otherRows) && (((Comparable) record_get(other,"offset") == otherOffset) && (((String) record_get(other,"pending") == otherPending) && ((Comparable) record_get(other,"read_bytes") == 0)))),"another source retains its observation, cursor and incomplete record");
   ccw-write(path,nth(event,1)); ohs-update(reader,65536);
   ccw-write(path,nth(next,1)); let joined = oh-set(oh-set(renewal,"publisher",json-node-string("joined-replacing-writer")),"capabilities",json-node-array(list())); ohc-sync-source(stream,joined);
   ccw-assert((((Value) reader == ohc-stream(owner,source)) && ccw-empty(reader,"renewed")),"ordinary new publisher starts a fresh reading on the same owner");
   ohs-update(reader,65536); ccw-assert(((String) ohv-str(head(record_get(reader,"current")),"id") == head(next)),"ordinary publisher reads replacement event");
   ccw-assert(((Comparable) sbt-append-count(path,"bad\n{") == 5),"truncation diagnostic preparation"); ohs-update(reader,65536);
   let invalid = record_get(reader,"invalid_records"); ccw-write(path,nth(event,1)); ohs-update(reader,65536);
   ccw-assert((((Comparable) record_get(reader,"invalid_records") == invalid) && (((String) record_get(reader,"generation") == "renewed") && (((String) record_get(reader,"pending") == "") && (((Comparable) len(record_get(reader,"current")) == 2) && (((String) ohv-str(head(record_get(reader,"current")),"aspect") == "source-reset") && ((String) ohv-str(nth(record_get(reader,"current"),1),"id") == head(event))))))),"truncation preserves generation, invalid-record history, source-reset signal and new observation");
   ohc-close(owner); ccw-assert((ccw-closed(reader) && ccw-closed(other)),"close clears both readers including publisher history");
   jv-object(list(jv-n("restart_constructor_dispatches",restartCalls),jv-n("restart_fields_clear",1),jv-n("shared_append_preserved",1),jv-n("ordinary_publisher_restarted",1),jv-n("other_source_preserved",1),jv-n("truncation_diagnostic_preserved",1),jv-n("close_clears_readers",1)));
  }
  def ccw-churn(owner,root,discovery,count,bytes) = if (count <= 0) then bytes else ccw-churn(owner,root,discovery,(count - 1),(bytes + str_len(jv-emit(ohc-read-through(owner,root,discovery,65536,host_monotonic_ms(),occ-source-report,occ-view)))));
  def ccw-collect(owner,root,discovery,before,count,bytes) = if (nth(kernel_live(host_pid()),21) > before) then list(count,bytes) else if (count >= 4096) then form_error("changing care observation budget ended before collection") else ccw-collect(owner,root,discovery,before,(count + 128),ccw-churn(owner,root,discovery,128,bytes));
  def ccw-index-append(reader,path,row,expected) {
   let text = str_concat(jv-emit(row),"\n");
   ccw-assert(((Comparable) sbt-append-count(path,text) == str_len(text)),"indexed care event append");
   ohs-update(reader,65536);
   let fresh = ohv-current-through(list(row),expected,ohs-correlation,reader);
   ccw-assert(jv-equal(jv-array(record_get(reader,"current")),jv-array(fresh)),"indexed reader preserves the shared reducer's complete ordered observations");
   fresh;
  }
  def ccw-index-rounds(reader,root,path,index,expected) = if ((Comparable) index == 32) then expected else {
   let event = ccw-event(root,(index + 1000));
   let row = jv-set(jv-set(jvp-parse(nth(event,1)),"flow",jv-string(str_concat(root,str_concat("/write-",int_to_str(index))))),"offers",jv-array(list(jv-string("read-back"))));
   let observed = ccw-index-append(reader,path,row,expected);
   let actual = read_file(str_concat(root,"/payload"));
   let applied = jv-set(jv-set(jv-set(row,"stage",jv-string("applied")),"selected",jv-string("read-back")),"result",jv-string(actual));
   let cared = ccw-index-append(reader,path,applied,observed);
   ccw-index-rounds(reader,root,path,(index + 1),cared);
  };
  def ccw-indexed(root) {
   let path = str_concat(root,"/indexed.jsonl"); ccw-write(path,"");
   let reader = ohs-open(path,"indexed-writes");
   let expected = ccw-index-rounds(reader,root,path,0,list());
   let first = head(expected);
   let wrong = jv-set(first,"id",jv-string("unmatched-read-back"));
   ccw-assert(((Comparable) sbt-append-count(path,str_concat(jv-emit(wrong),"\n")) == (str_len(jv-emit(wrong)) + 1)),"mismatched control append");
   ohs-update(reader,65536);
   let current = record_get(reader,"current");
   let diagnostic = ohv-find(current,jv-object(list(jv-s("organ","health-flow"),jv-pair("flow",jv-get(first,"flow")),jv-s("aspect","control-correlation"))));
   ccw-assert((((Comparable) len(current) == 33) && (jv-equal(ohv-find(current,first),first) && (ohv-pain(diagnostic) && ((String) ohv-str(diagnostic,"observed") == "unmatched-read-back")))),"mismatched control preserves its prior observation and adds the correlation need");
   ohs-close(reader); ccw-assert(ccw-closed(reader),"standalone reader releases its roots");
   jv-object(list(jv-n("actual_writes",32),jv-n("read_back_actions",32),jv-n("ordered_reducer_equivalence",1),jv-n("mismatched_control_preserved",1)));
  }
  def ccw-run(root) {
   ccw-assert((((Comparable) str_byte_at(root,0) == 47) && ((Comparable) fs_exists(root) == 0)),"supply a new absolute observation directory");
   ccw-assert(((Comparable) host_dir_mkdir(root) == 1),"observation directory creation failed");
   let paths = list("runtime/fkwu-uni.c","fkwu","form/form-stdlib/bml/form-core-health.bml","form/form-stdlib/bml/organ-health-stream.bml","form/form-stdlib/bml/form-core-care.bml","form/form-stdlib/bml/json-view.bml","form/form-stdlib/bml/json-view-parse.bml","form/form-stdlib/bml/organ-health-values.bml","form/form-stdlib/bml/organ-health-discovery.bml","form/form-stdlib/organ-health.bml","form/form-stdlib/json.fk","form/form-stdlib/bml/json-wire-admission.bml","observe/form-care-changing-witness.bml","observe/form-care-witness-common.bml","form/form-stdlib/bml/form-core-health-values.bml");
   let bindings = ccw-bindings(paths);
   let path = str_concat(root,"/events.jsonl"); let event = ccw-event(root,199); ccw-write(path,nth(event,1));
   let owner = ohc-open(); let discovery = ccw-discovery(ccw-source(root,path,"99"));
   let admitted = ccw-read(owner,root,discovery); ccw-current(admitted,head(event));
   let held = head(admitted); let rendered = nth(admitted,1);
   let rows = ccw-rounds(owner,root,path,100,132,list());
   let before = nth(kernel_live(host_pid()),21); let strings = kernel_stat(51);
   let collected = ccw-collect(owner,root,ccw-discovery(ccw-source(root,path,"131")),before,0,0);
   let cycles = (nth(kernel_live(host_pid()),21) - before); let freed = (kernel_stat(51) - strings);
   ccw-assert(((String) jv-emit(held) == rendered),"held view survives changing reader generations");
   ccw-assert(((cycles > 0) && (freed > 0)),"retained view crossed actual collection and temporary string release");
   ohc-close(owner); ccw-assert(((String) jv-emit(held) == rendered),"held care view survives owner close");
   let lifecycle = ccw-lifecycle(root);
   let indexed = ccw-indexed(root);
   ccw-assert(((String) jv-emit(jv-array(bindings)) == jv-emit(jv-array(ccw-bindings(paths)))),"selected runtime and source bytes stayed unchanged during observation");
   let report = jv-object(list(jv-s("schema","care-changing-witness-v1"),jv-n("accepted",1),jv-n("generations",32),jv-pair("initial_admission",nth(admitted,2)),jv-pair("append_totals",ccw-stage(rows,"append")),jv-pair("renew_totals",ccw-stage(rows,"renew")),jv-pair("quiet_totals",ccw-stage(rows,"quiet")),jv-pair("rows",jv-array(rows)),jv-n("collector_cycles",cycles),jv-n("reclaimed_strings",freed),jv-n("collection_exercise_reads",head(collected)),jv-n("held_view_exact",1),jv-pair("lifecycle",lifecycle),jv-pair("sources",jv-array(bindings)),jv-pair("observations",ccw-bind(str_concat(root,"/observations.jsonl"))),jv-s("scope","real local payload writes and readback events; append, equal-size declared renewal and quiet reads; discovery declarations prepared before measured reader plus serialization; pair slots are occupied heap slots including garbage, not total allocation or retained RAM; constructor dispatches may count one allocation twice; malformed-event diagnostics and collection exercise measured separately from stage totals; selected source bindings are not the complete dependency closure; primary nodes and seed records remain permanent")));
   let text = jv-emit(jv-set(report,"indexed_writes",indexed)); ccw-write(str_concat(root,"/evidence.json"),text);
   print(list("care-changing",32,"append",jv-emit(ccw-stage(rows,"append")),"renew",jv-emit(ccw-stage(rows,"renew")),"quiet",jv-emit(ccw-stage(rows,"quiet")),"collection-cycles",cycles,"reclaimed-strings",freed,"held-view-exact",1,"evidence",str_concat(root,"/evidence.json"))); 0;
  }
 }
 let root = read_line();
 if (nothing?(root) || ((String) trim(root) == "")) then 0 else ccw-run(trim(root));
}
