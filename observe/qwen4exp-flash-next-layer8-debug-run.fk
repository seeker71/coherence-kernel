; First-divergence probe: run proven-finite layers 0..7, then name every
; architectural boundary inside layer 8.
;
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk

(do
    (defn q4l8-word (s i)
        (add (str_byte_at s (mul i 4))
        (add (mul (str_byte_at s (add (mul i 4) 1)) 256)
        (add (mul (str_byte_at s (add (mul i 4) 2)) 65536)
             (mul (str_byte_at s (add (mul i 4) 3)) 16777216)))))
    (defn q4l8-f32 (s i) (fd-value (q4l8-word s i) 8 23))
    (defn q4l8-summary (h n)
        (do
            (let a (metal_buf_read h 0 12))
            (let z (metal_buf_read h (mul (sub n 1) 4) 4))
            (list (q4l8-f32 a 0) (q4l8-f32 a 1)
                  (q4l8-f32 a 2) (q4l8-f32 z 0))))
    (defn q4l8-u32s-go (s i n acc)
        (if (ge i n) (reverse acc)
            (q4l8-u32s-go s (add i 1) n (cons (q4l8-word s i) acc))))
    (defn q4l8-u32s (h n)
        (do (let s (metal_buf_read h 0 (mul n 4)))
            (q4l8-u32s-go s 0 n (empty))))
    (defn q4l8-warm (aps qps gps bs model lays sts layer)
        (if (ge layer 8) 1
            (do
                (q4t-block aps qps gps bs model (nth lays layer) (nth sts layer)
                    layer 0 16 9419 248046 248046)
                (q4l8-warm aps qps gps bs model lays sts (add layer 1)))))

    (let prefix "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-")
    (let ctx (q4t-open prefix 16))
    (let aps (nth ctx 0)) (let qps (nth ctx 1)) (let gps (nth ctx 2))
    (let bs (nth ctx 3)) (let lays (nth ctx 4)) (let model (nth ctx 5))
    (let sts (nth ctx 6))
    (q4t-embed qps gps bs (nth model 0) 9419)
    (q4l8-warm aps qps gps bs model lays sts 0)
    (let before (q4l8-summary (nth bs 1) 10240))
    (let lay (nth lays 8)) (let st (nth sts 8))
    (q4t-hc-mix qps gps bs lay 0)
    (let attn-mixed (q4l8-summary (nth bs 5) 2560))
    (let attn-inject (q4l8-summary (nth bs 6) 4))
    (q4t-linear aps qps gps bs lay st)
    (let attn-out (q4l8-summary (nth bs 7) 2560))
    (q4gj-hc-combine gps (nth bs 1) (nth bs 7) (nth bs 6))
    (let after-attn (q4l8-summary (nth bs 1) 10240))
    (q4t-hc-mix qps gps bs lay 4)
    (let ffn-mixed (q4l8-summary (nth bs 5) 2560))
    (q4t-mv qps (nth lay 8) (nth bs 5) (nth bs 21))
    (metal_enqueue (nth aps 20)
        (q4t-b16 (list (nth bs 21) (nth bs 22) (nth bs 23)) (list 512 10)) 1)
    (let route-logits (q4l8-summary (nth bs 21) 512))
    (let route-ids (q4l8-u32s (nth bs 22) 10))
    (q4t-moe aps qps bs lay)
    (let moe-out (q4l8-summary (nth bs 28) 2560))
    (let shared-out (q4l8-summary (nth bs 32) 2560))
    (q4gj-hc-combine gps (nth bs 1) (nth bs 28) (nth bs 6))
    (let after-ffn (q4l8-summary (nth bs 1) 10240))
    (let live (metal_status))
    (q4t-close ctx)
    (list "qwen4exp-flash-next-layer8-debug"
        (list "before" before) (list "attn-mixed" attn-mixed)
        (list "attn-inject" attn-inject) (list "attn-out" attn-out)
        (list "after-attn" after-attn) (list "ffn-mixed" ffn-mixed)
        (list "route-logits" route-logits) (list "route-ids" route-ids)
        (list "shared-out" shared-out) (list "moe-out" moe-out)
        (list "after-ffn" after-ffn) (list "metal-status" live)
        (list "after-close" (metal_status))))
