; cell-channel-eval-run.fk — the evaluation membrane's far side.
;
; A live cell never evaluates a heard symbol in its own process: it hands
; the program to this door in a child under the caller's patience
; (cell-channel.bml cc-eval-membrane) and reads back one `value=` line.
; Whatever happens here — a symbol that never returns, an evaluator death
; the kernel does not report — stays here; the cell reads `nothing` and
; answers `refuse reason=spent`, alive.
;
; stdin: line 1 the kind (say -> integer value, tell -> string value);
; the rest is the whole program, evaluated by the body's own evaluator.
; preflight-exec: forbidden
; preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk grammars/form-eval.fk
(do
    (defn ccer-with-nl (l) (if (eq (str_len l) 0) l (if (eq (str_byte_at l (sub (str_len l) 1)) 10) l (str_concat l "\n"))))
    (defn ccer-lines (acc)
        (do (let l (read_line))
            (if (nothing? l) acc (ccer-lines (str_concat acc (ccer-with-nl l))))))
    (defn ccer-one-line (s i acc)
        (if (ge i (str_len s)) acc
            (ccer-one-line s (add i 1) (str_concat acc (if (eq (str_byte_at s i) 10) " " (byte_to_str (str_byte_at s i)))))))
    (let kind (trim (read_line)))
    (let program (ccer-lines ""))
    (let v (fe-eval program))
    (print_str (str_concat "value="
        (str_concat (if (nothing? v) "nothing" (if (str_eq kind "tell") (ccer-one-line v 0 "") (int_to_str v))) "\n")))
    0)
