; resident-async-ingress-hot-swap-live.fk — a truly external late-source
; witness.  This source contains no delivered recipe name, definition body, or
; invocation.  It constructs an empty resident organ and scannerless session,
; emits READY, and only then reads six externally supplied lines:
;
;   stable recipe NodeID
;   first definition source
;   first invocation source
;   replacement definition source
;   second invocation source
;   expected result shared by both invocations
;
; Each line enters the same dynamic channel as an envelope, yields through the
; cooperative scheduler, and reaches fef-eval-state.  The PTY receipt proves
; when the bytes arrived; source inspection proves what was absent beforehand.
; read_line is intentionally named as a blocking ingress boundary, not a
; nonblocking kernel primitive.  A resident turnwheel can poll append-only
; channels between compute quanta through rai-poll-file; this witness isolates
; the stronger post-start absence claim.
;
; No recursive self-call, HTTP/server, model, Metal, digest, flatten, native
; function seat, or C growth participates.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/substrate-phase.fk form/form-stdlib/form-eval-full.fk form/form-stdlib/resident-async-ingress.fk

(do
    (defn raisl-enter (organ session channel sequence exchange kind source nodeid)
        (do
            (let offered (rai-offer organ
                (rai-envelope channel sequence exchange kind source nodeid -1)))
            (let yielded (rai-yield (nth offered 0) (now_unix_ms)))
            (let stepped (rai-session-step session (nth yielded 1)))
            (list (nth yielded 0) stepped)))

    (let channel "@0.2.0.900")
    (let organ0 (rai-organ (list (rai-channel channel 8 8 0)) 16))
    (let session0 (rai-session))
    (print_str "READY resident-async-ingress empty-env=1 awaiting-external-source=1")

    ; Nothing below is available until another local participant writes it to
    ; the already-running process.
    (let recipe-nodeid (read_line))
    (let definition-v1 (read_line))
    (let invocation-v1 (read_line))
    (let definition-v2 (read_line))
    (let invocation-v2 (read_line))
    (let expected (str_to_int (read_line)))

    (let move1 (raisl-enter organ0 session0 channel 1 101 "recipe"
        definition-v1 recipe-nodeid))
    (let define1 (nth move1 1))
    (let move2 (raisl-enter (nth move1 0)
        (rai-session-result-session define1) channel 2 102 "invoke"
        invocation-v1 recipe-nodeid))
    (let invoke1 (nth move2 1))
    (let move3 (raisl-enter (nth move2 0)
        (rai-session-result-session invoke1) channel 3 103 "recipe"
        definition-v2 recipe-nodeid))
    (let define2 (nth move3 1))
    (let move4 (raisl-enter (nth move3 0)
        (rai-session-result-session define2) channel 4 104 "invoke"
        invocation-v2 recipe-nodeid))
    (let invoke2 (nth move4 1))
    (let released (rai-release-channel (nth move4 0) channel 105))
    (let view (rai-inspect-channel released channel))
    (let frame (rai-record-framebuffer released channel 1))

    (print_str (str_concat "resident-hot-swap nodeid=" recipe-nodeid))
    (print_str (str_concat " defined-symbol="
        (rai-session-result-symbol define1)))
    (print_str (str_concat " define-exchange="
        (int_to_str (rai-session-result-exchange define1))))
    (print_str (str_concat " invoke-v1="
        (int_to_str (rai-session-result-value invoke1))))
    (print_str (str_concat " replace-version="
        (int_to_str (rai-session-result-version define2))))
    (print_str (str_concat " invoke-v2="
        (int_to_str (rai-session-result-value invoke2))))
    (print_str (str_concat " invoke-exchange="
        (int_to_str (rai-session-result-exchange invoke2))))
    (print_str (str_concat " release-state=" (nth view 2)))
    (print_str (str_concat " releases=" (int_to_str (nth view 22))))
    (print_str " startup-recipe-source=absent external-after-ready=1 fk-fn-seat=0 restart=0")
    (print_str (str_concat " framebuffer-events="
        (int_to_str (len (framebuffer-events)))))
    (print (if (and (str_eq (rai-session-result-nodeid define1) recipe-nodeid)
                   (and (str_eq (rai-session-result-nodeid invoke2) recipe-nodeid)
                        (and (eq (rai-session-result-value invoke1) expected)
                             (and (eq (rai-session-result-value invoke2) expected)
                                  (and (eq (rai-session-result-version define1) 1)
                                       (and (eq (rai-session-result-version define2) 2)
                                            (and (eq (rai-session-result-exchange invoke2) 104)
                                                 (and (str_eq (nth view 2) "released")
                                                      (eq (nth view 22) 1)))))))))
               255 0)))
