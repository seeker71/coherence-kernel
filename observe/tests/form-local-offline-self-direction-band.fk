; form-local-offline-self-direction-band.fk -- pure local tick + adversaries.
; witnessed: 2026-08-25 -> 524287

import "../form-local-offline-self-direction.fk"
import "../../form/form-stdlib/form-nodeid-mastery-cell-categories.fk"

(do
    (defn flosdb-observe (state stamp)
        (flohm-map stamp
            (list
                (flohm-organ "kernel" 1 5 5 stamp "fixture:kernel"
                    (fmcl-continuation-category) "ready")
                (flohm-organ "knowledge" (if (gt state 0) 1 0) 5 5 stamp
                    "fixture:knowledge" (fmcl-attempt-category) "learn")
                (flohm-organ "backup" (if (gt state 1) 1 0) 2 2 stamp
                    "fixture:backup" (fmcl-persistence-category) "retain")
                (flohm-organ "unknown" (nothing) 1 1 stamp "fixture:unknown"
                    (fmcl-signal-category) "observe"))))

    (defn flosdb-control (outbound) (bfc-control outbound 0))
    (defn flosdb-replay-control (outbound)
        (bfc-envelope 1 (sub (bfc-exchange outbound) 1) 1 0
            (bfc-alternative outbound)))
    (defn flosdb-false-control (outbound) (bfc-control outbound 3))
    (defn flosdb-no-control (outbound) (nothing))

    (defn flosdb-apply (state selected before)
        (do
            ; A third local event makes the sole actuator call observable.  A
            ; rejected control must leave only the outbound/inbound pair.
            (let event (fb_record (intern_trivial_int 7199)
                "form-local-offline-self-direction-band.fk" 1))
            (flosd-apply-result "applied" "fixture-movement"
                (flohm-identity selected) (flohm-action-token selected) 1 1)))
    (defn flosdb-no-change-apply (state selected before)
        (flosd-apply-result "applied" "accepted-without-health-transition"
            (flohm-identity selected) (flohm-action-token selected) state 1))
    (defn flosdb-nothing-apply (state selected before)
        (flosd-apply-result "nothing" "recipe-binding-absent"
            (flohm-identity selected) (flohm-action-token selected) 99 0))
    (defn flosdb-raw-nothing-apply (state selected before) (nothing))
    (defn flosdb-wrong-identity-apply (state selected before)
        (flosd-apply-result "applied" "replay" "backup"
            (flohm-action-token selected) 1 1))
    (defn flosdb-wrong-action-apply (state selected before)
        (flosd-apply-result "applied" "swap" (flohm-identity selected)
            (fmcl-persistence-category) 1 1))

    (defn flosdb-status? (result value) (if (str_eq (nth result 1) value) 1 0))
    (defn flosdb-reason? (result value) (if (str_eq (nth result 2) value) 1 0))
    (defn flosdb-fold-bits-loop (bits acc)
        (if (nil? bits) acc
            (flosdb-fold-bits-loop (tail bits) (add (mul acc 2) (head bits)))))
    (defn flosdb-fold-bits (bits) (flosdb-fold-bits-loop bits 0))

    (framebuffer-clear)
    (let moved (flosd-tick flosdb-observe flosdb-control flosdb-apply
        0 100 71 7200000 0))
    (let moved-events (len (framebuffer-events)))

    (framebuffer-clear)
    (let replayed (flosd-tick flosdb-observe flosdb-replay-control flosdb-apply
        0 200 72 7200000 0))
    (let replay-events (len (framebuffer-events)))

    (framebuffer-clear)
    (let false-control (flosd-tick flosdb-observe flosdb-false-control flosdb-apply
        0 300 73 7200000 0))
    (let missing-control (flosd-tick flosdb-observe flosdb-no-control flosdb-apply
        0 400 74 7200000 0))
    (let wrong-identity (flosd-tick flosdb-observe flosdb-control
        flosdb-wrong-identity-apply 0 500 75 7200000 0))
    (let wrong-action (flosd-tick flosdb-observe flosdb-control
        flosdb-wrong-action-apply 0 600 76 7200000 0))
    (let raw-nothing (flosd-tick flosdb-observe flosdb-control
        flosdb-raw-nothing-apply 0 700 77 7200000 0))
    (let held-nothing (flosd-tick flosdb-observe flosdb-control
        flosdb-nothing-apply 0 800 78 7200000 0))
    (let no-change (flosd-tick flosdb-observe flosdb-control
        flosdb-no-change-apply 0 900 79 7200000 0))
    (let not-due (flosd-tick flosdb-observe flosdb-control flosdb-apply
        0 1000 80 7200000 7199999))
    (let idle (flosd-tick flosdb-observe flosdb-control flosdb-apply
        2 1100 81 7200000 0))

    (let bits (list
        (flosdb-status? moved "applied")
        (if (str_eq (nth moved 4) "knowledge") 1 0)
        (flosd-action-eq? (nth moved 5) (fmcl-attempt-category))
        (if (and (eq (nth moved 10) 1) (eq (nth moved 11) 1)) 1 0)
        (if (and (eq (nth moved 13) 2) (eq (nth moved 14) 1)) 1 0)
        (if (and (eq (nth moved 15) 250) (eq (nth moved 16) 500)) 1 0)
        (if (and (eq (nth moved 12) 1) (eq moved-events 3)) 1 0)
        (if (and (flosdb-status? replayed "refused")
            (flosdb-reason? replayed "correlated-continue-control-required")) 1 0)
        (if (and (eq (nth replayed 10) 0) (eq replay-events 2)) 1 0)
        (if (and (flosdb-status? false-control "refused")
            (flosdb-status? missing-control "refused")) 1 0)
        (if (and (flosdb-reason? wrong-identity "actuator-result-unbound")
            (flosdb-reason? wrong-action "actuator-result-unbound")) 1 0)
        (if (and (flosdb-reason? raw-nothing "actuator-result-unbound")
            (eq (nth raw-nothing 10) 0)) 1 0)
        (if (and (flosdb-status? held-nothing "nothing")
            (and (eq (nth held-nothing 10) 0)
                 (eq (nth held-nothing 12) 0))) 1 0)
        (if (and (flosdb-status? no-change "applied")
            (and (eq (nth no-change 10) 1)
                 (eq (nth no-change 12) 0))) 1 0)
        (if (and (flosdb-status? not-due "not-due")
            (and (eq (nth not-due 10) 0) (eq (nth not-due 11) 0))) 1 0)
        (if (and (flosdb-status? idle "idle")
            (and (eq (nth idle 10) 0) (eq (nth idle 11) 1))) 1 0)
        (if (and (eq (flosd-due? 7199999 3600000) 0)
            (eq (flosd-due? 7200000 3600000) 1)) 1 0)
        (if (and (eq (flosd-native-wake-owned?) 0)
            (str_eq (flosd-wake-seam) "native-bounded-wake-primitive-absent")) 1 0)
        (if (and (nothing? (flohm-state (nth (nth (nth moved 3) 10) 3)))
            (and (eq (flohm-state (nth (nth (nth moved 3) 10) 1)) 0)
                 (eq (flohm-state (nth (nth (nth moved 9) 10) 1)) 1))) 1 0)))
    (flosdb-fold-bits bits))
