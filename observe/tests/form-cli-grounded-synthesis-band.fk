; form-cli-grounded-synthesis-band.fk — the grounded synthesis authority answers
; its pins with no model, no provider and no socket: the JSON escape the oracle
; request rides on, the reader of a llama.cpp /completion reply, the receipt
; ranking (terms matched first, then date, newest first), the provider argv
; (own identity, no tools, an effort flag only when asked) and the HTTP body
; split. 8 bits -> 255.
; witnessed: 2026-09-18 -> 255
; preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml

(do
    (defn gsb-bit (ok n) (if ok n 0))

    ; 1: escape — backslash, quote and newline survive as JSON escapes
    (let escaped (fgs-escape "a\"b\\c\nd"))
    (let b1 (str_eq escaped "a\\\"b\\\\c\\nd"))

    ; 2: a llama.cpp-shaped reply reads as answered with its counts
    (let reply (fgs-oracle-read "{\"content\":\"hello\",\"tokens_evaluated\":12,\"tokens_predicted\":3}"))
    (let b2 (and (str_eq (nth reply 0) "answered")
                 (and (str_eq (nth reply 1) "hello")
                      (and (eq (nth reply 2) 12) (eq (nth reply 3) 3)))))

    ; 3: blank content is empty, never an answer
    (let blank (fgs-oracle-read "{\"content\":\"  \",\"tokens_evaluated\":5,\"tokens_predicted\":0}"))
    (let b3 (str_eq (nth blank 0) "empty"))

    ; 4: equal hits rank by date, newest first; non-.md names and misses drop
    (let rows (fgs-top (fgs-rank (list "2026-01-01-trust-a.md" "2026-09-01-trust-b.md" "notes.txt" "2026-05-05-other.md") (list "trust")) 5))
    (let b4 (and (eq (len rows) 2)
                 (str_eq (nth (head rows) 1) "receipts/2026-09-01-trust-b.md")))

    ; 5: more terms matched beats a newer date
    (let rows2 (fgs-top (fgs-rank (list "2026-09-01-trust.md" "2026-01-01-trust-sovereignty.md") (list "trust" "sovereignty")) 1))
    (let b5 (str_eq (nth (head rows2) 1) "receipts/2026-01-01-trust-sovereignty.md"))

    ; 6: the provider argv carries its own session identity and an empty tool set
    (let argv (fgs-argv "/tmp/home" "123e4567-e89b-12d3-a456-426614174000" ""))
    (let b6 (and (str_eq (nth argv 0) "env")
                 (and (ge (str_find (fgs-join argv " ") "--session-id 123e4567-e89b-12d3-a456-426614174000" 0) 0)
                      (and (lt (str_find (fgs-join argv " ") "--effort" 0) 0)
                           (str_eq (nth argv (sub (len argv) 1)) "")))))

    ; 7: the HTTP body is what follows the first blank line
    (let b7 (str_eq (fgs-http-body "HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\n{}") "{}"))

    ; 8: a requested effort rides the argv as its own flag
    (let argv2 (fgs-argv "/tmp/home" "" "low"))
    (let b8 (and (ge (str_find (fgs-join argv2 " ") "--effort low" 0) 0)
                 (lt (str_find (fgs-join argv2 " ") "--session-id" 0) 0)))

    (add (gsb-bit b1 1)
         (add (gsb-bit b2 2)
              (add (gsb-bit b3 4)
                   (add (gsb-bit b4 8)
                        (add (gsb-bit b5 16)
                             (add (gsb-bit b6 32)
                                  (add (gsb-bit b7 64) (gsb-bit b8 128)))))))))
