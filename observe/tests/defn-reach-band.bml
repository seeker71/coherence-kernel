; defn-reach-band.bml — observe/defn-reach-run.bml over a fixture unit: its three [defn-reach] lines, pinned, for a root and for
; the word dead-tops, and its cut. The band plants a unit of seven definitions and a source that calls the root, twice, in two
; directories of the temp directory, and runs the door as a cell (cell_run, docs/in-process-cells.md) with the unit's own directory
; as the search root, so nothing outside the fixture is read.
;
; The fixture: drf-root reaches drf-helper, drf-shared, drf-lent and drf-lifted. drf-other (outside the reach) keeps drf-shared,
; the planted caller keeps drf-lent, and the unit's own top-level text keeps drf-lifted, so drf-helper alone leaves with the root.
; Nothing names drf-other or drf-alone, so they are the dead tops.
;
; Expected: 31
; Verdict 31 when every claim lands:
;   1   a root: `[defn-reach] <unit> defns=7 root=drf-root reaches=5 leaves-with-it=2 kept=3`, the planted caller as the one
;       source that names the root, and drf-root and drf-helper leaving with it
;   2   dead-tops: `[defn-reach] <unit> defns=7 root=dead-tops reaches=1 leaves-with-it=2 kept=-1`, no source names the word,
;       and drf-other and drf-alone leave
;   4   the door ran as a cell both times: no stop, no compile error, and its value is the count that leaves (2 each time)
;   8   without cut no file changes: the unit and the caller read as planted
;   16  cut: the same three lines, then `[defn-reach] cut: <bytes> -> <bytes> bytes`, and the unit reads as planted without
;       drf-root's and drf-helper's lines; the five that stay and the caller are as written
;
; REQUIRES: the built ./fkwu with the cell_run door (docs/in-process-cells.md), the body root as the working directory.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class DefnReachBand {
  def drb-dir() = temp_dir() ++ "/defn-reach-band-" ++ host_pid().str();
  def drb-at(place) = drb-dir() ++ "/" ++ place;
  def drb-unit(place) = drb-at(place) ++ "/unit.fk";
  def drb-caller(place) = drb-at(place) ++ "/caller.fk";
  def drb-leaving-lines() = ["(defn drf-root (x) (drf-helper (drf-shared (drf-lent (drf-lifted x)))))\n", "(defn drf-helper (x) (+ x 1))\n"];
  def drb-staying-lines() = ["(defn drf-shared (x) (* x 2))\n", "(defn drf-lent (x) (- x 3))\n", "(defn drf-lifted (x) x)\n", "(defn drf-other (x) (drf-shared x))\n", "(defn drf-alone (x) (- x 1))\n", "(let drf-top (drf-lifted 3))\n"];
  def drb-cat(xs) = nil?(xs) ? "" : xs[0] ++ drb-cat(xs[1:]);
  def drb-unit-text() = drb-cat(append(drb-leaving-lines(), drb-staying-lines()));
  def drb-caller-text() = "(defn drc-use (y) (drf-root (drf-lent y)))\n";
  def drb-plant(place) {
   let made = host_dir_mkdir(drb-at(place));
   let u = write_file(drb-unit(place), drb-unit-text());
   let c = write_file(drb-caller(place), drb-caller-text());
   made;
  }
  def drb-door(words) = cell_run("observe/defn-reach-run.bml", 0, 120000, [words]);
  def drb-out(r) = (String) record_get(r, "out");
  def drb-has(s, part) = str_find(s, part, 0) >= 0;
  def drb-bit(ok, bit) = ok ? bit : 0;
  def drb-say(label, r) = print([label, drb-out(r)]);
  def drb-ran?(r) = nothing?(record_get(r, "stopped")) && (Comparable) record_get(r, "errors") == 0 && (Comparable) record_get(r, "value") == 2;
  def drb-root-lines(place) = "[defn-reach] " ++ drb-unit(place) ++ " defns=7 root=drf-root reaches=5 leaves-with-it=2 kept=3\n"
   ++ "[defn-reach] sources that name the root (their call sites change first):\n  " ++ drb-caller(place) ++ "\n"
   ++ "[defn-reach] leaving with it:\n  drf-root\n  drf-helper\n";
  def drb-dead-lines(place) = "[defn-reach] " ++ drb-unit(place) ++ " defns=7 root=dead-tops reaches=1 leaves-with-it=2 kept=-1\n"
   ++ "[defn-reach] sources that name the root (their call sites change first):\n"
   ++ "[defn-reach] leaving with it:\n  drf-other\n  drf-alone\n";
  def drb-cut-line() = "[defn-reach] cut: " ++ len(drb-unit-text()).str() ++ " -> " ++ len(drb-cat(drb-staying-lines())).str() ++ " bytes\n";
  def drb-sweep(place) {
   let u = host_path_remove(drb-unit(place));
   let c = host_path_remove(drb-caller(place));
   host_dir_rmdir(drb-at(place));
  }
  def drb-run() {
   let made = host_dir_mkdir(drb-dir());
   let planted = drb-plant("reach");
   let rooted = drb-door(drb-unit("reach") ++ " drf-root " ++ drb-at("reach"));
   let shown1 = drb-say("root", rooted);
   let b1 = drb-bit((String) drb-out(rooted) == drb-root-lines("reach"), 1);
   let dead = drb-door(drb-unit("reach") ++ " dead-tops " ++ drb-at("reach"));
   let shown2 = drb-say("dead-tops", dead);
   let b2 = drb-bit((String) drb-out(dead) == drb-dead-lines("reach"), 2);
   let b4 = drb-bit(drb-ran?(rooted) && drb-ran?(dead), 4);
   let b8 = drb-bit((String) (read_file(drb-unit("reach")) ?? "") == drb-unit-text() && (String) (read_file(drb-caller("reach")) ?? "") == drb-caller-text(), 8);
   let planted2 = drb-plant("cut");
   let cut = drb-door(drb-unit("cut") ++ " drf-root " ++ drb-at("cut") ++ " cut");
   let shown3 = drb-say("cut", cut);
   let b16 = drb-bit((String) drb-out(cut) == drb-root-lines("cut") ++ drb-cut-line() && drb-ran?(cut)
    && (String) (read_file(drb-unit("cut")) ?? "") == drb-cat(drb-staying-lines()) && (String) (read_file(drb-caller("cut")) ?? "") == drb-caller-text(), 16);
   let swept = drb-sweep("reach") + drb-sweep("cut");
   let cleaned = host_dir_rmdir(drb-dir());
   let verdict = b1 + b2 + b4 + b8 + b16;
   let shown = print(["defn-reach-band", "verdict", verdict]);
   verdict;
  }
 }
 drb-run();
}
