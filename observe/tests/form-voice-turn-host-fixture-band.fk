; form-voice-turn-host-fixture-band.fk -- one real, no-network membrane crossing.
;
; PROOF LEVEL: fkwu only.  This is intentionally a deterministic fixture, not a
; local agent and not a remote-model claim.  Its purpose is to prove the actual
; Form -> host-file / host-exec -> Form return shape while the trusted full-duplex
; mailbox adapter remains a named missing organ.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/string-byte-fold-src-shim.fk form-stdlib/sha256.fk
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/hex.fk
; preludes: form-stdlib/form-agent-protocol.fk form-stdlib/choice-receipt.fk
; preludes: form-stdlib/form-agent-tree.fk form-stdlib/tool-channel.fk
; preludes: form-stdlib/form-cli-membrane.fk observe/form-voice-turn.fk
; preludes: observe/form-voice-turn-host-fixture.fk
;
; Verdict 63:
;   1 Form writes and rereads a harmless request byte-for-byte
;   2 Form invokes a real local fixture and receives its stdout
;   4 Form records only opaque fixture categories in the framebuffer
;   8 fixture provenance stays fixture/os-kernel/fixture-return, never rented/native
;  16 the fixture response returns through fvt-render-exact unchanged
;  32 the public witness exposes hashes and route, never fixture bytes

(do
    (let report (fvtf-public-report))
    (let c0 (if (ge (str_find report "fixture_file_roundtrip=1" 0) 0) 1 0))
    (let c1 (if (ge (str_find report "fixture_stdout_return=1" 0) 0) 2 0))
    (let c2 (if (ge (str_find report "framebuffer_event_count=2" 0) 0) 4 0))
    (let c3 (if (and (ge (str_find report "voice_author=fixture" 0) 0)
                     (ge (str_find report "immediate_surface=os-kernel" 0) 0)) 8 0))
    (let c4 (if (ge (str_find report "fixture_exact_render=1" 0) 0) 16 0))
    (let c5 (if (and (ge (str_find report "candidate_sha256=" 0) 0)
                     (and (lt (str_find report "fixture response: returned through the membrane" 0) 0)
                          (lt (str_find report "fixture request: form-owned and harmless" 0) 0))) 32 0))
    (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
