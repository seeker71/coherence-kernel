; import "../limitation-freshness-ledger.fk"
; [fresh, OWED, lapsed, renewed, inspected, nothing-arm, node-arm,
;  fresh-but-uninspected-is-OWED]
; witnessed: 2026-07-21 -> [2, 1, 0, 2, 1, 0, 3, 1]
(do
  (defn lflb-node (n) (intern_node (make_nodeid 9 7 5 n) (list)))
  (defn lflb-row (id offer observed date valid)
    (lfl-entry id 1 offer observed (list id) (list id) (list id) date valid))
  (let epoch 20260721)
  (let fresh (lflb-row (lflb-node 10) (nothing) 1 20260721 1))
  (let owed (lflb-row (lflb-node 11) 0 1 20260720 1))
  (let lapsed (lflb-row (lflb-node 12) 1 1 20260721 0))
  (let node-offer (lflb-row (lflb-node 13) (lflb-node 14) 1 20260721 1))
  (let uninspected (lfl-entry (lflb-node 15) 1 0 1 (list) (list) (list) 20260721 1))
  (let renewed (lfl-rewitness owed 20260721 1))
  (list (lfl-status fresh epoch) (lfl-status owed epoch)
    (lfl-status lapsed epoch) (lfl-status renewed epoch)
    (lfl-inspected? fresh) (lfl-offer-arm (lfl-offer fresh))
    (lfl-offer-arm (lfl-offer node-offer)) (lfl-status uninspected epoch)))
