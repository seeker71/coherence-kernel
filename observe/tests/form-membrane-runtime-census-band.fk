; form-membrane-runtime-census-band.fk -- pure crossing census/delta proof.
;
; The band never crosses a membrane and never opens a live window.  It uses
; fixture snapshots to prove per-tag deltas, sparse filtering, plane totals,
; uniqueness, and a denominator computed from the current census rather than a
; fixed target.  The live map freshness bit is kept separate because a changed
; generated tag map is an invitation to re-census, not a numerical failure.
;
; Expected today: 8191 (13 claims), direct fkwu.
; preludes: observe/form-membrane-runtime-census.fk

(do
    (defn fmrcb-bit (ok bit) (if ok bit 0))
    (defn fmrcb-before ()
        (list (list "host-exec" 136 "local-process" 2)
              (list "sock_request" 118 "network-address-unknown" 7)
              (list "metal_enqueue" 249 "metal-device" 10)
              (list "mlx_run" 145 "mlx-runtime" 0)))
    (defn fmrcb-after ()
        (list (list "host-exec" 136 "local-process" 3)
              (list "sock_request" 118 "network-address-unknown" 7)
              (list "metal_enqueue" 249 "metal-device" 14)
              (list "mlx_run" 145 "mlx-runtime" 0)))
    (defn form-membrane-runtime-census-band ()
        (do
            (let rows (fmrc-registry))
            (let deltas (fmrc-deltas (fmrcb-before) (fmrcb-after)))
            (sum (list
                (fmrcb-bit (str_eq (fmrc-version)
                    "form-membrane-runtime-census-v1") 1)
                (fmrcb-bit (gt (fmrc-registry-count) 0) 2)
                (fmrcb-bit (eq (fmrc-registry-count) (len rows)) 4)
                (fmrcb-bit (eq (fmrc-registry-unique?) 1) 8)
                (fmrcb-bit (eq (fmrc-has-tag-go rows 136) 1) 16)
                (fmrcb-bit (eq (fmrc-has-tag-go rows 118) 1) 32)
                (fmrcb-bit (eq (fmrc-has-tag-go rows 245) 1) 64)
                (fmrcb-bit (eq (len deltas) 2) 128)
                (fmrcb-bit (eq (fmrc-delta-total deltas) 5) 256)
                (fmrcb-bit (eq (fmrc-delta-plane-total deltas
                    "metal-device") 4) 512)
                (fmrcb-bit (eq (fmrc-delta-plane-total deltas
                    "network-address-unknown") 0) 1024)
                (fmrcb-bit (eq (fmrc-delta-has? deltas "host-exec") 1) 2048)
                (fmrcb-bit (eq (fmrc-delta-has? deltas "mlx_run") 0) 4096)))))
    (form-membrane-runtime-census-band))
