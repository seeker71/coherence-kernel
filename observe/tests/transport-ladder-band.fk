; observe/tests/transport-ladder-band.fk — proof of the transport reachability ladder.
;
; preludes: form-stdlib/core.fk observe/transport-ladder.fk
;
; run: cat form/form-stdlib/core.fk observe/transport-ladder.fk \
;          observe/tests/transport-ladder-band.fk > /tmp/tl.fk
;      ./fkwu --src /tmp/tl.fk    ; -> 31
;
; c0  today: only cloud-proxy built + reachable -> pick 8. THE CROSS-NETWORK CASE:
;     apart, no shared LAN, and the mesh still connects through the public proxy.
; c1  future co-present: every transport built + reachable -> pick 1 (wifi-direct,
;     the preferred direct radio) — the ladder climbs to the best when all are up.
; c2  HONEST FLOOR: bluetooth reachable but NOT implemented, cloud down -> pick 0.
;     The ladder refuses to route over a channel only named, never built.
; c3  co-present, no internet: bluetooth built + reachable, cloud down -> pick 3.
;     The mesh survives with no network at all, over the short-range radio.
; c4  resilience: three transports usable at once -> tl-count 3 (anastomotic mesh).

(do
    (defn tlb-score (ok bit) (if ok bit 0))
    (defn transport-ladder-band ()
        (do
            (let c0 (tlb-score (eq (tl-pick (tl-today)) 8) 1))
            (let all (list (tl-t 1 1 1) (tl-t 2 1 1) (tl-t 3 1 1) (tl-t 8 1 1)))
            (let c1 (tlb-score (eq (tl-pick all) 1) 2))
            (let named-only (list (tl-t 3 1 0) (tl-t 8 0 1)))
            (let c2 (tlb-score (eq (tl-pick named-only) 0) 4))
            (let offline-bt (list (tl-t 3 1 1) (tl-t 8 0 1)))
            (let c3 (tlb-score (eq (tl-pick offline-bt) 3) 8))
            (let three-up (list (tl-t 1 1 1) (tl-t 3 1 1) (tl-t 8 1 1) (tl-t 4 0 1)))
            (let c4 (tlb-score (eq (tl-count three-up) 3) 16))
            (add c0 (add c1 (add c2 (add c3 c4))))))
    (transport-ladder-band))
