; Form owns correlation and refuses a forged or incomplete return.
; preludes: form-stdlib/core.fk observe/form-voice-membrane.fk

(do
    (let digest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    (let opened (fvm-open "turn-41" digest 1))
    (let closed (fvm-close "turn-41" digest "request-evidence" "turn-41" 1))
    (let forged (fvm-close "turn-41" digest "request-evidence" "turn-42" 1))
    (if (and (ge (str_find opened "state=awaiting-external-return" 0) 0)
             (and (ge (str_find closed "closed=1" 0) 0)
                  (ge (str_find forged "state=uncorrelated-return" 0) 0))) 7 0))
