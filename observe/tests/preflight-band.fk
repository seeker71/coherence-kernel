; tests/preflight-band.fk — the pre-run pass, proved on the failures that made it.
;
; PROOF LEVEL: FOURTH-ARM + GO — Verdict 131071 on go and fkwu; preflight shells out to compare kernels.
;
; preludes: form-stdlib/core.fk observe/preflight.fk
;
; Verdict 131071 — seventeen readings. Every one is a question I answered by hand,
; at a cost of hours each, and every one is now one call.
;
; The pure half of the lane reading — kind, cache paths, brace surface, marker —
; is proven four-way in form/form-stdlib/tests/preflight-source-band.bml. What
; lives here is what only a real run can witness: the arms, the fresh compile,
; and the door's own exit code.
;
;   THE ARM MAP, PROBED RATHER THAN DECLARED
;   walk_recipe resolves on every AVAILABLE expected arm; if proof siblings
;     are not built, the classification says UNOBSERVED rather than lying      1
;   `nothing` resolves on every available arm, and is the availability probe    2
;   host-exec resolves on available go/fkwu arms (expected mask 9).
;     observe/review-ask.fk
;     says in prose "host-exec is fkwu-only: Go, Rust and TypeScript
;     have no such native" and its band declares FOURTH-ARM ONLY on that
;     sentence. Go answers the same five bytes. The sentence is mine,
;     four days old, written from inference — corpus row 914,
;     teleological. A probed map cannot make that mistake             4
;   a name no kernel has has mask 0                                       8
;
;   THE QUESTION THE DIAGNOSTIC CANNOT ANSWER
;   an unresolved name that nobody defines classifies as a TYPO          16
;   an unresolved name another kernel defines classifies as a LANE
;     SEAM — the same red line, two opposite repairs, and every
;     numb-green this week was the second read as neither               32
;   an unresolved name a unit in this tree defines, where the chain does
;     not load that unit, classifies as UNPRELUDED and names the unit.
;     It read TYPO before: tn-softmax called without
;     transformer-numerics.fk was sent to fix a spelling that was right 65536
;
;   THE PASS ITSELF
;   an unbalanced cell is caught without running anything (three cells
;     landed unbalanced this week and each was found only when
;     something refused to run)                                         64
;   the fresh compile finds the name a warm cache would have replaced
;     with a tally                                                     128
;   a clean cell reports zero errors, so the pass can say "nothing
;     here" and be believed                                            256
;   and the report names the file it read                              512
;   a source with NO compile lane is refused visibly and preserved
;     byte-identical                                                  1024
;   a marked effectful .fk is refused without executing its mutation 2048
;
;   THE LANE THE BODY IS ASKED TO WRITE IN
;   The authoring floor has been high-grammar BML since 2026-08-30, and
;   preflight read one thing off a path — does it end in ".fk" — so the
;   cells most likely to be written today were the ones it could not
;   vouch for. It said so in a row and then exited 0.
;   a .bml is compiled fresh and its unresolved name is named           4096
;   and a SECOND run says the same, because the artifacts removed were
;     the ones this unit actually writes (x.bml.fkb, not x.fkb). The
;     old shape removed a file that was never there, and the warm image
;     answered `cached image was compiled with errors` — no name, no
;     line. Witnessed 2026-09-10: the page read `unresolved 0`         8192
;   a .bml marked `// preflight-exec: forbidden` — the marker in its own
;     tongue — is refused without executing its mutation              16384
;   and the runner door's exit code agrees with its own page: nonzero
;     when no verdict can be read, zero when one can. AGENTS.md item 9
;     asks a reader to read the exit code rather than the number, and
;     this door answered 0 to everything it was ever asked            32768

(do
    (defn pfb (ok bit) (if ok bit 0))
    (defn pfb-tmp () (do (fs_mkdir (str_concat (temp_dir) "/preflight-band"))
                         (str_concat (temp_dir) "/preflight-band")))
    (defn pfb-case (name text)
        (do (let p (str_concat (pfb-tmp) (str_concat "/" name)))
            (write_file p text)
            p))

    (defn pfb-check ()
        (do
            (let typo  (pfb-case "typo.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn f (x) (add x (zzz-no-such-name x))) 7)\n"))
            (let seam  (pfb-case "seam.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn g (x) (walk_recipe x)) 7)\n"))
            (let unbal (pfb-case "unbal.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn h (x) (add x 1)\n"))
            (let clean (pfb-case "clean.fk"
                "; preludes: form-stdlib/core.fk\n(do (add 1 2))\n"))
            (let plain-text "(Grammar preflight_source_preservation)\n")
            (let plain (pfb-case "source.txt" plain-text))
            ;; the lane the body is asked to write in
            (let bml-bad (pfb-case "lane.bml"
                "// lane.bml\nsection [form.bml] {\n    class PfbLane {\n        def pfb-lane() = zzz-no-such-name(1);\n    }\n}\n"))
            (let bml-sentinel (str_concat (pfb-tmp) "/bml-effect-ran"))
            (let _bml-clear (fs_remove bml-sentinel))
            (let bml-effect (pfb-case "lane-effect.bml"
                (pf-cat (list "// preflight-exec: forbidden\nsection [form.bml] {\n    write_file(\""
                              bml-sentinel "\", \"executed\");\n}\n"))))
            (let effect-sentinel (str_concat (pfb-tmp) "/effect-ran"))
            (let _effect-clear (fs_remove effect-sentinel))
            (let effect (pfb-case "effect.fk"
                (str_concat "; preflight-exec: forbidden\n; preludes: form-stdlib/core.fk\n(do (write_file \""
                    (str_concat effect-sentinel "\" \"executed\") 0)\n"))))
            (let rt (pf-report typo))
            (let rs (pf-report seam))
            (let ru (pf-report unbal))
            (let rc (pf-report clean))
            (let rp (pf-report plain))
            (let re (pf-report effect))
            ;; The .bml is read TWICE on purpose. The first page proves the lane
            ;; is walked at all; the second proves the walk left no image behind
            ;; that could answer for it. One reading cannot tell those apart.
            (let rl1 (pf-report bml-bad))
            (let rl2 (pf-report bml-bad))
            (let rle (pf-report bml-effect))
            ;; The door's own exit code, read through the process-local stdin
            ;; door — the fixed /tmp path is shared with every other hand in
            ;; this tree, and a band that writes it stains what it measures.
            (defn pfb-door (target)
                (pf-run-checked (pf-cat (list "printf '%s\\n' " target
                                              " | ./fkwu observe/preflight-stdin-run.fk"))))
            (let door-clean (pfb-door clean))
            (let door-broken (pfb-door bml-bad))
            (let ready (pf-arm-availability-mask))
            (add (pfb (if (eq ready 15)
                          (eq (pf-arm-mask "walk_recipe") 7)
                          (ge (str_find (pf-classify "walk_recipe") "UNOBSERVED" 0) 0)) 1)
            (add (pfb (eq (pf-arm-mask "nothing") ready) 2)
            (add (pfb (eq (pf-arm-mask "host-exec")
                          (pf-mask-intersection 9 ready)) 4)
            (add (pfb (eq (pf-arm-mask "zzz-no-such-name") 0) 8)
            (add (pfb (ge (str_find (pf-classify "zzz-no-such-name")
                          (if (eq ready 15) "TYPO" "UNOBSERVED") 0) 0) 16)
            (add (pfb (ge (str_find (pf-classify "walk_recipe")
                          (if (eq ready 15) "LANE SEAM" "UNOBSERVED") 0) 0) 32)
            (add (pfb (ge (str_find ru "UNBALANCED" 0) 0) 64)
            (add (pfb (ge (str_find rt "zzz-no-such-name" 0) 0) 128)
            (add (pfb (ge (str_find rc "errors        0" 0) 0) 256)
            (add (pfb (ge (str_find rc "clean.fk" 0) 0) 512)
            (add (pfb (if (str_eq (read_file plain) plain-text)
                          (if (ge (str_find rp "source preserved" 0) 0) 1 0)
                          0) 1024)
            (add (pfb (if (eq (fs_exists effect-sentinel) 0)
                          (if (ge (str_find re "EFFECTFUL EXECUTION REFUSED" 0) 0) 1 0)
                          0) 2048)
            (add (pfb (and (ge (str_find rl1 "source-kind   bml" 0) 0)
                           (ge (str_find rl1 "zzz-no-such-name" 0) 0)) 4096)
            (add (pfb (ge (str_find rl2 "zzz-no-such-name" 0) 0) 8192)
            (add (pfb (if (eq (fs_exists bml-sentinel) 0)
                          (if (ge (str_find rle "EFFECTFUL EXECUTION REFUSED" 0) 0) 1 0)
                          0) 16384)
            (add (pfb (and (eq (pf-command-failed? door-clean) 0)
                           (and (eq (pf-command-failed? door-broken) 1)
                                (ge (str_find door-broken "exit=1" 0) 0))) 32768)
            (add (pfb (if (eq ready 15)
                          (and (ge (str_find (pf-classify "tn-softmax") "UNPRELUDED" 0) 0)
                               (ge (str_find (pf-classify "tn-softmax")
                                             "form/form-stdlib/transformer-numerics.fk" 0) 0))
                          (ge (str_find (pf-classify "tn-softmax") "UNOBSERVED" 0) 0)) 65536)
                 0)))))))))))))))))))

    (pfb-check))
