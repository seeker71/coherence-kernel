; tests/preflight-band.fk — the pre-run pass, proved on the failures that made it.
;
; PROOF LEVEL: FOURTH-ARM + GO — 4095 on go and fkwu (witnessed 2026-09-03; host-exec pf-arm-mask 9); preflight shells out to compare kernels.
;
; preludes: form-stdlib/core.fk observe/preflight.fk
;
; Verdict 4095 — twelve readings. Every one is a question I answered by hand this
; week, at a cost of hours each, and every one is now one call.
;
;   THE ARM MAP, PROBED RATHER THAN DECLARED
;   walk_recipe resolves on every AVAILABLE expected arm; if proof siblings
;     are not built, the classification says UNOBSERVED rather than lying      1
;   `nothing` resolves on every available arm, and is the availability probe    2
;   host-exec resolves on available go/fkwu arms (expected mask 9).
;     observe/review-ask.fk
;     says in prose "host-exec is fkwu-only: Go, Rust and TypeScript
;     have no such native" and its band declares FOURTH-ARM ONLY on that
;     sentence. Go answers the same five bytes. The sentence is mine,
;     four days old, written from inference — corpus row 914,
;     teleological. A probed map cannot make that mistake             4
;   a name no kernel has has mask 0                                       8
;
;   THE QUESTION THE DIAGNOSTIC CANNOT ANSWER
;   an unresolved name that nobody defines classifies as a TYPO          16
;   an unresolved name another kernel defines classifies as a LANE
;     SEAM — the same red line, two opposite repairs, and every
;     numb-green this week was the second read as neither               32
;
;   THE PASS ITSELF
;   an unbalanced cell is caught without running anything (three cells
;     landed unbalanced this week and each was found only when
;     something refused to run)                                         64
;   the fresh compile finds the name a warm cache would have replaced
;     with a tally                                                     128
;   a clean cell reports zero errors, so the pass can say "nothing
;     here" and be believed                                            256
;   and the report names the file it read                              512
;   a non-.fk source is refused visibly and preserved byte-identical 1024
;   a marked effectful .fk is refused without executing its mutation 2048

(do
    (defn pfb (ok bit) (if ok bit 0))
    (defn pfb-tmp () (do (fs_mkdir (str_concat (temp_dir) "/preflight-band"))
                         (str_concat (temp_dir) "/preflight-band")))
    (defn pfb-case (name text)
        (do (let p (str_concat (pfb-tmp) (str_concat "/" name)))
            (write_file p text)
            p))

    (defn pfb-check ()
        (do
            (let typo  (pfb-case "typo.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn f (x) (add x (zzz-no-such-name x))) 7)\n"))
            (let seam  (pfb-case "seam.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn g (x) (walk_recipe x)) 7)\n"))
            (let unbal (pfb-case "unbal.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn h (x) (add x 1)\n"))
            (let clean (pfb-case "clean.fk"
                "; preludes: form-stdlib/core.fk\n(do (add 1 2))\n"))
            (let bml-text "(Grammar preflight_source_preservation)\n")
            (let bml (pfb-case "source.bml" bml-text))
            (let effect-sentinel (str_concat (pfb-tmp) "/effect-ran"))
            (let _effect-clear (fs_remove effect-sentinel))
            (let effect (pfb-case "effect.fk"
                (str_concat "; preflight-exec: forbidden\n; preludes: form-stdlib/core.fk\n(do (write_file \""
                    (str_concat effect-sentinel "\" \"executed\") 0)\n"))))
            (let rt (pf-report typo))
            (let rs (pf-report seam))
            (let ru (pf-report unbal))
            (let rc (pf-report clean))
            (let rb (pf-report bml))
            (let re (pf-report effect))
            (let ready (pf-arm-availability-mask))
            (add (pfb (if (eq ready 15)
                          (eq (pf-arm-mask "walk_recipe") 7)
                          (ge (str_find (pf-classify "walk_recipe") "UNOBSERVED" 0) 0)) 1)
            (add (pfb (eq (pf-arm-mask "nothing") ready) 2)
            (add (pfb (eq (pf-arm-mask "host-exec")
                          (pf-mask-intersection 9 ready)) 4)
            (add (pfb (eq (pf-arm-mask "zzz-no-such-name") 0) 8)
            (add (pfb (ge (str_find (pf-classify "zzz-no-such-name")
                          (if (eq ready 15) "TYPO" "UNOBSERVED") 0) 0) 16)
            (add (pfb (ge (str_find (pf-classify "walk_recipe")
                          (if (eq ready 15) "LANE SEAM" "UNOBSERVED") 0) 0) 32)
            (add (pfb (ge (str_find ru "UNBALANCED" 0) 0) 64)
            (add (pfb (ge (str_find rt "zzz-no-such-name" 0) 0) 128)
            (add (pfb (ge (str_find rc "errors        0" 0) 0) 256)
            (add (pfb (ge (str_find rc "clean.fk" 0) 0) 512)
            (add (pfb (if (str_eq (read_file bml) bml-text)
                          (if (ge (str_find rb "source preserved" 0) 0) 1 0)
                          0) 1024)
            (add (pfb (if (eq (fs_exists effect-sentinel) 0)
                          (if (ge (str_find re "EFFECTFUL EXECUTION REFUSED" 0) 0) 1 0)
                          0) 2048)
                 0))))))))))))))

    (pfb-check))
