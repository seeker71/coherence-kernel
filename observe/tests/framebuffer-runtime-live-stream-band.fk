; framebuffer-runtime-live-stream-band.fk -- extracted canonical stream shape.
; Expected: 8191 (13 bits)
; preludes: observe/framebuffer-runtime-live-stream.fk

(do
    (defn fbrolsb-bit (held weight) (if held weight 0))
    (defn framebuffer-runtime-live-stream-band ()
        (do
            (let window (fbro-open-stream "live-stream-subset-proof" "Sema"
                "observes-resident-movement" "keep-stage-visible"
                "opaque-only" 12
                "observe/tests/framebuffer-runtime-live-stream-band.fk" 11 7))
            (print_str "\n")
            (let before (fbro-snapshot))
            (let work (sum (list 1 2 3 4)))
            (let after (fbro-snapshot))
            (let stage (fbro-stage-observed-stream
                "live-stream-subset-proof" "pure-work" "begin" "Sema"
                "observes-resident-movement" "keep-stage-visible"
                "opaque-only" before after "sum" work "observed"
                "observe/tests/framebuffer-runtime-live-stream-band.fk" 20 7))
            (print_str "\n")
            (let report (fbro-close-stream window "completed" work
                "observe/tests/framebuffer-runtime-live-stream-band.fk" 24 7))
            (print_str "\n")
            (let events (fbro-events report))
            (sum (list
                (fbrolsb-bit (str_eq (head report)
                    "framebuffer-runtime-observation") 1)
                (fbrolsb-bit (str_eq (nth (nth report 1) 1)
                    "live-stream-subset-proof") 2)
                (fbrolsb-bit (eq (nth (nth report 1) 3) 3) 4)
                (fbrolsb-bit (value_eq (nth (nth report 2) 1)
                    (list "observe/tests/framebuffer-runtime-live-stream-band.fk"
                          11 7)) 8)
                (fbrolsb-bit (str_eq (nth (nth report 3) 1) "Sema") 16)
                (fbrolsb-bit (str_eq (nth (nth report 4) 3)
                    "opaque-only") 32)
                (fbrolsb-bit (ge (nth (nth report 5) 5) 0) 64)
                (fbrolsb-bit (gt (nth (nth report 6) 2) 0) 128)
                (fbrolsb-bit (str_eq (nth (nth report 7) 1)
                    "completed") 256)
                (fbrolsb-bit (eq (len events) 3) 512)
                (fbrolsb-bit (str_eq (head (nth (nth events 0) 3))
                    "begin") 1024)
                (fbrolsb-bit (str_eq (nth (nth (nth events 1) 3) 2)
                    "pure-work") 2048)
                (fbrolsb-bit (str_eq (head (nth (nth events 2) 3))
                    "end") 4096)))))
    (framebuffer-runtime-live-stream-band))
