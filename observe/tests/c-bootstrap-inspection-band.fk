; preludes: form-stdlib/bml/c-bootstrap-inspection.bml
(do
 (let source "#if X\nstatic int x, *y;\nint f(int x) { char *s = \"}\"; /* } */ return x; }\n#else\nint f(int x)\n{ return 0; }\n#endif\nstatic int (*call)(int);\nstatic int a[] = {1, 2};\nstruct T { int x; };\n")
 (let rows (cbi-inventory source))
 (let body-source "static int pair[] = {1, 2};\nint f(void) { static int held[] = {3, 4}; return held[0]; }\n")
 (let body-rows (cbi-inventory body-source))
 (let body-statics (cbi-all-statics body-source body-rows))
 (print (cbi-summary rows))
 (print (list (eq (cbi-count rows "function") 2)
              (eq (cbi-count rows "declaration") 4)
              (eq (cbi-count rows "directive") 3)
              (eq (cbi-count rows "unresolved") 0)
              (eq (cbi-count rows "unresolved-brace") 0)
              (str_eq (cbi-fn-name (nth (nth rows 2) 5) "" "" 0) "f")
              (eq (cbi-global-count body-rows) 1)
              (eq (len body-statics) 1)
              (str_eq (head (cbi-global-names (nth (head body-statics) 1))) "held")
              (eq (cbi-definition-line rows "f") 3)
              (eq (cbi-regions-valid (list (list 3 "a") (list 6 "b")) 0) 1)
              (eq (cbi-regions-valid (list (list -1 "missing")) 0) 0)
              (str_eq (cbi-family 5 (list (list 0 "a") (list 6 "b"))) "a")
              (str_eq (cbi-family 6 (list (list 0 "a") (list 6 "b"))) "b"))))
