; observe/tests/journey-phase-band.fk — proof of the first two-instance organ.
;
; preludes: form-stdlib/core.fk observe/journey-phase.fk
;
; run: cat form/form-stdlib/core.fk observe/journey-phase.fk \
;          observe/tests/journey-phase-band.fk > /tmp/jp.fk
;      ./fkwu --src /tmp/jp.fk    ; -> 31
;
; c0 is the LIVE founding vector (2026-07-07, airport gate, phone on the Mac's
; cable): 1006 hPa steady, tethered -> 101 (ground, steady, together). The rest
; are the journey ahead of it: climb, cruise, descent, and the honest 0 for a
; pressure no phase band claims.

(do
    (defn jpb-score (ok bit) (if ok bit 0))
    (defn journey-phase-band ()
        (do
            (let c0 (jpb-score (eq (jp-read 1006 1006 1) 101) 1))
            (let c1 (jpb-score (eq (jp-read 1006 940 1) 211) 2))
            (let c2 (jpb-score (eq (jp-read 812 810 0) 310) 4))
            (let c3 (jpb-score (eq (jp-read 880 900 1) 221) 8))
            (let c4 (jpb-score (eq (jp-read 650 650 0) 0) 16))
            (add c0 (add c1 (add c2 (add c3 c4))))))
    (journey-phase-band))
