; carrier-mass-band.fk — the carrier-mass lens classes every planted path,
; sheds what is not its own, sums what it weighs, and folds honestly.
;
; Verdict 16383 (fourteen bits):
;   1      seed / metal-shell / scripts each resolve from a planted path
;   2      doors: three prefixes (cuda, mlx, vulkan), one class
;   4      carriers: presence/carriers, native/presence, native/audio
;   8      witnesses: the three kernels and walkers/
;   16     fixtures: model/fixtures, presence/fixtures, presence/concept-pl-*
;   32     tooling: tools/, python_bmf, os/
;   64     other catches the unknown, the empty path, and a prefix that is
;          only a substring (docs/runtime/x.c is not the seed)
;   128    one wc line parses to (path, lines); the total line and a blank
;          line parse to nothing-to-add (an empty row, never a crash)
;   256    exclusion rows shed seedbank and node_modules before classing:
;          a seedbank .ts under form-kernel-ts never becomes a witness
;   512    per-class files and lines over a planted wc text; seed-lines is
;          fkwu-uni.c alone; shell excludes the seed class and the witnesses
;   1024   the fold and its places: 100/501/7 -> 100000501007; today's
;          16190/43414/130 -> 16190043414130; 1/999999/999 stays in place
;   2048   an empty list answers zeros in every place, and host-exec's
;          nothing answers 0 through the named-absence door - no crash
;   4096   line and suffix counts: a last line without its newline counts
;   8192   every class in the table has a seat in the print order, and the
;          order has exactly the table's classes plus other - no class hides
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane and reads
; git through host-exec.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml observe/carrier-mass.bml
;
; The organ's top-level statement runs the real walk when preluded, so a
; run of this band prints the body's carrier-mass report first; the one
; "host-exec answered nothing" line after it is bit 2048 opening the
; named-absence door on purpose; the verdict is the last line and the
; exit code.
;
; run: ./fkwu observe/tests/carrier-mass-band.fk    ; -> 16383
;
; witnessed: 2026-09-04 -> 16383

(do
    (defn cmb-k (cond bit) (if cond bit 0))
    (defn cmb-class? (path class) (str_eq (cm-class-of path) class))
    (defn cmb-member? (xs s)
        (if (eq (len xs) 0) 0
            (if (str_eq (head xs) s) 1 (cmb-member? (tail xs) s))))
    (defn cmb-all-seated? (rows order)
        (if (eq (len rows) 0) 1
            (if (eq (cmb-member? order (nth (head rows) 0)) 1)
                (cmb-all-seated? (tail rows) order)
                0)))
    (defn cmb-wc-row-is? (w path lines)
        (and (eq (len w) 2)
             (and (str_eq (nth w 0) path) (eq (nth w 1) lines))))
    (defn carrier-mass-band ()
        (do
            (let planted (str_concat "  100 runtime/fkwu-uni.c\n   10 runtime/fkwu-optable.h\n  200 form/native/metal/a.sh\n"
                         (str_concat "  300 form/scripts/b.py\n  400 form/form-kernel-go/main.go\n   50 form/form-kernel-ts/seedbank/x.ts\n"
                                     "   60 tools/node_modules/y.mjs\n    1 cognition/c.mjs\n 1121 total\n")))
            (let rows (cm-rows-of-text planted))
            (let none (cm-rows-of-text ""))
            (let c0  (cmb-k (and (cmb-class? "runtime/fkwu-uni.c" "seed")
                                 (and (cmb-class? "form/native/metal/dsv4-stone-9.sh" "metal-shell")
                                      (cmb-class? "form/scripts/validate_form_ontology.py" "scripts"))) 1))
            (let c1  (cmb-k (and (cmb-class? "form/native/cuda/ptx-host.c" "doors")
                                 (and (cmb-class? "form/native/mlx/fk-mlx-carrier.c" "doors")
                                      (cmb-class? "form/native/vulkan/door.c" "doors"))) 2))
            (let c2  (cmb-k (and (cmb-class? "presence/carriers/mic.swift" "carriers")
                                 (and (cmb-class? "form/native/presence/sense.m" "carriers")
                                      (cmb-class? "form/native/audio/ring.c" "carriers"))) 4))
            (let c3  (cmb-k (and (cmb-class? "form/form-kernel-go/main.go" "witnesses")
                                 (and (cmb-class? "form/form-kernel-rust/src/main.rs" "witnesses")
                                      (and (cmb-class? "form/form-kernel-ts/src/main.ts" "witnesses")
                                           (cmb-class? "walkers/go/walker.go" "witnesses")))) 8))
            (let c4  (cmb-k (and (cmb-class? "model/fixtures/whisper-tiny/fetch.py" "fixtures")
                                 (and (cmb-class? "presence/fixtures/concept-pl-public-algorithms-13/a.c" "fixtures")
                                      (cmb-class? "presence/concept-pl-execution-13-fixtures/b.py" "fixtures"))) 16))
            (let c5  (cmb-k (and (cmb-class? "tools/bench.sh" "tooling")
                                 (and (cmb-class? "form/python_bmf/bmf.py" "tooling")
                                      (cmb-class? "os/hati-os/boot.sh" "tooling"))) 32))
            (let c6  (cmb-k (and (cmb-class? "cognition/concept-x-build.mjs" "other")
                                 (and (cmb-class? "form/validate.sh" "other")
                                      (and (cmb-class? "" "other")
                                           (cmb-class? "docs/runtime/x.c" "other")))) 64))
            (let c7  (cmb-k (and (cmb-wc-row-is? (cm-wc-row "   16190 runtime/fkwu-uni.c") "runtime/fkwu-uni.c" 16190)
                                 (and (eq (len (cm-wc-row " 1121 total")) 0)
                                      (and (eq (len (cm-wc-row "")) 0)
                                           (eq (len (cm-wc-row "   ")) 0)))) 128))
            (let c8  (cmb-k (and (eq (len rows) 6)
                                 (and (eq (cm-class-files rows "witnesses") 1)
                                      (and (eq (cm-excluded? "form/form-kernel-ts/seedbank/x.ts") 1)
                                           (and (eq (cm-excluded? "tools/node_modules/y.mjs") 1)
                                                (eq (cm-excluded? "form/form-kernel-ts/src/main.ts") 0))))) 256))
            (let c9  (cmb-k (and (eq (cm-class-files rows "seed") 2)
                                 (and (eq (cm-class-lines rows "seed") 110)
                                      (and (eq (cm-class-lines rows "metal-shell") 200)
                                           (and (eq (cm-class-lines rows "scripts") 300)
                                                (and (eq (cm-class-lines rows "witnesses") 400)
                                                     (and (eq (cm-class-files rows "other") 1)
                                                          (and (eq (cm-seed-lines rows) 100)
                                                               (and (eq (cm-shell-lines rows) 501)
                                                                    (eq (cm-outside-witnesses-lines rows) 611))))))))) 512))
            (let c10 (cmb-k (and (eq (cm-field 100 501 7) 100000501007)
                                 (and (eq (cm-field 16190 43414 130) 16190043414130)
                                      (eq (cm-field 1 999999 999) 1999999999))) 1024))
            (let c11 (cmb-k (and (eq (len none) 0)
                                 (and (eq (cm-class-files none "seed") 0)
                                      (and (eq (cm-class-lines none "other") 0)
                                           (and (eq (cm-seed-lines none) 0)
                                                (and (eq (cm-shell-lines none) 0)
                                                     (and (eq (cm-field (cm-seed-lines none) (cm-shell-lines none) (cm-count-lines "")) 0)
                                                          (eq (cm-run-at (nothing)) 0))))))) 2048))
            (let c12 (cmb-k (and (eq (cm-count-lines "a.fk\nb.bml\n") 2)
                                 (and (eq (cm-count-lines "a.fk") 1)
                                      (and (eq (cm-count-suffix "a.fk\nb.bml\nc.fk\n" ".fk") 2)
                                           (eq (cm-count-suffix "a.fk\nb.bml\nc.fk" ".bml") 1)))) 4096))
            (let c13 (cmb-k (and (eq (len (cm-class-order)) 9)
                                 (and (eq (cmb-all-seated? (cm-classes) (cm-class-order)) 1)
                                      (eq (cmb-member? (cm-class-order) "other") 1))) 8192))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
            (add c8 (add c9 (add c10 (add c11 (add c12 c13)))))))))))))))
    (carrier-mass-band))
