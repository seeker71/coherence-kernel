; band-head-band.fk — what a band says in its comment head is read in Form, as validate.sh needs it.
;
; preludes: observe/band-head.bml
;
; run: ./fkwu observe/tests/band-head-band.fk   ; -> 255
;
; Fixtures are texts, so no file but this band's own is read.
;
; Verdict 255:
;   1    the proof level is the word after `; PROOF LEVEL: `, upper-case letters and hyphens only;
;        a band without the line answers nothing
;   2    the staged carrier is the path after `; STAGED CARRIER: ` up to its first space, and the
;        longer `; STAGED CARRIER DOOR: ` line is never taken for it
;   4    the carrier door is the whole command after `; STAGED CARRIER DOOR: `
;   8    the head pin is the digits after the first `Verdict ` in the comment head, and a pin
;        that stands after the first code line is not read
;   16   `Verdict: 131 (P1)` (prose about a sum) is no pin, and a `Verdict` word without digits
;        is passed over for the next that has them
;   32   a blank line keeps the head going; a code line ends it
;   64   the manifest row names the stem and its third field is the registered verdict; a `#`
;        line is no row, and a stem that is not there answers nothing
;   128  this band's own file reads its own head pin, 255

(do
    (defn bhb-k (ok bit) (if ok bit 0))
    (defn bhb-nl () (byte_to_str 10))
    (defn bhb-j (a b) (str_concat a (str_concat (bhb-nl) b)))
    (defn bhb-band ()
        (bhb-j "; a band"
        (bhb-j "; PROOF LEVEL: FKWU-STAGED (vulkan door: run_vk through host-exec)"
        (bhb-j "; STAGED CARRIER DOOR: ./fkwu observe/vk-carrier-build.bml"
        (bhb-j "; STAGED CARRIER: .hearth/vk/run_vk and more"
        (bhb-j "; Verdict 1023 when the device answers:"
        (bhb-j "(do 1)"
               "; Verdict 99")))))))
    (defn bhb-manifest ()
        (bhb-j "# stem fks verdict"
        (bhb-j "# channel-flow fks 1"
        (bhb-j "channel-flow fks 8388607"
               "form-pe-coff   bml   16383"))))
    (defn band-head-band ()
        (do
            (let band (bhb-band))
            (let own (read_file "observe/tests/band-head-band.fk"))
            (sum (list
                (bhb-k (and (str_eq (bh-level band) "FKWU-STAGED")
                            (str_eq (bh-level "; no level here\n(do 1)\n") "")) 1)
                (bhb-k (and (str_eq (bh-carrier band) ".hearth/vk/run_vk")
                            (str_eq (bh-carrier "; STAGED CARRIER DOOR: ./fkwu x.bml\n") "")) 2)
                (bhb-k (str_eq (bh-door band) "./fkwu observe/vk-carrier-build.bml") 4)
                (bhb-k (and (str_eq (bh-pin band) "1023")
                            (str_eq (bh-pin "(do 1)\n; Verdict 7\n") "")) 8)
                (bhb-k (and (str_eq (bh-pin "; Verdict: 131 (P1) + 12*42 (P2) = 635\n(do 1)\n") "")
                            (str_eq (bh-pin "; the Verdict is plain\n; Verdict 5 then\n(do 1)\n") "5")) 16)
                (bhb-k (and (str_eq (bh-pin (bhb-j "; head" (bhb-j "" (bhb-j "; Verdict 11" "(do 1)")))) "11")
                            (str_eq (bh-pin (bhb-j "; head" (bhb-j "(do 1)" "; Verdict 12"))) "")) 32)
                (bhb-k (and (str_eq (bh-row-name (bhb-manifest) "channel-flow") "channel-flow")
                            (and (str_eq (bh-row-pin (bhb-manifest) "channel-flow") "8388607")
                                 (and (str_eq (bh-row-pin (bhb-manifest) "form-pe-coff") "16383")
                                      (and (str_eq (bh-row-name (bhb-manifest) "nosuch") "")
                                           (str_eq (bh-row-pin (bhb-manifest) "stem") ""))))) 64)
                (bhb-k (str_eq (bh-pin own) "255") 128)))))
    (band-head-band))
