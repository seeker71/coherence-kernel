; tests/crossing-record-band.fk — the band for observe/crossing-record.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk observe/crossing-record.fk
;
; The band does NOT cross the membrane. It walks a fixture ledger, so the reading
; is the same on every run. The recording itself is witnessed by using the door.
;
; b2 and b3 are why the walk is a reading: empty text holds no rows and sums to
; nothing. b4 and b5 read the two columns APART — a folder that returned the same
; number for both would pass one and fall on the other.
;
; b8 PERTURBS THE TOP LEVEL: a one-row ledger and a two-row ledger count apart.
;
; witnessed: 2026-08-15 -> 255 on fkwu.

(do
    (defn xcb-k (cond bit) (if cond bit 0))
    (defn xcb-one () "1000\t12\t400\n")
    (defn xcb-line-shape () (xc-line 7 3 9))
    (defn crossing-record-band ()
        (add (add (add (add (add (add (add
            ; two rows in, two rows counted
            (xcb-k (eq (xc-count-text (xc-fx)) 2) 1)
            ; nothing recorded is nothing counted
            (xcb-k (eq (xc-count-text "") 0) 2))
            (xcb-k (if (eq (xc-sum-text "" 1) 0) (eq (xc-sum-text "" 2) 0) 0) 4))
            ; the two columns read APART: 12+8 out, 400+68 back
            (xcb-k (eq (xc-sum-text (xc-fx) 1) 20) 8))
            (xcb-k (eq (xc-sum-text (xc-fx) 2) 468) 16))
            ; a line carries three fields and ends the row
            (xcb-k (eq (xc-count-text (xcb-line-shape)) 1) 32))
            ; and the command TEXT is never in it — only its length
            (xcb-k (lt (str_find (xc-line 1 5 5) "claude" 0) 0) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: one row and two count apart
            (xcb-k (if (eq (xc-count-text (xcb-one)) (xc-count-text (xc-fx))) 0 1) 128)))
    (crossing-record-band))
