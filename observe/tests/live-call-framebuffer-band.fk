; live-call-framebuffer-band.fk -- a long call can be inspected from its own
; source-attributed framebuffer cells before it completes.
; Verdict 2047 proves eleven shape, source, ordering, bounded projection, and
; append-only window properties.
; preludes: form/form-stdlib/core.fk form/form-stdlib/living-world-organ.fk observe/live-call-framebuffer.fk

(do
  (let reads-before (kernel_stat 229))
  (let started (lcfb-open-stream "lcfb-band" "form" "band" "window"
                  "observe/tests/live-call-framebuffer-band.fk" 8 16))
  (let enter (lcfb-call-stream "lcfb-band" "held-call" "enter" "form"
                "offered-modifier" "offered-target" 1 started
                "observe/tests/live-call-framebuffer-band.fk" 11 16))
  (let leave (lcfb-call-stream "lcfb-band" "held-call" "leave" "form"
                "offered-modifier" "offered-target" 2 started
                "observe/tests/live-call-framebuffer-band.fk" 14 16))
  (let appended (lcfb-call-stream-elapsed "lcfb-band" "nested-call" "modify"
                  "form" "nested-observer" "same-window" 3 0
                  "observe/tests/live-call-framebuffer-band.fk" 18 18))
  (let reads-before-boundary (kernel_stat 229))
  (let events (framebuffer-events))
  (let reads-after-boundary (kernel_stat 229))
  (let enter-source (node_source enter))
  (sum (list
    (if (eq (lcfb-call? enter) 1) 1 0)
    (if (eq (lcfb-call? leave) 1) 2 0)
    (if (eq (len events) 4) 4 0)
    (if (eq (len enter-source) 3) 8 0)
    (if (str_eq (nth enter-source 0)
          "observe/tests/live-call-framebuffer-band.fk") 16 0)
    (if (eq (nth enter-source 1) 11) 32 0)
    (if (str_eq (node_value (nth (node_children enter) 3)) "enter") 64 0)
    (if (str_eq (node_value (nth (node_children leave) 3)) "leave") 128 0)
    (if (str_eq
          (lcfb-call-line "t" "c" "modify" "a" "m" "x" 3 5 7)
          "child-call-framebuffer|schema=v1|trace=t|call=c|phase=modify|actor=a|modifier=m|target=x|ordinal=3|elapsed-ms=5|frames=7")
        256 0)
    (if (and (eq (lcfb-call? appended) 1)
             (eq (node_value (nth (node_children appended) 8)) 0))
        512 0)
    (if (and (eq reads-before-boundary reads-before)
             (eq (sub reads-after-boundary reads-before-boundary) 1))
        1024 0))))
