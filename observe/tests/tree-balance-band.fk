; tree-balance-band.fk — the sweep walks the tree in Form: fs_list down the directories, no `find`, no `sort`.
;
; Verdict 31:
;   1   the walk of a synthetic tree answers its `*.fk` files as paths under the root, one per line, in byte order
;       (".hid/x.fk" before "a.fk" before "b.fk" before "sub/deep/y.fk" before "sub/z.fk": the sort is over whole paths,
;       so a directory's files are not kept together)
;   2   what is not a cell is not listed: a .fkb, a .fkx, a text file, and a directory named like a cell (the walk enters it
;       and lists the cells inside it, not the directory)
;   4   `.git` is skipped at the root only: a `.git/inside.fk` at the root is not listed, a `sub/.git/inside.fk` is
;   8   a directory that does not exist walks to nothing (an empty answer, no stop), and an empty directory too
;   16  the sweep's own answer for this checkout is the one `find . -name '*.fk' -not -path './.git/*' | sort` gave: the
;       list is sorted, every line begins `./` and ends `.fk`, there are no repeats, and the cells this band depends on
;       (./observe/tree-balance.fk and this band) are in it
;
; REQUIRES: nothing outside the tree. Writes only under temp_dir and removes what it made.
; preludes: form-stdlib/core.fk observe/tree-balance.fk
(do
    (defn tbb-bit (ok bit) (if ok bit 0))
    (defn tbb-root () (str_concat (temp_dir) (str_concat "/tree-balance-band-" (value_str (host_pid)))))
    (defn tbb-put (rel text)
        (do (let p (str_concat (tbb-root) (str_concat "/" rel)))
            (write_file p text)
            p))
    (defn tbb-lines-from (s at)
        (if (ge at (len s)) (list)
            (cons (substring s at (str_find s "\n" at)) (tbb-lines-from s (add (str_find s "\n" at) 1)))))
    (defn tbb-lines (s) (tbb-lines-from s 0))
    (defn tbb-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (tbb-cat (tail xs)))))
    (defn tbb-ordered (xs)
        (if (lt (len xs) 2) 1
            (if (gt (str-compare (head xs) (nth xs 1)) 0) 0 (tbb-ordered (tail xs)))))
    (defn tbb-nonempty (xs)
        (if (eq (len xs) 0) (list)
            (if (gt (len (head xs)) 0) (cons (head xs) (tbb-nonempty (tail xs))) (tbb-nonempty (tail xs)))))
    (defn tbb-has (s needle) (if (ge (str_find s needle 0) 0) 1 0))
    (defn tbb-begins (s needle) (if (eq (str_find s needle 0) 0) 1 0))
    (defn tbb-ends (s needle) (if (and (ge (len s) (len needle)) (str_eq (substring s (sub (len s) (len needle)) (len s)) needle)) 1 0))
    (defn tbb-all-shaped (xs)
        (if (eq (len xs) 0) 1
            (if (and (eq (tbb-begins (head xs) "./") 1) (eq (tbb-ends (head xs) ".fk") 1)) (tbb-all-shaped (tail xs)) 0)))
    (defn tbb-no-repeat (xs)
        (if (lt (len xs) 2) 1
            (if (str_eq (head xs) (nth xs 1)) 0 (tbb-no-repeat (tail xs)))))
    (let root (tbb-root))
    (let made (host_dir_mkdir root))
    (let d1 (host_dir_mkdir (str_concat root "/sub")))
    (let d2 (host_dir_mkdir (str_concat root "/sub/deep")))
    (let d3 (host_dir_mkdir (str_concat root "/.hid")))
    (let d4 (host_dir_mkdir (str_concat root "/.git")))
    (let d5 (host_dir_mkdir (str_concat root "/sub/.git")))
    (let d6 (host_dir_mkdir (str_concat root "/empty")))
    (let d7 (host_dir_mkdir (str_concat root "/q.fk")))
    (let w1 (tbb-put "b.fk" "(do 1)"))
    (let w2 (tbb-put "a.fk" "(do 1)"))
    (let w3 (tbb-put "sub/z.fk" "(do 1)"))
    (let w4 (tbb-put "sub/deep/y.fk" "(do 1)"))
    (let w5 (tbb-put ".hid/x.fk" "(do 1)"))
    (let w6 (tbb-put "a.fkb" "x"))
    (let w7 (tbb-put "notes.fkx" "x"))
    (let w8 (tbb-put "readme.txt" "x"))
    (let w9 (tbb-put ".git/inside.fk" "(do 1)"))
    (let w10 (tbb-put "sub/.git/inside.fk" "(do 1)"))
    (let w11 (tbb-put "q.fk/in-q.fk" "(do 1)"))
    (let got (tb-paths-in root))
    (let want (tbb-cat (list root "/.hid/x.fk\n" root "/a.fk\n" root "/b.fk\n" root "/q.fk/in-q.fk\n" root "/sub/.git/inside.fk\n" root "/sub/deep/y.fk\n" root "/sub/z.fk\n")))
    (let nowhere (tb-paths-in (str_concat root "-nowhere")))
    (let nothing-here (tb-paths-in (str_concat root "/empty")))
    (let real (tb-paths))
    (let real-lines (tbb-nonempty (tbb-lines real)))
    (let gone (host_dir_rmdir root))
    (add (tbb-bit (str_eq got want) 1)
    (add (tbb-bit (and (eq (tbb-has got "a.fkb") 0) (and (eq (tbb-has got "notes.fkx") 0) (and (eq (tbb-has got "readme.txt") 0) (eq (tbb-has got "/q.fk\n") 0)))) 2)
    (add (tbb-bit (and (eq (tbb-has got (str_concat root "/.git/inside.fk")) 0) (eq (tbb-has got "/sub/.git/inside.fk") 1)) 4)
    (add (tbb-bit (and (str_eq nowhere "") (str_eq nothing-here "")) 8)
         (tbb-bit (and (gt (len real-lines) 0)
                       (and (eq (tbb-all-shaped real-lines) 1)
                            (and (eq (tbb-ordered real-lines) 1)
                            (and (eq (tbb-no-repeat real-lines) 1)
                                 (and (eq (tbb-has real "./observe/tree-balance.fk\n") 1)
                                      (eq (tbb-has real "./observe/tests/tree-balance-band.fk\n") 1)))))) 16))))))
