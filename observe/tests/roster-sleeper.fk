; roster-sleeper.fk — a kernel that works long enough to open its live page and take a roster slot,
; then rests three seconds, so a band can ask the roster whether it is seen while it lives.
; Spawned by form/form-stdlib/tests/roster-register-band.fk.
;
; preludes: form-stdlib/core.fk
(do
    (defn rs-spin (n acc) (if (le n 0) acc (rs-spin (sub n 1) (add acc 1))))
    (let w (rs-spin 5000 0))
    (let s (host_sleep_ms 3000))
    0)
