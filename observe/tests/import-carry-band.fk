; tests/import-carry-band.fk — the band for the import lane's carry and the
; admission pulse, read in a home no other build has written.
; Verdict 255
; REQUIRES: host_spawn_at and kernel_stat 15-18 — the child kernel, the .fkb import lane and the .bml floor are
; fkwu's own.
; preludes: form/form-stdlib/core.fk
;
; The pair shape is the wound shape of 2026-09-01: a unit the lane imports as
; a standalone .fkb image FIRST, a .bml floor surface SECOND
; (import-carry-fixture-unit.fk, import-carry-fixture-floor.bml; the pair's
; bits are in import-carry-fixture-pair.fk). The lane only fires when the
; unit's image is this build's own, so a pair compiled beside images another
; fkwu wrote answers 15: the lane sets the foreign image aside, rebuilds it,
; and the pulse bits do not hold until the next run. Every kernel change
; rebuilds fkwu, so a band that read the pair where it is tracked read red on
; exactly the run that asked it.
;
; So the band makes the pair's home itself: it copies the unit and the floor
; into a fresh directory under temp_dir, writes the pair's root there with a
; `; preludes:` line naming those copies, and asks a child fkwu (this repo's
; ./fkwu, the binary that is reading this band) to walk it twice:
;     1..32  the cold walk's six pair bits: both halves answer, the door is read,
;            the counters agree with it
;     64     the cold walk took the import lane (door 1, one image, one carried unit)
;     128    the warm walk answered all six bits through its cached image (door 2)
; The same two admission bits also require retained imported constant ownership,
; saved function identity, and declaration order for duplicate exported names.
; A child that does not exit 0 answers nothing, and none of its bits hold.
; The home is removed afterwards.

section [form.bml] {
    def icb-unit-list(home,names) = nil?(names) ? "" : icb-at(home,head(names)) + (nil?(tail(names)) ? "" : " " + icb-unit-list(home,tail(names)));
    def icb-source(home,name,dependencies,body) = write_file(icb-at(home,name),
        (nil?(dependencies) ? "" : "; preludes: " + icb-unit-list(home,dependencies) + "\n") + body + "\n");
    def icb-ownership-fixture(home) {
        icb-source(home,"owner-x.fk",[],"(let icb-owner-state 11) (defn icb-owner-x () icb-owner-state) (do (icb-owner-x))");
        icb-source(home,"owner-y.fk",[],"(let icb-owner-state 22) (defn icb-owner-y () icb-owner-state) (do (icb-owner-y))");
        icb-source(home,"owner-a.fk",["owner-x.fk"],"(defn icb-owner-a () (icb-owner-x)) (do (icb-owner-a))");
        icb-source(home,"owner-b.fk",["owner-x.fk"],"(defn icb-owner-b () (icb-owner-x)) (do (icb-owner-b))");
        icb-source(home,"fn-x.fk",[],"(defn icb-fn-f () 1) (let icb-fn-saved icb-fn-f) (do (icb-fn-f))");
        icb-source(home,"fn-a.fk",["fn-x.fk"],"(defn icb-fn-a () (eq icb-fn-saved icb-fn-f)) (do (icb-fn-a))");
        icb-source(home,"fn-b.fk",["fn-x.fk"],"(defn icb-fn-b () (eq icb-fn-saved icb-fn-f)) (do (icb-fn-b))");
        icb-source(home,"duplicate.fk",[],"(defn icb-duplicate (x) x) (defn icb-duplicate (x y) (add x y))");
        icb-source(home,"duplicate-a.fk",["duplicate.fk"],"(defn icb-duplicate-a () (icb-duplicate 1 2))");
        icb-source(home,"duplicate-b.fk",["duplicate.fk"],"(defn icb-duplicate-b () (icb-duplicate 3 4))");
        icb-source(home,"ownership.fk",["owner-a.fk","owner-y.fk","owner-b.fk","fn-a.fk","fn-b.fk","duplicate-a.fk","duplicate-b.fk"],
            "(do (let ownership (and (eq (icb-owner-a) 11) (and (eq (icb-owner-y) 22) (eq (icb-owner-b) 11))))"
            + " (let identity (and (eq (icb-fn-a) 1) (eq (icb-fn-b) 1)))"
            + " (let order (and (eq (icb-duplicate-a) 3) (eq (icb-duplicate-b) 7)))"
            + " (add (add (add (if ownership 1 0) (if identity 2 0)) (if order 4 0))"
            + " (add (if (eq (kernel_stat 15) 1) 8 0) (if (eq (kernel_stat 15) 2) 16 0))))");
    }
}

(do
    (defn icb-k (cond bit) (if cond bit 0))
    (defn icb-at (home name) (str_concat home (str_concat "/" name)))
    (defn icb-tracked (name) (str_concat "observe/tests/" name))
    (defn icb-copy (home name) (write_file_text (icb-at home name) (read_file (icb-tracked name))))
    (defn icb-root-text (home)
        (str_concat "; preludes: "
            (str_concat (icb-at home "import-carry-fixture-unit.fk")
                (str_concat " "
                    (str_concat (icb-at home "import-carry-fixture-floor.bml")
                        (str_concat "\n" (read_file (icb-tracked "import-carry-fixture-pair.fk"))))))))
    ; one child kernel walks the pair; its stdout is its answer, nothing when it did not exit 0
    (defn icb-ask-file (home file tag)
        (do (let out (icb-at home (str_concat tag ".out")))
            (let err (icb-at home (str_concat tag ".err")))
            (let pid (host_spawn_at (list (str_concat (host_cwd) "/fkwu") (icb-at home file)) (list "/dev/null" out err)))
            (let code (if (gt pid 0) (host_wait pid) -1))
            (if (eq code 0) (str_to_int (read_file out))
                (do (print (list "import-carry child failed" file code (read_file err) (read_file out))) (nothing)))))
    (defn icb-ask (home tag) (icb-ask-file home "pair.fk" tag))
    (defn icb-low (n) (if (nothing? n) 0 (band n 63)))
    (defn icb-door (n) (if (nothing? n) 0 (band n 192)))

    (let home (str_concat (temp_dir) (str_concat "/import-carry-" (str_concat (int_to_str (host_pid)) (str_concat "-" (int_to_str (now_unix_ms)))))))
    (let made (fs_mkdir home))
    (let u (icb-copy home "import-carry-fixture-unit.fk"))
    (let f (icb-copy home "import-carry-fixture-floor.bml"))
    (let r (write_file_text (icb-at home "pair.fk") (icb-root-text home)))
    (let cold (icb-ask home "cold"))
    (let warm (icb-ask home "warm"))
    (let ownership-files (icb-ownership-fixture home))
    (let ownership-cold (icb-ask-file home "ownership.fk" "ownership-cold"))
    (let ownership-warm (icb-ask-file home "ownership.fk" "ownership-warm"))
    (let said (print_str (str_concat "import-carry pair: cold=" (str_concat (if (nothing? cold) "nothing" (int_to_str cold)) (str_concat " warm=" (if (nothing? warm) "nothing" (int_to_str warm)))))))
    (let ownership-said (print (list "import-carry ownership/function/order" ownership-cold ownership-warm)))
    (let gone (fs_rmdir home))
    (if (nothing? (fs_list home))
        (add (add (icb-low cold)
                  (icb-k (and (eq (icb-door cold) 64) (eq ownership-cold 15)) 64))
             (icb-k (if (nothing? warm) 0 (and (eq warm 191) (eq ownership-warm 23))) 128))
        (form_error (str_concat "import-carry fixture cleanup incomplete: " home))))
