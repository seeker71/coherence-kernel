; tests/import-carry-band.fk — the band for the import lane's carry and the
; admission pulse. Verdict 63.
; PROOF LEVEL: FOURTH-ARM ONLY — the .fkb import lane and the .bml floor are
; fkwu's own; the three minimal walkers carry neither.
;
; preludes: observe/tests/import-carry-fixture-unit.fk observe/tests/import-carry-fixture-floor.bml
;
; The pair shape is the wound shape of 2026-09-01: a unit the lane imports as
; a standalone .fkb image FIRST, a .bml floor surface SECOND. The lane once
; rebuilt the program as images + root text and left the .bml's lowered defns
; behind without a word — every icff-* call answered [unresolved-call] numb
; (peer-contribution birth surface, healed in fk_src_try_import_fkb_images:
; uncovered units are carried as source beside the imports).
;
; b1/b2 stand on the IMPORTED half: the image's defns answer.
; b4/b8 stand on the CARRIED half: the .bml's defns answer — before the heal
; this band answers 3 with two [unresolved-call] errors and exit 1, after it
; 63 clean (witnessed 2026-09-01/02 on the pre-heal and healed kernels side
; by side).
; b16/b32 stand on the ADMISSION PULSE: the run reads WHICH door its own
; compile took (kernel_stat 15: 0 flat, 1 import lane, 2 cached image,
; 3 native dylib; 16 images imported; 17 units carried; 18 last lane-refusal
; reason). The pulse is always recorded — no toggle — so a cold run answers
; door 1 with images=1 carried=1 refusal=0 and a warm replay answers door 2
; with both counters 0; b32 demands the counters agree with the door either
; way. The icetide teaching made native: the door decision is the program's
; own observable, not a stderr trace behind a conf switch.
;
; The lane only fires when the fixture unit's standalone image is fresh, so a
; cold run compiles it first; a warm run of THIS band replays the band's own
; image — delete observe/tests/import-carry-*.fkb to re-witness the lane live.
;
; witnessed: 2026-09-01 -> 15 on fkwu (the .bml floor is fkwu's own lane; the
;   three minimal walkers carry no .bml lowering, so this is a one-arm band).

(do
    (defn icb-k (cond bit) (if cond bit 0))
    ; door 1 (import lane): exactly one image, one carried unit, no refusal.
    ; door 2 (cached replay): the lane never ran, both counters 0.
    ; any other door is inconsistent for this band's pair shape.
    (defn icb-door-consistent (door)
        (if (eq door 1)
            (if (eq (kernel_stat 16) 1)
                (if (eq (kernel_stat 17) 1) (eq (kernel_stat 18) 0) 0)
                0)
            (if (eq door 2)
                (if (eq (kernel_stat 16) 0) (eq (kernel_stat 17) 0) 0)
                0)))
    (defn import-carry-band ()
        (add (add (add (add (add
            ; the imported image's defns answer
            (icb-k (eq (icfu-answer) 41) 1)
            (icb-k (eq (icfu-twice 21) 42) 2))
            ; the carried floor's defns answer — the wound bits
            (icb-k (str_eq (icff-mark) "carried-floor-alive") 4))
            (icb-k (eq (icff-answer 41) 42) 8))
            ; the run knows its own door: import lane cold, cached warm
            (icb-k (or (eq (kernel_stat 15) 1) (eq (kernel_stat 15) 2)) 16))
            ; and the pulse counters agree with that door
            (icb-k (eq (icb-door-consistent (kernel_stat 15)) 1) 32)))
    (print (import-carry-band)))
