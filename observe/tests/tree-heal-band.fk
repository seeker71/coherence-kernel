; tests/tree-heal-band.fk — the repair loop, proved on a wound and on a trap.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the loop compiles through host-exec.
;
; preludes: form-stdlib/core.fk observe/tree-balance.fk observe/tree-heal.fk
;
; Verdict 127 — seven readings. The first three are the loop working; the last
; four are the loop REFUSING, which is the part that makes it safe to run
; unattended. A healer that cannot decline is not a healer, it is an edit.
;
;   a cell whose form does not close is healed                            1
;   and the closer lands where the form LEAKED, not at the end of the
;     file — the wound is on the second of three defns and the diff
;     touches that line                                                   2
;   and the healed cell then compiles and answers                         4
;
;   THE REFUSALS
;   a cell that is already whole is left byte-identical — the loop does
;     not "improve" what is not broken                                    8
;   a cell whose only failure is an unresolved NAME is left alone: no
;     paren repair can fix a lane seam, and trying would churn the file
;     for nothing                                                        16
;   a repair that balances but does not satisfy the kernel is REVERTED,
;     and the cell comes back byte-identical. This is the whole design:
;     neutral-rule-mdl-admission.fk balanced, parsed and crashed until
;     the closer moved from the (list ...) tail to the (let ...) it
;     belonged to, so balance is never the acceptance test              32
;   and a cell that closes reads as depth 0, which is the precondition
;     the healer checks before it tries anything — without it, an
;     already-whole cell got a `)` written into its `; preludes:` COMMENT
;     and the gate accepted it, because an inert edit compiles. "The
;     kernel stops objecting" is necessary and not sufficient          64

(do
    (defn thb (ok bit) (if ok bit 0))
    (defn thb-dir () (do (fs_mkdir (str_concat (temp_dir) "/tree-heal-band"))
                         (str_concat (temp_dir) "/tree-heal-band")))
    (defn thb-write (name text)
        (do (let p (str_concat (thb-dir) (str_concat "/" name)))
            (write_file p text) p))

    (defn thb-check ()
        (do
            ;; a wound: the SECOND of three defns loses its closer
            (let wound (thb-write "wound.fk"
                "; preludes: form-stdlib/core.fk\n(do\n  (defn w-a (x) (add x 1))\n  (defn w-b (x) (add (w-a x) 2)\n  (defn w-c (x) (add (w-b x) 3))\n  (w-c 1))\n"))
            (let before (read_file wound))
            (let healed (th-heal wound))
            (let after (read_file wound))

            ;; already whole — nothing to do, and nothing done
            (let whole (thb-write "whole.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn k (x) (add x 1)) (k 41))\n"))
            (let whole-before (read_file whole))
            (let whole-healed (th-heal whole))
            (let whole-after (read_file whole))

            ;; a lane seam: balanced, and no closer anywhere can help
            (let seam (thb-write "seam.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn s (x) (walk_recipe x)) 7)\n"))
            (let seam-before (read_file seam))
            (let seam-healed (th-heal seam))
            (let seam-after (read_file seam))

            ;; escaped quotes are string content, not a string ending

            (add (thb (eq healed 1) 1)
            (add (thb (ge (str_find after "(add (w-a x) 2))" 0) 0) 2)
            (add (thb (lt (str_find after "3)))" 0) 0) 4)
            (add (thb (str_eq whole-before whole-after) 8)
            (add (thb (eq whole-healed 0) 0)          ; whole cells report nothing to heal
            (add (thb (eq seam-healed 0) 16)
            (add (thb (str_eq seam-before seam-after) 32)
            (add (thb (eq (tb-depth whole) 0) 64)
                 0))))))))))

    (thb-check))
