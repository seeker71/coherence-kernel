; tests/tree-heal-band.fk — the loop, on a wound and on a cell that asked to stay open.
;
; PROOF LEVEL: FOURTH-ARM + GO — 255 on go and fkwu (witnessed 2026-09-03; host-exec pf-arm-mask 9); the loop compiles through host-exec.
;
; preludes: form-stdlib/core.fk observe/tree-balance.fk observe/tree-heal.fk
;
; Verdict 255 — eight readings. Four are the loop closing something; four are it
; leaving something exactly as it found it, which is most of what it does.
;
;   a cell whose form came apart is closed                                 1
;   and the closer lands where it came apart, not at the end of the file
;     — the opening is on the second of three definitions and the diff
;     touches that line                                                    2
;   and the cell then reads and answers                                    4
;
;   a cell that already closes is left byte-identical — nothing here
;     improves what is whole                                               8
;   a cell whose only trouble is an unresolved name is left alone: no
;     closer anywhere fixes a lane seam                                   16
;   a closer that balances but leaves the kernel unsatisfied goes back,
;     byte for byte. neutral-rule-mdl-admission.fk balanced, parsed and
;     died until the closer moved from the `(list ...)` tail to the
;     `(let ...)` it belonged to — so the reading decides, never the
;     count                                                               32
;   a cell that already closes reads as depth 0, which is what this asks
;     before trying anything. Without it, a whole cell got a `)` written
;     into its `; preludes:` comment and the reading came back fine,
;     because an edit that touches nothing passes everything             64
;
;   and a cell that says `; DO NOT REPAIR: <why>` is left whole, with the
;     reason it gave handed back rather than left for someone to find   128

(do
    (defn thb (ok bit) (if ok bit 0))
    (defn thb-dir () (do (fs_mkdir (str_concat (temp_dir) "/tree-heal-band"))
                         (str_concat (temp_dir) "/tree-heal-band")))
    (defn thb-write (name text)
        (do (let p (str_concat (thb-dir) (str_concat "/" name)))
            (write_file p text) p))

    (defn thb-check ()
        (do
            ;; a wound: the SECOND of three defns loses its closer
            (let wound (thb-write "wound.fk"
                "; preludes: form-stdlib/core.fk\n(do\n  (defn w-a (x) (add x 1))\n  (defn w-b (x) (add (w-a x) 2)\n  (defn w-c (x) (add (w-b x) 3))\n  (w-c 1))\n"))
            (let before (read_file wound))
            (let healed (th-heal wound))
            (let after (read_file wound))

            ;; already whole — nothing to do, and nothing done
            (let whole (thb-write "whole.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn k (x) (add x 1)) (k 41))\n"))
            (let whole-before (read_file whole))
            (let whole-healed (th-heal whole))
            (let whole-after (read_file whole))

            ;; a cell that says do-not-repair-me: broken, repairable, left alone
            (let keep (thb-write "keep.fk"
                "; DO NOT REPAIR: the band is built around this open form\n; preludes: form-stdlib/core.fk\n(do (defn q (x) (add x 1)\n"))
            (let keep-before (read_file keep))
            (let keep-healed (th-heal keep))
            (let keep-after (read_file keep))

            ;; a lane seam: balanced, and no closer anywhere can help
            (let seam (thb-write "seam.fk"
                "; preludes: form-stdlib/core.fk\n(do (defn s (x) (walk_recipe x)) 7)\n"))
            (let seam-before (read_file seam))
            (let seam-healed (th-heal seam))
            (let seam-after (read_file seam))

            ;; escaped quotes are string content, not a string ending

            (add (thb (eq healed 1) 1)
            (add (thb (ge (str_find after "(add (w-a x) 2))" 0) 0) 2)
            (add (thb (lt (str_find after "3)))" 0) 0) 4)
            (add (thb (str_eq whole-before whole-after) 8)
            (add (thb (eq whole-healed 0) 0)          ; whole cells report nothing to heal
            (add (thb (eq seam-healed 0) 16)
            (add (thb (str_eq seam-before seam-after) 32)
            (add (thb (eq (tb-depth whole) 0) 64)
            (add (thb (eq keep-healed 0)
                     (if (str_eq keep-before keep-after)
                         (if (gt (str_len (th-stays-open-why keep)) 10) 128 0) 0))
                 0)))))))))))

    (thb-check))
