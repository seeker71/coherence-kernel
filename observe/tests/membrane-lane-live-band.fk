; preludes: form-stdlib/core.fk observe/membrane-lane.fk observe/bidirectional-framebuffer-channel.fk observe/membrane-lane-live.fk
;
; membrane-lane-live-band — the membrane observer wired to the bidirectional channel
; (observe/membrane-lane-live.fk). Five claims, verdict 31 when every one crosses.
;
; ---------------------------------------------------------------------------
; APORON — THE DECLARED RADIUS.
;   PROVES: each owed crossing becomes a correlated (observation, request-evidence)
;   pair; a native lane asks nothing; a remote+network lane asks exactly once per owed
;   crossing; a landed re-witness removes its ask on re-observe; and the apply is honest
;   -- request-evidence HOLDS the state, no-response falls to the named ALTERNATIVE
;   (never silence), and only rehearse-ground swaps in the rehearsed state.
;   twinblind: correlation, counts, and apply outcomes are canonical -- a self-check is
;   a real falsifier.
;   DOES NOT PROVE: the framebuffer carrier (fb_record) -- this is the protocol logic,
;   the pure half; the recording half is the kernel's. NOT four-way; fkwu-witnessed.
;
; Claim 16 is the honesty gate: a channel where "request evidence" silently changed the
; answer would let a lane fabricate its own closure. So it demands request-evidence hold
; the state, no-response select the alternative, and only rehearse-ground move it.
; ---------------------------------------------------------------------------
;
;   bit  1  ONE OWED CROSSING, ONE CORRELATED ASK: the observation is (dir 0, kind 0,
;           exchange=id, alt=id); the request is (dir 1, kind 1, action 4, exchange=id).
;   bit  2  A SOVEREIGN LANE ASKS NOTHING: a fully-native lane owes nothing, so it emits
;           zero asks.
;   bit  4  A REMOTE+NETWORK LANE ASKS ONCE PER DEBT: two owed crossings -> two pairs,
;           each correlated to its crossing id.
;   bit  8  A RE-WITNESS REMOVES ITS ASK: close the rented-mind crossing -> the ask count
;           drops from 2 to 1; the closed crossing no longer asks.
;   bit 16  THE APPLY IS HONEST: request-evidence (4) holds the current state; no response
;           selects the named alternative; only rehearse-ground (5) swaps the rehearsed
;           state. Evidence is requested, never fabricated.

(do
    (let L (list (list 1 1 1 0) (list 2 2 1 0) (list 3 3 1 1023) (list 4 4 1 0) (list 5 5 1 0)))
    (let R (list (list 1 1 1 0) (list 11 7 0 0) (list 12 6 0 0)))
    (let web (list 12 6 0 0))

    ; --- claim 1: one owed crossing, one correlated ask ---
    (let obs (mll-observe web))
    (let req (mll-request web))
    (let cl1 (if (eq (bfc-direction obs) 0)
                 (if (eq (bfc-kind obs) 0)
                     (if (eq (bfc-exchange obs) 12)
                         (if (eq (bfc-alternative obs) 12)
                             (if (eq (bfc-direction req) 1)
                                 (if (eq (bfc-kind req) 1)
                                     (if (eq (bfc-payload req) 4)
                                         (if (eq (bfc-exchange req) 12) 1 0) 0) 0) 0) 0) 0) 0) 0))

    ; --- claim 2: a sovereign lane asks nothing ---
    (let cl2 (if (eq (mll-request-count L) 0) 2 0))

    ; --- claim 4: a remote+network lane asks once per debt ---
    (let pairs (mll-pairs R))
    (let cl4 (if (eq (mll-request-count R) 2)
                 (if (eq (bfc-exchange (mll-pair-obs (nth pairs 0))) 11)
                     (if (eq (bfc-exchange (mll-pair-obs (nth pairs 1))) 12) 4 0)
                     0)
                 0))

    ; --- claim 8: a re-witness removes its ask ---
    (let R2 (ml-close R 11 1023))
    (let cl8 (if (eq (mll-request-count R) 2)
                 (if (eq (mll-request-count R2) 1) 8 0)
                 0))

    ; --- claim 16: the apply is honest ---
    (let reqE (mll-request web))              ; request-evidence, action 4
    (let reh  (bfc-control (mll-observe web) 5))  ; rehearse-ground, action 5
    (let cl16 (if (eq (mll-apply web reqE 100 200) 100)
                  (if (eq (mll-apply web (nothing) 100 200) 12)
                      (if (eq (mll-apply web reh 100 200) 200) 16 0)
                      0)
                  0))

    (add cl1 (add cl2 (add cl4 (add cl8 cl16)))))
