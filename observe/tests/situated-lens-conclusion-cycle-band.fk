; situated-lens-conclusion-cycle-band.fk — missing evidence requests one
; exact source-attributed row, applies it, and re-observes a value; ambiguity
; abstains without choosing between rows.
; PROOF LEVEL: FOURTH-ARM ONLY — Verdict 131071 on the actual fkwu carrier.
;
; SINGLE-WITNESS (fkwu): actual nothing? and framebuffer recording are carrier
; operations. The policy/actuator crosses four-way in
; form-stdlib/tests/situated-lens-conclusion-control-band.fk.
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk observe/bidirectional-framebuffer-channel.fk observe/situated-lens-conclusion-cycle.fk

(do
    (defn slccb-bit (condition bit) (if condition bit 0))
    (defn slccb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (slccb-sum (tail values)))))

    (framebuffer-clear)
    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let repaired
        (slcc-cycle 10 "WE" "we" "what" 0 5 (list)
            10 lens 1 offered 9901))
    (let repaired-before (slcc-c-before repaired))
    (let repaired-state (slcc-c-state repaired))
    (let repaired-after (slcc-c-after repaired))
    (let repaired-in-1 (slcc-c-inbound-1 repaired))
    (let repaired-in-2 (slcc-c-inbound-2 repaired))
    (let repaired-out-1 (slcc-c-outbound-1 repaired))

    (framebuffer-clear)
    (let ambiguous-field
        (list
            (slc-observation 10 lens 1 6 9001)
            (slc-observation 10 lens 0 7 9002)))
    (let abstained
        (slcc-cycle 20 "WE" "we" "what" 0 5 ambiguous-field
            10 lens 1 offered 9902))
    (let abstained-state (slcc-c-state abstained))
    (let abstained-after (slcc-c-after abstained))

    (framebuffer-clear)
    (let wrong-offer
        (slc-observation 10 (cwi-lens 2 2 3 4) 1 6 9003))
    (let rejected
        (slcc-cycle 30 "WE" "we" "what" 0 5 (list)
            10 lens 1 wrong-offer 9903))
    (let rejected-state (slcc-c-state rejected))
    (let rejected-after (slcc-c-after rejected))

    ; 131071 means all 17 observations held.
    (slccb-sum
        (list
            (slccb-bit
                (and (eq (slc-o-kind repaired-before) (slc-tag-nothing))
                     (eq (slc-o-reason repaired-before) 2)) 1)
            (slccb-bit (eq (bfc-payload repaired-in-1) 4) 2)
            (slccb-bit (eq (slcc-s-action repaired-state) 4) 4)
            (slccb-bit (eq (slcc-s-accepted repaired-state) 1) 8)
            (slccb-bit (eq (slcc-s-selected repaired-state) 9001) 16)
            (slccb-bit
                (and (eq (slc-o-kind repaired-after) (slc-tag-value))
                     (eq (slc-o-conclusion repaired-after) 1)) 32)
            (slccb-bit (eq (slc-o-source repaired-after) 9001) 64)
            (slccb-bit (eq (bfc-payload repaired-in-2) 0) 128)
            (slccb-bit (eq (slcc-c-frames repaired) 4) 256)
            (slccb-bit
                (and (eq (bfc-exchange repaired-out-1)
                         (bfc-exchange repaired-in-1))
                     (eq (nth (bfc-payload repaired-out-1) 3)
                         (cwi-lens-rank lens))) 512)
            (slccb-bit
                (and (eq (slcc-s-action abstained-state) 3)
                     (eq (slcc-s-accepted abstained-state) 1)) 1024)
            (slccb-bit (eq (slcc-s-selected abstained-state) 9902) 2048)
            (slccb-bit
                (and (eq (slc-o-kind abstained-after)
                         (slc-tag-nothing))
                     (eq (slc-o-reason abstained-after) 3)) 4096)
            (slccb-bit (eq (slcc-c-frames abstained) 4) 8192)
            (slccb-bit
                (and (eq (slcc-s-action rejected-state) 4)
                     (eq (slcc-s-accepted rejected-state) 0)) 16384)
            (slccb-bit
                (and (eq (slcc-s-selected rejected-state) 9903)
                     (eq (slc-o-reason rejected-after) 2)) 32768)
            (slccb-bit (eq (slcc-c-frames rejected) 4) 65536))))
