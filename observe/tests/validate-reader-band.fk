; validate-reader-band.fk — validate.sh's reader of band heads works in the sweep worker's shell, and fails loudly.
;
; preludes: form-stdlib/core.fk gate/lens-text.bml
;
; run from the repository root: ./fkwu observe/tests/validate-reader-band.fk   ; -> 15
;
; The sweep worker runs under IFS=$'\x1f'. A question sent as "$*" arrives there as one word joined
; by that byte, the Form door answers nothing, and every pin reads empty with no error. validate.sh
; sends the fields one by one; `validate.sh --selftest-reader <band>` asks the reader exactly as the
; worker does and prints the band's head pin.
;
; Verdict 15:
;   1   under the worker's IFS the reader answers the head pin of observe/tests/band-head-band.fk, 2047
;   2   with no fkwu to read with it is loud: the exit is non-zero and a ✗ line says so
;   4   a path holding a space cannot be asked, and is loud the same way
;   8   the hazard is real: "$*" under that IFS joins its words with the 0x1f byte, so the fix is
;       the reason claim 1 holds

(do
    (defn vrb-k (ok bit) (if ok bit 0))
    (defn vrb-pin ()
        (lx-sh-out "bash form/validate.sh --selftest-reader ../observe/tests/band-head-band.fk"))
    (defn vrb-nofkwu ()
        (lx-sh "FORM_SOURCE_FKWU=/nonexistent/fkwu bash form/validate.sh --selftest-reader ../observe/tests/band-head-band.fk"))
    (defn vrb-space ()
        (lx-sh "bash form/validate.sh --selftest-reader 'a b'"))
    (defn vrb-joined ()
        (lx-sh-out "bash -c 'IFS=$(printf \"\\037\"); f() { printf \"%s\" \"$*\"; }; f pin x'"))
    (defn validate-reader-band ()
        (do
            (let pin (vrb-pin))
            (let none (vrb-nofkwu))
            (let spaced (vrb-space))
            (let joined (vrb-joined))
            (sum (list
                (vrb-k (and (eq (lx-sh-rc pin) 0) (str_eq (lx-sh-text pin) "2047")) 1)
                (vrb-k (and (not (eq (lx-sh-rc none) 0))
                            (ge (str_find (lx-sh-text none) "band-head reader: no fkwu to read with" 0) 0)) 2)
                (vrb-k (and (not (eq (lx-sh-rc spaced) 0))
                            (ge (str_find (lx-sh-text spaced) "holding a space cannot be asked" 0) 0)) 4)
                (vrb-k (and (eq (len (lx-sh-text joined)) 5)
                            (ge (str_find (lx-sh-text joined) (byte_to_str 31) 0) 0)) 8)))))
    (validate-reader-band))
