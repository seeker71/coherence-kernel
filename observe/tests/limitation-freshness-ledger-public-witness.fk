; import "../limitation-freshness-ledger.fk"
; Public result: four offer vectors, then [fresh, OWED, lapsed] audit.
; witnessed: 2026-07-21 ->
; [[nothing,0,1,-5],[0,0,1,-21],[1,0,1,-31],[-45,0,1,-41],[2,1,1]]

(do
  (defn lflw-node (n) (intern_node (make_nodeid 8 6 4 n) (list)))
  (defn lflw-row (id offer date valid)
    (lfl-entry id 1 offer 1 (list (lflw-node 20)) (list (lflw-node 21))
      (list (lflw-node 22)) date valid))
  (let epoch 20260721)
  (let rn (lflw-row (lflw-node 30) (nothing) 20260721 1))
  (let rz (lflw-row (lflw-node 31) 0 20260720 1))
  (let ro (lflw-row (lflw-node 32) 1 20260721 0))
  (let rd (lflw-row (lflw-node 33) (lflw-node 34) 20260721 1))
  (let sn (lfl-status rn epoch))
  (let sz (lfl-status rz epoch))
  (let so (lfl-status ro epoch))
  (let sd (lfl-status rd epoch))
  (let fresh-count (add (if (eq sn 2) 1 0) (if (eq sd 2) 1 0)))
  (let owed-count (if (eq sz 1) 1 0))
  (let lapsed-count (if (eq so 0) 1 0))
  (list (lfl-public-vector rn) (lfl-public-vector rz)
        (lfl-public-vector ro) (lfl-public-vector rd)
        (list fresh-count owed-count lapsed-count)))
