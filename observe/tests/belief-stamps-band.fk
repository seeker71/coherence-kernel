; belief-stamps-band.fk — the belief re-witness lens parses every stamp
; shape the body carries, reads the epoch, and folds the larder honestly.
;
; Verdict 65535 (sixteen bits):
;   1      "; witnessed: 2026-07-05 -> 31"            date 20260705, proven, token 31
;   2      "-> 255"                                    the plain number shape
;   4      "-> band 127 four-way (...)"                the number after the word band
;   8      "-> self-check 63; 764 sources"             prose: the first word is the token
;   16     "// witnessed: 2026-08-30 -> 65535"        the BML marker
;   32     "-> " with nothing after it                 dated, unproven, empty token
;   64     "-> pending"                                dated, unproven: pending is honest, not proof
;   128    "; witnessed: pending" / a field string     no date, or no marker at column 0: no stamp
;   256    "2026-08-03 (later) -> 47 rows"             the arrow may come after a parenthesis
;   512    "-> 1023;" and "-> 111111111,"              trailing punctuation shed
;   1024   epoch "2026-09-03\n" -> 20260903; noise -> 0
;   2048   a file with two stamps keeps the newest
;   4096   a pre-epoch stamp is OWED (bf-status 1)
;   8192   an at-epoch stamp is LAW for now (2)
;   16384  no stamp and pending are both HELD (0)
;   32768  the field fold and the counts: 3 stamped, 1 law, 1 owed, 2 held -> 3001001; bf-audit 10102
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself is go + fkwu, pf-arm-mask 9, probed 2026-09-03); the lens is BML on fkwu's own lane and
; reads git through host-exec.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml observe/belief-freshness.fk observe/belief-stamps.bml
;
; The organ's top-level statement runs the real walk when preluded, so a
; run of this band prints the body's report first; the verdict is the
; last line and the exit code.
;
; run: ./fkwu observe/tests/belief-stamps-band.fk    ; -> 65535
;
; witnessed: 2026-09-03 -> 65535

(do
    (defn bsb-k (cond bit) (if cond bit 0))
    (defn bsb-stamp-is? (s date proven token)
        (and (eq (bfs-stamp-date s) date)
             (and (eq (bfs-stamp-proven s) proven)
                  (str_eq (bfs-stamp-token s) token))))
    (defn belief-stamps-band ()
        (do
            (let epoch 20260903)
            (let pre  (bfs-row-of-text "a.fk" "; a cell\n; witnessed: 2026-08-19 -> 31\n\n(do 1)\n"))
            (let post (bfs-row-of-text "b.fk" "; witnessed: 2026-09-03 -> 255\n(do 1)\n"))
            (let none (bfs-row-of-text "c.fk" "; a cell with no stamp\n(do 1)\n"))
            (let pend (bfs-row-of-text "d.fk" "; witnessed: 2026-09-03 -> pending\n"))
            (let rows (list pre post none pend))
            (let two  (bfs-stamp-of-file-text "; witnessed: 2026-07-15 -> 65535\n; witnessed: 2026-08-03 -> re-witnessed\n"))
            (let c0  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-07-05 -> 31") 20260705 1 "31") 1))
            (let c1  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-08-14 -> 255") 20260814 1 "255") 2))
            (let c2  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-07-05 -> band 127 four-way (fkwu/Go/Rust/TS)") 20260705 1 "127") 4))
            (let c3  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-07-16 -> self-check 63; 764 sources") 20260716 1 "self-check") 8))
            (let c4  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "// witnessed: 2026-08-30 -> 65535") 20260830 1 "65535") 16))
            (let c5  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-07-22 ->") 20260722 0 "") 32))
            (let c6  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-08-26 -> pending") 20260826 0 "pending") 64))
            (let c7  (bsb-k (and (eq (bfs-stamp-date (bfs-stamp-of-line "; witnessed: pending")) 0)
                                 (and (eq (bfs-stamp-date (bfs-stamp-of-line "        field HistoricalWitness = \"; witnessed: 2026-08-30 -> denominator 93628\";")) 0)
                                      (eq (bfs-stamp-line? "; SAME ANSWER, argued and then witnessed: BPE picks") 0))) 128))
            (let c8  (bsb-k (bsb-stamp-is? (bfs-stamp-of-line "; witnessed: 2026-08-03 (later) -> 47 rows, 65535 on fkwu") 20260803 1 "47") 256))
            (let c9  (bsb-k (and (str_eq (bfs-stamp-token (bfs-stamp-of-line "; witnessed: 2026-08-14 -> 1023;")) "1023")
                                 (str_eq (bfs-stamp-token (bfs-stamp-of-line ";; witnessed: 2026-07-18 -> 111111111, eight units")) "111111111")) 512))
            (let c10 (bsb-k (and (eq (bfs-epoch-of "2026-09-03\n") 20260903)
                                 (eq (bfs-epoch-of "fatal: not a git repository\n") 0)) 1024))
            (let c11 (bsb-k (bsb-stamp-is? two 20260803 1 "re-witnessed") 2048))
            (let c12 (bsb-k (eq (bfs-row-status pre epoch) 1) 4096))
            (let c13 (bsb-k (eq (bfs-row-status post epoch) 2) 8192))
            (let c14 (bsb-k (and (eq (bfs-row-status none epoch) 0) (eq (bfs-row-status pend epoch) 0)) 16384))
            (let c15 (bsb-k (and (eq (bfs-field (bfs-stamped rows) (bfs-count-status rows epoch 1) (bfs-count-status rows epoch 2)) 3001001)
                                 (and (eq (bfs-count-status rows epoch 0) 2)
                                      (and (eq (bf-audit (tb-map rows bfs-row-belief) epoch) 10102)
                                           (eq (bfs-row-path (head (bfs-owed-rows rows epoch))) "a.fk")))) 32768))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
            (add c8 (add c9 (add c10 (add c11 (add c12 (add c13 (add c14 c15)))))))))))))))))
    (belief-stamps-band))
