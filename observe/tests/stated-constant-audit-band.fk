; tests/stated-constant-audit-band.fk — the band for observe/stated-constant-audit.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk observe/stated-constant-audit.fk
;
; b2, b3 and b5 are why this band exists: a walker that answered "stated constant"
; to everything would pass b1 and fall on all three. A defn with a parameter, a
; nullary that calls something, and a nullary doing arithmetic are each NOT bare
; constants, and each has to read 0.
;
; b6 is the declared radius, checked rather than promised: a literal-list body
; contains the alpha run `list`, so this walker does NOT count it. Pinning that
; keeps the limit visible instead of drifting into a silent claim.
;
; b8 PERTURBS THE TOP LEVEL: a text with a bare constant and a text without have
; to read apart, or sca-audit-text is a constant itself.
;
; witnessed: 2026-08-15 -> 255 four-way (fkwu / Go / Rust / TS).

(do
    (defn scab-k (cond bit) (if cond bit 0))
    (defn stated-constant-audit-band ()
        (add (add (add (add (add (add (add
            ; a bare-number nullary is one stated constant
            (scab-k (eq (sca-audit-text (sca-fx-one)) 1) 1)
            ; a defn that takes a parameter is not
            (scab-k (eq (sca-audit-text (sca-fx-none)) 0) 2))
            ; a nullary that calls something is not
            (scab-k (eq (sca-audit-text (sca-fx-call)) 0) 4))
            ; two of them count as two — the walk does not stop at the first
            (scab-k (eq (sca-audit-text (sca-fx-two)) 2) 8))
            ; a nullary doing arithmetic is not stated; it computes
            (scab-k (eq (sca-audit-text (sca-fx-nest)) 0) 16))
            ; THE DECLARED RADIUS: a literal-list body is stated but NOT counted
            (scab-k (eq (sca-audit-text "(defn a () (list 1 2 3))") 0) 32))
            ; empty text finds nothing
            (scab-k (eq (sca-audit-text "") 0) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: the walk discriminates
            (scab-k (if (eq (sca-audit-text (sca-fx-one)) (sca-audit-text (sca-fx-call))) 0 1) 128)))
    (stated-constant-audit-band))
