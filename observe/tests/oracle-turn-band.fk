; tests/oracle-turn-band.fk — the band for observe/oracle-turn.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk observe/oracle-turn.fk
;
; This band does NOT cross the membrane. A band that reached out to the oracle
; would answer differently on every run and could not stand — it would be a
; measurement of the weather. What stands here is the SHAPE: the composing, the
; weighing, the recording, the address. The crossing is witnessed by running the
; cell, and the run is its own receipt.
;
; b3 and b4 are why the weighing is a reading: an empty answer weighs 0 bytes and
; 0 words, so a non-zero weight elsewhere means text actually came back.
;
; b8 PERTURBS THE TOP LEVEL: two different answers weigh apart. If ot-words
; answered the same for any input, every count above would be furniture.
;
; witnessed: 2026-08-15 -> 255 on fkwu (host-exec / write_file / scan_run are
;   native here; the three minimal walkers carry none of them).

(do
    (defn otb-k (cond bit) (if cond bit 0))
    (defn otb-other () "one two three")
    (defn oracle-turn-band ()
        (add (add (add (add (add (add (add
            ; the question is composed in Form, quoted for the host
            (otb-k (gt (str_len (ot-cmd "hello")) (str_len "hello")) 1)
            ; and it carries the verb that reaches the oracle
            (otb-k (ge (str_find (ot-cmd "hello") "claude -p " 0) 0) 2))
            ; an answer weighs what it weighs
            (otb-k (eq (ot-words (ot-fx-answer)) 6) 4))
            ; and nothing weighs nothing — bytes and words both
            (otb-k (if (eq (ot-bytes (ot-fx-empty)) 0) (eq (ot-words (ot-fx-empty)) 0) 0) 8))
            ; the crossing records both sides and says it crossed
            (otb-k (eq (ot-crossed? (ot-crossing "q" (ot-fx-answer))) 1) 16))
            (otb-k (eq (len (ot-crossing "q" (ot-fx-answer))) 4) 32))
            ; the turn has an address, four coordinates
            (otb-k (eq (len (ot-id)) 4) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: two answers weigh apart
            (otb-k (if (eq (ot-words (ot-fx-answer)) (ot-words (otb-other))) 0 1) 128)))
    (oracle-turn-band))
