; tests/unused-door-audit-band.fk — the band for observe/unused-door-audit.fk. Verdict 511.
;
; preludes: form-stdlib/core.fk observe/unused-door-audit.fk
;
; The band walks fixture TEXT, not the tree, so the reading is the same on every
; run. b3 and b4 are the pair that makes it a reading rather than a claim: a
; prelude whose names ARE called reads used, and one whose names are not reads
; unused. Either alone would pass while the other drifted.
;
; b7 pins the declared radius: a name appearing anywhere in the caller counts as a
; use, including in a comment. That makes this instrument UNDER-report, which is
; the right direction for one that suggests deletions.
;
; b9 PERTURBS THE TOP LEVEL: used and unused have to read apart, or uda-uses? is a
; constant and every bit above is furniture.
;
; witnessed: 2026-08-15 -> 511 on fkwu.

(do
    (defn udb-k (cond bit) (if cond bit 0))
    (defn unused-door-audit-band ()
        (add (add (add (add (add (add (add (add
            ; the declared chain is found and carries both names
            (udb-k (ge (str_find (uda-chain-text (uda-fx-caller)) "a.fk" 0) 0) 1)
            (udb-k (ge (str_find (uda-chain-text (uda-fx-caller)) "b.fk" 0) 0) 2))
            ; a.fk defines alpha, and the caller calls alpha — used
            (udb-k (eq (uda-uses? (uda-fx-caller) (uda-fx-a)) 1) 4))
            ; b.fk defines beta, and the caller never mentions beta — unused
            (udb-k (eq (uda-uses? (uda-fx-caller) (uda-fx-b)) 0) 8))
            ; a cell with no chain line yields no chain
            (udb-k (eq (str_len (uda-chain-text (uda-fx-nochain))) 0) 16))
            ; a definer that defines nothing is never "used"
            (udb-k (eq (uda-uses? (uda-fx-caller) "(do 0)") 0) 32))
            ; THE DECLARED RADIUS: a mention in a comment counts as a use, so this
            ; under-reports. Pinned rather than promised.
            (udb-k (eq (uda-uses? "; beta is not called here\n(do 1)" (uda-fx-b)) 1) 64))
            ; the chain of a cell that names nothing is empty, not the whole file
            (udb-k (lt (str_len (uda-chain-text (uda-fx-nochain))) 4) 128))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: used and unused read apart
            (udb-k (if (eq (uda-uses? (uda-fx-caller) (uda-fx-a))
                           (uda-uses? (uda-fx-caller) (uda-fx-b))) 0 1) 256)))
    (unused-door-audit-band))
