; child-framebuffer-channel-live.fk -- actual same-process stdout/stdin round.
; The runner reads the outbound child frame before sending action 5.

import "../child-framebuffer-channel.fk"

(do
  (let current (intern_trivial_int 910))
  (let rehearsed (intern_trivial_int 911))
  (let alternative (intern_trivial_int 912))
  (let round (cfc-live-round 41 current rehearsed alternative
    (list 0 1 2 3 4 5)))
  (sum (list
    (if (eq (bfc-direction (nth round 0)) 0) 1 0)
    (if (eq (bfc-exchange (nth round 0)) 41) 2 0)
    (if (eq (bfc-direction (nth round 1)) 1) 4 0)
    (if (eq (bfc-exchange (nth round 1)) 41) 8 0)
    (if (eq (bfc-payload (nth round 1)) 5) 16 0)
    (if (node_eq (nth round 2) rehearsed) 32 0)
    (if (eq (nth round 3) 1) 64 0)
    (if (eq (nth round 4) 3) 128 0)
    (if (eq (nth round 5) 3) 256 0)
    (if (and (eq (nth round 6) 1) (eq (nth round 7) 1)) 512 0)
    (if (eq (nth round 8) 1) 1024 0))))
