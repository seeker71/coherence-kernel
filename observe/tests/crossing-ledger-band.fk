; tests/crossing-ledger-band.fk — the band for observe/crossing-ledger.fk. Verdict 511.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk observe/crossing-ledger.fk
;
; b2 and b3 are why this is a reading and not a list: a change nobody read again
; scores 0 closed, and a re-read where nothing moved scores 0 productive. Without
; those two, xr-closed? could answer 1 to everything and the seven rows below
; would be decoration.
;
; b6 is the finding the ledger exists to hold: TWO of the seven crossings had
; their conclusion reversed by the re-reading rather than confirmed by it. That
; count is pinned so it cannot drift quietly into a rounder story.
;
; b9 PERTURBS THE TOP LEVEL: a closed row and an unread one have to read apart.
;
; witnessed: 2026-08-15 -> 511 on fkwu (intern_node is absent from the minimal walkers).

(do
    (defn xrb-k (cond bit) (if cond bit 0))
    (defn crossing-ledger-band ()
        (add (add (add (add (add (add (add (add
            ; every crossing recorded tonight came back
            (xrb-k (eq (xr-all-closed? (xr-tonight)) 1) 1)
            ; a change nobody read again does not close
            (xrb-k (eq (xr-closed? (xr-unread)) 0) 2))
            ; a re-read where nothing moved is closed but not productive
            (xrb-k (if (eq (xr-closed? (xr-nomove)) 1) (eq (xr-productive? (xr-nomove)) 0) 0) 4))
            ; seven crossings, all closed
            (xrb-k (eq (xr-count (xr-tonight)) 7) 8))
            (xrb-k (eq (xr-closed-count (xr-tonight)) 7) 16))
            ; TWO were corrective — re-read, and the number refused to move
            (xrb-k (eq (xr-corrective-count (xr-tonight)) 2) 32))
            ; five moved the reading
            (xrb-k (eq (xr-productive-count (xr-tonight)) 5) 64))
            ; the ledger has an address, four coordinates
            (xrb-k (eq (len (xr-id)) 4) 128))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: closed and unread part
            (xrb-k (eq (xr-reads-apart?) 1) 256)))
    (crossing-ledger-band))
