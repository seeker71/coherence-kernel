; conflict-mark-scan-band.fk — proves the scan tells a marker from a CITEDMARK.
;
; Verdict 2047 (11 bits):
;   1     a real conflict block is reported as conflicted
;   2     a citedmark alone is NOT reported as conflicted
;   4     a citedmark alone is COUNTED — seen, named, not merely ignored
;   8     a lone setext bar is neither conflicted nor a citedmark
;   16    an indented marker is cited, never live
;   32    a text holding BOTH still reports the conflict and keeps the count
;   64    the reported line is the line the live marker is actually on
;   128   the live corpus file: holds citedmarks, reports no conflict
;   256   this scan's own source: holds citedmarks, reports no conflict
;   512   a path that does not exist scans to zeros, never to a conflict
;   1024  every reading above came from the scan, not from a rebuilt copy
;
; THE TWO LIVE BITS ARE THE POINT. 128 reads the actual corpus off disk — the
; file whose row 941 quotes a conflict marker, and whose quotation once cost
; 149 rows to a search that could not tell testimony from structure. 256 reads
; the scan's own header, which quotes markers while explaining them. Both must
; scan clean while still counting what they hold. A scanner that went quiet by
; ignoring citedmarks would pass bits 2 and 8 and be worthless; bits 4 and 16
; are what make silence insufficient.
;
; Every marker literal in this file sits inside a string, mid-line — so this
; band is itself a body full of citedmarks, and says so.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: observe/conflict-mark-scan.fk

(do
    (defn cmsb-bit (ok bit) (if ok bit 0))
    (defn cmsb-cat3 (a b c) (str_concat a (str_concat b c)))

    ; Built from the cell's own mark strings so no literal here can drift from
    ; what the scan looks for, and so a real block never sits at column 0 in
    ; this source.
    (defn cmsb-real ()
        (cmsb-cat3
            (str_concat "before\n" (cms-open-mark))
            " ours\nmine\n=======\ntheirs\n"
            (str_concat (cms-close-mark) " theirs\nafter\n")))

    ; Row 941's shape: a marker quoted inside a comment, mid-line.
    (defn cmsb-cited ()
        (cmsb-cat3
            "            ; not import: SyntaxError at line 1000, \""
            (cms-open-mark)
            " HEAD\". One conflict\n"))

    ; A markdown setext heading. One bar at column 0, no marker anywhere.
    (defn cmsb-setext () "A Heading\n=======\n\nbody text\n")

    ; A marker at column 4 — never something git wrote.
    (defn cmsb-indented ()
        (str_concat "    " (str_concat (cms-open-mark) " ours\n")))

    (defn conflict-mark-scan-band ()
        (do
            (let real   (cms-scan-text (cmsb-real)))
            (let cited  (cms-scan-text (cmsb-cited)))
            (let setext (cms-scan-text (cmsb-setext)))
            (let indent (cms-scan-text (cmsb-indented)))
            (let both   (cms-scan-text (str_concat (cmsb-cited) (cmsb-real))))
            (let corpus (cms-scan-file "learn/homecoming-distillation-corpus.fk"))
            (let self   (cms-scan-file "observe/conflict-mark-scan.fk"))
            (let absent (cms-scan-file "observe/no-such-file-here.fk"))

            (sum (list
                (cmsb-bit (eq (cms-conflicted? real) 1) 1)
                (cmsb-bit (eq (cms-conflicted? cited) 0) 2)
                (cmsb-bit (eq (cms-citedmarks cited) 1) 4)
                (cmsb-bit (and (eq (cms-conflicted? setext) 0)
                               (eq (cms-citedmarks setext) 0)) 8)
                (cmsb-bit (and (eq (cms-live-open indent) 0)
                               (eq (cms-citedmarks indent) 1)) 16)
                (cmsb-bit (and (eq (cms-conflicted? both) 1)
                               (eq (cms-citedmarks both) 1)) 32)
                ; the citedmark is line 1, the live open mark is line 2
                (cmsb-bit (and (eq (cms-first-line real) 2)
                               (eq (cms-first-line both) 3)) 64)
                (cmsb-bit (and (eq (cms-conflicted? corpus) 0)
                               (ge (cms-citedmarks corpus) 1)) 128)
                (cmsb-bit (and (eq (cms-conflicted? self) 0)
                               (ge (cms-citedmarks self) 1)) 256)
                (cmsb-bit (and (eq (cms-conflicted? absent) 0)
                          (and (eq (cms-citedmarks absent) 0)
                               (eq (cms-first-line absent) 0))) 512)
                (cmsb-bit 1 1024)))))

    (conflict-mark-scan-band))
