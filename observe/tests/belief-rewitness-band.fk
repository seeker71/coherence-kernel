; belief-rewitness-band.fk — proves observe/belief-rewitness.bml's door: band
; discovery (named-mention-wins, beside-cell default), a real renew cycle on
; an actual owed cell, a real mismatch reported as an honest lapse (never
; silently), and the no-band / no-stamp cases both reported, never crashed.
;
; Expected: 127
; Verdict 127 (seven bits):
;   1   beside-cell default: a path with no *-band.fk mention in its own
;       text resolves to tests/<stem>-band.fk sitting beside it
;   2   named mention wins: a cell whose header names two bands takes the
;       FIRST one that exists on disk, in reading order, over the default
;   4   a real renew: observe/belief-freshness.fk's real fresh band run
;       matches its declared "127" stamp exactly, status "renew", a
;       candidate line is produced, and the source file is untouched byte
;       for byte (the door prints, it never writes)
;   8   a real lapse: a fixture cell's declared stamp does not match what
;       its real band answers today — status "lapse", the real verdict is
;       reported, never dropped
;   16  no band discoverable: a fixture cell with a stamp but no
;       tests/<stem>-band.fk beside it and no mention in its own text
;       reports status "no-band", not a crash
;   32  no stamp at all: a fixture cell with no `; witnessed:` line reports
;       status "no-stamp"
;   64  the day (brw-day-of, brw-today): the civil date of an instant's local time agrees with the era algorithm run by hand over the
;       instant plus the host's reported offset, for two days after 1970, a leap day, a day's last second, a fixed 2026 instant, now and 2100
;
; REQUIRES: fkwu — belief-rewitness.bml is BML; the .bml floor
; compiles it, and this band shells real fixture files onto disk to give
; pf-fresh something to actually run.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/table.bml observe/belief-freshness.fk observe/belief-stamps.bml observe/preflight.fk observe/belief-rewitness.bml
;
; run: ./fkwu observe/tests/belief-rewitness-band.fk    ; -> 127

(do
    (defn brwb-k (cond bit) (if cond bit 0))
    (defn brwb-dir () "/private/tmp/belief-rewitness-band-fixtures")
    (defn brwb-mkdir () (host-exec (str_concat "mkdir -p " (str_concat (brwb-dir) (str_concat "/tests " (str_concat (brwb-dir) "/tests")))) ""))

    ; ---- fixture 1: beside-cell default, real verdict matches, a real renew ----
    (defn brwb-default-cell () (str_concat (brwb-dir) "/default-cell.fk"))
    (defn brwb-default-band () (str_concat (brwb-dir) "/tests/default-cell-band.fk"))
    (defn brwb-write-default ()
        (do
            (write_file (brwb-default-cell) "; witnessed: 2026-07-01 -> 15\n(do 15)\n")
            (write_file (brwb-default-band) "(do 15)\n")
            0))

    ; ---- fixture 2: named mention wins over the beside-cell default ----
    (defn brwb-named-cell () (str_concat (brwb-dir) "/named-cell.fk"))
    (defn brwb-named-real-band () (str_concat (brwb-dir) "/real-band.fk"))
    (defn brwb-named-decoy-band () (str_concat (brwb-dir) "/tests/named-cell-band.fk"))
    (defn brwb-write-named ()
        (do
            ; the decoy sits at the default path and would win if mentions were ignored
            (write_file (brwb-named-decoy-band) "(do 999)\n")
            ; the real band is named first in the cell's own text; brw-band-for must prefer it
            (write_file (brwb-named-cell) (str_concat "; see " (str_concat (brwb-named-real-band) "\n; witnessed: 2026-07-01 -> 7\n(do 7)\n")))
            (write_file (brwb-named-real-band) "(do 7)\n")
            0))

    ; ---- fixture 3: a real lapse (declared stamp no longer matches the live band) ----
    (defn brwb-lapse-cell () (str_concat (brwb-dir) "/lapse-cell.fk"))
    (defn brwb-lapse-band () (str_concat (brwb-dir) "/tests/lapse-cell-band.fk"))
    (defn brwb-write-lapse ()
        (do
            (write_file (brwb-lapse-cell) "; witnessed: 2026-07-01 -> 99\n(do 99)\n")
            (write_file (brwb-lapse-band) "(do 5)\n")
            0))

    ; ---- fixture 4: a stamp with no discoverable band ----
    (defn brwb-noband-cell () (str_concat (brwb-dir) "/noband-cell.fk"))
    (defn brwb-write-noband () (write_file (brwb-noband-cell) "; witnessed: 2026-07-01 -> 1\n(do 1)\n"))

    ; ---- fixture 5: no stamp at all ----
    (defn brwb-nostamp-cell () (str_concat (brwb-dir) "/nostamp-cell.fk"))
    (defn brwb-write-nostamp () (write_file (brwb-nostamp-cell) "; a cell with no witnessed line\n(do 1)\n"))

    (defn brwb-source-before (path) (read_file path))

    ; ---- the day: brw-day-of an instant is the civil date of its local time, by hand (the era algorithm over the instant plus the offset
    ; east of UTC the host reports for it), where `date +%Y-%m-%d` was run before ----
    (defn brwb-pad2 (n) (if (lt n 10) (str_concat "0" (int_to_str n)) (int_to_str n)))
    (defn brwb-day-by-hand (ms)
        (do
            (let off (nth (host_localtime ms) 7))
            (let days (div (add (div ms 1000) off) 86400))
            (let z (add days 719468))
            (let era (div z 146097))
            (let doe (sub z (mul era 146097)))
            (let yoe (div (add (sub doe (div doe 1460)) (sub (div doe 36524) (div doe 146096))) 365))
            (let doy (sub doe (sub (add (mul 365 yoe) (div yoe 4)) (div yoe 100))))
            (let mp (div (add (mul 5 doy) 2) 153))
            (let dd (add (sub doy (div (add (mul 153 mp) 2) 5)) 1))
            (let mm (if (lt mp 10) (add mp 3) (sub mp 9)))
            (let yy (add (add yoe (mul era 400)) (if (le mm 2) 1 0)))
            (str_concat (int_to_str yy) (str_concat "-" (str_concat (brwb-pad2 mm) (str_concat "-" (brwb-pad2 dd)))))))
    (defn brwb-day-ok? (ms) (str_eq (brw-day-of ms) (brwb-day-by-hand ms)))
    (defn brwb-days-ok? ()
        (and (brwb-day-ok? 172800000)
        (and (brwb-day-ok? 951782400000)
        (and (brwb-day-ok? 951868799000)
        (and (brwb-day-ok? 1791087423285)
        (and (brwb-day-ok? (now_unix_ms))
        (and (brwb-day-ok? 4102444800000)
        (and (eq (str_len (brw-today)) 10)
             (str_eq (brw-today) (brw-day-of (now_unix_ms)))))))))))

    (defn belief-rewitness-band ()
        (do
            (brwb-mkdir)
            (brwb-write-default)
            (brwb-write-named)
            (brwb-write-lapse)
            (brwb-write-noband)
            (brwb-write-nostamp)

            (let default-band (brw-band-for (brwb-default-cell)))
            (let c1 (brwb-k (str_eq default-band (brwb-default-band)) 1))

            (let named-band (brw-band-for (brwb-named-cell)))
            (let c2 (brwb-k (str_eq named-band (brwb-named-real-band)) 2))

            (let real-before (brwb-source-before "observe/belief-freshness.fk"))
            (let renew (brw-witness "observe/belief-freshness.fk"))
            (let real-after (brwb-source-before "observe/belief-freshness.fk"))
            (let c3 (brwb-k
                (and (str_eq (brw-r-status renew) "renew")
                (and (str_eq (brw-r-real renew) "127")
                (and (gt (str_len (brw-r-candidate renew)) 0)
                     (str_eq real-before real-after))))
                4))

            (let lapse (brw-witness (brwb-lapse-cell)))
            (let c4 (brwb-k
                (and (str_eq (brw-r-status lapse) "lapse")
                (and (str_eq (brw-r-declared lapse) "99")
                     (str_eq (brw-r-real lapse) "5")))
                8))

            (let noband (brw-witness (brwb-noband-cell)))
            (let c5 (brwb-k (str_eq (brw-r-status noband) "no-band") 16))

            (let nostamp (brw-witness (brwb-nostamp-cell)))
            (let c6 (brwb-k (str_eq (brw-r-status nostamp) "no-stamp") 32))

            (let c7 (brwb-k (brwb-days-ok?) 64))

            (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
    (belief-rewitness-band))
