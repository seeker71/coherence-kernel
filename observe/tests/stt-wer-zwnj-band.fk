; stt-wer-zwnj-band.fk — a word is the same word with or without a zero-width joiner or non-joiner: Persian
; writes زبان‌های and زبانهای for one word, and the WER door must not count that as an error. 4 bits -> 15.
; A gap in learn/native-turn-queue.jsonl: the native code lane is asked to turn it green.
; preludes: observe/stt-wer.fk
(do
    (defn swz-bit (ok n) (if ok n 0))
    (let zwnj (eq (sw-wer-bounded (sw-tokens "به زبان‌های بسیاری") (sw-tokens "به زبانهای بسیاری")) 0))
    (let zwj (eq (sw-wer-bounded (sw-tokens "می‍خواهم") (sw-tokens "میخواهم")) 0))
    (let plain (eq (sw-wer-bounded (sw-tokens "a b c") (sw-tokens "a b d")) 33))
    (let fold (eq (sw-wer-bounded (sw-tokens "The Body") (sw-tokens "the body")) 0))
    (add (swz-bit zwnj 1) (add (swz-bit zwj 2) (add (swz-bit plain 4) (swz-bit fold 8)))))
