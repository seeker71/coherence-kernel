; situated-lens-authority-cycle-band.fk — the actual framebuffer cycle admits
; a row only through fresh independent quorum, while insufficiency and
; equivocation remain explicit and ambiguity still abstains.
; Four-way: Verdict 262143 on fkwu, go, rust and ts (witnessed 2026-09-03).
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk form-stdlib/situated-evidence-authority.fk form-stdlib/situated-lens-authorized-control.fk observe/bidirectional-framebuffer-channel.fk observe/situated-lens-conclusion-cycle.fk observe/situated-lens-authority-cycle.fk

(do
    (defn slacfb-bit (condition bit) (if condition bit 0))
    (defn slacfb-sum (values)
        (if (eq (len values) 0) 0
            (add (head values) (slacfb-sum (tail values)))))

    (let lens (cwi-lens 1 2 3 4))
    (let offered (slc-observation 10 lens 1 6 9001))
    (let policy (sea-policy (list 7001 7002) 2 3))
    (let a (sea-endorsement 7001 9001 10 lens 1 6 11))
    (let b (sea-endorsement 7002 9001 10 lens 1 6 12))

    (framebuffer-clear)
    (let admitted
        (slac-cycle 40 "WE" "we" "what" 0 5 (list)
            10 lens 1 offered 9901 (list a b) policy 13))

    (framebuffer-clear)
    (let insufficient
        (slac-cycle 50 "WE" "we" "what" 0 5 (list)
            10 lens 1 offered 9902 (list a) policy 13))

    (framebuffer-clear)
    (let equivocation
        (slac-cycle 60 "WE" "we" "what" 0 5 (list)
            10 lens 1 offered 9903
            (list a b (sea-endorsement
                7001 9001 10 lens 0 6 13))
            policy 13))

    (framebuffer-clear)
    (let ambiguous-field
        (list offered (slc-observation 10 lens 0 7 9002)))
    (let abstained
        (slac-cycle 70 "WE" "we" "what" 0 5 ambiguous-field
            10 lens 1 offered 9904 (list) (list) 999))

    ; 262143 means all 18 observations held.
    (slacfb-sum
        (list
            (slacfb-bit
                (and (eq (slc-o-kind
                            (slac-c-before admitted)) (slc-tag-nothing))
                     (eq (bfc-payload
                            (slac-c-inbound-1 admitted)) 4)) 1)
            (slacfb-bit
                (eq (sea-o-admitted
                    (slac-c-authority admitted)) 1) 2)
            (slacfb-bit
                (eq (sea-o-fresh-distinct
                    (slac-c-authority admitted)) 2) 4)
            (slacfb-bit
                (eq (slcc-s-accepted
                    (slac-c-state admitted)) 1) 8)
            (slacfb-bit
                (and (eq (slc-o-kind
                            (slac-c-after admitted)) (slc-tag-value))
                     (eq (slc-o-conclusion
                            (slac-c-after admitted)) 1)) 16)
            (slacfb-bit (eq (slac-c-frames admitted) 4) 32)
            (slacfb-bit
                (eq (sea-o-reason
                    (slac-c-authority insufficient)) 2) 64)
            (slacfb-bit
                (eq (slcc-s-accepted
                    (slac-c-state insufficient)) 0) 128)
            (slacfb-bit
                (eq (slc-o-reason
                    (slac-c-after insufficient)) 2) 256)
            (slacfb-bit (eq (slac-c-frames insufficient) 4) 512)
            (slacfb-bit
                (eq (sea-o-reason
                    (slac-c-authority equivocation)) 3) 1024)
            (slacfb-bit
                (eq (sea-o-equivocator
                    (slac-c-authority equivocation)) 7001) 2048)
            (slacfb-bit
                (eq (slcc-s-accepted
                    (slac-c-state equivocation)) 0) 4096)
            (slacfb-bit
                (eq (slc-o-reason
                    (slac-c-after equivocation)) 2) 8192)
            (slacfb-bit
                (eq (sea-o-reason
                    (slac-c-authority abstained)) 4) 16384)
            (slacfb-bit
                (and (eq (slcc-s-action
                            (slac-c-state abstained)) 3)
                     (eq (slcc-s-accepted
                            (slac-c-state abstained)) 1)) 32768)
            (slacfb-bit
                (and (eq (slcc-s-selected
                            (slac-c-state abstained)) 9904)
                     (eq (slc-o-reason
                            (slac-c-after abstained)) 3)) 65536)
            (slacfb-bit (eq (slac-c-frames abstained) 4) 131072))))
