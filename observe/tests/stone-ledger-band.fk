; tests/stone-ledger-band.fk — the band for the breathing ledger. Verdict 63.
; Four-way: 63 on fkwu, go, rust and ts (witnessed 2026-09-03) — this band proves the pure standing fold the ledger's organs (patrol, release door) share.
;
; preludes: form-stdlib/stone-ledger.fk
;
; Synthetic ledger truth: a stone stands after its addition (b1), lies
; down after a release (b2), stands AGAIN when re-added after release —
; the re-heat path (b4). Names match as exact fields: an addition of
; "xy" never makes "x" stand (b8). Mentions count all lines carrying the
; name (b16). A release with no addition leaves nothing standing (b32).
;
; witnessed: 2026-09-02 -> 63 on fkwu.

(do
    (defn slb-k (cond bit) (if cond bit 0))
    (defn slb-nl () (byte_to_str 10))
    (defn slb-line (kind name detail)
        (str_concat "t=1 stone=" (str_concat kind
            (str_concat " name=" (str_concat name
                (str_concat " " (str_concat detail (slb-nl))))))))
    (defn slb-added () (slb-line "long-walker" "cell-a.fk" "cpu-s=90"))
    (defn slb-released ()
        (str_concat (slb-added)
            (slb-line "released" "cell-a.fk" "cpu-s=0.2 witnessed")))
    (defn slb-reheated ()
        (str_concat (slb-released) (slb-line "long-walker" "cell-a.fk" "cpu-s=80")))
    (defn slb-neighbor () (slb-line "long-walker" "cell-ab.fk" "cpu-s=70"))
    (defn slb-only-release () (slb-line "released" "ghost.fk" "never added"))
    (defn stone-ledger-band ()
        (add (add (add (add (add
            (slb-k (eq (sl-standing? (slb-added) "cell-a.fk") 1) 1)
            (slb-k (eq (sl-standing? (slb-released) "cell-a.fk") 0) 2))
            (slb-k (eq (sl-standing? (slb-reheated) "cell-a.fk") 1) 4))
            (slb-k (eq (sl-standing? (slb-neighbor) "cell-a.fk") 0) 8))
            (slb-k (eq (sl-mentions (slb-reheated) "cell-a.fk") 3) 16))
            (slb-k (eq (sl-standing? (slb-only-release) "ghost.fk") 0) 32)))
    (print (stone-ledger-band)))
