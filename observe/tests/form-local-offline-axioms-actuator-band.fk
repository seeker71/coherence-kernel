; form-local-offline-axioms-actuator-band.fk -- exact-pair actuator adversaries.
; witnessed: PENDING

import "../form-local-offline-axioms-actuator.fk"

(do
    (defn flosdab-crossing (marker)
        (list "axioms-one-family-crossing-v1" "axioms" marker 0 0 0 0
            "model" "run" 1 0 0 1 0 0 0 0 1 0))
    (defn flosdab-valid? (crossing)
        (if (and (eq (flosda-crossing-shape? crossing) 1)
                 (str_eq (nth crossing 2) "ready")) 1 0))
    (defn flosdab-record-run (path model-id value)
        (do
            (let event (fb_record (intern_trivial_int 3102109)
                "form-local-offline-axioms-actuator-band.fk" 1))
            value))
    (defn flosdab-ready-run (path model-id)
        (flosdab-record-run path model-id
            (if (and (str_eq path "/fixture/qwen.gguf")
                     (str_eq model-id "fixture-qwen"))
                (flosdab-crossing "ready") 7)))
    (defn flosdab-not-yet-run (path model-id)
        (flosdab-record-run path model-id (flosdab-crossing "not-yet")))
    (defn flosdab-nothing-run (path model-id)
        (flosdab-record-run path model-id (nothing)))
    (defn flosdab-malformed-run (path model-id)
        (flosdab-record-run path model-id 7))

    (defn flosdab-rows (stamp)
        (list
            (flohm-organ (flosda-target) 0 5 5 stamp "fixture:axioms"
                (fmcl-attempt-category) "baseline surprise")
            (flohm-organ "heldout-local-form-transfer" 0 5 5 stamp
                "fixture:heldout" (fmcl-attempt-category) "project")
            (flohm-organ "kernel" 1 4 4 stamp "fixture:kernel"
                (fmcl-continuation-category) "ready")
            (flohm-organ "unknown" (nothing) 1 1 stamp "fixture:unknown"
                (fmcl-signal-category) "observe")))
    (defn flosdab-state ()
        (flosda-state (flosdab-rows 100) "/fixture/qwen.gguf"
            "fixture-qwen" "unattempted" (nothing) 0))
    (defn flosdab-observe (state stamp)
        (flosda-observe-with flosdab-valid? state stamp))
    (defn flosdab-control (outbound) (bfc-control outbound 0))
    (defn flosdab-apply (state selected before)
        (flosda-apply-with flosdab-ready-run flosdab-valid?
            state selected before))
    (defn flosdab-fold-loop (bits acc)
        (if (nil? bits) acc
            (flosdab-fold-loop (tail bits) (add (mul acc 2) (head bits)))))

    (let state (flosdab-state))
    (let before (flosdab-observe state 100))
    (let selected (flohm-best-gap (nth before 10)))
    (let wrong-identity (flohm-organ "heldout-local-form-transfer" 0 5 5 100
        "fixture:heldout" (fmcl-attempt-category) "project"))
    (let wrong-action (flohm-organ (flosda-target) 0 5 5 100
        "fixture:axioms" (fmcl-persistence-category) "wrong-action"))

    (framebuffer-clear)
    (let wrong-id-result (flosda-apply-with flosdab-ready-run flosdab-valid?
        state wrong-identity before))
    (let wrong-action-result (flosda-apply-with flosdab-ready-run flosdab-valid?
        state wrong-action before))
    (let refused-events (len (framebuffer-events)))

    (framebuffer-clear)
    (let moved (flosd-tick flosdab-observe flosdab-control flosdab-apply
        state 200 109 7200000 0))
    (let moved-events (len (framebuffer-events)))
    (let moved-state (nth moved 20))

    (framebuffer-clear)
    (let nothing-result (flosda-apply-with flosdab-nothing-run flosdab-valid?
        state selected before))
    (let nothing-state (flosd-apply-state nothing-result))
    (let nothing-map (flosdab-observe nothing-state 300))
    (let not-yet-result (flosda-apply-with flosdab-not-yet-run flosdab-valid?
        state selected before))
    (let not-yet-state (flosd-apply-state not-yet-result))
    (let not-yet-map (flosdab-observe not-yet-state 400))
    (let malformed-result (flosda-apply-with flosdab-malformed-run flosdab-valid?
        state selected before))
    (let malformed-state (flosd-apply-state malformed-result))
    (let malformed-map (flosdab-observe malformed-state 500))
    ; A forged outcome label cannot promote an invalid retained crossing.
    (let replay-state (flosda-state (flosda-rows not-yet-state)
        (flosda-path not-yet-state) (flosda-model-id not-yet-state)
        "ready" (flosda-crossing not-yet-state) 1))
    (let replay-map (flosdab-observe replay-state 600))

    (let bits (list
        (if (and (str_eq (flohm-priority-identity before) (flosda-target))
            (node_eq (flohm-priority-action before)
                (fmcl-attempt-category))) 1 0)
        (if (and (str_eq (flosd-apply-status wrong-id-result) "refused")
            (str_eq (flosd-apply-reason wrong-id-result)
                "exact-identity-action-pair-required")) 1 0)
        (if (and (str_eq (flosd-apply-status wrong-action-result) "refused")
            (eq refused-events 0)) 1 0)
        (if (and (str_eq (nth moved 1) "applied")
            (str_eq (nth moved 2) "physical-attempt-crossing-ready")) 1 0)
        (if (and (eq (nth moved 10) 1) (eq (nth moved 11) 1)) 1 0)
        (if (and (eq (nth moved 12) 1) (eq moved-events 3)) 1 0)
        (if (and (eq (nth moved 13) 2) (eq (nth moved 14) 1)) 1 0)
        (if (and (eq (nth moved 15) 250) (eq (nth moved 16) 500)) 1 0)
        (if (and (str_eq (flosda-outcome moved-state) "ready")
            (eq (flosda-attempts moved-state) 1)) 1 0)
        (if (and (str_eq (flosd-apply-status nothing-result) "applied")
            (and (str_eq (flosda-outcome nothing-state) "nothing")
                 (nothing? (flosda-crossing nothing-state)))) 1 0)
        (if (and (eq (flohm-state (head (nth nothing-map 10))) 0)
            (nothing? (flohm-state (nth (nth nothing-map 10) 3)))) 1 0)
        (if (and (str_eq (flosda-outcome not-yet-state) "not-yet")
            (eq (flohm-state (head (nth not-yet-map 10))) 0)) 1 0)
        (if (and (str_eq (flosda-outcome malformed-state) "refused")
            (eq (flohm-state (head (nth malformed-map 10))) 0)) 1 0)
        (if (eq (flohm-state (head (nth replay-map 10))) 0) 1 0)
        (if (and (str_eq (flohm-identity (nth (nth nothing-map 10) 1))
                "heldout-local-form-transfer")
            (and (eq (flohm-freshness (nth (nth nothing-map 10) 1)) 100)
                 (eq (flohm-freshness (head (nth nothing-map 10))) 300))) 1 0)
        (if (and (eq (flosda-selected? selected) 1)
            (and (eq (flosda-selected? wrong-identity) 0)
                 (eq (flosda-selected? wrong-action) 0))) 1 0)))
    (flosdab-fold-loop bits 0))
