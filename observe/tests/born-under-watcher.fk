; born-under-watcher.fk — a kernel that notes the parent it was born under and ends once that parent is no
; longer its parent, the way the glass organs do. What it saw goes to .hearth/born-under-<pid>.said: "born P"
; at start, then " released" when it ends by its own reading, or " outlived" after ten seconds.
; Spawned by form/form-stdlib/tests/born-under-band.fk, directly and through observe/tests/born-under-leaver.fk.
;
; preludes: form-stdlib/core.fk form/form-stdlib/born-under.bml
(do
    (defn buw-path () (str_concat ".hearth/born-under-" (str_concat (int_to_str (host_pid)) ".said")))
    (defn buw-say (born word) (write_file_text (buw-path) (str_concat "born " (str_concat (int_to_str born) word))))
    (defn buw-loop (born n)
        (if (le n 0) (buw-say born " outlived")
            (if (eq (bun-held? born) 0) (buw-say born " released")
                (do (let r (host_sleep_ms 200)) (buw-loop born (sub n 1))))))
    (let born (bun-parent))
    (let said (buw-say born ""))
    (let ended (buw-loop born 50))
    0)
