; born-under-leaver.fk — starts a born-under watcher, rests long enough for the watcher to read its parent,
; says the watcher's pid and ends without waiting for it, as a carrier ended by a signal does. Spawned by
; form/form-stdlib/tests/born-under-band.fk.
;
; preludes: form-stdlib/core.fk
(do
    (let w (host_spawn_quiet (list "./fkwu" "observe/tests/born-under-watcher.fk")))
    (let rest (host_sleep_ms 2500))
    (print_str (int_to_str w))
    0)
