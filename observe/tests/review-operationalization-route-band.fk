; preludes: form-stdlib/core.fk observe/review-panel.fk observe/review-operationalization.fk observe/review-ask.fk
;
; 127: native evidence settles what it measures; the panel receives the open.
; No outside door is called by this band.

(do
    (let pass-row (ro-row 108 1 1 1 0 0 1 1))
    (let revise-row (ro-row 33 1 0 1 0 0 1 1))
    (let open-row (ro-row 60 1 1 1 0 0 0 1))
    (let native-result (ra-review-with-evidence "" "" (list pass-row) 1))

    (add (if (eq (ra-review-verdict (list pass-row) 1) (ro-pass)) 1 0)
    (add (if (eq (ra-review-needs-panel? (list pass-row) 1) 0) 2 0)
    (add (if (eq (ra-review-verdict (list revise-row) 1) (ro-revise)) 4 0)
    (add (if (eq (ra-review-needs-panel? (list revise-row) 1) 0) 8 0)
    (add (if (eq (ra-review-verdict (list open-row) 1) (ro-open)) 16 0)
    (add (if (eq (ra-review-needs-panel? (list open-row) 1) 1) 32 0)
    (add (if (eq (len (nth native-result 1)) 0) 64 0)
         0))))))))
