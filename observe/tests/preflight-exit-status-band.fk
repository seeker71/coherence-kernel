; Verdict 15: a successful command, silent nonzero exit, misleading compiler
; summary, and signaled child. The child belongs exclusively to this test.
; preludes: observe/preflight.fk
(do
    (let success (pf-run-checked "printf clean"))
    (let failed (pf-run-checked "exit 7"))
    (let misleading (pf-run-checked "printf 'fkwu: 0 error(s), 0 warning(s)'; exit 9"))
    (let signaled (pf-run-checked "sh -c 'kill -TERM $$'"))
    (add
        (if (and (str_eq success "clean") (eq (pf-clean? success) 1)) 1 0)
        (add
            (if (and (eq (pf-clean? failed) 0) (ge (str_find failed "exit=7" 0) 0)) 2 0)
            (add
                (if (and (eq (pf-clean? misleading) 0) (ge (str_find misleading "exit=9" 0) 0)) 4 0)
                (if (and (eq (pf-clean? signaled) 0) (ge (str_find signaled "exit=143" 0) 0)) 8 0)))))
