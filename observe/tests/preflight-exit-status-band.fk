; Verdict 262143: three readings of the pre-run pass's record, one number. Bits 1..8 the exit status, 16..1024 the marker, 2048..131072 the tally.
;
; EXIT STATUS (bits 1..8). A successful program, a silent nonzero exit, a misleading compiler summary, and a unit the budget ended
; (a door that is not there reads exit 127 with the words a missing carrier has always had).
; Each unit is a Form cell this band writes under temp_dir and calls in this process (cell_run, through pf-cell: no child, no
; exit to wait for; the answer the door gives stands where an exit stood). It belongs exclusively to this test. A signal death
; no longer exists for a cell: what ends a unit that never ends is its budget, and that reads 124.
;
; MARKER (bits 16..1024). A marker is a complete comment line, not quoted test data. Pure readings.
;
; TALLY (bits 2048..131072). The compile's own tally is read from the record the door answered, so imported-image warning rows, a
; refusal and a unit's own printed words cannot hide or move it. Pure readings; no compile or file mutation.
; REQUIRES: cell_run — pf-run-checked calls the cell in this process
; preludes: observe/preflight.fk
(do
    (defn pfx-dir () (str_concat (temp_dir) (str_concat "/preflight-exit-band-" (value_str (host_pid)))))
    (defn pfx-cell (name text)
        (do (let p (str_concat (pfx-dir) (str_concat "/" name)))
            (write_file p text)
            p))
    (let made (host_dir_mkdir (pfx-dir)))
    (let hd "; preludes: form-stdlib/core.fk\n")
    (let fine (pfx-cell "fine.fk" (str_concat hd "(do (print_str \"clean\") 0)\n")))
    (let broke (pfx-cell "broke.fk" (str_concat hd "(do (form_error \"preflight exit band: a silent nonzero exit\") 0)\n")))
    (let lie (pfx-cell "lie.fk" (str_concat hd "(do (print_str \"fkwu: 0 error(s), 0 warning(s)\") (form_error \"preflight exit band: the summary says clean\") 0)\n")))
    (let spin (pfx-cell "spin.fk" (str_concat hd "(do (defn spin (n) (spin (add n 1))) (spin 0))\n")))
    (let success (pf-run-checked fine))
    (let failed (pf-run-checked broke))
    (let misleading (pf-run-checked lie))
    (let budgeted (pf-cell spin (nothing) 300))
    (let absent (pf-cell-of (nothing)))
    (let removed (host_dir_rmdir (pfx-dir)))
    (let exit-bits
        (add
            (if (and (str_eq (record_get (pf-r-rec success) "out") "clean\n") (and (eq (pf-command-failed? success) 0) (eq (pf-clean? success) 1))) 1 0)
            (add
                (if (and (eq (pf-clean? failed) 0) (eq (pf-r-status failed) 1)) 2 0)
                (add
                    (if (and (eq (pf-clean? misleading) 0) (eq (pf-r-status misleading) 1)) 4 0)
                    (if (and (eq (pf-clean? budgeted) 0)
                             (and (eq (pf-r-status budgeted) 124)
                                  (and (eq (pf-clean? absent) 0)
                                       (and (eq (pf-r-status absent) 127)
                                            (eq (pf-unavailable? absent) 1))))) 8 0)))))
    (defn pfmb-bit (ok bit) (if ok bit 0))
    (let marker "; preflight-exec: forbidden")
    (let marker-bits (sum (list
        (pfmb-bit (eq (pf-effect-marker? marker 0) 1) 1)
        (pfmb-bit (eq (pf-effect-marker? (str_concat "  " (str_concat marker "\r\n0")) 0) 1) 2)
        (pfmb-bit (eq (pf-effect-marker? (str_concat "(print \"" (str_concat marker "\")")) 0) 0) 4)
        (pfmb-bit (eq (pf-effect-marker? "" 0) 0) 8)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-run.fk") 1) 16)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-machine-live.fk") 1) 32)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-organs-live.fk") 1) 64))))
    (defn pft-bit (ok bit) (if ok bit 0))
    (defn pft-row (observed) (record_new 0 "organ" "fkwu-compiler" "aspect" "diagnostic" "observed" observed))
    (defn pft-rec (errors diag stopped out) (record_new 0 "errors" errors "diag" diag "stopped" stopped "out" out "value" 0))
    (let warning (pft-row "compile-warning"))
    (let tfailed (pf-cell-of (pft-rec 6 (list (pft-row "compile-error") warning) (nothing) "")))
    (let tzero (pf-cell-of (pft-rec 0 (list warning) (nothing) "")))
    (let fatal (pf-cell-of (pft-rec 0 (list) (record_new 0 "kind" "refused" "message" "cached image was REFUSED at compile") "")))
    (let loud (pf-cell-of (pft-rec 6 (list warning) (nothing) "fkwu: 4 error(s), 2 warning(s)\nfkwu: 6 error(s), 1 warning(s)\n")))
    (let tally-bits
        (add (pft-bit (eq (pf-errors tfailed) 6) 1)
        (add (pft-bit (eq (pf-warnings tfailed) 1) 2)
        (add (pft-bit (eq (pf-errors tzero) 0) 4)
        (add (pft-bit (eq (pf-warnings tzero) 1) 8)
        (add (pft-bit (eq (pf-errors fatal) 1) 16)
        (add (pft-bit (eq (pf-clean? tfailed) 0) 32)
             (pft-bit (eq (pf-errors loud) 6) 64))))))))
    (add exit-bits (add (mul 16 marker-bits) (mul 2048 tally-bits))))
