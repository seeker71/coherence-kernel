; Verdict 15: a successful program, a silent nonzero exit, a misleading compiler summary, and a unit the budget ended
; (a door that is not there reads exit 127 with the words a missing carrier has always had).
; Each unit is a Form cell this band writes under temp_dir and calls in this process (cell_run, through pf-cell: no child, no
; exit to wait for; the answer the door gives stands where an exit stood). It belongs exclusively to this test. A signal death
; no longer exists for a cell: what ends a unit that never ends is its budget, and that reads 124.
; REQUIRES: cell_run — pf-run-checked calls the cell in this process
; preludes: observe/preflight.fk
(do
    (defn pfx-dir () (str_concat (temp_dir) (str_concat "/preflight-exit-band-" (value_str (host_pid)))))
    (defn pfx-cell (name text)
        (do (let p (str_concat (pfx-dir) (str_concat "/" name)))
            (write_file p text)
            p))
    (let made (host_dir_mkdir (pfx-dir)))
    (let hd "; preludes: form-stdlib/core.fk\n")
    (let fine (pfx-cell "fine.fk" (str_concat hd "(do (print_str \"clean\") 0)\n")))
    (let broke (pfx-cell "broke.fk" (str_concat hd "(do (form_error \"preflight exit band: a silent nonzero exit\") 0)\n")))
    (let lie (pfx-cell "lie.fk" (str_concat hd "(do (print_str \"fkwu: 0 error(s), 0 warning(s)\") (form_error \"preflight exit band: the summary says clean\") 0)\n")))
    (let spin (pfx-cell "spin.fk" (str_concat hd "(do (defn spin (n) (spin (add n 1))) (spin 0))\n")))
    (let success (pf-run-checked fine))
    (let failed (pf-run-checked broke))
    (let misleading (pf-run-checked lie))
    (let budgeted (pf-cell spin (nothing) 300))
    (let absent (pf-cell-of (nothing) 0))
    (let removed (host_dir_rmdir (pfx-dir)))
    (add
        (if (and (eq (str_find success "clean\n" 0) 0) (and (lt (str_find success "preflight-command-failed" 0) 0) (eq (pf-clean? success) 1))) 1 0)
        (add
            (if (and (eq (pf-clean? failed) 0) (ge (str_find failed "exit=1" 0) 0)) 2 0)
            (add
                (if (and (eq (pf-clean? misleading) 0) (ge (str_find misleading "exit=1" 0) 0)) 4 0)
                (if (and (eq (pf-clean? budgeted) 0)
                         (and (ge (str_find budgeted "exit=124" 0) 0)
                              (and (eq (pf-clean? absent) 0)
                                   (and (ge (str_find absent "exit=127" 0) 0)
                                        (eq (pf-unavailable? absent) 1))))) 8 0)))))
