; Imported-image warning text cannot hide the final compiler tally.
; Expected: 127. Pure diagnostics; no compile or file mutation.
; preludes: observe/preflight.fk
(do
  (defn pft-bit (ok bit) (if ok bit 0))
  (let warning "fkwu: warning: unit is not importable (1620 unresolved error(s) compiled alone); falling back\n")
  (let failed (str_concat warning "fkwu:2767:67: error: stray ')'\nfkwu: 6 error(s), 1 warning(s)\n"))
  (let zero (str_concat warning "fkwu: 0 error(s), 1 warning(s)\n"))
  (let fatal "fkwu: error: cached image was REFUSED at compile\n")
  (add (pft-bit (eq (pf-errors failed) 6) 1)
  (add (pft-bit (eq (pf-warnings failed) 1) 2)
  (add (pft-bit (eq (pf-errors zero) 0) 4)
  (add (pft-bit (eq (pf-errors warning) 0) 8)
  (add (pft-bit (eq (pf-errors fatal) 1) 16)
  (add (pft-bit (eq (pf-clean? failed) 0) 32)
       (pft-bit (eq (pf-errors "fkwu: 4 error(s), 2 warning(s)\nfkwu: 6 error(s), 1 warning(s)\n") 6) 64))))))))
