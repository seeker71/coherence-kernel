; preludes: form-stdlib/core.fk observe/live-silence-inquiry.fk

(do
    (let active (lsi-inquire (lsi-observation 1 0 0 0 0 "fk_walk")))
    (let progress (lsi-inquire (lsi-observation 1 1 0 0 0 "frame+1")))
    (let failure (lsi-inquire (lsi-observation 0 0 1 0 0 "stderr-hidden")))
    (let silence (lsi-inquire (lsi-observation 0 0 0 1 0 "silence-offered")))
    (let stop (lsi-inquire (lsi-observation 0 0 0 0 1 "stream-stop")))
    (let unknown (lsi-inquire (lsi-observation 0 0 0 0 0 "no-sample")))
    (add (if (str_eq (lsi-state active) "active-without-output") 1 0)
    (add (if (str_eq (lsi-state progress) "progress-visible") 2 0)
    (add (if (str_eq (lsi-state failure) "dropped-failure") 4 0)
    (add (if (str_eq (lsi-state silence) "deliberate-silence") 8 0)
    (add (if (str_eq (lsi-state stop) "stop-or-offline") 16 0)
         (if (str_eq (lsi-state unknown) "unknown-silence") 32 0)))))))
