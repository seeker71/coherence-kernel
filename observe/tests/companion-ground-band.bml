; companion-ground-band.bml — the companion's packet ground, read before any voice is asked.
;
; A said whose words sit in a teaching's name carries that path. A said whose words sit nowhere
; carries the miss. No model is admitted and no conversation log is written.
;
; Verdict 7 when all claims land:
;   1  "difficult conversation" carries teachings/difficult-conversations.md
;   2  a word no cell carries is the miss
;   4  two matching moves sharing a source use that source only once
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk observe/companion-ground.bml
section [form.bml] {
  def cgb-hit() = str_find(cp-ground("a difficult conversation"), "teachings/difficult-conversations.md", 0) >= 0;
  def cgb-miss() = cp-ground("zzqqxplugh") == cp-miss();
  def cgb-shared-source() {
   let ground = cp-ground("trust acknowledgment");
   let path = "cognition/dialogue-covenant.fk";
   let first = str_find(ground, path, 0);
   first >= 0 && str_find(ground, path, first + len(path)) < 0;
  }
  def cgb() = (cgb-hit() ? 1 : 0) + (cgb-miss() ? 2 : 0) + (cgb-shared-source() ? 4 : 0);
  cgb();
}
