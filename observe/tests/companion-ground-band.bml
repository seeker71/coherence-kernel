; companion-ground-band.bml — the companion's packet ground, read before any voice is asked, and the ear's word it hears.
;
; A said whose words sit in a teaching's name carries that path. A said whose words sit nowhere
; carries the miss. No model is admitted and no conversation log is written. The ear's door
; (observe/companion-run.bml, from-ear) reads the spool's last closed line as the person's word and
; its tongue, and a word is present only when it holds a character past blanks: the door's own fixture
; reading answers its tongue, its words and its presence, with no server asked and nothing written.
;
; Verdict 127 when all claims land:
;   1  "difficult conversation" carries teachings/difficult-conversations.md
;   2  a word no cell carries is the miss
;   4  two matching moves sharing a source use that source only once
;   8  from-ear-check reads the last closed line of its spool fixture (the open line before it passes over)
;      as tongue en, the words "I am scared of the change", present 1
;   16 cp-lands-line reads a reply against the counsel's predicate (dcc-read-lands?) when the person's words carry the
;      counsel: its seed reply reads lands=1 and the ordinary seed lands=0; words with no counsel and an empty answer
;      read nothing
;   32 the real entry keeps default turns in-process, pauses until resume,
;      retains only an explicit turn, and consumes no input after leave
;   64 saved history needs recall; forgetting clears session context; mouth
;      output needs its own option; unknown options admit no work
; preflight-exec: forbidden
// preludes: form-stdlib/core.fk observe/companion-ground.bml
section [form.bml] {
  def cgb-hit() = str_find(cp-ground("a difficult conversation"), "teachings/difficult-conversations.md", 0) >= 0;
  def cgb-miss() = cp-ground("zzqqxplugh") == cp-miss();
  def cgb-shared-source() {
   let ground = cp-ground("trust acknowledgment");
   let path = "cognition/dialogue-covenant.fk";
   let first = str_find(ground, path, 0);
   first >= 0 && str_find(ground, path, first + len(path)) < 0;
  }
  // the door's fixture reading, asked through its own stdin: "[en, I am scared of the change, 1]"
  def cgb-ear() {
   let run = cell_run("observe/companion-run.bml",0,0,["from-ear-check"]);
   let said = trim(record_get(run,"out"));
   cgb-clean?(run) && str_find(said, "[en, I am scared of the change, 1]", 0) == 0 && len(said) < 80;
  }
  def cgb-clean?(run) = record_get(run,"errors") == 0 && nothing?(record_get(run,"stopped"));
  def cgb-has?(text,part) = str_find(text,part,0) >= 0;
  // The production entry runs unchanged except for its private fixture directory.
  // No fixture asks a model, resident or ear, or touches the living conversation.
  def cgb-boundaries() {
   let dir = temp_dir() ++ "/cgb-boundaries-" ++ host_pid().str();
   fs_mkdir(dir);
   defer host_dir_rmdir(dir);
   let source = str-join-with(split-on(read_file("observe/companion-run.bml"),".hearth/companion"),dir ++ "/conversation");
   let path = dir ++ "/entry.bml";
   write_file_text(path,source);
   let run = cell_run(path,0,0,["session-only-marker","en","0","/pause","paused-marker","en","0 retain","/resume","retained-marker","en","0 retain","/leave","after-leave-marker","en","0 retain"]);
   let log = read_file(dir ++ "/conversation/conversation.jsonl") ?? "";
   let out = record_get(run,"out");
   let lifecycle = cgb-clean?(run) && cgb-has?(out,"state=paused release=released") && cgb-has?(out,"state=active") && cgb-has?(out,"state=left release=released") && cgb-has?(out,"retention=appended") && cgb-has?(log,"retained-marker") && !any?(t => cgb-has?(log,t),["session-only-marker","paused-marker","after-leave-marker"]);
   // Inspect the same memory and output owners without generation. Only the
   // fixture entry expression changes; all production definitions are retained.
   let inspect = "let owner=fcnv-residence(); record_set(owner,\"conversation\",[]); record_set(owner,\"companion-state\",\"active\"); let absent=cp-memory(owner,[]); let recalled=cp-memory(owner,[\"recall\"]); cp-kept(owner,\"fresh-marker\",\"en\",[],[\"answered\",\"synthetic-answer\"]); let session=cp-memory(owner,[]); let noMouth=file_size(cp-mouth()) < 0; cp-control(owner,\"/forget\"); let forgotten=cp-memory(owner,[]); let offered=cp-offer(\"synthetic-spoken-answer\"); let mouths=len(fs_list(cp-mouth())); cp-kept(owner,\"unfinished-turn\",\"en\",[\"mouth\"],[\"incomplete\",\"\",0,0,\"\",0,1,\"length\",\"unfinished-marker\"]); print([\"scope-observed\",len(absent)==0,str_find(recalled,\"retained-marker\",0)>=0,str_find(session,\"fresh-marker\",0)>=0,noMouth,len(forgotten)==0,offered==\"written\",nothing?(cp-options(\"unexpected\")),len(fs_list(cp-mouth()))==mouths,str_find(cp-memory(owner,[]),\"[unfinished reason=length]\",0)>=0]);";
   let inspectPath = dir ++ "/inspect.bml";
   write_file_text(inspectPath,str-join-with(split-on(source," cp-run();")," " ++ inspect));
   let checked = cell_run(inspectPath,0,0,nothing());
   let rejected = cell_run(path,0,0,["bad-options-marker","en","unexpected","/leave"]);
   let scope = cgb-clean?(checked) && cgb-clean?(rejected) && cgb-has?(record_get(rejected,"out"),"options=refused") && cgb-has?(record_get(checked,"out"),"[scope-observed, 1, 1, 1, 1, 1, 1, 1, 1, 1]") && cgb-has?(record_get(checked,"out"),"unfinished reason=length\nunfinished-marker") && !cgb-has?(read_file(dir ++ "/conversation/conversation.jsonl") ?? "","fresh-marker");
   (lifecycle ? 32 : 0) + (scope ? 64 : 0);
  }
  // a reply to words the counsel carries is read against the counsel's predicate beside the answer: the counsel's two
  // seed replies to its woodworking seed read lands=1 (Sema's) and lands=0 (the ordinary one); words the ground does not
  // tie to the counsel, and an empty answer, read nothing
  def cgb-said() = "A difficult conversation I dread. " ++ dcc-given-seed();
  def cgb-lands() = cp-lands-line(cgb-said(), dcc-sema-seed()) == "[companion] lands=1\n" && cp-lands-line(cgb-said(), dcc-ordinary-seed()) == "[companion] lands=0\n" && cp-lands-line("zzqqxplugh", dcc-sema-seed()) == "" && cp-lands-line(cgb-said(), "") == "";
  def cgb() = (cgb-hit() ? 1 : 0) + (cgb-miss() ? 2 : 0) + (cgb-shared-source() ? 4 : 0) + (cgb-ear() ? 8 : 0) + (cgb-lands() ? 16 : 0) + cgb-boundaries();
  cgb();
}
