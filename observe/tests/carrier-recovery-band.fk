; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk observe/carrier-recovery.fk

(do
    (let observed (cr-live-form-run))
    (let missing (carrier-recover (list "/path/not-observed/form-run")))
    (add (if (str_eq (cr-status observed) "pivot") 1 0)
    (add (if (str_eq (cr-selected observed) "./form-run") 2 0)
    (add (if (str_eq (cr-alternate observed) "execute-selected") 4 0)
    (add (if (str_eq (cr-status missing) "no-result") 8 0)
         (if (str_eq (cr-alternate missing) "discover-carrier") 16 0))))))
