; flow-meter-band.fk — the flow meter's reading, proven against a fixture.
;
; observe/tests/fixtures/flow-meter-transcript.jsonl carries two messages:
; msg_A spans two rows with the same usage record (10/20/30/40), one a text
; row and one a Bash row running ./fkwu; msg_B is one Read row (1/2/3/4).
; A user row echoes a tool name and a stop reason and must count nothing.
; Expected: provider_calls 3 (rows with a stop reason), provider_turns 2
; (message ids), native 1, file 1, non-Form 1, tokens_total 110, uncached 77.
; The meter is a door, so the band runs it as a child and reads its one line.
; The cell's value is the bitmask of the checks that held: 127 is all seven.
(do
    (defn fmb-fixture () "observe/tests/fixtures/flow-meter-transcript.jsonl")
    (defn fmb-line () (host-exec "./fkwu observe/flow-meter-run.bml 2>/dev/null | head -n 1" (str_concat (fmb-fixture) "\n")))
    (defn fmb-has? (line key) (if (ge (str_find line key 0) 0) 1 0))
    (defn fmb-bit (b v) (if (eq b 1) v 0))
    (let line (fmb-line))
    (let b1 (fmb-has? line "\"provider_calls\":3,"))
    (let b2 (fmb-has? line "\"provider_turns\":2,"))
    (let b3 (fmb-has? line "\"native_fkwu_calls\":1,"))
    (let b4 (fmb-has? line "\"file_calls\":1,"))
    (let b5 (fmb-has? line "\"non_form_calls\":1,"))
    (let b6 (fmb-has? line "\"tokens_total\":110,"))
    (let b7 (fmb-has? line "\"tokens_uncached\":77}"))
    (add (fmb-bit b1 1)
        (add (fmb-bit b2 2)
             (add (fmb-bit b3 4)
                  (add (fmb-bit b4 8)
                       (add (fmb-bit b5 16)
                            (add (fmb-bit b6 32) (fmb-bit b7 64))))))))
