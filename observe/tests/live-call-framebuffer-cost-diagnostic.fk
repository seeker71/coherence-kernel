; live-call-framebuffer-cost-diagnostic.fk -- public heap-shape observation for
; the live call projection.  Two equal batches reveal whether emitting a new
; cell repeatedly materializes all preceding framebuffer roots.
; preludes: form/form-stdlib/core.fk observe/live-call-framebuffer.fk

(do
  (defn lcfbcd-emit (remaining ordinal started)
    (if (le remaining 0) ordinal
      (do
        (let emitted
          (lcfb-call-stream-elapsed "lcfb-cost" "public-step" "modify"
            "form-native" "heap-shape" "public-fixture" ordinal 0
            "observe/tests/live-call-framebuffer-cost-diagnostic.fk" 12 11))
        (lcfbcd-emit (sub remaining 1) (add ordinal 1) started))))

  (defn live-call-framebuffer-cost-diagnostic ()
    (do
      (let started
        (lcfb-open-stream "lcfb-cost" "form-native" "heap-shape"
          "public-fixture"
          "observe/tests/live-call-framebuffer-cost-diagnostic.fk" 20 9))
      (let before (kernel_stat 6))
      (let reads-before (kernel_stat 229))
      (let first-end (lcfbcd-emit 32 1 started))
      (let middle (kernel_stat 6))
      (let reads-middle (kernel_stat 229))
      (let second-end (lcfbcd-emit 32 first-end started))
      (let after (kernel_stat 6))
      (let reads-after (kernel_stat 229))
      (list (sub middle before) (sub after middle)
        (sub reads-middle reads-before) (sub reads-after reads-middle)
        (len (framebuffer-events)) second-end)))

  (live-call-framebuffer-cost-diagnostic))
