; tests/float-mint-band.fk — the boxing floor holds: a float literal mints
; ONE pool slot per process, the int lane mints none, and intern_trivial_float
; keeps its name (dedup by canonical bits, the Go proof arm's contract).
; Verdict 63.
; PROOF LEVEL: FOURTH-ARM ONLY — kernel_stat (pf-arm-mask 8, probed 2026-09-03): its node/pool fills (4, 8) are the
; fkwu seed's own organs; the three minimal walkers do not carry them.
;
; Born 2026-09-02 beside onemint (the float-literal memo, fk_flit_memo) and
; the tag-113 interning heal: the boxvoice board had witnessed fspin boxing
; 600,000 floats in 300,000 iterations — two per pass, the add result AND the
; constant 1.5 re-boxed every evaluation. The literal now mints once per
; process; this band keeps that floor with the kernel's own counters instead
; of the per-pid board file. The add-result mint per iteration is the
; remaining NAMED cost — the unboxed float lane is the glass JIT's float
; story; when it lands, these deltas shrink and the ceilings here still hold.
(do
    (defn fmb-score (ok bit) (if ok bit 0))
    (defn fmb-fspin (i acc) (if (ge i 2000) acc (fmb-fspin (add i 1) (add acc 1.5))))
    (defn fmb-ispin (i acc) (if (ge i 2000) acc (fmb-ispin (add i 1) (add acc 3))))
    ; the accumulator seed mints once, outside every measured window
    (let z (str_to_float "0"))
    (let f0 (kernel_stat 8))
    (let fs1 (fmb-fspin 0 z))
    (let f1 (kernel_stat 8))
    (let is1 (fmb-ispin 0 0))
    (let f2 (kernel_stat 8))
    (let fs2 (fmb-fspin 0 z))
    (let f3 (kernel_stat 8))
    ; the literal mints once: the first float loop pays its 2000 add results
    ; plus ONE mint for the 1.5 (before onemint this delta read 4000)
    (let c0 (fmb-score (le (sub f1 f0) 2001) 1))
    ; the int lane mints nothing
    (let c1 (fmb-score (eq (sub f2 f1) 0) 2))
    ; the memo stands for the process: the same loop again pays only its adds
    (let c2 (fmb-score (le (sub f3 f2) 2000) 4))
    ; answers stay true while the pool thins
    (let c3 (fmb-score (and (eq fs1 3000) (and (eq fs2 3000) (eq is1 6000))) 8))
    ; intern_trivial_float keeps its name: same bits, same row, no second mint
    (let p0 (kernel_stat 8))
    (let ia (intern_trivial_float "2.5"))
    (let n1 (kernel_stat 4))
    (let ib (intern_trivial_float "2.5"))
    (let n2 (kernel_stat 4))
    (let p1 (kernel_stat 8))
    (let c4 (fmb-score (and (eq (sub n2 n1) 0) (le (sub p1 p0) 1)) 16))
    ; the computed lane never freezes: fresh strings, fresh values, exact sums
    (let c5 (fmb-score (and (eq (add 1.5 2.5) 4) (eq (str_to_float "2.25") 2.25)) 32))
    (print (add c0 (add c1 (add c2 (add c3 (add c4 c5))))))
0)
