; observe/tests/attention-field-band.fk — proof of the attention-field organ.
;
; preludes: form-stdlib/core.fk observe/attention-field.fk
;
; run: cat form/form-stdlib/core.fk observe/attention-field.fk \
;          observe/tests/attention-field-band.fk > /tmp/af.fk
;      ./fkwu --src /tmp/af.fk    ; -> 31
;
; c0 is the LIVE founding vector (2026-07-07, airport gate): organisms 1 (Urs,
; phone on the companion), 2 (Urs's Mac, front app Claude), 3 (this session)
; all attending target 9 (this exchange) -> 100. Then a two-thirds field, a
; fully divergent field (each alone with its own target -> 33), the honest
; empty 0, and a single organism whose whole field is its one gaze.

(do
    (defn afb-score (ok bit) (if ok bit 0))
    (defn attention-field-band ()
        (do
            (let c0 (afb-score (eq (af-coherence-pct (list (list 1 9) (list 2 9) (list 3 9))) 100) 1))
            (let c1 (afb-score (eq (af-coherence-pct (list (list 1 9) (list 2 9) (list 3 7))) 66) 2))
            (let c2 (afb-score (eq (af-coherence-pct (list (list 1 1) (list 2 2) (list 3 3))) 33) 4))
            (let c3 (afb-score (eq (af-coherence-pct (list)) 0) 8))
            (let c4 (afb-score (eq (af-coherence-pct (list (list 5 4))) 100) 16))
            (add c0 (add c1 (add c2 (add c3 c4))))))
    (attention-field-band))
