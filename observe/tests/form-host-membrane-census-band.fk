; form-host-membrane-census-band.fk -- host observation stays aggregate and owned.
; Expected: 127 (7 claims)
; preludes: observe/form-host-membrane-census.fk

(do
    (defn fhmcb-bit (ok bit) (if ok bit 0))
    (defn fhmcb-run ()
        (sum (list
            (fhmcb-bit (str_eq (fhmc-version)
                "form-host-membrane-census-v1") 1)
            (fhmcb-bit (ge (str_find (fhmc-model-process-command)
                "llama-server" 0) 0) 2)
            (fhmcb-bit (ge (str_find (fhmc-listener-command)
                "-sTCP:LISTEN" 0) 0) 4)
            (fhmcb-bit (ge (str_find (fhmc-established-command)
                "-sTCP:ESTABLISHED" 0) 0) 8)
            (fhmcb-bit (eq (fhmc-command-private-safe?
                (fhmc-model-process-command)) 1) 16)
            (fhmcb-bit (eq (fhmc-command-private-safe?
                "ps -o command=") 0) 32)
            (fhmcb-bit (eq (fmrc-delta-has?
                (list (list "host-exec" 136 "local-process" 1 0 1))
                "host-exec") 1) 64))))
    (fhmcb-run))
