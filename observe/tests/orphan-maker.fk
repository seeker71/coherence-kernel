; orphan-maker.fk — starts a sleeper, says its pid, and ends without waiting for it, so the sleeper is left
; with pid 1 for a parent: a real orphan for the census's orphans reading (form/form-stdlib/kernel-roster.bml)
; and for form/form-stdlib/tests/host-process-band.fk, whose census row for it is owned by launchd.
;
; preludes: form-stdlib/core.fk
(do
    (let c (host_spawn_quiet (list "./fkwu" "observe/tests/roster-sleeper.fk")))
    (print_str (int_to_str c))
    0)
