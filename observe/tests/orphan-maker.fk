; orphan-maker.fk — starts a sleeper, says its pid, and ends without waiting for it, so the sleeper is left
; with pid 1 for a parent. Spawned by form/form-stdlib/tests/roster-census-band.fk to make a real orphan.
;
; preludes: form-stdlib/core.fk
(do
    (let c (host_spawn_quiet (list "./fkwu" "observe/tests/roster-sleeper.fk")))
    (print_str (int_to_str c))
    0)
