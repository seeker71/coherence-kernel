; jit-evaluator-heat-band.fk -- the live fourth-arm counter surface becomes
; calibrated Form data without a fixed function/operation registry.
;
; Verdict 4095.  The workload is intentionally much larger than one snapshot
; so its signal remains visible after subtracting the empty observer interval.
;
; preludes: form/form-stdlib/core.fk observe/jit-evaluator-heat.fk

(do
    (defn jehb-bit (ok bit) (if ok bit 0))
    (defn jehb-work (i count acc)
        (if (ge i count) acc
            (jehb-work (add i 1) count
                (add acc (mod (mul i 3) 97)))))
    (defn jehb-run ()
        (do
            (let direct-snapshot (jeh-snapshot))
            (let window (jeh-open))
            (let value (jehb-work 0 10000 0))
            (let receipt (jeh-close window))
            (let rows (jeh-rows receipt))
            (let choices (jeh-choices receipt))
            (let add-row (jeh-at rows 3))
            (let mod-row (jeh-at rows 11))
            (let mul-row (jeh-at rows 42))
            (let hottest (jeh-hottest-score rows))
            (sum (list
                (jehb-bit (eq (len direct-snapshot) 256) 1)
                (jehb-bit (jeh-window? window) 2)
                (jehb-bit (jeh-receipt? receipt) 4)
                (jehb-bit (eq (jeh-sampled-slots receipt) 256) 8)
                (jehb-bit (gt (len rows) 0) 16)
                (jehb-bit (gt (len choices) 0) 32)
                (jehb-bit (jeh-all-score? choices hottest) 64)
                (jehb-bit (nothing? (jeh-at rows 127)) 128)
                (jehb-bit (and (not (nothing? add-row))
                               (gt (jeh-row-excess add-row) 0)) 256)
                (jehb-bit (and (not (nothing? mod-row))
                               (gt (jeh-row-excess mod-row) 0)) 512)
                (jehb-bit (and (not (nothing? mul-row))
                               (gt (jeh-row-excess mul-row) 0)) 1024)
                ; Nothing stays distinct from both a valid computed value and
                ; every positive count in the receipt.
                (jehb-bit (and (nothing? (jeh-at rows 255))
                               (and (not (nothing? value)) (ge value 0))) 2048)))))
    (jehb-run))
