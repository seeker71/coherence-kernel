//////////////////////////////////////////////////////////////////////
// tests/import-carry-fixture-floor.bml -- the floor-lane half of
// import-carry-band.fk's pair. The import lane never probes a .bml as a
// standalone image; its lowered text must be CARRIED beside the imports,
// or every def below goes numb at the band's call sites.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class ImportCarryFixtureFloor {
        field Mark = "carried-floor-alive";

        def icff-mark() = Mark();
        def icff-answer(x) = add(x, 1);
    }
    0;
}
