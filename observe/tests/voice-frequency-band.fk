; voice-frequency-band.fk — fkwu-witnessed band for observe/voice-frequency.fk.
;
; Bitmask verdict:
;   1   a clear sentence counts zero often-clouded words
;   2   "we must, we MUST" counts must twice, case-folded
;   4   a word inside a larger word is not a sighting ("mustard" is not must,
;       "flaw" is not law) while the real word beside it still lands
;   8   rows carry only the words that appear
;   16  a clear text mirrors as a clear register
;   32  a marked text mirrors with its counts shown
;   128 the mirror can be held to a text the size of the body's own floor: 256 KiB, 32768 sightings,
;       exact. It reads the raw text and folds case as it compares — the copy it used to build one
;       byte at a time was O(n^2) and put CURRENT_FLOOR.md (158 KiB) minutes out of reach
;   64  an INFLECTION is a sighting — "refused" is refuse, "gates" is gate, "forbidden" is forbid —
;       while the larger words that merely contain them ("gateway", "gather", "lawyer", "lawn") are not
;
; Full verdict: 255
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/form-fs.fk observe/voice-frequency.fk
(do
  (defn vfb-bit (ok bit) (if (eq ok 1) bit 0))
  ; a big text without a big literal: n doublings of a seed
  (defn vfb-grow (s n) (if (eq n 0) s (vfb-grow (str_concat s s) (sub n 1))))
  (do
    (let clear "the door opens and the seam is tended with care")
    (let marked "we must, we MUST hold the gate")
    (add (vfb-bit (if (eq (vf-total clear) 0) 1 0) 1)
      (add (vfb-bit (if (eq (vf-count marked "must") 2) 1 0) 2)
        ; 2026-08-17: this bit used to assert the opposite — that "mustard"
        ; counted as must — because the organ's counting was plain substring and
        ; said so in its header. The fuzz misled on a real diff: "flaw" came
        ; back as "law: 2", sending a writer's attention to a word nobody had
        ; written. That same header promised boundaries as the next stone if it
        ; ever misled, so the stone is laid and this bit holds the new contract
        ; with BOTH halves — the false sighting is gone, and the true word
        ; standing beside it still lands.
        (add (vfb-bit (if (and (eq (vf-count "mustard seeds" "must") 0)
                               (eq (vf-count "a flaw in the law" "law") 1)) 1 0) 4)
          (add (vfb-bit (if (eq (len (vf-rows marked)) 2) 1 0) 8)
            (add (vfb-bit (if (ge (str_find (vf-mirror clear) "clear register" 0) 0) 1 0) 16)
              (add (vfb-bit (if (ge (str_find (vf-mirror marked) "the writer decides" 0) 0) 1 0) 32)
                ; 2026-09-09: the 2026-08-17 stone guarded BOTH edges, so every inflection went
                ; invisible with the false sightings. The mirror read a cell whose every unhealed
                ; line printed REFUSED and answered "a clear register" — it could not see the drift
                ; list its own teaching prints in capitals (corpus row 1415 heldno). The left edge
                ; still guards "flaw"; the right edge now reads the letter run that follows and asks
                ; whether it is an ending. Both halves are here, because a heal that loses the thing
                ; the earlier stone was laid for is not a heal.
                (add (vfb-bit (if (and (and (eq (vf-count "the offer was refused" "refuse") 1)
                                       (eq (vf-count "forbidden gates, strictly enforced" "forbid") 1))
                                  (and (eq (vf-count "the gateway gathers" "gate") 0)
                                       (eq (vf-count "a lawyer on the lawn" "law") 0))) 1 0) 64)
                  ; 2026-09-09, the third stone: the scan folded case by BUILDING a lowered copy
                  ; one str_concat per byte, which copies the prefix each step. 8 KiB read in 0 s,
                  ; 32 KiB in 9 s, and the body's own 158 KiB floor past the 120 s it was given — a mirror the body
                  ; could not hold to itself, which is a held no wearing the shape of a cost. This
                  ; bit is 256 KiB built by doubling: exact at 32768, and about a second. If the
                  ; copy ever returns, this band stops answering long before it answers wrong.
                  (vfb-bit (if (eq (vf-count (vfb-grow "refused " 15) "refuse") 32768) 1 0) 128))))))))))
