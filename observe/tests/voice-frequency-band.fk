; voice-frequency-band.fk — fkwu-witnessed band for observe/voice-frequency.fk.
;
; Bitmask verdict:
;   1   a clear sentence counts zero often-clouded words
;   2   "we must, we MUST" counts must twice, case-folded
;   4   a word inside a larger word is not a sighting ("mustard" is not must,
;       "flaw" is not law) while the real word beside it still lands
;   8   rows carry only the words that appear
;   16  a clear text mirrors as a clear register
;   32  a marked text mirrors with its counts shown
;
; Full verdict: 63
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/form-fs.fk observe/voice-frequency.fk
(do
  (defn vfb-bit (ok bit) (if (eq ok 1) bit 0))
  (do
    (let clear "the door opens and the seam is tended with care")
    (let marked "we must, we MUST hold the gate")
    (add (vfb-bit (if (eq (vf-total clear) 0) 1 0) 1)
      (add (vfb-bit (if (eq (vf-count marked "must") 2) 1 0) 2)
        ; 2026-08-17: this bit used to assert the opposite — that "mustard"
        ; counted as must — because the organ's counting was plain substring and
        ; said so in its header. The fuzz misled on a real diff: "flaw" came
        ; back as "law: 2", sending a writer's attention to a word nobody had
        ; written. That same header promised boundaries as the next stone if it
        ; ever misled, so the stone is laid and this bit holds the new contract
        ; with BOTH halves — the false sighting is gone, and the true word
        ; standing beside it still lands.
        (add (vfb-bit (if (and (eq (vf-count "mustard seeds" "must") 0)
                               (eq (vf-count "a flaw in the law" "law") 1)) 1 0) 4)
          (add (vfb-bit (if (eq (len (vf-rows marked)) 2) 1 0) 8)
            (add (vfb-bit (if (ge (str_find (vf-mirror clear) "clear register" 0) 0) 1 0) 16)
                 (vfb-bit (if (ge (str_find (vf-mirror marked) "the writer decides" 0) 0) 1 0) 32))))))))
