; tests/work-metric-band.fk — the stone-work metric holds its own laws before any student exists.
;
; PREREGISTERED 2026-08-18, predicted verdict 255. POWER-OF-TWO BIT WEIGHTS so a reader can
; subtract. Every mutation below is run against the SAME first real trial row, so a gate that
; cannot fail (vacuity, corpus row 1007) has nowhere to hide: each bit's mutation flips exactly
; one axis and must flip the score.
;
;   bit   1  THE METRIC IS THE REGISTERED ONE: id 20260818.
;   bit   2  KIND CLOSURE: all eight stone kinds admit; an alien kind ("compile") refuses.
;   bit   4  THE HELD-OUT CASES ARE HELD: four cases, every held flag 1 — none may ever train.
;   bit   8  THE FIRST REAL TRIAL SCORES: the 2026-08-18 slot-rung stone, as rows, earns its coin
;            (correct AND every step witnessed AND inside its clock).
;   bit  16  THE STALLRED LAW BITES: the same trial with its bound pulled under its clock scores
;            0 — a trial that outlives its clock is red, the fold never waits.
;   bit  32  PROCESS BITES: the same trial with one witness emptied scores 0 — a claim without
;            a witness is not a step.
;   bit  64  CORRECTNESS BITES: the same trial with the honest first-witness actual (191, the
;            gold-ledger's slot-bound-bit row) against prediction 255 scores 0.
;   bit 128  THE EARN IS COMPOSED, NOT INVENTED: an 8-case tie history promotes under
;            cc-promote? (margin 0), and the same coins over only 3 cases refuse (min-samples) —
;            the gate is champion-challenger.fk's own, witnessed through this cell.
;
; preludes: observe/work-metric.fk

(do
    (defn wmb-score (ok bit) (if ok bit 0))

    ; a trial with one field swapped — built fresh, never mutated in place
    (defn wmb-with-bound (t nb)
        (wm-trial (wm-case t) (wm-worker t) (wm-pred t) (wm-act t) (wm-clock t) nb (wm-steps t)))
    (defn wmb-with-act (t na)
        (wm-trial (wm-case t) (wm-worker t) (wm-pred t) na (wm-clock t) (wm-bound t) (wm-steps t)))
    (defn wmb-blank-wit (ss)
        (if (eq (len ss) 0) (empty)
            (append (list (wm-step (wm-step-kind (head ss)) (wm-step-move (head ss)) ""))
                    (tail ss))))
    (defn wmb-with-blank-first-wit (t)
        (wm-trial (wm-case t) (wm-worker t) (wm-pred t) (wm-act t) (wm-clock t) (wm-bound t)
                  (wmb-blank-wit (wm-steps t))))

    (defn wmb-ties (n) (if (eq n 0) (empty) (append (wmb-ties (sub n 1)) (list (list 1 1)))))

    (let t0 (wm-first-trial))

    (let c0 (wmb-score (eq (wm-metric-id) 20260818) 1))
    (let c1 (wmb-score (and (eq (wm-kind-ok? "map") 1)
                       (and (eq (wm-kind-ok? "receipt") 1)
                            (eq (wm-kind-ok? "compile") 0))) 2))
    (let c2 (wmb-score (and (eq (len (wm-cases)) 4) (eq (wm-all-held (wm-cases)) 1)) 4))
    (let c3 (wmb-score (eq (wm-score t0) 1) 8))
    (let c4 (wmb-score (eq (wm-score (wmb-with-bound t0 60000)) 0) 16))
    (let c5 (wmb-score (eq (wm-score (wmb-with-blank-first-wit t0)) 0) 32))
    (let c6 (wmb-score (eq (wm-score (wmb-with-act t0 191)) 0) 64))
    (let c7 (wmb-score (and (eq (wm-earns? (wmb-ties 8) 8 0) 1)
                            (eq (wm-earns? (wmb-ties 3) 8 0) 0)) 128))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
