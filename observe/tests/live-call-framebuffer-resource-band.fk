; live-call-framebuffer-resource-band.fk -- a native resource lens remains
; privacy-safe, content-sensitive, source-attributed, and history-independent.
; Verdict 2047 proves eleven properties.
; preludes: form/form-stdlib/core.fk observe/live-call-framebuffer.fk

(do
  (defn lcfbrb-bit (condition bit) (if condition bit 0))
  (defn live-call-framebuffer-resource-band ()
    (do
      (let reads-before (kernel_stat 229))
      (let first (lcfb-resource-target "public-fixture"))
      (let changed
        (intern_trivial_int (add (now_unix_ms) (kernel_stat 4))))
      (let second (lcfb-resource-target "public-fixture"))
      (let reads-after-targets (kernel_stat 229))
      (let started
        (lcfb-open-stream "lcfb-resource-band" "form-native"
          "native-resource-lens" "public-fixture"
          "observe/tests/live-call-framebuffer-resource-band.fk" 17 9))
      (let sample
        (lcfb-call-stream "lcfb-resource-band" "native-resource" "modify"
          "form-native" "native-resource-lens" second 1 started
          "observe/tests/live-call-framebuffer-resource-band.fk" 21 9))
      (let reads-before-boundary (kernel_stat 229))
      (let events (framebuffer-events))
      (let reads-after-boundary (kernel_stat 229))
      (let source (node_source sample))
      (sum (list
        (lcfbrb-bit (eq (str_find first "public-fixture:o" 0) 0) 1)
        (lcfbrb-bit (gt (str_find first ":n" 0) 0) 2)
        (lcfbrb-bit (gt (str_find first ":s" 0) 0) 4)
        (lcfbrb-bit (gt (str_find first ":c" 0) 0) 8)
        (lcfbrb-bit (gt (str_find first ":r" 0) 0) 16)
        (lcfbrb-bit (gt (str_find first ":e" 0) 0) 32)
        (lcfbrb-bit (not (str_eq first second)) 64)
        (lcfbrb-bit (eq reads-before reads-after-targets) 128)
        (lcfbrb-bit (and (eq (len events) 2)
                           (eq (lcfb-call? sample) 1)) 256)
        (lcfbrb-bit
          (and (eq (len source) 3)
               (str_eq (nth source 0)
                 "observe/tests/live-call-framebuffer-resource-band.fk"))
          512)
        (lcfbrb-bit
          (and (eq reads-before-boundary reads-after-targets)
               (eq (sub reads-after-boundary reads-before-boundary) 1))
          1024)))))
  (live-call-framebuffer-resource-band))
