; say-band.fk — the body can speak mid-program, on every arm.
;
; preludes: form/form-stdlib/core.fk observe/say.fk
;
; Band verdict 255 when every claim lands (1+2+...+128):
;   1    say-to writes, and answers the byte count it wrote
;   2    what it wrote reads back exactly
;   4    say-line-to adds one newline and nothing else
;   8    an empty string is written as zero bytes rather than turned away
;   16   writing twice replaces rather than appends — the act is a write, not a log
;   32   say-count renders a label and an integer, and reads back as written
;   64   the stdout door opens — say answers a non-negative count, i.e. it wrote rather
;        than failed. Asked with the empty string, so proving it costs no output.
;   128  the count is BYTES, not characters: a two-byte UTF-8 glyph costs two
;
; The file checks go to a temp path rather than stdout, because a band that proved
; itself by writing to stdout would be proving it by being read. Bit 64 is the one
; claim that touches the real door, and it asks only what the door reports.

(do
    (let dir (temp_dir))
    (let path (str_concat dir "/say-band-probe.txt"))
    (let text "the body says something")

    (let wrote (say-to path text))
    (let back (read_file path))

    (let lnpath (str_concat dir "/say-band-line.txt"))
    (let lnwrote (say-line-to lnpath text))
    (let lnback (read_file lnpath))

    (let emptypath (str_concat dir "/say-band-empty.txt"))
    (let emptywrote (say-to emptypath ""))

    (let twicepath (str_concat dir "/say-band-twice.txt"))
    (let first (say-to twicepath "aaaa"))
    (let second (say-to twicepath "bb"))
    (let twiceback (read_file twicepath))

    (let cntpath (str_concat dir "/say-band-count.txt"))
    (let cntwrote (say-line-to cntpath (str_concat "sites" (str_concat " " (int_to_str 751)))))
    (let cntback (read_file cntpath))

    (add
        (add
            (add
                (if (eq wrote (str_len text)) 1 0)
                (if (str_eq back text) 2 0))
            (add
                (if (eq lnwrote (add (str_len text) 1)) 4 0)
                (if (eq emptywrote 0) 8 0)))
        (add
            (add
                (add
                    (if (and (eq second 2) (str_eq twiceback "bb")) 16 0)
                    (if (str_eq cntback "sites 751\n") 32 0))
                (if (ge (say "") 0) 64 0))
            (if (eq (say-to (str_concat dir "/say-band-bytes.txt") "λ") 2) 128 0))))
