; preludes: observe/review-operationalization.fk
;
; 8191: PASS, measured refusal, and honest open state are all reachable.

(do
    (let good-a (ro-row 108 1 1 1 0 0 1 1))
    (let good-b (ro-row 77777 1 1 1 0 0 1 1))
    (let primary-fails (ro-row 33 1 0 1 0 0 1 1))
    (let control-fails (ro-row 60 1 1 1 0 1 1 1))
    (let unseen (ro-row 1818 1 0 0 0 0 1 1))
    (let stale (ro-row 888 1 0 1 0 0 1 0))
    (let good (list good-a good-b))
    (let duplicate (list good-a good-a))

    (add (if (eq (add (ro-revise) (ro-pass)) 0) 1 0)
    (add (if (eq (ro-row-determinate? good-a) 1) 2 0)
    (add (if (eq (ro-row-matches? good-a) 1) 4 0)
    (add (if (eq (ro-row-refuses? primary-fails) 1) 8 0)
    (add (if (eq (ro-row-refuses? control-fails) 1) 16 0)
    (add (if (eq (ro-row-refuses? unseen) 0) 32 0)
    (add (if (eq (ro-row-refuses? stale) 0) 64 0)
    (add (if (eq (ro-verdict good 2) (ro-pass)) 128 0)
    (add (if (eq (ro-verdict (list good-a) 2) (ro-open)) 256 0)
    (add (if (eq (ro-verdict (list good-a primary-fails) 2) (ro-revise)) 512 0)
    (add (if (eq (ro-verdict (list good-a control-fails) 2) (ro-revise)) 1024 0)
    (add (if (eq (ro-verdict duplicate 2) (ro-open)) 2048 0)
    (add (if (eq (ro-verdict (list) 0) (ro-open)) 4096 0)
         0))))))))))))))
