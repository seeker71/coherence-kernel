; child-framebuffer-channel-band.fk -- pure protocol/default boundary.
; Verdict 32767 proves fifteen parsing, offer, correlation, and default bits.

import "../child-framebuffer-channel.fk"

(do
  (let actions (list 0 1 2 3 4 5))
  (let alternative (intern_trivial_int 901))
  (let current (intern_trivial_int 902))
  (let rehearsed (intern_trivial_int 903))
  (let outbound (bfc-envelope 0 41 0 (list 2 1) alternative))
  (let valid (cfc-control-line
    "child-control|schema=v1|exchange=41|action=5" 41 actions alternative))
  (let mismatch (cfc-control-line
    "child-control|schema=v1|exchange=42|action=5" 41 actions alternative))
  (let unoffered (cfc-control-line
    "child-control|schema=v1|exchange=41|action=6" 41 actions alternative))
  (let malformed (cfc-control-line
    "child-control|schema=v2|exchange=41|action=5" 41 actions alternative))
  (let missing-action (cfc-control-line
    "child-control|schema=v1|exchange=41" 41 actions alternative))
  (let no-default (bfc-envelope 0 41 0 (list 0 0) (nothing)))
  (let continue-control (bfc-control outbound 0))
  (let rehearse-control (bfc-control outbound 5))
  (let wrong-exchange (bfc-envelope 1 42 1 5 alternative))
  (sum (list
    (if (not (nothing? valid)) 1 0)
    (if (eq (bfc-exchange valid) 41) 2 0)
    (if (eq (bfc-payload valid) 5) 4 0)
    (if (nothing? mismatch) 8 0)
    (if (nothing? unoffered) 16 0)
    (if (nothing? malformed) 32 0)
    (if (nothing? missing-action) 64 0)
    (if (nothing? (bfc-apply no-default (nothing) current rehearsed)) 128 0)
    (if (node_eq (bfc-apply outbound (nothing) current rehearsed) alternative) 256 0)
    (if (node_eq (bfc-apply outbound rehearse-control current rehearsed) rehearsed) 512 0)
    (if (node_eq (bfc-apply outbound continue-control current rehearsed) current) 1024 0)
    (if (node_eq (bfc-apply outbound wrong-exchange current rehearsed) alternative) 2048 0)
    (if (eq (cfc-action-offered? actions 0) 1) 4096 0)
    (if (eq (cfc-action-offered? actions 6) 0) 8192 0)
    (if (str_eq (cfc-status-line 41 "outbound" 1 1 0 1 (sub 0 1) 0)
      "child-framebuffer|schema=v1|exchange=41|stage=outbound|events=1|attributed=1|accepted=0|default-present=1|action=-1|state-changed=0") 16384 0))))
