//////////////////////////////////////////////////////////////////////
// tests/bml-multiline-def-fixture.bml -- the floor half of
// bml-multiline-def-band.fk's pair. Three def shapes over the SAME
// meaning: a single-line control, a call body torn across lines, an if
// body that never touches the definition line. Before the statement
// heal the torn call refused loudly and the wrapped if bound a def
// whose body was the EMPTY expr -- it answered [] forever with zero
// diagnostics while its real body evaluated as a stray top statement.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    def bmd-one-line(x) = add(x, 1);
    def bmd-call-lines(x) = add(
        x,
        1);
    def bmd-if-lines(x) =
        if le(x, 0)
            then 0
            else 1;
    0;
}
