; Expected: 127. A marker is a complete comment line, not quoted test data.
; preludes: observe/preflight.fk
(do
    (defn pfmb-bit (ok bit) (if ok bit 0))
    (let marker "; preflight-exec: forbidden")
    (sum (list
        (pfmb-bit (eq (pf-effect-marker? marker 0) 1) 1)
        (pfmb-bit (eq (pf-effect-marker? (str_concat "  " (str_concat marker "\r\n0")) 0) 1) 2)
        (pfmb-bit (eq (pf-effect-marker? (str_concat "(print \"" (str_concat marker "\")")) 0) 0) 4)
        (pfmb-bit (eq (pf-effect-marker? "" 0) 0) 8)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-run.fk") 1) 16)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-machine-live.fk") 1) 32)
        (pfmb-bit (eq (pf-effect-forbidden? "observe/form-glass-organs-live.fk") 1) 64))))
