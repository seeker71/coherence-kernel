; tests/self-extent-band.fk — the band for observe/self-extent.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk observe/stated-constant-audit.fk observe/self-extent.fk
;
; b1 is the whole point: the cell can read itself and finds a non-empty length.
; A cell that could not open its own door would answer 0 here and every other bit
; would be a fold over that nothing.
;
; b4 and b5 are the identity: the NodeID is four coordinates and it MEETS itself.
; Two interns of the same content answering node_eq 1 is what makes it an address
; rather than a fresh allocation each time.
;
; b6 and b7 keep the reading from being a constant: this cell and a sibling read
; apart in bytes, and a cell reads equal to itself.
;
; b8 PERTURBS THE TOP LEVEL: reading a path that is not there answers 0, so a
; non-zero length elsewhere means a door actually opened.
;
; witnessed: 2026-08-15 -> 255 on fkwu (read_file and scan_run are native here;
;   the three minimal walkers carry neither, so this is a one-arm reading).

(do
    (defn sxb-k (cond bit) (if cond bit 0))
    (defn sxb-sibling () "observe/stated-constant-audit.fk")
    (defn self-extent-band ()
        (add (add (add (add (add (add (add
            ; the cell opens its own door and finds itself
            (sxb-k (gt (sx-own-bytes) 0) 1)
            ; it walks itself and the count is a number, not nothing
            (sxb-k (ge (sx-own-stated) 0) 2))
            ; the reading is one row of three parts
            (sxb-k (eq (len (sx-reading)) 3) 4))
            ; identity: four coordinates
            (sxb-k (eq (len (sx-id)) 4) 8))
            ; identity: it meets itself — an address, not a fresh mint each call
            (sxb-k (eq (sx-id-holds?) 1) 16))
            ; two different cells read apart
            (sxb-k (eq (sx-reads-apart? (sx-own-path) (sxb-sibling)) 1) 32))
            ; and a cell reads equal to itself
            (sxb-k (eq (sx-reads-apart? (sx-own-path) (sx-own-path)) 0) 64))
            ; PERTURBATION: an absent path answers 0, so a length means a door opened
            (sxb-k (eq (sx-cell-bytes "observe/no-such-cell-here.fk") 0) 128)))
    (self-extent-band))
