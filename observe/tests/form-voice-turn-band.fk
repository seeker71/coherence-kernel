; form-voice-turn-band.fk -- anti-forgery proof for a Form-owned final answer.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/string-byte-fold-src-shim.fk form-stdlib/sha256.fk
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/hex.fk
; preludes: form-stdlib/form-agent-protocol.fk form-stdlib/choice-receipt.fk
; preludes: form-stdlib/form-agent-tree.fk form-stdlib/tool-channel.fk
; preludes: form-stdlib/form-cli-membrane.fk observe/form-voice-turn.fk
;
; Verdict 1023 proves ten distinct boundaries:
;   1 native -> Metal-negative -> local is ordered; direct local escalation is refused
;   2 Form computes a content identity, and a changed byte sequence does not bind
;   4 a local agent is named rented-voice / local-oracle / local-cli-return
;   8 a false native label is refused
;  16 Form admits only a pre-offered planned tool call
;  32 the observed result re-enters the forked Form agent tree
;  64 missing required tool output prevents finalization
; 128 frequency remains unmeasured and claims remain semantically unjudged
; 256 exact-byte identity rendering succeeds through Form
; 512 any outer rewrite becomes refused-untracked-transform

(do
    (let turn-id "voice-turn-band-001")
    (let prompt "How is the crossing held?")
    (let prompt-ref (fvt-content-ref "hash-only" prompt ""))
    (let args-ref (fvt-content-ref "hash-only" "trace=local-health" ""))
    (let result-ref (fvt-content-ref "hash-only" "tool-observation=present" ""))
    (let adapter-ref (fvt-content-ref "hash-only" "adapter=form-local-agent-v1" ""))
    (let answer "The answer is rendered exactly after Form verifies the turn.")
    (let answer-ref (fvt-content-ref "hash-only" answer ""))
    (let native-first (fvt-route "native-no-answer" "metal-refused" "local-returned"))
    (let local-first (fvt-route "native-no-answer" "metal-not-attempted" "local-returned"))
    (let offer (fvt-offer "tool-1" "query" "cap.store.query" args-ref))
    (let turn (fvt-turn turn-id "hash-only" prompt-ref native-first (list offer)))
    (let proposal (fvt-proposal turn-id 1 "tool-1" "query" "cap.store.query" args-ref))
    (let crossing (fcm-crossing "query" "cap.store.query" (fcm-surface-native)
                                     1 "turn-tool-observation" "success" 100 0))
    (let parent (list (ap-msg "user" (list (ap-text "opaque-prompt-ref")))))
    (let step (fvt-observed-step parent proposal result-ref crossing "success" 100 1))
    (let provenance (fvt-provenance "rented-voice" (fcm-surface-local-oracle)
                                    "local-cli-return" adapter-ref
                                    "adapter-manifest-bound"))
    (let false-native (fvt-provenance "rented-voice" (fcm-surface-native)
                                      "local-cli-return" adapter-ref
                                      "adapter-manifest-bound"))
    (let claim (fvt-claim "claim-1" answer-ref result-ref "unjudged"))
    (let candidate (fvt-candidate turn-id answer-ref provenance (list "tool-1")
                                  (list claim) "unmeasured"))
    (let forged-candidate (fvt-candidate turn-id answer-ref false-native (list "tool-1")
                                         (list claim) "unmeasured"))
    (let exact-final (fvt-final turn-id "identity-render" answer-ref "none"))
    (let rewritten-ref (fvt-content-ref "hash-only" "Outer narration changed these bytes." ""))
    (let rewritten-final (fvt-final turn-id "identity-render" rewritten-ref "none"))

    (let c0 (if (and (eq (fvt-route-valid? native-first) 1)
                     (eq (fvt-route-valid? local-first) 0)) 1 0))
    (let c1 (if (and (eq (fvt-ref-valid? answer-ref) 1)
                     (eq (str_eq (fvt-sha256 "changed") (fvt-ref-sha256 answer-ref)) 0)) 2 0))
    (let c2 (if (eq (fvt-provenance-valid? provenance) 1) 4 0))
    (let c3 (if (eq (fvt-provenance-valid? false-native) 0) 8 0))
    (let c4 (if (and (eq (fvt-proposal-admitted? turn proposal) 1)
                     (eq (fvt-proposal-admitted? turn
                          (fvt-proposal turn-id 1 "tool-2" "query" "cap.store.query" args-ref)) 0)) 16 0))
    (let c5 (if (and (eq (fvt-step-valid? turn step) 1)
                     (eq (fvt-step-carried-result? step) 1)) 32 0))
    (let c6 (if (str_eq (fvt-decision turn candidate (list) exact-final)
                         "refused-missing-tool-result") 64 0))
    (let c7 (if (and (str_eq (fvt-candidate-frequency candidate) "unmeasured")
                     (eq (fvt-claim-valid? claim) 1)) 128 0))
    (let c8 (if (and (str_eq (fvt-decision turn candidate (list step) exact-final)
                         "accepted-exact-candidate")
                     (str_eq (fvt-render-exact turn candidate (list step) exact-final answer) answer)) 256 0))
    (let c9 (if (and (str_eq (fvt-decision turn candidate (list step) rewritten-final)
                              "refused-untracked-transform")
                         (and (str_eq (fvt-render-exact turn candidate (list step) rewritten-final answer)
                                      "FORM-VOICE-TURN-REFUSED")
                              (eq (fvt-candidate-valid? forged-candidate) 0))) 512 0))

    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9))))))))))
