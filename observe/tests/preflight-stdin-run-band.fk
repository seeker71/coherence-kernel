; preflight-stdin-run-band.fk — the parallel-safe preflight door owns its
; target on stdin and leaves the fixed /tmp compatibility door intact.
; Expected: 31
; preludes: form-stdlib/core.fk

(do
    (defn pfsb-bit (condition bit) (if condition bit 0))
    (defn pfsb-has (text needle) (if (ge (str_find text needle 0) 0) 1 0))
    (let source (read_file "observe/preflight-stdin-run.fk"))
    (let compatibility (read_file "observe/preflight-run.fk"))
    (let practice (read_file "AGENTS.md"))
    (sum (list
        (pfsb-bit (eq (pfsb-has source "(read_line)") 1) 1)
        (pfsb-bit (lt (str_find source "/tmp/preflight-target" 0) 0) 2)
        (pfsb-bit (eq (pfsb-has source "(pf-report target)") 1) 4)
        (pfsb-bit (and (eq (pfsb-has practice "process-local") 1)
                       (eq (pfsb-has practice "preflight-stdin-run.fk") 1)) 8)
        (pfsb-bit (eq (pfsb-has compatibility "/tmp/preflight-target") 1) 16))))
