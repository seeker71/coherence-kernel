; tests/ask-lane-floor-band.fk — the ASK verb's routing discipline holds on any host.
;
; preludes: observe/ask-lane-floor.fk
;
; run: ./fkwu observe/tests/ask-lane-floor-band.fk   ; -> 31
;      (resolver-driven; the preludes line above is the live load directive)
;
; Every check here is host-independent ON PURPOSE. The floor CODE differs between a box
; with no weights (0, this container) and one holding them (10 or 11), so the code is
; reported by the cell and never asserted here — a band that demanded 0 would go red on
; the day the voice comes home, which is the one day it must not.
;
; fkwu-witnessed: the ask closure reaches the filesystem (file_size, read_file), which is
; fkwu's family and not the walkers'. Never claimed four-way.
; witnessed: 2026-07-25 -> 31 on fkwu, floor code 0 in this container

(do
    (defn alfb-k (cond bit) (if cond bit 0))
    (defn alfb-q () "What is BenchBenchBench, and does the recursion terminate?")
    (defn ask-lane-floor-band ()
        (add (add (add (add
            (alfb-k (eq (alf-routes-to-grounded? (alfb-q)) 1) 1)
            (alfb-k (eq (alf-decline-named? (alfb-q)) 1) 2))
            (alfb-k (eq (alf-answer-carries-lane? (alfb-q)) 1) 4))
            (alfb-k (eq (alf-answer-carries-decline? (alfb-q)) 1) 8))
            (alfb-k (eq (alf-floor-wellformed? (alfb-q)) 1) 16)))
    (ask-lane-floor-band))
