; tests/import-carry-fixture-pair.fk — the pair import-carry-band.fk walks in a
; home no other build has written. It names no preludes: the band copies the
; unit and the floor beside it and puts the `; preludes:` line in front of this
; text, so its closure is the band's copies and never a cache another fkwu left.
;
; It answers its six bits plus 64 when its own compile took the import lane
; (kernel_stat 15 = 1) and 128 when it replayed its cached image (15 = 2):
; 127 cold, 191 warm.
;
; b1/b2 stand on the IMPORTED half: the image's defns answer.
; b4/b8 stand on the CARRIED half: the .bml's defns answer. The lane once
; rebuilt the program as images + root text and left the .bml's lowered defns
; behind without a word: every icff-* call answered [unresolved-call] numb
; (healed in fk_src_try_import_fkb_images: uncovered units are carried as source
; beside the imports).
; b16/b32 stand on the ADMISSION PULSE: the run reads WHICH door its own compile
; took (kernel_stat 15: 0 flat, 1 import lane, 2 cached image, 3 native dylib;
; 16 images imported; 17 units carried; 18 last lane-refusal reason), and the
; counters agree with that door.

(do
    (defn icb-k (cond bit) (if cond bit 0))
    ; door 1 (import lane): exactly one image, one carried unit, no refusal.
    ; door 2 (cached replay): the lane never ran, both counters 0.
    ; any other door is inconsistent for this pair's shape.
    (defn icb-door-consistent (door)
        (if (eq door 1)
            (if (eq (kernel_stat 16) 1)
                (if (eq (kernel_stat 17) 1) (eq (kernel_stat 18) 0) 0)
                0)
            (if (eq door 2)
                (if (eq (kernel_stat 16) 0) (eq (kernel_stat 17) 0) 0)
                0)))
    (defn import-carry-pair ()
        (add (add (add (add (add (add (add
            ; the imported image's defns answer
            (icb-k (eq (icfu-answer) 41) 1)
            (icb-k (eq (icfu-twice 21) 42) 2))
            ; the carried floor's defns answer — the wound bits
            (icb-k (str_eq (icff-mark) "carried-floor-alive") 4))
            (icb-k (eq (icff-answer 41) 42) 8))
            ; the run knows its own door: import lane cold, cached warm
            (icb-k (or (eq (kernel_stat 15) 1) (eq (kernel_stat 15) 2)) 16))
            ; and the pulse counters agree with that door
            (icb-k (eq (icb-door-consistent (kernel_stat 15)) 1) 32))
            ; which door it was
            (icb-k (eq (kernel_stat 15) 1) 64))
            (icb-k (eq (kernel_stat 15) 2) 128)))
    (import-carry-pair))
