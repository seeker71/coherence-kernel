        let events = fmrc-record-deltas(window, deltas, outcome, ended, source, line, col);
        let finish = fmrc-end-node(window, outcome, ended, len(deltas), fmrc-delta-total(deltas), source, line, col);
        ["form-membrane-runtime-observation-v1", (Comparable) fmrc-window-current?(window) == 1 ? "observed" : "stale-map", window, outcome, ended, after, deltas, events, finish];
    };
    def fmrc-result-status(r) = r[1];
    def fmrc-result-deltas(r) = r[6];
    def fmrc-result-events(r) = r[7];
    0;
}
