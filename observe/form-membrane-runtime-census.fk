    def fmrc-delta-node(window, row, outcome, ended, source, line, col) = intern_node_at(bp("FRAMEBUFFER-MEMBRANE-CROSSING"), [intern_trivial_string("result"), intern_trivial_string(fmrc-window-trace(window)), intern_trivial_string(fmrc-window-purpose(window)), intern_trivial_string(fmrc-delta-name(row)), intern_trivial_int(fmrc-delta-tag(row)), intern_trivial_string(fmrc-delta-plane(row)), intern_trivial_int(fmrc-delta-count(row)), intern_trivial_int(fmrc-delta-before(row)), intern_trivial_int(fmrc-delta-after(row)), intern_trivial_int(ended - fmrc-window-started(window)), intern_trivial_string(outcome)], source, line, col);
    def fmrc-record-deltas(window, rows, outcome, ended, source, line, col) = nil?(rows) ? empty() : cons(fmrc-delta-node(window, rows[0], outcome, ended, source, line, col), fmrc-record-deltas(window, rows[1:], outcome, ended, source, line, col));
    def fmrc-end-node(window, outcome, ended, delta-count, dispatches, source, line, col) = intern_node_at(bp("FRAMEBUFFER-MEMBRANE-CROSSING"), [intern_trivial_string("end"), intern_trivial_string(fmrc-window-trace(window)), intern_trivial_string(fmrc-window-purpose(window)), intern_trivial_string(outcome), intern_trivial_int(ended), intern_trivial_int(ended - fmrc-window-started(window)), intern_trivial_int(delta-count), intern_trivial_int(dispatches), intern_trivial_int(fmrc-window-current?(window))], source, line, col);
    // result = schema status window outcome ended after deltas events end
    def fmrc-close(window, outcome, source, line, col) = {
