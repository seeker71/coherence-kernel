; form-membrane-runtime-census.fk -- live per-primitive crossings from fkwu.
;
; A wrapper can be bypassed.  The fourth arm cannot bypass its own dispatch
; counters: kernel_stat(100 + tag) reads the number of times that native tag
; actually fired.  This organ snapshots every currently-censused outward or
; carrier effect and emits one attributed framebuffer event for every row that
; moved inside a correlated window.  No command, prompt, model text, path,
; address, or returned payload enters the event; only identity, extent, time,
; purpose and outcome do.
;
; The rows are an observation of the temporary source-runner seed's generated
; dispatch map, not an operation table and never execution authority.  Its
; digest is pinned so a changed runtime map makes the census stale instead of
; silently retaining an old denominator.  `fmrc-registry-count` is computed
; from the fresh rows; no fixed target is claimed.
;
; Planes describe physical crossings, not moral rank:
;   stdio, filesystem, local-process, network-address-unknown, mesh,
;   metal-device, mlx-runtime, cpu-jit, cuda-device, physical-sense.
; A socket tag alone cannot say loopback or remote.  The correlated caller's
; purpose/surface observation supplies that fact.
;
; preludes: form-stdlib/core.fk form-stdlib/native-model-evidence.fk
; Proven by: observe/tests/form-membrane-runtime-census-band.fk

(do
    (defn fmrc-version () "form-membrane-runtime-census-v1")
    (defn fmrc-map-path () "runtime/fkwu-optable.h")
    (defn fmrc-map-sha ()
        "f08876fb04332c97d78b005aaeeab6fca7c4b3ebadcb5178af2a978fde220122")
    (defn fmrc-map-current? ()
        (if (lt (file_size (fmrc-map-path)) 0) 0
            (if (str_eq (nmfe-sha256 (read_file (fmrc-map-path)))
                    (fmrc-map-sha)) 1 0)))

    ; row = name, runtime tag, physical plane
    (defn fmrc-row (name tag plane) (list name tag plane))
    (defn fmrc-name (r) (nth r 0))
    (defn fmrc-tag (r) (nth r 1))
    (defn fmrc-plane (r) (nth r 2))

    ; One canonical name per dispatch tag.  Aliases intentionally do not
    ; duplicate a counter.  Observer-only tags (clock, kernel_stat, framebuffer)
    ; are excluded so observing a window does not manufacture its crossings.
    (defn fmrc-registry ()
        (list
            (fmrc-row "input_byte" 17 "stdio")
            (fmrc-row "read_line" 114 "stdio")
            (fmrc-row "print_str" 115 "stdio")
            (fmrc-row "isatty" 116 "stdio")
            (fmrc-row "self_source" 117 "stdio")
            (fmrc-row "form_error" 238 "stdio")
            (fmrc-row "print" 239 "stdio")

            (fmrc-row "host_dir_rmdir" 55 "filesystem")
            (fmrc-row "host_dir_mkdir" 56 "filesystem")
            (fmrc-row "host_path_exists" 57 "filesystem")
            (fmrc-row "host_path_remove" 58 "filesystem")
            (fmrc-row "host_path_rename" 59 "filesystem")
            (fmrc-row "host_file_size" 60 "filesystem")
            (fmrc-row "host_file_append_bytes" 61 "filesystem")
            (fmrc-row "host_file_read_slice" 62 "filesystem")
            (fmrc-row "host_file_read_text" 63 "filesystem")
            (fmrc-row "host_temp_dir" 101 "filesystem")
            (fmrc-row "host_file_write_text" 104 "filesystem")
            (fmrc-row "host_file_mtime" 107 "filesystem")
            (fmrc-row "host_dir_list" 132 "filesystem")
            (fmrc-row "file_open" 133 "filesystem")
            (fmrc-row "file_read" 134 "filesystem")
            (fmrc-row "file_close" 135 "filesystem")
            (fmrc-row "host_path_is_dir" 200 "filesystem")
            (fmrc-row "host_source_inventory" 202 "filesystem")

            (fmrc-row "host-exec" 136 "local-process")

            (fmrc-row "http_get" 105 "network-address-unknown")
            (fmrc-row "sock_request" 118 "network-address-unknown")
            (fmrc-row "tls_request" 119 "network-address-unknown")
            (fmrc-row "socket_listen" 120 "network-address-unknown")
            (fmrc-row "socket_port" 121 "network-address-unknown")
            (fmrc-row "socket_accept" 122 "network-address-unknown")
            (fmrc-row "socket_connect" 123 "network-address-unknown")
            (fmrc-row "socket_send" 124 "network-address-unknown")
            (fmrc-row "socket_recv" 125 "network-address-unknown")
            (fmrc-row "socket_close" 126 "network-address-unknown")
            (fmrc-row "api_health" 227 "network-address-unknown")

            (fmrc-row "mesh_serve" 224 "mesh")
            (fmrc-row "mesh_announce" 225 "mesh")
            (fmrc-row "mesh_discover" 226 "mesh")
            (fmrc-row "mesh_register" 228 "mesh")
            (fmrc-row "mesh_detect" 229 "mesh")
            (fmrc-row "mesh_registry" 230 "mesh")
            (fmrc-row "mesh_roster" 231 "mesh")

            (fmrc-row "metal_fence_wait" 142 "metal-device")
            (fmrc-row "metal_matvec_fixture" 203 "metal-device")
            (fmrc-row "metal_matvec_f32" 204 "metal-device")
            (fmrc-row "metal_pipeline" 245 "metal-device")
            (fmrc-row "metal_buf_alloc" 246 "metal-device")
            (fmrc-row "metal_buf_from_file" 247 "metal-device")
            (fmrc-row "metal_buf_write" 248 "metal-device")
            (fmrc-row "metal_enqueue" 249 "metal-device")
            (fmrc-row "metal_sync" 250 "metal-device")
            (fmrc-row "metal_buf_read" 251 "metal-device")
            (fmrc-row "metal_status" 252 "metal-device")
            (fmrc-row "metal_batch_concurrent" 253 "metal-device")
            (fmrc-row "metal_buf_free" 254 "metal-device")
            (fmrc-row "metal_submit" 255 "metal-device")

            (fmrc-row "mlx_status" 143 "mlx-runtime")
            (fmrc-row "mlx_add" 144 "mlx-runtime")
            (fmrc-row "mlx_run" 145 "mlx-runtime")

            (fmrc-row "jit_compile_value" 83 "cpu-jit")
            (fmrc-row "jit_leaf_inram" 146 "cpu-jit")
            (fmrc-row "jit_arm64_u32_leaf" 215 "cpu-jit")

            (fmrc-row "cuda_matvec" 232 "cuda-device")
            (fmrc-row "cuda_matvec_f32" 233 "cuda-device")

            (fmrc-row "sense_mic_stream_start" 139 "physical-sense")
            (fmrc-row "sense_mic_stream_read" 140 "physical-sense")
            (fmrc-row "sense_mic_stream_stop" 141 "physical-sense")
            (fmrc-row "sense_mic_count" 205 "physical-sense")
            (fmrc-row "sense_cam_count" 206 "physical-sense")
            (fmrc-row "sense_mic_name" 207 "physical-sense")
            (fmrc-row "sense_cam_name" 208 "physical-sense")
            (fmrc-row "sense_mic_health" 209 "physical-sense")
            (fmrc-row "sense_cam_health" 210 "physical-sense")
            (fmrc-row "sense_report" 211 "physical-sense")
            (fmrc-row "sense_cam_grab" 212 "physical-sense")
            (fmrc-row "sense_frame_read" 213 "physical-sense")
            (fmrc-row "sense_stream" 214 "physical-sense")
            (fmrc-row "sense_wifi_ssid" 216 "physical-sense")
            (fmrc-row "sense_wifi_signal" 217 "physical-sense")
            (fmrc-row "sense_bt_present" 218 "physical-sense")
            (fmrc-row "sense_bt_count" 219 "physical-sense")
            (fmrc-row "sense_power" 220 "physical-sense")
            (fmrc-row "sense_mem" 221 "physical-sense")
            (fmrc-row "sense_sensors" 222 "physical-sense")
            (fmrc-row "sense_publish" 223 "physical-sense")
            (fmrc-row "sense_mic_capture" 234 "physical-sense")
            (fmrc-row "sense_cam_luma" 235 "physical-sense")
            (fmrc-row "sense_audio_loopback" 236 "physical-sense")
            (fmrc-row "sense_wav_loopback" 237 "physical-sense")))

    (defn fmrc-registry-count () (len (fmrc-registry)))
    (defn fmrc-has-tag-go (rows tag)
        (if (nil? rows) 0
            (if (eq (fmrc-tag (head rows)) tag) 1
                (fmrc-has-tag-go (tail rows) tag))))
    (defn fmrc-unique-go (rows seen)
        (if (nil? rows) 1
            (if (eq (fmrc-has-tag-go seen (fmrc-tag (head rows))) 1) 0
                (fmrc-unique-go (tail rows) (cons (head rows) seen)))))
    (defn fmrc-registry-unique? ()
        (fmrc-unique-go (fmrc-registry) (empty)))

    ; snapshot row = name, tag, plane, dispatch count
    (defn fmrc-snapshot-go (rows)
        (if (nil? rows) (empty)
            (cons (list (fmrc-name (head rows))
                        (fmrc-tag (head rows))
                        (fmrc-plane (head rows))
                        (kernel_stat (add 100 (fmrc-tag (head rows)))))
                  (fmrc-snapshot-go (tail rows)))))
    (defn fmrc-snapshot () (fmrc-snapshot-go (fmrc-registry)))
    (defn fmrc-snap-name (r) (nth r 0))
    (defn fmrc-snap-tag (r) (nth r 1))
    (defn fmrc-snap-plane (r) (nth r 2))
    (defn fmrc-snap-count (r) (nth r 3))

    ; delta row = name, tag, plane, delta, before, after
    (defn fmrc-delta-row (before after)
        (list (fmrc-snap-name after) (fmrc-snap-tag after)
              (fmrc-snap-plane after)
              (sub (fmrc-snap-count after) (fmrc-snap-count before))
              (fmrc-snap-count before) (fmrc-snap-count after)))
    (defn fmrc-delta-name (r) (nth r 0))
    (defn fmrc-delta-tag (r) (nth r 1))
    (defn fmrc-delta-plane (r) (nth r 2))
    (defn fmrc-delta-count (r) (nth r 3))
    (defn fmrc-delta-before (r) (nth r 4))
    (defn fmrc-delta-after (r) (nth r 5))
    (defn fmrc-deltas-go (before after)
        (if (or (nil? before) (nil? after)) (empty)
            (do
                (let row (fmrc-delta-row (head before) (head after)))
                (let rest (fmrc-deltas-go (tail before) (tail after)))
                (if (gt (fmrc-delta-count row) 0) (cons row rest) rest))))
    (defn fmrc-deltas (before after) (fmrc-deltas-go before after))
    (defn fmrc-delta-total (rows)
        (if (nil? rows) 0
            (add (fmrc-delta-count (head rows))
                 (fmrc-delta-total (tail rows)))))
    (defn fmrc-delta-plane-total (rows plane)
        (if (nil? rows) 0
            (add (if (str_eq (fmrc-delta-plane (head rows)) plane)
                     (fmrc-delta-count (head rows)) 0)
                 (fmrc-delta-plane-total (tail rows) plane))))
    (defn fmrc-delta-has? (rows name)
        (if (nil? rows) 0
            (if (str_eq (fmrc-delta-name (head rows)) name) 1
                (fmrc-delta-has? (tail rows) name))))

    ; window = schema trace purpose source line col start current snapshot begin
    (defn fmrc-begin-node (trace purpose source line col started current count)
        (intern_node_at (bp "FRAMEBUFFER-MEMBRANE-CROSSING")
            (list (intern_trivial_string "begin")
                  (intern_trivial_string trace)
                  (intern_trivial_string purpose)
                  (intern_trivial_string "observer")
                  (intern_trivial_int started)
                  (intern_trivial_int current)
                  (intern_trivial_int count))
            source line col))
    (defn fmrc-open (trace purpose source line col)
        (do
            (let started (now_unix_ms))
            (let current (fmrc-map-current?))
            (let snapshot (fmrc-snapshot))
            (let begin (fmrc-begin-node trace purpose source line col started
                current (len snapshot)))
            (list "form-membrane-runtime-window-v1" trace purpose source
                  line col started current snapshot begin)))
    (defn fmrc-window-trace (w) (nth w 1))
    (defn fmrc-window-purpose (w) (nth w 2))
    (defn fmrc-window-started (w) (nth w 6))
    (defn fmrc-window-current? (w) (nth w 7))
    (defn fmrc-window-snapshot (w) (nth w 8))

    (defn fmrc-delta-node (window row outcome ended source line col)
        (intern_node_at (bp "FRAMEBUFFER-MEMBRANE-CROSSING")
            (list (intern_trivial_string "result")
                  (intern_trivial_string (fmrc-window-trace window))
                  (intern_trivial_string (fmrc-window-purpose window))
                  (intern_trivial_string (fmrc-delta-name row))
                  (intern_trivial_int (fmrc-delta-tag row))
                  (intern_trivial_string (fmrc-delta-plane row))
                  (intern_trivial_int (fmrc-delta-count row))
                  (intern_trivial_int (fmrc-delta-before row))
                  (intern_trivial_int (fmrc-delta-after row))
                  (intern_trivial_int (sub ended
                      (fmrc-window-started window)))
                  (intern_trivial_string outcome))
            source line col))
    (defn fmrc-record-deltas (window rows outcome ended source line col)
        (if (nil? rows) (empty)
            (cons (fmrc-delta-node window (head rows) outcome ended
                    source line col)
                  (fmrc-record-deltas window (tail rows) outcome ended
                    source line col))))
    (defn fmrc-end-node (window outcome ended delta-count dispatches source line col)
        (intern_node_at (bp "FRAMEBUFFER-MEMBRANE-CROSSING")
            (list (intern_trivial_string "end")
                  (intern_trivial_string (fmrc-window-trace window))
                  (intern_trivial_string (fmrc-window-purpose window))
                  (intern_trivial_string outcome)
                  (intern_trivial_int ended)
                  (intern_trivial_int (sub ended
                      (fmrc-window-started window)))
                  (intern_trivial_int delta-count)
                  (intern_trivial_int dispatches)
                  (intern_trivial_int (fmrc-window-current? window)))
            source line col))
    ; result = schema status window outcome ended after deltas events end
    (defn fmrc-close (window outcome source line col)
        (do
            (let ended (now_unix_ms))
            (let after (fmrc-snapshot))
            (let deltas (fmrc-deltas (fmrc-window-snapshot window) after))
            (let events (fmrc-record-deltas window deltas outcome ended
                source line col))
            (let finish (fmrc-end-node window outcome ended (len deltas)
                (fmrc-delta-total deltas) source line col))
            (list "form-membrane-runtime-observation-v1"
                  (if (eq (fmrc-window-current? window) 1)
                      "observed" "stale-map")
                  window outcome ended after deltas events finish)))
    (defn fmrc-result-status (r) (nth r 1))
    (defn fmrc-result-deltas (r) (nth r 6))
    (defn fmrc-result-events (r) (nth r 7))
    0)
