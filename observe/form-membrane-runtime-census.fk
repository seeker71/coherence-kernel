    def fmrc-registry-count() = len(fmrc-registry());
    def fmrc-has-tag-go(rows, tag) = nil?(rows) ? 0 : (Comparable) fmrc-tag(rows[0]) == tag ? 1 : fmrc-has-tag-go(rows[1:], tag);
    def fmrc-unique-go(rows, seen) = nil?(rows) ? 1 : (Comparable) fmrc-has-tag-go(seen, fmrc-tag(rows[0])) == 1 ? 0 : fmrc-unique-go(rows[1:], cons(rows[0], seen));
    def fmrc-registry-unique?() = fmrc-unique-go(fmrc-registry(), empty());
    // snapshot row = name, tag, plane, dispatch count
    def fmrc-snapshot-go(rows) = nil?(rows) ? empty() : cons([fmrc-name(rows[0]), fmrc-tag(rows[0]), fmrc-plane(rows[0]), kernel_stat((Number) 100 + (Number) fmrc-tag(rows[0]))], fmrc-snapshot-go(rows[1:]));
    def fmrc-snapshot() = fmrc-snapshot-go(fmrc-registry());
    def fmrc-snap-name(r) = r[0];
    def fmrc-snap-tag(r) = r[1];
    def fmrc-snap-plane(r) = r[2];
    def fmrc-snap-count(r) = r[3];
    // delta row = name, tag, plane, delta, before, after
    def fmrc-delta-row(before, after) = [fmrc-snap-name(after), fmrc-snap-tag(after), fmrc-snap-plane(after), fmrc-snap-count(after) - fmrc-snap-count(before), fmrc-snap-count(before), fmrc-snap-count(after)];
    def fmrc-delta-name(r) = r[0];
    def fmrc-delta-tag(r) = r[1];
    def fmrc-delta-plane(r) = r[2];
    def fmrc-delta-count(r) = r[3];
    def fmrc-delta-before(r) = r[4];
    def fmrc-delta-after(r) = r[5];
    def fmrc-deltas-go(before, after) = nil?(before) || nil?(after) ? empty() : {
        let row = fmrc-delta-row(before[0], after[0]);
        let rest = fmrc-deltas-go(before[1:], after[1:]);
        fmrc-delta-count(row) > 0 ? cons(row, rest) : rest;
    };
    def fmrc-deltas(before, after) = fmrc-deltas-go(before, after);
    // The complement of a delta: a registered crossing whose count did not move.
    // Stillness in one window is the reading. It is not yet a claim the organ is dead.
    def fmrc-still-go(before, after) = nil?(before) || nil?(after) ? empty() : {
        let row = fmrc-delta-row(before[0], after[0]);
        let rest = fmrc-still-go(before[1:], after[1:]);
        (Comparable) fmrc-delta-count(row) == 0 ? cons(row, rest) : rest;
    };
    def fmrc-still(before, after) = fmrc-still-go(before, after);
    def fmrc-delta-total(rows) = nil?(rows) ? 0 : (Number) fmrc-delta-count(rows[0]) + (Number) fmrc-delta-total(rows[1:]);
    def fmrc-delta-plane-total(rows, plane) = nil?(rows) ? 0 : (Number) ((String) fmrc-delta-plane(rows[0]) == plane ? fmrc-delta-count(rows[0]) : 0) + (Number) fmrc-delta-plane-total(rows[1:], plane);
    def fmrc-delta-has?(rows, name) = nil?(rows) ? 0 : (String) fmrc-delta-name(rows[0]) == name ? 1 : fmrc-delta-has?(rows[1:], name);
    // window = schema trace purpose source line col start current snapshot begin
    def fmrc-begin-node(trace, purpose, source, line, col, started, current, count) = intern_node_at(bp("FRAMEBUFFER-MEMBRANE-CROSSING"), [intern_trivial_string("begin"), intern_trivial_string(trace), intern_trivial_string(purpose), intern_trivial_string("observer"), intern_trivial_int(started), intern_trivial_int(current), intern_trivial_int(count)], source, line, col);
    def fmrc-open(trace, purpose, source, line, col) = {
        let started = now_unix_ms();
        let current = fmrc-map-current?();
