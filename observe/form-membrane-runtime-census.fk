    def fmrc-row(name, tag, plane) = [name, tag, plane];
    def fmrc-name(r) = r[0];
    def fmrc-tag(r) = r[1];
    def fmrc-plane(r) = r[2];
    // One canonical name per dispatch tag.  Aliases intentionally do not
    // duplicate a counter.  Observer-only tags (clock, kernel_stat, framebuffer)
    // are excluded so observing a window does not manufacture its crossings.
    def fmrc-registry() = [fmrc-row("input_byte", 17, "stdio"), fmrc-row("read_line", 114, "stdio"), fmrc-row("print_str", 115, "stdio"), fmrc-row("isatty", 116, "stdio"), fmrc-row("self_source", 117, "stdio"), fmrc-row("form_error", 238, "stdio"), fmrc-row("print", 239, "stdio"), fmrc-row("host_dir_rmdir", 55, "filesystem"), fmrc-row("host_dir_mkdir", 56, "filesystem"), fmrc-row("host_path_exists", 57, "filesystem"), fmrc-row("host_path_remove", 58, "filesystem"), fmrc-row("host_path_rename", 59, "filesystem"), fmrc-row("host_file_size", 60, "filesystem"), fmrc-row("host_file_append_bytes", 61, "filesystem"), fmrc-row("host_file_read_slice", 62, "filesystem"), fmrc-row("host_file_read_text", 63, "filesystem"), fmrc-row("host_temp_dir", 101, "filesystem"), fmrc-row("host_file_write_text", 104, "filesystem"), fmrc-row("host_file_mtime", 107, "filesystem"), fmrc-row("host_dir_list", 132, "filesystem"), fmrc-row("file_open", 133, "filesystem"), fmrc-row("file_read", 134, "filesystem"), fmrc-row("file_close", 135, "filesystem"), fmrc-row("host_path_is_dir", 200, "filesystem"), fmrc-row("host_source_inventory", 202, "filesystem"), fmrc-row("host-exec", 136, "local-process"), fmrc-row("http_get", 105, "network-address-unknown"), fmrc-row("sock_request", 118, "network-address-unknown"), fmrc-row("tls_request", 119, "network-address-unknown"), fmrc-row("socket_listen", 120, "network-address-unknown"), fmrc-row("socket_port", 121, "network-address-unknown"), fmrc-row("socket_accept", 122, "network-address-unknown"), fmrc-row("socket_connect", 123, "network-address-unknown"), fmrc-row("socket_send", 124, "network-address-unknown"), fmrc-row("socket_recv", 125, "network-address-unknown"), fmrc-row("socket_close", 126, "network-address-unknown"), fmrc-row("api_health", 227, "network-address-unknown"), fmrc-row("mesh_serve", 224, "mesh"), fmrc-row("mesh_announce", 225, "mesh"), fmrc-row("mesh_discover", 226, "mesh"), fmrc-row("mesh_register", 228, "mesh"), fmrc-row("mesh_detect"