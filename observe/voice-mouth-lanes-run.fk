// voice-mouth-lanes-run.fk — which of the body's tongues it renders ITSELF, and which have a voice
// and no native route yet; and, on request, one line spoken down the native lane.
//
// Every step of a line is the body's own: letters->phonemes from its tables (voice-g2p.bml), phoneme
// ids (voice-phoneme.bml), and the whole VITS on this Mac's own metal (voice-pass.bml). A tongue is
// native when its voice is on disk, reads espeak-style phonemes and the body holds tables for it;
// the four tongues whose voices read their own engine's phonemes (zh ja th he) and every tongue with
// no tables answer "no native mouth yet", and nothing else speaks for them.
//
// Reading only: it names the lanes and speaks nothing. Write a tongue code and a line into
// /tmp/voice-say-line (two lines) and it will speak that one down the native lane.
//
// preflight-exec: forbidden
import form/form-stdlib/voice-say.bml;
section [form.bml] {
    def vl-join(xs) = (Comparable) len(xs) == 0 ? "" : (xs[0] + ((String) ((Comparable) len(xs[1:]) == 0 ? "" : " ") + vl-join(xs[1:])));
    def vl-line(k, v) = print((k + ("  " + v)));
    def vl-ask() = {
        let t = read_file("/tmp/voice-say-line");
        nothing?(t) ? [] : split-on(t, byte_to_str(10));
    };
    def vl-at(xs, i) = len(xs) <= i ? "" : trim(nth(xs, i));
    vl-line("mouths", (vs-mouth-count().str() + " tongues have a voice on this disk"));
    vl-line("native", (vs-native-count().str() + (" render in the body: " + vl-join(vs-native-codes()))));
    vl-line("no native mouth yet", (len(vs-no-route-codes()).str() + (" have a voice and no native route: " + vl-join(vs-no-route-codes()))));
    print("");
    print("  nothing leaves the body on a native lane: letters->phonemes is the body's tables (taught");
    print("  lines and words, and the words its own T5 answered through the bridge), then the id row");
    print("  from the voice's table, the whole VITS on this Mac's metal, the samples turned to");
    print("  16-bit on the same device, and the air through the seed's own mouth at the voice's");
    print("  own rate.");
    let ask = vl-ask();
    (Comparable) len(ask) == 0 ? 0 : {
        let code = vl-at(ask, 0);
        let text = vl-at(ask, 1);
        (Comparable) len(code) == 0 ? 0 : {
            let t0 = now_unix_ms();
            let said = vs-say(code, text);
            print("");
            vl-line("said", said);
            vl-line("took", ((now_unix_ms() - t0).str() + " ms"));
            0;
        };
    };
    0;
}
