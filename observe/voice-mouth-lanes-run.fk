// voice-mouth-lanes-run.fk — which of the body's tongues it renders ITSELF, and which still
// leave whole; and, on request, one line spoken down the native lane.
//
// The pass came home on 2026-09-09: `voice-pass.bml` runs a whole VITS — text encoder, stochastic
// duration predictor, flow and HiFi-GAN vocoder — on this Mac's own metal, answering the same
// samples onnxruntime answers to six decimals. What is left crossing is letters->phonemes, and it
// is not the same crossing for every tongue: espeak-ng hands back a phoneme LIST for most of them,
// and four carry their own engine whose output the body cannot yet produce at all.
//
// Reading only: it names the lanes and speaks nothing. Write a tongue code and a line into
// /tmp/voice-say-line (two lines) and it will speak that one down the native lane.
//
// preflight-exec: forbidden
import form/form-stdlib/voice-say.bml;
section [form.bml] {
    def vl-join(xs) = (Comparable) len(xs) == 0 ? "" : (xs[0] + ((String) ((Comparable) len(xs[1:]) == 0 ? "" : " ") + vl-join(xs[1:])));
    def vl-line(k, v) = print((k + ("  " + v)));
    def vl-ask() = {
        let t = read_file("/tmp/voice-say-line");
        nothing?(t) ? [] : split-on(t, byte_to_str(10));
    };
    def vl-at(xs, i) = len(xs) <= i ? "" : trim(nth(xs, i));
    vl-line("mouths", (vs-mouth-count().str() + " tongues have a voice on this disk"));
    vl-line("native", (vs-native-count().str() + (" render in the body: " + vl-join(vs-native-codes()))));
    vl-line("crossing", (len(vs-crossing-codes()).str() + (" still leave whole (their own g2p engine): " + vl-join(vs-crossing-codes()))));
    print("");
    print("  what crosses on a native lane is letters->phonemes and nothing else — espeak-ng has");
    print("  no native twin in this body yet. Everything after it is the seed's own: the id row");
    print("  from the voice's table, the whole VITS on this Mac's metal, the samples turned to");
    print("  16-bit on the same device, and the air through the seed's own mouth at the voice's");
    print("  own rate.");
    let ask = vl-ask();
    (Comparable) len(ask) == 0 ? 0 : {
        let code = vl-at(ask, 0);
        let text = vl-at(ask, 1);
        (Comparable) len(code) == 0 ? 0 : {
            let t0 = now_unix_ms();
            let said = vs-say(code, text);
            print("");
            vl-line("said", said);
            vl-line("took", ((now_unix_ms() - t0).str() + " ms"));
            0;
        };
    };
    0;
}
