// framebuffer-runtime-observation.fk -- trace-first eyes over a real fkwu run.
//
// This is the kernel framebuffer, not a screen capture.  fkwu already counts
// every native operation (kernel_stat), carries a bounded ordered list of
// source-attributed nodes (framebuffer-events), and can recover each node's
// (file line col) with node_source.  This organ turns those native facts into
// one inspectable observation window answering:
//
//   what fired; where; who/which relation; why/which offer; when/how long;
//   dispatch, allocation and I/O cost; and the outcome.
//
// The runtime cannot yet emit a source row for every Form function dispatch.
// Callers therefore place attributed BEGIN/END markers around meaningful
// stages.  Everything between them is measured exactly by cumulative fkwu
// counters.  The counter delta includes the small observer cost and says so;
// an empty-window calibration makes that overhead measurable rather than
// invisible.  No C seed growth and no host script is involved.
//
// witnessed: 2026-07-20 -> native source rows + whole-window and per-stage
// clock/cost deltas on fkwu; native bottleneck selection over emitted events
import form/form-stdlib/core.fk;
section [form.bml] {
    def fbro-stat(key) = kernel_stat(key);
    // Operation counters use key 100 + tag; lower keys are aggregate gauges.
    def fbro-io-count() = sum([fbro-stat(155), fbro-stat(156), fbro-stat(157), fbro-stat(158), fbro-stat(159), fbro-stat(232), fbro-stat(243), fbro-stat(300), fbro-stat(242), fbro-stat(248), fbro-stat(315), fbro-stat(345), fbro-stat(346), fbro-stat(347), fbro-stat(348), fbro-stat(349), fbro-stat(350), fbro-stat(351), fbro-stat(352), fbro-stat(353), fbro-stat(354), fbro-stat(355), fbro-stat(160), fbro-stat(161), fbro-stat(162), fbro-stat(163), fbro-stat(204), fbro-stat(205), fbro-stat(207), fbro-stat(218), fbro-stat(219), fbro-stat(220), fbro-stat(221), fbro-stat(222), fbro-stat(223), fbro-stat(224), fbro-stat(225), fbro-stat(226), fbro-stat(233), fbro-stat(234), fbro-stat(235), fbro-stat(236), fbro-stat(302), fbro-stat(305), fbro-stat(306), fbro-stat(307), fbro-stat(308), fbro-stat(309), fbro-stat(310), fbro-stat(311), fbro-stat(312), fbro-stat(313), fbro-stat(314), fbro-stat(316), fbro-stat(317), fbro-stat(318), fbro-stat(319), fbro-stat(320), fbro-stat(321), fbro-stat(322), fbro-stat(323), fbro-stat(334), fbro-stat(335), fbro-stat(336), fbro-stat(337)]);
    // Snapshot shape: time, dispatches, distinct ops, hottest tag/count,
    // interned nodes, strings, arena cons cells, value-stack depth,
    // boxed floats, and observable I/O/sense dispatch count.
    def fbro-snapshot() = {
        let t = now_unix_ms();
        let distinct = fbro-stat(1);
        let hot-tag = fbro-stat(2);
        let hot-count = fbro-stat(3);
        let nodes = fbro-stat(4);
        let strings = fbro-stat(5);
        let arena = fbro-stat(6);
        let stack = fbro-stat(7);
        let floats = fbro-stat(8);
        let io = fbro-io-count();
        // Total last: the observation calls above are honestly in the window.
        let dispatches = fbro-stat(0);
        [t, dispatches, distinct, hot-tag, hot-count, nodes, strings, arena, stack, floats, io];
    };
    def fbro-snap-time(s) = s[0];
    def fbro-snap-dispatches(s) = s[1];
    def fbro-snap-nodes(s) = s[5];
    def fbro-snap-strings(s) = s[6];
    def fbro-snap-arena(s) = s[7];
    def fbro-snap-stack(s) = s[8];
    def fbro-snap-floats(s) = s[9];
    def fbro-snap-io(s) = s[10];
    // Marker payload is deliberately all trivial nodes so a Form observer can
    // recover it with node_children + node_value without a side schema.
    def fbro-marker(phase, trace-id, actor, relation, why, offer, stamp, file, line, col) = intern_node_at(bp("FRAMEBUFFER-RUNTIME-EVENT"), [intern_trivial_string(phase), intern_trivial_string(trace-id), intern_trivial_string(actor), intern_trivial_string(relation), intern_trivial_string(why), intern_trivial_string(offer), intern_trivial_int(stamp)], file, line, col);
    // A caller places one of these immediately after each expensive semantic
    // boundary.  causal-parent names the preceding stage; metric/value carry the
    // stage's own useful magnitude (bytes, parameters, rows, or world entries).
    def fbro-stage(trace-id, stage, causal-parent, actor, relation, why, offer, started, ended, metric, value, outcome, file, line, col) = intern_node_at(bp("FRAMEBUFFER-RUNTIME-STAGE"), [intern_trivial_string("stage"), intern_trivial_string(trace-id), intern_trivial_string(stage), intern_trivial_string(causal-parent), intern_trivial_string(actor), intern_trivial_string(relation), intern_trivial_string(why), intern_trivial_string(offer), intern_trivial_int(started), intern_trivial_int(ended), intern_trivial_int(ended - started), intern_trivial_string(metric), intern_trivial_int(value), intern_trivial_string(outcome)], file, line, col);
    // Resource-attributed stage marker.  `before` and `after` are genuine
    // fbro-snapshots around the work, so the stage carries exact deltas rather
    // than distributing the whole-run total by elapsed-time guesswork.  The
    // snapshot calls themselves are included consistently; event interning is
    // deliberately outside the measured stage and remains visible in the
    // enclosing whole-window report.
    def fbro-stage-observed(trace-id, stage, causal-parent, actor, relation, why, offer, before, after, metric, value, outcome, file, line, col) = intern_node_at(bp("FRAMEBUFFER-RUNTIME-STAGE-OBSERVED"), [intern_trivial_string("stage"), intern_trivial_string(trace-id), intern_trivial_string(stage), intern_trivial_string(causal-parent), intern_trivial_string(actor), intern_trivial_string(relation), intern_trivial_string(why), intern_trivial_string(offer), intern_trivial_int(fbro-snap-time(before)), intern_trivial_int(fbro-snap-time(after)), intern_trivial_int(fbro-snap-time(after) - fbro-snap-time(before)), intern_trivial_string(metric), intern_trivial_int(value), intern_trivial_string(outcome), intern_trivial_string("duration-ms"), intern_trivial_int(fbro-snap-time(after) - fbro-snap-time(before)), intern_trivial_string("dispatches"), intern_trivial_int(fbro-snap-dispatches(after) - fbro-snap-dispatches(before)), intern_trivial_string("interned-nodes"), intern_trivial_int(fbro-snap-nodes(after) - fbro-snap-nodes(before)), intern_trivial_string("string-pool"), intern_trivial_int(fbro-snap-strings(after) - fbro-snap-strings(before)), intern_trivial_string("arena-cons"), intern_trivial_int(fbro-snap-arena(after) - fbro-snap-arena(before)), intern_trivial_string("value-stack-depth"), intern_trivial_int(fbro-snap-stack(after) - fbro-snap-stack(before)), intern_trivial_string("boxed-floats"), intern_trivial_int(fbro-snap-floats(after) - fbro-snap-floats(before)), intern_trivial_string("io-sense-dispatches"), intern_trivial_int(fbro-snap-io(after) - fbro-snap-io(before))], file, line, col);
    def fbro-cat(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + fbro-cat(parts[1:]));
    def fbro-stage-stream-line(event) = {
        let values = fbro-node-values(node_children(event));
        fbro-cat(["FRAMEBUFFER STAGE trace=", values[1], " stage=", values[2], " parent=", values[3], " actor=", values[4], " relation=", values[5], " why=", values[6], " duration-ms=", values[10].str(), " dispatches=", fbro-event-number-at(values, "dispatches", 0).str(), " ", values[11], "=", values[12].str(), " arena-cons=", fbro-event-number-at(values, "arena-cons", 0).str(), " boxed-floats=", fbro-event-number-at(values, "boxed-floats", 0).str(), " io-sense=", fbro-event-number-at(values, "io-sense-dispatches", 0).str(), " outcome=", values[13]]);
    };
    def fbro-stage-observed-stream(trace-id, stage, causal-parent, actor, relation, why, offer, before, after, metric, value, outcome, file, line, col) = {
        let event = fbro-stage-observed(trace-id, stage, causal-parent, actor, relation, why, offer, before, after, metric, value, outcome, file, line, col);
        print_str(fbro-stage-stream-line(event));
        event;
    };
    // Window = metadata + initial native snapshot + attributed BEGIN node.
    def fbro-open(trace-id, actor, relation, why, offer, input-bytes, file, line, col) = {
        framebuffer-clear();
        let before = fbro-snapshot();
        let begin = fbro-marker("begin", trace-id, actor, relation, why, offer, fbro-snap-time(before), file, line, col);
        ["framebuffer-window", trace-id, actor, relation, why, offer, input-bytes, file, line, col, before, begin];
    };
    def fbro-open-stream(trace-id, actor, relation, why, offer, input-bytes, file, line, col) = {
        let window = fbro-open(trace-id, actor, relation, why, offer, input-bytes, file, line, col);
        print_str(fbro-cat(["FRAMEBUFFER BEGIN trace=", trace-id, " actor=", actor, " relation=", relation, " why=", why, " offer=", offer, " source=", file, ":", line.str(), ":", col.str(), " input-bytes=", input-bytes.str()]));
        window;
    };
    def fbro-window-before(w) = w[10];
    def fbro-window-begin(w) = w[11];
    def fbro-source-row(node) = {
        let source = node_source(node);
        (Comparable) len(source) == 3 ? source : ["", 0, 0];
    };
    def fbro-node-values(kids) = (Comparable) len(kids) == 0 ? empty() : cons(node_value(kids[0]), fbro-node-values(kids[1:]));
    def fbro-event-row(node) = ["framebuffer-event", fbro-source-row(node), node_type(node_category(node)), fbro-node-values(node_children(node))];
    def fbro-event-rows(nodes) = (Comparable) len(nodes) == 0 ? empty() : cons(fbro-event-row(nodes[0]), fbro-event-rows(nodes[1:]));
    // Read one named numeric value from an event payload.  The resource fields
    // are name/value pairs so future counters can be appended without moving the
    // stable stage identity/duration fields at indexes 2 and 10.
    def fbro-event-number-at(values, label, i) = i >= len(values) ? -1 : (Value) nth(values, i) == label && (Number) i + (Number) 1 < len(values) ? nth(values, (Number) i + (Number) 1) : fbro-event-number-at(values, label, (Number) i + (Number) 1);
    def fbro-event-number(event, label) = len(event) >= 4 ? fbro-event-number-at(event[3], label, 0) : -1;
    def fbro-event-stage(event) = len(event) >= 4 && len(event[3]) >= 3 ? event[3][2] : "";
    // Return (metric value stage event) for the largest observed stage.  BEGIN,
    // END and legacy stage rows lack the named resource and are skipped.  This is
    // the trace-first focus selector used before deciding what to optimize.
    def fbro-bottleneck-go(events, metric, best-value, best-stage, best-event) = (Comparable) len(events) == 0 ? [metric, best-value, best-stage, best-event] : {
        let event = events[0];
        let value = fbro-event-number(event, metric);
        value > best-value ? fbro-bottleneck-go(events[1:], metric, value, fbro-event-stage(event), event) : fbro-bottleneck-go(events[1:], metric, best-value, best-stage, best-event);
    };
    def fbro-bottleneck(report, metric) = fbro-bottleneck-go(fbro-events(report), metric, -1, "", empty());
    def fbro-last-event(events) = (Comparable) len(events) == 1 ? events[0] : fbro-last-event(events[1:]);
    def fbro-observed-stage-count(events) = (Comparable) len(events) == 0 ? 0 : (Number) (fbro-event-number(events[0], "dispatches") >= 0 ? 1 : 0) + (Number) fbro-observed-stage-count(events[1:]);
    // Production admission contract: a result may call itself trace-first only
    // when its report proves an attributed BEGIN, at least one resource-observed
    // STAGE, an END, matching event count, actor/reason/source, time, outcome and
    // nonzero whole-window work.  This does not prove semantic correctness; it
    // proves the observation plane actually preceded the claim.
    def fbro-trace-first?(report) = len(report) < 10 ? 0 : {
        let events = fbro-events(report);
        let first-values = len(events) > 0 ? events[0][3] : empty();
        let last-values = len(events) > 0 ? fbro-last-event(events)[3] : empty();
        let resources = fbro-resources(report);
        (String) report[0] == "framebuffer-runtime-observation" && (len(events) >= 3 && ((Comparable) fbro-what(report)[3] == len(events) && ((String) first-values[0] == "begin" && ((String) last-values[0] == "end" && (fbro-observed-stage-count(events) > 0 && ((Comparable) len(fbro-where(report)[1]) == 3 && ((Comparable) ((String) fbro-with(report)[1] == "") == 0 && ((Comparable) ((String) fbro-why(report)[1] == "") == 0 && (fbro-when(report)[5] >= 0 && (fbro-event-number-at(resources, "dispatches", 0) > 0 && (Comparable) ((String) fbro-outcome(report)[1] == "") == 0)))))))))) ? 1 : 0;
    };
    def fbro-resource-delta(before, after, input-bytes, output-units) = ["resources", "dispatches", fbro-snap-dispatches(after) - fbro-snap-dispatches(before), "interned-nodes", fbro-snap-nodes(after) - fbro-snap-nodes(before), "string-pool", fbro-snap-strings(after) - fbro-snap-strings(before), "arena-cons", fbro-snap-arena(after) - fbro-snap-arena(before), "boxed-floats", fbro-snap-floats(after) - fbro-snap-floats(before), "io-sense-dispatches", fbro-snap-io(after) - fbro-snap-io(before), "input-bytes", input-bytes, "output-units", output-units, "observer-overhead", "included; calibrate-with-empty-window"];
    // Report fields remain direct data, not prose hidden in a receipt.
    def fbro-close(window, outcome, output-units, file, line, col) = {
        let after-work = fbro-snapshot();
        let finish = fbro-marker("end", window[1], window[2], window[3], window[4], window[5], fbro-snap-time(after-work), file, line, col);
        let events = framebuffer-events();
        let before = fbro-window-before(window);
        ["framebuffer-runtime-observation", ["what", window[1], "events", len(events)], ["where", fbro-source-row(fbro-window-begin(window)), fbro-source-row(finish)], ["with", window[2], "relation", window[3]], ["why", window[4], "causal-parent-offer", window[5]], ["when", fbro-snap-time(before), "ended", fbro-snap-time(after-work), "duration-ms", fbro-snap-time(after-work) - fbro-snap-time(before)], fbro-resource-delta(before, after-work, window[6], output-units), ["outcome", outcome], fbro-event-rows(events), ["native", "fkwu-kernel-stat+framebuffer-events+node_source", "per-function-dispatch-source", 0, "honest-floor", "explicit source markers + exact whole-window counters"]];
    };
    def fbro-close-stream(window, outcome, output-units, file, line, col) = {
        let report = fbro-close(window, outcome, output-units, file, line, col);
        let resources = fbro-resources(report);
        print_str(fbro-cat(["FRAMEBUFFER END trace=", fbro-what(report)[1], " duration-ms=", fbro-when(report)[5].str(), " dispatches=", fbro-event-number-at(resources, "dispatches", 0).str(), " boxed-floats=", fbro-event-number-at(resources, "boxed-floats", 0).str(), " io-sense=", fbro-event-number-at(resources, "io-sense-dispatches", 0).str(), " outcome=", outcome]));
        report;
    };
    def fbro-what(r) = r[1];
    def fbro-where(r) = r[2];
    def fbro-with(r) = r[3];
    def fbro-why(r) = r[4];
    def fbro-when(r) = r[5];
    def fbro-resources(r) = r[6];
    def fbro-outcome(r) = r[7];
    def fbro-events(r) = r[8];
}
