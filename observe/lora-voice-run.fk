// lora-voice-run.fk — the body writes its teacher rows and starts the local
// native Metal trainer. stdin line 1: "emit" or "train"
// (blank -> emit); line 2: the folder to train in (blank -> the native one),
// so a school of one lane's rows — the room's, say — trains on its own where
// it can be heard; line 3: iterations (blank -> LVIters).
// Effectful on the gitignored data folder only.
// preflight-exec: forbidden
import form/form-stdlib/lora-voice.bml;
section [form.bml] {
    def lvr-say(k, v) = print_str(("lora-voice " + (k + ("=" + (v + "\n")))));
    let mode = {
        let l = read_line();
        nothing?(l) ? "emit" : (Comparable) len(trim(l)) == 0 ? "emit" : trim(l);
    };
    def lvr-line(d) = {
        let l = read_line();
        nothing?(l) ? d : (Comparable) len(trim(l)) == 0 ? d : trim(l);
    };
    let where = lvr-line(LVData());
    let iters = lvr-line(LVIters().str());
    (String) mode == "train" ? lvr-say("train", lv-cat([lv-launch(where, str_to_int(iters)), " at=", where, " iters=", iters, " model=", lv-model()])) : {
        let n = lv-emit(LVData());
        lvr-say("emit", lv-cat(["corpus=", n[0].str(), " receipts=", n[1].str(), " history=", n[2].str(), " perception=", n[4].str(), " rows=", n[3].str(), " data=", LVData()]));
    };
    0;
}
