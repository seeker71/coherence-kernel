; lora-voice-run.fk — the body writes its teacher rows and starts the local
; trainer (the one membrane crossing left). stdin line 1: "emit" or "train"
; (blank -> emit). Effectful on the gitignored data folder only.
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-voice.bml
(do
    (defn lvr-say (k v) (print_str (str_concat "lora-voice " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (let mode (do (let l (read_line)) (if (nothing? l) "emit" (if (eq (str_len (trim l)) 0) "emit" (trim l)))))
    (if (str_eq mode "train")
        (lvr-say "train" (str_concat (lv-launch (LVData) (LVIters)) (str_concat " model=" (lv-model))))
        (do (let n (lv-emit (LVData)))
            (lvr-say "emit" (lv-cat (list "corpus=" (int_to_str (nth n 0)) " receipts=" (int_to_str (nth n 1)) " rows=" (int_to_str (nth n 2)) " data=" (LVData))))))
    0)
