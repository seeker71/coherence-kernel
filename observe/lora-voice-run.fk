; lora-voice-run.fk — the body writes its teacher rows and starts the local
; native Metal trainer. stdin line 1: "emit" or "train"
; (blank -> emit); line 2: the folder to train in (blank -> the native one),
; so a school of one lane's rows — the room's, say — trains on its own where
; it can be heard; line 3: iterations (blank -> LVIters).
; Effectful on the gitignored data folder only.
; preflight-exec: forbidden
; preludes: form/form-stdlib/lora-voice.bml
(do
    (defn lvr-say (k v) (print_str (str_concat "lora-voice " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (let mode (do (let l (read_line)) (if (nothing? l) "emit" (if (eq (str_len (trim l)) 0) "emit" (trim l)))))
    (defn lvr-line (d) (do (let l (read_line)) (if (nothing? l) d (if (eq (str_len (trim l)) 0) d (trim l)))))
    (let where (lvr-line (LVData)))
    (let iters (lvr-line (int_to_str (LVIters))))
    (if (str_eq mode "train")
        (lvr-say "train" (lv-cat (list (lv-launch where (str_to_int iters)) " at=" where " iters=" iters " model=" (lv-model))))
        (do (let n (lv-emit (LVData)))
            (lvr-say "emit" (lv-cat (list "corpus=" (int_to_str (nth n 0)) " receipts=" (int_to_str (nth n 1)) " history=" (int_to_str (nth n 2)) " perception=" (int_to_str (nth n 4)) " rows=" (int_to_str (nth n 3)) " data=" (LVData))))))
    0)
