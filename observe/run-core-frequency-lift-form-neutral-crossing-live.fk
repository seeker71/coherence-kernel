; Printable live rows for the form-neutral crossing.
import "../cognition/core-frequency-lift-form-neutral-crossing.fk"

(do
  (defn fncl-line (p)
    (str_concat (fnc-p-locale p)
      (str_concat " surface="
        (str_concat (fnc-p-surface p)
          (str_concat " source="
            (str_concat (fnc-p-source-code p)
              (str_concat " state="
                (str_concat (fnc-p-state p)
                  (str_concat " residue="
                    (str_concat (int_to_str (fnc-p-residue p)) "\n"))))))))))
  (defn fncl-lines (rows)
    (if (eq (len rows) 0) ""
      (str_concat (fncl-line (head rows)) (fncl-lines (tail rows)))))
  (let runtime (cnl13-runtime-open))
  (fncl-lines (fnc-nl-required-projections runtime)))
