; form-glass-deadline-cadence-live-run.fk — physical ordinary-frame cadence.
;
; The untimed admission below acquires the rows that Glass deliberately holds.
; Each measured frame then runs the same changing collectors, inventory,
; observation, control, dimensions, and dashboard construction as the resident.
; No fabricated sample or model name enters this witness.
;
; preludes: form/form-stdlib/form-glass-live.bml

(defn fgdcl-model-ids (samples)
    (if (eq (len samples) 0)
        (list)
        (if (str_eq (fgtm-sample-kind (head samples)) "model")
            (cons (fgtm-sample-id (head samples)) (fgdcl-model-ids (tail samples)))
            (fgdcl-model-ids (tail samples)))))

(defn fgdcl-frame (hz frame heldHost heldQueue heldStorage heldHeat)
  (do
    (let started (now_unix_ms))
    (let heatRows (fgl-heat-rows frame heldHeat))
    (let fastRows (fgl-fast-rows frame (list) heatRows))
    (let hostRows (fgl-host-rows frame heldHost))
    (let queueRows (fgl-queue-rows frame heldQueue))
    (let storageRows (fgl-storage-rows frame heldStorage))
    (let metrics (append fastRows (append hostRows (append queueRows storageRows))))
    (let governorRefresh (fgl-refresh-governor frame))
    (let epoch (now_unix_ms))
    (let inventory (fgtm-inventory (FGLRoot)))
    (let externalSamples (fgl-external-samples (fgl-inventory-samples-at inventory epoch)))
    (let samples (fgl-local-samples externalSamples epoch))
    (let publishers (fgl-external-publishers (fgl-inventory-publishers inventory)))
    (let observations (fgl-v2-observations epoch frame))
    (let point (fgl-flow-point-current-full epoch metrics observations samples))
    (let history (list point))
    (let control (fgl-control-start-state (fgtm-read-control-ack (FGLRoot) (FGLControlChannel))))
    (let width (fgl-terminal-width))
    (let height (fgl-terminal-height))
    (let glassFrame (fgl-dashboard-frame width height epoch hz frame control metrics samples publishers history observations))
    (let workEnded (now_unix_ms))
    (let workMs (fgl-frame-elapsed-ms started workEnded))
    (let budgetMs (fgl-frame-budget-ms hz))
    (let waitTargetMs (fgl-frame-wait-ms hz started workEnded))
    (let slept (fgl-sleep-ms waitTargetMs))
    (let waitEnded (now_unix_ms))
    (let waitMs (fgl-frame-elapsed-ms workEnded waitEnded))
    (let cycleMs (fgl-frame-elapsed-ms started waitEnded))
    (list "physical-glass-ordinary-frame-v1"
          "hz" hz "frame" frame "budget-ms" budgetMs
          "work-ms" workMs "wait-target-ms" waitTargetMs
          "wait-actual-ms" waitMs "cycle-ms" cycleMs
          "deadline-met" (and (ge cycleMs (sub budgetMs 10)) (le cycleMs (add budgetMs 75)))
          "metrics" (len metrics) "samples" (len samples)
          "models" (fgdcl-model-ids samples)
          "width" width "height" height
          "segments" (len (fgd-segment-frame-lines glassFrame)))))

(do
    (let heldHost (fgl-host-rows 0 (list)))
    (let heldQueue (fgl-queue-rows 0 (list)))
    (let heldStorage (fgl-storage-rows 0 (list)))
    (let heldHeat (fgl-heat-rows 0 (list)))
    (list (fgdcl-frame (FGLActiveHz) 1 heldHost heldQueue heldStorage heldHeat)
          (fgdcl-frame (FGLQuietHz) 2 heldHost heldQueue heldStorage heldHeat)))
