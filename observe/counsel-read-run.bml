// counsel-read-run.bml — the door: a draft reply in, the moves and claims a reader sees in it out, and what the
// counsel reads over them. A reading beside the draft before it is offered; it holds nothing back and decides nothing.
//
//   printf '%s\n%s\n' "$MODEL" "$REPLY" | ./fkwu observe/counsel-read-run.bml
//
// stdin: line 1 the model — "0" takes the lines after it as a reader's own answer lines (a person's reading, or a
// fixture), blank asks the registry's answer model to read the reply, a registry id asks that one; every line after
// is the reply. The reader answers in lines: move <kind> <1|0> and claim <who> <lane>
// (cognition/difficult-conversation-counsel.fk: dcc-moves-read, dcc-claims-read, dcc-read-lands?).
// Prints the rows read and the reading; appends one CounselReadRow to receipts/counsel-read-ledger.jsonl.
// The rows are the reader's, not the reply's truth: a voice's reading, a person's reading and the person's own
// answer are separate evidence (teachings/difficult-conversations.md).
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk cognition/dialogue-covenant.fk cognition/difficult-conversation-counsel.fk form-stdlib/bml/form-cli-native-voice.bml form-stdlib/bml/ledger.bml
section [form.bml] {
 blueprint CounselReadRow { at_unix_ms: int, bytes_in: int, moves: int, claims: int, lands: int, reader: string }
 class CounselReadRun {
  def crr-ledger() = "receipts/counsel-read-ledger.jsonl";
  def crr-line() { let l = read_line(); nothing?(l) ? "" : trim(l); }
  def crr-rest-go(acc) { let l = read_line(); nothing?(l) ? acc : crr-rest-go(acc ++ l ++ "\n"); }
  def crr-packet(reply) = dc-card-core() ++ "\nRead this reply as it stands. For each move you read in it, write one line: move, the kind, then 1 or 0, with one space between them. The kinds are advise, miss, flatter, elevate, stretch, receive, play, rest, disagree. Write 1 when the move stands on a source the reply names or on the person's own words, and 0 when it stands on nothing shown. For each claim the reply makes about a person, write one line: claim, then self (the one asking) or other (someone not in the room), then observed, reported, inferred or imagined. Write those lines only.\n\nThe reply:\n" ++ reply;
  def crr-ask(reply, flag) = fcnv-ask(crr-packet(reply), (Comparable) len(flag) == 0 ? json-node-object([]) : json-node-object([oh-s("model", flag)]));
  def crr-answer(reply, flag) {
   let asked = (String) flag == "0" ? ["answered", reply] : crr-ask(reply, flag);
   (String) asked[0] == "answered" ? trim(asked[1]) : "";
  }
  def crr-move-lines(ms) = foldl((a, m) => a ++ "  move " ++ dc-kind(m) ++ " " ++ dc-grounded(m).str() ++ "\n", "", ms);
  def crr-claim-lines(cs) = foldl((a, c) => a ++ "  claim " ++ dcc-claim-who(c) ++ " " ++ dcc-claim-lane(c) ++ "\n", "", cs);
  def crr-run() {
   let flag = crr-line();
   let reply = trim(crr-rest-go(""));
   let answer = crr-answer(reply, flag);
   let moves = dcc-moves-read(answer);
   let claims = dcc-claims-read(answer);
   let lands = dcc-read-lands?(answer) ? 1 : 0;
   let said = print_str("[counsel-read] " ++ len(reply).str() ++ " bytes in · moves " ++ len(moves).str() ++ " · claims " ++ len(claims).str() ++ " · the counsel reads " ++ lands.str() ++ " over the reader's rows · reader " ++ ((String) flag == "0" ? "given" : "voice"));
   let shown = nil?(moves) && nil?(claims) ? 0 : print_str(crr-move-lines(moves) ++ crr-claim-lines(claims));
   let kept = ledger-append(crr-ledger(), CounselReadRow{at_unix_ms: now_unix_ms(), bytes_in: len(reply), moves: len(moves), claims: len(claims), lands: lands, reader: (String) flag == "0" ? "given" : "voice"});
   0;
  }
 }
 crr-run();
}
