// self-distill-run.bml — the walk's door to the voice's own frontier row (form-stdlib/bml/self-distill.bml): one finding, one ask, one judged candidate.
//   ./fkwu observe/self-distill-run.bml </dev/null
// stdin, optional, one JSON line: candidates, ledger, corpus, lexicon, proof, turns, register (paths in place of the defaults), reply (a band's stand-in; no model opens), until_ms (host_monotonic_ms the ask must fit before).
// Prints one [self-distill] line: admitted, refused by name, held, or why no voice was asked. Exit 0 for each of them: a refusal is a reading.
// preflight-exec: forbidden
import form-stdlib/bml/self-distill.bml;
section [form.bml] {
 sd-run(dop-doc(sd-door(), stdin-text(), sd-spec()));
 0;
}
