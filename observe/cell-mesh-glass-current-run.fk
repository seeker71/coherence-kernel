; cell-mesh-glass-current-run.fk — one bounded frame of the living Form
; Glass focused on the mesh: the same collectors, inventory and renderer
; as the resident dashboard, never a second dashboard process. The mesh
; rows arrive through the telemetry bus (publishers cell-channel.<name>
; and cell-mesh) tagged `mesh`, so the focus shows them and nothing else.
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let frame (fgl-bounded-current-frame-focus "overview" "mesh" 120 40))
    (print_str (fgd-segment-project frame))
    0)
