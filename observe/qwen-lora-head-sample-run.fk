; qwen-lora-head-sample-run.fk — one small fully adapted local text sample.
;
; Effectful: opens Qwen3.8 Q8 on local Metal.  Each decoded token takes the
; q38-forward-adapted path; the printed text is evidence to evaluate, never a
; self-promotion.  Do not preflight.
; preludes: form/form-stdlib/qwen-lora-head.fk form/form-stdlib/form-cli-model-generate.fk form/form-stdlib/model-registry.bml

(do
    (defn qlhs-prompt () "Say home.")
    (defn qlhs-cap () 2)
    (defn qlhs-receipt-path () ".form-qwen-lora-head-sample.txt")
    (let path (mr-path (mr-find "qwen38-q8")))
    (let artifact (qlh-path))
    (qlh-write artifact (qlh-source))
    (let adapter (qlh-admit artifact))
    (let admitted (qlh-admitted? adapter))
    (let src (fcmg-src path))
    ; Keep this one-token probe outside the teaching overlay so the route
    ; itself, not prompt scaffolding, is what the receipt measures.
    (let ids (q35-chat-ids src (qlhs-prompt)))
    (let ctx (q38-open path (add (len ids) (qlhs-cap))))
    (if (if (eq admitted 0) 1 (lt (len ctx) 10))
        (do (print (list "qwen-lora-sample" "refused" 1 "voice-home" 0)) (qlh-close adapter) 0)
        (do
            (let sts (q38-new-state (nth ctx 2)))
            (let stops (list (gmt-u32 src "tokenizer.ggml.eos_token_id")))
            (let prefill (q38-prefill-adapted
                (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                (nth ctx 4) (nth ctx 5) (nth ctx 6) adapter ids 0))
            (let first (nth prefill 0))
            (let rest (if (if (lt first 0) 1 (q38-stop? first stops)) (empty)
                (q38-generate-adapted
                    (nth ctx 0) (nth ctx 1) (nth ctx 2) (nth ctx 3) sts
                    (nth ctx 4) (nth ctx 5) (nth ctx 6) adapter first (nth prefill 1)
                    (sub (qlhs-cap) 1) stops (empty))))
            (let out (if (if (lt first 0) 1 (q38-stop? first stops)) (empty) (cons first rest)))
            (let text (tkz-decode-text src out))
            (let saved (write_file (qlhs-receipt-path) text))
            (let closed (q38-close ctx sts))
            (let released (qlh-close adapter))
            (framebuffer-clear)
            (fb_record (intern_trivial_string "qwen-lora-head-local-sample")
                       "form/native/metal/qwen35-dense-token-handle.fk" (if (gt (len out) 0) 1 0))
            (print (list "qwen-lora-sample" "adapted-tokens" (len out)
                         "device-admitted" admitted "released" (if (gt released 0) 1 0)
                         "receipt-bytes" (file_size (qlhs-receipt-path))
                         "voice-home" 0 "events" (len (framebuffer-events))))
            (print_str text)
            (print_str "\n")
            (if (gt (len out) 0) 1 0))))
