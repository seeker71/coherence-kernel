; Bounded compiler diagnostic for the Form-emitted Q5_K candidate.
; preludes: form/form-stdlib/qk-matvec-lane.fk form/form-stdlib/metal-door.fk

(do
    (let unit (str_concat (qml-msl-header)
        (qml-q5k-quant1-msl "form_q5k_matvec_quant1_f32")))
    (let pipe (metal_pipeline unit "form_q5k_matvec_quant1_f32"))
    (list "q5k-quant-space-compile" pipe (metal_status)))
