// nvr-corpus-live.fk — watch the eight sources, and the empty summaries.
//
import form-stdlib/core.fk;
import form-stdlib/native-vs-rented.fk;
import observe/nvr-metric.fk;
import observe/nvr-corpus.fk;
section [form.bml] {
    print("nvrc-live sources=");
    print(len(nvrc-seed()).str());
    print(" complete=");
    print(nvrc-complete-n(nvrc-seed()).str());
    print(" ready=");
    print(nvrc-ready?(nvrc-seed()).str());
    print("\n");
    print("nvrc-live src0=");
    print(nvrc-src(nvrc-seed()[0]));
    print("\n");
    print("nvrc-live check=");
    print(nvrc-check().str());
    print("\n");
    0;
}
