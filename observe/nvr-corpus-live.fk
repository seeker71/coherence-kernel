; nvr-corpus-live.fk — watch the eight sources, and the empty summaries.
;
; preludes: form-stdlib/core.fk observe/native-vs-rented.fk observe/nvr-metric.fk observe/nvr-corpus.fk

(do
    (print "nvrc-live sources=")
    (print (int_to_str (len (nvrc-seed))))
    (print " complete=")
    (print (int_to_str (nvrc-complete-n (nvrc-seed))))
    (print " ready=")
    (print (int_to_str (nvrc-ready? (nvrc-seed))))
    (print "\n")
    (print "nvrc-live src0=")
    (print (nvrc-src (head (nvrc-seed))))
    (print "\n")
    (print "nvrc-live check=")
    (print (int_to_str (nvrc-check)))
    (print "\n")
    0)
