; native-model-dual-resident-live-run.fk — one long-lived Form process with
; physical Qwen3.8 Flash Next and Llama 3.2 3B contexts simultaneously open.
; preflight-exec: forbidden
;
; Startup physically opens and prefills both models, then returns to Qwen for
; one append-only prefix-reuse evaluation while the 3B stays resident.  The process
; polls an atomic Form filesystem ingress at 4 Hz for `heartbeat`, `status`,
; `qwen-step`, `3b-step`, or `quit`.  Idle polls do not render, intern, or
; serialize a snapshot; state publishes at start, explicit inspection, and
; before/after real model work while a separate observer owns PID liveness.
; A completed turn never closes either context.  An explicitly offered quit
; closes both contexts; ordinary idle cadence is never an eviction event.
;
; preludes: form/form-stdlib/qwen4exp-flash-next-generate.bml form/form-stdlib/llama32-3b-resident-state.bml form/form-stdlib/native-model-glass.bml form/form-stdlib/native-model-resident-fleet.bml form/form-stdlib/native-model-memory-glass.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml form/form-stdlib/native-model-owner-cadence.bml

(do
    (defn nmdr-qwen-prefix ()
        "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-")
    (defn nmdr-threeb-path ()
        "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff")
    (defn nmdr-qwen-id () "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
    (defn nmdr-qwen-weights-id () "weights.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
    (defn nmdr-qwen-experts-id () "experts.qwen3.8-flash-next.ud-q2_k_xl.unsloth")
    (defn nmdr-qwen-kv-id () "state.qwen3.8-flash-next.ud-q2_k_xl.unsloth.kv")
    (defn nmdr-qwen-token-id () "tokens.qwen3.8-flash-next.ud-q2_k_xl.unsloth.position")
    (defn nmdr-qwen-loaded-id () "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.loaded")
    (defn nmdr-qwen-prefilled-id () "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.prefilled")
    (defn nmdr-qwen-active-id () "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.active")
    (defn nmdr-qwen-mapped-id () "mapped.qwen3.8-flash-next")
    (defn nmdr-qwen-materialized-id () "materialized.qwen3.8-flash-next")
    (defn nmdr-threeb-id () "model.llama-3.2-3b-instruct")
    (defn nmdr-threeb-weights-id () "weights.llama-3.2-3b-instruct")
    (defn nmdr-threeb-kv-id () "state.llama-3.2-3b-instruct.kv")
    (defn nmdr-threeb-token-id () "tokens.llama-3.2-3b-instruct.position")
    (defn nmdr-threeb-loaded-id () "state.model.llama-3.2-3b-instruct.loaded")
    (defn nmdr-threeb-prefilled-id () "state.model.llama-3.2-3b-instruct.prefilled")
    (defn nmdr-threeb-active-id () "state.model.llama-3.2-3b-instruct.active")
    (defn nmdr-threeb-mapped-id () "mapped.llama-3.2-3b")
    (defn nmdr-threeb-materialized-id () "materialized.llama-3.2-3b")
    (defn nmdr-threeb-prompt () (list 128000 791 6864 315 9822 374))
    (defn nmdr-telemetry-root () "/tmp/form-glass-telemetry")
    (defn nmdr-publisher (instance) (nmdt-owner-publisher instance))
    (defn nmdr-self-pid ()
        (do
            ; host-exec's child shell names its Form owner as PPID.  Refuse a
            ; missing or malformed carrier answer rather than publish PID 0.
            (let text (host-exec "printf '%s' \"$PPID\"" ""))
            (if (eq (fgtm-uint-text? text) 1) (str_to_int text) 0)))

    (defn nmdr-lifecycle (session id)
        (do
            (let model (nmg-find id (nmg-models session)))
            (if (eq (len model) 0) "unknown"
                (if (eq (nmg-active? model) 1) "active"
                    (if (str_eq (nmg-phase model) "prefill") "prefilling"
                        (if (eq (nmg-prefilled? model) 1) "ready"
                            (if (eq (nmg-loaded? model) 1) "allocated" "released")))))))

    (defn nmdr-threeb-reasoning (session contextTokens)
        (nmg-observed session (NMGThreeB) 1 1 1 "decode" contextTokens
            "3b-resident-token-evaluate-entered" "none" "3b-reasoning"))

    (defn nmdr-callable-sample (id source session handle readEpoch writeEpoch owner)
        (nmdt-callable-sample id owner (nmdr-lifecycle session source) handle
            readEpoch writeEpoch))

    (defn nmdr-model-extent-samples (mappedId materializedId parent owner epoch)
        (list
            (nmdt-missing-extent-sample mappedId parent owner "mapped-bytes"
                "per-model-mapped-bytes" epoch
                "model.carrier-per-model-mapped-bytes")
            (nmdt-missing-extent-sample materializedId parent owner
                "materialized-bytes" "per-model-materialized-bytes" epoch
                "model.carrier-per-model-materialized-bytes")))

    (defn nmdr-weight-sample (id parent bytes readEpoch)
        (nmdt-weight-catalog id parent bytes readEpoch))

    (defn nmdr-open-artifact-samples (identities paths parent owner handle openEpoch source)
        (if (or (eq (len identities) 0) (eq (len paths) 0)) (list)
            (cons
                (nmdt-open-artifact-sample
                    (nmtl-artifact-identity-id (head identities)) parent owner
                    (head paths) handle openEpoch source
                    (list "process" "model" "memory" "tensor" "metal" "gpu" "health"))
                (nmdr-open-artifact-samples (tail identities) (tail paths)
                    parent owner handle openEpoch source))))

    (defn nmdr-budget-sample (budget)
        (nmdt-budget-sample budget))

    (defn nmdr-substate-sample (id parent kind purpose session source handle readEpoch writeEpoch channels)
        (nmdt-derived-substate id parent kind purpose
            (nmdr-lifecycle session source) handle readEpoch writeEpoch channels))

    (defn nmdr-token-sample (id parent position session source handle accessEpoch)
        (nmdt-token-position id parent position (nmdr-lifecycle session source)
            handle accessEpoch))

    ; State clocks retain the last transition of each independent bit.  A
    ; decode changes active, but does not pretend loaded/prefilled changed too.
    (defn nmdr-state-samples (model-id loadedId prefilledId activeId source session handle clock owner)
        (do
            (let model (nmg-find source (nmg-models session)))
            (if (eq (len model) 0) (list)
                (list
                    (nmdt-model-state-sample-owned loadedId model-id owner
                        "loaded" (nmg-loaded? model) handle
                        (nmdt-state-loaded-epoch clock))
                    (nmdt-model-state-sample-owned prefilledId model-id owner
                        "prefilled" (nmg-prefilled? model) handle
                        (nmdt-state-prefilled-epoch clock))
                    (nmdt-model-state-sample-owned activeId model-id owner
                        "active" (nmg-active? model) handle
                        (nmdt-state-active-epoch clock))))))

    (defn nmdr-status-counter (status key id kind plane owner lane purpose epoch source channels)
        (do
            (let value (nmdt-status-int status key))
            (if (lt value 0)
                (nmdt-owner-missing-sample id kind plane owner lane purpose epoch source channels)
                (nmdt-owner-counter-sample id kind plane owner lane purpose value epoch source channels))))

    (defn nmdr-owner-runtime-samples (owner epoch)
        (do
            (let status (metal_status))
            (let mlx (mlx_status))
            (list
                (nmdt-owner-counter-sample "primitive.owner.dispatch-total"
                    "primitive-counter" "form" owner "primitive"
                    "runtime-work-including-observer-cost" (kernel_stat 0) epoch
                    "fkwu.kernel-stat-0" (list "process" "model" "primitive" "cpu" "health"))
                (nmdt-owner-counter-sample "primitive.owner.dispatch-distinct"
                    "primitive-counter" "form" owner "primitive"
                    "runtime-surface-in-use" (kernel_stat 1) epoch
                    "fkwu.kernel-stat-1" (list "process" "model" "primitive" "cpu" "health"))
                (nmdt-owner-counter-sample "primitive.owner.hottest-tag"
                    "primitive-counter" "form" owner "primitive"
                    "current-owner-hotspot-tag" (kernel_stat 2) epoch
                    "fkwu.kernel-stat-2" (list "process" "model" "primitive" "cpu" "health"))
                (nmdt-owner-counter-sample "primitive.owner.hottest-count"
                    "primitive-counter" "form" owner "primitive"
                    "current-owner-hotspot-calls" (kernel_stat 3) epoch
                    "fkwu.kernel-stat-3" (list "process" "model" "primitive" "cpu" "health"))
                (nmdt-owner-counter-sample "jit.owner.compile-dispatch"
                    "jit-counter" "form" owner "jit" "compile-call-impact"
                    (kernel_stat 183) epoch "fkwu.kernel-stat-183"
                    (list "process" "model" "jit" "cpu" "health"))
                (nmdt-owner-counter-sample "jit.owner.leaf-inram-dispatch"
                    "jit-counter" "form" owner "jit" "inram-leaf-call-impact"
                    (kernel_stat 246) epoch "fkwu.kernel-stat-246"
                    (list "process" "model" "jit" "cpu" "health"))
                (nmdt-owner-counter-sample "jit.owner.arm64-dispatch"
                    "jit-counter" "form" owner "jit" "arm64-call-impact"
                    (kernel_stat 315) epoch "fkwu.kernel-stat-315"
                    (list "process" "model" "jit" "cpu" "health"))
                (nmdt-metal-counter status "jit.owner.metal-dispatch"
                    "jit-counter" "jit" "cpu-jit-fallback-calls"
                    "cpu_jit_dispatch" "metal_status.cpu_jit_dispatch" owner epoch
                    (list "process" "model" "jit" "cpu" "health"))
                (nmdt-metal-counter status "jit.owner.metal-busy-us"
                    "jit-counter" "jit" "cpu-jit-fallback-cost-us"
                    "cpu_jit_busy_us_total" "metal_status.cpu_jit_busy_us_total"
                    owner epoch (list "process" "model" "jit" "cpu" "health"))
                (nmdt-metal-counter status "metal.owner.in-flight"
                    "metal-gauge" "metal" "submitted-command-batches"
                    "in_flight" "metal_status.in_flight" owner epoch
                    (list "process" "model" "metal" "gpu" "health"))
                (nmdt-metal-counter status "metal.owner.buffers"
                    "metal-gauge" "memory" "allocated-metal-buffer-handles"
                    "buffers" "metal_status.buffers" owner epoch
                    (list "process" "model" "memory" "metal" "gpu" "tensor" "health"))
                (nmdt-metal-counter status "cache.owner.metal-pipelines"
                    "pipeline-cache" "cache" "compiled-metal-pipeline-handles"
                    "pipelines" "metal_status.pipelines" owner epoch
                    (list "process" "model" "cache" "metal" "health"))
                (nmdt-metal-counter status "mapping.owner.mmap-buffer-handles"
                    "mapping-counter" "memory" "mmap-no-copy-buffer-handles"
                    "mmap_nocopy_buffers" "metal_status.mmap_nocopy_buffers"
                    owner epoch (list "process" "model" "memory" "metal" "health"))
                (nmdt-metal-counter status "metal.owner.dispatch-total"
                    "metal-counter" "metal" "submitted-metal-dispatches"
                    "total_dispatch" "metal_status.total_dispatch" owner epoch
                    (list "process" "model" "metal" "gpu" "health"))
                (nmdt-metal-counter status "metal.owner.sync-total"
                    "metal-counter" "metal" "completed-metal-synchronizations"
                    "total_sync" "metal_status.total_sync" owner epoch
                    (list "process" "model" "metal" "gpu" "health"))
                (nmdt-metal-counter status "gpu.owner.busy-us-total"
                    "gpu-counter" "gpu" "command-buffer-device-time-us"
                    "gpu_busy_us_total" "metal_status.gpu_busy_us_total" owner epoch
                    (list "process" "model" "metal" "gpu" "health"))
                (nmdr-status-counter mlx "mlx_ops" "mlx.owner.ops"
                    "mlx-capability" "mlx" owner "mlx" "available-mlx-operation-surface"
                    epoch "mlx_status.mlx_ops"
                    (list "process" "model" "mlx" "gpu" "health"))
                (nmdr-status-counter mlx "mlx_dispatch" "mlx.owner.dispatch-total"
                    "mlx-counter" "mlx" owner "mlx" "owner-process-mlx-dispatches"
                    epoch "mlx_status.mlx_dispatch"
                    (list "process" "model" "mlx" "gpu" "health"))
                (nmdt-owner-missing-sample "cache.owner.walk-stats"
                    "walk-cache" "form" owner "cache" "hit-miss-and-age"
                    epoch "fkwu.walk-cache-stats"
                    (list "process" "model" "cache" "health"))
                (nmdt-owner-missing-sample "jit.owner.stage-duration"
                    "jit-duration" "form" owner "jit" "per-stage-duration"
                    epoch "fkwu.jit-stats"
                    (list "process" "model" "jit" "cpu" "health"))
                (nmdt-owner-missing-sample "memory.owner.ephemeral-render-string"
                    "runtime-memory" "form" owner "memory"
                    "per-publication-temporary-string-reclaim" epoch
                    "kernel.ephemeral-render-string"
                    (list "process" "model" "memory" "health"))
                (nmdt-owner-nodeid-seam owner epoch))))

    (defn nmdr-publish (qslot three session fleet qhandle thandle publisher started incarnation heartbeatId ownerPid sequence qAccess tAccess qStateClock tStateClock artifactSamples)
        (do
            (let epoch (now_unix_ms))
            (let correlation (nmdt-owner-correlation publisher
                ownerPid started incarnation sequence epoch))
            (let modelSamples (append (list
                (nmdr-callable-sample (nmdr-qwen-id) (NMGQwen) session qhandle qAccess qAccess publisher)
                (nmdr-weight-sample (nmdr-qwen-weights-id) (nmdr-qwen-id) (NMRFQwenBytes) qAccess)
                (nmdr-substate-sample (nmdr-qwen-experts-id) (nmdr-qwen-id) "expert-pack" "moe-route" session (NMGQwen) qhandle qAccess qAccess (list "memory" "model" "metal" "gpu" "expert" "query-lane"))
                (nmdr-substate-sample (nmdr-qwen-kv-id) (nmdr-qwen-id) "kv-substate" "attention-state" session (NMGQwen) qhandle qAccess qAccess (list "memory" "model" "metal" "gpu" "substate" "query-lane"))
                (nmdr-token-sample (nmdr-qwen-token-id) (nmdr-qwen-id) (q4s-pos qslot) session (NMGQwen) qhandle qAccess)
                (nmdr-callable-sample (nmdr-threeb-id) (NMGThreeB) session thandle tAccess tAccess publisher)
                (nmdr-weight-sample (nmdr-threeb-weights-id) (nmdr-threeb-id) (NMRFThreeBBytes) tAccess)
                (nmdr-substate-sample (nmdr-threeb-kv-id) (nmdr-threeb-id) "kv-substate" "attention-state" session (NMGThreeB) thandle tAccess tAccess (list "memory" "model" "metal" "gpu" "substate" "query-lane"))
                (nmdr-token-sample (nmdr-threeb-token-id) (nmdr-threeb-id) (l3rs-position three) session (NMGThreeB) thandle tAccess))
                (append
                    (nmdr-model-extent-samples (nmdr-qwen-mapped-id)
                        (nmdr-qwen-materialized-id) (nmdr-qwen-id) publisher epoch)
                    (nmdr-model-extent-samples (nmdr-threeb-mapped-id)
                        (nmdr-threeb-materialized-id) (nmdr-threeb-id) publisher epoch))))
            (let stateSamples (append
                    (nmdr-state-samples (nmdr-qwen-id) (nmdr-qwen-loaded-id)
                        (nmdr-qwen-prefilled-id) (nmdr-qwen-active-id)
                    (NMGQwen) session qhandle qStateClock publisher)
                (nmdr-state-samples (nmdr-threeb-id) (nmdr-threeb-loaded-id)
                    (nmdr-threeb-prefilled-id) (nmdr-threeb-active-id)
                    (NMGThreeB) session thandle tStateClock publisher)))
            (if (not (eq (nmdt-owner-correlation? correlation) 1))
                (list "glass-publish-v1" "refused" "owner-correlation")
                (do
                    (let runtimeSamples (nmdr-owner-runtime-samples publisher epoch))
                    (let tensorGroups (append
                            (q4t-ledger-groups (q4s-ctx qslot) (nmdr-qwen-id)
                                publisher epoch)
                            (l3rs-ledger-groups three (nmdr-threeb-id)
                                publisher epoch)))
                    (let tensorSamples (append
                        (nmdt-tensor-group-samples tensorGroups)
                        (nmdt-tensor-reconcile-samples tensorGroups
                            (metal_status) publisher epoch)))
                    (let publishedSamples (append (list (nmdt-owner-heartbeat-sample-at correlation heartbeatId))
                        (append modelSamples (append artifactSamples
                            (append stateSamples (append runtimeSamples (append tensorSamples
                                (list (nmdr-budget-sample (nmrf-budget fleet))))))))))
                    (fgtm-publish-snapshot (nmdr-telemetry-root)
                        publisher epoch publishedSamples)))))

    (defn nmdr-publish-state (qslot three session fleet qhandle thandle publisher started incarnation heartbeatId ownerPid sequence qAccess tAccess qStateClock tStateClock artifactSamples)
        (do
            (let published (nmdr-publish qslot three session fleet qhandle thandle
                publisher started incarnation heartbeatId ownerPid sequence
                qAccess tAccess qStateClock tStateClock artifactSamples))
            (let _memory-frame (nmmg-write-quiet fleet session
                (q4s-pos qslot) (l3rs-position three)))
            published))

    (defn nmdr-release-sample (id closed epoch)
        (nmdt-release-tombstone id closed epoch))

    (defn nmdr-publish-release (publisher qclosed tclosed)
        (do
            (let epoch (now_unix_ms))
            (fgtm-publish-snapshot (nmdr-telemetry-root)
                publisher epoch (list
                    (nmdr-release-sample (nmdr-qwen-id) qclosed epoch)
                    (nmdr-release-sample (nmdr-threeb-id) tclosed epoch)))))

    (defn nmdr-status (qslot three session fleet qhandle thandle)
        (do
            (let _qframe (nmg-glass-write-physical session (NMGQwen) qhandle
                "resident-turnwheel-status"))
            (let _tframe (nmg-glass-write-physical session (NMGThreeB) thandle
                "resident-turnwheel-status"))
            (let _memory-map (nmmg-write fleet session
                (q4s-pos qslot) (l3rs-position three)))
            (let pressure (nmrf-pressure-plan fleet 0 (list)))
            (print (list "native-model-dual-resident-status"
                "loaded" (nmrf-loaded-count (nmrf-rows fleet))
                "prefilled" (nmrf-prefilled-count (nmrf-rows fleet))
                "logical-weight-bytes" (nmrf-resident-bytes (nmrf-rows fleet))
                "budget-bytes" (nmrf-budget fleet)
                "pressure-needed" (nth pressure 1)
                "pressure-evictions" (len (nth pressure 3))
                "qwen-position" (q4s-pos qslot)
                "threeb-position" (l3rs-position three)
                "qwen-handle" qhandle "threeb-handle" thandle))
            1))

    (defn nmdr-close (qslot three session qhandle thandle publisher reason)
        (do
            (let qclosed (q4s-close qslot))
            (let tclosed (l3rs-close three))
            (let qreleased (if (eq qclosed 1)
                (nmg-release session (NMGQwen)) session))
            (let _qframe (if (eq qclosed 1)
                (nmg-glass-write-physical-release qreleased (NMGQwen)
                    qhandle qclosed) 0))
            (let treleased (if (eq tclosed 1)
                (nmg-release qreleased (NMGThreeB)) qreleased))
            (let _tframe (if (eq tclosed 1)
                (nmg-glass-write-physical-release treleased (NMGThreeB)
                    thandle tclosed) 0))
            (let _tombstone (nmdr-publish-release publisher qclosed tclosed))
            (list "native-model-dual-resident-closed" reason
                "qwen-close" qclosed "threeb-close" tclosed)))

    (defn nmdr-loop (qslot three session fleet qhandle thandle publisher started incarnation heartbeatId ownerPid sequence qAccess tAccess qStateClock tStateClock artifactSamples)
        (do
            (let _door (if (eq sequence 1)
                (print (list "native-model-owner-command-door"
                    (nmdoc-command-path publisher)
                    "cadence-ms" 250)) 0))
            (let polled (nmdoc-poll-command publisher))
            (if (str_eq (nmdoc-command-status polled) "waiting")
                (do
                    (let _wait (host-exec "/bin/sleep 0.25" ""))
                    (nmdr-loop qslot three session fleet qhandle thandle publisher
                        started incarnation heartbeatId ownerPid (add sequence 1)
                        qAccess tAccess qStateClock tStateClock artifactSamples))
                (do
                (let command (nmdoc-command-value polled))
                (if (str_eq command "quit")
                (nmdr-close qslot three session qhandle thandle publisher "quit")
                (if (str_eq command "heartbeat")
                    (do
                        (let _heartbeat-state (nmdr-publish-state qslot three session fleet
                            qhandle thandle publisher started incarnation heartbeatId ownerPid
                            sequence qAccess tAccess qStateClock tStateClock artifactSamples))
                        (print (list "native-model-owner-heartbeat" "publisher"
                            publisher "pid" ownerPid "sequence" sequence))
                        (nmdr-loop qslot three session fleet qhandle thandle publisher
                            started incarnation heartbeatId ownerPid (add sequence 1)
                            qAccess tAccess qStateClock tStateClock artifactSamples))
                (if (str_eq command "status")
                    (do
                        (let _status-state (nmdr-publish-state qslot three session fleet
                            qhandle thandle publisher started incarnation heartbeatId ownerPid
                            sequence qAccess tAccess qStateClock tStateClock artifactSamples))
                        (nmdr-status qslot three session fleet qhandle thandle)
                        (nmdr-loop qslot three session fleet qhandle thandle publisher
                            started incarnation heartbeatId ownerPid (add sequence 1)
                            qAccess tAccess qStateClock tStateClock artifactSamples))
                    (if (str_eq command "qwen-step")
                        (do
                            (let activeEpoch (now_unix_ms))
                            (let active (nmg-qwen-reasoning session (q4s-pos qslot)))
                            (let qActiveStateClock
                                (nmdt-state-active-at qStateClock activeEpoch))
                            (let _active-frame (nmg-glass-write-physical active
                                (NMGQwen) qhandle "resident-decode-entered"))
                            (let _active-telemetry (nmdr-publish-state qslot three active fleet
                                qhandle thandle publisher started incarnation heartbeatId ownerPid
                                (add sequence 1) activeEpoch tAccess
                                qActiveStateClock tStateClock artifactSamples))
                            (let next (q4s-evaluate-one qslot (q4s-output qslot)))
                            (let done (nmg-qwen-finished active (q4s-pos next)))
                            (let _done-frame (nmg-glass-write-physical done
                                (NMGQwen) qhandle "resident-decode-returned"))
                            (let nextFleet (nmrf-touch fleet (NMGQwen)))
                            (let doneEpoch (now_unix_ms))
                            (let qDoneStateClock
                                (nmdt-state-active-at qActiveStateClock doneEpoch))
                            (let _done-telemetry (nmdr-publish-state next three done nextFleet
                                qhandle thandle publisher started incarnation heartbeatId ownerPid
                                (add sequence 2) doneEpoch tAccess
                                qDoneStateClock tStateClock artifactSamples))
                            (print (list "qwen-step" "input" (q4s-prev1 next)
                                "output" (q4s-output next) "position" (q4s-pos next)))
                            (nmdr-loop next three done nextFleet qhandle thandle publisher
                                started incarnation heartbeatId ownerPid (add sequence 2)
                                doneEpoch tAccess qDoneStateClock tStateClock artifactSamples))
                        (if (str_eq command "3b-step")
                            (do
                                (let activeEpoch (now_unix_ms))
                                (let active (nmdr-threeb-reasoning session
                                    (l3rs-position three)))
                                (let tActiveStateClock
                                    (nmdt-state-active-at tStateClock activeEpoch))
                                (let _active-frame (nmg-glass-write-physical active
                                    (NMGThreeB) thandle "resident-decode-entered"))
                                (let _active-telemetry (nmdr-publish-state qslot three active fleet
                                    qhandle thandle publisher started incarnation heartbeatId ownerPid
                                    (add sequence 1) qAccess activeEpoch
                                    qStateClock tActiveStateClock artifactSamples))
                                (let next (l3rs-step three))
                                (let done (nmg-threeb-finished active
                                    (l3rs-position next)))
                                (let _done-frame (nmg-glass-write-physical done
                                    (NMGThreeB) thandle "resident-decode-returned"))
                                (let nextFleet (nmrf-touch fleet (NMGThreeB)))
                                (let doneEpoch (now_unix_ms))
                                (let tDoneStateClock
                                    (nmdt-state-active-at tActiveStateClock doneEpoch))
                                (let _done-telemetry (nmdr-publish-state qslot next done nextFleet
                                    qhandle thandle publisher started incarnation heartbeatId ownerPid
                                    (add sequence 2) qAccess doneEpoch
                                    qStateClock tDoneStateClock artifactSamples))
                                (print (list "3b-step" "text" (l3rs-pending-text three)
                                    "next" (l3rs-pending next)
                                    "position" (l3rs-position next)))
                                (nmdr-loop qslot next done nextFleet qhandle thandle publisher
                                    started incarnation heartbeatId ownerPid (add sequence 2)
                                    qAccess doneEpoch qStateClock tDoneStateClock artifactSamples))
                            (do
                                (print (list "owner-command-ingress"
                                    (nmdoc-command-status polled) command))
                                (nmdr-loop qslot three session fleet qhandle thandle publisher
                                    started incarnation heartbeatId ownerPid (add sequence 1)
                                    qAccess tAccess qStateClock tStateClock artifactSamples)))))))))))

    (defn nmdr-after-threeb (qsrc qresult qsession qhandle qStateClock qArtifactSamples three thandle started publisher incarnation heartbeatId ownerPid)
        (do
            (let tloaded (nmg-threeb-loaded qsession))
            (let tLoadedEpoch (now_unix_ms))
            (let tArtifactSamples (nmdr-open-artifact-samples
                (nmtl-layout-profile-artifact (nmtl-llama-layout-profile))
                (list (l3rs-path three)) (nmdr-threeb-id) publisher
                thandle tLoadedEpoch "l3rs.open-path-file-stat"))
            (let artifactSamples (append qArtifactSamples tArtifactSamples))
            (let _tloaded-frame (nmg-glass-write-physical tloaded
                (NMGThreeB) thandle "weight-open-returned"))
            (let tprefilling (nmg-threeb-prefilling tloaded 0))
            (let _tprefill-frame (nmg-glass-write-physical tprefilling
                (NMGThreeB) thandle "prefix-evaluate-entered"))
            (let tprefilled (l3rs-prefill three (nmdr-threeb-prompt)))
            (let tdone (nmg-threeb-finished tprefilling (l3rs-position tprefilled)))
            (let tDoneEpoch (now_unix_ms))
            (let tStateClock
                (nmdt-state-clock tLoadedEpoch tDoneEpoch tDoneEpoch))
            (let _tdone-frame (nmg-glass-write-physical tdone
                (NMGThreeB) thandle "prefill-returned"))
            (let qslot (q4x-result-slot qresult))
            (let incoming (append (q4s-tokens qslot) (list 11)))
            (let qactive (nmg-qwen-reasoning tdone (q4s-pos qslot)))
            (let _qactive-frame (nmg-glass-write-physical qactive
                (NMGQwen) qhandle "retained-prefix-append-entered"))
            (let appended (q4s-evaluate qslot incoming))
            (let qnext (q4s-result-slot appended))
            (let qdone (nmg-qwen-finished qactive (q4s-pos qnext)))
            (let qDoneEpoch (now_unix_ms))
            (let qCurrentStateClock
                (nmdt-state-active-at qStateClock qDoneEpoch))
            (let _qdone-frame (nmg-glass-write-physical qdone
                (NMGQwen) qhandle "retained-prefix-append-returned"))
            (let fleet (nmrf-dual-resident qhandle thandle))
            (let noPressure (nmrf-pressure-plan fleet 0 (list)))
            (print (list "native-model-dual-resident-started"
                "qwen-handle" qhandle "threeb-handle" thandle
                "loaded" (nmrf-loaded-count (nmrf-rows fleet))
                "prefilled" (nmrf-prefilled-count (nmrf-rows fleet))
                "logical-weight-bytes" (nmrf-resident-bytes (nmrf-rows fleet))
                "budget-bytes" (nmrf-budget fleet)
                "qwen-prefix-status" (q4s-result-status appended)
                "qwen-reused" (q4s-result-reused appended)
                "qwen-evaluated" (q4s-result-evaluated appended)
                "threeb-first" (l3rs-pending tprefilled)
                "threeb-text" (l3rs-pending-text tprefilled)
                "pressure-evictions" (len (nth noPressure 3))))
            (let qAccess (now_unix_ms))
            (let tAccess (now_unix_ms))
            (let _initial-state (nmdr-publish-state qnext tprefilled qdone fleet
                qhandle thandle publisher started incarnation heartbeatId ownerPid
                1 qAccess tAccess qCurrentStateClock tStateClock artifactSamples))
            (nmdr-loop qnext tprefilled qdone fleet qhandle thandle publisher
                started incarnation heartbeatId ownerPid 1 qAccess tAccess
                qCurrentStateClock tStateClock artifactSamples)))

    (defn nmdr-open-threeb (qsrc qresult qsession qhandle qStateClock qArtifactSamples started publisher incarnation heartbeatId ownerPid)
        (do
            (let tloading (nmg-threeb-loading qsession))
            (let _tloading-frame (nmg-glass-write tloading))
            (let three (l3rs-open (nmdr-threeb-path) 128))
            (let thandle (l3rs-residency-handle three))
            (if (eq (l3rs-resident? three) 1)
                (nmdr-after-threeb qsrc qresult tloading qhandle qStateClock
                    qArtifactSamples three thandle started publisher incarnation heartbeatId
                    ownerPid)
                (do
                    (let tclosed (l3rs-close three))
                    (let qclosed (q4x-close qresult))
                    (list "native-model-dual-resident-refused"
                        "threeb-handle" thandle "threeb-close" tclosed
                        "qwen-close" qclosed)))))

    (defn nmdr-after-qwen (src slot loading qhandle started publisher incarnation heartbeatId ownerPid)
        (do
            (let qloaded (nmg-qwen-loaded loading))
            (let qLoadedEpoch (now_unix_ms))
            (let qArtifactSamples (nmdr-open-artifact-samples
                (nmtl-layout-profile-artifact (nmtl-qwen-layout-profile))
                (q4t-paths (q4s-prefix slot)) (nmdr-qwen-id) publisher
                qhandle qLoadedEpoch "q4s.open-path-file-stat"))
            (let _qloaded-frame (nmg-glass-write-physical qloaded
                (NMGQwen) qhandle "weight-open-returned"))
            (let ids (q4tk-chat-ids src "Return only the word Form."))
            (let qprefilling (nmg-qwen-prefilling qloaded 0))
            (let _qprefill-frame (nmg-glass-write-physical qprefilling
                (NMGQwen) qhandle "prefix-evaluate-entered"))
            (let prefill (q4s-evaluate slot ids))
            (let resident (q4s-result-slot prefill))
            (let qreason (nmg-qwen-reasoning qprefilling (q4s-pos resident)))
            (let qPrefilledEpoch (now_unix_ms))
            (let _qreason-frame (nmg-glass-write-physical qreason
                (NMGQwen) qhandle "prefill-returned"))
            (let result (q4x-from-prefill src prefill 1 (len ids)))
            (let qdone (nmg-qwen-finished qreason
                (q4s-pos (q4x-result-slot result))))
            (let qActiveEpoch (now_unix_ms))
            (let qStateClock
                (nmdt-state-clock qLoadedEpoch qPrefilledEpoch qActiveEpoch))
            (let _qdone-frame (nmg-glass-write-physical qdone
                (NMGQwen) qhandle "generation-returned-retained"))
            (print (list "qwen-seed-answer" (q4x-result-text result)
                "tokens" (len ids) "position"
                (q4s-pos (q4x-result-slot result))))
            (nmdr-open-threeb src result qdone qhandle qStateClock qArtifactSamples started
                publisher incarnation heartbeatId ownerPid)))

    (framebuffer-clear)
    (let instance (now_unix_ms))
    (let publisher (nmdr-publisher instance))
    (let incarnation (nmdt-owner-incarnation instance))
    (let heartbeatId (nmdt-owner-heartbeat-id-from-incarnation incarnation))
    (let ownerPid (nmdr-self-pid))
    (if (le ownerPid 0)
        (list "native-model-dual-resident-refused"
            "reason" "owner-pid-unavailable-before-model-open")
        (do
            (let native (nmg-begin-native (nmg-initial)))
            (let selected (nmg-finish-native native "request-evidence"))
            (let loading (nmg-qwen-loading selected))
            (let _loading-frame (nmg-glass-write loading))
            (let prefix (nmdr-qwen-prefix))
            (let src (eqr-of-file (str_concat prefix "00001-of-00003.gguf") 0 12000000))
            (let slot (q4s-open prefix 128))
            (let qhandle (q4s-residency-handle slot))
            (if (eq (q4s-resident? slot) 1)
                (nmdr-after-qwen src slot loading qhandle instance publisher
                    incarnation heartbeatId ownerPid)
                (do
                    (let closed (q4s-close slot))
                    (list "native-model-dual-resident-refused" "qwen-handle"
                        qhandle "qwen-close" closed))))))
