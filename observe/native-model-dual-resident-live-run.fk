// native-model-dual-resident-live-run.fk — one long-lived Form process with
// physical Qwen3.8 Flash Next and Llama 3.2 3B contexts simultaneously open.
// preflight-exec: forbidden
//
// Startup physically opens and prefills both models, then returns to Qwen for
// one append-only prefix-reuse evaluation while the 3B stays resident.  The process
// polls an atomic Form filesystem ingress at 4 Hz for `heartbeat`, `status`,
// `qwen-step`, `3b-step`, or `quit`.  Idle polls do not render, intern, or
// serialize a snapshot; state publishes at start, explicit inspection, and
// before/after real model work while a separate observer owns PID liveness.
// A completed turn never closes either context.  An explicitly offered quit
// closes both contexts; ordinary idle cadence is never an eviction event.
//
import form/form-stdlib/qwen4exp-flash-next-generate.bml;
import form/form-stdlib/llama32-3b-resident-state.bml;
import form/form-stdlib/native-model-glass.bml;
import form/form-stdlib/native-model-resident-fleet.bml;
import form/form-stdlib/native-model-memory-glass.bml;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/line-grammar.fk;
import form/form-stdlib/form-glass-telemetry-membrane.bml;
import form/form-stdlib/native-model-dual-telemetry.bml;
import form/form-stdlib/native-model-owner-cadence.bml;
import form/form-stdlib/hearth.bml;
import form/form-stdlib/model-registry.bml;
section [form.bml] {
    def nmdr-qwen-prefix() = mr-flash-next-prefix();
    def nmdr-threeb-path() = mr-path(mr-find("llama32-3b"));
    def nmdr-qwen-id() = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
    def nmdr-qwen-weights-id() = "weights.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
    def nmdr-qwen-experts-id() = "experts.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
    def nmdr-qwen-kv-id() = "state.qwen3.8-flash-next.ud-q2_k_xl.unsloth.kv";
    def nmdr-qwen-token-id() = "tokens.qwen3.8-flash-next.ud-q2_k_xl.unsloth.position";
    def nmdr-qwen-loaded-id() = "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.loaded";
    def nmdr-qwen-prefilled-id() = "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.prefilled";
    def nmdr-qwen-active-id() = "state.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth.active";
    def nmdr-qwen-mapped-id() = "mapped.qwen3.8-flash-next";
    def nmdr-qwen-materialized-id() = "materialized.qwen3.8-flash-next";
    def nmdr-threeb-id() = "model.llama-3.2-3b-instruct";
    def nmdr-threeb-weights-id() = "weights.llama-3.2-3b-instruct";
    def nmdr-threeb-kv-id() = "state.llama-3.2-3b-instruct.kv";
    def nmdr-threeb-token-id() = "tokens.llama-3.2-3b-instruct.position";
    def nmdr-threeb-loaded-id() = "state.model.llama-3.2-3b-instruct.loaded";
    def nmdr-threeb-prefilled-id() = "state.model.llama-3.2-3b-instruct.prefilled";
    def nmdr-threeb-active-id() = "state.model.llama-3.2-3b-instruct.active";
    def nmdr-threeb-mapped-id() = "mapped.llama-3.2-3b";
    def nmdr-threeb-materialized-id() = "materialized.llama-3.2-3b";
    def nmdr-threeb-prompt() = [128000, 791, 6864, 315, 9822, 374];
    def nmdr-telemetry-root() = hearth-telemetry-root();
    def nmdr-publisher(instance) = nmdt-owner-publisher(instance);
    def nmdr-self-pid() = {
        // This process's own pid from the seed's host_pid door. Refuse a
        // missing or malformed answer rather than publish PID 0.
        let pid = host_pid();
        (String) value_kind(pid) == "int" && pid > 0 ? pid : 0;
    };
    def nmdr-lifecycle(session, id) = {
        let model = nmg-find(id, nmg-models(session));
        (Comparable) len(model) == 0 ? "unknown" : (Comparable) nmg-active?(model) == 1 ? "active" : (String) nmg-phase(model) == "prefill" ? "prefilling" : (Comparable) nmg-prefilled?(model) == 1 ? "ready" : (Comparable) nmg-loaded?(model) == 1 ? "allocated" : "released";
    };
    def nmdr-threeb-reasoning(session, contextTokens) = nmg-observed(session, NMGThreeB(), 1, 1, 1, "decode", contextTokens, "3b-resident-token-evaluate-entered", "none", "3b-reasoning");
    def nmdr-callable-sample(id, source, session, handle, readEpoch, writeEpoch, owner) = nmdt-callable-sample(id, owner, nmdr-lifecycle(session, source), handle, readEpoch, writeEpoch);
    def nmdr-model-extent-samples(mappedId, materializedId, parent, owner, epoch) = [nmdt-missing-extent-sample(mappedId, parent, owner, "mapped-bytes", "per-model-mapped-bytes", epoch, "model.carrier-per-model-mapped-bytes"), nmdt-missing-extent-sample(materializedId, parent, owner, "materialized-bytes", "per-model-materialized-bytes", epoch, "model.carrier-per-model-materialized-bytes")];
    def nmdr-weight-sample(id, parent, bytes, readEpoch) = nmdt-weight-catalog(id, parent, bytes, readEpoch);
    def nmdr-open-artifact-samples(identities, paths, parent, owner, handle, openEpoch, source) = (Comparable) len(identities) == 0 || (Comparable) len(paths) == 0 ? [] : cons(nmdt-open-artifact-sample(nmtl-artifact-identity-id(identities[0]), parent, owner, paths[0], handle, openEpoch, source, ["process", "model", "memory", "tensor", "metal", "gpu", "health"]), nmdr-open-artifact-samples(identities[1:], paths[1:], parent, owner, handle, openEpoch, source));
    def nmdr-budget-sample(budget) = nmdt-budget-sample(budget);
    def nmdr-substate-sample(id, parent, kind, purpose, session, source, handle, readEpoch, writeEpoch, channels) = nmdt-derived-substate(id, parent, kind, purpose, nmdr-lifecycle(session, source), handle, readEpoch, writeEpoch, channels);
    def nmdr-token-sample(id, parent, position, session, source, handle, accessEpoch) = nmdt-token-position(id, parent, position, nmdr-lifecycle(session, source), handle, accessEpoch);
    // State clocks retain the last transition of each independent bit.  A
    // decode changes active, but does not pretend loaded/prefilled changed too.
    def nmdr-state-samples(model-id, loadedId, prefilledId, activeId, source, session, handle, clock, owner) = {
        let model = nmg-find(source, nmg-models(session));
        (Comparable) len(model) == 0 ? [] : [nmdt-model-state-sample-owned(loadedId, model-id, owner, "loaded", nmg-loaded?(model), handle, nmdt-state-loaded-epoch(clock)), nmdt-model-state-sample-owned(prefilledId, model-id, owner, "prefilled", nmg-prefilled?(model), handle, nmdt-state-prefilled-epoch(clock)), nmdt-model-state-sample-owned(activeId, model-id, owner, "active", nmg-active?(model), handle, nmdt-state-active-epoch(clock))];
    };
    def nmdr-status-counter(status, key, id, kind, plane, owner, lane, purpose, epoch, source, channels) = {
        let value = nmdt-status-int(status, key);
        value < 0 ? nmdt-owner-missing-sample(id, kind, plane, owner, lane, purpose, epoch, source, channels) : nmdt-owner-counter-sample(id, kind, plane, owner, lane, purpose, value, epoch, source, channels);
    };
    def nmdr-owner-runtime-samples(owner, epoch) = {
        let status = metal_status();
        [nmdt-owner-counter-sample("primitive.owner.dispatch-total", "primitive-counter", "form", owner, "primitive", "runtime-work-including-observer-cost", kernel_stat(0), epoch, "fkwu.kernel-stat-0", ["process", "model", "primitive", "cpu", "health"]), nmdt-owner-counter-sample("primitive.owner.dispatch-distinct", "primitive-counter", "form", owner, "primitive", "runtime-surface-in-use", kernel_stat(1), epoch, "fkwu.kernel-stat-1", ["process", "model", "primitive", "cpu", "health"]), nmdt-owner-counter-sample("primitive.owner.hottest-tag", "primitive-counter", "form", owner, "primitive", "current-owner-hotspot-tag", kernel_stat(2), epoch, "fkwu.kernel-stat-2", ["process", "model", "primitive", "cpu", "health"]), nmdt-owner-counter-sample("primitive.owner.hottest-count", "primitive-counter", "form", owner, "primitive", "current-owner-hotspot-calls", kernel_stat(3), epoch, "fkwu.kernel-stat-3", ["process", "model", "primitive", "cpu", "health"]), nmdt-owner-counter-sample("jit.owner.compile-dispatch", "jit-counter", "form", owner, "jit", "compile-call-impact", kernel_stat(183), epoch, "fkwu.kernel-stat-183", ["process", "model", "jit", "cpu", "health"]), nmdt-owner-counter-sample("jit.owner.leaf-inram-dispatch", "jit-counter", "form", owner, "jit", "inram-leaf-call-impact", kernel_stat(246), epoch, "fkwu.kernel-stat-246", ["process", "model", "jit", "cpu", "health"]), nmdt-owner-counter-sample("jit.owner.arm64-dispatch", "jit-counter", "form", owner, "jit", "arm64-call-impact", kernel_stat(315), epoch, "fkwu.kernel-stat-315", ["process", "model", "jit", "cpu", "health"]), nmdt-metal-counter(status, "jit.owner.metal-dispatch", "jit-counter", "jit", "cpu-jit-fallback-calls", "cpu_jit_dispatch", "metal_status.cpu_jit_dispatch", owner, epoch, ["process", "model", "jit", "cpu", "health"]), nmdt-metal-counter(status, "jit.owner.metal-busy-us", "jit-counter", "jit", "cpu-jit-fallback-cost-us", "cpu_jit_busy_us_total", "metal_status.cpu_jit_busy_us_total", owner, epoch, ["process", "model", "jit", "cpu", "health"]), nmdt-metal-counter(status, "metal.owner.in-flight", "metal-gauge", "metal", "submitted-command-batches", "in_flight", "metal_status.in_flight", owner, epoch, ["process", "model", "metal", "gpu", "health"]), nmdt-metal-counter(status, "metal.owner.buffers", "metal-gauge", "memory", "allocated-metal-buffer-handles", "buffers", "metal_status.buffers", owner, epoch, ["process", "model", "memory", "metal", "gpu", "tensor", "health"]), nmdt-metal-counter(status, "cache.owner.metal-pipelines", "pipeline-cache", "cache", "compiled-metal-pipeline-handles", "pipelines", "metal_status.pipelines", owner, epoch, ["process", "model", "cache", "metal", "health"]), nmdt-metal-counter(status, "mapping.owner.mmap-buffer-handles", "mapping-counter", "memory", "mmap-no-copy-buffer-handles", "mmap_nocopy_buffers", "metal_status.mmap_nocopy_buffers", owner, epoch, ["process", "model", "memory", "metal", "health"]), nmdt-metal-counter(status, "metal.owner.dispatch-total", "metal-counter", "metal", "submitted-metal-dispatches", "total_dispatch", "metal_status.total_dispatch", owner, epoch, ["process", "model", "metal", "gpu", "health"]), nmdt-metal-counter(status, "metal.owner.sync-total", "metal-counter", "metal", "completed-metal-synchronizations", "total_sync", "metal_status.total_sync", owner, epoch, ["process", "model", "metal", "gpu", "health"]), nmdt-metal-counter(status, "gpu.owner.busy-us-total", "gpu-counter", "gpu", "command-buffer-device-time-us", "gpu_busy_us_total", "metal_status.gpu_busy_us_total", owner, epoch, ["process", "model", "metal", "gpu", "health"]), nmdt-owner-missing-sample("cache.owner.walk-stats", "walk-cache", "form", owner, "cache", "hit-miss-and-age", epoch, "fkwu.walk-cache-stats", ["process", "model", "cache", "health"]), nmdt-owner-missing-sample("jit.owner.stage-duration", "jit-duration", "form", owner, "jit", "per-stage-duration", epoch, "fkwu.jit-stats", ["process", "model", "jit", "cpu", "health"]), nmdt-owner-missing-sample("memory.owner.ephemeral-render-string", "runtime-memory", "form", owner, "memory", "per-publication-temporary-string-reclaim", epoch, "kernel.ephemeral-render-string", ["process", "model", "memory", "health"]), nmdt-owner-nodeid-seam(owner, epoch)];
    };
    def nmdr-publish(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples) = {
        let epoch = now_unix_ms();
        let correlation = nmdt-owner-correlation(publisher, ownerPid, started, incarnation, sequence, epoch);
        let modelSamples = append([nmdr-callable-sample(nmdr-qwen-id(), NMGQwen(), session, qhandle, qAccess, qAccess, publisher), nmdr-weight-sample(nmdr-qwen-weights-id(), nmdr-qwen-id(), NMRFQwenBytes(), qAccess), nmdr-substate-sample(nmdr-qwen-experts-id(), nmdr-qwen-id(), "expert-pack", "moe-route", session, NMGQwen(), qhandle, qAccess, qAccess, ["memory", "model", "metal", "gpu", "expert", "query-lane"]), nmdr-substate-sample(nmdr-qwen-kv-id(), nmdr-qwen-id(), "kv-substate", "attention-state", session, NMGQwen(), qhandle, qAccess, qAccess, ["memory", "model", "metal", "gpu", "substate", "query-lane"]), nmdr-token-sample(nmdr-qwen-token-id(), nmdr-qwen-id(), q4s-pos(qslot), session, NMGQwen(), qhandle, qAccess), nmdr-callable-sample(nmdr-threeb-id(), NMGThreeB(), session, thandle, tAccess, tAccess, publisher), nmdr-weight-sample(nmdr-threeb-weights-id(), nmdr-threeb-id(), NMRFThreeBBytes(), tAccess), nmdr-substate-sample(nmdr-threeb-kv-id(), nmdr-threeb-id(), "kv-substate", "attention-state", session, NMGThreeB(), thandle, tAccess, tAccess, ["memory", "model", "metal", "gpu", "substate", "query-lane"]), nmdr-token-sample(nmdr-threeb-token-id(), nmdr-threeb-id(), l3rs-position(three), session, NMGThreeB(), thandle, tAccess)], append(nmdr-model-extent-samples(nmdr-qwen-mapped-id(), nmdr-qwen-materialized-id(), nmdr-qwen-id(), publisher, epoch), nmdr-model-extent-samples(nmdr-threeb-mapped-id(), nmdr-threeb-materialized-id(), nmdr-threeb-id(), publisher, epoch)));
        let stateSamples = append(nmdr-state-samples(nmdr-qwen-id(), nmdr-qwen-loaded-id(), nmdr-qwen-prefilled-id(), nmdr-qwen-active-id(), NMGQwen(), session, qhandle, qStateClock, publisher), nmdr-state-samples(nmdr-threeb-id(), nmdr-threeb-loaded-id(), nmdr-threeb-prefilled-id(), nmdr-threeb-active-id(), NMGThreeB(), session, thandle, tStateClock, publisher));
        !((Comparable) nmdt-owner-correlation?(correlation) == 1) ? ["glass-publish-v1", "refused", "owner-correlation"] : {
            let runtimeSamples = nmdr-owner-runtime-samples(publisher, epoch);
            let tensorGroups = append(q4t-ledger-groups(q4s-ctx(qslot), nmdr-qwen-id(), publisher, epoch), l3rs-ledger-groups(three, nmdr-threeb-id(), publisher, epoch));
            let tensorSamples = append(nmdt-tensor-group-samples(tensorGroups), nmdt-tensor-reconcile-samples(tensorGroups, metal_status(), publisher, epoch));
            let publishedSamples = append([nmdt-owner-heartbeat-sample-at(correlation, heartbeatId)], append(modelSamples, append(artifactSamples, append(stateSamples, append(runtimeSamples, append(tensorSamples, [nmdr-budget-sample(nmrf-budget(fleet))]))))));
            fgtm-publish-snapshot(nmdr-telemetry-root(), publisher, epoch, publishedSamples);
        };
    };
    def nmdr-publish-state(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples) = {
        let published = nmdr-publish(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
        let _memory-frame = nmmg-write-quiet(fleet, session, q4s-pos(qslot), l3rs-position(three));
        published;
    };
    def nmdr-release-sample(id, closed, epoch) = nmdt-release-tombstone(id, closed, epoch);
    def nmdr-publish-release(publisher, qclosed, tclosed) = {
        let epoch = now_unix_ms();
        fgtm-publish-snapshot(nmdr-telemetry-root(), publisher, epoch, [nmdr-release-sample(nmdr-qwen-id(), qclosed, epoch), nmdr-release-sample(nmdr-threeb-id(), tclosed, epoch)]);
    };
    def nmdr-status(qslot, three, session, fleet, qhandle, thandle) = {
        let _qframe = nmg-glass-write-physical(session, NMGQwen(), qhandle, "resident-turnwheel-status");
        let _tframe = nmg-glass-write-physical(session, NMGThreeB(), thandle, "resident-turnwheel-status");
        let _memory-map = nmmg-write(fleet, session, q4s-pos(qslot), l3rs-position(three));
        let pressure = nmrf-pressure-plan(fleet, 0, []);
        print(["native-model-dual-resident-status", "loaded", nmrf-loaded-count(nmrf-rows(fleet)), "prefilled", nmrf-prefilled-count(nmrf-rows(fleet)), "logical-weight-bytes", nmrf-resident-bytes(nmrf-rows(fleet)), "budget-bytes", nmrf-budget(fleet), "pressure-needed", pressure[1], "pressure-evictions", len(pressure[3]), "qwen-position", q4s-pos(qslot), "threeb-position", l3rs-position(three), "qwen-handle", qhandle, "threeb-handle", thandle]);
        1;
    };
    def nmdr-close(qslot, three, session, qhandle, thandle, publisher, reason) = {
        let qclosed = q4s-close(qslot);
        let tclosed = l3rs-close(three);
        let qreleased = (Comparable) qclosed == 1 ? nmg-release(session, NMGQwen()) : session;
        let _qframe = (Comparable) qclosed == 1 ? nmg-glass-write-physical-release(qreleased, NMGQwen(), qhandle, qclosed) : 0;
        let treleased = (Comparable) tclosed == 1 ? nmg-release(qreleased, NMGThreeB()) : qreleased;
        let _tframe = (Comparable) tclosed == 1 ? nmg-glass-write-physical-release(treleased, NMGThreeB(), thandle, tclosed) : 0;
        let _tombstone = nmdr-publish-release(publisher, qclosed, tclosed);
        ["native-model-dual-resident-closed", reason, "qwen-close", qclosed, "threeb-close", tclosed];
    };
    def nmdr-loop(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples) = {
        let _door = (Comparable) sequence == 1 ? print(["native-model-owner-command-door", nmdoc-command-frame(publisher), "cadence-ms", 250]) : 0;
        let polled = nmdoc-poll-command(publisher);
        (String) nmdoc-command-status(polled) == "waiting" ? {
            let _wait = host_sleep_ms(250);
            nmdr-loop(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
        } : {
            let command = nmdoc-command-value(polled);
            (String) command == "quit" ? nmdr-close(qslot, three, session, qhandle, thandle, publisher, "quit") : (String) command == "heartbeat" ? {
                let _heartbeat-state = nmdr-publish-state(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
                print(["native-model-owner-heartbeat", "publisher", publisher, "pid", ownerPid, "sequence", sequence]);
                nmdr-loop(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
            } : (String) command == "status" ? {
                let _status-state = nmdr-publish-state(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, sequence, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
                nmdr-status(qslot, three, session, fleet, qhandle, thandle);
                nmdr-loop(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
            } : (String) command == "qwen-step" ? {
                let activeEpoch = now_unix_ms();
                let active = nmg-qwen-reasoning(session, q4s-pos(qslot));
                let qActiveStateClock = nmdt-state-active-at(qStateClock, activeEpoch);
                let _active-frame = nmg-glass-write-physical(active, NMGQwen(), qhandle, "resident-decode-entered");
                let _active-telemetry = nmdr-publish-state(qslot, three, active, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, activeEpoch, tAccess, qActiveStateClock, tStateClock, artifactSamples);
                let next = q4s-evaluate-one(qslot, q4s-output(qslot));
                let done = nmg-qwen-finished(active, q4s-pos(next));
                let _done-frame = nmg-glass-write-physical(done, NMGQwen(), qhandle, "resident-decode-returned");
                let nextFleet = nmrf-touch(fleet, NMGQwen());
                let doneEpoch = now_unix_ms();
                let qDoneStateClock = nmdt-state-active-at(qActiveStateClock, doneEpoch);
                let _done-telemetry = nmdr-publish-state(next, three, done, nextFleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 2, doneEpoch, tAccess, qDoneStateClock, tStateClock, artifactSamples);
                print(["qwen-step", "input", q4s-prev1(next), "output", q4s-output(next), "position", q4s-pos(next)]);
                nmdr-loop(next, three, done, nextFleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 2, doneEpoch, tAccess, qDoneStateClock, tStateClock, artifactSamples);
            } : (String) command == "3b-step" ? {
                let activeEpoch = now_unix_ms();
                let active = nmdr-threeb-reasoning(session, l3rs-position(three));
                let tActiveStateClock = nmdt-state-active-at(tStateClock, activeEpoch);
                let _active-frame = nmg-glass-write-physical(active, NMGThreeB(), thandle, "resident-decode-entered");
                let _active-telemetry = nmdr-publish-state(qslot, three, active, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, qAccess, activeEpoch, qStateClock, tActiveStateClock, artifactSamples);
                let next = l3rs-step(three);
                let done = nmg-threeb-finished(active, l3rs-position(next));
                let _done-frame = nmg-glass-write-physical(done, NMGThreeB(), thandle, "resident-decode-returned");
                let nextFleet = nmrf-touch(fleet, NMGThreeB());
                let doneEpoch = now_unix_ms();
                let tDoneStateClock = nmdt-state-active-at(tActiveStateClock, doneEpoch);
                let _done-telemetry = nmdr-publish-state(qslot, next, done, nextFleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 2, qAccess, doneEpoch, qStateClock, tDoneStateClock, artifactSamples);
                print(["3b-step", "text", l3rs-pending-text(three), "next", l3rs-pending(next), "position", l3rs-position(next)]);
                nmdr-loop(qslot, next, done, nextFleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 2, qAccess, doneEpoch, qStateClock, tDoneStateClock, artifactSamples);
            } : {
                print(["owner-command-ingress", nmdoc-command-status(polled), command]);
                nmdr-loop(qslot, three, session, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, (Number) sequence + (Number) 1, qAccess, tAccess, qStateClock, tStateClock, artifactSamples);
            };
        };
    };
    def nmdr-after-threeb(qsrc, qresult, qsession, qhandle, qStateClock, qArtifactSamples, three, thandle, started, publisher, incarnation, heartbeatId, ownerPid) = {
        let tloaded = nmg-threeb-loaded(qsession);
        let tLoadedEpoch = now_unix_ms();
        let tArtifactSamples = nmdr-open-artifact-samples(nmtl-layout-profile-artifact(nmtl-llama-layout-profile()), [l3rs-path(three)], nmdr-threeb-id(), publisher, thandle, tLoadedEpoch, "l3rs.open-path-file-stat");
        let artifactSamples = append(qArtifactSamples, tArtifactSamples);
        let _tloaded-frame = nmg-glass-write-physical(tloaded, NMGThreeB(), thandle, "weight-open-returned");
        let tprefilling = nmg-threeb-prefilling(tloaded, 0);
        let _tprefill-frame = nmg-glass-write-physical(tprefilling, NMGThreeB(), thandle, "prefix-evaluate-entered");
        let tprefilled = l3rs-prefill(three, nmdr-threeb-prompt());
        let tdone = nmg-threeb-finished(tprefilling, l3rs-position(tprefilled));
        let tDoneEpoch = now_unix_ms();
        let tStateClock = nmdt-state-clock(tLoadedEpoch, tDoneEpoch, tDoneEpoch);
        let _tdone-frame = nmg-glass-write-physical(tdone, NMGThreeB(), thandle, "prefill-returned");
        let qslot = q4x-result-slot(qresult);
        let incoming = append(q4s-tokens(qslot), [11]);
        let qactive = nmg-qwen-reasoning(tdone, q4s-pos(qslot));
        let _qactive-frame = nmg-glass-write-physical(qactive, NMGQwen(), qhandle, "retained-prefix-append-entered");
        let appended = q4s-evaluate(qslot, incoming);
        let qnext = q4s-result-slot(appended);
        let qdone = nmg-qwen-finished(qactive, q4s-pos(qnext));
        let qDoneEpoch = now_unix_ms();
        let qCurrentStateClock = nmdt-state-active-at(qStateClock, qDoneEpoch);
        let _qdone-frame = nmg-glass-write-physical(qdone, NMGQwen(), qhandle, "retained-prefix-append-returned");
        let fleet = nmrf-dual-resident(qhandle, thandle);
        let noPressure = nmrf-pressure-plan(fleet, 0, []);
        print(["native-model-dual-resident-started", "qwen-handle", qhandle, "threeb-handle", thandle, "loaded", nmrf-loaded-count(nmrf-rows(fleet)), "prefilled", nmrf-prefilled-count(nmrf-rows(fleet)), "logical-weight-bytes", nmrf-resident-bytes(nmrf-rows(fleet)), "budget-bytes", nmrf-budget(fleet), "qwen-prefix-status", q4s-result-status(appended), "qwen-reused", q4s-result-reused(appended), "qwen-evaluated", q4s-result-evaluated(appended), "threeb-first", l3rs-pending(tprefilled), "threeb-text", l3rs-pending-text(tprefilled), "pressure-evictions", len(noPressure[3])]);
        let qAccess = now_unix_ms();
        let tAccess = now_unix_ms();
        let _initial-state = nmdr-publish-state(qnext, tprefilled, qdone, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, 1, qAccess, tAccess, qCurrentStateClock, tStateClock, artifactSamples);
        nmdr-loop(qnext, tprefilled, qdone, fleet, qhandle, thandle, publisher, started, incarnation, heartbeatId, ownerPid, 1, qAccess, tAccess, qCurrentStateClock, tStateClock, artifactSamples);
    };
    def nmdr-open-threeb(qsrc, qresult, qsession, qhandle, qStateClock, qArtifactSamples, started, publisher, incarnation, heartbeatId, ownerPid) = {
        let tloading = nmg-threeb-loading(qsession);
        let _tloading-frame = nmg-glass-write(tloading);
        let three = l3rs-open(nmdr-threeb-path(), 128);
        let thandle = l3rs-residency-handle(three);
        (Comparable) l3rs-resident?(three) == 1 ? nmdr-after-threeb(qsrc, qresult, tloading, qhandle, qStateClock, qArtifactSamples, three, thandle, started, publisher, incarnation, heartbeatId, ownerPid) : {
            let tclosed = l3rs-close(three);
            let qclosed = q4x-close(qresult);
            ["native-model-dual-resident-refused", "threeb-handle", thandle, "threeb-close", tclosed, "qwen-close", qclosed];
        };
    };
    def nmdr-after-qwen(src, slot, loading, qhandle, started, publisher, incarnation, heartbeatId, ownerPid) = {
        let qloaded = nmg-qwen-loaded(loading);
        let qLoadedEpoch = now_unix_ms();
        let qArtifactSamples = nmdr-open-artifact-samples(nmtl-layout-profile-artifact(nmtl-qwen-layout-profile()), q4t-paths(q4s-prefix(slot)), nmdr-qwen-id(), publisher, qhandle, qLoadedEpoch, "q4s.open-path-file-stat");
        let _qloaded-frame = nmg-glass-write-physical(qloaded, NMGQwen(), qhandle, "weight-open-returned");
        let ids = q4tk-chat-ids(src, "Return only the word Form.");
        let qprefilling = nmg-qwen-prefilling(qloaded, 0);
        let _qprefill-frame = nmg-glass-write-physical(qprefilling, NMGQwen(), qhandle, "prefix-evaluate-entered");
        let prefill = q4s-evaluate(slot, ids);
        let resident = q4s-result-slot(prefill);
        let qreason = nmg-qwen-reasoning(qprefilling, q4s-pos(resident));
        let qPrefilledEpoch = now_unix_ms();
        let _qreason-frame = nmg-glass-write-physical(qreason, NMGQwen(), qhandle, "prefill-returned");
        let result = q4x-from-prefill(src, prefill, 1, len(ids));
        let qdone = nmg-qwen-finished(qreason, q4s-pos(q4x-result-slot(result)));
        let qActiveEpoch = now_unix_ms();
        let qStateClock = nmdt-state-clock(qLoadedEpoch, qPrefilledEpoch, qActiveEpoch);
        let _qdone-frame = nmg-glass-write-physical(qdone, NMGQwen(), qhandle, "generation-returned-retained");
        print(["qwen-seed-answer", q4x-result-text(result), "tokens", len(ids), "position", q4s-pos(q4x-result-slot(result))]);
        nmdr-open-threeb(src, result, qdone, qhandle, qStateClock, qArtifactSamples, started, publisher, incarnation, heartbeatId, ownerPid);
    };
    framebuffer-clear();
    let instance = now_unix_ms();
    let publisher = nmdr-publisher(instance);
    let incarnation = nmdt-owner-incarnation(instance);
    let heartbeatId = nmdt-owner-heartbeat-id-from-incarnation(incarnation);
    let ownerPid = nmdr-self-pid();
    ownerPid <= 0 ? ["native-model-dual-resident-refused", "reason", "owner-pid-unavailable-before-model-open"] : {
        let native = nmg-begin-native(nmg-initial());
        let selected = nmg-finish-native(native, "request-evidence");
        let loading = nmg-qwen-loading(selected);
        let _loading-frame = nmg-glass-write(loading);
        let prefix = nmdr-qwen-prefix();
        let src = eqr-of-file((prefix + "00001-of-00003.gguf"), 0, 12000000);
        let slot = q4s-open(prefix, 128);
        let qhandle = q4s-residency-handle(slot);
        (Comparable) q4s-resident?(slot) == 1 ? nmdr-after-qwen(src, slot, loading, qhandle, instance, publisher, incarnation, heartbeatId, ownerPid) : {
            let closed = q4s-close(slot);
            ["native-model-dual-resident-refused", "qwen-handle", qhandle, "qwen-close", closed];
        };
    };
}
