// preflight-exec: forbidden
// Read-only, potentially large index: invoked with a process deadline.
// preludes: form-stdlib/rag-ask.fk
section [form.bml] {
    class FormCliHealRag {
        def fhrag-source(hit) {
            let path = ra-hit-source-path(hit);
            if or(eq(str_len(path), 0), or(eq(str_byte_at(path, 0), 47), ge(str_find(path, "..", 0), 0))) then "current-source-unavailable" else if le(file_size(path), 0) then "current-source-absent" else read_file_slice(path, 0, 2000);
        }
        def fhrag-run() {
            let hit = ra-grounded-hit(read_line());
            print_str(str_concat(ra-hit-output(hit), str_concat("\nCurrent source excerpt:\n", fhrag-source(hit))));
        }
    }
    fhrag-run();
}
