//////////////////////////////////////////////////////////////////////
//
// observe/belief-stamps.bml — the belief re-witness lens.
//
// Executable BML. R14 in the release ledger. observe/belief-freshness.fk
// holds the lifecycle — a belief is held (0), owed a re-witness (1), or
// law for now (2), judged by bf-status against an epoch — and has said
// since 2026-07-05 that wiring every cell's header stamp into bf- rows
// was "the pending half, named not claimed". This cell is that half.
// It reads; it writes nothing.
//
// Corpus row 1259 names afterwall: a limit that stands in a cell's
// words after the kernel stopped enforcing it. A stamp older than the
// seed is the soil an afterwall grows in — the words were true of a
// kernel that is gone. This lens keeps the list of those stamps in
// front of the body, oldest first, so none of them thickens unseen.
//
// WHAT COUNTS AS A STAMP. Every tracked .fk and .bml is read once —
// git ls-files through host-exec, because "tracked" is a git fact: the
// body's own tree walk (source_inventory) sees the disk, and the disk
// holds sibling worktrees, scratch and ices nobody witnessed. A line
// that BEGINS with a comment marker (";" or "//") and then "witnessed:"
// is a stamp. Its date becomes a date-int (yyyymmdd); the word after
// "->" is the verdict token (after the word "band", the number that
// follows it; a trailing , ; . or ) is shed). A file with several
// stamps keeps its NEWEST — the freshest witness is the one the body
// leans on, and it is the line a re-witness door will append.
// proven = 1 when a verdict token follows the arrow; an arrow with
// nothing after it, or the word "pending", is an honest absence, not
// a proof (proven 0, held). "witnessed: pending" without a date is
// no stamp at all.
//
// THE EPOCH is the date of the last commit touching runtime/fkwu-uni.c,
// read from git log through host-exec. That date IS the definition of
// the ground shift, so it needs no judgment; a stamp file the land
// cadence might write would be a mirror of it, and a mirror drifts
// (the bp-table lesson). When the epoch cannot be read the lens says
// so and answers 0 rather than silently calling every belief a law -
// Form has no loud death word yet; the message and the zero are the
// floor, named.
//
// ANSWER. Prints the totals, the OWED list oldest-first
// (stamp  path  -> token), and answers stamped*10^6 + owed*10^3 + laws
// — injective while each place stays under 1000 (486 stamps today).
// bf-audit is folded over the same rows and printed with its caveat:
// its places are 10^2 wide, sized for a larder of ninety-nine, so at
// body scale it is shown, never read as a code.
//
// Run directly:  ./fkwu observe/belief-stamps.bml
// Proven by:     observe/tests/belief-stamps-band.fk
//
// NEXT STONE, named and not built here (it writes into cells that six
// siblings hold open this hour): the re-witness door. A cell whose
// stamp is owed runs its band; exit 0 with the declared verdict renews
// the stamp to today (bf-rewitness observed=1) — a band run IS the
// witness; the receipt IS the stamp. A red run lets the belief lapse
// (observed=0), its last honest date kept. The token this lens keeps
// per row is the number that door compares against.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml observe/belief-freshness.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormBeliefStamps {
        thought belief-stamps-pattern = list("stamp-is-a-row", "newest-stamp-wins", "epoch-is-the-seed-commit", "reads-never-writes", "owed-oldest-first");

        def bfs-nl() = byte_to_str(10);
        def bfs-seed() = "runtime/fkwu-uni.c";
        def bfs-key() = "witnessed:";
        def bfs-arrow() = "->";
        def bfs-files-cmd() = "git ls-files -- '*.fk' '*.bml'";
        def bfs-epoch-cmd() = "git log -1 --format=%ad --date=short -- " ++ bfs-seed();
        def bfs-host-text(v) = v ?? "";

        // ---- lines, order kept; a last line without its newline still counts ----
        def bfs-lines(text, from, acc) {
            let nl = str_find(text, bfs-nl(), from);
            nl < 0 ? reverse(bfs-last-line(text, from, acc))
            : bfs-lines(text, nl + 1, cons(substring(text, from, nl), acc));
        }
        def bfs-last-line(text, from, acc) = from < str_len(text) ? cons(substring(text, from, str_len(text)), acc) : acc;

        // ---- characters: one byte at i, "" past the end (substring clamps) ----
        def bfs-ch(s, i) = substring(s, i, i + 1);
        def bfs-blank?(c) = (String) c == " " ? 1 : (String) c == byte_to_str(9) ? 1 : 0;
        def bfs-skip-blank(s, i) = i >= str_len(s) ? i : (Comparable) bfs-blank?(bfs-ch(s, i)) == 1 ? bfs-skip-blank(s, i + 1) : i;
        def bfs-skip-char(s, i, c) = i >= str_len(s) ? i : (String) bfs-ch(s, i) == c ? bfs-skip-char(s, i + 1, c) : i;
        def bfs-word-end(s, i) = i >= str_len(s) ? i : (Comparable) bfs-blank?(bfs-ch(s, i)) == 1 ? i : bfs-word-end(s, i + 1);

        // ---- the comment marker: index just past it, or -1 when the line is no comment ----
        def bfs-slash?(line, i) = (String) bfs-ch(line, i) == "/";
        def bfs-after-marker(line) = (String) bfs-ch(line, 0) == ";" ? bfs-skip-char(line, 0, ";") : bfs-slash?(line, 0) && bfs-slash?(line, 1) ? bfs-skip-char(line, 0, "/") : (0 - 1);

        // ---- the text after "witnessed:" on a stamp line; nothing when the line is no stamp ----
        def bfs-stamp-rest(line) = bfs-stamp-rest-at(line, bfs-after-marker(line));
        def bfs-stamp-rest-at(line, m) = m < 0 ? nothing() : bfs-stamp-rest-from(line, bfs-skip-blank(line, m));
        def bfs-stamp-rest-from(line, i) = (String) substring(line, i, i + str_len(bfs-key())) == bfs-key() ? substring(line, i + str_len(bfs-key()), str_len(line)) : nothing();
        def bfs-stamp-line?(line) = nothing?(bfs-stamp-rest(line)) ? 0 : 1;

        // ---- the date: "yyyy-mm-dd" at the head of t -> yyyymmdd, or 0 ----
        def bfs-date-of(t) {
            let y = str_to_int(substring(t, 0, 4));
            let m = str_to_int(substring(t, 5, 7));
            let d = str_to_int(substring(t, 8, 10));
            str_len(t) < 10 ? 0
            : !((String) bfs-ch(t, 4) == "-") ? 0
            : !((String) bfs-ch(t, 7) == "-") ? 0
            : y < 2000 ? 0
            : (m < 1) || (m > 12) ? 0
            : (d < 1) || (d > 31) ? 0
            : ((y * 10000) + ((m * 100) + d));
        }

        // ---- the verdict token: the word after "->", trailing punctuation shed ----
        def bfs-tail-punct?(c) = (String) c == "," ? 1 : (String) c == ";" ? 1 : (String) c == "." ? 1 : (String) c == ")" ? 1 : 0;
        def bfs-word-clean(w) = (Comparable) str_len(w) == 0 ? w : (Comparable) bfs-tail-punct?(bfs-ch(w, str_len(w) - 1)) == 1 ? bfs-word-clean(substring(w, 0, str_len(w) - 1)) : w;
        def bfs-word-at(s, i) = bfs-word-clean(substring(s, i, bfs-word-end(s, i)));
        def bfs-word-after(s, i) = bfs-word-at(s, bfs-skip-blank(s, bfs-word-end(s, i)));
        def bfs-first-word-index(t) = bfs-first-word-index-at(t, str_find(t, bfs-arrow(), 0));
        def bfs-first-word-index-at(t, a) = a < 0 ? (0 - 1) : bfs-skip-blank(t, a + 2);
        def bfs-token-at(t, i) = i < 0 ? "" : bfs-token-after-band(t, i, bfs-word-at(t, i));
        // "band 127 four-way" names its number after the word band
        def bfs-token-after-band(t, i, w) = (String) w == "band" ? bfs-word-after(t, i) : w;
        def bfs-verdict-token(t) = bfs-token-at(t, bfs-first-word-index(t));
        def bfs-proven?(token) = (Comparable) str_len(token) == 0 ? 0 : (String) token == "pending" ? 0 : 1;

        // ---- a stamp: list(date, proven, token, date-text); the no-stamp is all zero ----
        def bfs-no-stamp() = list(0, 0, "", "");
        def bfs-stamp-date(s) = s[0];
        def bfs-stamp-proven(s) = s[1];
        def bfs-stamp-token(s) = s[2];
        def bfs-stamp-text(s) = s[3];
        def bfs-stamp-of-text(t) {
            let date = bfs-date-of(t);
            let token = bfs-verdict-token(t);
            (Comparable) date == 0 ? bfs-no-stamp() : list(date, bfs-proven?(token), token, substring(t, 0, 10));
        }
        def bfs-stamp-of-rest(rest) = nothing?(rest) ? bfs-no-stamp() : bfs-stamp-of-text(substring(rest, bfs-skip-blank(rest, 0), str_len(rest)));
        def bfs-stamp-of-line(line) = bfs-stamp-of-rest(bfs-stamp-rest(line));

        // ---- the newest stamp in a file; the first wins a tie ----
        def bfs-newer(a, b) = bfs-stamp-date(b) > bfs-stamp-date(a) ? b : a;
        def bfs-newest-stamp(lines, best) = (Comparable) len(lines) == 0 ? best : bfs-newest-stamp(tail(lines), bfs-newer(best, bfs-stamp-of-line(head(lines))));
        def bfs-stamp-of-file-text(text) = str_find(text, bfs-key(), 0) < 0 ? bfs-no-stamp() : bfs-newest-stamp(bfs-lines(text, 0, list()), bfs-no-stamp());

        // ---- rows: the belief-freshness row itself, plus the token and date-text it came from ----
        def bfs-row(path, stamp) = list(bf-belief(path, bfs-stamp-proven(stamp), bfs-stamp-date(stamp)), bfs-stamp-token(stamp), bfs-stamp-text(stamp));
        def bfs-row-belief(r) = r[0];
        def bfs-row-token(r) = r[1];
        def bfs-row-text(r) = r[2];
        def bfs-row-path(r) = bf-id(bfs-row-belief(r));
        def bfs-row-date(r) = bf-date(bfs-row-belief(r));
        def bfs-row-of-text(path, text) = bfs-row(path, bfs-stamp-of-file-text(text));
        def bfs-row-of-path(path) = bfs-row-of-text(path, bfs-host-text(read_file(path)));
        def bfs-row-status(r, epoch) = bf-status(bfs-row-belief(r), epoch);

        // ---- the walk rides the table engine: filter2 / map, no hand-rolled row recursion ----
        def bfs-status-is?(r, es) = (Comparable) bfs-row-status(r, es[0]) == es[1] ? 1 : 0;
        def bfs-stamped(rows) = len(filter(r => bfs-row-date(r) > 0, rows));
        def bfs-pending(rows) = len(filter(r => (bfs-row-date(r) > 0) && ((Comparable) bf-proven(bfs-row-belief(r)) == 0), rows));
        def bfs-count-status(rows, epoch, s) = len(tb-filter2(rows, bfs-status-is?, list(epoch, s)));
        def bfs-owed-rows(rows, epoch) = bfs-sort-oldest(tb-filter2(rows, bfs-status-is?, list(epoch, 1)), list());

        // ---- oldest first, stable: equal dates keep the tracked order (a seam: the table engine has no sort) ----
        def bfs-insert(sorted, r) = (Comparable) len(sorted) == 0 ? list(r) : bfs-row-date(r) < bfs-row-date(head(sorted)) ? cons(r, sorted) : cons(head(sorted), bfs-insert(tail(sorted), r));
        def bfs-sort-oldest(rows, acc) = (Comparable) len(rows) == 0 ? acc : bfs-sort-oldest(tail(rows), bfs-insert(acc, head(rows)));

        // ---- the body: paths from git, epoch from the seed's last commit ----
        def bfs-paths() = bfs-lines(bfs-host-text(host-exec(bfs-files-cmd(), "")), 0, list());
        def bfs-rows() = tb-map(bfs-paths(), bfs-row-of-path);
        def bfs-epoch-of(text) = bfs-date-of(substring(text, bfs-skip-blank(text, 0), str_len(text)));
        def bfs-epoch() = bfs-epoch-of(bfs-host-text(host-exec(bfs-epoch-cmd(), "")));

        // ---- the answer ----
        def bfs-field(stamped, owed, laws) = (stamped * 1000000) + ((owed * 1000) + laws);
        def bfs-owed-line(r) = bfs-row-text(r) ++ "  " ++ bfs-row-path(r) ++ "  -> " ++ bfs-row-token(r);
        def bfs-print-owed(rows) = (Comparable) len(rows) == 0 ? 0 : bfs-print-owed-one(head(rows), tail(rows));
        def bfs-print-owed-one(r, rest) {
            print(bfs-owed-line(r));
            bfs-print-owed(rest);
        }
        def bfs-kv(k, v) = k ++ "=" ++ int_to_str(v);
        def bfs-totals-line(rows, stamped, laws, owed, held) = bfs-kv("tracked", len(rows)) ++ " " ++ bfs-kv("stamped", stamped) ++ " " ++ bfs-kv("law", laws) ++ " " ++ bfs-kv("owed", owed) ++ " " ++ bfs-kv("held", held) ++ " " ++ bfs-kv("stamped-pending", bfs-pending(rows));
        def bfs-report(rows, epoch) {
            let stamped = bfs-stamped(rows);
            let laws = bfs-count-status(rows, epoch, 2);
            let owed = bfs-count-status(rows, epoch, 1);
            let held = bfs-count-status(rows, epoch, 0);
            print("belief stamps - epoch " ++ int_to_str(epoch) ++ " (last commit touching " ++ bfs-seed() ++ ")");
            print(bfs-totals-line(rows, stamped, laws, owed, held));
            print("bf-audit over the same rows (10^4/10^2 places, sized for 99 - shown, not read as a code): " ++ int_to_str(bf-audit(tb-map(rows, bfs-row-belief), epoch)));
            print("owed a re-witness - oldest first (stamp  path  -> verdict token):");
            bfs-print-owed(bfs-owed-rows(rows, epoch));
            print("field stamped*10^6 + owed*10^3 + laws = " ++ int_to_str(bfs-field(stamped, owed, laws)));
            bfs-field(stamped, owed, laws);
        }
        def bfs-no-epoch() {
            print("belief stamps: epoch unreadable - git log on " ++ bfs-seed() ++ " answered no date; nothing here is called law until it can be read");
            0;
        }
        def bfs-run-at(epoch) = (Comparable) epoch == 0 ? bfs-no-epoch() : bfs-report(bfs-rows(), epoch);
        def bfs-run() = bfs-run-at(bfs-epoch());
    }
    bfs-run();
}
