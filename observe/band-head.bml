// band-head.bml — what a band says in its comment head, read in Form.
//
// validate.sh asks four things of a band file and two of the verdict manifest: the band's proof
// level (`; PROOF LEVEL: <WORD>`), the staged carrier it names (`; STAGED CARRIER: <path>`) and
// the door that builds it (`; STAGED CARRIER DOOR: <command>`), its head pin (the first
// `Verdict <n>` on a `; ` line of the comment head, which ends at the first code line), and the
// manifest's row for a stem (its name, and its third field, the registered verdict). The shell
// held these as sed and awk lines; they are Form now, and observe/band-head-run.bml is the door.
//
// A key line is the first line anywhere in the file that starts with its exact text; a
// head pin is read only inside the head, so `Verdict: 131 (P1) + 12*42 (P2) = 635` (prose about
// a sum) is never taken for a pin: only `Verdict <digits>` is.
//
// preludes: form-stdlib/core.fk gate/lens-text.bml
section [form.bml] {
    class BandHead {
        // ---- lines of a text; the comment head runs to the first line that is code ----
        def bh-code-line?(l) = (Comparable) len(lx-strip(l)) == 0 ? 0 : (Comparable) lx-at?(l, 0, ";") == 1 ? 0 : 1;
        def bh-head-go(ls, acc) = (Comparable) len(ls) == 0 ? reverse(acc) : (Comparable) bh-code-line?(ls[0]) == 1 ? reverse(acc) : bh-head-go(ls[1:], cons(ls[0], acc));
        def bh-head(text) = bh-head-go(lx-lines(text), []);

        // ---- the remainder of the first line that starts with a prefix ("" when none does) ----
        def bh-after(ls, prefix) = (Comparable) len(ls) == 0 ? "" : (Comparable) lx-at?(ls[0], 0, prefix) == 1 ? substring(ls[0], len(prefix), len(ls[0])) : bh-after(ls[1:], prefix);

        // ---- tokens: a run of upper-case letters and hyphens; a run up to the first space ----
        def bh-level-byte?(b) = ((b >= 65) && (b <= 90)) || (b == 45) ? 1 : 0;
        def bh-level-end(s, i) = i >= len(s) ? i : (Comparable) bh-level-byte?(str_byte_at(s, i)) == 1 ? bh-level-end(s, i + 1) : i;
        def bh-space-end(s) = str_find(s, " ", 0) < 0 ? len(s) : str_find(s, " ", 0);

        def bh-level(text) {
            let r = bh-after(lx-lines(text), "; PROOF LEVEL: ");
            substring(r, 0, bh-level-end(r, 0));
        }
        def bh-carrier(text) {
            let r = bh-after(lx-lines(text), "; STAGED CARRIER: ");
            substring(r, 0, bh-space-end(r));
        }
        def bh-door(text) = bh-after(lx-lines(text), "; STAGED CARRIER DOOR: ");

        // ---- the head pin: digits after the first `Verdict ` that has digits, on a `;` line of the head ----
        def bh-digits-after(l, from) {
            let i = str_find(l, "Verdict ", from);
            i < 0 ? "" : (Comparable) lx-digits-end(l, i + 8) > (i + 8) ? substring(l, i + 8, lx-digits-end(l, i + 8)) : bh-digits-after(l, i + 8);
        }
        def bh-pin-go(ls) {
            (Comparable) len(ls) == 0 ? ""
            : (Comparable) lx-at?(ls[0], 0, ";") == 1 && (Comparable) len(bh-digits-after(ls[0], 0)) > 0 ? bh-digits-after(ls[0], 0)
            : bh-pin-go(ls[1:]);
        }
        def bh-pin(text) = bh-pin-go(bh-head(text));

        // ---- the manifest: whitespace-separated fields; a `#` line is a comment ----
        def bh-ws?(l, i) = i >= len(l) ? 0 : (Comparable) lx-ws-at?(l, i) == 1 ? 1 : 0;
        def bh-tok-end(l, i) = i >= len(l) ? i : (Comparable) bh-ws?(l, i) == 1 ? i : bh-tok-end(l, i + 1);
        def bh-skip(l, i) = i >= len(l) ? i : (Comparable) bh-ws?(l, i) == 1 ? bh-skip(l, i + 1) : i;
        // the n-th field (from 1) of a line, "" when it has fewer
        def bh-field-at(l, i, n) {
            let a = bh-skip(l, i);
            a >= len(l) ? ""
            : (Comparable) n == 1 ? substring(l, a, bh-tok-end(l, a))
            : bh-field-at(l, bh-tok-end(l, a), n - 1);
        }
        def bh-field(l, n) = bh-field-at(l, 0, n);
        def bh-row-for(ls, stem) = (Comparable) len(ls) == 0 ? "" : (Comparable) lx-at?(ls[0], 0, "#") == 0 && (String) bh-field(ls[0], 1) == stem ? ls[0] : bh-row-for(ls[1:], stem);
        def bh-row-name(text, stem) = bh-field(bh-row-for(lx-lines(text), stem), 1);
        def bh-row-pin(text, stem) = bh-field(bh-row-for(lx-lines(text), stem), 3);

        // ---- the door's line: `<command> <path> [<stem>]`; the answer is one word or none ----
        def bh-read(path) = (Comparable) file_size(path) > 0 ? read_file(path) : "";
        def bh-answer(cmd, arg, arg2) =
            (String) cmd == "level" ? bh-level(bh-read(arg))
            : (String) cmd == "carrier" ? bh-carrier(bh-read(arg))
            : (String) cmd == "door" ? bh-door(bh-read(arg))
            : (String) cmd == "pin" ? bh-pin(bh-read(arg))
            : (String) cmd == "row-name" ? bh-row-name(bh-read(arg), arg2)
            : (String) cmd == "row-pin" ? bh-row-pin(bh-read(arg), arg2)
            : (Comparable) len(cmd) == 0 ? "?no question"
            : "?unknown question: " ++ cmd;
        def bh-line-answer(line) {
            let cmd = bh-field(line, 1);
            let arg = bh-field(line, 2);
            let arg2 = bh-field(line, 3);
            bh-answer(cmd, arg, arg2);
        }
    }
}
