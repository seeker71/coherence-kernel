// q38-spec-run.bml — speculative decoding on the Qwen lane, from the model's own MTP head: the measure and its witnesses.
//
//   echo '{}' | ./fkwu observe/q38-spec-run.bml            the plan. Opens nothing.
//   echo '{"go":1,"mode":"mvk"}' | ./fkwu observe/q38-spec-run.bml
//                                                           the small-batch matvec against the lane's wide matvec on real activations
// stdin, one JSON line, all optional: go, mode, span (64), file, prompt.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/form-cli-model-session.fk native/metal/qwen35-dense-spec.fk form-stdlib/bml/qwen38-spec-witness.bml
section [form.bml] {
 class Q38SpecRun {
  def qsr-file() = "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
  def qsr-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def qsr-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def qsr-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("q38-spec", line) : json-node-object([]);
  }
  def qsr-ids(n, i) = i >= n ? [] : cons(1000 + ((i * 37) % 5000), qsr-ids(n, i + 1));
  def qsr-say(s) = print_str("[q38-spec] " ++ s);
  def qsr-times(n, f) = n <= 0 ? 1 : {
   let done = f();
   qsr-times(n - 1, f);
  };
  // n copies of a dispatch in one batch, submitted and waited once: microseconds each
  def qsr-block(label, n, f) {
   metal_batch_concurrent();
   let t0 = host_monotonic_ms();
   let queued = qsr-times(n, f);
   let synced = metal_sync();
   let t1 = host_monotonic_ms();
   qsr-say("block " ++ label ++ ": " ++ n.str() ++ " in " ++ (t1 - t0).str() ++ " ms = " ++ (n <= 0 ? 0 : ((t1 - t0) * 1000) / n).str() ++ " us each");
  }
  // words that differ between two float rows, widest gap in ulp (same-sign: the u32 gap)
  def qsr-ulp-go(a, b, i, n, cnt, widest) = i >= n ? [cnt, widest] : {
   let wa = ln-u32-le(a, i * 4);
   let wb = ln-u32-le(b, i * 4);
   let d = wa > wb ? wa - wb : wb - wa;
   qsr-ulp-go(a, b, i + 1, n, d > 0 ? cnt + 1 : cnt, d > widest ? d : widest);
  };
  // the small-batch matvec against the lane's wide matvec: column t of an NT-wide pass must be the bits of a decode matvec on token t's activations
  def qsr-mvk-col(ctx, qs, tv, ntok, nt, t, rr) {
   let ps = ctx[0];
   let bs = ctx[1];
   let geo = ctx[2];
   let rows = kth-tv-r(tv);
   let cols = kth-tv-c(tv);
   let xt = metal_buf_alloc(cols * 4);
   let yr = metal_buf_alloc(rows * 4);
   let yk = metal_buf_alloc(rows * nt * 4);
   metal_batch_concurrent();
   let c1 = metal_enqueue(ps[32], kth-b16([bs[1], xt], [cols, t * cols]), cols);
   let w1 = q38-mv(ps, tv, xt, yr, 1);
   let k1 = q38s-mv-r(ps, qs, tv, bs[1], yk, nt, rows, 1, rr);
   let a = metal_buf_read(yr, 0, rows * 4);
   let b = metal_buf_read(yk, t * rows * 4, rows * 4);
   let u = qsr-ulp-go(a, b, 0, rows, 0, 0);
   let fa = metal_buf_free(xt);
   let fb = metal_buf_free(yr);
   let fc = metal_buf_free(yk);
   qsr-say("mvk rows/group " ++ rr.str() ++ " NT=" ++ nt.str() ++ " column " ++ t.str() ++ " vs wide matvec on that token: " ++ u[0].str() ++ " of " ++ rows.str() ++ " words differ, widest " ++ u[1].str() ++ " ulp");
  }
  def qsr-mvk-time(ctx, qs, tv, nt, rr) {
   let ps = ctx[0];
   let bs = ctx[1];
   let rows = kth-tv-r(tv);
   let yk = metal_buf_alloc(rows * nt * 4);
   let w = (rows * kth-tv-c(tv) / 32) * 34;
   qsr-block("mvk rows/group " ++ rr.str() ++ " NT=" ++ nt.str() ++ " gate (" ++ (w / 1000000).str() ++ " MB)", 96, () => q38s-mv-r(ps, qs, tv, bs[1], yk, nt, rows, 1, rr));
   let fy = metal_buf_free(yk);
   1;
  }
  // the milliseconds n copies of a dispatch take in one batch
  def qsr-ms(n, f) {
   metal_batch_concurrent();
   let t0 = host_monotonic_ms();
   let queued = qsr-times(n, f);
   let synced = metal_sync();
   host_monotonic_ms() - t0;
  }
  def qsr-min(xs, best) = len(xs) == 0 ? best : qsr-min(xs[1:], xs[0] < best ? xs[0] : best);
  def qsr-max(xs, worst) = len(xs) == 0 ? worst : qsr-max(xs[1:], xs[0] > worst ? xs[0] : worst);
  // the GPU's speed moves by factors between seconds on this machine: variants are raced round by round, the best round of each is its reading
  def qsr-race-go(ctx, qs, tv, nt, yk, rounds, ra, rb, rc, rd) = rounds <= 0 ? [ra, rb, rc, rd] : {
   let ps = ctx[0];
   let bs = ctx[1];
   let rows = kth-tv-r(tv);
   let a = qsr-ms(48, () => q38-mv(ps, tv, bs[1], yk, 1));
   let b = qsr-ms(48, () => q38s-mv-r(ps, qs, tv, bs[1], yk, nt, rows, 1, 2));
   let c = qsr-ms(48, () => q38s-mv-r(ps, qs, tv, bs[1], yk, nt, rows, 1, 4));
   let d = qsr-ms(48, () => q38s-mv-r(ps, qs, tv, bs[1], yk, nt, rows, 1, 8));
   qsr-race-go(ctx, qs, tv, nt, yk, rounds - 1, append(ra, [a]), append(rb, [b]), append(rc, [c]), append(rd, [d]));
  };
  def qsr-race(ctx, qs, tv, nt) {
   let rows = kth-tv-r(tv);
   let yk = metal_buf_alloc(rows * nt * 4);
   let r = qsr-race-go(ctx, qs, tv, nt, yk, 6, [], [], [], []);
   let fy = metal_buf_free(yk);
   qsr-say("gate matvec NT=" ++ nt.str() ++ " best of 6 rounds of 48 (us each): wide(1 col) " ++ ((qsr-min(r[0], 100000) * 1000) / 48).str() ++ ", 2 rows " ++ ((qsr-min(r[1], 100000) * 1000) / 48).str() ++ ", 4 rows " ++ ((qsr-min(r[2], 100000) * 1000) / 48).str() ++ ", 8 rows " ++ ((qsr-min(r[3], 100000) * 1000) / 48).str() ++ "; worst round 2 rows " ++ ((qsr-max(r[1], 0) * 1000) / 48).str());
  }
  def qsr-mvk-sweep(ctx, qs, tv, rr, nt) = nt > 8 ? 1 : {
   let t = qsr-race(ctx, qs, tv, nt);
   qsr-mvk-sweep(ctx, qs, tv, rr, nt + 1);
  };
  def qsr-mvk(ctx, qs, ids) {
   let ps = ctx[0];
   let bs = ctx[1];
   let geo = ctx[2];
   let lay = nth(ctx[3], 0);
   let tv = lay[2];
   let sts = q38-new-state(geo);
   let r = q38-prefill-span-batched(ps, bs, geo, ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
   let ntok = len(ids);
   let c1 = qsr-mvk-col(ctx, qs, tv, ntok, 4, 3, 4);
   let c2 = qsr-mvk-col(ctx, qs, tv, ntok, 8, 7, 4);
   let c3 = qsr-mvk-col(ctx, qs, tv, ntok, 4, 3, 8);
   let c4 = qsr-mvk-col(ctx, qs, tv, ntok, 8, 7, 8);
   let c5 = qsr-mvk-col(ctx, qs, tv, ntok, 1, 0, 8);
   let yw = metal_buf_alloc(kth-tv-r(tv) * 4);
   let tw = qsr-block("wide matvec gate", 96, () => q38-mv(ps, tv, bs[1], yw, 1));
   let fw = metal_buf_free(yw);
   let s2 = qsr-mvk-sweep(ctx, qs, tv, 2, 1);
   let ym = metal_buf_alloc(kth-tv-r(tv) * ntok * 4);
   let tm = qsr-block("mm64 gate at " ++ ntok.str() ++ " tokens", 8, () => metal_enqueue(ps[q38-mm64-index()], md-bind16([kth-tv-h(tv), bs[1], ym], [kth-tv-r(tv), kth-tv-c(tv), ntok, kth-tv-r(tv)], 128, 0, 1, 1), q38-mm64-groups(kth-tv-r(tv), ntok)));
   let fm = metal_buf_free(ym);
   let freed = q38-free-state(sts);
   1;
  }
  def qsr-idstr(xs) = foldl((acc, x) => acc ++ x.str() ++ " ", "", xs);
  def qsr-rate(n, ms) = ms <= 0 ? 0 : (n * 1000) / ms;
  def qsr-rate10(n, ms) = ms <= 0 ? 0 : (n * 10000) / ms;
  // the plain greedy decode and the speculative one, from a fresh state each, back to back: the same ids or the speculation is wrong
  def qsr-plain(ctx, ids, n) {
   let sts = q38-new-state(ctx[2]);
   let r = q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
   let l0 = metal_live();
   let t0 = host_monotonic_ms();
   let spoken = q38-generate(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], r[0], len(ids), n, [], []);
   let t1 = host_monotonic_ms();
   let l1 = metal_live();
   let freed = q38-free-state(sts);
   [spoken, t1 - t0, r[0], (l1[11] - l0[11]) / 1000, l1[7] - l0[7]];
  }
  def qsr-specrun(ctx, qs, sx, ids, n, k, phased) {
   let sts = q38-new-state(ctx[2]);
   let r = q38s-prefill(ctx, qs, sts, sx, ids);
   let t0 = host_monotonic_ms();
   let g = q38s-generate-a(ctx, qs, sts, sx, ids, r[0], k < 0 ? 0 - k : k, n, phased, k < 0 ? 1 : 0);
   let t1 = host_monotonic_ms();
   let freed = q38-free-state(sts);
   [g[0], t1 - t0, g[1], r[0], g[2]];
  }
  // a negative k asks for the adaptive policy with at most -k drafts a step
  def qsr-kmax(k) = k < 0 ? 0 - k : k;
  def qsr-klabel(k) = k < 0 ? "adaptive<=" ++ (0 - k).str() : k.str();
  // the share of the steps that tried draft position j and took it
  def qsr-hits(stats, j, kmax) = j > kmax ? "" : "p" ++ j.str() ++ " " ++ ((stats[8 + j] * 100) / (stats[8 + kmax + j] <= 0 ? 1 : stats[8 + kmax + j])).str() ++ "% of " ++ stats[8 + kmax + j].str() ++ "  " ++ qsr-hits(stats, j + 1, kmax);
  def qsr-trace(tr) = foldl((acc, t) => acc ++ t[0].str() ++ ":" ++ t[1].str() ++ ":" ++ t[2].str() ++ ":" ++ t[3].str() ++ " ", "", tr);
  def qsr-report(label, a, b, n, k) {
   let sa = qsr-idstr(a[0]);
   let sb = qsr-idstr(b[0]);
   let st = b[2];
   let steps = st[0] <= 0 ? 1 : st[0];
   qsr-say(label ++ " k=" ++ qsr-klabel(k) ++ " first token " ++ a[2].str() ++ "/" ++ b[3].str() ++ ": ids " ++ ((String) sa == sb ? "IDENTICAL" : "DIFFER") ++ "; plain " ++ n.str() ++ " tokens in " ++ a[1].str() ++ " ms = " ++ (qsr-rate10(n, a[1]) / 10).str() ++ "." ++ (qsr-rate10(n, a[1]) % 10).str() ++ " tok/s; spec " ++ (qsr-rate10(n, b[1]) / 10).str() ++ "." ++ (qsr-rate10(n, b[1]) % 10).str() ++ " tok/s in " ++ b[1].str() ++ " ms = " ++ (b[1] <= 0 ? 0 : (a[1] * 100) / b[1]).str() ++ " percent of the plain speed");
   qsr-say(label ++ " steps " ++ st[0].str() ++ ", tokens per step " ++ ((n * 100) / steps).str() ++ "/100; acceptance " ++ qsr-hits(st, 1, qsr-kmax(k)) ++ "; per step: host before wait " ++ (st[1] / steps).str() ++ " ms, wait " ++ (st[2] / steps).str() ++ " ms; sections (phased) restore " ++ (st[3] / steps).str() ++ ", catch-up+draft " ++ (st[4] / steps).str() ++ ", chain " ++ (st[5] / steps).str() ++ ", check " ++ (st[6] / steps).str() ++ " ms; device busy " ++ (st[7] / steps).str() ++ " ms and " ++ (st[8] / steps).str() ++ " dispatches a step (plain: " ++ (a[3] / n).str() ++ " ms and " ++ (a[4] / n).str() ++ " dispatches a token)");
   qsr-say(label ++ " trace accepted:step ms:device busy ms:host-before-wait ms " ++ qsr-trace(b[4]));
   (String) sa == sb ? 1 : qsr-say(label ++ " spec ids: " ++ sb);
  }
  def qsr-insert(x, xs) = len(xs) == 0 ? [x] : x <= xs[0] ? cons(x, xs) : cons(xs[0], qsr-insert(x, xs[1:]));
  def qsr-median(xs) = nth(foldl((acc, x) => qsr-insert(x, acc), [], xs), len(xs) / 2);
  def qsr-short(label, a, b, n, kk) {
   let st = b[2];
   let steps = st[0] <= 0 ? 1 : st[0];
   qsr-say(label ++ " k=" ++ qsr-klabel(kk) ++ ": ids " ++ ((String) qsr-idstr(a[0]) == qsr-idstr(b[0]) ? "IDENTICAL" : "DIFFER") ++ "; plain " ++ (qsr-rate10(n, a[1]) / 10).str() ++ "." ++ (qsr-rate10(n, a[1]) % 10).str() ++ " tok/s, spec " ++ (qsr-rate10(n, b[1]) / 10).str() ++ "." ++ (qsr-rate10(n, b[1]) % 10).str() ++ " tok/s = " ++ (b[1] <= 0 ? 0 : (a[1] * 100) / b[1]).str() ++ " percent; " ++ st[0].str() ++ " steps, " ++ ((n * 100) / steps).str() ++ "/100 tokens a step, acceptance " ++ qsr-hits(st, 1, qsr-kmax(kk)) ++ " step " ++ (b[1] / steps).str() ++ " ms (host before wait " ++ (st[1] / steps).str() ++ ")");
   b[1] <= 0 ? 0 : (a[1] * 100) / b[1];
  }
  // rounds pairs of (plain, speculative) back to back at k drafts: the ratio of each pair, and their median
  def qsr-rounds(ctx, qs, sx, ids, n, kk, rounds, acc) = rounds <= 0 ? acc : {
   let a = qsr-plain(ctx, ids, n);
   let b = qsr-specrun(ctx, qs, sx, ids, n, kk, 0);
   let pct = qsr-short("A/B", a, b, n, kk);
   qsr-rounds(ctx, qs, sx, ids, n, kk, rounds - 1, append(acc, [pct]));
  };
  def qsr-ab(ctx, qs, sx, ids, n, kk, kmax, rounds) = kk > kmax ? 1 : {
   let ratios = qsr-rounds(ctx, qs, sx, ids, n, kk, rounds, []);
   qsr-say("k=" ++ qsr-klabel(kk) ++ " median of " ++ rounds.str() ++ " pairs: " ++ qsr-median(ratios).str() ++ " percent of the plain speed (" ++ foldl((acc, x) => acc ++ x.str() ++ " ", "", ratios) ++ ")");
   qsr-ab(ctx, qs, sx, ids, n, kk + 1, kmax, rounds);
  };
  def qsr-spec(ctx, qs, sx, ids, n, k, phased, kmin, rounds) {
   let w1 = qsr-plain(ctx, ids, n);
   let w2 = qsr-specrun(ctx, qs, sx, ids, n, k, 0);
   qsr-say("warm-up done (weights paged in, pipelines built); plain ids: " ++ qsr-idstr(w1[0]));
   let ab = qsr-ab(ctx, qs, sx, ids, n, kmin, k, rounds);
   let adaptive = (phased == 2) || (phased == 3) ? qsr-ab-adapt(ctx, qs, sx, ids, n, k, rounds) : 1;
   (phased == 1) || (phased == 3) ? qsr-phased(ctx, qs, sx, ids, n, k) : 1;
  }
  // phased: 1 adds a phase-timed run, 2 adds the adaptive policy (at most k drafts) against the plain decode, 3 both
  def qsr-ab-adapt(ctx, qs, sx, ids, n, k, rounds) {
   let ratios = qsr-rounds(ctx, qs, sx, ids, n, 0 - k, rounds, []);
   qsr-say("k=" ++ qsr-klabel(0 - k) ++ " median of " ++ rounds.str() ++ " pairs: " ++ qsr-median(ratios).str() ++ " percent of the plain speed (" ++ foldl((acc, x) => acc ++ x.str() ++ " ", "", ratios) ++ ")");
  }
  def qsr-phased(ctx, qs, sx, ids, n, k) {
   let a2 = qsr-plain(ctx, ids, n);
   let c = qsr-specrun(ctx, qs, sx, ids, n, k, 1);
   let r3 = qsr-report("phased", a2, c, n, k);
   1;
  }
  def qsr-spec-open(ctx, qs, ids, n, k, ph, kmin, rounds) {
   let sx = q38s-open(ctx, k, len(ids));
   let said = qsr-spec(ctx, qs, sx, ids, n, k, ph, kmin, rounds);
   let closed = q38s-close(sx);
   1;
  }
  // the span blocks at ntok tokens, each n times in one batch: what a verification step spends where
  def qsr-tvbytes(tv) = (kth-tv-r(tv) * kth-tv-c(tv) / 32) * 34;
  def qsr-first-full(l, geo) = kth-full?(l, geo[22]) ? l : qsr-first-full(l + 1, geo);
  def qsr-blocks(ctx, qs, sx, ids, ntok) {
   let ps = ctx[0];
   let bs = ctx[1];
   let geo = ctx[2];
   let lays = ctx[3];
   let sts = q38-new-state(geo);
   let r = q38-prefill-span-batched(ps, bs, geo, lays, sts, ctx[4], ctx[5], ctx[6], ids, 0);
   let pos = len(ids);
   let lin = nth(lays, 0);
   let lf = qsr-first-full(0, geo);
   let full = nth(lays, lf);
   let snp = nth(sx[9], 0);
   let variants = [
    ["decode ffn (1 token, wide matvec)", 24, () => q38-ffn(ps, bs, geo, lin)],
    ["decode linear-attn (1 token)", 24, () => q38-linear-attn(ps, bs, geo, lin, nth(sts, 0))],
    ["decode full-attn (1 token) at " ++ pos.str(), 24, () => q38-full-attn(ps, bs, geo, full, nth(sts, lf), pos)],
    ["check ffn ntok " ++ ntok.str(), 24, () => q38s-ffn-span(ps, qs, bs, geo, lin, ntok)],
    ["check linear-attn ntok " ++ ntok.str() ++ " WITH snapshots", 24, () => q38s-linear-attn-span-s(ps, qs, bs, geo, lin, nth(sts, 0), snp, ntok, 1)],
    ["check linear-attn ntok " ++ ntok.str() ++ " without snapshots (the lane's recurrence kernels)", 24, () => q38s-linear-attn-span-s(ps, qs, bs, geo, lin, nth(sts, 0), snp, ntok, 0)],
    ["check full-attn ntok " ++ ntok.str() ++ " (decode-exact attention)", 24, () => q38s-full-attn-span(ps, qs, bs, geo, full, nth(sts, lf), pos, ntok)],
    ["lane full-attn-span ntok " ++ ntok.str() ++ " (mm64, the lane's span attention)", 24, () => q38-full-attn-span(ps, bs, geo, full, nth(sts, lf), pos, ntok)],
    ["decode head (1 token): norm, wide matvec vocab, argmax", 8, () => q38-head(ps, bs, geo, ctx[5], ctx[6])],
    ["check head ntok " ++ ntok.str() ++ ": output_norm span, mvk vocab, argmax", 8, () => q38s-head-check(ctx, qs, sx, ntok)]
   ];
   let r = qsr-racelist(variants, 5, len(variants) * 0, []);
   let freed = q38-free-state(sts);
   1;
  }
  // every variant timed in turn, round after round (the GPU changes speed between seconds here); the best round of each is its reading
  def qsr-round(vs, acc) = len(vs) == 0 ? acc : qsr-round(vs[1:], append(acc, [qsr-ms(vs[0][1], vs[0][2])]));
  def qsr-mins(rows, i, n, acc) = i >= n ? acc : qsr-mins(rows, i + 1, n, append(acc, [qsr-min(foldl((a, row) => append(a, [row[i]]), [], rows), 1000000)]));
  def qsr-racelist(vs, rounds, unused, rows) = rounds <= 0 ? qsr-report-race(vs, qsr-mins(rows, 0, len(vs), [])) : qsr-racelist(vs, rounds - 1, unused, append(rows, [qsr-round(vs, [])]));
  def qsr-report-race(vs, best) = len(vs) == 0 ? 1 : {
   qsr-say("race best-of-rounds: " ++ vs[0][0] ++ ": " ++ ((best[0] * 1000) / vs[0][1]).str() ++ " us each");
   qsr-report-race(vs[1:], best[1:]);
  };
  // does the plain decode slow down as it runs (clocks, position)? chunks of c tokens, the ms of each
  def qsr-drift-go(ctx, sts, id, pos, c, left, acc) = left <= 0 ? acc : {
   let t0 = host_monotonic_ms();
   let spoken = q38-generate(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], id, pos, c, [], []);
   let t1 = host_monotonic_ms();
   qsr-drift-go(ctx, sts, spoken[c - 1], pos + c, c, left - 1, append(acc, [t1 - t0]));
  };
  def qsr-drift(ctx, ids, c, chunks) {
   let sts = q38-new-state(ctx[2]);
   let r = q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
   let ms = qsr-drift-go(ctx, sts, r[0], len(ids), c, chunks, []);
   let freed = q38-free-state(sts);
   qsr-say("plain decode, ms per " ++ c.str() ++ " tokens, from position " ++ len(ids).str() ++ ": " ++ foldl((acc, x) => acc ++ x.str() ++ " ", "", ms));
  }
  // how exact is the check? the plain decode's own head value (the winning logit's bits) at every position, against the value the check
  // computed for the same position in a span: equal words say the check reproduced the decode bit for bit there
  def qsr-bits(ctx, qs, sx, ids, n, k) {
   let w = q38sw-compare(ctx, qs, sx, ids, n, k);
   qsr-say("k=" ++ k.str() ++ ": " ++ n.str() ++ " positions, ids " ++ (w[0] == 1 ? "IDENTICAL" : "DIFFER") ++ ", winning-logit words equal at " ++ w[1].str() ++ ", differ at " ++ w[2].str() ++ (w[2] == 0 ? "" : " (position, decode, check): " ++ q38sw-differ-text(w[6])) ++ "; " ++ q38sw-steps(w[3]).str() ++ " steps");
  }
  def qsr-bits-open(ctx, qs, ids, n, k) {
   let sx = q38s-open(ctx, k, len(ids));
   let w = qsr-bits(ctx, qs, sx, ids, n, k);
   let closed = q38s-close(sx);
   1;
  }
  def qsr-measure(ctx, qs, ids, mode, n, k, ph, kmin, rounds) {
   (String) mode == "bits" ? qsr-bits-open(ctx, qs, ids, n, k) :
   (String) mode == "drift" ? qsr-drift(ctx, ids, 8, 12) :
   (String) mode == "mvk" ? qsr-mvk(ctx, qs, ids) : (String) mode == "spec" ? qsr-spec-open(ctx, qs, ids, n, k, ph, kmin, rounds) : (String) mode == "blocks" ? qsr-blocks-open(ctx, qs, ids, kmin + 1, k + 1) : qsr-say("no such mode: " ++ mode);
  }
  def qsr-blocks-loop(ctx, qs, sx, ids, ntok, last) = ntok > last ? 1 : {
   qsr-say("---- span of " ++ ntok.str() ++ " tokens (" ++ (ntok - 1).str() ++ " drafts) ----");
   let said = qsr-blocks(ctx, qs, sx, ids, ntok);
   qsr-blocks-loop(ctx, qs, sx, ids, ntok + 1, last);
  };
  def qsr-blocks-open(ctx, qs, ids, first, last) {
   let sx = q38s-open(ctx, last, len(ids));
   let looped = qsr-blocks-loop(ctx, qs, sx, ids, first, last);
   let closed = q38s-close(sx);
   1;
  }
  def qsr-open(path, want, n, k, prompt, mode, ph, kmin, rounds) {
   let src = fcmg-src(path);
   let ids = (String) prompt == "" ? qsr-ids(want, 0) : q35-chat-ids(src, prompt);
   let span = len(ids);
   let maxpos = span + n + k + 16;
   let own = fcms-qwen-own(src, maxpos);
   let weights = fcms-weights-bytes(path);
   let granted = mg-lease("q38 spec probe", path, weights, own);
   !mg-granted?(granted) ? print_str("[q38-spec] held: " ++ granted[1]) : {
    let ctx = q38-open-span(path, maxpos, span + 1);
    !((Comparable) q38-context-ok?(ctx) == 1) ? {
     let closed = len(ctx) < 10 ? 0 : q38-close(ctx, []);
     let unleased = mg-release();
     qsr-say("the context did not open: len " ++ len(ctx).str() ++ ", scratch ok " ++ (len(ctx) < 10 ? 0 : q38-handles-ok?(ctx[1])).str() ++ ", layers ok " ++ (len(ctx) < 10 ? 0 : q38-layers-ok?(ctx[3])).str() ++ ", emb " ++ (len(ctx) < 10 ? 0 : kth-tv-h(ctx[4])).str() ++ ", onorm " ++ (len(ctx) < 10 ? 0 : kth-tv-h(ctx[5])).str() ++ ", proj " ++ (len(ctx) < 10 ? 0 : kth-tv-h(ctx[6])).str() ++ ", bs " ++ (len(ctx) < 10 ? "" : ctx[1].str()));
    } : {
     let qs = q38s-pipes(q38s-msl());
     !q38s-pipes-ok?(qs) ? qsr-say("the spec pipelines did not compile: " ++ qs.str()) : {
      let measured = qsr-measure(ctx, qs, ids, mode, n, k, ph, kmin, rounds);
      1;
     };
     let closed = q38-close(ctx, []);
     let unleased = mg-release();
     qsr-say("released");
    };
   };
  }
  def qsr-run() {
   let opts = qsr-opts();
   let path = qsr-text(opts, "file", qsr-file());
   let span = qsr-int(opts, "span", 64);
   let n = qsr-int(opts, "decode", 32);
   let k = qsr-int(opts, "k", 2);
   (Comparable) qsr-int(opts, "go", 0) == 1 ? qsr-open(path, span, n, k, qsr-text(opts, "prompt", ""), qsr-text(opts, "mode", "mvk"), qsr-int(opts, "phased", 0), qsr-int(opts, "kmin", 1), qsr-int(opts, "rounds", 2)) : print_str("[q38-spec] plan: modes mvk, spec (decode n tokens, k drafts); {\"go\":1,\"mode\":\"spec\",\"prompt\":\"...\"} opens the model and measures");
  }
 }
 qsr-run();
}
