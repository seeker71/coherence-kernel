; native-model-nl-form-diagnostic-run.fk — bounded control exchange for the
; 3B NL-to-Form proposal. The framebuffer carries only outcome codes; model
; prompt and response bytes remain in the question-bound native artifact.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/ask-native-lane.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn nmnfd-apply-revise (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound)
                                 (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    (framebuffer-clear)
    ; 3941 = prose/cap, 3942 = revise to a completion-shaped Form example.
    (let outbound (bfc-envelope 0 83905 0 3941 3942))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let applied (nmnfd-apply-revise outbound inbound 3941 3942))
    (let raw (read_file (anl-artifact-path)))
    (let proposal (anl-answer-text raw))
    (let valid (if (ge (str_find proposal "(mul 7 7)" 0) 0) 1 0))
    (let reobserved (if (eq applied 3942) valid 0))
    (let outbound2 (bfc-envelope 0 84005 0 reobserved 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))
    (list "native-model-nl-form-diagnostic"
        "before" 3941 "applied" applied "reobserved-valid-form" reobserved
        "answer-bytes" (str_len proposal)
        "framebuffer-events" (len (framebuffer-events))))
