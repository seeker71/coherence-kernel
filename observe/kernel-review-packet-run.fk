; stdin: proposal path, output path. Form preserves the reviewed text on disk.
; preflight-exec: forbidden
; preludes: form-stdlib/core.fk
(do
    (let proposal (read_line))
    (let output (read_line))
    (write_file output (str_concat (read_file proposal)
        (str_concat "\n\n--- CURRENT NORTH STAR ---\n\n"
            (read_file "docs/fkwu-form-native-north-star.md")))))
