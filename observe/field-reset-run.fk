// field-reset-run.fk — begin a new permanent interning epoch.
// preflight-exec: forbidden
import form-stdlib/bml/field-reset-admission.bml;
//
// The field owner checks every retained process identity and commits under one
// exclusive journal lease. Unknown owners refuse. Historical coordinates,
// held views, gifts and journal bytes remain valid; this is not disk reclamation.
// Refusal exits nonzero. No process is stopped by this door.
section [form.bml] {
    let result = field_reset();
    result==1 ? print(["field-reset",1,"new interning epoch committed; existing identities and gifts retained"]) : form_error("field reset refused: exclusive current ownership was not established");
}
