// Compile ordinary BML source, then observe its owned repeat receiver on fkwu.
// Compiler inputs, emitted code, stdout and stderr remain in the native capture.
// preludes: form-stdlib/bml/bml-repeat-lower.bml form-stdlib/bml/native-source-inventory.bml
// preflight-exec: forbidden
section [form.bml] {
 class BmlRepeatWitness {
  def brc-check(name,got,want) { print(list(name,got,want)); if ((Value) got == want) then 1 else form_error(name); }
  def brc-prefix() = str_concat(".hearth/bml-repeat-",int_to_str(host_pid()));
  def brc-parse(name,source) {
   let path = str_concat(brc-prefix(),str_concat("-",str_concat(name,".bml")));
   write_file_text(path,source);
   let parsed = bml-source-file-parse-executable(path);
   brc-check(str_concat(name," source read completely"),bml-source-exec-parse-ok?(parsed),1);
   path;
  }
  def brc-args(args) = if nil?(args) then empty else cons(bfk-int(head(args)),brc-args(tail(args)));
  def brc-case(name,source,args,expected,held) {
   let image = bcr-source(brc-parse(name,source));
   brc-check(str_concat(name," lowering"),nth(image,1),empty);
   let path = str_concat(brc-prefix(),str_concat("-",str_concat(name,".fk")));
   let invoke = bfk-form(list("brw-run","start",bfk-form(cons("list",brc-args(args))),bfk-int(expected),"200000",bfk-int(held)));
   write_file_text(path,str_concat("; preludes: form/form-stdlib/tests/bml-repeat-runtime.bml\n",bfk-do(list(bfk-let("start",head(image))),invoke)));
   let ran = nsi-capture(list("./fkwu",path));
   print(list(name,"evidence",nsi-evidence(ran))); print(nsi-text(ran)); print(read_file(nsi-path(nsi-evidence(ran),"stderr")));
   brc-check(str_concat(name," native exit"),nsi-status(ran),0);
   brc-check(str_concat(name," native answer"),bfk-decode(nsi-text(ran),read_file(nsi-path(nsi-evidence(ran),"stderr"))),list(1,0));
  }
  def brc-branches(n) = if (n <= 0) then "" else str_concat("if (n > 0) s = s + 1; else s = s - 1; ",brc-branches(n - 1));
  def brc-main() {
   brc-case("while","int Tri(int n) { int s = 0; int i = 0; while (i < n) { s = s + i; i = i + 1; } return s + i; }",list(20000),200010000,0);
   brc-case("empty","int Empty(int n) { int s = 0; while (n < 0) { s = s + 1; } return s; }",list(0),0,0);
   brc-case("for","int Sum(int n) { int s = 0; for (int i = 0; i < n; i++) { if (i == 2) continue; if (i == 6) break; s = s + i; } return s; }",list(20),13,0);
   brc-case("nested","int Pairs(int n) { int hits = 0; outer: for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { if (j > i) continue outer; if (i == 190) break outer; if (i * j == 3600) hits = hits + 1; } } return hits; }",list(200),10,0);
   brc-case("return","int Find(int n) { for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { if (i == 3 && j == 2) return i * 100 + j; } } return 0; }",list(10),302,0);
   brc-case("parameters","int Dec(int n, int step) { int s = 0; while (n > 0) { s = s + n; n = n - step; } return s; }",list(7,2),16,0);
   brc-case("scope","int Scope(int n) { int s = 0; int i = 0; while (i < n) { { int i = 10; s = s + i; } i = i + 1; } for (int j = 0; j < n; j++) s = s + 1; return s + i; }",list(3),36,0);
   brc-case("branches",str_concat("int Branch(int n) { int s = 0; while (n > 0) { ",str_concat(brc-branches(16),"n = n - 1; } return s; }")),list(2),32,0);
   brc-case("care","int Need(int n) { while (n > 0) { n = n; } return n; }",list(1),0,1);
   let refused = bcr-source(brc-parse("effect","int Effect(int n) { while (n > 0) { n = Other(n); } return n; }"));
   brc-check("unsupported effect emits no partial program",head(refused),"");
   brc-check("unsupported effect names its need",len(nth(refused,1)) > 0,1);
   let broken = str_concat(brc-prefix(),"-unread.bml"); write_file_text(broken,"int Unread(int n) { while (n >");
   let unread = bcr-source(broken); brc-check("unread source never produces a partial program",head(unread),"");
   brc-check("unread source names its need",nth(unread,1),list("repeat/source-unread"));
   1;
  }
 }
 brc-main();
}
