; kernel-length-run.fk — what the body's emitters will hand the compiler, before any GPU runs:
; every kernel of a unit with its statements and the loops they sit inside. A shape neutral in
; arithmetic, threads and memory can still be decided by the length of its straight-line body,
; and the emitter knows that length at emit time. No dispatch happens here.
; preflight-exec: forbidden
; preludes: form/form-stdlib/kernel-length-lens.bml form/form-stdlib/ear-msl.fk form/form-stdlib/q8-0-msl.fk form/form-stdlib/q6k-msl.fk
(do
    (print_str (kl-frame "the ear's own kernels" (kl-rows (em-unit))))
    (print_str (kl-frame "the Q8_0 family" (kl-rows (str_concat (q80-msl-unit "form_q80_dequant_f32" "form_q80_matvec_f32" "form_q80_matvec_lane_f32") (q80-matvec-tg3-body "form_q80_matvec_tg3_f32")))))
    0)
