; session-neutral-semantic-reflection-live.fk — two actual turns rebased inward.
; preludes: cognition/session-neutral-semantic-reflection.fk

(do
  (defn snsrl-print-receipt (name receipt)
    (do
      (print name)
      (print " before=") (print (int_to_str (snsr-r-before receipt)))
      (print " reflected=") (print (int_to_str (snsr-r-reflected receipt)))
      (print " retained=") (print (int_to_str (snsr-r-retained receipt)))
      (print " after=") (print (int_to_str (snsr-r-after receipt)))
      (print "\n") 0))
  (let runtime (snsf-open))
  (let request (snsf-resolve-text runtime "en"
    "can we extend this to all symbols to words in most sessions so that we can have better response coverage of the words we are using to ask and respond with a native semantic frequency understanding of which words / symbols / tokens we are using"))
  (let response (snsf-resolve-text runtime "en"
    (read_file "observe/fixtures/2026-08-22-form-native-dialogue-response.txt")))
  (let turn-one (snsr-rebase-receipt (empty) request))
  (let turn-two (snsr-rebase-receipt (snsr-r-active turn-one) response))
  (let active (snsr-r-active turn-two))
  (let trust (snsr-by-address active (snsf-concept-address 490)))
  (let first-address (snsr-e-address (head active)))
  (let first-address-surfaces (snsr-by-address active first-address))
  (print "session-neutral-semantic-reflection\n")
  (print "130000=lexical-supply-audit-only\n")
  (print "internal-witness=request-and-response-arrivals\n")
  (snsrl-print-receipt "turn-1-request" turn-one)
  (snsrl-print-receipt "turn-2-response" turn-two)
  (print "turn-1-witness=")
  (print (int_to_str (snsr-internal-witness (empty) request)))
  (print "/7\nturn-2-witness=")
  (print (int_to_str (snsr-internal-witness (snsr-r-active turn-one) response)))
  (print "/7\n")
  (print "active-unique=") (print (int_to_str (snsr-all-unique? active)))
  (print " active-valid=") (print (int_to_str (snsr-entries-valid? active)))
  (print " first-address-reverse-surfaces=")
  (print (int_to_str (len first-address-surfaces)))
  (print " trust-address-present-in-these-turns=") (print (int_to_str (len trust)))
  (print "\n")
  0)
