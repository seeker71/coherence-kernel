; twin-census-take.fk — read the twin sensor's frame the way the glass reads it.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/twin-glass.bml
;
; The twin census gives its rows into a gift frame under its own publisher and
; states its cadence INSIDE the frame, so no roster edit is owed for a new sensor.
; This door is the proof of the other half: the rows a taker gets back are the same
; cells the census built, seq-first, no wire and no parser between.
;
; A frame nobody is giving is named absent, not empty — the same honesty the census
; itself keeps about a door it could not measure. Run the census door first; it
; holds its frame open for twenty seconds:
;
;     ./fkwu observe/twin-census-run.fk &
;     ./fkwu observe/twin-census-take.fk

(do
    (defn tct-value (r)
        (if (str_eq (fgo-value-kind r) "text") (fgo-text-value r) (int_to_str (fgo-int-value r))))
    (defn tct-row (r)
        (print (bcs-cat (list "  " (fgo-id r) "  " (tct-value r) " " (fgo-unit r) "   " (fgo-label r)))))
    (defn tct-rows (rs)
        (if (nil? rs) 0 (do (let said (tct-row (head rs))) (tct-rows (tail rs)))))

    (let standing (fgsr-standing? (TWCSensor)))
    (let held (fgsr-take (TWCSensor) (fgsr-held -1 -1 (list))))
    (let rows (fgsr-held-rows held))
    (let a (print ""))
    (if (eq standing 0)
        (print (str_concat "  no twin frame standing under " (fgsr-publisher (TWCSensor))))
        (do (let b (print (bcs-cat (list "  twin frame " (fgsr-publisher (TWCSensor))
                                         "  seq " (int_to_str (fgsr-held-seq held))
                                         "  cadence " (int_to_str (fgsr-held-cadence held)) " ms"
                                         "  " (int_to_str (len rows)) " rows"))))
            (let c (print ""))
            (tct-rows rows)))
    (len rows))
