; qwen38-resident-run.fk — two sentences from ONE admission, and what the second
; one did not have to pay.  Effectful: do not preflight.
;
; The first turn admits the model (whole-file SHA-256 seal, tensor views, kernels)
; and answers.  The second turn is handed what the first one earned and answers
; again.  Both wall times are printed, so the saving is a measurement rather than a
; claim, and the residence is released at the end with its handle count checked.
;
; preludes: form/form-stdlib/form-cli-model-generate.fk form/form-stdlib/model-registry.bml

(do
    (let path (mr-path (mr-find "qwen38-q8")))
    (let t0 (now_unix_ms))
    (let one (fcmg-generate-resident (fcmr-none) path "Say one short sentence about the sky." 32))
    (let t1 (now_unix_ms))
    (let two (fcmg-generate-resident (nth one 1) path "Say one short sentence about the sea." 32))
    (let t2 (now_unix_ms))
    (let released (fcmr-release-ok? (nth two 1)))
    (let t3 (now_unix_ms))
    (print_str "── turn 1 (admission + generation) ──")
    (print_str (nth one 0))
    (print_str (str_concat "turn1_wall_ms " (int_to_str (sub t1 t0))))
    (print_str "── turn 2 (resident) ──")
    (print_str (nth two 0))
    (print_str (str_concat "turn2_wall_ms " (int_to_str (sub t2 t1))))
    (print_str (str_concat "turn1_held_residence " (int_to_str (fcmr-live? (nth one 1)))))
    (print_str (str_concat "turn2_held_residence " (int_to_str (fcmr-live? (nth two 1)))))
    (print_str (str_concat "release_ok " (int_to_str released)))
    (print_str (str_concat "release_wall_ms " (int_to_str (sub t3 t2))))
    0)
