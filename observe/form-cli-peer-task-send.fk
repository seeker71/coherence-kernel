; form-cli-peer-task-send.fk — short-lived Form-native client for the resident
; peer spool. No HTTP, recursive form-cli process, or shell ring is involved.
;
; stdin lines: task spool, fifo bell, turn, kind, task-body file.
; The body file may contain arbitrary newlines. One scannerless frame is
; appended atomically before the FIFO wake edge is written.
;
; preludes: form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk

(do
    (defn fcpts-line (name value)
        (print_str (str_concat "form-peer-client "
            (str_concat name (str_concat "=" (str_concat value "\n"))))))
    (defn fcpts-int (name value) (fcpts-line name (int_to_str value)))
    (let spool (read_line))
    (let bell (read_line))
    (let turn (str_to_int (read_line)))
    (let kind (read_line))
    (let body-path (read_line))
    (let body (read_file body-path))
    (if (or (nothing? body) (or (le turn 0) (str_eq kind "")))
        (do
            (fcpts-line "signal" "nothing")
            (fcpts-line "reason" "task-input-absent")
            0)
        (do
            (let frame (str_concat (fcpa-task-frame turn kind body) "\n"))
            (let appended (sbt-append spool frame))
            (if (lt appended 0)
                (do
                    (fcpts-line "signal" "failure")
                    (fcpts-line "reason" "task-append-refused")
                    0)
                (do
                    (let rung (sbt-ring bell))
                    (fcpts-line "signal" (if (lt rung 0) "failure" "value"))
                    (fcpts-int "appended-bytes" appended)
                    (fcpts-int "ring-result" rung)
                    (if (lt rung 0) 0 1))))))
