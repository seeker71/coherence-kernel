; bearing-census-run.fk — run a real proof, then ask the body which of its own
; composed doors that proof stood on.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/bearing-glass.bml learn/tests/homecoming-distillation-corpus-band.fk
;
; The workload is the corpus band — a proof this body actually runs, not a
; benchmark written to be measured. It runs IN THIS PROCESS, because the heat
; ledger belongs to the process that walked; a census reading another kernel's
; page sees only its top three, and only while that kernel stands.
;
; The order is the whole method: WORK, then SNAPSHOT the ledger, then think.
; Every step the census itself takes lands after the snapshot, so the measure
; never appears in its own reading.
;
; A prelude binds doors without running the file's top-level form (witnessed
; 2026-09-07), so the workload here is an explicit call and nothing else runs
; behind it.
;
; The sister door is observe/bearing-census-locale-run.fk: the same census over
; the locale-row walk, which is where this body's string doors actually live.

(do
    ; the files the workload's doors live in. A hot row's unit names the RESOLUTION
    ; FRAME, not always the file — a band loaded as a prelude reports every one of its
    ; doors under core.fk — so the census is handed the real files and finds each door
    ; by name.
    (defn bcr-sources ()
        (list "form/form-stdlib/core.fk"
              "learn/homecoming-distillation-corpus.fk"
              "learn/tests/homecoming-distillation-corpus-band.fk"))
    (defn bcr-label () "the corpus band")
    (defn bcr-hold-ms () 20000)

    (let t0 (now_unix_ms))
    (let verdict (homecoming-distillation-corpus-band))
    (let t1 (now_unix_ms))
    (let rows (kernel_hot_rows (BCSTopN)))
    (let walked (bgl-walked))

    (let worst (bgl-witness rows walked (sub t1 t0) (bcr-label) (bcr-sources)))
    (let waited (print (str_concat "  workload verdict " (int_to_str verdict))))
    (let held (host_sleep_ms (bcr-hold-ms)))
    worst)
