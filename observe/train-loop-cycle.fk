; train-loop-cycle.fk — one unattended cycle: observe, decide, execute, and a
; ledger row the next cycle can read. The retraining trigger the north star
; lacked: cron or a hand runs this one cell; everything else is the body's.
;
; The ledger is append-only at learn/train-loop-ledger.txt — one line per
; cycle: stamp, adapter, the four permille readings, the directive, the
; outcome's first line. tlr-plateau? can read the facts column of the last
; rows before anyone retrains blind.
;
; preludes: learn/train-loop-observe.fk learn/train-loop-execute.fk

(do
    (defn tlc-adapter ()
        "/Users/ursmuff/.coherence-network/form-train-runs/homecoming-authoring-adapter-20260826-2120")
    (defn tlc-fused-out ()
        "/Users/ursmuff/.coherence-network/form-train-runs/form-llama-3b-fused-authoring-20260826")
    (defn tlc-ledger () "learn/train-loop-ledger.txt")

    (defn tlc-stamp () (fqmn-trim-like (host-exec "date '+%Y-%m-%d %H:%M'" "")))

    (defn tlc-row (stamp o d outcome)
        (str_concat stamp
        (str_concat "  fmt=" (str_concat (int_to_str (tlr-format o))
        (str_concat " facts=" (str_concat (int_to_str (tlr-facts o))
        (str_concat " fabri=" (str_concat (int_to_str (tlr-fabri o))
        (str_concat " abstain=" (str_concat (int_to_str (tlr-abstain o))
        (str_concat "  -> " (str_concat d
        (str_concat "  | " (str_concat outcome "\n"))))))))))))))

    (defn tlc-append (line)
        (do (let prev (read_file (tlc-ledger)))
            (write_file (tlc-ledger)
                (str_concat (if (nothing? prev) "" prev) line))))

    (defn tlc-outcome-line (r)
        (if (nothing? r) "nothing"
            (if (eq (str_len r) 0) "done" (fqmn-trim-like r))))

    (do
        (print "cycle: observing...\n")
        (let o (tlo-observe (tlc-adapter) 6))
        (if (nothing? o)
            (do (print "observe: nothing — model unreachable; no ledger row invented\n") 0)
            (do
                (let d (tlr-decide o))
                (if (nothing? d)
                    (do (tlc-append (tlc-row (tlc-stamp) o "NOTHING" "a mind is needed"))
                        (print "decide: nothing — surfaced to the ledger\n") 0)
                    (do
                        (print (str_concat "decide: " (str_concat d "\n")))
                        (let r (tle-execute d (tlc-adapter) (tlc-fused-out)))
                        (let line (tlc-row (tlc-stamp) o d (tlc-outcome-line r)))
                        (tlc-append line)
                        (print line)
                        0))))))
