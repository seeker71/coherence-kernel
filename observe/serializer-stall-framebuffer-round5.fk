; serializer-stall-framebuffer-round5.fk — replay the missed observation through
; the actual thought framebuffer and runtime framebuffer. It learns a bounded
; structural redirect: deeply nested concat -> staged concat, before another wait.
import "thought-framebuffer.fk"
; witnessed: 2026-07-21 -> first prediction refuted at correlation 0;
; learned boundary 8 then pre-ground/post-ground both:
; [nothing,0,1,5101,10,6,8,1,1,1,1,1,2,2,10000,123,1]
(do
  (defn ssf5-max-depth-loop (s i depth best)
    (if (ge i (str_len s)) best
      (do (let b (str_byte_at s i))
        (let next (if (eq b 40) (add depth 1) (if (eq b 41) (sub depth 1) depth)))
        (ssf5-max-depth-loop s (add i 1) next (if (gt next best) next best)))))
  (defn ssf5-max-depth (s) (ssf5-max-depth-loop s 0 0 0))
  (defn ssf5-slice-loop (s i end out)
    (if (ge i end) out
      (ssf5-slice-loop s (add i 1) end
        (str_concat out (byte_to_str (str_byte_at s i))))))
  (defn ssf5-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (ssf5-match s i p (add j 1)) 0))))
  (defn ssf5-find (s p i) (if (gt (add i (str_len p)) (str_len s)) -1
    (if (eq (ssf5-match s i p 0) 1) i (ssf5-find s p (add i 1)))))
  (defn ssf5-row-source (s)
    (do (let a (ssf5-find s "(defn cic5-row" 0))
      (let b (ssf5-find s "(defn cic5-lanes" a))
      (if (or (lt a 0) (lt b 0)) "" (ssf5-slice-loop s a b ""))))
  ; Exact failed expression family retained as evidence, not re-executed blindly.
  (let failed-shape "(str_concat a (str_concat b (str_concat c (str_concat d (str_concat e (str_concat f (str_concat g (str_concat h (str_concat i (str_concat j k)))))))))))")
  (let current-source (read_file "cognition/core-inquiry-cascade-round5.fk"))
  (let current-shape (ssf5-row-source current-source))
  (let failed-depth (ssf5-max-depth failed-shape))
  (let current-depth (ssf5-max-depth current-shape))
  ; Learn the separating boundary from observed failed/successful shapes.
  (let threshold (div (add failed-depth current-depth) 2))
  (let predicted-stall (if (gt failed-depth threshold) 1 0))
  (let predicted-current-result (if (le current-depth threshold) 1 0))
  (let current-result (if (gt (str_len (read_file ".form-core-inquiry-cascade-v5.state")) 0) 1 0))
  ; The 60-second bounded attempt is represented as an exhausted frame; the
  ; alternate trace is grounded by the current persisted successful execution.
  (let before (list (fb-frame 0 1 1)
    (fb-stall-frame 1 "serialize-nested" "serialize-staged" 60 60)))
  (let after (list (fb-frame 0 1 1) (fb-frame 1 current-result 1)))
  (let divergence (diverge before after))
  (let learned (fb-alternate-learned? before after))
  ; Feed the two structural observations through the live runtime framebuffer.
  (framebuffer-clear)
  (let failed-node (fb_record (intern_trivial_int failed-depth)
    "serializer-stall-framebuffer-round5.fk" 1))
  (let current-node (fb_record (intern_trivial_int current-depth)
    "serializer-stall-framebuffer-round5.fk" 2))
  (let runtime-frames (len (framebuffer-events)))
  (let correlation (if (and (eq predicted-stall 1)
    (and (eq predicted-current-result current-result) (eq learned 1))) 10000 0))
  (let state (str_concat "serializer-shape-learning-v1\nrule=max-depth<=learned-threshold=>run;else=>stage\n"
    (str_concat "threshold=" (str_concat (int_to_str threshold)
    (str_concat "\nsamples=2\ncorrelation-bp=" (str_concat (int_to_str correlation) "\n"))))))
  (let saved (write_file ".form-serializer-shape-learning.state" state))
  (let success (if (and (eq runtime-frames 2)
    (and (eq divergence 1) (and (eq correlation 10000) (gt saved 0)))) 1 0))
  ; [nothing, 0, 1, learning-node, failed depth, current depth, threshold,
  ;  predicted stall, predicted current result, observed current result,
  ;  divergence, learned alternate, runtime frames, samples, correlation bp,
  ;  bytes saved, success]
  (list (nothing) 0 1 5101 failed-depth current-depth threshold predicted-stall
    predicted-current-result current-result divergence learned runtime-frames 2
    correlation saved success))
