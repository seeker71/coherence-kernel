; WAV path, optional language, stream path, cancellation file and event path on stdin.
; preflight-exec: forbidden
; preludes: form-stdlib/native-whisper-transcribe.bml
(do
 (defn nwr-line () (do (let value (read_line)) (if (nothing? value) "" (trim value))))
 (let path (nwr-line)) (let hint (nwr-line)) (let stream (nwr-line)) (let cancel (nwr-line)) (let events (nwr-line))
 (let result (nwt-transcribe (nws-base) path hint stream cancel events))
 (print_str (str_concat (json-emit-precise result) "\n"))
 (if (str_eq (sti-value result "status") "completed") 0 (form_error "native Whisper returned an incomplete transcription; inspect the result and events")))
