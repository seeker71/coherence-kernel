// WAV path, optional language, stream path, cancellation file and event path on stdin.
// preflight-exec: forbidden
import form-stdlib/native-whisper-transcribe.bml;
section [form.bml] {
    def nwr-line() = {
        let value = read_line();
        nothing?(value) ? "" : trim(value);
    };
    let path = nwr-line();
    let hint = nwr-line();
    let stream = nwr-line();
    let cancel = nwr-line();
    let events = nwr-line();
    let result = nwt-transcribe(nws-base(), path, hint, stream, cancel, events);
    print_str((json-emit-precise(result) + "\n"));
    (String) sti-value(result, "status") == "completed" ? 0 : form_error("native Whisper returned an incomplete transcription; inspect the result and events");
}
