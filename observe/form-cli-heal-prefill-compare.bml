// preflight-exec: forbidden
// Real local Q4 comparison. No training, remote call, or living source writes.
// preludes: form-stdlib/form-cli-model-session.fk
section [form.bml] {
    class HealPrefillComparison {
        def fhpc-run() {
            let path = mr-path(mr-find("qwen38-q4"));
            let seal = qaf-seal-verdict(path);
            let x = qsx-load(path);
            let ctx = qsx-open-span(path, 32, x, 4);
            let a = q38-new-state(nth(ctx, 2));
            let b = q38-new-state(nth(ctx, 2));
            let ids = take(4, qsx-chat-ids(nth(ctx, 7), "check", x));
            let begin = now_unix_ms();
            let sequential = q38-prefill(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), a, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), ids, 0);
            let middle = now_unix_ms();
            let batched = q38-prefill-span-sliced(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), b, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), ids, 0, 4);
            let end = now_unix_ms();
            let freed = q38-free-state(b);
            let expected = q38-close-expected(ctx, a);
            let released = q38-close(ctx, a);
            print(list("sequential-ms", sub(middle, begin), "batched-ms", sub(end, middle), "positions", len(ids), "sequential", sequential, "batched", batched));
            add(if eq(seal, 1) then 1 else 0, add(if eq(len(ids), 4) then 2 else 0, add(if eq(head(sequential), head(batched)) then 4 else 0, add(if and(eq(nth(sequential, 1), 4), eq(nth(batched, 1), 4)) then 8 else 0, if eq(released, expected) then 16 else 0))));
        }
    }
    0;
}
