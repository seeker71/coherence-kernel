; perception-rows-run.fk — a day the body perceived, written as rows.
;
; stdin line 1: what to read. A path ending in ".spool" is one spool; any
;   other path is a ROOT swept for <root>/<entry>/.hearth/ear.spool, so a
;   machine whose hands each keep their own ear is read in one pass.
;   Blank -> this checkout's own .hearth/ear.spool.
; stdin line 2: the training folder (blank -> the native one). The rows land
;   in perception.jsonl beside the other row lanes, and lv-emit folds them
;   into train the way it folds the distilled and the Rumi rows.
;
; Effectful on that folder only: it reads spools and writes rows. Nothing
; here opens the microphone; the perception was already had.
; preflight-exec: forbidden
; preludes: form/form-stdlib/perception-rows.bml
(do
    (defn prr-say (k v) (print_str (str_concat "perception-rows " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn prr-trim (s) (if (nothing? s) "" (trim s)))
    (defn prr-or (s d) (if (eq (str_len s) 0) d s))
    (defn prr-one? (p) (ge (str_find p ".spool" 0) 0))
    (defn prr-live? (p) (gt (file_size p) 0))
    ; every hand's ear under one root, in the order the tree lists them
    (defn prr-paths (root names acc)
        (if (eq (len names) 0) (reverse acc)
            (do (let p (str_concat root (str_concat "/" (str_concat (head names) "/.hearth/ear.spool"))))
                (prr-paths root (tail names) (if (prr-live? p) (cons p acc) acc)))))
    ; the first spool opens the row file; the rest are appended to it
    (defn prr-fold (paths data i acc)
        (if (eq (len paths) 0) acc
            (do (let r (if (eq i 0) (pr-emit (head paths) data) (pr-append (head paths) data)))
                (prr-fold (tail paths) data (add i 1)
                    (list (add (nth acc 0) (nth r 0)) (add (nth acc 1) (nth r 1))
                          (add (nth acc 2) (nth r 2)) (add (nth acc 3) (nth r 3))
                          (add (nth acc 4) 1))))))

    (let want (prr-or (prr-trim (read_line)) (PRSpool)))
    (let data (prr-or (prr-trim (read_line)) (LVData)))
    ; stdin line 3: a school folder of its own for these rows alone (blank -> none)
    (let school (prr-trim (read_line)))
    (let paths (if (prr-one? want)
        (if (prr-live? want) (list want) (list))
        (prr-paths want (fs-list want) (list))))
    ; the gate asked of what it wrote: every line of every spool, offered to
    ; the rows themselves. Anything but zero is a leak and the number is the count.
    (defn prr-leaks (paths rowtext acc)
        (if (eq (len paths) 0) acc
            (do (let g (pr-leak-scan (head paths) rowtext))
                (prr-leaks (tail paths) rowtext (list (add (nth acc 0) (head g)) (add (nth acc 1) (nth g 1)))))))

    (if (eq (len paths) 0)
        (prr-say "signal" (str_concat "nothing reason=no-spool-with-frames at=" want))
        (do (let n (prr-fold paths data 0 (list 0 0 0 0 0)))
            (let g (prr-leaks paths (pr-rows-text data) (list 0 0)))
            (prr-say "gate" (pr-cat (list
                "found=" (int_to_str (nth g 1))
                " spot-checked=" (int_to_str (head g)) " lines against the rows"
                " structural=attested-frames-carry-words-and-there-were=" (int_to_str (nth n 2)))))
            (prr-say "wrote" (pr-cat (list
                "spools=" (int_to_str (nth n 4))
                " frames=" (int_to_str (nth n 0))
                " rows=" (int_to_str (add (nth n 1) (mul 2 (nth n 4))))
                " moments=" (int_to_str (nth n 1))
                " attested=" (int_to_str (nth n 2))
                " shapes=" (int_to_str (nth n 3))
                " out=" (pr-out-path data))))
            (if (eq (str_len school) 0) 0
                (prr-say "school" (pr-cat (list "rows=" (int_to_str (pr-school data school)) " at=" school))))))
    0)
