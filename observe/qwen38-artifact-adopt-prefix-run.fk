; Adopt bytes carried by curl into Form's rolling-integrity ledger.  The prefix
; is not trusted: Form rehashes it from byte zero with the M4 SHA JIT, aligns to
; a complete SHA block, then atomically records the raw compression state.
; Effectful run cell: do not preflight.
; preludes: form/form-stdlib/qwen35-artifact-fetch.fk

(do
    (let spec (qaf-default-spec))
    (let manifest (qaf-observe-manifest spec))
    (let actual (file_size (qaf-spec-target spec)))
    (let aligned (sub actual (mod actual 64)))
    (if (not (qaf-manifest-ready? manifest))
        (list "refused" "manifest" (qaf-manifest-detail manifest))
        (if (or (le aligned 0) (gt aligned (qaf-manifest-size manifest)))
            (list "refused" "prefix-boundary" aligned (qaf-manifest-size manifest))
            (do
                (let state (saj-file-prefix-state (qaf-spec-target spec) aligned))
                (let committed (qaf-commit-offset spec aligned state))
                (list "adopted" committed actual aligned (str_len state) (metal_status)))))
)
