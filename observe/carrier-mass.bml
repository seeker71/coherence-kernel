// Form reads current source bytes, counts newlines and classifies paths.
// Git supplies one NUL-delimited inventory. All source rows, including the
// weighted field's exclusions, remain in .hearth/carrier-mass-current.json.
// Unknown files and incomplete reads stay visible; an incomplete source read
// refuses a mass. Extension and shebang candidates include target-language
// specimens and proof engines: this inventory does not assert runtime roles.
// The weighted field excludes node_modules and seedbank. Its encoding is
// seed-lines * 10^9 + shell-lines * 10^3 + lexical host-exec-call files.
// The same term is used for continuity; shell-lines includes other languages.
// Calls are lexical candidates, not a process trace. Native execution and
// source ownership need their own observations.
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/form-fs.fk form-stdlib/organ-health.bml form-stdlib/bml/native-source-inventory.bml

section [form.bml] {
    class FormCarrierMass {
        thought carrier-mass-pattern = list("class-is-a-row", "inventory-needs-child-status", "native-source-byte-reading", "other-hides-nothing", "lexical-call-shape", "complete-evidence-retained");

        def cm-nl() = byte_to_str(10);
        def cm-seed() = "runtime/fkwu-uni.c";
        def cm-other() = "other";
        def cm-witnesses() = "witnesses";
        def cm-seed-class() = "seed";
        def cm-source-extensions() = list(".sh",".bash",".zsh",".ps1",".cmd",".bat",".py",".pyw",".swift",".c",".h",".m",".mm",".cpp",".cc",".cxx",".hpp",".hh",".cs",".mjs",".cjs",".js",".jsx",".go",".rs",".ts",".tsx",".java",".kt",".rb",".lua",".pl",".php",".s",".S",".asm",".ptx",".comp",".metal");
        def cm-source?(path) = oh-has(cm-source-extensions(),fs-path-extension(path));
        def cm-form?(path) = oh-has(list(".fk",".bml"),fs-path-extension(path));

        // ---- the class table: (class, prefix) rows; first match wins; no match is "other" ----
        def cm-class-row(class, prefix) = list(class, prefix);
        def cm-classes() = list(
            cm-class-row("seed", "runtime/"),
            cm-class-row("metal-shell", "form/native/metal/"),
            cm-class-row("scripts", "form/scripts/"),
            cm-class-row("doors", "form/native/cuda/"),
            cm-class-row("doors", "form/native/vulkan/"),
            cm-class-row("carriers", "presence/carriers/"),
            cm-class-row("carriers", "form/native/presence/"),
            cm-class-row("carriers", "form/native/audio/"),
            cm-class-row("witnesses", "form/form-kernel-go/"),
            cm-class-row("witnesses", "form/form-kernel-rust/"),
            cm-class-row("witnesses", "form/form-kernel-ts/"),
            cm-class-row("witnesses", "walkers/"),
            cm-class-row("fixtures", "model/fixtures/"),
            cm-class-row("fixtures", "presence/fixtures/"),
            cm-class-row("fixtures", "presence/concept-pl-"),
            cm-class-row("tooling", "tools/"),
            cm-class-row("tooling", "os/"));
        def cm-class-order() = list("seed", "metal-shell", "scripts", "doors", "carriers", "witnesses", "fixtures", "tooling", "other");
        // exclusion rows are lists like every table row: tb-find2 answers the row itself, and the engine reads len() of it
        def cm-exclude-row(needle) = list(needle);
        def cm-excludes() = list(cm-exclude-row("node_modules"), cm-exclude-row("seedbank"));

        def cm-prefix?(path, prefix) = (String) substring(path, 0, str_len(prefix)) == prefix ? 1 : 0;
        def cm-class-name(row) = (Comparable) len(row) == 0 ? cm-other() : row[0];
        def cm-class-of(path) = cm-class-name(tb-first(cm-classes(), row => cm-prefix?(path, row[1])) ?? list());
        def cm-exclude-hits?(row, path) = oh-has(split-on(path,"/"),head(row));
        def cm-excluded?(path) = tb-any2?(cm-excludes(), cm-exclude-hits?, path);

        // ---- lines, order kept; a last line without its newline still counts ----
        def cm-lines(text, from, acc) {
            let nl = str_find(text, cm-nl(), from);
            nl < 0 ? reverse(cm-last-line(text, from, acc))
            : cm-lines(text, nl + 1, cons(substring(text, from, nl), acc));
        }
        def cm-last-line(text, from, acc) = from < str_len(text) ? cons(substring(text, from, str_len(text)), acc) : acc;
        def cm-count-lines(text) = len(filter(line => str_len(line) > 0, cm-lines(text, 0, list())));
        def cm-ends?(name, suffix) = str_len(name) < str_len(suffix) ? 0 : (String) substring(name, str_len(name) - str_len(suffix), str_len(name)) == suffix ? 1 : 0;
        def cm-count-suffix(text, suffix) = len(tb-filter2(cm-lines(text, 0, list()), cm-ends?, suffix));

        // ---- a file row: list(path, lines, class) ----
        def cm-file-row(path, lines) = list(path, lines, cm-class-of(path));
        def cm-row-path(r) = r[0];
        def cm-row-lines(r) = r[1];
        def cm-row-class(r) = r[2];

        // ---- sums ride the table engine ----
        def cm-sum-lines(acc, r) = acc + cm-row-lines(r);
        def cm-lines-of(rows) = tb-fold(rows, cm-sum-lines, 0);
        def cm-class-rows(rows, class) = filter(r => (String) cm-row-class(r) == class, rows);
        def cm-outside(rows, class) = filter(r => !((String) cm-row-class(r) == class), rows);
        def cm-class-files(rows, class) = len(cm-class-rows(rows, class));
        def cm-class-lines(rows, class) = cm-lines-of(cm-class-rows(rows, class));
        def cm-seed-lines(rows) = cm-lines-of(filter(r => (String) cm-row-path(r) == cm-seed(), rows));
        def cm-shell-lines(rows) = cm-lines-of(cm-outside(cm-outside(rows, cm-witnesses()), cm-seed-class()));
        def cm-outside-witnesses-lines(rows) = cm-lines-of(cm-outside(rows, cm-witnesses()));

        // ---- the fold: places 10^9 / 10^3 / 1; ceilings 1,000,000 shell lines and 1,000 cells ----
        def cm-field(seed, shell, cells) = (seed * 1000000000) + ((shell * 1000) + cells);

        // ---- printing ----
        def cm-spaces(n) = n <= 0 ? "" : " " ++ cm-spaces(n - 1);
        def cm-pad-right(s, n) = s ++ cm-spaces(n - str_len(s));
        def cm-pad-left(s, n) = cm-spaces(n - str_len(s)) ++ s;
        def cm-kv(k, v) = k ++ "=" ++ int_to_str(v);
        def cm-class-line(rows, class) = cm-pad-right(class, 12) ++ cm-pad-left(int_to_str(cm-class-files(rows, class)), 6) ++ cm-pad-left(int_to_str(cm-class-lines(rows, class)), 9);
        def cm-print-classes(rows, classes) = (Comparable) len(classes) == 0 ? 0 : cm-print-class-one(rows, head(classes), tail(classes));
        def cm-print-class-one(rows, class, rest) {
            print(cm-class-line(rows, class));
            cm-print-classes(rows, rest);
        }
        def cm-other-line(r) = "  " ++ cm-pad-left(int_to_str(cm-row-lines(r)), 7) ++ "  " ++ cm-row-path(r);
        def cm-print-rows(rows) = (Comparable) len(rows) == 0 ? 0 : cm-print-rows-one(head(rows), tail(rows));
        def cm-print-rows-one(r, rest) {
            print(cm-other-line(r));
            cm-print-rows(rest);
        }

        // ---- the report; the last line is the field code, which is also the answer ----
        def cm-report(rows, forms, calls, mentions) {
            let seed = cm-seed-lines(rows);
            let shell = cm-shell-lines(rows);
            let cells = len(calls);
            print("carrier mass - current source bytes read by Form; target specimens and proof code remain visible; node_modules and seedbank excluded from the weighted field");
            print(cm-pad-right("class", 12) ++ cm-pad-left("files", 6) ++ cm-pad-left("lines", 9));
            cm-print-classes(rows, cm-class-order());
            print("other - listed so nothing hides (lines  path):");
            cm-print-rows(cm-class-rows(rows, cm-other()));
            print(cm-kv("weighed-files", len(rows)) ++ "  " ++ cm-kv("form-fk", len(tb-filter2(forms,cm-ends?,".fk"))) ++ "  " ++ cm-kv("form-bml", len(tb-filter2(forms,cm-ends?,".bml"))));
            print(cm-kv("seed-lines", seed) ++ "  (" ++ cm-seed() ++ ")");
            print(cm-kv("shell-lines", shell) ++ "  (weighed lines outside the seed class and the witnesses)");
            print(cm-kv("non-form-lines-outside-witnesses", cm-outside-witnesses-lines(rows)) ++ "  (seed class included)");
            print(cm-kv("host-exec-cells", cells) ++ "  (lexical call shape)  " ++ cm-kv("host-exec-mentions", len(mentions)) ++ "  (word occurrence; neither is a process trace)");
            print("field seed-lines*10^9 + shell-lines*10^3 + host-exec-cells = " ++ int_to_str(cm-field(seed, shell, cells)));
            cm-field(seed, shell, cells);
        }
        def cm-no-host() {
            print("carrier mass: inventory unavailable - no reading; 0 is absence, not a mass");
            0;
        }
        def cm-newlines(text,from,total) {
            let at = str_find(text,"\n",from);
            at < 0 ? total : cm-newlines(text,at + 1,total + 1);
        }
        def cm-has(text,needle) = str_find(text,needle,0) >= 0;
        def cm-space?(byte) = oh-has(list(" ","\t","\r","\n"),byte);
        def cm-skip-space(text,at) = at >= str_len(text) ? at : cm-space?(substring(text,at,at + 1)) ? cm-skip-space(text,at + 1) : at;
        def cm-before-space(text,at) = at <= 0 ? "" : cm-space?(substring(text,at - 1,at)) ? cm-before-space(text,at - 1) : substring(text,at - 1,at);
        def cm-name-byte?(byte) = oh-has(list("_","-","?","!"),byte) || (((str_byte_at(byte,0) >= 48) && (str_byte_at(byte,0) <= 57)) || (((str_byte_at(byte,0) >= 65) && (str_byte_at(byte,0) <= 90)) || ((str_byte_at(byte,0) >= 97) && (str_byte_at(byte,0) <= 122))));
        def cm-call-at(text,name,from) {
            let at = str_find(text,name,from);
            let after = at + str_len(name);
            let end = cm-skip-space(text,after);
            let before = at <= 0 ? "" : substring(text,at - 1,at);
            let next = after >= str_len(text) ? "" : substring(text,after,after + 1);
            let native = ((String) cm-before-space(text,at) == "(") && (cm-space?(next) || ((String) next == ")"));
            let high = (!cm-name-byte?(before)) && ((String) substring(text,end,end + 1) == "(");
            at < 0 ? 0 : native || high ? 1 : cm-call-at(text,name,at + 1);
        }
        def cm-call?(text) = cm-call-at(text,"host-exec",0) || cm-call-at(text,"host_exec",0);
        def cm-mention?(text) = cm-has(text,"host-exec") || cm-has(text,"host_exec");
        // state: all source rows, Form paths, lexical calls, mentions, unread.
        // Source row: path, newline count, class, bytes, weighted exclusion.
        def cm-scan(paths,rows,forms,calls,mentions,unread) = nil?(paths) ? list(reverse(rows),reverse(forms),reverse(calls),reverse(mentions),reverse(unread)) : cm-read(head(paths),tail(paths),rows,forms,calls,mentions,unread);
        def cm-read(path,rest,rows,forms,calls,mentions,unread) {
            (String) path == "" ? cm-scan(rest,rows,forms,calls,mentions,unread)
            : file_size(path) < 0 ? cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            : cm-source?(path) || cm-form?(path) ? cm-content(path,rest,rows,forms,calls,mentions,unread,read_file(path))
            : cm-probe(path,rest,rows,forms,calls,mentions,unread,read_file_slice(path,0,2));
        }
        def cm-probe(path,rest,rows,forms,calls,mentions,unread,prefix) {
            nothing?(prefix) || ((Comparable) str_len(prefix) != (file_size(path) < 2 ? file_size(path) : 2)) ? cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            : (String) prefix == "#!" ? cm-content(path,rest,rows,forms,calls,mentions,unread,read_file(path)) : cm-scan(rest,rows,forms,calls,mentions,unread);
        }
        def cm-content(path,rest,rows,forms,calls,mentions,unread,text) {
            nothing?(text) || ((Comparable) str_len(text) != file_size(path)) ? cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            : cm-form?(path) ? cm-scan(rest,rows,cons(path,forms),cm-call?(text) ? cons(path,calls) : calls,cm-mention?(text) ? cons(path,mentions) : mentions,unread)
            : cm-scan(rest,cons(list(path,cm-newlines(text,0,0),cm-class-of(path),str_len(text),cm-excluded?(path)),rows),forms,calls,mentions,unread);
        }
        def cm-json-row(row) = json-node-object(list(oh-s("path",head(row)),oh-n("lines",row[1]),oh-s("class",row[2]),oh-n("bytes",row[3]),oh-n("excluded_from_weighted_field",row[4])));
        def cm-save(reading) {
            let made = fs_mkdir(".hearth");
            let path = ".hearth/carrier-mass-current.json";
            let report = json-node-object(list(oh-s("schema","carrier-mass-v2"),oh-n("observed_at_ms",now_unix_ms()),oh-s("scope","git tracked and unignored source candidates, including target-language specimens; file class does not establish runtime ownership"),oh-n("complete",nil?(reading[4])),json-node-pair("sources",json-node-array(tb-map(head(reading),cm-json-row))),json-node-pair("form_paths",json-node-array(oh-strings(reading[1]))),json-node-pair("host_exec_calls",json-node-array(oh-strings(reading[2]))),json-node-pair("host_exec_mentions",json-node-array(oh-strings(reading[3]))),json-node-pair("unread_paths",json-node-array(oh-strings(reading[4])))));
            let text = json-emit-precise(report) ++ "\n";
            (Comparable) write_file(path,text) != str_len(text) ? form_error("carrier mass evidence write incomplete") : path;
        }
        def cm-observe(reading) {
            let path = cm-save(reading);
            let complete = nil?(reading[4]);
            let row = oh-reading("carrier-mass","repository","source-reading",json-node-int(0),json-node-int(len(reading[4])),json-node-int(complete),complete ? list() : list(oh-need("readable-current-source",json-node-array(oh-strings(reading[4])))),list("request-evidence","defer"),oh-reference(path));
            oh-voice(row);
            print("complete source inventory=" ++ path);
            complete ? cm-report(filter(r => !r[4],head(reading)),reading[1],reading[2],reading[3]) : cm-incomplete(row);
        }
        def cm-incomplete(row) {
            let response = oh-response(row,"request-evidence");
            oh-voice(response);
            let selected = oh-select(row,response,"defer");
            oh-voice(oh-applied(row,selected,oh-get(row,"needs")));
            form_error("carrier mass source reading incomplete; inspect retained unread paths");
        }
        def cm-run-at(inventory) = nothing?(inventory) ? cm-no-host() : !nsi-nuls?(inventory) ? form_error("carrier mass inventory incomplete") : cm-observe(cm-scan(split-on(inventory,byte_to_str(0)),list(),list(),list(),list(),list()));
        def cm-run() = cm-run-at(nsi-text(nsi-git()));
    }
    cm-run();
}
