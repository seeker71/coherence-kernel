// Form reads current source bytes, counts newlines and classifies paths.
// Git supplies one NUL-delimited inventory. All source rows, including the
// weighted field's exclusions, remain in .hearth/carrier-mass-current.json.
// Unknown files and incomplete reads stay visible; an incomplete source read
// refuses a mass. Extension and shebang candidates include target-language
// specimens and proof engines: this inventory does not assert runtime roles.
// The weighted field excludes node_modules and seedbank. Its encoding is
// seed-lines * 10^9 + shell-lines * 10^3 + lexical host-exec-call files.
// The same term is used for continuity; shell-lines includes other languages.
// Calls are lexical candidates, not a process trace. Native execution and
// source ownership need their own observations.
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/form-fs.fk form-stdlib/organ-health.bml form-stdlib/bml/native-source-inventory.bml

section [form.bml] {
    class FormCarrierMass {
        thought carrier-mass-pattern = list("class-is-a-row", "inventory-needs-child-status", "native-source-byte-reading", "other-hides-nothing", "lexical-call-shape", "complete-evidence-retained");

        def cm-nl() = byte_to_str(10);
        def cm-seed() = "runtime/fkwu-uni.c";
        def cm-other() = "other";
        def cm-witnesses() = "witnesses";
        def cm-seed-class() = "seed";
        def cm-source-extensions() = list(".sh",".bash",".zsh",".ps1",".cmd",".bat",".py",".pyw",".swift",".c",".h",".m",".mm",".cpp",".cc",".cxx",".hpp",".hh",".cs",".mjs",".cjs",".js",".jsx",".go",".rs",".ts",".tsx",".java",".kt",".rb",".lua",".pl",".php",".s",".S",".asm",".ptx",".comp",".metal");
        def cm-source?(path) = oh-has(cm-source-extensions(),fs-path-extension(path));
        def cm-form?(path) = oh-has(list(".fk",".bml"),fs-path-extension(path));

        // ---- the class table: (class, prefix) rows; first match wins; no match is "other" ----
        def cm-class-row(class, prefix) = list(class, prefix);
        def cm-classes() = list(
            cm-class-row("seed", "runtime/"),
            cm-class-row("metal-shell", "form/native/metal/"),
            cm-class-row("scripts", "form/scripts/"),
            cm-class-row("doors", "form/native/cuda/"),
            cm-class-row("doors", "form/native/vulkan/"),
            cm-class-row("carriers", "presence/carriers/"),
            cm-class-row("carriers", "form/native/presence/"),
            cm-class-row("carriers", "form/native/audio/"),
            cm-class-row("witnesses", "form/form-kernel-go/"),
            cm-class-row("witnesses", "form/form-kernel-rust/"),
            cm-class-row("witnesses", "form/form-kernel-ts/"),
            cm-class-row("witnesses", "walkers/"),
            cm-class-row("fixtures", "model/fixtures/"),
            cm-class-row("fixtures", "presence/fixtures/"),
            cm-class-row("fixtures", "presence/concept-pl-"),
            cm-class-row("tooling", "tools/"),
            cm-class-row("tooling", "os/"));
        def cm-class-order() = list("seed", "metal-shell", "scripts", "doors", "carriers", "witnesses", "fixtures", "tooling", "other");
        // exclusion rows are lists like every table row: tb-find2 answers the row itself, and the engine reads len() of it
        def cm-exclude-row(needle) = list(needle);
        def cm-excludes() = list(cm-exclude-row("node_modules"), cm-exclude-row("seedbank"));

        def cm-prefix?(path, prefix) = if str_eq(substring(path, 0, str_len(prefix)), prefix) then 1 else 0;
        def cm-class-hits?(row, path) = cm-prefix?(path, nth(row, 1));
        def cm-class-name(row) = if eq(len(row), 0) then cm-other() else nth(row, 0);
        def cm-class-of(path) = cm-class-name(tb-find2(cm-classes(), cm-class-hits?, path));
        def cm-exclude-hits?(row, path) = oh-has(split-on(path,"/"),head(row));
        def cm-excluded?(path) = tb-any2?(cm-excludes(), cm-exclude-hits?, path);

        // ---- lines, order kept; a last line without its newline still counts ----
        def cm-lines(text, from, acc) {
            let nl = str_find(text, cm-nl(), from);
            if lt(nl, 0) then reverse(cm-last-line(text, from, acc))
            else cm-lines(text, add(nl, 1), cons(substring(text, from, nl), acc));
        }
        def cm-last-line(text, from, acc) = if lt(from, str_len(text)) then cons(substring(text, from, str_len(text)), acc) else acc;
        def cm-nonempty?(line, a) = if gt(str_len(line), 0) then 1 else 0;
        def cm-count-lines(text) = len(tb-filter2(cm-lines(text, 0, list()), cm-nonempty?, 0));
        def cm-ends?(name, suffix) = if lt(str_len(name), str_len(suffix)) then 0 else if str_eq(substring(name, sub(str_len(name), str_len(suffix)), str_len(name)), suffix) then 1 else 0;
        def cm-count-suffix(text, suffix) = len(tb-filter2(cm-lines(text, 0, list()), cm-ends?, suffix));

        // ---- a file row: list(path, lines, class) ----
        def cm-file-row(path, lines) = list(path, lines, cm-class-of(path));
        def cm-row-path(r) = nth(r, 0);
        def cm-row-lines(r) = nth(r, 1);
        def cm-row-class(r) = nth(r, 2);

        // ---- sums ride the table engine ----
        def cm-sum-lines(acc, r) = add(acc, cm-row-lines(r));
        def cm-lines-of(rows) = tb-fold(rows, cm-sum-lines, 0);
        def cm-class-is?(r, class) = if str_eq(cm-row-class(r), class) then 1 else 0;
        def cm-class-not?(r, class) = if str_eq(cm-row-class(r), class) then 0 else 1;
        def cm-path-is?(r, path) = if str_eq(cm-row-path(r), path) then 1 else 0;
        def cm-class-rows(rows, class) = tb-filter2(rows, cm-class-is?, class);
        def cm-outside(rows, class) = tb-filter2(rows, cm-class-not?, class);
        def cm-class-files(rows, class) = len(cm-class-rows(rows, class));
        def cm-class-lines(rows, class) = cm-lines-of(cm-class-rows(rows, class));
        def cm-seed-lines(rows) = cm-lines-of(tb-filter2(rows, cm-path-is?, cm-seed()));
        def cm-shell-lines(rows) = cm-lines-of(cm-outside(cm-outside(rows, cm-witnesses()), cm-seed-class()));
        def cm-outside-witnesses-lines(rows) = cm-lines-of(cm-outside(rows, cm-witnesses()));

        // ---- the fold: places 10^9 / 10^3 / 1; ceilings 1,000,000 shell lines and 1,000 cells ----
        def cm-field(seed, shell, cells) = add(mul(seed, 1000000000), add(mul(shell, 1000), cells));

        // ---- printing ----
        def cm-spaces(n) = if le(n, 0) then "" else str_concat(" ", cm-spaces(sub(n, 1)));
        def cm-pad-right(s, n) = str_concat(s, cm-spaces(sub(n, str_len(s))));
        def cm-pad-left(s, n) = str_concat(cm-spaces(sub(n, str_len(s))), s);
        def cm-kv(k, v) = str_concat(k, str_concat("=", int_to_str(v)));
        def cm-class-line(rows, class) = str_concat(cm-pad-right(class, 12), str_concat(cm-pad-left(int_to_str(cm-class-files(rows, class)), 6), cm-pad-left(int_to_str(cm-class-lines(rows, class)), 9)));
        def cm-print-classes(rows, classes) = if eq(len(classes), 0) then 0 else cm-print-class-one(rows, head(classes), tail(classes));
        def cm-print-class-one(rows, class, rest) {
            print(cm-class-line(rows, class));
            cm-print-classes(rows, rest);
        }
        def cm-other-line(r) = str_concat("  ", str_concat(cm-pad-left(int_to_str(cm-row-lines(r)), 7), str_concat("  ", cm-row-path(r))));
        def cm-print-rows(rows) = if eq(len(rows), 0) then 0 else cm-print-rows-one(head(rows), tail(rows));
        def cm-print-rows-one(r, rest) {
            print(cm-other-line(r));
            cm-print-rows(rest);
        }

        // ---- the report; the last line is the field code, which is also the answer ----
        def cm-report(rows, forms, calls, mentions) {
            let seed = cm-seed-lines(rows);
            let shell = cm-shell-lines(rows);
            let cells = len(calls);
            print("carrier mass - current source bytes read by Form; target specimens and proof code remain visible; node_modules and seedbank excluded from the weighted field");
            print(str_concat(cm-pad-right("class", 12), str_concat(cm-pad-left("files", 6), cm-pad-left("lines", 9))));
            cm-print-classes(rows, cm-class-order());
            print("other - listed so nothing hides (lines  path):");
            cm-print-rows(cm-class-rows(rows, cm-other()));
            print(str_concat(cm-kv("weighed-files", len(rows)), str_concat("  ", str_concat(cm-kv("form-fk", len(tb-filter2(forms,cm-ends?,".fk"))), str_concat("  ", cm-kv("form-bml", len(tb-filter2(forms,cm-ends?,".bml"))))))));
            print(str_concat(cm-kv("seed-lines", seed), str_concat("  (", str_concat(cm-seed(), ")"))));
            print(str_concat(cm-kv("shell-lines", shell), "  (weighed lines outside the seed class and the witnesses)"));
            print(str_concat(cm-kv("non-form-lines-outside-witnesses", cm-outside-witnesses-lines(rows)), "  (seed class included)"));
            print(str_concat(cm-kv("host-exec-cells", cells), str_concat("  (lexical call shape)  ", str_concat(cm-kv("host-exec-mentions", len(mentions)), "  (word occurrence; neither is a process trace)"))));
            print(str_concat("field seed-lines*10^9 + shell-lines*10^3 + host-exec-cells = ", int_to_str(cm-field(seed, shell, cells))));
            cm-field(seed, shell, cells);
        }
        def cm-no-host() {
            print("carrier mass: inventory unavailable - no reading; 0 is absence, not a mass");
            0;
        }
        def cm-newlines(text,from,total) {
            let at = str_find(text,"\n",from);
            if lt(at,0) then total else cm-newlines(text,add(at,1),add(total,1));
        }
        def cm-has(text,needle) = ge(str_find(text,needle,0),0);
        def cm-space?(byte) = oh-has(list(" ","\t","\r","\n"),byte);
        def cm-skip-space(text,at) = if ge(at,str_len(text)) then at else if cm-space?(substring(text,at,add(at,1))) then cm-skip-space(text,add(at,1)) else at;
        def cm-before-space(text,at) = if le(at,0) then "" else if cm-space?(substring(text,sub(at,1),at)) then cm-before-space(text,sub(at,1)) else substring(text,sub(at,1),at);
        def cm-name-byte?(byte) = or(oh-has(list("_","-","?","!"),byte),or(and(ge(str_byte_at(byte,0),48),le(str_byte_at(byte,0),57)),or(and(ge(str_byte_at(byte,0),65),le(str_byte_at(byte,0),90)),and(ge(str_byte_at(byte,0),97),le(str_byte_at(byte,0),122)))));
        def cm-call-at(text,name,from) {
            let at = str_find(text,name,from);
            let after = add(at,str_len(name));
            let end = cm-skip-space(text,after);
            let before = if le(at,0) then "" else substring(text,sub(at,1),at);
            let next = if ge(after,str_len(text)) then "" else substring(text,after,add(after,1));
            let native = and(str_eq(cm-before-space(text,at),"("),or(cm-space?(next),str_eq(next,")")));
            let high = and(not(cm-name-byte?(before)),str_eq(substring(text,end,add(end,1)),"("));
            if lt(at,0) then 0 else if or(native,high) then 1 else cm-call-at(text,name,add(at,1));
        }
        def cm-call?(text) = or(cm-call-at(text,"host-exec",0),cm-call-at(text,"host_exec",0));
        def cm-mention?(text) = or(cm-has(text,"host-exec"),cm-has(text,"host_exec"));
        // state: all source rows, Form paths, lexical calls, mentions, unread.
        // Source row: path, newline count, class, bytes, weighted exclusion.
        def cm-scan(paths,rows,forms,calls,mentions,unread) = if nil?(paths) then list(reverse(rows),reverse(forms),reverse(calls),reverse(mentions),reverse(unread)) else cm-read(head(paths),tail(paths),rows,forms,calls,mentions,unread);
        def cm-read(path,rest,rows,forms,calls,mentions,unread) {
            if str_eq(path,"") then cm-scan(rest,rows,forms,calls,mentions,unread)
            else if lt(file_size(path),0) then cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            else if or(cm-source?(path),cm-form?(path)) then cm-content(path,rest,rows,forms,calls,mentions,unread,read_file(path))
            else cm-probe(path,rest,rows,forms,calls,mentions,unread,read_file_slice(path,0,2));
        }
        def cm-probe(path,rest,rows,forms,calls,mentions,unread,prefix) {
            if or(nothing?(prefix),ne(str_len(prefix),if lt(file_size(path),2) then file_size(path) else 2)) then cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            else if str_eq(prefix,"#!") then cm-content(path,rest,rows,forms,calls,mentions,unread,read_file(path)) else cm-scan(rest,rows,forms,calls,mentions,unread);
        }
        def cm-content(path,rest,rows,forms,calls,mentions,unread,text) {
            if or(nothing?(text),ne(str_len(text),file_size(path))) then cm-scan(rest,rows,forms,calls,mentions,cons(path,unread))
            else if cm-form?(path) then cm-scan(rest,rows,cons(path,forms),if cm-call?(text) then cons(path,calls) else calls,if cm-mention?(text) then cons(path,mentions) else mentions,unread)
            else cm-scan(rest,cons(list(path,cm-newlines(text,0,0),cm-class-of(path),str_len(text),cm-excluded?(path)),rows),forms,calls,mentions,unread);
        }
        def cm-weighted?(row,ignored) = not(nth(row,4));
        def cm-json-row(row) = json-node-object(list(oh-s("path",head(row)),oh-n("lines",nth(row,1)),oh-s("class",nth(row,2)),oh-n("bytes",nth(row,3)),oh-n("excluded_from_weighted_field",nth(row,4))));
        def cm-save(reading) {
            let made = fs_mkdir(".hearth");
            let path = ".hearth/carrier-mass-current.json";
            let report = json-node-object(list(oh-s("schema","carrier-mass-v2"),oh-n("observed_at_ms",now_unix_ms()),oh-s("scope","git tracked and unignored source candidates, including target-language specimens; file class does not establish runtime ownership"),oh-n("complete",nil?(nth(reading,4))),json-node-pair("sources",json-node-array(tb-map(head(reading),cm-json-row))),json-node-pair("form_paths",json-node-array(oh-strings(nth(reading,1)))),json-node-pair("host_exec_calls",json-node-array(oh-strings(nth(reading,2)))),json-node-pair("host_exec_mentions",json-node-array(oh-strings(nth(reading,3)))),json-node-pair("unread_paths",json-node-array(oh-strings(nth(reading,4))))));
            let text = str_concat(json-emit-precise(report),"\n");
            if ne(write_file(path,text),str_len(text)) then form_error("carrier mass evidence write incomplete") else path;
        }
        def cm-observe(reading) {
            let path = cm-save(reading);
            let complete = nil?(nth(reading,4));
            let row = oh-reading("carrier-mass","repository","source-reading",json-node-int(0),json-node-int(len(nth(reading,4))),json-node-int(complete),if complete then list() else list(oh-need("readable-current-source",json-node-array(oh-strings(nth(reading,4))))),list("request-evidence","defer"),oh-reference(path));
            oh-voice(row);
            print(str_concat("complete source inventory=",path));
            if complete then cm-report(tb-filter2(head(reading),cm-weighted?,0),nth(reading,1),nth(reading,2),nth(reading,3)) else cm-incomplete(row);
        }
        def cm-incomplete(row) {
            let response = oh-response(row,"request-evidence");
            oh-voice(response);
            let selected = oh-select(row,response,"defer");
            oh-voice(oh-applied(row,selected,oh-get(row,"needs")));
            form_error("carrier mass source reading incomplete; inspect retained unread paths");
        }
        def cm-run-at(inventory) = if nothing?(inventory) then cm-no-host() else if not(nsi-nuls?(inventory)) then form_error("carrier mass inventory incomplete") else cm-observe(cm-scan(split-on(inventory,byte_to_str(0)),list(),list(),list(),list(),list()));
        def cm-run() = cm-run-at(nsi-text(nsi-git()));
    }
    cm-run();
}
