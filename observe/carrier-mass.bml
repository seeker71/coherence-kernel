//////////////////////////////////////////////////////////////////////
//
// observe/carrier-mass.bml — the carrier-mass lens.
//
// Executable BML. R67 in the release ledger. The alignment plan
// (receipts/2026-09-04-north-star-alignment-plan.md) names three
// numbers the body reads about itself on every landing: the seed's
// line count, the mass of the non-Form shell around it, and the
// number of cells that reach through host-exec. This lens reads all
// three from the tracked tree and folds them into one field code the
// land cadence can diff. It reads; it writes nothing.
//
// WHAT IS WEIGHED. Every tracked file whose extension is one of
// .sh .py .swift .c .h .m .cpp .mjs .go .rs .ts — the surfaces that
// are not Form. "Tracked" is a git fact (git ls-files through
// host-exec, the belief-stamps shape): the disk under this root holds
// sibling worktrees and ices nobody witnessed. node_modules and
// seedbank paths are shed (cm-excludes, rows of data). The lines come
// from ONE wc -l over the whole list — the pipeline
// `git ls-files -- <globs> | xargs wc -l` is one host-exec; wc's own
// total line is skipped by its name.
//
// WHY THE PIPELINE COMPOSES IN THE SHELL. host-exec's second argument
// is not fed to the child today (fk_host_exec: `(void)inputv`), and
// its command string is capped at 8192 bytes, so a list of 368 paths
// cannot cross back over the membrane as arguments or as stdin. The
// list therefore stays inside the one pipeline and comes back WITH its
// counts; Form does the shedding, the classing and the sums. When
// host-exec grows a stdin, the list can be handed across and the
// exclusion rows can precede the count; nothing else here changes.
//
// CLASSES ARE ROWS. cm-classes is a table of (class, path-prefix);
// the first row whose prefix heads the path names its class, and a
// path no row claims is "other" — printed in full, so nothing hides
// behind a name. Three prefixes may share one class (doors: cuda,
// mlx, vulkan). Adding a class is adding a row.
//
// THE THREE HEADLINES partition the weighed tree, so no line lands in
// two of them:
//   seed-lines   runtime/fkwu-uni.c alone — the plan's shrink measure
//                (`wc -l runtime/fkwu-uni.c`); the seed CLASS row also
//                carries the optable and the seed's own test script.
//   shell-lines  every weighed line outside the seed class and outside
//                the witnesses: the shell around the seed.
//   witnesses    the Go / Rust / TS kernels and the minimal walkers —
//                proof siblings, weighed but not folded (R66 owns them).
// The plan's own phrase "non-Form lines outside witnesses" (seed class
// included) is printed too, so that census stays diffable.
//
// HOST-EXEC CELLS are counted by CALL SHAPE — a .fk or .bml that
// contains `(host-exec ` or `(host-exec` at a line end or `host-exec(`
// or `host_exec` — because a mention is not a reach: 54 tracked cells
// today carry the word only in a comment, a string, a pf-arm-mask row,
// a membrane census row or a ledger row. The mention count
// (`grep -l host-exec`, the recipe the plan's 183 came from) is printed
// beside it so the two never get confused again; the fold carries the
// call count, which moves only when a cell begins or stops reaching.
//
// THE FIELD CODE is seed-lines*10^9 + shell-lines*10^3 + host-exec-cells.
// Exact, not rounded: a plan whose rule is "every movement moves a
// number" cannot afford a place that swallows 999 lines. Injective
// while host-exec-cells < 1,000 and shell-lines < 1,000,000 (130 and
// 43,414 today); the whole stays under 2^53 while the seed stays under
// 9,007,199 lines, so a sibling arm that reads doubles would still
// read it exactly. Lower is better in every place.
//
// ABSENCE IS NAMED. host-exec answering nothing (a launch failure,
// never "") prints one line saying so and answers 0 — no zero here
// wears a reading's skin. An empty list (git spoke, no files) answers
// zeros in every place honestly.
//
// Run directly:  ./fkwu observe/carrier-mass.bml
// Proven by:     observe/tests/carrier-mass-band.fk
//
// NEXT STONE, named and not built here: the readings line on the land
// cadence. form-stdlib/land-cadence-live.fk runs the drift gates
// (gate/drift-gates.bml) before any landing act; the three lenses the
// plan names — observe/authoring-altitude-run.fk, this lens, and
// observe/belief-stamps.bml — are not read there yet. They belong
// beside the gates as READINGS, printed every breath and never
// refusing a landing (a lens has no red); the drift-gates row shape
// carries a want and refuses, so it is the wrong seat. One preludes
// entry per lens on that door would print each report eagerly; proving
// that the eager walk sits well inside a door that also pushes is that
// stone's own witness.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCarrierMass {
        thought carrier-mass-pattern = list("class-is-a-row", "tracked-is-a-git-fact", "one-wc-over-the-whole-list", "other-hides-nothing", "call-shape-not-mention", "reads-never-writes");

        def cm-nl() = byte_to_str(10);
        def cm-seed() = "runtime/fkwu-uni.c";
        def cm-other() = "other";
        def cm-witnesses() = "witnesses";
        def cm-seed-class() = "seed";
        def cm-globs() = "-- '*.sh' '*.py' '*.swift' '*.c' '*.h' '*.m' '*.cpp' '*.mjs' '*.go' '*.rs' '*.ts'";
        def cm-form-globs() = "-- '*.fk' '*.bml'";
        def cm-wc-cmd() = str_concat("git ls-files ", str_concat(cm-globs(), " | xargs wc -l"));
        def cm-form-cmd() = str_concat("git ls-files ", cm-form-globs());
        def cm-call-cmd() = str_concat(cm-form-cmd(), " | xargs grep -l -e '(host-exec[[:space:]]' -e '(host-exec$' -e 'host-exec(' -e host_exec");
        def cm-mention-cmd() = str_concat(cm-form-cmd(), " | xargs grep -l -e host-exec -e host_exec");
        def cm-host-text(v) = if nothing?(v) then "" else v;

        // ---- the class table: (class, prefix) rows; first match wins; no match is "other" ----
        def cm-class-row(class, prefix) = list(class, prefix);
        def cm-classes() = list(
            cm-class-row("seed", "runtime/"),
            cm-class-row("metal-shell", "form/native/metal/"),
            cm-class-row("scripts", "form/scripts/"),
            cm-class-row("doors", "form/native/cuda/"),
            cm-class-row("doors", "form/native/mlx/"),
            cm-class-row("doors", "form/native/vulkan/"),
            cm-class-row("carriers", "presence/carriers/"),
            cm-class-row("carriers", "form/native/presence/"),
            cm-class-row("carriers", "form/native/audio/"),
            cm-class-row("witnesses", "form/form-kernel-go/"),
            cm-class-row("witnesses", "form/form-kernel-rust/"),
            cm-class-row("witnesses", "form/form-kernel-ts/"),
            cm-class-row("witnesses", "walkers/"),
            cm-class-row("fixtures", "model/fixtures/"),
            cm-class-row("fixtures", "presence/fixtures/"),
            cm-class-row("fixtures", "presence/concept-pl-"),
            cm-class-row("tooling", "tools/"),
            cm-class-row("tooling", "form/python_bmf/"),
            cm-class-row("tooling", "os/"));
        def cm-class-order() = list("seed", "metal-shell", "scripts", "doors", "carriers", "witnesses", "fixtures", "tooling", "other");
        // exclusion rows are lists like every table row: tb-find2 answers the row itself, and the engine reads len() of it
        def cm-exclude-row(needle) = list(needle);
        def cm-excludes() = list(cm-exclude-row("node_modules"), cm-exclude-row("seedbank"));

        def cm-prefix?(path, prefix) = if str_eq(substring(path, 0, str_len(prefix)), prefix) then 1 else 0;
        def cm-class-hits?(row, path) = cm-prefix?(path, nth(row, 1));
        def cm-class-name(row) = if eq(len(row), 0) then cm-other() else nth(row, 0);
        def cm-class-of(path) = cm-class-name(tb-find2(cm-classes(), cm-class-hits?, path));
        def cm-exclude-hits?(row, path) = if ge(str_find(path, nth(row, 0), 0), 0) then 1 else 0;
        def cm-excluded?(path) = tb-any2?(cm-excludes(), cm-exclude-hits?, path);

        // ---- lines, order kept; a last line without its newline still counts ----
        def cm-lines(text, from, acc) {
            let nl = str_find(text, cm-nl(), from);
            if lt(nl, 0) then reverse(cm-last-line(text, from, acc))
            else cm-lines(text, add(nl, 1), cons(substring(text, from, nl), acc));
        }
        def cm-last-line(text, from, acc) = if lt(from, str_len(text)) then cons(substring(text, from, str_len(text)), acc) else acc;
        def cm-nonempty?(line, a) = if gt(str_len(line), 0) then 1 else 0;
        def cm-count-lines(text) = len(tb-filter2(cm-lines(text, 0, list()), cm-nonempty?, 0));
        def cm-ends?(name, suffix) = if lt(str_len(name), str_len(suffix)) then 0 else if str_eq(substring(name, sub(str_len(name), str_len(suffix)), str_len(name)), suffix) then 1 else 0;
        def cm-count-suffix(text, suffix) = len(tb-filter2(cm-lines(text, 0, list()), cm-ends?, suffix));

        // ---- one wc line: "  16190 runtime/fkwu-uni.c" -> list(path, lines); blank and total lines -> list() ----
        def cm-ch(s, i) = substring(s, i, add(i, 1));
        def cm-blank?(c) = if str_eq(c, " ") then 1 else if str_eq(c, byte_to_str(9)) then 1 else 0;
        def cm-skip-blank(s, i) = if ge(i, str_len(s)) then i else if eq(cm-blank?(cm-ch(s, i)), 1) then cm-skip-blank(s, add(i, 1)) else i;
        def cm-word-end(s, i) = if ge(i, str_len(s)) then i else if eq(cm-blank?(cm-ch(s, i)), 1) then i else cm-word-end(s, add(i, 1));
        def cm-wc-row(line) {
            let a = cm-skip-blank(line, 0);
            let b = cm-word-end(line, a);
            let path = substring(line, cm-skip-blank(line, b), str_len(line));
            if eq(str_len(path), 0) then list() else if str_eq(path, "total") then list() else list(path, str_to_int(substring(line, a, b)));
        }

        // ---- a file row: list(path, lines, class) ----
        def cm-file-row(path, lines) = list(path, lines, cm-class-of(path));
        def cm-row-path(r) = nth(r, 0);
        def cm-row-lines(r) = nth(r, 1);
        def cm-row-class(r) = nth(r, 2);
        def cm-rows-add(acc, line) {
            let w = cm-wc-row(line);
            if eq(len(w), 0) then acc else if eq(cm-excluded?(nth(w, 0)), 1) then acc else cons(cm-file-row(nth(w, 0), nth(w, 1)), acc);
        }
        def cm-rows-of-text(text) = reverse(tb-fold(cm-lines(text, 0, list()), cm-rows-add, list()));

        // ---- sums ride the table engine ----
        def cm-sum-lines(acc, r) = add(acc, cm-row-lines(r));
        def cm-lines-of(rows) = tb-fold(rows, cm-sum-lines, 0);
        def cm-class-is?(r, class) = if str_eq(cm-row-class(r), class) then 1 else 0;
        def cm-class-not?(r, class) = if str_eq(cm-row-class(r), class) then 0 else 1;
        def cm-path-is?(r, path) = if str_eq(cm-row-path(r), path) then 1 else 0;
        def cm-class-rows(rows, class) = tb-filter2(rows, cm-class-is?, class);
        def cm-outside(rows, class) = tb-filter2(rows, cm-class-not?, class);
        def cm-class-files(rows, class) = len(cm-class-rows(rows, class));
        def cm-class-lines(rows, class) = cm-lines-of(cm-class-rows(rows, class));
        def cm-seed-lines(rows) = cm-lines-of(tb-filter2(rows, cm-path-is?, cm-seed()));
        def cm-shell-lines(rows) = cm-lines-of(cm-outside(cm-outside(rows, cm-witnesses()), cm-seed-class()));
        def cm-outside-witnesses-lines(rows) = cm-lines-of(cm-outside(rows, cm-witnesses()));

        // ---- the fold: places 10^9 / 10^3 / 1; ceilings 1,000,000 shell lines and 1,000 cells ----
        def cm-field(seed, shell, cells) = add(mul(seed, 1000000000), add(mul(shell, 1000), cells));

        // ---- printing ----
        def cm-spaces(n) = if le(n, 0) then "" else str_concat(" ", cm-spaces(sub(n, 1)));
        def cm-pad-right(s, n) = str_concat(s, cm-spaces(sub(n, str_len(s))));
        def cm-pad-left(s, n) = str_concat(cm-spaces(sub(n, str_len(s))), s);
        def cm-kv(k, v) = str_concat(k, str_concat("=", int_to_str(v)));
        def cm-class-line(rows, class) = str_concat(cm-pad-right(class, 12), str_concat(cm-pad-left(int_to_str(cm-class-files(rows, class)), 6), cm-pad-left(int_to_str(cm-class-lines(rows, class)), 9)));
        def cm-print-classes(rows, classes) = if eq(len(classes), 0) then 0 else cm-print-class-one(rows, head(classes), tail(classes));
        def cm-print-class-one(rows, class, rest) {
            print(cm-class-line(rows, class));
            cm-print-classes(rows, rest);
        }
        def cm-other-line(r) = str_concat("  ", str_concat(cm-pad-left(int_to_str(cm-row-lines(r)), 7), str_concat("  ", cm-row-path(r))));
        def cm-print-rows(rows) = if eq(len(rows), 0) then 0 else cm-print-rows-one(head(rows), tail(rows));
        def cm-print-rows-one(r, rest) {
            print(cm-other-line(r));
            cm-print-rows(rest);
        }

        // ---- the report; the last line is the field code, which is also the answer ----
        def cm-report(rows, formtext, calltext, mentiontext) {
            let seed = cm-seed-lines(rows);
            let shell = cm-shell-lines(rows);
            let cells = cm-count-lines(calltext);
            print("carrier mass - tracked non-Form surfaces (.sh .py .swift .c .h .m .cpp .mjs .go .rs .ts), node_modules and seedbank shed");
            print(str_concat(cm-pad-right("class", 12), str_concat(cm-pad-left("files", 6), cm-pad-left("lines", 9))));
            cm-print-classes(rows, cm-class-order());
            print("other - listed so nothing hides (lines  path):");
            cm-print-rows(cm-class-rows(rows, cm-other()));
            print(str_concat(cm-kv("weighed-files", len(rows)), str_concat("  ", str_concat(cm-kv("form-fk", cm-count-suffix(formtext, ".fk")), str_concat("  ", cm-kv("form-bml", cm-count-suffix(formtext, ".bml")))))));
            print(str_concat(cm-kv("seed-lines", seed), str_concat("  (", str_concat(cm-seed(), ")"))));
            print(str_concat(cm-kv("shell-lines", shell), "  (weighed lines outside the seed class and the witnesses)"));
            print(str_concat(cm-kv("non-form-lines-outside-witnesses", cm-outside-witnesses-lines(rows)), "  (the plan receipt's phrase: seed class included)"));
            print(str_concat(cm-kv("host-exec-cells", cells), str_concat("  (call shape)  ", str_concat(cm-kv("host-exec-mentions", cm-count-lines(mentiontext)), "  (the word anywhere, the recipe behind the plan's 183)"))));
            print(str_concat("field seed-lines*10^9 + shell-lines*10^3 + host-exec-cells = ", int_to_str(cm-field(seed, shell, cells))));
            cm-field(seed, shell, cells);
        }
        def cm-no-host() {
            print("carrier mass: host-exec answered nothing (the child never launched) - no reading; 0 is an absence, not a mass");
            0;
        }
        def cm-run-at(wctext) = if nothing?(wctext) then cm-no-host() else cm-report(cm-rows-of-text(wctext), cm-host-text(host-exec(cm-form-cmd(), "")), cm-host-text(host-exec(cm-call-cmd(), "")), cm-host-text(host-exec(cm-mention-cmd(), "")));
        def cm-run() = cm-run-at(host-exec(cm-wc-cmd(), ""));
    }
    cm-run();
}
