// local-focus-run.bml — the planner's focus guide, answered by parallel lenses of the local model, as its own door.
//
//   echo '{"request":"<id>","go":1}' | ./fkwu observe/local-focus-run.bml
//
// The call itself is form-stdlib/bml/local-focus-lenses.bml (lfl-run): one prefix (the planner's own focus prompt), three lenses, one
// weight pass per step, each lens read by the planner's own rules, the surest valid one written at flp-focus-path(req). The planner
// asks for the same thing itself with {"lenses":1} (observe/local-plan-run.bml); this door runs it alone, ahead of a walk.
// stdin, one JSON line: request (id in learn/local-requests.jsonl), go (without it only the plan is said), gen (48 tokens a lens).
// A physical run: it needs the local GPU.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/q38-multi.bml form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/q38-lenses.bml native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-dense-spec.fk
import form-stdlib/bml/form-cli-local-plan.bml;
import form-stdlib/bml/local-focus-lenses.bml;
section [form.bml] {
 class LocalFocusRun {
  def lfr-say(t) = print_str("[local-focus] " ++ t ++ "\n");
  def lfr-opts() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("local-focus", line) : json-node-object([]);
  }
  def lfr-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def lfr-request(id) = flp-first(flp-queue-rows(flp-requests()), r => (String) flp-req-id(r) == id);
  def lfr-run() {
   let o = lfr-opts();
   let id = json-object-has?(o, "request") ? json-string-value(json-object-get(o, "request")) : "";
   let req = lfr-request(id);
   nothing?(req) ? lfr-say("no request " ++ id ++ " in " ++ flp-requests()) : lfr-go(req, o);
  }
  def lfr-go(req, o) {
   lfr-int(o, "go", 0) != 1 ? lfr-say("plan: go=1 reads a prompt of " ++ len(flp-focus-prompt(req)).str() ++ " bytes with " ++ len(lfl-lenses()).str() ++ " lenses and writes " ++ flp-focus-path(req)) : lfr-say(lfl-run(req, lfr-int(o, "gen", 48)));
  }
 }
 lfr-run();
}
