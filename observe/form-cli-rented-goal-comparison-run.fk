; form-cli-rented-goal-comparison-run.fk — one local Form process reads
; caller-provided evidence paths and renders only scalar comparison evidence.
; It never selects a root, starts a model, opens a provider, or reads task or
; answer prose into its output.
; stdin: historical-receipt path; task-spool path; reply-spool path; turn.
; preludes: form-stdlib/bml/form-cli-rented-goal-comparison.bml

(do
    (defn fcgrcr-line (name value)
        (print_str (str_concat "rented-goal-comparison "
            (str_concat name (str_concat "=" (str_concat value "\n"))))) )
    (defn fcgrcr-int-or-nothing (value)
        (if (nothing? value) "nothing" (int_to_str value)))
    (defn fcgrcr-read (path)
        (if (eq (str_len path) 0) (nothing) (read_file path)))
    (let history-path (read_line))
    (let task-path (read_line))
    (let reply-path (read_line))
    (let turn (str_to_int (read_line)))
    (let result (fcgrc-compare (fcgrcr-read history-path) (fcgrcr-read task-path) (fcgrcr-read reply-path) turn))
    (fcgrcr-line "status" (fcgrc-status result))
    (fcgrcr-line "source" (fcgrc-source-of result))
    (fcgrcr-line "reason" (fcgrc-reason result))
    (fcgrcr-line "task-turn" (int_to_str (fcgrc-task-turn result)))
    (fcgrcr-line "normal-remote-tokens" (fcgrcr-int-or-nothing (fcgrc-normal-remote-tokens result)))
    (fcgrcr-line "form-cli-remote-tokens" (fcgrcr-int-or-nothing (fcgrc-form-cli-remote-tokens result)))
    (fcgrcr-line "ratio-bps" (fcgrcr-int-or-nothing (fcgrc-ratio-bps result)))
    (fcgrcr-line "under-ten-percent" (fcgrcr-int-or-nothing (fcgrc-under-ten-percent? result)))
    0)
