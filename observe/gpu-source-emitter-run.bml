// stdin: kind (ptx or glsl), then output path. Output is executable BML,
// regardless of its filename extension. No derived Python or shell program.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/gpu-source-emitter.bml
section [form.bml] {
 class GpuSourceEmitterDoor {
  def gsed-run() {
   let kind = read_line();
   let path = read_line();
   if or(nothing?(kind),nothing?(path)) then form_error("GPU source generation needs kind and output path on stdin") else gse-publish(gse-catalog(kind),path);
  }
 }
 gsed-run();
}
