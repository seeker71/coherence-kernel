; form-cli-embodied-goal-compression-run.fk -- one BML grammar lowers the
; active goal and reports only structural compression.  It opens no tokenizer,
; model, Metal handle, provider, HTTP endpoint, or second process.
;
; The exact goal literal and its lowering live only in BML.  Token fields are
; nothing because local tokenization is neither this user's metric nor a
; healthy pre-step on this route.
; preludes: form-stdlib/bml/form-cli-embodied-goal-grammar.bml

(do
    (defn fcegc-line (name value)
        (print_str (str_concat "embodied-compression "
            (str_concat name (str_concat "=" (str_concat value "\n"))))) )
    (defn fcegc-int (name value) (fcegc-line name (int_to_str value)))
    (let prompt (fcpdag-embodied-goal-prompt))
    (let lowered (fcpdag-observation prompt))
    (let receipt (fcpdag-compression prompt lowered (nothing) (nothing)))
    (fcegc-line "status" "value")
    (fcegc-line "lane" (fcpdag-compression-lane receipt))
    (fcegc-int "input-bytes" (fcpdag-original-bytes receipt))
    (fcegc-int "lowered-bytes" (fcpdag-lowered-bytes receipt))
    (fcegc-int "bytes-saved" (fcpdag-bytes-saved receipt))
    (fcegc-int "byte-reduction-bps" (fcpdag-byte-reduction-bps receipt))
    (fcegc-line "token-reduction" "nothing")
    0)
