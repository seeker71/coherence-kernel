; form-glass-machine-live.fk — the machine frame, given every 50 ms.
;
; One process, no forks, no scans: the host GPU level and its busy integral
; (this process is the host's one accelerator reader -- the accelerator answers
; the mean since the previous query by any process, so one reader keeps the
; windows whole), host CPU busy time over every core, and this process's own
; kernel counters, given as cells into the shared-memory frame glass.sensor.machine.
; The slow sensors (memory_pressure, ps, iostat, the governor) live in
; observe/form-glass-sensors-live.fk at their own cadences and never delay this
; frame. The glass reads the frame on every one of its own frames.
;
; The accelerator gauge is consumed on read: Activity Monitor, when it stands,
; reads the same dictionary about once a second and every read by this process
; answers 0. Every 40 frames (2 s) this process asks libproc whether an
; Activity Monitor stands (host_processes, no ps) and hands the answer to the
; rows, so a 0 beside another reader is given as contended, never as idle.
;
; preludes: form/form-stdlib/form-glass-live.bml form/form-stdlib/form-glass-sensor-rows.bml

(do
    (defn fgml-readers (frame held) (if (eq (fgl-cycle? frame 40) 1) (host_processes "Activity Monitor") held))
    (defn fgml-step (frame heldReaders)
        (do
            (let readers (fgml-readers frame heldReaders))
            (let now (now_unix_ms))
            (let given (fgsr-give "machine" now (fgo-observe-rows (fgl-machine-rows-at readers) now frame)))
            (let rested (host_sleep_ms 50))
            (fgml-step (add frame 1) readers)))
    (fgml-step 0 (list)))
