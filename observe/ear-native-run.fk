; ear-native-run.fk — the native whisper pass on one 16 kHz mono s16 wav, timed: table, open,
; encoder, tokens, text. stdin line 1: wav path. The model and the token table are read from the
; reference's own cache (a model file read, the one crossing besides the microphone).
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-native.fk
(do
    (defn er-join (xs) (if (eq (len xs) 0) "" (str_concat (int_to_str (head xs)) (str_concat " " (er-join (tail xs))))))
    (defn er-model () (str_concat (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")) ""))
    (let wav (trim (read_line)))
    (let snap (str_concat "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/" (trim (en-text (read_file "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main")))))
    (let t0 (now_unix_ms))
    (let st (enw-open (str_concat snap "/weights.npz") "/Users/ursmuff/.mlx-venv/lib/python3.14/site-packages/mlx_whisper/assets/multilingual.tiktoken"))
    (let t1 (now_unix_ms))
    (print_str (str_concat "open_ms=" (str_concat (int_to_str (sub t1 t0)) (str_concat " weights=" (str_concat (int_to_str (len (enw-hs st))) (str_concat " pipes=" (int_to_str (len (nth st 3)))))))))
    (let bytes (en-text (read_file wav)))
    (let pcm (substring bytes 44 (str_len bytes)))
    (let t2 (now_unix_ms))
    (let Te (if (lt (str_len pcm) 3200) 0 (enw-encode st pcm)))
    (let t3 (now_unix_ms))
    (print_str (str_concat "samples=" (str_concat (int_to_str (div (str_len pcm) 2)) (str_concat " Tenc=" (str_concat (int_to_str Te) (str_concat " encode_ms=" (int_to_str (sub t3 t2))))))))
    (let r (if (eq Te 0) (list (enw-lang-lo) (list)) (enw-transcribe st Te 40)))
    (let t4 (now_unix_ms))
    (print_str (str_concat "lang=" (str_concat (enw-lang-code (head r)) (str_concat " tokens=" (str_concat (int_to_str (len (nth r 1))) (str_concat " decode_ms=" (int_to_str (sub t4 t3))))))))
    (print_str (str_concat "ids=" (er-join (nth r 1))))
    (print_str (str_concat "text=" (enw-text st (nth r 1))))
    (print_str (metal_status))
    0)
