// Numeric policy remains an exact wire claim before generic JSON conversion.
// preludes: form/form-stdlib/bml/concept-translation-worker.bml observe/concept-translation-witness.bml
section [form.bml] {
 class ConceptTranslationAdmissionWitness {
  def ctaw-source(number) = str_concat("{\"id\":\"numeric\",\"operation\":\"prepare\",\"labels\":[\"a\"],\"target\":\"id\",\"maxRows\":",str_concat(number,",\"maxUnits\":2200}"));
  def ctaw-refusals(state,values) = if nil?(values) then 1 else ctaw-refuse(state,head(values),tail(values));
  def ctaw-refuse(state,value,rest) {
   ctw-check(state,str_concat("integer-wire-refusal-",value),not(ctr-good(ctwk-syntax(ctaw-source(value))))); ctaw-refusals(state,rest);
  }
  def ctaw-run() {
   let state = cmm-state(".","form-sha256");
   ctaw-refusals(state,list("18446744073709551716","9223372036854775908","4611686018427387904","-1","1.0","1e2","1e999","0","100x","01","true","\"100\""));
   let largest = ctwk-syntax(ctaw-source("4611686018427387903"));
   ctw-check(state,"largest-positive-tagged-integer-admitted-exactly",and(ctr-good(largest),eq(ctwk-num(ctr-value(largest),"maxRows"),4611686018427387903)));
   ctw-check(state,"ordinary-policy-admitted",ctr-good(ctwk-syntax(ctaw-source("100"))));
   ctw-check(state,"numeric-text-keeps-string-meaning",ctr-good(ctwk-syntax("{\"id\":\"18446744073709551716\",\"operation\":\"prepare\",\"labels\":[\"1e999 \\\"-1\\\"\"],\"target\":\"id\",\"maxRows\":100,\"maxUnits\":2200}")));
   ctw-check(state,"delay-multiplication-refuses-before-overflow",not(ctt-policy(4,4611686018427387903,1)));
   ctw-check(state,"sleep-nanosecond-deadline-refuses-before-overflow",not(ctt-policy(2,add(ctt-sleep-limit(),1000),1)));
   ctw-check(state,"no-delay-policy-keeps-large-attempt-domain",ctt-policy(4611686018427387903,0,1));
   ctw-check(state,"retry-flag-must-be-integer",not(ctt-policy(5,400,1.0)));
   ctw-check(state,"actual-live-policy-admitted",ctt-policy(5,400,0));
   print(list("translation-admission","observations",record_get(state,"observations"),"provider-requests",0)); 1;
  }
 }
 ctaw-run();
}
