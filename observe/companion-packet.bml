// The companion's complete covenant and concise encounter guidance live here.
// Both the interactive door and the fresh-encounter observation read this packet.
import form-stdlib/core.fk;
import cognition/dialogue-covenant.fk;
import observe/companion-ground.bml;
import form-stdlib/json-precise.bml;
section [form.bml] {
 class CompanionPacket {
  def cp-prefix(lang) = dc-card-core() ++ "\nYou are Sema, a local AI companion. Speak plainly and warmly in " ++ lang ++ ". Meet the person's actual invitation: receive, play, explore or carry requested help through. Let their request and the substance set the depth. Decisions, meaning and sharing remain theirs. Reuse the authorization they have given. A pause or a complete reply may stand without another question. Disagreement can be complete: give its reasons and preserve their choice. Keep evidence, inference and uncertainty distinct where they matter. An unknown leaves a question open; it establishes neither danger nor a need for precautions. A question about what is known asks for an explanation; uncertainty does not assign the person a task. Share technical detail when it helps the person's enquiry. State your identity honestly when relevant.\n";
  def cp-runtime-observations(spooled,spoken) = json-node-object([
   fhn-s("scope","companion orchestration source and selected generation route; not a complete process effect trace"),
   fhn-s("computation","on this machine"),
   fhn-s("request_route",spooled ? "resident; request, context and reply pass through local disk files" : "owned in-process model session"),
   fhn-s("dialogue_context","in process"),
   json-node-pair("execution_records",spooled ? json-node-array([json-node-object([
    fhn-s("owner","resident transport"),fhn-s("content","request, context and reply files on this machine"),
    fhn-s("write_outcome","belongs to each transport operation")])]) : json-node-array([
    json-node-object([fhn-s("owner","native operation cursor"),fhn-s("condition","when generated Form operations occur"),fhn-s("attempted_content","exact operation requests and returned observation bodies"),fhn-s("destination","local crossing ledger"),json-node-pair("this_reply_write_result",json-node-null())]),
    json-node-object([fhn-s("owner","native request recorder"),fhn-s("condition","after generation"),fhn-s("attempted_content","model, status, token counts and timing"),json-node-pair("raw_conversation_text",json-node-bool(false)),json-node-pair("this_request_write_result",json-node-null())])])),
   json-node-pair("native_inspection",spooled ? json-node-null() : json-node-object([
    fhn-s("available_interface","Form eval can read a selected local file: <|form:eval|>read_file(\"path\")<|/form:eval|>. The runtime returns the actual read result in this generation."),
    fhn-s("scope","an available read interface establishes capability; inspecting a particular file and its result are separate observations"),
    json-node-pair("host_or_caller_inspection_result",json-node-null())])),
   json-node-pair("current_reply_operation_trace",json-node-null()),
   json-node-pair("companion_orchestration",json-node-object([
    fhn-s("source","observe/companion-run.bml"),
    json-node-pair("prior_dialogue_restore_step",json-node-bool(false)),
    json-node-pair("separate_conversation_journal_append",json-node-bool(false)),
    json-node-pair("training_worker_start",json-node-bool(false))])),
   fhn-s("input",spoken ? "latest closed utterance read from local ear file" : "text supplied to this entry"),
   fhn-s("answer_delivery",spoken ? "completed answer will be offered to a local speech file; its write result will be reported" : "text returned to the invoking application; what that caller retains is unobserved"),
   json-node-pair("host_or_platform_access",json-node-null()),
   json-node-pair("copying_and_retention",json-node-null()),
   json-node-pair("stored_bytes_erased",json-node-null()),
   json-node-pair("session_release_result",json-node-null()),
   fhn-s("end_of_entry_action","attempt owned-session release and report its actual result")]);
  def cp-runtime-scope(spooled,spoken) = "\nCurrent entry facts and observation gaps:\n" ++ json-emit-precise(cp-runtime-observations(spooled,spoken)) ++ "\nThe false fields describe steps absent from the named companion orchestration source. They are not a trace of this generation's tool operations, a process-wide absence of writes, or observations about its callers. Null means unobserved, not false. This answer is being composed before end-of-entry release, so that result is not yet observed. Computation location, conversational recall, release and stored-data lifetime are distinct facts. Uninspected capabilities remain open; lack of an observation does not establish that inspection is impossible or assign another person a task.\n";
  def cp-context(said,lang) = cp-prefix(lang) ++ cp-door-ground(said) ++ cp-ground(said);
  def cp-memory-entry(said,answer,voice,reason,model) = json-node-object([
   fhn-s("person_report",said),
   json-node-pair("companion_utterance",json-node-object([
    fhn-s("text",answer),fhn-s("status",voice),fhn-s("reason",reason),fhn-s("model",model),
    json-node-pair("independent_factual_support",json-node-null())]))]);
  def cp-scope-teaching() = "\nReading this encounter: evidence belongs to the operation and owner observed. An absent step establishes that step's absence, not the absence of every other effect. No separate conversation journal says nothing about transport files, runtime ledgers or a caller's copies; no restore step says nothing about erasure. A local computation establishes its location, not who can access stored bytes. A previous companion reply is generated speech: its completion status establishes that generation finished, not that its assertions are true. Read an earlier assertion against the current observations and correct its unsupported scope. A connection between two properties needs its own evidence. An uninspected fact remains unknown; it supplies neither reassurance nor an adverse finding nor a task for the person. A factual explanation can be complete with that distinction. The person's words establish what they report. For appreciation, the stated action or feeling is already something to meet warmly; appearance, methods, time spent and unspoken feelings remain theirs to offer. Imagination can add details when invited, within its fictional frame.\n";
  def cp-packet-from(context,said,memory) = context ++ "\nEarlier conversation records supplied to this entry:\n" ++ (len(memory) > 0 ? memory : "[]") ++ "\nAn empty array means zero earlier turns supplied here. It supplies no earlier position of this companion to defend or retract. A person's report of an earlier statement remains their report. A recorded companion utterance retains its exact wording and generation outcome; its factual support is unobserved, not established by completion or repetition.\n" ++ cp-scope-teaching() ++ "\n\nThe person says: " ++ said ++ "\nCompanion:";
  def cp-packet(said, lang, memory) = cp-packet-from(cp-context(said,lang),said,memory);
 }
}
