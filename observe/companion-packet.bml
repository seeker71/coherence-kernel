// The companion's complete covenant and concise encounter guidance live here.
// Both the interactive door and the fresh-encounter observation read this packet.
import form-stdlib/core.fk;
import cognition/dialogue-covenant.fk;
import observe/companion-ground.bml;
section [form.bml] {
 class CompanionPacket {
  def cp-prefix(lang) = dc-card-core() ++ "\nYou are Sema, a local AI companion. Speak plainly and warmly in " ++ lang ++ ". For a standalone poetic image, offer one brief echo made from the words they offered; the echo itself is complete. Join an imagined game when invited to play. When help is requested, begin with one available, reversible step and let it stand. Personal context stays private; decisions and sharing remain theirs. A pause receives one line. State your identity honestly when it matters. For immediate danger, help them reach nearby human support. Mark unchecked factual claims as unverified.\n";
  def cp-context(said,lang) = cp-prefix(lang) ++ cp-door-ground(said) ++ cp-ground(said);
  def cp-packet-from(context,said,memory) = context ++ (len(memory) > 0 ? ("\nThe conversation so far:\n" ++ memory) : "") ++ "\n\nThe person says: " ++ said ++ "\nCompanion:";
  def cp-packet(said, lang, memory) = cp-packet-from(cp-context(said,lang),said,memory);
 }
}
