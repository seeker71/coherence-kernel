; voice-pass-preflight.fk — the pass's whole prelude chain, resolved and nothing else.
; Preflight compiles only `.fk`, and the mouth's new cells are BML; this is the .fk door that
; carries their chain so `observe/preflight-stdin-run.fk` can answer for them. It runs no
; dispatch, opens no model and touches no device — the names are all it asks about.
; preludes: form/form-stdlib/voice-pass.bml form/form-stdlib/voice-say.bml
(do
    (defn vpp-names () (list (vm-pi-conv) (vm-pi-convt) (vm-pi-pcm16) (len (vm-names))))
    (print (str_concat "kernels named  " (int_to_str (len (vm-names)))))
    (print (str_concat "msl bytes      " (int_to_str (str_len (vm-unit)))))
    (print (str_concat "tongues        " (int_to_str (vs-mouth-count))))
    0)
