; aware-axes-run.fk — the witness door for the body's sense of its own aliveness.
;
; stdin: one committed line per line of input. Each is weighed against the one
; before it and its axes printed. The dense lane is opened once, the machine's
; floor is measured once, and every reading says which weather it was taken in.
;
;   printf 'the capital of France is Paris\nxqzt fribble morgnash\n' | ./fkwu observe/aware-axes-run.fk
;
; Nothing here touches the ear's live path: these are committed lines, arriving
; from a file or a spool that already closed them.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/aware-dense.bml form/form-stdlib/aware-vocab.bml form/form-stdlib/floor-lens.bml
(do
    (defn awr-text (s) (if (nothing? s) "" s))
    ; the floor lens keeps its best reading per checkout; a worktree that has never
    ; run it has NO best, and "a quiet machine" would then be a claim about a
    ; machine nobody weighed. Say the absence instead of inheriting a default.
    (defn awr-weather (gbs best)
        (if (le best 0.0)
            (str_concat "unweighed: " (str_concat (float_to_str gbs) " GB/s measured here, and this checkout holds no earlier reading of this door to call it fast or slow against"))
            (fl-weather gbs best)))
    (defn awr-pad (s n) (if (ge (str_len s) n) s (awr-pad (str_concat s " ") n)))
    (defn awr-row-value (row) (if (str_eq (nth row 4) "text") (nth row 6) (int_to_str (nth row 5))))
    (defn awr-say-rows (rows)
        (if (eq (len rows) 0) 0
            (do (let r (head rows))
                (print_str (str_concat "  " (str_concat (awr-pad (nth r 2) 24) (str_concat (awr-pad (awr-row-value r) 44) (nth r 3)))))
                (awr-say-rows (tail rows)))))
    (defn awr-loop (st vocab hist prev prevIds last n cache)
        (do (let got (awr-text (read_line)))
            (let line (trim got))
            (if (eq (str_len line) 0) n
                (do (let now (now_unix_ms))
                    (let gap (if (lt last 0) (sub 0 1) (sub now last)))
                    (let rec (awx-recurrence hist line))
                    (let own (awx-held (awx-words line) vocab))
                    (let scored (awd-score st prev prevIds line own rec gap cache))
                    (print_str (str_concat "--- line " (str_concat (int_to_str (add n 1)) " ---")))
                    (awr-say-rows (awx-rows (head scored)))
                    (awr-loop st vocab (awx-remember hist line) line (nth scored 2) (now_unix_ms) (add n 1) (nth scored 1))))))
    (let t0 (now_unix_ms))
    (let st (awd-open))
    (let t1 (now_unix_ms))
    (let vocab (awv-vocab))
    (let t2 (now_unix_ms))
    (let bw (fl-measure-bw (mr-path (mr-find "llama32-1b"))))
    (let gbs (fl-gbs bw))
    (let tfl (fl-tflops (fl-measure-flops)))
    (let t3 (now_unix_ms))
    (print_str (str_concat "aware: lane up in " (str_concat (int_to_str (sub t1 t0)) (str_concat " ms, own vocabulary " (str_concat (int_to_str (len vocab)) (str_concat " words in " (str_concat (int_to_str (sub t2 t1)) " ms")))))))
    (print_str (str_concat "aware: floor measured in " (str_concat (int_to_str (sub t3 t2)) " ms")))
    (awr-say-rows (awx-floor-rows (float_to_int (mul gbs 100.0)) (float_to_int (mul tfl 100.0)) (awr-weather gbs (fl-best-seen)) (sub t1 t0)))
    (let n (awr-loop st vocab (list) "" (list) (sub 0 1) 0 (list)))
    (print_str (str_concat "aware: " (str_concat (int_to_str n) " lines weighed")))
    0)
