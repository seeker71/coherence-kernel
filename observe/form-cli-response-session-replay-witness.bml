// preflight-exec: forbidden
// Exercise real admission and JSON replay with an intentional pre-model refusal.
// The refused request is a lifecycle observation, not a successful answer task.
// preludes: form-stdlib/bml/form-cli-response-session.bml
section [form.bml] {
 def frsw-need(ok,why) = if ok then 1 else form_error(why);
 let artifact = "receipts/artifacts/2026-09-20-response-session-replay-witness.json";
 let request = parse-json("pre-model-refusal","{\"mode\":\"review\",\"review_entry\":\"direct\",\"evaluation\":1,\"context\":0,\"goal\":\"Observe replay of a pre-model context refusal\",\"documents\":[{\"id\":\"value\",\"path\":\"value.json\",\"text\":\"{\\\"value\\\":7}\"}],\"writable\":[],\"checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\",\"value.json\"],\"stdout\":\"7\\n\"}],\"report_checks\":[{\"tool\":\"jq\",\"arguments\":[\".value\"],\"stdout\":\"7\\n\"}]}");
 let member = json-node-object(list(nsm-s("id","pre-model-refusal"),json-node-pair("request",request)));
 let manifest = json-node-object(list(nsm-s("session","response-replay-observation"),nsm-s("run_id","2026-09-20-refusal"),json-node-pair("cases",json-node-array(list(member)))));
 let firstText = frss-run(manifest);
 frsw-need(faj-valid(firstText),"first public response-session result is not JSON text");
 let first = parse-json("first",firstText);
 let replayText = frss-text(json-emit(manifest));
 frsw-need(faj-valid(replayText),"public replay is not JSON text");
 let replay = parse-json("replay",replayText);
 frsw-need(str_eq(fcap-string(replay,"status"),"terminal-replay"),"completed refusal was not replayed");
 frsw-need(and(eq(nsm-num(replay,"native_executions_new"),0),and(eq(nsm-num(replay,"native_executions_historical"),1),eq(nsm-num(replay,"provider_processes_new"),0))),"replay new/history accounting differs");
 let root = fcap-string(replay,"evidence"); let rows = node_children(json-object-get(replay,"results"));
 let result = parse-json("retained-case",read_file(frsh-path(fcap-string(head(rows),"evidence"),"result.json")));
 frsw-need(str_eq(fcap-string(result,"reason"),"positive-context-and-turns-required"),"witness did not stop at the pre-model context boundary");
 let conflict = parse-json("conflict",frss-text(str_concat(json-emit(manifest)," ")));
 frsw-need(str_eq(fcap-string(conflict,"status"),"run-identity-conflict"),"changed request bytes reused one logical identity");
 let unkeyed = if fs_exists(artifact) then json-object-get(parse-json("retained-witness",read_file(artifact)),"unkeyed") else {
  let freshManifest = json-node-object(oh-without(json-object-pairs(manifest),"run_id"));
  let a = parse-json("fresh-a",frss-run(freshManifest)); let b = parse-json("fresh-b",frss-run(freshManifest));
  frsw-need(and(not(str_eq(fcap-string(a,"evidence"),fcap-string(b,"evidence"))),and(eq(nsm-num(a,"native_executions_new"),1),eq(nsm-num(b,"native_executions_new"),1))),"unkeyed invocation ceased to be a fresh execution");
  json-node-object(list(nsm-s("first",fcap-string(a,"evidence")),nsm-s("second",fcap-string(b,"evidence")),nsm-n("native_case_executions",2)));
 };
 let summary = json-node-object(list(nsm-s("scope","real public controller admission and replay of an intentionally invalid context; no model admitted and no quality claim"),nsm-s("evidence",root),nsm-s("first_status",fcap-string(first,"status")),nsm-n("first_native_executions_new",nsm-num(first,"native_executions_new")),nsm-n("replay_native_executions_new",nsm-num(replay,"native_executions_new")),nsm-n("native_executions_historical",nsm-num(replay,"native_executions_historical")),nsm-n("provider_processes_new",nsm-num(replay,"provider_processes_new")),nsm-s("retained_reason",fcap-string(result,"reason")),nsm-s("conflict",fcap-string(conflict,"status")),json-node-pair("unkeyed",unkeyed)));
 if not(fs_exists(artifact)) then frsh-frozen(artifact,json-emit(summary)) else 0;
 print_str(json-emit(summary));
 1;
}
