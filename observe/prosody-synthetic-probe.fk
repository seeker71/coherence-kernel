; preludes: form/form-stdlib/room-prosody.bml
(do
    ; a sawtooth of a known period, built as s16le bytes: synthetic truth for a period detector
    (defn le16 (v) (do (let u (if (lt v 0) (add v 65536) v)) (str_concat (byte_to_str (mod u 256)) (byte_to_str (div u 256)))))
    (defn saw (n period amp i acc) (if (ge i n) acc (saw n period amp (add i 1) (str_concat acc (le16 (sub (mul (div (mul (mod i period) (mul 2 amp)) period) 1) amp))))))
    (defn tone (period amp) (saw 1600 period amp 0 ""))
    (defn zeros (n acc) (if (ge (str_len acc) (mul 2 n)) (substring acc 0 (mul 2 n)) (zeros n (str_concat acc (le16 0)))))
    (let t0 (now_unix_ms))
    (let a (rpr-pitch-of (tone 40 8000)))
    (let t1 (now_unix_ms))
    (print_str (str_concat (str_concat "period 40 samples -> expect 400 Hz  got " (str_concat (int_to_str (head a)) (str_concat "  r=" (float_to_str (nth a 1))))) (byte_to_str 10)))
    (print_str (str_concat (str_concat "one pitch pass ms: " (int_to_str (sub t1 t0))) (byte_to_str 10)))
    (let b (rpr-pitch-of (tone 80 8000)))
    (print_str (str_concat (str_concat "period 80 -> expect 200 Hz  got " (str_concat (int_to_str (head b)) (str_concat "  r=" (float_to_str (nth b 1))))) (byte_to_str 10)))
    (let c (rpr-pitch-of (tone 160 8000)))
    (print_str (str_concat (str_concat "period 160 -> expect 100 Hz  got " (str_concat (int_to_str (head c)) (str_concat "  r=" (float_to_str (nth c 1))))) (byte_to_str 10)))
    (let d (rpr-pitch-of (tone 61 8000)))
    (print_str (str_concat (str_concat "period 61 -> expect 262 Hz  got " (str_concat (int_to_str (head d)) (str_concat "  r=" (float_to_str (nth d 1))))) (byte_to_str 10)))
    (let e (rpr-pitch-of (zeros 1600 "")))
    (print_str (str_concat (str_concat "silence -> expect 0  got " (int_to_str (head e))) (byte_to_str 10)))
    (print_str (str_concat (str_concat "tilt of a 400 Hz saw (low-heavy, expect positive): " (int_to_str (rpr-tilt-of (tone 40 8000)))) (byte_to_str 10)))
    (print_str (str_concat (str_concat "tilt of alternating +/- (high only, expect negative): " (int_to_str (rpr-tilt-of (tone 2 8000)))) (byte_to_str 10)))
    (print_str (str_concat (str_concat "db10 of a full-scale rms: " (int_to_str (rpr-db10 32768))) (byte_to_str 10)))
    (print_str (str_concat (str_concat "db10 of one tenth scale: " (int_to_str (rpr-db10 3277))) (byte_to_str 10)))
    0)
