; ask-lane-floor.fk — what the ASK verb can actually say on THIS host, as a value.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/ask-cost-receipt.fk form-stdlib/ask-native-lane.fk form-stdlib/form-cli-ask.fk
;
; WHY THIS CELL EXISTS. Asked on 2026-07-25 to answer a question through form-cli on the
; 100% native model. The answer is no, on this host — and the difference between a prose
; "no" and this cell is that a prose no is a claim. form-cli-ask.fk already computes every
; part of the refusal; nothing here decides anything new. It folds what the verb already
; returns into one scalar a caller can route on, so "the native model cannot answer here"
; is something the body RETURNS rather than something a reader is asked to believe.
;
; WHAT IS DELIBERATELY NOT ASSERTED. The floor code is a REPORT, not a law — it is 0 in
; this container and would be 10 or 11 on a machine holding the weights, and a band that
; asserted 0 would fail exactly where the voice finally came home. The band proves the
; ROUTING DISCIPLINE instead, which is the same on every host: the grounded lane takes a
; question the native lane declines, the decline always carries its reason, and no answer
; from either lane is ever lane-less. Those hold whether or not a model is resident.
;
; Kin: form-cli-ask.fk (fca-* — the verb this reads), ask-native-lane.fk (anl-* — the
; native lane and its question binding), rag-ask.fk (ra-* — the grounded lane),
; form/form-stdlib/native-vs-rented.fk (the older, coarser form of this same question).
;
; NOT the same organ as form-stdlib/tests/form-cli-ask-band.fk (262143), which shares the
; `fca-` prefix and is easy to mistake for this. That band proves form-cli-ask-GATE.fk —
; the posterior sufficiency gate, over synthetic signal tuples, four-way: given an answer
; and its signals, does it become OBSERVED. This cell proves the step before it, on real
; host state: which lane gets to answer at all, and whether its decline is audible. A
; question can route perfectly and still fail the gate, or pass the gate having been
; answered by a lane nobody named. Both are needed and neither subsumes the other.
; observe/membrane-lane-live.fk is the third of the set — it takes the crossings a lane
; owes and turns each into a live request-evidence ask on the bidirectional channel.
;
; Proven by: observe/tests/ask-lane-floor-band.fk (verdict 31).
; witnessed: 2026-07-25 -> floor code 0 in this container (no GPU, no runner, no GGUF,
;            no staged index; rag-heal is fail-closed at refusal 73)

(do
    (defn alf-index-path () ".coherence-network/rag-index/index.jsonl")
    (defn alf-present? (p) (if (gt (file_size p) 0) 1 0))

    ; ── the two lanes, each asked whether it can speak, not told ──────────────
    (defn alf-native-ready? (q) (anl-ready? q))
    (defn alf-grounded-index? () (alf-present? (alf-index-path)))
    (defn alf-lane (q) (fca-lane-of q))
    (defn alf-declined (q) (anl-refusal q))
    (defn alf-answer (q) (fca-ask q))

    ; ── the floor, folded: 11 both / 10 native only / 1 grounded only / 0 neither ──
    (defn alf-floor-code (q)
        (add (mul (alf-native-ready? q) 10) (alf-grounded-index?)))

    ; ── the routing discipline, stated as predicates a band can hold ──────────
    ; 1. a question the native lane declines is routed to the grounded lane
    (defn alf-routes-to-grounded? (q)
        (if (eq (alf-native-ready? q) 0)
            (if (str_eq (alf-lane q) (fca-rag-lane)) 1 0)
            1))
    ; 2. a decline is never silent — no readiness without an empty reason, and no
    ;    unreadiness without a stated one
    (defn alf-decline-named? (q)
        (if (eq (alf-native-ready? q) 0)
            (if (str_eq (alf-declined q) "") 0 1)
            (if (str_eq (alf-declined q) "") 1 0)))
    ; 3. nothing this verb hands back is lane-less, including a miss
    (defn alf-answer-carries-lane? (q)
        (if (ge (str_find (alf-answer q) "local-lane:" 0) 0) 1 0))
    ; 4. when the fallback was taken, the answer carries the reason too
    (defn alf-answer-carries-decline? (q)
        (if (eq (alf-native-ready? q) 0)
            (if (ge (str_find (alf-answer q) "declined:" 0) 0) 1 0)
            1))
    ; 5. the floor code is well-formed — one of the four reachable states
    (defn alf-floor-wellformed? (q)
        (do (let c (alf-floor-code q))
            (if (or (eq c 0) (or (eq c 1) (or (eq c 10) (eq c 11)))) 1 0)))
    0)
