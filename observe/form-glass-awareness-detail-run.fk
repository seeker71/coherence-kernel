; Read the standing observer's native detail channel; no new observer is started.
; preludes: observe/say.fk form/form-stdlib/hearth.bml form/form-stdlib/bml/form-glass-awareness.bml
(do
  (defn fgad-lines (events left)
    (if (or (eq (len events) 0) (le left 0)) 0
      (do (let e (head events))
        (let line (say-line (fgtm-cat (list (fga-get e "source") "/" (fga-get e "id") ": " (fga-get e "reason") " -> " (fga-get e "action")))))
        (fgad-lines (tail events) (sub left 1)))))
  (defn fgad-show (frame)
    (if (nothing? frame) (say-line "glass-awareness absent: start or renew the existing Glass carrier")
      (if (not (and (eq (len frame) 3) (str_eq (head frame) (FGASchema)))) (say-line "glass-awareness unknown grammar: request evidence")
        (do (let state (nth frame 2))
          (let summary (say-line (fgtm-cat (list "glass-awareness age-ms=" (int_to_str (sub (now_unix_ms) (nth frame 1))) " rows=" (int_to_str (fga-get state "after")) " unread=" (int_to_str (fga-get state "unread-rows")) " asks=" (int_to_str (fga-get state "ask-count")) " gifts=" (int_to_str (fga-get state "gifts")) " recipes=" (int_to_str (len (fga-get state "recipes")))))))
          (fgad-lines (fga-get state "asks") 8)))))
  (let shown (fgad-show (fga-read (hearth-telemetry-root))))
  0)
