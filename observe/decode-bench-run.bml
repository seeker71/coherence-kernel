// decode-bench-run.bml — what one decoded token costs the native Llama voice, and where it goes.
//
//   ./fkwu observe/decode-bench-run.bml
//
// Opens the 3B voice with its voice-native adapter, prefills a chat prompt, then decodes 40 tokens one at a time two ways and prints
// milliseconds a token, the device's own busy milliseconds (metal_live word 11), dispatches (word 7) and syncs (word 8) a token:
//   next    nlg-forward-next: the forward of one token and one argmax read back
//   choice  nlg-forward-choice: the forward and three argmaxes (best, second, third), what the in-stream walk asks of every token
// The tokens follow the best pick, so both walks see the same text. The GPU should be quiet for the numbers to be the voice's.
// preflight-exec: forbidden
import form-stdlib/native-llama-voice.bml;
import form-stdlib/model-registry.bml;
import form-stdlib/metal-carrier.bml;
section [form.bml] {
 class DecodeBenchRun {
  // DECODE_STEPS=400 holds the device under load long enough to read its sustained rate: a few seconds of work run at a burst
  // clock, and a long run is slower (the candle: 28 ms a product at rest, 71 to 76 after seconds of continuous work)
  def dbr-steps() = str_to_int(host_getenv("DECODE_STEPS") ?? "40");
  // the wall of each window of 40 tokens in order, in tenths of a ms a token, and the device's busy time in the same windows
  def dbr-windows(rows) = nil?(rows) ? [] : cons([dbr-sum(take(40, rows), 1) * 10 / len(take(40, rows)), dbr-sum(take(40, rows), 2) * 10 / len(take(40, rows))], dbr-windows(drop(40, rows)));
  def dbr-one(model, ctx, id, pos, choice) {
   let a = metal_live();
   let t0 = host_monotonic_ms();
   let picked = choice ? nlg-forward-choice(model, ctx, [id], pos, "", "decode") : nlg-forward-next(model, ctx, [id], pos, "", "decode");
   let ms = host_monotonic_ms() - t0;
   let b = metal_live();
   [choice ? picked[0] : picked, ms, (b[11] - a[11]) / 1000, b[7] - a[7], b[8] - a[8]];
  }
  def dbr-walk(model, ctx, id, pos, n, choice, rows) = n <= 0 ? rows : dbr-walk-next(model, ctx, pos, n, choice, rows, dbr-one(model, ctx, id, pos, choice));
  def dbr-walk-next(model, ctx, pos, n, choice, rows, r) = dbr-walk(model, ctx, r[0], pos + 1, n - 1, choice, cons(r, rows));
  def dbr-sum(rows, k) = foldl((a, r) => a + r[k], 0, rows);
  def dbr-say(label, rows) {
   let n = len(rows);
   print_str("[decode-bench] " ++ label ++ ": " ++ (dbr-sum(rows, 1) * 10 / n).str() ++ " tenth-ms a token, device busy " ++ (dbr-sum(rows, 2) * 10 / n).str() ++ " tenth-ms, dispatches " ++ (dbr-sum(rows, 3) / n).str() ++ ", syncs " ++ (dbr-sum(rows, 4) / n).str() ++ " (" ++ n.str() ++ " tokens)");
   // the gap between the wall and the device's busy time is read with every run: the device idle is the host encoding, the sync
   // and a starved host thread
   print_str("[decode-bench] " ++ label ++ ": the device idle " ++ ((dbr-sum(rows, 1) - dbr-sum(rows, 2)) * 10 / n).str() ++ " tenth-ms a token (" ++ (((dbr-sum(rows, 1) - dbr-sum(rows, 2)) * 100) / dbr-sum(rows, 1)).str() ++ "% of the wall)");
  }
  def dbr-run() {
   let a = mca-admit(".hearth/carrier.log", ".hearth/carrier.err");
   let session = nlg-open(mr-path(mr-find("llama32-3b-mlx-4bit")), "form/form-stdlib/adapters/llama-3.2-3b-voice-native");
   let model = session[0]; let tk = session[1];
   let ids = nlt-chat(tk, "What is 17 * 23 + 4? Answer with the number only.");
   let ctx = nll-context(model, len(ids) + dbr-steps() + 8);
   let pre = nlg-prefill(model, ctx, ids, 0, "");
   let first = pre[0][0];
   let candle1 = nam-candle();
   let rows1 = dbr-walk(model, ctx, first, pre[1], dbr-steps(), 0 == 1, []);
   let candle2 = nam-candle();
   let ctx2 = nll-context(model, len(ids) + dbr-steps() + 8);
   let pre2 = nlg-prefill(model, ctx2, ids, 0, "");
   let rows2 = dbr-walk(model, ctx2, pre2[0][0], pre2[1], dbr-steps(), 1 == 1, []);
   let candle3 = nam-candle();
   let c = print_str("[decode-bench] the machine candle (a fixed matrix product, tenths of a ms) before the first pass " ++ (candle1 / 100).str() ++ ", between " ++ (candle2 / 100).str() ++ ", after the second " ++ (candle3 / 100).str());
   let w = len(rows1) > 40 ? print_str("[decode-bench] next, by windows of 40 tokens (wall, device busy; tenth-ms a token): " ++ value_str(dbr-windows(reverse(rows1)))) : 0;
   let s1 = dbr-say("next (forward, one argmax)", rows1);
   let s2 = dbr-say("choice (forward, three argmaxes)", rows2);
   let closed = nll-context-close(ctx);
   let closed2 = nll-context-close(ctx2);
   let end = nlg-close(session);
   0;
  }
 }
 dbr-run();
}
