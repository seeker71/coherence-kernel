// disk-steward-run.bml — the body reads its own disk, weighs its leases, and composts what it chooses.
//
//   ./fkwu observe/disk-steward-run.bml </dev/null                 read: the volume, the leases, what it would release
//   printf 'act 1\n' | ./fkwu observe/disk-steward-run.bml          release waste and pressure leases, delete merged own branches
//   printf 'act 2\n' | ./fkwu observe/disk-steward-run.bml          also remove idle, clean, merged worktrees
//   printf 'root /path\n' | ./fkwu observe/disk-steward-run.bml     tend another checkout
//   printf 'top 20\n' | ./fkwu observe/disk-steward-run.bml         how many of the largest leases to list (default 10)
//
// The organ is form-stdlib/bml/disk-steward.bml (ds-tend); every tending leaves a row in receipts/disk-steward-ledger.jsonl
// and a snapshot in the glass. stdin: `act N` | `root <path>` | `top N`   (frw-options)
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/form-rows.bml form-stdlib/bml/stdin-source.bml form-stdlib/bml/disk-steward.bml
section [form.bml] {
 class DiskStewardRun {
  def dsr-run() = dsr-with(frw-options(stdin-text() ?? ""));
  def dsr-with(o) {
   if (String) o[0] != "ok" then print_str("[disk] the options were refused at line " ++ o[2].str() ++ ": " ++ o[1] ++ "\n")
   else dsr-go(o[1]);
  }
  def dsr-go(o) {
   let root = frw-has?(o, "root") ? frw-str(o, "root", ".") : ".";
   let act = frw-int(o, "act", 0);
   let top = frw-int(o, "top", 10);
   let now = now_unix_ms() / 1000;
   let line = ds-tend(root, act);
   let said = print_str(line ++ "\n");
   let leases = filter(l => (String) ds-lkind(l) != "kept", ds-leases(root, now));
   print_str(top > 0 ? "the largest leases by release value:\n" ++ ds-top(leases, top) : "");
  }
 }
 dsr-run();
}
