// voice-pass-run.fk — the mouth's pass, run by the body, stage by stage, out loud.
//
// It opens a voice model, reports what the pass READ out of it (never what a hand told it), then
// walks the four parts — the text encoder, the duration predictor, the flow, the vocoder — and
// prints what each one answered. Nothing here plays a sound; hearing it is the room's to
// witness, not this pass's.
//
// The phoneme row is the one already proved identical to piper's, so a
// disagreement downstream is the pass's and nothing else's.
//
// preflight-exec: forbidden
import form/form-stdlib/voice-pass.bml;
section [form.bml] {
    def vr-default() = "en_GB-jenny_dioco-medium";
    def vr-voice() = {
        let t = read_file("/tmp/voice-onnx-target");
        nothing?(t) ? vr-default() : (Comparable) len(trim(t)) == 0 ? vr-default() : trim(t);
    };
    def vr-ids() = [1, 0, 41, 0, 59, 0, 3, 0, 15, 0, 120, 0, 52, 0, 17, 0, 74, 0, 119, 0, 3, 0, 74, 0, 38, 0, 3, 0, 24, 0, 120, 0, 62, 0, 122, 0, 26, 0, 74, 0, 44, 0, 3, 0, 32, 0, 59, 0, 3, 0, 31, 0, 28, 0, 120, 0, 21, 0, 122, 0, 23, 0, 10, 0, 2];
    def vr-line(k, v) = print((k + ("  " + v)));
    def vr-fsum(xs) = (Comparable) len(xs) == 0 ? 0.0 : (Number) xs[0] + (Number) vr-fsum(xs[1:]);
    def vr-fabs(xs) = (Comparable) len(xs) == 0 ? 0.0 : (Number) vv-abs(xs[0]) + (Number) vr-fabs(xs[1:]);
    def vr-ftext(xs) = (Comparable) len(xs) == 0 ? "" : (float_to_str(xs[0]) + ((String) ((Comparable) len(xs[1:]) == 0 ? "" : " ") + vr-ftext(xs[1:])));
    def vr-itext(xs) = (Comparable) len(xs) == 0 ? "" : (xs[0].str() + ((String) ((Comparable) len(xs[1:]) == 0 ? "" : " ") + vr-itext(xs[1:])));
    def vr-isum(xs) = (Comparable) len(xs) == 0 ? 0 : (Number) xs[0] + (Number) vr-isum(xs[1:]);
    def vr-first(xs, n) = n <= 0 ? [] : (Comparable) len(xs) == 0 ? [] : cons(xs[0], vr-first(xs[1:], n - 1));
    let voice = vr-voice();
    let path = vp-model-path(voice);
    let ids = vr-ids();
    print(("voice  " + voice));
    let st = vv-open(path);
    vr-line("door", (Comparable) vv-open-ok?(st) == 1 ? "pipelines up, model mapped, every scalar resolved" : ("REFUSED — " + vv-open-why(st)));
    (Comparable) vv-open-ok?(st) == 1 ? {
        vr-line("convolutions", (len(vv-ctab(st)).str() + " nodes read with their own kernel, stride, pad, dilation and group"));
        vr-line("encoder layers", vv-nlayers(st, 0).str());
        vr-line("coupling flows", vr-itext(vv-rcl-list(st)));
        vr-line("duration flows", vr-itext(vv-cf-list(st)));
        vr-line("vocoder", (vv-nups(st, 0).str() + (" upsamples, " + (vv-nres(st, 0).str() + " residual blocks"))));
        vr-line("read constants", ("eps " + (float_to_str(vv-eps(st)) + (", embed scale " + (float_to_str(vv-escale(st)) + (", ffn pad " + (vv-ffnpad(st).str() + (", vocoder divisor " + float_to_str(vv-decdiv(st))))))))));
        print("");
        let enc = vv-enc(st, ids);
        let sy = metal_sync();
        let mp = vv-read(enc[1], 0, vv-tn(enc[1]));
        vr-line("phonemes", len(ids).str());
        vr-line("encoder x", (vv-tc(enc[0]).str() + (" x " + vv-tl(enc[0]).str())));
        vr-line("m_p sum", float_to_str(vr-fsum(mp)));
        vr-line("m_p |sum|", float_to_str(vr-fabs(mp)));
        vr-line("m_p first 6", vr-ftext(vr-first(mp, 6)));
        print("");
        let logw = vv-logw(st, enc[0]);
        let durs = vv-durs(logw, 1.0);
        vr-line("logw first 8", vr-ftext(vr-first(logw, 8)));
        vr-line("durations", vr-itext(durs));
        vr-line("frames", vr-isum(durs).str());
        print("");
        let t0 = now_unix_ms();
        let o = vv-render(st, ids, 1.0);
        let t1 = now_unix_ms();
        let samples = vv-read(o, 0, vv-tn(o));
        vr-line("samples", vv-tn(o).str());
        vr-line("sample sum", float_to_str(vr-fsum(samples)));
        vr-line("sample |sum|", float_to_str(vr-fabs(samples)));
        vr-line("first 8", vr-ftext(vr-first(samples, 8)));
        vr-line("at 1000", vr-ftext(vr-first(vv-read(o, 1000, 8), 8)));
        vr-line("render", ((t1 - t0).str() + (" ms for " + (float_to_str(divide(1.0 * vv-tn(o), 1.0 * vp-sample-rate(vp-cfg(voice)))) + " s of speech"))));
        0;
    } : 0;
}
