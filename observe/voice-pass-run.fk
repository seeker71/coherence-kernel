; voice-pass-run.fk — the mouth's pass, run by the body, stage by stage, out loud.
;
; It opens a voice model, reports what the pass READ out of it (never what a hand told it), then
; walks the four parts — the text encoder, the duration predictor, the flow, the vocoder — and
; prints what each one answered. Nothing here plays a sound; `observe/voice-room-witness.fk` is
; the door that does.
;
; The phoneme row is the one `voice-onnx-band.fk` already proved identical to piper's, so a
; disagreement downstream is the pass's and nothing else's.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/voice-pass.bml
(do
    (defn vr-default () "en_GB-jenny_dioco-medium")
    (defn vr-voice ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vr-default) (if (eq (str_len (trim t)) 0) (vr-default) (trim t)))))
    (defn vr-ids () (list 1 0 41 0 59 0 3 0 15 0 120 0 52 0 17 0 74 0 119 0 3 0 74 0 38 0 3 0 24 0 120 0 62 0 122 0 26 0 74 0 44 0 3 0 32 0 59 0 3 0 31 0 28 0 120 0 21 0 122 0 23 0 10 0 2))
    (defn vr-line (k v) (print (str_concat k (str_concat "  " v))))
    (defn vr-fsum (xs) (if (eq (len xs) 0) 0.0 (add (head xs) (vr-fsum (tail xs)))))
    (defn vr-fabs (xs) (if (eq (len xs) 0) 0.0 (add (vv-abs (head xs)) (vr-fabs (tail xs)))))
    (defn vr-ftext (xs) (if (eq (len xs) 0) "" (str_concat (float_to_str (head xs)) (str_concat (if (eq (len (tail xs)) 0) "" " ") (vr-ftext (tail xs))))))
    (defn vr-itext (xs) (if (eq (len xs) 0) "" (str_concat (int_to_str (head xs)) (str_concat (if (eq (len (tail xs)) 0) "" " ") (vr-itext (tail xs))))))
    (defn vr-isum (xs) (if (eq (len xs) 0) 0 (add (head xs) (vr-isum (tail xs)))))
    (defn vr-first (xs n) (if (le n 0) (list) (if (eq (len xs) 0) (list) (cons (head xs) (vr-first (tail xs) (sub n 1))))))

    (let voice (vr-voice))
    (let path (vp-model-path voice))
    (let ids (vr-ids))
    (print (str_concat "voice  " voice))
    (let st (vv-open path))
    (vr-line "door" (if (eq (vv-open-ok? st) 1) "pipelines up, model mapped, every scalar resolved" (str_concat "REFUSED — " (vv-open-why st))))
    (if (eq (vv-open-ok? st) 1)
        (do
            (vr-line "convolutions" (str_concat (int_to_str (len (vv-ctab st))) " nodes read with their own kernel, stride, pad, dilation and group"))
            (vr-line "encoder layers" (int_to_str (vv-nlayers st 0)))
            (vr-line "coupling flows" (vr-itext (vv-rcl-list st)))
            (vr-line "duration flows" (vr-itext (vv-cf-list st)))
            (vr-line "vocoder" (str_concat (int_to_str (vv-nups st 0)) (str_concat " upsamples, " (str_concat (int_to_str (vv-nres st 0)) " residual blocks"))))
            (vr-line "read constants" (str_concat "eps " (str_concat (float_to_str (vv-eps st)) (str_concat ", embed scale " (str_concat (float_to_str (vv-escale st)) (str_concat ", ffn pad " (str_concat (int_to_str (vv-ffnpad st)) (str_concat ", vocoder divisor " (float_to_str (vv-decdiv st))))))))))
            (print "")
            (let enc (vv-enc st ids))
            (let sy (metal_sync))
            (let mp (vv-read (nth enc 1) 0 (vv-tn (nth enc 1))))
            (vr-line "phonemes" (int_to_str (len ids)))
            (vr-line "encoder x" (str_concat (int_to_str (vv-tc (head enc))) (str_concat " x " (int_to_str (vv-tl (head enc))))))
            (vr-line "m_p sum" (float_to_str (vr-fsum mp)))
            (vr-line "m_p |sum|" (float_to_str (vr-fabs mp)))
            (vr-line "m_p first 6" (vr-ftext (vr-first mp 6)))
            (print "")
            (let logw (vv-logw st (head enc)))
            (let durs (vv-durs logw 1.0))
            (vr-line "logw first 8" (vr-ftext (vr-first logw 8)))
            (vr-line "durations" (vr-itext durs))
            (vr-line "frames" (int_to_str (vr-isum durs)))
            (print "")
            (let t0 (now_unix_ms))
            (let o (vv-render st ids 1.0))
            (let t1 (now_unix_ms))
            (let samples (vv-read o 0 (vv-tn o)))
            (vr-line "samples" (int_to_str (vv-tn o)))
            (vr-line "sample sum" (float_to_str (vr-fsum samples)))
            (vr-line "sample |sum|" (float_to_str (vr-fabs samples)))
            (vr-line "first 8" (vr-ftext (vr-first samples 8)))
            (vr-line "at 1000" (vr-ftext (vr-first (vv-read o 1000 8) 8)))
            (vr-line "render" (str_concat (int_to_str (sub t1 t0)) (str_concat " ms for " (str_concat (float_to_str (divide (mul 1.0 (vv-tn o)) (mul 1.0 (vp-sample-rate (vp-cfg voice))))) " s of speech"))))
            0)
        0)
)
