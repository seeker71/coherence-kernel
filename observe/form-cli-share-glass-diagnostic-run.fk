; form-cli-share-glass-diagnostic-run.fk — bounded framebuffer exchange for
; the completed-share publisher prelude seam.
;
; Only compile-state codes and a source-presence bit enter the framebuffer.
; No prompt, answer, or rollout content crosses this diagnostic window.
;
; preludes: form/form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn fcsgd-has (path needle)
        (if (ge (str_find (read_file path) needle 0) 0) 1 0))
    (defn fcsgd-apply-revise (outbound inbound before revised)
        (if (or (nothing? inbound)
                (or (not (eq (bfc-direction inbound) 1))
                    (or (not (eq (bfc-kind inbound) 1))
                        (not (eq (bfc-exchange outbound)
                                 (bfc-exchange inbound))))))
            before
            (if (eq (bfc-payload inbound) 2) revised before)))
    (framebuffer-clear)
    ; 4101: the top-level runner relied on a nested BML prelude, leaving the
    ; fresh whole-chain preflight with two unresolved telemetry calls.
    ; 4102: the effectful runner names its telemetry membrane directly.
    (let outbound (bfc-envelope 0 90201 0 4101 4102))
    (let out-event (bfc-record-out outbound 1))
    (let inbound (bfc-control outbound 2))
    (let in-event (bfc-record-in inbound 2))
    (let applied (fcsgd-apply-revise outbound inbound 4101 4102))
    (let source-witness (fcsgd-has
        "form/form-stdlib/form-cli-share-run.fk"
        "; preludes: form-stdlib/form-glass-telemetry-membrane.bml"))
    (let reobserved (if (eq applied 4102) source-witness 0))
    (let outbound2 (bfc-envelope 0 90202 0 reobserved 0))
    (let out-event2 (bfc-record-out outbound2 3))
    (let inbound2 (bfc-control outbound2 0))
    (let in-event2 (bfc-record-in inbound2 4))
    ; 4111: a remembered live-loop band path was not present in this tree.
    ; 4112: source inventory selected the actual live UI transition band.
    (let outbound3 (bfc-envelope 0 90203 0 4111 4112))
    (let out-event3 (bfc-record-out outbound3 5))
    (let inbound3 (bfc-control outbound3 2))
    (let in-event3 (bfc-record-in inbound3 6))
    (let applied3 (fcsgd-apply-revise outbound3 inbound3 4111 4112))
    (let path-reobserved (if (eq applied3 4112)
        (if (gt (file_size
            "form/form-stdlib/tests/form-glass-live-ui-band.fk") 0) 1 0) 0))
    (let outbound4 (bfc-envelope 0 90204 0 path-reobserved 0))
    (let out-event4 (bfc-record-out outbound4 7))
    (let inbound4 (bfc-control outbound4 0))
    (let in-event4 (bfc-record-in inbound4 8))
    (list "form-cli-share-glass-diagnostic"
        "before" 4101 "applied" applied "source-reobserved" reobserved
        "path-before" 4111 "path-applied" applied3
        "path-reobserved" path-reobserved
        "framebuffer-events" (len (framebuffer-events))))
