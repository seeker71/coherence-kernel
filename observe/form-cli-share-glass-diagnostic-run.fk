                "form/form-stdlib/tests/form-cli-share-glass-band.fk") 0))
            1 0) 0))
    (let outbound6 (bfc-envelope 0 90206 0 share-paths-reobserved 0))
    (let out-event6 (bfc-record-out outbound6 11))
    (let inbound6 (bfc-control outbound6 0))
    (let in-event6 (bfc-record-in inbound6 12))
    ; 4131: a BML field-call spelling was copied into a direct Form band.
    ; 4132: the direct Form call shape is parenthesized at the call site.
    (let outbound7 (bfc-envelope 0 90207 0 4131 4132))
    (let out-event7 (bfc-record-out outbound7 13))
    (let inbound7 (bfc-control outbound7 2))
    (let in-event7 (bfc-record-in inbound7 14))
    (let applied7 (fcsgd-apply-revise outbound7 inbound7 4131 4132))
    (let syntax-reobserved (if (eq applied7 4132)
