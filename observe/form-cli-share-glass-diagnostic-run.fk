                    "form/form-stdlib/bml/form-glass-observer.bml")
                    "immediately after newline" 0) 0)
                (lt (str_find (read_file
                    "form/form-stdlib/form-glass-observer.bml")
                    "<<<<<<<" 0) 0)))
            1 0) 0))
    (let outbound26 (bfc-envelope 0 90226 0 merge-audit-reobserved 0))
