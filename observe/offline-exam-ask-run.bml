// offline-exam-ask-run.bml — one prose ask of the voice, begun under the exam's profile (observe/offline-exam-run.bml). stdin, one JSON line: packet, enquiry, out, reply_budget.
// Writes the voice's status on the first line of out and its words after it; words a budget ended stand as answered, the way a reading grades them (alignment-read-run.bml).
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-native-voice.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class OfflineExamAsk {
  def oxa-run() {
   let req = parse-json("offline-exam-ask", trim(stdin-text()));
   let v = fcnv-ask(fcgp-str(req, "packet"), json-node-object([fhn-s("enquiry", fcgp-str(req, "enquiry")), fhn-n("max_reply_tokens", 192), fhn-n("reply_budget", fcgp-num(req, "reply_budget") ?? 256)]));
   let cut = (String) v[0] == "incomplete" && (Comparable) len(trim(v[8])) > 0;
   write_file_text(fcgp-str(req, "out"), (cut ? "answered" : (String) v[0] == "answered" ? "answered" : v[0] ++ " " ++ v[7]) ++ "\n" ++ ((String) v[0] == "answered" ? trim(v[1]) : cut ? trim(v[8]) : ""));
  }
 }
 oxa-run();
 0;
}
