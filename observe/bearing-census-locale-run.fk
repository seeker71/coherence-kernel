; bearing-census-locale-run.fk — the bearing census over the locale-row walk.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/bearing-glass.bml form/form-stdlib/meaning-codes.bml
;
; The corpus band leans on its own row accessors. THIS workload leans on the
; body's shared string floor: every meaning round-tripping through every code
; reads locale rows, and reading a row is find, split, trim and char_at all the
; way down. It is the terrain `substring` was buried under — the reason a door
; can run at 4.59 MB/s for months and no band notice.
;
; Ten seconds and near two hundred million walker steps, so the census that
; follows it is a rounding error on its own reading.
;
; The order is the whole method: WORK, then SNAPSHOT the ledger, then think.

(do
    ; the shared floor the locale walk stands on, handed in by name because a hot row's
    ; unit names its resolution frame and not always the file the door lives in
    (defn bclr-sources ()
        (list "form/form-stdlib/core.fk"
              "form/form-stdlib/line-grammar.fk"
              "form/form-stdlib/meaning-codes.bml"
              "form/form-stdlib/sha256.fk"
              "form/form-stdlib/rag-key.bml"))
    (defn bclr-label () "the locale-row walk")
    (defn bclr-hold-ms () 20000)

    (let t0 (now_unix_ms))
    (let round (mc-all-round? (mc-meanings)))
    (let t1 (now_unix_ms))
    (let rows (kernel_hot_rows (BCSTopN)))
    (let walked (bgl-walked))

    (let worst (bgl-witness rows walked (sub t1 t0) (bclr-label) (bclr-sources)))
    (let said (print (str_concat "  every meaning round-tripped: " (int_to_str round))))
    (let held (host_sleep_ms (bclr-hold-ms)))
    worst)
