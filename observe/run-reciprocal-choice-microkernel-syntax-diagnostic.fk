; Bounded framebuffer exchange for the extra closer introduced while adding
; the humm-state band bit. Payloads are only depth/error counts and node ids.
import "../form/form-stdlib/core.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let failed (bfc-envelope 0 73 0 (list -1 1) 7399))
  (let revise (bfc-control failed 2))
  (bfc-record-out failed 1)
  (bfc-record-in revise 2)
  ; Re-observation is populated only after fresh preflight returned depth 0,
  ; errors 0, warnings 0, and unresolved 0 for the repaired band.
  (let healed (bfc-envelope 0 74 0 (list 0 0) 7499))
  (let continue (bfc-control healed 0))
  (bfc-record-out healed 3)
  (bfc-record-in continue 4)
  (list "reciprocal-choice-syntax-diagnostic"
    (list "observed-depth" -1 "errors" 1)
    (list "selected-action" (bfc-payload revise)
          "repair-node" (bfc-apply failed revise 7302 7305))
    (list "reobserved-depth" 0 "errors" 0
          "selected-action" (bfc-payload continue)
          "healthy-node" (bfc-apply healed continue 7400 7405))
    (list "framebuffer-events" (len (framebuffer-events)))))
