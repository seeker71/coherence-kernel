; qwen38-family-native-exec-resident-batch-live-run.fk -- PENDING physical
; current-family native execution in one local-Qwen residence.
;
; EFFECTFUL. `observe/preflight-run.fk` executes its target, so DO NOT point it
; at this driver or run this driver while another sibling owns Qwen/Metal. The
; pure scheduler/ledger and adversarial band are the executable review surfaces.
; This file is checked only for lexical balance until an intentional carrier
; window opens.
;
; One Qwen context and one stream state stay resident across every current
; canonical `fkpfm-family-ids` row. For each family, the exact typed teaching frame
; enters that state; the next complete raw model reply is parsed scannerlessly.
; Metal is offered only when every byte equals the bound recipe-exec request.
; Form generates/JITs/executes/releases the native operation, injects the typed
; frex result into the same state, and requires the exact family/run-bound held
; acknowledgement before teaching the next family. The model never executes
; Form. After the final acknowledgement, the one stream/context is released;
; only then are the current-census v2 checks/evidences/receipts finalized.
;
; No remote call, persistence, ops table, flattening, or C growth occurs.
; preludes: form-stdlib/form-knowledge-family-native-exec-resident-batch.fk form-stdlib/form-cli-model-session.fk form-stdlib/model-registry.bml

(do
    (defn qfnb-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn qfnb-model-id () "Qwen3.8-27B-Q8_0-local")
    (defn qfnb-receipt-path ()
        "receipts/2026-08-26-family-native-exec-resident-batch-pure.md")
    (defn qfnb-line (name value)
        (print_str (str_concat name (str_concat "="
            (str_concat value "\n")))))
    (defn qfnb-int (name value) (qfnb-line name (int_to_str value)))
    (defn qfnb-bit (held weight) (if held weight 0))
    (defn qfnb-batch-id (started receipt-source-sha)
        (nmfe-sha256 (nmfe-fields (list
            "family-native-resident-physical-batch-v1"
            (int_to_str started) (qfnb-model-id) receipt-source-sha))))
    (defn qfnb-residence-id (batch-id started)
        (nmfe-sha256 (nmfe-fields (list
            "family-native-resident-context-v1" batch-id (qfnb-model-id)
            (int_to_str started)))))
    (defn qfnb-same-residence? (opened current)
        (if (and (eq (fcms-resident? opened) 1)
                 (and (eq (fcms-resident? current) 1)
                 (and (eq (fkpfm-equal?
                               (fcms-ctx opened) (fcms-ctx current)) 1)
                      (eq (fkpfm-equal?
                               (fcms-sts opened) (fcms-sts current)) 1)))) 1 0))
    (defn qfnb-prompt (first-row)
        (fkfne-cat (list
            "You are entering one bounded local Form-native execution batch. "
            "The same context will receive "
            (int_to_str (fkfnb-family-count))
            " current family lessons, one at a "
            "time. For each lesson, reply first with exactly the recipe-exec "
            "bytes named by the typed frame: no thought, prose, markdown, "
            "leading byte, trailing byte, or duplicate frame. Form parses the "
            "raw decoded byte stream and executes; you do not execute Form. "
            "After the typed frex observation, reply with exactly the held "
            "frame whose family, binding, and run Form names. Then the next "
            "lesson will arrive.\n"
            (fkfnb-schedule-teach first-row)
            "\nAfter its frex observation, reply exactly:\n"
            (fkfnb-ack first-row))))
    (defn qfnb-next-teach (row)
        (fkfne-cat (list
            "The prior family crossing is closed. Begin the next family.\n"
            (fkfnb-schedule-teach row)
            "\nAfter its frex observation, reply exactly:\n"
            (fkfnb-ack row))))

    ; loop result = tag session captures carrier-release-all
    (defn qfnb-loop-result (session captures carrier-release-all)
        (list "family-native-resident-live-loop-v1" session captures
              carrier-release-all))
    (defn qfnb-loop-session (r) (nth r 1))
    (defn qfnb-loop-captures (r) (nth r 2))
    (defn qfnb-loop-carriers-released? (r) (nth r 3))
    (defn qfnb-loop
        (opened session schedule residence-id captures carriers-released)
        (if (nil? schedule)
            (qfnb-loop-result session captures carriers-released)
            (do
                (let row (head schedule))
                ; Generation is complete before exactness can open Metal.
                (let generated (fcms-generate session 160))
                (let spoken (fcms-generation-session generated))
                (let raw (fcms-generation-text generated))
                (let binding (fkfnb-schedule-binding row))
                (let prep (fkfne-prepare binding raw))
                (let prepared (fkfne-preparation-valid? prep))
                (let executable (fkfne-carrier-executable-now?
                    (fkfne-binding-carrier binding)))
                (let live (if (and (eq prepared 1) (eq executable 1))
                    (frexl-execute-request (fkfne-prep-request prep)
                        (frexl-cursor-bytes (fkfne-prep-cursor prep)))
                    (nothing)))
                (let compact (if (nothing? live)
                    (frex-choice (fkfne-prep-request prep) (empty))
                    (frexl-result-as-frex (fkfne-prep-request prep) live)))
                (let typed (frex-render compact))
                (let observed (fcms-observe spoken typed))
                (let acknowledgement-generation (fcms-generate observed 128))
                (let acknowledged
                    (fcms-generation-session acknowledgement-generation))
                (let acknowledgement
                    (fcms-generation-text acknowledgement-generation))
                (let same-residence
                    (qfnb-same-residence? opened acknowledged))
                (let carrier-release (if (nothing? live) 0
                    (frexl-result-buffer-released? live)))
                (let capture (fkfnb-capture row raw prep compact typed
                    acknowledgement residence-id same-residence
                    carrier-release))
                (let captures-next (append captures (list capture)))
                (let carriers-next (if (and (eq carriers-released 1)
                                             (eq carrier-release 1)) 1 0))
                ; A rejected exact request, carrier signal, residence, or ack
                ; closes this attempt. No later family may borrow its place.
                (if (not (eq (fkfnb-capture-valid? capture) 1))
                    (qfnb-loop-result acknowledged captures-next carriers-next)
                (if (nil? (tail schedule))
                    (qfnb-loop-result acknowledged captures-next carriers-next)
                    (do
                        (let taught (fcms-observe acknowledged
                            (qfnb-next-teach (head (tail schedule)))))
                        (qfnb-loop opened taught (tail schedule) residence-id
                            captures-next carriers-next)))))))

    (defn qfnb-captures-all? (captures predicate)
        ; Predicates are named by an integer lens because Form functions are
        ; not passed as host callbacks in this body.
        (if (nil? captures) 1
            (do
                (let c (head captures))
                (let prep (fkfnb-capture-prep c))
                (let result (fkfnb-capture-result c))
                (let held
                    (if (eq predicate 1) (fkfnb-capture-valid? c)
                    (if (eq predicate 2) (fkfne-prep-exact? prep)
                    (if (eq predicate 3) (fkfne-prep-scannerless? prep)
                    (if (eq predicate 4) (fkfne-prep-model-requested? prep)
                    (if (eq predicate 5)
                        (frex-result-native-code-generated? result)
                    (if (eq predicate 6) (frex-result-executed? result)
                    (if (eq predicate 7)
                        (if (eq (frex-result-model-executed? result) 0) 1 0)
                    (if (eq predicate 8)
                        (fkfnb-capture-carrier-released? c)
                    (if (eq predicate 9)
                        (frxc-observation-valid? (fkfnb-capture-typed c))
                    (if (eq predicate 10)
                        (if (str_eq (fkfnb-capture-ack c)
                                    (fkfnb-ack
                                        (fkfnb-capture-schedule c))) 1 0)
                    (if (eq predicate 11)
                        (fkfnb-capture-same-residence? c) 0))))))))))))
                (if (eq held 1)
                    (qfnb-captures-all? (tail captures) predicate) 0))))
    (defn qfnb-print-rows (rows)
        (if (nil? rows) 0
            (do
                (let row (head rows))
                (let capture (fkfnb-row-capture row))
                (let schedule (fkfnb-capture-schedule capture))
                (let check (fkfnb-row-check row))
                (let result (fkfnb-capture-result capture))
                (qfnb-line "family" (fkfnb-schedule-family schedule))
                (qfnb-line "source-sha"
                    (fkfne-binding-source-sha
                        (fkfnb-schedule-binding schedule)))
                (qfnb-line "challenge-sha"
                    (fkfne-binding-challenge-sha
                        (fkfnb-schedule-binding schedule)))
                (qfnb-line "binding-sha"
                    (fkfne-binding-sha (fkfnb-schedule-binding schedule)))
                (qfnb-line "run-id" (fkfnb-schedule-run-id schedule))
                (qfnb-line "raw-model-request" (fkfnb-capture-raw capture))
                (qfnb-line "typed-frex" (fkfnb-capture-typed capture))
                (qfnb-line "held-ack" (fkfnb-capture-ack capture))
                (qfnb-line "value-kind" (fkfnb-result-signal-kind result))
                (qfnb-line "result-status" (frex-result-status result))
                (qfnb-line "carrier" (frex-result-carrier result))
                (qfnb-int "value-present"
                    (frex-result-value-present? result))
                (qfnb-int "value" (frex-result-value result))
                (qfnb-int "native-code-generated"
                    (frex-result-native-code-generated? result))
                (qfnb-int "carrier-executed"
                    (frex-result-executed? result))
                (qfnb-int "model-executed"
                    (frex-result-model-executed? result))
                (qfnb-int "carrier-release-ok"
                    (fkfnb-capture-carrier-released? capture))
                (qfnb-line "lifecycle"
                    (frex-trace-actions (frex-result-trace result)))
                (qfnb-line "receipt-sha"
                    (if (eq (fkfne-check-valid? check) 1)
                        (fkpfm-receipt-sha (fkfne-check-receipt check)) ""))
                (qfnb-print-rows (tail rows)))))

    (defn qfnb-run (selected-path)
        (do
            (let started (now_unix_ms))
            (let receipt-source-sha
                (nmfe-sha256 (read_file (qfnb-receipt-path))))
            (let batch-id (qfnb-batch-id started receipt-source-sha))
            (let residence-id (qfnb-residence-id batch-id started))
            (let schedule (fkfnb-build-schedule batch-id))
            (let opened (fcms-open selected-path
                (qfnb-prompt (head schedule)) 16384))
            (let open-ms (sub (now_unix_ms) started))
            (if (not (eq (fcms-live? opened) 1))
                (do
                    (qfnb-line "status" (fcms-status opened))
                    (qfnb-line "reason" (fcms-reason opened))
                    (qfnb-int "open-ms" open-ms)
                    (qfnb-int "open-count" 1)
                    (qfnb-int "remote-calls" 0)
                    (qfnb-int "context-release-ok"
                        (fcms-release-ok? opened))
                    0)
                (do
                    (let crossed (qfnb-loop opened opened schedule residence-id
                        (list) 1))
                    (let final-session (qfnb-loop-session crossed))
                    (let captures (qfnb-loop-captures crossed))
                    (let carriers-release
                        (qfnb-loop-carriers-released? crossed))
                    (let context-release (fcms-release-ok? final-session))
                    (let ledger (fkfnb-ledger batch-id (qfnb-model-id)
                        residence-id 1 0 context-release schedule captures))
                    (let ledger-valid (fkfnb-ledger-valid? ledger))
                    (let ended (now_unix_ms))
                    (qfnb-line "status"
                        (if (eq ledger-valid 1)
                            "current-family-native-resident-admitted"
                            "not-yet"))
                    (qfnb-line "batch-id" batch-id)
                    (qfnb-line "residence-id" residence-id)
                    (qfnb-line "receipt-source-sha" receipt-source-sha)
                    (qfnb-line "ledger-sha" (fkfnb-ledger-sha ledger))
                    (qfnb-int "open-ms" open-ms)
                    (qfnb-int "movement-ms" (sub ended (add started open-ms)))
                    (qfnb-int "family-count" (len schedule))
                    (qfnb-int "capture-count" (len captures))
                    (qfnb-int "row-count" (len (fkfnb-ledger-rows ledger)))
                    (qfnb-int "open-count" 1)
                    (qfnb-int "remote-calls" 0)
                    (qfnb-int "carrier-release-all" carriers-release)
                    (qfnb-int "context-release-ok" context-release)
                    (qfnb-int "ledger-valid" ledger-valid)
                    (qfnb-print-rows (fkfnb-ledger-rows ledger))
                    (sum (list
                        (qfnb-bit (eq (fkfnb-schedule-valid?
                            schedule batch-id) 1) 1)
                        (qfnb-bit (eq (fcms-resident? opened) 1) 2)
                        (qfnb-bit (eq (len captures)
                            (fkfnb-family-count)) 4)
                        (qfnb-bit (eq (qfnb-captures-all? captures 11) 1) 8)
                        (qfnb-bit (eq (qfnb-captures-all? captures 2) 1) 16)
                        (qfnb-bit (eq (qfnb-captures-all? captures 3) 1) 32)
                        (qfnb-bit (eq (qfnb-captures-all? captures 4) 1) 64)
                        (qfnb-bit (eq (qfnb-captures-all? captures 5) 1) 128)
                        (qfnb-bit (eq (qfnb-captures-all? captures 6) 1) 256)
                        (qfnb-bit (eq (qfnb-captures-all? captures 7) 1) 512)
                        (qfnb-bit (eq (qfnb-captures-all? captures 8) 1) 1024)
                        (qfnb-bit (eq (qfnb-captures-all? captures 9) 1) 2048)
                        (qfnb-bit (eq (qfnb-captures-all? captures 10) 1) 4096)
                        (qfnb-bit (eq context-release 1) 8192)
                        (qfnb-bit (eq ledger-valid 1) 16384)
                        (qfnb-bit (and (eq (fkfnb-ledger-open-count ledger) 1)
                            (eq (fkfnb-ledger-remote-calls ledger) 0))
                            32768)))))))

    (qfnb-run (qfnb-path)))
