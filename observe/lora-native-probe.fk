; lora-native-probe.fk — what the native dense lane is handed and what it says back.
; stdin line 1: the prompt (a literal \n in the text becomes a line break)
; stdin line 2: how many new ids to allow (blank -> 48)
; A probe, not a band: it opens the GPU.
; preflight-exec: forbidden
; preludes: form/form-stdlib/ear-tongue.fk
(do
    (defn p (k v) (print_str (str_concat k (str_concat "=" (str_concat v "\n")))))
    (defn t (x) (if (nothing? x) "" x))
    ; a literal backslash-n in the stdin line becomes a real line break
    (defn unesc (s i acc)
        (if (ge i (str_len s)) acc
            (if (and (eq (str_byte_at s i) 92) (and (lt (add i 1) (str_len s)) (eq (str_byte_at s (add i 1)) 110)))
                (unesc s (add i 2) (str_concat acc (byte_to_str 10)))
                (unesc s (add i 1) (str_concat acc (byte_to_str (str_byte_at s i)))))))
    (defn ids-say (xs acc) (if (eq (len xs) 0) acc (ids-say (tail xs) (str_concat acc (str_concat " " (int_to_str (head xs)))))))
    (let raw (t (read_line)))
    (let nraw (t (read_line)))
    (let maxnew (if (eq (str_len (trim nraw)) 0) 48 (str_to_int (trim nraw))))
    (let prompt (unesc raw 0 ""))
    (let lane (et-lane-open))
    (let ids (et-encode (nth lane 4) (nth lane 1) prompt))
    (p "prompt-len" (int_to_str (str_len prompt)))
    (p "prompt-ids-n" (int_to_str (len ids)))
    (p "prompt-ids" (ids-say ids ""))
    (p "round-trip" (str_concat "|" (str_concat (et-detok (nth lane 5) (nth lane 6) (nth lane 7) (tail ids) "") "|")))
    (let st (et-lane-st lane))
    (let first (et-prefill-from st ids 0))
    (let gen (et-gen-go st (nth lane 2) first (len ids) maxnew (list)))
    (p "gen-n" (int_to_str (len gen)))
    (p "gen-ids" (ids-say gen ""))
    (p "gen-text" (str_concat "|" (str_concat (et-detok (nth lane 5) (nth lane 6) (nth lane 7) gen "") "|")))
    0)
