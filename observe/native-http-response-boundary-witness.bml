// RFC 9112 7.1.1 / RFC 9110 8.6 grammar at the held response boundary.
// preludes: form/form-stdlib/bml/native-http-response.bml
section [form.bml] {
 class NativeHttpResponseBoundary {
  def nhrb-chunk(extension) = str_concat("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1",str_concat(extension,"\r\nx\r\n0;end=\"\"\r\n\r\n"));
  def nhrb-expect(name,wire,expected) {
   let response = nhr-parse(wire);
   if not(eq(nhr-good(response),expected)) then nhrb-refuse(name,response) else 1;
  }
  def nhrb-refuse(name,response) {
   print(list("HTTP boundary",name,response)); form_error("HTTP boundary observation differs");
  }
  def nhrb-extensions(rows,expected,count) = if nil?(rows) then count else nhrb-extension(head(rows),tail(rows),expected,count);
  def nhrb-extension(text,rest,expected,count) {
   nhrb-expect(text,nhrb-chunk(text),expected); nhrb-extensions(rest,expected,add(count,1));
  }
  def nhrb-prefixes(wire,at) = if eq(at,str_len(wire)) then at else nhrb-prefix(wire,at);
  def nhrb-prefix(wire,at) {
   nhrb-expect("incomplete prefix",substring(wire,0,at),0); nhrb-prefixes(wire,add(at,1));
  }
  def nhrb-run() {
   let valid = nhrb-extensions(list("",";name",";name=token"," ; name = token",";a=\"\"",";a=\"semi;comma,equals=\"",";a=\"escaped\\\"quote\"",";a=\"escaped\\\\slash\"","\t;\ta\t=\t\"x\";b",";a;b=c;d=\"y\""),1,0);
   let invalid = nhrb-extensions(list(";",";=bad",";a=",";a=\"unterminated",";a=\"x\"junk",";a=two words",";a = ",";a,,",";a=\"x\\",";a=\"bad\n\"",";a=\"x\" "," ",";a;"),0,0);
   nhrb-expect("204 length forbidden","HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n",0);
   nhrb-expect("204 transfer forbidden","HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n",0);
   nhrb-expect("204 ordinary","HTTP/1.1 204 No Content\r\n\r\n",1);
   nhrb-expect("304 decimal representation","HTTP/1.1 304 Not Modified\r\nContent-Length: 123\r\n\r\n",1);
   nhrb-expect("304 wide decimal unconverted","HTTP/1.1 304 Not Modified\r\nContent-Length: 18446744073709551716\r\n\r\n",1);
   nhrb-expect("304 malformed representation","HTTP/1.1 304 Not Modified\r\nContent-Length: x\r\n\r\n",0);
   nhrb-expect("304 empty representation","HTTP/1.1 304 Not Modified\r\nContent-Length: \r\n\r\n",0);
   nhrb-expect("304 double framing","HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n",0);
   nhrb-expect("304 no payload","HTTP/1.1 304 Not Modified\r\nContent-Length: 1\r\n\r\nx",0);
   let wire = nhrb-chunk(" ; a = \"q\\\";x\""); let prefixes = nhrb-prefixes(wire,0);
   print(list("valid-extensions",valid,"invalid-extensions",invalid,"bodyless-observations",9,"incomplete-prefixes",prefixes)); 1;
  }
 }
 nhrb-run();
}
