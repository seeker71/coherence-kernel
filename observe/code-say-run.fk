; code-say-run.fk — any code in, every code out. A symbol token, an NL
; phrase, a node id, a Persian, German, French, Portuguese, Romanian,
; Hebrew, Chinese or Japanese word resolves to its meaning(s); the door
; prints every code of each, the bytes each code costs against the NL
; phrase, the collisions the code carries, and publishes voice.codes.
; stdin line 1: the code.
; preflight-exec: forbidden
; preludes: form/form-stdlib/meaning-codes.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml
(do
    (defn cs-say (k v) (print_str (str_concat "code " (str_concat k (str_concat "=" (str_concat v "\n"))))))
    (defn cs-trim (s) (if (nothing? s) "" (trim s)))
    (defn cs-each (syms) (if (eq (len syms) 0) 0 (do (let codes (mc-codes (head syms))) (let short (mc-shortest codes (list))) (cs-say "meaning" (mc-cat (list (head syms) " | " (mc-line codes) "| nl-bytes=" (int_to_str (str_len (mc-nl (head syms)))) " shortest=" (head short) ":" (int_to_str (str_len (nth short 1))) " bytes"))) (cs-each (tail syms)))))
    (let code (cs-trim (read_line)))
    (let syms (mc-resolve-all code))
    (cs-say "query" code)
    (if (eq (len syms) 0) (cs-say "resolves" "nothing (offer a row)") (cs-say "resolves" (mc-join syms)))
    (let n (cs-each syms))
    (let epoch (now_unix_ms))
    (let published (if (eq (len syms) 0) (list "glass-publish-v1" "nothing") (fgtm-publish-snapshot (hearth-telemetry-root) "voice.codes" epoch (list (fgtm-sample (str_concat "code." (head syms)) (fgtm-absent) "meaning-code" "form" "voice.codes" "voice" (if (gt (len syms) 1) "collides" "unique") (fgtm-absent) (fgtm-present (str_len code)) "ready" (fgtm-absent) (fgtm-present epoch) (fgtm-absent) (fgtm-present (str_len (mc-nl (head syms)))) "never" "physical-live" "meaning-codes" (list "all" "we" "mesh" "voice"))))))
    (cs-say "glass" (nth published 1))
    0)
