// form-cli-grounded-synthesis-run.bml — the body grounds first, then spends
// the in-process model session first, else one
// provider turn when the caller allows it.
// stdin: {"enquiry":"...","terms":"a b c","seconds":600,"receipts":8,
//         "oracle":1,"model":"qwen38-q8","max_reply_tokens":1536,
//         "context":12288,"provider":{"allowed":1}}
// Omitted provider permission keeps this native-only. oracle is the legacy
// option name for local generation; it no longer contacts a model server.
// The authority is form-stdlib/bml/form-cli-grounded-synthesis.bml; this door
// only reads one request and prints one report.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml
section [form.bml] {
 print_str(json-emit-precise(fgs-answer(parse-json("grounded-synthesis-request", read_line()))));
 0;
}
