// form-cli-grounded-synthesis-run.bml — S1 asked with a request of the caller's own: the terms, the reply and the lanes named, and one report row per enquiry.
//
//   printf '%s\n' '{"enquiry":"...","terms":"a b c"}' | ./fkwu observe/form-cli-grounded-synthesis-run.bml
//
// stdin: one JSON line, the request of fgs-answer (form-stdlib/bml/form-cli-grounded-synthesis.bml, the authority): enquiry, terms, seconds,
// receipts, oracle (1/0: 0 grounds and asks no model), model, max_reply_tokens, reply_budget, context, provider {allowed}; omitted provider permission
// keeps it native-only. "movement" names the report row, default "S1 enquiry". An ordinary form-cli `ask` reaches the same fgs-answer with its terms and
// bound drawn from the enquiry (form-stdlib/form-cli.fk fc-session-ask).
// Prints the report, and appends the report row (fgs-report-row) to receipts/rent-ledger.jsonl.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-grounded-synthesis.bml;
section [form.bml] {
 class GroundedSynthesisRun {
  def gsr-run(request) {
   let report = fgs-answer(request);
   let kept = fgs-land(request, report);
   print_str(json-emit-precise(report));
  }
 }
 gsr-run(parse-json("grounded-synthesis-request", read_line()));
 0;
}
