// form-cli-grounded-synthesis-run.bml — S1's own door: the body grounds first, then the in-process model session, and one report row per enquiry.
//
//   printf '%s\n' '{"enquiry":"...","terms":"a b c"}' | ./fkwu observe/form-cli-grounded-synthesis-run.bml
//
// stdin: one JSON line, the request of fgs-answer (form-stdlib/bml/form-cli-grounded-synthesis.bml, the authority): enquiry, terms, seconds,
// receipts, oracle (1/0: 0 grounds and asks no model), model, max_reply_tokens, context, provider {allowed}; omitted provider permission keeps it
// native-only. "movement" names the report row, default "S1 enquiry". 115fea55e cut this door, which left S1 with no caller while the goal's
// pinned reading and E4 are read from it; ./fkwu observe/exit-proof-run.bml names what still stands between it and an ordinary form-cli enquiry.
// Prints the report, and appends the report row to receipts/rent-ledger.jsonl: door "S1", the enquiry (its receipts/artifacts path when it is
// the pinned one), source, rent_tokens, the receipts in the packet by count, and those the answer cites by a path that exists (apc-floor).
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-grounded-synthesis.bml;
import observe/answer-parity-check.fk;
section [form.bml] {
 class GroundedSynthesisRun {
  def gsr-ledger() = "receipts/rent-ledger.jsonl";
  def gsr-pinned() = "receipts/artifacts/2026-09-18-form-cli-enquiry.txt";
  def gsr-enquiry-name(enquiry) = (String) trim(read_file(gsr-pinned()) ?? "") == trim(enquiry) ? gsr-pinned() : enquiry;
  def gsr-sum(r, keys) = foldl((acc, k) => acc + fhn-count(r, k), 0, keys);
  def gsr-row(request, report, floor) = json-node-object([
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", json-object-has?(request, "movement") ? fhn-text(request, "movement") : "S1 enquiry"),
   fhn-s("door", "S1"),
   fhn-s("enquiry", gsr-enquiry-name(fhn-text(request, "enquiry"))),
   fhn-s("source", fhn-text(report, "source")),
   fhn-s("oracle", fhn-text(report, "oracle")),
   fhn-n("rent_tokens", gsr-sum(report, ["input_tokens", "cache_write_input_tokens", "cache_read_input_tokens", "output_tokens"])),
   fhn-n("oracle_tokens_evaluated", fhn-count(report, "oracle_tokens_evaluated")),
   fhn-n("oracle_tokens_predicted", fhn-count(report, "oracle_tokens_predicted")),
   fhn-s("oracle_model", fhn-text(report, "oracle_model")),
   fhn-n("receipts_in_packet", len(json-array-elements(json-object-get(report, "receipts")))),
   fhn-n("citation_keys_offered", len(json-array-elements(json-object-get(report, "receipts")))),
   fhn-n("packet_bytes", fhn-count(report, "packet_bytes")),
   fhn-n("answer_bytes", fhn-count(report, "answer_bytes")),
   fhn-n("answer_axes", floor[0]),
   fhn-n("answer_receipts_cited", floor[1]),
   fhn-n("answer_receipts_existing", floor[2]),
   fhn-n("answer_limits", floor[3]),
   fhn-n("grounding_ms", fhn-count(report, "grounding_ms")),
   fhn-n("oracle_ms", fhn-count(report, "oracle_ms")),
   fhn-n("provider_ms", fhn-count(report, "provider_ms")),
   fhn-s("answer", fhn-text(report, "answer")),
   fhn-s("evidence", fhn-text(report, "evidence"))]);
  def gsr-run(request) {
   let report = fgs-answer(request);
   let answer = read_file(fhn-text(report, "answer")) ?? "";
   let kept = fhn-append(gsr-ledger(), json-emit(gsr-row(request, report, apc-floor(answer))) ++ "\n");
   print_str(json-emit-precise(report));
  }
 }
 gsr-run(parse-json("grounded-synthesis-request", read_line()));
 0;
}
