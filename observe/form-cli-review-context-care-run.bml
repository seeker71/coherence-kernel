// Supply caller-selected source context through the organ care mechanism.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-review-context-care.bml form-stdlib/bml/form-cli-heal-native-io.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 let input = read_line();
 if or(nothing?(input),not(jwa-valid(input))) then form_error("review context care requires one JSON request line") else 0;
 frcc-request(fhn-root(),parse-json("review-context-care-request",input));
}
