// Attributed corpus publication from complete held local sources.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/concept-human-reindex.bml
section [form.bml] {
 class ConceptHumanReindexRun {
  def chrr-request(text) {
   if not(jwa-valid(text)) then csa-input-refused("complete corpus reindex JSON required") else 0;
   let request = parse-json("concept-human-reindex-request",text);
   if not(node_eq(node_category(request),JSON-OBJECT())) then csa-input-refused("corpus reindex object required") else 0;
   if not(csa-request-fields(json-object-pairs(request),list())) then csa-input-refused("unique root/hash string fields required") else 0;
   chr-run(if json-object-has?(request,"root") then json-string-value(json-object-get(request,"root")) else ".",if json-object-has?(request,"hash") then json-string-value(json-object-get(request,"hash")) else "form-sha256");
  }
  def chrr-home() {
   let text = read_line();
   if or(nothing?(text),str_eq(text,"")) then chr-run(".","form-sha256") else chrr-request(text);
  }
 }
 chrr-home();
}
