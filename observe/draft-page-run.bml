// draft-page-run.bml — the body's drafts laid out on one page for our reading.
//
// Reads receipts/draft-ledger.jsonl (a draft is an id whose rows carry a path; a redraft is the same draft at its
// latest row; its reading is the latest row naming it), reads each draft's own file, and fills
// docs/draft-reading.template.html at its /*DATA*/ mark into the hearth, beside the drafts: drafts/index.html under
// hearth-home(), its directory made with its parents. The line names the page only when the write's answer says the
// whole page landed; otherwise it says what the write answered and that nothing was drawn. The page records nothing: its
// marks become lines "<id> accepted|revised|rejected [note]" that observe/draft-reading-run.bml records.
// preflight-exec: forbidden
// preludes: form-stdlib/hearth.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftPage {
  def dp-ledger() = "receipts/draft-ledger.jsonl";
  def dp-template() = "docs/draft-reading.template.html";
  def dp-dir() = hearth-home() + "/drafts";
  def dp-out() = dp-dir() + "/index.html";
  def dp-nonempty(xs) = nil?(xs) ? [] : (Comparable) len(trim(xs[0])) == 0 ? dp-nonempty(xs[1:]) : cons(xs[0], dp-nonempty(xs[1:]));
  def dp-parse(xs) = xs |> map(x => parse-json("draft-row", x));
  def dp-rows() = file_size(dp-ledger()) < 1 ? [] : dp-parse(dp-nonempty(split-on(fhn-read(dp-ledger()), "\n")));
  def dp-later(id, rows) = nil?(rows) ? 0 : ((String) fhn-text(rows[0], "draft") == id) && (len(fhn-text(rows[0], "path")) > 0) ? 1 : dp-later(id, rows[1:]);
  def dp-reading(id, rows, acc) = nil?(rows) ? acc : dp-reading(id, rows[1:], (String) fhn-text(rows[0], "draft") == id ? fhn-text(rows[0], "reading") : acc);
  def dp-join(parts, sep) = nil?(parts) ? "" : nil?(parts[1:]) ? parts[0] : parts[0] ++ sep ++ dp-join(parts[1:], sep);
  def dp-swap(s, needle, replacement) = dp-join(split-on(s, needle), replacement);
  def dp-text(path) = file_size(path) > 0 ? fhn-read(path) : "";
  def dp-item(row, all) = json-node-object([fhn-s("id", fhn-text(row, "draft")), fhn-s("reading", dp-reading(fhn-text(row, "draft"), all, "")), fhn-s("voice", fhn-text(row, "voice")), fhn-n("packet", fhn-count(row, "packet")), fhn-s("text", dp-text(fhn-text(row, "path")))]);
  def dp-current?(row, rest) = (len(fhn-text(row, "path")) > 0) && ((Comparable) dp-later(fhn-text(row, "draft"), rest) == 0);
  def dp-items(rows, all) = nil?(rows) ? [] : dp-current?(rows[0], rows[1:]) ? cons(dp-item(rows[0], all), dp-items(rows[1:], all)) : dp-items(rows[1:], all);
  // the write's answer read: the byte count when the whole page landed, -1 when the path does not open, fewer when it fell short
  def dp-landed(wrote, page) = (Comparable) wrote == len(page) ? " -> " ++ dp-out() : " (the page did not land at " ++ dp-out() ++ ": the write answered " ++ wrote.str() ++ " of " ++ len(page).str() ++ " bytes; nothing drawn)";
  def dp-draw(page) {
   let made = hch-mkdirs(dp-dir());
   dp-landed(write_file_text(dp-out(), page), page);
  }
  def dp-run() {
   let all = dp-rows();
   let items = dp-items(all, all);
   let data = dp-swap(json-emit(json-node-array(items)), "</", "<\\/");
   let template = file_size(dp-template()) > 0 ? fhn-read(dp-template()) : "";
   let marked = str_find(template, "/*DATA*/", 0) >= 0;
   let line = "[draft-page] " ++ len(items).str() ++ " drafts" ++ (marked ? dp-draw(dp-swap(template, "/*DATA*/", data)) : " (template absent or unmarked; nothing drawn)");
   let said = print_str(line ++ "\n");
   line;
  }
 }
 dp-run();
}
