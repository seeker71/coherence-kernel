// draft-page-run.bml — the body's drafts laid out on one page for our reading.
//
// Reads receipts/draft-ledger.jsonl (a draft is an id whose rows carry a path; a redraft is the same draft at its
// latest row; its reading is the latest row naming it), reads each draft's own file, and fills
// docs/draft-reading.template.html at its /*DATA*/ mark into the main checkout's hearth, beside the drafts:
// /Users/ursmuff/source/coherence-kernel/.hearth/drafts/index.html. The page records nothing: its marks become
// lines "<id> accepted|revised|rejected [note]" that observe/draft-reading-run.bml records.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftPage {
  def dp-ledger() = "receipts/draft-ledger.jsonl";
  def dp-template() = "docs/draft-reading.template.html";
  def dp-out() = "/Users/ursmuff/source/coherence-kernel/.hearth/drafts/index.html";
  def dp-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def dp-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def dp-nonempty(xs) = if nil?(xs) then list() else if eq(str_len(trim(head(xs))), 0) then dp-nonempty(tail(xs)) else cons(head(xs), dp-nonempty(tail(xs)));
  def dp-parse(xs) = if nil?(xs) then list() else cons(parse-json("draft-row", head(xs)), dp-parse(tail(xs)));
  def dp-rows() = if lt(file_size(dp-ledger()), 1) then list() else dp-parse(dp-nonempty(split-on(fhn-read(dp-ledger()), "\n")));
  def dp-later(id, rows) = if nil?(rows) then 0 else if and(str_eq(dp-str(head(rows), "draft"), id), gt(str_len(dp-str(head(rows), "path")), 0)) then 1 else dp-later(id, tail(rows));
  def dp-reading(id, rows, acc) = if nil?(rows) then acc else dp-reading(id, tail(rows), if str_eq(dp-str(head(rows), "draft"), id) then dp-str(head(rows), "reading") else acc);
  def dp-join(parts, sep) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else str_concat(head(parts), str_concat(sep, dp-join(tail(parts), sep)));
  def dp-swap(s, needle, replacement) = dp-join(split-on(s, needle), replacement);
  def dp-text(path) = if gt(file_size(path), 0) then fhn-read(path) else "";
  def dp-item(row, all) = json-node-object(list(fhn-s("id", dp-str(row, "draft")), fhn-s("reading", dp-reading(dp-str(row, "draft"), all, "")), fhn-s("voice", dp-str(row, "voice")), fhn-n("packet", dp-int(row, "packet")), fhn-s("text", dp-text(dp-str(row, "path")))));
  def dp-current?(row, rest) = and(gt(str_len(dp-str(row, "path")), 0), eq(dp-later(dp-str(row, "draft"), rest), 0));
  def dp-items(rows, all) = if nil?(rows) then list() else if dp-current?(head(rows), tail(rows)) then cons(dp-item(head(rows), all), dp-items(tail(rows), all)) else dp-items(tail(rows), all);
  def dp-run() {
   let all = dp-rows();
   let items = dp-items(all, all);
   let data = dp-swap(json-emit(json-node-array(items)), "</", "<\\/");
   let template = if gt(file_size(dp-template()), 0) then fhn-read(dp-template()) else "";
   let marked = ge(str_find(template, "/*DATA*/", 0), 0);
   let wrote = if marked then write_file_text(dp-out(), dp-swap(template, "/*DATA*/", data)) else 0;
   print_str(mc-cat(list("[draft-page] ", int_to_str(len(items)), " drafts", if marked then str_concat(" -> ", dp-out()) else " (template absent or unmarked; nothing drawn)", "\n")));
  }
 }
 dp-run();
}
