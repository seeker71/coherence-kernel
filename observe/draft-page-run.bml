// draft-page-run.bml — the body's drafts laid out on one page for our reading.
//
// Reads receipts/draft-ledger.jsonl (a draft is an id whose rows carry a path; a redraft is the same draft at its
// latest row; its reading is the latest row naming it), reads each draft's own file, and fills
// docs/draft-reading.template.html at its /*DATA*/ mark into the main checkout's hearth, beside the drafts:
// /Users/ursmuff/source/coherence-kernel/.hearth/drafts/index.html. The page records nothing: its marks become
// lines "<id> accepted|revised|rejected [note]" that observe/draft-reading-run.bml records.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class DraftPage {
  def dp-ledger() = "receipts/draft-ledger.jsonl";
  def dp-template() = "docs/draft-reading.template.html";
  def dp-out() = "/Users/ursmuff/source/coherence-kernel/.hearth/drafts/index.html";
  def dp-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def dp-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def dp-nonempty(xs) = nil?(xs) ? list() : (Comparable) str_len(trim(head(xs))) == 0 ? dp-nonempty(tail(xs)) : cons(head(xs), dp-nonempty(tail(xs)));
  def dp-parse(xs) = xs |> map(x => parse-json("draft-row", x));
  def dp-rows() = file_size(dp-ledger()) < 1 ? list() : dp-parse(dp-nonempty(split-on(fhn-read(dp-ledger()), "\n")));
  def dp-later(id, rows) = nil?(rows) ? 0 : ((String) dp-str(head(rows), "draft") == id) && (str_len(dp-str(head(rows), "path")) > 0) ? 1 : dp-later(id, tail(rows));
  def dp-reading(id, rows, acc) = nil?(rows) ? acc : dp-reading(id, tail(rows), (String) dp-str(head(rows), "draft") == id ? dp-str(head(rows), "reading") : acc);
  def dp-join(parts, sep) = nil?(parts) ? "" : nil?(tail(parts)) ? head(parts) : head(parts) ++ sep ++ dp-join(tail(parts), sep);
  def dp-swap(s, needle, replacement) = dp-join(split-on(s, needle), replacement);
  def dp-text(path) = file_size(path) > 0 ? fhn-read(path) : "";
  def dp-item(row, all) = json-node-object(list(fhn-s("id", dp-str(row, "draft")), fhn-s("reading", dp-reading(dp-str(row, "draft"), all, "")), fhn-s("voice", dp-str(row, "voice")), fhn-n("packet", dp-int(row, "packet")), fhn-s("text", dp-text(dp-str(row, "path")))));
  def dp-current?(row, rest) = (str_len(dp-str(row, "path")) > 0) && ((Comparable) dp-later(dp-str(row, "draft"), rest) == 0);
  def dp-items(rows, all) = nil?(rows) ? list() : dp-current?(head(rows), tail(rows)) ? cons(dp-item(head(rows), all), dp-items(tail(rows), all)) : dp-items(tail(rows), all);
  def dp-run() {
   let all = dp-rows();
   let items = dp-items(all, all);
   let data = dp-swap(json-emit(json-node-array(items)), "</", "<\\/");
   let template = file_size(dp-template()) > 0 ? fhn-read(dp-template()) : "";
   let marked = str_find(template, "/*DATA*/", 0) >= 0;
   let wrote = marked ? write_file_text(dp-out(), dp-swap(template, "/*DATA*/", data)) : 0;
   print_str("[draft-page] " ++ int_to_str(len(items)) ++ " drafts" ++ (marked ? " -> " ++ dp-out() : " (template absent or unmarked; nothing drawn)") ++ "\n");
  }
 }
 dp-run();
}
