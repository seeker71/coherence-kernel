// The Glass fleet supervisor, admitted by observe/form-glass-run.fk after its
// prelude-free checkout bootstrap. The public door preserves the viewing TTY.
// preflight-exec: forbidden
//
// It wakes the ear unless someone chose otherwise (fgr-ear-wake: .hearth/ear.slept
// is that choice, written by the glass's z key), lowers its own priority, stands the
// three frame processes beside the glass
// (observe/form-glass-sensors-live.fk at its slow cadences, observe/form-glass-
// machine-live.fk every 50 ms, observe/form-glass-organs-live.fk every 500 ms),
// and runs the glass in a loop: staged startup,
// launch admission, governor refresh, the live loop; when the live loop ends
// the supervisor decides (fglu-supervisor-restart?, the door form-glass-launch.bml
// carries) -- 0 abstains and
// ends the carrier, 1 rebirths after 250 ms. Every child is an argv spawned by
// the kernel itself; no shell reads any of it, and the frame processes are
// quiet so the terminal stays the glass's own. Ending the carrier ends all three.
//
// Every end of this carrier speaks: the readings go to .hearth/organ-health.jsonl,
// which outlives the terminal the glass was watched in, so a body that lost its
// glass hears about it instead of reading a state file that still says running.
//
import form/form-stdlib/form-glass-launch.bml;
import form/form-stdlib/organ-health.bml;
import form/form-stdlib/bml/form-core-care.bml;
section [form.bml] {
    def fgr-health-spool() = ".hearth/organ-health.jsonl";
    // The reading is spoken and kept: oh-voice answers its own printing, never the
    // row, so the row is held first and both doors are given the same one.
    def fgr-say(aspect, expected, observed, health, needs, offers) = {
        let row = oh-reading("glass", "glass-supervisor", aspect, json-node-string(expected), json-node-string(observed), json-node-int(health), needs, offers, oh-reference((HearthDir() + "/form-glass-supervisor.state")));
        let said = oh-voice(row);
        oh-emit(fgr-health-spool(), row);
    };
    def fgr-ended(word, aspect, observed, health, needs, offers) = {
        let marked = fglu-supervisor-mark(word);
        fgr-say(aspect, "standing", observed, health, needs, offers);
    };
    def fgr-run(args) = {
        let pid = host_spawn(args);
        pid > 0 ? host_wait(pid) : -1;
    };
    def fgr-step(args) = (Comparable) fgr-run(args) == 0;
    // Governor observation belongs to the sensor owner. A missing optional
    // reading must remain visible inside Glass rather than end every sensor.
    def fgr-admitted() {
        let owner = ohc-open();
        let view = occ-view-request-at(owner,json-node-object([json-node-pair("sources",json-node-array([json-node-string(fgr-health-spool())]))]));
        let prior = filter(row => (String) jv-str(row,"organ") == "glass" && (String) jv-str(row,"flow") == "glass-supervisor" && (String) jv-str(row,"aspect") == "admission",jv-items(jv-get(view,"signals")));
        ohc-close(owner);
        let fresh = oh-reading("glass","glass-supervisor","admission",json-node-string("admitted"),json-node-string("admitted"),json-node-int(1),[],[],oh-reference("observe/form-glass-launch-run.fk"));
        let row = nil?(prior) || !ohv-pain(prior[0]) ? fresh : oh-set(oh-set(oh-set(fresh,"care_of",json-node-string(jv-str(prior[0],"id"))),"responder",json-node-string("glass-supervisor")),"care_delivery",json-node-object([oh-s("admission","staged-startup-and-launch")]));
        oh-voice(row);
        oh-emit(fgr-health-spool(),row);
        1;
    };
    def fgr-admit() = (Comparable) fgr-step(["./fkwu", "observe/form-glass-staged-startup-run.fk"]) == 0 ? 0 : (Comparable) fgr-step(["./fkwu", "form/form-stdlib/form-glass-launch.bml"]) == 0 ? 0 : (Comparable) fgr-step(["./fkwu", "observe/form-glass-launch-run.fk"]) == 0 ? 0 : fgr-admitted();
    // A body that hears is the default. The ear sensor stands its mic while .hearth/ear.wanted is
    // present, so the carrier writes that marker at birth -- unless .hearth/ear.slept stands, which
    // is the mark a hand at the glass leaves when it presses z. A choice to be unheard persists
    // across every rebirth, every login and every self-molt; the absence of that choice does not
    // mean silence, it means nobody has asked for it.
    def fgr-ear-wake() = {
        let mk = fs-mkdir(".hearth");
        file_size(".hearth/ear.slept") >= 0 ? 0 : file_size(".hearth/ear.wanted") >= 0 ? 1 : write_file_text(".hearth/ear.wanted", "en pt fa id") >= 0 ? 1 : 0;
    };
    def fgr-stop(pid) = pid > 0 ? {
        host_kill(pid);
        host_wait(pid);
    } : -1;
    def fgr-end(sensors, machine, organs, ear) = {
        fgr-stop(sensors);
        fgr-stop(machine);
        fgr-stop(organs);
        fgr-stop(ear);
        0;
    };
    def fgr-loop(sensors, machine, organs, ear, admitted) = (Comparable) (admitted ? 1 : fgr-admit()) == 0 ? {
        fgr-end(sensors, machine, organs, ear);
        fgr-ended("ended", "admission", "refused", 0, [oh-need("glass-admission", json-node-string("staged-startup, launch"))], ["repair-the-reported-unit", "restart-the-glass"]);
        form_error("Glass admission failed; owned sensors released; repair the reported unit before relaunch");
    } : {
        let identity = fglu-dependency-manifest();
        let lived = fgr-run(["./fkwu", "observe/form-glass-live-run.fk"]);
        !((Comparable) lived == 0) ? {
            fgr-end(sensors, machine, organs, ear);
            print(["glass-supervisor", "live-exit", lived]);
            fgr-ended("ended", "live-runner", "exited", 0, [oh-need("glass-live-runner", json-node-int(lived))], ["restart-the-glass", "inspect-the-reported-unit", "abstain"]);
            form_error("Glass live runner failed; owned sensors released");
        } : (Comparable) fglu-supervisor-restart?() == 0 ? {
            fgr-end(sensors, machine, organs, ear);
            fgr-ended("ended", "carrier", "ended", 1, [], ["restart-the-glass"]);
        } : {
            host_sleep_ms(250);
            (String) identity == fglu-dependency-manifest() ? fgr-loop(sensors, machine, organs, ear, 1) : {
                fgr-end(sensors, machine, organs, ear);
                fgr-begin();
            };
        };
    };
    def fgr-begin() = {
        let platform = fglu-carrier-care();
        let sensors = host_spawn_quiet(["./fkwu", "observe/form-glass-sensors-live.fk"]);
        let machine = host_spawn_quiet(["./fkwu", "observe/form-glass-machine-live.fk"]);
        let organs = host_spawn_quiet(["./fkwu", "observe/form-glass-organs-live.fk"]);
        let ear = host_spawn_quiet(["./fkwu", "observe/form-glass-ear-live.fk"]);
        sensors > 0 && (machine > 0 && (organs > 0 && ear > 0)) ? fgr-loop(sensors, machine, organs, ear, 0) : {
            print("Glass sensor spawn refused; retrying");
            fgr-end(sensors, machine, organs, ear);
            host_sleep_ms(1000);
            fgr-begin();
        };
    };
    let entry = cell_path();
    (String) entry == "observe/form-glass-supervisor-run.fk" || (String) entry == host_cwd() + "/observe/form-glass-supervisor-run.fk" ? {
        let niced = host_nice(19);
        let hearing = fgr-ear-wake();
        fgr-begin();
    } : 0;
}
