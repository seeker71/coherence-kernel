; form-glass-atlas-current-run.fk — render one physical Glass frame without
; starting another resident dashboard process.
;
; The door uses the same collectors, telemetry inventory, control ack, history
; point, row budget, and terminal projection as the live loop. It is for
; bounded diagnostics and receipts; it does not claim temporal motion from its
; one-point history.
;
; preludes: form/form-stdlib/form-glass-live.bml

(do
    (let epoch (now_unix_ms))
    (let frameNumber 0)
    (let hostRows (fgl-host-rows frameNumber (list)))
    (let queueRows (fgl-queue-rows frameNumber (list)))
    (let storageRows (fgl-storage-rows frameNumber (list)))
    (let heatRows (fgl-heat-rows frameNumber (list)))
    (let fastRows (fgl-fast-rows frameNumber (list) heatRows))
    (let metrics (append fastRows (append hostRows
        (append queueRows storageRows))))
    (let governorRefresh (fgl-refresh-governor frameNumber))
    (let inventory (fgtm-inventory (FGLRoot)))
    (let externalSamples (fgl-external-samples
        (fgl-inventory-samples-at inventory epoch)))
    (let samples (fgl-local-samples externalSamples epoch))
    (let publishers (fgl-external-publishers
        (fgl-inventory-publishers inventory)))
    (let observations (fgl-v2-observations epoch frameNumber))
    (let point (fgl-flow-point-current-full epoch metrics observations samples))
    (let history (list point))
    (let control (fgl-control-start-state
        (fgtm-read-control-ack (FGLRoot) (FGLControlChannel))))
    (let frame (fgl-dashboard-frame 80 24 epoch (FGLQuietHz) frameNumber
        control metrics samples publishers history observations))
    (print_str (fgd-segment-project frame))
    0)
