// preflight-exec: forbidden
// Two live Q4 output tokens compared with the ordinary forward path.
// preludes: form-stdlib/bml/form-cli-heal-flow.bml
section [form.bml] {
 class HealFlowLive {
  def fhfl-run(partial) {
   let model = "qwen38-q4";
   let path = mr-path(mr-find(model));
   let seal = qaf-seal-verdict(path);
   let x = qsx-load(path);
   let ctx = qsx-open-span(path, 8, x, 4);
   let a = q38-new-state(nth(ctx, 2));
   let b = q38-new-state(nth(ctx, 2));
   let src = nth(ctx, 7);
   let ids = take(4, qsx-chat-ids(src, "check", x));
   let first = q38-prefill-span-sliced(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), a, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), ids, 0, 4);
   let other = q38-prefill-span-sliced(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), b, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), ids, 0, 4);
   let next = fhf-next(ctx, a, list(), head(first), 4);
   let expected = tkz-decode-text(src, list(head(first), next));
   let fresh = write_file(partial, "");
   let streamed = fhf-walk(ctx, b, src, list(), "", model, path, partial, head(other), 4, 4, 0, list(), 6);
   let same = str_eq(read_file(partial), expected);
   let freed = q38-free-state(b);
   let wanted = q38-close-expected(ctx, a);
   let closed = q38-close(ctx, a);
   print(list("flow-live", "output-tokens", nth(streamed, 1), "stream-bytes", file_size(partial), "byte-parity", same, "stop", head(streamed), "released", eq(wanted, closed)));
   add(if eq(seal, 1) then 1 else 0, add(if eq(nth(streamed, 1), 2) then 2 else 0, add(if same then 4 else 0, add(if str_eq(head(streamed), "context-capacity") then 8 else 0, if and(eq(wanted, closed), gt(freed, 0)) then 16 else 0))));
  }
 }
 0;
}
