// A short question the body already holds, through the grounded door,
// with the provider closed. The model is not admitted.
import form-stdlib/bml/form-cli-grounded-synthesis.bml;
section [form.bml] {
 def gsr-request() = json-node-object([json-node-pair("enquiry", json-node-string("What does a check below its pin mean?")), json-node-pair("terms", json-node-string("check pin miss")), json-node-pair("receipts", json-node-int(4))]);
 def gsr-run() = {
  let report = fgs-answer(gsr-request());
  print_str(json-string-value(json-object-get(report, "source")));
  print_str(json-int-value(json-object-get(report, "rent_tokens")).str());
  print_str(json-string-value(json-object-get(report, "oracle")));
  print_str(read_file(json-string-value(json-object-get(report, "answer"))) ?? "");
  0;
 };
 gsr-run();
}
