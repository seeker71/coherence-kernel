; voice-tensor-table.fk — every initializer of a voice, one to a line, read by the body.
; Point it with /tmp/voice-onnx-target, or take the default.
; preflight-exec: allowed
; preludes: form/form-stdlib/voice-native.bml
(do
    (defn vt-default () "en_GB-jenny_dioco-medium")
    (defn vt-voice ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vt-default) (if (eq (str_len (trim t)) 0) (vt-default) (trim t)))))
    (let p (vp-model-path (vt-voice)))
    (print (vo-rows-text (vo-inits p)))
    0)
