; session-neutral-discourse-growth-live.fk — a real-time recorded clause,
; sentence, and paragraph growth witness.
; witnessed: 2026-08-24 -> seeds 869287278 and 869291042, 64 edges / 6 receipts each
; preludes: cognition/session-neutral-discourse-growth.fk

(do
  (defn sndgl-proposal-rows (proposals)
    (if (eq (len proposals) 0) (empty)
      (cons (list (sndg-p-draw (head proposals))
              (sndg-clause-role-row (sndg-p-clause (head proposals)))
              (sndg-p-vector (head proposals)))
        (sndgl-proposal-rows (tail proposals)))))
  (defn sndgl-print-round (ordinal round)
    (do
      (print "\nclause-round=") (print (int_to_str ordinal))
      (print " proposals=[draw roles(subject mode relation object context) guidance(surprise coherence trust sovereignty vitality flow)]=")
      (print (sndgl-proposal-rows (sndg-r-proposals round)))
      (print " pareto-frontier=")
      (print (sndgl-proposal-rows (sndg-r-frontier round)))
      (print " selector=") (print (int_to_str (sndg-r-selector round)))
      (print " selected-roles=") (print (sndg-r-clause-roles round))
      (print " selected-guidance=")
      (print (sndg-p-vector (sndg-r-selected round)))))
  (defn sndgl-print-rounds (rounds ordinal)
    (if (eq (len rounds) 0) 0
      (do
        (sndgl-print-round ordinal (head rounds))
        (sndgl-print-rounds (tail rounds) (add ordinal 1)))))
  (defn sndgl-print-realizations (realizations)
    (if (eq (len realizations) 0) 0
      (do
        (print "\nlocale=") (print (sndg-gr-locale (head realizations)))
        (print " state=") (print (sndg-gr-state (head realizations)))
        (print "\n") (print (sndg-gr-surface (head realizations)))
        (sndgl-print-realizations (tail realizations)))))

  (let seed (snmt-positive
    (bxor (now_unix_ms) (add (kernel_stat 0) (kernel_stat 6)))))
  (let growth (sndg-grow seed))
  (let opened (snmt-open))
  (let runtime (snmt-o-runtime opened))
  (let dictionary (snmt-o-dictionary opened))
  (let paragraph (sndg-w-paragraph growth))
  (let realizations (sndg-realize-paragraphs runtime dictionary paragraph
    (list "en" "de" "zh" "fr" "ban" "sa")))
  (let graph (sndg-graph growth realizations))
  (print "session-neutral-discourse-growth")
  (print "\nvariation-lane=arrival-seeded-pseudo-random-recorded")
  (print "\nseed=") (print (int_to_str seed))
  (sndgl-print-rounds (sndg-w-rounds growth) 1)
  (print "\nparagraph-theme=")
  (print (list (nth (sndg-g-theme paragraph) 2)
    (fwf-surface (fwf-at (nth (sndg-g-theme paragraph) 2)))))
  (print " perspective-mode=") (print (nth (sndg-g-perspective paragraph) 2))
  (print " sentence-relations=")
  (print (list (sndg-s-relations (head (sndg-g-sentences paragraph)))
    (sndg-s-relations (nth (sndg-g-sentences paragraph) 1))))
  (print " paragraph-relations=") (print (sndg-g-relations paragraph))
  (sndgl-print-realizations realizations)
  (print "\nreversible-graph-edges=") (print (int_to_str (len graph)))
  (print " locale-surface-receipts=")
  (print (sndg-surface-receipts graph realizations))
  (print "\n")
  0)
