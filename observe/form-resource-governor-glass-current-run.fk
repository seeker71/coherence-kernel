// form-resource-governor-glass-current-run.fk — refresh honest governor telemetry.
//
// This is the bounded production publisher used by Glass.  It does not run
// the atomic-slot fixture from the governor proof runner.  Inputs the carrier
// cannot currently expose stay typed unavailable and therefore fail closed.
// System memory headroom is sampled physically on every invocation; it is not
// promoted to Metal working-set bytes or model residency.
//
import form-stdlib/core.fk;
import form-stdlib/bml/form-glass-observation-v2.bml;
import form-stdlib/form-glass-observer.bml;
import form-stdlib/form-resource-governor.bml;
import form-stdlib/form-resource-host-pressure.bml;
import form-stdlib/form-glass-telemetry-membrane.bml;
import form-stdlib/form-resource-governor-glass.bml;
import form-stdlib/hearth.bml;
section [form.bml] {
    def frggcr-self-pid() = host_pid();
    def frggcr-self-current?(pid) = pid <= 0 ? 0 : len(fgo-process-read(pid)) > 0 ? 1 : 0;
    def frggcr-process-start-seconds(pid) = {
        let process = fgo-process-read(pid);
        (Comparable) len(process) == 0 ? nothing() : nothing?(fgo-ps-elapsed(process)) ? nothing() : now_unix_ms() / 1000 - fgo-ps-elapsed(process);
    };
    def frggcr-provenance(pid, startedSeconds, epoch, current) = !((Comparable) current == 1) || (nothing?(startedSeconds) || startedSeconds <= 0) ? fgov2-provenance("declared", "resource.governor", fgov2-unavailable("current-process-start-not-correlated", "process.current-lifetime"), fgov2-measured(kernel_stat(0)), fgov2-measured(epoch), "mach.host_statistics64") : fgov2-provenance("physical-live", ("resource.governor.p" + (pid.str() + (".s" + startedSeconds.str()))), fgov2-measured(fgov2-process-lifetime(pid, startedSeconds * 1000, ("os-p" + (pid.str() + ("-s" + startedSeconds.str()))))), fgov2-measured(kernel_stat(0)), fgov2-measured(epoch), "mach.host_statistics64+metal_live:current-process-only");
    def frggcr-unavailable(reason, door) = frg-unavailable(reason, door);
    def frggcr-resource(name, capacity-door, foreground-door, reserve-door) = frg-resource(name, frggcr-unavailable("capacity-not-exposed", capacity-door), frggcr-unavailable("foreground-demand-not-exposed", foreground-door), frggcr-unavailable("reserve-not-exposed", reserve-door));
    let epoch = now_unix_ms();
    let pid = frggcr-self-pid();
    let started-seconds = frggcr-process-start-seconds(pid);
    let provenance = frggcr-provenance(pid, started-seconds, epoch, frggcr-self-current?(pid));
    let vm = host_vm_stat();
    let headroom-policy = frghp-default-policy();
    let pressure = frghp-pressure-from-vm(headroom-policy, vm, 0, provenance);
    let total-memory = frghp-total-bytes-from-vm(vm, 0, provenance);
    let status = metal_live();
    let sample = frg-sample(frggcr-unavailable("request-queue-not-correlated", "hearth.queue.current"), frggcr-resource("cpu", "host.cpu.capacity", "host.cpu.foreground", "host.cpu.reserve"), frggcr-resource("gpu", "metal.capacity", "metal.foreground", "metal.reserve"), frg-resource("memory", total-memory, frggcr-unavailable("foreground-demand-not-exposed", "host.memory.foreground"), frggcr-unavailable("reserve-not-exposed", "host.memory.reserve")), frggcr-unavailable("foreground-presence-not-exposed", "host.foreground-presence"), frggcr-unavailable("foreground-latency-not-exposed", "host.foreground-latency"), pressure, frggcr-unavailable("thermal-state-not-exposed", "host.thermal-state"), frggcr-unavailable("low-power-state-not-exposed", "host.low-power-state"), frg-signal(fgov2-metal-in-flight-truth(status), 0, provenance));
    let policy = frg-default-policy();
    let decision = frg-tick(policy, frg-initial-state(), sample);
    let release-plan = frg-pressure-release-plan(policy, frg-pressure(sample), frggcr-unavailable("required-bytes-not-requested", "governor.reclaim-request"), []);
    let slot-observation = frg-metal-slot-observation("unobserved", "production-publisher-does-not-probe-fixture-slot", frg-metal-slot-path(), "");
    let frame = frgg-project(policy, sample, decision, [], [], [], release-plan, slot-observation, epoch);
    let published = frgg-publish(hearth-telemetry-root(), epoch, frame);
    len(published) > 1 && (String) published[1] == "published" ? 0 : 1;
}
