; form-resource-governor-glass-current-run.fk — refresh honest governor telemetry.
;
; This is the bounded production publisher used by Glass.  It does not run
; the atomic-slot fixture from the governor proof runner.  Inputs the carrier
; cannot currently expose stay typed unavailable and therefore fail closed.
; System memory headroom is sampled physically on every invocation; it is not
; promoted to Metal working-set bytes or model residency.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-glass-observation-v2.bml form-stdlib/form-glass-observer.bml form-stdlib/form-resource-governor.bml form-stdlib/form-resource-host-pressure.bml form-stdlib/form-glass-telemetry-membrane.bml form-stdlib/form-resource-governor-glass.bml form-stdlib/hearth.bml

(do
    (defn frggcr-self-pid ()
        (do (let text (trim (host-exec "printf '%s' \"$PPID\"" "")))
            (if (eq (fgo-ps-uint? text) 1) (str_to_int text) 0)))
    (defn frggcr-self-current? (pid)
        (if (le pid 0) 0
            (fgo-ps-command-fkwu? (trim (host-exec
                (str_concat "/bin/ps -p " (str_concat (int_to_str pid) " -o comm=")) "")))))
    (defn frggcr-start-byte? (byte)
        (if (and (ge byte 48) (le byte 57)) 1
            (if (and (ge byte 65) (le byte 90)) 1
                (if (and (ge byte 97) (le byte 122)) 1
                    (if (eq byte 32) 1 (if (eq byte 58) 1 0))))))
    (defn frggcr-start-text-safe-at? (text at)
        (if (ge at (str_len text)) 1
            (if (eq (frggcr-start-byte? (str_byte_at text at)) 1)
                (frggcr-start-text-safe-at? text (add at 1)) 0)))
    (defn frggcr-process-start-seconds (pid)
        (do
            (let signature (trim (host-exec
                (str_concat "/bin/ps -p " (str_concat (int_to_str pid) " -o lstart=")) "")))
            (let safe (if (gt (str_len signature) 0)
                (frggcr-start-text-safe-at? signature 0) 0))
            (let command (if (eq safe 1)
                (str_concat "/bin/date -j -f '%a %b %e %T %Y' '"
                    (str_concat signature "' '+%s'")) ""))
            (let result (if (eq safe 1) (trim (host-exec command "")) ""))
            (if (eq (fgo-ps-uint? result) 1) (str_to_int result) -1)))
    (defn frggcr-provenance (pid startedSeconds epoch current)
        (if (or (not (eq current 1)) (le startedSeconds 0))
            (fgov2-provenance "declared" "resource.governor"
                (fgov2-unavailable "current-process-start-not-correlated" "process.current-lifetime")
                (fgov2-measured (kernel_stat 0)) (fgov2-measured epoch)
                "host-exec:/usr/bin/memory_pressure-Q")
            (fgov2-provenance "physical-live"
                (str_concat "resource.governor.p" (str_concat (int_to_str pid)
                    (str_concat ".s" (int_to_str startedSeconds))))
                (fgov2-measured (fgov2-process-lifetime pid (mul startedSeconds 1000)
                    (str_concat "os-p" (str_concat (int_to_str pid) (str_concat "-s" (int_to_str startedSeconds))))))
                (fgov2-measured (kernel_stat 0)) (fgov2-measured epoch)
                "host-exec:/usr/bin/memory_pressure-Q+metal_status:current-process-only")))
    (defn frggcr-unavailable (reason door) (frg-unavailable reason door))
    (defn frggcr-resource (name capacity-door foreground-door reserve-door)
        (frg-resource name
            (frggcr-unavailable "capacity-not-exposed" capacity-door)
            (frggcr-unavailable "foreground-demand-not-exposed" foreground-door)
            (frggcr-unavailable "reserve-not-exposed" reserve-door)))

    (let epoch (now_unix_ms))
    (let pid (frggcr-self-pid))
    (let started-seconds (frggcr-process-start-seconds pid))
    (let provenance (frggcr-provenance pid started-seconds epoch (frggcr-self-current? pid)))
    (let pressure-output (host-exec "/usr/bin/memory_pressure -Q" ""))
    (let headroom-policy (frghp-default-policy))
    (let pressure (frghp-pressure-from-output headroom-policy pressure-output 0 provenance))
    (let total-memory (frghp-total-bytes-from-output pressure-output 0 provenance))
    (let status (metal_status))
    (let sample (frg-sample
        (frggcr-unavailable "request-queue-not-correlated" "hearth.queue.current")
        (frggcr-resource "cpu" "host.cpu.capacity" "host.cpu.foreground" "host.cpu.reserve")
        (frggcr-resource "gpu" "metal.capacity" "metal.foreground" "metal.reserve")
        (frg-resource "memory" total-memory
            (frggcr-unavailable "foreground-demand-not-exposed" "host.memory.foreground")
            (frggcr-unavailable "reserve-not-exposed" "host.memory.reserve"))
        (frggcr-unavailable "foreground-presence-not-exposed" "host.foreground-presence")
        (frggcr-unavailable "foreground-latency-not-exposed" "host.foreground-latency")
        pressure
        (frggcr-unavailable "thermal-state-not-exposed" "host.thermal-state")
        (frggcr-unavailable "low-power-state-not-exposed" "host.low-power-state")
        (frg-signal (fgov2-status-number-truth status "in_flight") 0 provenance)))
    (let policy (frg-default-policy))
    (let decision (frg-tick policy (frg-initial-state) sample))
    (let release-plan (frg-pressure-release-plan policy (frg-pressure sample)
        (frggcr-unavailable "required-bytes-not-requested" "governor.reclaim-request") (list)))
    (let slot-observation (frg-metal-slot-observation
        "unobserved" "production-publisher-does-not-probe-fixture-slot"
        (frg-metal-slot-path) ""))
    (let frame (frgg-project policy sample decision (list) (list) (list)
        release-plan slot-observation epoch))
    (let published (frgg-publish (hearth-telemetry-root) epoch frame))
    (if (and (gt (len published) 1) (str_eq (nth published 1) "published")) 0 1))
