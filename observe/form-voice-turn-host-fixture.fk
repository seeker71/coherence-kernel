; form-voice-turn-host-fixture.fk -- a deliberately harmless live crossing.
;
; This is not an agent, not a remote call, and not a voice-quality result.  It
; is a reproducible Form -> host-file / host-exec -> Form witness whose public
; return has identities and state only.  It exists so the turn membrane can be
; observed as an actual crossing while the secure local-agent mailbox is built.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/string-byte-fold-src-shim.fk form-stdlib/sha256.fk
; preludes: form-stdlib/form-ontology-bp.fk form-stdlib/hex.fk
; preludes: form-stdlib/form-agent-protocol.fk form-stdlib/choice-receipt.fk
; preludes: form-stdlib/form-agent-tree.fk form-stdlib/tool-channel.fk
; preludes: form-stdlib/form-cli-membrane.fk observe/form-voice-turn.fk

(do
    (defn fvtf-public-report ()
        (do
            (let request "fixture request: form-owned and harmless")
            (let response "fixture response: returned through the membrane")
            (let path (str_concat (temp_dir)
                                  "/form-voice-turn-host-fixture-request.txt"))
            (let wrote (write_file path request))
            (let reread (read_file path))
            (let returned (host-exec
                "printf 'fixture response: returned through the membrane'"
                "ignored-by-current-host-exec"))
            (framebuffer-clear)
            (let outbound (fb_record
                (intern_trivial_string "form-voice-turn-fixture-request")
                "observe/form-voice-turn-host-fixture.fk" 1))
            (let inbound (fb_record
                (intern_trivial_string "form-voice-turn-fixture-response")
                "observe/form-voice-turn-host-fixture.fk" 2))

            (let prompt-ref (fvt-content-ref "hash-only" request ""))
            (let answer-ref (fvt-content-ref "hash-only" response ""))
            (let adapter-ref (fvt-content-ref "hash-only" "fixture=printf" ""))
            (let route (fvt-route "native-no-answer" "metal-refused"
                                  "local-returned"))
            (let turn (fvt-turn "fixture-turn-001" "hash-only" prompt-ref
                                route (list)))
            (let provenance (fvt-provenance "fixture" (fcm-surface-kernel)
                                            "fixture-return" adapter-ref
                                            "fixture-observed"))
            (let candidate (fvt-candidate "fixture-turn-001" answer-ref
                                          provenance (list) (list) "unmeasured"))
            (let final (fvt-final "fixture-turn-001" "identity-render"
                                  answer-ref "none"))
            (let file-ok (if (str_eq request reread) "1" "0"))
            (let stdout-ok (if (str_eq returned response) "1" "0"))
            (let final-ok (if (and
                (str_eq (fvt-decision turn candidate (list) final)
                        "accepted-exact-candidate")
                (str_eq (fvt-render-exact turn candidate (list) final response)
                        response))
                "1" "0"))
            (fvt-cat (list
                (fvt-report turn candidate (list) final)
                "fixture_file_roundtrip=" file-ok "\n"
                "fixture_stdout_return=" stdout-ok "\n"
                "framebuffer_event_count=" (int_to_str (len (framebuffer-events))) "\n"
                "fixture_exact_render=" final-ok "\n"
                "fixture_crossing=local-fixture-return\n"
                "fixture_note=deterministic-local-process-not-a-rented-voice\n"))))
    0)
