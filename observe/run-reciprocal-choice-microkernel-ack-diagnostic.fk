; Bounded diagnostic for band bit 32: inspect the successful observation-one
; acknowledgement after the dead choice-lane import was removed.
import "../cognition/reciprocal-choice-microkernel.fk"
import "../cognition/reciprocal-choice-microkernel-observations.fk"
import "bidirectional-framebuffer-channel.fk"

(do
  (framebuffer-clear)
  (let e1 (rcmo-exchange-one))
  (let ack (rcm-answer-ack (rcm-e-answer e1)))
  (let failed (bfc-envelope 0 75 0
    (list 32 (rcm-x-output (rcm-answer-execution (rcm-e-answer e1)))
      (oac-one? ack) (oac-nothing? ack)) 7599))
  (let evidence (bfc-control failed 4))
  (bfc-record-out failed 1)
  (bfc-record-in evidence 2)

  ; Re-observe the typed ack after the evidence request. No prompt content.
  (let observed (bfc-envelope 0 76 0
    (list (oac-one? ack) (oac-nothing? ack) (rcm-o-output (rcmo-observation-one)))
    7699))
  (let continue (bfc-control observed 0))
  (bfc-record-out observed 3)
  (bfc-record-in continue 4)
  (list "reciprocal-choice-ack-diagnostic"
    (list "request-action" (bfc-payload evidence)
          "evidence" (bfc-payload failed))
    (list "reobserve-action" (bfc-payload continue)
          "evidence" (bfc-payload observed))
    (list "framebuffer-events" (len (framebuffer-events)))))
