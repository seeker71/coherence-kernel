// turn-reward-run.bml — the native-turn ledger read through Terminal-RSI's rewards (form-stdlib/bml/turn-reward.bml).
//   ./fkwu observe/turn-reward-run.bml </dev/null
// stdin, optional, one JSON line: ledger (a path in place of receipts/native-turn-ledger.jsonl), rows (1 prints one JSON line per attempt first).
// Prints one [turn-reward] line: attempts, families, successes, the failed reward share under binary, FDR and SPR, and whether every
// success outranks every failure. It writes nothing and asks no model. Exit 0.
// preflight-exec: forbidden
import form-stdlib/bml/turn-reward.bml;
section [form.bml] {
 trw-run(dop-doc(trw-door(), stdin-text(), trw-spec()));
 0;
}
