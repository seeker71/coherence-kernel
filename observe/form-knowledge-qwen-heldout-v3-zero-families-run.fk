; form-knowledge-qwen-heldout-v3-zero-families-run.fk — diagnostic A/B over
; the five families the 2026-08-25 full audit scored 0/2: axioms, learn,
; teachings, control, ingest. Same sealed dataset, same consent gate, same
; scoring — only the row set is filtered. This is an OBSERVATION of whether
; the same-day curriculum expansion (fqt 30->37, seven zero-family entries
; with own-cell glosses) moved anything; it is NOT the promotion gate. Any
; >=95 claim still travels only through the full 30-row audit.
;
; preludes: form-stdlib/form-knowledge-heldout-reproduction.fk form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn fkz-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkz-model-id () "qwen3.8-27b-q8_0-form-native-metal-jit-v3-zerofam-ab")
    (defn fkz-consented? ()
        (fkh3-consent-valid? (read_file (fkh3-consent-path))))

    (defn fkz-zero-family? (f)
        (if (str_eq f "axioms") 1
        (if (str_eq f "learn") 1
        (if (str_eq f "teachings") 1
        (if (str_eq f "control") 1
        (if (str_eq f "ingest") 1 0))))))
    (defn fkz-filter (rows)
        (if (eq (len rows) 0) (list)
            (if (eq (fkz-zero-family? (fkh3-family (head rows))) 1)
                (cons (head rows) (fkz-filter (tail rows)))
                (fkz-filter (tail rows)))))

    ; ---- resumability: rows already scored in a previous sitting are named
    ; in observe/.zerofam-done (one id per line, untracked); a swept run
    ; costs only its in-flight row, never its completed ones. The done-file
    ; lives in the repo, not /tmp, per the shared-/tmp collision lesson.
    (defn fkz-done-text ()
        (if (eq (fs-exists? "observe/.zerofam-done") 1)
            (read_file "observe/.zerofam-done") ""))
    (defn fkz-done? (row done)
        (if (eq (str_len done) 0) 0
            (if (ge (str_find done (fkh3-id row) 0) 0) 1 0)))
    (defn fkz-skip-done (rows done)
        (if (eq (len rows) 0) (list)
            (if (eq (fkz-done? (head rows) done) 1)
                (fkz-skip-done (tail rows) done)
                (cons (head rows) (fkz-skip-done (tail rows) done)))))

    (defn fkz-loop (rows residence path scores executed)
        (if (eq (len rows) 0)
            (list "zerofam-loop" scores residence executed)
            (do
                (let row (head rows))
                (let effective (fqt-knowledge-prompt (fkh3-prompt row)))
                (let _a (print_str (fkh3-line "id" (fkh3-id row))))
                (let _b (print_str (fkh3-line "family" (fkh3-family row))))
                (let before (now_unix_ms))
                (let generated
                    (fcmg-generate-knowledge-resident-2p-hinted residence path
                        (fkh3-prompt row) (fcmg-current-source-query-budget)
                        (fcmg-current-source-answer-reserve) (fkh3-source row)))
                (let after (now_unix_ms))
                (let parsed (fkh3-parse-resident-output (nth generated 0)))
                (let score (fkh3-score row effective parsed (sub after before)))
                (let _c (print_str (fkh3-score-lines (list score))))
                ; the reproduction digest, persisted per row so the anchored /
                ; coincident / moved relation is witnessable next sitting
                ; (form-knowledge-heldout-reproduction.fk) — the ratio alone
                ; cannot tell an anchor from a coincidence.
                (let _d (print_str (fkh3-line "actual-sha"
                    (fkhr-actual-sha (fkh3-score-observation score)))))
                (fkz-loop (tail rows) (nth generated 1) path
                    (cons score scores)
                    (add executed (if (eq (fkh3-output-error parsed) 0) 1 0))))))

    (if (eq (fkz-consented?) 1)
        (do
            (let rows (fkh3-rows))
            (let audit (fkh3-leakage-audit rows))
            (if (eq (fkh3-dataset-valid-with? rows audit) 1)
                (do
                    (let subset (fkz-skip-done (fkz-filter rows) (fkz-done-text)))
                    (let _n (print_str (fkh3-line "scope" "zero-families-subset")))
                    (let _m (print_str (fkh3-line "subset-rows"
                        (int_to_str (len subset)))))
                    (let result (fkz-loop subset (fcmr-none) (fkz-model-path)
                        (list) 0))
                    (let scores (nmfe-reverse (nth result 1)))
                    (let release-ok (fcmr-release-ok? (nth result 2)))
                    (let all-executed
                        (if (eq (nth result 3) (len subset)) 1 0))
                    (let _r (print_str (fkh3-line "subset-executed"
                        (int_to_str (nth result 3)))))
                    (let _s (print_str (fkh3-line "subset-all-executed"
                        (int_to_str all-executed))))
                    (let _t (print_str (fkh3-line "residence-released"
                        (int_to_str release-ok))))
                    0)
                (do
                    (print_str (fkh3-line "dataset-sha256" (fkh3-dataset-seal)))
                    (print_str (fkh3-line "dataset-valid" "0"))
                    0)))
        (do
            (print_str (fkh3-line "dataset-sha256" (fkh3-dataset-seal)))
            (print_str (fkh3-line "consent-present" "0"))
            0)))
