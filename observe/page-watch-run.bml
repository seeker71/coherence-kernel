// page-watch-run.bml — what a running kernel is doing NOW, read from its live page by another process: no sampling file, no wait for the run to end.
//
//   echo '{"pid":12345,"every_ms":200,"top":12}' | ./fkwu observe/page-watch-run.bml
//
// Each beat prints the kernel's current phase and defn (kernel_page_hot pid 0: the C phase its sampler last saw, and the row it was in), and counts how many
// beats each (phase, defn) held; when the kernel ends, the watch ends and prints the held counts and the kernel's hottest defns read from its page (kernel_page_hot pid n)
// while it still stands. A kernel that has no page to read (not yet sampling, or gone) reads as nothing: the watch waits for it, up to idle_ms (default 60000).
// stdout: one line a change of (phase, defn), then the summary.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/door-options.bml form-stdlib/bml/serve-sched.bml form-stdlib/sort.fk
section [form.bml] {
 class PageWatch {
  def pw-spec() = [["pid", "int"], ["every_ms", "int"], ["top", "int"], ["idle_ms", "int"]];
  def pw-row-text(r) = nothing?(r) ? "nothing" : nothing?(r[1]) ? r[0].str() ++ " (a unit's top level)" : r[0].str() ++ " " ++ r[1][1].str();
  def pw-go(pid, every, top, idle, quiet_ms, last, seen) {
   let now = kernel_page_hot(pid, 0);
   let text = pw-row-text(now);
   if nothing?(now) then {
    if quiet_ms >= idle then { print_str("[page-watch] the page went quiet: " ++ pid.str() ++ " ends or never sampled"); pw-end(pid, top, seen); } else { host_sleep_ms(every); pw-go(pid, every, top, idle, quiet_ms + every, last, seen); };
   } else {
    let said = text == last ? 0 : { print_str("[page-watch] " ++ text); 1; };
    host_sleep_ms(every);
    pw-go(pid, every, top, idle, 0, text, pw-bump(seen, text));
   };
  }
  def pw-bump(seen, text) = pw-has?(seen, text) ? map(p => p[0] == text ? [p[0], p[1] + 1] : p, seen) : cons([text, 1], seen);
  def pw-has?(seen, text) = len(filter(p => p[0] == text, seen)) > 0;
  def pw-end(pid, top, seen) {
   let sorted = sort-by(seen, p => 0 - p[1]);
   let a = map(p => print_str("[page-watch] held " ++ p[1].str() ++ " beats: " ++ p[0]), sort-take(sorted, top));
   let forced = len(a);
   let hot = kernel_page_hot(pid, top);
   nothing?(hot) ? print_str("[page-watch] no hot rows left on the page") : print_str("[page-watch] hottest on its page: " ++ hot.str());
   nothing();
  }
  def pw-run() {
   let o = dop-doc("page-watch", stdin-text(), pw-spec());
   pw-go(svs-int(o, "pid", 0), svs-int(o, "every_ms", 200), svs-int(o, "top", 12), svs-int(o, "idle_ms", 60000), 0, "", []);
  }
 }
 pw-run();
}
