; Real DS4 crystallized lookup: resolve the actual layer-0 plan once and reuse
; its inspected descriptor eight times.  The checksum must match the baseline.
; preludes: native/metal/dsv4-layer-walk.fk

(do
    (defn dlwp-after-repeat (plan remaining checksum)
        (if (eq remaining 0) checksum
            (dlwp-after-repeat plan (sub remaining 1)
                (add checksum (dlp-view (nth plan 1))))))
    (let src (eqr-of-file (dlp-model-path) 0 (gm-window)))
    (let base (egg-data-base src (gm-alignment)))
    (let descs (dlp-collect src base (egg-tinfo-start src) (egg-tensor-count src)))
    (let plan (dlw-layer-plan src descs 0))
    (print_str (str_concat "REAL after-checksum="
        (int_to_str (dlwp-after-repeat plan 8 0)))))
