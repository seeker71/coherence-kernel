// Supplied samples travel through the actual BML organs, inventory and fusion.
// These observations establish interpretation and routing, not hardware acquisition.
// preludes: observe/motion-sense-organ.fk observe/scene-features-organ.fk observe/same-room-organ.fk
section [form.bml] {
 class SensorFlow {
  def sfw-equal(actual: Value,expected: Value,name: String) = if actual == expected then actual else
   form_error(str-join(list("sensor flow: ",name," expected ",value_str(expected)," observed ",value_str(actual))));
  def sfw-reading(row,plane,value,carrier) = sfw-equal(row,list("reading",plane,value,carrier,"organ",90),"routed reading");
  def sfw-main() {
   let roster = wsf-roster();
   sfw-equal(map(wsf-plane,roster),list("where","who","where","what","who","vitality","vitality","where","where","where"),"sensor planes");
   let carriers = list("wifi","bluetooth","battery","memory","camera","mic");
   sfw-equal(wsf-floor-complete?(carriers,roster),list("floor-partial",6,10,list("gps","proximity","magnetometer","barometer")),"available carriers");
   let camera-only = wsf-floor-complete?(list("camera","mic"),roster);
   sfw-equal(list(wfc-carried(camera-only),wsf-has?(wfc-missing(camera-only),"gps")),list(2,1),"partial inventory");
   sfw-equal(wfc-complete?(wsf-floor-complete?(map(wsf-name,roster),roster)),1,"complete inventory");
   sfw-equal(so-afferent?(motion-organ()) && so-answers?(motion-organ(),"motion"),1,"sensor port");
   let accel = list(3.0,4.0,0.0); let yaw = list(0.0,0.0,1.0);
   sfw-equal(round(ms-acc-magnitude(ms-acceleration(accel)) * 100.0),500,"acceleration");
   sfw-equal(round(ms-speed(list(accel,accel,accel),1.0) * 100.0),1500,"integrated magnitude");
   sfw-equal(round(ms-speed(list(accel),1.0) * 100.0),500,"one sample");
   let motion = motion-obs(list(0.0,0.0),list(accel),yaw,1.0,90);
   sfw-reading(head(ms-route(motion)),"where",32580,"gps");
   sfw-reading(nth(ms-route(motion),1),"motion",2,"accelerometer");
   sfw-equal(list(head(ms-fuse(motion)),fo-o-where(ms-fuse(motion))),list("observed",32580),"motion fusion");
   let baseline = list(100,100,100,100,100,100,100,100,100,100,100,100,100,100,250,10);
   let scene = list(100,100,100,100,100,100,100,100,100,100,100,100,250,10,250,10);
   sfw-equal(sf-shape(baseline,4,300),list(0,0,0,1),"room shape");
   sfw-equal(sf-objects(baseline,4,30),list(3),"baseline objects");
   sfw-equal(sf-objects(scene,4,30),list(2,3),"new object");
   sfw-equal(list(sf-common?(baseline,baseline,4,0,1,30),sf-unique?(scene,baseline,4,0,1,30),sf-common?(scene,baseline,4,1,1,30)),list(1,1,1),"region residuals");
   sfw-equal(list(sf-edge(baseline,4,2,3),sf-block-edge(baseline,4,0,0),sf-detail(empty,0,0,0,0,0)),list(240,0,0),"gradient and empty region");
   sfw-reading(scene-route(list(scene,4,30),90),"what",2,"camera");
   let home = cs-signature(list("home-5g","home-2g"),list("echo","tv","thermostat"),-1);
   let car = cs-signature(list("car-audio"),list("car-headunit","phone"),-1);
   let noisy = cs-signature(list("car-audio","home-2g"),list("car-headunit"),-1);
   let cafe = cs-signature(list("cafe-guest"),list("barista-speaker"),-1);
   let known = list(cs-register(home,"home"),cs-register(car,"car"));
   sfw-equal(list(cs-overlap(noisy,car),cs-overlap(noisy,home),cs-overlap(cafe,car)),list(50,14,0),"network overlap");
   sfw-equal(list(cs-match(noisy,known,30),cs-match(cafe,known,30),cs-loc(noisy),len(cs-bt(car))),list("car","new",-1,2),"context recognition");
   sfw-equal(cs-match(car,list(cs-register(car,"first"),cs-register(car,"second")),30),"first","stable tie");
   sfw-equal(cs-match(car,empty,0),"new","no contexts");
   let a = cs-signature(list("office"),list("deskcam","kbd"),-1);
   let b = cs-signature(list("office"),list("deskcam"),-1);
   sfw-reading(same-room-route(list(a,b,30),90),"where",1,"wifi");
   sfw-reading(same-room-route(list(a,cafe,30),90),"where",0,"wifi");
   sfw-equal(sr-why(a,b,30),list("network-overlap","same-room",66,30),"shared evidence");
   sfw-equal(sr-why(a,cafe,30),list("network-overlap","different-room",0,30),"distinct evidence");
   let rooms = list(rr-register(10,list(4,2,7)),rr-register(20,list(1,6,3)));
   sfw-equal(list(sr-which-room-id(list(4,2,8),rooms,3,99),sr-which-room-id(list(1,6,4),rooms,3,99)),list(10,20),"registered rooms");
   let groups = sr-fusion(list(list(sr-device("a",a),sr-device("b",b),sr-device("c",cafe)),30));
   sfw-equal(groups,list(list("b","a"),list("c")),"room membership");
   let fused = so-observe(same-room-organ(),sr-feature,wsf-fuse,list(list(a,b,30)),90);
   sfw-equal(list(fo-o-where(fused),fo-o-confidence(fused)),list(1,90),"room fusion");
   let gathered = wsf-fuse(list(wsf-route(wsf-find(roster,"wifi"),2,80),wsf-route(wsf-find(roster,"bluetooth"),"ilena",60),wsf-route(wsf-find(roster,"mic"),"ilena",70),wsf-route(wsf-find(roster,"camera"),"face",90)));
   sfw-equal(list(fo-o-where(gathered),fo-o-who(gathered),fo-o-what(gathered)),list(2,"ilena","face"),"cross-sensor fusion");
   print(list("sensor-flow","source-backed","motion",32580,"objects",sf-objects(scene,4,30),"context",cs-match(noisy,known,30),"rooms",groups));
   1;
  }
 }
 sfw-main();
}
