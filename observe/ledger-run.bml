// ledger-run.bml — a node ledger as text for a person, and form-rows text carried into a node ledger once.
//
//   printf 'show .hearth/form-token-lora/llama-1791769698018/training-events.fkb\n' | ./fkwu observe/ledger-run.bml
//   printf 'show EVENTS.fkb\nlast 5\n' | ./fkwu observe/ledger-run.bml                    the last five rows only
//   printf 'from EVENTS.rows\nto EVENTS.fkb\n' | ./fkwu observe/ledger-run.bml          a text ledger becomes a node ledger
//
// The Form-token loop keeps its ledgers as nodes at rest (form-value-nodes.bml, FORMBIN2 on disk): content-addressed rows the
// kernel holds natively, read with no parse. This is the view: `show` prints each row as one line of form-rows text (the derived
// text, what the trainer prints as it works), `from`/`to` reads an older ledger of form-rows text and writes it as nodes, whole or
// not at all (a line that does not read stops the door before anything is written, and it says which). `to` must not hold rows
// unless `append 1` is given. Prints the rows and bytes.
// stdin: `show PATH` [`last N`]  or  `from PATH` `to PATH` [`append 1`]   (frw-options)
// preflight-exec: forbidden
import form-stdlib/bml/form-rows.bml;
import form-stdlib/bml/form-value-nodes.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class LedgerRun {
  def lrr-say(t) = print_str("[ledger] " ++ t);
  def lrr-run() = lrr-with(frw-options(stdin-text() ?? ""));
  def lrr-with(o) {
   if (String) o[0] != "ok" then lrr-say("the options were refused at line " ++ o[2].str() ++ ": " ++ o[1])
   else if frw-has?(o[1], "show") then lrr-show(frw-str(o[1], "show", ""), frw-int(o[1], "last", 0))
   else if frw-has?(o[1], "from") && frw-has?(o[1], "to") then lrr-carry(frw-str(o[1], "from", ""), frw-str(o[1], "to", ""), frw-int(o[1], "append", 0) == 1)
   else lrr-say("give `show PATH` [`last N`], or `from PATH` and `to PATH` [`append 1`]");
  }
  def lrr-show(path, last) {
   let nodes = fvn-ledger(path);
   let shown = last > 0 && last < len(nodes) ? nodes[len(nodes) - last:] : nodes;
   let lines = map(n => print_str(fvn-text(n) ++ "\n"), shown);
   lrr-say(path ++ ": " ++ len(shown).str() ++ " of " ++ len(nodes).str() ++ " row(s)");
  }
  def lrr-carry(from, to, adding) {
   let r = frw-rows(read_file(from) ?? "");
   let have = fvn-ledger(to);
   if file_size(from) < 1 then lrr-say(from ++ " is absent or empty: nothing was written")
   else if (String) r[0] != "ok" then lrr-say(from ++ " is refused (" ++ r[1] ++ "): nothing was written")
   else if len(have) > 0 && !adding then lrr-say(to ++ " holds " ++ len(have).str() ++ " row(s): nothing was written (give `append 1` to add after them)")
   else lrr-put(to, append(have, map(v => fvn-of(v), r[1])), len(r[1]));
  }
  def lrr-put(to, nodes, added) {
   let wrote = fvn-ledger-write(to, nodes);
   lrr-say(to ++ ": " ++ added.str() ++ " row(s) added, " ++ len(nodes).str() ++ " in all, " ++ wrote.str() ++ " bytes");
  }
 }
 lrr-run();
}
