// git-native-run.bml — `git`, in Form: the read commands answered from the repository's own files, no program started.
//
//   printf 'rev-parse HEAD'                      | ./fkwu observe/git-native-run.bml
//   printf 'status --porcelain=v1 -b'            | ./fkwu observe/git-native-run.bml
//   printf 'log --oneline -n 5'                  | ./fkwu observe/git-native-run.bml
//   printf -- '-C /path/to/worktree diff --name-only HEAD~1' | ./fkwu observe/git-native-run.bml
//
// stdin is one argv-style command line (the words after `git`; '…' and "…" group words). stdout is what git prints (the door's one
// framing line: a text that does not end in a newline gets the door's newline), stderr is git's stderr, and the LAST line of stdout is
// the exit code (the cell's value): 0 ok, 1 a question answered no (merge-base --is-ancestor, diff --quiet, cat-file -e ...),
// 128 fatal (not a repository, a name that is no object), 129 a flag or command refused by name.
//
// The read commands, the flags in use at the product's git sites, and what is refused by name are listed at the head of
// form-stdlib/bml/git-cmd.bml; the local write commands (init, add, rm, commit, update-ref, branch, tag, checkout, switch, restore, reset,
// hash-object -w) at the head of git-wcmd.bml; merge and rebase at the head of git-merge.bml. A write is allowed only in a scratch
// repository under the temp directory or with `-c native.allow-write=true` on the command line (exit 128 otherwise, nothing touched).
// fetch, pull and push are phase 3 and are refused by name. The census that chose all of this is receipts/2026-10-04-the-native-git.md.
// The door runs in the cwd it is started in (or the directory given by -C).
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/git-sha1.bml form-stdlib/bml/git-inflate.bml form-stdlib/bml/git-store.bml form-stdlib/bml/git-refs.bml form-stdlib/bml/git-index.bml form-stdlib/bml/git-ignore.bml form-stdlib/bml/git-status.bml form-stdlib/bml/git-rev.bml form-stdlib/bml/git-diff.bml form-stdlib/bml/git-cmd.bml form-stdlib/bml/git-write.bml form-stdlib/bml/git-wcmd.bml form-stdlib/bml/git-merge.bml
import form-stdlib/core.fk;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/bml/git-sha1.bml;
import form-stdlib/bml/git-inflate.bml;
import form-stdlib/bml/git-store.bml;
import form-stdlib/bml/git-refs.bml;
import form-stdlib/bml/git-index.bml;
import form-stdlib/bml/git-ignore.bml;
import form-stdlib/bml/git-status.bml;
import form-stdlib/bml/git-rev.bml;
import form-stdlib/bml/git-diff.bml;
import form-stdlib/bml/git-cmd.bml;
import form-stdlib/bml/git-write.bml;
import form-stdlib/bml/git-wcmd.bml;
import form-stdlib/bml/git-merge.bml;
section [form.bml] {
 class GitNativeRun {
  // print_str writes the text and one newline: a text that ends in a newline gives up that one
  def gnr-emit(text) = len(text) == 0 ? 0 : str_byte_at(text, len(text) - 1) == 10 ? print_str(substring(text, 0, len(text) - 1)) : print_str(text);
  def gnr-err(text) = len(text) == 0 ? 0 : write_file("/dev/stderr", text);
 }
 let line = stdin-text();
 let res = git-run-full-line(host_cwd(), line);
 let wrote = gnr-emit(res[0]);
 let said = gnr-err(res[2]);
 res[1];
}
