; jungle-ear-name.fk — a name arrives from outside and binds to a node id.
;
; The body never mints an animal's name. It measures, it remembers, and it waits.
; When a person -- or a mind that actually heard the sound -- knows what a voice
; is, this door binds that name to the voice's content address, writes it into
; the rows the ear keeps, and lays a row into locale-rows so the tongue lane can
; carry it into every tongue the header names.
;
; stdin, three lines:
;   line 1  the node id (eight hex characters), from observe/jungle-ear-voices.fk
;   line 2  the name, in English
;   line 3  optional: the same name in the other tongues of the tongue header,
;           separated by "|", in the header's order. Blank leaves them absent.
;
; A node nobody carries is refused out loud rather than silently doing nothing.
;
; preflight-exec: forbidden
; preludes: form/form-stdlib/jungle-ear.bml form/form-stdlib/form-fs.fk
(do
    (defn jen-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (jen-cat (tail xs)))))
    (defn jen-text (v) (if (nothing? v) "" v))
    (defn jen-line () (do (let l (read_line)) (if (nothing? l) "" (trim l))))
    ; the tongues the jungle rows carry; the english key leads, as in symbol-words.rows
    (defn jen-tongues () (list "english" "indonesian" "balinese" "german" "french" "persian"))
    (defn jen-blank (n) (if (le n 0) "" (str_concat "|" (jen-blank (sub n 1)))))
    (defn jen-header () (je-tongue-header (jen-tongues)))
    (defn jen-words (rest) (if (eq (str_len rest) 0) (jen-blank (sub (len (jen-tongues)) 1)) (str_concat "|" rest)))

    (let node (jen-line))
    (let name (jen-line))
    (let rest (jen-line))
    (let text (jen-text (read_file (JERowsPath))))
    (let cs (if (eq (str_len text) 0) (list) (je-rows-of text)))
    (let found (je-find cs node))
    (if (eq (len cs) 0) (print "no voices yet -- nothing to name. run observe/jungle-ear-listen.fk") 0)
    (if (and (gt (len cs) 0) (eq (len found) 0)) (print (jen-cat (list "no voice carries the address " node " -- refusing to name a voice this place has not heard"))) 0)
    (if (eq (str_len name) 0) (print "no name given -- a voice keeps its coordinates rather than take an empty word") 0)
    (let ok (if (eq (len found) 0) 0 (if (eq (str_len name) 0) 0 1)))
    (let bound (if (eq ok 1) (je-bind cs node name) cs))
    (let wrote (if (eq ok 1) (write_file (JERowsPath) (je-rows-wire bound)) 0))
    ; the tongue row: appended if the file stands, created with its header if not
    (let old (jen-text (read_file (JETonguePath))))
    (let head0 (if (eq (str_len old) 0) (str_concat (jen-header) (byte_to_str 10)) old))
    (let line (jen-cat (list name (jen-words rest) (byte_to_str 10))))
    (let laid (if (eq ok 1) (write_file (JETonguePath) (str_concat head0 line)) 0))
    (if (eq ok 1) (print (jen-cat (list "named " node " -> " name))) 0)
    (if (eq ok 1) (print (je-describe found)) 0)
    (if (eq ok 1) (print (jen-cat (list "the name now travels: " (JETonguePath)))) 0)
    ok)
