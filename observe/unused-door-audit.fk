; unused-door-audit.fk — a noticing made three times by hand, asked once.
;
; preludes: form-stdlib/core.fk
;
; A cell that NAMES a prelude it does not call can still inherit what that prelude
; cannot do: naming form-stdlib/json.fk handed json.fk's unresolved natives to
; chains touching no json- function. An unresolved call answers `nothing`, so bits
; that touch it read 0 and the band reports a number anyway.
;
; Made three times with grep on 2026-08-15 — natural-language / nl-translate /
; translate-lane band chains, then cache.fk, then audit-evidence-cells.fk. Three
; shapes with one solution means the solution is generic; copy-paste of a reading
; is debt that fragments into partial fixes.
;
; RADIUS, and it under-reports on purpose. It reads a cell's OWN text: for each
; named prelude, does the caller mention any name that prelude defines. A mention
; in a comment counts as a use. It does NOT read the transitive chain — so
; tests/training-catalog-band.fk reads UNUSED for json.fk while genuinely needing
; it, because code-tool-learning.fk calls json-array-length and carries no
; preludes line of its own. A flag here is a question, not an answer.
;
; THE CLAIMS ARE BITS. tests/unused-door-audit-band.fk:
;   b1,b2    the declared chain is found and carries its names
;   b3,b4    a called prelude reads used; an uncalled one reads unused
;   b5,b6    no chain yields no chain; a definer defining nothing is never used
;   b7       the declared radius: a comment mention counts as a use
;   b9       used and unused read apart
;
; It edits nothing. It names what it found and the writer decides.
; witnessed: 2026-08-15 -> band 511 on fkwu.

(do
    (defn uda-byte (t n i) (if (or (lt i 0) (ge i n)) 0 (str_byte_at t i)))
    (defn uda-nl () 10)

    ; ---- the declared chain: the text after "; preludes:" up to end of line ----
    (defn uda-mark () "; preludes:")
    (defn uda-eol (t n i)
        (if (ge i n) i (if (eq (uda-byte t n i) (uda-nl)) i (uda-eol t n (add i 1)))))
    (defn uda-chain-text (t)
        (do (let h (str_find t (uda-mark) 0))
            (if (lt h 0) ""
                (do (let s (add h 11)) (substring t s (uda-eol t (str_len t) s))))))

    ; ---- the names a cell defines, as a count and as a membership test ----
    (defn uda-defn-mark () "(defn ")
    (defn uda-name-end (t n i)
        (if (ge i n) i
            (do (let b (uda-byte t n i))
                (if (or (eq b 32) (or (eq b 40) (or (eq b 41) (eq b (uda-nl))))) i
                    (uda-name-end t n (add i 1))))))
    ; does CALLER mention any name DEFINER defines? walks definer's defn heads.
    (defn uda-uses-loop (caller definer n from)
        (do (let h (str_find definer (uda-defn-mark) from))
            (if (lt h 0) 0
                (do (let s (add h 6))
                    (let e (uda-name-end definer n s))
                    (if (le e s) (uda-uses-loop caller definer n (add h 6))
                        (if (ge (str_find caller (substring definer s e) 0) 0) 1
                            (uda-uses-loop caller definer n (add h 6))))))))
    (defn uda-uses? (caller definer)
        (uda-uses-loop caller definer (str_len definer) 0))

    ; ---- the reading: does this caller use that prelude at all ----
    ; Paths in a chain are stated relative to form/, the way the resolver reads them.
    (defn uda-root () "form/")
    (defn uda-cell-text (rel) (read_file (str_concat (uda-root) rel)))
    (defn uda-carries? (caller-path prelude-rel)
        (uda-uses? (read_file caller-path) (uda-cell-text prelude-rel)))
    ; 1 when the caller NAMES that prelude and this reading finds no call into it
    (defn uda-unused? (caller-path prelude-rel)
        (do (let chain (uda-chain-text (read_file caller-path)))
            (if (lt (str_find chain prelude-rel 0) 0) 0
                (if (eq (uda-carries? caller-path prelude-rel) 1) 0 1))))

    ; ---- fixtures, so the walk is checked on text it was not fitted to ----
    ; The caller fixture is BUILT, not written. A literal "; preludes:" in a string
    ; is still read by the resolver — it scans source text, not syntax — so the
    ; first version of this fixture declared a real dependency on observe/a.fk and
    ; the cell would not load. Witnessed 2026-08-15, one command after this
    ; header called preludes "all-or-nothing": they are text-scanned, which is
    ; subtler than the absolute I had just written.
    (defn uda-fx-caller ()
        (str_concat (uda-mark) " a.fk b.fk\n(do (alpha 1))"))
    (defn uda-fx-a () "(do (defn alpha (x) x))")
    (defn uda-fx-b () "(do (defn beta (x) x))")
    (defn uda-fx-nochain () "(do (defn gamma (x) x))")
    0)
