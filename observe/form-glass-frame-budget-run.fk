// form-glass-frame-budget-run.fk — the glass frame path, measured as it runs.
//
// Twenty consecutive frames through the SAME per-frame work the live loop does
// -- sensor gift reads with their held triples, the cached inventory with its
// cache carried frame to frame, observations held every fourth frame, kernel
// rows, the flow point, the dashboard frame -- with per-stage milliseconds
// and the count of frames whose total work stayed under 50 ms. No synthetic
// samples enter; a sensor that is not giving shows as its one absent row and
// the frame is measured with it. Run with observe/form-glass-sensors-live.fk
// standing to see the path as the live glass sees it. The twentieth frame is
// also painted as the 80x24 atlas, so the gauges are witnessed on real frames.
//
import form/form-stdlib/form-glass-live.bml;
section [form.bml] {
    def fbr-ms(a, b) = b - a;
    // the read surface, named: every frame the rows came from (shm name, seq) and each lane's value with the frame it read
    def fbr-gift-rows(rows) = (Comparable) len(rows) == 0 ? [] : (String) fgo-domain(rows[0]) == "gift" ? cons([fgo-id(rows[0]), fgo-int-value(rows[0]), fgo-source(rows[0])], fbr-gift-rows(rows[1:])) : fbr-gift-rows(rows[1:]);
    def fbr-read-surface(metrics, point) = {
        print(["frames-read", fbr-gift-rows(metrics)]);
        print(["lanes", ["G", fgd-flow-value(point, 2), fgd-flow-source(point, 2)], ["C", fgd-flow-value(point, 3), fgd-flow-source(point, 3)], ["D", fgd-flow-value(point, 4), fgd-flow-source(point, 4)], ["Q", fgd-flow-value(point, 5), fgd-flow-source(point, 5)], ["J", fgd-flow-value(point, 6), fgd-flow-source(point, 6)], ["c", fgd-flow-value(point, 7), fgd-flow-source(point, 7)], ["R", fgd-flow-value(point, 8), fgd-flow-source(point, 8)], ["I", fgd-flow-value(point, 9), fgd-flow-source(point, 9)]]);
    };
    def fbr-frame(frame, heldFast, heldHost, heldQueue, heldStorage, heldHeat, cache, history, acc) = {
        let t0 = now_unix_ms();
        let epoch = t0;
        let roster = (Comparable) len(fgl-cache-roster(cache)) == 0 || (Comparable) fgl-cycle?(frame, 10) == 1 ? fgtm-inventory-roster(FGLRoot()) : fgl-cache-roster(cache);
        let ta = now_unix_ms();
        let inventoryPair = fgtm-inventory-cached-with(FGLRoot(), roster, fgl-cache-snapshots(cache));
        let tb = now_unix_ms();
        let inventory = inventoryPair[0];
        let inventoryMoved = fgtm-inventory-moved(inventoryPair, fgl-cache-snapshots(cache));
        let inventorySamples = (Comparable) inventoryMoved == 0 && len(fgl-cache-samples(cache)) > 0 ? [] : fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
        let tc = now_unix_ms();
        let jitSamples = fgl-jit-current-samples();
        let td = now_unix_ms();
        let externalSamples = (Comparable) inventoryMoved == 0 && len(fgl-cache-samples(cache)) > 0 ? fgl-cache-samples(cache) : fgl-dedupe-samples(append(jitSamples, inventorySamples));
        let te = now_unix_ms();
        let samples = fgl-local-samples(externalSamples, epoch);
        let t1 = now_unix_ms();
        let hostHeld = fgsr-take("host", heldHost);
        let ownerHeld = fgsr-take("owner", heldFast);
        let queueHeld = fgsr-take("queue", heldQueue);
        let storageHeld = fgsr-take("storage", heldStorage);
        let hostRows = append(fgsr-rows-or-absent("machine", fgsr-take("machine", [])), fgsr-rows-or-absent("host", hostHeld));
        let ownerRows = fgsr-rows-or-absent("owner", ownerHeld);
        let queueRows = fgsr-rows-or-absent("queue", queueHeld);
        let storageRows = fgsr-rows-or-absent("storage", storageHeld);
        let t2 = now_unix_ms();
        let heatRows = fgl-heat-rows-at(frame, heldHeat, epoch);
        let localRows = append(fgo-observe-rows(fgl-frame-fast-rows(frame, 0, 0, 40, fgl-fast-rows(frame, heldFast, [])), epoch, frame), append(heatRows, fgo-observe-rows(fgl-kernel-rows(), epoch, frame)));
        let gaveGlass = fgsr-give("glass", epoch, localRows);
        let fastRows = append(fgsr-rows-or-absent("glass", fgsr-take("glass", [])), ownerRows);
        let kernelRows = [];
        let t3 = now_unix_ms();
        let metricsObserved = append(fgo-observe-rows([fgl-string-growth-row(kernel_stat(5)), fgl-node-growth-row(kernel_stat(4))], epoch, frame), append(fastRows, append(hostRows, append(queueRows, append(storageRows, append(kernelRows, fgl-model-route-rows(samples, epoch, frame)))))));
        let metrics = fgo-age-rows-at(metricsObserved, epoch);
        let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
        let observations = (Comparable) len(fgl-cache-observations(cache)) == 0 || (Comparable) fgl-cycle?(frame, 4) == 1 ? fgl-v2-observations(epoch, frame, samples) : fgl-cache-observations(cache);
        let nextCache = fgl-cache-full(inventoryPair[1], observations, externalSamples, roster);
        let t4 = now_unix_ms();
        let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
        let nextHistory = ftc-ring-push(history, point, FGLHistoryCapacity());
        let control = fgl-control-state-full("all", "budget", 0, "held", "overview", "all", "all", 0);
        let nextFrame = fgl-dashboard-frame(110, 34, epoch, FGLActiveHz(), frame, control, metrics, samples, publishers, nextHistory, observations);
        let t5 = now_unix_ms();
        let total = fbr-ms(t0, t5);
        let row = [frame, fbr-ms(t0, t1), fbr-ms(t1, t2), fbr-ms(t2, t3), fbr-ms(t3, t4), fbr-ms(t4, t5), total, len(samples), len(metrics), inventoryMoved, ["roster", fbr-ms(t0, ta), "inventory", fbr-ms(ta, tb), "derive", fbr-ms(tb, tc), "jit", fbr-ms(tc, td), "dedupe", fbr-ms(td, te), "local", fbr-ms(te, t1)]];
        frame >= 19 ? {
            print(fgd-segment-project(fgl-dashboard-frame(80, 24, epoch, FGLActiveHz(), frame, fgl-control-state-full("all", "budget", 0, "held", "atlas", "all", "all", 0), metrics, samples, publishers, nextHistory, observations)));
            fbr-read-surface(metrics, point);
            cons(row, acc);
        } : fbr-frame((Number) frame + (Number) 1, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, nextCache, nextHistory, cons(row, acc));
    };
    def fbr-warm(rows) = len(rows) <= 1 ? [] : reverse(reverse(rows)[1:]);
    def fbr-col(rows, k) = (Comparable) len(rows) == 0 ? [] : cons(nth(rows[0], k), fbr-col(rows[1:], k));
    def fbr-under(rows, n) = (Comparable) len(rows) == 0 ? n : fbr-under(rows[1:], rows[0][6] < 50 ? (Number) n + (Number) 1 : n);
    def fbr-col-max(rows, k, m) = (Comparable) len(rows) == 0 ? m : fbr-col-max(rows[1:], k, nth(rows[0], k) > m ? nth(rows[0], k) : m);
    def fbr-col-sum(rows, k, s) = (Comparable) len(rows) == 0 ? s : fbr-col-sum(rows[1:], k, (Number) s + (Number) nth(rows[0], k));
    let rows = fbr-frame(0, [], [], [], [], [], fgl-cache-empty(), [], []);
    let n = len(rows);
    print(["form-glass-frame-budget-v1", "frames", n, "under-50ms", fbr-under(rows, 0), "first-frame-total", nth(rows, n - 1)[6], "mean-ms", ["inventory+samples", fbr-col-sum(rows, 1, 0) / n, "sensors", fbr-col-sum(rows, 2, 0) / n, "heat+fast+kernel", fbr-col-sum(rows, 3, 0) / n, "metrics+observations", fbr-col-sum(rows, 4, 0) / n, "flow+render", fbr-col-sum(rows, 5, 0) / n, "total", fbr-col-sum(rows, 6, 0) / n], "max-total-ms", fbr-col-max(rows, 6, 0), "max-warm-ms", fbr-col-max(fbr-warm(rows), 6, 0), "moved-per-frame", fbr-col(rows, 9), "stage-1-split-frame-10", rows[9][10], "sensors-standing", [fgsr-standing?("host"), fgsr-standing?("owner"), fgsr-standing?("queue"), fgsr-standing?("storage")]]);
    fbr-under(rows, 0);
}
