// form-token-usage-run.bml — the Form tokens in use, kind by kind, for one evaluation row.
//
//   print -r -- "2 lora" | ./fkwu observe/form-token-usage-run.bml
//
// stdin, optional: "ROW ARM". ROW is an index into receipts/form-token-eval.jsonl, negative from the end (-1, the
// default, is the newest); ARM is plain, taught or lora (default lora). Prints, for that arm, the controls taught per
// kind by the trace corpus, the controls its held-out traces expected, the complete controls the voice wrote, the
// substitution between them, the kinds used and their effective number, each family's answers, and the advice the rules
// in form-stdlib/bml/form-token-usage.bml give. Model-free: it reads the receipts and the corpus, opens nothing.
// preflight-exec: forbidden
import form-stdlib/bml/form-token-usage.bml;
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class FormTokenUsageRun {
  def ftur-at(rows, i) = i < 0 ? rows[len(rows) + i] : rows[i];
  def ftur-run(spec) {
   let parts = split-on(trim(spec ?? ""), " ");
   let rows = fu-rows();
   let i = len(parts) > 0 && len(parts[0]) > 0 ? str_to_int(parts[0]) : 0 - 1;
   let arm = len(parts) > 1 ? parts[1] : "lora";
   map(l => print_str(l), fu-lines(ftur-at(rows, i), arm, fu-corpus()));
   0;
  }
 }
 ftur-run(stdin-text());
}
