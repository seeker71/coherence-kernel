// stdin, one `name value` a line (form-rows.bml frw-options):
//   events training-events.rows     budgets_gib [2 4 8]     ridge 0.000001     headroom 0.9
import form-stdlib/bml/stdin-source.bml;
import form-stdlib/bml/training-observations.bml;
import form-stdlib/bml/form-cli-microthought.bml;
section [form.bml] {
 def tcr-run(request) {
  let offered = tro-offer(oh-str(request, "events"));
  let owner = fmc-open(4096); defer fmc-release(owner);
  let imported = fmc-render(fmc-token(owner, "recipe-import", "training-cost"));
  let input = nothing?(offered) ? "nothing" : "[recipe(\"training-cost.values\")(node(\"" + ftv-coord(offered[1]) + "\"))," + json-emit-precise(oh-get(request, "budgets_gib")) + "," + json-emit-precise(oh-get(request, "ridge")) + "," + json-emit-precise(oh-get(request, "headroom")) + "]";
  let result = nothing?(offered) || !ftv-starts?(imported, "value=") ? fmc-result(owner, "nothing", "training-cost-input-unavailable", nothing(), 0, "") : fmc-token(owner, "recipe-exec", "training-cost.plan;input=" + input + ";carrier=form");
  let released = fmc-release(owner);
  let report = json-node-object([oh-s("status", result[0]), json-node-pair("request", request), json-node-pair("input", nothing?(offered) ? json-node-null() : offered[2]), json-node-pair("result", fmc-value-node(result[2])), oh-s("source_observation", fmc-render(result)), oh-n("release_ok", released), json-node-pair("execution", fmc-evidence(owner))]);
  oh-voice(oh-reading("training-cost", oh-str(request, "events"), "plan", json-node-string("observed fits, admissible plans and complete release"), report, json-node-int(result[0] == "value" && released), result[0] == "value" && released ? [] : [oh-need("inspect-training-cost-observation", report)], ["revise-input", "offer-current-events"], report));
  print_str(frw-emit(frb-of-node(report)));
  result[0] == "value" && released ? 1 : nothing();
 }
 def tcr-request() = tcr-request-of(frw-options(stdin-text() ?? ""));
 def tcr-request-of(r) = (String) r[0] == "ok" ? frb-to-node(r[1]) : form_error("training-cost-run: the options were refused at line " ++ r[2].str() ++ ": " ++ r[1]);
 tcr-run(tcr-request());
}
