; voice-onnx-run.fk — what a voice model actually holds, read by the body itself.
;
; Point it at any of the twenty-nine voices under the voice store (write the voice's
; name into /tmp/voice-onnx-target, or take the default) and it opens the file the way
; the ear opens a .npz: no onnxruntime, no protobuf library, no python. It answers the
; model's identity, its tensor table, the doors it eats and answers through, the voice's
; own configuration, and — the part a next hand needs most — the census of the 2755
; nodes: which OPERATORS the graph is written in, and which PART of the voice each node
; belongs to, counted from the names the export itself wrote.
;
; The operator census is the map of what a native pass owes. Nothing here claims a kernel
; exists for any of them; it names the work.
; preludes: form/form-stdlib/voice-native.bml
(do
    (defn vr-default () "en_GB-jenny_dioco-medium")
    (defn vr-target ()
        (do (let t (read_file "/tmp/voice-onnx-target"))
            (if (nothing? t) (vr-default) (if (eq (str_len (trim t)) 0) (vr-default) (trim t)))))
    (defn vr-line (k v) (print (str_concat k (str_concat "  " v))))
    (defn vr-top-go (rows n acc) (if (le n 0) acc (if (eq (len rows) 0) acc (vr-top-go (tail rows) (sub n 1) (str_concat acc (str_concat "    " (str_concat (vo-row-text (head rows)) (vo-nl))))))))

    (let voice (vr-target))
    (let p (vp-model-path voice))
    (let ok (vo-model? p))
    (print (str_concat "voice  " voice))
    (if (eq ok 1)
        (do
            (let cfg (vp-cfg voice))
            (let rows (vo-inits p))
            (vr-line "producer" (str_concat (vo-producer p) (str_concat " ir " (int_to_str (vo-ir p)))))
            (vr-line "tongue" (str_concat (vp-language cfg) (str_concat "  phonemes by " (vp-phoneme-type cfg))))
            (vr-line "audio" (str_concat (int_to_str (vp-sample-rate cfg)) (str_concat " Hz, speakers " (int_to_str (vp-num-speakers cfg)))))
            (vr-line "symbols" (str_concat (int_to_str (vp-num-symbols cfg)) (str_concat ", id table " (int_to_str (vp-table-size (vp-map cfg))))))
            (vr-line "tensors" (str_concat (int_to_str (len rows)) (str_concat ", sound " (int_to_str (vo-sound-count rows)))))
            (vr-line "weights" (str_concat (int_to_str (vo-param-sum rows)) (str_concat " values in " (str_concat (int_to_str (vo-byte-sum rows)) " bytes"))))
            (print "")
            (print "  eats")
            (print (vo-io-text (vo-inputs p)))
            (print "  answers")
            (print (vo-io-text (vo-outputs p)))
            (print "  largest tensors, in file order")
            (print (vr-top-go rows 6 ""))
            (print "  the voice's parts, by node count")
            (print (vo-census-text (vo-part-census p)))
            (print "  and by weight bytes — where the program is is not where the numbers are.")
            (print "  \"(loose)\" is not a leftover: it is every tensor the export RENAMED when it fused")
            (print "  weight-norm into the convolution, which strips the module path off the flow's own")
            (print "  weights (sixteen 384x192x5 kernels arriving as onnx::Conv_NNNN). A hand mapping")
            (print "  tensors back to modules must go by shape and graph position, not by name.")
            (print (vo-census-text (vo-weight-parts rows)))
            (print (str_concat "  the operators a native pass owes — " (str_concat (int_to_str (vo-node-count p)) " nodes")))
            (print (vo-census-text (vo-op-census p)))
            (print "  native today: the model read, the voice's configuration, the phoneme->id row,")
            (print "  and the text encoder's first stage (embedding lookup and the model's own scale).")
            (print "  still crossing: letters->phonemes (espeak-ng and three per-tongue g2p engines),")
            (print "  and the pass from the encoder's first stage to samples.")
            0)
        (do (print "  not a model — its fields do not tile the file, so no table is offered")
            0))
)
