// Motion readings inherit routing from the shared sensor organ.
// preludes: form-stdlib/motion-sense.fk observe/sensor-organ-template.fk
section [form.bml] {
 class MotionSenseOrgan {
  def motion-organ() = so-organ("motion","motion","accelerometer");
  def ms-feature(sample) = ms-direction(nth(sample,0),nth(sample,1));
  def motion-route(sample,confidence) = so-route(motion-organ(),ms-feature,sample,confidence);
 }
 0;
}
