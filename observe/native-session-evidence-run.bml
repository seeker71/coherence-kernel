// Attend to the current learner's needs using retained verified memory.
// Optional stdin is a session home; normal workers attend during their drain.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-evidence.bml
section [form.bml] {
 class NativeSessionEvidenceRun {
  def nser-run() {
   let input = read_line(); let home = if or(nothing?(input),str_eq(input,"")) then hearth-session-learning() else input;
   if nsm-running(home) then print_str("care-owned-by-running-learner") else print_str(json-emit-precise(nse-attend(home)));
  }
 }
 nser-run();
}
