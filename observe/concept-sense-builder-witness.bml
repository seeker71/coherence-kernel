// Full source and private publication witness; stdin names the local dictionary.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/concept-sense-builder-witness.bml
section [form.bml] {
 class ConceptSenseWitnessRun {
  def csww-home() {
   let text = read_line();
   if not(jwa-valid(text)) then csa-input-refused("sense witness requires one JSON dict field") else 0;
   let request = parse-json("concept-sense-witness-request",text);
   if not(node_eq(node_category(request),JSON-OBJECT())) then csa-input-refused("sense witness object required") else 0;
   let pairs = json-object-pairs(request);
   if not(and(eq(len(pairs),1),and(str_eq(json-pair-key(head(pairs)),"dict"),eq(node_type(json-pair-value(head(pairs))),2)))) then csa-input-refused("one string dict field required") else 0;
   let dict = json-string-value(json-object-get(request,"dict"));
   if not(ctsb-host-path?(dict)) then csa-input-refused("complete dictionary path required") else 0;
   csw-run(dict);
  }
 }
 csww-home();
}
