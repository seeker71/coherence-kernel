// JSON request on stdin; emits one structured JSON result.
// A kernel-level qlhb/Metal throw remains a process-failure boundary because
// BML provides no exception/finally recovery. Ordinary refusals are returned.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/qwen-lora-learning.bml
section [form.bml] {
 let source = read_line();
 let result = qll-run-source(source);
 print_str(json-emit-precise(result));
 if qll-value(result,"ok") then 1 else form_error(fcap-string(result,"reason"));
}
