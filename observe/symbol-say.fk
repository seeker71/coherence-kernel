; symbol-say.fk — every stdin line of symbols becomes one natural-language
; line, expanded by the body from its own vocabulary at no rented cost.
;   echo 'us DO offer:thrice admit* folded* heard:42 | teaching farside' | ./fkwu observe/symbol-say.fk
; preflight-exec: forbidden
; preludes: form/form-stdlib/symbol-voice.bml
(do
    (defn ss-lines () (do (let l (read_line)) (if (nothing? l) 0 (do (print_str (str_concat (sv-say (trim l)) "\n")) (ss-lines)))))
    (ss-lines))
