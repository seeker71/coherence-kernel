//////////////////////////////////////////////////////////////////////
//
// autopoietic-pulse-run.bml
//
// Executable BML. The runnable door for observe/autopoietic-pulse.fk:
// the body observes itself with its own organs and writes INDEX.md,
// re-observing until the page it writes is the page it reads back.
//
//   ./fkwu observe/autopoietic-pulse-run.bml
//
// prints  autopoietic-pulse verdict=<v> stable=<s>
// and answers <v>: 2 portrayed and coherent, 1 unportrayed,
// 0 drifted, -3 the write was refused, -4 it did not settle.
//
// preludes: observe/autopoietic-pulse.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormAutopoieticPulseRun {
        thought autopoietic-pulse-run-pattern = list("observe-then-write", "write-then-reobserve", "fixed-point-is-the-portrait");

        def aprr-line(verdict, stable) = str_concat("autopoietic-pulse verdict=", str_concat(int_to_str(verdict), str_concat(" stable=", int_to_str(stable))));
        def aprr-report() {
            let v = ap-tend();
            print(aprr-line(v, ap-stable?()));
            v;
        }
    }
    aprr-report();
}
