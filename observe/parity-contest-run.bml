// parity-contest-run.bml — one contest of docs/single-call-parity-goal.form,
// walked by the body with no rented mind between the doors.
//
// It answers the goal's pinned enquiry with one form-cli call (native
// grounding, then the in-process model at rent 0, else one provider turn when
// this request allows it), reads the structural floor on that answer and on
// the guided flow's reference answer, reads rent and the calls that left the
// body, and appends one row to receipts/parity-contest-ledger.jsonl with the
// verdict flags the goal's exit proof reads: floor_parity, rent_under_1pct,
// zero_non_form. The person's reading of both answers enters the row as
// "pending" and is recorded by the person, never inferred here.
//
// The guided reference is pinned: the receipt that answered the enquiry as a
// guided flow, its own floor row of rent and calls (through provider call 21).
//
// stdin, optional: {"movement":"<name>","provider":{"allowed":1},"oracle":1,
//                   "effort":"low","opening_bytes":400}
// effort rides to the provider as its own flag (low, medium, high) and empty
// leaves the provider's default; opening_bytes bounds each receipt's opening
// in the packet. Both land in the row so their cost can be read.
// With empty stdin the provider is not asked, so an unattended contest can
// never spend rent by itself; the row then records what the body could do alone.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml observe/answer-parity-check.fk
section [form.bml] {
 class ParityContest {
  def pc-enquiry-path() = "receipts/artifacts/2026-09-18-form-cli-enquiry.txt";
  def pc-terms() = "quality volume frequency vitality trust traceability sovereignty resonance rented membrane";
  def pc-guided-answer() = "receipts/2026-09-18-direct-vs-guided-form-cli.md";
  def pc-guided-rent() = 2544568;
  def pc-guided-non-form() = 78;
  def pc-ledger() = "receipts/parity-contest-ledger.jsonl";
  def pc-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def pc-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def pc-request(options) = json-node-object(list(
   fhn-s("enquiry", read_file(pc-enquiry-path())),
   fhn-s("terms", pc-terms()),
   fhn-n("seconds", 600),
   fhn-n("receipts", 8),
   fhn-n("oracle", if json-object-has?(options, "oracle") then pc-int(options, "oracle") else 1),
   fhn-s("effort", pc-str(options, "effort")),
   fhn-n("opening_bytes", if json-object-has?(options, "opening_bytes") then pc-int(options, "opening_bytes") else 400),
   json-node-pair("provider", if json-object-has?(options, "provider") then json-object-get(options, "provider") else json-node-object(list(fhn-n("allowed", 0))))));
  def pc-floor(path) = apc-floor(apc-text(path));
  def pc-ge?(single, guided, i) = ge(nth(single, i), nth(guided, i));
  def pc-floor-parity(single, guided) = if and(pc-ge?(single, guided, 0), and(pc-ge?(single, guided, 2), pc-ge?(single, guided, 3))) then 1 else 0;
  def pc-non-form(report) = pc-int(report, "provider_turns");
  def pc-row(options, report, single, guided) {
   let rent = pc-int(report, "rent_tokens");
   let nonForm = pc-non-form(report);
   json-node-object(list(
    fhn-n("at_unix_ms", now_unix_ms()),
    fhn-s("movement", if json-object-has?(options, "movement") then pc-str(options, "movement") else "parity-contest"),
    fhn-s("enquiry", pc-enquiry-path()),
    fhn-s("single_source", pc-str(report, "source")),
    fhn-s("single_oracle", pc-str(report, "oracle")),
    fhn-s("single_answer", pc-str(report, "answer")),
    fhn-n("single_rent_tokens", rent),
    fhn-n("single_thinking_tokens", pc-int(report, "thinking_tokens")),
    fhn-n("single_provider_attempts", pc-int(report, "provider_attempts")),
    fhn-s("single_effort", pc-str(report, "effort")),
    fhn-n("single_opening_bytes", pc-int(report, "opening_bytes")),
    fhn-n("single_packet_bytes", pc-int(report, "packet_bytes")),
    fhn-n("single_non_form_calls", nonForm),
    fhn-n("single_axes", nth(single, 0)),
    fhn-n("single_receipts_cited", nth(single, 1)),
    fhn-n("single_receipts_existing", nth(single, 2)),
    fhn-n("single_limits", nth(single, 3)),
    fhn-n("single_bytes", nth(single, 4)),
    fhn-s("guided_answer", pc-guided-answer()),
    fhn-n("guided_rent_tokens", pc-guided-rent()),
    fhn-n("guided_non_form_calls", pc-guided-non-form()),
    fhn-n("guided_axes", nth(guided, 0)),
    fhn-n("guided_receipts_cited", nth(guided, 1)),
    fhn-n("guided_receipts_existing", nth(guided, 2)),
    fhn-n("guided_limits", nth(guided, 3)),
    fhn-n("guided_bytes", nth(guided, 4)),
    fhn-n("floor_parity", pc-floor-parity(single, guided)),
    fhn-n("rent_ratio_bps", div(mul(rent, 10000), pc-guided-rent())),
    fhn-n("rent_under_1pct", if lt(mul(rent, 100), pc-guided-rent()) then 1 else 0),
    fhn-n("zero_non_form", if eq(nonForm, 0) then 1 else 0),
    fhn-s("reading", "pending"),
    fhn-s("evidence", pc-str(report, "evidence"))));
  }
  def pc-run() {
   let line0 = read_line();
   let line = if nothing?(line0) then "" else trim(line0);
   let options = if str_eq(line, "") then json-node-object(list()) else parse-json("parity-contest-options", line);
   let report = fgs-answer(pc-request(options));
   let single = pc-floor(pc-str(report, "answer"));
   let guided = pc-floor(pc-guided-answer());
   let row = pc-row(options, report, single, guided);
   let appended = fhn-append(pc-ledger(), str_concat(json-emit(row), "\n"));
   print_str(json-emit-precise(json-node-object(list(json-node-pair("row", row), fhn-s("ledger", appended)))));
  }
 }
 pc-run();
}
