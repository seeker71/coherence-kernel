; Read current RAG state and the resident's actual liveness. No inference or training.
; preludes: form-stdlib/bml/form-local-autonomy-report.bml
(do
 (let result (flar-ground (read_line)))
 (let destination (read_line))
 (if (or (nothing? destination) (str_eq destination "")) 0 (nsm-write destination result))
 (print_str (json-emit-precise result))
 0)
