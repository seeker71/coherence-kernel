// form-eval.fk — the source tree-walk, in Form, on the BMF cursor: Form source string -> value, evaluated AS it
// is read, with NO flatten table. This dissolves the flatten knot: running a recipe no longer REQUIRES flattening —
// the cursor reads and computes directly; flatten becomes optional SPEED (the JIT path). Mirrors form-parse.fk's
// recursive-descent over the cursor (no tokenizer, the BMF discipline), but each node returns its VALUE not a cell.
//
// Grammar form-eval now evaluates (a real meta-circular core + STRING/LIST/FLOAT values):
//   expr   := integer | float | string | symbol | '(' form ')'
//   float  := a number literal carrying '.' or 'e'/'E'  -> (str_to_float <literal-text>)
//   string := '"' ... '"'  (escapes \n \" \\ handled)   -> the literal's inner text
//   form   := (op a b)            op in {add,sub,mul,div,mod,le,lt,gt,ge,eq}   ; binary builtins (float-aware)
//           | (if c t e)                                                       ; conditional
//           | (let name val body)                                             ; lexical binding
//           | (defn name (params...) body)                                    ; register a function
//           | (do e1 e2 ...)                                                   ; sequence, threading env
//           | (prim arg...)        prim a STRING/LIST kernel op               ; variadic, applied by name (fe-prim)
//           | (fname arg...)        fname a user-defined function             ; THE meta-circular call
//   symbol := lookup in the environment (a var bound by let, or an arg bound at a call)
//
// STRING/LIST/FLOAT values are OPAQUE to form-eval: a string/list/float value passes straight through the
// (value end-pos env) triple; the kernel primitive (str_concat, head, str_to_float, ...) does the work. The new
// work is mostly PARSING — fe-expr2 branches on '"' (fe-str) and on a float-marker inside a number (fe-num); the
// new ops route through fe-prim (collect args -> fe-prim-apply by name). String prims: str_concat str_eq substring
// str_len str_byte_at str_to_float ; list prims: list cons head tail empty nth len.
//
// State threads as (value, end-pos, env). The ENV is the new thread: an assoc-list of bindings, each a cons-chain
// cell terminated by integer 0 (our nil). Two entry kinds: variable (list name 0 value), and function
// (list name 1 params body-pos) — params is a list of name-strings, body-pos the source position of the body expr,
// re-evaluated under (current-env + arg bindings) on each call so a defn sees ITSELF (recursion is free).
// This is the milestone: a recipe with a user-defined function — (do (defn f (n) (add n 1)) (f 5)) — runs THROUGH
// the Form walker on the c-bootstrapped fkwu kernel, integers all the way down, no host interpreter.
//
// Proven on fkwu by grammars/tests/form-eval-band.fk (verdict 65535 — sixteen claims: 1..512 the meta-circular core,
// 1024..32768 the STRING/LIST/FLOAT value kinds; the user-call milestone is claim 64).
//
import form-stdlib/core.fk;
section [form.bml] {
    // --- result triples (value end-pos env) ---
    def fe-fst(pr) = pr[0];
    def fe-snd(pr) = pr[1:][0];
    def fe-thd(pr) = pr[1:][1:][0];
    // --- env: assoc-list, cons-chained, 0-terminated ---
    def fe-emp() = 0;
    def fe-var(nm, vl) = [nm, 0, vl];
    def fe-fn(nm, params, bodypos) = [nm, 1, params, bodypos];
    def fe-e-nm(e) = e[0];
    def fe-e-kind(e) = e[1:][0];
    def fe-e-a(e) = e[1:][1:][0];
    def fe-e-b(e) = e[1:][1:][1:][0];
    def fe-bind(env, e) = cons(e, env);
    def fe-look(env, nm) = (Comparable) env == 0 ? 0 : (String) fe-e-nm(env[0]) == nm ? env[0] : fe-look(env[1:], nm);
    // --- cursor primitives over the source string ---
    def fe-at(s, pos) = ord(char_at(s, pos));
    def fe-len(s) = len(s);
    def fe-isdigit(c) = c >= 48 && 57 >= c;
    def fe-isws(c) = (Comparable) c == 32 ? 1 : (Comparable) c == 10 ? 1 : (Comparable) c == 13 ? 1 : (Comparable) c == 9 ? 1 : 0;
    def fe-isdelim(c) = (Comparable) fe-isws(c) == 1 ? 1 : (Comparable) c == 40 ? 1 : (Comparable) c == 41 ? 1 : 0;
    def fe-skip(s, pos) = pos >= fe-len(s) ? pos : (Comparable) fe-isws(fe-at(s, pos)) == 1 ? fe-skip(s, (Number) pos + (Number) 1) : pos;
    def fe-digits(s, pos, acc) = pos >= fe-len(s) ? [acc, pos] : fe-isdigit(fe-at(s, pos)) ? fe-digits(s, (Number) pos + (Number) 1, (Number) (acc * 10) + (Number) (fe-at(s, pos) - 48)) : [acc, pos];
    def fe-sym-end(s, pos) = pos >= fe-len(s) ? pos : (Comparable) fe-isdelim(fe-at(s, pos)) == 1 ? pos : fe-sym-end(s, (Number) pos + (Number) 1);
    // advance past a closing ')' (with leading ws) — list terminator
    def fe-close(s, pos) = fe-skip(s, pos) >= fe-len(s) ? fe-skip(s, pos) : (Number) fe-skip(s, pos) + (Number) 1;
    // --- expr := integer | float | string | symbol | '(' form ')' ; returns (value end-pos env) ---
    //   '"' (char 34) opens a STRING literal; a number literal carrying '.' or 'e'/'E' is a FLOAT literal.
    def fe-expr(s, pos, env) = fe-expr2(s, fe-skip(s, pos), env);
    def fe-expr2(s, pos, env) = (Comparable) fe-at(s, pos) == 40 ? fe-form(s, (Number) pos + (Number) 1, env) : (Comparable) fe-at(s, pos) == 34 ? fe-str(s, pos, env) : fe-isdigit(fe-at(s, pos)) ? fe-num(s, pos, env) : fe-sym(s, pos, env);
    // number literal: scan the whole token; if it carries '.' / 'e' / 'E' it is a FLOAT (str_to_float the
    // literal text), else an INTEGER (the existing digit-fold). Both return (value end-pos env).
    def fe-num(s, pos, env) = fe-num2(s, pos, fe-sym-end(s, pos), env);
    def fe-num2(s, a, b, env) = (Comparable) fe-isfloat(s, a, b) == 1 ? [str_to_float(substring(s, a, b)), b, env] : fe-int(s, a, env);
    // does the token s[a..b) contain a float marker ('.' 46 | 'e' 101 | 'E' 69) ?
    def fe-isfloat(s, a, b) = a >= b ? 0 : (Comparable) fe-at(s, a) == 46 ? 1 : (Comparable) fe-at(s, a) == 101 ? 1 : (Comparable) fe-at(s, a) == 69 ? 1 : fe-isfloat(s, (Number) a + (Number) 1, b);
    def fe-int(s, pos, env) = fe-int2(fe-digits(s, pos, 0), env);
    def fe-int2(d, env) = [fe-fst(d), fe-snd(d), env];
    // --- string literal: from the opening '"' at pos, scan to the closing '"'; the VALUE is the
    //     literal's inner text (substring of the source). Escapes (\" \\ \n) are handled minimally —
    //     see fe-str-end / fe-str-val. end-pos advances past the closing quote. ---
    def fe-str(s, pos, env) = fe-str2(s, (Number) pos + (Number) 1, fe-str-end(s, (Number) pos + (Number) 1), env);
    // end of the literal's inner text: index of the closing '"' (34), skipping escaped chars.
    def fe-str-end(s, i) = i >= fe-len(s) ? i : (Comparable) fe-at(s, i) == 34 ? i : (Comparable) fe-at(s, i) == 92 ? fe-str-end(s, (Number) i + (Number) 2) : fe-str-end(s, (Number) i + (Number) 1);
    // value = unescaped inner text [a..b); end-pos = b+1 (past the closing quote)
    def fe-str2(s, a, b, env) = [fe-unesc(s, a, b, ""), (Number) b + (Number) 1, env];
    // build the unescaped string by walking [i..b): '\' introduces an escape (\n -> LF, \" -> ", \\ -> \,
    // any other escaped char passes through literally). No-escape source returns its own substring.
    def fe-unesc(s, i, b, acc) = i >= b ? acc : (Comparable) fe-at(s, i) == 92 ? fe-unesc(s, (Number) i + (Number) 2, b, ((String) acc + fe-esc-ch(fe-at(s, (Number) i + (Number) 1)))) : fe-unesc(s, (Number) i + (Number) 1, b, ((String) acc + substring(s, i, (Number) i + (Number) 1)));
    def fe-esc-ch(c) = (Comparable) c == 110 ? "\n" : (Comparable) c == 34 ? "\"" : (Comparable) c == 92 ? "\\" : "?";
    def fe-sym(s, pos, env) = fe-sym2(s, pos, fe-sym-end(s, pos), env);
    def fe-sym2(s, a, b, env) = [fe-e-a(fe-look(env, substring(s, a, b))), b, env];
    // --- form := dispatch on the head symbol ---
    def fe-form(s, pos, env) = fe-head(s, fe-skip(s, pos), env);
    def fe-head(s, pos, env) = fe-disp(substring(s, pos, fe-sym-end(s, pos)), s, fe-sym-end(s, pos), env);
    def fe-disp(op, s, pos, env) = (String) op == "if" ? fe-if(s, pos, env) : (String) op == "let" ? fe-let(s, pos, env) : (String) op == "do" ? fe-do(s, pos, env) : (String) op == "defn" ? fe-defn(s, pos, env) : fe-isbuiltin(op) ? fe-bin(op, s, pos, env) : fe-isprim(op) ? fe-prim(op, s, pos, env) : fe-call(op, s, pos, env);
    def fe-isbuiltin(op) = (String) op == "add" ? 1 : (String) op == "sub" ? 1 : (String) op == "mul" ? 1 : (String) op == "div" ? 1 : (String) op == "mod" ? 1 : (String) op == "le" ? 1 : (String) op == "lt" ? 1 : (String) op == "gt" ? 1 : (String) op == "ge" ? 1 : (String) op == "eq" ? 1 : 0;
    // primitive (string/list/float) kernel ops — variadic-arity, collected then applied by name.
    def fe-isprim(op) = (String) op == "str_concat" ? 1 : (String) op == "str_eq" ? 1 : (String) op == "substring" ? 1 : (String) op == "str_len" ? 1 : (String) op == "str_byte_at" ? 1 : (String) op == "str_to_float" ? 1 : (String) op == "list" ? 1 : (String) op == "cons" ? 1 : (String) op == "head" ? 1 : (String) op == "tail" ? 1 : (String) op == "empty" ? 1 : (String) op == "nth" ? 1 : (String) op == "len" ? 1 : 0;
    // --- binary builtin: (op a b) ---
    def fe-bin(op, s, pos, env) = fe-bin-a(op, s, fe-expr(s, pos, env));
    def fe-bin-a(op, s, ae) = fe-bin-b(op, s, fe-fst(ae), fe-expr(s, fe-snd(ae), fe-thd(ae)));
    def fe-bin-b(op, s, a, be) = [fe-apply(op, a, fe-fst(be)), fe-close(s, fe-snd(be)), fe-thd(be)];
    def fe-apply(op, a, b) = (String) op == "add" ? (Number) a + (Number) b : (String) op == "sub" ? a - b : (String) op == "mul" ? a * b : (String) op == "div" ? a / b : (String) op == "mod" ? a % b : (String) op == "le" ? a <= b ? 1 : 0 : (String) op == "lt" ? a < b ? 1 : 0 : (String) op == "gt" ? a > b ? 1 : 0 : (String) op == "ge" ? a >= b ? 1 : 0 : (String) op == "eq" ? (Comparable) a == b ? 1 : 0 : 0;
    // --- primitive (string / list / float) ops: (op arg...) — variadic-arity.
    //     Collect ALL args into a value-list (the same cons-chain fe-args builds for user calls), then
    //     apply the kernel op by name, pulling positional args by head/tail. The values are OPAQUE to
    //     form-eval — a string value, list value, or float value passes straight through (value end-pos env). ---
    def fe-prim(op, s, pos, env) = fe-prim-fin(op, s, fe-args(s, pos, env));
    def fe-prim-fin(op, s, av) = [fe-prim-apply(op, fe-fst(av)), fe-snd(av), fe-thd(av)];
    // positional arg accessors over the collected value-list
    def fe-a0(vs) = vs[0];
    def fe-a1(vs) = vs[1:][0];
    def fe-a2(vs) = vs[1:][1:][0];
    def fe-prim-apply(op, vs) = (String) op == "list" ? vs : (String) op == "empty" ? empty() : (String) op == "str_concat" ? ((String) fe-a0(vs) + fe-a1(vs)) : (String) op == "str_eq" ? (String) fe-a0(vs) == fe-a1(vs) ? 1 : 0 : (String) op == "substring" ? substring(fe-a0(vs), fe-a1(vs), fe-a2(vs)) : (String) op == "str_len" ? len(fe-a0(vs)) : (String) op == "str_byte_at" ? str_byte_at(fe-a0(vs), fe-a1(vs)) : (String) op == "str_to_float" ? str_to_float(fe-a0(vs)) : (String) op == "cons" ? cons(fe-a0(vs), fe-a1(vs)) : (String) op == "head" ? fe-a0(vs)[0] : (String) op == "tail" ? fe-a0(vs)[1:] : (String) op == "nth" ? nth(fe-a0(vs), fe-a1(vs)) : (String) op == "len" ? len(fe-a0(vs)) : 0;
    // --- conditional: (if c t e) — evaluate c, then only the taken branch must be evaluated for value,
    //     but we evaluate both arms for position to find the close (pure walk, no host short-circuit needed
    //     for correctness here since arms are pure). We thread the cond's env into both arms. ---
    // SHORT-CIRCUIT is load-bearing: only the taken arm is evaluated, the other is merely SKIPPED for position.
    // (Without this a recursive (if base 0 (recur)) never terminates — the dead arm would recurse forever.)
    def fe-if(s, pos, env) = fe-if-c(s, fe-expr(s, pos, env));
    def fe-if-c(s, ce) = fe-if-arms(s, fe-fst(ce), fe-snd(ce), fe-thd(ce));
    def fe-if-arms(s, c, tpos, env) = (Comparable) c == 0 ? fe-if-pick(s, env, fe-skip-expr(s, tpos)) :     // cond false: then-end is else-start
fe-if-then(s, env, fe-expr(s, tpos, env));
    // cond true: eval then, then skip else
    // cond true: te = (val then-end env'); skip the else arm; close past the if's ')'
    def fe-if-then(s, env, te) = [fe-fst(te), fe-close(s, fe-skip-expr(s, fe-snd(te))), fe-thd(te)];
    // cond false: evaluate the else arm (which begins at epos), close past the if's ')'
    def fe-if-pick(s, env, epos) = fe-if-else(s, fe-expr(s, epos, env));
    def fe-if-else(s, ee) = [fe-fst(ee), fe-close(s, fe-snd(ee)), fe-thd(ee)];
    // --- let: (let name val body) — bind name to val, eval body in the extended env,
    //     return body's value; the binding does NOT escape (env returned is the original). ---
    def fe-let(s, pos, env) = fe-let-nm(s, fe-skip(s, pos), env);
    def fe-let-nm(s, pos, env) = fe-let-v(s, fe-sym-end(s, pos), substring(s, pos, fe-sym-end(s, pos)), env);
    def fe-let-v(s, pos, nm, env) = fe-let-b(s, nm, env, fe-expr(s, pos, env));
    def fe-let-b(s, nm, env, ve) = fe-let-fin(s, env, fe-expr(s, fe-snd(ve), fe-bind(env, fe-var(nm, fe-fst(ve)))));
    // after the body we sit at the body's end; advance past the let's own ')'; binding does NOT escape (env0).
    def fe-let-fin(s, env0, be) = [fe-fst(be), fe-close(s, fe-snd(be)), env0];
    // --- do: (e1 e2 ... ) — evaluate each child threading env child-to-child, value is the last child's. ---
    def fe-do(s, pos, env) = fe-do-loop(s, fe-skip(s, pos), env, 0);
    def fe-do-loop(s, pos, env, last) = (Comparable) fe-at(s, pos) == 41 ? [last, (Number) pos + (Number) 1, env] : fe-do-step(s, fe-expr(s, pos, env));
    def fe-do-step(s, ce) = fe-do-loop(s, fe-skip(s, fe-snd(ce)), fe-thd(ce), fe-fst(ce));
    // --- defn: (defn name (params...) body) — register a function entry, skip the body, extend env. ---
    def fe-defn(s, pos, env) = fe-defn-nm(s, fe-skip(s, pos), env);
    def fe-defn-nm(s, pos, env) = fe-defn-p(s, fe-sym-end(s, pos), substring(s, pos, fe-sym-end(s, pos)), env);
    // params list begins at '(' ; collect param name-strings
    def fe-defn-p(s, pos, nm, env) = fe-defn-b(s, nm, fe-params(s, (Number) fe-skip(s, pos) + (Number) 1), env);
    // body begins right after the params ')' ; we DON'T evaluate it now — store its position
    def fe-defn-b(s, nm, pe, env) = fe-defn-fin(s, nm, fe-fst(pe), fe-skip(s, fe-snd(pe)), env);
    def fe-defn-fin(s, nm, params, bodypos, env) = [0, fe-close(s, fe-skip-expr(s, bodypos)), fe-bind(env, fe-fn(nm, params, bodypos))];
    // collect param names until ')' ; returns (params-list end-pos)
    def fe-params(s, pos) = (Comparable) fe-at(s, fe-skip(s, pos)) == 41 ? [0, (Number) fe-skip(s, pos) + (Number) 1] : fe-params-step(s, fe-skip(s, pos));
    def fe-params-step(s, pos) = fe-params-cons(substring(s, pos, fe-sym-end(s, pos)), fe-params(s, fe-sym-end(s, pos)));
    def fe-params-cons(nm, rest) = [cons(nm, fe-fst(rest)), fe-snd(rest)];
    // --- skip an expression (no eval) — needed to find a defn body's end without evaluating it.
    //     Returns the end-pos just past the expression. ---
    def fe-skip-expr(s, pos) = fe-skip-expr2(s, fe-skip(s, pos));
    // a string literal is skipped to just past its closing '"'; a number (int OR float) ends at the next
    // delimiter (fe-sym-end carries '.' 'e' 'E'); a symbol likewise. '"' must be checked before the
    // number/symbol cases since fe-sym-end would stop at whitespace INSIDE a quoted string.
    def fe-skip-expr2(s, pos) = (Comparable) fe-at(s, pos) == 40 ? fe-skip-list(s, (Number) pos + (Number) 1) : (Comparable) fe-at(s, pos) == 34 ? (Number) fe-str-end(s, (Number) pos + (Number) 1) + (Number) 1 : fe-sym-end(s, pos);
    def fe-skip-list(s, pos) = (Comparable) fe-at(s, fe-skip(s, pos)) == 41 ? (Number) fe-skip(s, pos) + (Number) 1 : fe-skip-list(s, fe-skip-expr(s, fe-skip(s, pos)));
    // --- user call: (fname arg...) — look up fn, evaluate args, bind to params, eval body. ---
    def fe-call(op, s, pos, env) = fe-call-f(op, env, fe-look(env, op), s, pos, env);
    def fe-call-f(op, env, fn, s, pos, callenv) = fe-call-a(fn, s, fe-args(s, pos, callenv), callenv);
    // fe-args collects (arg-values-list end-pos env) — env threads through arg eval
    def fe-args(s, pos, env) = (Comparable) fe-at(s, fe-skip(s, pos)) == 41 ? [0, (Number) fe-skip(s, pos) + (Number) 1, env] : fe-args-step(s, fe-expr(s, pos, env));
    def fe-args-step(s, ae) = fe-args-cons(fe-fst(ae), fe-args(s, fe-snd(ae), fe-thd(ae)));
    def fe-args-cons(v, rest) = [cons(v, fe-fst(rest)), fe-snd(rest), fe-thd(rest)];
    // bind params to arg values atop the call env, then eval the body at the stored position
    def fe-call-a(fn, s, av, callenv) = fe-call-b(fn, s, fe-fst(av), fe-snd(av), callenv);
    def fe-call-b(fn, s, args, endpos, callenv) = [fe-fst(fe-expr(s, fe-e-b(fn), fe-zip(fe-e-a(fn), args, callenv))), endpos, callenv];
    // zip params (name-list) with args (value-list) into env entries
    def fe-zip(params, args, env) = (Comparable) params == 0 ? env : fe-zip(params[1:], args[1:], fe-bind(env, fe-var(params[0], args[0])));
    // --- entry point ---
    def fe-eval(s) = fe-fst(fe-expr(s, 0, fe-emp()));
}
