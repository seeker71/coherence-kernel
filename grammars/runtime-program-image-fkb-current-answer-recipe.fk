; runtime-program-image-fkb-current-answer-recipe.fk -- the production owner
; of one canonical resident program image for current-answer agreement.
;
; The image is recipe-data: a 60-node immutable DAG with one canonical symbol,
; not a flattened runtime table or operations registry.  Its caller supplies
; the already-observed query result.  This cell performs no filesystem lookup,
; model call, HTTP crossing, Metal call, or ambient authority.
;
; preludes: form-stdlib/runtime-program-image-fkb-current-answer-capability.fk
;
; Proven by: form-stdlib/tests/form-cli-current-answer-in-process-band.fk

(do
    (defn rpicr-version ()
        "runtime-program-image-fkb-current-answer-recipe-v1")

    (defn rpicr-nodes ()
        (list
            (pif-node-row 2 0 0 0)
            (pif-node-row 1 0 0 0) (pif-node-row 1 1 0 0)
            (pif-node-row 1 2 0 0) (pif-node-row 1 3 0 0)
            (pif-node-row 1 4 0 0) (pif-node-row 1 5 0 0)
            (pif-node-row 1 6 0 0) (pif-node-row 1 7 0 0)
            (pif-node-row 1 8 0 0) (pif-node-row 1 9 0 0)
            (pif-node-row 1 10 0 0) (pif-node-row 1 11 0 0)
            (pif-node-row 1 12 0 0) (pif-node-row 1 13 0 0)
            (pif-node-row 1 14 0 0) (pif-node-row 1 15 0 0)
            (pif-node-row 23 0 1 0) (pif-node-row 23 0 2 0)
            (pif-node-row 23 0 3 0) (pif-node-row 23 0 4 0)
            (pif-node-row 23 0 5 0) (pif-node-row 23 0 6 0)
            (pif-node-row 23 0 7 0) (pif-node-row 23 0 8 0)
            (pif-node-row 23 0 9 0) (pif-node-row 23 0 10 0)
            (pif-node-row 23 0 11 0) (pif-node-row 23 0 12 0)
            (pif-node-row 23 0 13 0) (pif-node-row 23 0 14 0)
            (pif-node-row 23 0 15 0) (pif-node-row 23 0 16 0)
            (pif-node-row 24 0 0 0)
            (pif-node-row 24 1 0 0)
            (pif-node-row 80 17 18 0)
            (pif-node-row 26 19 20 0)
            (pif-node-row 26 21 22 0)
            (pif-node-row 26 21 33 0)
            (pif-node-row 26 23 24 0)
            (pif-node-row 102 25 26 0)
            (pif-node-row 102 25 2 0)
            (pif-node-row 102 27 28 0)
            (pif-node-row 102 27 2 0)
            (pif-node-row 102 29 30 0)
            (pif-node-row 102 29 2 0)
            (pif-node-row 26 31 32 0)
            (pif-node-row 26 31 34 0)
            (pif-node-row 42 35 36 0)
            (pif-node-row 42 48 37 0)
            (pif-node-row 42 49 38 0)
            (pif-node-row 42 50 39 0)
            (pif-node-row 42 51 40 0)
            (pif-node-row 42 52 41 0)
            (pif-node-row 42 53 42 0)
            (pif-node-row 42 54 43 0)
            (pif-node-row 42 55 44 0)
            (pif-node-row 42 56 45 0)
            (pif-node-row 42 57 46 0)
            (pif-node-row 42 58 47 0)))

    (defn rpicr-string-rows ()
        (list (list 104 105 116)
              (list 99 104 111 105 99 101 44 99 117 116 44
                    114 101 108 101 97 115 101)))

    (defn rpicr-table ()
        (pif-table-image 1 (list 59) 60 (rpicr-nodes)
            2 (rpicr-string-rows)))

    (defn rpicr-symbol-image ()
        (pif-symbol-image 1
            (list (pif-symbol-row 0
                "knowledge/current-answer-outcome-bound"))
            1 (list (pif-node-symbol-row 59 0 (empty)))))

    (defn rpicr-pif ()
        (pif-envelope-with-symbols
            "form/form-stdlib/runtime-program-image-fkb-current-answer-recipe.fk"
            "sha:resident-current-answer-recipe-source"
            1
            "resident:knowledge/current-answer-outcome-bound"
            "sha:resident-current-answer-recipe-content"
            1 1 (rpicr-table) (rpicr-symbol-image)))

    (defn rpicr-envelope ()
        (do
            (let pif (rpicr-pif))
            (let source (pif-source-from-envelope pif))
            (let fkb (pif-descriptor-from-envelope pif))
            (rale-envelope-from-selection source fkb (sad-no-artifact)
                (ras-selection-from-plan
                    (rap-plan-from-descriptors
                        source fkb (sad-no-artifact))))))

    (defn rpicr-admission ()
        (do
            (let pif (rpicr-pif))
            (let payload
                (pifbd-payload
                    (pif-envelope-source-path pif)
                    (pif-envelope-source-hash pif)
                    (pif-envelope-source-mtime pif)
                    (pif-envelope-artifact-path pif)
                    (pif-envelope-seal-ok pif)
                    (pif-envelope-table pif)
                    (pif-envelope-symbol-image pif)))
            (pifbd-admission
                (list "resident-current-answer-recipe-admission")
                (pifbd-decoded-row payload 1)
                pif (pifbd-status-admitted) (pifbd-reason-admitted))))

    ; This canonical symbol request is the executable recipe identity.  It is
    ; resolved inside the admitted PIF and refuses duplicates; it is not
    ; mislabeled as a new package-31 NodeID while that census is incomplete.
    (defn rpicr-recipe-identity () (rpica-symbol-request))

    (defn rpicr-execution-from-result (result step-budget)
        (rpica-execution-result
            (rpicr-envelope) (rpicr-admission) result step-budget))

    0)
