; runtime-program-image-fkb-current-answer-capability.fk -- admit one
; source-bound current answer and lookup outcome as typed resident PIF data.
;
; The effectful query remains the only filesystem authority.  This adapter
; accepts its canonical result, checks that the result and its 27-child native
; observation describe the same request, source, answer, counters, and
; lifecycle, then reconstructs the independently retained current source node.
; The resident image receives paired typed values and re-witnesses every pair.
;
; Nothing here opens a path, model, HTTP peer, remote provider, Metal carrier,
; flattened table, or generated ops registry.  `nothing` is refusal before a
; walk; a well-typed resident disagreement is present 0; agreement is present
; 1; resident fuel exhaustion has no output and remains timeout.
;
; preludes: form-stdlib/core.fk form-stdlib/form-nodeid-knowledge-query.fk
; preludes: form-stdlib/runtime-program-image-fkb-current-source-capability.fk
; preludes: form-stdlib/runtime-program-image-fkb-symbol-walk.fk
;
; Proven by: form-stdlib/tests/runtime-program-image-fkb-current-answer-capability-band.fk

(do
    (defn rpica-version ()
        "runtime-program-image-fkb-current-answer-capability-v1")

    (defn rpica-feature (name status)
        (list "runtime-program-image-fkb-current-answer-capability-feature"
              name status))
    (defn rpica-feature-name (feature) (nth feature 1))
    (defn rpica-feature-status (feature) (nth feature 2))
    (defn runtime-program-image-fkb-current-answer-capability-manifest ()
        (list
            (rpica-feature "canonical-query-result-required" 1)
            (rpica-feature "canonical-native-observation-required" 1)
            (rpica-feature "held-and-current-source-identity-required" 1)
            (rpica-feature "bounded-answer-required" 1)
            (rpica-feature "one-lookup-hit-outcome-required" 1)
            (rpica-feature "choice-cut-release-lifecycle-required" 1)
            (rpica-feature "typed-resident-answer-outcome-pairs" 1)
            (rpica-feature "load-call-return-fault-timeout-release-receipt" 1)
            (rpica-feature "nothing-zero-one-timeout-distinct" 1)
            (rpica-feature "zero-byte-source-and-empty-answer-present" 1)
            (rpica-feature "single-effectful-query-door" 1)
            (rpica-feature "no-http-model-remote-or-metal-call" 1)
            (rpica-feature "no-flatten-or-generated-table-authority" 1)
            (rpica-feature "no-c-seed-growth" 1)))
    (defn runtime-program-image-fkb-current-answer-capability-manifest-has?
          (name features)
        (if (nil? features) 0
            (if (and (str_eq (rpica-feature-name (head features)) name)
                     (eq (rpica-feature-status (head features)) 1))
                1
                (runtime-program-image-fkb-current-answer-capability-manifest-has?
                    name (tail features)))))

    (defn rpica-observation (result) (fknq-observation result))
    (defn rpica-observation-child (result at)
        (nth (node_children (rpica-observation result)) at))
    (defn rpica-observation-string (result at)
        (node_value (rpica-observation-child result at)))
    (defn rpica-observation-int (result at)
        (node_value (rpica-observation-child result at)))

    (defn rpica-result-shaped? (result)
        (if (nothing? result) 0
            (if (eq (len result) 22) 1 0)))
    (defn rpica-observation-shaped? (result)
        (if (eq (rpica-result-shaped? result) 0) 0
            (do
                (let observation (rpica-observation result))
                (if (nothing? observation) 0
                (if (not (node_eq (node_category observation)
                                  (fknq-observation-category))) 0
                    (if (eq (len (node_children observation)) 27) 1 0))))))
    (defn rpica-string-child? (result at)
        (do
            (let child (rpica-observation-child result at))
            (if (nothing? child) 0
                (if (and (eq (node_level child) 1)
                         (eq (node_type child) 2)) 1 0))))
    (defn rpica-int-child? (result at)
        (do
            (let child (rpica-observation-child result at))
            (if (nothing? child) 0
                (if (and (eq (node_level child) 1)
                         (eq (node_type child) 1)) 1 0))))
    (defn rpica-observation-leaf-shape? (result)
        (if (eq (rpica-observation-shaped? result) 0) 0
        (if (not (rpica-string-child? result 0)) 0
        (if (not (rpica-string-child? result 1)) 0
        (if (not (rpica-string-child? result 9)) 0
        (if (not (rpica-string-child? result 10)) 0
        (if (not (rpica-string-child? result 11)) 0
        (if (not (rpica-string-child? result 12)) 0
        (if (not (rpica-string-child? result 13)) 0
        (if (not (rpica-string-child? result 23)) 0
        (if (not (rpica-string-child? result 24)) 0
        (if (not (rpica-string-child? result 25)) 0
        (if (not (rpica-int-child? result 14)) 0
        (if (not (rpica-int-child? result 15)) 0
        (if (not (rpica-int-child? result 16)) 0
        (if (not (rpica-int-child? result 17)) 0
        (if (not (rpica-int-child? result 18)) 0
        (if (not (rpica-int-child? result 19)) 0
        (if (not (rpica-int-child? result 20)) 0
        (if (not (rpica-int-child? result 21)) 0
        (if (not (rpica-int-child? result 22)) 0
            (rpica-int-child? result 26))))))))))))))))))))))

    (defn rpica-result-token-bindings? (result)
        (if (eq (rpica-observation-leaf-shape? result) 0) 0
        (if (eq (fknq-source-token-valid? (fknq-source result)) 0) 0
        (if (eq (fknq-entry-token-valid? (fknq-entry result)) 0) 0
        (if (eq (fknq-request-valid? (fknq-request result)) 0) 0
        (if (not (node_eq (fknq-executor result)
                          (fknq-executor-token))) 0
        (if (not (node_eq (fknq-source result)
                          (rpica-observation-child result 4))) 0
        (if (not (node_eq (fknq-entry result)
                          (rpica-observation-child result 5))) 0
        (if (not (node_eq (fknq-request result)
                          (rpica-observation-child result 2))) 0
        (if (not (node_eq (fknq-executor result)
                          (rpica-observation-child result 3))) 0
        (if (not (node_eq (fknq-source-original-of result)
                          (rpica-observation-child result 6))) 0
            (if (node_eq (fknq-entry-original-of result)
                         (rpica-observation-child result 7)) 1 0))))))))))))

    (defn rpica-held-source (result) (fknq-source-original-of result))
    (defn rpica-current-source (result)
        (psci-source-node
            (rpica-observation-string result 9)
            (rpica-observation-string result 24)
            (rpica-observation-string result 25)
            (rpica-observation-int result 26)))
    (defn rpica-source-bindings? (result)
        (if (eq (rpica-result-token-bindings? result) 0) 0
            (do
                (let source (rpica-held-source result))
                (let entry (fknq-entry-original-of result))
                (let current (rpica-current-source result))
                (if (eq (psci-source-node-valid? source) 0) 0
                (if (eq (psci-entry-valid? entry) 0) 0
                (if (not (node_eq (psci-entry-source entry) source)) 0
                (if (not (node_eq (fknq-source-original
                                    (fknq-source result)) source)) 0
                (if (not (node_eq (fknq-entry-original
                                    (fknq-entry result)) entry)) 0
                (if (not (str_eq (fknq-source-path result)
                                 (psci-source-path source))) 0
                (if (not (str_eq (rpica-observation-string result 9)
                                 (psci-source-family source))) 0
                (if (not (str_eq (rpica-observation-string result 10)
                                 (psci-source-path source))) 0
                (if (not (str_eq (rpica-observation-string result 11)
                                 (psci-source-id source))) 0
                (if (eq (psci-source-node-valid? current) 0) 0
                    (if (node_eq source current) 1 0))))))))))))))

    (defn rpica-request-source-bound? (result)
        (if (eq (rpica-source-bindings? result) 0) 0
            (do
                (let request (fknq-request result))
                (let source (rpica-held-source result))
                (let entry (fknq-entry-original-of result))
                (if (str_eq (fknq-request-kind request) "concept")
                    (pscish-key-member? (fknq-request-coordinate request)
                                        (psci-entry-keys entry))
                    (if (str_eq (fknq-request-kind request) "nodeid")
                        (if (or
                                (str_eq (fknq-request-coordinate request)
                                        (fknq-node-key source))
                                (str_eq (fknq-request-coordinate request)
                                        (fknq-node-key entry))) 1 0)
                        0)))))

    (defn rpica-outcome-bindings? (result)
        (if (eq (rpica-request-source-bound? result) 0) 0
        (if (not (str_eq (fknq-status result)
                         (rpica-observation-string result 0))) 0
        (if (not (str_eq (fknq-reason result)
                         (rpica-observation-string result 1))) 0
        (if (not (str_eq (fknq-answer result)
                         (rpica-observation-string result 13))) 0
        (if (not (eq (fknq-fresh? result)
                     (rpica-observation-int result 14))) 0
        (if (not (eq (fknq-rebuild? result)
                     (rpica-observation-int result 15))) 0
        (if (not (eq (fknq-match-count result)
                     (rpica-observation-int result 16))) 0
        (if (not (eq (fknq-lookup-count result)
                     (rpica-observation-int result 17))) 0
        (if (not (eq (fknq-hit-count result)
                     (rpica-observation-int result 18))) 0
        (if (not (eq (fknq-executed? result)
                     (rpica-observation-int result 19))) 0
        (if (not (eq (fknq-model-executed? result)
                     (rpica-observation-int result 20))) 0
        (if (not (eq (fknq-pretokenized? result)
                     (rpica-observation-int result 21))) 0
        (if (not (eq (fknq-scannerless? result)
                     (rpica-observation-int result 22))) 0
            (if (str_eq (fknq-trace-actions (fknq-trace result))
                        (rpica-observation-string result 23)) 1 0)))))))))))))))

    (defn rpica-hit-contract? (result)
        (if (eq (rpica-outcome-bindings? result) 0) 0
        (if (not (str_eq (fknq-status result) "hit")) 0
        (if (not (str_eq (fknq-reason result)
                         "concept-registry-current-source-hit")) 0
        (if (not (eq (fknq-fresh? result) 1)) 0
        (if (not (eq (fknq-rebuild? result) 0)) 0
        (if (not (eq (fknq-match-count result) 1)) 0
        (if (not (eq (fknq-lookup-count result) 1)) 0
        (if (not (eq (fknq-hit-count result) 1)) 0
        (if (not (eq (fknq-executed? result) 1)) 0
        (if (not (eq (fknq-model-executed? result) 0)) 0
        (if (not (eq (fknq-pretokenized? result) 0)) 0
        (if (not (eq (fknq-scannerless? result) 1)) 0
        (if (not (str_eq (fknq-trace-actions (fknq-trace result))
                         "choice,cut,release")) 0
        (if (gt (str_len (fknq-answer result)) (fkss-answer-limit)) 0
        (if (gt (str_len (fknq-answer result))
                (psci-source-size (rpica-held-source result))) 0
            (if (str_eq (rpica-observation-string result 12)
                        (fhcs-answer-key (fknq-answer result))) 1 0)))))))))))))))))

    ; capability = (marker result held-source current-source)
    (defn rpica-capability-row (result held-source current-source)
        (list (rpica-version) result held-source current-source))
    (defn rpica-capability-from-result (result)
        (if (eq (rpica-hit-contract? result) 0) (nothing)
            (do
                (let held-source (rpica-held-source result))
                (let current-source (rpica-current-source result))
                (if (not (node_eq held-source current-source)) (nothing)
                    (rpica-capability-row result held-source current-source)))))
    (defn rpica-capability? (capability)
        (if (nothing? capability) 0
        (if (not (eq (len capability) 4)) 0
        (if (not (str_eq (nth capability 0) (rpica-version))) 0
            (do
                (let rebuilt (rpica-capability-from-result (nth capability 1)))
                (if (nothing? rebuilt) 0
                (if (not (node_eq (nth capability 2) (nth rebuilt 2))) 0
                    (if (node_eq (nth capability 3) (nth rebuilt 3)) 1 0))))))))
    (defn rpica-capability-result (capability) (nth capability 1))
    (defn rpica-capability-held-source (capability) (nth capability 2))
    (defn rpica-capability-current-source (capability) (nth capability 3))

    ; value = held/current pairs for source, answer, status, reason, lookup,
    ; hit, executed, and ordered lifecycle.  Every zero is present data.
    (defn rpica-capability-value (capability)
        (do
            (let result (rpica-capability-result capability))
            (list
                (rpica-capability-held-source capability)
                (rpica-capability-current-source capability)
                (fknq-answer result)
                (rpica-observation-string result 13)
                (fknq-status result)
                (rpica-observation-string result 0)
                (fknq-reason result)
                (rpica-observation-string result 1)
                (fknq-lookup-count result)
                (rpica-observation-int result 17)
                (fknq-hit-count result)
                (rpica-observation-int result 18)
                (fknq-executed? result)
                (rpica-observation-int result 19)
                (fknq-trace-actions (fknq-trace result))
                (rpica-observation-string result 23))))
    (defn rpica-input-kind ()
        (rpmw-kind-list
            (list
                (rpicsc-source-kind) (rpicsc-source-kind)
                (rpmw-kind-string) (rpmw-kind-string)
                (rpmw-kind-string) (rpmw-kind-string)
                (rpmw-kind-string) (rpmw-kind-string)
                (rpmw-kind-int) (rpmw-kind-int)
                (rpmw-kind-int) (rpmw-kind-int)
                (rpmw-kind-int) (rpmw-kind-int)
                (rpmw-kind-string) (rpmw-kind-string))))
    (defn rpica-capability-kind (capability)
        (if (rpica-capability? capability)
            (rpica-input-kind)
            (rpmw-kind-absent)))
    (defn rpica-symbol-request ()
        (pise-request-by-canonical-key
            "knowledge/current-answer-outcome-bound"))

    ; The execution receipt is derived only after the resident symbol walk has
    ; returned.  "load" means the already-admitted PIF identity entered the
    ; resident walker; this adapter performs no disk load.  "release" means the
    ; walk's immutable frame has left scope after return, fault, or timeout; it
    ; is not a claim about a model, Metal handle, or host resource.
    (defn rpica-phase-marker ()
        "runtime-program-image-fkb-current-answer-capability-phase")
    (defn rpica-phase (name observed)
        (list (rpica-phase-marker) name observed))
    (defn rpica-phase? (phase name)
        (if (not (eq (len phase) 3)) 0
            (if (not (str_eq (nth phase 0) (rpica-phase-marker))) 0
                (if (not (str_eq (nth phase 1) name)) 0
                    (if (or (eq (nth phase 2) 0)
                            (eq (nth phase 2) 1)) 1 0)))))
    (defn rpica-phase-observed (phase) (nth phase 2))
    (defn rpica-phase-matches? (actual expected name)
        (if (eq (rpica-phase? actual name) 0) 0
            (if (eq (rpica-phase? expected name) 0) 0
                (if (eq (rpica-phase-observed actual)
                        (rpica-phase-observed expected)) 1 0))))
    (defn rpica-lifecycle-matches? (actual expected)
        (if (not (eq (len actual) 6)) 0
        (if (not (eq (len expected) 6)) 0
        (if (eq (rpica-phase-matches? (nth actual 0) (nth expected 0)
                                      "load") 0) 0
        (if (eq (rpica-phase-matches? (nth actual 1) (nth expected 1)
                                      "call") 0) 0
        (if (eq (rpica-phase-matches? (nth actual 2) (nth expected 2)
                                      "return") 0) 0
        (if (eq (rpica-phase-matches? (nth actual 3) (nth expected 3)
                                      "fault") 0) 0
        (if (eq (rpica-phase-matches? (nth actual 4) (nth expected 4)
                                      "timeout") 0) 0
            (rpica-phase-matches? (nth actual 5) (nth expected 5)
                                  "release")))))))))

    (defn rpica-walk-micro (walk) (rpsw-receipt-micro-walk walk))
    (defn rpica-walk-trace (walk) (rpsw-receipt-trace walk))
    (defn rpica-input-matches-capability? (input capability)
        (if (not (eq (len input) 16)) 0
        (if (not (node_eq (nth input 0)
                          (rpica-capability-held-source capability))) 0
        (if (not (node_eq (nth input 1)
                          (rpica-capability-current-source capability))) 0
        (if (not (str_eq (nth input 2) (nth (rpica-capability-value capability) 2))) 0
        (if (not (str_eq (nth input 3) (nth (rpica-capability-value capability) 3))) 0
        (if (not (str_eq (nth input 4) (nth (rpica-capability-value capability) 4))) 0
        (if (not (str_eq (nth input 5) (nth (rpica-capability-value capability) 5))) 0
        (if (not (str_eq (nth input 6) (nth (rpica-capability-value capability) 6))) 0
        (if (not (str_eq (nth input 7) (nth (rpica-capability-value capability) 7))) 0
        (if (not (eq (nth input 8) (nth (rpica-capability-value capability) 8))) 0
        (if (not (eq (nth input 9) (nth (rpica-capability-value capability) 9))) 0
        (if (not (eq (nth input 10) (nth (rpica-capability-value capability) 10))) 0
        (if (not (eq (nth input 11) (nth (rpica-capability-value capability) 11))) 0
        (if (not (eq (nth input 12) (nth (rpica-capability-value capability) 12))) 0
        (if (not (eq (nth input 13) (nth (rpica-capability-value capability) 13))) 0
        (if (not (str_eq (nth input 14) (nth (rpica-capability-value capability) 14))) 0
            (if (str_eq (nth input 15)
                        (nth (rpica-capability-value capability) 15)) 1 0))))))))))))))))))
    (defn rpica-walk-bound-to-capability? (capability walk)
        (if (eq (rpica-capability? capability) 0) 0
        (if (not (rpsw-receipt? walk)) 0
        (if (not (rpsw-receipt-agrees? walk)) 0
        (if (eq (rpica-input-matches-capability?
                    (rpsw-receipt-input-value walk) capability) 0) 0
        (if (not (rpmw-kind-equal? (rpsw-receipt-input-kind walk)
                                   (rpica-capability-kind capability))) 0
        (if (not (rpsw-request-matches?
                    (rpsw-receipt-symbol-request walk)
                    (rpica-symbol-request))) 0
        (if (not (rpmw-receipt? (rpica-walk-micro walk))) 0
            (if (rpiwt-trace? (rpica-walk-trace walk)) 1 0)))))))))

    (defn rpica-walk-returned? (walk)
        (do
            (let trace (rpica-walk-trace walk))
            (if (and (str_eq (rpiwt-trace-status trace) (rao-obs-ok))
                (and (str_eq (rpiwt-trace-stop-reason trace)
                             (rpiwt-stop-completed))
                (and (eq (rpiwt-trace-output-count trace) 1)
                     (eq (rpiwt-trace-exit-code trace) 0)))) 1 0)))
    (defn rpica-walk-faulted? (walk)
        (do
            (let trace (rpica-walk-trace walk))
            (if (and (str_eq (rpiwt-trace-status trace) (rao-obs-error))
                (and (str_eq (rpiwt-trace-stop-reason trace)
                             (rpiwt-stop-error))
                (and (eq (rpiwt-trace-output-count trace) 0)
                     (eq (rpiwt-trace-exit-code trace) 1)))) 1 0)))
    (defn rpica-walk-timeout? (walk)
        (do
            (let trace (rpica-walk-trace walk))
            (if (and (str_eq (rpiwt-trace-status trace) (rao-obs-timeout))
                (and (str_eq (rpiwt-trace-stop-reason trace)
                             (rpiwt-stop-timeout))
                (and (eq (rpiwt-trace-output-count trace) 0)
                     (eq (rpiwt-trace-exit-code trace) 124)))) 1 0)))
    (defn rpica-walk-terminal-count (walk)
        (add (rpica-walk-returned? walk)
            (add (rpica-walk-faulted? walk)
                 (rpica-walk-timeout? walk))))
    (defn rpica-walk-status (walk)
        (if (eq (rpica-walk-returned? walk) 1) "returned"
            (if (eq (rpica-walk-faulted? walk) 1) "fault"
                (if (eq (rpica-walk-timeout? walk) 1) "timeout" ""))))
    (defn rpica-walk-reason (walk)
        (rpmw-receipt-reason (rpica-walk-micro walk)))
    (defn rpica-lifecycle-from-walk (walk)
        (list
            (rpica-phase "load" 1)
            (rpica-phase "call" 1)
            (rpica-phase "return" (rpica-walk-returned? walk))
            (rpica-phase "fault" (rpica-walk-faulted? walk))
            (rpica-phase "timeout" (rpica-walk-timeout? walk))
            (rpica-phase "release" 1)))

    ; receipt = (marker capability symbol-walk lifecycle status reason)
    (defn rpica-execution-marker ()
        "runtime-program-image-fkb-current-answer-capability-execution")
    (defn rpica-execution-row (capability walk lifecycle status reason)
        (list (rpica-execution-marker) capability walk lifecycle status reason))
    (defn rpica-execution-capability (receipt) (nth receipt 1))
    (defn rpica-execution-walk (receipt) (nth receipt 2))
    (defn rpica-execution-lifecycle (receipt) (nth receipt 3))
    (defn rpica-execution-status (receipt) (nth receipt 4))
    (defn rpica-execution-reason (receipt) (nth receipt 5))
    (defn rpica-execution-load (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 0)))
    (defn rpica-execution-call (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 1)))
    (defn rpica-execution-return (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 2)))
    (defn rpica-execution-fault (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 3)))
    (defn rpica-execution-timeout (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 4)))
    (defn rpica-execution-release (receipt)
        (rpica-phase-observed (nth (rpica-execution-lifecycle receipt) 5)))
    (defn rpica-execution-from-walk (capability walk)
        (if (eq (rpica-walk-bound-to-capability? capability walk) 0) (nothing)
            (if (not (eq (rpica-walk-terminal-count walk) 1)) (nothing)
                (rpica-execution-row capability walk
                    (rpica-lifecycle-from-walk walk)
                    (rpica-walk-status walk)
                    (rpica-walk-reason walk)))))
    (defn rpica-execution-receipt? (receipt)
        (if (nothing? receipt) 0
        (if (not (eq (len receipt) 6)) 0
        (if (not (str_eq (nth receipt 0) (rpica-execution-marker))) 0
            (do
                (let expected (rpica-execution-from-walk
                    (rpica-execution-capability receipt)
                    (rpica-execution-walk receipt)))
                (if (nothing? expected) 0
                (if (eq (rpica-lifecycle-matches?
                            (rpica-execution-lifecycle receipt)
                            (rpica-execution-lifecycle expected)) 0) 0
                (if (not (str_eq (rpica-execution-status receipt)
                                 (rpica-execution-status expected))) 0
                    (if (str_eq (rpica-execution-reason receipt)
                                (rpica-execution-reason expected)) 1 0)))))))))

    (defn rpica-walk-result (envelope admission result step-budget)
        (do
            (let capability (rpica-capability-from-result result))
            (if (nothing? capability) (nothing)
                (rpsw-walk-symbol-with-kind
                    envelope admission (rpica-symbol-request) step-budget
                    (rpica-capability-value capability)
                    (rpica-capability-kind capability)))))

    (defn rpica-execution-result (envelope admission result step-budget)
        (do
            (let capability (rpica-capability-from-result result))
            (if (nothing? capability) (nothing)
                (rpica-execution-from-walk capability
                    (rpsw-walk-symbol-with-kind
                        envelope admission (rpica-symbol-request) step-budget
                        (rpica-capability-value capability)
                        (rpica-capability-kind capability))))))

    ; This is the only effectful door.  The result is born inside the bounded
    ; query and is immediately admitted; arbitrary host data never crosses it.
    (defn rpica-execute-at (envelope admission root artifact surface
                            local-ready cursor-budget step-budget)
        (rpica-walk-result envelope admission
            (fknq-execute-at root artifact surface local-ready cursor-budget)
            step-budget))
    (defn rpica-execute-receipt-at
        (envelope admission root artifact surface local-ready cursor-budget
         step-budget)
        (rpica-execution-result envelope admission
            (fknq-execute-at root artifact surface local-ready cursor-budget)
            step-budget))
)
