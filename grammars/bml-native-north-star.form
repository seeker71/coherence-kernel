# bml-native-north-star.form - BML/BMF/Form native compiler orientation

(bml-native-compiler
  (north-star
    (sentence "The original BML, BMF, and Form compiler sources compile themselves into versioned .fkb images and Hati native binaries.")
    (connected-tissue "The compiler north star harmonizes with the band manifest (form/band-verdicts.txt), the compiler's own health organ (form/form-stdlib/bml/bml-compiler-health.bml), Hati target cells, Form-to-ASM object cells, native executor proof ledger, JSONL export/cache, and commit evidence so sister nodes name one current floor.")
    (must-carry full-class-support full-template-support full-generic-support method-dispatch state exception-and-backtracking full-runtime-control-flow full-runtime-backtracking typed-values physical-lanes clang-target-assembly form-native-target-object form-native-target-executable native-metal-emit-manifest form-native-jit-runtime lowered-jit-residual-tags value-native-jit-span numeric-native-conversions-transcendentals jit-tensor-emitter-as-recipe clang-oracle-sampling oracle-learning-choice gpu-kernel-emission ml-kernel-emission)
    (artifact-contract source -> compiler-image -> loadable-table -> native-binary -> target-assembly -> form-native-object -> form-native-executable -> native-metal-emit-table -> oracle-sample -> form-native-jit-bytes -> lowered-jit-table -> value-native-jit-table -> numeric-native-table -> tensor-emitter-source -> measured-native-choice -> measured-run)
    (proof-shape same-source-same-image same-table-same-value stdout-stderr-timing binary-size loadable-artifact-roundtrip clang-target-assembly target-object-format form-native-target-object form-native-target-executable native-metal-emit form-native-byte-conviction lowered-jit value-native-jit numeric-native jit-tensor-emit oracle-learning-choice))

  (floor
    (expression-surface "Executable form.bml uses explicit module imports, one choice spelling, try/catch and fail, polymorphic value equality and addition, len, value.str(), list literals, negative indexing, and half-open slices. The BMF cursor shares bracket parsing with executable admission. Native kind specialization keeps common first/remainder reductions on the JIT loop lane; source bootstrap remains sufficient.")
    (sentence "A native compiler claim is allowed only when the supported subset emits a loadable Hati table with parity proof, target assembly receipts exist for the supported metal planes, Form-native target object floors exist for macOS Mach-O, Windows PE/COFF x64, and Android ELF/aarch64, the Form-native Android ELF/aarch64 executable shape plus Linux/arm64 and Android adb stdout/stderr/exit receipts are proven, the Windows x64 PE/COFF object links into a loadable DLL, swaps behind the same recipe symbol, can be called through a cross-platform minimal bootstrap exe with host-boundary measurements, and the emitted fkwu C carrier builds on Windows through the local LLVM/clang oracle, native metal/emit target rows run on fkwu, third-party compilers/drivers/models are treated as oracle/sample sources, Form-native JIT runtime rows, lowered residual JIT rows, value-native JIT span rows, numeric conversion/transcendental rows, tensor emitter-as-recipe rows, measured oracle-learning choice samples run on fkwu for the supported lanes, Mac+Android native receipt/package evidence is explicit about its carrier, and unsupported BML shapes or unproven transports are named before table emission.")
    (no-silent-zero unsupported-lowering-must-not-be-a-valid-table)
    (android-jit-floor "the Form-native lowered recipe/table path; a clang-like compiler may ship inside the APK as an optional oracle, never as a required floor")
    (unheld-fail "A fail no choose holds ends the program, and the program answers the value of its last completed statement, even when the fail lands in the middle of an expression; the native run voices that ending once through the compiler organ.")
    (language-ground "BML's meaning is grounded in the thesis text, docs/field/urs/artifacts/master-thesis-2000/backtracking-model-languages.txt in the Coherence-Network checkout, cited by line; where the thesis gives a flag no behaviour, the flag is carried and voiced until Urs gives it one")
    (current-supported int float string char add const lexical-const-binding bound-name-return bound-name-add return method-body one-argument-method-parameter two-argument-method-parameter known-method-call arity-mismatch-receipts method-scope-class-field-read method-scope-class-field-write record-backed-self named-class-method-dispatch class-construction-defaults arity-aware-overload-dispatch arity-selected-compiled-overload-calls template-generic-metadata block-sequence simple-choose/fail form-native-control-backtracking-ml-coverage bml-native-source-control-transfer source-if_fail/while_success source-save-discard-try-throw-catch let-effect-once pure-call-let-snapshot write-file-text native-mutation-receipt-family field-model-form-runtime port-shape interface-package-import-metadata native-mutable-local-frame table-image string-stdout clang-target-assembly clang-oracle-samples native-metal-emit-floor asm-pl-human-emit form-macho form-pe-coff bootstrap-host form-elf form-elf-exec linux-arm64-docker-executable-runner-receipt android-device-form-native-executable-runner-receipt mac-android-core-axiom-native-channel-receipt windows-x86_64-dll-load-swap-receipt bootstrap-exe-load-swap-measurement-receipt core-axiom-apk-native-library-package-receipt hati-os-native-cli-emit hati-os-targets metal-emit form-native-jit-runtime lowered-jit-tags-70-79 value-native-jit-tags-81-86 numeric-native-tags-87-90 jit-logic-lower jit-folded-literal jit-unbox-carrier jit-closure-lift jit-bmf-output-lower jit-lowered-emit jit-value-native-span float-conversions trig tensor-quant transcendental-natives jit-tensor-emitter-as-recipe oracle-learning-choice gpu-kernel-emitter ml-kernel-emitter macos-arm64 android-arm64 windows-x86_64 unit-constant-let lexical-nested-do form-source-scan-lexicon package-namespace-resolution import-symbol-resolution import-consts keyword-and-property-path-segments unresolved-names-named-in-lowering general-calls many-argument-methods callee-scope-name-resolution mutable-local-source-lowering arrays element-assignment restore-spelling save-restore-discard-snapshot choose-backtracking-snapshot branch-assignment-carry control-block-if-else loop while for switch labeled-break-continue try-throw-catch receiver-slot class-member-receiver-dispatch native-fixture-door compiler-health-voice hati-branch-stops-at-fail field-set-rollback-in-failing-choose compiler-voice-on-fkwu unheld-fail-stops-program live-import-heal class-construction-syntax interface-method-dispatch type-generic-overload-resolution template-generic-specialization mid-expression-fail-value with-implicit-receiver select-statement iterative-loop-lowering per-call-switch-temporaries unreadable-statement-voice nested-field-path-assignment imported-class-member-scope method-result-static-type field-initializer-expressions multiple-class-bases host-record-class-id fkwu-jit-run-path runaway-loop-voice member-access-after-new delegate-field-slots field-initializer-this member-access-on-call-result field-set-on-call-result jit-loop-lane-for-bml-loops cut-lowering class-model-final-abstract-constants delegate-field-visibility parenthesized-member-access loop-lane-quiet-calls loop-lane-nested-loops loop-lane-crossings loop-lane-multi-carry loop-lane-standing-body loop-lane-heat-trigger-measured class-field-section bma-in-thesis-unit field-flags property-word-member-names package-default-access strict-runtime-check bma-residue-in-scope-builder)
    (carriers-wired
      (bml-native-interface-package-import "package and import rows reach bml-scope-link, which links every unit an import reaches into one table")
      (bml-native-source-control "every break, continue, throw and return is a bnsc effect row whose mode drives the lowering")
      (form-control-backtracking-ml "bml-ctl-form-native-covered? ties the control lowering to the fcml primitive lists")
      (bml-native-mutable-locals "the carrier's frame shape: declare and assign lower to record ops on one BML-MUTABLE-LOCAL-FRAME record per call"))
    (witness
      (registered "form/band-verdicts.txt registers the class-dispatch proof (a host-made record's class id), the class-model and inheritance proofs, the three carrier bands and let-scope; each reads fkwu's full marks. The native behaviours live as fixtures the door runs on fkwu itself: the run step spawns fkwu, the only runtime")
      (voice "form/form-stdlib/bml/bml-compiler-health.bml speaks where the compiler withholds a table or answers that it could not lower, and is silent when healthy")
      (door "observe/bml-native-run.bml runs every fixture that declares its answer through bml-run-unit-value (form/form-stdlib/bml/bml-form-lower.bml): its imports and Units: heal live through organ-care, the linked units lower to Form defns that fkwu runs on its own evaluator and JIT, and each answer is judged against the one its own head declares; a run past its Budget: (2000 ms unless the source declares one) raises a reading naming its hot defns and offers extend or stop"))
    (current-unsupported inner-classes class-methods template-kind-constraints application-main-entry method-section-properties package-access-methods-and-inherited-constants deferred-method-meaning loop-lane-labeled-and-body-control loop-lane-class-calls loop-lane-limits frame-source-receipt bml-category-one-identity android-jni-load-call-receipts installed-app-native-execution non-adb-transport-receipts)
    (next-code-point classes "form/form-stdlib/bml/bml-form-lower.bml and grammars/bml.fk: inner classes (261, 654), the reader first; class methods (686); which kinds a template may wrap (757); Application.Main as entry (270); section properties on methods, with package access for methods and for constants a subclass inherits; deferred waits on Urs for a meaning")
    (next-code-point run "form/form-stdlib/bml/bml-form-lower.bml and runtime/fkwu-uni.c's loop lane: a labeled break or continue to an outer loop, and a switch, try or choose in a loop body, ride out as values; class calls are read for quietness through the method tables; the lane takes more than six slots, if-chains and record frames")
    (next-code-point names "form/form-stdlib/bml/bml-form-lower.bml and form-ontology-bp.fk: a call frame carries its source (language, path, line); a BML category name resolves to the registry's one identity in every section")
    (next-code-point android "an attached Android device: JNI load/call, installed-app native execution, a transport other than adb (adb lists no device on this Mac)"))

  (next-step
    (sentence "Close one missing semantic family at a time; its expectation lives in the compiler as a signal, its sources in fixtures, and its parity in the band manifest.")
    (next-semantic-candidate inner-classes)
    (why "Compact source must retain meaning, owned effects and observable cost. The shared Form value operators, BMF cursor and native compiler carry the current surface. Advance unsupported semantic families at their executing boundary, specialize hot paths from measured work, and remove replaced implementations after callers agree.")))
