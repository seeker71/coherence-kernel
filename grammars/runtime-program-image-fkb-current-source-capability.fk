; runtime-program-image-fkb-current-source-capability.fk -- admit one
; correlated current-source identity as typed data for the resident PIF walker.
;
; Freshness is observed before this organ by form-nodeid-knowledge-query.  This
; adapter receives that held evidence, reconstructs the independently observed
; current source node, and admits only an exact pair.  The resident image gets
; no path authority: it receives [held-source, current-source] plus the exact
; value-kind tree and decides equality with native NODE_EQ.
;
; preludes: form-stdlib/core.fk form-stdlib/form-knowledge-source-search.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk
; preludes: form-stdlib/program-image-symbol-entry.fk
; preludes: form-stdlib/runtime-program-image-fkb-micro-walker.fk
; preludes: form-stdlib/runtime-program-image-fkb-symbol-walk.fk
;
; Proven by: form-stdlib/tests/runtime-program-image-fkb-current-source-capability-band.fk

(do
    (defn rpicsc-version ()
        "runtime-program-image-fkb-current-source-capability-v1")

    (defn rpicsc-feature (name status)
        (list "runtime-program-image-fkb-current-source-capability-feature"
              name status))
    (defn rpicsc-feature-name (feature) (nth feature 1))
    (defn rpicsc-feature-status (feature) (nth feature 2))
    (defn runtime-program-image-fkb-current-source-capability-manifest ()
        (list
            (rpicsc-feature "correlated-current-hit-required" 1)
            (rpicsc-feature "held-and-current-source-node-validity-required" 1)
            (rpicsc-feature "held-and-current-source-identity-required" 1)
            (rpicsc-feature "typed-resident-source-pair" 1)
            (rpicsc-feature "resident-node-equality-decision" 1)
            (rpicsc-feature "missing-stale-miss-malformed-return-nothing" 1)
            (rpicsc-feature "zero-byte-source-is-present" 1)
            (rpicsc-feature "no-ambient-filesystem-authority" 1)
            (rpicsc-feature "no-model-remote-or-metal-call" 1)
            (rpicsc-feature "no-flatten-or-generated-table-authority" 1)
            (rpicsc-feature "no-c-seed-growth" 1)))
    (defn runtime-program-image-fkb-current-source-capability-manifest-has?
          (name features)
        (if (nil? features) 0
            (if (and (str_eq (rpicsc-feature-name (head features)) name)
                     (eq (rpicsc-feature-status (head features)) 1))
                1
                (runtime-program-image-fkb-current-source-capability-manifest-has?
                    name (tail features)))))

    ; capability = (marker registry current held-source current-source)
    (defn rpicsc-capability-row (registry current held-source current-source)
        (list (rpicsc-version) registry current held-source current-source))
    (defn rpicsc-capability? (capability)
        (if (nothing? capability) 0
        (if (not (eq (len capability) 5)) 0
        (if (not (str_eq (nth capability 0) (rpicsc-version))) 0
            (do
                (let rebuilt (rpicsc-capability-from-current
                    (nth capability 1) (nth capability 2)))
                (if (nothing? rebuilt) 0
                (if (not (node_eq (nth capability 3) (nth rebuilt 3))) 0
                    (if (node_eq (nth capability 4) (nth rebuilt 4)) 1 0))))))))
    (defn rpicsc-capability-registry (capability) (nth capability 1))
    (defn rpicsc-capability-current (capability) (nth capability 2))
    (defn rpicsc-capability-held-source (capability) (nth capability 3))
    (defn rpicsc-capability-current-source (capability) (nth capability 4))

    (defn rpicsc-registry-shaped? (registry)
        (if (nothing? registry) 0
            (if (not (eq (len registry) 15)) 0
                (str_eq (nth registry 0)
                        "form-nodeid-knowledge-registry-result-v1"))))
    (defn rpicsc-current-shaped? (current)
        (if (nothing? current) 0
            (if (not (eq (len current) 17)) 0
                (str_eq (nth current 0) "form-knowledge-source-search-v1"))))

    (defn rpicsc-capability-from-current (registry current)
        (if (eq (rpicsc-registry-shaped? registry) 0) (nothing)
        (if (eq (rpicsc-current-shaped? current) 0) (nothing)
        (if (eq (fknq-current-hit-bound? registry current) 0) (nothing)
            (do
                (let held-source (fknq-registry-source registry))
                (let current-source
                    (psci-source-node
                        (fknq-registry-family registry)
                        (fkss-source-path current)
                        (fkss-source-id-of current)
                        (fkss-source-size current)))
                (if (eq (psci-source-node-valid? held-source) 0) (nothing)
                (if (eq (psci-source-node-valid? current-source) 0) (nothing)
                (if (not (node_eq held-source current-source)) (nothing)
                    (rpicsc-capability-row registry current held-source
                                           current-source)))))))))

    (defn rpicsc-source-kind ()
        (rpmw-kind-composite-node
            (list (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-string-node)
                  (rpmw-kind-trivial-int-node))))
    (defn rpicsc-input-kind ()
        (rpmw-kind-list (list (rpicsc-source-kind) (rpicsc-source-kind))))
    (defn rpicsc-capability-value (capability)
        (list (rpicsc-capability-held-source capability)
              (rpicsc-capability-current-source capability)))
    (defn rpicsc-capability-kind (capability)
        (if (rpicsc-capability? capability)
            (rpicsc-input-kind)
            (rpmw-kind-absent)))
    (defn rpicsc-symbol-request ()
        (pise-request-by-canonical-key "knowledge/current-source-bound"))

    ; This is the only typed resident entry exposed by this adapter.  The
    ; current-source capability is rebuilt here; callers cannot supply an
    ; arbitrary value/kind pair through this door.
    (defn rpicsc-walk-current-source (envelope admission registry current
                                      step-budget)
        (do
            (let capability (rpicsc-capability-from-current registry current))
            (if (nothing? capability) (nothing)
                (rpsw-walk-symbol-with-kind
                    envelope admission (rpicsc-symbol-request) step-budget
                    (rpicsc-capability-value capability)
                    (rpicsc-capability-kind capability)))))
)
