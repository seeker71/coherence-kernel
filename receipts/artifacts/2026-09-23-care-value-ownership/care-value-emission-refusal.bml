// preludes: form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 let result = nsi-capture(list(str_concat(host_cwd(),"/fkwu"),".hearth/care-value-nonfinite.bml"));
 let errors = read_file(nsi-path(nsi-evidence(result),"stderr"));
 if not(and(eq(nsi-status(result),1),and(eq(str_len(nsi-text(result)),0),ge(str_find(errors,"non-finite value has no JSON number",0),0)))) then form_error("nonfinite JSON emission must retain its refusal") else 0;
 let report = json-emit-precise(json-node-object(list(oh-s("schema","care-value-nonfinite-refusal-v1"),oh-n("accepted",1),oh-n("child_exit",nsi-status(result)),oh-n("stdout_bytes",str_len(nsi-text(result))),oh-s("stderr",errors),oh-s("evidence",nsi-evidence(result)))));
 if ne(write_file(".hearth/care-value-emission-refusal.json",report),str_len(report)) then form_error("emission refusal report incomplete") else 0;
 print_str(str_concat(report,"\n")); 1;
}
