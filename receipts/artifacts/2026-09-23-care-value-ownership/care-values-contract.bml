// Protocol counterexamples and retained real execution, compared with parent source.
// preludes: form-stdlib/bml/organ-health-stream.bml .hearth/organ-health-reference.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class CareValueContract {
  def cvc-check(ok,label) = if ok then 1 else form_error(str_concat("care value contract: ",label));
  def cvc-node(text) = parse-json("care-value-reference",text);
  def cvc-parity(text) {
   let prior = cvc-node(text); let value = jvp-parse(text);
   cvc-check(jv-equal(jv-node(prior),value),"typed parse equality");
   cvc-check(str_eq(json-emit-precise(prior),jv-emit(value)),"precise serialization parity");
   cvc-check(node_eq(prior,jv-materialize(value)),"explicit node materialization parity"); 1;
  }
  def cvc-deep(n,text) = if le(n,0) then text else cvc-deep(sub(n,1),str_concat("[",str_concat(text,"]")));
  def cvc-base() = jvp-parse("{\"schema\":\"organ-health-v1\",\"schema\":\"second\",\"id\":\"observed-1\",\"organ\":\"owned\",\"flow\":\"local\",\"aspect\":\"write\",\"stage\":\"observe\",\"expected\":1,\"observed\":0,\"health\":0,\"needs\":[{\"resource\":\"local\",\"detail\":{\"choices\":[null,false,0,1,1.0,0.125],\"a\":1,\"a\":2}}],\"needs\":[],\"offers\":[\"supply\",\"defer\"],\"evidence\":{\"native\":true},\"surprise\":1,\"at_ms\":7}");
  def cvc-attention(row,need) = jv-set(row,"attention",jv-object(list(jv-pair("need",need),jv-s("state","directed"))));
  def cvc-steps(events,prior,current,index) = if nil?(events) then index else {
   let node = jv-materialize(head(events)); let value = head(events);
   let old = before-oh-current(list(node),prior); let fresh = ohv-current(list(value),current);
   cvc-check(str_eq(json-emit-precise(json-node-array(old)),jv-emit(jv-array(fresh))),str_concat("parent protocol step ",int_to_str(index)));
   cvc-check(node_eq(json-node-array(oh-current(list(node),prior)),json-node-array(old)),"node adapter shares protocol");
   if eq(index,7) then cvc-check(eq(len(jv-items(jv-get(head(fresh),"attentions"))),6),"typed and ordered needs retain six distinct attentions") else 0;
   if eq(index,8) then cvc-check(and(eq(jv-kind(jv-get(head(fresh),"result")),3),str_eq(jv-str(head(fresh),"result"),"")),"missing control result preserves empty string contract") else 0;
   if eq(index,9) then cvc-check(not(jv-has(head(fresh),"care_delivery")),"new care need releases old delivery") else 0;
   if eq(index,11) then cvc-check(jv-equal(jv-array(fresh),jv-array(current)),"late attention cannot revive an old observation") else 0;
   cvc-steps(tail(events),old,fresh,add(index,1));
  };
  def cvc-lines(lines,reader,count) = if nil?(lines) then count else { ohs-line(reader,head(lines)); cvc-lines(tail(lines),reader,add(count,1)); };
  def cvc-clean(row) = if str_eq(ohv-str(row,"aspect"),"control-correlation") then jv-remove(jv-remove(jv-remove(row,"id"),"at_ms"),"observed_at_ms") else row;
  def cvc-clean-all(rows) = if nil?(rows) then list() else cons(cvc-clean(head(rows)),cvc-clean-all(tail(rows)));
  def cvc-run() {
   let outbound = bfc-envelope(0,host_monotonic_ms(),0,list(128,256),0); bfc-record-out(outbound,0);
   let inbound = bfc-control(outbound,5); bfc-record-in(inbound,1);
   cvc-check(eq(bfc-apply(outbound,inbound,0,1),1),"correlated revise selects actual fresh-identity re-observation");
   cvc-parity("{\"a\":1,\"a\":2,\"values\":[null,false,true,0,1,1.0,-0.0,0.125,1.2345678901234567e-8,9007199254740993,\"\\u0000\\uD83D\\uDE00\\n\"]}");
   cvc-parity(cvc-deep(96,"{\"leaf\":[]}"));
   cvc-check(and(node_eq(cvc-node("1e999"),jv-materialize(jvp-parse("1e999"))),node_eq(cvc-node("-1e999"),jv-materialize(jvp-parse("-1e999")))),"overflow float node admission preserves both infinities");
   cvc-check(node_eq(json-node-float-text("NaN"),jv-materialize(jv-float(div(0.0,0.0)))),"NaN node admission preserves canonical identity");
   cvc-check(and(not(jv-equal(jv-int(0),jv-bool(0))),not(jv-equal(jv-int(1),jv-float(1.0)))),"integer boolean and float remain distinct");
   cvc-check(and(jv-has(jvp-parse("{\"a\":null}"),"a"),not(jv-has(jvp-parse("{}"),"a"))),"absence differs from null");
   cvc-check(and(jv-equal(jv-float(div(0.0,0.0)),jv-float(div(0.0,0.0))),jv-equal(jv-node(json-node-bool(true)),jv-bool(1))),"NaN identity and borrowed booleans");
   let base = cvc-base(); let control = jv-set(jv-set(base,"stage",jv-string("response")),"selected",jv-string("supply"));
   let applied = jv-set(jv-set(jv-set(control,"stage",jv-string("applied")),"result",jv-null()),"care_need",jv-string("local"));
   let next = jv-set(jv-set(base,"id",jv-string("observed-2")),"health",jv-int(1));
   let steps = cvc-steps(list(jv-object(list(jv-pair("health",jv-set(base,"care_delivery",jv-string("old"))))),cvc-attention(base,jv-int(0)),cvc-attention(base,jv-bool(0)),cvc-attention(base,jv-float(1.0)),cvc-attention(base,jv-int(1)),cvc-attention(base,jvp-parse("{\"a\":1,\"b\":2}")),cvc-attention(base,jvp-parse("{\"b\":2,\"a\":1}")),cvc-attention(base,jv-int(0)),control,applied,next,cvc-attention(base,jv-null())),list(),list(),0);
   let reader = ohs-open("owned-contract.jsonl","first"); ohs-row(reader,base);
   let bad = jv-set(control,"id",jv-string("unobserved")); let records = kernel_stat(164); let minted = kernel_stat(53);
   ohs-row(reader,bad); let first = ohv-str(ohv-find(record_get(reader,"current"),jv-object(list(jv-s("organ","health-flow"),jv-s("flow","local"),jv-s("aspect","control-correlation")))),"id");
   ohs-restart(reader,"second"); ohs-row(reader,bad);
   let second = ohv-str(head(record_get(reader,"current")),"id"); let recordGrowth = sub(kernel_stat(164),records); let primaryGrowth = sub(kernel_stat(53),minted);
   cvc-check(and(not(str_eq(first,second)),and(eq(recordGrowth,0),eq(primaryGrowth,0))),"correlation diagnostics reuse reader identity across generations without permanent admission");
   let priorBad = before-oh-current(list(jv-materialize(bad)),list());
   cvc-check(str_eq(jv-emit(jv-array(cvc-clean-all(jv-wrap(priorBad)))),jv-emit(jv-array(cvc-clean-all(record_get(reader,"current"))))),"unbound response retains diagnostic content");
   let raw = parse-json("retained-care",read_file(".hearth/live-process-care-report.json"));
   let path = str_concat(before-oh-str(nth(json-array-elements(before-oh-get(raw,"cases")),1),"job"),"/probe.events.jsonl");
   let text = read_file(path); let lines = split-on(text,"\n"); let old = before-oh-lines(lines,list());
   let live = ohs-open(path,"retained-execution"); let start = host_monotonic_ms(); let before = kernel_stat(53); let floatBefore = kernel_stat(45);
   let events = cvc-lines(lines,live,0); let mints = sub(kernel_stat(53),before); let boxes = sub(kernel_stat(45),floatBefore); let elapsed = sub(host_monotonic_ms(),start);
   cvc-check(eq(mints,0),"real retained event parse and reduction create no primary nodes");
   cvc-check(str_eq(jv-emit(jv-array(cvc-clean-all(jv-wrap(old)))),jv-emit(jv-array(cvc-clean-all(record_get(live,"current"))))),"retained execution matches parent reducer");
   let floatStart = kernel_stat(45); let floatPrimary = kernel_stat(53); let parsed = jvp-parse("[1.2345678901234567,0.000000000125,1e200]"); let floatMints = sub(kernel_stat(53),floatPrimary); let floatBoxes = sub(kernel_stat(45),floatStart);
   cvc-check(and(eq(floatMints,0),gt(floatBoxes,0)),"floating leaves disclose seed boxes separately");
   let unique = jv-object(list(jv-s("explicit-node-boundary",noc-open()),jv-n("observed",17)));
   let admission = kernel_stat(53); let admitted = jv-materialize(unique); let admissionMints = sub(kernel_stat(53),admission);
   cvc-check(gt(admissionMints,0),"explicit node API still materializes content");
   let report = jv-object(list(jv-s("schema","care-value-contract-v1"),jv-n("accepted",1),jv-n("protocol_steps",steps),jv-n("nested_depth",96),jv-n("retained_bytes",str_len(text)),jv-n("retained_lines",events),jv-n("retained_primary_mints",mints),jv-n("retained_float_boxes",boxes),jv-n("retained_elapsed_ms",elapsed),jv-n("diagnostic_primary_mints",primaryGrowth),jv-n("diagnostic_record_dispatches",recordGrowth),jv-n("float_parse_primary_mints",floatMints),jv-n("float_parse_boxes",floatBoxes),jv-n("explicit_admission_primary_mints",admissionMints),jv-s("reference","26863337f:form/form-stdlib/organ-health.bml; namespace-only copy")));
   let output = jv-emit(report); cvc-check(eq(write_file(".hearth/care-values-contract.json",output),str_len(output)),"report retained");
   bfc-record-out(bfc-envelope(0,bfc-exchange(outbound),0,list(steps,events,admissionMints),0),2);
   print_str(str_concat(output,"\n")); 1;
  }
 }
 if str_eq(read_line(),"run") then cvc-run() else 0;
}
