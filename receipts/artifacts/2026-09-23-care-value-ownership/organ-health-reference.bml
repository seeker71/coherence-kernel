// One language for an organ's live reading, need, response and changed state.
// The organ supplies health and meaning. This carrier knows no error names,
// model families, resource catalogue, thresholds or expected verdict numbers.
// preludes: form-stdlib/json-precise.bml form-stdlib/spool-bell-transport.fk form-stdlib/line-grammar.fk form-stdlib/bml/native-owner-clock.bml
section [form.bml] {
 class BeforeOrganHealth {
  def before-oh-s(key,value) = json-node-pair(key,json-node-string(value));
  def before-oh-n(key,value) = json-node-pair(key,json-node-int(value));
  def before-oh-get(row,key) = json-object-get(row,key);
  def before-oh-str(row,key) = json-string-value(before-oh-get(row,key));
  def before-oh-has(values,value) = if nil?(values) then 0 else or(str_eq(head(values),value),before-oh-has(tail(values),value));
  def before-oh-strings(values) = if nil?(values) then list() else cons(json-node-string(head(values)),before-oh-strings(tail(values)));
  def before-oh-values(nodes) = if nil?(nodes) then list() else cons(json-string-value(head(nodes)),before-oh-values(tail(nodes)));
  def before-oh-ints(values) = if nil?(values) then list() else cons(json-node-int(head(values)),before-oh-ints(tail(values)));
  def before-oh-int-values(nodes) = if nil?(nodes) then list() else cons(json-int-value(head(nodes)),before-oh-int-values(tail(nodes)));
  def before-oh-without(pairs,key) = if nil?(pairs) then list() else if str_eq(json-pair-key(head(pairs)),key) then before-oh-without(tail(pairs),key) else cons(head(pairs),before-oh-without(tail(pairs),key));
  def before-oh-set(row,key,value) = json-node-object(append(before-oh-without(json-object-pairs(row),key),list(json-node-pair(key,value))));
  def before-oh-need(resource,detail) = json-node-object(list(before-oh-s("resource",resource),json-node-pair("detail",detail)));
  def before-oh-reference(path) = json-node-object(list(before-oh-s("path",path),before-oh-n("bytes",file_size(path)),before-oh-n("observed_unix_ms",now_unix_ms())));
  def before-oh-reading(organ,flow,aspect,expected,observed,health,needs,offers,evidence) {
   let id = str_concat(noc-open(),str_concat(":",str_concat(flow,str_concat(":",aspect))));
   before-oh-reading-with-id(id,organ,flow,aspect,expected,observed,health,needs,offers,evidence);
  }
  // An organ may already own a unique, retained event identity. Carry it
  // explicitly when process introspection is unavailable in its host scope.
  // The caller owns uniqueness and replay identity; no process birth is inferred.
  def before-oh-reading-with-id(id,organ,flow,aspect,expected,observed,health,needs,offers,evidence) {
   if str_eq(id,"") then form_error("organ health reading identity is empty") else 0;
   let at = now_unix_ms();
   json-node-object(list(before-oh-s("schema","organ-health-v1"),before-oh-s("id",id),before-oh-s("organ",organ),before-oh-s("flow",flow),before-oh-s("aspect",aspect),before-oh-s("stage","observe"),json-node-pair("expected",expected),json-node-pair("observed",observed),json-node-pair("health",health),before-oh-n("surprise",not(node_eq(expected,observed))),json-node-pair("needs",json-node-array(needs)),json-node-pair("offers",json-node-array(before-oh-strings(offers))),before-oh-s("selected",""),json-node-pair("evidence",evidence),before-oh-n("observed_at_ms",at),before-oh-n("at_ms",at)));
  }
  def before-oh-text(row,key) = and(eq(node_type(before-oh-get(row,key)),2),gt(str_len(before-oh-str(row,key)),0));
  def before-oh-health-value(value) = or(node_eq(value,json-node-null()),or(node_eq(value,json-node-int(0)),node_eq(value,json-node-int(1))));
  def before-oh-array(row,key) = node_eq(node_category(before-oh-get(row,key)),JSON-ARRAY());
  def before-oh-valid(row) = and(str_eq(before-oh-str(row,"schema"),"organ-health-v1"),and(before-oh-text(row,"id"),and(before-oh-text(row,"organ"),and(before-oh-text(row,"flow"),and(before-oh-text(row,"aspect"),and(before-oh-has(list("observe","response","applied"),before-oh-str(row,"stage")),and(json-object-has?(row,"expected"),and(json-object-has?(row,"observed"),and(before-oh-health-value(before-oh-get(row,"health")),and(before-oh-array(row,"needs"),before-oh-array(row,"offers")))))))))));
  def before-oh-pain(row) = node_eq(before-oh-get(row,"health"),json-node-int(0));
  def before-oh-unease(row) = and(before-oh-valid(row),or(before-oh-pain(row),or(node_eq(before-oh-get(row,"health"),json-node-null()),or(not(nil?(json-array-elements(before-oh-get(row,"needs")))),node_eq(before-oh-get(row,"surprise"),json-node-int(1))))));
  def before-oh-response(reading,selected) = before-oh-set(before-oh-set(before-oh-set(reading,"stage",json-node-string("response")),"selected",json-node-string(selected)),"at_ms",json-node-int(now_unix_ms()));
  def before-oh-select(reading,response,fallback) = if not(before-oh-valid(response)) then fallback else if not(and(str_eq(before-oh-key(reading),before-oh-key(response)),and(str_eq(before-oh-str(reading,"id"),before-oh-str(response,"id")),and(str_eq(before-oh-str(response,"stage"),"response"),before-oh-has(before-oh-values(json-array-elements(before-oh-get(reading,"offers"))),before-oh-str(response,"selected")))))) then fallback else before-oh-str(response,"selected");
  // Applied describes an action, never a repaired health reading.
  def before-oh-applied(reading,selected,result) = before-oh-set(before-oh-set(before-oh-set(before-oh-response(reading,selected),"stage",json-node-string("applied")),"result",result),"at_ms",json-node-int(now_unix_ms()));
  def before-oh-frame(row) = fb_record(intern_trivial_int(now_unix_ms()),"organ-health.bml",if before-oh-pain(row) then 1 else 0);
  def before-oh-emit(path,row) {
   if not(before-oh-valid(row)) then form_error("organ health event has no complete identity or observation") else before-oh-emit-valid(path,row);
  }
  def before-oh-emit-valid(path,row) {
   let text = str_concat(json-emit-precise(row),"\n");
   let wrote = sbt-append-count(path,text);
   let frame = before-oh-frame(row);
   // The byte-count door confirms this complete event. Absent and incomplete
   // writes keep their refusal through the shared transport.
   if or(nothing?(wrote),ne(wrote,str_len(text))) then form_error("organ health event transport is incomplete") else row;
  }
  def before-oh-voice(row) {
   let frame = before-oh-frame(row);
   print_str(str_concat("form-organ health ",str_concat(json-emit-precise(row),"\n")));
  }
  // every reading speaks, in order, and comes back as it was
  def before-oh-voice-all(rows) = if nil?(rows) then rows else before-oh-voice-then(before-oh-voice(head(rows)),rows);
  def before-oh-voice-then(said,rows) = cons(head(rows),before-oh-voice-all(tail(rows)));
  def before-oh-extract(row) = if str_eq(before-oh-str(row,"schema"),"organ-health-v1") then row else if json-object-has?(row,"health") then before-oh-get(row,"health") else json-node-null();
  def before-oh-key(row) = json-emit(json-node-array(list(before-oh-get(row,"organ"),before-oh-get(row,"flow"),before-oh-get(row,"aspect"))));
  def before-oh-replace(rows,row) = if nil?(rows) then list(row) else if str_eq(before-oh-key(head(rows)),before-oh-key(row)) then cons(row,tail(rows)) else cons(head(rows),before-oh-replace(tail(rows),row));
  def before-oh-observed(row) = if json-object-has?(row,"observed_at_ms") then row else before-oh-set(row,"observed_at_ms",before-oh-get(row,"at_ms"));
  def before-oh-find(rows,row) = if nil?(rows) then json-node-null() else if str_eq(before-oh-key(head(rows)),before-oh-key(row)) then head(rows) else before-oh-find(tail(rows),row);
  // Attention annotates an already observed identity. It never replaces the
  // organ's measured content, and a delayed annotation cannot revive old pain.
  def before-oh-attentions(rows,attention) = if nil?(rows) then list(attention) else if node_eq(before-oh-get(head(rows),"need"),before-oh-get(attention,"need")) then cons(attention,tail(rows)) else cons(head(rows),before-oh-attentions(tail(rows),attention));
  def before-oh-attention-reading(held,row) {
   let prior = before-oh-find(held,row);
   let bound = and(before-oh-valid(prior),str_eq(before-oh-str(prior,"id"),before-oh-str(row,"id")));
   if not(bound) then held else before-oh-replace(held,before-oh-set(before-oh-set(prior,"attention",before-oh-get(row,"attention")),"attentions",json-node-array(before-oh-attentions(if before-oh-array(prior,"attentions") then json-array-elements(before-oh-get(prior,"attentions")) else list(),before-oh-get(row,"attention")))));
  }
  def before-oh-control-metadata(held,row) {
   let clean = if json-object-has?(row,"care_need") then json-node-object(before-oh-without(json-object-pairs(held),"care_delivery")) else held;
   let responder = if json-object-has?(row,"responder") then before-oh-set(clean,"responder",before-oh-get(row,"responder")) else clean;
   let need = if json-object-has?(row,"care_need") then before-oh-set(responder,"care_need",before-oh-get(row,"care_need")) else responder;
   if json-object-has?(row,"care_of") then before-oh-set(need,"care_of",before-oh-get(row,"care_of")) else need;
  }
  def before-oh-control-reading(held,row) {
   let prior = before-oh-find(held,row);
   let bound = and(before-oh-valid(prior),and(str_eq(before-oh-str(prior,"id"),before-oh-str(row,"id")),before-oh-has(before-oh-values(json-array-elements(before-oh-get(prior,"offers"))),before-oh-str(row,"selected"))));
   if bound then before-oh-replace(held,before-oh-control-metadata(before-oh-set(before-oh-set(before-oh-set(before-oh-set(prior,"stage",before-oh-get(row,"stage")),"selected",before-oh-get(row,"selected")),"result",before-oh-get(row,"result")),"at_ms",before-oh-get(row,"at_ms")),row)) else before-oh-replace(held,before-oh-reading("health-flow",before-oh-str(row,"flow"),"control-correlation",json-node-string("response bound to an observed offer"),json-node-string(before-oh-str(row,"id")),json-node-int(0),list(before-oh-need("correlated-observation",before-oh-get(row,"evidence"))),list("request-evidence","defer"),before-oh-get(row,"evidence")));
  }
  def before-oh-current(rows,held) = if nil?(rows) then held else before-oh-current(tail(rows),if not(before-oh-valid(before-oh-extract(head(rows)))) then held else if str_eq(before-oh-str(before-oh-extract(head(rows)),"stage"),"observe") then if json-object-has?(before-oh-extract(head(rows)),"attention") then before-oh-attention-reading(held,before-oh-extract(head(rows))) else before-oh-replace(held,before-oh-observed(before-oh-extract(head(rows)))) else before-oh-control-reading(held,before-oh-extract(head(rows))));
  def before-oh-lines(lines,held) = if nil?(lines) then held else if str_eq(head(lines),"") then before-oh-lines(tail(lines),held) else before-oh-lines(tail(lines),before-oh-current(list(parse-json("organ-health-flow",head(lines))),held));
  // One transport chunk and the unfinished event are held while the file flows.
  // The current map grows with distinct organ/flow/aspect identities, not tokens.
  def before-oh-age(rows,now) = if nil?(rows) then list() else cons(before-oh-set(head(rows),"observation_age_ms",if json-object-has?(head(rows),"observed_at_ms") then json-node-int(sub(now,json-int-value(before-oh-get(head(rows),"observed_at_ms")))) else json-node-null()),before-oh-age(tail(rows),now));
  def before-oh-read(path) = before-oh-age(before-oh-read-from(path,0,"",list()),now_unix_ms());
  def before-oh-read-from(path,offset,pending,held) = if ge(offset,file_size(path)) then if str_eq(pending,"") then held else before-oh-lines(list(pending),held) else before-oh-read-chunk(path,offset,pending,held,read_file_slice(path,offset,65536));
  def before-oh-read-chunk(path,offset,pending,held,chunk) {
   let lines = split-on(str_concat(pending,chunk),"\n");
   let reversed = reverse(lines);
   if eq(str_len(chunk),0) then held else before-oh-read-from(path,add(offset,str_len(chunk)),head(reversed),before-oh-lines(reverse(tail(reversed)),held));
  }
 }
 0;
}
