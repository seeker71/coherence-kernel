// Exact parent implementation, namespace changed only for side-by-side reading.
// preludes: form-stdlib/native-edit.fk
section [form.bml] {
 let text = ne-replace-all(ne-replace-all(read_file(".hearth/organ-health-before.bml"),"oh-","before-oh-"),"class OrganHealth","class BeforeOrganHealth");
 if eq(write_file(".hearth/organ-health-reference.bml",text),str_len(text)) then 1 else form_error("reference write incomplete");
}
