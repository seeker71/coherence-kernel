// Observe the actual learner history through a fresh reader; keep full current values.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-evidence.bml form-stdlib/qwen35-artifact-seal-reader.fk
section [form.bml] {
 let label = read_line();
 if not(or(str_eq(label,"before"),str_eq(label,"after"))) then form_error("reader observation label") else 0;
 if nsm-running(hearth-session-learning()) then form_error("learner owns this flow") else 0;
 let prefix = str_concat(".hearth/reader-gap-",label);
 let source = "form/form-stdlib/bml/organ-health-stream.bml";
 write_file(str_concat(prefix,".source.bml"),read_file(source));
 let path = nsm-at(hearth-session-learning(),"events.jsonl"); let extent = file_size(path);
 let seal = qaf-string-hex(saj-file-digest-any-tail(path,extent));
 if not(eq(str_len(seal),64)) then form_error("event flow digest unavailable") else 0;
 let reader = nse-reader(hearth-session-learning()); let start = host_monotonic_ms(); let primary = kernel_stat(53);
 ohs-update(reader,extent);
 let elapsed = sub(host_monotonic_ms(),start); let minted = sub(kernel_stat(53),primary);
 let values = jv-emit(jv-array(record_get(reader,"current")));
 let exact = if str_eq(label,"after") then str_eq(values,read_file(".hearth/reader-gap-before.current.json")) else 1;
 if not(and(eq(file_size(path),extent),str_eq(seal,qaf-string-hex(saj-file-digest-any-tail(path,extent))))) then form_error("event history changed during comparison") else 0;
 if not(exact) then form_error("current observations changed") else 0;
 write_file(str_concat(prefix,".current.json"),values);
 let report = jv-object(list(jv-s("schema","native-reader-gap-v1"),jv-s("label",label),jv-n("pid",host_pid()),jv-s("source",path),jv-s("source_sha256",seal),jv-n("source_bytes",extent),jv-n("elapsed_ms",elapsed),jv-n("primary_mints",minted),jv-n("current_rows",len(record_get(reader,"current"))),jv-n("invalid_records",record_get(reader,"invalid_records")),jv-n("pending_bytes",str_len(record_get(reader,"pending"))),jv-n("current_exact",exact),jv-n("current_bytes",str_len(values))));
 let text = jv-emit(report); write_file(str_concat(prefix,".json"),text); print_str(str_concat(text,"\n"));
}
