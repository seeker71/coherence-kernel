// A retained native reader for an append-only organ flow. Only complete JSONL
// records become observations. A caller owns the reader and its work budget.
// preludes: form-stdlib/organ-health.bml form-stdlib/bml/json-view-parse.bml
section [form.bml] {
 class OrganHealthStream {
  def ohs-open(path,generation) {
   let owner = record_new(0,"path",path);
   record_set(owner,"identity",noc-open()); record_set(owner,"diagnostic_sequence",0);
   ohs-restart(owner,generation);
  }
  // A stream owns one mutable reader across publisher generations. Releasing
  // these references lets obsolete working values reach the current collector;
  // already returned reports hold their own immutable event values. Reader
  // identity and diagnostic sequence outlive publisher generations.
  def ohs-restart(owner,generation) {
   record_set(owner,"generation",generation); record_set(owner,"offset",0);
   record_set(owner,"pending",""); record_set(owner,"current",list());
   record_set(owner,"state","unobserved"); record_set(owner,"read_bytes",0);
   record_set(owner,"invalid_records",0); record_set(owner,"extent",0);
   owner;
  }
  def ohs-path(owner) = record_get(owner,"path");
  def ohs-smaller(a,b) = if le(a,b) then a else b;
  def ohs-identity(owner) {
   record_set(owner,"diagnostic_sequence",add(record_get(owner,"diagnostic_sequence"),1));
   str_concat(record_get(owner,"identity"),str_concat(":diagnostic:",int_to_str(record_get(owner,"diagnostic_sequence"))));
  }
  def ohs-correlation(row,owner) = ohv-correlation(ohs-identity(owner),row);
  def ohs-current(owner,row) = record_set(owner,"current",ohv-current-through(list(row),record_get(owner,"current"),ohs-correlation,owner));
  def ohs-diagnostic(owner,aspect,expected,observed) {
   let row = ohv-reading-with-id(ohs-identity(owner),"organ-health-reader",ohs-path(owner),aspect,jv-string(expected),observed,jv-int(0),list(ohv-need("complete-organ-evidence",ohv-reference(ohs-path(owner)))),list("request-evidence","defer"),ohv-reference(ohs-path(owner)));
   ohs-current(owner,row);
   ohv-frame(row);
  }
  def ohs-poll(owner,budget) { ohs-update(owner,budget); ohs-report(owner); }
  // Consume once; the caller chooses the representation of its report.
  def ohs-update(owner,budget) {
   if le(budget,0) then form_error("organ reading needs a positive byte work budget") else ohs-poll-size(owner,budget,file_size(ohs-path(owner)));
  }
  def ohs-poll-size(owner,budget,size) {
   record_set(owner,"read_bytes",0);
   record_set(owner,"extent",size);
   if lt(size,0) then ohs-unavailable(owner,"absent-or-unreadable") else if lt(size,record_get(owner,"offset")) then ohs-reset(owner,budget,size) else ohs-read(owner,budget,size);
  }
  def ohs-unavailable(owner,state) {
   record_set(owner,"state",state);
   owner;
  }
  def ohs-reset(owner,budget,size) {
   record_set(owner,"offset",0); record_set(owner,"pending",""); record_set(owner,"current",list());
   ohs-diagnostic(owner,"source-reset","append-only source generation",jv-int(size));
   ohs-read(owner,budget,size);
  }
  def ohs-read(owner,budget,extent) {
   let offset = record_get(owner,"offset");
   if ge(offset,extent) then ohs-settled(owner,"caught-up") else if le(budget,0) then ohs-settled(owner,"backlog") else ohs-chunk(owner,budget,extent,read_file_slice(ohs-path(owner),offset,ohs-smaller(65536,ohs-smaller(budget,sub(extent,offset)))));
  }
  def ohs-chunk(owner,budget,extent,chunk) {
   if or(nothing?(chunk),eq(str_len(chunk),0)) then ohs-unavailable(owner,"read-refused") else ohs-chunk-read(owner,budget,extent,chunk);
  }
  def ohs-chunk-read(owner,budget,extent,chunk) {
   let text = str_concat(record_get(owner,"pending"),chunk);
   let parts = reverse(split-on(text,"\n"));
   record_set(owner,"offset",add(record_get(owner,"offset"),str_len(chunk)));
   record_set(owner,"read_bytes",add(record_get(owner,"read_bytes"),str_len(chunk)));
   record_set(owner,"pending",head(parts));
   ohs-lines(owner,reverse(tail(parts)));
   ohs-read(owner,sub(budget,str_len(chunk)),extent);
  }
  def ohs-lines(owner,lines) = if nil?(lines) then 0 else { ohs-line(owner,head(lines)); ohs-lines(owner,tail(lines)); };
  def ohs-line(owner,line) {
   if str_eq(trim(line),"") then 0 else if not(jwa-valid(line)) then ohs-invalid(owner,"complete JSON record",jv-int(str_len(line))) else ohs-row(owner,jvp-admitted(line));
  }
  def ohs-invalid(owner,expected,observed) {
   record_set(owner,"invalid_records",add(record_get(owner,"invalid_records"),1));
   ohs-diagnostic(owner,"event-admission",expected,observed);
  }
  def ohs-row(owner,record) {
   let row = ohv-extract(record);
   if eq(jv-kind(row),8) then 0 else if not(ohv-valid(row)) then ohs-invalid(owner,"complete organ observation",jv-null()) else ohs-current(owner,row);
  }
  def ohs-settled(owner,state) {
   record_set(owner,"state",if and(str_eq(state,"caught-up"),gt(str_len(record_get(owner,"pending")),0)) then "awaiting-complete-record" else state);
   owner;
  }
  def ohs-view(owner) = jv-object(list(jv-s("source",ohs-path(owner)),jv-s("generation",record_get(owner,"generation")),jv-s("state",record_get(owner,"state")),jv-n("offset",record_get(owner,"offset")),jv-n("extent",record_get(owner,"extent")),jv-n("read_bytes",record_get(owner,"read_bytes")),jv-n("pending_bytes",str_len(record_get(owner,"pending"))),jv-n("invalid_records",record_get(owner,"invalid_records")),jv-pair("current",jv-array(ohv-age(record_get(owner,"current"),now_unix_ms())))));
  def ohs-report(owner) = jv-materialize(ohs-view(owner));
 }
 0;
}
