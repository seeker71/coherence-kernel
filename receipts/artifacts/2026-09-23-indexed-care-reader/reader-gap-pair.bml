// Sequential native observation of original and current reader implementations.
// preflight-exec: forbidden
section [form.bml] {
 let before = host_spawn(list("./fkwu",".hearth/reader-gap-before-run.bml"));
 if not(and(gt(before,0),eq(host_wait(before),0))) then form_error("original reader observation failed") else 0;
 let after = host_spawn(list("./fkwu",".hearth/reader-gap-after-run.bml"));
 if not(and(gt(after,0),eq(host_wait(after),0))) then form_error("indexed reader observation failed") else 0;
}
