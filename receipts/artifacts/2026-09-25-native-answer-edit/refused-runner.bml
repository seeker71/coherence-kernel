// Run the public native code door with progress-aware process supervision.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 let root = ".hearth/native-answer-edit-2026-09-25";
 let job = fhn-at(root,"process");
 if not(eq(host_dir_mkdir(job),1)) then form_error("answer-edit execution already retained") else 0;
 fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(fhn-s("root",fhn-root()))));
 let status = fhn-run(job,"code",0,"root",fhn-at(root,"input.txt"),list("./fkwu","observe/form-cli-code-run.fk"));
 let result = json-node-object(list(fhn-s("status",status),fhn-s("evidence",job)));
 fhn-write-json(fhn-at(root,"process-result.json"),result);
 print_str(json-emit(result));
}
