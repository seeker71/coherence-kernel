// Codex-selected editorial changes executed by Form's native guarded editor.
// This evaluated answer stays outside session learning.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def qaf-edit(state,old,replacement,checker) {
  let action = json-node-object(list(nsm-s("tool","edit"),json-node-pair("arguments",json-node-array(list(json-node-string("answer.md"),json-node-string(old),json-node-string(replacement))))));
  let next = fcap-step(state,json-emit(action),checker);
  if or(gt(fcap-failures(next),fcap-failures(state)),value_eq(fcap-docs(next),fcap-docs(state))) then form_error(fcap-note(next)) else next;
 }
 def qaf-text(docs,path) = if nil?(docs) then form_error("edited document absent") else if str_eq(fcap-string(head(docs),"path"),path) then fcap-string(head(docs),"text") else qaf-text(tail(docs),path);
 let root = ".hearth/native-answer-edit-2026-09-25";
 let request = parse-json("request",read_file(frsh-path(root,"request.json")));
 let result = parse-json("result",read_file(frsh-path(root,"result.json")));
 let decoded = fat-wire-documents(result);
 if not(str_eq(fat-wire-error(decoded),"")) then form_error(fat-wire-error(decoded)) else 0;
 let checker = fcaq-live-checker(request);
 let state = fcap-open-direct-code("Apply the explicit reviewer-selected editorial corrections; retain all original source checks and source documents.",fat-wire-value(decoded),list("answer.md"));
 let first = qaf-edit(state,"This means the response can be direct and open, without permission gates or approval queues.","Within the work you asked for, trust means taking the next useful action and naming uncertainty where the evidence ends.",checker);
 let second = qaf-edit(first,"The response is warm, direct, and free of self-assessment. ","",checker);
 let final = qaf-edit(second," It lifts the enquiry by connecting ground to direction, leaving the person more grounded, more stretched, and more free.","",checker);
 let docs = fat-wire-documents-node(fcap-docs(final));
 let assessment = oh-set(request,"documents",docs);
 let checks = frr-source(assessment);
 if not(head(checks)) then form_error(nth(checks,1)) else 0;
 let rows = node_children(docs);
 let answer = qaf-text(rows,"answer.md");
 let original = node_children(json-object-get(result,"documents"));
 let observed = json-node-object(list(nsm-s("selection","Codex review of completed public native answer"),nsm-s("execution","Form native guarded edit"),nsm-n("model_generation_calls",0),nsm-n("edits",fcap-calls(final)),nsm-n("original_words",fal-count(qaf-text(original,"answer.md"))),nsm-n("final_words",fal-count(answer)),nsm-n("original_checks",head(checks)),nsm-s("check_observation",nth(checks,1)),nsm-n("source_unchanged",str_eq(qaf-text(original,"enquiry.txt"),qaf-text(rows,"enquiry.txt"))),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("evaluation",1),json-node-pair("felt_resonance",json-node-null())));
 frsh-frozen(frsh-path(root,"editorial-answer.txt"),answer);
 frsh-frozen(frsh-path(root,"editorial-comparison.json"),json-emit(observed));
 print_str(json-emit(observed)); print_str("\n"); print_str(answer);
}
