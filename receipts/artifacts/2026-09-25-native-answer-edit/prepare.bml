// Build a real document-edit request from the retained public failure.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let previous = parse-json("previous",read_file(".hearth/native-compose-care-2026-09-23/request.json"));
 let assessment = json-object-get(previous,"assessment");
 let originalDocs = node_children(json-object-get(assessment,"documents"));
 let answer = read_file("receipts/artifacts/2026-09-25-qwen-response-learning/answer.txt");
 let goal = "Edit answer.md into the complete useful answer to Urs's ORIGINAL ENQUIRY in enquiry.txt. This is a document-editing task: use native write or guarded edit on answer.md, then verify the actual changed document and complete review. The sources in enquiry.txt are read-only. The retained 509-word draft repeated byte for byte after its length correction; do not resubmit it. Concrete edits: replace the opening process history and unsupported claim that the shield was a structural failure with the practical value Form adds to this exchange. Restore the explicit distinction between 0, 1 and nothing, connecting absence to how a reply treats missing evidence. Correct the tokenizer claim: the tokenizer encodes, the model decoder predicts. Explain frequency arithmetic as the supplied annotations' intensity-weighted valence and contracted fraction; keep Urs's felt resonance separate. Preserve the reference-conditioned lifetime distinction, unreferenced reclamation, external-file boundary, and separation of graph identity, vocabulary anchors and model token IDs. Keep one supplied translation example and connect meaning to a response decision. Preserve the two independently advancing paths: native responses and enrichment of the arriving mind. Remove repeated discussion of the shield, meta-commentary about this work, self-assessment and repeated explanations. All six requested axes must contribute to the answer, with warmth and directness, in the unchanged 350-450 whitespace-delimited words. Aim near 400. Read the final document for source fidelity and useful response quality; passing the word count alone does not establish either. No result in this packet establishes felt resonance or an out-of-box baseline.";
 let request = json-node-object(list(
  nsm-s("goal",goal),nsm-s("mode","code"),nsm-s("code_entry","direct"),nsm-s("model","qwen38-q8"),
  nsm-n("context",16384),nsm-n("turns",12),nsm-n("max_reply_tokens",2048),nsm-n("evaluation",1),
  json-node-pair("documents",json-node-array(list(json-node-object(list(nsm-s("id","answer"),nsm-s("path","answer.md"),nsm-s("text",answer))),nth(originalDocs,1)))),
  json-node-pair("writable",json-node-array(list(json-node-string("answer.md")))),
  json-node-pair("checks",json-object-get(assessment,"checks"))));
 if not(fcaq-request-valid(request)) then form_error(fcaq-request-refusal(request)) else 0;
 let root = ".hearth/native-answer-edit-2026-09-25";
 if not(eq(host_dir_mkdir(root),1)) then form_error("answer-edit request already retained") else 0;
 frsh-frozen(frsh-path(root,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(root,"original-answer.txt"),answer);
 print_str(json-emit(json-node-object(list(nsm-s("request",frsh-path(root,"request.json")),nsm-s("original_answer_sha256",nsm-hash(answer)),nsm-n("original_words",fal-count(answer)),nsm-n("evaluation",1),nsm-s("boundary","same enquiry and source, actual writable answer, original word-range check; task representation and caller guidance changed; evaluated content excluded from learning")))));
}
