// Read the completed public code result, never its private reply evidence.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 def qae-final(rows) = if nil?(rows) then form_error("completed native code result absent") else {
  let line = head(rows);
  if not(faj-valid(line)) then qae-final(tail(rows)) else {
   let row = parse-json("public-code-result",line);
   if str_eq(fcap-string(row,"schema"),"form-native-code-v1") then row else qae-final(tail(rows));
  };
 };
 def qae-doc(rows,path) = if nil?(rows) then form_error(str_concat("result document absent: ",path)) else if str_eq(fcap-string(head(rows),"path"),path) then fcap-string(head(rows),"text") else qae-doc(tail(rows),path);
 def qae-copy(from,to) {
  let bytes = read_file(from);
  if not(str_eq(value_kind(bytes),"string")) then form_error(str_concat("evidence absent: ",from)) else frsh-frozen(to,bytes);
 }
 def qae-retain(root,output,names) = if nil?(names) then 1 else {
  qae-copy(frsh-path(root,head(names)),frsh-path(output,head(names)));
  qae-retain(root,output,tail(names));
 };
 let root = ".hearth/native-answer-edit-2026-09-25";
 if le(file_size(frsh-path(root,"process-result.json")),0) then form_error("native process has no terminal receipt") else 0;
 let job = fcap-string(fhn-json(frsh-path(root,"admission.json")),"evidence");
 let result = qae-final(reverse(split-on(read_file(fhn-stage-path(job,"code",".out")),"\n")));
 let docs = node_children(json-object-get(result,"documents"));
 let request = fhn-json(frsh-path(root,"request.json"));
 let originalDocs = node_children(json-object-get(request,"documents"));
 let answer = qae-doc(docs,"answer.md");
 let before = qae-doc(originalDocs,"answer.md");
 let checked = frr-source(fhn-put(request,"documents",json-object-get(result,"documents")));
 let summary = json-node-object(list(
  nsm-s("status",fcap-string(result,"status")),nsm-s("reason",fcap-string(result,"reason")),
  json-node-pair("release_ok",json-object-get(result,"release_ok")),json-node-pair("turns",json-object-get(result,"turns")),
  json-node-pair("tool_calls",json-object-get(result,"tool_calls")),json-node-pair("repair_attempts",json-object-get(result,"repair_attempts")),
  json-node-pair("generated_ids",json-object-get(result,"generated_ids")),json-node-pair("injected_ids",json-object-get(result,"injected_ids")),
  nsm-n("original_words",fal-count(before)),nsm-n("final_words",fal-count(answer)),
  nsm-n("answer_changed",not(str_eq(before,answer))),nsm-n("source_unchanged",str_eq(qae-doc(originalDocs,"enquiry.txt"),qae-doc(docs,"enquiry.txt"))),
  nsm-n("current_original_checks",head(checked)),nsm-s("answer_sha256",nsm-hash(answer)),
  nsm-n("evaluation",1),nsm-n("provider_calls",0),json-node-pair("semantic_quality",json-node-null())));
 frsh-frozen(frsh-path(root,"result.json"),json-emit(result));
 frsh-frozen(frsh-path(root,"answer.txt"),answer);
 frsh-frozen(frsh-path(root,"comparison.json"),json-emit(summary));
 frsh-frozen(frsh-path(root,"current-checks.json"),json-emit(json-node-object(list(nsm-n("passed",head(checked)),nsm-s("observed",nth(checked,1))))));
 let output = "receipts/artifacts/2026-09-25-native-answer-edit";
 if not(eq(host_dir_mkdir(output),1)) then form_error("answer-edit artifact export already retained") else 0;
 qae-retain(root,output,list("request.json","original-answer.txt","result.json","answer.txt","comparison.json","current-checks.json","editorial-answer.txt","editorial-comparison.json","coordinator-cost.json","process-refusal.json","refused-runner.bml"));
 qae-copy(".hearth/native-answer-edit-prepare.bml",frsh-path(output,"prepare.bml"));
 qae-copy(".hearth/native-answer-edit-run.bml",frsh-path(output,"run.bml"));
 qae-copy(".hearth/native-answer-edit-export.bml",frsh-path(output,"export.bml"));
 qae-copy(".hearth/native-answer-edit-finish.bml",frsh-path(output,"editorial-finish.bml"));
 let process = fhn-json(fhn-stage-path(job,"code",".process.json"));
 let processRecord = json-node-object(list(json-node-pair("state",json-object-get(process,"state")),json-node-pair("returncode",json-object-get(process,"returncode")),json-node-pair("elapsed_ms",json-object-get(process,"elapsed_ms")),json-node-pair("supervision",json-object-get(process,"supervision")),json-node-pair("cleanup",json-object-get(process,"cleanup")),json-node-pair("output_drains",json-object-get(process,"output_drains"))));
 frsh-frozen(frsh-path(output,"process.json"),json-emit(processRecord));
 print_str(json-emit(summary)); print_str("\n"); print_str(answer);
}
