// Rebuild only the diagnostic from the original row's retained projection values.
// This does not repeat the model computation or update a gradient.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class ProjectionHealthReobserve {
  def phr-find(rows) = if nil?(rows) then json-node-object(list()) else {
   let row = parse-json("training-event",head(head(rows)));
   if str_eq(nsm-str(row,"stage"),"row-head-check") then row else phr-find(tail(rows));
  };
 }
 let path = nsm-at(hearth-session-learning(),"rows/ebb4fc485697b97d8cc475f6686dc11241f13c968dc0feb65b0e2800663451fe/adapter/training-events.jsonl");
 let observed = phr-find(nld-file(path));
 if not(str_eq(nsm-str(observed,"stage"),"row-head-check")) then form_error("original projection observation absent") else 0;
 let old = oh-get(observed,"health"); let evidence = oh-get(old,"evidence");
 let checked = list(nsm-num(old,"health"),nsm-num(evidence,"row"),nsm-num(evidence,"max_absolute_difference"),nsm-num(evidence,"nonfinite"));
 let fresh = ntr-head-reading(nsm-str(old,"flow"),nsm-num(observed,"line"),checked);
 let result = json-node-object(list(nsm-s("scope","diagnostic replay of retained original projection values; no model or gradient execution"),nsm-s("source",path),json-node-pair("original",observed),json-node-pair("reobserved",fresh)));
 nsm-write(".hearth/projection-health-reobserved.json",result); print_str(json-emit-precise(result));
 if not(and(eq(nsm-num(fresh,"health"),1),eq(nsm-num(fresh,"surprise"),0))) then form_error("exact original projection retained a false alarm") else 0;
}
