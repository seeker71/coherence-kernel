// Compare the original whole-row training objective with its same-parent assessment.
// Reads existing real work; admits no model and makes no optimizer update.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class LearningLossReobserve {
  def llr-event(rows) = if nil?(rows) then json-node-object(list()) else if and(str_eq(nsm-str(head(rows),"stage"),"row"),eq(nsm-num(head(rows),"line"),1)) then head(rows) else llr-event(tail(rows));
  def llr-score(rows,id) = if nil?(rows) then json-node-object(list()) else if str_eq(nsm-str(head(rows),"row_sha256"),id) then head(rows) else llr-score(tail(rows),id);
  def llr-admitted(rows) = if nil?(rows) then json-node-object(list()) else if str_eq(nsm-str(head(rows),"stage"),"admitted") then head(rows) else llr-admitted(tail(rows));
 }
 let rowRoot = nsm-at(hearth-session-learning(),"rows/ebb4fc485697b97d8cc475f6686dc11241f13c968dc0feb65b0e2800663451fe");
 let training = head(nsl-examples(nld-file(nsm-at(rowRoot,"train.jsonl"))));
 let id = nsm-hash(json-emit-precise(training));
 let events = nsl-examples(nld-file(nsm-at(rowRoot,"adapter/training-events.jsonl")));
 let event = llr-event(events); let admitted = llr-admitted(events);
 let parent = nsm-str(nsm-json(nsm-at(rowRoot,"before.json")),"parent");
 if not(and(gt(str_len(parent),0),str_eq(parent,nsm-str(admitted,"adapter")))) then form_error("training and assessment parent do not bind") else 0;
 let score = llr-score(json-array-elements(nsm-json(nsm-at(rowRoot,"adapter/assessment-before.json"))),id);
 let bound = and(str_eq(id,"2af5f66f6f0fd71946238b2c69767b450a60e6a3f91565cc46d7f51e187f4b3c"),and(eq(nsm-num(score,"input_tokens"),nsm-num(event,"input_tokens")),and(eq(nsm-num(score,"supervised_tokens"),nsm-num(event,"supervised_tokens")),str_eq(nsm-str(event,"stage"),"row"))));
 if not(bound) then form_error("original example or loss observation does not bind") else 0;
 let delta = sub(nsm-num(event,"sequence_loss"),nsm-num(score,"loss"));
 let difference = if lt(delta,0.0) then sub(0.0,delta) else delta;
 let result = json-node-object(list(nsm-s("scope","whole-row and sliced loss of the same parent; no new training or quality claim"),nsm-s("training_root",rowRoot),nsm-s("parent",parent),nsm-s("original_example_sha256",id),nsm-n("input_tokens",nsm-num(event,"input_tokens")),nsm-n("supervised_tokens",nsm-num(event,"supervised_tokens")),nsm-real("absolute_loss_difference",difference),json-node-pair("training",event),json-node-pair("assessment",score),json-node-pair("admission",admitted)));
 nsm-write(".hearth/learning-loss-reobserved.json",result); print_str(json-emit-precise(result));
}
