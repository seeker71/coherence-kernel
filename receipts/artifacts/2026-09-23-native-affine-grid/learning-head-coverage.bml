// Observe the actual long-row output projection against independent row calls.
// No optimizer update, serving change, source mutation or model generation.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class LearningHeadCoverage {
  def lhc-row(view,x,whole,t,d,v,row) {
   let input = nam-alloc(d); let actual = nam-alloc(v); let reference = nam-alloc(v); let difference = nam-alloc(v);
   nll-last(x,input,d,mul(row,d)); nll-last(whole,actual,v,mul(row,v));
   nam-linear(view,input,reference,1,0); nam-add(actual,reference,difference,v,-1.0); nam-sync();
   let observed = nam-stats(actual,v); let expected = nam-stats(reference,v); let delta = nam-stats(difference,v);
   let result = json-node-object(list(nsm-n("row",row),nsm-real("actual_squared",nth(observed,1)),nsm-real("reference_squared",nth(expected,1)),nsm-real("max_absolute_difference",nth(delta,2)),nsm-real("nonfinite",add(head(observed),head(expected)))));
   nam-free(list(input,actual,reference,difference)); result;
  }
  def lhc-rows(view,x,whole,t,d,v,rows) = if nil?(rows) then list() else cons(lhc-row(view,x,whole,t,d,v,head(rows)),lhc-rows(view,x,whole,t,d,v,tail(rows)));
 }
 let root = ".hearth/answer-edit-reasoning-2026-09-23";
 let name = read_line();
 let report = if or(nothing?(name),str_eq(name,"")) then "head-coverage-before.json" else name;
 let training = nsm-at(hearth-session-learning(),"rows/ccb671796a21dbd30b2a8fc18d3d304c0eb34db9c24d53bc13d6d21134c67f72");
 let before = nsm-json(nsm-at(training,"before.json"));
 let started = host_monotonic_ms(); let session = nlg-open(nsm-model(),nsm-str(before,"parent"));
 let model = head(session); let g = head(model); let d = nth(g,0); let v = nth(g,5); let view = nth(model,2);
 let rows = nsl-examples(nld-file(nsm-at(training,"train.jsonl")));
 let sample = nld-row(nth(session,1),nth(rows,2),1,3); let ids = head(sample); let t = len(ids);
 let ib = nam-write(nam-alloc(t),md-le32-list(ids,"")); let x = nam-alloc(mul(t,d)); let logits = nam-alloc(mul(t,v));
 nam-embed(view,ib,x,t); nam-linear(view,x,logits,t,0); nam-sync();
 let observed = lhc-rows(view,x,logits,t,d,v,list(0,1023,2047,3000,sub(t,1)));
 nam-free(list(ib,x,logits)); nlg-close(session);
 let result = json-node-object(list(nsm-n("tokens",t),nsm-n("width",d),nsm-n("vocabulary",v),nsm-n("groups",mul(t,v)),nsm-n("threads",mul(32,mul(t,v))),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started)),nsm-n("retained_buffers",nth(metal_live(),2)),json-node-pair("rows",json-node-array(observed))));
 nsm-write(nsm-at(root,report),result); print_str(json-emit-precise(result));
}
