// Re-observe the retained native review after delivering shared Form meanings.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let raw = read_file(".hearth/native-fidelity-review.request.json");
 let request = parse-json("original-review-request",raw);
 fcr-need(fcaq-evaluation(request),"native review remains excluded from training");
 let before = read_file(".hearth/native-fidelity-bootstrap-before.txt");
 let after = read_file(".hearth/native-fidelity-bootstrap-after.txt");
 let meaning = fqt-meaning-prefix(); let at = str_find(after,meaning,0);
 fcr-need(and(ge(at,0),lt(str_find(before,meaning,0),0)),"actual bootstrap must newly receive shared meanings");
 let restored = str_concat(substring(after,0,at),substring(after,add(at,str_len(meaning)),str_len(after)));
 fcr-need(str_eq(before,restored),"caller request or protocol changed alongside meaning delivery");
 let docs = fat-wire-value(fat-wire-documents(request));
 let state = fcap-begin-context(fcaq-prepare(request,docs,fcaq-live-checker(request),hearth-code-memory()));
 let bootstrap = fcac-bootstrap-budget(state,add(fcap-turns(state),fcaq-number(request,"turns",64)));
 fcr-need(str_eq(bootstrap,after),"executing review bootstrap differs from retained delivery");
 frsh-frozen(".hearth/native-fidelity-meaning.request.json",raw);
 let delivery = json-node-object(list(oh-n("before_bytes",str_len(before)),oh-n("after_bytes",str_len(after)),oh-n("shared_meaning_bytes",str_len(meaning)),oh-n("remaining_bootstrap_exact",1),oh-s("request_sha256",nsm-hash(raw)),oh-s("bootstrap_sha256",nsm-hash(after)),oh-n("evaluation",1)));
 frsh-frozen(".hearth/native-fidelity-meaning.delivery.json",json-emit(delivery));
 print_str(str_concat("meaning-delivery ",str_concat(json-emit(delivery),"\n")));
 let waiting = host_monotonic_ms();
 let settled = nsm-settle(hearth-session-learning());
 nsm-settle-exit(settled);
 fcr-need(not(nsm-running(hearth-session-learning())),"learner still owns model resources");
 let waited = sub(host_monotonic_ms(),waiting);
 print_str(str_concat("learner-released; wait-ms=",str_concat(int_to_str(waited),"\n")));
 let started = host_monotonic_ms();
 let result = fcaq-call(raw);
 frsh-frozen(".hearth/native-fidelity-meaning.result.json",result);
 let parsed = parse-json("native-review-result",result);
 frsh-frozen(".hearth/native-fidelity-meaning.report.json",oh-str(parsed,"report"));
 let summary = json-node-object(list(oh-s("status",oh-str(parsed,"status")),oh-s("reason",oh-str(parsed,"reason")),json-node-pair("tool_calls",oh-get(parsed,"tool_calls")),json-node-pair("generated_ids",oh-get(parsed,"generated_ids")),json-node-pair("release_ok",oh-get(parsed,"release_ok")),oh-n("elapsed_ms",sub(host_monotonic_ms(),started)),oh-n("learner_wait_ms",waited),oh-n("provider_calls",0),oh-s("report_path",".hearth/native-fidelity-meaning.report.json"),json-node-pair("semantic_quality",json-node-null())));
 frsh-frozen(".hearth/native-fidelity-meaning.summary.json",json-emit(summary));
 print_str(str_concat(json-emit(summary),"\n"));
}
