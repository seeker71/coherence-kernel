// Materialize the exact review bootstrap without admitting a model.
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let path = read_line();
 fcr-need(and(not(nothing?(path)),gt(str_len(path),0)),"bootstrap evidence path required");
 let request = parse-json("review-request",read_file(".hearth/native-fidelity-review.request.json"));
 fcr-need(fcaq-evaluation(request),"review must remain excluded from training");
 let docs = fat-wire-value(fat-wire-documents(request));
 let state = fcap-begin-context(fcaq-prepare(request,docs,fcaq-live-checker(request),hearth-code-memory()));
 let bootstrap = fcac-bootstrap-budget(state,add(fcap-turns(state),fcaq-number(request,"turns",64)));
 frsh-frozen(path,bootstrap);
 print(list("bootstrap-bytes",str_len(bootstrap),"evaluation",1,"model-calls",0,"provider-calls",0));
}
