// Re-observe the actual retained answer through the unchanged caller check.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let request = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let prior = nsm-json("receipts/artifacts/2026-09-23-native-json-completion/result.json");
 let docs = fat-wire-value(fat-wire-documents(prior));
 let checked = fcaq-check(json-array-elements(json-object-get(request,"checks")),docs);
 let answer = fat-find-doc(docs,"answer.md");
 let row = json-node-object(list(nsm-s("candidate_sha256",fat-document-sha(answer)),nsm-n("passed",head(checked)),nsm-s("observation",nth(checked,1)),nsm-n("model_calls",0),nsm-n("provider_calls",0)));
 print_str(json-emit(row));
 nsm-write(".hearth/word-care-reobserved.json",row);
}
