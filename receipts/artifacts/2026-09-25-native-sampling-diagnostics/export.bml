// Export completed public CLI output; private generation files stay closed.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 class NativeSamplingDiagnosticsExport {
  def nsde-int(node,key) = json-int-value(json-object-get(node,key));
  def nsde-text(node,key) = json-string-value(json-object-get(node,key));
  def nsde-archive(path,text) = json-node-object(list(nsm-s("schema","verbatim-public-artifact-v1"),nsm-s("original_path",path),nsm-n("bytes",str_len(text)),nsm-s("sha256",nsm-hash(text)),nsm-s("text",text)));
 }
 let logPath = ".hearth/native-sampling-diagnostics-cli.log";
 let log = read_file(logPath); let marker = "form-native-generation ";
 let start = str_find(log,marker,0);
 if lt(start,0) then form_error("public generation result absent") else 0;
 let begin = add(start,str_len(marker)); let end = str_find(log,"\n",begin);
 let textMarker = "\ntext:\n"; let textAt = str_find(log,textMarker,end);
 let textStart = add(textAt,str_len(textMarker)); let textEnd = str_find(log,"\nform-cli> ",textStart);
 if or(lt(end,0),or(lt(textAt,0),lt(textEnd,0))) then form_error("public generation response incomplete") else 0;
 let report = parse-json("public-generation",substring(log,begin,end));
 let answer = substring(log,textStart,textEnd);
 if not(eq(fal-count(answer),nsde-int(report,"final_words"))) then form_error("public answer count does not reconcile") else 0;
 let baselineRoot = "receipts/artifacts/2026-09-25-native-sampling";
 let baseline = parse-json("baseline",read_file(frsh-path(baselineRoot,"report.json")));
 let packet = parse-json("retained-prompt",read_file(frsh-path(baselineRoot,"prompt.txt.json")));
 let prompt = read_file(".hearth/native-direct-application-2026-09-25/prompt.txt");
 if not(str_eq(prompt,nsde-text(packet,"text"))) then form_error("comparison prompt changed") else 0;
 let req = parse-json("original-assertions",read_file("receipts/artifacts/2026-09-25-native-applied-response/request.json"));
 let beforeDocs = fat-wire-value(fat-wire-documents(req)); let before = fat-find-doc(beforeDocs,"answer.md");
 let docs = fat-put-doc(beforeDocs,list(head(before),nth(before,1),answer));
 let checked = fcaq-check(node_children(json-object-get(req,"checks")),docs);
 let initialSampling = json-object-get(report,"sampling_before_length_check");
 let finalSampling = json-object-get(report,"sampling");
 let initialStats = json-object-get(initialSampling,"diagnostics");
 let finalStats = json-object-get(finalSampling,"diagnostics");
 let revisionStats = json-node-object(list(
  nsm-n("draws",sub(nsde-int(finalSampling,"draws"),nsde-int(initialSampling,"draws"))),
  nsm-n("non_argmax_draws",sub(nsde-int(finalStats,"non_argmax_draws"),nsde-int(initialStats,"non_argmax_draws"))),
  nsm-n("singleton_nucleus_draws",sub(nsde-int(finalStats,"singleton_nucleus_draws"),nsde-int(initialStats,"singleton_nucleus_draws"))),
  nsm-n("nucleus_candidates_total",sub(nsde-int(finalStats,"nucleus_candidates_total"),nsde-int(initialStats,"nucleus_candidates_total")))));
 let comparison = json-node-object(list(
  nsm-s("schema","native-sampling-diagnostics-comparison-v1"),nsm-s("prompt_sha256",nsm-hash(prompt)),
  nsm-n("same_prompt",1),nsm-n("same_prompt_ids",eq(nsde-int(baseline,"prompt_ids"),nsde-int(report,"prompt_ids"))),
  nsm-n("same_context",eq(nsde-int(baseline,"context"),nsde-int(report,"context"))),
  nsm-n("same_seed",eq(nsde-int(json-object-get(baseline,"sampling"),"seed"),nsde-int(finalSampling,"seed"))),
  nsm-n("same_answer_allowance",eq(nsde-int(baseline,"answer_allowance"),nsde-int(report,"answer_allowance"))),
  nsm-n("same_final_answer",str_eq(read_file(frsh-path(baselineRoot,"answer.txt")),answer)),
  nsm-s("answer_sha256",nsm-hash(answer)),nsm-s("length_revision_change",nsde-text(report,"length_revision_change")),
  json-node-pair("initial_sampling",initialSampling),json-node-pair("revision_diagnostics",revisionStats),
  nsm-n("original_assertions_passed",head(checked)),nsm-s("assertion_observation",nth(checked,1)),
  nsm-s("attribution","Qwen3.8-27B-Q8_0 via source-backed form-cli; same seeded policy and caller packet; scalar diagnostics added"),
  nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null())));
 let target = "receipts/artifacts/2026-09-25-native-sampling-diagnostics";
 frsh-frozen(frsh-path(target,"report.json"),json-emit(report));
 frsh-frozen(frsh-path(target,"answer.txt"),answer);
 frsh-frozen(frsh-path(target,"comparison.json"),json-emit(comparison));
 let archived = json-emit(nsde-archive(logPath,log));
 if not(str_eq(nsde-text(parse-json("archived",archived),"text"),log)) then form_error("public log archive changed bytes") else 0;
 frsh-frozen(frsh-path(target,"public-cli.log.json"),archived);
 frsh-frozen(frsh-path(target,"coordinator-cost.json"),read_file(".hearth/native-sampling-diagnostics-coordinator-cost.json"));
 print_str(json-emit(comparison));
}
