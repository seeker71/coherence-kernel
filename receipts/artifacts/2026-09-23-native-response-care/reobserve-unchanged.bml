// Actual native reply nine, replayed through the repaired amendment boundary.
// stdin: prior report path, public action path, output path.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let prior = read_file(read_line());
 let action = read_file(read_line());
 let output = read_line();
 let request = nsm-json("receipts/artifacts/2026-09-23-native-current-task/request.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let before = fcap-step(initial,json-emit(json-node-object(list(json-node-pair("report",parse-json("prior",prior))))),fcaq-checker(request));
 let after = fcap-step(before,action,fcaq-checker(request));
 let same = str_eq(fcap-report(before),fcap-report(after));
 let checks = sub(fcap-checks(after),fcap-checks(before));
 let changed = sub(len(fcap-amendments(after)),len(fcap-amendments(before)));
 let diagnosed = ge(str_find(fcap-note(after),"report values unchanged",0),0);
 if not(and(same,and(eq(checks,0),and(eq(changed,0),diagnosed)))) then form_error("actual unchanged amendment was not retained without another check") else 0;
 let result = json-node-object(list(nsm-s("source","completed local Qwen public reply nine"),nsm-n("report_retained",same),nsm-n("source_documents_unchanged",value_eq(fcap-docs(before),fcap-docs(after))),nsm-n("new_check_runs",checks),nsm-n("new_amendments",changed),nsm-s("observation",fcap-note(after)),nsm-s("stage",fcap-stage(after)),nsm-n("model_calls",0)));
 nsm-write(output,result);
 print_str(json-emit(result));
}
