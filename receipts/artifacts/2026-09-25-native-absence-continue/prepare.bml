// Continue the actual incomplete candidate with its newly compact failure.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let priorRoot = ".hearth/native-absence-review-2026-09-25";
 let root = ".hearth/native-absence-continue-2026-09-25";
 fs_mkdir(root);
 let original = parse-json("request",read_file(frsh-path(priorRoot,"request.json")));
 let result = parse-json("completed-result",read_file(frsh-path(priorRoot,"result.json")));
 if not(and(eq(json-int-value(json-object-get(result,"release_ok")),1),str_eq(fcap-string(result,"reason"),"coding-reply-context-capacity"))) then form_error("prior owned run has no matching released outcome") else 0;
 let docs = fat-wire-value(fat-wire-documents(result));
 let checked = fcaq-check(node_children(json-object-get(original,"checks")),docs);
 if head(checked) then form_error("retained candidate no longer fails") else 0;
 let evidence = str_concat("The completed native candidate changed the opening trust sentence but retained the conflicting claim later in that paragraph. Complete the original repair by changing that remaining sentence. The original word range and all four absence assertions still apply. This is the actual check of the retained candidate, with the same source identities; the full enquiry remains available through native read.\n\n",nth(checked,1));
 let currentDocs = list(fat-find-doc(docs,"answer.md"),fat-find-doc(docs,"enquiry.txt"),list("caller-findings","repair-evidence.txt",evidence));
 let request = oh-set(original,"documents",fat-wire-documents-node(currentDocs));
 if not(fcaq-request-valid(request)) then form_error(fcaq-request-refusal(request)) else 0;
 let prompt = fcac-bootstrap-budget(fcaq-initial(request,currentDocs),fcaq-number(request,"turns",0));
 let path = mr-path(mr-find(fcap-string(request,"model")));
 let encoded = qtlc-drain(fcmg-chat-cursor-profile(path,prompt,"knowledge-query",qsx-load(path)));
 if not(str_eq(head(encoded),"done")) then form_error("continuation prompt tokenization failed") else 0;
 let admission = json-node-object(list(nsm-n("prompt_ids",len(nth(encoded,1))),nsm-n("context",fcaq-number(request,"context",0)),nsm-n("max_reply_tokens",fcaq-number(request,"max_reply_tokens",0)),nsm-n("all_original_checks_retained",faj-equal(json-object-get(original,"checks"),json-object-get(request,"checks"))),nsm-n("enquiry_unchanged",value_eq(fat-find-doc(docs,"enquiry.txt"),fat-find-doc(currentDocs,"enquiry.txt"))),nsm-n("initial_checks_passed",head(checked)),nsm-s("answer_sha256",nsm-hash(nth(fat-find-doc(currentDocs,"answer.md"),2))),nsm-s("changed_context","Latest compact failure replaces earlier caller-findings text; retained native candidate becomes the starting answer; goal, checks, allowances and enquiry are unchanged.")));
 frsh-frozen(frsh-path(root,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(root,"input.txt"),str_concat("@",str_concat(root,"/request.json\n")));
 frsh-frozen(frsh-path(root,"admitted-context.txt"),prompt);
 frsh-frozen(frsh-path(root,"pre-admission.json"),json-emit(admission));
 print_str(json-emit(admission));
}
