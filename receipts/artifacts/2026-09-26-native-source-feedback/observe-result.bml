// Observe the public terminal result of the existing resumed repair.
// Retain original assertions and distinguish this admission from prior work.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nsfr-last(text,marker,from,found) {
  let at=str_find(text,marker,from);
  if lt(at,0) then found else nsfr-last(text,marker,add(at,str_len(marker)),at);
 }
 def nsfr-line(log,at) {
  let end=str_find(log,"\n",at);
  if or(lt(at,0),lt(end,0)) then form_error("public terminal observation is unavailable or incomplete") else substring(log,at,end);
 }
 def nsfr-has(text,fragment) = ge(str_find(text,fragment,0),0);
 let root="receipts/artifacts/2026-09-26-native-source-feedback";
 let priorRoot="receipts/artifacts/2026-09-26-native-source-review";
 let logPath=".hearth/native-source-feedback/public-cli.log"; let log=read_file(logPath);
 let raw=nsfr-line(log,str_find(log,"{\"schema\":\"form-native-code-v1\"",0));
 if not(faj-valid(raw)) then form_error("public native result is invalid JSON") else 0;
 let result=parse-json("resumed-public-result",raw);
 let request=nsm-json(frsh-path(priorRoot,"feedback-request.json"));
 let prior=nsm-json(frsh-path(priorRoot,"terminal-result.json"));
 let supplied=fat-wire-documents(request); let returned=fat-wire-documents(result); let previous=fat-wire-documents(prior);
 if not(and(str_eq(fat-wire-error(supplied),""),and(str_eq(fat-wire-error(returned),""),str_eq(fat-wire-error(previous),"")))) then form_error("public source documents unavailable") else 0;
 let original=fat-wire-value(supplied); let after=fat-wire-value(returned); let before=fat-wire-value(previous);
 let answer=nth(fat-find-doc(after,"answer.md"),2); let oldAnswer=nth(fat-find-doc(before,"answer.md"),2);
 let checked=fcaq-check(json-array-elements(oh-get(request,"checks")),after);
 let mark="\nform-code "; let at=nsfr-last(log,mark,0,-1);
 let progress=parse-json("last-public-progress",nsfr-line(log,add(at,str_len(mark))));
 let feedback=oh-get(request,"feedback");
 let feedbackPresent=node_eq(oh-get(result,"caller_feedback"),json-node-array(list(json-node-array(list(oh-get(feedback,"id"),oh-get(feedback,"text"))))));
 let observation=json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-s("checkpoint_id",nsm-str(result,"checkpoint_id")),nsm-n("before_words",fal-count(oldAnswer)),nsm-n("after_words",fal-count(answer)),nsm-n("original_checks_passed",head(checked)),nsm-s("check_observation",nth(checked,1)),nsm-n("readonly_preserved",fcap-readonly-preserved(original,after,fcap-array(request,"writable"))),nsm-n("caller_feedback_retained",feedbackPresent),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("new_turns",sub(nsm-num(result,"turns"),nsm-num(prior,"turns"))),nsm-n("new_tool_calls",sub(nsm-num(result,"tool_calls"),nsm-num(prior,"tool_calls"))),nsm-n("new_checks",sub(nsm-num(result,"check_runs"),nsm-num(prior,"check_runs"))),nsm-n("generated_ids_this_admission",nsm-num(result,"generated_ids")),nsm-n("injected_ids_this_admission",nsm-num(result,"injected_ids")),nsm-n("last_observed_elapsed_ms",nsm-num(progress,"elapsed_ms")),nsm-n("weight_training_excluded",nsm-num(result,"weight_training_excluded")),nsm-n("provider_calls",0),nsm-n("original_cause_sentence_present",nsfr-has(answer,"That distance came from treating the exchange as a risk to manage rather than a question to serve.")),nsm-n("original_action_sentence_present",nsfr-has(answer,"I act by offering a cell with arguments, acknowledged by exactly one result.")),nsm-s("answer_sha256",nsm-hash(answer)),nsm-s("scope","Exact checks, retained event and literal presence only; read the answer and review for semantic quality. Model counters describe this resumed admission; state counters are differences from the original public result.")));
 fs-mkdir(root);
 frsh-frozen(frsh-path(root,"terminal-result.json"),raw);
 frsh-frozen(frsh-path(root,"answer.txt"),answer);
 frsh-frozen(frsh-path(root,"comparison.json"),json-emit(observation));
 frsh-frozen(frsh-path(root,"public-cli.log.json"),json-emit(json-node-object(list(nsm-s("source",logPath),nsm-s("sha256",nsm-hash(log)),nsm-s("text",log)))));
 print_str(json-emit(observation)); print_str("Native review:"); print_str(nsm-str(result,"report")); print_str("Native answer:"); print_str(answer);
}
