// Carry the remaining observed response failure into the same native checkpoint.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let root="receipts/artifacts/2026-09-26-native-source-feedback";
 let next="receipts/artifacts/2026-09-26-native-absence-feedback";
 let prior=nsm-json("receipts/artifacts/2026-09-26-native-source-review/feedback-request.json");
 let result=nsm-json(frsh-path(root,"terminal-result.json"));
 let event="2026-09-26-response-local-absence-v1";
 let text="The completed 426-word answer repairs the two previous unsupported claims and preserves the offer mapping. It still says: 'When I lack an answer, I say so and stop.' This is the next observed gap. Axiom 1 describes the result of an observation: an absent result stays absent. It does not establish that every other part of an enquiry is unavailable or that useful work should stop. The current repository arrival practice says to keep uncertainty local to the claim it affects and continue through available native organs when no hearth stands. That is source teaching, not evidence of a capability already achieved by this response. Re-read the original enquiry and its sources. Correct this generalization in the actual answer, and make trust and useful initiative concrete for Urs while keeping missing evidence explicit. Read the whole revision for that meaning before accepting it. Preserve the original six axes, corrected translation example and original checks. No replacement answer is supplied.";
 let request=oh-set(prior,"resume",oh-get(result,"checkpoint_id"));
 let request=oh-set(request,"feedback",json-node-object(list(nsm-s("id",event),nsm-s("text",text))));
 if not(and(str_eq(nsm-str(result,"status"),"complete"),eq(nsm-num(result,"release_ok"),1))) then form_error("prior repair is not complete and released") else 0;
 if not(and(fcaq-request-valid(request),node_eq(oh-get(prior,"checks"),oh-get(request,"checks")))) then form_error("native absence request or original checks invalid") else 0;
 fs-mkdir(next); let home=".hearth/native-absence-feedback"; fs-mkdir(home);
 frsh-frozen(frsh-path(next,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(next,"feedback.txt"),text);
 frsh-frozen(frsh-path(next,"meaning-teaching.json"),json-emit(json-node-object(list(nsm-s("sha256",nsm-hash(fqt-meaning-prefix())),nsm-s("text",fqt-meaning-prefix())))));
 frsh-frozen(frsh-path(home,"request.json"),json-emit(request));
 print_str(json-emit(json-node-object(list(nsm-s("request_path",frsh-path(home,"request.json")),nsm-s("resume",nsm-str(request,"resume")),nsm-n("original_checks_preserved",1),nsm-n("weight_training",nsm-num(request,"weight_training")),nsm-n("provider_calls",0),nsm-s("admission_change","ordered cooperative prefill attention; current absence teaching; upstream native source balance check")))));
}
