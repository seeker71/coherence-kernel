// Attribute actual arriving answers and native word counts on one enquiry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let before = read_file("receipts/artifacts/2026-09-23-native-answer-edit/codex-answer.txt");
 let after = read_file("receipts/artifacts/2026-09-23-response-practice/arriving-answer.txt");
 let evidence = json-node-object(list(nsm-s("answer_source","context-equipped Codex using supplied Form sources and observed work"),nsm-n("before_words",fal-count(before)),nsm-n("after_words",fal-count(after)),nsm-s("before_sha256",nsm-hash(before)),nsm-s("after_sha256",nsm-hash(after)),nsm-n("word_range_passed",fal-within(fal-count(after),350,450)),nsm-s("scope","Actual arriving-agent revision of the same original enquiry. Native counting establishes length only; semantic improvement is an attributed reading and felt resonance is unmeasured. This answer was not supplied to the active Qwen review.")));
 nsm-write("receipts/artifacts/2026-09-23-response-practice/observation.json",evidence);
 print_str(json-emit(evidence));
}
