// Retain the completed public answer and compare the original assertions.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nse-copy(from,to) = if le(file_size(from),0) then form_error("public evidence absent") else frsh-frozen(to,read_file(from));
 let logPath = ".hearth/native-sampled-application-cli.log";
 let log = read_file(logPath); let marker = "form-native-generation ";
 let start = str_find(log,marker,0);
 if lt(start,0) then form_error("public generation result absent") else 0;
 let begin = add(start,str_len(marker)); let end = str_find(log,"\n",begin);
 let textMarker = "\ntext:\n"; let textAt = str_find(log,textMarker,end);
 let textStart = add(textAt,str_len(textMarker)); let textEnd = str_find(log,"\nform-cli> ",textStart);
 if or(lt(end,0),or(lt(textAt,0),lt(textEnd,0))) then form_error("public generation response incomplete") else 0;
 let report = parse-json("public-generation",substring(log,begin,end));
 let answer = substring(log,textStart,textEnd);
 if not(eq(fal-count(answer),json-int-value(json-object-get(report,"final_words")))) then form_error("public answer count does not reconcile") else 0;
 let baselineRoot = "receipts/artifacts/2026-09-25-native-direct-application";
 let baseline = parse-json("baseline",read_file(frsh-path(baselineRoot,"report.json")));
 let prompt = read_file(".hearth/native-direct-application-2026-09-25/prompt.txt");
 if not(str_eq(prompt,read_file(frsh-path(baselineRoot,"prompt.txt")))) then form_error("comparison prompt changed") else 0;
 let req = parse-json("original-assertions",read_file("receipts/artifacts/2026-09-25-native-applied-response/request.json"));
 let beforeDocs = fat-wire-value(fat-wire-documents(req)); let before = fat-find-doc(beforeDocs,"answer.md");
 let docs = fat-put-doc(beforeDocs,list(head(before),nth(before,1),answer));
 let checked = fcaq-check(node_children(json-object-get(req,"checks")),docs);
 let comparison = json-node-object(list(
  nsm-s("schema","native-sampled-answer-comparison-v1"),nsm-s("prompt_sha256",nsm-hash(prompt)),
  nsm-n("same_prompt",1),nsm-n("same_prompt_ids",value_eq(json-object-get(baseline,"prompt_ids"),json-object-get(report,"prompt_ids"))),
  nsm-n("same_context",value_eq(json-object-get(baseline,"context"),json-object-get(report,"context"))),
  nsm-n("baseline_words",json-int-value(json-object-get(baseline,"final_words"))),nsm-n("final_words",fal-count(answer)),
  nsm-n("answer_changed",not(str_eq(read_file(frsh-path(baselineRoot,"answer.txt")),answer))),
  nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("original_assertions_passed",head(checked)),nsm-s("assertion_observation",nth(checked,1)),
  nsm-s("attribution","Qwen3.8-27B-Q8_0 via source-backed form-cli; Form-owned seeded sampling; unchanged caller-selected source packet"),
  nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null())));
 let target = "receipts/artifacts/2026-09-25-native-sampling"; fs_mkdir(target);
 frsh-frozen(frsh-path(target,"report.json"),json-emit(report));
 frsh-frozen(frsh-path(target,"answer.txt"),answer);
 frsh-frozen(frsh-path(target,"comparison.json"),json-emit(comparison));
 frsh-frozen(frsh-path(target,"prompt.txt"),prompt);
 nse-copy(logPath,frsh-path(target,"public-cli.log"));
 nse-copy(".hearth/native-sampled-application-export.bml",frsh-path(target,"export.bml"));
 print_str(json-emit(comparison)); print_str("\n"); print_str(answer);
}
