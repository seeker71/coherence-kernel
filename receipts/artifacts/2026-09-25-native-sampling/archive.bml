// Archive exact public packet/log bytes without changing whitespace checks.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nga-one(path) {
  let source = read_file(path);
  if not(str_eq(value_kind(source),"string")) then form_error("archive source unavailable") else 0;
  let target = str_concat(path,".json");
  let record = json-node-object(list(nsm-s("schema","verbatim-public-artifact-v1"),nsm-s("original_path",path),nsm-n("bytes",str_len(source)),nsm-s("sha256",nsm-hash(source)),nsm-s("text",source)));
  frsh-frozen(target,json-emit(record));
  let recovered = json-string-value(json-object-get(parse-json("archived",read_file(target)),"text"));
  if not(str_eq(source,recovered)) then form_error("archive roundtrip changed bytes") else print_str(str_concat("exact-byte archive ",target));
 }
 def nga-many(paths) = if nil?(paths) then 1 else { nga-one(head(paths)); nga-many(tail(paths)); };
 nga-many(list(
 "receipts/artifacts/2026-09-25-native-direct-application/original-enquiry.txt",
 "receipts/artifacts/2026-09-25-native-direct-application/prompt.txt",
 "receipts/artifacts/2026-09-25-native-direct-application/selected-sources.txt",
 "receipts/artifacts/2026-09-25-native-direct-application/public-cli.log",
 "receipts/artifacts/2026-09-25-native-sampling/prompt.txt",
 "receipts/artifacts/2026-09-25-native-sampling/public-cli.log"));
 frsh-frozen("receipts/artifacts/2026-09-25-native-sampling/archive.bml",read_file(".hearth/native-generation-archive.bml"));
 1;
}
