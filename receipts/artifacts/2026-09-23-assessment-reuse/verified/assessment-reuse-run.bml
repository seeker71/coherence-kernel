// Re-observe the real serving and candidate adapters on the current held-out rows.
// No optimizer update, serving change, model generation or provider call.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 let root = read_line();
 if or(nothing?(root),str_eq(root,"")) then form_error("fresh assessment evidence directory required") else 0;
 if not(eq(host_dir_mkdir(root),1)) then form_error("assessment reuse evidence directory already exists") else 0;
 let home = hearth-session-learning(); let base = nsm-model(); let serving = nsl-serving(home);
 let before = nsm-json(nsm-at(nsm-at(home,"rows/ebb4fc485697b97d8cc475f6686dc11241f13c968dc0feb65b0e2800663451fe"),"before.json"));
 let candidate = nsm-str(before,"parent");
 let rows = nsl-examples(nld-file(nsm-valid-path(home)));
 if or(str_eq(serving,""),or(str_eq(candidate,""),not(eq(len(rows),2)))) then form_error("current serving, candidate and two held-out rows required") else 0;
 let scope = nsl-cache-open(root);
 if str_eq(scope,"") then form_error("fresh assessment cache unavailable") else 0;
 let a = host_monotonic_ms(); let cold = nsl-grade-cached(root,base,serving,rows,scope); let b = host_monotonic_ms();
 let reversed = list(nth(rows,1),head(rows));
 let warm = nsl-grade-cached(root,base,serving,reversed,scope); let c = host_monotonic_ms();
 let expected = list(oh-set(nth(cold,1),"index",json-node-int(0)),oh-set(head(cold),"index",json-node-int(1)));
 nsm-write(nsm-at(root,"comparison.json"),json-node-object(list(json-node-pair("cold",json-node-array(cold)),json-node-pair("warm",json-node-array(warm)),json-node-pair("expected",json-node-array(expected)))));
 if not(str_eq(json-emit-precise(json-node-array(warm)),json-emit-precise(json-node-array(expected)))) then form_error("reused assessment changed serialized values or row order") else 0;
 let changed = nsl-grade-cached(root,base,candidate,rows,scope); let d = host_monotonic_ms();
 let report = json-node-object(list(nsm-s("serving",serving),nsm-s("candidate",candidate),nsm-s("scope",scope),nsm-n("cold_ms",sub(b,a)),nsm-n("warm_ms",sub(c,b)),nsm-n("changed_adapter_ms",sub(d,c)),nsm-n("reordered_scores_equal",1),nsm-n("retained_buffers",nth(metal_live(),2)),nsm-n("provider_calls",0),json-node-pair("rows",json-node-array(rows)),json-node-pair("cold",json-node-array(cold)),json-node-pair("warm",json-node-array(warm)),json-node-pair("changed_adapter",json-node-array(changed))));
 nsm-write(nsm-at(root,"report.json"),report);
 print_str(json-emit-precise(report));
 fs-remove-tree(scope);
}
