// Replay the first completed edit against its unchanged original documents.
// The live model, its reasoning, and its current task state remain untouched.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/answer-edit-reasoning-2026-09-23";
 let request = nsm-json(nsm-at(root,"request.json"));
 let path = ".hearth/code-memory/replies/95004-1790143044718.txt";
 let raw = read_file(path);
 let state = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let next = fcap-step(state,raw,fcaq-live-checker(request));
 let candidate = nth(fat-find-doc(fcap-docs(next),"answer.md"),2);
 let checked = fcaq-check(node_children(json-object-get(request,"checks")),fcap-docs(next));
 nag-write(nsm-at(root,"candidate-after-first-edit.txt"),candidate);
 let result = json-node-object(list(nsm-s("reply_path",path),nsm-s("reply_sha256",nsm-hash(raw)),nsm-n("documents_changed",not(value_eq(fcap-docs(state),fcap-docs(next)))),nsm-n("words",fal-count(candidate)),nsm-s("candidate_sha256",nsm-hash(candidate)),nsm-n("caller_check_passed",head(checked)),nsm-s("caller_check_evidence",nth(checked,1)),nsm-s("scope","first completed edit replayed against frozen original documents; live task still running")));
 nsm-write(nsm-at(root,"first-edit-observation.json"),result); print_str(json-emit-precise(result));
}
