// Isolate the observed score comparison using the retained real score bytes.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 let path = ".hearth/assessment-reuse-2026-09-23/assessment-cache/1790142758439-2271-275738293/f7039e8432abe17b066713e7b7ae592f9728290cb8ec56315beaca6fef2c85d9.json";
 let parsed = json-object-get(nsm-json(path),"score");
 let constructed = json-node-object(list(ntr-int("index",nsm-num(parsed,"index")),ntr-text("row_sha256",nsm-str(parsed,"row_sha256")),ntr-real("loss",nsm-num(parsed,"loss")),ntr-real("supervised_tokens",nsm-num(parsed,"supervised_tokens")),ntr-int("input_tokens",nsm-num(parsed,"input_tokens")),ntr-int("assessment_slices",nsm-num(parsed,"assessment_slices")),ntr-int("peak_slice_estimated_bytes",nsm-num(parsed,"peak_slice_estimated_bytes"))));
 let result = json-node-object(list(nsm-n("value_equal",value_eq(parsed,constructed)),nsm-n("json_bytes_equal",str_eq(json-emit-precise(parsed),json-emit-precise(constructed))),nsm-n("loss_equal",eq(nsm-num(parsed,"loss"),nsm-num(constructed,"loss"))),nsm-n("parsed_count_type",node_type(json-object-get(parsed,"supervised_tokens"))),nsm-n("constructed_count_type",node_type(json-object-get(constructed,"supervised_tokens"))),json-node-pair("parsed",parsed),json-node-pair("constructed",constructed)));
 nsm-write(".hearth/assessment-reuse-2026-09-23/representation.json",result); print_str(json-emit-precise(result));
}
