// Publish the actual completed comparison without grading its answer.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 def retain(path,text) {
  if gt(file_size(path),0) then {
   if not(str_eq(read_file(path),text)) then form_error("retained literal evidence changed") else 1;
  } else if not(eq(write_file(path,text),str_len(text))) then form_error("literal evidence retention incomplete") else 1;
 }
 let root = "receipts/artifacts/2026-09-23-native-literal-grounding/";
 let path = ".hearth/generate-answer-repaired.json";
 if le(file_size(path),0) then form_error("repaired generation has not returned") else 0;
 let report = nsm-json(path);
 retain(str_concat(root,"generate-answer-repaired.json"),read_file(path));
 retain(str_concat(root,"generate-answer-repaired.txt"),read_file(".hearth/generate-answer-repaired.txt"));
 retain(str_concat(root,"literal-source.bml"),read_file(".hearth/generate-answer-literal-source.bml"));
 let raw = read_file(".hearth/generate-answer-repaired.txt");
 let boundary = str_find(raw,"text:\n",0);
 if lt(boundary,0) then form_error("native report contains no answer boundary") else 0;
 retain(str_concat(root,"answer.txt"),substring(raw,add(boundary,6),str_len(raw)));
 let cost = ftc-read();
 retain(str_concat(root,"preceding-coordinator-cost.json"),json-emit(cost));
 print_str(str_concat(json-emit(report),"\n"));
}
