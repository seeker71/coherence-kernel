// Scalar observations around the real model-listing CLI session.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 let label = read_line();
 if not(or(str_eq(label,"before"),str_eq(label,"after"))) then form_error("close observation label absent") else 0;
 let state = nsm-status(hearth-session-learning());
 let report = json-node-object(list(nsm-s("stage",label),nsm-n("at_ms",now_unix_ms()),json-node-pair("worker_alive",oh-get(state,"worker_alive")),json-node-pair("pending",oh-get(state,"pending")),json-node-pair("session_corpus",oh-get(state,"session_corpus")),json-node-pair("experience_corpus",oh-get(state,"experience_corpus")),json-node-pair("learned_rounds",oh-get(oh-get(state,"state"),"learned_rounds"))));
 let text = json-emit(report); let path = str_concat(".hearth/cli-close-",str_concat(label,".json"));
 if not(eq(write_file(path,text),str_len(text))) then form_error("close evidence write incomplete") else print_str(str_concat(text,"\n"));
}
