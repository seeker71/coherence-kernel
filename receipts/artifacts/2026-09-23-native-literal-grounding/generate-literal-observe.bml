// Return to the actual packet and distinguish source variables from values.
// preludes: form-stdlib/form-cli-model-generate.fk ../observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 def need(value,why) = if value then 1 else form_error(why);
 let prompt = read_file(".hearth/generate-answer-source.txt");
 let taught = str_concat(fcmg-teach(prompt),str_concat("\n",fhm-caller-budget-text(64)));
 let before = bfc-envelope(0,now_unix_ms(),0,list(11,82,0),nothing());
 bfc-record-out(before,0); let control = bfc-control(before,4); bfc-record-in(control,4);
 need(eq(bfc-exchange(control),bfc-exchange(before)),"literal observation control mismatch");
 let found = lg-think-all(taught);
 print(list("actual-packet-native-thoughts",len(found),lg-values-line(found)));
 need(eq(len(found),0),"source packet still supplies unintended executable thoughts");
 need(str_eq(lg-values-line(lg-think-all("Compute (add 2 3) then (mul 6 7).")),"5|42"),"actual arithmetic changed");
 need(str_eq(lg-values-line(lg-think-all("(sub -2 3) (eq 0 0) (add 0 -4)")),"-5|1|-4"),"signed or zero operand changed");
 need(eq(len(lg-think-all("(add x y) (eq 1) (mul 2z 3) (sub 2 3x) (add 1 2 3) (eq 1 2")),0),"incomplete cells became observations");
 need(str_eq(lg-values-line(lg-think-all("(add x y) then (add 4 5)")),"9"),"invalid source hid a later valid cell");
 bfc-record-out(bfc-envelope(0,bfc-exchange(before),0,list(len(found),1),nothing()),0);
 print(list("literal-source-boundary",1,"provider-calls",0));
}
