// Preserve exact input bytes in JSON strings, including terminal spaces.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 def retain-input(name) {
  let input = str_concat(".hearth/",str_concat(name,".txt"));
  let text = read_file(input);
  let path = str_concat("receipts/artifacts/2026-09-23-native-literal-grounding/",str_concat(name,".json"));
  let record = json-node-object(list(nsm-s("schema","exact-input-text-v1"),nsm-s("sha256",nsm-hash(text)),nsm-n("bytes",str_len(text)),nsm-s("text",text)));
  nsm-write(path,record);
  let restored = nsm-str(nsm-json(path),"text");
  if not(str_eq(restored,text)) then form_error("retained input bytes changed") else print(list("input-exact",name,str_len(restored),nsm-hash(restored)));
 }
 retain-input("generate-answer-source");
 retain-input("generate-answer-meaning");
}
