// Compare the ordinary CLI generation allowances on the exact real enquiry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 def retain(path,text) = if not(eq(write_file(path,text),str_len(text))) then form_error("generation comparison retention incomplete") else if not(str_eq(read_file(path),text)) then form_error("generation comparison readback differs") else 1;
 def observe(path,request,label) {
  let start = host_monotonic_ms();
  let result = fgc-run(fcmr-none(),path,request);
  let elapsed = sub(host_monotonic_ms(),start);
  let released = fcmr-release-ok?(nth(result,1));
  retain(str_concat(".hearth/generate-answer-",str_concat(label,".txt")),head(result));
  let row = json-node-object(list(nsm-s("lane",label),nsm-n("allowance",head(fgc-request(request))),nsm-n("elapsed_ms",elapsed),nsm-n("release_ok",released),nsm-n("report_bytes",str_len(head(result))),nsm-n("provider_calls",0)));
  retain(str_concat(".hearth/generate-answer-",str_concat(label,".json")),json-emit(row));
  print_str(str_concat(json-emit(row),"\n"));
  if not(released) then form_error("comparison model release incomplete") else row;
 }
 let source = ".hearth/hearth-answer-source-repair.packet.md";
 let prompt = read_file(source); let model = mr-path(mr-find("qwen38-q8"));
 if le(str_len(prompt),0) then form_error("actual enquiry packet absent") else 0;
 retain(".hearth/generate-answer-source.txt",prompt);
 retain(".hearth/generate-answer-meaning.txt",fqt-meaning-prefix());
 let started = host_monotonic_ms();
 nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let waitMs = sub(host_monotonic_ms(),started);
 print(list("generation-comparison-ready",host_pid(),model,nsm-hash(prompt),waitMs));
 let before = observe(model,str_concat("--tokens 64 ",prompt),"before");
 let after = observe(model,prompt,"after");
 let report = json-node-object(list(nsm-s("schema","ordinary-native-generation-comparison-v1"),nsm-s("model",model),nsm-s("prompt_sha256",nsm-hash(prompt)),nsm-n("prompt_bytes",str_len(prompt)),nsm-n("learner_wait_ms",waitMs),json-node-pair("before",before),json-node-pair("after",after),nsm-s("scope","same original enquiry packet and shared teachings; allowance and its prompt annotation change; generated answers require reading; no provider calls; coordinator excluded")));
 retain(".hearth/generate-answer-comparison.json",json-emit(report));
 print_str(str_concat(json-emit(report),"\n"));
}
