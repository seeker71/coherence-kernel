// Re-answer the same enquiry after correcting literal operand admission.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml ../observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 def keep(path,text) = if not(eq(write_file(path,text),str_len(text))) then form_error("repaired answer retention incomplete") else if not(str_eq(read_file(path),text)) then form_error("repaired answer readback differs") else 1;
 def await-comparison(pid) = if and(eq(host_alive(pid),1),le(file_size(".hearth/generate-answer-comparison.json"),0)) then { host_sleep_ms(500); await-comparison(pid); } else 0;
 let parserPath = "form/form-stdlib/bml/local-generate-literal.bml";
 let parserSource = read_file(parserPath);
 keep(".hearth/generate-answer-literal-source.bml",parserSource);
 print(list("repair-awaits-prior-comparison",host_pid(),3812,host_alive(3812)));
 await-comparison(3812);
 if not(str_eq(parserSource,read_file(parserPath))) then form_error("literal parser changed while awaiting comparison") else 0;
 let comparison = nsm-json(".hearth/generate-answer-comparison.json");
 if not(str_eq(nsm-str(comparison,"schema"),"ordinary-native-generation-comparison-v1")) then form_error("prior comparison has not finished") else 0;
 let prompt = read_file(".hearth/generate-answer-source.txt");
 if not(str_eq(nsm-hash(prompt),nsm-str(comparison,"prompt_sha256"))) then form_error("original enquiry changed") else 0;
 if not(str_eq(fqt-meaning-prefix(),read_file(".hearth/generate-answer-meaning.txt"))) then form_error("shared teaching changed between comparisons") else 0;
 if not(eq(fgc-default-tokens(),nsm-num(oh-get(comparison,"after"),"allowance"))) then form_error("generation allowance changed between comparisons") else 0;
 let promptText = str_concat(fcmg-teach(prompt),str_concat("\n",fhm-caller-budget-text(fgc-default-tokens())));
 let thoughts = lg-think-all(promptText);
 if not(eq(len(thoughts),0)) then form_error("source examples still became fabricated thoughts") else 0;
 let observation = bfc-envelope(0,now_unix_ms(),0,list(11,82,fgc-default-tokens()),nothing());
 bfc-record-out(observation,0); let control = bfc-control(observation,5); bfc-record-in(control,5);
 if not(eq(bfc-exchange(control),bfc-exchange(observation))) then form_error("response re-observation is uncorrelated") else 0;
 let waitStart = host_monotonic_ms(); nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let waitMs = sub(host_monotonic_ms(),waitStart);
 let model = nsm-str(comparison,"model"); let started = host_monotonic_ms();
 print(list("repaired-generation-ready",host_pid(),model,fgc-default-tokens(),waitMs));
 let result = fgc-run(fcmr-none(),model,prompt);
 let elapsed = sub(host_monotonic_ms(),started); let released = fcmr-release-ok?(nth(result,1));
 keep(".hearth/generate-answer-repaired.txt",head(result));
 let report = json-node-object(list(nsm-s("schema","ordinary-native-generation-repair-v1"),nsm-s("model",model),nsm-s("prompt_sha256",nsm-hash(prompt)),nsm-s("meaning_sha256",nsm-hash(fqt-meaning-prefix())),nsm-n("allowance",fgc-default-tokens()),nsm-n("unintended_thoughts",len(thoughts)),nsm-n("learner_wait_ms",waitMs),nsm-n("elapsed_ms",elapsed),nsm-n("release_ok",released),nsm-n("provider_calls",0),nsm-s("scope","same enquiry, meanings, model and allowance as prior after lane; literal parser changed; actual returned words establish answer quality")));
 keep(".hearth/generate-answer-repaired.json",json-emit(report));
 bfc-record-out(bfc-envelope(0,bfc-exchange(observation),0,list(len(thoughts),elapsed,released),nothing()),0);
 print_str(str_concat(json-emit(report),"\n"));
 if not(released) then form_error("repaired model release incomplete") else 0;
}
