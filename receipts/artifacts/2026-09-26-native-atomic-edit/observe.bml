// Reproduce two actual native paragraph changes through one atomic tool call.
// Caller-owned documents only; no model admission or checkpoint mutation.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nae-assert(name,ok) = if ok then 1 else form_error(str_concat("atomic edit observation: ",name));
 def nae-pairs(before,after) = if nil?(before) then list() else append(if str_eq(head(before),head(after)) then list() else list(head(before),head(after)),nae-pairs(tail(before),tail(after)));
 def nae-command(args) = json-emit(json-node-object(list(nsm-s("tool","edit"),json-node-pair("arguments",json-node-array(fcap-string-json(args))))));
 let root = "receipts/artifacts/2026-09-26-native-atomic-edit";
 let beforePath = "receipts/artifacts/2026-09-26-native-identity-usefulness-care/answer.txt";
 let afterPath = "receipts/artifacts/2026-09-26-native-feedback-continuity/candidate-turn-30.txt";
 let before = read_file(beforePath); let after = read_file(afterPath);
 nae-assert("original completed answer identity",str_eq(nsm-hash(before),"1a15dff2be8b01563cf03f91754f954832bd6988e2c84d9121c3b943e3c4788b"));
 nae-assert("actual turn-30 candidate identity",str_eq(nsm-hash(after),"6b9481be1783e4a3efc0564a25229dbfcff0cef6784abf126fbc137e454c880e"));
 let beforeParagraphs = split-on(before,"\n\n"); let afterParagraphs = split-on(after,"\n\n");
 nae-assert("same paragraph topology",eq(len(beforeParagraphs),len(afterParagraphs)));
 let pairs = nae-pairs(beforeParagraphs,afterParagraphs);
 nae-assert("two changed paragraphs",eq(len(pairs),4));
 let request = nsm-json("receipts/artifacts/2026-09-26-native-feedback-continuity/request.json");
 let supplied = fat-wire-documents(request);
 nae-assert("valid caller source",str_eq(fat-wire-error(supplied),""));
 let docs = fat-wire-value(supplied); let answerDoc = fat-find-doc(docs,"answer.md");
 let original = fat-put-doc(docs,list(head(answerDoc),nth(answerDoc,1),before));
 let args = cons("answer.md",pairs);
 let result = fat-call(original,"edit",args,"");
 let observed = nth(fat-find-doc(fat-documents(result),"answer.md"),2);
 nae-assert("one batch reproduces the actual draft exactly",and(eq(fat-exit(result),0),str_eq(observed,after)));
 nae-assert("other documents unchanged",fcap-readonly-preserved(original,fat-documents(result),list("answer.md")));
 let refusedArgs = list("answer.md",head(pairs),nth(pairs,1),nth(pairs,2),nth(pairs,2));
 let refused = fat-call(original,"edit",refusedArgs,"");
 nae-assert("failed second edit preserves all original documents",and(eq(fat-exit(refused),2),value_eq(fat-documents(refused),original)));
 let checks = fcaq-check(json-array-elements(oh-get(request,"checks")),fat-documents(result));
 nae-assert("original length check still refuses the actual 500-word draft",and(eq(fal-count(observed),500),and(eq(head(checks),0),ge(str_find(nth(checks,1),"word-range",0),0))));
 let batchBytes = str_len(nae-command(args));
 let wholeBytes = str_len(nae-command(list("answer.md","sha256",nsm-hash(before),after)));
 let reading = json-node-object(list(nsm-s("before_path",beforePath),nsm-s("after_path",afterPath),nsm-s("before_sha256",nsm-hash(before)),nsm-s("after_sha256",nsm-hash(after)),nsm-n("changed_paragraphs",div(len(pairs),2)),nsm-n("tool_exit",fat-exit(result)),nsm-n("exact_draft_reproduced",str_eq(observed,after)),nsm-n("readonly_preserved",fcap-readonly-preserved(original,fat-documents(result),list("answer.md"))),nsm-n("later_failure_rolled_back",value_eq(fat-documents(refused),original)),nsm-s("rollback_evidence",fat-out(refused)),nsm-n("observed_words",fal-count(observed)),nsm-n("original_checks_passed",head(checks)),nsm-s("original_check_evidence",nth(checks,1)),nsm-n("batch_command_bytes",batchBytes),nsm-n("whole_document_command_bytes",wholeBytes),nsm-n("command_bytes_saved",sub(wholeBytes,batchBytes)),nsm-s("scope","Actual recorded edits reproduced through the public native tool. Byte counts describe canonical command payloads, not measured generation tokens or time. The running model predates this tool change; its answer quality and future use remain separate observations.")));
 frsh-frozen(nsm-at(root,"observation.json"),json-emit(reading));
 print_str(json-emit(reading));
}
