// Read only the source document returned in the public completed result.
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let result=nsm-json("receipts/artifacts/2026-09-26-native-absence-feedback/terminal-result.json");
 let supplied=fat-wire-documents(result);
 if not(str_eq(fat-wire-error(supplied),"")) then form_error("public source unavailable") else 0;
 let doc=fat-find-doc(fat-wire-value(supplied),"enquiry.txt");
 if nil?(doc) then form_error("enquiry source absent") else print_str(nth(doc,2));
}
