// Replay the real retained candidate through the coding review boundary.
// The verdicts below are caller-supplied protocol observations, not model output.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nre-row(label,state) = json-node-object(list(nsm-s("case",label),nsm-s("stage",fcap-stage(state)),nsm-s("observation",fcap-note(state)),nsm-n("checks",fcap-checks(state)),nsm-s("report",fcap-report(state))));
 let phase = read_line();
 if not(or(str_eq(phase,"before"),str_eq(phase,"after"))) then form_error("choose before or after") else 0;
 let root = "receipts/artifacts/2026-09-25-native-answer-edit";
 let request = parse-json("request",read_file(frsh-path(root,"request.json")));
 let result = parse-json("result",read_file(frsh-path(root,"result.json")));
 let original = fat-wire-documents(request); let candidate = fat-wire-documents(result);
 if not(and(str_eq(fat-wire-error(original),""),str_eq(fat-wire-error(candidate),""))) then form_error("retained document decode refused") else 0;
 let checker = fcaq-live-checker(request);
 let state = fcaq-initial(request,fat-wire-value(original));
 let target = fat-find-doc(fat-wire-value(candidate),"answer.md");
 let old = fat-find-doc(fat-wire-value(original),"answer.md");
 let action = json-node-object(list(nsm-s("tool","edit"),json-node-pair("arguments",json-node-array(list(json-node-string("answer.md"),json-node-string("sha256"),json-node-string(fat-document-sha(old)),json-node-string(nth(target,2)))))));
 let edited = fcap-step(state,json-emit(action),checker);
 let reviewing = fcap-step(edited,"{\"task\":\"done\"}",checker);
 if not(str_eq(fcap-stage(reviewing),"review")) then form_error(fcap-note(reviewing)) else 0;
 let explained = "The answer has 397 words and distinguishes tokenizer encoding from decoder prediction. This scoped observation does not establish full fidelity to the original goal.";
 let accepted = fcap-step(reviewing,json-emit(json-node-object(list(nsm-s("verdict","accept"),nsm-s("reason",explained)))),checker);
 let record = json-node-object(list(nsm-s("scope","actual retained candidate and original checker; caller-authored verdicts; no model generation or semantic quality claim"),nsm-s("phase",phase),nsm-s("candidate_sha256",fat-document-sha(target)),json-node-pair("cases",json-node-array(list(nre-row("reason-absent",fcap-step(reviewing,"{\"verdict\":\"accept\"}",checker)),nre-row("reason-blank",fcap-step(reviewing,"{\"verdict\":\"accept\",\"reason\":\"  \"}",checker)),nre-row("reason-non-string",fcap-step(reviewing,"{\"verdict\":\"accept\",\"reason\":7}",checker)),nre-row("reason-supplied",accepted)))),nsm-n("checkpoint_report_roundtrip",str_eq(fcap-report(fcam-unpack(fcam-pack(accepted))),fcap-report(accepted))),nsm-n("model_calls",0)));
 frsh-frozen(str_concat(".hearth/native-review-evidence-",str_concat(phase,".json")),json-emit(record));
 print_str(json-emit(record));
}
