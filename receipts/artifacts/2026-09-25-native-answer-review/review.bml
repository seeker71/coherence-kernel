// Re-open the actual retained answer at its coding-review boundary.
// Caller reconstruction is counted separately from native model replies.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nar-other(docs) = if nil?(docs) then list() else if str_eq(nth(head(docs),1),"answer.md") then nar-other(tail(docs)) else cons(head(docs),nar-other(tail(docs)));
 let output = ".hearth/native-answer-review-2026-09-25";
 let input = "receipts/artifacts/2026-09-25-native-answer-edit";
 let request = parse-json("request",read_file(frsh-path(input,"request.json")));
 let previous = parse-json("completed-result",read_file(frsh-path(input,"result.json")));
 let original = fat-wire-documents(request); let candidate = fat-wire-documents(previous);
 if not(and(fcaq-request-valid(request),and(fcaq-evaluation(request),and(str_eq(fat-wire-error(original),""),str_eq(fat-wire-error(candidate),""))))) then form_error("retained evaluation request unavailable") else 0;
 let checker = fcaq-live-checker(request);
 let state = fcaq-initial(request,fat-wire-value(original));
 let target = fat-find-doc(fat-wire-value(candidate),"answer.md");
 let old = fat-find-doc(fat-wire-value(original),"answer.md");
 let action = json-node-object(list(nsm-s("tool","edit"),json-node-pair("arguments",json-node-array(list(json-node-string("answer.md"),json-node-string("sha256"),json-node-string(fat-document-sha(old)),json-node-string(nth(target,2)))))));
 let reviewing = fcap-step(fcap-step(state,json-emit(action),checker),"{\"task\":\"done\"}",checker);
 if not(and(str_eq(fcap-stage(reviewing),"review"),and(not(fcam-managed(reviewing)),str_eq(fat-document-sha(target),"bea4ab0a7d548e0ff65762167b1f7a5d138141e7cea3e4d91bf1a4ce2a3d44c8")))) then form_error("retained review boundary differs") else 0;
 let limit = add(fcap-turns(reviewing),6);
 let admission = json-node-object(list(nsm-s("model","qwen38-q8"),nsm-s("profile",fcac-profile(reviewing)),nsm-s("scope","fresh admission at reconstructed review boundary; no historical model context or replies replayed"),nsm-n("evaluation",1),nsm-n("provider_calls",0),nsm-n("context",16384),nsm-n("native_reply_allowance",6),nsm-n("baseline_turns",fcap-turns(reviewing)),nsm-n("baseline_tool_calls",fcap-calls(reviewing)),nsm-n("baseline_checks",fcap-checks(reviewing)),nsm-s("candidate_sha256",fat-document-sha(target)),nsm-s("original_goal",fcap-string(request,"goal")),nsm-s("code_policy_sha256",nsm-hash(read_file("form/form-stdlib/bml/form-cli-code-policy.bml")))));
 frsh-frozen(frsh-path(output,"context.json"),json-emit(admission));
 frsh-frozen(frsh-path(output,"admitted-context.txt"),fcac-bootstrap-budget(reviewing,limit));
 let started = now_unix_ms();
 let result = fcac-admit("qwen38-q8",reviewing,checker,16384,limit);
 let elapsed = sub(now_unix_ms(),started);
 let final = head(result); let answer = nth(fat-find-doc(fcap-docs(final),"answer.md"),2);
 let rechecked = fcap-check-state(final,checker);
 frsh-frozen(frsh-path(output,"result.json"),fcaq-result-core(result));
 frsh-frozen(frsh-path(output,"answer.txt"),answer);
 let comparison = json-node-object(list(nsm-s("status",fcap-stage(final)),nsm-s("reason",fcap-note(final)),nsm-s("report",fcap-report(final)),nsm-n("native_model_replies",sub(fcap-turns(final),fcap-turns(reviewing))),nsm-n("native_tool_calls",sub(fcap-calls(final),fcap-calls(reviewing))),nsm-n("native_check_runs",sub(fcap-checks(final),fcap-checks(reviewing))),nsm-n("repairs",fcap-failures(final)),nsm-n("release_ok",nth(result,1)),nsm-n("generated_ids",nth(result,2)),nsm-n("injected_ids",nth(result,3)),nsm-n("elapsed_ms",elapsed),nsm-n("original_words",fal-count(nth(target,2))),nsm-n("final_words",fal-count(answer)),nsm-n("answer_changed",not(str_eq(answer,nth(target,2)))),nsm-n("source_unchanged",value_eq(nar-other(fcap-docs(reviewing)),nar-other(fcap-docs(final)))),nsm-n("postrun_original_checks",head(rechecked)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null())));
 frsh-frozen(frsh-path(output,"comparison.json"),json-emit(comparison));
 print_str(json-emit(comparison)); print_str("\n");
}
