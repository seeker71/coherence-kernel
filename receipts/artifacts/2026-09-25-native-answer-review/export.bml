// Export completed public results and process metadata, never private replies.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 def nar-copy(source,target) = if le(file_size(source),0) then form_error(str_concat("evidence absent: ",source)) else frsh-frozen(target,read_file(source));
 def nar-copies(root,target,names) = if nil?(names) then 1 else {
  nar-copy(frsh-path(root,head(names)),frsh-path(target,head(names)));
  nar-copies(root,target,tail(names));
 };
 def nar-process(job) {
  let row = fhn-json(fhn-stage-path(job,"review",".process.json"));
  if not(str_eq(fcap-string(row,"state"),"finished")) then form_error("process has not finished") else 0;
  json-node-object(list(json-node-pair("state",json-object-get(row,"state")),json-node-pair("returncode",json-object-get(row,"returncode")),json-node-pair("elapsed_ms",json-object-get(row,"elapsed_ms")),json-node-pair("supervision",json-object-get(row,"supervision")),json-node-pair("cleanup",json-object-get(row,"cleanup")),json-node-pair("output_drains",json-object-get(row,"output_drains"))));
 }
 let root = ".hearth/native-answer-review-2026-09-25";
 let target = "receipts/artifacts/2026-09-25-native-answer-review";
 let final = fhn-json(frsh-path(root,"process-result.json"));
 if not(str_eq(fcap-string(final,"status"),"0")) then form_error("native review process did not finish successfully; inspect retained evidence") else 0;
 fs_mkdir(target);
 nar-copies(root,target,list("context.json","admitted-context.txt","result.json","answer.txt","comparison.json","coordinator-cost.json"));
 nar-copy(".hearth/native-review-evidence-before.json",frsh-path(target,"protocol-before.json"));
 nar-copy(".hearth/native-review-evidence-after.json",frsh-path(target,"protocol-after.json"));
 nar-copy(".hearth/native-review-evidence-observe.bml",frsh-path(target,"protocol-observe.bml"));
 nar-copy(".hearth/native-review-memory-counts-before.log",frsh-path(target,"native-review-memory-counts-before.log"));
 nar-copy(".hearth/native-review-value-counts-before.log",frsh-path(target,"native-review-value-counts-before.log"));
 nar-copy(".hearth/native-review-repair-counts-before.log",frsh-path(target,"native-review-repair-counts-before.log"));
 nar-copy(".hearth/native-answer-review.bml",frsh-path(target,"review.bml"));
 nar-copy(".hearth/native-answer-review-run.bml",frsh-path(target,"run.bml"));
 nar-copy(".hearth/native-answer-review-export.bml",frsh-path(target,"export.bml"));
 nar-copy(".hearth/native-answer-review-failed-runner.bml",frsh-path(target,"failed-runner.bml"));
 let failed = fcap-string(fhn-json(frsh-path(root,"failed-launch-admission.json")),"evidence");
 frsh-frozen(frsh-path(target,"launch-failure.json"),json-emit(nar-process(failed)));
 frsh-frozen(frsh-path(target,"process.json"),json-emit(nar-process(fcap-string(final,"evidence"))));
 print_str(read_file(frsh-path(target,"comparison.json"))); print_str("\n");
 print_str(read_file(frsh-path(target,"answer.txt")));
}
