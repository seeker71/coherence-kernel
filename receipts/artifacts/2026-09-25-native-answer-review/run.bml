// Progress-aware native supervision; one admitted run, no wall-time deadline.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 let root = ".hearth/native-answer-review-2026-09-25";
 let checkout = fhn-root(); let spool = fhn-at(checkout,".form-heal");
 fs_mkdir(spool); fs_mkdir(root);
 if gt(file_size(fhn-at(root,"admission.json")),0) then form_error("native answer review already admitted") else 0;
 let job = fhn-unique(spool,"answer-review-",0);
 fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(fhn-s("root",checkout))));
 fhn-write-json(fhn-at(root,"admission.json"),json-node-object(list(fhn-s("evidence",job))));
 let status = fhn-run(job,"review",0,"root","-",list("./fkwu",".hearth/native-answer-review.bml"));
 let result = json-node-object(list(fhn-s("status",status),fhn-s("evidence",job)));
 fhn-write-json(fhn-at(root,"process-result.json"),result);
 print_str(json-emit(result));
}
