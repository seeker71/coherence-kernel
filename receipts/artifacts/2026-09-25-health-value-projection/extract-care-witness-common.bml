// preludes: form-stdlib/native-edit.fk
section [form.bml] {
 class ExtractCareWitnessCommon {
  def ecw-drop(text,start,end) {
   let a = find-from(text,start,0); let b = find-from(text,end,0);
   if or(lt(a,0),le(b,a)) then form_error("shared witness extraction anchors missing") else str_concat(substring(text,0,a),substring(text,b,str_len(text)));
  }
 }
 let path = "observe/form-care-changing-witness.bml";
 let original = read_file(path);
 let first = ecw-drop(original,"  def ccw-assert(","  def ccw-read(");
 let second = ecw-drop(first,"  def ccw-sum(","  def ccw-empty(");
 let third = ecw-drop(second,"  def ccw-bind(","  def ccw-index-append(");
 let shared = ne-replace-all(third,"// preludes: form-stdlib/bml/form-core-care.bml form-stdlib/qwen35-artifact-seal-reader.fk","// preludes: observe/form-care-witness-common.bml");
 let bound = ne-replace-all(shared,"\"observe/form-care-changing-witness.bml\"","\"observe/form-care-changing-witness.bml\",\"observe/form-care-witness-common.bml\",\"form/form-stdlib/bml/form-core-health-values.bml\"");
 if eq(write_file(path,bound),str_len(bound)) then 1 else form_error("shared witness extraction incomplete");
}
