// Frozen projection parity against the exact parent, plus real retained flow.
// preludes: form-stdlib/bml/form-core-care.bml .hearth/health-projection-reference.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class HealthProjectionContract {
  def hpc-check(ok,label) = if ok then 1 else form_error(str_concat("health projection: ",label));
  def hpc-source(path,state,rows) = jv-object(list(jv-s("source",path),jv-s("generation","owned"),jv-s("state",state),jv-n("offset",37),jv-n("extent",37),jv-n("read_bytes",37),jv-n("pending_bytes",0),jv-n("invalid_records",0),jv-pair("current",jv-array(rows)),jv-pair("declaration",jv-null())));
  def hpc-frozen(discovery,sources) {
   let nodes = jv-materialize-items(sources); let before = before-ohc-project("/owned",discovery,nodes,host_monotonic_ms());
   let after = ohc-view("/owned",discovery,sources,host_monotonic_ms());
   let oldText = json-emit-precise(oh-set(before,"elapsed_ms",json-node-int(0))); let newText = jv-emit(jv-set(after,"elapsed_ms",jv-int(0)));
   hpc-check(str_eq(oldText,newText),"complete projected JSON equals parent except elapsed time");
   hpc-check(node_eq(oh-set(ohc-project("/owned",discovery,nodes,host_monotonic_ms()),"elapsed_ms",json-node-int(0)),oh-set(before,"elapsed_ms",json-node-int(0))),"node projection adapter preserves complete content");
   hpc-check(node_eq(json-node-array(ohc-readings(nodes)),json-node-array(before-ohc-readings(nodes))),"node readings adapter preserves ordering and metadata replacement");
   hpc-check(node_eq(json-node-array(ohc-source-needs(nodes)),json-node-array(before-ohc-source-needs(nodes))),"node source-needs adapter preserves state meanings");
   after;
  }
  def hpc-callback(root,discovery,sources,started) {
   hpc-check(node_eq(node_category(discovery),JSON-OBJECT()),"custom callback receives node discovery");
   hpc-check(and(not(nil?(sources)),oh-array(head(sources),"current")),"custom callback receives node source reports");
   "node-callback";
  }
  def hpc-arguments(owner,args) = if nil?(args) then 0 else {
   hpc-check(str_eq(ohc-command-at(owner,head(args)),before-ohc-command-at(owner,head(args))),"help and invalid request messages preserve exact bytes");
   add(1,hpc-arguments(owner,tail(args)));
  };
  def hpc-run() {
   let out = bfc-envelope(0,host_monotonic_ms(),0,list(128,256),0); bfc-record-out(out,0); let control = bfc-control(out,5); bfc-record-in(control,1);
   hpc-check(eq(bfc-apply(out,control,0,1),1),"revision selects the actual value projection");
   let base = jvp-parse("{\"schema\":\"organ-health-v1\",\"id\":\"a\",\"organ\":\"unknown\",\"flow\":\"local\",\"aspect\":\"value\",\"stage\":\"observe\",\"expected\":null,\"observed\":false,\"health\":null,\"surprise\":0,\"needs\":[],\"offers\":[\"defer\"],\"observed_at_ms\":7,\"at_ms\":7,\"observation_age_ms\":13,\"source\":\"old\",\"source\":\"duplicate\",\"source_state\":\"old\",\"evidence\":{\"x\":1,\"x\":2,\"values\":[false,0,1,1.0,0.125,null,\"\\u0000\\uD83D\\uDE00\"],\"observation_age_ms\":123}}");
   let pain = jv-set(jv-set(jv-set(base,"id",jv-string("b")),"organ",jv-string("pain")),"health",jv-int(0));
   let well = jv-set(jv-set(jv-set(base,"id",jv-string("c")),"organ",jv-string("well")),"health",jv-int(1));
   let sources = list(hpc-source("/first","caught-up",list(base,pain,well)),hpc-source("/backlog","backlog",list()),hpc-source("/partial","awaiting-complete-record",list()),hpc-source("/empty","caught-up",list()),hpc-source("/absent","absent-or-unreadable",list()),hpc-source("/unreadable","read-refused",list()));
   let discovery = parse-json("health-discovery","{\"coverage\":\"observed-only\",\"sources\":[],\"diagnostics\":[],\"extra\":{\"not_observed\":null}}");
   let projected = hpc-frozen(discovery,sources); let attention = jv-items(jv-get(projected,"attention"));
   hpc-check(and(eq(len(attention),2),and(str_eq(jv-str(head(attention),"organ"),"pain"),str_eq(jv-str(nth(attention,1),"organ"),"unknown"))),"stable pain-first attention preserves unknown separately from health");
   hpc-check(eq(len(jv-items(jv-get(projected,"source_needs"))),5),"all distinct incomplete evidence states remain visible");
   hpc-frozen(discovery,list());
   let retained = parse-json("retained-process",read_file(".hearth/live-process-care-report.json"));
   let path = str_concat(oh-str(nth(json-array-elements(oh-get(retained,"cases")),1),"job"),"/probe.events.jsonl");
   let text = read_file(path); let root = host_cwd(); let source = ohc-source(root,path); let owner = ohc-open();
   let realDiscovery = json-node-object(list(oh-s("coverage","retained-execution"),json-node-pair("sources",json-node-array(list(source,source)))));
   let reports = ohc-poll-with(owner,list(source,source),65536,list(),ohcv-source-report);
   hpc-check(and(eq(len(reports),1),eq(jv-str(head(reports),"read_bytes"),str_len(text))),"duplicate declarations consume the source exactly once");
   let real = hpc-frozen(realDiscovery,reports);
   hpc-check(eq(len(jv-items(jv-get(real,"organs"))),3),"retained execution keeps all three organs");
   let request = json-node-object(list(json-node-pair("sources",json-node-array(list(json-node-string(path))))));
   hpc-check(str_eq(ohc-read-with(owner,root,realDiscovery,65536,host_monotonic_ms(),hpc-callback),"node-callback"),"custom read callback unchanged");
   hpc-check(str_eq(ohc-request-with(owner,request,hpc-callback),"node-callback"),"custom request callback unchanged");
   hpc-check(node_eq(node_category(ohc-request-at(owner,request)),JSON-OBJECT()),"explicit node API still returns a primary object");
   let arguments = hpc-arguments(owner,list("help","{","[]","{\"sources\":1}","{\"sources\":[1]}","{\"sources\":[\"../outside\"]}","{\"sources\":[\"/x\\u0000y\"]}","{\"budget_bytes\":0}","{\"budget_bytes\":1.0}"));
   hpc-check(str_eq(read_file(path),text),"retained execution bytes stay unchanged");
   let report = jv-object(list(jv-s("schema","health-view-contract-v1"),jv-n("accepted",1),jv-n("frozen_projection_cases",3),jv-n("source_states",6),jv-n("request_message_cases",arguments),jv-n("custom_node_callbacks",2),jv-n("retained_bytes",str_len(text)),jv-n("retained_organs",len(jv-items(jv-get(real,"organs")))),jv-s("reference","d02faa1c6:form/form-stdlib/bml/form-core-health.bml; namespace-only copy")));
   let output = jv-emit(report); hpc-check(eq(write_file(".hearth/health-view-contract.json",output),str_len(output)),"contract report retained"); bfc-record-out(bfc-envelope(0,bfc-exchange(out),0,list(3,6,arguments),0),2); print_str(str_concat(output,"\n")); 1;
  }
 }
 if str_eq(read_line(),"run") then hpc-run() else 0;
}
