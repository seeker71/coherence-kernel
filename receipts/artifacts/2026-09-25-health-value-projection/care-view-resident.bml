// Actual source REPL, its retained cursor, and the public Glass command.
// preludes: .hearth/live-resident-care.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class CareViewResident {
  def cvr-run() {
   let root = host_cwd();
   let source = parse-json("retained-care",read_file(".hearth/live-process-care-report.json"));
   let original = str_concat(oh-str(nth(json-array-elements(oh-get(source,"cases")),1),"job"),"/probe.events.jsonl");
   let held = lrh-bound(original);
   let paths = append(lrh-sources(),list("form/form-stdlib/bml/json-view.bml","form/form-stdlib/bml/form-core-care.bml","observe/form-glass-organ-care-run.fk",".hearth/care-view-resident.bml",".hearth/session-home-reading.bml"));
   let bindings = lrh-bind(paths);
   let cwd = lrh-isolate(root,"care-source"); let job = fhn-unique(fhn-at(cwd,".form-heal"),"process-",0);
   fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(oh-s("root",cwd))));
   let event = fhn-at(cwd,"care.events.jsonl"); lrh-copy(original,event);
   let request = json-emit-precise(json-node-object(list(json-node-pair("sources",json-node-array(list(json-node-string(event)))))));
   let input = fhn-at(job,"stdin"); let commands = fh-cat(list("health ",request,"\ncare ",request,"\nhealth ",request,"\ncare ",request,"\nquit\n"));
   lrh-assert(eq(write_file(input,commands),str_len(commands)),"complete production commands");
   // The correlated revision consumes the real revised implementation below.
   let outbound = bfc-envelope(0,host_monotonic_ms(),0,list(128,256),0); bfc-record-out(outbound,0);
   let inbound = bfc-control(outbound,5); bfc-record-in(inbound,1);
   lrh-assert(eq(bfc-apply(outbound,inbound,0,1),1),"correlated revise response selects actual source re-observation");
   let status = fhn-run(job,"repl",0,"root",input,list(fhn-at(root,"fkwu"),fhn-at(root,"form/form-stdlib/form-cli-repl.fk")));
   let process = lrh-capture(job,"repl");
   lrh-assert(and(str_eq(status,"0"),eq(fhn-number(process,"returncode"),0)),"resident care/health exits successfully");
   let stdout = fhn-read(fhn-stage-path(job,"repl",".out")); let care = lrc-lines(split-on(stdout,"\n")); let health = lrh-health-lines(split-on(stdout,"\n"));
   lrh-assert(and(eq(len(care),2),eq(len(health),2)),"two health and two care production replies");
   let first = lrc-check(head(care),event); let second = lrc-check(nth(care,1),event);
   lrh-assert(value_eq(first,second),"all needs, actual supplies and unknowns stay present on quiet read");
   lrh-assert(and(eq(fhn-number(head(health),"read_bytes"),file_size(event)),and(eq(fhn-number(nth(health,1),"read_bytes"),0),and(eq(fhn-number(head(care),"read_bytes"),0),eq(fhn-number(nth(care,1),"read_bytes"),0)))),"health consumes evidence once and both lanes retain one cursor");
   let homeStatus = fhn-run(job,"home",0,"root","/dev/null",list(fhn-at(root,"fkwu"),fhn-at(root,".hearth/session-home-reading.bml")));
   let homeProcess = lrh-capture(job,"home");
   lrh-assert(and(str_eq(homeStatus,"0"),eq(fhn-number(homeProcess,"returncode"),0)),"private home stays separate from real ancestor session state");
   lrh-assert(eq(ohd-num(ohd-retire(cwd,fhn-stage-path(job,"home",".events.jsonl")),"ok"),1),"owned home-observer declaration retired");
   let glassStatus = fhn-run(job,"glass",0,"root","/dev/null",list(fhn-at(root,"fkwu"),fhn-at(root,"observe/form-glass-organ-care-run.fk")));
   let glassProcess = lrh-capture(job,"glass"); let glass = parse-json("glass-care",fhn-read(fhn-stage-path(job,"glass",".out")));
   lrh-assert(and(str_eq(glassStatus,"0"),str_eq(oh-str(glass,"schema"),"form-core-care-v1")),"public Glass care emits the current view");
   lrh-assert(eq(ohd-num(ohd-retire(cwd,fhn-stage-path(job,"glass",".events.jsonl")),"ok"),1),"owned Glass process event declaration retired");
   let released = lrh-release-form(root,cwd,process);
   let retired = rcd-retire(cwd,job,fhn-number(process,"pid"));
   let home = fhn-at(cwd,".hearth/session-learning");
   lrh-assert(and(str_eq(read_file(fhn-at(home,"paused")),"1"),lrh-no-worker(home,list("worker.pid","learner.pid","worker.rc","worker.input","worker.out","worker.err","learner.err","learner.log","state.json"))),"private CLI observation uses no learner or model");
   lrh-assert(and(value_eq(bindings,lrh-bind(paths)),and(value_eq(held,lrh-bound(original)),str_eq(read_file(event),read_file(original)))),"current source and retained event bytes remain exact");
   lrh-assert(and(eq(file_size(fhn-stage-path(job,"repl",".err")),0),eq(file_size(fhn-stage-path(job,"glass",".err")),0)),"production CLI and Glass stderr are clean after explicit cache admission");
   let report = json-node-object(list(oh-s("schema","care-view-resident-observation-v1"),oh-n("accepted",1),oh-s("cwd",cwd),oh-s("job",job),oh-n("first_read_bytes",file_size(event)),oh-n("second_read_bytes",0),oh-n("health_read_bytes",0),oh-n("repl_exit",fhn-number(process,"returncode")),oh-n("repl_stderr_bytes",file_size(fhn-stage-path(job,"repl",".err"))),oh-n("glass_exit",fhn-number(glassProcess,"returncode")),oh-n("glass_stderr_bytes",file_size(fhn-stage-path(job,"glass",".err"))),json-node-pair("projection",first),json-node-pair("sources",json-node-array(bindings)),json-node-pair("input",held),json-node-pair("mount_release",released),json-node-pair("declaration_release",retired)));
   fhn-write-json(".hearth/health-view-resident.json",oh-set(oh-set(oh-set(report,"schema",json-node-string("health-view-resident-observation-v1")),"health_read_bytes",json-node-int(file_size(event))),"session_home_isolation",json-node-int(1)));
   bfc-record-out(bfc-envelope(0,bfc-exchange(outbound),0,list(2,1,1),0),2);
   print(list("resident-care",2,"health",2,"glass",1,"quiet-bytes",0,"retained-input",1,"released",1)); 1;
  }
 }
 if str_eq(read_line(),"run") then cvr-run() else 0;
}
