// preludes: form-stdlib/native-edit.fk
section [form.bml] {
 let source = read_file(".hearth/health-projection-before.bml");
 let text = ne-replace-all(ne-replace-all(source,"ohc-","before-ohc-"),"class FormCoreHealth","class BeforeCoreHealth");
 if ne(write_file(".hearth/health-projection-reference.bml",text),str_len(text)) then form_error("health reference retention incomplete") else 1;
}
