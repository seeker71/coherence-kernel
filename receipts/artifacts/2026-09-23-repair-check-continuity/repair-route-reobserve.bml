// Actual edit -> failed check -> actual diagnosis -> actual next edit.
// Boundary replay only; no model admission or live-state mutation.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let destination = read_line();
 let root = "receipts/artifacts/2026-09-23-native-edit-identity/";
 let request = nsm-json(str_concat(root,"request.json"));
 let checker = fcaq-live-checker(request);
 let start = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let edited = fcap-step(start,read_file(str_concat(root,"first-edit.txt")),checker);
 let failed = fcap-step(edited,"{\"tool\":\"verify\",\"arguments\":[]}",checker);
 let diagnosis = read_file("receipts/artifacts/2026-09-23-repair-check-continuity/diagnosis-before-edit.txt");
 let routed = fcap-step(failed,diagnosis,checker);
 let action = read_file(str_concat(root,"accepted-edit.txt"));
 let after = fcap-step(routed,action,checker);
 let check = fcap-source-check(after,checker);
 let result = json-node-object(list(nsm-s("scope","reconstruct actual repair routing at edit boundary; not a full model replay"),nsm-s("action_sha256",nsm-hash(action)),nsm-s("diagnosis_sha256",nsm-hash(diagnosis)),nsm-s("before_stage",fcap-stage(routed)),nsm-n("before_checks",fcap-checks(routed)),nsm-s("after_stage",fcap-stage(after)),nsm-n("after_checks",fcap-checks(after)),nsm-s("model_observation",fcap-note(after)),nsm-s("candidate_sha256",fat-document-sha(fat-find-doc(fcap-docs(after),"answer.md"))),nsm-n("caller_check_passed",head(check)),nsm-s("caller_check",nth(check,1)),nsm-n("new_provider_calls",0)));
 let path = if or(nothing?(destination),str_eq(destination,"")) then ".hearth/repair-route-current.json" else destination;
 nsm-write(path,result); print_str(json-emit(result));
}
