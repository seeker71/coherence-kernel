// Replay a real rejected action at its original document/check boundary.
// No model admission, live-session mutation or learning target is involved.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let supplied = read_line();
 let destination = if nothing?(supplied) then ".hearth/repair-edit-current.json" else if eq(str_len(fat-trim(supplied)),0) then ".hearth/repair-edit-current.json" else fat-trim(supplied);
 let root = ".hearth/answer-edit-reasoning-2026-09-23";
 let request = nsm-json(nsm-at(root,"request.json"));
 let checker = fcaq-live-checker(request);
 let firstPath = ".hearth/code-memory/replies/95004-1790143044718.txt";
 let repairPath = ".hearth/code-memory/replies/95004-1790144688822-1.txt";
 let raw = read_file(repairPath);
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let edited = fcap-step(initial,read_file(firstPath),checker);
 let before = fcap-step(edited,"{\"tool\":\"verify\",\"arguments\":[]}",checker);
 let after = fcap-step(before,raw,checker);
 let candidate = nth(fat-find-doc(fcap-docs(after),"answer.md"),2);
 let checked = fcaq-check(node_children(json-object-get(request,"checks")),fcap-docs(after));
 let result = json-node-object(list(
  nsm-s("scope","reconstruct the original 515-word document and failed caller check, then apply the exact rejected action; not a replay of the full live session"),
  nsm-s("request_sha256",nsm-hash(read_file(nsm-at(root,"request.json")))),
  nsm-s("first_edit_sha256",nsm-hash(read_file(firstPath))),
  nsm-s("repair_action_sha256",nsm-hash(raw)),
  nsm-s("before_stage",fcap-stage(before)),nsm-s("after_stage",fcap-stage(after)),
  nsm-s("before_sha256",fat-document-sha(fat-find-doc(fcap-docs(before),"answer.md"))),
  nsm-s("after_sha256",nsm-hash(candidate)),
  nsm-n("before_words",fal-count(nth(fat-find-doc(fcap-docs(before),"answer.md"),2))),
  nsm-n("after_words",fal-count(candidate)),
  nsm-n("documents_changed",not(value_eq(fcap-docs(before),fcap-docs(after)))),
  nsm-n("tool_calls",sub(fcap-calls(after),fcap-calls(before))),
  nsm-n("automatic_checks",sub(fcap-checks(after),fcap-checks(before))),
  nsm-n("model_turns",sub(fcap-turns(after),fcap-turns(before))),
  nsm-n("caller_check_passed",head(checked)),nsm-s("caller_check_evidence",nth(checked,1)),
  nsm-s("policy_note",fcap-note(after)),
  json-node-pair("repair_notes",json-node-array(fcap-reflections-json(fcap-reflections(after)))),
  nsm-n("provider_calls",0)));
 nsm-write(destination,result);
 nag-write(str_concat(destination,".answer.txt"),candidate);
 print_str(json-emit-precise(result));
}
