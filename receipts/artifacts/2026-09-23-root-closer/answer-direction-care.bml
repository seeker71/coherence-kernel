// Re-observe retained native bytes, then resume the same owned contract.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class AnswerDirectionCare {
  def adc-save(path,text) {
   write_file_text(path,text);
   if not(str_eq(read_file(path),text)) then form_error("care evidence retention failed") else 0;
  }
  def adc-never(contract,docs) = form_error("syntax care reached caller verification");
 }
 let root = ".hearth/answer-direction-2026-09-23";
 let id = "2d3240750ea48b2786e2e290e4b17f3c245d0e32ab29bd8f0a37e9640ef10221-64826-1790129201736";
 let path = fcam-path(hearth-code-memory(),id,"checkpoint");
 let packet = fcam-read(path);
 if nothing?(packet) then form_error("owned checkpoint unavailable") else 0;
 let state = fcam-state-from(packet);
 let request = parse-json("request",read_file(nsm-at(root,"request.json")));
 let options = if json-object-has?(request,"options") then json-object-get(request,"options") else request;
 let initial = fcaq-initial(options,fat-wire-value(fat-wire-documents(request)));
 let scope = fcam-work-scope(initial,json-emit(json-object-get(options,"checks")));
 if not(and(fcam-packet-valid(packet,"checkpoint",scope),fcam-state-valid(state,initial))) then form_error("owned contract changed") else 0;
 let raw = read_file(".hearth/code-memory/replies/64826-1790129487641.txt");
 let repeated = read_file(".hearth/code-memory/replies/64826-1790129592886.txt");
 let third = read_file(".hearth/code-memory/replies/64826-1790129697039.txt");
 if not(and(str_eq(raw,repeated),str_eq(raw,third))) then form_error("retained repetition changed") else 0;
 let mode = read_line();
 print_str(json-emit(json-node-object(list(nsm-s("checkpoint",id),nsm-s("stage",fcap-stage(state)),nsm-n("turns",fcap-turns(state)),nsm-n("tools",fcap-calls(state)),nsm-n("failures",fcap-failures(state)),nsm-s("note",fcap-note(state)),nsm-n("identical_reply_bytes",str_len(raw))))));
 if str_eq(mode,"apply") then {
  if not(and(str_eq(fcap-stage(state),"implement"),and(eq(fcap-calls(state),1),nil?(fcap-json-repairs(state))))) then form_error("syntax care already applied or checkpoint moved") else 0;
  let home = "receipts/artifacts/2026-09-23-root-closer";
  fs_mkdir(home);
  if not(fcam-write(nsm-at(root,"before-care.checkpoint.fkb"),packet)) then form_error("checkpoint backup failed") else 0;
  adc-save(nsm-at(home,"native-reply.json.txt"),raw);
  let reading = fcac-syntax-before(state,raw,nsm-at(home,"native-reply.json.txt"));
  let next = fcap-step(state,raw,list(adc-never,0));
  let recovered = fcac-syntax-after(state,raw,next,reading);
  if not(and(eq(fcap-calls(next),2),eq(len(fcap-json-repairs(next)),1))) then form_error("retained edit did not reach native tool") else 0;
  let summary = json-node-object(list(nsm-s("checkpoint",id),nsm-n("interrupted_exit",143),nsm-n("identical_retained_replies",3),nsm-n("reply_bytes",str_len(raw)),nsm-n("before_turns",fcap-turns(state)),nsm-n("after_turns",fcap-turns(next)),nsm-n("before_failures",fcap-failures(state)),nsm-n("after_failures",fcap-failures(next)),json-node-pair("repair",parse-json("repair",head(fcap-json-repairs(next)))),json-node-pair("before_health",reading),json-node-pair("after_health",recovered),nsm-s("tool_observation",fcap-note(next)),nsm-n("checks",fcap-checks(next)),nsm-n("model_calls",0),nsm-n("provider_calls",0)));
  adc-save(nsm-at(home,"care.json"),json-emit(summary));
  adc-save(nsm-at(root,"care-candidate.bml"),nth(fat-find-doc(fcap-docs(next),"form/form-stdlib/bml/form-cli-answer-length.bml"),2));
  if not(fcam-save(next)) then form_error("care checkpoint save failed") else 0;
  let resumed = json-node-object(faj-put-pair(node_children(options),json-node-pair("resume",json-node-string(id))));
  let resumeRequest = if json-object-has?(request,"options") then json-node-object(faj-put-pair(node_children(request),json-node-pair("options",resumed))) else resumed;
  adc-save(nsm-at(root,"resume-request.json"),json-emit(resumeRequest));
  print_str(json-emit(summary));
 } else 0;
}
