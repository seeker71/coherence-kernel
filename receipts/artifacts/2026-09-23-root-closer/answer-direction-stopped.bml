// Attribute the stopped native task and inspect the actual unchanged edit.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let id = "2d3240750ea48b2786e2e290e4b17f3c245d0e32ab29bd8f0a37e9640ef10221-64826-1790129201736";
 let packet = fcam-read(fcam-path(hearth-code-memory(),id,"checkpoint"));
 let s = fcam-state-from(packet);
 let root = "receipts/artifacts/2026-09-23-root-closer";
 let raw = read_file(nsm-at(root,"unchanged-native-edit.json.txt"));
 if not(faj-valid(raw)) then form_error("retained unchanged command malformed") else 0;
 let obj = parse-json("unchanged-command",raw); let args = fcap-array(obj,"arguments");
 let checked = fat-call(fcap-docs(s),fcap-string(obj,"tool"),args,fcap-string(obj,"input"));
 if not(and(eq(fat-exit(checked),2),and(ge(str_find(fat-error(checked),"edit-unchanged:",0),0),value_eq(fat-documents(checked),fcap-docs(s))))) then form_error("retained edit was not unchanged") else 0;
 let evidence = json-node-object(list(nsm-s("checkpoint",id),nsm-s("stage",fcap-stage(s)),nsm-n("turns",fcap-turns(s)),nsm-n("tool_calls",fcap-calls(s)),nsm-n("failures",fcap-failures(s)),nsm-n("checks",fcap-checks(s)),nsm-n("last_observed_generated_ids",1589),nsm-n("last_observed_injected_ids",1063),nsm-n("last_observed_elapsed_ms",636635),nsm-n("terminal_exit",143),nsm-s("counter_scope","last progress sample from resumed run; not aggregate counters across interruption"),nsm-n("unchanged_edit_bytes",str_len(raw)),nsm-s("source_completion","Codex supplied executable restructuring and the two-branch reserve; native checkpoint remains unfinished")));
 let reading = oh-reading("native-coding",id,"unchanged-edit-after-syntax-care",json-node-string("progress on requested source repair"),json-node-string("native edit supplied identical old and new source"),json-node-int(0),list(oh-need("source-repair",oh-reference(nsm-at(root,"unchanged-native-edit.json.txt")))),list("revise"),evidence);
 oh-voice(reading); let response = oh-response(reading,"revise"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"revise")) then form_error("source care uncorrelated") else 0;
 oh-voice(oh-applied(reading,"revise",evidence));
 nsm-write(nsm-at(root,"stopped.json"),evidence);
 print_str(json-emit(evidence));
}
