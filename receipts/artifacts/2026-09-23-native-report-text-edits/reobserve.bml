// Encode the already-observed model deletion as a native literal report edit.
// stdin: output directory. No model admission and no private state access.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = read_line();
 if or(nothing?(root),str_eq(root,"")) then form_error("reobservation output directory required") else 0;
 let before = read_file("receipts/artifacts/2026-09-23-native-current-task/reply-4/report.json");
 let originalAction = read_file("receipts/artifacts/2026-09-23-native-report-text-edits/public-reply-5.json");
 let expected = read_file("receipts/artifacts/2026-09-23-native-report-text-edits/report.json");
 let edit = json-node-object(list(json-node-pair("path",json-node-array(list(json-node-string("answer")))),nsm-s("old"," of attending to evidence"),nsm-s("new","")));
 let action = json-node-object(list(json-node-pair("report_amend",json-node-object(list(nsm-s("base",fcra-id(before)),json-node-pair("text_edits",json-node-array(list(edit))))))));
 let result = fcra-apply(before,action);
 if not(head(result)) then form_error(nth(result,2)) else 0;
 let candidate = json-emit(nth(result,1));
 if not(str_eq(candidate,expected)) then form_error("literal representation changed the actual model result") else 0;
 let request = nsm-json("receipts/artifacts/2026-09-23-native-current-task/request.json");
 let sourceCheck = fcaq-check(node_children(oh-get(request,"checks")),fat-wire-value(fat-wire-documents(request)));
 let reportCheck = fcaq-report-check(node_children(oh-get(request,"report_checks")),candidate);
 let evidence = json-node-object(list(nsm-s("representation_source","Codex encoded the already-observed Qwen deletion as text_edits; this is not new model output"),nsm-n("same_report_bytes",1),nsm-n("original_action_bytes",str_len(originalAction)),nsm-n("literal_action_bytes",str_len(json-emit(action))),nsm-n("payload_bytes_saved",sub(str_len(originalAction),str_len(json-emit(action)))),nsm-n("before_words",fal-count(nsm-str(parse-json("prior",before),"answer"))),nsm-n("after_words",fal-count(nsm-str(nth(result,1),"answer"))),nsm-n("source_checks_passed",head(sourceCheck)),nsm-n("report_checks_passed",head(reportCheck)),nsm-s("report_check_observation",nth(reportCheck,1)),nsm-n("model_calls",0),nsm-s("scope","Exact replay establishes a smaller action with identical content and checks. Future model use, generated-token savings and answer-quality improvement remain unobserved.")));
 fs-mkdir(root);
 nsm-write(nsm-at(root,"literal-action.json"),action);
 nag-write(nsm-at(root,"report.json"),candidate);
 nsm-write(nsm-at(root,"reobservation.json"),evidence);
 print_str(json-emit(evidence));
 0;
}
