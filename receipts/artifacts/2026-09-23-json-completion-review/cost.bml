// Aggregate the actual two owned review calls, including the failed first one.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-23-json-completion-review";
 let first = nsm-json(nsm-at(root,"first-observation.json"));
 let after = nsm-json(nsm-at(root,"after-observation.json"));
 let a = json-object-get(first,"provider_usage"); let b = json-object-get(after,"provider_usage");
 if not(and(str_eq(nsm-str(a,"status"),"observed"),str_eq(nsm-str(b,"status"),"observed"))) then form_error("review usage unobserved") else 0;
 let summary = json-node-object(list(nsm-n("provider_calls",2),nsm-n("provider_tokens",add(nsm-num(a,"input_plus_output_tokens"),nsm-num(b,"input_plus_output_tokens"))),nsm-n("cached_input_tokens",add(nsm-num(a,"cached_input_tokens"),nsm-num(b,"cached_input_tokens"))),nsm-n("provider_elapsed_ms",add(nsm-num(first,"provider_elapsed_ms"),nsm-num(after,"provider_elapsed_ms"))),nsm-n("both_released",and(eq(nsm-num(first,"process_released"),1),eq(nsm-num(after,"process_released"),1))),nsm-s("scope","two provider execution windows; failed first call included; coordinating work separate")));
 nsm-write(nsm-at(root,"cost.json"),summary); print_str(json-emit(summary));
 1;
}
