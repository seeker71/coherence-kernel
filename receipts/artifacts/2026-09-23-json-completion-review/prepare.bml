// Prepare one actual implementation review. No inference or file mutation of
// reviewed source. The separate synthesis door owns the offered provider call.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 def jcr-lines(rows) = if nil?(rows) then list() else cons(line-text(head(rows)),jcr-lines(tail(rows)));
 def jcr-source(path,first,count) {
  let text = read_file(path);
  if or(not(str_eq(value_kind(text),"string")),le(str_len(text),0)) then form_error("review source unavailable") else 0;
  let excerpt = if eq(count,0) then text else fat-join(jcr-lines(take(count,drop(sub(first,1),lines-from-source(text)))),"\n");
  json-node-object(list(nsm-s("path",path),nsm-n("first_line",first),nsm-n("line_count",count),nsm-s("scope",if eq(count,0) then "complete file" else "selected lines; omitted source is unobserved"),nsm-s("whole_source_sha256",nsm-hash(text)),nsm-s("text",excerpt)));
 }
 let sources = list(
  jcr-source("form/form-stdlib/bml/form-cli-json-completion.bml",1,0),
  jcr-source("form/form-stdlib/bml/form-cli-code-live.bml",1,0),
  jcr-source("form/form-stdlib/form-cli-model-session.fk",1,0),
  jcr-source("form/form-stdlib/bml/form-cli-model-adapter.bml",1,0),
  jcr-source("form/form-stdlib/bml/form-cli-reasoning-budget.bml",1,0),
  jcr-source("form/form-stdlib/bml/form-agent-json-query.bml",1,85),
  jcr-source("form/form-stdlib/bml/form-agent-tool-values.bml",25,16),
  jcr-source("form/native/metal/qwen35-dense-token-handle.fk",887,88),
  jcr-source("form/form-stdlib/tests/form-cli-json-completion-band.bml",1,0));
 let domain = json-node-object(list(nsm-s("schema","native-json-completion-review-v1"),json-node-pair("sources",json-node-array(sources)),nsm-s("observed","Boundary checks pass. A prior live task emitted the same unfinished 549-byte edit three times, ending inside a JSON string after 170 final tokens. Its configured stop is im_end, ID 248046. A new live continuation has returned one complete but unchanged edit; it has not yet exercised the new stop-selection path. No answer-quality improvement has been established.")));
 let document = json-node-object(list(nsm-s("id","source"),nsm-s("path","review-source.json"),nsm-s("text",json-emit(domain))));
 let goal = "Review the newly added FormCliJsonCompletion and its integration into fcac-reasoned for concrete correctness defects. Follow state, uncommitted pending token, logit ownership, generated-token allowance and accounting through the supplied callers. Check whether it can act on an incomplete response, repeat a consumed token, lose the original prefix or leak private reasoning. Distinguish a real defect from an unobserved live result; do not infer omitted source behavior. Return answer as a concise review summary and findings as an array of actionable defects with path, function, trigger, consequence and smallest repair. Return an empty findings array if no concrete defect is supported. Do not invent a finding to fill the array. This is an implementation review of actual landed work, not an answer-quality evaluation. No tools, repository writes, extra inference calls or training.";
 let checks = parse-json("review-checks","[{\"tool\":\"jq\",\"arguments\":[\".schema\",\"review-source.json\"],\"stdout\":\"\\\"native-json-completion-review-v1\\\"\\n\"}]");
 let reportChecks = parse-json("review-report-checks","[{\"tool\":\"jq\",\"arguments\":[\".answer | type\"],\"stdout\":\"\\\"string\\\"\\n\"},{\"tool\":\"jq\",\"arguments\":[\".findings | type\"],\"stdout\":\"\\\"array\\\"\\n\"}]");
 let request = json-node-object(list(nsm-s("mode","review"),nsm-n("evaluation",1),nsm-s("goal",goal),json-node-pair("documents",json-node-array(list(document))),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",checks),json-node-pair("report_checks",reportChecks)));
 let manifest = json-node-object(list(nsm-s("session","json-completion-review-2026-09-23"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","json-completion-review"),json-node-pair("request",request)))))),json-node-pair("provider",parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}"))));
 if not(and(frsy-valid(manifest),frsy-sources(node_children(json-object-get(manifest,"cases"))))) then form_error("review manifest/source checks refused") else 0;
 fs-mkdir(".hearth/json-completion-review");
 frsh-frozen(".hearth/json-completion-review/manifest.json",json-emit(manifest));
 frsh-frozen(".hearth/json-completion-review/source.json",json-emit(domain));
 print_str(json-emit(json-node-object(list(nsm-n("sources",len(sources)),nsm-n("provider_prompt_bytes",str_len(frsy-prompt(manifest))),nsm-n("provider_calls",0)))));
 1;
}
