// Supply the omitted action-admission boundary and executed counterevidence.
// The original provider answer and failed report checks remain retained.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml form-stdlib/bml/form-cli-review-context-care.bml
section [form.bml] {
 let root = ".hearth/json-completion-review";
 let original = nsm-json(nsm-at(root,"manifest.json"));
 let member = head(json-array-elements(json-object-get(original,"cases")));
 let request = json-object-get(member,"request");
 let before = read_file(nsm-at(root,"source.json"));
 let goal = "Additional source: form-cli-code-policy.bml owns strict action admission; form-cli-reasoning-budget.bml owns admission of the reserved final stage. Source coverage does not establish review correctness.\n";
 let parts = list(list("form/form-stdlib/bml/form-cli-code-policy.bml","  def fcap-step(","  def fcap-object("),list("form/form-stdlib/bml/form-cli-reasoning-budget.bml","  def frbg-reserve-fits(","  def frbg-decode("));
 let cared = frcc-prepare(fhn-root(),"json-completion-review",nsm-at(root,"care-events.jsonl"),before,goal,parts);
 if nothing?(head(cared)) then form_error("review context unavailable") else 0;
 frsh-frozen(nsm-at(root,"additional-source.txt"),head(cared));
 let task = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let prior = nsm-json("receipts/artifacts/2026-09-23-native-json-completion/result.json");
 let checker = fcaq-live-checker(task);
 let initial = fcaq-initial(task,fat-wire-value(fat-wire-documents(prior)));
 let state = fcap-before-review(fcap-count-check(initial),fcap-source-check(initial,checker));
 let raw = read_file("receipts/artifacts/2026-09-23-native-json-completion/reply-3.txt");
 let next = fcap-step(state,raw,checker);
 let reservation = fcms-session("live","boundary-arithmetic","","",list(),list(),17,10,0,0,10,0,0,0);
 let observed = json-node-object(list(nsm-s("action_sha256",nsm-hash(raw)),nsm-n("reply_bytes",str_len(raw)),nsm-s("observation",fcap-note(next)),nsm-n("tool_calls",fcap-calls(next)),nsm-n("documents_changed",not(value_eq(fcap-docs(state),fcap-docs(next)))),nsm-n("exact_fit_admitted_by_reserve",frbg-reserve-fits(reservation,3,4)),nsm-s("reserve_scope","boundary arithmetic: position 10, added observation 3, answer allowance 4, context 17; no model admitted"),nsm-n("model_calls",0)));
 if not(and(eq(fcap-calls(next),0),value_eq(fcap-docs(state),fcap-docs(next)))) then form_error("unfinished action unexpectedly acted") else 0;
 frsh-frozen(nsm-at(root,"counterevidence.json"),json-emit(observed));
 let previous = read_file(".hearth/response-sessions/syntheses/71525fb428a300a2ec1b5156d1ca60ee0ea303397557ce4f92e197aa459d2af8/provider-answer.json");
 let added = list(json-node-object(list(nsm-s("id","care"),nsm-s("path","additional-source.txt"),nsm-s("text",head(cared)))),json-node-object(list(nsm-s("id","counterevidence"),nsm-s("path","counterevidence.json"),nsm-s("text",json-emit(observed)))),json-node-object(list(nsm-s("id","prior-review"),nsm-s("path","prior-review.json"),nsm-s("text",previous))));
 let informed = oh-set(request,"documents",json-node-array(append(json-array-elements(json-object-get(request,"documents")),added)));
 let clarification = " Re-evaluate the prior review against the added action-admission source and executed counterevidence. The first supplied packet omitted fcap-step's definition. Distinguish generation completion from syntax admission: determine whether the invalid stopped response can actually execute a tool. Determine whether exact context equality is reachable through the supplied final-stage reservation contract before calling the conservative continuation guard a defect. Preserve a real counterexample if one remains. The prior review also failed the original report shape by using summary. Return the report with exactly answer (string) and findings (array); all original checks remain. Do not treat the prior findings or this clarification as an expected verdict.";
 let updated = oh-set(informed,"goal",json-node-string(str_concat(fcap-string(request,"goal"),clarification)));
 let manifest = oh-set(oh-set(original,"session",json-node-string("json-completion-review-care-2026-09-23")),"cases",json-node-array(list(oh-set(member,"request",updated))));
 if not(and(frsy-valid(manifest),frsy-sources(json-array-elements(json-object-get(manifest,"cases"))))) then form_error("review care manifest refused") else 0;
 frsh-frozen(nsm-at(root,"care-manifest.json"),json-emit(manifest));
 print_str(json-emit(json-node-object(list(nsm-n("provider_prompt_bytes",str_len(frsy-prompt(manifest))),nsm-n("provider_calls",0),json-node-pair("counterevidence",observed)))));
 1;
}
