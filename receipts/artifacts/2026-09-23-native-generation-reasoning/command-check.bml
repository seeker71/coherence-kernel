// Exercise the public command boundary without admitting model resources.
// preludes: form-stdlib/bml/form-cli-generate-command.bml
section [form.bml] {
 def need(value,why) = if value then 1 else form_error(why);
 def invalid(arg) {
  let result = fgc-run(fcmr-none(),"unused-model",arg);
  need(and(gt(str_len(head(result)),0),not(fcmr-live?(nth(result,1)))),"invalid command admitted resources");
  need(eq(head(fgc-request(arg)),0),"invalid allowance accepted");
 }
 let body = "Explain 0, 1 and nothing.  Keep spacing.\nAnd this line.";
 let plain = fgc-request(body); let selected = fgc-request(str_concat("--tokens 64 ",body));
 need(and(eq(head(plain),2048),str_eq(nth(plain,1),body)),"ordinary request changed");
 need(and(eq(head(selected),64),str_eq(nth(selected,1),body)),"explicit allowance or prompt changed");
 need(eq(nth(plain,3),0),"ordinary generation gained a reasoning stage");
 let reasoned = fgc-request(str_concat("--reasoning 2048 --tokens 512 ",body));
 let reordered = fgc-request(str_concat("--tokens 512 --reasoning 2048 ",body));
 need(and(value_eq(reasoned,reordered),and(eq(head(reasoned),512),and(eq(nth(reasoned,3),2048),str_eq(nth(reasoned,1),body)))),"reasoning option or original prompt changed");
 invalid(""); invalid("--tokens"); invalid("--tokens 0 ask"); invalid("--tokens -1 ask"); invalid("--tokens 1.5 ask"); invalid("--tokens 10x ask"); invalid("--tokens 10 ");
 invalid("--reasoning"); invalid("--reasoning 0 ask"); invalid("--reasoning -1 ask"); invalid("--reasoning 1.5 ask"); invalid("--reasoning 01 ask"); invalid("--reasoning 10 "); invalid("--tokens 4 --tokens 8 ask"); invalid("--reasoning 4 --reasoning 8 ask");
 let absent = fgc-run(fcmr-none(),"","--tokens 64 hello");
 need(ge(str_find(head(absent),"no model is picked",0),0),"missing model guidance changed");
 let absentReasoning = fgc-run(fcmr-none(),"","--reasoning 2048 hello");
 need(ge(str_find(head(absentReasoning),"no model is picked",0),0),"reasoning missing model guidance changed");
 need(str_eq(fcms-reason(fcms-open-reserved("unused","prompt",0,"full-reasoning")),"session-output-reserve-refused"),"invalid output reserve reached model admission");
 print(list("generate-command-boundary",1,"prompt-bytes-preserved",1,"invalid-admissions",0));
}
