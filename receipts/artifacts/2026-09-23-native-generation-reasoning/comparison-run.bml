// Same enquiry, teaching and answer allowance, with native deliberation open.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-reasoning-budget.bml form-stdlib/native-session-memory.bml ../observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 def keep(path,text) = if not(eq(write_file(path,text),str_len(text))) then form_error("reasoning answer retention incomplete") else if not(str_eq(read_file(path),text)) then form_error("reasoning answer readback differs") else 1;
 let previous = nsm-json(".hearth/generate-answer-repaired.json");
 let prompt = read_file(".hearth/generate-answer-source.txt");
 if not(str_eq(nsm-hash(prompt),nsm-str(previous,"prompt_sha256"))) then form_error("original enquiry changed") else 0;
 if not(str_eq(fqt-meaning-prefix(),read_file(".hearth/generate-answer-meaning.txt"))) then form_error("shared teaching changed") else 0;
 let answer = nsm-num(previous,"allowance"); let reasoning = 2048; let context = 12288;
 let text = str_concat(fcmg-teach(prompt),str_concat("\n",fhm-caller-budget-text(answer)));
 keep(".hearth/generate-reasoning-admitted-user.txt",text);
 keep(".hearth/generate-reasoning-admitted-system.txt",ftl-system-text());
 let observation = bfc-envelope(0,now_unix_ms(),0,list(871,0,answer),nothing());
 bfc-record-out(observation,0); let control = bfc-control(observation,5); bfc-record-in(control,5);
 if not(eq(bfc-exchange(control),bfc-exchange(observation))) then form_error("reasoning observation uncorrelated") else 0;
 let waitStart = host_monotonic_ms(); nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let waitMs = sub(host_monotonic_ms(),waitStart);
 let model = nsm-str(previous,"model"); let started = host_monotonic_ms();
 print(list("reasoning-generation-ready",host_pid(),reasoning,answer,context,waitMs));
 let session = fcms-open-with-profile(model,text,context,"full-reasoning");
 let result = frbg-generate(session,reasoning,answer); let last = frbg-session(result);
 let elapsed = sub(host_monotonic_ms(),started); let released = fcms-release-ok?(last);
 keep(".hearth/generate-reasoning-private-initial.txt",fcms-generation-text(frbg-first(result)));
 keep(".hearth/generate-reasoning-private-final.txt",fcms-generation-text(frbg-final(result)));
 keep(".hearth/generate-reasoning-controller.txt",frbg-notice(result));
 keep(".hearth/generate-reasoning-answer.txt",frbg-answer(result));
 let report = json-node-object(list(nsm-s("schema","ordinary-native-reasoning-comparison-v1"),nsm-s("model",model),nsm-s("prompt_sha256",nsm-hash(prompt)),nsm-s("meaning_sha256",nsm-hash(fqt-meaning-prefix())),nsm-s("admitted_user_sha256",nsm-hash(text)),nsm-s("admitted_system_sha256",nsm-hash(ftl-system-text())),nsm-n("reasoning_allowance",reasoning),nsm-n("answer_allowance",answer),nsm-n("context",context),nsm-n("prompt_ids",fcms-prompt-ids(last)),nsm-n("initial_generated_ids",len(fcms-generation-ids(frbg-first(result)))),nsm-n("final_generated_ids",len(fcms-generation-ids(frbg-final(result)))),nsm-n("injected_ids",fcms-injected-ids(last)),nsm-n("complete",frbg-complete(result)),nsm-s("reason",frbg-reason(result)),nsm-s("answer_origin",frbg-origin(result)),nsm-n("learner_wait_ms",waitMs),nsm-n("elapsed_ms",elapsed),nsm-n("release_ok",released),nsm-n("provider_calls",0),nsm-s("scope","same question, supplied source, shared teaching, full system and final allowance; open reasoning and bounded final-stage session replace ordinary generation; actual final words establish answer quality")));
 keep(".hearth/generate-reasoning-report.json",json-emit(report));
 bfc-record-out(bfc-envelope(0,bfc-exchange(observation),0,list(frbg-complete(result),elapsed,released),nothing()),0);
 print_str(str_concat(json-emit(report),"\n"));
 if not(released) then form_error("reasoning session release incomplete") else 0;
}
