// Retain public final answers and metadata; initial model deliberation stays local.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 def keep(path,text) = if not(eq(write_file(path,text),str_len(text))) then form_error("public generation retention incomplete") else if not(str_eq(read_file(path),text)) then form_error("public generation readback differs") else 1;
 def words(text,at,inside,count) = if ge(at,str_len(text)) then count else {
  let byte = str_byte_at(text,at); let space = or(eq(byte,32),or(eq(byte,9),or(eq(byte,10),eq(byte,13))));
  words(text,add(at,1),not(space),add(count,if and(not(space),not(inside)) then 1 else 0));
 };
 def packet(root,name,path) {
  let text = read_file(path);
  if le(str_len(text),0) then form_error(str_concat("missing public evidence: ",path)) else 0;
  let value = json-node-object(list(nsm-s("text",text),nsm-n("bytes",str_len(text)),nsm-n("whitespace_words",words(text,0,0,0)),nsm-s("sha256",nsm-hash(text))));
  let out = str_concat(root,str_concat("/",str_concat(name,".json")));
  keep(out,json-emit(value));
  if not(str_eq(nsm-str(nsm-json(out),"text"),text)) then form_error("encoded evidence differs") else 0;
  print(list(name,"bytes",str_len(text),"whitespace-words",nsm-num(value,"whitespace_words"),"sha256",nsm-hash(text)));
 }
 let root = "receipts/artifacts/2026-09-23-native-generation-reasoning";
 if le(file_size(".hearth/generate-reasoning-command.json"),0) then form_error("public command observation is pending") else 0;
 fs-mkdir(root);
 packet(root,"source",".hearth/generate-answer-source.txt");
 packet(root,"repair-packet",".hearth/generate-reasoning-repair-packet.txt");
 packet(root,"admitted-user",".hearth/generate-reasoning-admitted-user.txt");
 packet(root,"admitted-system",".hearth/generate-reasoning-admitted-system.txt");
 packet(root,"reasoning-answer",".hearth/generate-reasoning-answer.txt");
 packet(root,"command-answer",".hearth/generate-reasoning-command-answer.txt");
 keep(str_concat(root,"/reasoning-report.json"),read_file(".hearth/generate-reasoning-report.json"));
 keep(str_concat(root,"/command-report.json"),read_file(".hearth/generate-reasoning-command.json"));
 keep(str_concat(root,"/command-answer.txt"),read_file(".hearth/generate-reasoning-command-answer.txt"));
 keep(str_concat(root,"/template-check.bml"),read_file(".hearth/generate-reasoning-check.bml"));
 keep(str_concat(root,"/command-check.bml"),read_file(".hearth/generate-command-check.bml"));
 keep(str_concat(root,"/comparison-run.bml"),read_file(".hearth/generate-answer-reasoning.bml"));
 keep(str_concat(root,"/command-run.bml"),read_file(".hearth/generate-reasoning-command.bml"));
 print(list("public-final-evidence",root,"private-reasoning-published",0));
}
