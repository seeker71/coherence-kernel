// Verify supplied system/user segments survive opening the reasoning span.
// preludes: form-stdlib/bml/form-cli-reasoning-template.bml
section [form.bml] {
 def need(ok,why) = if ok then 1 else form_error(why);
 let crystal = list(1,101,102,103,104,list(11),list(12),list(13),list(14));
 let prompt = "Same enquiry.\nExact source.  "; let system = "Same Form teachings.\n";
 let ordinary = qtlc-full-chat-segments(prompt,system,crystal);
 let reasoning = fcrt-profile-segments(prompt,system,crystal,"full-reasoning");
 need(value_eq(take(sub(len(ordinary),3),ordinary),take(sub(len(reasoning),1),reasoning)),"system or user prefix changed");
 need(value_eq(head(reverse(reasoning)),qtlc-id-segment(nth(crystal,6))),"reasoning opening lost newline");
 need(value_eq(fcrt-profile-segments(prompt,system,crystal,"knowledge-query-reasoning"),fcrt-segments(prompt,crystal)),"review profile changed");
 need(value_eq(fcrt-profile-segments(prompt,"",crystal,"full-reasoning"),fcrt-segments(prompt,crystal)),"unarmed system profile changed");
 print(list("reasoning-template",1,"system-and-source-identical",1));
}
