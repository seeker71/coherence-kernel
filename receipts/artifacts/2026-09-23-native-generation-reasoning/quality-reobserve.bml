// Return the actual source comparison to the organ; the caller owns its semantic
// assessment. Native counting supplies length, not a semantic-quality grade.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-23-native-generation-reasoning";
 let answer = nsm-json(str_concat(root,"/command-answer.json"));
 let detail = json-node-object(list(nsm-s("answer",str_concat(root,"/command-answer.json")),nsm-s("assessment_source","arriving-agent comparison with supplied source"),nsm-n("prior_targeted_claims",2),nsm-n("prior_claims_resolved",2),nsm-n("remaining_unmeasured_outcome_claim",1),nsm-s("scope","feedback-assisted repair; no automatic semantic verification or retained Qwen learning established")));
 oh-voice(oh-reading("native-generation","generate-reasoning-source-repair","answer-grounding",json-node-int(0),json-node-int(1),json-node-int(0),list(oh-need("ground-felt-outcome-claim",detail)),list("inspect-retained-evidence"),detail));
 let count = nsm-num(answer,"whitespace_words");
 oh-voice(oh-reading("native-generation","generate-reasoning-source-repair","answer-length",json-node-int(450),json-node-int(count),json-node-int(le(count,450)),list(oh-need("requested-answer-length",json-node-int(count))),list("inspect-retained-evidence"),json-node-object(list(nsm-s("counter","ASCII whitespace boundaries"),nsm-s("answer",str_concat(root,"/command-answer.json"))))));
}
