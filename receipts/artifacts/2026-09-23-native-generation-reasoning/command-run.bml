// Repair the actual response through the public command boundary, with explicit
// caller-observed source contradictions. This adds feedback to the same enquiry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 def keep(path,text) = if not(eq(write_file(path,text),str_len(text))) then form_error("command answer retention incomplete") else if not(str_eq(read_file(path),text)) then form_error("command answer readback differs") else 1;
 let prior = nsm-json(".hearth/generate-reasoning-report.json");
 let prompt = read_file(".hearth/generate-answer-source.txt");
 if not(str_eq(nsm-hash(prompt),nsm-str(prior,"prompt_sha256"))) then form_error("original enquiry changed") else 0;
 if not(str_eq(fqt-meaning-prefix(),read_file(".hearth/generate-answer-meaning.txt"))) then form_error("shared teaching changed") else 0;
 if not(str_eq(ftl-system-text(),read_file(".hearth/generate-reasoning-admitted-system.txt"))) then form_error("system teaching changed") else 0;
 let draft = read_file(".hearth/generate-reasoning-answer.txt");
 let feedback = "The preceding answer contains two observed source contradictions. (1) It says the old cell persists, referenced or not. The supplied axiom says the referenced old cell persists and the unreferenced composts; the shared teaching says a cell with no remaining reference may be reclaimed. Preserve that condition. (2) It says an out-of-box model has no such state and fills the gap with a guess or hedge. The enquiry supplies no measured out-of-box baseline, so those claims have no evidence here. Explain the Form teaching and its practical contribution without inventing another model's behavior. Keep the correct distinction that supplied valence annotations do not measure a person's inner state. Return a corrected, complete 350-450 word answer to the original enquiry, covering all its axes with warmth and concrete meaning. Do not narrate this correction process.";
 let repairedPrompt = str_concat(prompt,str_concat("\n\nACTUAL NATIVE DRAFT TO CORRECT\n",str_concat(draft,str_concat("\n\nSOURCE-GROUNDED CALLER FEEDBACK\n",feedback))));
 keep(".hearth/generate-reasoning-repair-packet.txt",repairedPrompt);
 let evidence = json-node-object(list(nsm-s("packet",".hearth/generate-reasoning-repair-packet.txt"),nsm-n("caller_observed_source_contradictions",2),nsm-s("assessment_source","arriving-agent comparison with the supplied source")));
 let reading = oh-reading("native-generation","generate-reasoning-source-repair","answer-grounding",json-node-int(0),json-node-int(2),json-node-int(0),list(oh-need("source-grounded-revision",evidence)),list("revise-answer"),evidence);
 oh-voice(reading); let response = oh-response(reading,"revise-answer"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"revise-answer")) then form_error("source revision control is uncorrelated") else 0;
 nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let request = str_concat("--reasoning ",str_concat(int_to_str(nsm-num(prior,"reasoning_allowance")),str_concat(" --tokens ",str_concat(int_to_str(nsm-num(prior,"answer_allowance")),str_concat(" ",repairedPrompt)))));
 print(list("public-generation-command-ready",host_pid()));
 let result = fgc-run(fcmr-none(),nsm-str(prior,"model"),request);
 keep(".hearth/generate-reasoning-command.txt",head(result));
 let detail = nth(result,2);
 oh-voice(oh-applied(reading,"revise-answer",detail));
 keep(".hearth/generate-reasoning-command.json",json-emit(detail));
 keep(".hearth/generate-reasoning-command-answer.txt",read_file(str_concat(oh-str(detail,"private_evidence"),"/answer.txt")));
 print_str(str_concat(json-emit(detail),"\n"));
 if not(and(eq(nsm-num(detail,"release_ok"),1),fcmr-release-ok?(nth(result,1)))) then form_error("public command release incomplete") else 0;
}
