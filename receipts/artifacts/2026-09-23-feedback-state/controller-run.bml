// preflight-exec: forbidden
// Correct the retained real answer through the public generation command.
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 let root = ".hearth/native-answer-length-controller-2026-09-23";
 if not(eq(host_dir_mkdir(root),1)) then form_error("answer length evidence already exists") else 0;
 let source = read_file(".hearth/generate-answer-source.txt");
 let original = nsm-json(".hearth/generate-answer-repaired.json");
 if not(str_eq(nsm-hash(source),nsm-str(original,"prompt_sha256"))) then form_error("original enquiry changed") else 0;
 let draft = read_file(".hearth/generate-reasoning-command-answer.txt");
 let count = fal-count(draft);
 let feedback = str_concat(fal-feedback(count,350,450)," Preserve the source distinctions the draft already carries. Its final sentence promises how the person leaves; no such felt outcome was observed. Express that as the practice's intention, with no promised effect on the person. Keep the response useful and direct, without narrating this revision process.");
 let prompt = str_concat(source,str_concat("\n\nACTUAL NATIVE ANSWER TO REVISE\n",str_concat(draft,str_concat("\n\nOBSERVATION AND REQUEST\n",feedback))));
 fgcr-keep(root,"question.txt",source); fgcr-keep(root,"before.txt",draft); fgcr-keep(root,"prompt.txt",prompt);
 let observation = json-node-object(list(nsm-n("words",count),nsm-n("minimum",350),nsm-n("maximum",450),nsm-s("source_sha256",nsm-hash(source)),nsm-s("draft_sha256",nsm-hash(draft)),nsm-s("semantic_feedback_source","Codex: the final sentence promises an unobserved felt outcome")));
 nsm-write(nsm-at(root,"before.json"),observation);
 let reading = oh-reading("native-generation",root,"retained-answer-length",json-node-int(450),json-node-int(count),json-node-int(fal-within(count,350,450)),list(oh-need("complete-answer-within-requested-range",oh-reference(nsm-at(root,"before.json")))),list("revise-retained-answer"),oh-reference(nsm-at(root,"before.json")));
 oh-voice(reading); let response = oh-response(reading,"revise-retained-answer"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"revise-retained-answer")) then form_error("answer correction response is uncorrelated") else 0;
 nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let model = mr-path(mr-find("qwen38-q8"));
 print(list("native-length-revision-ready",host_pid(),count));
 let result = fgc-run(fcmr-none(),model,str_concat("--tokens 2048 --words 350:450 ",prompt));
 let detail = nth(result,2); let answer = read_file(nsm-at(nsm-str(detail,"private_evidence"),"answer.txt"));
 fgcr-keep(root,"answer.txt",answer); nsm-write(nsm-at(root,"result.json"),detail);
 oh-voice(oh-applied(reading,"revise-retained-answer",detail));
 print_str(str_concat(json-emit-precise(detail),"\n"));
 if not(and(eq(nsm-num(detail,"release_ok"),1),eq(nsm-num(detail,"retained"),1))) then form_error("length revision resources or evidence incomplete") else 0;
}
