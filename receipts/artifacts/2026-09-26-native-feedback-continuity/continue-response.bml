// Repair the remaining observed claims in the same retained response.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def fcc-root() = "receipts/artifacts/2026-09-26-native-feedback-continuity";
 def fcc-home() = ".hearth/native-feedback-continuity";
 let previous = "receipts/artifacts/2026-09-26-native-identity-usefulness-care";
 let request = nsm-json(nsm-at(previous,"request.json"));
 let prior = nsm-json(nsm-at(previous,"terminal-result.json"));
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let scope = fcam-work-scope(initial,json-emit(oh-get(request,"checks")));
 let packet = fcam-read(fcam-path(hearth-code-memory(),nsm-str(request,"resume"),"checkpoint"));
 if not(fcam-packet-valid(packet,"checkpoint",scope)) then form_error("current checkpoint contract invalid") else 0;
 let state = fcam-state-from(packet);
 if not(and(fcam-state-valid(state,initial),and(str_eq(fcap-stage(state),"complete"),eq(nsm-num(prior,"release_ok"),1)))) then form_error("current response is not complete and released") else 0;
 let answer = nth(fat-find-doc(fcap-docs(state),"answer.md"),2);
 if not(str_eq(nsm-hash(answer),"1a15dff2be8b01563cf03f91754f954832bd6988e2c84d9121c3b943e3c4788b")) then form_error("current answer differs from the observed 443-word answer; inspect before continuing") else 0;
 let finding = "The completed 443-word answer still ends its numeric-identity paragraph with 'I can offer a corrected response without the old one being destroyed.' This applies conditional Form-cell retention to this prose revision without supplied evidence of that transition or retention. Keep the cell principle scoped to what its source establishes. The closing 'The resulting response serves your enquiry by connecting ground to direction' praises the response; 'Each claim anchors to a source line or your words' reports its own conduct; and the closing repeats the absent-baseline point already stated near the beginning. Resolve these remaining findings in the actual answer. Let the ending complete the explanation of practical usefulness instead of announcing its quality. Preserve the useful trust facets, concrete vocabulary and correct offer lookup, all six requested axes, and the original word range and checks. The existing answer and exact source observations are available; use them, keeping uncertainty local. No replacement prose is supplied. Re-read the entire changed answer before accepting it.";
 let feedback = json-node-object(list(nsm-s("id","2026-09-26-complete-response-remaining-findings-v1"),nsm-s("text",finding)));
 let continued = oh-set(oh-set(request,"feedback",feedback),"turns",json-node-int(6));
 if not(and(fcaq-request-valid(continued),and(node_eq(oh-get(request,"checks"),oh-get(continued,"checks")),and(node_eq(oh-get(request,"documents"),oh-get(continued,"documents")),str_eq(nsm-str(request,"goal"),nsm-str(continued,"goal")))))) then form_error("continuation changed the original task contract") else 0;
 fs-mkdir(fcc-home());
 if not(eq(host_dir_mkdir(nsm-at(fcc-home(),"claim")),1)) then form_error("this repair already has an owner; inspect it rather than restart") else 0;
 frsh-frozen(nsm-at(fcc-home(),"owner.json"),json-emit(json-node-object(list(nsm-n("pid",host_pid()),nsm-n("started_ms",now_unix_ms()),nsm-s("checkpoint_id",nsm-str(request,"resume"))))));
 frsh-frozen(nsm-at(fcc-root(),"request.json"),json-emit(continued));
 frsh-frozen(nsm-at(fcc-root(),"feedback.txt"),finding);
 frsh-frozen(nsm-at(fcc-root(),"meaning-teaching.json"),json-emit(json-node-object(list(nsm-s("sha256",nsm-hash(fqt-meaning-prefix())),nsm-s("text",fqt-meaning-prefix())))));
 print_str("native-response-care: original response verified complete; waiting for shared learning to release before native admission");
 nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 print_str("native-response-care: learning settled; continuing the same response with retained caller corrections");
 let result = fcaq-command(json-emit(continued));
 frsh-frozen(nsm-at(fcc-root(),"terminal-result.json"),result);
 let completed = parse-json("native-response-result",result);
 print_str(json-emit(json-node-object(list(nsm-s("status",nsm-str(completed,"status")),nsm-s("checkpoint_id",nsm-str(completed,"checkpoint_id")),nsm-n("release_ok",nsm-num(completed,"release_ok")),nsm-s("result",nsm-at(fcc-root(),"terminal-result.json"))))));
}
