// Await the existing owner, then check its returned documents and exact review scope.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def fcc-await(pid,path) = if eq(host_alive(pid),1) then { host_sleep_ms(5000); fcc-await(pid,path); } else if le(file_size(path),0) then form_error("response owner ended without a retained result; inspect that owner's failure") else nsm-json(path);
 def fcc-event(rows,event) = if nil?(rows) then 0 else if node_eq(head(rows),event) then 1 else fcc-event(tail(rows),event);
 let root = "receipts/artifacts/2026-09-26-native-feedback-continuity";
 let previous = "receipts/artifacts/2026-09-26-native-identity-usefulness-care";
 let owner = nsm-json(".hearth/native-feedback-continuity/owner.json");
 print_str("native-response-comparison: awaiting the existing response owner; no model admitted");
 let result = fcc-await(nsm-num(owner,"pid"),nsm-at(root,"terminal-result.json"));
 let prior = nsm-json(nsm-at(previous,"terminal-result.json"));
 let request = nsm-json(nsm-at(root,"request.json"));
 let original = fat-wire-documents(request); let returned = fat-wire-documents(result); let earlier = fat-wire-documents(prior);
 if not(and(str_eq(fat-wire-error(original),""),and(str_eq(fat-wire-error(returned),""),str_eq(fat-wire-error(earlier),"")))) then form_error("returned source documents unavailable") else 0;
 if not(str_eq(nsm-str(result,"checkpoint_id"),nsm-str(request,"resume"))) then form_error("result has a different checkpoint") else 0;
 let docs = fat-wire-value(returned);
 let answer = nth(fat-find-doc(docs,"answer.md"),2);
 let oldAnswer = nth(fat-find-doc(fat-wire-value(earlier),"answer.md"),2);
 let checks = fcaq-check(json-array-elements(oh-get(request,"checks")),docs);
 let feedback = oh-get(request,"feedback");
 let retained = fcc-event(json-array-elements(oh-get(result,"caller_feedback")),json-node-array(list(oh-get(feedback,"id"),oh-get(feedback,"text"))));
 let reportText = nsm-str(result,"report");
 let report = if faj-valid(reportText) then parse-json("retained-review",reportText) else json-node-null();
 let currentReview = and(str_eq(nsm-str(report,"schema"),"native-coding-review-v1"),and(str_eq(nsm-str(report,"goal_sha256"),nsm-hash(nsm-str(request,"goal"))),node_eq(oh-get(report,"documents"),json-node-array(fcap-document-catalog(docs)))));
 let comparison = json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-s("checkpoint_id",nsm-str(result,"checkpoint_id")),nsm-n("before_words",fal-count(oldAnswer)),nsm-n("after_words",fal-count(answer)),nsm-n("original_checks_passed",head(checks)),nsm-n("readonly_preserved",fcap-readonly-preserved(fat-wire-value(original),docs,fcap-array(request,"writable"))),nsm-n("caller_feedback_retained",retained),nsm-n("current_review",currentReview),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("new_turns",sub(nsm-num(result,"turns"),nsm-num(prior,"turns"))),nsm-n("new_tool_calls",sub(nsm-num(result,"tool_calls"),nsm-num(prior,"tool_calls"))),nsm-n("new_checks",sub(nsm-num(result,"check_runs"),nsm-num(prior,"check_runs"))),nsm-n("generated_ids_this_admission",nsm-num(result,"generated_ids")),nsm-n("injected_ids_this_admission",nsm-num(result,"injected_ids")),nsm-n("weight_training_excluded",nsm-num(result,"weight_training_excluded")),nsm-n("answer_changed",not(str_eq(answer,oldAnswer))),nsm-s("answer_sha256",nsm-hash(answer)),nsm-s("scope","Same real response continued with new findings and restored feedback. Read the actual answer for quality. Same-model review and structural checks do not establish parity or felt resonance.")));
 frsh-frozen(nsm-at(root,"answer.txt"),answer);
 frsh-frozen(nsm-at(root,"comparison.json"),json-emit(comparison));
 frsh-frozen(nsm-at(root,"review.json"),json-emit(json-node-object(list(nsm-n("current_review",currentReview),nsm-s("text",reportText)))));
 print_str(json-emit(comparison));
 print_str("Native Qwen answer:"); print_str(answer);
}
