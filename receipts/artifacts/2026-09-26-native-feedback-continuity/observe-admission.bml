// Observe retained caller corrections at an actual resumed response checkpoint.
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def fco-encoded(text) { let encoded=json-emit(json-node-string(text)); substring(encoded,1,sub(str_len(encoded),1)); }
 def fco-before(state,prompt,expected) {
  let field=json-emit(json-node-object(fcap-caller-feedback-pairs(state)));
  let entry=str_concat(substring(field,1,sub(str_len(field),1)),",");
  let at=str_find(prompt,entry,0);
  if lt(at,0) then form_error("feedback admission field absent") else 0;
  let prior=str_concat(substring(prompt,0,at),substring(prompt,add(at,str_len(entry)),str_len(prompt)));
  if not(str_eq(nsm-hash(prior),expected)) then form_error("reconstructed prior admission differs from retained digest") else prior;
 }
 def fco-rows(rows,prompt) = if nil?(rows) then list() else cons(json-node-object(list(nsm-s("id",head(head(rows))),nsm-n("text_bytes",str_len(nth(head(rows),1))),nsm-n("id_in_admission",ge(str_find(prompt,head(head(rows)),0),0)),nsm-n("whole_text_in_admission",ge(str_find(prompt,fco-encoded(nth(head(rows),1)),0),0)))),fco-rows(tail(rows),prompt));
 let phase = read_line();
 if not(fat-has(list("before","before-encoded","after"),phase)) then form_error("supply before, before-encoded or after") else 0;
 let root = "receipts/artifacts/2026-09-26-native-feedback-continuity";
 let request = nsm-json("receipts/artifacts/2026-09-26-native-usefulness-feedback/request.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let scope = fcam-work-scope(initial,json-emit(oh-get(request,"checks")));
 let packet = faj-json("owned-checkpoint",read_file(".hearth/native-identity-usefulness-care/observed-checkpoint.json"));
 if not(fcam-packet-valid(packet,"checkpoint",scope)) then form_error("checkpoint contract invalid") else 0;
 let state = fcam-state-from(packet);
 if not(fcam-state-valid(state,initial)) then form_error("checkpoint source state invalid") else 0;
 let current = fcap-bootstrap(fcap-begin-context(state));
 let prompt = if str_eq(phase,"before-encoded") then fco-before(state,current,nsm-str(nsm-json(nsm-at(root,"before.json")),"admission_sha256")) else current;
 let feedback = fcaq-feedback-events(state);
 let report = json-node-object(list(nsm-s("phase",phase),nsm-s("checkpoint_digest",nsm-str(packet,"digest")),nsm-n("turns",fcap-turns(state)),nsm-n("retained_feedback_count",len(feedback)),json-node-pair("feedback",json-node-array(fco-rows(feedback,prompt))),nsm-n("admission_bytes",str_len(prompt)),nsm-s("admission_sha256",nsm-hash(prompt)),nsm-s("retained_feedback_sha256",nsm-hash(json-emit(fcam-pack(feedback)))),nsm-s("scope","Reconstructed admission from the same validated real checkpoint. No model admitted; no private model reasoning or replies read.")));
 frsh-frozen(nsm-at(root,str_concat(phase,".json")),json-emit(report));
 print_str(json-emit(report));
}
