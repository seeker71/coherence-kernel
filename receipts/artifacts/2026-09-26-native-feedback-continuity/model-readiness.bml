// Observe available native model inputs without admitting a model.
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def fmr-row(name) = json-node-object(list(nsm-s("model",name),nsm-s("path",mr-path(mr-find(name))),nsm-s("readiness",mr-readiness(mr-find(name))),nsm-n("coding_door_ready",fcac-model-ready(name))));
 let report=json-node-object(list(json-node-pair("models",json-node-array(list(fmr-row("qwen38-q8"),fmr-row("qwen38-q4")))),nsm-s("scope","Artifact, seal, tokenizer and supported coding-door admission prerequisites only; no model admitted and no output quality or speed established.")));
 frsh-frozen("receipts/artifacts/2026-09-26-native-feedback-continuity/model-readiness.json",json-emit(report));
 print_str(json-emit(report));
}
