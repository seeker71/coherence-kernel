// Review a retained working document; this does not complete or resume native work.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 def pvr-sources(docs) = if nil?(docs) then list() else if str_eq(nth(head(docs),1),"answer.md") then pvr-sources(tail(docs)) else cons(head(docs),pvr-sources(tail(docs)));
 def pvr-word(path,count) = json-node-object(list(nsm-s("kind","word-range"),nsm-s("path",path),nsm-n("minimum",count),nsm-n("maximum",count)));
 let root="receipts/artifacts/2026-09-26-native-usefulness-feedback";
 let original=nsm-json(frsh-path(root,"request.json"));
 let supplied=fat-wire-documents(original);
 if not(str_eq(fat-wire-error(supplied),"")) then form_error("original source packet unavailable") else 0;
 let candidate=read_file(frsh-path(root,"checkpoint-answer-c5e6fa9751c5afcf02c7a56d0d2aa54b5d18808cf6f6c0e43ad5c03c375e0eb2.txt"));
 if not(str_eq(nsm-hash(candidate),"c5e6fa9751c5afcf02c7a56d0d2aa54b5d18808cf6f6c0e43ad5c03c375e0eb2")) then form_error("retained native candidate changed") else 0;
 let prior=read_file("receipts/artifacts/2026-09-26-native-absence-feedback/answer.txt");
 let arriving=read_file(frsh-path(root,"arriving-answer.md"));
 let context=json-emit(json-node-object(list(nsm-s("native_source","Qwen3.8-27B-Q8_0 through native Form code, checkpoint turn 19; unfinished, no release or acceptance claimed"),nsm-s("prior_native","Completed 434-word answer to the same original enquiry; same checkpoint"),nsm-s("arriving_source","Codex using current repository context and observed work; this answer was not supplied to the native repair"),nsm-s("comparison_scope","Sources and exposure differ; this is a substantive answer review, not a context-matched benchmark, measured out-of-box comparison or human resonance assessment"),json-node-pair("original_native_checks",oh-get(original,"checks")),json-node-pair("observed_native_checks",nsm-json(frsh-path(root,"checkpoint-checks-1790365157552.json"))),nsm-s("source_assertion_scope","The assessment checks below witness the retained document word counts. The original native 350-450 requirement remains failed and unchanged. Assessment completion grants no native completion."))));
 let docs=append(pvr-sources(fat-wire-value(supplied)),list(list("prior-native","prior-native.txt",prior),list("native-candidate","native-candidate.txt",candidate),list("arriving-candidate","arriving-answer.md",arriving),list("context","comparison-context.json",context)));
 let goal="Assess the unfinished native-candidate.txt against the ORIGINAL ENQUIRY in enquiry.txt, the supplied sources, prior-native.txt and the separately attributed arriving-answer.md. Explain actual improvements and remaining differences in grounding, insight, relevance, warmth, useful action and application of the six concepts. Review both current answers with the same standard. Distinguish an unsupported claim from a contradiction and a teaching from an observed implementation. In particular, examine the scope of claims about a cell's content identity and about editing this answer; report a missing executing contract as missing, not as proof of the opposite. Do not invent an out-of-box answer, hidden model processes or human felt resonance. Preserve the unfinished native status and failed original word range. Give the smallest useful next repair, with the actual words and supporting source. Do not rewrite either answer or instruct an external action. Return a report object with answer (a concise complete review), findings (objects with candidate, claim, assessment, evidence and repair), preferred_current_answer, quality_gap_closed (boolean), and boundary. A preferred answer is this reviewer's judgment, not a measured general model ranking.";
 let request=json-node-object(list(nsm-s("mode","review"),nsm-n("evaluation",1),nsm-s("goal",goal),json-node-pair("documents",fat-wire-documents-node(docs)),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",json-node-array(list(pvr-word("native-candidate.txt",507),pvr-word("prior-native.txt",434),pvr-word("arriving-answer.md",408)))),json-node-pair("report_checks",json-node-array(list(json-node-object(list(nsm-s("kind","word-range"),nsm-s("field","answer"),nsm-n("minimum",1),nsm-n("maximum",1000))))))));
 let manifest=json-node-object(list(nsm-s("session","2026-09-26-provisional-507-review-v1"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","response-gap"),json-node-pair("request",request)))))),json-node-pair("provider",json-node-object(list(json-node-pair("allowed",json-node-bool(1)),nsm-s("interface","codex-exec"),nsm-n("max_processes",1),nsm-n("seconds",0))))));
 if not(frsy-valid(manifest)) then form_error("bounded review manifest invalid") else 0;
 if not(frsy-sources(json-array-elements(oh-get(manifest,"cases")))) then form_error("retained review source counts changed") else 0;
 let path=frsh-path(root,"provisional-review-manifest.json");
 frsh-frozen(path,json-emit(manifest));
 print_str(json-emit(json-node-object(list(nsm-s("manifest_path",path),nsm-n("prompt_bytes",str_len(frsy-prompt(manifest))),nsm-n("provider_calls",0),nsm-n("native_model_calls",0)))));
}
