// Recheck a caller-owned document snapshot without reading private reply files.
// No checkpoint mutation, model admission, reasoning or reply-file reads.
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def cso-word-evidence(reason,attempt) {
  let normalized=fcap-counterexample(reason);
  if not(faj-valid(normalized)) then list() else {
   let parsed=faj-json("source-check",normalized);
   if not(fat-wire-array?(parsed)) then list() else {
    let fields=json-array-elements(parsed);
    let out=if ge(len(fields),2) then node_value(nth(fields,1)) else "";
    if not(and(str_eq(value_kind(out),"string"),fat-starts(out,"word-range "))) then list() else {
     let check=faj-json("word-check",substring(out,11,str_len(out)));
     list(json-node-object(list(nsm-n("attempt",attempt),nsm-n("observed_words",nsm-num(check,"observed_words")),nsm-n("minimum",nsm-num(check,"minimum")),nsm-n("maximum",nsm-num(check,"maximum")))));
    };
   };
  };
 }
 def cso-prior-checks(rows) = if nil?(rows) then list() else append(cso-word-evidence(nth(head(rows),1),head(head(rows))),cso-prior-checks(tail(rows)));
 def cso-checks(rows,docs,index) = if nil?(rows) then list() else {
  let row=head(rows); let result=fcaq-check(list(row),docs);
  cons(json-node-object(list(nsm-n("index",index),nsm-s("kind",if fcaq-word-check?(row) then "word-range" else nsm-str(row,"tool")),nsm-n("passed",head(result)))),cso-checks(tail(rows),docs,add(index,1)));
 };
 let root="receipts/artifacts/2026-09-26-native-usefulness-feedback";
 let request=nsm-json(frsh-path(root,"request.json"));
 let supplied=fat-wire-documents(request);
 if not(str_eq(fat-wire-error(supplied),"")) then form_error("source request documents unavailable") else 0;
 let initial=fcaq-initial(request,fat-wire-value(supplied));
 let scope=fcam-work-scope(initial,json-emit(oh-get(request,"checks")));
 let id=nsm-str(request,"resume");
 let packet=fcam-read(fcam-path(hearth-code-memory(),id,"checkpoint"));
 if not(fcam-packet-valid(packet,"checkpoint",scope)) then form_error("checkpoint does not match the original caller contract") else 0;
 let state=fcam-state-from(packet);
 if not(fcam-state-valid(state,initial)) then form_error("checkpoint state or read-only source contract invalid") else 0;
 let docs=fcap-docs(state); let answer=nth(fat-find-doc(docs,"answer.md"),2);
 let candidatePath=frsh-path(root,str_concat("checkpoint-answer-",str_concat(nsm-hash(answer),".txt")));
 frsh-frozen(candidatePath,answer);
 print_str(str_concat("Caller-writable snapshot; public result governs release: ",candidatePath));
 print_str(json-emit(json-node-array(append(cso-prior-checks(fcap-reflections(state)),cso-word-evidence(fcap-evidence(state),fcap-failures(state))))));
 let observed=now_unix_ms();
 let toolHistory=head(fcap-tool-history(state));
 let lastTool=if eq(len(toolHistory),6) then json-node-object(list(nsm-s("tool",head(toolHistory)),nsm-n("exit",nth(toolHistory,3)),nsm-s("error",nth(toolHistory,5)))) else json-node-null();
 let toolArgs=if eq(len(toolHistory),6) then nth(toolHistory,1) else list();
 let guarded=and(str_eq(nsm-str(lastTool,"tool"),"edit"),and(eq(len(toolArgs),4),str_eq(nth(toolArgs,1),"sha256")));
 let lastTool=if guarded then oh-set(oh-set(lastTool,"offered_sha256",json-node-string(nth(toolArgs,2))),"resident_sha256",json-node-string(fat-document-sha(fat-find-doc(docs,head(toolArgs))))) else lastTool;
 print_str(json-emit(json-node-object(list(json-node-pair("last_native_tool",lastTool)))));
 let evidence=fcap-evidence(state); let counter=fcap-counterexample(evidence);
 if and(faj-valid(counter),fat-wire-array?(faj-json("counterexample",counter))) then {
  let fields=json-array-elements(faj-json("counterexample",counter));
  let out=if ge(len(fields),2) then node_value(nth(fields,1)) else "";
  if and(str_eq(value_kind(out),"string"),fat-starts(out,"word-range ")) then print_str(out) else print_str("counterexample is not a normalized word-range output");
 } else print_str("Non-word-range failure remains in the owned checkpoint.");
 let report=json-emit(json-node-object(list(nsm-s("schema","form-response-checkpoint-checks-v1"),nsm-s("checkpoint_id",id),nsm-s("packet_digest",nsm-str(packet,"digest")),nsm-n("observed_at_ms",observed),nsm-s("stage",fcap-stage(state)),nsm-n("turns",fcap-turns(state)),nsm-n("retained_check_runs",fcap-checks(state)),nsm-n("retained_repairs",fcap-failures(state)),nsm-n("words",fal-count(answer)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("retained_failure_mentions_word_range",ge(str_find(fcap-evidence(state),"word-range",0),0)),json-node-pair("current_checks",json-node-array(cso-checks(json-array-elements(oh-get(request,"checks")),docs,0))),nsm-s("scope","Read-only snapshot and fresh original checks. No claim of model completion, release or semantic quality. Private model reasoning and reply files were not read."))));
 let path=frsh-path(root,str_concat("checkpoint-checks-",str_concat(int_to_str(observed),".json")));
 frsh-frozen(path,report);
 frsh-frozen(frsh-path(root,str_concat("checkpoint-tool-",str_concat(int_to_str(observed),".json"))),json-emit(json-node-object(list(nsm-s("checkpoint_id",id),nsm-n("turns",fcap-turns(state)),nsm-n("observed_at_ms",observed),json-node-pair("last_native_tool",lastTool)))));
 print_str(path); print_str(report);
}
