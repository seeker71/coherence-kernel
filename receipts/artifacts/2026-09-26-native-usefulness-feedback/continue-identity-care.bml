// Continue this real response repair after its current owner has released.
// One immutable claim; no restart on a timeout or a missing public result.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-heal-native-process.bml
section [form.bml] {
 def nic-last(text,marker,from,found) {
  let at=str_find(text,marker,from);
  if lt(at,0) then found else nic-last(text,marker,add(at,str_len(marker)),at);
 }
 def nic-terminal(log) {
  let at=nic-last(log,"{\"schema\":\"form-native-code-v1\"",0,-1);
  let end=if lt(at,0) then -1 else str_find(log,"\n",at);
  if or(lt(at,0),lt(end,0)) then "" else {
   let raw=substring(log,at,end);
   if and(faj-valid(raw),ge(str_find(log,"\n@form fkwu 0 ",end),0)) then raw else "";
  };
 }
 def nic-await(pid,path,drainLeft) {
  if fhn-alive(pid) then {
   host_sleep_ms(5000);
   nic-await(pid,path,120);
  } else {
   let raw=nic-terminal(read_file(path));
   if not(str_eq(raw,"")) then raw else if le(drainLeft,0) then form_error("prior owner exited without a complete successful public execution record; retained evidence needs care") else {
    host_sleep_ms(1000);
    nic-await(pid,path,sub(drainLeft,1));
   };
  };
 }
 let before="receipts/artifacts/2026-09-26-native-usefulness-feedback";
 let next="receipts/artifacts/2026-09-26-native-identity-usefulness-care";
 let home=".hearth/native-identity-usefulness-care";
 let priorLog=".hearth/native-usefulness-feedback/public-cli.log";
 let priorPid=8730;
 let request=nsm-json(frsh-path(before,"request.json"));
 if not(fcaq-request-valid(request)) then form_error("original response request invalid") else 0;
 fs-mkdir(home);
 if not(eq(host_dir_mkdir(frsh-path(home,"claim")),1)) then form_error("identity care already claimed; inspect its existing owner and result") else 0;
 frsh-frozen(frsh-path(home,"owner.json"),json-emit(json-node-object(list(nsm-n("pid",host_pid()),nsm-n("prior_pid",priorPid),nsm-s("checkpoint_id",nsm-str(request,"resume"))))));
 let observation=oh-reading("native-response-care",home,"prior-model-owner",json-node-string("released"),json-node-string("awaiting-current-owner"),json-node-int(0),list(),list("await-owner-release"),json-node-object(list(nsm-n("prior_pid",priorPid),nsm-s("public_log",priorLog))));
 let response=oh-response(observation,"await-owner-release");
 if not(str_eq(oh-select(observation,response,""),"await-owner-release")) then form_error("owner-release care did not correlate") else 0;
 oh-emit(frsh-path(home,"events.jsonl"),observation); oh-emit(frsh-path(home,"events.jsonl"),response);
 print_str("native-response-care: waiting for the existing native owner to release; no model admitted");
 let waited=host_monotonic_ms(); let raw=nic-await(priorPid,priorLog,120);
 let prior=faj-json("completed-owner-result",raw);
 if not(and(str_eq(nsm-str(prior,"checkpoint_id"),nsm-str(request,"resume")),eq(nsm-num(prior,"release_ok"),1))) then form_error("prior public result has a different checkpoint or incomplete model release") else 0;
 let original=fat-wire-documents(request); let returned=fat-wire-documents(prior);
 if not(and(str_eq(fat-wire-error(original),""),str_eq(fat-wire-error(returned),""))) then form_error("prior source documents unavailable") else 0;
 if not(fcap-readonly-preserved(fat-wire-value(original),fat-wire-value(returned),fcap-array(request,"writable"))) then form_error("prior read-only source changed; preserve evidence before further admission") else 0;
 let candidate=nth(fat-find-doc(fat-wire-value(returned),"answer.md"),2);
 frsh-frozen(frsh-path(before,"terminal-result.json"),raw);
 frsh-frozen(frsh-path(before,"answer.txt"),candidate);
 let release=json-node-object(list(nsm-n("prior_pid",priorPid),nsm-n("release_ok",1),nsm-s("prior_status",nsm-str(prior,"status")),nsm-n("prior_turns",nsm-num(prior,"turns")),nsm-n("prior_words",fal-count(candidate)),nsm-s("prior_answer_sha256",nsm-hash(candidate)),nsm-n("wait_elapsed_ms",sub(host_monotonic_ms(),waited))));
 oh-emit(frsh-path(home,"events.jsonl"),oh-applied(observation,"await-owner-release",release));
 let finding="The retained working answer from turn 19 (507 words) substantially improved the trust and vocabulary explanation. A Form-owned provider review identified this unsupported application: 'When I change an answer, a new node ID is minted' and unconditional preservation of the old answer. The source establishes the identity and conditional retention rules for Form cells; it does not establish that this document edit performed a witnessed cell transition or retained every earlier answer. Assess the latest candidate against that distinction and repair it where needed. Keep the useful trust facets, concrete vocabulary example, correct offer lookup and separation of annotated frequency from felt resonance. The opening and closing also repeat the missing-baseline explanation, and the closing praises the response and reports its own conduct. Focus edits on the unsupported identity application and redundant self-reporting so factual repair and shortening happen together. Use the actual native word-count feedback; preserve all six axes and the original 350-450 range and phrase checks. No replacement answer is supplied. The provider's judgments based on missing conversation/history context are not findings to apply; its supplied replacement prose is not a training target. Re-read the complete revised answer before accepting it.";
 let feedback=json-node-object(list(nsm-s("id","2026-09-26-response-identity-and-usefulness-v1"),nsm-s("text",finding)));
 let continued=oh-set(oh-set(oh-set(request,"resume",oh-get(prior,"checkpoint_id")),"feedback",feedback),"context",json-node-int(32768));
 if not(and(fcaq-request-valid(continued),and(node_eq(oh-get(request,"checks"),oh-get(continued,"checks")),and(node_eq(oh-get(request,"documents"),oh-get(continued,"documents")),str_eq(nsm-str(request,"goal"),nsm-str(continued,"goal")))))) then form_error("continuation changed the original task contract") else 0;
 fs-mkdir(next);
 frsh-frozen(frsh-path(next,"prior-release.json"),json-emit(release));
 frsh-frozen(frsh-path(next,"feedback.txt"),finding);
 frsh-frozen(frsh-path(next,"request.json"),json-emit(continued));
 frsh-frozen(frsh-path(next,"meaning-teaching.json"),json-emit(json-node-object(list(nsm-s("sha256",nsm-hash(fqt-meaning-prefix())),nsm-s("text",fqt-meaning-prefix())))));
 print_str("native-response-care: original owner released; continuing the same checkpoint with focused findings and 32768 context positions");
 let result=fcaq-command(json-emit(continued));
 frsh-frozen(frsh-path(next,"terminal-result.json"),result);
 print_str(result);
}
