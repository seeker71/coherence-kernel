// Retain the completed provider report through the identical manifest's replay.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root="receipts/artifacts/2026-09-26-native-usefulness-feedback";
 let evidence=".hearth/response-sessions/syntheses/89e6bd4a575dbfa341f782dfbf056696ae312d0597b5265410a5e16a9ee68326";
 if not(fs_exists(frsh-path(evidence,"process.json"))) then form_error("completed provider process record unavailable; no new admission") else 0;
 let result=frsy-run(nsm-json(frsh-path(root,"provisional-review-manifest.json")));
 if not(and(eq(nsm-num(result,"checked"),1),eq(nsm-num(result,"provider_processes_new"),0))) then form_error("retained review did not recheck without a new provider process") else 0;
 let raw=read_file(nsm-str(result,"answer_path"));
 let report=oh-get(head(json-array-elements(oh-get(faj-json("completed-review",raw),"results"))),"report");
 frsh-frozen(frsh-path(root,"provisional-review.json"),raw);
 frsh-frozen(frsh-path(root,"provisional-review-result.json"),json-emit(result));
 print_str(json-emit(result)); print_str(json-emit(report));
}
