// Lossless care for the actual retained report; no model or provider call.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-comparison-review.bml form-stdlib/organ-care.bml
section [form.bml] {
 class HearthSynthesisCare {
  def hsc-root() = ".hearth/response-sessions/syntheses/c5d49c6ede96694256d8d438c4fcb13d6222a01f92ba68315ac238837257c798";
  def hsc-path(name) = str_concat(".hearth/hearth-final-synthesis-",name);
  def hsc-entries(pairs) = if nil?(pairs) then list() else cons(json-node-object(list(oh-s("category",json-pair-key(head(pairs))),json-node-pair("value",json-pair-value(head(pairs))))),hsc-entries(tail(pairs)));
  def hsc-pairs(rows) = if nil?(rows) then list() else cons(json-node-pair(oh-str(head(rows),"category"),oh-get(head(rows),"value")),hsc-pairs(tail(rows)));
  def hsc-emit(context,stage,row) = oh-emit(hsc-path("care.events.jsonl"),row);
  def hsc-reading(context,check) {
   let ok = json-int-value(oh-get(check,"assertions_passed"));
   oh-reading("response-synthesis",hsc-root(),"report-shape-care",json-node-int(1),json-node-int(ok),json-node-int(ok),if ok then list() else list(oh-need("report-array-shape",json-node-string("retain every category and value; unchanged assertions"))),list("reshape-retained-report"),json-node-object(list(json-node-pair("check",check),json-node-pair("semantic_quality",json-node-null()),oh-s("original",str_concat(hsc-root(),"/provider-answer.json")))));
  }
  def hsc-supply(context,reading,need) {
   let original = record_get(context,"original");
   let member = head(json-array-elements(oh-get(original,"results")));
   let report = oh-get(member,"report"); let findings = oh-get(report,"findings");
   fcr-need(fat-wire-object?(findings),"retained findings are not the observed object");
   let entries = hsc-entries(json-object-pairs(findings));
   fcr-need(node_eq(findings,json-node-object(hsc-pairs(entries))),"finding category or value changed");
   let changed = oh-set(report,"findings",json-node-array(entries));
   let revised = oh-set(original,"results",json-node-array(list(oh-set(member,"report",changed))));
   let restored = oh-set(changed,"findings",json-node-object(hsc-pairs(json-array-elements(oh-get(changed,"findings")))));
   fcr-need(node_eq(original,oh-set(revised,"results",json-node-array(list(oh-set(member,"report",restored))))),"report changed beyond reversible findings shape");
   frsh-frozen(hsc-path("reshaped.json"),json-emit(revised));
   frsh-frozen(hsc-path("answer.txt"),oh-str(report,"answer"));
   json-node-object(list(oh-n("lossless_roundtrip",1),oh-n("categories",len(entries)),oh-n("model_calls",0),oh-n("provider_calls",0),oh-s("revised",hsc-path("reshaped.json"))));
  }
  def hsc-observe(context,reading,delivery) {
   let fresh = frsy-check(record_get(context,"manifest"),read_file(hsc-path("reshaped.json")));
   frsh-frozen(hsc-path("recheck.json"),json-emit(fresh));
   oh-set(hsc-reading(context,fresh),"care_of",oh-get(reading,"id"));
  }
  def hsc-run() {
   let context = record_new(0);
   let manifest = parse-json("frozen-manifest",read_file(".hearth/hearth-final-synthesis.manifest.json"));
   let raw = read_file(str_concat(hsc-root(),"/provider-answer.json"));
   record_set(context,"manifest",manifest); record_set(context,"original",parse-json("retained-answer",raw));
   let before = frsy-check(manifest,raw); let reading = hsc-reading(context,before);
   hsc-emit(context,"organ-health",reading);
   let cared = oc-hear(context,reading,list(oc-provider("native-lossless-report-shape",list("report-array-shape"),"reshape-retained-report",hsc-supply)),hsc-emit,hsc-observe);
   frsh-frozen(hsc-path("care.result.json"),json-emit(cared));
   let passed = json-int-value(oh-get(oh-get(cared,"observation"),"health"));
   fcr-need(eq(passed,1),"unchanged synthesis assertions remain open");
   print_str("retained report: unchanged checks pass; category/value roundtrip exact; original preserved; new model/provider calls=0; semantic quality unmeasured by checks");
  }
 }
 hsc-run();
}
