// Read the actual learning flow twice without changing its source or requests.
// preludes: form-stdlib/native-session-evidence.bml
section [form.bml] {
 class SessionReaderObserve {
  def sro-read(reader) {
   let before = host_monotonic_ms(); let primary = kernel_stat(53);
   let extent = file_size(ohs-path(reader));
   ohs-update(reader,if gt(extent,0) then extent else 1);
   jv-object(list(jv-n("elapsed_ms",sub(host_monotonic_ms(),before)),jv-n("primary_mints",sub(kernel_stat(53),primary)),jv-n("extent",record_get(reader,"extent")),jv-n("offset",record_get(reader,"offset")),jv-n("read_bytes",record_get(reader,"read_bytes")),jv-n("current_rows",len(record_get(reader,"current"))),jv-n("pending_bytes",str_len(record_get(reader,"pending"))),jv-n("invalid_records",record_get(reader,"invalid_records")),jv-s("state",record_get(reader,"state"))));
  }
 }
 let home = hearth-session-learning();
 if nsm-running(home) then form_error("learning flow is owned by a live learner") else 0;
 let reader = nse-reader(home);
 let first = sro-read(reader); print_str(str_concat(jv-emit(first),"\n"));
 let current = record_get(reader,"current");
 let second = sro-read(reader);
 if and(eq(jv-str(second,"read_bytes"),0),value_eq(current,record_get(reader,"current"))) then 1 else form_error("unchanged event flow did not retain its current observation");
 let report = jv-object(list(jv-s("schema","session-retained-reader-observation-v1"),jv-s("source",ohs-path(reader)),jv-n("at_ms",now_unix_ms()),jv-pair("first",first),jv-pair("unchanged",second),jv-n("current_preserved",1),jv-s("scope","actual session-learning event flow; reader only; no source retrieval, model training or answer-quality claim")));
 let text = jv-emit(report);
 if eq(write_file(".hearth/session-reader-observation.json",text),str_len(text)) then print_str(str_concat(text,"\n")) else form_error("reader observation retention failed");
}
