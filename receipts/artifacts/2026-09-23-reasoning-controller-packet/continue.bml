// Continue the actual unfinished answer from its retained candidate and fresh
// caller check. Original goal, source packet, checks and model remain intact.
// Evaluation: no recall, coding checkpoint or training of these answers.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = read_line();
 if or(nothing?(root),str_eq(root,"")) then form_error("continuation evidence directory required") else 0;
 if fs-exists?(nsm-at(root,"started.json")) then form_error("continuation already admitted; inspect its live owner or retained result") else 0;
 let requestPath = "receipts/artifacts/2026-09-23-native-edit-identity/request.json";
 let priorPath = "receipts/artifacts/2026-09-23-reasoning-controller-packet/native-result.json";
 let request = nsm-json(requestPath); let prior = nsm-json(priorPath);
 if not(and(fcaq-request-valid(request),and(fcaq-evaluation(request),and(eq(nsm-num(prior,"release_ok"),1),str_eq(nsm-str(prior,"reason"),"caller-turn-budget-reached;candidate-retained-in-result"))))) then form_error("released unfinished evaluated task required") else 0;
 let originalWire = fat-wire-documents(request); let currentWire = fat-wire-documents(prior);
 if not(and(str_eq(fat-wire-error(originalWire),""),str_eq(fat-wire-error(currentWire),""))) then form_error("retained documents invalid") else 0;
 let docs = fat-wire-value(currentWire);
 if not(fcap-readonly-preserved(fat-wire-value(originalWire),docs,fcap-array(request,"writable"))) then form_error("original read-only sources changed") else 0;
 let checker = fcaq-live-checker(request);
 let initial = fcaq-initial(request,docs);
 let currentCheck = fcap-source-check(initial,checker);
 if not(and(fcap-check-shape?(currentCheck),not(head(currentCheck)))) then form_error("actual unfinished source check required") else 0;
 // This is a real caller check with zero model replies and zero tool calls.
 let state = fcap-before-review(fcap-count-check(initial),currentCheck);
 let allowance = 6;
 let started = host_monotonic_ms();
 let reading = oh-reading("native-code",root,"unfinished-answer",json-node-int(1),json-node-int(head(currentCheck)),json-node-int(0),list(oh-need("answer-within-original-contract",json-node-object(list(nsm-n("words",fal-count(nth(fat-find-doc(docs,"answer.md"),2))),nsm-n("target_words",400))))),list("continue-current-candidate","retain"),json-node-object(list(nsm-s("prior_result",priorPath),nsm-s("observation","Previous six replies reduced 478 to 466 words; original 350-450 bound still fails. Current native check supplies computed repair target; controller now uses plain-request encoding."))));
 oh-voice(reading); let response = oh-response(reading,"continue-current-candidate"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,"retain"),"continue-current-candidate")) then form_error("continuation control did not correlate") else 0;
 let admission = json-node-object(list(nsm-n("pid",host_pid()),nsm-s("request",requestPath),nsm-s("prior_result",priorPath),nsm-s("request_sha256",nsm-hash(read_file(requestPath))),nsm-s("prior_result_sha256",nsm-hash(read_file(priorPath))),nsm-n("new_reply_allowance",allowance),nsm-s("initial_stage",fcap-stage(state)),nsm-n("initial_checks",fcap-checks(state)),nsm-n("initial_model_replies",fcap-turns(state)),nsm-n("initial_tool_calls",fcap-calls(state)),nsm-s("current_check",nth(currentCheck,1)),nsm-n("evaluation",1),nsm-n("provider_calls",0)));
 nsm-write(nsm-at(root,"started.json"),admission); print_str(json-emit(admission));
 let result = fcac-admit(fcap-string(request,"model"),state,checker,fcaq-number(request,"context",16384),allowance);
 let returned = parse-json("continuation-result",fcaq-result-core(result));
 nsm-write(nsm-at(root,"result.json"),returned);
 let final = head(result); let answer = fat-find-doc(fcap-docs(final),"answer.md");
 let finalCheck = fcap-source-check(final,checker);
 nag-write(nsm-at(root,"answer.txt"),nth(answer,2));
 let report = json-node-object(list(nsm-s("status",nsm-str(returned,"status")),nsm-s("reason",nsm-str(returned,"reason")),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started)),nsm-n("generated_ids",nth(result,2)),nsm-n("injected_ids",nth(result,3)),nsm-n("turns",fcap-turns(final)),nsm-n("tool_calls",fcap-calls(final)),nsm-n("check_runs",fcap-checks(final)),nsm-n("repair_attempts",fcap-failures(final)),nsm-n("release_ok",nth(result,1)),nsm-n("words",fal-count(nth(answer,2))),nsm-n("word_range_passed",head(finalCheck)),nsm-s("word_range_evidence",nth(finalCheck,1)),nsm-n("provider_calls",0),nsm-s("quality","inspect actual answer; structural checks do not establish semantic parity")));
 nsm-write(nsm-at(root,"report.json"),report); print_str(json-emit(report));
 oh-voice(oh-applied(reading,"continue-current-candidate",json-node-object(list(nsm-n("words",fal-count(nth(answer,2))),nsm-n("range_passed",head(finalCheck)),nsm-n("release_ok",nth(result,1)),nsm-s("report",nsm-at(root,"report.json"))))));
 oh-voice(oh-reading("native-code",root,"unfinished-answer",json-node-int(1),json-node-int(head(finalCheck)),json-node-int(head(finalCheck)),list(),list("retain"),json-node-object(list(nsm-s("report",nsm-at(root,"report.json")),nsm-s("scope","Original word-range check only; semantic answer review remains separate.")))));
}
