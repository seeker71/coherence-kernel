// Observe actual GGUF token packets without model admission, KV or generation.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let path = mr-path(mr-find("qwen38-q8"));
 if le(file_size(path),0) then form_error("registered model unavailable") else 0;
 let src = fcmg-src(path); let stop = head(fcmg-q35-stops(src));
 let session = fcms-session("live","packet-only",path,src,list(),list(),16384,6423,stop,1,5912,512,0,0);
 let notice = frbg-observation(512,512,1024);
 let start = host_monotonic_ms(); let legacy = fcms-observation-ids(session,notice); let legacyMs = sub(host_monotonic_ms(),start);
 let nextStart = host_monotonic_ms(); let current = frbg-observation-ids(session,notice); let currentMs = sub(host_monotonic_ms(),nextStart);
 let reference = tkz-cat(list(stop),fcms-direct-answer-tail-ids(src,notice));
 let oldText = ftdb-text(src,legacy); let newText = ftdb-text(src,current);
 let sound = and(value_eq(current,reference),and(eq(head(current),stop),and(ge(str_find(newText,notice,0),0),and(eq(str_find(newText,"<tool_response>",0),-1),ge(str_find(oldText,"<tool_response>",0),0)))));
 if not(sound) then form_error("controller packet changed its text, pending stop or plain-request contract") else 0;
 fs-mkdir(".hearth/reasoning-controller-packet");
 nag-write(".hearth/reasoning-controller-packet/before.txt",oldText);
 nag-write(".hearth/reasoning-controller-packet/after.txt",newText);
 let row = json-node-object(list(nsm-s("model",path),nsm-s("scope","token packet only; no model admission, KV mutation or generation"),nsm-s("timing_scope","one sequential sample, legacy first; not a controlled throughput comparison"),nsm-n("legacy_ids",len(legacy)),nsm-n("current_ids",len(current)),nsm-n("legacy_encoding_ms",legacyMs),nsm-n("current_encoding_ms",currentMs),nsm-n("matches_plain_reference",value_eq(current,reference)),nsm-n("pending_stop",stop),nsm-n("notice_preserved",ge(str_find(newText,notice,0),0)),nsm-n("tool_response_wrapper",ge(str_find(newText,"<tool_response>",0),0)),nsm-s("before_sha256",nsm-hash(oldText)),nsm-s("after_sha256",nsm-hash(newText)),nsm-n("provider_calls",0)));
 nsm-write(".hearth/reasoning-controller-packet/report.json",row);
 print_str(json-emit(row));
}
