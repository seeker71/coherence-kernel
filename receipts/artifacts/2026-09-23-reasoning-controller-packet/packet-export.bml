// Preserve exact packet bytes, including their trailing chat-template newlines.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-23-reasoning-controller-packet";
 let before = read_file(nsm-at(root,"packet-before.txt"));
 let after = read_file(nsm-at(root,"packet-after.txt"));
 let row = json-node-object(list(nsm-s("before",before),nsm-s("after",after)));
 let path = nsm-at(root,"packet-text.json"); nsm-write(path,row);
 let readback = nsm-json(path); let measured = nsm-json(nsm-at(root,"packet.json"));
 if not(and(str_eq(nsm-str(readback,"before"),before),and(str_eq(nsm-str(readback,"after"),after),and(str_eq(nsm-hash(before),nsm-str(measured,"before_sha256")),str_eq(nsm-hash(after),nsm-str(measured,"after_sha256")))))) then form_error("packet evidence roundtrip or measured hash changed") else 0;
 print_str("Packet bytes preserved through JSON roundtrip; both hashes match the original observation.");
}
