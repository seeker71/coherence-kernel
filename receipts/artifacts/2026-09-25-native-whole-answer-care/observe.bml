// Read only the public terminal report; keep the native answer unchanged.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nwa-last(log,marker,from,found) {
  let at = str_find(log,marker,from);
  if lt(at,0) then found else nwa-last(log,marker,add(at,str_len(marker)),at);
 };
 let root = "receipts/artifacts/2026-09-25-native-whole-answer-care";
 let logPath = ".hearth/native-whole-answer-care/public-cli.log";
 let log = read_file(logPath);
 let marker = "{\"schema\":\"form-native-code-v1\"";
 let at = str_find(log,marker,0);
 if lt(at,0) then form_error("public terminal code result not yet available") else 0;
 let end = str_find(log,"\n",at);
 if lt(end,0) then form_error("public terminal code result unfinished") else 0;
 let raw = substring(log,at,end);
 if not(faj-valid(raw)) then form_error("public terminal code result invalid") else 0;
 let result = parse-json("public-code-result",raw);
 let request = nsm-json(frsh-path(root,"request.json"));
 let supplied = fat-wire-documents(request); let returned = fat-wire-documents(result);
 if or(not(str_eq(fat-wire-error(supplied),"")),not(str_eq(fat-wire-error(returned),""))) then form_error("source or returned documents unavailable") else 0;
 let before = fat-wire-value(supplied); let after = fat-wire-value(returned);
 let answer = nth(fat-find-doc(after,"answer.md"),2);
 let checked = fcaq-check(json-array-elements(oh-get(request,"checks")),after);
 let progressMark = "\nform-code "; let progressAt = nwa-last(log,progressMark,0,-1);
 let progressBegin = add(progressAt,str_len(progressMark)); let progressEnd = str_find(log,"\n",progressBegin);
 let progress = if or(lt(progressAt,0),lt(progressEnd,0)) then json-node-object(list()) else parse-json("last-code-progress",substring(log,progressBegin,progressEnd));
 let fields = list(nsm-s("status",nsm-str(result,"status")),nsm-s("reason",nsm-str(result,"reason")),nsm-n("before_words",fal-count(nth(fat-find-doc(before,"answer.md"),2))),nsm-n("after_words",fal-count(answer)),nsm-n("original_checks_passed",head(checked)),nsm-s("check_observation",nth(checked,1)),nsm-n("other_documents_preserved",fcap-readonly-preserved(before,after,fcap-array(request,"writable"))),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("turns",nsm-num(result,"turns")),nsm-n("tool_calls",nsm-num(result,"tool_calls")),nsm-n("repair_attempts",nsm-num(result,"repair_attempts")),nsm-n("check_runs",nsm-num(result,"check_runs")),nsm-n("generated_ids",nsm-num(result,"generated_ids")),nsm-n("injected_ids",nsm-num(result,"injected_ids")),nsm-n("last_observed_elapsed_ms",nsm-num(progress,"elapsed_ms")),nsm-n("provider_calls",0),nsm-n("evaluation",1),nsm-s("attribution","Qwen3.8-27B-Q8_0 through the public native code request, with caller-supplied sources and defect observations; no arriving-agent answer edit"),nsm-s("semantic_quality","requires reading; same-model review and caller assertions have narrower scope"));
 frsh-frozen(frsh-path(root,"terminal-result.json"),raw);
 frsh-frozen(frsh-path(root,"answer.txt"),answer);
 frsh-frozen(frsh-path(root,"comparison.json"),json-emit(json-node-object(fields)));
 frsh-frozen(frsh-path(root,"public-cli.log.json"),json-emit(json-node-object(list(nsm-s("source",logPath),nsm-s("sha256",nsm-hash(log)),nsm-n("bytes",str_len(log)),nsm-s("text",log)))));
 print_str(json-emit(json-node-object(fields))); print_str("\nNative review:\n"); print_str(nsm-str(result,"report")); print_str("\nNative answer:\n"); print_str(answer);
}
