// Correct the observed codebook claim in the actual returned answer.
// Codex selected the sentence and its two surfaces. Form resolves the symbol,
// checks the language columns, applies one guarded edit and rechecks the answer.
// This does not classify arbitrary prose or certify the remaining answer.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 def nwm-string-nodes(items) = if nil?(items) then list() else cons(json-node-string(head(items)),nwm-string-nodes(tail(items)));
 def nwm-strings(items) = json-node-array(nwm-string-nodes(items));
 def nwm-row(path) = json-node-object(list(nsm-s("path",path),nsm-s("sha256",nsm-hash(read_file(path))),nsm-s("text",read_file(path))));
 def nwm-sources(paths) = if nil?(paths) then list() else cons(nwm-row(head(paths)),nwm-sources(tail(paths)));
 def nwm-intersect(left,right) = if nil?(left) then list() else if mc-member?(right,head(left)) then cons(head(left),nwm-intersect(tail(left),right)) else nwm-intersect(tail(left),right);
 let root = "receipts/artifacts/2026-09-25-native-whole-answer-care";
 let original = nsm-json(frsh-path(root,"terminal-result.json"));
 let request = nsm-json(frsh-path(root,"request.json"));
 let admitted = fat-wire-documents(original);
 if not(str_eq(fat-wire-error(admitted),"")) then form_error("native answer documents unavailable") else 0;
 let docs = fat-wire-value(admitted);
 let before = nth(fat-find-doc(docs,"answer.md"),2);
 if not(str_eq(before,read_file(frsh-path(root,"answer.txt")))) then form_error("retained native answer differs from terminal result") else 0;
 let claimed = "trust";
 let persian = "پیشنهاد داد"; let german = "anbot";
 let prefix = "For example, the lookup for “";
 let suffix = mc-cat(list("” returns Persian ",persian," and German ",german,"."));
 let old = mc-cat(list(prefix,claimed,suffix));
 if not(eq(ne-count(before,old),1)) then form_error("selected claim is absent or ambiguous") else 0;
 let paths = mc-files(); let table = mc-table-of(paths);
 let roster = mc-meanings(); let book = mc-book-of(roster,table);
 let fa = mc-resolve-in(book,persian); let de = mc-resolve-in(book,german);
 let both = nwm-intersect(fa,de);
 if not(eq(len(both),1)) then form_error("surfaces do not resolve to one shared codebook symbol") else 0;
 let symbol = head(both);
 let codes = mc-codes-in(table,symbol);
 if not(and(str_eq(mc-code-of(codes,"persian"),persian),str_eq(mc-code-of(codes,"german"),german))) then form_error("resolved symbol does not carry the claimed language columns") else 0;
 let replacement = mc-cat(list(prefix,symbol,suffix));
 let edited = fat-call(docs,"edit",list("answer.md",old,replacement),"");
 if not(eq(fat-exit(edited),0)) then form_error(fat-error(edited)) else 0;
 let afterDocs = fat-documents(edited);
 let after = nth(fat-find-doc(afterDocs,"answer.md"),2);
 let checks = json-array-elements(oh-get(request,"checks"));
 let beforeChecks = fcaq-check(checks,docs); let afterChecks = fcaq-check(checks,afterDocs);
 let preserved = fcap-readonly-preserved(docs,afterDocs,list("answer.md"));
 let reobserved = and(eq(ne-count(after,replacement),1),and(eq(ne-count(after,old),0),and(mc-member?(fa,symbol),mc-member?(de,symbol))));
 if not(and(head(afterChecks),and(preserved,reobserved))) then form_error("corrected answer did not retain original checks, sources and resolved claim") else 0;
 let evidence = json-node-object(list(nsm-s("schema","native-codebook-answer-care-v1"),nsm-s("claimed_symbol",claimed),nsm-n("claimed_symbol_in_spoken_roster",mc-member?(roster,claimed)),nsm-s("persian_surface",persian),nsm-s("german_surface",german),json-node-pair("persian_matches",nwm-strings(fa)),json-node-pair("german_matches",nwm-strings(de)),nsm-s("resolved_symbol",symbol),nsm-s("english_surface",mc-code-of(codes,"nl")),nsm-s("codebook_anchor",mc-code-of(codes,"node")),nsm-s("before_claim",old),nsm-s("after_claim",replacement),nsm-n("before_original_checks_passed",head(beforeChecks)),nsm-n("after_original_checks_passed",head(afterChecks)),nsm-n("claim_reobserved",reobserved),nsm-n("other_documents_preserved",preserved),nsm-n("before_words",fal-count(before)),nsm-n("after_words",fal-count(after)),nsm-s("before_sha256",nsm-hash(before)),nsm-s("after_sha256",nsm-hash(after)),nsm-n("provider_calls",0),nsm-n("local_model_calls",0),nsm-s("attribution","Codex selected the actual claim and composed this care cell; existing Form codebook resolved both surfaces, checked language columns, and its native edit tool changed the symbol. Qwen did not generate the correction."),nsm-s("scope","Current spoken codebook and its locale rows; not universal translation correctness, automatic prose understanding, or kernel composition identity. Original checks passed even with the wrong symbol. Whole-answer quality remains open.")));
 frsh-frozen(frsh-path(root,"meaning-care-observation.json"),json-emit(evidence));
 frsh-frozen(frsh-path(root,"meaning-care-source.json"),json-emit(json-node-object(list(json-node-pair("spoken_roster",nwm-strings(roster)),json-node-pair("locale_sources",json-node-array(nwm-sources(paths))),json-node-pair("definition_sources",json-node-array(nwm-sources(list("form/form-stdlib/meaning-codes.bml","form/form-stdlib/symbol-voice.bml","form/form-stdlib/perception-symbols.bml"))))))));
 frsh-frozen(frsh-path(root,"meaning-corrected-answer.txt"),after);
 print_str(json-emit(evidence));
}
