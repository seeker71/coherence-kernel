// Carry the actual composed answer into the native owned coding loop.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nwa-documents(rows,answer,feedback) = if nil?(rows) then list() else {
  let row = head(rows); let path = nsm-str(row,"path");
  let changed = if str_eq(path,"answer.md") then oh-set(row,"text",json-node-string(answer)) else if str_eq(path,"repair-evidence.txt") then oh-set(row,"text",json-node-string(feedback)) else row;
  cons(changed,nwa-documents(tail(rows),answer,feedback));
 };
 let root = "receipts/artifacts/2026-09-25-native-whole-answer-care";
 let prior = nsm-json("receipts/artifacts/2026-09-25-native-applied-response/request.json");
 let answer = read_file("receipts/artifacts/2026-09-25-native-claim-repair/followup/answer.txt");
 let comparison = read_file("receipts/artifacts/2026-09-25-native-claim-repair/followup/comparison.json");
 let feedback = str_concat("This is the actual composed result of the preceding native sparse correction. Form applied 15 replacements. The complete answer grew from 496 to 561 words and failed its original 350-450-word requirement. The answer repeats 'I acknowledge it directly' consecutively and repeats the changed-composition explanation beside existing sentences making the same point. It still says 'the response demonstrates care through clarity' and 'The response is not cautious'; changing first-person self-praise into third-person self-praise did not remove it. The ending still identifies the response with cell composition without establishing that relationship. It mostly describes mechanisms instead of making their practical contribution to Urs's enquiry clear. These content observations are caller feedback. Read the complete answer as one response. Remove redundant and unsupported material; a removed sentence does not need a replacement. Preserve useful source-supported explanations, the six requested axes, and the original 350-450-word requirement. The concrete translation lookup is available in enquiry.txt. Read the edited answer as a whole before completing the task, and use the actual checks to observe the result. Do not claim quality from passing checks.\n\nOriginal-check observation:\n",comparison);
 let documents = json-node-array(nwa-documents(json-array-elements(oh-get(prior,"documents")),answer,feedback));
 let request = oh-set(prior,"documents",documents);
 let goal = str_concat(nsm-str(prior,"goal")," The current repair-evidence.txt names the actual failure of the preceding sparse edits. Resolve those failures in the composed answer; choose edits for the complete response, without replacing each removed sentence with another assertion.");
 let request = oh-set(request,"goal",json-node-string(goal));
 if not(fcaq-request-valid(request)) then form_error("whole-answer care request invalid") else 0;
 if not(node_eq(oh-get(prior,"checks"),oh-get(request,"checks"))) then form_error("original checks changed") else 0;
 fs-mkdir(root);
 frsh-frozen(frsh-path(root,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(root,"before-answer.txt"),answer);
 frsh-frozen(frsh-path(root,"feedback.txt"),feedback);
 let state = ".hearth/native-whole-answer-care"; fs-mkdir(state);
 let path = frsh-path(state,"request.json"); frsh-frozen(path,json-emit(request));
 print_str(json-emit(json-node-object(list(nsm-s("request_path",path),nsm-n("answer_words",fal-count(answer)),nsm-n("checks_unchanged",1),nsm-n("evaluation",1),nsm-n("provider_allowed",0)))));
}
