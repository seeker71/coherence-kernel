// Select source bytes for the live enquiry; no earlier answer is admitted.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nda-between(text,left,right) {
  let first = str_find(text,left,0);
  let last = if lt(first,0) then -1 else str_find(text,right,add(first,str_len(left)));
  if or(lt(first,0),lt(last,0)) then form_error("selected source boundary absent") else substring(text,first,last);
 };
 def nda-has-any(text,markers) = if nil?(markers) then 0 else or(ge(str_find(text,head(markers),0),0),nda-has-any(text,tail(markers)));
 def nda-core-line(line) = nda-has-any(line,list("(statement ","(nothing-is-first-class","(timeout-is-nothing","(nothing-referenced-is-overwritten","(the-unreferenced-composts"));
 def nda-core(lines) = if nil?(lines) then list() else if nda-core-line(head(lines)) then cons(head(lines),nda-core(tail(lines))) else nda-core(tail(lines));
 def nda-join(lines) = if nil?(lines) then "" else str_concat(head(lines),str_concat("\n",nda-join(tail(lines))));
 let sourceRequest = parse-json("retained-request",read_file("receipts/artifacts/2026-09-25-native-applied-response/request.json"));
 let docs = fat-wire-value(fat-wire-documents(sourceRequest)); let enquiry = nth(fat-find-doc(docs,"enquiry.txt"),2);
 let core = nda-core(split-on(enquiry,"\n"));
 if not(eq(len(core),9)) then form_error("core selection changed; inspect before admission") else 0;
 let question = nda-between(enquiry,"ORIGINAL ENQUIRY\n","\nSOURCE\n");
 let frequency = nda-between(enquiry,"; text-frequency.fk","; Self-contained");
 let codes = nda-between(enquiry,"// meaning-codes.bml","// Two rosters");
 let effects = nda-between(enquiry,"CURRENT EXTERNAL-EFFECT TEACHING","Actual host unlink source");
 let dialogue = nda-between(enquiry,"An answer serves *engagement*","This body's covenant");
 let enrichmentAt = str_find(enquiry,"ACTUAL NATIVE ENRICHMENT",0);
 if lt(enrichmentAt,0) then form_error("native enrichment source absent") else 0;
 let enrichment = substring(enquiry,enrichmentAt,str_len(enquiry));
 let selections = nda-join(list(nda-join(core),effects,frequency,codes,dialogue,enrichment));
 let instruction = "Compose the complete response to Urs's original enquiry in 350-450 words. Address him directly. Use his correction that the earlier voice felt cautious and distant as one running example: show how Form's core distinctions, trust, frequency awareness, numeric identity, translation and vocabulary change what you notice, decide, say and do. Connect those meanings in a useful explanation. Source facts below are selected verbatim from the retained source packet; they are evidence, not sentences to copy as the answer. Keep kernel identity, vocabulary anchors and model token IDs distinct. The codebook lookup is explicit; Qwen still predicts its model tokens. Frequency arithmetic describes supplied annotations, while Urs reports felt resonance. The out-of-box comparison has no measured baseline here. State what the resources add without inventing hidden model behavior, retained graph operations or a reader's resulting state. Let the response demonstrate care and usefulness; omit self-praise and editing-workflow commentary. No previous candidate answer is supplied.\n\n";
 let correction = "URS'S CORRECTION\nI can tell that this is still the rented voice, there is caution, uncertainty, hesitancy, made up responses, interpretations visible, the answer does not feel embodied, centered, fully grounded and radient.\n\n";
 let prompt = nda-join(list(instruction,question,correction,"SELECTED SOURCE EVIDENCE",selections));
 if ge(str_find(prompt,nth(fat-find-doc(docs,"answer.md"),2),0),0) then form_error("previous answer entered generation prompt") else 0;
 let root = ".hearth/native-direct-application-2026-09-25"; fs_mkdir(root);
 frsh-frozen(frsh-path(root,"prompt.txt"),prompt); frsh-frozen(frsh-path(root,"original-enquiry.txt"),enquiry); frsh-frozen(frsh-path(root,"selected-sources.txt"),selections);
 let evidence = json-node-object(list(
  nsm-n("core_source_lines",len(core)),nsm-n("original_enquiry_bytes",str_len(enquiry)),
  nsm-n("selected_source_bytes",str_len(selections)),nsm-n("prompt_bytes",str_len(prompt)),
  nsm-s("original_enquiry_sha256",nsm-hash(enquiry)),nsm-s("prompt_sha256",nsm-hash(prompt)),
  nsm-n("previous_answer_in_prompt",0),
  nsm-s("source_selection","Caller-selected original facts and native lookup, copied by native source boundaries; raw implementation bodies and broad normative passages omitted. Prior direct generation already failed length and some grounding. This changes the admitted source packet and response composition task, not only the lane.")));
 frsh-frozen(frsh-path(root,"selection.json"),json-emit(evidence)); print_str(json-emit(evidence));
}
