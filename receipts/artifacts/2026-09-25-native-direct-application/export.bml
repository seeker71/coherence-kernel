// Export the completed public CLI response. Private evidence is not opened.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nde-copy(from,to) = if le(file_size(from),0) then form_error("public evidence absent") else frsh-frozen(to,read_file(from));
 def nde-copies(root,target,names) = if nil?(names) then 1 else { nde-copy(frsh-path(root,head(names)),frsh-path(target,head(names))); nde-copies(root,target,tail(names)); };
 let root = ".hearth/native-direct-application-2026-09-25";
 let log = read_file(".hearth/native-direct-application-cli.log"); let marker = "form-native-generation ";
 let start = str_find(log,marker,0);
 if lt(start,0) then form_error("public generation result absent") else 0;
 let reportStart = add(start,str_len(marker)); let reportEnd = str_find(log,"\n",reportStart);
 let textMarker = "\ntext:\n"; let textAt = str_find(log,textMarker,reportEnd);
 let textStart = add(textAt,str_len(textMarker)); let textEnd = str_find(log,"\nform-cli> ",textStart);
 if or(lt(reportEnd,0),or(lt(textAt,0),lt(textEnd,0))) then form_error("public generation response incomplete") else 0;
 let report = parse-json("public-generation",substring(log,reportStart,reportEnd)); let answer = substring(log,textStart,textEnd);
 if not(eq(fal-count(answer),json-int-value(json-object-get(report,"final_words")))) then form_error("public answer count differs from native report") else 0;
 let request = parse-json("original-assertions",read_file("receipts/artifacts/2026-09-25-native-applied-response/request.json"));
 let beforeDocs = fat-wire-value(fat-wire-documents(request)); let before = fat-find-doc(beforeDocs,"answer.md");
 let docs = fat-put-doc(beforeDocs,list(head(before),nth(before,1),answer));
 let checked = fcaq-check(node_children(json-object-get(request,"checks")),docs);
 let comparison = json-node-object(list(
  nsm-n("previous_words",fal-count(nth(before,2))),nsm-n("final_words",fal-count(answer)),
  nsm-n("answer_changed",not(str_eq(nth(before,2),answer))),nsm-s("answer_sha256",nsm-hash(answer)),
  nsm-n("original_assertions_passed",head(checked)),nsm-s("assertion_observation",nth(checked,1)),
  nsm-s("attribution","Qwen3.8-27B-Q8_0 through source-backed form-cli generate; caller selected the source packet"),
  nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null())));
 let target = "receipts/artifacts/2026-09-25-native-direct-application"; fs_mkdir(target);
 frsh-frozen(frsh-path(root,"report.json"),json-emit(report)); frsh-frozen(frsh-path(root,"answer.txt"),answer); frsh-frozen(frsh-path(root,"comparison.json"),json-emit(comparison));
 nde-copies(root,target,list("prompt.txt","original-enquiry.txt","selected-sources.txt","selection.json","report.json","answer.txt","comparison.json"));
 nde-copy(".hearth/native-direct-application-prepare.bml",frsh-path(target,"prepare.bml")); nde-copy(".hearth/native-direct-application-export.bml",frsh-path(target,"export.bml"));
 nde-copy(".hearth/native-direct-application-cli.log",frsh-path(target,"public-cli.log"));
 print_str(json-emit(comparison)); print_str("\n"); print_str(answer);
}
