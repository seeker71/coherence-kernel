// Display the actual retained answers, unchanged and attributed.
section [form.bml] {
 let root="receipts/artifacts/2026-09-26-native-identity-usefulness-care/";
 let native=read_file(str_concat(root,"answer.txt"));
 let arriving=read_file("receipts/artifacts/2026-09-26-native-usefulness-feedback/arriving-answer-revised.md");
 let first="# Two answers to the original Form enquiry\n\nThese are actual retained answers to the same enquiry. Their contexts differ: local Qwen used the supplied source packet, admitted Form teachings and caller feedback; Codex also had the conversation and the provisional review. This is a comparison of real work, with no claim of a controlled model ranking.\n\n## Local Qwen — qwen38-q8, 443 words\n\nCompleted native repair. Original checks passed and the retained review identifies this document.\n\n";
 let second="\n\n## Arriving Codex — 416 words\n\nThe separately authored answer passes the same mechanical checks. It was not supplied as replacement prose to the native repair.\n\n";
 let path=str_concat(root,"response-comparison.md");
 write_file_text(path,str_concat(first,str_concat(native,str_concat(second,arriving))));
 print_str(path);
}
