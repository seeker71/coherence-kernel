// Inspect the real response checkpoint's admission context without exposing it.
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def cah-location(rows,older) = if nil?(rows) then list() else cons(nsm-n(head(head(rows)),ge(str_find(nth(head(rows),1),older,0),0)),cah-location(tail(rows),older));
 def cah-history(rows,older) = if nil?(rows) then list() else {
  let row=head(rows); let evidence=nth(row,1); let at=str_find(evidence,"{",0);
  let prefix=if and(ge(at,0),lt(at,150)) then substring(evidence,0,at) else "unclassified-prefix";
  cons(json-node-object(append(list(nsm-n("attempt",head(row)),nsm-s("evidence_prefix",prefix)),cah-location(list(list("normalized_evidence",fcap-counterexample(evidence)),list("diagnosis",nth(row,2)),list("change",nth(row,3))),older))),cah-history(tail(rows),older));
 };
 let phase=read_line();
 if not(fat-has(list("before","after","resolved","verified"),phase)) then form_error("supply before, after, resolved or verified") else 0;
 let root="receipts/artifacts/2026-09-26-native-identity-usefulness-care";
 let frozen=".hearth/native-identity-usefulness-care/observed-checkpoint.json";
 let request=nsm-json("receipts/artifacts/2026-09-26-native-usefulness-feedback/request.json");
 let initial=fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let scope=fcam-work-scope(initial,json-emit(oh-get(request,"checks")));
 let id=nsm-str(request,"resume");
 let source=if str_eq(phase,"before") then fcam-path(hearth-code-memory(),id,"checkpoint") else frozen;
 let packet=if str_eq(phase,"before") then fcam-read(source) else faj-json("owned-checkpoint",read_file(source));
 let raw=json-emit(packet);
 if not(fcam-packet-valid(packet,"checkpoint",scope)) then form_error("checkpoint contract invalid") else 0;
 let state=fcam-state-from(packet);
 if not(fcam-state-valid(state,initial)) then form_error("checkpoint source state invalid") else 0;
 if str_eq(phase,"before") then frsh-frozen(frozen,raw) else 0;
 let prompt=fcap-bootstrap(fcap-begin-context(state));
 let current=fat-document-sha(fat-find-doc(fcap-docs(state),"answer.md"));
 let older="89537cdecd9dd3b73cb1522363a0fc0017c7d11ba9639cc5a19046f9261818a8";
 let history=json-emit(json-node-array(fcap-reflections-json(fcap-reflections(state))));
 if str_eq(phase,"verified") then {
  let before=nsm-json(frsh-path(root,"admission-history-before.json"));
  if not(and(ge(str_find(prompt,current,0),0),and(lt(str_find(prompt,older,0),0),str_eq(nsm-hash(history),nsm-str(before,"public_history_sha256"))))) then form_error("current identity or complete historical evidence lost, or stale identity still admitted") else 0;
 } else 0;
 let reading=json-node-object(list(nsm-s("phase",phase),nsm-s("checkpoint_digest",nsm-str(packet,"digest")),nsm-n("turns",fcap-turns(state)),nsm-s("current_answer_sha256",current),nsm-n("current_identity_in_admission",ge(str_find(prompt,current,0),0)),nsm-n("earlier_checked_identity_in_admission",ge(str_find(prompt,older,0),0)),nsm-n("earlier_checked_identity_in_public_history",ge(str_find(history,older,0),0)),nsm-s("public_history_sha256",nsm-hash(history)),nsm-n("admission_bytes",str_len(prompt)),nsm-s("admission_sha256",nsm-hash(prompt)),nsm-s("scope","Reconstructed admission for the same retained real checkpoint; the active model context is unchanged. No private model reasoning or reply files were read.")));
 frsh-frozen(frsh-path(root,str_concat("admission-history-",str_concat(phase,".json"))),json-emit(reading));
 print_str(json-emit(reading));
 if not(str_eq(phase,"before")) then {
  let places=list(list("current_failure",fcap-evidence(state)),list("current_observation",fcap-note(state)),list("brief",nth(state,6)),list("plan",nth(state,7)),list("prior_repairs",json-emit(json-node-array(fcap-prior-repairs-json(fat-take(reverse(fcap-reflections(state)),3))))),list("source_queries",fcap-source-context(state)));
  print_str(json-emit(json-node-object(cah-location(places,older))));
  print_str(json-emit(json-node-array(cah-history(fat-take(reverse(fcap-reflections(state)),3),older))));
  let occurrence=str_find(prompt,older,0);
  if ge(occurrence,0) then print_str(substring(prompt,fat-max(0,sub(occurrence,150)),add(occurrence,str_len(older)))) else 0;
 } else 0;
}
