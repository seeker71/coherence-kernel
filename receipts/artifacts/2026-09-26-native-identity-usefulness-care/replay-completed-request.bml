// Reuse the completed real request through the same native code door.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let root="receipts/artifacts/2026-09-26-native-identity-usefulness-care";
 let request=nsm-json(frsh-path(root,"request.json"));
 let prior=nsm-json(frsh-path(root,"terminal-result.json"));
 if not(and(str_eq(nsm-str(prior,"status"),"complete"),and(eq(nsm-num(prior,"release_ok"),1),str_eq(nsm-str(prior,"checkpoint_id"),nsm-str(request,"resume"))))) then form_error("completed matching checkpoint with released owner required") else 0;
 let started=host_monotonic_ms();
 let raw=fcaq-command(json-emit(request));
 let elapsed=sub(host_monotonic_ms(),started);
 frsh-frozen(frsh-path(root,"replay-result.json"),raw);
 let result=faj-json("replayed-code-result",raw);
 let before=fat-wire-documents(prior); let after=fat-wire-documents(result);
 if not(and(str_eq(fat-wire-error(before),""),str_eq(fat-wire-error(after),""))) then form_error("replay documents unavailable; retained result requires care") else 0;
 let sameDocs=value_eq(fat-wire-value(before),fat-wire-value(after));
 let checks=fcaq-check(json-array-elements(oh-get(request,"checks")),fat-wire-value(after));
 let observed=json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-n("documents_identical",sameDocs),nsm-n("original_checks_passed",head(checks)),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("generated_ids",nsm-num(result,"generated_ids")),nsm-n("injected_ids",nsm-num(result,"injected_ids")),nsm-n("new_turns",sub(nsm-num(result,"turns"),nsm-num(prior,"turns"))),nsm-n("new_check_runs",sub(nsm-num(result,"check_runs"),nsm-num(prior,"check_runs"))),nsm-n("elapsed_ms",elapsed),nsm-n("weight_training_excluded",nsm-num(result,"weight_training_excluded")),nsm-s("scope","Actual replay of the same completed request and feedback event. Returning retained words and rechecking source assertions does not establish new answer quality.")));
 frsh-frozen(frsh-path(root,"replay-comparison.json"),json-emit(observed));
 print_str(json-emit(observed));
 if not(and(str_eq(nsm-str(result,"status"),"complete"),and(sameDocs,and(head(checks),and(eq(nsm-num(result,"generated_ids"),0),eq(nsm-num(result,"injected_ids"),0)))))) then form_error("completed replay changed, failed checks or generated new tokens; inspect retained result") else 0;
}
