// Finish the actual guide from retained native work; no new generation.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-cli-heal-native-io.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 class LocalWalkFinish {
  def lwf-copy(from,to) {
   let bytes = read_file(from);
   if nothing?(bytes) then form_error("actual work artifact absent") else 0;
   write_file_text(to,bytes);
   if not(str_eq(read_file(to),bytes)) then form_error("artifact retention failed") else 0;
  }
  def lwf-edit(text,old,new) {
   let edited = fat-call(list(list("guide","guide.md",text)),"edit",list("guide.md",old,new),"");
   if not(eq(fat-exit(edited),0)) then form_error(fat-error(edited)) else nth(head(fat-documents(edited)),2);
  }
  def lwf-run() {
   let base = "receipts/artifacts/2026-09-22-native-local-walk-guide/";
   fs_mkdir(base);
   lwf-copy(".hearth/local-walk-repair-2026-09-22original.md",str_concat(base,"original.md"));
   lwf-copy(".hearth/local-walk-repair-2026-09-22request.json",str_concat(base,"request.json"));
   lwf-copy(".hearth/local-walk-repair.bml",str_concat(base,"worker.bml"));
   lwf-copy(".form-heal/process-81790-197458992-0/process.process.json",str_concat(base,"process.json"));
   lwf-copy(".hearth/code-memory/replies/81795-1790065260229.txt",str_concat(base,"native-write.json"));
   lwf-copy(".hearth/code-memory/replies/81795-1790065314236.txt",str_concat(base,"native-diagnosis.json"));
   let proposed = fhn-string(parse-json("native-write",read_file(str_concat(base,"native-write.json"))),"input");
   write_file_text(str_concat(base,"native-proposal.md"),proposed);
   let intro = lwf-edit(proposed,"The walk runs directly through the local kernel; the model runs in-process. No\nexternal assistant, no loopback server, no transcript discovery, no schedule.","The walk runs directly through the local kernel. It uses registry model weights\nand the host's optional Metal carrier in-process.");
   let bootstrap = lwf-edit(intro,"Build the kernel once per checkout (see AGENTS.md for the full C-bootstrap and\nfreshness recipe):\n\n```sh\ncc -O2 -o fkwu runtime/fkwu-uni.c\n```\n\nThen make one call, replacing `<date>` with today (YYYY-MM-DD):","Follow the [C-bootstrap and freshness instructions](../AGENTS.md#ground-the-kernel-first-temporary-c-seed-shrinking-to-zero), then run from the repository root:");
   let begin = str_find(bootstrap,"```sh\n",0);
   let end = str_find(bootstrap,"\n```",add(begin,6));
   if or(lt(begin,0),lt(end,0)) then form_error("native command block absent") else 0;
   let command = lwf-edit(bootstrap,substring(bootstrap,begin,add(end,4)),"```sh\n./form-run ./fkwu observe/movement-run.bml <<'FORM_MOVEMENT'\n{\"movement\":\"local walk\",\"transcript\":\"\",\"subject\":\"Local native movement\"}\nFORM_MOVEMENT\n```");
   let restart = lwf-edit(command,"- `restart`: optional restart command.\n","");
   let final = lwf-edit(restart,"\n## Bootstrap\n\nSee AGENTS.md for the C-bootstrap and freshness requirements. Do not duplicate\nthat recipe here.\n","");
   let target = "docs/local-walk-prompt.md";
   let original = read_file(str_concat(base,"original.md"));
   if not(str_eq(read_file(target),original)) then form_error("live guide changed since admission") else 0;
   let replaced = lwf-edit(read_file(target),original,final);
   write_file_text(target,replaced);
   if not(str_eq(read_file(target),final)) then form_error("guide publication failed") else 0;
   write_file_text(str_concat(base,"adopted.md"),final);
   let request = parse-json("actual-request",read_file(str_concat(base,"request.json")));
   let docs = fat-wire-value(fat-wire-documents(request));
   let initial = fcap-with-reply-token-limit(fcap-open-direct-code(fhn-string(request,"goal"),docs,list(target)),1536);
   let full = fcac-bootstrap-budget(fcap-begin-context(initial),12);
   let catalog = fcac-bootstrap-budget(fcap-begin-context(fcap-with-document-context(initial,"catalog")),12);
   let measured = json-node-object(list(fhn-s("status","adopted-with-source-review-corrections"),fhn-s("native_controller","deadline;unfinished"),fhn-n("full_context_bytes_current",str_len(full)),fhn-n("catalog_context_bytes_current",str_len(catalog)),fhn-n("bytes_removed",sub(str_len(full),str_len(catalog))),fhn-s("scope","same retained task and sources with current guidance; bytes, not latency or answer quality"),fhn-n("new_model_calls",0)));
   write_file_text(str_concat(base,"audit.json"),json-emit(measured));
   write_file_text(str_concat(base,"preceding-coordinator-cost.json"),json-emit(ftc-read()));
   print_str(json-emit(measured));
  }
 }
 lwf-run();
}
