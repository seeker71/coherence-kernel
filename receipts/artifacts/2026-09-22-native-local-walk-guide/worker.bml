// Real documentation repair in one native coding session.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-cli-review-context-care.bml form-stdlib/bml/form-cli-heal-native-io.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 class LocalWalkRepair {
  def lwr-root() = ".hearth/local-walk-repair-2026-09-22";
  def lwr-path() = "docs/local-walk-prompt.md";
  def lwr-has(text,part) = ge(str_find(text,part,0),0);
  def lwr-doc(id,path,text) = list(id,path,text);
  def lwr-check(path,docs) {
   let text = nth(fat-find-doc(docs,path),2);
   let native = and(lwr-has(text,"./form-run ./fkwu observe/movement-run.bml"),lwr-has(text,"in-process"));
   let obsolete = or(lwr-has(text,"claude -p"),or(lwr-has(text,"127.0.0.1:18082"),lwr-has(text,"~/.claude/projects")));
   let bounded = and(lwr-has(text,"health"),and(lwr-has(text,"landing"),lwr-has(text,"push")));
   list(and(native,and(not(obsolete),bounded)),"Documentation contract: include the direct native movement command and in-process model, read health/landing/push separately, and remove the rented launcher, old server endpoint and arbitrary Claude transcript search. These assertions do not establish prose quality.");
  }
  def lwr-main() {
   fs_mkdir(lwr-root());
   let original = read_file(lwr-path());
   let docs = list(lwr-doc("edit",lwr-path(),original),lwr-doc("movement","observe/movement-run.bml",read_file("observe/movement-run.bml")),lwr-doc("voice","form/form-stdlib/bml/form-cli-voice-walk.bml",read_file("form/form-stdlib/bml/form-cli-voice-walk.bml")),lwr-doc("landing-contract","source/landing-contract.bml",frcc-part(list("form/form-stdlib/bml/form-cli-landing.bml","  def ld-land(","  def ld-run("))),lwr-doc("bootstrap","source/bootstrap.md",frcc-part(list("AGENTS.md","## Ground the kernel first","Form-generated CPU and Metal programs"))));
   let goal = "Repair docs/local-walk-prompt.md for the current native runtime. Replace its outdated rented-assistant prompt with concise operational instructions, at most 450 words. The walk runs directly through ./form-run ./fkwu observe/movement-run.bml and the local model runs in-process. Use the supplied current source as authority. Give a concrete JSON stdin command, explain its current outputs and optional fields, and describe C-bootstrap/freshness requirements by linking AGENTS.md rather than duplicating its recipe. Remove the external assistant launch, arbitrary transcript discovery, old loopback-server description and obsolete branch-specific setup. Leave transcript empty unless the operator deliberately supplies the relevant supported transcript; empty is unmeasured, not zero cost. State that land defaults on, pushes the current branch and has a land=0 option; actual landing and push outcomes must be read. A completed process does not establish answer quality. A failure asks for inspection and repair from retained evidence before continuation; an observation timeout is not terminal and must not trigger another model admission. Do not install a schedule, run the movement, claim unobserved success, or change any other document. Perform the edit with native write or edit, then finish the task, review it and run the original caller checks.";
   write_file_text(str_concat(lwr-root(),"original.md"),original);
   write_file_text(str_concat(lwr-root(),"request.json"),json-emit(json-node-object(list(oh-s("goal",goal),json-node-pair("documents",fat-wire-documents-node(docs)),oh-s("model","qwen38-q8"),oh-n("context",12288),oh-n("turns",12),oh-n("max_reply_tokens",1536)))));
   let initial = fcap-with-reply-token-limit(fcap-open-direct-code(goal,docs,list(lwr-path())),1536);
   let started = host_monotonic_ms();
   let result = fcac-admit("qwen38-q8",initial,list(lwr-check,lwr-path()),12288,12);
   let state = head(result);
   let full = parse-json("local-walk-result",fcaq-result-core(result));
   write_file_text(str_concat(lwr-root(),"result.json"),json-emit(full));
   let candidate = nth(fat-find-doc(fcap-docs(state),lwr-path()),2);
   write_file_text(str_concat(lwr-root(),"candidate.md"),candidate);
   print_str(json-emit(json-node-object(list(oh-s("status",fcap-stage(state)),oh-s("reason",fcap-note(state)),oh-n("turns",fcap-turns(state)),oh-n("tool_calls",fcap-calls(state)),oh-n("generated_ids",nth(result,2)),oh-n("injected_ids",nth(result,3)),oh-n("release_ok",nth(result,1)),oh-n("elapsed_ms",sub(host_monotonic_ms(),started)),oh-n("candidate_changed",not(str_eq(candidate,original))),oh-n("provider_calls",0),oh-s("evidence",lwr-root())))));
  }
 }
 lwr-main();
}
