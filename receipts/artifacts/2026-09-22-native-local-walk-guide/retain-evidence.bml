// Preserve actual output bytes and verify every artifact write.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-heal-native-io.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 let cost = ftc-read();
 let costText = json-emit(cost);
 let costPath = "receipts/artifacts/2026-09-22-native-local-walk-guide/preceding-coordinator-cost.json";
 write_file_text(costPath,costText);
 if not(str_eq(read_file(costPath),costText)) then form_error("cost artifact not retained") else 0;
 let output = read_file(".form-heal/process-81790-197458992-0/process.out");
 if nothing?(output) then form_error("actual process output absent") else 0;
 let encoded = json-emit(json-node-string(output));
 let outputPath = "receipts/artifacts/2026-09-22-native-local-walk-guide/process-output.json";
 write_file_text(outputPath,encoded);
 let roundtrip = str_eq(json-string-value(parse-json("retained-process-output",read_file(outputPath))),output);
 if not(roundtrip) then form_error("retained process output changed bytes") else 0;
 print_str(json-emit(json-node-object(list(fhn-n("cost_retained",1),fhn-n("output_roundtrip",roundtrip),fhn-n("output_bytes",str_len(output))))));
}
