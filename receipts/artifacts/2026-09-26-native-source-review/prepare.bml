// Native source observations for the actual retained answer, followed by an
// owned local correction request. The model receives no replacement answer.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 def nsr-code-rows(rows) = if nil?(rows) then list() else cons(json-node-object(list(nsm-s("kind",head(head(rows))),nsm-s("surface",nth(head(rows),1)))),nsr-code-rows(tail(rows)));
 def nsr-symbol-rows(symbols,table) = if nil?(symbols) then list() else cons(json-node-object(list(nsm-s("symbol",head(symbols)),json-node-pair("codes",json-node-array(nsr-code-rows(mc-codes-in(table,head(symbols))))))),nsr-symbol-rows(tail(symbols),table));
 def nsr-mentions(rows,table) = if nil?(rows) then list() else {
  let row = head(rows);
  cons(json-node-object(list(nsm-s("surface",head(row)),nsm-n("first_byte",nth(row,1)),json-node-pair("meanings",json-node-array(nsr-symbol-rows(nth(row,2),table))))),nsr-mentions(tail(rows),table));
 };
 def nsr-documents(rows,feedback) = if nil?(rows) then list() else {
  let row = head(rows);
  cons(if str_eq(nsm-str(row,"path"),"repair-evidence.txt") then oh-set(row,"text",json-node-string(feedback)) else row,nsr-documents(tail(rows),feedback));
 };
 def nsr-query(path) = json-node-object(list(nsm-s("tool","read"),json-node-pair("arguments",json-node-array(list(json-node-string(path))))));
 let root = "receipts/artifacts/2026-09-26-native-source-review";
 let priorRoot = "receipts/artifacts/2026-09-25-native-whole-answer-care";
 let prior = nsm-json(frsh-path(priorRoot,"request.json"));
 let originalGoal = nsm-str(nsm-json("receipts/artifacts/2026-09-25-native-applied-response/request.json"),"goal");
 let result = nsm-json(frsh-path(priorRoot,"terminal-result.json"));
 let supplied = fat-wire-documents(result);
 if not(str_eq(fat-wire-error(supplied),"")) then form_error("retained answer documents unavailable") else 0;
 let docs = fat-wire-value(supplied); let answer = nth(fat-find-doc(docs,"answer.md"),2);
 let table = mc-table(); let book = mc-book-of(mc-meanings(),table);
 let mentions = mc-text-codes-in(book,answer);
 let evidence = json-node-object(list(nsm-s("schema","form-codebook-text-observation-v1"),nsm-s("subject_sha256",nsm-hash(answer)),nsm-s("scope","Exact case-sensitive locale surfaces with whitespace or punctuation boundaries. Each row retains every matching spoken-codebook symbol and its current codes. These are lookup candidates, not claims that the surrounding prose chose that language or sense. A missing match only describes this codebook and this delimiter set."),json-node-pair("mentions",json-node-array(nsr-mentions(mentions,table)))));
 let feedback = "The retained answer passed its original word-range and phrase-absence checks and same-model review. Those checks do not verify factual reasoning. Re-read the original enquiry and compare the answer's factual examples, causal explanations and descriptions of its own actions with the supplied evidence. codebook-evidence.json is generated by Form from locale surface bytes occurring in this exact answer; it retains all candidate meanings. Use it to check the relationships asserted in the answer, choosing language and sense from context. Correct source mismatches and distinguish observed causes from interpretations. Keep the useful explanation and complete the person's original enquiry. Read the revised answer as a whole; a passing check alone does not establish its quality. No replacement answer is supplied.";
 let evidenceDoc = json-node-object(list(nsm-s("id","native-codebook-observation"),nsm-s("path","codebook-evidence.json"),nsm-s("text",json-emit(evidence))));
 let documents = json-node-array(append(nsr-documents(json-array-elements(oh-get(result,"documents")),feedback),list(evidenceDoc)));
 let request = oh-set(prior,"documents",documents);
 let request = oh-set(request,"evaluation",json-node-int(0));
 let request = oh-set(request,"weight_training",json-node-int(0));
 let request = oh-set(request,"reasoning_tokens",json-node-int(512));
 let request = oh-set(request,"reasoning_answer_tokens",json-node-int(1024));
 let request = oh-set(request,"turns",json-node-int(10));
 let request = oh-set(request,"source_queries",json-node-array(list(nsr-query("enquiry.txt"),nsr-query("answer.md"),nsr-query("codebook-evidence.json"),nsr-query("repair-evidence.txt"))));
 let request = oh-set(request,"goal",json-node-string(str_concat(originalGoal," The current repair-evidence.txt and native codebook-evidence.json carry the next source-fidelity work. Resolve it through your own reading, reasoning, document edits and review. Preserve the original enquiry and checks.")));
 if not(fcaq-request-valid(request)) then form_error("source review request invalid") else 0;
 if not(node_eq(oh-get(prior,"checks"),oh-get(request,"checks"))) then form_error("original checks changed") else 0;
 fs-mkdir(root);
 frsh-frozen(frsh-path(root,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(root,"before-answer.txt"),answer);
 frsh-frozen(frsh-path(root,"codebook-evidence.json"),json-emit(evidence));
 frsh-frozen(frsh-path(root,"feedback.txt"),feedback);
 frsh-frozen(frsh-path(root,"meaning-teaching.json"),json-emit(json-node-object(list(nsm-s("sha256",nsm-hash(fqt-meaning-prefix())),nsm-s("text",fqt-meaning-prefix())))));
 let home = ".hearth/native-source-review"; fs-mkdir(home);
 let path = frsh-path(home,"request.json"); frsh-frozen(path,json-emit(request));
 print_str(json-emit(json-node-object(list(nsm-s("request_path",path),nsm-n("answer_words",fal-count(answer)),nsm-n("lookup_rows",len(mentions)),nsm-n("checks_unchanged",1),nsm-n("weight_training",0),nsm-n("reasoning_tokens",512),nsm-n("provider_calls",0),json-node-pair("codebook_evidence",evidence)))));
}
