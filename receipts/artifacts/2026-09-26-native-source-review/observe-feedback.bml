// Reopen the actual completed response with caller findings; no model admission.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nsrf-require(ok,label) = if ok then 1 else form_error(str_concat("native feedback observation: ",label));
 let root = "receipts/artifacts/2026-09-26-native-source-review";
 let original = nsm-json(frsh-path(root,"request.json"));
 let result = nsm-json(frsh-path(root,"terminal-result.json"));
 let request = oh-set(original,"resume",json-node-string(nsm-str(result,"checkpoint_id")));
 let text = "The returned 415-word answer still contains two unsupported claims. Opening: 'That distance came from treating the exchange as a risk to manage rather than a question to serve.' The enquiry reports how the voice felt; it does not establish that internal cause. Ending: 'I act by offering a cell with arguments, acknowledged by exactly one result.' No identified operation or observed result supports this as an action performed by that reply. Re-read the source context, correct those claims, and make the changes in attention, judgment and useful action concrete for Urs. Preserve the corrected offer mapping and the original six axes. Original word and phrase checks still apply. Assess the whole revised answer and these findings against evidence before accepting it. This is caller feedback, not a replacement answer or a claim that the cause has been diagnosed.";
 let feedback = json-node-object(list(nsm-s("id","2026-09-26-source-review-unsupported-claims-v1"),nsm-s("text",text)));
 let next = oh-set(request,"feedback",feedback);
 nsrf-require(fcaq-request-valid(next),"feedback request admission");
 let docs = fat-wire-value(fat-wire-documents(original)); let checker = fcaq-live-checker(original);
 let before = fcaq-prepare(request,docs,checker,hearth-code-memory());
 let after = fcaq-prepare(next,docs,checker,hearth-code-memory());
 nsrf-require(str_eq(fcap-stage(before),"complete"),"original checkpoint still completes its checks");
 nsrf-require(str_eq(fcap-stage(after),"repair"),"feedback reopens actual completed work");
 nsrf-require(str_eq(fcam-contract(before),fcam-contract(after)),"original contract preserved");
 nsrf-require(node_eq(fcam-pack(fcap-docs(before)),fcam-pack(fcap-docs(after))),"candidate documents preserved");
 nsrf-require(node_eq(fcam-pack(nth(before,2)),fcam-pack(nth(after,2))),"original documents preserved");
 nsrf-require(str_eq(fcap-report(before),fcap-report(after)),"prior review retained");
 nsrf-require(eq(fcap-failures(after),add(fcap-failures(before),1)),"one observed failure");
 nsrf-require(eq(fcap-turns(before),fcap-turns(after)),"no fabricated model turn");
 let restored = fcam-state-from(fcam-packet(after,"checkpoint"));
 let repeated = fcaq-feedback-state(next,restored);
 nsrf-require(node_eq(fcam-pack(after),fcam-pack(repeated)),"same event delivery is idempotent after checkpoint codec");
 let conflict = oh-set(next,"feedback",oh-set(feedback,"text",json-node-string("different finding")));
 nsrf-require(str_eq(fcap-note(fcaq-feedback-state(conflict,after)),"caller-feedback-id-content-conflict"),"changed event content refused");
 nsrf-require(not(fcaq-request-valid(oh-set(next,"resume",json-node-string("")))),"feedback requires explicit checkpoint");
 nsrf-require(not(fcaq-request-valid(oh-set(next,"evaluation",json-node-int(1)))),"fresh evaluation excludes feedback resume");
 nsrf-require(not(fcaq-request-valid(oh-set(next,"feedback",json-node-string("untyped")))),"feedback shape checked");
 nsrf-require(not(fcaq-request-valid(oh-set(next,"feedback",oh-set(feedback,"text",json-node-string(" "))))),"empty finding refused");
 let invalid = oh-set(next,"resume",json-node-string("abc"));
 nsrf-require(str_eq(fcap-stage(fcaq-prepare(invalid,docs,checker,hearth-code-memory())),"attention"),"feedback cannot reopen a missing checkpoint");
 nsrf-require(fcaq-training-excluded(next),"assessed answer remains outside gradients");
 nsrf-require(node_eq(oh-get(original,"checks"),oh-get(next,"checks")),"all original checks unchanged");
 let observation = json-node-object(list(nsm-s("before",fcap-stage(before)),nsm-s("after",fcap-stage(after)),nsm-s("checkpoint_id",fcam-id(after)),nsm-n("contract_preserved",1),nsm-n("documents_preserved",1),nsm-n("checks_unchanged",1),nsm-n("feedback_events",len(fcaq-feedback-events(after))),nsm-n("replay_idempotent",1),nsm-n("conflicting_event_refused",1),nsm-n("weight_training_excluded",1),nsm-n("model_calls",0),nsm-s("scope","actual retained checkpoint enters repair with caller findings; answer quality awaits native revision")));
 frsh-frozen(frsh-path(root,"feedback-request.json"),json-emit(next));
 frsh-frozen(frsh-path(root,"feedback-observation.json"),json-emit(observation));
 let home = ".hearth/native-source-feedback"; fs-mkdir(home);
 frsh-frozen(frsh-path(home,"request.json"),json-emit(next));
 print_str(json-emit(observation));
}
