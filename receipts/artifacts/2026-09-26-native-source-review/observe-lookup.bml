// Observe the new lookup on the actual answer and the existing locale corpus.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-enrich.bml
section [form.bml] {
 def nsro-symbols(left,right) = if nil?(left) then nil?(right) else if nil?(right) then 0 else and(str_eq(head(left),head(right)),nsro-symbols(tail(left),tail(right)));
 def nsro-valid(rows,book,text) = if nil?(rows) then 1 else {
  let row = head(rows); let surface = head(row); let at = nth(row,1);
  and(str_eq(substring(text,at,add(at,str_len(surface))),surface),and(nsro-symbols(nth(row,2),mc-resolve-in(book,surface)),nsro-valid(tail(rows),book,text)));
 };
 def nsro-find(rows,surface) = if nil?(rows) then list() else if str_eq(head(head(rows)),surface) then cons(head(rows),nsro-find(tail(rows),surface)) else nsro-find(tail(rows),surface);
 let root = "receipts/artifacts/2026-09-26-native-source-review";
 let answerPath = "receipts/artifacts/2026-09-25-native-whole-answer-care/answer.txt";
 let answer = read_file(answerPath); let table = mc-table(); let book = mc-book-of(mc-meanings(),table);
 let rows = mc-text-codes-in(book,answer);
 let real = and(eq(len(rows),2),and(nsro-valid(rows,book,answer),and(nsro-symbols(nth(head(rows),2),list("offer")),nsro-symbols(nth(nth(rows,1),2),list("offer")))));
 let corpusPath = "form/form-stdlib/locale-rows/symbol-words.rows";
 let corpus = read_file(corpusPath); let corpusRows = mc-text-codes-in(book,corpus);
 let shared = nsro-find(corpusRows,"گفت");
 let collision = and(eq(len(shared),1),nsro-symbols(nth(head(shared),2),list("say","tell")));
 let rendered = fce-command(str_concat("--text-file ",answerPath));
 let cli = and(ge(str_find(rendered,"byte=1905 surface=پیشنهاد داد",0),0),ge(str_find(rendered,"byte=1938 surface=anbot",0),0));
 let corpusValid = nsro-valid(corpusRows,book,corpus);
 if not(and(real,and(collision,and(corpusValid,cli)))) then form_error("actual codebook lookup contract failed") else 0;
 let observation = json-node-object(list(nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("actual_answer_rows",len(rows)),nsm-n("actual_answer_matches",real),nsm-n("public_cli_matches",cli),nsm-s("locale_corpus",corpusPath),nsm-s("locale_corpus_sha256",nsm-hash(corpus)),nsm-n("locale_match_rows",len(corpusRows)),nsm-n("locale_offsets_and_meanings_valid",corpusValid),nsm-n("shared_surface_one_row_all_meanings",collision),nsm-s("scope","Literal source lookup and public CLI behavior; contextual language choice and answer quality require reading.")));
 frsh-frozen(frsh-path(root,"lookup-observation.json"),json-emit(observation));
 frsh-frozen(frsh-path(root,"lookup-public.json"),json-emit(json-node-object(list(nsm-s("sha256",nsm-hash(rendered)),nsm-s("text",rendered)))));
 print_str(json-emit(observation));
}
