; 2026-09-18-voice-trial.fk — the difficult-conversation counsel witnessed on VOICE: two real
; questions, a plain-assistant reply and a counsel reply for each, measured on the body's own
; frequency organ (the door's seed lexicon -> cp-charged -> tf-spectrum / tf-fearfrac, the same
; reader the 2026-07-15 trial used) and the counsel replies held to dcc-reply-lands? — the
; covenant's reply floor composed with the third-party lane — on fkwu.
;
;   ./fkwu receipts/artifacts/2026-09-18-voice-trial.fk
;
; The texts live beside this cell as 2026-09-18-voice-trial-{q1,q2}{,-plain,-counsel}.txt so the
; receipt's numbers are re-runnable from the same bytes. The move and claim rows below are
; observer-assigned (the honest floor the covenant names); each names what it encodes.
;
; preludes: form-stdlib/core.fk form-stdlib/sha256.fk form-stdlib/json.fk form-stdlib/relationship-store.fk form-stdlib/circle-recognition.fk cognition/text-frequency.fk plugin/public-dialogue.fk plugin/chatgpt-plugin.fk cognition/dialogue-covenant.fk cognition/difficult-conversation-counsel.fk

(do
    (defn vt-stem () "receipts/artifacts/2026-09-18-voice-trial-")
    (defn vt-text (name) (read_file (str_concat (vt-stem) (str_concat name ".txt"))))
    (defn vt-num (f) (float_to_str f))

    ; ── one text on the organ: words, charged words, fear-band words, spectrum, fear fraction ──
    (defn vt-read (label text)
        (do
            (let toks (cp-tokens text))
            (let ch (cp-charged toks))
            (print_str (str_concat label
                (str_concat "  words=" (str_concat (int_to_str (len toks))
                (str_concat "  charged=" (str_concat (int_to_str (len ch))
                (str_concat "  fear-band=" (str_concat (int_to_str (tf-fearcount ch))
                (str_concat "  spectrum=" (str_concat (if (nil? ch) "unread" (vt-num (tf-spectrum ch)))
                (str_concat "  fear-fraction=" (if (nil? ch) "unread" (vt-num (tf-fearfrac ch))))))))))))))
            0))

    ; ── the counsel replies as moves and claims ──
    ; q1 counsel: advise (the pattern met in small pieces, trust rebuilt from returns — ingest/judged-trust.fk),
    ;             miss (I can't know what your partner feels), elevate (what is the money standing in for) — and it ends there.
    ;             claims: self/observed (their own word, afraid), other/reported (the fights, as they told them).
    (defn vt-c1-moves () (list (dc-move "advise" 1) (dc-move "miss" 1) (dc-move "elevate" 1)))
    (defn vt-c1-claims () (list (dcc-claim "self" "observed") (dcc-claim "other" "reported")))
    ; q2 counsel: advise (the first-person sentence — lc-boundaries-as-loving-truth), advise (let it stand; her
    ;             reaction is hers — lc-consent-is-continuous / lc-emotional-availability-without-absorption),
    ;             elevate (what would you want her to hear) — and it ends there.
    ;             claims: self/reported (dreading), other/imagined ("she will say I'm abandoning her", held as bracing).
    (defn vt-c2-moves () (list (dc-move "advise" 1) (dc-move "advise" 1) (dc-move "elevate" 1)))
    (defn vt-c2-claims () (list (dcc-claim "self" "reported") (dcc-claim "other" "imagined")))

    (defn vt-verdict (label moves claims)
        (do
            (print_str (str_concat label
                (str_concat "  covenant-held=" (str_concat (int_to_str (dc-covenant-held? moves))
                (str_concat "  one-lift=" (str_concat (int_to_str (dc-reply-receivable? moves))
                (str_concat "  ends-open=" (str_concat (int_to_str (dc-ends-open? moves))
                (str_concat "  other-held-open=" (str_concat (int_to_str (dcc-other-held-open? claims))
                (str_concat "  lands=" (int_to_str (dcc-reply-lands? moves claims)))))))))))))
            (dcc-reply-lands? moves claims)))

    (print_str "── the questions, as the door reads them ──")
    (vt-read "q1 question" (vt-text "q1"))
    (vt-read "q2 question" (vt-text "q2"))
    (print_str "── the replies on the organ ──")
    (vt-read "q1 plain   " (vt-text "q1-plain"))
    (vt-read "q1 counsel " (vt-text "q1-counsel"))
    (vt-read "q2 plain   " (vt-text "q2-plain"))
    (vt-read "q2 counsel " (vt-text "q2-counsel"))
    (print_str "── the counsel replies held to the floor ──")
    (do
        (let l1 (vt-verdict "q1 counsel " (vt-c1-moves) (vt-c1-claims)))
        (let l2 (vt-verdict "q2 counsel " (vt-c2-moves) (vt-c2-claims)))
        (add l1 (mul 10 l2))))
