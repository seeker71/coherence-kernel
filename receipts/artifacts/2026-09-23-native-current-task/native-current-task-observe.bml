// Re-observe the actual repeated answer and its final-stage correction packet.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-current-task-2026-09-23";
 let request = nsm-json(".hearth/native-answer-review-resume-2026-09-23/request.json");
 let original = nsm-json("receipts/artifacts/2026-09-23-native-report-closure/reply-1-strict-candidate.json");
 let raw = read_file(".hearth/code-memory/replies/54872-1790160574627.txt");
 if not(faj-valid(raw)) then form_error("actual resumed reply is not strict JSON") else 0;
 let reply = parse-json("actual-resumed-report",raw);
 let report = oh-get(reply,"report");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let checked = fcap-step(initial,raw,fcaq-checker(request));
 let state = fcap-begin-context(checked);
 let task = fcac-final-task(state,12);
 let packet = parse-json("current-final-task",task);
 if not(and(str_eq(fcap-stage(state),"repair"),str_eq(fcap-string(packet,"failure_evidence"),fcap-evidence(state)))) then form_error("final task lost the actual repair or full failure") else 0;
 let checkpointPath = fcam-path(hearth-code-memory(),fcap-string(request,"resume"),"checkpoint");
 let checkpoint = fcam-read(checkpointPath);
 let contract = fcam-work-scope(initial,json-emit(json-node-array(list(oh-get(request,"checks"),oh-get(request,"report_checks")))));
 if not(fcam-packet-valid(checkpoint,"checkpoint",contract)) then form_error("continuing checkpoint contract failed") else 0;
 let saved = fcam-state-from(checkpoint);
 if not(fcam-state-valid(saved,initial)) then form_error("continuing checkpoint state failed") else 0;
 let evidence = json-node-object(list(nsm-s("schema","native-current-task-observation-v1"),nsm-n("answer_words",fal-count(fcap-string(report,"answer"))),nsm-n("answer_unchanged",str_eq(fcap-string(report,"answer"),fcap-string(oh-get(original,"report"),"answer"))),nsm-n("report_unchanged",str_eq(json-emit(report),json-emit(oh-get(original,"report")))),nsm-n("report_checks_passed",head(fcaq-report-check(node_children(oh-get(request,"report_checks")),json-emit(report)))),nsm-n("source_unchanged",value_eq(fcap-docs(state),fcap-docs(initial))),nsm-s("before_final_notice",frbg-observation(512,512,1024)),nsm-s("after_final_notice",frbg-task-observation(512,512,1024,task)),nsm-n("current_task_bytes",str_len(task)),nsm-s("checkpoint_id",fcap-string(request,"resume")),nsm-s("checkpoint_digest",fcap-string(checkpoint,"digest")),nsm-s("checkpoint_stage",fcap-stage(saved)),nsm-n("checkpoint_replies",fcap-turns(saved)),nsm-n("checkpoint_checks",fcap-checks(saved)),nsm-n("checkpoint_valid",1),nsm-n("model_calls",0),nsm-s("scope","Actual completed public reply; exact native checks and controller handoff. No private generation read and no answer-quality improvement claimed.")));
 fs-mkdir(root);
 nsm-write(nsm-at(root,read_line()),evidence);
 print_str(json-emit(evidence));
}
