// Replay a completed public report amendment through the original checks.
// stdin: prior report path, public amendment path, output directory.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let priorPath = read_line(); let actionPath = read_line(); let root = read_line();
 let priorNode = nsm-json(priorPath);
 let prior = if json-object-has?(priorNode,"report") then oh-get(priorNode,"report") else priorNode;
 let request = nsm-json("receipts/artifacts/2026-09-23-native-current-task/request.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let before = fcap-step(initial,json-emit(json-node-object(list(json-node-pair("report",prior)))),fcaq-checker(request));
 if not(fcap-amendable(before)) then form_error("prior report did not reach amendment repair") else 0;
 let raw = read_file(actionPath);
 let after = fcap-step(before,raw,fcaq-checker(request));
 if not(eq(len(fcap-amendments(after)),1)) then form_error("public amendment was not applied through its actual base") else 0;
 let report = parse-json("amended-report",fcap-report(after));
 let answer = nsm-str(report,"answer");
 let checked = fcaq-report-check(node_children(oh-get(request,"report_checks")),fcap-report(after));
 fs-mkdir(root);
 nag-write(nsm-at(root,"report.json"),fcap-report(after));
 nag-write(nsm-at(root,"answer.txt"),answer);
 let evidence = json-node-object(list(nsm-s("answer_source","local Qwen public report amendment"),nsm-s("public_action",actionPath),nsm-n("before_words",fal-count(nsm-str(prior,"answer"))),nsm-n("after_words",fal-count(answer)),nsm-n("answer_changed",not(str_eq(nsm-str(prior,"answer"),answer))),nsm-n("report_checks_passed",head(checked)),nsm-s("check_observation",nth(checked,1)),nsm-s("stage",fcap-stage(after)),nsm-n("source_unchanged",value_eq(fcap-docs(after),fcap-docs(initial))),nsm-n("native_replay_model_calls",0),nsm-s("scope","Replay of one completed public model action. Model generation cost remains in its owning runtime; source and word checks do not establish semantic quality.")));
 nsm-write(nsm-at(root,"observation.json"),evidence); print_str(json-emit(evidence));
 0;
}
