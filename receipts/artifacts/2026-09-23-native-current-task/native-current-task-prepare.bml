// Carry the owned review checkpoint into its repaired final-task handoff.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-current-task-2026-09-23";
 if fs-exists?(nsm-at(root,"care.json")) then form_error("current-task care already applied; observe its owner") else 0;
 let before = nsm-json(nsm-at(root,"before-stop.json"));
 let after = nsm-json(nsm-at(root,"after-stop.json"));
 if not(and(str_eq(nsm-str(before,"checkpoint_digest"),nsm-str(after,"checkpoint_digest")),eq(nsm-num(after,"checkpoint_valid"),1))) then form_error("checkpoint changed across owned process stop") else 0;
 let previous = nsm-json(".hearth/native-answer-review-resume-2026-09-23/request.json");
 let request = oh-set(previous,"turns",json-node-int(sub(12,nsm-num(after,"checkpoint_replies"))));
 if not(fcaq-request-valid(request)) then form_error("current-task resume request failed original request boundary") else 0;
 let checkpoint = fcam-read(fcam-path(hearth-code-memory(),nsm-str(after,"checkpoint_id"),"checkpoint"));
 if not(str_eq(nsm-str(checkpoint,"digest"),nsm-str(after,"checkpoint_digest"))) then form_error("checkpoint changed before resume preparation") else 0;
 let state = fcam-state-from(checkpoint);
 let task = fcac-final-task(fcap-begin-context(state),12);
 let taskNode = parse-json("current-task-handoff",task);
 let current = str_eq(nsm-str(taskNode,"failure_evidence"),fcap-evidence(state));
 if not(current) then form_error("current-task handoff lost retained failure evidence") else 0;
 let detail = json-node-object(list(nsm-n("answer_words",nsm-num(after,"answer_words")),nsm-n("answer_unchanged",nsm-num(after,"answer_unchanged")),nsm-n("report_checks_passed",0),nsm-s("checkpoint_id",nsm-str(after,"checkpoint_id"))));
 let reading = oh-reading("native-coding",nsm-str(after,"checkpoint_id"),"final-task-handoff",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("current-repair-at-final-stage",detail)),list("restate-current-task"),detail);
 oh-voice(reading); oh-voice(oh-response(reading,"restate-current-task"));
 nsm-write(nsm-at(root,"request.json"),request);
 let evidence = json-node-object(list(nsm-s("schema","native-current-task-care-v1"),nsm-s("checkpoint_id",nsm-str(after,"checkpoint_id")),nsm-s("checkpoint_digest",nsm-str(after,"checkpoint_digest")),nsm-n("completed_replies",fcap-turns(state)),nsm-n("remaining_replies",nsm-num(request,"turns")),nsm-n("current_failure_present",current),nsm-n("current_task_bytes",str_len(task)),nsm-s("final_notice",frbg-task-observation(512,512,1024,task)),nsm-n("old_process_pid",54872),nsm-n("old_process_exit",143),json-node-pair("old_normal_model_release",json-node-null()),nsm-n("old_completed_reply_generated_ids",1444),nsm-s("old_interrupted_generated_ids","exact total unobserved"),nsm-n("checkpoint_mutations",0),nsm-n("model_calls",0),nsm-n("provider_calls",0),nsm-s("quality_scope","Current controller correction is restored at final generation; model use and answer quality remain unobserved.")));
 nsm-write(nsm-at(root,"care.json"),evidence);
 oh-voice(oh-applied(reading,"restate-current-task",json-node-object(list(nsm-n("current_failure_present",current),nsm-n("checkpoint_mutations",0)))));
 let fresh = oh-reading("native-coding",nsm-str(after,"checkpoint_id"),"final-task-handoff",json-node-int(1),json-node-int(current),json-node-int(current),list(),list("continue"),detail);
 oh-voice(oh-set(fresh,"care_of",oh-get(reading,"id")));
 0;
}
