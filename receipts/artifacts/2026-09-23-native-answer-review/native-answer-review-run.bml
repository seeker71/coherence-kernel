// Public code entry owns the review, checkpoint and native model release.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-answer-review-2026-09-23";
 if fs-exists?(nsm-at(root,"started.json")) then form_error("review already admitted; observe its process or resume its retained checkpoint") else 0;
 let requestPath = nsm-at(root,"request.json");
 let request = nsm-json(requestPath);
 if not(fcaq-request-valid(request)) then form_error("prepared review request invalid") else 0;
 let start = host_monotonic_ms();
 nsm-write(nsm-at(root,"started.json"),json-node-object(list(nsm-n("pid",host_pid()),nsm-n("started_unix_ms",now_unix_ms()),nsm-s("request_sha256",nsm-hash(read_file(requestPath))))));
 let result = parse-json("review-result",fcaq-command(str_concat("@",requestPath)));
 nsm-write(nsm-at(root,"result.json"),result);
 let report = nsm-str(result,"report");
 nag-write(nsm-at(root,"report.json"),report);
 let answer = if faj-valid(report) then nsm-str(parse-json("review-report",report),"answer") else "";
 nag-write(nsm-at(root,"answer.txt"),answer);
 let checked = fcaq-report-check(json-array-elements(oh-get(request,"report_checks")),report);
 let observed = json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-s("reason",nsm-str(result,"reason")),nsm-s("checkpoint_id",nsm-str(result,"checkpoint_id")),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("elapsed_ms",sub(host_monotonic_ms(),start)),nsm-n("generated_ids",nsm-num(result,"generated_ids")),nsm-n("injected_ids",nsm-num(result,"injected_ids")),nsm-n("turns",nsm-num(result,"turns")),nsm-n("check_runs",nsm-num(result,"check_runs")),nsm-n("report_checks_passed",head(checked)),nsm-n("words",fal-count(answer)),nsm-n("provider_calls",0),nsm-s("answer_source","local Qwen through ordinary native review")));
 nsm-write(nsm-at(root,"observation.json"),observed); print_str(json-emit(observed));
}
