// Preserve the original enquiry and actual native candidate; request a useful
// revised answer through ordinary checkpointed review, excluded from training.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 let root = ".hearth/native-answer-review-2026-09-23";
 if fs-exists?(nsm-at(root,"request.json")) then form_error("request already prepared; use the retained request") else 0;
 let original = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let draft = read_file("receipts/artifacts/2026-09-23-answer-quality-gap/native-applied-answer.txt");
 let changed = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(fat-find-doc(docs,"answer.md")),draft),"");
 if not(and(eq(fat-exit(changed),0),fcap-readonly-preserved(docs,fat-documents(changed),list("answer.md")))) then form_error("native candidate admission changed original source") else 0;
 let goal = "Give Urs the complete useful answer to the original enquiry in enquiry.txt, revising the actual native draft in answer.md. Preserve all six requested axes, a concrete witnessed native translation example, and the supplied source conditions. The arriving reader observed two gaps in this draft: most sections inventory definitions without showing how they change an interaction or useful next action; the conclusion claims traceability changes felt resonance without evidence for that causal claim. Resolve both through the supplied meanings. Lead with the practical value, explain how each concept changes a response decision, and keep an uncertainty beside the specific claim it affects. Use warmth and direct language. Preserve distinctions between Form graph identity, external file lifetime, vocabulary codes and model decoding. Do not invent a measured out-of-box baseline or hidden model changes. The original answer requirement remains 350-450 whitespace-delimited words including headings. Return report.answer as the complete revised answer string and report.findings as an array naming the concrete semantic changes and remaining limits. Keep process details out of the answer. Source documents are read-only; report checks establish shape and length only. Your actual answer will be read for meaning and usefulness.";
 let reportChecks = parse-json("report-checks","[{\"tool\":\"jq\",\"arguments\":[\".answer | type\"],\"stdout\":\"\\\"string\\\"\\n\"},{\"tool\":\"jq\",\"arguments\":[\".findings | type\"],\"stdout\":\"\\\"array\\\"\\n\"},{\"kind\":\"word-range\",\"field\":\"answer\",\"minimum\":350,\"maximum\":450}]");
 let request = json-node-object(list(nsm-s("mode","review"),nsm-s("review_entry","direct"),nsm-s("goal",goal),nsm-s("model",fcap-string(original,"model")),nsm-n("context",fcaq-number(original,"context",16384)),nsm-n("turns",fcaq-number(original,"turns",6)),nsm-n("max_reply_tokens",fcaq-number(original,"max_reply_tokens",1536)),nsm-n("reasoning_tokens",fcaq-number(original,"reasoning_tokens",512)),json-node-pair("documents",fat-wire-documents-node(fat-documents(changed))),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",oh-get(original,"checks")),json-node-pair("report_checks",reportChecks)));
 let sourceCheck = fcaq-check(json-array-elements(oh-get(request,"checks")),fat-documents(changed));
 let completed = oh-set(request,"reasoning_answer_tokens",json-node-int(fcaq-number(original,"reasoning_answer_tokens",1024)));
 print_str(json-emit(json-node-object(list(nsm-n("initial_request_valid",fcaq-request-valid(request)),nsm-n("initial_reasoning_valid",fcaq-reasoning-valid(request)),nsm-n("source_checks_passed",head(sourceCheck)),nsm-n("complete_request_valid",fcaq-request-valid(completed)),nsm-n("answer_reserve",fcaq-number(completed,"reasoning_answer_tokens",0))))));
 if not(and(fcaq-request-valid(completed),head(sourceCheck))) then form_error("native review request or original source checks failed") else 0;
 fs-mkdir(root); nsm-write(nsm-at(root,"request.json"),completed);
 let cost = ftc-read(); nsm-write(nsm-at(root,"previous-turn-cost.json"),cost);
 print_str(json-emit(json-node-object(list(nsm-s("request",nsm-at(root,"request.json")),nsm-s("model",fcap-string(request,"model")),nsm-n("context",fcaq-number(request,"context",0)),nsm-n("turns",fcaq-number(request,"turns",0)),nsm-n("draft_words",fal-count(draft)),nsm-s("enquiry_sha256",fat-document-sha(fat-find-doc(fat-documents(changed),"enquiry.txt"))),nsm-s("continuity","ordinary managed review; reports excluded from weight training"),nsm-n("provider_calls",0),json-node-pair("previous_completed_coordinator_turn",cost)))));
}
