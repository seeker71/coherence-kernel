// Carry actual sources and observed feedback into the response composition door.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-cli-generate-command.bml
section [form.bml] {
 let oldRoot = ".hearth/native-final-capacity-2026-09-23";
 let root = ".hearth/native-compose-2026-09-23";
 if fs-exists?(nsm-at(root,"prompt.txt")) then form_error("composition enquiry already prepared; observe its owner") else 0;
 let request = nsm-json(nsm-at(oldRoot,"request.json"));
 let result = nsm-json(nsm-at(oldRoot,"result.json"));
 if not(and(str_eq(nsm-str(result,"status"),"complete"),eq(nsm-num(result,"release_ok"),1))) then form_error("preceding review must finish and release") else 0;
 let report = parse-json("actual-native-review",nsm-str(result,"report"));
 let docs = fat-wire-value(fat-wire-documents(request));
 let draft = nth(fat-find-doc(docs,"answer.md"),2);
 let source = nth(fat-find-doc(docs,"enquiry.txt"),2);
 let copied = str_eq(fat-trim(nsm-str(report,"answer")),fat-trim(draft));
 if not(and(copied,str_eq(nsm-str(report,"verdict"),"reject"))) then form_error("expected observed unchanged rejected draft unavailable") else 0;
 let instruction = "Compose a complete response to Urs's original enquiry from the supplied sources. Return the answer itself in prose, 350-450 words including any headings, aiming near 400. Lead with practical value in this conversation. Urs said the earlier response 'does not feel embodied, centered, fully grounded and radient' and was 'being quite behind a shield of pretending to understand'. Urs named two independent paths: improving Form's native responses and grounding the arriving mind in Form's context and tools. The latest direction is 'focus on the gap'. Show how receiving that correction changes the next supported action and how native evidence changes a claim. Let the six requested axes explain useful response decisions. Preserve referenced-cell persistence, unreferenced reclamation, external-file lifetime, and the distinction between graph identity, vocabulary codes and model token IDs. Use an actual supplied translation example. Keep uncertainty local to the claim it affects. Felt resonance remains Urs's report; source checks do not establish it. The native review below assessed an earlier draft and named concrete omissions. Apply the useful feedback while composing this answer. The deliverable is a response to Urs, not another assessment of the earlier draft.\n\nNATIVE REVIEW FEEDBACK (attributed local-model assessment, not new source facts):\n";
 let prompt = str_concat(instruction,str_concat(nsm-str(report,"reason"),str_concat("\n\nORIGINAL ENQUIRY AND SOURCE TEXT, PRESERVED VERBATIM:\n",source)));
 if ge(str_find(prompt,fat-trim(draft),0),0) then form_error("earlier draft leaked into composition context") else 0;
 let parsed = fgc-request(str_concat("--tokens 2048 --reasoning 512 --words 350:450 ",prompt));
 if not(str_eq(nth(parsed,1),prompt)) then form_error("composition options changed the enquiry bytes") else 0;
 fs-mkdir(root);
 nag-write(nsm-at(root,"prompt.txt"),prompt);
 let fileRequest = fgc-request(str_concat("--tokens 2048 --reasoning 512 --words 350:450 --prompt-file ",nsm-at(root,"prompt.txt")));
 if not(value_eq(parsed,fileRequest)) then form_error("file-backed CLI request differs from exact inline request") else 0;
 let evidence = json-node-object(list(nsm-s("scope","response composition through ordinary generate; prior review and source assertions retained separately"),nsm-n("prior_answer_copies_draft",copied),nsm-s("prior_report_verdict",nsm-str(report,"verdict")),nsm-s("native_feedback",nsm-str(report,"reason")),nsm-s("source_sha256",nsm-hash(source)),nsm-s("prompt_sha256",nsm-hash(prompt)),nsm-n("prompt_bytes",str_len(prompt)),nsm-n("file_request_matches_inline",1),nsm-n("draft_absent",1),nsm-n("provider_calls",0)));
 nsm-write(nsm-at(root,"preparation.json"),evidence);
 let reading = oh-reading("native-response","compose-2026-09-23","useful-composition",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("response-composition",evidence)),list("compose-response"),json-node-object(list(nsm-n("prior_report_checks_passed",1),nsm-n("prior_answer_copies_draft",copied))));
 oh-voice(reading); oh-voice(oh-response(reading,"compose-response"));
 oh-voice(oh-applied(reading,"compose-response",json-node-object(list(nsm-s("prompt_path",nsm-at(root,"prompt.txt")),nsm-n("file_request_matches_inline",1)))));
 print_str(json-emit(evidence));
}
