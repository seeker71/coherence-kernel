// Count actual public report text with the answering model's tokenizer.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 def nrps-ids(path,text) {
  let cursor = qtlc-open(path,qsx-seal-line(path),list(qtlc-text-segment(text)));
  if not(str_eq(qtlc-status(cursor),"open")) then form_error("indexed tokenizer unavailable") else 0;
  let result = qtlc-drain(cursor);
  if not(str_eq(head(result),"done")) then form_error("indexed tokenizer incomplete") else nth(result,1);
 }
 let path = mr-path(mr-find("qwen38-q8"));
 let src = fcmg-src(path);
 let reportPath = "receipts/artifacts/2026-09-23-native-composition-floor/completed-native-report.json";
 let reportText = read_file(reportPath);
 if not(faj-valid(reportText)) then form_error("completed public report unavailable") else 0;
 let report = parse-json("public-report",reportText);
 let answer = nsm-str(report,"answer");
 let action = json-emit(json-node-object(list(json-node-pair("report",report))));
 let answerIds = nrps-ids(path,answer);
 let reportIds = nrps-ids(path,action);
 if not(and(str_eq(ftdb-text(src,answerIds),answer),str_eq(ftdb-text(src,reportIds),action))) then form_error("public report tokenization did not roundtrip") else 0;
 let row = json-node-object(list(nsm-s("scope","actual retained complete report encoded as a full submission, with stale findings retained; not the failed private generation"),nsm-s("model","qwen38-q8"),nsm-s("report_path",reportPath),nsm-s("report_sha256",nsm-hash(reportText)),nsm-n("answer_words",fal-count(answer)),nsm-n("answer_ids",len(answerIds)),nsm-n("full_report_action_ids",len(reportIds)),nsm-n("fits_1024_text_ids",le(len(reportIds),1024)),nsm-n("model_calls",0),nsm-n("provider_calls",0)));
 nsm-write(".hearth/native-source-first-2026-09-23/public-report-size.json",row);
 print_str(json-emit(row));
}
