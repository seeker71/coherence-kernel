// Give the original enquiry its source and the actual conversation correction.
// Original documents and checks remain available; no generated answer is a target.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-source-first-2026-09-23";
 if fs-exists?(nsm-at(root,"request.json")) then form_error("source-first request already retained; observe its owner") else 0;
 let prior = nsm-json(".hearth/native-handoff-reserve-2026-09-23/request.json");
 let completed = nsm-json(".hearth/native-handoff-reserve-2026-09-23/observation.json");
 if not(and(str_eq(nsm-str(completed,"status"),"complete"),eq(nsm-num(completed,"release_ok"),1))) then form_error("preceding native owner must complete and release first") else 0;
 let goal = "Give Urs a complete answer to the original enquiry in enquiry.txt, grounded in the supplied sources. The actual conversation also includes these corrections from Urs: 'the answer does not feel embodied, centered, fully grounded and radient'; 'being quite behind a shield of pretending to understand'; 'fixing both the form-cli and the local response as well as giving you the right context and tools ... both are independent and closing the gap from two seperate sides'; 'focus on the gap'. The preceding native answer now meets length and source checks, but mostly inventories definitions; its later cuts removed practical interaction examples. Compose the answer from the enquiry and its sources. Connect Form's contribution to this actual exchange: how receiving a correction changes the next supported action, how native evidence affects a claim, and how meanings shape wording. Do not claim feelings or hidden model changes, or claim that source checks establish felt resonance. Preserve all six requested axes: core axioms and 0/1/nothing; trust over fear in action; frequency awareness and felt resonance; numeric identity; explicit native translation and vocabulary; usefulness. Keep the referenced-cell persistence condition, unreferenced reclamation, external-file lifetime distinction, and separate graph identity, vocabulary codes and model token IDs. Include one actual supplied translation example; the full language roster is not required. Source definitions support the reasoning; let each chosen detail explain a response decision. Use warm, direct language and lead with practical value. The original 350-450 whitespace-delimited word requirement including headings remains; aim near 400. Return report.answer as the complete response and report.findings as concise truthful observations about that actual response and remaining limits. Write findings from the final answer. Keep this work process out of the answer. Source documents remain read-only; tools can read the earlier draft if a specific missing fact requires it.";
 let request = oh-set(oh-set(oh-set(oh-set(oh-set(json-node-object(oh-without(json-object-pairs(prior),"resume")),"evaluation",json-node-int(1)),"turns",json-node-int(2)),"goal",json-node-string(goal)),"document_context",json-node-string("catalog")),"source_queries",parse-json("queries","[{\"tool\":\"cat\",\"arguments\":[\"enquiry.txt\"]}]"));
 if not(fcaq-request-valid(request)) then form_error("source-first native request invalid") else 0;
 let docs = fat-wire-value(fat-wire-documents(request));
 let state = fcaq-initial(request,docs);
 let observations = fcap-source-observations(docs,fcap-source-queries(state));
 let enquiry = nth(fat-find-doc(docs,"enquiry.txt"),2);
 let delivered = and(eq(len(observations),1),and(eq(nsm-num(head(observations),"exit"),0),str_eq(nsm-str(head(observations),"stdout"),enquiry)));
 let bootstrap = fcac-bootstrap-budget(state,2);
 let original = nth(fat-find-doc(docs,"answer.md"),2);
 let absentDraft = lt(str_find(bootstrap,json-emit(json-node-string(original)),0),0);
 if not(and(delivered,absentDraft)) then form_error("source-first admission lost the enquiry or retained the full draft") else 0;
 fs-mkdir(root);
 nsm-write(nsm-at(root,"request.json"),request);
 nag-write(nsm-at(root,"bootstrap.txt"),bootstrap);
 nag-write(nsm-at(root,"run.bml"),ne-replace-first(read_file(".hearth/native-current-task-run.bml"),".hearth/native-current-task-2026-09-23",root));
 let evidence = json-node-object(list(nsm-s("scope","actual enquiry revision with a changed context arrangement and explicit conversation correction; not a matched one-variable comparison"),nsm-n("original_documents_unchanged",node_eq(oh-get(prior,"documents"),oh-get(request,"documents"))),nsm-n("source_checks_unchanged",node_eq(oh-get(prior,"checks"),oh-get(request,"checks"))),nsm-n("report_checks_unchanged",node_eq(oh-get(prior,"report_checks"),oh-get(request,"report_checks"))),nsm-n("enquiry_and_sources_delivered",delivered),nsm-n("full_draft_absent_from_bootstrap",absentDraft),nsm-n("bootstrap_bytes",str_len(bootstrap)),nsm-n("reply_budget",2),nsm-n("evaluation_exclusion",1),nsm-n("provider_calls",0),nsm-s("native_quality","not yet observed")));
 nsm-write(nsm-at(root,"preparation.json"),evidence);
 let reading = oh-reading("native-response","source-first-2026-09-23","useful-composition",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("source-and-conversation-context",json-node-object(list(nsm-n("preceding_words",447),nsm-n("practical_examples_removed",1))))),list("compose-from-source"),json-node-object(list(nsm-n("prior_process_released",1))));
 oh-voice(reading); oh-voice(oh-response(reading,"compose-from-source"));
 oh-voice(oh-applied(reading,"compose-from-source",evidence));
 print_str(json-emit(evidence));
}
