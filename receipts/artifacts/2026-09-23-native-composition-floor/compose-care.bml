// One offered resource repairs the actual completed native response failure.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root = ".hearth/native-compose-care-2026-09-23";
 let generation = ".hearth/response-sessions/generation/83711-1790170659027";
 let observed = nsm-json(nsm-at(generation,"report.json"));
 if not(and(eq(nsm-num(observed,"release_ok"),1),and(eq(nsm-num(observed,"complete"),1),eq(nsm-num(observed,"word_range_passed"),0)))) then form_error("completed released native word-range failure required") else 0;
 fs-mkdir(root);
 let original = nsm-json(".hearth/native-final-capacity-2026-09-23/request.json");
 let feedback = "Compose the complete response to Urs requested by this goal, applying corrections rather than returning the old draft with a review of it. The actual ordinary native generate path returned 843 words and its one shortening pass also returned 843 words. Its response addresses Urs's correction but makes unsupported applications: it asserts that this particular exchange persists as graph cells without an observed graph operation or identity, and declares 'I removed the shield' without Urs reporting that result. Preserve the general cell identity and reference lifetime conditions while distinguishing them from this conversation's observed storage. Receiving a correction should lead to a concrete supported action; name the two independent paths of native response improvement and enrichment of the arriving mind. Show practical value through that connection. Keep a single actual translation example and the six requested axes. Avoid repeated language rosters and repeated distinctions. Give Urs a warm, direct answer near 400 words under the unchanged 350-450 requirement. Return report.answer as the completed response, with concise findings describing that actual response and its remaining limits. This feedback is Codex's reading of the public native answer, not an automated semantic verdict. No response in this packet proves felt resonance.";
 let assessment = oh-set(original,"goal",json-node-string(str_concat(nsm-str(original,"goal"),str_concat("\nCURRENT OBSERVED RESPONSE FAILURE AND CARE:\n",feedback))));
 let before = read_file(nsm-at(generation,"before-length-check.txt"));
 let after = read_file(nsm-at(generation,"answer.txt"));
 let firstReport = json-emit(json-node-object(list(nsm-s("answer",before),json-node-pair("findings",json-node-array(list())))));
 let finalReport = json-emit(json-node-object(list(nsm-s("answer",after),json-node-pair("findings",json-node-array(list())))));
 let firstPath = nsm-at(root,"native-before.json"); let finalPath = nsm-at(root,"native-after.json");
 frsh-frozen(firstPath,firstReport); frsh-frozen(finalPath,finalReport);
 if not(and(head(frr-source(assessment)),not(head(frr-report(assessment,finalReport))))) then form_error("original source checks and actual failed answer check required") else 0;
 let provider = json-node-object(list(json-node-pair("allowed",json-node-bool(1)),nsm-s("interface","codex-exec"),nsm-n("max_processes",1),nsm-n("seconds",0)));
 let request = json-node-object(list(nsm-s("id","native-compose-care-2026-09-23"),json-node-pair("assessment",assessment),json-node-pair("local_reports",json-node-array(list(json-node-string(firstPath),json-node-string(finalPath)))),json-node-pair("provider",provider)));
 if not(frr-valid(request)) then form_error("native composition care request invalid") else 0;
 frsh-frozen(nsm-at(root,"request.json"),json-emit(request));
 let evidence = json-node-object(list(nsm-s("scope","actual completed public native answers wrapped losslessly as answer strings; empty findings arrays are structural containers, not model reviews"),nsm-n("initial_words",fal-count(before)),nsm-n("final_words",fal-count(after)),nsm-n("answers_equal",str_eq(before,after)),nsm-s("before_sha256",nsm-hash(before)),nsm-s("after_sha256",nsm-hash(after)),nsm-n("original_sources_unchanged",node_eq(oh-get(original,"documents"),oh-get(assessment,"documents"))),nsm-n("original_checks_unchanged",and(node_eq(oh-get(original,"checks"),oh-get(assessment,"checks")),node_eq(oh-get(original,"report_checks"),oh-get(assessment,"report_checks"))))));
 frsh-frozen(nsm-at(root,"before.json"),json-emit(evidence));
 let reading = oh-reading("native-response","compose-care-2026-09-23","useful-complete-answer",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("offered-response-repair",evidence)),list("request-offered-resource"),evidence);
 oh-voice(reading); oh-voice(oh-response(reading,"request-offered-resource"));
 let result = frr-run(request);
 frsh-frozen(nsm-at(root,"result.json"),json-emit(result));
 oh-voice(oh-applied(reading,"request-offered-resource",json-node-object(list(nsm-s("result_path",nsm-at(root,"result.json"))))));
 print_str(json-emit(result));
}
