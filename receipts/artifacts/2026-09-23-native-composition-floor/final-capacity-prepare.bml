// Resolve an observed final-output ceiling while preserving the task contract.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let priorRoot = ".hearth/native-source-first-2026-09-23";
 let root = ".hearth/native-final-capacity-2026-09-23";
 if fs-exists?(nsm-at(root,"request.json")) then form_error("capacity correction already prepared; observe its existing owner") else 0;
 let observed = nsm-json(nsm-at(priorRoot,"observation.json"));
 let prior = nsm-json(nsm-at(priorRoot,"request.json"));
 let log = read_file(nsm-at(priorRoot,"runtime.log"));
 let at = str_find(log,"{\"reply\":2,\"requested_initial_tokens\":",0);
 if lt(at,0) then form_error("actual second-reply stage metadata unavailable") else 0;
 let end = str_find(log,"\n",at);
 if lt(end,at) then form_error("actual stage metadata incomplete") else 0;
 let stage = parse-json("actual-second-stage",substring(log,at,end));
 if not(and(eq(nsm-num(observed,"release_ok"),1),and(str_eq(nsm-str(stage,"generation_reason"),"final-generation-incomplete"),and(eq(nsm-num(stage,"completion_observed"),0),eq(nsm-num(stage,"final_generated_ids"),nsm-num(stage,"effective_answer_tokens")))))) then form_error("released final-token exhaustion required for this correction") else 0;
 let request = oh-set(oh-set(prior,"reasoning_answer_tokens",json-node-int(2048)),"max_reply_tokens",json-node-int(2048));
 if not(fcaq-request-valid(request)) then form_error("corrected final allowance violates request contract") else 0;
 let withoutCaps = json-node-object(oh-without(oh-without(json-object-pairs(prior),"reasoning_answer_tokens"),"max_reply_tokens"));
 let correctedWithoutCaps = json-node-object(oh-without(oh-without(json-object-pairs(request),"reasoning_answer_tokens"),"max_reply_tokens"));
 if not(node_eq(withoutCaps,correctedWithoutCaps)) then form_error("capacity correction changed another request field") else 0;
 fs-mkdir(root);
 nsm-write(nsm-at(root,"request.json"),request);
 nag-write(nsm-at(root,"run.bml"),ne-replace-first(read_file(nsm-at(priorRoot,"run.bml")),priorRoot,root));
 let evidence = json-node-object(list(nsm-s("scope","same task, sources, checks, model, reasoning allowance and reply budget; final-output allowance and its stage cap increased"),nsm-n("previous_final_generated_ids",nsm-num(stage,"final_generated_ids")),nsm-n("previous_final_allowance",nsm-num(stage,"effective_answer_tokens")),nsm-n("new_final_allowance",2048),nsm-n("other_request_fields_unchanged",1),nsm-n("previous_release_ok",nsm-num(observed,"release_ok")),nsm-n("previous_elapsed_ms",nsm-num(observed,"elapsed_ms")),nsm-n("provider_calls",0)));
 nsm-write(nsm-at(root,"preparation.json"),evidence);
 let reading = oh-reading("native-response","final-capacity-2026-09-23","complete-response",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("final-output-capacity",evidence)),list("increase-final-allowance"),evidence);
 oh-voice(reading); oh-voice(oh-response(reading,"increase-final-allowance"));
 oh-voice(oh-applied(reading,"increase-final-allowance",evidence));
 print_str(json-emit(evidence));
}
