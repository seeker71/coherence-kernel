// Compare completed public answers; never read private generation evidence.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 def nlco-replace(text,old,replacement) = if lt(str_find(text,old,0),0) then text else nlco-replace(ne-replace-first(text,old,replacement),old,replacement);
 let root = ".hearth/response-sessions/generation/83711-1790170659027";
 let before = read_file(nsm-at(root,"before-length-check.txt"));
 let after = read_file(nsm-at(root,"answer.txt"));
 let normalized = nlco-replace(nlco-replace(nlco-replace(after,"’","'"),"“","\""),"”","\"");
 let evidence = json-node-object(list(nsm-n("before_words",fal-count(before)),nsm-n("after_words",fal-count(after)),nsm-n("raw_equal",str_eq(before,after)),nsm-n("equal_after_normalizing_three_quote_characters",str_eq(before,normalized)),nsm-s("before_sha256",nsm-hash(before)),nsm-s("after_sha256",nsm-hash(after)),nsm-s("scope","actual complete outputs; normalization is for comparison only and changes no retained response")));
 nsm-write("receipts/artifacts/2026-09-23-native-composition-floor/compose-length-change.json",evidence);
 print_str(json-emit(evidence));
}
