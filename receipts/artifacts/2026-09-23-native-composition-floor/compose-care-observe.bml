// Reuse the actual completed resource; count its returned answer natively.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let request = nsm-json(".hearth/native-compose-care-2026-09-23/request.json");
 let replay = frr-run(request);
 if not(and(eq(nsm-num(replay,"provider_processes_new"),0),eq(nsm-num(replay,"verified_repair"),1))) then form_error("retained provider repair did not recheck without a new call") else 0;
 let report = nsm-json(nsm-str(replay,"answer_path"));
 let answer = nsm-str(report,"answer");
 let process = nsm-json(frsh-path(nsm-str(replay,"evidence"),"process.json"));
 if not(eq(nsm-num(process,"budget_seconds"),0)) then form_error("actual resource used a different supervision mode") else 0;
 let root = "receipts/artifacts/2026-09-23-native-composition-floor";
 nsm-write(nsm-at(root,"compose-care-report.json"),report);
 nag-write(nsm-at(root,"compose-care-answer.txt"),answer);
 let observed = json-node-object(list(nsm-n("words",fal-count(answer)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("budget_seconds",nsm-num(process,"budget_seconds")),json-node-pair("replay",replay),nsm-s("scope","same retained provider answer and usage event, original checks re-run, zero new provider processes; semantic assessment stays separate")));
 nsm-write(nsm-at(root,"compose-care-reobservation.json"),observed);
 print_str(json-emit(observed));
}
