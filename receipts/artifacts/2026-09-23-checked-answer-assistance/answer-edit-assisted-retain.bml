// Retain both provider stages and check the final answer as the original document.
// No model or provider admission.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let first = nsm-json(".hearth/answer-edit-provider.result.json");
 let repair = nsm-json(".hearth/answer-edit-repair.result.json");
 let raw = read_file(nsm-str(repair,"answer_path"));
 let report = parse-json("repaired-report",raw);
 let answer = nsm-str(report,"answer");
 let original = nsm-json(".hearth/answer-edit-reasoning-2026-09-23/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let applied = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(fat-find-doc(docs,"answer.md")),answer),"");
 let checked = fcaq-check(json-array-elements(oh-get(original,"checks")),fat-documents(applied));
 let request = nsm-json(".hearth/answer-edit-repair.request.json");
 let reportChecked = frr-report(frr-assessment(request),raw);
 if not(and(head(checked),head(reportChecked))) then form_error("actual repaired answer still fails its original length or report contract") else 0;
 let manifest = nsm-json(".hearth/answer-edit-provider.manifest.json");
 let originalReport = read_file(".hearth/answer-edit-provider.answer.json");
 let member = head(json-array-elements(oh-get(manifest,"cases")));
 let rebound = oh-set(manifest,"cases",json-node-array(list(oh-set(member,"request",frr-assessment(request)))));
 let recheckedOriginal = frsy-check(rebound,originalReport);
 if not(eq(nsm-num(recheckedOriginal,"assertions_passed"),0)) then form_error("overlong synthesis escaped the new report check") else 0;
 let u1 = oh-get(first,"provider_usage"); let u2 = oh-get(repair,"provider_usage");
 if str_eq(nsm-str(first,"usage_event"),nsm-str(repair,"usage_event")) then form_error("cannot double count a usage event") else 0;
 let observation = json-node-object(list(nsm-s("source","two Form-owned provider processes; zero additional provider calls in this reading"),nsm-n("final_words",fal-count(answer)),nsm-n("original_document_check_passed",head(checked)),nsm-n("report_checks_passed",head(reportChecked)),nsm-n("original_overlong_report_now_refused",1),nsm-n("provider_processes_total",2),nsm-n("provider_tokens_total",add(nsm-num(u1,"input_plus_output_tokens"),nsm-num(u2,"input_plus_output_tokens"))),nsm-n("cached_input_tokens_total",add(nsm-num(u1,"cached_input_tokens"),nsm-num(u2,"cached_input_tokens"))),nsm-n("provider_elapsed_ms_total",add(nsm-num(first,"provider_elapsed_ms"),nsm-num(repair,"provider_elapsed_ms"))),nsm-n("other_documents_preserved",fcap-readonly-preserved(docs,fat-documents(applied),list("answer.md"))),json-node-pair("rechecked_initial_synthesis",recheckedOriginal),nsm-s("quality","Source fidelity and usefulness require reading the answer. Felt resonance and whole-session parity remain unestablished; coordinator cost is additional.")));
 frsh-frozen(".hearth/answer-edit-assisted.answer.json",raw);
 frsh-frozen(".hearth/answer-edit-assisted.answer.txt",answer);
 frsh-frozen(".hearth/answer-edit-assisted.observation.json",json-emit-precise(observation));
 print_str(json-emit-precise(observation));
}
