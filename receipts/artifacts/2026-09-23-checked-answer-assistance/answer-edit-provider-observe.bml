// Recheck the retained provider answer; this cell cannot admit a provider.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let manifest = nsm-json(".hearth/answer-edit-provider.manifest.json");
 let text = json-emit(manifest);
 let root = frsh-path(hearth-response-syntheses(),frsy-identity(manifest,text,frsy-prompt(manifest)));
 let processPath = frsh-path(root,"process.json");
 if not(fs-exists?(processPath)) then form_error("owned synthesis process is not terminal; keep waiting on the same handle") else 0;
 let result = frsy-result(root,manifest,nsm-json(processPath),0);
 let returned = read_file(nsm-str(result,"answer_path"));
 if not(faj-valid(returned)) then form_error("provider returned invalid JSON; retain original outcome") else 0;
 let report = oh-get(head(json-array-elements(oh-get(parse-json("provider-answer",returned),"results"))),"report");
 let answer = nsm-str(report,"answer");
 let original = nsm-json(".hearth/answer-edit-reasoning-2026-09-23/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let existing = fat-find-doc(docs,"answer.md");
 let applied = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(existing),answer),"");
 if not(and(eq(fat-exit(applied),0),str_eq(fat-error(applied),""))) then form_error("returned answer could not be reconstructed under its original guard") else 0;
 let checked = fcaq-check(json-array-elements(oh-get(original,"checks")),fat-documents(applied));
 let request = oh-get(head(json-array-elements(oh-get(manifest,"cases"))),"request");
 let detail = json-node-object(list(
  nsm-s("source","codex-exec-through-native-form"),
  nsm-n("original_documents_identical",node_eq(oh-get(request,"documents"),oh-get(original,"documents"))),
  nsm-s("original_request_sha256",nsm-hash(json-emit(original))),
  nsm-s("original_goal_sha256",nsm-hash(nsm-str(original,"goal"))),
  nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("words",fal-count(answer)),
  nsm-n("original_word_range_passed",head(checked)),nsm-s("original_check_evidence",nth(checked,1)),
  nsm-n("other_documents_preserved",fcap-readonly-preserved(docs,fat-documents(applied),list("answer.md"))),
  nsm-n("provider_processes_for_request",nsm-num(result,"provider_processes_for_request")),
  nsm-n("provider_processes_new",0),json-node-pair("provider_elapsed_ms",oh-get(result,"provider_elapsed_ms")),
  json-node-pair("provider_usage",oh-get(result,"provider_usage")),nsm-s("usage_event",nsm-str(result,"usage_event")),
  nsm-n("process_released",nsm-num(result,"process_released")),nsm-n("source_and_shape_checked",nsm-num(result,"checked")),
  nsm-s("scope","Same source documents and original editing goal; output transport is report.answer. Original document check reruns after native reconstruction. No native-agent completion or semantic parity follows from length and shape.")));
 frsh-frozen(".hearth/answer-edit-provider.result.json",json-emit(result));
 frsh-frozen(".hearth/answer-edit-provider.answer.json",returned);
 frsh-frozen(".hearth/answer-edit-provider.answer.txt",answer);
 frsh-frozen(".hearth/answer-edit-provider.observation.json",json-emit-precise(detail));
 print_str(json-emit-precise(detail));
}
