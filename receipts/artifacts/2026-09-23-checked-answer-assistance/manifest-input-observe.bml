// Observe carrier bytes only; never print or execute the supplied packet.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let line = read_line();
 let file = read_file(".hearth/answer-edit-provider.manifest.json");
 let observation = json-node-object(list(nsm-n("stdin_bytes",if nothing?(line) then 0 else str_len(line)),nsm-n("file_bytes",str_len(file)),nsm-n("stdin_valid_json",if nothing?(line) then 0 else faj-valid(line)),nsm-n("file_valid_json",faj-valid(file)),nsm-n("same_bytes",if nothing?(line) then 0 else str_eq(line,file)),nsm-n("provider_processes",0)));
 nsm-write(".hearth/manifest-input-observation.json",observation); print_str(json-emit(observation));
}
