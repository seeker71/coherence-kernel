// Bind the already requested word range to the actual retained report.
// This preparation admits no model or provider.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let manifest = nsm-json(".hearth/answer-edit-provider.manifest.json");
 let prior = oh-get(head(json-array-elements(oh-get(manifest,"cases"))),"request");
 let returned = nsm-json(".hearth/answer-edit-provider.answer.json");
 let report = oh-get(head(json-array-elements(oh-get(returned,"results"))),"report");
 let range = parse-json("answer-word-range","{\"kind\":\"word-range\",\"field\":\"answer\",\"minimum\":350,\"maximum\":450}");
 let checks = json-node-array(append(json-array-elements(oh-get(prior,"report_checks")),list(range)));
 let assessment = oh-set(prior,"report_checks",checks);
 let failed = frr-report(assessment,json-emit(report));
 if not(and(fcaq-request-valid(assessment),and(head(frr-source(assessment)),not(head(failed))))) then form_error("actual report length failure required") else 0;
 frsh-frozen(".hearth/answer-edit-provider.report.json",json-emit(report));
 let request = json-node-object(list(nsm-s("id","answer-edit-length-repair-2026-09-23"),json-node-pair("assessment",assessment),json-node-pair("local_reports",json-node-array(list(json-node-string(".hearth/answer-edit-provider.report.json")))),json-node-pair("provider",oh-get(manifest,"provider"))));
 if not(frr-valid(request)) then form_error("repair request invalid") else 0;
 frsh-frozen(".hearth/answer-edit-repair.request.json",json-emit(request));
 let observation = json-node-object(list(nsm-s("prior_answer_source","Form-owned codex-exec synthesis; locally retained provider report, not local-model output"),nsm-n("goal_identical",node_eq(oh-get(prior,"goal"),oh-get(assessment,"goal"))),nsm-n("documents_identical",node_eq(oh-get(prior,"documents"),oh-get(assessment,"documents"))),nsm-s("change","Bind the original 350-450-word requirement to report.answer; retain all previous assertions"),nsm-s("failure",nth(failed,1)),nsm-n("provider_calls_new",0)));
 frsh-frozen(".hearth/answer-edit-repair.before.json",json-emit(observation));
 print_str(json-emit(observation));
}
