// One caller-offered provider repair, owned and deduplicated by Form.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let result = frr-run(nsm-json(".hearth/answer-edit-repair.request.json"));
 frsh-frozen(".hearth/answer-edit-repair.result.json",json-emit(result));
 print_str(json-emit(result));
}
