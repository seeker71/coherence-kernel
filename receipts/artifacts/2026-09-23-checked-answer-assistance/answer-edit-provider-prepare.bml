// Prepare assistance for the same unfinished answer, preserving its inputs.
// No provider admission occurs in this cell.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 class AnswerEditProvider {
  def aep-checks(docs,all) = if nil?(docs) then list() else {
   let args = list(nth(head(docs),1));
   let actual = fat-call(all,"read",args,"");
   if not(and(eq(fat-exit(actual),0),str_eq(fat-error(actual),""))) then form_error("source read failed") else 0;
   cons(json-node-object(list(nsm-s("tool","read"),json-node-pair("arguments",json-node-array(fcap-string-json(args))),nsm-s("stdout",fat-out(actual)))),aep-checks(tail(docs),all));
  };
 }
 let original = nsm-json(".hearth/answer-edit-reasoning-2026-09-23/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let goal = str_concat(nsm-str(original,"goal")," Output transport for this assistance: return the complete revised answer as report.answer, a string, and findings as an array. The document and its original word-range check will be reconstructed and checked in Form. The answer itself carries no process audit.");
 let request = json-node-object(list(nsm-s("mode","review"),nsm-n("evaluation",1),nsm-s("goal",goal),json-node-pair("documents",oh-get(original,"documents")),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",json-node-array(aep-checks(docs,docs))),json-node-pair("report_checks",parse-json("report-shape","[{\"tool\":\"jq\",\"arguments\":[\".answer | type\"],\"stdout\":\"\\\"string\\\"\\n\"},{\"tool\":\"jq\",\"arguments\":[\".findings | type\"],\"stdout\":\"\\\"array\\\"\\n\"}]"))));
 if not(fcaq-request-valid(request)) then form_error("provider review request invalid") else 0;
 if not(head(fcaq-check(json-array-elements(oh-get(request,"checks")),docs))) then form_error("provider source checks failed") else 0;
 let manifest = json-node-object(list(nsm-s("session","answer-edit-assistance-2026-09-23"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","answer-edit"),json-node-pair("request",request)))))),json-node-pair("provider",parse-json("offered-provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}"))));
 if not(frsy-valid(manifest)) then form_error("provider manifest invalid") else 0;
 frsh-frozen(".hearth/answer-edit-provider.manifest.json",json-emit(manifest));
 let identical = node_eq(oh-get(original,"documents"),oh-get(request,"documents"));
 let scope = "same original goal and documents; output transport changes to report.answer; original word-range assertion reruns after native reconstruction";
 print_str(json-emit(json-node-object(list(nsm-n("source_documents_identical",identical),nsm-s("scope",scope),nsm-n("provider_processes_new",0)))));
}
