// Compare view emission with the existing precise primary-node encoder.
// preludes: form-stdlib/bml/json-view.bml
section [form.bml] {
 def check(view) = if str_eq(jv-emit(view),json-emit-precise(jv-materialize(view))) then 1 else form_error("JSON view differs from precise primary encoding");
 def checks(values) = if nil?(values) then 0 else add(check(head(values)),checks(tail(values)));
 let borrowed = jv-node(parse-json("borrowed-export","{\"old\":false,\"keep\":[null,1]}"));
 let escaped = jv-object(list(jv-s("quote\"slash\\line\n","tab\treturn\r雪"),jv-pair("tiny",jv-float(str_to_float("5e-324"))),jv-pair("large",jv-float(str_to_float("1.7976931348623157e308")))));
 let values = list(jv-array(list()),jv-object(list()),jv-array(list(jv-null())),jv-object(list(jv-s("one",""))),escaped,borrowed,jv-overlay(borrowed,list(jv-pair("old",jv-bool(1)),jv-pair("new",escaped))),jv-array(list(jv-bool(0),jv-bool(1),jv-int(-12),escaped,borrowed)));
 print(list("precise-primary-equality",checks(values)));
}
