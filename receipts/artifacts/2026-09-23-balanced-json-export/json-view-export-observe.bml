// Re-emit the complete real retained value; compare all bytes in memory.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/json-view-parse.bml form-stdlib/qwen35-artifact-seal-reader.fk
section [form.bml] {
 let reference = ".hearth/reader-gap-bounded-before.current.json";
 let extent = file_size(reference);
 let seal = qaf-string-hex(saj-file-digest-any-tail(reference,extent));
 if not(and(eq(extent,91369563),eq(str_len(seal),64))) then form_error("retained real export unavailable") else 0;
 print(list("export-input",host_pid(),extent,seal));
 let totalStart = host_monotonic_ms(); let raw = read_file(reference);
 if not(eq(str_len(raw),extent)) then form_error("retained export read incomplete") else 0;
 let value = jvp-parse(raw);
 let parsedMs = sub(host_monotonic_ms(),totalStart);
 print(list("export-parse-complete",parsedMs));
 let start = host_monotonic_ms(); let minted = kernel_stat(53);
 let output = jv-emit(value);
 let elapsed = sub(host_monotonic_ms(),start); let primary = sub(kernel_stat(53),minted);
 let exact = str_eq(raw,output);
 print(list("export-emission-complete",elapsed,str_len(output),exact));
 let finalSeal = qaf-string-hex(saj-file-digest-any-tail(reference,file_size(reference)));
 if not(and(exact,str_eq(seal,finalSeal))) then form_error("actual complete JSON export changed") else 0;
 let report = jv-object(list(jv-s("schema","native-json-view-export-v1"),jv-n("pid",host_pid()),jv-s("source_sha256",seal),jv-n("source_bytes",extent),jv-n("rows",len(jv-items(value))),jv-n("parse_ms",parsedMs),jv-n("emit_ms",elapsed),jv-n("primary_mints",primary),jv-n("complete_bytes_equal",exact),jv-n("output_bytes",str_len(output)),jv-n("provider_calls",0),jv-s("scope","complete retained real JSON array; parsing and emission timed separately; peak RSS and answer quality not measured")));
 let text = jv-emit(report);
 if not(eq(write_file(".hearth/json-view-export-observed.json",text),str_len(text))) then form_error("export observation retention incomplete") else print_str(str_concat(text,"\n"));
}
