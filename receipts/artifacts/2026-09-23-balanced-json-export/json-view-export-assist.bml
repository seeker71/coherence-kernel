// One bounded, Form-owned proposal for the observed JSON aggregate export gap.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 let path = "form/form-stdlib/bml/json-view.bml"; let source = read_file(path);
 let example = fcr-between(read_file("form/form-stdlib/bml/native-table-sources.bml"),"  def nts-text(parts)","  def nts-read(path)");
 let enquiry = "Repair the excessive aggregate allocation in the current JSON-view emitter while preserving its exact public behavior and native runtime.";
 let observation = json-node-object(list(nsm-s("behavior","Emitting the complete array of 2304 real retained JSON views did not finish before the observed process reached 54877200 KiB RSS. Its read stage had already completed in 202007 ms. The owned process was explicitly terminated with SIGTERM, exit 143. A preceding whole-export process ended with signal 9; that termination cause was not established."),nsm-n("rows",2304),nsm-n("expected_serialized_bytes",91369563),nsm-s("reference","The exact complete JSON array was subsequently retained by emitting each actual row separately, with identical order and separators. This is available locally for full byte comparison; its private contents are not supplied."),nsm-s("causal_scope","The source performs recursively nested concatenation of whole suffixes. This is the code-level explanation to assess; the RSS observation does not independently isolate every allocation.")));
 let domain = json-node-object(list(nsm-s("original_enquiry",enquiry),nsm-s("source_path",path),nsm-s("source_sha256",nsm-hash(source)),nsm-s("source",source),nsm-s("existing_native_balanced_join",example),json-node-pair("observation",observation)));
 let task = "Review the supplied emitter and return the smallest complete BML repair for the observed large-array export. Use existing Form capabilities; no C seed changes or external runtime. Preserve exact JSON bytes, ordering, escaping, precise floating-point formatting, empty collections, overlays, borrowed-node delegation and all existing public function signatures. The supplied balanced composition recipe is an existing native pattern, not a requirement to copy it. Do not execute tools or claim unrun checks. Return answer explaining the cause and remaining limits, findings as an array, and files as an array containing exactly one object with path, original_sha256 copied from the source evidence, and content containing the complete revised source file. Also include verification as a short array of concrete checks. Proposed source is a draft; the caller will run native behavior and actual large-output comparisons.";
 let request = fcr-request(domain,task);
 frsh-frozen(".hearth/json-view-export-review.request.json",json-emit(request));
 let member = json-node-object(list(nsm-s("id","json-view-export"),json-node-pair("request",request)));
 let provider = parse-json("offered-provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}");
 let manifest = json-node-object(list(nsm-s("session","json-view-export-repair-2026-09-23"),json-node-pair("cases",json-node-array(list(member))),json-node-pair("provider",provider)));
 frsh-frozen(".hearth/json-view-export-assist.manifest.json",json-emit(manifest));
 let result = frsy-run(manifest);
 frsh-frozen(".hearth/json-view-export-assist.result.json",json-emit(result));
 print_str(str_concat(json-emit(result),"\n"));
}
