// Retain content-free evidence and correlate the repaired export observation.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-turn-cost.bml form-stdlib/native-session-memory.bml ../observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 let exchange = now_unix_ms();
 let before = bfc-envelope(0,exchange,0,list(143,54877200,2304),nothing());
 bfc-record-out(before,143);
 let control = bfc-control(before,4); bfc-record-in(control,4);
 if not(and(eq(bfc-exchange(control),exchange),eq(bfc-payload(control),4))) then form_error("export evidence request mismatch") else 0;
 let result = nsm-json(".hearth/json-view-export-observed.json");
 if not(and(eq(nsm-num(result,"complete_bytes_equal"),1),eq(nsm-num(result,"output_bytes"),91369563))) then form_error("complete export equality absent") else 0;
 bfc-record-out(bfc-envelope(0,exchange,0,list(nsm-num(result,"parse_ms"),nsm-num(result,"emit_ms"),nsm-num(result,"output_bytes"),nsm-num(result,"primary_mints")),nothing()),0);
 let text = json-emit(ftc-read());
 let path = "receipts/artifacts/2026-09-23-balanced-json-export/preceding-coordinator-cost.json";
 if not(eq(write_file(path,text),str_len(text))) then form_error("coordinator cost retention incomplete") else print(list("export-evidence-retained",path));
}
