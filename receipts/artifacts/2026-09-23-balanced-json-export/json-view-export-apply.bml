// Apply the retained provider proposal only to the exact source it reviewed.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 let answer = nsm-json(".hearth/response-sessions/syntheses/5669f9ada03d58dce2d2ad3e21090ce924a605e7686edb97d0a74159c5ff4f9e/provider-answer.json");
 let results = json-array-elements(json-object-get(answer,"results"));
 if not(eq(len(results),1)) then form_error("proposal result count changed") else 0;
 let result = head(results);
 if not(str_eq(nsm-str(result,"id"),"json-view-export")) then form_error("proposal case changed") else 0;
 let files = json-array-elements(json-object-get(json-object-get(result,"report"),"files"));
 if not(eq(len(files),1)) then form_error("proposal file count changed") else 0;
 let file = head(files); let path = nsm-str(file,"path");
 if not(str_eq(path,"form/form-stdlib/bml/json-view.bml")) then form_error("proposal path changed") else 0;
 let original = read_file(path); let content = nsm-str(file,"content");
 if not(str_eq(nsm-hash(original),nsm-str(file,"original_sha256"))) then form_error("proposal source changed") else 0;
 if not(eq(write_file(".hearth/json-view-export-before.bml",original),str_len(original))) then form_error("original retention incomplete") else 0;
 if not(eq(write_file(path,content),str_len(content))) then form_error("proposal write incomplete") else 0;
 if not(str_eq(read_file(path),content)) then form_error("proposal readback differs") else print(list("proposal-applied",path,nsm-hash(original),nsm-hash(content)));
}
