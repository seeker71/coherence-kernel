// Compare only the public answer stages; the initial reasoning remains private.
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 let root = ".hearth/reasoning-original-enquiry-2026-09-23";
 let report = nsm-json(str_concat(root,"/report.json")); let evidence = nsm-str(report,"private_evidence");
 let stages = nsm-json(nsm-at(evidence,"generation.json"));
 let answer = read_file(nsm-at(evidence,"answer.txt"));
 let prior = read_file(nsm-at(evidence,"before-length-check.txt"));
 let result = json-node-object(list(nsm-n("answer_bytes",str_len(answer)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("revision_text_equal",str_eq(answer,prior)),nsm-n("revision_ids_equal",node_eq(oh-get(oh-get(stages,"final"),"ids"),oh-get(oh-get(stages,"length_revision"),"ids")))));
 nsm-write(str_concat(root,"/comparison.json"),result);
 nsm-write(str_concat(root,"/public-generation.json"),json-node-object(list(json-node-pair("final",oh-get(stages,"final")),json-node-pair("length_revision",oh-get(stages,"length_revision")))));
 let meaning = read_file(nsm-at(root,"admitted-meaning.txt"));
 nsm-write(nsm-at(root,"admitted-meaning.json"),json-node-object(list(nsm-n("bytes",str_len(meaning)),nsm-s("sha256",nsm-hash(meaning)),nsm-s("text",meaning))));
 print_str(json-emit-precise(result));
}
