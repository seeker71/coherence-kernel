// Offer the exact retained example again after the observed memory failure and repair.
// Preserve the first attempt and enter the existing serialized learner queue.
// preflight-exec: forbidden
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 let home = hearth-session-learning();
 let original = nsm-at(home,"rows/2cd6d7ff4e62f68c77d6bd1549d9a3d640e082b4b4e78d391d786b70a200dc90");
 let record = nsm-json(nsm-at(original,"record.json")); let result = nsm-json(nsm-at(original,"result.json"));
 if or(nlw-running(original),or(nsm-withdrawn(original),or(not(str_eq(nsm-str(result,"status"),"refused")),gt(file_size(nsm-at(original,"adapter/native-current")),0)))) then form_error("original attempt is not an inactive refused row without an update") else 0;
 if not(nse-record-valid(record)) then form_error("original retained target is not valid") else 0;
 let example = oh-get(record,"example"); let route = nsm-str(record,"route");
 let outcome = nsm-str(record,"outcome"); let evidence = nsm-str(record,"evidence");
 let positive = str_eq(nsm-str(record,"objective"),"supervised-answer"); let context = nse-context(record);
 let prompt = if positive then nsm-str(example,"prompt") else nsm-str(context,"problem");
 let answer = if positive then nsm-str(example,"completion") else nsm-str(context,"attempt");
 let derived = if positive then nsm-row(prompt,answer) else nsm-row(nsm-experience-prompt(route,prompt,answer),nsm-outcome(route,outcome,evidence));
 if not(node_eq(derived,example)) then form_error("re-offered training target would change") else 0;
 let root = ".hearth/recompute-original-row-2026-09-23"; fs-mkdir(root);
 let reading = oh-reading("session-learning",original,"training-memory",json-node-string("complete original example gradient"),json-node-string("whole-tape admission refused 341213194880 bytes before update"),json-node-int(0),list(oh-need("memory-admitted-full-gradient",oh-reference("form/form-stdlib/native-lora-recompute.bml"))),list("reoffer-after-repair"),oh-reference(nsm-at(original,"train.err")));
 oh-voice(reading); let response = oh-response(reading,"reoffer-after-repair"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"reoffer-after-repair")) then form_error("training care did not correlate") else 0;
 nsm-write(str_concat(root,"/original-result.json"),result);
 nag-write(str_concat(root,"/original-stderr.txt"),nsm-text(nsm-at(original,"train.err")));
 let key = str_concat(nsm-str(record,"event"),":layer-recompute-2026-09-23");
 let offered = nsm-offer(home,nsm-str(record,"session"),key,route,prompt,answer,outcome,evidence,0);
 let report = json-node-object(list(nsm-s("original_row",original),nsm-s("new_row",head(offered)),nsm-s("worker",nth(offered,1)),nsm-n("example_equal",node_eq(example,oh-get(nsm-json(nsm-at(head(offered),"record.json")),"example"))),nsm-s("example_sha256",nsm-hash(json-emit-precise(example))),nsm-s("activation_policy",ntr-activation-policy()),nsm-s("implementation_sha256",nsm-hash(read_file("form/form-stdlib/native-lora-recompute.bml")))));
 nsm-write(str_concat(root,"/offer.json"),report);
 nsm-event(home,"training-memory-reoffer",list(json-node-pair("care",report)));
 oh-voice(oh-applied(reading,"reoffer-after-repair",report));
 print_str(json-emit-precise(report));
}
