// Observe the existing learner without starting or retrying work.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class RecomputeLearningReading {
  def rlr-row(home,id) {
   let dir = nsm-at(home,str_concat("rows/",id)); let result = nsm-json(nsm-at(dir,"result.json"));
   let rows = nld-lines(nsm-text(nsm-at(dir,"train.log")));
   let last = if nil?(rows) then json-node-object(list()) else parse-json("training-progress",head(head(reverse(rows))));
   json-node-object(list(nsm-s("row",id),nsm-s("status",if gt(file_size(nsm-at(dir,"result.json")),0) then nsm-str(result,"status") else if nlw-running(dir) then "training" else "awaiting-learner"),nsm-s("reason",nsm-str(result,"reason")),nsm-n("training_alive",nlw-running(dir)),nsm-n("assessment_prepared",gt(file_size(nsm-at(dir,"before.json")),0)),json-node-pair("latest_training_event",last),nsm-s("stderr",nsm-text(nsm-at(dir,"train.err")))));
  }
 }
 let home = hearth-session-learning(); let state = nsm-state(home);
 let result = json-node-object(list(nsm-n("at_ms",host_monotonic_ms()),nsm-n("worker_alive",nsm-running(home)),nsm-s("worker_status",nsm-worker-state(home)),nsm-n("pending",len(nsm-pending(home,nsm-dirs(home)))),nsm-n("optimizer_step",nsm-num(state,"optimizer_step")),nsm-n("learned_rounds",nsm-num(state,"learned_rounds")),nsm-s("last_row",nsm-str(state,"last_row")),json-node-pair("original_retry",rlr-row(home,"ebb4fc485697b97d8cc475f6686dc11241f13c968dc0feb65b0e2800663451fe")),json-node-pair("teaching",rlr-row(home,"ea36f88dc3deeb412c7959de61b5225b18c12a15f49cb4f0a5e9e3072ee4613e"))));
 let output = read_line();
 if and(not(nothing?(output)),not(str_eq(output,""))) then nsm-write(output,result) else 0;
 print_str(json-emit-precise(result));
}
