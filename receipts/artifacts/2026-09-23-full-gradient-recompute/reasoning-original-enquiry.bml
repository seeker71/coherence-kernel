// Answer the original enquiry through the public generate command's reasoning mode.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 let root = ".hearth/reasoning-original-enquiry-2026-09-23";
 if not(eq(host_dir_mkdir(root),1)) then form_error("original reasoning response already retained") else 0;
 let questionPath = "receipts/artifacts/2026-09-23-response-prompt/question.txt";
 let question = read_file(questionPath);
 if or(nothing?(question),str_eq(question,"")) then form_error("original enquiry unavailable") else 0;
 let prior = nsm-json("receipts/artifacts/2026-09-23-root-closer/prefix.json");
 let model = nsm-str(prior,"model");
 let command = str_concat("--reasoning 1024 --tokens 2048 --words 350:450 ",question);
 let request = fgc-request(command);
 if not(str_eq(nth(request,1),question)) then form_error("public generate changed original enquiry bytes") else 0;
 let source = json-node-object(list(nsm-s("model",model),nsm-s("question_path",questionPath),nsm-s("question_sha256",nsm-hash(question)),nsm-n("question_bytes",str_len(question)),nsm-n("reasoning_allowance",1024),nsm-n("answer_allowance",2048),nsm-n("word_minimum",350),nsm-n("word_maximum",450),nsm-n("concurrent_learner_alive",nsm-running(hearth-session-learning())),nsm-s("concurrent_learner_pid",nsm-text(nsm-at(hearth-session-learning(),"learner.pid")))));
 nsm-write(str_concat(root,"/request.json"),source);
 fgcr-keep(root,"admitted-meaning.txt",fqt-meaning-prefix());
 fgcr-keep(root,"admitted-system.txt",ftl-system-text());
 let reading = oh-reading("native-generation",root,"response-revision",json-node-string("source-faithful complete answer within requested length"),json-node-string("direct-mode correction returned unchanged 635-word answer"),json-node-int(0),list(oh-need("reasoned-native-answer",source)),list("bounded-reasoning-answer"),source);
 oh-voice(reading); let response = oh-response(reading,"bounded-reasoning-answer"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"bounded-reasoning-answer")) then form_error("response care did not correlate") else 0;
 let result = fgc-run-request(fcmr-none(),model,request);
 let detail = nth(result,2);
 nsm-write(str_concat(root,"/report.json"),detail);
 oh-voice(oh-applied(reading,"bounded-reasoning-answer",detail));
 print_str(head(result));
 0;
}
