// Re-enter the exact failed response transcript through fresh prefill.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 class ContinuationReplay {
  def cr-values(nodes) = if nil?(nodes) then list() else cons(node_value(head(nodes)),cr-values(tail(nodes)));
  def cr-ids(node) = cr-values(node_children(json-object-get(node,"ids")));
  def cr-difference(a,b,i) = if and(nil?(a),nil?(b)) then -1 else if or(nil?(a),nil?(b)) then i else if eq(head(a),head(b)) then cr-difference(tail(a),tail(b),add(i,1)) else i;
  def cr-save(root,name,node) = if fgcr-keep(root,name,json-emit-precise(node)) then 1 else form_error("replay evidence retention failed");
 }
 let root = ".hearth/continuation-replay-2026-09-23";
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 if not(eq(host_dir_mkdir(root),1)) then form_error("replay directory already exists") else 0;
 let old = nsm-json("receipts/artifacts/2026-09-23-generation-evidence/response.json");
 let evidence = nsm-json("receipts/artifacts/2026-09-23-generation-evidence/generation.json");
 let original = json-object-get(evidence,"initial"); let revision = json-object-get(evidence,"length_revision");
 let path = nsm-str(old,"model"); let started = host_monotonic_ms();
 if not(eq(qaf-seal-verdict(path),1)) then form_error("replay model seal refused") else 0;
 let src = fcmg-src(path); let crystal = qsx-load(path);
 if not(and(eq(nth(crystal,0),1),mr-wired?(fcmg-arch(src)))) then form_error("replay model or tokenizer unavailable") else 0;
 let prompt = read_file("receipts/artifacts/2026-09-23-response-prompt/question.txt");
 let enquiry = str_concat(prompt,str_concat("\n\n",fal-requirement(nsm-num(old,"word_minimum"),nsm-num(old,"word_maximum"))));
 let text = str_concat(fgcr-response-prompt(enquiry),str_concat("\n",fhm-caller-budget-text(nsm-num(old,"answer_allowance"))));
 if not(str_eq(text,read_file("receipts/artifacts/2026-09-23-response-prompt/after-prompt.txt"))) then form_error("replay prompt bytes differ from retained serving prompt") else 0;
 let drained = qtlc-drain(fcmg-chat-cursor-profile(path,text,nsm-str(old,"profile"),crystal));
 if not(str_eq(head(drained),"done")) then form_error("replay prompt tokenizer incomplete") else 0;
 let promptIds = nth(drained,1); let firstIds = cr-ids(original);
 let notice = read_file(nsm-at(nsm-str(old,"private_evidence"),"length-feedback.txt"));
 if not(str_eq(notice,fal-feedback(nsm-num(old,"initial_words"),nsm-num(old,"word_minimum"),nsm-num(old,"word_maximum")))) then form_error("retained feedback differs from serving feedback") else 0;
 let closed = fcms-crossing-prefix-ids(nsm-num(original,"pending"),q38-stop?(nsm-num(original,"pending"),fcmg-q35-stops(src)),q35-special-id(src,"<|im_end|>"),1);
 let tail = fcmo-direct-tail-ids(path,notice);
 if nothing?(tail) then form_error("replay indexed feedback unavailable") else 0;
 let feedbackIds = append(closed,tail); let allIds = append(promptIds,append(firstIds,feedbackIds));
 let position = add(nsm-num(original,"position"),len(feedbackIds)); let capacity = nsm-num(old,"context");
 if not(and(eq(len(promptIds),nsm-num(old,"prompt_ids")),and(eq(add(len(promptIds),len(firstIds)),nsm-num(original,"position")),and(eq(len(feedbackIds),nsm-num(old,"injected_ids")),and(eq(len(allIds),position),and(gt(capacity,position),le(capacity,fcms-artifact-context-capacity-from-src(src)))))))) then form_error("replay transcript bounds differ") else 0;
 cr-save(root,"prefix.json",json-node-object(list(nsm-s("model",path),nsm-s("profile",nsm-str(old,"profile")),nsm-s("prompt",text),nsm-s("feedback",notice),json-node-pair("prompt_ids",json-node-array(oh-ints(promptIds))),json-node-pair("answer_ids",json-node-array(oh-ints(firstIds))),json-node-pair("feedback_ids",json-node-array(oh-ints(feedbackIds))))));
 let reading = oh-reading("native-generation",root,"continuation-repetition",json-node-string("effective revision of the original answer"),json-node-string("812 generated IDs repeated"),json-node-int(0),list(oh-need("same-transcript-state-comparison",oh-reference("receipts/2026-09-23-generation-evidence.md"))),list("fresh-prefill-identical-transcript"),json-node-object(list(nsm-n("prompt_ids",len(promptIds)),nsm-n("answer_ids",len(firstIds)),nsm-n("feedback_ids",len(feedbackIds)),nsm-n("prefix_ids",len(allIds)))));
 oh-voice(reading); let response = oh-response(reading,"fresh-prefill-identical-transcript"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"fresh-prefill-identical-transcript")) then form_error("replay control uncorrelated") else 0;
 let session = fcms-open-context(path,src,capacity,len(allIds),list(),allIds,0,crystal,1);
 if not(frbg-valid-session(session)) then { fcms-release-ok?(session); form_error(fcms-reason(session)); } else 0;
 let generation = fcms-generate(session,nsm-num(old,"answer_allowance")); let last = fcms-generation-session(generation);
 let released = fcms-release-ok?(last); let ids = fcms-generation-ids(generation); let answer = fcms-generation-text(generation);
 cr-save(root,"generation.json",fgcr-generation-evidence(generation));
 if not(fgcr-keep(root,"answer.txt",answer)) then form_error("replay answer retention failed") else 0;
 let outcome = json-node-object(list(nsm-n("fresh_prefill_ids",len(allIds)),nsm-n("generated_ids",len(ids)),nsm-n("ids_equal_incremental_revision",value_eq(ids,cr-ids(revision))),nsm-n("first_different_id_index",cr-difference(ids,cr-ids(revision),0)),nsm-n("text_equal_incremental_revision",str_eq(answer,nsm-str(revision,"text"))),nsm-n("words",fal-count(answer)),nsm-n("word_range_passed",fal-within(fal-count(answer),nsm-num(old,"word_minimum"),nsm-num(old,"word_maximum"))),nsm-n("pending",fcms-pending(last)),nsm-n("position",fcms-pos(last)),nsm-n("complete",frbg-stopped(last)),nsm-n("release_ok",released),nsm-n("provider_calls",0),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started))));
 cr-save(root,"comparison.json",outcome); oh-voice(oh-applied(reading,"fresh-prefill-identical-transcript",outcome)); print_str(str_concat(json-emit-precise(outcome),"\n"));
 if released then 0 else form_error("replay release incomplete");
}
