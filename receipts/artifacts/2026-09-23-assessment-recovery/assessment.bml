// Re-observe the retained failed row with the same serving model and adapter.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 let home = hearth-session-learning(); let state = nsm-state(home);
 let root = ".hearth/assessment-recovery-2026-09-23"; fs-mkdir(root);
 let id = "2cd6d7ff4e62f68c77d6bd1549d9a3d640e082b4b4e78d391d786b70a200dc90";
 let dir = nsm-at(home,str_concat("rows/",id));
 let rows = json-array-elements(nsm-json(nsm-at(dir,"assessment.json")));
 let failure = json-node-object(list(nsm-s("worker_status",nsm-worker-state(home)),nsm-n("worker_alive",nsm-running(home)),nsm-s("stderr",nsm-text(nsm-at(home,"learner.err"))),nsm-n("optimizer_step",nsm-num(state,"optimizer_step")),nsm-n("pending",len(nsm-pending(home,nsm-dirs(home))))));
 nsm-write(str_concat(root,"/before.json"),failure);
 let adapter = nsl-serving(home); let started = host_monotonic_ms();
 if or(nil?(rows),str_eq(adapter,"")) then form_error("retained assessment or serving adapter unavailable") else {
  print(list("retained-assessment-rows",len(rows),"grading-row",0,"model",nsm-model(),"adapter",adapter));
  let score = head(nsl-grade(nsm-model(),adapter,list(head(rows))));
  let report = json-node-object(list(nsm-s("row",id),json-node-pair("score",score),nsm-n("wall_ms",sub(host_monotonic_ms(),started)),nsm-n("retained_buffers",nth(metal_live(),2)),nsm-n("optimizer_step",nsm-num(nsm-state(home),"optimizer_step")),nsm-n("provider_calls",0)));
  nsm-write(str_concat(root,"/after.json"),report);
  print_str(json-emit-precise(report));
 };
}
