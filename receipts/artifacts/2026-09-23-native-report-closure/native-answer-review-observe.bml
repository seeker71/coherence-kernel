// Recheck completed native review and retain comparable actual answers.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-session.bml form-stdlib/bml/form-cli-turn-cost.bml
section [form.bml] {
 def nar-answer(source,text) = json-node-object(list(nsm-s("source",source),nsm-n("words",fal-count(text)),nsm-s("sha256",nsm-hash(text))));
 let supplied = read_line();
 let root = if or(nothing?(supplied),str_eq(supplied,"")) then ".hearth/native-answer-review-2026-09-23" else supplied;
 if not(fs-exists?(nsm-at(root,"result.json"))) then form_error("native review result is not available; keep observing its owner") else 0;
 let request = nsm-json(nsm-at(root,"request.json"));
 let result = nsm-json(nsm-at(root,"result.json"));
 let checked = frss-recheck(request,result);
 let reportText = nsm-str(result,"report");
 let report = parse-json("native-review-report",reportText);
 let answer = if faj-valid(reportText) then nsm-str(report,"answer") else "";
 let original = read_file("receipts/artifacts/2026-09-23-answer-quality-gap/native-applied-answer.txt");
 let assisted = read_file("receipts/artifacts/2026-09-23-answer-quality-gap/answer-final.txt");
 let codex = read_file("receipts/artifacts/2026-09-23-native-answer-edit/codex-answer.txt");
 let cost = ftc-read();
 let evidence = json-node-object(list(nsm-s("schema","native-answer-revision-observation-v1"),json-node-pair("native_run",nsm-json(nsm-at(root,"observation.json"))),json-node-pair("current_checks",checked),json-node-pair("answers",json-node-array(list(nar-answer("local Qwen prior retained answer",original),nar-answer("local Qwen checkpointed review",answer),nar-answer("prior Form-owned provider synthesis and repair",assisted),nar-answer("context-equipped Codex baseline",codex)))),json-node-pair("local_findings",if faj-valid(reportText) then oh-get(report,"findings") else json-node-null()),json-node-pair("previous_completed_coordinator_turn",cost),nsm-s("comparison_scope","Actual answers to the same original enquiry and supplied sources. Revision drafts, feedback and response paths differ; no matched-session savings or parity claim."),nsm-s("quality_scope","Read returned words for grounding, useful decisions, relevance and warmth. Source preservation, JSON shape and word bounds do not establish semantic quality or felt resonance.")));
 nsm-write(nsm-at(root,"reobservation.json"),evidence);
 print_str(json-emit(evidence));
 print_str("\nNATIVE ANSWER — local Qwen checkpointed review\n");
 print_str(answer);
}
