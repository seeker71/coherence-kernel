// Apply the observed report-envelope care after the old owner exited 143.
// Preserve completed model-reply counts; this replay is native work, not a new
// model answer. The same original source and report checks remain authoritative.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let priorRoot = ".hearth/native-answer-review-2026-09-23";
 let root = ".hearth/native-answer-review-resume-2026-09-23";
 if fs-exists?(nsm-at(root,"care.json")) then form_error("native report care already applied; use its retained resume request") else 0;
 let audit = nsm-json(nsm-at(priorRoot,"checkpoint-audit-after-stop.json"));
 let request = nsm-json(nsm-at(priorRoot,"request.json"));
 let packet = fcam-read(nsm-str(audit,"checkpoint_path"));
 if not(str_eq(fcap-string(packet,"digest"),nsm-str(audit,"packet_digest"))) then form_error("checkpoint changed after the stopped-owner audit") else 0;
 let saved = fcam-state-from(packet);
 let raw = read_file(".hearth/code-memory/replies/50317-1790159228707.txt");
 let checker = fcaq-live-checker(request);
 if not(and(str_eq(fcap-stage(saved),"review"),and(eq(fcap-turns(saved),2),eq(fcap-checks(saved),0)))) then form_error("retained review no longer matches the observed failure") else 0;
 let reading = fcac-syntax-reading(saved,raw,".hearth/code-memory/replies/50317-1790159228707.txt");
 oh-voice(reading); let response = oh-response(reading,"repair-json-delimiter"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,"revise"),"repair-json-delimiter")) then form_error("native report care control did not correlate") else 0;
 let replayed = fcap-step(saved,raw,checker);
 let cared = append(fat-take(replayed,9),cons(fcap-turns(saved),fat-drop(replayed,10)));
 if not(and(str_eq(fcap-stage(cared),"repair"),and(eq(fcap-checks(cared),1),and(eq(len(fcap-json-repairs(cared)),1),and(value_eq(fcap-docs(cared),fcap-docs(saved)),fcap-amendable(cared)))))) then form_error("native report care failed to expose the original content check") else 0;
 fs-mkdir(root);
 if not(fcam-write(nsm-at(root,"before-care.checkpoint.fkb"),packet)) then form_error("checkpoint copy failed") else 0;
 if not(fcam-save(cared)) then form_error("repaired checkpoint did not persist") else 0;
 let reread = fcam-read(nsm-str(audit,"checkpoint_path"));
 if not(and(fcam-packet-valid(reread,"checkpoint",fcam-contract(cared)),value_eq(fcam-state-from(reread),cared))) then form_error("repaired checkpoint did not revalidate") else 0;
 let remaining = sub(fcaq-number(request,"turns",0),fcap-turns(cared));
 if le(remaining,0) then form_error("original reply allowance is exhausted") else 0;
 let resume = oh-set(oh-set(request,"resume",json-node-string(fcam-id(cared))),"turns",json-node-int(remaining));
 if not(fcaq-request-valid(resume)) then form_error("original-contract resume request failed") else 0;
 nsm-write(nsm-at(root,"request.json"),resume);
 let evidence = json-node-object(list(nsm-s("checkpoint_id",fcam-id(cared)),nsm-s("before_digest",fcap-string(packet,"digest")),nsm-s("after_digest",fcap-string(reread,"digest")),nsm-n("completed_model_replies_before",fcap-turns(saved)),nsm-n("completed_model_replies_after",fcap-turns(cared)),nsm-n("native_public_reply_replays",1),nsm-n("checks_before",fcap-checks(saved)),nsm-n("checks_after",fcap-checks(cared)),nsm-n("remaining_original_reply_allowance",remaining),nsm-s("stage",fcap-stage(cared)),nsm-s("content_failure",fcap-evidence(cared)),nsm-n("model_calls",0),nsm-n("provider_calls",0),nsm-n("old_process_exit",143),json-node-pair("old_normal_model_release",json-node-null()),nsm-s("interruption_scope","Coordinator ended the verified owner after identical completed failures and a verified controller repair. Its third reply was unfinished; normal model release and exact interrupted token count were not observed.")));
 nsm-write(nsm-at(root,"care.json"),evidence); print_str(json-emit(evidence));
 fcac-syntax-after(saved,raw,cared,reading);
}
