// Read and validate this public review's checkpoint without changing it.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-answer-review-2026-09-23";
 let id = "2ecf7aa4855cb15d44f2892e234f86a4f1fc17d4fa74f361e1a0976022581bb2-50317-1790157976026";
 let request = nsm-json(nsm-at(root,"request.json"));
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let contract = fcam-work-scope(initial,json-emit(json-node-array(list(oh-get(request,"checks"),oh-get(request,"report_checks")))));
 let path = fcam-path(hearth-code-memory(),id,"checkpoint");
 let packet = fcam-read(path);
 if not(fcam-packet-valid(packet,"checkpoint",contract)) then form_error("original review checkpoint identity or contract failed") else 0;
 let saved = fcam-state-from(packet);
 if not(fcam-state-valid(saved,initial)) then form_error("original review checkpoint state failed") else 0;
 let same = str_eq(read_file(".hearth/code-memory/replies/50317-1790158852893.txt"),read_file(".hearth/code-memory/replies/50317-1790159228707.txt"));
 let evidence = json-node-object(list(nsm-s("checkpoint_id",id),nsm-s("checkpoint_path",path),nsm-s("packet_digest",fcap-string(packet,"digest")),nsm-n("contract_valid",1),nsm-n("state_valid",1),nsm-s("stage",fcap-stage(saved)),nsm-n("completed_replies",fcap-turns(saved)),nsm-n("checks",fcap-checks(saved)),nsm-n("repairs",fcap-failures(saved)),nsm-n("first_two_public_replies_identical",same),nsm-s("scope","Read-only checkpoint and public action comparison; no private generation read, no model admission, no checkpoint mutation.")));
 nsm-write(nsm-at(root,read_line()),evidence); print_str(json-emit(evidence));
}
