// Inspect the actual public native review reply; preserve every payload byte.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/native-report-closure-reobserve";
 fs-mkdir(root);
 let raw = read_file("receipts/artifacts/2026-09-23-native-report-closure/reply-1.txt");
 let request = nsm-json("receipts/artifacts/2026-09-23-native-answer-review/request.json");
 let state = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let candidate = fcap-report-closer(state,raw,faj-complete(raw));
 if nothing?(candidate) then form_error("report envelope repair has no candidate for the actual reply") else 0;
 let next = fcap-step(state,raw,fcaq-live-checker(request));
 let report = json-emit(oh-get(parse-json("strict-candidate",candidate),"report"));
 let check = fcaq-report-check(json-array-elements(oh-get(request,"report_checks")),report);
 let words = fal-count(nsm-str(parse-json("candidate-report",report),"answer"));
 let evidence = json-node-object(list(nsm-n("original_bytes",str_len(raw)),nsm-n("candidate_bytes",str_len(candidate)),nsm-n("strict_candidate_valid",faj-valid(candidate)),nsm-n("one_final_brace_only",str_eq(candidate,str_concat(raw,"}"))),nsm-n("answer_words",words),nsm-n("report_check_passed",head(check)),nsm-s("report_check",nth(check,1)),nsm-s("policy_stage",fcap-stage(next)),nsm-n("policy_checks",fcap-checks(next)),nsm-n("policy_tools",fcap-calls(next)),nsm-n("native_json_repairs",len(fcap-json-repairs(next))),nsm-n("source_unchanged",value_eq(fcap-docs(next),fcap-docs(state))),nsm-s("scope","Same actual public reply through the current native policy; shape repair changes only one closing brace. No model admitted.")));
 nsm-write(nsm-at(root,read_line()),evidence); print_str(json-emit(evidence));
 nag-write(nsm-at(root,"reply-1-strict-candidate.json"),candidate);
 nag-write(nsm-at(root,"reply-1-answer.txt"),nsm-str(parse-json("candidate-report",report),"answer"));
}
