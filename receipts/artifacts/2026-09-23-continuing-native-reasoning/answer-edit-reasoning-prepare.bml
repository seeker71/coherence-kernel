// Continue the same real editing work with reasoning available on each reply.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let prior = ".hearth/answer-edit-2026-09-23";
 let root = ".hearth/answer-edit-reasoning-2026-09-23";
 if not(eq(host_dir_mkdir(root),1)) then form_error("reasoning editing request already retained") else 0;
 let original = nsm-json(nsm-at(prior,"request.json"));
 let request = oh-set(oh-set(original,"reasoning_tokens",json-node-int(512)),"reasoning_answer_tokens",json-node-int(1024));
 if not(fcaq-request-valid(request)) then form_error("reasoning editing request invalid") else 0;
 nsm-write(nsm-at(root,"request.json"),request);
 nsm-write(nsm-at(root,"before.json"),json-node-object(list(nsm-s("previous_request_sha256",nsm-hash(nsm-text(nsm-at(prior,"request.json")))),nsm-s("request_sha256",nsm-hash(nsm-text(nsm-at(root,"request.json")))),nsm-n("documents_identical",node_eq(oh-get(original,"documents"),oh-get(request,"documents"))),nsm-n("goal_identical",node_eq(oh-get(original,"goal"),oh-get(request,"goal"))),nsm-n("checks_identical",node_eq(oh-get(original,"checks"),oh-get(request,"checks"))),nsm-n("model_identical",node_eq(oh-get(original,"model"),oh-get(request,"model"))),nsm-n("reply_budget_identical",node_eq(oh-get(original,"turns"),oh-get(request,"turns"))),nsm-n("max_reply_tokens_identical",node_eq(oh-get(original,"max_reply_tokens"),oh-get(request,"max_reply_tokens"))),nsm-s("changed","reasoning_tokens=512; reasoning_answer_tokens=1024; native continuation now opens reasoning"),nsm-s("quality","inspect actual edited answer and completion; runtime checks alone do not establish improvement"))));
 print_str(nsm-text(nsm-at(root,"before.json")));
}
