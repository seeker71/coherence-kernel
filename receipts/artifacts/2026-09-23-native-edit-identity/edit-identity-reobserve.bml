// Reconstruct the two accepted edits at the successful-mutation boundary.
// No model admission or live-process mutation. This is not the whole dialogue.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let supplied = read_line();
 let destination = if or(nothing?(supplied),str_eq(supplied,"")) then ".hearth/edit-identity-current.json" else supplied;
 let root = "receipts/artifacts/2026-09-23-native-edit-identity/";
 let request = nsm-json(str_concat(root,"request.json"));
 let original = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let checker = fcaq-live-checker(request);
 let before = fcap-step(original,read_file(str_concat(root,"first-edit.txt")),checker);
 let raw = read_file(str_concat(root,"accepted-edit.txt"));
 let after = fcap-step(before,raw,checker);
 let current = fat-find-doc(fcap-docs(after),"answer.md");
 let digest = fat-document-sha(current);
 let bootstrap = fcap-bootstrap(fcap-begin-context(after));
 let repeated = fcap-step(after,raw,checker);
 let result = json-node-object(list(
  nsm-s("scope","successful tool acknowledgement and renewed context for the actual accepted edit; no model generation or full dialogue replay"),
  nsm-s("action_sha256",nsm-hash(raw)),nsm-s("before_sha256",fat-document-sha(fat-find-doc(fcap-docs(before),"answer.md"))),
  nsm-s("after_sha256",digest),nsm-n("after_words",fal-count(nth(current,2))),
  nsm-s("success_note",fcap-note(after)),
  nsm-n("success_note_contains_current_identity",ge(str_find(fcap-note(after),digest,0),0)),
  nsm-n("renewed_bootstrap_contains_current_identity",ge(str_find(bootstrap,digest,0),0)),
  nsm-n("stale_action_preserves_documents",value_eq(fcap-docs(after),fcap-docs(repeated))),
  nsm-s("stale_action_failure",fcap-evidence(repeated)),nsm-n("new_provider_calls",0)));
 nsm-write(destination,result); print_str(json-emit(result));
}
