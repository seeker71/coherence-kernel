// Retain the completed public editing result and recheck its actual bytes.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 def nae-result(rows) = if nil?(rows) then form_error("public code result absent") else if not(faj-valid(head(rows))) then nae-result(tail(rows)) else {
  let row = parse-json("public-result",head(rows));
  if str_eq(fcap-string(row,"schema"),"form-native-code-v1") then row else nae-result(tail(rows));
 };
 def nae-other(docs) = if nil?(docs) then list() else if str_eq(nth(head(docs),1),"answer.md") then nae-other(tail(docs)) else cons(head(docs),nae-other(tail(docs)));
 def nae-copy(from,to) = if le(file_size(from),0) then form_error(str_concat("evidence absent: ",from)) else frsh-frozen(to,read_file(from));
 def nae-copies(root,target,names) = if nil?(names) then 1 else { nae-copy(frsh-path(root,head(names)),frsh-path(target,head(names))); nae-copies(root,target,tail(names)); };
 let root = ".hearth/native-absence-review-2026-09-25";
 let terminal = fhn-json(frsh-path(root,"process-result.json"));
 if not(str_eq(fcap-string(terminal,"status"),"0")) then form_error("native process has no successful terminal result; inspect its retained evidence") else 0;
 let job = fcap-string(terminal,"evidence");
 let result = nae-result(reverse(split-on(read_file(fhn-stage-path(job,"code",".out")),"\n")));
 let request = fhn-json(frsh-path(root,"request.json"));
 let originalDocs = fat-wire-value(fat-wire-documents(request));
 let finalDocs = fat-wire-value(fat-wire-documents(result));
 let before = nth(fat-find-doc(originalDocs,"answer.md"),2); let answer = nth(fat-find-doc(finalDocs,"answer.md"),2);
 let allChecks = fcaq-check(node_children(json-object-get(request,"checks")),finalDocs);
 let oldRequest = parse-json("original-request",read_file("receipts/artifacts/2026-09-25-native-answer-edit/request.json"));
 let originalChecks = fcaq-check(node_children(json-object-get(oldRequest,"checks")),finalDocs);
 let process = fhn-json(fhn-stage-path(job,"code",".process.json"));
 let comparison = json-node-object(list(
  nsm-s("status",fcap-string(result,"status")),nsm-s("reason",fcap-string(result,"reason")),nsm-s("report",fcap-string(result,"report")),
  json-node-pair("turns",json-object-get(result,"turns")),json-node-pair("tool_calls",json-object-get(result,"tool_calls")),json-node-pair("repair_attempts",json-object-get(result,"repair_attempts")),json-node-pair("check_runs",json-object-get(result,"check_runs")),
  json-node-pair("generated_ids",json-object-get(result,"generated_ids")),json-node-pair("injected_ids",json-object-get(result,"injected_ids")),json-node-pair("release_ok",json-object-get(result,"release_ok")),json-node-pair("process_elapsed_ms",json-object-get(process,"elapsed_ms")),
  nsm-n("original_words",fal-count(before)),nsm-n("final_words",fal-count(answer)),nsm-n("answer_changed",not(str_eq(before,answer))),nsm-n("all_readonly_documents_unchanged",value_eq(nae-other(originalDocs),nae-other(finalDocs))),
  nsm-n("original_checks_passed",head(originalChecks)),nsm-n("original_and_additional_checks_passed",head(allChecks)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-s("attribution","Codex supplied the counterexamples and scoped requirements; Qwen selected and performed the edits"),
  nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null())));
 let target = "receipts/artifacts/2026-09-25-native-absence-repair"; fs_mkdir(target);
 frsh-frozen(frsh-path(root,"result.json"),json-emit(result)); frsh-frozen(frsh-path(root,"answer.txt"),answer); frsh-frozen(frsh-path(root,"comparison.json"),json-emit(comparison));
 frsh-frozen(frsh-path(root,"current-checks.json"),json-emit(json-node-object(list(nsm-n("passed",head(allChecks)),nsm-s("observation",nth(allChecks,1))))));
 nae-copies(root,target,list("request.json","original-answer.txt","repair-evidence.txt","admitted-context.txt","result.json","answer.txt","comparison.json","current-checks.json","before.json","after.json","diagnostic-before.json","diagnostic-after.json","diagnostic-test-failure.log","coordinator-cost.json"));
 nae-copy(".hearth/native-absence-observe.bml",frsh-path(target,"observe.bml")); nae-copy(".hearth/native-absence-prepare.bml",frsh-path(target,"prepare.bml")); nae-copy(".hearth/native-absence-run.bml",frsh-path(target,"run.bml")); nae-copy(".hearth/native-absence-export.bml",frsh-path(target,"export.bml"));
 nae-copy(".hearth/native-check-diagnostic-observe.bml",frsh-path(target,"diagnostic-observe.bml"));
 frsh-frozen(frsh-path(target,"process.json"),json-emit(json-node-object(list(json-node-pair("state",json-object-get(process,"state")),json-node-pair("returncode",json-object-get(process,"returncode")),json-node-pair("elapsed_ms",json-object-get(process,"elapsed_ms")),json-node-pair("supervision",json-object-get(process,"supervision")),json-node-pair("cleanup",json-object-get(process,"cleanup")),json-node-pair("output_drains",json-object-get(process,"output_drains"))))));
 print_str(json-emit(comparison)); print_str("\n"); print_str(answer);
}
