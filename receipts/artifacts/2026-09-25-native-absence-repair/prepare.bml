// Turn the actual retained review contradiction into a checked editing task.
// Caller-selected findings remain attributed; this is a guided native repair.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nap-absent(quote) = json-node-object(list(nsm-s("tool","rg"),json-node-pair("arguments",json-node-array(list(json-node-string("-F"),json-node-string(quote),json-node-string("answer.md")))),nsm-s("stdout",""),nsm-n("exit",1)));
 def nap-query(path) = json-node-object(list(nsm-s("tool","read"),json-node-pair("arguments",json-node-array(list(json-node-string(path))))));
 let root = ".hearth/native-absence-review-2026-09-25";
 let original = parse-json("original-request",read_file("receipts/artifacts/2026-09-25-native-answer-edit/request.json"));
 let prior = parse-json("completed-native-review",read_file("receipts/artifacts/2026-09-25-native-answer-review/result.json"));
 let found = fat-wire-documents(prior);
 if not(str_eq(fat-wire-error(found),"")) then form_error(fat-wire-error(found)) else 0;
 let docs = fat-wire-value(found); let answer = nth(fat-find-doc(docs,"answer.md"),2);
 let quotes = list("The response is warm, direct, and free of self-assessment.","It lifts the enquiry by connecting ground to direction, leaving the person more grounded, more stretched, and more free.","without permission gates or approval queues","the body chooses the surface that fits the enquiry's plane");
 let checks = append(node_children(json-object-get(original,"checks")),list(nap-absent(nth(quotes,0)),nap-absent(nth(quotes,1)),nap-absent(nth(quotes,2)),nap-absent(nth(quotes,3))));
 let failed = fcaq-check(checks,docs);
 if head(failed) then form_error("the retained counterexample no longer fails") else 0;
 let evidence = str_concat("Caller finding against the completed native review: its acceptance says the text is free of self-assessment, while the answer explicitly praises its own warmth and claims the reader's resulting state. These are claims to remove, not evidence of quality. Also scope trust to action within the requested work, and translation to observed lookup surfaces and your response choice; the sources do not demonstrate automatic context-sensitive translation selection. These judgments are supplied by Codex. The native check below establishes only the first literal counterexample; all original and additional assertions remain required.\n\n",nth(failed,1));
 let completeDocs = append(docs,list(list("caller-findings","repair-evidence.txt",evidence)));
 let goal = "Repair answer.md for the ORIGINAL ENQUIRY in enquiry.txt. The previous native review incorrectly accepted self-assessment; repair-evidence.txt contains the actual contradiction and failed native check. Remove the two closing sentences that praise the response and claim the reader's resulting state. Scope the trust paragraph to acting within the requested work; retain uncertainty where evidence ends. Replace the translation claim of automatic surface selection with a concrete account of how the witnessed alternatives guide this reply, leaving unavailable translations open. Preserve the six axes, factual distinctions, useful substance and unchanged 350-450 word range. Use small guarded edits to the existing answer. All sources are read-only. Native absence checks cover the named old phrases only; read the new wording against these requirements too. The native verify tool supplies exact checks and counts. Final acceptance findings should be at most three concise sentences about the actual edits and remaining scope. This is a caller-guided repair, not independent discovery or an out-of-box comparison.";
 let request = json-node-object(list(nsm-s("goal",goal),nsm-s("mode","code"),nsm-s("code_entry","direct"),nsm-s("model","qwen38-q8"),nsm-s("document_context","catalog"),nsm-n("context",16384),nsm-n("turns",8),nsm-n("max_reply_tokens",512),nsm-n("evaluation",1),json-node-pair("documents",fat-wire-documents-node(completeDocs)),json-node-pair("writable",json-node-array(list(json-node-string("answer.md")))),json-node-pair("checks",json-node-array(checks)),json-node-pair("source_queries",json-node-array(list(nap-query("answer.md"),nap-query("repair-evidence.txt"))))));
 if not(fcaq-request-valid(request)) then form_error(fcaq-request-refusal(request)) else 0;
 frsh-frozen(frsh-path(root,"request.json"),json-emit(request));
 frsh-frozen(frsh-path(root,"input.txt"),str_concat("@",str_concat(root,"/request.json\n")));
 frsh-frozen(frsh-path(root,"original-answer.txt"),answer);
 frsh-frozen(frsh-path(root,"repair-evidence.txt"),evidence);
 frsh-frozen(frsh-path(root,"admitted-context.txt"),fcac-bootstrap-budget(fcaq-initial(request,completeDocs),8));
 print_str(json-emit(json-node-object(list(nsm-s("request",frsh-path(root,"request.json")),nsm-n("original_words",fal-count(answer)),nsm-n("original_checks",len(node_children(json-object-get(original,"checks")))),nsm-n("additional_literal_absence_checks",4),nsm-n("initial_checks_passed",head(failed)),nsm-n("evaluation",1),nsm-s("attribution","caller-selected counterexamples and requirements; native model will select and execute edits")))));
}
