// Observe native absence checking on retained answers; no model call.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def nao-row(label,text,row) {
  let docs = list(list("answer","answer.md",text));
  let observed = fat-call(docs,"rg",fcap-array(row,"arguments"),"");
  let checked = fcaq-check(list(row),docs);
  json-node-object(list(nsm-s("case",label),nsm-s("text_sha256",nsm-hash(text)),nsm-n("native_exit",fat-exit(observed)),nsm-s("native_error",fat-error(observed)),nsm-n("check_passed",head(checked))));
 }
 let phase = read_line();
 if not(fat-has(list("before","after"),phase)) then form_error("choose before or after") else 0;
 let root = ".hearth/native-absence-review-2026-09-25"; fs_mkdir(root);
 let row = parse-json("absence", "{\"tool\":\"rg\",\"arguments\":[\"-F\",\"The response is warm, direct, and free of self-assessment.\",\"answer.md\"],\"stdout\":\"\",\"exit\":1}");
 let bad = read_file("receipts/artifacts/2026-09-25-native-answer-review/answer.txt");
 let editorial = read_file("receipts/artifacts/2026-09-25-native-answer-edit/editorial-answer.txt");
 let missing = fcaq-check(list(row),list());
 let record = json-node-object(list(nsm-s("phase",phase),nsm-s("scope","caller-selected literal absence; no general quality or semantic review claim"),nsm-n("admitted",fcaq-check-valid(row)),json-node-pair("cases",json-node-array(list(nao-row("native-411-word-answer",bad,row),nao-row("prior-codex-selected-editorial-answer",editorial,row)))),nsm-n("missing_source_passed",head(missing)),nsm-s("missing_source_observation",nth(missing,1)),nsm-n("model_calls",0)));
 frsh-frozen(frsh-path(root,str_concat(phase,".json")),json-emit(record));
 print_str(json-emit(record));
}
