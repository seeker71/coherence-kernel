// Measure the real failed assertion without exposing or changing its sources.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let phase = read_line();
 if not(fat-has(list("before","after"),phase)) then form_error("choose before or after") else 0;
 let root = ".hearth/native-absence-review-2026-09-25";
 let request = parse-json("retained-request",read_file(frsh-path(root,"request.json")));
 let docs = fat-wire-value(fat-wire-documents(request));
 let observation = fcaq-check(node_children(json-object-get(request,"checks")),docs);
 let text = nth(observation,1);
 let source = nth(fat-find-doc(docs,"enquiry.txt"),2);
 let record = json-node-object(list(nsm-s("phase",phase),json-node-pair("check_passed",json-node-int(head(observation))),nsm-n("diagnostic_bytes",str_len(text)),json-node-pair("whole_enquiry_repeated",json-node-int(ge(str_find(text,json-emit(json-node-string(source)),0),0))),nsm-s("source_sha256",nsm-hash(source)),nsm-s("diagnostic_sha256",nsm-hash(text)),json-node-pair("model_calls",json-node-int(0))));
 frsh-frozen(frsh-path(root,str_concat("diagnostic-",str_concat(phase,".json"))),json-emit(record));
 print_str(json-emit(record));
}
