// Reconstruct public actions against their actual initial candidate and the
// same checker admitted by this process. No model or live-state mutation.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 def aec-observe(state,paths,checker,root,rows) = if nil?(paths) then {
  nsm-write(nsm-at(root,"observed-stages.json"),json-node-array(reverse(rows)));
  print_str(json-emit(json-node-array(reverse(rows))));
 } else {
  let raw = read_file(head(paths)); let next = fcap-step(state,raw,checker);
  let doc = fat-find-doc(fcap-docs(next),"answer.md");
  let check = fcap-source-check(next,checker);
  let row = json-node-object(list(nsm-n("reply",fcap-turns(next)),nsm-s("reply_path",head(paths)),nsm-s("reply_sha256",nsm-hash(raw)),nsm-s("stage",fcap-stage(next)),nsm-n("checks",fcap-checks(next)),nsm-n("tool_calls",fcap-calls(next)),nsm-n("words",fal-count(nth(doc,2))),nsm-n("changed",not(value_eq(fcap-docs(state),fcap-docs(next)))),nsm-n("passed",head(check)),nsm-s("candidate_sha256",fat-document-sha(doc)),nsm-s("observation",fcap-note(next))));
  nag-write(nsm-at(root,str_concat("candidate-after-",str_concat(int_to_str(fcap-turns(next)),".txt"))),nth(doc,2));
  aec-observe(next,tail(paths),checker,root,cons(row,rows));
 };
 let request = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let prior = nsm-json("receipts/artifacts/2026-09-23-reasoning-controller-packet/native-result.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(prior)));
 let checker = fcaq-live-checker(request);
 let state = fcap-before-review(fcap-count-check(initial),fcap-source-check(initial,checker));
 let paths = fcap-strings(json-array-elements(parse-json("completed-actions",read_line())));
 aec-observe(state,paths,checker,".hearth/answer-edit-word-care-2026-09-23",list());
}
