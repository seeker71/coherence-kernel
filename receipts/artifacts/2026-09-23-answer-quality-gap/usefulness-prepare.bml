// Supply the original enquiry and actual assisted draft for one useful revision.
// No Codex baseline or local model output is supplied as an answer to imitate.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let original = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let draft = read_file("receipts/artifacts/2026-09-23-checked-answer-assistance/answer-edit-assisted.answer.txt");
 let changed = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(fat-find-doc(docs,"answer.md")),draft),"");
 if not(and(eq(fat-exit(changed),0),fcap-readonly-preserved(docs,fat-documents(changed),list("answer.md")))) then form_error("assisted draft admission changed original source") else 0;
 let goal = "Revise the actual draft in answer.md to serve the original enquiry in enquiry.txt more fully. Preserve its six requested axes, source conditions, concrete native translation example, and distinctions between graph identity, external file lifetime, vocabulary codes and model token prediction. The original requirement remains 350-450 whitespace-delimited words including headings; aim for 400. The arriving reader's observed quality gap is that the draft mostly inventories definitions and puts limitations before their practical value. Connect each resource to a concrete change in how an interaction proceeds, how a response reasons, or what useful action follows. Explain trust through consistency between words and actions, uncertainty attached to the particular missing evidence, and initiative within the actual request. Use the sources to develop these connections without claiming a measured out-of-box improvement, hidden model changes, or a proven effect on the person's felt resonance. Write warmly, directly and confidently from the available ground. Keep the answer about the enquiry, with no work-process audit. Return report.answer as the complete revised answer string and report.findings as an array of concise semantic changes and remaining limits. A passing word count is not the semantic objective. This is one message-only synthesis; no tools, repository writes, additional inference calls or training.";
 let reportChecks = parse-json("report-checks","[{\"tool\":\"jq\",\"arguments\":[\".answer | type\"],\"stdout\":\"\\\"string\\\"\\n\"},{\"tool\":\"jq\",\"arguments\":[\".findings | type\"],\"stdout\":\"\\\"array\\\"\\n\"},{\"kind\":\"word-range\",\"field\":\"answer\",\"minimum\":350,\"maximum\":450}]");
 let request = json-node-object(list(nsm-s("mode","review"),nsm-n("evaluation",1),nsm-s("goal",goal),json-node-pair("documents",json-node-array(fcap-model-documents(fat-documents(changed)))),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",oh-get(original,"checks")),json-node-pair("report_checks",reportChecks)));
 let manifest = json-node-object(list(nsm-s("session","answer-usefulness-2026-09-23"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","answer-usefulness"),json-node-pair("request",request)))))),json-node-pair("provider",parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}"))));
 print_str(json-emit(json-node-object(list(nsm-n("request_valid",fcaq-request-valid(request)),nsm-n("manifest_valid",frsy-valid(manifest)),nsm-n("sources_valid",frsy-sources(json-array-elements(oh-get(manifest,"cases"))))))));
 if not(and(frsy-valid(manifest),frsy-sources(json-array-elements(oh-get(manifest,"cases"))))) then form_error("usefulness manifest or original source checks failed") else 0;
 fs-mkdir(".hearth/answer-usefulness");
 frsh-frozen(".hearth/answer-usefulness/manifest.json",json-emit(manifest));
 print_str(json-emit(json-node-object(list(nsm-s("source_enquiry_sha256",fat-document-sha(fat-find-doc(fat-documents(changed),"enquiry.txt"))),nsm-s("starting_answer_sha256",nsm-hash(draft)),nsm-n("starting_words",fal-count(draft)),nsm-n("provider_prompt_bytes",str_len(frsy-prompt(manifest))),nsm-n("provider_calls",0)))));
}
