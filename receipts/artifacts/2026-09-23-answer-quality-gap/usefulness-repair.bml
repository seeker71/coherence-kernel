// Repair the actual failed assisted answer through the existing Form-owned door.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root = ".hearth/answer-usefulness";
 if fs-exists?(nsm-at(root,"repair-result.json")) then form_error("repair already retained; inspect its result instead of admitting it again") else 0;
 let manifest = nsm-json(nsm-at(root,"manifest.json"));
 let prior = oh-get(head(json-array-elements(oh-get(manifest,"cases"))),"request");
 let returned = nsm-json(nsm-at(root,"answer.json"));
 let report = oh-get(head(json-array-elements(oh-get(returned,"results"))),"report");
 let observation = " Additional arriving-reader feedback on this actual 480-word answer: keep its useful links from concepts to interaction decisions. Shorten repeated framing and secondary details. Lead with the practical contribution; place each necessary limit beside the claim it qualifies. One or two witnessed translation surfaces suffice for the concrete example. Preserve all six axes, persistence conditions, source distinctions and the original word range.";
 let assessment = oh-set(prior,"goal",json-node-string(str_concat(nsm-str(prior,"goal"),observation)));
 let failed = frr-report(assessment,json-emit(report));
 if not(and(fcaq-request-valid(assessment),and(head(frr-source(assessment)),not(head(failed))))) then form_error("actual failed report and unchanged valid source assertions required") else 0;
 let reportPath = nsm-at(root,"prior-report.json");
 frsh-frozen(reportPath,json-emit(report));
 let request = json-node-object(list(nsm-s("id","answer-usefulness-length-repair-2026-09-23"),json-node-pair("assessment",assessment),json-node-pair("local_reports",json-node-array(list(json-node-string(reportPath)))),json-node-pair("provider",oh-get(manifest,"provider"))));
 if not(frr-valid(request)) then form_error("native repair request invalid") else 0;
 frsh-frozen(nsm-at(root,"repair-request.json"),json-emit(request));
 frsh-frozen(nsm-at(root,"repair-before.json"),json-emit(json-node-object(list(nsm-s("source","locally retained provider report, not local-model output"),nsm-n("documents_identical",node_eq(oh-get(prior,"documents"),oh-get(assessment,"documents"))),nsm-n("source_checks_identical",node_eq(oh-get(prior,"checks"),oh-get(assessment,"checks"))),nsm-n("report_checks_identical",node_eq(oh-get(prior,"report_checks"),oh-get(assessment,"report_checks"))),nsm-s("added_feedback",observation),nsm-s("failure",nth(failed,1)),nsm-n("provider_calls_before_execution",0)))));
 let result = frr-run(request);
 frsh-frozen(nsm-at(root,"repair-result.json"),json-emit(result));
 print_str(json-emit(result));
}
