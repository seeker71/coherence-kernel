// Count both actual provider processes and verify the delivered document.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root = ".hearth/answer-usefulness";
 let first = nsm-json(nsm-at(root,"result.json"));
 let repair = nsm-json(nsm-at(root,"repair-result.json"));
 let raw = read_file(nsm-str(repair,"answer_path"));
 let report = parse-json("repaired-answer",raw); let answer = nsm-str(report,"answer");
 let offered = nsm-json(nsm-at(root,"repair-request.json"));
 let reportCheck = frr-report(frr-assessment(offered),raw);
 let original = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let applied = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(fat-find-doc(docs,"answer.md")),answer),"");
 let checked = fcaq-check(json-array-elements(oh-get(original,"checks")),fat-documents(applied));
 if not(and(head(reportCheck),and(eq(fat-exit(applied),0),head(checked)))) then form_error("actual repaired answer failed original document or report checks") else 0;
 if str_eq(nsm-str(first,"usage_event"),nsm-str(repair,"usage_event")) then form_error("duplicate provider usage identity") else 0;
 let u1 = oh-get(first,"provider_usage"); let u2 = oh-get(repair,"provider_usage");
 let counts = list(nsm-n("provider_calls_total",2),nsm-n("provider_tokens_total",add(nsm-num(u1,"input_plus_output_tokens"),nsm-num(u2,"input_plus_output_tokens"))),nsm-n("cached_input_tokens_total",add(nsm-num(u1,"cached_input_tokens"),nsm-num(u2,"cached_input_tokens"))),nsm-n("provider_elapsed_ms_total",add(nsm-num(first,"provider_elapsed_ms"),nsm-num(repair,"provider_elapsed_ms"))));
 let checks = list(nsm-n("original_word_range_passed",head(checked)),nsm-n("report_checks_passed",head(reportCheck)),nsm-n("other_documents_preserved",fcap-readonly-preserved(docs,fat-documents(applied),list("answer.md"))),nsm-n("first_process_released",nsm-num(first,"process_released")),nsm-n("repair_process_released",nsm-num(oh-get(repair,"check"),"process_released")));
 let identity = list(nsm-s("source","two Form-owned provider calls; no Codex baseline supplied"),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("words",fal-count(answer)),nsm-s("scope","Semantic usefulness requires reading this answer. Felt resonance, native-only parity and matched-session savings remain unestablished; coordinator cost is additional."));
 let observation = json-node-object(append(identity,append(counts,checks)));
 frsh-frozen(nsm-at(root,"answer-final.json"),raw);
 frsh-frozen(nsm-at(root,"answer-final.txt"),answer);
 frsh-frozen(nsm-at(root,"final-observation.json"),json-emit-precise(observation));
 print_str(json-emit-precise(observation));
}
