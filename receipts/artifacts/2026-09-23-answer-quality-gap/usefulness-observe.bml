// Retain the actual provider result and recheck the original document contract.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let root = ".hearth/answer-usefulness";
 let manifest = nsm-json(nsm-at(root,"manifest.json"));
 let owned = frsh-path(hearth-response-syntheses(),frsy-identity(manifest,json-emit(manifest),frsy-prompt(manifest)));
 let processPath = nsm-at(owned,"process.json");
 if not(fs-exists?(processPath)) then form_error("provider process has no terminal result; wait on the same owner") else 0;
 let result = frsy-result(owned,manifest,nsm-json(processPath),0);
 let raw = read_file(nsm-str(result,"answer_path"));
 frsh-frozen(nsm-at(root,"result.json"),json-emit(result));
 frsh-frozen(nsm-at(root,"answer.json"),raw);
 if not(faj-valid(raw)) then form_error("provider JSON invalid; original evidence retained") else 0;
 let report = oh-get(head(json-array-elements(oh-get(parse-json("useful-answer",raw),"results"))),"report");
 let answer = nsm-str(report,"answer");
 let original = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let docs = fat-wire-value(fat-wire-documents(original));
 let applied = fat-call(docs,"edit",list("answer.md","sha256",fat-document-sha(fat-find-doc(docs,"answer.md")),answer),"");
 let checked = fcaq-check(json-array-elements(oh-get(original,"checks")),fat-documents(applied));
 let detail = json-node-object(list(nsm-s("source","Form-owned codex-exec synthesis with original enquiry and arriving semantic feedback; Codex baseline excluded"),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("words",fal-count(answer)),nsm-n("original_word_range_passed",head(checked)),nsm-s("original_check_evidence",nth(checked,1)),nsm-n("other_documents_preserved",fcap-readonly-preserved(docs,fat-documents(applied),list("answer.md"))),nsm-n("source_and_report_checked",nsm-num(result,"checked")),nsm-n("provider_processes_for_request",nsm-num(result,"provider_processes_for_request")),nsm-n("provider_calls_new",0),json-node-pair("provider_usage",oh-get(result,"provider_usage")),json-node-pair("provider_elapsed_ms",oh-get(result,"provider_elapsed_ms")),nsm-s("usage_event",nsm-str(result,"usage_event")),nsm-n("process_released",nsm-num(result,"process_released")),nsm-s("scope","Inspect the actual answer for semantic improvement; no native-only parity, felt-resonance measurement or matched-session cost claim follows from these checks.")));
 frsh-frozen(nsm-at(root,"answer.txt"),answer);
 frsh-frozen(nsm-at(root,"observation.json"),json-emit-precise(detail));
 print_str(json-emit-precise(detail));
 if not(and(eq(fat-exit(applied),0),head(checked))) then form_error("retained answer does not meet the original document contract") else 0;
}
