// Observe public prefix/action evidence from the same live reply, without
// reading private generations or changing the running model's state.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let request = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let prior = nsm-json("receipts/artifacts/2026-09-23-reasoning-controller-packet/native-result.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(prior)));
 let checker = fcaq-live-checker(request);
 let state = fcap-before-review(fcap-count-check(initial),fcap-source-check(initial,checker));
 let first = read_file(".hearth/code-memory/replies/39672-1790155490791.txt");
 let before = fcap-step(state,first,checker);
 let prefix = read_file(".hearth/code-memory/replies/39672-1790155759142.txt");
 let complete = read_file(".hearth/code-memory/replies/39672-1790155812606-2.txt");
 let incomplete = fcap-step(before,prefix,checker);
 let after = fcap-step(before,complete,checker);
 let sound = and(not(faj-valid(prefix)),and(faj-valid(complete),and(eq(str_find(complete,prefix,0),0),and(eq(fcap-calls(incomplete),fcap-calls(before)),and(eq(fcap-calls(after),add(fcap-calls(before),1)),and(value_eq(fcap-docs(before),fcap-docs(after)),str_eq(first,complete)))))));
 if not(sound) then form_error("actual prefix/completion or action boundary differs from observed live care") else 0;
 let transition = json-node-object(list(nsm-s("source","form-code-json-continuation event emitted by the live owner"),nsm-n("position",8665),nsm-n("stop_id",248046),nsm-n("selected_id",1068),nsm-n("prefix_generated_ids",478),nsm-n("remaining_tokens",546),nsm-n("continued_generated_ids",234),nsm-n("total_final_generated_ids",712)));
 let report = json-node-object(list(nsm-s("source","public live reply 2 from PID 39672; no private generation read"),nsm-n("prefix_bytes",str_len(prefix)),nsm-s("prefix_sha256",nsm-hash(prefix)),nsm-n("prefix_json_valid",faj-valid(prefix)),nsm-n("completed_bytes",str_len(complete)),nsm-s("completed_sha256",nsm-hash(complete)),nsm-n("completed_json_valid",faj-valid(complete)),nsm-n("prefix_preserved",1),nsm-n("partial_tool_calls",sub(fcap-calls(incomplete),fcap-calls(before))),nsm-n("completed_tool_calls",sub(fcap-calls(after),fcap-calls(before))),nsm-n("completed_action_identical_to_reply_1",str_eq(first,complete)),nsm-n("documents_changed",not(value_eq(fcap-docs(before),fcap-docs(after)))),nsm-n("words",fal-count(nth(fat-find-doc(fcap-docs(after),"answer.md"),2))),nsm-s("action_observation",fcap-note(after)),json-node-pair("runtime_transition",transition),nsm-s("scope","Same-stream JSON completion was observed. The recovered action is still an unchanged edit; task completion and answer quality remain open.")));
 nsm-write("receipts/artifacts/2026-09-23-answer-quality-gap/live-json-care.json",report);
 print_str(json-emit(report));
}
