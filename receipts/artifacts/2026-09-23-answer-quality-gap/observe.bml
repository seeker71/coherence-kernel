// Compare retained real answers. Counts/hashes are native observations;
// qualitative assessments are explicitly attributed to the arriving reader.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 def aqo-answer(source,path,assessment) {
  let text = read_file(path);
  if le(str_len(text),0) then form_error("retained answer unavailable") else 0;
  let words = fal-count(text);
  json-node-object(list(nsm-s("source",source),nsm-s("path",path),nsm-s("sha256",nsm-hash(text)),nsm-n("words",words),nsm-n("original_range_passed",fal-within(words,350,450)),nsm-s("assessment_source","Codex arriving reader; qualitative judgment, not a measured resonance score"),nsm-s("assessment",assessment)));
 };
 let root = "receipts/artifacts/2026-09-23-answer-quality-gap";
 fs-mkdir(root);
 let answers = list(
  aqo-answer("local Qwen3.8 retained candidate; six replies from 478 words","receipts/artifacts/2026-09-23-reasoning-controller-packet/native-answer.txt","Covers all six axes, distinguishes graph identity from model tokens and host file lifetime, and corrects referenced persistence. Its statement that traceability is what changes resonance asserts an effect not observed in the supplied evidence. Much of the answer restates definitions. The offer paragraph does connect evidence and missing information to an interaction; the other sections need similarly useful connections. The failed length requirement is separate from these semantic findings."),
  aqo-answer("Form-owned provider synthesis after a failed length check","receipts/artifacts/2026-09-23-checked-answer-assistance/answer-edit-assisted.answer.txt","Meets the original range and removes the unsupported traceability-to-resonance conclusion. Preserves six axes and source boundaries. It remains mainly an inventory of definitions, with practical use concentrated in the closing covenant. Its opening foregrounds limitations before showing their value to the enquiry. This is useful source fidelity, not established felt-resonance parity."),
  aqo-answer("context-equipped Codex authored baseline","receipts/artifacts/2026-09-23-native-answer-edit/codex-answer.txt","Connects each group of resources to response decisions: distinguishing absence from rejection, acting within the request, letting failed checks direct repair, keeping uncertainty local, and preserving translation senses. Covers the six axes with a concrete translation example and separates annotation arithmetic from the person's report. This is the arriving reader's assessment of a retained answer; neither an out-of-box baseline nor a blinded quality measurement.")
 );
 let revised = aqo-answer("Form-owned synthesis and measured repair, with original enquiry and arriving semantic feedback","receipts/artifacts/2026-09-23-answer-quality-gap/answer-final.txt","Meets the original range and more often connects concepts to interaction decisions: preserve absence, classify an offered outcome, take initiative within the request, and preserve a witnessed translation sense. Keeps the six axes and persistence conditions. Compared with the previous assisted draft, the practical contribution is clearer. It still repeats limitation language and provides less concrete failed-check counsel than the Codex baseline. This is an attributed reader judgment, not demonstrated overall parity or the person's felt resonance.");
 let allAnswers = append(answers,list(revised));
 let windows = list(json-node-pair("completed_coordinator_turn",nsm-json(".hearth/controller-packet-completed-turn-cost.json")),json-node-pair("local_execution_window",nsm-json("receipts/artifacts/2026-09-23-reasoning-controller-packet/native-report.json")),json-node-pair("new_assisted_execution_window",nsm-json(".hearth/answer-usefulness/final-observation.json")));
 let scope = list(nsm-s("scope","Same original enquiry, four real retained answers, different admitted workflows and starting states. No invented comparison response. No answer is supplied here as a native training target."),nsm-s("cost_scope","These execution windows are not matched end-to-end sessions; do not infer a savings ratio or parity. Count all coordinator input, cached input, output and unattributed tokens. Separate Form-owned provider calls remain separately accounted."),nsm-s("next_quality_observation","Read the current local continuation's actual revised answer against the original enquiry. Check whether meaning changes its explanation and practical decisions, whether the unsupported resonance conclusion remains, and whether it completes its original task. A passed word range alone does not close the gap."));
 let report = json-node-object(append(scope,cons(json-node-pair("answers",json-node-array(allAnswers)),windows)));
 nsm-write(nsm-at(root,"comparison.json"),report);
 print_str(json-emit(report));
}
