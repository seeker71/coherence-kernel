// Re-observe the actual final edit at the plan boundary without admitting a
// model. Reply 5's public path was not retained by the truncated command view.
// The same plan supplied to both boundaries is reply 4's native-authored change,
// selected by Codex. This is a boundary comparison, not a six-reply replay.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 def aqr-replay(state,paths,checker) = if nil?(paths) then state else aqr-replay(fcap-step(state,read_file(head(paths)),checker),tail(paths),checker);
 def aqr-old-plan(s,plan) = fcap-move(s,"split",fcap-docs(s),list(),nth(s,6),plan,"Split into ordered, concrete tasks; avoid unnecessary fragmentation.",fcap-calls(s),nth(s,11));
 def aqr-row(state,initial,checker) {
  let doc = fat-find-doc(fcap-docs(state),"answer.md");
  let check = fcap-source-check(state,checker);
  json-node-object(list(nsm-s("stage",fcap-stage(state)),nsm-n("words",fal-count(nth(doc,2))),nsm-s("answer_sha256",fat-document-sha(doc)),nsm-n("changed",not(value_eq(fcap-docs(state),fcap-docs(initial)))),nsm-n("check_runs",fcap-checks(state)),nsm-n("tool_calls",fcap-calls(state)),nsm-n("range_passed",head(check)),nsm-n("source_failure_open",fcap-source-repair-open(state)),nsm-n("complete",fcap-done(state)),nsm-s("observation",fcap-note(state))));
 }
 let root = "receipts/artifacts/2026-09-23-answer-quality-gap";
 let request = nsm-json("receipts/artifacts/2026-09-23-native-edit-identity/request.json");
 let prior = nsm-json("receipts/artifacts/2026-09-23-reasoning-controller-packet/native-result.json");
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(prior)));
 let checker = fcaq-live-checker(request);
 let repair = fcap-before-review(fcap-count-check(initial),fcap-source-check(initial,checker));
 let paths = list(nsm-at(root,"current-reply-1.txt"),nsm-at(root,"current-reply-2.txt"),nsm-at(root,"current-reply-3.txt"),nsm-at(root,"current-reply-4.txt"));
 let planning = aqr-replay(repair,paths,checker);
 let plan = nsm-str(nsm-json(nth(paths,3)),"change");
 let planReply = json-emit(json-node-object(list(nsm-s("plan",plan))));
 let action = read_file(nsm-at(root,"current-reply-6.txt"));
 let before = fcap-step(aqr-old-plan(planning,plan),action,checker);
 let after = fcap-step(fcap-step(planning,planReply,checker),action,checker);
 if not(and(str_eq(fcap-stage(planning),"plan"),value_eq(nth(planning,5),list(fcap-direct-task())))) then form_error("actual replay did not retain the direct caller task") else 0;
 if not(and(value_eq(fcap-docs(before),fcap-docs(initial)),not(value_eq(fcap-docs(after),fcap-docs(initial))))) then form_error("replan boundary did not isolate the denied versus applied edit") else 0;
 if not(and(eq(fcap-checks(after),add(fcap-checks(before),1)),fcap-readonly-preserved(fcap-docs(initial),fcap-docs(after),fcap-array(request,"writable")))) then form_error("changed edit did not preserve source and invoke the original check") else 0;
 let observation = json-node-object(list(nsm-s("scope","Same retained native action and source contract at old versus repaired direct-plan boundary. Native reply 4 change is the coordinator-selected plan; reply 5 is unavailable. No model admission, no live checkpoint mutation."),nsm-s("selected_plan",plan),nsm-s("action_sha256",nsm-hash(action)),nsm-n("provider_calls",0),nsm-n("model_calls",0),json-node-pair("before",aqr-row(before,initial,checker)),json-node-pair("after",aqr-row(after,initial,checker)),nsm-s("quality","Read the answer separately. Applying the edit and passing a range check do not establish semantic quality or felt resonance.")));
 nag-write(nsm-at(root,"native-applied-answer.txt"),nth(fat-find-doc(fcap-docs(after),"answer.md"),2));
 nsm-write(nsm-at(root,"direct-replan-observation.json"),observation);
 print_str(json-emit(observation));
}
