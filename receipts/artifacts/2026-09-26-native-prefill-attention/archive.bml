// Preserve actual kernel observations, including the first isolated emission
// and the complete runtime shader emission used for the second comparison.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def qpar-keep(root,name,path) {
  let text=read_file(path);
  if nothing?(text) then form_error(str_concat("missing observation: ",path)) else 0;
  frsh-frozen(frsh-path(root,name),json-emit(json-node-object(list(nsm-s("source",path),nsm-n("bytes",str_len(text)),nsm-s("sha256",nsm-hash(text)),nsm-s("text",text)))));
 }
 let root="receipts/artifacts/2026-09-26-native-prefill-attention"; fs-mkdir(root);
 qpar-keep(root,"isolated-emission.json",".hearth/native-source-feedback/attention-check.log");
 qpar-keep(root,"runtime-emission.json",".hearth/native-source-feedback/attention-runtime-check.log");
 qpar-keep(root,"live-process-sample.json",".hearth/native-source-feedback/process.sample.txt");
 print_str("Retained both kernel comparisons and the preceding live process sample. No model call.");
}
