// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-voice.bml
section [form.bml] {
 class PrefillCodeReview {
  def pcr-join(parts) = if nil?(parts) then "" else str_concat(head(parts),pcr-join(tail(parts)));
  def pcr-part(path,first,last) {
   let source = read_file(path);
   let begin = str_find(source,first,0);
   let end = str_find(source,last,add(begin,str_len(first)));
   if or(lt(begin,0),le(end,begin)) then form_error("review source boundary absent") else substring(source,begin,end);
  }
  def pcr-run() {
   let root = ".hearth/prefill-code-review-2026-09-22";
   if not(eq(host_dir_mkdir(root),1)) then form_error("review already admitted; inspect retained work") else 0;
   let packet = pcr-join(list("Review this actual native prefill implementation for correctness. Find actionable bugs, especially failed GPU completion and resource ownership. For each finding name the function, the concrete execution that fails, and the smallest repair. If the supplied source establishes no defect, say so. Do not invent execution results. Review only this source; no tools are available in this model call.\n\n",
    read_file("form/form-stdlib/bml/qwen38-prefill-completion.bml"),
    pcr-part("form/native/metal/qwen35-dense-token-handle.fk","    (defn q38-prefill-sliced-go ","    (defn q38-last-slice-n "),
    pcr-part("form/form-stdlib/form-cli-model-generate.fk","    (defn fcmg-live-prefill-span ","    (defn fcmg-run-context-cursor-budgeted"),
    pcr-part("form/form-stdlib/form-cli-model-session.fk","    (defn fcms-open-context","    ; The PROFILE"),
    pcr-part("form/form-stdlib/form-cli-model-session.fk","    (defn fcms-release-ok?","    0)"),
    pcr-part("form/native/metal/qwen35-dense-token-handle.fk","    (defn q38-close (","    0)")));
   write_file_text(str_concat(root,"/packet.txt"),packet);
   let request = json-node-object(list(oh-s("model",fcnv-default-model()),oh-n("context",fcnv-context()),oh-n("max_reply_tokens",1024)));
   write_file_text(str_concat(root,"/request.json"),json-emit(request));
   let started = now_unix_ms();
   let result = fcnv-ask(packet,request);
   let elapsed = sub(now_unix_ms(),started);
   fcnv-retain(root,result);
   write_file_text(str_concat(root,"/answer.md"),nth(result,1));
   let summary = oh-set(fcnv-metadata(result),"elapsed_ms",json-node-int(elapsed));
   write_file_text(str_concat(root,"/result.json"),json-emit(summary));
   print_str(json-emit(summary));
  }
 }
 pcr-run();
}
