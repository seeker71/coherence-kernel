// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-native-voice.bml
section [form.bml] {
 class PrefillReviewResolution {
  def prr-part(path,first,last) {
   let source = read_file(path);
   let begin = str_find(source,first,0);
   let end = str_find(source,last,add(begin,str_len(first)));
   if or(lt(begin,0),le(end,begin)) then form_error("review source boundary absent") else substring(source,begin,end);
  }
  def prr-join(parts) = if nil?(parts) then "" else str_concat(head(parts),prr-join(tail(parts)));
  def prr-run() {
   let root = ".hearth/prefill-review-resolution-2026-09-22";
   if not(eq(host_dir_mkdir(root),1)) then form_error("resolution already admitted; inspect retained work") else 0;
   let model = "form/form-stdlib/form-cli-model-session.fk";
   let packet = prr-join(list("Complete this actual resource-ownership review. The earlier review called the absence of immediate cleanup a resource leak in both prefill refusal paths of fcms-open-context. Here is the surrounding ownership and caller code. Trace what happens after a refusal, decide whether those findings survive, and identify any concrete remaining fault supported by this source. At most 150 words; no code fences. Do not invent execution evidence.\n\n",
    prr-part(model,"    (defn fcms-session ","    (defn fcms-none "),
    prr-part(model,"    (defn fcms-open-context","    ; The PROFILE"),
    prr-part(model,"    (defn fcms-generate ","    ; The tail begins"),
    prr-part(model,"    (defn fcms-release-ok?","    0)"),
    prr-part("form/form-stdlib/bml/form-cli-native-voice.bml","  def fcnv-run(","  def fcnv-number(")));
   write_file_text(str_concat(root,"/packet.txt"),packet);
   let request = json-node-object(list(oh-s("model",fcnv-default-model()),oh-n("context",fcnv-context()),oh-n("max_reply_tokens",512)));
   write_file_text(str_concat(root,"/request.json"),json-emit(request));
   let started = now_unix_ms();
   let result = fcnv-ask(packet,request);
   fcnv-retain(root,result);
   let summary = oh-set(fcnv-metadata(result),"elapsed_ms",json-node-int(sub(now_unix_ms(),started)));
   write_file_text(str_concat(root,"/result.json"),json-emit(summary));
   print_str(json-emit(summary));
  }
 }
 prr-run();
}
