// Retain this actual review's source delivery and the shared care reading.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-core-care.bml
section [form.bml] {
 let base = "receipts/artifacts/2026-09-22-prefill-code-review/";
 let events = ".hearth/prefill-code-review-2026-09-22/public-context-care.jsonl";
 let packet = read_file(".hearth/prefill-code-review-2026-09-22/cared-packet.txt");
 let retained = read_file(str_concat(base,"resolution-packet.txt"));
 let exact = and(not(nothing?(packet)),str_eq(packet,retained));
 if not(exact) then form_error("retained care packet differs from completed review source") else 0;
 let reading = occ-request-at(ohc-open(),json-node-object(list(json-node-pair("sources",json-node-array(list(json-node-string(events)))))));
 let signals = json-array-elements(oh-get(reading,"signals"));
 let outcomes = json-array-elements(oh-get(reading,"supply_outcomes"));
 let observed = and(eq(len(signals),1),and(eq(len(outcomes),1),str_eq(oh-str(head(outcomes),"observation_state"),"organ-reobserved")));
 if not(observed) then form_error("shared care view did not retain the review observation") else 0;
 let result = json-node-object(list(oh-n("packet_matches_retained_resolution",exact),oh-n("packet_bytes",str_len(packet)),oh-n("shared_care_observed",observed),oh-n("new_model_calls",0),oh-n("new_provider_calls",0),oh-s("answer_binding","retained resolution; no new generation")));
 write_file_text(str_concat(base,"public-context-care.jsonl"),read_file(events));
 write_file_text(str_concat(base,"public-context-care-view.json"),json-emit(reading));
 write_file_text(str_concat(base,"public-context-care.json"),json-emit(result));
 print_str(json-emit(result));
}
