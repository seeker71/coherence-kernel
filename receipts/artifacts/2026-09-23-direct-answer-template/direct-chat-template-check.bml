// Re-encode the actual enquiry using both native paths; no model admission.
// preflight-exec: forbidden
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 let text = read_file(".hearth/hearth-answer-source-repair.packet.md");
 let path = head(split-on(read_file(".hearth/hearth-serving-startup.txt"),"\n"));
 let src = fcmg-src(path);
 let start = now_unix_ms(); let indexed = fcmo-direct-tail-ids(path,text);
 let middle = now_unix_ms();
 if nothing?(indexed) then form_error("indexed direct template unavailable") else 0;
 print_str(str_concat("actual-enquiry indexed-ids=",str_concat(int_to_str(len(indexed)),"; reference encoding running\n")));
 let reference = fcms-direct-answer-tail-ids(src,text);
 let same = value_eq(indexed,reference);
 let result = json-node-object(list(oh-n("body_bytes",str_len(text)),oh-n("indexed_ids",len(indexed)),oh-n("reference_ids",len(reference)),oh-n("identical",same),oh-n("indexed_ms",sub(middle,start)),oh-n("reference_ms",sub(now_unix_ms(),middle)),oh-n("model_admissions",0),oh-n("generated_ids",0),oh-s("template","existing-q35-chat-ids-no-thinking;preserved-prior-close")));
 let saved = write_file(".hearth/direct-chat-template-check.json",json-emit-precise(result));
 print_str(json-emit-precise(result));
 if same then 1 else form_error("indexed and reference direct chat IDs differ");
}
