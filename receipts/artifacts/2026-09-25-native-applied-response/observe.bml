// Real answer revision; preserve sources, caller checks and native attribution.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 def nar-query(path) = json-node-object(list(nsm-s("tool","read"),json-node-pair("arguments",json-node-array(list(json-node-string(path))))));
 def nar-copy(from,to) = if le(file_size(from),0) then form_error(str_concat("evidence absent: ",from)) else frsh-frozen(to,read_file(from));
 def nar-copies(root,target,names) = if nil?(names) then 1 else { nar-copy(frsh-path(root,head(names)),frsh-path(target,head(names))); nar-copies(root,target,tail(names)); };
 def nar-result(rows) = if nil?(rows) then form_error("completed public result absent") else if not(faj-valid(head(rows))) then nar-result(tail(rows)) else {
  let row = parse-json("public-result",head(rows));
  if str_eq(fcap-string(row,"schema"),"form-native-code-v1") then row else nar-result(tail(rows));
 };
 def nar-other(docs) = if nil?(docs) then list() else if str_eq(nth(head(docs),1),"answer.md") then nar-other(tail(docs)) else cons(head(docs),nar-other(tail(docs)));
 def nar-prepare(root) {
  let prior = "receipts/artifacts/2026-09-25-native-absence-continue";
  let oldRequest = fhn-json(frsh-path(prior,"request.json")); let oldResult = fhn-json(frsh-path(prior,"result.json"));
  if not(eq(json-int-value(json-object-get(oldResult,"release_ok")),1)) then form_error("prior model release unverified") else 0;
  let oldDocs = fat-wire-value(fat-wire-documents(oldResult));
  let findings = "The retained answer passes its exact word-range and phrase assertions, but mostly describes concepts and its own usefulness. Its final paragraph still says the response serves the enquiry with clarity and care. The remaining work is to apply the concepts to Urs's actual enquiry and correction: show how they change attention, judgment, language and useful action. This is a caller observation, not a native finding. No replacement answer is supplied. The entire original enquiry and source evidence are available in enquiry.txt.";
  let docs = list(fat-find-doc(oldDocs,"answer.md"),fat-find-doc(oldDocs,"enquiry.txt"),list("caller-findings","repair-evidence.txt",findings));
  let goal = "Rewrite answer.md into the completed high-level response to the ORIGINAL ENQUIRY in enquiry.txt. Preserve its six axes and factual boundaries, and the original 350-450 word range. Apply the concepts to what Urs actually brought, including the correction that the voice felt cautious and distant. Explain concrete changes in judgment, interaction and next action, with relevant witnessed examples from the supplied sources. Let direct, warm wording do its work; remove claims praising the answer or predicting the reader's felt state. Keep numeric content identity, vocabulary anchors and model tokens distinct; retain 0, 1 and nothing; distinguish annotated frequency arithmetic from felt resonance. Explain what the available translation lookup actually contributes to wording, without inventing automatic semantic selection. Keep uncertainty at the particular missing evidence, including the absent measured out-of-box baseline. Answer the person rather than reporting this editing workflow. All source documents are read-only. A guarded whole-document edit can carry the rewrite without reproducing the old answer; use the current resident_sha256. Read the rewritten answer against the original enquiry, complete the task, and retain native review and final checks. Acceptance findings should be concise and refer to the actual answer. The exact phrase checks establish only those absences; they do not establish useful application or resonance.";
  let request = oh-set(oh-set(oh-set(oh-set(oh-set(oldRequest,"documents",fat-wire-documents-node(docs)),"goal",json-node-string(goal)),"turns",json-node-int(12)),"max_reply_tokens",json-node-int(1024)),"source_queries",json-node-array(list(nar-query("enquiry.txt"),nar-query("answer.md"),nar-query("repair-evidence.txt"))));
  if not(fcaq-request-valid(request)) then form_error(fcaq-request-refusal(request)) else 0;
  let checked = fcaq-check(node_children(json-object-get(request,"checks")),docs);
  if not(head(checked)) then form_error("starting candidate no longer passes its retained assertions") else 0;
  fs_mkdir(root); frsh-frozen(frsh-path(root,"request.json"),json-emit(request)); frsh-frozen(frsh-path(root,"input.txt"),str_concat("@",str_concat(root,"/request.json\n")));
  frsh-frozen(frsh-path(root,"admitted-context.txt"),fcac-bootstrap-budget(fcaq-initial(request,docs),12));
  let admission = json-node-object(list(nsm-n("original_assertions_retained",faj-equal(json-object-get(oldRequest,"checks"),json-object-get(request,"checks"))),nsm-n("enquiry_unchanged",value_eq(fat-find-doc(oldDocs,"enquiry.txt"),fat-find-doc(docs,"enquiry.txt"))),nsm-n("starting_checks_passed",head(checked)),nsm-n("starting_words",fal-count(nth(fat-find-doc(docs,"answer.md"),2))),nsm-s("starting_answer_sha256",nsm-hash(nth(fat-find-doc(docs,"answer.md"),2))),nsm-n("evaluation",1),nsm-s("changed_context","Actual 389-word candidate; caller asks for applied explanation and removal of self-description. Full relevant source is admitted initially. Allowances are 12 replies of up to 1024 tokens. This is new work, not an isolated instruction or timing comparison.")));
  frsh-frozen(frsh-path(root,"pre-admission.json"),json-emit(admission)); print_str(json-emit(admission));
 };
 def nar-export(root) {
  let terminal = fhn-json(frsh-path(root,"process-result.json"));
  if not(str_eq(fcap-string(terminal,"status"),"0")) then form_error("inspect retained native process failure") else 0;
  let job = fcap-string(terminal,"evidence"); let result = nar-result(reverse(split-on(read_file(fhn-stage-path(job,"code",".out")),"\n")));
  let request = fhn-json(frsh-path(root,"request.json")); let beforeDocs = fat-wire-value(fat-wire-documents(request)); let docs = fat-wire-value(fat-wire-documents(result));
  let answer = nth(fat-find-doc(docs,"answer.md"),2); let checked = fcaq-check(node_children(json-object-get(request,"checks")),docs); let process = fhn-json(fhn-stage-path(job,"code",".process.json"));
  let comparison = json-node-object(list(nsm-s("status",fcap-string(result,"status")),nsm-s("reason",fcap-string(result,"reason")),nsm-s("review",fcap-string(result,"report")),json-node-pair("turns",json-object-get(result,"turns")),json-node-pair("tool_calls",json-object-get(result,"tool_calls")),json-node-pair("repair_attempts",json-object-get(result,"repair_attempts")),json-node-pair("check_runs",json-object-get(result,"check_runs")),json-node-pair("generated_ids",json-object-get(result,"generated_ids")),json-node-pair("injected_ids",json-object-get(result,"injected_ids")),json-node-pair("release_ok",json-object-get(result,"release_ok")),json-node-pair("process_elapsed_ms",json-object-get(process,"elapsed_ms")),nsm-n("original_words",fal-count(nth(fat-find-doc(beforeDocs,"answer.md"),2))),nsm-n("final_words",fal-count(answer)),nsm-n("all_readonly_documents_unchanged",value_eq(nar-other(beforeDocs),nar-other(docs))),nsm-n("all_checks_passed",head(checked)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("provider_calls",0),nsm-n("evaluation",1),nsm-s("attribution","Codex supplied observed shortcomings and the requested application; Qwen composes and reviews the revision"),json-node-pair("semantic_quality",json-node-null())));
  frsh-frozen(frsh-path(root,"result.json"),json-emit(result)); frsh-frozen(frsh-path(root,"answer.txt"),answer); frsh-frozen(frsh-path(root,"comparison.json"),json-emit(comparison));
  frsh-frozen(frsh-path(root,"current-checks.json"),json-emit(json-node-object(list(nsm-n("passed",head(checked)),nsm-s("observation",nth(checked,1))))));
  let target = "receipts/artifacts/2026-09-25-native-applied-response"; fs_mkdir(target);
  nar-copies(root,target,list("request.json","pre-admission.json","admitted-context.txt","result.json","answer.txt","comparison.json","current-checks.json"));
  nar-copy(".hearth/native-applied-response.bml",frsh-path(target,"observe.bml")); nar-copy(".hearth/native-completion-cost-2026-09-25.json",frsh-path(target,"coordinator-cost.json"));
  frsh-frozen(frsh-path(target,"process.json"),json-emit(json-node-object(list(json-node-pair("state",json-object-get(process,"state")),json-node-pair("returncode",json-object-get(process,"returncode")),json-node-pair("elapsed_ms",json-object-get(process,"elapsed_ms")),json-node-pair("cleanup",json-object-get(process,"cleanup")),json-node-pair("output_drains",json-object-get(process,"output_drains"))))));
  print_str(json-emit(comparison)); print_str("\n"); print_str(answer);
 };
 def nar-run(root) {
  if gt(file_size(frsh-path(root,"admission.json")),0) then form_error("native revision already admitted") else 0;
  let checkout = fhn-root(); let job = fhn-unique(fhn-at(checkout,".form-heal"),"applied-response-",0);
  fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object(list(fhn-s("root",checkout)))); fhn-write-json(frsh-path(root,"admission.json"),json-node-object(list(fhn-s("evidence",job))));
  let status = fhn-run(job,"code",0,"root",fhn-at(checkout,frsh-path(root,"input.txt")),list("./fkwu","observe/form-cli-code-run.fk"));
  fhn-write-json(frsh-path(root,"process-result.json"),json-node-object(list(fhn-s("status",status),fhn-s("evidence",job)))); nar-export(root);
 };
 let root = ".hearth/native-applied-response-2026-09-25"; let phase = read_line();
 if str_eq(phase,"prepare") then nar-prepare(root) else if str_eq(phase,"run") then nar-run(root) else if str_eq(phase,"export") then nar-export(root) else form_error("phase must be prepare, run or export");
}
