// Observe and apply the completed native follow-up without altering its edits.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-review-enquiry.bml form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 class NativeClaimFollowup {
  def ncf-string(node,key) = json-string-value(json-object-get(node,key));
  def ncf-archive(path,text) = json-emit(json-node-object(list(nsm-s("schema","verbatim-public-artifact-v1"),nsm-s("original_path",path),nsm-n("bytes",str_len(text)),nsm-s("sha256",nsm-hash(text)),nsm-s("text",text))));
  def ncf-count(rows,action) = if nil?(rows) then 0 else add(if str_eq(ncf-string(head(rows),"action"),action) then 1 else 0,ncf-count(tail(rows),action));
  def ncf-public-value(log,key) {
   let marker = str_concat("\n",str_concat(key,"="));
   let at = str_find(log,marker,0);
   if lt(at,0) then form_error(str_concat("public generation field absent: ",key)) else {
    let begin = add(at,str_len(marker)); let end = str_find(log,"\n",begin);
    if lt(end,0) then form_error("public generation field unfinished") else json-int-value(parse-json("public-number",substring(log,begin,end)));
   };
  };
  def ncf-apply(root,detail,reply,original) {
   let complete = json-int-value(json-object-get(detail,"complete"));
   let valid = faj-valid(fat-trim(reply));
   let applied = if and(complete,valid) then fcrp-apply(original,list("answer"),parse-json("public-span-edits",reply)) else fcra-fail("generation incomplete or edit object invalid");
   if not(head(applied)) then {
    let failure = json-node-object(list(nsm-n("complete",complete),nsm-n("valid_json",valid),nsm-n("applied",0),nsm-s("reason",nth(applied,2)),nsm-n("evaluation",1)));
    frsh-frozen(frsh-path(root,"comparison.json"),json-emit(failure));
    print_str(json-emit(failure));
   } else {
    let edits = parse-json("public-span-edits",reply);
    let rows = node_children(json-object-get(edits,"span_edits"));
    let answer = ncf-string(nth(applied,1),"answer");
    let before = ncf-string(parse-json("original",original),"answer");
    let request = parse-json("original-checks",read_file("receipts/artifacts/2026-09-25-native-applied-response/request.json"));
    let documents = fat-wire-value(fat-wire-documents(request));
    let doc = fat-find-doc(documents,"answer.md");
    let afterDocs = fat-put-doc(documents,list(head(doc),nth(doc,1),answer));
    let checked = fcaq-check(node_children(json-object-get(request,"checks")),afterDocs);
    let result = json-node-object(list(nsm-n("complete",complete),nsm-n("valid_json",valid),nsm-n("applied",1),nsm-n("changed_spans",len(rows)),nsm-n("removed",ncf-count(rows,"remove")),nsm-n("replaced",ncf-count(rows,"replace")),nsm-n("before_words",fal-count(before)),nsm-n("after_words",fal-count(answer)),nsm-n("answer_changed",not(str_eq(before,answer))),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("original_assertions_passed",head(checked)),nsm-s("assertion_observation",nth(checked,1)),nsm-n("provider_calls",0),nsm-n("evaluation",1),json-node-pair("semantic_quality",json-node-null()),nsm-s("attribution","Qwen3.8-27B-Q8_0 generated sparse edits; Form applied them; Codex supplied specific schema and content defects; no arriving-agent answer edit")));
    frsh-frozen(frsh-path(root,"edits.json"),json-emit(edits));
    frsh-frozen(frsh-path(root,"revised-report.json"),json-emit(nth(applied,1)));
    frsh-frozen(frsh-path(root,"answer.txt"),answer);
    frsh-frozen(frsh-path(root,"comparison.json"),json-emit(result));
    print_str(json-emit(result)); print_str("\n"); print_str(answer);
   };
  }
 }
 let root = "receipts/artifacts/2026-09-25-native-claim-repair/followup";
 let original = read_file("receipts/artifacts/2026-09-25-native-claim-repair/input-report.json");
 let logPath = ".hearth/native-claim-repair-followup-cli.log";
 let log = read_file(logPath);
 let reportAt = str_find(log,"\nstate_released=",0);
 if lt(reportAt,0) then form_error("public direct-generation report not yet available") else 0;
 let textMarker = "\ntext:\n"; let textAt = str_find(log,textMarker,reportAt);
 let textStart = add(textAt,str_len(textMarker)); let textEnd = str_find(log,"\nform-cli> ",textStart);
 if or(lt(textAt,0),lt(textEnd,0)) then form_error("public generation response incomplete") else 0;
 let stopped = ncf-public-value(log,"heed_stopped");
 let timeout = ncf-public-value(log,"heed_decode_timeout");
 let queryCut = ncf-public-value(log,"heed_query_fuel_cut");
 let answerCut = ncf-public-value(log,"heed_answer_fuel_cut");
 let complete = and(stopped,not(or(timeout,or(queryCut,answerCut))));
 let detail = json-node-object(list(nsm-s("report_source","public direct-generation key-value fields"),nsm-s("profile","form-native-generate"),nsm-n("complete",complete),nsm-s("completion_basis","heed_stopped with no timeout or query/answer fuel cut"),nsm-n("stopped",stopped),nsm-n("decode_timeout",timeout),nsm-n("query_fuel_cut",queryCut),nsm-n("answer_fuel_cut",answerCut),nsm-n("state_released",ncf-public-value(log,"state_released")),nsm-n("state_handles_closed",ncf-public-value(log,"state_handles_closed")),nsm-n("state_handles_expected",ncf-public-value(log,"state_handles_expected")),nsm-n("prompt_tokens",ncf-public-value(log,"prompt_tokens")),nsm-n("generated_tokens",ncf-public-value(log,"generated_tokens")),nsm-n("gpu_busy_us",ncf-public-value(log,"gpu_busy_us")),nsm-n("prefill_gpu_busy_us",ncf-public-value(log,"prefill_gpu_busy_us")),nsm-n("decode_gpu_busy_us",ncf-public-value(log,"decode_gpu_busy_us")),nsm-n("provider_calls",0),nsm-n("evaluation",1)));
 let reply = substring(log,textStart,textEnd);
 frsh-frozen(frsh-path(root,"generation.json"),json-emit(detail));
 frsh-frozen(frsh-path(root,"reply.txt.json"),ncf-archive(logPath,reply));
 frsh-frozen(frsh-path(root,"public-cli.log.json"),ncf-archive(logPath,log));
 frsh-frozen(frsh-path(root,"coordinator-cost.json"),read_file(".hearth/native-claim-repair-followup-cost.json"));
 ncf-apply(root,detail,reply,original);
}
