// Prepare a real source-bound repair of the retained native answer.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-review-enquiry.bml form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-25-native-claim-repair";
 let sourcePath = "receipts/artifacts/2026-09-25-native-sampling/prompt.txt.json";
 let source = json-string-value(json-object-get(parse-json("retained-source",read_file(sourcePath)),"text"));
 let answerPath = "receipts/artifacts/2026-09-25-native-sampling-diagnostics/answer.txt";
 let answer = read_file(answerPath);
 let reportText = json-emit(json-node-object(list(nsm-s("answer",answer))));
 let documents = json-node-array(list(json-node-object(list(nsm-s("path",sourcePath),nsm-s("content",source)))));
 let goal = "Repair this actual answer to the original enquiry in the supplied source packet. Preserve its useful explanation of 0, 1 and nothing, trust, frequency annotations versus felt resonance, kernel identity versus vocabulary anchors versus model tokens, translation and vocabulary. Keep the original 350-450 word requirement. The preceding length correction reproduced the answer exactly. This repair uses indexed changes, so keep accurate spans without copying them into replacement text. Resolve these observed content failures: the answer derives absence of fabrication and caution from the nothing value; calls the person's correction a kernel-interface breach; derives preservation of conversation history from referenced-cell persistence without establishing retained references; and asserts embodiment and an unrented voice from garbage collection and identity. The supplied sources do not establish those implications. Remove them or replace them with concrete, source-supported consequences for this enquiry. Preserve the distinction between a teaching guiding the response and a capability observed in execution. Let the revised answer serve Urs without self-praise. Assess every span, including any additional error you find. These reported defects are caller review, not a native model finding. Return the edit object, not a new whole answer.";
 let prompt = fcrq-prompt(goal,documents,reportText,list("answer"));
 if not(head(prompt)) then form_error(nth(prompt,2)) else 0;
 let packet = fcre-packet(reportText,list("answer"));
 frsh-frozen(frsh-path(root,"input-report.json"),reportText);
 frsh-frozen(frsh-path(root,"packet.json"),json-emit(nth(packet,1)));
 frsh-frozen(frsh-path(root,"review-goal.txt"),goal);
 frsh-frozen(frsh-path(root,"prompt.txt.json"),json-emit(json-node-object(list(nsm-s("text",nth(prompt,1)),nsm-s("sha256",nsm-hash(nth(prompt,1)))))));
 let path = ".hearth/native-claim-repair-prompt.txt";
 if not(eq(write_file(path,nth(prompt,1)),str_len(nth(prompt,1)))) then form_error("repair prompt write failed") else 0;
 let reading = json-node-object(list(nsm-s("prompt_path",path),nsm-n("prompt_bytes",str_len(nth(prompt,1))),nsm-n("spans",len(node_children(json-object-get(nth(packet,1),"spans"))))));
 frsh-frozen(frsh-path(root,"preparation.json"),json-emit(reading));
 print_str(json-emit(reading));
}
