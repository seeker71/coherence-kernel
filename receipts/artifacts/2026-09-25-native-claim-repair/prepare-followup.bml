// A compact native repair carries the actual failed proposal and observed gaps.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-review-enquiry.bml form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 def ncf-proposals(rows) = if nil?(rows) then list() else if str_eq(fcre-string(head(rows),"action"),"keep") then ncf-proposals(tail(rows)) else cons(head(rows),ncf-proposals(tail(rows)));
 let root = "receipts/artifacts/2026-09-25-native-claim-repair";
 let original = read_file(frsh-path(root,"input-report.json"));
 let publicReply = json-string-value(json-object-get(parse-json("public-reply",read_file(frsh-path(root,"reply.txt.json"))),"text"));
 let proposal = parse-json("failed-proposal",publicReply);
 let sourcePath = "receipts/artifacts/2026-09-25-native-sampling/prompt.txt.json";
 let source = json-string-value(json-object-get(parse-json("retained-source",read_file(sourcePath)),"text"));
 let selectedRows = ncf-proposals(node_children(json-object-get(proposal,"edits")));
 let selected = json-emit(json-node-array(selectedRows));
 let documents = json-node-array(list(json-node-object(list(nsm-s("path",sourcePath),nsm-s("content",source))),json-node-object(list(nsm-s("path","actual-unapplied-proposals.json"),nsm-s("content",selected)))));
 let attention = "\nThe actual preceding native edit set was rejected at span 8 because its replacements omitted reason. No edits were applied. Every sparse edit now needs id, action and nonempty reason; replacement also needs text. The proposed changes are retained as a source document for your use, not accepted corrections. Further caller-observed defects remain in the original answer: span 6 asserts absence of anxiety, span 17 asserts absence of hesitation, span 21 calls release fearless, span 34 promises prevention of semantic drift, span 35 conflates vocabulary changes with kernel composition, span 39 derives decisions from cell persistence, and span 43 praises its own care. Spans 44-46 also need useful explanation instead of claims about being cautious, embodied or unrented. Remove unsupported behavioral assurances and self-assessment; preserve or supply concrete practical connections answering the original enquiry. Keep the complete answer within the original 350-450 words. Render real whitespace in replacements. Return only changed spans using the sparse schema.";
 let goal = str_concat(read_file(frsh-path(root,"review-goal.txt")),attention);
 let prompt = fcrq-amend-prompt(goal,documents,original,list("answer"));
 if not(head(prompt)) then form_error(nth(prompt,2)) else 0;
 let folder = str_concat(root,"/followup"); fs-mkdir(folder);
 frsh-frozen(frsh-path(folder,"goal.txt"),goal);
 frsh-frozen(frsh-path(folder,"prompt.txt.json"),json-emit(json-node-object(list(nsm-s("text",nth(prompt,1)),nsm-s("sha256",nsm-hash(nth(prompt,1)))))));
 frsh-frozen(frsh-path(folder,"packet.json"),json-emit(nth(fcrp-packet(original,list("answer")),1)));
 let path = ".hearth/native-claim-repair-followup-prompt.txt";
 if not(eq(write_file(path,nth(prompt,1)),str_len(nth(prompt,1)))) then form_error("repair followup prompt write failed") else 0;
 let reading = json-node-object(list(nsm-s("prompt_path",path),nsm-n("prompt_bytes",str_len(nth(prompt,1))),nsm-n("retained_proposals",len(selectedRows)),nsm-n("evaluation",1)));
 print_str(json-emit(reading));
}
