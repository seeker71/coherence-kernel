// Real models/quit execution against the shared learning home, with native timing.
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 class SessionCloseObservation {
  def sco-root() = "receipts/artifacts/2026-09-26-native-session-close";
  def sco-events(text,pid) = sco-lines(text,0,str_concat("\"pid\":",str_concat(int_to_str(pid),",")));
  def sco-lines(text,at,needle) = if ge(at,str_len(text)) then list() else sco-line(text,at,str_find(text,"\n",at),needle);
  def sco-line(text,at,end,needle) {
   let stop = if lt(end,0) then str_len(text) else end;
   let line = substring(text,at,stop);
   if ge(str_find(line,needle,0),0) then cons(parse-json("session-close-event",line),sco-lines(text,add(stop,1),needle)) else sco-lines(text,add(stop,1),needle);
  }
  def sco-baseline(events) {
   let rows = sco-events(events,25318);
   if not(and(eq(len(rows),3),and(str_eq(nsm-str(nth(rows,1),"stage"),"settle-begin"),str_eq(nsm-str(nth(rows,2),"stage"),"settle-observed")))) then form_error("original CLI completion evidence changed") else sco-baseline-write(rows);
  }
  def sco-baseline-write(rows) {
   let doc = json-node-object(list(nsm-s("command","models /Users/ursmuff/models/qwen38-27b; quit"),nsm-n("cli_pid",25318),nsm-n("settle_elapsed_ms",sub(nsm-num(nth(rows,2),"at_ms"),nsm-num(nth(rows,1),"at_ms"))),json-node-pair("events",json-node-array(rows))));
   nsm-write(nsm-at(sco-root(),"before.json"),doc);
  }
  def sco-run() {
   let home = hearth-session-learning();
   let baseline = sco-baseline(read_file(nsm-at(home,"events.jsonl")));
   let worker = str_to_int(trim(nsm-text(nsm-at(home,"worker.pid"))));
   let parent = nsm-worker-parent(worker);
   let alive = host_alive(worker);
   let input = nsm-at(sco-root(),"commands.txt");
   let wrote = nag-write(input,"models /Users/ursmuff/models/qwen38-27b\nquit\n");
   let out = nsm-at(".hearth",str_concat("session-close-",str_concat(nsm-id(),".stdout"))); let err = nsm-at(sco-root(),"cli.stderr");
   let cleanOut = fs-remove-file(out); let cleanErr = fs-remove-file(err);
   let started = host_monotonic_ms();
   let pid = host_spawn_at(list("./fkwu","form/form-stdlib/form-cli-repl.fk"),list(input,out,err));
   let rc = if gt(pid,0) then host_wait(pid) else -1;
   let elapsed = sub(host_monotonic_ms(),started);
   let after = host_alive(worker);
   let stdoutPath = nsm-at(sco-root(),"cli.stdout.json");
   let stdout = read_file(out);
   let captured = nsm-write(stdoutPath,json-node-object(list(nsm-n("bytes",str_len(stdout)),nsm-s("text",stdout))));
   let released = if str_eq(nsm-str(nsm-json(stdoutPath),"text"),stdout) then fs-remove-file(out) else form_error("CLI output retention changed bytes");
   let rows = sco-events(read_file(nsm-at(home,"events.jsonl")),pid);
   let doc = json-node-object(list(nsm-s("command","models /Users/ursmuff/models/qwen38-27b; quit"),nsm-n("cli_pid",pid),nsm-n("exit",rc),nsm-n("whole_command_elapsed_ms",elapsed),nsm-n("worker_pid",worker),nsm-n("worker_parent_before",parent),nsm-n("worker_alive_before",alive),nsm-n("same_worker_alive_after",after),json-node-pair("events",json-node-array(rows)),nsm-s("stdout",stdoutPath),nsm-s("stderr",err)));
   let saved = nsm-write(nsm-at(sco-root(),"after.json"),doc);
   print_str(json-emit-precise(doc));
  }
 }
 sco-run();
}
