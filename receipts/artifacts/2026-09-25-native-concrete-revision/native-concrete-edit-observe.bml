// Retain completed public answers and metadata; never open private reasoning.
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 let selectedHome = read_line(); let selectedOut = read_line();
 let home = if or(nothing?(selectedHome),str_eq(selectedHome,"")) then ".hearth/native-concrete-edit-2026-09-25" else selectedHome;
 let log = read_file(nsm-at(home,"runtime.log"));
 let marker = "form-native-generation ";
 let at = str_find(log,marker,0);
 if lt(at,0) then print_str("status=running-or-no-public-result\n") else {
  let start = add(at,str_len(marker));
  let end = str_find(log,"\n",start);
  if lt(end,0) then form_error("public generation metadata incomplete") else 0;
  let report = parse-json("public-generation",substring(log,start,end));
  let root = nsm-str(report,"private_evidence");
  let answer = read_file(nsm-at(root,"answer.txt"));
  let before = read_file(nsm-at(root,"before-length-check.txt"));
  let original = read_file("receipts/artifacts/2026-09-23-native-composition-floor/compose-original.txt");
  let words = fal-count(answer);
  if not(eq(words,nsm-num(report,"final_words"))) then form_error("public answer and reported count disagree") else 0;
  let out = if or(nothing?(selectedOut),str_eq(selectedOut,"")) then "receipts/artifacts/2026-09-25-native-concrete-revision" else selectedOut;
  let preparation = nsm-json(nsm-at(home,"preparation.json"));
  if not(str_eq(nsm-str(preparation,"prompt_sha256"),nsm-hash(read_file(nsm-at(home,"prompt.txt"))))) then form_error("preparation metadata and executed prompt differ") else 0;
  fs-mkdir(out);
  nag-write(nsm-at(out,"answer.txt"),answer);
  nag-write(nsm-at(out,"before-length-check.txt"),before);
  nsm-write(nsm-at(out,"report.json"),report);
  nsm-write(nsm-at(out,"preparation.json"),preparation);
  nsm-write(nsm-at(out,"prompt.json"),json-node-object(list(nsm-s("text",read_file(nsm-at(home,"prompt.txt"))))));
  nsm-write(nsm-at(out,"wire-observation.json"),nsm-json(".hearth/native-length-wire-observation.json"));
  nsm-write(nsm-at(out,"preceding-coordinator-cost.json"),nsm-json(nsm-at(home,"preceding-coordinator-cost.json")));
  let assessment = json-object-get(nsm-json(".hearth/native-compose-care-2026-09-23/request.json"),"assessment");
  let wrapped = json-emit(json-node-object(list(nsm-s("answer",answer),json-node-pair("findings",json-node-array(list())))));
  let sourceCheck = frr-source(assessment); let answerCheck = frr-report(assessment,wrapped);
  let checks = json-node-object(list(nsm-n("source_checks",head(sourceCheck)),nsm-n("answer_checks",head(answerCheck)),nsm-s("scope","original source/report assertions; empty findings array wraps prose without inventing a model review")));
  nsm-write(nsm-at(out,"checks.json"),checks);
  let observed = json-node-object(list(nsm-n("original_words",fal-count(original)),nsm-n("initial_words",fal-count(before)),nsm-n("final_words",words),nsm-n("range_passed",fal-within(words,350,450)),nsm-n("unchanged_original",str_eq(original,answer)),nsm-n("unchanged_length_revision",str_eq(before,answer)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("bold_heading_markers",ge(str_find(answer,"**",0),0)),nsm-n("choice_marker",ge(str_find(answer,"<CHOICE>",0),0)),nsm-n("stop_marker",ge(str_find(answer,"<STOP>",0),0)),nsm-s("scope","completed public answer and mechanical checks; semantic quality assessed from prose")));
  nsm-write(nsm-at(out,"observation.json"),observed);
  print_str(json-emit(report)); print_str("\n"); print_str(json-emit(observed)); print_str("\n"); print_str(json-emit(checks)); print_str("\n"); print_str(answer);
 };
}
