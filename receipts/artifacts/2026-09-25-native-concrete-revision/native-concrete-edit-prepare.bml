// Prepare a real revision of the retained failed answer from its original sources.
// preludes: form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-cli-generate-reasoning.bml
section [form.bml] {
 let root = ".hearth/native-concrete-edit-2026-09-25";
 fs-mkdir(root);
 let original = read_file(".hearth/native-compose-2026-09-23/prompt.txt");
 let start = str_find(original,"\nSOURCE\n",0);
 if lt(start,0) then form_error("original source boundary absent") else 0;
 let source = substring(original,add(start,8),str_len(original));
 let draft = read_file("receipts/artifacts/2026-09-23-native-composition-floor/compose-original.txt");
 if not(eq(fal-count(draft),843)) then form_error("actual failed draft changed") else 0;
 let enquiry = "Urs asks how Form's axioms, trust over fear, frequency awareness, numeric identity, native translation and vocabulary change interactions and responses compared with an arriving model without this repository context. Urs found the prior voice cautious and shielded, and asks us to focus on the gap. Two independent paths matter: improve native Form responses and enrich the arriving mind with Form's context and tools. There is no measured out-of-box baseline.\n";
 let edits = "Rewrite the actual draft above into the answer Urs can use now. Make these concrete edits:\n1. Delete all six bold section headings and the sentence announcing six axes. Use five connected prose paragraphs, about 80 words each, 350-450 words total.\n2. Delete the claims that this exchange persists as graph cells, that revising this answer mints a node, and that the prior draft is unreferenced. No graph operation was observed. Explain composition identity and referenced/unreferenced lifetime as the Form contract, with external files kept distinct.\n3. Delete the assurances 'I removed the shield' and 'the correction changed the answer\'s shape'. Describe the actual useful change in work instead: the native answer had 843 words, its shortening pass still had 843, and that failure directs attention to effective revision. A separate provider-assisted repair exists; do not credit it as a native capability.\n4. Delete the long lists of translated words and purified synonyms. Keep only the observed offer/offered/anbot example. Explain what preserving meaning across labels adds, keeping vocabulary anchors and model token IDs distinct from graph identity.\n5. Apply trust and the dialogue covenant to this real work: receive the correction, preserve the failing answer, repair its cause, and return to the same enquiry. Frequency arithmetic describes supplied annotations; Urs's experience of the response is its own evidence.\n6. Name both independent paths and what each contributes. Connect concepts to response decisions. Give a warm, direct answer to Urs; no self-assessment, apologies, word-count narration, invented operations or declarations that resonance has been achieved.\nReturn only the completed revised answer.\n";
 let prompt = str_concat(enquiry,str_concat("\nORIGINAL SOURCE PACKET\n",str_concat(source,str_concat("\nACTUAL FAILED DRAFT\n",str_concat(draft,str_concat("\n\nCURRENT EDIT REQUEST\n",edits))))));
 if not(fgcr-keep(root,"prompt.txt",prompt)) then form_error("revision prompt retention failed") else 0;
 let row = json-node-object(list(nsm-s("source_sha256",nsm-hash(source)),nsm-s("draft_sha256",nsm-hash(draft)),nsm-s("prompt_sha256",nsm-hash(prompt)),nsm-n("prompt_bytes",str_len(prompt)),nsm-n("draft_words",fal-count(draft)),nsm-s("changed_context","fresh direct composition from original sources plus actual failed draft and specific edits; no reasoning stage; not a one-variable comparison"),nsm-n("model_calls",0),nsm-n("provider_calls",0)));
 nsm-write(nsm-at(root,"preparation.json"),row);
 print_str(json-emit(row));
}
