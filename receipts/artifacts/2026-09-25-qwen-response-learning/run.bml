// One native movement: verified learning, explicit candidate, unchanged enquiry.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/qwen-lora-learning.bml form-stdlib/bml/form-cli-generate-reasoning.bml form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let requestText = read_file(".hearth/qwen-response-learning-request.json");
 let request = parse-json("learning-request",requestText);
 let root = fcap-string(request,"output_directory");
 let learned = qll-run-source(requestText);
 print_str(json-emit-precise(learned)); print_str("\n");
 if not(eq(qll-value(learned,"ok"),1)) then form_error(fcap-string(learned,"reason")) else 0;
 let detail = json-object-get(learned,"detail");
 if not(lt(qll-value(detail,"selected_validation_loss"),qll-value(detail,"initial_validation_loss"))) then print_str("candidate remains at baseline; no duplicate generation or promotion\n") else {
  let baseRoot = "receipts/artifacts/2026-09-25-native-response-profile";
  let baseline = qll-read(nsm-at(baseRoot,"report.json"));
  let prompt = fcap-string(qll-read(nsm-at(baseRoot,"prompt.json")),"text");
  let profile = fcap-string(baseline,"profile");
  let lower = qll-value(baseline,"word_minimum"); let upper = qll-value(baseline,"word_maximum");
  let allowance = qll-value(baseline,"answer_allowance");
  let text = fgcr-input-text(prompt,allowance,lower,upper);
  let started = host_monotonic_ms();
  let session = qll-open-selected(root,text,qll-value(baseline,"context"),profile);
  if not(fcms-live?(session)) then { let released = fcms-release-ok?(session); print(list("candidate-admission-refused",fcms-reason(session),"release",released)); form_error("candidate admission refused"); } else 0;
  if not(eq(fcms-prompt-ids(session),qll-value(baseline,"prompt_ids"))) then { let released = fcms-release-ok?(session); print(list("candidate-input-count-changed","release",released)); form_error("matched enquiry input changed"); } else 0;
  let response = fgcr-compose(session,fcms-path(session),profile,0,allowance,lower,upper,started);
  let report = nth(response,2); let answerRoot = fcap-string(report,"private_evidence");
  let answer = read_file(nsm-at(answerRoot,"answer.txt"));
  frsh-frozen(nsm-at(root,"answer.txt"),answer);
  qll-write-result(root,"answer-report.json",report);
  let assessment = json-object-get(qll-read(".hearth/native-compose-care-2026-09-23/request.json"),"assessment");
  let wrapped = json-emit(json-node-object(list(nsm-s("answer",answer),json-node-pair("findings",json-node-array(list())))));
  let compared = json-node-object(list(nsm-s("scope","same native response prompt/profile/context/allowance; explicit unpromoted learned adapter; public answers only"),nsm-s("baseline_answer_sha256",nsm-hash(read_file(nsm-at(baseRoot,"answer.txt")))) ,nsm-s("candidate_answer_sha256",nsm-hash(answer)),nsm-n("base_words",qll-value(baseline,"final_words")),nsm-n("candidate_words",fal-count(answer)),nsm-n("source_checks",head(frr-source(assessment))),nsm-n("answer_checks",head(frr-report(assessment,wrapped))),json-node-pair("semantic_quality",json-node-null()),nsm-n("serving_promotion",0),nsm-n("provider_calls",0)));
  qll-write-result(root,"comparison.json",compared);
  print_str(json-emit(compared)); print_str("\n"); print_str(head(response));
 };
}
