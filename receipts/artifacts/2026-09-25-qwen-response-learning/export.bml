// Retain public results and source-derived targets from the completed movement.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/qwen-lora-learning.bml
section [form.bml] {
 def qre-retain(from,to) {
  let text = read_file(from);
  if not(str_eq(value_kind(text),"string")) then form_error(str_concat("evidence absent: ",from)) else frsh-frozen(to,text);
 }
 def qre-copy(root,output,names) = if nil?(names) then 1 else {
  qre-retain(frsh-path(root,head(names)),frsh-path(output,head(names)));
  qre-copy(root,output,tail(names));
 };
 let root = ".hearth/qwen-response-learning-2026-09-25";
 let output = "receipts/artifacts/2026-09-25-qwen-response-learning";
 let report = qll-read(frsh-path(root,"answer-report.json"));
 let learned = qll-read(frsh-path(root,"result.json"));
 let binding = qll-read(frsh-path(root,"candidate.json"));
 if not(and(eq(qll-value(report,"complete"),1),and(eq(qll-value(report,"release_ok"),1),eq(qll-value(json-object-get(learned,"detail"),"release_ok"),1)))) then form_error("learning and public response must complete and release before export") else 0;
 let publicRoot = fcap-string(report,"private_evidence");
 let before = read_file(frsh-path(publicRoot,"before-length-check.txt"));
 let after = read_file(frsh-path(root,"answer.txt"));
 let material = fcmd-snapshot(fcap-string(binding,"candidate"));
 if not(eq(len(material),3)) then form_error("selected adapter unavailable for identity check") else 0;
 if not(eq(host_dir_mkdir(output),1)) then form_error("evidence directory already exists") else 0;
 qre-copy(root,output,list("request.json","capture.json","result.json","candidate.json","answer.txt","answer-report.json","comparison.json"));
 qre-retain(frsh-path(publicRoot,"before-length-check.txt"),frsh-path(output,"before-length-check.txt"));
 qre-retain(frsh-path(publicRoot,"length-feedback.txt"),frsh-path(output,"length-feedback.txt"));
 qre-retain(".hearth/qwen-response-learning-coordinator-cost.json",frsh-path(output,"coordinator-cost.json"));
 qre-retain(".hearth/qwen-response-learning-admission-before.log",frsh-path(output,"admission-before.log"));
 qre-retain(".hearth/qwen-response-learning-prepare.bml",frsh-path(output,"prepare.bml"));
 qre-retain(".hearth/qwen-response-learning-run.bml",frsh-path(output,"run.bml"));
 qre-retain(".hearth/qwen-response-learning-export.bml",frsh-path(output,"export.bml"));
 let audit = json-node-object(list(
  nsm-s("scope","completed public responses and verified training targets; private reasoning excluded"),
  nsm-s("baseline","receipts/artifacts/2026-09-25-native-response-profile"),
  nsm-s("before_revision_sha256",nsm-hash(before)),nsm-s("after_revision_sha256",nsm-hash(after)),
  nsm-n("revision_byte_identical",str_eq(before,after)),
  nsm-n("adapter_identity_matches",and(str_eq(nth(material,2),fcap-string(binding,"adapter_ab_sha256")),str_eq(nth(material,2),fcap-string(report,"adapter_ab_sha256")))),
  nsm-s("teaching_source_sha256",nsm-hash(read_file("form/form-stdlib/bml/form-cli-qwen-meaning.bml"))),
  nsm-s("learner_source_sha256",nsm-hash(read_file("form/form-stdlib/bml/qwen-lora-learning.bml"))),
  nsm-s("response_source_sha256",nsm-hash(read_file("form/form-stdlib/bml/form-cli-generate-reasoning.bml"))),
  nsm-n("provider_calls",0),nsm-n("serving_promotion",0)));
 frsh-frozen(frsh-path(output,"audit.json"),json-emit(audit));
 print_str(json-emit(audit));
}
