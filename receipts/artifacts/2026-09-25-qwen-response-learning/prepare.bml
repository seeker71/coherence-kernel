// Verified sentence selection from committed teaching, not evaluated answers.
// preludes: form-stdlib/bml/qwen-lora-learning.bml form-stdlib/bml/form-cli-generate-reasoning.bml
section [form.bml] {
 def qrp-sentence(text,index) {
  let end = str_find(text,". ",0);
  if eq(index,0) then if lt(end,0) then text else substring(text,0,add(end,1))
  else if lt(end,0) then form_error("teaching sentence index absent") else qrp-sentence(substring(text,add(end,2),str_len(text)),sub(index,1));
 }
 def qrp-row(id,split,source,instruction,indices) {
  let target = qrp-target(source,indices);
  let prompt = str_concat("Revise this working explanation according to the current edit request. The explanation is verified source text. Keep only the requested sentences, in their original order and exact wording; return the revised explanation alone.\n\nWORKING EXPLANATION\n",str_concat(source,str_concat("\n\nCURRENT EDIT REQUEST\n",instruction)));
  json-node-object(list(nsm-s("id",id),nsm-s("split",split),nsm-s("prompt",prompt),nsm-s("completion",target)));
 }
 def qrp-target(source,indices) = if nil?(indices) then "" else str_concat(qrp-sentence(source,head(indices)),if nil?(tail(indices)) then "" else str_concat(" ",qrp-target(source,tail(indices))));
 let rows = list(
  qrp-row("model-prediction","train",fqt-symbol-meaning(),"Keep only the second sentence: which representation the model uses and which operations encode and predict.",list(1)),
  qrp-row("reference-lifetime","train",fqt-effect-meaning(),"Keep only the third and fourth sentences: changed composition, the referenced old cell, and reclamation without remaining references.",list(2,3)),
  qrp-row("surface-scope","train",fqt-surface-meaning(),"Keep only the fourth and fifth sentences: the short codebook anchor's scope and the source of natural-language answers.",list(3,4)),
  qrp-row("parser-boundary","train",fqt-parser-meaning(),"Keep only the first two sentences: the parser's raw-byte input and the model's tokenizer.",list(0,1)),
  qrp-row("behavior-evidence","train",fqt-response-evidence-meaning(),"Keep only the first sentence: what grounds descriptions of model behavior.",list(0)),
  qrp-row("symbol-lookup","validation",fqt-symbol-meaning(),"Keep the first and last sentences. Remove the model-representation sentence in the middle.",list(0,2)),
  qrp-row("external-lifetime","validation",fqt-effect-meaning(),"Keep the first and sixth sentences. State the lifetime distinction and the actual filesystem-unlink boundary.",list(0,5)),
  qrp-row("translation-coverage","validation",fqt-surface-meaning(),"Keep the second and third sentences. Preserve alternate language surfaces, dictionary senses and missing translations.",list(1,2)));
 let root = ".hearth/qwen-response-learning-2026-09-25";
 let request = json-node-object(list(nsm-s("model","qwen38-q8"),nsm-s("output_directory",root),json-node-pair("rows",json-node-array(rows)),nsm-s("profile","response"),nsm-n("context",4096),nsm-n("epochs",8),qll-real("learning_rate",0.001),qll-real("max_norm",1.0)));
 if not(str_eq(qll-request-reason(request),"")) then form_error(qll-request-reason(request)) else 0;
 if or(qll-profile-valid("response-reasoning"),or(qll-profile-valid("full-reasoning"),qll-profile-valid("knowledge-query-reasoning"))) then form_error("public completion target admitted inside reasoning") else 0;
 if not(and(qll-profile-valid("full"),and(qll-profile-valid("knowledge-query"),str_eq(qll-runtime-profile("response"),"response")))) then form_error("completion profile routing changed") else 0;
 frsh-frozen(".hearth/qwen-response-learning-request.json",json-emit-precise(request));
 let reading = json-node-object(list(nsm-s("admission",qll-request-reason(request)),nsm-n("rows",len(rows)),nsm-s("basis","exact selected sentences from committed fqt teaching; validation holds different sentence selections from the same concepts; original enquiry and evaluated answers excluded"),nsm-s("source_sha256",nsm-hash(read_file("form/form-stdlib/bml/form-cli-qwen-meaning.bml"))),nsm-n("model_calls",0)));
 print_str(json-emit(reading));
}
