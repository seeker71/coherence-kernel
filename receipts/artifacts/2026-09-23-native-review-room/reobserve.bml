// Complete the actual review with room for analysis and the requested report.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-comparison-review.bml
section [form.bml] {
 class NativeFidelityReviewRoom {
  def nfrr-contract(request) = json-node-object(oh-without(oh-without(oh-without(json-object-pairs(request),"initial_reasoning_tokens"),"reasoning_answer_tokens"),"max_reply_tokens"));
 }
 let prior = parse-json("original-review-request",read_file(".hearth/native-fidelity-review.request.json"));
 let request = oh-set(oh-set(oh-set(prior,"initial_reasoning_tokens",json-node-int(3072)),"reasoning_answer_tokens",json-node-int(3072)),"max_reply_tokens",json-node-int(3072));
 fcr-need(str_eq(json-emit(nfrr-contract(prior)),json-emit(nfrr-contract(request))),"only observed generation allowances may change");
 fcr-need(fcaq-evaluation(request),"review remains excluded from training");
 frsh-frozen(".hearth/native-fidelity-room.request.json",json-emit(request));
 let delivery = json-node-object(list(oh-n("original_request_except_allowances_exact",1),oh-n("initial_reasoning_tokens",3072),oh-n("reasoning_answer_tokens",3072),oh-n("max_reply_tokens",3072),json-node-pair("context",oh-get(request,"context")),oh-s("shared_meaning_sha256",nsm-hash(fqt-meaning-prefix())),oh-s("cause","retained initial analysis ended during paragraph one; final stage stopped mid-finding at its allowance; partial answer retained source contradictions")));
 frsh-frozen(".hearth/native-fidelity-room.delivery.json",json-emit(delivery));
 print_str(str_concat("review-room ",str_concat(json-emit(delivery),"\n")));
 let waiting = host_monotonic_ms();
 let settled = nsm-settle(hearth-session-learning()); nsm-settle-exit(settled);
 fcr-need(not(nsm-running(hearth-session-learning())),"learner still owns model resources");
 let waited = sub(host_monotonic_ms(),waiting);
 print_str(str_concat("learner-released; wait-ms=",str_concat(int_to_str(waited),"\n")));
 let started = host_monotonic_ms();
 let result = fcaq-call(json-emit(request));
 frsh-frozen(".hearth/native-fidelity-room.result.json",result);
 let parsed = parse-json("native-review-result",result);
 frsh-frozen(".hearth/native-fidelity-room.report.json",oh-str(parsed,"report"));
 let summary = json-node-object(list(oh-s("status",oh-str(parsed,"status")),oh-s("reason",oh-str(parsed,"reason")),json-node-pair("tool_calls",oh-get(parsed,"tool_calls")),json-node-pair("generated_ids",oh-get(parsed,"generated_ids")),json-node-pair("release_ok",oh-get(parsed,"release_ok")),oh-n("elapsed_ms",sub(host_monotonic_ms(),started)),oh-n("learner_wait_ms",waited),oh-n("provider_calls",0),oh-s("report_path",".hearth/native-fidelity-room.report.json"),json-node-pair("semantic_quality",json-node-null())));
 frsh-frozen(".hearth/native-fidelity-room.summary.json",json-emit(summary));
 print_str(str_concat(json-emit(summary),"\n"));
}
