// Real tokenizer and retained task; cursor geometry from the failed execution.
// No model admission, generation or private reasoning read.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let taskPath = read_line();
 let output = read_line();
 let path = mr-path(mr-find("qwen38-q8"));
 let source = fcmg-src(path);
 let session = fcms-session("live","reobserve-cursor",path,source,list(),list(),16384,14654,0,0,0,0,0,0);
 let task = read_file(taskPath);
 let notice = frbg-task-observation(512,512,1024,task);
 let ids = frbg-observation-ids(session,notice);
 let old = frbg-reserve-fits(session,512,1024);
 let current = frbg-task-reserve-fits(session,512,1024,task);
 if not(and(old,not(current))) then form_error("retained overflow did not discriminate admission") else 0;
 let reading = json-node-object(list(nsm-s("scope","actual registry tokenizer and retained current task; reconstructed cursor, no model execution"),nsm-s("model","qwen38-q8"),nsm-n("position",14654),nsm-n("context",16384),nsm-n("reasoning",512),nsm-n("answer",1024),nsm-n("handoff_ids",len(ids)),nsm-n("old_admission",old),nsm-n("current_admission",current),nsm-n("model_calls",0),nsm-n("provider_calls",0),nsm-s("task_sha256",nsm-hash(task))));
 nsm-write(output,reading);
 print_str(json-emit(reading));
}
