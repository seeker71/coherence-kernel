// Observe the original enquiry through the serving path with complete ID evidence.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 let root = ".hearth/generation-evidence-2026-09-23/response";
 if not(eq(host_dir_mkdir(root),1)) then form_error("generation evidence response already exists") else 0;
 // Inference owns its resources separately from retained learning needs.
 if nsm-running(hearth-session-learning()) then form_error("session learner still owns resources") else 0;
 let prompt = read_file("receipts/artifacts/2026-09-23-response-prompt/question.txt");
 let result = fgc-run(fcmr-none(),mr-path(mr-find("qwen38-q8")),str_concat("--tokens 2048 --words 350:450 ",prompt));
 let detail = nth(result,2);
 nsm-write(nsm-at(root,"result.json"),detail);
 nag-write(nsm-at(root,"answer.txt"),read_file(nsm-at(nsm-str(detail,"private_evidence"),"answer.txt")));
 print_str(str_concat(json-emit-precise(detail),"\n"));
 if and(eq(nsm-num(detail,"release_ok"),1),eq(nsm-num(detail,"retained"),1)) then 0 else form_error("response release or retention incomplete");
}
