// Compare the actual serving sequences and decode them anew without admitting a model.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 class GenerationEvidenceCompare {
  def gec-ids(g) = gec-values(node_children(json-object-get(g,"ids")));
  def gec-values(xs) = if nil?(xs) then list() else cons(node_value(head(xs)),gec-values(tail(xs)));
  def gec-first-difference(a,b,i) = if and(nil?(a),nil?(b)) then -1 else if or(nil?(a),nil?(b)) then i else if eq(head(a),head(b)) then gec-first-difference(tail(a),tail(b),add(i,1)) else i;
 }
 let root = ".hearth/generation-evidence-2026-09-23";
 let report = nsm-json(nsm-at(root,"response/result.json"));
 let private = nsm-str(report,"private_evidence");
 let raw = read_file(nsm-at(private,"generation.json"));
 if nothing?(raw) then form_error("serving generation sequences absent") else 0;
 let evidence = parse-json("generation-evidence",raw);
 let initial = json-object-get(evidence,"initial"); let revision = json-object-get(evidence,"length_revision");
 let a = gec-ids(initial); let b = gec-ids(revision);
 let src = fcmg-src(nsm-str(report,"model"));
 let first = ftdb-text(src,a); let second = ftdb-text(src,b);
 let compared = json-node-object(list(
  nsm-n("initial_ids",len(a)),nsm-n("revision_ids",len(b)),nsm-n("ids_equal",value_eq(a,b)),nsm-n("first_different_id_index",gec-first-difference(a,b,0)),
  nsm-n("text_equal",str_eq(nsm-str(initial,"text"),nsm-str(revision,"text"))),
  nsm-n("initial_fresh_decode_equal",str_eq(first,nsm-str(initial,"text"))),nsm-n("revision_fresh_decode_equal",str_eq(second,nsm-str(revision,"text"))),
  nsm-n("initial_matches_prior_answer",str_eq(first,read_file("receipts/artifacts/2026-09-23-response-prompt/after-answer.txt"))),
  nsm-n("initial_pending",nsm-num(initial,"pending")),nsm-n("revision_pending",nsm-num(revision,"pending")),
  nsm-n("initial_pending_is_stop",q38-stop?(nsm-num(initial,"pending"),fcmg-q35-stops(src))),nsm-n("revision_pending_is_stop",q38-stop?(nsm-num(revision,"pending"),fcmg-q35-stops(src))),
  nsm-n("initial_position",nsm-num(initial,"position")),nsm-n("revision_position",nsm-num(revision,"position")),
  nsm-n("initial_words",fal-count(first)),nsm-n("revision_words",fal-count(second)),nsm-n("fresh_decode_model_admissions",0),nsm-n("fresh_decode_provider_calls",0)));
 let out = "receipts/artifacts/2026-09-23-generation-evidence"; fs-mkdir(out);
 nag-write(nsm-at(out,"generation.json"),raw);
 nsm-write(nsm-at(out,"response.json"),report);
 nsm-write(nsm-at(out,"comparison.json"),compared);
 nag-write(nsm-at(out,"answer.txt"),second);
 print_str(str_concat(json-emit-precise(compared),"\n"));
 let firstExact = str_eq(first,nsm-str(initial,"text"));
 let secondExact = str_eq(second,nsm-str(revision,"text"));
 if and(firstExact,secondExact) then 0 else form_error("retained IDs and fresh decoded text disagree");
}
