// Reconstruct completed tool actions over their frozen resident documents.
// No model, filesystem source edit, continuity write or learning call is made.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class AnswerEditObservation {
  def aeo-walk(state,paths,checker,root,index,observed) {
   if nil?(paths) then {
    nsm-write(nsm-at(root,"observed-stages.json"),json-node-array(reverse(observed)));
    nag-write(nsm-at(root,"observed-candidate.txt"),nth(fat-find-doc(fcap-docs(state),"answer.md"),2));
    print_str(json-emit-precise(json-node-array(reverse(observed))));
   } else {
    let raw = read_file(head(paths)); let next = fcap-step(state,raw,checker);
    let text = nth(fat-find-doc(fcap-docs(next),"answer.md"),2);
    let changed = not(value_eq(fcap-docs(state),fcap-docs(next)));
    let entry = json-node-object(list(nsm-n("reply",index),nsm-s("reply_path",head(paths)),nsm-s("reply_sha256",nsm-hash(raw)),nsm-s("stage",fcap-stage(next)),nsm-n("tool_calls",fcap-calls(next)),nsm-n("checks",fcap-checks(next)),nsm-n("repairs",fcap-failures(next)),nsm-n("documents_changed",changed),nsm-n("words",fal-count(text)),nsm-s("candidate_sha256",nsm-hash(text)),nsm-s("observation",fcap-note(next))));
    if changed then nag-write(nsm-at(root,str_concat("candidate-after-",str_concat(int_to_str(index),".txt"))),text) else 0;
    aeo-walk(next,tail(paths),checker,root,add(index,1),cons(entry,observed));
   };
  }
 }
 let root = ".hearth/answer-edit-2026-09-23"; let request = nsm-json(nsm-at(root,"request.json"));
 let paths = list(".hearth/code-memory/replies/85407-1790137003882.txt",".hearth/code-memory/replies/85407-1790137704650.txt",".hearth/code-memory/replies/85407-1790137742919.txt",".hearth/code-memory/replies/85407-1790137910412.txt",".hearth/code-memory/replies/85407-1790138627552.txt",".hearth/code-memory/replies/85407-1790138691292.txt",".hearth/code-memory/replies/85407-1790138844794.txt",".hearth/code-memory/replies/85407-1790139544879.txt");
 aeo-walk(fcaq-initial(request,fat-wire-value(fat-wire-documents(request))),paths,fcaq-live-checker(request),root,1,list());
}
