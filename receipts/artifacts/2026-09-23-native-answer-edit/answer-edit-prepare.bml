// Give the actual answer and unchanged source packet to the native editor.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/answer-edit-2026-09-23";
 if not(eq(host_dir_mkdir(root),1)) then form_error("answer edit request already retained") else 0;
 let questionPath = "receipts/artifacts/2026-09-23-response-prompt/question.txt";
 let answerPath = "receipts/artifacts/2026-09-23-full-gradient-recompute/answer.txt";
 let question = read_file(questionPath); let answer = read_file(answerPath);
 let docs = list(list("answer","answer.md",answer),list("enquiry-and-sources","enquiry.txt",question));
 let check = parse-json("word-range","{\"kind\":\"word-range\",\"path\":\"answer.md\",\"minimum\":350,\"maximum\":450}");
 let goal = "Revise answer.md into the useful high-level answer requested in enquiry.txt, using its supplied sources. The current answer has 547 words; the required range is 350-450 words including headings. It incorrectly says an old Form cell persists referenced or not. The source says referenced cells persist and unreferenced cells compost; carry that condition consistently through the answer. Preserve coverage of all six requested axes, the distinction between graph identity and Qwen token prediction, explicit translation evidence, and the enquiry covenant. Avoid unsupported baseline comparisons and claims that arithmetic proves felt resonance. Remove repetition and secondary detail while keeping the explanation warm, direct and useful. Change only answer.md. Use the native editing tools; verify returns the actual word-range result so you can revise if needed. Review the entire revised answer against enquiry.txt and finish when the sources, enquiry and length are satisfied. Return the answer through the edited document, without a process audit in its prose.";
 let request = json-node-object(list(nsm-s("goal",goal),json-node-pair("documents",fat-wire-documents-node(docs)),json-node-pair("writable",json-node-array(list(json-node-string("answer.md")))),json-node-pair("checks",json-node-array(list(check))),nsm-s("model","qwen38-q8"),nsm-s("code_entry","direct"),nsm-s("document_context","full"),nsm-n("context",16384),nsm-n("turns",12),nsm-n("max_reply_tokens",1536),nsm-n("evaluation",1)));
 if not(fcaq-request-valid(request)) then form_error("native answer edit request invalid") else 0;
 let baseline = fcaq-check(list(check),docs);
 if head(baseline) then form_error("original length failure was not reproduced") else 0;
 nsm-write(nsm-at(root,"request.json"),request);
 nsm-write(nsm-at(root,"before.json"),json-node-object(list(nsm-s("question_sha256",nsm-hash(question)),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("original_words",fal-count(answer)),nsm-s("length_evidence",nth(baseline,1)),nsm-n("concurrent_learner_alive",nsm-running(hearth-session-learning())),nsm-s("evaluation_scope","actual answer revision; excluded from training; semantic review separate"))));
 print_str(nth(baseline,1));
}
