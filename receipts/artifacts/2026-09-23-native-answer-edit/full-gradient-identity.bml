// Observe exact example identity and completed stages in the existing learner.
// preludes: form-stdlib/native-session-learning.bml
section [form.bml] {
 class FullGradientIdentity {
  def fgi-events(rows) = if nil?(rows) then list() else if fatStage(head(rows)) then cons(head(rows),fgi-events(tail(rows))) else fgi-events(tail(rows));
  def fatStage(row) = nsm-has(list("row-start","row-forward-complete","row-backward-complete","row-complete","round","validation","complete"),nsm-str(row,"stage"));
 }
 let root = ".hearth/answer-edit-2026-09-23";
 let home = hearth-session-learning();
 let dir = nsm-at(home,"rows/ccb671796a21dbd30b2a8fc18d3d304c0eb34db9c24d53bc13d6d21134c67f72");
 let original = oh-get(nsm-json(nsm-at(home,"rows/2cd6d7ff4e62f68c77d6bd1549d9a3d640e082b4b4e78d391d786b70a200dc90/record.json")),"example");
 let rows = nsl-examples(nld-file(nsm-at(dir,"train.jsonl")));
 let before = nsm-json(nsm-at(dir,"before.json"));
 let generation = nag-resolve(nsm-at(dir,"adapter")); let complete = nsm-json(nsm-at(generation,"complete.json"));
 let config = nsm-json(nsm-at(generation,"adapter_config.json"));
 let bytesMatch = and(gt(nsm-num(complete,"adapter_bytes"),0),and(gt(nsm-num(complete,"optimizer_bytes"),0),and(eq(file_size(nsm-at(generation,"adapters.safetensors")),nsm-num(complete,"adapter_bytes")),eq(file_size(nsm-at(generation,"optimizer.safetensors")),nsm-num(complete,"optimizer_bytes")))));
 let events = nse-json-lines(split-on(nsm-text(nsm-at(dir,"adapter/training-events.jsonl")),"\n"));
 let report = json-node-object(list(nsm-s("training_row",dir),nsm-n("training_alive",nlw-running(dir)),nsm-s("parent",nsm-str(before,"parent")),nsm-n("batch_rows",len(rows)),nsm-n("third_example_equals_original",if ge(len(rows),3) then node_eq(nth(rows,2),original) else 0),nsm-s("original_example_sha256",nsm-hash(json-emit-precise(original))),json-node-pair("completed_stages",json-node-array(fgi-events(events))),json-node-pair("result",nsm-json(nsm-at(dir,"result.json")))));
 nsm-write(nsm-at(root,"learning-gradient.json"),report);
 nsm-write(nsm-at(root,"learning-checkpoint.json"),json-node-object(list(nsm-s("generation",generation),nsm-n("native_step",nsm-num(config,"native_step")),nsm-n("checkpoint_bytes_match",bytesMatch),json-node-pair("complete",complete))));
 print_str(json-emit-precise(report));
}
