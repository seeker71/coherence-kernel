// Public native editing task, with its answer and outcomes retained separately.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/answer-edit-2026-09-23";
 nag-write(nsm-at(root,"pid"),int_to_str(host_pid()));
 let started = host_monotonic_ms();
 let raw = fcaq-command(str_concat("@",nsm-at(root,"request.json")));
 let result = parse-json("answer-edit-result",raw);
 nsm-write(nsm-at(root,"result.json"),result);
 let docs = fat-wire-documents(result);
 let answer = if str_eq(fat-wire-error(docs),"") then fat-find-doc(fat-wire-value(docs),"answer.md") else list();
 if nil?(answer) then 0 else nag-write(nsm-at(root,"answer.txt"),nth(answer,2));
 let request = nsm-json(nsm-at(root,"request.json"));
 let checked = if nil?(answer) then list(0,"returned answer absent") else fcaq-check(node_children(oh-get(request,"checks")),fat-wire-value(docs));
 let detail = json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-s("reason",nsm-str(result,"reason")),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started)),nsm-n("generated_ids",nsm-num(result,"generated_ids")),nsm-n("injected_ids",nsm-num(result,"injected_ids")),nsm-n("turns",nsm-num(result,"turns")),nsm-n("tool_calls",nsm-num(result,"tool_calls")),nsm-n("repair_attempts",nsm-num(result,"repair_attempts")),nsm-n("check_runs",nsm-num(result,"check_runs")),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("word_range_passed",head(checked)),nsm-s("word_range_evidence",nth(checked,1)),json-node-pair("words",if nil?(answer) then json-node-null() else json-node-int(fal-count(nth(answer,2)))),nsm-n("provider_calls",0),nsm-s("quality","read returned answer against original enquiry and sources")));
 nsm-write(nsm-at(root,"report.json"),detail);
 print_str(json-emit-precise(detail));
}
