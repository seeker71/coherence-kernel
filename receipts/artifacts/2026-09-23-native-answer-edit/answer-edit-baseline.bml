// The arriving agent's revision stays separate from the native editing input.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 let root = ".hearth/answer-edit-2026-09-23";
 let text = read_file(nsm-at(root,"codex-answer.txt"));
 let request = nsm-json(nsm-at(root,"request.json"));
 let check = fcaq-check(node_children(oh-get(request,"checks")),list(list("answer","answer.md",text)));
 let report = json-node-object(list(nsm-s("source","Codex revision of the same retained draft; full thread context also available"),nsm-n("words",fal-count(text)),nsm-n("word_range_passed",head(check)),nsm-s("check",nth(check,1)),nsm-s("answer_sha256",nsm-hash(text)),nsm-s("native_request_sha256",nsm-hash(read_file(nsm-at(root,"request.json")))),nsm-s("cost_scope","current coordinator turn; measured after completion; includes cached input"),nsm-n("given_to_native_editor",0),nsm-n("training_target",0)));
 nsm-write(nsm-at(root,"codex-report.json"),report);
 print_str(json-emit-precise(report));
}
