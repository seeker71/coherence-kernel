// Return the observed false review claim to the same owned response task.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-26-native-review-counterexample";
 let home = ".hearth/native-review-counterexample";
 let previous = "receipts/artifacts/2026-09-26-native-feedback-continuity";
 let request = nsm-json(nsm-at(previous,"request.json"));
 let prior = nsm-json(nsm-at(previous,"terminal-result.json"));
 let observed = nsm-json(nsm-at(root,"observation.json"));
 let initial = fcaq-initial(request,fat-wire-value(fat-wire-documents(request)));
 let scope = fcam-work-scope(initial,json-emit(oh-get(request,"checks")));
 let packet = fcam-read(fcam-path(hearth-code-memory(),nsm-str(request,"resume"),"checkpoint"));
 if not(fcam-packet-valid(packet,"checkpoint",scope)) then form_error("checkpoint contract invalid") else 0;
 let state = fcam-state-from(packet);
 if not(and(fcam-state-valid(state,initial),and(str_eq(fcap-stage(state),"complete"),eq(nsm-num(prior,"release_ok"),1)))) then form_error("response is not complete and released") else 0;
 let before = nth(fat-find-doc(fcap-docs(state),"answer.md"),2);
 if not(str_eq(nsm-hash(before),nsm-str(observed,"answer_sha256"))) then form_error("observed answer identity changed") else 0;
 let finding = str_concat("The accepted review claims 'and repeated baseline caveat are all removed.' A native rg query of the exact accepted answer contradicts that claim:\n",str_concat(nsm-str(observed,"query_stdout"),"\nCorrect the actual closing so it completes the practical effect of Form's resources on this interaction. It still repeats the missing baseline and reports your intended conduct ('I scope', 'pick warmth', 'default open') instead of completing that explanation. Preserve all six requested axes, the useful corrected numeric-identity paragraph, concrete vocabulary, correct offer lookup, original sources and original checks. Use focused edits of the actual current text. No replacement prose is supplied. Before accepting, use a native read or search on the changed answer to examine the correction in context; report what that observation actually shows. A passed word count or absence of an old exact phrase does not establish that the unwanted meaning was removed. The review must not claim a correction that the answer contradicts."));
 let feedback = json-node-object(list(nsm-s("id","2026-09-26-review-removal-counterexample-v1"),nsm-s("text",finding)));
 let continued = oh-set(oh-set(oh-set(request,"feedback",feedback),"turns",json-node-int(6)),"reasoning_tokens",json-node-int(128));
 if not(and(fcaq-request-valid(continued),and(node_eq(oh-get(request,"checks"),oh-get(continued,"checks")),and(node_eq(oh-get(request,"documents"),oh-get(continued,"documents")),str_eq(nsm-str(request,"goal"),nsm-str(continued,"goal")))))) then form_error("original task contract changed") else 0;
 fs-mkdir(home);
 if not(eq(host_dir_mkdir(nsm-at(home,"claim")),1)) then form_error("repair already has an owner; observe it instead of restarting") else 0;
 frsh-frozen(nsm-at(home,"owner.json"),json-emit(json-node-object(list(nsm-n("pid",host_pid()),nsm-n("started_ms",now_unix_ms()),nsm-s("checkpoint_id",nsm-str(request,"resume"))))));
 frsh-frozen(nsm-at(root,"request.json"),json-emit(continued));
 frsh-frozen(nsm-at(root,"feedback.txt"),finding);
 frsh-frozen(nsm-at(root,"admitted-context.json"),json-emit(json-node-object(list(nsm-s("meaning",fqt-meaning-prefix()),nsm-s("edit_guidance",fat-edit-guidance()),nsm-s("review_instruction",fcap-instruction(fcap-note-at(state,"review","current document review")))))));
 print_str("native-response-care: exact review counterexample retained; waiting for the shared learner before model admission");
 nsm-settle-exit(nsm-settle(hearth-session-learning()));
 if nsm-running(hearth-session-learning()) then form_error("learner still owns model resources") else 0;
 let started = now_unix_ms();
 print_str("native-response-care: continuing the same response with current-source review evidence and 128 reasoning tokens per reply");
 let raw = fcaq-command(json-emit(continued));
 let elapsed = sub(now_unix_ms(),started);
 frsh-frozen(nsm-at(root,"terminal-result.json"),raw);
 let result = parse-json("response-result",raw);
 let returned = fat-wire-documents(result);
 if not(str_eq(fat-wire-error(returned),"")) then form_error("returned source documents unavailable; terminal result retained") else 0;
 let docs = fat-wire-value(returned);
 let answer = nth(fat-find-doc(docs,"answer.md"),2);
 let checks = fcaq-check(json-array-elements(oh-get(request,"checks")),docs);
 let query = fat-call(docs,"rg",list("-n","baseline","answer.md"),"");
 let reportText = nsm-str(result,"report");
 let review = if faj-valid(reportText) then parse-json("retained-review",reportText) else json-node-null();
 let currentReview = and(str_eq(nsm-str(review,"schema"),"native-coding-review-v1"),and(str_eq(nsm-str(review,"goal_sha256"),nsm-hash(nsm-str(request,"goal"))),node_eq(oh-get(review,"documents"),json-node-array(fcap-document-catalog(docs)))));
 let comparison = json-node-object(list(nsm-s("status",nsm-str(result,"status")),nsm-s("checkpoint_id",nsm-str(result,"checkpoint_id")),nsm-n("before_words",fal-count(before)),nsm-n("after_words",fal-count(answer)),nsm-n("original_checks_passed",head(checks)),nsm-s("check_evidence",nth(checks,1)),nsm-n("readonly_preserved",fcap-readonly-preserved(fat-wire-value(fat-wire-documents(request)),docs,fcap-array(request,"writable"))),nsm-n("current_review",currentReview),nsm-n("release_ok",nsm-num(result,"release_ok")),nsm-n("new_turns",sub(nsm-num(result,"turns"),nsm-num(prior,"turns"))),nsm-n("new_tool_calls",sub(nsm-num(result,"tool_calls"),nsm-num(prior,"tool_calls"))),nsm-n("new_checks",sub(nsm-num(result,"check_runs"),nsm-num(prior,"check_runs"))),nsm-n("generated_ids_this_admission",nsm-num(result,"generated_ids")),nsm-n("injected_ids_this_admission",nsm-num(result,"injected_ids")),nsm-n("request_wall_ms_after_learning_settled",elapsed),nsm-n("weight_training_excluded",nsm-num(result,"weight_training_excluded")),nsm-s("answer_sha256",nsm-hash(answer)),nsm-n("baseline_occurrences",ne-count(answer,"baseline")),nsm-n("baseline_query_exit",fat-exit(query)),nsm-s("baseline_query_stdout",fat-out(query)),nsm-s("scope","Same response and original checks, with a fresh exact review counterexample and revised native review instruction. Reasoning allowance changed from 512 to 128 per reply. Read the answer and its review; these conditions do not establish parity, felt resonance, or a controlled latency comparison.")));
 frsh-frozen(nsm-at(root,"answer.txt"),answer);
 frsh-frozen(nsm-at(root,"comparison.json"),json-emit(comparison));
 frsh-frozen(nsm-at(root,"review.json"),json-emit(json-node-object(list(nsm-n("current_review",currentReview),nsm-s("text",reportText)))));
 print_str(json-emit(comparison));
}
