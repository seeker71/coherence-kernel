// Check a completed review's removal claim against its exact accepted document.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-response-resource.bml
section [form.bml] {
 let root = "receipts/artifacts/2026-09-26-native-review-counterexample";
 let previous = "receipts/artifacts/2026-09-26-native-feedback-continuity";
 let result = nsm-json(nsm-at(previous,"terminal-result.json"));
 let returned = fat-wire-documents(result);
 if not(str_eq(fat-wire-error(returned),"")) then form_error("accepted documents unavailable") else 0;
 let docs = fat-wire-value(returned);
 let doc = fat-find-doc(docs,"answer.md");
 let review = parse-json("completed-native-review",nsm-str(result,"report"));
 let comparison = nsm-json(nsm-at(previous,"comparison.json"));
 if not(and(eq(nsm-num(comparison,"current_review"),1),and(eq(nsm-num(result,"release_ok"),1),str_eq(fat-document-sha(doc),"bd8abbec45af64fc12b4d094655e864cb679a959d3b1d8b5a5d0451ee83187d1")))) then form_error("review or document identity changed") else 0;
 let quote = "and repeated baseline caveat are all removed.";
 if lt(str_find(nsm-str(review,"reason"),quote,0),0) then form_error("observed review claim changed") else 0;
 let query = fat-call(docs,"rg",list("-n","baseline","answer.md"),"");
 let matches = ne-count(nth(doc,2),"baseline");
 if not(and(eq(fat-exit(query),0),eq(matches,2))) then form_error("original counterexample changed") else 0;
 let reading = json-node-object(list(nsm-s("review_verdict",nsm-str(review,"verdict")),nsm-s("review_claim",quote),nsm-s("answer_sha256",fat-document-sha(doc)),nsm-n("original_checks_passed",nsm-num(comparison,"original_checks_passed")),nsm-n("query_exit",fat-exit(query)),nsm-s("query_stdout",fat-out(query)),nsm-n("literal_occurrences",matches),nsm-s("finding","The accepted answer states the absent baseline near its beginning and again in its closing. The retained review claims that repetition was removed. The exact source contradicts that review claim; passing the existing checks did not establish this correction.")));
 frsh-frozen(nsm-at(root,"observation.json"),json-emit(reading));
 print_str(json-emit(reading));
}
