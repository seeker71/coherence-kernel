// A concrete source correction on the original enquiry and retained answer.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-generate-command.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 class FidelityRepair {
  def fr-values(xs) = if nil?(xs) then list() else cons(node_value(head(xs)),fr-values(tail(xs)));
  def fr-ids(node,key) = fr-values(node_children(json-object-get(node,key)));
  def fr-save(root,name,node) = if fgcr-keep(root,name,json-emit-precise(node)) then 1 else form_error("fidelity repair evidence retention failed");
 }
 let root = ".hearth/fidelity-repair-2026-09-23";
 if nsm-running(hearth-session-learning()) then form_error("learner still owns resources") else 0;
 if not(eq(host_dir_mkdir(root),1)) then form_error("fidelity repair directory already exists") else 0;
 let prior = nsm-json("receipts/artifacts/2026-09-23-continuation-replay/prefix.json");
 let old = nsm-json("receipts/artifacts/2026-09-23-generation-evidence/response.json");
 let original = json-object-get(nsm-json("receipts/artifacts/2026-09-23-generation-evidence/generation.json"),"initial");
 let path = nsm-str(prior,"model"); let started = host_monotonic_ms();
 if not(eq(qaf-seal-verdict(path),1)) then form_error("fidelity model seal refused") else 0;
 let src = fcmg-src(path); let crystal = qsx-load(path);
 if not(and(eq(nth(crystal,0),1),mr-wired?(fcmg-arch(src)))) then form_error("fidelity model or tokenizer unavailable") else 0;
 let correction = "Revise your preceding answer to Urs's original enquiry. Three source corrections are needed.\n1. Your opening says 'Form shifts interaction from prediction to witnessing.' Qwen still predicts output token IDs. Form supplies executable grounding, retrieval and observation that inform and check an answer; these do not replace model prediction. Explain that concrete contribution consistently.\n2. You wrote 'The response serves engagement'. The supplied covenant says 'Serve the enquiry, never the engagement.' Trust over fear means acting usefully from the person's intent through offered interfaces. Apply that distinction to how you answer.\n3. Your final paragraph declares the answer complete, useful, grounded and clear. Remove this self-assessment and use that space to explain a practical consequence for the person.\nKeep the original source distinctions: three states including absence; identity versus labels and model tokens; dictionary senses versus translated surfaces; supplied numeric annotations versus felt resonance. Include the actual vocabulary example already supplied. Return the complete high-level review in 350-450 words, with warmth and direct language. Return only the revised answer; do not report this correction process.";
 let closed = fcms-crossing-prefix-ids(nsm-num(original,"pending"),q38-stop?(nsm-num(original,"pending"),fcmg-q35-stops(src)),q35-special-id(src,"<|im_end|>"),1);
 let encoded = fcmo-direct-tail-ids(path,correction);
 if nothing?(encoded) then form_error("fidelity feedback tokenizer unavailable") else 0;
 let feedbackIds = append(closed,encoded);
 let prefix = append(fr-ids(prior,"prompt_ids"),append(fr-ids(prior,"answer_ids"),feedbackIds));
 let capacity = nsm-num(old,"context"); let allowance = nsm-num(old,"answer_allowance");
 if not(lt(add(len(prefix),allowance),capacity)) then form_error("fidelity response reserve absent") else 0;
 fr-save(root,"request.json",json-node-object(list(nsm-s("correction_author","Codex using supplied source"),nsm-s("model",path),nsm-s("correction",correction),nsm-n("original_prompt_and_answer_unchanged",1),json-node-pair("feedback_ids",json-node-array(oh-ints(feedbackIds))),nsm-n("prefix_ids",len(prefix)),nsm-n("allowance",allowance))));
 let reading = oh-reading("native-generation",root,"source-fidelity",json-node-string("source-faithful response to the original enquiry"),json-node-string("prediction/witnessing contradiction, engagement reversal and self-assessment"),json-node-int(0),list(oh-need("specific-source-correction",oh-reference("receipts/2026-09-23-generation-evidence.md"))),list("revise-from-cited-errors"),json-node-object(list(nsm-n("prefix_ids",len(prefix)),nsm-n("feedback_ids",len(feedbackIds)))));
 oh-voice(reading); let response = oh-response(reading,"revise-from-cited-errors"); oh-voice(response);
 if not(str_eq(oh-select(reading,response,""),"revise-from-cited-errors")) then form_error("fidelity control uncorrelated") else 0;
 let session = fcms-open-context(path,src,capacity,len(prefix),list(),prefix,0,crystal,1);
 if not(frbg-valid-session(session)) then { fcms-release-ok?(session); form_error(fcms-reason(session)); } else 0;
 let generated = fcms-generate(session,allowance); let last = fcms-generation-session(generated);
 let released = fcms-release-ok?(last); let answer = fcms-generation-text(generated);
 fr-save(root,"generation.json",fgcr-generation-evidence(generated));
 if not(fgcr-keep(root,"answer.txt",answer)) then form_error("fidelity answer retention failed") else 0;
 let result = json-node-object(list(nsm-n("generated_ids",len(fcms-generation-ids(generated))),nsm-n("ids_equal_initial",value_eq(fcms-generation-ids(generated),fr-ids(original,"ids"))),nsm-n("text_equal_initial",str_eq(answer,nsm-str(original,"text"))),nsm-n("words",fal-count(answer)),nsm-n("word_range_passed",fal-within(fal-count(answer),350,450)),nsm-n("complete",frbg-stopped(last)),nsm-n("release_ok",released),nsm-n("provider_calls",0),nsm-s("semantic_quality","read-the-retained-answer"),nsm-n("elapsed_ms",sub(host_monotonic_ms(),started))));
 fr-save(root,"result.json",result); oh-voice(oh-applied(reading,"revise-from-cited-errors",result)); print_str(str_concat(json-emit-precise(result),"\n"));
 if released then 0 else form_error("fidelity release incomplete");
}
