#!/usr/bin/env bash
# ftimeout SECONDS command [args...] — portable timeout for macOS (no GNU coreutils).
# Kills the command after SECONDS; exits 124 on timeout (like GNU timeout), else the
# command's own exit code. Provided because macOS lacks `timeout` and we hit it constantly.
# Plain shell: the command runs as a child with this process's stdin, and a tenth-of-a-second
# watch on it ends it with KILL once the seconds are spent. (A form-native seed primitive —
# fk_host_exec with a deadline — is the hardening, tracked separately.)
# Exit codes, one rule: 124 when the deadline ended it; otherwise the child's own status, and a
# child that a signal ended exits 128+n (the shell's rule: 143 for TERM, 137 for KILL). When a
# signal ended the child by itself, bash prints its own "Terminated: <n>" notice on stderr: that
# line is the shell's report of the death, not the child's output.
secs="${1:-}"
if [[ -z "$secs" ]]; then echo "usage: ftimeout SECONDS command [args...]" >&2; exit 2; fi
if ! [[ "$secs" =~ ^[0-9]+$ ]]; then echo "ftimeout: first arg must be seconds" >&2; exit 2; fi
shift
if [[ $# -eq 0 ]]; then echo "usage: ftimeout SECONDS command [args...]" >&2; exit 2; fi
"$@" <&0 &
pid=$!
ticks=0
limit=$((secs * 10))
while kill -0 "$pid" 2>/dev/null; do
    if [[ $ticks -ge $limit ]]; then
        kill -KILL "$pid" 2>/dev/null
        { wait "$pid"; } 2>/dev/null
        exit 124
    fi
    sleep 0.1
    ticks=$((ticks + 1))
done
{ wait "$pid"; } 2>/dev/null
exit $?
