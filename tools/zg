#!/bin/sh
# Form-native zg: query-time workspace search through rg, BM25, vector, or RRF hybrid.
# Usage: tools/zg QUERY [ROOT] [rg|fts|vector|hybrid] [LIMIT]
set -eu

if [ "$#" -lt 1 ]; then
  printf '%s\n' 'usage: tools/zg QUERY [ROOT] [rg|fts|vector|hybrid] [LIMIT]' >&2
  exit 2
fi

query=$1
root=${2:-.}
route=${3:-hybrid}
limit=${4:-7}
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

cd "$here"
printf '%s\n' "$root" "$route" "$query" "$limit" | ./fkwu observe/zvec-grep-run.fk
