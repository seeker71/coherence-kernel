<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>earth.hati.coherence.rent-walk</string>
  <!-- The body's own kernel, run by the host's own scheduler. No shell reads
       this: the request is a file the repository owns, handed in on stdin, and
       the movement door does the rest — compose, speak, read the flow, redraw
       the page, gate, commit, push. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ursmuff/source/coherence-kernel/fkwu</string>
    <string>observe/movement-run.bml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ursmuff/source/coherence-kernel</string>
  <key>StandardInPath</key>
  <string>/Users/ursmuff/source/coherence-kernel/host/launchd/nightly-movement.json</string>
  <key>StandardOutPath</key>
  <string>/Users/ursmuff/source/coherence-kernel/.hearth/rent-walk.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ursmuff/source/coherence-kernel/.hearth/rent-walk.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
