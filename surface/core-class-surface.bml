; core-class-surface.bml - the core stdlib as its class surface, authored as generic abstractions in the BML
; maintenance dialect.
;
; The stdlib travels as four generic classes — Num<T>, List<T>, Cell<T>,
; Task<T> — plus two cross-cutting top-level defs. A plain generic class is an
; organizing abstraction: each method hoists to a BARE top-level fndef (built by
; the same def lowerer a flat `def` rides, so the runtime recipe is unchanged),
; and the class name binds to a nullary descriptor `(Name)` so
; the abstraction stays a queryable value. The type parameter is a contract that
; erases. Callers use the bare names exactly as before.
;
; Kernel execution receives lowered Form objects. Source sections are compiled
; by form-stdlib/source-compiler.fk before kernels walk source or binary form.

section [form.bml] {
    // the identity arrow — used across every abstraction (Task threads it as a
    // resolved continuation), so it rests above the classes.
    def identity(x) = x;

    // Num<T> — numeric predicates, closures, and helpers over a number.
    class Num<T> {
        def even?(n) = (Comparable) (n % 2) == 0;
        def odd?(n) = (Comparable) (n % 2) == 1;
        def zero?(n) = (Comparable) n == 0;
        def positive?(n) = n > 0;
        def negative?(n) = n < 0;
        def plus(a, b) = a + b;
        def minus(a, b) = a - b;
        def times(a, b) = a * b;
        def divide(a, b) = a / b;
        def abs(n) = negative?(n) ? (0 - n) : n;
        def min2(a, b) = a < b ? a : b;
        def max2(a, b) = a > b ? a : b;
    }

    // List<T> — traversal, shape transforms, and aggregation over a list. The
    // aggregators lean on Num (plus/times/min2/max2), so List rests below Num.
    class List<T> {
        def nil?(xs) = (Comparable) xs == empty();
        def map(f, xs) = nil?(xs) ? empty : cons(f(xs[0]), map(f, xs[1:]));
        def filter(pred, xs) = nil?(xs) ? empty : pred(xs[0]) ? cons(xs[0], filter(pred, xs[1:])) : filter(pred, xs[1:]);
        def foldl(f, init, xs) = nil?(xs) ? init : foldl(f, f(init, xs[0]), xs[1:]);
        def foldr(f, init, xs) = nil?(xs) ? init : f(xs[0], foldr(f, init, xs[1:]));
        def range(start, end) = start >= end ? empty : cons(start, (start + 1) .. end);
        def append(xs, ys) = nil?(xs) ? ys : cons(xs[0], append(xs[1:], ys));
        def take(n, xs) = (n <= 0) || nil?(xs) ? empty : cons(xs[0], take(n - 1, xs[1:]));
        def drop(n, xs) = n <= 0 ? xs : nil?(xs) ? empty : drop(n - 1, xs[1:]);
        def nth(xs, n) = (Comparable) n == 0 ? xs[0] : xs[1:][n - 1];
        def cons-flip(acc, x) = cons(x, acc);
        def reverse(xs) = foldl(cons-flip, empty, xs);
        def sum(xs) = foldl(plus, 0, xs);
        def product(xs) = foldl(times, 1, xs);
        def maximum(xs) = foldl(max2, xs[0], xs[1:]);
        def minimum(xs) = foldl(min2, xs[0], xs[1:]);
        def any?(pred, xs) = nil?(xs) ? false : pred(xs[0]) ? true : any?(pred, xs[1:]);
        def all?(pred, xs) = nil?(xs) ? true : pred(xs[0]) ? all?(pred, xs[1:]) : false;
    }

    // Cell<T> — a reversible cell: kind, value, origin, and an inverse that
    // undoes it. The substrate's smallest unit of reversible state.
    class Cell<T> {
        def cell(kind, value, origin, inverse) = ["cell", kind, value, origin, inverse];
        def cell?(c) = (len(c) > 0) && ((String) c[0] == "cell");
        def cell-kind(c) = c[1:][0];
        def cell-value(c) = c[1:][1:][0];
        def cell-origin(c) = c[1:][1:][1:][0];
        def cell-inverse(c) = c[1:][1:][1:][1:][0];
        def cell-undo(c) {
            let inverse = cell-inverse(c);
            inverse(c);
        }
        def cell-do(c) = cell-value(c);
    }

    // Task<T> — an async cell over Cell: a (state, value, continuation) triple
    // that resolves, rejects, awaits, and steps. Rests below Cell (it is one)
    // and below List (it reads its triple with nth).
    class Task<T> {
        def task-undo(t) = cell-origin(t);
        def task-cell(state, value, cont, origin, inverse) = cell("task", [state, value, cont], origin, inverse);
        def task?(t) = cell?(t) && ((String) cell-kind(t) == "task");
        def task-state(t) = cell-value(t)[0];
        def task-value(t) = cell-value(t)[1];
        def task-cont(t) = cell-value(t)[2];
        def task-pending(origin, cont) = task-cell("pending", empty, cont, origin, task-undo);
        def task-resolved(value) = task-cell("resolved", value, identity, empty, task-undo);
        def task-failed(failure) = task-cell("failed", failure, identity, empty, task-undo);
        def task-resolve(t, value) = task-cell("resolved", value, task-cont(t), cell-origin(t), cell-inverse(t));
        def task-reject(t, failure) = task-cell("failed", failure, task-cont(t), cell-origin(t), cell-inverse(t));
        def task-await(t) = (String) task-state(t) == "resolved" ? task-value(t) : t;
        def task-step(t) {
            let cont = task-cont(t);
            (String) task-state(t) == "resolved" ? cont(task-value(t)) : t;
        }
        def task-ready?(t) = (String) task-state(t) == "resolved";
        def task-failed?(t) = (String) task-state(t) == "failed";
    }

    // assertion — pred holds or the kernel halts. Form has no halt-with-
    // message native; head(empty) panics in every kernel, which surfaces
    // the failure at the assert site. msg is reader hint for the human
    // reading the test; the panic message will point at this line.
    def assert(pred, msg) = pred ? 0 : empty[0];

    0;
}
