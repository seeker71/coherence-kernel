.form-cli-turn-rollout
.form-cli-rented-turn-meter-state
.form-cli-turn-evidence-target
.form-cli-turn-evidence-progress
.form-cli-turn-evidence-row
.form-cli-turn-evidence-candidate
.form-cli-turn-evidence-discovery
.form-cli-turn-evidence-start-discovery
.form-cli-turn-evidence-latest-validation
.form-cli-turn-grok-session
.form-cli-turn-cursor-transcript

# fkwu admits Metal dynamically in the same process. Separate Metal executables
# are local artifacts; the seed does not link the Metal framework.
fkwu-metal

# v3 heldout consent is a per-run act, not a checkout property (9f954a02)
.form-knowledge-qwen-heldout-v3-consent

# zerofam resume ledger, per-sitting
observe/.zerofam-done
*.bml.fk
*.bml.fkb
*.bml.sym
.hearth/
# Captured speech and per-run transcripts are local material.
/.form-lora-voice-native/stt/
.form-heal/
*.bml.lowfk
*.fk.lowfk
*.fkwu-heat
.fkwu-heat
.fkwu-heat.*
.fkwu-boxing.*
