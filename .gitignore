.DS_Store
.claude/

# obsidian vault window (SECOND-BRAIN.md): commit only the shared door
# settings; workspace/cache/plugins are per-witness, never the commons'
.obsidian/*
!.obsidian/app.json
!.obsidian/graph.json
fkwu
fkwu.exe
win-witness/
fkwu-cam-frame.bmp
fkwu-cam-frame.png
walkers/go/walker
gowalker.exe
fkwu.exe
/nvr.fk
/t.fk
/tiny.fk
*.flat
audio-training-runs/

# local runtime config (never commit -- read at startup, would change behavior)
fkwu.conf

# learned native model checkpoints are local runtime state, not source fixtures
.form-native-adaptive-model.state
.form-native-neutral-dictionary.state
.form-native-inquiry-ledger.tsv
.form-scripture-knowledge.state
.form-scripture-transmutation.state
.form-scripture-evidence-v2.state
.form-scripture-model-v3.state
.form-scripture-coverage-v4.state
.form-scripture-model-v4.state
.form-core-inquiry-cascade-v5.state
.form-core-model-v5.state
.form-serializer-shape-learning.state
.form-scripture-coverage-v6.state
.form-core-model-v6.state
.form-scripture-frequency-reemit-v7.state

# tool build cache (compiled artifacts; regenerable)
.forge/

# program-image artifacts fkwu emits beside any .fk it runs (regenerable;
# fkwu recompiles stale/missing ones -- like the fkwu binary, never committed)
*.fkb
*.sym

# the door's circle store: consented visitor memory is held by the BODY, never
# published to the public repo -- remembering is not publishing
# (plugin/chatgpt-plugin.fk's memory doors; reception-consent-policy.form)
plugin/circle/
plugin/circle-introductions/
__pycache__/
*.py[cod]
*-shelf.txt
