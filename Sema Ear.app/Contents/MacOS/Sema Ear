#!/bin/sh
# Sema Ear — the ear's principal. Launched through LaunchServices (open -n) so the
# microphone grant binds to this bundle, not to a terminal. Reads its request from
# .hearth/ear.request (seconds, language hint), runs the STT door from the repo root,
# answers into .hearth/ear.out and marks .hearth/ear.done.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
cd "$ROOT" || exit 1
mkdir -p .hearth; rm -f .hearth/ear.done
./fkwu observe/stt-oracle-run.fk < .hearth/ear.request > .hearth/ear.out 2>&1
date > .hearth/ear.done
