; gen-source-walker-table.fk — emit runtime/fkwu-optable.h from the ONE op table.
;
; The C source-walker (runtime/fkwu-uni.c fk_sparse) used to carry a hand-written
; `if (fk_sym_eq(s, hn, "head")) ...` line per op. That is the carrier-last smell:
; every new op was another C edit. The single source of truth for (name arity tag)
; is flt-ops in flatten/form-flatten.fk (hand-maintained — a native-op-manifest.fk
; generator was named once but never came across). This recipe reads that SAME table and
; the small rewrite-rule table below, and emits a C header the runtime #includes.
; Adding a value op = a manifest row -> a flt-ops row -> regen -> an fkc-flat
; arm in form/form-stdlib/fkc-table-serialize.fk; NEVER a C edit. The fourth
; mirror is the one this line used to leave un-named, and the un-named mirror
; collected the wounds: node_at (147) and method_define (197), added by two
; hands the same day (2026-09-02) through this recipe when it counted three
; steps, both fell to the BINARY fallback there — an op without its own
; fkc-flat arm serializes at the wrong arity. Unary takes an fkc-un2 arm (or
; joins the tail or-group), ternary fkc-tri2, nullary a leaf row; only binary
; rides the fallback as-is. The gate that names a missed arm has no pre-merge
; wire — it speaks only when run by hand:
;   python3 form/scripts/validate_fkwu_native_surface.py    (also validate.sh phase 0)
;
; Run on the bootstrap kernel (the executor, like bin-go was for flt-ops). This
; recipe's ACTION is the write: its final form is
;   (write_file "runtime/fkwu-optable.h" (header))
; — write_file is a host-io op (tag 104) the source-walker runtime already
; carries, so the recipe IS the whole regeneration; no shell stdout-capture.
; flt-ops lives in form-flatten.fk; the splice that brings it into scope is done
; in PURE FORM by flatten/gen-source-walker.fk (read_file + str_find/substring,
; no grep/sed/awk). Regeneration is two fkwu calls, zero bash, from repo root:
;   fkwu flatten/gen-source-walker.fk          ; splice -> /tmp/gen-source-walker-combined.fk
;   fkwu /tmp/gen-source-walker-combined.fk     ; this generator -> runtime/fkwu-optable.h
; The combined driver re-opens one (do over the spliced flt-ops + this recipe's
; body. The output is committed (same discipline as flt-ops: GENERATED, do not
; hand-edit; both the flattener and the source-walker read the ONE table).
;
; Two generated tables:
;   1. fk_optab[]  — (name,arity,tag) primitive rows. The generic dispatch in
;      fk_sparse reads arity args and emits fk_smknode(tag, ...). Pure data.
;   2. fk_rwtab[]  — (name,arity,template) rewrite rules. A rewrite LOWERS to a
;      shape of existing nodes (gt/ge/lt/eq/and/or/not/abs), mirroring the
;      flattener's flt-low rules. The template is a flat int program the generic
;      C instantiator walks: [PROG ...] where each op is one of
;        ARG i        -> the i-th parsed operand              (encoded 0 i)
;        LIT v        -> a literal node fk_smklit(v)          (encoded 1 v)
;        NODE t n     -> build fk_smknode(t, <n popped kids>) (encoded 2 t n)
;      The program is POSTFIX (RPN): children are emitted before the NODE that
;      consumes them, so a single left-to-right pass with a small stack builds
;      the tree. This is the SAME lowering vocabulary the flattener uses (if/le/
;      sub on tags 6/5/4, lt/eq on 103/102), expressed as data instead of C.

(do
    ; ── 1. the primitive op rows, straight from flt-ops (the manifest's table) ──
    ; Each row is (name arity tag). Only the control forms (defn/do/let/if) keep
    ; their own fk_sparse handling (special eval semantics). Every VALUE form flows
    ; through the generic dispatch as data — including (empty) (arity 0 -> tag 18)
    ; and (list ..) (arity -1 VARIADIC -> fold via cons/19, nil-terminated).
    (defn rows () (flt-ops))

    ; ── 2. the rewrite rules — name, arity, RPN template (see header note) ──
    ; ARG i = (list 0 i)  LIT v = (list 1 v)  NODE t n = (list 2 t n)
    ; gt(a,b) = if(le a b) 0 1   ge(a,b) = le b a   lt = tag103   eq = tag102
    ; and(a,b)= if a (if b 1 0) 0   or(a,b)= if a 1 (if b 1 0)
    ; not(a)  = if a 0 1           abs(a) = if(le 0 a) a (sub 0 a)
    (defn rwa () (list 0 0))
    (defn rwb () (list 0 1))
    (defn rwc () (list 0 2))
    (defn lit0 () (list 1 0))
    (defn lit1 () (list 1 1))
    (defn rwrules ()
        (list
            ; gt: a b le(2) -> if(6) lit0 lit1            cond then else
            (list "gt" 2 (list (rwa) (rwb) (list 2 5 2) (lit0) (lit1) (list 2 6 3)))
            ; ge: b a le(2)  (le b a)
            (list "ge" 2 (list (rwb) (rwa) (list 2 5 2)))
            ; lt: a b -> tag 103
            (list "lt" 2 (list (rwa) (rwb) (list 2 103 2)))
            ; eq: a b -> tag 102
            (list "eq" 2 (list (rwa) (rwb) (list 2 102 2)))
            ; and: a (b 1 0 if) 0 if   = if a (if b 1 0) 0
            (list "and" 2 (list (rwa) (rwb) (lit1) (lit0) (list 2 6 3) (lit0) (list 2 6 3)))
            ; or: a 1 (b 1 0 if) if    = if a 1 (if b 1 0)
            (list "or" 2 (list (rwa) (lit1) (rwb) (lit1) (lit0) (list 2 6 3) (list 2 6 3)))
            ; not: a 0 1 if            = if a 0 1
            (list "not" 1 (list (rwa) (lit0) (lit1) (list 2 6 3)))
            ; ne: a b eq(102) -> if(6) lit0 lit1   = if (eq a b) 0 1  -- the sibling kernels' compare verb
            (list "ne" 2 (list (rwa) (rwb) (list 2 102 2) (lit0) (lit1) (list 2 6 3)))
            ; the float-NodeID surface: four sibling natives lower onto ONE walker arm,
            ; float_leaf (tag 201, arity 2): mode then operand. A literal mode selects the door.
            ;   float_value n   = (float_leaf 0 n)     make_float32 x = (float_leaf 1 x)
            ;   make_float64 x  = (float_leaf 2 x)     math_pi        = (float_leaf 3 0)
            (list "float_value" 1 (list (lit0) (rwa) (list 2 201 2)))
            (list "make_float32" 1 (list (lit1) (rwa) (list 2 201 2)))
            (list "make_float64" 1 (list (list 1 2) (rwa) (list 2 201 2)))
            (list "math_pi" 0 (list (list 1 3) (lit0) (list 2 201 2)))
            ; the binary form (FORMBIN2) and the value witness: five more sibling natives on the
            ; same door, modes 4-8 -- the tag space is full and 150 is the native-surface probe.
            ;   value_kind v        = (float_leaf 4 v)    recipe_to_bytes r  = (float_leaf 5 r)
            ;   bytes_to_recipe bs  = (float_leaf 6 bs)   read_form_binary p = (float_leaf 7 p)
            ;   write_form_binary p r = (float_leaf 8 (cons p r))   -- one operand: the pair
            (list "value_kind" 1 (list (list 1 4) (rwa) (list 2 201 2)))
            (list "value-kind" 1 (list (list 1 4) (rwa) (list 2 201 2)))
            (list "recipe_to_bytes" 1 (list (list 1 5) (rwa) (list 2 201 2)))
            (list "bytes_to_recipe" 1 (list (list 1 6) (rwa) (list 2 201 2)))
            (list "read_form_binary" 1 (list (list 1 7) (rwa) (list 2 201 2)))
            (list "write_form_binary" 2 (list (list 1 8) (rwa) (rwb) (list 2 19 2) (list 2 201 2)))
            ; substring (mode 9) — the string slice, the one door under char_at,
            ; str_find, split-on and trim, and 847 call sites here. It was tag 29
            ; until 2026-07-01, when it became Form composition over the narrow
            ; waist (fstr-substring-halve in core.fk); the recipe is correct and
            ; it is 90x slower than str_concat on the same bytes, because cutting
            ; 192 kB costs ~384,000 interpreted str_byte_at/byte_to_str/str_concat
            ; calls. Tag 29 is mlx_live now and every tag 0..255 carries an arm,
            ; so this rides the leaf door like modes 4-8 rather than taking 150,
            ; which this file has reserved as the native-surface probe since the
            ; binary form landed.
            ;   substring s a b = (float_leaf 9 s (cons a b))
            ; NODE 201 3 fills the leaf node's THIRD child — the shape the arm
            ; reads back without allocating a pair (fk_node[i][3] is a tag-19
            ; node, walked child by child). A hand-written (float_leaf 9 x) has
            ; arity 2, leaves that child 0, and answers nothing: never-was.
            (list "substring" 3 (list (list 1 9) (rwa) (rwb) (rwc) (list 2 19 2) (list 2 201 3)))
            ; the SPEAKING family — seven names, modes 10-16 of the SAME leaf door, and
            ; NO NEW TAG. Until 2026-09-08 every sense_* row in this table pointed inward:
            ; the body could hear a room and had no door that made a sound, so its own
            ; voice went out through afplay. The mouth wanted a tag family of its own and
            ; the space had none to give. 0 is not a tag; 150 is the probe reserved above;
            ; and 190 — the one number a census of `if (t == N)` sites calls free — is
            ; FK_TAG_CONST_HOLD, spelled only by a #define. A first cut took it, and every
            ; door answered its own MODE back, because the once-hold walks a node's first
            ; child and returns it. So the mouth rides the leaf door like modes 4-9.
            ; The RATE is carried and not assumed. The ear's wire is 16 kHz and fixed;
            ; the mouth's is not — piper renders this body's own voice at 22050 Hz, and
            ; through a 16 kHz queue that comes back a fourth low and 1.38x slow. So the
            ; two plain names are rewrites that fill in 16000, and _at names carry it.
            ; Mode 13's operand is a cons pair, the shape write_form_binary already uses
            ; to carry two things through a one-operand door.
            ;   sense_speaker_count          = (float_leaf 10 0)
            ;   sense_speaker_name i         = (float_leaf 11 i)
            ;   sense_speaker_health i       = (float_leaf 12 i)
            ;   sense_speaker_play s         = (float_leaf 13 (cons s 16000))
            ;   sense_speaker_play_at s hz   = (float_leaf 13 (cons s hz))
            ;   sense_speaker_stream_start   = (float_leaf 14 16000)
            ;   sense_speaker_stream_start_at hz = (float_leaf 14 hz)
            ;   sense_speaker_stream_write s = (float_leaf 15 s)
            ;   sense_speaker_stream_stop    = (float_leaf 16 0)
            (list "sense_speaker_count" 0 (list (list 1 10) (lit0) (list 2 201 2)))
            (list "sense_speaker_name" 1 (list (list 1 11) (rwa) (list 2 201 2)))
            (list "sense_speaker_health" 1 (list (list 1 12) (rwa) (list 2 201 2)))
            (list "sense_speaker_play" 1
                (list (list 1 13) (rwa) (list 1 16000) (list 2 19 2) (list 2 201 2)))
            (list "sense_speaker_play_at" 2
                (list (list 1 13) (rwa) (rwb) (list 2 19 2) (list 2 201 2)))
            (list "sense_speaker_stream_start" 0 (list (list 1 14) (list 1 16000) (list 2 201 2)))
            (list "sense_speaker_stream_start_at" 1 (list (list 1 14) (rwa) (list 2 201 2)))
            (list "sense_speaker_stream_write" 1 (list (list 1 15) (rwa) (list 2 201 2)))
            (list "sense_speaker_stream_stop" 0 (list (list 1 16) (lit0) (list 2 201 2)))
            ; the doors that END THE SHELL — modes 17-19 of the SAME leaf door, and again
            ; NO NEW TAG. On 2026-09-09 observe/form-glass-ear-live.fk still stood its two
            ; lanes through `sh -c`, and not to run a shell program: only to say where the
            ; child's three standard streams go, because host_spawn_quiet hands a child the
            ; PARENT'S own stdin and a lane born on a terminal sits at its first read
            ; forever (corpus row 1339 mutebirth). The same cell asked `kill -0` through a
            ; second fork every two seconds to learn whether a pid still answered, and made
            ; its two fifo bells through a third. The reasons were all sound; the shell was
            ; furniture. host_spawn / host_spawn_quiet / host_wait / host_kill were a family
            ; with a missing sibling.
            ;   host_spawn_at argv (list in out err) = (float_leaf 17 (cons argv redirects))
            ;   host_alive pid                       = (float_leaf 18 pid)
            ;   fs_mkfifo path                       = (float_leaf 19 path)
            ; Mode 17's operand is the cons pair that write_form_binary and the mouth's
            ; play_at already use to carry two things through a one-operand door.
            (list "host_spawn_at" 2 (list (list 1 17) (rwa) (rwb) (list 2 19 2) (list 2 201 2)))
            (list "host_alive" 1 (list (list 1 18) (rwa) (list 2 201 2)))
            (list "fs_mkfifo" 1 (list (list 1 19) (rwa) (list 2 201 2)))
            ; abs: (0 a le) a (0 a sub) if = if(le 0 a) a (sub 0 a)
            (list "abs" 1 (list (lit0) (rwa) (list 2 5 2) (rwa) (lit0) (rwa) (list 2 4 2) (list 2 6 3)))))

    ; ── emit helpers ──────────────────────────────────────────────────────────
    (defn nl () (byte_to_str 10))
    (defn cma () ", ")
    (defn q () (byte_to_str 34))
    (defn qs (s) (str_concat (q) (str_concat s (q))))

    ; one fk_optab row:  { "name", arity, tag },
    (defn op-row (r)
        (str_concat "  { " (str_concat (qs (nth r 0))
            (str_concat (cma) (str_concat (int_to_str (nth r 1))
                (str_concat (cma) (str_concat (int_to_str (nth r 2)) " },")))))))
    ; balanced divide-and-conquer join (same bytes: rows joined by nl with a trailing nl), at
    ; O(log n) eval depth — the linear right-fold used one tree-walker C frame per row, which
    ; overflows on hosts with small default stacks (Windows 1MB) once the table passes ~120 rows.
    (defn op-rows-range (rs i k)
        (if (eq k 1)
            (op-row (nth rs i))
            (str_concat (op-rows-range rs i (div k 2))
                (str_concat (nl) (op-rows-range rs (add i (div k 2)) (sub k (div k 2)))))))
    (defn op-rows (rs)
        (if (eq (len rs) 0) ""
            (str_concat (op-rows-range rs 0 (len rs)) (nl))))

    ; one template cell -> "0,i," | "1,v," | "2,t,n,"
    (defn tpl-cell (c)
        (if (eq (nth c 0) 2)
            (str_concat "2," (str_concat (int_to_str (nth c 1)) (str_concat "," (str_concat (int_to_str (nth c 2)) ","))))
            (str_concat (int_to_str (nth c 0)) (str_concat "," (str_concat (int_to_str (nth c 1)) ",")))))
    (defn tpl-cells (cs)
        (if (eq (len cs) 0) ""
            (str_concat (tpl-cell (head cs)) (tpl-cells (tail cs)))))
    ; count program ints: ARG/LIT = 2 ints, NODE = 3 ints
    (defn tpl-ints (cs)
        (if (eq (len cs) 0) 0
            (add (if (eq (nth (head cs) 0) 2) 3 2) (tpl-ints (tail cs)))))

    ; one fk_rwtab row: { "name", arity, ntpl, { prog... } },
    (defn rw-row (r)
        (str_concat "  { " (str_concat (qs (nth r 0))
            (str_concat (cma) (str_concat (int_to_str (nth r 1))
                (str_concat (cma) (str_concat (int_to_str (tpl-ints (nth r 2)))
                    (str_concat (cma) (str_concat "{ " (str_concat (tpl-cells (nth r 2)) "} },"))))))))))
    (defn rw-rows (rs)
        (if (eq (len rs) 0) ""
            (str_concat (rw-row (head rs)) (str_concat (nl) (rw-rows (tail rs))))))

    ; line s = newline + s.  str_concat is ARITY 2 — every join is strictly
    ; (str_concat A B); a chain is right-nested (str_concat A (str_concat B ...)).
    (defn line (s) (str_concat (nl) s))
    (defn header ()
        (str_concat "/* GENERATED by flatten/gen-source-walker-table.fk from flt-ops"
        (str_concat (line "   (form-flatten.fk, the hand-maintained single source of truth). DO NOT HAND-EDIT.")
        (str_concat (line "   Adding a value op = a manifest row -> a flt-ops row -> regen -> an fkc-flat arm")
        (str_concat (line "   in form/form-stdlib/fkc-table-serialize.fk; NEVER a C edit. An op without its arm")
        (str_concat (line "   falls to the binary fallback there. Gate: validate_fkwu_native_surface.py */")
        (str_concat (line "struct fk_optab_row { const char *name; long long arity; long long tag; };")
        (str_concat (line "static const struct fk_optab_row fk_optab[] = {")
        (str_concat (line (op-rows (rows)))
        (str_concat (line "};")
        (str_concat (line "static const long long fk_optab_n = sizeof(fk_optab)/sizeof(fk_optab[0]);")
        (str_concat (line "struct fk_rwtab_row { const char *name; long long arity; long long nprog; long long prog[24]; };")
        (str_concat (line "static const struct fk_rwtab_row fk_rwtab[] = {")
        (str_concat (line (rw-rows (rwrules)))
        (str_concat (line "};")
        (str_concat (line "static const long long fk_rwtab_n = sizeof(fk_rwtab)/sizeof(fk_rwtab[0]);")
                    (nl)))))))))))))))))

    ; The recipe ACTION is the write itself — write_file (tag 104, a host-io
    ; op the source-walker runtime already carries) lands the header at the path.
    ; No shell stdout-capture: the recipe is the whole regeneration. The returned
    ; value is the byte count (irrelevant); the header file is the effect.
    (write_file "runtime/fkwu-optable.h" (header)))
