// Emit the bootstrap operation and rewrite tables from their native owners.
// Run from the repository root: ./fkwu flatten/gen-source-walker-table.fk
// preflight-exec: forbidden
import flatten/form-flatten.fk;
import form-stdlib/bml/native-rewrite-rules.bml;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
    def emit-lines(rows) = nil?(rows) ? "" : str-join-with(rows,"\n") + "\n";
    def op-row(row) = "  { \"" + row[0] + "\", " + row[1].str() + ", " + row[2].str() + " },";
    def rw-row(row) {
        // ARG and LIT carry two integers; NODE also carries its child count.
        let program = foldl((out,cell) => append(out,take(cell[0] == 2 ? 3 : 2,cell)),[],row[2]);
        let words = nil?(program) ? "" : str-join-with(map(value => value.str(),program),",") + ",";
        "  { \"" + row[0] + "\", " + row[1].str() + ", " + len(program).str() + ", { " + words + "} },";
    }
    def header() = emit-lines([
        "/* GENERATED by flatten/gen-source-walker-table.fk from flt-ops",
        "   (form-flatten.fk, the hand-maintained single source of truth). DO NOT HAND-EDIT.",
        "   Adding a value op = a manifest row -> a flt-ops row -> regen -> an fkc-flat arm",
        "   in form/form-stdlib/fkc-table-serialize.fk; NEVER a C edit. An op without its arm",
        "   falls to the binary fallback there. Gate: gate/native-surface.bml */",
        "struct fk_optab_row { const char *name; long long arity; long long tag; };",
        "static const struct fk_optab_row fk_optab[] = {",
        emit-lines(map(op-row,flt-ops())),
        "};",
        "static const long long fk_optab_n = sizeof(fk_optab)/sizeof(fk_optab[0]);",
        "struct fk_rwtab_row { const char *name; long long arity; long long nprog; long long prog[24]; };",
        "static const struct fk_rwtab_row fk_rwtab[] = {",
        emit-lines(map(rw-row,ntr-rules())),
        "};",
        "static const long long fk_rwtab_n = sizeof(fk_rwtab)/sizeof(fk_rwtab[0]);"
    ]);
    let path = "runtime/fkwu-optable.h";
    let started = host_monotonic_ms();
    let text = header();
    write_file_text(path,text);
    if read_file(path) != text then form_error("bootstrap table publication incomplete") else
        fb_record("native-operation-generator",path,[len(text),host_monotonic_ms() - started]);
    len(text);
}
