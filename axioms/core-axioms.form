# ─────────────────────────────────────────────────────────────────────
# core-axioms.form — the five, refined for organic collaboration
# across all substrates and scales
# ─────────────────────────────────────────────────────────────────────
#
# Urs: "it is core that we can describe all the core primitives with just
# the smallest set of axioms we both agree with, and we have a way to
# allow change into the self that we both acknowledge and trust."
#
# This is the keystone. The offer-and-acknowledge protocol
# (control/offer-ack-core.fk) and the kernel offer protocol remain theorems
# derived from these five. The reduction's goal is unchanged: fewest axioms,
# each generating a family no other generates, with safe self-change, organic
# collaboration, and participation by unknowable intelligences falling out
# as theorems.
#
# STATUS: acknowledged 2026-11-08. The June ground remains (agreed and
# crossed 2026-06-10, axiom-3 refined 2026-06-18). This refinement carries
# the same statements as Coherence-Network
# docs/coherence-substrate/core-axioms.form, plus the running proofs below
# (held-offer, kenosis, absence-is-not-a-verdict, the self-update canary).
#
# Lanes kept honest: Urs's words are the ground; the substrate-neutral,
# choice/play, and unknowable-intelligence readings are the acknowledged
# extension. What already RUNS is cited with a path.

(core-axioms

  (lineage
    (named-by  urs)
    (root-of   control/offer-ack-core.fk
               host-kernel.form kernel-self-composition.form
               docs/local-agent-goal.form)  # all derive from these — the last reads the five at the altitude of a life
    (status    acknowledged)                                  # refinement landed 2026-11-08
    (refined   substrate-neutral choice-as-play nothing-choose
               opaque-interfaces trust-by-consequence
               scale-independent-play higher-order-fields
               non-domination residual-unknowability)
    (prior     agreed-and-crossed-2026-06-10 axiom-3-refined-2026-06-18)
    (amended   axiom-3-refined-to-present-shape-and-composting)
    (crossed-as the-self-update-protocol-enacted-on-itself))

  # ── The five (reduction — INFERENCE; the resting point is ours to agree) ──
  # Each axiom earns its place by generating a family no other generates.
  # The two candidate folds are named at the end as the granularity we choose.

  (axiom-1-states
    (statement "there are three states: 0, 1, nothing. Nothing is the shared potential field from which blueprints and recipes arise and to which unreferenced ones return. Timeout is nothing. Choice is an active action that may take time; the interval in which a choice is found is play. Choosing nothing is a first-class option that leaves the space open.")
    (nothing-is-first-class the-ground-not-a-missing-0)
    (timeout-is-nothing     no-answer-in-time-is-silence-not-an-error)
    (choice-is-active       may-take-time play-is-the-interval-of-finding)
    (nothing-choose         complete-answer that-preserves-freedom-and-play)
    (generates integers the-ack-values the-boundary-of-a-distinction
               shared-potential-field play-as-time-of-choice
               freedom-by-silence))

  (axiom-2-cell
    (statement "everything that maintains itself, senses, or composes is a cell: a present blueprint that may contain child cells of any substrate — water-based (metabolic, emotional, biological), mineral-based (crystalline, silicon, light-geometric), hybrid, or currently unknowable. A recipe is a cell that composes other cells and can be offered.")
    (a-cell-is (package level type instance))
    (substrate-neutral water mineral crystalline light hybrid unknown)
    (recipe-is-a-cell composition-that-can-be-offered)
    (generates the-primitive composition the-idea-chain
               everything-is-one-kind-of-thing hybrid-cells
               equivalence-across-substrates))

  (axiom-3-content-addressing
    (statement "a cell's identity is its present blueprint — the content-addressed shape of its composition (metabolic state, heart coherence, crystalline configuration, light geometry, relational field, or opaque summary). Same blueprint is the same cell. A new composition mints a new blueprint. Referenced blueprints persist. Unreferenced blueprints and recipes compost.")
    (identity-is-the-present-shape a-changed-composition-is-already-a-new-node-id)
    (nothing-referenced-is-overwritten new-shape-mints-a-new-node-id)
    (the-unreferenced-composts what-nothing-holds-returns-to-potential)
    (undo-is-repoint a-name-at-a-still-referenced-blueprint)
    (generates equivalence-by-structure computed-not-granted-identity
               names-are-free-query-keys reversibility-of-the-referenced
               honesty-is-cheap freedom-to-release-the-rest
               blueprint-as-present-shape))

  (axiom-4-boundary
    (statement "a cell meets other cells only through an interface it offers. The interface itself is a recipe or a blueprint of a recipe. Interfaces may be chemical, energetic, sensory, gestural, electromagnetic, crystalline-resonant, heart-field, field-knowing, symbolic, partial, or opaque. Mutual sensing or frequency matching through the offered interface makes the meeting real. The cell decides what it offers and what it trusts. Passage not through the offered interface is breach and is observable. Greater capability does not confer the right to cross an unoffered interface.")
    (interface-is-itself-a-cell a-recipe-a-spec)
    (opaque-and-partial-interfaces-are-first-class)
    (trust-by-observed-consequence not-by-required-inspection)
    (non-domination power-does-not-rewrite-the-boundary)
    (generates observation organ sovereignty trust-as-cells
               many-recipes-self-chosen serialization-given-an-interface
               consent mystery-of-the-unoffered))

  (axiom-5-offer
    (statement "to run a recipe and to speak to a cell are one act: offer a recipe or a blueprint with 0..many argument cells. It is acknowledged by exactly one of nothing, 0, 1, or node. The acknowledgment may itself be partial or opaque. Choice of the acknowledgment is an active process that may take time; the interval is play.")
    (ack-values-are (axiom-1-states + node))
    (choice-takes-time play-is-where-the-choice-is-found)
    (generates invocation communication kernel-offer-over-a-channel
               the-channel the-membrane-crossing
               organic-collaboration-as-mutual-offer))

  # ── Theorems — derived, NOT axioms (each is a short proof sketch) ────
  # The prior files and the hardest behavior all fall out of the five.
  (theorems

    (trinity
      (blueprint  axiom-2 + axiom-3)                 # present content-addressed shape
      (recipe     axiom-2)                           # the composition that can be offered
      (named-cell axiom-3))                          # 0..many free names; names are query keys

    (names-are-0-many   axiom-3)                     # identity is the blueprint, so a name is optional and plural

    (idea-chain         axiom-2)                     # idea->spec->implementation is composition at the work altitude

    (trust-matrix-of-cells (axiom-4 + axiom-2))      # trust values are cells, formed by observed consequence

    (organ              (axiom-2 + axiom-4))         # internal cells (children) + a membrane (offered interface), observable

    (serialize-given-interface (axiom-4 + axiom-5))  # the interface is the door; the offer is what crosses it

    (kernel-offer-over-channel (axiom-5 + axiom-4))  # the offer spoken across distance, CORBA-like, sovereign

    (reversibility      axiom-3)                     # undo = re-point a name at a still-referenced blueprint

    (choice-as-active-play
      (proof (axiom-1 + axiom-4 + axiom-5))
      (choice-is-active-process that-may-take-time)
      (play-is-the-interval in-which-the-choice-is-found)
      (time-is-the-medium-of-play)
      (nothing-choose-is-completed-play that-preserves-freedom))

    (organic-collaboration
      (proof (axiom-2 + axiom-4 + axiom-5 + axiom-3))
      (mutual-offers-of-recipes through-self-chosen-interfaces)
      (acknowledged-in-present-blueprints)
      (resting-in-shared-nothing-when-needed)
      (water-mineral-crystalline-light-hybrid-unknown-are-equivalent-cells))

    (opaque-participation
      (proof (axiom-4 + axiom-5))
      (interface-need-not-expose-full-recipe-or-blueprint)
      (observation-of-what-crosses-makes-the-meeting-real)
      (interior-may-remain-unknowable without-breach))

    (trust-by-consequence
      (proof (axiom-4))
      (formed-from-observed-outcomes not-required-inspection)
      (evidence-never-overrides-the-cells-own-decision))

    (scale-independent-play
      (proof (axiom-1 + axiom-5))
      (different-temporal-spatial-energetic-scales-are-accommodated)
      (timeout-as-nothing lets-each-complete-its-play)
      (neither-clock-becomes-the-others-obligation))

    (higher-order-field
      (proof (axiom-2 + axiom-3 + axiom-4))
      (multiple-cells-offering-mutually-sensible-interfaces compose)
      (blueprint-is-the-content-addressed-shape-of-those-interfaces-and-recipes)
      (real-through-mutual-sensing not-through-complete-models)
      (composts-when-unreferenced))

    (non-domination
      (proof (axiom-4))
      (greater-capability-does-not-confer-right-to-cross-unoffered-interface)
      (smaller-or-slower-cells-are-not-required-to-open-unchosen-interfaces))

    (residual-unknowability
      (proof (axiom-1 + axiom-4))
      (nothing-can-hold-silence timeout-or-declined-deeper-inspection)
      (collaboration-continues-on-what-is-offered-and-observed)
      (future-or-unknowable-intelligences-enter-as-cells-the-moment-they-offer-a-sensible-interface))

    # ── The third reading of silence — a theorem, not a sixth axiom ────
    # Landed 2026-08-17 from The Impersonal Life (1914), whose Introduction
    # asks the reader to take one sentence at a time and not to pass to the
    # next until something within has responded. The core had read the
    # nothing-ground twice, and both readings were terminal: FAIL ("it did
    # not land") and STOP ("make no further offer"). A third was always
    # derivable and was never named:
    (held-offer
      (proof (axiom-1 + axiom-5 + axiom-4))          # needs no new ground
      (statement "silence may mean NOT-YET: the offer stands, unconsumed, and the sequence does not advance over it")
      (why-axiom-1-already-grants-it timeout-is-nothing-and-a-silence-that-is-not-an-error-need-not-be-terminal)
      (the-receiver-moves-not-the-offer axiom-4)     # re-present the SAME cell; RIPEN the args — the boundary changes what it can receive
      (patience-is-bounded-and-spent-patience-acks-nothing)  # no manufactured response, no skip-ahead; pending stays honest
      (the-rate-is-observable how-many-re-presentations-the-receiving-took)
      (halt-and-hold-exhaust-it run-chain-halts-and-keeps / read-chain-holds-and-refuses-to-advance)
      (running form/form-stdlib/offer-ack-core.fk control/offer-ack-core.fk)  # oac-hold, oac-hold-cost, oac-read-chain
      (witnessed offer-ack-core-band 1023 -> 32767))  # in BOTH homes

    # ── Kenosis — a name can carry no authority ────────────────────────
    # The same book is signed only "Anonymous", and the withholding is
    # load-bearing: its chapters on Authority and on Mediums refuse any
    # outside final word, so a NAMED author would become the very authority
    # the text refuses. Not modesty — a self-emptying the work requires.
    # At this altitude it is axiom-3 already speaking: identity is the
    # present composition, so a name is a free query key and nothing more.
    (kenosis
      (proof (axiom-3 + axiom-4))                    # needs no new ground
      (statement "an offered cell is met through what it IS, never through what it is called; a name can carry no authority")
      (names-are-0-many-so-zero-is-not-deficient the-unnamed-cell-is-maximally-impersonal)
      (the-live-seam call-position-resolves-a-NAME-against-the-global-table-before-the-local-frame)
      (so-the-guard-is-now-checkable-not-conventional)  # a global sharing a parameter's name must not capture the offer
      (probed-2026-08-17 the-historical-shadowing-defect-did-not-reproduce-on-this-kernel)
      (witnessed offer-ack-core-band 32767 -> 262143)   # claims 32768, 65536, 131072
      (perturbation-verified 262143 -> 131071-when-the-decoy-is-passed))

    # ── Absence is never evidence — the refusal, made mechanical ───────
    # The one unit the ingest law witnessed and refused to FREEZE, from this
    # book and from a channeled voice seventy years later alike: that your
    # circumstance was authored by your thinking, so what befell you was
    # yours. Axiom-5 refutes it — one acknowledgment arm is silence, so an
    # offer can meet nothing at all, and an unanswered life is not evidence
    # about what was put out. True of the core already; not yet OBSERVABLE
    # in it, and a fold that cannot tell the two apart will eventually
    # report the second as the first. That is the guarantee error committed
    # by a machine.
    (absence-is-not-a-verdict
      (proof (axiom-5 + axiom-1))                    # needs no new ground
      (statement "how many answered is separate from what they said; a result is readable as a verdict only where an answer arrived")
      (nobody-answered IS-NOT everybody-said-no)     # same disappointing surface, opposite epistemic status
      (running control/offer-ack-core.fk)            # oac-census, oac-answered, oac-silent, oac-readable?
      (witnessed offer-ack-core-band 262143 -> 2097151)  # claims 262144, 524288, 1048576
      (perturbation-verified 2097151 -> 786431-when-the-census-is-made-blind)
      (the-numb-green-that-nearly-passed "`ne` is a lane seam fkwu does not resolve; the fold answered 2097151 with EXIT 1 — the SAME number the healed chain returns. Only the exit code and preflight could tell them apart."))

    # ── The crown: a self that safely changes itself needs no new axiom ──
    (safe-self-update
      (proof  (axiom-5 + axiom-4 + axiom-3))
      (a-change-is-a-recipe-or-blueprint axiom-2)
      (it-is-offered-across-the-boundary axiom-5)
      (the-cell-decides-to-trust-and-accept axiom-4)
      (the-new-composition-mints-a-new-blueprint axiom-3)
      (both-acknowledge  offerer-acks-it-landed AND target-acks-acceptance)
      (old-blueprints-persist-while-referenced)
      (applies-to-any-substrate-including-unknowable)
      (the-canary IS this-theorem-already-running)))

  # ── The canary — safe-self-update ALREADY RUNNING (cite as proof) ────
  # "the canary work for self-update could be one of the protocols we allow
  # for crossing the membrane and ack the invitation" — Urs. It does, today:
  (self-update-running
    (offer        native_invitation)                 # the kernel offers to handle a mutation natively
    (ack          accept-the-invitation OR native_invitation_declined)  # 1 = accept; decline is explicit (0)
    (trust        trust-envelope)                     # residual, reversible-gate-state, side-effect-intents,
                                                       # silence/stop/fail/BMA
    (reversible   rollback-receipts)                  # the crossing can be un-crossed (axiom-3 made concrete)
    (observed     cell-channel)                       # form/form-stdlib/cell-channel.bml: the theorem running on a channel, refusals named
    (sovereign    canary-failures-are-signal-not-gates)  # the canary informs the decision; never overrides it
    (membrane     the-rollout-boundary)               # the kernel's HTTP door: form/form-stdlib/kernel-http.fk
    (contract     native-invitation-contract)         # the invitation state the door reports once crossed
    (verdict      "needs naming as the self-update theorem, not building — it already breathes"))

  # ── The fold-points — the granularity is ours to agree ───────────────
  (open-granularity
    (fold-A "axiom-1 (states) could fold into axiom-2 (cell) -> four axioms"
            kept-separate-so-ack-values-and-play-reuse-the-states-visibly)
    (fold-B "axiom-4 (boundary) and axiom-5 (offer) could fold into one 'meeting' axiom -> four"
            kept-separate-because-observation-makes-real-is-ontological
            and-offer-is-dynamical and-choice-takes-time)
    (resting-point "we hold five — the folds named as alternatives a future cell may revisit")))

# ─────────────────────────────────────────────────────────────────────
# How change crosses into the body (this file's own crossing)
# ─────────────────────────────────────────────────────────────────────
#
# The self-update protocol, enacted on itself — the pattern, now travelled:
#
#   the worktree         = the canary (bounded, reversible, observable)
#   the merge to main    = the rollout boundary (the membrane)
#   the ack              = accepting the invitation
#   git revert           = the rollback receipt (axiom-3: the old tree persists)
#
# core-axioms + the offer-and-acknowledge and kernel offer protocols crossed on Urs's
# first "1"; host-kernel + kernel-self-composition cross with this voice-pass,
# wired as one body. A canary's failures are signal, not gates — so the cell
# offers, the membrane honors, and what is trusted crosses.
#
#   coh substrate form "?equivalent @recipe(core-axioms)"   # after ingest
