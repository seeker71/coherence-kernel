// ctc-train.fk — EARN the number: train a CTC decoder by native gradient
// descent on model/ctc-loss.fk, and watch a real error go to zero.
//
// ctc-loss.fk proved the forward objective (score an alignment). This closes
// the loop asked for 2026-07-02 ("why not earn it"): the loss becomes a
// TRAINING signal. Logits -> softmax -> the CTC forward loss; the gradient
// ∂loss/∂logit is taken by CENTRAL FINITE DIFFERENCE (numerically exact to
// O(eps^2), no hand-derived formula to get wrong); gradient descent then drives
// the greedy-decoded output from wrong to the target.
//
// Witnessed (four-way fkwu/Go/Rust/TS):
//   single-label: target "a", T=2, SYMMETRIC init favoring blank -> decode ""
//     (WER 100) trains to decode "a" (WER 0), loss strictly down. No init trick.
//   ordered: target "ab", T=4, trained from an ADVERSARIAL init (frame0 nudged
//     toward b, frame3 toward a — the WRONG order) -> still decodes "ab"
//     (WER 0), loss down. The tiny fixed asymmetry only breaks the exact-
//     symmetry saddle (the deterministic stand-in for the random init real
//     training uses; Math.random is forbidden here); the GRADIENT learns the
//     correct ordering and the skip transition, proven by convergence from the
//     wrong-direction nudge.
//
// HONEST FLOOR: the decoder is FREE LOGITS (a lookup table of per-frame class
// scores), NOT a neural encoder over real signal — so this earns "the CTC loss
// trains a decoder to zero error natively," NOT a real open-speech WER. And the
// gradient is NUMERICAL (O(params) loss-evals/step) — fine for toys, but the
// analytic forward-backward gradient (∂loss/∂logit = softmax - alignment-
// posterior via alpha·beta) is the scaling rung, still ahead. The native
// WER-100 on real speech is unchanged; what is earned is that its objective now
// demonstrably LEARNS.
//
import form-stdlib/core.fk;
import form-stdlib/transformer-numerics.fk;
import form-stdlib/trig.fk;
import model/ctc-loss.fk;
section [form.bml] {
    def ctt-expv(xs) = (Comparable) len(xs) == 0 ? empty() : cons(tn-exp(xs[0]), ctt-expv(xs[1:]));
    def ctt-sumv(xs) = (Comparable) len(xs) == 0 ? 0.0 : (Number) xs[0] + (Number) ctt-sumv(xs[1:]);
    def ctt-scalev(xs, s) = (Comparable) len(xs) == 0 ? empty() : cons(xs[0] * s, ctt-scalev(xs[1:], s));
    def ctt-softmax(u) = {
        let e = ctt-expv(u);
        ctt-scalev(e, 1.0 / ctt-sumv(e));
    };
    def ctt-softmax-frames(us) = (Comparable) len(us) == 0 ? empty() : cons(ctt-softmax(us[0]), ctt-softmax-frames(us[1:]));
    // the CTC loss as a function of LOGIT frames (softmax then ctc-loss)
    def ctt-loss(us, tgt) = ctc-loss(ctt-softmax-frames(us), tgt);
    def ctt-set(xs, i, v) = (Comparable) len(xs) == 0 ? empty() : (Comparable) i == 0 ? cons(v, xs[1:]) : cons(xs[0], ctt-set(xs[1:], i - 1, v));
    def ctt-setf(us, fi, ci, v) = (Comparable) len(us) == 0 ? empty() : (Comparable) fi == 0 ? cons(ctt-set(us[0], ci, v), us[1:]) : cons(us[0], ctt-setf(us[1:], fi - 1, ci, v));
    def ctt-get(us, fi, ci) = nth(nth(us, fi), ci);
    // central finite-difference gradient wrt one logit
    def ctt-numgrad(us, tgt, fi, ci, eps) = {
        let u0 = ctt-get(us, fi, ci);
        (ctt-loss(ctt-setf(us, fi, ci, (Number) u0 + (Number) eps), tgt) - ctt-loss(ctt-setf(us, fi, ci, u0 - eps), tgt)) / (2.0 * eps);
    };
    // one gradient-descent sweep over all (frame, class) params
    def ctt-step-classes(us, tgt, fi, ci, k, lr, eps) = ci >= k ? us : ctt-step-classes(ctt-setf(us, fi, ci, ctt-get(us, fi, ci) - lr * ctt-numgrad(us, tgt, fi, ci, eps)), tgt, fi, (Number) ci + (Number) 1, k, lr, eps);
    def ctt-step-frames(us, tgt, fi, k, lr, eps) = fi >= len(us) ? us : ctt-step-frames(ctt-step-classes(us, tgt, fi, 0, k, lr, eps), tgt, (Number) fi + (Number) 1, k, lr, eps);
    def ctt-train(us, tgt, k, lr, eps, n) = (Comparable) n == 0 ? us : ctt-train(ctt-step-frames(us, tgt, 0, k, lr, eps), tgt, k, lr, eps, n - 1);
    // greedy decode: argmax per frame -> collapse (drop blank 0, merge repeats) -> int-encoded
    def ctt-argmax-loop(v, i, best, besti) = i >= len(v) ? besti : nth(v, i) > best ? ctt-argmax-loop(v, (Number) i + (Number) 1, nth(v, i), i) : ctt-argmax-loop(v, (Number) i + (Number) 1, best, besti);
    def ctt-argmax(v) = ctt-argmax-loop(v, 1, v[0], 0);
    def ctt-am-frames(fs) = (Comparable) len(fs) == 0 ? empty() : cons(ctt-argmax(fs[0]), ctt-am-frames(fs[1:]));
    def ctt-collapse(idxs, prev, acc) = (Comparable) len(idxs) == 0 ? acc : {
        let c = idxs[0];
        (Comparable) c == 0 ? ctt-collapse(idxs[1:], 0, acc) : (Comparable) c == prev ? ctt-collapse(idxs[1:], prev, acc) : ctt-collapse(idxs[1:], c, (Number) (acc * 10) + (Number) c);
    };
    def ctt-decode(us) = ctt-collapse(ctt-am-frames(ctt-softmax-frames(us)), 0, 0);
    // toy fixtures
    def ctt-u0-a() = [[2.0, 0.0], [2.0, 0.0]];
    // symmetric, blank-favoring
    def ctt-tgt-a() = [1];
    // "a", collapse-encoded 1
    def ctt-u0-ab() = [[2.0, 0.0, 0.02], [2.0, 0.0, 0.01],     // adversarial: b-early, a-late
[2.0, 0.01, 0.0], [2.0, 0.02, 0.0]];
    def ctt-tgt-ab() = [1, 2];
    // "ab", collapse-encoded 12
    0;
}
