; form-neutral-token-space-band.fk — surface/core-token convergence, reverse
; projection, directed query, multiword-token, and numeric round-trip witness.
;
; Expected: 1073741823 (30 bits).
; preludes: model/form-neutral-token-space.fk

(do
  (defn fntsb-bit (condition bit) (if condition bit 0))
  (defn form-neutral-token-space-band ()
    (do
      (let world (fnwm-crossing (cnl13-runtime-open)))
      (let space (fnts-space world))
      (let mappings (fnwm-mappings world))
      (let nl (nth mappings 0))
      (let pl (nth mappings 13))
      (let phrase (nth mappings 26))
      (let nl-tokens (fnts-resolve-surface space
        (cfd-surface-language (cfd-map-source nl))
        (cfd-surface-text (cfd-map-source nl))
        (cfd-map-context nl)))
      (let pl-tokens (fnts-resolve-surface space
        (cfd-surface-language (cfd-map-source pl))
        (cfd-surface-text (cfd-map-source pl))
        (cfd-map-context pl)))
      (let phrase-tokens (fnts-resolve-surface space
        (cfd-surface-language (cfd-map-source phrase))
        (cfd-surface-text (cfd-map-source phrase))
        (cfd-map-context phrase)))
      (let dependency-token (head nl-tokens))
      (let phrase-token (head phrase-tokens))
      (let dependency-numeric (fnts-token-numeric dependency-token))
      (let phrase-numeric (fnts-token-numeric phrase-token))
      (let nl-projected (fnts-project-token space dependency-token
        (cfd-surface-language (cfd-map-source nl)) (cfd-map-context nl)))
      (let pl-projected (fnts-project-token space dependency-token
        (cfd-surface-language (cfd-map-source pl)) (cfd-map-context pl)))
      (let dep-anchor (fnts-token-for-anchor space (cfd-map-meaning nl)))
      (let phrase-anchor (fnts-token-for-anchor space (cfd-map-meaning phrase)))
      (let reversed-edge (intern_node (fnts-cat-edge)
        (list dependency-token
          (intern_trivial_int (fnwm-relation-candidate-alignment)) dep-anchor
          (intern_trivial_int 1) (intern_trivial_int 1))))
      (let unbacked-edge (intern_node (fnts-cat-edge)
        (list phrase-anchor
          (intern_trivial_int (fnwm-relation-candidate-alignment)) dependency-token
          (intern_trivial_int 1) (intern_trivial_int 1))))
      (let forged-space (intern_node (fnts-cat-space)
        (cons world (append (fnts-space-tokens space)
          (cons unbacked-edge (fnts-space-edges space))))))
      (let short-world (intern_node (fnwm-cat-graph)
        (list (intern_trivial_int 64))))
      (let negative-budget-world (intern_node (fnwm-cat-graph)
        (cons (intern_trivial_int (fnwm-graph-size world))
          (cons (intern_trivial_int -1) (fnwm-graph-elements world)))))
      (let duplicate-elements
        (cons (head (fnwm-graph-elements world)) (fnwm-graph-elements world)))
      (let duplicate-world (intern_node (fnwm-cat-graph)
        (cons (intern_trivial_int (fnwm-elements-envelope-bytes duplicate-elements))
          (cons (intern_trivial_int (fnwm-active-budget-bytes)) duplicate-elements))))
      (let numeric-edges (nth dependency-numeric 1))
      (let unordered-numeric (list 2
        (cons (nth numeric-edges 1)
          (cons (nth numeric-edges 0) (tail (tail numeric-edges))))))
      (let duplicate-numeric (list 2
        (cons (nth numeric-edges 0)
          (cons (nth numeric-edges 0) (tail numeric-edges)))))
      (sum (list
        (fntsb-bit (and (not (nothing? space))
          (eq (fnts-space-valid? space) 1)) 1)
        (fntsb-bit (and (eq (len (fnts-space-tokens space)) 5)
                         (eq (len (fnts-space-edges space)) 3)) 2)
        (fntsb-bit (and (le (fnts-space-envelope-bytes space)
                            (fnwm-active-budget-bytes))
                         (eq (fnts-smaller-than-active-llm? space) 1)) 4)
        (fntsb-bit (and (eq (len nl-tokens) 1)
                         (eq (len pl-tokens) 1)) 8)
        (fntsb-bit (node_eq (head nl-tokens) (head pl-tokens)) 16)
        (fntsb-bit (and (eq (len phrase-tokens) 1)
          (gt (str_find (cfd-surface-text (cfd-map-source phrase)) " " 0) 0)) 32)
        (fntsb-bit (not (node_eq dependency-token phrase-token)) 64)
        (fntsb-bit (and (eq (nth dependency-numeric 0) 2)
                         (eq (nth phrase-numeric 0) 2)) 128)
        (fntsb-bit (node_eq dependency-token
          (fnts-token-from-numeric dependency-numeric)) 256)
        (fntsb-bit (node_eq phrase-token
          (fnts-token-from-numeric phrase-numeric)) 512)
        (fntsb-bit (eq (len (fnts-outgoing space dep-anchor)) 1) 1024)
        (fntsb-bit (eq (len (fnts-incoming space dependency-token)) 2) 2048)
        (fntsb-bit (eq (len (fnts-source-tokens
          (fnts-incoming space dependency-token))) 2) 4096)
        (fntsb-bit (eq (len (fnts-outgoing space phrase-anchor)) 1) 8192)
        (fntsb-bit (eq (len nl-projected) 1) 16384)
        (fntsb-bit (eq (len pl-projected) 1) 32768)
        (fntsb-bit (and (node_eq (head nl-projected) nl)
                         (node_eq (head pl-projected) pl)) 65536)
        (fntsb-bit (nothing? (fnts-token-from-numeric (list 9 1))) 131072)
        (fntsb-bit (nothing? (fnts-space (fnwm-anchor-symbol
          (fnc-anchor 1)))) 262144)
        (fntsb-bit (eq (fnts-token-plane-surface-free? space) 1) 524288)
        (fntsb-bit (and (node_eq
          (fnts-token-from-numeric (fnts-token-numeric dep-anchor)) dep-anchor)
          (eq (nth (fnts-token-numeric dep-anchor) 0) 1)) 1048576)
        (fntsb-bit (and (eq (len (fnts-project-token space phrase-token
            (cfd-surface-language (cfd-map-source phrase))
            (cfd-map-context phrase))) 1)
          (node_eq (head (fnts-project-token space phrase-token
              (cfd-surface-language (cfd-map-source phrase))
              (cfd-map-context phrase))) phrase)) 2097152)
        (fntsb-bit (eq (fnts-edge-valid? reversed-edge) 0) 4194304)
        (fntsb-bit (eq (fnts-space-valid? forged-space) 0) 8388608)
        (fntsb-bit (and (eq (len (fnts-resolve-surface forged-space
              (cfd-surface-language (cfd-map-source nl))
              (cfd-surface-text (cfd-map-source nl))
              (cfd-map-context nl))) 0)
          (eq (len (fnts-project-token forged-space dependency-token
              (cfd-surface-language (cfd-map-source phrase))
              (cfd-map-context phrase))) 0)) 16777216)
        (fntsb-bit (and (nothing? (fnts-space short-world))
                         (nothing? (fnts-space negative-budget-world))) 33554432)
        (fntsb-bit (nothing? (fnts-space duplicate-world)) 67108864)
        (fntsb-bit (and (nothing? (fnts-token-from-numeric unordered-numeric))
                         (nothing? (fnts-token-from-numeric (list 2 (list))))) 134217728)
        (fntsb-bit (and (nothing? (fnts-token-from-numeric (list 1 70000)))
          (eq (len (fnts-resolve-surface space "unknown" "unknown"
              (cfd-map-context nl))) 0)) 268435456)
        (fntsb-bit (and (eq (fnts-edge-valid? unbacked-edge) 1)
          (nothing? (fnts-token-from-numeric duplicate-numeric))) 536870912)))))
  (form-neutral-token-space-band))
