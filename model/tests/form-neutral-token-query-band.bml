// Public crossing fixture. Direct query helpers must honor the same space and
// membership as the top-level queries. No corpus, model or living-state writes.
// preludes: model/form-neutral-token-space.fk observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class FormNeutralTokenQueryBand {
  def fntq-rows(space,forged,nl,dep,anchor) {
   let language = cfd-surface-language(cfd-map-source(nl));
   let context = cfd-map-context(nl); let meaning = cfd-map-meaning(nl);
   let bad = intern_node(fnts-cat-token(),list(fnts-token-symbol(anchor),intern_trivial_int(0)));
   let emptySpace = intern_node(fnts-cat-space(),list());
   let absent = fnts-token(fnwm-anchor-symbol(fnc-anchor(65535)));
   list(
    list("valid-space",fnts-space-valid?(space)),
    list("invalid-space",not(fnts-space-valid?(forged))),
    list("anchor-lookup-preserved",node_eq(fnts-token-for-anchor(space,meaning),anchor)),
    list("symbol-lookup-preserved",node_eq(fnts-token-for-symbol(space,fnts-token-symbol(anchor)),anchor)),
    list("anchor-projection-preserved",value_eq(fnts-project-anchor-tokens(space,list(anchor),language,context),list(nl))),
    list("invalid-anchor-lookup",nothing?(fnts-token-for-anchor(forged,meaning))),
    list("invalid-symbol-lookup",nothing?(fnts-token-for-symbol(forged,fnts-token-symbol(anchor)))),
    list("invalid-anchor-projection",nil?(fnts-project-anchor-tokens(forged,list(anchor),language,context))),
    list("malformed-token-projection",nil?(fnts-project-anchor-tokens(space,list(bad),language,context))),
    list("mixed-batch-refuses-whole",nil?(fnts-project-anchor-tokens(space,list(anchor,bad),language,context))),
    list("absent-token-not-member",and(fnts-token-valid?(absent),not(fnwm-member?(absent,fnts-space-tokens(space))))),
    list("absent-token-projection",nil?(fnts-project-anchor-tokens(space,list(absent),language,context))),
    list("empty-space-lookup",nothing?(fnts-token-for-anchor(emptySpace,meaning))),
    list("empty-space-projection",nil?(fnts-project-anchor-tokens(emptySpace,list(anchor),language,context))),
    list("nothing-space-lookup",nothing?(fnts-token-for-anchor(nothing(),meaning))),
    list("nothing-space-projection",nil?(fnts-project-anchor-tokens(nothing(),list(anchor),language,context))),
    list("resolve-preserved",value_eq(fnts-resolve-surface(space,language,cfd-surface-text(cfd-map-source(nl)),context),list(dep))),
    list("project-preserved",value_eq(fnts-project-token(space,dep,language,context),list(nl))),
    list("language-miss",nil?(fnts-project-anchor-tokens(space,list(anchor),"not-a-witnessed-language",context))),
    list("empty-token-list",nil?(fnts-project-anchor-tokens(space,list(),language,context)))
   );
  }
  def fntq-all(rows) = if nil?(rows) then 1 else and(nth(head(rows),1),fntq-all(tail(rows)));
  def fntq-coordinate-rows(anchor) {
   let blank = cfd-meaning(list());
   let nested = cfd-meaning(list(cfd-e(cfd-role(0),blank)));
   let deeper = cfd-meaning(list(cfd-e(cfd-role(0),nested)));
   let scalar = cfd-meaning(list(cfd-e(cfd-role(0),intern_trivial_int(0))));
   let mixed = cfd-meaning(list(cfd-e(cfd-role(0),scalar),cfd-e(cfd-role(1),blank)));
   let valid = cfd-meaning(list(cfd-e(cfd-role(0),scalar),cfd-e(cfd-role(1),cfd-gap(0)),cfd-e(cfd-role(2),cfd-axiom(0)),cfd-e(cfd-role(3),intern_trivial_int(-1))));
   let forgedBlank = intern_node(fnts-cat-token(),list(fnwm-recipe-symbol(blank),intern_trivial_int(fnts-claim-candidate())));
   let forgedNested = intern_node(fnts-cat-token(),list(fnwm-recipe-symbol(nested),intern_trivial_int(fnts-claim-candidate())));
   let scalarToken = fnts-token(fnwm-recipe-symbol(scalar));
   let validToken = fnts-token(fnwm-recipe-symbol(valid));
   let blankRelation = fnwm-relation(fnts-token-symbol(anchor),fnwm-relation-candidate-alignment(),fnwm-recipe-symbol(blank),1,1);
   let scalarRelation = fnwm-relation(fnts-token-symbol(anchor),fnwm-relation-candidate-alignment(),fnwm-recipe-symbol(scalar),1,1);
   list(
    list("empty-dictionary-value-preserved",and(fnwm-recipe-valid?(blank,fnwm-envelope-walk-fuel()),fnwm-symbol-valid?(fnwm-recipe-symbol(blank)))),
    list("empty-token-construction-refused",nothing?(fnts-token(fnwm-recipe-symbol(blank)))),
    list("nested-empty-token-refused",nothing?(fnts-token(fnwm-recipe-symbol(nested)))),
    list("deeper-empty-token-refused",nothing?(fnts-token(fnwm-recipe-symbol(deeper)))),
    list("mixed-empty-token-refused",nothing?(fnts-token(fnwm-recipe-symbol(mixed)))),
    list("forged-empty-token-refused",not(fnts-token-valid?(forgedBlank))),
    list("forged-nested-token-refused",not(fnts-token-valid?(forgedNested))),
    list("forged-empty-encoding-refused",nothing?(fnts-token-numeric(forgedBlank))),
    list("empty-coordinate-still-refused",nothing?(fnts-token-from-numeric(list(2,list())))),
    list("scalar-zero-roundtrip",and(fnts-token-valid?(scalarToken),node_eq(scalarToken,fnts-token-from-numeric(fnts-token-numeric(scalarToken))))),
    list("nested-values-roundtrip",and(fnts-token-valid?(validToken),node_eq(validToken,fnts-token-from-numeric(fnts-token-numeric(validToken))))),
    list("anchor-roundtrip",and(fnts-token-valid?(anchor),node_eq(anchor,fnts-token-from-numeric(fnts-token-numeric(anchor))))),
    list("non-coordinate-relation-refused",and(fnwm-relation-valid?(blankRelation),nothing?(fnts-edge-from-relation(blankRelation)))),
    list("coordinate-relation-preserved",fnts-edge-valid?(fnts-edge-from-relation(scalarRelation)))
   );
  }
  def fntq-run() {
   let world = fnwm-crossing(cnl13-runtime-open()); let space = fnts-space(world);
   let nl = head(fnwm-mappings(world)); let phrase = nth(fnwm-mappings(world),26);
   let anchor = fnts-token-for-anchor(space,cfd-map-meaning(nl));
   let phraseAnchor = fnts-token-for-anchor(space,cfd-map-meaning(phrase));
   let dep = head(fnts-resolve-surface(space,cfd-surface-language(cfd-map-source(nl)),cfd-surface-text(cfd-map-source(nl)),cfd-map-context(nl)));
   let extra = intern_node(fnts-cat-edge(),list(phraseAnchor,intern_trivial_int(fnwm-relation-candidate-alignment()),dep,intern_trivial_int(1),intern_trivial_int(1)));
   let forged = intern_node(fnts-cat-space(),cons(world,append(fnts-space-tokens(space),cons(extra,fnts-space-edges(space)))));
   let observation = bfc-envelope(0,17890301,0,list(fnts-space-valid?(forged),len(fnts-space-tokens(forged))),-1);
   let out = bfc-record-out(observation,0); let control = bfc-control(observation,5);
   let received = bfc-record-in(control,1);
   let selected = bfc-apply(observation,control,-1,append(fntq-rows(space,forged,nl,dep,anchor),fntq-coordinate-rows(anchor)));
   let shown = print(selected);
   let after = bfc-record-out(bfc-envelope(0,bfc-exchange(observation),0,list(len(selected),fntq-all(selected)),-1),2);
   if fntq-all(selected) then 17179869183 else form_error("token query admission witness refused");
  }
 }
}
