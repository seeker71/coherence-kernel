; form-neutral-language-world-model-band.fk — mapping projections, directed
; candidate relations, native world orientation, bounded growth, and absence.
;
; Verdict 65535 when all sixteen observations are present.
; witnessed: 2026-08-14 -> 65535 on fkwu
import "../form-neutral-language-world-model.fk"

(do
  (defn fnwmb-bit (ok bit) (if ok bit 0))
  (defn fnwmb-deep-cell (depth child)
    (if (eq depth 0) child
      (intern_node (cfd-cat-gap)
        (list (fnwmb-deep-cell (sub depth 1) child)))))
  (defn form-neutral-language-world-model-band ()
    (do
      (let runtime (cnl13-runtime-open))
      (let graph (fnwm-crossing runtime))
      (let nl-anchor-node (fnwm-anchor-symbol (fnc-nl-necessary-anchor)))
      (let dependency-recipe-node (fnwm-recipe-symbol (fnc-dependency-symbol)))
      (let id-maps (fnwm-parse graph "id" "keperluan" (cfd-c-specification)))
      (let zh-projected (fnwm-project graph (fnc-nl-necessary-anchor)
        "zh" (cfd-c-specification)))
      (let world (fnwm-world graph 7 "language-organ" 100))
      (let fresh-anchor (fnc-anchor 4001))
      (let fresh-recipe (cfd-meaning (list
        (cfd-e (cfd-role 14) (cfd-axiom 1))
        (cfd-e (cfd-role 20) (cfd-axiom 3)))))
      (let fresh-alignment (fnc-alignment fresh-anchor fresh-recipe 32))
      (let fresh-projection (fnc-projection 1 "x-symbol" "∿" fresh-anchor 1
        "participant-offered-unreviewed" "bounded-extension-fixture" "P"
        33 "participant-offer"))
      (let extended (fnwm-extend graph fresh-projection fresh-alignment 4001))
      (let repeated (fnwm-extend extended fresh-projection fresh-alignment 4001))
      (let second-projection (fnc-projection 1 "x-symbol" "∿∿" fresh-anchor 1
        "participant-offered-unreviewed" "bounded-extension-fixture" "P"
        33 "participant-offer"))
      (let surface-extended
        (fnwm-extend extended second-projection fresh-alignment 4002))
      (let budget-held (fnwm-extend
        (fnwm-with-budget graph (fnwm-graph-size graph))
        fresh-projection fresh-alignment 4001))
      (let invalid-anchor (fnc-anchor 65536))
      (let invalid-alignment (fnc-alignment invalid-anchor fresh-recipe 32))
      (let invalid-projection (fnc-projection 1 "x-symbol" "overflow"
        invalid-anchor 1 "participant-offered-unreviewed"
        "bounded-extension-fixture" "P" 33 "participant-offer"))
      (let mismatched-projection (fnc-projection 1 "x-symbol" "mismatch"
        fresh-anchor 1 "participant-offered-unreviewed"
        "bounded-extension-fixture" "P" 33 "participant-offer"))
      (let wrong-anchor (cfd-indexed (cfd-cat-gap) 4002))
      (let wrong-anchor-alignment (fnc-alignment wrong-anchor fresh-recipe 32))
      (let wrong-anchor-projection (fnc-projection 1 "x-symbol" "wrong-anchor"
        wrong-anchor 1 "participant-offered-unreviewed"
        "bounded-extension-fixture" "P" 33 "participant-offer"))
      (let wrong-alignment (intern_node (cfd-cat-gap)
        (list fresh-anchor fresh-recipe (intern_trivial_int 32))))
      (let zero-residue-alignment (fnc-alignment fresh-anchor fresh-recipe 0))
      (let string-anchor (intern_node (fnc-cat-anchor)
        (list (intern_trivial_string "4002"))))
      (let string-anchor-alignment (fnc-alignment string-anchor fresh-recipe 32))
      (let string-anchor-projection (fnc-projection 1 "x-symbol" "string-anchor"
        string-anchor 1 "participant-offered-unreviewed"
        "bounded-extension-fixture" "P" 33 "participant-offer"))
      ; Direct graph construction must account for content below every
      ; top-level category, including faithful candidate surfaces and recipes.
      (let size-projection (fnc-projection 1 "x-symbol" "arriving"
        fresh-anchor 1 "participant-offered-unreviewed"
        "bounded-size-fixture" "P" 33 "participant-offer"))
      (let size-mapping (fnc-projection-mapping size-projection 9001))
      (let faithful-small (cfd-mapping (cfd-map-source size-mapping)
        (cfd-map-context size-mapping) fresh-anchor
        (cfd-surface "x-symbol" "a") (cfd-map-provenance size-mapping)))
      (let faithful-large (cfd-mapping (cfd-map-source size-mapping)
        (cfd-map-context size-mapping) fresh-anchor
        (cfd-surface "x-symbol"
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
        (cfd-map-provenance size-mapping)))
      (let size-anchor-node (fnwm-anchor-symbol fresh-anchor))
      (let faithful-small-elements (list size-anchor-node faithful-small))
      (let faithful-large-elements (list size-anchor-node faithful-large))
      (let faithful-small-size
        (fnwm-elements-envelope-bytes faithful-small-elements))
      (let faithful-large-size
        (fnwm-elements-envelope-bytes faithful-large-elements))
      (let faithful-small-graph
        (fnwm-graph faithful-small-size faithful-small-elements))
      (let faithful-large-held
        (fnwm-graph faithful-small-size faithful-large-elements))
      (let small-recipe-size (fnwm-element-envelope-bytes
        (fnwm-recipe-symbol fresh-recipe)))
      (let large-recipe-size (fnwm-element-envelope-bytes
        (fnwm-recipe-symbol (fnc-dependency-symbol))))
      (let deep-envelope (fnwm-node-envelope-bytes
        (fnwmb-deep-cell 257 (intern_trivial_int 1))
        (fnwm-envelope-walk-fuel)))
      (let forged-size-graph (intern_node (fnwm-cat-graph)
        (cons (intern_trivial_int 1)
          (cons (intern_trivial_int (fnwm-active-budget-bytes))
            (fnwm-graph-elements graph)))))
      (let malformed-symbol (intern_node (fnwm-cat-symbol)
        (list (intern_trivial_int 1))))
      (let malformed-relation (intern_node (fnwm-cat-relation)
        (list size-anchor-node (intern_trivial_int 1))))
      (let malformed-mapping (intern_node (cfd-cat-mapping)
        (list (intern_trivial_int 1))))
      (let malformed-recipe (intern_node (cfd-cat-meaning)
        (list (intern_trivial_int 1))))
      (let malformed-recipe-symbol (fnwm-recipe-symbol malformed-recipe))
      (let unordered-recipe (intern_node (cfd-cat-meaning)
        (list (cfd-e (cfd-role 20) (cfd-axiom 1))
              (cfd-e (cfd-role 14) (cfd-axiom 1)))))
      (let unordered-recipe-symbol (fnwm-recipe-symbol unordered-recipe))
      (let reversed-relation (fnwm-relation (fnwm-recipe-symbol fresh-recipe)
        (fnwm-relation-candidate-alignment) size-anchor-node 1 1))
      (let dangling-relation (fnwm-relation size-anchor-node
        (fnwm-relation-candidate-alignment)
        (fnwm-recipe-symbol fresh-recipe) 1 1))
      (let size-provenance (cfd-map-provenance size-mapping))
      (let size-occurrence (cfd-prov-occurrence size-provenance))
      (let mislinked-provenance (cfd-provenance-linked size-occurrence
        (cfd-surface-projection (cfd-map-source size-mapping)
          (cfd-surface "x-symbol" "different-lexeme") 0)
        (cfd-prov-origin size-provenance)
        (cfd-prov-coverage size-provenance)
        (cfd-prov-residue size-provenance)
        (cfd-prov-claim size-provenance)
        (cfd-prov-lineage-evidence size-provenance)))
      (let mislinked-mapping (cfd-mapping (cfd-map-source size-mapping)
        (cfd-map-context size-mapping) fresh-anchor
        (cfd-map-faithful size-mapping) mislinked-provenance))
      (let malformed-occurrence (intern_node (cfd-cat-occurrence)
        (list (cfd-occ-surface size-occurrence)
          (cfd-occ-context size-occurrence)
          (cfd-occ-corpus size-occurrence)
          (nth (node_children size-occurrence) 3)
          (nth (node_children size-occurrence) 4)
          (nth (node_children size-occurrence) 5)
          (intern_trivial_string "not-a-gap"))))
      (let malformed-occurrence-provenance (cfd-provenance-linked
        malformed-occurrence (cfd-prov-projection size-provenance)
        (cfd-prov-origin size-provenance)
        (cfd-prov-coverage size-provenance)
        (cfd-prov-residue size-provenance)
        (cfd-prov-claim size-provenance)
        (cfd-prov-lineage-evidence size-provenance)))
      (let malformed-occurrence-mapping (cfd-mapping
        (cfd-map-source size-mapping) (cfd-map-context size-mapping)
        fresh-anchor (cfd-map-faithful size-mapping)
        malformed-occurrence-provenance))
      (let unknown-element (intern_trivial_int 7))
      (sum (list
        (fnwmb-bit (and (not (nothing? graph))
          (and (eq (len (fnwm-symbols graph)) 5)
          (and (eq (len (fnwm-relations graph)) 3)
               (eq (len (fnwm-mappings graph)) 39)))) 1)
        (fnwmb-bit (eq (fnwm-semantic-surface-free? graph) 1) 2)
        (fnwmb-bit (and (eq (len id-maps) 1)
          (node_eq (cfd-map-meaning (head id-maps))
                   (fnc-nl-necessary-anchor))) 4)
        (fnwmb-bit (and (eq (len zh-projected) 1)
          (and (str_eq (cfd-surface-text
                (cfd-map-source (head zh-projected))) "必要")
               (not (nothing? (cfd-prov-lineage-evidence
                 (cfd-map-provenance (head zh-projected))))))) 8)
        (fnwmb-bit (and (eq (len (fnwm-outgoing graph nl-anchor-node)) 1)
          (node_eq (fnwm-rel-to (head (fnwm-outgoing graph nl-anchor-node)))
                   dependency-recipe-node)) 16)
        (fnwmb-bit (and (eq (len (fnwm-incoming graph dependency-recipe-node)) 2)
          (and (eq (fnwm-rel-claim
                (head (fnwm-incoming graph dependency-recipe-node))) 1)
               (eq (fnwm-rel-kind
                (head (fnwm-incoming graph dependency-recipe-node)))
                (fnwm-relation-candidate-alignment)))) 32)
        (fnwmb-bit (and (eq (len world) 3)
          (and (eq (wm-orient-count world "meaning") 3)
          (and (str_eq (wm-ent-id (head world)) "1400")
               (eq (wm-ent-persistence (head world)) 2)))) 64)
        (fnwmb-bit (and (eq (len (fnwm-world-image graph 7
              "language-organ" 100)) 3)
          (eq (fnwm-world-meaning-count graph 7 "language-organ" 100) 3)) 128)
        (fnwmb-bit (and (eq (fnwm-smaller-than-active-llm? graph) 1)
          (and (eq (fnwm-graph-size-honest? graph) 1)
          (and (lt (fnwm-graph-size graph) (fnwm-active-budget-bytes))
          (and (lt (fnwm-active-budget-bytes)
                   (dtrs-dsv4-default-bytes))
          (and (gt faithful-large-size faithful-small-size)
          (and (not (nothing? faithful-small-graph))
          (and (nothing? faithful-large-held)
          (and (gt large-recipe-size small-recipe-size)
          (and (gt deep-envelope (fnwm-active-budget-bytes))
          (and (eq (fnwm-graph-size graph)
                   (fnwm-node-envelope-bytes graph
                     (fnwm-envelope-walk-fuel)))
               (eq (fnwm-graph-size-honest? forged-size-graph) 0))))))))))) 256)
        (fnwmb-bit (and (not (nothing? extended))
          (and (eq (len (fnwm-anchor-nodes extended)) 4)
          (and (eq (len (fnwm-symbols extended)) 7)
          (and (eq (len (fnwm-relations extended)) 4)
          (and (eq (len (fnwm-mappings extended)) 40)
               (eq (fnwm-world-meaning-count extended 7
                    "language-organ" 101) 4)))))) 512)
        (fnwmb-bit (and (node_eq extended repeated)
          (and (eq (fnwm-graph-size extended) (fnwm-graph-size repeated))
          (and (eq (len (fnwm-symbols surface-extended))
                   (len (fnwm-symbols extended)))
          (and (eq (len (fnwm-relations surface-extended))
                   (len (fnwm-relations extended)))
          (and (eq (len (fnwm-mappings surface-extended)) 41)
               (gt (fnwm-graph-size surface-extended)
                   (fnwm-graph-size extended))))))) 1024)
        (fnwmb-bit (nothing? budget-held) 2048)
        (fnwmb-bit (and
          (nothing? (fnwm-extend graph invalid-projection
            invalid-alignment 5001))
          (and (nothing? (fnwm-extend graph mismatched-projection
                 (fnc-nl-dependency-alignment) 5002))
          (and (nothing? (fnwm-extend graph wrong-anchor-projection
                 wrong-anchor-alignment 5003))
          (and (nothing? (fnwm-extend graph fresh-projection
                 wrong-alignment 5004))
          (and (nothing? (fnwm-extend graph fresh-projection
                 zero-residue-alignment 5005))
          (and (nothing? (fnwm-extend graph string-anchor-projection
                 string-anchor-alignment 5006))
          (and (nothing? (fnwm-extend graph fresh-projection
                 fresh-alignment -1))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list unknown-element)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list malformed-symbol)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list malformed-relation)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list malformed-mapping)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list faithful-small)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list malformed-recipe-symbol)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list unordered-recipe-symbol)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list size-anchor-node (fnwm-recipe-symbol fresh-recipe)
                       reversed-relation)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list size-anchor-node dangling-relation)))
          (and (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list size-anchor-node mislinked-mapping)))
               (nothing? (fnwm-graph (fnwm-active-budget-bytes)
                 (list size-anchor-node
                       malformed-occurrence-mapping)))))))))))))))))))) 4096)
        (fnwmb-bit (and
          (eq (wm-held-open? (fnwm-observe-anchor fresh-anchor 9)) 1)
          (eq (wm-persisted? (fnwm-observe-anchor fresh-anchor 9)
            "language-organ" 101 (fnwm-known-cells graph)) 0)) 8192)
        (fnwmb-bit (and
          (eq (len (cfd-render-in (fnwm-mappings graph)
            (fnc-nl-necessary-anchor) "id" (cfd-c-specification))) 0)
          (eq (len (fnwm-parse graph "unknown" "∿"
            (cfd-context-any))) 0)) 16384)
        (fnwmb-bit (and
          (node_eq (fnwm-symbol-value nl-anchor-node)
                   (fnc-nl-necessary-anchor))
          (and (node_eq (fnwm-symbol-value dependency-recipe-node)
                        (fnc-dependency-symbol))
               (not (node_eq (fnwm-symbol-value nl-anchor-node)
                             (fnwm-symbol-value dependency-recipe-node))))) 32768)))))

  (form-neutral-language-world-model-band))
