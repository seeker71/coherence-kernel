        let edges = fnts-recipe-edges-from-numeric(encoded);
        nothing?(edges) ? nothing() : cfd-meaning(edges);
    };
    def fnts-token-from-numeric(encoded) = !((Comparable) len(encoded) == 2) ? nothing() : (Comparable) encoded[0] == 1 ? fnts-token(fnwm-anchor-symbol(fnc-anchor(encoded[1]))) : (Comparable) encoded[0] == 2 ? {
        let recipe = fnts-recipe-from-numeric(encoded[1]);
        nothing?(recipe) ? nothing() : fnts-token(fnwm-recipe-symbol(recipe));
    } : nothing();
    // The token plane carries symbols and numeric edges only. Language strings
    // remain exclusively in the evidence-bearing world mapping plane.
    def fnts-token-plane-surface-free?(space) = fnwm-semantic-surface-free-loop(append(fnts-token-symbols(fnts-space-tokens(space)), fnts-edge-symbols(fnts-space-edges(space))));
    def fnts-token-symbols(tokens) = (Comparable) len(tokens) == 0 ? [] : cons(fnts-token-symbol(tokens[0]), fnts-token-symbols(tokens[1:]));
    def fnts-edge-symbols(edges) = (Comparable) len(edges) == 0 ? [] : cons(fnts-token-symbol(fnts-edge-from(edges[0])), cons(fnts-token-symbol(fnts-edge-to(edges[0])), fnts-edge-symbols(edges[1:])));
