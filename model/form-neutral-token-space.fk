; form-neutral-token-space.fk — a surface-independent token dictionary over the
; language world-model graph.
;
; A token is a content-addressed semantic symbol, never a word spelling. NL and
; PL surfaces enter through evidence-bearing mappings, walk anchor -> candidate
; recipe, and converge on the same token when the graph actually supports that
; convergence. A many-word phrase therefore remains one token when its mapping
; names one semantic recipe. Reverse traversal projects the token back through
; its incoming anchors into any witnessed surface plane.
;
; Every token also has an exact nested numeric recipe. The encoding contains
; only numeric tags, indexes, roles, axioms, gaps, and integers; it reconstructs
; the same content-addressed token without a privileged natural or programming
; language. This is an exact symbolic coordinate, not a learned similarity
; claim. Learned embeddings may be layered over it later without replacing it.
;
; The token space remains a bounded active working set under the world model's
; 16 MiB covenant, far below the measured DS4 resident-weight baseline.
;
; witnessed: 2026-08-14 -> token-space band 1073741823 on fkwu, Go, Rust, TypeScript
import "form-neutral-language-world-model.fk"

(do
  (defn fnts-cat-token () (make_nodeid 31 2 0 31))
  (defn fnts-cat-edge () (make_nodeid 31 2 0 32))
  (defn fnts-cat-space () (make_nodeid 31 2 0 33))
  (defn fnts-claim-candidate () 1)

  ; ── semantic tokens and directed edges ──────────────────────────
  (defn fnts-token (symbol)
    (if (eq (fnwm-symbol-valid? symbol) 0) (nothing)
      (intern_node (fnts-cat-token)
        (list symbol (intern_trivial_int (fnts-claim-candidate))))))
  (defn fnts-token-symbol (token) (nth (node_children token) 0))
  (defn fnts-token-claim (token)
    (node_value (nth (node_children token) 1)))
  (defn fnts-token-valid? (token)
    (if (not (node_eq (node_category token) (fnts-cat-token))) 0
    (if (not (eq (len (node_children token)) 2)) 0
      (if (and (eq (fnwm-symbol-valid? (fnts-token-symbol token)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children token) 1)) 1)
               (eq (fnts-token-claim token) (fnts-claim-candidate)))) 1 0))))

  (defn fnts-edge-from-relation (relation)
    (if (eq (fnwm-relation-valid? relation) 0) (nothing)
      (intern_node (fnts-cat-edge)
        (list (fnts-token (fnwm-rel-from relation))
          (intern_trivial_int (fnwm-rel-kind relation))
          (fnts-token (fnwm-rel-to relation))
          (intern_trivial_int (fnwm-rel-residue relation))
          (intern_trivial_int (fnwm-rel-claim relation))))))
  (defn fnts-edge-from (edge) (nth (node_children edge) 0))
  (defn fnts-edge-kind (edge)
    (node_value (nth (node_children edge) 1)))
  (defn fnts-edge-to (edge) (nth (node_children edge) 2))
  (defn fnts-edge-residue (edge)
    (node_value (nth (node_children edge) 3)))
  (defn fnts-edge-claim (edge)
    (node_value (nth (node_children edge) 4)))
  (defn fnts-edge-direction-valid? (edge)
    (if (not (eq (fnwm-symbol-kind
                   (fnts-token-symbol (fnts-edge-from edge)))
                 (fnwm-kind-anchor))) 0
      (if (eq (fnwm-symbol-kind
                (fnts-token-symbol (fnts-edge-to edge)))
              (fnwm-kind-recipe)) 1 0)))
  (defn fnts-edge-valid? (edge)
    (if (not (node_eq (node_category edge) (fnts-cat-edge))) 0
    (if (not (eq (len (node_children edge)) 5)) 0
    (if (eq (fnts-token-valid? (fnts-edge-from edge)) 0) 0
    (if (eq (fnwm-trivial-int? (nth (node_children edge) 1)) 0) 0
    (if (eq (fnts-token-valid? (fnts-edge-to edge)) 0) 0
    (if (eq (fnwm-trivial-int? (nth (node_children edge) 3)) 0) 0
    (if (eq (fnwm-trivial-int? (nth (node_children edge) 4)) 0) 0
    (if (not (eq (fnts-edge-kind edge)
                 (fnwm-relation-candidate-alignment))) 0
    (if (le (fnts-edge-residue edge) 0) 0
    (if (eq (fnts-edge-direction-valid? edge) 0) 0
      (if (eq (fnts-edge-claim edge) (fnts-claim-candidate)) 1 0))))))))))))

  (defn fnts-tokens-from-symbols (symbols)
    (if (eq (len symbols) 0) (list)
      (cons (fnts-token (head symbols))
        (fnts-tokens-from-symbols (tail symbols)))))
  (defn fnts-edges-from-relations (relations)
    (if (eq (len relations) 0) (list)
      (cons (fnts-edge-from-relation (head relations))
        (fnts-edges-from-relations (tail relations)))))
  (defn fnts-elements-of-category (elements category)
    (if (eq (len elements) 0) (list)
      (if (node_eq (node_category (head elements)) category)
        (cons (head elements)
          (fnts-elements-of-category (tail elements) category))
        (fnts-elements-of-category (tail elements) category))))
  (defn fnts-space-world (space) (head (node_children space)))
  (defn fnts-space-elements (space) (tail (node_children space)))
  (defn fnts-space-tokens (space)
    (fnts-elements-of-category (fnts-space-elements space) (fnts-cat-token)))
  (defn fnts-space-edges (space)
    (fnts-elements-of-category (fnts-space-elements space) (fnts-cat-edge)))

  (defn fnts-token-for-symbol-loop (tokens symbol)
    (if (eq (len tokens) 0) (nothing)
      (if (node_eq (fnts-token-symbol (head tokens)) symbol)
        (head tokens)
        (fnts-token-for-symbol-loop (tail tokens) symbol))))
  (defn fnts-token-for-symbol (space symbol)
    (fnts-token-for-symbol-loop (fnts-space-tokens space) symbol))
  (defn fnts-token-for-anchor (space anchor)
    (fnts-token-for-symbol space (fnwm-anchor-symbol anchor)))
  (defn fnts-node-set-contained? (wanted available)
    (if (eq (len wanted) 0) 1
      (if (eq (fnwm-member? (head wanted) available) 1)
        (fnts-node-set-contained? (tail wanted) available) 0)))
  (defn fnts-space-elements-valid? (elements)
    (if (eq (len elements) 0) 1
      (if (or (eq (fnts-token-valid? (head elements)) 1)
              (eq (fnts-edge-valid? (head elements)) 1))
        (fnts-space-elements-valid? (tail elements)) 0)))
  (defn fnts-space-edges-linked? (edges tokens)
    (if (eq (len edges) 0) 1
      (if (and (eq (fnwm-member? (fnts-edge-from (head edges)) tokens) 1)
               (eq (fnwm-member? (fnts-edge-to (head edges)) tokens) 1))
        (fnts-space-edges-linked? (tail edges) tokens) 0)))
  (defn fnts-space-envelope-bytes (space)
    (fnwm-node-envelope-bytes space (fnwm-envelope-walk-fuel)))
  (defn fnts-elements-unique-loop? (remaining seen)
    (if (eq (len remaining) 0) 1
      (if (eq (fnwm-member? (head remaining) seen) 1) 0
        (fnts-elements-unique-loop? (tail remaining)
          (cons (head remaining) seen)))))
  (defn fnts-elements-unique? (elements)
    (fnts-elements-unique-loop? elements (list)))
  (defn fnts-world-header-valid? (world)
    (if (nothing? world) 0
    (if (not (node_eq (node_category world) (fnwm-cat-graph))) 0
    (if (lt (len (node_children world)) 2) 0
      (if (and (eq (fnwm-trivial-int? (nth (node_children world) 0)) 1)
               (eq (fnwm-trivial-int? (nth (node_children world) 1)) 1)) 1 0)))))
  (defn fnts-world-valid? (world)
    (if (eq (fnts-world-header-valid? world) 0) 0
      (do
        (let elements (fnwm-graph-elements world))
        (if (eq (fnwm-elements-valid? elements) 0) 0
        (if (eq (fnwm-elements-linked? elements elements) 0) 0
        (if (eq (fnts-elements-unique? elements) 0) 0
        (if (eq (fnwm-graph-size-honest? world) 0) 0
        (if (lt (fnwm-graph-budget world) (fnwm-graph-size world)) 0
          (if (le (fnwm-graph-budget world)
                  (fnwm-active-budget-bytes)) 1 0)))))))))
  (defn fnts-space-valid? (space)
    (if (not (node_eq (node_category space) (fnts-cat-space))) 0
    (if (lt (len (node_children space)) 1) 0
      (do
        (let world (fnts-space-world space))
        (let tokens (fnts-space-tokens space))
        (let edges (fnts-space-edges space))
        (let expected-tokens
          (fnts-tokens-from-symbols (fnwm-symbols world)))
        (let expected-edges
          (fnts-edges-from-relations (fnwm-relations world)))
        (if (eq (fnts-world-valid? world) 0) 0
        (if (eq (fnts-space-elements-valid?
                  (fnts-space-elements space)) 0) 0
        (if (not (eq (len tokens) (len expected-tokens))) 0
        (if (not (eq (len edges) (len expected-edges))) 0
        (if (eq (fnts-node-set-contained? expected-tokens tokens) 0) 0
        (if (eq (fnts-node-set-contained? expected-edges edges) 0) 0
        (if (eq (fnts-space-edges-linked? edges tokens) 0) 0
          (if (le (fnts-space-envelope-bytes space)
                  (fnwm-active-budget-bytes)) 1 0))))))))))))
  (defn fnts-space (world)
    (if (or (nothing? world)
            (not (node_eq (node_category world) (fnwm-cat-graph))))
      (nothing)
      (do
        (let tokens (fnts-tokens-from-symbols (fnwm-symbols world)))
        (let edges (fnts-edges-from-relations (fnwm-relations world)))
        (let space (intern_node (fnts-cat-space)
          (cons world (append tokens edges))))
        (if (eq (fnts-space-valid? space) 1) space (nothing)))))
  (defn fnts-smaller-than-active-llm? (space)
    (if (and (eq (fnts-space-valid? space) 1)
             (lt (fnts-space-envelope-bytes space)
                 (dtrs-dsv4-default-bytes))) 1 0))

  ; ── bidirectional token graph query ─────────────────────────────
  (defn fnts-outgoing-loop (edges token)
    (if (eq (len edges) 0) (list)
      (if (node_eq (fnts-edge-from (head edges)) token)
        (cons (head edges) (fnts-outgoing-loop (tail edges) token))
        (fnts-outgoing-loop (tail edges) token))))
  (defn fnts-incoming-loop (edges token)
    (if (eq (len edges) 0) (list)
      (if (node_eq (fnts-edge-to (head edges)) token)
        (cons (head edges) (fnts-incoming-loop (tail edges) token))
        (fnts-incoming-loop (tail edges) token))))
  (defn fnts-outgoing (space token)
    (if (or (eq (fnts-space-valid? space) 0)
            (eq (fnts-token-valid? token) 0)) (list)
      (if (eq (fnwm-member? token (fnts-space-tokens space)) 0) (list)
        (fnts-outgoing-loop (fnts-space-edges space) token))))
  (defn fnts-incoming (space token)
    (if (or (eq (fnts-space-valid? space) 0)
            (eq (fnts-token-valid? token) 0)) (list)
      (if (eq (fnwm-member? token (fnts-space-tokens space)) 0) (list)
        (fnts-incoming-loop (fnts-space-edges space) token))))
  (defn fnts-target-tokens (edges)
    (if (eq (len edges) 0) (list)
      (fnwm-append-unique (fnts-target-tokens (tail edges))
        (fnts-edge-to (head edges)))))
  (defn fnts-source-tokens (edges)
    (if (eq (len edges) 0) (list)
      (fnwm-append-unique (fnts-source-tokens (tail edges))
        (fnts-edge-from (head edges)))))

  ; ── surfaces <-> core semantic tokens ───────────────────────────
  (defn fnts-resolve-mappings (space mappings)
    (if (eq (len mappings) 0) (list)
      (do
        (let anchor-token
          (fnts-token-for-anchor space (cfd-map-meaning (head mappings))))
        (let resolved (if (nothing? anchor-token) (list)
          (fnts-target-tokens (fnts-outgoing space anchor-token))))
        (fnts-node-set-union resolved
          (fnts-resolve-mappings space (tail mappings))))))
  (defn fnts-node-set-union (left right)
    (if (eq (len left) 0) right
      (fnts-node-set-union (tail left)
        (fnwm-append-unique right (head left)))))
  (defn fnts-resolve-surface (space language text context)
    (if (eq (fnts-space-valid? space) 0) (list)
      (fnts-resolve-mappings space
        (fnwm-parse (fnts-space-world space) language text context))))
  (defn fnts-project-anchor-tokens (space tokens language context)
    (if (eq (len tokens) 0) (list)
      (do
        (let symbol (fnts-token-symbol (head tokens)))
        (let projected
          (if (eq (fnwm-symbol-kind symbol) (fnwm-kind-anchor))
            (fnwm-project (fnts-space-world space)
              (fnwm-symbol-value symbol) language context)
            (list)))
        (append projected
          (fnts-project-anchor-tokens space (tail tokens)
            language context)))))
  (defn fnts-project-token (space token language context)
    (if (or (eq (fnts-space-valid? space) 0)
            (eq (fnts-token-valid? token) 0)) (list)
      (fnts-project-anchor-tokens space
        (fnts-source-tokens (fnts-incoming space token)) language context)))

  ; ── exact form-neutral numeric coordinates ──────────────────────
  ; Value tags: integer=1, axiom=2, gap=3, nested meaning=4.
  ; Token tags: external anchor=1, numeric meaning recipe=2.
  (defn fnts-indexed-value (node)
    (node_value (head (node_children node))))
  (defn fnts-value-numeric (value)
    (if (eq (fnwm-trivial-int? value) 1)
      (list 1 (node_value value))
    (if (eq (fnwm-indexed-valid? value (cfd-cat-axiom)) 1)
      (list 2 (fnts-indexed-value value))
    (if (eq (fnwm-indexed-valid? value (cfd-cat-gap)) 1)
      (list 3 (fnts-indexed-value value))
    (if (node_eq (node_category value) (cfd-cat-meaning))
      (list 4 (fnts-recipe-numeric value))
      (nothing))))))
  (defn fnts-recipe-edge-numeric (edge)
    (list (cfd-edge-role-index edge)
      (fnts-value-numeric (nth (node_children edge) 1))))
  (defn fnts-recipe-edges-numeric (edges)
    (if (eq (len edges) 0) (list)
      (cons (fnts-recipe-edge-numeric (head edges))
        (fnts-recipe-edges-numeric (tail edges)))))
  (defn fnts-recipe-numeric (recipe)
    (fnts-recipe-edges-numeric (node_children recipe)))
  (defn fnts-token-numeric (token)
    (if (eq (fnts-token-valid? token) 0) (nothing)
      (do
        (let symbol (fnts-token-symbol token))
        (if (eq (fnwm-symbol-kind symbol) (fnwm-kind-anchor))
          (list 1 (fnwm-anchor-index (fnwm-symbol-value symbol)))
          (list 2 (fnts-recipe-numeric (fnwm-symbol-value symbol)))))))

  (defn fnts-value-from-numeric (encoded)
    (if (not (eq (len encoded) 2)) (nothing)
      (if (eq (nth encoded 0) 1) (intern_trivial_int (nth encoded 1))
      (if (eq (nth encoded 0) 2) (cfd-axiom (nth encoded 1))
      (if (eq (nth encoded 0) 3) (cfd-gap (nth encoded 1))
      (if (eq (nth encoded 0) 4) (fnts-recipe-from-numeric (nth encoded 1))
        (nothing)))))))
  (defn fnts-recipe-edges-from-numeric (encoded)
    (if (eq (len encoded) 0) (list)
      (do
        (let item (head encoded))
        (if (not (eq (len item) 2)) (nothing)
          (do
            (let value (fnts-value-from-numeric (nth item 1)))
            (if (nothing? value) (nothing)
              (do
                (let rest
                  (fnts-recipe-edges-from-numeric (tail encoded)))
                (if (nothing? rest) (nothing)
                  (cons (cfd-e (cfd-role (nth item 0)) value) rest)))))))))
  (defn fnts-numeric-role-order-valid? (encoded previous)
    (if (eq (len encoded) 0) 1
      (do
        (let item (head encoded))
        (if (not (eq (len item) 2)) 0
          (if (le (nth item 0) previous) 0
            (fnts-numeric-role-order-valid? (tail encoded)
              (nth item 0)))))))
  (defn fnts-recipe-from-numeric (encoded)
    (if (or (eq (len encoded) 0)
            (eq (fnts-numeric-role-order-valid? encoded -1) 0)) (nothing)
      (do (let edges (fnts-recipe-edges-from-numeric encoded))
        (if (nothing? edges) (nothing) (cfd-meaning edges)))))
  (defn fnts-token-from-numeric (encoded)
    (if (not (eq (len encoded) 2)) (nothing)
      (if (eq (nth encoded 0) 1)
        (fnts-token (fnwm-anchor-symbol (fnc-anchor (nth encoded 1))))
      (if (eq (nth encoded 0) 2)
        (do (let recipe (fnts-recipe-from-numeric (nth encoded 1)))
          (if (nothing? recipe) (nothing)
            (fnts-token (fnwm-recipe-symbol recipe))))
        (nothing)))))

  ; The token plane carries symbols and numeric edges only. Language strings
  ; remain exclusively in the evidence-bearing world mapping plane.
  (defn fnts-token-plane-surface-free? (space)
    (fnwm-semantic-surface-free-loop
      (append
        (fnts-token-symbols (fnts-space-tokens space))
        (fnts-edge-symbols (fnts-space-edges space)))))
  (defn fnts-token-symbols (tokens)
    (if (eq (len tokens) 0) (list)
      (cons (fnts-token-symbol (head tokens))
        (fnts-token-symbols (tail tokens)))))
  (defn fnts-edge-symbols (edges)
    (if (eq (len edges) 0) (list)
      (cons (fnts-token-symbol (fnts-edge-from (head edges)))
        (cons (fnts-token-symbol (fnts-edge-to (head edges)))
          (fnts-edge-symbols (tail edges))))))

  0)
