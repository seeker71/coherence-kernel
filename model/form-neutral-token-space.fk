// form-neutral-token-space.fk — a surface-independent token dictionary over the
// language world-model graph.
//
// A token is a content-addressed semantic symbol, never a word spelling. NL and
// PL surfaces enter through evidence-bearing mappings, walk anchor -> candidate
// recipe, and converge on the same token when the graph actually supports that
// convergence. A many-word phrase therefore remains one token when its mapping
// names one semantic recipe. Reverse traversal projects the token back through
// its incoming anchors into any witnessed surface plane.
//
// Every token also has an exact nested numeric recipe. The encoding contains
// only numeric tags, indexes, roles, axioms, gaps, and integers; it reconstructs
// the same content-addressed token without a privileged natural or programming
// language. This is an exact symbolic coordinate, not a learned similarity
// claim. Learned embeddings may be layered over it later without replacing it.
// Recipe tokens have at least one edge at every nested meaning level. Empty
// dictionary/world recipes remain values but have no numeric token coordinate.
//
// The token space remains a bounded active working set under the world model's
// 16 MiB covenant, far below the measured DS4 resident-weight baseline.
//
// witnessed: 2026-09-11 -> token-space 1073741823 and token-query 17179869183 on fkwu
import model/form-neutral-token-coordinate.bml;
import "form-neutral-language-world-model.fk"
section [form.bml] {
    def fnts-cat-token() = make_nodeid(31, 2, 0, 31);
    def fnts-cat-edge() = make_nodeid(31, 2, 0, 32);
    def fnts-cat-space() = make_nodeid(31, 2, 0, 33);
    def fnts-claim-candidate() = 1;
    // ── semantic tokens and directed edges ──────────────────────────
    def fnts-token(symbol) = (Comparable) fntc-symbol-valid?(symbol) == 0 ? nothing() : intern_node(fnts-cat-token(), [symbol, intern_trivial_int(fnts-claim-candidate())]);
    def fnts-token-symbol(token) = node_children(token)[0];
    def fnts-token-claim(token) = node_value(node_children(token)[1]);
    def fnts-token-valid?(token) = !node_eq(node_category(token), fnts-cat-token()) ? 0 : !((Comparable) len(node_children(token)) == 2) ? 0 : (Comparable) fntc-symbol-valid?(fnts-token-symbol(token)) == 1 && ((Comparable) fnwm-trivial-int?(node_children(token)[1]) == 1 && (Comparable) fnts-token-claim(token) == fnts-claim-candidate()) ? 1 : 0;
    def fnts-edge-from-relation(relation) = (Comparable) fntc-relation-valid?(relation) == 0 ? nothing() : intern_node(fnts-cat-edge(), [fnts-token(fnwm-rel-from(relation)), intern_trivial_int(fnwm-rel-kind(relation)), fnts-token(fnwm-rel-to(relation)), intern_trivial_int(fnwm-rel-residue(relation)), intern_trivial_int(fnwm-rel-claim(relation))]);
    def fnts-edge-from(edge) = node_children(edge)[0];
    def fnts-edge-kind(edge) = node_value(node_children(edge)[1]);
    def fnts-edge-to(edge) = node_children(edge)[2];
    def fnts-edge-residue(edge) = node_value(node_children(edge)[3]);
    def fnts-edge-claim(edge) = node_value(node_children(edge)[4]);
    def fnts-edge-direction-valid?(edge) = !((Comparable) fnwm-symbol-kind(fnts-token-symbol(fnts-edge-from(edge))) == fnwm-kind-anchor()) ? 0 : (Comparable) fnwm-symbol-kind(fnts-token-symbol(fnts-edge-to(edge))) == fnwm-kind-recipe() ? 1 : 0;
    def fnts-edge-valid?(edge) = !node_eq(node_category(edge), fnts-cat-edge()) ? 0 : !((Comparable) len(node_children(edge)) == 5) ? 0 : (Comparable) fnts-token-valid?(fnts-edge-from(edge)) == 0 ? 0 : (Comparable) fnwm-trivial-int?(node_children(edge)[1]) == 0 ? 0 : (Comparable) fnts-token-valid?(fnts-edge-to(edge)) == 0 ? 0 : (Comparable) fnwm-trivial-int?(node_children(edge)[3]) == 0 ? 0 : (Comparable) fnwm-trivial-int?(node_children(edge)[4]) == 0 ? 0 : !((Comparable) fnts-edge-kind(edge) == fnwm-relation-candidate-alignment()) ? 0 : fnts-edge-residue(edge) <= 0 ? 0 : (Comparable) fnts-edge-direction-valid?(edge) == 0 ? 0 : (Comparable) fnts-edge-claim(edge) == fnts-claim-candidate() ? 1 : 0;
    def fnts-tokens-from-symbols(symbols) = (Comparable) len(symbols) == 0 ? [] : cons(fnts-token(symbols[0]), fnts-tokens-from-symbols(symbols[1:]));
    def fnts-edges-from-relations(relations) = (Comparable) len(relations) == 0 ? [] : cons(fnts-edge-from-relation(relations[0]), fnts-edges-from-relations(relations[1:]));
    def fnts-elements-of-category(elements, category) = (Comparable) len(elements) == 0 ? [] : node_eq(node_category(elements[0]), category) ? cons(elements[0], fnts-elements-of-category(elements[1:], category)) : fnts-elements-of-category(elements[1:], category);
    def fnts-space-world(space) = node_children(space)[0];
    def fnts-space-elements(space) = node_children(space)[1:];
    def fnts-space-tokens(space) = fnts-elements-of-category(fnts-space-elements(space), fnts-cat-token());
    def fnts-space-edges(space) = fnts-elements-of-category(fnts-space-elements(space), fnts-cat-edge());
    def fnts-token-for-symbol-loop(tokens, symbol) = (Comparable) len(tokens) == 0 ? nothing() : node_eq(fnts-token-symbol(tokens[0]), symbol) ? tokens[0] : fnts-token-for-symbol-loop(tokens[1:], symbol);
    def fnts-token-for-symbol(space, symbol) = (Comparable) fnts-space-valid?(space) == 0 ? nothing() : fnts-token-for-symbol-loop(fnts-space-tokens(space), symbol);
    def fnts-token-for-anchor(space, anchor) = fnts-token-for-symbol(space, fnwm-anchor-symbol(anchor));
    def fnts-node-set-contained?(wanted, available) = (Comparable) len(wanted) == 0 ? 1 : (Comparable) fnwm-member?(wanted[0], available) == 1 ? fnts-node-set-contained?(wanted[1:], available) : 0;
    def fnts-space-elements-valid?(elements) = (Comparable) len(elements) == 0 ? 1 : (Comparable) fnts-token-valid?(elements[0]) == 1 || (Comparable) fnts-edge-valid?(elements[0]) == 1 ? fnts-space-elements-valid?(elements[1:]) : 0;
    def fnts-space-edges-linked?(edges, tokens) = (Comparable) len(edges) == 0 ? 1 : (Comparable) fnwm-member?(fnts-edge-from(edges[0]), tokens) == 1 && (Comparable) fnwm-member?(fnts-edge-to(edges[0]), tokens) == 1 ? fnts-space-edges-linked?(edges[1:], tokens) : 0;
    def fnts-space-envelope-bytes(space) = fnwm-node-envelope-bytes(space, fnwm-envelope-walk-fuel());
    def fnts-elements-unique-loop?(remaining, seen) = (Comparable) len(remaining) == 0 ? 1 : (Comparable) fnwm-member?(remaining[0], seen) == 1 ? 0 : fnts-elements-unique-loop?(remaining[1:], cons(remaining[0], seen));
    def fnts-elements-unique?(elements) = fnts-elements-unique-loop?(elements, []);
    def fnts-world-header-valid?(world) = nothing?(world) ? 0 : !node_eq(node_category(world), fnwm-cat-graph()) ? 0 : len(node_children(world)) < 2 ? 0 : (Comparable) fnwm-trivial-int?(node_children(world)[0]) == 1 && (Comparable) fnwm-trivial-int?(node_children(world)[1]) == 1 ? 1 : 0;
    def fnts-world-valid?(world) = (Comparable) fnts-world-header-valid?(world) == 0 ? 0 : {
        let elements = fnwm-graph-elements(world);
        (Comparable) fnwm-elements-valid?(elements) == 0 ? 0 : (Comparable) fnwm-elements-linked?(elements, elements) == 0 ? 0 : (Comparable) fnts-elements-unique?(elements) == 0 ? 0 : (Comparable) fnwm-graph-size-honest?(world) == 0 ? 0 : fnwm-graph-budget(world) < fnwm-graph-size(world) ? 0 : fnwm-graph-budget(world) <= fnwm-active-budget-bytes() ? 1 : 0;
    };
    def fnts-space-valid?(space) = !node_eq(node_category(space), fnts-cat-space()) ? 0 : len(node_children(space)) < 1 ? 0 : {
        let world = fnts-space-world(space);
        let tokens = fnts-space-tokens(space);
        let edges = fnts-space-edges(space);
        let expected-tokens = fnts-tokens-from-symbols(fnwm-symbols(world));
        let expected-edges = fnts-edges-from-relations(fnwm-relations(world));
        (Comparable) fnts-world-valid?(world) == 0 ? 0 : (Comparable) fnts-space-elements-valid?(fnts-space-elements(space)) == 0 ? 0 : !((Comparable) len(tokens) == len(expected-tokens)) ? 0 : !((Comparable) len(edges) == len(expected-edges)) ? 0 : (Comparable) fnts-node-set-contained?(expected-tokens, tokens) == 0 ? 0 : (Comparable) fnts-node-set-contained?(expected-edges, edges) == 0 ? 0 : (Comparable) fnts-space-edges-linked?(edges, tokens) == 0 ? 0 : fnts-space-envelope-bytes(space) <= fnwm-active-budget-bytes() ? 1 : 0;
    };
    def fnts-space(world) = nothing?(world) || !node_eq(node_category(world), fnwm-cat-graph()) ? nothing() : {
        let tokens = fnts-tokens-from-symbols(fnwm-symbols(world));
        let edges = fnts-edges-from-relations(fnwm-relations(world));
        let space = intern_node(fnts-cat-space(), cons(world, append(tokens, edges)));
        (Comparable) fnts-space-valid?(space) == 1 ? space : nothing();
    };
    def fnts-smaller-than-active-llm?(space) = (Comparable) fnts-space-valid?(space) == 1 && fnts-space-envelope-bytes(space) < dtrs-dsv4-default-bytes() ? 1 : 0;
    // ── bidirectional token graph query ─────────────────────────────
    def fnts-outgoing-loop(edges, token) = (Comparable) len(edges) == 0 ? [] : node_eq(fnts-edge-from(edges[0]), token) ? cons(edges[0], fnts-outgoing-loop(edges[1:], token)) : fnts-outgoing-loop(edges[1:], token);
    def fnts-incoming-loop(edges, token) = (Comparable) len(edges) == 0 ? [] : node_eq(fnts-edge-to(edges[0]), token) ? cons(edges[0], fnts-incoming-loop(edges[1:], token)) : fnts-incoming-loop(edges[1:], token);
    def fnts-outgoing(space, token) = (Comparable) fnts-space-valid?(space) == 0 || (Comparable) fnts-token-valid?(token) == 0 ? [] : (Comparable) fnwm-member?(token, fnts-space-tokens(space)) == 0 ? [] : fnts-outgoing-loop(fnts-space-edges(space), token);
    def fnts-incoming(space, token) = (Comparable) fnts-space-valid?(space) == 0 || (Comparable) fnts-token-valid?(token) == 0 ? [] : (Comparable) fnwm-member?(token, fnts-space-tokens(space)) == 0 ? [] : fnts-incoming-loop(fnts-space-edges(space), token);
    def fnts-target-tokens(edges) = (Comparable) len(edges) == 0 ? [] : fnwm-append-unique(fnts-target-tokens(edges[1:]), fnts-edge-to(edges[0]));
    def fnts-source-tokens(edges) = (Comparable) len(edges) == 0 ? [] : fnwm-append-unique(fnts-source-tokens(edges[1:]), fnts-edge-from(edges[0]));
    // ── surfaces <-> core semantic tokens ───────────────────────────
    def fnts-resolve-mappings(space, mappings) = (Comparable) len(mappings) == 0 ? [] : {
        let anchor-token = fnts-token-for-anchor(space, cfd-map-meaning(mappings[0]));
        let resolved = nothing?(anchor-token) ? [] : fnts-target-tokens(fnts-outgoing(space, anchor-token));
        fnts-node-set-union(resolved, fnts-resolve-mappings(space, mappings[1:]));
    };
    def fnts-node-set-union(left, right) = (Comparable) len(left) == 0 ? right : fnts-node-set-union(left[1:], fnwm-append-unique(right, left[0]));
    def fnts-resolve-surface(space, language, text, context) = (Comparable) fnts-space-valid?(space) == 0 ? [] : fnts-resolve-mappings(space, fnwm-parse(fnts-space-world(space), language, text, context));
    def fnts-project-anchor-tokens(space, tokens, language, context) = (Comparable) fnts-space-valid?(space) == 0 ? [] : (Comparable) fnts-node-set-contained?(tokens, fnts-space-tokens(space)) == 0 ? [] : fnts-project-anchor-loop(fnts-space-world(space), tokens, language, context);
    // Traversal receives an admitted world's members; query admission happens once.
    def fnts-project-anchor-loop(world, tokens, language, context) = (Comparable) len(tokens) == 0 ? [] : {
        let symbol = fnts-token-symbol(tokens[0]);
        let projected = (Comparable) fnwm-symbol-kind(symbol) == fnwm-kind-anchor() ? fnwm-project(world, fnwm-symbol-value(symbol), language, context) : [];
        append(projected, fnts-project-anchor-loop(world, tokens[1:], language, context));
    };
    def fnts-project-token(space, token, language, context) = (Comparable) fnts-space-valid?(space) == 0 || (Comparable) fnts-token-valid?(token) == 0 ? [] : fnts-project-anchor-tokens(space, fnts-source-tokens(fnts-incoming(space, token)), language, context);
    // ── exact form-neutral numeric coordinates ──────────────────────
    // Value tags: integer=1, axiom=2, gap=3, nested meaning=4.
    // Token tags: external anchor=1, numeric meaning recipe=2.
    def fnts-indexed-value(node) = node_value(node_children(node)[0]);
    def fnts-value-numeric(value) = (Comparable) fnwm-trivial-int?(value) == 1 ? [1, node_value(value)] : (Comparable) fnwm-indexed-valid?(value, cfd-cat-axiom()) == 1 ? [2, fnts-indexed-value(value)] : (Comparable) fnwm-indexed-valid?(value, cfd-cat-gap()) == 1 ? [3, fnts-indexed-value(value)] : node_eq(node_category(value), cfd-cat-meaning()) ? [4, fnts-recipe-numeric(value)] : nothing();
    def fnts-recipe-edge-numeric(edge) = [cfd-edge-role-index(edge), fnts-value-numeric(node_children(edge)[1])];
    def fnts-recipe-edges-numeric(edges) = (Comparable) len(edges) == 0 ? [] : cons(fnts-recipe-edge-numeric(edges[0]), fnts-recipe-edges-numeric(edges[1:]));
    def fnts-recipe-numeric(recipe) = fnts-recipe-edges-numeric(node_children(recipe));
    def fnts-token-numeric(token) = (Comparable) fnts-token-valid?(token) == 0 ? nothing() : {
        let symbol = fnts-token-symbol(token);
        (Comparable) fnwm-symbol-kind(symbol) == fnwm-kind-anchor() ? [1, fnwm-anchor-index(fnwm-symbol-value(symbol))] : [2, fnts-recipe-numeric(fnwm-symbol-value(symbol))];
    };
    def fnts-value-from-numeric(encoded) = !((Comparable) len(encoded) == 2) ? nothing() : (Comparable) encoded[0] == 1 ? intern_trivial_int(encoded[1]) : (Comparable) encoded[0] == 2 ? cfd-axiom(encoded[1]) : (Comparable) encoded[0] == 3 ? cfd-gap(encoded[1]) : (Comparable) encoded[0] == 4 ? fnts-recipe-from-numeric(encoded[1]) : nothing();
    def fnts-recipe-edges-from-numeric(encoded) = (Comparable) len(encoded) == 0 ? [] : {
        let item = encoded[0];
        !((Comparable) len(item) == 2) ? nothing() : {
            let value = fnts-value-from-numeric(item[1]);
            nothing?(value) ? nothing() : {
                let rest = fnts-recipe-edges-from-numeric(encoded[1:]);
                nothing?(rest) ? nothing() : cons(cfd-e(cfd-role(item[0]), value), rest);
            };
        };
    };
    def fnts-numeric-role-order-valid?(encoded, previous) = (Comparable) len(encoded) == 0 ? 1 : {
