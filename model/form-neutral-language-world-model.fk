; form-neutral-language-world-model.fk — language projections enter the native
; world model without turning their surfaces into meaning identity.
;
; The semantic graph is small, directed, and content-addressed:
;
;   NL / PL surface -> evidence-bearing mapping -> external anchor
;   external anchor -> candidate alignment edge -> numeric meaning recipe
;
; The first relation remains queryable in both directions through the shared
; dictionary parser/projector. The second is a claim-1 edge with visible
; residue, not semantic or cultural equivalence. Only external anchors enter
; world-model recognition. They use the same wm-entity-embed / wm-persist /
; wm-orient path as every other entity kind; no language receives a separate
; engine.
;
; Size stays bounded by an explicit canonical packed-envelope estimate. The
; active graph may occupy at most 16 MiB; larger corpora remain content-addressed
; shards outside the active model and project in as needed. This is an active
; symbolic working set, not a parameter model. Its ceiling is compared with the
; repository's measured 9.103 GB DS4 resident-weight baseline.
;
; witnessed: 2026-08-14 -> native band 65535; complete-root envelope 87362
import "../form/form-stdlib/core.fk"
import "../form/form-stdlib/speaker-embed.fk"
import "../form/form-stdlib/champion-challenger.fk"
import "../form/form-stdlib/identity-match.fk"
import "../form/form-stdlib/face-embed.fk"
import "../form/form-stdlib/spatial-fusion.fk"
import "../form/form-stdlib/world-model.fk"
import "../form/form-stdlib/dsv4-token-recipe-swap.fk"
import "../cognition/core-frequency-lift-form-neutral-crossing.fk"

(do
  ; ── graph cells ───────────────────────────────────────────────────
  (defn fnwm-cat-symbol () (make_nodeid 31 2 0 23))
  (defn fnwm-cat-relation () (make_nodeid 31 2 0 24))
  (defn fnwm-cat-graph () (make_nodeid 31 2 0 25))
  (defn fnwm-kind-anchor () 1)
  (defn fnwm-kind-recipe () 2)
  (defn fnwm-relation-candidate-alignment () 1)

  (defn fnwm-symbol (symbol kind claim)
    (intern_node (fnwm-cat-symbol)
      (list symbol (intern_trivial_int kind) (intern_trivial_int claim))))
  (defn fnwm-symbol-value (n) (nth (node_children n) 0))
  (defn fnwm-symbol-kind (n) (node_value (nth (node_children n) 1)))
  (defn fnwm-symbol-claim (n) (node_value (nth (node_children n) 2)))
  (defn fnwm-anchor-symbol (anchor) (fnwm-symbol anchor (fnwm-kind-anchor) 1))
  (defn fnwm-recipe-symbol (recipe) (fnwm-symbol recipe (fnwm-kind-recipe) 1))

  (defn fnwm-relation (from relation to residue claim)
    (intern_node (fnwm-cat-relation)
      (list from (intern_trivial_int relation) to
        (intern_trivial_int residue) (intern_trivial_int claim))))
  (defn fnwm-rel-from (e) (nth (node_children e) 0))
  (defn fnwm-rel-kind (e) (node_value (nth (node_children e) 1)))
  (defn fnwm-rel-to (e) (nth (node_children e) 2))
  (defn fnwm-rel-residue (e) (node_value (nth (node_children e) 3)))
  (defn fnwm-rel-claim (e) (node_value (nth (node_children e) 4)))
  (defn fnwm-alignment-relation (alignment)
    (fnwm-relation
      (fnwm-anchor-symbol (fnc-a-anchor alignment))
      (fnwm-relation-candidate-alignment)
      (fnwm-recipe-symbol (fnc-a-recipe alignment))
      (fnc-a-residue alignment) 1))

  ; ── active-size covenant ──────────────────────────────────────────
  ; The packed envelope is deliberately conservative and inspectable. Every
  ; reachable cell contributes 32 structural bytes; every trivial string also
  ; contributes its complete payload. Shared descendants are counted again at
  ; every reference, so this cannot hide a large faithful surface, provenance
  ; field, recipe, or future child behind a fixed top-level cost. It is not a
  ; claim about the evaluator's heap layout; it is the bounded canonical export
  ; contract.
  (defn fnwm-active-budget-bytes () 16777216)
  (defn fnwm-cell-envelope-base-bytes () 32)
  ; root + packed-size trivial + budget trivial
  (defn fnwm-graph-envelope-base-bytes () 96)
  (defn fnwm-envelope-walk-fuel () 256)
  (defn fnwm-max-anchor-index () 65535)
  (defn fnwm-node-envelope-bytes (node fuel)
    (if (le fuel 0) (add (fnwm-active-budget-bytes) 1)
      (if (and (eq (node_level node) 1) (eq (node_type node) 2))
        (add (fnwm-cell-envelope-base-bytes) (str_len (node_value node)))
        (fnwm-node-children-envelope-bytes (node_children node) (sub fuel 1)
          (fnwm-cell-envelope-base-bytes)))))
  (defn fnwm-node-children-envelope-bytes (children fuel total)
    (if (eq (len children) 0) total
      (fnwm-node-children-envelope-bytes (tail children) fuel
        (add total (fnwm-node-envelope-bytes (head children) fuel)))))
  (defn fnwm-element-envelope-bytes (element)
    ; A complete-root walk spends one unit before reaching each element.
    (fnwm-node-envelope-bytes element (sub (fnwm-envelope-walk-fuel) 1)))
  (defn fnwm-elements-envelope-bytes-loop (elements total)
    (if (eq (len elements) 0) total
      (fnwm-elements-envelope-bytes-loop (tail elements)
        (add total (fnwm-element-envelope-bytes (head elements))))))
  (defn fnwm-elements-envelope-bytes (elements)
    (fnwm-elements-envelope-bytes-loop elements
      (fnwm-graph-envelope-base-bytes)))

  ; The lower graph door validates the carrier shape it exposes to query.
  ; Content addressing proves identity, not schema: a forged node can carry a
  ; known category with the wrong children unless this boundary looks.
  (defn fnwm-trivial-int? (n)
    (if (and (eq (node_level n) 1) (eq (node_type n) 1)) 1 0))
  (defn fnwm-trivial-string? (n)
    (if (and (eq (node_level n) 1) (eq (node_type n) 2)) 1 0))
  (defn fnwm-indexed-valid? (n category)
    (if (not (node_eq (node_category n) category)) 0
    (if (not (eq (len (node_children n)) 1)) 0
      (fnwm-trivial-int? (head (node_children n))))))
  (defn fnwm-anchor-valid? (anchor)
    (if (not (node_eq (node_category anchor) (fnc-cat-anchor))) 0
    (if (not (eq (len (node_children anchor)) 1)) 0
      (do (let index-node (head (node_children anchor)))
        (if (not (eq (fnwm-trivial-int? index-node) 1)) 0
          (if (and (ge (node_value index-node) 0)
                   (le (node_value index-node) (fnwm-max-anchor-index))) 1 0))))))
  (defn fnwm-surface-valid? (surface)
    (if (not (node_eq (node_category surface) (cfd-cat-surface))) 0
    (if (not (eq (len (node_children surface)) 2)) 0
      (if (and (eq (fnwm-trivial-string? (nth (node_children surface) 0)) 1)
               (eq (fnwm-trivial-string? (nth (node_children surface) 1)) 1)) 1 0))))
  (defn fnwm-context-valid? (context)
    (if (not (node_eq (node_category context) (cfd-cat-context))) 0
    (if (not (eq (len (node_children context)) 3)) 0
      (if (and (eq (fnwm-trivial-int? (nth (node_children context) 0)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children context) 1)) 1)
               (eq (fnwm-trivial-int? (nth (node_children context) 2)) 1))) 1 0))))
  (defn fnwm-corpus-valid? (corpus)
    (if (not (node_eq (node_category corpus) (cfd-cat-corpus))) 0
    (if (not (eq (len (node_children corpus)) 2)) 0
      (if (and (eq (fnwm-trivial-string? (nth (node_children corpus) 0)) 1)
               (eq (fnwm-trivial-string? (nth (node_children corpus) 1)) 1)) 1 0))))
  (defn fnwm-occurrence-valid? (occurrence)
    (if (not (node_eq (node_category occurrence) (cfd-cat-occurrence))) 0
    (if (not (eq (len (node_children occurrence)) 7)) 0
      (if (and (eq (fnwm-surface-valid? (nth (node_children occurrence) 0)) 1)
          (and (eq (fnwm-context-valid? (nth (node_children occurrence) 1)) 1)
          (and (eq (fnwm-corpus-valid? (nth (node_children occurrence) 2)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children occurrence) 3)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children occurrence) 4)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children occurrence) 5)) 1)
               (eq (fnwm-indexed-valid? (nth (node_children occurrence) 6)
                     (cfd-cat-gap)) 1))))))) 1 0))))
  (defn fnwm-surface-projection-valid? (projection)
    (if (not (node_eq (node_category projection)
                      (cfd-cat-surface-projection))) 0
    (if (not (eq (len (node_children projection)) 3)) 0
      (if (and (eq (fnwm-surface-valid? (nth (node_children projection) 0)) 1)
          (and (eq (fnwm-surface-valid? (nth (node_children projection) 1)) 1)
               (eq (fnwm-trivial-int? (nth (node_children projection) 2)) 1))) 1 0))))
  (defn fnwm-lineage-evidence-valid? (evidence)
    (if (not (node_eq (node_category evidence) (cfd-cat-evidence))) 0
    (if (not (eq (len (node_children evidence)) 7)) 0
      (if (and (eq (fnwm-trivial-int? (nth (node_children evidence) 0)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children evidence) 1)) 1)
          (and (eq (fnwm-trivial-string? (nth (node_children evidence) 2)) 1)
          (and (eq (fnwm-trivial-string? (nth (node_children evidence) 3)) 1)
          (and (eq (fnwm-trivial-string? (nth (node_children evidence) 4)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children evidence) 5)) 1)
               (eq (fnwm-trivial-string? (nth (node_children evidence) 6)) 1))))))) 1 0))))
  (defn fnwm-provenance-valid? (provenance)
    (if (not (node_eq (node_category provenance) (cfd-cat-provenance))) 0
    (if (not (eq (len (node_children provenance)) 7)) 0
      (if (and (eq (fnwm-occurrence-valid? (nth (node_children provenance) 0)) 1)
          (and (eq (fnwm-surface-projection-valid?
                     (nth (node_children provenance) 1)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children provenance) 2)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children provenance) 3)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children provenance) 4)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children provenance) 5)) 1)
               (eq (fnwm-lineage-evidence-valid?
                     (nth (node_children provenance) 6)) 1))))))) 1 0))))
  (defn fnwm-recipe-value-valid? (value fuel)
    (if (le fuel 0) 0
    (if (eq (fnwm-trivial-int? value) 1) 1
    (if (eq (fnwm-indexed-valid? value (cfd-cat-axiom)) 1) 1
    (if (eq (fnwm-indexed-valid? value (cfd-cat-gap)) 1) 1
    (if (node_eq (node_category value) (cfd-cat-meaning))
      (fnwm-recipe-valid? value (sub fuel 1))
      0))))))
  (defn fnwm-recipe-edge-valid? (edge previous-role fuel)
    (if (not (node_eq (node_category edge) (cfd-cat-edge))) 0
    (if (not (eq (len (node_children edge)) 2)) 0
      (do
        (let role (nth (node_children edge) 0))
        (let value (nth (node_children edge) 1))
        (if (not (eq (fnwm-indexed-valid? role (cfd-cat-role)) 1)) 0
          (if (and (gt (node_value (head (node_children role))) previous-role)
                   (eq (fnwm-recipe-value-valid? value fuel) 1)) 1 0))))))
  (defn fnwm-recipe-edges-valid? (edges previous-role fuel)
    (if (eq (len edges) 0) 1
      (if (eq (fnwm-recipe-edge-valid? (head edges) previous-role fuel) 0) 0
        (fnwm-recipe-edges-valid? (tail edges)
          (node_value (head (node_children
            (nth (node_children (head edges)) 0)))) fuel))))
  (defn fnwm-recipe-valid? (recipe fuel)
    (if (le fuel 0) 0
      (if (not (node_eq (node_category recipe) (cfd-cat-meaning))) 0
        (fnwm-recipe-edges-valid? (node_children recipe) -1 fuel))))
  (defn fnwm-symbol-valid? (symbol)
    (if (not (node_eq (node_category symbol) (fnwm-cat-symbol))) 0
    (if (not (eq (len (node_children symbol)) 3)) 0
      (do
        (let value (nth (node_children symbol) 0))
        (let kind-node (nth (node_children symbol) 1))
        (let claim-node (nth (node_children symbol) 2))
        (if (or (not (eq (fnwm-trivial-int? kind-node) 1))
                (not (eq (fnwm-trivial-int? claim-node) 1))) 0
        (if (not (eq (node_value claim-node) 1)) 0
          (if (eq (node_value kind-node) (fnwm-kind-anchor))
            (fnwm-anchor-valid? value)
          (if (eq (node_value kind-node) (fnwm-kind-recipe))
            (fnwm-recipe-valid? value (fnwm-envelope-walk-fuel))
            0))))))))
  (defn fnwm-relation-valid? (relation)
    (if (not (node_eq (node_category relation) (fnwm-cat-relation))) 0
    (if (not (eq (len (node_children relation)) 5)) 0
      (if (and (eq (fnwm-symbol-valid? (nth (node_children relation) 0)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children relation) 1)) 1)
          (and (eq (fnwm-symbol-valid? (nth (node_children relation) 2)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children relation) 3)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children relation) 4)) 1)
          (and (eq (node_value (nth (node_children relation) 1))
                   (fnwm-relation-candidate-alignment))
          (and (gt (node_value (nth (node_children relation) 3)) 0)
          (and (eq (node_value (nth (node_children relation) 4)) 1)
          (and (eq (fnwm-symbol-kind (nth (node_children relation) 0))
                   (fnwm-kind-anchor))
               (eq (fnwm-symbol-kind (nth (node_children relation) 2))
                   (fnwm-kind-recipe))))))))))) 1 0))))
  (defn fnwm-mapping-valid? (mapping)
    (if (not (node_eq (node_category mapping) (cfd-cat-mapping))) 0
      (if (not (eq (len (node_children mapping)) 5)) 0
      (do
        (let source (cfd-map-source mapping))
        (let context (cfd-map-context mapping))
        (let provenance (cfd-map-provenance mapping))
        (if (eq (fnwm-provenance-valid? provenance) 0) 0
          (do
            (let occurrence (cfd-prov-occurrence provenance))
            (let projection (cfd-prov-projection provenance))
            (if (and (eq (fnwm-surface-valid? source) 1)
                (and (eq (fnwm-context-valid? context) 1)
                (and (eq (fnwm-anchor-valid? (cfd-map-meaning mapping)) 1)
                (and (eq (fnwm-surface-valid? (cfd-map-faithful mapping)) 1)
                (and (node_eq (cfd-occ-surface occurrence) source)
                (and (node_eq (cfd-occ-context occurrence) context)
                (and (node_eq (cfd-sp-occurrence projection) source)
                (and (node_eq (cfd-sp-lexeme projection) source)
                     (or (eq (cfd-sp-mode projection) 0)
                         (eq (cfd-sp-mode projection) 1)))))))))) 1 0)))))))
  (defn fnwm-element-valid? (element)
    (do (let category (node_category element))
      (if (node_eq category (fnwm-cat-symbol)) (fnwm-symbol-valid? element)
      (if (node_eq category (fnwm-cat-relation)) (fnwm-relation-valid? element)
      (if (node_eq category (cfd-cat-mapping)) (fnwm-mapping-valid? element)
        0)))))
  (defn fnwm-elements-valid? (elements)
    (if (eq (len elements) 0) 1
      (if (eq (fnwm-element-valid? (head elements)) 1)
        (fnwm-elements-valid? (tail elements)) 0)))
  (defn fnwm-element-linked? (element elements)
    (do (let category (node_category element))
      (if (node_eq category (fnwm-cat-symbol)) 1
      (if (node_eq category (fnwm-cat-relation))
        (if (and (eq (fnwm-member? (fnwm-rel-from element) elements) 1)
                 (eq (fnwm-member? (fnwm-rel-to element) elements) 1)) 1 0)
      (if (node_eq category (cfd-cat-mapping))
        (fnwm-member? (fnwm-anchor-symbol (cfd-map-meaning element)) elements)
        0)))))
  (defn fnwm-elements-linked? (remaining all-elements)
    (if (eq (len remaining) 0) 1
      (if (eq (fnwm-element-linked? (head remaining) all-elements) 1)
        (fnwm-elements-linked? (tail remaining) all-elements) 0)))

  ; graph children = [packed-size, budget, elements...]. Elements are semantic
  ; symbols, directed relations, and cfd mappings; their categories are enough
  ; to query the graph without parallel indexes.
  (defn fnwm-graph (budget elements)
    (do (let packed-size (fnwm-elements-envelope-bytes elements))
      (if (and (eq (fnwm-elements-valid? elements) 1)
          (and (eq (fnwm-elements-linked? elements elements) 1)
          (and (ge budget packed-size)
               (le budget (fnwm-active-budget-bytes)))))
        (intern_node (fnwm-cat-graph)
          (cons (intern_trivial_int packed-size)
            (cons (intern_trivial_int budget) elements)))
        (nothing))))
  (defn fnwm-graph-size (g) (node_value (nth (node_children g) 0)))
  (defn fnwm-graph-budget (g) (node_value (nth (node_children g) 1)))
  (defn fnwm-graph-elements (g) (tail (tail (node_children g))))
  (defn fnwm-empty () (fnwm-graph (fnwm-active-budget-bytes) (list)))
  (defn fnwm-with-budget (g budget)
    (fnwm-graph budget (fnwm-graph-elements g)))
  (defn fnwm-graph-size-honest? (g)
    (if (eq (fnwm-graph-size g)
      (fnwm-node-envelope-bytes g (fnwm-envelope-walk-fuel))) 1 0))
  (defn fnwm-smaller-than-active-llm? (g)
    (if (and (eq (fnwm-graph-size-honest? g) 1)
        (and (le (fnwm-graph-size g) (fnwm-graph-budget g))
        (and (le (fnwm-graph-budget g) (fnwm-active-budget-bytes))
             (lt (fnwm-graph-budget g) (dtrs-dsv4-default-bytes))))) 1 0))

  (defn fnwm-member? (wanted elements)
    (if (eq (len elements) 0) 0
      (if (node_eq wanted (head elements)) 1
        (fnwm-member? wanted (tail elements)))))
  (defn fnwm-append-unique (elements element)
    (if (eq (fnwm-member? element elements) 1) elements
      (append elements (list element))))
  (defn fnwm-elements-of-category (elements category)
    (if (eq (len elements) 0) (list)
      (if (node_eq (node_category (head elements)) category)
        (cons (head elements)
          (fnwm-elements-of-category (tail elements) category))
        (fnwm-elements-of-category (tail elements) category))))
  (defn fnwm-symbols (g)
    (fnwm-elements-of-category (fnwm-graph-elements g) (fnwm-cat-symbol)))
  (defn fnwm-relations (g)
    (fnwm-elements-of-category (fnwm-graph-elements g) (fnwm-cat-relation)))
  (defn fnwm-mappings (g)
    (fnwm-elements-of-category (fnwm-graph-elements g) (cfd-cat-mapping)))

  ; ── extension ─────────────────────────────────────────────────────
  (defn fnwm-anchor-index (anchor)
    (node_value (head (node_children anchor))))
  (defn fnwm-projection-valid? (projection alignment)
    (if (or (nothing? projection) (nothing? alignment)) 0
    (if (not (eq (len projection) 10)) 0
    (if (not (node_eq (node_category alignment) (fnc-cat-alignment))) 0
    (if (not (eq (len (node_children alignment)) 3)) 0
      (do
        (let projection-anchor (fnc-p-anchor projection))
        (let alignment-anchor (fnc-a-anchor alignment))
        (let recipe (fnc-a-recipe alignment))
        (if (not (node_eq (node_category projection-anchor)
                          (fnc-cat-anchor))) 0
        (if (not (node_eq (node_category alignment-anchor)
                          (fnc-cat-anchor))) 0
        (if (or (not (eq (len (node_children projection-anchor)) 1))
                (not (eq (len (node_children alignment-anchor)) 1))) 0
          (if (and (gt (str_len (fnc-p-surface projection)) 0)
              (and (gt (str_len (fnc-p-source projection)) 0)
              (and (gt (str_len (fnc-p-lineage projection)) 0)
              (and (ge (fnc-p-residue projection) 1)
              (and (gt (fnc-a-residue alignment) 0)
              (and (node_eq projection-anchor alignment-anchor)
              (and (node_eq (node_category recipe) (cfd-cat-meaning))
              (and (ge (fnwm-anchor-index projection-anchor) 0)
                   (le (fnwm-anchor-index projection-anchor)
                       (fnwm-max-anchor-index)))))))))) 1 0))))))))))
  (defn fnwm-extend (g projection alignment ordinal)
    (if (or (nothing? g)
        (or (lt ordinal 0)
            (eq (fnwm-projection-valid? projection alignment) 0))) (nothing)
      (do
        (let anchor-node (fnwm-anchor-symbol (fnc-a-anchor alignment)))
        (let recipe-node (fnwm-recipe-symbol (fnc-a-recipe alignment)))
        (let relation (fnwm-alignment-relation alignment))
        (let mapping (fnc-projection-mapping projection ordinal))
        (let e1 (fnwm-append-unique (fnwm-graph-elements g) anchor-node))
        (let e2 (fnwm-append-unique e1 recipe-node))
        (let e3 (fnwm-append-unique e2 relation))
        (let e4 (fnwm-append-unique e3 mapping))
        (fnwm-graph (fnwm-graph-budget g) e4))))

  (defn fnwm-extend-all (g projections alignment ordinal)
    (if (eq (len projections) 0) g
      (do (let next (fnwm-extend g (head projections) alignment ordinal))
        (if (nothing? next) (nothing)
          (fnwm-extend-all next (tail projections) alignment (add ordinal 1))))))
  (defn fnwm-crossing (runtime)
    (do
      (let g1 (fnwm-extend-all (fnwm-empty)
        (fnc-nl-required-projections runtime)
        (fnc-nl-dependency-alignment) 1001))
      (let g2 (if (nothing? g1) (nothing)
        (fnwm-extend-all g1 (fnc-pl-dependency-projections)
          (fnc-pl-dependency-alignment) 2001)))
      (if (nothing? g2) (nothing)
        (fnwm-extend-all g2 (fnc-nl-need-projections)
          (fnc-need-enquiry-alignment) 3001))))

  ; ── directed and bidirectional query ──────────────────────────────
  (defn fnwm-outgoing-loop (edges from)
    (if (eq (len edges) 0) (list)
      (if (node_eq (fnwm-rel-from (head edges)) from)
        (cons (head edges) (fnwm-outgoing-loop (tail edges) from))
        (fnwm-outgoing-loop (tail edges) from))))
  (defn fnwm-incoming-loop (edges to)
    (if (eq (len edges) 0) (list)
      (if (node_eq (fnwm-rel-to (head edges)) to)
        (cons (head edges) (fnwm-incoming-loop (tail edges) to))
        (fnwm-incoming-loop (tail edges) to))))
  (defn fnwm-outgoing (g symbol-node)
    (fnwm-outgoing-loop (fnwm-relations g) symbol-node))
  (defn fnwm-incoming (g symbol-node)
    (fnwm-incoming-loop (fnwm-relations g) symbol-node))
  (defn fnwm-parse (g language text context)
    (cfd-parse-in (fnwm-mappings g) language text context))
  (defn fnwm-project (g anchor language context)
    (cfd-project-in (fnwm-mappings g) anchor language context))

  ; ── native world-model path ───────────────────────────────────────
  ; External anchor indexes use a 16-bit bipolar signature. Exact self-dot is
  ; 1600; any distinct index loses at least one bit and remains held open.
  (defn fnwm-signature-go (index width)
    (if (eq width 0) (list)
      (cons (if (eq (mod index 2) 1) 10 -10)
        (fnwm-signature-go (div index 2) (sub width 1)))))
  (defn fnwm-signature (anchor)
    (fnwm-signature-go (fnwm-anchor-index anchor) 16))
  (defn fnwm-anchor-region (anchor position)
    (list "meaning" (fnwm-signature anchor) position))
  (defn fnwm-observe-anchor (anchor position)
    (wm-entity-embed (fnwm-anchor-region anchor position)))
  (defn fnwm-known-anchor-cell (anchor)
    (im-cell (int_to_str (fnwm-anchor-index anchor)) "meaning"
      (fnwm-signature anchor) 1600))

  (defn fnwm-anchor-nodes-loop (symbols)
    (if (eq (len symbols) 0) (list)
      (if (eq (fnwm-symbol-kind (head symbols)) (fnwm-kind-anchor))
        (cons (head symbols) (fnwm-anchor-nodes-loop (tail symbols)))
        (fnwm-anchor-nodes-loop (tail symbols)))))
  (defn fnwm-anchor-nodes (g) (fnwm-anchor-nodes-loop (fnwm-symbols g)))
  (defn fnwm-known-cells-loop (nodes)
    (if (eq (len nodes) 0) (list)
      (cons (fnwm-known-anchor-cell (fnwm-symbol-value (head nodes)))
        (fnwm-known-cells-loop (tail nodes)))))
  (defn fnwm-known-cells (g) (fnwm-known-cells-loop (fnwm-anchor-nodes g)))
  (defn fnwm-persist-nodes-loop (nodes position viewpoint time known)
    (if (eq (len nodes) 0) (list)
      (do (let anchor (fnwm-symbol-value (head nodes)))
        (cons (wm-persist (fnwm-observe-anchor anchor position)
                viewpoint time known)
          (fnwm-persist-nodes-loop (tail nodes) position viewpoint time known)))))
  (defn fnwm-world (g position viewpoint time)
    (do (let nodes (fnwm-anchor-nodes g))
      (fnwm-persist-nodes-loop nodes position viewpoint time
        (fnwm-known-cells g))))
  (defn fnwm-world-image (g position viewpoint time)
    (wm-model (fnwm-world g position viewpoint time)))
  (defn fnwm-world-meaning-count (g position viewpoint time)
    (wm-orient-count (fnwm-world g position viewpoint time) "meaning"))

  ; The semantic subgraph itself carries no surface cells. Mapping projections
  ; are intentionally excluded: they are the evidence-bearing language plane.
  (defn fnwm-semantic-surface-free-loop (elements)
    (if (eq (len elements) 0) 1
      (if (eq (cfd-no-surface? (head elements) 64) 1)
        (fnwm-semantic-surface-free-loop (tail elements)) 0)))
  (defn fnwm-semantic-surface-free? (g)
    (fnwm-semantic-surface-free-loop
      (append (fnwm-symbols g) (fnwm-relations g))))

  0)
