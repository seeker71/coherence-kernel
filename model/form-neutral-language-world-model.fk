// form-neutral-language-world-model.fk — language projections enter the native
// world model without turning their surfaces into meaning identity.
//
// The semantic graph is small, directed, and content-addressed:
//
//   NL / PL surface -> evidence-bearing mapping -> external anchor
//   external anchor -> candidate alignment edge -> numeric meaning recipe
//
// The first relation remains queryable in both directions through the shared
// dictionary parser/projector. The second is a claim-1 edge with visible
// residue, not semantic or cultural equivalence. Only external anchors enter
// world-model recognition. They use the same wm-entity-embed / wm-persist /
// wm-orient path as every other entity kind; no language receives a separate
// engine.
//
// Size stays bounded by an explicit canonical packed-envelope estimate. The
// active graph may occupy at most 16 MiB; larger corpora remain content-addressed
// shards outside the active model and project in as needed. This is an active
// symbolic working set, not a parameter model. Its ceiling is compared with the
// repository's measured 9.103 GB DS4 resident-weight baseline.
//
// witnessed: 2026-08-14 -> native band 65535; complete-root envelope 87362
import "../form/form-stdlib/core.fk"
import "../form/form-stdlib/speaker-embed.fk"
import "../form/form-stdlib/champion-challenger.fk"
import "../form/form-stdlib/identity-match.fk"
import "../form/form-stdlib/face-embed.fk"
import "../form/form-stdlib/spatial-fusion.fk"
import "../form/form-stdlib/world-model.fk"
import "../form/form-stdlib/dsv4-token-recipe-swap.fk"
import "../cognition/core-frequency-lift-form-neutral-crossing.fk"
section [form.bml] {
    // ── graph cells ───────────────────────────────────────────────────
    def fnwm-cat-symbol() = make_nodeid(31, 2, 0, 23);
    def fnwm-cat-relation() = make_nodeid(31, 2, 0, 24);
    def fnwm-cat-graph() = make_nodeid(31, 2, 0, 25);
    def fnwm-kind-anchor() = 1;
    def fnwm-kind-recipe() = 2;
    def fnwm-relation-candidate-alignment() = 1;
    def fnwm-symbol(symbol, kind, claim) = intern_node(fnwm-cat-symbol(), [symbol, intern_trivial_int(kind), intern_trivial_int(claim)]);
    def fnwm-symbol-value(n) = node_children(n)[0];
    def fnwm-symbol-kind(n) = node_value(node_children(n)[1]);
    def fnwm-symbol-claim(n) = node_value(node_children(n)[2]);
    def fnwm-anchor-symbol(anchor) = fnwm-symbol(anchor, fnwm-kind-anchor(), 1);
    def fnwm-recipe-symbol(recipe) = fnwm-symbol(recipe, fnwm-kind-recipe(), 1);
    def fnwm-relation(from, relation, to, residue, claim) = intern_node(fnwm-cat-relation(), [from, intern_trivial_int(relation), to, intern_trivial_int(residue), intern_trivial_int(claim)]);
    def fnwm-rel-from(e) = node_children(e)[0];
    def fnwm-rel-kind(e) = node_value(node_children(e)[1]);
    def fnwm-rel-to(e) = node_children(e)[2];
    def fnwm-rel-residue(e) = node_value(node_children(e)[3]);
    def fnwm-rel-claim(e) = node_value(node_children(e)[4]);
    def fnwm-alignment-relation(alignment) = fnwm-relation(fnwm-anchor-symbol(fnc-a-anchor(alignment)), fnwm-relation-candidate-alignment(), fnwm-recipe-symbol(fnc-a-recipe(alignment)), fnc-a-residue(alignment), 1);
    // ── active-size covenant ──────────────────────────────────────────
    // The packed envelope is deliberately conservative and inspectable. Every
    // reachable cell contributes 32 structural bytes; every trivial string also
    // contributes its complete payload. Shared descendants are counted again at
    // every reference, so this cannot hide a large faithful surface, provenance
    // field, recipe, or future child behind a fixed top-level cost. It is not a
    // claim about the evaluator's heap layout; it is the bounded canonical export
    // contract.
    def fnwm-active-budget-bytes() = 16777216;
    def fnwm-cell-envelope-base-bytes() = 32;
    // root + packed-size trivial + budget trivial
    def fnwm-graph-envelope-base-bytes() = 96;
    def fnwm-envelope-walk-fuel() = 256;
    def fnwm-max-anchor-index() = 65535;
    def fnwm-node-envelope-bytes(node, fuel) = fuel <= 0 ? (Number) fnwm-active-budget-bytes() + (Number) 1 : (Comparable) node_level(node) == 1 && (Comparable) node_type(node) == 2 ? (Number) fnwm-cell-envelope-base-bytes() + (Number) len(node_value(node)) : fnwm-node-children-envelope-bytes(node_children(node), fuel - 1, fnwm-cell-envelope-base-bytes());
    def fnwm-node-children-envelope-bytes(children, fuel, total) = (Comparable) len(children) == 0 ? total : fnwm-node-children-envelope-bytes(children[1:], fuel, (Number) total + (Number) fnwm-node-envelope-bytes(children[0], fuel));
    def fnwm-element-envelope-bytes(element) =     // A complete-root walk spends one unit before reaching each element.
fnwm-node-envelope-bytes(element, fnwm-envelope-walk-fuel() - 1);
    def fnwm-elements-envelope-bytes-loop(elements, total) = (Comparable) len(elements) == 0 ? total : fnwm-elements-envelope-bytes-loop(elements[1:], (Number) total + (Number) fnwm-element-envelope-bytes(elements[0]));
    def fnwm-elements-envelope-bytes(elements) = fnwm-elements-envelope-bytes-loop(elements, fnwm-graph-envelope-base-bytes());
    // The lower graph door validates the carrier shape it exposes to query.
    // Content addressing proves identity, not schema: a forged node can carry a
    // known category with the wrong children unless this boundary looks.
    def fnwm-trivial-int?(n) = (Comparable) node_level(n) == 1 && (Comparable) node_type(n) == 1 ? 1 : 0;
    def fnwm-trivial-string?(n) = (Comparable) node_level(n) == 1 && (Comparable) node_type(n) == 2 ? 1 : 0;
    def fnwm-indexed-valid?(n, category) = !node_eq(node_category(n), category) ? 0 : !((Comparable) len(node_children(n)) == 1) ? 0 : fnwm-trivial-int?(node_children(n)[0]);
    def fnwm-anchor-valid?(anchor) = !node_eq(node_category(anchor), fnc-cat-anchor()) ? 0 : !((Comparable) len(node_children(anchor)) == 1) ? 0 : {
        let index-node = node_children(anchor)[0];
        !((Comparable) fnwm-trivial-int?(index-node) == 1) ? 0 : node_value(index-node) >= 0 && node_value(index-node) <= fnwm-max-anchor-index() ? 1 : 0;
    };
    def fnwm-surface-valid?(surface) = !node_eq(node_category(surface), cfd-cat-surface()) ? 0 : !((Comparable) len(node_children(surface)) == 2) ? 0 : (Comparable) fnwm-trivial-string?(node_children(surface)[0]) == 1 && (Comparable) fnwm-trivial-string?(node_children(surface)[1]) == 1 ? 1 : 0;
    def fnwm-context-valid?(context) = !node_eq(node_category(context), cfd-cat-context()) ? 0 : !((Comparable) len(node_children(context)) == 3) ? 0 : (Comparable) fnwm-trivial-int?(node_children(context)[0]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(context)[1]) == 1 && (Comparable) fnwm-trivial-int?(node_children(context)[2]) == 1) ? 1 : 0;
    def fnwm-corpus-valid?(corpus) = !node_eq(node_category(corpus), cfd-cat-corpus()) ? 0 : !((Comparable) len(node_children(corpus)) == 2) ? 0 : (Comparable) fnwm-trivial-string?(node_children(corpus)[0]) == 1 && (Comparable) fnwm-trivial-string?(node_children(corpus)[1]) == 1 ? 1 : 0;
    def fnwm-occurrence-valid?(occurrence) = !node_eq(node_category(occurrence), cfd-cat-occurrence()) ? 0 : !((Comparable) len(node_children(occurrence)) == 7) ? 0 : (Comparable) fnwm-surface-valid?(node_children(occurrence)[0]) == 1 && ((Comparable) fnwm-context-valid?(node_children(occurrence)[1]) == 1 && ((Comparable) fnwm-corpus-valid?(node_children(occurrence)[2]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(occurrence)[3]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(occurrence)[4]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(occurrence)[5]) == 1 && (Comparable) fnwm-indexed-valid?(node_children(occurrence)[6], cfd-cat-gap()) == 1))))) ? 1 : 0;
    def fnwm-surface-projection-valid?(projection) = !node_eq(node_category(projection), cfd-cat-surface-projection()) ? 0 : !((Comparable) len(node_children(projection)) == 3) ? 0 : (Comparable) fnwm-surface-valid?(node_children(projection)[0]) == 1 && ((Comparable) fnwm-surface-valid?(node_children(projection)[1]) == 1 && (Comparable) fnwm-trivial-int?(node_children(projection)[2]) == 1) ? 1 : 0;
    def fnwm-lineage-evidence-valid?(evidence) = !node_eq(node_category(evidence), cfd-cat-evidence()) ? 0 : !((Comparable) len(node_children(evidence)) == 7) ? 0 : (Comparable) fnwm-trivial-int?(node_children(evidence)[0]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(evidence)[1]) == 1 && ((Comparable) fnwm-trivial-string?(node_children(evidence)[2]) == 1 && ((Comparable) fnwm-trivial-string?(node_children(evidence)[3]) == 1 && ((Comparable) fnwm-trivial-string?(node_children(evidence)[4]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(evidence)[5]) == 1 && (Comparable) fnwm-trivial-string?(node_children(evidence)[6]) == 1))))) ? 1 : 0;
    def fnwm-provenance-valid?(provenance) = !node_eq(node_category(provenance), cfd-cat-provenance()) ? 0 : !((Comparable) len(node_children(provenance)) == 7) ? 0 : (Comparable) fnwm-occurrence-valid?(node_children(provenance)[0]) == 1 && ((Comparable) fnwm-surface-projection-valid?(node_children(provenance)[1]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(provenance)[2]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(provenance)[3]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(provenance)[4]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(provenance)[5]) == 1 && (Comparable) fnwm-lineage-evidence-valid?(node_children(provenance)[6]) == 1))))) ? 1 : 0;
    def fnwm-recipe-value-valid?(value, fuel) = fuel <= 0 ? 0 : (Comparable) fnwm-trivial-int?(value) == 1 ? 1 : (Comparable) fnwm-indexed-valid?(value, cfd-cat-axiom()) == 1 ? 1 : (Comparable) fnwm-indexed-valid?(value, cfd-cat-gap()) == 1 ? 1 : node_eq(node_category(value), cfd-cat-meaning()) ? fnwm-recipe-valid?(value, fuel - 1) : 0;
    def fnwm-recipe-edge-valid?(edge, previous-role, fuel) = !node_eq(node_category(edge), cfd-cat-edge()) ? 0 : !((Comparable) len(node_children(edge)) == 2) ? 0 : {
        let role = node_children(edge)[0];
        let value = node_children(edge)[1];
        !((Comparable) fnwm-indexed-valid?(role, cfd-cat-role()) == 1) ? 0 : node_value(node_children(role)[0]) > previous-role && (Comparable) fnwm-recipe-value-valid?(value, fuel) == 1 ? 1 : 0;
    };
    def fnwm-recipe-edges-valid?(edges, previous-role, fuel) = (Comparable) len(edges) == 0 ? 1 : (Comparable) fnwm-recipe-edge-valid?(edges[0], previous-role, fuel) == 0 ? 0 : fnwm-recipe-edges-valid?(edges[1:], node_value(node_children(node_children(edges[0])[0])[0]), fuel);
    def fnwm-recipe-valid?(recipe, fuel) = fuel <= 0 ? 0 : !node_eq(node_category(recipe), cfd-cat-meaning()) ? 0 : fnwm-recipe-edges-valid?(node_children(recipe), -1, fuel);
    def fnwm-symbol-valid?(symbol) = !node_eq(node_category(symbol), fnwm-cat-symbol()) ? 0 : !((Comparable) len(node_children(symbol)) == 3) ? 0 : {
        let value = node_children(symbol)[0];
        let kind-node = node_children(symbol)[1];
        let claim-node = node_children(symbol)[2];
        !((Comparable) fnwm-trivial-int?(kind-node) == 1) || !((Comparable) fnwm-trivial-int?(claim-node) == 1) ? 0 : !((Comparable) node_value(claim-node) == 1) ? 0 : (Comparable) node_value(kind-node) == fnwm-kind-anchor() ? fnwm-anchor-valid?(value) : (Comparable) node_value(kind-node) == fnwm-kind-recipe() ? fnwm-recipe-valid?(value, fnwm-envelope-walk-fuel()) : 0;
    };
    def fnwm-relation-valid?(relation) = !node_eq(node_category(relation), fnwm-cat-relation()) ? 0 : !((Comparable) len(node_children(relation)) == 5) ? 0 : (Comparable) fnwm-symbol-valid?(node_children(relation)[0]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(relation)[1]) == 1 && ((Comparable) fnwm-symbol-valid?(node_children(relation)[2]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(relation)[3]) == 1 && ((Comparable) fnwm-trivial-int?(node_children(relation)[4]) == 1 && ((Comparable) node_value(node_children(relation)[1]) == fnwm-relation-candidate-alignment() && (node_value(node_children(relation)[3]) > 0 && ((Comparable) node_value(node_children(relation)[4]) == 1 && ((Comparable) fnwm-symbol-kind(node_children(relation)[0]) == fnwm-kind-anchor() && (Comparable) fnwm-symbol-kind(node_children(relation)[2]) == fnwm-kind-recipe())))))))) ? 1 : 0;
    def fnwm-mapping-valid?(mapping) = !node_eq(node_category(mapping), cfd-cat-mapping()) ? 0 : !((Comparable) len(node_children(mapping)) == 5) ? 0 : {
        let source = cfd-map-source(mapping);
        let context = cfd-map-context(mapping);
        let provenance = cfd-map-provenance(mapping);
        (Comparable) fnwm-provenance-valid?(provenance) == 0 ? 0 : {
            let occurrence = cfd-prov-occurrence(provenance);
            let projection = cfd-prov-projection(provenance);
            (Comparable) fnwm-surface-valid?(source) == 1 && ((Comparable) fnwm-context-valid?(context) == 1 && ((Comparable) fnwm-anchor-valid?(cfd-map-meaning(mapping)) == 1 && ((Comparable) fnwm-surface-valid?(cfd-map-faithful(mapping)) == 1 && (node_eq(cfd-occ-surface(occurrence), source) && (node_eq(cfd-occ-context(occurrence), context) && (node_eq(cfd-sp-occurrence(projection), source) && (node_eq(cfd-sp-lexeme(projection), source) && ((Comparable) cfd-sp-mode(projection) == 0 || (Comparable) cfd-sp-mode(projection) == 1)))))))) ? 1 : 0;
        };
    };
    def fnwm-element-valid?(element) = {
        let category = node_category(element);
        node_eq(category, fnwm-cat-symbol()) ? fnwm-symbol-valid?(element) : node_eq(category, fnwm-cat-relation()) ? fnwm-relation-valid?(element) : node_eq(category, cfd-cat-mapping()) ? fnwm-mapping-valid?(element) : 0;
    };
    def fnwm-elements-valid?(elements) = (Comparable) len(elements) == 0 ? 1 : (Comparable) fnwm-element-valid?(elements[0]) == 1 ? fnwm-elements-valid?(elements[1:]) : 0;
    def fnwm-element-linked?(element, elements) = {
        let category = node_category(element);
        node_eq(category, fnwm-cat-symbol()) ? 1 : node_eq(category, fnwm-cat-relation()) ? (Comparable) fnwm-member?(fnwm-rel-from(element), elements) == 1 && (Comparable) fnwm-member?(fnwm-rel-to(element), elements) == 1 ? 1 : 0 : node_eq(category, cfd-cat-mapping()) ? fnwm-member?(fnwm-anchor-symbol(cfd-map-meaning(element)), elements) : 0;
    };
    def fnwm-elements-linked?(remaining, all-elements) = (Comparable) len(remaining) == 0 ? 1 : (Comparable) fnwm-element-linked?(remaining[0], all-elements) == 1 ? fnwm-elements-linked?(remaining[1:], all-elements) : 0;
    // graph children = [packed-size, budget, elements...]. Elements are semantic
    // symbols, directed relations, and cfd mappings; their categories are enough
    // to query the graph without parallel indexes.
    def fnwm-graph(budget, elements) = {
        let packed-size = fnwm-elements-envelope-bytes(elements);
        (Comparable) fnwm-elements-valid?(elements) == 1 && ((Comparable) fnwm-elements-linked?(elements, elements) == 1 && (budget >= packed-size && budget <= fnwm-active-budget-bytes())) ? intern_node(fnwm-cat-graph(), cons(intern_trivial_int(packed-size), cons(intern_trivial_int(budget), elements))) : nothing();
    };
    def fnwm-graph-size(g) = node_value(node_children(g)[0]);
    def fnwm-graph-budget(g) = node_value(node_children(g)[1]);
    def fnwm-graph-elements(g) = node_children(g)[1:][1:];
    def fnwm-empty() = fnwm-graph(fnwm-active-budget-bytes(), []);
    def fnwm-with-budget(g, budget) = fnwm-graph(budget, fnwm-graph-elements(g));
    def fnwm-graph-size-honest?(g) = (Comparable) fnwm-graph-size(g) == fnwm-node-envelope-bytes(g, fnwm-envelope-walk-fuel()) ? 1 : 0;
    def fnwm-smaller-than-active-llm?(g) = (Comparable) fnwm-graph-size-honest?(g) == 1 && (fnwm-graph-size(g) <= fnwm-graph-budget(g) && (fnwm-graph-budget(g) <= fnwm-active-budget-bytes() && fnwm-graph-budget(g) < dtrs-dsv4-default-bytes())) ? 1 : 0;
    def fnwm-member?(wanted, elements) = (Comparable) len(elements) == 0 ? 0 : node_eq(wanted, elements[0]) ? 1 : fnwm-member?(wanted, elements[1:]);
    def fnwm-append-unique(elements, element) = (Comparable) fnwm-member?(element, elements) == 1 ? elements : append(elements, [element]);
    def fnwm-elements-of-category(elements, category) = (Comparable) len(elements) == 0 ? [] : node_eq(node_category(elements[0]), category) ? cons(elements[0], fnwm-elements-of-category(elements[1:], category)) : fnwm-elements-of-category(elements[1:], category);
    def fnwm-symbols(g) = fnwm-elements-of-category(fnwm-graph-elements(g), fnwm-cat-symbol());
    def fnwm-relations(g) = fnwm-elements-of-category(fnwm-graph-elements(g), fnwm-cat-relation());
    def fnwm-mappings(g) = fnwm-elements-of-category(fnwm-graph-elements(g), cfd-cat-mapping());
    // ── extension ─────────────────────────────────────────────────────
    def fnwm-anchor-index(anchor) = node_value(node_children(anchor)[0]);
    // A validator orders only what it has asked: a residue that is not a number
    // has no order, so it fails the check instead of being measured.
    def fnwm-number?(x) = (String) value_kind(x) == "int" || (String) value_kind(x) == "float";
    def fnwm-num-ge?(x, n) = fnwm-number?(x) ? x >= n : 0;
    def fnwm-num-gt?(x, n) = fnwm-number?(x) ? x > n : 0;
    def fnwm-projection-valid?(projection, alignment) = nothing?(projection) || nothing?(alignment) ? 0 : !((Comparable) len(projection) == 10) ? 0 : !node_eq(node_category(alignment), fnc-cat-alignment()) ? 0 : !((Comparable) len(node_children(alignment)) == 3) ? 0 : {
        let projection-anchor = fnc-p-anchor(projection);
        let alignment-anchor = fnc-a-anchor(alignment);
        let recipe = fnc-a-recipe(alignment);
        !node_eq(node_category(projection-anchor), fnc-cat-anchor()) ? 0 : !node_eq(node_category(alignment-anchor), fnc-cat-anchor()) ? 0 : !((Comparable) len(node_children(projection-anchor)) == 1) || !((Comparable) len(node_children(alignment-anchor)) == 1) ? 0 : len(fnc-p-surface(projection)) > 0 && (len(fnc-p-source(projection)) > 0 && (len(fnc-p-lineage(projection)) > 0 && (fnc-p-residue(projection) >= 1 && (fnc-a-residue(alignment) > 0 && (node_eq(projection-anchor, alignment-anchor) && (node_eq(node_category(recipe), cfd-cat-meaning()) && (fnwm-num-ge?(fnwm-anchor-index(projection-anchor), 0) && (fnwm-number?(fnwm-anchor-index(projection-anchor)) ? fnwm-anchor-index(projection-anchor) <= fnwm-max-anchor-index() : 0)))))))) ? 1 : 0;
    };
    def fnwm-extend(g, projection, alignment, ordinal) = nothing?(g) || (ordinal < 0 || (Comparable) fnwm-projection-valid?(projection, alignment) == 0) ? nothing() : {
        let anchor-node = fnwm-anchor-symbol(fnc-a-anchor(alignment));
        let recipe-node = fnwm-recipe-symbol(fnc-a-recipe(alignment));
        let relation = fnwm-alignment-relation(alignment);
        let mapping = fnc-projection-mapping(projection, ordinal);
        let e1 = fnwm-append-unique(fnwm-graph-elements(g), anchor-node);
        let e2 = fnwm-append-unique(e1, recipe-node);
        let e3 = fnwm-append-unique(e2, relation);
        let e4 = fnwm-append-unique(e3, mapping);
        fnwm-graph(fnwm-graph-budget(g), e4);
    };
    def fnwm-extend-all(g, projections, alignment, ordinal) = (Comparable) len(projections) == 0 ? g : {
        let next = fnwm-extend(g, projections[0], alignment, ordinal);
        nothing?(next) ? nothing() : fnwm-extend-all(next, projections[1:], alignment, (Number) ordinal + (Number) 1);
    };
    def fnwm-crossing(runtime) = {
        let g1 = fnwm-extend-all(fnwm-empty(), fnc-nl-required-projections(runtime), fnc-nl-dependency-alignment(), 1001);
        let g2 = nothing?(g1) ? nothing() : fnwm-extend-all(g1, fnc-pl-dependency-projections(), fnc-pl-dependency-alignment(), 2001);
        nothing?(g2) ? nothing() : fnwm-extend-all(g2, fnc-nl-need-projections(), fnc-need-enquiry-alignment(), 3001);
    };
    // ── directed and bidirectional query ──────────────────────────────
    def fnwm-outgoing-loop(edges, from) = (Comparable) len(edges) == 0 ? [] : node_eq(fnwm-rel-from(edges[0]), from) ? cons(edges[0], fnwm-outgoing-loop(edges[1:], from)) : fnwm-outgoing-loop(edges[1:], from);
    def fnwm-incoming-loop(edges, to) = (Comparable) len(edges) == 0 ? [] : node_eq(fnwm-rel-to(edges[0]), to) ? cons(edges[0], fnwm-incoming-loop(edges[1:], to)) : fnwm-incoming-loop(edges[1:], to);
    def fnwm-outgoing(g, symbol-node) = fnwm-outgoing-loop(fnwm-relations(g), symbol-node);
    def fnwm-incoming(g, symbol-node) = fnwm-incoming-loop(fnwm-relations(g), symbol-node);
    def fnwm-parse(g, language, text, context) = cfd-parse-in(fnwm-mappings(g), language, text, context);
    def fnwm-project(g, anchor, language, context) = cfd-project-in(fnwm-mappings(g), anchor, language, context);
    // ── native world-model path ───────────────────────────────────────
    // External anchor indexes use a 16-bit bipolar signature. Exact self-dot is
    // 1600; any distinct index loses at least one bit and remains held open.
    def fnwm-signature-go(index, width) = (Comparable) width == 0 ? [] : cons((Comparable) (index % 2) == 1 ? 10 : -10, fnwm-signature-go(index / 2, width - 1));
    def fnwm-signature(anchor) = fnwm-signature-go(fnwm-anchor-index(anchor), 16);
    def fnwm-anchor-region(anchor, position) = ["meaning", fnwm-signature(anchor), position];
    def fnwm-observe-anchor(anchor, position) = wm-entity-embed(fnwm-anchor-region(anchor, position));
    def fnwm-known-anchor-cell(anchor) = im-cell(fnwm-anchor-index(anchor).str(), "meaning", fnwm-signature(anchor), 1600);
    def fnwm-anchor-nodes-loop(symbols) = (Comparable) len(symbols) == 0 ? [] : (Comparable) fnwm-symbol-kind(symbols[0]) == fnwm-kind-anchor() ? cons(symbols[0], fnwm-anchor-nodes-loop(symbols[1:])) : fnwm-anchor-nodes-loop(symbols[1:]);
    def fnwm-anchor-nodes(g) = fnwm-anchor-nodes-loop(fnwm-symbols(g));
    def fnwm-known-cells-loop(nodes) = (Comparable) len(nodes) == 0 ? [] : cons(fnwm-known-anchor-cell(fnwm-symbol-value(nodes[0])), fnwm-known-cells-loop(nodes[1:]));
    def fnwm-known-cells(g) = fnwm-known-cells-loop(fnwm-anchor-nodes(g));
    def fnwm-persist-nodes-loop(nodes, position, viewpoint, time, known) = (Comparable) len(nodes) == 0 ? [] : {
        let anchor = fnwm-symbol-value(nodes[0]);
        cons(wm-persist(fnwm-observe-anchor(anchor, position), viewpoint, time, known), fnwm-persist-nodes-loop(nodes[1:], position, viewpoint, time, known));
    };
    def fnwm-world(g, position, viewpoint, time) = {
        let nodes = fnwm-anchor-nodes(g);
        fnwm-persist-nodes-loop(nodes, position, viewpoint, time, fnwm-known-cells(g));
    };
    def fnwm-world-image(g, position, viewpoint, time) = wm-model(fnwm-world(g, position, viewpoint, time));
    def fnwm-world-meaning-count(g, position, viewpoint, time) = wm-orient-count(fnwm-world(g, position, viewpoint, time), "meaning");
    // The semantic subgraph itself carries no surface cells. Mapping projections
    // are intentionally excluded: they are the evidence-bearing language plane.
    def fnwm-semantic-surface-free-loop(elements) = (Comparable) len(elements) == 0 ? 1 : (Comparable) cfd-no-surface?(elements[0], 64) == 1 ? fnwm-semantic-surface-free-loop(elements[1:]) : 0;
    def fnwm-semantic-surface-free?(g) = fnwm-semantic-surface-free-loop(append(fnwm-symbols(g), fnwm-relations(g)));
    0;
}
