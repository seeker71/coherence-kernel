// ctc-logspace.fk — the CTC forward in LOG space: the stabilization stone.
//
// model/ctc-loss.fk's product-form alpha underflows on real-length sequences —
// a probability that is a product of hundreds of per-frame terms rounds to 0 in
// double precision, and the whole objective becomes useless (log 0 = -inf,
// gradient 0). This is why every real CTC implementation runs in log space. The
// recursion becomes, with log-sum-exp in place of add and + in place of *:
//
//   log-alpha_t(s) = LSE( log-alpha_{t-1}(s), log-alpha_{t-1}(s-1),
//                         [skip] log-alpha_{t-1}(s-2) ) + log y_t(ext[s])
//   log-p = LSE( log-alpha_T(2L), log-alpha_T(2L-1) )
//
// LSE(a,b) = m + log(exp(a-m) + exp(b-m)), m = max(a,b) — the numerically stable
// form (the largest term is factored out so no exp overflows). log(0) is carried
// as a large-negative sentinel (clogz), and LSE of two sentinels stays a sentinel.
//
// Proven on fkwu:
//   correctness — exp(log-p) equals model/ctc-loss.fk's probability-space p on
//     the toys ("a" -> 0.75, "ab" -> 0.25), to 1e-6.
//   the point — a 10-frame sequence of per-frame probability 1e-40 gives
//     probability-space p = (1e-40)^10 = 1e-400 = EXACTLY 0.0 (underflowed),
//     while log-space gives a finite ~-921 (= 10 * ln(1e-40)). Same computation,
//     usable answer.
//
// HONEST FLOOR: this is the FORWARD in log space. The backward (beta) and the
// gradient in log space — needed so training itself is
// stable at length — is the next refinement. Still toy scale, still free logits.
// But the underflow wall that blocked real-length CTC is down.
//
import form-stdlib/core.fk;
import form-stdlib/transformer-numerics.fk;
import form-stdlib/trig.fk;
import model/ctc-loss.fk;
section [form.bml] {
    def clog-z() = -1.0e18;
    // log(0) sentinel
    def clog-max(a, b) = a > b ? a : b;
    def clog-lse2(a, b) = clog-max(a, b) <= -1.0e17 ? clog-z() : {
        let m = clog-max(a, b);
        (Number) m + (Number) fln((Number) tn-exp(a - m) + (Number) tn-exp(b - m));
    };
    def clog-logp(y) = y <= 0.0 ? clog-z() : fln(y);
    def clog-at(xs, i) = i < 0 ? clog-z() : i >= len(xs) ? clog-z() : nth(xs, i);
    def clog-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : clog-rev(xs[1:], cons(xs[0], acc));
    def clog-init-loop(ext, y0, s, acc) = s >= len(ext) ? clog-rev(acc, empty()) : clog-init-loop(ext, y0, (Number) s + (Number) 1, cons((Comparable) s == 0 ? clog-logp(nth(y0, ext[0])) : (Comparable) s == 1 ? clog-logp(nth(y0, ext[1])) : clog-z(), acc));
    def clog-init(ext, y0) = clog-init-loop(ext, y0, 0, empty());
    def clog-step-loop(ext, frame, prev, s, acc) = s >= len(ext) ? clog-rev(acc, empty()) : {
        let base = clog-lse2(clog-at(prev, s), clog-at(prev, s - 1));
        let ws = (Comparable) ctc-skip?(ext, s) == 1 ? clog-lse2(base, clog-at(prev, s - 2)) : base;
        clog-step-loop(ext, frame, prev, (Number) s + (Number) 1, cons((Number) ws + (Number) clog-logp(nth(frame, nth(ext, s))), acc));
    };
    def clog-step(ext, frame, prev) = clog-step-loop(ext, frame, prev, 0, empty());
    def clog-fold(ext, frames, a) = (Comparable) len(frames) == 0 ? a : clog-fold(ext, frames[1:], clog-step(ext, frames[0], a));
    // log p_total over per-frame probability frames and a target label sequence
    def clog-forward(frames, tgt) = {
        let ext = ctc-ext(tgt);
        let a0 = clog-init(ext, frames[0]);
        let af = clog-fold(ext, frames[1:], a0);
        clog-lse2(clog-at(af, len(ext) - 1), clog-at(af, len(ext) - 2));
    };
    // the log-space CTC loss is just -log-p (already the negative log-likelihood)
    def clog-loss(frames, tgt) = 0.0 - clog-forward(frames, tgt);
    0;
}
