// Numeric token coordinates require a nonempty recipe at every nested level.
// Empty dictionary/world recipes remain values; they are not numeric tokens.
// Shape, role order, scalar types and anchor bounds stay owned by the world.
// preludes: model/form-neutral-language-world-model.fk
section [form.bml] {
 class FormNeutralTokenCoordinate {
  def fntc-symbol-valid?(symbol) = if not(fnwm-symbol-valid?(symbol)) then 0 else if eq(fnwm-symbol-kind(symbol),fnwm-kind-anchor()) then 1 else fntc-recipe-present?(fnwm-symbol-value(symbol),fnwm-envelope-walk-fuel());
  def fntc-relation-valid?(relation) = if not(fnwm-relation-valid?(relation)) then 0 else and(fntc-symbol-valid?(fnwm-rel-from(relation)),fntc-symbol-valid?(fnwm-rel-to(relation)));
  def fntc-recipe-present?(recipe,fuel) = if or(le(fuel,0),nil?(node_children(recipe))) then 0 else fntc-edges-present?(node_children(recipe),fuel);
  def fntc-edges-present?(edges,fuel) = if nil?(edges) then 1 else and(fntc-value-present?(nth(node_children(head(edges)),1),fuel),fntc-edges-present?(tail(edges),fuel));
  def fntc-value-present?(value,fuel) = if node_eq(node_category(value),cfd-cat-meaning()) then fntc-recipe-present?(value,sub(fuel,1)) else 1;
 }
 0;
}
