// Numeric token coordinates require a nonempty recipe at every nested level.
// Empty dictionary/world recipes remain values; they are not numeric tokens.
// Shape, role order, scalar types and anchor bounds stay owned by the world.
// preludes: model/form-neutral-language-world-model.fk
section [form.bml] {
 class FormNeutralTokenCoordinate {
  def fntc-symbol-valid?(symbol) = !fnwm-symbol-valid?(symbol) ? 0 : (Comparable) fnwm-symbol-kind(symbol) == fnwm-kind-anchor() ? 1 : fntc-recipe-present?(fnwm-symbol-value(symbol),fnwm-envelope-walk-fuel());
  def fntc-relation-valid?(relation) = !fnwm-relation-valid?(relation) ? 0 : (fntc-symbol-valid?(fnwm-rel-from(relation)) && fntc-symbol-valid?(fnwm-rel-to(relation)));
  def fntc-recipe-present?(recipe,fuel) = (fuel <= 0) || nil?(node_children(recipe)) ? 0 : fntc-edges-present?(node_children(recipe),fuel);
  def fntc-edges-present?(edges,fuel) = nil?(edges) ? 1 : (fntc-value-present?(node_children(head(edges))[1],fuel) && fntc-edges-present?(tail(edges),fuel));
  def fntc-value-present?(value,fuel) = node_eq(node_category(value),cfd-cat-meaning()) ? fntc-recipe-present?(value,fuel - 1) : 1;
 }
 0;
}
