; form-neutral-language-world-model-activation.fk — observed frequency selects a
; bounded context shard before a local model may offer a mapping selection.
;
; Frequency remains evidence, not meaning. Each frequency cell binds one
; existing mapping to a named corpus, hit/total counts, an evidence index, and
; claim state 2. Ranking compares exact ratios and breaks ties by the mapping's
; occurrence ordinal, so input order cannot change the activated shard.
;
; The activation path is deliberately narrow:
;
;   graph + context + observed frequencies -> exact bounded shard
;   shard -> form-cli local offer -> candidate mapping selection
;   selection + numeric recipe -> sovereign candidate meaning + graph edge
;
; The offer contains only numeric interface/tier/claim cells. The local model
; may point to a mapping already present in the shard and may mint a new
; content-addressed numeric meaning recipe from the dictionary's own cells. The
; new meaning exists immediately and joins a candidate overlay. It does not
; erase its predecessor: it may become an explicit successor while both cells
; remain addressable. Residue stays visible, shared meaning stays
; participant-observed, and tokenizer equivalence stays open until witnessed.
; This cell offers the local constructor; a remote-shaped offer does not enter.
;
; witnessed: 2026-08-14 -> activation band 67108863 on four execution arms
import "form-neutral-language-world-model.fk"

(do
  ; ── observed frequency cells ─────────────────────────────────────
  (defn fnwma-frequency-claim-observed () 2)
  (defn fnwma-max-frequency-total () 1000000)
  (defn fnwma-frequency (mapping corpus hits total evidence)
    (intern_node (cfd-cat-frequency)
      (list mapping corpus
        (intern_trivial_int hits)
        (intern_trivial_int total)
        evidence
        (intern_trivial_int (fnwma-frequency-claim-observed)))))
  (defn fnwma-f-mapping (frequency)
    (nth (node_children frequency) 0))
  (defn fnwma-f-corpus (frequency)
    (nth (node_children frequency) 1))
  (defn fnwma-f-hits (frequency)
    (node_value (nth (node_children frequency) 2)))
  (defn fnwma-f-total (frequency)
    (node_value (nth (node_children frequency) 3)))
  (defn fnwma-f-evidence (frequency)
    (nth (node_children frequency) 4))
  (defn fnwma-f-claim (frequency)
    (node_value (nth (node_children frequency) 5)))
  (defn fnwma-mapping-ordinal (mapping)
    (cfd-occ-line (cfd-prov-occurrence (cfd-map-provenance mapping))))
  (defn fnwma-frequency-valid? (frequency)
    (if (not (node_eq (node_category frequency) (cfd-cat-frequency))) 0
    (if (not (eq (len (node_children frequency)) 6)) 0
      (if (and (eq (fnwm-mapping-valid? (fnwma-f-mapping frequency)) 1)
          (and (eq (fnwm-corpus-valid? (fnwma-f-corpus frequency)) 1)
          (and (eq (fnwm-trivial-int?
                     (nth (node_children frequency) 2)) 1)
          (and (eq (fnwm-trivial-int?
                     (nth (node_children frequency) 3)) 1)
          (and (eq (fnwm-indexed-valid? (fnwma-f-evidence frequency)
                     (cfd-cat-evidence)) 1)
          (and (eq (fnwm-trivial-int?
                     (nth (node_children frequency) 5)) 1)
          (and (ge (fnwma-f-hits frequency) 0)
          (and (gt (fnwma-f-total frequency) 0)
          (and (le (fnwma-f-hits frequency) (fnwma-f-total frequency))
          (and (le (fnwma-f-total frequency) (fnwma-max-frequency-total))
               (eq (fnwma-f-claim frequency)
                   (fnwma-frequency-claim-observed)))))))))))) 1 0))))

  (defn fnwma-frequency-mapping-member? (mapping frequencies)
    (if (eq (len frequencies) 0) 0
      (if (node_eq mapping (fnwma-f-mapping (head frequencies))) 1
        (fnwma-frequency-mapping-member? mapping (tail frequencies)))))
  (defn fnwma-frequency-ordinal-member? (ordinal frequencies)
    (if (eq (len frequencies) 0) 0
      (if (eq ordinal
              (fnwma-mapping-ordinal (fnwma-f-mapping (head frequencies)))) 1
        (fnwma-frequency-ordinal-member? ordinal (tail frequencies)))))
  (defn fnwma-frequency-set-valid-loop? (graph remaining seen)
    (if (eq (len remaining) 0) 1
      (do
        (let frequency (head remaining))
        (if (eq (fnwma-frequency-valid? frequency) 0) 0
          (do
            (let mapping (fnwma-f-mapping frequency))
            (let ordinal (fnwma-mapping-ordinal mapping))
            (if (or (eq (fnwm-member? mapping (fnwm-mappings graph)) 0)
                (or (eq (fnwma-frequency-mapping-member? mapping seen) 1)
                    (eq (fnwma-frequency-ordinal-member? ordinal seen) 1))) 0
              (fnwma-frequency-set-valid-loop? graph (tail remaining)
                (cons frequency seen))))))))
  (defn fnwma-frequency-set-valid? (graph frequencies)
    (if (or (nothing? graph)
            (not (node_eq (node_category graph) (fnwm-cat-graph)))) 0
      (fnwma-frequency-set-valid-loop? graph frequencies (list))))

  ; Exact rational comparison avoids bucketed score collisions. A tie is
  ; ordered by the occurrence ordinal already bound into mapping provenance.
  (defn fnwma-frequency-before? (left right)
    (do
      (let lscaled (mul (fnwma-f-hits left) (fnwma-f-total right)))
      (let rscaled (mul (fnwma-f-hits right) (fnwma-f-total left)))
      (if (gt lscaled rscaled) 1
        (if (lt lscaled rscaled) 0
          (if (lt (fnwma-mapping-ordinal (fnwma-f-mapping left))
                  (fnwma-mapping-ordinal (fnwma-f-mapping right))) 1 0)))))
  (defn fnwma-frequency-insert (frequency ranked)
    (if (eq (len ranked) 0) (list frequency)
      (if (eq (fnwma-frequency-before? frequency (head ranked)) 1)
        (cons frequency ranked)
        (cons (head ranked)
          (fnwma-frequency-insert frequency (tail ranked))))))
  (defn fnwma-frequency-rank-loop (frequencies ranked)
    (if (eq (len frequencies) 0) ranked
      (fnwma-frequency-rank-loop (tail frequencies)
        (fnwma-frequency-insert (head frequencies) ranked))))
  (defn fnwma-frequency-rank (frequencies)
    (fnwma-frequency-rank-loop frequencies (list)))
  (defn fnwma-context-frequencies (frequencies context)
    (if (eq (len frequencies) 0) (list)
      (if (node_eq
            (cfd-map-context (fnwma-f-mapping (head frequencies))) context)
        (cons (head frequencies)
          (fnwma-context-frequencies (tail frequencies) context))
        (fnwma-context-frequencies (tail frequencies) context))))
  (defn fnwma-take (items count)
    (if (or (le count 0) (eq (len items) 0)) (list)
      (cons (head items) (fnwma-take (tail items) (sub count 1)))))
  (defn fnwma-frequency-mappings (frequencies)
    (if (eq (len frequencies) 0) (list)
      (cons (fnwma-f-mapping (head frequencies))
        (fnwma-frequency-mappings (tail frequencies)))))

  ; ── context-sized shard activation ───────────────────────────────
  (defn fnwma-anchor-symbols (mappings)
    (if (eq (len mappings) 0) (list)
      (fnwm-append-unique (fnwma-anchor-symbols (tail mappings))
        (fnwm-anchor-symbol (cfd-map-meaning (head mappings))))))
  (defn fnwma-relations-for-anchors (relations anchors)
    (if (eq (len relations) 0) (list)
      (if (eq (fnwm-member? (fnwm-rel-from (head relations)) anchors) 1)
        (cons (head relations)
          (fnwma-relations-for-anchors (tail relations) anchors))
        (fnwma-relations-for-anchors (tail relations) anchors))))
  (defn fnwma-target-symbols (relations)
    (if (eq (len relations) 0) (list)
      (fnwm-append-unique (fnwma-target-symbols (tail relations))
        (fnwm-rel-to (head relations)))))
  (defn fnwma-shard-from-mappings (graph mappings)
    (if (eq (len mappings) 0) (nothing)
      (do
        (let anchors (fnwma-anchor-symbols mappings))
        (let relations
          (fnwma-relations-for-anchors (fnwm-relations graph) anchors))
        (let symbols (append anchors (fnwma-target-symbols relations)))
        (let elements (append symbols (append relations mappings)))
        (let exact-budget (fnwm-elements-envelope-bytes elements))
        (fnwm-graph exact-budget elements))))

  ; ── activation and local-only selection offer ────────────────────
  (defn fnwma-cat-activation () (make_nodeid 31 2 0 26))
  (defn fnwma-cat-local-offer () (make_nodeid 31 2 0 27))
  (defn fnwma-cat-local-selection () (make_nodeid 31 2 0 28))
  (defn fnwma-cat-local-meaning () (make_nodeid 31 2 0 29))
  (defn fnwma-cat-activation-successor () (make_nodeid 31 2 0 30))
  (defn fnwma-direction-forward () 1)
  (defn fnwma-direction-reverse () 2)
  (defn fnwma-direction-both () 3)
  (defn fnwma-interface-form-cli () 1)
  (defn fnwma-tier-local () 1)
  (defn fnwma-tier-remote () 2)
  (defn fnwma-claim-candidate () 1)
  (defn fnwma-direction-valid? (direction)
    (if (or (eq direction (fnwma-direction-forward))
        (or (eq direction (fnwma-direction-reverse))
            (eq direction (fnwma-direction-both)))) 1 0))
  (defn fnwma-context-offered? (context)
    (if (and (eq (fnwm-context-valid? context) 1)
             (not (node_eq context (cfd-context-any)))) 1 0))
  (defn fnwma-activation-context (activation)
    (nth (node_children activation) 0))
  (defn fnwma-activation-shard (activation)
    (nth (node_children activation) 1))
  (defn fnwma-activation-direction (activation)
    (node_value (nth (node_children activation) 2)))
  (defn fnwma-activation-limit (activation)
    (node_value (nth (node_children activation) 3)))
  (defn fnwma-activation-frequencies (activation)
    (tail (tail (tail (tail (node_children activation))))))
  (defn fnwma-frequency-order-valid? (frequencies)
    (if (le (len frequencies) 1) 1
      (if (eq (fnwma-frequency-before?
                (head frequencies) (head (tail frequencies))) 1)
        (fnwma-frequency-order-valid? (tail frequencies)) 0)))
  (defn fnwma-frequency-mappings-contained? (frequencies mappings)
    (if (eq (len frequencies) 0) 1
      (if (eq (fnwm-member? (fnwma-f-mapping (head frequencies))
                mappings) 1)
        (fnwma-frequency-mappings-contained? (tail frequencies) mappings) 0)))
  (defn fnwma-frequency-mappings-match? (frequencies mappings)
    (if (not (eq (len frequencies) (len mappings))) 0
      (fnwma-frequency-mappings-contained? frequencies mappings)))
  (defn fnwma-all-frequency-context? (frequencies context)
    (if (eq (len frequencies) 0) 1
      (if (node_eq
            (cfd-map-context (fnwma-f-mapping (head frequencies))) context)
        (fnwma-all-frequency-context? (tail frequencies) context) 0)))
  (defn fnwma-tight-shard-valid? (shard)
    (if (or (nothing? shard)
        (or (not (node_eq (node_category shard) (fnwm-cat-graph)))
            (lt (len (node_children shard)) 2))) 0
      (if (and (eq (fnwm-trivial-int? (nth (node_children shard) 0)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children shard) 1)) 1)
          (and (eq (fnwm-elements-valid? (fnwm-graph-elements shard)) 1)
          (and (eq (fnwm-elements-linked? (fnwm-graph-elements shard)
                     (fnwm-graph-elements shard)) 1)
          (and (eq (fnwm-graph-size-honest? shard) 1)
          (and (eq (fnwm-graph-budget shard) (fnwm-graph-size shard))
               (eq (fnwm-smaller-than-active-llm? shard) 1))))))) 1 0)))
  (defn fnwma-activation-valid? (activation)
    (if (not (node_eq (node_category activation) (fnwma-cat-activation))) 0
    (if (lt (len (node_children activation)) 5) 0
      (do
        (let context (fnwma-activation-context activation))
        (let shard (fnwma-activation-shard activation))
        (let direction-node (nth (node_children activation) 2))
        (let limit-node (nth (node_children activation) 3))
        (let frequencies (fnwma-activation-frequencies activation))
        (if (and (eq (fnwma-context-offered? context) 1)
            (and (eq (fnwma-tight-shard-valid? shard) 1)
            (and (eq (fnwm-trivial-int? direction-node) 1)
            (and (eq (fnwm-trivial-int? limit-node) 1)
            (and (eq (fnwma-direction-valid? (node_value direction-node)) 1)
            (and (gt (node_value limit-node) 0)
            (and (gt (len frequencies) 0)
            (and (le (len frequencies) (node_value limit-node))
            (and (eq (fnwma-frequency-set-valid? shard frequencies) 1)
            (and (eq (fnwma-frequency-order-valid? frequencies) 1)
            (and (eq (fnwma-all-frequency-context? frequencies context) 1)
            (and (eq (fnwma-frequency-mappings-match? frequencies
                       (fnwm-mappings shard)) 1)
                 (le (fnwm-node-envelope-bytes activation
                       (fnwm-envelope-walk-fuel))
                     (fnwm-active-budget-bytes)))))))))))))) 1 0)))))

  (defn fnwma-activate (graph context frequencies limit direction)
    (if (or (eq (fnwma-context-offered? context) 0)
        (or (le limit 0)
        (or (eq (fnwma-direction-valid? direction) 0)
            (eq (fnwma-frequency-set-valid? graph frequencies) 0))))
      (nothing)
      (do
        (let ranked (fnwma-take
          (fnwma-frequency-rank
            (fnwma-context-frequencies frequencies context)) limit))
        (let shard (fnwma-shard-from-mappings graph
          (fnwma-frequency-mappings ranked)))
        (if (nothing? shard) (nothing)
          (do
            (let activation (intern_node (fnwma-cat-activation)
              (cons context
                (cons shard
                  (cons (intern_trivial_int direction)
                    (cons (intern_trivial_int limit) ranked))))))
            (if (eq (fnwma-activation-valid? activation) 1)
              activation (nothing)))))))

  ; The interface number is projected by the host as `form-cli`; it is not a
  ; natural-language meaning cell. Tier 1 is local. There is intentionally no
  ; remote-offer constructor.
  (defn fnwma-local-offer (activation)
    (if (eq (fnwma-activation-valid? activation) 0) (nothing)
      (intern_node (fnwma-cat-local-offer)
        (list activation
          (intern_trivial_int (fnwma-interface-form-cli))
          (intern_trivial_int (fnwma-tier-local))
          (intern_trivial_int (fnwma-claim-candidate))))))
  (defn fnwma-offer-activation (offer) (nth (node_children offer) 0))
  (defn fnwma-offer-interface (offer)
    (node_value (nth (node_children offer) 1)))
  (defn fnwma-offer-tier (offer)
    (node_value (nth (node_children offer) 2)))
  (defn fnwma-offer-claim (offer)
    (node_value (nth (node_children offer) 3)))
  (defn fnwma-local-offer-valid? (offer)
    (if (not (node_eq (node_category offer) (fnwma-cat-local-offer))) 0
    (if (not (eq (len (node_children offer)) 4)) 0
      (if (and (eq (fnwma-activation-valid?
                     (fnwma-offer-activation offer)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children offer) 1)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children offer) 2)) 1)
          (and (eq (fnwm-trivial-int? (nth (node_children offer) 3)) 1)
          (and (eq (fnwma-offer-interface offer)
                   (fnwma-interface-form-cli))
          (and (eq (fnwma-offer-tier offer) (fnwma-tier-local))
               (eq (fnwma-offer-claim offer)
                   (fnwma-claim-candidate)))))))) 1 0))))

  ; A model selection points to one existing mapping and carries only a score,
  ; evidence index, and candidate claim. It does not mutate the shard.
  (defn fnwma-local-selection (offer mapping score evidence)
    (if (or (eq (fnwma-local-offer-valid? offer) 0)
        (or (lt score 0) (gt score 100))) (nothing)
      (do
        (let shard (fnwma-activation-shard
          (fnwma-offer-activation offer)))
        (if (eq (fnwm-member? mapping (fnwm-mappings shard)) 0) (nothing)
          (intern_node (fnwma-cat-local-selection)
            (list offer mapping
              (intern_trivial_int score) evidence
              (intern_trivial_int (fnwma-claim-candidate))))))))
  (defn fnwma-selection-offer (selection)
    (nth (node_children selection) 0))
  (defn fnwma-selection-mapping (selection)
    (nth (node_children selection) 1))
  (defn fnwma-selection-score (selection)
    (node_value (nth (node_children selection) 2)))
  (defn fnwma-selection-evidence (selection)
    (nth (node_children selection) 3))
  (defn fnwma-selection-claim (selection)
    (node_value (nth (node_children selection) 4)))
  (defn fnwma-local-selection-valid? (selection)
    (if (not (node_eq (node_category selection)
                      (fnwma-cat-local-selection))) 0
    (if (not (eq (len (node_children selection)) 5)) 0
      (do
        (let offer (fnwma-selection-offer selection))
        (if (eq (fnwma-local-offer-valid? offer) 0) 0
          (do
            (let shard (fnwma-activation-shard
              (fnwma-offer-activation offer)))
            (if (and (eq (fnwm-mapping-valid?
                           (fnwma-selection-mapping selection)) 1)
                (and (eq (fnwm-member? (fnwma-selection-mapping selection)
                           (fnwm-mappings shard)) 1)
                (and (eq (fnwm-trivial-int?
                           (nth (node_children selection) 2)) 1)
                (and (eq (fnwm-indexed-valid?
                           (fnwma-selection-evidence selection)
                           (cfd-cat-evidence)) 1)
                (and (eq (fnwm-trivial-int?
                           (nth (node_children selection) 4)) 1)
                (and (ge (fnwma-selection-score selection) 0)
                (and (le (fnwma-selection-score selection) 100)
                     (eq (fnwma-selection-claim selection)
                         (fnwma-claim-candidate))))))))) 1 0)))))))
  (defn fnwma-selection-anchor (selection)
    (if (eq (fnwma-local-selection-valid? selection) 0) (nothing)
      (cfd-map-meaning (fnwma-selection-mapping selection))))
  ; Claim state 3 remains participant-bound and is not offered by this bridge.
  ; The selection is real; only a shared observation of its mapping is absent.
  (defn fnwma-selection-shared-observed? (selection) 0)

  ; Meaning generation is alive here. The selected mapping supplies a grounded
  ; context anchor; the local model supplies a numeric recipe built from the
  ; same form-neutral dictionary cells. Content addressing gives the recipe its
  ; own symbol immediately. The relation is additive and claim-1: it cannot
  ; erase the shard's existing candidate alignment, and shared observation
  ; remains participant-bound. Changed evidence is free to create a
  ; successor overlay; continuity is addressability, not stasis.
  (defn fnwma-local-meaning (selection recipe residue evidence)
    (if (or (eq (fnwma-local-selection-valid? selection) 0)
        (or (eq (fnwm-recipe-valid? recipe (fnwm-envelope-walk-fuel)) 0)
        (or (le residue 0)
            (eq (fnwm-indexed-valid? evidence (cfd-cat-evidence)) 0))))
      (nothing)
      (do
        (let anchor-symbol
          (fnwm-anchor-symbol (fnwma-selection-anchor selection)))
        (let recipe-symbol (fnwm-recipe-symbol recipe))
        (let relation (fnwm-relation anchor-symbol
          (fnwm-relation-candidate-alignment) recipe-symbol residue
          (fnwma-claim-candidate)))
        (intern_node (fnwma-cat-local-meaning)
          (list selection recipe-symbol relation
            (intern_trivial_int residue) evidence
            (intern_trivial_int (fnwma-claim-candidate)))))))
  (defn fnwma-meaning-selection (meaning)
    (nth (node_children meaning) 0))
  (defn fnwma-meaning-symbol (meaning)
    (nth (node_children meaning) 1))
  (defn fnwma-meaning-relation (meaning)
    (nth (node_children meaning) 2))
  (defn fnwma-meaning-residue (meaning)
    (node_value (nth (node_children meaning) 3)))
  (defn fnwma-meaning-evidence (meaning)
    (nth (node_children meaning) 4))
  (defn fnwma-meaning-claim (meaning)
    (node_value (nth (node_children meaning) 5)))
  (defn fnwma-local-meaning-valid? (meaning)
    (if (not (node_eq (node_category meaning)
                      (fnwma-cat-local-meaning))) 0
    (if (not (eq (len (node_children meaning)) 6)) 0
      (do
        (let selection (fnwma-meaning-selection meaning))
        (if (eq (fnwma-local-selection-valid? selection) 0) 0
          (do
            (let symbol (fnwma-meaning-symbol meaning))
            (let relation (fnwma-meaning-relation meaning))
            (let expected (fnwm-relation
              (fnwm-anchor-symbol (fnwma-selection-anchor selection))
              (fnwm-relation-candidate-alignment) symbol
              (fnwma-meaning-residue meaning) (fnwma-claim-candidate)))
            (if (and (eq (fnwm-symbol-valid? symbol) 1)
                (and (eq (fnwm-symbol-kind symbol) (fnwm-kind-recipe))
                (and (eq (fnwm-relation-valid? relation) 1)
                (and (node_eq relation expected)
                (and (eq (fnwm-trivial-int?
                           (nth (node_children meaning) 3)) 1)
                (and (gt (fnwma-meaning-residue meaning) 0)
                (and (eq (fnwm-indexed-valid?
                           (fnwma-meaning-evidence meaning)
                           (cfd-cat-evidence)) 1)
                (and (eq (fnwm-trivial-int?
                           (nth (node_children meaning) 5)) 1)
                     (eq (fnwma-meaning-claim meaning)
                         (fnwma-claim-candidate)))))))))) 1 0)))))))

  (defn fnwma-local-meaning-overlay (meaning)
    (if (eq (fnwma-local-meaning-valid? meaning) 0) (nothing)
      (do
        (let shard (fnwma-activation-shard
          (fnwma-offer-activation
            (fnwma-selection-offer
              (fnwma-meaning-selection meaning)))))
        (let with-symbol (fnwm-append-unique (fnwm-graph-elements shard)
          (fnwma-meaning-symbol meaning)))
        (let elements (fnwm-append-unique with-symbol
          (fnwma-meaning-relation meaning)))
        (fnwm-graph (fnwm-elements-envelope-bytes elements) elements))))
  ; The meaning exists. What remains unobserved is only its shared mapping.
  (defn fnwma-meaning-shared-observed? (meaning) 0)

  ; Growth is a directed relation between two complete activations. The prior
  ; cell remains addressable; the successor must retain every earlier mapping,
  ; add at least one mapping under the same context/direction, and carry new
  ; observed evidence. This is continuity with expansion, not byte identity.
  (defn fnwma-mappings-contained? (earlier later)
    (if (eq (len earlier) 0) 1
      (if (eq (fnwm-member? (head earlier) later) 1)
        (fnwma-mappings-contained? (tail earlier) later) 0)))
  (defn fnwma-activation-grows? (earlier later)
    (if (and (eq (fnwma-activation-valid? earlier) 1)
        (and (eq (fnwma-activation-valid? later) 1)
        (and (node_eq (fnwma-activation-context earlier)
                      (fnwma-activation-context later))
        (and (eq (fnwma-activation-direction earlier)
                 (fnwma-activation-direction later))
        (and (lt (len (fnwm-mappings (fnwma-activation-shard earlier)))
                 (len (fnwm-mappings (fnwma-activation-shard later))))
             (eq (fnwma-mappings-contained?
                   (fnwm-mappings (fnwma-activation-shard earlier))
                   (fnwm-mappings (fnwma-activation-shard later))) 1)))))) 1 0))
  (defn fnwma-activation-successor (earlier later evidence)
    (if (or (eq (fnwma-activation-grows? earlier later) 0)
            (eq (fnwm-indexed-valid? evidence (cfd-cat-evidence)) 0))
      (nothing)
      (intern_node (fnwma-cat-activation-successor)
        (list earlier later evidence
          (intern_trivial_int (fnwma-frequency-claim-observed))))))
  (defn fnwma-successor-earlier (successor)
    (nth (node_children successor) 0))
  (defn fnwma-successor-later (successor)
    (nth (node_children successor) 1))
  (defn fnwma-successor-evidence (successor)
    (nth (node_children successor) 2))
  (defn fnwma-successor-claim (successor)
    (node_value (nth (node_children successor) 3)))
  (defn fnwma-activation-successor-valid? (successor)
    (if (not (node_eq (node_category successor)
                      (fnwma-cat-activation-successor))) 0
    (if (not (eq (len (node_children successor)) 4)) 0
      (if (and (eq (fnwma-activation-grows?
                     (fnwma-successor-earlier successor)
                     (fnwma-successor-later successor)) 1)
          (and (eq (fnwm-indexed-valid?
                     (fnwma-successor-evidence successor)
                     (cfd-cat-evidence)) 1)
          (and (eq (fnwm-trivial-int?
                     (nth (node_children successor) 3)) 1)
               (eq (fnwma-successor-claim successor)
                   (fnwma-frequency-claim-observed))))) 1 0))))

  0)
