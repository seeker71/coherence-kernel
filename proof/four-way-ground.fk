; four-way-ground.fk — source-native executable proof entry.
; The host shell launches only fkwu. This Form cell owns all four invocations,
; value parsing, comparison, and adjudication through the host-exec port.
;
; import "../form/form-stdlib/core.fk"
; import "../form/form-stdlib/four-way-verdict.fk"
; import "../form/form-stdlib/four-way-run.fk"

(fr-diagnose-cmds
    "form/form-kernel-go/bin-go bootstrap/ground.fk"
    "form/form-kernel-rust/target/release/form-kernel-rust bootstrap/ground.fk"
    "node --stack_size=262144 form/form-kernel-ts/dist/main.mjs bootstrap/ground.fk"
    "./fkwu --src bootstrap/ground.fk")
