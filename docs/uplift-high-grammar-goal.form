; uplift-high-grammar-goal.form — the goal + exit proof for raising the body from raw-primitive
; recipes to HIGH-GRAMMAR semantic abstraction (BML class-hierarchy / template / generic /
; attribute), behavior-preserving and measured. Companion to re-architecture-stones.form —
; those stones BUILD the constructs; this goal LIFTS the body into them. The daily lens is
; observe/authoring-altitude-run.fk (AGENTS.md: new meaning is authored in BML or higher).

(uplift-high-grammar-goal

  ; ── GROUND ──
  (ground
    (definition    "HIGH-GRAMMAR = altitude of abstraction (class hierarchy, template, generic, attribute —
                    the BML / Field-Model grammar: grammars/bmf-core.fk + grammars/field-domain-grammars.form),
                    NOT .fk-vs-.c file language. A .fk written in raw primitives is LOW-grammar.")
    (measure-PINNED "git ls-tree -r --name-only <REF> | grep '\.fk$' | grep -vE 'walkers/|/tests/' → the file set;
                     of those, the ones matching grep -iE the construct set below = high-grammar; count/total = share.
                     PIN TO A COMMITTED REF (git ls-tree <REF>), NEVER git ls-files — the working tree is a live-runner
                     checkout that mutates every minute. Constructs: class|inherit|template|generic|attribute|
                     interface|blueprint|grammar-rule|domain-grammar|extends|trait|ontology|schema|field-domain.")
    (reading       "1114/2894 = 38.5% @ 2a2c5bfb (re-measured 2026-09-03 by the pinned command).")
    (truer-measure "recipe-COUNT share under-reads the win: an uplift that KEEPS the low-grammar original (for
                    byte-identity delegation) adds a high-grammar cell without removing a low one, so the
                    share barely moves. Record ALSO the retired/collapsed low-grammar LINE-count — the real benefit.")
    (proof-of-shape "form-eval's value-op dispatch is ONE table-as-DATA (fef-optable, rows of (name tag arity)) —
                     adding an op is a row, not a hand-written if-branch. That is the pattern."))

  ; ── WHAT STANDS (the constructs exist; each names its cell) ──
  (stands
    (B1 "observe/ sensing family"  "observe/sensor-organ-template.fk is the high-grammar BASE: so-organ declares
         attributes, so-port/so-route INHERIT world-sensor-floor, so-observe fuses with the supplied FUSION-FN;
         scene-features / motion-sense / same-room ride as thin organs delegating to the proven originals")
    (B2 "tensor emit"  "form/form-stdlib/jit-tensor-emit.fk emits matvec + affine-train THROUGH the data-driven
         form/form-stdlib/tensor-ir.fk (ISA-as-DATA); tir-emit-* carry ZERO per-ISA ifs")
    (B3 "transcendental fragment + FFN-forward"  "exp/tanh/gelu live once as a shared IR spine fragment; the FFN-forward
         block kernel emits through the IR from it"))

  ; ── THE NAMED WALLS (honest stops; each is a stone in re-architecture-stones.form) ──
  (walls
    (closure-on-a-cell "the FULL sensing form (one (sensor-roster) DATA table, field-domain-grammar shape) needs a
         STORED function-value attribute in the organ's data row — ((nth o 4) x) answers [unresolved-call] rc 1
         on fkwu (re-observed 2026-09-03) while a fn passed as a direct arg resolves. Stone S2c. Until it lands,
         FEATURE-FN/FUSION-FN ride as direct function-value ARGS; promotion into the row is a one-line edit.
         This wall is the top unblock — it gates the full B1 form AND the data-table parsers of B3/B5.")
    (ir-fragments "still hand-authored, not faked through the IR: the FFN/resid/attn TRAINING kernels (backprop
         spines), the LayerNorm/RMSNorm Newton-sqrt fragment, the softmax (max-subtract) fragment, the RoPE
         rotate fragment, and every kernel that composes them (transformer block fwd, llama/gqa block fwd +
         causal + decode). Each is a named next fragment to realize, then route the kernels that compose it."))

  ; ── THE BENEFIT-RANKED BACKLOG STILL OPEN (size × repeated-structure × low-grammar) ──
  (backlog
    (B3-rest "the remaining IR fragments above")
    (B4 "form/form-stdlib/form-cli-gguf-cell.fk"  "hand-coded defns parsing a structured format"
        "-> a schema/grammar-driven parser (the GGUF format as DATA)")
    (B5 "substrate/form-fs.fk"                    "filesystem CRUD"          "-> the resource-port abstraction")
    (B6 "form/form-stdlib/line-grammar.fk + learn/ family" "patterns"                "-> their domain grammars"))

  ; ── INVARIANTS (every uplift holds ALL — else it is not an uplift) ──
  (invariants
    (construct-grounded "uplifts into a high-grammar construct that EXISTS and is proven (fkwu + four-way where it
                         applies); if the construct is absent, BUILD+prove it first — never fake an uplift in raw Form")
    (behavior-identical "the uplifted recipe's fkwu result == the original's, verdict/byte-identical (the HARD GATE);
                         a changed result is a FAILED uplift, never shipped")
    (grammar-lifted     "the recipe now USES the semantic construct (verifiable by the high-grammar measure),
                         not re-inlined primitives under a nicer name")
    (reduced            "lines/defns after < before (measured), OR N recipes collapse into 1 template + N thin declarations")
    (receipted          "each uplift lands a receipt: before->after lines, the identical-verdict proof, the construct used"))

  ; ── EXIT PROOF (STOP when ALL hold; each checkable from origin/main, no human judgment) ──
  (exit-proof
    (E1 "CONSTRUCTS PROVEN" "BML expresses class-hierarchy + template + attribute, each with a fkwu/four-way receipt in
                             receipts/; where a construct cannot be built, E1 is met by a named-wall receipt deriving
                             the minimal construct from an axiom")
    (E2 "BACKLOG DONE"      "every backlog recipe is EITHER uplifted-with-passing-receipt OR carries a NAMED-WALL
                             receipt stating exactly which abstraction BML cannot yet express (honest stop, not a skip)")
    (E3 "SHARE RECORDED"    "the high-grammar share + retired-low-grammar line-count, measured by the pinned command
                             BEFORE & AFTER, improvement recorded — the recorded number is the proof, not a threshold to game")
    (E4 "NO REGRESSION"     "the four-way floor still passes (./fkwu proof/four-way-run-recipe42.fk -> 0) and the
                             ground quartet stands; nothing the uplift touched broke")
    (E5 "SELF-CONSISTENT"   "this cell and observe/authoring-altitude-run.fk read the same altitude — no drift"))

  ; ── HONEST FLOOR ──
  (honest-floor "a precise NAMED WALL ('BML cannot yet express generic-over-attribute; here is the minimal construct it
                 would need, derived from axiom-N') IS a valid exit for that recipe. Pending is honest; a fake uplift is
                 not. The goal stops at the proof or the wall — never at a vibe."))
