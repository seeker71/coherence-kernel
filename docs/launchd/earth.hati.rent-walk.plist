<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The night walk, 03:30. launchd spawns launch/fkwu on launch/walk-launch.fk, the pair only observe/walk-launch-pin.bml
       writes; the launcher begins the walk door as its child with the job's stdin, stdout and stderr, and ends as it ended.
       The walk rebuilds ./fkwu and follows main's observe/walk-launch.fk, and neither reaches launch/ without a pin, so a
       rebuilt kernel never meets launchd's requirement for this job and a moved door never fails it at launch
       (docs/launchd/README.md). -->
  <key>Label</key><string>earth.hati.rent-walk</string>
  <key>ProgramArguments</key><array>
    <string>/Users/ursmuff/source/coherence-kernel-walk/launch/fkwu</string>
    <string>/Users/ursmuff/source/coherence-kernel-walk/launch/walk-launch.fk</string>
    <string>observe/scheduled-walk.bml</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ursmuff/source/coherence-kernel-walk</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.log</string>
  <key>StandardErrorPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/rent-walk.err.log</string>
</dict></plist>
