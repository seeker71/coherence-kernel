<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The second slots of the day turns (earth.hati.day-turn, 12:30 and 19:00), ten minutes later. observe/walk-retry.bml reads
       whether the first slot began (.hearth/walk.began): if it did the door ends there. If it did not, it reads why (launchctl,
       the OS diagnostic reports, the log) and begins the day-turn door as its own child by a route changed for that class, at
       most twice, and keeps the evidence in .hearth/walk-retry.jsonl. A first start that began is never begun twice. -->
  <key>Label</key><string>earth.hati.day-turn-retry</string>
  <key>ProgramArguments</key><array>
    <string>/Users/ursmuff/source/coherence-kernel-walk/fkwu</string>
    <string>observe/walk-retry.bml</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ursmuff/source/coherence-kernel-walk</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/day-turn-retry.log</string>
  <key>StandardErrorPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/day-turn-retry.err.log</string>
</dict></plist>
