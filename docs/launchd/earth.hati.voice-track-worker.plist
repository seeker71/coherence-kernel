<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The voice-track worker, as a SERVICE the host's manager owns (docs/in-process-cells.md, "Services").
     It waits for a request (.hearth/voice-track/worker.request), renders that tongue under the machine-wide GPU lease, and gives its
     progress as a record in the shared field (form/form-stdlib/voice-track-record.bml). The body's supervisor (observe/voice-track-run.fk)
     reads that record and, when a working worker gives no beat for 150 s, ends it with host_signal; KeepAlive then starts the next one.
     The body never starts it and never runs launchctl. An operator loads it:
       launchctl bootstrap gui/$(id -u) docs/launchd/earth.hati.voice-track-worker.plist
       launchctl kickstart -k gui/$(id -u)/earth.hati.voice-track-worker       (restart it by hand)
       launchctl bootout gui/$(id -u)/earth.hati.voice-track-worker            (take it away)
     The paths below are this machine's checkout; copy the file and change them for another. -->
<plist version="1.0"><dict>
  <key>Label</key><string>earth.hati.voice-track-worker</string>
  <key>ProgramArguments</key><array>
    <string>./fkwu</string>
    <string>observe/voice-track-worker-run.fk</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ursmuff/source/coherence-kernel-walk</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/voice-track-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/voice-track-worker.err.log</string>
</dict></plist>
