<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- form-find, as a SERVICE the host's manager owns (docs/form-native-agent-tools.md, "form-find").
     It holds the checkout's source tree indexed in memory (files, definitions, import edges, band headers, trigram postings) and answers
     the agent wire through a spool directory: a client writes ask.<n>.json with a plain shell redirect, the service writes ans.<n>.json.
     The body never starts it and never runs launchctl. An operator loads it once:
       launchctl bootstrap gui/$(id -u) docs/launchd/earth.hati.form-find.plist
       launchctl kickstart -k gui/$(id -u)/earth.hati.form-find       (restart it by hand)
       launchctl bootout gui/$(id -u)/earth.hati.form-find            (take it away)
     The paths below are this machine's checkout and uid (501): copy the file and change WorkingDirectory and FORM_FIND_SPOOL for another.
     The spool is /tmp/form-find/<uid>, the path an agent's shell spells /tmp/form-find/$UID. -->
<plist version="1.0"><dict>
  <key>Label</key><string>earth.hati.form-find</string>
  <key>ProgramArguments</key><array>
    <string>./fkwu</string>
    <string>observe/form-find-run.fk</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ursmuff/source/coherence-kernel-walk</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FORM_FIND_SPOOL</key><string>/tmp/form-find/501</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/form-find.log</string>
  <key>StandardErrorPath</key><string>/Users/ursmuff/Library/Logs/CoherenceSense/form-find.err.log</string>
</dict></plist>
