# ─────────────────────────────────────────────────────────────────────
# tool-grammar.form — the abstract Language cell for invocable surfaces
# ─────────────────────────────────────────────────────────────────────
#
# Every tool — the body's own recipes, host programs, HTTP services,
# graph queries — is a Language cell with the same four-part shape as a
# file-format Language cell, with the two halves named to reflect the
# invocation direction:
#
#   file grammar:   parse_bytes(bytes) -> tree
#                   emit_bytes(tree) -> bytes
#
#   tool grammar:   call_pattern(args_tree) -> invocation
#                   response_pattern(invocation_result) -> result_tree
#
# Same shape; different direction. The lattice doesn't distinguish
# locality (internal vs external) or carrier (host process, http, kernel
# call); the protocols of `tool-channel.fk` name that.

# ─────────────────────────────────────────────────────────────────────
# Part 1 — the supporting shapes
# ─────────────────────────────────────────────────────────────────────

form modality_shape = {
    name:   ~Slug,
    domain: ~Slug,
};

# An invocation is what the carrier executes. Three sub-shapes for the
# three common carriers: a host process (`host:exec`), an HTTP request
# (`http:request`), and a call into the body (`kernel:call`).

form host_invocation_shape = {
    command:   ~String,
    argv:      ~List,             # [~String] — argv after command name
    env:       ~Object,           # {~Slug: ~String} — env vars to set
    stdin:     ?~String,          # null if no stdin
    cwd:       ?~PathRef,         # null = host cwd
    timeout:   ?~Float,           # seconds; null = host default
};

form http_invocation_shape = {
    method:   ~Slug,              # "GET" | "POST" | "PUT" | "DELETE" | "PATCH"
    url:      ~URLLit,
    headers:  ~Object,            # {~Slug: ~String}
    body:     ?~String,           # serialized payload (JSON, form-encoded, etc.)
    timeout:  ?~Float,
};

form kernel_invocation_shape = {
    unit:     ~PathRef,           # the Form unit that defines the operation
    callable: ~Slug,              # defn / operation name
    args:     ~List,              # positional args (~Form values)
};

# A response is what the carrier returns. Three sub-shapes mirror the
# invocation shapes; the response_pattern in the Language cell parses
# this into a Form object tree.

form host_response_shape = {
    stdout:      ~String,
    stderr:      ~String,
    exit_code:   ~Int,
    duration_ms: ~Int,
};

form http_response_shape = {
    status:      ~Int,
    headers:     ~Object,
    body:        ~String,
    duration_ms: ~Int,
};

form kernel_response_shape = {
    value:       ~Form,           # the operation's return value
    failure:     ?~Form,          # the observed failure, or null
    duration_ms: ~Int,
};

# ─────────────────────────────────────────────────────────────────────
# Part 2 — the tool Language cell
# ─────────────────────────────────────────────────────────────────────

form tool_grammar_shape = {
    modality:            modality_shape,   # name: "tool", domain: tool's category

    # Call-half: tree → invocation. Walks an args-tree (recipe shape)
    # and produces a (host|http|kernel)_invocation_shape.
    call_pattern:        ~Recipe,

    # Response-half: invocation-result → tree. Parses the carrier's
    # response into a Form object that downstream cells consume.
    response_pattern:    ~Recipe,

    # Which protocol the tool uses.
    carrier:             ~Slug,            # "host:exec" | "http:request" | "kernel:call"

    # Version of the tool's surface area. Bumped when the tool's CLI/API
    # changes shape (e.g. gh CLI 2.40 → 2.45 added new --json fields).
    # Cells consuming via NodeID see the version change as a Blueprint
    # NodeID shift.
    version:             ~String,

    # Optional cross-modal links — sibling tools that produce the same
    # result-tree shape. E.g. `gh pr view` and a substrate query of the
    # PR cell both yield a pull_request_shape tree.
    cross_modal_links:   ~List,            # [~CellRef]
};

# ─────────────────────────────────────────────────────────────────────
# Part 3 — the invoke recipe
# ─────────────────────────────────────────────────────────────────────
#
# Generic recipe a cell calls to invoke any tool. The native surface is
# two-step: first ask `tool-channel.fk` for a protocol plan with `tc-plan-tool`
# or `tc-plan-request`, then offer that plan through the named kernel/tool
# channel. The plan names the explicit protocol (`host:exec`, `host:file`,
# `http:request`, `kernel:call`, `kernel:route`, `stream:read`, `store:query`)
# and the boundary it crosses. `tc-which`, `tc-protocol-carries?`, and
# `tc-native-option?` make the catalog inspectable before any offer. No host
# access is ambient; host tools are visible protocols.

defn invoke(tool, args_tree) = do {
    let invocation = call(tool.call_pattern, args_tree);
    let plan       = tool_channel_plan(tool, args_tree);
    let raw_result = offer_tool_plan(plan, invocation);
    let parsed     = call(tool.response_pattern, raw_result);
    parsed
};

# `tool_channel_plan` is executable as `form/form-stdlib/tool-channel.fk`
# (`tool-channel-band` 255): cells and recipes discover protocols, providers,
# applets, catalog tools, and request carriers as Form data, then receive an
# invocation plan or `tool/no-plan` when a capability is missing.
# `form/form-stdlib/tool-channel-grammar.fk` (`tool-channel-grammar-band` 255)
# makes those concepts available to the language layer: protocol declarations,
# tool declarations, capability declarations, plan expressions, and offer
# expressions lower to the same rows. `offer_tool_plan` is the kernel boundary:
# it carries an explicit protocol plan across an offered channel, so every
# host, network and store access is a named protocol the body can see.

# ─────────────────────────────────────────────────────────────────────
# Part 4 — the witness pairing
# ─────────────────────────────────────────────────────────────────────
#
# Every invocation is observable. The invoke recipe publishes a witness
# trace of kind "tool_fired" alongside the strategy traces: what state the
# body was in when the tool fired, what came after. The body's lived record
# covers both strategy-firings and tool-firings under one observation layer.

defn invoke_witnessed(cell, tool, args_tree) = do {
    let before = sense_state(cell);
    let result = invoke(tool, args_tree);
    let after  = sense_state(cell);
    publish_tool_trace(cell, tool, args_tree, result, before, after);
    result
};

# `publish_tool_trace` is the sibling of the strategy trace. Its fields are
# (cell, tool, args, response, sense_before, sense_after). Same aggregation
# pattern; same efficacy-signature shape; same substrate Blueprint structural
# identity. The body that learns from strategy-firings can learn from
# tool-firings the same way.

# ─────────────────────────────────────────────────────────────────────
# Part 5 — what stands and what is open
# ─────────────────────────────────────────────────────────────────────
#
# GAP-T1: the executors behind the offered channel. `kernel:call` has one:
#         `form/form-stdlib/wire-rpc.fk` marshals (op, args) through CDR
#         bytes, dispatches a Form operation table and marshals the result
#         back (`wire-rpc-band` 15). The other protocols are planned by
#         `tool-channel.fk`; their effects run through the organs that own
#         them (the host-effect doors, the coding lane's Form-native tools)
#         rather than through `offer_tool_plan`. One executor per protocol
#         behind the offered channel is the open work.
#
# GAP-T2: `call(pattern, args)` is recipe application — walk the pattern's
#         recipe tree with the args bound.
#
# GAP-T3: `publish_tool_trace` is open: the tool_fired trace kind beside the
#         strategy traces.
#
# GAP-T4: Cross-carrier interoperability — a `gh pr view` host tool and a
#         substrate lookup that both produce a pull_request_shape tree should
#         typecheck as compatible. `cross_modal_links` names the
#         relationship; the compatibility check reads the output Blueprint.
#
# GAP-T5: Versioning — when a host tool adds a new output field, its grammar
#         bumps `version` and its response_pattern Blueprint shifts. Cells
#         consuming via the old NodeID still work (the old recipe is still
#         in the lattice); cells wanting the new field upgrade to the new
#         NodeID.

# ─────────────────────────────────────────────────────────────────────
# Part 6 — how it composes
# ─────────────────────────────────────────────────────────────────────
#
# Once tools are Language cells, composition becomes structural:
#
#   defn prs_touching_substrate_today(cell) = do {
#       # Tool 1: list today's PRs
#       let prs = invoke_witnessed(cell, @tool(gh_pr_list),
#                                  {limit: 50, state: "merged", since: "today"});
#       # Tool 2: for each PR, get its diff
#       let diffs = map(prs, fn(pr) ->
#           invoke_witnessed(cell, @tool(gh_pr_diff), {number: pr.number})
#       );
#       # Tool 3: annotate each file in each diff against the substrate
#       let annotations = flat_map(diffs, fn(d) ->
#           map(d.files, fn(f) ->
#               invoke_witnessed(cell, @tool(substrate_annotate),
#                                {path: f.path})
#           )
#       );
#       # Result: each cell touched, with structural context
#       annotations
#   };
#
# The composition is content-addressed; two cells writing the same query
# share Recipe NodeIDs by content-addressing. The body invokes the outside
# the same way it reads the inside.
