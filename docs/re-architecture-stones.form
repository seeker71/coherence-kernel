; re-architecture-stones.form — the gap-closing plan: every PL-primitive gap closed as an
; axiom-grounded, core-grounded, observable, on-metal-fkwu-native stone.
; Source audit: the offer/ack vision (core-axioms.form axiom-5) + the PL-completeness audit
; (first-class fns, native structures, numeric tower, pattern-match, TCO, laziness, types).
; A number beside a band is its ./fkwu verdict.

(re-architecture-stones

  ; ── THE FOUR INVARIANTS — every stone holds ALL of them, or it is not a stone ──
  (invariants
    (axiom-grounded   "the closure DERIVES from the five axioms — named, a theorem, not bolted on")
    (core-grounded    "built on the kernel core (reducer / value-system / data optable) — generic, ZERO special-cases")
    (observable       "the stone emits an offer/ack trace the observe organ reads — thought watching itself")
    (on-metal-native  "proven via ./fkwu on the cc-seed, with a REAL on-metal receipt;
                       Mac observed; RTX/Android/iPhone as the receipt sessions land — pending is honest"))

  ; ── STANDING (the eval-as-offer/ack spine and the data primitives) ──
  (S1   stands "offer/ack contract"        (axiom 5)
        (cell "control/offer-ack-core.fk") (band "control/tests/offer-ack-core-band.fk" 2097151)
        (proof "oac-kind over {nothing|0|1|node}; choice / lanes / cut / store / undo / timeout over real calls"))
  (S2a  stands "nothing first-class"        (axiom 1)
        (proof "(nothing? (nothing)) = 1, (eq (nothing) 0) = 0 — a data row, no C special-case;
                measuring nothing dies loud (str_len: nothing has no length)"))
  (S2b  stands "general call arity"         (axiom 5)
        (proof "multi-arg defn and packed calls run on the source door; sense bodies' logic runs"))
  (S3   stands "reducer = observable offer/ack machine" (axiom 5 + 4)
        (cell "grammars/form-eval.fk") (band "form/form-stdlib/tests/form-eval-band.fk" 42)
        (band "form/form-stdlib/tests/form-eval-full-band.fk" 635)
        (proof "the reduction is itself a recipe: source→value as the BMF cursor reads it; the value-op
                dispatch is one table (fef-optable: rows of (name tag arity)) — adding an op is a ROW"))
  (S8   stands "native indexed array + content-addressed map" (axiom 2 + 3)
        (cell "substrate/native-structures.fk") (band "substrate/tests/native-structures-band.fk" 1550602099)
        (derivation "array = indexed children (axiom-2); MAP = content-addressing IS the hash (axiom-3)")
        (floor "array get/set are O(i) over the cons list: no op the source door reaches binds an O(1)
                indexed slot; the recipe shape is unchanged when the carrier swaps. The kernel carries a
                string-keyed record (record_new / record_get / record_set / record_has / record_keys)
                beside this content-addressed pair map"))
  (S9   stands "numeric tower (bignum / rational / complex)"   (axiom 1 + 2)
        (cell "model/numeric-tower.fk") (band "model/tests/numeric-tower-band.fk" 127)
        (derivation "axiom-1 integers as base; bignum = composed digit-cells, rational/complex = pair-cells"))
  (S10  stands "pattern matching / destructuring" (axiom 3 + 5)
        (cell "control/pattern-match.fk") (band "control/tests/pattern-match-band.fk" 511)
        (proof "pm-match(cell, clauses-as-DATA) -> first fitting clause's result with holes bound to
                children, no fit -> (nothing); four-way over the pure-list cell surface"))
  (S13  stands "eval-level type / contract system" (axiom 4 + 3)
        (cell "substrate/cell-type.fk") (band "substrate/tests/cell-type-band.fk" 1013)
        (derivation "the interface a cell offers IS its type (axiom-4); Blueprint is the structural type
                     (axiom-3); type-checking = the boundary's trust decision; a mismatch acks nothing"))
  (S7   moving "one data-driven tensor IR (codegen)" (core-grounded "ISA as DATA")
        (cell "form/form-stdlib/tensor-ir.fk") (cell "form/form-stdlib/jit-tensor-emit.fk")
        (band "model/tests/tensor-ir-band.fk" 15) (band "model/tests/tensor-ir-affine-band.fk" 31)
        (band "model/tests/tensor-ir-ffn-fwd-band.fk" 7) (band "form/form-stdlib/tests/jit-tensor-emit-band.fk" 7)
        (stands "matvec, affine-train, the transcendental fragment (exp/tanh/gelu), and the FFN-forward
                 block emit through the IR; tir-emit-* carry zero per-ISA ifs")
        (wall "outside the one IR: the norm, softmax, RoPE, attention and training kernels the model
               lanes run are emitted by their own Form emitters (q38-msl, native-lora-train.bml), and
               gpu-lower.bml lowers a recipe's own nodes; one IR under all of them is the stone"))
  (S11  moving "guaranteed tail-call (TCO)"   (axiom 5 + 3)
        (derivation "a tail-offer REUSES the frame (axiom-5 run=offer); the old frame composts (axiom-3)")
        (stands "a self tail call runs in constant stack: a 10,000,000-deep count answers on fkwu")
        (gap   "mutual tail calls do not: even?/odd? 1,000,000 deep stops at the walker's stack wall
                ('eval too deep'), rc 1")
        (proof "deep mutual tail-recursion in CONSTANT stack"))

  ; ── OPEN — the value-system keystone ──
  (S2c  next   "closure on a cell"  (axiom 2 + 5)
        (stands "a function value pulled from a list is callable once it has a name: bound by let, or
                 passed as a parameter, (f x) resolves")
        (gap   "an inline computed call head does not: ((nth o 4) x) answers [unresolved-call] '' and the
                run exits rc 1 on fkwu")
        (derivation "a function IS a cell (axiom-2); axiom-5 already offers cells, so a fn-value is a cell-ref
                     value; a closure is a cell composing its captured environment-cells")
        (proof "the call head is a COMPUTED cell; a closure captures and reads its env;
                the sensing family's organ row then carries FEATURE-FN/FUSION-FN as data"))

  ; ── OPEN — the runtime engines ──
  (S4   queued "host ports as offered cells"  (axiom 4)
        (gap   "host effects are C op-tags in the seed's dispatch — no membrane a cell offers/refuses/observes")
        (proof "a host effect crosses an offered, refusable, observable interface — consent enforced IN the dispatch"))
  (S5   queued "content-address reachability/GC engine" (axiom 3)
        (gap   "compost/undo are host allocation, not kernel ops")
        (derivation "axiom-3: identity=present composition; nothing-referenced-is-overwritten; the-unreferenced-composts")
        (proof "a referenced old shape persists; the unreferenced composts (measured); undo = re-point old node-id"))
  (S6   queued "in-kernel offer scheduler + atomics"    (axiom 5 + 1)
        (gap   "async/timeout/many-offers fall to pthreads/host-exec")
        (derivation "axiom-5 offer-over-channel + axiom-1 timeout==nothing")
        (proof "many offers in flight; fair choice; cancel/timeout → nothing"))

  ; ── OPEN — control / eval depth ──
  (S12  queued "lazy values / generators"     (axiom 5)
        (derivation "a lazy value is an un-acked offer; forcing is the ack (axiom-5); builds on S6")
        (proof "a stream forced on demand, nothing-until-forced"))

  ; ── ORDER (dependency spine; S7 and the metal receipts run in PARALLEL) ──
  (order  S2c  S4 S5  S11  S6 S12))
