#!/bin/sh
set -u

SEMA_APP_MACOS=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SEMA_APP_ROOT=$(CDPATH= cd -- "$SEMA_APP_MACOS/../../.." && pwd)
SEMA_APP_URL="http://127.0.0.1:8765/"
SEMA_APP_KERNEL="$SEMA_APP_ROOT/runtime/bootstrap/fkwu-darwin-arm64"
SEMA_APP_ROOM="$SEMA_APP_ROOT/form/form-stdlib/session-app-room.fk"
SEMA_APP_HOME="$SEMA_APP_ROOT/.sema-sessions"
SEMA_APP_LOG="$SEMA_APP_HOME/sessions.log"

cd "$SEMA_APP_ROOT" || exit 1
/bin/mkdir -p "$SEMA_APP_HOME"

if /usr/bin/curl -fsS "$SEMA_APP_URL" 2>/dev/null | /usr/bin/grep -q "Sema · Sessions"; then
    /usr/bin/open "$SEMA_APP_URL"
    exit 0
fi

if [ ! -x "$SEMA_APP_KERNEL" ] || [ ! -f "$SEMA_APP_ROOM" ]; then
    /usr/bin/osascript -e 'display alert "Sessions could not open" message "This copy is incomplete. Please receive a fresh copy of Sema Sessions." as critical'
    exit 1
fi

"$SEMA_APP_KERNEL" "$SEMA_APP_ROOM" >>"$SEMA_APP_LOG" 2>&1 &
SEMA_APP_SERVER=$!
SEMA_APP_READY=0
SEMA_APP_TRIES=0

while [ "$SEMA_APP_TRIES" -lt 120 ]; do
    if /usr/bin/curl -fsS "$SEMA_APP_URL" 2>/dev/null | /usr/bin/grep -q "Sema · Sessions"; then
        SEMA_APP_READY=1
        break
    fi
    if ! /bin/kill -0 "$SEMA_APP_SERVER" 2>/dev/null; then
        break
    fi
    /bin/sleep 0.25
    SEMA_APP_TRIES=$((SEMA_APP_TRIES + 1))
done

if [ "$SEMA_APP_READY" -eq 1 ]; then
    /usr/bin/open "$SEMA_APP_URL"
    wait "$SEMA_APP_SERVER"
    exit $?
fi

/usr/bin/osascript -e 'display alert "Sessions stayed asleep" message "Your existing recordings and transcripts are untouched. Close Sessions and open it once more." as warning'
wait "$SEMA_APP_SERVER" 2>/dev/null
exit 1
