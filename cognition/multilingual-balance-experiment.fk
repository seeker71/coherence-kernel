; multilingual-balance-experiment.fk — execute and try to falsify the proposed
; healthy multilingual growth structure against a bulk-translation control.
;
; This is a controlled structural experiment, not evidence from a live multilingual
; corpus. One hundred rounds are generated and scored from explicit model dimensions. The healthy arm
; grows native-source grounding, provenance, temporal scope, seven-plane coverage,
; executable checks, reversible translation, and world events. The control grows
; translated volume while those dimensions stay flat. Success and pairwise rank
; correlation are derived from the rows, never stored as expected verdicts.
;
; The thought framebuffer observes the decision trace: source-inside-language,
; provenance, temporal scope, inquiry planes, execution, human witness, and
; freeze/hold/compost. A bulk-translation counterfactual gives the framebuffer a
; second trace, so divergence localizes where the reasoning changes.
;
; Honest boundary: fixture evidence can prove that the proposed metric structure is
; internally discriminating. It cannot prove that real language growth will achieve
; these rates. Live sourced rows and native-speaker judgments are the next witness.
; witnessed: 2026-07-20 -> 4095 four-way.
;
; preludes: form-stdlib/core.fk form-stdlib/thought-framebuffer.fk

(do
    ; row = strategy, round, translated-volume, native-source, provenance,
    ; temporal-scope, seven-plane coverage, executable checks, reversible
    ; translation, witnessed events. Every dimension is 0..100.
    (defn mbe-row (strategy round volume native provenance temporal planes executable reversible events)
        (list strategy round volume native provenance temporal planes executable reversible events))
    (defn mbe-round      (r) (nth r 1))
    (defn mbe-volume     (r) (nth r 2))
    (defn mbe-native     (r) (nth r 3))
    (defn mbe-provenance (r) (nth r 4))
    (defn mbe-temporal   (r) (nth r 5))
    (defn mbe-planes     (r) (nth r 6))
    (defn mbe-executable (r) (nth r 7))
    (defn mbe-reversible (r) (nth r 8))
    (defn mbe-events     (r) (nth r 9))

    (defn mbe-concept-score (r)
        (div (add (mbe-native r)
              (add (mbe-provenance r)
              (add (mbe-planes r)
              (add (mbe-executable r) (mbe-reversible r))))) 5))
    (defn mbe-world-score (r)
        (div (add (mbe-native r)
              (add (mbe-provenance r)
              (add (mbe-temporal r) (mbe-events r)))) 4))
    (defn mbe-quality (r) (div (add (mbe-concept-score r) (mbe-world-score r)) 2))
    (defn mbe-semantic-coverage (r)
        (div (add (mbe-native r)
              (add (mbe-provenance r)
              (add (mbe-temporal r)
              (add (mbe-planes r)
              (add (mbe-executable r) (mbe-reversible r)))))) 6))
    (defn mbe-success? (r)
        (if (and (ge (mbe-concept-score r) 60) (ge (mbe-world-score r) 60)) 1 0))

    ; Generate 100 rounds rather than authoring the result rows. Healthy growth
    ; raises every semantic/world dimension with the round. Provenance receives
    ; a ten-point lead because source capture precedes interpretation, capped at
    ; 100. The control increases translated volume only.
    (defn mbe-cap100 (n) (if (gt n 100) 100 n))
    (defn mbe-healthy-rows-loop (round limit)
        (if (gt round limit) (list)
            (cons
                (mbe-row "healthy" round round
                    round (mbe-cap100 (add round 10)) round round round round round)
                (mbe-healthy-rows-loop (add round 1) limit))))
    (defn mbe-bulk-rows-loop (round limit)
        (if (gt round limit) (list)
            (cons
                (mbe-row "bulk" round round 5 20 10 14 10 90 10)
                (mbe-bulk-rows-loop (add round 1) limit))))
    (defn mbe-healthy-rows () (mbe-healthy-rows-loop 1 100))
    (defn mbe-bulk-rows () (mbe-bulk-rows-loop 1 100))

    (defn mbe-successes (rows)
        (if (eq (len rows) 0) 0
            (add (mbe-success? (head rows)) (mbe-successes (tail rows)))))
    (defn mbe-success-rate (rows)
        (if (eq (len rows) 0) 0 (div (mul (mbe-successes rows) 100) (len rows))))

    ; Pairwise rank correlation rate. For every pair whose semantic coverage
    ; differs, count whether quality moves in the same direction. This yields
    ; an integer 0..100 and needs no floating square root.
    (defn mbe-pair-result (a b)
        (do
            (let dx (sub (mbe-semantic-coverage b) (mbe-semantic-coverage a)))
            (let dy (sub (mbe-quality b) (mbe-quality a)))
            (if (eq dx 0) (list 0 0)
                (if (or (and (gt dx 0) (gt dy 0)) (and (lt dx 0) (lt dy 0)))
                    (list 1 1)
                    (list 0 1)))))
    (defn mbe-pairs-against (a rest)
        (if (eq (len rest) 0) (list 0 0)
            (do
                (let here (mbe-pair-result a (head rest)))
                (let more (mbe-pairs-against a (tail rest)))
                (list (add (nth here 0) (nth more 0))
                      (add (nth here 1) (nth more 1))))))
    (defn mbe-all-pairs (rows)
        (if (le (len rows) 1) (list 0 0)
            (do
                (let here (mbe-pairs-against (head rows) (tail rows)))
                (let more (mbe-all-pairs (tail rows)))
                (list (add (nth here 0) (nth more 0))
                      (add (nth here 1) (nth more 1))))))
    (defn mbe-correlation-rate (rows)
        (do
            (let pairs (mbe-all-pairs rows))
            (if (eq (nth pairs 1) 0) 0
                (div (mul (nth pairs 0) 100) (nth pairs 1)))))

    ; The framebuffer now observes all 100 rounds. Its token is the chosen path:
    ; 101 = keep growing the grounded native-source lane, 107 = admit after the
    ; success floor, 201 = bulk translate-English-first. Margin is model quality.
    (defn mbe-trace-from-rows (rows healthy)
        (if (eq (len rows) 0) (list)
            (do
                (let r (head rows))
                (let token (if (eq healthy 1)
                               (if (eq (mbe-success? r) 1) 107 101)
                               201))
                (cons (fb-frame (sub (mbe-round r) 1) token (mbe-quality r))
                      (mbe-trace-from-rows (tail rows) healthy)))))
    (defn mbe-healthy-trace () (mbe-trace-from-rows (mbe-healthy-rows) 1))
    (defn mbe-bulk-trace () (mbe-trace-from-rows (mbe-bulk-rows) 0))

    ; Language-balance projection over the same 100 steps. The baseline is the
    ; measured name proxy from 2026-07-17: 61,335 distinct English-rooted names
    ; and 64 seated rows in each of Chinese, Arabic, and Sanskrit. A healthy
    ; parity batch admits 613 witnessed semantic-name rows per language per
    ; step. These are modeled coverage units, not a claim that source content
    ; has already entered the repository.
    (defn mbe-english-baseline () 61335)
    (defn mbe-lane-baseline () 64)
    (defn mbe-lane-growth-per-step () 613)
    (defn mbe-lane-count (step)
        (add (mbe-lane-baseline) (mul step (mbe-lane-growth-per-step))))
    ; row = step, English, Chinese, Arabic, Sanskrit, combined non-English,
    ; combined non-English as percent of English.
    (defn mbe-language-row (step)
        (do
            (let lane (mbe-lane-count step))
            (let non-english (mul lane 3))
            (list step (mbe-english-baseline) lane lane lane non-english
                  (div (mul non-english 100) (mbe-english-baseline)))))
    (defn mbe-language-checkpoints ()
        (list (mbe-language-row 0)
              (mbe-language-row 25)
              (mbe-language-row 50)
              (mbe-language-row 75)
              (mbe-language-row 100)))
    (defn mbe-language-rises? (rows column)
        (if (le (len rows) 1) 1
            (if (gt (nth (nth rows 1) column) (nth (head rows) column))
                (mbe-language-rises? (tail rows) column)
                0)))
    (defn mbe-parity-lanes (row)
        (add (if (ge (nth row 2) (nth row 1)) 1 0)
        (add (if (ge (nth row 3) (nth row 1)) 1 0)
             (if (ge (nth row 4) (nth row 1)) 1 0))))

    ; result = healthy success, bulk success, healthy correlation, bulk
    ; correlation, final concept scores, final world scores, framebuffer
    ; hesitation, conviction, divergence, changed?, and structural verdict.
    (defn multilingual-balance-experiment ()
        (do
            (let healthy (mbe-healthy-rows))
            (let bulk (mbe-bulk-rows))
            (let hlast (nth healthy 99))
            (let blast (nth bulk 99))
            (let htrace (mbe-healthy-trace))
            (let btrace (mbe-bulk-trace))
            (let support
                (if (and (gt (mbe-success-rate healthy) (mbe-success-rate bulk))
                     (and (gt (mbe-correlation-rate healthy) (mbe-correlation-rate bulk))
                     (and (gt (mbe-concept-score hlast) (mbe-concept-score blast))
                          (gt (mbe-world-score hlast) (mbe-world-score blast))))) 1 0))
            (list
                (mbe-success-rate healthy)
                (mbe-success-rate bulk)
                (mbe-correlation-rate healthy)
                (mbe-correlation-rate bulk)
                (mbe-concept-score hlast)
                (mbe-concept-score blast)
                (mbe-world-score hlast)
                (mbe-world-score blast)
                (hesitation htrace)
                (conviction htrace)
                (diverge htrace btrace)
                (thinking-changed? htrace btrace)
                support)))

    0)
