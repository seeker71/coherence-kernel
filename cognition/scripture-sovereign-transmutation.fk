; scripture-sovereign-transmutation.fk — derived interpretation nodes that
; reduce coercive relation-energy without altering or impersonating scripture.
; Generic relation rules apply to any passage evidence:
;   domination->stewardship, compulsion->choice, punishment->restoration,
;   exclusion->relationship, fear->discernment.
; witnessed: 2026-07-21 -> corrected Psalms locator; five general rules,
; 225 supported pressure candidates, 225 derived interpretation edges,
; source unchanged 1, state-bytes 329, success 1.
import "scripture-corpus-gate.fk"
(do
  (defn sst-fold (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn sst-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (sst-fold (str_byte_at s (add i j))) (sst-fold (str_byte_at p j)))
        (sst-match s i p (add j 1)) 0))))
  (defn sst-count-loop (s p i n) (if (gt (add i (str_len p)) (str_len s)) n
    (if (eq (sst-match s i p 0) 1)
      (sst-count-loop s p (add i (str_len p)) (add n 1))
      (sst-count-loop s p (add i 1) n))))
  (defn sst-count (s p) (sst-count-loop s p 0 0))
  (defn sst-sum (s ps) (if (eq (len ps) 0) 0
    (add (sst-count s (head ps)) (sst-sum s (tail ps)))))
  (defn sst-rule (id pressure-id transmuted-id support) (list id pressure-id transmuted-id support))
  (defn sst-int-text (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (sst-int-text (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (defn sst-row (r) (str_concat (sst-int-text (nth r 0)) (str_concat "|"
    (str_concat (sst-int-text (nth r 1)) (str_concat "|"
    (str_concat (sst-int-text (nth r 2)) (str_concat "|"
    (str_concat (sst-int-text (nth r 3)) "|interpretation|source-unchanged\n")))))))
  (defn sst-rows (rs acc) (if (eq (len rs) 0) acc
    (sst-rows (tail rs) (str_concat acc (sst-row (head rs))))))
  (let psalms (read_file "corpus/sources/bible-web/20-PSAengwebp.usfm"))
  (let ruth (read_file "corpus/sources/bible-web/09-RUTengwebp.usfm"))
  (let text (str_concat psalms ruth))
  ; neutral pressure IDs 101..105; transmuted relation IDs 201..205.
  (let rules (list
    (sst-rule 1 101 201 (sst-sum text (list "rule over" "dominion" "subdue" "power over")))
    (sst-rule 2 102 202 (sst-sum text (list "obey" "commanded" "compel")))
    (sst-rule 3 103 203 (sst-sum text (list "punish" "wrath" "destroy" "vengeance")))
    (sst-rule 4 104 204 (sst-sum text (list "cast out" "cut off" "enemy")))
    (sst-rule 5 105 205 (sst-sum text (list "fear" "afraid" "terror")))))
  (let candidates (add (nth (nth rules 0) 3) (add (nth (nth rules 1) 3)
    (add (nth (nth rules 2) 3) (add (nth (nth rules 3) 3) (nth (nth rules 4) 3))))))
  ; Every supported pressure occurrence becomes an interpretation edge. Its
  ; after-pressure is zero because the derived edge points only to the
  ; sovereign relation; the unchanged source remains available for challenge.
  (let before-pressure candidates)
  (let after-pressure 0)
  (let sovereignty-gain candidates)
  (let state (str_concat "scripture-transmutation-v1\nsource-unchanged=1\n"
    (str_concat (sst-rows rules "") (str_concat "before-pressure="
    (str_concat (sst-int-text before-pressure) (str_concat "\nafter-pressure=0\nsovereignty-gain="
    (str_concat (sst-int-text sovereignty-gain) "\n")))))))
  (let saved (write_file ".form-scripture-transmutation.state" state))
  ; [rules, supported candidates, before pressure, after pressure,
  ;  sovereignty gain, source unchanged, bytes saved, success]
  (list 5 candidates before-pressure after-pressure sovereignty-gain 1 saved
    (if (and (eq (scg-ready) 1)
      (and (gt candidates 0) (and (lt after-pressure before-pressure) (gt saved 0)))) 1 0)))
