// concept-human-corpus-130000.fk -- random access and exhaustive native audit.
//
// Pinned shard/index hashes remain transport provenance in SOURCE-MANIFEST.tsv.
// Runtime integrity does not rent a shell: Form checks exact sizes and every
// sequential index boundary, reconstructs every original six-field Tatoeba row
// from the projection, recomputes its SHA-256, and verifies the retained
// source-row hash. Counts or transport hashes alone cannot stand in for that
// content-path witness.
// witnessed: 2026-07-20 -> random access operational; exhaustive audit door
import form/form-stdlib/core.fk;
import form/form-stdlib/form-fs.fk;
import cognition/concept-human-corpus-130000-metadata.fk;
import cognition/concept-human-corpus-130000-ingest.fk;
import observe/framebuffer-runtime-observation.fk;
section [form.bml] {
    def chc130-spec-locale(s) = s[0];
    def chc130-spec-lang(s) = s[1];
    def chc130-spec-rows(s) = s[2];
    def chc130-spec-target(s) = s[3];
    def chc130-spec-data-path(s) = s[4];
    def chc130-spec-data-hash(s) = s[5];
    def chc130-spec-data-bytes(s) = s[6];
    def chc130-spec-index-path(s) = s[7];
    def chc130-spec-index-hash(s) = s[8];
    def chc130-spec-index-bytes(s) = s[9];
    def chc130-spec-archive-hash(s) = s[10];
    def chc130-spec-archive-bytes(s) = s[11];
    def chc130-spec-archive-url(s) = s[12];
    def chc130-spec-status(s) = s[13];
    def chc130-spec-at-go(specs, locale) = (Comparable) len(specs) == 0 ? empty() : (String) chc130-spec-locale(specs[0]) == locale ? specs[0] : chc130-spec-at-go(specs[1:], locale);
    def chc130-spec-at(locale) = chc130-spec-at-go(chc130-specs(), locale);
    def chc130-u32-at(index-path, index) = {
        let b = fs-read-slice(index-path, index * 4, 4);
        !((Comparable) len(b) == 4) ? -1 : (Number) str-byte-at(b, 0) + (Number) ((Number) (str-byte-at(b, 1) * 256) + (Number) ((Number) (str-byte-at(b, 2) * 65536) + (Number) (str-byte-at(b, 3) * 16777216)));
    };
    def chc130-row-line(spec, index) = index < 0 || index >= chc130-spec-rows(spec) ? "" : {
        let start = chc130-u32-at(chc130-spec-index-path(spec), index);
        let end = chc130-u32-at(chc130-spec-index-path(spec), (Number) index + (Number) 1);
        start < 0 || end <= start ? "" : fs-read-slice(chc130-spec-data-path(spec), start, end - start - 1);
    };
    def chc130-row-at(locale, index) = {
        let spec = chc130-spec-at(locale);
        (Comparable) len(spec) == 0 ? "" : chc130-row-line(spec, index);
    };
    def chc130-source-line(row) = chc130-concat([chc130-field(row, 2), "\t", chc130-field(row, 1), "\t", chc130-field(row, 10), "\t", chc130-field(row, 3), "\t", chc130-field(row, 4), "\t", chc130-field(row, 5)]);
    def chc130-hex-byte?(b) = b >= 48 && b <= 57 || b >= 97 && b <= 102;
    def chc130-hex64-go(s, i) = (Comparable) i == 64 ? 1 : (Comparable) chc130-hex-byte?(str-byte-at(s, i)) == 0 ? 0 : chc130-hex64-go(s, (Number) i + (Number) 1);
    def chc130-hex64?(s) = (Comparable) len(s) == 64 && (Comparable) chc130-hex64-go(s, 0) == 1;
    def chc130-source-hash-valid?(row) = (Comparable) chc130-hex64?(chc130-field(row, 9)) == 1 && (String) chc130-source-hash(chc130-source-line(row)) == chc130-field(row, 9);
    def chc130-row-structure-valid?(spec, row, previous-id) = {
        let sentence-id = str_to_int(chc130-field(row, 2));
        (Comparable) chc130-field-count(row) == 11 && ((String) chc130-field(row, 0) == chc130-spec-locale(spec) && ((String) chc130-field(row, 1) == chc130-spec-lang(spec) && (sentence-id > previous-id && (!((String) chc130-field(row, 3) == "") && (!((String) chc130-field(row, 10) == "") && ((String) chc130-field(row, 6) == "CC-BY-2.0-FR" && ((String) chc130-field(row, 7) == chc130-page-url(chc130-field(row, 2)) && (String) chc130-field(row, 8) == "human-contributed-unreviewed")))))));
    };
    // audit = locale, rows, structurally valid, source hashes valid, failures,
    //         first id, last id, monotonic ids, index terminal, artifact hashes.
    def chc130-audit-go(spec, index, structural, hashes, previous-id, first-id, monotonic) = index >= chc130-spec-rows(spec) ? {
        let terminal = chc130-u32-at(chc130-spec-index-path(spec), index);
        [chc130-spec-locale(spec), index, structural, hashes, index - (structural < hashes ? structural : hashes), first-id, previous-id, monotonic, terminal];
    } : {
        let row = chc130-row-line(spec, index);
        let sentence-id = str_to_int(chc130-field(row, 2));
        let structure-ok = chc130-row-structure-valid?(spec, row, previous-id);
        let hash-ok = chc130-source-hash-valid?(row);
        chc130-audit-go(spec, (Number) index + (Number) 1, (Number) structural + (Number) structure-ok, (Number) hashes + (Number) hash-ok, sentence-id, (Comparable) index == 0 ? sentence-id : first-id, monotonic && ((Comparable) index == 0 ? 1 : sentence-id > previous-id));
    };
    def chc130-spec-artifacts-valid?(spec) = (Comparable) fs-stat-size(chc130-spec-data-path(spec)) == chc130-spec-data-bytes(spec) && ((Comparable) fs-stat-size(chc130-spec-index-path(spec)) == chc130-spec-index-bytes(spec) && ((Comparable) chc130-spec-index-bytes(spec) == ((Number) chc130-spec-rows(spec) + (Number) 1) * 4 && ((Comparable) chc130-u32-at(chc130-spec-index-path(spec), 0) == len(chc130-header()) && (Comparable) chc130-u32-at(chc130-spec-index-path(spec), chc130-spec-rows(spec)) == chc130-spec-data-bytes(spec))));
    def chc130-audit-spec(spec) = {
        let audit = chc130-audit-go(spec, 0, 0, 0, -1, -1, 1);
        [audit, (Comparable) audit[1] == chc130-spec-rows(spec), (Comparable) audit[2] == chc130-spec-rows(spec), (Comparable) audit[3] == chc130-spec-rows(spec), (Comparable) audit[7] == 1, (Comparable) audit[8] == chc130-spec-data-bytes(spec), chc130-spec-artifacts-valid?(spec)];
    };
    def chc130-audit-locale(locale) = {
        let spec = chc130-spec-at(locale);
        (Comparable) len(spec) == 0 ? ["unknown-locale"] : chc130-audit-spec(spec);
    };
    // The observation report is returned beside, and before interpretation of,
    // the audit.  Resource costs are measured, not apportioned by row count.
    def chc130-audit-observed(locale) = {
        let spec = chc130-spec-at(locale);
        let window = fbro-open-stream(("human-corpus-audit-" + locale), "Sema", "audits-attributed-human-sentences", "verify-source-content-before-coverage-claim", "user-requested-framebuffer-first", (Number) chc130-spec-data-bytes(spec) + (Number) chc130-spec-index-bytes(spec), "cognition/concept-human-corpus-130000.fk", 148, 7);
        let before = fbro-snapshot();
        let audit = chc130-audit-spec(spec);
        let after = fbro-snapshot();
        let ok = audit[1] && (audit[2] && (audit[3] && (audit[4] && (audit[5] && audit[6]))));
        let outcome = ok ? "complete-source-content-audit" : "audit-refuted-or-incomplete";
        let stage = fbro-stage-observed-stream(("human-corpus-audit-" + locale), "source-content-audit", "trace-begin", "Sema", "audits-attributed-human-sentences", "verify-source-content-before-coverage-claim", "user-requested-framebuffer-first", before, after, "rows", chc130-spec-rows(spec), outcome, "cognition/concept-human-corpus-130000.fk", 163, 7);
        let report = fbro-close-stream(window, outcome, chc130-spec-rows(spec), "cognition/concept-human-corpus-130000.fk", 166, 7);
        [report, audit];
    };
    def chc130-quote(locale, index) = {
        let row = chc130-row-at(locale, index);
        (String) row == "" ? empty() : ["attributed-human-quote-not-novel-generation", chc130-field(row, 0), str_to_int(chc130-field(row, 2)), chc130-field(row, 3), chc130-field(row, 6), chc130-field(row, 7), chc130-field(row, 8), chc130-field(row, 9), chc130-field(row, 10)];
    };
}
