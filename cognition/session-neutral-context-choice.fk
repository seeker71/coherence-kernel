; session-neutral-context-choice.fk — context can offer one witnessed phrase
; meaning without erasing any alternative.
;
; A candidate's score composes three visible terms: current evidence balance,
; exact neutral-symbol overlap, and 13-axis field resonance. Only a binding whose
; current witness summary is `supported` may become the offer. Ties remain
; ambiguous and an absence of supported evidence abstains. Every candidate row
; is returned regardless of the offer, so scoring is a lens rather than a
; mutation of the dictionary or graph.
;
; witnessed: 2026-08-24 -> context choice band 32767 on fkwu
; preludes: cognition/session-neutral-meaning-evidence.fk

(do
  (defn snsc-project-context (dictionary addresses projection)
    (if (eq (len addresses) 0) projection
      (do
        (let consensus
          (snsp-address-field-consensus dictionary (head addresses)))
        (snsc-project-context dictionary (tail addresses)
          (if (eq (len consensus) 0) projection
            (list (snsf-shape-add (snsf-p-shape projection) (head consensus))
              (add (snsf-p-count projection) 1)
              (cons (head addresses) (snsf-p-evidence projection))))))))
  (defn snsc-context-field (dictionary addresses)
    (do
      (let p (snsc-project-context dictionary addresses
        (snsf-projection-empty)))
      (if (eq (snsf-p-count p) 0) (empty)
        (snsf-shape-div (snsf-p-shape p) (snsf-p-count p)))))
  (defn snsc-overlap (recipe context)
    (if (eq (len recipe) 0) 0
      (add (if (eq (snse-address-in? (head recipe) context) 1) 1 0)
        (snsc-overlap (tail recipe) context))))
  (defn snsc-resonance-loop (a b)
    (if (eq (len a) 0) (if (eq (len b) 0) 0 -1)
      (if (eq (len b) 0) -1
        (add (sub 1000 (abs (sub (head a) (head b))))
          (snsc-resonance-loop (tail a) (tail b))))))
  (defn snsc-resonance (a b)
    (if (or (eq (len a) 0) (eq (len b) 0)) -1
      (snsc-resonance-loop a b)))
  (defn snsc-evidence-balance (summary)
    (sub (snse-s-support summary) (snse-s-release summary)))
  (defn snsc-score (summary overlap resonance)
    (add (mul (snsc-evidence-balance summary) 20000)
      (add (mul overlap 14000) (if (lt resonance 0) 0 resonance))))

  ; candidate row = binding, evidence summary, exact overlap, resonance, score,
  ; supported-for-offer.
  (defn snsc-candidate
    (dictionary context-field context events binding minimum)
    (do
      (let summary (snse-summary events binding minimum))
      (let meaning (snsp-b-meaning binding))
      (let overlap (snsc-overlap (snsp-m-recipe meaning) context))
      (let resonance (snsc-resonance (snsp-m-field meaning) context-field))
      (list binding summary overlap resonance
        (snsc-score summary overlap resonance)
        (if (str_eq (snse-s-state summary) "supported") 1 0))))
  (defn snsc-c-binding (candidate) (nth candidate 0))
  (defn snsc-c-summary (candidate) (nth candidate 1))
  (defn snsc-c-overlap (candidate) (nth candidate 2))
  (defn snsc-c-resonance (candidate) (nth candidate 3))
  (defn snsc-c-score (candidate) (nth candidate 4))
  (defn snsc-c-supported (candidate) (nth candidate 5))
  (defn snsc-candidates
    (dictionary context-field context events bindings minimum)
    (if (eq (len bindings) 0) (empty)
      (cons (snsc-candidate dictionary context-field context events
              (head bindings) minimum)
        (snsc-candidates dictionary context-field context events
          (tail bindings) minimum))))
  (defn snsc-supported (candidates)
    (if (eq (len candidates) 0) (empty)
      (if (eq (snsc-c-supported (head candidates)) 1)
        (cons (head candidates) (snsc-supported (tail candidates)))
        (snsc-supported (tail candidates)))))
  (defn snsc-best-score (candidates best)
    (if (eq (len candidates) 0) best
      (snsc-best-score (tail candidates)
        (if (gt (snsc-c-score (head candidates)) best)
          (snsc-c-score (head candidates)) best))))
  (defn snsc-at-score (candidates score)
    (if (eq (len candidates) 0) (empty)
      (if (eq (snsc-c-score (head candidates)) score)
        (cons (head candidates) (snsc-at-score (tail candidates) score))
        (snsc-at-score (tail candidates) score))))

  ; choice = mode, all candidate rows, offered binding or empty, number tied
  ; at the best supported score, best score, reason.
  (defn snsc-choice (dictionary context events bindings minimum)
    (do
      (let context-field (snsc-context-field dictionary context))
      (let candidates (snsc-candidates dictionary context-field context
        events bindings minimum))
      (let supported (snsc-supported candidates))
      (if (eq (len candidates) 0)
        (list "abstain" candidates (empty) 0 -1 "no-bindings")
        (if (eq (len supported) 0)
          (list "abstain" candidates (empty) 0 -1
            "no-supported-evidence")
          (do
            (let best (snsc-best-score supported -1000000000))
            (let top (snsc-at-score supported best))
            (if (gt (len top) 1)
              (list "ambiguous" candidates (empty) (len top) best
                "equal-contextual-offers")
              (list "offer" candidates
                (snsc-c-binding (head top)) 1 best
                "unique-supported-contextual-offer")))))))
  (defn snsc-o-mode (choice) (nth choice 0))
  (defn snsc-o-candidates (choice) (nth choice 1))
  (defn snsc-o-binding (choice) (nth choice 2))
  (defn snsc-o-ties (choice) (nth choice 3))
  (defn snsc-o-score (choice) (nth choice 4))
  (defn snsc-o-reason (choice) (nth choice 5))

  0)
