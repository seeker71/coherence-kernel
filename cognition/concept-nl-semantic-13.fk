// concept-nl-semantic-13.fk — indexed Form access to 10k concept-aligned labels.
//
// Data is a pinned 10,000-row TSV. A generated 10,001-offset index gives the
// byte interval of every row. The API takes both values explicitly, keeping
// parsing/detection pure; a live carrier may obtain the TSV with read_file.
//
// English is the exact frequency-model anchor. Other mapped labels are
// automatically extracted OMW evidence joined through PWN 3.1 sense keys to
// PWN 3.0 synsets, therefore state=mapped-unreviewed. Empty cells are absent.
// There is no seed fallback and no claim that the first lemma is preferred,
// canonical, fluent, or reviewed.
// witnessed: 2026-07-18 -> 1023 four-way; 8191 live fkwu
//
import form/form-stdlib/core.fk;
import cognition/concept-nl-semantic-13-metadata.fk;
import cognition/concept-nl-semantic-13-offsets.fk;
section [form.bml] {
    def cnl13-anchor-count() = 10000;
    def cnl13-data-path() = "cognition/concept-nl-semantic-13-omw.tsv";
    def cnl13-source-codes-path() = "cognition/concept-nl-semantic-13-sources.dat";
    def cnl13-locale-codes() = ["en", "id", "es", "fr", "pt-br", "sw", "de", "ru", "zh", "ja", "ar", "hi", "tr"];
    // Column 0 is the PWN 3.0 offset-pos synset; locale labels occupy 1..13.
    def cnl13-locale-col(code) = (String) code == "en" ? 1 : (String) code == "id" ? 2 : (String) code == "es" ? 3 : (String) code == "fr" ? 4 : (String) code == "pt-br" ? 5 : (String) code == "sw" ? 6 : (String) code == "de" ? 7 : (String) code == "ru" ? 8 : (String) code == "zh" ? 9 : (String) code == "ja" ? 10 : (String) code == "ar" ? 11 : (String) code == "hi" ? 12 : (String) code == "tr" ? 13 : -1;
    def cnl13-row-line-from-tail(data, offset-tail) = substring(data, offset-tail[0], offset-tail[1:][0] - 1);
    def cnl13-offset-tail(offsets, index) = (Comparable) index == 0 ? offsets : cnl13-offset-tail(offsets[1:], index - 1);
    def cnl13-row-line(data, offsets, index) = index < 0 || index >= cnl13-anchor-count() ? "" : cnl13-row-line-from-tail(data, cnl13-offset-tail(offsets, index));
    // Extract one tab field from an already indexed row, preserving empty cells.
    def cnl13-field-go(line, target, col, start, i) = i >= len(line) ? (Comparable) col == target ? substring(line, start, i) : "" : (Comparable) str_byte_at(line, i) == 9 ? (Comparable) col == target ? substring(line, start, i) : cnl13-field-go(line, target, (Number) col + (Number) 1, (Number) i + (Number) 1, (Number) i + (Number) 1) : cnl13-field-go(line, target, col, start, (Number) i + (Number) 1);
    def cnl13-field(line, column) = cnl13-field-go(line, column, 0, 0, 0);
    def cnl13-anchor-at(data, offsets, index) = cnl13-field(cnl13-row-line(data, offsets, index), 0);
    def cnl13-label-at(data, offsets, index, code) = {
        let col = cnl13-locale-col(code);
        col < 1 ? "" : cnl13-field(cnl13-row-line(data, offsets, index), col);
    };
    def cnl13-label-state(code, label) = cnl13-locale-col(code) < 1 ? "unknown-locale" : (String) label == "" ? "absent" : "mapped-unreviewed";
    // lookup = (index synset locale label state)
    def cnl13-lookup(data, offsets, index, code) = {
        let label = cnl13-label-at(data, offsets, index, code);
        [index, cnl13-anchor-at(data, offsets, index), code, label, cnl13-label-state(code, label)];
    };
    def cnl13-generate(data, offsets, index, code) = cnl13-label-at(data, offsets, index, code);
    // One fixed provenance byte per concept/lens cell, row-major:
    // F = frequency anchor, W = Wiktionary OMW, D = dedicated language WordNet,
    // C = CLDR, G = Google machine translation (unreviewed), 0 = absent.
    // The source matrix is separate from labels so old lookup/generation callers
    // keep their exact shape while a stricter caller can demand attribution.
    def cnl13-source-code-at(sources, index, code) = {
        let col = cnl13-locale-col(code);
        index < 0 || index >= cnl13-anchor-count() ? "0" : col < 1 ? "0" : substring(sources, (Number) (index * 13) + (Number) (col - 1), (Number) (index * 13) + (Number) col);
    };
    def cnl13-source-name(source-code) = (String) source-code == "F" ? "frequency-anchor" : (String) source-code == "W" ? "wiktionary-omw" : (String) source-code == "D" ? "dedicated-wordnet" : (String) source-code == "C" ? "cldr-wordnet" : (String) source-code == "G" ? "google-translate-machine" : "absent";
    def cnl13-sourced-state(source-code) = (String) source-code == "F" ? "frequency-observed" : (String) source-code == "G" ? "machine-translated-unreviewed" : (String) source-code == "0" ? "absent" : "mapped-unreviewed";
    // sourced lookup = ordinary five-field lookup + exact source name/code.
    def cnl13-lookup-sourced(data, offsets, sources, index, code) = {
        let base = cnl13-lookup(data, offsets, index, code);
        let source-code = cnl13-source-code-at(sources, index, code);
        [base[0], base[1], base[2], base[3], cnl13-sourced-state(source-code), cnl13-source-name(source-code), source-code];
    };
    def cnl13-count-source-go(sources, i, wanted, count) = (Comparable) i == len(sources) ? count : cnl13-count-source-go(sources, (Number) i + (Number) 1, wanted, (String) substring(sources, i, (Number) i + (Number) 1) == wanted ? (Number) count + (Number) 1 : count);
    def cnl13-count-source(sources, wanted) = cnl13-count-source-go(sources, 0, wanted, 0);
    // Exact label detection returns the first matching anchor. Multiple concepts
    // may legitimately share a lemma; callers get the witnessed first-match rule.
    def cnl13-detect-first-go(data, offset-tail, col, code, label, index) = index >= cnl13-anchor-count() ? empty() : {
        let line = cnl13-row-line-from-tail(data, offset-tail);
        let candidate = cnl13-field(line, col);
        !((String) candidate == "") && (String) candidate == label ? [index, cnl13-field(line, 0), code, candidate, "mapped-unreviewed"] : cnl13-detect-first-go(data, offset-tail[1:], col, code, label, (Number) index + (Number) 1);
    };
    def cnl13-detect-first(data, offsets, code, label) = {
        let col = cnl13-locale-col(code);
        col < 1 || (String) label == "" ? empty() : cnl13-detect-first-go(data, offsets, col, code, label, 0);
    };
    // Recompute exact mapped coverage from the pinned rows, using the index as a
    // sequential cursor so the 10k walk stays linear rather than repeated nth.
    def cnl13-count-present-go(data, offset-tail, col, index, count) = index >= cnl13-anchor-count() ? count : {
        let label = cnl13-field(cnl13-row-line-from-tail(data, offset-tail), col);
        cnl13-count-present-go(data, offset-tail[1:], col, (Number) index + (Number) 1, (String) label == "" ? count : (Number) count + (Number) 1);
    };
    def cnl13-count-present(data, offsets, code) = {
        let col = cnl13-locale-col(code);
        col < 1 ? 0 : cnl13-count-present-go(data, offsets, col, 0, 0);
    };
    def cnl13-meta-find-go(rows, code) = (Comparable) len(rows) == 0 ? empty() : (String) rows[0][0] == code ? rows[0] : cnl13-meta-find-go(rows[1:], code);
    def cnl13-locale-meta(code) = cnl13-meta-find-go(cnl13-locale-meta-rows(), code);
    def cnl13-meta-present(row) = row[2];
    def cnl13-meta-absent(row) = row[3];
    def cnl13-meta-source-hash(row) = row[4];
    // reviewed stays zero until a reviewed source/review receipt is ingested.
    def cnl13-review-summary(code) = {
        let row = cnl13-locale-meta(code);
        (Comparable) len(row) == 0 ? [0, 0, 0] : [cnl13-meta-present(row), cnl13-meta-absent(row), 0];
    };
    def cnl13-total-present-go(rows, total) = (Comparable) len(rows) == 0 ? total : cnl13-total-present-go(rows[1:], (Number) total + (Number) cnl13-meta-present(rows[0]));
    def cnl13-total-present() = cnl13-total-present-go(cnl13-locale-meta-rows(), 0);
}
