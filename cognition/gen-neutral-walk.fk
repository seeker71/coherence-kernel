; gen-neutral-walk.fk — the emitted IR run INSIDE the kernel, and the band that
; asks it. Split out of gen-neutral-code.fk on 2026-07-28, and the split is the
; finding rather than housekeeping.
;
; WHY IT MOVED
;   `cognition/tests/gen-conformance-band.fk` printed 255 and exited 1. Codex,
;   asked to review the codegen stack, ran the band and read the exit status;
;   I had read only the number. Two `[unresolved-call] walk_recipe` errors were
;   raised, recovered to `nothing` by axiom-5, and the fold went green anyway
;   because the readings that matter never touch those call sites.
;
;   The cause is not a typo. `walk_recipe` is registered in Go, Rust and
;   TypeScript and absent from fkwu; `host-exec` is fkwu's and absent from the
;   siblings. gen-conformance needs host-exec, so it runs on fkwu — and it
;   preludes gen-neutral-code.fk, which carried a walk_recipe call site in a
;   function it never calls. fkwu resolves every call site in the chain, not
;   only the reached ones, so an unrelated arm's door became an error in this
;   arm's run. That is corpus row 913, impedance-mismatch, one layer up.
;
;   So the ARM-NEUTRAL half stays in gen-neutral-code.fk — tables, renderer,
;   vocabulary walkers, everything any arm can hold — and the SIBLINGS-ONLY
;   half lives here. A cell now preludes only the doors its arm actually has.
;
; PROOF LANE: SIBLINGS ONLY — walk_recipe is Go/Rust/TS and absent from fkwu.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk cognition/gen-neutral-code.fk

(do
  ;; ═══ the Form emission is EXECUTED, not just spelled ═══════════
  ;; the same IR lowered to a recipe the kernel can walk
  (defn gnc-to-recipe (n)
    (do (let k (gir-kind n))
      (if (str_eq k "lit") (intern_trivial_int (gir-nth n 0))
        (if (str_eq k "cmp")
            (intern_node (bp "eq") (list (gnc-to-recipe (gir-nth n 1)) (gnc-to-recipe (gir-nth n 2))))
          (if (str_eq k "if")
              (intern_node (bp "if") (list (gnc-to-recipe (gir-nth n 0))
                                           (gnc-to-recipe (gir-nth n 1))
                                           (gnc-to-recipe (gir-nth n 2))))
            (intern_node (bp "add") (list (gnc-to-recipe (gir-nth n 1))
                                          (gnc-to-recipe (gir-nth n 2)))))))))
  (defn gnc-run (concept) (walk_recipe (gnc-to-recipe (gnc-count-ir concept))))

  (defn gnc-direct-loop (fs c)
    (if (eq (len fs) 0) 0
      (add (if (eq (stn-f-subject (head fs)) c)
             (if (eq (stn-f-relation (head fs)) (stn-has-member)) 1 0) 0)
           (gnc-direct-loop (tail fs) c))))
  (defn gnc-direct (c) (gnc-direct-loop (stn-facts) c))

  (defn gnc-check ()
    (add (if (eq (gnc-total?) 1) 1 0)
    (add (if (eq (gnc-has-shape? "cobol" "bin") 0) 2 0)
    (add (if (eq (str_len (gnc-emit "cobol" (stn-threefold-soul))) 0) 4 0)
    (add (if (gt (str_len (gnc-emit "form" (stn-threefold-soul))) 60) 8 0)
    (add (if (gt (str_len (gnc-emit "python" (stn-threefold-soul))) 60) 16 0)
    (add (if (gt (str_len (gnc-emit "javascript" (stn-threefold-soul))) 60) 32 0)
    ;; three languages, three DIFFERENT texts from one IR
    (add (if (str_eq (gnc-emit "form" (stn-threefold-soul))
                     (gnc-emit "python" (stn-threefold-soul))) 0 64)
    (add (if (str_eq (gnc-emit "python" (stn-threefold-soul))
                     (gnc-emit "javascript" (stn-threefold-soul))) 0 128)
    ;; and the generated Form RUNS, agreeing with the graph
    (add (if (eq (gnc-run (stn-threefold-soul)) (gnc-direct (stn-threefold-soul))) 256 0)
    (add (if (eq (gnc-run (stn-fourfold-being)) 4) 512 0)
    (add (if (eq (gnc-run (stn-eurythmy)) 0) 1024 0)
    (add (if (eq (gnc-ops-total?) 1) 2048 0)
    (add (if (str_eq (gnc-op "python" "eq") "==") 4096 0)
    (add (if (eq (gnc-data-leaked? "form") 0)
             (if (eq (gnc-data-leaked? "python") 0) 8192 0) 0)
    (add (if (gt (str_len (gnc-emit-fn "python")) 40)
             (if (gt (str_len (gnc-emit-fn "javascript")) 40) 16384 0) 0)
    (add (if (eq (str_len (gnc-render "form" (gir-bcall "nosuch" (list (gir-lit 1))))) 0) 32768 0)
    ;; every language that names a builtin it does not have, ships it
    (add (if (gt (str_len (gnc-prelude "python")) 20)
             (if (gt (str_len (gnc-prelude "javascript")) 20)
                 (if (eq (str_len (gnc-prelude "form")) 0) 65536 0) 0) 0)
    (add (if (gt (str_len (gnc-module "python")) (str_len (gnc-emit-fn "python"))) 131072 0)
    ;; PRECEDENCE: the infix output no longer wraps what it need not wrap
    (add (if (eq (gnc-prefix? "form") 1) (if (eq (gnc-prefix? "python") 0) 262144 0) 0)
    (add (if (gt (gnc-prec "python" "add") (gnc-prec "python" "eq")) 524288 0)
    ;; the relation-parameterised query emits in every language
    (add (if (gt (str_len (gnc-emit-query "python")) 60)
             (if (gt (str_len (gnc-emit-query "form")) 60) 1048576 0) 0)
    ;; and it still carries no data
    (add (if (lt (str_find (gnc-emit-query "python") "3045" 0) 0) 2097152 0)
    ;; LEVERAGE is a number, and it is greater than one
    (add (if (gt (gnc-leverage) 1) 4194304 0)
    ;; the signature table drives everything: gir-kinds derives from it
    (add (if (eq (len (gir-kinds)) 15) 8388608 0)
    ;; a NEW IR kind, added with zero renderer edits, renders in all three
    (add (if (gt (str_len (gnc-render "form" (gir-let "x" (gir-lit 1) (gir-var "x")))) 8)
             (if (gt (str_len (gnc-render "python" (gir-let "x" (gir-lit 1) (gir-var "x")))) 8)
                 (if (gt (str_len (gnc-render "javascript" (gir-let "x" (gir-lit 1) (gir-var "x")))) 8)
                     16777216 0) 0) 0)
    ;; and the counts come from the graph, not from two constants
    (add (if (gt (gnc-relations-n) 1) (if (gt (gnc-concepts-n) 1) 33554432 0) 0)
    ;; the generic IR walker works — it finds the ops and builtins the query
    ;; actually reaches for, rather than the ones the table declares
    (add (if (eq (len (gnc-required-ops (gnc-query-ir))) 3)
             (if (eq (len (gnc-required-bis (gnc-query-ir))) 3) 67108864 0) 0)
    ;; and every registered language can spell all of them
    (add (if (eq (gnc-vocab-covered? (gnc-query-ir)) 1) 134217728 0)
    ;; a program reaching for a builtin nobody names is REFUSED by the check,
    ;; not discovered at render time
    (add (if (eq (gnc-vocab-covered? (gir-bcall "nosuch" (list (gir-lit 1)))) 0) 268435456 0)
    ;; four languages now, and the fourth forced the statement layer
    (add (if (eq (gnc-languages-n) 4) 536870912 0)
    ;; Go renders the STATEMENT form — it has no conditional expression
    (add (if (gt (str_len (gnc-emit-stmt "go")) 80) 1073741824 0)
    ;; and REFUSES the expression form, because it carries no `if`/`fn` row.
    ;; Python is the mirror: it renders the expression form and refuses the
    ;; statement one. Neither refusal is a gap; a language row says which
    ;; forms that language can actually speak.
    (add (if (eq (str_len (gnc-emit-query "go")) 0)
             (if (eq (str_len (gnc-emit-stmt "python")) 0) 2147483648 0) 0)
         0)))))))))))))))))))))))))))))))))

  0)
