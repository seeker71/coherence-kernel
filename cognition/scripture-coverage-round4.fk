; scripture-coverage-round4.fk — admit one more source layer and measure the
; portion of each locally available corpus that the native model has touched.
; Every public observation starts: [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [-8999999999999999999,0,1,4001,10,66,1515,3,3,10000,5,5360951,38869388,65,1]
import "scripture-corpus-gate.fk"
(do
  (defn scr4-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (scr4-match s i p (add j 1)) 0))))
  (defn scr4-has-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) 0
    (if (eq (scr4-match s i p 0) 1) 1 (scr4-has-loop s p (add i 1)))))
  (defn scr4-has (s p) (scr4-has-loop s p 0))
  (defn scr4-suffix (s p) (if (lt (str_len s) (str_len p)) 0
    (scr4-match s (sub (str_len s) (str_len p)) p 0)))
  (defn scr4-bible-source (name)
    (if (eq (scr4-suffix name ".usfm") 0) 0
      (if (eq (scr4-has name "FRT") 1) 0
        (if (eq (scr4-has name "GLO") 1) 0 1))))
  (defn scr4-xml-source (name) (scr4-suffix name ".xml"))
  (defn scr4-source-count (names kind n) (if (eq (len names) 0) n
    (scr4-source-count (tail names) kind
      (add n (if (eq kind 1) (scr4-bible-source (head names)) (scr4-xml-source (head names)))))))
  (defn scr4-size-loop (paths n) (if (eq (len paths) 0) n
    (scr4-size-loop (tail paths) (add n (host_file_size (head paths))))))
  (defn scr4-present-loop (paths n) (if (eq (len paths) 0) n
    (scr4-present-loop (tail paths)
      (add n (if (gt (host_file_size (head paths)) 0) 1 0)))))
  (defn scr4-any-text (texts patterns)
    (if (eq (len patterns) 0) 0
      (if (eq (scr4-any-source texts (head patterns)) 1) 1
        (scr4-any-text texts (tail patterns)))))
  (defn scr4-any-source (texts pattern)
    (if (eq (len texts) 0) 0
      (if (eq (scr4-has (head texts) pattern) 1) 1
        (scr4-any-source (tail texts) pattern))))
  (defn scr4-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (scr4-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))

  (let bible-dir "corpus/sources/bible-web/")
  (let sanskrit-dir "corpus/sources/sanskrit-sarit/")
  (let bible-total (scr4-source-count (host_dir_list bible-dir) 1 0))
  (let sanskrit-total (scr4-source-count (host_dir_list sanskrit-dir) 2 0))
  (let bible-paths (list
    "corpus/sources/bible-web/09-RUTengwebp.usfm"
    "corpus/sources/bible-web/20-PSAengwebp.usfm"
    "corpus/sources/bible-web/21-PROengwebp.usfm"
    "corpus/sources/bible-web/73-JHNengwebp.usfm"
    "corpus/sources/bible-web/89-JASengwebp.usfm"
    "corpus/sources/bible-web/02-GENengwebp.usfm"
    "corpus/sources/bible-web/03-EXOengwebp.usfm"
    "corpus/sources/bible-web/24-ISAengwebp.usfm"
    "corpus/sources/bible-web/70-MATengwebp.usfm"
    "corpus/sources/bible-web/75-ROMengwebp.usfm"))
  (let sanskrit-paths (list
    "corpus/sources/sanskrit-sarit/astavakragita.xml"
    "corpus/sources/sanskrit-sarit/patanjalayogasastra.xml"
    "corpus/sources/sanskrit-sarit/mahabharata-devanagari.xml"))
  (let bible-admitted (scr4-present-loop bible-paths 0))
  (let sanskrit-admitted (scr4-present-loop sanskrit-paths 0))
  (let bible-bp (div (mul bible-admitted 10000) bible-total))
  (let sanskrit-bp (div (mul sanskrit-admitted 10000) sanskrit-total))

  ; New evidence is evaluated, rather than admitted merely because a file exists.
  (let new-texts (list
    (read_file "corpus/sources/bible-web/02-GENengwebp.usfm")
    (read_file "corpus/sources/bible-web/03-EXOengwebp.usfm")
    (read_file "corpus/sources/bible-web/24-ISAengwebp.usfm")
    (read_file "corpus/sources/bible-web/70-MATengwebp.usfm")
    (read_file "corpus/sources/bible-web/75-ROMengwebp.usfm")
    (read_file "corpus/sources/sanskrit-sarit/mahabharata-devanagari.xml")))
  (let trust (scr4-any-text new-texts (list "trust" "faith" "विश्वास" "श्रद्धा")))
  (let knowing (scr4-any-text new-texts (list "know" "wisdom" "ज्ञान")))
  (let witness (scr4-any-text new-texts (list "witness" "testimony" "साक्ष")))
  (let time (scr4-any-text new-texts (list "time" "काल")))
  (let self (scr4-any-text new-texts (list "self" "आत्म")))
  (let supported (add trust (add knowing (add witness (add time self)))))
  (let state (str_concat "scripture-coverage-v4\n"
    (str_concat "bible=" (str_concat (scr4-int bible-admitted)
    (str_concat "/" (str_concat (scr4-int bible-total)
    (str_concat "\nsanskrit=" (str_concat (scr4-int sanskrit-admitted)
    (str_concat "/" (str_concat (scr4-int sanskrit-total)
    (str_concat "\nconcept-support=" (str_concat (scr4-int supported) "\n"))))))))))))
  (let saved (write_file ".form-scripture-coverage-v4.state" state))
  (let success (if (eq (scg-ready) 1) (if (eq bible-total 66)
    (if (eq sanskrit-total 3)
      (if (eq supported 5) (if (gt saved 0) 1 0) 0) 0) 0) 0))
  ; [nothing, rejected/opposed, supported, observation-node,
  ;  Bible admitted/total/basis-points, Sanskrit admitted/total/basis-points,
  ;  newly supported concepts, admitted bytes Bible/Sanskrit, saved, success]
  (list (nothing) 0 1 4001
    bible-admitted bible-total bible-bp
    sanskrit-admitted sanskrit-total sanskrit-bp
    supported (scr4-size-loop bible-paths 0) (scr4-size-loop sanskrit-paths 0)
    saved success))
