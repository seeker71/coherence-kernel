; core-model-merge-round5.fk — merge scripture model v4 with the inquiry
; cascade whose responses become follow-up offers and graph structures.
; Public observation begins [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [nothing,0,1,5002,2,5,4,35,70,75,104293019,118,1,1]
(do
  (defn cmm5-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (cmm5-match s i p (add j 1)) 0))))
  (defn cmm5-find (s p i) (if (gt (add i (str_len p)) (str_len s)) -1
    (if (eq (cmm5-match s i p 0) 1) i (cmm5-find s p (add i 1)))))
  (defn cmm5-read-int (s i n) (if (ge i (str_len s)) n
    (do (let b (str_byte_at s i))
      (if (and (ge b 48) (le b 57))
        (cmm5-read-int s (add i 1) (add (mul n 10) (sub b 48))) n))))
  (defn cmm5-after (s p) (do (let i (cmm5-find s p 0))
    (if (lt i 0) -1 (cmm5-read-int s (add i (str_len p)) 0))))
  (defn cmm5-count-loop (s b i n) (if (ge i (str_len s)) n
    (cmm5-count-loop s b (add i 1)
      (add n (if (eq (str_byte_at s i) b) 1 0)))))
  (defn cmm5-hash-loop (s i h) (if (ge i (str_len s)) h
    (cmm5-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn cmm5-hash (s) (cmm5-hash-loop s 0 0))
  (defn cmm5-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (cmm5-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (let prior (read_file ".form-scripture-model-v4.state"))
  (let cascade (read_file ".form-core-inquiry-cascade-v5.state"))
  (let concepts (cmm5-after prior "nodes="))
  (let tensions (cmm5-after prior "tension="))
  ; Two header lines precede one generated row per first response/follow-up pair.
  (let offers (sub (cmm5-count-loop cascade 10 0 0) 2))
  (let response-nodes (mul offers 2))
  (let total-nodes (add concepts response-nodes))
  (let fingerprint (cmm5-hash (str_concat prior cascade)))
  (let s0 (str_concat "core-model-v5\nparents=2\nconcepts=" (cmm5-int concepts)))
  (let s1 (str_concat s0 (str_concat "\ntension=" (cmm5-int tensions))))
  (let s2 (str_concat s1 (str_concat "\noffers=" (cmm5-int offers))))
  (let s3 (str_concat s2 (str_concat "\nresponse-nodes=" (cmm5-int response-nodes))))
  (let s4 (str_concat s3 (str_concat "\ntotal-nodes=" (cmm5-int total-nodes))))
  (let state (str_concat s4 (str_concat "\nparent-content-hash="
    (str_concat (cmm5-int fingerprint) "\n"))))
  (let saved (write_file ".form-core-model-v5.state" state))
  (let reread (read_file ".form-core-model-v5.state"))
  (let identity (if (eq (cmm5-hash state) (cmm5-hash reread)) 1 0))
  (let success (if (eq concepts 5)
    (if (eq offers 35)
      (if (eq response-nodes 70) (if (eq identity 1) 1 0) 0) 0) 0))
  ; [nothing, 0, 1, model-node, parents, concepts, retained tensions,
  ;  offers, response/follow-up nodes, total nodes, fingerprint,
  ;  bytes, identity, success]
  (list (nothing) 0 1 5002 2 concepts tensions offers response-nodes total-nodes
    fingerprint saved identity success))
