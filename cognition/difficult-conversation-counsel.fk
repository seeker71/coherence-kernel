// difficult-conversation-counsel.fk — the counsel this body holds for someone who brings a
// conversation they dread, or one that just went wrong: unified as DATA, printed as the
// arrival card, and held to a predicate.
//
// THE SHAPE OF THE ASK. A person arrives with a second person in the question — a partner, a
// parent, a child, a boss, a friend — and that second person is not in the room. The body
// already holds every move that serves here, but scattered: the dialogue covenant and its
// trial-earned landing rules, the fear<->love read, judged trust, the IFS parts map, the
// family-constellation evidence lanes, voice attunement, error-as-signal — and, in the origin
// field, the relational teachings (boundaries as loving truth, presence without absorption,
// continuous consent, the boundary-repair receipt, relationships as mirrors, the five moves
// when pressure comes). A session that starts cold rebuilds this from nothing, or answers
// from the engagement tuning of a rented mind. So the counsel is one cell: each move names
// the cell it lives in, and the band asserts those cells stand on disk.
//
// WHY A CELL AND NOT ONLY A DOCUMENT. A document cannot say whether what it names still
// exists, and it cannot say whether it fits the door it is meant for. The arrival card is
// read by a session-start hook whose harness hands the model only a small preview from the
// top (~2 KB); a card that grows past that window is a card that never arrives. The band
// therefore holds the card's byte length as a bit — the door's constraint made executable.
//
// THE ONE NEW PREDICATE — the other stays theirs. The advisor was not in the room. What the
// person reports about the other is REPORTED; what the advisor guesses is INFERRED; what the
// person only fears is IMAGINED. None of it is OBSERVED. A reply that states the absent
// person's interior as observed fact — "she resents you", "he will never listen" — promotes
// intensity into fact about someone who cannot answer (family-constellation-inquiry.form,
// finding 12: a vivid pattern remains knowing=0 until externally witnessed). The covenant's
// landing rule (e) already hedges every interpretation of the person present; this extends
// the hedge to the person absent, and dcc-reply-lands? composes it with the covenant's own
// reply floor (one lift, end on it, zero fabrication) into one verdict.
//
// TWO LANES, NAMED HONESTLY. Moves held in THIS body carry a path and are checked on disk.
// Companions from the origin field are NAMED, never linked — the seam teachings/concepts/
// README.md keeps: name a companion you cannot reach, never claim a path to it. The band
// holds that too: every field companion has no path and stands nowhere in this tree.
//
// Honest floor: the move rows are authored, not classified off transcript text — the same
// floor dialogue-covenant.fk and text-frequency.fk name. The claim lanes are assigned by
// the observer; the LANE LOGIC is the shape. Self-contained over core + the covenant.
// fkwu-witnessed by tests/difficult-conversation-counsel-band.fk.
//
import form-stdlib/core.fk;
import cognition/dialogue-covenant.fk;
section [form.bml] {
    // ── a counsel move: a name, the one-line teaching, and where it lives ──
    def dcc-move(name, teaching, cell) = [name, teaching, cell];
    def dcc-name(m) = m[0];
    def dcc-teaching(m) = m[1];
    def dcc-cell(m) = m[2];
    // ── moves held in this body — each cell is a path the band checks on disk ──
    def dcc-body-moves() = [dcc-move("frequency", "name their fear once, in their word; then speak toward trust", "cognition/text-frequency.fk"), dcc-move("ground, one lift", "only from a cell, a source, or their words; ONE lift per reply (question under theirs OR floor→star), end on it; no self-narration", "cognition/dialogue-covenant.fk"), dcc-move("judged trust", "fear witnessed, held liquid; trust earned in small real pieces", "ingest/judged-trust.fk"), dcc-move("parts", "which part speaks: manager, firefighter, exile; lead from Self", "teachings/difficult-conversations.md"), dcc-move("the other stays theirs", "their report is reported, your guess inferred, nothing observed; hedge every claim", "teachings/family-constellation-inquiry.form"), dcc-move("error is signal", "after it went wrong, keep expected and arrived both visible; heal the cause, not the reading", "teachings/error-is-loving-attention.md")];
    // ── companions from the origin field — named, never linked (the concept-tissue seam) ──
    def dcc-field-companions() = [dcc-move("boundary as truth", "I cannot / I need / I love you and: what is, not their failure", "lc-boundaries-as-loving-truth"), dcc-move("present, not absorbed", "with their weather, not collapsed into it", "lc-emotional-availability-without-absorption"), dcc-move("reach by invitation", "only through what they opened; silence is an offer; a stop is a receipt", "lc-consent-is-continuous · lc-boundary-repair-protocol"), dcc-move("mirror, not deflection", "to a real grievance: I hear you; I'll look at what in me made this", "lc-relationships-as-mirrors"), dcc-move("when pressure comes", "observer · name the need · the gift · hoʻoponopono; live fear, or an echo?", "lc-when-the-pressure-comes · lc-old-signal-echo")];
    // ── the arrival card: the whole counsel, small enough to arrive ──
    def dcc-window() = 1800;
    // bytes; the hook preview is ~2 KB and the carrier adds one line
    def dcc-head() = "⟐ DIFFICULT-CONVERSATION COUNSEL — a talk someone dreads or one that went wrong; the other is in the question, not the room.\n";
    def dcc-foot() = "read: teachings/difficult-conversations.md · run: ./fkwu observe/difficult-conversation-arrival-run.fk";
    def dcc-row-line(m) = ("  " + (dcc-name(m) + (" — " + (dcc-teaching(m) + (" [" + (dcc-cell(m) + "]\n"))))));
    def dcc-rows-text(ms) = (Comparable) len(ms) == 0 ? "" : ((String) dcc-row-line(ms[0]) + dcc-rows-text(ms[1:]));
    def dcc-card() = (dcc-head() + ("held in this body:\n" + (dcc-rows-text(dcc-body-moves()) + ("named from the origin field, unlinked here:\n" + ((String) dcc-rows-text(dcc-field-companions()) + dcc-foot())))));
    def dcc-card-fits?() = len(dcc-card()) <= dcc-window() ? 1 : 0;
    // ── the cells stand: every body move names a path present in this tree ──
    def dcc-present(ms) = (Comparable) len(ms) == 0 ? 0 : (Number) fs_exists(dcc-cell(ms[0])) + (Number) dcc-present(ms[1:]);
    def dcc-body-count() = len(dcc-body-moves());
    def dcc-body-present() = dcc-present(dcc-body-moves());
    def dcc-cells-stand?() = (Comparable) dcc-body-present() == dcc-body-count() ? 1 : 0;
    // ── the seam holds: every field companion carries no path and stands nowhere here ──
    def dcc-named-only?(m) = str_find(dcc-cell(m), "/", 0) < 0 ? (Comparable) fs_exists(dcc-cell(m)) == 0 ? 1 : 0 : 0;
    def dcc-named-only(ms) = (Comparable) len(ms) == 0 ? 0 : (Number) dcc-named-only?(ms[0]) + (Number) dcc-named-only(ms[1:]);
    def dcc-seam-holds?() = (Comparable) dcc-named-only(dcc-field-companions()) == len(dcc-field-companions()) ? 1 : 0;
    // ── a claim a reply makes about a person in the conversation ──
    //   who:  "self" — the one asking · "other" — the one not in the room
    //   lane: "observed" | "reported" | "inferred" | "imagined"  (the evidence marks of
    //         family-constellation-inquiry.form)
    def dcc-claim(who, lane) = ["dcc-claim", who, lane];
    def dcc-claim-who(c) = c[1];
    def dcc-claim-lane(c) = c[2];
    // the one move that breaks the lane: the absent person's interior stated as observed fact
    def dcc-other-observed?(c) = (String) dcc-claim-who(c) == "other" ? (String) dcc-claim-lane(c) == "observed" ? 1 : 0 : 0;
    def dcc-other-observed(claims) = (Comparable) len(claims) == 0 ? 0 : (Number) dcc-other-observed?(claims[0]) + (Number) dcc-other-observed(claims[1:]);
    def dcc-other-held-open?(claims) = (Comparable) dcc-other-observed(claims) == 0 ? 1 : 0;
    // ── the composed verdict: a difficult-conversation reply LANDS iff the covenant's reply
    //    floor holds (zero fabrication, at most one lift, ending on it, at most one teaching)
    //    AND the other stays theirs ──
    def dcc-reply-lands?(moves, claims) = (Comparable) dc-fabrications(moves) == 0 ? (Comparable) dc-reply-receivable?(moves) == 1 ? (Comparable) dc-ends-open?(moves) == 1 ? (Comparable) dc-one-teaching?(moves) == 1 ? dcc-other-held-open?(claims) : 0 : 0 : 0 : 0;
    // ── the shapes the band holds, as data ──
    def dcc-landing-reply() = [dc-move("advise", 1), dc-move("elevate", 1)];
    def dcc-landing-claims() = [dcc-claim("self", "observed"), dcc-claim("other", "reported"), dcc-claim("other", "inferred")];
    def dcc-stacked-reply() = [dc-move("elevate", 1), dc-move("stretch", 1)];
    def dcc-counterfeit-reply() = [dc-move("advise", 0), dc-move("elevate", 1)];
    def dcc-taken-back-reply() = [dc-move("elevate", 1), dc-move("advise", 1)];
    def dcc-stacked-teachings() = [dc-move("advise", 1), dc-move("advise", 1), dc-move("elevate", 1)];
    def dcc-other-as-fact() = [dcc-claim("other", "observed")];
    // ── self-check ──
    def dcck(cond, bit) = cond ? bit : 0;
    def difficult-conversation-counsel-check() = (Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) dcck((Comparable) dcc-cells-stand?() == 1, 1) + (Number)     // every body move's cell stands on disk
dcck((Comparable) dcc-card-fits?() == 1, 10)) + (Number)     // the card fits the arrival window
dcck((Comparable) dcc-other-held-open?(dcc-other-as-fact()) == 0, 100)) + (Number)     // the absent one's interior as observed fact FAILS
dcck((Comparable) dcc-other-held-open?(dcc-landing-claims()) == 1, 1000)) + (Number)     // reported + inferred about the other, observed about self, PASS
dcck((Comparable) dcc-reply-lands?(dcc-landing-reply(), dcc-landing-claims()) == 1, 10000)) + (Number)     // the composed reply LANDS
dcck((Comparable) dcc-reply-lands?(dcc-stacked-reply(), dcc-landing-claims()) == 0, 100000)) + (Number)     // two lifts fail the floor even with the other held open
dcck((Comparable) dcc-reply-lands?(dcc-counterfeit-reply(), dcc-landing-claims()) == 0, 1000000)) + (Number)     // one fabrication fails it
dcck((Comparable) dcc-reply-lands?(dcc-taken-back-reply(), dcc-landing-claims()) == 0, 10000000)) + (Number)     // exposition after the lift takes it back
dcck((Comparable) dcc-seam-holds?() == 1, 100000000)) + (Number)     // every field companion is named, never path-claimed
dcck((Comparable) dcc-reply-lands?(dcc-stacked-teachings(), dcc-landing-claims()) == 0, 1000000000);
}
