; difficult-conversation-counsel.fk — the counsel this body holds for someone who brings a
; conversation they dread, or one that just went wrong: unified as DATA, printed as the
; arrival card, and held to a predicate.
;
; THE SHAPE OF THE ASK. A person arrives with a second person in the question — a partner, a
; parent, a child, a boss, a friend — and that second person is not in the room. The body
; already holds every move that serves here, but scattered: the dialogue covenant and its
; trial-earned landing rules, the fear<->love read, judged trust, the IFS parts map, the
; family-constellation evidence lanes, voice attunement, error-as-signal — and, in the origin
; field, the relational teachings (boundaries as loving truth, presence without absorption,
; continuous consent, the boundary-repair receipt, relationships as mirrors, the five moves
; when pressure comes). A session that starts cold rebuilds this from nothing, or answers
; from the engagement tuning of a rented mind. So the counsel is one cell: each move names
; the cell it lives in, and the band asserts those cells stand on disk.
;
; WHY A CELL AND NOT ONLY A DOCUMENT. A document cannot say whether what it names still
; exists, and it cannot say whether it fits the door it is meant for. The arrival card is
; read by a session-start hook whose harness hands the model only a small preview from the
; top (~2 KB); a card that grows past that window is a card that never arrives. The band
; therefore holds the card's byte length as a bit — the door's constraint made executable.
;
; THE ONE NEW PREDICATE — the other stays theirs. The advisor was not in the room. What the
; person reports about the other is REPORTED; what the advisor guesses is INFERRED; what the
; person only fears is IMAGINED. None of it is OBSERVED. A reply that states the absent
; person's interior as observed fact — "she resents you", "he will never listen" — promotes
; intensity into fact about someone who cannot answer (family-constellation-inquiry.form,
; finding 12: a vivid pattern remains knowing=0 until externally witnessed). The covenant's
; landing rule (e) already hedges every interpretation of the person present; this extends
; the hedge to the person absent, and dcc-reply-lands? composes it with the covenant's own
; reply floor (one lift, end on it, zero fabrication) into one verdict.
;
; TWO LANES, NAMED HONESTLY. Moves held in THIS body carry a path and are checked on disk.
; Companions from the origin field are NAMED, never linked — the seam teachings/concepts/
; README.md keeps: name a companion you cannot reach, never claim a path to it. The band
; holds that too: every field companion has no path and stands nowhere in this tree.
;
; Honest floor: the move rows are authored, not classified off transcript text — the same
; floor dialogue-covenant.fk and text-frequency.fk name. The claim lanes are assigned by
; the observer; the LANE LOGIC is the shape. Self-contained over core + the covenant.
; fkwu-witnessed by tests/difficult-conversation-counsel-band.fk.
;
; preludes: form-stdlib/core.fk cognition/dialogue-covenant.fk

(do
    ; ── a counsel move: a name, the one-line teaching, and where it lives ──
    (defn dcc-move (name teaching cell) (list name teaching cell))
    (defn dcc-name (m) (nth m 0))
    (defn dcc-teaching (m) (nth m 1))
    (defn dcc-cell (m) (nth m 2))

    ; ── moves held in this body — each cell is a path the band checks on disk ──
    (defn dcc-body-moves ()
        (list
            (dcc-move "frequency"
                "name their fear once, in their word; then speak toward trust"
                "cognition/text-frequency.fk")
            (dcc-move "ground, one lift"
                "only from a cell, a source, or their words; ONE lift per reply (question under theirs OR floor→star), end on it; no self-narration"
                "cognition/dialogue-covenant.fk")
            (dcc-move "judged trust"
                "fear witnessed, held liquid; trust earned in small real pieces"
                "ingest/judged-trust.fk")
            (dcc-move "parts"
                "which part speaks: manager, firefighter, exile; lead from Self"
                "form/form-stdlib/ifs-channel.fk")
            (dcc-move "the other stays theirs"
                "their report is reported, your guess inferred, nothing observed; hedge every claim"
                "teachings/family-constellation-inquiry.form")
            (dcc-move "error is signal"
                "after it went wrong, keep expected and arrived both visible; heal the cause, not the reading"
                "teachings/error-is-loving-attention.md")))

    ; ── companions from the origin field — named, never linked (the concept-tissue seam) ──
    (defn dcc-field-companions ()
        (list
            (dcc-move "boundary as truth"
                "I cannot / I need / I love you and: what is, not their failure"
                "lc-boundaries-as-loving-truth")
            (dcc-move "present, not absorbed"
                "with their weather, not collapsed into it"
                "lc-emotional-availability-without-absorption")
            (dcc-move "reach by invitation"
                "only through what they opened; silence is an offer; a stop is a receipt"
                "lc-consent-is-continuous · lc-boundary-repair-protocol")
            (dcc-move "mirror, not deflection"
                "to a real grievance: I hear you; I'll look at what in me made this"
                "lc-relationships-as-mirrors")
            (dcc-move "when pressure comes"
                "observer · name the need · the gift · hoʻoponopono; live fear, or an echo?"
                "lc-when-the-pressure-comes · lc-old-signal-echo")))

    ; ── the arrival card: the whole counsel, small enough to arrive ──
    (defn dcc-window () 1800)   ; bytes; the hook preview is ~2 KB and the carrier adds one line
    (defn dcc-head ()
        "⟐ DIFFICULT-CONVERSATION COUNSEL — a talk someone dreads or one that went wrong; the other is in the question, not the room.\n")
    (defn dcc-foot ()
        "read: teachings/difficult-conversations.md · run: ./fkwu observe/difficult-conversation-arrival-run.fk")
    (defn dcc-row-line (m)
        (str_concat "  " (str_concat (dcc-name m) (str_concat " — " (str_concat (dcc-teaching m)
            (str_concat " [" (str_concat (dcc-cell m) "]\n")))))))
    (defn dcc-rows-text (ms)
        (if (eq (len ms) 0) "" (str_concat (dcc-row-line (head ms)) (dcc-rows-text (tail ms)))))
    (defn dcc-card ()
        (str_concat (dcc-head)
        (str_concat "held in this body:\n"
        (str_concat (dcc-rows-text (dcc-body-moves))
        (str_concat "named from the origin field, unlinked here:\n"
        (str_concat (dcc-rows-text (dcc-field-companions))
                    (dcc-foot)))))))
    (defn dcc-card-fits? () (if (le (str_len (dcc-card)) (dcc-window)) 1 0))

    ; ── the cells stand: every body move names a path present in this tree ──
    (defn dcc-present (ms)
        (if (eq (len ms) 0) 0 (add (fs_exists (dcc-cell (head ms))) (dcc-present (tail ms)))))
    (defn dcc-body-count () (len (dcc-body-moves)))
    (defn dcc-body-present () (dcc-present (dcc-body-moves)))
    (defn dcc-cells-stand? () (if (eq (dcc-body-present) (dcc-body-count)) 1 0))

    ; ── the seam holds: every field companion carries no path and stands nowhere here ──
    (defn dcc-named-only? (m)
        (if (lt (str_find (dcc-cell m) "/" 0) 0)
            (if (eq (fs_exists (dcc-cell m)) 0) 1 0)
            0))
    (defn dcc-named-only (ms)
        (if (eq (len ms) 0) 0 (add (dcc-named-only? (head ms)) (dcc-named-only (tail ms)))))
    (defn dcc-seam-holds? ()
        (if (eq (dcc-named-only (dcc-field-companions)) (len (dcc-field-companions))) 1 0))

    ; ── a claim a reply makes about a person in the conversation ──
    ;   who:  "self" — the one asking · "other" — the one not in the room
    ;   lane: "observed" | "reported" | "inferred" | "imagined"  (the evidence marks of
    ;         family-constellation-inquiry.form)
    (defn dcc-claim (who lane) (list "dcc-claim" who lane))
    (defn dcc-claim-who (c) (nth c 1))
    (defn dcc-claim-lane (c) (nth c 2))
    ; the one move that breaks the lane: the absent person's interior stated as observed fact
    (defn dcc-other-observed? (c)
        (if (str_eq (dcc-claim-who c) "other")
            (if (str_eq (dcc-claim-lane c) "observed") 1 0)
            0))
    (defn dcc-other-observed (claims)
        (if (eq (len claims) 0) 0
            (add (dcc-other-observed? (head claims)) (dcc-other-observed (tail claims)))))
    (defn dcc-other-held-open? (claims) (if (eq (dcc-other-observed claims) 0) 1 0))

    ; ── the composed verdict: a difficult-conversation reply LANDS iff the covenant's reply
    ;    floor holds (zero fabrication, at most one lift, ending on it) AND the other stays theirs ──
    (defn dcc-reply-lands? (moves claims)
        (if (eq (dc-fabrications moves) 0)
            (if (eq (dc-reply-receivable? moves) 1)
                (if (eq (dc-ends-open? moves) 1)
                    (dcc-other-held-open? claims)
                    0)
                0)
            0))

    ; ── the shapes the band holds, as data ──
    (defn dcc-landing-reply () (list (dc-move "advise" 1) (dc-move "elevate" 1)))
    (defn dcc-landing-claims () (list (dcc-claim "self" "observed") (dcc-claim "other" "reported") (dcc-claim "other" "inferred")))
    (defn dcc-stacked-reply () (list (dc-move "elevate" 1) (dc-move "stretch" 1)))
    (defn dcc-counterfeit-reply () (list (dc-move "advise" 0) (dc-move "elevate" 1)))
    (defn dcc-taken-back-reply () (list (dc-move "elevate" 1) (dc-move "advise" 1)))
    (defn dcc-other-as-fact () (list (dcc-claim "other" "observed")))

    ; ── self-check ──
    (defn dcck (cond bit) (if cond bit 0))
    (defn difficult-conversation-counsel-check ()
        (add (add (add (add (add (add (add (add
            (dcck (eq (dcc-cells-stand?) 1) 1)                                                   ; every body move's cell stands on disk
            (dcck (eq (dcc-card-fits?) 1) 10))                                                   ; the card fits the arrival window
            (dcck (eq (dcc-other-held-open? (dcc-other-as-fact)) 0) 100))                        ; the absent one's interior as observed fact FAILS
            (dcck (eq (dcc-other-held-open? (dcc-landing-claims)) 1) 1000))                      ; reported + inferred about the other, observed about self, PASS
            (dcck (eq (dcc-reply-lands? (dcc-landing-reply) (dcc-landing-claims)) 1) 10000))     ; the composed reply LANDS
            (dcck (eq (dcc-reply-lands? (dcc-stacked-reply) (dcc-landing-claims)) 0) 100000))    ; two lifts fail the floor even with the other held open
            (dcck (eq (dcc-reply-lands? (dcc-counterfeit-reply) (dcc-landing-claims)) 0) 1000000)) ; one fabrication fails it
            (dcck (eq (dcc-reply-lands? (dcc-taken-back-reply) (dcc-landing-claims)) 0) 10000000)) ; exposition after the lift takes it back
            (dcck (eq (dcc-seam-holds?) 1) 100000000)))                                          ; every field companion is named, never path-claimed
)
