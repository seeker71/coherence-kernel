; jung-neutral-kernel.fk — C. G. Jung's structural fundamentals as one
; surface-independent meaning graph.
;
; Shape borrowed unchanged from cognition/steiner-neutral-kernel.fk: a teaching
; is a set of numeric facts
;
;   [subject-node, relation-node, object-node, evidence-node, order]
;
; and English and German are registered NL projections. German is here for the
; same reason it is there: Jung wrote in German, so the English is a projection
; of the meaning and never the original. Coordinate space (package 3, level 46)
; — (3,36)..(3,45) were already taken, and 45 is Steiner. THE LEVELS ARE THE
; POINT: see the Ich law below.
;
; ── THE ICH LAW, and it is why this cell exists as its OWN level ────────────
; Steiner's Ich and Jung's Ich share a German string and almost nothing else.
; Steiner's is the fourth member of the human being beside physischer Leib,
; Aetherleib and Astralleib — a spiritual individuality. Jung's is, verbatim in
; the 1921 first edition, "bloss ein Komplex unter andern Komplexen": the centre
; of the field of consciousness, explicitly NOT the whole psyche. A graph that
; registered "Ich" once and hung both evidences on it would have already made
; the error the whole comparison exists to prevent. So Jung's Ich is
; (3,46,2,1), Steiner's is its own node at level 45, and no query can reach both
; through one identity. cognition/depth-query-lanes.fk is the organ that reads
; across the two levels without merging them.
;
; ── WHAT THIS CELL REFUSES TO CARRY ────────────────────────────────────────
; There is no list of named archetypes here, and there must never be one. CW 9i
; §155 makes the archetype "empty and purely formal, nothing but a facultas
; praeformandi" — a capacity to form, inherited in FORM only and never in
; content. A node called "the Hero archetype" would contradict the definition it
; claims to implement. What the graph carries instead is the TYPE DISTINCTION:
; archetype-as-such gives rise to archetypal image. jnk-named-archetypes answers
; the empty list on purpose, and jnk-refuses-enumeration? says so out loud.
;
; ── SOURCING ───────────────────────────────────────────────────────────────
; Grounded 2026-08-28 against the 1921 first edition of Psychologische Typen
; read verbatim (Project Gutenberg #61543) plus the C.G. Jung-Museum
; Schriftenverzeichnis for GW dating. Two facts from that reading shape the
; graph and are worth carrying in the header:
;   - Def. 50 "Selbst" in 1921 has NO text of its own. It reads only
;     "(Siehe Ich.)" — the Self is defined, from the start, as a relation to the
;     ego. The graph therefore states selbst CONTAINS ich rather than giving
;     selbst an independent definition it did not have.
;   - "Schatten" has no definition entry in 1921 at all. It becomes a formal
;     structural term later, and Aion (1951) gives it its own chapter. Its
;     evidence node is Aion, never Typen.
; Definition NUMBERS are deliberately absent from every identity: Jung ordered
; the Definitionen alphabetically, so the same definition carries different
; numbers in German and English. A number that changes with the surface is a
; surface artifact and cannot be an identity.
;
; INTENTIONALLY LOSSY. This is the structural kernel — the members, the
; functions, their groups and oppositions, the process terms — not the clinical
; work, not the alchemical symbolism, not the case material.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk
;
; Proven by: cognition/tests/jung-neutral-band.fk

(do
  (defn jnk-node (type instance) (lnsi-node 3 46 type instance))
  (defn jnk-level () 46)

  (defn jnk-t-concept  () 1)
  (defn jnk-t-member   () 2)
  (defn jnk-t-function () 3)
  (defn jnk-t-group    () 4)
  (defn jnk-t-relation () 5)
  (defn jnk-t-work     () 6)

  ;; ── concepts ────────────────────────────────────────────────────
  (defn jnk-structure     () (jnk-node (jnk-t-concept) 1))
  (defn jnk-typology      () (jnk-node (jnk-t-concept) 2))
  (defn jnk-individuation () (jnk-node (jnk-t-concept) 3))
  (defn jnk-opposites     () (jnk-node (jnk-t-concept) 4))
  (defn jnk-synchronicity () (jnk-node (jnk-t-concept) 5))

  ;; ── members of the psyche ───────────────────────────────────────
  (defn jnk-ich              () (jnk-node (jnk-t-member) 1))
  (defn jnk-selbst           () (jnk-node (jnk-t-member) 2))
  (defn jnk-persona          () (jnk-node (jnk-t-member) 3))
  (defn jnk-anima            () (jnk-node (jnk-t-member) 4))
  (defn jnk-animus           () (jnk-node (jnk-t-member) 5))
  (defn jnk-seelenbild       () (jnk-node (jnk-t-member) 6))
  (defn jnk-schatten         () (jnk-node (jnk-t-member) 7))
  (defn jnk-komplex          () (jnk-node (jnk-t-member) 8))
  (defn jnk-personal-unc     () (jnk-node (jnk-t-member) 9))
  (defn jnk-collective-unc   () (jnk-node (jnk-t-member) 10))
  (defn jnk-archetype-as-such () (jnk-node (jnk-t-member) 11))
  (defn jnk-archetypal-image  () (jnk-node (jnk-t-member) 12))
  (defn jnk-inflation        () (jnk-node (jnk-t-member) 13))
  (defn jnk-transcendent-fn  () (jnk-node (jnk-t-member) 14))

  ;; ── the four functions and the two attitudes ────────────────────
  (defn jnk-denken       () (jnk-node (jnk-t-function) 1))
  (defn jnk-fuehlen      () (jnk-node (jnk-t-function) 2))
  (defn jnk-empfinden    () (jnk-node (jnk-t-function) 3))
  (defn jnk-intuition    () (jnk-node (jnk-t-function) 4))
  (defn jnk-introversion () (jnk-node (jnk-t-function) 5))
  (defn jnk-extraversion () (jnk-node (jnk-t-function) 6))

  ;; ── groups. rational/irrational is Jung's own grouping and is
  ;; INDEPENDENT of the introversion/extraversion axis. ────────────
  (defn jnk-g-rational   () (jnk-node (jnk-t-group) 1))
  (defn jnk-g-irrational () (jnk-node (jnk-t-group) 2))
  (defn jnk-g-attitude   () (jnk-node (jnk-t-group) 3))
  (defn jnk-g-function   () (jnk-node (jnk-t-group) 4))

  ;; ── relations ───────────────────────────────────────────────────
  (defn jnk-contains      () (jnk-node (jnk-t-relation) 1))
  (defn jnk-is-a          () (jnk-node (jnk-t-relation) 2))
  (defn jnk-mirrors       () (jnk-node (jnk-t-relation) 3))
  (defn jnk-compensates   () (jnk-node (jnk-t-relation) 4))
  (defn jnk-represents    () (jnk-node (jnk-t-relation) 5))
  (defn jnk-opposes       () (jnk-node (jnk-t-relation) 6))
  (defn jnk-superordinate () (jnk-node (jnk-t-relation) 7))
  (defn jnk-gives-rise-to () (jnk-node (jnk-t-relation) 8))
  (defn jnk-in-group      () (jnk-node (jnk-t-relation) 9))

  ;; ── works, as evidence nodes ────────────────────────────────────
  (defn jnk-w-assoziation  () (jnk-node (jnk-t-work) 1)) ; 1904-1911
  (defn jnk-w-transzendent () (jnk-node (jnk-t-work) 2)) ; written 1916
  (defn jnk-w-typen        () (jnk-node (jnk-t-work) 3)) ; 1921
  (defn jnk-w-beziehungen  () (jnk-node (jnk-t-work) 4)) ; 1928
  (defn jnk-w-alchemie     () (jnk-node (jnk-t-work) 5)) ; 1944
  (defn jnk-w-aion         () (jnk-node (jnk-t-work) 6)) ; 1951
  (defn jnk-w-synchro      () (jnk-node (jnk-t-work) 7)) ; 1952
  (defn jnk-w-mysterium    () (jnk-node (jnk-t-work) 8)) ; 1955-56

  (defn jnk-fact (s r o e n) (list s r o e n))
  (defn jnk-f-subject  (f) (nth f 0))
  (defn jnk-f-relation (f) (nth f 1))
  (defn jnk-f-object   (f) (nth f 2))
  (defn jnk-f-evidence (f) (nth f 3))
  (defn jnk-f-order    (f) (nth f 4))

  ;; ── the structure. The Self contains the ego and the ego is itself
  ;; a complex: those two together are the whole correction the graph
  ;; exists to hold against the popular picture. ──
  (defn jnk-structure-facts ()
    (list
      (jnk-fact (jnk-selbst) (jnk-contains) (jnk-ich) (jnk-w-typen) 1)
      (jnk-fact (jnk-ich) (jnk-is-a) (jnk-komplex) (jnk-w-typen) 2)
      (jnk-fact (jnk-persona) (jnk-mirrors) (jnk-anima) (jnk-w-typen) 3)
      (jnk-fact (jnk-anima) (jnk-compensates) (jnk-persona) (jnk-w-typen) 4)
      (jnk-fact (jnk-seelenbild) (jnk-represents) (jnk-anima) (jnk-w-typen) 5)
      (jnk-fact (jnk-anima) (jnk-mirrors) (jnk-animus) (jnk-w-aion) 6)
      (jnk-fact (jnk-personal-unc) (jnk-contains) (jnk-komplex)
        (jnk-w-beziehungen) 7)
      (jnk-fact (jnk-collective-unc) (jnk-contains) (jnk-archetype-as-such)
        (jnk-w-beziehungen) 8)
      (jnk-fact (jnk-archetype-as-such) (jnk-gives-rise-to)
        (jnk-archetypal-image) (jnk-w-aion) 9)
      (jnk-fact (jnk-komplex) (jnk-is-a) (jnk-personal-unc)
        (jnk-w-assoziation) 10)
      (jnk-fact (jnk-inflation) (jnk-opposes) (jnk-selbst)
        (jnk-w-beziehungen) 11)))

  ;; ── typology. Two axes, never a list of four types in a row:
  ;; judging {Denken, Fuehlen} and perceiving {Empfinden, Intuition},
  ;; with attitude superordinate to function. ──
  (defn jnk-type-facts ()
    (list
      (jnk-fact (jnk-denken) (jnk-in-group) (jnk-g-rational) (jnk-w-typen) 1)
      (jnk-fact (jnk-fuehlen) (jnk-in-group) (jnk-g-rational) (jnk-w-typen) 2)
      (jnk-fact (jnk-empfinden) (jnk-in-group) (jnk-g-irrational)
        (jnk-w-typen) 3)
      (jnk-fact (jnk-intuition) (jnk-in-group) (jnk-g-irrational)
        (jnk-w-typen) 4)
      (jnk-fact (jnk-denken) (jnk-opposes) (jnk-fuehlen) (jnk-w-typen) 5)
      (jnk-fact (jnk-empfinden) (jnk-opposes) (jnk-intuition) (jnk-w-typen) 6)
      (jnk-fact (jnk-introversion) (jnk-in-group) (jnk-g-attitude)
        (jnk-w-typen) 7)
      (jnk-fact (jnk-extraversion) (jnk-in-group) (jnk-g-attitude)
        (jnk-w-typen) 8)
      (jnk-fact (jnk-g-attitude) (jnk-superordinate) (jnk-g-function)
        (jnk-w-typen) 9)))

  ;; ── the process ─────────────────────────────────────────────────
  (defn jnk-process-facts ()
    (list
      (jnk-fact (jnk-individuation) (jnk-gives-rise-to) (jnk-selbst)
        (jnk-w-beziehungen) 1)
      (jnk-fact (jnk-transcendent-fn) (jnk-mirrors) (jnk-opposites)
        (jnk-w-transzendent) 2)
      (jnk-fact (jnk-opposites) (jnk-gives-rise-to) (jnk-transcendent-fn)
        (jnk-w-transzendent) 3)
      (jnk-fact (jnk-selbst) (jnk-in-group) (jnk-structure) (jnk-w-alchemie) 4)
      (jnk-fact (jnk-synchronicity) (jnk-opposes) (jnk-opposites)
        (jnk-w-synchro) 5)
      (jnk-fact (jnk-opposites) (jnk-contains) (jnk-schatten)
        (jnk-w-mysterium) 6)))

  ;; ── Aion's own late ordering of the structure: Das Ich, Der
  ;; Schatten, Die Syzygie, Das Selbst. Jung's sequence, not ours. ──
  (defn jnk-aion-order ()
    (list (jnk-ich) (jnk-schatten) (jnk-anima) (jnk-selbst)))
  (defn jnk-aion-order-count () 4)

  (defn jnk-app (a b) (if (eq (len a) 0) b (cons (head a) (jnk-app (tail a) b))))
  (defn jnk-facts ()
    (jnk-app (jnk-structure-facts)
      (jnk-app (jnk-type-facts) (jnk-process-facts))))
  (defn jnk-fact-count () (len (jnk-facts)))

  ;; ── THE REFUSAL. Named archetypes are not carried, by the
  ;; definition's own terms. This is a door that answers empty on
  ;; purpose, so a later reader finds the reason instead of the gap. ──
  (defn jnk-named-archetypes () (empty))
  (defn jnk-refuses-enumeration? () 1)
  (defn jnk-refusal-ground () "cw9i-155-facultas-praeformandi")

  ;; ── NL surfaces: en and de, registered per node. The identity is
  ;; the number; these are projections of it. The 1921 edition prints
  ;; "collektiv" with a c; the modern spelling is registered here and
  ;; the drift is recorded rather than silently normalised. ──
  (defn jnk-sur (node en de) (list node en de))
  (defn jnk-surfaces ()
    (list
      (jnk-sur (jnk-ich) "ego" "Ich")
      (jnk-sur (jnk-selbst) "self" "Selbst")
      (jnk-sur (jnk-persona) "persona" "Persona")
      (jnk-sur (jnk-anima) "anima" "Anima")
      (jnk-sur (jnk-animus) "animus" "Animus")
      (jnk-sur (jnk-seelenbild) "soul-image" "Seelenbild")
      (jnk-sur (jnk-schatten) "shadow" "Schatten")
      (jnk-sur (jnk-komplex) "complex" "Komplex")
      (jnk-sur (jnk-personal-unc) "personal-unconscious"
        "persoenliches Unbewusstes")
      (jnk-sur (jnk-collective-unc) "collective-unconscious"
        "kollektives Unbewusstes")
      (jnk-sur (jnk-archetype-as-such) "archetype-as-such"
        "Archetypus an sich")
      (jnk-sur (jnk-archetypal-image) "archetypal-image"
        "archetypisches Bild")
      (jnk-sur (jnk-inflation) "inflation" "Inflation")
      (jnk-sur (jnk-transcendent-fn) "transcendent-function"
        "transzendente Funktion")
      (jnk-sur (jnk-denken) "thinking" "Denken")
      (jnk-sur (jnk-fuehlen) "feeling" "Fuehlen")
      (jnk-sur (jnk-empfinden) "sensation" "Empfinden")
      (jnk-sur (jnk-intuition) "intuition" "Intuition")
      (jnk-sur (jnk-introversion) "introversion" "Introversion")
      (jnk-sur (jnk-extraversion) "extraversion" "Extraversion")
      (jnk-sur (jnk-individuation) "individuation" "Individuation")
      (jnk-sur (jnk-synchronicity) "synchronicity" "Synchronizitaet")
      (jnk-sur (jnk-opposites) "opposites" "Gegensaetze")
      (jnk-sur (jnk-g-rational) "rational" "rational")
      (jnk-sur (jnk-g-irrational) "irrational" "irrational")))
  (defn jnk-surface-count () (len (jnk-surfaces)))

  (defn jnk-sur-node (s) (nth s 0))
  (defn jnk-sur-en   (s) (nth s 1))
  (defn jnk-sur-de   (s) (nth s 2))

  ;; a locale outside the registered adapters answers nothing, so the
  ;; graph is ready for more without pretending any exist
  (defn jnk-project-row (s locale)
    (if (str_eq locale "en") (jnk-sur-en s)
      (if (str_eq locale "de") (jnk-sur-de s) (nothing))))
  (defn jnk-find-loop (ss node)
    (if (eq (len ss) 0) (nothing)
      (if (eq (jnk-sur-node (head ss)) node) (head ss)
        (jnk-find-loop (tail ss) node))))
  (defn jnk-project (node locale)
    (do (let row (jnk-find-loop (jnk-surfaces) node))
        (if (nothing? row) (nothing) (jnk-project-row row locale))))

  ;; lookup by surface, per locale — the door depth-query-lanes routes on
  (defn jnk-by-surface-loop (ss text locale)
    (if (eq (len ss) 0) (nothing)
      (do (let s (head ss))
          (let v (jnk-project-row s locale))
          (if (nothing? v) (jnk-by-surface-loop (tail ss) text locale)
            (if (str_eq v text) (jnk-sur-node s)
              (jnk-by-surface-loop (tail ss) text locale))))))
  (defn jnk-by-surface (text locale)
    (jnk-by-surface-loop (jnk-surfaces) text locale))

  ;; every fact is a well-formed 5-tuple whose parts all live at this level
  (defn jnk-level-of (node) (mod (div node 1000000) 1000))
  (defn jnk-wellformed-loop (fs)
    (if (eq (len fs) 0) 1
      (do (let f (head fs))
          (if (not (eq (len f) 5)) 0
            (if (not (eq (jnk-level-of (jnk-f-subject f)) (jnk-level))) 0
              (if (not (eq (jnk-level-of (jnk-f-relation f)) (jnk-level))) 0
                (if (not (eq (jnk-level-of (jnk-f-object f)) (jnk-level))) 0
                  (if (not (eq (jnk-level-of (jnk-f-evidence f)) (jnk-level))) 0
                    (jnk-wellformed-loop (tail fs))))))))))
  (defn jnk-wellformed? () (jnk-wellformed-loop (jnk-facts)))
  0)
