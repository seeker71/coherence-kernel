; form-neutral-word-field.fk — a semantic field for words, never an acoustic one.
;
; The field has thirteen form-neutral axes. English names are surfaces attached
; to the axes; the numeric axis positions and the definition recipes are the
; carrier-independent shape.  Values are per-mille affinities, not hertz, not
; moral scores, and not a claim that culture has one universal geometry.
;
; The first thirteen shapes are AUTHORED SEEDS.  Their definitions close over
; the small core lexicon.  They can be revised by adding a witnessed successor;
; no observation is manufactured from the coordinates themselves.
;
; A directed semantic wake is what remains when one shape moves through
; another: target-minus-source delta, adjacent-axis shear, alignment, distance,
; and expansion.  Shear is antisymmetric, so A -> B and B -> A retain direction.
; This is the requested liquid-turbulence analogy made executable without
; pretending that a word is a physical fluid or sound wave.
; witnessed: 2026-08-24 -> fwf 8191, combined field band 33554431
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/core-lexicon.fk

(do
    (defn fwf-axis-count () 13)
    (defn fwf-scale () 1000)
    (defn fwf-authored-seed () 1)

    ; seed = (neutral-id english-surface definition-tokens 13-axis-shape status)
    (defn fwf-seed (id surface desc shape status)
        (list id surface desc shape status))
    (defn fwf-id (seed) (nth seed 0))
    (defn fwf-surface (seed) (nth seed 1))
    (defn fwf-desc (seed) (nth seed 2))
    (defn fwf-shape (seed) (nth seed 3))
    (defn fwf-status (seed) (nth seed 4))

    ; Axis order is stable and neutral.  The English surfaces below are one
    ; rendering: love, harmony, vitality, clarify, awe, humor, excitement,
    ; trust, sovereignty, grace, flow, coherence, resonance.
    (defn fwf-seeds ()
        (list
            (fwf-seed 0 "love"
                (list "when" "a" "self" "know" "other" "as" "part" "of" "the" "whole"
                      "and" "want" "other" "to" "be" "more")
                (list 1000 820 840 680 780 720 700 920 820 940 780 880 900)
                (fwf-authored-seed))
            (fwf-seed 1 "harmony"
                (list "when" "many" "part" "do" "in" "a" "way" "that" "make" "the" "whole" "still" "be" "whole")
                (list 820 1000 760 760 680 740 580 860 760 940 880 980 940)
                (fwf-authored-seed))
            (fwf-seed 2 "vitality"
                (list "how" "a" "whole" "still" "do" "and" "be" "more")
                (list 800 760 1000 700 800 820 940 760 900 700 940 840 820)
                (fwf-authored-seed))
            (fwf-seed 3 "clarify"
                (list "make" "a" "self" "know" "this" "is" "the" "same" "thing" "and" "not" "other")
                (list 680 780 680 1000 700 560 640 900 900 780 740 960 780)
                (fwf-authored-seed))
            (fwf-seed 4 "awe"
                (list "when" "a" "self" "know" "a" "thing" "is" "more" "than" "what" "the" "self" "know" "before")
                (list 820 700 860 740 1000 760 900 760 720 880 800 820 900)
                (fwf-authored-seed))
            (fwf-seed 5 "humor"
                (list "when" "a" "self" "know" "an" "other" "way" "and" "this" "make" "the" "self" "want" "more")
                (list 800 760 900 680 800 1000 920 740 820 860 920 780 860)
                (fwf-authored-seed))
            (fwf-seed 6 "excitement"
                (list "when" "a" "self" "want" "to" "do" "now" "and" "be" "more")
                (list 740 640 980 700 920 920 1000 700 840 700 940 720 840)
                (fwf-authored-seed))
            (fwf-seed 7 "trust"
                (list "when" "what" "other" "say" "and" "do" "are" "the" "same" "again")
                (list 940 900 780 940 760 700 660 1000 940 960 780 960 880)
                (fwf-authored-seed))
            (fwf-seed 8 "sovereignty"
                (list "when" "a" "self" "know" "what" "it" "want" "and" "do" "and" "not" "make" "other" "less")
                (list 840 780 940 940 760 780 860 940 1000 880 900 940 800)
                (fwf-authored-seed))
            (fwf-seed 9 "grace"
                (list "a" "way" "a" "thing" "be" "other" "and" "all" "part" "still" "be" "whole")
                (list 960 960 760 820 900 840 640 960 900 1000 900 980 940)
                (fwf-authored-seed))
            (fwf-seed 10 "flow"
                (list "when" "a" "thing" "do" "now" "and" "still" "do" "after")
                (list 820 920 960 780 840 900 940 820 920 940 1000 940 960)
                (fwf-authored-seed))
            (fwf-seed 11 "coherence"
                (list "when" "all" "part" "of" "a" "whole" "do" "as" "1" "and" "not" "make" "other" "part" "less")
                (list 900 1000 860 960 840 780 740 980 960 980 940 1000 1000)
                (fwf-authored-seed))
            (fwf-seed 12 "resonance"
                (list "when" "1" "thing" "do" "and" "other" "thing" "do" "the" "same")
                (list 940 980 880 860 940 900 860 940 840 960 980 1000 1000)
                (fwf-authored-seed))))

    (defn fwf-find-loop (seeds surface)
        (if (eq (len seeds) 0) (list)
            (if (str_eq (fwf-surface (head seeds)) surface) (head seeds)
                (fwf-find-loop (tail seeds) surface))))
    (defn fwf-find (surface) (fwf-find-loop (fwf-seeds) surface))
    (defn fwf-at (id) (nth (fwf-seeds) id))

    (defn fwf-vector-map2 (a b op)
        (if (eq (len a) 0) (list)
            (cons (if (eq op 0) (sub (head b) (head a))
                      (mul (head a) (head b)))
                  (fwf-vector-map2 (tail a) (tail b) op))))
    (defn fwf-delta (a b) (fwf-vector-map2 a b 0))
    (defn fwf-dot-products (a b) (fwf-vector-map2 a b 1))
    (defn fwf-sum (xs)
        (if (eq (len xs) 0) 0 (add (head xs) (fwf-sum (tail xs)))))
    (defn fwf-abs (x) (if (lt x 0) (sub 0 x) x))
    (defn fwf-l1 (xs)
        (if (eq (len xs) 0) 0 (add (fwf-abs (head xs)) (fwf-l1 (tail xs)))))

    ; One shear component per adjacent pair, including last -> first.
    (defn fwf-shear-open (a b first-a first-b)
        (if (eq (len (tail a)) 0)
            (list (div (sub (mul (head a) first-b) (mul (head b) first-a))
                       (fwf-scale)))
            (cons (div (sub (mul (head a) (nth b 1))
                            (mul (head b) (nth a 1)))
                       (fwf-scale))
                  (fwf-shear-open (tail a) (tail b) first-a first-b))))
    (defn fwf-shear (a b) (fwf-shear-open a b (head a) (head b)))

    ; wake = (from-id to-id delta shear alignment distance expansion)
    (defn fwf-wake-by-id (from-id to-id)
        (do
            (let a (fwf-shape (fwf-at from-id)))
            (let b (fwf-shape (fwf-at to-id)))
            (let delta (fwf-delta a b))
            (list from-id to-id delta (fwf-shear a b)
                  (div (fwf-sum (fwf-dot-products a b)) (fwf-axis-count))
                  (fwf-l1 delta)
                  (sub (fwf-sum b) (fwf-sum a)))))
    (defn fwf-wake (from-surface to-surface)
        (do
            (let a (fwf-find from-surface))
            (let b (fwf-find to-surface))
            (if (or (eq (len a) 0) (eq (len b) 0)) (nothing)
                (fwf-wake-by-id (fwf-id a) (fwf-id b)))))
    (defn fwf-wake-delta (wake) (nth wake 2))
    (defn fwf-wake-shear (wake) (nth wake 3))
    (defn fwf-wake-alignment (wake) (nth wake 4))
    (defn fwf-wake-distance (wake) (nth wake 5))
    (defn fwf-wake-expansion (wake) (nth wake 6))

    ; A small directed ring is a queryable seed graph.  Relation codes are
    ; neutral symbols; labels belong in locale renderers, not in the edge.
    (defn fwf-edge (from relation to) (list from relation to))
    (defn fwf-edge-from (edge) (nth edge 0))
    (defn fwf-edge-rel (edge) (nth edge 1))
    (defn fwf-edge-to (edge) (nth edge 2))
    (defn fwf-edges ()
        (list
            (fwf-edge 0 0 7) (fwf-edge 7 1 8) (fwf-edge 8 2 2)
            (fwf-edge 2 3 10) (fwf-edge 10 4 11) (fwf-edge 11 5 12)
            (fwf-edge 12 6 1) (fwf-edge 1 7 9) (fwf-edge 9 8 4)
            (fwf-edge 4 9 3) (fwf-edge 3 10 5) (fwf-edge 5 11 6)
            (fwf-edge 6 12 0)))
    (defn fwf-edges-from-loop (edges id acc)
        (if (eq (len edges) 0) acc
            (fwf-edges-from-loop (tail edges) id
                (if (eq (fwf-edge-from (head edges)) id)
                    (cons (head edges) acc) acc))))
    (defn fwf-edges-to-loop (edges id acc)
        (if (eq (len edges) 0) acc
            (fwf-edges-to-loop (tail edges) id
                (if (eq (fwf-edge-to (head edges)) id)
                    (cons (head edges) acc) acc))))
    (defn fwf-forward (surface)
        (do (let seed (fwf-find surface))
            (if (eq (len seed) 0) (list)
                (fwf-edges-from-loop (fwf-edges) (fwf-id seed) (list)))))
    (defn fwf-backward (surface)
        (do (let seed (fwf-find surface))
            (if (eq (len seed) 0) (list)
                (fwf-edges-to-loop (fwf-edges) (fwf-id seed) (list)))))

    (defn fwf-core-token? (token)
        (cl-ok-token? token))
    (defn fwf-desc-closed? (tokens)
        (if (eq (len tokens) 0) 1
            (if (eq (fwf-core-token? (head tokens)) 1)
                (fwf-desc-closed? (tail tokens)) 0)))
    (defn fwf-all-desc-closed-loop (seeds)
        (if (eq (len seeds) 0) 1
            (if (eq (fwf-desc-closed? (fwf-desc (head seeds))) 1)
                (fwf-all-desc-closed-loop (tail seeds)) 0)))
    (defn fwf-shapes-sized-loop (seeds)
        (if (eq (len seeds) 0) 1
            (if (eq (len (fwf-shape (head seeds))) (fwf-axis-count))
                (fwf-shapes-sized-loop (tail seeds)) 0)))
    (defn fwf-shape-eq? (a b)
        (if (eq (len a) 0) 1
            (if (eq (head a) (head b)) (fwf-shape-eq? (tail a) (tail b)) 0)))
    (defn fwf-shape-shared-loop (seeds target id)
        (if (eq (len seeds) 0) 0
            (if (and (not (eq (fwf-id (head seeds)) id))
                     (eq (fwf-shape-eq? (fwf-shape (head seeds)) target) 1)) 1
                (fwf-shape-shared-loop (tail seeds) target id))))
    (defn fwf-all-shapes-distinct-loop (seeds all)
        (if (eq (len seeds) 0) 1
            (if (eq (fwf-shape-shared-loop all (fwf-shape (head seeds))
                                           (fwf-id (head seeds))) 0)
                (fwf-all-shapes-distinct-loop (tail seeds) all) 0)))
    (defn fwf-all-shapes-distinct? ()
        (fwf-all-shapes-distinct-loop (fwf-seeds) (fwf-seeds)))

    (defn fwf-directed-pair? (a b)
        (do
            (let ab (fwf-wake-by-id a b))
            (let ba (fwf-wake-by-id b a))
            (if (and (eq (fwf-shape-eq? (fwf-wake-delta ab)
                                        (fwf-wake-delta ba)) 0)
                     (eq (fwf-wake-expansion ab)
                         (sub 0 (fwf-wake-expansion ba)))) 1 0)))
    (defn fwf-all-directed-inner (a b)
        (if (ge b (fwf-axis-count)) 1
            (if (eq a b) (fwf-all-directed-inner a (add b 1))
                (if (eq (fwf-directed-pair? a b) 1)
                    (fwf-all-directed-inner a (add b 1)) 0))))
    (defn fwf-all-directed-loop (a)
        (if (ge a (fwf-axis-count)) 1
            (if (eq (fwf-all-directed-inner a 0) 1)
                (fwf-all-directed-loop (add a 1)) 0)))
    (defn fwf-all-directed? () (fwf-all-directed-loop 0))

    (defn fwfk (condition bit) (if condition bit 0))
    (defn fwf-check ()
        (do
            (let love-trust (fwf-wake "love" "trust"))
            (let trust-love (fwf-wake "trust" "love"))
            (add (fwfk (eq (len (fwf-seeds)) 13) 1)
            (add (fwfk (eq (fwf-shapes-sized-loop (fwf-seeds)) 1) 2)
            (add (fwfk (eq (fwf-all-shapes-distinct?) 1) 4)
            (add (fwfk (eq (fwf-all-desc-closed-loop (fwf-seeds)) 1) 8)
            (add (fwfk (eq (len (fwf-edges)) 13) 16)
            (add (fwfk (and (eq (len (fwf-forward "trust")) 1)
                             (eq (len (fwf-backward "trust")) 1)) 32)
            (add (fwfk (and (not (nothing? love-trust))
                             (not (nothing? trust-love))) 64)
            (add (fwfk (eq (fwf-wake-distance love-trust)
                           (fwf-wake-distance trust-love)) 128)
            (add (fwfk (eq (fwf-wake-expansion love-trust)
                           (sub 0 (fwf-wake-expansion trust-love))) 256)
            (add (fwfk (eq (fwf-shape-eq? (fwf-wake-shear love-trust)
                                          (fwf-wake-shear trust-love)) 0) 512)
            (add (fwfk (eq (fwf-all-directed?) 1) 1024)
            (add (fwfk (nothing? (fwf-wake "love" "unseated")) 2048)
            (add (fwfk (eq (fwf-status (fwf-find "resonance"))
                           (fwf-authored-seed)) 4096)
                 0)))))))))))))))

    0)
