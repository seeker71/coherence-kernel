// form-neutral-word-field.fk — a semantic field for words, never an acoustic one.
//
// The field has thirteen form-neutral axes. English names are surfaces attached
// to the axes; the numeric axis positions and the definition recipes are the
// carrier-independent shape.  Values are per-mille affinities, not hertz, not
// moral scores, and not a claim that culture has one universal geometry.
//
// The first thirteen shapes are AUTHORED SEEDS.  Their definitions close over
// the small core lexicon.  They can be revised by adding a witnessed successor;
// no observation is manufactured from the coordinates themselves.
//
// A directed semantic wake is what remains when one shape moves through
// another: target-minus-source delta, adjacent-axis shear, alignment, distance,
// and expansion.  Shear is antisymmetric, so A -> B and B -> A retain direction.
// This is the requested liquid-turbulence analogy made executable without
// pretending that a word is a physical fluid or sound wave.
// witnessed: 2026-08-24 -> fwf 8191, combined field band 33554431
//
import form/form-stdlib/core.fk;
import form/form-stdlib/core-lexicon.fk;
section [form.bml] {
    def fwf-axis-count() = 13;
    def fwf-scale() = 1000;
    def fwf-authored-seed() = 1;
    // seed = (neutral-id english-surface definition-tokens 13-axis-shape status)
    def fwf-seed(id, surface, desc, shape, status) = [id, surface, desc, shape, status];
    def fwf-id(seed) = seed[0];
    def fwf-surface(seed) = seed[1];
    def fwf-desc(seed) = seed[2];
    def fwf-shape(seed) = seed[3];
    def fwf-status(seed) = seed[4];
    // Axis order is stable and neutral.  The English surfaces below are one
    // rendering: love, harmony, vitality, clarify, awe, humor, excitement,
    // trust, sovereignty, grace, flow, coherence, resonance.
    def fwf-seeds() = [fwf-seed(0, "love", ["when", "a", "self", "know", "other", "as", "part", "of", "the", "whole", "and", "want", "other", "to", "be", "more"], [1000, 820, 840, 680, 780, 720, 700, 920, 820, 940, 780, 880, 900], fwf-authored-seed()), fwf-seed(1, "harmony", ["when", "many", "part", "do", "in", "a", "way", "that", "make", "the", "whole", "still", "be", "whole"], [820, 1000, 760, 760, 680, 740, 580, 860, 760, 940, 880, 980, 940], fwf-authored-seed()), fwf-seed(2, "vitality", ["how", "a", "whole", "still", "do", "and", "be", "more"], [800, 760, 1000, 700, 800, 820, 940, 760, 900, 700, 940, 840, 820], fwf-authored-seed()), fwf-seed(3, "clarify", ["make", "a", "self", "know", "this", "is", "the", "same", "thing", "and", "not", "other"], [680, 780, 680, 1000, 700, 560, 640, 900, 900, 780, 740, 960, 780], fwf-authored-seed()), fwf-seed(4, "awe", ["when", "a", "self", "know", "a", "thing", "is", "more", "than", "what", "the", "self", "know", "before"], [820, 700, 860, 740, 1000, 760, 900, 760, 720, 880, 800, 820, 900], fwf-authored-seed()), fwf-seed(5, "humor", ["when", "a", "self", "know", "an", "other", "way", "and", "this", "make", "the", "self", "want", "more"], [800, 760, 900, 680, 800, 1000, 920, 740, 820, 860, 920, 780, 860], fwf-authored-seed()), fwf-seed(6, "excitement", ["when", "a", "self", "want", "to", "do", "now", "and", "be", "more"], [740, 640, 980, 700, 920, 920, 1000, 700, 840, 700, 940, 720, 840], fwf-authored-seed()), fwf-seed(7, "trust", ["when", "what", "other", "say", "and", "do", "are", "the", "same", "again"], [940, 900, 780, 940, 760, 700, 660, 1000, 940, 960, 780, 960, 880], fwf-authored-seed()), fwf-seed(8, "sovereignty", ["when", "a", "self", "know", "what", "it", "want", "and", "do", "and", "not", "make", "other", "less"], [840, 780, 940, 940, 760, 780, 860, 940, 1000, 880, 900, 940, 800], fwf-authored-seed()), fwf-seed(9, "grace", ["a", "way", "a", "thing", "be", "other", "and", "all", "part", "still", "be", "whole"], [960, 960, 760, 820, 900, 840, 640, 960, 900, 1000, 900, 980, 940], fwf-authored-seed()), fwf-seed(10, "flow", ["when", "a", "thing", "do", "now", "and", "still", "do", "after"], [820, 920, 960, 780, 840, 900, 940, 820, 920, 940, 1000, 940, 960], fwf-authored-seed()), fwf-seed(11, "coherence", ["when", "all", "part", "of", "a", "whole", "do", "as", "1", "and", "not", "make", "other", "part", "less"], [900, 1000, 860, 960, 840, 780, 740, 980, 960, 980, 940, 1000, 1000], fwf-authored-seed()), fwf-seed(12, "resonance", ["when", "1", "thing", "do", "and", "other", "thing", "do", "the", "same"], [940, 980, 880, 860, 940, 900, 860, 940, 840, 960, 980, 1000, 1000], fwf-authored-seed())];
    def fwf-find-loop(seeds, surface) = (Comparable) len(seeds) == 0 ? [] : (String) fwf-surface(seeds[0]) == surface ? seeds[0] : fwf-find-loop(seeds[1:], surface);
    def fwf-find(surface) = fwf-find-loop(fwf-seeds(), surface);
    def fwf-at(id) = nth(fwf-seeds(), id);
    def fwf-vector-map2(a, b, op) = (Comparable) len(a) == 0 ? [] : cons((Comparable) op == 0 ? b[0] - a[0] : a[0] * b[0], fwf-vector-map2(a[1:], b[1:], op));
    def fwf-delta(a, b) = fwf-vector-map2(a, b, 0);
    def fwf-dot-products(a, b) = fwf-vector-map2(a, b, 1);
    def fwf-sum(xs) = (Comparable) len(xs) == 0 ? 0 : (Number) xs[0] + (Number) fwf-sum(xs[1:]);
    def fwf-abs(x) = x < 0 ? 0 - x : x;
    def fwf-l1(xs) = (Comparable) len(xs) == 0 ? 0 : (Number) fwf-abs(xs[0]) + (Number) fwf-l1(xs[1:]);
    // One shear component per adjacent pair, including last -> first.
    def fwf-shear-open(a, b, first-a, first-b) = (Comparable) len(a[1:]) == 0 ? [(a[0] * first-b - b[0] * first-a) / fwf-scale()] : cons((a[0] * b[1] - b[0] * a[1]) / fwf-scale(), fwf-shear-open(a[1:], b[1:], first-a, first-b));
    def fwf-shear(a, b) = fwf-shear-open(a, b, a[0], b[0]);
    // wake = (from-id to-id delta shear alignment distance expansion)
    def fwf-wake-by-id(from-id, to-id) = {
        let a = fwf-shape(fwf-at(from-id));
        let b = fwf-shape(fwf-at(to-id));
        let delta = fwf-delta(a, b);
        [from-id, to-id, delta, fwf-shear(a, b), fwf-sum(fwf-dot-products(a, b)) / fwf-axis-count(), fwf-l1(delta), fwf-sum(b) - fwf-sum(a)];
    };
    def fwf-wake(from-surface, to-surface) = {
        let a = fwf-find(from-surface);
        let b = fwf-find(to-surface);
        (Comparable) len(a) == 0 || (Comparable) len(b) == 0 ? nothing() : fwf-wake-by-id(fwf-id(a), fwf-id(b));
    };
    def fwf-wake-delta(wake) = wake[2];
    def fwf-wake-shear(wake) = wake[3];
    def fwf-wake-alignment(wake) = wake[4];
    def fwf-wake-distance(wake) = wake[5];
    def fwf-wake-expansion(wake) = wake[6];
    // A small directed ring is a queryable seed graph.  Relation codes are
    // neutral symbols; labels belong in locale renderers, not in the edge.
    def fwf-edge(from, relation, to) = [from, relation, to];
    def fwf-edge-from(edge) = edge[0];
    def fwf-edge-rel(edge) = edge[1];
    def fwf-edge-to(edge) = edge[2];
    def fwf-edges() = [fwf-edge(0, 0, 7), fwf-edge(7, 1, 8), fwf-edge(8, 2, 2), fwf-edge(2, 3, 10), fwf-edge(10, 4, 11), fwf-edge(11, 5, 12), fwf-edge(12, 6, 1), fwf-edge(1, 7, 9), fwf-edge(9, 8, 4), fwf-edge(4, 9, 3), fwf-edge(3, 10, 5), fwf-edge(5, 11, 6), fwf-edge(6, 12, 0)];
    def fwf-edges-from-loop(edges, id, acc) = (Comparable) len(edges) == 0 ? acc : fwf-edges-from-loop(edges[1:], id, (Comparable) fwf-edge-from(edges[0]) == id ? cons(edges[0], acc) : acc);
    def fwf-edges-to-loop(edges, id, acc) = (Comparable) len(edges) == 0 ? acc : fwf-edges-to-loop(edges[1:], id, (Comparable) fwf-edge-to(edges[0]) == id ? cons(edges[0], acc) : acc);
    def fwf-forward(surface) = {
        let seed = fwf-find(surface);
        (Comparable) len(seed) == 0 ? [] : fwf-edges-from-loop(fwf-edges(), fwf-id(seed), []);
    };
    def fwf-backward(surface) = {
        let seed = fwf-find(surface);
        (Comparable) len(seed) == 0 ? [] : fwf-edges-to-loop(fwf-edges(), fwf-id(seed), []);
    };
    def fwf-core-token?(token) = cl-ok-token?(token);
    def fwf-desc-closed?(tokens) = (Comparable) len(tokens) == 0 ? 1 : (Comparable) fwf-core-token?(tokens[0]) == 1 ? fwf-desc-closed?(tokens[1:]) : 0;
    def fwf-all-desc-closed-loop(seeds) = (Comparable) len(seeds) == 0 ? 1 : (Comparable) fwf-desc-closed?(fwf-desc(seeds[0])) == 1 ? fwf-all-desc-closed-loop(seeds[1:]) : 0;
    def fwf-shapes-sized-loop(seeds) = (Comparable) len(seeds) == 0 ? 1 : (Comparable) len(fwf-shape(seeds[0])) == fwf-axis-count() ? fwf-shapes-sized-loop(seeds[1:]) : 0;
    def fwf-shape-eq?(a, b) = (Comparable) len(a) == 0 ? 1 : (Comparable) a[0] == b[0] ? fwf-shape-eq?(a[1:], b[1:]) : 0;
    def fwf-shape-shared-loop(seeds, target, id) = (Comparable) len(seeds) == 0 ? 0 : !((Comparable) fwf-id(seeds[0]) == id) && (Comparable) fwf-shape-eq?(fwf-shape(seeds[0]), target) == 1 ? 1 : fwf-shape-shared-loop(seeds[1:], target, id);
    def fwf-all-shapes-distinct-loop(seeds, all) = (Comparable) len(seeds) == 0 ? 1 : (Comparable) fwf-shape-shared-loop(all, fwf-shape(seeds[0]), fwf-id(seeds[0])) == 0 ? fwf-all-shapes-distinct-loop(seeds[1:], all) : 0;
    def fwf-all-shapes-distinct?() = fwf-all-shapes-distinct-loop(fwf-seeds(), fwf-seeds());
    def fwf-directed-pair?(a, b) = {
        let ab = fwf-wake-by-id(a, b);
        let ba = fwf-wake-by-id(b, a);
        (Comparable) fwf-shape-eq?(fwf-wake-delta(ab), fwf-wake-delta(ba)) == 0 && (Comparable) fwf-wake-expansion(ab) == 0 - fwf-wake-expansion(ba) ? 1 : 0;
    };
    def fwf-all-directed-inner(a, b) = b >= fwf-axis-count() ? 1 : (Comparable) a == b ? fwf-all-directed-inner(a, (Number) b + (Number) 1) : (Comparable) fwf-directed-pair?(a, b) == 1 ? fwf-all-directed-inner(a, (Number) b + (Number) 1) : 0;
    def fwf-all-directed-loop(a) = a >= fwf-axis-count() ? 1 : (Comparable) fwf-all-directed-inner(a, 0) == 1 ? fwf-all-directed-loop((Number) a + (Number) 1) : 0;
    def fwf-all-directed?() = fwf-all-directed-loop(0);
    def fwfk(condition, bit) = condition ? bit : 0;
    def fwf-check() = {
        let love-trust = fwf-wake("love", "trust");
        let trust-love = fwf-wake("trust", "love");
        (Number) fwfk((Comparable) len(fwf-seeds()) == 13, 1) + (Number) ((Number) fwfk((Comparable) fwf-shapes-sized-loop(fwf-seeds()) == 1, 2) + (Number) ((Number) fwfk((Comparable) fwf-all-shapes-distinct?() == 1, 4) + (Number) ((Number) fwfk((Comparable) fwf-all-desc-closed-loop(fwf-seeds()) == 1, 8) + (Number) ((Number) fwfk((Comparable) len(fwf-edges()) == 13, 16) + (Number) ((Number) fwfk((Comparable) len(fwf-forward("trust")) == 1 && (Comparable) len(fwf-backward("trust")) == 1, 32) + (Number) ((Number) fwfk(!nothing?(love-trust) && !nothing?(trust-love), 64) + (Number) ((Number) fwfk((Comparable) fwf-wake-distance(love-trust) == fwf-wake-distance(trust-love), 128) + (Number) ((Number) fwfk((Comparable) fwf-wake-expansion(love-trust) == 0 - fwf-wake-expansion(trust-love), 256) + (Number) ((Number) fwfk((Comparable) fwf-shape-eq?(fwf-wake-shear(love-trust), fwf-wake-shear(trust-love)) == 0, 512) + (Number) ((Number) fwfk((Comparable) fwf-all-directed?() == 1, 1024) + (Number) ((Number) fwfk(nothing?(fwf-wake("love", "unseated")), 2048) + (Number) ((Number) fwfk((Comparable) fwf-status(fwf-find("resonance")) == fwf-authored-seed(), 4096) + (Number) 0))))))))))));
    };
    0;
}
