; identity-space-answer-kernel.fk — a timeless address, a situated receipt.
;
; This cell composes four already-observed organs:
;   language-neutral-symbol-identity  labels are evidence, never identity
;   native-inquiry-derivation         every answer can become the next subject
;   belief-freshness                  proven witness ages
;   subjective-logic                  uncertainty is not disbelief
;
; The timeless identity space has three modes, seven layers, and seven inquiry
; planes.  Its 147 coordinates do not contain a date, place, spelling, or
; truth claim:
;
;   modes  0 POINT/I, 1 SAME-JOIN/WE, 2 DIFFERENCE-JOIN/US
;   layers 0 EXIST, 1 FEEL, 2 DO, 3 INCLUDE, 4 EMIT, 5 OBSERVE, 6 BE
;   planes 0 WHAT, 1 WHERE, 2 WHEN, 3 WHO, 4 HOW, 5 WHICH, 6 WHY
;
; An optional viewpoint role qualifies any coordinate:
;   roles 0 SELF/I-or-ME, 1 ADDRESSED/YOU, 2 REFERRED/IT
; This makes 3*147 = 441 role-qualified positions without changing the stable
; 147 base addresses. Natural-language pronouns are contextual and
; grammatically richer than these axes. The uppercase words above are
; framework labels, not universal linguistic definitions.
;
; A local slot is the smallest ordinal address for this finite space:
;   1 + mode*49 + layer*7 + plane  -> 1..147
; A global symbol uses the repository's package/level/type/instance address.
; A recursive derivation node remains separate: meaning, answer, and evidence
; are related in the receipt but never collapsed into one number.
;
; Several freshly-known symbols may also collapse into one CONSTELLATION.
; Its relation is explicitly commutative: members are sorted and deduplicated,
; so arrival order cannot change the composite. The members remain recoverable.
; This is a structural symbol, not a lossy arithmetic hash.
;
; Response:
;   [nothing,0,1,alternative,ack,reason,symbol,slot,receipt,steps,knowing]
; ack is exactly one of nothing / 0 / 1 / derived-node.
; reason: 0 complete, 1 unknown subject, 2 fuel exhausted,
;         4 unknown inquiry plane, 5 invalid identity mode/layer,
;         6 WHY lacks non-vacuous evidence, 7 proposed symbol mismatched.
; knowing: 0 held/not established, 1 proven but owed re-witness,
;          2 proven and fresh for the current grounding epoch.
;
; A receipt carries time and point, but this first slice does not claim that
; those two caller-supplied scalars are authenticated by the derivation seal.
; It proves composition and replay of the derivation, not external provenance.
;
; witnessed: 2026-07-26 -> full fkwu answer band success 1;
; pure structural projection 127 on fkwu/Go/Rust/TypeScript
import "language-neutral-symbol-identity.fk"
import "native-inquiry-derivation.fk"
import "../observe/belief-freshness.fk"
import "../form/form-stdlib/subjective-logic.fk"

(do
  (defn isk-mode? (mode) (if (and (ge mode 0) (le mode 2)) 1 0))
  (defn isk-layer? (layer) (if (and (ge layer 0) (le layer 6)) 1 0))
  (defn isk-role? (role) (if (and (ge role 0) (le role 2)) 1 0))
  (defn isk-coordinate? (mode layer plane)
    (if (and (eq (isk-mode? mode) 1)
      (and (eq (isk-layer? layer) 1) (eq (nid-lane? plane) 1))) 1 0))

  ; Compact local semantic address (1..147) and repository-global symbol.
  (defn isk-slot (mode layer plane)
    (add 1 (add (mul mode 49) (add (mul layer 7) plane))))
  (defn isk-symbol (mode layer plane)
    (lnsi-node 2 (add mode 1) (add layer 1) (add plane 1)))

  ; Role qualification keeps viewpoint separate from inclusion. A YOU is an
  ; addressed locus from this point; from its own point that locus is SELF.
  (defn isk-role-slot (role mode layer plane)
    (add 1 (add (mul role 147)
      (add (mul mode 49) (add (mul layer 7) plane)))))
  (defn isk-role-symbol (role mode layer plane)
    (lnsi-node 2 (add 30 (add (mul role 3) mode))
      (add layer 1) (add plane 1)))

  ; Lowercase/exact and uppercase/inclusive are explicit relations, not magic
  ; typography. More surface words can be added without changing identity.
  (defn isk-word-relation (inclusion) (if (eq inclusion 0) 901 902))
  (defn isk-word-symbol (layer inclusion)
    (lnsi-node 2 (add 10 inclusion) (add 100 layer) 1))
  (defn isk-core-aliases ()
    (list
      (lnsi-alias 1 901 1 "exist"   (isk-word-symbol 0 0))
      (lnsi-alias 1 901 1 "exists"  (isk-word-symbol 0 0))
      (lnsi-alias 1 901 1 "feel"    (isk-word-symbol 1 0))
      (lnsi-alias 1 901 1 "feels"   (isk-word-symbol 1 0))
      (lnsi-alias 1 901 1 "do"      (isk-word-symbol 2 0))
      (lnsi-alias 1 901 1 "does"    (isk-word-symbol 2 0))
      (lnsi-alias 1 901 1 "include" (isk-word-symbol 3 0))
      (lnsi-alias 1 901 1 "includes" (isk-word-symbol 3 0))
      (lnsi-alias 1 901 1 "emit"    (isk-word-symbol 4 0))
      (lnsi-alias 1 901 1 "emits"   (isk-word-symbol 4 0))
      (lnsi-alias 1 901 1 "observe" (isk-word-symbol 5 0))
      (lnsi-alias 1 901 1 "observes" (isk-word-symbol 5 0))
      (lnsi-alias 1 901 1 "be"      (isk-word-symbol 6 0))
      (lnsi-alias 1 901 1 "is"      (isk-word-symbol 6 0))
      (lnsi-alias 1 901 1 "are"     (isk-word-symbol 6 0))
      (lnsi-alias 1 902 1 "EXIST"   (isk-word-symbol 0 1))
      (lnsi-alias 1 902 1 "FEEL"    (isk-word-symbol 1 1))
      (lnsi-alias 1 902 1 "DO"      (isk-word-symbol 2 1))
      (lnsi-alias 1 902 1 "INCLUDE" (isk-word-symbol 3 1))
      (lnsi-alias 1 902 1 "EMIT"    (isk-word-symbol 4 1))
      (lnsi-alias 1 902 1 "OBSERVE" (isk-word-symbol 5 1))
      (lnsi-alias 1 902 1 "BE"      (isk-word-symbol 6 1))))
  (defn isk-resolve-word (aliases inclusion surface)
    (lnsi-resolve aliases 1 (isk-word-relation inclusion) 1 surface))

  ; An order-independent constellation is one structural symbol carrying a
  ; canonical set of member symbols. Sorting is the quotient operation:
  ; permutations and duplicates receive the same representative.
  (defn isk-constellation-tag () (lnsi-node 2 20 1 1))
  (defn isk-member-insert (member members)
    (if (eq (len members) 0) (list member)
      (if (eq member (head members)) members
        (if (lt member (head members)) (cons member members)
          (cons (head members) (isk-member-insert member (tail members)))))))
  (defn isk-canonical-members-loop (members canonical)
    (if (eq (len members) 0) canonical
      (isk-canonical-members-loop (tail members)
        (isk-member-insert (head members) canonical))))
  (defn isk-canonical-members (members)
    (isk-canonical-members-loop members (list)))
  (defn isk-constellation (members)
    (list (isk-constellation-tag) (isk-canonical-members members)))
  (defn isk-constellation-members (constellation) (nth constellation 1))
  (defn isk-int-list-eq? (left right)
    (if (not (eq (len left) (len right))) 0
      (if (eq (len left) 0) 1
        (if (eq (head left) (head right))
          (isk-int-list-eq? (tail left) (tail right))
          0))))
  (defn isk-constellation-eq? (left right)
    (if (not (eq (len left) 2)) 0
      (if (not (eq (len right) 2)) 0
        (if (not (eq (nth left 0) (nth right 0))) 0
          (isk-int-list-eq? (nth left 1) (nth right 1))))))
  (defn isk-constellation-valid? (constellation)
    (if (not (eq (len constellation) 2)) 0
      (if (not (eq (nth constellation 0) (isk-constellation-tag))) 0
        (isk-int-list-eq? (nth constellation 1)
          (isk-canonical-members (nth constellation 1))))))

  ; AND over a commutative constellation is canonical union. NOT is never an
  ; absolute identity: it is set difference inside an explicitly supplied
  ; universe. Both operations preserve the member symbols.
  (defn isk-members-add-all (from into)
    (if (eq (len from) 0) into
      (isk-members-add-all (tail from)
        (isk-member-insert (head from) into))))
  (defn isk-and (left right)
    (isk-constellation (isk-members-add-all
      (isk-constellation-members left)
      (isk-constellation-members right))))
  (defn isk-member? (member members)
    (if (eq (len members) 0) 0
      (if (eq member (head members)) 1
        (isk-member? member (tail members)))))
  (defn isk-members-not-loop (universe excluded kept)
    (if (eq (len universe) 0) kept
      (if (eq (isk-member? (head universe) excluded) 1)
        (isk-members-not-loop (tail universe) excluded kept)
        (isk-members-not-loop (tail universe) excluded
          (isk-member-insert (head universe) kept)))))
  (defn isk-not (universe excluded)
    (isk-constellation
      (isk-members-not-loop
        (isk-constellation-members universe)
        (isk-constellation-members excluded)
        (list))))

  ; question =
  ; [subject,mode,layer,plane,claim,time,point,belief,epoch,opinion,fuel]
  ; claim=nothing asks openly; otherwise claim proposes a canonical symbol.
  (defn isk-question
    (subject mode layer plane claim time point belief epoch opinion fuel)
    (list subject mode layer plane claim time point belief epoch opinion fuel))
  (defn isk-q-subject (q) (nth q 0))
  (defn isk-q-mode (q) (nth q 1))
  (defn isk-q-layer (q) (nth q 2))
  (defn isk-q-plane (q) (nth q 3))
  (defn isk-q-claim (q) (nth q 4))
  (defn isk-q-time (q) (nth q 5))
  (defn isk-q-point (q) (nth q 6))
  (defn isk-q-belief (q) (nth q 7))
  (defn isk-q-epoch (q) (nth q 8))
  (defn isk-q-opinion (q) (nth q 9))
  (defn isk-q-fuel (q) (nth q 10))

  ; receipt =
  ; [symbol,slot,derived-node,mode,layer,plane,time,point,belief,epoch,
  ;  opinion,knowing,native-derivation-receipt]
  (defn isk-receipt
    (symbol slot derived mode layer plane time point belief epoch opinion knowing native)
    (list symbol slot derived mode layer plane time point belief epoch
      opinion knowing native))
  (defn isk-rc-symbol (r) (nth r 0))
  (defn isk-rc-slot (r) (nth r 1))
  (defn isk-rc-derived (r) (nth r 2))
  (defn isk-rc-mode (r) (nth r 3))
  (defn isk-rc-layer (r) (nth r 4))
  (defn isk-rc-plane (r) (nth r 5))
  (defn isk-rc-time (r) (nth r 6))
  (defn isk-rc-point (r) (nth r 7))
  (defn isk-rc-belief (r) (nth r 8))
  (defn isk-rc-epoch (r) (nth r 9))
  (defn isk-rc-opinion (r) (nth r 10))
  (defn isk-rc-knowing (r) (nth r 11))
  (defn isk-rc-native (r) (nth r 12))

  (defn isk-response
    (alternative ack reason symbol slot receipt steps knowing)
    (list (nothing) 0 1 alternative ack reason symbol slot receipt steps knowing))
  (defn isk-r-alt (r) (nth r 3))
  (defn isk-r-ack (r) (nth r 4))
  (defn isk-r-reason (r) (nth r 5))
  (defn isk-r-symbol (r) (nth r 6))
  (defn isk-r-slot (r) (nth r 7))
  (defn isk-r-receipt (r) (nth r 8))
  (defn isk-r-steps (r) (nth r 9))
  (defn isk-r-knowing (r) (nth r 10))
  (defn isk-response-arms? (r)
    (if (and (nothing? (nth r 0)) (and (eq (nth r 1) 0)
      (and (eq (nth r 2) 1) (eq (nid-valid? (nth r 3)) 1)))) 1 0))

  (defn isk-evidence? (opinion)
    (if (and (eq (sl-valid? opinion 1) 1) (lt (sl-u opinion) 1000)) 1 0))
  (defn isk-ack-complete? (ack)
    (if (nothing? ack) 0 (if (eq ack 0) 0 1)))
  (defn isk-knowing (ack symbol belief epoch opinion)
    (if (eq (isk-ack-complete? ack) 0) 0
      (if (not (eq (bf-id belief) symbol)) 0
        (if (eq (sl-valid? opinion 1) 0) 0
          (if (lt (sl-expectation opinion) 500) 0
            (bf-status belief epoch))))))

  ; Open questions emit a recursively queryable node. A proposed canonical
  ; symbol receives 1 or 0. Missing structure/evidence receives nothing.
  (defn isk-ask (q)
    (do
      (let mode (isk-q-mode q))
      (let layer (isk-q-layer q))
      (let plane (isk-q-plane q))
      (if (or (eq (isk-mode? mode) 0) (eq (isk-layer? layer) 0))
        (isk-response 1 (nothing) 5 (nothing) (nothing) (list) 0 0)
        (do
          (let native (nid-inquire (isk-q-subject q) plane (isk-q-fuel q)))
          (let native-ack (nid-p-ack native))
          (if (nothing? native-ack)
            (isk-response (nid-p-alt native) (nothing) (nid-p-reason native)
              (nothing) (nothing) (list) (nth native 7) 0)
            (do
              (let symbol (isk-symbol mode layer plane))
              (let slot (isk-slot mode layer plane))
              (if (and (eq plane 6) (eq (isk-evidence? (isk-q-opinion q)) 0))
                (isk-response (nid-p-alt native) (nothing) 6 symbol slot
                  (list) (nth native 7) 0)
                (do
                  (let claim (isk-q-claim q))
                  (let ack (if (nothing? claim) native-ack
                    (if (eq claim symbol) 1 0)))
                  (let reason (if (eq ack 0) 7 0))
                  (let knowing (isk-knowing ack symbol (isk-q-belief q)
                    (isk-q-epoch q) (isk-q-opinion q)))
                  (let receipt (isk-receipt symbol slot native-ack mode layer plane
                    (isk-q-time q) (isk-q-point q) (isk-q-belief q)
                    (isk-q-epoch q) (isk-q-opinion q) knowing
                    (nid-p-receipt native)))
                  (isk-response (nid-p-alt native) ack reason symbol slot receipt
                    (nth native 7) knowing)))))))))

  ; Composition replay proves the internal address and the native derivation.
  ; It does not authenticate the caller-supplied time or point.
  (defn isk-receipt-composed? (r)
    (if (not (eq (len r) 13)) 0
      (if (eq (isk-coordinate? (isk-rc-mode r)
        (isk-rc-layer r) (isk-rc-plane r)) 0) 0
        (if (not (eq (isk-rc-symbol r)
          (isk-symbol (isk-rc-mode r) (isk-rc-layer r) (isk-rc-plane r)))) 0
          (if (not (eq (isk-rc-slot r)
            (isk-slot (isk-rc-mode r) (isk-rc-layer r) (isk-rc-plane r)))) 0
            (if (not (eq (bf-id (isk-rc-belief r)) (isk-rc-symbol r))) 0
              (if (not (eq (nid-r-node (isk-rc-native r))
                (isk-rc-derived r))) 0
                (nid-receipt-valid? (isk-rc-native r)))))))))

  ; Prove all 147 compact slots and global symbols are strictly increasing.
  (defn isk-index-mode (i) (div i 49))
  (defn isk-index-layer (i) (div (mod i 49) 7))
  (defn isk-index-plane (i) (mod i 7))
  (defn isk-unique-loop (i prior-slot prior-symbol count)
    (if (ge i 147) count
      (do
        (let mode (isk-index-mode i))
        (let layer (isk-index-layer i))
        (let plane (isk-index-plane i))
        (let slot (isk-slot mode layer plane))
        (let symbol (isk-symbol mode layer plane))
        (if (and (gt slot prior-slot) (gt symbol prior-symbol))
          (isk-unique-loop (add i 1) slot symbol (add count 1))
          count))))
  (defn isk-unique-count () (isk-unique-loop 0 0 0 0))

  ; The optional role-qualified space has 441 unique compact/global addresses.
  (defn isk-role-index (i) (div i 147))
  (defn isk-role-index-within (i) (mod i 147))
  (defn isk-role-unique-loop (i prior-slot prior-symbol count)
    (if (ge i 441) count
      (do
        (let role (isk-role-index i))
        (let within (isk-role-index-within i))
        (let mode (isk-index-mode within))
        (let layer (isk-index-layer within))
        (let plane (isk-index-plane within))
        (let slot (isk-role-slot role mode layer plane))
        (let symbol (isk-role-symbol role mode layer plane))
        (if (and (gt slot prior-slot) (gt symbol prior-symbol))
          (isk-role-unique-loop (add i 1) slot symbol (add count 1))
          count))))
  (defn isk-role-unique-count () (isk-role-unique-loop 0 0 0 0))

  ; One diagonal reasoning chain traverses all seven planes and layers, with
  ; modes cycling I -> WE -> US. Every emitted answer becomes the next subject.
  (defn isk-chain-loop (subject lane epoch opinion acc)
    (if (ge lane 7) (nid-reverse-loop acc (list))
      (do
        (let mode (mod lane 3))
        (let symbol (isk-symbol mode lane lane))
        (let belief (bf-belief symbol 1 epoch))
        (let q (isk-question subject mode lane lane (nothing)
          (add epoch lane) (add 700 lane) belief epoch opinion 1))
        (let answer (isk-ask q))
        (if (or (nothing? (isk-r-ack answer)) (eq (isk-r-ack answer) 0))
          (nid-reverse-loop (cons answer acc) (list))
          (isk-chain-loop (isk-r-ack answer) (add lane 1) epoch opinion
            (cons answer acc))))))
  (defn isk-chain (epoch opinion) (isk-chain-loop 1 0 epoch opinion (list)))
  (defn isk-chain-ok-loop (answers lane)
    (if (eq (len answers) 0) (if (eq lane 7) 1 0)
      (do
        (let answer (head answers))
        (let expected-mode (mod lane 3))
        (if (and (eq (isk-response-arms? answer) 1)
          (and (eq (nid-valid? (isk-r-ack answer)) 1)
          (and (eq (isk-r-symbol answer) (isk-symbol expected-mode lane lane))
          (and (eq (isk-r-knowing answer) 2)
          (and (eq (isk-receipt-composed? (isk-r-receipt answer)) 1)
               (eq (isk-r-reason answer) 0))))))
          (isk-chain-ok-loop (tail answers) (add lane 1))
          0))))
  (defn isk-chain-ok? (answers) (isk-chain-ok-loop answers 0))

  ; Collapse only fresh known-for-now response symbols. Reordering the answers
  ; cannot change the resulting constellation.
  (defn isk-known-symbols-loop (answers members)
    (if (eq (len answers) 0) members
      (do
        (let answer (head answers))
        (if (and (eq (isk-r-knowing answer) 2)
          (not (nothing? (isk-r-symbol answer))))
          (isk-known-symbols-loop (tail answers)
            (cons (isk-r-symbol answer) members))
          (isk-known-symbols-loop (tail answers) members)))))
  (defn isk-collapse-known (answers)
    (isk-constellation (isk-known-symbols-loop answers (list))))

  ; Pure structural witness for the three minimal proof walkers. It avoids the
  ; fkwu-native first-class nothing arm, which those deliberately-small proof
  ; oracles do not yet carry.
  (defn isk-structure-witness ()
    (do
      (let a (isk-symbol 0 0 0))
      (let b (isk-symbol 1 2 4))
      (let c (isk-symbol 2 6 6))
      (let abc (isk-constellation (list a b c)))
      (let cbaa (isk-constellation (list c b a a)))
      (let changed (isk-constellation (list a b (isk-symbol 2 6 5))))
      (let me-role (isk-role-symbol 0 0 0 3))
      (let you-role (isk-role-symbol 1 0 0 3))
      (let it-role (isk-role-symbol 2 0 0 3))
      (let universe (isk-constellation (list me-role you-role it-role)))
      (let me-only (isk-constellation (list me-role)))
      (let you-and-it (isk-and
        (isk-constellation (list you-role))
        (isk-constellation (list it-role))))
      (let wider (isk-constellation
        (list me-role you-role it-role (isk-role-symbol 2 0 1 3))))
      (let aliases (isk-core-aliases))
      (let do-node (isk-resolve-word aliases 0 "do"))
      (let does-node (isk-resolve-word aliases 0 "does"))
      (let DO-node (isk-resolve-word aliases 1 "DO"))
      (add
        (if (eq (isk-unique-count) 147) 1 0)
        (add
          (if (eq (isk-role-unique-count) 441) 2 0)
          (add
            (if (eq (isk-constellation-eq? abc cbaa) 1) 4 0)
            (add
              (if (eq (isk-constellation-eq? abc changed) 0) 8 0)
              (add
                (if (eq (isk-constellation-eq?
                  (isk-not universe me-only) you-and-it) 1) 16 0)
                (add
                  (if (eq (isk-constellation-eq?
                    (isk-not wider me-only) you-and-it) 0) 32 0)
                  (if (and (eq do-node does-node)
                    (not (eq do-node DO-node))) 64 0)))))))))

  (defn isk-witness ()
    (do
      (let epoch 20260726)
      (let opinion (sl-opinion 700 100 200 500))
      (let vacuous (sl-opinion 0 0 1000 500))
      (let symbol (isk-symbol 0 0 0))
      (let fresh (bf-belief symbol 1 epoch))
      (let stale (bf-belief symbol 1 20260725))
      (let open (isk-ask (isk-question 1 0 0 0 (nothing)
        20260726 101 fresh epoch opinion 1)))
      (let confirmed (isk-ask (isk-question 1 0 0 0 symbol
        20260726 101 fresh epoch opinion 1)))
      (let rejected (isk-ask (isk-question 1 0 0 0 (add symbol 1)
        20260726 101 fresh epoch opinion 1)))
      (let no-why-symbol (isk-symbol 2 6 6))
      (let no-why (isk-ask (isk-question 1 2 6 6 (nothing)
        20260726 202 (bf-belief no-why-symbol 1 epoch)
        epoch vacuous 1)))
      (let stale-answer (isk-ask (isk-question 1 0 0 0 (nothing)
        20260726 101 stale epoch opinion 1)))
      (let later (isk-ask (isk-question 1 0 0 0 (nothing)
        20260727 202 fresh epoch opinion 1)))
      (let invalid (isk-ask (isk-question 1 3 0 0 (nothing)
        20260726 101 fresh epoch opinion 1)))
      (let chain (isk-chain epoch opinion))
      (let constellation-a (isk-collapse-known chain))
      (let constellation-b
        (isk-collapse-known (nid-reverse-loop chain (list))))
      (let constellation-c (isk-constellation
        (cons (isk-symbol 0 0 1) (isk-constellation-members constellation-a))))
      (let constellation-orderless (if (and
        (eq (isk-constellation-eq? constellation-a constellation-b) 1)
        (and (eq (isk-constellation-eq? constellation-a constellation-c) 0)
             (eq (isk-constellation-valid? constellation-a) 1))) 1 0))
      ; ME/YOU/IT are viewpoint roles at the WHO plane. In this explicitly
      ; closed three-role universe only, NOT(ME) equals YOU AND IT.
      (let me-role (isk-role-symbol 0 0 0 3))
      (let you-role (isk-role-symbol 1 0 0 3))
      (let it-role (isk-role-symbol 2 0 0 3))
      (let role-universe (isk-constellation (list me-role you-role it-role)))
      (let me-only (isk-constellation (list me-role)))
      (let you-only (isk-constellation (list you-role)))
      (let it-only (isk-constellation (list it-role)))
      (let not-me (isk-not role-universe me-only))
      (let you-and-it (isk-and you-only it-only))
      (let wider-universe
        (isk-constellation (list me-role you-role it-role
          (isk-role-symbol 2 0 1 3))))
      (let role-logic (if (and
        (not (eq me-role you-role))
        (and (not (eq you-role it-role))
        (and (eq (isk-constellation-eq? not-me you-and-it) 1)
             (eq (isk-constellation-eq?
               (isk-not wider-universe me-only) you-and-it) 0))))
        1 0))
      (let aliases (isk-core-aliases))
      (let do-node (isk-resolve-word aliases 0 "do"))
      (let does-node (isk-resolve-word aliases 0 "does"))
      (let DO-node (isk-resolve-word aliases 1 "DO"))
      (let wrong-case-relation (isk-resolve-word aliases 1 "do"))
      (let timeless-same (if (and
        (eq (isk-r-symbol open) (isk-r-symbol later))
        (and (not (eq (isk-rc-time (isk-r-receipt open))
                      (isk-rc-time (isk-r-receipt later))))
             (not (eq (isk-rc-point (isk-r-receipt open))
                      (isk-rc-point (isk-r-receipt later)))))) 1 0))
      (let aliases-hold (if (and (eq do-node does-node)
        (and (not (eq do-node DO-node)) (nothing? wrong-case-relation))) 1 0))
      (let success (if (and (eq (isk-unique-count) 147)
        (and (eq (isk-role-unique-count) 441)
        (and (eq (isk-r-ack confirmed) 1)
        (and (eq (isk-r-ack rejected) 0)
