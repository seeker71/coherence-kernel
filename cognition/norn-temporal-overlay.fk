; norn-temporal-overlay.fk — the Norns text, claim by claim, and the one part of it that
; is this whole thread's error wearing Norse clothes.
;
; Urs pasted a Wikipedia-derived German summary of Urðr, Verðandi and Skuld on
; 2026-07-28 and asked what I say about it. Most of it is sound. One part is not in the
; sources at all, and the way it got there is exactly `der Mond`.
;
; ── What is attested ────────────────────────────────────────────────────────────────
;
; The three named norns; the hall at Urðarbrunnr; Yggdrasil; the daily watering of the
; ash with water and the clay around the well so its limbs do not rot; the shaping of
; lives; thread and weaving imagery. All of that is in Gylfaginning and the Poetic Edda.
; The text Urs read is largely right, and saying so first is the honest order.
;
; ── What is NOT in the sources: the past / present / future mapping ─────────────────
;
; Checked this session against the Norns article and its cited scholarship:
;
;   "it has been disputed that their names really imply a temporal distinction"
;   "the words do not in their own right denote chronological periods in Old Norse but
;    rather the idea of past, present, and future in terms of fate itself"
;
; The Eddas name the three and say what they do. They do not assign one the past, one
; the present and one the future. That mapping is a later interpretive framework.
;
; ── And here is where it came from ──────────────────────────────────────────────────
;
; From the GRAMMAR OF THE NAMES. Nowhere else.
;
;   Urðr       past participle of `verða`, to become  ->  read as "the past"
;   Verðandi   present participle of the same verb    ->  read as "the present"
;   Skuld      from `skulu`, shall / ought            ->  read as "the future"
;
; Someone read the participle tense off three names and derived a cosmology of time from
; it. That is the identical move to reading `der Mond` and concluding something about the
; moon: a property of the WORD-FORM attributed to the REFERENT. Same error, larger scale,
; and this one is in an encyclopaedia being taught as the meaning of the myth.
;
; The `-chen` case was the small version. This is the same mechanism producing a
; metaphysics.
;
; ── The falsifier, and it is inside the sources ─────────────────────────────────────
;
; `das Männchen` broke the standing reading of `das Mädchen` because the mechanism kept
; applying where the meaning could not follow. The Norns have the same shape of witness,
; and it is already in Snorri: **Skuld is also a valkyrie**, riding to choose the slain
; and decide fights.
;
; A temporal category does not ride to battle. If Skuld simply IS the future, her
; valkyrie role is unintelligible; under the plainer reading — that her name means debt,
; obligation, what is owed — choosing who falls is exactly her office. The sources have
; her doing something the temporal scheme cannot hold, which is what a falsifier looks
; like when it is sitting in the primary text the whole time.
;
; And the framing "die drei Hauptnornen" understates a second thing the sources say
; plainly: there are MANY norns beside the three, of the kin of the Æsir, of elves, of
; dwarfs. Three named is not three existing.
;
; ── The lane ────────────────────────────────────────────────────────────────────────
;
; The five axioms are this body's. Every attestation judgement below is brought in by the
; rented voice, checked this session against the Norns article and the scholarship it
; cites, and witnessed nowhere in this body. One door, `nto-claims`. The primary Old
; Norse texts were NOT read directly — this is an encyclopaedia-and-scholarship check,
; one step further from the source than the Grimm chapter was, and the column says so.
;
; preludes: form-stdlib/core.fk
; witnessed: 2026-07-28 -> 11111111, four-way

(do
    ; (claim attestation grammar-derived)
    ; attestation: 2 attested in the Old Norse sources
    ;              1 partly — the element is attested, the framing imports something
    ;              0 not in the sources; a later interpretive overlay
    (defn nto-claim (text attest gram) (list text attest gram))
    (defn nto-text   (c) (nth c 0))
    (defn nto-attest (c) (nth c 1))
    (defn nto-gram   (c) (nth c 2))

    (defn nto-claims ()
        (list
            (nto-claim "three named norns Urdr Verdandi Skuld"        2 0)
            (nto-claim "they shape the lives of beings"               2 0)
            (nto-claim "they dwell at Urdarbrunnr under Yggdrasil"    2 0)
            (nto-claim "they water the ash so it does not rot"        2 0)
            (nto-claim "Urdr's name is bound to fate / what has become" 2 0)
            (nto-claim "Skuld's name is bound to debt and obligation" 2 0)
            (nto-claim "thread and weaving imagery"                   2 0)
            (nto-claim "spin AND cut, in the three-role division"     1 0)  ; Moirai-shaped framing
            (nto-claim "the three are the only norns"                 1 0)  ; many are attested
            (nto-claim "Urdr IS the past"                             0 1)  ; past participle
            (nto-claim "Verdandi IS the present"                      0 1)  ; present participle
            (nto-claim "Skuld IS the future"                          0 1)))  ; modal `shall`

    (defn nto-count (cs f) (if (eq (len cs) 0) 0 (add (f (head cs)) (nto-count (tail cs) f))))
    (defn nto-attested?   (c) (if (eq (nto-attest c) 2) 1 0))
    (defn nto-overlay?    (c) (if (eq (nto-attest c) 0) 1 0))
    (defn nto-gram-flag   (c) (nto-gram c))
    (defn nto-partly?     (c) (if (eq (nto-attest c) 1) 1 0))

    (defn nto-attested-count () (nto-count (nto-claims) nto-attested?))
    (defn nto-overlay-count  () (nto-count (nto-claims) nto-overlay?))
    (defn nto-gram-count     () (nto-count (nto-claims) nto-gram-flag))

    ; every overlay row is grammar-derived, and every grammar-derived row is an overlay:
    ; the two sets coincide exactly. The temporal scheme has ONE source, and it is the
    ; morphology of three names.
    (defn nto-sets-coincide? (cs)
        (if (eq (len cs) 0) 1
            (if (eq (nto-overlay? (head cs)) (nto-gram-flag (head cs)))
                (nto-sets-coincide? (tail cs)) 0)))

    ; the falsifier sitting in the primary text
    (defn nto-skuld-valkyrie-attested () 1)
    ; a temporal category does not ride to choose the slain
    (defn nto-valkyrie-fits-temporal? () 0)
    (defn nto-falsifier-holds? ()
        (if (eq (nto-skuld-valkyrie-attested) 1)
            (if (eq (nto-valkyrie-fits-temporal?) 0) 1 0) 0))

    ; the shape shared with the moon question: a property of the word-form read onto the
    ; referent. Both are that; the moon case was the small one.
    (defn nto-same-shape-as-mond? ()
        (if (eq (nto-sets-coincide? (nto-claims)) 1)
            (if (gt (nto-gram-count) 0) 1 0) 0))

    (defn nto-bit (cond bit) (if cond bit 0))
    (defn norn-temporal-overlay-check ()
        (add (add (add (add (add (add (add
            ; 1 — most of the pasted text is attested. Say that first
            (nto-bit (gt (nto-attested-count)
                         (sub (len (nto-claims)) (nto-attested-count))) 1)
            ; 2 — exactly three claims are not in the sources
            (nto-bit (eq (nto-overlay-count) 3) 10))
            ; 3 — and exactly three claims are derived from the grammar of a name
            (nto-bit (eq (nto-gram-count) 3) 100))
            ; 4 — the two sets coincide row for row: the temporal scheme has ONE source,
            ;     the morphology of three names, and no other
            (nto-bit (eq (nto-sets-coincide? (nto-claims)) 1) 1000))
            ; 5 — the falsifier is in the primary text: Skuld is also a valkyrie, and a
            ;     temporal category does not ride to choose the slain
            (nto-bit (eq (nto-falsifier-holds?) 1) 10000))
            ; 6 — two claims are partly-attested framings rather than plain errors:
            ;     the Moirai-shaped spin-and-cut division, and "the three" for many
            (nto-bit (eq (nto-count (nto-claims) nto-partly?) 2) 100000))
            ; 7 — same shape as the moon question: a property of the word-form read onto
            ;     the referent. This one produced a metaphysics
            (nto-bit (eq (nto-same-shape-as-mond?) 1) 1000000))
            ; 8 — and the attested core survives all of it: the myth is not diminished by
            ;     losing the overlay, only by being asked to carry what it never said
            (nto-bit (gt (nto-attested-count) 6) 10000000)))
    0)
