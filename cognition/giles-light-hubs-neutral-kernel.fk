; giles-light-hubs-neutral-kernel.fk — one surface-independent meaning graph.
;
; The exact English transmission is identified elsewhere by source id 13 and
; its SHA-256. It is not copied here. This cell carries the selected semantic
; kernel as numeric facts:
;
;   [subject-node, relation-node, object-node, evidence-node, order]
;
; No NL or PL spelling participates in those identities. English and
; Indonesian are registered NL projections; Form and Python are registered PL
; data projections. A target outside those adapters returns nothing. Thus the
; graph is ready for additional NL/PL adapters without pretending that every
; language's grammar, lexicon, or cultural framing has already been built.
;
; The extraction remains human-witnessed and intentionally lossy: it preserves
; the functional kernel, reported place order, practical proposals, one
; phenomenological claim, attribution, and scoped reuse. It does not claim to
; reconstruct the source's complete wording, cadence, metaphor, or vision.
;
; witnessed: 2026-07-26 -> native band; pure structure 127 four-way
import "language-neutral-symbol-identity.fk"

(do
  (defn glhn-node (type instance) (lnsi-node 3 41 type instance))

  (defn glhn-type-concept () 1)
  (defn glhn-type-action () 2)
  (defn glhn-type-place () 3)
  (defn glhn-type-practice () 4)
  (defn glhn-type-relation () 5)
  (defn glhn-type-evidence () 6)

  ; Concepts and participants.
  (defn glhn-hub () (glhn-node (glhn-type-concept) 1))
  (defn glhn-body () (glhn-node (glhn-type-concept) 2))
  (defn glhn-transmission () (glhn-node (glhn-type-concept) 3))
  (defn glhn-land () (glhn-node (glhn-type-concept) 10))
  (defn glhn-community () (glhn-node (glhn-type-concept) 11))
  (defn glhn-nature () (glhn-node (glhn-type-concept) 12))
  (defn glhn-practice () (glhn-node (glhn-type-concept) 13))
  (defn glhn-service () (glhn-node (glhn-type-concept) 14))
  (defn glhn-electric-current () (glhn-node (glhn-type-concept) 15))
  (defn glhn-giles () (glhn-node (glhn-type-concept) 16))
  (defn glhn-scoped-reuse () (glhn-node (glhn-type-concept) 17))

  ; Verbs are action nodes, not English words.
  (defn glhn-ground () (glhn-node (glhn-type-action) 1))
  (defn glhn-connect () (glhn-node (glhn-type-action) 2))
  (defn glhn-remember () (glhn-node (glhn-type-action) 3))
  (defn glhn-nurture () (glhn-node (glhn-type-action) 4))
  (defn glhn-create () (glhn-node (glhn-type-action) 5))
  (defn glhn-serve () (glhn-node (glhn-type-action) 6))

  ; Reported and envisioned places.
  (defn glhn-hati-suci () (glhn-node (glhn-type-place) 1))
  (defn glhn-cacao-forest () (glhn-node (glhn-type-place) 2))
  (defn glhn-nacpan-beach () (glhn-node (glhn-type-place) 3))
  (defn glhn-europe-future () (glhn-node (glhn-type-place) 4))

  ; Practical proposal nodes.
  (defn glhn-food-forests () (glhn-node (glhn-type-practice) 1))
  (defn glhn-medicinal-plants () (glhn-node (glhn-type-practice) 2))
  (defn glhn-plant-farming () (glhn-node (glhn-type-practice) 3))
  (defn glhn-wellbeing-education () (glhn-node (glhn-type-practice) 4))
  (defn glhn-land-living () (glhn-node (glhn-type-practice) 5))
  (defn glhn-qigong () (glhn-node (glhn-type-practice) 6))
  (defn glhn-dance () (glhn-node (glhn-type-practice) 7))
  (defn glhn-breath () (glhn-node (glhn-type-practice) 8))
  (defn glhn-yoga () (glhn-node (glhn-type-practice) 9))
  (defn glhn-barefoot-walk () (glhn-node (glhn-type-practice) 10))
  (defn glhn-silent-spaces () (glhn-node (glhn-type-practice) 11))
  (defn glhn-labyrinths () (glhn-node (glhn-type-practice) 12))
  (defn glhn-bee-sanctuaries () (glhn-node (glhn-type-practice) 13))
  (defn glhn-wormeries () (glhn-node (glhn-type-practice) 14))
  (defn glhn-compost-toilets () (glhn-node (glhn-type-practice) 15))
  (defn glhn-village-schools () (glhn-node (glhn-type-practice) 16))
  (defn glhn-animal-care () (glhn-node (glhn-type-practice) 17))
  (defn glhn-communal-kitchens () (glhn-node (glhn-type-practice) 18))

  ; Relations remain distinct from the concepts they connect.
  (defn glhn-includes () (glhn-node (glhn-type-relation) 1))
  (defn glhn-enacts () (glhn-node (glhn-type-relation) 2))
  (defn glhn-located-at () (glhn-node (glhn-type-relation) 3))
  (defn glhn-offers () (glhn-node (glhn-type-relation) 4))
  (defn glhn-experiences () (glhn-node (glhn-type-relation) 5))
  (defn glhn-attributed-to () (glhn-node (glhn-type-relation) 6))
  (defn glhn-authorized-for () (glhn-node (glhn-type-relation) 7))

  ; Evidence/modalities prevent a transmitted vision from becoming an
  ; externally verified fact merely because it entered the graph.
  (defn glhn-evidence-structure () (glhn-node (glhn-type-evidence) 1))
  (defn glhn-evidence-reported () (glhn-node (glhn-type-evidence) 2))
  (defn glhn-evidence-visionary () (glhn-node (glhn-type-evidence) 3))
  (defn glhn-evidence-proposal () (glhn-node (glhn-type-evidence) 4))
  (defn glhn-evidence-phenomenological () (glhn-node (glhn-type-evidence) 5))
  (defn glhn-evidence-member-witnessed () (glhn-node (glhn-type-evidence) 6))

  (defn glhn-fact (subject relation object evidence order)
    (list subject relation object evidence order))
  (defn glhn-fact-subject (f) (nth f 0))
  (defn glhn-fact-relation (f) (nth f 1))
  (defn glhn-fact-object (f) (nth f 2))
  (defn glhn-fact-evidence (f) (nth f 3))
  (defn glhn-fact-order (f) (nth f 4))

  (defn glhn-core-concepts ()
    (list (glhn-land) (glhn-community) (glhn-nature)
      (glhn-practice) (glhn-service)))
  (defn glhn-core-facts ()
    (list
      (glhn-fact (glhn-hub) (glhn-includes) (glhn-land)
        (glhn-evidence-structure) 1)
      (glhn-fact (glhn-hub) (glhn-includes) (glhn-community)
        (glhn-evidence-structure) 2)
      (glhn-fact (glhn-hub) (glhn-includes) (glhn-nature)
        (glhn-evidence-structure) 3)
      (glhn-fact (glhn-hub) (glhn-includes) (glhn-practice)
        (glhn-evidence-structure) 4)
      (glhn-fact (glhn-hub) (glhn-includes) (glhn-service)
        (glhn-evidence-structure) 5)))

  (defn glhn-action-facts ()
    (list
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-ground)
        (glhn-evidence-structure) 1)
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-connect)
        (glhn-evidence-structure) 2)
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-remember)
        (glhn-evidence-structure) 3)
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-nurture)
        (glhn-evidence-structure) 4)
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-create)
        (glhn-evidence-structure) 5)
      (glhn-fact (glhn-hub) (glhn-enacts) (glhn-serve)
        (glhn-evidence-structure) 6)))

  (defn glhn-place-facts ()
    (list
      (glhn-fact (glhn-hub) (glhn-located-at) (glhn-hati-suci)
        (glhn-evidence-reported) 1)
      (glhn-fact (glhn-hub) (glhn-located-at) (glhn-cacao-forest)
        (glhn-evidence-reported) 2)
      (glhn-fact (glhn-hub) (glhn-located-at) (glhn-nacpan-beach)
        (glhn-evidence-reported) 3)
      (glhn-fact (glhn-hub) (glhn-located-at) (glhn-europe-future)
        (glhn-evidence-visionary) 4)))

  (defn glhn-practice-facts ()
    (list
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-food-forests)
        (glhn-evidence-proposal) 1)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-medicinal-plants)
        (glhn-evidence-proposal) 2)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-plant-farming)
        (glhn-evidence-proposal) 3)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-wellbeing-education)
        (glhn-evidence-proposal) 4)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-land-living)
        (glhn-evidence-proposal) 5)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-qigong)
        (glhn-evidence-proposal) 6)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-dance)
        (glhn-evidence-proposal) 7)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-breath)
        (glhn-evidence-proposal) 8)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-yoga)
        (glhn-evidence-proposal) 9)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-barefoot-walk)
        (glhn-evidence-proposal) 10)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-silent-spaces)
        (glhn-evidence-proposal) 11)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-labyrinths)
        (glhn-evidence-proposal) 12)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-bee-sanctuaries)
        (glhn-evidence-proposal) 13)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-wormeries)
        (glhn-evidence-proposal) 14)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-compost-toilets)
        (glhn-evidence-proposal) 15)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-village-schools)
        (glhn-evidence-proposal) 16)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-animal-care)
        (glhn-evidence-proposal) 17)
      (glhn-fact (glhn-hub) (glhn-offers) (glhn-communal-kitchens)
        (glhn-evidence-proposal) 18)))

  (defn glhn-phenomenology-facts ()
    (list
      (glhn-fact (glhn-body) (glhn-experiences) (glhn-electric-current)
        (glhn-evidence-phenomenological) 1)))

  (defn glhn-provenance-facts ()
    (list
      (glhn-fact (glhn-transmission) (glhn-attributed-to) (glhn-giles)
        (glhn-evidence-member-witnessed) 1)
      (glhn-fact (glhn-transmission) (glhn-authorized-for)
        (glhn-scoped-reuse) (glhn-evidence-member-witnessed) 2)))

  (defn glhn-append (left right)
    (if (eq (len left) 0) right
      (cons (head left) (glhn-append (tail left) right))))
  (defn glhn-graph ()
    (glhn-append (glhn-core-facts)
      (glhn-append (glhn-action-facts)
        (glhn-append (glhn-place-facts)
          (glhn-append (glhn-practice-facts)
            (glhn-append (glhn-phenomenology-facts)
              (glhn-provenance-facts)))))))

  (defn glhn-fact-valid? (f)
    (if (and (eq (len f) 5)
      (and (gt (glhn-fact-subject f) 1)
      (and (gt (glhn-fact-relation f) 1)
      (and (gt (glhn-fact-object f) 1)
      (and (gt (glhn-fact-evidence f) 1)
           (ge (glhn-fact-order f) 0)))))) 1 0))
  (defn glhn-valid-fact-count-loop (facts n)
    (if (eq (len facts) 0) n
      (glhn-valid-fact-count-loop (tail facts)
        (add n (glhn-fact-valid? (head facts))))))
  (defn glhn-valid-fact-count ()
    (glhn-valid-fact-count-loop (glhn-graph) 0))

  ; Pure integer/list projection for the four proof walkers.
  (defn glhn-structure-witness ()
    (add
      (if (eq (len (glhn-graph)) 36) 1 0)
      (add
        (if (eq (len (glhn-core-facts)) 5) 2 0)
        (add
          (if (eq (len (glhn-action-facts)) 6) 4 0)
          (add
            (if (eq (len (glhn-place-facts)) 4) 8 0)
            (add
              (if (eq (len (glhn-practice-facts)) 18) 16 0)
              (add
                (if (and
                  (eq (len (glhn-phenomenology-facts)) 1)
                  (eq (len (glhn-provenance-facts)) 2)) 32 0)
                (if (and
                  (eq (glhn-valid-fact-count) 36)
                  (eq (glhn-hub) (glhn-node 1 1))) 64 0))))))))

  ; A bilingual row is surface evidence for one numeric node. Adding or
  ; changing a label cannot change that node.
  (defn glhn-bilingual (node en id) (list node en id))
  (defn glhn-bilingual-rows ()
    (list
      (glhn-bilingual (glhn-hub) "light hub" "pusat cahaya")
      (glhn-bilingual (glhn-body) "body" "tubuh")
      (glhn-bilingual (glhn-transmission) "transmission" "transmisi")
      (glhn-bilingual (glhn-land) "land" "lahan")
      (glhn-bilingual (glhn-community) "community" "komunitas")
      (glhn-bilingual (glhn-nature) "nature" "alam")
      (glhn-bilingual (glhn-practice) "practice" "praktik")
      (glhn-bilingual (glhn-service) "service" "pelayanan")
      (glhn-bilingual (glhn-electric-current)
        "dynamic electric current" "arus listrik dinamis")
      (glhn-bilingual (glhn-giles) "Giles" "Giles")
      (glhn-bilingual (glhn-scoped-reuse)
        "scoped quotation, translation, reasoning, and training reuse"
        "penggunaan ulang terbatas untuk kutipan, terjemahan, penalaran, dan pelatihan")

      (glhn-bilingual (glhn-ground) "grounding" "membumi")
      (glhn-bilingual (glhn-connect) "connecting" "menghubungkan")
      (glhn-bilingual (glhn-remember) "remembering" "mengingat")
      (glhn-bilingual (glhn-nurture) "nurturing" "memelihara")
      (glhn-bilingual (glhn-create) "creating" "mencipta")
      (glhn-bilingual (glhn-serve) "serving" "melayani")

      (glhn-bilingual (glhn-hati-suci)
        "Hati Suci Sanctuary" "Suaka Hati Suci")
      (glhn-bilingual (glhn-cacao-forest)
        "Cacao Forest, Bali" "Hutan Kakao, Bali")
      (glhn-bilingual (glhn-nacpan-beach)
        "Nacpan Beach, Palawan, Philippines"
        "Pantai Nacpan, Palawan, Filipina")
      (glhn-bilingual (glhn-europe-future)
        "future European hub" "pusat Eropa masa depan")

      (glhn-bilingual (glhn-food-forests) "food forests" "hutan pangan")
      (glhn-bilingual (glhn-medicinal-plants)
        "medicinal plants" "tanaman obat")
      (glhn-bilingual (glhn-plant-farming)
        "plant farming" "budidaya tanaman")
      (glhn-bilingual (glhn-wellbeing-education)
        "wellbeing education" "pendidikan kesejahteraan")
      (glhn-bilingual (glhn-land-living)
        "land-based living" "hidup berbasis lahan")
      (glhn-bilingual (glhn-qigong) "qigong" "qigong")
      (glhn-bilingual (glhn-dance) "dance" "tari")
      (glhn-bilingual (glhn-breath) "breath practice" "latihan napas")
      (glhn-bilingual (glhn-yoga) "yoga" "yoga")
      (glhn-bilingual (glhn-barefoot-walk)
        "barefoot silent walking" "berjalan hening tanpa alas kaki")
      (glhn-bilingual (glhn-silent-spaces) "silent spaces" "ruang hening")
      (glhn-bilingual (glhn-labyrinths) "labyrinths" "labirin")
      (glhn-bilingual (glhn-bee-sanctuaries)
        "bee sanctuaries" "suaka lebah")
      (glhn-bilingual (glhn-wormeries)
        "sewage wormeries" "pengolahan limbah dengan cacing")
      (glhn-bilingual (glhn-compost-toilets)
        "compost toilets" "toilet kompos")
      (glhn-bilingual (glhn-village-schools)
        "village schools" "sekolah desa")
      (glhn-bilingual (glhn-animal-care)
        "animal-care houses" "rumah perawatan hewan")
      (glhn-bilingual (glhn-communal-kitchens)
        "communal kitchens" "dapur komunal")

      (glhn-bilingual (glhn-includes) "includes" "mencakup")
      (glhn-bilingual (glhn-enacts) "enacts" "mewujudkan")
      (glhn-bilingual (glhn-located-at) "is located at" "berlokasi di")
      (glhn-bilingual (glhn-offers) "offers" "menyediakan")
      (glhn-bilingual (glhn-experiences) "experiences" "mengalami")
      (glhn-bilingual (glhn-attributed-to)
        "is attributed to" "diatribusikan kepada")
      (glhn-bilingual (glhn-authorized-for)
        "is authorized for" "diizinkan untuk")

      (glhn-bilingual (glhn-evidence-structure)
        "structural paraphrase" "parafrasa struktural")
      (glhn-bilingual (glhn-evidence-reported)
        "reported in transmission" "dilaporkan dalam transmisi")
      (glhn-bilingual (glhn-evidence-visionary)
        "visionary statement" "pernyataan visioner")
      (glhn-bilingual (glhn-evidence-proposal)
        "practical proposal" "usulan praktis")
      (glhn-bilingual (glhn-evidence-phenomenological)
        "phenomenological report" "laporan fenomenologis")
      (glhn-bilingual (glhn-evidence-member-witnessed)
        "member-witnessed permission" "izin yang disaksikan anggota")))

  (defn glhn-bilingual-find (rows node)
    (if (eq (len rows) 0) (nothing)
      (if (eq (nth (head rows) 0) node) (head rows)
        (glhn-bilingual-find (tail rows) node))))
  (defn glhn-nl-surface (locale node)
    (do
      (let row (glhn-bilingual-find (glhn-bilingual-rows) node))
      (if (nothing? row) (nothing)
        (if (str_eq locale "en") (nth row 1)
          (if (str_eq locale "id") (nth row 2) (nothing))))))

  (defn glhn-cat (parts)
    (if (eq (len parts) 0) ""
      (str_concat (head parts) (glhn-cat (tail parts)))))
  (defn glhn-digit-char (digit) (byte_to_str (add digit 48)))
  (defn glhn-int-to-str-positive (n)
    (if (lt n 10) (glhn-digit-char n)
      (str_concat (glhn-int-to-str-positive (div n 10))
        (glhn-digit-char (mod n 10)))))
  (defn glhn-int-to-str (n)
    (if (eq n 0) "0"
      (if (lt n 0)
        (str_concat "-" (glhn-int-to-str-positive (sub 0 n)))
        (glhn-int-to-str-positive n))))
  (defn glhn-reverse-loop (xs acc)
    (if (eq (len xs) 0) acc
      (glhn-reverse-loop (tail xs) (cons (head xs) acc))))

  ; Controlled NL realization. It is a complete normalized fact projection,
  ; not a claim of literary translation or target-native rhetorical style.
  (defn glhn-render-nl-fact (locale fact)
    (do
      (let subject (glhn-nl-surface locale (glhn-fact-subject fact)))
      (let relation (glhn-nl-surface locale (glhn-fact-relation fact)))
      (let object (glhn-nl-surface locale (glhn-fact-object fact)))
      (let evidence (glhn-nl-surface locale (glhn-fact-evidence fact)))
      (if (or (nothing? subject)
        (or (nothing? relation)
        (or (nothing? object) (nothing? evidence))))
        (nothing)
        (glhn-cat (list subject " " relation " " object
          " [" evidence "; order="
          (glhn-int-to-str (glhn-fact-order fact)) "]")))))

  ; PL realization is data, not a fabricated executable behavior.
  (defn glhn-render-form-fact (fact)
    (glhn-cat (list "(list "
      (glhn-int-to-str (glhn-fact-subject fact)) " "
      (glhn-int-to-str (glhn-fact-relation fact)) " "
      (glhn-int-to-str (glhn-fact-object fact)) " "
      (glhn-int-to-str (glhn-fact-evidence fact)) " "
      (glhn-int-to-str (glhn-fact-order fact)) ")")))
  (defn glhn-render-python-fact (fact)
    (glhn-cat (list "("
      (glhn-int-to-str (glhn-fact-subject fact)) ", "
      (glhn-int-to-str (glhn-fact-relation fact)) ", "
      (glhn-int-to-str (glhn-fact-object fact)) ", "
      (glhn-int-to-str (glhn-fact-evidence fact)) ", "
      (glhn-int-to-str (glhn-fact-order fact)) ")")))
  (defn glhn-render-pl-fact (language fact)
    (if (str_eq language "form") (glhn-render-form-fact fact)
      (if (str_eq language "python") (glhn-render-python-fact fact)
        (nothing))))

  (defn glhn-render-fact (plane target fact)
    (if (eq plane 1) (glhn-render-nl-fact target fact)
      (if (eq plane 2) (glhn-render-pl-fact target fact) (nothing))))
  (defn glhn-render-loop (facts plane target acc)
    (if (eq (len facts) 0) (glhn-reverse-loop acc (list))
      (do
        (let rendered (glhn-render-fact plane target (head facts)))
        (if (nothing? rendered) (nothing)
          (glhn-render-loop (tail facts) plane target
            (cons rendered acc))))))
  (defn glhn-render (plane target)
    (glhn-render-loop (glhn-graph) plane target (list)))

  ; Stable bounded graph digest for equality checks across surface projections.
  (defn glhn-fact-digest (fact)
    (mod
      (add (glhn-fact-subject fact)
        (add (mul (glhn-fact-relation fact) 3)
          (add (mul (glhn-fact-object fact) 5)
            (add (mul (glhn-fact-evidence fact) 7)
              (mul (glhn-fact-order fact) 11)))))
      1000000007))
  (defn glhn-graph-digest-loop (facts acc)
    (if (eq (len facts) 0) acc
      (glhn-graph-digest-loop (tail facts)
        (mod (add (mul acc 31) (glhn-fact-digest (head facts)))
          1000000007))))
  (defn glhn-graph-digest ()
    (glhn-graph-digest-loop (glhn-graph) 17))

  ; Losses: source wording absent; semantic selection is a paraphrase;
  ; extraction is human-witnessed rather than a native general NL parser.
  (defn glhn-losses () (list 1 1 1))
  (defn glhn-extraction-human-witnessed () 1)
  (defn glhn-native-general-parser () 0)
  (defn glhn-witness-node () (glhn-node 99 1))

  0)
