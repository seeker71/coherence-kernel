; session-neutral-phrase-graph.fk — actual adjacent token spans become
; language-specific expression cells over form-neutral candidate symbols.
;
; This cell has no phrase table. A caller chooses a span band, normally two to
; three tokens, and the body constructs expression identity from the exact
; locale, surface bytes, and expression facets that arrived. Candidate meaning
; stays plural. Repetition raises an expression to a repeated expression whose
; meaning is still open; recurrence alone never manufactures an idiom.
;
; A single meaning sits only through an explicit binding to a closed definition
; recipe made entirely from neutral addresses already active in the session
; dictionary (plus the kernel's structural symbols). The meaning address is the
; definition recipe itself under namespace 8, so two expressions in different
; locales receive the same meaning address when and only when they carry the
; same neutral recipe. No English phrase key participates in that identity.
;
; Directed edges use existing neutral structural relations:
;   separate-parts: expression/meaning -> component symbol
;   flow:           candidate at position n -> candidate at position n+1
;   reference:      expression -> explicitly bound meaning
; The same edge body is queryable from either endpoint.
;
; Phrase field shape is a candidate-set projection across every field-bearing
; candidate in the observed span. It is reproducible evidence, not selected
; contextual sense and not intrinsic frequency.
;
; witnessed: 2026-08-24 -> phrase graph band 32767 on fkwu
; preludes: cognition/session-neutral-semantic-reflection.fk

(do
  (defn snsp-expression-part (token)
    (list (nmfe-string-bytes (snsf-t-surface token))
      (snsf-t-expression-case token)))
  (defn snsp-expression-parts (rows)
    (if (eq (len rows) 0) (empty)
      (cons (snsp-expression-part (head rows))
        (snsp-expression-parts (tail rows)))))
  (defn snsp-expression-address (rows)
    (snsf-address 10
      (list (nmfe-string-bytes (snsf-t-locale (head rows)))
        (snsp-expression-parts rows))))

  (defn snsp-token-addresses (candidates)
    (if (eq (len candidates) 0) (empty)
      (cons (snsf-c-address (head candidates))
        (snsp-token-addresses (tail candidates)))))
  (defn snsp-address-sets (rows)
    (if (eq (len rows) 0) (empty)
      (cons (snsp-token-addresses (snsf-t-candidates (head rows)))
        (snsp-address-sets (tail rows)))))
  (defn snsp-surfaces (rows)
    (if (eq (len rows) 0) (empty)
      (cons (snsf-t-surface (head rows)) (snsp-surfaces (tail rows)))))
  (defn snsp-ordinals (rows)
    (if (eq (len rows) 0) (empty)
      (cons (snsf-t-ordinal (head rows)) (snsp-ordinals (tail rows)))))

  ; composition recipe = begin, candidate-set, flow, candidate-set, ..., end.
  ; Candidate sets remain nested so ambiguity cannot collapse into a first hit.
  (defn snsp-composition-body (sets)
    (if (eq (len sets) 0) (empty)
      (if (eq (len (tail sets)) 0) (list (head sets))
        (cons (head sets)
          (cons (snsf-structure-address 9)
            (snsp-composition-body (tail sets)))))))
  (defn snsp-composition-recipe (sets)
    (cons (snsf-structure-address 0)
      (append (snsp-composition-body sets)
        (list (snsf-structure-address 1)))))

  ; Projection uses the candidates that actually sat in the span. Every
  ; ambiguity contributes openly; the state names this rather than implying a
  ; contextual selection.
  (defn snsp-project-candidates (candidates projection)
    (if (eq (len candidates) 0) projection
      (do
        (let candidate (head candidates))
        (let field (snsf-c-field candidate))
        (snsp-project-candidates (tail candidates)
          (if (eq (len field) 0) projection
            (list (snsf-shape-add (snsf-p-shape projection) field)
              (add (snsf-p-count projection) 1)
              (cons (snsf-c-address candidate)
                (snsf-p-evidence projection))))))))
  (defn snsp-project-rows (rows projection)
    (if (eq (len rows) 0) projection
      (snsp-project-rows (tail rows)
        (snsp-project-candidates (snsf-t-candidates (head rows)) projection))))
  (defn snsp-span-projection (rows)
    (do
      (let p (snsp-project-rows rows (snsf-projection-empty)))
      (if (eq (snsf-p-count p) 0) p
        (list (snsf-shape-div (snsf-p-shape p) (snsf-p-count p))
          (snsf-p-count p) (reverse (snsf-p-evidence p))))))

  ; phrase cell = expression-address, locale, surfaces, source ordinals,
  ; candidate-address sets, composition recipe, occurrence count,
  ; field-state, field, field-evidence.
  (defn snsp-cell-from-rows (rows)
    (do
      (let sets (snsp-address-sets rows))
      (let projection (snsp-span-projection rows))
      (list (snsp-expression-address rows) (snsf-t-locale (head rows))
        (snsp-surfaces rows) (snsp-ordinals rows) sets
        (snsp-composition-recipe sets) 1
        (if (eq (snsf-p-count projection) 0) "field-absence"
          "candidate-set-projection-v1")
        (if (eq (snsf-p-count projection) 0) (empty)
          (snsf-p-shape projection))
        (if (eq (snsf-p-count projection) 0) (empty)
          (snsf-p-evidence projection)))))
  (defn snsp-c-address (cell) (nth cell 0))
  (defn snsp-c-locale (cell) (nth cell 1))
  (defn snsp-c-surfaces (cell) (nth cell 2))
  (defn snsp-c-ordinals (cell) (nth cell 3))
  (defn snsp-c-candidate-sets (cell) (nth cell 4))
  (defn snsp-c-recipe (cell) (nth cell 5))
  (defn snsp-c-count (cell) (nth cell 6))
  (defn snsp-c-field-state (cell) (nth cell 7))
  (defn snsp-c-field (cell) (nth cell 8))
  (defn snsp-c-field-evidence (cell) (nth cell 9))
  (defn snsp-cell-with-count (cell count)
    (list (snsp-c-address cell) (snsp-c-locale cell)
      (snsp-c-surfaces cell) (snsp-c-ordinals cell)
      (snsp-c-candidate-sets cell) (snsp-c-recipe cell) count
      (snsp-c-field-state cell) (snsp-c-field cell)
      (snsp-c-field-evidence cell)))

  (defn snsp-take (rows n)
    (if (or (le n 0) (eq (len rows) 0)) (empty)
      (cons (head rows) (snsp-take (tail rows) (sub n 1)))))
  (defn snsp-spans-at (rows size maximum)
    (if (or (gt size maximum) (lt (len rows) size)) (empty)
      (cons (snsp-cell-from-rows (snsp-take rows size))
        (snsp-spans-at rows (add size 1) maximum))))
  (defn snsp-span-cells-loop (rows minimum maximum)
    (if (lt (len rows) minimum) (empty)
      (append (snsp-spans-at rows minimum maximum)
        (snsp-span-cells-loop (tail rows) minimum maximum))))
  (defn snsp-span-cells (rows minimum maximum)
    (if (or (lt minimum 2) (lt maximum minimum)) (empty)
      (snsp-span-cells-loop rows minimum maximum)))

  ; Observation is an occurrence fold. It preserves one active expression cell
  ; and increments its count for every exact recurrence, within or across turns.
  (defn snsp-upsert (active incoming)
    (if (eq (len active) 0) (list incoming)
      (if (value_eq (snsp-c-address (head active))
                    (snsp-c-address incoming))
        (cons (snsp-cell-with-count incoming
                (add (snsp-c-count (head active))
                     (snsp-c-count incoming)))
          (tail active))
        (cons (head active) (snsp-upsert (tail active) incoming)))))
  (defn snsp-observe-cells (active cells)
    (if (eq (len cells) 0) active
      (snsp-observe-cells (snsp-upsert active (head cells)) (tail cells))))
  (defn snsp-observe (active rows minimum maximum)
    (snsp-observe-cells active (snsp-span-cells rows minimum maximum)))
  (defn snsp-by-expression (active expression-address)
    (if (eq (len active) 0) (empty)
      (if (value_eq expression-address (snsp-c-address (head active)))
        (list (head active))
        (snsp-by-expression (tail active) expression-address))))
  (defn snsp-repeated (active)
    (if (eq (len active) 0) (empty)
      (if (gt (snsp-c-count (head active)) 1)
        (cons (head active) (snsp-repeated (tail active)))
        (snsp-repeated (tail active)))))
  (defn snsp-max-count (active best)
    (if (eq (len active) 0) best
      (snsp-max-count (tail active)
        (if (gt (snsp-c-count (head active)) best)
          (snsp-c-count (head active)) best))))

  ; A definition recipe is closed only when every neutral symbol is active in
  ; the session dictionary or is one of the already-defined structural groups.
  (defn snsp-address-shape? (address)
    (if (and (eq (len address) 3) (eq (nth address 0) 31013)) 1 0))
  (defn snsp-structural-address? (address)
    (if (and (eq (snsp-address-shape? address) 1)
             (and (eq (nth address 1) 3)
                  (and (ge (nth address 2) 0) (lt (nth address 2) 18)))) 1 0))
  (defn snsp-known-address? (dictionary address)
    (if (eq (snsp-address-shape? address) 0) 0
      (if (eq (snsp-structural-address? address) 1) 1
        (if (gt (len (snsr-by-address dictionary address)) 0) 1 0))))
  (defn snsp-definition-closed? (dictionary recipe)
    (if (eq (len recipe) 0) 0
      (if (eq (snsp-known-address? dictionary (head recipe)) 1)
        (if (eq (len (tail recipe)) 0) 1
          (snsp-definition-closed? dictionary (tail recipe))) 0)))

  ; One neutral symbol may be witnessed through several locale surfaces. A
  ; field contributes only when every non-empty witness agrees on its shape.
  (defn snsp-address-field-consensus-loop (entries found shape)
    (if (eq (len entries) 0)
      (if (eq found 0) (empty) (list shape))
      (do
        (let field (snsf-c-field (snsr-e-candidate (head entries))))
        (if (eq (len field) 0)
          (snsp-address-field-consensus-loop (tail entries) found shape)
          (if (eq found 0)
            (snsp-address-field-consensus-loop (tail entries) 1 field)
            (if (value_eq shape field)
              (snsp-address-field-consensus-loop (tail entries) 1 shape)
              (empty)))))))
  (defn snsp-address-field-consensus (dictionary address)
    (snsp-address-field-consensus-loop
      (snsr-by-address dictionary address) 0 (empty)))
  (defn snsp-project-definition-symbols (dictionary recipe projection)
    (if (eq (len recipe) 0) projection
      (do
        (let consensus (snsp-address-field-consensus dictionary (head recipe)))
        (snsp-project-definition-symbols dictionary (tail recipe)
          (if (eq (len consensus) 0) projection
            (list (snsf-shape-add (snsf-p-shape projection) (head consensus))
              (add (snsf-p-count projection) 1)
              (cons (head recipe) (snsf-p-evidence projection))))))))
  ; meaning = content address, closed neutral recipe, field-state, field,
  ; field-evidence. Empty means the supplied recipe was not dictionary-closed.
  (defn snsp-meaning (dictionary recipe)
    (if (eq (snsp-definition-closed? dictionary recipe) 0) (empty)
      (do
        (let p (snsp-project-definition-symbols dictionary recipe
          (snsf-projection-empty)))
        (list (snsf-address 8 recipe) recipe
          (if (eq (snsf-p-count p) 0) "field-absence"
            "definition-symbol-projection-v1")
          (if (eq (snsf-p-count p) 0) (empty)
            (snsf-shape-div (snsf-p-shape p) (snsf-p-count p)))
          (if (eq (snsf-p-count p) 0) (empty)
            (reverse (snsf-p-evidence p)))))))
  (defn snsp-m-address (meaning) (nth meaning 0))
  (defn snsp-m-recipe (meaning) (nth meaning 1))
  (defn snsp-m-field-state (meaning) (nth meaning 2))
  (defn snsp-m-field (meaning) (nth meaning 3))
  (defn snsp-m-field-evidence (meaning) (nth meaning 4))

  ; binding = expression address, meaning, neutral evidence recipe, evidence
  ; state. English state text is metadata, never the binding identity.
  (defn snsp-neutral-address-list? (addresses)
    (if (eq (len addresses) 0) 0
      (if (eq (snsp-address-shape? (head addresses)) 1)
        (if (eq (len (tail addresses)) 0) 1
          (snsp-neutral-address-list? (tail addresses))) 0)))
  ; Binding is accepted only for an expression actually observed in the active
  ; phrase body and for non-empty form-native evidence.
  (defn snsp-binding
    (phrases expression-address meaning evidence-recipe evidence-state)
    (if (or (eq (len meaning) 0)
            (or (eq (len (snsp-by-expression phrases expression-address)) 0)
                (or (eq (snsp-neutral-address-list? evidence-recipe) 0)
                    (eq (str_len evidence-state) 0))))
      (empty) (list expression-address meaning evidence-recipe evidence-state)))
  (defn snsp-b-expression (binding) (nth binding 0))
  (defn snsp-b-meaning (binding) (nth binding 1))
  (defn snsp-b-evidence (binding) (nth binding 2))
  (defn snsp-b-evidence-state (binding) (nth binding 3))
  (defn snsp-same-binding? (a b)
    (if (and (value_eq (snsp-b-expression a) (snsp-b-expression b))
             (value_eq (snsp-m-address (snsp-b-meaning a))
                       (snsp-m-address (snsp-b-meaning b)))) 1 0))
  (defn snsp-binding-in? (binding bindings)
    (if (eq (len bindings) 0) 0
      (if (eq (snsp-same-binding? binding (head bindings)) 1) 1
        (snsp-binding-in? binding (tail bindings)))))
  (defn snsp-add-binding (bindings binding)
    (if (eq (len binding) 0) bindings
      (if (eq (snsp-binding-in? binding bindings) 1) bindings
        (append bindings (list binding)))))
  (defn snsp-bindings-by-expression (bindings expression-address)
    (if (eq (len bindings) 0) (empty)
      (if (value_eq expression-address (snsp-b-expression (head bindings)))
        (cons (head bindings)
          (snsp-bindings-by-expression (tail bindings) expression-address))
        (snsp-bindings-by-expression (tail bindings) expression-address))))
  (defn snsp-bindings-by-meaning (bindings meaning-address)
    (if (eq (len bindings) 0) (empty)
      (if (value_eq meaning-address
            (snsp-m-address (snsp-b-meaning (head bindings))))
        (cons (head bindings)
          (snsp-bindings-by-meaning (tail bindings) meaning-address))
        (snsp-bindings-by-meaning (tail bindings) meaning-address))))
  (defn snsp-expression-state (cell bindings)
    (do
      (let meanings (snsp-bindings-by-expression bindings (snsp-c-address cell)))
      (if (eq (len meanings) 1) "single-neutral-meaning"
        (if (gt (len meanings) 1) "multiple-neutral-meanings"
          (if (gt (snsp-c-count cell) 1)
            "repeated-expression-meaning-open"
            "observed-expression-meaning-open")))))

  ; ── directed graph ───────────────────────────────────────────────
  (defn snsp-edge (from relation to position)
    (list from relation to position))
  (defn snsp-e-from (edge) (nth edge 0))
  (defn snsp-e-relation (edge) (nth edge 1))
  (defn snsp-e-to (edge) (nth edge 2))
  (defn snsp-e-position (edge) (nth edge 3))
  (defn snsp-edge-in? (edge edges)
    (if (eq (len edges) 0) 0
      (if (value_eq edge (head edges)) 1
        (snsp-edge-in? edge (tail edges)))))
  (defn snsp-unique-edges-loop (edges out)
    (if (eq (len edges) 0) (reverse out)
      (snsp-unique-edges-loop (tail edges)
        (if (eq (snsp-edge-in? (head edges) out) 1) out
          (cons (head edges) out)))))
  (defn snsp-unique-edges (edges)
    (snsp-unique-edges-loop edges (empty)))
  (defn snsp-part-edges-set (expression-address addresses position)
    (if (eq (len addresses) 0) (empty)
      (cons (snsp-edge expression-address (snsf-structure-address 10)
              (head addresses) position)
        (snsp-part-edges-set expression-address (tail addresses) position))))
  (defn snsp-part-edges (expression-address sets position)
    (if (eq (len sets) 0) (empty)
      (append (snsp-part-edges-set expression-address (head sets) position)
        (snsp-part-edges expression-address (tail sets) (add position 1)))))
  (defn snsp-flow-from-one (from addresses position)
    (if (eq (len addresses) 0) (empty)
      (cons (snsp-edge from (snsf-structure-address 9)
              (head addresses) position)
        (snsp-flow-from-one from (tail addresses) position))))
  (defn snsp-flow-between (left right position)
    (if (eq (len left) 0) (empty)
      (append (snsp-flow-from-one (head left) right position)
        (snsp-flow-between (tail left) right position))))
  (defn snsp-flow-edges (sets position)
    (if (lt (len sets) 2) (empty)
      (append (snsp-flow-between (head sets) (head (tail sets)) position)
        (snsp-flow-edges (tail sets) (add position 1)))))
  (defn snsp-cell-edges (cell)
    (append (snsp-part-edges (snsp-c-address cell)
              (snsp-c-candidate-sets cell) 0)
      (snsp-flow-edges (snsp-c-candidate-sets cell) 0)))
  (defn snsp-phrase-edges (phrases)
    (if (eq (len phrases) 0) (empty)
      (append (snsp-cell-edges (head phrases))
        (snsp-phrase-edges (tail phrases)))))
  (defn snsp-definition-edges (meaning recipe position)
    (if (eq (len recipe) 0) (empty)
      (cons (snsp-edge (snsp-m-address meaning)
              (snsf-structure-address 10) (head recipe) position)
        (snsp-definition-edges meaning (tail recipe) (add position 1)))))
  (defn snsp-binding-edges (bindings)
    (if (eq (len bindings) 0) (empty)
      (do
        (let binding (head bindings))
        (let meaning (snsp-b-meaning binding))
        (cons (snsp-edge (snsp-b-expression binding)
                (snsf-structure-address 14) (snsp-m-address meaning) 0)
          (append (snsp-definition-edges meaning (snsp-m-recipe meaning) 0)
            (snsp-binding-edges (tail bindings)))))))
  (defn snsp-graph (phrases bindings)
    (snsp-unique-edges
      (append (snsp-phrase-edges phrases) (snsp-binding-edges bindings))))
  (defn snsp-edges-from (edges address)
    (if (eq (len edges) 0) (empty)
      (if (value_eq address (snsp-e-from (head edges)))
        (cons (head edges) (snsp-edges-from (tail edges) address))
        (snsp-edges-from (tail edges) address))))
  (defn snsp-edges-to (edges address)
    (if (eq (len edges) 0) (empty)
      (if (value_eq address (snsp-e-to (head edges)))
        (cons (head edges) (snsp-edges-to (tail edges) address))
        (snsp-edges-to (tail edges) address))))
  (defn snsp-edges-with-relation (edges relation)
    (if (eq (len edges) 0) (empty)
      (if (value_eq relation (snsp-e-relation (head edges)))
        (cons (head edges) (snsp-edges-with-relation (tail edges) relation))
        (snsp-edges-with-relation (tail edges) relation))))

  0)
