; neutral-interchange-v0-gate.fk
;
; The thin, falsifiable door agreed before the language-neutral experiment.
; This is deliberately not the full resolver.  It proves the identity rule,
; holds the non-waivable materiality floor as content-addressed dimensions,
; and returns one of the actual four arms for experiment readiness:
;
;   nothing  malformed or structurally unobserved packet
;   0        an explicit witnessed decline
;   1        every v0 prerequisite is present
;   node     one or more human/community decisions are still owed
;
; A "yes, proceed" authorizes this instrument.  It does not silently freeze a
; predicate inventory, sign a materiality floor, appoint ratifiers, manufacture
; fourteen cases, or create a pre-registration digest.  The committed current
; packet therefore remains a node.
;
; Identity follows the reconciled rule:
;   - a predicate id hashes arity, canonical role bytes, and normative gloss;
;   - GraphId hashes canonical graph bytes containing those predicate ids;
;   - ontology/registry digests are resolution context, never GraphId inputs.
;
; Honest floor:
;   - canonical graph bytes are caller-supplied because their exact byte-level
;     grammar is still a human/community decision;
;   - this gate verifies readiness, not the 150 projections themselves;
;   - signatures and external clock authority are not claimed here.
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk
; preludes: form/form-stdlib/sha256.fk form/form-stdlib/hex.fk

(do
  (defn niv0-string-bytes-loop (s i n)
    (if (ge i n)
      (empty)
      (cons (str_byte_at s i) (niv0-string-bytes-loop s (add i 1) n))))

  (defn niv0-sha256-hex (s)
    (hex-encode (sha256 (niv0-string-bytes-loop s 0 (str_len s)))))

  ; Length-prefixing keeps the predicate composition unambiguous.
  (defn niv0-field-bytes (s)
    (str_concat (int_to_str (str_len s)) (str_concat ":" s)))

  (defn niv0-predicate-bytes (arity canonical-roles normative-gloss)
    (str_concat "niv0-predicate|"
      (str_concat (int_to_str arity)
        (str_concat "|"
          (str_concat (niv0-field-bytes canonical-roles)
            (str_concat "|" (niv0-field-bytes normative-gloss)))))))

  (defn niv0-predicate-id (arity canonical-roles normative-gloss)
    (niv0-sha256-hex
      (niv0-predicate-bytes arity canonical-roles normative-gloss)))

  (defn niv0-predicate-active () 1)
  (defn niv0-predicate-deprecated () 2)
  (defn niv0-predicate-tombstoned () 3)

  (defn niv0-predicate
      (arity canonical-roles normative-gloss state)
    (list "NeutralInterchangeV0Predicate"
      (niv0-predicate-id arity canonical-roles normative-gloss)
      arity canonical-roles normative-gloss state))

  (defn niv0-predicate-id-of (p) (nth p 1))
  (defn niv0-predicate-arity (p) (nth p 2))
  (defn niv0-predicate-roles (p) (nth p 3))
  (defn niv0-predicate-gloss (p) (nth p 4))
  (defn niv0-predicate-state (p) (nth p 5))

  (defn niv0-predicate-state? (state)
    (if (or
      (eq state (niv0-predicate-active))
      (or
        (eq state (niv0-predicate-deprecated))
        (eq state (niv0-predicate-tombstoned)))) 1 0))

  (defn niv0-predicate? (p)
    (if (eq (len p) 6)
      (if (str_eq (nth p 0) "NeutralInterchangeV0Predicate")
        (if (eq (niv0-predicate-state? (niv0-predicate-state p)) 1)
          (if (str_eq
            (niv0-predicate-id-of p)
            (niv0-predicate-id
              (niv0-predicate-arity p)
              (niv0-predicate-roles p)
              (niv0-predicate-gloss p))) 1 0)
          0)
        0)
      0))

  (defn niv0-predicate-resolvable? (p)
    (if (eq (niv0-predicate? p) 1)
      (if (eq (niv0-predicate-state p) (niv0-predicate-tombstoned)) 0 1)
      0))

  (defn niv0-graph-id (canonical-graph-bytes)
    (niv0-sha256-hex
      (str_concat "niv0-graph|"
        (niv0-field-bytes canonical-graph-bytes))))

  (defn niv0-resolution-context
      (graph-id ontology-digest registry-digest)
    (list "NeutralInterchangeV0ResolutionContext"
      graph-id ontology-digest registry-digest))

  (defn niv0-context-graph-id (context) (nth context 1))
  (defn niv0-context-ontology-digest (context) (nth context 2))
  (defn niv0-context-registry-digest (context) (nth context 3))

  ; Content-addressed minimum dimensions a resolver may never guess away.
  ; Whether this exact eight-member floor is signed remains a community node.
  (defn niv0-loss-polarity ()
    (niv0-predicate-id 1 "severity"
      "whether a proposition is affirmed or negated"))
  (defn niv0-loss-quantifier-scope ()
    (niv0-predicate-id 1 "severity"
      "which quantified expression scopes over which proposition"))
  (defn niv0-loss-deontic-force ()
    (niv0-predicate-id 1 "severity"
      "whether an act is permitted required or recommended"))
  (defn niv0-loss-epistemic-strength ()
    (niv0-predicate-id 1 "severity"
      "whether a proposition is certain likely possible or unknown"))
  (defn niv0-loss-temporal-aspect ()
    (niv0-predicate-id 1 "severity"
      "the temporal and aspectual anchoring of an event or state"))
  (defn niv0-loss-agent-patient ()
    (niv0-predicate-id 1 "severity"
      "which participant acts and which participant is affected"))
  (defn niv0-loss-numeric-unit ()
    (niv0-predicate-id 1 "severity"
      "numeric magnitude together with its unit"))
  (defn niv0-loss-named-referent ()
    (niv0-predicate-id 1 "severity"
      "the identity of a specifically named referent"))

  (defn niv0-materiality-floor ()
    (list
      (niv0-loss-polarity)
      (niv0-loss-quantifier-scope)
      (niv0-loss-deontic-force)
      (niv0-loss-epistemic-strength)
      (niv0-loss-temporal-aspect)
      (niv0-loss-agent-patient)
      (niv0-loss-numeric-unit)
      (niv0-loss-named-referent)))

  (defn niv0-string-member? (needle xs)
    (if (eq (len xs) 0)
      0
      (if (str_eq needle (head xs))
        1
        (niv0-string-member? needle (tail xs)))))

  (defn niv0-unique-strings? (xs seen)
    (if (eq (len xs) 0)
      1
      (if (eq (niv0-string-member? (head xs) seen) 1)
        0
        (niv0-unique-strings? (tail xs) (cons (head xs) seen)))))

  (defn niv0-floor-unique? ()
    (niv0-unique-strings? (niv0-materiality-floor) (empty)))

  (defn niv0-hex-byte? (b)
    (if (or
      (and (ge b 48) (le b 57))
      (and (ge b 97) (le b 102))) 1 0))

  (defn niv0-hex-string-loop? (s i)
    (if (ge i (str_len s))
      1
      (if (eq (niv0-hex-byte? (str_byte_at s i)) 1)
        (niv0-hex-string-loop? s (add i 1))
        0)))

  (defn niv0-digest? (s)
    (if (eq (str_len s) 64)
      (niv0-hex-string-loop? s 0)
      0))

  (defn niv0-bit? (x) (if (or (eq x 0) (eq x 1)) 1 0))
  (defn niv0-decision-pending () 0)
  (defn niv0-decision-accepted () 1)
  (defn niv0-decision-declined () 2)

  ; decision, frozen predicate inventory, frozen serializer, signed floor,
  ; named ratifier authority, immutable preregistration digest, case count,
  ; NL target count, PL/Form target count, mandatory-category-rich NL target,
  ; bounded domain, adapter depth, graph-phase-only policy, no execution.
  (defn niv0-pilot-packet
      (decision predicates-frozen serializer-frozen floor-signed
       ratifier-named preregistration-digest case-count
       nl-targets pl-targets mandatory-rich-target bounded-domain
       adapter-depth graph-policy-only no-execution)
    (list decision predicates-frozen serializer-frozen floor-signed
      ratifier-named preregistration-digest case-count
      nl-targets pl-targets mandatory-rich-target bounded-domain
      adapter-depth graph-policy-only no-execution))

  (defn niv0-packet-decision (p) (nth p 0))
  (defn niv0-packet-predicates-frozen (p) (nth p 1))
  (defn niv0-packet-serializer-frozen (p) (nth p 2))
  (defn niv0-packet-floor-signed (p) (nth p 3))
  (defn niv0-packet-ratifier-named (p) (nth p 4))
  (defn niv0-packet-preregistration-digest (p) (nth p 5))
  (defn niv0-packet-case-count (p) (nth p 6))
  (defn niv0-packet-nl-targets (p) (nth p 7))
  (defn niv0-packet-pl-targets (p) (nth p 8))
  (defn niv0-packet-mandatory-rich-target (p) (nth p 9))
  (defn niv0-packet-bounded-domain (p) (nth p 10))
  (defn niv0-packet-adapter-depth (p) (nth p 11))
  (defn niv0-packet-graph-policy-only (p) (nth p 12))
  (defn niv0-packet-no-execution (p) (nth p 13))

  (defn niv0-decision? (decision)
    (if (or
      (eq decision (niv0-decision-pending))
      (or
        (eq decision (niv0-decision-accepted))
        (eq decision (niv0-decision-declined)))) 1 0))

  (defn niv0-packet? (p)
    (if (eq (len p) 14)
      (if (eq (niv0-decision? (niv0-packet-decision p)) 1)
        (if (and
          (eq (niv0-bit? (niv0-packet-predicates-frozen p)) 1)
          (and
            (eq (niv0-bit? (niv0-packet-serializer-frozen p)) 1)
            (and
              (eq (niv0-bit? (niv0-packet-floor-signed p)) 1)
              (and
                (eq (niv0-bit? (niv0-packet-ratifier-named p)) 1)
                (and
                  (eq (niv0-bit? (niv0-packet-mandatory-rich-target p)) 1)
                  (and
                    (eq (niv0-bit? (niv0-packet-bounded-domain p)) 1)
                    (and
                      (eq (niv0-bit? (niv0-packet-graph-policy-only p)) 1)
                      (eq (niv0-bit? (niv0-packet-no-execution p)) 1)))))))) 1 0)
        0)
      0))

  ; Reason 0 means ready.  The remaining numbers are stable query nodes:
  ; 1 malformed, 2 decision pending, 3 predicates, 4 serializer, 5 floor,
  ; 6 ratifier, 7 preregistration, 8 cases, 9 NL count, 10 PL count,
  ; 11 mandatory-rich target, 12 bounded domain, 13 depth,
  ; 14 graph policy, 15 no-execution.
  (defn niv0-first-owed-reason (p)
    (if (not (eq (niv0-packet-decision p) (niv0-decision-accepted))) 2
    (if (not (eq (niv0-packet-predicates-frozen p) 1)) 3
    (if (not (eq (niv0-packet-serializer-frozen p) 1)) 4
    (if (not (eq (niv0-packet-floor-signed p) 1)) 5
    (if (not (eq (niv0-packet-ratifier-named p) 1)) 6
    (if (not (eq (niv0-digest?
      (niv0-packet-preregistration-digest p)) 1)) 7
    (if (not (eq (niv0-packet-case-count p) 50)) 8
    (if (not (eq (niv0-packet-nl-targets p) 2)) 9
    (if (not (eq (niv0-packet-pl-targets p) 1)) 10
    (if (not (eq (niv0-packet-mandatory-rich-target p) 1)) 11
    (if (not (eq (niv0-packet-bounded-domain p) 1)) 12
    (if (not (eq (niv0-packet-adapter-depth p) 1)) 13
    (if (not (eq (niv0-packet-graph-policy-only p) 1)) 14
    (if (not (eq (niv0-packet-no-execution p) 1)) 15
      0)))))))))))))))

  (defn niv0-owed-cons (ok reason rest)
    (if ok rest (cons reason rest)))

  (defn niv0-owed-reasons (p)
    (niv0-owed-cons (eq (niv0-packet-decision p) (niv0-decision-accepted)) 2
    (niv0-owed-cons (eq (niv0-packet-predicates-frozen p) 1) 3
    (niv0-owed-cons (eq (niv0-packet-serializer-frozen p) 1) 4
    (niv0-owed-cons (eq (niv0-packet-floor-signed p) 1) 5
    (niv0-owed-cons (eq (niv0-packet-ratifier-named p) 1) 6
    (niv0-owed-cons (eq (niv0-digest?
      (niv0-packet-preregistration-digest p)) 1) 7
    (niv0-owed-cons (eq (niv0-packet-case-count p) 50) 8
    (niv0-owed-cons (eq (niv0-packet-nl-targets p) 2) 9
    (niv0-owed-cons (eq (niv0-packet-pl-targets p) 1) 10
    (niv0-owed-cons (eq (niv0-packet-mandatory-rich-target p) 1) 11
    (niv0-owed-cons (eq (niv0-packet-bounded-domain p) 1) 12
    (niv0-owed-cons (eq (niv0-packet-adapter-depth p) 1) 13
    (niv0-owed-cons (eq (niv0-packet-graph-policy-only p) 1) 14
    (niv0-owed-cons (eq (niv0-packet-no-execution p) 1) 15
      (empty)))))))))))))))

  (defn niv0-decision-node (reason)
    (make_nodeid 3 48 reason 1))

  (defn niv0-result (p)
    (if (not (eq (niv0-packet? p) 1))
      (nothing)
      (if (eq (niv0-packet-decision p) (niv0-decision-declined))
        0
        (do
          (let reason (niv0-first-owed-reason p))
          (if (eq reason 0) 1 (niv0-decision-node reason))))))

  (defn niv0-result-kind (result)
    (if (nothing? result) 0
    (if (eq result 0) 1
    (if (eq result 1) 2
      3))))

  (defn niv0-readiness-receipt (p)
    (do
      (let result (niv0-result p))
      (if (nothing? result)
        (nothing)
        (list "NeutralInterchangeV0ReadinessReceipt"
          (niv0-result-kind result)
          (if (eq (niv0-result-kind result) 3)
            (node_type result)
            (if (eq result 0) 2 0))
          (niv0-owed-reasons p)
          (niv0-packet-preregistration-digest p)
          (niv0-packet-case-count p)
          (niv0-packet-nl-targets p)
          (niv0-packet-pl-targets p)
          (niv0-materiality-floor)))))

  ; Grounded current state: Giles carries 36 member-witnessed facts and the
  ; existing EN/ID/Form/Python projections.  The reconciled pilot still owes
  ; its frozen ontology subset, canonical bytes, signed floor, named ratifier
  ; authority, immutable pre-registration, fourteen cases, and a
  ; mandatory-category-rich NL target.
  (defn niv0-current-pilot-packet ()
    (niv0-pilot-packet
      (niv0-decision-accepted)
      0 0 0 0 ""
      36 2 1 0 1 1 1 1))

  0)
