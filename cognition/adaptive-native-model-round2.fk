; round 2 — reload and infer the quadratic Newton feature from observation (2,11).
; witnessed: 2026-07-21 -> [2, 2, 3, 14, 16, 180, 84, 45, 71, 1]
(do
  (let path ".form-native-adaptive-model.state")
  (let loaded (read_file path))
  (let loaded-n (div (sub (str_len loaded) 10) 2))
  (let c0 (sub (str_byte_at loaded 10) 48))
  (let c1 (sub (str_byte_at loaded 12) 48))
  (let observed-prediction (add c0 (mul c1 2)))
  (let learned-c2 (div (sub 11 observed-prediction) 1))
  (let saved (str_concat loaded (str_concat (byte_to_str (add 48 learned-c2)) "\n")))
  (let saved-n (div (sub (str_len saved) 10) 2))
  (let before-p4 (add c0 (mul c1 4)))
  (let before-p5 (add c0 (mul c1 5)))
  (let before (add (sub 69 before-p4) (sub 131 before-p5)))
  (let p4 (add before-p4 (mul learned-c2 6)))
  (let p5 (add before-p5 (mul learned-c2 10)))
  (let after (add (sub 69 p4) (sub 131 p5)))
  (let wrote (write_file path saved))
  (let success-a (eq saved-n (add loaded-n 1)))
  (let success-b (lt after before))
  (let success-c (eq wrote (str_len saved)))
  (list loaded-n loaded-n saved-n (str_len loaded) (str_len saved)
    before after p4 p5
    (if success-a (if success-b (if success-c 1 0) 0) 0)))
