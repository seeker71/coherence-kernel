; scripture-evidence-round2.fk — multi-work, lineage-aware, paraconsistent
; evidence vectors. Textual presence is evidence, never truth by itself.
; status: 0 nothing, 1 supported-only, 2 opposed-only, 3 tension/node.
; witnessed: 2026-07-21 -> eight texts / three correlated digital lineages /
; five resolved concepts / four tension nodes / success 1; exact output:
; [8,3,5,4,5,[1,7,3,1],[2,8,4,0],1,[4,8,1,0],[5,8,1,0],134,1]
import "scripture-corpus-gate.fk"
(do
  (defn ser-fold (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn ser-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (ser-fold (str_byte_at s (add i j))) (ser-fold (str_byte_at p j)))
        (ser-match s i p (add j 1)) 0))))
  (defn ser-has-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) 0
    (if (eq (ser-match s i p 0) 1) 1 (ser-has-loop s p (add i 1)))))
  (defn ser-has? (s p) (ser-has-loop s p 0))
  (defn ser-any? (s ps) (if (eq (len ps) 0) 0
    (if (eq (ser-has? s (head ps)) 1) 1 (ser-any? s (tail ps)))))
  (defn ser-append (a b) (if (eq (len a) 0) b (cons (head a) (ser-append (tail a) b))))
  (defn ser-source (text support refute) (list (ser-any? text support) (ser-any? text refute)))
  (defn ser-evidence-loop (texts support refute sources sup opp unresolved)
    (if (eq (len texts) 0) (list sup opp unresolved sources)
      (do (let e (ser-source (head texts) support refute))
        (let s (nth e 0)) (let o (nth e 1))
        (ser-evidence-loop (tail texts) support refute (add sources 1)
          (add sup s) (add opp o) (add unresolved (if (and (eq s 0) (eq o 0)) 1 0))))))
  (defn ser-evidence (texts support refute) (ser-evidence-loop texts support refute 0 0 0 0))
  (defn ser-status (e) (if (and (gt (nth e 0) 0) (gt (nth e 1) 0)) 3
    (if (gt (nth e 0) 0) 1 (if (gt (nth e 1) 0) 2 0))))
  (defn ser-ack (id e) (do (let status (ser-status e))
    (if (eq status 0) (nothing) (if (eq status 1) 1
      (if (eq status 2) 0 (list id (nth e 0) (nth e 1) (nth e 2)))))))
  (defn ser-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (ser-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (defn ser-row (id e lineage culture axiom-mask)
    (str_concat (ser-int id) (str_concat "|" (str_concat (ser-int (nth e 0))
    (str_concat "|" (str_concat (ser-int (nth e 1)) (str_concat "|"
    (str_concat (ser-int (nth e 2)) (str_concat "|" (str_concat (ser-int lineage)
    (str_concat "|" (str_concat (ser-int culture) (str_concat "|0|1|1|"
    (str_concat (ser-int axiom-mask) (str_concat "|" (str_concat (ser-int (ser-status e)) "\n"))))))))))))))))
  (let web (list
    (read_file "corpus/sources/bible-web/09-RUTengwebp.usfm")
    (read_file "corpus/sources/bible-web/20-PSAengwebp.usfm")
    (read_file "corpus/sources/bible-web/21-PROengwebp.usfm")
    (read_file "corpus/sources/bible-web/73-JHNengwebp.usfm")
    (read_file "corpus/sources/bible-web/89-JASengwebp.usfm")))
  (let sarit (list
    (read_file "corpus/sources/sanskrit-sarit/astavakragita.xml")
    (read_file "corpus/sources/sanskrit-sarit/patanjalayogasastra.xml")))
  (let core (list (read_file "axioms/core-axioms.form")))
  (let texts (ser-append web (ser-append sarit core)))
  ; Neutral candidates and their supporting/opposing surface families.
  (let e1 (ser-evidence texts (list "trust" "faith" "viśvās" "śraddh")
    (list "betray" "deceit" "aviśvās")))
  (let e2 (ser-evidence texts (list "know" "knowledge" "wisdom" "jñāna" "vijñā")
    (list "ignorance" "unknown" "fool" "ajñāna" "moha")))
  (let e3 (ser-evidence texts (list "witness" "testimony" "sākṣ")
    (list "false witness" "false testimony")))
  (let e4 (ser-evidence texts (list "time" "times" "kāla")
    (list "timeless" "akāla")))
  (let e5 (ser-evidence texts (list "self" "ātma" "ātman")
    (list "selfless" "anātma" "not-self")))
  ; Digital lineage diversity is three, not eight: WEB, SARIT, body.
  (let state (str_concat "scripture-evidence-v2\n"
    (str_concat (ser-row 1 e1 3 3 10) (str_concat (ser-row 2 e2 3 3 8)
    (str_concat (ser-row 3 e3 3 3 8) (str_concat (ser-row 4 e4 3 3 1)
                (ser-row 5 e5 3 3 14)))))))
  (let saved (write_file ".form-scripture-evidence-v2.state" state))
  (let tension (add (if (eq (ser-status e1) 3) 1 0) (add (if (eq (ser-status e2) 3) 1 0)
    (add (if (eq (ser-status e3) 3) 1 0) (add (if (eq (ser-status e4) 3) 1 0)
    (if (eq (ser-status e5) 3) 1 0))))))
  ; [sources, lineages, concepts, tensions, five acknowledgements, bytes, success]
  (let resolved (add (if (gt (ser-status e1) 0) 1 0) (add (if (gt (ser-status e2) 0) 1 0)
    (add (if (gt (ser-status e3) 0) 1 0) (add (if (gt (ser-status e4) 0) 1 0)
    (if (gt (ser-status e5) 0) 1 0))))))
  (list 8 3 5 tension resolved (ser-ack 1 e1) (ser-ack 2 e2) (ser-ack 3 e3)
    (ser-ack 4 e4) (ser-ack 5 e5) saved
    (if (and (eq (scg-ready) 1) (and (eq resolved 5) (gt saved 0))) 1 0)))
