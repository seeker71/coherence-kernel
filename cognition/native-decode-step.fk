// native-decode-step.fk — rung 3a of the voice: REAL trained generative weights, loaded as
// recipe-data by the Form body, one greedy decode step run natively on the walker, the token
// chosen from GPU-dispatched logits with the bit-exact receipt riding in the value, the
// decision watched as a thought-frame.
//
// preludes (cat before this cell): form/form-stdlib/core.fk (int_to_str post-shrink),
// observe/thought-framebuffer.fk (fb-frame/fb-step/fb-margin).
//
// The model: karpathy/tinyllamas stories260K — a genuinely TRAINED llama2 (dim 64, hidden 172,
// 5 layers, 8 heads / 4 kv-heads, vocab 512, ~260K f32 params). Real weights, real training,
// the smallest honest generative body. The checkpoint bytes cross fkwu's now-binary-safe
// read_file door (O_RDBIN) and every IEEE-754
// f32 is decoded IN FORM (sign/exponent/mantissa by integer div/mod, magnitude by f64
// arithmetic — exact: every f32 is representable in f64).
//
// Position 0 makes the whole step native-expressible TODAY, with no approximation:
//   - RoPE at pos 0 rotates by angle 0 — the identity, exactly (no trig ops needed).
//   - attention over one position: softmax of a single score is exactly 1 (computed
//     explicitly below as exp(s-s)/exp(s-s), not assumed) — each head passes its v through.
// Everything else is the full llama step, really computed: RMSNorm (math_sqrt), q/k/v/wo
// matvecs, SwiGLU (math_exp), residuals, final RMSNorm — all f64 walker arithmetic reading
// weights straight off the checkpoint string. The LM head (vocab x dim = 512x64) dispatches
// on the RTX through cuda_matvec_f32: (agree logits...) — agree < vocab refuses the token.
//
// Honest floor, named: ONE position (multi-position needs RoPE trig — sin/cos are not ops
// yet; the named next rung), f64 walker forward (not the f32 two-rounding lane; the C
// projection runner is a SANITY oracle, not a bit-oracle), a 512-token vocab trained on
// TinyStories (a child's first word, not eloquence), and the words framing this receipt are
// still the rented mind's. The token is the body's own.
section [form.bml] {
    // ── tail plumbing ────────────────────────────────────────────────────────
    def nds-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : nds-rev(xs[1:], cons(xs[0], acc));
    // ── IEEE-754 f32 decode, in Form ─────────────────────────────────────────
    def nds-p2(k, acc) = (Comparable) k == 0 ? acc : nds-p2(k - 1, acc * 2.0);
    def nds-pow2(k) = nds-p2(k, 1.0);
    def nds-i32(s, o) = (Number) str_byte_at(s, o) + (Number) ((Number) (str_byte_at(s, (Number) o + (Number) 1) * 256) + (Number) ((Number) (str_byte_at(s, (Number) o + (Number) 2) * 65536) + (Number) (str_byte_at(s, (Number) o + (Number) 3) * 16777216)));
    def nds-mag(ex, man) = (Comparable) ex == 0 ? 1.0 * man / nds-pow2(149) : 127 <= ex ? ((Number) 1.0 + (Number) (1.0 * man / 8388608.0)) * nds-pow2(ex - 127) : ((Number) 1.0 + (Number) (1.0 * man / 8388608.0)) / nds-pow2(127 - ex);
    def nds-f32(s, o) = {
        let bits = nds-i32(s, o);
        let ex = bits / 8388608 % 256;
        let mag = nds-mag(ex, bits % 8388608);
        (Comparable) (bits / 2147483648) == 1 ? 0.0 - mag : mag;
    };
    // ── weight reads straight off the checkpoint string ──────────────────────
    // n floats from byte offset -> list (ascending)
    def nds-floats-loop(s, o, n, acc) = (Comparable) n == 0 ? nds-rev(acc, empty()) : nds-floats-loop(s, (Number) o + (Number) 4, n - 1, cons(nds-f32(s, o), acc));
    // dot of the weight row at byte `base` with list x (n elements)
    def nds-dot(s, base, x, n, acc) = (Comparable) n == 0 ? acc : nds-dot(s, (Number) base + (Number) 4, x[1:], n - 1, (Number) acc + (Number) (nds-f32(s, base) * x[0]));
    // y = W.x for W (rows x cols) at byte `base`
    def nds-mv-loop(s, base, rows, cols, x, acc) = (Comparable) rows == 0 ? nds-rev(acc, empty()) : nds-mv-loop(s, (Number) base + (Number) (cols * 4), rows - 1, cols, x, cons(nds-dot(s, base, x, cols, 0.0), acc));
    def nds-mv(s, base, rows, cols, x) = nds-mv-loop(s, base, rows, cols, x, empty());
    // ── elementwise organs (all tail + reverse) ──────────────────────────────
    def nds-ss(x, n, acc) = (Comparable) n == 0 ? acc : nds-ss(x[1:], n - 1, (Number) acc + (Number) (x[0] * x[0]));
    // RMSNorm, llama2.c order: inv = 1/sqrt(ss/n + 1e-5); out_i = w_i * (inv * x_i)
    def nds-rms-loop(s, wbase, x, n, inv, acc) = (Comparable) n == 0 ? nds-rev(acc, empty()) : nds-rms-loop(s, (Number) wbase + (Number) 4, x[1:], n - 1, inv, cons(nds-f32(s, wbase) * (inv * x[0]), acc));
    def nds-rms(s, wbase, x, n) = nds-rms-loop(s, wbase, x, n, 1.0 / math_sqrt((Number) (nds-ss(x, n, 0.0) / (1.0 * n)) + (Number) 0.00001), empty());
    // SwiGLU: silu(h1)*h3, silu(v) = v / (1 + exp(-v))
    def nds-swiglu(h1, h3, n, acc) = (Comparable) n == 0 ? nds-rev(acc, empty()) : nds-swiglu(h1[1:], h3[1:], n - 1, cons(h1[0] / ((Number) 1.0 + (Number) math_exp(0.0 - h1[0])) * h3[0], acc));
    def nds-addz(a, b, n, acc) = (Comparable) n == 0 ? nds-rev(acc, empty()) : nds-addz(a[1:], b[1:], n - 1, cons((Number) a[0] + (Number) b[0], acc));
    // ── attention at position 0 (GQA; softmax-of-one computed, not assumed) ──
    def nds-dot8(q, k, qi, ki, n, acc) = (Comparable) n == 0 ? acc : nds-dot8(q, k, (Number) qi + (Number) 1, (Number) ki + (Number) 1, n - 1, (Number) acc + (Number) (nth(q, qi) * nth(k, ki)));
    // per-head weight: a = exp(s - max) / sum = exp(0)/exp(0) over ONE key — exactly 1.0
    def nds-att-a(q, k, h, hd) = {
        let s = nds-dot8(q, k, h * hd, h / 2 * hd, hd, 0.0) / math_sqrt(1.0 * hd);
        math_exp(s - s) / math_exp(s - s);
    };
    def nds-att-loop(q, k, v, i, hd, acc) = i < 0 ? acc : nds-att-loop(q, k, v, i - 1, hd, cons(nds-att-a(q, k, i / hd, hd) * nth(v, (Number) (i / hd / 2 * hd) + (Number) (i % hd)), acc));
    def nds-att(q, k, v, dim, hd) = nds-att-loop(q, k, v, dim - 1, hd, empty());
    // ── one full llama layer at pos 0 ────────────────────────────────────────
    // bases is (rms-att wq wk wv wo rms-ffn w1 w2 w3) byte offsets for THIS layer
    def nds-layer(s, x, dim, kvd, hid, hd, bases) = {
        let xb = nds-rms(s, bases[0], x, dim);
        let q = nds-mv(s, bases[1], dim, dim, xb);
        let k = nds-mv(s, bases[2], kvd, dim, xb);
        let v = nds-mv(s, bases[3], kvd, dim, xb);
        let att = nds-att(q, k, v, dim, hd);
        let x1 = nds-addz(x, nds-mv(s, bases[4], dim, dim, att), dim, empty());
        let xb3 = nds-rms(s, bases[5], x1, dim);
        let h1 = nds-mv(s, bases[6], hid, dim, xb3);
        let h3 = nds-mv(s, bases[8], hid, dim, xb3);
        let hh = nds-swiglu(h1, h3, hid, empty());
        nds-addz(x1, nds-mv(s, bases[7], dim, hid, hh), dim, empty());
    };
    // per-layer base offsets from the config (llama2.c legacy layout).
    // ra0 = byte base of rms_att, i.e. AFTER the vocab x dim embedding table — anchoring
    // here at the checkpoint start was the first-run bug: every weight room shifted by
    // vocab*dim*4 and the forward produced a plausible-but-wrong token (261 " a") that
    // ONLY the projection-runner oracle exposed. The oracle is not optional.
    def nds-bases(l, dim, kvd, hid, layers, ra0) = {
        let ra = ra0;
        let wq = (Number) ra + (Number) (layers * dim * 4);
        let wk = (Number) wq + (Number) (layers * dim * dim * 4);
        let wv = (Number) wk + (Number) (layers * kvd * dim * 4);
        let wo = (Number) wv + (Number) (layers * kvd * dim * 4);
        let rf = (Number) wo + (Number) (layers * dim * dim * 4);
        let w1 = (Number) rf + (Number) (layers * dim * 4);
        let w2 = (Number) w1 + (Number) (layers * hid * dim * 4);
        let w3 = (Number) w2 + (Number) (layers * dim * hid * 4);
        [(Number) ra + (Number) (l * dim * 4), (Number) wq + (Number) (l * dim * dim * 4), (Number) wk + (Number) (l * kvd * dim * 4), (Number) wv + (Number) (l * kvd * dim * 4), (Number) wo + (Number) (l * dim * dim * 4), (Number) rf + (Number) (l * dim * 4), (Number) w1 + (Number) (l * hid * dim * 4), (Number) w2 + (Number) (l * dim * hid * 4), (Number) w3 + (Number) (l * hid * dim * 4)];
    };
    def nds-layers(s, x, l, layers, dim, kvd, hid, hd, ra0) = (Comparable) l == layers ? x : nds-layers(s, nds-layer(s, x, dim, kvd, hid, hd, nds-bases(l, dim, kvd, hid, layers, ra0)), (Number) l + (Number) 1, layers, dim, kvd, hid, hd, ra0);
    // ── argmax + runner-up margin over the GPU logits ────────────────────────
    def nds-best-loop(xs, i, bi, bv) = (Comparable) len(xs) == 0 ? bi : xs[0] > bv ? nds-best-loop(xs[1:], (Number) i + (Number) 1, i, xs[0]) : nds-best-loop(xs[1:], (Number) i + (Number) 1, bi, bv);
    def nds-best2-loop(xs, skip, i, bv) = (Comparable) len(xs) == 0 ? bv : (Comparable) i == skip ? nds-best2-loop(xs[1:], skip, (Number) i + (Number) 1, bv) : xs[0] > bv ? nds-best2-loop(xs[1:], skip, (Number) i + (Number) 1, xs[0]) : nds-best2-loop(xs[1:], skip, (Number) i + (Number) 1, bv);
    // ── tokenizer: decode ONE id from tok512.bin (maxlen i32, then per entry:
    //    score f32, len i32, len bytes) ─────────────────────────────────────
    def nds-tok-str(s, o, n, acc) = (Comparable) n == 0 ? acc : nds-tok-str(s, (Number) o + (Number) 1, n - 1, ((String) acc + byte_to_str(str_byte_at(s, o))));
    def nds-tok-walk(s, o, id) = (Comparable) id == 0 ? nds-tok-str(s, (Number) o + (Number) 8, nds-i32(s, (Number) o + (Number) 4), "") : nds-tok-walk(s, (Number) o + (Number) ((Number) 8 + (Number) nds-i32(s, (Number) o + (Number) 4)), id - 1);
    def nds-token-text(tok, id) = nds-tok-walk(tok, 4, id);
    // ── the step: checkpoint + tokenizer paths in, first native token out ────
    def native-decode-step(ckpt, tokpath) = {
        let s = read_file(ckpt);
        let dim = nds-i32(s, 0);
        let hid = nds-i32(s, 4);
        let layers = nds-i32(s, 8);
        let heads = nds-i32(s, 12);
        let kvh = nds-i32(s, 16);
        let vocab = nds-i32(s, 20);
        let hd = dim / heads;
        let kvd = kvh * hd;
        let t-emb = 28;
        // x = tok_emb[BOS=1]
        let x0 = nds-floats-loop(s, (Number) t-emb + (Number) (dim * 4), dim, empty());
        let ra0 = (Number) t-emb + (Number) (vocab * dim * 4);
        let xn = nds-layers(s, x0, 0, layers, dim, kvd, hid, hd, ra0);
        // final RMSNorm weight sits after w3
        let rfin = (Number) t-emb + (Number) (4 * ((Number) (vocab * dim) + (Number) (layers * ((Number) (dim * 2) + (Number) ((Number) (dim * dim * 2) + (Number) ((Number) (kvd * dim * 2) + (Number) (hid * dim * 3)))))));
        let xf = nds-rms(s, rfin, xn, dim);
        // LM head = tok_emb (tied) through the RTX door: (agree logits...)
        let wflat = nds-floats-loop(s, t-emb, vocab * dim, empty());
        let r = cuda_matvec_f32(wflat, xf);
        (Comparable) len(r) == 0 ? "[voice: gpu door refused — no receipt, no token]" : {
            let agree = r[0];
            let logits = r[1:];
            let bi = nds-best-loop(logits[1:], 1, 0, logits[0]);
            let margin-milli = float_to_int(1000.0 * (nth(logits, bi) - nds-best2-loop(logits, bi, 0, 0.0 - 1000000.0)));
            let f = fb-frame(0, bi, margin-milli);
            agree < vocab ? "[voice: gpu/cpu disagree — refusing the token]" : ("first-native-token:id=" + (bi.str() + (" text=[" + (nds-token-text(read_file(tokpath), bi) + ("]\nrtx-receipt:bit-exact " + (agree.str() + ("/" + (vocab.str() + ("\nthought-frame:step=" + (fb-step(f).str() + (" chose=" + (bi.str() + (" margin-milli=" + (fb-margin(f).str() + "\nlane:native-walker-forward+rtx-lm-head"))))))))))))));
        };
    };
    0;
}
