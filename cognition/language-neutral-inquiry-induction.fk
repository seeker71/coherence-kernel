// language-neutral-inquiry-induction.fk — compute neutral identity from aligned
// locale evidence, then open every inquiry lane from that identity.
//
// No surface alias table lives here. The resolver locates a complete token
// sequence in the attributed locale baseline, derives identity from its neutral
// meaning coordinate, and converts that identity into a valid recursive inquiry
// path. Adding another ready locale or meaning row extends coverage without a
// code change.
import "language-neutral-symbol-identity.fk"
import "native-inquiry-derivation.fk"
import "../learn/sanskrit-locale-baseline.fk"
section [form.bml] {
    def lnii-node-for-meaning(meaning) = meaning > 0 ? lnsi-node(1, 1, 10, meaning) : nothing();
    def lnii-resolve(locale, tokens) = lnii-node-for-meaning(slb-meaning-for-tokens(locale, tokens));
    // Encode an arbitrary positive canonical id as a base-8 inquiry path whose
    // digits are only 0..6. This preserves the no-digit-7 invariant.
    def lnii-subject-go(n) = (Comparable) n == 0 ? 1 : nid-child(lnii-subject-go(n / 7), n % 7);
    def lnii-subject(node) = nothing?(node) ? nothing() : lnii-subject-go(node);
    def lnii-lanes-ok(subject, lane, count) = lane >= 7 ? count : {
        let proof = nid-inquire(subject, lane, 1);
        let replay = nid-replay(nid-p-receipt(proof));
        lnii-lanes-ok(subject, (Number) lane + (Number) 1, (Number) count + (Number) ((Comparable) nid-p-reason(proof) == 0 && ((Comparable) nid-p-ack(replay) == 1 && ((Comparable) nid-p-reason(replay) == 0 && ((Comparable) nid-valid?(nid-p-alt(proof)) == 1 && (Comparable) nid-valid?(nid-p-alt(replay)) == 1))) ? 1 : 0));
    };
    // Accumulator: [resolved surfaces, converged identities, inquiry replays].
    def lnii-observe-locales(row, locales, acc) = (Comparable) len(locales) == 0 ? acc : {
        let locale-row = locales[0];
        let code = slb-loc-code(locale-row);
        let tokens = slb-tokens(row, code);
        (Comparable) slb-loc-ready(locale-row) == 0 || (Comparable) len(tokens) == 0 ? lnii-observe-locales(row, locales[1:], acc) : {
            let node = lnii-resolve(code, tokens);
            let expected = lnii-node-for-meaning(slb-meaning(row));
            let converged = (Comparable) node == expected ? 1 : 0;
            let lanes = (Comparable) converged == 1 ? lnii-lanes-ok(lnii-subject(node), 0, 0) : 0;
            lnii-observe-locales(row, locales[1:], [(Number) acc[0] + (Number) 1, (Number) acc[1] + (Number) converged, (Number) acc[2] + (Number) lanes]);
        };
    };
    def lnii-observe-rows(rows, locales, acc) = (Comparable) len(rows) == 0 ? acc : lnii-observe-rows(rows[1:], locales, lnii-observe-locales(rows[0], locales, acc));
    def lnii-witness() = {
        let observed = lnii-observe-rows(slb-lines(), slb-locales(), [0, 0, 0]);
        let surfaces = observed[0];
        let converged = observed[1];
        let inquiries = observed[2];
        let unknown = lnii-resolve("sa", ["not", "a", "known", "row"]);
        let expected-inquiries = surfaces * 7;
        // Observe the coverage change rather than merely reporting it.
        let before = [fb-frame(0, 1, 1), fb-frame(1, 2, 1)];
        let after = [fb-frame(0, 1, 1), fb-frame(1, surfaces, 1)];
        let coverage-divergence = diverge(before, after);
        framebuffer-clear();
        let event0 = fb_record(intern_trivial_int(2), "language-neutral-inquiry-induction.fk", 1);
        let event1 = fb_record(intern_trivial_int(surfaces), "language-neutral-inquiry-induction.fk", 2);
        let event2 = fb_record(intern_trivial_int(inquiries), "language-neutral-inquiry-induction.fk", 3);
        let runtime-frames = len(framebuffer-events());
        [nothing(), 0, 1, 1001099002, 2, surfaces, converged, expected-inquiries, inquiries, coverage-divergence, runtime-frames, unknown, surfaces > 2 && ((Comparable) surfaces == converged && ((Comparable) inquiries == expected-inquiries && ((Comparable) coverage-divergence == 1 && ((Comparable) runtime-frames == 3 && nothing?(unknown))))) ? 1 : 0];
    };
    0;
}
