; gen-query-walk.fk — the query rows walked in-kernel, checked against the
; hand-written accessors they replace. Split out of gen-query-flow.fk on
; 2026-07-28 for the same reason gen-neutral-walk.fk was.
;
; gen-conformance runs on fkwu (host-exec) and preludes the query cell for its
; emitters. The closed-recipe half of that cell calls `walk_recipe`, which fkwu
; does not have, so every conformance run raised two unresolved-call errors and
; exited 1 while printing a green 255. The number was right and numb.
;
; The emitters, the query-shape table and the statement form are arm-neutral and
; stay in gen-query-flow.fk. What is here needs walk_recipe: the closed recipe
; over the real facts, the eight agreement questions, and the two checks.
;
; PROOF LANE: SIBLINGS ONLY — walk_recipe is Go/Rust/TS and absent from fkwu.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk cognition/gen-neutral-code.fk cognition/gen-query-flow.fk

(do

  ;; ═══ in-kernel check against the REAL graph ════════════════════
  ;; A closed recipe over the real facts, one term per fact. This is NOT the
  ;; exported program — that keeps fs as a parameter — it is the same query row
  ;; instantiated so the kernel can walk it. Named rather than blurred.
  (defn gqy-col (f q) (if (eq (gqy-mcol q) 0) (stn-f-subject f) (stn-f-object f)))
  (defn gqy-res (f q) (if (eq (gqy-rcol q) 0) (stn-f-subject f) (stn-f-object f)))
  (defn gqy-hit (f q rel key)
    (if (eq (stn-f-relation f) rel) (if (eq (gqy-col f q) key) 1 0) 0))

  (defn gqy-closed-count (fs q rel key)
    (if (eq (len fs) 0) (intern_trivial_int 0)
      (intern_node (bp "add")
        (list (intern_trivial_int (gqy-hit (head fs) q rel key))
              (gqy-closed-count (tail fs) q rel key)))))
  ;; THE CONDITION IS AN EXPLICIT COMPARISON, not a bare integer. The first
  ;; version passed the 0/1 hit straight in as the `if` condition, and the three
  ;; kernels disagreed: Go and Rust took the then-branch on an interned 1, and
  ;; TypeScript took the else. Every `find` query came back 0 on the TS arm —
  ;; and the band still scored 253 of 255, because the one question with NO
  ;; answer expects 0 and passed for the wrong reason. Comparing to 1 explicitly
  ;; leans on no kernel's truthiness rule. A real flow found this; the toy could
  ;; not, because counting never branches on a value.
  (defn gqy-closed-find (fs q rel key)
    (if (eq (len fs) 0) (intern_trivial_int 0)
      (intern_node (bp "if")
        (list (intern_node (bp "eq")
                (list (intern_trivial_int (gqy-hit (head fs) q rel key))
                      (intern_trivial_int 1)))
              (intern_trivial_int (gqy-res (head fs) q))
              (gqy-closed-find (tail fs) q rel key)))))
  (defn gqy-closed (q rel key)
    (if (str_eq (gqy-mode q) "count")
        (gqy-closed-count (stn-facts) q rel key)
        (gqy-closed-find (stn-facts) q rel key)))
  (defn gqy-run (q rel key) (walk_recipe (gqy-closed q rel key)))

  ;; ═══ the hand-written accessors, restated for comparison ═══════
  ;; These are what the graph used before the generator existed.
  (defn gqy-hand-members (fs c)
    (if (eq (len fs) 0) 0
      (add (if (eq (stn-f-subject (head fs)) c)
             (if (eq (stn-f-relation (head fs)) (stn-has-member)) 1 0) 0)
           (gqy-hand-members (tail fs) c))))
  (defn gqy-hand-state (fs m)
    (if (eq (len fs) 0) 0
      (if (eq (stn-f-subject (head fs)) m)
        (if (eq (stn-f-relation (head fs)) (stn-in-state))
          (stn-f-object (head fs)) (gqy-hand-state (tail fs) m))
        (gqy-hand-state (tail fs) m))))
  (defn gqy-hand-mediator (fs x)
    (if (eq (len fs) 0) 0
      (if (eq (stn-f-object (head fs)) x)
        (if (eq (stn-f-relation (head fs)) (stn-mediates))
          (stn-f-subject (head fs)) (gqy-hand-mediator (tail fs) x))
        (gqy-hand-mediator (tail fs) x))))

  ;; ═══ agreement on the real graph, question by question ═════════
  (defn gqy-a1 () (if (eq (gqy-run (gqy-q "count_by_subject") (stn-has-member) (stn-threefold-soul))
                          (gqy-hand-members (stn-facts) (stn-threefold-soul))) 1 0))
  (defn gqy-a2 () (if (eq (gqy-run (gqy-q "count_by_subject") (stn-has-member) (stn-fourfold-being))
                          (gqy-hand-members (stn-facts) (stn-fourfold-being))) 1 0))
  (defn gqy-a3 () (if (eq (gqy-run (gqy-q "count_by_object") (stn-in-group) (stn-g-other-being))
                          (stn-senses-in (stn-g-other-being))) 1 0))
  (defn gqy-a4 () (if (eq (gqy-run (gqy-q "count_by_object") (stn-in-group) (stn-g-own-body))
                          (stn-senses-in (stn-g-own-body))) 1 0))
  (defn gqy-a5 () (if (eq (gqy-run (gqy-q "find_object") (stn-in-state) (stn-willing))
                          (gqy-hand-state (stn-facts) (stn-willing))) 1 0))
  (defn gqy-a6 () (if (eq (gqy-run (gqy-q "find_object") (stn-in-state) (stn-thinking))
                          (gqy-hand-state (stn-facts) (stn-thinking))) 1 0))
  (defn gqy-a7 () (if (eq (gqy-run (gqy-q "find_subject") (stn-mediates) (stn-polarity))
                          (gqy-hand-mediator (stn-facts) (stn-polarity))) 1 0))
  ;; a question with NO answer in the graph must come back 0, not a wrong row
  (defn gqy-a8 () (if (eq (gqy-run (gqy-q "find_object") (stn-in-state) (stn-eurythmy)) 0) 1 0))

  ;; COUNT and FIND both ride every arm — but only since this session.
  ;;
  ;; A find query returns a node id, ~3.0e9, past 2^31, and the TypeScript arm
  ;; was returning 3045007003 as -1249960293. I wrote that up as "I32 BY
  ;; DESIGN", citing a `| 0` in compiler.ts and a nearby comment about V8 SMI
  ;; tagging, and split the proof lane to declare TS could not carry it.
  ;;
  ;; Urs asked how I knew it was deliberate. I did not. Tracing it properly:
  ;; walk_recipe never touches compiler.ts — the loss was in kernel.ts:765,
  ;; `internTrivialInt`, which packed the value into the NodeID's 32-bit inst
  ;; slot with no overflow branch. The Go kernel has that branch and says why:
  ;; "inline while the value fits the 32-bit inst slot; overflow into i64s once
  ;; it crosses the int32 ceiling … callers and arithmetic never see the storage
  ;; split." Rust agrees with Go. A behaviour ONE of three siblings has is a
  ;; bug, not a design — and the siblings exist to make exactly that visible.
  ;;
  ;; Fixed in form-kernel-ts/src/kernel.ts, mirroring Go. All three arms now
  ;; return 3045007003. The split lane was me writing a defect into the body's
  ;; proof structure as though it were a law.
  (defn gqy-agree-count ()
    (add (gqy-a1) (add (gqy-a2) (add (gqy-a3) (gqy-a4)))))
  (defn gqy-agree-find ()
    (add (gqy-a5) (add (gqy-a6) (add (gqy-a7) (gqy-a8)))))
  (defn gqy-check-find ()
    (add (if (eq (gqy-agree-find) 4) 1 0)
    (add (if (gt (gqy-run (gqy-q "find_subject") (stn-mediates) (stn-polarity)) 2147483647) 2 0)
         0)))

  (defn gqy-check ()
    (add (if (eq (gqy-count) 4) 1 0)
    (add (if (eq (gqy-agree-count) 4) 2 0)
    (add (if (gt (str_len (gqy-emit "python" (gqy-q "find_subject"))) 60) 4 0)
    (add (if (gt (str_len (gqy-emit "form" (gqy-q "count_by_object"))) 60) 8 0)
    (add (if (gt (str_len (gqy-emit "javascript" (gqy-q "find_object"))) 60) 16 0)
    (add (if (eq (gqy-emitted-n) 12)
             (if (eq (gqy-all-covered?) 1) 32 0) 0)
    (add (if (lt (str_find (gqy-module "python") "3045" 0) 0) 64 0)
    (add (if (gt (str_len (gqy-module "javascript")) 400) 128 0)
         0)))))))))

  0)
