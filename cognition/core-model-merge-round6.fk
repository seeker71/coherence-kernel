; core-model-merge-round6.fk — merge model v5 with the next witnessed source
; layer. Source works become nodes; support does not erase tension.
; Public observation begins [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> first run unresolved-call/no state/success 0;
; local native emitter alternate then pre-ground and post-ground both:
; [nothing,0,1,6002,2,75,5,80,4,5,1691995,107,1,1]
(do
  (defn cmm6-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (cmm6-match s i p (add j 1)) 0))))
  (defn cmm6-find (s p i) (if (gt (add i (str_len p)) (str_len s)) -1
    (if (eq (cmm6-match s i p 0) 1) i (cmm6-find s p (add i 1)))))
  (defn cmm6-read-int (s i n) (if (ge i (str_len s)) n
    (do (let b (str_byte_at s i))
      (if (and (ge b 48) (le b 57))
        (cmm6-read-int s (add i 1) (add (mul n 10) (sub b 48))) n))))
  (defn cmm6-after (s p) (do (let i (cmm6-find s p 0))
    (if (lt i 0) -1 (cmm6-read-int s (add i (str_len p)) 0))))
  (defn cmm6-hash-loop (s i h) (if (ge i (str_len s)) h
    (cmm6-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn cmm6-hash (s) (cmm6-hash-loop s 0 0))
  (defn cmm6-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (cmm6-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (let prior (read_file ".form-core-model-v5.state"))
  (let coverage (read_file ".form-scripture-coverage-v6.state"))
  (let prior-nodes (cmm6-after prior "total-nodes="))
  (let tensions (cmm6-after prior "tension="))
  (let sources (cmm6-after coverage "new-sources="))
  (let support (cmm6-after coverage "concept-support="))
  (let total-nodes (add prior-nodes sources))
  (let fingerprint (cmm6-hash (str_concat prior coverage)))
  (let s0 "core-model-v6\nparents=2\n")
  (let s1 (str_concat s0 (str_concat "prior-nodes=" (cmm6-int prior-nodes))))
  (let s2 (str_concat s1 (str_concat "\nsource-nodes=" (cmm6-int sources))))
  (let s3 (str_concat s2 (str_concat "\ntotal-nodes=" (cmm6-int total-nodes))))
  (let s4 (str_concat s3 (str_concat "\ntension=" (cmm6-int tensions))))
  (let state (str_concat s4 (str_concat "\nparent-content-hash="
    (str_concat (cmm6-int fingerprint) "\n"))))
  (let saved (write_file ".form-core-model-v6.state" state))
  (let identity (if (str_eq state (read_file ".form-core-model-v6.state")) 1 0))
  (let success (if (eq prior-nodes 75)
    (if (eq sources 5)
      (if (eq support 5) (if (eq identity 1) 1 0) 0) 0) 0))
  (list (nothing) 0 1 6002 2 prior-nodes sources total-nodes tensions support
    fingerprint saved identity success))
