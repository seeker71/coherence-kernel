; scripture-coverage-round6.fk — one more bounded layer: five additional Bible
; works, evaluated against the neutral concept families. Sanskrit stays 3/3.
; Public observation begins [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [nothing,0,1,6001,15,66,2272,3,3,10000,5,5,2533626,79,1,1]
import "scripture-corpus-gate.fk"
(do
  (defn scr6-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (scr6-match s i p (add j 1)) 0))))
  (defn scr6-has-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) 0
    (if (eq (scr6-match s i p 0) 1) 1 (scr6-has-loop s p (add i 1)))))
  (defn scr6-has (s p) (scr6-has-loop s p 0))
  (defn scr6-suffix (s p) (if (lt (str_len s) (str_len p)) 0
    (scr6-match s (sub (str_len s) (str_len p)) p 0)))
  (defn scr6-bible-source (name)
    (if (eq (scr6-suffix name ".usfm") 0) 0
      (if (eq (scr6-has name "FRT") 1) 0
        (if (eq (scr6-has name "GLO") 1) 0 1))))
  (defn scr6-count-bible (names n) (if (eq (len names) 0) n
    (scr6-count-bible (tail names) (add n (scr6-bible-source (head names))))))
  (defn scr6-present (paths n) (if (eq (len paths) 0) n
    (scr6-present (tail paths)
      (add n (if (gt (host_file_size (head paths)) 0) 1 0)))))
  (defn scr6-size (paths n) (if (eq (len paths) 0) n
    (scr6-size (tail paths) (add n (host_file_size (head paths))))))
  (defn scr6-any-source (texts p) (if (eq (len texts) 0) 0
    (if (eq (scr6-has (head texts) p) 1) 1 (scr6-any-source (tail texts) p))))
  (defn scr6-any (texts ps) (if (eq (len ps) 0) 0
    (if (eq (scr6-any-source texts (head ps)) 1) 1 (scr6-any texts (tail ps)))))
  (defn scr6-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (scr6-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))

  (let new-paths (list
    "corpus/sources/bible-web/04-LEVengwebp.usfm"
    "corpus/sources/bible-web/06-DEUengwebp.usfm"
    "corpus/sources/bible-web/19-JOBengwebp.usfm"
    "corpus/sources/bible-web/72-LUKengwebp.usfm"
    "corpus/sources/bible-web/88-HEBengwebp.usfm"))
  (let new-texts (list
    (read_file "corpus/sources/bible-web/04-LEVengwebp.usfm")
    (read_file "corpus/sources/bible-web/06-DEUengwebp.usfm")
    (read_file "corpus/sources/bible-web/19-JOBengwebp.usfm")
    (read_file "corpus/sources/bible-web/72-LUKengwebp.usfm")
    (read_file "corpus/sources/bible-web/88-HEBengwebp.usfm")))
  (let total (scr6-count-bible (host_dir_list "corpus/sources/bible-web/") 0))
  (let newly-admitted (scr6-present new-paths 0))
  (let admitted (add 10 newly-admitted))
  (let bible-bp (div (mul admitted 10000) total))
  (let trust (scr6-any new-texts (list "trust" "faith")))
  (let knowing (scr6-any new-texts (list "know" "wisdom" "knowledge")))
  (let witness (scr6-any new-texts (list "witness" "testimony")))
  (let time (scr6-any new-texts (list "time" "times")))
  (let self (scr6-any new-texts (list "self" "yourself")))
  (let support (add trust (add knowing (add witness (add time self)))))
  (let s0 "scripture-coverage-v6\n")
  (let s1 (str_concat s0 (str_concat "bible=" (scr6-int admitted))))
  (let s2 (str_concat s1 (str_concat "/" (scr6-int total))))
  (let s3 (str_concat s2 "\nsanskrit=3/3"))
  (let s4 (str_concat s3 (str_concat "\nnew-sources=" (scr6-int newly-admitted))))
  (let state (str_concat s4 (str_concat "\nconcept-support="
    (str_concat (scr6-int support) "\n"))))
  (let saved (write_file ".form-scripture-coverage-v6.state" state))
  (let identity (if (str_eq state (read_file ".form-scripture-coverage-v6.state")) 1 0))
  (let success (if (eq (scg-ready) 1) (if (eq total 66)
    (if (eq admitted 15)
      (if (eq support 5) (if (eq identity 1) 1 0) 0) 0) 0) 0))
  ; [nothing, 0, 1, coverage-node, Bible admitted/total/bp,
  ;  Sanskrit admitted/total/bp, newly admitted, support concepts,
  ;  new bytes, saved, identity, success]
  (list (nothing) 0 1 6001 admitted total bible-bp 3 3 10000
    newly-admitted support (scr6-size new-paths 0) saved identity success))
