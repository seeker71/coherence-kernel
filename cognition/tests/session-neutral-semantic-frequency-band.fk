  (defn snsfb-int-in? (wanted ids)
    (if (eq (len ids) 0) 0
      (if (eq wanted (head ids)) 1 (snsfb-int-in? wanted (tail ids)))))
  (defn snsfb-all-candidate-fields-sized? (candidates)
    (if (eq (len candidates) 0) 1
      (do
        (let field (snsf-c-field (head candidates)))
        (if (or (eq (len field) 0) (eq (len field) (fwf-axis-count)))
          (snsfb-all-candidate-fields-sized? (tail candidates)) 0))))
  (defn snsfb-all-fields-sized? (rows)
