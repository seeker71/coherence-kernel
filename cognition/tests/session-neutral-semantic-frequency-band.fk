        (snsfb-all-fields-sized? (tail rows)) 0)))
  (defn snsfb-locale-roundtrip? (runtime codes concept-id)
    (if (eq (len codes) 0) 1
      (do
        (let code (head codes))
        (let surface (cnl13-runtime-generate (snsf-rt-nl runtime) concept-id code))
        (let ids (snsf-candidate-ids runtime code surface))
        (if (and (gt (str_len surface) 0)
                 (eq (snsfb-int-in? concept-id ids) 1))
          (snsfb-locale-roundtrip? runtime (tail codes) concept-id) 0))))
  (defn snsfb-symbol-field? (groups)
