; counsel-read-band.bml — a reader's answer lines become the counsel's rows (cognition/difficult-conversation-counsel.fk).
;
; Expected: 15
; Verdict 15 when every claim lands:
;    1   move lines become dc-move rows in order, with the grounded bit; other lines and an empty answer give none
;    2   claim lines become dcc-claim rows (who, lane); move lines give none
;    4   dcc-read-lands? is dcc-reply-lands? over both: grounded advice with an open question and a reported claim reads 1
;    8   an absent person's interior read as observed, an ungrounded move, and an empty answer each read 0
; The rows are the reader's reading; the band checks the parsing, not any reply's truth.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk cognition/dialogue-covenant.fk cognition/difficult-conversation-counsel.fk
section [form.bml] {
 def crb-moves() = dcc-moves-read("move advise 1\nclaim other observed\nmove elevate 0");
 def crb-c-moves() = len(crb-moves()) == 2 && (String) dc-kind(crb-moves()[0]) == "advise" && dc-grounded(crb-moves()[0]) == 1 && (String) dc-kind(crb-moves()[1]) == "elevate" && dc-grounded(crb-moves()[1]) == 0 && len(dcc-moves-read("")) == 0;
 def crb-claims() = dcc-claims-read("claim self observed\nmove advise 1\nclaim other reported");
 def crb-c-claims() = len(crb-claims()) == 2 && (String) dcc-claim-who(crb-claims()[1]) == "other" && (String) dcc-claim-lane(crb-claims()[1]) == "reported" && len(dcc-claims-read("move advise 1")) == 0;
 def crb-c-lands() = dcc-read-lands?("move advise 1\nmove elevate 1\nclaim other reported") ? true : false;
 def crb-c-open() = !dcc-read-lands?("move advise 1\nclaim other observed") && !dcc-read-lands?("move advise 0\nmove elevate 1") && !dcc-read-lands?("");
 (crb-c-moves() ? 1 : 0) + (crb-c-claims() ? 2 : 0) + (crb-c-lands() ? 4 : 0) + (crb-c-open() ? 8 : 0);
}
