; Fixture surfaces cross the same strict parser and trained calibrator used by
; the live DS4 binding. No fixture is granted model authority.
import "../local-ds4-validation-adapter.fk"

(do
  (defn ldvab-payload () (dvp-payload "capital?" "Paris" "reference" "fact lookup"))
  (defn ldvab-clear ()
    "<FORM_VALIDATION>\nstate=CLEAR\nconfidence=96\nsupport=94\ncontradiction=4\ncompleteness=91\nrepairability=20\nuncertainty=8\nresult=Paris\nevidence=reference agrees\nissue=\n</FORM_VALIDATION>")
  (defn ldvab-repair ()
    "<FORM_VALIDATION>\nstate=REPAIR\nconfidence=91\nsupport=51\ncontradiction=82\ncompleteness=55\nrepairability=94\nuncertainty=27\nresult=Paris\nevidence=reference contradicts candidate\nissue=candidate named Lyon\n</FORM_VALIDATION>")
  (defn ldvab-mismatch ()
    "<FORM_VALIDATION>\nstate=CLEAR\nconfidence=95\nsupport=42\ncontradiction=44\ncompleteness=39\nrepairability=21\nuncertainty=88\nresult=Paris\nevidence=conflict\nissue=uncertain\n</FORM_VALIDATION>")
  (defn ldvab-cap (surface)
    (do (let parsed (dvp-parse surface))
      (let model (dvc-train))
      (let predicted (if (eq (nth parsed 0) 1)
        (dvc-predict model (dvc-features-from-parse parsed))
        (dvp-state-invalid)))
      (list (ldvab-payload) "prompt" (list 0 128803) (list 1) surface parsed predicted
        (if (and (eq (nth parsed 0) 1) (eq predicted (nth parsed 1))) 1 0))))
  (defn ldvab-health ()
    (lfsm-health (fc-certified-form-reading 1 1) 1 1 1 1))
  (defn ldvab-request ()
    (lfsm-request 1 (ldvab-payload)
      (list (lfsm-word (cwi-word-node "we") 24 7)
            (lfsm-word (cwi-word-node "do") 32 6))
      3 (cwi-lens 2 5 6 7) 7001 4 10 5 (ldvab-health)))
  (defn ldvab-bit (ok bit) (if ok bit 0))
  (let request (ldvab-request))
  (let clear (ldva-from-capture request 9001 (ldvab-cap (ldvab-clear))))
  (let repair (ldva-from-capture request 9001 (ldvab-cap (ldvab-repair))))
  (let mismatch (ldva-from-capture request 9001 (ldvab-cap (ldvab-mismatch))))
  (let malformed (ldva-from-capture request 9001 (ldvab-cap "CLEAR")))
  (let score
    (add (ldvab-bit (and (eq (lvl-validation-state clear) (lvl-state-clear))
                         (eq (lvl-validation-result clear) 9001)) 1)
    (add (ldvab-bit (and (eq (lvl-validation-state repair) (lvl-state-repaired))
                         (eq (ldva-repair-node? (lvl-validation-result repair)) 1)) 2)
    (add (ldvab-bit (eq (lvl-validation-state mismatch) (lvl-state-unresolved)) 4)
    (add (ldvab-bit (eq (lvl-validation-state malformed) (lvl-state-unresolved)) 8)
         (ldvab-bit (eq (nth (ldvab-cap (ldvab-clear)) 1) "prompt") 16))))))
  (list (nothing) 1001099999 score (if (eq score 31) 1 0)))
