; One semantic request crosses three different LLM surfaces, becomes water,
; crystallizes, and then returns by Form-native keyed lookup without evaluation.
; Changed phase and stale reality re-open computation; mismatch revises; unknown
; health remains useful water but cannot become trusted ice.
import "../llm-form-substrate-membrane.fk"

(do
  (defn lfsmb-compute (request) 9001)
  (defn lfsmb-no-answer (request) (nothing))
  (defn lfsmb-ready-health ()
    (lfsm-health (fc-human-reading 1 1) 1 1 1 1))
  (defn lfsmb-unknown-health ()
    (lfsm-health (fc-unmeasured-reading) 2 2 2 1))
  (defn lfsmb-words (phase)
    (list (lfsm-word (cwi-word-node "we") phase 7)
          (lfsm-word (cwi-word-node "do") 32 6)
          (lfsm-word (cwi-word-node "exist") 40 5)))
  (defn lfsmb-request (model surface phase epoch health)
    (lfsm-request model surface (lfsmb-words phase) 3
      (cwi-lens 2 5 6 7) 7001 4 epoch 5 health))
  (defn lfsmb-ok (condition bit) (if condition bit 0))

  (defn lfsmb-witness ()
    (do
      (framebuffer-clear)
      (let a (lfsmb-request 11 101 24 10 (lfsmb-ready-health)))
      (let b (lfsmb-request 22 202 24 11 (lfsmb-ready-health)))
      (let c (lfsmb-request 33 303 24 12 (lfsmb-ready-health)))
      (let phase-shift (lfsmb-request 11 404 96 12 (lfsmb-ready-health)))
      (let stale (lfsmb-request 44 505 24 20 (lfsmb-ready-health)))
      (let unknown-a (lfsmb-request 55 606 24 10 (lfsmb-unknown-health)))
      (let unknown-b (lfsmb-request 66 707 24 11 (lfsmb-unknown-health)))

      ; Different model/tokenizer surfaces converge on one neutral key.
      (let same-key (km-keq (lfsm-key a) (lfsm-key b)))
      (let memory0 (km-for 16))
      (let step1 (lfsm-enter memory0 a lfsmb-compute))
      (let memory1 (lfsm-step-memory step1))
      (let response1 (lfsm-step-response step1))
      (let step2 (lfsm-enter memory1 b lfsmb-compute))
      (let memory2 (lfsm-step-memory step2))
      (let response2 (lfsm-step-response step2))
      (let step3 (lfsm-enter memory2 c lfsmb-no-answer))
      (let response3 (lfsm-step-response step3))

      ; Situated frequency and freshness are live: neither may borrow old ice.
      (let shifted-step (lfsm-enter memory2 phase-shift lfsmb-compute))
      (let shifted-response (lfsm-step-response shifted-step))
      (let stale-step (lfsm-enter memory2 stale lfsmb-compute))
      (let stale-response (lfsm-step-response stale-step))

      ; A conflicting prior result is observed and revised, not silently reused.
      (let bad-entry (lfsm-entry (lfsm-water) 9002 1 15
        (list (list 77 808 10 9002))
        (lfsm-phrase-resonance (lfsm-request-words a))))
      (let bad-memory (km-put (km-for 1) (lfsm-key a) bad-entry))
      (let revise-step (lfsm-enter bad-memory a lfsmb-compute))
      (let revise-response (lfsm-step-response revise-step))

      ; Useful computation continues when health is unknown, but it cannot ice.
      (let unknown-step1 (lfsm-enter (km-for 1) unknown-a lfsmb-compute))
      (let unknown-step2 (lfsm-enter (lfsm-step-memory unknown-step1)
        unknown-b lfsmb-compute))
      (let unknown-response2 (lfsm-step-response unknown-step2))

      ; A genuinely unanswered computation opens evidence rather than fabricating.
      (let empty-step (lfsm-enter (km-for 1) a lfsmb-no-answer))
      (let empty-response (lfsm-step-response empty-step))
      (let frames (len (framebuffer-events)))

      (let score
        (add
          (lfsmb-ok (eq same-key 1) 1)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route response1) (lfsm-route-execute))
            (eq (lfsm-response-state response1) (lfsm-water))) 2)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route response2) (lfsm-route-execute))
            (eq (lfsm-response-state response2) (lfsm-ice))) 4)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route response3) (lfsm-route-lookup))
            (eq (lfsm-response-result response3) 9001)) 8)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route shifted-response) (lfsm-route-execute))
            (not (eq (lfsm-response-key-hash shifted-response)
                     (lfsm-response-key-hash response3)))) 16)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route stale-response) (lfsm-route-execute))
            (eq (lfsm-response-state stale-response) (lfsm-water))) 32)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route revise-response) (lfsm-route-revise))
            (eq (lfsm-response-result revise-response) 9001)) 64)
          (add (lfsmb-ok (and
            (eq (lfsm-response-state unknown-response2) (lfsm-water))
            (eq (lfsm-response-observations unknown-response2) 2)) 128)
          (add (lfsmb-ok (and
            (eq (lfsm-response-route empty-response) (lfsm-route-evidence))
            (nothing? (lfsm-response-result empty-response))) 256)
          (add (lfsmb-ok (gt frames 0) 512)
          (lfsmb-ok (not (eq
            (lfsm-phrase-resonance (lfsm-request-words a))
            (lfsm-phrase-resonance (lfsm-request-words phase-shift)))) 1024))))))))))))
      ; [nothing,0,1,node, score, frames, first, crystallize, lookup,
      ;  shifted, stale, revised, unknown-health, no-answer, success]
      (list (nothing) 0 1 1001099699 score frames
        (list (lfsm-response-route response1) (lfsm-response-state response1))
        (list (lfsm-response-route response2) (lfsm-response-state response2))
        (list (lfsm-response-route response3) (lfsm-response-state response3))
        (lfsm-response-route shifted-response)
        (list (lfsm-response-route stale-response) (lfsm-response-state stale-response))
        (lfsm-response-route revise-response)
        (lfsm-response-state unknown-response2)
        (lfsm-response-route empty-response)
        (if (eq score 2047) 1 0))))
  (lfsmb-witness))
