; giles-light-hubs-neutral-kernel-band.fk
;
; The public vector proves that one numeric 36-fact graph is independent of
; its registered EN/ID NL and Form/Python PL projections. Unknown targets stay
; nothing; full-body absence and lossy human extraction remain explicit.
import "../../learn/giles-light-hubs-candidate.fk"

(do
  (defn glhnb-witness ()
    (do
      (let source (ctsr-find (glh-source-id)))
      (let graph (glhn-graph))
      (let digest-before (glhn-graph-digest))
      (let en (glhn-render 1 "en"))
      (let id (glhn-render 1 "id"))
      (let form (glhn-render 2 "form"))
      (let python (glhn-render 2 "python"))
      (let digest-after (glhn-graph-digest))
      (let unknown-nl (glhn-render 1 "unregistered"))
      (let unknown-pl (glhn-render 2 "unregistered"))
      (let success
        (if (and
          (eq (glhn-structure-witness) 127)
          (and (eq (ctsr-content-state source) (ctsr-content-neutral-kernel))
          (and (eq (glh-public-segment-count) 0)
          (and (eq (len en) 36)
          (and (eq (len id) 36)
          (and (eq (len form) 36)
          (and (eq (len python) 36)
          (and (str_eq (head en)
            "light hub includes land [structural paraphrase; order=1]")
          (and (str_eq (head id)
            "pusat cahaya mencakup lahan [parafrasa struktural; order=1]")
          (and (str_eq (head form)
            "(list 3041001001 3041005001 3041001010 3041006001 1)")
          (and (str_eq (head python)
            "(3041001001, 3041005001, 3041001010, 3041006001, 1)")
          (and (eq digest-before digest-after)
          (and (nothing? unknown-nl)
          (and (nothing? unknown-pl)
          (and (eq (glhn-extraction-human-witnessed) 1)
          (and (eq (glhn-native-general-parser) 0)
               (eq (len (glhn-losses)) 3))))))))))))))))) 1 0))
      (list (nothing) 0 1 (glhn-witness-node)
        (glh-source-id) (str_len (glh-sha256))
        (len graph)
        (len (glhn-core-facts))
        (len (glhn-action-facts))
        (len (glhn-place-facts))
        (len (glhn-practice-facts))
        (len (glhn-phenomenology-facts))
        (len (glhn-provenance-facts))
        (len en) (len id) (len form) (len python)
        digest-before digest-after
        (glhn-extraction-human-witnessed)
        (glhn-native-general-parser)
        (len (glhn-losses))
        unknown-nl unknown-pl success)))

  (glhnb-witness))
