; preludes: form-stdlib/core.fk form-stdlib/thought-framebuffer.fk cognition/multilingual-balance-experiment.fk
;
; Observe the modeled Chinese, Arabic, Sanskrit, and combined non-English
; coverage rise across 100 steps. This proves the counter and parity schedule,
; not the presence of yet-uningested source content. Verdict 255.
(do
    (let rows (mbe-language-checkpoints))
    (let first (head rows))
    (let last (nth rows 4))
    (defn mcgb-bit (ok bit) (if ok bit 0))
    (add (mcgb-bit (eq (nth first 5) 192) 1)
    (add (mcgb-bit (eq (nth last 5) 184092) 2)
    (add (mcgb-bit (eq (nth first 4) 64) 4)
    (add (mcgb-bit (eq (nth last 4) 61364) 8)
    (add (mcgb-bit (eq (nth last 1) 61335) 16)
    (add (mcgb-bit (eq (mbe-parity-lanes last) 3) 32)
    (add (mcgb-bit (eq (mbe-language-rises? rows 4) 1) 64)
         (mcgb-bit (eq (mbe-language-rises? rows 5) 1) 128)))))))))
