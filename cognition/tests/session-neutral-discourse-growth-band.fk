; session-neutral-discourse-growth-band.fk — typed hierarchy, Pareto-visible
; selection, normalized locale realization, and reversible paragraph graph.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-discourse-growth.fk

(do
  (defn sndgb-bit (condition bit) (if condition bit 0))
  (defn sndgb-frontier-undominated? (frontier proposals)
    (if (eq (len frontier) 0) 0
      (if (eq (sndg-dominated-by-any? (head frontier) proposals) 0)
        (if (eq (len (tail frontier)) 0) 1
          (sndgb-frontier-undominated? (tail frontier) proposals)) 0)))
  (defn sndgb-realizations-complete? (realizations)
    (if (eq (len realizations) 0) 0
      (if (and (str_eq (sndg-gr-state (head realizations))
                 "complete-normalized-projection")
               (gt (str_len (sndg-gr-surface (head realizations))) 0))
        (if (eq (len (tail realizations)) 0) 1
          (sndgb-realizations-complete? (tail realizations))) 0)))
  (defn sndgb-sum (values)
    (if (eq (len values) 0) 0
      (add (head values) (sndgb-sum (tail values)))))
  (defn sndgb-check ()
    (do
      (let opened (snmt-open))
      (let runtime (snmt-o-runtime opened))
      (let dictionary (snmt-o-dictionary opened))
      (let growth (sndg-grow 108))
      (let replay (sndg-grow 108))
      (let other (sndg-grow 109))
      (let rounds (sndg-w-rounds growth))
      (let first-round (head rounds))
      (let paragraph (sndg-w-paragraph growth))
      (let codes (list "en" "de" "zh" "fr" "ban" "sa"))
      (let realizations (sndg-realize-paragraphs runtime dictionary
        paragraph codes))
      (let graph (sndg-graph growth realizations))
      (let first-surface (head realizations))
      (sndgb-sum (list
        (sndgb-bit (and (eq (sndg-modes-closed?) 1)
                         (eq (sndg-discourses-closed?) 1)) 1)
        (sndgb-bit (and (eq (len rounds) 4)
                         (eq (sndg-clauses-valid?
                           (sndg-sentence-clauses
                             (sndg-w-sentences growth))) 1)) 2)
        (sndgb-bit (and (eq (len (sndg-r-proposals first-round)) 3)
                         (gt (len (sndg-r-frontier first-round)) 0)) 4)
        (sndgb-bit (eq (sndgb-frontier-undominated?
                         (sndg-r-frontier first-round)
                         (sndg-r-proposals first-round)) 1) 8)
        (sndgb-bit (and (str_eq (sndg-r-state first-round)
                           "selected-from-pareto-frontier")
                         (eq (len (sndg-p-vector
                           (sndg-r-selected first-round))) 6)) 16)
        (sndgb-bit (and (eq (sndg-sentence-valid?
                           (head (sndg-w-sentences growth))) 1)
                         (eq (sndg-sentence-valid?
                           (nth (sndg-w-sentences growth) 1)) 1)) 32)
        (sndgb-bit (eq (sndg-paragraph-valid? paragraph) 1) 64)
        (sndgb-bit (and (eq (len (sndg-g-sentences paragraph)) 2)
                         (eq (len (sndg-g-relations paragraph)) 1)) 128)
        (sndgb-bit (eq (snmt-field-address-valid?
                           (sndg-g-theme paragraph)) 1) 256)
        (sndgb-bit (and (eq (len realizations) 6)
                         (eq (sndgb-realizations-complete?
                           realizations) 1)) 512)
        (sndgb-bit (and (str_eq (sndg-gr-locale first-surface) "en")
                         (value_eq (sndg-gr-paragraph first-surface)
                           (sndg-g-address paragraph))) 1024)
        (sndgb-bit (and (gt (len graph) 40)
                         (eq (sndg-surface-receipts graph realizations) 6)) 2048)
        (sndgb-bit (and (value_eq (sndg-g-address
                           (sndg-w-paragraph growth))
                           (sndg-g-address (sndg-w-paragraph replay)))
                         (not (value_eq (sndg-g-address
                           (sndg-w-paragraph growth))
                           (sndg-g-address
                             (sndg-w-paragraph other))))) 4096)
        (sndgb-bit (and (eq (len (sndg-r-vectors first-round)) 3)
                         (eq (len (sndg-r-clause-roles first-round)) 5)) 8192)
        (sndgb-bit (and (eq (len (sndg-cr-roles
                           (head (sndg-sr-clauses
                             (head (sndg-gr-sentences
                               first-surface)))))) 5)
                         (eq (sndg-clause-valid?
                           (sndg-r-clause first-round)) 1)) 16384)))))

  (print (sndgb-check)))
