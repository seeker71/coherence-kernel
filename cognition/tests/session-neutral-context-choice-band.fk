; session-neutral-context-choice-band.fk — context offers without first-hit
; collapse; unsupported and tied relations abstain.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-context-choice.fk

(do
  (defn snscb-bit (condition bit) (if condition bit 0))
  (defn snscb-candidate-for (candidates meaning-address)
    (if (eq (len candidates) 0) (empty)
      (if (value_eq meaning-address
            (snsp-m-address (snsp-b-meaning
              (snsc-c-binding (head candidates)))))
        (head candidates)
        (snscb-candidate-for (tail candidates) meaning-address))))
  (defn snscb-check ()
    (do
      (let runtime (snsf-open))
      (let rows (snsf-resolve-text runtime "en" "yes trust"))
      (let field-rows (snsf-resolve-text runtime "en" "trust flow vitality"))
      (let dictionary (snsr-rebase (snsr-rebase (empty) rows) field-rows))
      (let phrases (snsp-observe (empty) rows 2 2))
      (let expression (snsp-c-address (head (snsp-span-cells rows 2 2))))
      (let trust-address (snsf-concept-address 490))
      (let flow-address (snsf-concept-address 3382))
      (let trust-meaning (snsp-meaning dictionary (list trust-address)))
      (let flow-meaning (snsp-meaning dictionary (list flow-address)))
      (let binding-evidence (list (snsf-structure-address 14)))
      (let trust-binding (snsp-binding phrases expression trust-meaning
        binding-evidence "candidate"))
      (let flow-binding (snsp-binding phrases expression flow-meaning
        binding-evidence "candidate"))
      (let bindings (list trust-binding flow-binding))
      (let w1 (snsf-address 15 11))
      (let w2 (snsf-address 15 12))
      (let w3 (snsf-address 15 13))
      (let w4 (snsf-address 15 14))
      (let evidence (list expression (snsf-structure-address 14)))
      (let t1 (snse-event w1 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1))
      (let t2 (snse-event w2 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1))
      (let f1 (snse-event w3 expression (snsp-m-address flow-meaning)
        (snse-support) evidence 1))
      (let f2 (snse-event w4 expression (snsp-m-address flow-meaning)
        (snse-support) evidence 1))
      (let events (list t1 t2 f1 f2))
      (let flow-context (list flow-address))
      (let context-field (snsc-context-field dictionary flow-context))
      (let offered (snsc-choice dictionary flow-context events bindings 2))
      (let offered-candidates (snsc-o-candidates offered))
      (let trust-candidate
        (snscb-candidate-for offered-candidates (snsp-m-address trust-meaning)))
      (let flow-candidate
        (snscb-candidate-for offered-candidates (snsp-m-address flow-meaning)))
      (let tied (snsc-choice dictionary (empty) events bindings 2))
      (let no-evidence (snsc-choice dictionary flow-context (empty) bindings 2))
      (let flow-release (snse-event w3 expression
        (snsp-m-address flow-meaning) (snse-release) evidence 2))
      (let flow-contested (snsc-choice dictionary flow-context
        (append events (list flow-release)) bindings 2))
      (let conflict-release (snse-event w1 expression
        (snsp-m-address trust-meaning) (snse-release) evidence 3))
      (let conflict-support (snse-event w1 expression
        (snsp-m-address trust-meaning) (snse-support) evidence 3))
      (let trust-conflicted (snsc-choice dictionary flow-context
        (append events (list conflict-release conflict-support)) bindings 2))
      (let one (snsc-choice dictionary (empty) (list t1 t2)
        (list trust-binding) 2))
      (add (snscb-bit (eq (len context-field) 13) 1)
      (add (snscb-bit (eq (snsc-resonance
                              (snsp-m-field flow-meaning) context-field) 13000) 2)
      (add (snscb-bit (and (eq (snsc-c-overlap flow-candidate) 1)
                            (eq (snsc-c-overlap trust-candidate) 0)) 4)
      (add (snscb-bit (and (str_eq (snsc-o-mode offered) "offer")
                            (value_eq (snsp-m-address
                              (snsp-b-meaning (snsc-o-binding offered)))
                              (snsp-m-address flow-meaning))) 8)
      (add (snscb-bit (eq (len offered-candidates) 2) 16)
      (add (snscb-bit (and (str_eq (snsc-o-mode tied) "ambiguous")
                            (eq (snsc-o-ties tied) 2)) 32)
      (add (snscb-bit (and (str_eq (snsc-o-mode no-evidence) "abstain")
                            (str_eq (snsc-o-reason no-evidence)
                              "no-supported-evidence")) 64)
      (add (snscb-bit (value_eq (snsp-m-address
                              (snsp-b-meaning
                                (snsc-o-binding flow-contested)))
                              (snsp-m-address trust-meaning)) 128)
      (add (snscb-bit (value_eq (snsp-m-address
                              (snsp-b-meaning
                                (snsc-o-binding trust-conflicted)))
                              (snsp-m-address flow-meaning)) 256)
      (add (snscb-bit (and (str_eq (snsc-o-mode
                              (snsc-choice dictionary flow-context events
                                (empty) 2)) "abstain")
                            (str_eq (snsc-o-reason
                              (snsc-choice dictionary flow-context events
                                (empty) 2)) "no-bindings")) 512)
      (add (snscb-bit (eq (snsc-o-score offered) 67000) 1024)
      (add (snscb-bit (gt (snsc-c-score flow-candidate)
                              (snsc-c-score trust-candidate)) 2048)
      (add (snscb-bit (and (str_eq (snsc-o-mode one) "offer")
                            (value_eq (snsc-o-binding one) trust-binding)) 4096)
      (add (snscb-bit (str_eq (snse-s-state
                              (snsc-c-summary flow-candidate)) "supported") 8192)
      (add (snscb-bit (eq (len (snsc-context-field dictionary
                              (list (snsf-residue-address "unseen")))) 0) 16384)
        0)))))))))))))))))

  (print (snscb-check)))
