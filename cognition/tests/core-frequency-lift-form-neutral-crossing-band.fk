; core-frequency-lift-form-neutral-crossing-band.fk
;
; Verdict 67108863: twenty-six power-of-two observations that identity remains
; independent of English while attributed NL and PL projections retain residue.
; witnessed: 2026-08-14 -> 67108863 on fkwu; semantic admission not claimed
import "../core-frequency-lift-form-neutral-crossing.fk"

(do
  (defn fncb-bit (condition weight) (if condition weight 0))
  (defn fncb-evidence-mutations-hold? (base changed)
    (if (eq (len changed) 0) 1
      (if (and (not (node_eq base (head changed)))
               (node_eq (cfd-map-meaning base)
                        (cfd-map-meaning (head changed))))
        (fncb-evidence-mutations-hold? base (tail changed)) 0)))
  (defn fncb-band ()
    (do
      (let runtime (cnl13-runtime-open))
      (let nl (fnc-nl-required-projections runtime))
      (let pl (fnc-pl-dependency-projections))
      (let need (fnc-nl-need-projections))
      (let symbol (fnc-dependency-symbol))
      (let id (fnc-find-projection nl "id"))
      (let de (fnc-find-projection nl "de"))
      (let zh (fnc-find-projection nl "zh"))
      (let ja (fnc-find-projection nl "ja"))
      (let ar (fnc-find-projection nl "ar"))
      (let ru (fnc-find-projection nl "ru"))
      (let hi (fnc-find-projection nl "hi"))
      (let sw (fnc-find-projection nl "sw"))
      (let zh-need (fnc-find-projection need "zh"))
      (let ja-need (fnc-find-projection need "ja"))
      (let id-need (fnc-find-projection need "id"))
      (let id-mapping (fnc-projection-mapping id 1002))
      (let id-provenance (cfd-map-provenance id-mapping))
      (let id-evidence (cfd-prov-lineage-evidence id-provenance))
      (let changed-state (fnc-projection 1 "id" "keperluan"
        (fnc-nl-necessary-anchor) 1 "changed-state"
        (fnc-p-source id) "D" 37 "01580050-a"))
      (let changed-source (fnc-projection 1 "id" "keperluan"
        (fnc-nl-necessary-anchor) 1 "mapped-unreviewed"
        "changed-source" "D" 37 "01580050-a"))
      (let changed-source-code (fnc-projection 1 "id" "keperluan"
        (fnc-nl-necessary-anchor) 1 "mapped-unreviewed"
        (fnc-p-source id) "W" 37 "01580050-a"))
      (let changed-residue (fnc-projection 1 "id" "keperluan"
        (fnc-nl-necessary-anchor) 1 "mapped-unreviewed"
        (fnc-p-source id) "D" 36 "01580050-a"))
      (let changed-lineage (fnc-projection 1 "id" "keperluan"
        (fnc-nl-necessary-anchor) 1 "mapped-unreviewed"
        (fnc-p-source id) "D" 37 "changed-lineage"))
      (let changed-state-mapping (fnc-projection-mapping changed-state 1002))
      (let changed-source-mapping (fnc-projection-mapping changed-source 1002))
      (let changed-source-code-mapping
        (fnc-projection-mapping changed-source-code 1002))
      (let changed-residue-mapping
        (fnc-projection-mapping changed-residue 1002))
      (let changed-lineage-mapping
        (fnc-projection-mapping changed-lineage 1002))
      (let crossing-mappings (fnc-crossing-mappings runtime))
      (let projected-id (cfd-project-in crossing-mappings
        (fnc-nl-necessary-anchor) "id" (cfd-c-specification)))
      (sum (list
        (fncb-bit (and (node_eq symbol (cfd-requirement-dependency))
          (and (node_eq (fnc-a-anchor (fnc-nl-dependency-alignment))
                        (fnc-nl-necessary-anchor))
          (and (node_eq (fnc-a-recipe (fnc-nl-dependency-alignment)) symbol)
          (and (eq (fnc-a-residue (fnc-nl-dependency-alignment)) 36)
          (and (node_eq (fnc-a-recipe (fnc-pl-dependency-alignment)) symbol)
               (eq (fnc-a-residue (fnc-pl-dependency-alignment)) 40)))))) 1)
        (fncb-bit (eq (cfd-no-surface? symbol 64) 1) 2)
        (fncb-bit (and (eq (len nl) 13)
                       (eq (len (fnc-crossing-mappings runtime)) 39)) 4)
        (fncb-bit (eq (len pl) 13) 8)
        (fncb-bit (eq (len need) 13) 16)
        (fncb-bit (eq (fnc-all-symbol? nl (fnc-nl-necessary-anchor)) 1) 32)
        (fncb-bit (eq (fnc-all-symbol? pl (fnc-pl-dependency-anchor)) 1) 64)
        (fncb-bit (and (eq (fnc-all-symbol? need (fnc-need-enquiry-anchor)) 1)
          (and (node_eq (fnc-a-recipe (fnc-need-enquiry-alignment))
                        (fnc-need-enquiry-symbol))
               (not (node_eq symbol (fnc-need-enquiry-symbol))))) 128)
        (fncb-bit (and (eq (fnc-count-source-code nl "F") 1)
          (and (eq (fnc-count-source-code nl "D") 1)
          (and (eq (fnc-count-source-code nl "W") 10)
          (and (eq (fnc-count-source-code nl "G") 1)
          (and (str_eq (fnc-p-surface sw) "muhimu")
          (and (eq (fnc-p-residue sw) 39)
               (eq (fnc-all-source-state-consistent? nl) 1))))))) 256)
        (fncb-bit (and (str_eq (fnc-p-surface id) "keperluan")
          (and (str_eq (fnc-p-source-code id) "D")
               (eq (fnc-p-residue id) 37))) 512)
        (fncb-bit (and (str_eq (fnc-p-surface de) "nötig")
          (and (str_eq (fnc-p-source-code de) "W")
               (eq (fnc-p-residue de) 37))) 1024)
        (fncb-bit (and (str_eq (fnc-p-surface zh) "必要")
          (and (str_eq (fnc-p-source-code zh) "W")
               (eq (fnc-p-residue zh) 37))) 2048)
        (fncb-bit (and (str_eq (fnc-p-surface ja) "必要")
          (and (str_eq (fnc-p-source-code ja) "W")
               (eq (fnc-p-residue ja) 37))) 4096)
        (fncb-bit (and (str_eq (fnc-p-surface ar) "ضروري")
          (and (str_eq (fnc-p-source-code ar) "W")
               (eq (fnc-p-residue ar) 37))) 8192)
        (fncb-bit (and (eq (fnc-all-pl-detected? pl) 1)
          (and (eq (fnc-all-pl-dependency-construct? pl) 1)
               (eq (fnc-all-language-only?
                     (fnc-pl-language-only-data)) 1))) 16384)
        (fncb-bit (eq (fnc-all-residue? pl 40) 1) 32768)
        (fncb-bit (and (str_eq (fnc-p-surface zh-need) "你需要什么？")
          (and (str_eq (fnc-p-surface ja-need) "何が必要ですか？")
          (and (str_eq (fnc-p-surface id-need) "Apa yang Anda butuhkan?")
          (and (str_eq (fnc-p-surface ru) "необходимый")
               (str_eq (fnc-p-surface hi) "ज़रूरी"))))) 65536)
        (fncb-bit (and
          (str_eq (fnc-p-source zh-need) (fnc-p-source ja-need))
          (and (not (str_eq (fnc-p-lineage zh-need)
                            (fnc-p-lineage ja-need)))
               (not (str_eq (fnc-p-lineage ja-need)
                            (fnc-p-lineage id-need))))) 131072)
        (fncb-bit (and (eq (fnc-all-symbol?
          (fnc-without-locale nl "en") (fnc-nl-necessary-anchor)) 1)
          (eq (len (fnc-without-locale nl "en")) 12)) 262144)
        (fncb-bit (and
          (eq (len (fnc-parse-crossing runtime "id" "keperluan"
                    (cfd-c-specification))) 1)
          (and (eq (len (fnc-parse-crossing runtime "zh" "必要"
                        (cfd-c-specification))) 1)
          (and (eq (len (fnc-parse-crossing runtime "pl:python"
                        "from m import x\n" (cfd-c-software))) 1)
          (and (eq (len (fnc-parse-crossing runtime "unknown" "∿"
                        (cfd-context-any))) 0)
               (nothing? (fnc-find-projection pl "brainfuck")))))) 524288)
        (fncb-bit (and
          (node_eq (fnc-p-anchor (fnc-projection 1 "x" "∿"
            (fnc-nl-necessary-anchor) 1 "offered" "participant" "new" 33
            "participant-offer")) (fnc-nl-necessary-anchor))
          (and (eq (cfd-no-surface? (fnc-p-anchor
            (fnc-projection 1 "x" "∿" (fnc-nl-necessary-anchor) 1
              "offered" "participant" "new" 33 "participant-offer")) 64) 1)
               (eq (fnc-all-lineage? nl "01580050-a") 1))) 1048576)
        (fncb-bit (and
          (eq (fnc-all-residue? need 48) 1)
          (and (str_eq (fnc-p-state zh-need)
                       "bounded-rented-voice-seed-unreviewed")
          (and (str_eq (fnc-p-state (fnc-find-projection need "sw"))
                       "bounded-rented-voice-seed-unreviewed")
               (str_eq (fnc-p-source zh-need)
                       "cognition/nl-lenses-13-data.fk")))) 2097152)
        (fncb-bit (and
          (not (nothing? id-evidence))
          (and (str_eq (fnc-pe-state id-evidence) (fnc-p-state id))
          (and (str_eq (fnc-pe-source id-evidence) (fnc-p-source id))
          (and (str_eq (fnc-pe-source-code id-evidence) "D")
          (and (eq (fnc-pe-residue id-evidence) 37)
          (and (str_eq (fnc-pe-lineage id-evidence) "01580050-a")
          (and (eq (cfd-prov-residue id-provenance) 37)
          (and (str_eq (cfd-corpus-revision (cfd-occ-corpus
                (cfd-prov-occurrence id-provenance))) "01580050-a")
          (and (eq (cfd-prov-claim id-provenance) 1)
               (eq (fncb-evidence-mutations-hold? id-mapping
                 (list changed-state-mapping changed-source-mapping
                   changed-source-code-mapping changed-residue-mapping
                   changed-lineage-mapping)) 1)))))))))) 4194304)
        (fncb-bit (and (eq (len projected-id) 1)
          (and (node_eq (head projected-id) id-mapping)
               (not (nothing? (cfd-prov-lineage-evidence
                 (cfd-map-provenance (head projected-id))))))) 8388608)
        (fncb-bit (and
          (eq (len (cfd-render-in crossing-mappings
            (fnc-nl-necessary-anchor) "id" (cfd-c-specification))) 0)
          (eq (len (cfd-render-loop crossing-mappings
            (fnc-nl-necessary-anchor) "id" (cfd-c-specification))) 0)) 16777216)
        (fncb-bit (and
          (eq (fnc-all-mapping-claim? crossing-mappings 1) 1)
          (and (eq (cfd-all-mapping-meanings-real? crossing-mappings) 0)
               (eq (cfd-all-mapping-meanings-pure? crossing-mappings) 1))) 33554432)
      ))))
  (fncb-band))
