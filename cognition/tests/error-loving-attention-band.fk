; Error-as-signal teaching: absence, present negative, present positive,
; timeout, retained evidence, movement, pause, and release remain distinct.
; preludes: form-stdlib/core.fk cognition/error-loving-attention.fk
; Verdict 4095.

(do
    (defn elab-has? (xs value)
        (if (eq (len xs) 0) 0
            (if (str_eq (head xs) value) 1 (elab-has? (tail xs) value))))
    (defn elab-bit (ok bit) (if ok bit 0))
    (defn elab-band ()
        (do
            (let error (ela-signal "error" 32767 2015 "form-cli-universe-mint-band"))
            (let timed (ela-signal "timeout" 1 (nothing) "resident-forward"))
            (let retuned (ela-signal "retune-away" 32767 2015 "expected-mask"))
            (let resolved (ela-signal "resolved" 32767 32767 "heldout-reobserve"))
            (let false-resolved (ela-signal "resolved" 32767 2015 "label-only"))
            (let attended (ela-attend error))
            (let t-attended (ela-attend timed))
            (let r-attended (ela-attend retuned))
            (let done (ela-attend resolved))
            (add
                (elab-bit (nothing? (ela-health (nothing))) 1)
            (add
                (elab-bit (eq (ela-health retuned) 0) 2)
            (add
                (elab-bit (eq (ela-health error) 1) 4)
            (add
                (elab-bit (and (eq (ela-prediction (nth attended 0)) 32767)
                               (eq (ela-observation (nth attended 0)) 2015)) 8)
            (add
                (elab-bit (eq (len (nth attended 2)) 13) 16)
            (add
                (elab-bit (and (eq (elab-has? (nth attended 2) "steer") 1)
                               (eq (elab-has? (nth attended 2) "digest") 1)) 32)
            (add
                (elab-bit (and (eq (elab-has? (nth t-attended 2) "pause") 1)
                               (eq (elab-has? (nth t-attended 2) "request-evidence") 1)) 64)
            (add
                (elab-bit (and (eq (elab-has? (nth r-attended 2) "restore-error") 1)
                               (eq (elab-has? (nth r-attended 2) "release") 0)) 128)
            (add
                (elab-bit (eq (ela-release? done) 1) 256)
            (add
                (elab-bit (and (eq (ela-release? attended) 0)
                               (eq (ela-release? (ela-attend false-resolved)) 0)) 512)
            (add
                (elab-bit (nothing? (ela-attend (list "malformed"))) 1024)
                (elab-bit (and (nothing? (ela-health (ela-signal "unknown" 0 0 "x")))
                               (nothing? (ela-movement (ela-signal "unknown" 0 0 "x")))) 2048))))))))))))))
    (elab-band))
