; reciprocal-choice-microkernel-band.fk — two-turn embodiment, declared-charge
; mode switch, channel-budget change, fragment replacement, and budget controls.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the native carrier preserves actual `nothing`;
; the Go / Rust / TypeScript proof siblings currently reject that established
; offer/ack value before this kernel is reached.
; Verdict 4194303.
import "../reciprocal-choice-microkernel.fk"
import "../reciprocal-choice-microkernel-observations.fk"

(do
  (defn rcmb-bit (condition bit) (if condition bit 0))
  (defn rcmb-sum (bits)
    (if (eq (len bits) 0) 0
      (add (head bits) (rcmb-sum (tail bits)))))
  ; Read the discriminator retained at ack construction. Re-reading an interned
  ; ack node after unrelated node creation is a known native last-writer seam.
  (defn rcmb-observation-one-ack-bit ()
    (rcmb-bit (eq
      (rcm-answer-ack-kind (rcm-e-answer (rcmo-exchange-one)))
      (oac-tag-one)) 32))
  (let o1 (rcmo-observation-one))
  (let o2 (rcmo-observation-two))

  ; Negative budget control: matching thought is ready but costs 5 inside 3;
  ; default interrupt yields the nothing ack and no model pass-through.
  (let budget-human
    (rcm-explicit-choice 9001 (rcm-mode-do) 3 5 5 2001 3001
      (rcm-fallback-interrupt)))
  (let budget-sema
    (rcm-declared-charge-choice 9002 (rcm-charges 10 90 20 10 90 20 90)
      5 5 2001 3001 (rcm-fallback-interrupt)))
  (let budget-offer
    (rcm-offer 9 budget-human 4001 799
      (list (rcm-candidate (rcm-mode-do) 5 95 798 3001)) 70))
  (let budget-answer (rcm-answer budget-offer budget-sema))
  (let budget-x (rcm-answer-execution budget-answer))

  ; Explicit pass-through control: both sides must choose model-pass.
  (let pass-human
    (rcm-explicit-choice 9101 (rcm-mode-do) 3 5 5 2001 3001
      (rcm-fallback-model-pass)))
  (let pass-sema
    (rcm-declared-charge-choice 9102 (rcm-charges 10 90 20 10 90 20 90)
      5 5 2001 3001 (rcm-fallback-model-pass)))
  (let pass-offer
    (rcm-offer 10 pass-human 4001 799
      (list (rcm-candidate (rcm-mode-do) 5 95 798 3001)) 70))
  (let pass-x (rcm-answer-execution (rcm-answer pass-offer pass-sema)))

  ; Discriminating mixed control: either interrupt preference must prevent pass.
  (let mixed-human
    (rcm-explicit-choice 9201 (rcm-mode-do) 3 5 5 2001 3001
      (rcm-fallback-interrupt)))
  (let mixed-sema
    (rcm-declared-charge-choice 9202 (rcm-charges 10 90 20 10 90 20 90)
      5 5 2001 3001 (rcm-fallback-model-pass)))
  (let mixed-offer
    (rcm-offer 11 mixed-human 4001 799
      (list (rcm-candidate (rcm-mode-do) 5 95 798 3001)) 70))
  (let mixed-answer (rcm-answer mixed-offer mixed-sema))
  (let mixed-x (rcm-answer-execution mixed-answer))

  ; Mirrored discriminating control: receiver interrupt must also prevent pass.
  (let reverse-human
    (rcm-explicit-choice 9301 (rcm-mode-do) 3 5 5 2001 3001
      (rcm-fallback-model-pass)))
  (let reverse-sema
    (rcm-declared-charge-choice 9302 (rcm-charges 10 90 20 10 90 20 90)
      5 5 2001 3001 (rcm-fallback-interrupt)))
  (let reverse-offer
    (rcm-offer 12 reverse-human 4001 799
      (list (rcm-candidate (rcm-mode-do) 5 95 798 3001)) 70))
  (let reverse-answer (rcm-answer reverse-offer reverse-sema))
  (let reverse-x (rcm-answer-execution reverse-answer))

  ; Crossed axes distinguish independent argmaxes from a mode→budget shortcut.
  (let crossed-charges (rcm-charges 10 90 20 10 20 90 90))
  (let state-expression (rcm-state-expression (rcm-state-active)))

  (rcmb-sum (list
    (rcmb-bit (and (eq (rcm-e-turns (rcmo-exchange-one)) 2)
                   (eq (rcm-e-turns (rcmo-exchange-two)) 2)) 1)
    (rcmb-bit (and (eq (rcm-choice-source (rcm-o-offerer o1)) (rcm-source-explicit))
                   (eq (rcm-choice-source (rcm-o-offerer o2)) (rcm-source-explicit-carry-ack))) 2)
    (rcmb-bit (and (eq (rcm-selected-from-declared-charges? (rcm-o-receiver o1)) 1)
                   (eq (rcm-selected-from-declared-charges? (rcm-o-receiver o2)) 1)) 4)
    (rcmb-bit (and (eq (rcm-choice-mode (rcm-o-receiver o1)) (rcm-mode-do))
                   (eq (rcm-choice-budget (rcm-o-receiver o1)) 3)) 8)
    (rcmb-bit (and (eq (rcm-o-budget o1) 3)
      (and (eq (rcm-o-output o1) 701)
      (and (eq (rcm-o-provenance o1) (rcm-provenance-microkernel))
           (eq (rcm-o-replaced o1) 1)))) 16)
    (rcmb-observation-one-ack-bit)
    (rcmb-bit (and (eq (rcm-o-next-point o1) 2) (eq (rcm-o-open-awaiting-both? o1) 1)) 64)
    (rcmb-bit (and (eq (rcm-charge-mode (rcmo-sema-charges-two)) (rcm-mode-see))
                   (eq (rcm-charge-budget (rcmo-sema-charges-two)) 5)) 128)
    (rcmb-bit (eq (rcm-mode-switched? o1 o2) 1) 256)
    (rcmb-bit (eq (rcm-receiver-budget-changed? o1 o2) 1) 512)
    (rcmb-bit (and (eq (rcm-channel-budget-changed? o1 o2) 1)
                   (eq (rcm-o-budget o2) 4)) 1024)
    (rcmb-bit (and (eq (rcm-o-output o2) 712)
      (and (eq (rcm-o-provenance o2) (rcm-provenance-microkernel))
           (eq (rcm-o-replaced o2) 1))) 2048)
    (rcmb-bit (and (eq (rcm-fixture-outcome-predicate-met? o1) 1)
                   (eq (rcm-fixture-outcome-predicate-met? o2) 1)) 4096)
    (rcmb-bit (and (eq (rcm-o-point o2) (rcm-o-next-point o1))
      (and (eq (rcm-o-next-point o2) 3)
           (eq (rcm-o-open-awaiting-both? o2) 1))) 8192)
    (rcmb-bit (and (eq (rcm-x-over-budget budget-x) 1)
      (and (eq (rcm-x-output budget-x) 0)
           (eq (oac-nothing? (rcm-answer-ack budget-answer)) 1))) 16384)
    (rcmb-bit (and (eq (rcm-x-over-budget pass-x) 1)
      (and (eq (rcm-x-output pass-x) 799)
           (eq (rcm-x-provenance pass-x) (rcm-provenance-model)))) 32768)
    (rcmb-bit (and (eq (rcm-choice-state (rcm-o-receiver o1)) (rcm-state-active))
      (and (eq (rcm-choice-state (rcm-o-receiver o2)) (rcm-state-active))
           (str_eq (rcm-state-sound-name (rcm-state-active)) "humm"))) 65536)
    (rcmb-bit (and (eq (rcm-x-over-budget mixed-x) 1)
      (and (eq (rcm-x-output mixed-x) 0)
      (and (eq (rcm-x-provenance mixed-x) (rcm-provenance-none))
           (eq (oac-nothing? (rcm-answer-ack mixed-answer)) 1)))) 131072)
    (rcmb-bit (and (str_eq (nth state-expression 0) "rcm-state")
      (and (eq (nth state-expression 1) 1)
           (str_eq (nth (nth state-expression 2) 1) "humm"))) 262144)
    (rcmb-bit (and (eq (rcm-c-fragment (rcm-o-selected o1)) 701)
      (and (eq (rcm-o-offered-model-fragment o1) 700)
      (and (eq (rcm-o-threshold o1) 70)
      (and (eq (rcm-c-fragment (rcm-o-selected o2)) 712)
           (eq (rcm-o-offered-model-fragment o2) 710))))) 524288)
    (rcmb-bit (and (eq (rcm-x-over-budget reverse-x) 1)
      (and (eq (rcm-x-output reverse-x) 0)
      (and (eq (rcm-x-provenance reverse-x) (rcm-provenance-none))
           (eq (oac-nothing? (rcm-answer-ack reverse-answer)) 1)))) 1048576)
    (rcmb-bit (and (eq (rcm-charge-mode crossed-charges) (rcm-mode-do))
                   (eq (rcm-charge-budget crossed-charges) 5)) 2097152))))
