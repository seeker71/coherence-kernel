; session-neutral-meaning-realization-band.fk — active surfaces first, corpus
; and field-recipe fallback, expression casing, CJK segments, and round-trip.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-meaning-realization.fk

(do
  (defn snmrb-bit (condition bit) (if condition bit 0))
  (defn snmrb-candidate-address-in? (candidates address)
    (if (eq (len candidates) 0) 0
      (if (value_eq (snsf-c-address (head candidates)) address) 1
        (snmrb-candidate-address-in? (tail candidates) address))))
  (defn snmrb-check ()
    (do
      (let runtime (snsf-open))
      (let en (snsf-resolve-tokens runtime "en" (list "trust" "flow")))
      (let en-upper (snsf-resolve-tokens runtime "en" (list "TRUST")))
      (let de (snsf-resolve-tokens runtime "de" (list "Vertrauen" "Fluss")))
      (let zh (snsf-resolve-tokens runtime "zh" (list "信任" "流动")))
      (let sa (snsf-resolve-tokens runtime "sa" (list "विश्वास")))
      (let dictionary-en (snsr-rebase (snsr-rebase (empty) en) en-upper))
      (let dictionary-de (snsr-rebase dictionary-en de))
      (let dictionary-zh (snsr-rebase dictionary-de zh))
      (let dictionary (snsr-rebase dictionary-zh sa))
      (let meaning (snsp-meaning dictionary
        (list (snsf-concept-address 490) (snsf-concept-address 3382))))
      (let en-self (snmr-realize runtime dictionary meaning "en"
        (snsf-expression-self)))
      (let en-field (snmr-realize runtime dictionary meaning "en"
        (snsf-expression-field)))
      (let de-self (snmr-realize runtime dictionary meaning "de"
        (snsf-expression-self)))
      (let zh-uncased (snmr-realize runtime dictionary meaning "zh"
        (snsf-expression-uncased)))
      (let fr-self (snmr-realize runtime dictionary meaning "fr"
        (snsf-expression-self)))
      (let unavailable (snmr-realize runtime dictionary meaning "tlh"
        (snsf-expression-self)))
      (let zh-segments (snmr-combination-surfaces
        (head (snmr-r-combinations zh-uncased))))
      (let zh-roundtrip (snsf-resolve-tokens runtime "zh" zh-segments))
      (let field-meaning (snsp-meaning dictionary
        (list (snsf-field-address 7))))
      (let field-de (snmr-realize runtime dictionary field-meaning "de"
        (snsf-expression-self)))
      (add (snmrb-bit (and (str_eq (snmr-r-state en-self) "complete")
                            (eq (snmr-realization-matches?
                              en-self "trust flow") 1)) 1)
      (add (snmrb-bit (and (eq (len (head
                              (snmr-r-option-sets en-self))) 1)
                            (str_eq (snmr-o-provenance
                              (head (head (snmr-r-option-sets en-self))))
                              "session-observed")) 2)
      (add (snmrb-bit (eq (snmr-realization-matches?
                              en-field "TRUST FLOW") 1) 4)
      (add (snmrb-bit (eq (snsf-expression-code
                              (snmr-r-expression en-field)) 1) 8)
      (add (snmrb-bit (eq (snmr-realization-matches?
                              de-self "vertrauen fließen") 1) 16)
      (add (snmrb-bit (and (eq (len zh-segments) 2)
                            (eq (snmr-realization-matches?
                              zh-uncased "依赖流量") 1)) 32)
      (add (snmrb-bit (and (eq (snsf-cov-total
                              (snsf-coverage zh-roundtrip)) 2)
                            (and (eq (snsf-cov-residue
                                   (snsf-coverage zh-roundtrip)) 0)
                            (and (eq (snmrb-candidate-address-in?
                                  (snsf-t-candidates (head zh-roundtrip))
                                  (snsf-concept-address 490)) 1)
                                 (eq (snmrb-candidate-address-in?
                                   (snsf-t-candidates
                                     (head (tail zh-roundtrip)))
                                   (snsf-concept-address 3382)) 1)))) 64)
      (add (snmrb-bit (and (str_eq (snmr-r-state fr-self) "complete")
                            (str_eq (snmr-o-provenance
                              (head (head (snmr-r-option-sets fr-self))))
                              "corpus-generated")) 128)
      (add (snmrb-bit (and (str_eq (snmr-r-state unavailable) "surface-open")
                            (eq (len (snmr-r-surfaces unavailable)) 0)) 256)
      (add (snmrb-bit (and (value_eq (snmr-r-meaning en-self)
                              (snsp-m-address meaning))
                            (and (eq (len (snmr-realization-edges en-self)) 1)
                                 (eq (len (snsp-edges-to
                                   (snmr-realization-edges en-self)
                                   (snmr-surface-address "en" "trust flow"
                                     (snsf-expression-self)))) 1))) 512)
      (add (snmrb-bit (and (str_eq (snmr-r-state field-de) "complete")
                            (eq (snmr-realization-matches?
                              field-de "vertrauen") 1)) 1024)
      (add (snmrb-bit (str_eq (snmr-o-provenance
                              (head (head (snmr-r-option-sets field-de))))
                              "field-recipe-generated") 2048)
      (add (snmrb-bit (and (str_eq (snmr-separator "zh") "")
                            (str_eq (snmr-separator "de") " ")) 4096)
      (add (snmrb-bit (and (eq (len (snmr-r-combinations en-self)) 1)
                            (eq (len (snmr-r-surfaces en-self)) 1)) 8192)
      (add (snmrb-bit (and (eq (len (snmr-r-option-sets en-self)) 2)
                            (eq (len (snmr-r-option-sets zh-uncased)) 2)) 16384)
        0)))))))))))))))))

  (print (snmrb-check)))
