; tests/depth-query-lanes-band.fk — one question, two depth lanes, never merged.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk cognition/jung-neutral-kernel.fk cognition/depth-query-lanes.fk
;
; Verdict 1023 on Go / Rust / TypeScript (validate.sh) and on fkwu run directly.
; NOT registered in fourth-arm-bands.txt: fourth_band_stem only resolves bands
; under form-stdlib/tests/, so a cognition/ band cannot receive the gated fourth
; leg. Registering it would declare a lane the machinery cannot run. The fkwu
; reading below is a direct run, witnessed, not a gated one — same standing as
; cognition/tests/steiner-neutral-band.fk.
; Claims:
;   two lanes, both BELIEF, and belief ranks strictly below evidence     1
;   a live CROSSING: in English "thinking" is carried by both lanes      2
;   THE ICH LAW: every crossing answers two DIFFERENT nodes — the
;     same word standing in two graphs for two meanings, which is the
;     whole reason the levels are separate                              4
;   lane-specific tokens route to exactly one lane: shadow -> jung,
;     karma -> steiner, and neither leaks into the other                8
;   a token neither lane carries is named unreached, never filled      16
;   a reading returns that lane's anchors in query order               32
;   four rhymes, each carrying a falsifier, each spanning two levels,
;     and a rhyme is never an equivalence                              64
;   two documented contacts, each one-way, 1917 and 1935              128
;   whether they met is NOTHING — an absence recorded, not a guess    256
;   the german surfaces do not cross: "das Ich" is steiner's and
;     "Ich" is jung's, and neither lane answers the other's string    512

(do
  (defn dqb-bit (ok w) (if ok w 0))
  (defn dqb-tokens () (list "thinking" "feeling" "shadow" "karma" "quantum"))

  (defn depth-query-lanes-band ()
    (do
      (let toks (dqb-tokens))
      (let c0 (dqb-bit
        (and (eq (dql-lane-count) 2)
        (and (eq (len (dql-lanes)) 2)
        (and (eq (dql-lane-law?) 1)
             (eq (dql-all-belief?) 1)))) 1))

      (let cross (dql-crossings toks "en"))
      (let c1 (dqb-bit
        (and (eq (len cross) 2)
        (and (str_eq (nth cross 0) "thinking")
             (str_eq (nth cross 1) "feeling"))) 2))

      (let c2 (dqb-bit
        (and (eq (dql-ich-law? toks "en") 1)
             ; and shown concretely on one word
             (not (eq (dql-anchor (dql-l-steiner) "thinking" "en")
                      (dql-anchor (dql-l-jung) "thinking" "en")))) 4))

      (let c3 (dqb-bit
        (and (eq (dql-reaches? (dql-l-jung) "shadow" "en") 1)
        (and (eq (dql-reaches? (dql-l-steiner) "shadow" "en") 0)
        (and (eq (dql-reaches? (dql-l-steiner) "karma" "en") 1)
             (eq (dql-reaches? (dql-l-jung) "karma" "en") 0)))) 8))

      (let un (dql-unreached toks "en"))
      (let c4 (dqb-bit
        (and (eq (len un) 1) (str_eq (head un) "quantum")) 16))

      (let jr (dql-read (dql-l-jung) toks "en"))
      (let c5 (dqb-bit
        (and (eq (len jr) 3)
        (and (eq (nth jr 0) (jnk-denken))
        (and (eq (nth jr 1) (jnk-fuehlen))
             (eq (nth jr 2) (jnk-schatten))))) 32))

      (let c6 (dqb-bit
        (and (eq (dql-rhyme-count) 4)
        (and (eq (dql-rhymes-sound?) 1)
             (eq (dql-rhyme-is-equivalence?) 0))) 64))

      (let cs (dql-contacts))
      (let c7 (dqb-bit
        (and (eq (dql-contact-count) 2)
        (and (eq (dql-contact-one-way?) 1)
        (and (eq (dql-contact-year (nth cs 0)) 1917)
             (eq (dql-contact-year (nth cs 1)) 1935)))) 128))

      (let c8 (dqb-bit
        (and (nothing? (dql-met?))
        (and (eq (dql-met-recorded?) 0)
             ; nothing is not zero — the distinction the whole row rests on
             (not (eq (dql-met?) 0)))) 256))

      (let c9 (dqb-bit
        (and (eq (dql-reaches? (dql-l-steiner) "das Ich" "de") 1)
        (and (eq (dql-reaches? (dql-l-jung) "das Ich" "de") 0)
        (and (eq (dql-reaches? (dql-l-jung) "Ich" "de") 1)
             (eq (dql-reaches? (dql-l-steiner) "Ich" "de") 0)))) 512))

      (add c0 (add c1 (add c2 (add c3 (add c4
        (add c5 (add c6 (add c7 (add c8 c9)))))))))))

  (depth-query-lanes-band))
