; session-neutral-meaning-evidence-band.fk — latest witness choices, support,
; release, conflict, and revision remain visible without mutating bindings.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-meaning-evidence.fk

(do
  (defn snseb-bit (condition bit) (if condition bit 0))
  (defn snseb-check ()
    (do
      (let runtime (snsf-open))
      (let rows (snsf-resolve-text runtime "en" "yes trust"))
      (let other-rows (snsf-resolve-text runtime "en" "trust flow"))
      (let dictionary (snsr-rebase (snsr-rebase (empty) rows) other-rows))
      (let phrases (snsp-observe
        (snsp-observe (empty) rows 2 2) other-rows 2 2))
      (let expression (snsp-c-address (head (snsp-span-cells rows 2 2))))
      (let other-expression
        (snsp-c-address (head (snsp-span-cells other-rows 2 2))))
      (let trust-meaning
        (snsp-meaning dictionary (list (snsf-concept-address 490))))
      (let flow-meaning
        (snsp-meaning dictionary (list (snsf-concept-address 3382))))
      (let binding-evidence (list (snsf-structure-address 14)))
      (let trust-binding (snsp-binding phrases expression trust-meaning
        binding-evidence "authored-candidate"))
      (let flow-binding (snsp-binding phrases expression flow-meaning
        binding-evidence "authored-candidate"))
      (let w1 (snsf-address 15 1))
      (let w2 (snsf-address 15 2))
      (let w3 (snsf-address 15 3))
      (let w4 (snsf-address 15 4))
      (let evidence (list expression (snsf-structure-address 14)))
      (let e1 (snse-event w1 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1))
      (let e2 (snse-event w2 expression (snsp-m-address trust-meaning)
        (snse-support) evidence 1))
      (let e3 (snse-event w3 expression (snsp-m-address trust-meaning)
        (snse-release) evidence 1))
      (let e4 (snse-event w1 expression (snsp-m-address trust-meaning)
        (snse-release) evidence 2))
      (let supported (snse-summary (list e1 e2) trust-binding 2))
      (let contested (snse-summary (list e1 e2 e3) trust-binding 2))
      (let moved (snse-summary (list e1 e2 e3 e4) trust-binding 2))
      (let conflict-support (snse-event w4 expression
        (snsp-m-address trust-meaning) (snse-support) evidence 3))
      (let conflict-release (snse-event w4 expression
        (snsp-m-address trust-meaning) (snse-release) evidence 3))
      (let conflicted (snse-summary
        (list e1 e2 conflict-support conflict-release) trust-binding 2))
      (let revision (snse-revision w2 trust-binding flow-binding evidence 3))
      (let revised-events (append (list e1 e2 e3 e4) revision))
      (let old-after (snse-summary revised-events trust-binding 1))
      (let new-after (snse-summary revised-events flow-binding 1))
      (let duplicate-summary (snse-summary (list e1 e1) trust-binding 1))
      (let other-event (snse-event w3 other-expression
        (snsp-m-address trust-meaning) (snse-release) evidence 4))
      (let ignored (snse-summary (list e1 e2 other-event) trust-binding 2))
      (let invalid (snse-event w1 expression (snsp-m-address trust-meaning)
        (snse-support) (empty) 1))
      (add (snseb-bit (and (eq (snse-stances-closed?) 1)
                            (eq (snse-stance-valid? (snse-revise)) 1)) 1)
      (add (snseb-bit (and (eq (snse-event-valid? e1) 1)
                            (and (eq (nth (snse-e-address e1) 1) 13)
                                 (eq (len (snse-events-graph (list e1))) 3))) 2)
      (add (snseb-bit (and (eq (snse-s-support supported) 2)
                            (str_eq (snse-s-state supported) "supported")) 4)
      (add (snseb-bit (and (eq (snse-s-release contested) 1)
                            (str_eq (snse-s-state contested) "contested")) 8)
      (add (snseb-bit (and (eq (snse-s-support moved) 1)
                            (eq (snse-s-release moved) 2)) 16)
      (add (snseb-bit (and (eq (snse-s-conflicts conflicted) 1)
                            (str_eq (snse-s-state conflicted)
                              "witness-choice-conflict")) 32)
      (add (snseb-bit (eq (nth (snse-witness-view
                              (list e1 e4) trust-binding w1) 0) 2) 64)
      (add (snseb-bit (and (eq (len revision) 2)
                            (and (value_eq (snse-e-stance (head revision))
                                   (snse-release))
                                 (value_eq (snse-e-stance
                                   (head (tail revision)))
                                   (snse-support)))) 128)
      (add (snseb-bit (and (str_eq (snse-s-state old-after)
                              "released-by-witnesses")
                            (str_eq (snse-s-state new-after) "supported")) 256)
      (add (snseb-bit (and (eq (len trust-binding) 4)
                            (and (eq (len flow-binding) 4)
                                 (eq (len (snsp-edges-to
                                   (snse-events-graph (list e1))
                                   (snsp-m-address trust-meaning))) 1))) 512)
      (add (snseb-bit (eq (snse-event-valid? invalid) 0) 1024)
      (add (snseb-bit (and (eq (snse-s-conflicts duplicate-summary) 0)
                            (eq (snse-s-support duplicate-summary) 1)) 2048)
      (add (snseb-bit (and (eq (snse-s-support ignored) 2)
                            (eq (snse-s-release ignored) 0)) 4096)
      (add (snseb-bit (str_eq (snse-s-state
                              (snse-summary (list e1 e2) trust-binding 3))
                              "open") 8192)
      (add (snseb-bit (and (eq (snse-s-witnesses contested) 3)
                            (eq (snse-s-minimum contested) 2)) 16384)
        0)))))))))))))))))

  (print (snseb-check)))
