; session-neutral-semantic-reflection-band.fk — two-turn internal rebase.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-semantic-reflection.fk

(do
  (defn snsrb-bit (condition bit) (if condition bit 0))
  (defn snsrb-check ()
    (do
      (let runtime (snsf-open))
      (let lower-turn (snsf-resolve-text runtime "en" "trust -> response"))
      (let upper-turn (snsf-resolve-text runtime "en" "TRUST -> response"))
      (let lower-receipt (snsr-rebase-receipt (empty) lower-turn))
      (let lower-active (snsr-r-active lower-receipt))
      (let upper-receipt (snsr-rebase-receipt lower-active upper-turn))
      (let both-active (snsr-r-active upper-receipt))
      (let trust-address (snsf-concept-address 490))
      (let ya-row (snsf-resolve-one runtime "id" "ya" 0))
      (let ya-full (list ya-row))
      (let ya-active (snsr-rebase (empty) ya-full))
      (let ya-one (snsf-token 0 "ya" "word" "id"
        (list (head (snsf-t-candidates ya-row))) "one-reflected-candidate"))
      (let ya-rebased (snsr-rebase ya-active (list ya-one)))
      (let residue-row (snsf-resolve-one runtime "en" "⟐" 0))
      (let residue-active (snsr-rebase both-active (list residue-row)))
      (let request-rows (snsf-resolve-text runtime "en"
        "can we extend this to all symbols to words in most sessions so that we can have better response coverage of the words we are using to ask and respond with a native semantic frequency understanding of which words / symbols / tokens we are using"))
      (let request-receipt (snsr-rebase-receipt residue-active request-rows))
      (let request-active (snsr-r-active request-receipt))
      (let request-again (snsr-rebase request-active request-rows))
      (add (snsrb-bit (eq (snsr-reflection-valid? lower-turn) 1) 1)
      (add (snsrb-bit (eq (snsr-internal-witness (empty) lower-turn) 7) 2)
      (add (snsrb-bit (and (eq (snsr-r-before lower-receipt) 0)
                             (gt (snsr-r-after lower-receipt) 0)) 4)
      (add (snsrb-bit (gt (snsr-r-after upper-receipt)
                          (snsr-r-after lower-receipt)) 8)
      (add (snsrb-bit (and (eq (len (snsr-by-surface both-active "en" "trust")) 1)
                             (eq (len (snsr-by-surface both-active "en" "TRUST")) 1)) 16)
      (add (snsrb-bit (eq (len (snsr-by-address both-active trust-address)) 2) 32)
      (add (snsrb-bit (and (eq (snsf-expression-code (snsr-e-expression
                                (head (snsr-by-surface both-active "en" "trust")))) 0)
                             (eq (snsf-expression-code (snsr-e-expression
                                (head (snsr-by-surface both-active "en" "TRUST")))) 1)) 64)
      (add (snsrb-bit (and (str_eq (snsf-c-field-state (snsr-e-candidate
                                (head (snsr-by-surface both-active "en" "trust"))))
                                "authored-core-axis")
                             (eq (len (snsf-c-field (snsr-e-candidate
                                (head (snsr-by-surface both-active "en" "TRUST"))))) 13)) 128)
      (add (snsrb-bit (and (eq (len ya-active) 16)
                             (eq (snsr-reflection-valid? ya-full) 1)) 256)
      (add (snsrb-bit (and (eq (len ya-rebased) 1)
                             (eq (len (snsr-by-surface ya-rebased "id" "ya")) 1)) 512)
      (add (snsrb-bit (and (eq (len (snsr-by-surface residue-active "en" "⟐")) 1)
                             (value_eq (snsr-e-address
                               (head (snsr-by-surface residue-active "en" "⟐")))
                               (snsf-residue-address "⟐"))) 1024)
      (add (snsrb-bit (and (eq (snsf-cov-total (snsf-coverage request-rows)) 46)
                             (eq (snsf-cov-residue (snsf-coverage request-rows)) 0)) 2048)
      (add (snsrb-bit (eq (snsr-internal-witness residue-active request-rows) 7) 4096)
      (add (snsrb-bit (eq (len request-active) (len request-again)) 8192)
      (add (snsrb-bit (and (eq (snsr-all-unique? request-active) 1)
                             (eq (snsr-entries-valid? request-active) 1)) 16384)
        0)))))))))))))))))

  (print (snsrb-check)))
