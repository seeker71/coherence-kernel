; session-neutral-topology-growth-band.fk — variable topology, exact draw use,
; replay, normalized locale surfaces, and reversible topology graph.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-topology-growth.fk

(do
  (defn sndtb-bit (condition bit) (if condition bit 0))
  (defn sndtb-sum (values)
    (if (eq (len values) 0) 0
      (add (head values) (sndtb-sum (tail values)))))
  (defn sndtb-realizations-complete? (realizations)
    (if (eq (len realizations) 0) 0
      (if (str_eq (sndg-gr-state (head realizations))
            "complete-normalized-projection")
        (if (eq (len (tail realizations)) 0) 1
          (sndtb-realizations-complete? (tail realizations))) 0)))
  (defn sndtb-check ()
    (do
      (let opened (snmt-open))
      (let runtime (snmt-o-runtime opened))
      (let dictionary (snmt-o-dictionary opened))
      (let growth (sndt-grow 108))
      (let replay (sndt-grow 108))
      (let other (sndt-grow 109))
      (let plan (sndt-w-plan growth))
      (let rounds (sndg-w-rounds growth))
      (let sentences (sndg-w-sentences growth))
      (let paragraph (sndg-w-paragraph growth))
      (let realizations (sndt-realize-paragraphs runtime dictionary paragraph
        (list "en" "de" "zh" "fr" "ban" "sa")))
      (let graph (sndt-graph growth realizations))
      (let active (sndg-g-address paragraph))
      (let alternative (sndt-p-alternative-node plan))
      (let event-control (sndt-control-result growth))
      (let nothing-control
        (sndt-control-resolve 1 2 (sndt-p-clause-count plan)
          active alternative))
      (let timeout-control
        (sndt-control-resolve 2 1 (sndt-p-clause-count plan)
          active alternative))
      (let completed-control
        (sndt-control-resolve 2 (sndt-p-clause-count plan)
          (sndt-p-clause-count plan) active alternative))
      (sndtb-sum (list
        (sndtb-bit (and (eq (sndt-plan-valid? plan) 1)
                         (eq (sndt-control-valid? event-control) 1)) 1)
        (sndtb-bit (and (ge (sndt-p-clause-count plan) 4)
                         (le (sndt-p-clause-count plan) 8)) 2)
        (sndtb-bit (eq (len rounds) (sndt-p-clause-count plan)) 4)
        (sndtb-bit (eq (sndg-clauses-valid?
                         (sndt-round-clauses rounds)) 1) 8)
        (sndtb-bit (and (eq (sndt-sizes-sum (sndt-p-sizes plan))
                              (sndt-p-clause-count plan))
                         (eq (sndt-sizes-valid? (sndt-p-sizes plan)) 1)) 16)
        (sndtb-bit (and (eq (len sentences) (len (sndt-p-sizes plan)))
                         (eq (sndg-sentences-valid? sentences) 1)) 32)
        (sndtb-bit (eq (sndg-paragraph-valid? paragraph) 1) 64)
        (sndtb-bit (and (value_eq (sndg-g-perspective paragraph)
                            (sndt-p-perspective plan))
                         (str_eq
                           (substring (sndg-gr-surface (head realizations)) 0
                             (str_len (sndt-perspective-prefix
                               (sndt-p-perspective plan) "en")))
                           (sndt-perspective-prefix
                             (sndt-p-perspective plan) "en"))) 128)
        (sndtb-bit (value_eq (sndt-p-address (sndt-w-plan replay))
                       (sndt-p-address plan)) 256)
        (sndtb-bit (and
          (not (eq (sndt-p-clause-count (sndt-w-plan other))
                    (sndt-p-clause-count plan)))
          (and (not (value_eq (sndt-p-sizes (sndt-w-plan other))
                      (sndt-p-sizes plan)))
               (not (value_eq (sndt-p-perspective (sndt-w-plan other))
                      (sndt-p-perspective plan))))) 512)
        (sndtb-bit (and (eq (len realizations) 6)
                         (eq (sndtb-realizations-complete? realizations) 1)) 1024)
        (sndtb-bit (and (gt (len graph) 50)
          (and (eq (sndg-surface-receipts graph realizations) 6)
               (gt (len (snsp-edges-to graph alternative)) 0))) 2048)
        (sndtb-bit (eq (len (sndg-w-draws growth))
                       (add (mul 6 (sndt-p-clause-count plan)) 3)) 4096)
        (sndtb-bit (and
          (and (eq (len (sndt-p-sentence-relation-draws plan))
                 (sub (sndt-p-clause-count plan) (len sentences)))
               (eq (len (sndt-p-paragraph-relation-draws plan))
                 (sub (len sentences) 1)))
          (and (eq (sndt-control-valid? nothing-control) 1)
               (eq (sndt-control-valid? timeout-control) 1))) 8192)
        (sndtb-bit (and (gt (len sentences) 1)
          (and (gt (len (sndt-topology-edges growth)) 8)
               (and (eq (sndt-control-valid? completed-control) 1)
                    (str_eq (sndt-x-state completed-control)
                      "continue")))) 16384)))))

  (print (sndtb-check)))
