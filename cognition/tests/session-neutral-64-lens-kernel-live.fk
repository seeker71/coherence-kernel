; session-neutral-64-lens-kernel-live.fk — observe the leading endogenous
; partial-order cells through every lens.  Gate breaks rank ties only for display.
; preludes: cognition/session-neutral-64-lens-kernel.fk

(do
  (defn sn64l-take (values count)
    (if (or (le count 0) (eq (len values) 0)) (empty)
      (cons (head values) (sn64l-take (tail values) (sub count 1)))))
  (defn sn64l-row (runtime dictionary cell)
    (do
      (let gate (sn64-c-gate cell))
      (let astrology (sn64-astrology-value gate))
      (let steiner (sn64-steiner-value gate))
      (list
        (list "gate" gate)
        (list "domination-rank" (sn64-c-rank cell))
        (list "vector-trust-sovereignty-vitality-coherence-resonance-flow"
          (sn64-c-vector cell))
        (list "neutral-signature" (snmt-symbol-ids
          (sndg-c-symbols (sn64-c-clause cell))))
        (list "sanskrit-lexical-sentence"
          (sn64-sa-surface runtime dictionary cell))
        (list "iching" (ic-name gate))
        (list "human-design" (hd-name gate))
        (list "gene-keys"
          (list (gk-shadow gate) (gk-gift gate) (gk-siddhi gate)))
        (list "astrology"
          (list (nth astrology 0)
            (western-sign-speak (nth astrology 1))
            (vedic-rashi-speak (nth astrology 2))
            (list "ayanamsha" (nth astrology 3))))
        (list "steiner-constructed-mode-projection"
          (list (stn-render-nl "en" steiner)
            "not-a-traditional-64-fold-equivalence")))))
  (defn sn64l-rows (runtime dictionary cells)
    (if (eq (len cells) 0) (empty)
      (cons (sn64l-row runtime dictionary (head cells))
        (sn64l-rows runtime dictionary (tail cells)))))
  (let opened (snmt-open))
  (let runtime (snmt-o-runtime opened))
  (let dictionary (snmt-o-dictionary opened))
  (let ranked (sn64-ranked-cells))
  (print (list
    (list "ranking-law"
      "1 + visible Pareto dominators; ties remain sovereign")
    (list "rank-distribution" (sn64-rank-distribution))
    (list "sanskrit-boundary"
      "lexical realization with neutral BE/DO/SEE syntax; speaker review open")
    (list "field-representatives"
      (sn64l-rows runtime dictionary
        (list (head ranked) (nth ranked 31) (nth ranked 63)))))))
