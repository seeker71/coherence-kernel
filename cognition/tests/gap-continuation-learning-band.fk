; preludes: cognition/gap-continuation-learning.fk
;
; The memory contains no domain. Transfer is the same decision under varied
; observation and health vectors.
(do
    (defn gcl-bit (ok bit) (if ok bit 0))
    (add
        (gcl-bit (eq (gcl-living-next) (gcl-build-observe)) 1)
        (add
            (gcl-bit (eq (gcl-next 1 0 1 1 1) (gcl-build-observe)) 2)
            (add
                (gcl-bit (eq (gcl-next 9 0 1 1 1) (gcl-build-observe)) 4)
                (add
                    (gcl-bit (eq (gcl-next 1 1 0 0 0) (gcl-complete)) 8)
                    (add
                        (gcl-bit (eq (gcl-next 1 0 1 1 0) (gcl-reorient)) 16)
                        (gcl-bit (eq (gcl-next 1 0 0 1 1) (gcl-reorient)) 32)))))))
