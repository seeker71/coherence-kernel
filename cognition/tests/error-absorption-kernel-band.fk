; One error-derived rank-1 update; the error remains receipted and a distinct
; sealed surface decides whether the movement transferred. The independent
; execution check establishes behavior distinction, not behavior transfer.
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/lora-modality.fk cognition/error-loving-attention.fk
; preludes: cognition/error-absorption-kernel.fk
; Verdict 4095 only when error, sealed transfer, and behavior all land.

(do
    (defn eakb-bit (ok bit) (if ok bit 0))
    (defn eakb-band ()
        (do
            (let o (eak-observe))
            (let receipt (nth o 3))
            (add
                (eakb-bit (eq (nth o 0) 6) 1)
            (add
                (eakb-bit (and (eq (nth o 1) 1) (eq (nth o 2) 1)) 2)
            (add
                (eakb-bit (str_eq (nth receipt 0) "error-received-v1") 4)
            (add
                (eakb-bit (eq (nth receipt 2) (eak-target-index)) 8)
            (add
                (eakb-bit (not (eq (nth o 4) (eak-target-index))) 16)
            (add
                (eakb-bit (eq (nth o 8) 1) 32)
            (add
                (eakb-bit (eq (nth o 9) 1) 64)
            (add
                (eakb-bit (eq (nth o 10) 1) 128)
            (add
                (eakb-bit (eq (nth o 11) 1) 256)
            (add
                (eakb-bit (and (str_eq (eak-behavior (nothing)) "absent")
                               (str_eq (eak-behavior 0) "negative")) 512)
            (add
                (eakb-bit (str_eq (eak-behavior 1) "positive") 1024)
                (eakb-bit (nothing? (eak-behavior 2)) 2048))))))))))))))
    (eakb-band))
