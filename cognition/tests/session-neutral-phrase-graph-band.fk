; session-neutral-phrase-graph-band.fk — dynamic phrase identity, recurrence,
; multilingual meaning binding, field projection, and bidirectional edges.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-phrase-graph.fk

(do
  (defn snspb-bit (condition bit) (if condition bit 0))
  (defn snspb-flow-edge? (edges from to)
    (if (eq (len edges) 0) 0
      (if (and (value_eq from (snsp-e-from (head edges)))
               (and (value_eq (snsf-structure-address 9)
                              (snsp-e-relation (head edges)))
                    (value_eq to (snsp-e-to (head edges))))) 1
        (snspb-flow-edge? (tail edges) from to))))
  (defn snspb-check ()
    (do
      (let runtime (snsf-open))
      (let en (snsf-resolve-text runtime "en" "trust flow"))
      (let de (snsf-resolve-tokens runtime "de" (list "vertrauen" "fluss")))
      (let zh (snsf-resolve-tokens runtime "zh" (list "信任" "流动")))
      (let dictionary-en (snsr-rebase (empty) en))
      (let dictionary-de (snsr-rebase dictionary-en de))
      (let dictionary (snsr-rebase dictionary-de zh))
      (let en-cells (snsp-span-cells en 2 2))
      (let de-cells (snsp-span-cells de 2 2))
      (let zh-cells (snsp-span-cells zh 2 2))
      (let en-expression (snsp-c-address (head en-cells)))
      (let de-expression (snsp-c-address (head de-cells)))
      (let zh-expression (snsp-c-address (head zh-cells)))
      (let phrases-once (snsp-observe (empty) en 2 2))
      (let phrases-twice (snsp-observe phrases-once en 2 2))
      (let phrases-de (snsp-observe phrases-twice de 2 2))
      (let phrases (snsp-observe phrases-de zh 2 2))
      (let en-cell (head (snsp-by-expression phrases en-expression)))
      (let trust (snsf-concept-address 490))
      (let flow (snsf-concept-address 3382))
      (let recipe (list trust flow))
      (let meaning (snsp-meaning dictionary recipe))
      (let evidence (list (snsf-structure-address 14)))
      (let en-binding (snsp-binding phrases en-expression meaning evidence
        "observed-binding"))
      (let de-binding (snsp-binding phrases de-expression meaning evidence
        "observed-binding"))
      (let zh-binding (snsp-binding phrases zh-expression meaning evidence
        "observed-binding"))
      (let bindings-1 (snsp-add-binding (empty) en-binding))
      (let bindings-2 (snsp-add-binding bindings-1 de-binding))
      (let bindings (snsp-add-binding bindings-2 zh-binding))
      (let bindings-again (snsp-add-binding bindings en-binding))
      (let graph (snsp-graph phrases bindings))
      (let residue-rows (snsf-resolve-tokens runtime "en" (list "⟐" "trust")))
      (let residue-cell (head (snsp-span-cells residue-rows 2 2)))
      (let within-rows (snsf-resolve-text runtime "en" "trust flow trust flow"))
      (let within (snsp-observe (empty) within-rows 2 2))
      (let trust-only (snsp-meaning dictionary (list trust)))
      (let alternate (snsp-binding phrases en-expression trust-only evidence
        "second-observed-binding"))
      (let multiple (snsp-add-binding bindings alternate))
      (add (snspb-bit (and (eq (len en-cells) 1)
                            (eq (len (snsp-c-recipe (head en-cells))) 5)) 1)
      (add (snspb-bit (and (eq (nth en-expression 1) 10)
                            (and (not (value_eq en-expression de-expression))
                                 (not (value_eq de-expression zh-expression)))) 2)
      (add (snspb-bit (and (eq (snsp-c-count en-cell) 2)
                            (str_eq (snsp-expression-state en-cell (empty))
                              "repeated-expression-meaning-open")) 4)
      (add (snspb-bit (and (eq (len meaning) 5)
                            (and (eq (nth (snsp-m-address meaning) 1) 8)
                                 (value_eq (snsp-m-address meaning)
                                   (snsf-address 8 recipe)))) 8)
      (add (snspb-bit (eq (snsp-definition-closed? dictionary
                              (list (snsf-residue-address "not-observed"))) 0) 16)
      (add (snspb-bit (and (eq (len bindings) 3)
                            (eq (len bindings-again) 3)) 32)
      (add (snspb-bit (and (eq (len (snsp-bindings-by-meaning bindings
                                      (snsp-m-address meaning))) 3)
                            (str_eq (snsp-expression-state en-cell bindings)
                              "single-neutral-meaning")) 64)
      (add (snspb-bit (eq (len (snsp-edges-to graph
                              (snsp-m-address meaning))) 3) 128)
      (add (snspb-bit (eq (len (snsp-edges-from graph
                              (snsp-m-address meaning))) 2) 256)
      (add (snspb-bit (eq (len (snsp-edges-from graph en-expression)) 3) 512)
      (add (snspb-bit (eq (snspb-flow-edge? graph trust flow) 1) 1024)
      (add (snspb-bit (and (str_eq (snsp-c-field-state en-cell)
                              "candidate-set-projection-v1")
                            (eq (len (snsp-c-field en-cell)) 13)) 2048)
      (add (snspb-bit (value_eq
                        (head (head (snsp-c-candidate-sets residue-cell)))
                        (snsf-residue-address "⟐")) 4096)
      (add (snspb-bit (and (eq (len within) 2)
                            (and (eq (len (snsp-repeated within)) 1)
                                 (eq (snsp-max-count within 0) 2))) 8192)
      (add (snspb-bit (and (eq (len (snsp-bindings-by-expression multiple
                                      en-expression)) 2)
                            (str_eq (snsp-expression-state en-cell multiple)
                              "multiple-neutral-meanings")) 16384)
        0)))))))))))))))))

  (print (snspb-check)))
