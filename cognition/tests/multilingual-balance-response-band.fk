; preludes: form-stdlib/core.fk cognition/multilingual-balance-response.fk
;
; The answer is emitted by Form, carries the healthy multilingual/world-model
; policy, distinguishes composition from generation, and remains above 50%
; native-composed words with an explicit 100-word remote framing allowance.
; Verdict 255.
(do
    (let text (multilingual-balance-response))
    (let receipt (multilingual-balance-receipt 100))
    (defn mbrb-bit (ok bit) (if ok bit 0))
    (add
        (mbrb-bit (gt (mbr-word-count text) 200) 1)
        (add
        (mbrb-bit (eq (nth receipt 4) 1) 2)
        (add
        (mbrb-bit (gt (nth receipt 3) 50) 4)
        (add
        (mbrb-bit (ge (str_find text "Chinese and Arabic" 0) 0) 8)
        (add
        (mbrb-bit (ge (str_find text "Sanskrit" 0) 0) 16)
        (add
        (mbrb-bit (ge (str_find text "provenance and temporal scope" 0) 0) 32)
        (add
        (mbrb-bit (ge (str_find text "world model" 0) 0) 64)
        (mbrb-bit (ge (str_find text "returns nothing" 0) 0) 128)))))))))
