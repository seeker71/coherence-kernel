; session-neutral-micro-thought-band.fk — replayable event variation, visible
; surprise selection, locale realization, and reversible graph evidence.
; expected: 32767
; witnessed: 2026-08-24 -> 32767 on fkwu
; preludes: cognition/session-neutral-micro-thought.fk

(do
  (defn snmtb-bit (condition bit) (if condition bit 0))
  (defn snmtb-scores-at-most? (scores ceiling)
    (if (eq (len scores) 0) 1
      (if (le (head scores) ceiling)
        (snmtb-scores-at-most? (tail scores) ceiling) 0)))
  (defn snmtb-realizations-complete? (realizations)
    (if (eq (len realizations) 0) 1
      (if (and (str_eq (snmr-r-state (head realizations)) "complete")
               (gt (len (snmr-r-surfaces (head realizations))) 0))
        (snmtb-realizations-complete? (tail realizations)) 0)))
  (defn snmtb-check ()
    (do
      (let opened (snmt-open))
      (let runtime (snmt-o-runtime opened))
      (let dictionary (snmt-o-dictionary opened))
      (let draws (snmt-draw-stream 108 6))
      (let replay (snmt-draw-stream 108 6))
      (let event-a (snmt-event (head draws)))
      (let event-b (snmt-event (nth draws 1)))
      (let first-round (snmt-round (empty)
        (list (nth draws 0) (nth draws 1) (nth draws 2))))
      (let second-round (snmt-round (snmt-r-recipe first-round)
        (list (nth draws 3) (nth draws 4) (nth draws 5))))
      (let replay-round (snmt-round (empty)
        (list (nth replay 0) (nth replay 1) (nth replay 2))))
      (let codes (list "en" "de" "zh" "fr" "id" "ban" "sa"))
      (let realizations (snmt-realize-locales runtime dictionary
        (snmt-r-recipe second-round) codes))
      (let graph (snmt-graph second-round realizations))
      (let chosen-address (snmt-e-address (snmt-r-event second-round)))
      (add (snmtb-bit (and (eq (len draws) 6)
                            (value_eq draws replay)) 1)
      (add (snmtb-bit (and (eq (len (snmt-field-addresses)) 13)
                            (eq (snmt-dictionary-complete? dictionary) 1)) 2)
      (add (snmtb-bit (and (eq (snmt-event-valid? event-a) 1)
                            (eq (snmt-event-valid? event-b) 1)) 4)
      (add (snmtb-bit (and (ge (len (snmt-e-recipe event-a)) 2)
                            (le (len (snmt-e-recipe event-a)) 4)) 8)
      (add (snmtb-bit (and (value_eq (snmt-event (head draws)) event-a)
                            (not (value_eq (snmt-e-address event-a)
                              (snmt-e-address event-b)))) 16)
      (add (snmtb-bit (and (eq (len (snmt-r-candidates first-round)) 3)
                            (eq (len (snmt-r-candidates second-round)) 3)) 32)
      (add (snmtb-bit (and (str_eq (snmt-r-state first-round)
                              "selected-most-surprising-recorded-event")
                            (gt (snmt-r-score first-round) 0)) 64)
      (add (snmtb-bit (eq (snmtb-scores-at-most?
                              (snmt-r-scores first-round)
                              (snmt-r-score first-round)) 1) 128)
      (add (snmtb-bit (value_eq (snmt-r-address first-round)
                              (snmt-r-address replay-round)) 256)
      (add (snmtb-bit (and (eq (len realizations) 7)
                            (eq (snmtb-realizations-complete?
                              realizations) 1)) 512)
      (add (snmtb-bit (and (value_eq
                              (snmr-r-meaning (head realizations))
                              (snmr-r-meaning (nth realizations 2)))
                            (value_eq
                              (snmr-r-meaning (nth realizations 1))
                              (snmr-r-meaning (nth realizations 6)))) 1024)
      (add (snmtb-bit (and (eq (len (snmt-symbol-ids
                              (snmt-r-recipe second-round)))
                              (len (snmt-r-recipe second-round)))
                            (eq (len (snmt-observer-labels
                              (snmt-r-recipe second-round)))
                              (len (snmt-r-recipe second-round)))) 2048)
      (add (snmtb-bit (and (gt (len graph) 0)
                            (ge (len (snsp-edges-to graph chosen-address)) 2)) 4096)
      (add (snmtb-bit (and (eq (len (snmt-c-surprise
                              (snmt-r-chosen second-round))) 7)
                            (and (ge (snmt-s-turbulence-delta
                                  (snmt-c-surprise
                                    (snmt-r-chosen second-round))) 0)
                                 (ge (snmt-r-surprise-lift
                                   second-round) 0))) 8192)
      (add (snmtb-bit (and (eq (len (snmt-r-draws second-round)) 3)
                            (eq (len (snmt-r-scores second-round)) 3)) 16384)
        0)))))))))))))))))

  (print (snmtb-check)))
