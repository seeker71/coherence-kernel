; preludes: form-stdlib/core.fk cognition/multilingual-balance-response.fk cognition/review-only-generation.fk
;
; Remote review cannot author or rewrite response tokens. A Form-composed bounded
; response is therefore 100% native and 0% remote generation; a remote-authored
; segment is refused. Native promotion over the local incumbent remains gated by
; held-out score and the floor. Verdict 2047.
(do
    (let native-text (multilingual-balance-response))
    (let native-only (list (rog-segment (rog-native-source) native-text)))
    (let remote-injected (list (rog-segment (rog-native-source) "native")
                               (rog-segment (rog-remote-source) " remote prose")))
    (let receipt (rog-receipt native-only))
    (let reviewed (rog-apply-review (rog-compose native-only) (rog-review 2 0)))
    (defn rogb-bit (ok bit) (if ok bit 0))
    (add (rogb-bit (gt (nth receipt 0) 300) 1)
    (add (rogb-bit (eq (nth receipt 1) 0) 2)
    (add (rogb-bit (eq (nth receipt 2) 0) 4)
    (add (rogb-bit (eq (nth receipt 3) 100) 8)
    (add (rogb-bit (eq (nth receipt 5) 0) 16)
    (add (rogb-bit (eq (nth receipt 6) 1) 32)
    (add (rogb-bit (str_eq reviewed native-text) 64)
    (add (rogb-bit (str_eq (rog-compose remote-injected) "refused:remote-generation-token") 128)
    (add (rogb-bit (eq (rog-author-source 70 90 1) (rog-local-source)) 256)
    (add (rogb-bit (eq (rog-author-source 90 90 1) (rog-native-source)) 512)
         (rogb-bit (eq (rog-review-opens-work? (rog-review 3 42)) 1) 1024))))))))))))
