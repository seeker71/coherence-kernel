; session-neutral-64-lens-kernel-band.fk — generated 64 sentences, visible
; endogenous ranks, attributed lenses, Sanskrit projection, reversible graph.
; expected: 65535
; preludes: cognition/session-neutral-64-lens-kernel.fk

(do
  (defn sn64b-bit (condition bit) (if condition bit 0))
  (defn sn64b-sum (values)
    (if (eq (len values) 0) 0
      (add (head values) (sn64b-sum (tail values)))))
  (defn sn64b-projections-valid? (gate)
    (if (gt gate (sn64-count)) 1
      (do
        (let projections (sn64-projections gate))
        (if (and (eq (len projections) 6)
                 (and (str_eq (sn64-p-state (nth projections 3))
                        "symbolic-projection-not-causal-verdict")
                   (and (str_eq (sn64-p-state (nth projections 4))
                          "projection-not-traditional-equivalence")
                     (str_eq (sn64-p-state (nth projections 5))
                       "sanskrit-lexical-speaker-unreviewed-syntax"))))
          (sn64b-projections-valid? (add gate 1)) 0))))
  (defn sn64b-wheel-roundtrip? (gate)
    (if (gt gate (sn64-count)) 1
      (if (eq (gate-at-longitude (sn64-gate-center gate)) gate)
        (sn64b-wheel-roundtrip? (add gate 1)) 0)))
  (defn sn64b-sa-complete? (rows)
    (if (eq (len rows) 0) 1
      (if (and (gt (str_len (nth (head rows) 2)) 0)
               (str_eq (nth (head rows) 3)
                 "complete-normalized-projection"))
        (sn64b-sa-complete? (tail rows)) 0)))
  (defn sn64b-sa-unique-loop? (rows seen)
    (if (eq (len rows) 0) 1
      (if (eq (sn64-address-in? (nth (head rows) 2) seen) 1) 0
        (sn64b-sa-unique-loop? (tail rows)
          (cons (nth (head rows) 2) seen)))))
  (defn sn64b-sa-unique? (rows)
    (sn64b-sa-unique-loop? rows (empty)))
  (defn sn64b-rank-law? (gate)
    (if (gt gate (sn64-count)) 1
      (if (eq (sn64-rank gate)
            (add 1 (sn64-dominator-count-loop gate 1)))
        (sn64b-rank-law? (add gate 1)) 0)))
  (defn sn64b-steiner-facts? (gate)
    (if (gt gate (sn64-count)) 1
      (do
        (let fact (sn64-steiner-value gate))
        (if (and (eq (len fact) 5)
                 (value_eq (stn-f-evidence fact) (stn-w-seelenraetseln)))
          (sn64b-steiner-facts? (add gate 1)) 0))))
  (defn sn64b-astrology-shape? (gate)
    (if (gt gate (sn64-count)) 1
      (do
        (let value (sn64-astrology-value gate))
        (if (and (eq (len value) 4)
                 (and (ge (nth value 1) 0)
                   (and (lt (nth value 1) 12)
                     (and (ge (nth value 2) 0)
                       (lt (nth value 2) 12)))))
          (sn64b-astrology-shape? (add gate 1)) 0))))
  (defn sn64b-check ()
    (do
      (let opened (snmt-open))
      (let runtime (snmt-o-runtime opened))
      (let dictionary (snmt-o-dictionary opened))
      (let cells (sn64-cells))
      (let ranked (sn64-ranked-cells))
      (let rows (sn64-sa-rows runtime dictionary cells))
      (let graph (sn64-graph runtime dictionary))
      (let gate1 (sn64-cell-address 1))
      (let sa1 (sn64-lens-address 5 1))
      (sn64b-sum (list
        (sn64b-bit (eq (len cells) 64) 1)
        (sn64b-bit (eq (sn64-all-cells-valid?) 1) 2)
        (sn64b-bit (eq (sn64-all-fields-seen?) 1) 4)
        (sn64b-bit (and (eq (sn64-agency-digit 1) 0)
                       (and (eq (sn64-relation-digit 64) 3)
                         (eq (sn64-opening-digit 64) 3))) 8)
        (sn64b-bit (eq (sn64-ranks-not-flat?) 1) 16)
        (sn64b-bit (eq (sn64b-rank-law? 1) 1) 32)
        (sn64b-bit (eq (len ranked) 64) 64)
        (sn64b-bit (le (sn64-c-rank (head ranked))
                       (sn64-c-rank (nth ranked 63))) 128)
        (sn64b-bit (eq (sn64b-projections-valid? 1) 1) 256)
        (sn64b-bit (and (eq (ic64-all-found?) 1)
                       (eq (ic64-one-cell? 25) 1)) 512)
        (sn64b-bit (eq (sn64b-wheel-roundtrip? 1) 1) 1024)
        (sn64b-bit (eq (sn64b-astrology-shape? 1) 1) 2048)
        (sn64b-bit (eq (sn64b-steiner-facts? 1) 1) 4096)
        (sn64b-bit (and (eq (len rows) 64)
                       (eq (sn64b-sa-complete? rows) 1)) 8192)
        (sn64b-bit (eq (sn64b-sa-unique? rows) 1) 16384)
        (sn64b-bit (and (eq (len graph) 576)
          (and (gt (len (snsp-edges-from graph gate1)) 0)
               (gt (len (snsp-edges-to graph sa1)) 0))) 32768)))))

  (print (sn64b-check)))
