; kernel-primitives-fourway.fk — a second, third and fourth pair of eyes on the
; least-primitives doctrine and the comparison floor.
;
; Two crossings, each expected 11111111 on all four kernels:
;   reduction   observe/comparison-primitive-reduction.fk — the comparison floor is
;               {eq, lt}; le is one over; the one-primitive floor rides a leak the
;               walkers decline, so it is not four-way
;   minimality  cognition/primitive-minimality.fk — a rewrite lowers to native nodes at
;               parse, so derivation is free exactly when the template is O(1); mul-from-
;               add is O(b), so mul stays primitive. The boundary where least-primitives
;               and optimal-codegen stop competing.
;
; Verdict digits, low to high: reduction, minimality. 0 = both FOUR-WAY.
;
; preludes: form/form-stdlib/four-way-run.fk form/form-stdlib/form-fs.fk
; witnessed: 2026-07-28 -> 0 (both FOUR-WAY)
import "../../observe/comparison-primitive-reduction.fk"
import "../primitive-minimality.fk"
(do
    (defn kpf-cross (src path call fkwu-v)
        (do (write_file path
                (str_concat (read_file src)
                            (str_concat "\n(" (str_concat call ")\n"))))
            (fr-diagnose
                (str_concat "./walkers/go/walker " path)
                (str_concat "./walkers/rust/target/release/form-walker-rust " path)
                (str_concat "node --experimental-strip-types walkers/ts/main.ts " path)
                fkwu-v)))
    (add
        (kpf-cross "observe/comparison-primitive-reduction.fk" "/tmp/kpf-reduction.fk"
                   "comparison-reduction-check" (comparison-reduction-check))
        (mul 10 (kpf-cross "cognition/primitive-minimality.fk" "/tmp/kpf-minimality.fk"
                   "primitive-minimality-check" (primitive-minimality-check)))))
