; tests/jung-neutral-band.fk — Jung's fundamentals as a surface-independent
; meaning graph. PURE STRUCTURE: no NL or PL spelling reaches any
; reading below except where the projection itself is the claim.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/jung-neutral-kernel.fk
;
; Verdict 1023 on Go / Rust / TypeScript (validate.sh) and on fkwu run directly.
; NOT registered in fourth-arm-bands.txt: fourth_band_stem only resolves bands
; under form-stdlib/tests/, so a cognition/ band cannot receive the gated fourth
; leg. Registering it would declare a lane the machinery cannot run. The fkwu
; reading below is a direct run, witnessed, not a gated one — same standing as
; cognition/tests/steiner-neutral-band.fk.
; Claims:
;   26 facts carried                                                  1
;   every fact is a well-formed 5-tuple, all parts at level 46         2
;   the Self CONTAINS the ego, and the ego does not contain the Self   4
;   the ego IS-A complex — one complex among complexes                 8
;   persona and anima mirror each other, and anima compensates persona 16
;   the two groups: rational holds thinking and feeling, irrational
;     holds sensation and intuition                                   32
;   the two oppositions, each within its own group                    64
;   named archetypes are REFUSED — empty list, reason recorded       128
;   projections answer en and de, an unregistered locale answers
;     nothing, and a surface round-trips to its own node             256
;   Aion's own late ordering: Ich, Schatten, Anima, Selbst           512

(do
  (defn jnb-bit (ok w) (if ok w 0))
  (defn jnb-has-fact-loop (fs s r o)
    (if (eq (len fs) 0) 0
      (do (let f (head fs))
          (if (and (eq (jnk-f-subject f) s)
                   (and (eq (jnk-f-relation f) r) (eq (jnk-f-object f) o))) 1
            (jnb-has-fact-loop (tail fs) s r o)))))
  (defn jnb-has (s r o) (jnb-has-fact-loop (jnk-facts) s r o))

  (defn jung-neutral-band ()
    (do
      (let c0 (jnb-bit (eq (jnk-fact-count) 26) 1))
      (let c1 (jnb-bit (eq (jnk-wellformed?) 1) 2))
      (let c2 (jnb-bit
        (and (eq (jnb-has (jnk-selbst) (jnk-contains) (jnk-ich)) 1)
             (eq (jnb-has (jnk-ich) (jnk-contains) (jnk-selbst)) 0)) 4))
      (let c3 (jnb-bit
        (eq (jnb-has (jnk-ich) (jnk-is-a) (jnk-komplex)) 1) 8))
      (let c4 (jnb-bit
        (and (eq (jnb-has (jnk-persona) (jnk-mirrors) (jnk-anima)) 1)
             (eq (jnb-has (jnk-anima) (jnk-compensates) (jnk-persona)) 1)) 16))
      (let c5 (jnb-bit
        (and (eq (jnb-has (jnk-denken) (jnk-in-group) (jnk-g-rational)) 1)
        (and (eq (jnb-has (jnk-fuehlen) (jnk-in-group) (jnk-g-rational)) 1)
        (and (eq (jnb-has (jnk-empfinden) (jnk-in-group) (jnk-g-irrational)) 1)
             (eq (jnb-has (jnk-intuition) (jnk-in-group) (jnk-g-irrational)) 1))))
        32))
      (let c6 (jnb-bit
        (and (eq (jnb-has (jnk-denken) (jnk-opposes) (jnk-fuehlen)) 1)
        (and (eq (jnb-has (jnk-empfinden) (jnk-opposes) (jnk-intuition)) 1)
             ; and never across the groups
             (eq (jnb-has (jnk-denken) (jnk-opposes) (jnk-empfinden)) 0))) 64))
      (let c7 (jnb-bit
        (and (eq (len (jnk-named-archetypes)) 0)
        (and (eq (jnk-refuses-enumeration?) 1)
             (gt (str_len (jnk-refusal-ground)) 0))) 128))
      (let c8 (jnb-bit
        (and (str_eq (jnk-project (jnk-selbst) "en") "self")
        (and (str_eq (jnk-project (jnk-selbst) "de") "Selbst")
        (and (nothing? (jnk-project (jnk-selbst) "id"))
        (and (eq (jnk-by-surface "shadow" "en") (jnk-schatten))
             (eq (jnk-by-surface "Schatten" "de") (jnk-schatten)))))) 256))
      (let c9 (jnb-bit
        (and (eq (jnk-aion-order-count) 4)
        (and (eq (nth (jnk-aion-order) 0) (jnk-ich))
        (and (eq (nth (jnk-aion-order) 1) (jnk-schatten))
        (and (eq (nth (jnk-aion-order) 2) (jnk-anima))
             (eq (nth (jnk-aion-order) 3) (jnk-selbst)))))) 512))

      (add c0 (add c1 (add c2 (add c3 (add c4
        (add c5 (add c6 (add c7 (add c8 c9)))))))))))

  (jung-neutral-band))
