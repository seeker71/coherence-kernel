; preludes: form-stdlib/core.fk form-stdlib/thought-framebuffer.fk cognition/multilingual-balance-experiment.fk
;
; Controlled 100-step falsification band for healthy multilingual semantic growth
; versus bulk translation. Every returned number is checked. Verdict 4095.
(do
    (let r (multilingual-balance-experiment))
    (defn mbeb-bit (ok bit) (if ok bit 0))
    (add (mbeb-bit (eq (nth r 0) 43) 1)
    (add (mbeb-bit (eq (nth r 1) 0) 2)
    (add (mbeb-bit (eq (nth r 2) 99) 4)
    (add (mbeb-bit (eq (nth r 3) 0) 8)
    (add (mbeb-bit (eq (nth r 4) 100) 16)
    (add (mbeb-bit (eq (nth r 5) 27) 32)
    (add (mbeb-bit (eq (nth r 6) 100) 64)
    (add (mbeb-bit (eq (nth r 7) 11) 128)
    (add (mbeb-bit (eq (nth r 8) 0) 256)
    (add (mbeb-bit (eq (nth r 9) 99) 512)
    (add (mbeb-bit (eq (nth r 10) 0) 1024)
         (mbeb-bit (and (eq (nth r 11) 1) (eq (nth r 12) 1)) 2048)))))))))))))
