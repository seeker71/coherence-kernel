; core-frequency-lift-form-neutral-crossing.fk
;
; An observed vertical crossing from numeric recipe identity into NL and PL
; surfaces. Strings remain projection evidence; no string participates in the
; identity of either meaning. Projection residue is retained rather than
; calling a machine, lexical, or syntax crossing exact semantic equivalence.
;
; witnessed: 2026-08-14 -> native projection/mapping crossing 67108863;
;                               semantic alignments remain candidate
import "../form/form-stdlib/core.fk"
import "concept-nl-semantic-13-runtime.fk"
import "nl-lenses-13.fk"
import "pl-lenses-13.fk"
import "core-frequency-lift-dictionary.fk"

(do
  ; projection = [plane, locale, surface, anchor, relation, evidence-state,
  ;               source, source-code, residue, lineage-anchor]
  ; plane: 1 NL, 2 PL. relation: 1 lexical status, 2 PL dependency
  ; declaration, 3 NL need enquiry. Residue bits are projection-local:
  ;   1 mapped/unreviewed, 2 machine source, 4 lexical-kind shift,
  ;   8 PL binding/include mechanics, 16 enquiry/address/formality,
  ;   32 inherited pivot or authored alignment.
  (defn fnc-projection
    (plane locale surface anchor relation evidence-state source source-code residue lineage)
    (list plane locale surface anchor relation evidence-state source source-code residue lineage))
  (defn fnc-p-plane (p) (nth p 0))
  (defn fnc-p-locale (p) (nth p 1))
  (defn fnc-p-surface (p) (nth p 2))
  (defn fnc-p-symbol (p) (nth p 3))
  (defn fnc-p-anchor (p) (nth p 3))
  (defn fnc-p-relation (p) (nth p 4))
  (defn fnc-p-state (p) (nth p 5))
  (defn fnc-p-source (p) (nth p 6))
  (defn fnc-p-source-code (p) (nth p 7))
  (defn fnc-p-residue (p) (nth p 8))
  (defn fnc-p-lineage (p) (nth p 9))

  ; External anchor identity is numeric and surface-free, but its lineage is
  ; not neutralized away. Anchor 1400 inherits the PWN/OMW inventory; anchors
  ; 2001 and 3001 are local PL/phrase-pack observation seats.
  (defn fnc-cat-anchor () (make_nodeid 31 2 0 21))
  (defn fnc-cat-alignment () (make_nodeid 31 2 0 22))
  (defn fnc-anchor (index) (cfd-indexed (fnc-cat-anchor) index))
  (defn fnc-nl-necessary-anchor () (fnc-anchor 1400))
  (defn fnc-pl-dependency-anchor () (fnc-anchor 2001))
  (defn fnc-need-enquiry-anchor () (fnc-anchor 3001))
  ; alignment = [external anchor, candidate recipe, residue]. It is an
  ; inspectable proposal, not identity equality or semantic admission.
  (defn fnc-alignment (anchor recipe residue)
    (intern_node (fnc-cat-alignment)
      (list anchor recipe (intern_trivial_int residue))))
  (defn fnc-a-anchor (a) (nth (node_children a) 0))
  (defn fnc-a-recipe (a) (nth (node_children a) 1))
  (defn fnc-a-residue (a) (node_value (nth (node_children a) 2)))
  (defn fnc-nl-dependency-alignment ()
    (fnc-alignment (fnc-nl-necessary-anchor) (fnc-dependency-symbol) 36))
  (defn fnc-pl-dependency-alignment ()
    (fnc-alignment (fnc-pl-dependency-anchor) (fnc-dependency-symbol) 40))
  (defn fnc-need-enquiry-alignment ()
    (fnc-alignment (fnc-need-enquiry-anchor) (fnc-need-enquiry-symbol) 48))

  ; Same identity as cfd-requirement-dependency, reconstructed only from
  ; numeric axiom, role, and gap cells. Local function names aid maintainers;
  ; the interned content contains no surface label.
  (defn fnc-dependency-symbol ()
    (cfd-meaning (list
      (cfd-e (cfd-role 10) (cfd-axiom 2))
      (cfd-e (cfd-role 12)
        (cfd-meaning (list
          (cfd-e (cfd-role 10) (cfd-axiom 2))
          (cfd-e (cfd-role 19) (cfd-axiom 3)))))
      (cfd-e (cfd-role 47) (cfd-gap 22))
      (cfd-e (cfd-role 48) (cfd-gap 23))
      (cfd-e (cfd-role 33) (cfd-axiom 4)))))

  ; A question about living support is related to, but not identical with, a
  ; dependency relation. The separate symbol prevents NL enquiry grammar from
  ; being collapsed into PL dependency syntax.
  (defn fnc-need-enquiry-symbol ()
    (cfd-meaning (list
      (cfd-e (cfd-role 12) (cfd-requirement-need))
      (cfd-e (cfd-role 14) (cfd-observation))
      (cfd-e (cfd-role 16) (cfd-axiom 5))
      (cfd-e (cfd-role 20) (cfd-axiom 1)))))

  ; Pinned index 1400 / synset 01580050-a supplies thirteen surfaces for the
  ; lexical status conventionally anchored in English as "necessary". The live
  ; runtime retains each locale's actual source code. No row is reviewed.
  (defn fnc-nl-required-index () 1400)
  (defn fnc-nl-residue (source-code)
    (if (str_eq source-code "F") 36
      (if (str_eq source-code "G") 39 37)))
  (defn fnc-nl-required-projection (runtime code)
    (do (let lookup (cnl13-runtime-lookup-sourced
      runtime (fnc-nl-required-index) code))
      (let source-code (nth lookup 6))
      (let label (nth lookup 3))
      (if (str_eq label "") (nothing)
        (fnc-projection 1 code label (fnc-nl-necessary-anchor) 1
          (nth lookup 4) (nth lookup 5) source-code
          (fnc-nl-residue source-code) (nth lookup 1)))))
  (defn fnc-nl-required-projections-go (runtime codes)
    (if (eq (len codes) 0) (list)
      (do (let projection (fnc-nl-required-projection runtime (head codes)))
        (if (nothing? projection)
          (fnc-nl-required-projections-go runtime (tail codes))
          (cons projection
            (fnc-nl-required-projections-go runtime (tail codes)))))))
  (defn fnc-nl-required-projections (runtime)
    (fnc-nl-required-projections-go runtime (cnl13-locale-codes)))

  ; PL surfaces deliberately include enough actual syntax for the existing
  ; native PL detector to recognize the language. Identifiers are arbitrary
  ; projection material; the shared symbol remains numeric.
  (defn fnc-pl-dependency-data ()
    (list
      (list "python" "from m import x\n")
      (list "javascript" "const x = require(\"m\");\n")
      (list "typescript" "import { x } from \"m\";\ninterface T { x: string }\nconst y: string = \"m\";\n")
      (list "java" "import m.X;\npublic static class T {}\n")
      (list "c" "#include <x.h>\nint main(void) { return 0; }\n")
      (list "cpp" "#include <iostream>\n#include <x.hpp>\nstd::size_t n = 1;\n")
      (list "csharp" "using System;\nusing M;\nnamespace T {}\n")
      (list "go" "package main\nimport \"m\"\nfunc main() { _ = m.X }\n")
      (list "rust" "use m::x;\nfn main() { let mut y = x; println!(\"{y:?}\"); }\n")
      (list "ruby" "require \"m\"\ndef x\nend\n")
      (list "php" "<?php\n$x = require \"m.php\";\necho $x;\n?>\n")
      (list "swift" "import Foundation\nimport M\nfunc x() { let y = 1 }\n")
      (list "kotlin" "import m.X\ndata class T(val x: X)\nfun main() { println(T(X()).x) }\n")))
  (defn fnc-pl-dependency-projection (row)
    (fnc-projection 2 (nth row 0) (nth row 1)
      (fnc-pl-dependency-anchor) 2 "repo-observed-bounded-fixture"
      "cognition/core-frequency-lift-form-neutral-crossing.fk"
      "native-pl-surface" 40 "pl-dependency-fixture"))
  (defn fnc-pl-dependency-projections-go (rows)
    (if (eq (len rows) 0) (list)
      (cons (fnc-pl-dependency-projection (head rows))
        (fnc-pl-dependency-projections-go (tail rows)))))
  (defn fnc-pl-dependency-projections ()
    (fnc-pl-dependency-projections-go (fnc-pl-dependency-data)))

  ; The phrase pack supplies a second NL candidate plane. Its own source notes
  ; say the longer phrases are bounded rented-voice seeds; row sources are
  ; lineage context, not phrase-specific attestation. The full enquiry maps to
  ; its own anchor and therefore does not force enquiry grammar into dependency.
  (defn fnc-nl-need-projection (row)
    (fnc-projection 1 (nl13-code row) (nl13-need row)
      (fnc-need-enquiry-anchor) 3 "bounded-rented-voice-seed-unreviewed"
      "cognition/nl-lenses-13-data.fk" "bounded-phrase" 48
      (nl13-source row)))
  (defn fnc-nl-need-projections-go (rows)
    (if (eq (len rows) 0) (list)
      (cons (fnc-nl-need-projection (head rows))
        (fnc-nl-need-projections-go (tail rows)))))
  (defn fnc-nl-need-projections ()
    (fnc-nl-need-projections-go (nl13-data)))

  (defn fnc-find-projection (projections locale)
    (if (eq (len projections) 0) (nothing)
      (if (str_eq (fnc-p-locale (head projections)) locale)
        (head projections)
        (fnc-find-projection (tail projections) locale))))
  (defn fnc-all-symbol? (projections symbol)
    (if (eq (len projections) 0) 1
      (if (node_eq (fnc-p-symbol (head projections)) symbol)
        (fnc-all-symbol? (tail projections) symbol) 0)))
  (defn fnc-count-source-code (projections wanted)
    (if (eq (len projections) 0) 0
      (add (if (str_eq (fnc-p-source-code (head projections)) wanted) 1 0)
        (fnc-count-source-code (tail projections) wanted))))
  (defn fnc-source-state-consistent? (projection)
    (do (let code (fnc-p-source-code projection))
      (if (str_eq code "F")
        (if (and (str_eq (fnc-p-state projection) "frequency-observed")
                 (eq (fnc-p-residue projection) 36)) 1 0)
        (if (str_eq code "G")
          (if (and (str_eq (fnc-p-state projection)
                           "machine-translated-unreviewed")
                   (eq (fnc-p-residue projection) 39)) 1 0)
          (if (and (str_eq (fnc-p-state projection) "mapped-unreviewed")
                   (eq (fnc-p-residue projection) 37)) 1 0)))))
  (defn fnc-all-source-state-consistent? (projections)
    (if (eq (len projections) 0) 1
      (if (eq (fnc-source-state-consistent? (head projections)) 1)
        (fnc-all-source-state-consistent? (tail projections)) 0)))
  (defn fnc-all-residue? (projections residue)
    (if (eq (len projections) 0) 1
      (if (eq (fnc-p-residue (head projections)) residue)
        (fnc-all-residue? (tail projections) residue) 0)))
  (defn fnc-all-pl-detected? (projections)
    (if (eq (len projections) 0) 1
      (if (str_eq (pl13-detect (fnc-p-surface (head projections)))
                  (fnc-p-locale (head projections)))
        (fnc-all-pl-detected? (tail projections)) 0)))
  (defn fnc-pl-dependency-construct? (locale surface)
    (if (str_eq locale "python")
      (if (or (ge (str_find surface "from " 0) 0)
              (ge (str_find surface "import " 0) 0)) 1 0)
    (if (or (str_eq locale "javascript") (str_eq locale "typescript"))
      (if (or (ge (str_find surface "require(" 0) 0)
              (ge (str_find surface "import " 0) 0)) 1 0)
    (if (str_eq locale "java")
      (if (ge (str_find surface "import " 0) 0) 1 0)
    (if (or (str_eq locale "c") (str_eq locale "cpp"))
      (if (ge (str_find surface "#include " 0) 0) 1 0)
    (if (str_eq locale "csharp")
      (if (ge (str_find surface "using " 0) 0) 1 0)
    (if (str_eq locale "go")
      (if (ge (str_find surface "import " 0) 0) 1 0)
    (if (str_eq locale "rust")
      (if (or (ge (str_find surface "use " 0) 0)
              (ge (str_find surface "extern crate " 0) 0)) 1 0)
    (if (str_eq locale "ruby")
      (if (ge (str_find surface "require " 0) 0) 1 0)
    (if (str_eq locale "php")
      (if (or (ge (str_find surface "require " 0) 0)
              (ge (str_find surface "include " 0) 0)) 1 0)
    (if (str_eq locale "swift")
      (if (ge (str_find surface "import " 0) 0) 1 0)
    (if (str_eq locale "kotlin")
      (if (ge (str_find surface "import " 0) 0) 1 0) 0))))))))))))
  (defn fnc-all-pl-dependency-construct? (projections)
    (if (eq (len projections) 0) 1
      (if (eq (fnc-pl-dependency-construct?
                (fnc-p-locale (head projections))
                (fnc-p-surface (head projections))) 1)
        (fnc-all-pl-dependency-construct? (tail projections)) 0)))
  (defn fnc-pl-language-only-data ()
    (list
      (list "python" "def f(x):\n    print(f\"{x}\")\n")
      (list "javascript" "const f = x => console.log(x);\n")
      (list "typescript" "interface T { x: string }\nconst y: string = \"m\";\n")
      (list "java" "public static class T { void x() { System.out.println(); } }\n")
      (list "c" "int main(void) { printf(\"x\"); return 0; }\n")
      (list "cpp" "int main() { std::cout << \"x\"; }\n")
      (list "csharp" "namespace T { class C { static void Main() { Console.WriteLine(); } } }\n")
      (list "go" "package main\nfunc main() { fmt.Println() }\n")
      (list "rust" "fn main() { let mut y = 1; println!(\"{y}\"); }\n")
      (list "ruby" "def x\n  puts \"x\"\nend\n")
      (list "php" "<?php\n$x = 1; echo $x;\n?>\n")
      (list "swift" "func x() { let y = 1 }\n")
      (list "kotlin" "data class T(val x: Int)\nfun main() { println(1) }\n")))
  (defn fnc-all-language-only? (rows)
    (if (eq (len rows) 0) 1
      (do (let row (head rows))
        (if (and (str_eq (pl13-detect (nth row 1)) (nth row 0))
                 (eq (fnc-pl-dependency-construct? (nth row 0) (nth row 1)) 0))
          (fnc-all-language-only? (tail rows)) 0))))
  (defn fnc-all-lineage? (projections lineage)
    (if (eq (len projections) 0) 1
      (if (str_eq (fnc-p-lineage (head projections)) lineage)
        (fnc-all-lineage? (tail projections) lineage) 0)))
  (defn fnc-without-locale (projections locale)
    (if (eq (len projections) 0) (list)
      (if (str_eq (fnc-p-locale (head projections)) locale)
        (fnc-without-locale (tail projections) locale)
        (cons (head projections)
          (fnc-without-locale (tail projections) locale)))))

  ; These are dictionary-carrier mapping cells offered by the crossing
  ; extension. Their meaning positions hold external anchors rather than base
  ; recipe cells. Candidate alignments to recipes remain separate, so a mapping
  ; cannot impersonate admitted semantic equivalence.
  (defn fnc-projection-context (projection)
    (if (eq (fnc-p-relation projection) 1) (cfd-c-specification)
      (if (eq (fnc-p-relation projection) 2) (cfd-c-software)
        (cfd-c-relational))))
  (defn fnc-projection-language (projection)
    (if (eq (fnc-p-plane projection) 2)
      (str_concat "pl:" (fnc-p-locale projection))
      (fnc-p-locale projection)))
  ; Projection evidence is a content-addressed child of mapping provenance,
  ; not an adjacent side record. A changed state, source, source code, residue,
  ; or lineage therefore changes the evidence-bearing mapping while its
  ; external anchor stays stable.
  (defn fnc-projection-evidence (projection)
    (intern_node (cfd-cat-evidence)
      (list (intern_trivial_int (fnc-p-plane projection))
            (intern_trivial_int (fnc-p-relation projection))
            (intern_trivial_string (fnc-p-state projection))
            (intern_trivial_string (fnc-p-source projection))
            (intern_trivial_string (fnc-p-source-code projection))
            (intern_trivial_int (fnc-p-residue projection))
            (intern_trivial_string (fnc-p-lineage projection)))))
  (defn fnc-pe-state (e) (node_value (nth (node_children e) 2)))
  (defn fnc-pe-source (e) (node_value (nth (node_children e) 3)))
  (defn fnc-pe-source-code (e) (node_value (nth (node_children e) 4)))
  (defn fnc-pe-residue (e) (node_value (nth (node_children e) 5)))
  (defn fnc-pe-lineage (e) (node_value (nth (node_children e) 6)))
  (defn fnc-projection-provenance (projection surface context ordinal)
    (do (let occurrence (cfd-occurrence surface context
      (cfd-corpus (fnc-p-source projection) (fnc-p-lineage projection))
      ordinal 0 (str_len (fnc-p-surface projection)) (cfd-gap 100)))
      (cfd-provenance-linked occurrence
        (cfd-surface-projection surface surface 0)
        1 0 (fnc-p-residue projection) 1
        (fnc-projection-evidence projection))))
  (defn fnc-projection-mapping (projection ordinal)
    (do (let language (fnc-projection-language projection))
      (let surface (cfd-surface language (fnc-p-surface projection)))
      (let context (fnc-projection-context projection))
      (cfd-mapping surface context (fnc-p-symbol projection) surface
        (fnc-projection-provenance projection surface context ordinal))))
  (defn fnc-projection-mappings-go (projections ordinal)
    (if (eq (len projections) 0) (list)
      (cons (fnc-projection-mapping (head projections) ordinal)
        (fnc-projection-mappings-go (tail projections) (add ordinal 1)))))
  (defn fnc-projection-mappings (projections start)
    (fnc-projection-mappings-go projections start))
  (defn fnc-all-mapping-claim? (mappings claim)
    (if (eq (len mappings) 0) 1
      (if (eq (cfd-prov-claim
                (cfd-map-provenance (head mappings))) claim)
        (fnc-all-mapping-claim? (tail mappings) claim) 0)))
  (defn fnc-crossing-mappings (runtime)
    (append (fnc-projection-mappings
      (fnc-nl-required-projections runtime) 1001)
      (append (fnc-projection-mappings
        (fnc-pl-dependency-projections) 2001)
        (fnc-projection-mappings (fnc-nl-need-projections) 3001))))
  (defn fnc-parse-crossing (runtime language text context)
    (cfd-parse-in (fnc-crossing-mappings runtime) language text context))

  0)
