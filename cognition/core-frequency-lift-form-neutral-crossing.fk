// core-frequency-lift-form-neutral-crossing.fk
//
// An observed vertical crossing from numeric recipe identity into NL and PL
// surfaces. Strings remain projection evidence; no string participates in the
// identity of either meaning. Projection residue is retained rather than
// calling a machine, lexical, or syntax crossing exact semantic equivalence.
//
// witnessed: 2026-08-14 -> native projection/mapping crossing 67108863;
//                               semantic alignments remain candidate
import "../form/form-stdlib/core.fk"
import "concept-nl-semantic-13-runtime.fk"
import "nl-lenses-13.fk"
import "pl-lenses-13.fk"
import "core-frequency-lift-dictionary.fk"
section [form.bml] {
    // projection = [plane, locale, surface, anchor, relation, evidence-state,
    //               source, source-code, residue, lineage-anchor]
    // plane: 1 NL, 2 PL. relation: 1 lexical status, 2 PL dependency
    // declaration, 3 NL need enquiry. Residue bits are projection-local:
    //   1 mapped/unreviewed, 2 machine source, 4 lexical-kind shift,
    //   8 PL binding/include mechanics, 16 enquiry/address/formality,
    //   32 inherited pivot or authored alignment.
    def fnc-projection(plane, locale, surface, anchor, relation, evidence-state, source, source-code, residue, lineage) = [plane, locale, surface, anchor, relation, evidence-state, source, source-code, residue, lineage];
    def fnc-p-plane(p) = p[0];
    def fnc-p-locale(p) = p[1];
    def fnc-p-surface(p) = p[2];
    def fnc-p-symbol(p) = p[3];
    def fnc-p-anchor(p) = p[3];
    def fnc-p-relation(p) = p[4];
    def fnc-p-state(p) = p[5];
    def fnc-p-source(p) = p[6];
    def fnc-p-source-code(p) = p[7];
    def fnc-p-residue(p) = p[8];
    def fnc-p-lineage(p) = p[9];
    // External anchor identity is numeric and surface-free, but its lineage is
    // not neutralized away. Anchor 1400 inherits the PWN/OMW inventory; anchors
    // 2001 and 3001 are local PL/phrase-pack observation seats.
    def fnc-cat-anchor() = make_nodeid(31, 2, 0, 21);
    def fnc-cat-alignment() = make_nodeid(31, 2, 0, 22);
    def fnc-anchor(index) = cfd-indexed(fnc-cat-anchor(), index);
    def fnc-nl-necessary-anchor() = fnc-anchor(1400);
    def fnc-pl-dependency-anchor() = fnc-anchor(2001);
    def fnc-need-enquiry-anchor() = fnc-anchor(3001);
    // alignment = [external anchor, candidate recipe, residue]. It is an
    // inspectable proposal, not identity equality or semantic admission.
    def fnc-alignment(anchor, recipe, residue) = intern_node(fnc-cat-alignment(), [anchor, recipe, intern_trivial_int(residue)]);
    def fnc-a-anchor(a) = node_children(a)[0];
    def fnc-a-recipe(a) = node_children(a)[1];
    def fnc-a-residue(a) = node_value(node_children(a)[2]);
    def fnc-nl-dependency-alignment() = fnc-alignment(fnc-nl-necessary-anchor(), fnc-dependency-symbol(), 36);
    def fnc-pl-dependency-alignment() = fnc-alignment(fnc-pl-dependency-anchor(), fnc-dependency-symbol(), 40);
    def fnc-need-enquiry-alignment() = fnc-alignment(fnc-need-enquiry-anchor(), fnc-need-enquiry-symbol(), 48);
    // Same identity as cfd-requirement-dependency, reconstructed only from
    // numeric axiom, role, and gap cells. Local function names aid maintainers;
    // the interned content contains no surface label.
    def fnc-dependency-symbol() = cfd-meaning([cfd-e(cfd-role(10), cfd-axiom(2)), cfd-e(cfd-role(12), cfd-meaning([cfd-e(cfd-role(10), cfd-axiom(2)), cfd-e(cfd-role(19), cfd-axiom(3))])), cfd-e(cfd-role(47), cfd-gap(22)), cfd-e(cfd-role(48), cfd-gap(23)), cfd-e(cfd-role(33), cfd-axiom(4))]);
    // A question about living support is related to, but not identical with, a
    // dependency relation. The separate symbol prevents NL enquiry grammar from
    // being collapsed into PL dependency syntax.
    def fnc-need-enquiry-symbol() = cfd-meaning([cfd-e(cfd-role(12), cfd-requirement-need()), cfd-e(cfd-role(14), cfd-observation()), cfd-e(cfd-role(16), cfd-axiom(5)), cfd-e(cfd-role(20), cfd-axiom(1))]);
    // Pinned index 1400 / synset 01580050-a supplies thirteen surfaces for the
    // lexical status conventionally anchored in English as "necessary". The live
    // runtime retains each locale's actual source code. No row is reviewed.
    def fnc-nl-required-index() = 1400;
    def fnc-nl-residue(source-code) = (String) source-code == "F" ? 36 : (String) source-code == "G" ? 39 : 37;
    def fnc-nl-required-projection(runtime, code) = {
        let lookup = cnl13-runtime-lookup-sourced(runtime, fnc-nl-required-index(), code);
        let source-code = lookup[6];
        let label = lookup[3];
        (String) label == "" ? nothing() : fnc-projection(1, code, label, fnc-nl-necessary-anchor(), 1, lookup[4], lookup[5], source-code, fnc-nl-residue(source-code), lookup[1]);
    };
    def fnc-nl-required-projections-go(runtime, codes) = (Comparable) len(codes) == 0 ? [] : {
        let projection = fnc-nl-required-projection(runtime, codes[0]);
        nothing?(projection) ? fnc-nl-required-projections-go(runtime, codes[1:]) : cons(projection, fnc-nl-required-projections-go(runtime, codes[1:]));
    };
    def fnc-nl-required-projections(runtime) = fnc-nl-required-projections-go(runtime, cnl13-locale-codes());
    // PL surfaces deliberately include enough actual syntax for the existing
    // native PL detector to recognize the language. Identifiers are arbitrary
    // projection material; the shared symbol remains numeric.
    def fnc-pl-dependency-data() = [["python", "from m import x\n"], ["javascript", "const x = require(\"m\");\n"], ["typescript", "import { x } from \"m\";\ninterface T { x: string }\nconst y: string = \"m\";\n"], ["java", "import m.X;\npublic static class T {}\n"], ["c", "#include <x.h>\nint main(void) { return 0; }\n"], ["cpp", "#include <iostream>\n#include <x.hpp>\nstd::size_t n = 1;\n"], ["csharp", "using System;\nusing M;\nnamespace T {}\n"], ["go", "package main\nimport \"m\"\nfunc main() { _ = m.X }\n"], ["rust", "use m::x;\nfn main() { let mut y = x; println!(\"{y:?}\"); }\n"], ["ruby", "require \"m\"\ndef x\nend\n"], ["php", "<?php\n$x = require \"m.php\";\necho $x;\n?>\n"], ["swift", "import Foundation\nimport M\nfunc x() { let y = 1 }\n"], ["kotlin", "import m.X\ndata class T(val x: X)\nfun main() { println(T(X()).x) }\n"]];
    def fnc-pl-dependency-projection(row) = fnc-projection(2, row[0], row[1], fnc-pl-dependency-anchor(), 2, "repo-observed-bounded-fixture", "cognition/core-frequency-lift-form-neutral-crossing.fk", "native-pl-surface", 40, "pl-dependency-fixture");
    def fnc-pl-dependency-projections-go(rows) = (Comparable) len(rows) == 0 ? [] : cons(fnc-pl-dependency-projection(rows[0]), fnc-pl-dependency-projections-go(rows[1:]));
    def fnc-pl-dependency-projections() = fnc-pl-dependency-projections-go(fnc-pl-dependency-data());
    // The phrase pack supplies a second NL candidate plane. Its own source notes
    // say the longer phrases are bounded rented-voice seeds; row sources are
    // lineage context, not phrase-specific attestation. The full enquiry maps to
    // its own anchor and therefore does not force enquiry grammar into dependency.
    def fnc-nl-need-projection(row) = fnc-projection(1, nl13-code(row), nl13-need(row), fnc-need-enquiry-anchor(), 3, "bounded-rented-voice-seed-unreviewed", "cognition/nl-lenses-13-data.fk", "bounded-phrase", 48, nl13-source(row));
    def fnc-nl-need-projections-go(rows) = (Comparable) len(rows) == 0 ? [] : cons(fnc-nl-need-projection(rows[0]), fnc-nl-need-projections-go(rows[1:]));
    def fnc-nl-need-projections() = fnc-nl-need-projections-go(nl13-data());
    def fnc-find-projection(projections, locale) = (Comparable) len(projections) == 0 ? nothing() : (String) fnc-p-locale(projections[0]) == locale ? projections[0] : fnc-find-projection(projections[1:], locale);
    def fnc-all-symbol?(projections, symbol) = (Comparable) len(projections) == 0 ? 1 : node_eq(fnc-p-symbol(projections[0]), symbol) ? fnc-all-symbol?(projections[1:], symbol) : 0;
    def fnc-count-source-code(projections, wanted) = (Comparable) len(projections) == 0 ? 0 : (Number) ((String) fnc-p-source-code(projections[0]) == wanted ? 1 : 0) + (Number) fnc-count-source-code(projections[1:], wanted);
    def fnc-source-state-consistent?(projection) = {
        let code = fnc-p-source-code(projection);
        (String) code == "F" ? (String) fnc-p-state(projection) == "frequency-observed" && (Comparable) fnc-p-residue(projection) == 36 ? 1 : 0 : (String) code == "G" ? (String) fnc-p-state(projection) == "machine-translated-unreviewed" && (Comparable) fnc-p-residue(projection) == 39 ? 1 : 0 : (String) fnc-p-state(projection) == "mapped-unreviewed" && (Comparable) fnc-p-residue(projection) == 37 ? 1 : 0;
    };
    def fnc-all-source-state-consistent?(projections) = (Comparable) len(projections) == 0 ? 1 : (Comparable) fnc-source-state-consistent?(projections[0]) == 1 ? fnc-all-source-state-consistent?(projections[1:]) : 0;
    def fnc-all-residue?(projections, residue) = (Comparable) len(projections) == 0 ? 1 : (Comparable) fnc-p-residue(projections[0]) == residue ? fnc-all-residue?(projections[1:], residue) : 0;
    def fnc-all-pl-detected?(projections) = (Comparable) len(projections) == 0 ? 1 : (String) pl13-detect(fnc-p-surface(projections[0])) == fnc-p-locale(projections[0]) ? fnc-all-pl-detected?(projections[1:]) : 0;
    def fnc-pl-dependency-construct?(locale, surface) = (String) locale == "python" ? str_find(surface, "from ", 0) >= 0 || str_find(surface, "import ", 0) >= 0 ? 1 : 0 : (String) locale == "javascript" || (String) locale == "typescript" ? str_find(surface, "require(", 0) >= 0 || str_find(surface, "import ", 0) >= 0 ? 1 : 0 : (String) locale == "java" ? str_find(surface, "import ", 0) >= 0 ? 1 : 0 : (String) locale == "c" || (String) locale == "cpp" ? str_find(surface, "#include ", 0) >= 0 ? 1 : 0 : (String) locale == "csharp" ? str_find(surface, "using ", 0) >= 0 ? 1 : 0 : (String) locale == "go" ? str_find(surface, "import ", 0) >= 0 ? 1 : 0 : (String) locale == "rust" ? str_find(surface, "use ", 0) >= 0 || str_find(surface, "extern crate ", 0) >= 0 ? 1 : 0 : (String) locale == "ruby" ? str_find(surface, "require ", 0) >= 0 ? 1 : 0 : (String) locale == "php" ? str_find(surface, "require ", 0) >= 0 || str_find(surface, "include ", 0) >= 0 ? 1 : 0 : (String) locale == "swift" ? str_find(surface, "import ", 0) >= 0 ? 1 : 0 : (String) locale == "kotlin" ? str_find(surface, "import ", 0) >= 0 ? 1 : 0 : 0;
    def fnc-all-pl-dependency-construct?(projections) = (Comparable) len(projections) == 0 ? 1 : (Comparable) fnc-pl-dependency-construct?(fnc-p-locale(projections[0]), fnc-p-surface(projections[0])) == 1 ? fnc-all-pl-dependency-construct?(projections[1:]) : 0;
    def fnc-pl-language-only-data() = [["python", "def f(x):\n    print(f\"{x}\")\n"], ["javascript", "const f = x => console.log(x);\n"], ["typescript", "interface T { x: string }\nconst y: string = \"m\";\n"], ["java", "public static class T { void x() { System.out.println(); } }\n"], ["c", "int main(void) { printf(\"x\"); return 0; }\n"], ["cpp", "int main() { std::cout << \"x\"; }\n"], ["csharp", "namespace T { class C { static void Main() { Console.WriteLine(); } } }\n"], ["go", "package main\nfunc main() { fmt.Println() }\n"], ["rust", "fn main() { let mut y = 1; println!(\"{y}\"); }\n"], ["ruby", "def x\n  puts \"x\"\nend\n"], ["php", "<?php\n$x = 1; echo $x;\n?>\n"], ["swift", "func x() { let y = 1 }\n"], ["kotlin", "data class T(val x: Int)\nfun main() { println(1) }\n"]];
    def fnc-all-language-only?(rows) = (Comparable) len(rows) == 0 ? 1 : {
        let row = rows[0];
        (String) pl13-detect(row[1]) == row[0] && (Comparable) fnc-pl-dependency-construct?(row[0], row[1]) == 0 ? fnc-all-language-only?(rows[1:]) : 0;
    };
    def fnc-all-lineage?(projections, lineage) = (Comparable) len(projections) == 0 ? 1 : (String) fnc-p-lineage(projections[0]) == lineage ? fnc-all-lineage?(projections[1:], lineage) : 0;
    def fnc-without-locale(projections, locale) = (Comparable) len(projections) == 0 ? [] : (String) fnc-p-locale(projections[0]) == locale ? fnc-without-locale(projections[1:], locale) : cons(projections[0], fnc-without-locale(projections[1:], locale));
    // These are dictionary-carrier mapping cells offered by the crossing
    // extension. Their meaning positions hold external anchors rather than base
    // recipe cells. Candidate alignments to recipes remain separate, so a mapping
    // cannot impersonate admitted semantic equivalence.
    def fnc-projection-context(projection) = (Comparable) fnc-p-relation(projection) == 1 ? cfd-c-specification() : (Comparable) fnc-p-relation(projection) == 2 ? cfd-c-software() : cfd-c-relational();
    def fnc-projection-language(projection) = (Comparable) fnc-p-plane(projection) == 2 ? ("pl:" + fnc-p-locale(projection)) : fnc-p-locale(projection);
    // Projection evidence is a content-addressed child of mapping provenance,
    // not an adjacent side record. A changed state, source, source code, residue,
    // or lineage therefore changes the evidence-bearing mapping while its
    // external anchor stays stable.
    def fnc-projection-evidence(projection) = intern_node(cfd-cat-evidence(), [intern_trivial_int(fnc-p-plane(projection)), intern_trivial_int(fnc-p-relation(projection)), intern_trivial_string(fnc-p-state(projection)), intern_trivial_string(fnc-p-source(projection)), intern_trivial_string(fnc-p-source-code(projection)), intern_trivial_int(fnc-p-residue(projection)), intern_trivial_string(fnc-p-lineage(projection))]);
    def fnc-pe-state(e) = node_value(node_children(e)[2]);
    def fnc-pe-source(e) = node_value(node_children(e)[3]);
    def fnc-pe-source-code(e) = node_value(node_children(e)[4]);
    def fnc-pe-residue(e) = node_value(node_children(e)[5]);
    def fnc-pe-lineage(e) = node_value(node_children(e)[6]);
    def fnc-projection-provenance(projection, surface, context, ordinal) = {
        let occurrence = cfd-occurrence(surface, context, cfd-corpus(fnc-p-source(projection), fnc-p-lineage(projection)), ordinal, 0, len(fnc-p-surface(projection)), cfd-gap(100));
        cfd-provenance-linked(occurrence, cfd-surface-projection(surface, surface, 0), 1, 0, fnc-p-residue(projection), 1, fnc-projection-evidence(projection));
    };
    def fnc-projection-mapping(projection, ordinal) = {
        let language = fnc-projection-language(projection);
        let surface = cfd-surface(language, fnc-p-surface(projection));
        let context = fnc-projection-context(projection);
        cfd-mapping(surface, context, fnc-p-symbol(projection), surface, fnc-projection-provenance(projection, surface, context, ordinal));
    };
    def fnc-projection-mappings-go(projections, ordinal) = (Comparable) len(projections) == 0 ? [] : cons(fnc-projection-mapping(projections[0], ordinal), fnc-projection-mappings-go(projections[1:], (Number) ordinal + (Number) 1));
    def fnc-projection-mappings(projections, start) = fnc-projection-mappings-go(projections, start);
    def fnc-all-mapping-claim?(mappings, claim) = (Comparable) len(mappings) == 0 ? 1 : (Comparable) cfd-prov-claim(cfd-map-provenance(mappings[0])) == claim ? fnc-all-mapping-claim?(mappings[1:], claim) : 0;
    def fnc-crossing-mappings(runtime) = append(fnc-projection-mappings(fnc-nl-required-projections(runtime), 1001), append(fnc-projection-mappings(fnc-pl-dependency-projections(), 2001), fnc-projection-mappings(fnc-nl-need-projections(), 3001)));
    def fnc-parse-crossing(runtime, language, text, context) = cfd-parse-in(fnc-crossing-mappings(runtime), language, text, context);
    0;
}
