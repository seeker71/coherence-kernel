// concept-human-corpus-130000-ingest.fk -- Form-native Tatoeba stream intake.
//
// The host is allowed only to transport and decompress an archive whose URL and
// compressed SHA-256 are already pinned in ARCHIVES.tsv.  This cell owns every
// semantic decision after decompression: it reads detailed-export rows from
// stdin, validates their six-field shape and attribution, selects the first
// 10,000 eligible rows in upstream order, hashes the exact upstream row bytes,
// writes the projection and a fixed-width random-access index, and emits a
// framebuffer resource report before any success claim.
//
// No translation, paraphrase, prompt, concept label, or synthetic row enters
// selection.  `human-contributed-unreviewed` does not mean reviewed, correct,
// native-speaker-authored, parallel, or generated by this body.
// witnessed: 2026-07-20 -> exact pinned-source intake path; 10,000-row target
import form/form-stdlib/core.fk;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/str-byte-at.fk;
import form/form-stdlib/string-byte-fold-src-shim.fk;
import form/form-stdlib/sha256.fk;
import observe/framebuffer-runtime-observation.fk;
section [form.bml] {
    def chc130-field-go(line, target, col, start, i) = i >= len(line) ? (Comparable) col == target ? substring(line, start, i) : "" : (Comparable) str_byte_at(line, i) == 9 ? (Comparable) col == target ? substring(line, start, i) : chc130-field-go(line, target, (Number) col + (Number) 1, (Number) i + (Number) 1, (Number) i + (Number) 1) : chc130-field-go(line, target, col, start, (Number) i + (Number) 1);
    def chc130-field(line, col) = chc130-field-go(line, col, 0, 0, 0);
    def chc130-field-count-go(line, i, count) = i >= len(line) ? count : chc130-field-count-go(line, (Number) i + (Number) 1, (Number) count + (Number) ((Comparable) str_byte_at(line, i) == 9 ? 1 : 0));
    def chc130-field-count(line) = (String) line == "" ? 0 : chc130-field-count-go(line, 0, 1);
    def chc130-eligible?(line, lang) = (Comparable) chc130-field-count(line) == 6 && ((String) chc130-field(line, 1) == lang && (str_to_int(chc130-field(line, 0)) > 0 && (!((String) chc130-field(line, 3) == "") && (!((String) chc130-field(line, 3) == "\\N") && !((String) chc130-field(line, 2) == "")))));
    def chc130-concat-go(parts, out) = (Comparable) len(parts) == 0 ? out : chc130-concat-go(parts[1:], ((String) out + parts[0]));
    def chc130-concat(parts) = chc130-concat-go(parts, "");
    def chc130-string-bytes-go(s, i, out) = i < 0 ? out : chc130-string-bytes-go(s, i - 1, cons(str-byte-at(s, i), out));
    def chc130-string-bytes(s) = chc130-string-bytes-go(s, len(s) - 1, empty());
    def chc130-hex-char(n) = substring("0123456789abcdef", n, (Number) n + (Number) 1);
    def chc130-hex-go(bytes, out) = (Comparable) len(bytes) == 0 ? out : chc130-hex-go(bytes[1:], (out + ((String) chc130-hex-char(bytes[0] / 16) + chc130-hex-char(bytes[0] % 16))));
    def chc130-hex(bytes) = chc130-hex-go(bytes, "");
    def chc130-source-hash(line) = chc130-hex(sha256(chc130-string-bytes(line)));
    def chc130-page-url(sentence-id) = ("https://tatoeba.org/en/sentences/show/" + sentence-id);
    def chc130-projection-row(locale, line) = {
        let sentence-id = chc130-field(line, 0);
        chc130-concat([locale, "\t", chc130-field(line, 1), "\t", sentence-id, "\t", chc130-field(line, 3), "\t", chc130-field(line, 4), "\t", chc130-field(line, 5), "\tCC-BY-2.0-FR\t", chc130-page-url(sentence-id), "\thuman-contributed-unreviewed\t", chc130-source-hash(line), "\t", chc130-field(line, 2), "\n"]);
    };
    def chc130-u32le(n) = [n % 256, n / 256 % 256, n / 65536 % 256, n / 16777216 % 256];
    def chc130-header() = "locale\ttatoeba_lang\tsentence_id\tauthor\tadded_utc\tmodified_utc\tlicense\tsentence_url\treview_state\tsource_row_sha256\tsentence\n";
    def chc130-output-open(data-path, index-path) = {
        let header = chc130-header();
        let data-size = write_file(data-path, header);
        let cleared-index = write_file(index-path, "");
        let index-size = file_append_bytes(index-path, chc130-u32le(len(header)));
        [data-size, cleared-index, index-size];
    };
    // scan = selected, source rows read, rejected rows, source bytes observed,
    //        final data bytes, final index bytes, EOF state.
    def chc130-stream-go(locale, lang, target, data-path, index-path, selected, scanned, rejected, input-bytes) = selected >= target ? [selected, scanned, rejected, input-bytes, fs-stat-size(data-path), fs-stat-size(index-path), "target-met"] : {
        let line = read_line();
        (String) line == "" ? [selected, scanned, rejected, input-bytes, fs-stat-size(data-path), fs-stat-size(index-path), "source-exhausted"] : (Comparable) chc130-eligible?(line, lang) == 0 ? chc130-stream-go(locale, lang, target, data-path, index-path, selected, (Number) scanned + (Number) 1, (Number) rejected + (Number) 1, (Number) input-bytes + (Number) ((Number) len(line) + (Number) 1)) : {
            let row = chc130-projection-row(locale, line);
            let new-size = file_append_bytes(data-path, chc130-string-bytes(row));
            let index-size = file_append_bytes(index-path, chc130-u32le(new-size));
            chc130-stream-go(locale, lang, target, data-path, index-path, (Number) selected + (Number) 1, (Number) scanned + (Number) 1, rejected, (Number) input-bytes + (Number) ((Number) len(line) + (Number) 1));
        };
    };
    def chc130-ingest-stream(locale, lang, target, archive-sha, archive-bytes, data-path, index-path) = {
        let window = fbro-open(("tatoeba-130000-intake-" + locale), "Sema", "ingests-attributed-human-sentences", "expand-real-source-corpus-toward-130000", "hash-pinned-tatoeba-detailed-export", archive-bytes, "cognition/concept-human-corpus-130000-ingest.fk", 113, 7);
        let opened = chc130-output-open(data-path, index-path);
        let before = fbro-snapshot();
        let scan = chc130-stream-go(locale, lang, target, data-path, index-path, 0, 0, 0, 0);
        let after = fbro-snapshot();
        let outcome = (Comparable) scan[0] == target ? "target-met-attributed-unreviewed" : "source-shortfall-no-padding";
        let stage = fbro-stage-observed(("tatoeba-130000-intake-" + locale), "select-and-write", "trace-begin", "Sema", "ingests-attributed-human-sentences", "expand-real-source-corpus-toward-130000", "hash-pinned-tatoeba-detailed-export", before, after, "attributed-rows", scan[0], outcome, "cognition/concept-human-corpus-130000-ingest.fk", 125, 7);
        let report = fbro-close(window, outcome, scan[0], "cognition/concept-human-corpus-130000-ingest.fk", 128, 7);
        ["concept-human-corpus-130000-intake", locale, lang, archive-sha, archive-bytes, scan, report];
    };
}
