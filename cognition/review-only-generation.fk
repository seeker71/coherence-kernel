; review-only-generation.fk — remote minds may review, never author response text.
;
; Generation sources are explicit data:
;   1 form-native composition/generation
;   2 local-rented model on this machine
;   3 remote model
; A response is admissible only when source 3 contributes zero words. A remote
; review carries only axiom-5's bounded kind (nothing/0/1/node) plus an optional
; numeric counter-offer id; it has no text field, so review prose cannot leak into
; the response. Native promotion remains earned: native replaces local generation
; only after its held-out score meets or exceeds local and its floor is cleared.
;
; This closes remote generation for bounded composed responses. It does not call
; templated Form composition neural generation, and it does not claim the local
; model has been retired. Proven by cognition/tests/review-only-generation-band.fk.
;
; preludes: form-stdlib/core.fk

(do
    (defn rog-native-source () 1)
    (defn rog-local-source  () 2)
    (defn rog-remote-source () 3)

    (defn rog-segment (source text) (list source text))
    (defn rog-segment-source (s) (nth s 0))
    (defn rog-segment-text   (s) (nth s 1))

    (defn rog-space? (b) (if (eq b 32) 1 (if (eq b 10) 1 (if (eq b 9) 1 0))))
    (defn rog-words-loop (s i in-word count)
        (if (ge i (str_len s)) count
            (if (eq (rog-space? (str_byte_at s i)) 1)
                (rog-words-loop s (add i 1) 0 count)
                (if (eq in-word 1)
                    (rog-words-loop s (add i 1) 1 count)
                    (rog-words-loop s (add i 1) 1 (add count 1))))))
    (defn rog-word-count (s) (rog-words-loop s 0 0 0))

    (defn rog-source-words (segments source)
        (if (eq (len segments) 0) 0
            (add
                (if (eq (rog-segment-source (head segments)) source)
                    (rog-word-count (rog-segment-text (head segments))) 0)
                (rog-source-words (tail segments) source))))
    (defn rog-generation-words (segments)
        (add (rog-source-words segments (rog-native-source))
        (add (rog-source-words segments (rog-local-source))
             (rog-source-words segments (rog-remote-source)))))
    (defn rog-remote-generation-free? (segments)
        (if (eq (rog-source-words segments (rog-remote-source)) 0) 1 0))
    (defn rog-share (segments source)
        (do
            (let total (rog-generation-words segments))
            (if (eq total 0) 0
                (div (mul (rog-source-words segments source) 100) total))))

    (defn rog-join (segments acc)
        (if (eq (len segments) 0) acc
            (rog-join (tail segments)
                (str_concat acc (rog-segment-text (head segments))))))
    (defn rog-compose (segments)
        (if (eq (rog-remote-generation-free? segments) 1)
            (rog-join segments "")
            "refused:remote-generation-token"))

    ; Review has no text slot. kind: 0=nothing, 1=zero, 2=one, 3=node.
    ; counter is meaningful only for kind 3 and becomes later work, never prose.
    (defn rog-review (kind counter) (list kind counter))
    (defn rog-review-kind (review) (nth review 0))
    (defn rog-review-counter (review) (nth review 1))
    (defn rog-review-valid? (review)
        (if (and (ge (rog-review-kind review) 0) (le (rog-review-kind review) 3)) 1 0))
    ; A review may accept, reject, stay silent, or open work. It cannot rewrite.
    (defn rog-apply-review (response review)
        (if (eq (rog-review-valid? review) 1) response response))
    (defn rog-review-opens-work? (review)
        (if (and (eq (rog-review-kind review) 3) (gt (rog-review-counter review) 0)) 1 0))

    ; Local is the incumbent until native quality earns replacement.
    (defn rog-use-native? (native-score local-score floor-met)
        (if (and (ge native-score local-score) (eq floor-met 1)) 1 0))
    (defn rog-author-source (native-score local-score floor-met)
        (if (eq (rog-use-native? native-score local-score floor-met) 1)
            (rog-native-source)
            (rog-local-source)))

    ; receipt = native words, local words, remote words, native share,
    ; local share, remote share, remote-free, composed response.
    (defn rog-receipt (segments)
        (list
            (rog-source-words segments (rog-native-source))
            (rog-source-words segments (rog-local-source))
            (rog-source-words segments (rog-remote-source))
            (rog-share segments (rog-native-source))
            (rog-share segments (rog-local-source))
            (rog-share segments (rog-remote-source))
            (rog-remote-generation-free? segments)
            (rog-compose segments)))

    0)
