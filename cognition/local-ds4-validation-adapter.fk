; local-ds4-validation-adapter.fk -- turn a real DS4 validation capture into
; the local-validation-ladder's typed validation row.
;
; CLEAR returns the original semantic proposal. REPAIR returns a typed repair
; node containing the corrected surface; it remains water in the ladder until
; a later execution/lowering confirms it. Invalid syntax, low confidence, a
; learned-calibrator disagreement, or UNRESOLVED all become unresolved and are
; therefore eligible for the remote teacher.
;
; preludes: cognition/local-validation-ladder.fk
;           form-stdlib/dsv4-validation-protocol.fk
;           form-stdlib/dsv4-validation-calibrator.fk
; witnessed: pending live semantic run
import "local-validation-ladder.fk"
import "../form/form-stdlib/dsv4-validation-protocol.fk"
import "../form/form-stdlib/dsv4-validation-calibrator.fk"

(do
  (defn ldva-repair-kind () 1001099901)
  (defn ldva-repair-node (surface original-proposal)
    (list (ldva-repair-kind) surface original-proposal))
  (defn ldva-repair-node? (node)
    (if (gt (len node) 0) (if (eq (head node) (ldva-repair-kind)) 1 0) 0))
  (defn ldva-health (trusted)
    (if (eq trusted 1)
      (lfsm-health (fc-certified-form-reading 1 1) 1 1 1 1)
      (lvl-candidate-health)))
  (defn ldva-issue-node (parsed)
    (if (eq (nth parsed 0) 1) (add 1001099910 (nth parsed 1)) 1001099919))

  (defn ldva-from-capture (request proposal capture)
    (do (let parsed (nth capture 5))
      (let valid (nth parsed 0))
      (let state (nth parsed 1))
      (let confidence (nth parsed 2))
      (let trusted (if (and (eq valid 1) (eq (nth capture 7) 1))
        (if (ge confidence 80) 1 0) 0))
      (let evidence-node (if (eq valid 1) (add 1 (nth parsed 3)) 0))
      (if (and (eq trusted 1) (eq state (dvp-state-clear)))
        (lvl-validation (lvl-state-clear) proposal (nth parsed 8)
          (ldva-health 1) confidence evidence-node 0)
        (if (and (eq trusted 1) (eq state (dvp-state-repair)))
          (if (gt (str_len (nth parsed 8)) 0)
            (lvl-validation (lvl-state-repaired)
              (ldva-repair-node (nth parsed 8) proposal) (nth parsed 8)
              (ldva-health 1) confidence evidence-node (ldva-issue-node parsed))
            (lvl-validation (lvl-state-unresolved) (nothing) ""
              (ldva-health 0) 0 0 (ldva-issue-node parsed)))
          (lvl-validation (lvl-state-unresolved) (nothing) ""
            (ldva-health 0) confidence evidence-node (ldva-issue-node parsed))))))
  0)
