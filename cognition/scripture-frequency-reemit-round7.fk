; scripture-frequency-reemit-round7.fk — observe source -> lexical frequency
; -> language-neutral graph re-emission for Ruth and Astavakragita.
; Sources remain byte-unchanged; every introduced item is a traced derived edge.
; Public observation begins [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [nothing,0,1,7001,2,61539,2,4,2,68528,4,14,3,21,100,21,
;  130067,0,23,4,2411125,228,1,1]
(do
  (defn sfr7-fold (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn sfr7-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (sfr7-fold (str_byte_at s (add i j)))
              (sfr7-fold (str_byte_at p j)))
        (sfr7-match s i p (add j 1)) 0))))
  (defn sfr7-count-loop (s p i n) (if (gt (add i (str_len p)) (str_len s)) n
    (if (eq (sfr7-match s i p 0) 1)
      (sfr7-count-loop s p (add i (str_len p)) (add n 1))
      (sfr7-count-loop s p (add i 1) n))))
  (defn sfr7-count (s p) (sfr7-count-loop s p 0 0))
  (defn sfr7-sum (s ps) (if (eq (len ps) 0) 0
    (add (sfr7-count s (head ps)) (sfr7-sum s (tail ps)))))
  (defn sfr7-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (sfr7-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (defn sfr7-hash-loop (s i h) (if (ge i (str_len s)) h
    (sfr7-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn sfr7-hash (s) (sfr7-hash-loop s 0 0))
  (defn sfr7-row (source surface-id count relation-id)
    (do (let r0 (str_concat (sfr7-int source) "|"))
      (let r1 (str_concat r0 (str_concat (sfr7-int surface-id) "|")))
      (let r2 (str_concat r1 (str_concat (sfr7-int count) "|")))
      (str_concat r2 (str_concat (sfr7-int relation-id) "|derived|source-unchanged\n"))))

  (let ruth (read_file "corpus/sources/bible-web/09-RUTengwebp.usfm"))
  (let asta (read_file "corpus/sources/sanskrit-sarit/astavakragita.xml"))
  ; Ruth: compulsion-family surface -> choice relation 202.
  (let ruth-commanded (sfr7-count ruth "commanded"))
  (let ruth-pressure ruth-commanded)
  (let ruth-open (sfr7-sum ruth (list "love" "kindness" "mercy" "peace" "faithful" "restore")))
  ; Astavakragita: fear, bondage, ignorance retain distinct neutral surfaces;
  ; derived relations are discernment 205, relationship 204, knowing 202.
  (let asta-bhaya (sfr7-count asta "bhaya"))
  (let asta-bandha (sfr7-count asta "bandha"))
  (let asta-ajnana (sfr7-count asta "ajñāna"))
  (let asta-pressure (add asta-bhaya (add asta-bandha asta-ajnana)))
  (let asta-open (sfr7-sum asta (list "jñāna" "mukti" "śānta" "sukha" "ātma")))
  (let derived-edges (add ruth-pressure asta-pressure))
  (let state0 "scripture-frequency-reemit-v7\nsource-bytes-unchanged=1\nsurface-words-removed=0\n")
  (let state1 (str_concat state0 (sfr7-row 1 102 ruth-commanded 202)))
  (let state2 (str_concat state1 (sfr7-row 2 105 asta-bhaya 205)))
  (let state3 (str_concat state2 (sfr7-row 2 104 asta-bandha 204)))
  (let state (str_concat state3 (sfr7-row 2 103 asta-ajnana 202)))
  (let saved (write_file ".form-scripture-frequency-reemit-v7.state" state))
  (let reread (read_file ".form-scripture-frequency-reemit-v7.state"))
  (let identity (if (eq (sfr7-hash state) (sfr7-hash reread)) 1 0))
  (let success (if (eq ruth-commanded 2)
    (if (gt asta-pressure 0)
      (if (eq derived-edges (add ruth-pressure asta-pressure))
        (if (eq identity 1) 1 0) 0) 0) 0))
  ; [nothing, 0, 1, re-emission-node, texts,
  ;  Ruth bytes/pressure/open/derived,
  ;  Astavakragita bytes/bhaya/bandha/ajnana/pressure/open/derived,
  ;  retained bytes, removed surface words, introduced graph edges,
  ;  phrase rules, state fingerprint/bytes/identity/success]
  (list (nothing) 0 1 7001 2
    (str_len ruth) ruth-pressure ruth-open ruth-pressure
    (str_len asta) asta-bhaya asta-bandha asta-ajnana asta-pressure asta-open asta-pressure
    (add (str_len ruth) (str_len asta)) 0 derived-edges 4
    (sfr7-hash state) saved identity success))
