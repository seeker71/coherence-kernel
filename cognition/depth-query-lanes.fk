; depth-query-lanes.fk — one question, two depth lanes: Steiner and Jung,
; read side by side and never merged.
;
; Urs asked for "a steiner, carl jung organ as query lanes". This is that organ.
; A query arrives as tokens. Each lane answers with the ANCHORS it reaches in
; its own meaning graph — Steiner at node level 45, Jung at level 46 — and with
; the tokens it cannot carry. Nothing is generated; a lane either holds a node
; for a word or it honestly does not.
;
; ── WHY LANES, AND NOT ONE MERGED GRAPH ────────────────────────────────────
; Because "Ich" is two different things. Steiner's Ich is the fourth member of
; the human being beside physischer Leib, Aetherleib and Astralleib. Jung's Ich
; is, verbatim in 1921, "bloss ein Komplex unter andern Komplexen" — the centre
; of the field of consciousness, explicitly not the whole psyche. They share a
; German string and almost nothing else. One graph holding "Ich" once, with both
; evidences hanging off it, would have already committed the error the whole
; comparison exists to prevent: letting a shared surface pass for a shared
; meaning. Two levels make that error unrepresentable, and dql-ich-law? is the
; check that says so.
;
; ── THE LANE LAW, borrowed unchanged from learn/gender-three-lanes.fk ───────
; Belief ranks strictly below evidence, and BOTH of these lanes are belief.
; Neither Steiner's spiritual research nor Jung's depth psychology is carried
; here as measurement. A lane can be read, quoted and compared; it can never
; outrank a measurement, and this cell holds no evidence lane at all so that
; nothing here can be mistaken for one.
;
; ── RHYMES CARRY THEIR OWN FALSIFIER ───────────────────────────────────────
; Where the two vocabularies resemble each other, the resemblance is a row —
; and every row states what reading it as an IDENTITY would falsify. A rhyme
; without a falsifier is how one tradition gets used to argue for the other, so
; the falsifier is not commentary, it is part of the row. dql-rhyme-is-
; equivalence? answers 0, permanently.
;
; ── THE CONTACT IS DOCUMENTED, ONE-DIRECTIONAL, AND TWICE ──────────────────
; Steiner on Jung: a whole public lecture, Dornach, 10 November 1917, GA 178 —
; engaging Jung's 1917 book, years before Psychologische Typen. Jung on Steiner:
; a private letter to M. Patzelt, 29 November 1935, aimed at claims about
; Atlantis. Neither read the other's mature work; Steiner died in 1925. Whether
; the two ever met is genuinely unsettled in the sources, so dql-met? answers
; NOTHING — an absence recorded rather than a guess minted.
;
; preludes: form-stdlib/core.fk
; preludes: cognition/language-neutral-symbol-identity.fk
; preludes: cognition/steiner-neutral-kernel.fk
; preludes: cognition/jung-neutral-kernel.fk
;
; Proven by: cognition/tests/depth-query-lanes-band.fk

(do
  ;; ── lane codes. The ORDER is the law; comparison is on these
  ;; numbers, never on a name. ──
  (defn dql-belief () 1)
  (defn dql-evidence () 2)
  (defn dql-lane-order? () (if (lt (dql-belief) (dql-evidence)) 1 0))

  ;; ── the lanes: (id, name, node-level, lane-code, source-marker) ──
  (defn dql-lane (id name level lane marker) (list id name level lane marker))
  (defn dql-lane-id     (l) (nth l 0))
  (defn dql-lane-name   (l) (nth l 1))
  (defn dql-lane-level  (l) (nth l 2))
  (defn dql-lane-code   (l) (nth l 3))
  (defn dql-lane-marker (l) (nth l 4))

  (defn dql-l-steiner () 1)
  (defn dql-l-jung () 2)
  (defn dql-lanes ()
    (list (dql-lane (dql-l-steiner) "steiner" 45 (dql-belief) "body-graph")
          (dql-lane (dql-l-jung) "jung" 46 (dql-belief) "body-graph")))
  (defn dql-lane-count () 2)

  ;; every lane is belief — stated as a walk so a later row cannot slip
  ;; an evidence lane in beside them
  (defn dql-all-belief-loop (ls)
    (if (eq (len ls) 0) 1
      (if (eq (dql-lane-code (head ls)) (dql-belief))
        (dql-all-belief-loop (tail ls)) 0)))
  (defn dql-all-belief? () (dql-all-belief-loop (dql-lanes)))
  (defn dql-lane-law? ()
    (if (eq (dql-lane-order?) 1) (dql-all-belief?) 0))

  ;; ── routing: ask a lane's own graph for the node behind a surface.
  ;; The Steiner graph carries no by-surface door, so the walk is here,
  ;; over its own registered rows — never a table copied into this cell. ──
  (defn dql-stn-by-surface-loop (rs text locale)
    (if (eq (len rs) 0) (nothing)
      (do (let node (stn-sur-node (head rs)))
          (let v (stn-nl-surface locale node))
          (if (nothing? v) (dql-stn-by-surface-loop (tail rs) text locale)
            (if (str_eq v text) node
              (dql-stn-by-surface-loop (tail rs) text locale))))))
  (defn dql-stn-by-surface (text locale)
    (dql-stn-by-surface-loop (stn-surfaces) text locale))

  ;; one door, dispatching on lane id; an unknown lane answers nothing
  (defn dql-anchor (lane-id text locale)
    (if (eq lane-id (dql-l-steiner)) (dql-stn-by-surface text locale)
      (if (eq lane-id (dql-l-jung)) (jnk-by-surface text locale)
        (nothing))))
  (defn dql-reaches? (lane-id text locale)
    (if (nothing? (dql-anchor lane-id text locale)) 0 1))

  ;; ── a reading: for one lane and a token list, the anchors reached,
  ;; in query order. A token the lane does not carry is simply absent
  ;; from the reading — it is not filled, and dql-unreached names it. ──
  (defn dql-read-loop (lane-id ts locale acc)
    (if (eq (len ts) 0) acc
      (do (let a (dql-anchor lane-id (head ts) locale))
          (dql-read-loop lane-id (tail ts) locale
            (if (nothing? a) acc (append acc (list a)))))))
  (defn dql-read (lane-id tokens locale)
    (dql-read-loop lane-id tokens locale (list)))

  (defn dql-unreached-loop (ts locale acc)
    (if (eq (len ts) 0) acc
      (do (let t (head ts))
          (dql-unreached-loop (tail ts) locale
            (if (eq (add (dql-reaches? (dql-l-steiner) t locale)
                         (dql-reaches? (dql-l-jung) t locale)) 0)
              (append acc (list t)) acc)))))
  ;; tokens NEITHER lane carries — the organ's honest silence, named
  (defn dql-unreached (tokens locale) (dql-unreached-loop tokens locale (list)))

  ;; a token both lanes answer is a CROSSING: the same word standing in
  ;; two graphs for two different nodes. This is the interesting case,
  ;; and it is exactly where a merged graph would have lied.
  (defn dql-crossings-loop (ts locale acc)
    (if (eq (len ts) 0) acc
      (do (let t (head ts))
          (dql-crossings-loop (tail ts) locale
            (if (eq (add (dql-reaches? (dql-l-steiner) t locale)
                         (dql-reaches? (dql-l-jung) t locale)) 2)
              (append acc (list t)) acc)))))
  (defn dql-crossings (tokens locale) (dql-crossings-loop tokens locale (list)))

  ;; ── THE ICH LAW. For every crossing, the two lanes must answer two
  ;; DIFFERENT nodes. If any crossing ever answered one node from both
  ;; lanes, the levels would have collapsed and the graph would be
  ;; claiming Steiner's Ich and Jung's Ich are one thing. ──
  (defn dql-distinct-loop (ts locale)
    (if (eq (len ts) 0) 1
      (do (let t (head ts))
          (let a (dql-anchor (dql-l-steiner) t locale))
          (let b (dql-anchor (dql-l-jung) t locale))
          (if (eq a b) 0 (dql-distinct-loop (tail ts) locale)))))
  (defn dql-ich-law? (tokens locale)
    (dql-distinct-loop (dql-crossings tokens locale) locale))

  ;; ── RHYMES. (steiner-node, jung-node, resemblance, falsifier).
  ;; The falsifier states what reading the rhyme as an identity would
  ;; destroy, and it is part of the row, not a note beside it. ──
  (defn dql-rhyme (s j resemblance falsifier) (list s j resemblance falsifier))
  (defn dql-rhyme-steiner   (r) (nth r 0))
  (defn dql-rhyme-jung      (r) (nth r 1))
  (defn dql-rhyme-resemble  (r) (nth r 2))
  (defn dql-rhyme-falsifier (r) (nth r 3))

  (defn dql-rhymes ()
    (list
      (dql-rhyme (stn-thinking) (jnk-denken)
        "both partition inner life into irreducible modes"
        "jung has no willing function at all and demotes Wille to a quantity of energy; steiner has no sensation-intuition perceiving pair. read as identity, steiner loses Wollen and jung loses his two-axis structure")
      (dql-rhyme (stn-i) (jnk-ich)
        "the same german word names a centre in both"
        "steiner's Ich is a spiritual member of the fourfold being that reincarnates; jung's is one complex among complexes and empirically bounded. read as identity, either a complex becomes a spiritual member or a spiritual member becomes a psychic organ")
      (dql-rhyme (stn-polarity) (jnk-opposites)
        "a two-pole tension resolved by a third that is not a compromise"
        "steiner's mediator is a being, christ; jung's is a function arising from the tension itself. read as identity, an ontology collapses into a psychology or the reverse")
      (dql-rhyme (stn-knowledge-path) (jnk-transcendent-fn)
        "both name a disciplined inner practice that produces new content"
        "steiner claims trained supersensible perception of a real spiritual world; jung explicitly restrains from metaphysical claims about what the images are of. this is the axis on which the two genuinely oppose, documented in both directions")))
  (defn dql-rhyme-count () (len (dql-rhymes)))
  (defn dql-rhyme-is-equivalence? () 0)

  ;; every rhyme carries a falsifier, and its two nodes come from two
  ;; different levels — a rhyme inside one lane would be a category error
  (defn dql-level-of (node) (mod (div node 1000000) 1000))
  (defn dql-rhymes-sound-loop (rs)
    (if (eq (len rs) 0) 1
      (do (let r (head rs))
          (if (le (str_len (dql-rhyme-falsifier r)) 0) 0
            (if (eq (dql-level-of (dql-rhyme-steiner r))
                    (dql-level-of (dql-rhyme-jung r))) 0
              (dql-rhymes-sound-loop (tail rs)))))))
  (defn dql-rhymes-sound? () (dql-rhymes-sound-loop (dql-rhymes)))

  ;; ── DOCUMENTED CONTACT: (from-lane, to-lane, year, work, kind) ──
  (defn dql-contact (from to year work kind) (list from to year work kind))
  (defn dql-contact-from (c) (nth c 0))
  (defn dql-contact-to   (c) (nth c 1))
  (defn dql-contact-year (c) (nth c 2))
  (defn dql-contact-work (c) (nth c 3))
  (defn dql-contact-kind (c) (nth c 4))
  (defn dql-contacts ()
    (list
      (dql-contact (dql-l-steiner) (dql-l-jung) 1917 "ga-178-dornach-lecture"
        "public")
      (dql-contact (dql-l-jung) (dql-l-steiner) 1935 "letter-to-m-patzelt"
        "private")))
  (defn dql-contact-count () 2)
  ;; no contact row runs in both directions: each is one-way, and the
  ;; eighteen years between them are part of the fact
  (defn dql-contact-one-way-loop (cs)
    (if (eq (len cs) 0) 1
      (if (eq (dql-contact-from (head cs)) (dql-contact-to (head cs))) 0
        (dql-contact-one-way-loop (tail cs)))))
  (defn dql-contact-one-way? () (dql-contact-one-way-loop (dql-contacts)))

  ;; WHETHER THEY MET: the sources conflict and this cell does not decide.
  ;; nothing is the honest answer and it is not 0.
  (defn dql-met? () (nothing))
  (defn dql-met-recorded? () (if (nothing? (dql-met?)) 0 1))

  ;; neither read the other's mature work — a fact about the CONTACT,
  ;; carried so a later reader does not weigh either remark too heavily
  (defn dql-steiner-died () 1925)
  (defn dql-typen-published () 1921)
  (defn dql-steiner-read-mature-jung? () 0)
  0)
