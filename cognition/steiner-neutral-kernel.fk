; steiner-neutral-kernel.fk — Rudolf Steiner's fundamentals as one
; surface-independent meaning graph.
;
; No NL or PL spelling participates in the identities. A teaching is a set of
; numeric facts
;
;   [subject-node, relation-node, object-node, evidence-node, order]
;
; and English and German are registered NL projections, Form and Python
; registered PL data projections. German is here because Steiner wrote in
; German: the English is a projection of the meaning, not the original, and
; keeping both makes that visible instead of letting an English string pose as
; the teaching. A target outside the registered adapters returns nothing, so
; the graph is ready for more adapters without pretending any other language's
; grammar or framing has been built.
;
; WHY THIS CELL REPLACES THE PROSE ONE
;   ingest/frequency-ingest-steiner-core.fk stores each teaching as an English
;   sentence. That cell can answer "which lens fires", and it cannot generate
;   anything in German, Indonesian or code, because the teaching IS the English
;   string there. Asked for a neutral-space ingest, it was the wrong shape and
;   the review machinery built around it was a detour. This cell is the shape
;   that was asked for; the prose cell keeps only its selector.
;
; SHAPE borrowed unchanged from cognition/giles-light-hubs-neutral-kernel.fk,
; the body's own neutral-ingest exemplar (landed 2026-07-28). Coordinate space
; (package 3, level 45) — (3,36)..(3,44) were already taken.
;
; INTENTIONALLY LOSSY, and the losses are named. This is the FUNCTIONAL kernel
; of the fundamentals: the folds, their members, their order, the sense groups,
; the polarity and its mediator, and the social spheres with their principles.
; It is not his cosmology, not the evolution of consciousness through planetary
; stages, not the hierarchies, not the Christology beyond the mediating
; position, and not the biographical detail of the karma research. It carries
; reincarnation and karma as concepts with their dependency because a review of
; the prose cell found their absence disqualifying, but it does not pretend to
; hold their content.
;
; The mediator of the polarity is CHRIST, and that is in the graph as a node
; rather than softened into "the middle". A prior version secularised it, which
; a reviewer named as doing to his Christology exactly what the file accused
; others of doing to his machine-critique.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk

(do
  (defn stn-node (type instance) (lnsi-node 3 45 type instance))

  (defn stn-t-concept  () 1)
  (defn stn-t-member   () 2)
  (defn stn-t-sense    () 3)
  (defn stn-t-group    () 4)
  (defn stn-t-relation () 5)
  (defn stn-t-work     () 6)
  (defn stn-t-state    () 7)

  ;; ── concepts ────────────────────────────────────────────────────
  (defn stn-threefold-soul   () (stn-node (stn-t-concept) 1))
  (defn stn-fourfold-being   () (stn-node (stn-t-concept) 2))
  (defn stn-twelve-senses    () (stn-node (stn-t-concept) 3))
  (defn stn-polarity         () (stn-node (stn-t-concept) 4))
  (defn stn-threefold-social () (stn-node (stn-t-concept) 5))
  (defn stn-freedom          () (stn-node (stn-t-concept) 6))
  (defn stn-knowledge-path   () (stn-node (stn-t-concept) 7))
  (defn stn-reincarnation    () (stn-node (stn-t-concept) 8))
  (defn stn-karma            () (stn-node (stn-t-concept) 9))
  (defn stn-eurythmy         () (stn-node (stn-t-concept) 10))

  ;; ── members ─────────────────────────────────────────────────────
  (defn stn-thinking () (stn-node (stn-t-member) 1))
  (defn stn-feeling  () (stn-node (stn-t-member) 2))
  (defn stn-willing  () (stn-node (stn-t-member) 3))
  (defn stn-physical () (stn-node (stn-t-member) 4))
  (defn stn-etheric  () (stn-node (stn-t-member) 5))
  (defn stn-astral   () (stn-node (stn-t-member) 6))
  (defn stn-i        () (stn-node (stn-t-member) 7))
  (defn stn-lucifer  () (stn-node (stn-t-member) 8))
  (defn stn-ahriman  () (stn-node (stn-t-member) 9))
  (defn stn-christ   () (stn-node (stn-t-member) 10))
  (defn stn-spirit-sphere () (stn-node (stn-t-member) 11))
  (defn stn-rights-sphere () (stn-node (stn-t-member) 12))
  (defn stn-economy-sphere () (stn-node (stn-t-member) 13))
  (defn stn-liberty     () (stn-node (stn-t-member) 14))
  (defn stn-equality    () (stn-node (stn-t-member) 15))
  (defn stn-fraternity  () (stn-node (stn-t-member) 16))
  (defn stn-moral-imagination () (stn-node (stn-t-member) 17))

  ;; ── the twelve senses ───────────────────────────────────────────
  (defn stn-s-touch    () (stn-node (stn-t-sense) 1))
  (defn stn-s-life     () (stn-node (stn-t-sense) 2))
  (defn stn-s-movement () (stn-node (stn-t-sense) 3))
  (defn stn-s-balance  () (stn-node (stn-t-sense) 4))
  (defn stn-s-smell    () (stn-node (stn-t-sense) 5))
  (defn stn-s-taste    () (stn-node (stn-t-sense) 6))
  (defn stn-s-sight    () (stn-node (stn-t-sense) 7))
  (defn stn-s-warmth   () (stn-node (stn-t-sense) 8))
  (defn stn-s-hearing  () (stn-node (stn-t-sense) 9))
  (defn stn-s-word     () (stn-node (stn-t-sense) 10))
  (defn stn-s-thought  () (stn-node (stn-t-sense) 11))
  (defn stn-s-i-sense  () (stn-node (stn-t-sense) 12))

  (defn stn-g-own-body    () (stn-node (stn-t-group) 1))
  (defn stn-g-outer-world () (stn-node (stn-t-group) 2))
  (defn stn-g-other-being () (stn-node (stn-t-group) 3))

  (defn stn-awake    () (stn-node (stn-t-state) 1))
  (defn stn-dreaming () (stn-node (stn-t-state) 2))
  (defn stn-asleep   () (stn-node (stn-t-state) 3))

  ;; ── relations ───────────────────────────────────────────────────
  (defn stn-has-member  () (stn-node (stn-t-relation) 1))
  (defn stn-in-state    () (stn-node (stn-t-relation) 2))
  (defn stn-in-group    () (stn-node (stn-t-relation) 3))
  (defn stn-mediates    () (stn-node (stn-t-relation) 4))
  (defn stn-corresponds () (stn-node (stn-t-relation) 5))
  (defn stn-requires    () (stn-node (stn-t-relation) 6))

  ;; ── works, as evidence nodes ────────────────────────────────────
  (defn stn-w-freiheit  () (stn-node (stn-t-work) 1))   ; 1894
  (defn stn-w-theosophie () (stn-node (stn-t-work) 2))  ; 1904
  (defn stn-w-erkenntnisse () (stn-node (stn-t-work) 3)); 1904
  (defn stn-w-seelenraetseln () (stn-node (stn-t-work) 4)) ; 1917
  (defn stn-w-kernpunkte () (stn-node (stn-t-work) 5))  ; 1919
  (defn stn-w-lu-ah-cycle () (stn-node (stn-t-work) 6)) ; 1919, GA 191/193
  (defn stn-w-sinne-lectures () (stn-node (stn-t-work) 7)) ; 1909
  (defn stn-w-karma-cycles () (stn-node (stn-t-work) 8)) ; 1924

  (defn stn-fact (s r o e n) (list s r o e n))
  (defn stn-f-subject  (f) (nth f 0))
  (defn stn-f-relation (f) (nth f 1))
  (defn stn-f-object   (f) (nth f 2))
  (defn stn-f-evidence (f) (nth f 3))
  (defn stn-f-order    (f) (nth f 4))

  ;; ── the fundamentals, as facts ──────────────────────────────────
  (defn stn-soul-facts ()
    (list
      (stn-fact (stn-threefold-soul) (stn-has-member) (stn-thinking) (stn-w-seelenraetseln) 1)
      (stn-fact (stn-threefold-soul) (stn-has-member) (stn-feeling)  (stn-w-seelenraetseln) 2)
      (stn-fact (stn-threefold-soul) (stn-has-member) (stn-willing)  (stn-w-seelenraetseln) 3)
      (stn-fact (stn-thinking) (stn-in-state) (stn-awake)    (stn-w-seelenraetseln) 1)
      (stn-fact (stn-feeling)  (stn-in-state) (stn-dreaming) (stn-w-seelenraetseln) 2)
      (stn-fact (stn-willing)  (stn-in-state) (stn-asleep)   (stn-w-seelenraetseln) 3)))

  (defn stn-being-facts ()
    (list
      (stn-fact (stn-fourfold-being) (stn-has-member) (stn-physical) (stn-w-theosophie) 1)
      (stn-fact (stn-fourfold-being) (stn-has-member) (stn-etheric)  (stn-w-theosophie) 2)
      (stn-fact (stn-fourfold-being) (stn-has-member) (stn-astral)   (stn-w-theosophie) 3)
      (stn-fact (stn-fourfold-being) (stn-has-member) (stn-i)        (stn-w-theosophie) 4)))

  (defn stn-sense-facts ()
    (list
      (stn-fact (stn-s-touch)    (stn-in-group) (stn-g-own-body)    (stn-w-sinne-lectures) 1)
      (stn-fact (stn-s-life)     (stn-in-group) (stn-g-own-body)    (stn-w-sinne-lectures) 2)
      (stn-fact (stn-s-movement) (stn-in-group) (stn-g-own-body)    (stn-w-sinne-lectures) 3)
      (stn-fact (stn-s-balance)  (stn-in-group) (stn-g-own-body)    (stn-w-sinne-lectures) 4)
      (stn-fact (stn-s-smell)    (stn-in-group) (stn-g-outer-world) (stn-w-sinne-lectures) 5)
      (stn-fact (stn-s-taste)    (stn-in-group) (stn-g-outer-world) (stn-w-sinne-lectures) 6)
      (stn-fact (stn-s-sight)    (stn-in-group) (stn-g-outer-world) (stn-w-sinne-lectures) 7)
      (stn-fact (stn-s-warmth)   (stn-in-group) (stn-g-outer-world) (stn-w-sinne-lectures) 8)
      (stn-fact (stn-s-hearing)  (stn-in-group) (stn-g-other-being) (stn-w-sinne-lectures) 9)
      (stn-fact (stn-s-word)     (stn-in-group) (stn-g-other-being) (stn-w-sinne-lectures) 10)
      (stn-fact (stn-s-thought)  (stn-in-group) (stn-g-other-being) (stn-w-sinne-lectures) 11)
      (stn-fact (stn-s-i-sense)  (stn-in-group) (stn-g-other-being) (stn-w-sinne-lectures) 12)))

  (defn stn-polarity-facts ()
    (list
      (stn-fact (stn-polarity) (stn-has-member) (stn-lucifer) (stn-w-lu-ah-cycle) 1)
      (stn-fact (stn-polarity) (stn-has-member) (stn-ahriman) (stn-w-lu-ah-cycle) 2)
      (stn-fact (stn-christ) (stn-mediates) (stn-polarity)    (stn-w-lu-ah-cycle) 3)))

  (defn stn-social-facts ()
    (list
      (stn-fact (stn-threefold-social) (stn-has-member) (stn-spirit-sphere)  (stn-w-kernpunkte) 1)
      (stn-fact (stn-threefold-social) (stn-has-member) (stn-rights-sphere)  (stn-w-kernpunkte) 2)
      (stn-fact (stn-threefold-social) (stn-has-member) (stn-economy-sphere) (stn-w-kernpunkte) 3)
      (stn-fact (stn-spirit-sphere)  (stn-corresponds) (stn-liberty)    (stn-w-kernpunkte) 1)
      (stn-fact (stn-rights-sphere)  (stn-corresponds) (stn-equality)   (stn-w-kernpunkte) 2)
      (stn-fact (stn-economy-sphere) (stn-corresponds) (stn-fraternity) (stn-w-kernpunkte) 3)))

  (defn stn-path-facts ()
    (list
      (stn-fact (stn-freedom) (stn-requires) (stn-moral-imagination) (stn-w-freiheit) 1)
      (stn-fact (stn-knowledge-path) (stn-requires) (stn-awake) (stn-w-erkenntnisse) 1)
      (stn-fact (stn-karma) (stn-requires) (stn-reincarnation) (stn-w-karma-cycles) 1)
      (stn-fact (stn-eurythmy) (stn-requires) (stn-willing) (stn-w-seelenraetseln) 1)))

  (defn stn-app (a b) (if (eq (len a) 0) b (cons (head a) (stn-app (tail a) b))))
  (defn stn-facts ()
    (stn-app (stn-soul-facts)
      (stn-app (stn-being-facts)
        (stn-app (stn-sense-facts)
          (stn-app (stn-polarity-facts)
            (stn-app (stn-social-facts) (stn-path-facts)))))))
  (defn stn-fact-count () (len (stn-facts)))

  ;; ── NL surfaces: en and de, registered per node ─────────────────
  ;; The identity is the number above; these are projections of it.
  (defn stn-sur (node en de) (list node en de))
  (defn stn-surfaces ()
    (list
      (stn-sur (stn-threefold-soul) "the threefold soul" "die Dreigliederung der Seele")
      (stn-sur (stn-fourfold-being) "the fourfold human being" "der viergliedrige Mensch")
      (stn-sur (stn-twelve-senses) "the twelve senses" "die zwoelf Sinne")
      (stn-sur (stn-polarity) "the two-pole opposition" "die zwei Gegenmaechte")
      (stn-sur (stn-threefold-social) "the threefold social order" "die soziale Dreigliederung")
      (stn-sur (stn-freedom) "freedom" "die Freiheit")
      (stn-sur (stn-knowledge-path) "the path of knowledge" "der Erkenntnisweg")
      (stn-sur (stn-reincarnation) "reincarnation" "die Wiederverkoerperung")
      (stn-sur (stn-karma) "karma" "das Karma")
      (stn-sur (stn-eurythmy) "eurythmy" "die Eurythmie")
      (stn-sur (stn-thinking) "thinking" "das Denken")
      (stn-sur (stn-feeling) "feeling" "das Fuehlen")
      (stn-sur (stn-willing) "willing" "das Wollen")
      (stn-sur (stn-physical) "the physical body" "der physische Leib")
      (stn-sur (stn-etheric) "the etheric body" "der Aetherleib")
      (stn-sur (stn-astral) "the astral body" "der Astralleib")
      (stn-sur (stn-i) "the I" "das Ich")
      (stn-sur (stn-lucifer) "Lucifer" "Luzifer")
      (stn-sur (stn-ahriman) "Ahriman" "Ahriman")
      (stn-sur (stn-christ) "Christ" "Christus")
      (stn-sur (stn-spirit-sphere) "spiritual life" "das Geistesleben")
      (stn-sur (stn-rights-sphere) "the life of rights" "das Rechtsleben")
      (stn-sur (stn-economy-sphere) "economic life" "das Wirtschaftsleben")
      (stn-sur (stn-liberty) "liberty" "die Freiheit")
      (stn-sur (stn-equality) "equality" "die Gleichheit")
      (stn-sur (stn-fraternity) "fraternity" "die Bruederlichkeit")
      (stn-sur (stn-moral-imagination) "moral imagination" "die moralische Phantasie")
      (stn-sur (stn-s-touch) "touch" "der Tastsinn")
      (stn-sur (stn-s-life) "the life sense" "der Lebenssinn")
      (stn-sur (stn-s-movement) "the sense of self-movement" "der Bewegungssinn")
      (stn-sur (stn-s-balance) "the sense of balance" "der Gleichgewichtssinn")
      (stn-sur (stn-s-smell) "smell" "der Geruchssinn")
      (stn-sur (stn-s-taste) "taste" "der Geschmackssinn")
      (stn-sur (stn-s-sight) "sight" "der Sehsinn")
      (stn-sur (stn-s-warmth) "the warmth sense" "der Waermesinn")
      (stn-sur (stn-s-hearing) "hearing" "der Gehoersinn")
      (stn-sur (stn-s-word) "the word sense" "der Wortsinn")
      (stn-sur (stn-s-thought) "the thought sense" "der Gedankensinn")
      (stn-sur (stn-s-i-sense) "the I-sense" "der Ichsinn")
      (stn-sur (stn-g-own-body) "one's own body" "den eigenen Leib")
      (stn-sur (stn-g-outer-world) "the outer world" "die Aussenwelt")
      (stn-sur (stn-g-other-being) "another being" "ein anderes Wesen")
      (stn-sur (stn-awake) "awake" "wach")
      (stn-sur (stn-dreaming) "dreaming" "traeumend")
      (stn-sur (stn-asleep) "asleep" "schlafend")
      (stn-sur (stn-has-member) "has as member" "hat als Glied")
      (stn-sur (stn-in-state) "is in the state" "ist im Zustand")
      (stn-sur (stn-in-group) "perceives" "nimmt wahr")
      (stn-sur (stn-mediates) "mediates" "vermittelt")
      (stn-sur (stn-corresponds) "corresponds to" "entspricht")
      (stn-sur (stn-requires) "requires" "erfordert")
      (stn-sur (stn-w-freiheit) "Die Philosophie der Freiheit 1894" "Die Philosophie der Freiheit 1894")
      (stn-sur (stn-w-theosophie) "Theosophie 1904" "Theosophie 1904")
      (stn-sur (stn-w-erkenntnisse) "Wie erlangt man Erkenntnisse der hoeheren Welten 1904" "Wie erlangt man Erkenntnisse der hoeheren Welten 1904")
      (stn-sur (stn-w-seelenraetseln) "Von Seelenraetseln 1917" "Von Seelenraetseln 1917")
      (stn-sur (stn-w-kernpunkte) "Die Kernpunkte der sozialen Frage 1919" "Die Kernpunkte der sozialen Frage 1919")
      (stn-sur (stn-w-lu-ah-cycle) "the Lucifer/Ahriman cycle GA 191 and GA 193, 1919" "der Luzifer/Ahriman-Zyklus GA 191 und GA 193, 1919")
      (stn-sur (stn-w-sinne-lectures) "the sense lectures from 1909" "die Sinnesvortraege ab 1909")
      (stn-sur (stn-w-karma-cycles) "the karma cycles GA 235-240, 1924" "die Karma-Vortraege GA 235-240, 1924")))

  (defn stn-sur-node (r) (nth r 0))
  (defn stn-find-loop (rs n)
    (if (eq (len rs) 0) (nothing)
      (if (eq (stn-sur-node (head rs)) n) (head rs) (stn-find-loop (tail rs) n))))
  ;; an unregistered locale yields nothing, never a fallback to English
  (defn stn-nl-surface (locale node)
    (do (let row (stn-find-loop (stn-surfaces) node))
      (if (nothing? row) (nothing)
        (if (str_eq locale "en") (nth row 1)
          (if (str_eq locale "de") (nth row 2) (nothing))))))

  (defn stn-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (stn-cat (tail xs)))))

  ;; ── NL realization ──────────────────────────────────────────────
  ;; A normalized projection of the fact, not a claim of literary translation.
  (defn stn-render-nl (locale f)
    (do
      (let s (stn-nl-surface locale (stn-f-subject f)))
      (let r (stn-nl-surface locale (stn-f-relation f)))
      (let o (stn-nl-surface locale (stn-f-object f)))
      (let e (stn-nl-surface locale (stn-f-evidence f)))
      (if (or (nothing? s) (or (nothing? r) (or (nothing? o) (nothing? e))))
        (nothing)
        (stn-cat (list s " " r " " o " [" e "]")))))

  ;; ── PL realization: data, never fabricated behaviour ────────────
  (defn stn-render-form (f)
    (stn-cat (list "(list " (int_to_str (stn-f-subject f)) " "
      (int_to_str (stn-f-relation f)) " " (int_to_str (stn-f-object f)) " "
      (int_to_str (stn-f-evidence f)) " " (int_to_str (stn-f-order f)) ")")))
  (defn stn-render-python (f)
    (stn-cat (list "(" (int_to_str (stn-f-subject f)) ", "
      (int_to_str (stn-f-relation f)) ", " (int_to_str (stn-f-object f)) ", "
      (int_to_str (stn-f-evidence f)) ", " (int_to_str (stn-f-order f)) ")")))
  (defn stn-render-json (f)
    (stn-cat (list "{\"s\":" (int_to_str (stn-f-subject f))
      ",\"r\":" (int_to_str (stn-f-relation f))
      ",\"o\":" (int_to_str (stn-f-object f))
      ",\"e\":" (int_to_str (stn-f-evidence f))
      ",\"n\":" (int_to_str (stn-f-order f)) "}")))
  (defn stn-render-pl (language f)
    (if (str_eq language "form") (stn-render-form f)
      (if (str_eq language "python") (stn-render-python f)
        (if (str_eq language "json") (stn-render-json f) (nothing)))))

  ;; plane 1 = natural language, plane 2 = programming language
  (defn stn-render (plane target f)
    (if (eq plane 1) (stn-render-nl target f)
      (if (eq plane 2) (stn-render-pl target f) (nothing))))

  ;; ── structural readings ─────────────────────────────────────────
  (defn stn-group-count-loop (fs g)
    (if (eq (len fs) 0) 0
      (add (if (eq (stn-f-object (head fs)) g)
             (if (eq (stn-f-relation (head fs)) (stn-in-group)) 1 0) 0)
           (stn-group-count-loop (tail fs) g))))
  (defn stn-senses-in (g) (stn-group-count-loop (stn-facts) g))

  (defn stn-surfaced-loop (fs locale)
    (if (eq (len fs) 0) 1
      (if (nothing? (stn-render-nl locale (head fs))) 0
        (stn-surfaced-loop (tail fs) locale))))
  ;; every fact renders in a registered locale — no hole in the surface table
  (defn stn-fully-surfaced? (locale) (stn-surfaced-loop (stn-facts) locale))

  ;; Structure and projection remain separate claims, and both now cross the
  ;; four execution arms. The core supplies the same third-value observation
  ;; on the full siblings that fkwu and the minimal walkers carry directly.
  (defn stn-surface-count () (len (stn-surfaces)))
  (defn stn-well-formed-loop (fs)
    (if (eq (len fs) 0) 1
      (if (eq (len (head fs)) 5) (stn-well-formed-loop (tail fs)) 0)))
  (defn stn-well-formed? () (stn-well-formed-loop (stn-facts)))

  ;; PURE STRUCTURE — no NL or PL spelling reaches these, and no fkwu-only op
  (defn stn-check-structure ()
    (add (if (eq (stn-fact-count) 35) 1 0)
    (add (if (eq (stn-senses-in (stn-g-own-body)) 4) 2 0)
    (add (if (eq (stn-senses-in (stn-g-outer-world)) 4) 4 0)
    (add (if (eq (stn-senses-in (stn-g-other-being)) 4) 8 0)
    (add (if (eq (stn-christ) (stn-node (stn-t-member) 10)) 16 0)
    (add (if (gt (str_len (stn-render-python (head (stn-facts)))) 10) 32 0)
    (add (if (gt (str_len (stn-render-form (head (stn-facts)))) 10) 64 0)
    (add (if (eq (stn-well-formed?) 1) 128 0)
    (add (if (eq (stn-surface-count) 59) 256 0)
         0))))))))))

  ;; PROJECTIONS — fkwu only, because every refusal below answers `nothing`
  (defn stn-check-projection ()
    (add (if (eq (stn-fully-surfaced? "en") 1) 1 0)
    (add (if (eq (stn-fully-surfaced? "de") 1) 2 0)
    (add (if (nothing? (stn-render-nl "sw" (head (stn-facts)))) 4 0)
    (add (if (nothing? (stn-render-pl "rust" (head (stn-facts)))) 8 0)
    (add (if (nothing? (stn-render 3 "en" (head (stn-facts)))) 16 0)
         0))))))

  0)
