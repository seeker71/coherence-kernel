; native-neutral-dictionary.fk — corpus-learned, language-neutral concept graph.
;
; Identity and responses contain integers only. Source spellings are evidence used
; to rank concepts; they are never keys.  Each admitted rank has reciprocal
; predecessor/successor edges. Inquiry roots are numeric and universal:
;   0 what, 1 where, 2 when, 3 who, 4 how, 5 which, 6 why.
; A root is not a ceiling: [root, depth, relation...] is a composable lane
; path. Every admitted layer adds one relationship depth to every root.
; The body is reread on every run.  Nothing below contains a dictionary row.
; witnessed: 2026-07-21 -> four fresh native processes, no rebuild between:
;   nodes 0->111,  edges 220,  seven-root depth 1 coverage 0->777, success 1
;   nodes 111->333, edges 664, seven-root depth 2 coverage 777->4662, success 1
;   nodes 333->999, edges 1996, seven-root depth 3 coverage 4662->20979, success 1
;   nodes 999->999, edges 1996, re-witness coverage 20979->20979, success 1

(do
  (defn nnd-slice-loop (s i end acc)
    (if (ge i end) acc
      (nnd-slice-loop s (add i 1) end
        (str_concat acc (byte_to_str (str_byte_at s i))))))
  (defn nnd-slice (s start end) (nnd-slice-loop s start end ""))
  (defn nnd-delim? (b)
    (or (le b 32)
      (or (eq b 34) (or (eq b 35) (or (eq b 39)
      (or (eq b 40) (or (eq b 41) (or (eq b 42)
      (or (eq b 44) (or (eq b 45) (or (eq b 46)
      (or (eq b 47) (or (eq b 58) (or (eq b 59)
      (or (eq b 60) (or (eq b 61) (or (eq b 62)
      (or (eq b 91) (or (eq b 92) (or (eq b 93)
          (or (eq b 96) (or (eq b 123) (or (eq b 124) (eq b 125))))))))))))))))))))))))

  (defn nnd-lower-byte (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn nnd-normalize-loop (s i acc)
    (if (ge i (str_len s)) acc
      (do (let b (str_byte_at s i))
          (nnd-normalize-loop s (add i 1)
            (str_concat acc (byte_to_str (if (nnd-delim? b) 32 (nnd-lower-byte b))))))))
  (defn nnd-normalize (s) (nnd-normalize-loop s 0 ""))

  (defn nnd-tokens-loop (s i start acc)
    (if (ge i (str_len s))
      (if (gt i start) (cons (nnd-slice s start i) acc) acc)
      (if (eq (str_byte_at s i) 32)
        (nnd-tokens-loop s (add i 1) (add i 1)
          (if (gt i start) (cons (nnd-slice s start i) acc) acc))
        (nnd-tokens-loop s (add i 1) start acc))))
  (defn nnd-reverse-loop (xs acc)
    (if (eq (len xs) 0) acc (nnd-reverse-loop (tail xs) (cons (head xs) acc))))
  (defn nnd-reverse (xs) (nnd-reverse-loop xs (list)))
  (defn nnd-tokens (s) (nnd-reverse (nnd-tokens-loop (nnd-normalize s) 0 0 (list))))

  ; row = spelling, count, first-seen. Spelling is discarded from responses.
  (defn nnd-inc-row (row) (list (nth row 0) (add (nth row 1) 1) (nth row 2)))
  (defn nnd-count-one (rows word first)
    (if (eq (len rows) 0) (list (list word 1 first))
      (if (str_eq word (nth (head rows) 0))
        (cons (nnd-inc-row (head rows)) (tail rows))
        (cons (head rows) (nnd-count-one (tail rows) word first)))))
  (defn nnd-count-loop (words rows i)
    (if (eq (len words) 0) rows
      (nnd-count-loop (tail words) (nnd-count-one rows (head words) i) (add i 1))))

  (defn nnd-before? (a b)
    (if (gt (nth a 1) (nth b 1)) 1
      (if (lt (nth a 1) (nth b 1)) 0 (if (lt (nth a 2) (nth b 2)) 1 0))))
  (defn nnd-insert-ranked (row rows)
    (if (eq (len rows) 0) (list row)
      (if (eq (nnd-before? row (head rows)) 1) (cons row rows)
        (cons (head rows) (nnd-insert-ranked row (tail rows))))))
  (defn nnd-rank-loop (rows ranked)
    (if (eq (len rows) 0) ranked
      (nnd-rank-loop (tail rows) (nnd-insert-ranked (head rows) ranked))))
  (defn nnd-take (xs n)
    (if (or (le n 0) (eq (len xs) 0)) (list)
      (cons (head xs) (nnd-take (tail xs) (sub n 1)))))

  (defn nnd-parse-int-loop (s i acc)
    (if (ge i (str_len s)) acc
      (do (let b (str_byte_at s i))
          (if (and (ge b 48) (le b 57))
            (nnd-parse-int-loop s (add i 1) (add (mul acc 10) (sub b 48)))
            acc))))
  (defn nnd-parse-int (s) (nnd-parse-int-loop s 0 0))
  (defn nnd-nat-text (n)
    (if (lt n 10) (byte_to_str (add 48 n))
      (str_concat (nnd-nat-text (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (defn nnd-next-size (n) (if (lt n 111) 111 (if (lt n 333) 333 (if (lt n 999) 999 999))))
  (defn nnd-round (n) (if (le n 111) 1 (if (le n 333) 2 (if (le n 999) 3 4))))

  ; edge = source-id, relation-code, target-id. Every edge has an inverse.
  (defn nnd-edges-loop (i n acc)
    (if (ge i n) acc
      (nnd-edges-loop (add i 1) n
        (cons (list i 2 (add i 1)) (cons (list (add i 1) 1 i) acc)))))
  (defn nnd-edge-exists? (edges s r t)
    (if (eq (len edges) 0) 0
      (if (and (eq (nth (head edges) 0) s)
               (and (eq (nth (head edges) 1) r) (eq (nth (head edges) 2) t))) 1
        (nnd-edge-exists? (tail edges) s r t))))
  (defn nnd-edges-valid? (edges all n)
    (if (eq (len edges) 0) 1
      (do (let e (head edges))
          (let s (nth e 0)) (let r (nth e 1)) (let t (nth e 2))
          (if (and (ge s 1) (and (le s n) (and (ge t 1) (le t n))))
            (if (eq r 1)
              (if (eq (nnd-edge-exists? all t 2 s) 1) (nnd-edges-valid? (tail edges) all n) 0)
              (if (eq r 2)
                (if (eq (nnd-edge-exists? all t 1 s) 1) (nnd-edges-valid? (tail edges) all n) 0)
                0)) 0))))

  ; Language-neutral response: [lane, subject-id, numeric evidence...].
  ; row is [surface-evidence, frequency, first-seen]; the surface never crosses.
  ; provenance-set 1 = this cell's declared seven-file public-body corpus.
  ; method 1 = native frequency rank; edge-kind 1 = reciprocal rank-neighbor.
  (defn nnd-inquire (lane id n layer rows)
    (if (or (lt id 1) (gt id n)) (list)
      (do (let row (nth rows (sub id 1)))
        (let freq (nth row 1))
        (let first (nth row 2))
        (if (eq lane 0) (list 0 id freq)
        (if (eq lane 1)
          (if (eq id 1) (list 1 id 0 2)
            (if (eq id n) (list 1 id (sub id 1) 0)
              (list 1 id (sub id 1) (add id 1))))
        (if (eq lane 2) (list 2 id layer)
        (if (eq lane 3) (list 3 id 1)
        (if (eq lane 4) (list 4 id 1 first)
        (if (eq lane 5) (list 5 id id n)
        (if (eq lane 6)
          (list 6 id freq (if (or (eq id 1) (eq id n)) 1 2) 1)
          (list)))))))))))
  (defn nnd-lane-covered (lane id n)
    (if (and (ge lane 0) (and (le lane 6) (and (ge id 1) (le id n)))) 1 0))
  (defn nnd-max (a b) (if (gt a b) a b))
  (defn nnd-min (a b) (if (lt a b) a b))
  ; A depth response adds the reachable graph interval to the root answer.
  ; depth has no hard maximum; the current learned layer chooses how far it grows.
  (defn nnd-inquire-depth (root id n layer rows depth)
    (if (lt depth 1) (list)
      (list root depth id (nnd-max 1 (sub id depth))
            (nnd-min n (add id depth))
            (nnd-inquire root id n layer rows))))
  ; Seven validated roots × every admitted node × every learned depth.
  (defn nnd-coverage (n depth) (mul n (mul 7 depth)))

  (defn nnd-corpus ()
    (str_concat (read_file "README.md")
    (str_concat (read_file "WELCOME.md")
    (str_concat (read_file "HOMECOMING.md")
    (str_concat (read_file "axioms/core-axioms.form")
    (str_concat (read_file "teachings/uplifting-dialogue.md")
    (str_concat (read_file "teachings/concepts/lc-edges-as-vitality.md")
                (read_file "teachings/concepts/lc-whole-vitality.md"))))))))

  (let counts (nnd-count-loop (nnd-tokens (nnd-corpus)) (list) 0))
  (let ranked (nnd-rank-loop counts (list)))
  (let available (len (nnd-take ranked 999)))
  (let before (nnd-parse-int (read_file ".form-native-neutral-dictionary.state")))
  (let target (nnd-next-size before))
  (let n (if (lt available target) available target))
  (let layer (nnd-round n))
  (let edges (nnd-edges-loop 1 n (list)))
  (let valid (if (and (eq n target) (eq (nnd-edges-valid? edges edges n) 1)) 1 0))
  (let coverage-before (if (gt before 0) (nnd-coverage before (nnd-round before)) 0))
  (let coverage-after (nnd-coverage n layer))
  (let saved (write_file ".form-native-neutral-dictionary.state" (nnd-nat-text n)))
  (let grew (if (gt n before) 1 0))
  (let witnessed (if (and (eq n 999) (eq before 999)) 1 0))
  ; [round, nodes-before, nodes-after, reciprocal-edges, all-valid,
  ;  coverage-before, coverage-after, bytes-written, grew-or-rewitnessed,
  ;  neutral sample response, success]
  (list layer before n (len edges) valid coverage-before coverage-after saved
        (if (or (eq grew 1) (eq witnessed 1)) 1 0)
        (nnd-inquire-depth 6 (if (lt n 500) n 500) n layer ranked layer)
        (if (and (eq valid 1)
                 (and (ge coverage-after coverage-before)
                      (or (eq grew 1) (eq witnessed 1)))) 1 0)))
