; session-neutral-semantic-reflection.fk — reflect and internally rebase the
; small neutral dictionary that actual sessions touch.
;
; The 130,000-cell lexical table is a supply/index audit only; it does not
; participate in the internal verdict. Internal truth begins with arriving
; token rows. Reflection turns every
; candidate into an active entry without selecting one sense. Rebasing refreshes
; every surface/expression scope seen in the new turn, retains scopes that did
; not reappear, and removes stale candidates for scopes that did. This permits
; revision and growth; it is not byte-rigid append-only memory.
;
; An active entry keeps the complete candidate record, so definitions, source,
; occurrence frequency, sense count, field evidence, and the numeric expression
; facet remain queryable. Surface -> candidates and neutral address -> witnessed
; surfaces are exact reverse doors over the same active body.
;
; witnessed: 2026-08-24 -> two-turn reflection/rebase band 32767 on fkwu
; preludes: cognition/session-neutral-semantic-frequency.fk

(do
  ; entry = locale, surface, kind, token-state, expression-symbol, candidate.
  (defn snsr-entry (token candidate)
    (list (snsf-t-locale token) (snsf-t-surface token) (snsf-t-kind token)
      (snsf-t-state token) (snsf-t-expression-case token) candidate))
  (defn snsr-e-locale (entry) (nth entry 0))
  (defn snsr-e-surface (entry) (nth entry 1))
  (defn snsr-e-kind (entry) (nth entry 2))
  (defn snsr-e-state (entry) (nth entry 3))
  (defn snsr-e-expression (entry) (nth entry 4))
  (defn snsr-e-candidate (entry) (nth entry 5))
  (defn snsr-e-address (entry) (snsf-c-address (snsr-e-candidate entry)))

  (defn snsr-reflect-candidates (token candidates)
    (if (eq (len candidates) 0) (empty)
      (cons (snsr-entry token (head candidates))
        (snsr-reflect-candidates token (tail candidates)))))
  (defn snsr-reflect (rows)
    (if (eq (len rows) 0) (empty)
      (append (snsr-reflect-candidates (head rows)
                (snsf-t-candidates (head rows)))
        (snsr-reflect (tail rows)))))

  ; A scope is one exact locale/surface/expression arrival. Candidate identity
  ; is deliberately outside the scope so a later reflection may replace the
  ; candidate set without erasing unrelated surfaces.
  (defn snsr-same-scope? (a b)
    (if (and (str_eq (snsr-e-locale a) (snsr-e-locale b))
             (and (str_eq (snsr-e-surface a) (snsr-e-surface b))
                  (eq (snsf-expression-code (snsr-e-expression a))
                      (snsf-expression-code (snsr-e-expression b))))) 1 0))
  (defn snsr-same-entry? (a b)
    (if (and (eq (snsr-same-scope? a b) 1)
             (value_eq (snsr-e-address a) (snsr-e-address b))) 1 0))
  (defn snsr-entry-in? (wanted entries)
    (if (eq (len entries) 0) 0
      (if (eq (snsr-same-entry? wanted (head entries)) 1) 1
        (snsr-entry-in? wanted (tail entries)))))
  (defn snsr-scope-in? (wanted entries)
    (if (eq (len entries) 0) 0
      (if (eq (snsr-same-scope? wanted (head entries)) 1) 1
        (snsr-scope-in? wanted (tail entries)))))
  (defn snsr-unique-loop (entries out)
    (if (eq (len entries) 0) (reverse out)
      (snsr-unique-loop (tail entries)
        (if (eq (snsr-entry-in? (head entries) out) 1) out
          (cons (head entries) out)))))
  (defn snsr-unique (entries) (snsr-unique-loop entries (empty)))
  (defn snsr-all-unique? (entries)
    (eq (len entries) (len (snsr-unique entries))))

  (defn snsr-retain-unreflected (active reflected)
    (if (eq (len active) 0) (empty)
      (if (eq (snsr-scope-in? (head active) reflected) 1)
        (snsr-retain-unreflected (tail active) reflected)
        (cons (head active)
          (snsr-retain-unreflected (tail active) reflected)))))
  (defn snsr-rebase-reflection (active reflected)
    (do
      (let incoming (snsr-unique reflected))
      (append (snsr-retain-unreflected active incoming) incoming)))
  (defn snsr-rebase (active rows)
    (snsr-rebase-reflection active (snsr-reflect rows)))

  ; receipt = rebased active, before, reflected, retained, after.
  (defn snsr-rebase-receipt (active rows)
    (do
      (let reflected (snsr-unique (snsr-reflect rows)))
      (let retained (snsr-retain-unreflected active reflected))
      (let rebased (append retained reflected))
      (list rebased (len active) (len reflected) (len retained) (len rebased))))
  (defn snsr-r-active (receipt) (nth receipt 0))
  (defn snsr-r-before (receipt) (nth receipt 1))
  (defn snsr-r-reflected (receipt) (nth receipt 2))
  (defn snsr-r-retained (receipt) (nth receipt 3))
  (defn snsr-r-after (receipt) (nth receipt 4))

  (defn snsr-by-surface (active locale surface)
    (if (eq (len active) 0) (empty)
      (if (and (str_eq locale (snsr-e-locale (head active)))
               (str_eq surface (snsr-e-surface (head active))))
        (cons (head active) (snsr-by-surface (tail active) locale surface))
        (snsr-by-surface (tail active) locale surface))))
  (defn snsr-by-address (active address)
    (if (eq (len active) 0) (empty)
      (if (value_eq address (snsr-e-address (head active)))
        (cons (head active) (snsr-by-address (tail active) address))
        (snsr-by-address (tail active) address))))

  (defn snsr-candidate-total (rows)
    (if (eq (len rows) 0) 0
      (add (len (snsf-t-candidates (head rows)))
        (snsr-candidate-total (tail rows)))))
  (defn snsr-entry-valid? (entry)
    (do
      (let candidate (snsr-e-candidate entry))
      (let field (snsf-c-field candidate))
      (if (and (gt (str_len (snsr-e-locale entry)) 0)
               (and (gt (str_len (snsr-e-surface entry)) 0)
               (and (eq (len (snsr-e-expression entry)) 3)
               (and (eq (len (snsr-e-address entry)) 3)
                    (or (eq (len field) 0)
                        (eq (len field) (fwf-axis-count))))))) 1 0)))
  (defn snsr-entries-valid? (entries)
    (if (eq (len entries) 0) 1
      (if (eq (snsr-entry-valid? (head entries)) 1)
        (snsr-entries-valid? (tail entries)) 0)))
  (defn snsr-reflection-valid? (rows)
    (do
      (let reflected (snsr-reflect rows))
      (let unique (snsr-unique reflected))
      (if (and (eq (len reflected) (snsr-candidate-total rows))
               (and (eq (snsr-entries-valid? reflected) 1)
               (and (eq (snsr-all-in? reflected unique) 1)
                    (eq (snsr-all-unique? unique) 1)))) 1 0)))
  (defn snsr-all-in? (wanted available)
    (if (eq (len wanted) 0) 1
      (if (eq (snsr-entry-in? (head wanted) available) 1)
        (snsr-all-in? (tail wanted) available) 0)))
  (defn snsr-rebase-valid? (active rows rebased)
    (do
      (let reflected (snsr-unique (snsr-reflect rows)))
      (let retained (snsr-retain-unreflected active reflected))
      (if (and (eq (snsr-all-unique? rebased) 1)
               (and (eq (snsr-all-in? reflected rebased) 1)
                    (and (eq (snsr-all-in? retained rebased) 1)
                         (eq (len rebased)
                             (add (len retained) (len reflected)))))) 1 0)))

  ; Internal witness: actual rows and the rebased active body only. No corpus
  ; cardinality participates in this verdict.
  (defn snsr-internal-witness (active rows)
    (do
      (let rebased (snsr-rebase active rows))
      (add (if (eq (snsr-reflection-valid? rows) 1) 1 0)
        (add (if (eq (snsr-rebase-valid? active rows rebased) 1) 2 0)
          (if (eq (snsr-entries-valid? rebased) 1) 4 0)))))

  0)
