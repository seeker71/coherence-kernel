; session-neutral-micro-thought.fk — recorded event variation composes small
; neutral meaning recipes, then the existing realization organ returns them to
; natural-language surfaces.
;
; The thirteen core field symbols are the alphabet. A draw never defines or
; ranks a symbol; it only proposes a two-to-four-symbol composition. Each round
; retains every proposal and selects the proposal with the greatest visible
; change from the prior recipe. The recorded draw makes the result exactly
; replayable. Natural-language labels are generated after selection and do not
; participate in neutral identity.
;
; This cell is deterministic. A caller may supply recorded entropy, an arrival
; event, or a chosen seed. The live witness uses an arrival-time-seeded xorshift
; stream because the direct-source runner does not expose the kernel's tag-16
; entropy organ as a source primitive. It is named pseudo-random, not mistaken
; for independent physical entropy.
;
; witnessed: 2026-08-24 -> micro-thought band 32767 on fkwu
; preludes: cognition/session-neutral-meaning-realization.fk

(do
  (defn snmt-field-count () (fwf-axis-count))
  (defn snmt-positive (value) (band value 2147483647))
  (defn snmt-nonzero (value)
    (if (eq (snmt-positive value) 0) 108 (snmt-positive value)))

  ; A small replayable xorshift stream. The seed is an observed input, not
  ; hidden state. Every emitted draw stays in its event cell.
  (defn snmt-next-draw (value)
    (do
      (let x0 (snmt-nonzero value))
      (let x1 (bxor x0 (shl_u32 x0 13)))
      (let x2 (bxor x1 (shr_u32 x1 17)))
      (snmt-nonzero (bxor x2 (shl_u32 x2 5)))))
  (defn snmt-draw-stream-loop (value count out)
    (if (le count 0) (reverse out)
      (do
        (let next (snmt-next-draw value))
        (snmt-draw-stream-loop next (sub count 1) (cons next out)))))
  (defn snmt-draw-stream (seed count)
    (snmt-draw-stream-loop seed count (empty)))

  (defn snmt-field-address-valid? (address)
    (if (and (eq (len address) 3)
             (and (eq (nth address 0) 31013)
             (and (eq (nth address 1) 2)
                  (and (ge (nth address 2) 0)
                       (lt (nth address 2) (snmt-field-count)))))) 1 0))
  (defn snmt-field-addresses-loop (id)
    (if (ge id (snmt-field-count)) (empty)
      (cons (snsf-field-address id) (snmt-field-addresses-loop (add id 1)))))
  (defn snmt-field-addresses () (snmt-field-addresses-loop 0))
  (defn snmt-recipe-valid? (recipe)
    (if (or (lt (len recipe) 2) (gt (len recipe) 4)) 0
      (if (eq (len recipe) 0) 1
        (if (eq (snmt-field-address-valid? (head recipe)) 1)
          (if (eq (len (tail recipe)) 0) 1
            (snmt-recipe-valid-tail? (tail recipe))) 0))))
  (defn snmt-recipe-valid-tail? (recipe)
    (if (eq (len recipe) 0) 1
      (if (eq (snmt-field-address-valid? (head recipe)) 1)
        (snmt-recipe-valid-tail? (tail recipe)) 0)))

  (defn snmt-recipe-loop (value remaining out)
    (if (le remaining 0) (reverse out)
      (do
        (let next (snmt-next-draw value))
        (snmt-recipe-loop next (sub remaining 1)
          (cons (snsf-field-address (mod next (snmt-field-count))) out)))))
  (defn snmt-recipe-from-draw (draw)
    (snmt-recipe-loop draw (add 2 (mod (snmt-positive draw) 3)) (empty)))

  ; event = content address, recorded draw, neutral recipe, source lane.
  (defn snmt-event (draw)
    (do
      (let recorded (snmt-positive draw))
      (let recipe (snmt-recipe-from-draw recorded))
      (list (snsf-address 17 (list recorded recipe)) recorded recipe
        "recorded-event")))
  (defn snmt-e-address (event) (nth event 0))
  (defn snmt-e-draw (event) (nth event 1))
  (defn snmt-e-recipe (event) (nth event 2))
  (defn snmt-e-source (event) (nth event 3))
  (defn snmt-event-valid? (event)
    (if (and (eq (len event) 4)
             (and (eq (snmt-recipe-valid? (snmt-e-recipe event)) 1)
                  (str_eq (snmt-e-source event) "recorded-event"))) 1 0))

  (defn snmt-address-in? (wanted addresses)
    (if (eq (len addresses) 0) 0
      (if (value_eq wanted (head addresses)) 1
        (snmt-address-in? wanted (tail addresses)))))
  (defn snmt-novel-count-loop (previous current seen)
    (if (eq (len current) 0) 0
      (do
        (let address (head current))
        (add (if (and (eq (snmt-address-in? address previous) 0)
                      (eq (snmt-address-in? address seen) 0)) 1 0)
          (snmt-novel-count-loop previous (tail current)
            (cons address seen))))))
  (defn snmt-novel-count (previous current)
    (snmt-novel-count-loop previous current (empty)))
  (defn snmt-position-changes (previous current)
    (if (eq (len previous) 0) (len current)
      (if (eq (len current) 0) (len previous)
        (add (if (value_eq (head previous) (head current)) 0 1)
          (snmt-position-changes (tail previous) (tail current))))))
  (defn snmt-abs (value) (if (lt value 0) (sub 0 value) value))
  (defn snmt-turbulence (recipe)
    (if (lt (len recipe) 2) 0
      (add (fwf-wake-distance
              (fwf-wake-by-id (nth (head recipe) 2)
                (nth (head (tail recipe)) 2)))
        (snmt-turbulence (tail recipe)))))

  ; surprise = total, novel symbols, changed positions, length delta,
  ; previous turbulence, current turbulence, turbulence delta.
  (defn snmt-surprise (previous current)
    (do
      (let novel (snmt-novel-count previous current))
      (let positions (snmt-position-changes previous current))
      (let length-delta (snmt-abs (sub (len current) (len previous))))
      (let prior-turbulence (snmt-turbulence previous))
      (let current-turbulence (snmt-turbulence current))
      (let turbulence-delta
        (snmt-abs (sub current-turbulence prior-turbulence)))
      (list (add (mul novel 10000)
              (add (mul positions 3000)
                (add (mul length-delta 1000) turbulence-delta)))
        novel positions length-delta prior-turbulence current-turbulence
        turbulence-delta)))
  (defn snmt-s-total (surprise) (nth surprise 0))
  (defn snmt-s-novel (surprise) (nth surprise 1))
  (defn snmt-s-positions (surprise) (nth surprise 2))
  (defn snmt-s-length-delta (surprise) (nth surprise 3))
  (defn snmt-s-prior-turbulence (surprise) (nth surprise 4))
  (defn snmt-s-current-turbulence (surprise) (nth surprise 5))
  (defn snmt-s-turbulence-delta (surprise) (nth surprise 6))

  ; candidate = event, surprise relative to the prior selected recipe.
  (defn snmt-candidate (previous draw)
    (do
      (let event (snmt-event draw))
      (list event (snmt-surprise previous (snmt-e-recipe event)))))
  (defn snmt-c-event (candidate) (nth candidate 0))
  (defn snmt-c-surprise (candidate) (nth candidate 1))
  (defn snmt-c-score (candidate) (snmt-s-total (snmt-c-surprise candidate)))
  (defn snmt-candidates (previous draws)
    (if (eq (len draws) 0) (empty)
      (cons (snmt-candidate previous (head draws))
        (snmt-candidates previous (tail draws)))))
  (defn snmt-best-candidate (candidates best)
    (if (eq (len candidates) 0) best
      (snmt-best-candidate (tail candidates)
        (if (or (eq (len best) 0)
                (gt (snmt-c-score (head candidates)) (snmt-c-score best)))
          (head candidates) best))))
  (defn snmt-candidate-addresses (candidates)
    (if (eq (len candidates) 0) (empty)
      (cons (snmt-e-address (snmt-c-event (head candidates)))
        (snmt-candidate-addresses (tail candidates)))))

  ; round = content address, prior recipe, all candidates, chosen candidate,
  ; selection state. Ties keep the first recorded event while retaining peers.
  (defn snmt-round (previous draws)
    (do
      (let candidates (snmt-candidates previous draws))
      (let chosen (snmt-best-candidate candidates (empty)))
      (list (snsf-address 18
              (list previous (snmt-candidate-addresses candidates)))
        previous candidates chosen
        (if (eq (len chosen) 0) "abstain-no-event"
          "selected-most-surprising-recorded-event"))))
  (defn snmt-r-address (round) (nth round 0))
  (defn snmt-r-previous (round) (nth round 1))
  (defn snmt-r-candidates (round) (nth round 2))
  (defn snmt-r-chosen (round) (nth round 3))
  (defn snmt-r-state (round) (nth round 4))
  (defn snmt-r-event (round)
    (if (eq (len (snmt-r-chosen round)) 0) (empty)
      (snmt-c-event (snmt-r-chosen round))))
  (defn snmt-r-recipe (round)
    (if (eq (len (snmt-r-event round)) 0) (empty)
      (snmt-e-recipe (snmt-r-event round))))
  (defn snmt-r-score (round)
    (if (eq (len (snmt-r-chosen round)) 0) -1
      (snmt-c-score (snmt-r-chosen round))))
  (defn snmt-r-first-score (round)
    (if (eq (len (snmt-r-candidates round)) 0) -1
      (snmt-c-score (head (snmt-r-candidates round)))))
  (defn snmt-r-surprise-lift (round)
    (if (eq (len (snmt-r-candidates round)) 0) 0
      (sub (snmt-r-score round) (snmt-r-first-score round))))
  (defn snmt-r-draws (round)
    (if (eq (len (snmt-r-candidates round)) 0) (empty)
      (cons (snmt-e-draw
              (snmt-c-event (head (snmt-r-candidates round))))
        (snmt-r-draws-from (tail (snmt-r-candidates round))))))
  (defn snmt-r-draws-from (candidates)
    (if (eq (len candidates) 0) (empty)
      (cons (snmt-e-draw (snmt-c-event (head candidates)))
        (snmt-r-draws-from (tail candidates)))))
  (defn snmt-r-scores (round)
    (snmt-r-scores-from (snmt-r-candidates round)))
  (defn snmt-r-scores-from (candidates)
    (if (eq (len candidates) 0) (empty)
      (cons (snmt-c-score (head candidates))
        (snmt-r-scores-from (tail candidates)))))

  ; The neutral field alphabet is witnessed into the active dictionary through
  ; its existing English surfaces only to satisfy the dictionary's closure
  ; boundary. Those surfaces do not enter event or thought identity.
  (defn snmt-core-rows-loop (runtime id)
    (if (ge id (snmt-field-count)) (empty)
      (do
        (let surface (fwf-surface (fwf-at id)))
        (cons (snsf-token id surface "word" "en"
                (snsf-english-field-candidates surface)
                "local-field-meaning")
        (snmt-core-rows-loop runtime (add id 1))))))
  (defn snmt-open ()
    (do
      (let runtime (snsf-open))
      (let rows (snmt-core-rows-loop runtime 0))
      (list runtime (snsr-rebase (empty) rows))))
  (defn snmt-o-runtime (opened) (nth opened 0))
  (defn snmt-o-dictionary (opened) (nth opened 1))
  (defn snmt-dictionary-complete-loop? (dictionary addresses)
    (if (eq (len addresses) 0) 1
      (if (gt (len (snsr-by-address dictionary (head addresses))) 0)
        (snmt-dictionary-complete-loop? dictionary (tail addresses)) 0)))
  (defn snmt-dictionary-complete? (dictionary)
    (snmt-dictionary-complete-loop? dictionary (snmt-field-addresses)))

  (defn snmt-expression-for-locale (code)
    (if (or (str_eq code "zh") (str_eq code "sa"))
      (snsf-expression-uncased) (snsf-expression-self)))
  (defn snmt-realize
    (runtime dictionary recipe code)
    (snmr-realize runtime dictionary (snsp-meaning dictionary recipe) code
      (snmt-expression-for-locale code)))
  (defn snmt-realize-locales
    (runtime dictionary recipe codes)
    (if (eq (len codes) 0) (empty)
      (cons (snmt-realize runtime dictionary recipe (head codes))
        (snmt-realize-locales runtime dictionary recipe (tail codes)))))
  (defn snmt-realized-surfaces (realizations)
    (if (eq (len realizations) 0) (empty)
      (cons (list (snmr-r-locale (head realizations))
              (snmr-r-state (head realizations))
              (snmr-r-surfaces (head realizations)))
        (snmt-realized-surfaces (tail realizations)))))
  (defn snmt-symbol-ids (recipe)
    (if (eq (len recipe) 0) (empty)
      (cons (nth (head recipe) 2) (snmt-symbol-ids (tail recipe)))))
  (defn snmt-observer-labels (recipe)
    (if (eq (len recipe) 0) (empty)
      (cons (fwf-surface (fwf-at (nth (head recipe) 2)))
        (snmt-observer-labels (tail recipe)))))

  ; Round and event proposals join the reversible semantic graph. Every random
  ; proposal remains visible; the chosen event receives an additional reference.
  (defn snmt-event-symbol-edges (event recipe position)
    (if (eq (len recipe) 0) (empty)
      (cons (snsp-edge (snmt-e-address event) (snsf-structure-address 9)
              (head recipe) position)
        (snmt-event-symbol-edges event (tail recipe) (add position 1)))))
  (defn snmt-candidate-event-edges (candidates)
    (if (eq (len candidates) 0) (empty)
      (do
        (let event (snmt-c-event (head candidates)))
        (append (snmt-event-symbol-edges event (snmt-e-recipe event) 0)
          (snmt-candidate-event-edges (tail candidates))))))
  (defn snmt-round-candidate-edges (round candidates position)
    (if (eq (len candidates) 0) (empty)
      (cons (snsp-edge (snmt-r-address round) (snsf-structure-address 10)
              (snmt-e-address (snmt-c-event (head candidates))) position)
        (snmt-round-candidate-edges round (tail candidates)
          (add position 1)))))
  (defn snmt-round-edges (round)
    (if (eq (len (snmt-r-event round)) 0) (empty)
      (snsp-unique-edges
        (append
          (snmt-round-candidate-edges round (snmt-r-candidates round) 0)
          (cons (snsp-edge (snmt-r-address round)
                  (snsf-structure-address 14)
                  (snmt-e-address (snmt-r-event round)) 0)
            (snmt-candidate-event-edges (snmt-r-candidates round)))))))
  (defn snmt-realizations-edges (realizations)
    (if (eq (len realizations) 0) (empty)
      (append (snmr-realization-edges (head realizations))
        (snmt-realizations-edges (tail realizations)))))
  (defn snmt-graph (round realizations)
    (snsp-unique-edges
      (append (snmt-round-edges round)
        (snmt-realizations-edges realizations))))

  0)
