; learned-generalized-emitter.fk — learn one rule, generalize, emit NL + Form + Python.
; import "../form/form-stdlib/core.fk"
; import "../form/form-stdlib/form-eval-full.fk"

(do
    ; Two observations determine y = a*x+b. No output row is stored.
    (defn lge-learn (x1 y1 x2 y2)
        (do (let a (div (sub y2 y1) (sub x2 x1)))
            (let b (sub y1 (mul a x1)))
            (list a b)))
    (defn lge-a (m) (nth m 0))
    (defn lge-b (m) (nth m 1))
    (defn lge-run (m x) (add (mul (lge-a m) x) (lge-b m)))

    (defn lge-form-expr (m x)
        (str_concat "(add (mul " (str_concat (int_to_str x)
            (str_concat " " (str_concat (int_to_str (lge-a m))
                (str_concat ") " (str_concat (int_to_str (lge-b m)) ")")))))))
    (defn lge-form-code (m)
        (str_concat "(defn learned (x) (add (mul x "
            (str_concat (int_to_str (lge-a m))
                (str_concat ") " (str_concat (int_to_str (lge-b m)) "))"))))
    (defn lge-python-code (m)
        (str_concat "def learned(x):\n    return x * "
            (str_concat (int_to_str (lge-a m))
                (str_concat " + " (int_to_str (lge-b m))))))
    (defn lge-nl (m)
        (str_concat "सीखा नियम: प्रत्येक x को "
            (str_concat (int_to_str (lge-a m))
                (str_concat " से गुणा करें और "
                    (str_concat (int_to_str (lge-b m)) " जोड़ें।")))))

    (let model (lge-learn 1 5 3 9))
    (let heldout-x 7)
    (let expected 17)
    (let predicted (lge-run model heldout-x))
    (let emitted-value (fef-eval (str_concat "(do "
        (str_concat (lge-form-code model)
            (str_concat " (learned " (str_concat (int_to_str heldout-x) ")))"))))))
    (let nl (lge-nl model))
    (let python (lge-python-code model))
    (let nl-valid (if (and (ge (str_find nl "2" 0) 0) (ge (str_find nl "3" 0) 0)) 1 0))
    (let python-valid (if (and (ge (str_find python "def learned(x):" 0) 0)
        (ge (str_find python "x * 2 + 3" 0) 0)) 1 0))
    (print_str (str_concat
        (str_concat "learned-a=" (str_concat (int_to_str (lge-a model))
        (str_concat " learned-b=" (str_concat (int_to_str (lge-b model))
        (str_concat "\nheldout-x=7 expected=17 predicted=" (str_concat (int_to_str predicted)
        (str_concat "\nform-native-validation=" (str_concat (int_to_str emitted-value)
        (str_concat "\nnl-validation=" (str_concat (int_to_str nl-valid)
        (str_concat " python-structure-validation=" (str_concat (int_to_str python-valid)
        (str_concat "\nNL:\n" (str_concat nl
        (str_concat "\nFORM:\n" (str_concat (lge-form-code model)
        (str_concat "\nPYTHON:\n" (str_concat python "\n"))))))))))))))))))))
    (if (and (and (eq predicted expected) (eq emitted-value expected))
        (and (eq nl-valid 1) (eq python-valid 1))) 1 0))
