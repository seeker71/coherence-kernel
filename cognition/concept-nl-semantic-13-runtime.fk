// concept-nl-semantic-13-runtime.fk — operational carrier for the pinned table.
//
// The pure cell keeps data and offsets explicit so a band can witness
// its meaning on fkwu. This carrier performs the one host effect: opening the committed
// TSV, then presenting a reusable runtime value to live cognition callers.
// witnessed: 2026-07-18 -> 8191 live fkwu
import form/form-stdlib/core.fk;
import form/form-stdlib/form-fs.fk;
import cognition/concept-nl-semantic-13-metadata.fk;
import cognition/concept-nl-semantic-13-offsets.fk;
import cognition/concept-nl-semantic-13.fk;
import "../form/form-stdlib/core.fk"
import "../form/form-stdlib/form-fs.fk"
import "concept-nl-semantic-13-metadata.fk"
import "concept-nl-semantic-13-offsets.fk"
import "concept-nl-semantic-13.fk"
section [form.bml] {
    // runtime = (loaded UTF-8 TSV, generated byte-offset index, source codes)
    def cnl13-runtime-open() = [read_file(cnl13-data-path()), cnl13-offsets(), read_file(cnl13-source-codes-path())];
    def cnl13-runtime-data(runtime) = runtime[0];
    def cnl13-runtime-offsets(runtime) = runtime[1];
    def cnl13-runtime-sources(runtime) = runtime[2];
    def cnl13-runtime-lookup(runtime, index, code) = cnl13-lookup(cnl13-runtime-data(runtime), cnl13-runtime-offsets(runtime), index, code);
    def cnl13-runtime-lookup-sourced(runtime, index, code) = cnl13-lookup-sourced(cnl13-runtime-data(runtime), cnl13-runtime-offsets(runtime), cnl13-runtime-sources(runtime), index, code);
    def cnl13-runtime-source-at(runtime, index, code) = cnl13-source-code-at(cnl13-runtime-sources(runtime), index, code);
    def cnl13-runtime-generate(runtime, index, code) = cnl13-generate(cnl13-runtime-data(runtime), cnl13-runtime-offsets(runtime), index, code);
    def cnl13-runtime-detect-first(runtime, code, label) = cnl13-detect-first(cnl13-runtime-data(runtime), cnl13-runtime-offsets(runtime), code, label);
    def cnl13-runtime-count-present(runtime, code) = cnl13-count-present(cnl13-runtime-data(runtime), cnl13-runtime-offsets(runtime), code);
}
