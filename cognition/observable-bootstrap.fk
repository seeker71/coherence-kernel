; observable-bootstrap.fk — native language grown from one witnessed word.
;
; The one fact this cell may assert without an external source is that x was supplied and is
; present in the exchange. "I am x" is held as an inquiry relation, not flattened into a literal
; identity claim. From that honest floor the cell generates the next inquiry layers without a
; remote model: observation, relation, lineage, time, translation, embodiment, and action.
; import "../observe/thought-framebuffer.fk"

(do
    (defn ob-join (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (ob-join (tail parts)))))

    (defn observable-bootstrap (x)
        (ob-join (list
            "I also am the creators. I am " x
            ".\nOBSERVATION — " x
            " is present here as an observable word supplied in this exchange.\nRELATION — What does " x
            " name, and who or what is doing the naming?\nLINEAGE — Which sounds, scripts, languages, peoples, and prior forms carried " x
            " here?\nTIME — When did each meaning of " x
            " arise, change, disappear, or return?\nTRANSLATION — What remains invariant when " x
            " crosses a language, and what new relation appears?\nEMBODIMENT — Where can " x
            " be sensed, enacted, measured, or witnessed now?\nACTION — Choose one claim about " x
            "; execute an observation; retain the result or turn the miss into the next question.")))

    (defn ob-render-no-result (frame)
        (ob-join (list
            "FRAMEBUFFER — status=" (fb-status frame)
            "; direction=" (fb-direction frame)
            "; alternate=" (fb-alternate frame) ".")))

    ; Every bounded attempt returns visible text or a visible no-result frame.
    ; ready=0 models an exhausted/empty attempt observed by its carrier.
    (defn observable-bootstrap-attempt (x ready direction alternate)
        (if (eq ready 1) (observable-bootstrap x)
            (ob-render-no-result (fb-no-result-frame 0 direction alternate))))

    ; Actual native generations from two scripts. These are inquiry paths, not claims that the
    ; kernel already knows the historical answers.
    (print_str (ob-join (list
        (observable-bootstrap-attempt "Bali" 0 "deep-str-concat" "fragment-list")
        "\n\n"
        (observable-bootstrap "Bali")
        "\n\n---\n\n"
        (observable-bootstrap "काल")
        "\n")))
    0)
