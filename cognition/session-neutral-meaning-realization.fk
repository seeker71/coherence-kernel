; session-neutral-meaning-realization.fk — generate locale expression options
; from a closed neutral meaning recipe.
;
; The active session dictionary is the first surface memory. When it has no
; witnessed surface for a neutral address and locale, a ranked concept may use
; the committed 13-locale corpus and a core field symbol may use the existing
; seven-locale expression recipe. No phrase table is consulted. Multiple active
; surfaces remain alternatives; the Cartesian expression recipe is dynamic.
;
; A realization returns segment combinations as well as joined display text.
; Callers can feed the segments back to the locale-aware token door, so Chinese
; and Japanese do not depend on the byte tokenizer pretending to segment them.
; ASCII casing is an explicitly requested expression facet and does not change
; the neutral meaning address.
;
; witnessed: 2026-08-24 -> meaning realization band 32767 on fkwu
; preludes: cognition/session-neutral-context-choice.fk

(do
  ; option = surface, provenance, neutral address.
  (defn snmr-option (surface provenance address)
    (list surface provenance address))
  (defn snmr-o-surface (option) (nth option 0))
  (defn snmr-o-provenance (option) (nth option 1))
  (defn snmr-o-address (option) (nth option 2))
  (defn snmr-option-surface-in? (surface options)
    (if (eq (len options) 0) 0
      (if (str_eq surface (snmr-o-surface (head options))) 1
        (snmr-option-surface-in? surface (tail options)))))
  (defn snmr-unique-options-loop (options out)
    (if (eq (len options) 0) (reverse out)
      (snmr-unique-options-loop (tail options)
        (if (eq (snmr-option-surface-in?
                  (snmr-o-surface (head options)) out) 1) out
          (cons (head options) out)))))
  (defn snmr-unique-options (options)
    (snmr-unique-options-loop options (empty)))

  (defn snmr-active-options-loop (entries code address out)
    (if (eq (len entries) 0) (reverse out)
      (do
        (let entry (head entries))
        (snmr-active-options-loop (tail entries) code address
          (if (str_eq code (snsr-e-locale entry))
            (cons (snmr-option (snsr-e-surface entry)
                    "session-observed" address) out) out)))))
  (defn snmr-active-options (dictionary code address)
    (snmr-unique-options
      (snmr-active-options-loop (snsr-by-address dictionary address)
        code address (empty))))
  (defn snmr-corpus-option (runtime code address)
    (if (or (eq (snsp-address-shape? address) 0)
            (not (eq (nth address 1) 1))) (empty)
      (if (lt (ctr13-lens-index code) 0) (empty)
        (do
          (let surface (cnl13-runtime-generate
            (snsf-rt-nl runtime) (nth address 2) code))
          (if (eq (str_len surface) 0) (empty)
            (list (snmr-option surface "corpus-generated" address)))))))
  (defn snmr-field-option (runtime code address)
    (if (or (eq (snsp-address-shape? address) 0)
            (not (eq (nth address 1) 2))) (empty)
      (do
        (let locale (snsf-fwfl-locale code))
        (if (lt locale 0) (empty)
          (do
            (let surface (fwfl-generate-in (snsf-rt-nl runtime)
              (fwfl-symbol (nth address 2)) locale))
            (if (eq (str_len surface) 0) (empty)
              (list (snmr-option surface "field-recipe-generated" address))))))))

  (defn snmr-upper-loop (surface i out)
    (if (ge i (str_len surface)) out
      (do
        (let b (str_byte_at surface i))
        (snmr-upper-loop surface (add i 1)
          (str_concat out (byte_to_str
            (if (and (ge b 97) (le b 122)) (sub b 32) b)))))))
  (defn snmr-expression-surface (surface expression)
    (if (eq (snsf-expression-code expression) 0)
      (snsf-fold-range surface 0 (str_len surface) "")
      (if (eq (snsf-expression-code expression) 1)
        (snmr-upper-loop surface 0 "") surface)))
  (defn snmr-express-options (options expression)
    (if (eq (len options) 0) (empty)
      (cons (snmr-option
              (snmr-expression-surface (snmr-o-surface (head options)) expression)
              (snmr-o-provenance (head options))
              (snmr-o-address (head options)))
        (snmr-express-options (tail options) expression))))

  (defn snmr-options-for-address
    (runtime dictionary code address expression)
    (do
      (let active (snmr-active-options dictionary code address))
      (let supplied (if (gt (len active) 0) active
        (do
          (let corpus (snmr-corpus-option runtime code address))
          (if (gt (len corpus) 0) corpus
            (snmr-field-option runtime code address)))))
      (snmr-unique-options (snmr-express-options supplied expression))))
  (defn snmr-option-sets
    (runtime dictionary code recipe expression)
    (if (eq (len recipe) 0) (empty)
      (cons (snmr-options-for-address runtime dictionary code
              (head recipe) expression)
        (snmr-option-sets runtime dictionary code (tail recipe) expression))))
  (defn snmr-option-sets-complete? (sets)
    (if (eq (len sets) 0) 0
      (if (eq (len (head sets)) 0) 0
        (if (eq (len (tail sets)) 0) 1
          (snmr-option-sets-complete? (tail sets))))))

  (defn snmr-extend-combinations (combinations options)
    (if (eq (len combinations) 0) (empty)
      (append (snmr-extend-one (head combinations) options)
        (snmr-extend-combinations (tail combinations) options))))
  (defn snmr-extend-one (combination options)
    (if (eq (len options) 0) (empty)
      (cons (append combination (list (head options)))
        (snmr-extend-one combination (tail options)))))
  (defn snmr-combinations-loop (sets combinations)
    (if (eq (len sets) 0) combinations
      (snmr-combinations-loop (tail sets)
        (snmr-extend-combinations combinations (head sets)))))
  (defn snmr-combinations (sets)
    (if (eq (snmr-option-sets-complete? sets) 0) (empty)
      (snmr-combinations-loop sets (list (empty)))))
  (defn snmr-combination-surfaces (combination)
    (if (eq (len combination) 0) (empty)
      (cons (snmr-o-surface (head combination))
        (snmr-combination-surfaces (tail combination)))))
  (defn snmr-join (segments separator)
    (if (eq (len segments) 0) ""
      (if (eq (len (tail segments)) 0) (head segments)
        (str_concat (head segments)
          (str_concat separator (snmr-join (tail segments) separator))))))
  (defn snmr-separator (code)
    (if (or (str_eq code "zh") (str_eq code "ja")) "" " "))
  (defn snmr-render-combinations (combinations code)
    (if (eq (len combinations) 0) (empty)
      (cons (snmr-join (snmr-combination-surfaces (head combinations))
              (snmr-separator code))
        (snmr-render-combinations (tail combinations) code))))

  ; realization = meaning address, locale, expression facet, option sets,
  ; option combinations, display surfaces, state.
  (defn snmr-realize (runtime dictionary meaning code expression)
    (if (eq (len meaning) 0)
      (list (empty) code expression (empty) (empty) (empty)
        "incomplete-meaning")
      (do
        (let sets (snmr-option-sets runtime dictionary code
          (snsp-m-recipe meaning) expression))
        (let combinations (snmr-combinations sets))
        (list (snsp-m-address meaning) code expression sets combinations
          (snmr-render-combinations combinations code)
          (if (gt (len combinations) 0) "complete" "surface-open")))))
  (defn snmr-r-meaning (realization) (nth realization 0))
  (defn snmr-r-locale (realization) (nth realization 1))
  (defn snmr-r-expression (realization) (nth realization 2))
  (defn snmr-r-option-sets (realization) (nth realization 3))
  (defn snmr-r-combinations (realization) (nth realization 4))
  (defn snmr-r-surfaces (realization) (nth realization 5))
  (defn snmr-r-state (realization) (nth realization 6))
  (defn snmr-surface-in? (surface surfaces)
    (if (eq (len surfaces) 0) 0
      (if (str_eq surface (head surfaces)) 1
        (snmr-surface-in? surface (tail surfaces)))))
  (defn snmr-realization-matches? (realization surface)
    (snmr-surface-in? surface (snmr-r-surfaces realization)))

  ; Generated locale surfaces are graph nodes, content-addressed by locale,
  ; exact bytes, and expression facet. A meaning references every generated
  ; surface; reverse query uses the ordinary edges-to door.
  (defn snmr-surface-address (code surface expression)
    (snsf-address 16
      (list (nmfe-string-bytes code) (nmfe-string-bytes surface) expression)))
  (defn snmr-realization-edges-loop
    (meaning code expression surfaces position)
    (if (eq (len surfaces) 0) (empty)
      (cons (snsp-edge meaning (snsf-structure-address 14)
              (snmr-surface-address code (head surfaces) expression) position)
        (snmr-realization-edges-loop meaning code expression
          (tail surfaces) (add position 1)))))
  (defn snmr-realization-edges (realization)
    (if (eq (len (snmr-r-meaning realization)) 0) (empty)
      (snmr-realization-edges-loop (snmr-r-meaning realization)
        (snmr-r-locale realization) (snmr-r-expression realization)
        (snmr-r-surfaces realization) 0)))

  0)
