; session-neutral-discourse-growth.fk — recorded variation grows neutral field
; symbols into typed clauses, sentences, and paragraphs.
;
; A clause preserves subject, BE/DO/SEE mode, relation, object, and context as
; separate neutral addresses. Three recorded events propose clauses. Selection
; happens only among the Pareto frontier over visible surprise, coherence,
; trust, sovereignty, vitality, and flow coordinates; no weighted scalar hides
; their tradeoffs. Every proposal and every rejected frontier peer remains.
;
; Two clauses become a sentence through a neutral discourse edge. Two sentences
; become a paragraph carrying a theme and another discourse edge. Locale
; realization happens after graph identity. English, German, Chinese, and
; French use small speaker-unreviewed normalized grammar bridges. Balinese and
; Sanskrit retain neutral structural mode/discourse marks instead of receiving
; fabricated grammar. All content words still come dynamically from the field
; realization organ.
;
; preludes: cognition/session-neutral-micro-thought.fk
; witnessed: 2026-08-24 -> band 32767; live graph 64 edges / 6 locale receipts

(do
  ; ── neutral modes and discourse relations ───────────────────────
  (defn sndg-mode (id) (snsf-address 19 id))
  (defn sndg-be () (sndg-mode 0))
  (defn sndg-do () (sndg-mode 1))
  (defn sndg-see () (sndg-mode 2))
  (defn sndg-mode-valid? (mode)
    (if (and (eq (snsp-address-shape? mode) 1)
             (and (eq (nth mode 1) 19)
                  (and (ge (nth mode 2) 0) (le (nth mode 2) 2)))) 1 0))
  (defn sndg-mode-description (mode)
    (if (value_eq mode (sndg-be))
      (list (snsf-structure-address 6))
      (if (value_eq mode (sndg-do))
        (list (snsf-structure-address 9))
        (if (value_eq mode (sndg-see))
          (list (snsf-structure-address 7)
            (snsf-structure-address 14)) (empty)))))
  (defn sndg-modes-closed? ()
    (if (and (eq (snsp-neutral-address-list?
                    (sndg-mode-description (sndg-be))) 1)
             (and (eq (snsp-neutral-address-list?
                         (sndg-mode-description (sndg-do))) 1)
                  (eq (snsp-neutral-address-list?
                        (sndg-mode-description (sndg-see))) 1))) 1 0))

  (defn sndg-discourse (id) (snsf-address 20 id))
  (defn sndg-join () (sndg-discourse 0))
  (defn sndg-then () (sndg-discourse 1))
  (defn sndg-because () (sndg-discourse 2))
  (defn sndg-contrast () (sndg-discourse 3))
  (defn sndg-question () (sndg-discourse 4))
  (defn sndg-elaborate () (sndg-discourse 5))
  (defn sndg-discourse-count () 6)
  (defn sndg-discourse-valid? (relation)
    (if (and (eq (snsp-address-shape? relation) 1)
             (and (eq (nth relation 1) 20)
                  (and (ge (nth relation 2) 0)
                       (lt (nth relation 2) (sndg-discourse-count))))) 1 0))
  (defn sndg-discourse-description (relation)
    (if (value_eq relation (sndg-join))
      (list (snsf-structure-address 2))
      (if (value_eq relation (sndg-then))
        (list (snsf-structure-address 9))
        (if (value_eq relation (sndg-because))
          (list (snsf-structure-address 14) (snsf-structure-address 9))
          (if (value_eq relation (sndg-contrast))
            (list (snsf-structure-address 3))
            (if (value_eq relation (sndg-question))
              (list (snsf-structure-address 12))
              (if (value_eq relation (sndg-elaborate))
                (list (snsf-structure-address 10)
                  (snsf-structure-address 17)) (empty))))))))
  (defn sndg-discourses-closed-loop? (id)
    (if (ge id (sndg-discourse-count)) 1
      (if (eq (snsp-neutral-address-list?
                (sndg-discourse-description (sndg-discourse id))) 1)
        (sndg-discourses-closed-loop? (add id 1)) 0)))
  (defn sndg-discourses-closed? () (sndg-discourses-closed-loop? 0))

  ; ── clauses ──────────────────────────────────────────────────────
  ; clause = address, subject, mode, relation, object, context.
  (defn sndg-clause (subject mode relation object context)
    (list (snsf-address 21 (list subject mode relation object context))
      subject mode relation object context))
  (defn sndg-c-address (clause) (nth clause 0))
  (defn sndg-c-subject (clause) (nth clause 1))
  (defn sndg-c-mode (clause) (nth clause 2))
  (defn sndg-c-relation (clause) (nth clause 3))
  (defn sndg-c-object (clause) (nth clause 4))
  (defn sndg-c-context (clause) (nth clause 5))
  (defn sndg-c-symbols (clause)
    (list (sndg-c-subject clause) (sndg-c-relation clause)
      (sndg-c-object clause) (sndg-c-context clause)))
  (defn sndg-clause-valid? (clause)
    (if (and (eq (len clause) 6)
             (and (eq (snmt-field-address-valid? (sndg-c-subject clause)) 1)
             (and (eq (sndg-mode-valid? (sndg-c-mode clause)) 1)
             (and (eq (snmt-field-address-valid? (sndg-c-relation clause)) 1)
             (and (eq (snmt-field-address-valid? (sndg-c-object clause)) 1)
                  (eq (snmt-field-address-valid? (sndg-c-context clause)) 1)))))) 1 0))

  (defn sndg-next-field (value)
    (do
      (let next (snmt-next-draw value))
      (list next (snsf-field-address (mod next (snmt-field-count))))))
  (defn sndg-clause-from-draw (draw)
    (do
      (let a (sndg-next-field draw))
      (let b (sndg-next-field (nth a 0)))
      (let c (sndg-next-field (nth b 0)))
      (let d (sndg-next-field (nth c 0)))
      (let e (snmt-next-draw (nth d 0)))
      (sndg-clause (nth a 1) (sndg-mode (mod e 3))
        (nth b 1) (nth c 1) (nth d 1))))

  (defn sndg-shared-distinct-loop (a b seen)
    (if (eq (len a) 0) 0
      (do
        (let value (head a))
        (add (if (and (eq (snmt-address-in? value b) 1)
                      (eq (snmt-address-in? value seen) 0)) 1 0)
          (sndg-shared-distinct-loop (tail a) b (cons value seen))))))
  (defn sndg-shared-distinct (a b)
    (sndg-shared-distinct-loop a b (empty)))
  (defn sndg-distinct-count-loop (values seen)
    (if (eq (len values) 0) (len seen)
      (sndg-distinct-count-loop (tail values)
        (if (eq (snmt-address-in? (head values) seen) 1) seen
          (cons (head values) seen)))))
  (defn sndg-distinct-count (values)
    (sndg-distinct-count-loop values (empty)))
  (defn sndg-axis-total (symbols axis)
    (if (eq (len symbols) 0) 0
      (add (nth (fwf-shape (fwf-at (nth (head symbols) 2))) axis)
        (sndg-axis-total (tail symbols) axis))))
  (defn sndg-flow-alignment (symbols)
    (if (lt (len symbols) 2) 0
      (add (fwf-wake-alignment
              (fwf-wake-by-id (nth (head symbols) 2)
                (nth (head (tail symbols)) 2)))
        (sndg-flow-alignment (tail symbols)))))

  ; guidance vector = surprise, coherence, trust, sovereignty, vitality, flow.
  ; Every coordinate is independently visible. There is no weighted sum.
  (defn sndg-guidance-vector (previous clause)
    (do
      (let prior (if (eq (len previous) 0) (empty)
        (sndg-c-symbols previous)))
      (let current (sndg-c-symbols clause))
      (list (snmt-s-total (snmt-surprise prior current))
        (mul (sndg-shared-distinct prior current) 1000)
        (if (eq (sndg-clause-valid? clause) 1)
          (sndg-axis-total current 7) 0)
        (sndg-axis-total current 8)
        (add (sndg-axis-total current 2)
          (mul (sndg-distinct-count current) 100))
        (sndg-flow-alignment current))))
  (defn sndg-v-surprise (vector) (nth vector 0))
  (defn sndg-v-coherence (vector) (nth vector 1))
  (defn sndg-v-trust (vector) (nth vector 2))
  (defn sndg-v-sovereignty (vector) (nth vector 3))
  (defn sndg-v-vitality (vector) (nth vector 4))
  (defn sndg-v-flow (vector) (nth vector 5))

  ; proposal = content address, recorded draw, clause, guidance vector.
  (defn sndg-proposal (previous draw)
    (do
      (let clause (sndg-clause-from-draw draw))
      (let vector (sndg-guidance-vector previous clause))
      (list (snsf-address 25 (list draw (sndg-c-address clause) vector))
        draw clause vector)))
  (defn sndg-p-address (proposal) (nth proposal 0))
  (defn sndg-p-draw (proposal) (nth proposal 1))
  (defn sndg-p-clause (proposal) (nth proposal 2))
  (defn sndg-p-vector (proposal) (nth proposal 3))
  (defn sndg-proposals (previous draws)
    (if (eq (len draws) 0) (empty)
      (cons (sndg-proposal previous (head draws))
        (sndg-proposals previous (tail draws)))))

  (defn sndg-vector-all-ge? (a b)
    (if (eq (len a) 0) 1
      (if (ge (head a) (head b))
        (sndg-vector-all-ge? (tail a) (tail b)) 0)))
  (defn sndg-vector-any-gt? (a b)
    (if (eq (len a) 0) 0
      (if (gt (head a) (head b)) 1
        (sndg-vector-any-gt? (tail a) (tail b)))))
  (defn sndg-dominates? (a b)
    (if (and (eq (sndg-vector-all-ge? (sndg-p-vector a)
                    (sndg-p-vector b)) 1)
             (eq (sndg-vector-any-gt? (sndg-p-vector a)
                    (sndg-p-vector b)) 1)) 1 0))
  (defn sndg-dominated-by-any? (candidate proposals)
    (if (eq (len proposals) 0) 0
      (if (and (not (value_eq (sndg-p-address candidate)
                        (sndg-p-address (head proposals))))
               (eq (sndg-dominates? (head proposals) candidate) 1)) 1
        (sndg-dominated-by-any? candidate (tail proposals)))))
  (defn sndg-pareto-frontier-loop (remaining all)
    (if (eq (len remaining) 0) (empty)
      (if (eq (sndg-dominated-by-any? (head remaining) all) 1)
        (sndg-pareto-frontier-loop (tail remaining) all)
        (cons (head remaining)
          (sndg-pareto-frontier-loop (tail remaining) all)))))
  (defn sndg-pareto-frontier (proposals)
    (sndg-pareto-frontier-loop proposals proposals))
  (defn sndg-proposal-addresses (proposals)
    (if (eq (len proposals) 0) (empty)
      (cons (sndg-p-address (head proposals))
        (sndg-proposal-addresses (tail proposals)))))

  ; round = address, previous clause, all proposals, frontier, selected,
  ; selector draw, state.
  (defn sndg-round (previous draws selector)
    (do
      (let proposals (sndg-proposals previous draws))
      (let frontier (sndg-pareto-frontier proposals))
      (let selected (if (eq (len frontier) 0) (empty)
        (nth frontier (mod (snmt-positive selector) (len frontier)))))
      (list (snsf-address 26
              (list (if (eq (len previous) 0) (empty)
                      (sndg-c-address previous))
                (sndg-proposal-addresses proposals) selector))
        previous proposals frontier selected selector
        (if (eq (len selected) 0) "abstain-no-frontier"
          "selected-from-pareto-frontier"))))
  (defn sndg-r-address (round) (nth round 0))
  (defn sndg-r-previous (round) (nth round 1))
  (defn sndg-r-proposals (round) (nth round 2))
  (defn sndg-r-frontier (round) (nth round 3))
  (defn sndg-r-selected (round) (nth round 4))
  (defn sndg-r-selector (round) (nth round 5))
  (defn sndg-r-state (round) (nth round 6))
  (defn sndg-r-clause (round)
    (if (eq (len (sndg-r-selected round)) 0) (empty)
      (sndg-p-clause (sndg-r-selected round))))
  (defn sndg-r-vectors (round)
    (sndg-r-vectors-from (sndg-r-proposals round)))
  (defn sndg-r-vectors-from (proposals)
    (if (eq (len proposals) 0) (empty)
      (cons (sndg-p-vector (head proposals))
        (sndg-r-vectors-from (tail proposals)))))
  (defn sndg-r-clause-roles (round)
    (sndg-clause-role-row (sndg-r-clause round)))
  (defn sndg-clause-role-row (clause)
    (if (eq (len clause) 0) (empty)
      (list (nth (sndg-c-subject clause) 2) (nth (sndg-c-mode clause) 2)
        (nth (sndg-c-relation clause) 2) (nth (sndg-c-object clause) 2)
        (nth (sndg-c-context clause) 2))))

  ; ── sentences and paragraphs ─────────────────────────────────────
  ; sentence = address, ordered clauses, discourse relations.
  (defn sndg-sentence (clauses relations)
    (list (snsf-address 22 (list (sndg-clause-addresses clauses) relations))
      clauses relations))
  (defn sndg-s-address (sentence) (nth sentence 0))
  (defn sndg-s-clauses (sentence) (nth sentence 1))
  (defn sndg-s-relations (sentence) (nth sentence 2))
  (defn sndg-clause-addresses (clauses)
    (if (eq (len clauses) 0) (empty)
      (cons (sndg-c-address (head clauses))
        (sndg-clause-addresses (tail clauses)))))
  (defn sndg-relations-valid? (relations)
    (if (eq (len relations) 0) 1
      (if (eq (sndg-discourse-valid? (head relations)) 1)
        (sndg-relations-valid? (tail relations)) 0)))
  (defn sndg-clauses-valid? (clauses)
    (if (eq (len clauses) 0) 0
      (if (eq (sndg-clause-valid? (head clauses)) 1)
        (if (eq (len (tail clauses)) 0) 1
          (sndg-clauses-valid? (tail clauses))) 0)))
  (defn sndg-sentence-valid? (sentence)
    (if (and (eq (len sentence) 3)
             (and (eq (sndg-clauses-valid? (sndg-s-clauses sentence)) 1)
             (and (eq (sndg-relations-valid? (sndg-s-relations sentence)) 1)
                  (eq (len (sndg-s-relations sentence))
                    (sub (len (sndg-s-clauses sentence)) 1))))) 1 0))

  (defn sndg-sentence-clauses (sentences)
    (if (eq (len sentences) 0) (empty)
      (append (sndg-s-clauses (head sentences))
        (sndg-sentence-clauses (tail sentences)))))
  (defn sndg-all-symbols (clauses)
    (if (eq (len clauses) 0) (empty)
      (append (sndg-c-symbols (head clauses))
        (sndg-all-symbols (tail clauses)))))
  (defn sndg-count-address (wanted values)
    (if (eq (len values) 0) 0
      (add (if (value_eq wanted (head values)) 1 0)
        (sndg-count-address wanted (tail values)))))
  (defn sndg-theme-loop (remaining all best best-count)
    (if (eq (len remaining) 0) best
      (do
        (let count (sndg-count-address (head remaining) all))
        (sndg-theme-loop (tail remaining) all
          (if (gt count best-count) (head remaining) best)
          (if (gt count best-count) count best-count)))))
  (defn sndg-theme (sentences)
    (do
      (let symbols (sndg-all-symbols (sndg-sentence-clauses sentences)))
      (if (eq (len symbols) 0) (empty)
        (sndg-theme-loop symbols symbols (head symbols) 0))))

  ; paragraph = address, theme, ordered sentences, discourse relations,
  ; perspective mode.
  (defn sndg-paragraph (sentences relations)
    (do
      (let theme (sndg-theme sentences))
      (let perspective (if (eq (len sentences) 0) (sndg-see)
        (sndg-c-mode (head (sndg-s-clauses (head sentences))))))
      (list (snsf-address 23
              (list theme (sndg-sentence-addresses sentences) relations
                perspective))
        theme sentences relations perspective)))
  (defn sndg-g-address (paragraph) (nth paragraph 0))
  (defn sndg-g-theme (paragraph) (nth paragraph 1))
  (defn sndg-g-sentences (paragraph) (nth paragraph 2))
  (defn sndg-g-relations (paragraph) (nth paragraph 3))
  (defn sndg-g-perspective (paragraph) (nth paragraph 4))
  (defn sndg-sentence-addresses (sentences)
    (if (eq (len sentences) 0) (empty)
      (cons (sndg-s-address (head sentences))
        (sndg-sentence-addresses (tail sentences)))))
  (defn sndg-paragraph-valid? (paragraph)
    (if (eq (len paragraph) 5)
      (if (eq (snmt-field-address-valid? (sndg-g-theme paragraph)) 1)
        (if (eq (sndg-mode-valid? (sndg-g-perspective paragraph)) 1)
          (if (eq (sndg-sentences-valid? (sndg-g-sentences paragraph)) 1)
            (if (eq (sndg-relations-valid? (sndg-g-relations paragraph)) 1)
              (if (eq (len (sndg-g-relations paragraph))
                       (sub (len (sndg-g-sentences paragraph)) 1))
                1 0)
              0)
            0)
          0)
        0)
      0))
  (defn sndg-sentences-valid? (sentences)
    (if (eq (len sentences) 0) 0
      (if (eq (sndg-sentence-valid? (head sentences)) 1)
        (if (eq (len (tail sentences)) 0) 1
          (sndg-sentences-valid? (tail sentences))) 0)))

  ; ── one reproducible growth walk ─────────────────────────────────
  (defn sndg-take (values count)
    (if (or (le count 0) (eq (len values) 0)) (empty)
      (cons (head values) (sndg-take (tail values) (sub count 1)))))
  (defn sndg-drop (values count)
    (if (or (le count 0) (eq (len values) 0)) values
      (sndg-drop (tail values) (sub count 1))))
  ; growth = seed, draws, rounds, sentences, paragraph.
  (defn sndg-grow (seed)
    (do
      (let draws (snmt-draw-stream seed 19))
      (let r1 (sndg-round (empty) (sndg-take draws 3) (nth draws 3)))
      (let r2 (sndg-round (sndg-r-clause r1)
        (sndg-take (sndg-drop draws 4) 3) (nth draws 7)))
      (let r3 (sndg-round (sndg-r-clause r2)
        (sndg-take (sndg-drop draws 8) 3) (nth draws 11)))
      (let r4 (sndg-round (sndg-r-clause r3)
        (sndg-take (sndg-drop draws 12) 3) (nth draws 15)))
      (let s1 (sndg-sentence (list (sndg-r-clause r1) (sndg-r-clause r2))
        (list (sndg-discourse (mod (nth draws 16) (sndg-discourse-count))))))
      (let s2 (sndg-sentence (list (sndg-r-clause r3) (sndg-r-clause r4))
        (list (sndg-discourse (mod (nth draws 17) (sndg-discourse-count))))))
      (let paragraph (sndg-paragraph (list s1 s2)
        (list (sndg-discourse (mod (nth draws 18) (sndg-discourse-count))))))
      (list (snmt-positive seed) draws (list r1 r2 r3 r4)
        (list s1 s2) paragraph)))
  (defn sndg-w-seed (growth) (nth growth 0))
  (defn sndg-w-draws (growth) (nth growth 1))
  (defn sndg-w-rounds (growth) (nth growth 2))
  (defn sndg-w-sentences (growth) (nth growth 3))
  (defn sndg-w-paragraph (growth) (nth growth 4))

  ; ── normalized locale realization ───────────────────────────────
  (defn sndg-first-surface (realization)
    (if (eq (len (snmr-r-surfaces realization)) 0) ""
      (head (snmr-r-surfaces realization))))
  (defn sndg-word-surface (runtime dictionary address code)
    (sndg-first-surface (snmt-realize runtime dictionary (list address) code)))
  (defn sndg-mode-surface (mode code)
    (do
      (let id (nth mode 2))
      (if (str_eq code "en")
        (if (eq id 0) "is" (if (eq id 1) "does" "sees"))
        (if (str_eq code "de")
          (if (eq id 0) "ist" (if (eq id 1) "tut" "sieht"))
          (if (str_eq code "zh")
            (if (eq id 0) "是" (if (eq id 1) "做" "看见"))
            (if (str_eq code "fr")
              (if (eq id 0) "est" (if (eq id 1) "fait" "voit"))
              (if (eq id 0) "BE" (if (eq id 1) "DO" "SEE"))))))))
  (defn sndg-context-bridge (code)
    (if (str_eq code "en") " within "
      (if (str_eq code "de") " in "
        (if (str_eq code "zh") "于"
          (if (str_eq code "fr") " dans " " @ ")))))
  (defn sndg-space (code) (if (str_eq code "zh") "" " "))
  (defn sndg-discourse-surface (relation code)
    (do
      (let id (nth relation 2))
      (if (str_eq code "en")
        (if (eq id 0) "and" (if (eq id 1) "then"
          (if (eq id 2) "because" (if (eq id 3) "but"
            (if (eq id 4) "asks" "elaborates")))))
        (if (str_eq code "de")
          (if (eq id 0) "und" (if (eq id 1) "dann"
            (if (eq id 2) "weil" (if (eq id 3) "aber"
              (if (eq id 4) "fragt" "erläutert")))))
          (if (str_eq code "zh")
            (if (eq id 0) "和" (if (eq id 1) "然后"
              (if (eq id 2) "因为" (if (eq id 3) "但是"
                (if (eq id 4) "询问" "阐述")))))
            (if (str_eq code "fr")
              (if (eq id 0) "et" (if (eq id 1) "puis"
                (if (eq id 2) "parce que" (if (eq id 3) "mais"
                  (if (eq id 4) "demande" "développe")))))
              (if (eq id 0) "∧" (if (eq id 1) "→"
                (if (eq id 2) "∵" (if (eq id 3) "—"
                  (if (eq id 4) "?" "…")))))))))))
  (defn sndg-discourse-bridge (relation code)
    (str_concat (sndg-space code)
      (str_concat (sndg-discourse-surface relation code)
        (sndg-space code))))

  ; clause realization = clause address, locale, role surfaces, display, state.
  (defn sndg-realize-clause (runtime dictionary clause code)
    (do
      (let subject (sndg-word-surface runtime dictionary
        (sndg-c-subject clause) code))
      (let relation (sndg-word-surface runtime dictionary
        (sndg-c-relation clause) code))
      (let object (sndg-word-surface runtime dictionary
        (sndg-c-object clause) code))
      (let context (sndg-word-surface runtime dictionary
        (sndg-c-context clause) code))
      (let mode (sndg-mode-surface (sndg-c-mode clause) code))
      (let sep (sndg-space code))
      (let surface (str_concat subject
        (str_concat sep (str_concat mode
        (str_concat sep (str_concat relation
        (str_concat "→" (str_concat object
          (str_concat (sndg-context-bridge code) context)))))))))
      (list (sndg-c-address clause) code
        (list subject mode relation object context) surface
        (if (or (str_eq subject "") (or (str_eq relation "")
                (or (str_eq object "") (str_eq context ""))))
          "surface-open" "complete-normalized-projection"))))
  (defn sndg-cr-address (realization) (nth realization 0))
  (defn sndg-cr-locale (realization) (nth realization 1))
  (defn sndg-cr-roles (realization) (nth realization 2))
  (defn sndg-cr-surface (realization) (nth realization 3))
  (defn sndg-cr-state (realization) (nth realization 4))
  (defn sndg-realize-clauses (runtime dictionary clauses code)
    (if (eq (len clauses) 0) (empty)
      (cons (sndg-realize-clause runtime dictionary (head clauses) code)
        (sndg-realize-clauses runtime dictionary (tail clauses) code))))
  (defn sndg-clause-realizations-complete? (realizations)
    (if (eq (len realizations) 0) 0
      (if (str_eq (sndg-cr-state (head realizations))
            "complete-normalized-projection")
        (if (eq (len (tail realizations)) 0) 1
          (sndg-clause-realizations-complete? (tail realizations))) 0)))
  (defn sndg-render-clause-realizations (realizations relations code)
    (if (eq (len realizations) 0) ""
      (if (eq (len (tail realizations)) 0)
        (sndg-cr-surface (head realizations))
        (str_concat (sndg-cr-surface (head realizations))
          (str_concat (sndg-discourse-bridge (head relations) code)
            (sndg-render-clause-realizations (tail realizations)
              (tail relations) code))))))
  ; sentence realization = address, locale, clause realizations, display, state.
  (defn sndg-realize-sentence (runtime dictionary sentence code)
    (do
      (let clauses (sndg-realize-clauses runtime dictionary
        (sndg-s-clauses sentence) code))
      (list (sndg-s-address sentence) code clauses
        (sndg-render-clause-realizations clauses
          (sndg-s-relations sentence) code)
        (if (eq (sndg-clause-realizations-complete? clauses) 1)
          "complete-normalized-projection" "surface-open"))))
  (defn sndg-sr-address (realization) (nth realization 0))
  (defn sndg-sr-locale (realization) (nth realization 1))
  (defn sndg-sr-clauses (realization) (nth realization 2))
  (defn sndg-sr-surface (realization) (nth realization 3))
  (defn sndg-sr-state (realization) (nth realization 4))
  (defn sndg-realize-sentences (runtime dictionary sentences code)
    (if (eq (len sentences) 0) (empty)
      (cons (sndg-realize-sentence runtime dictionary (head sentences) code)
        (sndg-realize-sentences runtime dictionary (tail sentences) code))))
  (defn sndg-sentence-realizations-complete? (realizations)
    (if (eq (len realizations) 0) 0
      (if (str_eq (sndg-sr-state (head realizations))
            "complete-normalized-projection")
        (if (eq (len (tail realizations)) 0) 1
          (sndg-sentence-realizations-complete? (tail realizations))) 0)))
  (defn sndg-terminator (code) (if (str_eq code "zh") "。" "."))
  (defn sndg-render-sentence-realizations (realizations relations code)
    (if (eq (len realizations) 0) ""
      (if (eq (len (tail realizations)) 0)
        (str_concat (sndg-sr-surface (head realizations))
          (sndg-terminator code))
        (str_concat (sndg-sr-surface (head realizations))
          (str_concat (sndg-terminator code)
            (str_concat (sndg-discourse-bridge (head relations) code)
              (sndg-render-sentence-realizations (tail realizations)
                (tail relations) code)))))))
  ; paragraph realization = surface address, paragraph address, locale,
  ; sentence realizations, display, state.
  (defn sndg-realize-paragraph (runtime dictionary paragraph code)
    (do
      (let sentences (sndg-realize-sentences runtime dictionary
        (sndg-g-sentences paragraph) code))
      (let surface (sndg-render-sentence-realizations sentences
        (sndg-g-relations paragraph) code))
      (list (snsf-address 24
              (list (sndg-g-address paragraph) code
                (nmfe-string-bytes surface)))
        (sndg-g-address paragraph) code sentences surface
        (if (eq (sndg-sentence-realizations-complete? sentences) 1)
          "complete-normalized-projection" "surface-open"))))
  (defn sndg-gr-address (realization) (nth realization 0))
  (defn sndg-gr-paragraph (realization) (nth realization 1))
  (defn sndg-gr-locale (realization) (nth realization 2))
  (defn sndg-gr-sentences (realization) (nth realization 3))
  (defn sndg-gr-surface (realization) (nth realization 4))
  (defn sndg-gr-state (realization) (nth realization 5))
  (defn sndg-realize-paragraphs (runtime dictionary paragraph codes)
    (if (eq (len codes) 0) (empty)
      (cons (sndg-realize-paragraph runtime dictionary paragraph (head codes))
        (sndg-realize-paragraphs runtime dictionary paragraph (tail codes)))))

  ; ── reversible hierarchy graph ───────────────────────────────────
  (defn sndg-clause-edges (clause)
    (list
      (snsp-edge (sndg-c-address clause) (snsf-structure-address 14)
        (sndg-c-subject clause) 0)
      (snsp-edge (sndg-c-address clause) (snsf-structure-address 14)
        (sndg-c-mode clause) 1)
      (snsp-edge (sndg-c-address clause) (snsf-structure-address 9)
        (sndg-c-relation clause) 2)
      (snsp-edge (sndg-c-address clause) (snsf-structure-address 14)
        (sndg-c-object clause) 3)
      (snsp-edge (sndg-c-address clause) (snsf-structure-address 10)
        (sndg-c-context clause) 4)))
  (defn sndg-clause-list-edges (clauses)
    (if (eq (len clauses) 0) (empty)
      (append (sndg-clause-edges (head clauses))
        (sndg-clause-list-edges (tail clauses)))))
  (defn sndg-sentence-membership-edges (sentence clauses position)
    (if (eq (len clauses) 0) (empty)
      (cons (snsp-edge (sndg-s-address sentence)
              (snsf-structure-address 10) (sndg-c-address (head clauses))
              position)
        (sndg-sentence-membership-edges sentence (tail clauses)
          (add position 1)))))
  (defn sndg-sentence-flow-edges (clauses relations position)
    (if (or (eq (len relations) 0) (lt (len clauses) 2)) (empty)
      (cons (snsp-edge (sndg-c-address (head clauses)) (head relations)
              (sndg-c-address (head (tail clauses))) position)
        (sndg-sentence-flow-edges (tail clauses) (tail relations)
          (add position 1)))))
  (defn sndg-sentence-edges (sentence)
    (snsp-unique-edges
      (append (sndg-sentence-membership-edges sentence
                (sndg-s-clauses sentence) 0)
        (append (sndg-sentence-flow-edges (sndg-s-clauses sentence)
                  (sndg-s-relations sentence) 0)
          (sndg-clause-list-edges (sndg-s-clauses sentence))))))
  (defn sndg-sentences-edges (sentences)
    (if (eq (len sentences) 0) (empty)
      (append (sndg-sentence-edges (head sentences))
        (sndg-sentences-edges (tail sentences)))))
  (defn sndg-paragraph-membership-edges (paragraph sentences position)
    (if (eq (len sentences) 0) (empty)
      (cons (snsp-edge (sndg-g-address paragraph)
              (snsf-structure-address 10) (sndg-s-address (head sentences))
              position)
        (sndg-paragraph-membership-edges paragraph (tail sentences)
          (add position 1)))))
  (defn sndg-paragraph-flow-edges (sentences relations position)
    (if (or (eq (len relations) 0) (lt (len sentences) 2)) (empty)
      (cons (snsp-edge (sndg-s-address (head sentences)) (head relations)
              (sndg-s-address (head (tail sentences))) position)
        (sndg-paragraph-flow-edges (tail sentences) (tail relations)
          (add position 1)))))
  (defn sndg-round-proposal-edges (round proposals position)
    (if (eq (len proposals) 0) (empty)
      (cons (snsp-edge (sndg-r-address round) (snsf-structure-address 10)
              (sndg-p-address (head proposals)) position)
        (cons (snsp-edge (sndg-p-address (head proposals))
                (snsf-structure-address 14)
                (sndg-c-address (sndg-p-clause (head proposals))) position)
          (sndg-round-proposal-edges round (tail proposals)
            (add position 1))))))
  (defn sndg-round-edges (round)
    (if (eq (len (sndg-r-selected round)) 0) (empty)
      (snsp-unique-edges
        (cons (snsp-edge (sndg-r-address round) (snsf-structure-address 14)
                (sndg-p-address (sndg-r-selected round)) 0)
          (sndg-round-proposal-edges round (sndg-r-proposals round) 0)))))
  (defn sndg-rounds-edges (rounds)
    (if (eq (len rounds) 0) (empty)
      (append (sndg-round-edges (head rounds))
        (sndg-rounds-edges (tail rounds)))))
  (defn sndg-surface-edges (paragraph realizations position)
    (if (eq (len realizations) 0) (empty)
      (cons (snsp-edge (sndg-g-address paragraph)
              (snsf-structure-address 14)
              (sndg-gr-address (head realizations)) position)
        (sndg-surface-edges paragraph (tail realizations)
          (add position 1)))))
  (defn sndg-surface-receipts (graph realizations)
    (if (eq (len realizations) 0) 0
      (add (if (eq (len (snsp-edges-to graph
                       (sndg-gr-address (head realizations)))) 1) 1 0)
        (sndg-surface-receipts graph (tail realizations)))))
  (defn sndg-graph (growth realizations)
    (do
      (let paragraph (sndg-w-paragraph growth))
      (let sentences (sndg-g-sentences paragraph))
      (snsp-unique-edges
        (append (sndg-rounds-edges (sndg-w-rounds growth))
          (append
            (list (snsp-edge (sndg-g-address paragraph)
                    (snsf-structure-address 14)
                    (sndg-g-theme paragraph) 0))
            (append (sndg-paragraph-membership-edges paragraph sentences 0)
              (append (sndg-paragraph-flow-edges sentences
                        (sndg-g-relations paragraph) 0)
                (append (sndg-sentences-edges sentences)
                  (sndg-surface-edges paragraph realizations 0)))))))))

  0)
