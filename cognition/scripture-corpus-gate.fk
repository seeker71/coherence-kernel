; scripture-corpus-gate.fk — portable intake floor for the bundled WEB/SARIT
; sources. Licence is admission provenance, never semantic-frequency content.
(do
  (defn scg-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (scg-match s i p (add j 1)) 0))))
  (defn scg-has-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) 0
    (if (eq (scg-match s i p 0) 1) 1 (scg-has-loop s p (add i 1)))))
  (defn scg-has (s p) (scg-has-loop s p 0))
  (defn scg-suffix (s p) (if (lt (str_len s) (str_len p)) 0
    (scg-match s (sub (str_len s) (str_len p)) p 0)))
  (defn scg-bible-file (name) (if (eq (scg-suffix name ".usfm") 0) 0
    (if (eq (scg-has name "FRT") 1) 0 (if (eq (scg-has name "GLO") 1) 0 1))))
  (defn scg-count (names kind n) (if (eq (len names) 0) n
    (scg-count (tail names) kind (add n
      (if (eq kind 1) (scg-bible-file (head names)) (scg-suffix (head names) ".xml"))))))
  (defn scg-ready ()
    (do (let bible (scg-count (host_dir_list "corpus/sources/bible-web/") 1 0))
      (let sanskrit (scg-count (host_dir_list "corpus/sources/sanskrit-sarit/") 2 0))
      (let web-license (read_file "corpus/sources/bible-web/copr.htm"))
      (let asta (read_file "corpus/sources/sanskrit-sarit/astavakragita.xml"))
      (let yoga (read_file "corpus/sources/sanskrit-sarit/patanjalayogasastra.xml"))
      (let mb (read_file "corpus/sources/sanskrit-sarit/mahabharata-devanagari.xml"))
      (if (and (eq bible 66) (eq sanskrit 3))
        (if (and (eq (scg-has web-license "Public Domain") 1)
          (and (eq (scg-has asta "Attribution-ShareAlike 3.0") 1)
          (and (eq (scg-has yoga "Attribution-ShareAlike 3.0") 1)
               (eq (scg-has mb "Attribution-ShareAlike 3.0") 1)))) 1 0) 0)))
  (defn scripture-corpus-gate-witness ()
    (do (let bible (scg-count (host_dir_list "corpus/sources/bible-web/") 1 0))
      (let sanskrit (scg-count (host_dir_list "corpus/sources/sanskrit-sarit/") 2 0))
      (list (nothing) 0 1 7201 bible sanskrit (scg-ready)))))
