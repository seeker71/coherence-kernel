// nl-lenses-13.fk — one executable detector/generator over thirteen NL lenses.
//
// The neutral meanings are deliberately tiny:
//   1 presence, 2 enquiry, 3 affirmation, 4 grounded framing.
// Detection is phrase-pack evidence scoring. Generation is table selection or
// open+detail+close composition. Transformation crosses through the numeric
// meaning and preserves only the caller-supplied detail for meaning 4.
//
// Honest boundary: this is deterministic phrase semantics. It is not learned
// language identification, morphological generation, general translation, or
// fluency. Unknown text and unknown locale codes return the empty string.
//
import form/form-stdlib/core.fk;
import cognition/nl-lenses-13-data.fk;
import "../form/form-stdlib/core.fk"
import "nl-lenses-13-data.fk"
section [form.bml] {
    def nl13-id(r) = r[0];
    def nl13-code(r) = r[1];
    def nl13-name(r) = r[2];
    def nl13-script(r) = r[3];
    def nl13-presence(r) = r[4];
    def nl13-need(r) = r[5];
    def nl13-yes(r) = r[6];
    def nl13-open(r) = r[7];
    def nl13-close(r) = r[8];
    def nl13-provenance(r) = r[9];
    def nl13-source(r) = r[10];
    def nl13-count() = len(nl13-data());
    def nl13-at(i) = nth(nl13-data(), i);
    def nl13-find-go(rows, code) = (Comparable) len(rows) == 0 ? empty() : (String) nl13-code(rows[0]) == code ? rows[0] : nl13-find-go(rows[1:], code);
    def nl13-find(code) = nl13-find-go(nl13-data(), code);
    def nl13-frame(row, detail) = (nl13-open(row) + ((String) detail + nl13-close(row)));
    // Runtime-generated detail detector. fkwu, Go, and Rust keep raw UTF-8 byte
    // indexing; the minimal TypeScript proof walker currently narrows non-Latin
    // literals through its documented latin1 byte waist. The four-way law below
    // therefore stays on exact phrase equality, while the native runtime uses
    // this prefix/suffix path for arbitrary concept labels.
    def nl13-starts-with?(text, prefix) = len(text) < len(prefix) ? 0 : (String) substring(text, 0, len(prefix)) == prefix ? 1 : 0;
    def nl13-ends-with?(text, suffix) = len(text) < len(suffix) ? 0 : (String) substring(text, len(text) - len(suffix), len(text)) == suffix ? 1 : 0;
    def nl13-frame-shaped?(row, text) = len(text) >= (Number) len(nl13-open(row)) + (Number) len(nl13-close(row)) && ((Comparable) nl13-starts-with?(text, nl13-open(row)) == 1 && (Comparable) nl13-ends-with?(text, nl13-close(row)) == 1) ? 1 : 0;
    def nl13-score(row, text) = (Number) ((String) text == nl13-presence(row) ? 8 : 0) + (Number) ((Number) ((String) text == nl13-need(row) ? 4 : 0) + (Number) ((Number) ((String) text == nl13-yes(row) ? 2 : 0) + (Number) ((String) text == nl13-frame(row, "Form") ? 1 : 0)));
    def nl13-detect-go(rows, text, best, best-score) = (Comparable) len(rows) == 0 ? best : {
        let row = rows[0];
        let score = nl13-score(row, text);
        score > best-score ? nl13-detect-go(rows[1:], text, row, score) : nl13-detect-go(rows[1:], text, best, best-score);
    };
    def nl13-detect-row(text) = nl13-detect-go(nl13-data(), text, empty(), 0);
    def nl13-detect(text) = {
        let row = nl13-detect-row(text);
        (Comparable) len(row) == 0 ? "" : nl13-code(row);
    };
    def nl13-detect-frame-runtime-go(rows, text) = (Comparable) len(rows) == 0 ? "" : (Comparable) nl13-frame-shaped?(rows[0], text) == 1 ? nl13-code(rows[0]) : nl13-detect-frame-runtime-go(rows[1:], text);
    def nl13-detect-generated-runtime(text) = {
        let exact = nl13-detect(text);
        (String) exact == "" ? nl13-detect-frame-runtime-go(nl13-data(), text) : exact;
    };
    def nl13-generate-row(row, meaning, detail) = (Comparable) meaning == 1 ? nl13-presence(row) : (Comparable) meaning == 2 ? nl13-need(row) : (Comparable) meaning == 3 ? nl13-yes(row) : (Comparable) meaning == 4 ? nl13-frame(row, detail) : "";
    def nl13-generate(code, meaning, detail) = {
        let row = nl13-find(code);
        (Comparable) len(row) == 0 ? "" : nl13-generate-row(row, meaning, detail);
    };
    def nl13-meaning(row, text) = (String) text == nl13-presence(row) ? 1 : (String) text == nl13-need(row) ? 2 : (String) text == nl13-yes(row) ? 3 : (String) text == nl13-frame(row, "Form") ? 4 : 0;
    def nl13-detail(row, text, meaning) = (Comparable) meaning == 4 && (String) text == nl13-frame(row, "Form") ? "Form" : "";
    // The transformation is intentionally closed over the four meanings above.
    def nl13-transform(text, target-code) = {
        let source = nl13-detect-row(text);
        (Comparable) len(source) == 0 ? "" : {
            let meaning = nl13-meaning(source, text);
            (Comparable) meaning == 0 ? "" : nl13-generate(target-code, meaning, nl13-detail(source, text, meaning));
        };
    };
    // Structured frame transformation preserves any caller-owned detail without
    // trying to infer boundaries through the proof walker's Unicode byte seam.
    def nl13-reframe(source-code, target-code, detail) = len(nl13-find(source-code)) > 0 && len(nl13-find(target-code)) > 0 ? nl13-generate(target-code, 4, detail) : "";
    def nl13-transform-record(text, target-code) = {
        let source-code = nl13-detect(text);
        [source-code, target-code, (String) source-code == "" ? 0 : nl13-meaning(nl13-find(source-code), text), nl13-transform(text, target-code)];
    };
}
