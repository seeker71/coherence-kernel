; steiner-form-codegen.fk — the graph writes a program, and the body runs it.
;
; No template. No host-exec. No outside interpreter asked to judge.
;
; Urs named the cheat twice and both namings hold. First: a PL projection that
; only emits data is not a PL projection. Then: checking generated code by
; running it through python3 lets the generator skip having any model of the
; target language — the body concatenated a hand-written template and let an
; interpreter say yes.
;
; The way out was not a better Python emitter. It was to generate in a language
; the body HOLDS. `walk_recipe` is a registered native — "walks a recipe root in
; a fresh frame, the realization door" — so a recipe built with intern_node is
; a program the body can run with nothing outside it involved.
;
; WHAT MAKES THIS GENERATION RATHER THAN INTERPOLATION
;   The emitted program's SHAPE comes from the graph, not from a fixed skeleton
;   with holes. For a concept C the graph writes:
;
;     (add (if (eq s1 C) 1 0)
;     (add (if (eq s2 C) 1 0)
;     ...                       one term per has-member fact
;          0))
;
;   Add a fact to the graph and the program grows a term. Remove the relation
;   and the program shrinks to `0`. There is no string anywhere in it — every
;   node is an interned recipe node, and the operators come from the bp table by
;   name, so the generator is composing over the kernel's real op surface.
;
; THE PROOF
;   Two independent computations of the same number: the Form program the graph
;   WROTE (walked by the kernel) and a Form function that reads the graph
;   directly. If the generator drifts, they part and the band goes red. Neither
;   side asks anything outside the kernel.
;
; PROOF LANE, and it is the inverse of the usual one
;   `walk_recipe` is registered in Go, Rust and TypeScript and is ABSENT from
;   fkwu's door (it is in primitive-registry.fk and in no row of
;   native-op-manifest.fk or the runtime optable). So this band runs on the
;   three siblings and NOT on fkwu — the opposite of `nothing` and `host-exec`,
;   which fkwu has and the siblings lack. Declared here rather than discovered
;   later as a phantom divergence.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk

(do
  (defn sfg-lit (n) (intern_trivial_int n))

  ;; one term: (if (eq <subject> <concept>) 1 0)
  (defn sfg-term (subj concept)
    (intern_node (bp "if")
      (list (intern_node (bp "eq") (list (sfg-lit subj) (sfg-lit concept)))
            (sfg-lit 1)
            (sfg-lit 0))))

  ;; the chain: one term per has-member fact, folded with add, ending in 0.
  ;; The recursion IS the code generator — the program's length is the graph's.
  (defn sfg-chain (fs concept)
    (if (eq (len fs) 0) (sfg-lit 0)
      (if (eq (stn-f-relation (head fs)) (stn-has-member))
        (intern_node (bp "add")
          (list (sfg-term (stn-f-subject (head fs)) concept)
                (sfg-chain (tail fs) concept)))
        (sfg-chain (tail fs) concept))))

  ;; THE PROGRAM the graph wrote, for a given concept
  (defn sfg-program (concept) (sfg-chain (stn-facts) concept))

  ;; how many nodes deep it is — grows with the graph, which is the point
  (defn sfg-size-loop (n)
    (if (eq (len (node_children n)) 0) 1
      (add 1 (sfg-size-children (node_children n)))))
  (defn sfg-size-children (cs)
    (if (eq (len cs) 0) 0 (add (sfg-size-loop (head cs)) (sfg-size-children (tail cs)))))
  (defn sfg-size (concept) (sfg-size-loop (sfg-program concept)))

  ;; THE BODY RUNS IT
  (defn sfg-run (concept) (walk_recipe (sfg-program concept)))

  ;; and the same question answered by reading the graph directly
  (defn sfg-direct-loop (fs c)
    (if (eq (len fs) 0) 0
      (add (if (eq (stn-f-subject (head fs)) c)
             (if (eq (stn-f-relation (head fs)) (stn-has-member)) 1 0) 0)
           (sfg-direct-loop (tail fs) c))))
  (defn sfg-direct (c) (sfg-direct-loop (stn-facts) c))

  (defn sfg-agrees? (c) (if (eq (sfg-run c) (sfg-direct c)) 1 0))

  (defn sfg-check ()
    (add (if (eq (sfg-agrees? (stn-threefold-soul)) 1) 1 0)
    (add (if (eq (sfg-agrees? (stn-fourfold-being)) 1) 2 0)
    (add (if (eq (sfg-agrees? (stn-threefold-social)) 1) 4 0)
    (add (if (eq (sfg-agrees? (stn-polarity)) 1) 8 0)
    (add (if (eq (sfg-run (stn-threefold-soul)) 3) 16 0)
    (add (if (eq (sfg-run (stn-fourfold-being)) 4) 32 0)
    (add (if (eq (sfg-run (stn-polarity)) 2) 64 0)
    ;; a concept with no members: the graph writes a program that is just 0
    (add (if (eq (sfg-run (stn-eurythmy)) 0) 128 0)
    ;; and the generated program is big — it is not a constant folded by hand
    (add (if (gt (sfg-size (stn-threefold-soul)) 50) 256 0)
         0))))))))))

  0)
