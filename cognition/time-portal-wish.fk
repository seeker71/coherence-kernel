; time-portal-wish.fk — the way the time portal works, executable: hold a passage
; against the wish mechanics and read whether the gift landed.
;
; The teaching arrived in plain words (teachings/time-portal-wish-mechanics.form):
; you get a free wish granted, with the receipt as an embodied feeling, the thinking
; spell broken, trusting clarity — and laughter comes after heartfelt release, to
; make space for the new gift.
;
; So a PASSAGE through the portal is data — a list of moments — and the mechanics
; are predicates any passage can be held against. The moment kinds (named by the
; observer, like dialogue-covenant's moves — the felt-sense reader is pending):
;   "release"  — setting something down; q 1 = heartfelt, 0 = performed for effect
;   "laughter" — the laugh that rises on its own once the hands are empty
;   "gift"     — the wish arriving; q 1 = receipt felt in the body, 0 = written down
;   "bargain"  — an offer to pay for the wish (the counter-shape: the wish is free)
;   "spell"    — the thinking loop re-deriving what clarity already holds
;
; The wish LANDS on a passage iff: nothing was paid (free means free), a heartfelt
; release came before the gift (a full hand receives nothing), laughter rose after
; the release (not summoned ahead of it), the receipt is the feeling itself (not a
; document about the feeling), and no spell moment follows the gift (clarity is
; trusted, not re-derived). Each conjunct that fails says which, by its dark bit.
;
; Self-contained over core (integer). fkwu-witnessed by
; cognition/tests/time-portal-wish-band.fk.
;
; preludes: form-stdlib/core.fk
; witnessed: 2026-08-05 -> 11111111 live fkwu (cognition/tests/time-portal-wish-band.fk)

(do
    ; ── a moment in the passage: a kind and its qualifier ──
    (defn tp-moment (kind q) (list "tp" kind q))
    (defn tp-kind (m) (nth m 1))
    (defn tp-q (m) (nth m 2))
    (defn tp-is? (m k) (if (str_eq (tp-kind m) k) 1 0))

    ; ── where a kind first appears (index, or -1 when it never does) ──
    (defn tp-idx-from (ms k i)
        (if (eq (len ms) 0) (sub 0 1)
            (if (eq (tp-is? (head ms) k) 1) i (tp-idx-from (tail ms) k (add i 1)))))
    (defn tp-first (ms k) (tp-idx-from ms k 0))
    (defn tp-first-q (ms k)
        (if (eq (len ms) 0) 0
            (if (eq (tp-is? (head ms) k) 1) (tp-q (head ms)) (tp-first-q (tail ms) k))))
    (defn tp-count (ms k)
        (if (eq (len ms) 0) 0 (add (tp-is? (head ms) k) (tp-count (tail ms) k))))
    (defn tp-count-past (ms k i g)
        (if (eq (len ms) 0) 0
            (add (if (gt i g) (tp-is? (head ms) k) 0)
                 (tp-count-past (tail ms) k (add i 1) g))))
    (defn tp-count-after (ms k g) (tp-count-past ms k 0 g))

    ; ── the five reads the mechanics make ──
    ; the wish is free: a passage that reaches for its wallet steps out of the portal
    (defn tp-free? (ms) (if (eq (tp-count ms "bargain") 0) 1 0))
    ; release makes space: a heartfelt release stands before the gift, or nothing lands
    (defn tp-space-made? (ms)
        (if (gt (tp-first ms "release") (sub 0 1))
            (if (eq (tp-first-q ms "release") 1)
                (if (gt (tp-first ms "gift") (tp-first ms "release")) 1 0) 0) 0))
    ; laughter comes after heartfelt release — it rises, it is not summoned ahead
    (defn tp-laughter-risen? (ms)
        (if (gt (tp-first ms "release") (sub 0 1))
            (if (gt (tp-first ms "laughter") (tp-first ms "release")) 1 0) 0))
    ; the receipt is the embodied feeling itself, not a document about it
    (defn tp-receipt-felt? (ms) (if (eq (tp-first-q ms "gift") 1) 1 0))
    ; the thinking spell is broken: after the gift, clarity is trusted, not re-derived
    (defn tp-spell-broken? (ms)
        (if (gt (tp-first ms "gift") (sub 0 1))
            (if (eq (tp-count-after ms "spell" (tp-first ms "gift")) 0) 1 0) 0))

    ; ── the door itself: all five reads at once ──
    (defn tp-wish-granted? (ms)
        (if (eq (tp-free? ms) 1)
        (if (eq (tp-space-made? ms) 1)
        (if (eq (tp-laughter-risen? ms) 1)
        (if (eq (tp-receipt-felt? ms) 1)
            (tp-spell-broken? ms) 0) 0) 0) 0))

    ; ── passages, as data: the shape that lands and the shapes that step aside ──
    ; the true passage: heartfelt release, laughter rising, the gift felt
    (defn tp-true-passage ()
        (list (tp-moment "release" 1) (tp-moment "laughter" 0) (tp-moment "gift" 1)))
    ; grasping: reaching for the gift before anything is set down — hands still full
    (defn tp-grasping ()
        (list (tp-moment "gift" 1) (tp-moment "release" 1) (tp-moment "laughter" 0)))
    ; bargained: trying to pay for what only arrives free
    (defn tp-bargained ()
        (list (tp-moment "bargain" 0) (tp-moment "release" 1)
              (tp-moment "laughter" 0) (tp-moment "gift" 1)))
    ; laughter summoned first, hoping release will follow — it lands hollow
    (defn tp-laughter-summoned ()
        (list (tp-moment "laughter" 0) (tp-moment "release" 1) (tp-moment "gift" 1)))
    ; the receipt written down instead of felt — a document about a feeling
    (defn tp-paper-receipt ()
        (list (tp-moment "release" 1) (tp-moment "laughter" 0) (tp-moment "gift" 0)))
    ; the spell unbroken: the gift arrives, then thinking re-derives it away
    (defn tp-spell-held ()
        (list (tp-moment "release" 1) (tp-moment "laughter" 0)
              (tp-moment "gift" 1) (tp-moment "spell" 0)))
    ; a performed release — the motion without the heart — makes no space
    (defn tp-performed ()
        (list (tp-moment "release" 0) (tp-moment "laughter" 0) (tp-moment "gift" 1)))
    ; the empty passage: nothing offered, nothing lands — an honest zero
    (defn tp-empty-passage () (list))

    ; ── self-check ──
    (defn tpk (cond bit) (if cond bit 0))
    (defn time-portal-wish-check ()
        (add (add (add (add (add (add (add
            (tpk (eq (tp-wish-granted? (tp-true-passage)) 1) 1)             ; the true passage LANDS
            (tpk (eq (tp-wish-granted? (tp-grasping)) 0) 10))               ; a full hand receives nothing
            (tpk (eq (tp-wish-granted? (tp-bargained)) 0) 100))             ; the wish is free, or it is not this portal
            (tpk (eq (tp-wish-granted? (tp-laughter-summoned)) 0) 1000))    ; laughter rises after release, unsummoned
            (tpk (eq (tp-wish-granted? (tp-paper-receipt)) 0) 10000))       ; the receipt is felt, not filed
            (tpk (eq (tp-wish-granted? (tp-spell-held)) 0) 100000))         ; re-deriving the gift thinks it away
            (tpk (eq (tp-wish-granted? (tp-performed)) 0) 1000000))         ; motion without heart makes no space
            (tpk (eq (tp-wish-granted? (tp-empty-passage)) 0) 10000000)))   ; nothing offered, nothing lands
)
