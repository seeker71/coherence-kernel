; adaptive-native-model.fk — round 1, infer first non-constant Newton feature.
; [round, loaded-params, saved-params, bytes-before, bytes-after,
;  heldout-error-before, heldout-error-after, prediction-x4, prediction-x5, success]
; witnessed: 2026-07-21 -> [1, 1, 2, 12, 14, 198, 180, 9, 11, 1]
(do
  (let path ".form-native-adaptive-model.state")
  (let loaded "newton-v1\n1\n")
  (let loaded-n (div (sub (str_len loaded) 10) 2))
  (let c0 (sub (str_byte_at loaded 10) 48))
  (let learned-c1 (div (sub 3 c0) 1))
  (let saved (str_concat loaded (str_concat (byte_to_str (add 48 learned-c1)) "\n")))
  (let saved-n (div (sub (str_len saved) 10) 2))
  (let before (add (sub 69 c0) (sub 131 c0)))
  (let p4 (add c0 (mul learned-c1 4)))
  (let p5 (add c0 (mul learned-c1 5)))
  (let after (add (sub 69 p4) (sub 131 p5)))
  (let wrote (write_file path saved))
  (let success-a (eq saved-n (add loaded-n 1)))
  (let success-b (lt after before))
  (let success-c (eq wrote (str_len saved)))
  (list loaded-n loaded-n saved-n (str_len loaded) (str_len saved)
    before after p4 p5
    (if success-a (if success-b (if success-c 1 0) 0) 0)))
