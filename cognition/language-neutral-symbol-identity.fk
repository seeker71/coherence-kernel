// language-neutral-symbol-identity.fk — labels are evidence, never identity.
//
// A canonical symbol is derived only from its numeric composition.  A surface
// spelling can resolve to that symbol when its plane and relation agree, but
// changing or adding spellings cannot change the symbol's identity.
//
// The text-plane helpers keep provenance/licence/front-matter bytes outside
// lexical evidence.  They do not claim that lexical frequency is semantic
// frequency; callers must carry that claim as `nothing` until context observes it.
section [form.bml] {
    // Content-addressable slice coordinates: package/level/type/instance.
    // Each coordinate has an independent decimal field; labels never enter.
    def lnsi-node(package, level, type, instance) = (Number) (package * 1000000000) + (Number) ((Number) (level * 1000000) + (Number) ((Number) (type * 1000) + (Number) instance));
    // Alias row: [plane, relation, dialect, surface, canonical-node].
    // plane 1 = natural language; plane 2 = programming language.
    def lnsi-alias(plane, relation, dialect, surface, node) = [plane, relation, dialect, surface, node];
    def lnsi-resolve(aliases, plane, relation, dialect, surface) = (Comparable) len(aliases) == 0 ? nothing() : {
        let a = aliases[0];
        (Comparable) a[0] == plane && ((Comparable) a[1] == relation && ((Comparable) a[2] == dialect && (String) a[3] == surface)) ? a[4] : lnsi-resolve(aliases[1:], plane, relation, dialect, surface);
    };
    def lnsi-fold(b) = b >= 65 && b <= 90 ? (Number) b + (Number) 32 : b;
    def lnsi-match(s, i, p, j) = j >= len(p) ? 1 : (Number) i + (Number) j >= len(s) ? 0 : (Comparable) lnsi-fold(str_byte_at(s, (Number) i + (Number) j)) == lnsi-fold(str_byte_at(p, j)) ? lnsi-match(s, i, p, (Number) j + (Number) 1) : 0;
    def lnsi-find(s, p, i) = (Number) i + (Number) len(p) > len(s) ? -1 : (Comparable) lnsi-match(s, i, p, 0) == 1 ? i : lnsi-find(s, p, (Number) i + (Number) 1);
    def lnsi-count-sub-loop(s, p, i, n) = (Number) i + (Number) len(p) > len(s) ? n : (Comparable) lnsi-match(s, i, p, 0) == 1 ? lnsi-count-sub-loop(s, p, (Number) i + (Number) len(p), (Number) n + (Number) 1) : lnsi-count-sub-loop(s, p, (Number) i + (Number) 1, n);
    def lnsi-count-sub(s, p) = lnsi-count-sub-loop(s, p, 0, 0);
    // UTF-8 non-ASCII bytes remain part of a surface token. This makes exact
    // `santa` distinct from inflected/compounded `santah` and keeps IAST bytes.
    def lnsi-word-byte?(b) = b >= 48 && b <= 57 || (b >= 65 && b <= 90 || (b >= 97 && b <= 122 || b >= 128)) ? 1 : 0;
    def lnsi-exact-at?(s, p, i) = (Comparable) lnsi-match(s, i, p, 0) == 0 ? 0 : {
        let end = (Number) i + (Number) len(p);
        let left-ok = (Comparable) i == 0 ? 1 : (Comparable) lnsi-word-byte?(str_byte_at(s, i - 1)) == 0 ? 1 : 0;
        let right-ok = end >= len(s) ? 1 : (Comparable) lnsi-word-byte?(str_byte_at(s, end)) == 0 ? 1 : 0;
        (Comparable) left-ok == 1 && (Comparable) right-ok == 1 ? 1 : 0;
    };
    def lnsi-count-exact-loop(s, p, i, n) = (Number) i + (Number) len(p) > len(s) ? n : (Comparable) lnsi-exact-at?(s, p, i) == 1 ? lnsi-count-exact-loop(s, p, (Number) i + (Number) len(p), (Number) n + (Number) 1) : lnsi-count-exact-loop(s, p, (Number) i + (Number) 1, n);
    def lnsi-count-exact(s, p) = lnsi-count-exact-loop(s, p, 0, 0);
    // Range counting is the corpus-safe plane: it observes the source in place
    // instead of copying a multi-megabyte body through repeated concatenation.
    def lnsi-count-exact-range-loop(s, p, i, end, n) = (Number) i + (Number) len(p) > end ? n : (Comparable) lnsi-exact-at?(s, p, i) == 1 ? lnsi-count-exact-range-loop(s, p, (Number) i + (Number) len(p), end, (Number) n + (Number) 1) : lnsi-count-exact-range-loop(s, p, (Number) i + (Number) 1, end, n);
    def lnsi-count-exact-range(s, p, range) = lnsi-count-exact-range-loop(s, p, range[0], range[1], 0);
    def lnsi-count-sub-range-loop(s, p, i, end, n) = (Number) i + (Number) len(p) > end ? n : (Comparable) lnsi-match(s, i, p, 0) == 1 ? lnsi-count-sub-range-loop(s, p, (Number) i + (Number) len(p), end, (Number) n + (Number) 1) : lnsi-count-sub-range-loop(s, p, (Number) i + (Number) 1, end, n);
    def lnsi-count-sub-range(s, p, range) = lnsi-count-sub-range-loop(s, p, range[0], range[1], 0);
    def lnsi-slice-loop(s, i, end, acc) = i >= end ? acc : lnsi-slice-loop(s, (Number) i + (Number) 1, end, ((String) acc + byte_to_str(str_byte_at(s, i))));
    def lnsi-slice(s, start, end) = start < 0 || end < start ? "" : lnsi-slice-loop(s, start, end, "");
    // TEI semantic plane: only <body> descendants, never teiHeader/licence.
    def lnsi-tei-body(s) = {
        let open = lnsi-find(s, "<body", 0);
        let start = open < 0 ? -1 : lnsi-find(s, ">", open);
        let end = start < 0 ? -1 : lnsi-find(s, "</body>", (Number) start + (Number) 1);
        start < 0 || end < 0 ? "" : lnsi-slice(s, (Number) start + (Number) 1, end);
    };
    def lnsi-tei-body-range(s) = {
        let open = lnsi-find(s, "<body", 0);
        let start = open < 0 ? -1 : lnsi-find(s, ">", open);
        let end = start < 0 ? -1 : lnsi-find(s, "</body>", (Number) start + (Number) 1);
        start < 0 || end < 0 ? [0, 0] : [(Number) start + (Number) 1, end];
    };
    // USFM semantic plane: chapter/verse records, excluding book front matter.
    // Inline footnotes remain provenance in this narrow slice; none of the two
    // monitored Psalm aliases occur in those notes, which the witness checks by
    // exact content counts. A general USFM note-stripper is a separate layer.
    def lnsi-usfm-scripture(s) = {
        let start = lnsi-find(s, "\\c 1", 0);
        start < 0 ? "" : lnsi-slice(s, start, len(s));
    };
    def lnsi-usfm-scripture-range(s) = {
        let start = lnsi-find(s, "\\c 1", 0);
        start < 0 ? [0, 0] : [start, len(s)];
    };
    0;
}
