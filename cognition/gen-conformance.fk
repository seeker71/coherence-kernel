; gen-conformance.fk — the generated code is judged by its own compiler.
;
; The repeated finding of the last two days, in four different clothes: my
; checks measure the DECLARED. Declared kinds against used vocabulary; declared
; coverage against partial rows; hardcoded counts against the graph's real
; ones; capacity against emission. Each was the easiest true thing to compute,
; and each was blind in the same direction.
;
; The band cannot close that gap by getting cleverer, because it does not know
; what Python is. `go vet` does. `python3` does. So the honest test is not a
; better assertion — it is a DIFFERENT JUDGE: emit the module, hand it to the
; language's own toolchain, run it against the real graph, and compare the
; answer to what the graph says. A consumer with its own standards, which is
; the whole reason the Go compiler found a statement-separator bug that no
; reading of my code would have.
;
; Until now I did this by hand, once per language, once per turn. That is not a
; witness, it is an anecdote. This cell makes it an organ: every registered
; language with a real toolchain gets asked the same four questions, and the
; answers are compared to the graph's own.
;
; A LANGUAGE THAT CANNOT BE RUN IS NOT A FAILURE. Form has no external
; toolchain — it is verified inside the kernel by walk_recipe — and a language
; with no runner row is reported as UNJUDGED rather than passed. An unrun
; language scoring the same as a passing one is exactly the blindness this cell
; exists to end.
;
; PROOF LANE: FOURTH-ARM ONLY — host-exec is fkwu-only, and running a compiler
; is the entire point of this cell.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk cognition/gen-neutral-code.fk cognition/gen-query-flow.fk

(do
  (defn gcf-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (gcf-cat (tail xs)))))

  ;; ── the runner table: how a language becomes a running program ──
  ;; (lang file-ext facts-shape harness cmd) — harness slots: %1 module,
  ;; %2 facts literal, %3 the four calls.
  (defn gcf-run (lang ext facts harness cmd) (list lang ext facts harness cmd))
  (defn gcf-lang    (r) (nth r 0))
  (defn gcf-ext     (r) (nth r 1))
  (defn gcf-facts   (r) (nth r 2))
  (defn gcf-harness (r) (nth r 3))
  (defn gcf-cmd     (r) (nth r 4))

  ;; The facts-shape column is gone. It used to be a per-language spelling of
  ;; a list of rows — `[%1]` here, `[][]int{%1}` there — with a
  ;; `(str_eq lang "go")` branch choosing braces or brackets. That branch was
  ;; the fossil of a missing IR kind: `list` was type-blind, so a list OF LISTS
  ;; was unspellable and the harness spelled it by hand. With `listof` the
  ;; generator renders the graph AND the case table itself, and the runner row
  ;; carries only what is genuinely per-language: how a file becomes a running
  ;; program that prints its answers.
  (defn gcf-runners ()
    (list
      (gcf-run "python" "py" ""
        "%1\nF=%2\nC=%3\nprint(' '.join(str(x) for x in run_all(F,C)))\n"
        "python3 %f")
      (gcf-run "javascript" "js" ""
        "%1\nconst F=%2;\nconst C=%3;\nconsole.log(run_all(F,C).join(' '));\n"
        "node %f")
      (gcf-run "go" "go" ""
        "package main\nimport (\"fmt\"\n\"strings\"\n\"strconv\")\n%1\nfunc main(){ F := %2\n  C := %3\n  out := run_all(F, C)\n  ss := make([]string, len(out))\n  for i, v := range out { ss[i] = strconv.Itoa(v) }\n  fmt.Println(strings.Join(ss, \" \")) }\n"
        "cd %d && go run %f")))

  (defn gcf-find-loop (rs l)
    (if (eq (len rs) 0) (list)
      (if (str_eq (gcf-lang (head rs)) l) (head rs) (gcf-find-loop (tail rs) l))))
  (defn gcf-runner (l) (gcf-find-loop (gcf-runners) l))
  (defn gcf-runnable? (l) (if (eq (len (gcf-runner l)) 0) 0 1))

  ;; ── the graph and the sweep, both rendered BY THE GENERATOR ─────
  ;; Twenty lines of hand-spelled list literals with a language branch used to
  ;; live here. They are gone: gqy-emit-facts and gqy-emit-cases render both
  ;; through the same fold that renders the code, so a language that can spell
  ;; a typed collection gets its data for free.
  (defn gcf-facts-lit (r) (gqy-emit-facts (gcf-lang r)))
  (defn gcf-cases-lit (r) (gqy-emit-cases (gcf-lang r)))

  ;; ── WHAT IS ASKED: every question the graph makes askable ───────
  ;; Four hardcoded calls became 106 cases enumerated from the facts — every
  ;; (query shape, relation, key) triple some fact makes answerable, deduped.
  ;; Every one of them has a row that could answer it, so this is not a wall of
  ;; agreeing zeros; 14 of them have two or more matching rows, which are the
  ;; only cases that test first-match order at all.
  ;;
  ;; What the GRAPH answers is still gqy-answer — one hand reading the same
  ;; rows, corpus row 921, common-mode, and this cell no longer pretends
  ;; otherwise. Two things now stand against that, neither of them another
  ;; reading of the rows:
  ;;   1. THREE INDEPENDENT EXECUTORS. python3, node and go run share no code
  ;;      with each other or with Form. They cannot agree by inheriting an
  ;;      assumption; they can only agree by computing.
  ;;   2. A METAMORPHIC INVARIANT (gqy-invariant-sums?). Summing a count shape
  ;;      over every distinct key for a relation must equal the number of facts
  ;;      carrying it — a property of counting, true of any correct
  ;;      implementation and authored by nobody. A swapped column leaves every
  ;;      individual answer plausible and breaks the sum.
  (defn gcf-expected () (gqy-answers))

  ;; ── build, run, compare ─────────────────────────────────────────
  ;; A language takes whichever form it can speak; Go has no expression form,
  ;; Python no statement form, and neither absence is a failure.
  ;; the page: prelude, the four query functions, and the driver that answers
  ;; a whole case table. Every language that carries the statement rows speaks
  ;; it — including Form, whose `(do ...)` sequence takes `(let x v)` as a
  ;; statement-local binding, which nobody had checked before declaring it
  ;; could not.
  (defn gcf-module (l) (gqy-module-page l))

  (defn gcf-dir () (do (fs_mkdir (str_concat (temp_dir) "/gen-conformance"))
                       (str_concat (temp_dir) "/gen-conformance")))
  (defn gcf-path (r) (gcf-cat (list (gcf-dir) "/gen_q." (gcf-ext r))))

  ;; %3 was `(if (str_eq (gcf-lang r) "go") "," ",")` — a conditional whose
  ;; branches were identical, the fossil of a distinction that stopped
  ;; mattering and was never removed. The panel found it by reading the harness
  ;; as closely as the renderer. It is now the case table.
  (defn gcf-source (r)
    (gnc-sub1 (gnc-sub1 (gnc-sub1 (gcf-harness r) "%1" (gcf-module (gcf-lang r)))
                        "%2" (gcf-facts-lit r))
              "%3" (gcf-cases-lit r)))

  (defn gcf-exec (r)
    (do (let p (gcf-path r))
        (write_file p (gcf-source r))
        (host-exec (gnc-sub1 (gnc-sub1 (gcf-cmd r) "%f" p) "%d" (gcf-dir)) "")))

  ;; the toolchain's own answer, whitespace-normalised to one line
  (defn gcf-answer (l)
    (do (let r (gcf-runner l))
      (if (eq (len r) 0) ""
        (do (write_file (gcf-path r) (gcf-source r))
        (host-exec (gcf-cat (list "cd " (gcf-dir) " && "
          (gnc-sub1 (gnc-sub1 (gcf-cmd r) "%f" (gcf-path r)) "%d" (gcf-dir))
          " 2>&1 | tr -d '\\n'")) "")))))

  (defn gcf-write (l) (do (let r (gcf-runner l))
    (if (eq (len r) 0) 0 (do (write_file (gcf-path r) (gcf-source r)) 1))))

  (defn gcf-judge (l)
    (do (gcf-write l)
      (if (str_eq (gcf-answer l) (gcf-expected)) 1 0)))

  ;; ── the verdict over every language ─────────────────────────────
  (defn gcf-judged-loop (ls n)
    (if (eq (len ls) 0) n
      (gcf-judged-loop (tail ls)
        (add n (if (eq (gcf-runnable? (gnc-lang-name (head ls))) 1) 1 0)))))
  (defn gcf-judged-n () (gcf-judged-loop (gnc-languages) 0))
  (defn gcf-passed-loop (ls n)
    (if (eq (len ls) 0) n
      (gcf-passed-loop (tail ls)
        (add n (if (eq (gcf-runnable? (gnc-lang-name (head ls))) 1)
                   (gcf-judge (gnc-lang-name (head ls))) 0)))))
  (defn gcf-passed-n () (gcf-passed-loop (gnc-languages) 0))
  ;; UNJUDGED is reported, never counted as passing
  (defn gcf-unjudged-n () (sub (gnc-languages-n) (gcf-judged-n)))

  (defn gcf-check ()
    (add (if (eq (gcf-judged-n) 3) 1 0)
    (add (if (eq (gcf-unjudged-n) 1) 2 0)
    (add (if (eq (gcf-passed-n) (gcf-judged-n)) 4 0)
    (add (if (eq (gcf-judge "python") 1) 8 0)
    (add (if (eq (gcf-judge "javascript") 1) 16 0)
    (add (if (eq (gcf-judge "go") 1) 32 0)
    (add (if (eq (gcf-runnable? "form") 0) 64 0)
    ;; THE SWEEP IS LARGE, and its size is read from the graph rather than
    ;; pinned to a number someone typed
    (add (if (gt (gqy-cases-n) 105) 128 0)
    ;; and every case has an answering row — no wall of agreeing zeros
    (add (if (eq (gqy-nonzero-n) (gqy-cases-n)) 256 0)
    ;; and enough of them are multi-match to test first-match order at all
    (add (if (gt (gqy-multi-n) 10) 512 0)
    ;; THE METAMORPHIC INVARIANT: a check no implementation authored
    (add (if (eq (gqy-invariant-sums?) 1) 1024 0)
    ;; A PAGE OF CODE — measured on the emitted text, in three languages
    (add (if (gt (gqy-page-lines "python") 75) 2048 0)
    (add (if (gt (gqy-page-lines "javascript") 75) 4096 0)
    (add (if (gt (gqy-page-lines "go") 75) 8192 0)
    ;; FORM REFUSES THE STATEMENT PAGE, and this reading has now been wrong
    ;; twice in two directions. It first said Form "carries no slet row" —
    ;; inference; `(let x v)` inside its `(do ...)` sequence is exactly that.
    ;; So the row went in and the reading was rewritten to say Form renders the
    ;; whole page. It did render it, and the text was nonsense: Form's `ret`
    ;; spelled `%1` and its `sif` spelled `(if %1 %2 0)`, so a body of guarded
    ;; returns became `(do g1 g2 g3)` — guards evaluated, exits discarded,
    ;; final recursion unconditional. Run through fkwu the emitted function
    ;; died with `fk_vp: value stack overflow`.
    ;;
    ;; Both wrong claims passed a green reading, because Form has no runner row
    ;; and the reading measured TEXT. Corpus row 931, vacuous, twice inside the
    ;; correction that landed it. The counterfeit rows are gone; Form's honest
    ;; lane is the expression form, which steiner-form-codegen walks in-kernel.
    ;; A language that cannot exit early should refuse the statement page.
    (add (if (eq (str_len (gqy-module-page "form")) 0) 16384 0)
    ;; THE DELTA WITNESS. No single emitted program can prove it was generated
    ;; rather than typed — any one output could have been written by hand. What
    ;; a template cannot do is track a PREDICTED CHANGE in its input. Add one
    ;; fact to the graph and exactly one count answer rises by exactly one...
    (add (if (eq (gqy-delta-moved) 1) 32768 0)
    ;; ...while 108 of the other 109 stay identical. Not 109: the injected row
    ;; has subject == object, so the object-column count for the same key moves
    ;; too. That second mover is the delta landing exactly where the semantics
    ;; say it should, and pinning the count rather than rounding to "the rest" is the
    ;; difference between a witness and a slogan.
    (add (if (eq (gqy-delta-same) 108) 65536 0)
    ;; THE JOIN — the structure the 2x2 query table cannot hold. Four cloned
    ;; scanners and a dispatcher is a page by MEASUREMENT and one program by
    ;; STRUCTURE, and no number of extra count shapes buys a second shape of
    ;; program. Which relation pairs chain is READ FROM THE GRAPH: four of the
    ;; thirty-six possible pairs have a fact whose object under r1 is a fact's
    ;; subject under r2. Sweeping the rest would be questions with no path —
    ;; corpus row 930, thinmatch, wearing a bigger number.
    (add (if (eq (gqy-join-cases-n) 4) 131072 0)
         0)))))))))))))))))))

  0)
