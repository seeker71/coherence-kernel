  ; ── deterministic recipe identity ───────────────────────────────
  (defn cfd-edge (role meaning)
    (intern_node (cfd-cat-edge) (list role meaning)))
  (defn cfd-edge-role (edge) (nth (node_children edge) 0))
  (defn cfd-edge-role-index (edge)
    (node_value (nth (node_children (cfd-edge-role edge)) 0)))
  (defn cfd-role-index-member? (index edges)
    (if (eq (len edges) 0) 0
      (if (eq index (cfd-edge-role-index (head edges))) 1
        (cfd-role-index-member? index (tail edges)))))
  (defn cfd-unique-roles-loop? (edges seen)
    (if (eq (len edges) 0) 1
      (do (let edge (head edges))
        (let index (cfd-edge-role-index edge))
        (if (eq (cfd-role-index-member? index seen) 1) 0
          (cfd-unique-roles-loop? (tail edges) (cons edge seen))))))
  (defn cfd-unique-roles? (edges)
    (cfd-unique-roles-loop? edges (list)))
  (defn cfd-edge-insert (edge edges)
    (if (eq (len edges) 0) (list edge)
      (if (le (cfd-edge-role-index edge)
              (cfd-edge-role-index (head edges)))
        (cons edge edges)
        (cons (head edges) (cfd-edge-insert edge (tail edges))))))
  (defn cfd-edge-sort (edges sorted)
    (if (eq (len edges) 0) sorted
      (cfd-edge-sort (tail edges) (cfd-edge-insert (head edges) sorted))))
  (defn cfd-meaning (edges)
    (if (eq (cfd-unique-roles? edges) 0) (nothing)
      (intern_node (cfd-cat-meaning) (cfd-edge-sort edges (list)))))
  (defn cfd-e (role meaning) (cfd-edge role meaning))
  (defn cfd-child-at-role-loop (edges role)
    (if (eq (len edges) 0) (nothing)
      (if (node_eq (cfd-edge-role (head edges)) role)
        (nth (node_children (head edges)) 1)
        (cfd-child-at-role-loop (tail edges) role))))
  (defn cfd-child-at-role (meaning role)
    (cfd-child-at-role-loop (node_children meaning) role))

