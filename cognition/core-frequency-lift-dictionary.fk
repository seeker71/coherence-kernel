      (cfd-e (cfd-r-offer) (cfd-axiom-offer))
      (cfd-e (cfd-r-voluntary) (cfd-g-voluntary))
      (cfd-e (cfd-r-ack) (intern_trivial_int 1))
      (cfd-e (cfd-r-boundary) (cfd-axiom-boundary))
      (cfd-e (cfd-r-observation) (cfd-observation))
      (cfd-e (cfd-r-recovery) (cfd-recovery)))))
  (defn cfd-boundary-tending ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-sovereignty))
      (cfd-e (cfd-r-affected) (cfd-sovereignty))
      (cfd-e (cfd-r-boundary) (cfd-axiom-boundary))
      (cfd-e (cfd-r-observation) (cfd-observation))
      (cfd-e (cfd-r-relation) (cfd-care))
      (cfd-e (cfd-r-recovery) (cfd-recovery)))))
  (defn cfd-constraint ()
    (cfd-meaning (list
      (cfd-e (cfd-r-affected) (cfd-axiom-cell))
      (cfd-e (cfd-r-resource) (cfd-g-resource))
      (cfd-e (cfd-r-limit) (cfd-g-limit))
      (cfd-e (cfd-r-scope) (cfd-axiom-boundary))
      (cfd-e (cfd-r-movement) (cfd-change)))))
  (defn cfd-risk ()
    (cfd-meaning (list
      (cfd-e (cfd-r-affected) (cfd-axiom-cell))
      (cfd-e (cfd-r-observation) (cfd-axiom-states))
      (cfd-e (cfd-r-stake) (cfd-g-resource))
      (cfd-e (cfd-r-uncertainty) (cfd-g-uncertainty))
      (cfd-e (cfd-r-likelihood) (cfd-g-likelihood))
      (cfd-e (cfd-r-severity) (cfd-g-severity))
      (cfd-e (cfd-r-loss) (cfd-g-loss)))))
  (defn cfd-failure ()
    (cfd-meaning (list
      (cfd-e (cfd-r-intended) (cfd-g-intended))
      (cfd-e (cfd-r-actual) (cfd-g-actual))
      (cfd-e (cfd-r-difference) (cfd-axiom-states))
      (cfd-e (cfd-r-observation) (cfd-observation)))))
  (defn cfd-learning-response ()
    (cfd-meaning (list
      (cfd-e (cfd-r-observation) (cfd-failure))
      (cfd-e (cfd-r-guidance) (cfd-guidance))
      (cfd-e (cfd-r-movement) (cfd-change)))))
  (defn cfd-error ()
    (cfd-meaning (list
      (cfd-e (cfd-r-expected) (cfd-g-expected))
      (cfd-e (cfd-r-actual) (cfd-g-actual))
      (cfd-e (cfd-r-difference) (cfd-axiom-states))
      (cfd-e (cfd-r-observation) (cfd-observation)))))
  (defn cfd-rejection ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-sovereignty))
      (cfd-e (cfd-r-offer) (cfd-axiom-offer))
      (cfd-e (cfd-r-ack) (intern_trivial_int 0)))))
  (defn cfd-security ()
    (cfd-meaning (list
      (cfd-e (cfd-r-affected) (cfd-axiom-cell))
      (cfd-e (cfd-r-threat) (cfd-g-threat))
      (cfd-e (cfd-r-prevention) (cfd-g-prevention))
      (cfd-e (cfd-r-detection) (cfd-g-detection))
      (cfd-e (cfd-r-recovery) (cfd-recovery))
      (cfd-e (cfd-r-confidentiality) (cfd-g-confidentiality))
      (cfd-e (cfd-r-integrity) (cfd-g-integrity))
      (cfd-e (cfd-r-availability) (cfd-g-availability))
      (cfd-e (cfd-r-authenticity) (cfd-g-authenticity)))))
  (defn cfd-governance ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-organism))
      (cfd-e (cfd-r-decision) (cfd-g-decision))
      (cfd-e (cfd-r-right) (cfd-g-right))
      (cfd-e (cfd-r-allocation) (cfd-g-allocation))
      (cfd-e (cfd-r-resource) (cfd-g-resource))
      (cfd-e (cfd-r-accountability) (cfd-g-accountability))
      (cfd-e (cfd-r-conflict) (cfd-g-conflict))
      (cfd-e (cfd-r-power) (cfd-g-power))
      (cfd-e (cfd-r-boundary) (cfd-axiom-boundary)))))
  (defn cfd-validation ()
    (cfd-meaning (list
      (cfd-e (cfd-r-intended-use) (cfd-g-intended-use))
      (cfd-e (cfd-r-expected) (cfd-g-expected))
      (cfd-e (cfd-r-actual) (cfd-g-actual))
      (cfd-e (cfd-r-observation) (cfd-observation))
      (cfd-e (cfd-r-difference) (cfd-axiom-states))
      (cfd-e (cfd-r-criterion) (cfd-g-criterion))
      (cfd-e (cfd-r-threshold) (cfd-g-threshold))
      (cfd-e (cfd-r-evidence) (cfd-g-evidence)))))
  ; The surface "requirement" is not given one global frequency. These four
  ; recipes keep imposed demand, functional dependency, living need, and
  ; voluntarily chosen commitment distinct.
  (defn cfd-requirement-imposed ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-g-power))
      (cfd-e (cfd-r-affected) (cfd-sovereignty))
      (cfd-e (cfd-r-obligation) (cfd-g-obligation))
      (cfd-e (cfd-r-consequence) (cfd-g-consequence))
      (cfd-e (cfd-r-asymmetry) (cfd-g-asymmetry))
      (cfd-e (cfd-r-scope) (cfd-axiom-boundary)))))
  (defn cfd-requirement-dependency ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-axiom-cell))
      (cfd-e (cfd-r-relation) (cfd-composition))
      (cfd-e (cfd-r-invariant) (cfd-g-invariant))
      (cfd-e (cfd-r-resource) (cfd-g-resource))
      (cfd-e (cfd-r-scope) (cfd-axiom-boundary)))))
  (defn cfd-requirement-need ()
    (cfd-meaning (list
      (cfd-e (cfd-r-affected) (cfd-organism))
      (cfd-e (cfd-r-resource) (cfd-g-resource))
      (cfd-e (cfd-r-continuity) (cfd-continuity))
      (cfd-e (cfd-r-outcome) (cfd-vitality)))))
  (defn cfd-requirement-chosen ()
    (cfd-meaning (list
      (cfd-e (cfd-r-actor) (cfd-sovereignty))
      (cfd-e (cfd-r-affected) (cfd-sovereignty))
      (cfd-e (cfd-r-offer) (cfd-axiom-offer))
      (cfd-e (cfd-r-voluntary) (cfd-g-voluntary))
      (cfd-e (cfd-r-ack) (intern_trivial_int 1))
      (cfd-e (cfd-r-scope) (cfd-axiom-boundary))
      (cfd-e (cfd-r-revocable) (cfd-g-revocable)))))

  ; ── contexts and surfaces ────────────────────────────────────────
  ; Context = [domain, perspective, relation]. Zero in all coordinates means
  ; query all; it is never stored as an occurrence context.
  (defn cfd-context (domain perspective relation)
    (intern_node (cfd-cat-context)
      (list (intern_trivial_int domain)
            (intern_trivial_int perspective)
            (intern_trivial_int relation))))
  (defn cfd-context-any () (cfd-context 0 0 0))
  (defn cfd-perspective-first () 1)
  (defn cfd-perspective-descriptive () 2)
  (defn cfd-perspective-neutral () 3)
  (defn cfd-c-general ()       (cfd-context 1 3 1))
  (defn cfd-c-whole-organism () (cfd-context 14 3 1))
  (defn cfd-c-physical ()      (cfd-context 2 3 1))
  (defn cfd-c-self-update ()   (cfd-context 3 1 1))
  (defn cfd-c-institutional () (cfd-context 4 2 2))
  (defn cfd-c-feedback ()      (cfd-context 5 3 1))
  (defn cfd-c-experiment ()    (cfd-context 6 3 1))
  (defn cfd-c-expertise ()     (cfd-context 7 2 1))
  (defn cfd-c-relational ()    (cfd-context 8 1 2))
  (defn cfd-c-specification () (cfd-context 9 3 1))
  (defn cfd-c-coerced ()       (cfd-context 10 2 2))
  (defn cfd-c-legal ()         (cfd-context 11 2 2))
  (defn cfd-c-software ()      (cfd-context 12 3 1))
  (defn cfd-c-voluntary ()     (cfd-context 13 1 2))

  (defn cfd-surface (language text)
    (intern_node (cfd-cat-surface)
      (list (intern_trivial_string language) (intern_trivial_string text))))
  (defn cfd-surface-language (surface)
    (node_value (nth (node_children surface) 0)))
  (defn cfd-surface-text (surface)
    (node_value (nth (node_children surface) 1)))
  (defn cfd-en (text) (cfd-surface "en" text))

  ; Corpus occurrence and provenance are first-class. Claim states:
  ;   1 authored candidate, 2 surface relation attested,
  ;   3 participant-bound semantic selection attested.
  ; State 2 does not claim the candidate recipe is semantically admitted.
  (defn cfd-corpus (source revision)
    (intern_node (cfd-cat-corpus)
      (list (intern_trivial_string source) (intern_trivial_string revision))))
  (defn cfd-corpus-source (corpus)
    (node_value (nth (node_children corpus) 0)))
  (defn cfd-corpus-revision (corpus)
    (node_value (nth (node_children corpus) 1)))
  (defn cfd-occurrence (surface context corpus line column extent affected)
    (intern_node (cfd-cat-occurrence)
      (list surface context corpus
            (intern_trivial_int line)
            (intern_trivial_int column)
            (intern_trivial_int extent)
            affected)))
  (defn cfd-occ-surface (o) (nth (node_children o) 0))
  (defn cfd-occ-context (o) (nth (node_children o) 1))
  (defn cfd-occ-corpus (o) (nth (node_children o) 2))
  (defn cfd-occ-line (o) (node_value (nth (node_children o) 3)))
  (defn cfd-occ-affected (o) (nth (node_children o) 6))
  ; Surface projection mode 0 is direct; mode 1 is Unicode case-folding.
  ; Further modes may carry inflection, script, abbreviation, or other declared
  ; relations. Meaning identity never depends on byte identity.
  (defn cfd-surface-projection (occurrence-surface lexeme-surface mode)
    (intern_node (cfd-cat-surface-projection)
      (list occurrence-surface lexeme-surface (intern_trivial_int mode))))
  (defn cfd-sp-occurrence (p) (nth (node_children p) 0))
  (defn cfd-sp-lexeme (p) (nth (node_children p) 1))
  (defn cfd-sp-mode (p) (node_value (nth (node_children p) 2)))
  (defn cfd-provenance
    (occurrence projection origin coverage residue claim)
    (intern_node (cfd-cat-provenance)
      (list occurrence projection
            (intern_trivial_int origin)
            (intern_trivial_int coverage)
            (intern_trivial_int residue)
            (intern_trivial_int claim))))
  ; A crossing can retain its own content-addressed evidence as a seventh
  ; child. The first six positions stay compatible with the base provenance
  ; accessors and admission checks; claim state still decides what may open.
  (defn cfd-provenance-linked
    (occurrence projection origin coverage residue claim lineage-evidence)
    (intern_node (cfd-cat-provenance)
      (list occurrence projection
            (intern_trivial_int origin)
            (intern_trivial_int coverage)
            (intern_trivial_int residue)
            (intern_trivial_int claim)
            lineage-evidence)))
  (defn cfd-prov-occurrence (p) (nth (node_children p) 0))
  (defn cfd-prov-projection (p) (nth (node_children p) 1))
  (defn cfd-prov-origin (p) (node_value (nth (node_children p) 2)))
  (defn cfd-prov-coverage (p) (node_value (nth (node_children p) 3)))
  (defn cfd-prov-residue (p) (node_value (nth (node_children p) 4)))
  (defn cfd-prov-claim (p) (node_value (nth (node_children p) 5)))
  (defn cfd-prov-lineage-evidence (p)
    (if (gt (len (node_children p)) 6) (nth (node_children p) 6) (nothing)))
  (defn cfd-candidate-provenance (surface context ordinal)
    (do (let occurrence (cfd-occurrence surface context
      (cfd-corpus "authored-candidate"
        "core-frequency-lift-dictionary-v3") ordinal 0 0 (cfd-gap 100)))
      (cfd-provenance occurrence
        (cfd-surface-projection surface surface 0) 1 0 1 1)))
  (defn cfd-authority-occurrence-provenance ()
    (do (let exact-surface (cfd-en "Authority"))
      (let lexeme-surface (cfd-en "authority"))
      (let occurrence (cfd-occurrence exact-surface (cfd-c-institutional)
        (cfd-corpus "teachings/hati-suci-core-text-invitation.form"
          "4be91dcd8136eb933801820eb3cc4ead05f0d03249f137547cb171d9a51ebec5")
        16 1 9 (cfd-gap 100)))
      (cfd-provenance occurrence
        (cfd-surface-projection exact-surface lexeme-surface 1)
        2 1 1 2)))

  ; Mapping = [arriving surface, occurrence context, source meaning,
  ; faithful candidate surface, provenance]. The faithful surface is an
  ; authored projection and remains candidate until round-trip evidence lands.
  (defn cfd-mapping (surface context meaning faithful provenance)
    (intern_node (cfd-cat-mapping)
      (list surface context meaning faithful provenance)))
  (defn cfd-map-source (m) (nth (node_children m) 0))
  (defn cfd-map-context (m) (nth (node_children m) 1))
  (defn cfd-map-meaning (m) (nth (node_children m) 2))
  (defn cfd-map-faithful (m) (nth (node_children m) 3))
  (defn cfd-map-provenance (m) (nth (node_children m) 4))
  (defn cfd-map-evidence (m) (cfd-map-provenance m))
  (defn cfd-map-candidate (ordinal word context meaning phrase)
    (do (let source (cfd-en word))
      (cfd-mapping source context meaning (cfd-en phrase)
        (cfd-candidate-provenance source context ordinal))))
  (defn cfd-map-observed (word context meaning phrase provenance)
    (cfd-mapping (cfd-en word) context meaning (cfd-en phrase) provenance))

  (defn cfd-mappings ()
    (list
      (cfd-map-candidate 1 "safety" (cfd-c-whole-organism) (cfd-safety-whole)
        "whole-organism safety: harm awareness, integrity, trusted change, and recovery")
      (cfd-map-candidate 2 "safety" (cfd-c-physical) (cfd-safety-harm-prevention)
        "harm prevention, threat detection, integrity, and recovery")
      (cfd-map-candidate 3 "safety" (cfd-c-self-update) (cfd-trusted-becoming)
        "trusted becoming")
      (cfd-map-candidate 4 "permission" (cfd-c-institutional) (cfd-permission-external)
        "scoped authorization by another seat")
      (cfd-map-candidate 5 "control" (cfd-c-institutional) (cfd-control-external)
        "institutional direction shaping another participant's movement under a power asymmetry")
      (cfd-map-candidate 6 "control" (cfd-c-feedback) (cfd-control-feedback)
        "feedback regulation through observed difference")
      (cfd-map-candidate 7 "control" (cfd-c-experiment) (cfd-control-experimental)
        "experimental comparison condition")
      (cfd-map-candidate 8 "protection" (cfd-c-general) (cfd-protection)
        "specialized prevention, detection, integrity, and recovery")
      (cfd-map-observed "authority" (cfd-c-institutional) (cfd-authority-power)
        "scoped power within a jurisdiction" (cfd-authority-occurrence-provenance))
      (cfd-map-candidate 10 "authority" (cfd-c-expertise) (cfd-authority-expertise)
        "observed domain expertise")
      (cfd-map-candidate 11 "consent" (cfd-c-relational) (cfd-consent)
        "capable, comprehending, informed, voluntary, specific, ongoing, revocable yes")
      (cfd-map-candidate 12 "compliance" (cfd-c-specification) (cfd-compliance-specification)
        "observed conformance to a named specification")
      (cfd-map-candidate 13 "compliance" (cfd-c-coerced) (cfd-compliance-coerced)
        "conformity under obligation and force with imposed consequence and power asymmetry")
      (cfd-map-candidate 14 "enforcement" (cfd-c-legal) (cfd-enforcement-coercive)
        "authority imposes an obligation on an affected participant through force and consequence across a power asymmetry")
      (cfd-map-candidate 15 "enforcement" (cfd-c-software) (cfd-enforcement-mechanical)
        "mechanical observation of an invariant and limit with a defined consequence")
      (cfd-map-candidate 16 "enforcement" (cfd-c-voluntary) (cfd-enforcement-voluntary)
        "follow-through on a voluntarily acknowledged boundary")
      (cfd-map-candidate 17 "constraint" (cfd-c-general) (cfd-constraint)
        "a limit borne by something across a resource, scope, or movement")
      (cfd-map-candidate 18 "risk" (cfd-c-general) (cfd-risk)
        "uncertainty about a valued stake with possible loss, likelihood, and severity")
      (cfd-map-candidate 19 "failure" (cfd-c-general) (cfd-failure)
        "an observed difference between an intended and actual outcome")
      (cfd-map-candidate 20 "error" (cfd-c-general) (cfd-error)
        "an observed difference between expected and actual state")
      (cfd-map-candidate 21 "rejection" (cfd-c-general) (cfd-rejection)
        "a complete decline")
      (cfd-map-candidate 22 "security" (cfd-c-general) (cfd-security)
        "threat prevention, detection, and recovery across confidentiality, integrity, availability, and authenticity")
      (cfd-map-candidate 23 "governance" (cfd-c-general) (cfd-governance)
        "decision rights, resource allocation, accountability, conflict, power, and boundary in a shared body")
      (cfd-map-candidate 24 "validation" (cfd-c-general) (cfd-validation)
        "evidence against criteria and threshold for correspondence with an intended use")
      (cfd-map-candidate 25 "requirement" (cfd-c-institutional)
        (cfd-requirement-imposed)
        "a demand imposed on another participant with consequence and power asymmetry visible")
      (cfd-map-candidate 26 "requirement" (cfd-c-specification)
        (cfd-requirement-dependency)
        "a named condition on which a function or composition depends")
      (cfd-map-candidate 27 "requirement" (cfd-c-whole-organism)
        (cfd-requirement-need)
        "a living need that supports continuity and vitality")
      (cfd-map-candidate 28 "requirement" (cfd-c-voluntary)
        (cfd-requirement-chosen)
        "a voluntarily chosen, scoped, and revocable commitment")))

  (defn cfd-context-matches? (query actual)
    (if (node_eq query (cfd-context-any)) 1
      (if (node_eq query actual) 1 0)))
  (defn cfd-surface-matches? (surface language text)
    (if (and (str_eq (cfd-surface-language surface) language)
             (str_eq (cfd-surface-text surface) text)) 1 0))
  (defn cfd-parse-loop (mappings language text context)
    (if (eq (len mappings) 0) (list)
      (do (let mapping (head mappings))
        (if (and (eq (cfd-surface-matches?
                        (cfd-map-source mapping) language text) 1)
                 (eq (cfd-context-matches?
                        context (cfd-map-context mapping)) 1))
          (cons mapping (cfd-parse-loop (tail mappings) language text context))
          (cfd-parse-loop (tail mappings) language text context)))))
  (defn cfd-parse (language text context)
    (cfd-parse-loop (cfd-mappings) language text context))
  ; Extension organs can offer additional mapping lists without being folded
  ; into this English seed or creating an import cycle.
  (defn cfd-parse-in (mappings language text context)
    (cfd-parse-loop mappings language text context))

  ; Rendering begins from an explicitly selected meaning, never a source word.
  (defn cfd-render-loop (mappings meaning language context)
    (if (not (node_eq (node_category meaning) (cfd-cat-meaning))) (list)
    (if (eq (len mappings) 0) (list)
      (do (let mapping (head mappings))
        (let faithful (cfd-map-faithful mapping))
        (if (and (node_eq (cfd-map-meaning mapping) meaning)
            (and (str_eq (cfd-surface-language faithful) language)
                 (eq (cfd-context-matches?
                        context (cfd-map-context mapping)) 1)))
          (cons faithful (cfd-render-loop
            (tail mappings) meaning language context))
          (cfd-render-loop (tail mappings) meaning language context))))))
  (defn cfd-render (meaning language context)
    (cfd-render-loop (cfd-mappings) meaning language context))
  (defn cfd-render-in (mappings meaning language context)
    (cfd-render-loop mappings meaning language context))
  ; Reverse projection is a graph query, not semantic rendering. It returns
  ; whole mappings so provenance and candidate state cannot be stripped away.
  (defn cfd-project-loop (mappings anchor language context)
    (if (eq (len mappings) 0) (list)
      (do (let mapping (head mappings))
        (let source (cfd-map-source mapping))
        (if (and (node_eq (cfd-map-meaning mapping) anchor)
            (and (str_eq (cfd-surface-language source) language)
                 (eq (cfd-context-matches?
                        context (cfd-map-context mapping)) 1)))
          (cons mapping (cfd-project-loop
            (tail mappings) anchor language context))
          (cfd-project-loop (tail mappings) anchor language context)))))
  (defn cfd-project-in (mappings anchor language context)
    (cfd-project-loop mappings anchor language context))
  (defn cfd-render-selected (meaning language context)
    (do (let surfaces (cfd-render meaning language context))
      (if (eq (len surfaces) 1) (head surfaces) (nothing))))
  (defn cfd-render-selected-text (meaning language context)
    (do (let surface (cfd-render-selected meaning language context))
      (if (nothing? surface) (nothing) (cfd-surface-text surface))))

  ; ── optional alternatives: never overwrite the source sense ──────
  ; Delta is computed from the source and alternative top-level role graphs.
  ; It records [preserved, removed, added]; no authored change may appear in a
  ; delta unless it is present in the corresponding recipe comparison.
  (defn cfd-edge-member? (edge edges)
    (if (eq (len edges) 0) 0
      (if (node_eq edge (head edges)) 1
        (cfd-edge-member? edge (tail edges)))))
  (defn cfd-edge-intersection (left right)
    (if (eq (len left) 0) (list)
      (if (eq (cfd-edge-member? (head left) right) 1)
        (cons (head left) (cfd-edge-intersection (tail left) right))
        (cfd-edge-intersection (tail left) right))))
  (defn cfd-edge-difference (left right)
    (if (eq (len left) 0) (list)
      (if (eq (cfd-edge-member? (head left) right) 1)
        (cfd-edge-difference (tail left) right)
        (cons (head left) (cfd-edge-difference (tail left) right)))))
  (defn cfd-delta (preserved removed added)
    (intern_node (cfd-cat-delta) (list preserved removed added)))
  (defn cfd-delta-preserved (d) (nth (node_children d) 0))
  (defn cfd-delta-removed (d) (nth (node_children d) 1))
  (defn cfd-delta-added (d) (nth (node_children d) 2))
  (defn cfd-compute-delta (source alternative)
    (do (let source-edges (node_children source))
      (let alternative-edges (node_children alternative))
      (cfd-delta
        (cfd-meaning (cfd-edge-intersection source-edges alternative-edges))
        (cfd-meaning (cfd-edge-difference source-edges alternative-edges))
        (cfd-meaning (cfd-edge-difference alternative-edges source-edges)))))
  (defn cfd-transform (source alternative context perspective delta)
    (intern_node (cfd-cat-transform)
      (list source alternative context
            (intern_trivial_int perspective) delta)))
  (defn cfd-t-source (t) (nth (node_children t) 0))
  (defn cfd-t-alternative (t) (nth (node_children t) 1))
  (defn cfd-t-context (t) (nth (node_children t) 2))
  (defn cfd-t-perspective (t) (node_value (nth (node_children t) 3)))
  (defn cfd-t-delta (t) (nth (node_children t) 4))
  (defn cfd-voluntary-enforcement-delta ()
    (cfd-compute-delta
      (cfd-enforcement-voluntary) (cfd-boundary-tending)))
  (defn cfd-transforms ()
    (list
      (cfd-transform (cfd-enforcement-voluntary) (cfd-boundary-tending)
        (cfd-c-voluntary) (cfd-perspective-first)
        (cfd-voluntary-enforcement-delta))))
  (defn cfd-node-member? (node nodes)
    (if (eq (len nodes) 0) 0
      (if (node_eq node (head nodes)) 1
        (cfd-node-member? node (tail nodes)))))
  (defn cfd-transform-find-loop (transforms source alternative context perspective)
    (if (eq (len transforms) 0) (nothing)
      (do (let transform (head transforms))
        (if (and (node_eq (cfd-t-source transform) source)
            (and (node_eq (cfd-t-alternative transform) alternative)
            (and (node_eq (cfd-t-context transform) context)
                 (eq (cfd-t-perspective transform) perspective))))
          transform
          (cfd-transform-find-loop (tail transforms)
            source alternative context perspective)))))
  (defn cfd-transform-find (source alternative context perspective)
    (cfd-transform-find-loop (cfd-transforms)
      source alternative context perspective))
  (defn cfd-participant (index)
    (cfd-indexed (cfd-cat-participant) index))
  (defn cfd-selection (occurrence mapping participant perspective
                        acknowledgement current revocable)
    (intern_node (cfd-cat-selection)
      (list occurrence mapping participant
            (intern_trivial_int perspective)
            (intern_trivial_int acknowledgement)
            (intern_trivial_int current)
            (intern_trivial_int revocable))))
  (defn cfd-s-occurrence (s) (nth (node_children s) 0))
  (defn cfd-s-mapping (s) (nth (node_children s) 1))
  (defn cfd-s-participant (s) (nth (node_children s) 2))
  (defn cfd-s-perspective (s) (node_value (nth (node_children s) 3)))
  (defn cfd-s-ack (s) (node_value (nth (node_children s) 4)))
  (defn cfd-s-current (s) (node_value (nth (node_children s) 5)))
  (defn cfd-s-revocable (s) (node_value (nth (node_children s) 6)))
  (defn cfd-proposal (transform selection)
    (intern_node (cfd-cat-proposal)
      (list transform selection)))
  (defn cfd-p-transform (p) (nth (node_children p) 0))
  (defn cfd-p-selection (p) (nth (node_children p) 1))
  (defn cfd-selection-mapping-bound? (selection transform)
    (do (let mapping (cfd-s-mapping selection))
      (if (and (eq (cfd-node-member? mapping (cfd-mappings)) 1)
          (and (node_eq (cfd-map-meaning mapping) (cfd-t-source transform))
               (node_eq (cfd-map-context mapping) (cfd-t-context transform)))) 1 0)))
  (defn cfd-selection-occurrence-bound? (selection)
    (do (let occurrence (cfd-s-occurrence selection))
      (let mapping (cfd-s-mapping selection))
      (let provenance (cfd-map-provenance mapping))
      (let projection (cfd-prov-projection provenance))
      (if (and (node_eq occurrence (cfd-prov-occurrence provenance))
          (and (node_eq (cfd-sp-occurrence projection)
                        (cfd-occ-surface occurrence))
          (and (node_eq (cfd-sp-lexeme projection) (cfd-map-source mapping))
          (and (or (eq (cfd-sp-mode projection) 0)
                   (eq (cfd-sp-mode projection) 1))
               (node_eq (cfd-occ-context occurrence)
                        (cfd-map-context mapping)))))) 1 0)))
  (defn cfd-selection-participant-bound? (selection)
    (do (let participant (cfd-s-participant selection))
      (let occurrence (cfd-s-occurrence selection))
      (if (and (node_eq (node_category participant) (cfd-cat-participant))
               (node_eq participant (cfd-occ-affected occurrence))) 1 0)))
  (defn cfd-selection-current-consent? (selection transform)
    (if (and (eq (cfd-s-perspective selection) (cfd-t-perspective transform))
        (and (eq (cfd-s-ack selection) 1)
        (and (eq (cfd-s-current selection) 1)
             (eq (cfd-s-revocable selection) 1)))) 1 0))
  (defn cfd-selection-valid-for? (selection transform)
    (if (not (node_eq (node_category selection) (cfd-cat-selection))) 0
      (do (let mapping (cfd-s-mapping selection))
        (let provenance (cfd-map-provenance mapping))
        (if (and (eq (cfd-selection-mapping-bound? selection transform) 1)
            (and (eq (cfd-selection-occurrence-bound? selection) 1)
            (and (eq (cfd-selection-participant-bound? selection) 1)
            (and (eq (cfd-selection-current-consent? selection transform) 1)
                 (eq (cfd-prov-claim provenance) 3))))) 1 0))))
  (defn cfd-proposal-valid? (proposal)
    (do (let transform (cfd-p-transform proposal))
      (if (eq (cfd-node-member? transform (cfd-transforms)) 0) 0
        (if (not (node_eq (cfd-t-delta transform)
                          (cfd-compute-delta
                            (cfd-t-source transform)
                            (cfd-t-alternative transform)))) 0
          (cfd-selection-valid-for? (cfd-p-selection proposal) transform)))))

  ; Alternative surfaces are data behind the validated labeled-offer path.
  ; The table currently carries one English projection; language availability
  ; is absence/presence in data, not an English admission branch.
  (defn cfd-alternative-surface-data ()
    (list (list (cfd-boundary-tending) (cfd-c-voluntary)
                "en" (cfd-en "boundary tending"))))
  (defn cfd-alternative-surface-find-loop (rows meaning context language)
    (if (eq (len rows) 0) (nothing)
      (do (let row (head rows))
        (if (and (node_eq (nth row 0) meaning)
            (and (node_eq (nth row 1) context)
                 (str_eq (nth row 2) language)))
          (nth row 3)
          (cfd-alternative-surface-find-loop
            (tail rows) meaning context language)))))
  (defn cfd-alternative-surface-find (meaning context language)
    (cfd-alternative-surface-find-loop
      (cfd-alternative-surface-data) meaning context language))
  (defn cfd-render-offer (source alternative delta)
    (intern_node (cfd-cat-render-offer) (list source alternative delta)))
  (defn cfd-ro-source (offer) (nth (node_children offer) 0))
  (defn cfd-ro-alternative (offer) (nth (node_children offer) 1))
  (defn cfd-ro-delta (offer) (nth (node_children offer) 2))
  (defn cfd-proposal-render (proposal language)
    (if (eq (cfd-proposal-valid? proposal) 0) (nothing)
      (do (let transform (cfd-p-transform proposal))
        (let source (cfd-render-selected
          (cfd-t-source transform) language (cfd-t-context transform)))
        (let alternative (cfd-alternative-surface-find
          (cfd-t-alternative transform) (cfd-t-context transform) language))
        (if (and (not (nothing? source)) (not (nothing? alternative)))
          (cfd-render-offer source alternative
            (cfd-t-delta transform))
          (nothing)))))

  ; Frequency is deliberately separate and empty until corpus observations land.
  (defn cfd-frequency-observations () (list))
  (defn cfd-frequency-for (mapping)
    (nothing))

  ; ── structural witnesses ─────────────────────────────────────────
  (defn cfd-reaches-children? (children target fuel)
    (if (eq (len children) 0) 0
      (if (le fuel 0) (nothing)
        (do (let here (cfd-reaches? (head children) target (sub fuel 1)))
          (if (eq here 1) 1
            (do (let rest (cfd-reaches-children? (tail children) target fuel))
              (if (eq rest 1) 1
                (if (or (nothing? here) (nothing? rest)) (nothing) 0))))))))
  (defn cfd-reaches? (node target fuel)
    (if (node_eq node target) 1
      (do (let children (node_children node))
        (if (eq (len children) 0) 0
          (if (le fuel 0) (nothing)
            (cfd-reaches-children? children target fuel))))))
  (defn cfd-no-surface-children? (children fuel)
    (if (eq (len children) 0) 1
      (if (le fuel 0) (nothing)
        (do (let here (cfd-no-surface? (head children) (sub fuel 1)))
          (if (eq here 0) 0
            (do (let rest (cfd-no-surface-children? (tail children) fuel))
              (if (eq rest 0) 0
                (if (or (nothing? here) (nothing? rest)) (nothing) 1))))))))
  (defn cfd-no-surface? (node fuel)
    (if (node_eq (node_category node) (cfd-cat-surface)) 0
      (do (let children (node_children node))
        (if (eq (len children) 0) 1
          (if (le fuel 0) (nothing)
            (cfd-no-surface-children? children fuel))))))
  (defn cfd-all-mapping-meanings-pure? (mappings)
    (if (eq (len mappings) 0) 1
      (if (eq (cfd-no-surface? (cfd-map-meaning (head mappings)) 64) 1)
        (cfd-all-mapping-meanings-pure? (tail mappings)) 0)))
  (defn cfd-all-mapping-meanings-real? (mappings)
    (if (eq (len mappings) 0) 1
      (do (let meaning (cfd-map-meaning (head mappings)))
        (if (and (node_eq (node_category meaning) (cfd-cat-meaning))
                 (gt (len (node_children meaning)) 0))
          (cfd-all-mapping-meanings-real? (tail mappings)) 0))))

  0)
