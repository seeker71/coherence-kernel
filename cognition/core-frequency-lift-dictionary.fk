  (defn cfd-indexed (category index)
    (intern_node category (list (intern_trivial_int index))))
  (defn cfd-axiom (index) (cfd-indexed (cfd-cat-axiom) index))
  (defn cfd-role (index) (cfd-indexed (cfd-cat-role) index))
  (defn cfd-gap (index) (cfd-indexed (cfd-cat-gap) index))
  (defn cfd-evidence (index) (cfd-indexed (cfd-cat-evidence) index))

