    // ── deterministic recipe identity ───────────────────────────────
    def cfd-edge(role, meaning) = intern_node(cfd-cat-edge(), [role, meaning]);
    def cfd-edge-role(edge) = node_children(edge)[0];
    def cfd-edge-role-index(edge) = node_value(node_children(cfd-edge-role(edge))[0]);
    def cfd-role-index-member?(index, edges) = (Comparable) len(edges) == 0 ? 0 : (Comparable) index == cfd-edge-role-index(edges[0]) ? 1 : cfd-role-index-member?(index, edges[1:]);
    def cfd-unique-roles-loop?(edges, seen) = (Comparable) len(edges) == 0 ? 1 : {
        let edge = edges[0];
        let index = cfd-edge-role-index(edge);
        (Comparable) cfd-role-index-member?(index, seen) == 1 ? 0 : cfd-unique-roles-loop?(edges[1:], cons(edge, seen));
    };
    def cfd-unique-roles?(edges) = cfd-unique-roles-loop?(edges, []);
    def cfd-edge-insert(edge, edges) = (Comparable) len(edges) == 0 ? [edge] : cfd-edge-role-index(edge) <= cfd-edge-role-index(edges[0]) ? cons(edge, edges) : cons(edges[0], cfd-edge-insert(edge, edges[1:]));
    def cfd-edge-sort(edges, sorted) = (Comparable) len(edges) == 0 ? sorted : cfd-edge-sort(edges[1:], cfd-edge-insert(edges[0], sorted));
    def cfd-meaning(edges) = (Comparable) cfd-unique-roles?(edges) == 0 ? nothing() : intern_node(cfd-cat-meaning(), cfd-edge-sort(edges, []));
