    def cfd-render-offer(source, alternative, delta) = intern_node(cfd-cat-render-offer(), [source, alternative, delta]);
    def cfd-ro-source(offer) = node_children(offer)[0];
    def cfd-ro-alternative(offer) = node_children(offer)[1];
    def cfd-ro-delta(offer) = node_children(offer)[2];
    def cfd-proposal-render(proposal, language) = (Comparable) cfd-proposal-valid?(proposal) == 0 ? nothing() : {
        let transform = cfd-p-transform(proposal);
        let source = cfd-render-selected(cfd-t-source(transform), language, cfd-t-context(transform));
        let alternative = cfd-alternative-surface-find(cfd-t-alternative(transform), cfd-t-context(transform), language);
        !nothing?(source) && !nothing?(alternative) ? cfd-render-offer(source, alternative, cfd-t-delta(transform)) : nothing();
    };
    // Frequency is deliberately separate and empty until corpus observations land.
    def cfd-frequency-observations() = [];
    def cfd-frequency-for(mapping) = nothing();
    // ── structural witnesses ─────────────────────────────────────────
    def cfd-reaches-children?(children, target, fuel) = (Comparable) len(children) == 0 ? 0 : fuel <= 0 ? nothing() : {
        let here = cfd-reaches?(children[0], target, fuel - 1);
        (Comparable) here == 1 ? 1 : {
            let rest = cfd-reaches-children?(children[1:], target, fuel);
            (Comparable) rest == 1 ? 1 : nothing?(here) || nothing?(rest) ? nothing() : 0;
        };
    };
    def cfd-reaches?(node, target, fuel) = node_eq(node, target) ? 1 : {
        let children = node_children(node);
        (Comparable) len(children) == 0 ? 0 : fuel <= 0 ? nothing() : cfd-reaches-children?(children, target, fuel);
    };
    def cfd-no-surface-children?(children, fuel) = (Comparable) len(children) == 0 ? 1 : fuel <= 0 ? nothing() : {
        let here = cfd-no-surface?(children[0], fuel - 1);
        (Comparable) here == 0 ? 0 : {
            let rest = cfd-no-surface-children?(children[1:], fuel);
            (Comparable) rest == 0 ? 0 : nothing?(here) || nothing?(rest) ? nothing() : 1;
        };
    };
    def cfd-no-surface?(node, fuel) = node_eq(node_category(node), cfd-cat-surface()) ? 0 : {
        let children = node_children(node);
        (Comparable) len(children) == 0 ? 1 : fuel <= 0 ? nothing() : cfd-no-surface-children?(children, fuel);
    };
    def cfd-all-mapping-meanings-pure?(mappings) = (Comparable) len(mappings) == 0 ? 1 : (Comparable) cfd-no-surface?(cfd-map-meaning(mappings[0]), 64) == 1 ? cfd-all-mapping-meanings-pure?(mappings[1:]) : 0;
    def cfd-all-mapping-meanings-real?(mappings) = (Comparable) len(mappings) == 0 ? 1 : {
        let meaning = cfd-map-meaning(mappings[0]);
        node_eq(node_category(meaning), cfd-cat-meaning()) && len(node_children(meaning)) > 0 ? cfd-all-mapping-meanings-real?(mappings[1:]) : 0;
    };
    0;
}
