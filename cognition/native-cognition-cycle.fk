// native-cognition-cycle.fk — learned knowledge becomes inquiry, awareness,
// recognition, action, response, and routing through one witnessed cycle.
import "../learn/nl-meaning-error-adaptation.fk"
import "../observe/bidirectional-framebuffer-channel.fk"
section [form.bml] {
    // accumulator = [rows, agree, disagree, native-correct, native-wrong,
    //                 caught-base-errors, inquiry-replays, continue-actions,
    //                 evidence-actions, notable-records]
    def ncc-acc() = [0, 0, 0, 0, 0, 0, 0, 0, 0, []];
    // A recognition response is [nothing,0,1,alternative,ack,action,route].
    // route 0=native response, 1=evidence request.
    def ncc-response(alternative, ack, action, route) = [nothing(), 0, 1, alternative, ack, action, route];
    // [best-id, best-distance, second-distance]. This exposes recognition margin
    // without changing nmn-classify or inferring confidence from agreement alone.
    def ncc-top2-loop(y, protos, best-id, best-distance, second-distance) = (Comparable) len(protos) == 0 ? [best-id, best-distance, second-distance] : {
        let proto = protos[0];
        let distance = nmn-dist2(y, proto[1]);
        distance < best-distance ? ncc-top2-loop(y, protos[1:], proto[0], distance, best-distance) : distance < second-distance ? ncc-top2-loop(y, protos[1:], best-id, best-distance, distance) : ncc-top2-loop(y, protos[1:], best-id, best-distance, second-distance);
    };
    def ncc-top2(stack, row, protos) = ncc-top2-loop(nmn-predict(stack, nmn-vec-norm(nmc-ex-text(row), nmil-d()), nmil-eps()), protos, -1, 999999999.0, 999999999.0);
    def ncc-margin-observe(rows, index, base, rehearsal, protos, records) = (Comparable) len(rows) == 0 ? records : {
        let row = rows[0];
        let truth = nmc-ex-class(row);
        let base-pred = nmea-predict(base, row, protos);
        let top2 = ncc-top2(rehearsal, row, protos);
        let pred = top2[0];
        !((Comparable) base-pred == pred) ? ncc-margin-observe(rows[1:], (Number) index + (Number) 1, base, rehearsal, protos, records) : {
            let margin = top2[2] - top2[1];
            let record = [nmn-hash(nmc-ex-text(row)), len(nmc-ex-text(row)), truth, pred, top2[1], margin, (Comparable) truth == pred ? 1 : 0];
            let event = fb_record(intern_trivial_int(index), "native-cognition-cycle.fk", (Number) 100 + (Number) index);
            ncc-margin-observe(rows[1:], (Number) index + (Number) 1, base, rehearsal, protos, cons(record, records));
        };
    };
    def ncc-margin-witness() = {
        let original = nmil-training-raw();
        let split = nmea-split(nmil-held-raw());
        let adapt = split[0];
        let eval = split[1];
        let protos = nmil-protos();
        let base = nmn-train(nmn-stack(nmil-d()), nmil-encode-training(original), 0.02, nmil-eps(), 40);
        let errors = nmea-errors(base, adapt, protos);
        let replay = nmc-concat(nmil-encode-training(original), nmil-encode-training(errors));
        let rehearsal = nmn-train(base, replay, 0.01, nmil-eps(), 20);
        framebuffer-clear();
        let records = ncc-margin-observe(eval, 1, base, rehearsal, protos, []);
        [nothing(), 0, 1, 1001099009, len(records), len(framebuffer-events()), records, (Comparable) len(records) == 18 && (Comparable) len(framebuffer-events()) == 18 ? 1 : 0];
    };
    // Independent recognition from nearest native lexical training example.
    // This does not reuse either network's transformed prediction.
    def ncc-knn-loop(x, training, best-class, best-distance) = (Comparable) len(training) == 0 ? best-class : {
        let candidate = training[0];
        let distance = nmn-dist2(x, nmn-vec-norm(nmc-ex-text(candidate), nmil-d()));
        distance < best-distance ? ncc-knn-loop(x, training[1:], nmc-ex-class(candidate), distance) : ncc-knn-loop(x, training[1:], best-class, best-distance);
    };
    def ncc-knn-predict(row, training) = ncc-knn-loop(nmn-vec-norm(nmc-ex-text(row), nmil-d()), training, -1, 999999999.0);
    // A representation-independent lexical reader: exact tokens, no hash buckets
    // and no trained network transform. Class evidence is learned by summing token
    // overlap against every training row of that class.
    def ncc-token-member?(token, words) = (Comparable) len(words) == 0 ? 0 : (String) token == words[0] ? 1 : ncc-token-member?(token, words[1:]);
    def ncc-overlap(query-words, row-words) = (Comparable) len(query-words) == 0 ? 0 : (Number) ncc-token-member?(query-words[0], row-words) + (Number) ncc-overlap(query-words[1:], row-words);
    def ncc-lexical-score(query-words, training, class-id) = (Comparable) len(training) == 0 ? 0 : (Number) ((Comparable) nmc-ex-class(training[0]) == class-id ? ncc-overlap(query-words, re-split(nmc-ex-text(training[0]))) : 0) + (Number) ncc-lexical-score(query-words, training[1:], class-id);
    def ncc-lexical-best(query, training, class-id, best-id, best-score) = class-id >= 4 ? best-id : {
        let score = ncc-lexical-score(query, training, class-id);
        score > best-score ? ncc-lexical-best(query, training, (Number) class-id + (Number) 1, class-id, score) : ncc-lexical-best(query, training, (Number) class-id + (Number) 1, best-id, best-score);
    };
    def ncc-lexical-predict(row, training) = ncc-lexical-best(re-split(nmc-ex-text(row)), training, 0, -1, -1);
    // accumulator matches ncc-observe, plus every notable record carries kNN.
    def ncc-triangulated-observe(rows, index, training, base, rehearsal, protos, acc) = (Comparable) len(rows) == 0 ? acc : {
        let row = rows[0];
        let truth = nmc-ex-class(row);
        let base-pred = nmea-predict(base, row, protos);
        let rehearsal-pred = nmea-predict(rehearsal, row, protos);
        let knn-pred = ncc-lexical-predict(row, training);
        let recognized = (Comparable) base-pred == rehearsal-pred && (Comparable) rehearsal-pred == knn-pred ? 1 : 0;
        let action = (Comparable) recognized == 1 ? 0 : 4;
        let route = (Comparable) action == 0 ? 0 : 1;
        let node = lnii-node-for-meaning((Number) 301 + (Number) rehearsal-pred);
        let subject = lnii-subject(node);
        let alternative = nid-alternative(subject, 0);
        let inquiry-ok = (Comparable) route == 0 ? lnii-lanes-ok(subject, 0, 0) : 0;
        let outbound = bfc-envelope(0, index, 0, [base-pred, rehearsal-pred, knn-pred, recognized], alternative);
        let out-event = bfc-record-out(outbound, (Number) 200 + (Number) (index * 2));
        let inbound = bfc-control(outbound, action);
        let in-event = bfc-record-in(inbound, (Number) 201 + (Number) (index * 2));
        let native-correct = (Comparable) route == 0 && (Comparable) rehearsal-pred == truth ? 1 : 0;
        let native-wrong = (Comparable) route == 0 && !((Comparable) rehearsal-pred == truth) ? 1 : 0;
        let caught = (Comparable) route == 1 && !((Comparable) rehearsal-pred == truth) ? 1 : 0;
        let notable = (Comparable) recognized == 0 || (Comparable) native-wrong == 1 ? cons([nmn-hash(nmc-ex-text(row)), len(nmc-ex-text(row)), truth, base-pred, rehearsal-pred, knn-pred, recognized, action, route], acc[9]) : acc[9];
        ncc-triangulated-observe(rows[1:], (Number) index + (Number) 1, training, base, rehearsal, protos, [(Number) acc[0] + (Number) 1, (Number) acc[1] + (Number) recognized, (Number) acc[2] + (Number) ((Comparable) recognized == 0 ? 1 : 0), (Number) acc[3] + (Number) native-correct, (Number) acc[4] + (Number) native-wrong, (Number) acc[5] + (Number) caught, (Number) acc[6] + (Number) inquiry-ok, (Number) acc[7] + (Number) ((Comparable) action == 0 ? 1 : 0), (Number) acc[8] + (Number) ((Comparable) action == 4 ? 1 : 0), notable]);
    };
    def ncc-triangulated-witness-window(clear-window) = {
        let original = nmil-training-raw();
        let split = nmea-split(nmil-held-raw());
        let adapt = split[0];
        let eval = split[1];
        let protos = nmil-protos();
        let base = nmn-train(nmn-stack(nmil-d()), nmil-encode-training(original), 0.02, nmil-eps(), 40);
        let errors = nmea-errors(base, adapt, protos);
        let replay = nmc-concat(nmil-encode-training(original), nmil-encode-training(errors));
        let rehearsal = nmn-train(base, replay, 0.01, nmil-eps(), 20);
        let cleared = (Comparable) clear-window == 1 ? framebuffer-clear() : 0;
        let frame-start = len(framebuffer-events());
        let r = ncc-triangulated-observe(eval, 1, original, base, rehearsal, protos, ncc-acc());
        let rows = r[0];
        let agree = r[1];
        let disagree = r[2];
        let correct = r[3];
        let wrong = r[4];
        let caught = r[5];
        let inquiries = r[6];
        let frames = len(framebuffer-events()) - frame-start;
        [nothing(), 0, 1, 1001099010, rows, agree, disagree, correct, wrong, caught, inquiries, agree * 7, r[7], r[8], frames, r[9], (Comparable) ((Number) agree + (Number) disagree) == rows && ((Comparable) wrong == 0 && ((Comparable) inquiries == agree * 7 && ((Comparable) frames == rows * 2 && caught > 0))) ? 1 : 0];
    };
    def ncc-triangulated-witness() = ncc-triangulated-witness-window(1);
    def ncc-triangulated-witness-keep-window() = ncc-triangulated-witness-window(0);
    def ncc-observe(rows, index, base, rehearsal, protos, acc) = (Comparable) len(rows) == 0 ? acc : {
        let row = rows[0];
        let truth = nmc-ex-class(row);
        let base-pred = nmea-predict(base, row, protos);
        let rehearsal-pred = nmea-predict(rehearsal, row, protos);
        // Awareness is direct model agreement, not correctness.
        let recognized = (Comparable) base-pred == rehearsal-pred ? 1 : 0;
        let action = (Comparable) recognized == 1 ? 0 : 4;
        let route = (Comparable) action == 0 ? 0 : 1;
        let node = lnii-node-for-meaning((Number) 301 + (Number) rehearsal-pred);
        let subject = lnii-subject(node);
        let alternative = nid-alternative(subject, 0);
        let inquiry-ok = (Comparable) route == 0 ? lnii-lanes-ok(subject, 0, 0) : 0;
        let ack = (Comparable) route == 0 ? node : nothing();
        let response = ncc-response(alternative, ack, action, route);
        // The observation flows out; recognition control flows back. Correlation
        // is the held-out row index and both directions are retained.
        let outbound = bfc-envelope(0, index, 0, [base-pred, rehearsal-pred, recognized], alternative);
        let out-event = bfc-record-out(outbound, index * 2);
        let inbound = bfc-control(outbound, action);
        let in-event = bfc-record-in(inbound, (Number) (index * 2) + (Number) 1);
        let native-correct = (Comparable) route == 0 && (Comparable) rehearsal-pred == truth ? 1 : 0;
        let native-wrong = (Comparable) route == 0 && !((Comparable) rehearsal-pred == truth) ? 1 : 0;
        let caught = (Comparable) route == 1 && !((Comparable) base-pred == truth) ? 1 : 0;
        // Retain every disagreement and every incorrectly recognized row.
        let notable = (Comparable) recognized == 0 || (Comparable) native-wrong == 1 ? cons([nmn-hash(nmc-ex-text(row)), len(nmc-ex-text(row)), truth, base-pred, rehearsal-pred, recognized, action, route, nothing?(response[4])], acc[9]) : acc[9];
        ncc-observe(rows[1:], (Number) index + (Number) 1, base, rehearsal, protos, [(Number) acc[0] + (Number) 1, (Number) acc[1] + (Number) recognized, (Number) acc[2] + (Number) ((Comparable) recognized == 0 ? 1 : 0), (Number) acc[3] + (Number) native-correct, (Number) acc[4] + (Number) native-wrong, (Number) acc[5] + (Number) caught, (Number) acc[6] + (Number) inquiry-ok, (Number) acc[7] + (Number) ((Comparable) action == 0 ? 1 : 0), (Number) acc[8] + (Number) ((Comparable) action == 4 ? 1 : 0), notable]);
    };
    def ncc-witness() = {
        let original = nmil-training-raw();
        let split = nmea-split(nmil-held-raw());
        let adapt = split[0];
        let eval = split[1];
        let protos = nmil-protos();
        let base = nmn-train(nmn-stack(nmil-d()), nmil-encode-training(original), 0.02, nmil-eps(), 40);
        let errors = nmea-errors(base, adapt, protos);
        let replay = nmc-concat(nmil-encode-training(original), nmil-encode-training(errors));
        let rehearsal = nmn-train(base, replay, 0.01, nmil-eps(), 20);
        framebuffer-clear();
        let result = ncc-observe(eval, 1, base, rehearsal, protos, ncc-acc());
        let rows = result[0];
        let agree = result[1];
        let disagree = result[2];
        let native-correct = result[3];
        let native-wrong = result[4];
        let caught = result[5];
        let inquiry-ok = result[6];
        let continue-actions = result[7];
        let evidence-actions = result[8];
        let notable = result[9];
        let expected-inquiries = agree * 7;
        let frames = len(framebuffer-events());
        // Success proves the cycle/routing contract, not perfect recognition.
        [nothing(), 0, 1, 1001099008, rows, agree, disagree, native-correct, native-wrong, caught, inquiry-ok, expected-inquiries, continue-actions, evidence-actions, frames, notable, (Comparable) ((Number) agree + (Number) disagree) == rows && ((Comparable) ((Number) native-correct + (Number) native-wrong) == agree && ((Comparable) inquiry-ok == expected-inquiries && ((Comparable) continue-actions == agree && ((Comparable) evidence-actions == disagree && ((Comparable) frames == rows * 2 && caught > 0))))) ? 1 : 0];
    };
    0;
}
