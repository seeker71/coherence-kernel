; response-word-field-dictionary.fk — a grounded, typed extension for the
; exact response corpus observed by response-dictionary-spectrum.fk.
;
; This is not a claim that 200 English surfaces are now universally solved.
; Each row states its resolution:
;   lexical      a contextual meaning recipe
;   functional   a relation/grammar recipe
;   carrier      a repository, path, model, or protocol label
;   inflection   a response-time state/action surface
; The distinction keeps a path fragment from masquerading as a universal NL
; meaning while still giving it a form-neutral cell and description.
;
; Groups share a grounded recipe when they share the same response function.
; Every recipe closes over core + derived + domain words.  Each surface still
; receives its own neutral id.  Its semantic field is the group's 13-axis seed
; projection; the complete cell shape is (neutral-id field), so identity is not
; erased when two related words share a field.
; witnessed: 2026-08-24 -> rwfd 4095, exact response coverage 448/448 + 237/237
;
; preludes: form/form-stdlib/core.fk form/form-stdlib/core-lexicon.fk
; preludes: form/form-stdlib/core-lexicon-derived.fk
; preludes: form/form-stdlib/core-lexicon-domains.fk
; preludes: cognition/form-neutral-word-field.fk

(do
    (defn rwfd-kind-lexical () 0)
    (defn rwfd-kind-functional () 1)
    (defn rwfd-kind-carrier () 2)
    (defn rwfd-kind-inflection () 3)

    ; group = (field-axis kind specificity description surfaces)
    ; specificity: 2 concept recipe, 1 contextual role, 0 carrier label.
    (defn rwfd-group (axis kind specificity desc surfaces)
        (list axis kind specificity desc surfaces))
    (defn rwfd-group-axis (group) (nth group 0))
    (defn rwfd-group-kind (group) (nth group 1))
    (defn rwfd-group-specificity (group) (nth group 2))
    (defn rwfd-group-desc (group) (nth group 3))
    (defn rwfd-group-surfaces (group) (nth group 4))

    (defn rwfd-groups ()
        (list
            (rwfd-group 8 (rwfd-kind-lexical) 2
                (list "a" "thing" "that" "is" "from" "here" "and" "not" "from" "other")
                (list "native" "local" "home"))
