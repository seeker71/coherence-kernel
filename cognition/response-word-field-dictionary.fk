    ; entry = (neutral-id surface axis kind specificity description field status)
    (defn rwfd-entry (id surface group)
        (list id surface (rwfd-group-axis group) (rwfd-group-kind group)
              (rwfd-group-specificity group) (rwfd-group-desc group)
              (fwf-shape (fwf-at (rwfd-group-axis group)))
              (fwf-authored-seed)))
    (defn rwfd-id (entry) (nth entry 0))
    (defn rwfd-surface (entry) (nth entry 1))
    (defn rwfd-axis (entry) (nth entry 2))
    (defn rwfd-kind (entry) (nth entry 3))
    (defn rwfd-specificity (entry) (nth entry 4))
    (defn rwfd-desc (entry) (nth entry 5))
    (defn rwfd-field (entry) (nth entry 6))
    (defn rwfd-status (entry) (nth entry 7))
    (defn rwfd-cell-shape (entry) (list (rwfd-id entry) (rwfd-field entry)))

    (defn rwfd-group-count (groups)
        (if (eq (len groups) 0) 0
            (add (len (rwfd-group-surfaces (head groups)))
                 (rwfd-group-count (tail groups)))))
    (defn rwfd-count () (rwfd-group-count (rwfd-groups)))
    (defn rwfd-find-surface-loop (surfaces token i group)
        (if (eq (len surfaces) 0) (list)
            (if (str_eq (head surfaces) token) (rwfd-entry i token group)
                (rwfd-find-surface-loop (tail surfaces) token (add i 1) group))))
    (defn rwfd-find-groups-loop (groups token base)
        (if (eq (len groups) 0) (list)
            (do
                (let group (head groups))
                (let found (rwfd-find-surface-loop
                    (rwfd-group-surfaces group) token base group))
                (if (gt (len found) 0) found
                    (rwfd-find-groups-loop (tail groups) token
                        (add base (len (rwfd-group-surfaces group))))))))
    (defn rwfd-find (surface) (rwfd-find-groups-loop (rwfd-groups) surface 5000))

    ; Description grammar is explicit.  Inflections and small relation words
    ; reduce to lower-layer recipes; they are not silently waved through as
    ; glue.  Every token in every expansion must itself be core/derived/domain.
    (defn rwfd-description-expansion (token)
        (if (str_eq token "can") (list "have" "a" "way" "to" "do")
        (if (str_eq token "ask") (list "want" "to" "know")
        (if (or (str_eq token "known") (or (str_eq token "knows")
                                           (str_eq token "knew"))) (list "know")
        (if (str_eq token "has") (list "have")
        (if (str_eq token "lets") (list "make")
        (if (str_eq token "place") (list "where")
        (if (or (str_eq token "change") (or (str_eq token "becomes")
                                            (or (str_eq token "become")
                                                (str_eq token "becoming"))))
            (list "be" "other")
        (if (or (str_eq token "does") (str_eq token "did")) (list "do")
        (if (str_eq token "about") (list "to")
        (if (str_eq token "enough") (list "not" "less")
        (if (str_eq token "sequence") (list "thing" "after" "thing")
        (if (str_eq token "for") (list "to")
        (if (str_eq token "happens") (list "is" "after")
        (if (str_eq token "itself") (list "self")
        (if (str_eq token "only") (list "this" "and" "none" "other")
        (if (or (str_eq token "says") (str_eq token "said")) (list "say")
        (if (str_eq token "its") (list "it" "have")
        (if (str_eq token "with") (list "and")
        (if (str_eq token "one") (list "1")
        (if (str_eq token "carries") (list "have" "from" "to")
        (if (str_eq token "calls") (list "say")
        (if (str_eq token "small") (list "less")
        (if (or (str_eq token "kept") (str_eq token "held")) (list "hold")
        (if (str_eq token "observation") (list "know" "again")
        (if (str_eq token "so") (list "then")
        (if (str_eq token "path") (list "way")
        (if (str_eq token "meet") (list "be" "same" "at")
        (if (str_eq token "wanted") (list "want")
        (if (str_eq token "keeps") (list "hold")
        (if (str_eq token "different") (list "other")
        (if (str_eq token "learns") (list "know" "more" "after")
        (if (str_eq token "happened") (list "was")
        (if (str_eq token "carrier") (list "thing" "have" "from" "to")
        (if (str_eq token "observes") (list "know" "again")
        (if (str_eq token "largest") (list "more" "than" "all" "other")
        (if (str_eq token "choose") (list "want" "which" "to" "do")
        (if (str_eq token "movement") (list "do" "from" "to")
        (if (str_eq token "no") (list "none")
        (if (str_eq token "lost") (list "not" "have" "after")
        (if (str_eq token "stop") (list "not" "do" "after")
        (if (str_eq token "should") (list "want" "to" "do")
        (if (str_eq token "moves") (list "do" "from" "to")
        (if (or (str_eq token "made") (str_eq token "makes")) (list "make")
        (if (str_eq token "given") (list "give")
        (if (str_eq token "doing") (list "do")
        (if (str_eq token "without") (list "and" "not")
            (list token))))))))))))))))))))))))))))))))))))))))))))))))
    (defn rwfd-expansion-grounded? (tokens)
        (if (eq (len tokens) 0) 1
            (if (ge (cldx-token-depth (head tokens)) 0)
                (rwfd-expansion-grounded? (tail tokens)) 0)))
    (defn rwfd-ground-token? (token)
        (rwfd-expansion-grounded? (rwfd-description-expansion token)))
    (defn rwfd-expand-desc-loop (tokens acc)
        (if (eq (len tokens) 0) acc
            (rwfd-expand-desc-loop (tail tokens)
                (append acc (rwfd-description-expansion (head tokens))))))
    (defn rwfd-expanded-desc (entry)
        (rwfd-expand-desc-loop (rwfd-desc entry) (list)))
    (defn rwfd-desc-closed? (tokens)
        (if (eq (len tokens) 0) 1
            (if (eq (rwfd-ground-token? (head tokens)) 1)
                (rwfd-desc-closed? (tail tokens)) 0)))
    (defn rwfd-all-desc-closed-loop (groups)
        (if (eq (len groups) 0) 1
            (if (eq (rwfd-desc-closed? (rwfd-group-desc (head groups))) 1)
                (rwfd-all-desc-closed-loop (tail groups)) 0)))
    (defn rwfd-all-desc-closed? () (rwfd-all-desc-closed-loop (rwfd-groups)))

    (defn rwfd-surface-count-loop (groups surface)
        (if (eq (len groups) 0) 0
            (add (rwfd-surface-count-in (rwfd-group-surfaces (head groups)) surface)
                 (rwfd-surface-count-loop (tail groups) surface))))
    (defn rwfd-surface-count-in (surfaces surface)
        (if (eq (len surfaces) 0) 0
            (add (if (str_eq (head surfaces) surface) 1 0)
                 (rwfd-surface-count-in (tail surfaces) surface))))
    (defn rwfd-no-duplicates-in (surfaces groups)
        (if (eq (len surfaces) 0) 1
            (if (eq (rwfd-surface-count-loop groups (head surfaces)) 1)
                (rwfd-no-duplicates-in (tail surfaces) groups) 0)))
    (defn rwfd-no-duplicates-loop (groups all)
        (if (eq (len groups) 0) 1
            (if (eq (rwfd-no-duplicates-in (rwfd-group-surfaces (head groups)) all) 1)
                (rwfd-no-duplicates-loop (tail groups) all) 0)))
    (defn rwfd-no-duplicates? ()
        (rwfd-no-duplicates-loop (rwfd-groups) (rwfd-groups)))

    ; Polysemy is retained.  `find` offers the first response sense for callers
    ; that need one; `find-all` returns every independently identified sense.
    (defn rwfd-find-all-surfaces (surfaces token id group acc)
        (if (eq (len surfaces) 0) acc
            (rwfd-find-all-surfaces (tail surfaces) token (add id 1) group
                (if (str_eq (head surfaces) token)
                    (cons (rwfd-entry id token group) acc) acc))))
    (defn rwfd-find-all-groups (groups token base acc)
        (if (eq (len groups) 0) acc
            (do
                (let group (head groups))
                (rwfd-find-all-groups (tail groups) token
                    (add base (len (rwfd-group-surfaces group)))
                    (rwfd-find-all-surfaces (rwfd-group-surfaces group)
                        token base group acc)))))
    (defn rwfd-find-all (surface)
        (rwfd-find-all-groups (rwfd-groups) surface 5000 (list)))
    (defn rwfd-string-in? (surface surfaces)
        (if (eq (len surfaces) 0) 0
            (if (str_eq surface (head surfaces)) 1
                (rwfd-string-in? surface (tail surfaces)))))
    (defn rwfd-unique-surfaces-add (surfaces seen)
        (if (eq (len surfaces) 0) seen
            (rwfd-unique-surfaces-add (tail surfaces)
                (if (eq (rwfd-string-in? (head surfaces) seen) 1)
                    seen (cons (head surfaces) seen)))))
    (defn rwfd-unique-surfaces-loop (groups seen)
        (if (eq (len groups) 0) seen
            (rwfd-unique-surfaces-loop (tail groups)
                (rwfd-unique-surfaces-add
                    (rwfd-group-surfaces (head groups)) seen))))
    (defn rwfd-unique-surfaces ()
        (rwfd-unique-surfaces-loop (rwfd-groups) (list)))
    (defn rwfd-unique-count () (len (rwfd-unique-surfaces)))
    (defn rwfd-ambiguous-count-loop (surfaces total)
        (if (eq (len surfaces) 0) total
            (rwfd-ambiguous-count-loop (tail surfaces)
                (add total (if (gt (len (rwfd-find-all (head surfaces))) 1) 1 0)))))
    (defn rwfd-ambiguous-count ()
        (rwfd-ambiguous-count-loop (rwfd-unique-surfaces) 0))

    (defn rwfd-kind-count-loop (groups kind)
        (if (eq (len groups) 0) 0
            (add (if (eq (rwfd-group-kind (head groups)) kind)
                     (len (rwfd-group-surfaces (head groups))) 0)
                 (rwfd-kind-count-loop (tail groups) kind))))
    (defn rwfd-kind-count (kind) (rwfd-kind-count-loop (rwfd-groups) kind))

    ; Directed wake for every seated response surface.  Neutral ids are kept in
    ; the signature so two related inflections never collapse to one cell.
    (defn rwfd-wake (from-surface to-surface)
        (do
            (let a (rwfd-find from-surface))
            (let b (rwfd-find to-surface))
            (if (or (eq (len a) 0) (eq (len b) 0)) (nothing)
                (do
                    (let delta (fwf-delta (rwfd-field a) (rwfd-field b)))
                    (list (rwfd-id a) (rwfd-id b) delta
                          (fwf-shear (rwfd-field a) (rwfd-field b))
                          (div (fwf-sum (fwf-dot-products
                              (rwfd-field a) (rwfd-field b))) (fwf-axis-count))
                          (fwf-l1 delta)
                          (sub (fwf-sum (rwfd-field b))
                               (fwf-sum (rwfd-field a))))))))

    ; Every response cell has one directed edge to its field axis.  The reverse
    ; query is computed over the groups, keeping both directions available.
    (defn rwfd-forward (surface)
        (do (let entry (rwfd-find surface))
            (if (eq (len entry) 0) (list)
                (list (list (rwfd-id entry) 0 (rwfd-axis entry))))))
    (defn rwfd-backward-groups (groups axis base acc)
        (if (eq (len groups) 0) acc
            (do
                (let group (head groups))
                (let next (rwfd-backward-surfaces
                    (rwfd-group-surfaces group) axis base group acc))
                (rwfd-backward-groups (tail groups) axis
                    (add base (len (rwfd-group-surfaces group))) next))))
    (defn rwfd-backward-surfaces (surfaces axis id group acc)
        (if (eq (len surfaces) 0) acc
            (rwfd-backward-surfaces (tail surfaces) axis (add id 1) group
                (if (eq (rwfd-group-axis group) axis)
                    (cons (list id 0 axis) acc) acc))))
    (defn rwfd-backward (axis)
        (rwfd-backward-groups (rwfd-groups) axis 5000 (list)))

    (defn rwfdk (condition bit) (if condition bit 0))
    (defn rwfd-check ()
        (do
            (let native (rwfd-find "native"))
            (let codex (rwfd-find "codex"))
            (let wake (rwfd-wake "native" "review"))
            (add (rwfdk (gt (rwfd-count) 200) 1)
            (add (rwfdk (eq (rwfd-all-desc-closed?) 1) 2)
            (add (rwfdk (gt (len (rwfd-find-all "share")) 1) 4)
            (add (rwfdk (and (gt (len native) 0) (gt (len codex) 0)) 8)
            (add (rwfdk (and (eq (len (rwfd-field native)) 13)
                             (eq (len (rwfd-cell-shape native)) 2)) 16)
            (add (rwfdk (eq (rwfd-kind codex) (rwfd-kind-carrier)) 32)
            (add (rwfdk (eq (rwfd-specificity codex) 0) 64)
            (add (rwfdk (not (nothing? wake)) 128)
            (add (rwfdk (not (eq (rwfd-id native) (rwfd-id codex))) 256)
            (add (rwfdk (eq (len (rwfd-forward "native")) 1) 512)
            (add (rwfdk (gt (len (rwfd-backward 3)) 0) 1024)
            (add (rwfdk (nothing? (rwfd-wake "native" "unseated")) 2048)
                 0))))))))))))))

    0)
