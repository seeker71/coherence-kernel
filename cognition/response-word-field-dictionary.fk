rwfd-group(0, rwfd-kind-inflection(), 1, ["given", "to", "other", "before"], ["fed"]), rwfd-group(2, rwfd-kind-lexical(), 2, ["a", "part", "of", "the", "body", "that", "can", "give", "and", "hold"], ["hand"]), rwfd-group(4, rwfd-kind-lexical(), 2, ["a", "part", "between", "before", "and", "after"], ["stage"]), rwfd-group(10, rwfd-kind-lexical(), 2, ["when", "a", "thing", "does", "from", "a", "place", "without", "the", "wanted", "way"], ["drift"]), rwfd-group(5, rwfd-kind-lexical(), 2, ["a", "place", "and", "the", "way", "a", "self", "say", "there"], ["locale"]), rwfd-group(7, rwfd-kind-inflection(), 1, ["have", "after", "doing"], ["earns"]), rwfd-group(7, rwfd-kind-lexical(), 2, ["when", "what", "a", "self", "say", "and", "what", "is", "are", "the", "same"], ["honest"]), rwfd-group(11, rwfd-kind-functional(), 1, ["a", "way", "a", "thing", "do", "from", "all", "its", "part"], ["mechanically"]), rwfd-group(10, rwfd-kind-inflection(), 2, ["do", "from", "here", "to", "there"], ["go", "returns"]), rwfd-group(4, rwfd-kind-lexical(), 2, ["a", "place", "where", "a", "thing", "can", "be", "in", "or", "out"], ["open"]), rwfd-group(1, rwfd-kind-inflection(), 2, ["this", "and", "other", "are", "as", "one", "whole"], ["paired"]), rwfd-group(0, rwfd-kind-inflection(), 1, ["make", "a", "thing", "be", "from", "self", "to", "other"], ["lets"]), rwfd-group(7, rwfd-kind-functional(), 2, ["between", "this", "and", "other"], ["vs"]), rwfd-group(8, rwfd-kind-functional(), 2, ["not", "in", "the", "same", "place", "or", "whole"], ["separately"]), rwfd-group(4, rwfd-kind-lexical(), 2, ["what", "a", "thing", "is", "from", "before"], ["ancestry"]), rwfd-group(4, rwfd-kind-inflection(), 1, ["other", "is", "after", "and", "this", "is", "before"], ["superseded"]), rwfd-group(6, rwfd-kind-lexical(), 2, ["less", "between", "before", "and", "after"], ["fast"]), rwfd-group(10, rwfd-kind-lexical(), 2, ["one", "movement", "after", "other"], ["turn"]), rwfd-group(8, rwfd-kind-inflection(), 2, ["hold", 