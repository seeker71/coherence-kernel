    // entry = (neutral-id surface axis kind specificity description field status)
    def rwfd-entry(id, surface, group) = [id, surface, rwfd-group-axis(group), rwfd-group-kind(group), rwfd-group-specificity(group), rwfd-group-desc(group), fwf-shape(fwf-at(rwfd-group-axis(group))), fwf-authored-seed()];
    def rwfd-id(entry) = entry[0];
    def rwfd-surface(entry) = entry[1];
    def rwfd-axis(entry) = entry[2];
    def rwfd-kind(entry) = entry[3];
    def rwfd-specificity(entry) = entry[4];
    def rwfd-desc(entry) = entry[5];
    def rwfd-field(entry) = entry[6];
    def rwfd-status(entry) = entry[7];
    def rwfd-cell-shape(entry) = [rwfd-id(entry), rwfd-field(entry)];
    def rwfd-group-count(groups) = (Comparable) len(groups) == 0 ? 0 : (Number) len(rwfd-group-surfaces(groups[0])) + (Number) rwfd-group-count(groups[1:]);
    def rwfd-count() = rwfd-group-count(rwfd-groups());
    def rwfd-find-surface-loop(surfaces, token, i, group) = (Comparable) len(surfaces) == 0 ? [] : (String) surfaces[0] == token ? rwfd-entry(i, token, group) : rwfd-find-surface-loop(surfaces[1:], token, (Number) i + (Number) 1, group);
    def rwfd-find-groups-loop(groups, token, base) = (Comparable) len(groups) == 0 ? [] : {
        let group = groups[0];
        let found = rwfd-find-surface-loop(rwfd-group-surfaces(group), token, base, group);
        len(found) > 0 ? found : rwfd-find-groups-loop(groups[1:], token, (Number) base + (Number) len(rwfd-group-surfaces(group)));
    };
    def rwfd-find(surface) = rwfd-find-groups-loop(rwfd-groups(), surface, 5000);
    // Description grammar is explicit.  Inflections and small relation words
    // reduce to lower-layer recipes; they are not silently waved through as
    // glue.  Every token in every expansion must itself be core/derived/domain.
    def rwfd-description-expansion(token) = (String) token == "can" ? ["have", "a", "way", "to", "do"] : (String) token == "ask" ? ["want", "to", "know"] : (String) token == "known" || ((String) token == "knows" || (String) token == "knew") ? ["know"] : (String) token == "has" ? ["have"] : (String) token == "lets" ? ["make"] : (String) token == "place" ? ["where"] : (String) token == "change" || ((String) token == "becomes" || ((String) token == "become" || (String) token == "becoming")) ? ["be", "other"] : (String) token == "does" || (String) token == "did" ? ["do"] : (String) token == "about" ? ["to"] : (String) token == "enough" ? ["not", "less"] : (String) token == "sequence" ? ["thing", "after", "thing"] : (String) token == "for" ? ["to"] : (String) token == "happens" ? ["is", "after"] : (String) token == "itself" ? ["self"] : (String) token == "only" ? ["this", "and", "none", "other"] : (String) token == "says" || (String) token == "said" ? ["say"] : (String) token == "its" ? ["it", "have"] : (String) token == "with" ? ["and"] : (String) token == "one" ? ["1"] : (String) token == "carries" ? ["have", "from", "to"] : (String) token == "calls" ? ["say"] : (String) token == "small" ? ["less"] : (String) token == "kept" || (String) token == "held" ? ["hold"] : (String) token == "observation" ? ["know", "again"] : (String) token == "so" ? ["then"] : (String) token == "path" ? ["way"] : (String) token == "meet" ? ["be", "same", "at"] : (String) token == "wanted" ? ["want"] : (String) token == "keeps" ? ["hold"] : (String) token == "different" ? ["other"] : (String) token == "learns" ? ["know", "more", "after"] : (String) token == "happened" ? ["was"] : (String) token == "carrier" ? ["thing", "have", "from", "to"] : (String) token == "observes" ? ["know", "again"] : (String) token == "largest" ? ["more", "than", "all", "other"] : (String) token == "choose" ? ["want", "which", "to", "do"] : (String) token == "movement" ? ["do", "from", "to"] : (String) token == "no" ?