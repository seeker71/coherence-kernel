// response-word-field-dictionary.fk — a grounded, typed extension for the
// exact response corpus observed by the dictionary spectrum pass.
//
// This is not a claim that 200 English surfaces are now universally solved.
// Each row states its resolution:
//   lexical      a contextual meaning recipe
//   functional   a relation/grammar recipe
//   carrier      a repository, path, model, or protocol label
//   inflection   a response-time state/action surface
// The distinction keeps a path fragment from masquerading as a universal NL
// meaning while still giving it a form-neutral cell and description.
//
// Groups share a grounded recipe when they share the same response function.
// Every recipe closes over core + derived + domain words.  Each surface still
// receives its own neutral id.  Its semantic field is the group's 13-axis seed
// projection; the complete cell shape is (neutral-id field), so identity is not
// erased when two related words share a field.
// witnessed: 2026-08-24 -> rwfd 4095, exact response coverage 448/448 + 237/237
//
import form/form-stdlib/core.fk;
import form/form-stdlib/core-lexicon.fk;
import form/form-stdlib/core-lexicon-derived.fk;
import form/form-stdlib/core-lexicon-domains.fk;
import cognition/form-neutral-word-field.fk;
section [form.bml] {
    def rwfd-kind-lexical() = 0;
    def rwfd-kind-functional() = 1;
    def rwfd-kind-carrier() = 2;
    def rwfd-kind-inflection() = 3;
    // group = (field-axis kind specificity description surfaces)
    // specificity: 2 concept recipe, 1 contextual role, 0 carrier label.
    def rwfd-group(axis, kind, specificity, desc, surfaces) = [axis, kind, specificity, desc, surfaces];
    def rwfd-group-axis(group) = group[0];
    def rwfd-group-kind(group) = group[1];
    def rwfd-group-specificity(group) = group[2];
    def rwfd-group-desc(group) = group[3];
    def rwfd-group-surfaces(group) = group[4];
    def rwfd-groups() = [rwfd-group(8, rwfd-kind-lexical(), 2, ["a", "thing", "that", "is", "from", "here", "and", "not", "from", "other"], ["native", "local", "home"]), rwfd-group(12, rwfd-kind-lexical(), 2, ["the", "shape", "and", "way", "a", "thing", "can", "do"], ["form"]), rwfd-group(11, rwfd-kind-lexical(), 2, ["a", "part", "at", "the", "center", "that", "make", "the", "whole", "do"], ["kernel", "micro"]), rwfd-group(3, rwfd-kind-lexical(), 2, ["a", "way", "a", "self", "know", "a", "thing", "again", "and", "ask", "whether", "it", "is", "1"], ["review", "observe", "observation", "witness", "probe", "probes", "see"]), rwfd-group(0, rwfd-kind-lexical(), 2, ["when", "many", "self", "say", "and", "make", "other", "know"], ["dialogue", "exchange"]), rwfd-group(3, rwfd-kind-carrier(), 0, ["what", "a", "self", "say", "a", "thing", "is", "here"], ["codex", "ad", "c", "worktrees", "ursmuff", "cwd", "git", "fk", "operationalization", "eof", "pong", "cli", "f", "fd", "d", "md", "qwen", "stdlib"]), rwfd-group(8, rwfd-kind-lexical(), 1, ["many", "self", "that", "do", "to", "a", "thing"], ["users"]), rwfd-group(7, rwfd-kind-lexical(), 2, ["how", "a", "thing", "is", "now", "after", "a", "self", "know", "it", "again"], ["freshness", "fresh"]), rwfd-group(3, rwfd-kind-lexical(), 2, ["from", "before", "and", "not", "known", "again", "now"], ["stale", "old"]), rwfd-group(3, rwfd-kind-functional(), 2, ["at", "now"], ["current"]), rwfd-group(3, rwfd-kind-functional(), 2, ["before", "this"], ["previous"]), rwfd-group(4, rwfd-kind-lexical(), 2, ["other", "than", "before", "and", "here", "now"], ["new"]), rwfd-group(7, rwfd-kind-lexical(), 2, ["what", "make", "a", "thing", "be", "and", "has", "nothing", "before", "it"], ["ground", "grounding", "regrounded"]), rwfd-group(7, rwfd-kind-lexical(), 2, ["a", "thing", "that", "lets", "a", "self", "know", "whether", "other", "thing", "is", "1"], ["evidence", "proof", "instrument", "measurement"]), rwfd-group(3, rwfd-kind-lexical(), 2, ["a", "