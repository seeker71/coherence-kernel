    // here.  The core remains untouched; this overlay pays the debt the
    // response observer exposed instead of counting glue as meaning.
rwfd-group(3, rwfd-kind-functional(), 2, ["this", "one", "thing"], ["the", "a", "an"]), rwfd-group(7, rwfd-kind-functional(), 2, ["part", "of", "a", "whole"], ["of"]), rwfd-group(5, rwfd-kind-functional(), 2, ["the", "thing", "here"], ["this"]), rwfd-group(5, rwfd-kind-functional(), 2, ["the", "thing", "there"], ["that"]), rwfd-group(7, rwfd-kind-functional(), 2, ["is", "for", "many", "thing"], ["are"]), rwfd-group(4, rwfd-kind-functional(), 2, ["is", "before"], ["was"]), rwfd-group(7, rwfd-kind-functional(), 2, ["is", "for", "the", "self", "that", "say"], ["am"]), rwfd-group(7, rwfd-kind-functional(), 2, ["how", "this", "is", "to", "other"], ["than", "as"]),     // Twenty surfaces named by the first coverage witness.  These are
