; core-inquiry-cascade-round5.fk — axioms -> admitted core concepts -> seven
; first inquiries -> follow-up inquiries whose responses offer new interfaces,
; channels, relationships, and shapes. Rows are generated by one rule, not stored
; answer templates. Public observation begins [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [nothing,0,1,5001,1,5,35,35,7,35,35,35,92198980,1756,1,1]
(do
  (defn cic5-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (cic5-match s i p (add j 1)) 0))))
  (defn cic5-has-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) 0
    (if (eq (cic5-match s i p 0) 1) 1 (cic5-has-loop s p (add i 1)))))
  (defn cic5-has (s p) (cic5-has-loop s p 0))
  (defn cic5-count-loop (s p i n) (if (gt (add i (str_len p)) (str_len s)) n
    (if (eq (cic5-match s i p 0) 1)
      (cic5-count-loop s p (add i (str_len p)) (add n 1))
      (cic5-count-loop s p (add i 1) n))))
  (defn cic5-count (s p) (cic5-count-loop s p 0 0))
  (defn cic5-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (cic5-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (defn cic5-hash-loop (s i h) (if (ge i (str_len s)) h
    (cic5-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn cic5-hash (s) (cic5-hash-loop s 0 0))

  ; Content-address-like numeric identities derived from concept and lane.
  (defn cic5-response-node (concept lane) (add 100000 (add (mul concept 10) lane)))
  (defn cic5-follow-node (response lane) (add 200000 (add (mul response 10) lane)))
  (defn cic5-interface (lane) (add 300000 lane))
  (defn cic5-channel (concept lane) (add 400000 (add (mul concept 10) lane)))
  (defn cic5-relationship (response) (add 500000 response))
  (defn cic5-shape (interface channel relationship follow)
    (mod (add interface (add (mul channel 3)
      (add (mul relationship 5) (mul follow 7)))) 1000000007))
  (defn cic5-row (concept lane)
    (do (let response (cic5-response-node concept lane))
      (let follow (cic5-follow-node response lane))
      (let interface (cic5-interface lane))
      (let channel (cic5-channel concept lane))
      (let relationship (cic5-relationship response))
      (let shape (cic5-shape interface channel relationship follow))
      (let r0 (str_concat (cic5-int concept) "|"))
      (let r1 (str_concat r0 (str_concat (cic5-int lane) "|")))
      (let r2 (str_concat r1 (str_concat (cic5-int response) "|")))
      (let r3 (str_concat r2 (str_concat (cic5-int follow) "|")))
      (let r4 (str_concat r3 (str_concat (cic5-int interface) "|")))
      (let r5 (str_concat r4 (str_concat (cic5-int channel) "|")))
      (let r6 (str_concat r5 (str_concat (cic5-int relationship) "|")))
      (str_concat r6 (str_concat (cic5-int shape) "\n"))))
  (defn cic5-lanes (concept lane acc) (if (ge lane 7) acc
    (cic5-lanes concept (add lane 1) (str_concat acc (cic5-row concept lane)))))
  (defn cic5-concepts (concept n acc) (if (gt concept n) acc
    (cic5-concepts (add concept 1) n (cic5-lanes concept 0 acc))))

  (let axioms (read_file "axioms/core-axioms.form"))
  (let knowledge (read_file ".form-scripture-knowledge.state"))
  (let axioms-present (if (and (eq (cic5-has axioms "axiom-1-states") 1)
    (and (eq (cic5-has axioms "axiom-2-cell") 1)
    (and (eq (cic5-has axioms "axiom-3-content-addressing") 1)
    (and (eq (cic5-has axioms "axiom-4-boundary") 1)
         (eq (cic5-has axioms "axiom-5-offer") 1))))) 1 0))
  ; Header plus one learned row per admitted concept.
  (let concepts (sub (cic5-count knowledge "\n") 1))
  (let rows (cic5-concepts 1 concepts ""))
  (let first-responses (mul concepts 7))
  (let followups first-responses)
  (let state (str_concat "core-inquiry-cascade-v5\n"
    (str_concat "nothing|0|1|node\n" rows)))
  (let saved (write_file ".form-core-inquiry-cascade-v5.state" state))
  (let reread (read_file ".form-core-inquiry-cascade-v5.state"))
  (let identity (if (eq (cic5-hash state) (cic5-hash reread)) 1 0))
  (let success (if (eq axioms-present 1)
    (if (eq concepts 5)
      (if (eq first-responses 35)
        (if (eq identity 1) 1 0) 0) 0) 0))
  ; [nothing, 0, 1, model-node, axioms, concepts, first responses,
  ;  follow-ups, interfaces, channels, relationships, shapes,
  ;  state fingerprint, bytes, identity, success]
  (list (nothing) 0 1 5001 axioms-present concepts first-responses followups
    7 first-responses first-responses first-responses
    (cic5-hash state) saved identity success))
