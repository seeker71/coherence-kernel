; music-neutral-world-lens.fk — a plural world-model inquiry through music.
; witnessed: 2026-07-23 -> direct-source native witness returned the vector below
;
; This cell does not make religions interchangeable and does not turn a
; contemplative reading into a physical measurement.  It preserves three
; evidence lanes: 1 empirical, 2 formal, 3 symbolic/experiential.
;
; Symbols are numeric and names are optional gas aliases.  A music observation
; is (order, differentiation, prediction-correction, agency, freshness), each
; field 0/1 except freshness, which is an observation-relative integer.
; Intelligence support is computed, not attached to a genre, word, or faith.

(do
    (defn mnw-score-bit (x weight) (if (eq x 1) weight 0))

    ; Evidence lanes remain distinct even when their structures resonate.
    (defn mnw-claim (shape lane source freshness) (list shape lane source freshness))
    (defn mnw-shape (claim) (nth claim 0))
    (defn mnw-lane (claim) (nth claim 1))
    (defn mnw-resonates? (a b) (if (eq (mnw-shape a) (mnw-shape b)) 1 0))
    (defn mnw-same-evidence? (a b)
        (if (eq (mnw-resonates? a b) 1)
            (if (eq (mnw-lane a) (mnw-lane b)) 1 0)
            0))

    ; Core-teaching recipe.  A tradition supplies its own expression symbol.
    ; teaching: 1 compassion, 2 presence, 3 release, 4 relation/unity,
    ; 5 truthful action.  The shared shape is comparative, lane 3—not proof
    ; that the traditions teach the same metaphysics.
    (defn mnw-teaching (tradition teaching expression freshness)
        (list tradition teaching expression 3 freshness))
    (defn mnw-teaching-shape (x) (nth x 1))
    (defn mnw-teaching-resonates? (a b)
        (if (eq (mnw-teaching-shape a) (mnw-teaching-shape b)) 1 0))

    ; Formal polarity recipe: distinction (duality) and relation (non-duality)
    ; can coexist.  0/nothing leaves the inquiry open; neither is erased.
    (defn mnw-polarity (distinction relation)
        (if (eq distinction 0)
            (if (eq relation 0) (nothing) 2)
            (if (eq relation 0) 1 3)))

    ; "Free energy" has several meanings.  1 thermodynamic, 2 variational,
    ; 3 experiential metaphor.  A structural resonance is not identity.
    (defn mnw-free-energy-same? (kind-a kind-b)
        (if (eq kind-a kind-b) 1 0))

    ; Evidence for intelligence from a music/sensor observation.
    ; Low entropy/order contributes one bit.  Differentiated structure,
    ; prediction-correction, and situated agency contribute independently.
    ; Thus a crystal or repeated tone is orderly without being adjudicated
    ; intelligent by order alone.
    (defn mnw-intelligence-evidence (observation)
        (add
            (add (mnw-score-bit (nth observation 0) 1)
                 (mnw-score-bit (nth observation 1) 2))
            (add (mnw-score-bit (nth observation 2) 4)
                 (mnw-score-bit (nth observation 3) 8))))
    (defn mnw-intelligence-supported? (observation)
        (if (gt (mnw-intelligence-evidence observation) 7) 1 0))

    ; Seven inquiry lanes are computed views over the same observation.
    ; what=score, where=evidence lane, when=freshness, who=perspective,
    ; how=polarity composition, which=claim state, why=support threshold.
    ; The acknowledgement uses the core nothing/0/1/node vocabulary; this
    ; inquiry returns 1 or the alternative observation node.  An unknown
    ; polarity remains nothing, distinct from a negative acknowledgement (0).
    (defn mnw-inquire (observation evidence-lane perspective alternative-node)
        (do
            (let score (mnw-intelligence-evidence observation))
            (let supported (mnw-intelligence-supported? observation))
            (list
                score
                evidence-lane
                (nth observation 4)
                perspective
                (mnw-polarity (nth observation 1) (nth observation 2))
                (if (eq supported 1) 1 alternative-node)
                supported)))

    ; Direct witness contains a positive observation, the held-out orderly-only
    ; contrast, lane-honesty checks, polarity composition, free-energy
    ; disambiguation, cross-tradition resonance, and both inquiry vectors.
    (defn music-neutral-world-lens-witness ()
        (do
            (let responsive (list 1 1 1 1 23))
            (let orderly-only (list 1 0 0 0 23))
            (let empirical-order (mnw-claim 7 1 101 23))
            (let contemplative-order (mnw-claim 7 3 301 23))
            (let teaching-a (mnw-teaching 11 4 1104 23))
            (let teaching-b (mnw-teaching 12 4 1204 23))
            (list
                (mnw-intelligence-evidence responsive)
                (mnw-intelligence-supported? responsive)
                (mnw-intelligence-evidence orderly-only)
                (mnw-intelligence-supported? orderly-only)
                (mnw-resonates? empirical-order contemplative-order)
                (mnw-same-evidence? empirical-order contemplative-order)
                (mnw-polarity 1 1)
                (mnw-free-energy-same? 1 2)
                (mnw-teaching-resonates? teaching-a teaching-b)
                (mnw-inquire responsive 1 2 9001)
                (mnw-inquire orderly-only 1 2 9001))))

    (music-neutral-world-lens-witness))
