  (defn hcnl13-hash-valid? (path expected)
    (do (let size (file_size path)) (let bytes (read_file path))
      (if (and (ge size 0) (and (not (nothing? bytes))
          (and (eq size (str_len bytes)) (eq size (file_size path)))))
        (str_eq (hex-encode (sha256-stream-string bytes)) expected) 0)))
  (defn hcnl13-artifacts-valid? ()
