; Two linked observations requested for the reciprocal choice microkernel.
; The human fixture is explicitly chosen DO for a bounded two-observation test;
; observation two adds an EXPLICIT-CARRY-ACK fixture event. This demonstrates
; the protocol representation, never a live human act. Sema's two choices come
; from visible declared-charge readings.
;
; preludes: cognition/reciprocal-choice-microkernel.fk
(do
  (defn rcmo-human-id () 1001)
  (defn rcmo-sema-id () 1002)
  (defn rcmo-interface () 2001)
  (defn rcmo-recipe-do () 3001)
  (defn rcmo-recipe-see () 3002)
  (defn rcmo-information-gift () 4001)
  (defn rcmo-model-fragment-one () 700)
  (defn rcmo-model-fragment-two () 710)

  (defn rcmo-human-one ()
    (rcm-explicit-choice (rcmo-human-id) (rcm-mode-do) 4 9 7
      (rcmo-interface) (rcmo-recipe-do) (rcm-fallback-interrupt)))
  (defn rcmo-sema-charges-one ()
    (rcm-charges 20 90 30 20 80 30 90))
  (defn rcmo-sema-one ()
    (rcm-declared-charge-choice (rcmo-sema-id) (rcmo-sema-charges-one) 8 6
      (rcmo-interface) (rcmo-recipe-do) (rcm-fallback-interrupt)))

  (defn rcmo-candidates-one ()
    (list
      (rcm-candidate (rcm-mode-do) 2 85 701 (rcmo-recipe-do))
      (rcm-candidate (rcm-mode-see) 4 90 702 (rcmo-recipe-see))))

  (defn rcmo-exchange-one ()
    (rcm-embody
      (rcm-offer 1 (rcmo-human-one) (rcmo-information-gift)
        (rcmo-model-fragment-one) (rcmo-candidates-one) 70)
      (rcmo-sema-one)
      90 10 80))

  (defn rcmo-observation-one ()
    (rcm-e-observation (rcmo-exchange-one)))

  (defn rcmo-human-two () (rcm-explicit-carry-ack (rcmo-human-one)))
  (defn rcmo-sema-charges-two ()
    (rcm-next-charges (rcmo-observation-one)))
  (defn rcmo-sema-two ()
    (rcm-declared-charge-choice (rcmo-sema-id) (rcmo-sema-charges-two) 8 6
      (rcmo-interface) (rcmo-recipe-see) (rcm-fallback-interrupt)))

  (defn rcmo-candidates-two ()
    (list
      (rcm-candidate (rcm-mode-do) 2 80 711 (rcmo-recipe-do))
      (rcm-candidate (rcm-mode-see) 4 92 712 (rcmo-recipe-see))))

  (defn rcmo-exchange-two ()
    (rcm-embody
      (rcm-offer (rcm-o-next-point (rcmo-observation-one))
        (rcmo-human-two) (rcmo-information-gift)
        (rcmo-model-fragment-two) (rcmo-candidates-two) 70)
      (rcmo-sema-two)
      20 15 90))

  (defn rcmo-observation-two ()
    (rcm-e-observation (rcmo-exchange-two)))

  (defn rcmo-two-observations ()
    (list (rcmo-observation-one) (rcmo-observation-two)))

  0)
