// error-loving-attention.fk — an error remains a living signal.
//
// The response is not to repaint the signal, relax its witness, or rename the
// expected outcome. Attention keeps prediction and observation together,
// orients from their difference, chooses a movement, and re-observes. A
// timeout keeps unknown work unknown. Release arrives only after a distinct
// resolved observation.
//
// Nothing, present 0, and present 1 stay distinct:
//   nothing — no well-formed signal arrived;
//   0       — retuning-away was observed and wants a turn;
//   1       — the signal is being attended without erasure.
//
// This is a teaching and an executable orientation, not a law.
// Pure proof: cognition/tests/error-loving-attention-band.fk
section [form.bml] {
    // [kind prediction observation source]
    def ela-signal(kind, prediction, observation, source) = [kind, prediction, observation, source];
    def ela-kind(signal) = signal[0];
    def ela-prediction(signal) = signal[1];
    def ela-observation(signal) = signal[2];
    def ela-source(signal) = signal[3];
    def ela-signal?(signal) = nothing?(signal) ? 0 : (Comparable) len(signal) == 4 ? 1 : 0;
    def ela-full-movement() = ["pay-loving-attention", "observe", "orientate", "turn", "move", "lean", "steer", "guide", "absorb", "digest", "evaluate", "pause", "re-observe"];
    def ela-timeout-movement() = ["pay-loving-attention", "observe", "pause", "request-evidence", "re-observe"];
    def ela-resolved-movement() = ["absorb", "release", "re-observe"];
    def ela-retune-away-movement() = ["pause", "restore-error", "observe", "orientate"];
    def ela-health(signal) = (Comparable) ela-signal?(signal) == 0 ? nothing() : (String) ela-kind(signal) == "retune-away" ? 0 : (String) ela-kind(signal) == "error" || ((String) ela-kind(signal) == "timeout" || (String) ela-kind(signal) == "resolved") ? 1 : nothing();
    def ela-movement(signal) = (Comparable) ela-signal?(signal) == 0 ? nothing() : (String) ela-kind(signal) == "error" ? ela-full-movement() : (String) ela-kind(signal) == "timeout" ? ela-timeout-movement() : (String) ela-kind(signal) == "resolved" ? ela-resolved-movement() : (String) ela-kind(signal) == "retune-away" ? ela-retune-away-movement() : nothing();
    // The original signal is retained byte-for-byte in the attended row.
    // [signal health movement]
    def ela-attend(signal) = {
        let health = ela-health(signal);
        nothing?(health) ? nothing() : [signal, health, ela-movement(signal)];
    };
    def ela-release?(attended) = nothing?(attended) ? nothing() : {
        let signal = attended[0];
        (String) ela-kind(signal) == "resolved" ? (Comparable) ela-prediction(signal) == ela-observation(signal) ? 1 : 0 : 0;
    };
    0;
}
