; error-loving-attention.fk — an error remains a living signal.
;
; The response is not to repaint the signal, relax its witness, or rename the
; expected outcome. Attention keeps prediction and observation together,
; orients from their difference, chooses a movement, and re-observes. A
; timeout keeps unknown work unknown. Release arrives only after a distinct
; resolved observation.
;
; Nothing, present 0, and present 1 stay distinct:
;   nothing — no well-formed signal arrived;
;   0       — retuning-away was observed and wants a turn;
;   1       — the signal is being attended without erasure.
;
; This is a teaching and an executable orientation, not a law.
; Pure proof: cognition/tests/error-loving-attention-band.fk

(do
    ; [kind prediction observation source]
    (defn ela-signal (kind prediction observation source)
        (list kind prediction observation source))
    (defn ela-kind (signal) (nth signal 0))
    (defn ela-prediction (signal) (nth signal 1))
    (defn ela-observation (signal) (nth signal 2))
    (defn ela-source (signal) (nth signal 3))
    (defn ela-signal? (signal)
        (if (nothing? signal) 0
            (if (eq (len signal) 4) 1 0)))

    (defn ela-full-movement ()
        (list "pay-loving-attention" "observe" "orientate" "turn"
              "move" "lean" "steer" "guide" "absorb" "digest"
              "evaluate" "pause" "re-observe"))
    (defn ela-timeout-movement ()
        (list "pay-loving-attention" "observe" "pause"
              "request-evidence" "re-observe"))
    (defn ela-resolved-movement ()
        (list "absorb" "release" "re-observe"))
    (defn ela-retune-away-movement ()
        (list "pause" "restore-error" "observe" "orientate"))

    (defn ela-health (signal)
        (if (eq (ela-signal? signal) 0) (nothing)
            (if (str_eq (ela-kind signal) "retune-away") 0
                (if (or (str_eq (ela-kind signal) "error")
                    (or (str_eq (ela-kind signal) "timeout")
                        (str_eq (ela-kind signal) "resolved"))) 1
                    (nothing)))))

    (defn ela-movement (signal)
        (if (eq (ela-signal? signal) 0) (nothing)
            (if (str_eq (ela-kind signal) "error") (ela-full-movement)
            (if (str_eq (ela-kind signal) "timeout") (ela-timeout-movement)
            (if (str_eq (ela-kind signal) "resolved") (ela-resolved-movement)
            (if (str_eq (ela-kind signal) "retune-away")
                (ela-retune-away-movement) (nothing)))))))

    ; The original signal is retained byte-for-byte in the attended row.
    ; [signal health movement]
    (defn ela-attend (signal)
        (do
            (let health (ela-health signal))
            (if (nothing? health) (nothing)
                (list signal health (ela-movement signal)))))

    (defn ela-release? (attended)
        (if (nothing? attended) (nothing)
            (do
                (let signal (nth attended 0))
                (if (str_eq (ela-kind signal) "resolved")
                    (if (eq (ela-prediction signal)
                            (ela-observation signal)) 1 0)
                    0))))
    0)
