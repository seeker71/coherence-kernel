; native-sanskrit-result.fk — an actual local-language knowledge result.
; import "../form/form-stdlib/grammars/sanskrit-roots.fk"

(do
    (defn nsr-join (xs)
        (if (eq (len xs) 0) ""
            (str_concat (head xs) (nsr-join (tail xs)))))

    (print_str (nsr-join (list
        "NATIVE SANSKRIT RESULT\n"
        (dhatu-answer "karma") "\n"
        (dhatu-answer "samskara") "\n"
        "RELATION — karma and samskara resolve to the same seeded root, sqrt-kr: to do, to make. "
        "The observable path is action -> formation -> retained impression.\n"
        (dhatu-answer "yoga") "\n"
        "ACTION — join one performed act to the impression it leaves; observe whether repetition changes the next act.\n")))
    0)
