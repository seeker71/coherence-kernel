// pl-lenses-13.fk — Form-native registry, detection, and bounded generation
// across thirteen widely used programming-language surfaces.
//
// The audit behind this organ finds what stands in this body:
//   - no substrate language cells or parse/emit walkers for Python, TypeScript,
//     Go, or Rust are carried here (the audit rows below read 0 for them);
//   - lang-common.fk carries shared imperative expression grammar;
//   - source-compiler-text-lens emits Form source, not arbitrary foreign code.
//
// This cell closes a narrower native floor today: registry data, ranked lexical
// detection over real snippets, and exact binary-function generation for
// add/subtract/multiply. It does not claim thirteen parsers, AST round-tripping,
// name escaping, type checking, compilation, execution, or arbitrary
// transpilation. Division is excluded because integer semantics differ across
// these surfaces. Detection is evidence-scoring, not a proof of language.
// witnessed: 2026-07-18 -> band 1048575 four-way (fkwu/Go/Rust/TypeScript)
import form/form-stdlib/core.fk;
import "../form/form-stdlib/core.fk"
section [form.bml] {
    // lens = (id display extension markers fixture typing line-comment)
    def pl13-lens(id, display, extension, markers, fixture, typing, comment) = [id, display, extension, markers, fixture, typing, comment];
    def pl13-id(lens) = lens[0];
    def pl13-name(lens) = lens[1];
    def pl13-extension(lens) = lens[2];
    def pl13-markers(lens) = lens[3];
    def pl13-fixture(lens) = lens[4];
    def pl13-typing(lens) = lens[5];
    def pl13-comment(lens) = lens[6];
    // Each fixture is executable-looking source from its actual surface, not a
    // language name pasted into a generic placeholder.
    def pl13-registry() = [pl13-lens("python", "Python", ".py", ["pl13-language[python]", "from ", "def ", "print(", "f\""], "from pathlib import Path\n\ndef greet(name):\n    print(f\"Hello {name}\")\n", "dynamic", "#"), pl13-lens("javascript", "JavaScript", ".js", ["pl13-language[javascript]", "const ", "=>", "console.log("], "const greet = (name) => {\n  console.log(\"Hello \" + name);\n};\n", "dynamic", "//"), pl13-lens("typescript", "TypeScript", ".ts", ["pl13-language[typescript]", "interface ", ": string", "const ", "=>"], "interface User { name: string }\nconst greet = (user: User): string => user.name;\n", "static-gradual", "//"), pl13-lens("java", "Java", ".java", ["pl13-language[java]", "public static", "System.out.", "class "], "public final class Hello {\n  public static void main(String[] args) { System.out.println(\"hi\"); }\n}\n", "static", "//"), pl13-lens("c", "C", ".c", ["pl13-language[c]", "#include <stdio.h>", "int main(", "printf("], "#include <stdio.h>\nint main(void) { printf(\"hi\\n\"); return 0; }\n", "static-manual-memory", "//"), pl13-lens("cpp", "C++", ".cpp", ["pl13-language[cpp]", "#include <iostream>", "std::", "cout"], "#include <iostream>\nint main() { std::cout << \"hi\\n\"; }\n", "static-raii", "//"), pl13-lens("csharp", "C#", ".cs", ["pl13-language[csharp]", "using System;", "namespace ", "Console.WriteLine("], "using System;\nnamespace Demo { class Hello { static void Main() { Console.WriteLine(\"hi\"); } } }\n", "static-managed", "//"), pl13-lens("go", "Go", ".go", ["pl13-language[go]", "package main", "func ", "fmt."], "package main\nimport \"fmt\"\nfunc main() { fmt.Println(\"hi\") }\n", "static-gc", "//"), pl13-lens("rust", "Rust", ".rs", ["pl13-language[rust]", "fn main(", "let mut ", "println!("], "fn main() { let mut n: i64 = 1; n += 1; println!(\"{n}\"); }\n", "static-ownership", "//"), pl13-lens("ruby", "Ruby", ".rb", ["pl13-language[ruby]", "puts ", "def ", "\nend"], "class Greeter\n  def greet(name)\n    puts \"Hello #{name}\"\n  end\nend\n", "dynamic", "#"), pl13-lens("php", "PHP", ".php", ["pl13-language[php]", "<?php", "$", "echo "], "<?php\n$name = \"world\";\necho \"Hello $name\";\n?>\n", "dynamic-gradual", "//"), pl13-lens("swift", "Swift", ".swift", ["pl13-language[swift]", "import Foundation", "func ", "let "], "import Foundation\nfunc greet(_ name: String) -> String { let prefix = \"Hello \"; return prefix + name }\n", "static-arc", "//"), pl13-lens("kotlin", "Kotlin", ".kt", ["pl13-language[kotlin]", "data class ", "val ", "fun main(", "println("], "data class User(val name: String)\nfun main() { println(User(\"Ada\").name) }\n", "static-managed", "//")];
    def pl13-find(id, lenses) = (Comparable) len(lenses) == 0 ? empty() : (String) id == pl13-id(lenses[0]) ? lenses[0] : pl13-find(id, lenses[1:]);
    def pl13-lens-by-id(id) = pl13-find(id, pl13-registry());
    def pl13-marker-score(source, markers, score) = (Comparable) len(markers) == 0 ? score : pl13-marker-score(source, markers[1:], (Number) score + (Number) (str_find(source, markers[0], 0) >= 0 ? 1 : 0));
    def pl13-score(source, lens) = pl13-marker-score(source, pl13-markers(lens), 0);
    def pl13-ranked-go(source, lenses, out) = (Comparable) len(lenses) == 0 ? reverse(out) : pl13-ranked-go(source, lenses[1:], cons([pl13-id(lenses[0]), pl13-score(source, lenses[0])], out));
    def pl13-detection-evidence(source) = pl13-ranked-go(source, pl13-registry(), empty());
    def pl13-best-go(source, lenses, best, best-score) = (Comparable) len(lenses) == 0 ? (Comparable) best-score == 0 ? "unknown" : pl13-id(best) : {
        let candidate = lenses[0];
        let score = pl13-score(source, candidate);
        score > best-score ? pl13-best-go(source, lenses[1:], candidate, score) : pl13-best-go(source, lenses[1:], best, best-score);
    };
    def pl13-detect(source) = pl13-best-go(source, pl13-registry(), empty(), 0);
    // The language-neutral input recipe for this rung.
    // op is exactly one of add/sub/mul; names are assumed already valid.
    def pl13-binary-spec(name, left, right, op) = [name, left, right, op];
    def pl13-spec-name(spec) = spec[0];
    def pl13-spec-left(spec) = spec[1];
    def pl13-spec-right(spec) = spec[2];
    def pl13-spec-op(spec) = spec[3];
    def pl13-op-supported(op) = (String) op == "add" ? 1 : (String) op == "sub" ? 1 : (String) op == "mul" ? 1 : 0;
    def pl13-op-symbol(op) = (String) op == "add" ? "+" : (String) op == "sub" ? "-" : (String) op == "mul" ? "*" : "";
    def pl13-expression(left, op, right) = (left + (" " + (op + (" " + right))));
    def pl13-gen-python(spec, symbol) = ("def " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (", " + (pl13-spec-right(spec) + ("):\n    return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\n"))))))));
    def pl13-gen-javascript(spec, symbol) = ("function " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (", " + (pl13-spec-right(spec) + (") {\n  return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + ";\n}\n"))))))));
    def pl13-gen-typescript(spec, symbol) = ("function " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (": number, " + (pl13-spec-right(spec) + (": number): number {\n  return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + ";\n}\n"))))))));
    def pl13-gen-c-family(spec, symbol) = ("int " + (pl13-spec-name(spec) + ("(int " + (pl13-spec-left(spec) + (", int " + (pl13-spec-right(spec) + (") {\n  return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + ";\n}\n"))))))));
    def pl13-gen-java-family(spec, symbol) = ("static int " + (pl13-spec-name(spec) + ("(int " + (pl13-spec-left(spec) + (", int " + (pl13-spec-right(spec) + (") {\n  return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + ";\n}\n"))))))));
    def pl13-gen-go(spec, symbol) = ("func " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (" int, " + (pl13-spec-right(spec) + (" int) int {\n\treturn " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\n}\n"))))))));
    def pl13-gen-rust(spec, symbol) = ("fn " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (": i64, " + (pl13-spec-right(spec) + (": i64) -> i64 {\n    " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\n}\n"))))))));
    def pl13-gen-ruby(spec, symbol) = ("def " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (", " + (pl13-spec-right(spec) + (")\n  " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\nend\n"))))))));
    def pl13-gen-php(spec, symbol) = ("function " + (pl13-spec-name(spec) + ("($" + (pl13-spec-left(spec) + (", $" + (pl13-spec-right(spec) + (") {\n  return $" + (pl13-spec-left(spec) + (" " + (symbol + (" $" + (pl13-spec-right(spec) + ";\n}\n"))))))))))));
    def pl13-gen-swift(spec, symbol) = ("func " + (pl13-spec-name(spec) + ("(_ " + (pl13-spec-left(spec) + (": Int, _ " + (pl13-spec-right(spec) + (": Int) -> Int {\n    return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\n}\n"))))))));
    def pl13-gen-kotlin(spec, symbol) = ("fun " + (pl13-spec-name(spec) + ("(" + (pl13-spec-left(spec) + (": Int, " + (pl13-spec-right(spec) + (": Int): Int {\n    return " + (pl13-expression(pl13-spec-left(spec), symbol, pl13-spec-right(spec)) + "\n}\n"))))))));
    def pl13-generate-supported(language, spec, symbol) = (String) language == "python" ? pl13-gen-python(spec, symbol) : (String) language == "javascript" ? pl13-gen-javascript(spec, symbol) : (String) language == "typescript" ? pl13-gen-typescript(spec, symbol) : (String) language == "java" ? pl13-gen-java-family(spec, symbol) : (String) language == "c" ? pl13-gen-c-family(spec, symbol) : (String) language == "cpp" ? pl13-gen-c-family(spec, symbol) : (String) language == "csharp" ? pl13-gen-java-family(spec, symbol) : (String) language == "go" ? pl13-gen-go(spec, symbol) : (String) language == "rust" ? pl13-gen-rust(spec, symbol) : (String) language == "ruby" ? pl13-gen-ruby(spec, symbol) : (String) language == "php" ? pl13-gen-php(spec, symbol) : (String) language == "swift" ? pl13-gen-swift(spec, symbol) : (String) language == "kotlin" ? pl13-gen-kotlin(spec, symbol) : "";
    def pl13-generate(language, spec) = (Comparable) pl13-op-supported(pl13-spec-op(spec)) == 0 ? "" : (Comparable) len(pl13-lens-by-id(language)) == 0 ? "" : pl13-generate-supported(language, spec, pl13-op-symbol(pl13-spec-op(spec)));
    // Detectable generation is a separate, still-valid source surface. The plain
    // generator above stays byte-exact and annotation-free; this one adds an
    // explicit language comment so structurally-identical C-family functions can
    // re-enter the intended registry lens without pretending syntax can decide.
    def pl13-language-sentinel(language) = {
        let lens = pl13-lens-by-id(language);
        (Comparable) len(lens) == 0 ? "" : (pl13-comment(lens) + (" pl13-language[" + (language + "]\n")));
    };
    def pl13-generate-detectable(language, spec) = {
        let code = pl13-generate(language, spec);
        (Comparable) len(code) == 0 ? "" : (String) language == "php" ? ("<?php\n" + (pl13-language-sentinel(language) + (code + "?>\n"))) : ((String) pl13-language-sentinel(language) + code);
    };
    def pl13-generate-all-go(lenses, spec, out) = (Comparable) len(lenses) == 0 ? reverse(out) : pl13-generate-all-go(lenses[1:], spec, cons([pl13-id(lenses[0]), pl13-generate(pl13-id(lenses[0]), spec)], out));
    def pl13-generate-all(spec) = pl13-generate-all-go(pl13-registry(), spec, empty());
    // Executable audit and boundary: flags are evidence, not aspirations.
    def pl13-artifact-audit() = [["foreign-language-cells", 0, [], "not carried: the parse/emit walkers for these four surfaces are in git history"], ["form-seedbank-emitters", 0, [], "not carried: the emit templates for these four surfaces are in git history"], ["shared-imperative-grammar", 1, ["expressions", "statements"], "form/form-stdlib/lang-common.fk"], ["form-source-text-emitter", 1, ["form"], "form/form-stdlib/source-compiler-text-lens.fk"], ["this-native-lens", 13, ["lexical-detect", "binary-add-sub-mul-emit"], "cognition/pl-lenses-13.fk"]];
    // (lexical-detect, bounded-generate, full-parse, AST-roundtrip, typecheck,
    //  compile, execute, arbitrary-transpile, identifier-escape)
    def pl13-capability-flags() = [1, 1, 0, 0, 0, 0, 0, 0, 0];
}
