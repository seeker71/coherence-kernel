; family-constellation-inquiry.fk — family as a situated relationship graph,
; never a role-label pretending to be a person.
;
; This is a structural and inquiry framework, not a clinical truth oracle.
; A constellation exercise may enter as reported or imagined evidence; it does
; not become an observed fact about another person without an appropriate
; witness. Missing, excluded, ended, and unknown remain explicit.
;
; Composes identity-space-answer-kernel:
;   - POINT / WE / US are inclusion shapes
;   - SELF / YOU / IT are viewpoint roles
;   - constellations are commutative member sets
;   - NOT is relative to a named boundary
; and native-inquiry-derivation:
;   - every emitted answer node can become the next question's subject
;
; Family response:
; [nothing,0,1,alternative,ack,reason,answer,receipt,steps]
; reason 0 complete, 1 unknown subject, 2 fuel, 4 lane, 5 malformed context,
;        6 no observed answer, 7 proposed scalar mismatched,
;        8 WHY is not freshly known.
;
; witnessed: 2026-07-26 -> full fkwu response final success 1;
; twelve-finding structural projection 4095 on fkwu/Go/Rust/TypeScript
import "identity-space-answer-kernel.fk"

(do
  ; Relations. Direction belongs to the edge, never to the member identity.
  (defn fci-parent () 0)
  (defn fci-partner () 1)
  (defn fci-sibling () 2)
  (defn fci-caregiver () 3)
  (defn fci-household-relation () 4)
  (defn fci-chosen-relation () 5)
  (defn fci-pattern () 6)

  ; Boundaries are plural and non-interchangeable.
  (defn fci-biological () 0)
  (defn fci-legal () 1)
  (defn fci-household () 2)
  (defn fci-chosen () 3)
  (defn fci-remembered () 4)

  ; Evidence kind records provenance, not an automatic truth ranking.
  (defn fci-observed () 0)
  (defn fci-reported () 1)
  (defn fci-documented () 2)
  (defn fci-inferred () 3)
  (defn fci-imagined () 4)
  (defn fci-unknown () 5)

  ; Canonical global symbols. Labels and names remain aliases outside identity.
  (defn fci-member-symbol (instance) (lnsi-node 2 50 1 instance))
  (defn fci-edge-symbol (relation instance)
    (lnsi-node 2 51 (add relation 1) instance))
  (defn fci-boundary-symbol (kind instance)
    (lnsi-node 2 52 (add kind 1) instance))

  ; member = [node,generation,born,ended]. ended=0 means no observed ending.
  (defn fci-member (instance generation born ended)
    (list (fci-member-symbol instance) generation born ended))
  (defn fci-m-node (m) (nth m 0))
  (defn fci-m-generation (m) (nth m 1))
  (defn fci-m-born (m) (nth m 2))
  (defn fci-m-ended (m) (nth m 3))
  (defn fci-member-ended-at? (m time)
    (if (and (gt (fci-m-ended m) 0) (ge time (fci-m-ended m))) 1 0))

  ; edge =
  ; [node,left,right,relation,symmetric,begins,ends,evidence,belief,opinion]
  ; symmetric=0 preserves left->right direction; symmetric=1 quotients pair order.
  (defn fci-edge
    (instance left right relation symmetric begins ends evidence belief opinion)
    (list (fci-edge-symbol relation instance) left right relation symmetric
      begins ends evidence belief opinion))
  (defn fci-e-node (e) (nth e 0))
  (defn fci-e-left (e) (nth e 1))
  (defn fci-e-right (e) (nth e 2))
  (defn fci-e-relation (e) (nth e 3))
  (defn fci-e-symmetric (e) (nth e 4))
  (defn fci-e-begins (e) (nth e 5))
  (defn fci-e-ends (e) (nth e 6))
  (defn fci-e-evidence (e) (nth e 7))
  (defn fci-e-belief (e) (nth e 8))
  (defn fci-e-opinion (e) (nth e 9))
  (defn fci-edge-active? (e time)
    (if (and (ge time (fci-e-begins e))
      (or (eq (fci-e-ends e) 0) (le time (fci-e-ends e)))) 1 0))
  (defn fci-edge-pair? (e left right)
    (if (eq (fci-e-symmetric e) 1)
      (if (or
        (and (eq (fci-e-left e) left) (eq (fci-e-right e) right))
        (and (eq (fci-e-left e) right) (eq (fci-e-right e) left))) 1 0)
      (if (and (eq (fci-e-left e) left) (eq (fci-e-right e) right)) 1 0)))
  (defn fci-edge-matches? (e left right relation time)
    (if (and (eq (fci-edge-active? e time) 1)
      (and (eq (fci-edge-pair? e left right) 1)
        (or (eq relation -1) (eq (fci-e-relation e) relation)))) 1 0))

  ; boundary = [node,kind,begins,ends,member-nodes]
  (defn fci-boundary (instance kind begins ends members)
    (list (fci-boundary-symbol kind instance) kind begins ends members))
  (defn fci-b-node (b) (nth b 0))
  (defn fci-b-kind (b) (nth b 1))
  (defn fci-b-begins (b) (nth b 2))
  (defn fci-b-ends (b) (nth b 3))
  (defn fci-b-members (b) (nth b 4))
  (defn fci-boundary-active? (b time)
    (if (and (ge time (fci-b-begins b))
      (or (eq (fci-b-ends b) 0) (le time (fci-b-ends b)))) 1 0))
  (defn fci-boundary-members-at (b time)
    (if (eq (fci-boundary-active? b time) 1)
      (isk-constellation (fci-b-members b))
      (isk-constellation (list))))
  (defn fci-boundary-has? (b member time)
    (if (eq (fci-boundary-active? b time) 0) 0
      (isk-member? member (fci-b-members b))))

  ; system = [root-inquiry-node,members,edges,boundaries]
  (defn fci-system (root members edges boundaries)
    (list root members edges boundaries))
  (defn fci-s-root (s) (nth s 0))
  (defn fci-s-members (s) (nth s 1))
  (defn fci-s-edges (s) (nth s 2))
  (defn fci-s-boundaries (s) (nth s 3))
  (defn fci-member-present-loop (members node)
    (if (eq (len members) 0) 0
      (if (eq (fci-m-node (head members)) node) 1
        (fci-member-present-loop (tail members) node))))
  (defn fci-member-present? (system node)
    (fci-member-present-loop (fci-s-members system) node))
  (defn fci-boundary-present-loop (boundaries node)
    (if (eq (len boundaries) 0) 0
      (if (eq (fci-b-node (head boundaries)) node) 1
        (fci-boundary-present-loop (tail boundaries) node))))
  (defn fci-boundary-present? (system boundary)
    (if (not (eq (len boundary) 5)) 0
      (fci-boundary-present-loop
        (fci-s-boundaries system) (fci-b-node boundary))))

  ; From A, B may be YOU; from B, the same B is SELF. The member node does not
  ; change when the viewpoint role rotates.
  (defn fci-view-role (observer member addressed)
    (if (eq observer member) 0 (if (eq addressed 1) 1 2)))

  ; Only observed/reported/documented evidence may become known-for-now here.
  ; Inference and imagination remain valuable experiences with knowing=0.
  (defn fci-evidence-admissible? (e)
    (if (and (ge (fci-e-evidence e) 0) (le (fci-e-evidence e) 2)) 1 0))
  (defn fci-edge-knowing (e epoch)
    (if (eq (fci-evidence-admissible? e) 0) 0
      (if (eq (sl-valid? (fci-e-opinion e) 1) 0) 0
        (if (lt (sl-expectation (fci-e-opinion e)) 500) 0
          (if (not (eq (bf-id (fci-e-belief e)) (fci-e-node e))) 0
            (bf-status (fci-e-belief e) epoch))))))
  (defn fci-edge-score (e epoch)
    (add (mul (fci-edge-knowing e epoch) 10000)
      (sl-expectation (fci-e-opinion e))))

  (defn fci-best-edge-loop (edges left right relation time epoch best)
    (if (eq (len edges) 0) best
      (do
        (let edge (head edges))
        (if (eq (fci-edge-matches? edge left right relation time) 0)
          (fci-best-edge-loop (tail edges) left right relation time epoch best)
          (if (nothing? best)
            (fci-best-edge-loop (tail edges) left right relation time epoch edge)
            (fci-best-edge-loop (tail edges) left right relation time epoch
              (if (gt (fci-edge-score edge epoch) (fci-edge-score best epoch))
                edge best)))))))
  (defn fci-best-edge (system left right relation time epoch)
    (fci-best-edge-loop (fci-s-edges system)
      left right relation time epoch (nothing)))

  (defn fci-agreement-count-loop (edges left right relation time epoch count)
    (if (eq (len edges) 0) count
      (do
        (let edge (head edges))
        (fci-agreement-count-loop (tail edges) left right relation time epoch
          (add count (if (and
            (eq (fci-edge-matches? edge left right relation time) 1)
            (gt (fci-edge-knowing edge epoch) 0)) 1 0))))))
  (defn fci-agreement-count (system left right relation time epoch)
    (fci-agreement-count-loop (fci-s-edges system)
      left right relation time epoch 0))

  ; question =
  ; [subject,lane,actor,target,relation,boundary,time,claim,viewpoint,epoch,fuel]
  ; Scalar claims are supported in this first slice. Structural answer
  ; comparison is deliberately not guessed.
  (defn fci-question
    (subject lane actor target relation boundary time claim viewpoint epoch fuel)
    (list subject lane actor target relation boundary time claim viewpoint epoch fuel))
  (defn fci-q-subject (q) (nth q 0))
  (defn fci-q-lane (q) (nth q 1))
  (defn fci-q-actor (q) (nth q 2))
  (defn fci-q-target (q) (nth q 3))
  (defn fci-q-relation (q) (nth q 4))
  (defn fci-q-boundary (q) (nth q 5))
  (defn fci-q-time (q) (nth q 6))
  (defn fci-q-claim (q) (nth q 7))
  (defn fci-q-viewpoint (q) (nth q 8))
  (defn fci-q-epoch (q) (nth q 9))
  (defn fci-q-fuel (q) (nth q 10))

  ; answer pair = [answer, supporting-edge-or-nothing]
  (defn fci-answer-pair (system q)
    (do
      (let lane (fci-q-lane q))
      (let edge (if (or (eq lane 1) (eq lane 3)) (nothing)
        (fci-best-edge system (fci-q-actor q) (fci-q-target q)
          (fci-q-relation q) (fci-q-time q) (fci-q-epoch q))))
      (if (eq lane 0)
        (if (nothing? edge) (list (nothing) (nothing))
          (list (fci-e-relation edge) edge))
      (if (eq lane 1)
        (list (fci-boundary-has? (fci-q-boundary q)
          (fci-q-actor q) (fci-q-time q)) (nothing))
      (if (eq lane 2)
        (if (nothing? edge) (list (nothing) (nothing))
          (list (fci-e-begins edge) edge))
      (if (eq lane 3)
        (list (fci-boundary-members-at
          (fci-q-boundary q) (fci-q-time q)) (nothing))
      (if (eq lane 4)
        (if (nothing? edge) (list (nothing) (nothing))
          (list (fci-e-node edge) edge))
      (if (eq lane 5)
        (if (nothing? edge) (list (nothing) (nothing))
          (list (fci-e-node edge) edge))
      (if (eq lane 6)
        (if (nothing? edge) (list (nothing) (nothing))
          (if (eq (fci-edge-knowing edge (fci-q-epoch q)) 2)
            (list (fci-e-node edge) edge)
            (list (nothing) edge)))
        (list (nothing) (nothing)))))))))))
  (defn fci-ap-answer (p) (nth p 0))
  (defn fci-ap-edge (p) (nth p 1))

  ; receipt =
  ; [derived,lane,actor,target,relation,boundary,time,viewpoint,answer,
  ;  evidence-kind,knowing,agreement,native-receipt]
  (defn fci-receipt
    (derived lane actor target relation boundary time viewpoint answer
      evidence knowing agreement native)
    (list derived lane actor target relation (fci-b-node boundary) time viewpoint
      answer evidence knowing agreement native))
  (defn fci-response (alternative ack reason answer receipt steps)
    (list (nothing) 0 1 alternative ack reason answer receipt steps))
  (defn fci-r-alt (r) (nth r 3))
  (defn fci-r-ack (r) (nth r 4))
  (defn fci-r-reason (r) (nth r 5))
  (defn fci-r-answer (r) (nth r 6))
  (defn fci-r-receipt (r) (nth r 7))
  (defn fci-r-steps (r) (nth r 8))
  (defn fci-response-arms? (r)
    (if (and (nothing? (nth r 0)) (and (eq (nth r 1) 0)
      (and (eq (nth r 2) 1) (eq (nid-valid? (nth r 3)) 1)))) 1 0))

  (defn fci-query-context-valid? (system q)
    (if (and (eq (fci-boundary-present? system (fci-q-boundary q)) 1)
      (and (eq (fci-member-present? system (fci-q-actor q)) 1)
      (and (eq (fci-member-present? system (fci-q-viewpoint q)) 1)
        (if (or (eq (fci-q-lane q) 1) (eq (fci-q-lane q) 3)) 1
          (fci-member-present? system (fci-q-target q)))))) 1 0))

  (defn fci-ask (system q)
    (if (eq (fci-query-context-valid? system q) 0)
      (fci-response 1 (nothing) 5 (nothing) (list) 0)
      (do
        (let native (nid-inquire
          (fci-q-subject q) (fci-q-lane q) (fci-q-fuel q)))
        (let native-ack (nid-p-ack native))
        (if (nothing? native-ack)
          (fci-response (nid-p-alt native) (nothing) (nid-p-reason native)
            (nothing) (list) (nth native 7))
          (do
            (let pair (fci-answer-pair system q))
            (let answer (fci-ap-answer pair))
            (let edge (fci-ap-edge pair))
            (if (nothing? answer)
              (fci-response (nid-p-alt native) (nothing)
                (if (eq (fci-q-lane q) 6) 8 6)
                (nothing) (list) (nth native 7))
              (do
                (let agreement (if (nothing? edge) 0
                  (fci-agreement-count system
                    (fci-q-actor q) (fci-q-target q) (fci-q-relation q)
                    (fci-q-time q) (fci-q-epoch q))))
                (let open-ack (if (and (eq (fci-q-lane q) 5)
                  (gt agreement 1)) 1 native-ack))
                (let ack (if (nothing? (fci-q-claim q)) open-ack
                  (if (eq (fci-q-claim q) answer) 1 0)))
                (let reason (if (eq ack 0) 7 0))
                (let evidence (if (nothing? edge)
                  (fci-unknown) (fci-e-evidence edge)))
                (let knowing (if (nothing? edge)
                  0 (fci-edge-knowing edge (fci-q-epoch q))))
                (let receipt (fci-receipt native-ack
                  (fci-q-lane q) (fci-q-actor q) (fci-q-target q)
                  (fci-q-relation q) (fci-q-boundary q) (fci-q-time q)
                  (fci-q-viewpoint q) answer evidence knowing agreement
                  (nid-p-receipt native)))
                (fci-response (nid-p-alt native) ack reason answer receipt
                  (nth native 7)))))))))

  ; A small observed fixture. Letter names exist only in comments; member
  ; identity is numeric composition.
  (defn fci-fixture ()
    (do
      (let epoch 20260726)
      (let strong (sl-opinion 800 50 150 500))
      (let medium (sl-opinion 650 100 250 500))
      (let imagined (sl-opinion 950 0 50 500))
      ; A ended in 2020; B, C, D have no observed ending.
      (let a (fci-member 101 0 19500101 20200101))
      (let b (fci-member 102 1 19800101 0))
      (let c (fci-member 103 2 20100101 0))
      (let d (fci-member 104 1 19850101 0))
      (let an (fci-m-node a))
      (let bn (fci-m-node b))
      (let cn (fci-m-node c))
      (let dn (fci-m-node d))
      (let e1n (fci-edge-symbol (fci-parent) 1))
      (let e2n (fci-edge-symbol (fci-parent) 2))
      (let e3n (fci-edge-symbol (fci-parent) 3))
      (let e4n (fci-edge-symbol (fci-sibling) 4))
      (let e5n (fci-edge-symbol (fci-caregiver) 5))
      (let e6n (fci-edge-symbol (fci-pattern) 6))
      (let edges (list
        (fci-edge 1 an bn (fci-parent) 0 19800101 0
          (fci-documented) (bf-belief e1n 1 epoch) strong)
        (fci-edge 2 an bn (fci-parent) 0 19800101 0
          (fci-reported) (bf-belief e2n 1 epoch) medium)
        (fci-edge 3 bn cn (fci-parent) 0 20100101 0
          (fci-documented) (bf-belief e3n 1 epoch) strong)
        (fci-edge 4 bn dn (fci-sibling) 1 19850101 0
          (fci-reported) (bf-belief e4n 1 epoch) medium)
        (fci-edge 5 an cn (fci-caregiver) 0 20100101 0
          (fci-documented) (bf-belief e5n 1 20250101) medium)
        (fci-edge 6 an dn (fci-pattern) 0 20260726 0
          (fci-imagined) (bf-belief e6n 1 epoch) imagined)))
      (let boundaries (list
        (fci-boundary 1 (fci-biological) 19000101 0 (list an bn cn))
        (fci-boundary 2 (fci-household) 20200101 0 (list an bn))
        (fci-boundary 3 (fci-chosen) 20000101 0 (list bn dn))))
      (fci-system 1 (list a b c d) edges boundaries)))

  (defn fci-bit (condition bit) (if condition bit 0))

  ; Twelve structural findings. This function deliberately avoids first-class
  ; nothing so the minimal Go/Rust/TypeScript walkers can witness it too.
  (defn fci-findings-witness ()
    (do
      (let system (fci-fixture))
      (let members (fci-s-members system))
      (let edges (fci-s-edges system))
      (let boundaries (fci-s-boundaries system))
      (let a (nth members 0))
      (let b (nth members 1))
      (let c (nth members 2))
      (let d (nth members 3))
      (let an (fci-m-node a))
      (let bn (fci-m-node b))
      (let cn (fci-m-node c))
      (let dn (fci-m-node d))
      (let e1 (nth edges 0))
      (let e3 (nth edges 2))
      (let e4 (nth edges 3))
      (let e6 (nth edges 5))
      (let bio (nth boundaries 0))
      (let house (nth boundaries 1))
      (let chosen (nth boundaries 2))
      (let at 20260726)
      (let not-bio-a (isk-not (fci-boundary-members-at bio at)
        (isk-constellation (list an))))
      (let not-house-a (isk-not (fci-boundary-members-at house at)
        (isk-constellation (list an))))
      (add
        ; 1: one person may be inside biological and outside household.
        (fci-bit (and (eq (fci-boundary-has? bio cn at) 1)
          (eq (fci-boundary-has? house cn at) 0)) 1)
        (add
        ; 2: chosen family can include a member biological lineage does not.
        (fci-bit (and (eq (fci-boundary-has? chosen dn at) 1)
          (eq (fci-boundary-has? bio dn at) 0)) 2)
        (add
        ; 3: parent direction is not reversible.
        (fci-bit (and
          (eq (fci-edge-matches? e1 an bn (fci-parent) at) 1)
          (eq (fci-edge-matches? e1 bn an (fci-parent) at) 0)) 4)
        (add
        ; 4: a symmetric sibling relation is order-independent.
        (fci-bit (and
          (eq (fci-edge-matches? e4 bn dn (fci-sibling) at) 1)
          (eq (fci-edge-matches? e4 dn bn (fci-sibling) at) 1)) 8)
        (add
        ; 5: B can be child on one edge and parent on another without changing B.
        (fci-bit (and (eq (fci-e-right e1) bn)
          (eq (fci-e-left e3) bn)) 16)
        (add
        ; 6: YOU rotates to SELF at B's viewpoint; B's identity is unchanged.
        (fci-bit (and (eq (fci-view-role an bn 1) 1)
          (eq (fci-view-role bn bn 1) 0)) 32)
        (add
        ; 7: an observed ending does not erase lineage identity or membership.
        (fci-bit (and (eq (fci-member-ended-at? a at) 1)
          (and (eq (fci-member-present? system an) 1)
               (eq (fci-boundary-has? bio an at) 1))) 64)
        (add
        ; 8: NOT changes with its named family boundary.
        (fci-bit (eq (isk-constellation-eq? not-bio-a not-house-a) 0) 128)
        (add
        ; 9: membership changes with time while the member node stays stable.
        (fci-bit (and (eq (fci-boundary-has? house bn 20190101) 0)
          (eq (fci-boundary-has? house bn at) 1)) 256)
        (add
        ; 10: knowledge ages while the relationship symbol does not.
        (fci-bit (and (eq (fci-edge-knowing e1 20260726) 2)
          (eq (fci-edge-knowing e1 20270101) 1)) 512)
        (add
        ; 11: two independently-provenance-marked edges agree on A->B parent.
        (fci-bit (eq (fci-agreement-count
          system an bn (fci-parent) at 20260726) 2) 1024)
        ; 12: vivid imagination remains knowing=0 even with high expectation.
        (fci-bit (and (gt (sl-expectation (fci-e-opinion e6)) 900)
          (eq (fci-edge-knowing e6 20260726) 0)) 2048))))))))))))))

  (defn fci-witness ()
    (do
      (let system (fci-fixture))
      (let members (fci-s-members system))
      (let edges (fci-s-edges system))
      (let boundaries (fci-s-boundaries system))
      (let an (fci-m-node (nth members 0)))
      (let bn (fci-m-node (nth members 1)))
      (let cn (fci-m-node (nth members 2)))
      (let dn (fci-m-node (nth members 3)))
      (let bio (nth boundaries 0))
      (let house (nth boundaries 1))
      (let chosen (nth boundaries 2))
      ; Open answers recurse: WHAT -> WHEN -> WHO -> HOW.
      (let what (fci-ask system (fci-question 1 0 an bn
        (fci-parent) bio 20260726 (nothing) an 20260726 1)))
      (let when (fci-ask system (fci-question (fci-r-ack what) 2 bn cn
        (fci-parent) bio 20260726 (nothing) bn 20260726 1)))
      (let who (fci-ask system (fci-question (fci-r-ack when) 3 an 0 -1 bio 20260726
        (nothing) an 20260726 1)))
      (let how-single (fci-ask system (fci-question (fci-r-ack who) 4 bn cn
        (fci-parent) bio 20260726 (nothing) bn 20260726 1)))
      (let where-yes (fci-ask system (fci-question 1 1 cn 0 -1 bio 20260726
        1 an 20260726 1)))
      (let where-no (fci-ask system (fci-question 1 1 cn 0 -1 house 20260726
        1 an 20260726 1)))
      (let why-imagined (fci-ask system (fci-question 1 6 an dn
        (fci-pattern) chosen 20260726 (nothing) an 20260726 1)))
      (let which-agrees (fci-ask system (fci-question 1 5 an bn
        (fci-parent) bio 20260726 (nothing) an 20260726 1)))
      (let findings (fci-findings-witness))
      (let success (if (and (eq findings 4095)
        (and (eq (fci-response-arms? what) 1)
        (and (eq (nid-valid? (fci-r-ack what)) 1)
        (and (eq (fci-r-answer what) (fci-parent))
        (and (eq (nid-valid? (fci-r-ack when)) 1)
        (and (eq (fci-r-answer when) 20100101)
        (and (eq (nid-valid? (fci-r-ack who)) 1)
        (and (eq (fci-r-ack where-yes) 1)
        (and (eq (fci-r-ack where-no) 0)
        (and (nothing? (fci-r-ack why-imagined))
        (and (eq (fci-r-reason why-imagined) 8)
        (and (eq (fci-r-ack which-agrees) 1)
        (and (eq (nid-valid? (fci-r-ack how-single)) 1)
             (eq (fci-r-reason how-single) 0)))))))))))))) 1 0))
      ; [nothing,0,1,alternative, findings, recursive WHAT/WHEN/WHO/HOW nodes,
      ;  WHERE yes/no, WHY-nothing/reason, WHICH-agreement,
      ;  sample WHAT/WHEN/WHO/WHICH answers, success]
      (list (nothing) 0 1 (fci-r-alt what)
        findings
        (fci-r-ack what) (fci-r-ack when)
        (fci-r-ack who) (fci-r-ack how-single)
        (fci-r-ack where-yes) (fci-r-ack where-no)
        (fci-r-ack why-imagined) (fci-r-reason why-imagined)
        (fci-r-ack which-agrees)
        (fci-r-answer what) (fci-r-answer when)
        (fci-r-answer who) (fci-r-answer which-agrees)
        success)))

  0)
