; multilingual-balance-response.fk — a Form-native composed answer for healing
; English dominance while deepening the concept model and world model.
;
; This is composition, not neural generation: the answer text and accounting are
; recipe-data executed by fkwu. A caller may add remote framing, but the receipt
; measures whether native-composed words remain the majority. Content parity is
; measured by witnessed semantic coverage, not by inflating translated byte count.
; witnessed: 2026-07-20 -> 255 four-way; 326 native-composed words, 76% share
; with an explicit allowance of 100 remote framing words.
;
; preludes: form-stdlib/core.fk

(do
    (defn mbr-space? (b) (if (eq b 32) 1 (if (eq b 10) 1 (if (eq b 9) 1 0))))
    (defn mbr-words-loop (s i in-word count)
        (if (ge i (str_len s)) count
            (if (eq (mbr-space? (str_byte_at s i)) 1)
                (mbr-words-loop s (add i 1) 0 count)
                (if (eq in-word 1)
                    (mbr-words-loop s (add i 1) 1 count)
                    (mbr-words-loop s (add i 1) 1 (add count 1))))))
    (defn mbr-word-count (s) (mbr-words-loop s 0 0 0))

    ; native share in whole percentage points. "remote" is any framing or
    ; generative continuation supplied outside this Form-composed answer.
    (defn mbr-native-share (native-text remote-words)
        (do
            (let native-words (mbr-word-count native-text))
            (if (eq (add native-words remote-words) 0) 0
                (div (mul native-words 100) (add native-words remote-words)))))
    (defn mbr-native-majority? (native-text remote-words)
        (if (gt (mbr-word-count native-text) remote-words) 1 0))

    (defn multilingual-balance-response ()
        (str_concat
            "Change the corpus by growing knowledge from inside each language, not by making bulk translations of English. Choose Chinese and Arabic as the first parity lanes, keep Sanskrit as a lineage lane, and let every language contribute concepts that entered the body through sources written in that language. A neutral content-addressed cell may join equivalent meanings, but distinct meanings must remain distinct. "
            (str_concat
            "For every admitted unit, retain the original passage, language, author or community, place, witnessed date, source lineage, translation, confidence, and consent or licence. Resolve names through time instead of mapping one word permanently to one object. A missing source or unresolved translation returns nothing. "
            (str_concat
            "Improve the concept model by requiring each concept to answer what, who, when, where, which, how, and why; carry examples, counterexamples, relations, and disagreements; and test whether translations preserve or split the meaning. Improve the world model by storing entities, observations, events, state transitions, causal proposals, and competing witnesses as typed cells. Structural cells are stored once. Temporal edges say when a name, claim, or relation applied. "
            (str_concat
            "Use a repeating healthy ingest loop: select a native-language source; segment it without translating first; propose concepts and events; attach provenance and temporal scope; compare across languages; ask a fluent human or trusted source to witness the interpretation; execute every computable relation; then freeze, hold, or compost it. Never reward volume without provenance. "
            (str_concat
            "Measure progress with one simple proxy per language: witnessed semantic cells that have native source text, seven-plane coverage, executable checks where possible, and reversible translation. Publish the count and the English ratio. Grow the smallest language lane next until Chinese and Arabic each reach parity. "
            "For responses, retrieve these cells and let Form compose the grounded structure, citations, uncertainty, and stopping result before any borrowed voice adds connective prose. Count Form-composed words and remote words on every answer. Keep the native share above fifty percent only when the native cells actually hold the answer; otherwise report the smaller share honestly."))))))

    (defn multilingual-balance-receipt (remote-words)
        (do
            (let response (multilingual-balance-response))
            (list "multilingual-balance-response-v1"
                  (mbr-word-count response)
                  remote-words
                  (mbr-native-share response remote-words)
                  (mbr-native-majority? response remote-words)
                  "form-native-composition-not-neural-generation")))

    0)
