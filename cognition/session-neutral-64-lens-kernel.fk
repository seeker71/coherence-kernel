; session-neutral-64-lens-kernel.fk — one generated 64-cell field, six
; attributed lenses, and an inspectable endogenous rank.
;
; This organ does not collapse traditions into equivalence.  The I Ching,
; Human Design, and Gene Keys already share an attested ordinal cell in
; iching-channel.fk.  Astrology projects that Human Design gate through the
; measured mandala.  Steiner contributes a constructed BE/DO/SEE reading of
; an existing neutral fact.  Sanskrit is a lexical realization of the neutral
; sentence recipe; its normalized syntax is speaker-unreviewed and is not
; presented as literary Sanskrit.
;
; The generated sentence lattice uses all thirteen field symbols exactly as
; roles rather than storing 64 prose rows:
;   agency   = trust | sovereignty | vitality | love
;   relation = coherence | resonance | flow | harmony
;   opening  = clarify | awe | humor | excitement
;   context  = grace
; Three base-four digits generate 4^3 = 64 distinct clauses.  The ordinal
; digits are a synthesis address, not a reconstruction of King Wen line bits.
;
; "Inner knowing" is made inspectable as six coordinates carried by the
; sentence itself: trust, sovereignty, vitality, coherence, resonance, flow.
; A cell's rank is 1 + the number of other cells whose vector Pareto-dominates
; it.  Ties remain ties; gate order is only a display order.  No hidden weight,
; rented model, random oracle, or mystical truth claim decides the rank.
; witnessed: 2026-08-24 -> 64 generated cells / band 65535 / 576 graph edges
;
; preludes: cognition/session-neutral-discourse-growth.fk
; preludes: form/form-stdlib/iching-channel.fk
; preludes: form/form-stdlib/hd-mandala-wheel.fk
; preludes: form/form-stdlib/zodiac-channel.fk
; preludes: cognition/steiner-neutral-kernel.fk

(do
  (defn sn64-count () 64)
  (defn sn64-gate-valid? (gate)
    (if (and (ge gate 1) (le gate (sn64-count))) 1 0))
  (defn sn64-cell-address (gate) (snsf-address 29 gate))
  (defn sn64-lens-address (lens gate) (snsf-address 30 (list lens gate)))
  (defn sn64-surface-address (gate surface)
    (snsf-address 31 (list gate (nmfe-string-bytes surface))))

  ; ── 4 x 4 x 4 generated neutral sentence lattice ───────────────
  (defn sn64-index (gate) (sub gate 1))
  (defn sn64-agency-digit (gate) (div (sn64-index gate) 16))
  (defn sn64-relation-digit (gate)
    (mod (div (sn64-index gate) 4) 4))
  (defn sn64-opening-digit (gate) (mod (sn64-index gate) 4))
  (defn sn64-field-from (ids digit)
    (snsf-field-address (nth ids digit)))
  (defn sn64-agency (gate)
    (sn64-field-from (list 7 8 2 0) (sn64-agency-digit gate)))
  (defn sn64-relation (gate)
    (sn64-field-from (list 11 12 10 1) (sn64-relation-digit gate)))
  (defn sn64-opening (gate)
    (sn64-field-from (list 3 4 5 6) (sn64-opening-digit gate)))
  (defn sn64-context () (snsf-field-address 9))
  (defn sn64-mode (gate)
    (sndg-mode (mod (add (sn64-agency-digit gate)
                      (add (sn64-relation-digit gate)
                        (sn64-opening-digit gate))) 3)))
  (defn sn64-clause (gate)
    (if (eq (sn64-gate-valid? gate) 0) (empty)
      (sndg-clause (sn64-agency gate) (sn64-mode gate)
        (sn64-relation gate) (sn64-opening gate) (sn64-context))))
  (defn sn64-signature (gate)
    (if (eq (sn64-gate-valid? gate) 0) (empty)
      (list (sn64-agency-digit gate) (sn64-relation-digit gate)
        (sn64-opening-digit gate) (sn64-agency gate) (sn64-relation gate)
        (sn64-opening gate) (sn64-context) (sn64-mode gate))))
  (defn sn64-symbols (gate)
    (list (sn64-agency gate) (sn64-relation gate)
      (sn64-opening gate) (sn64-context)))

  ; ── visible endogenous field and Pareto-domination rank ─────────
  (defn sn64-axis-total (symbols axis)
    (if (eq (len symbols) 0) 0
      (add (nth (fwf-shape (fwf-at (nth (head symbols) 2))) axis)
        (sn64-axis-total (tail symbols) axis))))
  (defn sn64-inner-vector (gate)
    (if (eq (sn64-gate-valid? gate) 0) (empty)
      (do
        (let symbols (sn64-symbols gate))
        (list (sn64-axis-total symbols 7)
          (sn64-axis-total symbols 8)
          (sn64-axis-total symbols 2)
          (sn64-axis-total symbols 11)
          (sn64-axis-total symbols 12)
          (sn64-axis-total symbols 10)))))
  (defn sn64-vector-all-ge? (a b)
    (if (eq (len a) 0) 1
      (if (ge (head a) (head b))
        (sn64-vector-all-ge? (tail a) (tail b)) 0)))
  (defn sn64-vector-any-gt? (a b)
    (if (eq (len a) 0) 0
      (if (gt (head a) (head b)) 1
        (sn64-vector-any-gt? (tail a) (tail b)))))
  (defn sn64-dominates-vector? (a b)
    (if (and (eq (sn64-vector-all-ge? a b) 1)
             (eq (sn64-vector-any-gt? a b) 1)) 1 0))
  (defn sn64-dominates? (a-gate b-gate)
    (sn64-dominates-vector? (sn64-inner-vector a-gate)
      (sn64-inner-vector b-gate)))
  (defn sn64-dominator-count-loop (gate other)
    (if (gt other (sn64-count)) 0
      (add (if (and (not (eq gate other))
                    (eq (sn64-dominates? other gate) 1)) 1 0)
        (sn64-dominator-count-loop gate (add other 1)))))
  (defn sn64-rank (gate)
    (if (eq (sn64-gate-valid? gate) 0) 0
      (add 1 (sn64-dominator-count-loop gate 1))))

  ; cell = address, gate, signature, clause, inner vector, domination rank.
  (defn sn64-cell (gate)
    (if (eq (sn64-gate-valid? gate) 0) (empty)
      (list (sn64-cell-address gate) gate (sn64-signature gate)
        (sn64-clause gate) (sn64-inner-vector gate) (sn64-rank gate))))
  (defn sn64-c-address (cell) (nth cell 0))
  (defn sn64-c-gate (cell) (nth cell 1))
  (defn sn64-c-signature (cell) (nth cell 2))
  (defn sn64-c-clause (cell) (nth cell 3))
  (defn sn64-c-vector (cell) (nth cell 4))
  (defn sn64-c-rank (cell) (nth cell 5))
  (defn sn64-cells-loop (gate)
    (if (gt gate (sn64-count)) (empty)
      (cons (sn64-cell gate) (sn64-cells-loop (add gate 1)))))
  (defn sn64-cells () (sn64-cells-loop 1))

  ; Rank remains a partial-order signal.  Gate is used only to make display
  ; replay stable when cells share a domination rank.
  (defn sn64-display-before? (a b)
    (if (lt (sn64-c-rank a) (sn64-c-rank b)) 1
      (if (and (eq (sn64-c-rank a) (sn64-c-rank b))
               (lt (sn64-c-gate a) (sn64-c-gate b))) 1 0)))
  (defn sn64-insert-ranked (cell cells)
    (if (eq (len cells) 0) (list cell)
      (if (eq (sn64-display-before? cell (head cells)) 1)
        (cons cell cells)
        (cons (head cells) (sn64-insert-ranked cell (tail cells))))))
  (defn sn64-sort-ranked (cells out)
    (if (eq (len cells) 0) out
      (sn64-sort-ranked (tail cells)
        (sn64-insert-ranked (head cells) out))))
  (defn sn64-ranked-cells () (sn64-sort-ranked (sn64-cells) (empty)))

  ; ── attributed lens projections ─────────────────────────────────
  ; projection = address, lens id, gate, neutral value, provenance, state.
  (defn sn64-projection (lens gate value provenance state)
    (list (sn64-lens-address lens gate) lens gate value provenance state))
  (defn sn64-p-address (projection) (nth projection 0))
  (defn sn64-p-lens (projection) (nth projection 1))
  (defn sn64-p-gate (projection) (nth projection 2))
  (defn sn64-p-value (projection) (nth projection 3))
  (defn sn64-p-provenance (projection) (nth projection 4))
  (defn sn64-p-state (projection) (nth projection 5))

  (defn sn64-wheel-index-loop (gate wheel index)
    (if (eq (len wheel) 0) -1
      (if (eq (head wheel) gate) index
        (sn64-wheel-index-loop gate (tail wheel) (add index 1)))))
  (defn sn64-wheel-index (gate)
    (if (eq (sn64-gate-valid? gate) 0) -1
      (sn64-wheel-index-loop gate (hd-wheel) 0)))
  (defn sn64-gate-center (gate)
    (if (eq (sn64-gate-valid? gate) 0) -1.0
      (fnorm360 (add 358.25
        (add (mul (sn64-wheel-index gate) 5.625) 2.8125)))))
  ; Astrology value = centre longitude, tropical sign, sidereal sign,
  ; explicit Lahiri-2000 approximation.  It is a symbolic projection, not a
  ; causal or scientific verdict.
  (defn sn64-astrology-value (gate)
    (do
      (let longitude (sn64-gate-center gate))
      (let ayan (lahiri-ayanamsa-2000))
      (list longitude (tropical-sign-of longitude)
        (sidereal-sign-of longitude ayan) ayan)))
  ; Constructed bridge only: SEE→thinking/awake, BE→feeling/dreaming,
  ; DO→willing/asleep.  The returned fact is Steiner's neutral fact; the bridge
  ; itself is not asserted as a Steiner teaching or a 64-fold equivalence.
  (defn sn64-steiner-value (gate)
    (do
      (let mode-id (nth (sn64-mode gate) 2))
      (if (eq mode-id 2) (nth (stn-soul-facts) 3)
        (if (eq mode-id 0) (nth (stn-soul-facts) 4)
          (nth (stn-soul-facts) 5)))))
  (defn sn64-projections (gate)
    (if (eq (sn64-gate-valid? gate) 0) (empty)
      (list
        (sn64-projection 0 gate gate "iching-channel-documented-tradition"
          "ordinal-face")
        (sn64-projection 1 gate gate "human-design-attested-reference-data"
          "ordinal-face")
        (sn64-projection 2 gate gate "gene-keys-documented-tradition"
          "direct-experience-face")
        (sn64-projection 3 gate (sn64-astrology-value gate)
          "computed-from-attested-hd-mandala"
          "symbolic-projection-not-causal-verdict")
        (sn64-projection 4 gate (sn64-steiner-value gate)
          "constructed-be-do-see-bridge"
          "projection-not-traditional-equivalence")
        (sn64-projection 5 gate (sn64-signature gate)
          "field-recipe-generated"
          "sanskrit-lexical-speaker-unreviewed-syntax"))))

  ; Sanskrit surfaces are generated after neutral identity.  Every content
  ; word comes from the seven-locale field recipe; BE/DO/SEE and arrows remain
  ; explicit neutral syntax until a reviewed Sanskrit grammar sits.
  (defn sn64-realize-sa (runtime dictionary cell)
    (sndg-realize-clause runtime dictionary (sn64-c-clause cell) "sa"))
  (defn sn64-sa-surface (runtime dictionary cell)
    (sndg-cr-surface (sn64-realize-sa runtime dictionary cell)))
  (defn sn64-sa-state (runtime dictionary cell)
    (sndg-cr-state (sn64-realize-sa runtime dictionary cell)))
  (defn sn64-sa-rows (runtime dictionary cells)
    (if (eq (len cells) 0) (empty)
      (do
        (let cell (head cells))
        (let realization (sn64-realize-sa runtime dictionary cell))
        (cons (list (sn64-c-address cell) (sn64-c-gate cell)
                (sndg-cr-surface realization) (sndg-cr-state realization))
          (sn64-sa-rows runtime dictionary (tail cells))))))

  ; ── reversible graph ────────────────────────────────────────────
  (defn sn64-projection-edges (cell projections position)
    (if (eq (len projections) 0) (empty)
      (cons (snsp-edge (sn64-c-address cell)
              (snsf-structure-address 14)
              (sn64-p-address (head projections)) position)
        (sn64-projection-edges cell (tail projections) (add position 1)))))
  (defn sn64-next-gate (gate)
    (if (eq gate (sn64-count)) 1 (add gate 1)))
  (defn sn64-cell-edges (runtime dictionary cell)
    (do
      (let gate (sn64-c-gate cell))
      (let surface (sn64-sa-surface runtime dictionary cell))
      (let projections (sn64-projections gate))
      (append
        (list
          (snsp-edge (sn64-c-address cell) (snsf-structure-address 10)
            (sndg-c-address (sn64-c-clause cell)) 0)
          (snsp-edge (sn64-c-address cell) (snsf-field-address 10)
            (sn64-cell-address (sn64-next-gate gate)) 0)
          (snsp-edge (sn64-lens-address 5 gate)
            (snsf-structure-address 14)
            (sn64-surface-address gate surface) 0))
        (sn64-projection-edges cell projections 0))))
  (defn sn64-graph-loop (runtime dictionary cells)
    (if (eq (len cells) 0) (empty)
      (append (sn64-cell-edges runtime dictionary (head cells))
        (sn64-graph-loop runtime dictionary (tail cells)))))
  (defn sn64-graph (runtime dictionary)
    (snsp-unique-edges
      (sn64-graph-loop runtime dictionary (sn64-cells))))

  ; ── structural observations used by the band ───────────────────
  (defn sn64-address-in? (address addresses)
    (if (eq (len addresses) 0) 0
      (if (value_eq address (head addresses)) 1
        (sn64-address-in? address (tail addresses)))))
  (defn sn64-all-cells-valid-loop? (cells seen)
    (if (eq (len cells) 0) 1
      (do
        (let cell (head cells))
        (if (and (eq (sndg-clause-valid? (sn64-c-clause cell)) 1)
                 (and (eq (len (sn64-c-vector cell)) 6)
                   (and (gt (sn64-c-rank cell) 0)
                     (eq (sn64-address-in? (sndg-c-address
                           (sn64-c-clause cell)) seen) 0))))
          (sn64-all-cells-valid-loop? (tail cells)
            (cons (sndg-c-address (sn64-c-clause cell)) seen)) 0))))
  (defn sn64-all-cells-valid? ()
    (sn64-all-cells-valid-loop? (sn64-cells) (empty)))
  (defn sn64-field-seen-loop? (id cells)
    (if (eq (len cells) 0) 0
      (if (eq (snmt-address-in? (snsf-field-address id)
                (sndg-c-symbols (sn64-c-clause (head cells)))) 1) 1
        (sn64-field-seen-loop? id (tail cells)))))
  (defn sn64-all-fields-seen-loop? (id cells)
    (if (ge id (fwf-axis-count)) 1
      (if (eq (sn64-field-seen-loop? id cells) 1)
        (sn64-all-fields-seen-loop? (add id 1) cells) 0)))
  (defn sn64-all-fields-seen? ()
    (sn64-all-fields-seen-loop? 0 (sn64-cells)))
  (defn sn64-ranks-not-flat-loop? (cells first-rank)
    (if (eq (len cells) 0) 0
      (if (not (eq (sn64-c-rank (head cells)) first-rank)) 1
        (sn64-ranks-not-flat-loop? (tail cells) first-rank))))
  (defn sn64-ranks-not-flat? ()
    (do
      (let cells (sn64-cells))
      (sn64-ranks-not-flat-loop? (tail cells) (sn64-c-rank (head cells)))))
  (defn sn64-max-rank-loop (cells maximum)
    (if (eq (len cells) 0) maximum
      (sn64-max-rank-loop (tail cells)
        (if (gt (sn64-c-rank (head cells)) maximum)
          (sn64-c-rank (head cells)) maximum))))
  (defn sn64-max-rank () (sn64-max-rank-loop (sn64-cells) 0))
  (defn sn64-count-rank (cells rank)
    (if (eq (len cells) 0) 0
      (add (if (eq (sn64-c-rank (head cells)) rank) 1 0)
        (sn64-count-rank (tail cells) rank))))
  (defn sn64-rank-distribution-loop (cells rank maximum)
    (if (gt rank maximum) (empty)
      (do
        (let count (sn64-count-rank cells rank))
        (if (eq count 0)
          (sn64-rank-distribution-loop cells (add rank 1) maximum)
          (cons (list rank count)
            (sn64-rank-distribution-loop cells (add rank 1) maximum))))))
  (defn sn64-rank-distribution ()
    (do
      (let cells (sn64-cells))
      (sn64-rank-distribution-loop cells 1
        (sn64-max-rank-loop cells 0))))

  0)
