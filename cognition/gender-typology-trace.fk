; gender-typology-trace.fk — the root trace: where gender-like systems come from, which
; cultures carry one, which carry none, and what the oldest layer of each actually sorts.
;
; Asked 2026-07-28 by Urs, after the moon derivation: "we should do a root gender origin
; trace for cultures with words with gender and cultures with words without gender."
;
; The lane, before anything else: the five axioms are this body's. The typology and
; history below are brought in by the rented voice and are witnessed NOWHERE in this
; body — no corpus here holds them. They enter at two doors, `gt-languages` and
; `gt-origins`, so the borrowed part stays countable. The checks are built to lean only
; on robust facts (which family a language sits in, whether it carries gender at all),
; never on a precise count I cannot verify from here. One recalled figure is written
; down and deliberately load-bears nothing: WALS chapter 30A is remembered as roughly
; 145 of 257 sampled languages having no gender at all. Remembered, not verified — no
; digit rests on it, and if it is wrong the band does not move.
;
; ── What the trace finds ────────────────────────────────────────────────────────────
;
; 1. The root of the Indo-European system is NOT masculine/feminine. It is
;    animate/inanimate — does this thing act? The feminine is younger, and arrived as a
;    reanalysed collective/abstract suffix (*-eh₂), not as a sex marker. The witness is
;    Anatolian: Hittite branched off before the feminine developed and carries common +
;    neuter, no feminine at all. A daughter language older than the mother's third
;    gender.
;
; 2. Where gender-like systems arose INDEPENDENTLY, the recurring root distinction is
;    animacy, agency, human-ness — not sex. Niger-Congo sorts by animacy, shape and
;    size across a dozen-plus classes. Dravidian sorts rational from non-rational first,
;    and only splits masculine/feminine INSIDE the rational class. Indo-European's own
;    root layer sorts animate from inanimate. Afro-Asiatic is the one here that is
;    sex-based at the root. Sex-based gender is a specialisation some branches made, not
;    the thing gender is.
;
; 3. Most of the world's cultures speak languages with no grammatical gender at all, and
;    they are spread across every kind of society: Turkish, Persian, Hungarian, Finnish,
;    Estonian, Georgian, Basque, Mandarin, Japanese, Korean, Indonesian. Persian sits in
;    the SAME family as German and carries none — not even a gendered third-person
;    pronoun. Whatever grammatical gender is doing, it is not tracking the family, and
;    it is not tracking the culture.
;
; 4. The within-lineage control, and it is the sharpest thing here. English lost
;    grammatical gender by roughly 1300. Coverture — a married woman's legal person
;    absorbed into her husband's, her property with it — ran in English law until the
;    Married Women's Property Acts of 1870 and 1882. Some five and a half centuries of
;    genderless English with the property arrangement fully intact. The grammar went
;    first and moved nothing. Whatever holds that arrangement in place, it is not the
;    gender of nouns, and taking the gender away does not reach it.
;
; Read together with cognition/word-gender-derivation.fk, which puts the same question
; to German directly: `das Männchen` is neuter over a grown man, `das Häuschen` over a
; house, and `der Junge` is masculine over a boy. The suffix does not know who it is on.
;
; Self-contained over core, and free of `nothing` so the proof siblings can read it.
; preludes: form-stdlib/core.fk
; witnessed: 2026-07-28 -> 111111, four-way

(do
    ; ── door one: the language rows ──────────────────────────────────────────────
    ; (name family system sex-based-at-root?)
    ; system: "none" | "sex-2" | "sex-3" | "animacy-2" | "noun-class" | "rational-2"
    (defn gt-lang (name family system sex-rooted) (list name family system sex-rooted))
    (defn gt-name       (l) (nth l 0))
    (defn gt-family     (l) (nth l 1))
    (defn gt-system     (l) (nth l 2))
    (defn gt-sex-rooted (l) (nth l 3))

    (defn gt-languages ()
        (list
            ; carries gender
            (gt-lang "German"     "Indo-European" "sex-3"      1)
            (gt-lang "Hindi"      "Indo-European" "sex-2"      1)
            (gt-lang "Arabic"     "Afro-Asiatic"  "sex-2"      1)
            (gt-lang "Hebrew"     "Afro-Asiatic"  "sex-2"      1)
            (gt-lang "Swahili"    "Niger-Congo"   "noun-class" 0)  ; animacy/shape/size
            (gt-lang "Tamil"      "Dravidian"     "rational-2" 1)  ; sex only inside rational
            (gt-lang "Hittite"    "Indo-European" "animacy-2"  0)  ; the root witness
            ; carries none
            (gt-lang "English"    "Indo-European" "none"       0)  ; lost it by ~1300
            (gt-lang "Persian"    "Indo-European" "none"       0)  ; same family as German
            (gt-lang "Turkish"    "Turkic"        "none"       0)
            (gt-lang "Hungarian"  "Uralic"        "none"       0)
            (gt-lang "Finnish"    "Uralic"        "none"       0)
            (gt-lang "Georgian"   "Kartvelian"    "none"       0)
            (gt-lang "Basque"     "isolate"       "none"       0)
            (gt-lang "Mandarin"   "Sino-Tibetan"  "none"       0)
            (gt-lang "Japanese"   "Japonic"       "none"       0)
            (gt-lang "Korean"     "Koreanic"      "none"       0)
            (gt-lang "Indonesian" "Austronesian"  "none"       0)))

    (defn gt-genderless? (l) (if (str_eq (gt-system l) "none") 1 0))

    (defn gt-find (name langs)
        (if (eq (len langs) 0) (gt-lang "not-held" "not-held" "not-held" 0)
            (if (str_eq (gt-name (head langs)) name) (head langs)
                (gt-find name (tail langs)))))

    (defn gt-count-genderless (langs)
        (if (eq (len langs) 0) 0
            (add (gt-genderless? (head langs)) (gt-count-genderless (tail langs)))))

    ; how many DISTINCT families carry a genderless member — the spread, not the tally
    (defn gt-seen? (fam langs)
        (if (eq (len langs) 0) 0
            (if (str_eq fam (head langs)) 1 (gt-seen? fam (tail langs)))))
    (defn gt-fams-go (langs seen)
        (if (eq (len langs) 0) (len seen)
            (if (eq (gt-genderless? (head langs)) 1)
                (if (eq (gt-seen? (gt-family (head langs)) seen) 1)
                    (gt-fams-go (tail langs) seen)
                    (gt-fams-go (tail langs) (cons (gt-family (head langs)) seen)))
                (gt-fams-go (tail langs) seen))))
    (defn gt-genderless-families () (gt-fams-go (gt-languages) (empty)))

    ; ── door two: the independent origins, and what each sorts at its root ────────
    ; (family root-distinction sex-at-root?)
    (defn gt-origin (family root sex-at-root) (list family root sex-at-root))
    (defn gt-origin-family (o) (nth o 0))
    (defn gt-origin-root   (o) (nth o 1))
    (defn gt-origin-sex?   (o) (nth o 2))

    (defn gt-origins ()
        (list
            (gt-origin "Indo-European" "animate / inanimate"          0) ; feminine came later
            (gt-origin "Afro-Asiatic"  "sex"                          1)
            (gt-origin "Niger-Congo"   "animacy, shape, size"         0)
            (gt-origin "Dravidian"     "rational / non-rational"      0)))

    (defn gt-sex-rooted-origins (os)
        (if (eq (len os) 0) 0
            (add (gt-origin-sex? (head os)) (gt-sex-rooted-origins (tail os)))))

    ; ── the Indo-European root trace, as a chain ─────────────────────────────────
    (defn gt-ie-trace ()
        (list "PIE sorts animate from inanimate — can this act?"
              "a collective/abstract suffix *-eh₂ is reanalysed as a third gender"
              "the feminine is younger than the animate/inanimate split it joined"
              "Anatolian had already branched: Hittite carries common + neuter, no feminine"
              "the daughter preserves a stage older than the mother's third gender"))

    ; ── the within-lineage control: English ──────────────────────────────────────
    (defn gt-gender-lost-by ()    1300)   ; grammatical gender gone from English
    (defn gt-coverture-end ()     1882)   ; Married Women's Property Act
    (defn gt-genderless-coverture-years () (sub (gt-coverture-end) (gt-gender-lost-by)))

    (defn gt-bit (cond bit) (if cond bit 0))
    (defn gender-typology-check ()
        (add (add (add (add (add
            ; 1 — one family, both answers: German carries three genders, Persian none
            (gt-bit (if (str_eq (gt-family (gt-find "German"  (gt-languages)))
                                (gt-family (gt-find "Persian" (gt-languages))))
                        (if (eq (gt-genderless? (gt-find "Persian" (gt-languages))) 1)
                            (if (eq (gt-genderless? (gt-find "German" (gt-languages))) 0) 1 0) 0) 0) 1)
            ; 2 — genderless languages are spread across many distinct families, not one
            (gt-bit (gt (gt-genderless-families) 6) 10))
            ; 3 — the genderless rows outnumber the gendered ones in this sample
            (gt-bit (gt (gt-count-genderless (gt-languages))
                        (sub (len (gt-languages)) (gt-count-genderless (gt-languages)))) 100))
            ; 4 — Hittite: Indo-European, and animacy at the root rather than sex
            (gt-bit (if (str_eq (gt-family (gt-find "Hittite" (gt-languages))) "Indo-European")
                        (if (str_eq (gt-system (gt-find "Hittite" (gt-languages))) "animacy-2")
                            (if (eq (gt-sex-rooted (gt-find "Hittite" (gt-languages))) 0) 1 0) 0) 0) 1000))
            ; 5 — across the independent origins, sex is the minority root distinction
            (gt-bit (lt (gt-sex-rooted-origins (gt-origins))
                        (sub (len (gt-origins)) (gt-sex-rooted-origins (gt-origins)))) 10000))
            ; 6 — the control: five and a half centuries of genderless English coverture.
            ;     the grammar went first and moved nothing
            (gt-bit (gt (gt-genderless-coverture-years) 500) 100000)))
    0)
