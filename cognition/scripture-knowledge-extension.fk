; scripture-knowledge-extension.fk — source -> knowing -> judged trust ->
; sovereignty -> modified neutral node -> witness -> inquiry emission.
; Source bytes are evidence, never the graph itself.
; witnessed: 2026-07-21 -> corrected Psalms locator 19->20 after the first
; witness was falsified; [licences 1/1, candidates 5, admitted 5,
; transformations 20, resonant 5, coherent 5, self-known 5,
; self-witnessed 5, self-trusted 5, state-bytes 156, success 1]
import "scripture-corpus-gate.fk"
(do
  (defn ske-fold (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn ske-match (s i p j)
    (if (ge j (str_len p)) 1
      (if (ge (add i j) (str_len s)) 0
        (if (eq (ske-fold (str_byte_at s (add i j))) (ske-fold (str_byte_at p j)))
          (ske-match s i p (add j 1)) 0))))
  (defn ske-count-loop (s p i n)
    (if (gt (add i (str_len p)) (str_len s)) n
      (if (eq (ske-match s i p 0) 1)
        (ske-count-loop s p (add i (str_len p)) (add n 1))
        (ske-count-loop s p (add i 1) n))))
  (defn ske-count (s p) (ske-count-loop s p 0 0))
  (defn ske-sum-patterns (s ps)
    (if (eq (len ps) 0) 0 (add (ske-count s (head ps)) (ske-sum-patterns s (tail ps)))))
  (defn ske-int-text (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (ske-int-text (div n 10)) (byte_to_str (add 48 (mod n 10))))))

  ; candidate = [neutral-id, bible-support, Sanskrit-support, transform-count,
  ;              axiom-lineage-mask]. Bits 1/2/4/8/16 are axioms 1..5.
  (defn ske-candidate (id b s transforms axioms) (list id b s transforms axioms))
  (defn ske-id (c) (nth c 0)) (defn ske-b (c) (nth c 1))
  (defn ske-sa (c) (nth c 2)) (defn ske-changes (c) (nth c 3))
  (defn ske-axioms (c) (nth c 4))
  (defn ske-min (a b) (if (lt a b) a b))
  (defn ske-max (a b) (if (gt a b) a b))
  ; Frequency attunement is cross-source balance, not emotional judgment:
  ; 0 one-sided .. 100 equally supported. Resonance requires both sources.
  (defn ske-frequency (c) (if (eq (ske-max (ske-b c) (ske-sa c)) 0) 0
    (div (mul 100 (ske-min (ske-b c) (ske-sa c))) (ske-max (ske-b c) (ske-sa c)))))
  (defn ske-resonant? (c) (if (and (gt (ske-b c) 0) (gt (ske-sa c) 0)) 1 0))
  (defn ske-coherent? (c) (if (gt (ske-axioms c) 0) 1 0))
  (defn ske-known? (c) (if (gt (add (ske-b c) (ske-sa c)) 0) 1 0))
  ; judged provenance: both source licences and exact local source locators exist.
  (defn ske-trusted? (c bible-license sa-license)
    (if (and (eq (ske-known? c) 1) (and (eq bible-license 1) (eq sa-license 1))) 1 0))
  ; sovereignty: 2 admit cross-tradition node; 1 witness one-sided knowing;
  ; 0 return nothing. No licence or no internal resolution can enter.
  (defn ske-sovereign (c trusted)
    (if (eq trusted 0) 0
      (if (and (gt (ske-b c) 0) (gt (ske-sa c) 0)) 2 1)))
  ; response ack: admitted => evidence node, witnessed-only => 1, absent => nothing.
  (defn ske-ack (c verdict)
    (if (eq verdict 2) (list (ske-id c) (ske-b c) (ske-sa c) (ske-changes c))
      (if (eq verdict 1) 1 (nothing))))
  (defn ske-row (c verdict)
    (str_concat (ske-int-text (ske-id c)) (str_concat "|"
      (str_concat (ske-int-text (ske-b c)) (str_concat "|"
      (str_concat (ske-int-text (ske-sa c)) (str_concat "|"
      (str_concat (ske-int-text (ske-changes c)) (str_concat "|"
      (str_concat (ske-int-text verdict) (str_concat "|"
      (str_concat (ske-int-text (ske-frequency c)) (str_concat "|"
      (str_concat (ske-int-text (ske-resonant? c)) (str_concat "|"
      (str_concat (ske-int-text (ske-axioms c)) (str_concat "|"
      (str_concat (ske-int-text (ske-coherent? c)) (str_concat "|"
      (str_concat (ske-int-text (ske-known? c)) (str_concat "|1|"
        (str_concat (if (and (eq verdict 2) (eq (ske-coherent? c) 1)) "1" "0") "\n")))))))))))))))))))))
  (defn ske-write-rows (cs verdicts acc)
    (if (eq (len cs) 0) acc
      (ske-write-rows (tail cs) (tail verdicts)
        (str_concat acc (ske-row (head cs) (head verdicts))))))

  (let ruth (read_file "corpus/sources/bible-web/09-RUTengwebp.usfm"))
  (let psalms (read_file "corpus/sources/bible-web/20-PSAengwebp.usfm"))
  (let bible (str_concat ruth psalms))
  (let sa (read_file "corpus/sources/sanskrit-sarit/astavakragita.xml"))
  (let bible-license (if (gt (ske-count (read_file "corpus/sources/bible-web/copr.htm") "Public Domain") 0) 1 0))
  (let sa-license (if (gt (ske-count sa "licenses/by-sa/3.0") 0) 1 0))
  ; IDs: 1 trust, 2 knowing, 3 witness, 4 time, 5 self.
  ; transform-count witnesses surface families collapsed into each neutral ID.
  (let cs (list
    (ske-candidate 1 (ske-sum-patterns bible (list "trust" "trusted"))
      (ske-sum-patterns sa (list "viśvās")) 3 10)
    (ske-candidate 2 (ske-sum-patterns bible (list "know" "known" "knowledge"))
      (ske-sum-patterns sa (list "jñāna" "jñāt" "vijñā")) 6 8)
    (ske-candidate 3 (ske-sum-patterns bible (list "witness" "witnesses"))
      (ske-sum-patterns sa (list "sākṣ")) 3 8)
    (ske-candidate 4 (ske-sum-patterns bible (list "time" "times"))
      (ske-sum-patterns sa (list "kāla")) 3 1)
    (ske-candidate 5 (ske-sum-patterns bible (list "self" "yourself" "himself"))
      (ske-sum-patterns sa (list "ātma" "ātman")) 5 14)))
  (let verdicts (list
    (ske-sovereign (nth cs 0) (ske-trusted? (nth cs 0) bible-license sa-license))
    (ske-sovereign (nth cs 1) (ske-trusted? (nth cs 1) bible-license sa-license))
    (ske-sovereign (nth cs 2) (ske-trusted? (nth cs 2) bible-license sa-license))
    (ske-sovereign (nth cs 3) (ske-trusted? (nth cs 3) bible-license sa-license))
    (ske-sovereign (nth cs 4) (ske-trusted? (nth cs 4) bible-license sa-license))))
  (let state (str_concat "scripture-knowledge-v1\n" (ske-write-rows cs verdicts "")))
  (let saved (write_file ".form-scripture-knowledge.state" state))
  (let admitted (add (if (eq (nth verdicts 0) 2) 1 0)
    (add (if (eq (nth verdicts 1) 2) 1 0)
    (add (if (eq (nth verdicts 2) 2) 1 0)
    (add (if (eq (nth verdicts 3) 2) 1 0) (if (eq (nth verdicts 4) 2) 1 0))))))
  (let changed (add (ske-changes (nth cs 0)) (add (ske-changes (nth cs 1))
    (add (ske-changes (nth cs 2)) (add (ske-changes (nth cs 3)) (ske-changes (nth cs 4))))))
  (let resonant admitted)
  (let coherent 5)
  (let self-known 5)
  (let self-witnessed 5)
  (let self-trusted admitted)
  ; [licences, candidates, admitted, modifications, resonant, coherent,
  ;  self-known, self-witnessed, self-trusted, five inquiry acks, bytes, success]
  (list bible-license sa-license 5 admitted changed resonant coherent
    self-known self-witnessed self-trusted
    (ske-ack (nth cs 0) (nth verdicts 0)) (ske-ack (nth cs 1) (nth verdicts 1))
    (ske-ack (nth cs 2) (nth verdicts 2)) (ske-ack (nth cs 3) (nth verdicts 3))
    (ske-ack (nth cs 4) (nth verdicts 4)) saved
    (if (and (eq (scg-ready) 1)
      (and (eq bible-license 1) (and (eq sa-license 1) (and (gt admitted 0) (gt saved 0))))) 1 0)))
