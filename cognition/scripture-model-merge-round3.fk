; scripture-model-merge-round3.fk — merge three witnessed parent layers into
; a new model state; tension remains tension, interpretation remains derived.
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [3, 5, 1, 4, 225, 17524803, 103, 1, 1]
(do
  (defn smr-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (smr-match s i p (add j 1)) 0))))
  (defn smr-count-loop (s p i n) (if (gt (add i (str_len p)) (str_len s)) n
    (if (eq (smr-match s i p 0) 1)
      (smr-count-loop s p (add i (str_len p)) (add n 1))
      (smr-count-loop s p (add i 1) n))))
  (defn smr-count (s p) (smr-count-loop s p 0 0))
  (defn smr-find-loop (s p i) (if (gt (add i (str_len p)) (str_len s)) -1
    (if (eq (smr-match s i p 0) 1) i (smr-find-loop s p (add i 1)))))
  (defn smr-read-int (s i acc) (if (ge i (str_len s)) acc
    (do (let b (str_byte_at s i))
      (if (and (ge b 48) (le b 57)) (smr-read-int s (add i 1) (add (mul acc 10) (sub b 48))) acc))))
  (defn smr-after-int (s p)
    (do (let i (smr-find-loop s p 0))
      (if (lt i 0) -1 (smr-read-int s (add i (str_len p)) 0))))
  ; Every parent byte participates. Keep the accumulator bounded without the
  ; multiplicative recurrence that currently stalls the direct-source walker.
  (defn smr-hash-loop (s i h) (if (ge i (str_len s)) h
    (smr-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn smr-hash (s) (smr-hash-loop s 0 0))
  (defn smr-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (smr-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (let p1 (read_file ".form-scripture-knowledge.state"))
  (let p2 (read_file ".form-scripture-evidence-v2.state"))
  (let p3 (read_file ".form-scripture-transmutation.state"))
  (let parents-present (if (and (gt (str_len p1) 0) (and (gt (str_len p2) 0) (gt (str_len p3) 0))) 1 0))
  (let tensions (smr-count p2 "|3\n"))
  (let body (smr-count p2 "|1\n"))
  (let transformations (smr-after-int p3 "sovereignty-gain="))
  (let merged-hash (smr-hash (str_concat p1 (str_concat p2 p3))))
  (let state0 (str_concat "scripture-model-v3\nparents=3\nnodes=5\nbody=" (smr-int body)))
  (let state1 (str_concat state0 (str_concat "\ntension=" (smr-int tensions))))
  (let state2 (str_concat state1 (str_concat "\ninterpretations=" (smr-int transformations))))
  (let state (str_concat state2 (str_concat "\nparent-content-hash=" (str_concat (smr-int merged-hash) "\n"))))
  (let saved (write_file ".form-scripture-model-v3.state" state))
  (let reread (read_file ".form-scripture-model-v3.state"))
  (let identity (if (eq (smr-hash state) (smr-hash reread)) 1 0))
  (let counts-valid (if (eq (add body tensions) 5) 1 0))
  (let interpretations-valid (if (gt transformations 0) 1 0))
  (let storage-valid (if (gt saved 0) 1 0))
  (let success (if (eq parents-present 1)
    (if (eq counts-valid 1)
      (if (eq interpretations-valid 1)
        (if (eq storage-valid 1) identity 0) 0) 0) 0))
  ; [parents, nodes, body, tension, interpretations, parent hash,
  ;  bytes saved, read-back identity, success]
  (list 3 5 body tensions transformations merged-hash saved identity success))
