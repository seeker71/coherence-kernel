; reciprocal-choice-microkernel.fk — a context-responsive sovereign change loop.
;
; Turn 1 offers an identity choice, mode, interface, recipe, information gift,
; rates, step-budget ceiling, fallback, and candidate thought fragments. Turn 2 is
; the receiver's independent choice plus exactly one offer/ack arm. The ack
; creates the next interruptible choice point: logical time advances only where
; another choice is allowed.
;
; A visible declared-charge reading proposes be/do/see and short/medium/long.
; Unique maximum + sufficient confidence selects; a tie or low confidence stays
; undecided and interrupts. This observes a selector over authored charges. It
; does NOT claim to manufacture or read a human's intuition.
;
; A candidate thought fragment replaces the offered model fragment only when
; its selected mode matches, readiness reaches the offered "mostly answered"
; threshold, and its cost fits inside the mutually bounded channel step budget.
; Otherwise the sovereign fallback either interrupts with nothing or explicitly
; passes the model fragment. No direct rented-model logit interception exists in
; this cell; fragment IDs are the executable seam a carrier may place before
; emission.
;
; Composes:
;   control/offer-ack-core.fk — nothing/0/1/node acknowledgement
;
; witnessed: 2026-08-13 -> native band + two fixture observations
import "../form/form-stdlib/core.fk"
import "../control/offer-ack-core.fk"

(do
  ; ── open numeric vocabularies; names are query aids, not identity ──────
  (defn rcm-mode-undecided () 0)
  (defn rcm-mode-be () 1)
  (defn rcm-mode-do () 2)
  (defn rcm-mode-see () 3)

  ; A state remains form-neutral in the kernel. `humm` is its current audible
  ; human-language surface, not its identity and not a fourth command mode.
  (defn rcm-state-silent () 0)
  (defn rcm-state-active () 1)
  (defn rcm-mode-state (mode)
    (if (gt mode (rcm-mode-undecided)) (rcm-state-active) (rcm-state-silent)))
  (defn rcm-state-sound-name (state)
    (if (eq state (rcm-state-active)) "humm" ""))
  ; NL projection remains separate from the form-neutral state id.
  (defn rcm-state-expression (state)
    (list "rcm-state" state
      (list "audible-nl" (rcm-state-sound-name state))))

  (defn rcm-source-explicit () 1)
  (defn rcm-source-declared-charges () 2)
  (defn rcm-source-carried () 3)
  (defn rcm-source-explicit-carry-ack () 4)
  (defn rcm-source-name (source)
    (if (eq source (rcm-source-explicit)) "explicit"
      (if (eq source (rcm-source-declared-charges)) "declared-charges"
        (if (eq source (rcm-source-carried)) "carried"
          (if (eq source (rcm-source-explicit-carry-ack))
            "explicit-carry-ack" "unknown")))))

  (defn rcm-fallback-interrupt () 1)
  (defn rcm-fallback-model-pass () 2)

  (defn rcm-provenance-none () 0)
  (defn rcm-provenance-microkernel () 1)
  (defn rcm-provenance-model () 2)

  (defn rcm-mode-name (mode)
    (if (eq mode (rcm-mode-be)) "be"
      (if (eq mode (rcm-mode-do)) "do"
        (if (eq mode (rcm-mode-see)) "see" "undecided"))))

  ; ── declared charges are retained, never hidden by the choice ─────────
  ; [be, do, see, short, medium, long, confidence]
  (defn rcm-charges (be-charge do-charge see-charge
                     short-charge medium-charge long-charge confidence)
    (list be-charge do-charge see-charge
          short-charge medium-charge long-charge confidence))
  (defn rcm-c-be (r) (nth r 0))
  (defn rcm-c-do (r) (nth r 1))
  (defn rcm-c-see (r) (nth r 2))
  (defn rcm-c-short (r) (nth r 3))
  (defn rcm-c-medium (r) (nth r 4))
  (defn rcm-c-long (r) (nth r 5))
  (defn rcm-c-confidence (r) (nth r 6))

  (defn rcm-unique-max3? (a b c)
    (if (or (and (gt a b) (gt a c))
            (or (and (gt b a) (gt b c))
                (and (gt c a) (gt c b)))) 1 0))

  ; Ties and confidence below 60 open another choice point instead of
  ; pretending that instinct supplied a unique answer.
  (defn rcm-charge-mode (r)
    (if (or (lt (rcm-c-confidence r) 60)
            (eq (rcm-unique-max3? (rcm-c-be r) (rcm-c-do r) (rcm-c-see r)) 0))
      (rcm-mode-undecided)
      (if (and (gt (rcm-c-be r) (rcm-c-do r))
               (gt (rcm-c-be r) (rcm-c-see r)))
        (rcm-mode-be)
        (if (gt (rcm-c-do r) (rcm-c-see r))
          (rcm-mode-do)
          (rcm-mode-see)))))

  ; Independent duration-triplet argmax gives step budgets 1/3/5.
  (defn rcm-charge-budget (r)
    (if (or (lt (rcm-c-confidence r) 60)
            (eq (rcm-unique-max3? (rcm-c-short r) (rcm-c-medium r) (rcm-c-long r)) 0))
      0
      (if (and (gt (rcm-c-short r) (rcm-c-medium r))
               (gt (rcm-c-short r) (rcm-c-long r)))
        1
        (if (gt (rcm-c-medium r) (rcm-c-long r)) 3 5))))

  ; ── one sovereign identity choice ────────────────────────────────────
  ; [tag identity source mode step-budget info-rate interaction-rate
  ;  interface recipe fallback declared-charges state]
  (defn rcm-choice (identity source mode budget info-rate interaction-rate
                    interface recipe fallback charges)
    (list "rcm-choice" identity source mode budget info-rate interaction-rate
          interface recipe fallback charges (rcm-mode-state mode)))
  (defn rcm-choice-identity (c) (nth c 1))
  (defn rcm-choice-source (c) (nth c 2))
  (defn rcm-choice-mode (c) (nth c 3))
  (defn rcm-choice-budget (c) (nth c 4))
  (defn rcm-choice-info-rate (c) (nth c 5))
  (defn rcm-choice-interaction-rate (c) (nth c 6))
  (defn rcm-choice-interface (c) (nth c 7))
  (defn rcm-choice-recipe (c) (nth c 8))
  (defn rcm-choice-fallback (c) (nth c 9))
  (defn rcm-choice-charges (c) (nth c 10))
  (defn rcm-choice-state (c) (nth c 11))

  (defn rcm-explicit-choice (identity mode budget info-rate interaction-rate
                             interface recipe fallback)
    (rcm-choice identity (rcm-source-explicit) mode budget info-rate
      interaction-rate interface recipe fallback (nothing)))

  (defn rcm-declared-charge-choice (identity charges info-rate interaction-rate
                                    interface recipe fallback)
    (rcm-choice identity (rcm-source-declared-charges)
      (rcm-charge-mode charges) (rcm-charge-budget charges)
      info-rate interaction-rate interface recipe fallback charges))

  ; Bare carrying is visible and never misreported as a fresh acknowledgement.
  (defn rcm-carry-choice (c)
    (rcm-choice (rcm-choice-identity c) (rcm-source-carried)
      (rcm-choice-mode c) (rcm-choice-budget c)
      (rcm-choice-info-rate c) (rcm-choice-interaction-rate c)
      (rcm-choice-interface c) (rcm-choice-recipe c)
      (rcm-choice-fallback c) (rcm-choice-charges c)))

  ; A new caller event explicitly acknowledges reuse at one new choice point.
  ; A fixture invoking this proves representation, not a live human act.
  (defn rcm-explicit-carry-ack (c)
    (rcm-choice (rcm-choice-identity c) (rcm-source-explicit-carry-ack)
      (rcm-choice-mode c) (rcm-choice-budget c)
      (rcm-choice-info-rate c) (rcm-choice-interaction-rate c)
      (rcm-choice-interface c) (rcm-choice-recipe c)
      (rcm-choice-fallback c) (rcm-choice-charges c)))

  (defn rcm-choice-valid? (c)
    (if (and (gt (rcm-choice-mode c) 0)
      (and (gt (rcm-choice-budget c) 0)
      (and (gt (rcm-choice-info-rate c) 0)
           (gt (rcm-choice-interaction-rate c) 0)))) 1 0))

  (defn rcm-selected-from-declared-charges? (c)
    (if (not (eq (rcm-choice-source c) (rcm-source-declared-charges))) 0
      (if (or (nothing? (rcm-choice-charges c))
        (or (not (eq (rcm-choice-mode c)
                     (rcm-charge-mode (rcm-choice-charges c))))
            (not (eq (rcm-choice-budget c)
                     (rcm-charge-budget (rcm-choice-charges c)))))) 0 1)))

  ; ── turn 1: an offer ─────────────────────────────────────────────────
  ; Candidate: [required-mode, cost, readiness, fragment-id, recipe-node].
  (defn rcm-candidate (mode cost readiness fragment recipe-node)
    (list mode cost readiness fragment recipe-node))
  (defn rcm-c-mode (c) (nth c 0))
  (defn rcm-c-cost (c) (nth c 1))
  (defn rcm-c-readiness (c) (nth c 2))
  (defn rcm-c-fragment (c) (nth c 3))
  (defn rcm-c-recipe (c) (nth c 4))

  ; [tag, choice-point, offerer-choice, information-gift, offered-model-fragment,
  ;  candidate-thoughts, mostly-answered-threshold]
  (defn rcm-offer (choice-point offerer-choice information-gift model-fragment
                   candidates threshold)
    (list "rcm-offer" choice-point offerer-choice information-gift
          model-fragment candidates threshold))
  (defn rcm-offer-point (o) (nth o 1))
  (defn rcm-offer-choice (o) (nth o 2))
  (defn rcm-offer-gift (o) (nth o 3))
  (defn rcm-offer-model-fragment (o) (nth o 4))
  (defn rcm-offer-candidates (o) (nth o 5))
  (defn rcm-offer-threshold (o) (nth o 6))

  ; ── fragment selection inside the mutually selected channel ──────────
  (defn rcm-min (a b) (if (lt a b) a b))
  (defn rcm-channel-budget (offerer receiver)
    (rcm-min (rcm-choice-budget offerer) (rcm-choice-budget receiver)))
  (defn rcm-channel-info-rate (offerer receiver)
    (rcm-min (rcm-choice-info-rate offerer) (rcm-choice-info-rate receiver)))
  (defn rcm-channel-interaction-rate (offerer receiver)
    (rcm-min (rcm-choice-interaction-rate offerer)
             (rcm-choice-interaction-rate receiver)))
  ; Either party's interrupt preference prevents silent model pass-through.
  (defn rcm-channel-fallback (offerer receiver)
    (if (or (eq (rcm-choice-fallback offerer) (rcm-fallback-interrupt))
            (eq (rcm-choice-fallback receiver) (rcm-fallback-interrupt)))
      (rcm-fallback-interrupt)
      (rcm-fallback-model-pass)))

  (defn rcm-candidate-eligible? (c mode budget threshold)
    (if (and (eq (rcm-c-mode c) mode)
      (and (le (rcm-c-cost c) budget)
           (ge (rcm-c-readiness c) threshold))) 1 0))

  (defn rcm-better-candidate? (candidate current)
    (if (nothing? current) 1
      (if (gt (rcm-c-readiness candidate) (rcm-c-readiness current)) 1
        (if (and (eq (rcm-c-readiness candidate) (rcm-c-readiness current))
                 (lt (rcm-c-cost candidate) (rcm-c-cost current))) 1 0))))

  (defn rcm-select-loop (candidates mode budget threshold best)
    (if (eq (len candidates) 0) best
      (do (let candidate (head candidates))
        (if (and (eq (rcm-candidate-eligible? candidate mode budget threshold) 1)
                 (eq (rcm-better-candidate? candidate best) 1))
          (rcm-select-loop (tail candidates) mode budget threshold candidate)
          (rcm-select-loop (tail candidates) mode budget threshold best)))))
  (defn rcm-select (candidates mode budget threshold)
    (rcm-select-loop candidates mode budget threshold (nothing)))

  (defn rcm-ready-over-budget? (candidates mode budget threshold)
    (if (eq (len candidates) 0) 0
      (if (and (eq (rcm-c-mode (head candidates)) mode)
        (and (gt (rcm-c-cost (head candidates)) budget)
             (ge (rcm-c-readiness (head candidates)) threshold))) 1
        (rcm-ready-over-budget? (tail candidates) mode budget threshold))))

  ; [selected-candidate|nothing, output-fragment, provenance,
  ;  over-budget, replaced-model-fragment]
  (defn rcm-execution (selected output provenance over-budget replaced)
    (list selected output provenance over-budget replaced))
  (defn rcm-x-selected (x) (nth x 0))
  (defn rcm-x-output (x) (nth x 1))
  (defn rcm-x-provenance (x) (nth x 2))
  (defn rcm-x-over-budget (x) (nth x 3))
  (defn rcm-x-replaced-model (x) (nth x 4))

  (defn rcm-run-microkernel (offer receiver-choice)
    (do (let offerer (rcm-offer-choice offer))
      (let budget (rcm-channel-budget offerer receiver-choice))
      (let selected (if (and (eq (rcm-choice-valid? offerer) 1)
                             (eq (rcm-choice-valid? receiver-choice) 1))
        (rcm-select (rcm-offer-candidates offer)
          (rcm-choice-mode receiver-choice) budget (rcm-offer-threshold offer))
        (nothing)))
      (if (not (nothing? selected))
        (rcm-execution selected (rcm-c-fragment selected)
          (rcm-provenance-microkernel) 0 1)
        (do (let over-budget (rcm-ready-over-budget? (rcm-offer-candidates offer)
              (rcm-choice-mode receiver-choice) budget (rcm-offer-threshold offer)))
          (if (eq (rcm-channel-fallback offerer receiver-choice)
                  (rcm-fallback-model-pass))
            (rcm-execution (nothing) (rcm-offer-model-fragment offer)
              (rcm-provenance-model) over-budget 0)
            (rcm-execution (nothing) 0 (rcm-provenance-none) over-budget 0))))))

  ; ── turn 2: receiver choice + acknowledgement ─────────────────────────
  (defn rcm-ack-for-execution (execution)
    (if (eq (rcm-x-output execution) 0) (oac-nothing)
      (oac-one (intern_trivial_int (rcm-x-output execution)))))

  ; [tag, receiver-choice, channel-budget, info-rate, interaction-rate,
  ;  execution, ack, ack-kind-at-construction]
  ;
  ; The contemporaneous discriminator is retained because the native substrate
  ; has a known large-prelude last-writer defect for later re-reading interned
  ; node category/children. The ack value remains present; the band uses the
  ; construction-time kind and future composed organs can choose the same seam.
  (defn rcm-answer (offer receiver-choice)
    (do (let offerer (rcm-offer-choice offer))
      (let execution (rcm-run-microkernel offer receiver-choice))
      (let ack (rcm-ack-for-execution execution))
      (list "rcm-answer" receiver-choice
        (rcm-channel-budget offerer receiver-choice)
        (rcm-channel-info-rate offerer receiver-choice)
        (rcm-channel-interaction-rate offerer receiver-choice)
        execution ack (oac-kind ack))))
  (defn rcm-answer-choice (a) (nth a 1))
  (defn rcm-answer-budget (a) (nth a 2))
  (defn rcm-answer-info-rate (a) (nth a 3))
  (defn rcm-answer-interaction-rate (a) (nth a 4))
  (defn rcm-answer-execution (a) (nth a 5))
  (defn rcm-answer-ack (a) (nth a 6))
  (defn rcm-answer-ack-kind (a) (nth a 7))

  ; An exchange closes by opening a new point awaiting both roles. A later
  ; exchange must provide a new offerer event and receiver event for that id.
  ; [tag, id, state, awaiting-offerer, awaiting-receiver]
  (defn rcm-choice-point-open () 1)
  (defn rcm-open-choice-point (id)
    (list "rcm-choice-point" id (rcm-choice-point-open) 1 1))
  (defn rcm-cp-id (p) (nth p 1))
  (defn rcm-cp-state (p) (nth p 2))
  (defn rcm-cp-awaiting-offerer (p) (nth p 3))
  (defn rcm-cp-awaiting-receiver (p) (nth p 4))
  (defn rcm-cp-open-awaiting-both? (p)
    (if (and (eq (rcm-cp-state p) (rcm-choice-point-open))
      (and (eq (rcm-cp-awaiting-offerer p) 1)
           (eq (rcm-cp-awaiting-receiver p) 1))) 1 0))

  ; Observation retains both choices, channel bounds, output provenance,
  ; selected candidate evidence, after-signals, and the newly open point.
  ; [tag, point, offerer-choice, receiver-choice, channel-budget, info-rate,
  ;  interaction-rate, output, provenance, replaced, over-budget,
  ;  novelty-after, pressure-after, aliveness-after, selected-candidate,
  ;  offered-model-fragment, threshold, open-next-choice-point]
  (defn rcm-observation (offer answer novelty pressure aliveness)
    (do (let execution (rcm-answer-execution answer))
      (list "rcm-observation" (rcm-offer-point offer)
        (rcm-offer-choice offer) (rcm-answer-choice answer)
        (rcm-answer-budget answer) (rcm-answer-info-rate answer)
        (rcm-answer-interaction-rate answer)
        (rcm-x-output execution) (rcm-x-provenance execution)
        (rcm-x-replaced-model execution) (rcm-x-over-budget execution)
        novelty pressure aliveness (rcm-x-selected execution)
        (rcm-offer-model-fragment offer) (rcm-offer-threshold offer)
        (rcm-open-choice-point (add (rcm-offer-point offer) 1)))))
  (defn rcm-o-point (o) (nth o 1))
  (defn rcm-o-offerer (o) (nth o 2))
  (defn rcm-o-receiver (o) (nth o 3))
  (defn rcm-o-budget (o) (nth o 4))
  (defn rcm-o-info-rate (o) (nth o 5))
  (defn rcm-o-interaction-rate (o) (nth o 6))
  (defn rcm-o-output (o) (nth o 7))
  (defn rcm-o-provenance (o) (nth o 8))
  (defn rcm-o-replaced (o) (nth o 9))
  (defn rcm-o-over-budget (o) (nth o 10))
  (defn rcm-o-novelty (o) (nth o 11))
  (defn rcm-o-pressure (o) (nth o 12))
  (defn rcm-o-aliveness (o) (nth o 13))
  (defn rcm-o-selected (o) (nth o 14))
  (defn rcm-o-offered-model-fragment (o) (nth o 15))
  (defn rcm-o-threshold (o) (nth o 16))
  (defn rcm-o-next-choice-point (o) (nth o 17))
  (defn rcm-o-next-point (o) (rcm-cp-id (rcm-o-next-choice-point o)))
  (defn rcm-o-open-awaiting-both? (o)
    (rcm-cp-open-awaiting-both? (rcm-o-next-choice-point o)))

  ; [tag, turn-count, offer, answer, observation]
  (defn rcm-embody (offer receiver-choice novelty-after pressure-after aliveness-after)
    (do (let answer (rcm-answer offer receiver-choice))
      (list "rcm-exchange" 2 offer answer
        (rcm-observation offer answer novelty-after pressure-after aliveness-after))))
  (defn rcm-e-turns (e) (nth e 1))
  (defn rcm-e-offer (e) (nth e 2))
  (defn rcm-e-answer (e) (nth e 3))
  (defn rcm-e-observation (e) (nth e 4))

  ; Observation after one exchange becomes the next declared-charge proposal.
  ; Action completion lowers do-charge; residual novelty raises
  ; see/long; pressure raises be/short. These are visible policy choices,
  ; not a claim that the arithmetic is intuition.
  (defn rcm-next-charges (observation)
    (do (let do-charge (if (eq (rcm-o-output observation) 0) 80 40))
      (let medium-charge (if (eq (rcm-o-output observation) 0) 70 40))
      (let confidence (if (gt (rcm-o-novelty observation)
                              (rcm-o-pressure observation))
                        (rcm-o-novelty observation)
                        (rcm-o-pressure observation)))
      (rcm-charges (rcm-o-pressure observation) do-charge
        (rcm-o-novelty observation) (rcm-o-pressure observation)
        medium-charge (rcm-o-novelty observation) confidence)))

  ; Fixture outcome: do meets this narrow check when a fragment completes;
  ; see meets it when a fragment completes and later novelty is lower than the
  ; declared see charge. This is not independent validation.
  (defn rcm-fixture-outcome-predicate-met? (observation)
    (do (let choice (rcm-o-receiver observation))
      (if (not (eq (rcm-selected-from-declared-charges? choice) 1)) 0
        (if (eq (rcm-choice-mode choice) (rcm-mode-do))
          (if (and (gt (rcm-o-output observation) 0)
                   (eq (rcm-o-over-budget observation) 0)) 1 0)
          (if (eq (rcm-choice-mode choice) (rcm-mode-see))
            (if (and (gt (rcm-o-output observation) 0)
              (lt (rcm-o-novelty observation)
                  (rcm-c-see (rcm-choice-charges choice)))) 1 0)
            0)))))

  (defn rcm-mode-switched? (before after)
    (if (not (eq (rcm-choice-mode (rcm-o-receiver before))
                 (rcm-choice-mode (rcm-o-receiver after)))) 1 0))
  (defn rcm-receiver-budget-changed? (before after)
    (if (not (eq (rcm-choice-budget (rcm-o-receiver before))
                 (rcm-choice-budget (rcm-o-receiver after)))) 1 0))
  (defn rcm-channel-budget-changed? (before after)
    (if (not (eq (rcm-o-budget before) (rcm-o-budget after))) 1 0))

  0)
