// text-frequency.fk — spectrum arithmetic over supplied (valence, intensity) rows.
// The caller provides the annotations and their contextual meaning. tf-spectrum
// computes their intensity-weighted mean; tf-fearfrac returns the fraction of
// rows whose valence is negative.
// The functions below accept numeric lists. A raw-text caller needs its own
// word/sense lookup and contextual annotation before offering those lists.
// Keep the annotation source beside the result: the number describes the supplied
// values. A person's felt resonance remains a separate observation in dialogue.
//
// Self-contained over core (FLOAT spectrum). Proof: pending (no band reads this cell in this tree).
//
import form-stdlib/core.fk;
section [form.bml] {
    def tf-val(w) = w[0];
    // supplied valence annotation
    def tf-int(w) = w[1:][0];
    // supplied intensity annotation
    def tf-wsum(p) = (Comparable) len(p) == 0 ? 0 : (Number) (tf-val(p[0]) * tf-int(p[0])) + (Number) tf-wsum(p[1:]);
    def tf-isum(p) = (Comparable) len(p) == 0 ? 0 : (Number) tf-int(p[0]) + (Number) tf-isum(p[1:]);
    def tf-spectrum(p) = 1.0 * tf-wsum(p) / (1.0 * tf-isum(p));
    // intensity-weighted mean valence
    def tf-fearword?(w) = tf-val(w) < 0 ? 1 : 0;
    def tf-fearcount(p) = (Comparable) len(p) == 0 ? 0 : (Number) tf-fearword?(p[0]) + (Number) tf-fearcount(p[1:]);
    def tf-fearfrac(p) = 1.0 * tf-fearcount(p) / (1.0 * len(p));
    // fraction in the contracted band
    def tf-open() = [[8, 2], [9, 3], [7, 1]];
    // sample positive annotations
    def tf-wrath() = [[8, 1], [-9, 3], [-7, 2]];
    // sample mixed annotations
    def tfk(cond, bit) = cond ? bit : 0;
    def text-frequency-check() = (Number) ((Number) ((Number) ((Number) tfk(tf-spectrum(tf-open()) > 0.0, 1) + (Number)     // positive weighted mean
tfk(tf-spectrum(tf-wrath()) < 0.0, 10)) + (Number)     // negative weighted mean
tfk((Comparable) tf-fearfrac(tf-open()) == 0.0, 100)) + (Number)     // zero negative annotations
tfk(tf-fearfrac(tf-wrath()) > tf-fearfrac(tf-open()), 1000)) + (Number)     // a greater fraction of negative annotations
tfk(tf-spectrum(tf-open()) > tf-spectrum(tf-wrath()), 10000);
}
