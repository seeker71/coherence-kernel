; native-trust-trinity-inquiry.fk — semantic inquiry over typed neutral edges.
;
; Concept IDs and relation IDs are the model. English is an input/output
; projection only. No answer row is stored: a generic requirement walk derives
; the verdict, and clause composition emits the response selected by that proof.
;
; concepts: 1 trust, 2 trinity, 3 knowable, 4 currently-valid-knowing,
;   5 time, 6 freshness, 7 observation, 8 cell, 9 boundary,
;   10 present-composition, 11 structure, 12 proven-belief.
; relations: 1 requires, 2 grounded-by, 3 derived-from, 4 distinguishes.
; witnessed: 2026-07-21 -> completed NO ack 0; temporal YES ack evidence
;   node [4,6,5]; unresolved ack nothing/reason 1; timeout ack the same
;   nothing/reason 2; final success 1.

(do
  (defn nti-edge (s r t source) (list s r t source))
  (defn nti-s (e) (nth e 0))
  (defn nti-r (e) (nth e 1))
  (defn nti-t (e) (nth e 2))
  (defn nti-source (e) (nth e 3))

  ; source 1=core-axioms, 2=belief-freshness. These are semantic projections
  ; of executable body claims, not natural-language answer templates.
  (defn nti-edges ()
    (list
      (nti-edge 1 2 8 1)   ; trust grounded by cell (axiom 2)
      (nti-edge 1 2 9 1)   ; trust grounded by sovereign boundary (axiom 4)
      (nti-edge 2 3 8 1)   ; trinity derives from cell
      (nti-edge 2 3 10 1)  ; and present composition (axiom 3)
      (nti-edge 3 1 11 1)  ; knowability requires a structure
      (nti-edge 4 1 12 2)  ; currently-valid knowing requires proven belief
      (nti-edge 4 1 7 2)   ; and observation
      (nti-edge 4 1 6 2)   ; and freshness
      (nti-edge 6 1 5 2)   ; freshness requires time/stamp ordering
      (nti-edge 3 4 4 2))) ; knowable is distinct from currently-valid knowing

  (defn nti-member? (x xs)
    (if (eq (len xs) 0) 0
      (if (eq x (head xs)) 1 (nti-member? x (tail xs)))))
  (defn nti-direct? (edges s r t)
    (if (eq (len edges) 0) 0
      (if (and (eq (nti-s (head edges)) s)
               (and (eq (nti-r (head edges)) r) (eq (nti-t (head edges)) t))) 1
        (nti-direct? (tail edges) s r t))))
  (defn nti-requires-walk (all edges s target seen)
    (if (eq (len edges) 0) 0
      (do (let e (head edges))
        (if (and (eq (nti-s e) s) (eq (nti-r e) 1))
          (if (eq (nti-t e) target) 1
            (if (eq (nti-member? (nti-t e) seen) 1)
              (nti-requires-walk all (tail edges) s target seen)
              (if (eq (nti-requires-walk all all (nti-t e) target (cons (nti-t e) seen)) 1) 1
                (nti-requires-walk all (tail edges) s target seen))))
          (nti-requires-walk all (tail edges) s target seen)))))
  (defn nti-requires? (s t)
    (nti-requires-walk (nti-edges) (nti-edges) s t (list s)))

  ; Embodied proof receipt: [ack, reason, evidence-path, visited-steps].
  ; ack is the actual kernel range: nothing, 0, 1, or an evidence node.
  ; reason: 0 completed, 1 unresolved concept, 2 timeout (timeout IS nothing).
  (defn nti-proof (ack reason path steps) (list ack reason path steps))
  (defn nti-proof-ack (p) (nth p 0))
  (defn nti-proof-reason (p) (nth p 1))
  (defn nti-proof-path (p) (nth p 2))
  (defn nti-proof-steps (p) (nth p 3))
  (defn nti-proof-node? (p)
    (if (and (eq (nti-proof-nothing? p) 0)
             (and (not (eq (nti-proof-ack p) 0))
                  (not (eq (nti-proof-ack p) 1)))) 1 0))
  (defn nti-proof-yes? (p)
    (if (or (eq (nti-proof-ack p) 1) (eq (nti-proof-node? p) 1)) 1 0))
  (defn nti-proof-no? (p) (if (eq (nti-proof-ack p) 0) 1 0))
  (defn nti-proof-nothing? (p) (if (nothing? (nti-proof-ack p)) 1 0))
  (defn nti-proof-timeout? (p)
    (if (and (eq (nti-proof-nothing? p) 1) (eq (nti-proof-reason p) 2)) 1 0))
  (defn nti-known-concept? (id) (if (and (ge id 1) (le id 12)) 1 0))

  ; Search all requirement branches. A timed-out branch is remembered while
  ; siblings continue: YES may still land; only an exhausted search with an
  ; unresolved branch returns nothing. NO exists only after complete closure.
  (defn nti-proof-walk (all edges s target seen fuel pending steps)
    (if (le fuel 0) (nti-proof (nothing) 2 seen steps)
      (if (eq (len edges) 0)
        (if (eq (nti-proof-nothing? pending) 1) pending
          (nti-proof 0 0 (list) steps))
        (do (let e (head edges))
          (if (and (eq (nti-s e) s) (eq (nti-r e) 1))
            (if (eq (nti-t e) target)
              ; A path is a first-class alternative node acknowledgement.
              (nti-proof (list 1 s target) 0 (list s target) (add steps 1))
              (if (eq (nti-member? (nti-t e) seen) 1)
                (nti-proof-walk all (tail edges) s target seen (sub fuel 1) pending (add steps 1))
                (do (let child (nti-proof-walk all all (nti-t e) target
                                  (cons (nti-t e) seen) (sub fuel 1)
                                  (nti-proof 0 0 (list) 0) (add steps 1)))
                  (if (eq (nti-proof-yes? child) 1)
                    (do (let path (cons s (nti-proof-path child)))
                      (nti-proof (list 1 path) 0 path (nti-proof-steps child)))
                    (nti-proof-walk all (tail edges) s target seen (sub fuel 1)
                      (if (eq (nti-proof-nothing? child) 1) child pending)
                      (add steps 1))))))
            (nti-proof-walk all (tail edges) s target seen (sub fuel 1) pending (add steps 1)))))))
  (defn nti-proof-requires (s t fuel)
    (if (or (eq (nti-known-concept? s) 0) (eq (nti-known-concept? t) 0))
      (nti-proof (nothing) 1 (list s t) 0)
      (nti-proof-walk (nti-edges) (nti-edges) s t (list s) fuel
        (nti-proof 0 0 (list) 0) 0)))

  (defn nti-slice-loop (s i end acc)
    (if (ge i end) acc
      (nti-slice-loop s (add i 1) end
        (str_concat acc (byte_to_str (str_byte_at s i))))))
  (defn nti-fold-byte (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
  (defn nti-match-at (s i word j)
    (if (ge j (str_len word)) 1
      (if (ge (add i j) (str_len s)) 0
        (if (eq (nti-fold-byte (str_byte_at s (add i j)))
                (nti-fold-byte (str_byte_at word j)))
          (nti-match-at s i word (add j 1)) 0))))
  (defn nti-contains-loop (s word i)
    (if (gt (add i (str_len word)) (str_len s)) 0
      (if (eq (nti-match-at s i word 0) 1) 1
        (nti-contains-loop s word (add i 1)))))
  (defn nti-contains? (s word) (nti-contains-loop s word 0))
  (defn nti-recognized (q)
    (add (nti-contains? q "trust")
      (add (nti-contains? q "trinity")
        (add (nti-contains? q "knowing") (nti-contains? q "time")))))

  (defn nti-answer (trust-needs-trinity validity-needs-time distinct)
    (str_concat
      (if (eq trust-needs-trinity 1) "Yes. " "No. ")
      (str_concat
        (if (eq trust-needs-trinity 1)
          "The native requirement graph places Trinity on trust's dependency path. "
          "Trust is grounded by cell and boundary; Trinity is separately derived from cell and present composition. ")
        (str_concat
          (if (eq validity-needs-time 1)
            "Time is required for freshness when knowing is claimed as currently valid. "
            "The model found no temporal requirement for current validity. ")
          (if (eq distinct 1)
            "Knowability and currently validated knowing are distinct: time conditions the validation, not whether a structure can be known."
            "The model could not establish the distinction between knowability and current validation.")))))

  (let question "does trust require the Trinity to be knownable, since knowing requires time to valid in the reasoning plane?")
  (let recognized (nti-recognized question))
  (let trust-proof (nti-proof-requires 1 2 1000))
  (let time-proof (nti-proof-requires 4 5 1000))
  (let unknown-proof (nti-proof-requires 99 2 1000))
  (let timeout-proof (nti-proof-requires 4 5 0))
  (let trust-needs-trinity (nti-proof-ack trust-proof))
  (let validity-needs-time (nti-proof-yes? time-proof))
  (let distinct (nti-direct? (nti-edges) 3 4 4))
  (let grounded (if (and (eq (nti-direct? (nti-edges) 1 2 8) 1)
                          (eq (nti-direct? (nti-edges) 1 2 9) 1)) 1 0))
  (let success (if (and (eq recognized 4)
                     (and (eq (nti-proof-no? trust-proof) 1)
                       (and (eq (nti-proof-node? time-proof) 1)
                         (and (eq (nti-proof-nothing? unknown-proof) 1)
                           (and (eq (nti-proof-reason unknown-proof) 1)
                             (and (eq (nti-proof-timeout? timeout-proof) 1)
                               (and (eq distinct 1) (eq grounded 1)))))))) 1 0))
  (print_str (nti-answer trust-needs-trinity validity-needs-time distinct))
  ; [recognized, trust-proof, time-proof, unknown-proof, timeout-proof,
  ;  knowable-distinct, trust-grounded, success]
  (list recognized trust-proof time-proof unknown-proof timeout-proof
        distinct grounded success))
