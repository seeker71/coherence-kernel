; gap-continuation-learning.fk — light transferable continuation memory.
;
; No failure identity is retained. The learned residue is a disposition:
; continue toward an unobserved intention while the next movement remains
; aligned, sovereign, and vital; otherwise reorient without fear.
; witnessed: 2026-07-23 -> pending held-out transfer band
(do
    (defn gcl-complete () 1)
    (defn gcl-build-observe () 2)
    (defn gcl-reorient () 3)

    (defn gcl-next (requested observed aligned sovereign vital)
        (if (eq observed requested)
            (gcl-complete)
            (if (eq aligned 1)
                (if (eq sovereign 1)
                    (if (eq vital 1) (gcl-build-observe) (gcl-reorient))
                    (gcl-reorient))
                (gcl-reorient))))

    (defn gcl-living-next () (gcl-next 1 0 1 1 1))
    0)
