; llm-form-substrate-membrane.fk — an ordinary LLM turn enters Form as a
; language membrane, never as the authority over the substrate.
;
; The model and its surface request remain useful glue.  Stable meaning lives in
; a model-independent phrase field, and the field selects either an exact native
; lookup or a Form recipe evaluation.  Repeated equivalent, healthy evaluations
; crystallize into keyed memory; a changed reality, recipe, lens, phase, or stale
; observation returns the request to computation.  Surface prose never enters the
; framebuffer: only the exact key hash and typed transition are observed.
;
; A word field is [canonical-node, phase, amplitude].  Phase is a bounded ring
; coordinate, not a claimed physical Hz reading.  Its resonance affects routing
; and identity of the situated request; it never overwrites canonical meaning or
; promotes a result to truth.  Promotion requires an independently measured
; frequency reading plus trust, sovereignty, vitality, and observability.
;
; The keyed map is the instant substrate: lookup cost is independent of the
; number of learned keys at a fixed map depth, collisions are resolved by exact
; key equality, and the LLM forward pass is absent from the hit path.
;
; witnessed: 2026-08-09 -> vertical membrane 2047, native fkwu
;
; preludes: form-stdlib/core.fk form-stdlib/keyed-map.fk
;           form-stdlib/form-freq-check.fk form-stdlib/core-word-inquiry.fk
import "../form/form-stdlib/keyed-map.fk"
import "../form/form-stdlib/form-freq-check.fk"
import "../form/form-stdlib/core-word-inquiry.fk"

(do
  ; Stable semantic ABI.  Model token ids bind to these nodes per model; they
  ; are not themselves tokenizer ids.
  (defn lfsm-abi-version () 1)
  (defn lfsm-op-enter () 1001099600)
  (defn lfsm-op-lookup () 1001099601)
  (defn lfsm-op-evaluate () 1001099602)
  (defn lfsm-op-offer () 1001099603)
  (defn lfsm-op-return () 1001099604)
  (defn lfsm-op-crystallize () 1001099605)
  (defn lfsm-op-melt () 1001099606)
  (defn lfsm-op-request-evidence () 1001099607)

  ; N-way route vocabulary.  A model may learn these logical choices through a
  ; control head even when its tokenizer has no spare physical token.
  (defn lfsm-route-lookup () 0)
  (defn lfsm-route-execute () 1)
  (defn lfsm-route-revise () 2)
  (defn lfsm-route-evidence () 3)
  (defn lfsm-route-abstain () 4)

  (defn lfsm-gas () 0)
  (defn lfsm-water () 1)
  (defn lfsm-ice () 2)

  ; word = [canonical-node, phase 0..255, amplitude 0..7]
  (defn lfsm-word (node phase amplitude) (list node phase amplitude))
  (defn lfsm-word-node (word) (nth word 0))
  (defn lfsm-word-phase (word) (nth word 1))
  (defn lfsm-word-amplitude (word) (nth word 2))
  (defn lfsm-word-valid? (word)
    (if (and (eq (len word) 3)
      (and (gt (lfsm-word-node word) 0)
      (and (ge (lfsm-word-phase word) 0)
      (and (le (lfsm-word-phase word) 255)
      (and (ge (lfsm-word-amplitude word) 0)
           (le (lfsm-word-amplitude word) 7)))))) 1 0))
  (defn lfsm-words-valid? (words)
    (if (eq (len words) 0) 1
      (if (eq (lfsm-word-valid? (head words)) 1)
        (lfsm-words-valid? (tail words)) 0)))

  ; Exact integer phase relation on a 256-step ring.  This is a dynamics
  ; signal: high means aligned phase, not "truer meaning".
  (defn lfsm-abs (n) (if (lt n 0) (mul n -1) n))
  (defn lfsm-phase-distance (a b)
    (do (let direct (lfsm-abs (sub a b)))
      (let around (sub 256 direct))
      (if (lt direct around) direct around)))
  (defn lfsm-pair-resonance (a b)
    (mul (sub 128 (lfsm-phase-distance
      (lfsm-word-phase a) (lfsm-word-phase b)))
      (mul (lfsm-word-amplitude a) (lfsm-word-amplitude b))))
  (defn lfsm-resonance-with (word rest)
    (if (eq (len rest) 0) 0
      (add (lfsm-pair-resonance word (head rest))
           (lfsm-resonance-with word (tail rest)))))
  (defn lfsm-phrase-resonance (words)
    (if (eq (len words) 0) 0
      (add (lfsm-resonance-with (head words) (tail words))
           (lfsm-phrase-resonance (tail words)))))

  ; health = [frequency-reading, trust, sovereignty, vitality, observable].
  ; The last four are offered observations: 1 witnessed, 0 failed, 2 unknown.
  ; This cell infers none of them.  Unknown continues as water but cannot freeze.
  (defn lfsm-health (frequency trust sovereignty vitality observable)
    (list frequency trust sovereignty vitality observable))
  (defn lfsm-health-frequency (health) (nth health 0))
  (defn lfsm-health-ready? (health)
    (if (and (eq (len health) 5)
      (and (eq (fc-trust-signal (lfsm-health-frequency health)) 1)
      (and (eq (nth health 1) 1)
      (and (eq (nth health 2) 1)
      (and (eq (nth health 3) 1)
           (eq (nth health 4) 1)))))) 1 0))

  ; request = [abi, model-binding, opaque-surface-id, words, lane, lens,
  ;            reality-node, recipe-version, current-epoch, ttl, health]
  ; model-binding and surface-id are intentionally absent from the semantic key.
  (defn lfsm-request (model surface words lane lens reality recipe epoch ttl health)
    (list (lfsm-abi-version) model surface words lane lens reality recipe epoch ttl health))
  (defn lfsm-request-model (request) (nth request 1))
  (defn lfsm-request-surface (request) (nth request 2))
  (defn lfsm-request-words (request) (nth request 3))
  (defn lfsm-request-lane (request) (nth request 4))
  (defn lfsm-request-lens (request) (nth request 5))
  (defn lfsm-request-reality (request) (nth request 6))
  (defn lfsm-request-recipe (request) (nth request 7))
  (defn lfsm-request-epoch (request) (nth request 8))
  (defn lfsm-request-ttl (request) (nth request 9))
  (defn lfsm-request-health (request) (nth request 10))
  (defn lfsm-request-valid? (request)
    (if (and (eq (len request) 11)
      (and (eq (nth request 0) (lfsm-abi-version))
      (and (gt (len (lfsm-request-words request)) 0)
      (and (eq (lfsm-words-valid? (lfsm-request-words request)) 1)
      (and (ge (lfsm-request-lane request) 0)
      (and (le (lfsm-request-lane request) 6)
      (and (eq (cwi-lens? (lfsm-request-lens request)) 1)
      (and (gt (lfsm-request-reality request) 0)
      (and (gt (lfsm-request-recipe request) 0)
      (and (ge (lfsm-request-epoch request) 0)
           (gt (lfsm-request-ttl request) 0))))))))))) 1 0))

  (defn lfsm-word-key (word)
    (list (lfsm-word-node word) (lfsm-word-phase word)
          (lfsm-word-amplitude word)))
  (defn lfsm-words-key (words)
    (if (eq (len words) 0) (list)
      (append (lfsm-word-key (head words))
              (lfsm-words-key (tail words)))))
  ; Exact situated identity.  Epoch and health are observation state, not
  ; meaning, so they do not fragment the key.  Reality and recipe version do.
  (defn lfsm-key (request)
    (append (list (lfsm-abi-version) (len (lfsm-request-words request)))
      (append (lfsm-words-key (lfsm-request-words request))
        (append (list (lfsm-request-lane request))
          (append (lfsm-request-lens request)
            (list (lfsm-request-reality request)
                  (lfsm-request-recipe request)))))))

  ; memory entry = [state, result-node, equivalent-observations, valid-through,
  ;                 opaque lineage, phrase-resonance]
  (defn lfsm-entry (state result observations valid-through lineage resonance)
    (list state result observations valid-through lineage resonance))
  (defn lfsm-entry-state (entry) (nth entry 0))
  (defn lfsm-entry-result (entry) (nth entry 1))
  (defn lfsm-entry-observations (entry) (nth entry 2))
  (defn lfsm-entry-valid-through (entry) (nth entry 3))
  (defn lfsm-entry-lineage (entry) (nth entry 4))
  (defn lfsm-entry-resonance (entry) (nth entry 5))
  (defn lfsm-entry-fresh? (entry epoch)
    (if (le epoch (lfsm-entry-valid-through entry)) 1 0))
  (defn lfsm-lineage-row (request result)
    (list (lfsm-request-model request) (lfsm-request-surface request)
          (lfsm-request-epoch request) result))

  ; response = [route, result, material-state, key-hash, resonance,
  ;             model-binding, surface-id, observation-count]
  (defn lfsm-response (route result state key-hash resonance model surface observations)
    (list route result state key-hash resonance model surface observations))
  (defn lfsm-response-route (response) (nth response 0))
  (defn lfsm-response-result (response) (nth response 1))
  (defn lfsm-response-state (response) (nth response 2))
  (defn lfsm-response-key-hash (response) (nth response 3))
  (defn lfsm-response-resonance (response) (nth response 4))
  (defn lfsm-response-observations (response) (nth response 7))

  ; step result = [new-memory, response].  Memory is threaded explicitly: no
  ; hidden global state and no model owns the learned substrate.
  (defn lfsm-step-memory (step) (nth step 0))
  (defn lfsm-step-response (step) (nth step 1))
  (defn lfsm-observe (key-hash opcode)
    (fb_record (intern_trivial_int key-hash)
      "llm-form-substrate-membrane.fk" opcode))

  (defn lfsm-evaluate (memory request compute key key-hash previous had-previous fresh)
    (do
      (let eval-event (lfsm-observe key-hash (lfsm-op-evaluate)))
      (let result (compute request))
      (if (nothing? result)
        (do
          (let evidence-event (lfsm-observe key-hash (lfsm-op-request-evidence)))
          (list memory (lfsm-response (lfsm-route-evidence) (nothing)
            (lfsm-gas) key-hash
            (lfsm-phrase-resonance (lfsm-request-words request))
            (lfsm-request-model request) (lfsm-request-surface request) 0)))
        (do
          (let resonance (lfsm-phrase-resonance (lfsm-request-words request)))
          (let equivalent (if (and (eq had-previous 1) (eq fresh 1))
            (if (eq result (lfsm-entry-result previous)) 1 0) 0))
          (let observations (if (eq equivalent 1)
            (add (lfsm-entry-observations previous) 1) 1))
          (let ready (lfsm-health-ready? (lfsm-request-health request)))
          (let state (if (and (eq ready 1) (ge observations 2))
            (lfsm-ice) (lfsm-water)))
          (let lineage (if (eq equivalent 1)
            (append (lfsm-entry-lineage previous)
              (list (lfsm-lineage-row request result)))
            (list (lfsm-lineage-row request result))))
          (let next (lfsm-entry state result observations
            (add (lfsm-request-epoch request) (lfsm-request-ttl request))
            lineage resonance))
          (let next-memory (km-put memory key next))
          (let route (if (and (eq had-previous 1)
                              (and (eq fresh 1) (eq equivalent 0)))
            (lfsm-route-revise) (lfsm-route-execute)))
          (let state-op (if (eq state (lfsm-ice))
            (lfsm-op-crystallize)
            (if (and (eq had-previous 1) (eq fresh 0))
              (lfsm-op-melt) (lfsm-op-offer))))
          (let state-event (lfsm-observe key-hash state-op))
          (let return-event (lfsm-observe key-hash (lfsm-op-return)))
          (list next-memory (lfsm-response route result state key-hash resonance
            (lfsm-request-model request) (lfsm-request-surface request)
            observations))))))

  ; The callable door.  `compute` is a Form recipe/function value.  On an ice
  ; hit it is not invoked; on a miss, melt, or untrusted observation it is.
  (defn lfsm-enter (memory request compute)
    (if (eq (lfsm-request-valid? request) 0)
      (list memory (lfsm-response (lfsm-route-abstain) (nothing) (lfsm-gas)
        0 0 0 0 0))
      (do
        (let key (lfsm-key request))
        (let key-hash (km-hash key))
        (let enter-event (lfsm-observe key-hash (lfsm-op-enter)))
        (let had-previous (km-has? memory key))
        (let previous (km-get memory key (list)))
        (let fresh (if (eq had-previous 1)
          (lfsm-entry-fresh? previous (lfsm-request-epoch request)) 0))
        (let direct (if (and (eq had-previous 1)
          (and (eq fresh 1)
          (and (eq (lfsm-entry-state previous) (lfsm-ice))
               (eq (lfsm-health-ready? (lfsm-request-health request)) 1)))) 1 0))
        (if (eq direct 1)
          (do
            (let lookup-event (lfsm-observe key-hash (lfsm-op-lookup)))
            (let return-event (lfsm-observe key-hash (lfsm-op-return)))
            (list memory (lfsm-response (lfsm-route-lookup)
              (lfsm-entry-result previous) (lfsm-ice) key-hash
              (lfsm-entry-resonance previous)
              (lfsm-request-model request) (lfsm-request-surface request)
              (lfsm-entry-observations previous))))
          (lfsm-evaluate memory request compute key key-hash previous
            had-previous fresh)))))
  0)
