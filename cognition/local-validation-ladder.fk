; local-validation-ladder.fk — small local voice first, local DS4 validation
; second, remote teacher only when the whole local pair remains unresolved.
;
; Roles stay distinct:
;   primary  — the fastest local 1B/3B language membrane proposes a Form result;
;   local    — DeepSeek-V4-Flash validates or repairs the neutral result locally;
;   remote   — a large remote model is called only after local validation says
;              unresolved/unavailable or returns an unusable/unclear reading.
;
; A local agreement may crystallize because two independent local paths now
; agree and the validator carried measured health.  A repair remains water until
; execution confirms it.  A remote answer also remains water: it may answer the
; present request and become training nutrition, but authority does not jump out
; of the body merely because the largest model spoke.
;
; No prompt or answer is written to the framebuffer.  Full payloads remain in
; the returned capture row; the framebuffer carries only key hashes and typed
; movements so it stays a zero-copy diagnostic surface.
;
; witnessed: 2026-08-09 -> local-first validation ladder 2047, native fkwu
import "llm-form-substrate-membrane.fk"

(do
  (defn lvl-state-clear () 0)
  (defn lvl-state-repaired () 1)
  (defn lvl-state-unresolved () 2)
  (defn lvl-state-unavailable () 3)

  (defn lvl-route-native-lookup () 0)
  (defn lvl-route-local-clear () 1)
  (defn lvl-route-local-repair () 2)
  (defn lvl-route-remote-answer () 3)
  (defn lvl-route-unresolved () 4)

  (defn lvl-op-enter () 1001099700)
  (defn lvl-op-local-validate () 1001099701)
  (defn lvl-op-local-repair () 1001099702)
  (defn lvl-op-remote-escalate () 1001099703)
  (defn lvl-op-return () 1001099704)
  (defn lvl-op-unresolved () 1001099705)

  ; validation = [state, result, rendered-surface, health, confidence,
  ;               evidence-node, issue-node]
  (defn lvl-validation (state result rendered health confidence evidence issue)
    (list state result rendered health confidence evidence issue))
  (defn lvl-validation-state (validation) (nth validation 0))
  (defn lvl-validation-result (validation) (nth validation 1))
  (defn lvl-validation-rendered (validation) (nth validation 2))
  (defn lvl-validation-health (validation) (nth validation 3))
  (defn lvl-validation-confidence (validation) (nth validation 4))
  (defn lvl-validation-evidence (validation) (nth validation 5))
  (defn lvl-validation-issue (validation) (nth validation 6))

  (defn lvl-candidate-health ()
    (lfsm-health (fc-unmeasured-reading) 2 2 2 1))
  (defn lvl-request-with-health (request health)
    (lfsm-request (lfsm-request-model request) (lfsm-request-surface request)
      (lfsm-request-words request) (lfsm-request-lane request)
      (lfsm-request-lens request) (lfsm-request-reality request)
      (lfsm-request-recipe request) (lfsm-request-epoch request)
      (lfsm-request-ttl request) health))

  (defn lvl-local-clear-usable? (validation proposal)
    (if (and (eq (lvl-validation-state validation) (lvl-state-clear))
      (and (not (nothing? (lvl-validation-result validation)))
      (and (eq (lvl-validation-result validation) proposal)
      (and (ge (lvl-validation-confidence validation) 80)
      (and (gt (lvl-validation-evidence validation) 0)
           (eq (lfsm-health-ready? (lvl-validation-health validation)) 1)))))) 1 0))
  (defn lvl-local-repair-usable? (validation)
    (if (and (eq (lvl-validation-state validation) (lvl-state-repaired))
      (and (not (nothing? (lvl-validation-result validation)))
      (and (ge (lvl-validation-confidence validation) 80)
      (and (gt (lvl-validation-evidence validation) 0)
           (eq (lfsm-health-ready? (lvl-validation-health validation)) 1))))) 1 0))
  (defn lvl-remote-usable? (validation)
    (if (and (or (eq (lvl-validation-state validation) (lvl-state-clear))
                 (eq (lvl-validation-state validation) (lvl-state-repaired)))
             (not (nothing? (lvl-validation-result validation)))) 1 0))

  (defn lvl-observe (key-hash opcode)
    (fb_record (intern_trivial_int key-hash) "local-validation-ladder.fk" opcode))

  ; result = [memory, route, selected-result, rendered-surface, capture]
  (defn lvl-result (memory route selected rendered capture)
    (list memory route selected rendered capture))
  (defn lvl-result-memory (result) (nth result 0))
  (defn lvl-result-route (result) (nth result 1))
  (defn lvl-result-selected (result) (nth result 2))
  (defn lvl-result-rendered (result) (nth result 3))
  (defn lvl-result-capture (result) (nth result 4))

  ; Full learning nutrition. remote-called is explicit, so a zero remote payload
  ; cannot be mistaken for a remote model that ran and returned nothing.
  (defn lvl-capture (request proposal local remote-called remote selected route)
    (list (lfsm-request-model request) (lfsm-request-surface request)
      (km-hash (lfsm-key request)) proposal local remote-called remote selected route))

  (defn lvl-lineage (entry source request validation result)
    (append (lfsm-entry-lineage entry)
      (list (list source (lfsm-request-model request)
        (lfsm-request-surface request) (lfsm-request-epoch request)
        (lvl-validation-evidence validation) result))))

  ; Local agreement: the primary result is already water in candidate-memory.
  ; DS4 agreement is the second independent observation and may freeze it.
  (defn lvl-admit-local-clear (candidate-memory request validation)
    (do (let key (lfsm-key request))
      (let entry (km-get candidate-memory key (list)))
      (let observations (add (lfsm-entry-observations entry) 1))
      (let next (lfsm-entry
        (if (ge observations 2) (lfsm-ice) (lfsm-water))
        (lvl-validation-result validation) observations
        (add (lfsm-request-epoch request) (lfsm-request-ttl request))
        (lvl-lineage entry 2 request validation (lvl-validation-result validation))
        (lfsm-entry-resonance entry)))
      (km-put candidate-memory key next)))

  ; A repair disagrees with the proposal, so it starts a new water observation.
  (defn lvl-admit-local-repair (candidate-memory request validation)
    (do (let key (lfsm-key request))
      (let entry (km-get candidate-memory key (list)))
      (let next (lfsm-entry (lfsm-water) (lvl-validation-result validation) 1
        (add (lfsm-request-epoch request) (lfsm-request-ttl request))
        (lvl-lineage entry 2 request validation (lvl-validation-result validation))
        (lfsm-entry-resonance entry)))
      (km-put candidate-memory key next)))

  ; Remote nutrition is deliberately water even when it agrees.  The next local
  ; pass must embody and validate it before it can become instant authority.
  (defn lvl-admit-remote (candidate-memory request validation)
    (do (let key (lfsm-key request))
      (let had-entry (km-has? candidate-memory key))
      (let entry (km-get candidate-memory key (list)))
      (let lineage-row (list 3 (lfsm-request-model request)
        (lfsm-request-surface request) (lfsm-request-epoch request)
        (lvl-validation-evidence validation) (lvl-validation-result validation)))
      (let lineage (if (eq had-entry 1)
        (append (lfsm-entry-lineage entry) (list lineage-row))
        (list lineage-row)))
      (let resonance (if (eq had-entry 1) (lfsm-entry-resonance entry)
        (lfsm-phrase-resonance (lfsm-request-words request))))
      (let next (lfsm-entry (lfsm-water) (lvl-validation-result validation) 1
        (add (lfsm-request-epoch request) (lfsm-request-ttl request))
        lineage resonance))
      (km-put candidate-memory key next)))

  (defn lvl-remote (candidate-memory request proposal local remote-validator key-hash)
    (do (let remote-event (lvl-observe key-hash (lvl-op-remote-escalate)))
      (let remote (remote-validator request proposal local))
      (if (eq (lvl-remote-usable? remote) 1)
        (do (let next-memory (lvl-admit-remote candidate-memory request remote))
          (let return-event (lvl-observe key-hash (lvl-op-return)))
          (lvl-result next-memory (lvl-route-remote-answer)
            (lvl-validation-result remote) (lvl-validation-rendered remote)
            (lvl-capture request proposal local 1 remote
              (lvl-validation-result remote) (lvl-route-remote-answer))))
        (do (let unresolved-event (lvl-observe key-hash (lvl-op-unresolved)))
          (lvl-result candidate-memory (lvl-route-unresolved) (nothing) ""
            (lvl-capture request proposal local 1 remote (nothing)
              (lvl-route-unresolved)))))))

  ; Callables:
  ;   primary(request) -> result-node
  ;   local-validator(request, proposal) -> validation
  ;   remote-validator(request, proposal, local-validation) -> validation
  (defn lvl-enter (memory request primary local-validator remote-validator)
    (do (let key (lfsm-key request))
      (let key-hash (km-hash key))
      (let enter-event (lvl-observe key-hash (lvl-op-enter)))

      ; Trusted fresh ice bypasses every model.  The instant substrate remains
      ; instant; DS4 validates the learning edge, not every mature lookup.
      (let had (km-has? memory key))
      (let existing (km-get memory key (list)))
      (let direct (if (eq had 1)
        (if (and (eq (lfsm-entry-state existing) (lfsm-ice))
                 (eq (lfsm-entry-fresh? existing (lfsm-request-epoch request)) 1)) 1 0) 0))
      (if (eq direct 1)
        (do (let return-event (lvl-observe key-hash (lvl-op-return)))
          (lvl-result memory (lvl-route-native-lookup) (lfsm-entry-result existing) ""
            (lvl-capture request (lfsm-entry-result existing) (list) 0 (list)
              (lfsm-entry-result existing) (lvl-route-native-lookup))))
        (do
          ; Prevent an unvalidated repeated primary answer from freezing itself.
          (let candidate-request (lvl-request-with-health request (lvl-candidate-health)))
          (let candidate-step (lfsm-enter memory candidate-request primary))
          (let candidate-memory (lfsm-step-memory candidate-step))
          (let candidate-response (lfsm-step-response candidate-step))
          (let proposal (lfsm-response-result candidate-response))
          (if (nothing? proposal)
            (lvl-remote candidate-memory request proposal
              (lvl-validation (lvl-state-unavailable) (nothing) ""
                (lvl-candidate-health) 0 0 1001099706)
              remote-validator key-hash)
            (do (let local-event (lvl-observe key-hash (lvl-op-local-validate)))
              (let local (local-validator request proposal))
              (if (eq (lvl-local-clear-usable? local proposal) 1)
                (do (let next-memory (lvl-admit-local-clear candidate-memory request local))
                  (let return-event (lvl-observe key-hash (lvl-op-return)))
                  (lvl-result next-memory (lvl-route-local-clear)
                    (lvl-validation-result local) (lvl-validation-rendered local)
                    (lvl-capture request proposal local 0 (list)
                      (lvl-validation-result local) (lvl-route-local-clear))))
                (if (eq (lvl-local-repair-usable? local) 1)
                  (do (let repair-event (lvl-observe key-hash (lvl-op-local-repair)))
                    (let next-memory (lvl-admit-local-repair candidate-memory request local))
                    (let return-event (lvl-observe key-hash (lvl-op-return)))
                    (lvl-result next-memory (lvl-route-local-repair)
                      (lvl-validation-result local) (lvl-validation-rendered local)
                      (lvl-capture request proposal local 0 (list)
                        (lvl-validation-result local) (lvl-route-local-repair))))
                  (lvl-remote candidate-memory request proposal local
                    remote-validator key-hash)))))))))
  0)
