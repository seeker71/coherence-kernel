; core-text-36-layer-ingest.fk — rights-aware, protocol-aware semantic intake.
;
; The 36 layers are a versioned observation scaffold, not 36 timeless truths.
; Every layer has:
;   compact layer slot 1..36
;   compact query slot 1..252 for seven inquiry lanes
;   repository-global stable symbols whose identities contain no spelling
;   a response acknowledgement in exactly: nothing | 0 | 1 | derived-node
;
; Layers:
;   0 source identity       1 legal rights          2 community authority
;   3 cultural restriction 4 provenance             5 work
;   6 edition              7 segment                8 age
;   9 language            10 dialect               11 script
;  12 transliteration     13 morphology            14 syntax
;  15 speaker             16 addressee             17 viewpoint
;  18 identity role       19 inclusion/boundary    20 relationship
;  21 place               22 time                  23 action
;  24 state               25 feeling               26 modality
;  27 negation            28 composition           29 causality
;  30 evidence            31 uncertainty           32 metaphor
;  33 translation alignment/loss
;  34 query
;  35 response/receipt/freshness
;
; An admission response is:
;   [nothing,0,1,alternative,ack,reason,source-node,source-id,content-state]
; reason:
;   0 admitted, 1 unknown source, 2 rights unresolved, 3 exact item owed,
;   4 community review owed, 5 steward/community refusal,
;   6 legal rights closed/limited, 7 rights/protocol witness stale.
;
; Metadata may enter the registry while the text body waits. A source body is
; admitted only when legal rights, protocol, exact-item state, and freshness
; all pass. Public-domain status never overwrites community authority.
;
; witnessed: 2026-07-26 -> native full band and pure structural four-way band;
; exact commands/results in receipts/2026-07-26-core-text-36-layer-ingest.md
import "language-neutral-symbol-identity.fk"
import "native-inquiry-derivation.fk"
import "../learn/core-text-source-registry.fk"

(do
  (defn ct36-layer? (layer) (if (and (ge layer 0) (le layer 35)) 1 0))
  (defn ct36-layer-slot (layer) (add layer 1))
  (defn ct36-layer-symbol (layer)
    (lnsi-node 3 36 1 (ct36-layer-slot layer)))

  (defn ct36-query-slot (layer lane)
    (add 1 (add (mul layer 7) lane)))
  (defn ct36-query-symbol (layer lane)
    (lnsi-node 3 37 2 (ct36-query-slot layer lane)))
  (defn ct36-segment-symbol (source segment)
    (lnsi-node 3 38 source segment))
  (defn ct36-source-symbol (source)
    (lnsi-node 3 39 1 source))
  (defn ct36-review-symbol (source reason)
    (lnsi-node 3 40 reason source))

  ; Query response extends native-inquiry-derivation without collapsing the
  ; semantic layer, query identity, recursive answer, or derivation receipt.
  (defn ct36-query-response
    (alternative ack reason layer-symbol layer-slot query-symbol query-slot receipt steps)
    (list (nothing) 0 1 alternative ack reason layer-symbol layer-slot
      query-symbol query-slot receipt steps))
  (defn ct36-qr-alt (r) (nth r 3))
  (defn ct36-qr-ack (r) (nth r 4))
  (defn ct36-qr-reason (r) (nth r 5))
  (defn ct36-qr-layer-symbol (r) (nth r 6))
  (defn ct36-qr-layer-slot (r) (nth r 7))
  (defn ct36-qr-query-symbol (r) (nth r 8))
  (defn ct36-qr-query-slot (r) (nth r 9))
  (defn ct36-qr-receipt (r) (nth r 10))
  (defn ct36-qr-steps (r) (nth r 11))
  (defn ct36-query-arms? (r)
    (if (and (nothing? (nth r 0))
      (and (eq (nth r 1) 0)
      (and (eq (nth r 2) 1)
           (eq (nid-valid? (nth r 3)) 1)))) 1 0))

  (defn ct36-ask (subject layer lane fuel)
    (if (or (eq (ct36-layer? layer) 0) (eq (nid-lane? lane) 0))
      (ct36-query-response 1 (nothing) 4
        (nothing) (nothing) (nothing) (nothing) (list) 0)
      (do
        (let native (nid-inquire subject lane fuel))
        (ct36-query-response
          (nid-p-alt native) (nid-p-ack native) (nid-p-reason native)
          (ct36-layer-symbol layer) (ct36-layer-slot layer)
          (ct36-query-symbol layer lane) (ct36-query-slot layer lane)
          (nid-p-receipt native) (nth native 7)))))

  ; Every completed response can be the next query subject inside a bounded
  ; wave. Native derivation IDs are base-8 paths in signed integers; a single
  ; 36-deep path would overflow. Two explicit 18-step waves preserve all 36
  ; responses and make the checkpoint visible instead of laundering overflow.
  (defn ct36-chain-wave-loop (subject layer end acc)
    (if (ge layer end) (nid-reverse-loop acc (list))
      (do
        (let answer (ct36-ask subject layer (mod layer 7) 1))
        (if (or (nothing? (ct36-qr-ack answer))
          (eq (ct36-qr-ack answer) 0))
          (nid-reverse-loop (cons answer acc) (list))
          (ct36-chain-wave-loop (ct36-qr-ack answer) (add layer 1) end
            (cons answer acc))))))
  (defn ct36-append (left right)
    (if (eq (len left) 0) right
      (cons (head left) (ct36-append (tail left) right))))
  (defn ct36-chain ()
    (ct36-append
      (ct36-chain-wave-loop 1 0 18 (list))
      (ct36-chain-wave-loop 1 18 36 (list))))
  (defn ct36-chain-valid-loop (answers layer expected-parent)
    (if (eq (len answers) 0) (if (eq layer 36) 1 0)
      (do
        (let answer (head answers))
        (if (and (eq (ct36-query-arms? answer) 1)
          (and (eq (nid-valid? (ct36-qr-ack answer)) 1)
          (and (eq (ct36-qr-layer-slot answer) (add layer 1))
          (and (eq (ct36-qr-query-slot answer)
                   (ct36-query-slot layer (mod layer 7)))
          (and (eq (nid-r-parent (ct36-qr-receipt answer)) expected-parent)
               (eq (nid-receipt-valid? (ct36-qr-receipt answer)) 1))))))
          (ct36-chain-valid-loop (tail answers) (add layer 1)
            (if (eq (mod (add layer 1) 18) 0)
              1 (ct36-qr-ack answer)))
          0))))
  (defn ct36-chain-valid? (answers)
    (ct36-chain-valid-loop answers 0 1))

  (defn ct36-rights-open? (rights)
    (if (or (eq rights (ctsr-rights-public-domain))
      (or (eq rights (ctsr-rights-cc0))
      (or (eq rights (ctsr-rights-cc-by))
          (eq rights (ctsr-rights-cc-by-sa))))) 1 0))

  (defn ct36-admission-response
    (alternative ack reason source-node source-id content-state)
    (list (nothing) 0 1 alternative ack reason
      source-node source-id content-state))
  (defn ct36-ar-alt (r) (nth r 3))
  (defn ct36-ar-ack (r) (nth r 4))
  (defn ct36-ar-reason (r) (nth r 5))
  (defn ct36-ar-source (r) (nth r 6))
  (defn ct36-ar-source-id (r) (nth r 7))
  (defn ct36-ar-content-state (r) (nth r 8))
  (defn ct36-admission-arms? (r)
    (if (and (nothing? (nth r 0))
      (and (eq (nth r 1) 0)
      (and (eq (nth r 2) 1)
           (gt (nth r 3) 1)))) 1 0))

  ; Pure admission class for a KNOWN source:
  ;   0 unresolved, 1 refused, 2 admitted, 3 review-node.
  ; It is the shared decision core for both the rich four-arm response and the
  ; minimal proof walkers, which deliberately do not implement first-class
  ; nothing. The strict order ensures refusal is never hidden by CC0/PD.
  (defn ct36-admission-class (source epoch)
    (do
      (let protocol (ctsr-protocol source))
      (let rights (ctsr-rights source))
      (let rights-scope (ctsr-rights-scope source))
      (let content (ctsr-content-state source))
      (if (or (eq protocol (ctsr-protocol-no-dataset))
              (eq protocol (ctsr-protocol-no-merge)))
        1
        (if (or (eq rights (ctsr-rights-limited))
                (eq rights (ctsr-rights-closed)))
          1
          (if (or (eq rights (ctsr-rights-unknown))
                  (str_eq rights-scope ""))
            0
            (if (or (eq protocol (ctsr-protocol-unresolved))
                    (eq protocol (ctsr-protocol-per-item)))
              0
              (if (eq protocol (ctsr-protocol-community-review))
                3
                (if (not (eq (ctsr-epoch source) epoch))
                  3
                  (if (eq content (ctsr-content-metadata))
                    3
                    (if (eq (ct36-rights-open? rights) 1) 2 0))))))))))

  (defn ct36-admission-reason (source epoch)
    (do
      (let protocol (ctsr-protocol source))
      (let rights (ctsr-rights source))
      (let rights-scope (ctsr-rights-scope source))
      (let content (ctsr-content-state source))
      (if (or (eq protocol (ctsr-protocol-no-dataset))
              (eq protocol (ctsr-protocol-no-merge)))
        5
        (if (or (eq rights (ctsr-rights-limited))
                (eq rights (ctsr-rights-closed)))
          6
          (if (or (eq rights (ctsr-rights-unknown))
                  (str_eq rights-scope ""))
            2
            (if (or (eq protocol (ctsr-protocol-unresolved))
                    (eq protocol (ctsr-protocol-per-item)))
              3
              (if (eq protocol (ctsr-protocol-community-review))
                4
                (if (not (eq (ctsr-epoch source) epoch))
                  7
                  (if (eq content (ctsr-content-metadata))
                    3
                    (if (eq (ct36-rights-open? rights) 1) 0 2))))))))))

  ; Legal rights and community/steward protocol are independent gates.
  (defn ct36-admit-source (source epoch)
    (if (nothing? source)
      (ct36-admission-response (ct36-review-symbol 1 1)
        (nothing) 1 (nothing) 0 0)
      (do
        (let id (ctsr-id source))
        (let node (ct36-source-symbol id))
        (let content (ctsr-content-state source))
        (let class (ct36-admission-class source epoch))
        (let reason (ct36-admission-reason source epoch))
        (if (eq class 0)
          (ct36-admission-response (ct36-review-symbol id reason)
            (nothing) reason node id content)
          (if (eq class 1)
            (ct36-admission-response (ct36-review-symbol id reason)
              0 reason node id content)
            (if (eq class 2)
              (ct36-admission-response (ct36-review-symbol id reason)
                1 reason node id content)
              (ct36-admission-response (ct36-review-symbol id reason)
                (ct36-review-symbol id reason) reason node id content)))))))

  (defn ct36-admit (source-id epoch)
    (ct36-admit-source (ctsr-find source-id) epoch))

  ; Count selected classes without coercing nothing, 0, 1, and node together.
  ; Result: [admitted, review-node, refused, unresolved].
  (defn ct36-admission-counts-loop (sources epoch admitted review refused unresolved)
    (if (eq (len sources) 0)
      (list admitted review refused unresolved)
      (do
        (let class (ct36-admission-class (head sources) epoch))
        (if (eq class 0)
          (ct36-admission-counts-loop (tail sources) epoch
            admitted review refused (add unresolved 1))
          (if (eq class 1)
            (ct36-admission-counts-loop (tail sources) epoch
              admitted review (add refused 1) unresolved)
            (if (eq class 2)
              (ct36-admission-counts-loop (tail sources) epoch
                (add admitted 1) review refused unresolved)
              (ct36-admission-counts-loop (tail sources) epoch
                admitted (add review 1) refused unresolved)))))))
  (defn ct36-admission-counts (epoch)
    (ct36-admission-counts-loop (ctsr-sources) epoch 0 0 0 0))

  (defn ct36-segment-admitted-count-loop (segments epoch n)
    (if (eq (len segments) 0) n
      (do
        (let admitted (ct36-admit (ctsr-seg-source (head segments)) epoch))
        (ct36-segment-admitted-count-loop (tail segments) epoch
          (add n (if (eq (ct36-ar-ack admitted) 1) 1 0))))))
  (defn ct36-segment-admitted-count (epoch)
    (ct36-segment-admitted-count-loop (ctsr-segments) epoch 0))

  (defn ct36-translation-count-loop (segments group n)
    (if (eq (len segments) 0) n
      (ct36-translation-count-loop (tail segments) group
        (add n (if (eq (ctsr-seg-group (head segments)) group) 1 0)))))
  (defn ct36-translation-count (group)
    (ct36-translation-count-loop (ctsr-segments) group 0))

  (defn ct36-translation-distinct-loop (segments group prior-node n)
    (if (eq (len segments) 0) n
      (do
        (let segment (head segments))
        (if (eq (ctsr-seg-group segment) group)
          (do
            (let node (ct36-segment-symbol
              (ctsr-seg-source segment) (ctsr-seg-id segment)))
            (if (gt node prior-node)
              (ct36-translation-distinct-loop
                (tail segments) group node (add n 1))
              n))
          (ct36-translation-distinct-loop
            (tail segments) group prior-node n)))))
  (defn ct36-translation-distinct-count (group)
    (ct36-translation-distinct-loop (ctsr-segments) group 0 0))

  ; Strict monotonicity proves uniqueness of all 36 layer addresses.
  (defn ct36-layer-unique-loop (layer prior-slot prior-symbol n)
    (if (ge layer 36) n
      (do
        (let slot (ct36-layer-slot layer))
        (let symbol (ct36-layer-symbol layer))
        (if (and (gt slot prior-slot) (gt symbol prior-symbol))
          (ct36-layer-unique-loop
            (add layer 1) slot symbol (add n 1))
          n))))
  (defn ct36-layer-unique-count ()
    (ct36-layer-unique-loop 0 0 0 0))

  ; Query nodes are dense 1..252 in layer-major, lane-minor order.
  (defn ct36-query-index-layer (i) (div i 7))
  (defn ct36-query-index-lane (i) (mod i 7))
  (defn ct36-query-unique-loop (i prior-slot prior-symbol n)
    (if (ge i 252) n
      (do
        (let layer (ct36-query-index-layer i))
        (let lane (ct36-query-index-lane i))
        (let slot (ct36-query-slot layer lane))
        (let symbol (ct36-query-symbol layer lane))
        (if (and (gt slot prior-slot) (gt symbol prior-symbol))
          (ct36-query-unique-loop (add i 1) slot symbol (add n 1))
          n))))
  (defn ct36-query-unique-count ()
    (ct36-query-unique-loop 0 0 0 0))

  ; Pure structural projection for all four proof walkers. It deliberately
  ; avoids evaluating first-class nothing, which the minimal siblings do not
  ; carry, while still proving the address and admission-state structure.
  (defn ct36-structure-witness ()
    (do
      (let counts (ct36-admission-counts 20260726))
      (add
        (if (eq (ct36-layer-unique-count) 36) 1 0)
        (add
          (if (eq (ct36-query-unique-count) 252) 2 0)
          (add
            (if (and (eq (nth counts 0) 6) (eq (nth counts 1) 2)) 4 0)
            (add
              (if (and (eq (nth counts 2) 2) (eq (nth counts 3) 3)) 8 0)
              (add
                (if (eq (len (ctsr-segments)) 6) 16 0)
                (add
                  (if (eq (ct36-translation-count 100) 4) 32 0)
                  (if (eq (ct36-translation-distinct-count 100) 4)
                    64 0)))))))))

  (defn ct36-witness ()
    (do
      (let epoch 20260726)
      (let counts (ct36-admission-counts epoch))
      (let chain (ct36-chain))
      (let admitted (ct36-admit 1 epoch))
      (let reviewed (ct36-admit 7 epoch))
      (let refused (ct36-admit 9 epoch))
      (let unresolved (ct36-admit 8 epoch))
      (let stale (ct36-admit 1 20260727))
      (let missing (ct36-admit 99 epoch))
      (let answer (ct36-ask 1 35 6 1))
      (let score
        (add
          (if (eq (ct36-layer-unique-count) 36) 1 0)
          (add
            (if (eq (ct36-query-unique-count) 252) 2 0)
            (add
              (if (and (eq (nth counts 0) 6)
                (and (eq (nth counts 1) 2)
                (and (eq (nth counts 2) 2) (eq (nth counts 3) 3)))) 4 0)
              (add
                (if (and (eq (ct36-admission-arms? admitted) 1)
                  (and (eq (ct36-admission-arms? reviewed) 1)
                  (and (eq (ct36-admission-arms? refused) 1)
                       (eq (ct36-admission-arms? unresolved) 1)))) 8 0)
                (add
                  (if (and (eq (ct36-ar-ack admitted) 1)
                    (and (gt (ct36-ar-ack reviewed) 1)
                    (and (eq (ct36-ar-ack refused) 0)
                         (nothing? (ct36-ar-ack unresolved))))) 16 0)
                  (add
                    (if (and (eq (len chain) 36)
                             (eq (ct36-chain-valid? chain) 1)) 32 0)
                    (add
                      (if (and (eq (len (ctsr-segments)) 6)
                        (eq (ct36-segment-admitted-count epoch) 6)) 64 0)
                      (add
                        (if (and (eq (ct36-translation-count 100) 4)
                          (eq (ct36-translation-distinct-count 100) 4)) 128 0)
                        (add
                          (if (and (gt (ct36-ar-ack stale) 1)
                                   (eq (ct36-ar-reason stale) 7)) 256 0)
                          (add
                            (if (and (nothing? (ct36-ar-ack missing))
                                     (eq (ct36-ar-reason missing) 1)) 512 0)
                            (add
                              (if (and (eq (ct36-query-arms? answer) 1)
                                (and (eq (nid-valid? (ct36-qr-ack answer)) 1)
                                     (eq (nid-receipt-valid?
                                       (ct36-qr-receipt answer)) 1))) 1024 0)
                              (if (eq (ct36-structure-witness) 127)
                                2048 0)))))))))))))
      ; [nothing,0,1,alternative,admission-counts,segment-count,
      ;  translation-count,chain-count,stale-ack,missing-ack,
      ;  sample-query-ack,score]
      (list (nothing) 0 1 (ct36-ar-alt reviewed)
        counts (len (ctsr-segments)) (ct36-translation-count 100)
        (len chain) (ct36-ar-ack stale) (ct36-ar-ack missing)
        (ct36-qr-ack answer) score)))

  0)
