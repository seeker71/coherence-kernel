; session-neutral-meaning-evidence.fk — revisable witness relations for phrase
; meanings. Evidence changes the view of a binding; it never rewrites the
; expression, the meaning recipe, another witness, or the earlier event.
;
; Each witness has its own latest choice point for one expression/meaning pair.
; support, release, and revise are neutral stance symbols whose descriptions use
; existing structural symbols. Several different stances at the same latest
; choice point remain an explicit witness conflict instead of being ordered by
; list position. A caller supplies the support floor used by its current view.
;
; witnessed: 2026-08-24 -> meaning evidence band 32767 on fkwu
; preludes: cognition/session-neutral-phrase-graph.fk

(do
  (defn snse-stance (id) (snsf-address 12 id))
  (defn snse-support () (snse-stance 0))
  (defn snse-release () (snse-stance 1))
  (defn snse-revise () (snse-stance 2))
  (defn snse-stance-valid? (stance)
    (if (and (eq (snsp-address-shape? stance) 1)
             (and (eq (nth stance 1) 12)
                  (and (ge (nth stance 2) 0) (le (nth stance 2) 2)))) 1 0))
  (defn snse-stance-description (stance)
    (if (value_eq stance (snse-support))
      (list (snsf-structure-address 14) (snsf-structure-address 6))
      (if (value_eq stance (snse-release))
        (list (snsf-structure-address 3))
        (if (value_eq stance (snse-revise))
          (list (snsf-structure-address 9) (snsf-structure-address 14))
          (empty)))))
  (defn snse-stances-closed? ()
    (if (and (eq (snsp-neutral-address-list?
                    (snse-stance-description (snse-support))) 1)
             (and (eq (snsp-neutral-address-list?
                         (snse-stance-description (snse-release))) 1)
                  (eq (snsp-neutral-address-list?
                        (snse-stance-description (snse-revise))) 1))) 1 0))

  ; event = content address, witness, expression, meaning, stance,
  ; neutral evidence recipe, choice point.
  (defn snse-event
    (witness expression meaning stance evidence choice-point)
    (list (snsf-address 13
            (list witness expression meaning stance evidence choice-point))
      witness expression meaning stance evidence choice-point))
  (defn snse-e-address (event) (nth event 0))
  (defn snse-e-witness (event) (nth event 1))
  (defn snse-e-expression (event) (nth event 2))
  (defn snse-e-meaning (event) (nth event 3))
  (defn snse-e-stance (event) (nth event 4))
  (defn snse-e-evidence (event) (nth event 5))
  (defn snse-e-choice-point (event) (nth event 6))
  (defn snse-event-valid? (event)
    (if (and (eq (len event) 7)
             (and (eq (snsp-address-shape? (snse-e-witness event)) 1)
             (and (eq (snsp-address-shape? (snse-e-expression event)) 1)
             (and (eq (snsp-address-shape? (snse-e-meaning event)) 1)
             (and (eq (snse-stance-valid? (snse-e-stance event)) 1)
             (and (eq (snsp-neutral-address-list? (snse-e-evidence event)) 1)
                  (ge (snse-e-choice-point event) 0))))))) 1 0))
  (defn snse-event-for-binding? (event binding)
    (if (and (eq (snse-event-valid? event) 1)
             (and (value_eq (snse-e-expression event)
                       (snsp-b-expression binding))
                  (value_eq (snse-e-meaning event)
                    (snsp-m-address (snsp-b-meaning binding))))) 1 0))

  (defn snse-address-in? (address addresses)
    (if (eq (len addresses) 0) 0
      (if (value_eq address (head addresses)) 1
        (snse-address-in? address (tail addresses)))))
  (defn snse-binding-witnesses-loop (events binding out)
    (if (eq (len events) 0) (reverse out)
      (do
        (let event (head events))
        (let witness (snse-e-witness event))
        (snse-binding-witnesses-loop (tail events) binding
          (if (and (eq (snse-event-for-binding? event binding) 1)
                   (eq (snse-address-in? witness out) 0))
            (cons witness out) out)))))
  (defn snse-binding-witnesses (events binding)
    (snse-binding-witnesses-loop events binding (empty)))
  (defn snse-max-choice-point (events binding witness best)
    (if (eq (len events) 0) best
      (do
        (let event (head events))
        (snse-max-choice-point (tail events) binding witness
          (if (and (eq (snse-event-for-binding? event binding) 1)
                   (and (value_eq witness (snse-e-witness event))
                        (gt (snse-e-choice-point event) best)))
            (snse-e-choice-point event) best)))))
  (defn snse-latest-witness-events (events binding witness point)
    (if (eq (len events) 0) (empty)
      (do
        (let event (head events))
        (if (and (eq (snse-event-for-binding? event binding) 1)
                 (and (value_eq witness (snse-e-witness event))
                      (eq point (snse-e-choice-point event))))
          (cons event (snse-latest-witness-events
            (tail events) binding witness point))
          (snse-latest-witness-events (tail events) binding witness point)))))
  (defn snse-all-same-stance? (events stance)
    (if (eq (len events) 0) 1
      (if (value_eq stance (snse-e-stance (head events)))
        (snse-all-same-stance? (tail events) stance) 0)))
  ; witness view = latest point, events at point, stance or empty, conflict.
  (defn snse-witness-view (events binding witness)
    (do
      (let point (snse-max-choice-point events binding witness -1))
      (let latest (if (lt point 0) (empty)
        (snse-latest-witness-events events binding witness point)))
      (if (eq (len latest) 0) (list -1 (empty) (empty) 0)
        (do
          (let stance (snse-e-stance (head latest)))
          (if (eq (snse-all-same-stance? (tail latest) stance) 1)
            (list point latest stance 0)
            (list point latest (empty) 1))))))

  ; summary = support, release, revise, conflict, distinct witnesses,
  ; support floor, state.
  (defn snse-summary-loop
    (events binding witnesses support release revise conflicts)
    (if (eq (len witnesses) 0)
      (list support release revise conflicts)
      (do
        (let view (snse-witness-view events binding (head witnesses)))
        (let stance (nth view 2))
        (snse-summary-loop events binding (tail witnesses)
          (add support (if (and (eq (nth view 3) 0)
                                (value_eq stance (snse-support))) 1 0))
          (add release (if (and (eq (nth view 3) 0)
                                (value_eq stance (snse-release))) 1 0))
          (add revise (if (and (eq (nth view 3) 0)
                               (value_eq stance (snse-revise))) 1 0))
          (add conflicts (nth view 3))))))
  (defn snse-state (counts minimum)
    (do
      (let support (nth counts 0))
      (let release (nth counts 1))
      (let revise (nth counts 2))
      (let conflicts (nth counts 3))
      (if (gt conflicts 0) "witness-choice-conflict"
        (if (gt revise 0) "revision-offered"
          (if (and (ge support minimum) (eq release 0)) "supported"
            (if (and (gt support 0) (gt release 0)) "contested"
              (if (and (eq support 0) (gt release 0))
                "released-by-witnesses" "open")))))))
  (defn snse-summary (events binding minimum)
    (do
      (let witnesses (snse-binding-witnesses events binding))
      (let counts (snse-summary-loop events binding witnesses 0 0 0 0))
      (list (nth counts 0) (nth counts 1) (nth counts 2) (nth counts 3)
        (len witnesses) minimum (snse-state counts minimum))))
  (defn snse-s-support (summary) (nth summary 0))
  (defn snse-s-release (summary) (nth summary 1))
  (defn snse-s-revise (summary) (nth summary 2))
  (defn snse-s-conflicts (summary) (nth summary 3))
  (defn snse-s-witnesses (summary) (nth summary 4))
  (defn snse-s-minimum (summary) (nth summary 5))
  (defn snse-s-state (summary) (nth summary 6))

  ; A revision is two visible events at one choice point: release the old
  ; relation and support the new. Neither binding disappears.
  (defn snse-revision
    (witness old-binding new-binding evidence choice-point)
    (list
      (snse-event witness (snsp-b-expression old-binding)
        (snsp-m-address (snsp-b-meaning old-binding))
        (snse-release) evidence choice-point)
      (snse-event witness (snsp-b-expression new-binding)
        (snsp-m-address (snsp-b-meaning new-binding))
        (snse-support) evidence choice-point)))

  ; Evidence joins the same directed graph without flattening the event:
  ; witness -> event, event -> expression, and event -stance-> meaning.
  (defn snse-event-edges (event)
    (if (eq (snse-event-valid? event) 0) (empty)
      (list
        (snsp-edge (snse-e-witness event) (snsf-structure-address 14)
          (snse-e-address event) 0)
        (snsp-edge (snse-e-address event) (snsf-structure-address 14)
          (snse-e-expression event) 1)
        (snsp-edge (snse-e-address event) (snse-e-stance event)
          (snse-e-meaning event) 2))))
  (defn snse-events-graph (events)
    (if (eq (len events) 0) (empty)
      (snsp-unique-edges
        (append (snse-event-edges (head events))
          (snse-events-graph (tail events))))))

  0)
