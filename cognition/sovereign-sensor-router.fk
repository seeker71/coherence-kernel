; sovereign-sensor-router.fk — inquiry-relative, encoding-neutral channel choice.
; witnessed: 2026-07-23 -> direct-source witness [101, 11, 0, 0, 201]
;
; A channel is (node kind plane consent fresh independent decoder-success cost).
; kind: 1 camera, 2 microphone, 3 motion, 4 environment, 5 opaque.
; plane is the inquiry plane it currently serves; zero means not yet known.
; Opaque streams may be researched from observable features.  They do not gain
; epistemic authority from opacity.  Consent and freshness are admission rules.

(do
  (defn ssr-admitted? (c)
    (if (eq (nth c 3) 1) (if (eq (nth c 4) 1) 1 0) 0))

  (defn ssr-plane-fit (c wanted)
    (if (eq (nth c 2) wanted) 1 0))

  ; Fit 8, independence 4, observed decoder success 0..3, minus cost.
  ; A candidate with no known decoder can still win after observed transfer,
  ; but never receives invented success here.
  (defn ssr-score (c wanted)
    (if (eq (ssr-admitted? c) 0) 0
      (sub
        (add
          (add (if (eq (ssr-plane-fit c wanted) 1) 8 0)
               (if (eq (nth c 5) 1) 4 0))
          (nth c 6))
        (nth c 7))))

  (defn ssr-better (a b wanted)
    (if (gt (ssr-score a wanted) (ssr-score b wanted)) a b))

  (defn ssr-select (channels wanted)
    (if (eq (len channels) 0)
      (nothing)
      (if (eq (len channels) 1)
        (head channels)
        (ssr-better (head channels) (ssr-select (tail channels) wanted) wanted))))

  ; Spatial status: 1 only when two admitted, fresh, independent channels of
  ; the requested kind exist.  A synthesized second view is not a baseline.
  (defn ssr-spatial-pair? (a b kind)
    (if (eq (ssr-admitted? a) 1)
      (if (eq (ssr-admitted? b) 1)
        (if (eq (nth a 1) kind)
          (if (eq (nth b 1) kind)
            (if (eq (nth a 5) 1)
              (if (eq (nth b 5) 1)
                (if (eq (nth a 0) (nth b 0)) 0 1)
                0)
              0)
            0)
          0)
        0)
      0))

  (defn sovereign-sensor-router-witness ()
    (do
      (let mac-camera (list 101 1 7 1 1 1 3 1))
      (let desk-derived (list 102 1 7 1 1 0 3 1))
      (let mac-mic (list 201 2 8 1 1 1 3 1))
      (let android-motion-opaque (list 301 5 7 1 1 1 0 1))
      (let stale-channel (list 401 1 7 1 0 1 3 0))
      (list
        (nth (ssr-select (list desk-derived mac-camera android-motion-opaque stale-channel) 7) 0)
        (ssr-score android-motion-opaque 7)
        (ssr-spatial-pair? mac-camera desk-derived 1)
        (ssr-spatial-pair? mac-camera stale-channel 1)
        (nth (ssr-select (list mac-camera mac-mic) 8) 0))))

  (sovereign-sensor-router-witness))
