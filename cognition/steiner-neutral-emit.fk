; steiner-neutral-emit.fk — a TEMPLATE filled from the graph, checked by running
; it. Named accurately after Urs's correction; the first header said "the graph
; WRITES CODE" and that was an overclaim.
;
; The first PL projection emitted `(3045001001, 3045005001, ...)` — a tuple of
; numbers wearing Python's punctuation. Urs: "for PL we don't need just a data
; projection, we need it to write code, otherwise PL is useless." He is right.
; A projection nobody can execute is a data dump, and calling it a programming-
; language projection makes the graph look more capable than it is.
;
; WHAT THIS CELL ACTUALLY IS, said plainly
;   The Python below is a template I wrote by hand; the graph supplies the fact
;   table and the constants. That is genuinely more useful than a bare tuple
;   dump — the module has working query functions and runs — but the BODY did
;   not write this Python and has no model of it. The round-trip proves the
;   template is faithful to the graph; it proves nothing about the body
;   understanding Python, and using an interpreter to decide correctness is
;   exactly what lets a generator skip having semantics at all.
;   cognition/steiner-py-native.fk is the attempt at the real thing.
;
; So this cell emits a MODULE: the facts, the relation constants, and query
; functions over them — members_of, state_of, senses_in, requires_of,
; mediator_of — plus a main that prints a fingerprint. The same graph emits the
; same module in Form.
;
; THE PROOF, which is the point
;   Emitting code that looks plausible is exactly the failure the last cell was
;   corrected for: prose that had the SHAPE of structure. So the band does not
;   read the generated source and nod. It WRITES the module to disk, RUNS it
;   with host-exec, and compares the fingerprint the running program prints
;   against the same four answers computed in Form from the graph directly.
;
;   If the emitter drifts from the graph, two independent computations of the
;   same four numbers stop matching and the band goes red. That is the PL
;   equivalent of "render this in German" — the one-line test whose absence let
;   an English-only cell pass review for three turns.
;
; PROOF LANE: host-exec and `nothing` are fkwu-only, so the running half is
; FOURTH-ARM ONLY and says so. The EMITTERS themselves are pure string
; construction over the graph and cross four-way in the structure band.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk cognition/steiner-neutral-kernel.fk

(do
  (defn sne-nl () "\n")

  ;; ── the graph's own answers, computed in Form ───────────────────
  ;; These are what the generated program has to agree with.
  (defn sne-members-loop (fs c n)
    (if (eq (len fs) 0) n
      (add (if (eq (stn-f-subject (head fs)) c)
             (if (eq (stn-f-relation (head fs)) (stn-has-member)) 1 0) 0)
           (sne-members-loop (tail fs) c n))))
  (defn sne-members-of (c) (sne-members-loop (stn-facts) c 0))

  (defn sne-state-loop (fs m)
    (if (eq (len fs) 0) 0
      (if (eq (stn-f-subject (head fs)) m)
        (if (eq (stn-f-relation (head fs)) (stn-in-state))
          (stn-f-object (head fs))
          (sne-state-loop (tail fs) m))
        (sne-state-loop (tail fs) m))))
  (defn sne-state-of (m) (sne-state-loop (stn-facts) m))

  (defn sne-mediator-loop (fs x)
    (if (eq (len fs) 0) 0
      (if (eq (stn-f-object (head fs)) x)
        (if (eq (stn-f-relation (head fs)) (stn-mediates))
          (stn-f-subject (head fs))
          (sne-mediator-loop (tail fs) x))
        (sne-mediator-loop (tail fs) x))))
  (defn sne-mediator-of (x) (sne-mediator-loop (stn-facts) x))

  ;; the four answers, folded into one line — the fingerprint both sides print
  (defn sne-fingerprint ()
    (stn-cat (list
      (int_to_str (sne-members-of (stn-threefold-soul))) " "
      (int_to_str (sne-state-of (stn-willing))) " "
      (int_to_str (stn-senses-in (stn-g-other-being))) " "
      (int_to_str (sne-mediator-of (stn-polarity))))))

  ;; ── emit: the fact table, as a language's list literal ──────────
  (defn sne-py-facts-loop (fs)
    (if (eq (len fs) 0) ""
      (stn-cat (list "    " (stn-render-python (head fs)) ","
                     (sne-nl) (sne-py-facts-loop (tail fs))))))
  (defn sne-form-facts-loop (fs)
    (if (eq (len fs) 0) ""
      (stn-cat (list "    " (stn-render-form (head fs))
                     (sne-nl) (sne-form-facts-loop (tail fs))))))

  ;; ── emit: a runnable Python module ──────────────────────────────
  (defn sne-emit-python ()
    (stn-cat (list
"# generated from cognition/steiner-neutral-kernel.fk - do not edit" (sne-nl)
"# every identity below is a number; no English or German reaches this file." (sne-nl)
"FACTS = [" (sne-nl)
(sne-py-facts-loop (stn-facts))
"]" (sne-nl)
"HAS_MEMBER = "  (int_to_str (stn-has-member))  (sne-nl)
"IN_STATE = "    (int_to_str (stn-in-state))    (sne-nl)
"IN_GROUP = "    (int_to_str (stn-in-group))    (sne-nl)
"MEDIATES = "    (int_to_str (stn-mediates))    (sne-nl)
"REQUIRES = "    (int_to_str (stn-requires))    (sne-nl)
"THREEFOLD_SOUL = " (int_to_str (stn-threefold-soul)) (sne-nl)
"WILLING = "     (int_to_str (stn-willing))     (sne-nl)
"OTHER_BEING = " (int_to_str (stn-g-other-being)) (sne-nl)
"POLARITY = "    (int_to_str (stn-polarity))    (sne-nl)
(sne-nl)
"def members_of(concept):" (sne-nl)
"    rows = [f for f in FACTS if f[0] == concept and f[1] == HAS_MEMBER]" (sne-nl)
"    return [f[2] for f in sorted(rows, key=lambda f: f[4])]" (sne-nl)
(sne-nl)
"def state_of(member):" (sne-nl)
"    for f in FACTS:" (sne-nl)
"        if f[0] == member and f[1] == IN_STATE:" (sne-nl)
"            return f[2]" (sne-nl)
"    return None" (sne-nl)
(sne-nl)
"def senses_in(group):" (sne-nl)
"    rows = [f for f in FACTS if f[2] == group and f[1] == IN_GROUP]" (sne-nl)
"    return [f[0] for f in sorted(rows, key=lambda f: f[4])]" (sne-nl)
(sne-nl)
"def requires_of(concept):" (sne-nl)
"    return [f[2] for f in FACTS if f[0] == concept and f[1] == REQUIRES]" (sne-nl)
(sne-nl)
"def mediator_of(x):" (sne-nl)
"    for f in FACTS:" (sne-nl)
"        if f[2] == x and f[1] == MEDIATES:" (sne-nl)
"            return f[0]" (sne-nl)
"    return None" (sne-nl)
(sne-nl)
"if __name__ == '__main__':" (sne-nl)
"    print(len(members_of(THREEFOLD_SOUL)), state_of(WILLING), len(senses_in(OTHER_BEING)), mediator_of(POLARITY))" (sne-nl))))

  ;; ── emit: the same module in Form ───────────────────────────────
  (defn sne-emit-form ()
    (stn-cat (list
"; generated from cognition/steiner-neutral-kernel.fk - do not edit" (sne-nl)
"; a generated module stands on its own: without this line the emitted file" (sne-nl)
"; cannot resolve int_to_str and answers nothing. The round-trip found that;" (sne-nl)
"; reading the source would not have." (sne-nl)
"; preludes: form-stdlib/core.fk" (sne-nl)
"(do" (sne-nl)
"  (defn sg-facts () (list" (sne-nl)
(sne-form-facts-loop (stn-facts))
"  ))" (sne-nl)
"  (defn sg-has-member () " (int_to_str (stn-has-member)) ")" (sne-nl)
"  (defn sg-in-state () "   (int_to_str (stn-in-state))   ")" (sne-nl)
"  (defn sg-in-group () "   (int_to_str (stn-in-group))   ")" (sne-nl)
"  (defn sg-mediates () "   (int_to_str (stn-mediates))   ")" (sne-nl)
"  (defn sg-members-loop (fs c)" (sne-nl)
"    (if (eq (len fs) 0) 0" (sne-nl)
"      (add (if (eq (nth (head fs) 0) c) (if (eq (nth (head fs) 1) (sg-has-member)) 1 0) 0)" (sne-nl)
"           (sg-members-loop (tail fs) c))))" (sne-nl)
"  (defn sg-members-of (c) (sg-members-loop (sg-facts) c))" (sne-nl)
"  (defn sg-state-loop (fs m)" (sne-nl)
"    (if (eq (len fs) 0) 0" (sne-nl)
"      (if (eq (nth (head fs) 0) m)" (sne-nl)
"        (if (eq (nth (head fs) 1) (sg-in-state)) (nth (head fs) 2) (sg-state-loop (tail fs) m))" (sne-nl)
"        (sg-state-loop (tail fs) m))))" (sne-nl)
"  (defn sg-state-of (m) (sg-state-loop (sg-facts) m))" (sne-nl)
"  (defn sg-group-loop (fs g)" (sne-nl)
"    (if (eq (len fs) 0) 0" (sne-nl)
"      (add (if (eq (nth (head fs) 2) g) (if (eq (nth (head fs) 1) (sg-in-group)) 1 0) 0)" (sne-nl)
"           (sg-group-loop (tail fs) g))))" (sne-nl)
"  (defn sg-senses-in (g) (sg-group-loop (sg-facts) g))" (sne-nl)
"  (defn sg-med-loop (fs x)" (sne-nl)
"    (if (eq (len fs) 0) 0" (sne-nl)
"      (if (eq (nth (head fs) 2) x)" (sne-nl)
"        (if (eq (nth (head fs) 1) (sg-mediates)) (nth (head fs) 0) (sg-med-loop (tail fs) x))" (sne-nl)
"        (sg-med-loop (tail fs) x))))" (sne-nl)
"  (defn sg-mediator-of (x) (sg-med-loop (sg-facts) x))" (sne-nl)
"  (print_str (str_concat (int_to_str (sg-members-of " (int_to_str (stn-threefold-soul)) "))" (sne-nl)
"  (str_concat \" \" (str_concat (int_to_str (sg-state-of " (int_to_str (stn-willing)) "))" (sne-nl)
"  (str_concat \" \" (str_concat (int_to_str (sg-senses-in " (int_to_str (stn-g-other-being)) "))" (sne-nl)
"  (str_concat \" \" (int_to_str (sg-mediator-of " (int_to_str (stn-polarity)) ")))))))))" (sne-nl)
"  0)" (sne-nl))))

  (defn sne-render-code (language)
    (if (str_eq language "python") (sne-emit-python)
      (if (str_eq language "form") (sne-emit-form) (nothing))))

  ;; ── write it, run it, compare ───────────────────────────────────
  (defn sne-dir () (do (fs_mkdir (str_concat (temp_dir) "/steiner-emit"))
                       (str_concat (temp_dir) "/steiner-emit")))
  (defn sne-path (n) (str_concat (sne-dir) (str_concat "/" n)))

  ;; run the emitted PYTHON and read back what the program itself printed
  (defn sne-run-python ()
    (do (let p (sne-path "steiner_graph.py"))
        (write_file p (sne-emit-python))
        (host-exec (str_concat "python3 " (str_concat p " 2>/dev/null | tr -d '\\n'")) "")))

  ;; run the emitted FORM through the same kernel that generated it
  (defn sne-run-form ()
    (do (let p (sne-path "steiner_graph.fk"))
        (write_file p (sne-emit-form))
        (host-exec (str_concat "./fkwu --src " (str_concat p " 2>/dev/null | head -1 | tr -d '\\n'")) "")))

  ;; THE ROUND TRIP: graph -> code -> execution -> the same four answers
  (defn sne-python-agrees? () (if (str_eq (sne-run-python) (sne-fingerprint)) 1 0))
  (defn sne-form-agrees? ()   (if (str_eq (sne-run-form) (sne-fingerprint)) 1 0))

  (defn sne-check ()
    (add (if (gt (str_len (sne-emit-python)) 900) 1 0)
    (add (if (gt (str_len (sne-emit-form)) 900) 2 0)
    (add (if (nothing? (sne-render-code "rust")) 4 0)
    (add (if (gt (str_len (sne-fingerprint)) 12) 8 0)
    (add (if (eq (sne-python-agrees?) 1) 16 0)
    (add (if (eq (sne-form-agrees?) 1) 32 0)
         0)))))))

  0)
