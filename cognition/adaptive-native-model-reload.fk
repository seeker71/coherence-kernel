; adaptive-native-model-reload.fk — read-only fresh-process witness of state.
; Result: [parameter-count, checkpoint-bytes, heldout-error, prediction-x4,
;          prediction-x5, structured-state-valid]
; witnessed: 2026-07-21 -> [4, 18, 0, 69, 131, 1]

(do
  (defn aw-c (s i) (sub (str_byte_at s (add 10 (mul i 2))) 48))
  (defn aw-basis (i x)
    (if (eq i 1) x
      (if (eq i 2) (div (mul x (sub x 1)) 2)
        (div (mul (mul x (sub x 1)) (sub x 2)) 6))))
  (defn aw-predict (s n x)
    (add (aw-c s 0)
      (add (if (gt n 1) (mul (aw-c s 1) (aw-basis 1 x)) 0)
        (add (if (gt n 2) (mul (aw-c s 2) (aw-basis 2 x)) 0)
             (if (gt n 3) (mul (aw-c s 3) (aw-basis 3 x)) 0)))))
  (defn aw-abs (x) (if (lt x 0) (sub 0 x) x))

  (let state (read_file ".form-native-adaptive-model.state"))
  (let n (div (sub (str_len state) 10) 2))
  (let p4 (aw-predict state n 4))
  (let p5 (aw-predict state n 5))
  (let error (add (aw-abs (sub 69 p4)) (aw-abs (sub 131 p5))))
  (let valid-header (eq (str_byte_at state 0) 110))
  (let valid-count (eq n 4))
  (list n (str_len state) error p4 p5
    (if valid-header (if valid-count 1 0) 0)))
