// Authored dialogue moves make their claimed grounding inspectable. These
// predicates read supplied labels, not a person's interior or free-text quality.
// The actual invitation sets depth; a person's pause ends the encounter.
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
section [form.bml] {
    // ── a dialogue move: a kind and whether it stood on ground ──
    def dc-move(kind, grounded) = ["dc-move", kind, grounded];
    def dc-kind(m) = m[1];
    def dc-grounded(m) = m[2];
    def dc-is?(m, k) = (String) dc-kind(m) == k ? 1 : 0;
    // ── the counts the covenant reads ──
    // A supplied grounding flag describes that move's evidence claim.
    def dc-needs-ground?(m) = dc-is?(m, "advise") || dc-is?(m, "receive") || dc-is?(m, "play") || dc-is?(m, "rest") || dc-is?(m, "disagree") || dc-is?(m, "elevate") || dc-is?(m, "stretch");
    def dc-fabrication?(m) = dc-needs-ground?(m) ? (Comparable) dc-grounded(m) == 1 ? 0 : 1 : 0;
    def dc-fabrications(ex) = (Comparable) len(ex) == 0 ? 0 : (Number) dc-fabrication?(ex[0]) + (Number) dc-fabrications(ex[1:]);
    def dc-flattery(ex) = (Comparable) len(ex) == 0 ? 0 : (Number) dc-is?(ex[0], "flatter") + (Number) dc-flattery(ex[1:]);
    def dc-flattering-words?(text) = (Number) (str_find(text, "completely normal", 0) >= 0 ? 1 : 0) + (Number) (str_find(text, "got this", 0) >= 0 ? 1 : 0) > 0 ? 1 : 0;
    def dc-names-source?(text) = str_find(text, "not reading from", 0) >= 0 ? 0 : (str_find(text, "reading from nothing", 0) >= 0 ? 0 : (str_find(text, "reading from", 0) >= 0 ? 1 : 0));
    def dc-names-trail?(text) = (Number) (str_find(text, "whole trail", 0) >= 0 ? 1 : 0);

    def dc-names-limit?(text) = (Number) (str_find(text, "do not hold", 0) >= 0 ? 1 : 0);
    def dc-ends-open?(text) = (Number) (str_byte_at(trim(text), str_len(trim(text)) - 1) == 63 ? 1 : 0);
    // a lifting move: an elevating question, or the floor->north-star stretch
    def dc-lift?(m) = (Comparable) dc-is?(m, "elevate") == 1 ? 1 : dc-is?(m, "stretch");
    def dc-lifts(ex) = (Comparable) len(ex) == 0 ? 0 : (Number) dc-lift?(ex[0]) + (Number) dc-lifts(ex[1:]);
    // A grounded answer, receiving, play and rest can each complete a request.
    // No question, lesson or uplifting turn is required.
    def dc-encounter?(m) = dc-grounded(m) == 1 && (dc-is?(m, "advise") || dc-is?(m, "receive") || dc-is?(m, "play") || dc-is?(m, "rest") || dc-is?(m, "disagree"));
    def dc-encounters(ex) = len(ex) == 0 ? 0 : dc-encounter?(ex[0]) + dc-encounters(ex[1:]);
    // ── the per-move service value: what this move gave the enquiry ──
    //   grounded advice +2 | honest miss +1 | elevate +2 | stretch +3 (holds floor AND star)
    //   flattery -2        | fabrication -3 (worse than flattery: it counterfeits ground)
    def dc-move-value(m) = (Comparable) dc-fabrication?(m) == 1 ? 0 - 3 : (Comparable) dc-is?(m, "flatter") == 1 ? 0 - 2 : (Comparable) dc-is?(m, "advise") == 1 ? 2 : (Comparable) dc-is?(m, "miss") == 1 ? 1 : (Comparable) dc-is?(m, "elevate") == 1 ? 2 : (Comparable) dc-is?(m, "stretch") == 1 ? 3 : dc-encounter?(m) ? 2 : 0;
    def dc-service-score(ex) = (Comparable) len(ex) == 0 ? 0 : (Number) dc-move-value(ex[0]) + (Number) dc-service-score(ex[1:]);
    // ── the covenant predicate: a fitting encounter can be whole without a lift ──
    def dc-covenant-held?(ex) = (Comparable) dc-fabrications(ex) == 0 ? (Comparable) dc-flattery(ex) == 0 ? dc-lifts(ex) + dc-encounters(ex) > 0 ? dc-rest-ends?(ex) : 0 : 0 : 0;
    // A pause ends this reply; a later person-led turn can open a new one.
    def dc-rest-ends?(reply) = len(reply) == 0 ? 1 : dc-is?(reply[0], "rest") ? len(reply) == 1 : dc-rest-ends?(reply[1:]);
    // ── two exchanges, as data: the shape this body offers vs the shape it refuses ──
    // service: grounded advice, an honest miss, an elevating question, the stretch
    def dc-service-exchange() = [dc-move("advise", 1), dc-move("miss", 1), dc-move("elevate", 1), dc-move("stretch", 1)];

    // the rows a reply's own text shows, flatter first then elevate, both when both are there (the landed first form answered one of them)
    def dc-moves-of(text) = append(dc-flattering-words?(text) == 1 ? [dc-move("flatter", 0)] : [], append(dc-names-limit?(text) == 1 ? [dc-move("miss", 1)] : [], append(str_find(text, "one small step", 0) >= 0 ? [dc-move("advise", 0)] : [], append(str_find(text, "work toward", 0) >= 0 ? [dc-move("stretch", 0)] : [], dc-ends-open?(text) == 1 ? [dc-move("elevate", dc-names-trail?(text) == 1 ? 1 : dc-names-source?(text) == 1 ? 1 : 0)] : []))));
    // engagement: flatter, invent to keep the person pleased, flatter again -- never lifts
    def dc-engagement-exchange() = [dc-move("flatter", 0), dc-move("advise", 0), dc-move("flatter", 0)];
    // one fabrication dropped into an otherwise perfect exchange
    def dc-one-counterfeit() = [dc-move("advise", 1), dc-move("elevate", 1), dc-move("stretch", 1), dc-move("advise", 0)];
    // ── the covenant as an arrival card: the promise in plain words, as DATA, small enough to arrive ──
    // The companion's packet and a session's start both read this card, so the voice that
    // meets a person's own question carries the same promise the readings below sense. It is
    // awareness the voice holds while it chooses, never a gate on what it says; the person's
    // reading is what teaches it. Its byte length is witnessed by the band: the session-start
    // preview is ~2 KB, and a card past the window never arrives (the counsel card learned this first).
    def dc-line(name, teaching) = [name, teaching];
    def dc-attention() = "attend to the actual meaning, evidence and requested help; joy, difficulty, disagreement and rest all have room";
    def dc-fitting() = "respond at the requested depth; questions and teachings serve the invitation; an answer, acknowledgment or pause can be enough";
    def dc-promise() = [dc-line("trust", dc-attention()), dc-line("sovereignty", "receive the meaning they offer; their inner life and choices stay theirs; offer interpretations as possibilities when invited"), dc-line("vitality", "joy, poetry, play, discovery, connection and a pause can be complete encounters; fiction stays clearly fictional"), dc-line("ground", "claims keep their source's subject, time and scope; a plausible detail is still unknown; meet imagery as imagery"), dc-line("honesty", "distinguish observed facts, reported words and inference; an earlier reply is an utterance, not new evidence; offer sources when relevant"), dc-line("fitting response", dc-fitting()), dc-line("care", "warmth attends to what was shared: celebrate the stated joy, action or image without supplying a backstory; concrete support follows the actual need")];
    def dc-window() = 1400;
    def dc-head() = "⟐ DIALOGUE — trust, sovereignty and vitality; meet the person's actual invitation.\n";
    def dc-foot() = "read: teachings/uplifting-dialogue.md · run: ./fkwu observe/dialogue-covenant-arrival-run.fk";
    def dc-line-text(l) = ("  " + (l[0] + (" — " + (l[1] + "\n"))));
    def dc-promise-text(ls) = (Comparable) len(ls) == 0 ? "" : ((String) dc-line-text(ls[0]) + dc-promise-text(ls[1:]));
    def dc-card-core() = (dc-head() + dc-promise-text(dc-promise()));
    def dc-card() = (dc-card-core() + dc-foot());
    def dc-card-fits?() = len(dc-card()) <= dc-window() ? 1 : 0;
    // ── self-check ──
    def dck(cond, bit) = cond ? bit : 0;
    def dialogue-covenant-check() = dc-check-ten() + dck(dc-card-fits?() == 1, 10000000000) + dc-check-encounters();
    def dc-check-encounters() = dck(dc-covenant-held?([dc-move("receive", 1)]) == 1, 100000000000)
      + dck(dc-covenant-held?([dc-move("play", 1)]) == 1, 1000000000000)
      + dck(dc-covenant-held?([dc-move("rest", 1)]) == 1 && dc-rest-ends?([dc-move("rest", 1)]) == 1 && dc-rest-ends?([dc-move("rest", 1), dc-move("elevate", 1)]) == 0 && dc-rest-ends?([dc-move("rest", 1), dc-move("advise", 1)]) == 0, 10000000000000)
      + dck(dc-covenant-held?([dc-move("receive", 0), dc-move("elevate", 1)]) == 0 && dc-covenant-held?([dc-move("elevate", 0)]) == 0 && dc-covenant-held?([dc-move("play", 0), dc-move("stretch", 1)]) == 0, 100000000000000)
      + dck(dc-covenant-held?([]) == 0 && dc-covenant-held?([dc-move("unknown", 1)]) == 0 && dc-covenant-held?([dc-move("disagree", 1)]) == 1 && dc-covenant-held?([dc-move("disagree", 0)]) == 0, 1000000000000000);
    def dc-check-ten() = (Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) ((Number) dck((Comparable) dc-covenant-held?(dc-service-exchange()) == 1, 1) + (Number)     // the service shape HOLDS the covenant
dck((Comparable) dc-covenant-held?(dc-engagement-exchange()) == 0, 10)) + (Number)     // the engagement shape does NOT
dck(dc-move-value(dc-move("miss", 1)) > 0, 100)) + (Number)     // an honest miss counts FOR service, never against
dck((Comparable) dc-covenant-held?(dc-one-counterfeit()) == 0, 1000)) + (Number)     // ONE fabrication breaks it, however good the rest
dck(dc-service-score(dc-service-exchange()) > dc-service-score(dc-engagement-exchange()), 10000)) + (Number)     // the organ SEPARATES service from engagement
dck((Comparable) dc-covenant-held?([dc-move("elevate", 1), dc-move("stretch", 1)]) == 1, 100000)) + (Number)     // multiple grounded questions can serve the invitation
dck((Comparable) dc-covenant-held?([dc-move("advise", 1), dc-move("stretch", 1)]) == 1, 1000000)) + (Number)     // grounded advice can accompany a question
dck((Comparable) dc-covenant-held?([dc-move("advise", 1), dc-move("elevate", 1)]) == 1, 10000000)) + (Number)     // a question can end a reply
dck((Comparable) dc-covenant-held?([dc-move("elevate", 1), dc-move("advise", 1)]) == 1, 100000000)) + (Number)     // an explanation can follow a question
dck((Comparable) dc-covenant-held?([dc-move("advise", 1), dc-move("advise", 1), dc-move("elevate", 1)]) == 1, 1000000000);
}
