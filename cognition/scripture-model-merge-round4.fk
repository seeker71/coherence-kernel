; scripture-model-merge-round4.fk — merge the v3 model with the round-4
; coverage/evidence witness. More support does not erase prior opposition.
; Every public observation starts: [nothing, 0, 1, node-id, ...].
; witnessed: 2026-07-21 -> pre-ground and post-ground both
; [-8999999999999999999,0,1,4002,2,5,4,10,3,5,1227604,109,1,1]
(do
  (defn sm4-match (s i p j) (if (ge j (str_len p)) 1
    (if (ge (add i j) (str_len s)) 0
      (if (eq (str_byte_at s (add i j)) (str_byte_at p j))
        (sm4-match s i p (add j 1)) 0))))
  (defn sm4-find (s p i) (if (gt (add i (str_len p)) (str_len s)) -1
    (if (eq (sm4-match s i p 0) 1) i (sm4-find s p (add i 1)))))
  (defn sm4-read-int (s i n) (if (ge i (str_len s)) n
    (do (let b (str_byte_at s i))
      (if (and (ge b 48) (le b 57))
        (sm4-read-int s (add i 1) (add (mul n 10) (sub b 48))) n))))
  (defn sm4-after (s p) (do (let i (sm4-find s p 0))
    (if (lt i 0) -1 (sm4-read-int s (add i (str_len p)) 0))))
  (defn sm4-hash-loop (s i h) (if (ge i (str_len s)) h
    (sm4-hash-loop s (add i 1)
      (mod (add h (mul (add i 1) (str_byte_at s i))) 1000000007))))
  (defn sm4-hash (s) (sm4-hash-loop s 0 0))
  (defn sm4-int (n) (if (lt n 10) (byte_to_str (add 48 n))
    (str_concat (sm4-int (div n 10)) (byte_to_str (add 48 (mod n 10))))))
  (let prior (read_file ".form-scripture-model-v3.state"))
  (let coverage (read_file ".form-scripture-coverage-v4.state"))
  (let bible (sm4-after coverage "bible="))
  (let sanskrit (sm4-after coverage "sanskrit="))
  (let support (sm4-after coverage "concept-support="))
  (let fingerprint (sm4-hash (str_concat prior coverage)))
  (let state0 (str_concat "scripture-model-v4\nparents=2\nnodes=5\ntension=4\nbible=" (sm4-int bible)))
  (let state1 (str_concat state0 (str_concat "\nsanskrit=" (sm4-int sanskrit))))
  (let state2 (str_concat state1 (str_concat "\nnew-support=" (sm4-int support))))
  (let state (str_concat state2 (str_concat "\nparent-content-hash="
    (str_concat (sm4-int fingerprint) "\n"))))
  (let saved (write_file ".form-scripture-model-v4.state" state))
  (let reread (read_file ".form-scripture-model-v4.state"))
  (let identity (if (eq (sm4-hash state) (sm4-hash reread)) 1 0))
  (let success (if (eq bible 10)
    (if (eq sanskrit 3)
      (if (eq support 5) (if (eq identity 1) 1 0) 0) 0) 0))
  ; [nothing, rejected/opposed, supported, model-node, parents, concepts,
  ;  retained tensions, Bible works, Sanskrit works, new support,
  ;  parent fingerprint, bytes, identity, success]
  (list (nothing) 0 1 4002 2 5 4 bible sanskrit support fingerprint saved identity success))
