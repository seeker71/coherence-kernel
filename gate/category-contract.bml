// Native Form lens for category slots and aliases across the proof siblings.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk
section [form.bml] {
    class FormCategoryContractGate {
        thought category-contract-pattern = ["one-numbering-three-witnesses", "contract-through-json-fk", "sources-through-the-tree-walk", "conflict-before-compare", "twin-voice-byte-for-byte"];

        def ccg-name() = "category-contract";
        def ccg-contract() = "form/category-contract.json";
        def ccg-go-dir() = "form/form-kernel-go";
        def ccg-rust-dir() = "form/form-kernel-rust/src";
        def ccg-ts-dir() = "form/form-kernel-ts/src";
        def ccg-kernel-ts() = "form/form-kernel-ts/src/kernel.ts";
        def ccg-alias(from, to) = [from, to];
        def ccg-aliases() = [ccg-alias("FN_DEF", "FNDEF"), ccg-alias("FN_CALL", "FNCALL"), ccg-alias("LIST_LOCAL", "LIST"), ccg-alias("RESOLVE", "FIELD_RESOLVE")];
        def ccg-alias-of(name) {
            let row = ccg-lookup(ccg-aliases(), name);
            (Comparable) len(row) == 0 ? name : row[1];
        }
        // kept sorted: the script prints sorted(missing)
        def ccg-required-sibling() = ["CONSTRUCTOR", "EQUIVALENCE", "FORMAT", "INDUCTIVE", "NUMERIC", "QUOTIENT"];
        def ccg-import-plain() = "import CATEGORY_CONTRACT from \"../../category-contract.json\";";
        def ccg-import-with() = "import CATEGORY_CONTRACT from \"../../category-contract.json\" with { type: \"json\" };";
        def ccg-freeze() = "Object.freeze(CATEGORY_CONTRACT.r_basic)";
        def ccg-when(cond, msg) = cond ? [msg] : [];

        // ---- (name, value) rows ----
        def ccg-row-name(r) = r[0];
        def ccg-row-value(r) = r[1];
        def ccg-lookup(rows, name) = tb-first(rows, r => (String) r[0] == name) ?? [];
        def ccg-has-name?(rows, name) = (Comparable) len(ccg-lookup(rows, name)) == 0 ? 0 : 1;
        def ccg-names(rows) = tb-map(rows, ccg-row-name);
        def ccg-kv(r) = ccg-row-name(r) ++ "=" ++ ccg-row-value(r).str();

        // ---- the contract: list("ok", rows) or list("refused", message) ----
        def ccg-contract-read(text) {
            let root = parse-json(ccg-contract(), text);
            json-object-has?(root, "r_basic") ? ccg-contract-map(json-object-pairs(json-object-get(root, "r_basic"))) : ["refused", "category-contract.json has no non-empty r_basic map"];
        }
        def ccg-contract-map(pairs) {
            (Comparable) len(pairs) == 0 ? ["refused", "category-contract.json has no non-empty r_basic map"]
            : (Comparable) ccg-all-ints?(pairs) == 0 ? ["refused", "category-contract.json r_basic must map names to integers"]
            : ["ok", tb-map(pairs, ccg-pair-row)];
        }
        def ccg-all-ints?(pairs) = (Comparable) len(pairs) == 0 ? 1 : (Comparable) node_type(json-pair-value(pairs[0])) == 1 ? ccg-all-ints?(pairs[1:]) : 0;
        def ccg-pair-row(p) = [json-pair-key(p), node_value(json-pair-value(p))];

        // ---- slot aliasing, by slot ascending; names in the contract's order ----
        def ccg-slot-errors(rows) = ccg-slot-errors-go(lx-int-sort(lx-int-uniq(tb-map(rows, ccg-row-value))), rows, []);
        def ccg-slot-errors-go(slots, rows, acc) {
            (Comparable) len(slots) == 0 ? acc : ccg-slot-errors-one(slots[0], slots[1:], rows, acc);
        }
        def ccg-slot-errors-one(slot, rest, rows, acc) {
            let names = ccg-names(filter(r => (Comparable) ccg-row-value(r) == slot, rows));
            ccg-slot-errors-go(rest, rows, append(acc, ccg-when(len(names) > 1, "category-contract.json: RBasic slot " ++ slot.str() ++ " aliases " ++ tb-join(names, identity, ", "))));
        }

        // ---- Go: \bRBasic([A-Za-z0-9]+)\s+uint32\s*=\s*(\d+) ----
        def ccg-go-consts(text) = ccg-go-consts-go(text, 0, []);
        def ccg-go-consts-go(text, from, acc) {
            let i = str_find(text, "RBasic", from);
            i < 0 ? reverse(acc) : ccg-go-consts-go(text, i + 1, ccg-go-try(text, i, acc));
        }
        def ccg-go-try(text, i, acc) = (Comparable) lx-boundary-before?(text, i) == 0 ? acc : ccg-go-try-name(text, i + 6, lx-span-alnum(text, i + 6), acc);
        def ccg-go-try-name(text, a, j, acc) = (Comparable) j == a ? acc : ccg-go-try-ws(text, a, j, lx-skip-ws(text, j), acc);
        def ccg-go-try-ws(text, a, j, k, acc) {
            (Comparable) k == j ? acc
            : (Comparable) lx-at?(text, k, "uint32") == 0 ? acc
            : ccg-try-eq-value(text, k + 6, ccg-alias-of(lx-camel-upper(substring(text, a, j))), acc);
        }
        // the shared tail \s*=\s*(\d+): conses (name, value) onto acc, or leaves acc
        def ccg-try-eq-value(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            (Comparable) lx-at?(text, m2, "=") == 0 ? acc : ccg-try-digits(text, lx-skip-ws(text, m2 + 1), name, acc);
        }
        def ccg-try-digits(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : cons([name, lx-int-span(text, d, e)], acc);
        }

        // ---- Rust: \bconst\s+(?:RB|RBASIC)_([A-Z0-9_]+)\s*:\s*u32\s*=\s*(\d+) ----
        def ccg-rust-consts(text) = ccg-rust-consts-go(text, 0, []);
        def ccg-rust-consts-go(text, from, acc) {
            let i = str_find(text, "const", from);
            i < 0 ? reverse(acc) : ccg-rust-consts-go(text, i + 1, ccg-rust-try(text, i, acc));
        }
        def ccg-rust-try(text, i, acc) = (Comparable) lx-boundary-before?(text, i) == 0 ? acc : ccg-rust-try-ws(text, i + 5, lx-skip-ws(text, i + 5), acc);
        def ccg-rust-try-ws(text, j, k, acc) {
            (Comparable) k == j ? acc
            : (Comparable) lx-at?(text, k, "RBASIC_") == 1 ? ccg-rust-try-name(text, k + 7, acc)
            : (Comparable) lx-at?(text, k, "RB_") == 1 ? ccg-rust-try-name(text, k + 3, acc)
            : acc;
        }
        def ccg-rust-try-name(text, a, acc) {
            let j = lx-span-upper-word(text, a);
            (Comparable) j == a ? acc : ccg-rust-try-colon(text, a, j, lx-skip-ws(text, j), acc);
        }
        def ccg-rust-try-colon(text, a, j, k, acc) = (Comparable) lx-at?(text, k, ":") == 0 ? acc : ccg-rust-try-u32(text, a, j, lx-skip-ws(text, k + 1), acc);
        def ccg-rust-try-u32(text, a, j, k, acc) = (Comparable) lx-at?(text, k, "u32") == 0 ? acc : ccg-try-eq-value(text, k + 3, ccg-alias-of(substring(text, a, j)), acc);

        // ---- TypeScript aliases: export\s+const\s+RBasic([A-Za-z0-9]+)\s*=\s*RBasic\.([A-Z0-9_]+)\s*; -> (raw-name, target) ----
        def ccg-ts-aliases(text) = ccg-ts-go(text, 0, []);
        def ccg-ts-go(text, from, acc) {
            let i = str_find(text, "export", from);
            i < 0 ? reverse(acc) : ccg-ts-go(text, i + 1, ccg-ts-try(text, i + 6, acc));
        }
        def ccg-ts-try(text, j, acc) {
            let k = lx-skip-ws(text, j);
            (Comparable) k == j ? acc : (Comparable) lx-at?(text, k, "const") == 0 ? acc : ccg-ts-try-rbasic(text, k + 5, acc);
        }
        def ccg-ts-try-rbasic(text, j, acc) {
            let k = lx-skip-ws(text, j);
            (Comparable) k == j ? acc : (Comparable) lx-at?(text, k, "RBasic") == 0 ? acc : ccg-ts-try-name(text, k + 6, acc);
        }
        def ccg-ts-try-name(text, a, acc) {
            let j = lx-span-alnum(text, a);
            (Comparable) j == a ? acc : ccg-ts-try-eq(text, a, j, lx-skip-ws(text, j), acc);
        }
        def ccg-ts-try-eq(text, a, j, k, acc) = (Comparable) lx-at?(text, k, "=") == 0 ? acc : ccg-ts-try-target(text, a, j, lx-skip-ws(text, k + 1), acc);
        def ccg-ts-try-target(text, a, j, k, acc) = (Comparable) lx-at?(text, k, "RBasic.") == 0 ? acc : ccg-ts-try-target-name(text, a, j, k + 7, acc);
        def ccg-ts-try-target-name(text, a, j, t, acc) {
            let u = lx-span-upper-word(text, t);
            (Comparable) u == t ? acc : (Comparable) lx-at?(text, lx-skip-ws(text, u), ";") == 0 ? acc : cons([substring(text, a, j), substring(text, t, u)], acc);
        }

        // ---- collecting numeric constants over a kernel's sorted files: list(found, conflicts) ----
        def ccg-relpath(dir, file) = substring(dir, 5, len(dir)) ++ "/" ++ file;
        def ccg-collect(root, dir, suffix, scanner) = ccg-collect-go(root, dir, lx-files-sorted(root ++ dir, suffix), scanner, [], []);
        def ccg-collect-go(root, dir, files, scanner, found, errors) {
            (Comparable) len(files) == 0 ? [found, errors] : ccg-collect-file(root, dir, files[0], files[1:], scanner, found, errors);
        }
        def ccg-collect-file(root, dir, file, rest, scanner, found, errors) {
            let text = lx-host-text(read_file(root ++ dir ++ "/" ++ file));
            let step = ccg-absorb(scanner(text), ccg-relpath(dir, file), found, errors);
            ccg-collect-go(root, dir, rest, scanner, step[0], step[1]);
        }
        def ccg-absorb(rows, rel, found, errors) = (Comparable) len(rows) == 0 ? [found, errors] : ccg-absorb-one(rows[0], rows[1:], rel, found, errors);
        def ccg-absorb-one(r, rest, rel, found, errors) {
            let prev = ccg-lookup(found, ccg-row-name(r));
            ccg-absorb(rest, rel, ccg-put(found, r), append(errors, ccg-conflict(r, prev, rel)));
        }
        def ccg-conflict(r, prev, rel) = (Comparable) len(prev) == 0 ? [] : ccg-when(!((Comparable) ccg-row-value(prev) == ccg-row-value(r)), rel ++ ": " ++ ccg-kv(r) ++ " conflicts with " ++ ccg-row-value(prev).str());
        // the last definition wins, as in the script's dict
        def ccg-put(found, r) = (Comparable) ccg-has-name?(found, ccg-row-name(r)) == 0 ? append(found, [r]) : ccg-replace(found, r);
        def ccg-replace(found, r) = (Comparable) len(found) == 0 ? [] : (String) ccg-row-name(found[0]) == ccg-row-name(r) ? cons(r, found[1:]) : cons(found[0], ccg-replace(found[1:], r));

        // ---- comparing a kernel's constants with the contract, by name ----
        def ccg-compare(impl, found, contract) = append(ccg-compare-names(impl, lx-str-sort(ccg-names(found)), found, contract), ccg-missing-sibling(impl, found));
        def ccg-compare-names(impl, names, found, contract) {
            (Comparable) len(names) == 0 ? []
            : append(ccg-compare-one(impl, ccg-lookup(found, names[0]), ccg-lookup(contract, names[0])), ccg-compare-names(impl, names[1:], found, contract));
        }
        def ccg-compare-one(impl, r, expected) {
            (Comparable) len(expected) == 0 ? [impl ++ ": " ++ ccg-kv(r) ++ " is absent from category-contract.json"]
            : ccg-when(!((Comparable) ccg-row-value(r) == ccg-row-value(expected)), impl ++ ": " ++ ccg-kv(r) ++ ", category-contract.json requires " ++ ccg-row-value(expected).str());
        }
        def ccg-missing-sibling(impl, found) {
            let missing = filter(name => (Comparable) ccg-has-name?(found, name) == 0, ccg-required-sibling());
            ccg-when(len(missing) > 0, impl ++ ": missing sibling constants: " ++ tb-join(missing, identity, ", "));
        }

        // ---- TypeScript: list(errors, distinct alias targets) ----
        def ccg-ts(root, contract, kernel) {
            let head-errors = append(ccg-when(((Comparable) lx-has?(kernel, ccg-import-plain()) == 0) && ((Comparable) lx-has?(kernel, ccg-import-with()) == 0), "TypeScript: kernel.ts does not import the canonical category contract"),
                                     ccg-when((Comparable) lx-has?(kernel, ccg-freeze()) == 0, "TypeScript: RBasic is not projected from category-contract.json"));
            let walk = ccg-ts-files(root, lx-files-sorted(root ++ ccg-ts-dir(), ".ts"), contract, [], []);
            [append(head-errors, walk[0]), len(walk[1])];
        }
        def ccg-ts-files(root, files, contract, errors, targets) {
            (Comparable) len(files) == 0 ? [errors, targets]
            : ccg-ts-file(root, files[0], files[1:], contract, errors, targets);
        }
        def ccg-ts-file(root, file, rest, contract, errors, targets) {
            let text = lx-host-text(read_file(root ++ ccg-ts-dir() ++ "/" ++ file));
            let step = ccg-ts-absorb(ccg-ts-aliases(text), ccg-relpath(ccg-ts-dir(), file), contract, errors, targets);
            ccg-ts-files(root, rest, contract, step[0], step[1]);
        }
        def ccg-ts-absorb(rows, rel, contract, errors, targets) = (Comparable) len(rows) == 0 ? [errors, targets] : ccg-ts-absorb-one(rows[0], rows[1:], rel, contract, errors, targets);
        def ccg-ts-absorb-one(r, rest, rel, contract, errors, targets) {
            let [raw, target] = r;
            let name = ccg-alias-of(lx-camel-upper(raw));
            let e1 = ccg-when(!((String) name == target), rel ++ ": RBasic" ++ raw ++ " aliases " ++ target ++ ", expected " ++ name);
            (Comparable) ccg-has-name?(contract, target) == 0 ? ccg-ts-absorb(rest, rel, contract, append(errors, append(e1, ["TypeScript: alias target " ++ target ++ " is absent from category contract"])), targets)
            : ccg-ts-absorb(rest, rel, contract, append(errors, e1), (Comparable) lx-str-in?(targets, target) == 1 ? targets : append(targets, [target]));
        }

        // ---- the analysis: list(errors, contract-count, go-count, rust-count, ts-alias-count) ----
        def ccg-refusal(msg) = [[msg], 0, 0, 0, 0];
        def ccg-missing(root, rel) = "missing input: " ++ root ++ rel;
        def ccg-analysis(root) {
            let text = read_file(root ++ ccg-contract());
            nothing?(text) ? ccg-refusal(ccg-missing(root, ccg-contract())) : ccg-analysis-contract(root, ccg-contract-read(text));
        }
        def ccg-analysis-contract(root, read) {
            (String) read[0] == "refused" ? ccg-refusal(read[1])
            : (Comparable) fs_exists(root ++ ccg-go-dir()) == 0 ? ccg-refusal(ccg-missing(root, ccg-go-dir()))
            : (Comparable) fs_exists(root ++ ccg-rust-dir()) == 0 ? ccg-refusal(ccg-missing(root, ccg-rust-dir()))
            : (Comparable) fs_exists(root ++ ccg-ts-dir()) == 0 ? ccg-refusal(ccg-missing(root, ccg-ts-dir()))
            : ccg-analysis-kernel(root, read[1], read_file(root ++ ccg-kernel-ts()));
        }
        def ccg-analysis-kernel(root, contract, kernel) = nothing?(kernel) ? ccg-refusal(ccg-missing(root, ccg-kernel-ts())) : ccg-analysis-with(root, contract, kernel);
        def ccg-analysis-with(root, contract, kernel) {
            let go = ccg-collect(root, ccg-go-dir(), ".go", ccg-go-consts);
            let rust = ccg-collect(root, ccg-rust-dir(), ".rs", ccg-rust-consts);
            let ts = ccg-ts(root, contract, kernel);
            [append(ccg-slot-errors(contract), append(go[1], append(rust[1], append(ccg-compare("Go", go[0], contract), append(ccg-compare("Rust", rust[0], contract), ts[0]))))),
                 len(contract), len(go[0]), len(rust[0]), ts[1]];
        }
        def ccg-a-errors(a) = a[0];

        // ---- the voice ----
        def ccg-ok-line(a) = a[1].str() ++ " injective RBasic slots; Go=" ++ a[2].str() ++ ", Rust=" ++ a[3].str() ++ ", TypeScript=contract+" ++ a[4].str() ++ " named aliases";
        def ccg-judge(root) {
            let a = ccg-analysis(root);
            lx-verdict(ccg-name(), ccg-a-errors(a), ccg-ok-line(a));
        }
        def ccg-run() = ccg-judge("");
    }
    ccg-run();
}
