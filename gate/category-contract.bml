//////////////////////////////////////////////////////////////////////
//
// gate/category-contract.bml — the category-contract drift gate as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/verify_category_contract.py, read as the spec and
// transliterated check for check. The script stays in place as a
// witness while this lens stands its first landings; the drift-gates
// row (gate/drift-gates.bml, "category-contract") runs this door.
//
// THE INVARIANT. form/category-contract.json's r_basic map is the one
// numbering of the RBasic categories, and the three sibling kernels
// carry no number that disagrees with it:
//   - r_basic is a non-empty map of names to integers, injective: no
//     two names share a slot;
//   - every Go constant `RBasicName uint32 = N` (any .go under
//     form-kernel-go, subdirectories included), its name read to the
//     contract's spelling (ChoiceMatch -> CHOICE_MATCH, with the four
//     aliases FN_DEF->FNDEF, FN_CALL->FNCALL, LIST_LOCAL->LIST,
//     RESOLVE->FIELD_RESOLVE), names a contract slot and equals it; the
//     same constant defined twice at different numbers is a conflict;
//   - every Rust `const RB_NAME: u32 = N;` or `RBASIC_NAME` (any .rs
//     under form-kernel-rust/src) likewise, the aliases applied to the
//     raw name;
//   - Go and Rust each carry the six sibling constants FORMAT NUMERIC
//     QUOTIENT INDUCTIVE CONSTRUCTOR EQUIVALENCE;
//   - kernel.ts imports the contract itself (`import CATEGORY_CONTRACT
//     from "../../category-contract.json"`, with or without the json
//     import attribute) and projects RBasic from it
//     (`Object.freeze(CATEGORY_CONTRACT.r_basic)`); every TypeScript
//     alias `export const RBasicName = RBasic.TARGET;` (any .ts under
//     form-kernel-ts/src) names its own target and a target the
//     contract has; the four aliases FORMAT NUMERIC LANGUAGE
//     EQUIVALENCE are present.
//
// INPUTS. The contract is read through json.fk (parse-json, the
// body's own reader); the kernel sources are listed through
// source_inventory (the body's tree walk, paths sorted bytewise as the
// script sorts them) and read whole. Everything sits under a root the
// band can re-point; "" is the live tree.
//
// EXIT. No errors: one line `category-contract: OK <n> injective
// RBasic slots; Go=<g>, Rust=<r>, TypeScript=contract+<t> named
// aliases` and the answer 1 — the script's PASS line after its own
// prefix. Otherwise one `error: ...` line per finding in the script's
// order (slot aliases by slot, Go conflicts, Rust conflicts, Go
// compared by name, Rust compared by name, the kernel.ts import and
// projection, TypeScript aliases file by file, the missing aliases),
// then `category-contract: FAIL` and the answer 0. Each finding is the
// script's own words after its `FAIL ` prefix, so the band can hold the
// two outputs against each other byte for byte. A contract file or a
// kernel directory the tree does not have is one named `missing input`
// and a refusal, where the script dies in a traceback.
//
// Run directly:  ./fkwu gate/category-contract.bml    ; last line 1 / 0
// Twin:          python3 form/scripts/verify_category_contract.py
// Proven by:     gate/tests/category-contract-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCategoryContractGate {
        thought category-contract-pattern = list("one-numbering-three-witnesses", "contract-through-json-fk", "sources-through-the-tree-walk", "conflict-before-compare", "twin-voice-byte-for-byte");

        def ccg-name() = "category-contract";
        def ccg-contract() = "form/category-contract.json";
        def ccg-go-dir() = "form/form-kernel-go";
        def ccg-rust-dir() = "form/form-kernel-rust/src";
        def ccg-ts-dir() = "form/form-kernel-ts/src";
        def ccg-kernel-ts() = "form/form-kernel-ts/src/kernel.ts";
        def ccg-alias(from, to) = list(from, to);
        def ccg-aliases() = list(ccg-alias("FN_DEF", "FNDEF"), ccg-alias("FN_CALL", "FNCALL"), ccg-alias("LIST_LOCAL", "LIST"), ccg-alias("RESOLVE", "FIELD_RESOLVE"));
        def ccg-alias-from?(row, name) = if str_eq(nth(row, 0), name) then 1 else 0;
        def ccg-alias-of(name) {
            let row = tb-find2(ccg-aliases(), ccg-alias-from?, name);
            if eq(len(row), 0) then name else nth(row, 1);
        }
        // kept sorted: the script prints sorted(missing)
        def ccg-required-sibling() = list("CONSTRUCTOR", "EQUIVALENCE", "FORMAT", "INDUCTIVE", "NUMERIC", "QUOTIENT");
        def ccg-required-ts() = list("EQUIVALENCE", "FORMAT", "LANGUAGE", "NUMERIC");
        def ccg-import-plain() = "import CATEGORY_CONTRACT from \"../../category-contract.json\";";
        def ccg-import-with() = "import CATEGORY_CONTRACT from \"../../category-contract.json\" with { type: \"json\" };";
        def ccg-freeze() = "Object.freeze(CATEGORY_CONTRACT.r_basic)";
        def ccg-when(cond, msg) = if cond then list(msg) else list();

        // ---- (name, value) rows ----
        def ccg-row-name(r) = nth(r, 0);
        def ccg-row-value(r) = nth(r, 1);
        def ccg-named?(row, name) = if str_eq(nth(row, 0), name) then 1 else 0;
        def ccg-lookup(rows, name) = tb-find2(rows, ccg-named?, name);
        def ccg-has-name?(rows, name) = if eq(len(ccg-lookup(rows, name)), 0) then 0 else 1;
        def ccg-name-absent?(name, rows) = if eq(ccg-has-name?(rows, name), 1) then 0 else 1;
        def ccg-names(rows) = tb-map(rows, ccg-row-name);
        def ccg-kv(r) = str_concat(ccg-row-name(r), str_concat("=", int_to_str(ccg-row-value(r))));

        // ---- the contract: list("ok", rows) or list("refused", message) ----
        def ccg-contract-read(text) {
            let root = parse-json(ccg-contract(), text);
            if json-object-has?(root, "r_basic") then ccg-contract-map(json-object-pairs(json-object-get(root, "r_basic"))) else list("refused", "category-contract.json has no non-empty r_basic map");
        }
        def ccg-contract-map(pairs) {
            if eq(len(pairs), 0) then list("refused", "category-contract.json has no non-empty r_basic map")
            else if eq(ccg-all-ints?(pairs), 0) then list("refused", "category-contract.json r_basic must map names to integers")
            else list("ok", tb-map(pairs, ccg-pair-row));
        }
        def ccg-all-ints?(pairs) = if eq(len(pairs), 0) then 1 else if eq(node_type(json-pair-value(head(pairs))), 1) then ccg-all-ints?(tail(pairs)) else 0;
        def ccg-pair-row(p) = list(json-pair-key(p), node_value(json-pair-value(p)));

        // ---- slot aliasing, by slot ascending; names in the contract's order ----
        def ccg-slot-is?(r, slot) = if eq(ccg-row-value(r), slot) then 1 else 0;
        def ccg-slot-errors(rows) = ccg-slot-errors-go(lx-int-sort(lx-int-uniq(tb-map(rows, ccg-row-value))), rows, list());
        def ccg-slot-errors-go(slots, rows, acc) {
            if eq(len(slots), 0) then acc else ccg-slot-errors-one(head(slots), tail(slots), rows, acc);
        }
        def ccg-slot-errors-one(slot, rest, rows, acc) {
            let names = ccg-names(tb-filter2(rows, ccg-slot-is?, slot));
            ccg-slot-errors-go(rest, rows, append(acc, ccg-when(gt(len(names), 1), str_concat("category-contract.json: RBasic slot ", str_concat(int_to_str(slot), str_concat(" aliases ", tb-join(names, identity, ", ")))))));
        }

        // ---- Go: \bRBasic([A-Za-z0-9]+)\s+uint32\s*=\s*(\d+) ----
        def ccg-go-consts(text) = ccg-go-consts-go(text, 0, list());
        def ccg-go-consts-go(text, from, acc) {
            let i = str_find(text, "RBasic", from);
            if lt(i, 0) then reverse(acc) else ccg-go-consts-go(text, add(i, 1), ccg-go-try(text, i, acc));
        }
        def ccg-go-try(text, i, acc) = if eq(lx-boundary-before?(text, i), 0) then acc else ccg-go-try-name(text, add(i, 6), lx-span-alnum(text, add(i, 6)), acc);
        def ccg-go-try-name(text, a, j, acc) = if eq(j, a) then acc else ccg-go-try-ws(text, a, j, lx-skip-ws(text, j), acc);
        def ccg-go-try-ws(text, a, j, k, acc) {
            if eq(k, j) then acc
            else if eq(lx-at?(text, k, "uint32"), 0) then acc
            else ccg-try-eq-value(text, add(k, 6), ccg-alias-of(lx-camel-upper(substring(text, a, j))), acc);
        }
        // the shared tail \s*=\s*(\d+): conses (name, value) onto acc, or leaves acc
        def ccg-try-eq-value(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            if eq(lx-at?(text, m2, "="), 0) then acc else ccg-try-digits(text, lx-skip-ws(text, add(m2, 1)), name, acc);
        }
        def ccg-try-digits(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            if eq(e, d) then acc else cons(list(name, lx-int-span(text, d, e)), acc);
        }

        // ---- Rust: \bconst\s+(?:RB|RBASIC)_([A-Z0-9_]+)\s*:\s*u32\s*=\s*(\d+) ----
        def ccg-rust-consts(text) = ccg-rust-consts-go(text, 0, list());
        def ccg-rust-consts-go(text, from, acc) {
            let i = str_find(text, "const", from);
            if lt(i, 0) then reverse(acc) else ccg-rust-consts-go(text, add(i, 1), ccg-rust-try(text, i, acc));
        }
        def ccg-rust-try(text, i, acc) = if eq(lx-boundary-before?(text, i), 0) then acc else ccg-rust-try-ws(text, add(i, 5), lx-skip-ws(text, add(i, 5)), acc);
        def ccg-rust-try-ws(text, j, k, acc) {
            if eq(k, j) then acc
            else if eq(lx-at?(text, k, "RBASIC_"), 1) then ccg-rust-try-name(text, add(k, 7), acc)
            else if eq(lx-at?(text, k, "RB_"), 1) then ccg-rust-try-name(text, add(k, 3), acc)
            else acc;
        }
        def ccg-rust-try-name(text, a, acc) {
            let j = lx-span-upper-word(text, a);
            if eq(j, a) then acc else ccg-rust-try-colon(text, a, j, lx-skip-ws(text, j), acc);
        }
        def ccg-rust-try-colon(text, a, j, k, acc) = if eq(lx-at?(text, k, ":"), 0) then acc else ccg-rust-try-u32(text, a, j, lx-skip-ws(text, add(k, 1)), acc);
        def ccg-rust-try-u32(text, a, j, k, acc) = if eq(lx-at?(text, k, "u32"), 0) then acc else ccg-try-eq-value(text, add(k, 3), ccg-alias-of(substring(text, a, j)), acc);

        // ---- TypeScript aliases: export\s+const\s+RBasic([A-Za-z0-9]+)\s*=\s*RBasic\.([A-Z0-9_]+)\s*; -> (raw-name, target) ----
        def ccg-ts-aliases(text) = ccg-ts-go(text, 0, list());
        def ccg-ts-go(text, from, acc) {
            let i = str_find(text, "export", from);
            if lt(i, 0) then reverse(acc) else ccg-ts-go(text, add(i, 1), ccg-ts-try(text, add(i, 6), acc));
        }
        def ccg-ts-try(text, j, acc) {
            let k = lx-skip-ws(text, j);
            if eq(k, j) then acc else if eq(lx-at?(text, k, "const"), 0) then acc else ccg-ts-try-rbasic(text, add(k, 5), acc);
        }
        def ccg-ts-try-rbasic(text, j, acc) {
            let k = lx-skip-ws(text, j);
            if eq(k, j) then acc else if eq(lx-at?(text, k, "RBasic"), 0) then acc else ccg-ts-try-name(text, add(k, 6), acc);
        }
        def ccg-ts-try-name(text, a, acc) {
            let j = lx-span-alnum(text, a);
            if eq(j, a) then acc else ccg-ts-try-eq(text, a, j, lx-skip-ws(text, j), acc);
        }
        def ccg-ts-try-eq(text, a, j, k, acc) = if eq(lx-at?(text, k, "="), 0) then acc else ccg-ts-try-target(text, a, j, lx-skip-ws(text, add(k, 1)), acc);
        def ccg-ts-try-target(text, a, j, k, acc) = if eq(lx-at?(text, k, "RBasic."), 0) then acc else ccg-ts-try-target-name(text, a, j, add(k, 7), acc);
        def ccg-ts-try-target-name(text, a, j, t, acc) {
            let u = lx-span-upper-word(text, t);
            if eq(u, t) then acc else if eq(lx-at?(text, lx-skip-ws(text, u), ";"), 0) then acc else cons(list(substring(text, a, j), substring(text, t, u)), acc);
        }

        // ---- collecting numeric constants over a kernel's sorted files: list(found, conflicts) ----
        def ccg-relpath(dir, file) = str_concat(substring(dir, 5, str_len(dir)), str_concat("/", file));
        def ccg-collect(root, dir, suffix, scanner) = ccg-collect-go(root, dir, lx-files-sorted(str_concat(root, dir), suffix), scanner, list(), list());
        def ccg-collect-go(root, dir, files, scanner, found, errors) {
            if eq(len(files), 0) then list(found, errors) else ccg-collect-file(root, dir, head(files), tail(files), scanner, found, errors);
        }
        def ccg-collect-file(root, dir, file, rest, scanner, found, errors) {
            let text = lx-host-text(read_file(str_concat(root, str_concat(dir, str_concat("/", file)))));
            let step = ccg-absorb(scanner(text), ccg-relpath(dir, file), found, errors);
            ccg-collect-go(root, dir, rest, scanner, nth(step, 0), nth(step, 1));
        }
        def ccg-absorb(rows, rel, found, errors) = if eq(len(rows), 0) then list(found, errors) else ccg-absorb-one(head(rows), tail(rows), rel, found, errors);
        def ccg-absorb-one(r, rest, rel, found, errors) {
            let prev = ccg-lookup(found, ccg-row-name(r));
            ccg-absorb(rest, rel, ccg-put(found, r), append(errors, ccg-conflict(r, prev, rel)));
        }
        def ccg-conflict(r, prev, rel) = if eq(len(prev), 0) then list() else ccg-when(not(eq(ccg-row-value(prev), ccg-row-value(r))), str_concat(rel, str_concat(": ", str_concat(ccg-kv(r), str_concat(" conflicts with ", int_to_str(ccg-row-value(prev)))))));
        // the last definition wins, as in the script's dict
        def ccg-put(found, r) = if eq(ccg-has-name?(found, ccg-row-name(r)), 0) then append(found, list(r)) else ccg-replace(found, r);
        def ccg-replace(found, r) = if eq(len(found), 0) then list() else if str_eq(ccg-row-name(head(found)), ccg-row-name(r)) then cons(r, tail(found)) else cons(head(found), ccg-replace(tail(found), r));

        // ---- comparing a kernel's constants with the contract, by name ----
        def ccg-compare(impl, found, contract) = append(ccg-compare-names(impl, lx-str-sort(ccg-names(found)), found, contract), ccg-missing-sibling(impl, found));
        def ccg-compare-names(impl, names, found, contract) {
            if eq(len(names), 0) then list()
            else append(ccg-compare-one(impl, ccg-lookup(found, head(names)), ccg-lookup(contract, head(names))), ccg-compare-names(impl, tail(names), found, contract));
        }
        def ccg-compare-one(impl, r, expected) {
            if eq(len(expected), 0) then list(str_concat(impl, str_concat(": ", str_concat(ccg-kv(r), " is absent from category-contract.json"))))
            else ccg-when(not(eq(ccg-row-value(r), ccg-row-value(expected))), str_concat(impl, str_concat(": ", str_concat(ccg-kv(r), str_concat(", category-contract.json requires ", int_to_str(ccg-row-value(expected)))))));
        }
        def ccg-missing-sibling(impl, found) {
            let missing = tb-filter2(ccg-required-sibling(), ccg-name-absent?, found);
            ccg-when(gt(len(missing), 0), str_concat(impl, str_concat(": missing sibling constants: ", tb-join(missing, identity, ", "))));
        }

        // ---- TypeScript: list(errors, distinct alias targets) ----
        def ccg-ts(root, contract, kernel) {
            let head-errors = append(ccg-when(and(eq(lx-has?(kernel, ccg-import-plain()), 0), eq(lx-has?(kernel, ccg-import-with()), 0)), "TypeScript: kernel.ts does not import the canonical category contract"),
                                     ccg-when(eq(lx-has?(kernel, ccg-freeze()), 0), "TypeScript: RBasic is not projected from category-contract.json"));
            let walk = ccg-ts-files(root, lx-files-sorted(str_concat(root, ccg-ts-dir()), ".ts"), contract, list(), list());
            let missing = lx-str-minus(ccg-required-ts(), nth(walk, 1));
            list(append(head-errors, append(nth(walk, 0), ccg-when(gt(len(missing), 0), str_concat("TypeScript: missing contract aliases: ", tb-join(missing, identity, ", "))))), len(nth(walk, 1)));
        }
        def ccg-ts-files(root, files, contract, errors, targets) {
            if eq(len(files), 0) then list(errors, targets)
            else ccg-ts-file(root, head(files), tail(files), contract, errors, targets);
        }
        def ccg-ts-file(root, file, rest, contract, errors, targets) {
            let text = lx-host-text(read_file(str_concat(root, str_concat(ccg-ts-dir(), str_concat("/", file)))));
            let step = ccg-ts-absorb(ccg-ts-aliases(text), ccg-relpath(ccg-ts-dir(), file), contract, errors, targets);
            ccg-ts-files(root, rest, contract, nth(step, 0), nth(step, 1));
        }
        def ccg-ts-absorb(rows, rel, contract, errors, targets) = if eq(len(rows), 0) then list(errors, targets) else ccg-ts-absorb-one(head(rows), tail(rows), rel, contract, errors, targets);
        def ccg-ts-absorb-one(r, rest, rel, contract, errors, targets) {
            let raw = nth(r, 0);
            let target = nth(r, 1);
            let name = ccg-alias-of(lx-camel-upper(raw));
            let e1 = ccg-when(not(str_eq(name, target)), str_concat(rel, str_concat(": RBasic", str_concat(raw, str_concat(" aliases ", str_concat(target, str_concat(", expected ", name)))))));
            if eq(ccg-has-name?(contract, target), 0)
            then ccg-ts-absorb(rest, rel, contract, append(errors, append(e1, list(str_concat("TypeScript: alias target ", str_concat(target, " is absent from category contract"))))), targets)
            else ccg-ts-absorb(rest, rel, contract, append(errors, e1), if eq(lx-str-in?(targets, target), 1) then targets else append(targets, list(target)));
        }

        // ---- the analysis: list(errors, contract-count, go-count, rust-count, ts-alias-count) ----
        def ccg-refusal(msg) = list(list(msg), 0, 0, 0, 0);
        def ccg-missing(root, rel) = str_concat("missing input: ", str_concat(root, rel));
        def ccg-analysis(root) {
            let text = read_file(str_concat(root, ccg-contract()));
            if nothing?(text) then ccg-refusal(ccg-missing(root, ccg-contract())) else ccg-analysis-contract(root, ccg-contract-read(text));
        }
        def ccg-analysis-contract(root, read) {
            if str_eq(nth(read, 0), "refused") then ccg-refusal(nth(read, 1))
            else if eq(fs_exists(str_concat(root, ccg-go-dir())), 0) then ccg-refusal(ccg-missing(root, ccg-go-dir()))
            else if eq(fs_exists(str_concat(root, ccg-rust-dir())), 0) then ccg-refusal(ccg-missing(root, ccg-rust-dir()))
            else if eq(fs_exists(str_concat(root, ccg-ts-dir())), 0) then ccg-refusal(ccg-missing(root, ccg-ts-dir()))
            else ccg-analysis-kernel(root, nth(read, 1), read_file(str_concat(root, ccg-kernel-ts())));
        }
        def ccg-analysis-kernel(root, contract, kernel) = if nothing?(kernel) then ccg-refusal(ccg-missing(root, ccg-kernel-ts())) else ccg-analysis-with(root, contract, kernel);
        def ccg-analysis-with(root, contract, kernel) {
            let go = ccg-collect(root, ccg-go-dir(), ".go", ccg-go-consts);
            let rust = ccg-collect(root, ccg-rust-dir(), ".rs", ccg-rust-consts);
            let ts = ccg-ts(root, contract, kernel);
            list(append(ccg-slot-errors(contract), append(nth(go, 1), append(nth(rust, 1), append(ccg-compare("Go", nth(go, 0), contract), append(ccg-compare("Rust", nth(rust, 0), contract), nth(ts, 0)))))),
                 len(contract), len(nth(go, 0)), len(nth(rust, 0)), nth(ts, 1));
        }
        def ccg-a-errors(a) = nth(a, 0);

        // ---- the voice ----
        def ccg-ok-line(a) = str_concat(int_to_str(nth(a, 1)), str_concat(" injective RBasic slots; Go=", str_concat(int_to_str(nth(a, 2)), str_concat(", Rust=", str_concat(int_to_str(nth(a, 3)), str_concat(", TypeScript=contract+", str_concat(int_to_str(nth(a, 4)), " named aliases")))))));
        def ccg-judge(root) {
            let a = ccg-analysis(root);
            lx-verdict(ccg-name(), ccg-a-errors(a), ccg-ok-line(a));
        }
        def ccg-run() = ccg-judge("");
    }
    ccg-run();
}
