// structural-gate-run.fk — executable repository structural policy.
//
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import gate/structural-gate.fk;
//
// Run from repository root:
//   ./fkwu gate/structural-gate-run.fk
//
// It first prints the live four-slot audit and what it says in words, then
// returns native 1 (pass) or 0 (a script with no declared role stands).
// fkwu's current failure value is a typed Form result, not a process exit;
// the band sweep (gate/band-sweep-run.bml) reads this explicit result and
// ends in an error when it is 0.
section [form.bml] {
    let audit = sg-audit(".");
    print("structural-gate-v5 total/unclassified/carrier/fixture=");
    print(audit);
    print(sg-words(audit));
    sg-passes?(audit);
}
