// structural-gate-run.fk — executable repository structural policy.
//
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import gate/structural-gate.fk;
//
// Run from repository root:
//   ./fkwu gate/structural-gate-run.fk
//
// It first prints the live seven-slot audit, then returns native 1 (pass) or
// 0 (unclassified script present). fkwu's current failure value is a typed
// Form result, not a process exit; form/validate.sh is the existing validation
// carrier that turns this explicit result into its nonzero repository exit.
section [form.bml] {
    let audit = sg-audit(".");
    print("structural-gate-v3 total/unclassified/carrier/oracle/fixture/proof-sibling/tooling=");
    print(audit);
    sg-passes?(audit);
}
