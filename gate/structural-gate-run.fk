// structural-gate-run.fk — executable repository structural policy.
//
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import gate/structural-gate.fk;
//
// Run from repository root:
//   ./fkwu gate/structural-gate-run.fk
//
// It first prints the live six-slot audit, then returns native 1 (pass) or
// 0 (unclassified script present). fkwu's current failure value is a typed
// Form result, not a process exit; the band sweep (gate/band-sweep-run.bml)
// reads this explicit result and ends in an error when it is 0.
section [form.bml] {
    let audit = sg-audit(".");
    print("structural-gate-v4 total/unclassified/carrier/oracle/fixture/tooling=");
    print(audit);
    sg-passes?(audit);
}
