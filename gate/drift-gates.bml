//////////////////////////////////////////////////////////////////////
//
// drift-gates.bml
//
// Executable BML. The DRIFT GATES as rows of DATA. Every mirror gate
// the body owns — native surface, op manifest, the flt-ops sequence,
// reserved heads, canonical conformance, structural boundary, the
// substring and str_find meanings, the kernel laws, binary freshness,
// ground, door links, release ledger, the form-cli build, the cursor's
// coverage of every section —
// runs through one door: one cell_run per row (in this process, no
// child: docs/in-process-cells.md), one pass bit per row, one fold.
// The number names the gate that refused. Adding a gate is adding a row.
//
// This unit is the organ; the door is gate/drift-gates-run.bml, the
// structural-gate / structural-gate-run shape. A preluded unit runs
// its top-level statement eagerly, so an organ the band and the land
// cadence prelude cannot also be the door. Run from the repository
// root:
//
//   ./fkwu gate/drift-gates-run.bml
//
// prints one line per gate (name, rc of the cell: 0 when it ran and
// ended clean, 1 when it stopped or compiled with errors, last line
// of the gate, pass or REFUSED with the command to rerun), then
//
//   drift-gates pass=<fold> full=<mask> refused=<mask> names=<a,b | ->
//
// and answers the pass fold (full when every gate is green).
//
// Process exit: fkwu answers a Form value and keeps its own status, and
// the door exits 0 even when a row refuses. Its readers turn a refusal
// into a held landing: the landing door
// (form-stdlib/bml/form-cli-landing.bml, ld-gates-ok) reads the
// summary line and the door's exit; the land cadence
// (form-stdlib/land-cadence.fk, lc-land; door
// form-stdlib/land-cadence-live.fk) folds the rows in-process through
// dg-rows, dg-run and dg-green? before any landing act, so a red gate
// lands nothing. The band sweep (gate/band-sweep-run.bml) carries only a subset:
// structural-gate, and validation-start's rows (gate/validation-start.bml).
// Every row is read on fkwu: the one runtime.
// The same conversion as one line, for a hand, a hook, or a cron
// breath — every line still shows (on stderr), the exit is nonzero
// when any gate refuses, and also when the door itself never answers:
//
//   ./fkwu gate/drift-gates-run.bml | tee /dev/stderr | grep -q ' refused=0 '
//
// Row shape: name, unit, input, want. A row runs its unit as one cell_run call
// (a deadline instead of a kill; the input is the cell's stdin, a list of
// lines or nothing, and the mark @scratch@ in a line is a fresh path in the
// temp directory that is removed with whatever sits beside it when the cell
// returns). The reading is the record's: the cell's rc is 0 when it ran and
// ended clean and 1 when it stopped or compiled with errors; its last line is
// the value it answered. want is the Form verdict the gate answers as its
// value (with rc 0); want = dg-exit-only() means rc 0 is the whole verdict (a
// gate that speaks in prose). A unit that would not run at all reads no rc.
//
// A landing runs only the rows whose ground moved: each row names the paths it guards (dg-grounds),
// and a row whose ground no path since origin/main touches sits out, said so on its own line and
// absent from the fold, never a pass. A row with no ground named guards the whole tree and always
// runs. A grounded row also guards every unit its unit loads: dg-closure computes that part with the
// body's own dependency reader (form-stdlib/bml-source.fk: the prelude lines and imports of each unit,
// resolved by the loader's search order), so only the data files a gate reads by name are written by
// hand. Every row that runs is a live step (form-stdlib/bml/live.bml): its reading is spoken on
// stderr as it lands, and a red row is offered only the repairs that meet what it observed before
// it refuses (see dg-repairs); the printed line says "pass after <repair>" when one made it hold.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml form-stdlib/bml/live.bml form-stdlib/bml-source.fk
//
// Proven by: gate/tests/drift-gates-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormDriftGates {
        thought drift-gates-pattern = ["gates-are-rows", "one-bit-per-gate", "exit-is-the-last-line", "red-lands-nothing", "names-travel"];

        def dg-exit-only() = 0 - 1;
        // a row: [name, unit, input, want]; input is the cell's stdin (a list of lines, or nothing for none)
        def dg-row(name, unit, input, want) = [name, unit, input, want];
        def dg-name(r) = r[0];
        def dg-unit(r) = r[1];
        def dg-input-of(r) = r[2];
        def dg-want(r) = r[3];
        // the words that rerun a row by hand, said on a refusal
        def dg-command(r) = nothing?(dg-input-of(r)) ? "./fkwu " ++ dg-unit(r) : "printf '" ++ dg-join(dg-input-of(r), "\\n") ++ "' | ./fkwu " ++ dg-unit(r);
        def dg-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ dg-join(xs[1:], sep);

        // The substring-one-meaning row: substring is the door the tree stands
        // on — str_find, split-on, trim and char_at are recipes over it. The
        // band pins the one meaning (bytes, clamped, never dies) so a drift
        // refuses here rather than at the next multi-tongue row.
        //
        // The str-find-one-meaning row: the same one door up. The band pins the
        // one meaning (the byte index at or after max(from,0), or -1) against a
        // scan it builds from str_byte_at, and its bit 512 is the only thing in
        // the tree that can see a snapped `from`.
        //
        // The form-cli-build row: form-cli is the door the walk to zero rent
        // ends at, and on 2026-09-30 a lift renamed its recipe's image while
        // the build kept the old name; every build failed and no gate
        // saw it until a carrier test ran a day later. The row builds a copy
        // into the temp directory whenever the runtime, the stdlib or the
        // build's own door move, and judges by exit alone. A copy build
        // never republishes this checkout's bundle (form/form-stdlib/bootstrap)
        // or its form/form-cli link: when no current generation stands, the
        // build regenerates inside a private copy of the body and keeps only
        // the copy it was asked for (gate/form-cli-build-run.bml).
        //
        // The flt-ops-gen row: the flt-ops sequence check (gate/flt-ops-gen.bml)
        // stands on op-manifest's ground; the band sweep runs it at validation-start
        // and a landing runs it here.
        //
        // The bml-cursor-coverage row: the cursor (form-stdlib/grammars/form-bml.fk)
        // is the one reader of every form.bml, form.route and form.action section,
        // so when the reader, the lowerer or the lifter moves, every section the
        // tree holds must still read and lower whole. In gate mode the coverage
        // door answers the sections it does not (refused plus stops); it wants 0.
        // It walks the whole tree, so it runs only when its own closure moves or
        // a grammar does (form/form-stdlib/grammars/, grammars/): the five packs a
        // lift left with `import` inside their section read refused while no row
        // ran, because no pack is in the reader's closure. Any other section that
        // stops reading is met when a band or a walk loads it, not by this row.
        //
        // The kernel-laws row: the laws the core pins (docs/kernel-interface.md,
        // "Laws the core pins", 1-9: 63-bit wrap, the cold and warm division
        // stops, order refusals, exact sqrt and fmod, the guarded float_to_int,
        // one str_to_float grammar, the string doors' edges, one rendering) and
        // the math doors' special cases, all 31 bits. The row watches fkwu's
        // reading whenever the kernel moves.
        //
        // A row list is one statement: a comment BETWEEN rows ends it early and
        // the unit lowers with three parens still open. Comments live here.
        def dg-all-rows() = [
            dg-row("native-surface", "gate/native-surface.bml", nothing(), 1),
            dg-row("op-manifest", "gate/op-manifest.bml", nothing(), 1),
            dg-row("flt-ops-gen", "gate/flt-ops-gen.bml", nothing(), 1),
            dg-row("reserved-heads", "gate/reserved-heads.bml", nothing(), 1),
            dg-row("canonical-conformance", "gate/canonical-conformance-run.bml", nothing(), 1),
            dg-row("structural-gate", "gate/structural-gate-run.fk", nothing(), 1),
            dg-row("substring-one-meaning", "form/form-stdlib/tests/substring-one-meaning-band.fk", nothing(), 4095),
            dg-row("str-find-one-meaning", "form/form-stdlib/tests/str-find-one-meaning-band.fk", nothing(), 8191),
            dg-row("kernel-laws", "form/form-stdlib/tests/kernel-laws-band.fk", nothing(), 2147483647),
            dg-row("binary-freshness", "form/form-stdlib/tests/binary-freshness-band.fk", nothing(), 31),
            dg-row("ground", "bootstrap/ground.fk", nothing(), 42),
            dg-row("door-links", "observe/door-link-health-run.bml", nothing(), 0),
            dg-row("release-ledger", "form/form-stdlib/release-ledger.bml", nothing(), dg-exit-only()),
            dg-row("form-cli-build", "gate/form-cli-build-run.bml", ["{\"out\":\"@scratch@\"}"], dg-exit-only()),
            dg-row("bml-cursor-coverage", "observe/bml-cursor-coverage-run.bml", ["gate"], 0)];

        // --- a row's ground: the paths whose change it guards. The kernel rows guard the kernel
        // (the seed and the units every lens reads), the data files they read by name, and every unit
        // their own unit loads (dg-closure, computed). structural-gate, binary-freshness (a rebase
        // moves the runtime under a binary with no path of its own in the diff), ground, door-links
        // and release-ledger name no ground: they guard the whole tree and always run. A row outside
        // the ground that moved is absent from the fold, never a fabricated pass.
        def dg-kernels() = ["runtime/", "form/form-stdlib/core.fk", "form/form-stdlib/table.bml", "form/form-stdlib/json.fk", "gate/lens-text.bml"];
        def dg-op-data() = ["flatten/", "form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/native-op-manifest.fk", "form/form-stdlib/form-parse.fk"];
        def dg-grounds() = [
            ["native-surface", append(dg-kernels(), ["form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/host-io-fs-fkwu-emit.fk", "form/form-stdlib/form-parse.fk", "form/form-stdlib/form-flatten.fk", "gate/native-surface.bml"])],
            ["op-manifest", append(dg-kernels(), append(dg-op-data(), ["gate/op-manifest.bml"]))],
            ["flt-ops-gen", append(dg-kernels(), append(dg-op-data(), ["gate/flt-ops-gen.bml"]))],
            ["reserved-heads", append(dg-kernels(), ["form/form-stdlib/fkwu-op-arity.fk", "gate/reserved-heads.bml"])],
            ["canonical-conformance", append(dg-kernels(), ["gate/canonical-conformance.bml", "gate/canonical-conformance-run.bml", "form/conformance/", "form/form-stdlib/bml/formbin-codec.bml"])],
            ["substring-one-meaning", append(dg-kernels(), ["form/form-stdlib/tests/substring-one-meaning-band.fk"])],
            ["str-find-one-meaning", append(dg-kernels(), ["form/form-stdlib/tests/str-find-one-meaning-band.fk"])],
            ["kernel-laws", append(dg-kernels(), ["form/form-stdlib/tests/kernel-laws-band.fk"])],
            ["form-cli-build", ["runtime/", "gate/form-cli-build-run.bml", "form/form-stdlib/", "control/", "grammars/"]],
            ["bml-cursor-coverage", ["runtime/", "form/form-stdlib/grammars/", "grammars/", "form/form-stdlib/bml/form-source-lift.bml", "form/form-stdlib/bml-floor-compile.fk"]]];
        def dg-ground-of(grounds, name) = nil?(grounds) ? [] : (String) grounds[0][0] == name ? grounds[0][1] : dg-ground-of(grounds[1:], name);
        def dg-ground(row) = dg-ground-of(dg-grounds(), dg-name(row));
        def dg-starts?(s, p) = (len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
        def dg-touches?(paths, ground) = nil?(paths) ? false : dg-under?(paths[0], ground) ? true : dg-touches?(paths[1:], ground);
        def dg-under?(path, ground) = nil?(ground) ? false : dg-starts?(path, ground[0]) ? true : dg-under?(path, ground[1:]);

        // --- the computed part of a ground: the unit a row runs and every unit it loads, as the
        // loader names them. dg-closure reads each unit's prelude lines and imports with the body's own
        // dependency reader (bml-source-dependencies) and resolves each token by the loader's search
        // order (bml-source-resolve), unit by unit, spelled from the repo root; a spelling that walks
        // up (form/../control/x.fk) folds to the path a change names. A unit that does not read gives
        // no closure (nothing), and a row whose closure is nothing runs: an unread ground is never a rest.
        def dg-rfind-go(s, needle, from, last) {
            let i = str_find(s, needle, from);
            i < 0 ? last : dg-rfind-go(s, needle, i + 1, i);
        }
        def dg-rfind(s, needle) = dg-rfind-go(s, needle, 0, 0 - 1);
        def dg-cut-up(p, at) {
            let slash = dg-rfind(substring(p, 0, at), "/");
            slash < 0 ? substring(p, at + 4, str_len(p)) : (substring(p, 0, slash + 1) ++ substring(p, at + 4, str_len(p)));
        }
        def dg-fold-up(p) {
            let at = str_find(p, "/../", 0);
            at < 0 ? p : dg-fold-up(dg-cut-up(p, at));
        }
        def dg-bml?(path) = dg-ends?(path, ".bml");
        def dg-ends?(s, p) = (len(s) >= len(p)) && ((String) substring(s, len(s) - len(p), len(s)) == p);
        // the units one unit names, resolved to the path the loader opens (a token nothing answers is no unit)
        def dg-named(owner, text) = bml-source-dependencies(text, dg-bml?(owner) ? 0 : 1) |> map(token => bml-source-resolve(owner, token)) |> filter(p => !nothing?(p)) |> map(p => dg-fold-up(p));
        def dg-in?(xs, s) = nil?(xs) ? false : (String) xs[0] == s ? true : dg-in?(xs[1:], s);
        // depth first, each unit once, the first-met order; a unit that does not read names no more
        def dg-walk-units(pending, seen) {
            nil?(pending) ? reverse(seen)
            : dg-in?(seen, pending[0]) ? dg-walk-units(pending[1:], seen)
            : dg-walk-units(append(dg-named(pending[0], read_file(pending[0]) ?? ""), pending[1:]), cons(pending[0], seen));
        }
        // two loads the lines do not name. A program with a .bml unit in it is lowered over the operator floor
        // (form-stdlib/bml/value-operators.bml). And form-stdlib/home-index.txt (<name> <unit>): a unit that calls a home
        // name and defines no such name in its closure gets the home linked in, as if it had preluded it. The call
        // is read as the name and an open paren in some text of the closure, the definition as def/defn of the name
        // (a name read as called where the loader sees it defined or bound locally only widens the ground, never narrows it)
        def dg-operator-floor() = "form/form-stdlib/bml/value-operators.bml";
        def dg-home-index() = "form/form-stdlib/home-index.txt";
        def dg-home-rows() = split-on(read_file(dg-home-index()) ?? "", "\n") |> filter(l => len(l) > 0 && !dg-starts?(l, "#")) |> map(l => split-on(l, " ")) |> filter(r => len(r) == 2);
        def dg-home-unit(row) = bml-source-resolve(dg-operator-floor(), row[1]);
        def dg-mentions?(text, part) = str_find(text, part, 0) >= 0;
        // a name stands as a word where the byte before it is no part of an identifier
        def dg-ident-byte?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45 || b == 63;
        def dg-word-before?(text, i) = i == 0 || !dg-ident-byte?(str_byte_at(text, i - 1));
        def dg-opens-at?(text, i) = i < len(text) && (str_byte_at(text, i) == 40 || (str_byte_at(text, i) == 32 && i + 1 < len(text) && str_byte_at(text, i + 1) == 40));
        def dg-call-from?(text, name, from) {
            let i = str_find(text, name, from);
            i < 0 ? false : dg-word-before?(text, i) && dg-opens-at?(text, i + len(name)) ? true : dg-call-from?(text, name, i + 1);
        }
        def dg-calls?(text, name) = dg-call-from?(text, name, 0);
        def dg-defines?(text, name) = dg-mentions?(text, "def " ++ name ++ "(") || dg-mentions?(text, "defn " ++ name ++ " ");
        def dg-homes-for(units) {
            let texts = units |> map(u => read_file(u) ?? "");
            dg-home-rows() |> filter(r => any?(t => dg-calls?(t, r[0]), texts) && !any?(t => dg-defines?(t, r[0]), texts)) |> map(r => dg-home-unit(r)) |> filter(p => !nothing?(p) && !dg-in?(units, p));
        }
        def dg-close(units) {
            let lowered = dg-in?(units, dg-operator-floor()) || !any?(u => dg-bml?(u), units) ? units : dg-walk-units([dg-operator-floor()], reverse(units));
            let homes = dg-homes-for(lowered);
            nil?(homes) ? lowered : dg-close(dg-walk-units(homes, reverse(lowered)));
        }
        def dg-closure(unit) = nothing?(read_file(unit)) ? nothing() : dg-close(dg-walk-units([unit], []));
        def dg-touches-closure?(moved, units) = nothing?(units) ? true : dg-touches?(moved, units);
        // a grounded row meets a change through its hand-named paths first; only then is its unit's
        // closure read, so a kernel or data move never pays for a closure
        def dg-meets?(row, moved) {
            let fixed = dg-ground(row);
            let unit = dg-unit(row);
            nil?(fixed) ? true : dg-touches?(moved, fixed) ? true : (Comparable) str_len(unit) == 0 ? false : dg-touches-closure?(moved, dg-closure(unit));
        }
        def dg-guards?(row, moved) = nothing?(moved) ? true : dg-meets?(row, moved);
        // the rows a change calls: every row when no merge-base can be read (moved is nothing)
        def dg-rows-for(moved) = dg-chosen(dg-all-rows(), moved);
        def dg-chosen(rows, moved) = rows |> filter(row => dg-guards?(row, moved));
        // each row's call, read once: [row, guards?]
        def dg-calls(rows, moved) = rows |> map(row => [row, dg-guards?(row, moved)]);
        def dg-called(calls) = calls |> filter(c => c[1]) |> map(c => c[0]);
        def dg-resting(calls) = calls |> filter(c => !c[1]) |> map(c => c[0]);
        // what moved since origin/main: committed, in the working tree, or untracked. The merge-base
        // is read once from git; a base that does not arrive reads nothing, and every row runs.
        // (git is asked by argv; the body reads its answer, no shell reads a line)
        def dg-git(args) = host_capture(cons("git", args)) ?? "";
        def dg-base() = trim(dg-git(["merge-base", "HEAD", "origin/main"]));
        def dg-moved() {
            let base = dg-base();
            (Comparable) len(base) == 0 ? nothing() : dg-paths(split-on(dg-git(["diff", "--name-only", base]) ++ "\n" ++ dg-git(["ls-files", "--others", "--exclude-standard"]), "\n"));
        }
        def dg-paths(lines) = nil?(lines) ? [] : (Comparable) len(trim(lines[0])) == 0 ? dg-paths(lines[1:]) : cons(trim(lines[0]), dg-paths(lines[1:]));
        def dg-rest-lines(rows) = nil?(rows) ? 0 : dg-rest-next(rows, print(dg-name(rows[0]) ++ "  sits out: its ground did not move"));
        def dg-rest-next(rows, said) = dg-rest-lines(rows[1:]);
        def dg-rows() {
            let moved = dg-moved();
            let calls = dg-calls(dg-all-rows(), moved);
            let chosen = dg-called(calls);
            let said = print("drift-gates ground: " ++ (nothing?(moved) ? "no merge-base with origin/main to read, every row runs" : (len(moved).str() ++ " paths moved since origin/main; " ++ len(chosen).str() ++ " of " ++ len(dg-all-rows()).str() ++ " rows guard them")));
            let rested = dg-rest-lines(dg-resting(calls));
            chosen;
        }

        // --- the cell's record: {value, out, diag, stopped, errors, ...} (docs/in-process-cells.md). A row
        // is one cell_run call with a deadline instead of a kill; its rc is 0 when the unit ran and ended
        // clean and 1 when it stopped or compiled with errors (what a spawned run showed as exit 1)
        def dg-deadline-ms() = 1800000;
        def dg-ran?(stopped) = nothing?(stopped) ? true : ((String) record_get(stopped, "kind") == "stop") || ((String) record_get(stopped, "kind") == "deadline");
        def dg-rc-of(r) = !nothing?(record_get(r, "stopped")) || (Comparable) record_get(r, "errors") > 0 ? 1 : 0;
        def dg-render(v) = (String) value_kind(v) == "int" ? v.str() : (String) value_kind(v) == "string" ? v : value_str(v);
        def dg-first-line(s) {
            let nl = str_find(s, byte_to_str(10), 0);
            nl < 0 ? s : substring(s, 0, nl);
        }
        // the last line a row speaks: the value it answered, or how it stopped
        def dg-last-of(r) {
            let stopped = record_get(r, "stopped");
            nothing?(stopped) ? dg-render(record_get(r, "value")) : (String) record_get(stopped, "kind") ++ ": " ++ dg-first-line((String) record_get(stopped, "message"));
        }
        // the value as a number, when the unit answered one
        def dg-int-of(r) = nothing?(record_get(r, "stopped")) && (String) value_kind(record_get(r, "value")) == "int" ? record_get(r, "value") : nothing();

        // --- the scratch a row may name: the mark @scratch@ in an input line becomes a fresh path in the temp
        // directory, and the path and whatever the cell left beside it (path.*) are removed when it returns
        def dg-scratch-mark() = "@scratch@";
        def dg-scratch(row) = temp_dir() ++ "/drift-gates-" ++ host_pid().str() ++ "-" ++ dg-name(row);
        def dg-fill(line, scratch) = dg-join(split-on(line, dg-scratch-mark()), scratch);
        def dg-input(row, scratch) = nothing?(dg-input-of(row)) ? nothing() : dg-input-of(row) |> map(l => dg-fill(l, scratch));
        def dg-beside?(name, stem) = dg-starts?(name, stem);
        def dg-sweep-scratch(scratch) {
            let stem = substring(scratch, len(temp_dir()) + 1, len(scratch));
            let names = fs_list(temp_dir()) ?? [];
            let gone = foldl((acc, n) => dg-beside?(n, stem) ? host_path_remove(temp_dir() ++ "/" ++ n) : acc, 0, names);
            host_path_remove(scratch);
        }

        // --- a reading: row, rc, last line, last int. What did not arrive reads nothing: a
        // unit that would not run at all (the call was refused, or the text would not read as a
        // program) has no rc and no value, never a pass.
        def dg-reading(row, rc, last, value) = [row, rc, last, value];
        def dg-reading-of(row, r) = dg-ran?(record_get(r, "stopped")) ? dg-reading(row, dg-rc-of(r), dg-last-of(r), dg-int-of(r)) : dg-reading(row, nothing(), "launch vanished: " ++ dg-last-of(r), nothing());
        def dg-read(row) {
            let scratch = dg-scratch(row);
            let r = cell_run(dg-unit(row), 0, dg-deadline-ms(), dg-input(row, scratch));
            let swept = dg-sweep-scratch(scratch);
            dg-reading-of(row, r);
        }
        def dg-exited-0?(reading) = nothing?(reading[1]) ? false : ((Comparable) reading[1] == 0);
        def dg-rc-text(rc) = nothing?(rc) ? "nothing" : rc.str();
        def dg-ok?(reading) {
            let want = dg-want(reading[0]);
            !dg-exited-0?(reading) ? 0 : ((Value) want == dg-exit-only()) ? 1 : nothing?(reading[3]) ? 0 : (Comparable) reading[3] == want ? 1 : 0;
        }

        // --- a row is a live step (form-stdlib/bml/live.bml): its reading is spoken as it lands, and
        // a red row is offered only the repairs that meet what it observed. A repair never touches a
        // tracked source: rebuild-fkwu meets a stale binary, giving binary-freshness a binary built
        // from today's runtime (a fresh inode, so the running gates keep theirs). Cached images need no
        // repair: fkwu reads them content-true and rebuilds a foreign one itself. A row no repair meets
        // refuses at once, and its reading names its need.
        // the C compiler is the one external tool the seed needs to be BUILT: begun by argv (no shell), the product
        // made beside the live binary and renamed over it
        def dg-streams() = ["/dev/null", "/dev/null", "/dev/null"];
        def dg-cc-argv() = ["cc", "-O2", "-o", "fkwu.next", "runtime/fkwu-uni.c"];
        def dg-cc-exit() {
            let pid = host_spawn_at(dg-cc-argv(), dg-streams());
            pid <= 0 ? nothing() : host_wait(pid);
        }
        def dg-rebuild-fkwu(row) {
            let built = dg-cc-exit();
            nothing?(built) || (Comparable) built != 0 ? nothing() : (Comparable) fs_rename("fkwu.next", "fkwu") == 0 ? row : nothing();
        }
        def dg-stale-binary?(observed, row) = (String) dg-name(row) == "binary-freshness";
        def dg-repairs() = [live-repair("rebuild-fkwu", dg-stale-binary?, dg-rebuild-fkwu)];
        def dg-sense(row) = dg-read(row);
        def dg-holds?(reading, row) = nothing?(reading) ? false : ((Comparable) dg-ok?(reading) == 1);

        // --- one line per gate
        def dg-verdict-word(ok, row, repaired) = (Comparable) ok == 1 ? ((Comparable) len(repaired) == 0 ? tg-span("good", "pass") : tg-span("good", "pass after " ++ repaired)) : tg-span("bad", "REFUSED") ++ "  -> " ++ dg-command(row);
        def dg-line(reading, ok, repaired) = dg-name(reading[0]) ++ "  rc=" ++ dg-rc-text(reading[1]) ++ "  " ++ reading[2] ++ "  " ++ dg-verdict-word(ok, reading[0], repaired);

        // --- the walk: bit doubles per row; pass and refused masks name the rows
        def dg-join-name(names, name) = (Comparable) len(names) == 0 ? name : names ++ "," ++ name;
        def dg-walk(rows, bit, pass, refused, names) = (Comparable) len(rows) == 0 ? [pass, refused, names] : dg-step(rows[0], rows[1:], bit, pass, refused, names);
        def dg-step(row, rest, bit, pass, refused, names) {
            let settled = live-do("drift-gates", dg-name(row), row, dg-sense, dg-holds?, dg-repairs());
            let reading = settled[1] ?? dg-reading(row, nothing(), "the gate's reading stopped", nothing());
            let ok = settled[0];
            print(dg-line(reading, ok, settled[2]));
            (Comparable) ok == 1 ? dg-walk(rest, bit * 2, pass + bit, refused, names) : dg-walk(rest, bit * 2, pass, refused + bit, dg-join-name(names, dg-name(row)));
        }
        def dg-pow2(n) = (Comparable) n == 0 ? 1 : (2 * dg-pow2(n - 1));
        def dg-full(rows) = dg-pow2(len(rows)) - 1;
        def dg-green?(pass, rows) = (Comparable) pass == dg-full(rows) ? 1 : 0;
        def dg-names-voice(names) = (Comparable) len(names) == 0 ? "-" : names;
        def dg-summary-line(pass, full, refused, names) = "drift-gates pass=" ++ pass.str() ++ " full=" ++ full.str() ++ " refused=" ++ refused.str() ++ " names=" ++ dg-names-voice(names);
        def dg-run(rows) {
            let walk = dg-walk(rows, 1, 0, 0, "");
            print(dg-summary-line(walk[0], dg-full(rows), walk[1], walk[2]));
            walk[0];
        }
        def dg-report() = dg-run(dg-rows());

        // --- rows stay sound as data: every row named, every unit present, names distinct
        def dg-name-in?(rows, name) = (Comparable) len(rows) == 0 ? 0 : (String) dg-name(rows[0]) == name ? 1 : dg-name-in?(rows[1:], name);
        def dg-rows-sound?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) len(dg-name(rows[0])) == 0 ? 0 : (Comparable) len(dg-unit(rows[0])) == 0 ? 0 : (Comparable) dg-name-in?(rows[1:], dg-name(rows[0])) == 1 ? 0 : dg-rows-sound?(rows[1:]);
    }
    0;
}
