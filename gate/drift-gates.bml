//////////////////////////////////////////////////////////////////////
//
// drift-gates.bml
//
// Executable BML. The DRIFT GATES as rows of DATA. Every mirror gate
// the body owns — native surface, op manifest, ontology, primitive
// registry, category contract, kernel conformance, structural
// boundary, binary freshness, ground, door links, release ledger —
// runs through one door: one host-exec per row, one pass bit per
// row, one fold. The number names the gate that refused. Adding a
// gate is adding a row.
//
// This unit is the organ; the door is gate/drift-gates-run.bml, the
// structural-gate / structural-gate-run shape. A preluded unit runs
// its top-level statement eagerly, so an organ the band and the land
// cadence prelude cannot also be the door. Run from the repository
// root:
//
//   ./fkwu gate/drift-gates-run.bml
//
// prints one line per gate (name, exit code of the child, last line
// of the gate, pass or REFUSED with the command to rerun), then
//
//   drift-gates pass=<fold> full=<mask> refused=<mask> names=<a,b | ->
//
// and answers the pass fold (full when every gate is green).
//
// Process exit: fkwu answers a Form value and keeps its own status,
// so the body's carrier (form/validate.sh) reads the value off the
// last line and turns a refusal into its own nonzero exit. The same
// conversion as one line, for a hand, a hook, or a cron breath —
// every line still shows (on stderr), the exit is nonzero when any
// gate refuses, and also when the door itself never answers:
//
//   ./fkwu gate/drift-gates-run.bml | tee /dev/stderr | grep -q ' refused=0 '
//
// The land cadence (form-stdlib/land-cadence.fk, lc-land; door
// form-stdlib/land-cadence-live.fk) reads dg-report before any
// landing act: a red gate lands nothing.
//
// Row shape: name, command, want. Each command runs in a subshell
// with stderr folded into stdout and its exit code appended as the
// last line (@rc=N). want is the Form verdict the gate answers on
// its last line (with exit 0); want = dg-exit-only() means exit 0 is
// the whole verdict (a gate that speaks in prose).
//
// A landing runs only the rows whose ground moved: each row names the paths it guards (dg-grounds),
// and a row whose ground no path since origin/main touches sits out, said so on its own line and
// absent from the fold, never a pass. A row with no ground named guards the whole tree and always
// runs. Every row that runs is a live step (form-stdlib/bml/live.bml): its reading is spoken on
// stderr as it lands, and a red row is offered only the repairs that meet what it observed before
// it refuses (see dg-repairs); the printed line says "pass after <repair>" when one made it hold.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/kernel-change.bml form-stdlib/bml/live.bml
//
// Proven by: gate/tests/drift-gates-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormDriftGates {
        thought drift-gates-pattern = list("gates-are-rows", "one-bit-per-gate", "exit-is-the-last-line", "red-lands-nothing", "names-travel");

        def dg-exit-only() = 0 - 1;
        def dg-row(name, command, want) = list(name, command, want);
        def dg-name(r) = r[0];
        def dg-command(r) = r[1];
        def dg-want(r) = r[2];

        // The substring-one-meaning row: substring is the door the tree stands
        // on — str_find, split-on, trim and char_at are recipes over it. On
        // 2026-09-07 the four kernels were found not to agree on what a cut
        // MEANS, twice over and silently: three panicked where fkwu clamped,
        // and three floored byte offsets to character starts where fkwu cut
        // bytes. The band pins the one meaning (bytes, clamped, never dies) so
        // a kernel that drifts back refuses here rather than at the next
        // multi-tongue row. This row watches fkwu's reading; the three
        // siblings answer the same band under form/validate.sh.
        //
        // The str-find-one-meaning row: the same story one door up. On
        // 2026-09-08 the search was found diverging twice over and silently —
        // fkwu answered a negative `from` back to the caller as a position
        // while the three siblings clamped it to 0, and those three snapped
        // `from` UP to a character start where fkwu counted bytes. Both were
        // measured before the heal. The band pins the one meaning (the byte
        // index at or after max(from,0), or -1) against a scan it builds from
        // str_byte_at on the arm under test, and its bit 512 is the only thing
        // in the tree that can see a snapped `from`.
        //
        // A row list is one statement: a comment BETWEEN rows ends it early and
        // the unit lowers with three parens still open. Comments live here.
        def dg-all-rows() = list(
            dg-row("native-surface", "./fkwu gate/native-surface.bml", 1),
            dg-row("op-manifest", "./fkwu gate/op-manifest.bml", 1),
            dg-row("ontology", "./fkwu gate/ontology.bml", 1),
            dg-row("reserved-heads", "./fkwu gate/reserved-heads.bml </dev/null", 1),
            dg-row("primitive-registry", "./fkwu gate/primitive-registry.bml", 1),
            dg-row("category-contract", "./fkwu gate/category-contract.bml", 1),
            dg-row("kernel-conformance", "./fkwu gate/kernel-conformance.bml", 1),
            dg-row("structural-gate", "./fkwu gate/structural-gate-run.fk", 1),
            dg-row("substring-one-meaning", "./fkwu form/form-stdlib/tests/substring-one-meaning-band.fk", 4095),
            dg-row("str-find-one-meaning", "./fkwu form/form-stdlib/tests/str-find-one-meaning-band.fk", 8191),
            dg-row("binary-freshness", "./fkwu form/form-stdlib/tests/binary-freshness-band.fk </dev/null", 31),
            dg-row("ground", "./fkwu bootstrap/ground.fk", 42),
            dg-row("door-links", "./fkwu observe/door-link-health-run.bml", 0),
            dg-row("release-ledger", "./fkwu form/form-stdlib/release-ledger.bml", dg-exit-only()));

        // --- a row's ground: the paths whose change it guards. The kernel rows guard the kernels
        // (the seed, the walkers, the siblings), the files they read, the floor they stand on and
        // their own source. structural-gate, binary-freshness (a rebase moves the runtime under a
        // binary with no path of its own in the diff), ground, door-links and release-ledger name no
        // ground: they guard the whole tree and always run. A row outside the ground that moved is
        // absent from the fold, never a fabricated pass.
        def dg-kernels() = list("runtime/", "walkers/", "form/form-kernel-go/", "form/form-kernel-rust/", "form/form-kernel-ts/", "form/form-stdlib/core.fk", "form/form-stdlib/table.bml", "form/form-stdlib/json.fk", "gate/lens-text.bml");
        def dg-grounds() = list(
            list("native-surface", append(dg-kernels(), list("form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/host-io-fs-fkwu-emit.fk", "form/form-stdlib/form-parse.fk", "form/form-stdlib/form-flatten.fk", "gate/native-surface.bml"))),
            list("op-manifest", append(dg-kernels(), list("flatten/", "form/form-stdlib/fkc-table-serialize.fk", "form/form-stdlib/native-op-manifest.fk", "form/form-stdlib/form-parse.fk", "gate/op-manifest.bml"))),
            list("ontology", append(dg-kernels(), list("form/form-stdlib/form-ontology.json", "gate/ontology.bml"))),
            list("reserved-heads", append(dg-kernels(), list("form/form-stdlib/fkwu-op-arity.fk", "gate/reserved-heads.bml"))),
            list("primitive-registry", append(dg-kernels(), list("form/form-stdlib/primitive-registry.fk", "form/form-stdlib/tests/primitive-registry-band.fk", "gate/primitive-registry.bml"))),
            list("category-contract", append(dg-kernels(), list("form/category-contract.json", "gate/category-contract.bml"))),
            list("kernel-conformance", append(dg-kernels(), list("gate/kernel-conformance.bml", "gate/kernel-change.bml"))),
            list("substring-one-meaning", append(dg-kernels(), list("form/form-stdlib/tests/substring-one-meaning-band.fk"))),
            list("str-find-one-meaning", append(dg-kernels(), list("form/form-stdlib/tests/str-find-one-meaning-band.fk"))));
        def dg-ground-of(grounds, name) = nil?(grounds) ? list() : (String) head(grounds)[0] == name ? head(grounds)[1] : dg-ground-of(tail(grounds), name);
        def dg-ground(row) = dg-ground-of(dg-grounds(), dg-name(row));
        def dg-starts?(s, p) = (str_len(s) >= str_len(p)) && ((String) substring(s, 0, str_len(p)) == p);
        def dg-touches?(paths, ground) = nil?(paths) ? false : dg-under?(head(paths), ground) ? true : dg-touches?(tail(paths), ground);
        def dg-under?(path, ground) = nil?(ground) ? false : dg-starts?(path, head(ground)) ? true : dg-under?(path, tail(ground));
        def dg-guards?(row, moved) = nil?(dg-ground(row)) || dg-touches?(moved, dg-ground(row));
        // the rows a change calls: every row when no merge-base can be read (moved is nothing)
        def dg-rows-for(moved) = dg-chosen(dg-all-rows(), moved);
        def dg-chosen(rows, moved) = nil?(rows) ? list() : nothing?(moved) || dg-guards?(head(rows), moved) ? cons(head(rows), dg-chosen(tail(rows), moved)) : dg-chosen(tail(rows), moved);
        def dg-resting(rows, moved) = nil?(rows) || nothing?(moved) ? list() : dg-guards?(head(rows), moved) ? dg-resting(tail(rows), moved) : cons(head(rows), dg-resting(tail(rows), moved));
        // what moved since origin/main: committed, in the working tree, or untracked
        def dg-moved() {
            let base = kc-base();
            (Comparable) str_len(base) == 0 ? nothing() : dg-paths(split-on(kc-sh("{ git diff --name-only " ++ base ++ "; git ls-files --others --exclude-standard; }"), "\n"));
        }
        def dg-paths(lines) = nil?(lines) ? list() : (Comparable) str_len(trim(head(lines))) == 0 ? dg-paths(tail(lines)) : cons(trim(head(lines)), dg-paths(tail(lines)));
        def dg-rest-lines(rows) = nil?(rows) ? 0 : dg-rest-next(rows, print(dg-name(head(rows)) ++ "  sits out: its ground did not move"));
        def dg-rest-next(rows, said) = dg-rest-lines(tail(rows));
        def dg-rows() {
            let moved = dg-moved();
            let chosen = dg-rows-for(moved);
            let said = print("drift-gates ground: " ++ (nothing?(moved) ? "no merge-base with origin/main to read, every row runs" : (int_to_str(len(moved)) ++ " paths moved since origin/main; " ++ int_to_str(len(chosen)) ++ " of " ++ int_to_str(len(dg-all-rows())) ++ " rows guard them")));
            let rested = dg-rest-lines(dg-resting(dg-all-rows(), moved));
            chosen;
        }

        // --- the carrier: subshell, stderr folded in, exit code as the last line
        def dg-mark() = "@rc=";
        def dg-wrap(command) = "( " ++ command ++ " ) 2>&1; echo " ++ dg-mark() ++ "$?";

        // --- reading a child's voice: rc after the last mark, body before it
        def dg-rfind-go(s, needle, from, last) {
            let i = str_find(s, needle, from);
            i < 0 ? last : dg-rfind-go(s, needle, i + 1, i);
        }
        def dg-rfind(s, needle) = dg-rfind-go(s, needle, 0, 0 - 1);
        def dg-digit?(c) = (ord(c) >= 48) && (ord(c) <= 57);
        def dg-int-end(seen, acc) = seen > 0 ? acc : nothing();
        def dg-int-go(s, i, acc, seen) = i >= str_len(s) ? dg-int-end(seen, acc) : (Comparable) dg-digit?(char_at(s, i)) == 1 ? dg-int-go(s, i + 1, (acc * 10) + (ord(char_at(s, i)) - 48), 1) : dg-int-end(seen, acc);
        def dg-int-at(s, i) = dg-int-go(s, i, 0, 0);
        def dg-rc(out) {
            let at = dg-rfind(out, dg-mark());
            at < 0 ? nothing() : dg-int-at(out, at + str_len(dg-mark()));
        }
        def dg-body(out) {
            let at = dg-rfind(out, dg-mark());
            at < 0 ? out : substring(out, 0, at);
        }
        def dg-strip-nl(s) = (Comparable) str_len(s) == 0 ? s : (Comparable) ord(char_at(s, str_len(s) - 1)) == 10 ? dg-strip-nl(substring(s, 0, str_len(s) - 1)) : s;
        def dg-last-line(s) {
            let t = dg-strip-nl(s);
            let nl = dg-rfind(t, byte_to_str(10));
            nl < 0 ? t : substring(t, nl + 1, str_len(t));
        }
        def dg-all-digits-go(s, i) = i >= str_len(s) ? 1 : (Comparable) dg-digit?(char_at(s, i)) == 1 ? dg-all-digits-go(s, i + 1) : 0;
        def dg-all-digits?(s) = (Comparable) str_len(s) == 0 ? 0 : dg-all-digits-go(s, 0);
        def dg-last-int(s) {
            let l = dg-last-line(s);
            (Comparable) dg-all-digits?(l) == 1 ? str_to_int(l) : nothing();
        }

        // --- a reading: row, rc, last line, last int. What did not arrive reads nothing: a
        // vanished launch (host-exec answers nothing) has no rc and no value, never a pass.
        def dg-reading(row, rc, last, value) = list(row, rc, last, value);
        def dg-read(row) {
            let out = host-exec(dg-wrap(dg-command(row)), "");
            nothing?(out) ? dg-reading(row, nothing(), "launch vanished", nothing()) : dg-reading(row, dg-rc(out), dg-last-line(dg-body(out)), dg-last-int(dg-body(out)));
        }
        def dg-exited-0?(reading) = nothing?(reading[1]) ? false : ((Comparable) reading[1] == 0);
        def dg-rc-text(rc) = nothing?(rc) ? "nothing" : int_to_str(rc);
        def dg-ok?(reading) {
            let want = dg-want(reading[0]);
            !dg-exited-0?(reading) ? 0 : value_eq(want, dg-exit-only()) ? 1 : nothing?(reading[3]) ? 0 : (Comparable) reading[3] == want ? 1 : 0;
        }

        // --- a row is a live step (form-stdlib/bml/live.bml): its reading is spoken as it lands, and
        // a red row is offered only the repairs that meet what it observed. A repair never touches a
        // tracked source: rebuild-fkwu meets a stale binary, giving binary-freshness a binary built
        // from today's runtime (a fresh inode, so the running gates keep theirs). Cached images need no
        // repair: fkwu reads them content-true and rebuilds a foreign one itself. A row no repair meets
        // refuses at once, and its reading names its need.
        def dg-rebuild-fkwu(row) {
            let out = host-exec("cc -O2 -o fkwu.next runtime/fkwu-uni.c && mv fkwu.next fkwu && echo rebuilt", "");
            nothing?(out) || (str_find(out, "rebuilt", 0) < 0) ? nothing() : row;
        }
        def dg-stale-binary?(observed, row) = (String) dg-name(row) == "binary-freshness";
        def dg-repairs() = list(live-repair("rebuild-fkwu", dg-stale-binary?, dg-rebuild-fkwu));
        def dg-sense(row) = dg-read(row);
        def dg-holds?(reading, row) = nothing?(reading) ? false : ((Comparable) dg-ok?(reading) == 1);

        // --- one line per gate
        def dg-verdict-word(ok, row, repaired) = (Comparable) ok == 1 ? ((Comparable) str_len(repaired) == 0 ? tg-span("good", "pass") : tg-span("good", "pass after " ++ repaired)) : tg-span("bad", "REFUSED") ++ "  -> " ++ dg-command(row);
        def dg-line(reading, ok, repaired) = dg-name(reading[0]) ++ "  rc=" ++ dg-rc-text(reading[1]) ++ "  " ++ reading[2] ++ "  " ++ dg-verdict-word(ok, reading[0], repaired);

        // --- the walk: bit doubles per row; pass and refused masks name the rows
        def dg-join-name(names, name) = (Comparable) str_len(names) == 0 ? name : names ++ "," ++ name;
        def dg-walk(rows, bit, pass, refused, names) = (Comparable) len(rows) == 0 ? list(pass, refused, names) : dg-step(head(rows), tail(rows), bit, pass, refused, names);
        def dg-step(row, rest, bit, pass, refused, names) {
            let settled = live-do("drift-gates", dg-name(row), row, dg-sense, dg-holds?, dg-repairs());
            let reading = settled[1] ?? dg-reading(row, nothing(), "the gate's reading stopped", nothing());
            let ok = settled[0];
            print(dg-line(reading, ok, settled[2]));
            (Comparable) ok == 1 ? dg-walk(rest, bit * 2, pass + bit, refused, names) : dg-walk(rest, bit * 2, pass, refused + bit, dg-join-name(names, dg-name(row)));
        }
        def dg-pow2(n) = (Comparable) n == 0 ? 1 : (2 * dg-pow2(n - 1));
        def dg-full(rows) = dg-pow2(len(rows)) - 1;
        def dg-green?(pass, rows) = (Comparable) pass == dg-full(rows) ? 1 : 0;
        def dg-names-voice(names) = (Comparable) str_len(names) == 0 ? "-" : names;
        def dg-summary-line(pass, full, refused, names) = "drift-gates pass=" ++ int_to_str(pass) ++ " full=" ++ int_to_str(full) ++ " refused=" ++ int_to_str(refused) ++ " names=" ++ dg-names-voice(names);
        def dg-run(rows) {
            let walk = dg-walk(rows, 1, 0, 0, "");
            print(dg-summary-line(walk[0], dg-full(rows), walk[1], walk[2]));
            walk[0];
        }
        def dg-report() = dg-run(dg-rows());

        // --- rows stay sound as data: every row named, every command present, names distinct
        def dg-name-in?(rows, name) = (Comparable) len(rows) == 0 ? 0 : (String) dg-name(head(rows)) == name ? 1 : dg-name-in?(tail(rows), name);
        def dg-rows-sound?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) str_len(dg-name(head(rows))) == 0 ? 0 : (Comparable) str_len(dg-command(head(rows))) == 0 ? 0 : (Comparable) dg-name-in?(tail(rows), dg-name(head(rows))) == 1 ? 0 : dg-rows-sound?(tail(rows));
    }
    0;
}
