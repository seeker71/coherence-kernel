//////////////////////////////////////////////////////////////////////
//
// drift-gates.bml
//
// Executable BML. The DRIFT GATES as rows of DATA. Every mirror gate
// the body owns — native surface, op manifest, ontology, primitive
// registry, category contract, kernel conformance, structural
// boundary, binary freshness, ground, door links, release ledger —
// runs through one door: one host-exec per row, one pass bit per
// row, one fold. The number names the gate that refused. Adding a
// gate is adding a row.
//
// This unit is the organ; the door is gate/drift-gates-run.bml, the
// structural-gate / structural-gate-run shape. A preluded unit runs
// its top-level statement eagerly, so an organ the band and the land
// cadence prelude cannot also be the door. Run from the repository
// root:
//
//   ./fkwu gate/drift-gates-run.bml
//
// prints one line per gate (name, exit code of the child, last line
// of the gate, pass or REFUSED with the command to rerun), then
//
//   drift-gates pass=<fold> full=<mask> refused=<mask> names=<a,b | ->
//
// and answers the pass fold (full when every gate is green).
//
// Process exit: fkwu answers a Form value and keeps its own status,
// so the body's carrier (form/validate.sh) reads the value off the
// last line and turns a refusal into its own nonzero exit. The same
// conversion as one line, for a hand, a hook, or a cron breath —
// every line still shows (on stderr), the exit is nonzero when any
// gate refuses, and also when the door itself never answers:
//
//   ./fkwu gate/drift-gates-run.bml | tee /dev/stderr | grep -q ' refused=0 '
//
// The land cadence (form-stdlib/land-cadence.fk, lc-land; door
// form-stdlib/land-cadence-live.fk) reads dg-report before any
// landing act: a red gate lands nothing.
//
// Row shape: name, command, want. Each command runs in a subshell
// with stderr folded into stdout and its exit code appended as the
// last line (@rc=N). want is the Form verdict the gate answers on
// its last line (with exit 0); want = dg-exit-only() means exit 0 is
// the whole verdict (the Python gates speak in prose).
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml
//
// Proven by: gate/tests/drift-gates-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormDriftGates {
        thought drift-gates-pattern = list("gates-are-rows", "one-bit-per-gate", "exit-is-the-last-line", "red-lands-nothing", "names-travel");

        def dg-exit-only() = sub(0, 1);
        def dg-row(name, command, want) = list(name, command, want);
        def dg-name(r) = nth(r, 0);
        def dg-command(r) = nth(r, 1);
        def dg-want(r) = nth(r, 2);

        def dg-rows() = list(
            dg-row("native-surface", "python3 form/scripts/validate_fkwu_native_surface.py", dg-exit-only()),
            dg-row("op-manifest", "python3 form/scripts/sync_native_op_manifest.py", dg-exit-only()),
            dg-row("ontology", "python3 form/scripts/validate_form_ontology.py", dg-exit-only()),
            dg-row("primitive-registry", "python3 form/scripts/validate_primitive_registry.py --quiet", dg-exit-only()),
            dg-row("category-contract", "python3 form/scripts/verify_category_contract.py", dg-exit-only()),
            dg-row("kernel-conformance", "python3 form/scripts/verify_kernel_conformance.py", dg-exit-only()),
            dg-row("structural-gate", "./fkwu gate/structural-gate-run.fk", 1),
            dg-row("binary-freshness", "./fkwu form/form-stdlib/tests/binary-freshness-band.fk </dev/null", 31),
            dg-row("ground", "./fkwu bootstrap/ground.fk", 42),
            dg-row("door-links", "./fkwu observe/door-link-health-run.bml", 0),
            dg-row("release-ledger", "./fkwu form/form-stdlib/release-ledger.bml", dg-exit-only()));

        // --- the carrier: subshell, stderr folded in, exit code as the last line
        def dg-mark() = "@rc=";
        def dg-wrap(command) = str_concat("( ", str_concat(command, str_concat(" ) 2>&1; echo ", str_concat(dg-mark(), "$?"))));

        // --- reading a child's voice: rc after the last mark, body before it
        def dg-rfind-go(s, needle, from, last) {
            let i = str_find(s, needle, from);
            if lt(i, 0) then last else dg-rfind-go(s, needle, add(i, 1), i);
        }
        def dg-rfind(s, needle) = dg-rfind-go(s, needle, 0, sub(0, 1));
        def dg-digit?(c) = and(ge(ord(c), 48), le(ord(c), 57));
        def dg-int-end(seen, acc) = if gt(seen, 0) then acc else sub(0, 1);
        def dg-int-go(s, i, acc, seen) = if ge(i, str_len(s)) then dg-int-end(seen, acc) else if eq(dg-digit?(char_at(s, i)), 1) then dg-int-go(s, add(i, 1), add(mul(acc, 10), sub(ord(char_at(s, i)), 48)), 1) else dg-int-end(seen, acc);
        def dg-int-at(s, i) = dg-int-go(s, i, 0, 0);
        def dg-rc(out) {
            let at = dg-rfind(out, dg-mark());
            if lt(at, 0) then sub(0, 1) else dg-int-at(out, add(at, str_len(dg-mark())));
        }
        def dg-body(out) {
            let at = dg-rfind(out, dg-mark());
            if lt(at, 0) then out else substring(out, 0, at);
        }
        def dg-strip-nl(s) = if eq(str_len(s), 0) then s else if eq(ord(char_at(s, sub(str_len(s), 1))), 10) then dg-strip-nl(substring(s, 0, sub(str_len(s), 1))) else s;
        def dg-last-line(s) {
            let t = dg-strip-nl(s);
            let nl = dg-rfind(t, byte_to_str(10));
            if lt(nl, 0) then t else substring(t, add(nl, 1), str_len(t));
        }
        def dg-all-digits-go(s, i) = if ge(i, str_len(s)) then 1 else if eq(dg-digit?(char_at(s, i)), 1) then dg-all-digits-go(s, add(i, 1)) else 0;
        def dg-all-digits?(s) = if eq(str_len(s), 0) then 0 else dg-all-digits-go(s, 0);
        def dg-last-int(s) {
            let l = dg-last-line(s);
            if eq(dg-all-digits?(l), 1) then str_to_int(l) else sub(0, 1);
        }

        // --- a reading: row, rc, last line, last int. A vanished launch
        // (host-exec answers nothing) reads as rc -1, never as a pass.
        def dg-reading(row, rc, last, value) = list(row, rc, last, value);
        def dg-read(row) {
            let out = host-exec(dg-wrap(dg-command(row)), "");
            if nothing?(out) then dg-reading(row, sub(0, 1), "launch vanished", sub(0, 1)) else dg-reading(row, dg-rc(out), dg-last-line(dg-body(out)), dg-last-int(dg-body(out)));
        }
        def dg-ok?(reading) {
            let want = dg-want(nth(reading, 0));
            if not(eq(nth(reading, 1), 0)) then 0 else if eq(want, dg-exit-only()) then 1 else if eq(nth(reading, 3), want) then 1 else 0;
        }

        // --- one line per gate
        def dg-verdict-word(ok, row) = if eq(ok, 1) then tg-span("good", "pass") else str_concat(tg-span("bad", "REFUSED"), str_concat("  -> ", dg-command(row)));
        def dg-line(reading, ok) = str_concat(dg-name(nth(reading, 0)), str_concat("  rc=", str_concat(int_to_str(nth(reading, 1)), str_concat("  ", str_concat(nth(reading, 2), str_concat("  ", dg-verdict-word(ok, nth(reading, 0))))))));

        // --- the walk: bit doubles per row; pass and refused masks name the rows
        def dg-join-name(names, name) = if eq(str_len(names), 0) then name else str_concat(names, str_concat(",", name));
        def dg-walk(rows, bit, pass, refused, names) = if eq(len(rows), 0) then list(pass, refused, names) else dg-step(head(rows), tail(rows), bit, pass, refused, names);
        def dg-step(row, rest, bit, pass, refused, names) {
            let reading = dg-read(row);
            let ok = dg-ok?(reading);
            print(dg-line(reading, ok));
            if eq(ok, 1) then dg-walk(rest, mul(bit, 2), add(pass, bit), refused, names) else dg-walk(rest, mul(bit, 2), pass, add(refused, bit), dg-join-name(names, dg-name(row)));
        }
        def dg-pow2(n) = if eq(n, 0) then 1 else mul(2, dg-pow2(sub(n, 1)));
        def dg-full(rows) = sub(dg-pow2(len(rows)), 1);
        def dg-green?(pass, rows) = if eq(pass, dg-full(rows)) then 1 else 0;
        def dg-names-voice(names) = if eq(str_len(names), 0) then "-" else names;
        def dg-summary-line(pass, full, refused, names) = str_concat("drift-gates pass=", str_concat(int_to_str(pass), str_concat(" full=", str_concat(int_to_str(full), str_concat(" refused=", str_concat(int_to_str(refused), str_concat(" names=", dg-names-voice(names))))))));
        def dg-run(rows) {
            let walk = dg-walk(rows, 1, 0, 0, "");
            print(dg-summary-line(nth(walk, 0), dg-full(rows), nth(walk, 1), nth(walk, 2)));
            nth(walk, 0);
        }
        def dg-report() = dg-run(dg-rows());

        // --- rows stay sound as data: every row named, every command present, names distinct
        def dg-name-in?(rows, name) = if eq(len(rows), 0) then 0 else if str_eq(dg-name(head(rows)), name) then 1 else dg-name-in?(tail(rows), name);
        def dg-rows-sound?(rows) = if eq(len(rows), 0) then 1 else if eq(str_len(dg-name(head(rows))), 0) then 0 else if eq(str_len(dg-command(head(rows))), 0) then 0 else if eq(dg-name-in?(tail(rows), dg-name(head(rows))), 1) then 0 else dg-rows-sound?(tail(rows));
    }
    0;
}
