// fkwu is the only runtime. This gate holds it, and the native Form codec, to values the body has
// pinned: thirteen canonical expressions with their exact renderings (form/conformance/
// canonical-s-expression-vectors.json), one FORMBIN2 artifact and twelve malformed ones.
//
// The pinned values are what the Go, Rust and TypeScript kernels agreed on when they were still
// asked: all three rendered every canonical expression to the fixture's expected text, all three
// emitted the same 119 FORMBIN2 bytes for (list "fkb-interop" 42 2147483648 3.5) -- those bytes
// and their SHA-256 stand below as literals -- and all three, with the Form codec, refused each
// malformed artifact with the fixture's words. Today fkwu runs each expression and renders it,
// the codec decodes the pinned bytes to the one rendering fkwu computes from the source and
// re-encodes them byte for byte, the codec's own artifact equals its pinned bytes, and every
// malformed artifact is refused with its expected diagnostic. Numeric payloads remain raw
// int64/float64 bits in the codec.
//
// The organ holds no top-level run (a preluded unit runs its statement eagerly); the door is
// gate/canonical-conformance-run.bml: ./fkwu gate/canonical-conformance-run.bml -> 1 when all
// observations pass. Witness: gate/tests/canonical-conformance-band.fk.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk form-stdlib/bml/formbin-codec.bml form-stdlib/bml/native-fp64-bytes.bml

section [form.bml] {
    class FormCanonicalConformanceGate {
        thought canonical-conformance-pattern = ["one-runtime-pinned-values", "absent-is-a-typed-reading", "pinned-bytes-are-the-interop-witness", "native-codec-bidirectional-roundtrip"];

        def cvg-name() = "canonical-conformance";
        def cvg-vectors() = "form/conformance/canonical-s-expression-vectors.json";
        def cvg-malformed() = "form/conformance/formbin2-malformed-vectors.json";
        def cvg-schema() = "form-canonical-conformance-v1";
        def cvg-malformed-schema() = "formbin2-malformed-conformance-v1";
        def cvg-max-bytes() = 67108864;
        def cvg-when(cond, msg) = cond ? [msg] : [];
        def cvg-py(s) = lx-py-str(s);

        // ---- the pinned FORMBIN2 witnesses, read at base from the kernels' own artifacts ----
        def cvg-interop-source() = "(list \"fkb-interop\" 42 2147483648 3.5)";
        def cvg-interop-expected() = "[fkb-interop, 42, 2147483648, 3.5]";
        // the 119 bytes Go, Rust and TypeScript each emitted for the source above (byte-identical)
        def cvg-interop-hex() = "464f524d42494e32000000010000000b666b622d696e7465726f70000000010000000000000001000000020000002200000001000000040000000000000001000000010000000200000000000000000000000100000001000000010000002a000000030000008000000000000000020000000000000c40";
        def cvg-interop-sha256() = "9b5d11cea5d33e034b06fdd8284f3e9af5f6fee7ab16a288733f3ca2d9b46b89";
        // the 121 bytes the Form codec wrote for kcg's root and every kernel executed
        def cvg-form-expected() = "[form-formbin2, 42, 2147483648, 3.5]";
        def cvg-form-hex() = "464f524d42494e32000000010000000d666f726d2d666f726d62696e32000000010000000000000001000000020000002200000001000000040000000000000001000000010000000200000000000000000000000100000001000000010000002a000000030000008000000000000000020000000000000c40";
        def cvg-form-sha256() = "e972dda82f28009fc7f6ba4e96d41a6f64c0e1c214ed32f9efc7ec72436c4b1f";

        // ---- the vectors: list("ok", cases) or list("refused", message); a case is (name form expected) ----
        def cvg-cases(path, text) {
            let root = parse-json(path, text);
            !json-object-has?(root, "schema") ? ["refused", path ++ ": unsupported conformance schema"]
            : !((String) node_value(json-object-get(root, "schema")) == cvg-schema()) ? ["refused", path ++ ": unsupported conformance schema"]
            : !json-object-has?(root, "cases") ? ["refused", path ++ ": cases must be a non-empty list"]
            : cvg-cases-list(path, node_children(json-object-get(root, "cases")));
        }
        def cvg-cases-list(path, nodes) = (Comparable) len(nodes) == 0 ? ["refused", path ++ ": cases must be a non-empty list"] : cvg-cases-go(path, nodes, 0, []);
        def cvg-cases-go(path, nodes, i, acc) {
            (Comparable) len(nodes) == 0 ? ["ok", reverse(acc)]
            : cvg-case-one(path, nodes[0], nodes[1:], i, acc);
        }
        def cvg-case-one(path, node, rest, i, acc) {
            (Comparable) cvg-field-ok?(node, "name") == 0 ? ["refused", path ++ ": case " ++ i.str() ++ " has invalid name"]
            : (Comparable) cvg-field-ok?(node, "form") == 0 ? ["refused", path ++ ": case " ++ i.str() ++ " has invalid form"]
            : (Comparable) cvg-field-ok?(node, "expected") == 0 ? ["refused", path ++ ": case " ++ i.str() ++ " has invalid expected"]
            : cvg-cases-go(path, rest, i + 1, cons([node_value(json-object-get(node, "name")), node_value(json-object-get(node, "form")), node_value(json-object-get(node, "expected"))], acc));
        }
        // a present string field with at least one byte (node_type 2 is a trivial string)
        def cvg-field-ok?(node, key) = !json-object-has?(node, key) ? 0 : !((Comparable) node_type(json-object-get(node, key)) == 2) ? 0 : (Comparable) len(node_value(json-object-get(node, key))) == 0 ? 0 : 1;
        def cvg-c-name(c) = c[0];
        def cvg-c-form(c) = c[1];
        def cvg-c-expected(c) = c[2];

        // ---- one expression on fkwu: the form is written to a unit of its own and the running
        // fkwu is asked for it, as `./fkwu <unit>` answers; the unit and the images fkwu keeps
        // beside it leave with the reading ----
        def cvg-scratch(tag) = temp_dir() ++ "/canonical-conformance-" ++ host_pid().str() ++ "-" ++ tag;
        def cvg-leave(path) {
            let a = fs_remove(path);
            let b = fs_remove(path ++ ".fkb");
            let c = fs_remove(path ++ ".sym");
            0;
        }
        def cvg-run-expr(form, tag) {
            let path = cvg-scratch(tag) ++ ".fk";
            let wrote = write_file(path, form ++ lx-nl());
            let r = lx-sh-out("./fkwu " ++ path ++ " </dev/null");
            let left = cvg-leave(path);
            (Comparable) lx-sh-rc(r) == 0 ? lx-sh-text(r) : "<fkwu exit " ++ lx-sh-rc(r).str() ++ ">";
        }
        def cvg-rendered(o) = "fkwu=" ++ cvg-py(o);
        def cvg-case-line(c, i) {
            let out = cvg-run-expr(cvg-c-form(c), "case-" ++ i.str());
            let passed = (String) out == cvg-c-expected(c) ? 1 : 0;
            [passed, ((Comparable) passed == 1 ? "PASS " : "FAIL ") ++ cvg-c-name(c) ++ ": " ++ cvg-rendered(out)];
        }
        def cvg-case-lines(cases, i) = (Comparable) len(cases) == 0 ? [] : cons(cvg-case-line(cases[0], i), cvg-case-lines(cases[1:], i + 1));
        def cvg-passed-count(results) = len(filter(r => (Comparable) r[0] == 1, results));
        def cvg-line-of(r) = r[1];

        // ---- hex to bytes, in Form; a nibble that is not a hex digit answers -1 and poisons its byte ----
        def cvg-nibble(c) = (c >= 48) && (c <= 57) ? (c - 48) : (c >= 97) && (c <= 102) ? (c - 87) : (c >= 65) && (c <= 70) ? (c - 55) : (0 - 1);
        def cvg-hex-bytes(hex, i, n, acc) {
            (i + 2) > n ? reverse(acc)
            : cvg-hex-step(hex, i, n, acc, cvg-nibble(str_byte_at(hex, i)), cvg-nibble(str_byte_at(hex, i + 1)));
        }
        def cvg-hex-step(hex, i, n, acc, hi, lo) = (hi < 0) || (lo < 0) ? reverse(acc) : cvg-hex-bytes(hex, i + 2, n, cons((hi * 16) + lo, acc));
        // the bytes as one string, as read_file holds them
        def cvg-bytes-str(bytes, acc) = (Comparable) len(bytes) == 0 ? acc : cvg-bytes-str(bytes[1:], acc ++ byte_to_str(bytes[0]));
        def cvg-hex-str(hex) = cvg-bytes-str(cvg-hex-bytes(hex, 0, len(hex), []), "");

        // ---- a decoded artifact in the one rendering: a composite is its children in brackets, a string
        // is itself, a trivial int leaf (level 1, type 1) its instance, a raw number its value ----
        def cvg-int-of(raw) = nfb-le(raw, 0, 8);
        def cvg-render(node) {
            (Comparable) node[0] == 1 ? "[" ++ tb-join(node[2], cvg-render, ", ") ++ "]"
            : (Comparable) node[0] == 4 ? node[2]
            : (Comparable) node[0] == 3 ? cvg-int-of(node[1]).str()
            : (Comparable) node[0] == 2 ? nfb-f64(node[1]).str()
            : ((Comparable) node[2] == 1) && ((Comparable) node[3] == 1) ? node[4].str()
            : "@" ++ node[1].str() ++ "." ++ node[2].str() ++ "." ++ node[3].str() ++ "." ++ node[4].str();
        }

        // ---- the pinned interop witness: list(passed?, line, errors) ----
        // the source fkwu computes and the artifact the kernels agreed on render alike; the artifact is
        // held to its SHA-256, decodes in the Form codec and re-encodes byte for byte
        def cvg-interop() {
            let computed = cvg-run-expr(cvg-interop-source(), "interop");
            let bytes = cvg-hex-str(cvg-interop-hex());
            let decoded = fbc-decode(bytes);
            let errors = append(cvg-when(!((String) computed == cvg-interop-expected()), "fkwu rendered the interop source as " ++ cvg-py(computed) ++ ", pinned " ++ cvg-py(cvg-interop-expected())),
                         append(cvg-when(!((Comparable) len(bytes) == 119), "the pinned interop hex is " ++ len(bytes).str() ++ " bytes, not 119"),
                         append(cvg-when(!((String) fbc-hash(bytes) == cvg-interop-sha256()), "the pinned interop bytes do not hold their SHA-256"),
                                cvg-interop-decoded(bytes, decoded))));
            [(Comparable) len(errors) == 0 ? 1 : 0,
                 (Comparable) len(errors) == 0 ? "PASS FORMBIN2: the pinned kernel artifact (119 bytes) decodes to the rendering fkwu computes and re-encodes byte for byte" : "FAIL FORMBIN2: see the errors below",
                 errors];
        }
        def cvg-interop-decoded(bytes, decoded) = !fbc-good(decoded) ? ["the Form codec refused the pinned artifact: " ++ fbc-error(decoded)]
            : append(cvg-when(!((String) cvg-render(fbc-value(decoded)) == cvg-interop-expected()), "the pinned artifact decodes to " ++ cvg-py(cvg-render(fbc-value(decoded))) ++ ", not " ++ cvg-py(cvg-interop-expected())), cvg-repacked(bytes, fbc-encode(fbc-value(decoded)), "the pinned kernel artifact"));
        def cvg-repacked(bytes, encoded, what) = !fbc-good(encoded) ? [what ++ " re-encoding failed: " ++ fbc-error(encoded)] : cvg-when(!((String) bytes == fbc-value(encoded)), "the Form codec did not byte-roundtrip " ++ what);

        // ---- the codec's own artifact equals the bytes every kernel once executed: list(errors) ----
        def cvg-native-root() = fbc-composite(fbc-leaf(1, 2, 34, 1), [fbc-string(1, "form-formbin2"), fbc-leaf(1, 1, 1, 42), fbc-number(3, fbc-word(128) ++ fbc-word(0)), fbc-number(2, fbc-word(0) ++ fbc-word(3136))]);
        def cvg-native() {
            let encoded = fbc-encode(cvg-native-root());
            !fbc-good(encoded) ? ["Form codec emission failed: " ++ fbc-error(encoded)]
            : append(cvg-when(!((String) fbc-value(encoded) == cvg-hex-str(cvg-form-hex())), "the Form codec's artifact is not its pinned bytes"),
                     append(cvg-when(!((String) fbc-hash(fbc-value(encoded)) == cvg-form-sha256()), "the Form codec's artifact does not hold its pinned SHA-256"),
                            cvg-native-decoded(fbc-value(encoded), fbc-decode(fbc-value(encoded)))));
        }
        def cvg-native-decoded(bytes, decoded) = !fbc-good(decoded) ? ["the Form codec refused its own artifact: " ++ fbc-error(decoded)]
            : append(cvg-when(!((String) cvg-render(fbc-value(decoded)) == cvg-form-expected()), "the Form codec's artifact decodes to " ++ cvg-py(cvg-render(fbc-value(decoded))) ++ ", not " ++ cvg-py(cvg-form-expected())), cvg-repacked(bytes, fbc-encode(fbc-value(decoded)), "the Form codec's own artifact"));

        // ---- the malformed vectors: rows (name builder value-or-depth expected) ----
        def cvg-malformed-cases(path, text) {
            let root = parse-json(path, text);
            !json-object-has?(root, "schema") ? ["refused", path ++ ": unsupported malformed-vector schema"]
            : !((String) node_value(json-object-get(root, "schema")) == cvg-malformed-schema()) ? ["refused", path ++ ": unsupported malformed-vector schema"]
            : !json-object-has?(root, "cases") ? ["refused", path ++ ": cases must be a non-empty list"]
            : cvg-malformed-list(path, node_children(json-object-get(root, "cases")), 0, []);
        }
        def cvg-malformed-list(path, nodes, i, acc) {
            (Comparable) len(nodes) == 0 ? cvg-malformed-done(path, acc)
            : cvg-malformed-one(path, nodes[0], nodes[1:], i, acc);
        }
        def cvg-malformed-done(path, acc) = (Comparable) len(acc) == 0 ? ["refused", path ++ ": cases must be a non-empty list"] : ["ok", reverse(acc)];
        def cvg-malformed-one(path, node, rest, i, acc) {
            ((Comparable) cvg-field-ok?(node, "name") == 0) || ((Comparable) cvg-field-ok?(node, "expected_error") == 0) ? ["refused", path ++ ": case " ++ i.str() ++ " has invalid metadata"]
            : cvg-malformed-list(path, rest, i + 1, cons([node_value(json-object-get(node, "name")), cvg-str-field(node, "builder"), cvg-builder-arg(node), node_value(json-object-get(node, "expected_error"))], acc));
        }
        def cvg-str-field(node, key) = json-object-has?(node, key) ? node_value(json-object-get(node, key)) : "";
        // hex keeps its text; nested-composite keeps its depth as text; oversized carries nothing
        def cvg-builder-arg(node) = json-object-has?(node, "value") ? node_value(json-object-get(node, "value")) : json-object-has?(node, "depth") ? node_value(json-object-get(node, "depth")).str() : "";
        def cvg-m-name(m) = m[0];
        def cvg-m-builder(m) = m[1];
        def cvg-m-arg(m) = m[2];
        def cvg-m-expected(m) = m[3];
        // the nested composite as hex: leaf = five u32 words; node = u32(1) leaf u32(1) node, depth times; FORMBIN2 u32(0) node
        def cvg-u32(n) = cvg-hex8(n, 8, "");
        def cvg-hex8(n, k, acc) = (Comparable) k == 0 ? acc : cvg-hex8(n / 16, k - 1, cvg-hex-digit(n % 16) ++ acc);
        def cvg-hex-digit(d) = substring("0123456789abcdef", d, d + 1);
        def cvg-leaf-hex() = cvg-u32(0) ++ cvg-u32(1) ++ cvg-u32(1) ++ cvg-u32(1) ++ cvg-u32(0);
        def cvg-nested-hex(depth, node) = depth <= 0 ? node : cvg-nested-hex(depth - 1, cvg-u32(1) ++ cvg-leaf-hex() ++ cvg-u32(1) ++ node);
        def cvg-magic-hex() = "464f524d42494e32";
        def cvg-composite-hex(depth) = cvg-magic-hex() ++ cvg-u32(0) ++ cvg-nested-hex(depth, cvg-leaf-hex());
        // build the artifact file; answers list() or one error
        def cvg-build-malformed(m, i) {
            let base = cvg-scratch("malformed-" ++ i.str());
            (String) cvg-m-builder(m) == "hex" ? cvg-hex-file(base, cvg-m-arg(m))
            : (String) cvg-m-builder(m) == "nested-composite" ? cvg-hex-file(base, cvg-composite-hex(str_to_int(cvg-m-arg(m))))
            : (String) cvg-m-builder(m) == "oversized-artifact" ? cvg-oversized-file(base)
            : ["malformed case " ++ cvg-m-name(m) ++ ": unknown builder " ++ cvg-py(cvg-m-builder(m))];
        }
        def cvg-hex-file(base, hex) {
            let path = base ++ ".fkb";
            let cleared = (Comparable) fs_exists(path) == 1 ? fs_remove(path) : 0;
            let bytes = cvg-hex-bytes(hex, 0, len(hex), []);
            let wrote = host_file_append_bytes(path, bytes);
            cvg-when((wrote < 0) || (!((Comparable) (len(bytes) * 2) == len(hex))), "could not build a malformed artifact from hex: wrote " ++ wrote.str() ++ " of " ++ (len(hex) / 2).str());
        }
        // One byte over the ceiling, made by naming its length: the header is eight real bytes and
        // fs_truncate sets the extent, sparse, so the file whose whole point is how long it is costs nothing.
        def cvg-oversized-file(base) {
            let path = base ++ ".fkb";
            let cleared = (Comparable) fs_exists(path) == 1 ? fs_remove(path) : 0;
            let header = host_file_append_bytes(path, [70, 79, 82, 77, 66, 73, 78, 50]);
            let want = cvg-max-bytes() + 1;
            let got = fs_truncate(path, want);
            cvg-when((header < 0) || (!((Comparable) got == want)), "could not build the oversized artifact: extent " ++ got.str() ++ " of " ++ want.str());
        }
        // one malformed vector in the Form codec: list(passed?, line, errors); the artifact leaves with the reading
        def cvg-malformed-line(m, i) {
            let built = cvg-build-malformed(m, i);
            len(built) > 0 ? [0, "FAIL malformed FORMBIN2 " ++ cvg-m-name(m), built] : cvg-malformed-judge(m, i);
        }
        def cvg-malformed-judge(m, i) {
            let artifact = cvg-scratch("malformed-" ++ i.str()) ++ ".fkb";
            let native = fbc-load(artifact);
            let left = fs_remove(artifact);
            let errors = cvg-when(fbc-good(native) || (!((String) fbc-error(native) == cvg-m-expected(m))), "Form codec accepted or misclassified " ++ cvg-m-name(m) ++ ": " ++ fbc-error(native));
            [(Comparable) len(errors) == 0 ? 1 : 0,
                 ((Comparable) len(errors) == 0 ? "PASS malformed FORMBIN2 " : "FAIL malformed FORMBIN2 ") ++ cvg-m-name(m) ++ ": refused with " ++ cvg-py(cvg-m-expected(m)),
                 errors];
        }
        def cvg-malformed-lines(ms, i) = (Comparable) len(ms) == 0 ? [] : cons(cvg-malformed-line(ms[0], i), cvg-malformed-lines(ms[1:], i + 1));
        def cvg-errors-of(results) = (Comparable) len(results) == 0 ? [] : append(results[0][2], cvg-errors-of(results[1:]));

        // ---- the analysis: list(status, case-results, interop-result, malformed-results, errors, native-errors, case-count) ----
        def cvg-refusal(msg) = ["refused", [], [0, "", []], [], [msg], [], 0];
        def cvg-analysis() {
            let text = read_file(cvg-vectors());
            let mtext = read_file(cvg-malformed());
            nothing?(text) ? cvg-refusal("missing input: " ++ cvg-vectors())
            : nothing?(mtext) ? cvg-refusal("missing input: " ++ cvg-malformed())
            : cvg-analysis-cases(cvg-cases(cvg-vectors(), text), cvg-malformed-cases(cvg-malformed(), mtext));
        }
        def cvg-analysis-cases(cases, ms) {
            (String) cases[0] == "refused" ? cvg-refusal(cases[1])
            : (String) ms[0] == "refused" ? cvg-refusal(ms[1])
            : cvg-analysis-run(cases[1], ms[1]);
        }
        def cvg-analysis-run(cases, ms) {
            let results = cvg-case-lines(cases, 0);
            let interop = cvg-interop();
            let native = cvg-native();
            let malformed = cvg-malformed-lines(ms, 0);
            let failed = filter(r => !((Comparable) r[0] == 1), results);
            let errors = append(tb-map(failed, r => "canonical expression diverged: " ++ substring(r[1], 5, len(r[1]))), append(interop[2], append(native, cvg-errors-of(malformed))));
            [(Comparable) len(errors) == 0 ? "pass" : "fail", results, interop, malformed, errors, native, len(cases)];
        }
        def cvg-a-status(a) = a[0];
        def cvg-a-results(a) = a[1];
        def cvg-a-interop(a) = a[2];
        def cvg-a-malformed(a) = a[3];
        def cvg-a-errors(a) = a[4];
        def cvg-a-native(a) = a[5];
        def cvg-a-cases(a) = a[6];

        // ---- the voice ----
        def cvg-summary(a) = cvg-a-cases(a).str() ++ " canonical expressions on fkwu; the pinned FORMBIN2 artifacts; " ++ len(cvg-a-malformed(a)).str() ++ " malformed artifacts refused";
        def cvg-fail-summary(a) = cvg-passed-count(cvg-a-results(a)).str() ++ "/" ++ cvg-a-cases(a).str() ++ " canonical expressions on fkwu; FORMBIN2 interop " ++ ((Comparable) cvg-a-interop(a)[0] == 1 ? "green" : "red") ++ "; " ++ cvg-passed-count(cvg-a-malformed(a)).str() ++ "/" ++ len(cvg-a-malformed(a)).str() ++ " malformed artifacts refused";
        def cvg-print-lines(lines) = lx-print-prefixed("", lines);
        def cvg-judge() {
            let a = cvg-analysis();
            cvg-print-lines(tb-map(cvg-a-results(a), cvg-line-of));
            cvg-print-lines(cvg-when(len(cvg-a-results(a)) > 0, cvg-a-interop(a)[1]));
            cvg-print-lines(tb-map(cvg-a-malformed(a), cvg-line-of));
            lx-verdict-full(cvg-name(), [], cvg-a-errors(a), cvg-summary(a), (String) cvg-a-status(a) == "refused" ? "" : cvg-fail-summary(a));
        }
        def cvg-run() = cvg-judge();
    }
    0;
}
