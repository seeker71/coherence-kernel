// Native Form lens for ontology agreement across the proof siblings.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk
section [form.bml] {
    class FormOntologyGate {
        thought ontology-pattern = ["json-is-the-grammar", "arms-read-as-the-script-reads-them", "fall-through-takes-the-next-reading", "words-not-operators", "twin-voice-byte-for-byte"];

        def ong-name() = "ontology";
        def ong-json() = "form/form-stdlib/form-ontology.json";
        def ong-go() = "form/form-kernel-go/main.go";
        def ong-rust() = "form/form-kernel-rust/src/main.rs";
        def ong-ts() = "form/form-kernel-ts/src/reader.ts";
        def ong-ts-kernel() = "form/form-kernel-ts/src/kernel.ts";
        def ong-contract() = "form/category-contract.json";
        def ong-kernels() = ["form-kernel-go", "form-kernel-rust", "form-kernel-ts"];
        def ong-none() = 0 - 1;
        def ong-when(cond, msg) = cond ? [msg] : [];
        def ong-py(s) = lx-py-str(s);

        // ---- the script's tables as rows ----
        def ong-type-label(ty) = (Comparable) ty == 12 ? "math" : (Comparable) ty == 13 ? "compare" : (Comparable) ty == 14 ? "logic" : "";
        def ong-prim-label?(label) = ((String) label == "math") || (((String) label == "compare") || ((String) label == "logic")) ? 1 : 0;
        def ong-alias-row(name, accept) = [name, accept];
        // the accepted handlers, already sorted (the script prints sorted(accept))
        def ong-aliases() = [ong-alias-row("do", ["do"]), ong-alias-row("sequence", []), ong-alias-row("let", ["let"]), ong-alias-row("if-then", ["if"]), ong-alias-row("if", ["if"]), ong-alias-row("match", []), ong-alias-row("fndef", ["defn"]), ong-alias-row("fncall", []), ong-alias-row("ident", [])];
        def ong-cat-map(kind) = (String) kind == "go" ? [["catMath", "math"], ["catCompare", "compare"], ["catLogic", "logic"], ["catBlock", "block"], ["catCond", "cond"], ["catMatch", "match"], ["catFnDef", "fndef"], ["catFnCall", "fncall"], ["catIdent", "ident"]]
            : [["cat_math", "math"], ["cat_compare", "compare"], ["cat_logic", "logic"], ["cat_block", "block"], ["cat_cond", "cond"], ["cat_match", "match"], ["cat_fndef", "fndef"], ["cat_fncall", "fncall"], ["cat_ident", "ident"]];
        def ong-rbasic-map() = [["MATH", "math"], ["COMPARE", "compare"], ["LOGIC", "logic"], ["MATCH", "match"], ["BLOCK", "block"], ["COND", "cond"], ["FNDEF", "fndef"], ["FNCALL", "fncall"], ["IDENT", "ident"], ["LIST", "list"]];
        def ong-map-named?(row, name) = (String) row[0] == name ? 1 : 0;
        def ong-map-get(rows, name) {
            let row = tb-find2(rows, ong-map-named?, name);
            (Comparable) len(row) == 0 ? "" : row[1];
        }

        // ---- the ontology: rows (name type inst) from an array of objects ----
        def ong-rows(root, key) = json-object-has?(root, key) ? tb-map(node_children(json-object-get(root, key)), ong-row-of) : [];
        def ong-row-of(obj) = [node_value(json-object-get(obj, "name")), node_value(json-object-get(obj, "type")), node_value(json-object-get(obj, "inst"))];
        def ong-r-name(r) = r[0];
        def ong-r-type(r) = r[1];
        def ong-r-inst(r) = r[2];
        def ong-r-named?(r, name) = (String) r[0] == name ? 1 : 0;

        // ---- the brace block: strings ("', `) with escapes, // and /* */ unseen; answers the index of the matching } or -1 ----
        def ong-quote?(b) = ((Comparable) b == 34) || (((Comparable) b == 39) || ((Comparable) b == 96)) ? 1 : 0;
        def ong-brace-end(text, i, depth) {
            i >= len(text) ? (0 - 1)
            : (Comparable) ong-quote?(str_byte_at(text, i)) == 1 ? ong-brace-end(text, ong-string-end(text, i + 1, str_byte_at(text, i)) + 1, depth)
            : (Comparable) lx-at?(text, i, "//") == 1 ? ong-brace-end(text, ong-line-end(text, i), depth)
            : (Comparable) lx-at?(text, i, "/*") == 1 ? ong-brace-end(text, ong-comment-end(text, i), depth)
            : (Comparable) str_byte_at(text, i) == 123 ? ong-brace-end(text, i + 1, depth + 1)
            : (Comparable) str_byte_at(text, i) == 125 ? ong-brace-close(text, i, depth)
            : ong-brace-end(text, i + 1, depth);
        }
        def ong-brace-close(text, i, depth) = depth <= 1 ? i : ong-brace-end(text, i + 1, depth - 1);
        // the index of the closing quote (or the text's end): a backslash skips the next byte
        def ong-string-end(text, j, quote) {
            j >= len(text) ? j
            : (Comparable) str_byte_at(text, j) == quote ? j
            : (Comparable) str_byte_at(text, j) == 92 ? ong-string-end(text, j + 2, quote)
            : ong-string-end(text, j + 1, quote);
        }
        def ong-line-end(text, i) {
            let nl = str_find(text, lx-nl(), i);
            nl < 0 ? len(text) : (nl + 1);
        }
        def ong-comment-end(text, i) {
            let e = str_find(text, "*/", i + 2);
            e < 0 ? len(text) : (e + 2);
        }

        // ---- locating the dispatch function: the "{" of its body, or -1 ----
        // Go: func (...) buildVerb(...) ... then the brace; Rust: fn build_verb(...) ... then the brace.
        // TypeScript reads its verbs from the VERBS table instead (ong-ts-table).
        // (A comment line may not END with an open brace: the BML section scanner reads lines, comments included, and counts one.)
        def ong-fn-open(text, kind) {
            (String) kind == "go" ? ong-open-after(text, ong-go-head(text, 0))
            : ong-open-after(text, ong-word-head(text, "fn", "build_verb", 0));
        }
        // func\s+\([^)]*\)\s+buildVerb : the "func" whose parenthesised receiver is followed by the name
        def ong-go-head(text, from) {
            let i = str_find(text, "func", from);
            i < 0 ? (0 - 1) : ong-go-head-at(text, i, lx-skip-ws(text, i + 4));
        }
        def ong-go-head-at(text, i, k) {
            (Comparable) k == (i + 4) ? ong-go-head(text, i + 1)
            : (Comparable) lx-at?(text, k, "(") == 0 ? ong-go-head(text, i + 1)
            : ong-go-head-recv(text, i, str_find(text, ")", k));
        }
        def ong-go-head-recv(text, i, c) {
            c < 0 ? (0 - 1) : ong-go-head-name(text, i, c + 1, lx-skip-ws(text, c + 1));
        }
        def ong-go-head-name(text, i, j, k) = (k > j) && ((Comparable) lx-at?(text, k, "buildVerb") == 1) ? (k + 9) : ong-go-head(text, i + 1);
        // <word>\s+<name> : answers the index after the name, or -1
        def ong-word-head(text, word, name, from) {
            let i = str_find(text, word, from);
            i < 0 ? (0 - 1) : ong-word-head-at(text, word, name, i, lx-skip-ws(text, i + len(word)));
        }
        def ong-word-head-at(text, word, name, i, k) {
            (Comparable) k == (i + len(word)) ? ong-word-head(text, word, name, i + 1)
            : (Comparable) lx-boundary-before?(text, i) == 0 ? ong-word-head(text, word, name, i + 1)
            : (Comparable) lx-at?(text, k, name) == 1 ? (k + len(name))
            : ong-word-head(text, word, name, i + 1);
        }
        // \s*\([^)]*\)[^{]*\{ after the name: the first ")" then the first "{"
        def ong-open-after(text, after) {
            after < 0 ? (0 - 1) : ong-open-paren(text, str_find(text, "(", after));
        }
        def ong-open-paren(text, p) = p < 0 ? (0 - 1) : ong-open-brace(text, str_find(text, ")", p));
        def ong-open-brace(text, c) = c < 0 ? (0 - 1) : str_find(text, "{", c);
        // the body, from its "{" (the script slices from it)
        def ong-body(text, kind) {
            let open = ong-fn-open(text, kind);
            open < 0 ? ["refused", "buildVerb/build_verb function not found"] : ong-body-at(open, ong-brace-end(text, open, 0), text);
        }
        def ong-body-at(open, close, text) = close < 0 ? ["refused", "unmatched brace"] : ["ok", substring(text, open, close)];

        // ---- case positions inside a body: rows (pos, name) in order ----
        // Go: case\s+"name"\s*:
        def ong-cases(body) = ong-cases-go(body, 0, []);
        def ong-cases-go(body, from, acc) {
            let i = str_find(body, "case", from);
            i < 0 ? reverse(acc) : ong-cases-go(body, i + 1, ong-case-at(body, i, lx-skip-ws(body, i + 4), acc));
        }
        def ong-case-at(body, i, k, acc) {
            (Comparable) k == (i + 4) ? acc : ong-case-name(body, i, ong-quoted(body, k), acc);
        }
        def ong-case-name(body, i, q, acc) = (Comparable) len(q) == 0 ? acc : (Comparable) lx-at?(body, lx-skip-ws(body, q[1]), ":") == 0 ? acc : cons([i, q[0]], acc);
        // Rust: "name"\s*=>
        def ong-arms(body) = ong-arms-go(body, 0, []);
        def ong-arms-go(body, from, acc) {
            let i = str_find(body, "\"", from);
            i < 0 ? reverse(acc) : ong-arms-at(body, i, ong-quoted(body, i), acc);
        }
        def ong-arms-at(body, i, q, acc) {
            (Comparable) len(q) == 0 ? ong-arms-go(body, i + 1, acc)
            : (Comparable) lx-at?(body, lx-skip-ws(body, q[1]), "=>") == 1 ? ong-arms-go(body, q[1], cons([i, q[0]], acc))
            : ong-arms-go(body, i + 1, acc);
        }
        // "name" at i (one or more bytes, no quote inside) -> list(name, end-after-quote) or list()
        def ong-quoted(text, i) {
            (Comparable) lx-at?(text, i, "\"") == 0 ? [] : ong-quoted-end(text, i + 1, str_find(text, "\"", i + 1));
        }
        def ong-quoted-end(text, a, b) = b < 0 ? [] : (Comparable) b == a ? [] : [substring(text, a, b), b + 1];

        // ---- constants: Go \b(R\w+)\s+uint32\s*=\s*(\d+); Rust \bconst\s+(R\w+)\s*:\s*u32\s*=\s*(\d+)\s*; ----
        def ong-consts(text, kind) = (String) kind == "go" ? ong-go-consts(text, 0, []) : ong-rust-consts(text, 0, []);
        def ong-span-word(s, i) = (Comparable) lx-word-at?(s, i) == 1 ? ong-span-word(s, i + 1) : i;
        def ong-go-consts(text, from, acc) {
            let i = str_find(text, "R", from);
            i < 0 ? reverse(acc) : ong-go-consts(text, i + 1, ong-go-const-at(text, i, acc));
        }
        def ong-go-const-at(text, i, acc) {
            let j = ong-span-word(text, i + 1);
            (Comparable) lx-boundary-before?(text, i) == 0 ? acc
            : (Comparable) j == (i + 1) ? acc
            : ong-go-const-ws(text, i, j, lx-skip-ws(text, j), acc);
        }
        def ong-go-const-ws(text, i, j, k, acc) {
            (Comparable) k == j ? acc
            : (Comparable) lx-at?(text, k, "uint32") == 0 ? acc
            : ong-const-eq(text, k + 6, substring(text, i, j), acc);
        }
        def ong-const-eq(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            (Comparable) lx-at?(text, m2, "=") == 0 ? acc : ong-const-digits(text, lx-skip-ws(text, m2 + 1), name, acc);
        }
        def ong-const-digits(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : cons([name, lx-int-span(text, d, e)], acc);
        }
        def ong-rust-consts(text, from, acc) {
            let i = str_find(text, "const", from);
            i < 0 ? reverse(acc) : ong-rust-consts(text, i + 1, ong-rust-const-at(text, i, lx-skip-ws(text, i + 5), acc));
        }
        def ong-rust-const-at(text, i, k, acc) {
            (Comparable) lx-boundary-before?(text, i) == 0 ? acc
            : (Comparable) k == (i + 5) ? acc
            : (Comparable) lx-at?(text, k, "R") == 0 ? acc
            : ong-rust-const-name(text, k, ong-span-word(text, k + 1), acc);
        }
        def ong-rust-const-name(text, k, j, acc) {
            (Comparable) j == (k + 1) ? acc : ong-rust-const-colon(text, k, j, lx-skip-ws(text, j), acc);
        }
        def ong-rust-const-colon(text, k, j, c, acc) {
            (Comparable) lx-at?(text, c, ":") == 0 ? acc : ong-rust-const-u32(text, k, j, lx-skip-ws(text, c + 1), acc);
        }
        def ong-rust-const-u32(text, k, j, u, acc) = (Comparable) lx-at?(text, u, "u32") == 0 ? acc : ong-rust-const-value(text, u + 3, substring(text, k, j), acc);
        def ong-rust-const-value(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            (Comparable) lx-at?(text, m2, "=") == 0 ? acc : ong-rust-const-semi(text, lx-skip-ws(text, m2 + 1), name, acc);
        }
        def ong-rust-const-semi(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : (Comparable) lx-at?(text, lx-skip-ws(text, e), ";") == 0 ? acc : cons([name, lx-int-span(text, d, e)], acc);
        }
        def ong-const-value(consts, name) {
            let row = tb-find2(consts, ong-map-named?, name);
            (Comparable) len(row) == 0 ? ong-none() : row[1];
        }

        // ---- the first constructor call in a chunk: list(label, inst) or list() ----
        // \b(cat...)\s*\(\s*(R\w+)?\s*\)  — the earliest occurrence of any name in the table
        def ong-cat-call(chunk, kind, consts) = ong-cat-call-go(chunk, (String) kind == "go" ? "cat" : "cat_", ong-cat-map(kind), consts, 0);
        def ong-cat-call-go(chunk, stem, map, consts, from) {
            let i = str_find(chunk, stem, from);
            i < 0 ? [] : ong-cat-call-at(chunk, stem, map, consts, i, ong-cat-name(chunk, i, map));
        }
        def ong-cat-name(chunk, i, map) {
            let j = ong-span-word(chunk, i);
            (Comparable) lx-boundary-before?(chunk, i) == 0 ? "" : ong-map-get(map, substring(chunk, i, j));
        }
        def ong-cat-call-at(chunk, stem, map, consts, i, label) {
            (Comparable) len(label) == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : ong-cat-call-paren(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, ong-span-word(chunk, i)));
        }
        def ong-cat-call-paren(chunk, stem, map, consts, i, label, p) {
            (Comparable) lx-at?(chunk, p, "(") == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : ong-cat-call-arg(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, p + 1));
        }
        def ong-cat-call-arg(chunk, stem, map, consts, i, label, a) {
            (Comparable) lx-at?(chunk, a, "R") == 1 ? ong-cat-call-const(chunk, stem, map, consts, i, label, a, ong-span-word(chunk, a + 1))
            : (Comparable) lx-at?(chunk, a, ")") == 1 ? [label, ong-none()]
            : ong-cat-call-go(chunk, stem, map, consts, i + 1);
        }
        def ong-cat-call-const(chunk, stem, map, consts, i, label, a, j) {
            (Comparable) lx-at?(chunk, lx-skip-ws(chunk, j), ")") == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : [label, ong-const-value(consts, substring(chunk, a, j))];
        }

        def ong-ws-back(s, i) = (i > 0) && ((Comparable) lx-ws-at?(s, i - 1) == 1) ? ong-ws-back(s, i - 1) : i;

        // ---- TypeScript: the VERBS table, one ["verb", RBasic.X, R.Y | digits] row per verb ----
        def ong-ts-table(text, enums) {
            let i = str_find(text, "const VERBS", 0);
            i < 0 ? ["refused", "VERBS table not found in TS reader.ts"] : ["ok", ong-ts-rows(text, enums, i, str_find(text, "] as const", i), [])];
        }
        // kernel.ts names each enum from the contract: export const R = Object.freeze(CATEGORY_CONTRACT.instances.key) -> rows (R.Member, value)
        def ong-ts-freeze() = "= Object.freeze(CATEGORY_CONTRACT.instances.";
        def ong-ts-enums(text, instances) = ong-ts-enums-go(text, instances, 0, []);
        def ong-ts-enums-go(text, instances, from, acc) {
            let i = str_find(text, "export const ", from);
            i < 0 ? acc : ong-ts-enum-at(text, instances, i + 13, ong-span-word(text, i + 13), acc);
        }
        def ong-ts-enum-at(text, instances, a, b, acc) {
            let k = lx-skip-ws(text, b) + len(ong-ts-freeze());
            (Comparable) lx-at?(text, lx-skip-ws(text, b), ong-ts-freeze()) == 0 ? ong-ts-enums-go(text, instances, b, acc)
            : ong-ts-enums-go(text, instances, b, append(acc, ong-ts-members(substring(text, a, b), json-object-pairs(json-object-get(instances, substring(text, k, ong-span-word(text, k)))))));
        }
        def ong-ts-members(name, pairs) = tb-map(pairs, pair => [name ++ "." ++ json-pair-key(pair), node_value(json-pair-value(pair))]);
        def ong-ts-rows(text, enums, from, end, out) {
            let i = str_find(text, "[\"", from);
            (i < 0) || (i >= end) ? out : ong-ts-row(text, enums, i, end, str_find(text, "]", i), out);
        }
        def ong-ts-row(text, enums, i, end, close, out) {
            let chunk = substring(text, i, close);
            let label = ong-ts-label(chunk);
            let q = ong-quoted(chunk, 1);
            ((Comparable) len(q) == 0) || ((Comparable) len(label) == 0) ? ong-ts-rows(text, enums, close, end, out)
            : ong-ts-rows(text, enums, close, end, ong-assign(out, [q[0]], label, ong-ts-row-inst(chunk, enums)));
        }
        // the label RBasic.X names, or "" when it names none
        def ong-ts-label(chunk) {
            let i = str_find(chunk, "RBasic.", 0);
            i < 0 ? "" : ong-map-get(ong-rbasic-map(), substring(chunk, i + 7, ong-span-word(chunk, i + 7)));
        }
        // the third field: an enum member through the enums, digits, or none
        def ong-ts-row-inst(chunk, enums) {
            let c = str_find(chunk, ",", str_find(chunk, ",", 0) + 1);
            c < 0 ? ong-none() : ong-ts-inst-value(chunk, enums, lx-skip-ws(chunk, c + 1));
        }
        def ong-ts-inst-value(chunk, enums, v) {
            (Comparable) lx-digit-at?(chunk, v) == 1 ? lx-int-span(chunk, v, lx-digits-end(chunk, v))
            : (Comparable) lx-at?(chunk, v, "R") == 0 ? ong-none()
            : ong-ts-inst-enum(chunk, enums, v, ong-span-word(chunk, v + 1));
        }
        def ong-ts-inst-enum(chunk, enums, v, j) {
            (Comparable) lx-at?(chunk, j, ".") == 0 ? ong-none()
            : ong-const-value(enums, substring(chunk, v, j) ++ "." ++ substring(chunk, j + 1, ong-span-word(chunk, j + 1)));
        }

        // ---- walking the chunks: out rows (name label inst), pending names fall through to the next reading ----
        def ong-chunk(body, positions, k) = substring(body, positions[k][0], (k + 1) < len(positions) ? positions[k + 1][0] : len(body));
        def ong-walk(body, positions, kind, consts, k, pending, out) {
            k >= len(positions) ? out
            : ong-walk-cat(body, positions, kind, consts, k, pending, out, positions[k][1], ong-cat-call(ong-chunk(body, positions, k), kind, consts));
        }
        def ong-walk-cat(body, positions, kind, consts, k, pending, out, name, call) {
            (Comparable) len(call) == 0 ? ong-walk(body, positions, kind, consts, k + 1, append(pending, [name]), out)
            : ong-walk(body, positions, kind, consts, k + 1, [], ong-assign(out, append(pending, [name]), call[0], call[1]));
        }
        // dict assignment: a known name keeps its seat and takes the new reading; a new name joins at the end
        def ong-assign(out, names, label, inst) = (Comparable) len(names) == 0 ? out : ong-assign(ong-put(out, [names[0], label, inst]), names[1:], label, inst);
        def ong-put(out, r) = (Comparable) len(tb-find2(out, ong-r-named?, r[0])) == 0 ? append(out, [r]) : ong-replace(out, r);
        def ong-replace(out, r) = (Comparable) len(out) == 0 ? [] : (String) out[0][0] == r[0] ? cons(r, out[1:]) : cons(out[0], ong-replace(out[1:], r));
        // one kernel's dispatch: list("ok", rows) or list("refused", message)
        def ong-dispatch(text, kind) = ong-dispatch-body(ong-body(text, kind), text, kind);
        def ong-dispatch-body(body, text, kind) = (String) body[0] == "refused" ? body : ["ok", ong-dispatch-in(body[1], text, kind)];
        def ong-dispatch-in(body, text, kind) {
            (String) kind == "rust" ? ong-walk(body, ong-arms(body), kind, ong-consts(text, kind), 0, [], [])
            : ong-walk(body, ong-cases(body), kind, ong-consts(text, kind), 0, [], []);
        }
        def ong-k-name(k) = k[0];
        def ong-k-rows(k) = k[1];
        def ong-k-text(k) = k[2];

        // ---- validation ----
        def ong-prim-drifts(prims, kernels) = (Comparable) len(prims) == 0 ? [] : append(ong-prim-one(prims[0], kernels), ong-prim-drifts(prims[1:], kernels));
        def ong-prim-one(r, kernels) {
            let want = ong-type-label(ong-r-type(r));
            (Comparable) len(want) == 0 ? ["FORM-PRIMITIVE-TABLE row (" ++ ong-py(ong-r-name(r)) ++ " " ++ ong-r-type(r).str() ++ " " ++ ong-r-inst(r).str() ++ ") has unknown type " ++ ong-r-type(r).str()]
            : ong-prim-kernels(r, want, kernels);
        }
        def ong-prim-kernels(r, want, kernels) = (Comparable) len(kernels) == 0 ? [] : append(ong-prim-kernel(r, want, kernels[0], tb-find2(ong-k-rows(kernels[0]), ong-r-named?, ong-r-name(r))), ong-prim-kernels(r, want, kernels[1:]));
        def ong-prim-kernel(r, want, k, entry) {
            (Comparable) len(entry) == 0 ? ["primitive " ++ ong-py(ong-r-name(r)) ++ " (type=" ++ ong-r-type(r).str() ++ " inst=" ++ ong-r-inst(r).str() ++ ") in ontology but no `case \"" ++ ong-r-name(r) ++ "\"` in " ++ ong-k-name(k)]
            : append(ong-when(!((String) entry[1] == want), "primitive " ++ ong-py(ong-r-name(r)) ++ " in ontology says category=" ++ want ++ " but " ++ ong-k-name(k) ++ " dispatches to category=" ++ entry[1]),
                        ong-when((entry[2] >= 0) && (!((Comparable) entry[2] == ong-r-inst(r))), "primitive " ++ ong-py(ong-r-name(r)) ++ " in ontology has inst=" ++ ong-r-inst(r).str() ++ " but " ++ ong-k-name(k) ++ " dispatches with inst=" ++ entry[2].str()));
        }
        // ^[A-Za-z_][A-Za-z0-9_-]*$
        def ong-word-name?(s) = (Comparable) len(s) == 0 ? 0 : (Comparable) lx-digit-at?(s, 0) == 1 ? 0 : (Comparable) str_byte_at(s, 0) == 45 ? 0 : ong-word-name-go(s, 0);
        def ong-word-name-go(s, i) = i >= len(s) ? 1 : ((Comparable) lx-word-at?(s, i) == 1) || ((Comparable) str_byte_at(s, i) == 45) ? ong-word-name-go(s, i + 1) : 0;
        def ong-reverse-drifts(kernels, primnames) = (Comparable) len(kernels) == 0 ? [] : append(ong-reverse-kernel(ong-k-name(kernels[0]), ong-k-rows(kernels[0]), primnames), ong-reverse-drifts(kernels[1:], primnames));
        def ong-reverse-kernel(kname, rows, primnames) = (Comparable) len(rows) == 0 ? [] : append(ong-reverse-one(kname, rows[0], primnames), ong-reverse-kernel(kname, rows[1:], primnames));
        def ong-reverse-one(kname, r, primnames) = ong-when(((Comparable) ong-prim-label?(r[1]) == 1) && (((Comparable) lx-str-in?(primnames, r[0]) == 0) && ((Comparable) ong-word-name?(r[0]) == 1)), kname ++ " has `case \"" ++ r[0] ++ "\"` → " ++ r[1] ++ " but FORM-PRIMITIVE-TABLE has no row for it");
        def ong-cat-drifts(cats, kernels) = (Comparable) len(cats) == 0 ? [] : append(ong-cat-one(cats[0], kernels), ong-cat-drifts(cats[1:], kernels));
        def ong-cat-one(r, kernels) {
            let row = tb-first(ong-aliases(), alias => (String) alias[0] == ong-r-name(r)) ?? [];
            (Comparable) len(row) == 0 ? ["FORM-CATEGORY-TABLE row (" ++ ong-py(ong-r-name(r)) ++ " " ++ ong-r-type(r).str() ++ " " ++ ong-r-inst(r).str() ++ ") has no alias mapping in gate/ontology.bml — extend ong-aliases() if this is a new shape"]
            : (Comparable) len(row[1]) == 0 ? []
            : ong-cat-kernels(r, row[1], kernels);
        }
        def ong-cat-kernels(r, accept, kernels) = (Comparable) len(kernels) == 0 ? [] : append(ong-when((Comparable) ong-handled?(ong-k-text(kernels[0]), accept) == 0, "category " ++ ong-py(ong-r-name(r)) ++ " (type=" ++ ong-r-type(r).str() ++ " inst=" ++ ong-r-inst(r).str() ++ ") in ontology expects one of " ++ lx-py-str-list(accept) ++ " as a verb handler in " ++ ong-k-name(kernels[0]) ++ " but none found"), ong-cat-kernels(r, accept, kernels[1:]));
        def ong-handled?(text, accept) = (Comparable) len(accept) == 0 ? 0 : (Comparable) ong-handler?(text, accept[0], 0) == 1 ? 1 : ong-handled?(text, accept[1:]);
        // case\s+"x"\s*[:=]  |  "x"\s*=>  |  verb\s*===\s*"x"  |  ["x",  (a table row) — at any "x" in the text
        def ong-handler?(text, x, from) {
            let i = str_find(text, "\"" ++ x ++ "\"", from);
            i < 0 ? 0 : (Comparable) ong-handler-at?(text, x, i) == 1 ? 1 : ong-handler?(text, x, i + 1);
        }
        def ong-handler-at?(text, x, i) {
            let after = lx-skip-ws(text, i + (len(x) + 2));
            ((Comparable) ong-case-before?(text, i) == 1) && (((Comparable) lx-at?(text, after, ":") == 1) || ((Comparable) lx-at?(text, after, "=") == 1)) ? 1
            : (Comparable) lx-at?(text, after, "=>") == 1 ? 1
            : (i > 0) && (((Comparable) lx-at?(text, i - 1, "[") == 1) && ((Comparable) lx-at?(text, after, ",") == 1)) ? 1
            : ong-verb-before?(text, i);
        }
        def ong-case-before?(text, i) {
            let w = ong-ws-back(text, i);
            (Comparable) w == i ? 0 : ((w - 4) >= 0) && ((String) substring(text, w - 4, w) == "case") ? 1 : 0;
        }
        def ong-verb-before?(text, i) {
            let e = ong-ws-back(text, i);
            (e - 3) < 0 ? 0 : (Comparable) ((String) substring(text, e - 3, e) == "===") == 0 ? 0 : ong-verb-word?(text, ong-ws-back(text, e - 3));
        }
        def ong-verb-word?(text, e) = ((e - 4) >= 0) && ((String) substring(text, e - 4, e) == "verb") ? 1 : 0;

        // ---- the analysis: list(drifts) ----
        def ong-missing(root, rel) = ["missing input: " ++ root ++ rel];
        def ong-analysis(root) {
            let json = read_file(root ++ ong-json());
            let go = read_file(root ++ ong-go());
            let rust = read_file(root ++ ong-rust());
            let ts = read_file(root ++ ong-ts());
            let tskernel = read_file(root ++ ong-ts-kernel());
            let contract = read_file(root ++ ong-contract());
            nothing?(json) ? ong-missing(root, ong-json())
            : nothing?(go) ? ong-missing(root, ong-go())
            : nothing?(rust) ? ong-missing(root, ong-rust())
            : nothing?(ts) ? ong-missing(root, ong-ts())
            : nothing?(tskernel) ? ong-missing(root, ong-ts-kernel())
            : nothing?(contract) ? ong-missing(root, ong-contract())
            : ong-analysis-texts(parse-json(ong-json(), json), ong-dispatch(go, "go"), ong-dispatch(rust, "rust"), ong-ts-table(ts, ong-ts-enums(tskernel, json-object-get(parse-json(ong-contract(), contract), "instances"))), go, rust, ts);
        }
        def ong-analysis-texts(root, go, rust, ts, gotext, rusttext, tstext) {
            (String) go[0] == "refused" ? [go[1]]
            : (String) rust[0] == "refused" ? [rust[1]]
            : (String) ts[0] == "refused" ? [ts[1]]
            : ong-analysis-with(ong-rows(root, "categories"), ong-rows(root, "primitives"), [["form-kernel-go", go[1], gotext], ["form-kernel-rust", rust[1], rusttext], ["form-kernel-ts", ts[1], tstext]]);
        }
        def ong-analysis-with(cats, prims, kernels) = append(ong-prim-drifts(prims, kernels), append(ong-reverse-drifts(kernels, tb-map(prims, ong-r-name)), ong-cat-drifts(cats, kernels)));

        // ---- the voice ----
        def ong-ok-line() = "form ontology matches kernel parsers (Go/Rust/TS)";
        def ong-judge(root) = lx-verdict(ong-name(), ong-analysis(root), ong-ok-line());
        def ong-run() = ong-judge("");
    }
    ong-run();
}
