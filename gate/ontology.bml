// Native Form lens for ontology agreement across the proof siblings.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk
section [form.bml] {
    class FormOntologyGate {
        thought ontology-pattern = list("json-is-the-grammar", "arms-read-as-the-script-reads-them", "fall-through-takes-the-next-reading", "words-not-operators", "twin-voice-byte-for-byte");

        def ong-name() = "ontology";
        def ong-json() = "form/form-stdlib/form-ontology.json";
        def ong-go() = "form/form-kernel-go/main.go";
        def ong-rust() = "form/form-kernel-rust/src/main.rs";
        def ong-ts() = "form/form-kernel-ts/src/reader.ts";
        def ong-kernels() = list("form-kernel-go", "form-kernel-rust", "form-kernel-ts");
        def ong-none() = 0 - 1;
        def ong-when(cond, msg) = cond ? list(msg) : list();
        def ong-py(s) = lx-py-str(s);

        // ---- the script's tables as rows ----
        def ong-type-label(ty) = (Comparable) ty == 12 ? "math" : (Comparable) ty == 13 ? "compare" : (Comparable) ty == 14 ? "logic" : "";
        def ong-prim-label?(label) = ((String) label == "math") || (((String) label == "compare") || ((String) label == "logic")) ? 1 : 0;
        def ong-alias-row(name, accept) = list(name, accept);
        // the accepted handlers, already sorted (the script prints sorted(accept))
        def ong-aliases() = list(ong-alias-row("do", list("do")), ong-alias-row("sequence", list()), ong-alias-row("let", list("let")), ong-alias-row("if-then", list("if")), ong-alias-row("if", list("if")), ong-alias-row("match", list()), ong-alias-row("fndef", list("defn")), ong-alias-row("fncall", list()), ong-alias-row("ident", list()));
        def ong-cat-map(kind) = (String) kind == "go" ? list(list("catMath", "math"), list("catCompare", "compare"), list("catLogic", "logic"), list("catBlock", "block"), list("catCond", "cond"), list("catMatch", "match"), list("catFnDef", "fndef"), list("catFnCall", "fncall"), list("catIdent", "ident"))
            : list(list("cat_math", "math"), list("cat_compare", "compare"), list("cat_logic", "logic"), list("cat_block", "block"), list("cat_cond", "cond"), list("cat_match", "match"), list("cat_fndef", "fndef"), list("cat_fncall", "fncall"), list("cat_ident", "ident"));
        def ong-rbasic-map() = list(list("MATH", "math"), list("COMPARE", "compare"), list("LOGIC", "logic"), list("MATCH", "match"), list("BLOCK", "block"), list("COND", "cond"), list("FNDEF", "fndef"), list("FNCALL", "fncall"), list("IDENT", "ident"), list("LIST", "list"));
        def ong-map-named?(row, name) = (String) row[0] == name ? 1 : 0;
        def ong-map-get(rows, name) {
            let row = tb-find2(rows, ong-map-named?, name);
            (Comparable) len(row) == 0 ? "" : row[1];
        }

        // ---- the ontology: rows (name type inst) from an array of objects ----
        def ong-rows(root, key) = json-object-has?(root, key) ? tb-map(node_children(json-object-get(root, key)), ong-row-of) : list();
        def ong-row-of(obj) = list(node_value(json-object-get(obj, "name")), node_value(json-object-get(obj, "type")), node_value(json-object-get(obj, "inst")));
        def ong-r-name(r) = r[0];
        def ong-r-type(r) = r[1];
        def ong-r-inst(r) = r[2];
        def ong-r-named?(r, name) = (String) r[0] == name ? 1 : 0;

        // ---- the brace block: strings ("', `) with escapes, // and /* */ unseen; answers the index of the matching } or -1 ----
        def ong-quote?(b) = ((Comparable) b == 34) || (((Comparable) b == 39) || ((Comparable) b == 96)) ? 1 : 0;
        def ong-brace-end(text, i, depth) {
            i >= str_len(text) ? (0 - 1)
            : (Comparable) ong-quote?(str_byte_at(text, i)) == 1 ? ong-brace-end(text, ong-string-end(text, i + 1, str_byte_at(text, i)) + 1, depth)
            : (Comparable) lx-at?(text, i, "//") == 1 ? ong-brace-end(text, ong-line-end(text, i), depth)
            : (Comparable) lx-at?(text, i, "/*") == 1 ? ong-brace-end(text, ong-comment-end(text, i), depth)
            : (Comparable) str_byte_at(text, i) == 123 ? ong-brace-end(text, i + 1, depth + 1)
            : (Comparable) str_byte_at(text, i) == 125 ? ong-brace-close(text, i, depth)
            : ong-brace-end(text, i + 1, depth);
        }
        def ong-brace-close(text, i, depth) = depth <= 1 ? i : ong-brace-end(text, i + 1, depth - 1);
        // the index of the closing quote (or the text's end): a backslash skips the next byte
        def ong-string-end(text, j, quote) {
            j >= str_len(text) ? j
            : (Comparable) str_byte_at(text, j) == quote ? j
            : (Comparable) str_byte_at(text, j) == 92 ? ong-string-end(text, j + 2, quote)
            : ong-string-end(text, j + 1, quote);
        }
        def ong-line-end(text, i) {
            let nl = str_find(text, lx-nl(), i);
            nl < 0 ? str_len(text) : (nl + 1);
        }
        def ong-comment-end(text, i) {
            let e = str_find(text, "*/", i + 2);
            e < 0 ? str_len(text) : (e + 2);
        }

        // ---- locating the dispatch function: the "{" of its body, or -1 ----
        // Go: func (...) buildVerb(...) ... then the brace; Rust: fn build_verb(...) ... then the brace; TypeScript: function buildVerb(...): NodeID then the brace.
        // (A comment line may not END with an open brace: the BML section scanner reads lines, comments included, and counts one.)
        def ong-fn-open(text, kind) {
            (String) kind == "go" ? ong-open-after(text, ong-go-head(text, 0))
            : (String) kind == "rust" ? ong-open-after(text, ong-word-head(text, "fn", "build_verb", 0))
            : ong-ts-open(text, ong-word-head(text, "function", "buildVerb", 0));
        }
        // func\s+\([^)]*\)\s+buildVerb : the "func" whose parenthesised receiver is followed by the name
        def ong-go-head(text, from) {
            let i = str_find(text, "func", from);
            i < 0 ? (0 - 1) : ong-go-head-at(text, i, lx-skip-ws(text, i + 4));
        }
        def ong-go-head-at(text, i, k) {
            (Comparable) k == (i + 4) ? ong-go-head(text, i + 1)
            : (Comparable) lx-at?(text, k, "(") == 0 ? ong-go-head(text, i + 1)
            : ong-go-head-recv(text, i, str_find(text, ")", k));
        }
        def ong-go-head-recv(text, i, c) {
            c < 0 ? (0 - 1) : ong-go-head-name(text, i, c + 1, lx-skip-ws(text, c + 1));
        }
        def ong-go-head-name(text, i, j, k) = (k > j) && ((Comparable) lx-at?(text, k, "buildVerb") == 1) ? (k + 9) : ong-go-head(text, i + 1);
        // <word>\s+<name> : answers the index after the name, or -1
        def ong-word-head(text, word, name, from) {
            let i = str_find(text, word, from);
            i < 0 ? (0 - 1) : ong-word-head-at(text, word, name, i, lx-skip-ws(text, i + str_len(word)));
        }
        def ong-word-head-at(text, word, name, i, k) {
            (Comparable) k == (i + str_len(word)) ? ong-word-head(text, word, name, i + 1)
            : (Comparable) lx-boundary-before?(text, i) == 0 ? ong-word-head(text, word, name, i + 1)
            : (Comparable) lx-at?(text, k, name) == 1 ? (k + str_len(name))
            : ong-word-head(text, word, name, i + 1);
        }
        // \s*\([^)]*\)[^{]*\{ after the name: the first ")" then the first "{"
        def ong-open-after(text, after) {
            after < 0 ? (0 - 1) : ong-open-paren(text, str_find(text, "(", after));
        }
        def ong-open-paren(text, p) = p < 0 ? (0 - 1) : ong-open-brace(text, str_find(text, ")", p));
        def ong-open-brace(text, c) = c < 0 ? (0 - 1) : str_find(text, "{", c);
        // TypeScript: \([^)]*\)\s*:\s*NodeID\s* and then the open brace
        def ong-ts-open(text, after) {
            after < 0 ? (0 - 1) : ong-ts-open-paren(text, str_find(text, "(", after));
        }
        def ong-ts-open-paren(text, p) = p < 0 ? (0 - 1) : ong-ts-open-colon(text, str_find(text, ")", p));
        def ong-ts-open-colon(text, c) {
            c < 0 ? (0 - 1) : ong-ts-open-type(text, lx-skip-ws(text, c + 1));
        }
        def ong-ts-open-type(text, k) {
            (Comparable) lx-at?(text, k, ":") == 0 ? (0 - 1) : ong-ts-open-nodeid(text, lx-skip-ws(text, k + 1));
        }
        def ong-ts-open-nodeid(text, k) {
            (Comparable) lx-at?(text, k, "NodeID") == 0 ? (0 - 1) : ong-ts-open-final(text, lx-skip-ws(text, k + 6));
        }
        def ong-ts-open-final(text, k) = (Comparable) lx-at?(text, k, "{") == 1 ? k : (0 - 1);
        // the body: Go/Rust keep the "{" (the script slices from it); TypeScript starts after it
        def ong-body(text, kind) {
            let open = ong-fn-open(text, kind);
            open < 0 ? list("refused", (String) kind == "ts" ? "buildVerb not found in TS reader.ts" : "buildVerb/build_verb function not found") : ong-body-at(text, kind, open, ong-brace-end(text, open, 0));
        }
        def ong-body-at(text, kind, open, close) = close < 0 ? list("refused", "unmatched brace") : list("ok", substring(text, (String) kind == "ts" ? (open + 1) : open, close));

        // ---- case positions inside a body: rows (pos, name) in order ----
        // Go / TypeScript: case\s+"name"\s*:
        def ong-cases(body) = ong-cases-go(body, 0, list());
        def ong-cases-go(body, from, acc) {
            let i = str_find(body, "case", from);
            i < 0 ? reverse(acc) : ong-cases-go(body, i + 1, ong-case-at(body, i, lx-skip-ws(body, i + 4), acc));
        }
        def ong-case-at(body, i, k, acc) {
            (Comparable) k == (i + 4) ? acc : ong-case-name(body, i, ong-quoted(body, k), acc);
        }
        def ong-case-name(body, i, q, acc) = (Comparable) len(q) == 0 ? acc : (Comparable) lx-at?(body, lx-skip-ws(body, q[1]), ":") == 0 ? acc : cons(list(i, q[0]), acc);
        // Rust: "name"\s*=>
        def ong-arms(body) = ong-arms-go(body, 0, list());
        def ong-arms-go(body, from, acc) {
            let i = str_find(body, "\"", from);
            i < 0 ? reverse(acc) : ong-arms-at(body, i, ong-quoted(body, i), acc);
        }
        def ong-arms-at(body, i, q, acc) {
            (Comparable) len(q) == 0 ? ong-arms-go(body, i + 1, acc)
            : (Comparable) lx-at?(body, lx-skip-ws(body, q[1]), "=>") == 1 ? ong-arms-go(body, q[1], cons(list(i, q[0]), acc))
            : ong-arms-go(body, i + 1, acc);
        }
        // "name" at i (one or more bytes, no quote inside) -> list(name, end-after-quote) or list()
        def ong-quoted(text, i) {
            (Comparable) lx-at?(text, i, "\"") == 0 ? list() : ong-quoted-end(text, i + 1, str_find(text, "\"", i + 1));
        }
        def ong-quoted-end(text, a, b) = b < 0 ? list() : (Comparable) b == a ? list() : list(substring(text, a, b), b + 1);

        // ---- constants: Go \b(R\w+)\s+uint32\s*=\s*(\d+); Rust \bconst\s+(R\w+)\s*:\s*u32\s*=\s*(\d+)\s*; ----
        def ong-consts(text, kind) = (String) kind == "go" ? ong-go-consts(text, 0, list()) : ong-rust-consts(text, 0, list());
        def ong-span-word(s, i) = (Comparable) lx-word-at?(s, i) == 1 ? ong-span-word(s, i + 1) : i;
        def ong-go-consts(text, from, acc) {
            let i = str_find(text, "R", from);
            i < 0 ? reverse(acc) : ong-go-consts(text, i + 1, ong-go-const-at(text, i, acc));
        }
        def ong-go-const-at(text, i, acc) {
            let j = ong-span-word(text, i + 1);
            (Comparable) lx-boundary-before?(text, i) == 0 ? acc
            : (Comparable) j == (i + 1) ? acc
            : ong-go-const-ws(text, i, j, lx-skip-ws(text, j), acc);
        }
        def ong-go-const-ws(text, i, j, k, acc) {
            (Comparable) k == j ? acc
            : (Comparable) lx-at?(text, k, "uint32") == 0 ? acc
            : ong-const-eq(text, k + 6, substring(text, i, j), acc);
        }
        def ong-const-eq(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            (Comparable) lx-at?(text, m2, "=") == 0 ? acc : ong-const-digits(text, lx-skip-ws(text, m2 + 1), name, acc);
        }
        def ong-const-digits(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : cons(list(name, lx-int-span(text, d, e)), acc);
        }
        def ong-rust-consts(text, from, acc) {
            let i = str_find(text, "const", from);
            i < 0 ? reverse(acc) : ong-rust-consts(text, i + 1, ong-rust-const-at(text, i, lx-skip-ws(text, i + 5), acc));
        }
        def ong-rust-const-at(text, i, k, acc) {
            (Comparable) lx-boundary-before?(text, i) == 0 ? acc
            : (Comparable) k == (i + 5) ? acc
            : (Comparable) lx-at?(text, k, "R") == 0 ? acc
            : ong-rust-const-name(text, k, ong-span-word(text, k + 1), acc);
        }
        def ong-rust-const-name(text, k, j, acc) {
            (Comparable) j == (k + 1) ? acc : ong-rust-const-colon(text, k, j, lx-skip-ws(text, j), acc);
        }
        def ong-rust-const-colon(text, k, j, c, acc) {
            (Comparable) lx-at?(text, c, ":") == 0 ? acc : ong-rust-const-u32(text, k, j, lx-skip-ws(text, c + 1), acc);
        }
        def ong-rust-const-u32(text, k, j, u, acc) = (Comparable) lx-at?(text, u, "u32") == 0 ? acc : ong-rust-const-value(text, u + 3, substring(text, k, j), acc);
        def ong-rust-const-value(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            (Comparable) lx-at?(text, m2, "=") == 0 ? acc : ong-rust-const-semi(text, lx-skip-ws(text, m2 + 1), name, acc);
        }
        def ong-rust-const-semi(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : (Comparable) lx-at?(text, lx-skip-ws(text, e), ";") == 0 ? acc : cons(list(name, lx-int-span(text, d, e)), acc);
        }
        def ong-const-value(consts, name) {
            let row = tb-find2(consts, ong-map-named?, name);
            (Comparable) len(row) == 0 ? ong-none() : row[1];
        }

        // ---- the first constructor call in a chunk: list(label, inst) or list() ----
        // \b(cat...)\s*\(\s*(R\w+)?\s*\)  — the earliest occurrence of any name in the table
        def ong-cat-call(chunk, kind, consts) = ong-cat-call-go(chunk, (String) kind == "go" ? "cat" : "cat_", ong-cat-map(kind), consts, 0);
        def ong-cat-call-go(chunk, stem, map, consts, from) {
            let i = str_find(chunk, stem, from);
            i < 0 ? list() : ong-cat-call-at(chunk, stem, map, consts, i, ong-cat-name(chunk, i, map));
        }
        def ong-cat-name(chunk, i, map) {
            let j = ong-span-word(chunk, i);
            (Comparable) lx-boundary-before?(chunk, i) == 0 ? "" : ong-map-get(map, substring(chunk, i, j));
        }
        def ong-cat-call-at(chunk, stem, map, consts, i, label) {
            (Comparable) str_len(label) == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : ong-cat-call-paren(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, ong-span-word(chunk, i)));
        }
        def ong-cat-call-paren(chunk, stem, map, consts, i, label, p) {
            (Comparable) lx-at?(chunk, p, "(") == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : ong-cat-call-arg(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, p + 1));
        }
        def ong-cat-call-arg(chunk, stem, map, consts, i, label, a) {
            (Comparable) lx-at?(chunk, a, "R") == 1 ? ong-cat-call-const(chunk, stem, map, consts, i, label, a, ong-span-word(chunk, a + 1))
            : (Comparable) lx-at?(chunk, a, ")") == 1 ? list(label, ong-none())
            : ong-cat-call-go(chunk, stem, map, consts, i + 1);
        }
        def ong-cat-call-const(chunk, stem, map, consts, i, label, a, j) {
            (Comparable) lx-at?(chunk, lx-skip-ws(chunk, j), ")") == 0 ? ong-cat-call-go(chunk, stem, map, consts, i + 1)
            : list(label, ong-const-value(consts, substring(chunk, a, j)));
        }

        // ---- TypeScript enums: \benum\s+(\w+)\s*\{([^}]*)\} with members (\w+)\s*=\s*(\d+) -> rows (Enum.Member, value) ----
        def ong-enums(text) = ong-enums-go(text, 0, list());
        def ong-enums-go(text, from, acc) {
            let i = str_find(text, "enum", from);
            i < 0 ? acc : ong-enums-go(text, i + 1, ong-enum-at(text, i, lx-skip-ws(text, i + 4), acc));
        }
        def ong-enum-at(text, i, k, acc) {
            let j = ong-span-word(text, k);
            (Comparable) lx-boundary-before?(text, i) == 0 ? acc
            : (Comparable) k == (i + 4) ? acc
            : (Comparable) j == k ? acc
            : ong-enum-open(text, substring(text, k, j), lx-skip-ws(text, j), acc);
        }
        def ong-enum-open(text, name, o, acc) {
            (Comparable) lx-at?(text, o, "{") == 0 ? acc : ong-enum-body(text, name, o + 1, str_find(text, "}", o + 1), acc);
        }
        def ong-enum-body(text, name, a, b, acc) = b < 0 ? acc : append(acc, ong-enum-members(substring(text, a, b), name, 0, list()));
        def ong-enum-members(body, name, from, acc) {
            let i = str_find(body, "=", from);
            i < 0 ? reverse(acc) : ong-enum-members(body, name, i + 1, ong-enum-member-at(body, name, i, acc));
        }
        def ong-enum-member-at(body, name, i, acc) {
            let e = ong-ws-back(body, i);
            let s = ong-word-back(body, e);
            let d = lx-skip-ws(body, i + 1);
            let de = lx-digits-end(body, d);
            ((Comparable) s == e) || ((Comparable) de == d) ? acc : cons(list(name ++ "." ++ substring(body, s, e), lx-int-span(body, d, de)), acc);
        }
        def ong-ws-back(s, i) = (i > 0) && ((Comparable) lx-ws-at?(s, i - 1) == 1) ? ong-ws-back(s, i - 1) : i;
        def ong-word-back(s, i) = (i > 0) && ((Comparable) lx-word-at?(s, i - 1) == 1) ? ong-word-back(s, i - 1) : i;

        // ---- TypeScript chunk: first RBasic.X; inst: R.Y through the enums, or a literal; mathInst( skips ----
        def ong-ts-label(chunk) {
            let i = str_find(chunk, "RBasic.", 0);
            i < 0 ? "" : ong-ts-label-at(chunk, i + 7, ong-span-word(chunk, i + 7));
        }
        // "" when no RBasic.X stands; "?" when it stands but names no label (the script clears and continues)
        def ong-ts-label-at(chunk, a, j) {
            let label = ong-map-get(ong-rbasic-map(), substring(chunk, a, j));
            (Comparable) str_len(label) == 0 ? "?" : label;
        }
        def ong-ts-inst(chunk, enums) {
            let i = str_find(chunk, "inst", 0);
            i < 0 ? ong-none() : ong-ts-inst-at(chunk, enums, i, lx-skip-ws(chunk, i + 4));
        }
        def ong-ts-inst-at(chunk, enums, i, k) {
            (Comparable) lx-at?(chunk, k, ":") == 0 ? ong-ts-inst-next(chunk, enums, i)
            : ong-ts-inst-value(chunk, enums, i, lx-skip-ws(chunk, k + 1));
        }
        def ong-ts-inst-next(chunk, enums, i) {
            let n = str_find(chunk, "inst", i + 1);
            n < 0 ? ong-none() : ong-ts-inst-at(chunk, enums, n, lx-skip-ws(chunk, n + 4));
        }
        def ong-ts-inst-value(chunk, enums, i, v) {
            (Comparable) lx-at?(chunk, v, "R") == 1 ? ong-ts-inst-enum(chunk, enums, i, v, ong-span-word(chunk, v + 1))
            : (Comparable) lx-digit-at?(chunk, v) == 1 ? lx-int-span(chunk, v, lx-digits-end(chunk, v))
            : ong-ts-inst-next(chunk, enums, i);
        }
        def ong-ts-inst-enum(chunk, enums, i, v, j) {
            (Comparable) lx-at?(chunk, j, ".") == 0 ? ong-ts-inst-next(chunk, enums, i)
            : ong-ts-inst-member(chunk, enums, i, substring(chunk, v, j), j + 1, ong-span-word(chunk, j + 1));
        }
        def ong-ts-inst-member(chunk, enums, i, enumname, a, b) = (Comparable) b == a ? ong-ts-inst-next(chunk, enums, i) : ong-const-value(enums, enumname ++ "." ++ substring(chunk, a, b));

        // ---- walking the chunks: out rows (name label inst), pending names fall through to the next reading ----
        def ong-chunk(body, positions, k) = substring(body, positions[k][0], (k + 1) < len(positions) ? positions[k + 1][0] : str_len(body));
        def ong-walk(body, positions, kind, consts, enums, k, pending, out) {
            k >= len(positions) ? out
            : ong-walk-step(body, positions, kind, consts, enums, k, pending, out, ong-chunk(body, positions, k), positions[k][1]);
        }
        def ong-walk-step(body, positions, kind, consts, enums, k, pending, out, chunk, name) {
            (String) kind == "ts" ? ong-walk-ts(body, positions, kind, consts, enums, k, pending, out, chunk, name, ong-ts-label(chunk))
            : ong-walk-cat(body, positions, kind, consts, enums, k, pending, out, name, ong-cat-call(chunk, kind, consts));
        }
        def ong-walk-cat(body, positions, kind, consts, enums, k, pending, out, name, call) {
            (Comparable) len(call) == 0 ? ong-walk(body, positions, kind, consts, enums, k + 1, append(pending, list(name)), out)
            : ong-walk(body, positions, kind, consts, enums, k + 1, list(), ong-assign(out, append(pending, list(name)), call[0], call[1]));
        }
        def ong-walk-ts(body, positions, kind, consts, enums, k, pending, out, chunk, name, label) {
            (Comparable) str_len(label) == 0 ? ong-walk(body, positions, kind, consts, enums, k + 1, append(pending, list(name)), out)
            : (String) label == "?" ? ong-walk(body, positions, kind, consts, enums, k + 1, list(), out)
            : str_find(chunk, "mathInst", 0) >= 0 ? ong-walk-ts-math(body, positions, kind, consts, enums, k, pending, out, chunk, name, label, str_find(chunk, "mathInst", 0))
            : ong-walk(body, positions, kind, consts, enums, k + 1, list(), ong-assign(out, append(pending, list(name)), label, ong-ts-inst(chunk, enums)));
        }
        // mathInst\s*\( : the script skips the chunk (and drops its pending names) only when the paren follows
        def ong-walk-ts-math(body, positions, kind, consts, enums, k, pending, out, chunk, name, label, m) {
            (Comparable) lx-at?(chunk, lx-skip-ws(chunk, m + 8), "(") == 1 ? ong-walk(body, positions, kind, consts, enums, k + 1, list(), out)
            : ong-walk(body, positions, kind, consts, enums, k + 1, list(), ong-assign(out, append(pending, list(name)), label, ong-ts-inst(chunk, enums)));
        }
        // dict assignment: a known name keeps its seat and takes the new reading; a new name joins at the end
        def ong-assign(out, names, label, inst) = (Comparable) len(names) == 0 ? out : ong-assign(ong-put(out, list(head(names), label, inst)), tail(names), label, inst);
        def ong-put(out, r) = (Comparable) len(tb-find2(out, ong-r-named?, r[0])) == 0 ? append(out, list(r)) : ong-replace(out, r);
        def ong-replace(out, r) = (Comparable) len(out) == 0 ? list() : (String) head(out)[0] == r[0] ? cons(r, tail(out)) : cons(head(out), ong-replace(tail(out), r));
        // one kernel's dispatch: list("ok", rows) or list("refused", message)
        def ong-dispatch(text, kind) {
            let body = ong-body(text, kind);
            (String) body[0] == "refused" ? body : list("ok", ong-dispatch-in(body[1], text, kind));
        }
        def ong-dispatch-in(body, text, kind) {
            (String) kind == "rust" ? ong-walk(body, ong-arms(body), kind, ong-consts(text, kind), list(), 0, list(), list())
            : (String) kind == "go" ? ong-walk(body, ong-cases(body), kind, ong-consts(text, kind), list(), 0, list(), list())
            : ong-walk(body, ong-cases(body), kind, list(), ong-enums(text), 0, list(), list());
        }
        def ong-k-name(k) = k[0];
        def ong-k-rows(k) = k[1];
        def ong-k-text(k) = k[2];

        // ---- validation ----
        def ong-prim-drifts(prims, kernels) = (Comparable) len(prims) == 0 ? list() : append(ong-prim-one(head(prims), kernels), ong-prim-drifts(tail(prims), kernels));
        def ong-prim-one(r, kernels) {
            let want = ong-type-label(ong-r-type(r));
            (Comparable) str_len(want) == 0 ? list("FORM-PRIMITIVE-TABLE row (" ++ ong-py(ong-r-name(r)) ++ " " ++ int_to_str(ong-r-type(r)) ++ " " ++ int_to_str(ong-r-inst(r)) ++ ") has unknown type " ++ int_to_str(ong-r-type(r)))
            : ong-prim-kernels(r, want, kernels);
        }
        def ong-prim-kernels(r, want, kernels) = (Comparable) len(kernels) == 0 ? list() : append(ong-prim-kernel(r, want, head(kernels), tb-find2(ong-k-rows(head(kernels)), ong-r-named?, ong-r-name(r))), ong-prim-kernels(r, want, tail(kernels)));
        def ong-prim-kernel(r, want, k, entry) {
            (Comparable) len(entry) == 0 ? list("primitive " ++ ong-py(ong-r-name(r)) ++ " (type=" ++ int_to_str(ong-r-type(r)) ++ " inst=" ++ int_to_str(ong-r-inst(r)) ++ ") in ontology but no `case \"" ++ ong-r-name(r) ++ "\"` in " ++ ong-k-name(k))
            : append(ong-when(!((String) entry[1] == want), "primitive " ++ ong-py(ong-r-name(r)) ++ " in ontology says category=" ++ want ++ " but " ++ ong-k-name(k) ++ " dispatches to category=" ++ entry[1]),
                        ong-when((entry[2] >= 0) && (!((Comparable) entry[2] == ong-r-inst(r))), "primitive " ++ ong-py(ong-r-name(r)) ++ " in ontology has inst=" ++ int_to_str(ong-r-inst(r)) ++ " but " ++ ong-k-name(k) ++ " dispatches with inst=" ++ int_to_str(entry[2])));
        }
        // ^[A-Za-z_][A-Za-z0-9_-]*$
        def ong-word-name?(s) = (Comparable) str_len(s) == 0 ? 0 : (Comparable) lx-digit-at?(s, 0) == 1 ? 0 : (Comparable) str_byte_at(s, 0) == 45 ? 0 : ong-word-name-go(s, 0);
        def ong-word-name-go(s, i) = i >= str_len(s) ? 1 : ((Comparable) lx-word-at?(s, i) == 1) || ((Comparable) str_byte_at(s, i) == 45) ? ong-word-name-go(s, i + 1) : 0;
        def ong-reverse-drifts(kernels, primnames) = (Comparable) len(kernels) == 0 ? list() : append(ong-reverse-kernel(ong-k-name(head(kernels)), ong-k-rows(head(kernels)), primnames), ong-reverse-drifts(tail(kernels), primnames));
        def ong-reverse-kernel(kname, rows, primnames) = (Comparable) len(rows) == 0 ? list() : append(ong-reverse-one(kname, head(rows), primnames), ong-reverse-kernel(kname, tail(rows), primnames));
        def ong-reverse-one(kname, r, primnames) = ong-when(((Comparable) ong-prim-label?(r[1]) == 1) && (((Comparable) lx-str-in?(primnames, r[0]) == 0) && ((Comparable) ong-word-name?(r[0]) == 1)), kname ++ " has `case \"" ++ r[0] ++ "\"` → " ++ r[1] ++ " but FORM-PRIMITIVE-TABLE has no row for it");
        def ong-cat-drifts(cats, kernels) = (Comparable) len(cats) == 0 ? list() : append(ong-cat-one(head(cats), kernels), ong-cat-drifts(tail(cats), kernels));
        def ong-cat-one(r, kernels) {
            let row = tb-first(ong-aliases(), alias => (String) alias[0] == ong-r-name(r)) ?? list();
            (Comparable) len(row) == 0 ? list("FORM-CATEGORY-TABLE row (" ++ ong-py(ong-r-name(r)) ++ " " ++ int_to_str(ong-r-type(r)) ++ " " ++ int_to_str(ong-r-inst(r)) ++ ") has no alias mapping in gate/ontology.bml — extend ong-aliases() if this is a new shape")
            : (Comparable) len(row[1]) == 0 ? list()
            : ong-cat-kernels(r, row[1], kernels);
        }
        def ong-cat-kernels(r, accept, kernels) = (Comparable) len(kernels) == 0 ? list() : append(ong-when((Comparable) ong-handled?(ong-k-text(head(kernels)), accept) == 0, "category " ++ ong-py(ong-r-name(r)) ++ " (type=" ++ int_to_str(ong-r-type(r)) ++ " inst=" ++ int_to_str(ong-r-inst(r)) ++ ") in ontology expects one of " ++ lx-py-str-list(accept) ++ " as a verb handler in " ++ ong-k-name(head(kernels)) ++ " but none found"), ong-cat-kernels(r, accept, tail(kernels)));
        def ong-handled?(text, accept) = (Comparable) len(accept) == 0 ? 0 : (Comparable) ong-handler?(text, head(accept), 0) == 1 ? 1 : ong-handled?(text, tail(accept));
        // case\s+"x"\s*[:=]  |  "x"\s*=>  |  verb\s*===\s*"x"  — at any "x" in the text
        def ong-handler?(text, x, from) {
            let i = str_find(text, "\"" ++ x ++ "\"", from);
            i < 0 ? 0 : (Comparable) ong-handler-at?(text, x, i) == 1 ? 1 : ong-handler?(text, x, i + 1);
        }
        def ong-handler-at?(text, x, i) {
            let after = lx-skip-ws(text, i + (str_len(x) + 2));
            ((Comparable) ong-case-before?(text, i) == 1) && (((Comparable) lx-at?(text, after, ":") == 1) || ((Comparable) lx-at?(text, after, "=") == 1)) ? 1
            : (Comparable) lx-at?(text, after, "=>") == 1 ? 1
            : ong-verb-before?(text, i);
        }
        def ong-case-before?(text, i) {
            let w = ong-ws-back(text, i);
            (Comparable) w == i ? 0 : ((w - 4) >= 0) && ((String) substring(text, w - 4, w) == "case") ? 1 : 0;
        }
        def ong-verb-before?(text, i) {
            let e = ong-ws-back(text, i);
            (e - 3) < 0 ? 0 : (Comparable) ((String) substring(text, e - 3, e) == "===") == 0 ? 0 : ong-verb-word?(text, ong-ws-back(text, e - 3));
        }
        def ong-verb-word?(text, e) = ((e - 4) >= 0) && ((String) substring(text, e - 4, e) == "verb") ? 1 : 0;

        // ---- the analysis: list(drifts) ----
        def ong-missing(root, rel) = list("missing input: " ++ root ++ rel);
        def ong-analysis(root) {
            let json = read_file(root ++ ong-json());
            let go = read_file(root ++ ong-go());
            let rust = read_file(root ++ ong-rust());
            let ts = read_file(root ++ ong-ts());
            nothing?(json) ? ong-missing(root, ong-json())
            : nothing?(go) ? ong-missing(root, ong-go())
            : nothing?(rust) ? ong-missing(root, ong-rust())
            : nothing?(ts) ? ong-missing(root, ong-ts())
            : ong-analysis-texts(parse-json(ong-json(), json), ong-dispatch(go, "go"), ong-dispatch(rust, "rust"), ong-dispatch(ts, "ts"), go, rust, ts);
        }
        def ong-analysis-texts(root, go, rust, ts, gotext, rusttext, tstext) {
            (String) go[0] == "refused" ? list(go[1])
            : (String) rust[0] == "refused" ? list(rust[1])
            : (String) ts[0] == "refused" ? list(ts[1])
            : ong-analysis-with(ong-rows(root, "categories"), ong-rows(root, "primitives"), list(list("form-kernel-go", go[1], gotext), list("form-kernel-rust", rust[1], rusttext), list("form-kernel-ts", ts[1], tstext)));
        }
        def ong-analysis-with(cats, prims, kernels) = append(ong-prim-drifts(prims, kernels), append(ong-reverse-drifts(kernels, tb-map(prims, ong-r-name)), ong-cat-drifts(cats, kernels)));

        // ---- the voice ----
        def ong-ok-line() = "form ontology matches kernel parsers (Go/Rust/TS)";
        def ong-judge(root) = lx-verdict(ong-name(), ong-analysis(root), ong-ok-line());
        def ong-run() = ong-judge("");
    }
    ong-run();
}
