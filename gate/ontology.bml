//////////////////////////////////////////////////////////////////////
//
// gate/ontology.bml — the form-ontology drift gate as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/validate_form_ontology.py, read as the spec and
// transliterated check for check. The script stays in place as a
// witness while this lens stands its first landings; the drift-gates
// row (gate/drift-gates.bml, "ontology") runs this door.
//
// THE INVARIANT. form/form-stdlib/form-ontology.json is the data
// grammar: its `primitives` rows (name type inst; types 12 math, 13
// compare, 14 logic) and its `categories` rows (the shapes do,
// sequence, let, if-then, if, match, fndef, fncall, ident). Each
// kernel's verb dispatch — Go buildVerb, Rust build_verb, TypeScript
// buildVerb in reader.ts — agrees with it when:
//   - every primitive row has a `case "name"` arm in every kernel,
//     that arm's constructor is the row's category (catMath/cat_math/
//     RBasic.MATH and its siblings), and where the arm's instance can
//     be read (a named constant the kernel defines: `RMathPlus uint32
//     = 1`, `const RMATH_PLUS: u32 = 1;`, a TypeScript enum member or
//     a literal) it equals the row's inst;
//   - every math/compare/logic arm whose name is a word (operator
//     spellings like + and == are surface aliases) has a primitive row;
//   - every category row is one the script's alias table knows (fncall
//     and ident have no explicit arm and pass), and each kernel's
//     source carries one of its accepted verb handlers as `case "x"`,
//     `"x" =>` or `verb === "x"`.
//
// HOW THE ARMS ARE READ, AS THE SCRIPT READS THEM. The dispatch body
// is the brace block after the function head, matched with strings,
// line comments and block comments unseen. Every `case "name":` (Go,
// TypeScript) or `"name" =>` (Rust) inside it opens a chunk that runs
// to the next; the chunk's FIRST constructor call names the arm's
// category and instance. A chunk with no constructor is a fall-through
// whose names take the NEXT resolvable chunk's reading — which is how
// the script reads Go's choose/fail/stop (catChoice, a constructor it
// does not know) as `block 2` off the defn arm that follows them. The
// lens reads the same, so the two agree; the header of the twin names
// no such intent, and a reader who wants choose/fail/stop judged will
// add catChoice to both tables in one sitting. TypeScript arms whose
// instance is `mathInst(...)` (the float and int64 widths) are not
// primitives and are skipped; TypeScript instances named through
// `RMath.PLUS` resolve only through an `enum` the file declares, and
// reader.ts declares none, so every TypeScript instance reads as
// unknown and is not compared — the twin's reading, kept.
//
// INPUTS. The ontology through json.fk (parse-json); the three kernel
// texts read whole; all under a root the band can re-point ("" is the
// live tree).
//
// EXIT. No drift: one line `ontology: OK form ontology matches kernel
// parsers (Go/Rust/TS)` and the answer 1 — the script's line after its
// check mark. Otherwise one `error: ...` line per drift in the
// script's order (primitive rows in table order, kernels Go Rust TS
// within each; then the reverse check kernel by kernel; then the
// category rows), then `ontology: FAIL` and the answer 0 — the
// script's words after its `  - `. A text the tree does not have, or a
// kernel whose dispatch function or brace block cannot be found, is
// one named error and a refusal, where the script exits or dies with
// its own words.
//
// Run directly:  ./fkwu gate/ontology.bml    ; last line 1 / 0
// Twin:          python3 form/scripts/validate_form_ontology.py
// Proven by:     gate/tests/ontology-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormOntologyGate {
        thought ontology-pattern = list("json-is-the-grammar", "arms-read-as-the-script-reads-them", "fall-through-takes-the-next-reading", "words-not-operators", "twin-voice-byte-for-byte");

        def ong-name() = "ontology";
        def ong-json() = "form/form-stdlib/form-ontology.json";
        def ong-go() = "form/form-kernel-go/main.go";
        def ong-rust() = "form/form-kernel-rust/src/main.rs";
        def ong-ts() = "form/form-kernel-ts/src/reader.ts";
        def ong-kernels() = list("form-kernel-go", "form-kernel-rust", "form-kernel-ts");
        def ong-none() = sub(0, 1);
        def ong-when(cond, msg) = if cond then list(msg) else list();
        def ong-py(s) = lx-py-str(s);

        // ---- the script's tables as rows ----
        def ong-type-label(ty) = if eq(ty, 12) then "math" else if eq(ty, 13) then "compare" else if eq(ty, 14) then "logic" else "";
        def ong-prim-label?(label) = if or(str_eq(label, "math"), or(str_eq(label, "compare"), str_eq(label, "logic"))) then 1 else 0;
        def ong-alias-row(name, accept) = list(name, accept);
        // the accepted handlers, already sorted (the script prints sorted(accept))
        def ong-aliases() = list(ong-alias-row("do", list("do")), ong-alias-row("sequence", list("params", "seq")), ong-alias-row("let", list("let")), ong-alias-row("if-then", list("if")), ong-alias-row("if", list("if")), ong-alias-row("match", list("match")), ong-alias-row("fndef", list("defn")), ong-alias-row("fncall", list()), ong-alias-row("ident", list()));
        def ong-alias-named?(row, name) = if str_eq(nth(row, 0), name) then 1 else 0;
        def ong-cat-map(kind) = if str_eq(kind, "go") then list(list("catMath", "math"), list("catCompare", "compare"), list("catLogic", "logic"), list("catBlock", "block"), list("catCond", "cond"), list("catMatch", "match"), list("catFnDef", "fndef"), list("catFnCall", "fncall"), list("catIdent", "ident"))
            else list(list("cat_math", "math"), list("cat_compare", "compare"), list("cat_logic", "logic"), list("cat_block", "block"), list("cat_cond", "cond"), list("cat_match", "match"), list("cat_fndef", "fndef"), list("cat_fncall", "fncall"), list("cat_ident", "ident"));
        def ong-rbasic-map() = list(list("MATH", "math"), list("COMPARE", "compare"), list("LOGIC", "logic"), list("MATCH", "match"), list("BLOCK", "block"), list("COND", "cond"), list("FNDEF", "fndef"), list("FNCALL", "fncall"), list("IDENT", "ident"), list("LIST", "list"));
        def ong-map-named?(row, name) = if str_eq(nth(row, 0), name) then 1 else 0;
        def ong-map-get(rows, name) {
            let row = tb-find2(rows, ong-map-named?, name);
            if eq(len(row), 0) then "" else nth(row, 1);
        }

        // ---- the ontology: rows (name type inst) from an array of objects ----
        def ong-rows(root, key) = if json-object-has?(root, key) then tb-map(node_children(json-object-get(root, key)), ong-row-of) else list();
        def ong-row-of(obj) = list(node_value(json-object-get(obj, "name")), node_value(json-object-get(obj, "type")), node_value(json-object-get(obj, "inst")));
        def ong-r-name(r) = nth(r, 0);
        def ong-r-type(r) = nth(r, 1);
        def ong-r-inst(r) = nth(r, 2);
        def ong-r-named?(r, name) = if str_eq(nth(r, 0), name) then 1 else 0;

        // ---- the brace block: strings ("', `) with escapes, // and /* */ unseen; answers the index of the matching } or -1 ----
        def ong-quote?(b) = if or(eq(b, 34), or(eq(b, 39), eq(b, 96))) then 1 else 0;
        def ong-brace-end(text, i, depth) {
            if ge(i, str_len(text)) then sub(0, 1)
            else if eq(ong-quote?(str_byte_at(text, i)), 1) then ong-brace-end(text, add(ong-string-end(text, add(i, 1), str_byte_at(text, i)), 1), depth)
            else if eq(lx-at?(text, i, "//"), 1) then ong-brace-end(text, ong-line-end(text, i), depth)
            else if eq(lx-at?(text, i, "/*"), 1) then ong-brace-end(text, ong-comment-end(text, i), depth)
            else if eq(str_byte_at(text, i), 123) then ong-brace-end(text, add(i, 1), add(depth, 1))
            else if eq(str_byte_at(text, i), 125) then ong-brace-close(text, i, depth)
            else ong-brace-end(text, add(i, 1), depth);
        }
        def ong-brace-close(text, i, depth) = if le(depth, 1) then i else ong-brace-end(text, add(i, 1), sub(depth, 1));
        // the index of the closing quote (or the text's end): a backslash skips the next byte
        def ong-string-end(text, j, quote) {
            if ge(j, str_len(text)) then j
            else if eq(str_byte_at(text, j), quote) then j
            else if eq(str_byte_at(text, j), 92) then ong-string-end(text, add(j, 2), quote)
            else ong-string-end(text, add(j, 1), quote);
        }
        def ong-line-end(text, i) {
            let nl = str_find(text, lx-nl(), i);
            if lt(nl, 0) then str_len(text) else add(nl, 1);
        }
        def ong-comment-end(text, i) {
            let e = str_find(text, "*/", add(i, 2));
            if lt(e, 0) then str_len(text) else add(e, 2);
        }

        // ---- locating the dispatch function: the "{" of its body, or -1 ----
        // Go: func (...) buildVerb(...) ... then the brace; Rust: fn build_verb(...) ... then the brace; TypeScript: function buildVerb(...): NodeID then the brace.
        // (A comment line may not END with an open brace: the BML section scanner reads lines, comments included, and counts one.)
        def ong-fn-open(text, kind) {
            if str_eq(kind, "go") then ong-open-after(text, ong-go-head(text, 0))
            else if str_eq(kind, "rust") then ong-open-after(text, ong-word-head(text, "fn", "build_verb", 0))
            else ong-ts-open(text, ong-word-head(text, "function", "buildVerb", 0));
        }
        // func\s+\([^)]*\)\s+buildVerb : the "func" whose parenthesised receiver is followed by the name
        def ong-go-head(text, from) {
            let i = str_find(text, "func", from);
            if lt(i, 0) then sub(0, 1) else ong-go-head-at(text, i, lx-skip-ws(text, add(i, 4)));
        }
        def ong-go-head-at(text, i, k) {
            if eq(k, add(i, 4)) then ong-go-head(text, add(i, 1))
            else if eq(lx-at?(text, k, "("), 0) then ong-go-head(text, add(i, 1))
            else ong-go-head-recv(text, i, str_find(text, ")", k));
        }
        def ong-go-head-recv(text, i, c) {
            if lt(c, 0) then sub(0, 1) else ong-go-head-name(text, i, add(c, 1), lx-skip-ws(text, add(c, 1)));
        }
        def ong-go-head-name(text, i, j, k) = if and(gt(k, j), eq(lx-at?(text, k, "buildVerb"), 1)) then add(k, 9) else ong-go-head(text, add(i, 1));
        // <word>\s+<name> : answers the index after the name, or -1
        def ong-word-head(text, word, name, from) {
            let i = str_find(text, word, from);
            if lt(i, 0) then sub(0, 1) else ong-word-head-at(text, word, name, i, lx-skip-ws(text, add(i, str_len(word))));
        }
        def ong-word-head-at(text, word, name, i, k) {
            if eq(k, add(i, str_len(word))) then ong-word-head(text, word, name, add(i, 1))
            else if eq(lx-boundary-before?(text, i), 0) then ong-word-head(text, word, name, add(i, 1))
            else if eq(lx-at?(text, k, name), 1) then add(k, str_len(name))
            else ong-word-head(text, word, name, add(i, 1));
        }
        // \s*\([^)]*\)[^{]*\{ after the name: the first ")" then the first "{"
        def ong-open-after(text, after) {
            if lt(after, 0) then sub(0, 1) else ong-open-paren(text, str_find(text, "(", after));
        }
        def ong-open-paren(text, p) = if lt(p, 0) then sub(0, 1) else ong-open-brace(text, str_find(text, ")", p));
        def ong-open-brace(text, c) = if lt(c, 0) then sub(0, 1) else str_find(text, "{", c);
        // TypeScript: \([^)]*\)\s*:\s*NodeID\s* and then the open brace
        def ong-ts-open(text, after) {
            if lt(after, 0) then sub(0, 1) else ong-ts-open-paren(text, str_find(text, "(", after));
        }
        def ong-ts-open-paren(text, p) = if lt(p, 0) then sub(0, 1) else ong-ts-open-colon(text, str_find(text, ")", p));
        def ong-ts-open-colon(text, c) {
            if lt(c, 0) then sub(0, 1) else ong-ts-open-type(text, lx-skip-ws(text, add(c, 1)));
        }
        def ong-ts-open-type(text, k) {
            if eq(lx-at?(text, k, ":"), 0) then sub(0, 1) else ong-ts-open-nodeid(text, lx-skip-ws(text, add(k, 1)));
        }
        def ong-ts-open-nodeid(text, k) {
            if eq(lx-at?(text, k, "NodeID"), 0) then sub(0, 1) else ong-ts-open-final(text, lx-skip-ws(text, add(k, 6)));
        }
        def ong-ts-open-final(text, k) = if eq(lx-at?(text, k, "{"), 1) then k else sub(0, 1);
        // the body: Go/Rust keep the "{" (the script slices from it); TypeScript starts after it
        def ong-body(text, kind) {
            let open = ong-fn-open(text, kind);
            if lt(open, 0) then list("refused", if str_eq(kind, "ts") then "buildVerb not found in TS reader.ts" else "buildVerb/build_verb function not found") else ong-body-at(text, kind, open, ong-brace-end(text, open, 0));
        }
        def ong-body-at(text, kind, open, close) = if lt(close, 0) then list("refused", "unmatched brace") else list("ok", substring(text, if str_eq(kind, "ts") then add(open, 1) else open, close));

        // ---- case positions inside a body: rows (pos, name) in order ----
        // Go / TypeScript: case\s+"name"\s*:
        def ong-cases(body) = ong-cases-go(body, 0, list());
        def ong-cases-go(body, from, acc) {
            let i = str_find(body, "case", from);
            if lt(i, 0) then reverse(acc) else ong-cases-go(body, add(i, 1), ong-case-at(body, i, lx-skip-ws(body, add(i, 4)), acc));
        }
        def ong-case-at(body, i, k, acc) {
            if eq(k, add(i, 4)) then acc else ong-case-name(body, i, ong-quoted(body, k), acc);
        }
        def ong-case-name(body, i, q, acc) = if eq(len(q), 0) then acc else if eq(lx-at?(body, lx-skip-ws(body, nth(q, 1)), ":"), 0) then acc else cons(list(i, nth(q, 0)), acc);
        // Rust: "name"\s*=>
        def ong-arms(body) = ong-arms-go(body, 0, list());
        def ong-arms-go(body, from, acc) {
            let i = str_find(body, "\"", from);
            if lt(i, 0) then reverse(acc) else ong-arms-at(body, i, ong-quoted(body, i), acc);
        }
        def ong-arms-at(body, i, q, acc) {
            if eq(len(q), 0) then ong-arms-go(body, add(i, 1), acc)
            else if eq(lx-at?(body, lx-skip-ws(body, nth(q, 1)), "=>"), 1) then ong-arms-go(body, nth(q, 1), cons(list(i, nth(q, 0)), acc))
            else ong-arms-go(body, add(i, 1), acc);
        }
        // "name" at i (one or more bytes, no quote inside) -> list(name, end-after-quote) or list()
        def ong-quoted(text, i) {
            if eq(lx-at?(text, i, "\""), 0) then list() else ong-quoted-end(text, add(i, 1), str_find(text, "\"", add(i, 1)));
        }
        def ong-quoted-end(text, a, b) = if lt(b, 0) then list() else if eq(b, a) then list() else list(substring(text, a, b), add(b, 1));

        // ---- constants: Go \b(R\w+)\s+uint32\s*=\s*(\d+); Rust \bconst\s+(R\w+)\s*:\s*u32\s*=\s*(\d+)\s*; ----
        def ong-consts(text, kind) = if str_eq(kind, "go") then ong-go-consts(text, 0, list()) else ong-rust-consts(text, 0, list());
        def ong-span-word(s, i) = if eq(lx-word-at?(s, i), 1) then ong-span-word(s, add(i, 1)) else i;
        def ong-go-consts(text, from, acc) {
            let i = str_find(text, "R", from);
            if lt(i, 0) then reverse(acc) else ong-go-consts(text, add(i, 1), ong-go-const-at(text, i, acc));
        }
        def ong-go-const-at(text, i, acc) {
            let j = ong-span-word(text, add(i, 1));
            if eq(lx-boundary-before?(text, i), 0) then acc
            else if eq(j, add(i, 1)) then acc
            else ong-go-const-ws(text, i, j, lx-skip-ws(text, j), acc);
        }
        def ong-go-const-ws(text, i, j, k, acc) {
            if eq(k, j) then acc
            else if eq(lx-at?(text, k, "uint32"), 0) then acc
            else ong-const-eq(text, add(k, 6), substring(text, i, j), acc);
        }
        def ong-const-eq(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            if eq(lx-at?(text, m2, "="), 0) then acc else ong-const-digits(text, lx-skip-ws(text, add(m2, 1)), name, acc);
        }
        def ong-const-digits(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            if eq(e, d) then acc else cons(list(name, lx-int-span(text, d, e)), acc);
        }
        def ong-rust-consts(text, from, acc) {
            let i = str_find(text, "const", from);
            if lt(i, 0) then reverse(acc) else ong-rust-consts(text, add(i, 1), ong-rust-const-at(text, i, lx-skip-ws(text, add(i, 5)), acc));
        }
        def ong-rust-const-at(text, i, k, acc) {
            if eq(lx-boundary-before?(text, i), 0) then acc
            else if eq(k, add(i, 5)) then acc
            else if eq(lx-at?(text, k, "R"), 0) then acc
            else ong-rust-const-name(text, k, ong-span-word(text, add(k, 1)), acc);
        }
        def ong-rust-const-name(text, k, j, acc) {
            if eq(j, add(k, 1)) then acc else ong-rust-const-colon(text, k, j, lx-skip-ws(text, j), acc);
        }
        def ong-rust-const-colon(text, k, j, c, acc) {
            if eq(lx-at?(text, c, ":"), 0) then acc else ong-rust-const-u32(text, k, j, lx-skip-ws(text, add(c, 1)), acc);
        }
        def ong-rust-const-u32(text, k, j, u, acc) = if eq(lx-at?(text, u, "u32"), 0) then acc else ong-rust-const-value(text, add(u, 3), substring(text, k, j), acc);
        def ong-rust-const-value(text, m, name, acc) {
            let m2 = lx-skip-ws(text, m);
            if eq(lx-at?(text, m2, "="), 0) then acc else ong-rust-const-semi(text, lx-skip-ws(text, add(m2, 1)), name, acc);
        }
        def ong-rust-const-semi(text, d, name, acc) {
            let e = lx-digits-end(text, d);
            if eq(e, d) then acc else if eq(lx-at?(text, lx-skip-ws(text, e), ";"), 0) then acc else cons(list(name, lx-int-span(text, d, e)), acc);
        }
        def ong-const-value(consts, name) {
            let row = tb-find2(consts, ong-map-named?, name);
            if eq(len(row), 0) then ong-none() else nth(row, 1);
        }

        // ---- the first constructor call in a chunk: list(label, inst) or list() ----
        // \b(cat...)\s*\(\s*(R\w+)?\s*\)  — the earliest occurrence of any name in the table
        def ong-cat-call(chunk, kind, consts) = ong-cat-call-go(chunk, if str_eq(kind, "go") then "cat" else "cat_", ong-cat-map(kind), consts, 0);
        def ong-cat-call-go(chunk, stem, map, consts, from) {
            let i = str_find(chunk, stem, from);
            if lt(i, 0) then list() else ong-cat-call-at(chunk, stem, map, consts, i, ong-cat-name(chunk, i, map));
        }
        def ong-cat-name(chunk, i, map) {
            let j = ong-span-word(chunk, i);
            if eq(lx-boundary-before?(chunk, i), 0) then "" else ong-map-get(map, substring(chunk, i, j));
        }
        def ong-cat-call-at(chunk, stem, map, consts, i, label) {
            if eq(str_len(label), 0) then ong-cat-call-go(chunk, stem, map, consts, add(i, 1))
            else ong-cat-call-paren(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, ong-span-word(chunk, i)));
        }
        def ong-cat-call-paren(chunk, stem, map, consts, i, label, p) {
            if eq(lx-at?(chunk, p, "("), 0) then ong-cat-call-go(chunk, stem, map, consts, add(i, 1))
            else ong-cat-call-arg(chunk, stem, map, consts, i, label, lx-skip-ws(chunk, add(p, 1)));
        }
        def ong-cat-call-arg(chunk, stem, map, consts, i, label, a) {
            if eq(lx-at?(chunk, a, "R"), 1) then ong-cat-call-const(chunk, stem, map, consts, i, label, a, ong-span-word(chunk, add(a, 1)))
            else if eq(lx-at?(chunk, a, ")"), 1) then list(label, ong-none())
            else ong-cat-call-go(chunk, stem, map, consts, add(i, 1));
        }
        def ong-cat-call-const(chunk, stem, map, consts, i, label, a, j) {
            if eq(lx-at?(chunk, lx-skip-ws(chunk, j), ")"), 0) then ong-cat-call-go(chunk, stem, map, consts, add(i, 1))
            else list(label, ong-const-value(consts, substring(chunk, a, j)));
        }

        // ---- TypeScript enums: \benum\s+(\w+)\s*\{([^}]*)\} with members (\w+)\s*=\s*(\d+) -> rows (Enum.Member, value) ----
        def ong-enums(text) = ong-enums-go(text, 0, list());
        def ong-enums-go(text, from, acc) {
            let i = str_find(text, "enum", from);
            if lt(i, 0) then acc else ong-enums-go(text, add(i, 1), ong-enum-at(text, i, lx-skip-ws(text, add(i, 4)), acc));
        }
        def ong-enum-at(text, i, k, acc) {
            let j = ong-span-word(text, k);
            if eq(lx-boundary-before?(text, i), 0) then acc
            else if eq(k, add(i, 4)) then acc
            else if eq(j, k) then acc
            else ong-enum-open(text, substring(text, k, j), lx-skip-ws(text, j), acc);
        }
        def ong-enum-open(text, name, o, acc) {
            if eq(lx-at?(text, o, "{"), 0) then acc else ong-enum-body(text, name, add(o, 1), str_find(text, "}", add(o, 1)), acc);
        }
        def ong-enum-body(text, name, a, b, acc) = if lt(b, 0) then acc else append(acc, ong-enum-members(substring(text, a, b), name, 0, list()));
        def ong-enum-members(body, name, from, acc) {
            let i = str_find(body, "=", from);
            if lt(i, 0) then reverse(acc) else ong-enum-members(body, name, add(i, 1), ong-enum-member-at(body, name, i, acc));
        }
        def ong-enum-member-at(body, name, i, acc) {
            let e = ong-ws-back(body, i);
            let s = ong-word-back(body, e);
            let d = lx-skip-ws(body, add(i, 1));
            let de = lx-digits-end(body, d);
            if or(eq(s, e), eq(de, d)) then acc else cons(list(str_concat(name, str_concat(".", substring(body, s, e))), lx-int-span(body, d, de)), acc);
        }
        def ong-ws-back(s, i) = if and(gt(i, 0), eq(lx-ws-at?(s, sub(i, 1)), 1)) then ong-ws-back(s, sub(i, 1)) else i;
        def ong-word-back(s, i) = if and(gt(i, 0), eq(lx-word-at?(s, sub(i, 1)), 1)) then ong-word-back(s, sub(i, 1)) else i;

        // ---- TypeScript chunk: first RBasic.X; inst: R.Y through the enums, or a literal; mathInst( skips ----
        def ong-ts-label(chunk) {
            let i = str_find(chunk, "RBasic.", 0);
            if lt(i, 0) then "" else ong-ts-label-at(chunk, add(i, 7), ong-span-word(chunk, add(i, 7)));
        }
        // "" when no RBasic.X stands; "?" when it stands but names no label (the script clears and continues)
        def ong-ts-label-at(chunk, a, j) {
            let label = ong-map-get(ong-rbasic-map(), substring(chunk, a, j));
            if eq(str_len(label), 0) then "?" else label;
        }
        def ong-ts-inst(chunk, enums) {
            let i = str_find(chunk, "inst", 0);
            if lt(i, 0) then ong-none() else ong-ts-inst-at(chunk, enums, i, lx-skip-ws(chunk, add(i, 4)));
        }
        def ong-ts-inst-at(chunk, enums, i, k) {
            if eq(lx-at?(chunk, k, ":"), 0) then ong-ts-inst-next(chunk, enums, i)
            else ong-ts-inst-value(chunk, enums, i, lx-skip-ws(chunk, add(k, 1)));
        }
        def ong-ts-inst-next(chunk, enums, i) {
            let n = str_find(chunk, "inst", add(i, 1));
            if lt(n, 0) then ong-none() else ong-ts-inst-at(chunk, enums, n, lx-skip-ws(chunk, add(n, 4)));
        }
        def ong-ts-inst-value(chunk, enums, i, v) {
            if eq(lx-at?(chunk, v, "R"), 1) then ong-ts-inst-enum(chunk, enums, i, v, ong-span-word(chunk, add(v, 1)))
            else if eq(lx-digit-at?(chunk, v), 1) then lx-int-span(chunk, v, lx-digits-end(chunk, v))
            else ong-ts-inst-next(chunk, enums, i);
        }
        def ong-ts-inst-enum(chunk, enums, i, v, j) {
            if eq(lx-at?(chunk, j, "."), 0) then ong-ts-inst-next(chunk, enums, i)
            else ong-ts-inst-member(chunk, enums, i, substring(chunk, v, j), add(j, 1), ong-span-word(chunk, add(j, 1)));
        }
        def ong-ts-inst-member(chunk, enums, i, enumname, a, b) = if eq(b, a) then ong-ts-inst-next(chunk, enums, i) else ong-const-value(enums, str_concat(enumname, str_concat(".", substring(chunk, a, b))));

        // ---- walking the chunks: out rows (name label inst), pending names fall through to the next reading ----
        def ong-chunk(body, positions, k) = substring(body, nth(nth(positions, k), 0), if lt(add(k, 1), len(positions)) then nth(nth(positions, add(k, 1)), 0) else str_len(body));
        def ong-walk(body, positions, kind, consts, enums, k, pending, out) {
            if ge(k, len(positions)) then out
            else ong-walk-step(body, positions, kind, consts, enums, k, pending, out, ong-chunk(body, positions, k), nth(nth(positions, k), 1));
        }
        def ong-walk-step(body, positions, kind, consts, enums, k, pending, out, chunk, name) {
            if str_eq(kind, "ts") then ong-walk-ts(body, positions, kind, consts, enums, k, pending, out, chunk, name, ong-ts-label(chunk))
            else ong-walk-cat(body, positions, kind, consts, enums, k, pending, out, name, ong-cat-call(chunk, kind, consts));
        }
        def ong-walk-cat(body, positions, kind, consts, enums, k, pending, out, name, call) {
            if eq(len(call), 0) then ong-walk(body, positions, kind, consts, enums, add(k, 1), append(pending, list(name)), out)
            else ong-walk(body, positions, kind, consts, enums, add(k, 1), list(), ong-assign(out, append(pending, list(name)), nth(call, 0), nth(call, 1)));
        }
        def ong-walk-ts(body, positions, kind, consts, enums, k, pending, out, chunk, name, label) {
            if eq(str_len(label), 0) then ong-walk(body, positions, kind, consts, enums, add(k, 1), append(pending, list(name)), out)
            else if str_eq(label, "?") then ong-walk(body, positions, kind, consts, enums, add(k, 1), list(), out)
            else if ge(str_find(chunk, "mathInst", 0), 0) then ong-walk-ts-math(body, positions, kind, consts, enums, k, pending, out, chunk, name, label, str_find(chunk, "mathInst", 0))
            else ong-walk(body, positions, kind, consts, enums, add(k, 1), list(), ong-assign(out, append(pending, list(name)), label, ong-ts-inst(chunk, enums)));
        }
        // mathInst\s*\( : the script skips the chunk (and drops its pending names) only when the paren follows
        def ong-walk-ts-math(body, positions, kind, consts, enums, k, pending, out, chunk, name, label, m) {
            if eq(lx-at?(chunk, lx-skip-ws(chunk, add(m, 8)), "("), 1) then ong-walk(body, positions, kind, consts, enums, add(k, 1), list(), out)
            else ong-walk(body, positions, kind, consts, enums, add(k, 1), list(), ong-assign(out, append(pending, list(name)), label, ong-ts-inst(chunk, enums)));
        }
        // dict assignment: a known name keeps its seat and takes the new reading; a new name joins at the end
        def ong-assign(out, names, label, inst) = if eq(len(names), 0) then out else ong-assign(ong-put(out, list(head(names), label, inst)), tail(names), label, inst);
        def ong-put(out, r) = if eq(len(tb-find2(out, ong-r-named?, nth(r, 0))), 0) then append(out, list(r)) else ong-replace(out, r);
        def ong-replace(out, r) = if eq(len(out), 0) then list() else if str_eq(nth(head(out), 0), nth(r, 0)) then cons(r, tail(out)) else cons(head(out), ong-replace(tail(out), r));
        // one kernel's dispatch: list("ok", rows) or list("refused", message)
        def ong-dispatch(text, kind) {
            let body = ong-body(text, kind);
            if str_eq(nth(body, 0), "refused") then body else list("ok", ong-dispatch-in(nth(body, 1), text, kind));
        }
        def ong-dispatch-in(body, text, kind) {
            if str_eq(kind, "rust") then ong-walk(body, ong-arms(body), kind, ong-consts(text, kind), list(), 0, list(), list())
            else if str_eq(kind, "go") then ong-walk(body, ong-cases(body), kind, ong-consts(text, kind), list(), 0, list(), list())
            else ong-walk(body, ong-cases(body), kind, list(), ong-enums(text), 0, list(), list());
        }
        def ong-k-name(k) = nth(k, 0);
        def ong-k-rows(k) = nth(k, 1);
        def ong-k-text(k) = nth(k, 2);

        // ---- validation ----
        def ong-prim-drifts(prims, kernels) = if eq(len(prims), 0) then list() else append(ong-prim-one(head(prims), kernels), ong-prim-drifts(tail(prims), kernels));
        def ong-prim-one(r, kernels) {
            let want = ong-type-label(ong-r-type(r));
            if eq(str_len(want), 0) then list(str_concat("FORM-PRIMITIVE-TABLE row (", str_concat(ong-py(ong-r-name(r)), str_concat(" ", str_concat(int_to_str(ong-r-type(r)), str_concat(" ", str_concat(int_to_str(ong-r-inst(r)), str_concat(") has unknown type ", int_to_str(ong-r-type(r))))))))))
            else ong-prim-kernels(r, want, kernels);
        }
        def ong-prim-kernels(r, want, kernels) = if eq(len(kernels), 0) then list() else append(ong-prim-kernel(r, want, head(kernels), tb-find2(ong-k-rows(head(kernels)), ong-r-named?, ong-r-name(r))), ong-prim-kernels(r, want, tail(kernels)));
        def ong-prim-kernel(r, want, k, entry) {
            if eq(len(entry), 0) then list(str_concat("primitive ", str_concat(ong-py(ong-r-name(r)), str_concat(" (type=", str_concat(int_to_str(ong-r-type(r)), str_concat(" inst=", str_concat(int_to_str(ong-r-inst(r)), str_concat(") in ontology but no `case \"", str_concat(ong-r-name(r), str_concat("\"` in ", ong-k-name(k)))))))))))
            else append(ong-when(not(str_eq(nth(entry, 1), want)), str_concat("primitive ", str_concat(ong-py(ong-r-name(r)), str_concat(" in ontology says category=", str_concat(want, str_concat(" but ", str_concat(ong-k-name(k), str_concat(" dispatches to category=", nth(entry, 1))))))))),
                        ong-when(and(ge(nth(entry, 2), 0), not(eq(nth(entry, 2), ong-r-inst(r)))), str_concat("primitive ", str_concat(ong-py(ong-r-name(r)), str_concat(" in ontology has inst=", str_concat(int_to_str(ong-r-inst(r)), str_concat(" but ", str_concat(ong-k-name(k), str_concat(" dispatches with inst=", int_to_str(nth(entry, 2)))))))))));
        }
        // ^[A-Za-z_][A-Za-z0-9_-]*$
        def ong-word-name?(s) = if eq(str_len(s), 0) then 0 else if eq(lx-digit-at?(s, 0), 1) then 0 else if eq(str_byte_at(s, 0), 45) then 0 else ong-word-name-go(s, 0);
        def ong-word-name-go(s, i) = if ge(i, str_len(s)) then 1 else if or(eq(lx-word-at?(s, i), 1), eq(str_byte_at(s, i), 45)) then ong-word-name-go(s, add(i, 1)) else 0;
        def ong-reverse-drifts(kernels, primnames) = if eq(len(kernels), 0) then list() else append(ong-reverse-kernel(ong-k-name(head(kernels)), ong-k-rows(head(kernels)), primnames), ong-reverse-drifts(tail(kernels), primnames));
        def ong-reverse-kernel(kname, rows, primnames) = if eq(len(rows), 0) then list() else append(ong-reverse-one(kname, head(rows), primnames), ong-reverse-kernel(kname, tail(rows), primnames));
        def ong-reverse-one(kname, r, primnames) = ong-when(and(eq(ong-prim-label?(nth(r, 1)), 1), and(eq(lx-str-in?(primnames, nth(r, 0)), 0), eq(ong-word-name?(nth(r, 0)), 1))), str_concat(kname, str_concat(" has `case \"", str_concat(nth(r, 0), str_concat("\"` → ", str_concat(nth(r, 1), " but FORM-PRIMITIVE-TABLE has no row for it"))))));
        def ong-cat-drifts(cats, kernels) = if eq(len(cats), 0) then list() else append(ong-cat-one(head(cats), kernels), ong-cat-drifts(tail(cats), kernels));
        def ong-cat-one(r, kernels) {
            let row = tb-find2(ong-aliases(), ong-alias-named?, ong-r-name(r));
            if eq(len(row), 0) then list(str_concat("FORM-CATEGORY-TABLE row (", str_concat(ong-py(ong-r-name(r)), str_concat(" ", str_concat(int_to_str(ong-r-type(r)), str_concat(" ", str_concat(int_to_str(ong-r-inst(r)), ") has no alias mapping in validate_form_ontology.py — extend CATEGORY_NAME_ALIASES if this is a new shape")))))))
            else if eq(len(nth(row, 1)), 0) then list()
            else ong-cat-kernels(r, nth(row, 1), kernels);
        }
        def ong-cat-kernels(r, accept, kernels) = if eq(len(kernels), 0) then list() else append(ong-when(eq(ong-handled?(ong-k-text(head(kernels)), accept), 0), str_concat("category ", str_concat(ong-py(ong-r-name(r)), str_concat(" (type=", str_concat(int_to_str(ong-r-type(r)), str_concat(" inst=", str_concat(int_to_str(ong-r-inst(r)), str_concat(") in ontology expects one of ", str_concat(lx-py-str-list(accept), str_concat(" as a verb handler in ", str_concat(ong-k-name(head(kernels)), " but none found"))))))))))), ong-cat-kernels(r, accept, tail(kernels)));
        def ong-handled?(text, accept) = if eq(len(accept), 0) then 0 else if eq(ong-handler?(text, head(accept), 0), 1) then 1 else ong-handled?(text, tail(accept));
        // case\s+"x"\s*[:=]  |  "x"\s*=>  |  verb\s*===\s*"x"  — at any "x" in the text
        def ong-handler?(text, x, from) {
            let i = str_find(text, str_concat("\"", str_concat(x, "\"")), from);
            if lt(i, 0) then 0 else if eq(ong-handler-at?(text, x, i), 1) then 1 else ong-handler?(text, x, add(i, 1));
        }
        def ong-handler-at?(text, x, i) {
            let after = lx-skip-ws(text, add(i, add(str_len(x), 2)));
            if and(eq(ong-case-before?(text, i), 1), or(eq(lx-at?(text, after, ":"), 1), eq(lx-at?(text, after, "="), 1))) then 1
            else if eq(lx-at?(text, after, "=>"), 1) then 1
            else ong-verb-before?(text, i);
        }
        def ong-case-before?(text, i) {
            let w = ong-ws-back(text, i);
            if eq(w, i) then 0 else if and(ge(sub(w, 4), 0), str_eq(substring(text, sub(w, 4), w), "case")) then 1 else 0;
        }
        def ong-verb-before?(text, i) {
            let e = ong-ws-back(text, i);
            if lt(sub(e, 3), 0) then 0 else if eq(str_eq(substring(text, sub(e, 3), e), "==="), 0) then 0 else ong-verb-word?(text, ong-ws-back(text, sub(e, 3)));
        }
        def ong-verb-word?(text, e) = if and(ge(sub(e, 4), 0), str_eq(substring(text, sub(e, 4), e), "verb")) then 1 else 0;

        // ---- the analysis: list(drifts) ----
        def ong-missing(root, rel) = list(str_concat("missing input: ", str_concat(root, rel)));
        def ong-analysis(root) {
            let json = read_file(str_concat(root, ong-json()));
            let go = read_file(str_concat(root, ong-go()));
            let rust = read_file(str_concat(root, ong-rust()));
            let ts = read_file(str_concat(root, ong-ts()));
            if nothing?(json) then ong-missing(root, ong-json())
            else if nothing?(go) then ong-missing(root, ong-go())
            else if nothing?(rust) then ong-missing(root, ong-rust())
            else if nothing?(ts) then ong-missing(root, ong-ts())
            else ong-analysis-texts(parse-json(ong-json(), json), ong-dispatch(go, "go"), ong-dispatch(rust, "rust"), ong-dispatch(ts, "ts"), go, rust, ts);
        }
        def ong-analysis-texts(root, go, rust, ts, gotext, rusttext, tstext) {
            if str_eq(nth(go, 0), "refused") then list(nth(go, 1))
            else if str_eq(nth(rust, 0), "refused") then list(nth(rust, 1))
            else if str_eq(nth(ts, 0), "refused") then list(nth(ts, 1))
            else ong-analysis-with(ong-rows(root, "categories"), ong-rows(root, "primitives"), list(list("form-kernel-go", nth(go, 1), gotext), list("form-kernel-rust", nth(rust, 1), rusttext), list("form-kernel-ts", nth(ts, 1), tstext)));
        }
        def ong-analysis-with(cats, prims, kernels) = append(ong-prim-drifts(prims, kernels), append(ong-reverse-drifts(kernels, tb-map(prims, ong-r-name)), ong-cat-drifts(cats, kernels)));

        // ---- the voice ----
        def ong-ok-line() = "form ontology matches kernel parsers (Go/Rust/TS)";
        def ong-judge(root) = lx-verdict(ong-name(), ong-analysis(root), ong-ok-line());
        def ong-run() = ong-judge("");
    }
    ong-run();
}
