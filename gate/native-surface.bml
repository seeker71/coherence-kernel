//////////////////////////////////////////////////////////////////////
//
// gate/native-surface.bml — the fkwu native-surface drift gate as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/validate_fkwu_native_surface.py, read as the spec and
// transliterated check for check. The script stays in place as a
// witness while this lens stands its first landings; the drift-gates
// row (gate/drift-gates.bml, "native-surface") runs this door.
//
// THE INVARIANT. Every flt-ops row (name arity tag) in
// form/form-stdlib/form-flatten.fk lowers onto an fkc-flat arm in
// form/form-stdlib/fkc-table-serialize.fk of ITS OWN arity, inside the
// dispatch counters (fkc-arm-slots), with no two rows sharing a tag at
// different arities:
//   - a tag carried by several rows is an alias when every row agrees
//     on the arity, a conflict otherwise;
//   - the largest tag, and every tag, stays below fkc-arm-slots;
//   - a nullary tag has an explicit `(eq (fk-tag n) TAG)` row in
//     fkc-flat; a unary tag has one, or sits in an or-group whose arm is
//     `(fkc-un2 (fk-tag n) ...)`; a ternary tag has an explicit row or
//     an `(if (eq (fk-tag n) TAG) (fkc-tri2` arm; a binary tag rides
//     the fallback at the end of fkc-flat and needs nothing; a quad tag
//     without an explicit row is a WARNING (fkc-quad4 is checked by
//     hand); any other arity is an error;
//   - a tag at or above 55 (the host-io band) that no `if (t == TAG)`
//     arm in fkc-table-serialize.fk, host-io-fs-fkwu-emit.fk or
//     runtime/fkwu-uni.c carries, and no or-group dispatches, is a
//     WARNING — except 80 and 106 (node_eq/value_eq and _get share
//     arms). Warnings never refuse; they are counted on the OK line.
//
// INPUTS. flt-ops is read through its own accessor (form-flatten.fk,
// the stdlib copy the script reads) — the table as a table, not a regex
// over its text; the script's regex reads only non-negative arities
// and the stdlib copy holds none, so the two readings are the same rows.
// fkc-arm-slots, the fkc-flat block (from `(defn fkc-flat` to
// `(defn fkc-call2`) and the `if (t == N)` arms are read from the texts
// under a root the band can re-point; "" is the live tree. The emitter
// is required (the script exits 2 without it); the other two walker
// texts are read when present and skipped when absent, as the script
// skips them.
//
// ONE TEACHING, NAMED. The script's docstring says the or-groups are
// read (`dynamic_unary_tags`: "tags handled via (fkc-un2 (fk-tag n)
// ...) in or-groups"), but its regular expression cannot match a nested
// `(or ... (or ...))` and answers the empty set on every tree this body
// has had. This lens reads the or-groups as written — the paren block
// after `(if (or`, its arm the next form — so the two groups that
// dispatch to fkc-un2 (120/121/122/126 and the tail group 81..90, 127,
// 130, 147) and the one that dispatches to fkc-bin2 (123/124/125) are
// seen. On today's tree the two readings judge alike: every or-group
// tag is also an explicit row and a walker arm, so neither the arity
// check nor the walker warning turns on the difference. A tree where
// they diverge is a tree where the script was blind and this lens is
// not.
//
// EXIT. No errors: one line `native-surface: OK (<rows> flt-ops rows,
// max_tag=<m>, arm_slots=<s>, aliases=<a>, <w> warning(s))` and the
// answer 1. Otherwise the `warn: ...` rows, the `error: ...` rows in
// the script's order (conflicts by tag, the ceiling, then row by row),
// then `native-surface: FAIL (<e> error(s), <rows> flt-ops rows,
// arm_slots=<s>)` and the answer 0 — the script's own words, its
// module name replaced by this lens's. A required text the tree does
// not have, or an emitter without fkc-arm-slots / fkc-flat, is one
// named error and a refusal, where the script dies in a traceback.
//
// Run directly:  ./fkwu gate/native-surface.bml     ; last line 1 / 0
// Twin:          python3 form/scripts/validate_fkwu_native_surface.py
// Proven by:     gate/tests/native-surface-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/form-parse.fk form-stdlib/form-flatten.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNativeSurfaceGate {
        thought native-surface-pattern = list("every-row-has-its-arm", "alias-or-conflict", "or-groups-are-read", "warnings-count-never-refuse", "twin-voice-byte-for-byte");

        def nsf-name() = "native-surface";
        def nsf-emit() = "form/form-stdlib/fkc-table-serialize.fk";
        def nsf-fs-emit() = "form/form-stdlib/host-io-fs-fkwu-emit.fk";
        def nsf-runtime() = "runtime/fkwu-uni.c";
        def nsf-host-io-floor() = 55;
        def nsf-shared-arms() = list(80, 106);

        // ---- reading the emitter ----
        def nsf-arm-slots(emit) {
            let at = str_find(emit, "(defn fkc-arm-slots ()", 0);
            if lt(at, 0) then sub(0, 1) else nsf-arm-slots-at(emit, lx-skip-ws(emit, add(at, str_len("(defn fkc-arm-slots ()"))));
        }
        def nsf-arm-slots-at(emit, a) {
            let b = lx-digits-end(emit, a);
            if eq(b, a) then sub(0, 1) else if eq(lx-at?(emit, b, ")"), 1) then lx-int-span(emit, a, b) else sub(0, 1);
        }
        // the fkc-flat block: after the first "(defn fkc-flat", before the next "(defn fkc-call2"
        def nsf-flat-block(emit) {
            let a = str_find(emit, "(defn fkc-flat", 0);
            if lt(a, 0) then "" else nsf-flat-block-from(emit, add(a, str_len("(defn fkc-flat")));
        }
        def nsf-flat-block-from(emit, a) {
            let b = str_find(emit, "(defn fkc-call2", a);
            substring(emit, a, if lt(b, 0) then str_len(emit) else b);
        }
        def nsf-explicit(flat) = lx-int-uniq(lx-ints-after(flat, "(eq (fk-tag n) ", ")"));
        def nsf-tri(flat) = lx-int-uniq(lx-ints-after(flat, "(if (eq (fk-tag n) ", ") (fkc-tri2"));
        // or-groups: the paren block after "(if (or", then the arm that follows it
        def nsf-or-tags(flat, arm) = lx-int-uniq(nsf-or-tags-go(flat, arm, 0, list()));
        def nsf-or-tags-go(flat, arm, from, acc) {
            let i = str_find(flat, "(if (or", from);
            if lt(i, 0) then acc else nsf-or-tags-at(flat, arm, add(i, str_len("(if ")), acc);
        }
        def nsf-or-tags-at(flat, arm, s, acc) {
            let e = lx-block-end(flat, s, 0);
            let k = lx-skip-ws(flat, e);
            if eq(lx-at?(flat, k, arm), 1) then nsf-or-tags-go(flat, arm, e, append(acc, lx-ints-after(substring(flat, s, e), "(eq (fk-tag n) ", ")"))) else nsf-or-tags-go(flat, arm, e, acc);
        }
        def nsf-dyn-unary(flat) = nsf-or-tags(flat, "(fkc-un2 (fk-tag n)");
        def nsf-dyn-binary(flat) = nsf-or-tags(flat, "(fkc-bin2 (fk-tag n)");
        def nsf-c-tags(texts) = lx-int-uniq(nsf-c-tags-go(texts, list()));
        def nsf-c-tags-go(texts, acc) = if eq(len(texts), 0) then acc else nsf-c-tags-go(tail(texts), append(acc, lx-ints-after(head(texts), "if (t == ", ")")));
        // Internal walker tags that exist only as a name: `#define FK_TAG_<NAME> <int>`.
        // No optable row and no `if (t == N)` site names them, so every scan above is
        // blind to them -- FK_TAG_CONST_HOLD (190) swallowed a manifest row on 2026-09-05,
        // walking the call as a once-hold and answering its first child.
        def nsf-define-tags(texts) = lx-int-uniq(nsf-define-tags-go(texts, list()));
        def nsf-define-tags-go(texts, acc) = if eq(len(texts), 0) then acc else nsf-define-tags-go(tail(texts), append(acc, nsf-define-tags-in(head(texts), 0, list())));
        def nsf-define-tags-in(text, from, acc) {
            let i = str_find(text, "#define FK_TAG_", from);
            if lt(i, 0) then reverse(acc) else nsf-define-tags-at(text, add(i, str_len("#define FK_TAG_")), acc);
        }
        def nsf-define-tags-at(text, nameStart, acc) {
            let sp = str_find(text, " ", nameStart);
            let a = add(sp, 1);
            let b = if lt(sp, 0) then a else lx-digits-end(text, a);
            if or(lt(sp, 0), eq(b, a)) then nsf-define-tags-in(text, nameStart, acc) else nsf-define-tags-in(text, b, cons(lx-int-span(text, a, b), acc));
        }

        // ---- a reading: list("ok", slots, explicit, dyn-unary, dyn-binary, tri, c-tags) or list("refused", message) ----
        def nsf-read(root) {
            let emit = read_file(str_concat(root, nsf-emit()));
            if nothing?(emit) then list("refused", str_concat("missing input: ", str_concat(root, nsf-emit()))) else nsf-read-emit(root, emit);
        }
        def nsf-read-emit(root, emit) {
            let slots = nsf-arm-slots(emit);
            let flat = nsf-flat-block(emit);
            if lt(slots, 0) then list("refused", "fkc-arm-slots not found")
            else if eq(str_len(flat), 0) then list("refused", "fkc-flat not found")
            else nsf-read-texts(slots, flat, list(emit, lx-host-text(read_file(str_concat(root, nsf-fs-emit()))), lx-host-text(read_file(str_concat(root, nsf-runtime())))));
        }
        def nsf-read-texts(slots, flat, texts) {
            list("ok", slots, nsf-explicit(flat), nsf-dyn-unary(flat), nsf-dyn-binary(flat), nsf-tri(flat), nsf-c-tags(texts), nsf-define-tags(texts));
        }
        def nsf-r-slots(r) = nth(r, 1);
        def nsf-r-explicit(r) = nth(r, 2);
        def nsf-r-dyn-unary(r) = nth(r, 3);
        def nsf-r-dyn-binary(r) = nth(r, 4);
        def nsf-r-define-tags(r) = if ge(len(r), 8) then nth(r, 7) else list();
        def nsf-r-tri(r) = nth(r, 5);
        def nsf-r-c-tags(r) = nth(r, 6);

        // ---- rows ----
        def nsf-op-name(op) = nth(op, 0);
        def nsf-op-arity(op) = nth(op, 1);
        def nsf-op-tag(op) = nth(op, 2);
        def nsf-tags(ops) = tb-map(ops, nsf-op-tag);
        def nsf-max-tag(ops) = lx-int-max(nsf-tags(ops), 0);
        def nsf-with-tag?(op, tag) = if eq(nsf-op-tag(op), tag) then 1 else 0;
        def nsf-rows-with-tag(ops, tag) = tb-filter2(ops, nsf-with-tag?, tag);

        // ---- conflicts and aliases: tags carried by several rows, ascending ----
        def nsf-shared-tags(ops) = tb-filter2(lx-int-sort(lx-int-uniq(nsf-tags(ops))), nsf-tag-shared?, ops);
        def nsf-tag-shared?(tag, ops) = if gt(len(nsf-rows-with-tag(ops, tag)), 1) then 1 else 0;
        // answers list(errors, aliases)
        def nsf-conflicts(ops) = nsf-conflicts-go(nsf-shared-tags(ops), ops, list(), 0);
        def nsf-conflicts-go(tags, ops, errors, aliases) {
            if eq(len(tags), 0) then list(errors, aliases) else nsf-conflicts-one(head(tags), tail(tags), ops, errors, aliases);
        }
        def nsf-conflicts-one(tag, rest, ops, errors, aliases) {
            let rows = nsf-rows-with-tag(ops, tag);
            let arities = lx-int-uniq(tb-map(rows, nsf-op-arity));
            if gt(len(arities), 1)
            then nsf-conflicts-go(rest, ops, append(errors, list(str_concat("conflicting flt-ops tag ", str_concat(int_to_str(tag), str_concat(" (mixed arity ", str_concat(lx-py-int-list(lx-int-sort(arities)), str_concat("): ", lx-py-str-list(tb-map(rows, nsf-op-name))))))))), aliases)
            else nsf-conflicts-go(rest, ops, errors, add(aliases, 1));
        }

        // ---- one row's errors and warnings ----
        def nsf-voice(op, rest) = str_concat(nsf-op-name(op), str_concat(": ", rest));
        def nsf-tag-voice(op, kind, rest) = nsf-voice(op, str_concat(kind, str_concat(" tag ", str_concat(int_to_str(nsf-op-tag(op)), rest))));
        def nsf-when(cond, msg) = if cond then list(msg) else list();
        def nsf-op-errors(op, r) {
            let tag = nsf-op-tag(op);
            let arity = nsf-op-arity(op);
            let explicit = lx-int-in?(nsf-r-explicit(r), tag);
            append(nsf-when(ge(tag, nsf-r-slots(r)), nsf-voice(op, str_concat("tag ", str_concat(int_to_str(tag), str_concat(" out of arm slots range 0..", int_to_str(sub(nsf-r-slots(r), 1))))))),
                   append(nsf-when(lx-int-in?(nsf-r-define-tags(r), tag), nsf-voice(op, str_concat("tag ", str_concat(int_to_str(tag), " is an internal walker tag (#define FK_TAG_*): a call here is walked as that form and answers its first child, never this op")))),
                          nsf-arity-errors(op, r, arity, tag, explicit)));
        }
        def nsf-arity-errors(op, r, arity, tag, explicit) {
            if eq(arity, 0) then nsf-when(eq(explicit, 0), nsf-tag-voice(op, "nullary", " missing explicit fkc-flat row"))
            else if eq(arity, 1) then nsf-when(and(eq(explicit, 0), eq(lx-int-in?(nsf-r-dyn-unary(r), tag), 0)), nsf-tag-voice(op, "unary", " not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)"))
            else if eq(arity, 2) then list()
            else if eq(arity, 3) then nsf-when(and(eq(lx-int-in?(nsf-r-tri(r), tag), 0), eq(explicit, 0)), nsf-tag-voice(op, "ternary", " missing fkc-tri2 / explicit fkc-flat"))
            else if eq(arity, 4) then list()
            else list(nsf-voice(op, str_concat("unsupported arity ", int_to_str(arity))));
        }
        def nsf-op-warnings(op, r) {
            let tag = nsf-op-tag(op);
            append(nsf-when(and(eq(nsf-op-arity(op), 4), eq(lx-int-in?(nsf-r-explicit(r), tag), 0)), nsf-tag-voice(op, "quad", " — verify fkc-quad4 coverage manually")),
                   nsf-when(nsf-walker-blind?(tag, r), nsf-voice(op, str_concat("tag ", str_concat(int_to_str(tag), " not found in C walker if (t == N) strings")))));
        }
        def nsf-walker-blind?(tag, r) = and(ge(tag, nsf-host-io-floor()), and(eq(lx-int-in?(nsf-r-c-tags(r), tag), 0), and(eq(lx-int-in?(nsf-r-dyn-unary(r), tag), 0), and(eq(lx-int-in?(nsf-r-dyn-binary(r), tag), 0), eq(lx-int-in?(nsf-shared-arms(), tag), 0)))));
        def nsf-rows-errors(ops, r) = if eq(len(ops), 0) then list() else append(nsf-op-errors(head(ops), r), nsf-rows-errors(tail(ops), r));
        def nsf-rows-warnings(ops, r) = if eq(len(ops), 0) then list() else append(nsf-op-warnings(head(ops), r), nsf-rows-warnings(tail(ops), r));

        // ---- the analysis: list(warnings, errors, aliases, max-tag, slots) ----
        def nsf-analysis(ops, root) {
            let r = nsf-read(root);
            if str_eq(nth(r, 0), "refused") then list(list(), list(nth(r, 1)), 0, 0, 0) else nsf-analysis-with(ops, r);
        }
        def nsf-analysis-with(ops, r) {
            let conflicts = nsf-conflicts(ops);
            let maxtag = nsf-max-tag(ops);
            list(nsf-rows-warnings(ops, r),
                 append(nth(conflicts, 0), append(nsf-when(ge(maxtag, nsf-r-slots(r)), str_concat("max flt-ops tag ", str_concat(int_to_str(maxtag), str_concat(" >= fkc-arm-slots ", int_to_str(nsf-r-slots(r)))))), nsf-rows-errors(ops, r))),
                 nth(conflicts, 1), maxtag, nsf-r-slots(r));
        }
        def nsf-a-warnings(a) = nth(a, 0);
        def nsf-a-errors(a) = nth(a, 1);
        def nsf-a-aliases(a) = nth(a, 2);
        def nsf-a-max(a) = nth(a, 3);
        def nsf-a-slots(a) = nth(a, 4);

        // ---- the voice ----
        def nsf-ok-line(ops, a) = str_concat("(", str_concat(int_to_str(len(ops)), str_concat(" flt-ops rows, max_tag=", str_concat(int_to_str(nsf-a-max(a)), str_concat(", arm_slots=", str_concat(int_to_str(nsf-a-slots(a)), str_concat(", aliases=", str_concat(int_to_str(nsf-a-aliases(a)), str_concat(", ", str_concat(int_to_str(len(nsf-a-warnings(a))), " warning(s))"))))))))));
        def nsf-fail-line(ops, a) = str_concat("(", str_concat(int_to_str(len(nsf-a-errors(a))), str_concat(" error(s), ", str_concat(int_to_str(len(ops)), str_concat(" flt-ops rows, arm_slots=", str_concat(int_to_str(nsf-a-slots(a)), ")"))))));
        def nsf-judge(ops, root) {
            let a = nsf-analysis(ops, root);
            lx-verdict-full(nsf-name(), nsf-a-warnings(a), nsf-a-errors(a), nsf-ok-line(ops, a), nsf-fail-line(ops, a));
        }
        def nsf-run() = nsf-judge(flt-ops(), "");
    }
    nsf-run();
}
