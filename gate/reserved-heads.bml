// Reserved call heads. fkwu answers some names itself in call position: its op
// rows, its rewrite rows and the four control forms. A local binding of such a
// spelling is reachable in value position only; any other head reads the nearest
// local binding first. The Form copy of every row's argument count,
// form-stdlib/fkwu-op-arity.fk, is generated here from runtime/fkwu-optable.h.
// With empty stdin this compares that copy (1 when it stands); the stdin line
// `write` rewrites it first.
import form-stdlib/core.fk;
import form-stdlib/table.bml;
import form-stdlib/bml-source.fk;
import form-stdlib/bml/string-join.bml;
import gate/lens-text.bml;
section [form.bml] {
    class FormReservedHeadsGate {
        def rhg-name() = "reserved-heads";
        def rhg-optable() = "runtime/fkwu-optable.h";

        // ---- bytes the text needs, spelled by code so no literal carries structure ----
        def rhg-ch(b) = byte_to_str(b);
        def rhg-q() = rhg-ch(34);
        def rhg-cat(parts) = str-join(parts);

        // ---- the names: every row name in the header, once each, sorted ----
        def rhg-names(text) = lx-str-sort(lx-str-uniq(bml-source-reserved-heads(text)));

        def rhg-origin() = "gate/reserved-heads.bml from runtime/fkwu-optable.h";
        def rhg-writing?(mode) = if nothing?(mode) then 0 else if ((String) mode == "write") then 1 else 0;

        // ---- the Form copy: every row's argument count, the arity the reader demands in call position ----
        def rhg-arity-path() = "form/form-stdlib/fkwu-op-arity.fk";
        def rhg-row-open() = rhg-cat(["  { ", rhg-q()]);
        def rhg-arity-rows(text, from) {
            let at = str_find(text, rhg-row-open(), from);
            if (at < 0) then [] else rhg-arity-row(text, (at + len(rhg-row-open())));
        }
        def rhg-arity-row(text, nameAt) {
            let nameEnd = str_find(text, rhg-q(), nameAt);
            let arityEnd = str_find(text, ",", (nameEnd + 3));
            cons([substring(text, nameAt, nameEnd), str_to_int(trim(substring(text, (nameEnd + 2), arityEnd)))], rhg-arity-rows(text, arityEnd));
        }
        def rhg-arity-entries(rows) = str-join-with(map(row => rhg-cat(["[", rhg-q(), row[0], rhg-q(), ", ", row[1].str(), "]"]), rows), ", ");
        def rhg-arity-text(text) = rhg-cat([
            "// fkwu-op-arity.fk: generated by ", rhg-origin(), "; do not edit.\n",
            "// Every op and rewrite row fkwu answers in call position, with the argument count its reader demands:\n",
            "// a call with another count does not compile. The coding lane's arity tool reads a candidate against it.\n",
            "section [form.bml] {\n    def fkwu-op-arities() = [", rhg-arity-entries(rhg-arity-rows(text,0)), "];\n",
            "    // the arity of one call head, or nothing when fkwu does not answer it itself\n",
            "    def fkwu-op-arity-in(rows, name) = nil?(rows) ? fail : rows[0][0] == name ? rows[0][1] : fkwu-op-arity-in(rows[1:], name);\n",
            "    def fkwu-op-arity(name) = fkwu-op-arity-in(fkwu-op-arities(), name);\n}\n"]);
        def rhg-arity-stale(text, rest) {
            let have = read_file(rhg-arity-path());
            if nothing?(have) then cons(("missing: " + rhg-arity-path()), rest) else if ((String) have == rhg-arity-text(text)) then rest else cons(("stale: " + rhg-arity-path()), rest);
        }
        def rhg-act(mode, names, text) {
            let wrote = if ((Comparable) rhg-writing?(mode) == 1) then write_file(rhg-arity-path(), rhg-arity-text(text)) else 0;
            lx-verdict(rhg-name(), rhg-arity-stale(text, []), (len(names).str() + " reserved heads stand, with their arities in Form"));
        }
        def rhg-run() {
            let text = read_file(rhg-optable());
            let mode = read_line();
            if nothing?(text) then lx-verdict(rhg-name(), [("missing input: " + rhg-optable())], "") else rhg-act(mode, rhg-names(text), text);
        }
    }
    rhg-run();
}
