// Reserved call heads, one list for every proof arm. fkwu answers some names
// itself in call position: its op rows, its rewrite rows and the four control
// forms. A local binding of such a spelling is reachable in value position
// only; any other head reads the nearest local binding first. The siblings and
// walkers read the same list, generated here from runtime/fkwu-optable.h.
// With empty stdin this compares the six copies (1 when all stand); the stdin
// line `write` rewrites them first.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml
section [form.bml] {
    class FormReservedHeadsGate {
        def rhg-name() = "reserved-heads";
        def rhg-optable() = "runtime/fkwu-optable.h";
        def rhg-control() = list("defn", "do", "let", "if");

        // ---- bytes the text needs, spelled by code so no literal carries structure ----
        def rhg-ch(b) = byte_to_str(b);
        def rhg-q() = rhg-ch(34);
        def rhg-nl() = rhg-ch(10);
        def rhg-tab() = rhg-ch(9);
        def rhg-lp() = rhg-ch(40);
        def rhg-rp() = rhg-ch(41);
        def rhg-lb() = rhg-ch(123);
        def rhg-rb() = rhg-ch(125);
        def rhg-ls() = rhg-ch(91);
        def rhg-rs() = rhg-ch(93);
        def rhg-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), rhg-cat(tail(parts)));

        // ---- the names: every row name in the header, once each, sorted ----
        def rhg-rows(text, i, acc) {
            let a = str_find(text, str_concat(rhg-lb(), str_concat(" ", rhg-q())), i);
            if lt(a, 0) then acc else rhg-row-at(text, add(a, 3), acc);
        }
        def rhg-row-at(text, s, acc) {
            let e = str_find(text, rhg-q(), s);
            if lt(e, 0) then acc else rhg-rows(text, add(e, 1), cons(substring(text, s, e), acc));
        }
        def rhg-names(text) = lx-str-sort(lx-str-uniq(append(rhg-control(), rhg-rows(text, 0, list()))));

        // ---- one text per language ----
        def rhg-entries(names, indent) = if eq(len(names), 0) then "" else rhg-cat(list(indent, rhg-q(), head(names), rhg-q(), ",", rhg-nl(), rhg-entries(tail(names), indent)));
        def rhg-doc(marker) = rhg-cat(list(marker, "The names fkwu answers itself in call position: its op rows, its rewrite", rhg-nl(), marker, "rows and the four control forms. Such a head reaches the primitive even", rhg-nl(), marker, "under a local binding of its spelling; any other head reads the nearest", rhg-nl(), marker, "local binding first.", rhg-nl()));
        def rhg-origin() = "gate/reserved-heads.bml from runtime/fkwu-optable.h";
        def rhg-go(names) = rhg-cat(list("// Code generated by ", rhg-origin(), ". DO NOT EDIT.", rhg-nl(), rhg-nl(), "package main", rhg-nl(), rhg-nl(), rhg-doc("// "), "var fkwuReservedHeads = fkwuReservedHeadSet", rhg-lp(), rhg-ls(), rhg-rs(), "string", rhg-lb(), rhg-nl(), rhg-entries(names, rhg-tab()), rhg-rb(), rhg-rp(), rhg-nl(), rhg-nl(), "func fkwuReservedHeadSet", rhg-lp(), "names ", rhg-ls(), rhg-rs(), "string", rhg-rp(), " map", rhg-ls(), "string", rhg-rs(), "bool ", rhg-lb(), rhg-nl(), rhg-tab(), "set := make", rhg-lp(), "map", rhg-ls(), "string", rhg-rs(), "bool, len", rhg-lp(), "names", rhg-rp(), rhg-rp(), rhg-nl(), rhg-tab(), "for _, n := range names ", rhg-lb(), rhg-nl(), rhg-tab(), rhg-tab(), "set", rhg-ls(), "n", rhg-rs(), " = true", rhg-nl(), rhg-tab(), rhg-rb(), rhg-nl(), rhg-tab(), "return set", rhg-nl(), rhg-rb(), rhg-nl()));
        def rhg-rust(names) = rhg-cat(list("// Generated by ", rhg-origin(), "; do not edit.", rhg-nl(), "//", rhg-nl(), rhg-doc("// "), rhg-nl(), "pub", rhg-lp(), "crate", rhg-rp(), " const FKWU_RESERVED_HEADS: &", rhg-ls(), "&str", rhg-rs(), " = &", rhg-ls(), rhg-nl(), rhg-entries(names, "    "), rhg-rs(), ";", rhg-nl(), rhg-nl(), "pub", rhg-lp(), "crate", rhg-rp(), " fn fkwu_reserved", rhg-lp(), "name: &str", rhg-rp(), " -> bool ", rhg-lb(), rhg-nl(), "    FKWU_RESERVED_HEADS.contains", rhg-lp(), "&name", rhg-rp(), rhg-nl(), rhg-rb(), rhg-nl()));
        def rhg-ts(names) = rhg-cat(list("// Generated by ", rhg-origin(), "; do not edit.", rhg-nl(), "//", rhg-nl(), rhg-doc("// "), rhg-nl(), "export const FKWU_RESERVED_HEADS: ReadonlySet<string> = new Set", rhg-lp(), rhg-ls(), rhg-nl(), rhg-entries(names, "  "), rhg-rs(), rhg-rp(), ";", rhg-nl()));
        def rhg-text(kind, names) = if str_eq(kind, "go") then rhg-go(names) else if str_eq(kind, "rust") then rhg-rust(names) else rhg-ts(names);

        // ---- the six copies ----
        def rhg-targets() = list(list("form/form-kernel-go/reserved_heads.go", "go"), list("walkers/go/reserved_heads.go", "go"), list("form/form-kernel-rust/src/reserved_heads.rs", "rust"), list("walkers/rust/src/reserved_heads.rs", "rust"), list("form/form-kernel-ts/src/reserved-heads.ts", "ts"), list("walkers/ts/reserved-heads.ts", "ts"));
        def rhg-stale(targets, names) = if eq(len(targets), 0) then list() else rhg-stale-one(head(targets), names, rhg-stale(tail(targets), names));
        def rhg-stale-one(target, names, rest) {
            let have = read_file(nth(target, 0));
            if nothing?(have) then cons(str_concat("missing: ", nth(target, 0)), rest) else if str_eq(have, rhg-text(nth(target, 1), names)) then rest else cons(str_concat("stale: ", nth(target, 0)), rest);
        }
        def rhg-write(targets, names) = if eq(len(targets), 0) then 0 else rhg-write-one(head(targets), names, tail(targets));
        def rhg-write-one(target, names, rest) {
            let written = write_file(nth(target, 0), rhg-text(nth(target, 1), names));
            print(str_concat("wrote ", nth(target, 0)));
            rhg-write(rest, names);
        }
        def rhg-writing?(mode) = if nothing?(mode) then 0 else if str_eq(mode, "write") then 1 else 0;
        def rhg-act(mode, names) {
            let wrote = if eq(rhg-writing?(mode), 1) then rhg-write(rhg-targets(), names) else 0;
            lx-verdict(rhg-name(), rhg-stale(rhg-targets(), names), str_concat(int_to_str(len(names)), " reserved heads stand in every arm"));
        }
        def rhg-run() {
            let text = read_file(rhg-optable());
            let mode = read_line();
            if nothing?(text) then lx-verdict(rhg-name(), list(str_concat("missing input: ", rhg-optable())), "") else rhg-act(mode, rhg-names(text));
        }
    }
    rhg-run();
}
