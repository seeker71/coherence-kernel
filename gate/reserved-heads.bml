// Reserved call heads, one list for every proof arm. fkwu answers some names
// itself in call position: its op rows, its rewrite rows and the four control
// forms. A local binding of such a spelling is reachable in value position
// only; any other head reads the nearest local binding first. The siblings and
// walkers read the same list, generated here from runtime/fkwu-optable.h.
// With empty stdin this compares the six copies (1 when all stand); the stdin
// line `write` rewrites them first.
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/bml-source.fk gate/lens-text.bml
section [form.bml] {
    class FormReservedHeadsGate {
        def rhg-name() = "reserved-heads";
        def rhg-optable() = "runtime/fkwu-optable.h";

        // ---- bytes the text needs, spelled by code so no literal carries structure ----
        def rhg-ch(b) = byte_to_str(b);
        def rhg-q() = rhg-ch(34);
        def rhg-nl() = rhg-ch(10);
        def rhg-tab() = rhg-ch(9);
        def rhg-lp() = rhg-ch(40);
        def rhg-rp() = rhg-ch(41);
        def rhg-lb() = rhg-ch(123);
        def rhg-rb() = rhg-ch(125);
        def rhg-ls() = rhg-ch(91);
        def rhg-rs() = rhg-ch(93);
        def rhg-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ rhg-cat(tail(parts));

        // ---- the names: every row name in the header, once each, sorted ----
        def rhg-names(text) = lx-str-sort(lx-str-uniq(bml-source-reserved-heads(text)));

        // ---- one text per language ----
        def rhg-entries(names, indent) = (Comparable) len(names) == 0 ? "" : rhg-cat(list(indent, rhg-q(), head(names), rhg-q(), ",", rhg-nl(), rhg-entries(tail(names), indent)));
        def rhg-doc(marker) = rhg-cat(list(marker, "The names fkwu answers itself in call position: its op rows, its rewrite", rhg-nl(), marker, "rows and the four control forms. Such a head reaches the primitive even", rhg-nl(), marker, "under a local binding of its spelling; any other head reads the nearest", rhg-nl(), marker, "local binding first.", rhg-nl()));
        def rhg-origin() = "gate/reserved-heads.bml from runtime/fkwu-optable.h";
        def rhg-go(names) = rhg-cat(list("// Code generated by ", rhg-origin(), ". DO NOT EDIT.", rhg-nl(), rhg-nl(), "package main", rhg-nl(), rhg-nl(), rhg-doc("// "), "var fkwuReservedHeads = fkwuReservedHeadSet", rhg-lp(), rhg-ls(), rhg-rs(), "string", rhg-lb(), rhg-nl(), rhg-entries(names, rhg-tab()), rhg-rb(), rhg-rp(), rhg-nl(), rhg-nl(), "func fkwuReservedHeadSet", rhg-lp(), "names ", rhg-ls(), rhg-rs(), "string", rhg-rp(), " map", rhg-ls(), "string", rhg-rs(), "bool ", rhg-lb(), rhg-nl(), rhg-tab(), "set := make", rhg-lp(), "map", rhg-ls(), "string", rhg-rs(), "bool, len", rhg-lp(), "names", rhg-rp(), rhg-rp(), rhg-nl(), rhg-tab(), "for _, n := range names ", rhg-lb(), rhg-nl(), rhg-tab(), rhg-tab(), "set", rhg-ls(), "n", rhg-rs(), " = true", rhg-nl(), rhg-tab(), rhg-rb(), rhg-nl(), rhg-tab(), "return set", rhg-nl(), rhg-rb(), rhg-nl()));
        def rhg-rust(names) = rhg-cat(list("// Generated by ", rhg-origin(), "; do not edit.", rhg-nl(), "//", rhg-nl(), rhg-doc("// "), rhg-nl(), "pub", rhg-lp(), "crate", rhg-rp(), " const FKWU_RESERVED_HEADS: &", rhg-ls(), "&str", rhg-rs(), " = &", rhg-ls(), rhg-nl(), rhg-entries(names, "    "), rhg-rs(), ";", rhg-nl(), rhg-nl(), "pub", rhg-lp(), "crate", rhg-rp(), " fn fkwu_reserved", rhg-lp(), "name: &str", rhg-rp(), " -> bool ", rhg-lb(), rhg-nl(), "    FKWU_RESERVED_HEADS.contains", rhg-lp(), "&name", rhg-rp(), rhg-nl(), rhg-rb(), rhg-nl()));
        def rhg-ts(names) = rhg-cat(list("// Generated by ", rhg-origin(), "; do not edit.", rhg-nl(), "//", rhg-nl(), rhg-doc("// "), rhg-nl(), "export const FKWU_RESERVED_HEADS: ReadonlySet<string> = new Set", rhg-lp(), rhg-ls(), rhg-nl(), rhg-entries(names, "  "), rhg-rs(), rhg-rp(), ";", rhg-nl()));
        def rhg-text(kind, names) = (String) kind == "go" ? rhg-go(names) : (String) kind == "rust" ? rhg-rust(names) : rhg-ts(names);

        // ---- the six copies ----
        def rhg-targets() = list(list("form/form-kernel-go/reserved_heads.go", "go"), list("walkers/go/reserved_heads.go", "go"), list("form/form-kernel-rust/src/reserved_heads.rs", "rust"), list("walkers/rust/src/reserved_heads.rs", "rust"), list("form/form-kernel-ts/src/reserved-heads.ts", "ts"), list("walkers/ts/reserved-heads.ts", "ts"));
        def rhg-stale(targets, names) = (Comparable) len(targets) == 0 ? list() : rhg-stale-one(head(targets), names, rhg-stale(tail(targets), names));
        def rhg-stale-one(target, names, rest) {
            let have = read_file(target[0]);
            nothing?(have) ? cons("missing: " ++ target[0], rest) : (String) have == rhg-text(target[1], names) ? rest : cons("stale: " ++ target[0], rest);
        }
        def rhg-write(targets, names) = (Comparable) len(targets) == 0 ? 0 : rhg-write-one(head(targets), names, tail(targets));
        def rhg-write-one(target, names, rest) {
            let written = write_file(target[0], rhg-text(target[1], names));
            print("wrote " ++ target[0]);
            rhg-write(rest, names);
        }
        def rhg-writing?(mode) = nothing?(mode) ? 0 : (String) mode == "write" ? 1 : 0;

        // ---- the Form copy: every row's argument count, the arity the reader demands in call position ----
        def rhg-arity-path() = "form/form-stdlib/fkwu-op-arity.fk";
        def rhg-row-open() = rhg-cat(list("  { ", rhg-q()));
        def rhg-arity-rows(text, from) {
            let at = str_find(text, rhg-row-open(), from);
            at < 0 ? list() : rhg-arity-row(text, at + str_len(rhg-row-open()));
        }
        def rhg-arity-row(text, nameAt) {
            let nameEnd = str_find(text, rhg-q(), nameAt);
            let arityEnd = str_find(text, ",", nameEnd + 3);
            cons(list(substring(text, nameAt, nameEnd), str_to_int(trim(substring(text, nameEnd + 2, arityEnd)))), rhg-arity-rows(text, arityEnd));
        }
        def rhg-arity-entries(rows) = (Comparable) len(rows) == 0 ? "" : rhg-cat(list("        ", rhg-lp(), "list ", rhg-q(), head(head(rows)), rhg-q(), " ", int_to_str(head(rows)[1]), rhg-rp(), rhg-nl(), rhg-arity-entries(tail(rows))));
        def rhg-arity-text(text) = rhg-cat(list("; fkwu-op-arity.fk: generated by ", rhg-origin(), "; do not edit.", rhg-nl(),
            "; Every op and rewrite row fkwu answers in call position, with the argument count its reader demands:", rhg-nl(),
            "; a call with another count does not compile. The coding lane's arity tool reads a candidate against it.", rhg-nl(),
            rhg-lp(), "defn fkwu-op-arities ", rhg-lp(), rhg-rp(), rhg-nl(), "    ", rhg-lp(), "list", rhg-nl(), rhg-arity-entries(rhg-arity-rows(text, 0)), "    ", rhg-rp(), rhg-rp(), rhg-nl(),
            "; the arity of one call head, or nothing when fkwu does not answer it itself", rhg-nl(),
            rhg-lp(), "defn fkwu-op-arity-in ", rhg-lp(), "rows name", rhg-rp(), rhg-nl(),
            "    ", rhg-lp(), "if ", rhg-lp(), "nil? rows", rhg-rp(), " ", rhg-lp(), "nothing", rhg-rp(), rhg-nl(),
            "        ", rhg-lp(), "if ", rhg-lp(), "str_eq ", rhg-lp(), "head ", rhg-lp(), "head rows", rhg-rp(), rhg-rp(), " name", rhg-rp(), " ", rhg-lp(), "nth ", rhg-lp(), "head rows", rhg-rp(), " 1", rhg-rp(), rhg-nl(),
            "            ", rhg-lp(), "fkwu-op-arity-in ", rhg-lp(), "tail rows", rhg-rp(), " name", rhg-rp(), rhg-rp(), rhg-rp(), rhg-rp(), rhg-nl(),
            rhg-lp(), "defn fkwu-op-arity ", rhg-lp(), "name", rhg-rp(), " ", rhg-lp(), "fkwu-op-arity-in ", rhg-lp(), "fkwu-op-arities", rhg-rp(), " name", rhg-rp(), rhg-rp(), rhg-nl()));
        def rhg-arity-stale(text, rest) {
            let have = read_file(rhg-arity-path());
            nothing?(have) ? cons("missing: " ++ rhg-arity-path(), rest) : (String) have == rhg-arity-text(text) ? rest : cons("stale: " ++ rhg-arity-path(), rest);
        }
        def rhg-act(mode, names, text) {
            let wrote = (Comparable) rhg-writing?(mode) == 1 ? rhg-write(rhg-targets(), names) : 0;
            let wroteArity = (Comparable) rhg-writing?(mode) == 1 ? write_file(rhg-arity-path(), rhg-arity-text(text)) : 0;
            lx-verdict(rhg-name(), rhg-arity-stale(text, rhg-stale(rhg-targets(), names)), int_to_str(len(names)) ++ " reserved heads stand in every arm, with their arities in Form");
        }
        def rhg-run() {
            let text = read_file(rhg-optable());
            let mode = read_line();
            nothing?(text) ? lx-verdict(rhg-name(), list("missing input: " ++ rhg-optable()), "") : rhg-act(mode, rhg-names(text), text);
        }
    }
    rhg-run();
}
