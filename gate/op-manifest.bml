// Native Form lens for manifest, table and carrier agreement.
// Two tables, one meaning per name: the manifest is form-cli's op table (its flt-ops
// in form-stdlib/form-flatten.fk is generated from it), and flatten/form-flatten.fk
// is the table fkwu runs (runtime/fkwu-optable.h is generated from it). The lens
// holds the generated header to its source, every name both tables carry to one
// arity and one tag, and every manifest row to a name fkwu answers, form-cli's own
// byte carriers excepted by name; it says which tags those carriers share.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk
import form-stdlib/source-compiler.fk;
section [form.bml] {
    class FormOpManifestGate {
        thought op-manifest-pattern = ["manifest-first", "tables-through-their-accessors", "three-mirrors-one-assertion", "carriers-are-fkc-arms-siblings-reach-the-form-home", "variadic-is-seen", "twin-voice-byte-for-byte"];

        def oms-name() = "op-manifest";

        // ---- the texts, under a root ("" = the live tree) ----
        def oms-emitter() = "form/form-stdlib/fkc-table-serialize.fk";
        def oms-flatten-dir() = "flatten/form-flatten.fk";
        def oms-optable() = "runtime/fkwu-optable.h";
        def oms-runtime() = "runtime/fkwu-uni.c";
        def oms-text-paths() = [oms-emitter(), oms-flatten-dir(), oms-optable(), oms-runtime()];

        // ---- the data the script carries as constants: rows ----
        def oms-carrier-rows() = [["string_bytes", 1, 205], ["string_byte_fold", 3, 206], ["form_table_text", 2, 207]];
        def oms-obsolete() = ["string_fold"];
        def oms-variadic(name, tag) = [name, tag];
        def oms-variadic-rows() = [oms-variadic("list", 19), oms-variadic("print", 239), oms-variadic("record_new", 64), oms-variadic("method_invoke", 199)];

        // ---- reading the texts: a list parallel to oms-text-paths, or the first missing path ----
        def oms-read-all(root, paths, acc) {
            (Comparable) len(paths) == 0 ? ["ok", reverse(acc)]
            : oms-read-one(root, paths[0], paths[1:], acc, read_file(root ++ paths[0]));
        }
        def oms-read-one(root, path, rest, acc, text) = nothing?(text) ? ["missing",root + path] :
            oms-read-all(root,rest,cons(path == oms-flatten-dir() ? form-source-compile-text(text,root + path) : text,acc));
        def oms-t-emitter(texts) = texts[0];
        def oms-t-flatten-dir(texts) = texts[1];
        def oms-t-optable(texts) = texts[2];
        def oms-t-runtime(texts) = texts[3];

        // ---- the checks, each answering a list of error strings in the script's order ----
        def oms-diff-error(rows, voice) = (Comparable) len(rows) == 0 ? [] : [voice ++ " (" ++ len(rows).str() ++ "): " ++ lx-py-head5(rows, lx-py-triple)];
        def oms-table-errors(flt, nom) = append(oms-diff-error(lx-triple-diff(flt, nom), "in flt-ops but not manifest"), oms-diff-error(lx-triple-diff(nom, flt), "in manifest but not flt-ops"));

        def oms-carrier-errors(rows, flt, nom, texts) = (Comparable) len(rows) == 0 ? [] : append(oms-carrier-one(rows[0], flt, nom, texts), oms-carrier-errors(rows[1:], flt, nom, texts));
        def oms-carrier-one(r, flt, nom, texts) = append(
            oms-when(!((Comparable) lx-triple-in?(nom, r) == 1), "byte carrier manifest mismatch: expected " ++ lx-py-triple(r)),
            append(oms-when(!((Comparable) lx-triple-in?(flt, r) == 1), "byte carrier lowering mismatch: expected " ++ lx-py-triple(r)),
                   oms-when(!((Comparable) lx-has?(oms-t-emitter(texts), oms-arm-needle(r[2])) == 1), "byte carrier emitted arm missing: " ++ r[0] ++ " tag " ++ r[2].str())));
        def oms-arm-needle(tag) = "if (t == " ++ tag.str() ++ ")";

        def oms-obsolete-errors(names, flt, nom) = (Comparable) len(names) == 0 ? [] : append(
            oms-when(((Comparable) lx-triple-name-in?(nom, names[0]) == 1) || ((Comparable) lx-triple-name-in?(flt, names[0]) == 1), "obsolete byte carrier still lowerable: " ++ names[0]),
            oms-obsolete-errors(names[1:], flt, nom));

        def oms-variadic-errors(rows, texts) = (Comparable) len(rows) == 0 ? [] : append(oms-variadic-one(rows[0], texts), oms-variadic-errors(rows[1:], texts));
        def oms-variadic-one(v, texts) {
            let name = v[0];
            let tag = v[1].str();
            append(oms-when(!((Comparable) lx-has?(oms-t-flatten-dir(texts), "(list \"" ++ name ++ "\" -1 " ++ tag ++ ")") == 1), "variadic op missing from flatten/ flt-ops: " ++ name ++ " -1 " ++ tag),
            append(oms-when(!((Comparable) lx-has?(oms-t-optable(texts), "{ \"" ++ name ++ "\", -1, " ++ tag ++ " }") == 1), "variadic op missing from generated optable: " ++ name ++ " -1 " ++ tag ++ " (regen via flatten/gen-source-walker-table.fk)"),
                   oms-when(!((Comparable) lx-has?(oms-t-runtime(texts), "t == " ++ tag ++ ")") == 1), "variadic op walker arm missing: " ++ name ++ " tag " ++ tag)));
        }
        def oms-negative-errors(nom) = oms-when((Comparable) lx-triple-any-negative?(nom) == 1, "variadic (arity<0) row in the manifest: stdlib flt-op2 folds unknown arity as a quad -- variadic ops belong in VARIADIC_OPS + flatten/ flt-ops only");

        def oms-when(cond, msg) = cond ? [msg] : [];

        // ---- the table fkwu runs: flatten/'s compiled rows, (list "name" arity tag) ----
        def oms-flatten-rows(text) = oms-flatten-rows-go(text, 0, []);
        def oms-flatten-rows-go(text, from, acc) {
            let at = str_find(text, "(list \"", from);
            at < 0 ? reverse(acc) : oms-flatten-row-at(text, at + 7, acc);
        }
        def oms-flatten-row-at(text, nameAt, acc) {
            let nameEnd = str_find(text, "\"", nameAt);
            let arityEnd = str_find(text, " ", nameEnd + 2);
            let tagEnd = str_find(text, ")", arityEnd + 1);
            oms-flatten-rows-go(text, tagEnd, cons([substring(text, nameAt, nameEnd), str_to_int(substring(text, nameEnd + 2, arityEnd)), str_to_int(substring(text, arityEnd + 1, tagEnd))], acc));
        }
        def oms-fk-rows(texts) = nom-fkwu-rows(oms-t-optable(texts));
        // the generated header stands on its source, row for row
        def oms-optable-errors(texts) {
            let source = oms-flatten-rows(oms-t-flatten-dir(texts));
            let header = oms-fk-rows(texts);
            (Comparable) len(header) == 0 ? ["no fk_optab rows in runtime/fkwu-optable.h"]
            : append(oms-diff-error(lx-triple-diff(source, header), "in flatten/ flt-ops but not the generated optable (regen via flatten/gen-source-walker-table.fk)"),
                     oms-diff-error(lx-triple-diff(header, source), "in the generated optable but not flatten/ flt-ops (regen via flatten/gen-source-walker-table.fk)"));
        }
        // one name, one meaning across the two tables; a manifest name fkwu does not
        // answer is one of form-cli's declared byte carriers or a wound
        def oms-fk-named(fk, name) = filter(r => (String) r[0] == name, fk);
        def oms-fk-tagged(fk, tag) = filter(r => (Comparable) r[2] == tag, fk);
        def oms-carrier?(name) = (Comparable) lx-triple-name-in?(oms-carrier-rows(), name) == 1;
        def oms-cross-errors(nom, fk) = (Comparable) len(nom) == 0 ? [] : append(oms-cross-one(nom[0], fk), oms-cross-errors(nom[1:], fk));
        def oms-cross-one(r, fk) {
            let same = oms-fk-named(fk, r[0]);
            (Comparable) len(same) > 0 ? oms-when(!((Comparable) lx-triple-eq?(same[0], r) == 1), "one name, two meanings: " ++ r[0] ++ " is " ++ lx-py-triple(r) ++ " in the manifest and " ++ lx-py-triple(same[0]) ++ " in fkwu's table")
            : oms-when(!oms-carrier?(r[0]), "the manifest carries " ++ r[0] ++ " that fkwu's table does not answer: add its flatten/form-flatten.fk row, or name it a form-cli carrier");
        }
        // the tags form-cli's carriers share with fkwu, spoken in the reading
        def oms-shared-tags(fk) = map(r => r[0] ++ "@" ++ r[2].str() ++ "=" ++ tb-join(oms-fk-tagged(fk, r[2]), x => x[0], "/"), filter(r => len(oms-fk-tagged(fk, r[2])) > 0, oms-carrier-rows()));

        // ---- all errors over given tables and texts, in the script's order ----
        def oms-errors-with(flt, nom, texts) = append(oms-table-errors(flt, nom),
            append(oms-carrier-errors(oms-carrier-rows(), flt, nom, texts),
            append(oms-obsolete-errors(oms-obsolete(), flt, nom),
            append(oms-variadic-errors(oms-variadic-rows(), texts),
            append(oms-negative-errors(nom),
            append(oms-optable-errors(texts), oms-cross-errors(nom, oms-fk-rows(texts))))))));
        // read under a root; a missing text is one named error and no further judgment
        def oms-errors(flt, nom, root) {
            let read = oms-read-all(root, oms-text-paths(), []);
            (String) read[0] == "missing" ? ["missing input: " ++ read[1]] : oms-errors-with(flt, nom, read[1]);
        }
        def oms-fk-reading(root) = nom-fkwu-rows(read_file(root ++ oms-optable()));

        // ---- the voice ----
        def oms-ok-line(n, fk) = "(" ++ n.str() ++ " rows aligned with fkwu's " ++ len(fk).str() ++ " on every name both carry; form-cli's carriers share " ++ tb-join(oms-shared-tags(fk), x => x, " ") ++ "; edit manifest first, then regenerate flt-ops — not the reverse)";
        def oms-judge(flt, nom, root) = lx-verdict(oms-name(), oms-errors(flt, nom, root), oms-ok-line(len(flt), oms-fk-reading(root)));
        def oms-run() = oms-judge(flt-ops(), nom-ops(), "");
    }
    oms-run();
}
