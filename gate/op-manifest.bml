//////////////////////////////////////////////////////////////////////
//
// gate/op-manifest.bml — the op-manifest drift gate as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/sync_native_op_manifest.py, built by reading that script
// as the spec and transliterating it check for check. The script stays
// in place as a witness while this lens stands its first landings; the
// drift-gates row (gate/drift-gates.bml, "op-manifest") runs this door.
//
// THE INVARIANT. form/form-stdlib/native-op-manifest.fk is the
// authoritative fkwu native surface (rows: name arity tag class) and
// form/form-stdlib/form-flatten.fk's flt-ops (rows: name arity tag) is
// its regenerated mirror. The invariant is that the two tables hold the
// same set of (name arity tag) triples. Around that core, four more
// mirrors are held in one assertion:
//   1. the three byte-carrier ops (string_bytes 1 205, string_byte_fold
//      3 206, form_table_text 2 207) stand in the manifest, in flt-ops,
//      as an `if (t == TAG)` arm in fkc-table-serialize.fk, and as a
//      registration in each sibling kernel (Go registerNative(", Rust
//      register_native(", TypeScript registerNative(");
//   2. the obsolete carrier `string_fold` lowers nowhere;
//   3. the four variadic ops (list 19, print 239, record_new 64,
//      method_invoke 199) live OUTSIDE the manifest lane by
//      construction — stdlib flt-op2 folds an unknown arity as a quad —
//      so each is checked by name+tag in flatten/form-flatten.fk's
//      hand-held flt-ops, in the generated runtime/fkwu-optable.h, and
//      as a `t == TAG)` walker arm in runtime/fkwu-uni.c;
//   4. no manifest row carries a negative arity.
//
// INPUTS. The two tables are read through their own accessors — nom-ops
// from native-op-manifest.fk, flt-ops from form-flatten.fk (the stdlib
// copy, the one the script compares) — not through a regex over their
// text: the body reading its tables as tables. The seven texts the
// mirror checks need are read whole (read_file) under a root the band
// can re-point; "" is the live tree.
//
// EXIT. Zero errors: one line `op-manifest: OK (<flt-ops rows> rows
// aligned; edit manifest first, then regenerate flt-ops — not the
// reverse)` and the answer 1. Otherwise one `error: ...` line per
// finding, in the script's order, then `op-manifest: FAIL` and the
// answer 0. The lines are the script's own words, its module name
// replaced by this lens's, so the band can hold the two outputs
// against each other byte for byte. A text the tree does not have is
// named (`error: missing input: <path>`) and refuses — the script
// dies in a traceback there; the lens answers with a row.
//
// Run directly:  ./fkwu gate/op-manifest.bml          ; last line 1 / 0
// Twin:          python3 form/scripts/sync_native_op_manifest.py
// Proven by:     gate/tests/op-manifest-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormOpManifestGate {
        thought op-manifest-pattern = list("manifest-first", "tables-through-their-accessors", "four-mirrors-one-assertion", "variadic-is-seen", "twin-voice-byte-for-byte");

        def oms-name() = "op-manifest";

        // ---- the texts, under a root ("" = the live tree) ----
        def oms-emitter() = "form/form-stdlib/fkc-table-serialize.fk";
        def oms-flatten-dir() = "flatten/form-flatten.fk";
        def oms-optable() = "runtime/fkwu-optable.h";
        def oms-runtime() = "runtime/fkwu-uni.c";
        // sibling rows: kernel name, path, registration needle
        def oms-sibling(kernel, path, needle) = list(kernel, path, needle);
        def oms-siblings() = list(
            oms-sibling("Go", "form/form-kernel-go/main.go", "registerNative(\""),
            oms-sibling("Rust", "form/form-kernel-rust/src/main.rs", "register_native(\""),
            oms-sibling("TypeScript", "form/form-kernel-ts/src/kernel.ts", "registerNative(\""));
        def oms-text-paths() = list(oms-emitter(), nth(nth(oms-siblings(), 0), 1), nth(nth(oms-siblings(), 1), 1), nth(nth(oms-siblings(), 2), 1), oms-flatten-dir(), oms-optable(), oms-runtime());

        // ---- the data the script carries as constants: rows ----
        def oms-carrier-rows() = list(list("string_bytes", 1, 205), list("string_byte_fold", 3, 206), list("form_table_text", 2, 207));
        def oms-obsolete() = list("string_fold");
        def oms-variadic(name, tag) = list(name, tag);
        def oms-variadic-rows() = list(oms-variadic("list", 19), oms-variadic("print", 239), oms-variadic("record_new", 64), oms-variadic("method_invoke", 199));

        // ---- reading the texts: a list parallel to oms-text-paths, or the first missing path ----
        def oms-read-all(root, paths, acc) {
            if eq(len(paths), 0) then list("ok", reverse(acc))
            else oms-read-one(root, head(paths), tail(paths), acc, read_file(str_concat(root, head(paths))));
        }
        def oms-read-one(root, path, rest, acc, text) = if nothing?(text) then list("missing", str_concat(root, path)) else oms-read-all(root, rest, cons(text, acc));
        def oms-t-emitter(texts) = nth(texts, 0);
        def oms-t-sibling(texts, k) = nth(texts, add(1, k));
        def oms-t-flatten-dir(texts) = nth(texts, 4);
        def oms-t-optable(texts) = nth(texts, 5);
        def oms-t-runtime(texts) = nth(texts, 6);

        // ---- the checks, each answering a list of error strings in the script's order ----
        def oms-diff-error(rows, voice) = if eq(len(rows), 0) then list() else list(str_concat(voice, str_concat(" (", str_concat(int_to_str(len(rows)), str_concat("): ", lx-py-head5(rows, lx-py-triple))))));
        def oms-table-errors(flt, nom) = append(oms-diff-error(lx-triple-diff(flt, nom), "in flt-ops but not manifest"), oms-diff-error(lx-triple-diff(nom, flt), "in manifest but not flt-ops"));

        def oms-carrier-errors(rows, flt, nom, texts) = if eq(len(rows), 0) then list() else append(oms-carrier-one(head(rows), flt, nom, texts), oms-carrier-errors(tail(rows), flt, nom, texts));
        def oms-carrier-one(r, flt, nom, texts) = append(
            oms-when(not(eq(lx-triple-in?(nom, r), 1)), str_concat("byte carrier manifest mismatch: expected ", lx-py-triple(r))),
            append(oms-when(not(eq(lx-triple-in?(flt, r), 1)), str_concat("byte carrier lowering mismatch: expected ", lx-py-triple(r))),
            append(oms-when(not(eq(lx-has?(oms-t-emitter(texts), oms-arm-needle(nth(r, 2))), 1)), str_concat("byte carrier emitted arm missing: ", str_concat(nth(r, 0), str_concat(" tag ", int_to_str(nth(r, 2)))))),
                   oms-sibling-errors(oms-siblings(), 0, nth(r, 0), texts))));
        def oms-arm-needle(tag) = str_concat("if (t == ", str_concat(int_to_str(tag), ")"));
        def oms-sibling-errors(sibs, k, name, texts) {
            if eq(len(sibs), 0) then list()
            else append(oms-when(not(eq(lx-has?(oms-t-sibling(texts, k), str_concat(nth(head(sibs), 2), name)), 1)), str_concat("byte carrier sibling missing: ", str_concat(nth(head(sibs), 0), str_concat(" ", name)))),
                        oms-sibling-errors(tail(sibs), add(k, 1), name, texts));
        }

        def oms-obsolete-errors(names, flt, nom) = if eq(len(names), 0) then list() else append(
            oms-when(or(eq(lx-triple-name-in?(nom, head(names)), 1), eq(lx-triple-name-in?(flt, head(names)), 1)), str_concat("obsolete byte carrier still lowerable: ", head(names))),
            oms-obsolete-errors(tail(names), flt, nom));

        def oms-variadic-errors(rows, texts) = if eq(len(rows), 0) then list() else append(oms-variadic-one(head(rows), texts), oms-variadic-errors(tail(rows), texts));
        def oms-variadic-one(v, texts) {
            let name = nth(v, 0);
            let tag = int_to_str(nth(v, 1));
            append(oms-when(not(eq(lx-has?(oms-t-flatten-dir(texts), str_concat("(list \"", str_concat(name, str_concat("\" -1 ", str_concat(tag, ")"))))), 1)), str_concat("variadic op missing from flatten/ flt-ops: ", str_concat(name, str_concat(" -1 ", tag)))),
            append(oms-when(not(eq(lx-has?(oms-t-optable(texts), str_concat("{ \"", str_concat(name, str_concat("\", -1, ", str_concat(tag, " }"))))), 1)), str_concat("variadic op missing from generated optable: ", str_concat(name, str_concat(" -1 ", str_concat(tag, " (regen via flatten/gen-source-walker.fk)"))))),
                   oms-when(not(eq(lx-has?(oms-t-runtime(texts), str_concat("t == ", str_concat(tag, ")"))), 1)), str_concat("variadic op walker arm missing: ", str_concat(name, str_concat(" tag ", tag))))));
        }
        def oms-negative-errors(nom) = oms-when(eq(lx-triple-any-negative?(nom), 1), "variadic (arity<0) row in the manifest: stdlib flt-op2 folds unknown arity as a quad -- variadic ops belong in VARIADIC_OPS + flatten/ flt-ops only");

        def oms-when(cond, msg) = if cond then list(msg) else list();

        // ---- all errors over given tables and texts, in the script's order ----
        def oms-errors-with(flt, nom, texts) = append(oms-table-errors(flt, nom),
            append(oms-carrier-errors(oms-carrier-rows(), flt, nom, texts),
            append(oms-obsolete-errors(oms-obsolete(), flt, nom),
            append(oms-variadic-errors(oms-variadic-rows(), texts), oms-negative-errors(nom)))));
        // read under a root; a missing text is one named error and no further judgment
        def oms-errors(flt, nom, root) {
            let read = oms-read-all(root, oms-text-paths(), list());
            if str_eq(nth(read, 0), "missing") then list(str_concat("missing input: ", nth(read, 1))) else oms-errors-with(flt, nom, nth(read, 1));
        }

        // ---- the voice ----
        def oms-ok-line(n) = str_concat("(", str_concat(int_to_str(n), " rows aligned; edit manifest first, then regenerate flt-ops — not the reverse)"));
        def oms-judge(flt, nom, root) = lx-verdict(oms-name(), oms-errors(flt, nom, root), oms-ok-line(len(flt)));
        def oms-run() = oms-judge(flt-ops(), nom-ops(), "");
    }
    oms-run();
}
