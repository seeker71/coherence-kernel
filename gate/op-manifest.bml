// Native Form lens for manifest, table and carrier agreement.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk
section [form.bml] {
    class FormOpManifestGate {
        thought op-manifest-pattern = list("manifest-first", "tables-through-their-accessors", "four-mirrors-one-assertion", "variadic-is-seen", "twin-voice-byte-for-byte");

        def oms-name() = "op-manifest";

        // ---- the texts, under a root ("" = the live tree) ----
        def oms-emitter() = "form/form-stdlib/fkc-table-serialize.fk";
        def oms-flatten-dir() = "flatten/form-flatten.fk";
        def oms-optable() = "runtime/fkwu-optable.h";
        def oms-runtime() = "runtime/fkwu-uni.c";
        // sibling rows: kernel name, path, registration needle
        def oms-sibling(kernel, path, needle) = list(kernel, path, needle);
        def oms-siblings() = list(
            oms-sibling("Go", "form/form-kernel-go/main.go", "registerNative(\""),
            oms-sibling("Rust", "form/form-kernel-rust/src/main.rs", "register_native(\""),
            oms-sibling("TypeScript", "form/form-kernel-ts/src/kernel.ts", "registerNative(\""));
        def oms-text-paths() = list(oms-emitter(), oms-siblings()[0][1], oms-siblings()[1][1], oms-siblings()[2][1], oms-flatten-dir(), oms-optable(), oms-runtime());

        // ---- the data the script carries as constants: rows ----
        def oms-carrier-rows() = list(list("string_bytes", 1, 205), list("string_byte_fold", 3, 206), list("form_table_text", 2, 207));
        def oms-obsolete() = list("string_fold");
        def oms-variadic(name, tag) = list(name, tag);
        def oms-variadic-rows() = list(oms-variadic("list", 19), oms-variadic("print", 239), oms-variadic("record_new", 64), oms-variadic("method_invoke", 199));

        // ---- reading the texts: a list parallel to oms-text-paths, or the first missing path ----
        def oms-read-all(root, paths, acc) {
            (Comparable) len(paths) == 0 ? list("ok", reverse(acc))
            : oms-read-one(root, head(paths), tail(paths), acc, read_file(root ++ head(paths)));
        }
        def oms-read-one(root, path, rest, acc, text) = nothing?(text) ? list("missing", root ++ path) : oms-read-all(root, rest, cons(text, acc));
        def oms-t-emitter(texts) = texts[0];
        def oms-t-sibling(texts, k) = texts[1 + k];
        def oms-t-flatten-dir(texts) = texts[4];
        def oms-t-optable(texts) = texts[5];
        def oms-t-runtime(texts) = texts[6];

        // ---- the checks, each answering a list of error strings in the script's order ----
        def oms-diff-error(rows, voice) = (Comparable) len(rows) == 0 ? list() : list(voice ++ " (" ++ int_to_str(len(rows)) ++ "): " ++ lx-py-head5(rows, lx-py-triple));
        def oms-table-errors(flt, nom) = append(oms-diff-error(lx-triple-diff(flt, nom), "in flt-ops but not manifest"), oms-diff-error(lx-triple-diff(nom, flt), "in manifest but not flt-ops"));

        def oms-carrier-errors(rows, flt, nom, texts) = (Comparable) len(rows) == 0 ? list() : append(oms-carrier-one(head(rows), flt, nom, texts), oms-carrier-errors(tail(rows), flt, nom, texts));
        def oms-carrier-one(r, flt, nom, texts) = append(
            oms-when(!((Comparable) lx-triple-in?(nom, r) == 1), "byte carrier manifest mismatch: expected " ++ lx-py-triple(r)),
            append(oms-when(!((Comparable) lx-triple-in?(flt, r) == 1), "byte carrier lowering mismatch: expected " ++ lx-py-triple(r)),
            append(oms-when(!((Comparable) lx-has?(oms-t-emitter(texts), oms-arm-needle(r[2])) == 1), "byte carrier emitted arm missing: " ++ r[0] ++ " tag " ++ int_to_str(r[2])),
                   oms-sibling-errors(oms-siblings(), 0, r[0], texts))));
        def oms-arm-needle(tag) = "if (t == " ++ int_to_str(tag) ++ ")";
        def oms-sibling-errors(sibs, k, name, texts) {
            (Comparable) len(sibs) == 0 ? list()
            : append(oms-when(!((Comparable) lx-has?(oms-t-sibling(texts, k), head(sibs)[2] ++ name) == 1), "byte carrier sibling missing: " ++ head(sibs)[0] ++ " " ++ name),
                        oms-sibling-errors(tail(sibs), k + 1, name, texts));
        }

        def oms-obsolete-errors(names, flt, nom) = (Comparable) len(names) == 0 ? list() : append(
            oms-when(((Comparable) lx-triple-name-in?(nom, head(names)) == 1) || ((Comparable) lx-triple-name-in?(flt, head(names)) == 1), "obsolete byte carrier still lowerable: " ++ head(names)),
            oms-obsolete-errors(tail(names), flt, nom));

        def oms-variadic-errors(rows, texts) = (Comparable) len(rows) == 0 ? list() : append(oms-variadic-one(head(rows), texts), oms-variadic-errors(tail(rows), texts));
        def oms-variadic-one(v, texts) {
            let name = v[0];
            let tag = int_to_str(v[1]);
            append(oms-when(!((Comparable) lx-has?(oms-t-flatten-dir(texts), "(list \"" ++ name ++ "\" -1 " ++ tag ++ ")") == 1), "variadic op missing from flatten/ flt-ops: " ++ name ++ " -1 " ++ tag),
            append(oms-when(!((Comparable) lx-has?(oms-t-optable(texts), "{ \"" ++ name ++ "\", -1, " ++ tag ++ " }") == 1), "variadic op missing from generated optable: " ++ name ++ " -1 " ++ tag ++ " (regen via flatten/gen-source-walker.fk)"),
                   oms-when(!((Comparable) lx-has?(oms-t-runtime(texts), "t == " ++ tag ++ ")") == 1), "variadic op walker arm missing: " ++ name ++ " tag " ++ tag)));
        }
        def oms-negative-errors(nom) = oms-when((Comparable) lx-triple-any-negative?(nom) == 1, "variadic (arity<0) row in the manifest: stdlib flt-op2 folds unknown arity as a quad -- variadic ops belong in VARIADIC_OPS + flatten/ flt-ops only");

        def oms-when(cond, msg) = cond ? list(msg) : list();

        // ---- all errors over given tables and texts, in the script's order ----
        def oms-errors-with(flt, nom, texts) = append(oms-table-errors(flt, nom),
            append(oms-carrier-errors(oms-carrier-rows(), flt, nom, texts),
            append(oms-obsolete-errors(oms-obsolete(), flt, nom),
            append(oms-variadic-errors(oms-variadic-rows(), texts), oms-negative-errors(nom)))));
        // read under a root; a missing text is one named error and no further judgment
        def oms-errors(flt, nom, root) {
            let read = oms-read-all(root, oms-text-paths(), list());
            (String) read[0] == "missing" ? list("missing input: " ++ read[1]) : oms-errors-with(flt, nom, read[1]);
        }

        // ---- the voice ----
        def oms-ok-line(n) = "(" ++ int_to_str(n) ++ " rows aligned; edit manifest first, then regenerate flt-ops — not the reverse)";
        def oms-judge(flt, nom, root) = lx-verdict(oms-name(), oms-errors(flt, nom, root), oms-ok-line(len(flt)));
        def oms-run() = oms-judge(flt-ops(), nom-ops(), "");
    }
    oms-run();
}
