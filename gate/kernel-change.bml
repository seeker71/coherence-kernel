// kernel-change.bml — has a kernel source moved since origin/main?
// fkwu is the runtime. The sibling kernels (Go, Rust, TypeScript) read the same Form and answer as
// fkwu does: they validate a kernel change, they are not a runtime, and their speed is no goal. So
// they are asked only when a kernel changes. A kernel source is the seed (runtime/), the proof walkers
// (walkers/) and the fuller siblings (form/form-kernel-go, form/form-kernel-rust,
// form/form-kernel-ts/src). Everything else, the BML and Form where most work lands, the carrier and
// the bands, is validated on fkwu against its pins.
// kc-run prints one reading, then answers 1 when a kernel source differs from the merge-base with
// origin/main (committed, in the working tree, or untracked) or when no merge-base can be read, and 0
// when none moved. form/validate.sh asks it before it builds or starts any sibling.
// preludes: form-stdlib/core.fk
section [form.bml] {
    class KernelChange {
        def kc-paths() = ":/runtime :/walkers :/form/form-kernel-go :/form/form-kernel-rust :/form/form-kernel-ts/src";
        def kc-sh(cmd) {
            let v = host-exec(cmd, "");
            if nothing?(v) then "" else v;
        }
        def kc-base() = kc-sh("git merge-base HEAD origin/main 2>/dev/null | tr -d '[:space:]'");
        def kc-moved(base) = kc-sh(str_concat("{ git diff --name-only ", str_concat(base, str_concat(" -- ", str_concat(kc-paths(), str_concat("; git ls-files --others --exclude-standard -- ", str_concat(kc-paths(), "; } 2>/dev/null | sort -u")))))));
        def kc-lines(s, i, n) = if ge(i, str_len(s)) then n else kc-lines(s, add(i, 1), if eq(str_byte_at(s, i), 10) then add(n, 1) else n);
        def kc-short(base) = if lt(str_len(base), 12) then base else substring(base, 0, 12);
        def kc-say(text, moved, answer) {
            print_str(str_concat(text, byte_to_str(10)));
            let listed = if gt(str_len(moved), 0) then print_str(moved) else 0;
            answer;
        }
        def kc-run() {
            let base = kc-base();
            let moved = if eq(str_len(base), 0) then "" else kc-moved(base);
            let n = kc-lines(moved, 0, 0);
            let at = str_concat("kernel sources since origin/main ", kc-short(base));
            if eq(str_len(base), 0) then kc-say("kernel sources: no merge-base with origin/main to read; the sibling kernels validate this run", "", 1) else if eq(n, 0) then kc-say(str_concat(at, ": none moved; bands answer their pins on fkwu"), "", 0) else kc-say(str_concat(at, str_concat(": ", str_concat(int_to_str(n), " moved; the sibling kernels validate them"))), moved, 1);
        }
    }
    0;
}
