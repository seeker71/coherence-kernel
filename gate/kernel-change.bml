// kernel-change.bml — has a kernel source moved since origin/main?
// fkwu is the runtime. The sibling kernels (Go, Rust, TypeScript) read the same Form and answer as
// fkwu does: they validate a kernel change, they are not a runtime, and their speed is no goal. So
// they are asked only when a kernel changes. A kernel source is the seed (runtime/), the proof walkers
// (walkers/) and the fuller siblings (form/form-kernel-go, form/form-kernel-rust,
// form/form-kernel-ts/src). Everything else, the BML and Form where most work lands, the carrier and
// the bands, is validated on fkwu against its pins.
// kc-run prints one reading, then answers 1 when a kernel source differs from the merge-base with
// origin/main (committed, in the working tree, or untracked) or when no merge-base can be read, and 0
// when none moved. form/validate.sh asks it before it builds or starts any sibling.
// preludes: form-stdlib/core.fk
section [form.bml] {
    class KernelChange {
        def kc-paths() = ":/runtime :/walkers :/form/form-kernel-go :/form/form-kernel-rust :/form/form-kernel-ts/src";
        def kc-sh(cmd) {
            let v = host-exec(cmd, "");
            v ?? "";
        }
        def kc-base() = kc-sh("git merge-base HEAD origin/main 2>/dev/null | tr -d '[:space:]'");
        def kc-moved(base) = kc-sh("{ git diff --name-only " ++ base ++ " -- " ++ kc-paths() ++ "; git ls-files --others --exclude-standard -- " ++ kc-paths() ++ "; } 2>/dev/null | sort -u");
        def kc-lines(s, i, n) = i >= str_len(s) ? n : kc-lines(s, i + 1, (Comparable) str_byte_at(s, i) == 10 ? (n + 1) : n);
        def kc-short(base) = str_len(base) < 12 ? base : substring(base, 0, 12);
        def kc-say(text, moved, answer) {
            print_str(text ++ byte_to_str(10));
            let listed = str_len(moved) > 0 ? print_str(moved) : 0;
            answer;
        }
        def kc-run() {
            let base = kc-base();
            let moved = (Comparable) str_len(base) == 0 ? "" : kc-moved(base);
            let n = kc-lines(moved, 0, 0);
            let at = "kernel sources since origin/main " ++ kc-short(base);
            (Comparable) str_len(base) == 0 ? kc-say("kernel sources: no merge-base with origin/main to read; the sibling kernels validate this run", "", 1) : (Comparable) n == 0 ? kc-say(at ++ ": none moved; bands answer their pins on fkwu", "", 0) : kc-say(at ++ ": " ++ int_to_str(n) ++ " moved; the sibling kernels validate them", moved, 1);
        }
    }
    0;
}
