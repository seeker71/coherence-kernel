; structural-gate.fk — the no-bash/no-python constraint, as a number the body can read.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
;
; MANIFEST.md states this repo's second hard constraint outright: "This repo contains
; **zero `.sh` and zero `.py` files.** Ever." and "A repo gate enforces the
; no-bash/no-python constraint: any `.sh` or `.py` landing in the tree fails the gate."
;
; The gate was not in the tree. There is no `.github/workflows/`, and no cell enforces
; it — the sentence has been carrying the weight alone. So this cell is the gate the
; manifest describes, and it is deliberately a COUNTER rather than a verdict: it walks
; the tree from a root and answers how many `.sh` and `.py` files are under it. What
; the number should be is a question for the body, not for the instrument, and an
; instrument that decided the answer in advance could not report a surprise.
;
; It reports one, on the day it was written: **180**, and that is not a regression from
; anything — the same 180 stand on `origin/main`. Some have honest roles the repo's own
; vocabulary already has words for: `form/form-stdlib/tests/dsv4-*-oracle.py` are local
; ORACLES (never authority), and `form/native/**` and `presence/carriers/**` are
; CARRIERS (the body decides meaning, the carrier moves bytes). None of that is
; smuggled; every one is named in receipts. What is not true is the unqualified
; sentence, and a claim that no longer matches the tree is exactly what
; observe/belief-freshness.fk says is owed a re-witness.
;
; So this cell takes no position on the policy. It makes the policy checkable. Whether
; the honest law turns out to be "zero", or "zero in the sovereign core with carriers
; and oracles named at their own paths", the count is the thing that can tell you which
; one you are living in.
;
; Cost: one host `fs_list` per directory and one `fs_is_dir?` per entry, walked once.
; fkwu-witnessed — the walk is host I/O, which is fkwu's family and not the walkers'.

(do
    (defn sg-ext-sh () ".sh")
    (defn sg-ext-py () ".py")
    (defn sg-git-dir () ".git")

    ; 1 when a leaf name is one of the two the constraint names
    (defn sg-hit? (name)
        (do (let e (fs-path-extension name))
            (if (str_eq e (sg-ext-sh)) 1 (if (str_eq e (sg-ext-py)) 1 0))))

    ; .git holds packed history, not tree content; the constraint speaks about the tree
    (defn sg-skip? (name) (if (str_eq name (sg-git-dir)) 1 0))

    (defn sg-entries-loop (dir es i n acc)
        (if (ge i n)
            acc
            (do (let name (nth es i))
                (if (eq (sg-skip? name) 1)
                    (sg-entries-loop dir es (add i 1) n acc)
                    (do (let p (fs-path-join dir name))
                        (if (eq (fs-is-dir? p) 1)
                            (sg-entries-loop dir es (add i 1) n (add acc (sg-count p)))
                            (sg-entries-loop dir es (add i 1) n (add acc (sg-hit? name)))))))))

    ; THE ENTRY POINT: how many .sh + .py files live under this root
    (defn sg-count (dir)
        (do (let es (fs-list dir))
            (sg-entries-loop dir es 0 (len es) 0)))

    ; and the two halves separately, for a body that wants to see which constraint moved
    (defn sg-hit-ext? (name ext) (if (str_eq (fs-path-extension name) ext) 1 0))
    (defn sg-entries-ext-loop (dir es i n ext acc)
        (if (ge i n)
            acc
            (do (let name (nth es i))
                (if (eq (sg-skip? name) 1)
                    (sg-entries-ext-loop dir es (add i 1) n ext acc)
                    (do (let p (fs-path-join dir name))
                        (if (eq (fs-is-dir? p) 1)
                            (sg-entries-ext-loop dir es (add i 1) n ext
                                                 (add acc (sg-count-ext p ext)))
                            (sg-entries-ext-loop dir es (add i 1) n ext
                                                 (add acc (sg-hit-ext? name ext)))))))))
    (defn sg-count-ext (dir ext)
        (do (let es (fs-list dir))
            (sg-entries-ext-loop dir es 0 (len es) ext 0)))
    (defn sg-count-sh (dir) (sg-count-ext dir (sg-ext-sh)))
    (defn sg-count-py (dir) (sg-count-ext dir (sg-ext-py)))
    0)
