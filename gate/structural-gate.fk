; structural-gate.fk — the Form-owned core is shell/Python free; auxiliary
; carriers, fixtures, local oracles, proof siblings, and tooling stay named.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
;
; This is a verdict, not the former counter. The old Manifest claimed there
; were no .sh/.py files while the tree held them, and this cell merely reported
; their number. That made a green band compatible with a false constraint.
;
; The honest constraint is structural: a shell or Python file is permitted
; only where its role is explicit. Form-owned meaning and runtime may not
; acquire one accidentally. The exceptional roles below are deliberately
; observable rather than folded into a fake zero:
; carrier, oracle, fixture, proof-sibling, tooling, foreign-grammar.
;
; `sg-audit` walks the current checkout (not a pinned count). A new script
; outside those declared boundaries becomes `unclassified`, and
; structural-gate-run.fk returns native policy status 0. The runner is also
; called by form/validate.sh, whose existing process carrier makes that native
; refusal a nonzero validation result.
;
; Cost: one host fs_list per directory plus fs_is_dir? per entry. The role
; decision is pure Form; host I/O remains the named carrier beneath form-fs.

(do
    (defn sg-ext-sh () ".sh")
    (defn sg-ext-py () ".py")
    (defn sg-git-dir () ".git")

    ; Audit shape: total, unclassified, carrier, oracle, fixture,
    ; proof-sibling, tooling, foreign-grammar.
    (defn sg-audit-width () 8)
    (defn sg-total-slot () 0)
    (defn sg-unclassified-slot () 1)
    (defn sg-carrier-slot () 2)
    (defn sg-oracle-slot () 3)
    (defn sg-fixture-slot () 4)
    (defn sg-proof-sibling-slot () 5)
    (defn sg-tooling-slot () 6)
    (defn sg-foreign-grammar-slot () 7)

    (defn sg-class-unclassified () 0)
    (defn sg-class-carrier () 1)
    (defn sg-class-oracle () 2)
    (defn sg-class-fixture () 3)
    (defn sg-class-proof-sibling () 4)
    (defn sg-class-tooling () 5)
    (defn sg-class-foreign-grammar () 6)

    (defn sg-empty-audit () (list 0 0 0 0 0 0 0 0))
    (defn sg-total (a) (nth a (sg-total-slot)))
    (defn sg-unclassified (a) (nth a (sg-unclassified-slot)))
    (defn sg-carriers (a) (nth a (sg-carrier-slot)))
    (defn sg-oracles (a) (nth a (sg-oracle-slot)))
    (defn sg-fixtures (a) (nth a (sg-fixture-slot)))
    (defn sg-proof-siblings (a) (nth a (sg-proof-sibling-slot)))
    (defn sg-tooling (a) (nth a (sg-tooling-slot)))
    (defn sg-foreign-grammars (a) (nth a (sg-foreign-grammar-slot)))

    (defn sg-add-audit (a b)
        (list (add (sg-total a) (sg-total b))
              (add (sg-unclassified a) (sg-unclassified b))
              (add (sg-carriers a) (sg-carriers b))
              (add (sg-oracles a) (sg-oracles b))
              (add (sg-fixtures a) (sg-fixtures b))
              (add (sg-proof-siblings a) (sg-proof-siblings b))
              (add (sg-tooling a) (sg-tooling b))
              (add (sg-foreign-grammars a) (sg-foreign-grammars b))))

    (defn sg-audit-one (class)
        (list 1
              (if (eq class (sg-class-unclassified)) 1 0)
              (if (eq class (sg-class-carrier)) 1 0)
              (if (eq class (sg-class-oracle)) 1 0)
              (if (eq class (sg-class-fixture)) 1 0)
              (if (eq class (sg-class-proof-sibling)) 1 0)
              (if (eq class (sg-class-tooling)) 1 0)
              (if (eq class (sg-class-foreign-grammar)) 1 0)))

    ; 1 when a leaf name is one of the two extensions this gate observes.
    (defn sg-hit? (name)
        (do (let e (fs-path-extension name))
            (if (str_eq e (sg-ext-sh)) 1 (if (str_eq e (sg-ext-py)) 1 0))))

    ; .git holds packed history, not tree content. The policy speaks about the
    ; present checkout, including a new untracked script before it lands.
    (defn sg-skip? (name) (if (str_eq name (sg-git-dir)) 1 0))

    (defn sg-has? (path piece) (if (ge (str_find path piece 0) 0) 1 0))
    (defn sg-starts-with? (text prefix)
        (if (lt (str_len text) (str_len prefix)) 0
            (str_eq (substring text 0 (str_len prefix)) prefix)))
    ; A boundary is either the path's first segment or a whole later segment;
    ; `tooling/` must not match a coincidental `my-tooling/` spelling.
    (defn sg-under? (path boundary)
        (if (eq (sg-starts-with? path boundary) 1) 1
            (sg-has? path (str_concat "/" boundary))))
    (defn sg-ends-with? (text suffix)
        (do (let n (str_len text))
            (let m (str_len suffix))
            (if (lt n m) 0
                (str_eq (substring text (sub n m) n) suffix))))

    ; The two form-root shells are the public build/validation door. Requiring
    ; the .sh suffix keeps a new top-level foreign grammar from being silently
    ; classified as tooling.
    (defn sg-form-root-shell? (path)
        (if (str_eq (fs-path-extension path) (sg-ext-sh))
            (if (str_eq (fs-path-dirname path) "form") 1
                (if (str_eq (fs-path-dirname path) "./form") 1 0))
            0))

    ; External corpus acquisition/build is a source membrane even though its
    ; two tiny shells predate cognition/carriers/. Only those role suffixes
    ; qualify; an arbitrary cognition/*.sh remains unclassified.
    (defn sg-cognition-source-carrier? (path)
        (if (eq (sg-under? path "cognition/") 1)
            (if (eq (sg-ends-with? path "-fetch.sh") 1) 1
                (sg-ends-with? path "-build.sh"))
            0))

    ; Fixtures may be in a fixtures/ subtree or in a deliberately named
    ; concept-*-fixtures/ capture directory; both are evidence, not authority.
    (defn sg-fixture-path? (path)
        (if (eq (sg-under? path "fixtures/") 1) 1
            (sg-has? path "-fixtures/")))

    ; Classification is a role boundary, not a list of current filenames.
    ; Order keeps a local oracle inside tests distinct from ordinary test
    ; tooling, and keeps the foreign BMF grammar distinct from its tests.
    (defn sg-classify (path)
        (if (eq (sg-under? path "form/native/") 1) (sg-class-carrier)
        (if (eq (sg-under? path "presence/carriers/") 1) (sg-class-carrier)
        (if (eq (sg-cognition-source-carrier? path) 1) (sg-class-carrier)
        (if (eq (sg-under? path "form/python_bmf/") 1) (sg-class-foreign-grammar)
        (if (eq (sg-under? path "form/form-kernel-go/") 1) (sg-class-proof-sibling)
        (if (eq (sg-under? path "form/form-kernel-rust/") 1) (sg-class-proof-sibling)
        (if (eq (sg-under? path "form/form-kernel-ts/") 1) (sg-class-proof-sibling)
        (if (eq (sg-fixture-path? path) 1) (sg-class-fixture)
        (if (eq (sg-under? path "form/form-samples/") 1) (sg-class-fixture)
        (if (eq (sg-under? path "tests/") 1)
            (if (eq (sg-has? path "oracle") 1) (sg-class-oracle) (sg-class-tooling))
        (if (eq (sg-under? path "form/form-stdlib/measure/") 1) (sg-class-tooling)
        (if (eq (sg-under? path "form/scripts/") 1) (sg-class-tooling)
        (if (eq (sg-under? path "tools/") 1) (sg-class-tooling)
        (if (eq (sg-form-root-shell? path) 1) (sg-class-tooling)
            (sg-class-unclassified))))))))))))))))

    (defn sg-entries-audit-loop (dir es i n)
        (if (ge i n)
            (sg-empty-audit)
            (do (let name (nth es i))
                (if (eq (sg-skip? name) 1)
                    (sg-entries-audit-loop dir es (add i 1) n)
                    (do (let path (fs-path-join dir name))
                        (let here (if (eq (fs-is-dir? path) 1)
                                      (sg-audit path)
                                      (if (eq (sg-hit? name) 1)
                                          (sg-audit-one (sg-classify path))
                                          (sg-empty-audit))))
                        (sg-add-audit here (sg-entries-audit-loop dir es (add i 1) n)))))))

    ; THE ENTRY POINT: live classification of every shell/Python leaf beneath root.
    (defn sg-audit (root)
        (do (let es (fs-list root))
            (sg-entries-audit-loop root es 0 (len es))))

    ; Compatibility readers retained for callers that only need the observed
    ; total or extension split. None is a policy verdict; sg-passes? is.
    (defn sg-count (root) (sg-total (sg-audit root)))
    (defn sg-hit-ext? (name ext) (if (str_eq (fs-path-extension name) ext) 1 0))
    (defn sg-entries-ext-loop (dir es i n ext)
        (if (ge i n)
            0
            (do (let name (nth es i))
                (if (eq (sg-skip? name) 1)
                    (sg-entries-ext-loop dir es (add i 1) n ext)
                    (do (let path (fs-path-join dir name))
                        (add (if (eq (fs-is-dir? path) 1)
                                 (sg-count-ext path ext)
                                 (sg-hit-ext? name ext))
                             (sg-entries-ext-loop dir es (add i 1) n ext)))))))
    (defn sg-count-ext (root ext)
        (do (let es (fs-list root))
            (sg-entries-ext-loop root es 0 (len es) ext)))
    (defn sg-count-sh (root) (sg-count-ext root (sg-ext-sh)))
    (defn sg-count-py (root) (sg-count-ext root (sg-ext-py)))

    ; 1 is a live policy pass; 0 preserves the unknown as a visible signal.
    (defn sg-passes? (audit) (if (eq (sg-unclassified audit) 0) 1 0))
    0)
