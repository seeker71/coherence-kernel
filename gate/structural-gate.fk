// Form-owned runtime meaning is expressed in Form. The tree holds only kinds the body names (the allowlist below: Form, the C seed,
// documents and data); any other file is foreign, and a foreign file with no declared role refuses landing. A script of any language
// (shell, python, node, ruby, perl, awk, fish, tcl, R, julia, a macOS command file, whatever extension, uppercase or none) is foreign
// because it is off the list, never because it is on a list of scripts; a Form or C file that opens with #! is foreign too. The seed is
// C (runtime/fkwu-uni.c and the Metal carrier) and is not a script. Two roles are visible: a fixture is evidence, never authority
// (anything under fixtures/ or a concept-*-fixtures/ capture), and a carrier is a program that crosses to something Form cannot
// yet be, named here by its exact path with the reason, and removed from this list when Form carries what it carries.
// sg-audit reads the tree git holds, including a new untracked file before it lands (the structural reader names what it skips).
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import form-stdlib/bml/structural-source-reader.bml;
section [form.bml] {
    def sg-git-dir() = ".git";
    // Audit shape: total, unclassified, carrier, fixture.
    def sg-audit-width() = 4;
    def sg-total-slot() = 0;
    def sg-unclassified-slot() = 1;
    def sg-carrier-slot() = 2;
    def sg-fixture-slot() = 3;
    def sg-class-unclassified() = 0;
    def sg-class-carrier() = 1;
    def sg-class-fixture() = 2;
    def sg-empty-audit() = [0, 0, 0, 0];
    def sg-total(a) = nth(a, sg-total-slot());
    def sg-unclassified(a) = nth(a, sg-unclassified-slot());
    def sg-carriers(a) = nth(a, sg-carrier-slot());
    def sg-fixtures(a) = nth(a, sg-fixture-slot());
    def sg-add-audit(a, b) = [(Number) sg-total(a) + (Number) sg-total(b), (Number) sg-unclassified(a) + (Number) sg-unclassified(b), (Number) sg-carriers(a) + (Number) sg-carriers(b), (Number) sg-fixtures(a) + (Number) sg-fixtures(b)];
    def sg-audit-one(class) = [1, (Comparable) class == sg-class-unclassified() ? 1 : 0, (Comparable) class == sg-class-carrier() ? 1 : 0, (Comparable) class == sg-class-fixture() ? 1 : 0];
    // THE ALLOWLIST. What may stand in this tree is a kind the body holds, named here; any other file is foreign and needs a declared role.
    // (A list of the foreign kinds can never be whole: .awk .fish .tcl .R .jl .groovy .cs .dart .ex .nim and an uppercase .SH passed it.)
    //   form  the body's own words, read by fkwu: a #! on its first line makes it a script, which it is not allowed to be
    //   seed  the C of the one bootstrap crossing (runtime/, the Metal carrier): a #! on its first line likewise
    //   data  documents and data: inert whatever their bytes begin with (a fixture or a doc may open with #! as text)
    //   name  a few extensionless files by their exact leaf: git's own, a license, a marker, the bundle's signature files
    def sg-form-exts() = [".fk", ".bml", ".form", ".bmf"];
    def sg-seed-exts() = [".c", ".h", ".m", ".metal"];
    def sg-data-exts() = [".md", ".mdc", ".txt", ".json", ".jsonl", ".tsv", ".rows", ".dat", ".html", ".svg", ".png", ".wav", ".bin", ".f32", ".safetensors", ".lora", ".tiktoken", ".plist", ".out", ".example", ".ptx"];
    def sg-data-names() = [".gitignore", ".gitattributes", "LICENSE", "copied-at", "CodeDirectory", "CodeRequirements", "CodeResources", "CodeSignature"];
    def sg-leaf(path) = fs-path-basename(path);
    def sg-ext(path) = fs-path-extension(sg-leaf(path));
    def sg-in?(xs, x) = nil?(xs) ? 0 : (String) xs[0] == (String) x ? 1 : sg-in?(xs[1:], x);
    def sg-form?(path) = sg-in?(sg-form-exts(), sg-ext(path));
    def sg-seed?(path) = sg-in?(sg-seed-exts(), sg-ext(path));
    def sg-data?(path) = (Comparable) sg-in?(sg-data-exts(), sg-ext(path)) == 1 ? 1 : sg-in?(sg-data-names(), sg-leaf(path));
    // The first two bytes are #! (a script by its own declaration, whatever its name).
    def sg-shebang?(path) = (Comparable) file_size(path) > 1 ? ((String) (read_file_slice(path, 0, 2) ?? "") == "#!" ? 1 : 0) : 0;
    // A hit is a file the body does not hold as itself: a kind off the list, or a Form or seed file that opens with #!.
    def sg-hit?(path) = (Comparable) sg-data?(path) == 1 ? 0 : (Comparable) sg-form?(path) == 1 || (Comparable) sg-seed?(path) == 1 ? sg-shebang?(path) : 1;
    // .git holds packed history, not tree content. The policy speaks about the present checkout, including a new untracked script
    // before it lands. .claude holds the agents' worktrees -- whole sibling checkouts of this body, audited by their own gates in
    // their own trees. Walking them here counts the body many times over.
    def sg-claude-dir() = ".claude";
    def sg-has?(path, piece) = str_find(path, piece, 0) >= 0 ? 1 : 0;
    def sg-starts-with?(text, prefix) = len(text) < len(prefix) ? 0 : (String) substring(text, 0, len(prefix)) == prefix;
    // A boundary is either the path's first segment or a whole later segment.
    def sg-under?(path, boundary) = (Comparable) sg-starts-with?(path, boundary) == 1 ? 1 : sg-has?(path, ("/" + boundary));
    def sg-ends-with?(text, suffix) = {
        let n = len(text);
        let m = len(suffix);
        n < m ? 0 : (String) substring(text, n - m, n) == suffix;
    };
    // The declared carriers, by exact path. Each is a crossing Form cannot yet be.
    //   form-run                              the output-compaction wrapper the user's global instructions name; its Form-native
    //                                         classifier is pending (compaction=transparent-pending-form-native-classifier)
    //   Sema Ear.app/Contents/MacOS/Sema Ear  the ear's principal: a bundle's executable is a program, and macOS binds the microphone
    //                                         grant to the bundle that LaunchServices began
    def sg-declared-carrier?(path) = (String) path == "form-run" ? 1 : (String) path == "Sema Ear.app/Contents/MacOS/Sema Ear" ? 1 : 0;
    // Form writes these retained OS transport scripts into its private healing spool: process groups and redirection, git
    // inventory, and symlink probes. Healing decisions live in BML. Nothing else gains a role by appearing in the spool.
    def sg-heal-host-carrier?(path) = (Comparable) sg-under?(path, ".form-heal/") == 1 ? sg-ends-with?(path, ".launch.sh") ? 1 : (String) fs-path-basename(path) == "inventory.sh" ? 1 : (String) fs-path-basename(path) == "links-check.sh" : 0;
    // Fixtures may be in a fixtures/ subtree or in a deliberately named concept-*-fixtures/ capture directory; both are evidence.
    def sg-fixture-path?(path) = (Comparable) sg-under?(path, "fixtures/") == 1 ? 1 : sg-has?(path, "-fixtures/");
    // Classification is a role boundary, not a list of current filenames; a path with no role is unclassified and refuses landing.
    // the reader's paths may open with ./ (find prints the root in front); a role is a path from the root
    def sg-norm(path) = (Comparable) sg-starts-with?(path, "./") == 1 ? substring(path, 2, len(path)) : path;
    def sg-classify(path) = (Comparable) sg-declared-carrier?(sg-norm(path)) == 1 ? sg-class-carrier() : (Comparable) sg-heal-host-carrier?(path) == 1 ? sg-class-carrier() : (Comparable) sg-fixture-path?(path) == 1 ? sg-class-fixture() : sg-class-unclassified();
    // a file is read where it stands and given its role by its path from the root (a root other than "." is audited by the same roles)
    def sg-rel(root, path) = (Comparable) sg-starts-with?(path, (root + "/")) == 1 ? substring(path, len(root) + 1, len(path)) : path;
    def sg-paths-audit(root, paths) = nil?(paths) ? sg-empty-audit() : sg-add-audit((Comparable) sg-hit?(paths[0]) == 1 ? sg-audit-one(sg-classify(sg-rel(root, paths[0]))) : sg-empty-audit(), sg-paths-audit(root, paths[1:]));
    // THE ENTRY POINT: live classification of every script beneath root.
    def sg-audit(root) = sg-paths-audit(root, sga-read(root, sg-git-dir(), sg-claude-dir()));
    def sg-count(root) = sg-total(sg-audit(root));
    // 1 is a live policy pass; 0 preserves the unknown as a visible signal.
    def sg-passes?(audit) = nothing?(audit) ? 0 : (Comparable) len(audit) == sg-audit-width() && (Comparable) sg-unclassified(audit) == 0;
    // What the audit says in words: no script at all, or how many stand and where
    def sg-words(audit) = (Comparable) sg-total(audit) == 0 ? "every file is a kind the body holds; no script stands in this tree" : (Comparable) sg-unclassified(audit) == 0 ? ((String) sg-carriers(audit).str() + " declared carrier(s) and " + (String) sg-fixtures(audit).str() + " fixture(s) stand; no other foreign file") : (String) sg-unclassified(audit).str() + " foreign file(s) stand with no declared role";
    0;
}
