// Form-owned runtime meaning is expressed in Form. Shell and Python files
// remain visible at declared carrier, oracle, fixture, proof and tooling
// boundaries; these classifications do not establish native ownership.
// sg-audit reads the current checkout. Unclassified scripts refuse landing.
import form-stdlib/core.fk;
import form-stdlib/form-fs.fk;
import form-stdlib/bml/structural-source-reader.bml;
section [form.bml] {
    def sg-ext-sh() = ".sh";
    def sg-ext-py() = ".py";
    def sg-git-dir() = ".git";
    // Audit shape: total, unclassified, carrier, oracle, fixture,
    // proof-sibling, tooling.
    def sg-audit-width() = 7;
    def sg-total-slot() = 0;
    def sg-unclassified-slot() = 1;
    def sg-carrier-slot() = 2;
    def sg-oracle-slot() = 3;
    def sg-fixture-slot() = 4;
    def sg-proof-sibling-slot() = 5;
    def sg-tooling-slot() = 6;
    def sg-class-unclassified() = 0;
    def sg-class-carrier() = 1;
    def sg-class-oracle() = 2;
    def sg-class-fixture() = 3;
    def sg-class-proof-sibling() = 4;
    def sg-class-tooling() = 5;
    def sg-empty-audit() = [0, 0, 0, 0, 0, 0, 0];
    def sg-total(a) = nth(a, sg-total-slot());
    def sg-unclassified(a) = nth(a, sg-unclassified-slot());
    def sg-carriers(a) = nth(a, sg-carrier-slot());
    def sg-oracles(a) = nth(a, sg-oracle-slot());
    def sg-fixtures(a) = nth(a, sg-fixture-slot());
    def sg-proof-siblings(a) = nth(a, sg-proof-sibling-slot());
    def sg-tooling(a) = nth(a, sg-tooling-slot());
    def sg-add-audit(a, b) = [(Number) sg-total(a) + (Number) sg-total(b), (Number) sg-unclassified(a) + (Number) sg-unclassified(b), (Number) sg-carriers(a) + (Number) sg-carriers(b), (Number) sg-oracles(a) + (Number) sg-oracles(b), (Number) sg-fixtures(a) + (Number) sg-fixtures(b), (Number) sg-proof-siblings(a) + (Number) sg-proof-siblings(b), (Number) sg-tooling(a) + (Number) sg-tooling(b)];
    def sg-audit-one(class) = [1, (Comparable) class == sg-class-unclassified() ? 1 : 0, (Comparable) class == sg-class-carrier() ? 1 : 0, (Comparable) class == sg-class-oracle() ? 1 : 0, (Comparable) class == sg-class-fixture() ? 1 : 0, (Comparable) class == sg-class-proof-sibling() ? 1 : 0, (Comparable) class == sg-class-tooling() ? 1 : 0];
    // 1 when a leaf name is one of the two extensions this gate observes.
    def sg-hit?(name) = {
        let e = fs-path-extension(name);
        (String) e == sg-ext-sh() ? 1 : (String) e == sg-ext-py() ? 1 : 0;
    };
    // .git holds packed history, not tree content. The policy speaks about the
    // present checkout, including a new untracked script before it lands.
    // .claude holds the agents' worktrees -- whole sibling checkouts of this body, audited by their
    // own gates in their own trees. Walking them here counts the body many times over.
    def sg-claude-dir() = ".claude";
    def sg-has?(path, piece) = str_find(path, piece, 0) >= 0 ? 1 : 0;
    def sg-starts-with?(text, prefix) = len(text) < len(prefix) ? 0 : (String) substring(text, 0, len(prefix)) == prefix;
    // A boundary is either the path's first segment or a whole later segment;
    // `tooling/` must not match a coincidental `my-tooling/` spelling.
    def sg-under?(path, boundary) = (Comparable) sg-starts-with?(path, boundary) == 1 ? 1 : sg-has?(path, ("/" + boundary));
    def sg-ends-with?(text, suffix) = {
        let n = len(text);
        let m = len(suffix);
        n < m ? 0 : (String) substring(text, n - m, n) == suffix;
    };
    // The two form-root shells are the public build/validation door. Requiring
    // the .sh suffix keeps a new top-level foreign grammar from being silently
    // classified as tooling.
    def sg-form-root-shell?(path) = (String) fs-path-extension(path) == sg-ext-sh() ? (String) fs-path-dirname(path) == "form" ? 1 : (String) fs-path-dirname(path) == "./form" ? 1 : 0 : 0;
    // External corpus acquisition/build is a source membrane. Only the
    // -fetch.sh and -build.sh role suffixes qualify; an arbitrary
    // cognition/*.sh remains unclassified.
    def sg-cognition-source-carrier?(path) = (Comparable) sg-under?(path, "cognition/") == 1 ? (Comparable) sg-ends-with?(path, "-fetch.sh") == 1 ? 1 : sg-ends-with?(path, "-build.sh") : 0;
    // Observation may carry an explicitly named public-source fetch or local
    // oracle.  The suffix is the boundary: an arbitrary observe/*.sh or *.py
    // remains unclassified rather than borrowing either role.
    def sg-observe-source-carrier?(path) = (Comparable) sg-under?(path, "observe/") == 1 ? sg-ends-with?(path, "-fetch.sh") : 0;
    // A local hardware carrier is named by its role as well.  It may cross to
    // a microphone, camera, or local accelerator, but it is never Form meaning.
    // The suffix keeps arbitrary observe Python outside the boundary.
    def sg-observe-local-carrier?(path) = (Comparable) sg-under?(path, "observe/") == 1 ? sg-ends-with?(path, "-carrier.py") : 0;
    def sg-observe-oracle?(path) = (Comparable) sg-under?(path, "observe/") == 1 ? sg-ends-with?(path, "-oracle.py") : 0;
    // Form writes these retained OS transport scripts into its private healing
    // spool: process groups/redirection, git inventory, and symlink probes.
    // Healing decisions live in BML. Neither arbitrary shell nor Python gains
    // a role merely by appearing in the spool; archived carriers stay visible.
    def sg-heal-host-carrier?(path) = (Comparable) sg-under?(path, ".form-heal/") == 1 ? sg-ends-with?(path, ".launch.sh") ? 1 : (String) fs-path-basename(path) == "inventory.sh" ? 1 : (String) fs-path-basename(path) == "links-check.sh" : 0;
    // Fixtures may be in a fixtures/ subtree or in a deliberately named
    // concept-*-fixtures/ capture directory; both are evidence, not authority.
    def sg-fixture-path?(path) = (Comparable) sg-under?(path, "fixtures/") == 1 ? 1 : sg-has?(path, "-fixtures/");
    // Classification is a role boundary, not a list of current filenames.
    // Order keeps a local oracle inside tests distinct from ordinary test
    // tooling, and keeps the foreign BMF grammar distinct from its tests.
    def sg-classify(path) = (Comparable) sg-under?(path, "form/native/") == 1 ? sg-class-carrier() : (Comparable) sg-cognition-source-carrier?(path) == 1 ? sg-class-carrier() : (Comparable) sg-observe-source-carrier?(path) == 1 ? sg-class-carrier() : (Comparable) sg-observe-local-carrier?(path) == 1 ? sg-class-carrier() : (Comparable) sg-heal-host-carrier?(path) == 1 ? sg-class-carrier() : (Comparable) sg-under?(path, "form/form-kernel-go/") == 1 ? sg-class-proof-sibling() : (Comparable) sg-under?(path, "form/form-kernel-rust/") == 1 ? sg-class-proof-sibling() : (Comparable) sg-under?(path, "form/form-kernel-ts/") == 1 ? sg-class-proof-sibling() : (Comparable) sg-fixture-path?(path) == 1 ? sg-class-fixture() : (Comparable) sg-under?(path, "form/form-samples/") == 1 ? sg-class-fixture() : (Comparable) sg-observe-oracle?(path) == 1 ? sg-class-oracle() : (Comparable) sg-under?(path, "tests/") == 1 ? (Comparable) sg-has?(path, "oracle") == 1 ? sg-class-oracle() : sg-class-tooling() : (Comparable) sg-under?(path, "form/scripts/") == 1 ? sg-class-tooling() : (Comparable) sg-under?(path, "tools/") == 1 ? sg-class-tooling() : (Comparable) sg-form-root-shell?(path) == 1 ? sg-class-tooling() : sg-class-unclassified();
    def sg-paths-audit(paths) = nil?(paths) ? sg-empty-audit() : sg-add-audit((Comparable) sg-hit?(paths[0]) == 1 ? sg-audit-one(sg-classify(paths[0])) : sg-empty-audit(), sg-paths-audit(paths[1:]));
    // THE ENTRY POINT: live classification of every shell/Python leaf beneath root.
    def sg-audit(root) = sg-paths-audit(sga-read(root, sg-git-dir(), sg-claude-dir()));
    // Compatibility readers retained for callers that only need the observed
    // total or extension split. None is a policy verdict; sg-passes? is.
    def sg-count(root) = sg-total(sg-audit(root));
    def sg-hit-ext?(name, ext) = (String) fs-path-extension(name) == ext ? 1 : 0;
    def sg-paths-count-ext(paths, ext) = nil?(paths) ? 0 : (Number) sg-hit-ext?(paths[0], ext) + (Number) sg-paths-count-ext(paths[1:], ext);
    def sg-count-ext(root, ext) = sg-paths-count-ext(sga-read(root, sg-git-dir(), sg-claude-dir()), ext);
    def sg-count-sh(root) = sg-count-ext(root, sg-ext-sh());
    def sg-count-py(root) = sg-count-ext(root, sg-ext-py());
    // 1 is a live policy pass; 0 preserves the unknown as a visible signal.
    def sg-passes?(audit) = nothing?(audit) ? 0 : (Comparable) len(audit) == sg-audit-width() && (Comparable) sg-unclassified(audit) == 0;
    0;
}
