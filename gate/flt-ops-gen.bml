//////////////////////////////////////////////////////////////////////
//
// gate/flt-ops-gen.bml — the flt-ops generator's CHECK half as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/gen_flt_ops_from_manifest.py run without --write. That
// script has two halves. Its check half is a gate: does the flt-ops
// slice of form/form-stdlib/form-flatten.fk equal what the manifest
// would generate. Its --write half is a WRITER: it regenerates the
// slice. Only the check is a lens; a writer is an emitter, and the
// Form emitter that rewrites the slice from nom-ops is owed (R59/R62
// territory) — until it stands, the remedy named on the error line is
// the script's own writer, in the script's words.
//
// THE INVARIANT. Read the manifest's rows in order; a row with a
// negative arity cannot ride this lane (stdlib flt-op2 folds an
// unknown arity as a quad) and refuses before anything is compared.
// Format them as flt-ops rows and read those back; read the current
// flt-ops rows. The two SEQUENCES are equal — the same triples in the
// same order. This is sharper than gate/op-manifest.bml's first check,
// which holds the two tables equal as SETS: a reordered slice passes
// there and refuses here, because the generated slice has one order,
// the manifest's.
//
// INPUTS. Both tables through their own accessors: nom-ops from
// native-op-manifest.fk, flt-ops from form-flatten.fk (the stdlib copy
// the script rewrites). The script reads both as text with a
// digits-only pattern, so a negative-arity row already sitting in the
// slice would be invisible to it and visible here; today the slice has
// none and the two readings are the same rows.
//
// EXIT. Equal: one line `flt-ops-gen: OK (<rows> rows aligned)` and the
// answer 1. Otherwise `error: flt-ops drifted from
// native-op-manifest.fk (run gen_flt_ops_from_manifest.py --write)`,
// then `flt-ops-gen: FAIL` and the answer 0 — the script's words, its
// module name replaced by this lens's. A variadic manifest row answers
// the script's ValueError text as one error line where the script dies
// in a traceback.
//
// WHERE IT RUNS. gate/drift-gates.bml has no row for this check today
// (form/validate.sh phase 0 calls the script directly; that call is
// R59's to move); adding a row would move the door's fold, so this
// lens stands as a door of its own until the row is seated with the
// validate.sh transmutation.
//
// Run directly:  ./fkwu gate/flt-ops-gen.bml          ; last line 1 / 0
// Twin:          python3 form/scripts/gen_flt_ops_from_manifest.py
// Proven by:     gate/tests/flt-ops-gen-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormFltOpsGenGate {
        thought flt-ops-gen-pattern = list("check-is-a-lens-write-is-an-emitter", "sequence-not-set", "tables-through-their-accessors", "the-writer-is-owed", "twin-voice-byte-for-byte");

        def fog-name() = "flt-ops-gen";
        def fog-drift-line() = "flt-ops drifted from native-op-manifest.fk (run gen_flt_ops_from_manifest.py --write)";
        def fog-triple(r) = list(nth(r, 0), nth(r, 1), nth(r, 2));
        def fog-negative?(r, a) = if lt(nth(r, 1), 0) then 1 else 0;
        def fog-negatives(rows) = tb-filter2(rows, fog-negative?, 0);
        def fog-same-sequence?(xs, ys) {
            if not(eq(len(xs), len(ys))) then 0
            else if eq(len(xs), 0) then 1
            else if eq(lx-triple-eq?(head(xs), head(ys)), 0) then 0
            else fog-same-sequence?(tail(xs), tail(ys));
        }
        // errors over the two tables, in the script's order: the manifest's variadic refusal, then the sequence
        def fog-errors(flt, nom) {
            let negative = fog-negatives(nom);
            if gt(len(negative), 0) then list(str_concat("variadic (arity<0) rows cannot ride the manifest lane: ", lx-py-list(tb-map(negative, fog-triple), lx-py-triple)))
            else if eq(fog-same-sequence?(tb-map(nom, fog-triple), tb-map(flt, fog-triple)), 1) then list()
            else list(fog-drift-line());
        }
        def fog-ok-line(nom) = str_concat("(", str_concat(int_to_str(len(nom)), " rows aligned)"));
        def fog-judge(flt, nom) = lx-verdict(fog-name(), fog-errors(flt, nom), fog-ok-line(nom));
        def fog-run() = fog-judge(flt-ops(), nom-ops());
    }
    fog-run();
}
