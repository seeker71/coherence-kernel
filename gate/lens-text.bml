//////////////////////////////////////////////////////////////////////
//
// gate/lens-text.bml — the text-reading floor the drift lenses share.
//
// Executable BML, an organ with no door of its own. The drift lenses the
// drift-gates door runs (op-manifest, native-surface, ontology,
// category-contract, primitive-registry, kernel-conformance, flt-ops-gen)
// are text readers: each opens a handful of source files, finds a needle,
// reads the digits after it, walks a paren-balanced block, sorts a set
// difference and prints it in Python's repr voice. This unit holds those
// motions once so each lens is only its invariant.
//
// WHAT IS HERE.
//   lx-has? / lx-count      a needle is present / how many times
//   lx-at?                  a needle stands exactly at an offset
//   lx-lines                text as rows of lines, order kept
//   lx-ints-after           every integer that follows `needle` and is
//                           closed by `close` — the (eq (fk-tag n) 12)
//                           and if (t == 63) families
//   lx-block                the paren-balanced block that begins at
//                           the first `needle` — the (defn flt-ops ()
//                           walk, depth counted from the
//                           opening paren, strings and comments unseen
//                           (a lens that saw more would judge a different
//                           text than the one its band pins)
//   lx-triple-*             rows (name arity tag): equality, Python's
//                           tuple order (name bytewise, arity, tag),
//                           insertion sort, first-occurrence dedupe,
//                           set difference
//   lx-py-*                 Python's repr voice: 'name', (a, b, c),
//                           [x, y] — the one voice every lens's
//                           offender line speaks in
//
// Every scan reads bytes through str_byte_at (no interning per step);
// only the pieces that are answered are cut. Absence stays absence:
// nothing is handed through, never turned into "".
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml
//
// Proven by: the lenses that stand on it, run live by
// ./fkwu gate/drift-gates-run.bml (gate/tests/drift-gates-band.fk holds
// the rows sound) and by gate/tests/kernel-conformance-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLensText {
        thought lens-text-pattern = list("text-is-rows", "digits-after-a-needle", "block-from-the-paren", "python-voice-on-demand", "absence-stays-absence");

        def lx-nl() = byte_to_str(10);
        def lx-host-text(v) = v ?? "";

        // ---- presence ----
        def lx-has?(text, needle) = str_find(text, needle, 0) >= 0 ? 1 : 0;
        def lx-count-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? acc : lx-count-go(text, needle, i + str_len(needle), acc + 1);
        }
        def lx-count(text, needle) = (Comparable) str_len(needle) == 0 ? 0 : lx-count-go(text, needle, 0, 0);
        def lx-at?(text, i, needle) = (i + str_len(needle)) > str_len(text) ? 0 : (String) substring(text, i, i + str_len(needle)) == needle ? 1 : 0;

        // ---- lines, order kept; a last line without its newline still counts ----
        def lx-lines(text) = lx-lines-go(text, 0, list());
        def lx-lines-go(text, from, acc) {
            let nl = str_find(text, lx-nl(), from);
            nl < 0 ? reverse(lx-lines-last(text, from, acc))
            : lx-lines-go(text, nl + 1, cons(substring(text, from, nl), acc));
        }
        def lx-lines-last(text, from, acc) = from < str_len(text) ? cons(substring(text, from, str_len(text)), acc) : acc;
        def lx-strip-nl(s) = (Comparable) str_len(s) == 0 ? s : (Comparable) str_byte_at(s, str_len(s) - 1) == 10 ? lx-strip-nl(substring(s, 0, str_len(s) - 1)) : s;

        // ---- digits ----
        def lx-digit-at?(s, i) = i >= str_len(s) ? 0 : (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? 1 : 0;
        def lx-digits-end(s, i) = (Comparable) lx-digit-at?(s, i) == 1 ? lx-digits-end(s, i + 1) : i;
        // the end of an integer with an optional leading minus; a lone minus is no integer (answers i)
        def lx-int-end(s, i) = (i < str_len(s)) && ((Comparable) str_byte_at(s, i) == 45) ? lx-int-end-signed(s, i, lx-digits-end(s, i + 1)) : lx-digits-end(s, i);
        def lx-int-end-signed(s, i, e) = (Comparable) e == (i + 1) ? i : e;
        def lx-int-span(s, a, b) = str_to_int(substring(s, a, b));

        // ---- byte classes and spans: the regex character classes the scripts lean on ----
        def lx-byte(s, i) = i >= str_len(s) ? (0 - 1) : str_byte_at(s, i);
        def lx-ws-at?(s, i) {
            let b = lx-byte(s, i);
            ((Comparable) b == 32) || (((Comparable) b == 9) || (((Comparable) b == 10) || ((Comparable) b == 13))) ? 1 : 0;
        }
        def lx-skip-ws(s, i) = (Comparable) lx-ws-at?(s, i) == 1 ? lx-skip-ws(s, i + 1) : i;
        def lx-upper-at?(s, i) {
            let b = lx-byte(s, i);
            (b >= 65) && (b <= 90) ? 1 : 0;
        }
        def lx-lower-at?(s, i) {
            let b = lx-byte(s, i);
            (b >= 97) && (b <= 122) ? 1 : 0;
        }
        def lx-alnum-at?(s, i) = ((Comparable) lx-upper-at?(s, i) == 1) || (((Comparable) lx-lower-at?(s, i) == 1) || ((Comparable) lx-digit-at?(s, i) == 1)) ? 1 : 0;
        // \w: alnum or underscore
        def lx-word-at?(s, i) = ((Comparable) lx-alnum-at?(s, i) == 1) || ((Comparable) lx-byte(s, i) == 95) ? 1 : 0;
        // [A-Z0-9_]
        def lx-upper-word-at?(s, i) = ((Comparable) lx-upper-at?(s, i) == 1) || (((Comparable) lx-digit-at?(s, i) == 1) || ((Comparable) lx-byte(s, i) == 95)) ? 1 : 0;
        def lx-span-alnum(s, i) = (Comparable) lx-alnum-at?(s, i) == 1 ? lx-span-alnum(s, i + 1) : i;
        def lx-span-upper-word(s, i) = (Comparable) lx-upper-word-at?(s, i) == 1 ? lx-span-upper-word(s, i + 1) : i;
        // \b before i: the byte before is not a word byte (the start of the text counts)
        def lx-boundary-before?(s, i) = (Comparable) i == 0 ? 1 : (Comparable) lx-word-at?(s, i - 1) == 1 ? 0 : 1;
        // Python's re.sub(r"(?<=[a-z0-9])(?=[A-Z])", "_", name).upper(): ChoiceMatch -> CHOICE_MATCH
        def lx-camel-upper(s) = lx-camel-upper-go(s, 0, "");
        def lx-camel-upper-go(s, i, acc) = i >= str_len(s) ? acc : lx-camel-upper-go(s, i + 1, acc ++ lx-camel-piece(s, i));
        def lx-camel-piece(s, i) = ((Comparable) lx-upper-at?(s, i) == 1) && lx-camel-break-before?(s, i) ? "_" ++ lx-upper-byte(s, i) : lx-upper-byte(s, i);
        def lx-camel-break-before?(s, i) = (Comparable) i == 0 ? 0 : ((Comparable) lx-lower-at?(s, i - 1) == 1) || ((Comparable) lx-digit-at?(s, i - 1) == 1) ? 1 : 0;
        def lx-upper-byte(s, i) = (Comparable) lx-lower-at?(s, i) == 1 ? byte_to_str(str_byte_at(s, i) - 32) : substring(s, i, i + 1);

        // ---- the files under a directory (source_inventory: relative path, lines), paths sorted bytewise ----
        def lx-inv-path(row) = row[0];
        def lx-files-sorted(dir, suffix) = lx-str-sort(tb-map(source_inventory(dir, suffix, list()), lx-inv-path));

        // ---- every integer that follows `needle` and is closed by `close` ----
        def lx-ints-after(text, needle, close) = lx-ints-after-go(text, needle, close, 0, list());
        def lx-ints-after-go(text, needle, close, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? reverse(acc) : lx-ints-after-at(text, needle, close, i + str_len(needle), acc);
        }
        def lx-ints-after-at(text, needle, close, a, acc) {
            let b = lx-digits-end(text, a);
            (Comparable) b == a ? lx-ints-after-go(text, needle, close, a, acc)
            : (Comparable) lx-at?(text, b, close) == 1 ? lx-ints-after-go(text, needle, close, b, cons(lx-int-span(text, a, b), acc))
            : lx-ints-after-go(text, needle, close, b, acc);
        }

        // ---- the paren-balanced block that begins at the first `needle` ----
        def lx-block-end(text, i, depth) {
            i >= str_len(text) ? i
            : (Comparable) str_byte_at(text, i) == 40 ? lx-block-end(text, i + 1, depth + 1)
            : (Comparable) str_byte_at(text, i) == 41 ? lx-block-close(text, i, depth)
            : lx-block-end(text, i + 1, depth);
        }
        def lx-block-close(text, i, depth) = depth <= 1 ? (i + 1) : lx-block-end(text, i + 1, depth - 1);
        def lx-block(text, needle) {
            let s = str_find(text, needle, 0);
            s < 0 ? "" : substring(text, s, lx-block-end(text, s, 0));
        }
        def lx-block-from(text, s) = substring(text, s, lx-block-end(text, s, 0));
        // the same walk with strings unseen: a " toggles the string unless a \ precedes it (the registry script's walker)
        def lx-sblock-end(text, i, depth, instr) {
            i >= str_len(text) ? i
            : (Comparable) instr == 1 ? lx-sblock-end(text, i + 1, depth, ((Comparable) str_byte_at(text, i) == 34) && (!((Comparable) lx-byte(text, i - 1) == 92)) ? 0 : 1)
            : (Comparable) str_byte_at(text, i) == 34 ? lx-sblock-end(text, i + 1, depth, 1)
            : (Comparable) str_byte_at(text, i) == 40 ? lx-sblock-end(text, i + 1, depth + 1, 0)
            : (Comparable) str_byte_at(text, i) == 41 ? lx-sblock-close-s(text, i, depth)
            : lx-sblock-end(text, i + 1, depth, 0);
        }
        def lx-sblock-close-s(text, i, depth) = depth <= 1 ? (i + 1) : lx-sblock-end(text, i + 1, depth - 1, 0);
        def lx-sblock-from(text, s) = substring(text, s, lx-sblock-end(text, s, 0, 0));
        // all whitespace (or empty): Python's not s.strip()
        def lx-blank?(s) = (Comparable) lx-skip-ws(s, 0) == str_len(s) ? 1 : 0;
        def lx-strip(s) = lx-strip-end(s, lx-skip-ws(s, 0), str_len(s));
        def lx-strip-end(s, a, b) = b <= a ? "" : (Comparable) lx-ws-at?(s, b - 1) == 1 ? lx-strip-end(s, a, b - 1) : substring(s, a, b);
        def lx-head-bytes(s, n) = str_len(s) < n ? s : substring(s, 0, n);

        // ---- ints as a set ----
        def lx-int-in?(xs, n) = (Comparable) len(xs) == 0 ? 0 : (Comparable) head(xs) == n ? 1 : lx-int-in?(tail(xs), n);
        def lx-int-uniq-go(xs, acc) = (Comparable) len(xs) == 0 ? reverse(acc) : lx-int-uniq-go(tail(xs), (Comparable) lx-int-in?(acc, head(xs)) == 1 ? acc : cons(head(xs), acc));
        def lx-int-uniq(xs) = lx-int-uniq-go(xs, list());
        def lx-int-max(xs, best) = (Comparable) len(xs) == 0 ? best : lx-int-max(tail(xs), head(xs) > best ? head(xs) : best);
        def lx-int-insert(n, sorted) = (Comparable) len(sorted) == 0 ? list(n) : n < head(sorted) ? cons(n, sorted) : cons(head(sorted), lx-int-insert(n, tail(sorted)));
        def lx-int-sort-go(xs, acc) = (Comparable) len(xs) == 0 ? acc : lx-int-sort-go(tail(xs), lx-int-insert(head(xs), acc));
        def lx-int-sort(xs) = lx-int-sort-go(xs, list());

        // ---- strings bytewise, Python's order for ASCII names ----
        def lx-str-lt-go(a, b, i) {
            i >= str_len(a) ? lx-str-lt-ended(i, b)
            : i >= str_len(b) ? 0
            : str_byte_at(a, i) < str_byte_at(b, i) ? 1
            : str_byte_at(a, i) > str_byte_at(b, i) ? 0
            : lx-str-lt-go(a, b, i + 1);
        }
        // a ran out first: a is less exactly when b still has bytes
        def lx-str-lt-ended(i, b) = i < str_len(b) ? 1 : 0;
        def lx-str-lt?(a, b) = lx-str-lt-go(a, b, 0);
        def lx-str-in?(xs, s) = (Comparable) len(xs) == 0 ? 0 : (String) head(xs) == s ? 1 : lx-str-in?(tail(xs), s);
        def lx-str-insert(s, sorted) = (Comparable) len(sorted) == 0 ? list(s) : (Comparable) lx-str-lt?(s, head(sorted)) == 1 ? cons(s, sorted) : cons(head(sorted), lx-str-insert(s, tail(sorted)));
        def lx-str-sort-go(xs, acc) = (Comparable) len(xs) == 0 ? acc : lx-str-sort-go(tail(xs), lx-str-insert(head(xs), acc));
        def lx-str-sort(xs) = lx-str-sort-go(xs, list());
        def lx-str-uniq-go(xs, acc) = (Comparable) len(xs) == 0 ? reverse(acc) : lx-str-uniq-go(tail(xs), (Comparable) lx-str-in?(acc, head(xs)) == 1 ? acc : cons(head(xs), acc));
        def lx-str-uniq(xs) = lx-str-uniq-go(xs, list());
        def lx-str-minus(xs, ys) = tb-filter2(xs, lx-str-absent?, ys);
        def lx-str-absent?(s, ys) = (Comparable) lx-str-in?(ys, s) == 1 ? 0 : 1;
        def lx-str-common(xs, ys) = tb-filter2(xs, lx-str-present?, ys);
        def lx-str-present?(s, ys) = lx-str-in?(ys, s);

        // ---- rows (name arity tag ...): the first three fields are the triple ----
        def lx-triple-name(r) = r[0];
        def lx-triple-arity(r) = r[1];
        def lx-triple-tag(r) = r[2];
        def lx-triple-eq?(r, s) = (((String) r[0] == s[0]) && ((Comparable) r[1] == s[1])) && ((Comparable) r[2] == s[2]) ? 1 : 0;
        def lx-triple-lt?(r, s) {
            (Comparable) lx-str-lt?(r[0], s[0]) == 1 ? 1
            : (Comparable) lx-str-lt?(s[0], r[0]) == 1 ? 0
            : r[1] < s[1] ? 1
            : r[1] > s[1] ? 0
            : r[2] < s[2] ? 1 : 0;
        }
        def lx-triple-in?(rows, r) = (Comparable) len(rows) == 0 ? 0 : (Comparable) lx-triple-eq?(head(rows), r) == 1 ? 1 : lx-triple-in?(tail(rows), r);
        def lx-triple-absent?(r, rows) = (Comparable) lx-triple-in?(rows, r) == 1 ? 0 : 1;
        def lx-triple-minus(xs, ys) = tb-filter2(xs, lx-triple-absent?, ys);
        def lx-triple-uniq-go(xs, acc) = (Comparable) len(xs) == 0 ? reverse(acc) : lx-triple-uniq-go(tail(xs), (Comparable) lx-triple-in?(acc, head(xs)) == 1 ? acc : cons(head(xs), acc));
        def lx-triple-uniq(xs) = lx-triple-uniq-go(xs, list());
        def lx-triple-insert(r, sorted) = (Comparable) len(sorted) == 0 ? list(r) : (Comparable) lx-triple-lt?(r, head(sorted)) == 1 ? cons(r, sorted) : cons(head(sorted), lx-triple-insert(r, tail(sorted)));
        def lx-triple-sort-go(xs, acc) = (Comparable) len(xs) == 0 ? acc : lx-triple-sort-go(tail(xs), lx-triple-insert(head(xs), acc));
        def lx-triple-sort(xs) = lx-triple-sort-go(xs, list());
        // Python's sorted(set(a) - set(b))
        def lx-triple-diff(xs, ys) = lx-triple-sort(lx-triple-uniq(lx-triple-minus(xs, ys)));
        def lx-triple-name-in?(rows, name) = (Comparable) len(rows) == 0 ? 0 : (String) head(rows)[0] == name ? 1 : lx-triple-name-in?(tail(rows), name);
        def lx-triple-any-negative?(rows) = (Comparable) len(rows) == 0 ? 0 : head(rows)[1] < 0 ? 1 : lx-triple-any-negative?(tail(rows));

        // ---- Python's repr voice ----
        def lx-py-str(s) = "'" ++ s ++ "'";
        def lx-py-triple(r) = "(" ++ lx-py-str(r[0]) ++ ", " ++ int_to_str(r[1]) ++ ", " ++ int_to_str(r[2]) ++ ")";
        def lx-py-list(rows, f) = "[" ++ tb-join(rows, f, ", ") ++ "]";
        def lx-py-str-list(xs) = lx-py-list(xs, lx-py-str);
        // {sorted_list[:5]}...  — the scripts' way of naming the first five offenders
        def lx-py-head5(rows, f) = lx-py-list(take(5, rows), f) ++ "...";

        // ---- a child through the membrane: list(rc, output). The command runs in a subshell, its exit
        //      code rides the last line as @rc=N (the drift-gates carrier's shape); a launch that answers
        //      nothing reads rc -1. lx-sh folds stderr into the output; lx-sh-out keeps stdout alone. ----
        def lx-rfind-go(s, needle, from, last) {
            let i = str_find(s, needle, from);
            i < 0 ? last : lx-rfind-go(s, needle, i + 1, i);
        }
        def lx-rfind(s, needle) = lx-rfind-go(s, needle, 0, 0 - 1);
        def lx-sh-mark() = "@rc=";
        def lx-sh-wrap(command, stderr) = "( " ++ command ++ " ) " ++ stderr ++ "; echo " ++ lx-sh-mark() ++ "$?";
        def lx-sh-read(out) {
            nothing?(out) ? list(0 - 1, "launch vanished") : lx-sh-split(out, lx-rfind(out, lx-sh-mark()));
        }
        def lx-sh-split(out, at) = at < 0 ? list(0 - 1, out) : list(lx-int-span(out, at + str_len(lx-sh-mark()), lx-digits-end(out, at + str_len(lx-sh-mark()))), lx-strip-nl(substring(out, 0, at)));
        def lx-sh(command) = lx-sh-read(host-exec(lx-sh-wrap(command, "2>&1"), ""));
        def lx-sh-out(command) = lx-sh-read(host-exec(lx-sh-wrap(command, "2>/dev/null"), ""));
        def lx-sh-rc(r) = r[0];
        def lx-sh-text(r) = r[1];

        def lx-py-int-list(xs) = lx-py-list(xs, int_to_str);

        // ---- the voice every lens speaks: "warn: ..." rows, then "error: ..." rows, then NAME: FAIL <failline>; or NAME: OK <okline> ----
        def lx-print-prefixed(prefix, rows) = (Comparable) len(rows) == 0 ? 0 : lx-print-prefixed-one(prefix, head(rows), tail(rows));
        def lx-print-prefixed-one(prefix, r, rest) {
            print(prefix ++ r);
            lx-print-prefixed(prefix, rest);
        }
        def lx-print-errors(errors) = lx-print-prefixed("error: ", errors);
        def lx-print-warnings(warnings) = lx-print-prefixed("warn: ", warnings);
        def lx-verdict(name, errors, okline) = lx-verdict-full(name, list(), errors, okline, "");
        def lx-verdict-full(name, warnings, errors, okline, failline) {
            lx-print-warnings(warnings);
            (Comparable) len(errors) == 0 ? lx-verdict-ok(name, okline) : lx-verdict-fail(name, errors, failline);
        }
        def lx-verdict-ok(name, okline) {
            print(name ++ ": OK " ++ okline);
            1;
        }
        def lx-verdict-fail(name, errors, failline) {
            lx-print-errors(errors);
            print(name ++ ((Comparable) str_len(failline) == 0 ? ": FAIL" : ": FAIL " ++ failline));
            0;
        }
    }
    0;
}
