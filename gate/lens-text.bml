//////////////////////////////////////////////////////////////////////
//
// gate/lens-text.bml — the text-reading floor the drift lenses share.
//
// Executable BML, an organ with no door of its own. R58 in the release
// ledger turns the Python drift gates in form/scripts into Form lenses
// the drift-gates door runs natively. Every one of those scripts is a
// text reader: it opens a handful of source files, finds a needle,
// reads the digits after it, walks a paren-balanced block, sorts a set
// difference and prints it in Python's own voice. This unit holds those
// motions once so each lens is only its invariant.
//
// WHAT IS HERE.
//   lx-has? / lx-count      a needle is present / how many times
//   lx-at?                  a needle stands exactly at an offset
//   lx-lines                text as rows of lines, order kept
//   lx-ints-after           every integer that follows `needle` and is
//                           closed by `close` — the (eq (fk-tag n) 12)
//                           and if (t == 63) families
//   lx-block                the paren-balanced block that begins at
//                           the first `needle` — the (defn flt-ops ()
//                           walk the scripts do, depth counted from the
//                           opening paren, strings and comments unseen
//                           (the scripts are equally blind; a lens that
//                           saw more would judge a different text)
//   lx-triple-*             rows (name arity tag): equality, Python's
//                           tuple order (name bytewise, arity, tag),
//                           insertion sort, first-occurrence dedupe,
//                           set difference
//   lx-py-*                 Python's repr voice: 'name', (a, b, c),
//                           [x, y] — so a lens's offender line can be
//                           compared byte for byte with the script it
//                           replaces while that script still stands
//   lx-replace-prefix       one renaming, for that same comparison
//
// Every scan reads bytes through str_byte_at (no interning per step);
// only the pieces that are answered are cut. Absence stays absence:
// nothing is handed through, never turned into "".
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml
//
// Proven by: gate/tests/op-manifest-band.fk (the first lens on this floor)
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLensText {
        thought lens-text-pattern = list("text-is-rows", "digits-after-a-needle", "block-from-the-paren", "python-voice-on-demand", "absence-stays-absence");

        def lx-nl() = byte_to_str(10);
        def lx-host-text(v) = if nothing?(v) then "" else v;

        // ---- presence ----
        def lx-has?(text, needle) = if ge(str_find(text, needle, 0), 0) then 1 else 0;
        def lx-count-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            if lt(i, 0) then acc else lx-count-go(text, needle, add(i, str_len(needle)), add(acc, 1));
        }
        def lx-count(text, needle) = if eq(str_len(needle), 0) then 0 else lx-count-go(text, needle, 0, 0);
        def lx-at?(text, i, needle) = if gt(add(i, str_len(needle)), str_len(text)) then 0 else if str_eq(substring(text, i, add(i, str_len(needle))), needle) then 1 else 0;

        // ---- lines, order kept; a last line without its newline still counts ----
        def lx-lines(text) = lx-lines-go(text, 0, list());
        def lx-lines-go(text, from, acc) {
            let nl = str_find(text, lx-nl(), from);
            if lt(nl, 0) then reverse(lx-lines-last(text, from, acc))
            else lx-lines-go(text, add(nl, 1), cons(substring(text, from, nl), acc));
        }
        def lx-lines-last(text, from, acc) = if lt(from, str_len(text)) then cons(substring(text, from, str_len(text)), acc) else acc;
        def lx-strip-nl(s) = if eq(str_len(s), 0) then s else if eq(str_byte_at(s, sub(str_len(s), 1)), 10) then lx-strip-nl(substring(s, 0, sub(str_len(s), 1))) else s;

        // ---- digits ----
        def lx-digit-at?(s, i) = if ge(i, str_len(s)) then 0 else if and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)) then 1 else 0;
        def lx-digits-end(s, i) = if eq(lx-digit-at?(s, i), 1) then lx-digits-end(s, add(i, 1)) else i;
        // the end of an integer with an optional leading minus; a lone minus is no integer (answers i)
        def lx-int-end(s, i) = if and(lt(i, str_len(s)), eq(str_byte_at(s, i), 45)) then lx-int-end-signed(s, i, lx-digits-end(s, add(i, 1))) else lx-digits-end(s, i);
        def lx-int-end-signed(s, i, e) = if eq(e, add(i, 1)) then i else e;
        def lx-int-span(s, a, b) = str_to_int(substring(s, a, b));

        // ---- byte classes and spans: the regex character classes the scripts lean on ----
        def lx-byte(s, i) = if ge(i, str_len(s)) then sub(0, 1) else str_byte_at(s, i);
        def lx-ws-at?(s, i) {
            let b = lx-byte(s, i);
            if or(eq(b, 32), or(eq(b, 9), or(eq(b, 10), eq(b, 13)))) then 1 else 0;
        }
        def lx-skip-ws(s, i) = if eq(lx-ws-at?(s, i), 1) then lx-skip-ws(s, add(i, 1)) else i;
        def lx-upper-at?(s, i) {
            let b = lx-byte(s, i);
            if and(ge(b, 65), le(b, 90)) then 1 else 0;
        }
        def lx-lower-at?(s, i) {
            let b = lx-byte(s, i);
            if and(ge(b, 97), le(b, 122)) then 1 else 0;
        }
        def lx-alnum-at?(s, i) = if or(eq(lx-upper-at?(s, i), 1), or(eq(lx-lower-at?(s, i), 1), eq(lx-digit-at?(s, i), 1))) then 1 else 0;
        // \w: alnum or underscore
        def lx-word-at?(s, i) = if or(eq(lx-alnum-at?(s, i), 1), eq(lx-byte(s, i), 95)) then 1 else 0;
        // [A-Z0-9_]
        def lx-upper-word-at?(s, i) = if or(eq(lx-upper-at?(s, i), 1), or(eq(lx-digit-at?(s, i), 1), eq(lx-byte(s, i), 95))) then 1 else 0;
        def lx-span-alnum(s, i) = if eq(lx-alnum-at?(s, i), 1) then lx-span-alnum(s, add(i, 1)) else i;
        def lx-span-upper-word(s, i) = if eq(lx-upper-word-at?(s, i), 1) then lx-span-upper-word(s, add(i, 1)) else i;
        // \b before i: the byte before is not a word byte (the start of the text counts)
        def lx-boundary-before?(s, i) = if eq(i, 0) then 1 else if eq(lx-word-at?(s, sub(i, 1)), 1) then 0 else 1;
        // Python's re.sub(r"(?<=[a-z0-9])(?=[A-Z])", "_", name).upper(): ChoiceMatch -> CHOICE_MATCH
        def lx-camel-upper(s) = lx-camel-upper-go(s, 0, "");
        def lx-camel-upper-go(s, i, acc) = if ge(i, str_len(s)) then acc else lx-camel-upper-go(s, add(i, 1), str_concat(acc, lx-camel-piece(s, i)));
        def lx-camel-piece(s, i) = if and(eq(lx-upper-at?(s, i), 1), lx-camel-break-before?(s, i)) then str_concat("_", lx-upper-byte(s, i)) else lx-upper-byte(s, i);
        def lx-camel-break-before?(s, i) = if eq(i, 0) then 0 else if or(eq(lx-lower-at?(s, sub(i, 1)), 1), eq(lx-digit-at?(s, sub(i, 1)), 1)) then 1 else 0;
        def lx-upper-byte(s, i) = if eq(lx-lower-at?(s, i), 1) then byte_to_str(sub(str_byte_at(s, i), 32)) else substring(s, i, add(i, 1));

        // ---- the files under a directory (source_inventory: relative path, lines), paths sorted bytewise ----
        def lx-inv-path(row) = nth(row, 0);
        def lx-files-sorted(dir, suffix) = lx-str-sort(tb-map(source_inventory(dir, suffix, list()), lx-inv-path));

        // ---- every integer that follows `needle` and is closed by `close` ----
        def lx-ints-after(text, needle, close) = lx-ints-after-go(text, needle, close, 0, list());
        def lx-ints-after-go(text, needle, close, from, acc) {
            let i = str_find(text, needle, from);
            if lt(i, 0) then reverse(acc) else lx-ints-after-at(text, needle, close, add(i, str_len(needle)), acc);
        }
        def lx-ints-after-at(text, needle, close, a, acc) {
            let b = lx-digits-end(text, a);
            if eq(b, a) then lx-ints-after-go(text, needle, close, a, acc)
            else if eq(lx-at?(text, b, close), 1) then lx-ints-after-go(text, needle, close, b, cons(lx-int-span(text, a, b), acc))
            else lx-ints-after-go(text, needle, close, b, acc);
        }

        // ---- the paren-balanced block that begins at the first `needle` ----
        def lx-block-end(text, i, depth) {
            if ge(i, str_len(text)) then i
            else if eq(str_byte_at(text, i), 40) then lx-block-end(text, add(i, 1), add(depth, 1))
            else if eq(str_byte_at(text, i), 41) then lx-block-close(text, i, depth)
            else lx-block-end(text, add(i, 1), depth);
        }
        def lx-block-close(text, i, depth) = if le(depth, 1) then add(i, 1) else lx-block-end(text, add(i, 1), sub(depth, 1));
        def lx-block(text, needle) {
            let s = str_find(text, needle, 0);
            if lt(s, 0) then "" else substring(text, s, lx-block-end(text, s, 0));
        }
        def lx-block-from(text, s) = substring(text, s, lx-block-end(text, s, 0));
        // the same walk with strings unseen: a " toggles the string unless a \ precedes it (the registry script's walker)
        def lx-sblock-end(text, i, depth, instr) {
            if ge(i, str_len(text)) then i
            else if eq(instr, 1) then lx-sblock-end(text, add(i, 1), depth, if and(eq(str_byte_at(text, i), 34), not(eq(lx-byte(text, sub(i, 1)), 92))) then 0 else 1)
            else if eq(str_byte_at(text, i), 34) then lx-sblock-end(text, add(i, 1), depth, 1)
            else if eq(str_byte_at(text, i), 40) then lx-sblock-end(text, add(i, 1), add(depth, 1), 0)
            else if eq(str_byte_at(text, i), 41) then lx-sblock-close-s(text, i, depth)
            else lx-sblock-end(text, add(i, 1), depth, 0);
        }
        def lx-sblock-close-s(text, i, depth) = if le(depth, 1) then add(i, 1) else lx-sblock-end(text, add(i, 1), sub(depth, 1), 0);
        def lx-sblock-from(text, s) = substring(text, s, lx-sblock-end(text, s, 0, 0));
        // all whitespace (or empty): Python's not s.strip()
        def lx-blank?(s) = if eq(lx-skip-ws(s, 0), str_len(s)) then 1 else 0;
        def lx-strip(s) = lx-strip-end(s, lx-skip-ws(s, 0), str_len(s));
        def lx-strip-end(s, a, b) = if le(b, a) then "" else if eq(lx-ws-at?(s, sub(b, 1)), 1) then lx-strip-end(s, a, sub(b, 1)) else substring(s, a, b);
        def lx-head-bytes(s, n) = if lt(str_len(s), n) then s else substring(s, 0, n);

        // ---- ints as a set ----
        def lx-int-in?(xs, n) = if eq(len(xs), 0) then 0 else if eq(head(xs), n) then 1 else lx-int-in?(tail(xs), n);
        def lx-int-uniq-go(xs, acc) = if eq(len(xs), 0) then reverse(acc) else lx-int-uniq-go(tail(xs), if eq(lx-int-in?(acc, head(xs)), 1) then acc else cons(head(xs), acc));
        def lx-int-uniq(xs) = lx-int-uniq-go(xs, list());
        def lx-int-max(xs, best) = if eq(len(xs), 0) then best else lx-int-max(tail(xs), if gt(head(xs), best) then head(xs) else best);
        def lx-int-insert(n, sorted) = if eq(len(sorted), 0) then list(n) else if lt(n, head(sorted)) then cons(n, sorted) else cons(head(sorted), lx-int-insert(n, tail(sorted)));
        def lx-int-sort-go(xs, acc) = if eq(len(xs), 0) then acc else lx-int-sort-go(tail(xs), lx-int-insert(head(xs), acc));
        def lx-int-sort(xs) = lx-int-sort-go(xs, list());

        // ---- strings bytewise, Python's order for ASCII names ----
        def lx-str-lt-go(a, b, i) {
            if ge(i, str_len(a)) then lx-str-lt-ended(i, b)
            else if ge(i, str_len(b)) then 0
            else if lt(str_byte_at(a, i), str_byte_at(b, i)) then 1
            else if gt(str_byte_at(a, i), str_byte_at(b, i)) then 0
            else lx-str-lt-go(a, b, add(i, 1));
        }
        // a ran out first: a is less exactly when b still has bytes
        def lx-str-lt-ended(i, b) = if lt(i, str_len(b)) then 1 else 0;
        def lx-str-lt?(a, b) = lx-str-lt-go(a, b, 0);
        def lx-str-in?(xs, s) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), s) then 1 else lx-str-in?(tail(xs), s);
        def lx-str-insert(s, sorted) = if eq(len(sorted), 0) then list(s) else if eq(lx-str-lt?(s, head(sorted)), 1) then cons(s, sorted) else cons(head(sorted), lx-str-insert(s, tail(sorted)));
        def lx-str-sort-go(xs, acc) = if eq(len(xs), 0) then acc else lx-str-sort-go(tail(xs), lx-str-insert(head(xs), acc));
        def lx-str-sort(xs) = lx-str-sort-go(xs, list());
        def lx-str-uniq-go(xs, acc) = if eq(len(xs), 0) then reverse(acc) else lx-str-uniq-go(tail(xs), if eq(lx-str-in?(acc, head(xs)), 1) then acc else cons(head(xs), acc));
        def lx-str-uniq(xs) = lx-str-uniq-go(xs, list());
        def lx-str-minus(xs, ys) = tb-filter2(xs, lx-str-absent?, ys);
        def lx-str-absent?(s, ys) = if eq(lx-str-in?(ys, s), 1) then 0 else 1;
        def lx-str-common(xs, ys) = tb-filter2(xs, lx-str-present?, ys);
        def lx-str-present?(s, ys) = lx-str-in?(ys, s);

        // ---- rows (name arity tag ...): the first three fields are the triple ----
        def lx-triple-name(r) = nth(r, 0);
        def lx-triple-arity(r) = nth(r, 1);
        def lx-triple-tag(r) = nth(r, 2);
        def lx-triple-eq?(r, s) = if and(and(str_eq(nth(r, 0), nth(s, 0)), eq(nth(r, 1), nth(s, 1))), eq(nth(r, 2), nth(s, 2))) then 1 else 0;
        def lx-triple-lt?(r, s) {
            if eq(lx-str-lt?(nth(r, 0), nth(s, 0)), 1) then 1
            else if eq(lx-str-lt?(nth(s, 0), nth(r, 0)), 1) then 0
            else if lt(nth(r, 1), nth(s, 1)) then 1
            else if gt(nth(r, 1), nth(s, 1)) then 0
            else if lt(nth(r, 2), nth(s, 2)) then 1 else 0;
        }
        def lx-triple-in?(rows, r) = if eq(len(rows), 0) then 0 else if eq(lx-triple-eq?(head(rows), r), 1) then 1 else lx-triple-in?(tail(rows), r);
        def lx-triple-absent?(r, rows) = if eq(lx-triple-in?(rows, r), 1) then 0 else 1;
        def lx-triple-minus(xs, ys) = tb-filter2(xs, lx-triple-absent?, ys);
        def lx-triple-uniq-go(xs, acc) = if eq(len(xs), 0) then reverse(acc) else lx-triple-uniq-go(tail(xs), if eq(lx-triple-in?(acc, head(xs)), 1) then acc else cons(head(xs), acc));
        def lx-triple-uniq(xs) = lx-triple-uniq-go(xs, list());
        def lx-triple-insert(r, sorted) = if eq(len(sorted), 0) then list(r) else if eq(lx-triple-lt?(r, head(sorted)), 1) then cons(r, sorted) else cons(head(sorted), lx-triple-insert(r, tail(sorted)));
        def lx-triple-sort-go(xs, acc) = if eq(len(xs), 0) then acc else lx-triple-sort-go(tail(xs), lx-triple-insert(head(xs), acc));
        def lx-triple-sort(xs) = lx-triple-sort-go(xs, list());
        // Python's sorted(set(a) - set(b))
        def lx-triple-diff(xs, ys) = lx-triple-sort(lx-triple-uniq(lx-triple-minus(xs, ys)));
        def lx-triple-name-in?(rows, name) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 0), name) then 1 else lx-triple-name-in?(tail(rows), name);
        def lx-triple-any-negative?(rows) = if eq(len(rows), 0) then 0 else if lt(nth(head(rows), 1), 0) then 1 else lx-triple-any-negative?(tail(rows));

        // ---- Python's repr voice ----
        def lx-py-str(s) = str_concat("'", str_concat(s, "'"));
        def lx-py-triple(r) = str_concat("(", str_concat(lx-py-str(nth(r, 0)), str_concat(", ", str_concat(int_to_str(nth(r, 1)), str_concat(", ", str_concat(int_to_str(nth(r, 2)), ")"))))));
        def lx-py-list(rows, f) = str_concat("[", str_concat(tb-join(rows, f, ", "), "]"));
        def lx-py-str-list(xs) = lx-py-list(xs, lx-py-str);
        // {sorted_list[:5]}...  — the scripts' way of naming the first five offenders
        def lx-py-head5(rows, f) = str_concat(lx-py-list(take(5, rows), f), "...");

        // ---- a child through the membrane: list(rc, output). The command runs in a subshell, its exit
        //      code rides the last line as @rc=N (the drift-gates carrier's shape); a launch that answers
        //      nothing reads rc -1. lx-sh folds stderr into the output; lx-sh-out keeps stdout alone. ----
        def lx-rfind-go(s, needle, from, last) {
            let i = str_find(s, needle, from);
            if lt(i, 0) then last else lx-rfind-go(s, needle, add(i, 1), i);
        }
        def lx-rfind(s, needle) = lx-rfind-go(s, needle, 0, sub(0, 1));
        def lx-sh-mark() = "@rc=";
        def lx-sh-wrap(command, stderr) = str_concat("( ", str_concat(command, str_concat(" ) ", str_concat(stderr, str_concat("; echo ", str_concat(lx-sh-mark(), "$?"))))));
        def lx-sh-read(out) {
            if nothing?(out) then list(sub(0, 1), "launch vanished") else lx-sh-split(out, lx-rfind(out, lx-sh-mark()));
        }
        def lx-sh-split(out, at) = if lt(at, 0) then list(sub(0, 1), out) else list(lx-int-span(out, add(at, str_len(lx-sh-mark())), lx-digits-end(out, add(at, str_len(lx-sh-mark())))), lx-strip-nl(substring(out, 0, at)));
        def lx-sh(command) = lx-sh-read(host-exec(lx-sh-wrap(command, "2>&1"), ""));
        def lx-sh-out(command) = lx-sh-read(host-exec(lx-sh-wrap(command, "2>/dev/null"), ""));
        def lx-sh-rc(r) = nth(r, 0);
        def lx-sh-text(r) = nth(r, 1);

        // ---- one renaming, for comparing a lens's voice with its twin's ----
        def lx-replace-prefix(s, old, new) = if eq(lx-at?(s, 0, old), 1) then str_concat(new, substring(s, str_len(old), str_len(s))) else s;

        def lx-py-int-list(xs) = lx-py-list(xs, int_to_str);

        // ---- the voice every lens speaks: "warn: ..." rows, then "error: ..." rows, then NAME: FAIL <failline>; or NAME: OK <okline> ----
        def lx-print-prefixed(prefix, rows) = if eq(len(rows), 0) then 0 else lx-print-prefixed-one(prefix, head(rows), tail(rows));
        def lx-print-prefixed-one(prefix, r, rest) {
            print(str_concat(prefix, r));
            lx-print-prefixed(prefix, rest);
        }
        def lx-print-errors(errors) = lx-print-prefixed("error: ", errors);
        def lx-print-warnings(warnings) = lx-print-prefixed("warn: ", warnings);
        def lx-verdict(name, errors, okline) = lx-verdict-full(name, list(), errors, okline, "");
        def lx-verdict-full(name, warnings, errors, okline, failline) {
            lx-print-warnings(warnings);
            if eq(len(errors), 0) then lx-verdict-ok(name, okline) else lx-verdict-fail(name, errors, failline);
        }
        def lx-verdict-ok(name, okline) {
            print(str_concat(name, str_concat(": OK ", okline)));
            1;
        }
        def lx-verdict-fail(name, errors, failline) {
            lx-print-errors(errors);
            print(str_concat(name, if eq(str_len(failline), 0) then ": FAIL" else str_concat(": FAIL ", failline)));
            0;
        }
    }
    0;
}
