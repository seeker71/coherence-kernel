//////////////////////////////////////////////////////////////////////
//
// drift-gates-run.bml — the door for gate/drift-gates.bml.
//
// Run from the repository root:
//
//   ./fkwu gate/drift-gates-run.bml
//
// One line per gate row, then the summary line, then the pass fold.
// As a process gate (nonzero exit when any gate refuses, or when the
// door never answers):
//
//   ./fkwu gate/drift-gates-run.bml | tee /dev/stderr | grep -q ' refused=0 '
//
// The rows live in gate/drift-gates.bml (dg-rows); adding a gate is
// adding a row there. This unit only opens the door.
//
// preludes: gate/drift-gates.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    dg-report();
}
