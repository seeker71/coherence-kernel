// Native Form lens for registry, implementation and band-count agreement.
// Historical implementation comparisons live in git.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml
section [form.bml] {
    class FormPrimitiveRegistryGate {
        thought primitive-registry-pattern = list("registry-is-the-body-main-go-the-surface", "cells-read-as-the-script-reads-them", "lane-1-needs-three-kernels", "pins-equal-counts", "membrane-crossed-once-on-the-red-path", "twin-voice-byte-for-byte");

        def prg-name() = "primitive-registry";
        def prg-go-main() = "form/form-kernel-go/main.go";
        def prg-go-server() = "form/form-kernel-go/server.go";
        def prg-rs-main() = "form/form-kernel-rust/src/main.rs";
        def prg-ts-kernel() = "form/form-kernel-ts/src/kernel.ts";
        def prg-registry() = "form/form-stdlib/primitive-registry.fk";
        def prg-band() = "form/form-stdlib/tests/primitive-registry-band.fk";
        def prg-tests-glob() = "form/form-stdlib/tests/*.fk";
        def prg-cat(constructor, token) = list(constructor, token);
        def prg-cats() = list(prg-cat("catCall", "call"), prg-cat("catAccess", "access"), prg-cat("catMethod", "method"), prg-cat("catCompare", "compare"), prg-cat("catListNat", "list"), prg-cat("catWitness", "witness"), prg-cat("catUndefined", "undefined"));
        // the token of a Go constructor, or "" when it has none
        def prg-token-of(c) {
            let row = tb-first(prg-cats(), r => (String) r[0] == c) ?? list();
            (Comparable) len(row) == 0 ? "" : row[1];
        }
        def prg-when(cond, msg) = cond ? list(msg) : list();

        // ---- (name, token) rows ----
        def prg-row-name(r) = r[0];
        def prg-row-token(r) = r[1];
        def prg-lookup(rows, name) = tb-first(rows, r => (String) r[0] == name) ?? list();
        def prg-has?(rows, name) = (Comparable) len(prg-lookup(rows, name)) == 0 ? 0 : 1;
        def prg-absent?(name, rows) = (Comparable) prg-has?(rows, name) == 1 ? 0 : 1;
        def prg-present?(name, rows) = prg-has?(rows, name);
        def prg-names(rows) = tb-map(rows, prg-row-name);

        // ---- a quoted name at i: "name" -> list(name, end-after-quote) or list() ----
        def prg-quoted(text, i) {
            (Comparable) lx-at?(text, i, "\"") == 0 ? list() : prg-quoted-end(text, i + 1, str_find(text, "\"", i + 1));
        }
        def prg-quoted-end(text, a, b) = b < 0 ? list() : (Comparable) b == a ? list() : list(substring(text, a, b), b + 1);

        // ---- Go: list(rows(name token), dups) ----
        // k.registerNative(\s*"name",\s*(cat[A-Za-z]+)\(  and  k.registerEnvNative(...) — the same shape
        def prg-go-calls(text, needle, keep-field?) = prg-go-calls-go(text, needle, keep-field?, 0, list());
        def prg-go-calls-go(text, needle, keep-field?, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? reverse(acc) : prg-go-calls-go(text, needle, keep-field?, i + 1, prg-go-call-at(text, lx-skip-ws(text, i + str_len(needle)), keep-field?, acc));
        }
        def prg-go-call-at(text, i, keep-field?, acc) {
            let q = prg-quoted(text, i);
            (Comparable) len(q) == 0 ? acc : (Comparable) lx-at?(text, q[1], ",") == 0 ? acc : prg-go-call-cat(text, q[0], lx-skip-ws(text, q[1] + 1), keep-field?, acc);
        }
        def prg-go-call-cat(text, name, k, keep-field?, acc) {
            let e = prg-span-alpha(text, k + 3);
            (Comparable) lx-at?(text, k, "cat") == 0 ? acc
            : (Comparable) lx-at?(text, e, "(") == 0 ? acc
            : prg-go-call-row(name, substring(text, k, e), keep-field?, acc);
        }
        def prg-span-alpha(s, i) = ((Comparable) lx-upper-at?(s, i) == 1) || ((Comparable) lx-lower-at?(s, i) == 1) ? prg-span-alpha(s, i + 1) : i;
        // registerNative: a constructor without a token is kept raw, except catFieldPrimitive (the table loop line); registerEnvNative keeps every raw
        def prg-go-call-row(name, c, keep-field?, acc) {
            let token = prg-token-of(c);
            ((Comparable) str_len(token) == 0) && (((Comparable) keep-field? == 0) && ((String) c == "catFieldPrimitive")) ? acc
            : cons(list(name, (Comparable) str_len(token) == 0 ? c : token), acc);
        }
        // the fieldConstructors table: from `fieldConstructors := []struct {` to the first "\n\t}\n"; rows {"name",
        def prg-go-field-rows(text) {
            let a = str_find(text, "fieldConstructors := []struct {", 0);
            a < 0 ? list() : prg-go-field-rows-in(prg-go-field-block(text, a));
        }
        def prg-go-field-block(text, a) {
            let b = str_find(text, lx-nl() ++ byte_to_str(9) ++ "}" ++ lx-nl(), a);
            substring(text, a, b < 0 ? str_len(text) : (b + 4));
        }
        def prg-go-field-rows-in(block) = prg-go-field-go(block, 0, list());
        def prg-go-field-go(block, from, acc) {
            let i = str_find(block, "{\"", from);
            i < 0 ? reverse(acc) : prg-go-field-go(block, i + 1, prg-go-field-at(block, i + 2, acc));
        }
        def prg-go-field-at(block, a, acc) {
            let e = prg-span-lower-word(block, a);
            (Comparable) e == a ? acc : (Comparable) lx-at?(block, e, "\",") == 0 ? acc : cons(list(substring(block, a, e), "field"), acc);
        }
        def prg-span-lower-word(s, i) = ((Comparable) lx-lower-at?(s, i) == 1) || ((Comparable) lx-byte(s, i) == 95) ? prg-span-lower-word(s, i + 1) : i;
        // insertion in order, last token wins, duplicates named
        def prg-go-natives(text) = prg-go-absorb(append(prg-go-calls(text, "k.registerNative(", 0), append(prg-go-field-rows(text), prg-go-calls(text, "k.registerEnvNative(", 1))), list(), list());
        def prg-go-absorb(rows, out, dups) {
            (Comparable) len(rows) == 0 ? list(out, dups)
            : (Comparable) prg-has?(out, prg-row-name(head(rows))) == 1 ? prg-go-absorb(tail(rows), prg-go-replace(out, head(rows)), append(dups, list(prg-row-name(head(rows)))))
            : prg-go-absorb(tail(rows), append(out, list(head(rows))), dups);
        }
        def prg-go-replace(out, r) = (Comparable) len(out) == 0 ? list() : (String) prg-row-name(head(out)) == prg-row-name(r) ? cons(r, tail(out)) : cons(head(out), prg-go-replace(tail(out), r));

        // ---- Rust names: register_native( / register_env_native( "name"; native_field_constructor!(a, b, N, "name"); bare "field_x", rows ----
        def prg-rs-names(text) = lx-str-uniq(append(prg-quoted-after(text, "register_native(", 0), append(prg-quoted-after(text, "register_env_native(", 0), append(prg-rs-macro-names(text), prg-rs-bare-field-names(text)))));
        // every "name" that follows needle (after optional blanks)
        def prg-quoted-after(text, needle, from) = prg-quoted-after-go(text, needle, from, list());
        def prg-quoted-after-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? reverse(acc) : prg-quoted-after-go(text, needle, i + 1, prg-quoted-cons(prg-quoted(text, lx-skip-ws(text, i + str_len(needle))), acc));
        }
        def prg-quoted-cons(q, acc) = (Comparable) len(q) == 0 ? acc : cons(q[0], acc);
        def prg-rs-macro-names(text) = prg-rs-macro-go(text, 0, list());
        def prg-rs-macro-go(text, from, acc) {
            let i = str_find(text, "native_field_constructor!(", from);
            i < 0 ? reverse(acc) : prg-rs-macro-go(text, i + 1, prg-rs-macro-at(text, i + str_len("native_field_constructor!("), acc));
        }
        def prg-rs-macro-at(text, a, acc) {
            let c1 = str_find(text, ",", a);
            c1 < 0 ? acc : prg-rs-macro-second(text, str_find(text, ",", c1 + 1), acc);
        }
        def prg-rs-macro-second(text, c2, acc) {
            c2 < 0 ? acc : prg-rs-macro-digits(text, lx-skip-ws(text, c2 + 1), acc);
        }
        def prg-rs-macro-digits(text, d, acc) {
            let e = lx-digits-end(text, d);
            (Comparable) e == d ? acc : (Comparable) lx-at?(text, e, ",") == 0 ? acc : prg-quoted-cons(prg-quoted(text, lx-skip-ws(text, e + 1)), acc);
        }
        def prg-rs-bare-field-names(text) = tb-map(tb-filter2(lx-lines(text), prg-bare-field-line?, 0), prg-bare-field-name);
        def prg-bare-field-line?(line, a) {
            let k = lx-skip-ws(line, 0);
            (Comparable) lx-at?(line, k, "\"field_") == 0 ? 0 : prg-bare-field-tail?(line, prg-span-lower-word(line, k + 7));
        }
        def prg-bare-field-tail?(line, e) = (Comparable) lx-at?(line, e, "\",") == 0 ? 0 : (Comparable) lx-skip-ws(line, e + 2) == str_len(line) ? 1 : 0;
        def prg-bare-field-name(line) {
            let k = lx-skip-ws(line, 0) + 1;
            substring(line, k, prg-span-lower-word(line, k + 6));
        }

        // ---- TypeScript names: registerNative( / registerEnvNative( "name"; [ "name" , RBasic. ----
        def prg-ts-names(text) = lx-str-uniq(append(prg-quoted-after(text, "registerNative(", 0), append(prg-quoted-after(text, "registerEnvNative(", 0), prg-ts-table-names(text))));
        def prg-ts-table-names(text) = prg-ts-table-go(text, 0, list());
        def prg-ts-table-go(text, from, acc) {
            let i = str_find(text, "[", from);
            i < 0 ? reverse(acc) : prg-ts-table-go(text, i + 1, prg-ts-table-at(text, prg-quoted(text, lx-skip-ws(text, i + 1)), acc));
        }
        def prg-ts-table-at(text, q, acc) {
            (Comparable) len(q) == 0 ? acc
            : (Comparable) prg-ts-name-chars?(q[0], 0) == 0 ? acc
            : prg-ts-table-comma(text, q[0], lx-skip-ws(text, q[1]), acc);
        }
        def prg-ts-name-chars?(s, i) = i >= str_len(s) ? 1 : ((Comparable) lx-lower-at?(s, i) == 1) || (((Comparable) lx-digit-at?(s, i) == 1) || (((Comparable) str_byte_at(s, i) == 95) || (((Comparable) str_byte_at(s, i) == 63) || ((Comparable) str_byte_at(s, i) == 45)))) ? prg-ts-name-chars?(s, i + 1) : 0;
        def prg-ts-table-comma(text, name, k, acc) = (Comparable) lx-at?(text, k, ",") == 0 ? acc : (Comparable) lx-at?(text, lx-skip-ws(text, k + 1), "RBasic.") == 0 ? acc : cons(name, acc);

        // ---- the registry cells: list("ok", entries) or list("refused", message); an entry is (name token spec expected mode has-verify) ----
        def prg-e-name(e) = e[0];
        def prg-e-token(e) = e[1];
        def prg-e-spec(e) = e[2];
        def prg-e-expected(e) = e[3];
        def prg-e-mode(e) = e[4];
        def prg-e-verify?(e) = e[5];
        def prg-defined-verifiers(text) = prg-defined-go(text, 0, list());
        def prg-defined-go(text, from, acc) {
            let i = str_find(text, "(defn", from);
            i < 0 ? reverse(acc) : prg-defined-go(text, i + 1, prg-defined-at(text, i + 5, lx-skip-ws(text, i + 5), acc));
        }
        def prg-defined-at(text, j, k, acc) {
            let e = prg-span-verifier(text, k);
            (Comparable) k == j ? acc : (Comparable) lx-at?(text, k, "pv-") == 0 ? acc : (Comparable) lx-ws-at?(text, e) == 0 ? acc : cons(substring(text, k, e), acc);
        }
        // [^\s()]+
        def prg-span-verifier(s, i) = (i >= str_len(s)) || (((Comparable) lx-ws-at?(s, i) == 1) || (((Comparable) str_byte_at(s, i) == 40) || ((Comparable) str_byte_at(s, i) == 41))) ? i : prg-span-verifier(s, i + 1);
        def prg-entries(text) = prg-entries-go(text, prg-defined-verifiers(text), 0, list());
        def prg-entries-go(text, defined, from, acc) {
            let i = str_find(text, "(prim \"", from);
            i < 0 ? list("ok", reverse(acc)) : prg-entry-at(text, defined, i, lx-sblock-from(text, i), acc);
        }
        def prg-entry-at(text, defined, start, cell, acc) {
            let head = prg-cell-head(cell);
            let tail = prg-cell-tail(cell);
            ((Comparable) len(head) == 0) || ((Comparable) len(tail) == 0) ? list("refused", "unparseable registry cell at offset " ++ int_to_str(start) ++ ": " ++ lx-head-bytes(cell, 80) ++ "...")
            : prg-entries-go(text, defined, start + str_len(cell), cons(prg-entry(head, tail, prg-verifier-ok?(lx-strip(substring(cell, head[3], tail[2])), defined)), acc));
        }
        // (prim "name" "token" "spec" -> list(name, token, spec, end)
        def prg-cell-head(cell) {
            let n = prg-quoted(cell, 6);
            (Comparable) len(n) == 0 ? list() : prg-cell-head-token(cell, n, prg-quoted(cell, n[1] + 1));
        }
        def prg-cell-head-token(cell, n, t) {
            (Comparable) len(t) == 0 ? list() : (Comparable) lx-at?(cell, n[1], " ") == 0 ? list() : prg-cell-head-spec(cell, n, t, prg-quoted-or-empty(cell, t[1] + 1));
        }
        def prg-cell-head-spec(cell, n, t, s) = (Comparable) len(s) == 0 ? list() : (Comparable) lx-at?(cell, t[1], " ") == 0 ? list() : list(n[0], t[0], s[0], s[1]);
        // "..." allowing the empty string
        def prg-quoted-or-empty(text, i) {
            (Comparable) lx-at?(text, i, "\"") == 0 ? list() : prg-quoted-or-empty-end(text, i + 1, str_find(text, "\"", i + 1));
        }
        def prg-quoted-or-empty-end(text, a, b) = b < 0 ? list() : list(substring(text, a, b), b + 1);
        // \s+(-?\d+)\s+([01])\)$ read from the end -> list(expected, mode, start-of-tail)
        def prg-cell-tail(cell) {
            let n = str_len(cell);
            n < 6 ? list() : (Comparable) lx-at?(cell, n - 1, ")") == 0 ? list() : prg-cell-tail-mode(cell, n - 2);
        }
        def prg-cell-tail-mode(cell, m) {
            !(((Comparable) str_byte_at(cell, m) == 48) || ((Comparable) str_byte_at(cell, m) == 49)) ? list()
            : (Comparable) lx-ws-at?(cell, m - 1) == 0 ? list()
            : prg-cell-tail-expected(cell, m, prg-ws-back(cell, m - 1));
        }
        // the index of the first byte of the blank run ending at i
        def prg-ws-back(cell, i) = (i > 0) && ((Comparable) lx-ws-at?(cell, i - 1) == 1) ? prg-ws-back(cell, i - 1) : i;
        def prg-digits-back(cell, i) = (i > 0) && ((Comparable) lx-digit-at?(cell, i - 1) == 1) ? prg-digits-back(cell, i - 1) : i;
        def prg-cell-tail-expected(cell, m, w) {
            let d = prg-digits-back(cell, w);
            (Comparable) d == w ? list() : prg-cell-tail-sign(cell, m, w, (d > 0) && ((Comparable) str_byte_at(cell, d - 1) == 45) ? (d - 1) : d);
        }
        def prg-cell-tail-sign(cell, m, w, d) = (Comparable) lx-ws-at?(cell, d - 1) == 0 ? list() : list(str_to_int(substring(cell, d, w)), str_byte_at(cell, m) - 48, prg-ws-back(cell, d));
        def prg-verifier-ok?(v, defined) = (Comparable) str_len(v) == 0 ? 0 : ((Comparable) lx-at?(v, 0, "pv-") == 1) && ((Comparable) prg-span-verifier(v, 0) == str_len(v)) ? lx-str-in?(defined, v) : 1;
        def prg-entry(head, tail, verify?) = list(head[0], head[1], head[2], tail[0], tail[1], verify?);

        // ---- the band's pins: list("ok", total, verified, lane1, lane0) or list("refused", message) ----
        def prg-pin(text, needle) {
            let xs = lx-ints-after(text, needle, ")");
            (Comparable) len(xs) == 0 ? (0 - 1) : head(xs);
        }
        def prg-pins(text) {
            let total = prg-pin(text, "(eq (len reg) ");
            let verified = prg-pin(text, "(eq (prim-verified-count reg) ");
            let lane1 = prg-pin(text, "(eq (prim-mode-count reg 1) ");
            let lane0 = prg-pin(text, "(eq (prim-mode-count reg 0) ");
            (total < 0) || ((verified < 0) || ((lane1 < 0) || (lane0 < 0))) ? list("refused", "band pins not found in primitive-registry-band.fk") : list("ok", total, verified, lane1, lane0);
        }

        // ---- counts ----
        def prg-mode-count(entries, m) = len(filter(e => (Comparable) prg-e-mode(e) == m, entries));
        def prg-gaps(go, rs, ts) = filter(name => ((Comparable) lx-str-in?(rs, name) == 0) || ((Comparable) lx-str-in?(ts, name) == 0), prg-names(go));
        def prg-yn(set, name) = (Comparable) lx-str-in?(set, name) == 1 ? "y" : "n";

        // ---- failures, in the script's order ----
        def prg-failures(go, dups, rs, ts, entries, pins) {
            let reg = tb-map(entries, prg-e-name);
            let gonames = prg-names(go[0]);
            append(prg-when(len(dups) > 0, "duplicate registerNative in main.go: " ++ lx-py-str-list(lx-str-sort(lx-str-uniq(dups)))),
            append(prg-list-failure(lx-str-sort(lx-str-minus(gonames, reg)), "kernel natives missing from registry: "),
            append(prg-list-failure(lx-str-sort(lx-str-minus(reg, gonames)), "registry names not registered in main.go: "),
            append(prg-drift-failures(lx-str-sort(lx-str-common(gonames, reg)), go[0], entries),
            append(prg-entry-failures(entries, prg-gaps(go[0], rs, ts), rs, ts),
                   prg-pin-failures(entries, pins))))));
        }
        def prg-list-failure(names, voice) = prg-when(len(names) > 0, voice ++ lx-py-str-list(names));
        def prg-drift-failures(names, go, entries) {
            (Comparable) len(names) == 0 ? list()
            : append(prg-drift-one(head(names), prg-row-token(prg-lookup(go, head(names))), prg-e-token(prg-lookup(entries, head(names)))), prg-drift-failures(tail(names), go, entries));
        }
        def prg-drift-one(name, want, got) = prg-when(!((String) want == got), "category drift " ++ name ++ ": go declares " ++ want ++ ", registry holds " ++ got);
        def prg-entry-failures(entries, gaps, rs, ts) {
            (Comparable) len(entries) == 0 ? list()
            : append(prg-entry-one(head(entries), gaps, rs, ts), prg-entry-failures(tail(entries), gaps, rs, ts));
        }
        def prg-entry-one(e, gaps, rs, ts) {
            let name = prg-e-name(e);
            append(prg-when(((Comparable) prg-e-mode(e) == 1) && ((Comparable) lx-str-in?(gaps, name) == 1), "lane-1 entry " ++ name ++ " is sibling-gapped (rust=" ++ prg-yn(rs, name) ++ " ts=" ++ prg-yn(ts, name) ++ ")"),
            append(prg-when((Comparable) lx-blank?(prg-e-spec(e)) == 1, "empty spec for " ++ name),
                   prg-when((Comparable) prg-e-verify?(e) == 0, "no verification recipe declared for " ++ name)));
        }
        def prg-pin-failures(entries, pins) {
            let lane1 = prg-mode-count(entries, 1);
            let lane0 = prg-mode-count(entries, 0);
            prg-when((!((Comparable) pins[1] == len(entries))) || ((!((Comparable) pins[3] == lane1)) || ((!((Comparable) pins[4] == lane0)) || (!((Comparable) pins[2] == lane1)))),
                     "band pins drifted: band declares total=" ++ int_to_str(pins[1]) ++ " lane1=" ++ int_to_str(pins[3]) ++ " lane0=" ++ int_to_str(pins[4]) ++ " verified=" ++ int_to_str(pins[2]) ++ "; registry holds total=" ++ int_to_str(len(entries)) ++ " lane1=" ++ int_to_str(lane1) ++ " lane0=" ++ int_to_str(lane0));
        }

        // ---- the report: the script's lines, computed only when there is a report to print ----
        // categories by count, descending, first appearance breaking ties (Python's stable sort)
        def prg-cat-counts(entries) = prg-cat-counts-go(tb-map(entries, prg-e-token), list());
        def prg-cat-counts-go(tokens, acc) = (Comparable) len(tokens) == 0 ? acc : prg-cat-counts-go(tail(tokens), prg-cat-bump(acc, head(tokens)));
        def prg-cat-bump(acc, token) = (Comparable) prg-has?(acc, token) == 0 ? append(acc, list(list(token, 1))) : prg-cat-bump-in(acc, token);
        def prg-cat-bump-in(acc, token) = (String) head(acc)[0] == token ? cons(list(token, head(acc)[1] + 1), tail(acc)) : cons(head(acc), prg-cat-bump-in(tail(acc), token));
        def prg-cat-sort(rows) = prg-cat-sort-go(rows, list());
        def prg-cat-sort-go(rows, acc) = (Comparable) len(rows) == 0 ? acc : prg-cat-sort-go(tail(rows), prg-cat-insert(head(rows), acc));
        def prg-cat-insert(r, sorted) = (Comparable) len(sorted) == 0 ? list(r) : r[1] > head(sorted)[1] ? cons(r, sorted) : cons(head(sorted), prg-cat-insert(r, tail(sorted)));
        def prg-cat-voice(r) = r[0] ++ ":" ++ int_to_str(r[1]);
        // circulation: one grep through host-exec; answers the registry names that appear called in the stdlib bands
        def prg-ere-escape(s) = prg-ere-escape-go(s, 0, "");
        def prg-ere-escape-go(s, i, acc) {
            i >= str_len(s) ? acc
            : prg-ere-escape-go(s, i + 1, acc ++ (((Comparable) str_byte_at(s, i) == 63) || (((Comparable) str_byte_at(s, i) == 43) || (((Comparable) str_byte_at(s, i) == 42) || (((Comparable) str_byte_at(s, i) == 46) || (((Comparable) str_byte_at(s, i) == 124) || (((Comparable) str_byte_at(s, i) == 91) || (((Comparable) str_byte_at(s, i) == 93) || (((Comparable) str_byte_at(s, i) == 40) || (((Comparable) str_byte_at(s, i) == 41) || (((Comparable) str_byte_at(s, i) == 36) || (((Comparable) str_byte_at(s, i) == 94) || (((Comparable) str_byte_at(s, i) == 123) || (((Comparable) str_byte_at(s, i) == 125) || ((Comparable) str_byte_at(s, i) == 92))))))))))))) ? "\\" ++ substring(s, i, i + 1) : substring(s, i, i + 1)));
        }
        def prg-circulation-cmd(root, names) = "grep -ohE '\\((" ++ tb-join(names, prg-ere-escape, "|") ++ ")([[:space:])]|$)' " ++ root ++ prg-tests-glob() ++ " 2>/dev/null | sed -E 's/^\\(//; s/[[:space:])]$//' | sort -u";
        def prg-circulating(root, names) = filter(line => str_len(line) > 0, lx-lines(lx-host-text(host-exec(prg-circulation-cmd(root, names), ""))));
        def prg-server-count(root) = lx-count(lx-host-text(read_file(root ++ prg-go-server())), "k.registerNative(\"");
        def prg-report(root, go, rs, ts, entries) {
            let gaps = lx-str-sort(prg-gaps(go[0], rs, ts));
            let circulating = prg-circulating(root, tb-map(entries, prg-e-name));
            let declared = lx-str-sort(tb-map(filter(e => ((Comparable) prg-e-mode(e) == 0) && ((Comparable) lx-str-in?(circulating, prg-e-name(e)) == 0), entries), prg-e-name));
            append(list("natives: " ++ int_to_str(len(go[0])) ++ " (go main.go surface)  registry: " ++ int_to_str(len(entries)),
                        "lanes: " ++ int_to_str(prg-mode-count(entries, 1)) ++ " in-band verified  ·  " ++ int_to_str(prg-mode-count(entries, 0)) ++ " carrier-declared",
                        "categories: " ++ tb-join(prg-cat-sort(prg-cat-counts(entries)), prg-cat-voice, "  ")),
            append(prg-when(len(gaps) > 0, "sibling gaps (" ++ int_to_str(len(gaps)) ++ "): " ++ tb-join(gaps, identity, " ")),
            append(list("band circulation: " ++ int_to_str(len(lx-str-common(tb-map(entries, prg-e-name), circulating))) ++ "/" ++ int_to_str(len(entries)) ++ " names appear in stdlib tests"),
            append(prg-when(len(declared) > 0, "declared-only tail (" ++ int_to_str(len(declared)) ++ ", verification recipes awaiting a carrier): " ++ tb-join(declared, identity, " ")),
                   list("server.go host-IO surface (go-only, not in registry): " ++ int_to_str(prg-server-count(root)))))));
        }

        // ---- the analysis: list(failures, report-or-empty, go-count, entry-count, lane1, lane0); a refusal carries its one line as the failures ----
        def prg-refusal(msg) = list(list(msg), list(), 0, 0, 0, 0);
        def prg-missing(root, rel) = "missing input: " ++ root ++ rel;
        def prg-texts(root) = list(root ++ prg-go-main(), root ++ prg-rs-main(), root ++ prg-ts-kernel(), root ++ prg-registry(), root ++ prg-band());
        def prg-read-all(paths, acc) {
            (Comparable) len(paths) == 0 ? list("ok", reverse(acc))
            : prg-read-one(head(paths), tail(paths), acc, read_file(head(paths)));
        }
        def prg-read-one(path, rest, acc, text) = nothing?(text) ? list("missing", path) : prg-read-all(rest, cons(text, acc));
        def prg-analysis(root) {
            let read = prg-read-all(prg-texts(root), list());
            (String) read[0] == "missing" ? prg-refusal("missing input: " ++ read[1]) : prg-analysis-texts(root, read[1]);
        }
        def prg-analysis-texts(root, texts) {
            let entries = prg-entries(texts[3]);
            let pins = prg-pins(texts[4]);
            (String) entries[0] == "refused" ? prg-refusal(entries[1])
            : (String) pins[0] == "refused" ? prg-refusal(pins[1])
            : prg-analysis-with(root, prg-go-natives(texts[0]), prg-rs-names(texts[1]), prg-ts-names(texts[2]), entries[1], pins);
        }
        def prg-analysis-with(root, go, rs, ts, entries, pins) {
            let failures = prg-failures(go, go[1], rs, ts, entries, pins);
            list(failures, (Comparable) len(failures) == 0 ? list() : prg-report(root, go, rs, ts, entries), len(go[0]), len(entries), prg-mode-count(entries, 1), prg-mode-count(entries, 0));
        }
        def prg-a-failures(a) = a[0];
        def prg-a-report(a) = a[1];
        // the report on demand, for a green tree too (the twin prints it without --quiet)
        def prg-report-at(root) {
            let read = prg-read-all(prg-texts(root), list());
            (String) read[0] == "missing" ? list() : prg-report-texts(root, read[1]);
        }
        def prg-report-texts(root, texts) {
            let entries = prg-entries(texts[3]);
            (String) entries[0] == "refused" ? list() : prg-report(root, prg-go-natives(texts[0]), prg-rs-names(texts[1]), prg-ts-names(texts[2]), entries[1]);
        }

        // ---- the voice ----
        def prg-ok-line(a) = int_to_str(a[2]) ++ " natives == " ++ int_to_str(a[3]) ++ " rows; lanes " ++ int_to_str(a[4]) ++ "+" ++ int_to_str(a[5]) ++ "; band pins aligned";
        def prg-print-report(lines) = (Comparable) len(lines) == 0 ? 0 : prg-print-report-one(lines);
        def prg-print-report-one(lines) {
            lx-print-prefixed("", lines);
            print("");
            0;
        }
        def prg-judge(root) {
            let a = prg-analysis(root);
            prg-print-report(prg-a-report(a));
            lx-verdict(prg-name(), prg-a-failures(a), prg-ok-line(a));
        }
        def prg-run() = prg-judge("");
    }
    prg-run();
}
