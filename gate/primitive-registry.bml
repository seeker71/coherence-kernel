//////////////////////////////////////////////////////////////////////
//
// gate/primitive-registry.bml — the primitive-registry drift gate as a Form lens.
//
// Executable BML. R58 in the release ledger: the Form twin of
// form/scripts/validate_primitive_registry.py (its --quiet voice, the
// one the drift-gates row speaks), read as the spec and transliterated
// check for check. The script stays in place as a witness while this
// lens stands its first landings; the drift-gates row
// (gate/drift-gates.bml, "primitive-registry") runs this door.
//
// THE INVARIANT. form/form-stdlib/primitive-registry.fk is the body of
// the kernel native surface: one (prim "name" "category" "spec"
// verifier expected mode) cell per native, proven three-way by
// tests/primitive-registry-band.fk. The Go kernel's main.go is the
// surface it describes. The two agree when:
//   - every name main.go registers (k.registerNative("name", catX(,
//     the fieldConstructors table's {"name", rows, k.registerEnvNative)
//     has a registry cell, and every cell names a registered native;
//   - main.go registers no name twice;
//   - each cell's category is the token of the Go constructor (catCall
//     call, catAccess access, catMethod method, catCompare compare,
//     catListNat list, catWitness witness, catUndefined undefined; the
//     fieldConstructors rows are "field");
//   - a lane-1 cell (mode 1, verified in-band) names a native the Rust
//     kernel (register_native / register_env_native /
//     native_field_constructor! / the bare "field_x", rows of main.rs)
//     and the TypeScript kernel (registerNative / registerEnvNative /
//     ["name", RBasic. rows of kernel.ts) both carry; a sibling-gapped
//     name stays lane 0;
//   - no cell has a blank spec; every cell's verifier is a defined pv-
//     name or an inline expression;
//   - the band's four pins — (eq (len reg) N), (eq (prim-verified-count
//     reg) N), (eq (prim-mode-count reg 1) N), (eq (prim-mode-count reg
//     0) N) — equal the registry's total, lane-1 (twice) and lane-0.
//
// INPUTS. Six texts under a root the band can re-point ("" is the live
// tree): main.go, server.go (the report's go-only host-IO count, 0 when
// absent), main.rs, kernel.ts, primitive-registry.fk, and the band. The
// registry cells are read from the text as the script reads them — a
// string-aware paren walk from each `(prim "` — because one of the
// checks (a verifier that names no defined pv-) is a property of the
// text a loaded table cannot show. The stdlib band circulation the
// REPORT names (which registry names appear called in
// form-stdlib/tests/*.fk) is one grep through host-exec over the 1,873
// bands: the membrane, crossed once, and only when there is a report to
// print — the script walks 8 MB of text once per name; a Form loop
// doing that would cost minutes on every landing. R61 names host-exec
// as a membrane to shrink; this call is a row in that census.
//
// TWO TEACHINGS, NAMED. The script's third Rust pattern,
// `^\s*"(field_[a-z_]+)",\s*$`, has no MULTILINE flag, so it matches
// nothing on any file; this lens reads those bare rows (the intent),
// and today the two readings agree because every name in that list is
// also registered by name. And the script's `--quiet` PASS line counts
// Go natives, not registry rows, on its left — the same number only
// while the gate is green; the lens says the same words.
//
// EXIT. No failures: one line `primitive-registry: OK <go> natives ==
// <rows> rows; lanes <lane1>+<lane0>; band pins aligned` and the
// answer 1. Otherwise the report (natives, lanes, categories by count,
// sibling gaps, circulation, the declared-only tail, the server.go
// surface), one empty line, one `error: ...` line per finding in the
// script's order, then `primitive-registry: FAIL` and the answer 0 —
// the script's words, its `FAIL ` prefix read as `error: `. A text the
// tree does not have, an unparseable registry cell, or a band without
// its pins is one named error and a refusal, where the script dies or
// exits early with the same words.
//
// Run directly:  ./fkwu gate/primitive-registry.bml    ; last line 1 / 0
// Twin:          python3 form/scripts/validate_primitive_registry.py --quiet
// Proven by:     gate/tests/primitive-registry-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormPrimitiveRegistryGate {
        thought primitive-registry-pattern = list("registry-is-the-body-main-go-the-surface", "cells-read-as-the-script-reads-them", "lane-1-needs-three-kernels", "pins-equal-counts", "membrane-crossed-once-on-the-red-path", "twin-voice-byte-for-byte");

        def prg-name() = "primitive-registry";
        def prg-go-main() = "form/form-kernel-go/main.go";
        def prg-go-server() = "form/form-kernel-go/server.go";
        def prg-rs-main() = "form/form-kernel-rust/src/main.rs";
        def prg-ts-kernel() = "form/form-kernel-ts/src/kernel.ts";
        def prg-registry() = "form/form-stdlib/primitive-registry.fk";
        def prg-band() = "form/form-stdlib/tests/primitive-registry-band.fk";
        def prg-tests-glob() = "form/form-stdlib/tests/*.fk";
        def prg-cat(constructor, token) = list(constructor, token);
        def prg-cats() = list(prg-cat("catCall", "call"), prg-cat("catAccess", "access"), prg-cat("catMethod", "method"), prg-cat("catCompare", "compare"), prg-cat("catListNat", "list"), prg-cat("catWitness", "witness"), prg-cat("catUndefined", "undefined"));
        def prg-cat-named?(row, c) = if str_eq(nth(row, 0), c) then 1 else 0;
        // the token of a Go constructor, or "" when it has none
        def prg-token-of(c) {
            let row = tb-find2(prg-cats(), prg-cat-named?, c);
            if eq(len(row), 0) then "" else nth(row, 1);
        }
        def prg-when(cond, msg) = if cond then list(msg) else list();

        // ---- (name, token) rows ----
        def prg-row-name(r) = nth(r, 0);
        def prg-row-token(r) = nth(r, 1);
        def prg-named?(r, name) = if str_eq(nth(r, 0), name) then 1 else 0;
        def prg-lookup(rows, name) = tb-find2(rows, prg-named?, name);
        def prg-has?(rows, name) = if eq(len(prg-lookup(rows, name)), 0) then 0 else 1;
        def prg-absent?(name, rows) = if eq(prg-has?(rows, name), 1) then 0 else 1;
        def prg-present?(name, rows) = prg-has?(rows, name);
        def prg-names(rows) = tb-map(rows, prg-row-name);

        // ---- a quoted name at i: "name" -> list(name, end-after-quote) or list() ----
        def prg-quoted(text, i) {
            if eq(lx-at?(text, i, "\""), 0) then list() else prg-quoted-end(text, add(i, 1), str_find(text, "\"", add(i, 1)));
        }
        def prg-quoted-end(text, a, b) = if lt(b, 0) then list() else if eq(b, a) then list() else list(substring(text, a, b), add(b, 1));

        // ---- Go: list(rows(name token), dups) ----
        // k.registerNative(\s*"name",\s*(cat[A-Za-z]+)\(  and  k.registerEnvNative(...) — the same shape
        def prg-go-calls(text, needle, keep-field?) = prg-go-calls-go(text, needle, keep-field?, 0, list());
        def prg-go-calls-go(text, needle, keep-field?, from, acc) {
            let i = str_find(text, needle, from);
            if lt(i, 0) then reverse(acc) else prg-go-calls-go(text, needle, keep-field?, add(i, 1), prg-go-call-at(text, lx-skip-ws(text, add(i, str_len(needle))), keep-field?, acc));
        }
        def prg-go-call-at(text, i, keep-field?, acc) {
            let q = prg-quoted(text, i);
            if eq(len(q), 0) then acc else if eq(lx-at?(text, nth(q, 1), ","), 0) then acc else prg-go-call-cat(text, nth(q, 0), lx-skip-ws(text, add(nth(q, 1), 1)), keep-field?, acc);
        }
        def prg-go-call-cat(text, name, k, keep-field?, acc) {
            let e = prg-span-alpha(text, add(k, 3));
            if eq(lx-at?(text, k, "cat"), 0) then acc
            else if eq(lx-at?(text, e, "("), 0) then acc
            else prg-go-call-row(name, substring(text, k, e), keep-field?, acc);
        }
        def prg-span-alpha(s, i) = if or(eq(lx-upper-at?(s, i), 1), eq(lx-lower-at?(s, i), 1)) then prg-span-alpha(s, add(i, 1)) else i;
        // registerNative: a constructor without a token is kept raw, except catFieldPrimitive (the table loop line); registerEnvNative keeps every raw
        def prg-go-call-row(name, c, keep-field?, acc) {
            let token = prg-token-of(c);
            if and(eq(str_len(token), 0), and(eq(keep-field?, 0), str_eq(c, "catFieldPrimitive"))) then acc
            else cons(list(name, if eq(str_len(token), 0) then c else token), acc);
        }
        // the fieldConstructors table: from `fieldConstructors := []struct {` to the first "\n\t}\n"; rows {"name",
        def prg-go-field-rows(text) {
            let a = str_find(text, "fieldConstructors := []struct {", 0);
            if lt(a, 0) then list() else prg-go-field-rows-in(prg-go-field-block(text, a));
        }
        def prg-go-field-block(text, a) {
            let b = str_find(text, str_concat(lx-nl(), str_concat(byte_to_str(9), str_concat("}", lx-nl()))), a);
            substring(text, a, if lt(b, 0) then str_len(text) else add(b, 4));
        }
        def prg-go-field-rows-in(block) = prg-go-field-go(block, 0, list());
        def prg-go-field-go(block, from, acc) {
            let i = str_find(block, "{\"", from);
            if lt(i, 0) then reverse(acc) else prg-go-field-go(block, add(i, 1), prg-go-field-at(block, add(i, 2), acc));
        }
        def prg-go-field-at(block, a, acc) {
            let e = prg-span-lower-word(block, a);
            if eq(e, a) then acc else if eq(lx-at?(block, e, "\","), 0) then acc else cons(list(substring(block, a, e), "field"), acc);
        }
        def prg-span-lower-word(s, i) = if or(eq(lx-lower-at?(s, i), 1), eq(lx-byte(s, i), 95)) then prg-span-lower-word(s, add(i, 1)) else i;
        // insertion in order, last token wins, duplicates named
        def prg-go-natives(text) = prg-go-absorb(append(prg-go-calls(text, "k.registerNative(", 0), append(prg-go-field-rows(text), prg-go-calls(text, "k.registerEnvNative(", 1))), list(), list());
        def prg-go-absorb(rows, out, dups) {
            if eq(len(rows), 0) then list(out, dups)
            else if eq(prg-has?(out, prg-row-name(head(rows))), 1) then prg-go-absorb(tail(rows), prg-go-replace(out, head(rows)), append(dups, list(prg-row-name(head(rows)))))
            else prg-go-absorb(tail(rows), append(out, list(head(rows))), dups);
        }
        def prg-go-replace(out, r) = if eq(len(out), 0) then list() else if str_eq(prg-row-name(head(out)), prg-row-name(r)) then cons(r, tail(out)) else cons(head(out), prg-go-replace(tail(out), r));

        // ---- Rust names: register_native( / register_env_native( "name"; native_field_constructor!(a, b, N, "name"); bare "field_x", rows ----
        def prg-rs-names(text) = lx-str-uniq(append(prg-quoted-after(text, "register_native(", 0), append(prg-quoted-after(text, "register_env_native(", 0), append(prg-rs-macro-names(text), prg-rs-bare-field-names(text)))));
        // every "name" that follows needle (after optional blanks)
        def prg-quoted-after(text, needle, from) = prg-quoted-after-go(text, needle, from, list());
        def prg-quoted-after-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            if lt(i, 0) then reverse(acc) else prg-quoted-after-go(text, needle, add(i, 1), prg-quoted-cons(prg-quoted(text, lx-skip-ws(text, add(i, str_len(needle)))), acc));
        }
        def prg-quoted-cons(q, acc) = if eq(len(q), 0) then acc else cons(nth(q, 0), acc);
        def prg-rs-macro-names(text) = prg-rs-macro-go(text, 0, list());
        def prg-rs-macro-go(text, from, acc) {
            let i = str_find(text, "native_field_constructor!(", from);
            if lt(i, 0) then reverse(acc) else prg-rs-macro-go(text, add(i, 1), prg-rs-macro-at(text, add(i, str_len("native_field_constructor!(")), acc));
        }
        def prg-rs-macro-at(text, a, acc) {
            let c1 = str_find(text, ",", a);
            if lt(c1, 0) then acc else prg-rs-macro-second(text, str_find(text, ",", add(c1, 1)), acc);
        }
        def prg-rs-macro-second(text, c2, acc) {
            if lt(c2, 0) then acc else prg-rs-macro-digits(text, lx-skip-ws(text, add(c2, 1)), acc);
        }
        def prg-rs-macro-digits(text, d, acc) {
            let e = lx-digits-end(text, d);
            if eq(e, d) then acc else if eq(lx-at?(text, e, ","), 0) then acc else prg-quoted-cons(prg-quoted(text, lx-skip-ws(text, add(e, 1))), acc);
        }
        def prg-rs-bare-field-names(text) = tb-map(tb-filter2(lx-lines(text), prg-bare-field-line?, 0), prg-bare-field-name);
        def prg-bare-field-line?(line, a) {
            let k = lx-skip-ws(line, 0);
            if eq(lx-at?(line, k, "\"field_"), 0) then 0 else prg-bare-field-tail?(line, prg-span-lower-word(line, add(k, 7)));
        }
        def prg-bare-field-tail?(line, e) = if eq(lx-at?(line, e, "\","), 0) then 0 else if eq(lx-skip-ws(line, add(e, 2)), str_len(line)) then 1 else 0;
        def prg-bare-field-name(line) {
            let k = add(lx-skip-ws(line, 0), 1);
            substring(line, k, prg-span-lower-word(line, add(k, 6)));
        }

        // ---- TypeScript names: registerNative( / registerEnvNative( "name"; [ "name" , RBasic. ----
        def prg-ts-names(text) = lx-str-uniq(append(prg-quoted-after(text, "registerNative(", 0), append(prg-quoted-after(text, "registerEnvNative(", 0), prg-ts-table-names(text))));
        def prg-ts-table-names(text) = prg-ts-table-go(text, 0, list());
        def prg-ts-table-go(text, from, acc) {
            let i = str_find(text, "[", from);
            if lt(i, 0) then reverse(acc) else prg-ts-table-go(text, add(i, 1), prg-ts-table-at(text, prg-quoted(text, lx-skip-ws(text, add(i, 1))), acc));
        }
        def prg-ts-table-at(text, q, acc) {
            if eq(len(q), 0) then acc
            else if eq(prg-ts-name-chars?(nth(q, 0), 0), 0) then acc
            else prg-ts-table-comma(text, nth(q, 0), lx-skip-ws(text, nth(q, 1)), acc);
        }
        def prg-ts-name-chars?(s, i) = if ge(i, str_len(s)) then 1 else if or(eq(lx-lower-at?(s, i), 1), or(eq(lx-digit-at?(s, i), 1), or(eq(str_byte_at(s, i), 95), or(eq(str_byte_at(s, i), 63), eq(str_byte_at(s, i), 45))))) then prg-ts-name-chars?(s, add(i, 1)) else 0;
        def prg-ts-table-comma(text, name, k, acc) = if eq(lx-at?(text, k, ","), 0) then acc else if eq(lx-at?(text, lx-skip-ws(text, add(k, 1)), "RBasic."), 0) then acc else cons(name, acc);

        // ---- the registry cells: list("ok", entries) or list("refused", message); an entry is (name token spec expected mode has-verify) ----
        def prg-e-name(e) = nth(e, 0);
        def prg-e-token(e) = nth(e, 1);
        def prg-e-spec(e) = nth(e, 2);
        def prg-e-expected(e) = nth(e, 3);
        def prg-e-mode(e) = nth(e, 4);
        def prg-e-verify?(e) = nth(e, 5);
        def prg-defined-verifiers(text) = prg-defined-go(text, 0, list());
        def prg-defined-go(text, from, acc) {
            let i = str_find(text, "(defn", from);
            if lt(i, 0) then reverse(acc) else prg-defined-go(text, add(i, 1), prg-defined-at(text, add(i, 5), lx-skip-ws(text, add(i, 5)), acc));
        }
        def prg-defined-at(text, j, k, acc) {
            let e = prg-span-verifier(text, k);
            if eq(k, j) then acc else if eq(lx-at?(text, k, "pv-"), 0) then acc else if eq(lx-ws-at?(text, e), 0) then acc else cons(substring(text, k, e), acc);
        }
        // [^\s()]+
        def prg-span-verifier(s, i) = if or(ge(i, str_len(s)), or(eq(lx-ws-at?(s, i), 1), or(eq(str_byte_at(s, i), 40), eq(str_byte_at(s, i), 41)))) then i else prg-span-verifier(s, add(i, 1));
        def prg-entries(text) = prg-entries-go(text, prg-defined-verifiers(text), 0, list());
        def prg-entries-go(text, defined, from, acc) {
            let i = str_find(text, "(prim \"", from);
            if lt(i, 0) then list("ok", reverse(acc)) else prg-entry-at(text, defined, i, lx-sblock-from(text, i), acc);
        }
        def prg-entry-at(text, defined, start, cell, acc) {
            let head = prg-cell-head(cell);
            let tail = prg-cell-tail(cell);
            if or(eq(len(head), 0), eq(len(tail), 0)) then list("refused", str_concat("unparseable registry cell at offset ", str_concat(int_to_str(start), str_concat(": ", str_concat(lx-head-bytes(cell, 80), "...")))))
            else prg-entries-go(text, defined, add(start, str_len(cell)), cons(prg-entry(head, tail, prg-verifier-ok?(lx-strip(substring(cell, nth(head, 3), nth(tail, 2))), defined)), acc));
        }
        // (prim "name" "token" "spec" -> list(name, token, spec, end)
        def prg-cell-head(cell) {
            let n = prg-quoted(cell, 6);
            if eq(len(n), 0) then list() else prg-cell-head-token(cell, n, prg-quoted(cell, add(nth(n, 1), 1)));
        }
        def prg-cell-head-token(cell, n, t) {
            if eq(len(t), 0) then list() else if eq(lx-at?(cell, nth(n, 1), " "), 0) then list() else prg-cell-head-spec(cell, n, t, prg-quoted-or-empty(cell, add(nth(t, 1), 1)));
        }
        def prg-cell-head-spec(cell, n, t, s) = if eq(len(s), 0) then list() else if eq(lx-at?(cell, nth(t, 1), " "), 0) then list() else list(nth(n, 0), nth(t, 0), nth(s, 0), nth(s, 1));
        // "..." allowing the empty string
        def prg-quoted-or-empty(text, i) {
            if eq(lx-at?(text, i, "\""), 0) then list() else prg-quoted-or-empty-end(text, add(i, 1), str_find(text, "\"", add(i, 1)));
        }
        def prg-quoted-or-empty-end(text, a, b) = if lt(b, 0) then list() else list(substring(text, a, b), add(b, 1));
        // \s+(-?\d+)\s+([01])\)$ read from the end -> list(expected, mode, start-of-tail)
        def prg-cell-tail(cell) {
            let n = str_len(cell);
            if lt(n, 6) then list() else if eq(lx-at?(cell, sub(n, 1), ")"), 0) then list() else prg-cell-tail-mode(cell, sub(n, 2));
        }
        def prg-cell-tail-mode(cell, m) {
            if not(or(eq(str_byte_at(cell, m), 48), eq(str_byte_at(cell, m), 49))) then list()
            else if eq(lx-ws-at?(cell, sub(m, 1)), 0) then list()
            else prg-cell-tail-expected(cell, m, prg-ws-back(cell, sub(m, 1)));
        }
        // the index of the first byte of the blank run ending at i
        def prg-ws-back(cell, i) = if and(gt(i, 0), eq(lx-ws-at?(cell, sub(i, 1)), 1)) then prg-ws-back(cell, sub(i, 1)) else i;
        def prg-digits-back(cell, i) = if and(gt(i, 0), eq(lx-digit-at?(cell, sub(i, 1)), 1)) then prg-digits-back(cell, sub(i, 1)) else i;
        def prg-cell-tail-expected(cell, m, w) {
            let d = prg-digits-back(cell, w);
            if eq(d, w) then list() else prg-cell-tail-sign(cell, m, w, if and(gt(d, 0), eq(str_byte_at(cell, sub(d, 1)), 45)) then sub(d, 1) else d);
        }
        def prg-cell-tail-sign(cell, m, w, d) = if eq(lx-ws-at?(cell, sub(d, 1)), 0) then list() else list(str_to_int(substring(cell, d, w)), sub(str_byte_at(cell, m), 48), prg-ws-back(cell, d));
        def prg-verifier-ok?(v, defined) = if eq(str_len(v), 0) then 0 else if and(eq(lx-at?(v, 0, "pv-"), 1), eq(prg-span-verifier(v, 0), str_len(v))) then lx-str-in?(defined, v) else 1;
        def prg-entry(head, tail, verify?) = list(nth(head, 0), nth(head, 1), nth(head, 2), nth(tail, 0), nth(tail, 1), verify?);

        // ---- the band's pins: list("ok", total, verified, lane1, lane0) or list("refused", message) ----
        def prg-pin(text, needle) {
            let xs = lx-ints-after(text, needle, ")");
            if eq(len(xs), 0) then sub(0, 1) else head(xs);
        }
        def prg-pins(text) {
            let total = prg-pin(text, "(eq (len reg) ");
            let verified = prg-pin(text, "(eq (prim-verified-count reg) ");
            let lane1 = prg-pin(text, "(eq (prim-mode-count reg 1) ");
            let lane0 = prg-pin(text, "(eq (prim-mode-count reg 0) ");
            if or(lt(total, 0), or(lt(verified, 0), or(lt(lane1, 0), lt(lane0, 0)))) then list("refused", "band pins not found in primitive-registry-band.fk") else list("ok", total, verified, lane1, lane0);
        }

        // ---- counts ----
        def prg-mode-is?(e, m) = if eq(prg-e-mode(e), m) then 1 else 0;
        def prg-mode-count(entries, m) = len(tb-filter2(entries, prg-mode-is?, m));
        def prg-gapped?(name, sibs) = if or(eq(lx-str-in?(nth(sibs, 0), name), 0), eq(lx-str-in?(nth(sibs, 1), name), 0)) then 1 else 0;
        def prg-gaps(go, rs, ts) = tb-filter2(prg-names(go), prg-gapped?, list(rs, ts));
        def prg-yn(set, name) = if eq(lx-str-in?(set, name), 1) then "y" else "n";

        // ---- failures, in the script's order ----
        def prg-failures(go, dups, rs, ts, entries, pins) {
            let reg = tb-map(entries, prg-e-name);
            let gonames = prg-names(nth(go, 0));
            append(prg-when(gt(len(dups), 0), str_concat("duplicate registerNative in main.go: ", lx-py-str-list(lx-str-sort(lx-str-uniq(dups))))),
            append(prg-list-failure(lx-str-sort(lx-str-minus(gonames, reg)), "kernel natives missing from registry: "),
            append(prg-list-failure(lx-str-sort(lx-str-minus(reg, gonames)), "registry names not registered in main.go: "),
            append(prg-drift-failures(lx-str-sort(lx-str-common(gonames, reg)), nth(go, 0), entries),
            append(prg-entry-failures(entries, prg-gaps(nth(go, 0), rs, ts), rs, ts),
                   prg-pin-failures(entries, pins))))));
        }
        def prg-list-failure(names, voice) = prg-when(gt(len(names), 0), str_concat(voice, lx-py-str-list(names)));
        def prg-drift-failures(names, go, entries) {
            if eq(len(names), 0) then list()
            else append(prg-drift-one(head(names), prg-row-token(prg-lookup(go, head(names))), prg-e-token(prg-lookup(entries, head(names)))), prg-drift-failures(tail(names), go, entries));
        }
        def prg-drift-one(name, want, got) = prg-when(not(str_eq(want, got)), str_concat("category drift ", str_concat(name, str_concat(": go declares ", str_concat(want, str_concat(", registry holds ", got))))));
        def prg-entry-failures(entries, gaps, rs, ts) {
            if eq(len(entries), 0) then list()
            else append(prg-entry-one(head(entries), gaps, rs, ts), prg-entry-failures(tail(entries), gaps, rs, ts));
        }
        def prg-entry-one(e, gaps, rs, ts) {
            let name = prg-e-name(e);
            append(prg-when(and(eq(prg-e-mode(e), 1), eq(lx-str-in?(gaps, name), 1)), str_concat("lane-1 entry ", str_concat(name, str_concat(" is sibling-gapped (rust=", str_concat(prg-yn(rs, name), str_concat(" ts=", str_concat(prg-yn(ts, name), ")"))))))),
            append(prg-when(eq(lx-blank?(prg-e-spec(e)), 1), str_concat("empty spec for ", name)),
                   prg-when(eq(prg-e-verify?(e), 0), str_concat("no verification recipe declared for ", name))));
        }
        def prg-pin-failures(entries, pins) {
            let lane1 = prg-mode-count(entries, 1);
            let lane0 = prg-mode-count(entries, 0);
            prg-when(or(not(eq(nth(pins, 1), len(entries))), or(not(eq(nth(pins, 3), lane1)), or(not(eq(nth(pins, 4), lane0)), not(eq(nth(pins, 2), lane1))))),
                     str_concat("band pins drifted: band declares total=", str_concat(int_to_str(nth(pins, 1)), str_concat(" lane1=", str_concat(int_to_str(nth(pins, 3)), str_concat(" lane0=", str_concat(int_to_str(nth(pins, 4)), str_concat(" verified=", str_concat(int_to_str(nth(pins, 2)), str_concat("; registry holds total=", str_concat(int_to_str(len(entries)), str_concat(" lane1=", str_concat(int_to_str(lane1), str_concat(" lane0=", int_to_str(lane0)))))))))))))));
        }

        // ---- the report: the script's lines, computed only when there is a report to print ----
        // categories by count, descending, first appearance breaking ties (Python's stable sort)
        def prg-cat-counts(entries) = prg-cat-counts-go(tb-map(entries, prg-e-token), list());
        def prg-cat-counts-go(tokens, acc) = if eq(len(tokens), 0) then acc else prg-cat-counts-go(tail(tokens), prg-cat-bump(acc, head(tokens)));
        def prg-cat-bump(acc, token) = if eq(prg-has?(acc, token), 0) then append(acc, list(list(token, 1))) else prg-cat-bump-in(acc, token);
        def prg-cat-bump-in(acc, token) = if str_eq(nth(head(acc), 0), token) then cons(list(token, add(nth(head(acc), 1), 1)), tail(acc)) else cons(head(acc), prg-cat-bump-in(tail(acc), token));
        def prg-cat-sort(rows) = prg-cat-sort-go(rows, list());
        def prg-cat-sort-go(rows, acc) = if eq(len(rows), 0) then acc else prg-cat-sort-go(tail(rows), prg-cat-insert(head(rows), acc));
        def prg-cat-insert(r, sorted) = if eq(len(sorted), 0) then list(r) else if gt(nth(r, 1), nth(head(sorted), 1)) then cons(r, sorted) else cons(head(sorted), prg-cat-insert(r, tail(sorted)));
        def prg-cat-voice(r) = str_concat(nth(r, 0), str_concat(":", int_to_str(nth(r, 1))));
        // circulation: one grep through host-exec; answers the registry names that appear called in the stdlib bands
        def prg-ere-escape(s) = prg-ere-escape-go(s, 0, "");
        def prg-ere-escape-go(s, i, acc) {
            if ge(i, str_len(s)) then acc
            else prg-ere-escape-go(s, add(i, 1), str_concat(acc, if or(eq(str_byte_at(s, i), 63), or(eq(str_byte_at(s, i), 43), or(eq(str_byte_at(s, i), 42), or(eq(str_byte_at(s, i), 46), or(eq(str_byte_at(s, i), 124), or(eq(str_byte_at(s, i), 91), or(eq(str_byte_at(s, i), 93), or(eq(str_byte_at(s, i), 40), or(eq(str_byte_at(s, i), 41), or(eq(str_byte_at(s, i), 36), or(eq(str_byte_at(s, i), 94), or(eq(str_byte_at(s, i), 123), or(eq(str_byte_at(s, i), 125), eq(str_byte_at(s, i), 92)))))))))))))) then str_concat("\\", substring(s, i, add(i, 1))) else substring(s, i, add(i, 1))));
        }
        def prg-circulation-cmd(root, names) = str_concat("grep -ohE '\\((", str_concat(tb-join(names, prg-ere-escape, "|"), str_concat(")([[:space:])]|$)' ", str_concat(root, str_concat(prg-tests-glob(), " 2>/dev/null | sed -E 's/^\\(//; s/[[:space:])]$//' | sort -u")))));
        def prg-circulating(root, names) = tb-filter2(lx-lines(lx-host-text(host-exec(prg-circulation-cmd(root, names), ""))), prg-nonblank?, 0);
        def prg-nonblank?(line, a) = if eq(str_len(line), 0) then 0 else 1;
        def prg-declared-only?(e, circulating) = if and(eq(prg-e-mode(e), 0), eq(lx-str-in?(circulating, prg-e-name(e)), 0)) then 1 else 0;
        def prg-server-count(root) = lx-count(lx-host-text(read_file(str_concat(root, prg-go-server()))), "k.registerNative(\"");
        def prg-report(root, go, rs, ts, entries) {
            let gaps = lx-str-sort(prg-gaps(nth(go, 0), rs, ts));
            let circulating = prg-circulating(root, tb-map(entries, prg-e-name));
            let declared = lx-str-sort(tb-map(tb-filter2(entries, prg-declared-only?, circulating), prg-e-name));
            append(list(str_concat("natives: ", str_concat(int_to_str(len(nth(go, 0))), str_concat(" (go main.go surface)  registry: ", int_to_str(len(entries))))),
                        str_concat("lanes: ", str_concat(int_to_str(prg-mode-count(entries, 1)), str_concat(" in-band verified  ·  ", str_concat(int_to_str(prg-mode-count(entries, 0)), " carrier-declared")))),
                        str_concat("categories: ", tb-join(prg-cat-sort(prg-cat-counts(entries)), prg-cat-voice, "  "))),
            append(prg-when(gt(len(gaps), 0), str_concat("sibling gaps (", str_concat(int_to_str(len(gaps)), str_concat("): ", tb-join(gaps, identity, " "))))),
            append(list(str_concat("band circulation: ", str_concat(int_to_str(len(lx-str-common(tb-map(entries, prg-e-name), circulating))), str_concat("/", str_concat(int_to_str(len(entries)), " names appear in stdlib tests"))))),
            append(prg-when(gt(len(declared), 0), str_concat("declared-only tail (", str_concat(int_to_str(len(declared)), str_concat(", verification recipes awaiting a carrier): ", tb-join(declared, identity, " "))))),
                   list(str_concat("server.go host-IO surface (go-only, not in registry): ", int_to_str(prg-server-count(root))))))));
        }

        // ---- the analysis: list(failures, report-or-empty, go-count, entry-count, lane1, lane0); a refusal carries its one line as the failures ----
        def prg-refusal(msg) = list(list(msg), list(), 0, 0, 0, 0);
        def prg-missing(root, rel) = str_concat("missing input: ", str_concat(root, rel));
        def prg-texts(root) = list(str_concat(root, prg-go-main()), str_concat(root, prg-rs-main()), str_concat(root, prg-ts-kernel()), str_concat(root, prg-registry()), str_concat(root, prg-band()));
        def prg-read-all(paths, acc) {
            if eq(len(paths), 0) then list("ok", reverse(acc))
            else prg-read-one(head(paths), tail(paths), acc, read_file(head(paths)));
        }
        def prg-read-one(path, rest, acc, text) = if nothing?(text) then list("missing", path) else prg-read-all(rest, cons(text, acc));
        def prg-analysis(root) {
            let read = prg-read-all(prg-texts(root), list());
            if str_eq(nth(read, 0), "missing") then prg-refusal(str_concat("missing input: ", nth(read, 1))) else prg-analysis-texts(root, nth(read, 1));
        }
        def prg-analysis-texts(root, texts) {
            let entries = prg-entries(nth(texts, 3));
            let pins = prg-pins(nth(texts, 4));
            if str_eq(nth(entries, 0), "refused") then prg-refusal(nth(entries, 1))
            else if str_eq(nth(pins, 0), "refused") then prg-refusal(nth(pins, 1))
            else prg-analysis-with(root, prg-go-natives(nth(texts, 0)), prg-rs-names(nth(texts, 1)), prg-ts-names(nth(texts, 2)), nth(entries, 1), pins);
        }
        def prg-analysis-with(root, go, rs, ts, entries, pins) {
            let failures = prg-failures(go, nth(go, 1), rs, ts, entries, pins);
            list(failures, if eq(len(failures), 0) then list() else prg-report(root, go, rs, ts, entries), len(nth(go, 0)), len(entries), prg-mode-count(entries, 1), prg-mode-count(entries, 0));
        }
        def prg-a-failures(a) = nth(a, 0);
        def prg-a-report(a) = nth(a, 1);
        // the report on demand, for a green tree too (the twin prints it without --quiet)
        def prg-report-at(root) {
            let read = prg-read-all(prg-texts(root), list());
            if str_eq(nth(read, 0), "missing") then list() else prg-report-texts(root, nth(read, 1));
        }
        def prg-report-texts(root, texts) {
            let entries = prg-entries(nth(texts, 3));
            if str_eq(nth(entries, 0), "refused") then list() else prg-report(root, prg-go-natives(nth(texts, 0)), prg-rs-names(nth(texts, 1)), prg-ts-names(nth(texts, 2)), nth(entries, 1));
        }

        // ---- the voice ----
        def prg-ok-line(a) = str_concat(int_to_str(nth(a, 2)), str_concat(" natives == ", str_concat(int_to_str(nth(a, 3)), str_concat(" rows; lanes ", str_concat(int_to_str(nth(a, 4)), str_concat("+", str_concat(int_to_str(nth(a, 5)), "; band pins aligned")))))));
        def prg-print-report(lines) = if eq(len(lines), 0) then 0 else prg-print-report-one(lines);
        def prg-print-report-one(lines) {
            lx-print-prefixed("", lines);
            print("");
            0;
        }
        def prg-judge(root) {
            let a = prg-analysis(root);
            prg-print-report(prg-a-report(a));
            lx-verdict(prg-name(), prg-a-failures(a), prg-ok-line(a));
        }
        def prg-run() = prg-judge("");
    }
    prg-run();
}
