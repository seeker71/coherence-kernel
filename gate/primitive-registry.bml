// Native Form lens: the common native table (form/form-stdlib/primitive-registry.fk)
// against the kernels that carry it. main.go registers exactly the table's rows and
// sibling doors, each under the category token the table names; every row is a name
// fkwu answers (runtime/fkwu-optable.h), so fkwu compiles the table's probes; a
// lane-1 row is registered by Rust and TS too; a sibling door is a name fkwu does not
// answer; Rust and TS carry nothing beyond the table and server.go's application
// doors. The band (tests/primitive-registry-band.fk) runs the lane-1 probes.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml
import form-stdlib/bml/form-source-lift.bml;
import form-stdlib/bml-source.fk;
section [form.bml] {
    class FormPrimitiveRegistryGate {
        thought primitive-registry-pattern = ["the-table-is-the-body-every-kernel-carries-it", "fkwu-answers-every-row", "lane-1-needs-four-kernels", "a-door-is-what-fkwu-cannot-name", "twin-voice-byte-for-byte"];

        def prg-name() = "primitive-registry";
        def prg-go-main() = "form/form-kernel-go/main.go";
        def prg-go-server() = "form/form-kernel-go/server.go";
        def prg-rs-main() = "form/form-kernel-rust/src/main.rs";
        def prg-ts-kernel() = "form/form-kernel-ts/src/kernel.ts";
        def prg-optable() = "runtime/fkwu-optable.h";
        def prg-registry() = "form/form-stdlib/primitive-registry.fk";
        def prg-cat(constructor, token) = [constructor, token];
        def prg-cats() = [prg-cat("catCall", "call"), prg-cat("catAccess", "access"), prg-cat("catMethod", "method"), prg-cat("catCompare", "compare"), prg-cat("catListNat", "list"), prg-cat("catWitness", "witness"), prg-cat("catUndefined", "undefined")];
        // the token of a Go constructor, or "" when it has none
        def prg-token-of(c) {
            let row = tb-first(prg-cats(), r => (String) r[0] == c) ?? [];
            (Comparable) len(row) == 0 ? "" : row[1];
        }
        def prg-when(cond, msg) = cond ? [msg] : [];

        // ---- (name, token) rows ----
        def prg-row-name(r) = r[0];
        def prg-row-token(r) = r[1];
        def prg-lookup(rows, name) = tb-first(rows, r => (String) r[0] == name) ?? [];
        def prg-has?(rows, name) = (Comparable) len(prg-lookup(rows, name)) == 0 ? 0 : 1;
        def prg-names(rows) = tb-map(rows, prg-row-name);

        // ---- a quoted name at i: "name" -> list(name, end-after-quote) or list() ----
        def prg-quoted(text, i) {
            (Comparable) lx-at?(text, i, "\"") == 0 ? [] : prg-quoted-end(text, i + 1, str_find(text, "\"", i + 1));
        }
        def prg-quoted-end(text, a, b) = b < 0 ? [] : (Comparable) b == a ? [] : [substring(text, a, b), b + 1];

        // ---- Go: list(rows(name token), dups) from k.registerNative(\s*"name",\s*(cat[A-Za-z]+)\( ----
        def prg-go-calls(text) = prg-go-calls-go(text, "k.registerNative(", 0, []);
        def prg-go-calls-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? reverse(acc) : prg-go-calls-go(text, needle, i + 1, prg-go-call-at(text, lx-skip-ws(text, i + len(needle)), acc));
        }
        def prg-go-call-at(text, i, acc) {
            let q = prg-quoted(text, i);
            (Comparable) len(q) == 0 ? acc : (Comparable) lx-at?(text, q[1], ",") == 0 ? acc : prg-go-call-cat(text, q[0], lx-skip-ws(text, q[1] + 1), acc);
        }
        def prg-go-call-cat(text, name, k, acc) {
            let e = prg-span-alpha(text, k + 3);
            (Comparable) lx-at?(text, k, "cat") == 0 ? acc
            : (Comparable) lx-at?(text, e, "(") == 0 ? acc
            : cons([name, prg-go-token(substring(text, k, e))], acc);
        }
        def prg-go-token(c) {
            let token = prg-token-of(c);
            (Comparable) len(token) == 0 ? c : token;
        }
        def prg-span-alpha(s, i) = ((Comparable) lx-upper-at?(s, i) == 1) || ((Comparable) lx-lower-at?(s, i) == 1) ? prg-span-alpha(s, i + 1) : i;
        // insertion in order, last token wins, duplicates named
        def prg-go-natives(text) = prg-go-absorb(prg-go-calls(text), [], []);
        def prg-go-absorb(rows, out, dups) {
            (Comparable) len(rows) == 0 ? [out, dups]
            : (Comparable) prg-has?(out, prg-row-name(rows[0])) == 1 ? prg-go-absorb(rows[1:], prg-go-replace(out, rows[0]), append(dups, [prg-row-name(rows[0])]))
            : prg-go-absorb(rows[1:], append(out, [rows[0]]), dups);
        }
        def prg-go-replace(out, r) = (Comparable) len(out) == 0 ? [] : (String) prg-row-name(out[0]) == prg-row-name(r) ? cons(r, out[1:]) : cons(out[0], prg-go-replace(out[1:], r));

        // ---- every "name" that follows needle (after optional blanks) ----
        def prg-quoted-after(text, needle) = prg-quoted-after-go(text, needle, 0, []);
        def prg-quoted-after-go(text, needle, from, acc) {
            let i = str_find(text, needle, from);
            i < 0 ? reverse(acc) : prg-quoted-after-go(text, needle, i + 1, prg-quoted-cons(prg-quoted(text, lx-skip-ws(text, i + len(needle))), acc));
        }
        def prg-quoted-cons(q, acc) = (Comparable) len(q) == 0 ? acc : cons(q[0], acc);
        // ---- Rust: register_native( "name"; TypeScript: registerNative( "name" and [ "name", RBasic. table rows ----
        def prg-rs-names(text) = lx-str-uniq(prg-quoted-after(text, "register_native("));
        def prg-ts-names(text) = lx-str-uniq(append(prg-quoted-after(text, "registerNative("), prg-ts-table-names(text)));
        def prg-ts-table-names(text) = prg-ts-table-go(text, 0, []);
        def prg-ts-table-go(text, from, acc) {
            let i = str_find(text, "[", from);
            i < 0 ? reverse(acc) : prg-ts-table-go(text, i + 1, prg-ts-table-at(text, prg-quoted(text, lx-skip-ws(text, i + 1)), acc));
        }
        def prg-ts-table-at(text, q, acc) {
            (Comparable) len(q) == 0 ? acc
            : (Comparable) prg-ts-name-chars?(q[0], 0) == 0 ? acc
            : prg-ts-table-comma(text, q[0], lx-skip-ws(text, q[1]), acc);
        }
        def prg-ts-name-chars?(s, i) = i >= len(s) ? 1 : ((Comparable) lx-lower-at?(s, i) == 1) || (((Comparable) lx-digit-at?(s, i) == 1) || (((Comparable) str_byte_at(s, i) == 95) || (((Comparable) str_byte_at(s, i) == 63) || ((Comparable) str_byte_at(s, i) == 45)))) ? prg-ts-name-chars?(s, i + 1) : 0;
        def prg-ts-table-comma(text, name, k, acc) = (Comparable) lx-at?(text, k, ",") == 0 ? acc : (Comparable) lx-at?(text, lx-skip-ws(text, k + 1), "RBasic.") == 0 ? acc : cons(name, acc);

        // ---- the table: list("ok", rows, doors) or list("refused", message) ----
        // a row is (name token spec expected mode has-verify); a door is (name token spec)
        def prg-e-name(e) = e[0];
        def prg-e-token(e) = e[1];
        def prg-e-spec(e) = e[2];
        def prg-e-mode(e) = e[4];
        def prg-e-verify?(e) = e[5];
        // Read normalized Form structure, so punctuation inside strings and
        // compiler-emitted constant string composition cannot change a row.
        def prg-forms(nodes,op) = foldl((out,node) => append(out,
            fsl-op(node) == op ? [node] : prg-forms(fsl-kids(node),op)),[],nodes);
        def prg-entries(text) {
            let nodes = fsl-parse(text);
            let defined = map(node => fsl-word(fsl-kids(node)[1]),prg-forms(nodes,"defn"));
            let rows = map(node => prg-entry-node(fsl-kids(node)[1:],defined),prg-forms(nodes,"prim"));
            let doors = map(node => prg-door-node(fsl-kids(node)[1:]),prg-forms(nodes,"prim-door"));
            all?(row => !nothing?(row),rows) && all?(door => !nothing?(door),doors) ? ["ok",rows,doors] : ["refused","a row needs three constant strings, a verifier, an integer expectation and lane 0 or 1; a door needs three constant strings"];
        }
        def prg-entry-node(args,defined) {
            len(args) != 6 ? fail : {
                let strings = map(fsl-constant-string,take(3,args));
                let expected = fsl-word(args[4]); let mode = fsl-word(args[5]);
                (any?(value => nothing?(value),strings) || !fsl-int?(expected) || (mode != "0" && mode != "1")) ? fail : {
                    let verifier = fsl-word(args[3]);
                    let verified = nil?(fsl-kids(args[3])) && substring(verifier,0,3) == "pv-" ? lx-str-in?(defined,verifier) : verifier != "" || !nil?(fsl-kids(args[3]));
                    append(strings,[str_to_int(expected),str_to_int(mode),verified]);
                };
            };
        }
        def prg-door-node(args) {
            len(args) != 3 ? fail : {
                let strings = map(fsl-constant-string,args);
                any?(value => nothing?(value),strings) ? fail : strings;
            };
        }

        // ---- counts ----
        def prg-mode-count(entries, m) = len(filter(e => (Comparable) prg-e-mode(e) == m, entries));
        def prg-lane1-names(entries) = tb-map(filter(e => (Comparable) prg-e-mode(e) == 1, entries), prg-e-name);
        def prg-yn(set, name) = (Comparable) lx-str-in?(set, name) == 1 ? "y" : "n";

        // ---- failures, in the reading order ----
        // apps: the application doors server.go registers (pg, config, volatile cells),
        // the one surface a sibling carries beyond the table
        def prg-failures(go, apps, rs, ts, fk, entries, doors) {
            let table = append(tb-map(entries, prg-e-name), tb-map(doors, prg-e-name));
            let carried = append(table, apps);
            let gonames = prg-names(go[0]);
            append(prg-when(len(go[1]) > 0, "duplicate registerNative in main.go: " ++ lx-py-str-list(lx-str-sort(lx-str-uniq(go[1])))),
            append(prg-list-failure(lx-str-sort(lx-str-minus(gonames, table)), "main.go natives missing from the table: "),
            append(prg-list-failure(lx-str-sort(lx-str-minus(table, gonames)), "table names not registered in main.go: "),
            append(prg-drift-failures(lx-str-sort(lx-str-common(gonames, table)), go[0], append(entries, doors)),
            append(prg-list-failure(lx-str-sort(lx-str-minus(tb-map(entries, prg-e-name), fk)), "rows fkwu does not answer (a sibling door, or a name fkwu needs): "),
            append(prg-list-failure(lx-str-sort(lx-str-common(tb-map(doors, prg-e-name), fk)), "doors fkwu answers (each is a row now): "),
            append(prg-list-failure(lx-str-sort(lx-str-minus(rs, carried)), "Rust carries names off the table: "),
            append(prg-list-failure(lx-str-sort(lx-str-minus(ts, carried)), "TS carries names off the table: "),
                   prg-entry-failures(entries, rs, ts)))))))));
        }
        def prg-list-failure(names, voice) = prg-when(len(names) > 0, voice ++ lx-py-str-list(names));
        def prg-drift-failures(names, go, entries) {
            (Comparable) len(names) == 0 ? []
            : append(prg-drift-one(names[0], prg-row-token(prg-lookup(go, names[0])), prg-e-token(prg-lookup(entries, names[0]))), prg-drift-failures(names[1:], go, entries));
        }
        def prg-drift-one(name, want, got) = prg-when(!((String) want == got), "category drift " ++ name ++ ": go declares " ++ want ++ ", the table holds " ++ got);
        def prg-entry-failures(entries, rs, ts) {
            (Comparable) len(entries) == 0 ? []
            : append(prg-entry-one(entries[0], rs, ts), prg-entry-failures(entries[1:], rs, ts));
        }
        def prg-entry-one(e, rs, ts) {
            let name = prg-e-name(e);
            let gapped = ((Comparable) lx-str-in?(rs, name) == 0) || ((Comparable) lx-str-in?(ts, name) == 0);
            append(prg-when(((Comparable) prg-e-mode(e) == 1) && gapped, "lane-1 row " ++ name ++ " is sibling-gapped (rust=" ++ prg-yn(rs, name) ++ " ts=" ++ prg-yn(ts, name) ++ ")"),
            append(prg-when((Comparable) lx-blank?(prg-e-spec(e)) == 1, "empty spec for " ++ name),
                   prg-when((Comparable) prg-e-verify?(e) == 0, "no verification recipe declared for " ++ name)));
        }

        // ---- the report: computed only when there is a report to print ----
        // categories by count, descending, first appearance breaking ties
        def prg-cat-counts(entries) = prg-cat-counts-go(tb-map(entries, prg-e-token), []);
        def prg-cat-counts-go(tokens, acc) = (Comparable) len(tokens) == 0 ? acc : prg-cat-counts-go(tokens[1:], prg-cat-bump(acc, tokens[0]));
        def prg-cat-bump(acc, token) = (Comparable) prg-has?(acc, token) == 0 ? append(acc, [[token, 1]]) : prg-cat-bump-in(acc, token);
        def prg-cat-bump-in(acc, token) = (String) acc[0][0] == token ? cons([token, acc[0][1] + 1], acc[1:]) : cons(acc[0], prg-cat-bump-in(acc[1:], token));
        def prg-cat-sort(rows) = prg-cat-sort-go(rows, []);
        def prg-cat-sort-go(rows, acc) = (Comparable) len(rows) == 0 ? acc : prg-cat-sort-go(rows[1:], prg-cat-insert(rows[0], acc));
        def prg-cat-insert(r, sorted) = (Comparable) len(sorted) == 0 ? [r] : r[1] > sorted[0][1] ? cons(r, sorted) : cons(sorted[0], prg-cat-insert(r, sorted[1:]));
        def prg-cat-voice(r) = r[0] ++ ":" ++ r[1].str();
        def prg-report(go, apps, entries, doors) = [
            "natives: " ++ len(go[0]).str() ++ " (go main.go)  table: " ++ len(entries).str() ++ " rows + " ++ len(doors).str() ++ " sibling doors",
            "lanes: " ++ prg-mode-count(entries, 1).str() ++ " four-way verified  ·  " ++ prg-mode-count(entries, 0).str() ++ " declared",
            "categories: " ++ tb-join(prg-cat-sort(prg-cat-counts(append(entries, doors))), prg-cat-voice, "  "),
            "server.go application doors (beside the table): " ++ len(apps).str()];

        // ---- the analysis: list(failures, report-or-empty, go-count, row-count, door-count, lane1, lane0) ----
        def prg-refusal(msg) = [[msg], [], 0, 0, 0, 0, 0];
        def prg-texts(root) = [root ++ prg-go-main(), root ++ prg-rs-main(), root ++ prg-ts-kernel(), root ++ prg-registry(), root ++ prg-optable(), root ++ prg-go-server()];
        def prg-read-all(paths, acc) {
            (Comparable) len(paths) == 0 ? ["ok", reverse(acc)]
            : prg-read-one(paths[0], paths[1:], acc, read_file(paths[0]));
        }
        def prg-read-one(path, rest, acc, text) = nothing?(text) ? ["missing", path] : prg-read-all(rest, cons(text, acc));
        def prg-analysis(root) {
            let read = prg-read-all(prg-texts(root), []);
            (String) read[0] == "missing" ? prg-refusal("missing input: " ++ read[1]) : prg-analysis-texts(root, read[1]);
        }
        def prg-analysis-texts(root, texts) {
            let table = prg-entries(form-source-compile-text(texts[3],root + prg-registry()));
            (String) table[0] == "refused" ? prg-refusal(table[1])
            : prg-analysis-with(prg-go-natives(texts[0]), prg-names(prg-go-calls(texts[5])), prg-rs-names(texts[1]), prg-ts-names(texts[2]), bml-source-reserved-heads(texts[4]), table[1], table[2]);
        }
        def prg-analysis-with(go, apps, rs, ts, fk, entries, doors) {
            let failures = prg-failures(go, apps, rs, ts, fk, entries, doors);
            [failures, (Comparable) len(failures) == 0 ? [] : prg-report(go, apps, entries, doors), len(go[0]), len(entries), len(doors), prg-mode-count(entries, 1), prg-mode-count(entries, 0)];
        }
        def prg-a-failures(a) = a[0];
        def prg-a-report(a) = a[1];

        // ---- the voice ----
        def prg-ok-line(a) = a[2].str() ++ " natives == " ++ a[3].str() ++ " rows + " ++ a[4].str() ++ " sibling doors; lanes " ++ a[5].str() ++ "+" ++ a[6].str() ++ "; every row a name fkwu answers";
        def prg-print-report(lines) = (Comparable) len(lines) == 0 ? 0 : prg-print-report-one(lines);
        def prg-print-report-one(lines) {
            lx-print-prefixed("", lines);
            print("");
            0;
        }
        def prg-judge(root) {
            let a = prg-analysis(root);
            prg-print-report(prg-a-report(a));
            lx-verdict(prg-name(), prg-a-failures(a), prg-ok-line(a));
        }
        def prg-run() = prg-judge("");
    }
    prg-run();
}
