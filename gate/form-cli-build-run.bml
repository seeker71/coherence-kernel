// form-cli-build-run.bml — install, copy, build or prove the native form-cli.
//
//   ./fkwu gate/form-cli-build-run.bml </dev/null                         form/form-cli becomes the link to this host's published, verified bundle
//   printf '{"out":"/path/form-cli"}' | ./fkwu gate/form-cli-build-run.bml   a copy at that path (a relative path is under form/)
//   printf '{"regen":1}' | ./fkwu gate/form-cli-build-run.bml               publish the sealed source identity and this host's bundle
//   printf '{"prove":"/path/form-cli"}' | ./fkwu gate/form-cli-build-run.bml   the behavioral proof of an executable
//
// stdin is one JSON object, every key optional: out (a copy; with none the default install), regen (1 regenerates form-stdlib/bootstrap,
// or out_dir), prove (an executable; sha names the source identity it must answer, else the checkout's published one), retain (1 keeps
// the work directory of a failed candidate), force_link (1 builds the native startup even when a bundle is published), cc (the C
// compiler, cc). Run from the repository root. form-stdlib/bootstrap is regenerable output of the sources it seals (git ignores it):
// a checkout that holds no current generation regenerates it on an install, and builds a copy inside a private copy of the body so
// its own bundle stays untouched. The flows are form-stdlib/bml/form-cli-build-flow.bml over form-cli-build.bml; the proof is
// form-cli-prove.bml; the roots of the identity are form-stdlib/form-cli-source-roots.txt. The C compiler is the one external tool
// the seed needs to be built, begun by argv through host-child; the rest is Form.
//
// A flow that held answers 0; one that did not prints its reason and ends in an error naming it (exit 1).
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/form-cli-build-flow.bml form-stdlib/bml/form-cli-prove.bml
section [form.bml] {
 class FormCliBuildRun {
  def fbr-doc(text) = len(trim(text)) == 0 ? json-node-object([]) : parse-json("form-cli-build-options", text);
  def fbr-str(doc, key, fallback) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : fallback;
  def fbr-int(doc, key, fallback) = json-object-has?(doc, key) ? (json-int-value(json-object-get(doc, key)) ?? fallback) : fallback;
  def fbr-opts(doc) = record_new(0, "out", fbr-str(doc, "out", "form-cli"), "explicit", len(fbr-str(doc, "out", "")) > 0 ? 1 : fbr-int(doc, "explicit", 0), "private", fbr-int(doc, "private", 0), "retain", fbr-int(doc, "retain", 0), "force_link", fbr-int(doc, "force_link", 0), "cc", fbr-str(doc, "cc", "cc"), "out_dir", fbr-str(doc, "out_dir", fcb-boot-default()), "bootstrap_dir", "", "regenerated", 0);
  def fbr-sha(doc) {
   let named = fbr-str(doc, "sha", "");
   len(named) > 0 ? named : fcb-trim-file(fcb-boot-default() ++ "/form-cli.source.sha256");
  }
  def fbr-flow(doc) = len(fbr-str(doc, "prove", "")) > 0 ? fcp-prove(fbr-str(doc, "prove", ""), fbr-sha(doc)) : fbr-int(doc, "regen", 0) == 1 ? fcb-regen(fbr-opts(doc)) : fcb-build(fbr-opts(doc));
  def fbr-end(why) {
   let said = len(why) > 0 ? print_str(why) : 0;
   len(why) > 0 ? form_error("form-cli-build: " ++ why) : 0;
  }
 }
 let doc = fbr-doc(stdin-text());
 let proved = len(fbr-str(doc, "prove", "")) > 0;
 let why = fbr-flow(doc);
 let said = proved && len(why) == 0 ? print_str("form-cli behavioral proof: OK (identity, v2/v1, exact bytes, 1546-row rank, embed batch/cap, request HMAC/replay)") : 0;
 fbr-end(why);
}
