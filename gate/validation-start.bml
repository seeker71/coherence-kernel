// The existing validation-start checks, selected and interpreted by Form.
// Shared gate rows retain their one command/verdict home in drift-gates.bml.
// preludes: gate/drift-gates.bml
section [form.bml] {
 class NativeValidationStart {
  def nvs-find(rows, name) = if nil?(rows) then list() else if str_eq(dg-name(head(rows)), name) then head(rows) else nvs-find(tail(rows), name);
  def nvs-rows() = list(nvs-find(dg-rows(), "native-surface"), dg-row("flt-ops-gen", "./fkwu gate/flt-ops-gen.bml", 1), nvs-find(dg-rows(), "op-manifest"), nvs-find(dg-rows(), "category-contract"), nvs-find(dg-rows(), "primitive-registry"));
  def nvs-run() {
   let rows = nvs-rows();
   if not(dg-rows-sound?(rows)) then 0 else dg-green?(dg-run(rows), rows);
  }
 }
 0;
}
