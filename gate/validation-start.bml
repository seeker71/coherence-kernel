// The existing validation-start checks, selected and interpreted by Form.
// Shared gate rows retain their one command/verdict home in drift-gates.bml.
// preludes: gate/drift-gates.bml
section [form.bml] {
 class NativeValidationStart {
  def nvs-find(rows, name) = nil?(rows) ? [] : (String) dg-name(rows[0]) == name ? rows[0] : nvs-find(rows[1:], name);
  def nvs-rows() = [nvs-find(dg-all-rows(), "native-surface"), nvs-find(dg-all-rows(), "flt-ops-gen"), nvs-find(dg-all-rows(), "op-manifest"), nvs-find(dg-all-rows(), "category-contract"), nvs-find(dg-all-rows(), "primitive-registry")];
  def nvs-run() {
   let rows = nvs-rows();
   !dg-rows-sound?(rows) ? 0 : dg-green?(dg-run(rows), rows);
  }
 }
 0;
}
