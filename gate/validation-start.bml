// The existing validation-start checks, selected and interpreted by Form.
// Shared gate rows retain their one command/verdict home in drift-gates.bml.
// preludes: gate/drift-gates.bml
section [form.bml] {
 class NativeValidationStart {
  def nvs-find(rows, name) = nil?(rows) ? list() : (String) dg-name(head(rows)) == name ? head(rows) : nvs-find(tail(rows), name);
  def nvs-rows() = list(nvs-find(dg-all-rows(), "native-surface"), dg-row("flt-ops-gen", "./fkwu gate/flt-ops-gen.bml", 1), nvs-find(dg-all-rows(), "op-manifest"), nvs-find(dg-all-rows(), "category-contract"), nvs-find(dg-all-rows(), "primitive-registry"));
  def nvs-run() {
   let rows = nvs-rows();
   !dg-rows-sound?(rows) ? 0 : dg-green?(dg-run(rows), rows);
  }
 }
 0;
}
