; tests/flt-ops-gen-band.fk — the flt-ops-gen lens (the generator's check
; half) judges as its Python twin judges, on the live tree and under planted
; drift.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk gate/flt-ops-gen.bml
;
; run: ./fkwu gate/tests/flt-ops-gen-band.fk   ; -> 63
;
; The lens's top-level statement runs the live judgment when preluded, so a
; run of this band prints the body's own flt-ops-gen line first; the verdict
; is the last line and the exit code.
;
; Bits 2 and 8 run the Python twin through host-exec. They are the agreement
; proof R58 asks for and they stand only while the script stands: when
; form/scripts/gen_flt_ops_from_manifest.py leaves the tree (R59/R60), these
; two bits go red on purpose and the hand that removes the script re-declares
; this band without them.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane.
;
; Verdict 63:
;   1      the live tree: the manifest and the slice are one sequence
;   2      the live twin agrees byte for byte: its OK line, module name mapped
;          to the lens's, equals the lens's OK line, and it exits 0
;   4      planted: the manifest without its str_len row — the drift line, the
;          script's words
;   8      the same plant in a scratch tree read by the twin: its error line
;          is that same line byte for byte, exit 1
;   16     planted: a variadic manifest row refuses in the ValueError's words
;          before any comparison
;   32     sequence, not set: the slice's first two rows swapped is the same
;          set and refuses here (gate/op-manifest.bml holds it green); one
;          extra slice row refuses too

(do
    (defn fgb-k (ok bit) (if ok bit 0))
    (defn fgb-twin (command)
        (do (let out (host-exec (dg-wrap command) ""))
            (if (nothing? out) (list (sub 0 1) (list))
                (list (dg-rc out) (lx-lines (lx-strip-nl (dg-body out)))))))
    (defn fgb-twin-name () "gen_flt_ops_from_manifest")
    (defn fgb-map (line) (lx-replace-prefix line (fgb-twin-name) (fog-name)))
    (defn fgb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn fgb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (fgb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn fgb-without (rows name)
        (if (eq (len rows) 0) (list)
            (if (str_eq (nth (head rows) 0) name) (fgb-without (tail rows) name)
                (cons (head rows) (fgb-without (tail rows) name)))))
    (defn fgb-scratch-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-stdlib && cp form/scripts/gen_flt_ops_from_manifest.py $D/form/scripts/ && cp form/form-stdlib/form-flatten.fk $D/form/form-stdlib/"
                    " && grep -v '(nom-row \"str_len\" ' form/form-stdlib/native-op-manifest.fk > $D/form/form-stdlib/native-op-manifest.fk && python3 $D/form/scripts/gen_flt_ops_from_manifest.py; R=$?; rm -rf $D; exit $R"))
    (defn flt-ops-gen-band ()
        (do
            (let flt (flt-ops))
            (let nom (nom-ops))
            (let live (fgb-twin "python3 form/scripts/gen_flt_ops_from_manifest.py"))
            (let planted (fgb-twin (fgb-scratch-command)))
            (let swapped (cons (nth flt 1) (cons (head flt) (tail (tail flt)))))
            (sum (list
                (fgb-k (eq (len (fog-errors flt nom)) 0) 1)
                (fgb-k (and (eq (head live) 0)
                            (str_eq (fgb-map (fgb-last (nth live 1))) (str_concat (fog-name) (str_concat ": OK " (fog-ok-line nom))))) 2)
                (fgb-k (fgb-lines-eq? (fog-errors flt (fgb-without nom "str_len")) (list (fog-drift-line))) 4)
                (fgb-k (and (eq (head planted) 1)
                            (str_eq (fgb-last (nth planted 1)) (str_concat "error: " (fog-drift-line)))) 8)
                (fgb-k (fgb-lines-eq? (fog-errors flt (cons (list "print" -1 239 "variadic") nom))
                                      (list "variadic (arity<0) rows cannot ride the manifest lane: [('print', -1, 239)]")) 16)
                (fgb-k (and (fgb-lines-eq? (fog-errors swapped nom) (list (fog-drift-line)))
                            (fgb-lines-eq? (fog-errors (append flt (list (list "zz" 1 150))) nom) (list (fog-drift-line)))) 32)))))
    (flt-ops-gen-band))
