; tests/kernel-conformance-band.fk — the kernel-conformance lens orchestrates
; the real kernels as its Python twin does, reads an absent kernel as a typed
; finding, and agrees with the twin's verdict on the live tree.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/json.fk gate/kernel-conformance.bml
;
; run: ./fkwu gate/tests/kernel-conformance-band.fk   ; -> 511
;
; The lens's top-level statement runs the live orchestration when preluded
; (Go and Rust built from cache, every vector on every kernel present, the
; FORMBIN2 interop, the twelve malformed artifacts), so a run of this band
; prints the body's own conformance report first; the verdict is the last
; line and the exit code.
;
; The TypeScript kernel is present when `npm ci` has been run in
; form/form-kernel-ts. Bits 16 and 32 read that state and hold the lens and
; the twin to the SAME verdict in either state: absent, both refuse (the twin
; in a traceback before any vector runs, the lens after proving the Go and
; Rust halves, naming the absence); present, both pass the thirteen vectors
; on three kernels. A planted divergence cannot be handed to the twin while
; TypeScript is absent (it refuses before reading a vector), so bit 128
; proves the lens's own reading of a wrong expectation — the twin's side of
; that proof is pending until the TypeScript dependencies land.
;
; Bit 32 runs the Python twin through host-exec. It is the agreement proof
; R58 asks for and stands only while the script stands; when
; form/scripts/verify_kernel_conformance.py leaves the tree (R59/R60) the
; hand that removes it re-declares this band without that bit.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane and drives
; the kernels through the membrane.
;
; Verdict 511:
;   1      the vectors read: schema form-kernel-conformance-v1, thirteen cases
;          of name, form and expected; the malformed vectors read: twelve
;   2      every canonical expression passes on every kernel present
;   4      FORMBIN2 interop: every kernel reads every kernel's artifact to the
;          one rendering, and the sibling bytes are identical
;   8      every malformed artifact is refused by every kernel present with
;          the expected words
;   16     the typed absence: TypeScript absent -> exactly one error, the
;          absence line, status fail; present -> no error, status pass
;   32     the twin agrees on the verdict: absent -> it exits 1 naming the
;          absent dependencies; present -> it exits 0 with the lens's summary
;          after its PASS
;   64     the vectors reader refuses in the script's words: a wrong schema,
;          an empty case list, a case without its expected
;   128    a planted expectation fails in the script's line shape:
;          FAIL name: go='42', rust='42'
;   256    the nested-composite builder: depth 1 is magic, u32(0), u32(1),
;          leaf, u32(1), leaf

(do
    (defn kcb-k (ok bit) (if ok bit 0))
    (defn kcb-all-pass? (results) (if (eq (len results) 0) 0 (kcb-all-pass-go results)))
    (defn kcb-all-pass-go (results)
        (if (eq (len results) 0) 1 (if (eq (nth (head results) 0) 1) (kcb-all-pass-go (tail results)) 0)))
    (defn kcb-starts? (s prefix) (eq (lx-at? s 0 prefix) 1))
    (defn kcb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn kcb-leaf () "0000000000000001000000010000000100000000")
    (defn kernel-conformance-band ()
        (do
            (let cases (kcg-cases (kcg-vectors) (read_file (kcg-vectors))))
            (let ms (kcg-malformed-cases (kcg-malformed) (read_file (kcg-malformed))))
            (let a (kcg-analysis))
            (let ts (kcg-a-ts a))
            (let twin (lx-sh "python3 form/scripts/verify_kernel_conformance.py"))
            (let twin-lines (lx-lines (lx-sh-text twin)))
            (let root (kcg-root))
            (let built (kcg-build-kernels root))
            (let kernels (if (str_eq (nth built 0) "ok") (nth built 1) (list)))
            (let planted (if (eq (len kernels) 0) (list 0 "") (kcg-case-line kernels (list "binary-add" "(add 20 22)" "43"))))
            (let bad-schema (kcg-cases "v.json" "{\"schema\": \"x\", \"cases\": [{\"name\": \"a\", \"form\": \"1\", \"expected\": \"1\"}]}"))
            (let no-cases (kcg-cases "v.json" "{\"schema\": \"form-kernel-conformance-v1\", \"cases\": []}"))
            (let no-expected (kcg-cases "v.json" "{\"schema\": \"form-kernel-conformance-v1\", \"cases\": [{\"name\": \"a\", \"form\": \"1\"}]}"))
            (sum (list
                (kcb-k (and (str_eq (nth cases 0) "ok")
                            (and (eq (len (nth cases 1)) 13)
                                 (and (str_eq (nth ms 0) "ok") (eq (len (nth ms 1)) 12)))) 1)
                (kcb-k (and (eq (len (kcg-a-results a)) 13) (kcb-all-pass? (kcg-a-results a))) 2)
                (kcb-k (and (eq (nth (kcg-a-interop a) 0) 1) (kcb-starts? (nth (kcg-a-interop a) 1) "PASS FORMBIN2: ")) 4)
                (kcb-k (and (eq (len (kcg-a-malformed a)) 12) (kcb-all-pass? (kcg-a-malformed a))) 8)
                (kcb-k (if (eq ts 0)
                           (and (str_eq (kcg-a-status a) "fail")
                                (and (eq (len (kcg-a-errors a)) 1) (str_eq (head (kcg-a-errors a)) (kcg-ts-absent-line))))
                           (and (str_eq (kcg-a-status a) "pass") (eq (len (kcg-a-errors a)) 0))) 16)
                (kcb-k (if (eq ts 0)
                           (and (eq (lx-sh-rc twin) 1) (ge (str_find (kcb-last twin-lines) "TypeScript kernel dependencies are absent" 0) 0))
                           (and (eq (lx-sh-rc twin) 0) (str_eq (kcb-last twin-lines) (str_concat "PASS " (kcg-summary a))))) 32)
                (kcb-k (and (str_eq (nth bad-schema 1) "v.json: unsupported conformance schema")
                            (and (str_eq (nth no-cases 1) "v.json: cases must be a non-empty list")
                                 (str_eq (nth no-expected 1) "v.json: case 0 has invalid expected"))) 64)
                (kcb-k (and (eq (nth planted 0) 0) (kcb-starts? (nth planted 1) "FAIL binary-add: go='42', rust='42'")) 128)
                (kcb-k (str_eq (kcg-composite-hex 1)
                               (str_concat (kcg-magic-hex) (str_concat "00000000" (str_concat "00000001" (str_concat (kcb-leaf) (str_concat "00000001" (kcb-leaf))))))) 256)))))
    (kernel-conformance-band))
