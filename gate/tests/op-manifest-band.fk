; tests/op-manifest-band.fk — the op-manifest lens judges as its Python twin
; judges, on the live tree and under planted drift.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk gate/op-manifest.bml
;
; run: ./fkwu gate/tests/op-manifest-band.fk   ; -> 1023
;
; The lens's top-level statement runs the live judgment when preluded, so a
; run of this band prints the body's own op-manifest line first; the verdict
; is the last line and the exit code.
;
; Bits 2 and 8 run the Python twin through host-exec. They are the agreement
; proof R58 asks for and they stand only while the script stands: when
; form/scripts/sync_native_op_manifest.py leaves the tree (R59/R60), these
; two bits go red on purpose and the hand that removes the script re-declares
; this band without them. A witness leaving is a proof re-seated, never a
; bit that passes for two reasons.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane.
;
; Verdict 1023:
;   1      the live tree: zero errors over the real tables, answer 1
;   2      the live twin agrees byte for byte: its OK line, module name mapped
;          to the lens's, equals the lens's OK line, and it exits 0
;   4      planted: the manifest without its str_len row — one error, the
;          script's words: in flt-ops but not manifest (1): [('str_len', 1, 25)]...
;   8      the same plant in a scratch tree read by the twin: its error line
;          is that same line byte for byte, its last line is FAIL, exit 1
;   16     planted: a manifest row flt-ops lacks, and both plants at once
;          keep the script's order (flt-side first, then manifest-side)
;   32     planted: the string_bytes carrier row gone from the manifest — the
;          table diff names it AND the byte-carrier assertion names it, in
;          that order
;   64     planted: a variadic row in the manifest — the manifest-side diff
;          and the arity<0 refusal both speak
;   128    planted: the obsolete string_fold lowers again — named
;   256    a root that holds no tree: one named missing input, no traceback
;   512    six offenders sort in Python's tuple order and only five are shown

(do
    (defn omb-k (ok bit) (if ok bit 0))
    (defn omb-without (rows name)
        (if (eq (len rows) 0) (list)
            (if (str_eq (nth (head rows) 0) name) (omb-without (tail rows) name)
                (cons (head rows) (omb-without (tail rows) name)))))
    (defn omb-without-all (rows names)
        (if (eq (len names) 0) rows (omb-without-all (omb-without rows (head names)) (tail names))))
    ; the twin, through the drift-gates carrier: body before @rc, rc after
    (defn omb-twin (command)
        (do (let out (host-exec (dg-wrap command) ""))
            (if (nothing? out) (list (sub 0 1) (list))
                (list (dg-rc out) (lx-lines (lx-strip-nl (dg-body out)))))))
    (defn omb-twin-name () "sync_native_op_manifest")
    (defn omb-map (line) (lx-replace-prefix line (omb-twin-name) (oms-name)))
    (defn omb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn omb-nth-from-end (lines k) (if (lt (len lines) (add k 1)) "" (nth lines (sub (sub (len lines) 1) k))))
    ; a scratch tree holding the live inputs with the str_len row grepped out of the manifest
    (defn omb-scratch-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-stdlib $D/form/form-kernel-go $D/form/form-kernel-rust/src $D/form/form-kernel-ts/src $D/flatten $D/runtime"
        (str_concat " && cp form/scripts/sync_native_op_manifest.py $D/form/scripts/ && cp form/form-stdlib/form-flatten.fk form/form-stdlib/fkc-table-serialize.fk $D/form/form-stdlib/"
        (str_concat " && grep -v '(nom-row \"str_len\" ' form/form-stdlib/native-op-manifest.fk > $D/form/form-stdlib/native-op-manifest.fk"
        (str_concat " && cp form/form-kernel-go/main.go $D/form/form-kernel-go/ && cp form/form-kernel-rust/src/main.rs $D/form/form-kernel-rust/src/ && cp form/form-kernel-ts/src/kernel.ts $D/form/form-kernel-ts/src/"
        (str_concat " && cp flatten/form-flatten.fk $D/flatten/ && cp runtime/fkwu-optable.h runtime/fkwu-uni.c $D/runtime/"
                    " && python3 $D/form/scripts/sync_native_op_manifest.py; R=$?; rm -rf $D; exit $R"))))))
    (defn omb-str-len-line () "in flt-ops but not manifest (1): [('str_len', 1, 25)]...")
    (defn omb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (omb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn op-manifest-band ()
        (do
            (let flt (flt-ops))
            (let nom (nom-ops))
            (let live (omb-twin "python3 form/scripts/sync_native_op_manifest.py"))
            (let planted (omb-twin (omb-scratch-command)))
            (let no-strlen (omb-without nom "str_len"))
            (let extra (cons (list "zz_new" 2 7 "binary") nom))
            (let both (cons (list "zz_new" 2 7 "binary") no-strlen))
            (let no-carrier (omb-without nom "string_bytes"))
            (let variadic (cons (list "print" -1 239 "variadic") nom))
            (let obsolete (cons (list "string_fold" 3 206 "binary") nom))
            (let six (omb-without-all nom (list "tail" "head" "add" "sub" "le" "nth")))
            (let six-errors (oms-errors flt six ""))
            (sum (list
                (omb-k (eq (len (oms-errors flt nom "")) 0) 1)
                (omb-k (and (eq (head live) 0)
                            (str_eq (omb-map (omb-last (nth live 1))) (str_concat (oms-name) (str_concat ": OK " (oms-ok-line (len flt)))))) 2)
                (omb-k (omb-lines-eq? (oms-errors flt no-strlen "") (list (omb-str-len-line))) 4)
                (omb-k (and (eq (head planted) 1)
                            (and (str_eq (omb-nth-from-end (nth planted 1) 1) (str_concat "error: " (omb-str-len-line)))
                                 (str_eq (omb-map (omb-last (nth planted 1))) (str_concat (oms-name) ": FAIL")))) 8)
                (omb-k (and (omb-lines-eq? (oms-errors flt extra "") (list "in manifest but not flt-ops (1): [('zz_new', 2, 7)]..."))
                            (omb-lines-eq? (oms-errors flt both "") (list (omb-str-len-line) "in manifest but not flt-ops (1): [('zz_new', 2, 7)]..."))) 16)
                (omb-k (omb-lines-eq? (oms-errors flt no-carrier "")
                                      (list "in flt-ops but not manifest (1): [('string_bytes', 1, 205)]..."
                                            "byte carrier manifest mismatch: expected ('string_bytes', 1, 205)")) 32)
                (omb-k (omb-lines-eq? (oms-errors flt variadic "")
                                      (list "in manifest but not flt-ops (1): [('print', -1, 239)]..."
                                            "variadic (arity<0) row in the manifest: stdlib flt-op2 folds unknown arity as a quad -- variadic ops belong in VARIADIC_OPS + flatten/ flt-ops only")) 64)
                (omb-k (omb-lines-eq? (oms-errors flt obsolete "")
                                      (list "in manifest but not flt-ops (1): [('string_fold', 3, 206)]..."
                                            "obsolete byte carrier still lowerable: string_fold")) 128)
                (omb-k (omb-lines-eq? (oms-errors flt nom "/nonexistent-root/") (list "missing input: /nonexistent-root/form/form-stdlib/fkc-table-serialize.fk")) 256)
                (omb-k (omb-lines-eq? six-errors (list "in flt-ops but not manifest (6): [('add', 2, 3), ('head', 1, 20), ('le', 2, 5), ('nth', 2, 23), ('sub', 2, 4)]...")) 512)))))
    (op-manifest-band))
