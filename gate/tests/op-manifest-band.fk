; Native Form checks: live inputs, planted failures, and parser boundaries.
; Historical cross-language comparisons remain in git; no interpreter runs.
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/form-parse.fk form-stdlib/form-flatten.fk gate/op-manifest.bml
; witnessed: 2026-09-09 -> 1013

(do
    (defn omb-k (ok bit) (if ok bit 0))
    (defn omb-without (rows name)
        (if (eq (len rows) 0) (list)
            (if (str_eq (nth (head rows) 0) name) (omb-without (tail rows) name)
                (cons (head rows) (omb-without (tail rows) name)))))
    (defn omb-without-all (rows names)
        (if (eq (len names) 0) rows (omb-without-all (omb-without rows (head names)) (tail names))))
    ; the twin, through the drift-gates carrier: body before @rc, rc after

    ; a scratch tree holding the live inputs with the str_len row grepped out of the manifest

    (defn omb-str-len-line () "in flt-ops but not manifest (1): [('str_len', 1, 25)]...")
    (defn omb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (omb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn op-manifest-band ()
        (do
            (let flt (flt-ops))
            (let nom (nom-ops))

            (let no-strlen (omb-without nom "str_len"))
            (let extra (cons (list "zz_new" 2 7 "binary") nom))
            (let both (cons (list "zz_new" 2 7 "binary") no-strlen))
            (let no-carrier (omb-without nom "string_bytes"))
            (let variadic (cons (list "print" -1 239 "variadic") nom))
            (let obsolete (cons (list "string_fold" 3 206 "binary") nom))
            (let six (omb-without-all nom (list "tail" "head" "add" "sub" "le" "nth")))
            (let six-errors (oms-errors flt six ""))
            (sum (list
                (omb-k (eq (len (oms-errors flt nom "")) 0) 1)

                (omb-k (omb-lines-eq? (oms-errors flt no-strlen "") (list (omb-str-len-line))) 4)

                (omb-k (and (omb-lines-eq? (oms-errors flt extra "") (list "in manifest but not flt-ops (1): [('zz_new', 2, 7)]..."))
                            (omb-lines-eq? (oms-errors flt both "") (list (omb-str-len-line) "in manifest but not flt-ops (1): [('zz_new', 2, 7)]..."))) 16)
                (omb-k (omb-lines-eq? (oms-errors flt no-carrier "")
                                      (list "in flt-ops but not manifest (1): [('string_bytes', 1, 205)]..."
                                            "byte carrier manifest mismatch: expected ('string_bytes', 1, 205)")) 32)
                (omb-k (omb-lines-eq? (oms-errors flt variadic "")
                                      (list "in manifest but not flt-ops (1): [('print', -1, 239)]..."
                                            "variadic (arity<0) row in the manifest: stdlib flt-op2 folds unknown arity as a quad -- variadic ops belong in VARIADIC_OPS + flatten/ flt-ops only")) 64)
                (omb-k (omb-lines-eq? (oms-errors flt obsolete "")
                                      (list "in manifest but not flt-ops (1): [('string_fold', 3, 206)]..."
                                            "obsolete byte carrier still lowerable: string_fold")) 128)
                (omb-k (omb-lines-eq? (oms-errors flt nom "/nonexistent-root/") (list "missing input: /nonexistent-root/form/form-stdlib/fkc-table-serialize.fk")) 256)
                (omb-k (omb-lines-eq? six-errors (list "in flt-ops but not manifest (6): [('add', 2, 3), ('head', 1, 20), ('le', 2, 5), ('nth', 2, 23), ('sub', 2, 4)]...")) 512)))))
    (op-manifest-band))
