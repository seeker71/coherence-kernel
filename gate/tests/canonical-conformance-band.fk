; Canonical expressions on fkwu, the pinned FORMBIN2 artifact and the twelve malformed artifacts.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk gate/canonical-conformance.bml
;
; run: ./fkwu gate/tests/canonical-conformance-band.fk   ; -> 1023
;
; fkwu is the only runtime: its own answers and the Form codec's are held to values pinned from
; what the Go, Rust and TypeScript kernels agreed on at their last asking (the fixtures under
; form/conformance and the literals in gate/canonical-conformance.bml). Bit 4 reads the pinned
; kernel artifact; bit 16 the codec's own; bit 32 plants a flipped byte in the pinned artifact
; and shows the gate refuse it.
;
; Verdict 1023:
;   1      the vectors read: schema form-canonical-conformance-v1, thirteen cases
;          of name, form and expected; the malformed vectors read: twelve
;   2      every canonical expression answers its pinned text on fkwu
;   4      FORMBIN2 interop: the pinned kernel artifact holds its SHA-256, decodes to
;          the one rendering fkwu computes from the source and re-encodes byte for byte
;   8      every malformed artifact is refused by the Form codec with the expected words
;   16     the codec's own artifact equals its pinned bytes and SHA-256 and decodes to its rendering
;   32     a byte flipped in the pinned artifact is seen: the decoded rendering departs from the pin
;   64     the vectors reader refuses in the script's words: a wrong schema,
;          an empty case list, a case without its expected
;   128    a planted expectation fails in the script's line shape:
;          FAIL name: fkwu='42'
;   256    the nested-composite builder: depth 1 is magic, u32(0), u32(1),
;          leaf, u32(1), leaf
;   512    the scratch the analysis wrote is gone (nothing of this process's is left in the
;          temp directory), and a unit run in process (cell_run: 42 for (add 20 22)) leaves exactly
;          itself beside it, no image, and leaves with its reading

(do
    (defn cvb-k (ok bit) (if ok bit 0))
    (defn cvb-all-pass? (results) (if (eq (len results) 0) 0 (cvb-all-pass-go results)))
    (defn cvb-all-pass-go (results)
        (if (eq (len results) 0) 1 (if (eq (nth (head results) 0) 1) (cvb-all-pass-go (tail results)) 0)))
    (defn cvb-starts? (s prefix) (eq (lx-at? s 0 prefix) 1))
    (defn cvb-leaf () "0000000000000001000000010000000100000000")
    ; the pinned artifact with its 42 leaf made 43: the gate must see the rendering depart
    (defn cvb-flipped ()
        (do
            (let hex (cvg-interop-hex))
            (let at (str_find hex "0000002a" 0))
            (str_concat (substring hex 0 at) (str_concat "0000002b" (substring hex (add at 8) (len hex))))))
    (defn canonical-conformance-band ()
        (do
            (let cases (cvg-cases (cvg-vectors) (read_file (cvg-vectors))))
            (let ms (cvg-malformed-cases (cvg-malformed) (read_file (cvg-malformed))))
            (let a (cvg-analysis))
            (let flipped (cvg-hex-str (cvb-flipped)))
            (let flipped-errors (cvg-interop-decoded flipped (fbc-decode flipped)))
            (let planted (cvg-case-line (list "binary-add" "(add 20 22)" "43") 0))
            (let bad-schema (cvg-cases "v.json" "{\"schema\": \"x\", \"cases\": [{\"name\": \"a\", \"form\": \"1\", \"expected\": \"1\"}]}"))
            (let no-cases (cvg-cases "v.json" "{\"schema\": \"form-canonical-conformance-v1\", \"cases\": []}"))
            (let no-expected (cvg-cases "v.json" "{\"schema\": \"form-canonical-conformance-v1\", \"cases\": [{\"name\": \"a\", \"form\": \"1\"}]}"))
            ; the scratch the analysis above wrote is gone; then a unit planted in the scratch directory and
            ; run in process leaves exactly itself (a cell_run writes no image beside its unit), and leaves with its reading
            (let clean (cvg-leftovers))
            (let plant-path (str_concat (cvg-scratch "plant") ".fk"))
            (let plant-wrote (write_file plant-path "(add 20 22)\n"))
            (let plant-ran (cell_run plant-path 0 60000 (nothing)))
            (let dirty (cvg-leftovers))
            (let tidied (cvg-leave plant-path))
            (let after (cvg-leftovers))
            (sum (list
                (cvb-k (and (str_eq (nth cases 0) "ok")
                            (and (eq (len (nth cases 1)) 13)
                                 (and (str_eq (nth ms 0) "ok") (eq (len (nth ms 1)) 12)))) 1)
                (cvb-k (and (eq (len (cvg-a-results a)) 13) (cvb-all-pass? (cvg-a-results a))) 2)
                (cvb-k (and (eq (nth (cvg-a-interop a) 0) 1) (cvb-starts? (nth (cvg-a-interop a) 1) "PASS FORMBIN2: ")) 4)
                (cvb-k (and (eq (len (cvg-a-malformed a)) 12) (cvb-all-pass? (cvg-a-malformed a))) 8)
                (cvb-k (and (eq (len (cvg-a-native a)) 0) (str_eq (cvg-a-status a) "pass")) 16)
                (cvb-k (gt (len flipped-errors) 0) 32)
                (cvb-k (and (str_eq (nth bad-schema 1) "v.json: unsupported conformance schema")
                            (and (str_eq (nth no-cases 1) "v.json: cases must be a non-empty list")
                                 (str_eq (nth no-expected 1) "v.json: case 0 has invalid expected"))) 64)
                (cvb-k (and (eq (nth planted 0) 0) (cvb-starts? (nth planted 1) "FAIL binary-add: fkwu='42'")) 128)
                (cvb-k (str_eq (cvg-composite-hex 1)
                               (str_concat (cvg-magic-hex) (str_concat "00000000" (str_concat "00000001" (str_concat (cvb-leaf) (str_concat "00000001" (cvb-leaf))))))) 256)
                (cvb-k (and (str_eq clean "")
                            (and (eq (record_get plant-ran "value") 42)
                                 (and (str_eq dirty (str_concat (cvg-prefix) "plant.fk\n")) (str_eq after "")))) 512)))))
    (canonical-conformance-band))
