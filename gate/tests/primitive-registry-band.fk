; tests/primitive-registry-band.fk — the primitive-registry lens judges as its
; Python twin judges, on the live tree and over one planted scratch tree that
; both read.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml gate/primitive-registry.bml
;
; run: ./fkwu gate/tests/primitive-registry-band.fk   ; -> 511
;
; The lens's top-level statement runs the live judgment when preluded, so a
; run of this band prints the body's own primitive-registry line first; the
; verdict is the last line and the exit code.
;
; The planted tree is built once by host-exec (mktemp -d; the six texts and
; the 1,873 stdlib bands copied; four drifts planted: a registry category
; moved, a band pin moved, a Go native registered twice, a Rust registration
; renamed so a lane-1 name is sibling-gapped) and read by BOTH the lens (its
; root re-pointed) and the twin. It is removed at the end of the band.
;
; Bits 2, 4 and 16 run the Python twin through host-exec. They are the
; agreement proof R58 asks for and they stand only while the script stands:
; when form/scripts/validate_primitive_registry.py leaves the tree (R59/R60),
; these bits go red on purpose and the hand that removes the script
; re-declares this band without them.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane.
;
; Verdict 511:
;   1      the live tree: zero failures
;   2      the live twin (--quiet) agrees byte for byte: its PASS line after
;          the prefix equals the lens's OK line, and it exits 0
;   4      the live twin without --quiet prints the report; the lens's report
;          lines over the same tree are those lines, one for one (the
;          circulation census through the membrane included: 138/217 today)
;   8      the planted tree, read by the lens: the four findings, in the
;          script's order and words
;   16     the planted tree, read by the twin: its report lines are the
;          lens's, its FAIL lines after the prefix are the lens's findings,
;          exit 1
;   32     registry cells are read as the script reads them: a defined pv-
;          verifier, an undefined one (no recipe), a blank spec, an inline
;          verifier with a negative outside, a spec that stops at its first
;          quote (the script's head pattern is not escape-aware; only its cell
;          walk is), and an unparseable cell named by offset
;   64     the scanners read what the regular expressions read: the
;          fieldConstructors loop line (catFieldPrimitive) is not a name, an
;          unknown constructor keeps its raw spelling, env natives count, Rust
;          and TypeScript names come from every shape the script lists
;   128    a band without its pins refuses in the script's words
;   256    a root that holds no tree: one named missing input, no traceback

(do
    (defn prb-k (ok bit) (if ok bit 0))
    (defn prb-twin (command)
        (do (let out (host-exec (dg-wrap command) ""))
            (if (nothing? out) (list (sub 0 1) (list))
                (list (dg-rc out) (lx-lines (lx-strip-nl (dg-body out)))))))
    (defn prb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn prb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (prb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn prb-strip-fail (line) (lx-replace-prefix line "FAIL " ""))
    (defn prb-fail-line? (line a) (if (eq (lx-at? line 0 "FAIL ") 1) 1 0))
    (defn prb-report-line? (line a) (if (or (eq (str_len line) 0) (eq (lx-at? line 0 "FAIL ") 1)) 0 1))
    (defn prb-plant-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-kernel-go $D/form/form-kernel-rust/src $D/form/form-kernel-ts/src $D/form/form-stdlib/tests"
        (str_concat " && cp form/scripts/validate_primitive_registry.py $D/form/scripts/ && cp form/form-kernel-go/server.go $D/form/form-kernel-go/ && cp form/form-kernel-ts/src/kernel.ts $D/form/form-kernel-ts/src/ && cp form/form-stdlib/tests/*.fk $D/form/form-stdlib/tests/"
        (str_concat " && sed 's/(prim \"str_len\" \"access\"/(prim \"str_len\" \"method\"/' form/form-stdlib/primitive-registry.fk > $D/form/form-stdlib/primitive-registry.fk"
        (str_concat " && sed 's/(eq (len reg) 217)/(eq (len reg) 218)/' form/form-stdlib/tests/primitive-registry-band.fk > $D/form/form-stdlib/tests/primitive-registry-band.fk"
        (str_concat " && { cat form/form-kernel-go/main.go; printf '\\nfunc zz(k *Kernel) { k.registerNative(\"print\", catCall(), nil) }\\n'; } > $D/form/form-kernel-go/main.go"
                    " && sed 's/register_native(\"str_len\"/register_native(\"str_len_zz\"/' form/form-kernel-rust/src/main.rs > $D/form/form-kernel-rust/src/main.rs && echo $D"))))))
    (defn prb-planted-failures ()
        (list "duplicate registerNative in main.go: ['print']"
              "category drift str_len: go declares access, registry holds method"
              "lane-1 entry str_len is sibling-gapped (rust=n ts=y)"
              "band pins drifted: band declares total=218 lane1=184 lane0=33 verified=184; registry holds total=217 lane1=184 lane0=33"))
    (defn prb-cells ()
        (str_concat "(defn pv-one () 1)\n(defn prim-registry () (list\n"
        (str_concat "    (prim \"one\" \"call\" \"a spec with \\\"quotes\\\" and (parens)\"\n        pv-one 1 1)\n"
        (str_concat "    (prim \"two\" \"access\" \"   \" pv-nope 7 0)\n"
                    "    (prim \"three\" \"method\" \"inline\" (len (list 1 2)) -2 1)))\n"))))
    (defn prb-entry? (e name token spec expected mode verify)
        (and (str_eq (prg-e-name e) name)
             (and (str_eq (prg-e-token e) token)
                  (and (str_eq (prg-e-spec e) spec)
                       (and (eq (prg-e-expected e) expected)
                            (and (eq (prg-e-mode e) mode) (eq (prg-e-verify? e) verify)))))))
    (defn prb-go-snippet ()
        (str_concat "\tk.registerNative(\"print\", catCall(), func() {})\n\tk.registerNative(  \"odd\",  catOdd(), x)\n"
        (str_concat "\tfieldConstructors := []struct {\n\t\tname string\n\t}{\n\t\t{\"field_a\", RBasicField, 1},\n\t\t{\"field_b\", RBasicField, 2},\n\t}\n"
                    "\tfor _, c := range fieldConstructors {\n\t\tk.registerNative(c.name, catFieldPrimitive(c.categoryType), nil)\n\t}\n\tk.registerEnvNative(\"jit\", catWitness(), f)\n\tk.registerNative(\"print\", catCall(), g)\n")))
    (defn prb-rs-snippet ()
        "self.register_native(\"a\", cat_call(), f); self.register_env_native( \"b\", x, y);\nnative_field_constructor!(native_c, RB_FIELD, 3, \"field_c\");\n            \"field_d\",\n  \"field_e\", 1\n")
    (defn prb-ts-snippet ()
        "this.registerNative(\"a\", catCall(), f); this.registerEnvNative(\"b\", x); const t = [\n      [\"field_c\", RBasic.FIELD, 1],\n      [\"nope\", 7],\n    ];")
    (defn prb-remove (d) (if (and (gt (str_len d) 8) (str_eq (substring d 0 1) "/")) (host-exec (str_concat "rm -rf " d) "") 0))
    (defn primitive-registry-band ()
        (do
            (let live-a (prg-analysis ""))
            (let live (prb-twin "python3 form/scripts/validate_primitive_registry.py --quiet"))
            (let loud (prb-twin "python3 form/scripts/validate_primitive_registry.py"))
            (let live-report (prg-report-at ""))
            (let d (lx-strip-nl (lx-host-text (host-exec (prb-plant-command) ""))))
            (let root (str_concat d "/"))
            (let planted-a (prg-analysis root))
            (let planted (prb-twin (str_concat "python3 " (str_concat root "form/scripts/validate_primitive_registry.py --quiet"))))
            (let cells (prg-entries (prb-cells)))
            (let broken (prg-entries "(prim \"x\" \"call\" \"spec\" pv-x 1 1)\n(prim \"y\" \"call\" spec pv-y 1 1)"))
            (let go (prg-go-natives (prb-go-snippet)))
            (let rs (prg-rs-names (prb-rs-snippet)))
            (let ts (prg-ts-names (prb-ts-snippet)))
            (let no-pins (prg-pins "(let c0 (if (eq (len reg) 217) 1 0))"))
            (let absent (prg-analysis "/nonexistent-root/"))
            (let verdict (sum (list
                (prb-k (eq (len (prg-a-failures live-a)) 0) 1)
                (prb-k (and (eq (head live) 0)
                            (str_eq (prb-last (nth live 1)) (str_concat "PASS primitive registry: " (prg-ok-line live-a)))) 2)
                (prb-k (and (eq (head loud) 0) (prb-lines-eq? (nth loud 1) live-report)) 4)
                (prb-k (prb-lines-eq? (prg-a-failures planted-a) (prb-planted-failures)) 8)
                (prb-k (and (eq (head planted) 1)
                            (and (prb-lines-eq? (tb-filter2 (nth planted 1) prb-report-line? 0) (prg-a-report planted-a))
                                 (prb-lines-eq? (map prb-strip-fail (tb-filter2 (nth planted 1) prb-fail-line? 0)) (prg-a-failures planted-a)))) 16)
                (prb-k (and (str_eq (nth cells 0) "ok")
                            (and (eq (len (nth cells 1)) 3)
                                 (and (prb-entry? (nth (nth cells 1) 0) "one" "call" "a spec with \\" 1 1 1)
                                      (and (prb-entry? (nth (nth cells 1) 1) "two" "access" "   " 7 0 0)
                                           (and (prb-entry? (nth (nth cells 1) 2) "three" "method" "inline" (sub 0 2) 1 1)
                                                (and (str_eq (nth broken 0) "refused")
                                                     (str_eq (nth broken 1) "unparseable registry cell at offset 34: (prim \"y\" \"call\" spec pv-y 1 1)..."))))))) 32)
                (prb-k (and (eq (len (nth go 0)) 5)
                            (and (prb-lines-eq? (map prg-row-name (nth go 0)) (list "print" "odd" "field_a" "field_b" "jit"))
                                 (and (prb-lines-eq? (map prg-row-token (nth go 0)) (list "call" "catOdd" "field" "field" "witness"))
                                      (and (prb-lines-eq? (nth go 1) (list "print"))
                                           (and (prb-lines-eq? (lx-str-sort rs) (list "a" "b" "field_c" "field_d"))
                                                (prb-lines-eq? (lx-str-sort ts) (list "a" "b" "field_c"))))))) 64)
                (prb-k (and (str_eq (nth no-pins 0) "refused") (str_eq (nth no-pins 1) "band pins not found in primitive-registry-band.fk")) 128)
                (prb-k (prb-lines-eq? (prg-a-failures absent) (list "missing input: /nonexistent-root/form/form-kernel-go/main.go")) 256))))
            (prb-remove d)
            verdict))
    (primitive-registry-band))
