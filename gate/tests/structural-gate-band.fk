; tests/structural-gate-band.fk — the no-bash/no-python counter is a real instrument.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk gate/structural-gate.fk
;
; run: ./fkwu --src gate/tests/structural-gate-band.fk   ; -> 63
;
; THIS BAND DOES NOT ASSERT THE COUNT. On the day it was written the tree holds 180
; (99 .sh + 81 .py), matching `find` exactly — but pinning 180 would make the band go
; red the moment someone legitimately removes a carrier, and green only while the tree
; stands still. The count is the thing the gate REPORTS; what a band can honestly prove
; is that the instrument reporting it works.
;
; b1..b4 are the extension cases, and three of the four are the ones that were wrong:
; the helper took the FIRST dot, so `a.b.sh` and the dotfile `.metal_uncertainty_patched.sh`
; both missed. That single miss is how the bug was found — the walk answered 179 where
; `find` answered 180.
;
; b5 and b6 pin the counter's structure without pinning its value: a directory with no
; such files answers 0 while the repo root answers more than 0 (so the counter
; discriminates and is not constant), and the two halves sum to the whole (so a split
; that drifts cannot hide inside a total that still looks right).
;
; fkwu-witnessed — the walk is host I/O, fkwu's family and not the walkers'.

(do
    (defn sgb-k (cond bit) (if cond bit 0))
    (defn structural-gate-band ()
        (do
            (let root-total (sg-count "."))
            (let root-sh (sg-count-sh "."))
            (let root-py (sg-count-py "."))
            (add (add (add (add (add
                ; the ordinary case, which always worked
                (sgb-k (str_eq (fs-path-extension "x.sh") ".sh") 1)
                ; two dots: the extension is the LAST suffix, not the first
                (sgb-k (str_eq (fs-path-extension "a.b.sh") ".sh") 2))
                ; a dotfile that really does carry an extension
                (sgb-k (str_eq (fs-path-extension ".metal_x.sh") ".sh") 4))
                ; a leading dot alone is a hidden-file marker, not an extension
                (sgb-k (str_eq (fs-path-extension ".gitignore") "") 8))
                ; the counter discriminates: axioms/ holds none, the tree holds some
                (sgb-k (and (eq (sg-count "axioms") 0) (gt root-total 0)) 16))
                ; and the halves account for the whole
                (sgb-k (eq (add root-sh root-py) root-total) 32))))
    (structural-gate-band))
