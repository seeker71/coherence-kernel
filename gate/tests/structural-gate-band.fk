; tests/structural-gate-band.fk — the structural boundary is executable.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk gate/structural-gate.fk
;
; run: ./fkwu gate/tests/structural-gate-band.fk   ; -> 8191
;
; The band pins the classifier's meaning without pinning a census. A count is
; allowed to change when a carrier is removed or an oracle is added; a script
; that has no declared role is not. The live runner returns the native policy
; status; form/validate.sh turns a 0 into the repository's nonzero exit.

(do
    (defn sgb-k (cond bit) (if cond bit 0))
    (defn sgb-sum (xs) (if (nil? xs) 0 (add (head xs) (sgb-sum (tail xs)))))
    (defn structural-gate-band ()
        (do
            (let root-audit (sg-audit "."))
            (let root-total (sg-total root-audit))
            (let root-sh (sg-count-sh "."))
            (let root-py (sg-count-py "."))
            (sgb-sum (list
                ; suffix parsing stays byte-exact for ordinary and dotted paths
                (sgb-k (str_eq (fs-path-extension "x.sh") ".sh") 1)
                (sgb-k (str_eq (fs-path-extension "a.b.sh") ".sh") 2)
                (sgb-k (str_eq (fs-path-extension ".metal_x.sh") ".sh") 4)
                (sgb-k (str_eq (fs-path-extension ".gitignore") "") 8)
                ; each declared boundary is a positive, distinguishable role
                (sgb-k (eq (sg-classify "form/native/metal/probe.sh") (sg-class-carrier)) 16)
                (sgb-k (eq (sg-classify "form/form-stdlib/tests/x-oracle.py") (sg-class-oracle)) 32)
                (sgb-k (eq (sg-classify "model/fixtures/x/fetch.sh") (sg-class-fixture)) 64)
                (sgb-k (eq (sg-classify "form/form-kernel-rust/harness.py") (sg-class-proof-sibling)) 128)
                (sgb-k (eq (sg-classify "form/scripts/build.sh") (sg-class-tooling)) 256)
                (sgb-k (eq (sg-classify "form/python_bmf/sdk.py") (sg-class-foreign-grammar)) 512)
                ; this is the critical negative case: no role means no landing
                (sgb-k (eq (sg-classify "cognition/oracle.py") (sg-class-unclassified)) 1024)
                (sgb-k (eq (sg-passes? (sg-audit-one (sg-class-unclassified))) 0) 2048)
                ; current checkout has a nonempty named edge and no unknown edge;
                ; extension halves reconcile with the whole audit.
                (sgb-k (and (eq (sg-passes? root-audit) 1)
                             (and (gt root-total 0)
                                  (eq (add root-sh root-py) root-total))) 4096)))))
    (structural-gate-band))
