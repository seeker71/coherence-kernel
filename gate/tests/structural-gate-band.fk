; tests/structural-gate-band.fk — the structural boundary is executable: the tree holds only kinds the body names; nothing else stands without a role.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/bml/host-child.bml gate/structural-gate.fk
;
; run: ./fkwu gate/tests/structural-gate-band.fk   ; -> 262143
;
; Verdict 262143
;
; The band pins the classifier's meaning without pinning a census. The gate is an ALLOWLIST: Form, the C seed, documents and data are
; the kinds the body holds, and any other file is foreign and needs a declared role (so .awk .fish .tcl .R .jl .groovy .cs .dart .ex .nim
; and an uppercase .SH are refused as every unlisted kind is). A Form or C file that opens with #! is foreign; a document or data file
; may open with #! as text. The two declared carriers are named by exact path; a fixture is evidence. The live runner returns the native
; policy status; the band sweep turns a 0 into the repository's nonzero exit.
;   1       suffix parsing stays byte-exact for ordinary and dotted paths
;   2       a script of any language by its extension is a hit: .sh .bash .zsh .py .js .mjs .cjs .ts .rb .pl .command .swift .go .rs; Form,
;           C, markdown, JSON, the data kinds, a dotted data name and the named extensionless files (.gitignore, LICENSE, copied-at) are not
;   4       a plant: a new .sh anywhere is unclassified (under tools/, form/scripts/, cognition/, observe/, form/native/, tests/, form/ itself)
;   8       a plant: a new .py, .mjs or .command is unclassified, with or without a name that sounds like a role (-fetch, -build, -carrier, -oracle)
;   16      the declared carriers are carriers by exact path (form-run, Sema Ear.app/Contents/MacOS/Sema Ear); the same names elsewhere are not
;   32      the healing spool's transport scripts are carriers (.launch.sh, inventory.sh, links-check.sh under .form-heal/); any other is not
;   64      a fixture path is a fixture: fixtures/ and a concept-*-fixtures/ capture, even for a script
;   128     #! is read in every file: a Form or C file (.fk .bml .form .bmf .c .h .m) that opens with it is a hit, one that does not is not; a
;           document or data file (.md .txt .json .html .tsv .jsonl) that opens with it is not (it is text); a file of a kind off the list is a
;           hit with or without it, and so is an extensionless file that no name allows
;   256     a file with no role refuses: the audit of one unclassified path is no pass, nor is a missing audit, nor a width that is not four
;   512     the audit's words: none foreign says so; carriers and fixtures are counted; an unclassified file is named
;   1024    the live checkout passes: no unclassified file stands, and every foreign file the audit finds is a declared carrier or a fixture
;   2048    the live checkout stands at its declared carriers: its audit total equals its carriers and fixtures
;   4096    a new shebang file is refused: a file written under a scratch root with a #! line and no extension is a hit and unclassified
;   8192    a plant: with the classifier answering carrier for every path the plant's claim 4 is lost; the claims name the role, not the leaf
;   16384   the allowlist closes the kinds a list of scripts missed: .awk .sed .fish .tcl .R .jl .groovy .cs .dart .ex .nim .lua .php .ps1 .bat
;           .vbs .scpt .applescript .zsh and the uppercase .SH .PY .Sh .BAT are each a hit and unclassified; so is a name that is only an extension
;   32768   a plant: the old reading (a list of script extensions) calls the closed kinds of claim 16384 no script; the allowlist calls each a hit
;   65536   the tree is what git holds: in a scratch repository the tracked and the untracked files git does not ignore are read, a tracked
;           file gone from disk, an ignored file and anything under .claude or .git are not; the audit finds the untracked .awk, the .fk that
;           opens with #! and the fixture's .sh, and not the .txt that opens with #! as text nor the ignored .sh nor the .sh under .claude
;   131072  a root that is not a repository is listed whole by find: the same plants are found and nothing is set aside

(do
    (defn sgb-k (cond bit) (if cond bit 0))
    (defn sgb-sum (xs) (if (nil? xs) 0 (add (head xs) (sgb-sum (tail xs)))))
    (defn sgb-all-unclassified (paths) (if (nil? paths) 1 (if (eq (sg-classify (head paths)) (sg-class-unclassified)) (sgb-all-unclassified (tail paths)) 0)))
    (defn sgb-all-hits (paths) (if (nil? paths) 1 (if (eq (sg-hit? (head paths)) 1) (sgb-all-hits (tail paths)) 0)))
    (defn sgb-no-hits (paths) (if (nil? paths) 1 (if (eq (sg-hit? (head paths)) 0) (sgb-no-hits (tail paths)) 0)))
    (defn sgb-class-by (stub path) (if (eq stub 1) (sg-class-carrier) (sg-classify path)))
    (defn sgb-all-unclassified-by (stub paths) (if (nil? paths) 1 (if (eq (sgb-class-by stub (head paths)) (sg-class-unclassified)) (sgb-all-unclassified-by stub (tail paths)) 0)))
    ; the old reading: a list of the extensions of scripts (what the gate was before it was an allowlist)
    (defn sgb-old-exts () (list ".sh" ".bash" ".zsh" ".py" ".pyw" ".js" ".mjs" ".cjs" ".ts" ".tsx" ".rb" ".pl" ".pm" ".ps1" ".bat" ".cmd" ".command" ".swift" ".go" ".rs" ".java" ".kt" ".lua" ".php"))
    (defn sgb-old-hit? (path) (sg-in? (sgb-old-exts) (sg-ext path)))
    (defn sgb-none-old-hit (paths) (if (nil? paths) 1 (if (eq (sgb-old-hit? (head paths)) 0) (sgb-none-old-hit (tail paths)) 0)))
    (defn sgb-closed-kinds () (list "a.awk" "b.sed" "c/d.fish" "e.tcl" "f.R" "g.jl" "h.groovy" "i.cs" "j.dart" "k.ex" "l.nim" "m.lua" "n.php" "o.ps1" "p.bat" "q.vbs" "r.scpt" "s.applescript" "t.zsh" "u.SH" "v.PY" "w.Sh" "x.BAT"))
    ; a file written by path (the parent is made first)
    (defn sgb-put (dir leaf text) (write_file (str_concat dir (str_concat "/" leaf)) text))
    (defn sgb-run (dir argv) (nth (hch-run-in ".hearth/validation" "structural-band" argv "" (hch-by 60000)) 0))
    (defn structural-gate-band ()
        (do
            (let root-audit (sg-audit "."))
            (let root-total (sg-total root-audit))
            (let scratch (str_concat (host_temp_dir) (str_concat "/structural-gate-band-" (int_to_str (now_unix_ms)))))
            (let made (fs_mkdir scratch))
            (let shebang-path (str_concat scratch "/launcher"))
            (let plain-path (str_concat scratch "/plain"))
            (let sheb-fk (str_concat scratch "/opens.fk"))
            (let sheb-bml (str_concat scratch "/opens.bml"))
            (let sheb-c (str_concat scratch "/opens.c"))
            (let sheb-h (str_concat scratch "/opens.h"))
            (let sheb-form (str_concat scratch "/opens.form"))
            (let sheb-bmf (str_concat scratch "/opens.bmf"))
            (let sheb-m (str_concat scratch "/opens.m"))
            (let plain-fk (str_concat scratch "/plain.fk"))
            (let plain-c (str_concat scratch "/plain.c"))
            (let data-md (str_concat scratch "/text.md"))
            (let data-txt (str_concat scratch "/text.txt"))
            (let data-json (str_concat scratch "/text.json"))
            (let data-html (str_concat scratch "/text.html"))
            (let data-tsv (str_concat scratch "/text.tsv"))
            (let data-jsonl (str_concat scratch "/text.jsonl"))
            (let unk-cfg (str_concat scratch "/x.cfg"))
            (let unk-tpl (str_concat scratch "/y.tpl"))
            (let unk-plain (str_concat scratch "/z.cfg2"))
            (let wrote (sgb-sum (list (write_file shebang-path "#!/bin/sh\nexit 0\n") (write_file plain-path "just text\n")
                (write_file sheb-fk "#!/usr/bin/env fkwu\n(do 1)\n") (write_file sheb-bml "#!x\n") (write_file sheb-c "#!x\n") (write_file sheb-h "#!x\n")
                (write_file sheb-form "#!x\n") (write_file sheb-bmf "#!x\n") (write_file sheb-m "#!x\n") (write_file plain-fk "(do 1)\n") (write_file plain-c "int x;\n")
                (write_file data-md "#!/bin/sh as text\n") (write_file data-txt "#!/bin/sh as text\n") (write_file data-json "#!/bin/sh as text\n") (write_file data-html "#!/bin/sh as text\n")
                (write_file data-tsv "#!/bin/sh as text\n") (write_file data-jsonl "#!/bin/sh as text\n") (write_file unk-cfg "#!/bin/sh\n") (write_file unk-tpl "plain\n") (write_file unk-plain "#!/bin/sh\n"))))
            ; a scratch repository: tracked, untracked, ignored, deleted-from-disk, under .claude
            (let repo (str_concat scratch "/repo"))
            (let rmade (sgb-sum (list (fs_mkdir repo) (fs_mkdir (str_concat repo "/fixtures")) (fs_mkdir (str_concat repo "/ignored")) (fs_mkdir (str_concat repo "/.claude")))))
            (let rinit (sgb-run repo (list "git" "-C" repo "init" "-q")))
            (let rfiles (sgb-sum (list (sgb-put repo "ok.fk" "(do 1)\n") (sgb-put repo "seed.c" "int x;\n") (sgb-put repo "README.md" "text\n") (sgb-put repo "note.txt" "#!/bin/sh as data\n")
                (sgb-put repo "opens.fk" "#!/bin/sh\n") (sgb-put repo "gone.sh" "echo\n") (sgb-put repo ".gitignore" "ignored/\n") (sgb-put repo "fixtures/y.sh" "echo\n")
                (sgb-put repo "ignored/bad.sh" "echo\n") (sgb-put repo ".claude/z.sh" "echo\n") (sgb-put repo "new.awk" "BEGIN{}\n"))))
            (let radd (sgb-run repo (list "git" "-C" repo "add" "ok.fk" "seed.c" "README.md" "note.txt" "opens.fk" "gone.sh" ".gitignore" "fixtures/y.sh")))
            (let rgone (host_path_remove (str_concat repo "/gone.sh")))
            (let repo-audit (sg-audit repo))
            ; a plain directory (not a repository): listed whole
            (let plain (str_concat scratch "/plain-root"))
            (let pmade (sgb-sum (list (fs_mkdir plain) (fs_mkdir (str_concat plain "/ignored")))))
            (let pfiles (sgb-sum (list (sgb-put plain "new.awk" "BEGIN{}\n") (sgb-put plain "ok.fk" "(do 1)\n") (sgb-put plain "note.txt" "#!/bin/sh as data\n") (sgb-put plain "ignored/bad.sh" "echo\n"))))
            (let plain-audit (sg-audit plain))
            (let result
            (sgb-sum (list
                ; suffix parsing stays byte-exact for ordinary and dotted paths
                (sgb-k (and (str_eq (fs-path-extension "x.sh") ".sh")
                             (and (str_eq (fs-path-extension "a.b.sh") ".sh")
                                  (and (str_eq (fs-path-extension ".metal_x.sh") ".sh")
                                       (str_eq (fs-path-extension ".gitignore") "")))) 1)
                ; a script of any language by its extension is a hit; Form, C, data and the named files are not
                (sgb-k (and (eq (sgb-all-hits (list "a.sh" "b/c.bash" "d.zsh" "e.py" "f.js" "g.mjs" "h.cjs" "i.ts" "j.rb" "k.pl" "Sema Ear Glass.command" "l.swift" "m.go" "n.rs")) 1)
                             (eq (sgb-no-hits (list "a.fk" "b.bml" "c.c" "d.h" "e.m" "f.md" "g.json" "h.txt" "i.html" "j.fkb.sym.json" "k.metal" "l.ptx" "m.tsv" "n.form" "o.bmf" "p.jsonl" "q.rows" "r.png" "s.wav" ".gitignore" "form/.gitattributes" "model/tokenizers/whisper/LICENSE" "form/form-stdlib/adapters/x/copied-at" "fkwu.conf.example")) 1)) 2)
                ; a new .sh anywhere is unclassified
                (sgb-k (eq (sgb-all-unclassified (list "tools/x.sh" "form/scripts/build.sh" "cognition/x-fetch.sh" "observe/x-fetch.sh" "form/native/metal/probe.sh" "form/form-stdlib/tests/x.sh" "form/validate.sh" "x.sh")) 1) 4)
                (sgb-k (eq (sgb-all-unclassified (list "form/new-implementation.py" "my-tools/probe.py" "observe/ear-carrier.py" "cognition/oracle.py" "form/form-stdlib/tests/x-oracle.py" "cognition/x-build.mjs" "tools/x.command" "Sema Ear Glass.command")) 1) 8)
                ; the declared carriers are carriers by exact path only
                (sgb-k (and (eq (sg-classify "form-run") (sg-class-carrier))
                             (and (eq (sg-classify "./form-run") (sg-class-carrier))
                                  (and (eq (sg-classify "./Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-carrier))
                                       (and (eq (sg-classify "Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-carrier))
                                            (and (eq (sg-classify "tools/form-run") (sg-class-unclassified))
                                                 (eq (sg-classify "x/Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-unclassified))))))) 16)
                (sgb-k (and (eq (sg-classify ".form-heal/attempt/check.launch.sh") (sg-class-carrier))
                             (and (eq (sg-classify "./.form-heal/evaluation/evidence/inventory.sh") (sg-class-carrier))
                                  (and (eq (sg-classify ".form-heal/attempt/links-check.sh") (sg-class-carrier))
                                       (and (eq (sg-classify ".form-heal/attempt/repair.sh") (sg-class-unclassified))
                                            (eq (sg-classify "cognition/check.launch.sh") (sg-class-unclassified)))))) 32)
                ; a fixture is evidence
                (sgb-k (and (eq (sg-classify "model/fixtures/x/fetch.sh") (sg-class-fixture))
                             (and (eq (sg-classify "presence/concept-pl-execution-13-fixtures/b.py") (sg-class-fixture))
                                  (eq (sg-classify "my-fixtures-notes/b.py") (sg-class-unclassified)))) 64)
                ; #! is read in every file
                (sgb-k (and (eq (sgb-all-hits (list sheb-fk sheb-bml sheb-c sheb-h sheb-form sheb-bmf sheb-m)) 1)
                             (and (eq (sgb-no-hits (list plain-fk plain-c data-md data-txt data-json data-html data-tsv data-jsonl "no-such-file-anywhere.fk")) 1)
                                  (and (eq (sgb-all-hits (list unk-cfg unk-tpl unk-plain shebang-path plain-path "no-such-file-anywhere")) 1)
                                       (eq (sg-hit? "x.fk") 0)))) 128)
                ; no role means no landing
                (sgb-k (and (eq (sg-passes? (sg-audit-one (sg-class-unclassified))) 0)
                             (and (eq (sg-passes? (nothing)) 0)
                                  (and (eq (sg-passes? (list 1 0 0)) 0)
                                       (eq (sg-passes? (list 1 0 1 0)) 1)))) 256)
                ; the audit's words
                (sgb-k (and (str_eq (sg-words (sg-empty-audit)) "every file is a kind the body holds; no script stands in this tree")
                             (and (str_eq (sg-words (list 3 0 2 1)) "2 declared carrier(s) and 1 fixture(s) stand; no other foreign file")
                                  (str_eq (sg-words (list 3 2 1 0)) "2 foreign file(s) stand with no declared role"))) 512)
                ; the live checkout: no unclassified file, and every foreign file found has a role
                (sgb-k (eq (sg-passes? root-audit) 1) 1024)
                (sgb-k (and (eq (add (sg-carriers root-audit) (sg-fixtures root-audit)) root-total)
                             (gt (sg-carriers root-audit) 0)) 2048)
                ; a new shebang file under a scratch root is unclassified
                (sgb-k (and (eq (sg-hit? shebang-path) 1) (eq (sg-classify shebang-path) (sg-class-unclassified))) 4096)
                ; the claims name the role: a classifier that answered carrier for every path loses the plant
                (sgb-k (and (eq (sgb-all-unclassified-by 0 (list "tools/x.sh" "x.py")) 1) (eq (sgb-all-unclassified-by 1 (list "tools/x.sh" "x.py")) 0)) 8192)
                ; the allowlist closes what a list of scripts missed
                (sgb-k (and (eq (sgb-all-hits (sgb-closed-kinds)) 1) (and (eq (sgb-all-unclassified (sgb-closed-kinds)) 1) (and (eq (sg-hit? ".sh") 1) (eq (sg-hit? "noext") 1)))) 16384)
                ; the plant: the old list of script extensions calls them no script
                (sgb-k (and (eq (sgb-none-old-hit (list "a.awk" "b.sed" "c/d.fish" "e.tcl" "f.R" "g.jl" "h.groovy" "i.cs" "j.dart" "k.ex" "l.nim" "u.SH" "v.PY")) 1) (and (eq (sgb-old-hit? "m.lua") 1) (eq (sgb-all-hits (list "a.awk" "u.SH" "v.PY")) 1))) 32768)
                ; the tree is what git holds
                (sgb-k (and (eq (sg-total repo-audit) 3) (and (eq (sg-unclassified repo-audit) 2) (and (eq (sg-carriers repo-audit) 0) (eq (sg-fixtures repo-audit) 1)))) 65536)
                ; a root that is not a repository is listed whole
                (sgb-k (and (eq (sg-total plain-audit) 2) (and (eq (sg-unclassified plain-audit) 2) (eq (sg-fixtures plain-audit) 0))) 131072))))
            (do (host_dir_rmdir scratch) result)))
    (structural-gate-band))
