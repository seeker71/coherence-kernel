; tests/structural-gate-band.fk — the structural boundary is executable: no script of another language stands in the tree.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk gate/structural-gate.fk
;
; run: ./fkwu gate/tests/structural-gate-band.fk   ; -> 16383
;
; Verdict 16383
;
; The band pins the classifier's meaning without pinning a census. A script that has no declared role is refused whatever its
; place or its name; the two declared carriers are named by exact path; a fixture is evidence. The live runner returns the native
; policy status; the band sweep turns a 0 into the repository's nonzero exit.
;   1     suffix parsing stays byte-exact for ordinary and dotted paths
;   2     a script of any language by its extension is a hit: .sh .bash .zsh .py .js .mjs .cjs .ts .rb .pl .command .swift .go .rs; Form,
;         C, markdown, JSON and a dotted data name are not
;   4     a plant: a new .sh anywhere is unclassified (under tools/, form/scripts/, cognition/, observe/, form/native/, tests/, form/ itself)
;   8     a plant: a new .py, .mjs or .command is unclassified, with or without a name that sounds like a role (-fetch, -build, -carrier, -oracle)
;   16    the declared carriers are carriers by exact path (form-run, Sema Ear.app/Contents/MacOS/Sema Ear); the same names elsewhere are not
;   32    the healing spool's transport scripts are carriers (.launch.sh, inventory.sh, links-check.sh under .form-heal/); any other is not
;   64    a fixture path is a fixture: fixtures/ and a concept-*-fixtures/ capture, even for a script
;   128   an extensionless file that opens with #! is a script (a hit); one that does not, and a file with an extension that is no script, are not
;   256   a script with no role refuses: the audit of one unclassified path is no pass, nor is a missing audit, nor a width that is not four
;   512   the audit's words: no script at all says so; carriers and fixtures are counted; an unclassified script is named
;   1024  the live checkout passes: no unclassified script stands, and every script the audit finds is a declared carrier or a fixture
;   2048  the live checkout stands at its declared carriers: its audit total equals its carriers and fixtures
;   4096  a new shebang script is refused: a file written under a scratch root with a #! line and no extension is unclassified
;   8192  a plant: with the classifier answering carrier for every path the plant's claim 4 is lost; the claims name the role, not the leaf

(do
    (defn sgb-k (cond bit) (if cond bit 0))
    (defn sgb-sum (xs) (if (nil? xs) 0 (add (head xs) (sgb-sum (tail xs)))))
    (defn sgb-all-unclassified (paths) (if (nil? paths) 1 (if (eq (sg-classify (head paths)) (sg-class-unclassified)) (sgb-all-unclassified (tail paths)) 0)))
    (defn sgb-all-hits (paths) (if (nil? paths) 1 (if (eq (sg-hit? (head paths)) 1) (sgb-all-hits (tail paths)) 0)))
    (defn sgb-no-hits (paths) (if (nil? paths) 1 (if (eq (sg-hit? (head paths)) 0) (sgb-no-hits (tail paths)) 0)))
    (defn sgb-class-by (stub path) (if (eq stub 1) (sg-class-carrier) (sg-classify path)))
    (defn sgb-all-unclassified-by (stub paths) (if (nil? paths) 1 (if (eq (sgb-class-by stub (head paths)) (sg-class-unclassified)) (sgb-all-unclassified-by stub (tail paths)) 0)))
    (defn structural-gate-band ()
        (do
            (let root-audit (sg-audit "."))
            (let root-total (sg-total root-audit))
            (let scratch (str_concat (host_temp_dir) (str_concat "/structural-gate-band-" (int_to_str (now_unix_ms)))))
            (let made (fs_mkdir scratch))
            (let shebang-path (str_concat scratch "/launcher"))
            (let plain-path (str_concat scratch "/plain"))
            (let wrote (add (write_file shebang-path "#!/bin/sh\nexit 0\n") (write_file plain-path "just text\n")))
            (let result
            (sgb-sum (list
                ; suffix parsing stays byte-exact for ordinary and dotted paths
                (sgb-k (and (str_eq (fs-path-extension "x.sh") ".sh")
                             (and (str_eq (fs-path-extension "a.b.sh") ".sh")
                                  (and (str_eq (fs-path-extension ".metal_x.sh") ".sh")
                                       (str_eq (fs-path-extension ".gitignore") "")))) 1)
                ; a script of any language by its extension is a hit; Form, C and data are not
                (sgb-k (and (eq (sgb-all-hits (list "a.sh" "b/c.bash" "d.zsh" "e.py" "f.js" "g.mjs" "h.cjs" "i.ts" "j.rb" "k.pl" "Sema Ear Glass.command" "l.swift" "m.go" "n.rs")) 1)
                             (eq (sgb-no-hits (list "a.fk" "b.bml" "c.c" "d.h" "e.m" "f.md" "g.json" "h.txt" "i.html" "j.fkb.sym" "k.metal" "l.ptx" "m.tsv")) 1)) 2)
                ; a new .sh anywhere is unclassified
                (sgb-k (eq (sgb-all-unclassified (list "tools/x.sh" "form/scripts/build.sh" "cognition/x-fetch.sh" "observe/x-fetch.sh" "form/native/metal/probe.sh" "form/form-stdlib/tests/x.sh" "form/validate.sh" "x.sh")) 1) 4)
                (sgb-k (eq (sgb-all-unclassified (list "form/new-implementation.py" "my-tools/probe.py" "observe/ear-carrier.py" "cognition/oracle.py" "form/form-stdlib/tests/x-oracle.py" "cognition/x-build.mjs" "tools/x.command" "Sema Ear Glass.command")) 1) 8)
                ; the declared carriers are carriers by exact path only
                (sgb-k (and (eq (sg-classify "form-run") (sg-class-carrier))
                             (and (eq (sg-classify "./form-run") (sg-class-carrier))
                                  (and (eq (sg-classify "./Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-carrier))
                                       (and (eq (sg-classify "Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-carrier))
                                            (and (eq (sg-classify "tools/form-run") (sg-class-unclassified))
                                                 (eq (sg-classify "x/Sema Ear.app/Contents/MacOS/Sema Ear") (sg-class-unclassified))))))) 16)
                (sgb-k (and (eq (sg-classify ".form-heal/attempt/check.launch.sh") (sg-class-carrier))
                             (and (eq (sg-classify "./.form-heal/evaluation/evidence/inventory.sh") (sg-class-carrier))
                                  (and (eq (sg-classify ".form-heal/attempt/links-check.sh") (sg-class-carrier))
                                       (and (eq (sg-classify ".form-heal/attempt/repair.sh") (sg-class-unclassified))
                                            (eq (sg-classify "cognition/check.launch.sh") (sg-class-unclassified)))))) 32)
                ; a fixture is evidence
                (sgb-k (and (eq (sg-classify "model/fixtures/x/fetch.sh") (sg-class-fixture))
                             (and (eq (sg-classify "presence/concept-pl-execution-13-fixtures/b.py") (sg-class-fixture))
                                  (eq (sg-classify "my-fixtures-notes/b.py") (sg-class-unclassified)))) 64)
                ; an extensionless file is a script only when it opens with #!
                (sgb-k (and (eq (sg-hit? shebang-path) 1)
                             (and (eq (sg-hit? plain-path) 0)
                                  (and (eq (sg-hit? "no-such-file-anywhere") 0)
                                       (eq (sg-hit? "x.fk") 0)))) 128)
                ; no role means no landing
                (sgb-k (and (eq (sg-passes? (sg-audit-one (sg-class-unclassified))) 0)
                             (and (eq (sg-passes? (nothing)) 0)
                                  (and (eq (sg-passes? (list 1 0 0)) 0)
                                       (eq (sg-passes? (list 1 0 1 0)) 1)))) 256)
                ; the audit's words
                (sgb-k (and (str_eq (sg-words (sg-empty-audit)) "no shell, python or other script stands in this tree")
                             (and (str_eq (sg-words (list 3 0 2 1)) "2 declared carrier(s) and 1 fixture(s) stand; no other script")
                                  (str_eq (sg-words (list 3 2 1 0)) "2 script(s) stand with no declared role"))) 512)
                ; the live checkout: no unclassified script, and every script found has a role
                (sgb-k (eq (sg-passes? root-audit) 1) 1024)
                (sgb-k (and (eq (add (sg-carriers root-audit) (sg-fixtures root-audit)) root-total)
                             (gt (sg-carriers root-audit) 0)) 2048)
                ; a new shebang script under a scratch root is unclassified
                (sgb-k (and (eq (sg-hit? shebang-path) 1) (eq (sg-classify shebang-path) (sg-class-unclassified))) 4096)
                ; the claims name the role: a classifier that answered carrier for every path loses the plant
                (sgb-k (and (eq (sgb-all-unclassified-by 0 (list "tools/x.sh" "x.py")) 1) (eq (sgb-all-unclassified-by 1 (list "tools/x.sh" "x.py")) 0)) 8192))))
            (do (host_dir_rmdir scratch) result)))
    (structural-gate-band))
