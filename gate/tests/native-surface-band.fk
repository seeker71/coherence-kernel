; tests/native-surface-band.fk — the native-surface lens judges as its Python
; twin judges, on the live tree and under planted drift.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/form-parse.fk form-stdlib/form-flatten.fk gate/native-surface.bml
;
; run: ./fkwu gate/tests/native-surface-band.fk   ; -> 1023
;
; The lens's top-level statement runs the live judgment when preluded, so a
; run of this band prints the body's own native-surface line first; the
; verdict is the last line and the exit code.
;
; Bits 2 and 8 run the Python twin through host-exec. They are the agreement
; proof R58 asks for and they stand only while the script stands: when
; form/scripts/validate_fkwu_native_surface.py leaves the tree (R59/R60),
; these two bits go red on purpose and the hand that removes the script
; re-declares this band without them.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane.
;
; Verdict 511:
;   1      the live tree: zero errors and zero warnings over the real rows
;   2      the live twin agrees byte for byte: its OK line, module name mapped
;          to the lens's, equals the lens's OK line, and it exits 0
;   4      planted: a unary row at tag 150, which no fkc-flat row, no or-group
;          and no walker arm carries — one warning and one error, the
;          script's words
;   8      the same plant in a scratch tree read by the twin: warn line, error
;          line and FAIL line byte for byte, exit 1
;   16     planted: a unary row at tag 3 beside add/_plus — a conflict naming
;          the sorted arities and the rows in table order, and the row's own
;          missing arm (tag 3 has no fkc-flat row: add rides the fallback);
;          a binary row at tag 3 is one more alias and no error
;   32     planted: a binary row at tag 256 — the ceiling speaks first, then
;          the row, and the walker warning counts it
;   64     planted: nullary, ternary and arity-5 rows at tag 150 each refuse
;          in their own words; a quad row there only warns
;   128    the or-groups are read: the tail group's eleven tags are dynamic
;          unary tags, and a planted unary row at 147 (in that group, not in
;          fkc-flat as its own row) is not an error — the teaching the twin's
;          regex could not see, judged alike today because 147 is also an
;          explicit row
;   256    a root that holds no tree: one named missing input, no traceback

(do
    (defn nsb-k (ok bit) (if ok bit 0))
    (defn nsb-twin (command)
        (do (let out (host-exec (dg-wrap command) ""))
            (if (nothing? out) (list (sub 0 1) (list))
                (list (dg-rc out) (lx-lines (lx-strip-nl (dg-body out)))))))
    (defn nsb-twin-name () "validate_fkwu_native_surface")
    (defn nsb-map (line) (lx-replace-prefix line (nsb-twin-name) (nsf-name)))
    (defn nsb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn nsb-nth-from-end (lines k) (if (lt (len lines) (add k 1)) "" (nth lines (sub (sub (len lines) 1) k))))
    (defn nsb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (nsb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn nsb-all-in? (xs ys)
        (if (eq (len xs) 0) 1 (if (eq (lx-int-in? ys (head xs)) 1) (nsb-all-in? (tail xs) ys) 0)))
    (defn nsb-with (ops row) (append ops (list row)))
    ; a scratch tree holding the live inputs with one unary row planted after byte_to_str
    (defn nsb-scratch-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-stdlib $D/runtime"
        (str_concat " && cp form/scripts/validate_fkwu_native_surface.py $D/form/scripts/ && cp form/form-stdlib/fkc-table-serialize.fk form/form-stdlib/host-io-fs-fkwu-emit.fk $D/form/form-stdlib/"
        (str_concat " && sed 's/(list \"byte_to_str\" 1 33)/(list \"byte_to_str\" 1 33) (list \"zz\" 1 150)/' form/form-stdlib/form-flatten.fk > $D/form/form-stdlib/form-flatten.fk"
                    " && cp runtime/fkwu-uni.c $D/runtime/ && python3 $D/form/scripts/validate_fkwu_native_surface.py; R=$?; rm -rf $D; exit $R"))))
    (defn nsb-zz-warn () "zz: tag 150 not found in C walker if (t == N) strings")
    (defn nsb-zz-error () "zz: unary tag 150 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)")
    (defn native-surface-band ()
        (do
            (let ops (flt-ops))
            (let live-a (nsf-analysis ops ""))
            (let live (nsb-twin "python3 form/scripts/validate_fkwu_native_surface.py"))
            (let planted (nsb-twin (nsb-scratch-command)))
            (let zz (nsf-analysis (nsb-with ops (list "zz" 1 150)) ""))
            (let clash (nsf-analysis (nsb-with ops (list "zz" 1 3)) ""))
            (let alias (nsf-analysis (nsb-with ops (list "zz" 2 3)) ""))
            (let ceiling (nsf-analysis (nsb-with ops (list "zz" 2 256)) ""))
            (let nullary (nsf-analysis (nsb-with ops (list "zz" 0 150)) ""))
            (let ternary (nsf-analysis (nsb-with ops (list "zz" 3 150)) ""))
            (let five (nsf-analysis (nsb-with ops (list "zz" 5 150)) ""))
            (let quad (nsf-analysis (nsb-with ops (list "zz" 4 150)) ""))
            (let grouped (nsf-analysis (nsb-with ops (list "zz" 1 147)) ""))
            (let onhold (nsf-analysis (nsb-with ops (list "zz" 1 190)) ""))
            (let reading (nsf-read ""))
            (let absent (nsf-analysis ops "/nonexistent-root/"))
            (sum (list
                (nsb-k (nsb-lines-eq? (nsf-a-errors onhold) (list "zz: tag 190 is an internal walker tag (#define FK_TAG_*): a call here is walked as that form and answers its first child, never this op"
                                                                "zz: unary tag 190 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)")) 512)
                (nsb-k (and (eq (len (nsf-a-errors live-a)) 0) (eq (len (nsf-a-warnings live-a)) 0)) 1)
                (nsb-k (and (eq (head live) 0)
                            (str_eq (nsb-map (nsb-last (nth live 1))) (str_concat (nsf-name) (str_concat ": OK " (nsf-ok-line ops live-a))))) 2)
                (nsb-k (and (nsb-lines-eq? (nsf-a-warnings zz) (list (nsb-zz-warn)))
                            (nsb-lines-eq? (nsf-a-errors zz) (list (nsb-zz-error)))) 4)
                (nsb-k (and (eq (head planted) 1)
                            (and (str_eq (nsb-nth-from-end (nth planted 1) 2) (str_concat "warn: " (nsb-zz-warn)))
                                 (and (str_eq (nsb-nth-from-end (nth planted 1) 1) (str_concat "error: " (nsb-zz-error)))
                                      (str_eq (nsb-map (nsb-last (nth planted 1)))
                                              (str_concat (nsf-name) (str_concat ": FAIL " (nsf-fail-line (nsb-with ops (list "zz" 1 150)) zz))))))) 8)
                (nsb-k (and (nsb-lines-eq? (nsf-a-errors clash) (list "conflicting flt-ops tag 3 (mixed arity [1, 2]): ['add', '_plus', 'zz']"
                                                                       "zz: unary tag 3 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)"))
                            (and (eq (len (nsf-a-errors alias)) 0)
                                 (eq (nsf-a-aliases alias) (nsf-a-aliases live-a)))) 16)
                (nsb-k (and (nsb-lines-eq? (nsf-a-errors ceiling) (list "max flt-ops tag 256 >= fkc-arm-slots 256" "zz: tag 256 out of arm slots range 0..255"))
                            (nsb-lines-eq? (nsf-a-warnings ceiling) (list "zz: tag 256 not found in C walker if (t == N) strings"))) 32)
                (nsb-k (and (nsb-lines-eq? (nsf-a-errors nullary) (list "zz: nullary tag 150 missing explicit fkc-flat row"))
                            (and (nsb-lines-eq? (nsf-a-errors ternary) (list "zz: ternary tag 150 missing fkc-tri2 / explicit fkc-flat"))
                                 (and (nsb-lines-eq? (nsf-a-errors five) (list "zz: unsupported arity 5"))
                                      (and (eq (len (nsf-a-errors quad)) 0)
                                           (nsb-lines-eq? (nsf-a-warnings quad) (list "zz: quad tag 150 — verify fkc-quad4 coverage manually" (nsb-zz-warn))))))) 64)
                (nsb-k (and (nsb-all-in? (list 81 82 83 85 87 88 89 90 127 130 147) (nsf-r-dyn-unary reading))
                            (and (eq (lx-int-in? (nsf-r-dyn-unary reading) 150) 0)
                                 (eq (len (nsf-a-errors grouped)) 0))) 128)
                (nsb-k (nsb-lines-eq? (nsf-a-errors absent) (list "missing input: /nonexistent-root/form/form-stdlib/fkc-table-serialize.fk")) 256)))))
    (native-surface-band))
