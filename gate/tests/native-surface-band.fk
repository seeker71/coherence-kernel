; Native Form checks: live inputs, planted failures, and parser boundaries.
; Historical cross-language comparisons remain in git; no interpreter runs.
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/form-parse.fk form-stdlib/form-flatten.fk gate/native-surface.bml
; witnessed: 2026-09-09 -> 1013

(do
    (defn nsb-k (ok bit) (if ok bit 0))

    (defn nsb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (nsb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn nsb-all-in? (xs ys)
        (if (eq (len xs) 0) 1 (if (eq (lx-int-in? ys (head xs)) 1) (nsb-all-in? (tail xs) ys) 0)))
    (defn nsb-with (ops row) (append ops (list row)))
    ; a scratch tree holding the live inputs with one unary row planted after byte_to_str

    (defn nsb-zz-warn () "zz: tag 150 not found in C walker if (t == N) strings")
    (defn nsb-zz-error () "zz: unary tag 150 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)")
    (defn native-surface-band ()
        (do
            (let ops (flt-ops))
            (let live-a (nsf-analysis ops ""))

            (let zz (nsf-analysis (nsb-with ops (list "zz" 1 150)) ""))
            (let clash (nsf-analysis (nsb-with ops (list "zz" 1 3)) ""))
            (let alias (nsf-analysis (nsb-with ops (list "zz" 2 3)) ""))
            (let ceiling (nsf-analysis (nsb-with ops (list "zz" 2 256)) ""))
            (let nullary (nsf-analysis (nsb-with ops (list "zz" 0 150)) ""))
            (let ternary (nsf-analysis (nsb-with ops (list "zz" 3 150)) ""))
            (let five (nsf-analysis (nsb-with ops (list "zz" 5 150)) ""))
            (let quad (nsf-analysis (nsb-with ops (list "zz" 4 150)) ""))
            (let grouped (nsf-analysis (nsb-with ops (list "zz" 1 147)) ""))
            (let onhold (nsf-analysis (nsb-with ops (list "zz" 1 190)) ""))
            (let reading (nsf-read ""))
            (let absent (nsf-analysis ops "/nonexistent-root/"))
            (sum (list
                (nsb-k (nsb-lines-eq? (nsf-a-errors onhold) (list "zz: tag 190 is an internal walker tag (#define FK_TAG_*): a call here is walked as that form and answers its first child, never this op"
                                                                "zz: unary tag 190 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)")) 512)
                (nsb-k (and (eq (len (nsf-a-errors live-a)) 0) (eq (len (nsf-a-warnings live-a)) 0)) 1)

                (nsb-k (and (nsb-lines-eq? (nsf-a-warnings zz) (list (nsb-zz-warn)))
                            (nsb-lines-eq? (nsf-a-errors zz) (list (nsb-zz-error)))) 4)

                (nsb-k (and (nsb-lines-eq? (nsf-a-errors clash) (list "conflicting flt-ops tag 3 (mixed arity [1, 2]): ['add', '_plus', 'zz']"
                                                                       "zz: unary tag 3 not in fkc-flat (would hit binary fallback — flatten crash or wrong arity)"))
                            (and (eq (len (nsf-a-errors alias)) 0)
                                 (eq (nsf-a-aliases alias) (nsf-a-aliases live-a)))) 16)
                (nsb-k (and (nsb-lines-eq? (nsf-a-errors ceiling) (list "max flt-ops tag 256 >= fkc-arm-slots 256" "zz: tag 256 out of arm slots range 0..255"))
                            (nsb-lines-eq? (nsf-a-warnings ceiling) (list "zz: tag 256 not found in C walker if (t == N) strings"))) 32)
                (nsb-k (and (nsb-lines-eq? (nsf-a-errors nullary) (list "zz: nullary tag 150 missing explicit fkc-flat row"))
                            (and (nsb-lines-eq? (nsf-a-errors ternary) (list "zz: ternary tag 150 missing fkc-tri2 / explicit fkc-flat"))
                                 (and (nsb-lines-eq? (nsf-a-errors five) (list "zz: unsupported arity 5"))
                                      (and (eq (len (nsf-a-errors quad)) 0)
                                           (nsb-lines-eq? (nsf-a-warnings quad) (list "zz: quad tag 150 — verify fkc-quad4 coverage manually" (nsb-zz-warn))))))) 64)
                (nsb-k (and (nsb-all-in? (list 81 82 83 85 87 88 89 90 127 130 147) (nsf-r-dyn-unary reading))
                            (and (eq (lx-int-in? (nsf-r-dyn-unary reading) 150) 0)
                                 (eq (len (nsf-a-errors grouped)) 0))) 128)
                (nsb-k (nsb-lines-eq? (nsf-a-errors absent) (list "missing input: /nonexistent-root/form/form-stdlib/fkc-table-serialize.fk")) 256)))))
    (native-surface-band))
