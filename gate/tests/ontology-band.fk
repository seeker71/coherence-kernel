; Native Form checks: live inputs, planted failures, and parser boundaries.
; Historical cross-language comparisons remain in git; no interpreter runs.
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/json.fk gate/ontology.bml
; witnessed: 2026-09-09 -> 245

(do
    (defn onb-k (ok bit) (if ok bit 0))

    (defn onb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (onb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn onb-row? (rows name label inst)
        (do (let r (tb-find2 rows ong-r-named? name))
            (if (eq (len r) 0) 0
                (if (and (str_eq (nth r 1) label) (eq (nth r 2) inst)) 1 0))))
    (defn onb-plant-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-stdlib $D/form/form-kernel-go $D/form/form-kernel-rust/src $D/form/form-kernel-ts/src"
        (str_concat " && cp form/form-kernel-go/main.go $D/form/form-kernel-go/ && cp form/form-kernel-ts/src/reader.ts $D/form/form-kernel-ts/src/"
        (str_concat " && sed 's/\"name\": \"add\", \"type\": 12, \"inst\": 1,/\"name\": \"add\", \"type\": 12, \"inst\": 7,/' form/form-stdlib/form-ontology.json > $D/form/form-stdlib/form-ontology.json"
                    " && sed 's/\"mod\" =>/\"modx\" =>/' form/form-kernel-rust/src/main.rs > $D/form/form-kernel-rust/src/main.rs && echo $D"))))
    (defn onb-planted-lines ()
        (list "primitive 'add' in ontology has inst=7 but form-kernel-go dispatches with inst=1"
              "primitive 'add' in ontology has inst=7 but form-kernel-rust dispatches with inst=1"
              "primitive 'mod' (type=12 inst=5) in ontology but no `case \"mod\"` in form-kernel-rust"
              "form-kernel-rust has `case \"modx\"` → math but FORM-PRIMITIVE-TABLE has no row for it"))
    (defn onb-braces () "{ x = \"}\"; // }\n y = '}'; /* } */ { z } }")
    (defn onb-remove (d) (if (and (gt (str_len d) 8) (str_eq (substring d 0 1) "/")) (host-exec (str_concat "rm -rf " d) "") 0))
    (defn ontology-band ()
        (do
            (let live-drifts (ong-analysis ""))

            (let d (lx-strip-nl (lx-host-text (host-exec (onb-plant-command) ""))))
            (let root (str_concat d "/"))
            (let planted-drifts (ong-analysis root))

            (let go (ong-dispatch (read_file (ong-go)) "go"))
            (let rust (ong-dispatch (read_file (ong-rust)) "rust"))
            (let ts (ong-dispatch (read_file (ong-ts)) "ts"))
            (let absent (ong-analysis "/nonexistent-root/"))
            (let verdict (sum (list
                (onb-k (eq (len live-drifts) 0) 1)

                (onb-k (onb-lines-eq? planted-drifts (onb-planted-lines)) 4)

                (onb-k (and (eq (ong-brace-end (onb-braces) 0 0) (sub (str_len (onb-braces)) 1))
                            (eq (ong-brace-end "{ a { b }" 0 0) (sub 0 1))) 16)
                (onb-k (and (str_eq (nth go 0) "ok")
                            (and (onb-row? (nth go 1) "do" "block" 1)
                                 (and (onb-row? (nth go 1) "list" "fncall" (sub 0 1))
                                      (and (onb-row? (nth go 1) "add" "math" 1)
                                           (and (onb-row? (nth rust 1) "mod" "math" 5)
                                                (and (onb-row? (nth ts 1) "+" "math" (sub 0 1))
                                                     (and (onb-row? (nth ts 1) "list" "list" 1)
                                                          (eq (len (tb-find2 (nth ts 1) ong-r-named? "addf")) 0)))))))) 32)
                (onb-k (and (eq (ong-handler? "  case \"do\":" "do" 0) 1)
                            (and (eq (ong-handler? "\"seq\" => x" "seq" 0) 1)
                                 (and (eq (ong-handler? "if (verb === \"let\") {" "let" 0) 1)
                                      (and (eq (ong-handler? "case \"doing\":" "do" 0) 0)
                                           (eq (ong-handler? "x = \"do\" + 1" "do" 0) 0))))) 64)
                (onb-k (onb-lines-eq? absent (list "missing input: /nonexistent-root/form/form-stdlib/form-ontology.json")) 128))))
            (onb-remove d)
            verdict))
    (ontology-band))
