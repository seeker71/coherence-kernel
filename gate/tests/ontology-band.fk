; tests/ontology-band.fk — the ontology lens judges as its Python twin judges,
; on the live tree and over one planted scratch tree that both read.
;
; preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/term-graphics.bml gate/drift-gates.bml gate/lens-text.bml form-stdlib/json.fk gate/ontology.bml
;
; run: ./fkwu gate/tests/ontology-band.fk   ; -> 255
;
; The lens's top-level statement runs the live judgment when preluded, so a
; run of this band prints the body's own ontology line first; the verdict is
; the last line and the exit code.
;
; The planted tree is built once by host-exec (mktemp -d; the four texts
; copied; two drifts planted: add's inst moved to 7 in the ontology, Rust's
; "mod" arm renamed "modx") and read by BOTH the lens (its root re-pointed)
; and the twin. It is removed at the end of the band.
;
; Bits 2 and 8 run the Python twin through host-exec. They are the agreement
; proof R58 asks for and they stand only while the script stands: when
; form/scripts/validate_form_ontology.py leaves the tree (R59/R60), these two
; bits go red on purpose and the hand that removes the script re-declares
; this band without them.
;
; PROOF LEVEL: FOURTH-ARM ONLY — the .bml floor confines it (host-exec itself
; is go + fkwu, pf-arm-mask 9); the lens is BML on fkwu's own lane.
;
; Verdict 255:
;   1      the live tree: zero drifts
;   2      the live twin agrees byte for byte: its line after the check mark
;          equals the lens's OK line, and it exits 0
;   4      the planted tree, read by the lens: four drifts in the script's
;          order and words (Go inst, Rust inst, Rust arm missing, Rust arm
;          without a row)
;   8      the planted tree, read by the twin: its lines after the header,
;          each after its "  - ", are those four, exit 1
;   16     the brace block: braces inside strings, line comments and block
;          comments are unseen; an unclosed block answers -1
;   32     the arms are read as the twin reads them: Go's choose/fail/stop
;          take defn's block 2 (fall-through), list is fncall with no
;          instance, add is math 1; Rust's mod is math 5; TypeScript's "+"
;          is a math alias with no instance, list has instance 1, and addf
;          (mathInst) has no row
;   64     the category handler patterns: case "x":, "x" =>, verb === "x"
;          are handlers; a longer name and a plain string are not
;   128    a root that holds no tree: one named missing input, no traceback

(do
    (defn onb-k (ok bit) (if ok bit 0))
    (defn onb-twin (command)
        (do (let out (host-exec (dg-wrap command) ""))
            (if (nothing? out) (list (sub 0 1) (list))
                (list (dg-rc out) (lx-lines (lx-strip-nl (dg-body out)))))))
    (defn onb-last (lines) (if (eq (len lines) 0) "" (nth lines (sub (len lines) 1))))
    (defn onb-lines-eq? (xs ys)
        (if (eq (len xs) (len ys))
            (if (eq (len xs) 0) 1
                (if (str_eq (head xs) (head ys)) (onb-lines-eq? (tail xs) (tail ys)) 0))
            0))
    (defn onb-strip-item (line) (lx-replace-prefix line "  - " ""))
    (defn onb-row? (rows name label inst)
        (do (let r (tb-find2 rows ong-r-named? name))
            (if (eq (len r) 0) 0
                (if (and (str_eq (nth r 1) label) (eq (nth r 2) inst)) 1 0))))
    (defn onb-plant-command ()
        (str_concat "D=$(mktemp -d) && mkdir -p $D/form/scripts $D/form/form-stdlib $D/form/form-kernel-go $D/form/form-kernel-rust/src $D/form/form-kernel-ts/src"
        (str_concat " && cp form/scripts/validate_form_ontology.py $D/form/scripts/ && cp form/form-kernel-go/main.go $D/form/form-kernel-go/ && cp form/form-kernel-ts/src/reader.ts $D/form/form-kernel-ts/src/"
        (str_concat " && sed 's/\"name\": \"add\", \"type\": 12, \"inst\": 1,/\"name\": \"add\", \"type\": 12, \"inst\": 7,/' form/form-stdlib/form-ontology.json > $D/form/form-stdlib/form-ontology.json"
                    " && sed 's/\"mod\" =>/\"modx\" =>/' form/form-kernel-rust/src/main.rs > $D/form/form-kernel-rust/src/main.rs && echo $D"))))
    (defn onb-planted-lines ()
        (list "primitive 'add' in ontology has inst=7 but form-kernel-go dispatches with inst=1"
              "primitive 'add' in ontology has inst=7 but form-kernel-rust dispatches with inst=1"
              "primitive 'mod' (type=12 inst=5) in ontology but no `case \"mod\"` in form-kernel-rust"
              "form-kernel-rust has `case \"modx\"` → math but FORM-PRIMITIVE-TABLE has no row for it"))
    (defn onb-braces () "{ x = \"}\"; // }\n y = '}'; /* } */ { z } }")
    (defn onb-remove (d) (if (and (gt (str_len d) 8) (str_eq (substring d 0 1) "/")) (host-exec (str_concat "rm -rf " d) "") 0))
    (defn ontology-band ()
        (do
            (let live-drifts (ong-analysis ""))
            (let live (onb-twin "python3 form/scripts/validate_form_ontology.py"))
            (let d (lx-strip-nl (lx-host-text (host-exec (onb-plant-command) ""))))
            (let root (str_concat d "/"))
            (let planted-drifts (ong-analysis root))
            (let planted (onb-twin (str_concat "python3 " (str_concat root "form/scripts/validate_form_ontology.py"))))
            (let go (ong-dispatch (read_file (ong-go)) "go"))
            (let rust (ong-dispatch (read_file (ong-rust)) "rust"))
            (let ts (ong-dispatch (read_file (ong-ts)) "ts"))
            (let absent (ong-analysis "/nonexistent-root/"))
            (let verdict (sum (list
                (onb-k (eq (len live-drifts) 0) 1)
                (onb-k (and (eq (head live) 0)
                            (str_eq (onb-last (nth live 1)) (str_concat "✓ " (ong-ok-line)))) 2)
                (onb-k (onb-lines-eq? planted-drifts (onb-planted-lines)) 4)
                (onb-k (and (eq (head planted) 1)
                            (and (str_eq (head (nth planted 1)) "✗ form ontology drift detected:")
                                 (onb-lines-eq? (map onb-strip-item (tail (nth planted 1))) planted-drifts))) 8)
                (onb-k (and (eq (ong-brace-end (onb-braces) 0 0) (sub (str_len (onb-braces)) 1))
                            (eq (ong-brace-end "{ a { b }" 0 0) (sub 0 1))) 16)
                (onb-k (and (str_eq (nth go 0) "ok")
                            (and (onb-row? (nth go 1) "choose" "block" 2)
                                 (and (onb-row? (nth go 1) "list" "fncall" (sub 0 1))
                                      (and (onb-row? (nth go 1) "add" "math" 1)
                                           (and (onb-row? (nth rust 1) "mod" "math" 5)
                                                (and (onb-row? (nth ts 1) "+" "math" (sub 0 1))
                                                     (and (onb-row? (nth ts 1) "list" "list" 1)
                                                          (eq (len (tb-find2 (nth ts 1) ong-r-named? "addf")) 0)))))))) 32)
                (onb-k (and (eq (ong-handler? "  case \"do\":" "do" 0) 1)
                            (and (eq (ong-handler? "\"seq\" => x" "seq" 0) 1)
                                 (and (eq (ong-handler? "if (verb === \"let\") {" "let" 0) 1)
                                      (and (eq (ong-handler? "case \"doing\":" "do" 0) 0)
                                           (eq (ong-handler? "x = \"do\" + 1" "do" 0) 0))))) 64)
                (onb-k (onb-lines-eq? absent (list "missing input: /nonexistent-root/form/form-stdlib/form-ontology.json")) 128))))
            (onb-remove d)
            verdict))
    (ontology-band))
