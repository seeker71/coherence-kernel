; tests/drift-gates-band.fk — the drift gates are rows; the fold names the row.
;
; preludes: gate/drift-gates.bml
;
; run: ./fkwu gate/tests/drift-gates-band.fk   ; -> 2047
;
; The band plants its own rows (echo, true, exit 3) so it proves the door's
; grammar without running the live gates — those run at the land cadence and
; through `./fkwu gate/drift-gates.bml`. The organ is BML; this band is .fk
; because bands in this body are .fk cells that prelude their organ (the
; lane-counsel band is the same shape).
;
; Verdict 2047:
;   1      every planted row runs: pass and refused masks together cover the full mask
;   2      a planted green row passes
;   4      a planted failing row refuses
;   8      the fold names the refusing bits: rows 2 and 4 red -> pass 5, refused 10
;   16     the exit code read is the child's own: exit 3 reads 3, echo reads 0
;   32     refusing names travel in row order
;   64     an exit-only row judges by exit alone; a mute row that owes a verdict refuses
;   128    the summary voice is the carrier's grammar: refused=0 exits 0 through the one-line door, refused=10 exits nonzero
;   256    green is full-mask equality, nothing less
;   512    the live rows are sound data: named, commanded, distinct
;   1024   a vanished launch (rc -1) never passes

(do
    (defn dgb-k (ok bit) (if ok bit 0))
    ; the one-line carrier from the door header, fed the door's own summary voice
    (defn dgb-carrier (line)
        (dg-rc (host-exec
            (str_concat "printf '%s' '" (str_concat line "' | grep -q ' refused=0 '; echo @rc=$?")) "")))
    (defn drift-gates-band ()
        (do
            (let green (dg-row "green" "echo 42" 42))
            (let red (dg-row "red" "echo 41" 42))
            (let quiet (dg-row "quiet" "true" (dg-exit-only)))
            (let loud (dg-row "loud" "echo boom; exit 3" (dg-exit-only)))
            (let mute (dg-row "mute" "true" 42))
            (let planted (list green red quiet loud))
            (let walk (dg-walk planted 1 0 0 ""))
            (sum (list
                (dgb-k (eq (add (head walk) (nth walk 1)) (dg-full planted)) 1)
                (dgb-k (eq (dg-ok? (dg-read green)) 1) 2)
                (dgb-k (eq (dg-ok? (dg-read red)) 0) 4)
                (dgb-k (and (eq (head walk) 5) (eq (nth walk 1) 10)) 8)
                (dgb-k (and (eq (nth (dg-read loud) 1) 3) (eq (nth (dg-read green) 1) 0)) 16)
                (dgb-k (str_eq (nth walk 2) "red,loud") 32)
                (dgb-k (and (eq (dg-ok? (dg-read quiet)) 1) (eq (dg-ok? (dg-read mute)) 0)) 64)
                (dgb-k (and (eq (dgb-carrier (dg-summary-line 15 15 0 "")) 0)
                            (eq (dgb-carrier (dg-summary-line 5 15 10 "red,loud")) 1)) 128)
                (dgb-k (and (eq (dg-green? (dg-full planted) planted) 1)
                            (eq (dg-green? 5 planted) 0)) 256)
                (dgb-k (eq (dg-rows-sound? (dg-rows)) 1) 512)
                (dgb-k (eq (dg-ok? (dg-reading green (sub 0 1) "launch vanished" (sub 0 1))) 0) 1024)))))
    (drift-gates-band))
