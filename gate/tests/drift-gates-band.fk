; tests/drift-gates-band.fk — the drift gates are rows; the fold names the row.
;
; preludes: gate/drift-gates.bml form-stdlib/bml/form-agent-grep.bml
;
; run: ./fkwu gate/tests/drift-gates-band.fk   ; -> 262143
;
; REQUIRES: the repository root (the live rows name their units from there) and an fkwu with the cell_run door
; (docs/in-process-cells.md); a row is one cell_run call, in this process.
;
; The band plants its own rows (cells it writes into the temp directory: one that answers 42, one that answers 41,
; one that answers 0, one that stops, one that answers a string, one that reads its stdin, one that writes beside its
; scratch path) so it proves the door's grammar without running the live gates: those run at the land cadence and
; through `./fkwu gate/drift-gates-run.bml`. The organ is BML; this band is .fk because bands in this body are .fk
; cells that prelude their organ (the lane-counsel band is the same shape).
;
; Verdict 262143:
;   1      every planted row runs: pass and refused masks together cover the full mask
;   2      a planted green row passes
;   4      a planted failing row refuses
;   8      the fold names the refusing bits: rows 2 and 4 red -> pass 5, refused 10
;   16     the rc read is the cell's own: a cell that stopped reads 1, a clean one reads 0
;   32     refusing names travel in row order
;   64     an exit-only row judges by rc alone; a mute row that owes a verdict refuses
;   128    the summary voice is the carrier's grammar: refused=0 exits 0 through the one-line door, refused=10 exits nonzero
;   256    green is full-mask equality, nothing less
;   512    the live rows are sound data: named, a unit each, distinct
;   1024   a unit that would not run (no rc, no value: nothing) never passes
;   2048   a change that moves no kernel ground runs only the rows that guard the whole tree
;   4096   a moved kernel source, or no merge-base to read, calls every row
;   8192   the fold covers the rows that ran; it never claims a row that sat out passed
;   16384  a moved unit a gate loads calls that gate, and no gate that does not load it:
;          the FORMBIN2 codec (canonical-conformance's own prelude) calls canonical-conformance,
;          not ontology
;   32768  a closure spelling that walks up folds to the path a change names, and a closure
;          that does not arrive (a unit that is not there) reads nothing, so its row runs
;   65536  a moved grammar pack calls the cursor's coverage row, though no pack is in its closure
;   131072 a row's input is the cell's stdin (["gate"] reads 7, none reads 0); the mark @scratch@ in an input line
;          is a fresh path that is gone, with whatever the cell wrote beside it, when the cell returns; the closure
;          of a live row's unit is the unit and what its prelude lines name (core.fk, and the organ the door loads)

(do
    (defn dgb-k (ok bit) (if ok bit 0))
    ; the live row a name names, or nothing when no row carries it
    (defn dgb-named (rows name)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq (dg-name (head rows)) name) (head rows) (dgb-named (tail rows) name))))
    ; the one-line carrier from the door header, fed the door's own summary voice: the body's own grep
    ; (-q, fixed text) reads the line in process and answers grep's own exit, 0 selected, 1 none
    (defn dgb-carrier (line)
        (head (grep-text (list "-qF" " refused=0 ") line)))
    ; a planted unit: written under the band's own directory, answered as its path
    (defn dgb-dir () (str_concat (temp_dir) (str_concat "/drift-gates-band-" (int_to_str (host_pid)))))
    (defn dgb-unit (name text)
        (do (let path (str_concat (dgb-dir) (str_concat "/" name)))
            (let wrote (write_file path text))
            path))
    (defn dgb-member (xs s) (if (eq (len xs) 0) 0 (if (str_eq (head xs) s) 1 (dgb-member (tail xs) s))))
    (defn drift-gates-band ()
        (do
            (let made (host_dir_mkdir (dgb-dir)))
            (let green (dg-row "green" (dgb-unit "green.fk" "(do 42)\n") (nothing) 42))
            (let red (dg-row "red" (dgb-unit "red.fk" "(do 41)\n") (nothing) 42))
            (let quiet (dg-row "quiet" (dgb-unit "quiet.fk" "(do 0)\n") (nothing) (dg-exit-only)))
            (let loud (dg-row "loud" (dgb-unit "loud.fk" "(do (print_str \"boom\") (form_error \"planted refusal\"))\n") (nothing) (dg-exit-only)))
            (let mute (dg-row "mute" (dgb-unit "mute.fk" "(do (print_str \"x\") \"quiet\")\n") (nothing) 42))
            (let ghost (dg-row "ghost" (str_concat (dgb-dir) "/no-such-unit.fk") (nothing) (dg-exit-only)))
            (let reader (dgb-unit "reader.fk" "(do (let l (read_line)) (if (nothing? l) 0 (if (str_eq l \"gate\") 7 0)))\n"))
            (let heard (dg-row "heard" reader (list "gate") 7))
            (let deaf (dg-row "deaf" reader (nothing) 7))
            (let scribe (dgb-unit "scribe.fk" "(do (let p (read_line)) (write_file p \"x\") (write_file (str_concat p \".more\") \"y\") (if (fs_exists p) 5 0))\n"))
            (let marked (dg-row "marked" scribe (list "@scratch@") 5))
            (let planted (list green red quiet loud))
            (let walk (dg-walk planted 1 0 0 ""))
            (let codec-rows (dg-rows-for (list "form/form-stdlib/bml/formbin-codec.bml")))
            (let coverage (dgb-named (dg-all-rows) "bml-cursor-coverage"))
            (let reading-ghost (dg-read ghost))
            (let reading-marked (dg-read marked))
            (let beside (str_concat (dg-scratch marked) ".more"))
            (let live-closure (dg-closure "gate/canonical-conformance-run.bml"))
            (let total (sum (list
                (dgb-k (eq (add (head walk) (nth walk 1)) (dg-full planted)) 1)
                (dgb-k (eq (dg-ok? (dg-read green)) 1) 2)
                (dgb-k (eq (dg-ok? (dg-read red)) 0) 4)
                (dgb-k (and (eq (head walk) 5) (eq (nth walk 1) 10)) 8)
                (dgb-k (and (eq (nth (dg-read loud) 1) 1) (eq (nth (dg-read green) 1) 0)) 16)
                (dgb-k (str_eq (nth walk 2) "red,loud") 32)
                (dgb-k (and (eq (dg-ok? (dg-read quiet)) 1) (eq (dg-ok? (dg-read mute)) 0)) 64)
                (dgb-k (and (eq (dgb-carrier (dg-summary-line 15 15 0 "")) 0)
                            (eq (dgb-carrier (dg-summary-line 5 15 10 "red,loud")) 1)) 128)
                (dgb-k (and (eq (dg-green? (dg-full planted) planted) 1)
                            (eq (dg-green? 5 planted) 0)) 256)
                (dgb-k (eq (dg-rows-sound? (dg-all-rows)) 1) 512)
                (dgb-k (and (eq (dg-ok? (dg-reading green (nothing) "launch vanished" (nothing))) 0)
                            (and (nothing? (nth reading-ghost 1)) (eq (dg-ok? reading-ghost) 0))) 1024)
                (dgb-k (and (eq (dg-name-in? (dg-rows-for (list "docs/live.md")) "canonical-conformance") 0)
                            (eq (len (dg-rows-for (list "docs/live.md"))) 5)) 2048)
                (dgb-k (and (eq (len (dg-rows-for (list "runtime/fkwu-uni.c"))) (len (dg-all-rows)))
                            (eq (len (dg-rows-for (nothing))) (len (dg-all-rows)))) 4096)
                (dgb-k (eq (dg-green? (dg-full (dg-all-rows)) (dg-rows-for (list "docs/live.md"))) 0) 8192)
                (dgb-k (and (eq (dg-name-in? codec-rows "canonical-conformance") 1)
                            (eq (dg-name-in? codec-rows "ontology") 0)) 16384)
                (dgb-k (and (str_eq (dg-fold-up "form/../control/offer-ack-core.fk") "control/offer-ack-core.fk")
                            (and (nothing? (dg-closure "gate/no-such-gate.bml"))
                                 (dg-touches-closure? (list "docs/live.md") (nothing)))) 32768)
                (dgb-k (and (not (nothing? coverage))
                            (dg-guards? coverage (list "form/form-stdlib/grammars/go-bmf.fk"))) 65536)
                (dgb-k (and (eq (dg-ok? (dg-read heard)) 1)
                            (and (eq (dg-ok? (dg-read deaf)) 0)
                                 (and (eq (dg-ok? reading-marked) 1)
                                      (and (eq (fs_exists (dg-scratch marked)) 0)
                                           (and (eq (fs_exists beside) 0)
                                                (and (not (nothing? live-closure))
                                                     (and (eq (dgb-member live-closure "gate/canonical-conformance-run.bml") 1)
                                                          (and (eq (dgb-member live-closure "form/form-stdlib/core.fk") 1)
                                                               (eq (dgb-member live-closure "gate/canonical-conformance.bml") 1))))))))) 131072))))
            (let cleaned (host_dir_rmdir (dgb-dir)))
            total))
    (drift-gates-band))
