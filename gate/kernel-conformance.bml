// Form owns the complete codec and sibling conformance observation.
// Every canonical expression runs on the real Go, Rust and TypeScript
// proof kernels. Each sibling emits FORMBIN2; every sibling consumes it;
// the native Form codec decodes and reconstructs its exact bytes. A distinct
// artifact built from Form wire data executes on every sibling. Every
// malformed vector is refused by Form and each sibling with its expected
// diagnostic. Numeric payloads remain raw int64/float64 bits in the codec.
//
// Builds use each tool's incremental cache. Missing TypeScript dependencies
// produce a typed absence and a failing verdict after the available arms
// are observed. Every requested arm is required for a passing gate.
// Run: ./fkwu gate/kernel-conformance.bml -> 1 when all observations pass.
// Witness: gate/tests/kernel-conformance-band.fk.
// preludes: form-stdlib/core.fk form-stdlib/table.bml gate/lens-text.bml form-stdlib/json.fk form-stdlib/bml/formbin-codec.bml

section [form.bml] {
    class FormKernelConformanceGate {
        thought kernel-conformance-pattern = list("orchestrate-never-interpret", "every-kernel-every-vector", "absent-is-a-typed-reading", "cached-build-same-proof", "native-codec-bidirectional-interop");

        def kcg-name() = "kernel-conformance";
        def kcg-vectors() = "form/conformance/canonical-s-expression-vectors.json";
        def kcg-malformed() = "form/conformance/formbin2-malformed-vectors.json";
        def kcg-schema() = "form-kernel-conformance-v1";
        def kcg-malformed-schema() = "formbin2-malformed-conformance-v1";
        def kcg-build() = ".cache/kernel-conformance";
        // `mkdir -p`, in Form, through the body's own doors. This gate used to
        // spawn a shell for it while fs_exists and fs_mkdir sat one call away --
        // a crossing paid for work already at home. Walk the path and ensure
        // each prefix at every separator; a directory that already stands is
        // success, which is the whole of what -p meant.
        def kcg-both(a, b) = ((Comparable) a == 1) && ((Comparable) b == 1) ? 1 : 0;
        def kcg-ensure-one(dir) = (Comparable) str_len(dir) == 0 ? 1 : (Comparable) fs_mkdir(dir) == 1 ? 1 : fs_is_dir(dir);
        def kcg-ensure-upto(path, i, n, held) = i > n ? held : (Comparable) i == n ? kcg-both(held, kcg-ensure-one(path)) : (Comparable) str_byte_at(path, i) == 47 ? kcg-ensure-upto(path, i + 1, n, kcg-both(held, kcg-ensure-one(substring(path, 0, i)))) : kcg-ensure-upto(path, i + 1, n, held);
        def kcg-ensure-dir(path) = kcg-ensure-upto(path, 0, str_len(path), 1);
        def kcg-go-dir() = "form/form-kernel-go";
        def kcg-rust-dir() = "form/form-kernel-rust";
        def kcg-ts-dir() = "form/form-kernel-ts";
        def kcg-tsx() = "form/form-kernel-ts/node_modules/.bin/tsx";
        def kcg-interop-source() = "(list \"fkb-interop\" 42 2147483648 3.5)";
        def kcg-interop-expected() = "[fkb-interop, 42, 2147483648, 3.5]";
        def kcg-max-bytes() = 67108864;
        def kcg-when(cond, msg) = cond ? list(msg) : list();
        def kcg-py(s) = lx-py-str(s);

        // ---- the repository root as an absolute path (children run from a kernel's own directory) ----
        def kcg-root() = host_cwd();
        def kcg-abs(root, rel) = root ++ "/" ++ rel;

        // ---- the vectors: list("ok", cases) or list("refused", message); a case is (name form expected) ----
        def kcg-cases(path, text) {
            let root = parse-json(path, text);
            !json-object-has?(root, "schema") ? list("refused", path ++ ": unsupported conformance schema")
            : !((String) node_value(json-object-get(root, "schema")) == kcg-schema()) ? list("refused", path ++ ": unsupported conformance schema")
            : !json-object-has?(root, "cases") ? list("refused", path ++ ": cases must be a non-empty list")
            : kcg-cases-list(path, node_children(json-object-get(root, "cases")));
        }
        def kcg-cases-list(path, nodes) = (Comparable) len(nodes) == 0 ? list("refused", path ++ ": cases must be a non-empty list") : kcg-cases-go(path, nodes, 0, list());
        def kcg-cases-go(path, nodes, i, acc) {
            (Comparable) len(nodes) == 0 ? list("ok", reverse(acc))
            : kcg-case-one(path, head(nodes), tail(nodes), i, acc);
        }
        def kcg-case-one(path, node, rest, i, acc) {
            (Comparable) kcg-field-ok?(node, "name") == 0 ? list("refused", path ++ ": case " ++ int_to_str(i) ++ " has invalid name")
            : (Comparable) kcg-field-ok?(node, "form") == 0 ? list("refused", path ++ ": case " ++ int_to_str(i) ++ " has invalid form")
            : (Comparable) kcg-field-ok?(node, "expected") == 0 ? list("refused", path ++ ": case " ++ int_to_str(i) ++ " has invalid expected")
            : kcg-cases-go(path, rest, i + 1, cons(list(node_value(json-object-get(node, "name")), node_value(json-object-get(node, "form")), node_value(json-object-get(node, "expected"))), acc));
        }
        // a present string field with at least one byte (node_type 2 is a trivial string)
        def kcg-field-ok?(node, key) = !json-object-has?(node, key) ? 0 : !((Comparable) node_type(json-object-get(node, key)) == 2) ? 0 : (Comparable) str_len(node_value(json-object-get(node, key))) == 0 ? 0 : 1;
        def kcg-c-name(c) = c[0];
        def kcg-c-form(c) = c[1];
        def kcg-c-expected(c) = c[2];

        // ---- the kernels: rows (name, dir, command prefix as run inside dir) ----
        def kcg-kernel(name, dir, argv) = list(name, dir, argv);
        def kcg-k-name(k) = k[0];
        def kcg-k-dir(k) = k[1];
        def kcg-k-argv(k) = k[2];
        def kcg-child(k, args) = "cd " ++ kcg-k-dir(k) ++ " && " ++ kcg-k-argv(k) ++ " " ++ args;
        // builds: list("ok", kernels, ts-present?) or list("refused", message)
        def kcg-build-kernels(root) {
            let made = kcg-ensure-dir(kcg-build());
            let go = lx-sh("GOPROXY=off go build -C " ++ kcg-go-dir() ++ " -o " ++ kcg-abs(root, kcg-build() ++ "/form-kernel-go") ++ " .");
            !((Comparable) lx-sh-rc(go) == 0) ? list("refused", "Go kernel build failed (" ++ int_to_str(lx-sh-rc(go)) ++ "):" ++ kcg-detail(lx-sh-text(go)))
            : kcg-build-rust(root);
        }
        def kcg-detail(s) = (Comparable) str_len(s) == 0 ? "no output" : lx-nl() ++ s;
        def kcg-build-rust(root) {
            let rust = lx-sh("cargo build --quiet --release --offline --manifest-path " ++ kcg-rust-dir() ++ "/Cargo.toml --target-dir " ++ kcg-rust-dir() ++ "/target");
            !((Comparable) lx-sh-rc(rust) == 0) ? list("refused", "Rust kernel build failed (" ++ int_to_str(lx-sh-rc(rust)) ++ "):" ++ kcg-detail(lx-sh-text(rust)))
            : kcg-kernels-with-ts(root, fs_exists(kcg-tsx()));
        }
        def kcg-kernels-with-ts(root, ts) {
            let go = kcg-kernel("go", kcg-go-dir(), kcg-abs(root, kcg-build() ++ "/form-kernel-go"));
            let rust = kcg-kernel("rust", kcg-rust-dir(), kcg-abs(root, kcg-rust-dir() ++ "/target/release/form-kernel-rust"));
            (Comparable) ts == 1 ? list("ok", list(go, rust, kcg-kernel("typescript", kcg-ts-dir(), "node_modules/.bin/tsx src/main.ts")), 1) : list("ok", list(go, rust), 0);
        }

        // ---- one vector on every kernel: list(passed?, line) ----
        def kcg-run-expr(k, form) {
            let r = lx-sh-out(kcg-child(k, "--expr '" ++ form ++ "'"));
            (Comparable) lx-sh-rc(r) == 0 ? lx-sh-text(r) : "<" ++ kcg-k-name(k) ++ " kernel exit " ++ int_to_str(lx-sh-rc(r)) ++ ">";
        }
        def kcg-outputs(kernels, form) = (Comparable) len(kernels) == 0 ? list() : cons(list(kcg-k-name(head(kernels)), kcg-run-expr(head(kernels), form)), kcg-outputs(tail(kernels), form));
        def kcg-all-expected?(outputs, expected) = (Comparable) len(outputs) == 0 ? 1 : (String) head(outputs)[1] == expected ? kcg-all-expected?(tail(outputs), expected) : 0;
        def kcg-rendered(o) = o[0] ++ "=" ++ kcg-py(o[1]);
        def kcg-case-line(kernels, c) {
            let outputs = str_find(kcg-c-form(c), "'", 0) >= 0 ? list() : kcg-outputs(kernels, kcg-c-form(c));
            let passed = (Comparable) len(outputs) == 0 ? 0 : kcg-all-expected?(outputs, kcg-c-expected(c));
            list(passed, ((Comparable) passed == 1 ? "PASS " : "FAIL ") ++ kcg-c-name(c) ++ ": " ++ ((Comparable) len(outputs) == 0 ? "the form carries a single quote the membrane cannot hand across" : tb-join(outputs, kcg-rendered, ", ")));
        }
        def kcg-case-lines(kernels, cases) = (Comparable) len(cases) == 0 ? list() : cons(kcg-case-line(kernels, head(cases)), kcg-case-lines(kernels, tail(cases)));
        def kcg-passed-count(results) = len(tb-filter2(results, kcg-passed?, 0));
        def kcg-passed?(r, a) = r[0];
        def kcg-line-of(r) = r[1];

        // ---- FORMBIN2 interop between the kernels: list(passed?, line, errors) ----
        def kcg-artifact(root, k) = kcg-abs(root, kcg-build() ++ "/" ++ kcg-k-name(k) ++ ".fkb");
        def kcg-emit-all(root, kernels, src) = (Comparable) len(kernels) == 0 ? list() : append(kcg-emit-one(root, head(kernels), src), kcg-emit-all(root, tail(kernels), src));
        def kcg-emit-one(root, k, src) {
            let r = lx-sh(kcg-child(k, "--emit-binary " ++ kcg-artifact(root, k) ++ " " ++ src));
            kcg-when(!((Comparable) lx-sh-rc(r) == 0), kcg-k-name(k) ++ " kernel binary emit failed (" ++ int_to_str(lx-sh-rc(r)) ++ "): " ++ lx-sh-text(r));
        }
        def kcg-read-artifact(k, artifact) {
            let r = lx-sh-out(kcg-child(k, "--binary " ++ artifact));
            (Comparable) lx-sh-rc(r) == 0 ? lx-sh-text(r) : "<exit " ++ int_to_str(lx-sh-rc(r)) ++ ">";
        }
        def kcg-consume-all(root, producers, kernels) = (Comparable) len(producers) == 0 ? list() : append(kcg-consume-one(root, head(producers), kernels), kcg-consume-all(root, tail(producers), kernels));
        def kcg-consume-one(root, producer, kernels) {
            let outputs = tb-map(kernels, kcg-consumer-of(root, producer));
            kcg-when((Comparable) kcg-all-expected?(outputs, kcg-interop-expected()) == 0, kcg-k-name(producer) ++ " FORMBIN2 artifact diverged across kernels: " ++ tb-join(outputs, kcg-rendered, ", "));
        }
        // a consumer row (name, output) for one producer's artifact
        def kcg-consumer-of(root, producer) = list(root, producer);
        def kcg-bytes-identical?(root, kernels, first) {
            (Comparable) len(kernels) == 0 ? 1
            : (String) lx-host-text(read_file(kcg-artifact(root, head(kernels)))) == first ? kcg-bytes-identical?(root, tail(kernels), first) : 0;
        }
        def kcg-interop(root, kernels) {
            let src = kcg-abs(root, kcg-build() ++ "/kernel-fkb-interop.fk");
            let wrote = write_file(src, kcg-interop-source() ++ lx-nl());
            let emitted = kcg-emit-all(root, kernels, src);
            len(emitted) > 0 ? list(0, "FAIL FORMBIN2: a kernel could not emit its artifact", emitted) : kcg-interop-read(root, kernels);
        }
        def kcg-interop-read(root, kernels) {
            let diverged = kcg-consume-all-plain(root, kernels, kernels);
            let identical = kcg-bytes-identical?(root, kernels, lx-host-text(read_file(kcg-artifact(root, head(kernels)))));
            let codec = append(kcg-native-produced(root, kernels), kcg-native-roundtrips(root, kernels));
            let errors = append(codec, append(diverged, kcg-when((Comparable) identical == 0, "sibling kernels emitted different FORMBIN2 bytes for one source")));
            list((Comparable) len(errors) == 0 ? 1 : 0,
                 (Comparable) len(errors) == 0 ? "PASS FORMBIN2: " ++ int_to_str(len(kernels)) ++ " kernel artifacts read by " ++ int_to_str(len(kernels)) ++ " kernels; sibling bytes identical; Form-produced artifact executed by every kernel; Form codec byte-roundtrips every sibling artifact" : "FAIL FORMBIN2: see the errors below",
                 errors);
        }
        def kcg-native-root() = fbc-composite(fbc-leaf(1, 2, 34, 1), list(fbc-string(1, "form-formbin2"), fbc-leaf(1, 1, 1, 42), fbc-number(3, fbc-word(128) ++ fbc-word(0)), fbc-number(2, fbc-word(0) ++ fbc-word(3136))));
        def kcg-native-produced(root, kernels) {
            let path = kcg-abs(root, kcg-build() ++ "/form-produced.fkb");
            let encoded = fbc-dump(path, kcg-native-root());
            !fbc-good(encoded) ? list("Form codec emission failed: " ++ fbc-error(encoded))
            : kcg-native-consumers(kernels, path);
        }
        def kcg-native-consumers(kernels, path) = nil?(kernels) ? list() : append(kcg-when(!((String) kcg-read-artifact(head(kernels), path) == "[form-formbin2, 42, 2147483648, 3.5]"), kcg-k-name(head(kernels)) ++ " did not execute the Form-produced artifact"), kcg-native-consumers(tail(kernels), path));
        def kcg-native-roundtrips(root, kernels) = nil?(kernels) ? list() : append(kcg-native-roundtrip(kcg-artifact(root, head(kernels)), kcg-k-name(head(kernels))), kcg-native-roundtrips(root, tail(kernels)));
        def kcg-native-roundtrip(path, name) {
            let decoded = fbc-load(path);
            !fbc-good(decoded) ? list(name ++ " artifact refused by Form codec: " ++ fbc-error(decoded))
            : kcg-native-repacked(path, name, fbc-encode(fbc-value(decoded)));
        }
        def kcg-native-repacked(path, name, encoded) = !fbc-good(encoded) ? list(name ++ " artifact re-encoding failed: " ++ fbc-error(encoded)) : kcg-when(!((String) read_file(path) == fbc-value(encoded)), "Form codec did not byte-roundtrip " ++ name);
        // every consumer reads every producer's artifact
        def kcg-consume-all-plain(root, producers, kernels) = (Comparable) len(producers) == 0 ? list() : append(kcg-consume-plain(root, head(producers), kernels, kernels), kcg-consume-all-plain(root, tail(producers), kernels));
        def kcg-consume-plain(root, producer, consumers, kernels) {
            let outputs = kcg-consumer-outputs(root, producer, consumers);
            kcg-when((Comparable) kcg-all-expected?(outputs, kcg-interop-expected()) == 0, kcg-k-name(producer) ++ " FORMBIN2 artifact diverged across kernels: " ++ tb-join(outputs, kcg-rendered, ", "));
        }
        def kcg-consumer-outputs(root, producer, consumers) = (Comparable) len(consumers) == 0 ? list() : cons(list(kcg-k-name(head(consumers)), kcg-read-artifact(head(consumers), kcg-artifact(root, producer))), kcg-consumer-outputs(root, producer, tail(consumers)));

        // ---- the malformed vectors: rows (name builder value-or-depth expected) ----
        def kcg-malformed-cases(path, text) {
            let root = parse-json(path, text);
            !json-object-has?(root, "schema") ? list("refused", path ++ ": unsupported malformed-vector schema")
            : !((String) node_value(json-object-get(root, "schema")) == kcg-malformed-schema()) ? list("refused", path ++ ": unsupported malformed-vector schema")
            : !json-object-has?(root, "cases") ? list("refused", path ++ ": cases must be a non-empty list")
            : kcg-malformed-list(path, node_children(json-object-get(root, "cases")), 0, list());
        }
        def kcg-malformed-list(path, nodes, i, acc) {
            (Comparable) len(nodes) == 0 ? kcg-malformed-done(path, acc)
            : kcg-malformed-one(path, head(nodes), tail(nodes), i, acc);
        }
        def kcg-malformed-done(path, acc) = (Comparable) len(acc) == 0 ? list("refused", path ++ ": cases must be a non-empty list") : list("ok", reverse(acc));
        def kcg-malformed-one(path, node, rest, i, acc) {
            ((Comparable) kcg-field-ok?(node, "name") == 0) || ((Comparable) kcg-field-ok?(node, "expected_error") == 0) ? list("refused", path ++ ": case " ++ int_to_str(i) ++ " has invalid metadata")
            : kcg-malformed-list(path, rest, i + 1, cons(list(node_value(json-object-get(node, "name")), kcg-str-field(node, "builder"), kcg-builder-arg(node), node_value(json-object-get(node, "expected_error"))), acc));
        }
        def kcg-str-field(node, key) = json-object-has?(node, key) ? node_value(json-object-get(node, key)) : "";
        // hex keeps its text; nested-composite keeps its depth as text; oversized carries nothing
        def kcg-builder-arg(node) = json-object-has?(node, "value") ? node_value(json-object-get(node, "value")) : json-object-has?(node, "depth") ? int_to_str(node_value(json-object-get(node, "depth"))) : "";
        def kcg-m-name(m) = m[0];
        def kcg-m-builder(m) = m[1];
        def kcg-m-arg(m) = m[2];
        def kcg-m-expected(m) = m[3];
        // the nested composite as hex: leaf = five u32 words; node = u32(1) leaf u32(1) node, depth times; FORMBIN2 u32(0) node
        def kcg-u32(n) = kcg-hex8(n, 8, "");
        def kcg-hex8(n, k, acc) = (Comparable) k == 0 ? acc : kcg-hex8(n / 16, k - 1, kcg-hex-digit(n % 16) ++ acc);
        def kcg-hex-digit(d) = substring("0123456789abcdef", d, d + 1);
        def kcg-leaf-hex() = kcg-u32(0) ++ kcg-u32(1) ++ kcg-u32(1) ++ kcg-u32(1) ++ kcg-u32(0);
        def kcg-nested-hex(depth, node) = depth <= 0 ? node : kcg-nested-hex(depth - 1, kcg-u32(1) ++ kcg-leaf-hex() ++ kcg-u32(1) ++ node);
        def kcg-magic-hex() = "464f524d42494e32";
        def kcg-composite-hex(depth) = kcg-magic-hex() ++ kcg-u32(0) ++ kcg-nested-hex(depth, kcg-leaf-hex());
        // build the artifact file; answers list() or one error
        def kcg-build-malformed(root, m, i) {
            let base = kcg-abs(root, kcg-build() ++ "/malformed-" ++ int_to_str(i));
            (String) kcg-m-builder(m) == "hex" ? kcg-hex-file(base, kcg-m-arg(m))
            : (String) kcg-m-builder(m) == "nested-composite" ? kcg-hex-file(base, kcg-composite-hex(str_to_int(kcg-m-arg(m))))
            : (String) kcg-m-builder(m) == "oversized-artifact" ? kcg-oversized-file(base)
            : list("malformed case " ++ kcg-m-name(m) ++ ": unknown builder " ++ kcg-py(kcg-m-builder(m)));
        }
        // hex to bytes, in Form. This spawned a shell for `xxd -r -p` while
        // str_byte_at and host_file_append_bytes stood ready -- a crossing for
        // arithmetic. A nibble that is not a hex digit answers -1 and poisons
        // its byte, so a malformed vector cannot be silently built out of
        // whatever the text happened to contain.
        def kcg-nibble(c) = (c >= 48) && (c <= 57) ? (c - 48) : (c >= 97) && (c <= 102) ? (c - 87) : (c >= 65) && (c <= 70) ? (c - 55) : (0 - 1);
        def kcg-hex-bytes(hex, i, n, acc) {
            (i + 1) >= (n + 1) ? reverse(acc)
            : (i + 2) > n ? reverse(acc)
            : kcg-hex-step(hex, i, n, acc, kcg-nibble(str_byte_at(hex, i)), kcg-nibble(str_byte_at(hex, i + 1)));
        }
        def kcg-hex-step(hex, i, n, acc, hi, lo) = (hi < 0) || (lo < 0) ? reverse(acc) : kcg-hex-bytes(hex, i + 2, n, cons((hi * 16) + lo, acc));
        def kcg-hex-file(base, hex) {
            let path = base ++ ".fkb";
            let cleared = (Comparable) fs_exists(path) == 1 ? fs_remove(path) : 0;
            let bytes = kcg-hex-bytes(hex, 0, str_len(hex), list());
            let wrote = host_file_append_bytes(path, bytes);
            kcg-when((wrote < 0) || (!((Comparable) (len(bytes) * 2) == str_len(hex))), "could not build a malformed artifact from hex: wrote " ++ int_to_str(wrote) ++ " of " ++ int_to_str(str_len(hex) / 2));
        }
        // One byte over the ceiling, made by naming its length rather than by
        // piping sixty-four megabytes of /dev/zero through a shell. The header
        // is eight real bytes; fs_truncate sets the extent, sparse, so the file
        // whose whole point is how long it is costs nothing to make.
        def kcg-oversized-file(base) {
            let path = base ++ ".fkb";
            let cleared = (Comparable) fs_exists(path) == 1 ? fs_remove(path) : 0;
            let header = host_file_append_bytes(path, list(70, 79, 82, 77, 66, 73, 78, 50));
            let want = kcg-max-bytes() + 1;
            let got = fs_truncate(path, want);
            kcg-when((header < 0) || (!((Comparable) got == want)), "could not build the oversized artifact: extent " ++ int_to_str(got) ++ " of " ++ int_to_str(want));
        }
        // one malformed vector on every kernel: list(passed?, line, errors)
        def kcg-malformed-line(root, kernels, m, i) {
            let built = kcg-build-malformed(root, m, i);
            len(built) > 0 ? list(0, "FAIL malformed FORMBIN2 " ++ kcg-m-name(m), built) : kcg-malformed-judge(root, kernels, m, i);
        }
        def kcg-malformed-judge(root, kernels, m, i) {
            let artifact = kcg-abs(root, kcg-build() ++ "/malformed-" ++ int_to_str(i) ++ ".fkb");
            let native = fbc-load(artifact);
            let errors = append(kcg-when(fbc-good(native) || (!((String) fbc-error(native) == kcg-m-expected(m))), "Form codec accepted or misclassified " ++ kcg-m-name(m) ++ ": " ++ fbc-error(native)), kcg-reject-all(kernels, m, artifact));
            list((Comparable) len(errors) == 0 ? 1 : 0,
                 ((Comparable) len(errors) == 0 ? "PASS malformed FORMBIN2 " : "FAIL malformed FORMBIN2 ") ++ kcg-m-name(m) ++ ": Form codec + " ++ int_to_str(len(kernels)) ++ " kernels rejected",
                 errors);
        }
        def kcg-reject-all(kernels, m, artifact) = (Comparable) len(kernels) == 0 ? list() : append(kcg-reject-one(head(kernels), m, artifact), kcg-reject-all(tail(kernels), m, artifact));
        def kcg-reject-one(k, m, artifact) {
            let r = lx-sh(kcg-child(k, "--binary " ++ artifact));
            kcg-when(((Comparable) lx-sh-rc(r) == 0) || ((Comparable) lx-has?(lx-sh-text(r), kcg-m-expected(m)) == 0), kcg-k-name(k) ++ " accepted or misclassified malformed FORMBIN2 " ++ kcg-m-name(m) ++ ": exit=" ++ int_to_str(lx-sh-rc(r)) ++ ", expected " ++ kcg-py(kcg-m-expected(m)) ++ ", output=" ++ kcg-py(lx-sh-text(r)));
        }
        def kcg-malformed-lines(root, kernels, ms, i) = (Comparable) len(ms) == 0 ? list() : cons(kcg-malformed-line(root, kernels, head(ms), i), kcg-malformed-lines(root, kernels, tail(ms), i + 1));
        def kcg-errors-of(results) = (Comparable) len(results) == 0 ? list() : append(head(results)[2], kcg-errors-of(tail(results)));

        // ---- the analysis: list(status, case-results, interop-result, malformed-results, errors, ts-present?, kernel-count, case-count) ----
        def kcg-refusal(msg) = list("refused", list(), list(0, "", list()), list(), list(msg), 0, 0, 0);
        def kcg-analysis() {
            let text = read_file(kcg-vectors());
            let mtext = read_file(kcg-malformed());
            nothing?(text) ? kcg-refusal("missing input: " ++ kcg-vectors())
            : nothing?(mtext) ? kcg-refusal("missing input: " ++ kcg-malformed())
            : kcg-analysis-cases(kcg-cases(kcg-vectors(), text), kcg-malformed-cases(kcg-malformed(), mtext));
        }
        def kcg-analysis-cases(cases, ms) {
            (String) cases[0] == "refused" ? kcg-refusal(cases[1])
            : (String) ms[0] == "refused" ? kcg-refusal(ms[1])
            : kcg-analysis-build(cases[1], ms[1], kcg-root());
        }
        def kcg-analysis-build(cases, ms, root) {
            let built = kcg-build-kernels(root);
            (String) built[0] == "refused" ? kcg-refusal(built[1]) : kcg-analysis-run(cases, ms, root, built[1], built[2]);
        }
        def kcg-ts-absent-line() = "TypeScript kernel absent (run `npm ci` in form/form-kernel-ts); the Go and Rust halves are proved above, the third witness is not";
        def kcg-analysis-run(cases, ms, root, kernels, ts) {
            let results = kcg-case-lines(kernels, cases);
            let interop = kcg-interop(root, kernels);
            let malformed = kcg-malformed-lines(root, kernels, ms, 0);
            let failed = tb-filter2(results, kcg-failed?, 0);
            let errors = append(tb-map(failed, kcg-fail-error), append(interop[2], append(kcg-errors-of(malformed), kcg-when((Comparable) ts == 0, kcg-ts-absent-line()))));
            list((Comparable) len(errors) == 0 ? "pass" : "fail", results, interop, malformed, errors, ts, len(kernels), len(cases));
        }
        def kcg-failed?(r, a) = (Comparable) r[0] == 1 ? 0 : 1;
        def kcg-fail-error(r) = "canonical expression diverged: " ++ substring(r[1], 5, str_len(r[1]));
        def kcg-a-status(a) = a[0];
        def kcg-a-results(a) = a[1];
        def kcg-a-interop(a) = a[2];
        def kcg-a-malformed(a) = a[3];
        def kcg-a-errors(a) = a[4];
        def kcg-a-ts(a) = a[5];
        def kcg-a-kernels(a) = a[6];
        def kcg-a-cases(a) = a[7];

        // ---- the voice ----
        def kcg-summary(a) = int_to_str(kcg-a-cases(a)) ++ " canonical expressions × " ++ int_to_str(kcg-a-kernels(a)) ++ " real kernels";
        def kcg-fail-summary(a) = int_to_str(kcg-passed-count(kcg-a-results(a))) ++ "/" ++ int_to_str(kcg-a-cases(a)) ++ " canonical expressions on " ++ int_to_str(kcg-a-kernels(a)) ++ " real kernels; FORMBIN2 interop " ++ ((Comparable) kcg-a-interop(a)[0] == 1 ? "green" : "red") ++ "; " ++ int_to_str(kcg-passed-count(kcg-a-malformed(a))) ++ "/" ++ int_to_str(len(kcg-a-malformed(a))) ++ " malformed artifacts refused";
        def kcg-print-lines(lines) = lx-print-prefixed("", lines);
        def kcg-judge() {
            let a = kcg-analysis();
            kcg-print-lines(tb-map(kcg-a-results(a), kcg-line-of));
            kcg-print-lines(kcg-when(len(kcg-a-results(a)) > 0, kcg-a-interop(a)[1]));
            kcg-print-lines(tb-map(kcg-a-malformed(a), kcg-line-of));
            lx-verdict-full(kcg-name(), list(), kcg-a-errors(a), kcg-summary(a), (String) kcg-a-status(a) == "refused" ? "" : kcg-fail-summary(a));
        }
        def kcg-run() = kcg-judge();
    }
    kcg-run();
}
