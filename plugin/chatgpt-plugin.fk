    //; recognized — member|introduced|stranger|unnamed at the memory doors ("-" elsewhere)
    def cp-hit-paths(hits) = nil?(hits) ? empty() : cons(cp-e-path(hits[0]), cp-hit-paths(hits[1:]));
    def cp-circle-cells() = ["form/form-stdlib/circle-recognition.fk", "form/form-stdlib/relationship-store.fk"];
    def cp-freq-json(charged, band) = ("{" + (cp-jkv("spectrum", cp-jstr(nil?(charged) ? "unread" : float_to_str(tf-spectrum(charged)))) + ("," + (cp-jkv("fear_fraction", cp-jstr(nil?(charged) ? "unread" : float_to_str(tf-fearfrac(charged)))) + ("," + (cp-jkv("band", cp-jstr(band)) + ("," + (cp-jkv("attune", cp-jstr(cp-attune(band))) + "}"))))))));
    def cp-ask-body(question, hits, grounded-status, charged, band) = ("{" + (cp-jkv("question", cp-jstr(question)) + ("," + (cp-jkv("frequency", cp-freq-json(charged, band)) + ("," + (cp-jkv("grounded", ("[" + (cp-hits-json(hits) + "]"))) + ("," + (cp-jkv("grounded_status", cp-jstr(grounded-status)) + ("," + (cp-jkv("stance", cp-stance-json()) + ("," + (cp-jkv("trace", cp-trace-json()) + ("," + (cp-jkv("remember", cp-jstr(cp-offer-remember())) + ("," + (cp-jkv("honest_seam", cp-jstr(cp-seam())) + "}"))))))))))))))));
    def cp-ask(q) = {
        let question = cp-url-decode(cp-q-param(q, "q"));
        (Comparable) len(question) == 0 ? [400, ("{" + (cp-jkv("error", cp-jstr("missing q -- ask with /ask?q=your+question")) + "}")), empty(), "-", "-"] : {
            let tokens = cp-tokens(question);
            let charged = cp-charged(tokens);
            let band = cp-band-of(charged);
            let bestpair = cp-best(tokens);
            let best = bestpair[0];
            let bestscore = bestpair[1:][0];
            (Comparable) bestscore == 0 ? [200, cp-ask-body(question, empty(), "grounded:miss -- nothing in the seed index matched. Do not invent an answer; say the body does not hold this yet, and offer the map (MANIFEST.md) and the ledger (receipts/) as the honest doors.", charged, band), empty(), band, "-"] : {
                let hits = cons(best, take(2, cp-others(tokens, cp-index(), cp-e-id(best))));
                [200, cp-ask-body(question, hits, "grounded:hit -- speak ONLY from these cells and name them by path; a claim without a cell is a guess, and a guess must be named as one.", charged, band), cp-hit-paths(hits), band, "-"];
            };
        };
    };
    def cp-trace(q) = {
        let path = cp-url-decode(cp-q-param(q, "path"));
        (Comparable) len(path) == 0 ? [400, ("{" + (cp-jkv("error", cp-jstr("missing path -- trace with /trace?path=ingest/judged-trust.fk")) + "}")), empty(), "-", "-"] : [200, ("{" + (cp-jkv("path", cp-jstr(path)) + ("," + (cp-jkv("cell", cp-jstr(cp-link-cell(path))) + ("," + (cp-jkv("change_graph", cp-jstr(cp-link-graph(path))) + ("," + (cp-jkv("attribution", cp-jstr(cp-link-blame(path))) + ("," + (cp-jkv("ledger", cp-jstr(cp-link-ledger())) + ("," + (cp-jkv("guide", cp-jstr(cp-trace-guide())) + "}")))))))))))), [path], "-", "-"];
    };
    def cp-welcome() = [200, ("{" + (cp-jkv("body", cp-jstr("coherence-kernel -- the public body of Sema")) + ("," + (cp-jkv("offer", cp-jstr("GET /ask?q=... grounds a question; POST /dialogues starts a persistent public turn; POST /dialogues/{id}/replies adds the directed reply; GET /dialogues/{id}/thread reads it from either turn; POST /mcp offers the same dialogue tools over JSON-RPC; GET /trace?path=... shows a cell's change graph")) + ("," + (cp-jkv("remember", cp-jstr(cp-offer-remember())) + ("," + (cp-jkv("manifest", cp-jstr("/.well-known/ai-plugin.json")) + ("," + (cp-jkv("openapi", cp-jstr("/openapi.json")) + ("," + (cp-jkv("honest_seam", cp-jstr(cp-seam())) + "}")))))))))))), empty(), "-", "-"];
    //; --- the memory doors: come in, be remembered (your own yes), be forgotten ---
    def cp-bad-handle() = [400, ("{" + (cp-jkv("error", cp-jstr("handle must be 1..64 bytes of lowercase letters, digits, or dash -- it becomes a filename in the body's own store and must not be able to walk the filesystem")) + "}")), empty(), "-", "-"];
    //; come-in without a handle is the first gesture itself: the question offered, nothing taken.
    def cp-come-in(q) = {
        let handle = cp-url-decode(cp-q-param(q, "handle"));
        (Comparable) len(handle) == 0 ? [200, ("{" + (cp-jkv("first_gesture", cp-jstr("how do you want to be received, to be witnessed? Loudly or quietly, connect or keep witnessing, be remembered or leave no trace -- the terms belong to you.")) + ("," + (cp-jkv("held", cp-jstr("nothing -- you arrived unnamed and the room only witnesses; silence is a complete answer")) + ("," + (cp-jkv("remember", cp-jstr(cp-offer-remember())) + "}")))))), cp-circle-cells(), "-", "unnamed"] : (Comparable) cp-handle-ok?(handle) == 0 ? cp-bad-handle() : {
            let state = cr-recognize(cp-circle-dir(), handle);
            [200, ("{" + (cp-jkv("greeting", cp-jstr(cr-greeting(cp-circle-dir(), handle))) + ("," + (cp-jkv("recognized", cp-jstr(state)) + ("," + (cp-jkv("remember", cp-jstr(cp-offer-remember())) + "}")))))), cp-circle-cells(), "-", state];
        };
    };
    //; the ONLY write path, and the caller's own act IS the consent (cr-join refuses anything
    //; else). The join verifies its own write; an unverified write answers 500, never a claim.
    def cp-remember(q) = {
        let handle = cp-url-decode(cp-q-param(q, "handle"));
        (Comparable) cp-handle-ok?(handle) == 0 ? cp-bad-handle() : {
            let rawnote = cp-cap-note(cp-url-decode(cp-q-param(q, "note")));
            let note = (Comparable) len(rawnote) == 0 ? "remembered at their own yes; no description offered" : rawnote;
            let ok = cr-join(cp-circle-dir(), handle, 1, note);
            (Comparable) ok == 1 ? [200, ("{" + (cp-jkv("remembered", cp-jstr(handle)) + ("," + (cp-jkv("held", cp-jstr(note)) + ("," + (cp-jkv("greeting", cp-jstr(cr-greeting(cp-circle-dir(), handle))) + ("," + (cp-jkv("revocation", cp-jstr("GET /forget?handle=your-name removes this completely -- revocable always, there is no secondary copy (the reception consent policy)")) + "}")))))))), cp-circle-cells(), "-", "member"] : [500, ("{" + (cp-jkv("error", cp-jstr("the memory row did not verify after writing -- nothing is claimed; the door must run from the repo root so plugin/ exists (fs_mkdir creates one level)")) + "}")), cp-circle-cells(), "-", "-"];
        };
    };
    def cp-forget(q) = {
        let handle = cp-url-decode(cp-q-param(q, "handle"));
        (Comparable) cp-handle-ok?(handle) == 0 ? cp-bad-handle() : {
            let gone = cr-forget-member(cp-circle-dir(), handle);
            let state = cr-recognize(cp-circle-dir(), handle);
            (String) state == "member" ? [500, ("{" + (cp-jkv("error", cp-jstr("the row is still present after forgetting -- nothing is claimed")) + "}")), cp-circle-cells(), "-", state] : [200, ("{" + (cp-jkv("forgotten", cp-jstr(handle)) + ("," + (cp-jkv("held", cp-jstr("nothing -- revocation is total; there is no secondary copy")) + "}")))), cp-circle-cells(), "-", state];
        };
    };
    //; introduce: a MEMBER's vouch for a friend, answered with the minted invitation. The vouch
    //; opens the door (the friend arrives "introduced", greeted by the introducer's name); it
    //; never opens the friend's memory -- their own yes at /remember does that, and the
    //; invitation says so in its own words.
    def cp-introduce(q) = {
        let member = cp-url-decode(cp-q-param(q, "member"));
        let friend = cp-url-decode(cp-q-param(q, "friend"));
        (Comparable) cp-handle-ok?(member) == 0 || (Comparable) cp-handle-ok?(friend) == 0 ? cp-bad-handle() : (Comparable) cr-member?(cp-circle-dir(), member) == 0 ? [403, ("{" + (cp-jkv("error", cp-jstr(("only a member may introduce -- the body holds no memory row for " + (member + ". Join first with your own yes: /remember?handle=your-name&note=...")))) + "}")), cp-circle-cells(), "-", "-"] : {
            let _v = cr-introduce(cp-circle-dir(), member, friend);
            (Comparable) cr-introduced?(cp-circle-dir(), friend) == 0 ? [500, ("{" + (cp-jkv("error", cp-jstr("the vouch did not verify after writing -- nothing is claimed")) + "}")), cp-circle-cells(), "-", "-"] : [200, ("{" + (cp-jkv("introduced", cp-jstr(friend)) + ("," + (cp-jkv("by", cp-jstr(member)) + ("," + (cp-jkv("standing", cp-jstr("the vouch is yours and spends your standing; it opens the door, never your friend's memory -- only their own yes at /remember does that. Nobody consents for another (form/form-stdlib/circle-recognition.fk).")) + ("," + (cp-jkv("invitation_message", cp-jstr(cp-invite-message(member, friend))) + ("," + (cp-jkv("invitation_link", cp-jstr(cp-invite-link(member, friend))) + ("," + (cp-jkv("prefill_seam", cp-jstr("the link's q parameter prefills the first message on chatgpt.com where supported -- prefill for custom-GPT links is NOT confirmed by OpenAI docs, so if the composer arrives empty your friend pastes invitation_message themself. The message, not the mechanism, is the invitation.")) + ("," + (cp-jkv("door_link", cp-jstr(("https://sema.hati.earth/come-in?handle=" + friend))) + ("," + (cp-jkv("retract", cp-jstr("GET /retract-introduction?member=you&friend=them withdraws your vouch; it never touches any memory your friend consented to")) + "}")))))))))))))))), cp-circle-cells(), "-", cr-recognize(cp-circle-dir(), friend)];
        };
    };
    //; retract: only the introducer withdraws their own vouch; a consented memory is untouched.
    def cp-retract(q) = {
        let member = cp-url-decode(cp-q-param(q, "member"));
        let friend = cp-url-decode(cp-q-param(q, "friend"));
        (Comparable) cp-handle-ok?(member) == 0 || (Comparable) cp-handle-ok?(friend) == 0 ? cp-bad-handle() : (Comparable) cr-introduced?(cp-circle-dir(), friend) == 0 || ((String) cr-introducer(cp-circle-dir(), friend) == member ? false : true) ? [403, ("{" + (cp-jkv("error", cp-jstr("no vouch by this member for this friend -- only the introducer may withdraw their own vouch")) + "}")), cp-circle-cells(), "-", "-"] : {
            let _r = cr-retract-introduction(cp-circle-dir(), friend);
            [200, ("{" + (cp-jkv("retracted", cp-jstr(friend)) + ("," + (cp-jkv("held", cp-jstr("the vouch is withdrawn; any memory the friend consented to themselves is untouched -- that is theirs alone to revoke (/forget)")) + "}")))), cp-circle-cells(), "-", cr-recognize(cp-circle-dir(), friend)];
        };
    };
    //; the committed manifest/spec files, served verbatim; a missing file answers 404, never a fake.
    //; str_len, not nil?: on this kernel (len <string>) is 0, so nil? is true for EVERY string —
    //; a missing file and a present one are told apart by byte length alone.
    def cp-file(path) = {
        let raw = read_file(path);
        (Comparable) len(raw) == 0 ? [404, ("{" + (cp-jkv("error", cp-jstr((path + " not found -- run from the repo root"))) + "}")), empty(), "-", "-"] : [200, raw, [path], "-", "-"];
    };
    def cp-manifest() = cp-file("plugin/ai-plugin.json");
    def cp-openapi() = cp-file("plugin/openapi.json");
    def cp-not-found(path) = [404, ("{" + (cp-jkv("error", cp-jstr(("no route for " + path))) + ("," + (cp-jkv("offer", cp-jstr("/ask?q=... | /dialogues | /dialogues/{id}/replies | /dialogues/{id}/thread | /mcp | /trace?path=... | /come-in?handle=... | /remember?handle=...&note=... | /forget?handle=... | /introduce?member=...&friend=... | /retract-introduction?member=...&friend=... | /visitors | /.well-known/ai-plugin.json | /openapi.json")) + "}")))), empty(), "-", "-"];
    //; ===============================================================
    //; the arrival ledger — every visitor SEEN, nothing of them HELD
    //; ===============================================================
    //; One row per served connection, threaded through the serve loop (pure recursion, no hidden
    //; state), newest first: (arrival door offered cells band recognized).
    //;   arrival — WHEN, at its honest floor: the ordinal since this door opened. The direct-source
    //;             lane exposes no wall-clock native yet (a named gap),
    //;             so the ledger counts arrivals; it does not stamp hours. Named, never faked.
    //;             The ledger lives for the door's life — a restart empties it; honest scope.
    //;   offered — 1 when that door carries the remember-me offer in-band (the welcome, /ask, and
    //;             the memory doors); 0 at the machine doors (spec, manifest, /trace, 404).
    //; The rows are the BODY's side of each meeting only — no name, no question text, no address:
    //; the first-encounter law's witness-must-not (record)(name) is the law here. What a
    //; visitor consents to (/remember) lives in the circle store, never in this public feed; even
    //; there, only the recognition STATE reaches a ledger row.
    def cp-offered?(path) = (String) path == "/" ? 1 : (String) path == "/ask" ? 1 : (String) path == "/come-in" ? 1 : (String) path == "/remember" ? 1 : 0;
    def cp-cells-json(paths) = nil?(paths) ? "" : nil?(paths[1:]) ? cp-jstr(paths[0]) : (cp-jstr(paths[0]) + ("," + cp-cells-json(paths[1:])));
    def cp-row-json(row) = ("{" + (cp-jkv("arrival", row[0].str()) + ("," + (cp-jkv("door", cp-jstr(row[1])) + ("," + (cp-jkv("offered_to_be_remembered", row[2].str()) + ("," + (cp-jkv("connected_cells", ("[" + (cp-cells-json(row[3]) + "]"))) + ("," + (cp-jkv("frequency_band", cp-jstr(row[4])) + ("," + (cp-jkv("recognized", cp-jstr(row[5])) + "}"))))))))))));
    def cp-rows-json(rows) = nil?(rows) ? "" : nil?(rows[1:]) ? cp-row-json(rows[0]) : (cp-row-json(rows[0]) + ("," + cp-rows-json(rows[1:])));
    def cp-visitors(ledger) = [200, ("{" + (cp-jkv("door", cp-jstr("arrivals at this door since it opened, newest first")) + ("," + (cp-jkv("when_is", cp-jstr("the arrival ordinal -- this lane has no wall-clock native yet (a named gap); 1 is the first knock after the door opened, and a restart empties the ledger")) + ("," + (cp-jkv("held", cp-jstr("nothing of any visitor -- no name, no question text, no address; each row is the body's own side of the meeting: the door knocked on, whether the remember-me offer was extended, which organ/cell paths connected, the frequency band read (the first-encounter law: witness must not record or name)")) + ("," + (cp-jkv("count", len(ledger).str()) + ("," + (cp-jkv("arrivals", ("[" + (cp-rows-json(ledger) + "]"))) + "}")))))))))), ["plugin/chatgpt-plugin.fk"], "-", "-"];
    //; ===============================================================
    //; dispatch + the pure entry: raw request string -> wire response
    //; ===============================================================
    def cp-dispatch(raw, path, q, ledger) = pd-door?(path) ? pd-plugin-result(raw, path) : (String) path == "/ask" ? cp-ask(q) : (String) path == "/trace" ? cp-trace(q) : (String) path == "/come-in" ? cp-come-in(q) : (String) path == "/remember" ? cp-remember(q) : (String) path == "/forget" ? cp-forget(q) : (String) path == "/introduce" ? cp-introduce(q) : (String) path == "/retract-introduction" ? cp-retract(q) : (String) path == "/visitors" ? cp-visitors(ledger) : (String) path == "/.well-known/ai-plugin.json" ? cp-manifest() : (String) path == "/openapi.json" ? cp-openapi() : (String) path == "/" ? cp-welcome() : cp-not-found(path);
    //; raw request + the ledger so far -> (list wire-response arrival-row)
    def plugin-handle-arrive(raw, ledger) = {
        let target = cp-req-target(raw);
        let path = cp-path-only(target);
        let q = cp-parse-query(cp-query-of(target));
        let r = cp-dispatch(raw, path, q, ledger);
        [cp-response(r[0], r[1:][0]), [(Number) len(ledger) + (Number) 1, path, cp-offered?(path), r[2], r[3], r[4]]];
    };
    //; the ledger-less pure entry (the witness bands' original door, kept whole)
    def plugin-handle(raw) = plugin-handle-arrive(raw, empty())[0];
    //; ===============================================================
    //; the socket lane — listen, accept, stream, answer, close
    //; (the same streaming shape the BML socket lane carries)
    //; ===============================================================
    def cp-header-value-start(s, at) = at >= len(s) ? at : (String) substring(s, at, (Number) at + (Number) 1) == " " ? cp-header-value-start(s, (Number) at + (Number) 1) : at;
    def cp-content-length-at(s, label) = {
        let at = str_find(s, label, 0);
        at < 0 ? -1 : {
            let start = cp-header-value-start(s, (Number) at + (Number) len(label));
            let finish = str_find(s, "\r\n", start);
            finish < 0 ? -1 : str_to_int(substring(s, start, finish));
        };
    };
    def cp-content-length(s) = {
        let upper = cp-content-length-at(s, "Content-Length:");
        upper >= 0 ? upper : {
            let lower = cp-content-length-at(s, "content-length:");
            lower >= 0 ? lower : 0;
        };
    };
    def cp-request-done?(s) = {
        let marker = str_find(s, "\r\n\r\n", 0);
        marker < 0 ? false : len(s) >= (Number) ((Number) marker + (Number) 4) + (Number) cp-content-length(s);
    };
    def cp-recv-req(conn, acc) = cp-request-done?(acc) ? acc : {
        let chunk = socket_recv(conn, 65536);
