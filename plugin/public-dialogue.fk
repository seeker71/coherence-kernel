// public-dialogue.fk — persistent public dialogue cells, edges, HTTP, and MCP in Form.
//
import form-stdlib/core.fk;
import form-stdlib/sha256.fk;
import form-stdlib/json.fk;
import form-stdlib/relationship-store.fk;
//
// A turn owns its own removal capability.  Public reads expose the turn and its
// directed parent edge, never the capability or its digest.  Release removes
// the turn's content and leaves a content-free tombstone so the graph can still
// be observed from either connected turn after a restart.
section [form.bml] {
    def pd-dir() = "plugin/dialogues";
    def pd-disclosure() = "public-unlisted-thread-v2";
    // ----- bounded public text ---------------------------------------------
    def pd-text-ok-loop(s, i) = (Comparable) i == len(s) ? 1 : {
        let b = str_byte_at(s, i);
        b < 32 ? 0 : pd-text-ok-loop(s, (Number) i + (Number) 1);
    };
    def pd-text-ok?(s, maximum) = len(s) > 0 ? len(s) <= maximum ? pd-text-ok-loop(s, 0) : 0 : 0;
    def pd-locale-ok?(s) = pd-text-ok?(s, 80);
    def pd-id-char-ok?(b) = b >= 48 && b <= 57 || (b >= 97 && b <= 122 || (Comparable) b == 45);
    def pd-id-ok-loop(s, i) = (Comparable) i == len(s) ? 1 : pd-id-char-ok?(str_byte_at(s, i)) ? pd-id-ok-loop(s, (Number) i + (Number) 1) : 0;
    def pd-id-ok?(s) = len(s) > 0 ? len(s) <= 80 ? pd-id-ok-loop(s, 0) : 0 : 0;
    // ----- ids and private capability digests -----------------------------
    def pd-hex-digit(n) = n < 10 ? byte_to_str((Number) 48 + (Number) n) : byte_to_str((Number) 87 + (Number) n);
    def pd-hex-byte(b) = ((String) pd-hex-digit(b / 16) + pd-hex-digit(b % 16));
    def pd-hex-loop(bytes, out) = (Comparable) len(bytes) == 0 ? out : pd-hex-loop(bytes[1:], ((String) out + pd-hex-byte(bytes[0])));
    def pd-hex-string-loop(bytes, index, out) = (Comparable) index == len(bytes) ? out : pd-hex-string-loop(bytes, (Number) index + (Number) 1, ((String) out + pd-hex-byte(str_byte_at(bytes, index))));
    def pd-random-hex(count) = pd-hex-string-loop(read_file_slice("/dev/urandom", 0, count), 0, "");
    def pd-new-id() = ("dlg-" + pd-random-hex(16));
    def pd-new-token() = ("remove-" + pd-random-hex(32));
    def pd-token-digest(token) = pd-hex-loop(sha256-stream-string(token), "");
    def pd-constant-match-loop(left, right, index, difference) = (Comparable) index == len(left) ? (Comparable) difference == 0 ? 1 : 0 : pd-constant-match-loop(left, right, (Number) index + (Number) 1, bor(difference, bxor(str_byte_at(left, index), str_byte_at(right, index))));
    def pd-constant-match?(left, right) = (Comparable) len(left) == len(right) ? pd-constant-match-loop(left, right, 0, 0) : 0;
    // ----- durable field cells --------------------------------------------
    def pd-key(id, field) = (id + ("-" + field));
    def pd-has-field?(dir, id, field) = rs-known?(dir, pd-key(id, field));
    def pd-read(dir, id, field) = pd-has-field?(dir, id, field) ? rs-recall(dir, pd-key(id, field)) : "";
    def pd-write(dir, id, field, value) = rs-remember(dir, pd-key(id, field), value);
    def pd-forget(dir, id, field) = rs-forget(dir, pd-key(id, field));
    def pd-record?(dir, id) = pd-has-field?(dir, id, "state");
    def pd-active?(dir, id) = pd-record?(dir, id) ? (String) pd-read(dir, id, "state") == "tombstoned" ? 0 : 1 : 0;
    // ----- comma list of safe dialogue ids --------------------------------
    def pd-csv-loop(s, start) = {
        let comma = str_find(s, ",", start);
        (Comparable) comma == -1 ? [substring(s, start, len(s))] : cons(substring(s, start, comma), pd-csv-loop(s, (Number) comma + (Number) 1));
    };
    def pd-csv(s) = (Comparable) len(s) == 0 ? empty() : pd-csv-loop(s, 0);
    def pd-root-turns(dir, root) = pd-csv(pd-read(dir, root, "turns"));
    def pd-append-turn(dir, root, id) = {
        let current = pd-read(dir, root, "turns");
        pd-write(dir, root, "turns", (Comparable) len(current) == 0 ? id : (current + ("," + id)));
    };
    // ----- JSON ------------------------------------------------------------
    def pd-jesc-byte(b) = (Comparable) b == 34 ? "\\\"" : (Comparable) b == 92 ? "\\\\" : (Comparable) b == 10 ? "\\n" : (Comparable) b == 13 ? "\\r" : (Comparable) b == 9 ? "\\t" : b < 32 ? " " : byte_to_str(b);
    def pd-jesc-loop(s, i, out) = (Comparable) i == len(s) ? out : pd-jesc-loop(s, (Number) i + (Number) 1, ((String) out + pd-jesc-byte(str_byte_at(s, i))));
    def pd-jstr(s) = ("\"" + (pd-jesc-loop(s, 0, "") + "\""));
    def pd-jkv(key, value) = (pd-jstr(key) + (":" + value));
    def pd-error-json(message) = ("{" + (pd-jkv("error", pd-jstr(message)) + "}"));
    def pd-result(code, body) = [code, body];
    def pd-code(result) = result[0];
    def pd-body(result) = result[1];
    def pd-turn-json(dir, id) = {
        let state = pd-read(dir, id, "state");
        let parent = pd-read(dir, id, "parent");
        (String) state == "tombstoned" ? ("{" + (pd-jkv("id", pd-jstr(id)) + ("," + (pd-jkv("state", pd-jstr("tombstoned")) + ("," + (pd-jkv("parent_dialogue_id", (Comparable) len(parent) == 0 ? "null" : pd-jstr(parent)) + "}")))))) : ("{" + (pd-jkv("id", pd-jstr(id)) + ("," + (pd-jkv("state", pd-jstr(state)) + ("," + (pd-jkv("question", pd-jstr(pd-read(dir, id, "question"))) + ("," + (pd-jkv("point_of_view", pd-jstr(pd-read(dir, id, "point"))) + ("," + (pd-jkv("locale", pd-jstr(pd-read(dir, id, "locale"))) + ("," + (pd-jkv("parent_dialogue_id", (Comparable) len(parent) == 0 ? "null" : pd-jstr(parent)) + ("," + (pd-jkv("created_at_unix_ms", pd-read(dir, id, "created")) + "}"))))))))))))));
    };
    def pd-turns-json(dir, ids) = (Comparable) len(ids) == 0 ? "" : (Comparable) len(ids) == 1 ? pd-turn-json(dir, ids[0]) : (pd-turn-json(dir, ids[0]) + ("," + pd-turns-json(dir, ids[1:])));
    def pd-edge-json(dir, id) = ("{" + (pd-jkv("from", pd-jstr(pd-read(dir, id, "parent"))) + ("," + (pd-jkv("to", pd-jstr(id)) + ("," + (pd-jkv("relation", pd-jstr("reply")) + "}"))))));
    def pd-edges-json(dir, ids) = (Comparable) len(ids) == 0 ? "" : {
        let id = ids[0];
        let parent = pd-read(dir, id, "parent");
        (Comparable) len(parent) == 0 ? pd-edges-json(dir, ids[1:]) : {
            let rest = pd-edges-json(dir, ids[1:]);
            (Comparable) len(rest) == 0 ? pd-edge-json(dir, id) : (pd-edge-json(dir, id) + ("," + rest));
        };
    };
    // ----- create, read, release -------------------------------------------
    def pd-create-response(id, token, parent) = pd-result(202, ("{" + (pd-jkv("id", pd-jstr(id)) + ("," + (pd-jkv("state", pd-jstr("offered")) + ("," + (pd-jkv("parent_dialogue_id", (Comparable) len(parent) == 0 ? "null" : pd-jstr(parent)) + ("," + (pd-jkv("removal_token", pd-jstr(token)) + ("," + (pd-jkv("poll_url", pd-jstr(("/dialogues/" + id))) + "}")))))))))));
    def pd-write-turn(dir, id, token, parent, root, question, point, locale, disclosure) = {
        pd-write(dir, id, "state", "offered");
        pd-write(dir, id, "question", question);
        pd-write(dir, id, "point", point);
        pd-write(dir, id, "locale", locale);
        pd-write(dir, id, "parent", parent);
        pd-write(dir, id, "root", root);
        pd-write(dir, id, "disclosure", disclosure);
        pd-write(dir, id, "token-digest", pd-token-digest(token));
        pd-write(dir, id, "created", now_unix_ms().str());
        pd-append-turn(dir, root, id);
        pd-create-response(id, token, parent);
    };
    def pd-create-with(dir, id, token, parent, question, point, locale, disclosure) = (Comparable) pd-id-ok?(id) == 0 ? pd-result(400, pd-error-json("dialogue id is not a safe capability id")) : pd-record?(dir, id) ? pd-result(409, pd-error-json("dialogue id already exists")) : (Comparable) pd-text-ok?(question, 1200) == 0 ? pd-result(400, pd-error-json("question must be 1..1200 visible bytes")) : (Comparable) pd-text-ok?(point, 240) == 0 ? pd-result(400, pd-error-json("point_of_view must be 1..240 visible bytes")) : (Comparable) pd-locale-ok?(locale) == 0 ? pd-result(400, pd-error-json("locale must be 1..80 visible bytes")) : (String) disclosure == pd-disclosure() ? (Comparable) len(parent) == 0 ? pd-write-turn(dir, id, token, "", id, question, point, locale, disclosure) : (Comparable) pd-id-ok?(parent) == 0 ? pd-result(400, pd-error-json("parent_dialogue_id is malformed")) : (Comparable) pd-active?(dir, parent) == 0 ? pd-result(404, pd-error-json("parent dialogue is unavailable")) : (String) pd-read(dir, parent, "disclosure") == pd-disclosure() ? pd-write-turn(dir, id, token, parent, pd-read(dir, parent, "root"), question, point, locale, disclosure) : pd-result(403, pd-error-json("parent does not disclose its thread")) : pd-result(400, pd-error-json("public-unlisted-thread-v2 acknowledgement is needed"));
    def pd-create(dir, parent, question, point, locale, disclosure) = pd-create-with(dir, pd-new-id(), pd-new-token(), parent, question, point, locale, disclosure);
    def pd-get(dir, id) = (Comparable) pd-id-ok?(id) == 0 ? pd-result(400, pd-error-json("dialogue id is malformed")) : pd-record?(dir, id) ? pd-result(200, pd-turn-json(dir, id)) : pd-result(404, pd-error-json("dialogue not found"));
    def pd-thread(dir, anchor) = (Comparable) pd-id-ok?(anchor) == 0 ? pd-result(400, pd-error-json("dialogue id is malformed")) : pd-record?(dir, anchor) ? (String) pd-read(dir, anchor, "disclosure") == pd-disclosure() ? {
        let root = pd-read(dir, anchor, "root");
        let ids = pd-root-turns(dir, root);
        pd-result(200, ("{" + (pd-jkv("anchor_dialogue_id", pd-jstr(anchor)) + ("," + (pd-jkv("root_dialogue_id", pd-jstr(root)) + ("," + (pd-jkv("turns", ("[" + (pd-turns-json(dir, ids) + "]"))) + ("," + (pd-jkv("directed_edges", ("[" + (pd-edges-json(dir, ids) + "]"))) + "}")))))))));
    } : pd-result(403, pd-error-json("dialogue does not disclose its thread")) : pd-result(404, pd-error-json("dialogue not found"));
    def pd-released-json(id) = ("{" + (pd-jkv("id", pd-jstr(id)) + ("," + (pd-jkv("state", pd-jstr("tombstoned")) + ("," + (pd-jkv("released", "true") + "}"))))));
    def pd-release-record(dir, id) = {
        pd-write(dir, id, "state", "tombstoned");
        pd-forget(dir, id, "question");
        pd-forget(dir, id, "point");
        pd-forget(dir, id, "locale");
        pd-result(200, pd-released-json(id));
    };
    def pd-release-known(dir, id, token) = (Comparable) pd-constant-match?(pd-read(dir, id, "token-digest"), pd-token-digest(token)) == 1 ? pd-release-record(dir, id) : pd-result(403, pd-error-json("removal capability did not match"));
    def pd-release-with(dir, id, token) = (Comparable) pd-id-ok?(id) == 0 ? pd-result(400, pd-error-json("dialogue id is malformed")) : pd-record?(dir, id) ? pd-release-known(dir, id, token) : pd-result(404, pd-error-json("dialogue not found"));
    // ----- HTTP request membrane ------------------------------------------
    def pd-method-at(raw, at) = at < 0 ? "" : substring(raw, 0, at);
    def pd-method(raw) = pd-method-at(raw, str_find(raw, " ", 0));
    def pd-body-at(raw, marker) = marker < 0 ? "" : substring(raw, (Number) marker + (Number) 4, len(raw));
    def pd-body-of(raw) = pd-body-at(raw, str_find(raw, "\r\n\r\n", 0));
    def pd-hex-value(b) = b >= 48 && b <= 57 ? b - 48 : b >= 65 && b <= 70 ? b - 55 : b >= 97 && b <= 102 ? b - 87 : -1;
    def pd-url-decode-loop(s, i, out) = i >= len(s) ? out : {
        let b = str_byte_at(s, i);
        (Comparable) b == 43 ? pd-url-decode-loop(s, (Number) i + (Number) 1, (out + " ")) : (Comparable) b == 37 && (Number) i + (Number) 2 < len(s) ? {
            let hi = pd-hex-value(str_byte_at(s, (Number) i + (Number) 1));
            let lo = pd-hex-value(str_byte_at(s, (Number) i + (Number) 2));
            hi < 0 || lo < 0 ? pd-url-decode-loop(s, (Number) i + (Number) 1, ((String) out + byte_to_str(b))) : pd-url-decode-loop(s, (Number) i + (Number) 3, ((String) out + byte_to_str((Number) (hi * 16) + (Number) lo)));
        } : pd-url-decode-loop(s, (Number) i + (Number) 1, ((String) out + byte_to_str(b)));
    };
    def pd-url-decode(s) = pd-url-decode-loop(s, 0, "");
    def pd-form-pair(text) = {
        let at = str_find(text, "=", 0);
        at < 0 ? [pd-url-decode(text), ""] : [pd-url-decode(substring(text, 0, at)), pd-url-decode(substring(text, (Number) at + (Number) 1, len(text)))];
    };
    def pd-form-loop(body, start) = {
        let amp = str_find(body, "&", start);
        amp < 0 ? [pd-form-pair(substring(body, start, len(body)))] : cons(pd-form-pair(substring(body, start, amp)), pd-form-loop(body, (Number) amp + (Number) 1));
    };
    def pd-form(body) = (Comparable) len(body) == 0 ? empty() : pd-form-loop(body, 0);
    def pd-param(params, key) = (Comparable) len(params) == 0 ? "" : (String) params[0][0] == key ? params[0][1] : pd-param(params[1:], key);
    def pd-prefix?(text, prefix) = len(text) < len(prefix) ? false : (String) substring(text, 0, len(prefix)) == prefix;
    def pd-suffix?(text, suffix) = len(text) < len(suffix) ? false : (String) substring(text, len(text) - len(suffix), len(text)) == suffix;
    def pd-path-id(path) = pd-prefix?(path, "/dialogues/") ? {
        let slash = str_find(path, "/", 11);
        slash < 0 ? substring(path, 11, len(path)) : substring(path, 11, slash);
    } : "";
    def pd-turn-path?(path, id) = (String) path == ("/dialogues/" + id);
    def pd-reply-path?(path, id) = (String) path == ("/dialogues/" + (id + "/replies"));
    def pd-thread-path?(path, id) = (String) path == ("/dialogues/" + (id + "/thread"));
    def pd-start-from-params(dir, params, parent) = pd-create(dir, parent, pd-param(params, "question"), pd-param(params, "point_of_view"), pd-param(params, "locale"), pd-param(params, "public_disclosure_ack"));
    // ----- MCP JSON-RPC membrane -----------------------------------------
    def pd-json-string(obj, key) = json-object-has?(obj, key) ? json-string-value(json-object-get(obj, key)) : "";
    def pd-mcp-tools() = "{\"tools\":[{\"name\":\"start_dialogue\",\"description\":\"Offer one persistent public dialogue turn.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"question\",\"point_of_view\",\"locale\",\"public_disclosure_ack\"],\"properties\":{\"question\":{\"type\":\"string\"},\"point_of_view\":{\"type\":\"string\"},\"locale\":{\"type\":\"string\"},\"public_disclosure_ack\":{\"const\":\"public-unlisted-thread-v2\"}}}},{\"name\":\"reply_dialogue\",\"description\":\"Offer a reply with a directed parent edge.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"parent_dialogue_id\",\"question\",\"point_of_view\",\"locale\",\"public_disclosure_ack\"],\"properties\":{\"parent_dialogue_id\":{\"type\":\"string\"},\"question\":{\"type\":\"string\"},\"point_of_view\":{\"type\":\"string\"},\"locale\":{\"type\":\"string\"},\"public_disclosure_ack\":{\"const\":\"public-unlisted-thread-v2\"}}}},{\"name\":\"get_dialogue\",\"description\":\"Observe one unlisted turn.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"dialogue_id\"],\"properties\":{\"dialogue_id\":{\"type\":\"string\"}}}},{\"name\":\"get_dialogue_thread\",\"description\":\"Observe the connected directed thread from either turn id.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"dialogue_id\"],\"properties\":{\"dialogue_id\":{\"type\":\"string\"}}}},{\"name\":\"remove_dialogue\",\"description\":\"Release one turn into a content-free tombstone with its own capability.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"dialogue_id\",\"removal_token\"],\"properties\":{\"dialogue_id\":{\"type\":\"string\"},\"removal_token\":{\"type\":\"string\"}}}}]}";
    def pd-mcp-domain-call(dir, name, args) = (String) name == "start_dialogue" ? pd-create(dir, "", pd-json-string(args, "question"), pd-json-string(args, "point_of_view"), pd-json-string(args, "locale"), pd-json-string(args, "public_disclosure_ack")) : (String) name == "reply_dialogue" ? pd-create(dir, pd-json-string(args, "parent_dialogue_id"), pd-json-string(args, "question"), pd-json-string(args, "point_of_view"), pd-json-string(args, "locale"), pd-json-string(args, "public_disclosure_ack")) : (String) name == "get_dialogue" ? pd-get(dir, pd-json-string(args, "dialogue_id")) : (String) name == "get_dialogue_thread" ? pd-thread(dir, pd-json-string(args, "dialogue_id")) : (String) name == "remove_dialogue" ? pd-release-with(dir, pd-json-string(args, "dialogue_id"), pd-json-string(args, "removal_token")) : pd-result(404, pd-error-json("unknown MCP dialogue tool"));
    def pd-mcp-response(id-text, result) = {
        let failed = pd-code(result) >= 400;
        let content = ("{\"type\":\"text\",\"text\":" + (pd-jstr(pd-body(result)) + "}"));
        let payload = ("{\"content\":[" + (content + ("],\"structuredContent\":" + (pd-body(result) + (",\"isError\":" + ((failed ? "true" : "false") + "}"))))));
        let response = ("{\"jsonrpc\":\"2.0\",\"id\":" + (id-text + (",\"result\":" + (payload + "}"))));
        pd-result(200, response);
    };
    def pd-mcp-error(id-text, code, message) = pd-result(200, ("{\"jsonrpc\":\"2.0\",\"id\":" + (id-text + (",\"error\":{\"code\":" + (code.str() + (",\"message\":" + (pd-jstr(message) + "}}")))))));
    def pd-mcp(dir, raw) = {
        let root = parse-json("mcp", pd-body-of(raw));
        let id-text = json-object-has?(root, "id") ? json-emit(json-object-get(root, "id")) : "null";
        let method = pd-json-string(root, "method");
        ((String) pd-json-string(root, "jsonrpc") == "2.0" ? len(method) > 0 : false) ? (String) method == "tools/list" ? pd-result(200, ("{\"jsonrpc\":\"2.0\",\"id\":" + (id-text + (",\"result\":" + (pd-mcp-tools() + "}"))))) : (String) method == "tools/call" ? {
            let params = json-object-get(root, "params");
            let name = pd-json-string(params, "name");
            let args = json-object-get(params, "arguments");
            pd-mcp-response(id-text, pd-mcp-domain-call(dir, name, args));
        } : pd-mcp-error(id-text, -32601, "method not found") : pd-mcp-error(id-text, -32600, "invalid JSON-RPC request");
    };
    def pd-door?(path) = (String) path == "/dialogues" || (pd-prefix?(path, "/dialogues/") || (String) path == "/mcp");
    def pd-handle-in(dir, raw, path) = {
        let method = pd-method(raw);
        let params = pd-form(pd-body-of(raw));
        let id = pd-path-id(path);
        (String) method == "POST" && (String) path == "/dialogues" ? pd-start-from-params(dir, params, "") : (String) method == "POST" && pd-reply-path?(path, id) ? pd-start-from-params(dir, params, id) : (String) method == "GET" && pd-thread-path?(path, id) ? pd-thread(dir, id) : (String) method == "GET" && pd-turn-path?(path, id) ? pd-get(dir, id) : (String) method == "DELETE" && pd-turn-path?(path, id) ? pd-release-with(dir, id, pd-param(params, "removal_token")) : (String) method == "POST" && (String) path == "/mcp" ? pd-mcp(dir, raw) : pd-result(404, pd-error-json("no public dialogue route for this method and path"));
    };
    def pd-handle(raw, path) = pd-handle-in(pd-dir(), raw, path);
    def pd-plugin-result(raw, path) = {
        let r = pd-handle(raw, path);
        [pd-code(r), pd-body(r), ["plugin/public-dialogue.fk"], "-", "-"];
    };
    0;
}
