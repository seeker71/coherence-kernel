; public-dialogue-contract-band.fk — the plugin contract names the Form-native dialogue doors.
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk
;
; Verdict 255 when both JSON contracts parse and expose the persistent,
; directed, independently removable dialogue operations.

(do
    (defn pdcb-score (condition bit) (if condition bit 0))
    (defn pdcb-jstr (object key) (json-string-value (json-object-get object key)))
    (defn pdcb-operation (paths path method)
        (json-object-get (json-object-get paths path) method))

    (let openapi (parse-json "plugin/openapi.json" (read_file "plugin/openapi.json")))
    (let manifest (parse-json "plugin/ai-plugin.json" (read_file "plugin/ai-plugin.json")))
    (let paths (json-object-get openapi "paths"))
    (let schemas (json-object-get (json-object-get openapi "components") "schemas"))
    (let model-description (pdcb-jstr manifest "description_for_model"))

    (let c1 (pdcb-score (str_eq (pdcb-jstr openapi "openapi") "3.1.0") 1))
    (let c2 (pdcb-score
        (str_eq (pdcb-jstr (pdcb-operation paths "/dialogues" "post") "operationId")
            "start_dialogue") 2))
    (let c3 (pdcb-score
        (str_eq (pdcb-jstr
            (pdcb-operation paths "/dialogues/{dialogue_id}/replies" "post")
            "operationId") "reply_dialogue") 4))
    (let c4 (pdcb-score
        (str_eq (pdcb-jstr
            (pdcb-operation paths "/dialogues/{dialogue_id}/thread" "get")
            "operationId") "get_dialogue_thread") 8))
    (let c5 (pdcb-score
        (str_eq (pdcb-jstr
            (pdcb-operation paths "/dialogues/{dialogue_id}" "delete")
            "operationId") "remove_dialogue") 16))
    (let c6 (pdcb-score
        (and (json-object-has? schemas "DialogueTurn")
             (json-object-has? schemas "DialogueThread")) 32))
    (let c7 (pdcb-score
        (and (ge (str_find model-description "private removal_token" 0) 0)
             (ge (str_find model-description "content-free tombstones" 0) 0)) 64))
    (let c8 (pdcb-score
        (and (str_eq (pdcb-jstr manifest "name_for_model") "sema_coherence_kernel")
             (str_eq (pdcb-jstr (json-object-get manifest "api") "type") "openapi")) 128))

    (sum (list c1 c2 c3 c4 c5 c6 c7 c8)))
