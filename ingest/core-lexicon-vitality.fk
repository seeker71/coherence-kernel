; core-lexicon-vitality.fk — a vitality overlay for the closed 64-word core.
;
; A transmutation never edits core-lexicon.fk. It offers one core word as a
; candidate successor to another and keeps both profiles, the acknowledgement,
; and the served word in a reversible receipt. The base word remains served
; when evidence is absent, the candidate is declined, or more than one
; candidate competes for the same word.
;
; Admission follows skill-vitality's earned-upgrade shape:
;   vitality rises; trust rises; sovereignty does not fall; coverage and proof
;   count rise; residuals do not rise. The three outcomes use
;   satsang-transmute's terminal acknowledgement kinds:
;     nothing  hold the unmeasured candidate; keep the original
;     0        decline the candidate; keep the original
;     1        admit the candidate; keep the original in the receipt
;
; Honest floor: profile scores, counts, and source names are caller-offered
; observations. This cell validates and compares them; it does not infer a
; word's vitality or verify that a named source exists. Test profiles are
; mechanics fixtures, never semantic judgments about the words they contain.
;
; witnessed: 2026-08-13 -> band 2047, four-way
; Receipt: receipts/2026-08-13-core-lexicon-vitality.md
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/core-lexicon.fk ingest/satsang-transmute.fk

(do
    ; A profile is the observed state of one core word at one source.
    (defn clv-profile
        (word vitality trust sovereignty coverage proof-count residual-count source)
        (list "CoreLexiconVitalityProfile" word vitality trust sovereignty
              coverage proof-count residual-count source))
    (defn clv-profile-word (profile) (nth profile 1))
    (defn clv-profile-vitality (profile) (nth profile 2))
    (defn clv-profile-trust (profile) (nth profile 3))
    (defn clv-profile-sovereignty (profile) (nth profile 4))
    (defn clv-profile-coverage (profile) (nth profile 5))
    (defn clv-profile-proof-count (profile) (nth profile 6))
    (defn clv-profile-residual-count (profile) (nth profile 7))
    (defn clv-profile-source (profile) (nth profile 8))

    (defn clv-score? (score)
        (if (and (ge score 0) (le score 100)) 1 0))
    (defn clv-profile-valid? (profile)
        (if (eq (len profile) 9)
            (if (str_eq (head profile) "CoreLexiconVitalityProfile")
                (if (eq (cl-is-word? (clv-profile-word profile)) 1)
                    (if (and (eq (clv-score? (clv-profile-vitality profile)) 1)
                        (and (eq (clv-score? (clv-profile-trust profile)) 1)
                        (and (eq (clv-score? (clv-profile-sovereignty profile)) 1)
                        (and (eq (clv-score? (clv-profile-coverage profile)) 1)
                        (and (ge (clv-profile-proof-count profile) 0)
                        (and (ge (clv-profile-residual-count profile) 0)
                             (gt (str_len (clv-profile-source profile)) 0)))))))
                        1 0)
                    0)
                0)
            0))
    (defn clv-profile-measured? (profile)
        (if (eq (clv-profile-valid? profile) 1)
            (if (gt (clv-profile-proof-count profile) 0) 1 0)
            0))

    ; The candidate retains both present compositions. A changed word is a new
    ; offered shape, never an overwrite of the original (axiom-3).
    (defn clv-candidate (before after)
        (list "CoreLexiconVitalityCandidate" before after))
    (defn clv-candidate-before (candidate) (nth candidate 1))
    (defn clv-candidate-after (candidate) (nth candidate 2))
    (defn clv-candidate-original (candidate)
        (clv-profile-word (clv-candidate-before candidate)))
    (defn clv-candidate-proposed (candidate)
        (clv-profile-word (clv-candidate-after candidate)))
    (defn clv-candidate-valid? (candidate)
        (if (eq (len candidate) 3)
            (if (str_eq (head candidate) "CoreLexiconVitalityCandidate")
                (if (and
                        (eq (clv-profile-valid? (clv-candidate-before candidate)) 1)
                        (eq (clv-profile-valid? (clv-candidate-after candidate)) 1))
                    (if (str_eq (clv-candidate-original candidate)
                                (clv-candidate-proposed candidate))
                        0 1)
                    0)
                0)
            0))

    ; An admitted successor must be better on the dimensions vitality owns.
    ; Sovereignty and residuals are non-worsening; the other observed axes rise.
    (defn clv-better? (candidate)
        (if (eq (clv-candidate-valid? candidate) 0) 0
            (do
                (let before (clv-candidate-before candidate))
                (let after (clv-candidate-after candidate))
                (if (and
                        (gt (clv-profile-vitality after)
                            (clv-profile-vitality before))
                    (and
                        (gt (clv-profile-trust after)
                            (clv-profile-trust before))
                    (and
                        (ge (clv-profile-sovereignty after)
                            (clv-profile-sovereignty before))
                    (and
                        (gt (clv-profile-coverage after)
                            (clv-profile-coverage before))
                    (and
                        (gt (clv-profile-proof-count after)
                            (clv-profile-proof-count before))
                        (ge (clv-profile-residual-count before)
                            (clv-profile-residual-count after)))))))
                    1 0))))

    ; The terminal acknowledgement for one candidate. Invalid candidates are
    ; explicit declines; valid but unmeasured candidates rest as nothing.
    (defn clv-ack-kind (candidate)
        (if (eq (clv-candidate-valid? candidate) 0)
            (stx-tag-zero)
            (if (or
                    (eq (clv-profile-measured?
                            (clv-candidate-before candidate)) 0)
                    (eq (clv-profile-measured?
                            (clv-candidate-after candidate)) 0))
                (stx-tag-nothing)
                (if (eq (clv-better? candidate) 1)
                    (stx-tag-one)
                    (stx-tag-zero)))))
    (defn clv-verdict (candidate)
        (stx-verdict (clv-ack-kind candidate)))
    (defn clv-served-candidate-word (candidate)
        (if (eq (clv-ack-kind candidate) (stx-tag-one))
            (clv-candidate-proposed candidate)
            (clv-candidate-original candidate)))

    ; Ambiguity never chooses a winner. Zero or many candidates leave the
    ; original word in circulation; exactly one candidate may be served.
    (defn clv-candidate-for? (candidate word)
        (if (eq (clv-candidate-valid? candidate) 1)
            (if (str_eq (clv-candidate-original candidate) word) 1 0)
            0))
    (defn clv-candidate-count-for (candidates word)
        (if (eq (len candidates) 0) 0
            (add (clv-candidate-for? (head candidates) word)
                 (clv-candidate-count-for (tail candidates) word))))
    (defn clv-first-candidate-for (candidates word)
        (if (eq (len candidates) 0) (empty)
            (if (eq (clv-candidate-for? (head candidates) word) 1)
                (head candidates)
                (clv-first-candidate-for (tail candidates) word))))
    (defn clv-serve-word (word candidates)
        (if (eq (cl-is-word? word) 0) word
            (if (eq (clv-candidate-count-for candidates word) 1)
                (clv-served-candidate-word
                    (clv-first-candidate-for candidates word))
                word)))

    ; Tend the readable word surface while the authoritative 64-row lexicon
    ; remains untouched and reachable through cl-lexicon.
    (defn clv-tend-loop (rows candidates)
        (if (eq (len rows) 0) (empty)
            (cons (clv-serve-word (cl-word (head rows)) candidates)
                  (clv-tend-loop (tail rows) candidates))))
    (defn clv-tended-words (candidates)
        (clv-tend-loop (cl-lexicon) candidates))
    (defn clv-all-core? (words)
        (if (eq (len words) 0) 1
            (if (eq (cl-is-word? (head words)) 1)
                (clv-all-core? (tail words))
                0)))
    (defn clv-difference-count (before after)
        (if (eq (len before) 0) 0
            (add
                (if (str_eq (head before) (head after)) 0 1)
                (clv-difference-count (tail before) (tail after)))))
    (defn clv-base-words ()
        (clv-tend-loop (cl-lexicon) (empty)))
    (defn clv-transmuted-count (candidates)
        (clv-difference-count (clv-base-words)
                              (clv-tended-words candidates)))

    ; The receipt makes rollback a read, not a reconstruction.
    (defn clv-receipt (candidate)
        (list "CoreLexiconVitalityReceipt"
              (clv-candidate-original candidate)
              (clv-candidate-proposed candidate)
              (clv-ack-kind candidate)
              (clv-verdict candidate)
              (clv-served-candidate-word candidate)
              (clv-candidate-before candidate)
              (clv-candidate-after candidate)))
    (defn clv-receipt-original (receipt) (nth receipt 1))
    (defn clv-receipt-proposed (receipt) (nth receipt 2))
    (defn clv-receipt-ack-kind (receipt) (nth receipt 3))
    (defn clv-receipt-verdict (receipt) (nth receipt 4))
    (defn clv-receipt-served (receipt) (nth receipt 5))
    (defn clv-rollback (receipt) (clv-receipt-original receipt))

    0)
