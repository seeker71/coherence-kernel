; frontier-ingest-kat-coder-v25-band.fk — the KAT-Coder V2.5 ingest sorts
; every grounded finding correctly through the depth×fear law.
;
; preludes: form-stdlib/core.fk form-stdlib/knowledge-ingest.fk ingest/frontier-ingest-kat-coder-v25.fk
;
; run: ./fkwu ingest/tests/frontier-ingest-kat-coder-v25-band.fk   ; -> 1023
;      (resolver-driven; the preludes line above is the live load directive —
;       never cat the units by hand)
;
; Verdict 1023 when the ingest is honest. Bit weights are powers of two, not
; decimal digits, so a wrong bit lands on a distinct number the eye can read
; (the verdict-fold ceiling taught this once already).

(do
    (defn fikcb-score (ok bit) (if ok bit 0))
    (defn frontier-ingest-kat-coder-v25-band ()
        (do
    ; identity of the artifact is not identity of the pipeline — FREEZES
    (let c0 (fikcb-score (eq (ki-ingest (fikc-u1)) 2) 1))
    ; bound the disagreement instead of eliminating it — FREEZES
    (let c1 (fikcb-score (eq (ki-ingest (fikc-u2)) 2) 2))
    ; the instrument that scores you needs its own witness — FREEZES
    (let c2 (fikcb-score (eq (ki-ingest (fikc-u3)) 2) 4))
    ; named particulars, one at a time — FREEZES
    (let c3 (fikcb-score (eq (ki-ingest (fikc-u4)) 2) 8))
    ; single-digit delta over its own base is WITNESSED, never frozen
    (let c4 (fikcb-score (eq (ki-ingest (fikc-u5)) 1) 16))
    ; the priced sibling against the open voice seam is WITNESSED too
    (let c5 (fikcb-score (eq (ki-ingest (fikc-u6)) 1) 32))
    ; the cross-vendor ranking off one vendor's table COMPOSTS
    (let c6 (fikcb-score (eq (ki-ingest (fikc-u7)) 0) 64))
    ; activated-params-read-as-residency COMPOSTS too
    (let c7 (fikcb-score (eq (ki-ingest (fikc-u8)) 0) 128))
    ; the honest tally: 4 frozen, 2 witnessed, 2 composted
    (let c8 (fikcb-score (eq (fikc-field-code) 40202) 256))
    ; the uncomfortable priced-sibling unit is still SEEN — fear blocks ice,
    ; not sight
    (let c9 (fikcb-score (eq (ki-witnessable? (fikc-u6)) 1) 512))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 c9)))))))))
    )
    )
    (frontier-ingest-kat-coder-v25-band))
