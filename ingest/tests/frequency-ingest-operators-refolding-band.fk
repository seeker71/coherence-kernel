; frequency-ingest-operators-refolding-band.fk — conscious refolding enters
; without its field cosmology borrowing the structural teaching's ground.
;
; The voice unit is not only prose convergence: the body's existing acoustic
; organ independently reads content, identity, prosody, and band from one
; window. That proves observable layers, not biophotonic field instruction.
;
; preludes: form-stdlib/core.fk ingest/knowledge-ingest.fk observe/audio-fingerprint.fk ingest/frequency-ingest-operators-refolding.fk
;
; Verdict 262143 (2^18 - 1) when all distinctions hold.
; witnessed: 2026-08-30 -> 262143 on fkwu, Go, Rust, and TypeScript

(do
    (defn fiorb-score (condition bit) (if condition bit 0))
    (defn frequency-ingest-operators-refolding-band ()
        (do
            (let c0  (fiorb-score (eq (ki-ingest (fior-u1)) 2) 1))
            (let c1  (fiorb-score (eq (ki-ingest (fior-u2)) 2) 2))
            (let c2  (fiorb-score (eq (ki-ingest (fior-u3)) 2) 4))
            (let c3  (fiorb-score (eq (ki-ingest (fior-u4)) 2) 8))
            (let c4  (fiorb-score (eq (ki-ingest (fior-u5)) 2) 16))
            (let c5  (fiorb-score (eq (ki-ingest (fior-u6)) 2) 32))
            (let c6  (fiorb-score (eq (ki-ingest (fior-u7)) 1) 64))
            (let c7  (fiorb-score (eq (ki-ingest (fior-u8)) 1) 128))
            (let c8  (fiorb-score (eq (ki-ingest (fior-u9)) 1) 256))
            (let c9  (fiorb-score (eq (ki-ingest (fior-u10)) 0) 512))
            (let c10 (fiorb-score (eq (ki-ingest (fior-u11)) 0) 1024))
            (let c11 (fiorb-score (eq (ki-ingest (fior-u12)) 0) 2048))
            (let c12 (fiorb-score (eq (ki-ingest (fior-u13)) 0) 4096))
            (let c13 (fiorb-score (eq (ki-ingest (fior-u14)) 0) 8192))
            (let c14 (fiorb-score (eq (fior-field-code) 60305) 16384))
            ; Fear blocks ice, not sight: every liquid unit remains visible.
            (let c15 (fiorb-score
                (and (eq (ki-witnessable? (fior-u7)) 1)
                (and (eq (ki-witnessable? (fior-u8)) 1)
                     (eq (ki-witnessable? (fior-u9)) 1))) 32768))
            ; The grounded voice layers are already an executable organ.
            (let fp (af-fingerprint
                (list 1 92) (list 1 7) (list 1 5) (list 1 3)))
            (let c16 (fiorb-score (eq (af-mask fp) 15) 65536))
            ; The source's own attribution uncertainty remains attached.
            (let c17 (fiorb-score
                (str_eq (fior-provenance-status) "self-reported-uncertain")
                131072))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5
            (add c6 (add c7 (add c8 (add c9 (add c10 (add c11
            (add c12 (add c13 (add c14 (add c15 (add c16 c17))))))))))))))))))
        )
    (frequency-ingest-operators-refolding-band))
