; frontier-ingest-memory-caching-band.fk — the Memory Caching ingest sorts
; every grounded finding correctly through the depth×fear teaching, and the
; collapse identity it froze holds as arithmetic, not only as prose.
;
; preludes: form-stdlib/core.fk ingest/knowledge-ingest.fk ingest/frontier-ingest-memory-caching.fk
;
; run: ./fkwu --src ingest/tests/frontier-ingest-memory-caching-band.fk   ; -> 4095
;      (resolver-driven; the preludes line above is the live load directive —
;       never cat the units by hand)
;
; Verdict 4095 when the ingest is honest. Bit weights are powers of two, not
; decimal digits, so a wrong bit lands on a distinct number the eye can read
; (the verdict-fold ceiling taught this once already).

(do
    (defn fimcb-score (ok bit) (if ok bit 0))
    (defn frontier-ingest-memory-caching-band ()
        (do
    ; a design is real only where its parts stay distinguishable — FREEZES
    (let c0 (fimcb-score (eq (ki-ingest (fimc-u1)) 2) 1))
    ; memory that grows by checkpointing a running state — FREEZES
    (let c1 (fimcb-score (eq (ki-ingest (fimc-u2)) 2) 2))
    ; attention as the limit case of one dial — FREEZES
    (let c2 (fimcb-score (eq (ki-ingest (fimc-u3)) 2) 4))
    ; selective retrieval makes a growing memory affordable — FREEZES
    (let c3 (fimcb-score (eq (ki-ingest (fimc-u4)) 2) 8))
    ; modest self-reported deltas over the lineage's own bases — WITNESSED
    (let c4 (fimcb-score (eq (ki-ingest (fimc-u5)) 1) 16))
    ; both halves held here, no bridge between them — WITNESSED
    (let c5 (fimcb-score (eq (ki-ingest (fimc-u6)) 1) 32))
    ; the free-lunch complexity reading COMPOSTS
    (let c6 (fimcb-score (eq (ki-ingest (fimc-u7)) 0) 64))
    ; "the gap is closed" COMPOSTS too
    (let c7 (fimcb-score (eq (ki-ingest (fimc-u8)) 0) 128))
    ; the honest tally: 4 frozen, 2 witnessed, 2 composted
    (let c8 (fimcb-score (eq (fimc-field-code) 40202) 256))
    ; the uncomfortable mirror unit is still SEEN — fear blocks ice,
    ; not sight
    (let c9 (fimcb-score (eq (ki-witnessable? (fimc-u6)) 1) 512))
    ; the collapse happens: a linear memory's residual cache pre-sums into
    ; the fixed matrix's own answer (their equation 13, on real integers)
    (let c10 (fimcb-score (eq (fimc-collapse?) 1) 1024))
    ; and per-token weights do not pre-sum — GRM stays a real design
    (let c11 (fimcb-score (eq (fimc-grm-differs?) 1) 2048))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
        (add c8 (add c9 (add c10 c11)))))))))))
    )
    )
    (frontier-ingest-memory-caching-band))
