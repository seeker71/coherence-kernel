; frontier-ingest-omlx-band.fk — the oMLX ingest sorts every grounded finding
; correctly through the depth×fear law.
;
; preludes: form-stdlib/core.fk form-stdlib/knowledge-ingest.fk ingest/frontier-ingest-omlx.fk
;
; Verdict 127 when the ingest is honest.

(do
    (defn fomb-score (ok bit) (if ok bit 0))
    (defn frontier-ingest-omlx-band ()
        (do
    ; the per-boundary cost law FREEZES into body — both lineages measured it
    (let c0 (fomb-score (eq (ki-ingest (fom-u1)) 2) 1))
    ; verified speculation FREEZES: it changes when a forward runs, never what it computes
    (let c1 (fomb-score (eq (ki-ingest (fom-u2)) 2) 2))
    ; the silent-fallback law FREEZES: a degrading lane must be made to speak
    (let c2 (fomb-score (eq (ki-ingest (fom-u3)) 2) 4))
    ; the unread MTP drafter is WITNESSED, never frozen — a mapped file is not a run
    (let c3 (fomb-score (eq (ki-ingest (fom-u4)) 1) 8))
    ; the missing cross-run prefix cache and the untested residence mechanism are
    ; WITNESSED, never frozen (deep, and each carries its own contraction)
    (let c4 (fomb-score (and (eq (ki-ingest (fom-u5)) 1) (eq (ki-ingest (fom-u6)) 1)) 16))
    ; the refuted compile tax and the approximate ANE lane COMPOST, never enter
    (let c5 (fomb-score (and (eq (ki-ingest (fom-u7)) 0) (eq (ki-ingest (fom-u8)) 0)) 32))
    ; the honest tally: 3 frozen, 3 witnessed, 2 composted
    (let c6 (fomb-score (eq (fom-field-code) 30302) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    )
    (frontier-ingest-omlx-band))
