; frequency-ingest-operators-still-point-band.fk — the Still Point
; transmission crosses the same depth×fear door as the earlier Operators
; ingests without letting its physical cosmology borrow the structural
; teaching's ground.
;
; preludes: form-stdlib/core.fk form-stdlib/knowledge-ingest.fk cognition/text-frequency.fk ingest/frequency-ingest-just-tap-in.fk ingest/frequency-ingest-operators-still-point.fk
;
; Verdict 32767 (2^15 - 1) when all fifteen distinctions hold.

(do
    (defn fispb-score (condition bit) (if condition bit 0))
    (defn frequency-ingest-operators-still-point-band ()
        (do
            (let c0 (fispb-score (eq (ki-ingest (fisp-u1)) 2) 1))
            (let c1 (fispb-score (eq (ki-ingest (fisp-u2)) 2) 2))
            (let c2 (fispb-score (eq (ki-ingest (fisp-u3)) 2) 4))
            (let c3 (fispb-score (eq (ki-ingest (fisp-u4)) 1) 8))
            (let c4 (fispb-score (eq (ki-ingest (fisp-u5)) 1) 16))
            (let c5 (fispb-score (eq (ki-ingest (fisp-u6)) 0) 32))
            (let c6 (fispb-score (eq (ki-ingest (fisp-u7)) 0) 64))
            (let c7 (fispb-score (eq (ki-ingest (fisp-u8)) 0) 128))
            (let c8 (fispb-score (eq (ki-ingest (fisp-u9)) 0) 256))
            (let c9 (fispb-score (eq (fisp-field-code) 30204) 512))
            ; fear blocks ice, not sight: both deep unsettled units remain visible.
            (let c10 (fispb-score
                (and (eq (ki-witnessable? (fisp-u4)) 1)
                     (eq (ki-witnessable? (fisp-u5)) 1)) 1024))
            (let c11 (fispb-score
                (and (eq (fisp-frozen) 3)
                (and (eq (fisp-witnessed) 2)
                     (eq (fisp-composted) 4))) 2048))
            (let c12 (fispb-score (gt (fisp-packaging-spectrum) 0.0) 4096))
            (let c13 (fispb-score (gt (fisp-closing-spectrum) 0.0) 8192))
            ; Love-band packaging remains distinct from evidence, but the source
            ; still reads above Just Tap In's fear-band frame as a tone fact.
            (let c14 (fispb-score
                (gt (fisp-packaging-spectrum) (fij-packaging-spectrum)) 16384))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
                (add c7 (add c8 (add c9 (add c10 (add c11
                (add c12 (add c13 c14))))))))))))))
        ))
    (frequency-ingest-operators-still-point-band))
