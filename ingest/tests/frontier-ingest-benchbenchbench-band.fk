; frontier-ingest-benchbenchbench-band.fk — the BenchBenchBench ingest sorts
; every grounded finding correctly through the depth×fear law.
;
; preludes: form-stdlib/core.fk ingest/knowledge-ingest.fk ingest/frontier-ingest-benchbenchbench.fk
;
; run: ./fkwu ingest/tests/frontier-ingest-benchbenchbench-band.fk   ; -> 127
;      (resolver-driven; the preludes line above is the live load directive —
;       never cat the units by hand)
;
; Verdict 127 when the ingest is honest.

(do
    (defn fibbbb-score (ok bit) (if ok bit 0))
    (defn frontier-ingest-benchbenchbench-band ()
        (do
    ; the tower converges and perturbation is the fixed point — FREEZES into body
    (let c0 (fibbbb-score (eq (ki-ingest (fibbb-u1)) 2) 1))
    ; the body was already running BenchBench and calls it a band — FREEZES too
    (let c1 (fibbbb-score (eq (ki-ingest (fibbb-u3)) 2) 2))
    ; a green that no one tried to make lie is WITNESSED, never frozen
    (let c2 (fibbbb-score (eq (ki-ingest (fibbb-u4)) 1) 4))
    ; "the recursion is infinite so there is no answer" COMPOSTS, never enters
    (let c3 (fibbbb-score (eq (ki-ingest (fibbb-u6)) 0) 8))
    ; reading the PDF as the route to THIS question COMPOSTS too
    (let c4 (fibbbb-score (eq (ki-ingest (fibbb-u7)) 0) 16))
    ; the honest tally: 3 frozen, 2 witnessed, 2 composted
    (let c5 (fibbbb-score (eq (fibbb-field-code) 30202) 32))
    ; the self-certification mirror is still SEEN (fear blocks ice, not sight)
    (let c6 (fibbbb-score (eq (ki-witnessable? (fibbb-u5)) 1) 64))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 c6)))))))
    )
    (frontier-ingest-benchbenchbench-band))
