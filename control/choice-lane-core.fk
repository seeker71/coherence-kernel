// Choice keeps original inputs and accumulated findings. Checkpoints retain
// immutable memory values; their restoration does not reverse host effects.
// Every offered function runs through the shared offer/acknowledgement boundary.
// preludes: form-stdlib/core.fk control/offer-ack-core.fk
section [form.bml] {
 class ChoiceLane {
  def oac-cut(alts,args) = nil?(alts) ? nothing : oac-offer(head(alts),args);
  def oac-cut-receipt(ack,pruned) = list(ack,pruned);
  def oac-cut-receipt-ack(r) = head(r);
  def oac-cut-receipt-pruned(r) = nth(r,1);
  def oac-cut-with-receipt(alts,args) = nil?(alts) ? oac-cut-receipt(nothing,0) : oac-cut-receipt(oac-offer(head(alts),args),len(alts) - 1);
  def oac-lanes(alts,args) = alts |> map(alternative => oac-offer(alternative,args));
  def oac-lanes-winners(memory) = memory |> filter(ack => !oac-nothing?(ack));
  def oac-lanes-winner-count(memory) = len(oac-lanes-winners(memory));
  def oac-store(memory) = memory;
  def oac-restore(checkpoint) = checkpoint;
  def oac-undo(ack,checkpoint,memory) = oac-nothing?(ack) ? checkpoint : memory;
  def oac-timeout-walk(alts,args,budget: Number) = budget == 0 ? list(nothing,0,len(alts)) :
   nil?(alts) ? list(nothing,budget,0) : {
    let ack = oac-offer(head(alts),args);
    oac-nothing?(ack) ? oac-timeout-walk(tail(alts),args,budget - 1) : list(ack,budget - 1,len(tail(alts)));
   };
  def oac-timeout-ack(w) = head(w);
  def oac-timeout-budget-left(w) = nth(w,1);
  def oac-timeout-alts-left(w) = nth(w,2);
  def oac-timed-out?(w) = oac-nothing?(oac-timeout-ack(w)) && oac-timeout-alts-left(w) > 0;
  def oac-memory-add(memory,finding) = append(memory,list(finding));
  def oac-backtrack-walk(alts,args,memory) = nil?(alts) ? list(nothing,memory) : {
   let ack = oac-offer(head(alts),list(args,memory));
   oac-nothing?(ack) ? oac-backtrack-walk(tail(alts),args,memory) :
    oac-node?(ack) ? oac-backtrack-walk(tail(alts),args,oac-memory-add(memory,oac-payload(ack))) : list(ack,memory);
  };
  def oac-backtrack(alts,args) = head(oac-backtrack-walk(alts,args,empty));
  def oac-backtrack-ack(w) = head(w);
  def oac-backtrack-memory(w) = nth(w,1);
  def oac-option-args(offered) = head(offered);
  def oac-option-memory(offered) = nth(offered,1);
 }
 0;
}
