// Choice keeps original inputs and accumulated findings. Checkpoints retain
// immutable memory values; their restoration does not reverse host effects.
// Every offered function runs through the shared offer/acknowledgement boundary.
import form-stdlib/core.fk;
import control/offer-ack-core.fk;
section [form.bml] {
 class ChoiceLane {
  def oac-cut(alts,args) = nil?(alts) ? nothing : oac-offer(alts[0],args);
  def oac-cut-receipt(ack,pruned) = [ack,pruned];
  def oac-cut-receipt-ack(r) = r[0];
  def oac-cut-receipt-pruned(r) = r[1];
  def oac-cut-with-receipt(alts,args) = nil?(alts) ? oac-cut-receipt(nothing,0) : oac-cut-receipt(oac-offer(alts[0],args),len(alts) - 1);
  def oac-lanes(alts,args) = alts |> map(alternative => oac-offer(alternative,args));
  def oac-lanes-winners(memory) = memory |> filter(ack => !oac-nothing?(ack));
  def oac-lanes-winner-count(memory) = len(oac-lanes-winners(memory));
  def oac-store(memory) = memory;
  def oac-restore(checkpoint) = checkpoint;
  def oac-undo(ack,checkpoint,memory) = oac-nothing?(ack) ? checkpoint : memory;
  def oac-timeout-walk(alts,args,budget: Number) = budget == 0 ? [nothing,0,len(alts)] :
   nil?(alts) ? [nothing,budget,0] : {
    let ack = oac-offer(alts[0],args);
    oac-nothing?(ack) ? oac-timeout-walk(alts[1:],args,budget - 1) : [ack,budget - 1,len(alts[1:])];
   };
  def oac-timeout-ack(w) = w[0];
  def oac-timeout-budget-left(w) = w[1];
  def oac-timeout-alts-left(w) = w[2];
  def oac-timed-out?(w) = oac-nothing?(oac-timeout-ack(w)) && oac-timeout-alts-left(w) > 0;
  def oac-memory-add(memory,finding) = append(memory,[finding]);
  def oac-backtrack-walk(alts,args,memory) = nil?(alts) ? [nothing,memory] : {
   let ack = oac-offer(alts[0],[args,memory]);
   oac-nothing?(ack) ? oac-backtrack-walk(alts[1:],args,memory) :
    oac-node?(ack) ? oac-backtrack-walk(alts[1:],args,oac-memory-add(memory,oac-payload(ack))) : [ack,memory];
  };
  def oac-backtrack(alts,args) = oac-backtrack-walk(alts,args,empty)[0];
  def oac-backtrack-ack(w) = w[0];
  def oac-backtrack-memory(w) = w[1];
  def oac-option-args(offered) = offered[0];
  def oac-option-memory(offered) = offered[1];
 }
 0;
}
