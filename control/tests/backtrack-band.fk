; preludes: control/offer-ack-core.fk, control/choice-lane-core.fk
;
; backtrack-band — choice that keeps what each declined option learned
; (control/choice-lane-core.fk, oac-backtrack). An issue met on the way is a
; backtrack point: the next option receives the original args (in line with
; the first choice) and the memory of what the options before it saw.
;
; Verdict 255 when every claim lands:
;   1     the second option lands after the first declines with what it saw:
;         the walk acks ONE with the second option's payload
;   2     the second option received the first option's finding in its memory
;         (it answers 40 + the length of its memory = 41)
;   4     every option receives the SAME original args (args 7 reach the third)
;   8     a silent option (nothing) adds nothing to the memory: memory after
;         (declines "a", silent, declines "b") reads ("a" "b")
;   16    every option declined → the walk acks nothing (fail)
;   32    ... and the memory still holds every finding, in order
;   64    ZERO is the boundary's answer and ends the walk (the option after it
;         is never offered: the memory stays empty)
;   128   no options → nothing, with an empty memory
(do
    (defn bt-bit (ok v) (if (eq ok 1) v 0))
    (defn bt-declines-a (offered) (oac-node "a"))
    (defn bt-declines-b (offered) (oac-node "b"))
    (defn bt-silent (offered) (oac-nothing))
    (defn bt-says-no (offered) (oac-zero))
    (defn bt-counts-memory (offered) (oac-one (add 40 (len (oac-option-memory offered)))))
    (defn bt-reads-args (offered) (oac-one (oac-option-args offered)))

    (let w1 (oac-backtrack-walk (list bt-declines-a bt-counts-memory) 7 (list)))
    (let b1 (if (eq (oac-one? (oac-backtrack-ack w1)) 1) 1 0))
    (let b2 (if (eq (oac-payload (oac-backtrack-ack w1)) 41) 1 0))
    (let w3 (oac-backtrack-walk (list bt-declines-a bt-silent bt-reads-args) 7 (list)))
    (let b3 (if (eq (oac-payload (oac-backtrack-ack w3)) 7) 1 0))
    (let w4 (oac-backtrack-walk (list bt-declines-a bt-silent bt-declines-b) 7 (list)))
    (let m4 (oac-backtrack-memory w4))
    (let b4 (if (and (eq (len m4) 2) (and (str_eq (nth m4 0) "a") (str_eq (nth m4 1) "b"))) 1 0))
    (let b5 (oac-nothing? (oac-backtrack-ack w4)))
    (let b6 (if (and (eq b4 1) (eq (oac-nothing? (oac-backtrack (list bt-declines-a bt-declines-b) 7)) 1)) 1 0))
    (let w7 (oac-backtrack-walk (list bt-says-no bt-declines-a) 7 (list)))
    (let b7 (if (and (eq (oac-zero? (oac-backtrack-ack w7)) 1) (eq (len (oac-backtrack-memory w7)) 0)) 1 0))
    (let w8 (oac-backtrack-walk (list) 7 (list)))
    (let b8 (if (and (eq (oac-nothing? (oac-backtrack-ack w8)) 1) (eq (len (oac-backtrack-memory w8)) 0)) 1 0))
    (add (bt-bit b1 1) (add (bt-bit b2 2) (add (bt-bit b3 4) (add (bt-bit b4 8)
        (add (bt-bit b5 16) (add (bt-bit b6 32) (add (bt-bit b7 64) (bt-bit b8 128)))))))))
