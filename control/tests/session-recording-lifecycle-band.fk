; tests/session-recording-lifecycle-band.fk — raw footage cannot be lost by
; default, and only an answered offer can release it.
;
; preludes: form-stdlib/core.fk control/offer-ack-core.fk control/session-recording-lifecycle.fk
;
; Verdict 65535 — sixteen readings at POWERS OF TWO (a decimal-digit fold past
; the 15th reading rounds on the TypeScript arm; 2^53 is the wall).
;
; 4095 -> 65535 on 2026-08-17, the same day, after Urs read the first draft
; and said: fear, fear, fear, and you did not see it. He was right. The cell's
; own unit through form/form-stdlib/knowledge-ingest.fk is (depth 5, fear 1), and
; ki-ingest answers 1 — WITNESSED, never frozen — while the first draft had
; been frozen into control/ as core tissue. The four claims 4096..32768 are
; the repair: the first draft could say "removable" and had no way at all to
; say "finished". Every one of the twelve original safety claims still holds
; unchanged, which is the teaching — fear and love built nearly the SAME
; mechanism here, and differed in what they left unsayable.
;
;   1     raw-only is NEVER removable — with no transcript, raw is the only
;           ground there is, and three holders still hold it
;   2     transcribed-but-unedited is NEVER removable: a transcript that has
;           not been edited is a claim, not yet a witness
;   4     edited but WITHOUT consent is never removable (axiom-4: the owner
;           decides; the cell may offer, never take)
;   8     edited + no pending reprocess + explicit consent → removable. The
;           gate opens, and only here
;   16    a pending reprocess holds the raw even when edited AND consented —
;           reprocessability is the whole reason raw was kept
;   32    SILENCE IS NOT CONSENT. An unanswered removal offer leaves the
;           footage exactly where it is. This is the claim the archive
;           actually rests on
;   64    an explicit NO is not consent either
;   128   only an explicit YES is consent — one arm of four
;   256   a counter-offer (node) is not consent: the conversation continues
;           and nothing is removed
;   512   while raw is held the transcript is reprocessable; after release it
;           is not, and the state says so BEFORE the offer is answered
;   1024  releasing mints a NEW recording and the old composition persists
;           (axiom-3), so release is a let-go, never a destruction
;   2048  across a fleet, a sweep nobody answered is NOT a sweep everybody
;           agreed to — oac-readable? refuses to read the empty census

(do
    ;; recordings across the lifecycle
    (let fresh    (srl-rec 1 0 0 0 1))   ; captured, nothing derived
    (let draft    (srl-rec 2 1 0 0 1))   ; transcript exists, unedited
    (let ready    (srl-rec 3 1 1 0 1))   ; transcript generated AND edited
    (let busy     (srl-rec 4 1 1 1 1))   ; edited, but a reprocess is pending

    ;; prompts: 1-arg recipes standing for how the owner answered
    (defn says-nothing (args) (oac-nothing))
    (defn says-no      (args) (oac-zero))
    (defn says-yes     (args) (oac-one (intern_trivial_int 1)))
    (defn says-later   (args) (oac-node (intern_trivial_int 7)))

    ;; (1) raw-only: no transcript, unedited, no consent → three holders
    (let c1 (if (and (eq (srl-removable? fresh 0) 0)
                     (eq (srl-holders fresh 0) 3)) 1 0))

    ;; (2) transcribed but unedited → still held
    (let c2 (if (eq (srl-removable? draft 1) 0) 2 0))

    ;; (3) edited, but consent withheld → still held
    (let c3 (if (eq (srl-removable? ready 0) 0) 4 0))

    ;; (4) edited + consented + nothing pending → the gate opens
    (let c4 (if (and (eq (srl-removable? ready 1) 1)
                     (eq (srl-holders ready 1) 0)) 8 0))

    ;; (5) a pending reprocess holds it even when edited and consented
    (let c5 (if (eq (srl-removable? busy 1) 0) 16 0))

    ;; (6) SILENCE IS NOT CONSENT — the offer goes unanswered, raw stays
    (let unanswered (srl-offer-removal ready says-nothing (list)))
    (let c6 (if (and (eq (srl-consent-from-ack (says-nothing (list))) 0)
                     (eq (oac-nothing? unanswered) 1)) 32 0))

    ;; (7) an explicit no is not consent
    (let refused (srl-offer-removal ready says-no (list)))
    (let c7 (if (and (eq (srl-consent-from-ack (says-no (list))) 0)
                     (eq (oac-nothing? refused) 1)) 64 0))

    ;; (8) only an explicit yes is consent, and it releases THIS recording
    (let agreed (srl-offer-removal ready says-yes (list)))
    (let c8 (if (and (eq (srl-consent-from-ack (says-yes (list))) 1)
                     (and (eq (oac-one? agreed) 1)
                          (eq (node_value (oac-payload agreed)) 3))) 128 0))

    ;; (9) a counter-offer is not consent — the conversation continues
    (let deferred (srl-offer-removal ready says-later (list)))
    (let c9 (if (and (eq (srl-consent-from-ack (says-later (list))) 0)
                     (eq (oac-nothing? deferred) 1)) 256 0))

    ;; (10) the cost is readable BEFORE the offer is answered: held raw is
    ;; reprocessable, released raw is not, and the transcript becomes sole ground
    (let released (srl-release ready))
    (let c10 (if (and (eq (srl-reprocessable? ready) 1)
                      (and (eq (srl-reprocessable? released) 0)
                           (and (eq (srl-sole-ground-is-transcript? released) 1)
                                (eq (srl-state released) (srl-raw-released)))))
                 512 0))

    ;; (11) release mints a NEW recording; the old composition still stands
    ;; unchanged beside it (axiom-3) — a let-go, never a destruction
    (let c11 (if (and (eq (srl-raw? ready) 1)
                      (and (eq (srl-raw? released) 0)
                           (eq (srl-id released) (srl-id ready)))) 1024 0))

    ;; (12) across a fleet: nobody answered is NOT everybody agreed
    (let silent-sweep (srl-sweep-readable? (list says-nothing says-nothing) (list)))
    (let answered-sweep (srl-sweep-readable? (list says-no says-yes) (list)))
    (let c12 (if (and (eq silent-sweep 0) (eq answered-sweep 1)) 2048 0))


    ;; ── COMPLETION: what the fear had made unsayable ────────────────
    ;; The first draft could say "removable" and could not say "finished".
    ;; These four claims are the repair, and they exist because Urs read
    ;; the first draft and named the fear in it.

    ;; (13) completion is a fact about the WORK, not about permission:
    ;; a recording can be complete while consent has never been asked.
    (let c13 (if (and (eq (srl-complete? ready) 1)
                      (eq (srl-removable? ready 0) 0)) 4096 0))

    ;; (14) and it is not merely "not yet removable": the unfinished ones
    ;; are honestly incomplete — no transcript, or unedited, or mid-reprocess.
    (let c14 (if (and (eq (srl-complete? fresh) 0)
                      (and (eq (srl-complete? draft) 0)
                           (eq (srl-complete? busy) 0))) 8192 0))

    ;; (15) axiom-3 in its own words: raw let go from a COMPLETE recording
    ;; returned to potential — the transcript is the fruit it became. This is
    ;; health, not a hole where footage used to be.
    (let c15 (if (and (eq (srl-returned-to-potential? released) 1)
                      (eq (srl-lost? released) 0)) 16384 0))

    ;; (16) and the honest opposite stays sharp: raw let go while the work
    ;; was UNFINISHED is loss, not composting. Same empty disk, opposite act —
    ;; a distinction the first draft could not make at all.
    (let orphaned (srl-release fresh))
    (let c16 (if (and (eq (srl-lost? orphaned) 1)
                      (eq (srl-returned-to-potential? orphaned) 0)) 32768 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9
        (add c10 (add c11 (add c12 (add c13 (add c14 (add c15 c16))))))))))))))))
