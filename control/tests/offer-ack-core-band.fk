; preludes: form/form-stdlib/core.fk control/offer-ack-core.fk
;
; core.fk comes FIRST and is load-bearing, not decoration: the core's nothing
; arm is the reducer's canonical sentinel, reached through `nothing` / `nothing?`.
; fkwu carries those as direct native arms, so this band ran green here without
; core.fk — while every non-fkwu kernel left them unbound and the band was
; silently single-arm. core.fk:18-22 carries the form-native fallback the
; sibling kernels use (`(head (list))` + `value_eq`), so declaring it makes the
; band portable: witnessed 2026-08-17 agreeing across Go/Rust/TS at 2097151.
; It also arms claim 32768 for real — core.fk is where the global `cell`
; constructor lives, which is the exact condition oac-offer's `recipe` rename
; guards against, and the claim only tests that seam when core.fk is loaded.
;
; offer-ack-core-band — the five control primitives (fail, stop, choice,
; exceptions, async) each WITNESSED as an instance of the ONE offer/ack
; core. Every claim routes through oac-kind (the single discriminator) and
; oac-offer (the single invocation); none has its own dispatch chain.
;
; The strange-minimal edge that pins the whole shape: oac-fail and the
; failure-branch of oac-try are the SAME nothing-arm — failure being the
; silence-ack (axiom-1, first-class) is what lets try "catch" with no throw.
;
; The offered cells are 1-arg recipes (axiom-5: a cell + its args-list);
; oac-offer applies them through the kernel's invocation (tag-44 indirect
; call, four-way-proven). The ack each returns is one of {nothing,0,1,node}.
;
; Verdict 32767 since 2026-08-17 — the HOLD arm landed (claims 1024..16384),
; the THIRD reading of the nothing-ground, taken from The Impersonal Life
; (1914): read a sentence at a time, and do not pass to the next until
; something within responds. Silence here is neither fail nor stop; it is
; NOT-YET, and the sequence does not advance over it.
;   1024  HOLD lands what one offer could not — same recipe, a receiver
;           that kept ripening, finally acked
;   2048  the reading RATE is observable: it cost exactly 3 re-presentations
;   4096  and it refuses to lie — spent patience acks NOTHING, no
;           manufactured response and no skip-ahead
;   8192  the reading chain advances only on real acks, holding where it must
;  16384  THE SHIFT on one input: over the same three recipes, run-chain
;           HALTS and keeps its 5, read-chain HOLDS and acks nothing. This
;           claim fails the moment the two motions collapse into one.
;
; Verdict 1023 covered the original ten claims:
;   1    oac-fail acks the NOTHING kind (failure IS first-class silence)
;   2    oac-choice over (nothing, nothing, →1) picks the ONE ack = 5
;   4    oac-choice over (nothing, nothing) → nothing (all-decline = fail)
;   8    oac-try on a FAILING offer recovers via the handler → recovery value
;   16   oac-try on a SUCCEEDING offer passes the value through untouched
;   32   oac-async + oac-await resolves a pending offer to its ack
;   64   a fresh future peeks NOTHING before await (timeout==nothing)
;   128  oac-stop halts the offer chain: the driver makes no further offer
;   256  oac-run-chain returns the last ack BEFORE the stop (boundary halt)
;   512  the discriminator is total: each of the four arms reads its own tag
(do
    ;; --- offered cells: 1-arg recipes, args is the single args-list ----
    ;; a cell that always declines (silence): the fail/stop building block.
    (defn cell-silent (args) (oac-nothing))
    ;; a cell that acks ONE carrying the int 5 (ignores args).
    (defn cell-five (args) (oac-one (intern_trivial_int 5)))
    ;; a cell that acks ONE carrying the int 9 — the try recovery value.
    (defn cell-nine (args) (oac-one (intern_trivial_int 9)))
    ;; a cell that acks ZERO (received-no).
    (defn cell-zero-ack (args) (oac-zero))
    ;; a cell that acks a NODE counter-offer carrying a marker cell.
    (defn cell-counter (args) (oac-node (intern_trivial_int 7)))

    ;; the payload-int an ONE ack carries, read through the core accessor.
    (defn ack-int (ack) (node_value (oac-payload ack)))

    ;; (1) FAIL — failure is the nothing-kind.
    (let c1 (if (eq (oac-kind (oac-fail)) (oac-tag-nothing)) 1 0))

    ;; (2) CHOICE picks the first non-nothing — (silent, silent, five) → 5.
    (let pick (oac-choice (list cell-silent cell-silent cell-five) (list)))
    (let c2 (if (and (eq (oac-one? pick) 1) (eq (ack-int pick) 5)) 2 0))

    ;; (3) CHOICE all-decline → nothing (= fail).
    (let all-none (oac-choice (list cell-silent cell-silent) (list)))
    (let c3 (if (eq (oac-nothing? all-none) 1) 4 0))

    ;; (4) TRY on a failing offer recovers via the handler → 9.
    (let recovered (oac-try cell-silent (list) cell-nine))
    (let c4 (if (and (eq (oac-one? recovered) 1) (eq (ack-int recovered) 9)) 8 0))

    ;; (5) TRY on a succeeding offer passes the value through → 5 (handler unused).
    (let passed (oac-try cell-five (list) cell-nine))
    (let c5 (if (and (eq (oac-one? passed) 1) (eq (ack-int passed) 5)) 16 0))

    ;; (6) ASYNC + AWAIT resolves a pending offer to its ack → 5.
    (let fut (oac-async cell-five (list)))
    (let resolved (oac-await fut))
    (let c6 (if (and (eq (oac-one? resolved) 1) (eq (ack-int resolved) 5)) 32 0))

    ;; (7) a fresh future peeks NOTHING before await (timeout==nothing).
    (let c7 (if (eq (oac-nothing? (oac-peek fut)) 1) 64 0))

    ;; (8) STOP halts the chain: oac-stop acks nothing, oac-stopped? sees it.
    (let c8 (if (eq (oac-stopped? (oac-stop)) 1) 128 0))

    ;; (9) the chain runs offers over the SAME args until one STOPS; here the
    ;; middle cell stops (acks nothing), so the last ack BEFORE it (5) is kept.
    (let chained (oac-run-chain (list cell-five cell-silent cell-nine) (list) (oac-nothing)))
    (let c9 (if (and (eq (oac-one? chained) 1) (eq (ack-int chained) 5)) 256 0))

    ;; (10) the discriminator is TOTAL across all four arms — each arm reads
    ;; its own tag through the ONE oac-kind, proving the core's completeness.
    (let zero-ack (cell-zero-ack (list)))
    (let node-ack (cell-counter (list)))
    (let c10 (if (and (eq (oac-kind (oac-nothing)) (oac-tag-nothing))
                      (and (eq (oac-kind zero-ack) (oac-tag-zero))
                           (and (eq (oac-kind (cell-five (list))) (oac-tag-one))
                                (eq (oac-kind node-ack) (oac-tag-node)))))
                 512 0))

    
    ;; ── HOLD: the third reading of the nothing-ground ───────────────
    ;; the receiver ripens; the offered recipe never changes. `ripen` grows
    ;; the args-list by one — the reader coming back with more of itself.
    (defn ripen-real (args) (cons (intern_trivial_int 1) args))
    ;; THE DECOY — a global with the exact name of oac-hold's call-position
    ;; parameter, and it never ripens anything. If a NAME could capture the
    ;; offer, claim 131072 below would starve and ack nothing.
    (defn ripen (args) args)
    ;; and a global with the exact name of oac-offer's parameter, acking 99.
    (defn recipe (args) (oac-one (intern_trivial_int 99)))
    ;; a recipe that stays silent until the receiver has ripened three times,
    ;; then acks ONE carrying 5. The text is constant; readiness is not.
    (defn cell-ready-at-3 (args)
        (if (ge (len args) 3) (oac-one (intern_trivial_int 5)) (oac-nothing)))

    ;; (11) HOLD lands what a single offer could not.
    (let held (oac-hold cell-ready-at-3 (list) ripen-real 8))
    (let c11 (if (and (eq (oac-one? held) 1) (eq (ack-int held) 5)) 1024 0))

    ;; (12) the reading RATE is observable: exactly 3 re-presentations.
    (let c12 (if (eq (oac-hold-cost cell-ready-at-3 (list) ripen-real 8) 3) 2048 0))

    ;; (13) and it REFUSES to lie: spent patience acks NOTHING.
    (let unanswered (oac-hold cell-silent (list) ripen-real 4))
    (let c13 (if (eq (oac-nothing? unanswered) 1) 4096 0))

    ;; (14) the reading chain advances only on real acks, holding where it must.
    (let read-ok (oac-read-chain (list cell-five cell-ready-at-3) (list) ripen-real 8 (oac-nothing)))
    (let c14 (if (and (eq (oac-one? read-ok) 1) (eq (ack-int read-ok) 5)) 8192 0))

    ;; (15) THE SHIFT on ONE input: run-chain HALTS and keeps its 5,
    ;; read-chain HOLDS and acks nothing. Fails if the two ever collapse.
    (let read-held (oac-read-chain (list cell-five cell-silent cell-nine) (list) ripen-real 4 (oac-nothing)))
    (let c15 (if (and (eq (oac-nothing? read-held) 1)
                      (and (eq (oac-one? chained) 1) (eq (ack-int chained) 5)))
                 16384 0))


    ;; ── KENOSIS: the offered thing is met through what it IS ────────
    ;; The Impersonal Life is signed only "Anonymous", and the withholding is
    ;; load-bearing: its chapters XIII-XIV refuse outside authority, so a
    ;; NAMED author would become the very authority the text refuses. At core
    ;; altitude that is axiom-3 — identity is the present composition, so a
    ;; name is a free query key and can carry no authority of its own.
    ;;
    ;; The core has a live seam here: in call position the runtime resolves a
    ;; NAME against the global defn table BEFORE the local frame, so a global
    ;; sharing a parameter's name could capture the offer. These three claims
    ;; are the SENTINEL — the convention made checkable. Probed 2026-08-17:
    ;; the historical shadowing defect did not reproduce on this kernel, so
    ;; these guard a healed seam rather than patch an open one.

    ;; (16) a global named exactly like oac-offer's parameter does NOT
    ;; capture the offer: the offered recipe's own ack (5) comes back,
    ;; never the decoy's 99. The thing wins over the name.
    (let unhijacked (oac-offer cell-five (list)))
    (let c16 (if (and (eq (oac-one? unhijacked) 1) (eq (ack-int unhijacked) 5)) 32768 0))

    ;; (17) two recipes bearing DIFFERENT names and identical behaviour are
    ;; indistinguishable to the core — same arm, same payload. Names are
    ;; 0..many (axiom-3); authority cannot attach to one.
    (defn cell-five-anonymous (args) (oac-one (intern_trivial_int 5)))
    (let named (oac-offer cell-five (list)))
    (let unnamed (oac-offer cell-five-anonymous (list)))
    (let c17 (if (and (eq (oac-kind named) (oac-kind unnamed))
                      (eq (ack-int named) (ack-int unnamed)))
                 65536 0))

    ;; (18) and HOLD carries the same protection: oac-hold ripens with the
    ;; function it was PASSED, not the global of the same name. The decoy
    ;; never ripens, so a capture here would starve to nothing; the real
    ;; ripener lands the ack at 5.
    (let held-unhijacked (oac-hold cell-ready-at-3 (list) ripen-real 8))
    (let c18 (if (and (eq (oac-one? held-unhijacked) 1) (eq (ack-int held-unhijacked) 5)) 131072 0))


    ;; ── CENSUS: absence is never evidence ───────────────────────────
    ;; The one unit this body witnessed and refused to freeze says your
    ;; circumstance was authored by your thinking. Axiom-5 refutes it: an
    ;; offer can meet silence, so an unanswered life says nothing about what
    ;; was put out. These claims make that refusal OBSERVABLE in the core.
    (defn cell-zero-b (args) (oac-zero))

    ;; (19) all-silent: nothing answered. The census says 0 answered, 2
    ;; silent — and oac-readable? refuses to let that be read as a verdict.
    (let none-answered (oac-census (list cell-silent cell-silent) (list)))
    (let c19 (if (and (eq (oac-answered none-answered) 0)
                      (and (eq (oac-silent none-answered) 2)
                           (eq (oac-readable? none-answered) 0)))
                 262144 0))

    ;; (20) all-zero: everyone actively declined. Two REAL acks arrived, so
    ;; this one IS readable — a "no" is information, and it is kept.
    (let all-declined (oac-census (list cell-zero-ack cell-zero-b) (list)))
    (let c20 (if (and (eq (oac-answered all-declined) 2)
                      (and (eq (oac-silent all-declined) 0)
                           (eq (oac-readable? all-declined) 1)))
                 524288 0))

    ;; (21) THE REFUSAL ITSELF. oac-choice collapses both cases to the same
    ;; "no positive result" — and that collapse is exactly the guarantee
    ;; error a machine would commit. The census keeps them apart: same
    ;; disappointing surface, opposite epistemic status. This claim fails
    ;; the moment absence and refusal become one reading.
    (let silent-choice (oac-choice (list cell-silent cell-silent) (list)))
    (let declined-choice (oac-choice (list cell-zero-ack cell-zero-b) (list)))
    (let c21 (if (and (eq (oac-nothing? silent-choice) 1)
                      (and (eq (oac-zero? declined-choice) 1)
                           (eq (eq (oac-readable? none-answered) (oac-readable? all-declined)) 0)))
                 1048576 0))

    (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9
        (add c10 (add c11 (add c12 (add c13 (add c14 (add c15
        (add c16 (add c17 (add c18 (add c19 (add c20 c21)))))))))))))))))))))
