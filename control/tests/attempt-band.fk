; preludes: control/offer-ack-core.fk
;
; attempt-band — a stop is a backtrack point. (attempt x) walks x with a recover
; point standing; a stop inside x (a length of nothing, a branch on nothing,
; arithmetic over a non-number, a recursion past the walker's wall) unwinds to
; the attempt, is voiced as one organ-health line on stderr, and the attempt
; answers nothing. Every oac offer stands inside one, so a choice whose option
; stops takes its next option in line.
;
; Verdict 2047 when every claim lands:
;   1     a value passes through untouched
;   2     the length of nothing stops, and the attempt answers nothing
;   4     str_len of a non-string stops the same way
;   8     a branch on nothing stops the same way
;   16    attempts nest: the inner answers nothing, the outer meets arithmetic
;         over that nothing and answers nothing itself
;   32    a stop a thousand calls down unwinds every one of them to the attempt
;         (the walker's depth wall is such a stop on every arm; reaching it
;         costs seconds to minutes, so this band does not)
;   64    the frame around an attempt stands after a stop: its let reads 5
;   128   the same frame reads the value when nothing stopped
;   256   oac-choice passes over an option that stops and acks the next one's 7
;   512   an option that stops acks nothing to oac-try, whose handler answers 9
;   1024  a cons onto nothing stops the same way; a cons onto the empty list
;         is a one-item list

(do
    (defn at-bit (ok v) (if ok v 0))
    (defn at-deep (n) (if (eq n 0) (len (nothing)) (add 1 (at-deep (sub n 1)))))
    (defn at-framed (x) (do (let a 5) (let b (attempt (len x))) (if (nothing? b) (add a 100) b)))
    (defn at-stops (args) (oac-one (intern_trivial_int (len (nothing)))))
    (defn at-seven (args) (oac-one (intern_trivial_int 7)))
    (defn at-nine (args) (oac-one (intern_trivial_int 9)))
    (defn at-int (ack) (node_value (oac-payload ack)))

    (add (at-bit (eq (attempt (add 1 2)) 3) 1)
    (add (at-bit (nothing? (attempt (len (nothing)))) 2)
    (add (at-bit (nothing? (attempt (str_len 5))) 4)
    (add (at-bit (nothing? (attempt (if (nothing) 1 2))) 8)
    (add (at-bit (nothing? (attempt (add 1 (attempt (len (nothing)))))) 16)
    (add (at-bit (nothing? (attempt (at-deep 1000))) 32)
    (add (at-bit (eq (at-framed (nothing)) 105) 64)
    (add (at-bit (eq (at-framed (list 1 2 3)) 3) 128)
    (add (at-bit (eq (at-int (oac-choice (list at-stops at-seven) 0)) 7) 256)
    (add (at-bit (eq (at-int (oac-try at-stops 0 at-nine)) 9) 512)
         (at-bit (and (nothing? (attempt (cons 1 (nothing))))
                      (eq (len (cons 1 (list))) 1)) 1024))))))))))))
