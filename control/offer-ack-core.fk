// One offer boundary: absence, rejection, acceptance, or a counter-offer.
// A pending value holds a recipe and its arguments; scheduling belongs to its carrier.
// preludes: form-stdlib/core.fk
section [form.bml] {
 def OAC-ZERO() = bp("OAC-ZERO");
 def OAC-ONE() = bp("OAC-ONE");
 def OAC-NODE() = bp("OAC-NODE");
 def oac-tag-nothing() = 0;
 def oac-tag-zero() = 1;
 def oac-tag-one() = 2;
 def oac-tag-node() = 3;
 def oac-nothing() = nothing;
 def oac-zero() = intern_node(OAC-ZERO(),list(intern_trivial_int(0)));
 def oac-one(payload) = intern_node(OAC-ONE(),list(payload));
 def oac-node(counter) = intern_node(OAC-NODE(),list(counter));
 def oac-payload(ack) = head(node_children(ack));
 def oac-same-bp?(node,arm-bp) = node_eq(node_category(node),arm-bp) ? 1 : 0;
 def oac-kind(ack) = nothing?(ack) ? oac-tag-nothing() :
  oac-same-bp?(ack,OAC-ZERO()) ? oac-tag-zero() :
  oac-same-bp?(ack,OAC-ONE()) ? oac-tag-one() : oac-tag-node();
 def oac-nothing?(ack) = oac-kind(ack) == oac-tag-nothing();
 def oac-zero?(ack) = oac-kind(ack) == oac-tag-zero();
 def oac-one?(ack) = oac-kind(ack) == oac-tag-one();
 def oac-node?(ack) = oac-kind(ack) == oac-tag-node();
 // The one attempt owns unwinding; fail and stop are values read by the caller.
 def oac-offer(recipe,args) = attempt(recipe(args));
 def oac-fail() = fail;
 def oac-failed?(ack) = oac-nothing?(ack);
 def oac-stop() = stop;
 def oac-stopped?(ack) = oac-nothing?(ack);
 def oac-run-chain(cells,args,last) = nil?(cells) ? last : {
  let ack = offer(head(cells),args);
  oac-stopped?(ack) ? last : oac-run-chain(tail(cells),args,ack);
 };
 def oac-choice(alts,args) = nil?(alts) ? fail : {
  let ack = offer(head(alts),args);
  oac-nothing?(ack) ? oac-choice(tail(alts),args) : ack;
 };
 def oac-try(offer-cell,args,handler-cell) = try offer-cell(args) catch offer(handler-cell,args);
 def oac-async(recipe,args) = list(recipe,args);
 def oac-future-cell(f) = head(f);
 def oac-future-args(f) = nth(f,1);
 def oac-peek(f) = nothing;
 def oac-await(f) = offer(oac-future-cell(f),oac-future-args(f));
 // Re-presentation changes the arguments. Patience is the caller's allowance.
 def oac-hold(recipe,args,ripen,patience: Number) = patience == 0 ? nothing : {
  let ack = offer(recipe,args);
  oac-nothing?(ack) ? oac-hold(recipe,ripen(args),ripen,patience - 1) : ack;
 };
 def oac-hold-cost-loop(recipe,args,ripen,patience: Number,spent) = patience == 0 ? spent : {
  let ack = offer(recipe,args);
  oac-nothing?(ack) ? oac-hold-cost-loop(recipe,ripen(args),ripen,patience - 1,spent + 1) : spent;
 };
 def oac-hold-cost(recipe,args,ripen,patience) = oac-hold-cost-loop(recipe,args,ripen,patience,0);
 def oac-read-chain(recipes,args,ripen,patience,last) = nil?(recipes) ? last : {
  let ack = oac-hold(head(recipes),args,ripen,patience);
  oac-nothing?(ack) ? nothing : oac-read-chain(tail(recipes),args,ripen,patience,ack);
 };
 // Keep answered and silent distinct: an absent answer establishes no rejection.
 def oac-census-loop(recipes,args,answered,silent) = recipes |> foldl((counts,recipe) => {
  let absent = oac-nothing?(offer(recipe,args));
  list(head(counts) + (absent ? 0 : 1),nth(counts,1) + (absent ? 1 : 0));
 },list(answered,silent));
 def oac-census(recipes,args) = oac-census-loop(recipes,args,0,0);
 def oac-answered(c) = head(c);
 def oac-silent(c) = nth(c,1);
 def oac-readable?(c) = oac-answered(c) > 0;
 0;
}
