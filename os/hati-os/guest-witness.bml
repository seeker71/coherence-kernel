// Read actual QEMU serial/exit artifacts and the kernel bytes from one build.
// preludes: os/hati-os/guest-native.bml
section [form.bml] {
 class HatiGuestWitness {
  def hgw-lf(text) = hgw-lf-at(text, str_find(text, "\r\n", 0));
  def hgw-lf-at(text, at) = if (at < 0) then text else str_concat(substring(text, 0, at), str_concat("\n", hgw-lf(substring(text, (at + 2), str_len(text)))));
  def hgw-has?(text, value) = (str_find(text, value, 0) >= 0);
  def hgw-twice?(text, value) {
   let first = str_find(text, value, 0);
   if (first < 0) then 0 else (str_find(text, value, (first + str_len(value))) >= 0);
  }
  def hgw-number(text, marker, start) {
   let at = str_find(text, marker, start);
   if (at < 0) then -1 else str_to_int(substring(text, (at + str_len(marker)), str_len(text)));
  }
  def hgw-increases?(text, marker) {
   let first = str_find(text, marker, 0);
   if (first < 0) then 0 else (hgw-number(text, marker, (first + str_len(marker))) > hgw-number(text, marker, 0));
  }
  def hgw-bit(ok, bit) = if ok then bit else 0;
  def hgw-check(serial, exit-text, kernel) = if (nothing?(serial) || (nothing?(exit-text) || nothing?(kernel))) then 0 else hgw-check-text(hgw-lf(serial), exit-text, kernel);
  def hgw-check-text(serial, exit-text, kernel) = sum(list(
   hgw-bit(hgw-has?(serial, "boot witness: BIOS sector -> A20 -> GDT -> protected mode -> kmain"), 1),
   hgw-bit(hgw-has?(serial, "help ps mem ls cat <f> write <f> <text> echo <s> uptime spin halt"), 2),
   hgw-bit((hgw-has?(serial, "hati> hel\n") && (hgw-has?(serial, "hati> helpx\n") && hgw-twice?(serial, "unknown verb (help lists what this body can do)"))), 4),
   hgw-bit((hgw-has?(serial, "wrote 23 bytes to form") && hgw-has?(serial, "cat form\nForm emits native bytes\n")), 8),
   hgw-bit((hgw-has?(serial, "hati> cat for\n") && (hgw-has?(serial, "hati> cat formx\n") && hgw-twice?(serial, "no such file (honest miss)"))), 16),
   hgw-bit((hgw-has?(serial, "wrote 0 bytes to empty") && hgw-has?(serial, "empty (0 bytes)")), 32),
   hgw-bit((hgw-increases?(serial, "task 0 shell runs=") && (hgw-increases?(serial, "hearts a=") && hgw-increases?(serial, " b="))), 64),
   hgw-bit((hgw-number(serial, "ticks=", 0) > 0), 128),
   hgw-bit((((Comparable) str_to_int(exit-text) == 99) && hgw-has?(serial, "hati-os: witnessed, resting. goodbye.")), 256),
   hgw-bit((hgw-has?(kernel, hg-code(hg-streq-program())) && hgw-has?(kernel, hg-code(hg-slen-program()))), 512)));
  def hgw-read(directory) = hgw-check(read_file(str_concat(directory, "/serial.log")), read_file(str_concat(directory, "/exit.txt")), read_file(str_concat(directory, "/kernel.bin")));
 }
 0;
}
