; Pure emitter relocation and image-layout witness. Expected 255.
; preludes: os/hati-os/guest-native.bml
(do
 (let forward (hg-code (list (hg-jump 235 "next") (hg-label "next") (hg-raw (list 195)))))
 (let backward (hg-code (list (hg-label "start") (hg-raw (list 144)) (hg-jump 235 "start"))))
 (let missing (hg-code (list (hg-jump 235 "missing"))))
 (let far (hg-code (list (hg-jump 235 "far") (list "bytes" (hg-padding 128 (byte_to_str 144) "")) (hg-label "far"))))
 (let boot (str_concat (hg-padding 510 (byte_to_str 0) "") (hg-bytes (list 85 170))))
 (let image (hg-image boot "K"))
 (sum (list
  (if (str_eq forward (hg-bytes (list 235 0 195))) 1 0)
  (if (str_eq backward (hg-bytes (list 144 235 253))) 2 0)
  (if (nothing? missing) 4 0)
  (if (nothing? far) 8 0)
  (if (and (eq (str_len image) 32256) (eq (str_byte_at image 512) 75)) 16 0)
  (if (and (nothing? (hg-image "short" "K")) (nothing? (hg-image boot ""))) 32 0)
  (if (nothing? (hg-image boot (hg-padding 31745 "K" ""))) 64 0)
  (if (and (ge (str_find (hg-assembly) "hati_guest_streq:" 0) 0)
           (ge (str_find (hg-assembly) "hati_guest_slen:" 0) 0)) 128 0))))
