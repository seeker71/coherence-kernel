//////////////////////////////////////////////////////////////////////
//
// bp-table-emit.bml — the sibling kernels' bp tables, generated by the body.
//
// Go, Rust and TypeScript resolve a blueprint name through a table compiled
// into each kernel. Those tables are a projection of three sources, read here
// as they stand:
//
//   form/form-stdlib/blueprint-registry.json  every blueprint name and alias
//   form/form-stdlib/form-ontology.json       categories, primitives and the
//                                             dialect categories (prefix-name)
//   form/form-stdlib/form-ontology-bp.fk      the reviewed bootstrap rows
//
// A name reached twice keeps its first coordinates, in that source order and
// in each file's own order (the registry carries PY-ASSIGN both as an alias of
// F-ASN and as a blueprint of its own; the alias comes first). Names sort
// byte-wise. Each file keeps its own spelling; Rust entries wider than sixty
// columns break the way rustfmt breaks them.
//
//   ./fkwu form/scripts/bp-table-emit.bml
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BpTableEmit {
        def bte-registry() = "form/form-stdlib/blueprint-registry.json";
        def bte-ontology() = "form/form-stdlib/form-ontology.json";
        def bte-reviewed() = "form/form-stdlib/form-ontology-bp.fk";
        def bte-cat(parts) = nil?(parts) ? "" : parts[0] ++ bte-cat(parts[1:]);
        def bte-num(obj, key, fallback) = json-object-has?(obj, key) ? json-int-value(json-object-get(obj, key)) : fallback;
        def bte-text(obj, key) = json-string-value(json-object-get(obj, key));
        def bte-row(name, p, l, t, i) = [name, p, l, t, i];
        // ---- the registry: each blueprint's name, then its aliases ----
        def bte-aliases(obj) = json-object-has?(obj, "aliases") ? json-array-elements(json-object-get(obj, "aliases")) : [];
        def bte-names-rows(names, b, acc) = nil?(names) ? acc : bte-names-rows(names[1:], b, cons(bte-row(json-string-value(names[0]), bte-num(b, "pkg", 1), bte-num(b, "level", 2), bte-num(b, "type", 0), bte-num(b, "inst", 0)), acc));
        def bte-blueprint-rows(bs, acc) = nil?(bs) ? acc : bte-blueprint-rows(bs[1:], bte-names-rows(bte-aliases(bs[0]), bs[0], cons(bte-row(bte-text(bs[0], "name"), bte-num(bs[0], "pkg", 1), bte-num(bs[0], "level", 2), bte-num(bs[0], "type", 0), bte-num(bs[0], "inst", 0)), acc)));
        // ---- the ontology: categories and primitives, then prefixed dialect categories ----
        def bte-plain-rows(cs, acc) = nil?(cs) ? acc : bte-plain-rows(cs[1:], cons(bte-row(bte-text(cs[0], "name"), bte-num(cs[0], "pkg", 1), bte-num(cs[0], "level", 2), bte-num(cs[0], "type", bte-num(cs[0], "category_type", 0)), bte-num(cs[0], "inst", 0)), acc));
        def bte-dialect-cat-rows(d, cs, acc) = nil?(cs) ? acc : bte-dialect-cat-rows(d, cs[1:], cons(bte-row(bte-cat([bte-text(d, "name_prefix"), "-", bte-text(cs[0], "name")]), 1, 2, bte-num(d, "category_type", 0), bte-num(cs[0], "inst", 0)), acc));
        def bte-dialect-rows(ds, keys, acc) = nil?(keys) ? acc : bte-dialect-rows(ds, keys[1:], bte-dialect-cat-rows(json-object-get(ds, keys[0]), json-array-elements(json-object-get(json-object-get(ds, keys[0]), "categories")), acc));
        // ---- the reviewed rows: (fol-bp-row "NAME" p l t i) as the file spells them ----
        def bte-mark() = "(fol-bp-row \"";
        def bte-digits(s, i, n) = (i < len(s)) && ((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) ? bte-digits(s, i + 1, (n * 10) + (str_byte_at(s, i) - 48)) : [n, i];
        def bte-past-space(s, i) = (i < len(s)) && (((Comparable) str_byte_at(s, i) == 32) || ((Comparable) str_byte_at(s, i) == 9)) ? bte-past-space(s, i + 1) : i;
        def bte-int-at(s, i) = bte-digits(s, bte-past-space(s, i + 1), 0);
        def bte-reviewed-at(s, at, acc) {
            let i = str_find(s, bte-mark(), at);
            let start = i + len(bte-mark());
            let close = i < 0 ? -1 : str_find(s, "\"", start);
            let p = i < 0 ? [0, 0] : bte-int-at(s, close);
            let l = i < 0 ? [0, 0] : bte-int-at(s, p[1]);
            let t = i < 0 ? [0, 0] : bte-int-at(s, l[1]);
            let n = i < 0 ? [0, 0] : bte-int-at(s, t[1]);
            i < 0 ? acc : bte-reviewed-at(s, n[1], cons(bte-row(substring(s, start, close), p[0], l[0], t[0], n[0]), acc));
        }
        // ---- first write wins, then a byte-wise merge sort ----
        def bte-seen?(name, rows) = nil?(rows) ? 0 : (String) name == rows[0][0] ? 1 : bte-seen?(name, rows[1:]);
        def bte-first(rows, acc) = nil?(rows) ? acc : bte-seen?(rows[0][0], acc) ? bte-first(rows[1:], acc) : bte-first(rows[1:], cons(rows[0], acc));
        def bte-lt(a, b, i) = i >= len(a) ? (i < len(b)) : i >= len(b) ? 0 : str_byte_at(a, i) < str_byte_at(b, i) ? 1 : str_byte_at(a, i) > str_byte_at(b, i) ? 0 : bte-lt(a, b, i + 1);
        def bte-merge(a, b, acc) = nil?(a) ? append(reverse(acc), b) : nil?(b) ? append(reverse(acc), a) : bte-lt(b[0][0], a[0][0], 0) ? bte-merge(a, b[1:], cons(b[0], acc)) : bte-merge(a[1:], b, cons(a[0], acc));
        def bte-halve(xs, n, acc) = n <= 0 ? [reverse(acc), xs] : bte-halve(xs[1:], n - 1, cons(xs[0], acc));
        def bte-sort(xs) {
            let n = len(xs);
            let parts = bte-halve(xs, n / 2, []);
            n <= 1 ? xs : bte-merge(bte-sort(parts[0]), bte-sort(parts[1]), []);
        }
        // ---- the three spellings ----
        def bte-coords(r, sep) = bte-cat([r[1].str(), sep, r[2].str(), sep, r[3].str(), sep, r[4].str()]);
        def bte-q(s) = "\"" ++ s ++ "\"";
        def bte-header() = "// Code generated by form/scripts/bp-table-emit.bml from blueprint-registry.json,\n// form-ontology.json and the reviewed rows in form-ontology-bp.fk. DO NOT EDIT.\n// Regenerate after any of them changes: ./fkwu form/scripts/bp-table-emit.bml\n\n";
        def bte-go-rows(rs) = nil?(rs) ? "" : bte-cat(["\t", bte-q(rs[0][0]), ": {", bte-coords(rs[0], ", "), "},\n"]) ++ bte-go-rows(rs[1:]);
        def bte-ts-rows(rs) = nil?(rs) ? "" : bte-cat(["  ", bte-q(rs[0][0]), ": [", bte-coords(rs[0], ", "), "],\n"]) ++ bte-ts-rows(rs[1:]);
        def bte-rs-one(r) {
            let tuple = bte-cat(["(", bte-q(r[0]), ", [", bte-coords(r, ", "), "])"]);
            len(tuple) > 60 ? bte-cat(["    (\n        ", bte-q(r[0]), ",\n        [", bte-coords(r, ", "), "],\n    ),\n"]) : bte-cat(["    ", tuple, ",\n"]);
        }
        def bte-rs-rows(rs) = nil?(rs) ? "" : bte-rs-one(rs[0]) ++ bte-rs-rows(rs[1:]);
        def bte-write(path, text) = (Comparable) write_file(path, text) == len(text) ? 1 : form_error("bp table emit: incomplete write " ++ path);
        def bte-run() {
            let reg = parse-json(bte-registry(), read_file(bte-registry()));
            let ont = parse-json(bte-ontology(), read_file(bte-ontology()));
            let fromRegistry = reverse(bte-blueprint-rows(json-array-elements(json-object-get(reg, "blueprints")), []));
            let fromOntology = reverse(bte-dialect-rows(json-object-get(ont, "dialects"), json-object-keys(json-object-get(ont, "dialects")), reverse(bte-plain-rows(json-array-elements(json-object-get(ont, "primitives")), reverse(bte-plain-rows(json-array-elements(json-object-get(ont, "categories")), []))))));
            let fromReviewed = reverse(bte-reviewed-at(read_file(bte-reviewed()), 0, []));
            let rows = bte-sort(bte-first(append(fromRegistry, append(fromOntology, fromReviewed)), []));
            let go = bte-write("form/form-kernel-go/bp_table.go", bte-cat([bte-header(), "package main\n\nvar bpTable = map[string][4]uint32{\n", bte-go-rows(rows), "}\n"]));
            let rs = bte-write("form/form-kernel-rust/src/bp_table.rs", bte-cat([bte-header(), "pub static BP_ENTRIES: &[(&str, [u32; 4])] = &[\n", bte-rs-rows(rows), "];\n"]));
            let ts = bte-write("form/form-kernel-ts/src/bp_table.ts", bte-cat([bte-header(), "export const BP_TABLE: Record<string, [number, number, number, number]> = {\n", bte-ts-rows(rows), "};\n"]));
            "bp tables written: " ++ len(rows).str() ++ " names";
        }
    }
    bte-run();
}
