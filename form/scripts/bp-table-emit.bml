//////////////////////////////////////////////////////////////////////
//
// bp-table-emit.bml — the sibling kernels' bp tables, generated by the body.
//
// Go, Rust and TypeScript resolve a blueprint name through a table compiled
// into each kernel. Those tables are a projection of three sources, read here
// as they stand:
//
//   form/form-stdlib/blueprint-registry.json  every blueprint name and alias
//   form/form-stdlib/form-ontology.json       categories, primitives and the
//                                             dialect categories (prefix-name)
//   form/form-stdlib/form-ontology-bp.fk      the reviewed bootstrap rows
//
// A name reached twice keeps its first coordinates, in that source order and
// in each file's own order (the registry carries PY-ASSIGN both as an alias of
// F-ASN and as a blueprint of its own; the alias comes first). Names sort
// byte-wise. Each file keeps its own spelling; Rust entries wider than sixty
// columns break the way rustfmt breaks them.
//
//   ./fkwu form/scripts/bp-table-emit.bml
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BpTableEmit {
        def bte-registry() = "form/form-stdlib/blueprint-registry.json";
        def bte-ontology() = "form/form-stdlib/form-ontology.json";
        def bte-reviewed() = "form/form-stdlib/form-ontology-bp.fk";
        def bte-cat(parts) = if nil?(parts) then "" else str_concat(head(parts), bte-cat(tail(parts)));
        def bte-num(obj, key, fallback) = if json-object-has?(obj, key) then json-int-value(json-object-get(obj, key)) else fallback;
        def bte-text(obj, key) = json-string-value(json-object-get(obj, key));
        def bte-row(name, p, l, t, i) = list(name, p, l, t, i);
        // ---- the registry: each blueprint's name, then its aliases ----
        def bte-aliases(obj) = if json-object-has?(obj, "aliases") then json-array-elements(json-object-get(obj, "aliases")) else list();
        def bte-names-rows(names, b, acc) = if nil?(names) then acc else bte-names-rows(tail(names), b, cons(bte-row(json-string-value(head(names)), bte-num(b, "pkg", 1), bte-num(b, "level", 2), bte-num(b, "type", 0), bte-num(b, "inst", 0)), acc));
        def bte-blueprint-rows(bs, acc) = if nil?(bs) then acc else bte-blueprint-rows(tail(bs), bte-names-rows(bte-aliases(head(bs)), head(bs), cons(bte-row(bte-text(head(bs), "name"), bte-num(head(bs), "pkg", 1), bte-num(head(bs), "level", 2), bte-num(head(bs), "type", 0), bte-num(head(bs), "inst", 0)), acc)));
        // ---- the ontology: categories and primitives, then prefixed dialect categories ----
        def bte-plain-rows(cs, acc) = if nil?(cs) then acc else bte-plain-rows(tail(cs), cons(bte-row(bte-text(head(cs), "name"), bte-num(head(cs), "pkg", 1), bte-num(head(cs), "level", 2), bte-num(head(cs), "type", bte-num(head(cs), "category_type", 0)), bte-num(head(cs), "inst", 0)), acc));
        def bte-dialect-cat-rows(d, cs, acc) = if nil?(cs) then acc else bte-dialect-cat-rows(d, tail(cs), cons(bte-row(bte-cat(list(bte-text(d, "name_prefix"), "-", bte-text(head(cs), "name"))), 1, 2, bte-num(d, "category_type", 0), bte-num(head(cs), "inst", 0)), acc));
        def bte-dialect-rows(ds, keys, acc) = if nil?(keys) then acc else bte-dialect-rows(ds, tail(keys), bte-dialect-cat-rows(json-object-get(ds, head(keys)), json-array-elements(json-object-get(json-object-get(ds, head(keys)), "categories")), acc));
        // ---- the reviewed rows: (fol-bp-row "NAME" p l t i) as the file spells them ----
        def bte-mark() = "(fol-bp-row \"";
        def bte-digits(s, i, n) = if and(lt(i, str_len(s)), and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57))) then bte-digits(s, add(i, 1), add(mul(n, 10), sub(str_byte_at(s, i), 48))) else list(n, i);
        def bte-past-space(s, i) = if and(lt(i, str_len(s)), or(eq(str_byte_at(s, i), 32), eq(str_byte_at(s, i), 9))) then bte-past-space(s, add(i, 1)) else i;
        def bte-int-at(s, i) = bte-digits(s, bte-past-space(s, add(i, 1)), 0);
        def bte-reviewed-at(s, at, acc) {
            let i = str_find(s, bte-mark(), at);
            let start = add(i, str_len(bte-mark()));
            let close = if lt(i, 0) then -1 else str_find(s, "\"", start);
            let p = if lt(i, 0) then list(0, 0) else bte-int-at(s, close);
            let l = if lt(i, 0) then list(0, 0) else bte-int-at(s, nth(p, 1));
            let t = if lt(i, 0) then list(0, 0) else bte-int-at(s, nth(l, 1));
            let n = if lt(i, 0) then list(0, 0) else bte-int-at(s, nth(t, 1));
            if lt(i, 0) then acc else bte-reviewed-at(s, nth(n, 1), cons(bte-row(substring(s, start, close), head(p), head(l), head(t), head(n)), acc));
        }
        // ---- first write wins, then a byte-wise merge sort ----
        def bte-seen?(name, rows) = if nil?(rows) then 0 else if str_eq(name, head(head(rows))) then 1 else bte-seen?(name, tail(rows));
        def bte-first(rows, acc) = if nil?(rows) then acc else if bte-seen?(head(head(rows)), acc) then bte-first(tail(rows), acc) else bte-first(tail(rows), cons(head(rows), acc));
        def bte-lt(a, b, i) = if ge(i, str_len(a)) then lt(i, str_len(b)) else if ge(i, str_len(b)) then 0 else if lt(str_byte_at(a, i), str_byte_at(b, i)) then 1 else if gt(str_byte_at(a, i), str_byte_at(b, i)) then 0 else bte-lt(a, b, add(i, 1));
        def bte-merge(a, b, acc) = if nil?(a) then append(reverse(acc), b) else if nil?(b) then append(reverse(acc), a) else if bte-lt(head(head(b)), head(head(a)), 0) then bte-merge(a, tail(b), cons(head(b), acc)) else bte-merge(tail(a), b, cons(head(a), acc));
        def bte-halve(xs, n, acc) = if le(n, 0) then list(reverse(acc), xs) else bte-halve(tail(xs), sub(n, 1), cons(head(xs), acc));
        def bte-sort(xs) {
            let n = len(xs);
            let parts = bte-halve(xs, div(n, 2), list());
            if le(n, 1) then xs else bte-merge(bte-sort(head(parts)), bte-sort(nth(parts, 1)), list());
        }
        // ---- the three spellings ----
        def bte-coords(r, sep) = bte-cat(list(int_to_str(nth(r, 1)), sep, int_to_str(nth(r, 2)), sep, int_to_str(nth(r, 3)), sep, int_to_str(nth(r, 4))));
        def bte-q(s) = str_concat("\"", str_concat(s, "\""));
        def bte-header() = "// Code generated by form/scripts/bp-table-emit.bml from blueprint-registry.json,\n// form-ontology.json and the reviewed rows in form-ontology-bp.fk. DO NOT EDIT.\n// Regenerate after any of them changes: ./fkwu form/scripts/bp-table-emit.bml\n\n";
        def bte-go-rows(rs) = if nil?(rs) then "" else str_concat(bte-cat(list("\t", bte-q(head(head(rs))), ": {", bte-coords(head(rs), ", "), "},\n")), bte-go-rows(tail(rs)));
        def bte-ts-rows(rs) = if nil?(rs) then "" else str_concat(bte-cat(list("  ", bte-q(head(head(rs))), ": [", bte-coords(head(rs), ", "), "],\n")), bte-ts-rows(tail(rs)));
        def bte-rs-one(r) {
            let tuple = bte-cat(list("(", bte-q(head(r)), ", [", bte-coords(r, ", "), "])"));
            if gt(str_len(tuple), 60) then bte-cat(list("    (\n        ", bte-q(head(r)), ",\n        [", bte-coords(r, ", "), "],\n    ),\n")) else bte-cat(list("    ", tuple, ",\n"));
        }
        def bte-rs-rows(rs) = if nil?(rs) then "" else str_concat(bte-rs-one(head(rs)), bte-rs-rows(tail(rs)));
        def bte-write(path, text) = if eq(write_file(path, text), str_len(text)) then 1 else form_error(str_concat("bp table emit: incomplete write ", path));
        def bte-run() {
            let reg = parse-json(bte-registry(), read_file(bte-registry()));
            let ont = parse-json(bte-ontology(), read_file(bte-ontology()));
            let fromRegistry = reverse(bte-blueprint-rows(json-array-elements(json-object-get(reg, "blueprints")), list()));
            let fromOntology = reverse(bte-dialect-rows(json-object-get(ont, "dialects"), json-object-keys(json-object-get(ont, "dialects")), reverse(bte-plain-rows(json-array-elements(json-object-get(ont, "primitives")), reverse(bte-plain-rows(json-array-elements(json-object-get(ont, "categories")), list()))))));
            let fromReviewed = reverse(bte-reviewed-at(read_file(bte-reviewed()), 0, list()));
            let rows = bte-sort(bte-first(append(fromRegistry, append(fromOntology, fromReviewed)), list()));
            let go = bte-write("form/form-kernel-go/bp_table.go", bte-cat(list(bte-header(), "package main\n\nvar bpTable = map[string][4]uint32{\n", bte-go-rows(rows), "}\n")));
            let rs = bte-write("form/form-kernel-rust/src/bp_table.rs", bte-cat(list(bte-header(), "pub static BP_ENTRIES: &[(&str, [u32; 4])] = &[\n", bte-rs-rows(rows), "];\n")));
            let ts = bte-write("form/form-kernel-ts/src/bp_table.ts", bte-cat(list(bte-header(), "export const BP_TABLE: Record<string, [number, number, number, number]> = {\n", bte-ts-rows(rows), "};\n")));
            str_concat("bp tables written: ", str_concat(int_to_str(len(rows)), " names"));
        }
    }
    bte-run();
}
