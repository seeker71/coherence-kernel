//////////////////////////////////////////////////////////////////////
//
// form-asm-trig-witness.bml — the body's half of form_asm_trig_witness.sh.
//
// fam-sin / fam-cos are Form -> asm BYTES (tests/form-asm-trig-band.fk proves
// every kernel emits the same ones). This door wraps those bytes as Mach-O
// objects with form-macho, writes them, and writes the two point sets the
// carrier's loader probes: the named accuracy-bar angles (0, pi/6, pi/4, pi/2,
// pi, 3pi/2, 2pi) and RoPE's real domain (position 0..8192 step 7,
// inv_freq = 1/base^(2i/d), d=128, base=500000 — the llama3 convention). The
// carrier links, loads and compares against libm; this door only makes.
//
// base^(2i/d) is exp((2i/d) ln base) through the body's own tn-exp and fln,
// within a few ulp of libm's pow; every angle prints as its shortest
// round-trip decimal, which the loader's atof reads back exactly.
//
// stdin: the work directory.
//
//   ./fkwu form/scripts/form-asm-trig-witness.bml < dir
//
// preludes: form-stdlib/core.fk form-stdlib/form-macho.fk form-stdlib/form-asm-trig.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormAsmTrigWitness {
        def fatw-chomp(s) = if eq(str_len(s), 0) then s else if or(eq(str_byte_at(s, sub(str_len(s), 1)), 10), eq(str_byte_at(s, sub(str_len(s), 1)), 13)) then fatw-chomp(substring(s, 0, sub(str_len(s), 1))) else s;
        def fatw-line() {
            let raw = read_line();
            if nothing?(raw) then "" else fatw-chomp(raw);
        }
        def fatw-bytes(xs, acc) = if nil?(xs) then acc else fatw-bytes(tail(xs), str_concat(acc, byte_to_str(head(xs))));
        def fatw-write(path, text) = if eq(write_file(path, text), str_len(text)) then str_len(text) else form_error(str_concat("form asm trig witness: incomplete write ", path));
        def fatw-pi() = 3.141592653589793;
        def fatw-named() = list(0, div(fatw-pi(), 6.0), div(fatw-pi(), 4.0), div(fatw-pi(), 2.0), fatw-pi(), mul(3.0, div(fatw-pi(), 2.0)), mul(2.0, fatw-pi()));
        def fatw-words(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then value_str(head(xs)) else str_concat(value_str(head(xs)), str_concat(" ", fatw-words(tail(xs))));
        // the 64 inverse frequencies depend on i alone; each position scales them
        def fatw-inv-freqs(i, acc) = if ge(i, 64) then reverse(acc) else fatw-inv-freqs(add(i, 1), cons(div(1.0, tn-exp(mul(div(mul(2.0, i), 128.0), fln(500000.0)))), acc));
        def fatw-row(pos, fs, acc) = if nil?(fs) then acc else fatw-row(pos, tail(fs), str_concat(acc, str_concat(value_str(mul(add(pos, 0.0), head(fs))), "\n")));
        def fatw-rows(pos, fs, acc) = if gt(pos, 8192) then reverse(acc) else fatw-rows(add(pos, 7), fs, cons(fatw-row(pos, fs, ""), acc));
        // join pairwise, so each byte is copied once per halving rather than once per row
        def fatw-pairs(xs) = if nil?(xs) then list() else if nil?(tail(xs)) then xs else cons(str_concat(head(xs), head(tail(xs))), fatw-pairs(tail(tail(xs))));
        def fatw-join(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else fatw-join(fatw-pairs(xs));
        def fatw-run() {
            let dir = fatw-line();
            let sinO = mo-object-sym(fam-sin(), list(95, 102, 97, 109, 95, 115, 105, 110));
            let cosO = mo-object-sym(fam-cos(), list(95, 102, 97, 109, 95, 99, 111, 115));
            let a = fatw-write(str_concat(dir, "/fam_sin.o"), fatw-bytes(sinO, ""));
            let b = fatw-write(str_concat(dir, "/fam_cos.o"), fatw-bytes(cosO, ""));
            let c = fatw-write(str_concat(dir, "/named_pts.txt"), str_concat(fatw-words(fatw-named()), "\n"));
            let d = fatw-write(str_concat(dir, "/rope_domain.txt"), fatw-join(fatw-rows(0, fatw-inv-freqs(0, list()), list())));
            str_concat("emitted _fam_sin.o (", str_concat(int_to_str(len(sinO)), str_concat(" bytes), _fam_cos.o (", str_concat(int_to_str(len(cosO)), " bytes)"))));
        }
    }
    fatw-run();
}
