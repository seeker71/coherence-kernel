; e2e-run-prompt.fk — the REAL PROMPT through the driver's front stages on fkwu: llama3.2 chat
; template composed around the actual community-page prompt bytes, then the tokenize stage asked to
; run. The llama3 rank-table carrier is pending (claude/tokenizer-carriers), so the vocab binding is
; EMPTY and the driver must STOP at tokenize with status 0 — real template bytes, honestly empty ids
; and text, nothing fabricated. Carrier witness for scripts/e2e_driver_witness.sh; not a band (the
; refusal law itself is four-way proven at proof scale by tests/e2e-driver-band.fk claim 128).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk form-stdlib/llama-numerics.fk form-stdlib/rope.fk form-stdlib/transformer-block.fk form-stdlib/transformer-mh.fk form-stdlib/gqa-attn.fk form-stdlib/llama-block.fk form-stdlib/llama-gqa-block.fk form-stdlib/kv-cache.fk form-stdlib/kv-llama-block.fk form-stdlib/kv-gqa-llama-block.fk form-stdlib/multi-layer-stack.fk form-stdlib/gqa-multi-layer-stack.fk form-stdlib/greedy-decode.fk form-stdlib/llama-generate.fk form-stdlib/e2e-driver.fk
;
; Output: (status tpl-len tokenize-status gen-len txt-len (first 3 template bytes) lane-table)
;   status 0 + tokenize-status 0 + gen-len 0 + txt-len 0 == the honest stop at tokenize;
;   tpl-len == 57 + 2 + 290 + 55 + 2 == 406 real template bytes; first bytes 60 124 98 == "<|b".
(do
    (let prompt "Write a short status update for our community page: the mixture-of-experts gating recipe now runs identically on all four kernels, a real model now runs on our own native lane, and the next milestone is a full conversation running end-to-end at home. Keep it plain and warm, four sentences.")
    (let nlnl (list 10 10))
    (let pre (ed-append (host-abi-string-to-bytes "<|begin_of_text|><|start_header_id|>user<|end_header_id|>") nlnl))
    (let suf (ed-append (host-abi-string-to-bytes "<|eot_id|><|start_header_id|>assistant<|end_header_id|>") nlnl))
    (let ps  (host-abi-string-to-bytes prompt))

    ; the pending tokenize binding: NO vocab has landed for the llama3 rank table
    (let vocab (empty))
    ; forward-stage arguments are never reached on the refusal path; minimal placeholders satisfy
    ; the eager call only — no weight math runs in this file
    (let tok (list (list 0.0)))  (let layers (list))  (let gf (list 1.0))
    (let cfg (rope-cfg 10000.0 32.0 1.0 4.0 8192.0))

    (let tr (ed-run pre ps suf vocab tok layers gf 0.00001 1.0 1 1 1 cfg 0))
    (let tpl (nth tr 1))
    (let tk (ed-tokenize vocab tpl))
    (list (nth tr 0)
          (len tpl)
          (head tk)
          (len (nth tr 2))
          (len (nth tr 3))
          (list (nth tpl 0) (nth tpl 1) (nth tpl 2))
          (ed-lane-table)))
