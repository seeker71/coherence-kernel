//////////////////////////////////////////////////////////////////////
//
// emit-native-python-roundtrip.bml — the universal translator's proof of
// shape, carried whole by the body.
//
// One Form recipe, as source text, goes through python-native.fk's
// pn-emit-string and comes out as idiomatic Python (`def`, `return`, `+`,
// a conditional expression). The body's own Python model
// (grammars/python-bmf.fk read, python-bmf-lift.fk + python-bmf-eval.fk run)
// evaluates add(2, 3), factorial(5) and factorial(10) on that page; fkwu runs
// the SAME recipe text as Form. The two answers must be equal. No CPython and
// no sibling kernel stand in the loop.
//
// The Python model is a separate reading of Python semantics written in
// Form, so a page that is not the Python it claims to be fails here; it
// shares Form's runtime, so it is not an executor independent of Form.
//
//   ./fkwu form/scripts/emit-native-python-roundtrip.bml
//
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/grammars/python-bmf.fk form-stdlib/python-bmf-lift.fk form-stdlib/python-bmf-eval.fk form-stdlib/emits/semantic-lowerer.fk form-stdlib/lenses/symbol-source.fk form-stdlib/emits/python-native.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class EmitNativePythonRoundtrip {
        // the one recipe both sides read
        def enpr-source() = "(defn add (a b) (add a b))\n(defn factorial (n) (if (le n 1) 1 (mul n (factorial (sub n 1)))))\n";
        def enpr-calls-py() = "\n[add(2, 3), factorial(5), factorial(10)]\n";
        def enpr-calls-fk() = "(print (list (add 2 3) (factorial 5) (factorial 10)))\n";
        def enpr-words(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then value_str(head(xs)) else str_concat(value_str(head(xs)), str_concat(" ", enpr-words(tail(xs))));
        // Form's side: fkwu runs the same text as a direct-source cell and prints the list
        def enpr-form-side(dir) {
            let cell = str_concat(dir, "/roundtrip.fk");
            let out = str_concat(dir, "/roundtrip.out");
            let wrote = write_file(cell, str_concat(enpr-source(), enpr-calls-fk()));
            let pid = host_spawn_at(list("./fkwu", cell), list("/dev/null", out, "/dev/null"));
            let status = if or(nothing?(pid), le(pid, 0)) then -1 else host_wait(pid);
            let text = read_file(out);
            if or(not(eq(status, 0)), nothing?(text)) then form_error("emit-native-python roundtrip: fkwu could not run the recipe") else enpr-first-line(text);
        }
        def enpr-first-line(text) = enpr-line-at(text, 0);
        def enpr-line-at(text, i) = if or(ge(i, str_len(text)), eq(str_byte_at(text, i), 10)) then substring(text, 0, i) else enpr-line-at(text, add(i, 1));
        def enpr-run() {
            let dir = str_concat(temp_dir(), "/emit-native-python-roundtrip");
            let made = fs_mkdir(dir);
            let py = pn-emit-string(enpr-source());
            let bodyValues = py-run(lift-module-text(str_concat(py, enpr-calls-py())));
            let pyLine = str_concat("[", str_concat(enpr-words(bodyValues), "]"));
            let formLine = enpr-form-side(dir);
            let pyShown = print_str(py);
            let same = str_eq(enpr-words(bodyValues), enpr-words(parse-list-line(formLine)));
            if same then str_concat("roundtrip ok — the body's Python model and fkwu agree: ", pyLine) else form_error(str_concat("roundtrip MISMATCH — python model ", str_concat(pyLine, str_concat(" / fkwu ", formLine))));
        }
        // fkwu prints a flat int list as [a, b, c]; read it back without a second grammar
        def parse-list-line(line) = enpr-ints(line, 0, 0, 0, list());
        def enpr-ints(s, i, n, inNum, acc) = if ge(i, str_len(s)) then reverse(if inNum then cons(n, acc) else acc) else if and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)) then enpr-ints(s, add(i, 1), add(mul(n, 10), sub(str_byte_at(s, i), 48)), 1, acc) else enpr-ints(s, add(i, 1), 0, 0, if inNum then cons(n, acc) else acc);
    }
    enpr-run();
}
