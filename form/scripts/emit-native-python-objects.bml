//////////////////////////////////////////////////////////////////////
//
// emit-native-python-objects.bml — the cached Python BMF objects module,
// emitted on fkwu from the ontology itself.
//
// form-stdlib/form-ontology.json holds the python.bmf categories; ontology-emit
// reads them as (name, inst) pairs and python-native.fk's
// pn-emit-objects-module renders the module. No Form literal of the category
// table lives in the emitter: the ontology is the source of truth, read where
// it stands. The page lands at the path its own header names;
// form/scripts/python-page-read.bml then reads it as Python.
//
//   ./fkwu form/scripts/emit-native-python-objects.bml
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/form-fs.fk form-stdlib/bml/ontology-emit.bml form-stdlib/emits/semantic-lowerer.fk form-stdlib/lenses/symbol-source.fk form-stdlib/emits/python-native.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class EmitNativePythonObjects {
        def enpo-dir() = "form/.cache/emit_native_python";
        def enpo-out() = "form/.cache/emit_native_python/python_bmf/objects.py";
        def enpo-pairs(cs) = if nil?(cs) then list() else cons(list(oe-text(head(cs), "name"), oe-number(head(cs), "inst")), enpo-pairs(tail(cs)));
        def enpo-run() {
            let root = oe-root();
            let pairs = enpo-pairs(oe-categories(oe-field(oe-dialects(root), "python.bmf")));
            let madeCache = fs_mkdir("form/.cache");
            let madeDir = fs_mkdir(enpo-dir());
            let madeOut = fs_mkdir(str_concat(enpo-dir(), "/python_bmf"));
            let page = pn-emit-objects-module(pairs);
            let written = write_file(enpo-out(), page);
            if not(eq(written, str_len(page))) then form_error("emit native python objects: incomplete write") else str_concat("wrote ", str_concat(enpo-out(), str_concat(" (", str_concat(int_to_str(len(pairs)), " categories)"))));
        }
    }
    enpo-run();
}
