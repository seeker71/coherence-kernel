//////////////////////////////////////////////////////////////////////
//
// python-page-read.bml — does an emitted Python page read as Python?
//
// The body's own Python grammar (grammars/python-bmf.fk) and lift
// (python-bmf-lift.fk) read the page at the path on stdin, statement by
// statement. A page that reads answers with its statement count; a shape the
// grammar does not carry refuses by name and the process exits nonzero. This
// is the judgement `python3 -m py_compile` used to lend: it reads the page, it
// does not run it.
//
//   ./fkwu form/scripts/python-page-read.bml < path
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/grammars/python-bmf.fk form-stdlib/python-bmf-lift.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class PythonPageRead {
        def ppr-chomp(s) = if eq(str_len(s), 0) then s else if or(eq(str_byte_at(s, sub(str_len(s), 1)), 10), eq(str_byte_at(s, sub(str_len(s), 1)), 13)) then ppr-chomp(substring(s, 0, sub(str_len(s), 1))) else s;
        def ppr-run() {
            let raw = read_line();
            let path = if nothing?(raw) then "" else ppr-chomp(raw);
            let page = read_file(path);
            let module = if nothing?(page) then form_error(str_concat("python page read: unread ", path)) else lift-module-text(page);
            str_concat("reads as Python: ", str_concat(path, str_concat(" (", str_concat(int_to_str(len(node_children(module))), " statements)"))));
        }
    }
    ppr-run();
}
