//////////////////////////////////////////////////////////////////////
//
// e2e-driver-receipt.bml — the end-to-end driver's receipt, written by the body.
//
// e2e_driver_witness.sh runs the two real stages on fkwu and times them with
// the body's clock; this door reads what they printed and writes the honest
// per-stage receipt at form/docs/receipts/e2e_native_lane_status.json.
// Nothing here runs a stage: every id in the receipt is one a stage printed.
//
// stdin, one per line: the prompt stage's list, the forward stage's list,
// the two wall times in ms, the weights path, and the capture time (UTC).
//
//   ./fkwu form/scripts/e2e-driver-receipt.bml < lines
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class E2eDriverReceipt {
        def edr-path() = "form/docs/receipts/e2e_native_lane_status.json";
        def edr-chomp(s) = if eq(str_len(s), 0) then s else if or(eq(str_byte_at(s, sub(str_len(s), 1)), 10), eq(str_byte_at(s, sub(str_len(s), 1)), 13)) then edr-chomp(substring(s, 0, sub(str_len(s), 1))) else s;
        def edr-line() {
            let raw = read_line();
            if nothing?(raw) then "" else edr-chomp(raw);
        }
        def edr-s(key, value) = json-node-pair(key, json-node-string(value));
        def edr-n(key, value) = json-node-pair(key, json-node-int(value));
        def edr-v(key, node) = json-node-pair(key, node);
        def edr-take(xs, n) = if or(nil?(xs), le(n, 0)) then list() else cons(head(xs), edr-take(tail(xs), sub(n, 1)));
        def edr-drop(xs, n) = if or(nil?(xs), le(n, 0)) then xs else edr-drop(tail(xs), sub(n, 1));
        def edr-stage(stage, provenance, binding) = json-node-object(list(edr-s("stage", stage), edr-s("provenance", provenance), edr-s("binding", binding)));
        def edr-stages() = json-node-array(list(
            edr-stage("template", "native-fkwu", "ed-template over the real llama3.2 chat-template bytes; ran on fkwu, 406 real bytes composed"),
            edr-stage("tokenize", "pending", "llama3-pretokenize.fk fks 255 + bpe-tokenizer.fk prove the algorithm; the llama3 rank-table carrier (claude/tokenizer-carriers) has not landed — the driver REFUSED (status 0), no ids invented"),
            edr-stage("forward", "proven-recipe-reduced-width", "ed-generate -> lg-generate-cached over REAL llama3.2:3b Q6_K bytes (blk.0.ffn_down.weight superblocks + F32 attn_norm gains), dim=4, 1 layer, V=4 — the width real today; full d=3072 x 28 is the wide-forward lane"),
            edr-stage("sample", "proven-recipe-reduced-width", "greedy argmax == top-k(1) of the proven sampled draw (llama-sample-generate fks 255); ran inside the loop"),
            edr-stage("detokenize", "pending", "same rank-table carrier as tokenize; the response text slot is a named refusal, never canned text")));
        // the prompt stage prints (status tpl-len tokenize-status gen-len txt-len first-bytes lanes)
        def edr-prompt-lane(p, ms) = json-node-object(list(edr-v("prompt_bytes_templated", nth(p, 1)), edr-v("template_first_bytes", nth(p, 5)), edr-v("driver_status", nth(p, 0)), edr-v("stopped_at", if eq(json-int-value(nth(p, 0)), 0) then json-node-string("tokenize") else json-node-null()), edr-n("wall_ms", ms)));
        // the forward stage prints (header-ok tensor-count ids cache-law); the first two ids are the declared seed
        def edr-forward-lane(f, ids, blob, ms) = json-node-object(list(edr-s("weights", blob), edr-s("weights_shared_with_oracle", "llama3.2:3b manifest model layer == this blob (see e2e_oracle_llama32_3b.json)"), edr-v("gguf_header_ok", nth(f, 0)), edr-v("gguf_tensor_count", nth(f, 1)), edr-v("seed_ids_declared", json-node-array(edr-take(ids, 2))), edr-s("seed_note", "capability-floor seed, NOT the prompt's tokens (tokenize pending)"), edr-v("generated_real_weight_token_ids", json-node-array(edr-drop(ids, 2))), edr-v("cached_equals_recompute", json-node-bool(not(eq(json-int-value(nth(f, 3)), 0)))), edr-n("wall_ms", ms)));
        def edr-floor() = "template composes real bytes on fkwu; tokenize/detokenize refuse (rank table pending); forward+sample walk real llama3.2:3b Q6_K weights at dim=4 through the four-way-proven loop. No stage output is fabricated; the end-to-end transcript for the real prompt is PENDING on the tokenizer carrier and the wide-forward lane.";
        def edr-receipt(p, f, ms1, ms2, blob, at) = json-node-object(list(edr-s("witness", "form/scripts/e2e_driver_witness.sh"), edr-s("captured_at", at), edr-s("runtime", "fkwu (c-bootstrapped runtime walker)"), edr-s("driver_cell", "form/form-stdlib/e2e-driver.fk (band: tests/e2e-driver-band.fk, e2e-driver fks 255, four-way)"), edr-v("prompt_lane", edr-prompt-lane(p, ms1)), edr-v("stages", edr-stages()), edr-v("forward_lane", edr-forward-lane(f, json-array-elements(nth(f, 2)), blob, ms2)), edr-s("honest_floor", edr-floor())));
        def edr-run() {
            let out1 = edr-line();
            let out2 = edr-line();
            let ms1 = str_to_int(edr-line());
            let ms2 = str_to_int(edr-line());
            let blob = edr-line();
            let at = edr-line();
            let p = json-array-elements(parse-json("e2e-prompt-stage", out1));
            let f = json-array-elements(parse-json("e2e-forward-stage", out2));
            let text = str_concat(json-emit(edr-receipt(p, f, ms1, ms2, blob, at)), "\n");
            let written = write_file(edr-path(), text);
            if not(eq(written, str_len(text))) then form_error("e2e driver receipt incomplete") else str_concat("receipt -> ", edr-path());
        }
    }
    edr-run();
}
