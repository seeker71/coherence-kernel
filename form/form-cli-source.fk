; form-cli-source.fk — direct-source generation entry.
;
; Unflattened authority for the adaptive generation organ. This source unit
; keeps only the dependencies its live verbs exercise. Other form-cli organs
; can join by direct import as their source dialects become importable.
;
; import "form-stdlib/core.fk"
; import "form-stdlib/str-byte-at.fk"
; import "form-stdlib/string-byte-fold-src-shim.fk"
; import "form-stdlib/sha256.fk"
; import "form-stdlib/hex-encode-only.fk"
; import "form-stdlib/ask-native-lane.fk"
; import "form-stdlib/form-cli-adaptive-generation.fk"
; import "form-stdlib/form-cli-adaptive-execute.fk"

(do
    (defn fcs-verb (line)
        (do
            (let at (str_find line " " 0))
            (if (lt at 0) line (substring line 0 at))))

    (defn fcs-arg (line)
        (do
            (let at (str_find line " " 0))
            (if (lt at 0) "" (substring line (add at 1) (str_len line)))))

    (defn fcs-between (text begin end)
        (do
            (let b (str_find text begin 0))
            (if (lt b 0) ""
                (do
                    (let s (add b (str_len begin)))
                    (let e (str_find text end s))
                    (if (lt e 0) "" (substring text s e))))))

    (defn fcs-first-line (text)
        (do
            (let e (str_find text "\n" 0))
            (if (lt e 0) text (substring text 0 e))))

    (defn fcs-form-source (text)
        (do
            (let underscored
                (fcs-between text "BEGIN_FORM\n" "\nEND_FORM"))
            (if (gt (str_len underscored) 0) underscored
                (fcs-between text "BEGIN FORM\n" "\nEND FORM"))))

    ; An inspectable instruction surface, not private chain-of-thought.  It
    ; tells the generator what must remain true and what observation admits
    ; the result, while leaving the implementation to the model.
    (defn fcs-build-instruction (question)
        (str_concat
            "GOAL="
            (str_concat question
                "; DIALECT=Form named operators; METHOD=encode relation and check each branch; SUCCESS=program returns 1 only when all checks pass")))

    (defn fcs-local-code-prompt (question)
        (str_concat
            "Return only executable Form between BEGIN_FORM and END_FORM. Use exactly one outer (do ...), place every defn inside it, use eq not =, lt not <, gt not >. The and operator takes exactly two arguments; nest and for three or more checks. Finish with a check returning integer 1 only when all requested examples pass. Example: BEGIN_FORM\n(do (defn double (x) (mul x 2)) (if (eq (double 4) 8) 1 0))\nEND_FORM\nTask: "
            question))

    (defn fcs-build (question)
        (do
            (let ready (anl-refresh-build question))
            (if (eq ready 0)
                (str_concat
                    "form-cli-build-admitted:0\nform-cli-build-reason:"
                    (anl-refusal question))
                (do
                    (let answer (anl-answer-text
                        (read_file (anl-artifact-path))))
                    (let source (fcs-form-source answer))
                    (if (eq (str_len source) 0)
                        (str_concat
                            "form-cli-build-admitted:0\nform-cli-build-reason:missing-form-envelope\nform-cli-build-model-output:\n"
                            answer)
                        (do
                            (let path ".coherence-network/ask-native/candidate.fk")
                            (let wrote (write_file path source))
                            (let observed (host-exec
                                "./fkwu --src .coherence-network/ask-native/candidate.fk"
                                ""))
                            (let admitted (if
                                (str_eq (fcs-first-line observed) "1") 1 0))
                            (str_concat
                                (str_concat "form-cli-build-admitted:"
                                    (int_to_str admitted))
                                (str_concat
                                "\nform-cli-build-lane:native-local\nform-cli-build-network:0\nform-cli-build-source:\n"
                                (str_concat source
                                    (str_concat
                                        "\nform-cli-build-observed:\n"
                                        observed))))))))))

    (defn fcs-admit-model-answer (answer lane model)
        (do
            (let source (fcs-form-source answer))
            (if (eq (str_len source) 0)
                (str_concat
                    "form-cli-build-admitted:0\nform-cli-build-reason:missing-form-envelope\nform-cli-build-model-output:\n"
                    answer)
                (do
                    (let path ".coherence-network/ask-native/candidate.fk")
                    (let wrote (write_file path source))
                    (let observed (host-exec
                        "./fkwu --src .coherence-network/ask-native/candidate.fk"
                        ""))
                    (let admitted (if
                        (str_eq (fcs-first-line observed) "1") 1 0))
                    (str_concat
                        (str_concat "form-cli-build-admitted:"
                            (int_to_str admitted))
                        (str_concat "\nform-cli-build-lane:"
                            (str_concat lane
                        (str_concat "\nform-cli-build-model:"
                            (str_concat model
                        (str_concat "\nform-cli-build-network:0\nform-cli-build-source:\n"
                            (str_concat source
                                (str_concat "\nform-cli-build-observed:\n"
                                    observed))))))))))))

    (defn fcs-large-local-build (question)
        (do
            (let prompt (fcs-local-code-prompt question))
            (let coder-answer
                (host-exec "ollama run coder:latest --nowordwrap" prompt))
            (let coder-report
                (fcs-admit-model-answer coder-answer "local-coder" "coder:latest"))
            (if (ge (str_find coder-report "form-cli-build-admitted:1" 0) 0)
                coder-report
                (do
                    (let strong-answer
                        (host-exec "ollama run qwen2.5:72b --nowordwrap" prompt))
                    (let strong-report
                        (fcs-admit-model-answer strong-answer "local-strong" "qwen2.5:72b"))
                    (str_concat coder-report
                        (str_concat "\nform-cli-build-next-local-attempt:\n"
                            strong-report))))))

    (defn fcs-instruct-build (question)
        (do
            (let instruction (fcs-build-instruction question))
            (str_concat
                "form-cli-build-instruction:\n"
                (str_concat instruction
                    (str_concat "\n"
                        (fcs-large-local-build question))))))

    (defn fcs-respond (line)
        (do
            (let verb (fcs-verb line))
            (if (str_eq verb "carrier-probe")
                (host-exec "tr '[:lower:]' '[:upper:]'" "local-carrier-alive")
                (if (str_eq verb "build")
                    (fcs-build (fcs-arg line))
                (if (str_eq verb "instruct-build")
                    (fcs-instruct-build (fcs-arg line))
                (if (str_eq verb "generate")
                    (do
                        (let question (fcs-arg line))
                        (let native-ready (if (eq (anl-ready? question) 1)
                                                1
                                                (anl-refresh question)))
                        (if (eq native-ready 1)
                            (str_concat (anl-answer question)
                                "\nform-cli-generation-lane:native\nform-cli-native-attempts:1\nform-cli-native-accepted:1\nform-cli-local-cheap-attempts:0\nform-cli-local-cheap-accepted:0\nform-cli-local-strong-attempts:0\nform-cli-local-strong-accepted:0\nform-cli-remote-attempts:0\nform-cli-remote-accepted:0\nform-cli-exhausted:0")
                            (fnr-render-selection
                                (fag-generate
                                    question
                                    (anl-refusal question)
                                    "ollama run form-llama-vital-ground-prompted:latest --hidethinking --nowordwrap"
                                    "ollama run qwen2.5:72b --hidethinking --nowordwrap"
                                    "claude -p"))))
                    "usage: generate <inquiry> | build <code inquiry> | instruct-build <goal> | carrier-probe | quit"))))))

    (defn fcs-repl ()
        (do
            (let line (read_line))
            (if (lt line 0) ""
                (if (str_eq (fcs-verb line) "quit") ""
                    (do
                        (print_str (fcs-respond line))
                        (fcs-repl))))))

    (fcs-repl))
