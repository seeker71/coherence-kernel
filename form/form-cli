#!/bin/sh
# form-cli — thin door into the current Form source recipe.
#
# Runtime meaning lives in form-stdlib/form-cli-repl.fk and executes on the one
# repository fkwu.  This launcher deliberately carries no generated table and
# no embedded program image; source freshness and unit imports are observed by
# fkwu on every opening.

set -eu

form_cli_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
form_repo_dir=$(CDPATH= cd -- "$form_cli_dir/.." && pwd)

# The BML authority lowers in memory and reaches its own `.bml.fkb` cache.
# No generated source companion is a launch prerequisite. This warm-up cell's
# own voice (its readiness line and its fkwu-native verdict) is diagnostic,
# not the caller's answer -- it goes to stderr so stdout carries only the
# real REPL response below.
"$form_repo_dir/fkwu" "$form_cli_dir/form-stdlib/form-cli-bml-cache-run.fk" 1>&2

exec "$form_repo_dir/fkwu" \
    "$form_cli_dir/form-stdlib/form-cli-repl.fk" "$@"
