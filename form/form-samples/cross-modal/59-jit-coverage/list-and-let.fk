; Chained binding and list behavior. Native compilation uses ./fkwu.
(do
    (let a 7)
    (let b 11)
    (let c (add a b))
    (let d (mul c 2))
    (print "let-chain:" a b c d)
    (let xs (list a b c d))
    (print "list-len:" (len xs))
    (print "list-head:" (head xs))
    (defn sum-pair (x y)
        (do
            (let s (add x y))
            (mul s 2)))
    (let p1 (sum-pair a b))
    (let p2 (sum-pair c d))
    (print "sum-pair-results:" p1 p2)
    (print "compile-attempted:" (if (ge compiled 0) 1 0))
    (let p3 (sum-pair 100 200))
    (let p4 (sum-pair 1 1))
    (print "post-jit:" p3 p4)
    (add (if (eq a 7)   1 0)
    (add (if (eq d 36)  1 0)
    (add (if (eq (len xs) 4) 1 0)
    (add (if (eq p1 36) 1 0)
    (add (if (eq p2 108) 1 0)
         (if (eq p3 600) 1 0)))))))
