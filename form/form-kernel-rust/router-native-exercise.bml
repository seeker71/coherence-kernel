// Actual local routing exercise. The outer runner owns the process group.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/router-proof-lifecycle.bml
section [form.bml] {
 class RouterNativeExercise {
 def rpe-run() {
 let job = read_line();
 let owner = rp-owner(job);
 let upstream = rpc-fixture(owner, "upstream-close", "close");
 rpl-refusal(owner, head(upstream));
 rpc-basic(owner, head(upstream));
 rpc-shapes(owner, head(upstream));
 rpl-proof(owner, head(upstream));
 rpl-keep-timing(owner);
 rpl-reuse(owner);
 rpl-deadline(owner);
 rpl-concurrency(owner);
 let closed = append(record_get(owner, "released"), rp-stop-all(record_get(owner, "children")));
 rp-save(rp-path(job, "resources.json"), json-node-array(rp-resource-rows(closed)));
 let released = and(rp-resources-closed(closed), and(gt(len(closed), 0), eq(len(closed), record_get(owner, "started"))));
 rp-check(owner, "owned-processes-released", json-node-int(record_get(owner, "started")), json-node-int(len(closed)), released);
 rp-save(rp-path(job, "observations.json"), json-node-array(reverse(record_get(owner, "rows"))));
 if eq(record_get(owner, "failed"), 0) then 1 else form_error("native routing observation refused");
 }
 }
 rpe-run();
}
