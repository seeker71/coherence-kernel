// qwen35-dense-mm.fk — the batched Q8_0 matmul for a SHORT span (8 or 16 tokens): the matrix-unit check of a speculative step.
//
// The lane's 64-row x 32-token kernel (q38-mm64-msl) leaves three quarters of its token columns empty at 8 tokens. Here the output tile is
// rt rows x tn tokens (rt = 64, 32 or 16; tn = 8 or 16), 2 * rt threads (two a weight row): each simdgroup owns 16 rows x tn tokens in
// 2 * tn/8 accumulators. A K step is kb Q8_0 blocks (kb * 32 k) so the two barriers of a step serve more arithmetic, and the next step's
// loads wait in registers while the matrices compute on the current one. A small rt gives a tensor with few rows (the FFN down, 5120)
// more groups than the GPU has cores. The operands stay float (d * q is exact in fp32) and the accumulation chain is the 64 x 32 kernel's
// (the same 8-wide MMA over the same K order), so the output is that kernel's bits.
import native/metal/qwen35-dense-token-handle.fk;
section [form.bml] {
    def q38m-cat(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + q38m-cat(parts[1:]));
    def q38m-rep(n, i, f) = i >= n ? [] : cons(f(i), q38m-rep(n, i + 1, f));
    def q38m-repc(n, f) = q38m-cat(q38m-rep(n, 0, f));
    // float4 loads of the activations a thread makes a K step (the span's tn tokens x kb * 8 float4 over 2 * rt threads)
    def q38m-xn(tn, kb, rt) = (tn * kb * 8 + 2 * rt - 1) / (2 * rt);
    def q38m-xs-stride(kb) = kb * 32 + 4;
    def q38m-decl(tn, kb, rt) = q38m-cat([q38m-repc(kb, (b) => q38m-cat(["float d", b.str(), " = 0.0f; char4 w", b.str(), "0 = char4(0); char4 w", b.str(), "1 = char4(0); char4 w", b.str(), "2 = char4(0); char4 w", b.str(), "3 = char4(0); "])), q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["float4 xr", j.str(), " = float4(0.0f); "]))]);
    // the loads of K step `step` (an MSL expression) into the registers: this thread's row's kb blocks, and its share of the tn tokens' activations
    def q38m-load-w(kb, step) = q38m-repc(kb, (b) => q38m-cat(["{ uint wb = (", step, ") * ", kb.str(), "u + ", b.str(), "u; if (wrow < rows) { ulong bo = ((ulong)wrow * (ulong)nb + (ulong)wb) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); d", b.str(), " = float(as_type<half>(h)); device const uchar* qs = qb + bo + 2ul + (ulong)(whalf * 16u); w", b.str(), "0 = char4(*(device const packed_char4*)(qs)); w", b.str(), "1 = char4(*(device const packed_char4*)(qs + 4)); w", b.str(), "2 = char4(*(device const packed_char4*)(qs + 8)); w", b.str(), "3 = char4(*(device const packed_char4*)(qs + 12)); } else { d", b.str(), " = 0.0f; w", b.str(), "0 = char4(0); w", b.str(), "1 = char4(0); w", b.str(), "2 = char4(0); w", b.str(), "3 = char4(0); } } "]));
    def q38m-load-x(tn, kb, rt, step) = q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["{ uint xi = lt + ", (2 * rt * j).str(), "u; xr", j.str(), " = float4(0.0f); if (xi < ", (tn * kb * 8).str(), "u) { uint tk = xi / ", (kb * 8).str(), "u; uint kq = xi - tk * ", (kb * 8).str(), "u; uint tt = t0 + tk; if (tt < ntok) { xr", j.str(), " = *(device const float4*)(x + (ulong)tt * (ulong)cols + (ulong)(", step, ") * ", (kb * 32).str(), "ul + (ulong)(kq * 4u)); } } } "]));
    def q38m-load(tn, kb, rt, step) = q38m-cat([q38m-load-w(kb, step), q38m-load-x(tn, kb, rt, step)]);
    // registers to threadgroup memory: the weights dequantized d * q into float rows [row][k] of stride kb*32+4, the activations [token][k]
    def q38m-wcomp(b, blk, c) = q38m-cat(["d", b.str(), " * float(w", b.str(), blk.str(), ".", c, ")"]);
    def q38m-store-w(kb) = q38m-repc(kb, (b) => q38m-cat(["{ threadgroup float4* wp = (threadgroup float4*)(ws + rl * ", q38m-xs-stride(kb).str(), "u + ", (b * 32).str(), "u + whalf * 16u); ", q38m-repc(4, (blk) => q38m-cat(["wp[", blk.str(), "] = float4(", q38m-wcomp(b, blk, "x"), ", ", q38m-wcomp(b, blk, "y"), ", ", q38m-wcomp(b, blk, "z"), ", ", q38m-wcomp(b, blk, "w"), "); "])), "} "]));
    def q38m-store-x(tn, kb, rt) = q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["{ uint xi = lt + ", (2 * rt * j).str(), "u; if (xi < ", (tn * kb * 8).str(), "u) { uint tk = xi / ", (kb * 8).str(), "u; uint kq = xi - tk * ", (kb * 8).str(), "u; *(threadgroup float4*)(xs + tk * ", q38m-xs-stride(kb).str(), "u + kq * 4u) = xr", j.str(), "; } } "]));
    def q38m-mma(tn, kb) = q38m-cat(["for (uint ks = 0u; ks < ", (kb * 4).str(), "u; ks++) { ", q38m-repc(tn / 8, (i) => q38m-cat(["metal::simdgroup_float8x8 a", i.str(), "; metal::simdgroup_load(a", i.str(), ", xs + ", (i * 8 * q38m-xs-stride(kb)).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), "); "])), q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_float8x8 b", j.str(), "; metal::simdgroup_load(b", j.str(), ", ws + (sg * 16u + ", (j * 8).str(), "u) * ", q38m-xs-stride(kb).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), ", ulong2(0, 0), true); "])), q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_multiply_accumulate(acc", i.str(), j.str(), ", a", i.str(), ", b", j.str(), ", acc", i.str(), j.str(), "); "]))), "} "]);
    // fz = 1: the residual add rides the epilogue (y = res + the product: the add the lane runs as its own dispatch, the same float add); the
    // residual's buffer is the fourth, so the four constants move up one
    def q38m-name(tn, kb, rt, fz) = q38m-cat(["form_q38_mm", tn.str(), "_", kb.str(), "_", rt.str(), fz == 1 ? "_r" : ""]);
    def q38m-sig(fz) = q38m-cat([" (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], ", fz == 1 ? "device const float* res [[buffer(3)]], " : "", "constant uint& rows [[buffer(", (3 + fz).str(), ")]], constant uint& cols [[buffer(", (4 + fz).str(), ")]], constant uint& ntok [[buffer(", (5 + fz).str(), ")]], constant uint& ystride [[buffer(", (6 + fz).str(), ")]], "]);
    def q38m-msl(tn, kb, rt, fz) = q38m-cat(["kernel void ", q38m-name(tn, kb, rt, fz), q38m-sig(fz), "uint gr [[threadgroup_position_in_grid]], uint lt [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]]) { threadgroup float ws[", (rt * q38m-xs-stride(kb)).str(), "]; threadgroup float xs[", (tn * q38m-xs-stride(kb)).str(), "]; uint tilesN = (rows + ", (rt - 1).str(), "u) / ", rt.str(), "u; uint tgx = gr % tilesN; uint tgy = gr / tilesN; uint n0 = tgx * ", rt.str(), "u; uint t0 = tgy * ", tn.str(), "u; ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_float8x8 acc", i.str(), j.str(), " = metal::simdgroup_float8x8(0.0f); "]))), "uint rl = lt >> 1; uint whalf = lt & 1u; uint wrow = n0 + rl; uint nb = cols / 32u; uint nstep = nb / ", kb.str(), "u; ", q38m-decl(tn, kb, rt), q38m-load(tn, kb, rt, "0u"), " for (uint kb = 0u; kb < nstep; kb++) { ", q38m-store-w(kb), q38m-store-x(tn, kb, rt), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (kb + 1u < nstep) { ", q38m-load(tn, kb, rt, "(kb + 1u)"), "} ", q38m-mma(tn, kb), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_store(acc", i.str(), j.str(), ", ws + ", (i * 8 * rt).str(), "u + sg * 16u + ", (j * 8).str(), "u, ", rt.str(), "); "]))), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); uint col = lt & ", (rt - 1).str(), "u; uint trow = lt / ", rt.str(), "u; for (uint t = trow; t < ", tn.str(), "u; t += 2u) { uint tt = t0 + t; uint n = n0 + col; if (tt < ntok && n < rows) { y[(ulong)tt * (ulong)ystride + (ulong)n] = ", fz == 1 ? "res[(ulong)tt * (ulong)ystride + (ulong)n] + " : "", "ws[t * ", rt.str(), "u + col]; } } }"]);
    // ── the half-operand twin (the field's verify numerics: llama.cpp's mul_mm and Splash feed the matrix unit halves) ──
    // The weights are staged as half(d * q) and the activations as half(x); the matrices are simdgroup_half8x8 and the accumulators float, so the
    // sums keep fp32 and only the two operands round (2^-11 each: a relative error of a few 1e-4 on a projection). The output tile leaves through
    // the same threadgroup memory read back as floats.
    def q38m-hstore-w(kb) = q38m-repc(kb, (b) => q38m-cat(["{ threadgroup half4* wp = (threadgroup half4*)(ws + rl * ", q38m-xs-stride(kb).str(), "u + ", (b * 32).str(), "u + whalf * 16u); ", q38m-repc(4, (blk) => q38m-cat(["wp[", blk.str(), "] = half4(float4(", q38m-wcomp(b, blk, "x"), ", ", q38m-wcomp(b, blk, "y"), ", ", q38m-wcomp(b, blk, "z"), ", ", q38m-wcomp(b, blk, "w"), ")); "])), "} "]));
    def q38m-hstore-x(tn, kb, rt) = q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["{ uint xi = lt + ", (2 * rt * j).str(), "u; if (xi < ", (tn * kb * 8).str(), "u) { uint tk = xi / ", (kb * 8).str(), "u; uint kq = xi - tk * ", (kb * 8).str(), "u; *(threadgroup half4*)(xs + tk * ", q38m-xs-stride(kb).str(), "u + kq * 4u) = half4(xr", j.str(), "); } } "]));
    def q38m-hmma(tn, kb) = q38m-cat(["for (uint ks = 0u; ks < ", (kb * 4).str(), "u; ks++) { ", q38m-repc(tn / 8, (i) => q38m-cat(["metal::simdgroup_half8x8 a", i.str(), "; metal::simdgroup_load(a", i.str(), ", xs + ", (i * 8 * q38m-xs-stride(kb)).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), "); "])), q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_half8x8 b", j.str(), "; metal::simdgroup_load(b", j.str(), ", ws + (sg * 16u + ", (j * 8).str(), "u) * ", q38m-xs-stride(kb).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), ", ulong2(0, 0), true); "])), q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_multiply_accumulate(acc", i.str(), j.str(), ", a", i.str(), ", b", j.str(), ", acc", i.str(), j.str(), "); "]))), "} "]);
    def q38m-hname(tn, kb, rt) = q38m-cat(["form_q38_mmh", tn.str(), "_", kb.str(), "_", rt.str()]);
    def q38m-hmsl(tn, kb, rt) = q38m-cat(["kernel void ", q38m-hname(tn, kb, rt), q38m-sig(0), "uint gr [[threadgroup_position_in_grid]], uint lt [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]]) { threadgroup half ws[", (rt * q38m-xs-stride(kb)).str(), "]; threadgroup half xs[", (tn * q38m-xs-stride(kb)).str(), "]; uint tilesN = (rows + ", (rt - 1).str(), "u) / ", rt.str(), "u; uint tgx = gr % tilesN; uint tgy = gr / tilesN; uint n0 = tgx * ", rt.str(), "u; uint t0 = tgy * ", tn.str(), "u; ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_float8x8 acc", i.str(), j.str(), " = metal::simdgroup_float8x8(0.0f); "]))), "uint rl = lt >> 1; uint whalf = lt & 1u; uint wrow = n0 + rl; uint nb = cols / 32u; uint nstep = nb / ", kb.str(), "u; ", q38m-decl(tn, kb, rt), q38m-load(tn, kb, rt, "0u"), " for (uint kb = 0u; kb < nstep; kb++) { ", q38m-hstore-w(kb), q38m-hstore-x(tn, kb, rt), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (kb + 1u < nstep) { ", q38m-load(tn, kb, rt, "(kb + 1u)"), "} ", q38m-hmma(tn, kb), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } threadgroup float* wo = (threadgroup float*)ws; ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_store(acc", i.str(), j.str(), ", wo + ", (i * 8 * rt).str(), "u + sg * 16u + ", (j * 8).str(), "u, ", rt.str(), "); "]))), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); uint col = lt & ", (rt - 1).str(), "u; uint trow = lt / ", rt.str(), "u; for (uint t = trow; t < ", tn.str(), "u; t += 2u) { uint tt = t0 + t; uint n = n0 + col; if (tt < ntok && n < rows) { y[(ulong)tt * (ulong)ystride + (ulong)n] = wo[t * ", rt.str(), "u + col]; } } }"]);
    def q38m-hvariants() = [[8, 1, 64], [8, 2, 64], [8, 1, 32], [8, 1, 16]];
    def q38m-hmsl-go(vs) = (Comparable) len(vs) == 0 ? "" : ((String) q38m-hmsl(vs[0][0], vs[0][1], vs[0][2]) + q38m-hmsl-go(vs[1:]));
    def q38m-hpipes-go(msl, vs) = (Comparable) len(vs) == 0 ? [] : cons(metal_pipeline(msl, q38m-hname(vs[0][0], vs[0][1], vs[0][2])), q38m-hpipes-go(msl, vs[1:]));
    // ── the fragment kernels: the weights never visit threadgroup memory ──
    // At eight tokens every weight element meets exactly one MMA, so staging the weights through threadgroup memory (store, barrier, transposed
    // load) is pure overhead. Here each lane DEQUANTIZES ITS OWN FRAGMENT: simdgroup_float8x8::thread_elements() puts element (row, column) of an 8x8
    // matrix on lane l at row = (l >> 4) * 4 + ((l >> 1) & 3), columns (l >> 3 & 1) * 4 + (l & 1) * 2 and the next one (read on this GPU by
    // observe/q38-frag-probe.bml). The weight tile is the A operand (8 rows x 8 k): a lane's row is one weight row and its column pair two k, so with
    // k permuted inside a Q8_0 block (the lane quad cq holds k = 8 cq + 2 ks + e at step ks, e = 0, 1) the eight int8 it needs are ONE contiguous
    // 8-byte run of its row. The activations are the B operand (8 k x 8 tokens) read straight from the device by the same permutation (the lane's
    // fragment row is its k, its column pair two tokens): no threadgroup memory, no barrier in the K loop. A simdgroup owns ts*8 rows; sl K slices
    // (interleaved blocks) run on sl simdgroups of one threadgroup over the same rows and meet in threadgroup memory at the end in slice order.
    // The next block's loads are issued before this block's MMAs.
    def q38f-name(ts, sgr, sl, fz) = q38m-cat(["form_q38_fmm", ts.str(), "_", sgr.str(), "_", sl.str(), fz == 1 ? "_r" : ""]);
    def q38f-ld(ts, p, kbx) = q38m-cat([q38m-repc(ts, (t) => q38m-cat(["{ device const uchar* bp = wp", t.str(), " + (ulong)(", kbx, ") * 34ul; ", p, "d", t.str(), " = float(as_type<half>(*(device const ushort*)bp)); ", p, "a", t.str(), " = char4(*(device const packed_char4*)(bp + 2ul + (ulong)(8u * cq))); ", p, "c", t.str(), " = char4(*(device const packed_char4*)(bp + 6ul + (ulong)(8u * cq))); } "])), q38m-repc(4, (ks) => q38m-cat([p, "b", ks.str(), "0 = v0 ? xp0[(ulong)(", kbx, ") * 32ul + kofs + ", (2 * ks).str(), "u] : 0.0f; ", p, "b", ks.str(), "1 = v1 ? xp1[(ulong)(", kbx, ") * 32ul + kofs + ", (2 * ks).str(), "u] : 0.0f; "]))]);
    def q38f-decl(ts, p) = q38m-cat([q38m-repc(ts, (t) => q38m-cat(["float ", p, "d", t.str(), " = 0.0f; char4 ", p, "a", t.str(), " = char4(0); char4 ", p, "c", t.str(), " = char4(0); "])), q38m-repc(4, (ks) => q38m-cat(["float ", p, "b", ks.str(), "0 = 0.0f; float ", p, "b", ks.str(), "1 = 0.0f; "]))]);
    def q38f-copy(ts) = q38m-cat([q38m-repc(ts, (t) => q38m-cat(["d", t.str(), " = nd", t.str(), "; a", t.str(), " = na", t.str(), "; c", t.str(), " = nc", t.str(), "; "])), q38m-repc(4, (ks) => q38m-cat(["b", ks.str(), "0 = nb", ks.str(), "0; b", ks.str(), "1 = nb", ks.str(), "1; "]))]);
    def q38f-comp(i) = (i % 4 == 0 ? "x" : (i % 4 == 1 ? "y" : (i % 4 == 2 ? "z" : "w")));
    def q38f-qel(t, i) = q38m-cat([i < 4 ? "a" : "c", t.str(), ".", q38f-comp(i)]);
    def q38f-mma(ts) = q38m-repc(4, (ks) => q38m-cat(["{ metal::simdgroup_float8x8 bm; bm.thread_elements()[0] = b", ks.str(), "0; bm.thread_elements()[1] = b", ks.str(), "1; ", q38m-repc(ts, (t) => q38m-cat(["{ metal::simdgroup_float8x8 am; am.thread_elements()[0] = d", t.str(), " * float(", q38f-qel(t, 2 * ks), "); am.thread_elements()[1] = d", t.str(), " * float(", q38f-qel(t, 2 * ks + 1), "); metal::simdgroup_multiply_accumulate(acc", t.str(), ", am, bm, acc", t.str(), "); } "])), "} "]));
    def q38f-epi1(ts, fz) = q38m-repc(ts, (t) => q38m-cat(["{ uint r = n0 + ", (8 * t).str(), "u + mr; if (r < rows) { if (v0) { y[(ulong)c0 * (ulong)ystride + (ulong)r] = ", fz == 1 ? "res[(ulong)c0 * (ulong)ystride + (ulong)r] + " : "", "acc", t.str(), ".thread_elements()[0]; } if (v1) { y[(ulong)(c0 + 1u) * (ulong)ystride + (ulong)r] = ", fz == 1 ? "res[(ulong)(c0 + 1u) * (ulong)ystride + (ulong)r] + " : "", "acc", t.str(), ".thread_elements()[1]; } } } "]));
    def q38f-epis(ts, sgr, sl, fz) = q38m-cat([q38m-repc(ts, (t) => q38m-cat(["metal::simdgroup_store(acc", t.str(), ", red + ((sgid * ", ts.str(), "u + ", t.str(), "u) * 64u), 8); "])), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); for (uint i = lt; i < ", (sgr * ts * 64).str(), "u; i += ", (32 * sgr * sl).str(), "u) { uint rgt = i >> 6; uint rem = i & 63u; uint m = rem >> 3; uint n = rem & 7u; uint r = n0tg + rgt * 8u + m; float s = 0.0f; ", q38m-repc(sl, (s) => q38m-cat(["s = s + red[((", (s * sgr).str(), "u * ", ts.str(), "u + rgt) * 64u) + rem]; "])), "if (r < rows && n < ntok) { y[(ulong)n * (ulong)ystride + (ulong)r] = ", fz == 1 ? "res[(ulong)n * (ulong)ystride + (ulong)r] + " : "", "s; } } "]);
    def q38f-msl(ts, sgr, sl, fz) = q38m-cat(["kernel void ", q38f-name(ts, sgr, sl, fz), q38m-sig(fz), "uint gr [[threadgroup_position_in_grid]], uint lt [[thread_index_in_threadgroup]], uint sgid [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) { ", sl > 1 ? q38m-cat(["threadgroup float red[", (sgr * sl * ts * 64).str(), "]; "]) : "", "uint rg = sgid % ", sgr.str(), "u; uint sl = sgid / ", sgr.str(), "u; uint n0tg = gr * ", (sgr * ts * 8).str(), "u; uint n0 = n0tg + rg * ", (ts * 8).str(), "u; uint nb = cols / 32u; uint mr = (lane >> 4) * 4u + ((lane >> 1) & 3u); uint cq = ((lane >> 3) & 1u) * 2u + (lane & 1u); uint c0 = cq * 2u; uint kofs = 8u * (mr >> 1) + (mr & 1u); bool v0 = c0 < ntok; bool v1 = (c0 + 1u) < ntok; device const float* xp0 = x + (ulong)c0 * (ulong)cols; device const float* xp1 = x + (ulong)(c0 + 1u) * (ulong)cols; ", q38m-repc(ts, (t) => q38m-cat(["uint wr", t.str(), " = n0 + ", (8 * t).str(), "u + mr; if (wr", t.str(), " >= rows) { wr", t.str(), " = rows - 1u; } device const uchar* wp", t.str(), " = qb + (ulong)wr", t.str(), " * (ulong)nb * 34ul; metal::simdgroup_float8x8 acc", t.str(), " = metal::simdgroup_float8x8(0.0f); "])), q38f-decl(ts, ""), q38f-decl(ts, "n"), "if (sl < nb) { ", q38f-ld(ts, "", "sl"), "} for (uint kbk = sl; kbk < nb; kbk += ", sl.str(), "u) { if (kbk + ", sl.str(), "u < nb) { ", q38f-ld(ts, "n", "(kbk + " + (sl.str() + "u)")), "} ", q38f-mma(ts), q38f-copy(ts), "} ", sl > 1 ? q38f-epis(ts, sgr, sl, fz) : q38f-epi1(ts, fz), "}"]);
    // the variants [ts, sgr, sl, fz]
    def q38f-variants() = [[2, 4, 1, 0], [4, 2, 1, 0], [2, 2, 1, 0], [2, 1, 4, 0], [2, 2, 2, 0], [4, 1, 4, 0], [2, 4, 1, 1], [2, 1, 4, 1], [2, 2, 2, 1], [4, 1, 4, 1]];
    def q38f-msl-go(vs) = (Comparable) len(vs) == 0 ? "" : ((String) q38f-msl(vs[0][0], vs[0][1], vs[0][2], vs[0][3]) + q38f-msl-go(vs[1:]));
    def q38f-pipes-go(msl, vs) = (Comparable) len(vs) == 0 ? [] : cons(metal_pipeline(msl, q38f-name(vs[0][0], vs[0][1], vs[0][2], vs[0][3])), q38f-pipes-go(msl, vs[1:]));
    def q38f-groups(rows, ts, sgr) = (rows + sgr * ts * 8 - 1) / (sgr * ts * 8);
    // the variants [tn, kb, rt], in pipeline order. (kb 4 at rt 64 would hold 64 x 132 floats of weights: past the 32 KB of threadgroup memory.)
    // A check span is at most 8 tokens (the spec scratch holds 8 logit rows), so the 16-token tile (read in the lab: 16 tokens cost ~17% more than 8) is not carried.
    def q38m-variants() = [[8, 1, 64, 0], [8, 2, 64, 0], [8, 1, 32, 0], [8, 2, 32, 0], [8, 1, 16, 0], [8, 2, 16, 0], [8, 1, 64, 1], [8, 1, 32, 1], [8, 2, 64, 1], [8, 2, 32, 1], [8, 1, 16, 1], [8, 2, 16, 1]];
    def q38m-msl-go(vs) = (Comparable) len(vs) == 0 ? "" : ((String) q38m-msl(vs[0][0], vs[0][1], vs[0][2], vs[0][3]) + q38m-msl-go(vs[1:]));
    def q38m-text() = "#include <metal_stdlib>\n" + q38m-msl-go(q38m-variants());
    def q38m-pipes-go(msl, vs) = (Comparable) len(vs) == 0 ? [] : cons(metal_pipeline(msl, q38m-name(vs[0][0], vs[0][1], vs[0][2], vs[0][3])), q38m-pipes-go(msl, vs[1:]));
    def q38m-pipes(msl) = q38m-pipes-go(msl, q38m-variants());
    def q38m-slot-go(vs, i, tn, kb, rt, fz) = (Comparable) len(vs) == 0 ? -1 : ((Comparable) vs[0][0] == tn && vs[0][1] == kb && vs[0][2] == rt && vs[0][3] == fz ? i : q38m-slot-go(vs[1:], i + 1, tn, kb, rt, fz));
    def q38m-slot(tn, kb, rt, fz) = q38m-slot-go(q38m-variants(), 0, tn, kb, rt, fz);
    def q38m-groups(rows, ntok, tn, rt) = (ntok + tn - 1) / tn * ((rows + rt - 1) / rt);
    // one matmul over the span through the variant (tn, kb, rt, 0) of the list `ms` (q38m-pipes order)
    def q38m-run(ms, tv, xh, yh, ntok, ystride, barrier, tn, kb, rt) = metal_enqueue(ms[q38m-slot(tn, kb, rt, 0)], md-bind16([kth-tv-h(tv), xh, yh], [kth-tv-r(tv), kth-tv-c(tv), ntok, ystride], 2 * rt, 0, 1, barrier), q38m-groups(kth-tv-r(tv), ntok, tn, rt));
    // the same with the residual add in the epilogue: y = res + W x
    def q38m-run-res(ms, tv, xh, yh, resh, ntok, ystride, barrier, tn, kb, rt) = metal_enqueue(ms[q38m-slot(tn, kb, rt, 1)], md-bind16([kth-tv-h(tv), xh, yh, resh], [kth-tv-r(tv), kth-tv-c(tv), ntok, ystride], 2 * rt, 0, 1, barrier), q38m-groups(kth-tv-r(tv), ntok, tn, rt));
    0;
}
