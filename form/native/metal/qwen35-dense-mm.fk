// qwen35-dense-mm.fk — the batched Q8_0 matmul for a SHORT span (8 or 16 tokens): the matrix-unit check of a speculative step.
//
// The lane's 64-row x 32-token kernel (q38-mm64-msl) leaves three quarters of its token columns empty at 8 tokens. Here the output tile is
// rt rows x tn tokens (rt = 64, 32 or 16; tn = 8 or 16), 2 * rt threads (two a weight row): each simdgroup owns 16 rows x tn tokens in
// 2 * tn/8 accumulators. A K step is kb Q8_0 blocks (kb * 32 k) so the two barriers of a step serve more arithmetic, and the next step's
// loads wait in registers while the matrices compute on the current one. A small rt gives a tensor with few rows (the FFN down, 5120)
// more groups than the GPU has cores. The operands stay float (d * q is exact in fp32) and the accumulation chain is the 64 x 32 kernel's
// (the same 8-wide MMA over the same K order), so the output is that kernel's bits.
import native/metal/qwen35-dense-token-handle.fk;
section [form.bml] {
    def q38m-cat(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + q38m-cat(parts[1:]));
    def q38m-rep(n, i, f) = i >= n ? [] : cons(f(i), q38m-rep(n, i + 1, f));
    def q38m-repc(n, f) = q38m-cat(q38m-rep(n, 0, f));
    // float4 loads of the activations a thread makes a K step (the span's tn tokens x kb * 8 float4 over 2 * rt threads)
    def q38m-xn(tn, kb, rt) = (tn * kb * 8 + 2 * rt - 1) / (2 * rt);
    def q38m-xs-stride(kb) = kb * 32 + 4;
    def q38m-decl(tn, kb, rt) = q38m-cat([q38m-repc(kb, (b) => q38m-cat(["float d", b.str(), " = 0.0f; char4 w", b.str(), "0 = char4(0); char4 w", b.str(), "1 = char4(0); char4 w", b.str(), "2 = char4(0); char4 w", b.str(), "3 = char4(0); "])), q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["float4 xr", j.str(), " = float4(0.0f); "]))]);
    // the loads of K step `step` (an MSL expression) into the registers: this thread's row's kb blocks, and its share of the tn tokens' activations
    def q38m-load-w(kb, step) = q38m-repc(kb, (b) => q38m-cat(["{ uint wb = (", step, ") * ", kb.str(), "u + ", b.str(), "u; if (wrow < rows) { ulong bo = ((ulong)wrow * (ulong)nb + (ulong)wb) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); d", b.str(), " = float(as_type<half>(h)); device const uchar* qs = qb + bo + 2ul + (ulong)(whalf * 16u); w", b.str(), "0 = char4(*(device const packed_char4*)(qs)); w", b.str(), "1 = char4(*(device const packed_char4*)(qs + 4)); w", b.str(), "2 = char4(*(device const packed_char4*)(qs + 8)); w", b.str(), "3 = char4(*(device const packed_char4*)(qs + 12)); } else { d", b.str(), " = 0.0f; w", b.str(), "0 = char4(0); w", b.str(), "1 = char4(0); w", b.str(), "2 = char4(0); w", b.str(), "3 = char4(0); } } "]));
    def q38m-load-x(tn, kb, rt, step) = q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["{ uint xi = lt + ", (2 * rt * j).str(), "u; xr", j.str(), " = float4(0.0f); if (xi < ", (tn * kb * 8).str(), "u) { uint tk = xi / ", (kb * 8).str(), "u; uint kq = xi - tk * ", (kb * 8).str(), "u; uint tt = t0 + tk; if (tt < ntok) { xr", j.str(), " = *(device const float4*)(x + (ulong)tt * (ulong)cols + (ulong)(", step, ") * ", (kb * 32).str(), "ul + (ulong)(kq * 4u)); } } } "]));
    def q38m-load(tn, kb, rt, step) = q38m-cat([q38m-load-w(kb, step), q38m-load-x(tn, kb, rt, step)]);
    // registers to threadgroup memory: the weights dequantized d * q into float rows [row][k] of stride kb*32+4, the activations [token][k]
    def q38m-wcomp(b, blk, c) = q38m-cat(["d", b.str(), " * float(w", b.str(), blk.str(), ".", c, ")"]);
    def q38m-store-w(kb) = q38m-repc(kb, (b) => q38m-cat(["{ threadgroup float4* wp = (threadgroup float4*)(ws + rl * ", q38m-xs-stride(kb).str(), "u + ", (b * 32).str(), "u + whalf * 16u); ", q38m-repc(4, (blk) => q38m-cat(["wp[", blk.str(), "] = float4(", q38m-wcomp(b, blk, "x"), ", ", q38m-wcomp(b, blk, "y"), ", ", q38m-wcomp(b, blk, "z"), ", ", q38m-wcomp(b, blk, "w"), "); "])), "} "]));
    def q38m-store-x(tn, kb, rt) = q38m-repc(q38m-xn(tn, kb, rt), (j) => q38m-cat(["{ uint xi = lt + ", (2 * rt * j).str(), "u; if (xi < ", (tn * kb * 8).str(), "u) { uint tk = xi / ", (kb * 8).str(), "u; uint kq = xi - tk * ", (kb * 8).str(), "u; *(threadgroup float4*)(xs + tk * ", q38m-xs-stride(kb).str(), "u + kq * 4u) = xr", j.str(), "; } } "]));
    def q38m-mma(tn, kb) = q38m-cat(["for (uint ks = 0u; ks < ", (kb * 4).str(), "u; ks++) { ", q38m-repc(tn / 8, (i) => q38m-cat(["metal::simdgroup_float8x8 a", i.str(), "; metal::simdgroup_load(a", i.str(), ", xs + ", (i * 8 * q38m-xs-stride(kb)).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), "); "])), q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_float8x8 b", j.str(), "; metal::simdgroup_load(b", j.str(), ", ws + (sg * 16u + ", (j * 8).str(), "u) * ", q38m-xs-stride(kb).str(), "u + ks * 8u, ", q38m-xs-stride(kb).str(), ", ulong2(0, 0), true); "])), q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_multiply_accumulate(acc", i.str(), j.str(), ", a", i.str(), ", b", j.str(), ", acc", i.str(), j.str(), "); "]))), "} "]);
    def q38m-name(tn, kb, rt) = q38m-cat(["form_q38_mm", tn.str(), "_", kb.str(), "_", rt.str()]);
    def q38m-msl(tn, kb, rt) = q38m-cat(["kernel void ", q38m-name(tn, kb, rt), " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], constant uint& ntok [[buffer(5)]], constant uint& ystride [[buffer(6)]], uint gr [[threadgroup_position_in_grid]], uint lt [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]]) { threadgroup float ws[", (rt * q38m-xs-stride(kb)).str(), "]; threadgroup float xs[", (tn * q38m-xs-stride(kb)).str(), "]; uint tilesN = (rows + ", (rt - 1).str(), "u) / ", rt.str(), "u; uint tgx = gr % tilesN; uint tgy = gr / tilesN; uint n0 = tgx * ", rt.str(), "u; uint t0 = tgy * ", tn.str(), "u; ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_float8x8 acc", i.str(), j.str(), " = metal::simdgroup_float8x8(0.0f); "]))), "uint rl = lt >> 1; uint whalf = lt & 1u; uint wrow = n0 + rl; uint nb = cols / 32u; uint nstep = nb / ", kb.str(), "u; ", q38m-decl(tn, kb, rt), q38m-load(tn, kb, rt, "0u"), " for (uint kb = 0u; kb < nstep; kb++) { ", q38m-store-w(kb), q38m-store-x(tn, kb, rt), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (kb + 1u < nstep) { ", q38m-load(tn, kb, rt, "(kb + 1u)"), "} ", q38m-mma(tn, kb), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); } ", q38m-repc(tn / 8, (i) => q38m-repc(2, (j) => q38m-cat(["metal::simdgroup_store(acc", i.str(), j.str(), ", ws + ", (i * 8 * rt).str(), "u + sg * 16u + ", (j * 8).str(), "u, ", rt.str(), "); "]))), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); uint col = lt & ", (rt - 1).str(), "u; uint trow = lt / ", rt.str(), "u; for (uint t = trow; t < ", tn.str(), "u; t += 2u) { uint tt = t0 + t; uint n = n0 + col; if (tt < ntok && n < rows) { y[(ulong)tt * (ulong)ystride + (ulong)n] = ws[t * ", rt.str(), "u + col]; } } }"]);
    // the variants [tn, kb, rt], in pipeline order. (kb 4 at rt 64 would hold 64 x 132 floats of weights: past the 32 KB of threadgroup memory.)
    // A check span is at most 8 tokens (the spec scratch holds 8 logit rows), so the 16-token tile (read in the lab: 16 tokens cost ~17% more than 8) is not carried.
    def q38m-variants() = [[8, 1, 64], [8, 2, 64], [8, 1, 32], [8, 2, 32], [8, 1, 16], [8, 2, 16]];
    def q38m-msl-go(vs) = (Comparable) len(vs) == 0 ? "" : ((String) q38m-msl(vs[0][0], vs[0][1], vs[0][2]) + q38m-msl-go(vs[1:]));
    def q38m-text() = "#include <metal_stdlib>\n" + q38m-msl-go(q38m-variants());
    def q38m-pipes-go(msl, vs) = (Comparable) len(vs) == 0 ? [] : cons(metal_pipeline(msl, q38m-name(vs[0][0], vs[0][1], vs[0][2])), q38m-pipes-go(msl, vs[1:]));
    def q38m-pipes(msl) = q38m-pipes-go(msl, q38m-variants());
    def q38m-slot-go(vs, i, tn, kb, rt) = (Comparable) len(vs) == 0 ? -1 : ((Comparable) vs[0][0] == tn && vs[0][1] == kb && vs[0][2] == rt ? i : q38m-slot-go(vs[1:], i + 1, tn, kb, rt));
    def q38m-slot(tn, kb, rt) = q38m-slot-go(q38m-variants(), 0, tn, kb, rt);
    def q38m-groups(rows, ntok, tn, rt) = (ntok + tn - 1) / tn * ((rows + rt - 1) / rt);
    // one matmul over the span through the variant (tn, kb, rt) of the list `ms` (q38m-pipes order)
    def q38m-run(ms, tv, xh, yh, ntok, ystride, barrier, tn, kb, rt) = metal_enqueue(ms[q38m-slot(tn, kb, rt)], md-bind16([kth-tv-h(tv), xh, yh], [kth-tv-r(tv), kth-tv-c(tv), ntok, ystride], 2 * rt, 0, 1, barrier), q38m-groups(kth-tv-r(tv), ntok, tn, rt));
    0;
}
