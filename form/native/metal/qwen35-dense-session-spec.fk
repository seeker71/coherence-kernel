// qwen35-dense-session-spec.fk — the DFlash2 speculative walk as the model session's own greedy walk.
//
// The probe doors (observe/q38-dflash-run.bml, q38-spec-run.bml) speak a fresh state from a prefill they run themselves. The session lane
// (form-cli-model-session.fk) holds one resident stream across many asks, so the drafter has to live in the stream: it learns the target's
// tapped hidden states WHERE THE TARGET PRODUCES THEM, in the session's own prefill (the open's prompt and every observation, q38-lm-layers-span-t),
// and in the speculative steps themselves, so no position is ever run twice and a session that already prefilled can draft at any ask.
//
// THE OWNER. One mutable record (record_new) holds what the session owns beside the target: the pipelines, the drafter (q38d-open), the spec scratch
// (q38s-open: logits, ids, the recurrent snapshots), and the walk's persistent choices. Fields:
//   on         1 while the drafter is open; 0 for a record that only names why speculation is off (reason)
//   reason     the named reason speculation is off or was left, "" while it speaks
//   committed  the drafter's context holds rows for positions [0, committed) of THIS stream (stamp: the stream's first state handle)
//   mode       "dflash" while the walk is speculative, "plain" after its measured yield fell below the plain token's (q38x-judge)
//   ema kcur   the adaptive row count's running acceptance shares and the rows it will try next (carried from ask to ask)
//   strikes    the walks in a row whose yield scored below the plain token
//   last       [steps, tokens, ms, yield per thousand of a plain token] of the last walk
// The drafter's context can only ever lower the ACCEPTANCE, never change an id: every id a walk says is the argmax of the verify logits at its
// position, and a draft the target does not repeat changes nothing (state restored from the snapshots). The only thing that must be exact is the
// target's own state, which the walk leaves where the plain walk would: KV rows for the positions before the pending token, the recurrent state
// after the token before it, the pending token held (never in KV), a stop id kept out of the speech and held as pending.
//
// THE WALK (q38x-walk) is the plain walk's contract (fcms-walk-by) with its speculative step: the ids said (the pending token first, a stop id never),
// the pending token and its position, whether it stopped. A step from the pending token x at p checks k drafts in ONE weight pass; the accepted run
// d1..dm and the verified successor y are the stream's next tokens; the rows of x, d1..dm entered the KV and the drafter's context, the state is put back
// to after dm (restore from the snapshot of the span's token m). A stop id inside an accepted run ends the walk there: pending = that id, KV and state
// as after the token before it (a restore to that token's snapshot), the rows before it committed to the drafter. The row count is capped so a step never
// verifies past the tokens still wanted (k <= wanted - 2) or past the context (p + k < maxpos): the last tokens of a walk are checked one row at a time,
// on the same matrix-unit arithmetic (q38s-fast1, batch invariant), so the ids are the verify path's greedy decode whatever the steps' shape.
import native/metal/qwen35-dense-dflash.fk;
import form-stdlib/metal-carrier.bml;
section [form.bml] {
    def q38x-min(a, b) = a < b ? a : b;
    def q38x-max(a, b) = a > b ? a : b;
    // the rows the capture/commit buffers hold: the widest prefill slice the context was opened for, and at least the check span's eight
    def q38x-rows(ctx) = q38x-max(q38-ctx-span(ctx), 8);
    def q38x-kmax() = 7;
    def q38x-off(reason) = record_new(0,"on",0,"reason",reason,"release-handles",[]);
    def q38x-on?(o) = !nothing?(o) && (String) value_kind(o) == "record" && record_get(o, "on") == 1 ? 1 : 0;
    // what the drafter and its scratch take beside the target (the file's pages are shared and touched lazily: the head's rows and each layer's weights as they are drafted from)
    def q38x-plan(ctx,dpath,maxpos) = [q38d-plan(ctx,dpath,maxpos,q38x-rows(ctx)),q38s-verify-plan(ctx,q38x-kmax(),8)];
    def q38x-own-bytes(plan) = q38d-plan-bytes(plan[0])+q38s-plan-bytes(plan[1]);
    // ── the tap: what the session's prefill calls in its own batch ──
    def q38x-tap-capture(o, l, n) = n > record_get(o, "nr") ? 0 : q38d-capture-layer(record_get(o, "ctx")[1], record_get(o, "ctx")[2], record_get(o, "ds"), record_get(o, "dx"), l, n, 0);
    // rows pos0 .. pos0 + n enter the drafter's context; a slice that begins past the committed prefix leaves a hole, which keeps the walk plain (named)
    def q38x-tap-commit(o, n, pos0) = n > record_get(o, "nr") ? 0 : {
        q38d-commit(record_get(o, "ctx"), record_get(o, "qs"), record_get(o, "ds"), record_get(o, "dx"), n, pos0);
        pos0 <= record_get(o, "committed") ? record_set(o, "committed", pos0 + n) : 0;
        1;
    };
    def q38x-tap-go(o, phase, l, n, pos0) = phase == 0 ? q38x-tap-capture(o, l, n) : q38x-tap-commit(o, n, pos0);
    def q38x-tap(o) = q38x-on?(o) == 1 && (String) record_get(o, "mode") == "dflash" ? ((phase, l, n, pos0) => q38x-tap-go(o, phase, l, n, pos0)) : nothing();
    // a walk may begin when the drafter holds every position the stream holds, in THIS stream
    def q38x-ready-why(o, sts, pos) = q38x-on?(o) != 1 ? (String) record_get(o, "reason") : (String) record_get(o, "mode") != "dflash" ? (String) record_get(o, "reason") : len(sts) == 0 || record_get(o, "stamp") != nth(sts, 0)[0] ? "spec-off:stream-renewed" : record_get(o, "committed") != pos ? ("spec-off:drafter-context-behind:" ++ record_get(o, "committed").str() ++ "<" ++ pos.str()) : "";
    // ── the walk ──
    def q38x-first-stop(acc, stops, i) = i >= len(acc) ? -1 : (Comparable) q38-stop?(acc[i], stops) == 1 ? i : q38x-first-stop(acc, stops, i + 1);
    // the rejected rows' recurrent state put back (slot: the snapshot of the span's token after which the stream stands; -1 none) and the rows
    // the stream keeps entering the drafter's context, in one batch, settled: nothing is left pending between two calls
    def q38x-flush(ctx, qs, ds, dx, sts, sx, slot, nc, cp) = slot >= 0 || nc > 0 ? gpu-lease-turn("qwen speculative commit", () => {
        metal_batch_concurrent();
        slot >= 0 ? q38s-restore(ctx, sts, sx, slot) : 0;
        nc > 0 ? q38d-commit(ctx, qs, ds, dx, nc, cp) : 0;
        metal_sync();
        1;
    }) : 0;
    // the decode checkpoints the plain walk pulses at (1, 2, 4, 8, ...): the next one at or beyond what is said
    def q38x-pulse-next(nxt, emitted) = nxt > emitted ? nxt : q38x-pulse-next(nxt * 2, emitted);
    def q38x-pulse(pulse, st, emitted) = emitted >= st[5] ? {
        let said = pulse(emitted);
        append(append(take(5, st), [q38x-pulse-next(st[5], emitted + 1)]),drop(6,st));
    } : st;
    def q38x-progress(st,out,pending,pos,stopped) = len(st)>6 && value_kind(st[6])=="closure" ? (st[6])(out,pending,pos,stopped) : 0;
    // st = [ema, kcur, steps, tokens, ms, next pulse]; steps/tokens/ms count the steps of this walk
    def q38x-end(ctx, qs, ds, dx, sts, sx, out, pending, pos, stopped, slot, nc, cp, st) = {
        q38x-progress(st,out,pending,pos,0);
        let flushed = q38x-flush(ctx, qs, ds, dx, sts, sx, slot, nc, cp);
        q38x-progress(st,out,pending,pos,stopped);
        [out, pending, pos, stopped, take(6,st)];
    };
    def q38x-go(ctx, qs, ds, dx, sts, sx, x, p, left, stops, pulse, slot, nc, cp, out, st) = x < 0 ? q38x-end(ctx, qs, ds, dx, sts, sx, out, -1, p, 1, slot, nc, cp, st) : (Comparable) q38-stop?(x, stops) == 1 ? q38x-end(ctx, qs, ds, dx, sts, sx, out, x, p, 1, slot, nc, cp, st) : left <= 1 ? {
        let emitted=append(out,[x]);q38x-progress(st,emitted,x,p,0);
        q38x-end(ctx,qs,ds,dx,sts,sx,emitted,x,p,0,slot,nc,cp,q38x-pulse(pulse,st,len(emitted)));
    } : p >= ctx[2][18] ? q38x-end(ctx, qs, ds, dx, sts, sx, append(out, [x]), -1, p + 1, 1, slot, nc, cp, st) : q38x-step-go(ctx, qs, ds, dx, sts, sx, x, p, left, stops, pulse, slot, nc, cp, out, st);
    def q38x-step-go(ctx, qs, ds, dx, sts, sx, x, p, left, stops, pulse, slot, nc, cp, out, st) = {
        let out2 = append(out, [x]);
        q38x-progress(st,out2,x,p,0);
        let room = q38x-min(left - 2, ctx[2][18] - 1 - p);
        let keff = q38x-min(st[1], room);
        let t0 = host_monotonic_ms();
        let r = q38d-step(ctx, qs, ds, dx, sts, sx, x, p, keff, slot, nc, cp, 0);
        let dt = host_monotonic_ms() - t0;
        let d = r[0];
        let v = r[1];
        let m = q38s-accept-go(d, v, 1, keff);
        let acc = take(m, d[1:]);
        let si = q38x-first-stop(acc, stops, 0);
        let ema2 = keff == 0 ? st[0] : q38s-ema-go(st[0], m, 1, keff);
        let k2 = keff == 0 ? st[1] : q38d-next-k(ema2, st[1], q38x-kmax());
        let st2 = append([ema2, k2, st[2] + 1, st[3] + m + 1, st[4] + dt, st[5]],drop(6,st));
        si >= 0 ? q38x-end(ctx, qs, ds, dx, sts, sx, append(out2, take(si, acc)), acc[si], p + si + 1, 1, si, si + 1, p, st2) : {
            let out3 = append(out2, acc);
            q38x-progress(st2,out3,v[m],p+m+1,0);
            let st3 = q38x-pulse(pulse, st2, len(out3));
            q38x-go(ctx, qs, ds, dx, sts, sx, v[m], p + m + 1, left - 1 - m, stops, pulse, m < keff ? m : -1, m + 1, p, out3, st3);
        };
    };
    // x pending at p (the session's pending id and position), want ids to say at most, stops the session's: [ids, pending, pos, stopped, st]
    def q38x-walk(o, sts, x, p, want, stops, pulse) = {
        let st0 = [record_get(o, "ema"), record_get(o, "kcur"), 0, 0, 0, 1,record_get(o,"progress")];
        let r = q38x-go(record_get(o, "ctx"), record_get(o, "qs"), record_get(o, "ds"), record_get(o, "dx"), sts, record_get(o, "sx"), x, p, want, stops, pulse, -1, 0, 0, [], st0);
        let st = r[4];
        record_set(o, "ema", st[0]);
        record_set(o, "kcur", st[1]);
        // the rows the drafter holds are the positions the stream holds: the ones before the pending token (a walk that ended past the context has no pending token and its last position never ran)
        record_set(o, "committed", r[1] < 0 ? r[2] - 1 : r[2]);
        record_set(o, "last", [st[2], st[3], st[4], q38x-yield(st[0])]);
        record_set(o, "calls", record_get(o, "calls") + 1);
        r;
    };
    // THE YIELD, measured by the acceptance the adaptive row count already keeps (ema: the running share, in percent, of the steps that took each draft position
    // when it was tried). A step of k drafts says 100 + the first k shares of a token's worth and costs q38d-cost(k + 1) percent of a decode token (the draft, the
    // commit and a row's check, calibrated on this machine); the best k is the policy's own choice (q38d-best-go) and its score is that quotient, per thousand of a
    // plain token: a plain walk scores 1000. The speculative walk goes on while it scores above the plain token; two walks in a row below it (at least three steps each)
    // leave this stream plain for good, named: the tap stops and the plain planned step takes over. The measured wall of the steps stays in the report.
    def q38x-best-k(ema) = q38d-best-go(ema, 1, q38x-kmax(), 1, 0);
    def q38x-yield(ema) = q38d-score(ema, q38x-best-k(ema));
    def q38x-judge(o, st) = st[2] >= 3 ? {
        let y = q38x-yield(st[0]);
        let strikes = y < 1000 ? record_get(o, "strikes") + 1 : 0;
        record_set(o, "strikes", strikes);
        strikes >= 2 ? {
            record_set(o, "mode", "plain");
            record_set(o, "reason", "spec-off:yield-below-plain:" ++ y.str() ++ "/1000 over " ++ st[2].str() ++ " steps");
            0;
        } : 1;
    } : 1;
    // ── open and close ──
    def q38x-bufs-ok?(sx) = q38-handles-ok?([sx[0], sx[1], sx[2], sx[3], sx[4], sx[5], sx[6], sx[7], sx[8], sx[13]]);
    def q38x-view-handles(tv) = len(tv)>4 ? [kth-tv-h(tv),tv[4],tv[5]] : [kth-tv-h(tv)];
    def q38x-views-handles(tvs) = foldl((held,tv)=>append(held,q38x-view-handles(tv)),[],tvs);
    def q38x-alloc(owner,bytes) = mca-alloc(owner,bytes);
    def q38x-map(owner,path,offset,bytes) = mca-map(owner,path,offset,bytes);
    def q38x-admitted(handle) = q38-handle-ok?(handle) ? handle : form_error("speculative allocation or mapping refused");
    def q38x-construct-alloc(owner,bytes) {
        record_set(owner,"admission-attempt",["allocate",bytes]);
        q38x-admitted(q38x-alloc(owner,bytes));
    }
    def q38x-construct-map(owner,path,offset,bytes) {
        record_set(owner,"admission-attempt",["map",path,offset,bytes]);
        q38x-admitted(q38x-map(owner,path,offset,bytes));
    }
    def q38x-dx-handles(dx) = append(append(dx[2],foldl(append,[],dx[3])),append(q38x-views-handles(dx[1]),foldl((held,layer)=>append(held,q38x-views-handles(layer)),[],dx[0])));
    def q38x-sx-handles(sx) = append([sx[0],sx[1],sx[2],sx[3],sx[4],sx[5],sx[6],sx[7],sx[8],sx[13],sx[11][2],sx[11][3]],append(foldl(append,[],sx[9]),q38x-views-handles(append(take(4,sx[10]),sx[10][4]))));
    def q38x-unique-handles(handles) {
        let seen=record_new(0);
        filter(h=>value_kind(h)!="int" || h<=0 ? 0 : record_has(seen,h.str()) ? 0 : {record_set(seen,h.str(),1);1;},handles);
    }
    def q38x-release-handles(o) = value_kind(o)!="record" ? [] : record_has(o,"release-sources") ? filter(h=>!nothing?(q38x-release-source(o,h)),record_get(o,"release-selection")) : record_has(o,"release-handles") ? record_get(o,"release-handles") : q38x-on?(o)==1 ? q38x-unique-handles(append(q38x-dx-handles(record_get(o,"dx")),q38x-sx-handles(record_get(o,"sx")))) : [];
    // A retirement selects buffers from their original owners; it never copies
    // ownership. Interrupted release therefore leaves one authoritative list.
    def q38x-release-source(o,h) = !record_has(o,"release-sources") ? o : foldl((found,source)=>!nothing?(found) ? found : any?(held=>held==h,q38x-release-handles(source)) ? q38x-release-source(source,h) : nothing(),nothing(),record_get(o,"release-sources"));
    def q38x-owned(o) = len(q38x-release-handles(o));
    // A stopped decoder can still own buffers. Keep each unresolved handle so
    // release can resume without freeing a successful handle a second time.
    def q38x-free(owner,handle) = mca-free(owner,handle);
    def q38x-close(o) = q38x-close-owned-by(o,()=>metal_sync(),q38x-free);
    def q38x-close-by(o,settle,free) = q38x-close-owned-by(o,settle,(owner,handle)=>free(handle));
    def q38x-retain-release-tree(o) = record?(o) ? {
        if record_has(o,"release-sources") then map(q38x-retain-release-tree,record_get(o,"release-sources")) else 0;
        if !record_has(o,"release-handles") then record_set(o,"release-handles",q38x-release-handles(o)) else 0;
        o;
    } : o;
    def q38x-close-owned-by(o,settle,free) {
        q38x-retain-release-tree(o);
        let handles=q38x-release-handles(o);
        if !nil?(handles) then record_set(o,"release-handles",handles) else 0;
        mca-close-owned-by(o,settle,free);
    }
    def q38x-refuse-owned(owner,reason) {
        q38x-close(owner);
        record_set(owner,"reason",reason ++ (q38x-owned(owner)>0 ? ";release-incomplete" : ""));owner;
    }
    // the drafter at dpath for the stream context ctx (opened with at least two positions a slice), maxpos the session's: the owner record, or one that names why not.
    // The memory is the caller's to ask for first (the session glue leases it beside the target's).
    // open-ms = [the pipelines, the drafter's tensors and buffers, the scratch]: where an open's wall goes, kept in the owner for the door that reads it
    def q38x-open(ctx,dpath,maxpos) = q38x-open-owned(q38x-off("spec-opening"),ctx,dpath,maxpos,q38x-plan(ctx,dpath,maxpos));
    def q38x-open-owned(owner,ctx,dpath,maxpos,plan) = try {
        let t0 = host_monotonic_ms();
        let qs = q38s-fast1(q38s-pipes(q38s-msl()));
        let ds = q38d-pipes(q38d-msl());
        let t1 = host_monotonic_ms();
        !(q38s-pipes-ok?(qs) && q38s-pipes-ok?(ds)) ? q38x-refuse-owned(owner,"spec-off:pipelines-did-not-compile") : q38x-open-drafter(owner,ctx,qs,ds,dpath,maxpos,t1 - t0,plan);
    } catch q38x-refuse-owned(owner,"spec-off:open-interrupted:"+(record_get(owner,"admission-attempt") ?? []).str());
    def q38x-open-drafter(owner,ctx,qs,ds,dpath,maxpos,pipes-ms,plan) = {
        let t1 = host_monotonic_ms();
        let dx=q38d-open-plan(ctx,dpath,plan[0],bytes=>q38x-construct-alloc(owner,bytes),(path,offset,bytes)=>q38x-construct-map(owner,path,offset,bytes));
        record_set(owner,"dx",dx);
        let t2 = host_monotonic_ms();
        !q38d-ok?(dx) ? q38x-refuse-owned(owner,"spec-off:drafter-did-not-open") : q38x-open-scratch(owner,ctx,qs,ds,dx,maxpos,[pipes-ms,t2 - t1],plan);
    };
    def q38x-open-scratch(owner,ctx,qs,ds,dx,maxpos,open-ms,plan) = {
        let t2 = host_monotonic_ms();
        let sx=q38s-open-plan(ctx,plan[1],bytes=>q38x-construct-alloc(owner,bytes),(path,offset,bytes)=>q38x-construct-map(owner,path,offset,bytes));
        record_set(owner,"sx",sx);
        let t3 = host_monotonic_ms();
        !((Comparable) q38x-bufs-ok?(sx) == 1) ? {
            q38x-refuse-owned(owner,"spec-off:scratch-did-not-open");
        } : {
            map(pair=>record_set(owner,pair[0],pair[1]),[["reason",""],["ctx",ctx],["qs",qs],["ds",ds],["nr",q38x-rows(ctx)],["maxpos",maxpos],["committed",0],["stamp",0],["mode","dflash"],["ema",q38s-fill(q38x-kmax(),100)],["kcur",4],["strikes",0],["calls",0],["last",[0,0,0,0]],["open-ms",append(open-ms,[t3 - t2])]]);
            record_set(owner,"on",1);owner;
        };
    };
    0;
}
