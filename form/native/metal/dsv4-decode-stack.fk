; dsv4-decode-stack.fk — RUNG 14: the 43-layer DS4 decode STACK and the greedy stream, held by Form.
;
; Everything below stands on dsv4-decode-form.fk's thirteen proven rungs: the kernels are the same
; texts those rungs dispatched and checked (embed, hc broadcast/norm/split/wsum/post, the MLA chain,
; the fp8+f16 round, the growing raw cache, the compressor's second cache, both routing regimes, the
; experts, the shared lane, the exit head). This cell adds NO new arithmetic — it adds the LOOP: 43
; layers x two hyper-connection frames per token, one command batch per token, one sync (the logits
; read). Per-layer weight views are resolved once from the file's own header. The stream is the
; check: greedy ids diffed against the bash lane's receipt-recorded ids on the canonical file.
;
; preludes: native/metal/dsv4-decode-form.fk form-stdlib/llama-decode-msl.fk

(do
    (defn dfd-append1 (l x) (if (eq (len l) 0) (cons x 0) (cons (head l) (dfd-append1 (tail l) x))))
    ; ═══════════════ RUNG 14: the 43-LAYER STACK and the GREEDY STREAM ═══════════════
    ; The whole forward, held by this cell: per-layer weight views resolved once from the file's own
    ; header (never a constant), two freq tables (plain base-10000 for ratio-0 layers, the YaRN
    ; base-160000 table for every ratio>0 layer — one table, the scalars are global KVs), a growing
    ; raw KV arena per layer, the compressor's second cache on every ratio>0 layer (ratio-4 two-lane
    ; and ratio-128 single-lane, the state row rule read from the oracle's compStep: row =
    ; ratio+(pos%ratio) when ratio==4, else pos%ratio), hash routing below hash_layer_count and
    ; biased top-6 above it, the shared expert beside the routed six, hyper-connection frames around
    ; both halves, and the exit head. One command batch per generated token; the one sync is the
    ; logits read the argmax needs. The indexer mask stays inert below 2048 tokens (top_k 512) and
    ; is declared, not implemented (dsv4-compressor.fk's aporon radius).
    (defn dfd-posbits-gen (t)
        (if (eq t 0) 0
            (do (let e (dfd-hibit t))
                (add (mul (add e 127) 8388608) (mul (sub t (dfd-pow2 e)) (dfd-pow2 (sub 23 e)))))))
    (defn dfd-st-name (il suffix) (str_concat "blk." (str_concat (int_to_str il) suffix)))
    ; ── the one-walk tensor table (the dense rounds' dth-table shape, inherited at last).
    ; ONE pass over the 1328-row header; every later lookup is a list scan of cheap str_eq.
    ; Witnessed before this landed: dfd-st-build's ~50 egg-find-tensor header re-walks per
    ; layer cost SETUP views_43_layers_ms=720617 (dsl-l3-probe, 2026-08-09). The dense lanes
    ; paid the same disease at 74-96 s and the table took them to 1.6-28.5 s; the stack cell
    ; had never inherited the cure. One row: (name type d0 d1 d2 absoff bytes).
    (defn dfd-stt-walk (src off n base acc)
        (if (le n 0) acc
            (dfd-stt-walk src (egg-ti-next src off) (sub n 1) base
                (cons (list (gm-name src off) (egg-ti-type src off)
                            (gm-dimk src off 0) (gm-dimk src off 1) (gm-dimk src off 2)
                            (add base (egg-ti-dataoff src off)) (gm-bytes src off)) acc))))
    (defn dfd-stt (src)
        (dfd-stt-walk src (egg-tinfo-start src) (egg-tensor-count src)
                      (egg-data-base src (gm-alignment)) 0))
    (defn dfd-stt-find (tab name)
        (if (eq (len tab) 0) 0
            (if (str_eq (nth (head tab) 0) name) (head tab) (dfd-stt-find (tail tab) name))))
    (defn dfd-stt-ty    (tab name) (nth (dfd-stt-find tab name) 1))
    (defn dfd-stt-d0    (tab name) (nth (dfd-stt-find tab name) 2))
    (defn dfd-stt-d2    (tab name) (nth (dfd-stt-find tab name) 4))
    (defn dfd-stt-abs   (tab name) (nth (dfd-stt-find tab name) 5))
    (defn dfd-stt-bytes (tab name) (nth (dfd-stt-find tab name) 6))
    (defn dfd-st-view (tab path il suffix)
        (do (let r (dfd-stt-find tab (dfd-st-name il suffix)))
            (metal_buf_from_file path (nth r 5) (nth r 6))))
    (defn dfd-st-ratios-go (src off i n)
        (if (ge i n) 0
            (cons (eqr-le src (gm-arr-elem-off src off i) 4)
                  (dfd-st-ratios-go src off (add i 1) n))))
    (defn dfd-st-ratios (src n)
        (dfd-st-ratios-go src (gmt-find src "deepseek4.attention.compress_ratios") 0 n))
    (defn dfd-st-hashcount (src)
        (gm-int src (gmt-find src "deepseek4.hash_layer_count") 4))

    ; ── the GPU-resident id chain (dense round three's donor, ported to DS4). The argmax id never
    ; travels to the host mid-generation: it is copied device-to-device into a per-position id buffer,
    ; and the next token's embed and hash-select read their row index FROM that buffer. base = id*n*2
    ; is the same offset the host constant computed; hash-select's token is the same row. copy_u32 is
    ; bytes-are-bytes. Three kernels in one unit; the stack appends them as P36/37/38.
    (defn dfd-idchain-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat "#include <metal_stdlib>\nusing namespace metal;\n"
        (str_concat "kernel void form_dsv4_embed_f16_u32_idx(device const uchar* src [[buffer(0)]], device float* dst [[buffer(1)]], device const uint* idp [[buffer(2)]], constant uint& pos [[buffer(3)]], constant uint& n [[buffer(4)]], uint gid [[thread_position_in_grid]]) { if (gid < n) { uint base = idp[pos] * n * 2u; ushort h = *(device const ushort*)(src + base + gid*2u); dst[gid] = float(as_type<half>(h)); } }"
        (str_concat " kernel void form_dsv4_hash_select_idx (device const uchar* tb [[buffer(0)]], device uint* ids [[buffer(1)]], device const uint* idp [[buffer(2)]], constant uint& pos [[buffer(3)]], constant uint& nused [[buffer(4)]], uint i [[thread_position_in_grid]]) { if (i >= nused) return; uint token = idp[pos]; ulong off = ((ulong)token * (ulong)nused + (ulong)i) * 4ul; uint v = uint(tb[off]) + 256u * uint(tb[off + 1ul]) + 65536u * uint(tb[off + 2ul]) + 16777216u * uint(tb[off + 3ul]); ids[i] = v; }"
                    " kernel void form_dsv4_copy_u32 (device const uint* s [[buffer(0)]], device uint* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& doff [[buffer(3)]], constant uint& soff [[buffer(4)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; d[doff + i] = s[soff + i]; }")))))

    ; seed the id buffer with the prompt tokens (host->device, before any batch opens)
    (defn dfd-seed-ids (h ids i)
        (if (eq (len ids) 0) 0
            (do (metal_buf_write h (mul i 4) (dfd-u32 (head ids)))
                (dfd-seed-ids h (tail ids) (add i 1)))))
    ; read n u32 ids out of a raw byte string
    (defn dfd-read-ids (raw i n)
        (if (ge i n) 0 (cons (dfd-rd32 raw (mul i 4)) (dfd-read-ids raw (add i 1) n))))

    ; one layer's handles and arenas, resolved once. Fields:
    ;  0 nrmh  1 qaty  2 qah  3 qanh  4 kvh  5 kvanh  6 qbh  7 snkh  8 oah  9 oaty  10 obh  11 obty
    ; 12 hafh 13 hash 14 habh 15 hffh 16 hfsh 17 hfbh 18 fnwh
    ; 19 gih  20 routeh 21 hashed 22 gxh 23 uxh 24 dxh 25 strideg 26 strided
    ; 27 sgh  28 suh  29 sdh  30 sgty
    ; 31 ratio 32 arenab 33 ckvh 34 cgth 35 apeh 36 cnmh 37 stateb 38 scoreb 39 packedb 40 cwidth
    (defn dfd-st-layer-rec (tab path il ratio hashed kvcap)
        (do (let gxbytes (dfd-stt-bytes tab (dfd-st-name il ".ffn_gate_exps.weight")))
            (let dxbytes (dfd-stt-bytes tab (dfd-st-name il ".ffn_down_exps.weight")))
            (let nexp (dfd-stt-d2 tab (dfd-st-name il ".ffn_gate_exps.weight")))
            (let routeh (if (eq hashed 1) (dfd-st-view tab path il ".ffn_gate_tid2eid.weight")
                                          (dfd-st-view tab path il ".exp_probs_b.bias")))
            (let comp (if (eq ratio 0) (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 (cons 0 0))))))))
                (do (let ckvh (dfd-st-view tab path il ".attn_compressor_kv.weight"))
                    (let cgth (dfd-st-view tab path il ".attn_compressor_gate.weight"))
                    (let apeh (dfd-st-view tab path il ".attn_compressor_ape.weight"))
                    (let cnmh (dfd-st-view tab path il ".attn_compressor_norm.weight"))
                    (let cwidth (dfd-stt-d0 tab (dfd-st-name il ".attn_compressor_ape.weight")))
                    (let nrows (if (eq ratio 4) (mul 2 ratio) ratio))
                    (let stateb (metal_buf_alloc (mul (mul nrows cwidth) 4)))
                    (let scoreb (metal_buf_alloc (mul (mul nrows cwidth) 4)))
                    (let packedb (metal_buf_alloc 16384))
                    (cons ckvh (cons cgth (cons apeh (cons cnmh
                        (cons stateb (cons scoreb (cons packedb (cons cwidth 0)))))))))))
            (cons (dfd-st-view tab path il ".attn_norm.weight")
            (cons (dfd-stt-ty tab (dfd-st-name il ".attn_q_a.weight"))
            (cons (dfd-st-view tab path il ".attn_q_a.weight")
            (cons (dfd-st-view tab path il ".attn_q_a_norm.weight")
            (cons (dfd-st-view tab path il ".attn_kv.weight")
            (cons (dfd-st-view tab path il ".attn_kv_a_norm.weight")
            (cons (dfd-st-view tab path il ".attn_q_b.weight")
            (cons (dfd-st-view tab path il ".attn_sinks.weight")
            (cons (dfd-st-view tab path il ".attn_output_a.weight")
            (cons (dfd-stt-ty tab (dfd-st-name il ".attn_output_a.weight"))
            (cons (dfd-st-view tab path il ".attn_output_b.weight")
            (cons (dfd-stt-ty tab (dfd-st-name il ".attn_output_b.weight"))
            (cons (dfd-st-view tab path il ".hc_attn_fn.weight")
            (cons (dfd-st-view tab path il ".hc_attn_scale.weight")
            (cons (dfd-st-view tab path il ".hc_attn_base.weight")
            (cons (dfd-st-view tab path il ".hc_ffn_fn.weight")
            (cons (dfd-st-view tab path il ".hc_ffn_scale.weight")
            (cons (dfd-st-view tab path il ".hc_ffn_base.weight")
            (cons (dfd-st-view tab path il ".ffn_norm.weight")
            (cons (dfd-st-view tab path il ".ffn_gate_inp.weight")
            (cons routeh
            (cons hashed
            (cons (dfd-st-view tab path il ".ffn_gate_exps.weight")
            (cons (dfd-st-view tab path il ".ffn_up_exps.weight")
            (cons (dfd-st-view tab path il ".ffn_down_exps.weight")
            (cons (div gxbytes nexp)
            (cons (div dxbytes nexp)
            (cons (dfd-st-view tab path il ".ffn_gate_shexp.weight")
            (cons (dfd-st-view tab path il ".ffn_up_shexp.weight")
            (cons (dfd-st-view tab path il ".ffn_down_shexp.weight")
            (cons (dfd-stt-ty tab (dfd-st-name il ".ffn_gate_shexp.weight"))
            (cons ratio
            (cons (metal_buf_alloc (mul kvcap 2048))
                  comp)))))))))))))))))))))))))))))))))))

    (defn dfd-st-build (tab path il n hashn kvcap ratios)
        (if (ge il n) 0
            (cons (dfd-st-layer-rec tab path il (nth ratios il) (if (lt il hashn) 1 0) kvcap)
                  (dfd-st-build tab path (add il 1) n hashn kvcap ratios))))

    ; the compressor's per-token step for a ratio>0 layer (oracle compStep, dispatch for dispatch)
    (defn dfd-st-comp (P S L pos)
        (do (let ratio (nth L 31))
            (let w (nth L 40))
            (let row (if (eq ratio 4) (add ratio (mod pos ratio)) (mod pos ratio)))
            (let e0 (metal_enqueue (nth P 3)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth L 33)) (dfd-u32 (nth S 10))) (dfd-u32 (nth S 51))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 w) (dfd-u32 4096)))) w))
            (let e1 (metal_enqueue (nth P 3)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth L 34)) (dfd-u32 (nth S 10))) (dfd-u32 (nth S 52))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 w) (dfd-u32 4096)))) w))
            (let e2 (metal_enqueue (nth P 30)
                (str_concat (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 (nth S 51)) (dfd-u32 (nth S 52)))
                                                                (str_concat (str_concat (dfd-u32 (nth L 35)) (dfd-u32 (nth L 37))) (dfd-u32 (nth L 38)))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 w) (dfd-u32 row)) (dfd-u32 (mod pos ratio))))) w))
            (if (eq (mod (add pos 1) ratio) 0)
                (do (let e3 (metal_enqueue (nth P 31)
                        (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth L 37)) (dfd-u32 (nth L 38))) (dfd-u32 (nth S 53))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 ratio)))) 512))
                    (let e4 (if (eq ratio 4)
                        (metal_enqueue (nth P 32)
                            (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth L 37)) (dfd-u32 (nth L 38))))
                                        (str_concat (dfd-u32 2) (str_concat (dfd-u32 w) (dfd-u32 ratio)))) (mul ratio w))
                        0))
                    (let e5 (metal_enqueue (nth P 8) (dfd-bind-tg
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 53)) (dfd-u32 (nth S 54))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
                    (let e6 (metal_enqueue (nth P 9)
                        (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth S 53)) (dfd-u32 (nth L 36)))
                                                                        (str_concat (dfd-u32 (nth S 55)) (dfd-u32 (nth S 54)))))
                                    (str_concat (dfd-u32 1) (dfd-u32 512))) 512))
                    (let e7 (metal_enqueue (nth P 11)
                        (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth S 55)) (dfd-u32 (nth S 56))) (dfd-u32 (nth S 50))))
                                    (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 1) (dfd-u32 512))
                                        (str_concat (dfd-u32 64) (str_concat (dfd-u32 (dfd-posbits-gen (sub (add pos 1) ratio))) (dfd-u32 1065353216)))))) 512))
                    (let e8 (metal_enqueue (nth P 14) (dfd-bind-tg
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 56)) (dfd-u32 (nth S 57))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
                    (metal_enqueue (nth P 15)
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 57)) (dfd-u32 (nth L 39))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 (sub (div (add pos 1) ratio) 1)) (dfd-u32 512)))) 512))
                0)))

    ; one layer, dispatches only. P: 0 pe 1 pbc 2 pnw 3 pf16 4 psq4 5 pwsum 6 ppost 7 pslc
    ; 8 pr 9 pa 10 ph 11 pro 12 pam 13 pf 14 pkq 15 pap 16 pmv 17 pg
    ; 18 phsel 19 phprb 20 phwts 21 ptkp 22 ptks 23 pswg 24 pswge 25 pmred 26 pscl 27 paxp
    ; 28 piq2 29 pq2k 30 pcs 31 pcp 32 pcsh 33 phw
    ; S: 0 xb 1 residA 2 residB 3 flatb 4 amixb 5 asplitb 6 apostb 7 acombb 8 acurb 9 ib 10 xnb
    ; 11 qlb 12 ib2 13 qlnb 14 klb 15 ib3 16 klnb 17 qqb 18 qhb 19 qrb 20 krb 21 kqb 22 hab 23 hub
    ; 24 lob 25 aob 26 aftb 27 fmixb 28 fsplitb 29 fpostb 30 fcombb 31 fcurb 32 ib4 33 fnrmb
    ; 34 logitsb 35 idsb 36 wtsb 37 probsb 38 scb 39 gateb 40 upb 41 midb 42 partsb 43 moeb
    ; 44 sgvb 45 suvb 46 smidb 47 sharedb 48 ffnoutb 49 fb0 50 fbY 51 ckvb 52 cscb 53 pooledb
    ; 54 ib5 55 cnrmb 56 crb 57 cqb
    (defn dfd-st-layer (P S L pos token rin rout)
        (do (let ratio (nth L 31))
            (let fbh (if (eq ratio 0) (nth S 49) (nth S 50)))
            (let pb (dfd-posbits-gen pos))
            ; attn hcPre
            (let b0 (metal_enqueue (nth P 2) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 rin) (dfd-u32 (nth S 3))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 16384) (dfd-u32 (dfd-eps-bits))))) 1024 0) 1024))
            (let b1 (metal_enqueue (nth P 3)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth L 12)) (dfd-u32 (nth S 3))) (dfd-u32 (nth S 4))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 24) (dfd-u32 16384)))) 24))
            (let b2 (metal_enqueue (nth P 4)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth S 4)) (dfd-u32 (nth L 13)))
                                                                (str_concat (dfd-u32 (nth L 14)) (dfd-u32 (nth S 5)))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 4) (dfd-u32 20)) (dfd-u32 (dfd-eps-bits))))) 1))
            (let b3 (metal_enqueue (nth P 7)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 5)) (dfd-u32 (nth S 6))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 4)))) 4))
            (let b4 (metal_enqueue (nth P 7)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 5)) (dfd-u32 (nth S 7))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 8) (dfd-u32 16)))) 16))
            (let b5 (metal_enqueue (nth P 5)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 rin) (dfd-u32 (nth S 5))) (dfd-u32 (nth S 8))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 4096)))) 4096))
            ; MLA
            (let c0 (metal_enqueue (nth P 8) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 8)) (dfd-u32 (nth S 9))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4096) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let c1 (metal_enqueue (nth P 9)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth S 8)) (dfd-u32 (nth L 0)))
                                                                (str_concat (dfd-u32 (nth S 10)) (dfd-u32 (nth S 9)))))
                            (str_concat (dfd-u32 1) (dfd-u32 4096))) 4096))
            (let c2 (dfd-mv-enq (nth P 16) (nth L 1) (nth L 2) (nth S 10) (nth S 11) 1024 4096))
            (let c3 (dfd-mv-enq (nth P 16) (nth L 1) (nth L 4) (nth S 10) (nth S 14) 512 4096))
            (let cc (if (gt ratio 0) (dfd-st-comp P S L pos) 0))
            (let c4 (metal_enqueue (nth P 8) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 11)) (dfd-u32 (nth S 12))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let c5 (metal_enqueue (nth P 9)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth S 11)) (dfd-u32 (nth L 3)))
                                                                (str_concat (dfd-u32 (nth S 13)) (dfd-u32 (nth S 12)))))
                            (str_concat (dfd-u32 1) (dfd-u32 1024))) 1024))
            (let c6 (metal_enqueue (nth P 8) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 14)) (dfd-u32 (nth S 15))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let c7 (metal_enqueue (nth P 9)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth S 14)) (dfd-u32 (nth L 5)))
                                                                (str_concat (dfd-u32 (nth S 16)) (dfd-u32 (nth S 15)))))
                            (str_concat (dfd-u32 1) (dfd-u32 512))) 512))
            (let c8 (dfd-mv-enq (nth P 16) (nth L 1) (nth L 6) (nth S 13) (nth S 17) 32768 1024))
            (let c9 (metal_enqueue (nth P 10)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 17)) (dfd-u32 (nth S 18))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512)) (dfd-u32 (dfd-eps-bits))))) 64))
            (let c11 (metal_enqueue (nth P 11)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth S 18)) (dfd-u32 (nth S 19))) (dfd-u32 fbh)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 pb) (dfd-u32 1065353216)))))) 32768))
            (let c12 (metal_enqueue (nth P 11)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth S 16)) (dfd-u32 (nth S 20))) (dfd-u32 fbh)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 1) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 pb) (dfd-u32 1065353216)))))) 512))
            (let c13 (metal_enqueue (nth P 14) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 20)) (dfd-u32 (nth S 21))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
            (let c14 (metal_enqueue (nth P 15)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 21)) (dfd-u32 (nth L 32))))
