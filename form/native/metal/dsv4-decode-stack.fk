    ; the decode loop: prompt prefill then greedy continuation. Returns the generated ids, in order.
    (defn dfd-st-compinit (pci Ls)
        (if (eq (len Ls) 0) 0
            (do (let L (head Ls))
                (if (gt (nth L 31) 0)
                    (do (let n (mul (if (eq (nth L 31) 4) 8 128) (nth L 40)))
                        (metal_enqueue pci
                            (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth L 37)) (dfd-u32 (nth L 38))))
                                        (str_concat (dfd-u32 1) (dfd-u32 n))) n))
                    0)
                (dfd-st-compinit pci (tail Ls)))))
    ; the decode loop is now pure enqueue: the embed reads its token id from idbuf[pos] (S58), the
    ; head lands the next id in idbuf[pos+1], and no id is read to the host until the whole generation
    ; has been submitted. The dispatch sequence is id-INDEPENDENT (the routing reads device ids), so
    ; the entire greedy stream is one submit; dfd-stack-stream reads all ids once at the end.
    (defn dfd-st-step (P S Ls X pos ntotal promptlen)
        (if (ge pos ntotal) 0
            (do (let e0 (metal_enqueue (nth P 36)
                    (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth S 63)) (dfd-u32 (nth S 0))) (dfd-u32 (nth S 58))))
                                (str_concat (dfd-u32 2) (str_concat (dfd-u32 pos) (dfd-u32 4096)))) 4096))
                (let e1 (metal_enqueue (nth P 1)
                    (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 0)) (dfd-u32 (nth S 1))))
                                (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 4096)))) 16384))
                (let fin (dfd-st-layers-go P S Ls 0 pos 0 (nth S 1) (nth S 2)))
                (if (lt pos (sub promptlen 1))
                    (dfd-st-step P S Ls X (add pos 1) ntotal promptlen)
                    (do (dfd-st-head P S X pos fin)
                        (dfd-st-step P S Ls X (add pos 1) ntotal promptlen))))))


    (defn dfd-stack-stream (path promptids nsteps)
        (do
            (let src (dfd-src path))
            (let nlayers 43)
            (let hashn (dfd-st-hashcount src))
            (let ratios (dfd-st-ratios src (add nlayers 1)))
            (let kvcap (add (len promptids) (add nsteps 2)))
            (print (str_concat "STACK hash_layer_count=" (str_concat (int_to_str hashn)
                   (str_concat " kvcap=" (int_to_str kvcap)))))
            (let tab (dfd-stt src))
            (let eabs (dfd-stt-abs tab "token_embd.weight"))
            (let ebytes (dfd-stt-bytes tab "token_embd.weight"))
            (let embh (metal_buf_from_file path eabs ebytes))

            (let hmsl (dfd-hc-msl))
            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let fmsl (dfd-ffn-msl))
            (let cmsl (dfd-comp-msl))
            (let amsl (str_concat (dfd-msl-pragma)
                      (str_concat (ldm-argmax-part-msl "form_argmax_part_f32")
                                  (ldm-argmax-comb-msl "form_argmax_comb_f32"))))
            (let P (cons (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32")
                   (cons (metal_pipeline hmsl "form_hc_broadcast_f32")
                   (cons (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32")
                   (cons (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec")
                   (cons (metal_pipeline hmsl "form_hc_split_seq4_f32")
                   (cons (metal_pipeline hmsl "form_hc_wsum_f32")
                   (cons (metal_pipeline hmsl "form_hc_post_f32")
                   (cons (metal_pipeline (dfd-slice-msl) "dfd_slice")
                   (cons (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32")
                   (cons (metal_pipeline mslm "form_mla_rmsnorm_apply_f32")
                   (cons (metal_pipeline mslm "form_mla_headrms_f32")
                   (cons (metal_pipeline mslm "form_mla_rope_f32")
                   (cons (metal_pipeline mslm "form_mla_attend_mixed_f32")
                   (cons (metal_pipeline (dfd-freqs-msl) "dfd_freqs")
                   (cons (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par")
                   (cons (metal_pipeline (dfd-append-msl) "dfd_kv_append")
                   (cons (dfd-mv-pipe 8)
                   (cons (dfd-mvg-pipe 8)
                   (cons (metal_pipeline fmsl "form_dsv4_hash_select")
                   (cons (metal_pipeline fmsl "form_dsv4_hash_probs")
                   (cons (metal_pipeline fmsl "form_dsv4_hash_wts")
                   (cons (metal_pipeline fmsl "form_dsv4_topk_probs")
                   (cons (metal_pipeline fmsl "form_dsv4_topk_select_tg6")
                   (cons (metal_pipeline fmsl "form_dsv4_swiglu_f32")
                   (cons (metal_pipeline fmsl "form_dsv4_swiglu_experts")
                   (cons (metal_pipeline fmsl "form_dsv4_moe_reduce")
                   (cons (metal_pipeline fmsl "form_dsv4_scale_f32")
                   (cons (metal_pipeline fmsl "form_dsv4_axpy_f32")
                   (cons (metal_pipeline (dfd-iq2e-msl) "form_dsv4_iq2_matvec_experts4")
                   (cons (metal_pipeline (dfd-q2ke-msl) "form_dsv4_q2k_matvec_experts")
                   (cons (metal_pipeline cmsl "form_dsv4_comp_state_f32")
                   (cons (metal_pipeline cmsl "form_dsv4_comp_pool_f32")
                   (cons (metal_pipeline cmsl "form_dsv4_comp_shift_f32")
                   (cons (metal_pipeline hmsl "form_hc_headw_f32")
                   ; 34/35 — the GPU two-stage argmax, inherited from the dense lanes (llama-decode-msl).
                   ; The interpreted fold over 129,280 logits cost 1227 ms per generated token
                   ; (dsl-l3-probe L2d, 2026-08-09); these two dispatches and an 8-byte read replace it.
                   (cons (metal_pipeline amsl "form_argmax_part_f32")
                   (cons (metal_pipeline amsl "form_argmax_comb_f32")
                   ; 36/37/38 — the GPU-resident id chain: embed-by-id, hash-select-by-id, copy_u32.
                   (cons (metal_pipeline (dfd-idchain-msl) "form_dsv4_embed_f16_u32_idx")
                   (cons (metal_pipeline (dfd-idchain-msl) "form_dsv4_hash_select_idx")
                   (cons (metal_pipeline (dfd-idchain-msl) "form_dsv4_copy_u32") 0))))))))))))))))))))))))))))))))))))))))
            (let pci (metal_pipeline cmsl "form_dsv4_comp_init_f32"))

            (let S (cons (metal_buf_alloc 16384)      ; 0 xb
                   (cons (metal_buf_alloc 65536)      ; 1 residA
                   (cons (metal_buf_alloc 65536)      ; 2 residB
                   (cons (metal_buf_alloc 65536)      ; 3 flatb
                   (cons (metal_buf_alloc 96)         ; 4 amixb
                   (cons (metal_buf_alloc 96)         ; 5 asplitb
                   (cons (metal_buf_alloc 16)         ; 6 apostb
                   (cons (metal_buf_alloc 64)         ; 7 acombb
                   (cons (metal_buf_alloc 16384)      ; 8 acurb
                   (cons (metal_buf_alloc 4)          ; 9 ib
                   (cons (metal_buf_alloc 16384)      ; 10 xnb
                   (cons (metal_buf_alloc 4096)       ; 11 qlb
                   (cons (metal_buf_alloc 4)          ; 12 ib2
                   (cons (metal_buf_alloc 4096)       ; 13 qlnb
                   (cons (metal_buf_alloc 2048)       ; 14 klb
                   (cons (metal_buf_alloc 4)          ; 15 ib3
                   (cons (metal_buf_alloc 2048)       ; 16 klnb
                   (cons (metal_buf_alloc 131072)     ; 17 qqb
                   (cons (metal_buf_alloc 131072)     ; 18 qhb
                   (cons (metal_buf_alloc 131072)     ; 19 qrb
                   (cons (metal_buf_alloc 2048)       ; 20 krb
                   (cons (metal_buf_alloc 2048)       ; 21 kqb
                   (cons (metal_buf_alloc 131072)     ; 22 hab
                   (cons (metal_buf_alloc 131072)     ; 23 hub
                   (cons (metal_buf_alloc 32768)      ; 24 lob
                   (cons (metal_buf_alloc 16384)      ; 25 aob
                   (cons (metal_buf_alloc 65536)      ; 26 aftb
                   (cons (metal_buf_alloc 96)         ; 27 fmixb
                   (cons (metal_buf_alloc 96)         ; 28 fsplitb
                   (cons (metal_buf_alloc 16)         ; 29 fpostb
                   (cons (metal_buf_alloc 64)         ; 30 fcombb
                   (cons (metal_buf_alloc 16384)      ; 31 fcurb
                   (cons (metal_buf_alloc 4)          ; 32 ib4
                   (cons (metal_buf_alloc 16384)      ; 33 fnrmb
                   (cons (metal_buf_alloc 1024)       ; 34 logitsb
                   (cons (metal_buf_alloc 24)         ; 35 idsb
                   (cons (metal_buf_alloc 24)         ; 36 wtsb
                   (cons (metal_buf_alloc 1024)       ; 37 probsb
                   (cons (metal_buf_alloc 1024)       ; 38 scb
                   (cons (metal_buf_alloc 49152)      ; 39 gateb
                   (cons (metal_buf_alloc 49152)      ; 40 upb
                   (cons (metal_buf_alloc 49152)      ; 41 midb
                   (cons (metal_buf_alloc 98304)      ; 42 partsb
                   (cons (metal_buf_alloc 16384)      ; 43 moeb
                   (cons (metal_buf_alloc 8192)       ; 44 sgvb
                   (cons (metal_buf_alloc 8192)       ; 45 suvb
                   (cons (metal_buf_alloc 8192)       ; 46 smidb
                   (cons (metal_buf_alloc 16384)      ; 47 sharedb
                   (cons (metal_buf_alloc 16384)      ; 48 ffnoutb
                   (cons (metal_buf_alloc 128)        ; 49 fb0
                   (cons (metal_buf_alloc 128)        ; 50 fbY
                   (cons (metal_buf_alloc 4096)       ; 51 ckvb
                   (cons (metal_buf_alloc 4096)       ; 52 cscb
                   (cons (metal_buf_alloc 2048)       ; 53 pooledb
                   (cons (metal_buf_alloc 4)          ; 54 ib5
                   (cons (metal_buf_alloc 2048)       ; 55 cnrmb
                   (cons (metal_buf_alloc 2048)       ; 56 crb
                   (cons (metal_buf_alloc 2048)       ; 57 cqb
                   (cons (metal_buf_alloc (mul kvcap 4)) ; 58 idbuf (per-position token ids, device-resident)
                   (cons 0 (cons 0 (cons 0 (cons 0
                   (cons embh 0)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
            ; seed the prompt tokens into idbuf before any batch opens (host->device, no hazard)
            (let seed (dfd-seed-ids (nth S 58) promptids 0))
            ; the two freq tables, computed ON the device (rung 5 and rung 9's kernels and scalars)
            (let ef0 (metal_enqueue (nth P 13)
                (str_concat (str_concat (dfd-u32 1) (dfd-u32 (nth S 49)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64)) (dfd-u32 1176256512)))) 32))
            (let pfy (metal_pipeline (dfd-yarn-msl) "dfd_yarn_freqs"))
            (let efy (metal_enqueue pfy
                (str_concat (str_concat (dfd-u32 1) (dfd-u32 (nth S 50)))
                            (str_concat (dfd-u32 6) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64))
                                (str_concat (str_concat (dfd-u32 1209810944) (dfd-u32 1031798784))
                                            (str_concat (dfd-u32 1097859072) (dfd-u32 1103626240)))))) 32))
            (let Ls (dfd-st-build tab path 0 nlayers hashn kvcap ratios))
            ; comp planes born 0 / NEG_INF by the recipe's own init kernel, per ratio>0 layer
            (let ci (dfd-st-compinit pci Ls))
            ; the exit head's handles
            (let X (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_fn.weight") (dfd-stt-bytes tab "output_hc_fn.weight"))
                   (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_scale.weight") (dfd-stt-bytes tab "output_hc_scale.weight"))
                   (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_base.weight") (dfd-stt-bytes tab "output_hc_base.weight"))
                   (cons (metal_buf_from_file path (dfd-stt-abs tab "output_norm.weight") (dfd-stt-bytes tab "output_norm.weight"))
                   (cons (metal_buf_from_file path (dfd-stt-abs tab "output.weight") (dfd-stt-bytes tab "output.weight"))
                   (cons (metal_buf_alloc 16)         ; 5 preb
                   (cons (metal_buf_alloc 16)         ; 6 hwb
                   (cons (metal_buf_alloc 16384)      ; 7 collb
                   (cons (metal_buf_alloc 4)          ; 8 ib6
                   (cons (metal_buf_alloc 16384)      ; 9 normedb
                   (cons (metal_buf_alloc 517120)     ; 10 vlogitsb
                   (cons (metal_buf_alloc 2048)       ; 11 argmax partial ids (512 x u32)
                   (cons (metal_buf_alloc 2048)       ; 12 argmax partial values (512 x f32)
                   (cons (metal_buf_alloc 4)          ; 13 argmax winning id
                   (cons (metal_buf_alloc 4)          ; 14 argmax winning logit
                         0))))))))))))))))
            (print (metal_status))
            ; one submit: enqueue the whole greedy stream, then read all generated ids at once. The
            ; single metal_buf_read below is the only host fence of the generation (was one per token).
            (dfd-st-step P S Ls X 0 (add (len promptids) nsteps) (len promptids))
            (let raw (metal_buf_read (nth S 58) (mul (len promptids) 4) (mul nsteps 4)))
            (let gen (dfd-read-ids raw 0 nsteps))
            (print (metal_status))
            gen))
    0)
