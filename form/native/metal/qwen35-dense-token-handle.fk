    def q38-t64-msl(fname) = q38t-join(["kernel void ", fname, " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], constant uint& ntok [[buffer(5)]], constant uint& ystride [[buffer(6)]], uint gr [[threadgroup_position_in_grid]], uint lt [[thread_index_in_threadgroup]], uint sg [[simdgroup_index_in_threadgroup]]) { threadgroup float sm[4096]; threadgroup float* sa = sm; threadgroup float* sb = sm + 2048; uint nTok = (ntok + 63u) / 64u; uint r1 = (gr % nTok) * 64u; uint r0 = (gr / nTok) * 64u; uint nb = cols / 32u; uint lr0 = metal::min(lt >> 1, rows - r0 - 1u); uint il0 = lt & 1u; uint lr1 = metal::min(lt >> 1, ntok - r1 - 1u); device const uchar* xrow = qb + (ulong)(r0 + lr0) * (ulong)nb * 34ul; device const float* yrow = x + (ulong)(r1 + lr1) * (ulong)cols + il0 * 16u; metal::simdgroup_float8x8 ma[4]; metal::simdgroup_float8x8 mb[4]; metal::simdgroup_float8x8 mc[16]; ", q38t-mcinit(0), "uint sy = (lt >> 1) / 8u; uint lx = (lt >> 1) % 8u; for (uint kb = 0u; kb < nb; kb++) { device const uchar* blk = xrow + (ulong)kb * 34ul; ushort hh = (ushort)blk[0] | ((ushort)blk[1] << 8); float dd = float(as_type<half>(hh)); device const uchar* qs = blk + 2u + il0 * 16u; metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); ", q38t-deq(0), "device const float4* yp = (device const float4*)(yrow + (ulong)kb * 32ul); ", q38t-xst(0), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); threadgroup const float* lsma = sa + 4u * 64u * (sg & 1u); threadgroup const float* lsmb = sb + 4u * 64u * (sg >> 1); ", q38t-ik(0), "} if (r0 + 64u <= rows && r1 + 64u <= ntok) { device float* C = y + (r0 + 32u * (sg & 1u)) + (ulong)(r1 + 32u * (sg >> 1)) * (ulong)ystride; ", q38t-st(0), "} else { metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); threadgroup float* temp = sm + 32u * (sg & 1u) + (32u * (sg >> 1)) * 64u; ", q38t-stg(0), "metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); uint col = lt & 63u; uint trow = lt >> 6; for (uint t = trow; t < 64u; t += 2u) { uint tt = r1 + t; uint n = r0 + col; if (tt < ntok && n < rows) { y[(ulong)tt * (ulong)ystride + (ulong)n] = sm[t * 64u + col]; } } } }"], 0);
    // the Q8_0 batched matmul of one tensor: the 64 x 64-tile kernel where it fills the GPU, the 64 x 32 one otherwise
    def q38-mm-q80(ps, tv, xh, yh, ntok, ystride, barrier) = q38-t64-use?(kth-tv-r(tv), ntok) ? metal_enqueue(nth(ps, q38-t64-index()), md-bind16([kth-tv-h(tv), xh, yh], [kth-tv-r(tv), kth-tv-c(tv), ntok, ystride], 128, 0, 1, barrier), q38-t64-groups(kth-tv-r(tv), ntok)) : metal_enqueue(nth(ps, q38-mm64-index()), md-bind16([kth-tv-h(tv), xh, yh], [kth-tv-r(tv), kth-tv-c(tv), ntok, ystride], 128, 0, 1, barrier), q38-mm64-groups(kth-tv-r(tv), ntok));
    // one layer's delta recurrence over ntok tokens: the simdgroup-row kernel when the key/value width is the 128 it is written for, the
    // thread-a-row kernel otherwise
    def q38-delta-span-run(ps, bs, geo, st, pitch, ntok) = (Comparable) geo[4] == 128 ? metal_enqueue(ps[q38-gdnsg-index()], md-bind16([st[1], bs[2], bs[5], bs[6], bs[8]], [geo[3], geo[5], geo[4], geo[2], geo[7], pitch, geo[3], geo[3] * geo[5], ntok], 128, 0, 1, 1), q38-gdnsg-groups(geo[3], geo[5])) : metal_enqueue(nth(ps, qlslc-delta-span-pipeline()), q38-b16([st[1], bs[2], bs[5], bs[6], bs[8]], [geo[3], geo[5], geo[4], geo[2], geo[7], pitch, geo[3], geo[3] * geo[5], ntok], 0, 1), geo[3] * geo[5]);
    def q38-rms-span(ps, xh, gtv, yh, n, epsBits, ntok, barrier) = metal_enqueue(ps[q38-rmspar-span-index()], md-bind16([xh, kth-tv-h(gtv), yh], [n, epsBits, ntok], 256, 0, 1, barrier), ntok);
    // The FFN over the whole span. rms is per-row across ntok rows; the three
    // matmuls are the batched kernel at its real width; swiglu and the residual
    // add are elementwise, so they simply run over n * ntok contiguous values.
    def q38-ffn-span(ps, bs, geo, lay, ntok) = {
        q38-rms-span(ps, bs[33], lay[1], bs[1], geo[0], geo[6], ntok, 1);
        q38-mv-batch(ps, lay[2], bs[1], bs[14], ntok, 1);
        q38-mv-batch(ps, lay[3], bs[1], bs[15], ntok, 0);
        metal_enqueue(ps[18], q38-b16([bs[14], bs[15], bs[16]], [geo[10] * ntok], 0, 1), geo[10] * ntok);
        q38-mv-batch(ps, lay[4], bs[16], bs[17], ntok, 1);
        metal_enqueue(ps[19], q38-b16([bs[33], bs[17], bs[33]], [geo[0] * ntok], 0, 1), geo[0] * ntok);
        1;
    };
    // ── the full-attention block over a span ───────────────────────────────
    // Every op here is the per-token one with the token axis in the operation
    // instead of a loop around it. The stream is identical, line for line; it is
    // issued once for the span rather than once per position.
    def q38-full-attn-span(ps, bs, geo, lay, st, pos0, ntok) = {
        let nqhd = geo[12] * geo[14];
        let nkvhd = geo[13] * geo[14];
        q38-rms-span(ps, bs[33], lay[0], bs[1], geo[0], geo[6], ntok, 1);
        q38-mv-batch-y(ps, lay[5], bs[1], bs[2], ntok, q38-bs2-stride(geo), 1);
        q38-mv-batch(ps, lay[6], bs[1], bs[24], ntok, 0);
        q38-mv-batch(ps, lay[7], bs[1], bs[25], ntok, 0);
        metal_enqueue(ps[34], q38-b16([bs[2], bs[22]], [nqhd, geo[14], 0, ntok, q38-bs2-stride(geo)], 0, 1), nqhd * ntok);
        metal_enqueue(ps[34], q38-b16([bs[2], bs[23]], [nqhd, geo[14], geo[14], ntok, q38-bs2-stride(geo)], 0, 0), nqhd * ntok);
        metal_enqueue(ps[35], q38-b16([bs[22], kth-tv-h(lay[8]), bs[22]], [geo[12], geo[14], geo[6], ntok], 0, 1), geo[12] * ntok);
        metal_enqueue(ps[35], q38-b16([bs[24], kth-tv-h(lay[9]), bs[24]], [geo[13], geo[14], geo[6], ntok], 0, 0), geo[13] * ntok);
        metal_enqueue(ps[36], q38-b16([bs[22]], [geo[12], geo[14], geo[15], pos0, geo[16], ntok], 0, 1), geo[12] * (geo[15] / 2) * ntok);
        metal_enqueue(ps[36], q38-b16([bs[24]], [geo[13], geo[14], geo[15], pos0, geo[16], ntok], 0, 0), geo[13] * (geo[15] / 2) * ntok);
        metal_enqueue(ps[37], q38-b16([bs[24], st[2]], [geo[20], pos0, ntok], 0, 1), geo[20] * ntok);
        metal_enqueue(ps[37], q38-b16([bs[25], st[3]], [geo[20], pos0, ntok], 0, 0), geo[20] * ntok);
        q38pa-enqueue(nth(ps, q38pa-index()), [bs[22], st[2], st[3], bs[26], bs[27]], [pos0, geo[12], geo[13], geo[14], geo[17], geo[18], ntok], geo[12] * ntok, 1);
        metal_enqueue(ps[17], q38-b16([bs[26], bs[23]], [nqhd * ntok], 0, 1), nqhd * ntok);
        q38-mv-batch(ps, lay[10], bs[26], bs[10], ntok, 1);
        metal_enqueue(ps[19], q38-b16([bs[33], bs[10], bs[33]], [geo[0] * ntok], 0, 1), geo[0] * ntok);
        1;
    };
    // A linear layer keeps the conv window and delta state recurrences ordered by
    // token. The surrounding projections, norms, gates, and residual own the
    // whole packed span. Two small Form loops retain causality; no carrier-side
    // state or hidden evaluator is introduced.
    def q38-linear-conv-span(ps, bs, geo, lay, st, t, ntok) = t >= ntok ? 1 : {
        let offsets = q38-linear-span-offsets(geo, t);
        metal_enqueue(nth(ps, qlslc-conv-offset-pipeline()), q38-b16([st[0], bs[2], kth-tv-h(lay[6]), bs[2]], [geo[1], geo[23], offsets[0]], 0, 1), geo[1]);
        q38-linear-conv-span(ps, bs, geo, lay, st, (Number) t + (Number) 1, ntok);
    };
    def q38-linear-delta-span(ps, bs, geo, st, t, ntok) = t >= ntok ? 1 : {
        let offsets = q38-linear-span-offsets(geo, t);
        metal_enqueue(nth(ps, qlslc-delta-offset-pipeline()), q38-b16([st[1], bs[2], bs[5], bs[6], bs[8]], [geo[3], geo[5], geo[4], geo[2], geo[7], offsets[0], offsets[1], offsets[2]], 0, 1), geo[3] * geo[5]);
        q38-linear-delta-span(ps, bs, geo, st, (Number) t + (Number) 1, ntok);
    };
    // fold = 1 issues each recurrence once with its token loop inside, and it
    // is the default: it reaches the dispatch floor (the model's count plus the
    // lane's five), answers the same token every pass, and — measured 2026-09-11
    // in one process, ten interleaved passes of a 577-token prefill — its GPU time
    // cannot be told apart from the looped walk's on this host, while the looped
    // walk spends at least 1,951 ms of host time per prefill encoding 57,719
    // dispatches against the fold's at most 111 (the dispatch-count model).
    // fold = 0 keeps the looped walk
    // reachable, and the fold A/B probe asks the question again.
    def q38-linear-attn-span-f(ps, bs, geo, lay, st, ntok, fold) = {
        let bs2-pitch = qlslc-bs2-output-pitch(geo);
        q38-rms-span(ps, bs[33], lay[0], bs[1], geo[0], geo[6], ntok, 1);
        // bs2 is deliberately pitched. The producer receives this value,
        // and every bs2 consumer receives the same value; no consumer
        // infers it from allocation size.
        q38-mv-batch-y(ps, lay[5], bs[1], bs[2], ntok, bs2-pitch, 1);
        q38-mv-batch(ps, lay[7], bs[1], bs[3], ntok, 0);
        q38-mv-batch(ps, lay[8], bs[1], bs[4], ntok, 0);
        q38-mv-batch(ps, lay[12], bs[1], bs[7], ntok, 0);
        (Comparable) fold == 1 ? metal_enqueue(nth(ps, qlslc-conv-span-pipeline()), q38-b16([st[0], bs[2], kth-tv-h(lay[6]), bs[2]], [geo[1], geo[23], bs2-pitch, ntok], 0, 1), geo[1]) : q38-linear-conv-span(ps, bs, geo, lay, st, 0, ntok);
        metal_enqueue(ps[8], q38-b16([bs[2]], [qlslc-bs2-allocation-elements(geo, ntok)], 0, 1), qlslc-bs2-allocation-elements(geo, ntok));
        metal_enqueue(nth(ps, qlslc-l2norm-span-pipeline()), q38-b16([bs[2]], [2 * geo[2], geo[4], geo[6], bs2-pitch, ntok], 0, 1), 2 * geo[2] * ntok);
        metal_enqueue(nth(ps, qlslc-gates-span-pipeline()), q38-b16([bs[3], bs[4], kth-tv-h(lay[9]), kth-tv-h(lay[10]), bs[5], bs[6]], [geo[3], ntok], 0, 1), geo[3] * ntok);
        (Comparable) fold == 1 ? q38-delta-span-run(ps, bs, geo, st, bs2-pitch, ntok) : q38-linear-delta-span(ps, bs, geo, st, 0, ntok);
        metal_enqueue(nth(ps, qlslc-norm-gate-span-pipeline()), q38-b16([bs[8], kth-tv-h(lay[11]), bs[7], bs[9]], [geo[3], geo[5], geo[6], ntok], 0, 1), geo[3] * ntok);
        q38-mv-batch(ps, lay[13], bs[9], bs[10], ntok, 1);
        metal_enqueue(ps[19], q38-b16([bs[33], bs[10], bs[33]], [geo[0] * ntok], 0, 1), geo[0] * ntok);
        1;
    };
    // The scalar/token-wise witness remains reachable unchanged for chunk=-2
    // and decode. Only the layer-major chunk=-3 lane selects the widened recipe.
    def q38-lm-linear(ps, bs, geo, lays, sts, l, t, n) = t >= n ? 1 : {
        q38-gather(ps, bs, geo, t, 1);
        q38-linear-attn(ps, bs, geo, nth(lays, l), nth(sts, l));
        q38-scatter(ps, bs, geo, t, 1);
        q38-lm-linear(ps, bs, geo, lays, sts, l, (Number) t + (Number) 1, n);
    };
    def q38-linear-attn-span(ps, bs, geo, lay, st, ntok) = q38-linear-attn-span-f(ps, bs, geo, lay, st, ntok, 1);
    def q38-linear-attn-span-looped(ps, bs, geo, lay, st, ntok) = q38-linear-attn-span-f(ps, bs, geo, lay, st, ntok, 0);
    // fold rides down to every linear layer's two recurrences, so one process
    // can walk the same span both ways against the same open weights
    // (the fold A/B probe). The default below is fold 1.
    def q38-lm-layers-span-f(ps, bs, geo, lays, sts, l, nL, n, pos0, fold) = l >= nL ? 1 : {
        kth-full?(l, geo[22]) ? q38-full-attn-span(ps, bs, geo, nth(lays, l), nth(sts, l), pos0, n) : q38-linear-attn-span-f(ps, bs, geo, nth(lays, l), nth(sts, l), n, fold);
        q38-ffn-span(ps, bs, geo, nth(lays, l), n);
        // the hand-over (decode's, below): the open batch goes to the queue every q38-submit-every() layers without waiting, so the device runs the
        // early layers while the host encodes the later ones; the host's ~1400 dispatches no longer run before the first begins
        let handed = q38-handover-after((Number) l + (Number) 1, nL);
        q38-lm-layers-span-f(ps, bs, geo, lays, sts, (Number) l + (Number) 1, nL, n, pos0, fold);
    };
    def q38-lm-layers-span(ps, bs, geo, lays, sts, l, nL, n, pos0) = q38-lm-layers-span-f(ps, bs, geo, lays, sts, l, nL, n, pos0, 1);
    def q38-prefill-span-batched-f(ps, bs, geo, lays, sts, embTv, onormTv, projTv, ids, pos, fold) = {
        let n = len(ids);
        metal_batch_concurrent();
        q38-lm-embed(ps, bs, geo, embTv, ids, 0);
        q38-lm-layers-span-f(ps, bs, geo, lays, sts, 0, geo[21], n, pos, fold);
        q38-gather(ps, bs, geo, n - 1, 1);
        [q38-head-only(ps, bs, geo, onormTv, projTv), (Number) pos + (Number) n];
    };
    def q38-prefill-span-batched(ps, bs, geo, lays, sts, embTv, onormTv, projTv, ids, pos) = q38-prefill-span-batched-f(ps, bs, geo, lays, sts, embTv, onormTv, projTv, ids, pos, 1);
    def q38-lm-embed(ps, bs, geo, embTv, ids, t) = (Comparable) len(ids) == 0 ? t : {
        q38-embed(ps, bs, geo, embTv, ids[0], 1);
        q38-scatter(ps, bs, geo, t, 1);
        q38-lm-embed(ps, bs, geo, embTv, ids[1:], (Number) t + (Number) 1);
    };
    def q38-lm-attn(ps, bs, geo, lays, sts, l, t, n, pos0) = t >= n ? 1 : {
        q38-gather(ps, bs, geo, t, 1);
        kth-full?(l, geo[22]) ? q38-full-attn(ps, bs, geo, nth(lays, l), nth(sts, l), (Number) pos0 + (Number) t) : q38-linear-attn(ps, bs, geo, nth(lays, l), nth(sts, l));
        q38-scatter(ps, bs, geo, t, 1);
        q38-lm-attn(ps, bs, geo, lays, sts, l, (Number) t + (Number) 1, n, pos0);
    };
    def q38-lm-layers(ps, bs, geo, lays, sts, l, nL, n, pos0) = l >= nL ? 1 : {
        q38-lm-attn(ps, bs, geo, lays, sts, l, 0, n, pos0);
        q38-ffn-span(ps, bs, geo, nth(lays, l), n);
        q38-lm-layers(ps, bs, geo, lays, sts, (Number) l + (Number) 1, nL, n, pos0);
    };
    def q38-head-only(ps, bs, geo, onormTv, projTv) = {
        q38-head(ps, bs, geo, onormTv, projTv);
        let bytes = metal_buf_read(bs[31], 0, 4);
        q38pc-head-bytes?(bytes) ? kth-u32at(bytes, 0) : -1;
    };
    def q38-prefill-lm(ps, bs, geo, lays, sts, embTv, onormTv, projTv, ids, pos) = {
        let n = len(ids);
        metal_batch_concurrent();
        q38-lm-embed(ps, bs, geo, embTv, ids, 0);
        q38-lm-layers(ps, bs, geo, lays, sts, 0, geo[21], n, pos);
        q38-gather(ps, bs, geo, n - 1, 1);
        // No sync here. q38-forward does not sync before its read either —
        // metal_buf_read submits the open batch and waits. Syncing first
        // CLOSES the batch, and the head's dispatches then have no batch to
        // land in, so the argmax read comes back from a buffer nothing wrote.
        [q38-head-only(ps, bs, geo, onormTv, projTv), (Number) pos + (Number) n];
    };
    def q38-blocks(ps, bs, geo, lays, sts, pos, l, n, interval) = q38-blocks-scoped(ps, bs, geo, lays, sts, pos, l, n, interval, nothing());
    // THE HAND-OVER: the open batch goes to the queue after every `q38-submit-every()` layers (0: never) without waiting, and the next
    // is armed, so the device starts on the early layers while the host encodes the later ones (a token encodes ~1265 dispatches in
    // ~23 ms of host time that used to run before the first one began). The queue runs a queue's batches in order; the one sync at
    // the end drains them all. The last layers stay in the open batch for the head to join.
    def q38-submit-every() = 2;
    def q38-handover() {
        let f = metal_submit();
        f > 0 ? metal_batch_concurrent() : 0;
    }
    def q38-handover-after(nl, n) = q38-submit-every() > 0 && nl < n && nl % q38-submit-every() == 0 ? q38-handover() : 0;
    def q38-blocks-scoped(ps, bs, geo, lays, sts, pos, l, n, interval, scope) = l >= n ? 1 : {
        kth-full?(l, interval) ? q38-full-attn-scoped(ps, bs, geo, nth(lays, l), nth(sts, l), pos, scope) : q38-linear-attn(ps, bs, geo, nth(lays, l), nth(sts, l));
        q38-ffn(ps, bs, geo, nth(lays, l));
        let handed = q38-handover-after((Number) l + (Number) 1, n);
        q38-blocks-scoped(ps, bs, geo, lays, sts, pos, (Number) l + (Number) 1, n, interval, scope);
    };
    def q38-head(ps, bs, geo, onormTv, projTv) = {
        q38-rms(ps, bs[0], onormTv, bs[1], geo[0], geo[6], 1);
        q38-mv(ps, projTv, bs[1], bs[28], 1);
        metal_enqueue(ps[25], q38-b16([bs[28], bs[29], bs[30]], [geo[19], 1024], 0, 1), 1024);
        metal_enqueue(ps[26], md-bind16([bs[29], bs[30], bs[31], bs[32]], [1024], 1024, 0, 1, 1), 1);
        0;
    };
    // This is the only adapted Qwen head.  It preserves the base path above
    // for unadapted turns and gives an admitted rank-one adapter one exact
    // point of effect: after output_norm, before the existing output.weight
    // matvec.  Nothing ever obtains a writable view of projTv.
    def q38-head-adapted(ps, bs, geo, onormTv, projTv, adapter) = {
        q38-rms(ps, bs[0], onormTv, bs[1], geo[0], geo[6], 1);
        q38-lora-rank1-apply(ps, bs[1], adapter, geo[0]);
        q38-mv(ps, projTv, bs[1], bs[28], 1);
        metal_enqueue(ps[25], q38-b16([bs[28], bs[29], bs[30]], [geo[19], 1024], 0, 1), 1024);
        metal_enqueue(ps[26], md-bind16([bs[29], bs[30], bs[31], bs[32]], [1024], 1024, 0, 1, 1), 1);
        0;
    };
    // The state half of a forward: embed the token and run every block, which is
    // what advances this position's stream state and KV rows.  It stops before the
    // head, because the head answers a QUESTION (which token is next) and a
    // position nobody asks about does not need it asked.
    def q38-forward-state(ps, bs, geo, lays, sts, embTv, id, pos) = q38-forward-state-scoped(ps, bs, geo, lays, sts, embTv, id, pos, nothing());
    def q38-forward-state-scoped(ps, bs, geo, lays, sts, embTv, id, pos, scope) = {
        metal_batch_concurrent();
        q38-embed(ps, bs, geo, embTv, id, 0);
        q38-blocks-scoped(ps, bs, geo, lays, sts, pos, 0, geo[21], geo[22], scope);
        1;
    };
    def q38-forward(ps, bs, geo, lays, sts, embTv, onormTv, projTv, id, pos) = {
        q38-forward-state(ps, bs, geo, lays, sts, embTv, id, pos);
        q38-head(ps, bs, geo, onormTv, projTv);
        kth-u32at(metal_buf_read(bs[31], 0, 4), 0);
    };
    // Opt-in scope entry. Refuse before advancing recurrent state or KV when
    // the plan cannot cover the present position inside the allocated cache.
    def q38-forward-scoped(ps, bs, geo, lays, sts, embTv, onormTv, projTv, id, pos, scope) = (Comparable) dam-valid?(scope, (Number) pos + (Number) 1) == 0 || pos >= geo[18] ? -1 : {
        q38-forward-state-scoped(ps, bs, geo, lays, sts, embTv, id, pos, scope);
        q38-head(ps, bs, geo, onormTv, projTv);
        kth-u32at(metal_buf_read(bs[31], 0, 4), 0);
    };
    // The adapted entry refuses a mismatched adapter before any model state is
    // advanced.  A successful token therefore crossed the device rank-one head,
    // never a merely named projection.
    def q38-forward-adapted(ps, bs, geo, lays, sts, embTv, onormTv, projTv, adapter, id, pos) = (Comparable) q38-lora-rank1-valid?(adapter, geo[0]) == 1 ? {
        q38-forward-state(ps, bs, geo, lays, sts, embTv, id, pos);
        q38-head-adapted(ps, bs, geo, onormTv, projTv, adapter);
        kth-u32at(metal_buf_read(bs[31], 0, 4), 0);
    } : 0 - 1;
    // Advance one position without asking the head.  metal_sync stands exactly
    // where the argmax read-back stood in a full forward: the batch is submitted
