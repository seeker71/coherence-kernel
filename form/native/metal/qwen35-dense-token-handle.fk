; qwen35-dense-token-handle.fk — dense Qwen3.5/Qwen3.8 decode held by Form through Metal.
;
; The architecture, geometry, tensor names, tensor types, tokenizer width, context limit, special
; token ids, and MTP count all arrive from the selected GGUF.  The only architecture decision here
; is the qwen35 algorithm itself: three Gated DeltaNet blocks followed by one full-attention block,
; dense SwiGLU after every attention half, and sigmoid on the full-attention output gate.
; MSL is assembled by Form and passed to metal_pipeline, so every kernel is JIT-compiled for the
; device that actually answered metal_status.  Model bytes remain mmap-backed no-copy buffers.
;
; preludes: native/metal/kat-token-handle.fk form-stdlib/qk-matmul-batch.fk native/metal/qwen35-linear-span-layout-contract.fk

(do
    ; Dense and MoE Qwen3.5 share the full-attention x * sigmoid(g) gate.  kth-msl owns that
    ; proven kernel at pipeline 17; dense appends the wide Q8_0 matvec whose 256-thread group owns
    ; two output rows.  The ordinary kth Q8 lane remains available to its existing callers.
    ; The batched Q8_0 matmul rides along: one weight decode serving eight
    ; activation columns, so a prefill span is one dispatch per weight tensor
    ; instead of one per token. Stone 7 proved the shape on the K-quant lane in
    ; July (metal_batched_prefill.sh, 5 gates); this lane never inherited it
    ; because the generator hardcoded a 256-weight superblock and Q8_0's is 32.
    ; A source-offset copy to sit beside kth-copyoff-msl's destination-offset one,
    ; and an rmsnorm over a span of rows. The span form is ONE THREAD PER TOKEN.
    ; That thread walks its row in ascending order, keeping ldm-rmsnorm-msl's
    ; serial sum and Newton-50 reciprocal exactly while remaining independent of
    ; model width. A first version copied ldm-rmsnorm-tg-msl's fixed sq[4096]
    ; scratch even though Qwen3.8 declares n=5120; a matching output from that
    ; out-of-radius kernel was useful evidence, never a correctness witness.
    (defn q38-copysoff-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& soff [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; d[i] = s[soff + i]; }")))

    (defn q38-rmsspan-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* y [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& eps [[buffer(4)]], constant uint& ntok [[buffer(5)]], uint tok [[thread_position_in_grid]]) { if (tok >= ntok) return; uint off = tok * n; float ss = 0.0f; uint j = 0u; while (j < n) { float xv = x[off + j]; ss = ss + xv * xv; j += 1u; } float meansq = ss / float(n); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; j = 0u; while (j < n) { float nm = x[off + j] * inv; y[off + j] = nm * g[j]; j += 1u; } }")))

    ; ── the batch axis, put into the operations ────────────────────────────
    ; Each of these is its per-token kernel with one dimension added: the token
    ; index t, a stride, and a bound ntok. The arithmetic is unchanged, line for
    ; line. What changes is that the loop over tokens moves from Form into the
    ; grid, so one dispatch covers the span instead of one dispatch per token.
    ;
    ; rope also folds the position in: it took `pos` as a constant, it now takes
    ; pos0 and reads its own t, so a span of positions needs no loop either.

    (defn q38-qsplit-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& hd [[buffer(3)]], constant uint& off [[buffer(4)]], constant uint& ntok [[buffer(5)]], constant uint& sstride [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint t = gid / n; if (t >= ntok) return; uint i = gid - t * n; uint h = i / hd; uint j = i - h * hd; d[t * n + i] = s[t * sstride + h * 2u * hd + off + j]; }")))

    (defn q38-headrms-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* x [[buffer(0)]], device const float* w [[buffer(1)]], device float* out [[buffer(2)]], constant uint& nh [[buffer(3)]], constant uint& hd [[buffer(4)]], constant float& eps [[buffer(5)]], constant uint& ntok [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint b = t * nh * hd + h * hd; float ss = 0.0f; for (uint j = 0u; j < hd; ++j) { float v = x[b + j]; ss = ss + v * v; } float meansq = ss / float(hd); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; for (uint j = 0u; j < hd; ++j) { out[b + j] = (x[b + j] * inv) * w[j]; }}")))

    (defn q38-rope-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* v [[buffer(0)]], constant uint& nh [[buffer(1)]], constant uint& hd [[buffer(2)]], constant uint& nrot [[buffer(3)]], constant uint& pos0 [[buffer(4)]], constant float& base [[buffer(5)]], constant uint& ntok [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint np = nrot / 2u; uint per = nh * np; uint t = gid / per; if (t >= ntok) return; uint r = gid - t * per; uint h = r / np; uint k = r - h * np; uint o = t * nh * hd + h * hd; float ex = (-2.0f * float(k)) / float(nrot); float fq = fpow(base, ex); float a = float(pos0 + t) * fq; float ca = fcos(a); float sa = fsin(a); uint i0 = o + k; uint i1 = o + k + np; float x0 = v[i0]; float x1 = v[i1]; float t0 = x0 * ca; float t1 = x1 * sa; v[i0] = t0 - t1; float t2 = x0 * sa; float t3 = x1 * ca; v[i1] = t2 + t3; }")))

    ; one dispatch writes a whole span of positions into the K or V cache
    (defn q38-cachespan-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& pos0 [[buffer(3)]], constant uint& ntok [[buffer(4)]], uint gid [[thread_position_in_grid]]) { uint t = gid / n; if (t >= ntok) return; uint i = gid - t * n; d[(pos0 + t) * n + i] = s[t * n + i]; }")))

    ; ── attention over a span ──────────────────────────────────────────────
    ; ldm-attn-msl scores ONE query against the cached prefix with one thread per
    ; query head — 24 threads, and GPU_GAPS.md line 82 has said so, unticked, the
    ; whole time: "prefill, which Stone 4 runs as n decode steps rather than a
    ; batched pass."
    ;
    ; This is that kernel with the token axis added. A thread per (token, head),
    ; so a 385-token span dispatches once with 9,240 threads instead of 385 times
    ; with 24. Causality is carried, not masked away: token t attends over
    ; pos0 + t + 1 positions, which is exactly what it saw one at a time.
    ;
    ; The score scratch grows the same way — (t * nq + h) rows instead of h — so
    ; every (token, head) has its own, and the two-pass softmax is untouched.
    (defn q38-attn-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& pos0 [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& ntok [[buffer(11)]], uint gid [[thread_position_in_grid]]) { uint tk = gid / nq; if (tk >= ntok) return; uint h = gid - tk * nq; uint npos = pos0 + tk + 1u; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = tk * nq * hd + h * hd; uint koff = kvh * hd; uint row = tk * nq + h; uint S = row * sstride; uint E = (ntok * nq + row) * sstride; uint t = 0; while (t < npos) { float acc = 0.0f; uint c = hd; while (c > 0) { c -= 1; float p = q[qoff + c] * kc[t * KVD + koff + c]; acc = p + acc; } sc[S + t] = acc * scale; t += 1; } float mx = sc[S + 0]; t = 1; while (t < npos) { if (sc[S + t] > mx) { mx = sc[S + t]; } t += 1; } float sumes = 0.0f; t = 0; while (t < npos) { float e = fexp(sc[S + t] - mx); sc[E + t] = e; sumes = sumes + e; t += 1; } float invs = 1.0f / sumes; t = 0; while (t < npos) { sc[S + t] = sc[E + t] * invs; t += 1; } uint i = 0; while (i < hd) { y[qoff + i] = 0.0f; i += 1; } t = 0; while (t < npos) { i = 0; while (i < hd) { float pv = vc[t * KVD + koff + i] * sc[S + t]; y[qoff + i] = y[qoff + i] + pv; i += 1; } t += 1; } }")))

    ; ── the linear block over a span ───────────────────────────────────────
    ; Eleven of the thirteen ops here do not care what order tokens arrive in.
    ; Two do: the conv window and the delta state are recurrences. Those keep
    ; their loop and gain only a token offset, so they can walk a span in place;
    ; the other eleven take the token axis into the grid.
    (defn q38-l2norm-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* x [[buffer(0)]], constant uint& nh [[buffer(1)]], constant uint& hd [[buffer(2)]], constant float& eps [[buffer(3)]], constant uint& stride [[buffer(4)]], constant uint& ntok [[buffer(5)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint o = t * stride + h * hd; float s = 0.0f; for (uint i = 0u; i < hd; ++i) { float v = x[o + i]; s = s + v * v; } float inv = 1.0f / fsqrt(s + eps); for (uint i = 0u; i < hd; ++i) { x[o + i] = x[o + i] * inv; } }")))

    (defn q38-gates-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* a [[buffer(0)]], device const float* b [[buffer(1)]], device const float* A [[buffer(2)]], device const float* dtb [[buffer(3)]], device float* alpha [[buffer(4)]], device float* beta [[buffer(5)]], constant uint& nh [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint o = t * nh + h; float x = a[o] + dtb[h]; float ax = (x < 0.0f) ? -x : x; float sp = ((x > 0.0f) ? x : 0.0f) + fln(1.0f + fexp(-1.0f * ax)); float g = A[h] * sp; alpha[o] = fexp(g); float bb = b[o]; beta[o] = 1.0f / (1.0f + fexp(-1.0f * bb)); }")))

    (defn q38-gnorm-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* o [[buffer(0)]], device const float* w [[buffer(1)]], device const float* z [[buffer(2)]], device float* out [[buffer(3)]], constant uint& nv [[buffer(4)]], constant uint& dv [[buffer(5)]], constant float& eps [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nv; if (t >= ntok) return; uint h = gid - t * nv; uint b = t * nv * dv + h * dv; float ss = 0.0f; for (uint j = 0u; j < dv; ++j) { float v = o[b + j]; ss = ss + v * v; } float meansq = ss / float(dv); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; for (uint j = 0u; j < dv; ++j) { float nm = (o[b + j] * inv) * w[j]; float zz = z[b + j]; float sg = 1.0f / (1.0f + fexp(-1.0f * zz)); out[b + j] = nm * (zz * sg); }}")))

    ; the two recurrences: same body, one offset so they can walk a span in place
    (defn q38-conv-off-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& toff [[buffer(6)]], uint c [[thread_position_in_grid]]) { if (c >= nch) return; uint b = c * kw; for (uint j = 0u; j + 1u < kw; ++j) { win[b + j] = win[b + j + 1u]; } win[b + kw - 1u] = x[toff + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + win[b + j] * w[b + j]; } y[toff + c] = acc; }")))

    (defn q38-delta-off-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& toff [[buffer(10)]], constant uint& goff [[buffer(11)]], constant uint& ooff [[buffer(12)]], uint gid [[thread_position_in_grid]]) { if (gid >= nv * dv) return; uint h = gid / dv; uint i = gid - h * dv; uint kh = h - (h / nk) * nk; device const float* q = c + toff + kh * dk; device const float* k = c + toff + nk * dk + kh * dk; float v = c[toff + 2u * nk * dk + h * dv + i]; uint r = (h * dv + i) * dk; float al = alpha[goff + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[goff + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[ooff + h * dv + i] = acc; }")))
    ; GQA decode with one 256-thread THREADGROUP per query head, replacing the
    ; one-thread-per-head dispatch for this walker only. Measured 2026-08-24
    ; (layer-kind-probe): the full-attention block cost 2113 us of GPU per
    ; token against ~450 us of weight traffic, and the serial kernel — 24
    ; threads for the whole layer on ~5120 ALUs — was the largest resident.
    ; Same buffers, same constants, same math; the reductions are simdgroup
    ; trees instead of one thread's loop, so float summation ORDER differs —
    ; an argmax could flip on a near-tie. The serial body stays in kth-msl for
    ; its other tenants (llama, kat); this is a new name, not a rewrite.
    (defn q38-gqa-tg-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& npos [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { uint h = tgpig.x; if (h >= nq) return; threadgroup float sh[16]; uint lid = (uint)sgitg * 32u + (uint)tiisg; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = h * hd; uint koff = kvh * hd; uint S = h * sstride; uint E = (nq + h) * sstride; for (uint t = lid; t < npos; t += 256u) { float acc = 0.0f; for (uint c = 0u; c < hd; ++c) { acc = metal::fma(q[qoff + c], kc[t * KVD + koff + c], acc); } sc[S + t] = acc * scale; } metal::threadgroup_barrier(metal::mem_flags::mem_device); float mx = -3.4e38f; for (uint t = lid; t < npos; t += 256u) { float v = sc[S + t]; if (v > mx) { mx = v; } } mx = metal::simd_max(mx); if (tiisg == 0) { sh[sgitg] = mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float gmx = sh[0]; for (uint k = 1u; k < 8u; ++k) { if (sh[k] > gmx) { gmx = sh[k]; } } float se = 0.0f; for (uint t = lid; t < npos; t += 256u) { float e = fexp(sc[S + t] - gmx); sc[E + t] = e; se = se + e; } se = metal::simd_sum(se); if (tiisg == 0) { sh[8u + sgitg] = se; } metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup); float tot = 0.0f; for (uint k = 0u; k < 8u; ++k) { tot = tot + sh[8u + k]; } float inv = 1.0f / tot; for (uint c = lid; c < hd; c += 256u) { float acc = 0.0f; for (uint t = 0u; t < npos; ++t) { acc = metal::fma(vc[t * KVD + koff + c], sc[E + t], acc); } y[qoff + c] = acc * inv; } }")))

    ; ── the recurrences, with their token loop folded inside ───────────────
    ; These two are sequential OVER TOKENS and independent over everything else:
    ; the conv window belongs to a channel, the delta state to an (h, i) pair,
    ; and no channel or pair ever reads another's. So the order that must be kept
    ; is a loop INSIDE each thread, not a loop outside the dispatch.
    ;
    ; The thread decomposition is unchanged — same threads, same state, same
    ; arithmetic in the same order — and 48 layers x 2 kernels x N tokens becomes
    ; 48 x 2. Nothing about the recurrence is weakened; it is simply not asked
    ; 385 separate times whether it would like to advance one step.
    ;
    ; They are emitted and given pipelines unconditionally, and REACHED only
    ; through fold=1. The looped offset kernels stay the default: the folded
    ; configuration reaches the dispatch floor with byte-identical output, but
    ; this host's 19% run-to-run spread swallows the timing difference, so which
    ; is faster is observed-as-unseparated, not decided (corpus row 1091).
    (defn q38-conv-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& stride [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint c [[thread_position_in_grid]]) { if (c >= nch) return; uint b = c * kw; for (uint t = 0u; t < ntok; ++t) { for (uint j = 0u; j + 1u < kw; ++j) { win[b + j] = win[b + j + 1u]; } win[b + kw - 1u] = x[t * stride + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + win[b + j] * w[b + j]; } y[t * stride + c] = acc; } }")))

    (defn q38-delta-span-msl (fname)
        (str_concat "kernel void "
        (str_concat fname
            " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& cstride [[buffer(10)]], constant uint& gstride [[buffer(11)]], constant uint& ostride [[buffer(12)]], constant uint& ntok [[buffer(13)]], uint gid [[thread_position_in_grid]]) { if (gid >= nv * dv) return; uint h = gid / dv; uint i = gid - h * dv; uint kh = h - (h / nk) * nk; uint r = (h * dv + i) * dk; for (uint t = 0u; t < ntok; ++t) { uint co = t * cstride; device const float* q = c + co + kh * dk; device const float* k = c + co + nk * dk + kh * dk; float v = c[co + 2u * nk * dk + h * dv + i]; float al = alpha[t * gstride + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[t * gstride + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[t * ostride + h * dv + i] = acc; } }")))

    ; The individual span emitters above remain independently testable. These
    ; two composers make their ordering data without redefining an emitter.
    (defn q38-linear-span-msl ()
        (str_concat (q38-l2norm-span-msl "form_gdn_l2norm_span_f32")
        (str_concat (q38-gates-span-msl "form_gdn_gates_span_f32")
        (str_concat (q38-gnorm-span-msl "form_gdn_norm_gate_span_f32")
        (str_concat (q38-conv-off-msl "form_gdn_conv_off_f32")
        (str_concat (q38-delta-off-msl "form_gdn_delta_off_f32")
        (str_concat (q38-conv-span-msl "form_gdn_conv_span_f32")
                    (q38-delta-span-msl "form_gdn_delta_span_f32"))))))))

    (defn q38-joined-attention-msl ()
        (str_concat (q38-qsplit-span-msl "form_qsplit_span_f32")
        (str_concat (q38-headrms-span-msl "form_headrms_span_f32")
        (str_concat (q38-rope-span-msl "form_partial_rope_span_f32")
        (str_concat (q38-cachespan-msl "form_cache_span_f32")
        (str_concat (q38-attn-span-msl "form_gqa_span_f32")
                    (q38-gqa-tg-msl "form_gqa_decode_tg_f32")))))))
    (defn q38-msl ()
        (str_concat (kth-msl)
        (str_concat (q80-matvec-wide-body "form_q8_0_matvec_wide_f32")
        (str_concat (qmb-q80-batch)
        (str_concat (q38-copysoff-msl "form_copy_soff_f32")
        (str_concat (q38-rmsspan-msl "form_rmsnorm_span_f32")
        (str_concat (q38-joined-attention-msl)
                    (q38-linear-span-msl))))))))

    ; Order here IS the pipeline order for indices 40..46, and the layout
    ; contract names each one. Appending is safe; inserting renumbers a
    ; consumer, which is exactly how a merge nearly dispatched gates-span
    ; where norm-gate was meant.
    (defn q38-linear-span-pipeline-names ()
        (list "form_gdn_l2norm_span_f32"
              "form_gdn_gates_span_f32"
              "form_gdn_norm_gate_span_f32"
              "form_gdn_conv_off_f32"
              "form_gdn_delta_off_f32"
              "form_gdn_conv_span_f32"
              "form_gdn_delta_span_f32"))

    ; kth-pipes owns indices 0..28.  Dense Qwen adds the cooperative Q8_0 matvec and the Q8_0 row
    ; dequant used by token_embd.weight.
    (defn q38-pipes (msl)
        (do
        (let linear (q38-linear-span-pipeline-names))
        (append (kth-pipes msl)
            (list (metal_pipeline msl "form_q8_0_matvec_wide_f32")
                  (metal_pipeline msl "form_q8_0_dequant_f32")
                  (metal_pipeline msl "form_q8_0_matmul_batch_f32")
                  (metal_pipeline msl "form_copy_soff_f32")
                  (metal_pipeline msl "form_rmsnorm_span_f32")
                  (metal_pipeline msl "form_qsplit_span_f32")
                  (metal_pipeline msl "form_headrms_span_f32")
                  (metal_pipeline msl "form_partial_rope_span_f32")
                  (metal_pipeline msl "form_cache_span_f32")
                  (metal_pipeline msl "form_gqa_span_f32")
                  (metal_pipeline msl "form_gqa_decode_tg_f32")
                  (metal_pipeline msl (nth linear 0))
                  (metal_pipeline msl (nth linear 1))
                  (metal_pipeline msl (nth linear 2))
                  (metal_pipeline msl (nth linear 3))
                  (metal_pipeline msl (nth linear 4))
                  (metal_pipeline msl (nth linear 5))
                  (metal_pipeline msl (nth linear 6))))))

    ; One exact 256-thread group per output-row pair for Q8_0.  All other declared types retain the
    ; already-proven KAT dispatches.  Qwen3.8-27B-Q8_0 declares every large matrix type 8 and every
    ; norm type 0.  md-bind16's mode=1 makes the op's threads argument a group count.
    ; A dense forward runs in the carrier's concurrent encoder.  The last bit is an explicit
    ; buffer-scope dependency before this dispatch: independent projections carry 0; their first
    ; consumer carries 1.  Nothing about dependency order is left to encoder insertion order.
    (defn q38-b16 (bufs consts mode barrier)
        (md-bind16 bufs consts 256 0 mode barrier))
    ; ldm-rmsnorm-tg-msl declares sq[4096]. Qwen3.8's model width is 5120,
    ; so the cooperative twin is available only inside its witnessed radius;
    ; wider rows use the serial attestant at pipeline 5. This choice is data,
    ; not a hardcoded Qwen exception, and the band probes both sides.
    (defn q38-rms-cooperative? (n) (le n 4096))
    (defn q38-rms (ps xh gtv yh n epsBits barrier)
        (if (q38-rms-cooperative? n)
            (metal_enqueue (nth ps 6)
                (q38-b16 (list xh (kth-tv-h gtv) yh) (list n epsBits) 1 barrier) 1)
            (metal_enqueue (nth ps 5)
                (q38-b16 (list xh (kth-tv-h gtv) yh) (list n epsBits) 0 barrier) 1)))
    (defn q38-mv (ps tv xh yh barrier)
        (if (eq (kth-tv-ty tv) 8)
            (metal_enqueue (nth ps 29)
                (md-bind16 (list (kth-tv-h tv) xh yh) (list (kth-tv-r tv) (kth-tv-c tv))
                    256 0 1 barrier)
                (div (add (kth-tv-r tv) 1) 2))
            (metal_enqueue
                (if (eq (kth-tv-ty tv) 12) (nth ps 1)
                (if (eq (kth-tv-ty tv) 14) (nth ps 3)
                (if (eq (kth-tv-ty tv) 8) (nth ps 4) (nth ps 27))))
                (q38-b16 (list (kth-tv-h tv) xh yh)
                    (list (kth-tv-r tv) (kth-tv-c tv)) 0 barrier)
                (kth-tv-r tv))))

    ; Dense layer table.  Common indices 0..4 are attn norm, post-attn norm, gate/up/down.  The tail
    ; is 5..13 for linear attention or 5..10 for full attention; its shape is selected from the
    ; file-declared interval, and every record offset/type/dimension comes from the tensor table.
    (defn q38-suffixes ()
        (list ".attn_norm.weight" ".post_attention_norm.weight"
              ".ffn_gate.weight" ".ffn_up.weight" ".ffn_down.weight"
              ".attn_qkv.weight" ".ssm_conv1d.weight" ".ssm_alpha.weight"
              ".ssm_beta.weight" ".ssm_a" ".ssm_dt.bias" ".ssm_norm.weight"
              ".attn_gate.weight" ".ssm_out.weight"
              ".attn_q.weight" ".attn_k.weight" ".attn_v.weight"
              ".attn_q_norm.weight" ".attn_k_norm.weight" ".attn_output.weight"))
    (defn q38-tabs-go (src sfx acc)
        (if (eq (len sfx) 0) (reverse acc)
            (q38-tabs-go src (tail sfx) (cons (gti-offs-with src (head sfx)) acc))))
    (defn q38-tabs (src) (q38-tabs-go src (q38-suffixes) (empty)))
    (defn q38-tv-for (src base path tabs k l)
        (kth-tv-at src base path (gti-off-for (nth tabs k) l)))
    (defn q38-layer-common (src base path tabs l)
        (list (q38-tv-for src base path tabs 0 l)
              (q38-tv-for src base path tabs 1 l)
              (q38-tv-for src base path tabs 2 l)
              (q38-tv-for src base path tabs 3 l)
              (q38-tv-for src base path tabs 4 l)))
    (defn q38-layer (src base path tabs l interval)
        (if (kth-full? l interval)
            (append (q38-layer-common src base path tabs l)
                (list (q38-tv-for src base path tabs 14 l)
                      (q38-tv-for src base path tabs 15 l)
                      (q38-tv-for src base path tabs 16 l)
                      (q38-tv-for src base path tabs 17 l)
                      (q38-tv-for src base path tabs 18 l)
                      (q38-tv-for src base path tabs 19 l)))
            (append (q38-layer-common src base path tabs l)
                (list (q38-tv-for src base path tabs 5 l)
                      (q38-tv-for src base path tabs 6 l)
                      (q38-tv-for src base path tabs 7 l)
                      (q38-tv-for src base path tabs 8 l)
                      (q38-tv-for src base path tabs 9 l)
                      (q38-tv-for src base path tabs 10 l)
                      (q38-tv-for src base path tabs 11 l)
                      (q38-tv-for src base path tabs 12 l)
                      (q38-tv-for src base path tabs 13 l)))))
    (defn q38-layers-go (src base path tabs l n interval acc)
        (if (ge l n) acc
            (q38-layers-go src base path tabs (add l 1) n interval
                (append acc (list (q38-layer src base path tabs l interval))))))
    (defn q38-layers (src base path n interval)
        (q38-layers-go src base path (q38-tabs src) 0 n interval (empty)))

    (defn q38-linear-attn (ps bs geo lay st)
        (do
            (q38-rms ps (nth bs 0) (nth lay 0) (nth bs 1) (nth geo 0) (nth geo 6) 1)
            (q38-mv ps (nth lay 5) (nth bs 1) (nth bs 2) 1)
            (q38-mv ps (nth lay 7) (nth bs 1) (nth bs 3) 0)
            (q38-mv ps (nth lay 8) (nth bs 1) (nth bs 4) 0)
            (q38-mv ps (nth lay 12) (nth bs 1) (nth bs 7) 0)
            (metal_enqueue (nth ps 7)
                (q38-b16 (list (nth st 0) (nth bs 2) (kth-tv-h (nth lay 6)) (nth bs 2))
                         (list (nth geo 1) (nth geo 23)) 0 1)
                (nth geo 1))
            (metal_enqueue (nth ps 8)
                (q38-b16 (list (nth bs 2)) (list (nth geo 1)) 0 1) (nth geo 1))
            (metal_enqueue (nth ps 9)
                (q38-b16 (list (nth bs 2))
                    (list (mul 2 (nth geo 2)) (nth geo 4) (nth geo 6)) 0 1)
                (mul 2 (nth geo 2)))
            (metal_enqueue (nth ps 10)
                (q38-b16 (list (nth bs 3) (nth bs 4) (kth-tv-h (nth lay 9)) (kth-tv-h (nth lay 10))
                               (nth bs 5) (nth bs 6))
                         (list (nth geo 3)) 0 0)
                (nth geo 3))
            (metal_enqueue (nth ps 11)
                (q38-b16 (list (nth st 1) (nth bs 2) (nth bs 5) (nth bs 6) (nth bs 8))
                         (list (nth geo 3) (nth geo 5) (nth geo 4) (nth geo 2) (nth geo 7)) 0 1)
                (mul (nth geo 3) (nth geo 5)))
            (metal_enqueue (nth ps 12)
                (q38-b16 (list (nth bs 8) (kth-tv-h (nth lay 11)) (nth bs 7) (nth bs 9))
                         (list (nth geo 3) (nth geo 5) (nth geo 6)) 0 1)
                (nth geo 3))
            (q38-mv ps (nth lay 13) (nth bs 9) (nth bs 10) 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 0) (nth bs 10) (nth bs 0)) (list (nth geo 0)) 0 1)
                (nth geo 0))
            1))

    (defn q38-full-attn (ps bs geo lay st pos)
        (do
            (q38-rms ps (nth bs 0) (nth lay 0) (nth bs 1) (nth geo 0) (nth geo 6) 1)
            (q38-mv ps (nth lay 5) (nth bs 1) (nth bs 2) 1)
            (q38-mv ps (nth lay 6) (nth bs 1) (nth bs 24) 0)
            (q38-mv ps (nth lay 7) (nth bs 1) (nth bs 25) 0)
            (metal_enqueue (nth ps 14)
                (q38-b16 (list (nth bs 2) (nth bs 22))
                         (list (mul (nth geo 12) (nth geo 14)) (nth geo 14) 0) 0 1)
                (mul (nth geo 12) (nth geo 14)))
            (metal_enqueue (nth ps 14)
                (q38-b16 (list (nth bs 2) (nth bs 23))
                         (list (mul (nth geo 12) (nth geo 14)) (nth geo 14) (nth geo 14)) 0 0)
                (mul (nth geo 12) (nth geo 14)))
            (metal_enqueue (nth ps 13)
                (q38-b16 (list (nth bs 22) (kth-tv-h (nth lay 8)) (nth bs 22))
                         (list (nth geo 12) (nth geo 14) (nth geo 6)) 0 1)
                (nth geo 12))
            (metal_enqueue (nth ps 13)
                (q38-b16 (list (nth bs 24) (kth-tv-h (nth lay 9)) (nth bs 24))
                         (list (nth geo 13) (nth geo 14) (nth geo 6)) 0 0)
                (nth geo 13))
            (metal_enqueue (nth ps 15)
                (q38-b16 (list (nth bs 22))
                         (list (nth geo 12) (nth geo 14) (nth geo 15) pos (nth geo 16)) 0 1)
                (mul (nth geo 12) (div (nth geo 15) 2)))
            (metal_enqueue (nth ps 15)
                (q38-b16 (list (nth bs 24))
                         (list (nth geo 13) (nth geo 14) (nth geo 15) pos (nth geo 16)) 0 0)
                (mul (nth geo 13) (div (nth geo 15) 2)))
            (metal_enqueue (nth ps 24)
                (q38-b16 (list (nth bs 24) (nth st 2))
                    (list (nth geo 20) (mul pos (nth geo 20))) 0 1)
                (nth geo 20))
            (metal_enqueue (nth ps 24)
                (q38-b16 (list (nth bs 25) (nth st 3))
                    (list (nth geo 20) (mul pos (nth geo 20))) 0 0)
                (nth geo 20))
            ; pipeline 39: one 256-thread threadgroup per head (mode 1 makes the
            ; threads argument a GROUP count). The serial one-thread-per-head
            ; dispatch this replaces cost the block ~1.7 ms of its 2.1 ms
            ; (2026-08-24, layer-kind-probe: 2113 -> 553 us per block).
            (metal_enqueue (nth ps (qlslc-cooperative-gqa-pipeline))
                (q38-b16 (list (nth bs 22) (nth st 2) (nth st 3) (nth bs 26) (nth bs 27))
                         (list (add pos 1) (nth geo 12) (nth geo 13) (nth geo 14)
                               (nth geo 17) (nth geo 18)) 1 1)
                (nth geo 12))
            (metal_enqueue (nth ps 17)
                (q38-b16 (list (nth bs 26) (nth bs 23))
                    (list (mul (nth geo 12) (nth geo 14))) 0 1)
                (mul (nth geo 12) (nth geo 14)))
            (q38-mv ps (nth lay 10) (nth bs 26) (nth bs 10) 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 0) (nth bs 10) (nth bs 0)) (list (nth geo 0)) 0 1)
                (nth geo 0))
            1))

    (defn q38-ffn (ps bs geo lay)
        (do
            (q38-rms ps (nth bs 0) (nth lay 1) (nth bs 1) (nth geo 0) (nth geo 6) 1)
            (q38-mv ps (nth lay 2) (nth bs 1) (nth bs 14) 1)
            (q38-mv ps (nth lay 3) (nth bs 1) (nth bs 15) 0)
            (metal_enqueue (nth ps 18)
                (q38-b16 (list (nth bs 14) (nth bs 15) (nth bs 16))
                    (list (nth geo 10)) 0 1)
                (nth geo 10))
            (q38-mv ps (nth lay 4) (nth bs 16) (nth bs 17) 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 0) (nth bs 17) (nth bs 0)) (list (nth geo 0)) 0 1)
                (nth geo 0))
            1))

    ; ── the batched matmul, dispatched ─────────────────────────────────────
    ; form_q8_0_matmul_batch_f32 takes rows, cols and ntok, reads x[t*cols+j] and
    ; writes y[t*rows+r]. Grid is rows * ceil(ntok/8) * 32 with a threadgroup that
    ; is a multiple of 32, and mode 0 so the threads argument is the total thread
    ; count rather than a group count.
    ;
    ; At ntok 1 this replaces one matvec with one matmul over a single column —
    ; the same work, the same dispatch count, through the batched path. That is
    ; the point of running it at 1 first: it puts the binding, the grid and the
    ; token-major layout under the body's own witness before the loop order
    ; changes underneath them.
    ; bs2 is allocated at convcap = max(2*nq*hd, geo1) per token, not geo1 and
    ; not 2*nq*hd. Anything indexing a span of it must use that width; guessing
    ; either operand reads off the end of the token before it.
    (defn q38-bs2-stride (geo)
        (qlslc-bs2-output-pitch geo))

    ; ystride is the OUTPUT buffer's per-token width, which is not always rows:
    ; bs2 is allocated at convcap so that one buffer can serve both the fused
    ; q||gate projection and the linear block's wider one. Writing at `rows`
    ; there lays each token down at the wrong pitch and everything downstream
    ; reads the token before it.
    (defn q38-mv-batch-y (ps tv xh yh ntok ystride barrier)
        (metal_enqueue (nth ps 31)
            (md-bind16 (list (kth-tv-h tv) xh yh)
                (list (kth-tv-r tv) (kth-tv-c tv) ntok ystride)
                256 0 0 barrier)
            (mul (mul (kth-tv-r tv) (div (add ntok 7) 8)) 32)))

    (defn q38-mv-batch (ps tv xh yh ntok barrier)
        (q38-mv-batch-y ps tv xh yh ntok (kth-tv-r tv) barrier))

    ; Independent identities for the three token-major linear-attention rows.
    ; bs2 uses the producer-bound output pitch; gates are nv-wide, and delta
    ; output is nv*dv-wide. The pitch may equal allocation capacity only because
    ; q38-mv-batch-y writes it explicitly. Invalid tokens remain nothing rather
    ; than becoming the present integer 0.
    (defn q38-linear-span-offsets (geo token)
        (if (lt token 0) (nothing)
            (list (qlslc-bs2-token-offset geo token)
                  (mul token (nth geo 3))
                  (mul token (mul (nth geo 3) (nth geo 5))))))

    ; The FFN with its three matmuls on the batched kernel. rms, the swiglu gate
    ; and the residual add are unchanged: at ntok 1 they are already right, and at
    ; ntok > 1 they are the next three kernels to widen.
    (defn q38-ffn-b (ps bs geo lay ntok)
        (do
            (q38-rms ps (nth bs 0) (nth lay 1) (nth bs 1) (nth geo 0) (nth geo 6) 1)
            (q38-mv-batch ps (nth lay 2) (nth bs 1) (nth bs 14) ntok 1)
            (q38-mv-batch ps (nth lay 3) (nth bs 1) (nth bs 15) ntok 0)
            (metal_enqueue (nth ps 18)
                (q38-b16 (list (nth bs 14) (nth bs 15) (nth bs 16))
                    (list (nth geo 10)) 0 1)
                (nth geo 10))
            (q38-mv-batch ps (nth lay 4) (nth bs 16) (nth bs 17) ntok 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 0) (nth bs 17) (nth bs 0)) (list (nth geo 0)) 0 1)
                (nth geo 0))
            1))

    (defn q38-blocks-b (ps bs geo lays sts pos l n interval ntok)
        (if (ge l n) 1
            (do (if (kth-full? l interval)
                    (q38-full-attn ps bs geo (nth lays l) (nth sts l) pos)
                    (q38-linear-attn ps bs geo (nth lays l) (nth sts l)))
                (q38-ffn-b ps bs geo (nth lays l) ntok)
                (q38-blocks-b ps bs geo lays sts pos (add l 1) n interval ntok))))

    (defn q38-forward-state-b (ps bs geo lays sts embTv id pos barrier ntok)
        (do
            (metal_enqueue (nth ps 30)
                (q38-b16 (list (kth-tv-h embTv) (nth bs 0))
                         (list (mul id (nth geo 0)) (nth geo 0)) 0 barrier)
                (nth geo 0))
            (q38-blocks-b ps bs geo lays sts pos 0 (nth geo 21) (nth geo 22) ntok)
            1))

    (defn q38-prefill-mvb-go (ps bs geo lays sts embTv onormTv projTv ids pos)
        (if (eq (len ids) 1)
            (do (metal_sync)
                (list (q38-forward ps bs geo lays sts embTv onormTv projTv (head ids) pos)
                      (add pos 1)))
            (do (q38-forward-state-b ps bs geo lays sts embTv (head ids) pos 1 1)
                (q38-prefill-mvb-go ps bs geo lays sts embTv onormTv projTv
                    (tail ids) (add pos 1)))))

    (defn q38-prefill-mvb (ps bs geo lays sts embTv onormTv projTv ids pos)
        (do (metal_batch_concurrent)
            (q38-prefill-mvb-go ps bs geo lays sts embTv onormTv projTv ids pos)))

    ; ── layer-major prefill ────────────────────────────────────────────────
    ; dsv4-decode-loop.fk transcribed the shape from ds4.c: prefill is
    ; LAYER-MAJOR — all prompt tokens pass through layer 0, then layer 1. Decode
    ; is token-major. They are two schedules over the same rows.
    ;
    ; The recurrences are carried, not assumed away. Inside a layer the tokens
    ; still walk in order, so form_gdn_conv_f32's window state and
    ; form_gdn_delta_heads_f32's delta state evolve position by position exactly
    ; as they do today, and form_gqa_decode_f32 sees every earlier position's KV
    ; already written. What changes is only which loop is outer.
    ;
    ; Attention keeps its single-position working set: each token is gathered out
    ; of the token-major residual stream (bs 33) into slot 0, run, and scattered
    ; back. That costs two copies per token per layer and buys a FFN that sees
    ; the whole span at once — six dispatches per layer instead of six per token.
    (defn q38-scatter (ps bs geo t barrier)
        (metal_enqueue (nth ps 24)
            (q38-b16 (list (nth bs 0) (nth bs 33))
                     (list (nth geo 0) (mul t (nth geo 0))) 0 barrier)
            (nth geo 0)))

    (defn q38-gather (ps bs geo t barrier)
        (metal_enqueue (nth ps 32)
            (q38-b16 (list (nth bs 33) (nth bs 0))
                     (list (nth geo 0) (mul t (nth geo 0))) 0 barrier)
            (nth geo 0)))

    (defn q38-rms-span (ps xh gtv yh n epsBits ntok barrier)
        (metal_enqueue (nth ps 33)
            (md-bind16 (list xh (kth-tv-h gtv) yh) (list n epsBits ntok) 256 0 0 barrier)
            ntok))

    ; The FFN over the whole span. rms is per-row across ntok rows; the three
    ; matmuls are the batched kernel at its real width; swiglu and the residual
    ; add are elementwise, so they simply run over n * ntok contiguous values.
    (defn q38-ffn-span (ps bs geo lay ntok)
        (do
            (q38-rms-span ps (nth bs 33) (nth lay 1) (nth bs 1) (nth geo 0) (nth geo 6) ntok 1)
            (q38-mv-batch ps (nth lay 2) (nth bs 1) (nth bs 14) ntok 1)
            (q38-mv-batch ps (nth lay 3) (nth bs 1) (nth bs 15) ntok 0)
            (metal_enqueue (nth ps 18)
                (q38-b16 (list (nth bs 14) (nth bs 15) (nth bs 16))
                    (list (mul (nth geo 10) ntok)) 0 1)
                (mul (nth geo 10) ntok))
            (q38-mv-batch ps (nth lay 4) (nth bs 16) (nth bs 17) ntok 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 33) (nth bs 17) (nth bs 33))
                    (list (mul (nth geo 0) ntok)) 0 1)
                (mul (nth geo 0) ntok))
            1))

    ; ── the full-attention block over a span ───────────────────────────────
    ; Every op here is the per-token one with the token axis in the operation
    ; instead of a loop around it. The stream is identical, line for line; it is
    ; issued once for the span rather than once per position.
    (defn q38-full-attn-span (ps bs geo lay st pos0 ntok)
        (do
            (let nqhd (mul (nth geo 12) (nth geo 14)))
            (let nkvhd (mul (nth geo 13) (nth geo 14)))
            (q38-rms-span ps (nth bs 33) (nth lay 0) (nth bs 1) (nth geo 0) (nth geo 6) ntok 1)
            (q38-mv-batch-y ps (nth lay 5) (nth bs 1) (nth bs 2) ntok (q38-bs2-stride geo) 1)
            (q38-mv-batch ps (nth lay 6) (nth bs 1) (nth bs 24) ntok 0)
            (q38-mv-batch ps (nth lay 7) (nth bs 1) (nth bs 25) ntok 0)
            (metal_enqueue (nth ps 34)
                (q38-b16 (list (nth bs 2) (nth bs 22))
                         (list nqhd (nth geo 14) 0 ntok (q38-bs2-stride geo)) 0 1)
                (mul nqhd ntok))
            (metal_enqueue (nth ps 34)
                (q38-b16 (list (nth bs 2) (nth bs 23))
                         (list nqhd (nth geo 14) (nth geo 14) ntok (q38-bs2-stride geo)) 0 0)
                (mul nqhd ntok))
            (metal_enqueue (nth ps 35)
                (q38-b16 (list (nth bs 22) (kth-tv-h (nth lay 8)) (nth bs 22))
                         (list (nth geo 12) (nth geo 14) (nth geo 6) ntok) 0 1)
                (mul (nth geo 12) ntok))
            (metal_enqueue (nth ps 35)
                (q38-b16 (list (nth bs 24) (kth-tv-h (nth lay 9)) (nth bs 24))
                         (list (nth geo 13) (nth geo 14) (nth geo 6) ntok) 0 0)
                (mul (nth geo 13) ntok))
            (metal_enqueue (nth ps 36)
                (q38-b16 (list (nth bs 22))
                         (list (nth geo 12) (nth geo 14) (nth geo 15) pos0 (nth geo 16) ntok) 0 1)
                (mul (mul (nth geo 12) (div (nth geo 15) 2)) ntok))
            (metal_enqueue (nth ps 36)
                (q38-b16 (list (nth bs 24))
                         (list (nth geo 13) (nth geo 14) (nth geo 15) pos0 (nth geo 16) ntok) 0 0)
                (mul (mul (nth geo 13) (div (nth geo 15) 2)) ntok))
            (metal_enqueue (nth ps 37)
                (q38-b16 (list (nth bs 24) (nth st 2)) (list (nth geo 20) pos0 ntok) 0 1)
                (mul (nth geo 20) ntok))
            (metal_enqueue (nth ps 37)
                (q38-b16 (list (nth bs 25) (nth st 3)) (list (nth geo 20) pos0 ntok) 0 0)
                (mul (nth geo 20) ntok))
            (metal_enqueue (nth ps 38)
                (q38-b16 (list (nth bs 22) (nth st 2) (nth st 3) (nth bs 26) (nth bs 27))
                         (list pos0 (nth geo 12) (nth geo 13) (nth geo 14)
                               (nth geo 17) (nth geo 18) ntok) 0 1)
                (mul (nth geo 12) ntok))
            (metal_enqueue (nth ps 17)
                (q38-b16 (list (nth bs 26) (nth bs 23)) (list (mul nqhd ntok)) 0 1)
                (mul nqhd ntok))
            (q38-mv-batch ps (nth lay 10) (nth bs 26) (nth bs 10) ntok 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 33) (nth bs 10) (nth bs 33))
                    (list (mul (nth geo 0) ntok)) 0 1)
                (mul (nth geo 0) ntok))
            1))

    ; A linear layer keeps the conv window and delta state recurrences ordered by
    ; token. The surrounding projections, norms, gates, and residual own the
    ; whole packed span. Two small Form loops retain causality; no carrier-side
    ; state or hidden evaluator is introduced.
    (defn q38-linear-conv-span (ps bs geo lay st t ntok)
        (if (ge t ntok) 1
            (do
                (let offsets (q38-linear-span-offsets geo t))
                (metal_enqueue (nth ps (qlslc-conv-offset-pipeline))
                    (q38-b16
                        (list (nth st 0) (nth bs 2) (kth-tv-h (nth lay 6)) (nth bs 2))
                        (list (nth geo 1) (nth geo 23) (nth offsets 0)) 0 1)
                    (nth geo 1))
                (q38-linear-conv-span ps bs geo lay st (add t 1) ntok))))

    (defn q38-linear-delta-span (ps bs geo st t ntok)
        (if (ge t ntok) 1
            (do
                (let offsets (q38-linear-span-offsets geo t))
                (metal_enqueue (nth ps (qlslc-delta-offset-pipeline))
                    (q38-b16
                        (list (nth st 1) (nth bs 2) (nth bs 5) (nth bs 6) (nth bs 8))
                        (list (nth geo 3) (nth geo 5) (nth geo 4) (nth geo 2) (nth geo 7)
                              (nth offsets 0) (nth offsets 1) (nth offsets 2)) 0 1)
                    (mul (nth geo 3) (nth geo 5)))
                (q38-linear-delta-span ps bs geo st (add t 1) ntok))))

        ; fold = 1 issues each recurrence once with its token loop inside. MEASURED
    ; 2026-08-25 and NOT the default: it reaches the dispatch floor exactly
    ; (75,769 against a predicted 75,673) and costs 31% more GPU and 10% more
    ; wall, because one long low-occupancy kernel that nothing can overlap is
    ; worse than N short ones inside a concurrent batch. Kept reachable so the
    ; measurement stands and nobody pays for it twice.
    (defn q38-linear-attn-span-f (ps bs geo lay st ntok fold)
        (do
            (let bs2-pitch (qlslc-bs2-output-pitch geo))
            (q38-rms-span ps (nth bs 33) (nth lay 0) (nth bs 1)
                          (nth geo 0) (nth geo 6) ntok 1)
            ; bs2 is deliberately pitched. The producer receives this value,
            ; and every bs2 consumer receives the same value; no consumer
            ; infers it from allocation size.
            (q38-mv-batch-y ps (nth lay 5) (nth bs 1) (nth bs 2)
                            ntok bs2-pitch 1)
            (q38-mv-batch ps (nth lay 7) (nth bs 1) (nth bs 3) ntok 0)
            (q38-mv-batch ps (nth lay 8) (nth bs 1) (nth bs 4) ntok 0)
            (q38-mv-batch ps (nth lay 12) (nth bs 1) (nth bs 7) ntok 0)
            (if (eq fold 1)
                (metal_enqueue (nth ps (qlslc-conv-span-pipeline))
                    (q38-b16 (list (nth st 0) (nth bs 2) (kth-tv-h (nth lay 6)) (nth bs 2))
                             (list (nth geo 1) (nth geo 23) bs2-pitch ntok) 0 1)
                    (nth geo 1))
                (q38-linear-conv-span ps bs geo lay st 0 ntok))
            (metal_enqueue (nth ps 8)
                (q38-b16 (list (nth bs 2))
                         (list (qlslc-bs2-allocation-elements geo ntok)) 0 1)
                (qlslc-bs2-allocation-elements geo ntok))
            (metal_enqueue (nth ps (qlslc-l2norm-span-pipeline))
                (q38-b16 (list (nth bs 2))
                    (list (mul 2 (nth geo 2)) (nth geo 4) (nth geo 6)
                          bs2-pitch ntok) 0 1)
                (mul (mul 2 (nth geo 2)) ntok))
            (metal_enqueue (nth ps (qlslc-gates-span-pipeline))
                (q38-b16
                    (list (nth bs 3) (nth bs 4) (kth-tv-h (nth lay 9))
                          (kth-tv-h (nth lay 10)) (nth bs 5) (nth bs 6))
                    (list (nth geo 3) ntok) 0 1)
                (mul (nth geo 3) ntok))
            (if (eq fold 1)
                (metal_enqueue (nth ps (qlslc-delta-span-pipeline))
                    (q38-b16 (list (nth st 1) (nth bs 2) (nth bs 5) (nth bs 6) (nth bs 8))
                             (list (nth geo 3) (nth geo 5) (nth geo 4) (nth geo 2) (nth geo 7)
                                   bs2-pitch (nth geo 3)
                                   (mul (nth geo 3) (nth geo 5)) ntok) 0 1)
                    (mul (nth geo 3) (nth geo 5)))
                (q38-linear-delta-span ps bs geo st 0 ntok))
            (metal_enqueue (nth ps (qlslc-norm-gate-span-pipeline))
                (q38-b16
                    (list (nth bs 8) (kth-tv-h (nth lay 11)) (nth bs 7) (nth bs 9))
                    (list (nth geo 3) (nth geo 5) (nth geo 6) ntok) 0 1)
                (mul (nth geo 3) ntok))
            (q38-mv-batch ps (nth lay 13) (nth bs 9) (nth bs 10) ntok 1)
            (metal_enqueue (nth ps 19)
                (q38-b16 (list (nth bs 33) (nth bs 10) (nth bs 33))
                    (list (mul (nth geo 0) ntok)) 0 1)
                (mul (nth geo 0) ntok))
            1))

    ; The scalar/token-wise witness remains reachable unchanged for chunk=-2
    ; and decode. Only the layer-major chunk=-3 lane selects the widened recipe.
    (defn q38-lm-linear (ps bs geo lays sts l t n)
        (if (ge t n) 1
            (do (q38-gather ps bs geo t 1)
                (q38-linear-attn ps bs geo (nth lays l) (nth sts l))
                (q38-scatter ps bs geo t 1)
                (q38-lm-linear ps bs geo lays sts l (add t 1) n))))

    (defn q38-linear-attn-span (ps bs geo lay st ntok)
        (q38-linear-attn-span-f ps bs geo lay st ntok 0))
    (defn q38-linear-attn-span-folded (ps bs geo lay st ntok)
        (q38-linear-attn-span-f ps bs geo lay st ntok 1))

    (defn q38-lm-layers-span (ps bs geo lays sts l nL n pos0)
        (if (ge l nL) 1
            (do (if (kth-full? l (nth geo 22))
                    (q38-full-attn-span ps bs geo (nth lays l) (nth sts l) pos0 n)
                    (q38-linear-attn-span ps bs geo (nth lays l) (nth sts l) n))
                (q38-ffn-span ps bs geo (nth lays l) n)
                (q38-lm-layers-span ps bs geo lays sts (add l 1) nL n pos0))))

    (defn q38-prefill-span-batched (ps bs geo lays sts embTv onormTv projTv ids pos)
        (do
            (let n (len ids))
            (metal_batch_concurrent)
            (q38-lm-embed ps bs geo embTv ids 0)
            (q38-lm-layers-span ps bs geo lays sts 0 (nth geo 21) n pos)
            (q38-gather ps bs geo (sub n 1) 1)
            (list (q38-head-only ps bs geo onormTv projTv) (add pos n))))

    (defn q38-lm-embed (ps bs geo embTv ids t)
        (if (eq (len ids) 0) t
            (do (metal_enqueue (nth ps 30)
                    (q38-b16 (list (kth-tv-h embTv) (nth bs 0))
                        (list (mul (head ids) (nth geo 0)) (nth geo 0)) 0 1)
                    (nth geo 0))
                (q38-scatter ps bs geo t 1)
                (q38-lm-embed ps bs geo embTv (tail ids) (add t 1)))))

    (defn q38-lm-attn (ps bs geo lays sts l t n pos0)
        (if (ge t n) 1
            (do (q38-gather ps bs geo t 1)
                (if (kth-full? l (nth geo 22))
                    (q38-full-attn ps bs geo (nth lays l) (nth sts l) (add pos0 t))
                    (q38-linear-attn ps bs geo (nth lays l) (nth sts l)))
                (q38-scatter ps bs geo t 1)
                (q38-lm-attn ps bs geo lays sts l (add t 1) n pos0))))

    (defn q38-lm-layers (ps bs geo lays sts l nL n pos0)
        (if (ge l nL) 1
            (do (q38-lm-attn ps bs geo lays sts l 0 n pos0)
                (q38-ffn-span ps bs geo (nth lays l) n)
                (q38-lm-layers ps bs geo lays sts (add l 1) nL n pos0))))

    (defn q38-head-only (ps bs geo onormTv projTv)
        (do (q38-head ps bs geo onormTv projTv)
            (kth-u32at (metal_buf_read (nth bs 31) 0 4) 0)))

    (defn q38-prefill-lm (ps bs geo lays sts embTv onormTv projTv ids pos)
        (do
            (let n (len ids))
            (metal_batch_concurrent)
            (q38-lm-embed ps bs geo embTv ids 0)
            (q38-lm-layers ps bs geo lays sts 0 (nth geo 21) n pos)
            (q38-gather ps bs geo (sub n 1) 1)
            ; No sync here. q38-forward does not sync before its read either —
            ; metal_buf_read submits the open batch and waits. Syncing first
            ; CLOSES the batch, and the head's dispatches then have no batch to
            ; land in, so the argmax read comes back from a buffer nothing wrote.
            (list (q38-head-only ps bs geo onormTv projTv) (add pos n))))

    (defn q38-blocks (ps bs geo lays sts pos l n interval)
        (if (ge l n) 1
            (do (if (kth-full? l interval)
                    (q38-full-attn ps bs geo (nth lays l) (nth sts l) pos)
                    (q38-linear-attn ps bs geo (nth lays l) (nth sts l)))
                (q38-ffn ps bs geo (nth lays l))
                (q38-blocks ps bs geo lays sts pos (add l 1) n interval))))

    (defn q38-head (ps bs geo onormTv projTv)
        (do
            (q38-rms ps (nth bs 0) onormTv (nth bs 1) (nth geo 0) (nth geo 6) 1)
            (q38-mv ps projTv (nth bs 1) (nth bs 28) 1)
            (metal_enqueue (nth ps 25)
                (q38-b16 (list (nth bs 28) (nth bs 29) (nth bs 30))
                    (list (nth geo 19) 1024) 0 1)
                1024)
            (metal_enqueue (nth ps 26)
                (md-bind16 (list (nth bs 29) (nth bs 30) (nth bs 31) (nth bs 32))
                           (list 1024) 1024 0 1 1)
                1)
            0))

    ; The state half of a forward: embed the token and run every block, which is
    ; what advances this position's stream state and KV rows.  It stops before the
    ; head, because the head answers a QUESTION (which token is next) and a
    ; position nobody asks about does not need it asked.
    (defn q38-forward-state (ps bs geo lays sts embTv id pos)
        (do
            (metal_batch_concurrent)
            (metal_enqueue (nth ps 30)
                (q38-b16 (list (kth-tv-h embTv) (nth bs 0))
                         (list (mul id (nth geo 0)) (nth geo 0)) 0 0)
                (nth geo 0))
            (q38-blocks ps bs geo lays sts pos 0 (nth geo 21) (nth geo 22))
            1))

    (defn q38-forward (ps bs geo lays sts embTv onormTv projTv id pos)
        (do
            (q38-forward-state ps bs geo lays sts embTv id pos)
            (q38-head ps bs geo onormTv projTv)
            (kth-u32at (metal_buf_read (nth bs 31) 0 4) 0)))

    ; Advance one position without asking the head.  metal_sync stands exactly
    ; where the argmax read-back stood in a full forward: the batch is submitted
    ; and waited on before the next position is encoded, so this position's state
    ; and KV writes are complete before the next one reads them.  Same ordering,
    ; one fewer question.
    (defn q38-advance (ps bs geo lays sts embTv id pos)
        (do
            (q38-forward-state ps bs geo lays sts embTv id pos)
            (metal_sync)
            1))

    (defn q38-stop? (id stops)
        (if (eq (len stops) 0) 0
            (if (eq id (head stops)) 1 (q38-stop? id (tail stops)))))
    (defn q38-generate (ps bs geo lays sts embTv onormTv projTv id pos n stops acc)
        (if (le n 0) acc
            (do (let nid (q38-forward ps bs geo lays sts embTv onormTv projTv id pos))
                (if (if (lt nid 0) 1 (q38-stop? nid stops)) acc
                    (q38-generate ps bs geo lays sts embTv onormTv projTv
                                  nid (add pos 1) (sub n 1) stops (append acc (list nid)))))))

    ; Prefill asks the head ONCE, at the last prompt position — the only position
    ; whose answer is read.  Every earlier position runs the state half only.  The
    ; head is output_norm plus the vocab-wide output projection plus the argmax
    ; fold, and the projection is the single largest tensor in the file; running it
    ; for a prompt token and discarding its answer was pure weight traffic.  What
    ; each position leaves behind — its stream state, its KV rows — is unchanged,
    ; so the first generated token is the same token, bit for bit.
    (defn q38-prefill (ps bs geo lays sts embTv onormTv projTv ids pos)
        (if (eq (len ids) 1)
            (list (q38-forward ps bs geo lays sts embTv onormTv projTv (head ids) pos) (add pos 1))
            (do (q38-advance ps bs geo lays sts embTv (head ids) pos)
                (q38-prefill ps bs geo lays sts embTv onormTv projTv (tail ids) (add pos 1)))))

    ; ── prefill without a barrier at every position ────────────────────────
    ; q38-blocks enqueues all 48 layers into one batch with NO sync between
    ; them, so ordering inside a batch is already the carrier's job and already
    ; works. The per-position metal_sync in q38-advance is therefore not about
    ; KV ordering the way its comment reads — it is about the scratch buffers
    ; (bs 0, bs 1, ...) being reused by every position, so two positions in
    ; flight would write each other's working memory.
    ;
    ; That is a claim about this body, and this body can answer it. `chunk` says
    ; how many positions may be in flight before the carrier is asked to settle.
    ; chunk=1 IS q38-prefill, barrier for barrier. Larger chunks are the
    ; question, and the answer is whatever the same prompt produces through both.
    (defn q38-advance-open (ps bs geo lays sts embTv id pos)
        (do (q38-forward-state ps bs geo lays sts embTv id pos) 1))

    (defn q38-prefill-chunk-go (ps bs geo lays sts embTv onormTv projTv ids pos chunk k)
        (if (eq (len ids) 1)
            (do (metal_sync)
                (list (q38-forward ps bs geo lays sts embTv onormTv projTv (head ids) pos)
                      (add pos 1)))
            (do (q38-advance-open ps bs geo lays sts embTv (head ids) pos)
                (let settle (if (ge (add k 1) chunk) 1 0))
                (if (eq settle 1) (metal_sync) 0)
                (q38-prefill-chunk-go ps bs geo lays sts embTv onormTv projTv
                    (tail ids) (add pos 1) chunk (if (eq settle 1) 0 (add k 1))))))

    ; ── one batch for the whole span ───────────────────────────────────────
    ; chunk 64 answered no: the scratch buffers bs 0, bs 1, ... are reused by
    ; every position, so two positions in flight overwrite each other's working
    ; memory. The sync was buying ORDERING, and paying a CPU round trip for it.
    ;
    ; md-bind16's own comment names the cheaper coin: barrier_before, "1 =
    ; memoryBarrier before this dispatch; legal only in a concurrent batch".
    ; Today q38-forward-state opens a fresh concurrent batch per position and its
    ; embedding dispatch carries barrier 0 — correct, because a sync had just
    ; drained everything. Open the batch ONCE for the span and give each
    ; position's first dispatch barrier 1 instead, and the ordering that the
    ; round trip was buying is expressed inside the command buffer, where it
    ; costs a barrier rather than a stall.
    (defn q38-forward-state-after (ps bs geo lays sts embTv id pos barrier)
        (do
            (metal_enqueue (nth ps 30)
                (q38-b16 (list (kth-tv-h embTv) (nth bs 0))
                         (list (mul id (nth geo 0)) (nth geo 0)) 0 barrier)
                (nth geo 0))
            (q38-blocks ps bs geo lays sts pos 0 (nth geo 21) (nth geo 22))
            1))

    (defn q38-prefill-span-go (ps bs geo lays sts embTv onormTv projTv ids pos)
        (if (eq (len ids) 1)
            (do (metal_sync)
                (list (q38-forward ps bs geo lays sts embTv onormTv projTv (head ids) pos)
                      (add pos 1)))
            (do (q38-forward-state-after ps bs geo lays sts embTv (head ids) pos 1)
                (q38-prefill-span-go ps bs geo lays sts embTv onormTv projTv
                    (tail ids) (add pos 1) ))))

    (defn q38-prefill-span (ps bs geo lays sts embTv onormTv projTv ids pos)
        (do (metal_batch_concurrent)
            (q38-prefill-span-go ps bs geo lays sts embTv onormTv projTv ids pos)))

    ; chunk 1 = a barrier-per-position sync, the lane as it has always been.
    ; chunk 0 = one batch for the whole span, ordering by barrier.
    ; chunk n>1 = settle every n positions (the probe that answered no).
    ; A layer-major walk needs the residual stream to hold every position of the
    ; span. If the scratch was opened narrower than this prefill, the walk is not
    ; refused and not silently truncated — it runs span mode, which needs no span
    ; at all, and the caller sees which one ran in the reported dispatch counts.
    (defn q38-prefill-chunked-span (ps bs geo lays sts embTv onormTv projTv ids pos chunk span)
        (if (lt chunk (sub 0 2))
            (if (gt (len ids) span)
                (q38-prefill-span ps bs geo lays sts embTv onormTv projTv ids pos)
                (q38-prefill-span-batched ps bs geo lays sts embTv onormTv projTv ids pos))
        (if (lt chunk (sub 0 1))
            (if (gt (len ids) span)
                (q38-prefill-span ps bs geo lays sts embTv onormTv projTv ids pos)
                (q38-prefill-lm ps bs geo lays sts embTv onormTv projTv ids pos))
        (if (lt chunk 0)
            (q38-prefill-mvb ps bs geo lays sts embTv onormTv projTv ids pos)
        (if (eq chunk 0)
            (q38-prefill-span ps bs geo lays sts embTv onormTv projTv ids pos)
            (if (le chunk 1)
                (q38-prefill ps bs geo lays sts embTv onormTv projTv ids pos)
                (q38-prefill-chunk-go ps bs geo lays sts embTv onormTv projTv ids pos chunk 0)))))))

    (defn q38-prefill-chunked (ps bs geo lays sts embTv onormTv projTv ids pos chunk)
        (q38-prefill-chunked-span ps bs geo lays sts embTv onormTv projTv ids pos chunk 1))

    (defn q38-key (arch suffix) (str_concat arch (str_concat "." suffix)))

    ; A pipeline can compile against a sparse/truncated file, and mmap can accept many early tensor
    ; extents before a late one crosses EOF.  Neither is artifact admission.  Walk every tensor-info
    ; record, price its declared ggml type, and compute the last byte the file must contain before a
    ; single model handle is created.  Unknown types refuse with -1 instead of becoming zero bytes.
    (defn q38-required-size-go (src base off remaining high)
        (if (eq remaining 0) high
            (do (let bytes (kth-bytes src off))
                (if (le bytes 0) (sub 0 1)
                    (do (let end (add base (add (egg-ti-dataoff src off) bytes)))
                        (q38-required-size-go src base (egg-ti-next src off) (sub remaining 1)
                            (if (gt end high) end high)))))))
    (defn q38-required-size (src base)
        (q38-required-size-go src base (egg-tinfo-start src) (egg-tensor-count src) base))
    (defn q38-artifact-required (path)
        (do (let src (eqr-of-file path 0 40000000))
            (q38-required-size src (egg-data-base src 32))))
    (defn q38-artifact-complete? (path)
        (do (let required (q38-artifact-required path))
            (if (le required 0) 0 (if (ge (file_size path) required) 1 0))))

    ; Same index contract as kth-geo, so the proven linear/full attention helpers remain reusable.
    (defn q38-geo (src maxpos)
        (do (let a (gmt-str src "general.architecture"))
            (let d (gmt-u32 src (q38-key a "embedding_length")))
            (let nkh (gmt-u32 src (q38-key a "ssm.group_count")))
            (let nvh (gmt-u32 src (q38-key a "ssm.time_step_rank")))
            (let dk (gmt-u32 src (q38-key a "ssm.state_size")))
            (let dinner (gmt-u32 src (q38-key a "ssm.inner_size")))
            (let dv (div dinner nvh))
            (let taps (gmt-u32 src (q38-key a "ssm.conv_kernel")))
            (let eps (gmt-f32 src (q38-key a "attention.layer_norm_rms_epsilon")))
            (let nHead (gmt-u32 src (q38-key a "attention.head_count")))
            (let nKV (gmt-u32 src (q38-key a "attention.head_count_kv")))
            (let headDim (gmt-u32 src (q38-key a "attention.key_length")))
            (let nrot (gmt-u32 src (q38-key a "rope.dimension_count")))
            (let base (gmt-f32 src (q38-key a "rope.freq_base")))
            (let nLayerAll (gmt-u32 src (q38-key a "block_count")))
            (let nextn (gmt-u32 src (q38-key a "nextn_predict_layers")))
            (let ff (gmt-u32 src (q38-key a "feed_forward_length")))
            (list d
                  (add (mul 2 (mul nkh dk)) dinner)
                  nkh nvh dk dv
                  (md-f32-bits eps)
                  (md-f32-bits (div 1.0 (math_sqrt (add dk 0.0))))
                  1 1 ff ff
                  nHead nKV headDim nrot
                  (md-f32-bits base)
                  (md-f32-bits (div 1.0 (math_sqrt (add headDim 0.0))))
                  maxpos (gmt-vocab-n src) (mul nKV headDim)
                  (sub nLayerAll nextn)
                  (gmt-u32 src (q38-key a "full_attention_interval"))
                  taps)))

    ; Returns the same setup shape as KAT plus the selected path at index 9.  No model path or model
    ; geometry is compiled in.  The header window is a carrier window; egg-data-base determines the
    ; real data boundary (10,996,704 bytes on the observed Qwen3.8 Q8_0 file).
    ; span is how many positions the scratch may hold at once, token-major.
    ; q38-open is q38-open-span at span 1 — the same allocation the lane has
    ; always made. ctx slot 10 carries the span so the stack can read it.
    (defn q38-open (path maxpos) (q38-open-span path maxpos 1))

    (defn q38-open-span (path maxpos span)
        (if (eq (q38-artifact-complete? path) 0) (empty)
        (do (let src (eqr-of-file path 0 40000000))
            (let base (egg-data-base src 32))
            (let geo (q38-geo src maxpos))
            (let ps (q38-pipes (q38-msl)))
            (let qout (mul 2 (mul (nth geo 12) (nth geo 14))))
            (let convcap (if (gt qout (nth geo 1)) qout (nth geo 1)))
            (let bs (kth-bufs-span (nth geo 0) convcap (mul (nth geo 3) (nth geo 5)) (nth geo 3)
                              (nth geo 10) 1 (mul (nth geo 12) (nth geo 14))
                              (nth geo 20) maxpos (nth geo 12) (nth geo 19) span))
            (let lays (q38-layers src base path (nth geo 21) (nth geo 22)))
            (let embTv (kth-tv-at src base path (egg-find-tensor src "token_embd.weight")))
            (let onormTv (kth-tv-at src base path (egg-find-tensor src "output_norm.weight")))
            (let projTv (kth-tv-at src base path (egg-find-tensor src "output.weight")))
            (list ps bs geo lays embTv onormTv projTv src base path span))))

    (defn q38-ctx-span (ctx) (if (gt (len ctx) 10) (nth ctx 10) 1))

    (defn q38-new-state (geo)
        (kth-stream-state (nth geo 21) (nth geo 22) (nth geo 1) (nth geo 23)
                          (nth geo 3) (nth geo 5) (nth geo 4) (nth geo 20) (nth geo 18)))

    ; A REPL can select and run more than one model in one carrier lifetime.  Every
    ; per-run allocation and no-copy tensor view therefore has an explicit Form
    ; closer; only content-addressed pipeline handles remain cached by the carrier.
    (defn q38-handle-ok? (h) (if (gt h 0) 1 0))
    (defn q38-handles-ok? (hs)
        (if (eq (len hs) 0) 1
            (if (eq (q38-handle-ok? (head hs)) 1)
                (q38-handles-ok? (tail hs)) 0)))
    (defn q38-tvs-ok? (tvs)
        (if (eq (len tvs) 0) 1
            (if (eq (q38-handle-ok? (kth-tv-h (head tvs))) 1)
                (q38-tvs-ok? (tail tvs)) 0)))
    (defn q38-layers-ok? (lays)
        (if (eq (len lays) 0) 1
            (if (eq (q38-tvs-ok? (head lays)) 1)
                (q38-layers-ok? (tail lays)) 0)))
    (defn q38-state-row-ok? (row)
        (and (if (eq (nth row 0) 0) 1 (q38-handle-ok? (nth row 0)))
        (and (if (eq (nth row 1) 0) 1 (q38-handle-ok? (nth row 1)))
        (and (if (eq (nth row 2) 0) 1 (q38-handle-ok? (nth row 2)))
             (if (eq (nth row 3) 0) 1 (q38-handle-ok? (nth row 3)))))))
    (defn q38-state-ok? (sts)
        (if (eq (len sts) 0) 1
            (if (eq (q38-state-row-ok? (head sts)) 1)
                (q38-state-ok? (tail sts)) 0)))
    (defn q38-context-ok? (ctx)
        (if (lt (len ctx) 10) 0
            (and (q38-handles-ok? (nth ctx 1))
             (and (q38-layers-ok? (nth ctx 3))
              (and (q38-handle-ok? (kth-tv-h (nth ctx 4)))
               (and (q38-handle-ok? (kth-tv-h (nth ctx 5)))
                    (q38-handle-ok? (kth-tv-h (nth ctx 6)))))))))

    (defn q38-free-handle (h)
        (if (le h 0) 0 (if (eq (metal_buf_free h) 1) 1 0)))
    (defn q38-free-handles (hs)
        (if (eq (len hs) 0) 0
            (add (q38-free-handle (head hs)) (q38-free-handles (tail hs)))))
    (defn q38-free-tvs (tvs)
        (if (eq (len tvs) 0) 0
            (add (q38-free-handle (kth-tv-h (head tvs)))
                 (q38-free-tvs (tail tvs)))))
    (defn q38-free-layers (lays)
        (if (eq (len lays) 0) 0
            (add (q38-free-tvs (head lays)) (q38-free-layers (tail lays)))))
    (defn q38-free-state-row (row)
        (sum (list (q38-free-handle (nth row 0))
                   (q38-free-handle (nth row 1))
                   (q38-free-handle (nth row 2))
                   (q38-free-handle (nth row 3)))))
    (defn q38-free-state (sts)
        (if (eq (len sts) 0) 0
            (add (q38-free-state-row (head sts)) (q38-free-state (tail sts)))))
    (defn q38-layer-handle-count (lays)
        (if (eq (len lays) 0) 0
            (add (len (head lays)) (q38-layer-handle-count (tail lays)))))
    ; Exact resident weight traffic of one token forward.  Large matrices are
    ; streamed in full; token_embd contributes one selected row.  This is read
    ; from the opened tensor views, not inferred from a model-size label.
    (defn q38-tv-storage-bytes (tv)
        (kth-tybytes (kth-tv-ty tv) (mul (kth-tv-r tv) (kth-tv-c tv))))
    (defn q38-tv-row-bytes (tv)
        (kth-tybytes (kth-tv-ty tv) (kth-tv-c tv)))
    (defn q38-tvs-storage-bytes (tvs)
        (if (eq (len tvs) 0) 0
            (add (q38-tv-storage-bytes (head tvs))
                 (q38-tvs-storage-bytes (tail tvs)))))
    (defn q38-layers-storage-bytes (lays)
        (if (eq (len lays) 0) 0
            (add (q38-tvs-storage-bytes (head lays))
                 (q38-layers-storage-bytes (tail lays)))))
    (defn q38-forward-weight-bytes (ctx)
        (sum (list
            (q38-tv-row-bytes (nth ctx 4))
            (q38-tv-storage-bytes (nth ctx 5))
            (q38-tv-storage-bytes (nth ctx 6))
            (q38-layers-storage-bytes (nth ctx 3)))))
    (defn q38-state-row-handle-count (row)
        (sum (list (if (gt (nth row 0) 0) 1 0)
                   (if (gt (nth row 1) 0) 1 0)
                   (if (gt (nth row 2) 0) 1 0)
                   (if (gt (nth row 3) 0) 1 0))))
    (defn q38-state-handle-count (sts)
        (if (eq (len sts) 0) 0
            (add (q38-state-row-handle-count (head sts))
                 (q38-state-handle-count (tail sts)))))
    (defn q38-close-expected (ctx sts)
        (add (len (nth ctx 1))
            (add (q38-layer-handle-count (nth ctx 3))
                 (add 3 (q38-state-handle-count sts)))))
    (defn q38-close (ctx sts)
        (do
            (metal_sync)
            (sum (list
                (q38-free-handles (nth ctx 1))
                (q38-free-layers (nth ctx 3))
                (q38-free-handle (kth-tv-h (nth ctx 4)))
                (q38-free-handle (kth-tv-h (nth ctx 5)))
                (q38-free-handle (kth-tv-h (nth ctx 6)))
                (q38-free-state sts)))))
    0)
