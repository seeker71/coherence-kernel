    def q38t-st(i) = i >= 16 ? "" : q38t-join(["metal::simdgroup_store(mc[", q38t-s(i), "], C + ", q38t-s(8 * (i % 4)), "ul + ", q38t-s(8 * (i / 4)), "ul * (ulong)ystride, ystride); ", q38t-st(i + 1)], 0);
