// qwen35-dense-token-handle.fk — dense Qwen3.5/Qwen3.8 decode held by Form through Metal.
//
// The architecture, geometry, tensor names, tensor types, tokenizer width, context limit, special
// token ids, and MTP count all arrive from the selected GGUF.  The only architecture decision here
// is the qwen35 algorithm itself: three Gated DeltaNet blocks followed by one full-attention block,
// dense SwiGLU after every attention half, and sigmoid on the full-attention output gate.
// MSL is assembled by Form and passed to metal_pipeline, so every kernel is JIT-compiled for the
// device that actually answered metal_status.  Model bytes remain mmap-backed no-copy buffers.
//
import native/metal/kat-token-handle.fk;
import form-stdlib/qk-matmul-batch.fk;
import native/metal/qwen35-linear-span-layout-contract.fk;
import form-stdlib/bml/qwen38-open-observation.bml;
import form-stdlib/declarative-attention-metal.bml;
import form-stdlib/bml/qwen38-embedding.bml;
import form-stdlib/bml/qwen38-prefill-quant.bml;
import form-stdlib/bml/qwen38-decode-quant.bml;
import form-stdlib/bml/qwen38-prefill-completion.bml;
import form-stdlib/bml/qwen38-prefill-attention.bml;
section [form.bml] {
    // Dense and MoE Qwen3.5 share the full-attention x * sigmoid(g) gate.  kth-msl owns that
    // proven kernel at pipeline 17; dense appends the wide Q8_0 matvec whose 256-thread group owns
    // two output rows.  The ordinary kth Q8 lane remains available to its existing callers.
    // The batched Q8_0 matmul rides along: one weight decode serving eight
    // activation columns, so a prefill span is one dispatch per weight tensor
    // instead of one per token. Stone 7 proved the shape on the K-quant lane in
    // July (the batched-prefill witness, 5 gates); this lane never inherited it
    // because the generator hardcoded a 256-weight superblock and Q8_0's is 32.
    // A source-offset copy to sit beside kth-copyoff-msl's destination-offset one,
    // and an rmsnorm over a span of rows. The span form is ONE THREAD PER TOKEN.
    // That thread walks its row in ascending order, keeping ldm-rmsnorm-msl's
    // serial sum and Newton-50 reciprocal exactly while remaining independent of
    // model width. A first version copied ldm-rmsnorm-tg-msl's fixed sq[4096]
    // scratch even though Qwen3.8 declares n=5120; a matching output from that
    // out-of-radius kernel was useful evidence, never a correctness witness.
    def q38-copysoff-msl(fname) = ("kernel void " + (fname + " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& soff [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; d[i] = s[soff + i]; }"));
    def q38-rmsspan-msl(fname) = ("kernel void " + (fname + " (device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* y [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& eps [[buffer(4)]], constant uint& ntok [[buffer(5)]], uint tok [[thread_position_in_grid]]) { if (tok >= ntok) return; uint off = tok * n; float ss = 0.0f; uint j = 0u; while (j < n) { float xv = x[off + j]; ss = ss + xv * xv; j += 1u; } float meansq = ss / float(n); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; j = 0u; while (j < n) { float nm = x[off + j] * inv; y[off + j] = nm * g[j]; j += 1u; } }"));
    // ── the batch axis, put into the operations ────────────────────────────
    // Each of these is its per-token kernel with one dimension added: the token
    // index t, a stride, and a bound ntok. The arithmetic is unchanged, line for
    // line. What changes is that the loop over tokens moves from Form into the
    // grid, so one dispatch covers the span instead of one dispatch per token.
    //
    // rope also folds the position in: it took `pos` as a constant, it now takes
    // pos0 and reads its own t, so a span of positions needs no loop either.
    def q38-qsplit-span-msl(fname) = ("kernel void " + (fname + " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& hd [[buffer(3)]], constant uint& off [[buffer(4)]], constant uint& ntok [[buffer(5)]], constant uint& sstride [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint t = gid / n; if (t >= ntok) return; uint i = gid - t * n; uint h = i / hd; uint j = i - h * hd; d[t * n + i] = s[t * sstride + h * 2u * hd + off + j]; }"));
    def q38-headrms-span-msl(fname) = ("kernel void " + (fname + " (device const float* x [[buffer(0)]], device const float* w [[buffer(1)]], device float* out [[buffer(2)]], constant uint& nh [[buffer(3)]], constant uint& hd [[buffer(4)]], constant float& eps [[buffer(5)]], constant uint& ntok [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint b = t * nh * hd + h * hd; float ss = 0.0f; for (uint j = 0u; j < hd; ++j) { float v = x[b + j]; ss = ss + v * v; } float meansq = ss / float(hd); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; for (uint j = 0u; j < hd; ++j) { out[b + j] = (x[b + j] * inv) * w[j]; }}"));
    // A rank-one LoRA is an additive output-head delta without a writable base
    // tensor: h' = h + B * (alpha * (A dot h)).  The dot is deliberately one
    // deterministic device thread: the adapter is tiny beside Qwen's Q8 head,
    // and a fixed reduction order makes the fixture a precise receipt.  The
    // second kernel is data-parallel and writes only Qwen's scratch activation.
    // `output.weight` remains a read-only GGUF view throughout.
    def q38-lora-rank1-dot-msl(fname) = ("kernel void " + (fname + " (device const float* x [[buffer(0)]], device const float* a [[buffer(1)]], device float* dot [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& alpha [[buffer(4)]], uint gid [[thread_position_in_grid]]) { if (gid != 0u) return; float acc = 0.0f; uint i = n; while (i > 0u) { i -= 1u; acc = a[i] * x[i] + acc; } dot[0] = alpha * acc; }"));
    def q38-lora-rank1-add-msl(fname) = ("kernel void " + (fname + " (device float* x [[buffer(0)]], device const float* b [[buffer(1)]], device const float* dot [[buffer(2)]], constant uint& n [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i >= n) return; x[i] = x[i] + b[i] * dot[0]; }"));
    def q38-lora-rank1-msl() = ((String) q38-lora-rank1-dot-msl("form_qwen_lora_rank1_dot_f32") + q38-lora-rank1-add-msl("form_qwen_lora_rank1_add_f32"));
    def q38-lora-rank1-pipes(msl) = [metal_pipeline(msl, "form_qwen_lora_rank1_dot_f32"), metal_pipeline(msl, "form_qwen_lora_rank1_add_f32")];
    def q38-rope-span-msl(fname) = ("kernel void " + (fname + " (device float* v [[buffer(0)]], constant uint& nh [[buffer(1)]], constant uint& hd [[buffer(2)]], constant uint& nrot [[buffer(3)]], constant uint& pos0 [[buffer(4)]], constant float& base [[buffer(5)]], constant uint& ntok [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint np = nrot / 2u; uint per = nh * np; uint t = gid / per; if (t >= ntok) return; uint r = gid - t * per; uint h = r / np; uint k = r - h * np; uint o = t * nh * hd + h * hd; float ex = (-2.0f * float(k)) / float(nrot); float fq = fpow(base, ex); float a = float(pos0 + t) * fq; float ca = fcos(a); float sa = fsin(a); uint i0 = o + k; uint i1 = o + k + np; float x0 = v[i0]; float x1 = v[i1]; float t0 = x0 * ca; float t1 = x1 * sa; v[i0] = t0 - t1; float t2 = x0 * sa; float t3 = x1 * ca; v[i1] = t2 + t3; }"));
    // one dispatch writes a whole span of positions into the K or V cache
    def q38-cachespan-msl(fname) = ("kernel void " + (fname + " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& pos0 [[buffer(3)]], constant uint& ntok [[buffer(4)]], uint gid [[thread_position_in_grid]]) { uint t = gid / n; if (t >= ntok) return; uint i = gid - t * n; d[(pos0 + t) * n + i] = s[t * n + i]; }"));
    // ── attention over a span ──────────────────────────────────────────────
    // ldm-attn-msl scores ONE query against the cached prefix with one thread per
    // query head — 24 threads; dispatched once per token, it made prefill n
    // decode steps rather than a batched pass.
    //
    // This is that kernel with the token axis added. A thread per (token, head),
    // so a 385-token span dispatches once with 9,240 threads instead of 385 times
    // with 24. Causality is carried, not masked away: token t attends over
    // pos0 + t + 1 positions, which is exactly what it saw one at a time.
    //
    // The score scratch grows the same way — (t * nq + h) rows instead of h — so
    // every (token, head) has its own, and the two-pass softmax is untouched.
    def q38-attn-span-msl(fname) = ("kernel void " + (fname + " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& pos0 [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& ntok [[buffer(11)]], uint gid [[thread_position_in_grid]]) { uint tk = gid / nq; if (tk >= ntok) return; uint h = gid - tk * nq; uint npos = pos0 + tk + 1u; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = tk * nq * hd + h * hd; uint koff = kvh * hd; uint row = tk * nq + h; uint S = row * sstride; uint E = (ntok * nq + row) * sstride; uint t = 0; while (t < npos) { float acc = 0.0f; uint c = hd; while (c > 0) { c -= 1; float p = q[qoff + c] * kc[t * KVD + koff + c]; acc = p + acc; } sc[S + t] = acc * scale; t += 1; } float mx = sc[S + 0]; t = 1; while (t < npos) { if (sc[S + t] > mx) { mx = sc[S + t]; } t += 1; } float sumes = 0.0f; t = 0; while (t < npos) { float e = fexp(sc[S + t] - mx); sc[E + t] = e; sumes = sumes + e; t += 1; } float invs = 1.0f / sumes; t = 0; while (t < npos) { sc[S + t] = sc[E + t] * invs; t += 1; } uint i = 0; while (i < hd) { y[qoff + i] = 0.0f; i += 1; } t = 0; while (t < npos) { i = 0; while (i < hd) { float pv = vc[t * KVD + koff + i] * sc[S + t]; y[qoff + i] = y[qoff + i] + pv; i += 1; } t += 1; } }"));
    // ── the linear block over a span ───────────────────────────────────────
    // Eleven of the thirteen ops here do not care what order tokens arrive in.
    // Two do: the conv window and the delta state are recurrences. Those keep
    // their loop and gain only a token offset, so they can walk a span in place;
    // the other eleven take the token axis into the grid.
    def q38-l2norm-span-msl(fname) = ("kernel void " + (fname + " (device float* x [[buffer(0)]], constant uint& nh [[buffer(1)]], constant uint& hd [[buffer(2)]], constant float& eps [[buffer(3)]], constant uint& stride [[buffer(4)]], constant uint& ntok [[buffer(5)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint o = t * stride + h * hd; float s = 0.0f; for (uint i = 0u; i < hd; ++i) { float v = x[o + i]; s = s + v * v; } float inv = 1.0f / fsqrt(s + eps); for (uint i = 0u; i < hd; ++i) { x[o + i] = x[o + i] * inv; } }"));
    def q38-gates-span-msl(fname) = ("kernel void " + (fname + " (device const float* a [[buffer(0)]], device const float* b [[buffer(1)]], device const float* A [[buffer(2)]], device const float* dtb [[buffer(3)]], device float* alpha [[buffer(4)]], device float* beta [[buffer(5)]], constant uint& nh [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nh; if (t >= ntok) return; uint h = gid - t * nh; uint o = t * nh + h; float x = a[o] + dtb[h]; float ax = (x < 0.0f) ? -x : x; float sp = ((x > 0.0f) ? x : 0.0f) + fln(1.0f + fexp(-1.0f * ax)); float g = A[h] * sp; alpha[o] = fexp(g); float bb = b[o]; beta[o] = 1.0f / (1.0f + fexp(-1.0f * bb)); }"));
    def q38-gnorm-span-msl(fname) = ("kernel void " + (fname + " (device const float* o [[buffer(0)]], device const float* w [[buffer(1)]], device const float* z [[buffer(2)]], device float* out [[buffer(3)]], constant uint& nv [[buffer(4)]], constant uint& dv [[buffer(5)]], constant float& eps [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint t = gid / nv; if (t >= ntok) return; uint h = gid - t * nv; uint b = t * nv * dv + h * dv; float ss = 0.0f; for (uint j = 0u; j < dv; ++j) { float v = o[b + j]; ss = ss + v * v; } float meansq = ss / float(dv); float sdv = meansq + eps; float gg = sdv; uint it = 50u; while (it > 0u) { it -= 1u; gg = 0.5f * (gg + sdv / gg); } float inv = 1.0f / gg; for (uint j = 0u; j < dv; ++j) { float nm = (o[b + j] * inv) * w[j]; float zz = z[b + j]; float sg = 1.0f / (1.0f + fexp(-1.0f * zz)); out[b + j] = nm * (zz * sg); }}"));
    // the two recurrences: same body, one offset so they can walk a span in place
    def q38-conv-off-msl(fname) = ("kernel void " + (fname + " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& toff [[buffer(6)]], uint c [[thread_position_in_grid]]) { if (c >= nch) return; uint b = c * kw; for (uint j = 0u; j + 1u < kw; ++j) { win[b + j] = win[b + j + 1u]; } win[b + kw - 1u] = x[toff + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + win[b + j] * w[b + j]; } y[toff + c] = acc; }"));
    def q38-delta-off-msl(fname) = ("kernel void " + (fname + " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& toff [[buffer(10)]], constant uint& goff [[buffer(11)]], constant uint& ooff [[buffer(12)]], uint gid [[thread_position_in_grid]]) { if (gid >= nv * dv) return; uint h = gid / dv; uint i = gid - h * dv; uint kh = h - (h / nk) * nk; device const float* q = c + toff + kh * dk; device const float* k = c + toff + nk * dk + kh * dk; float v = c[toff + 2u * nk * dk + h * dv + i]; uint r = (h * dv + i) * dk; float al = alpha[goff + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[goff + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[ooff + h * dv + i] = acc; }"));
    // GQA decode with one 256-thread THREADGROUP per query head, replacing the
    // one-thread-per-head dispatch for this walker only. Measured 2026-08-24
    // (a per-layer-kind probe): the full-attention block cost 2113 us of GPU per
    // token against ~450 us of weight traffic, and the serial kernel — 24
    // threads for the whole layer on ~5120 ALUs — was the largest resident.
    // Same buffers, same constants, same math; the reductions are simdgroup
    // trees instead of one thread's loop, so float summation ORDER differs —
    // an argmax could flip on a near-tie. The serial body stays in kth-msl for
    // its other tenants (llama, kat); this is a new name, not a rewrite.
    def q38-gqa-tg-msl(fname) = ("kernel void " + (fname + " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& npos [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { uint h = tgpig.x; if (h >= nq) return; threadgroup float sh[16]; uint lid = (uint)sgitg * 32u + (uint)tiisg; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = h * hd; uint koff = kvh * hd; uint S = h * sstride; uint E = (nq + h) * sstride; for (uint t = lid; t < npos; t += 256u) { float acc = 0.0f; for (uint c = 0u; c < hd; ++c) { acc = metal::fma(q[qoff + c], kc[t * KVD + koff + c], acc); } sc[S + t] = acc * scale; } metal::threadgroup_barrier(metal::mem_flags::mem_device); float mx = -3.4e38f; for (uint t = lid; t < npos; t += 256u) { float v = sc[S + t]; if (v > mx) { mx = v; } } mx = metal::simd_max(mx); if (tiisg == 0) { sh[sgitg] = mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float gmx = sh[0]; for (uint k = 1u; k < 8u; ++k) { if (sh[k] > gmx) { gmx = sh[k]; } } float se = 0.0f; for (uint t = lid; t < npos; t += 256u) { float e = fexp(sc[S + t] - gmx); sc[E + t] = e; se = se + e; } se = metal::simd_sum(se); if (tiisg == 0) { sh[8u + sgitg] = se; } metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup); float tot = 0.0f; for (uint k = 0u; k < 8u; ++k) { tot = tot + sh[8u + k]; } float inv = 1.0f / tot; for (uint c = lid; c < hd; c += 256u) { float acc = 0.0f; for (uint t = 0u; t < npos; ++t) { acc = metal::fma(vc[t * KVD + koff + c], sc[E + t], acc); } y[qoff + c] = acc * inv; } }"));
    // ── the recurrences, with their token loop folded inside ───────────────
    // These two are sequential OVER TOKENS and independent over everything else:
    // the conv window belongs to a channel, the delta state to an (h, i) pair,
    // and no channel or pair ever reads another's. So the order that must be kept
    // is a loop INSIDE each thread, not a loop outside the dispatch.
    //
    // The thread decomposition is unchanged — same threads, same state, same
    // arithmetic in the same order — and 48 layers x 2 kernels x N tokens becomes
    // 48 x 2. Nothing about the recurrence is weakened; it is simply not asked
    // 385 separate times whether it would like to advance one step.
    //
    // They are emitted and given pipelines unconditionally, and they are the
    // default walk: the folded configuration reaches the dispatch floor with
    // byte-identical output, and on 2026-09-11 it was decided on host time, the
    // GPU time staying unseparated from the looped walk's (the dispatch-count model).
    // The looped offset kernels stay reachable through fold=0.
    def q38-conv-span-msl(fname) = ("kernel void " + (fname + " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& stride [[buffer(6)]], constant uint& ntok [[buffer(7)]], uint c [[thread_position_in_grid]]) { if (c >= nch) return; uint b = c * kw; for (uint t = 0u; t < ntok; ++t) { for (uint j = 0u; j + 1u < kw; ++j) { win[b + j] = win[b + j + 1u]; } win[b + kw - 1u] = x[t * stride + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + win[b + j] * w[b + j]; } y[t * stride + c] = acc; } }"));
    def q38-delta-span-msl(fname) = ("kernel void " + (fname + " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& cstride [[buffer(10)]], constant uint& gstride [[buffer(11)]], constant uint& ostride [[buffer(12)]], constant uint& ntok [[buffer(13)]], uint gid [[thread_position_in_grid]]) { if (gid >= nv * dv) return; uint h = gid / dv; uint i = gid - h * dv; uint kh = h - (h / nk) * nk; uint r = (h * dv + i) * dk; for (uint t = 0u; t < ntok; ++t) { uint co = t * cstride; device const float* q = c + co + kh * dk; device const float* k = c + co + nk * dk + kh * dk; float v = c[co + 2u * nk * dk + h * dv + i]; float al = alpha[t * gstride + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[t * gstride + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[t * ostride + h * dv + i] = acc; } }"));
    // The individual span emitters above remain independently testable. These
    // two composers make their ordering data without redefining an emitter.
    def q38-linear-span-msl() = (q38-l2norm-span-msl("form_gdn_l2norm_span_f32") + (q38-gates-span-msl("form_gdn_gates_span_f32") + (q38-gnorm-span-msl("form_gdn_norm_gate_span_f32") + (q38-conv-off-msl("form_gdn_conv_off_f32") + (q38-delta-off-msl("form_gdn_delta_off_f32") + ((String) q38-conv-span-msl("form_gdn_conv_span_f32") + q38-delta-span-msl("form_gdn_delta_span_f32")))))));
    def q38-joined-attention-msl() = (q38-qsplit-span-msl("form_qsplit_span_f32") + (q38-headrms-span-msl("form_headrms_span_f32") + (q38-rope-span-msl("form_partial_rope_span_f32") + (q38-cachespan-msl("form_cache_span_f32") + ((String) q38-attn-span-msl("form_gqa_span_f32") + q38-gqa-tg-msl("form_gqa_decode_tg_f32"))))));
    def q38-msl-base() = (kth-msl() + (q80-matvec-wide-body("form_q8_0_matvec_wide_f32") + (qmb-q80-batch() + (q38-copysoff-msl("form_copy_soff_f32") + (q38-rmsspan-msl("form_rmsnorm_span_f32") + (q38-joined-attention-msl() + ((String) q38-linear-span-msl() + q38-lora-rank1-msl())))))));
