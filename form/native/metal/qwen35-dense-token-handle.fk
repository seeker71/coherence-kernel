    def q38-state-ok?(sts) = (Comparable) len(sts) == 0 ? 1 : (Comparable) q38-state-row-ok?(sts[0]) == 1 ? q38-state-ok?(sts[1:]) : 0;
    def q38-context-ok?(ctx) = len(ctx) < 10 ? 0 : q38-handles-ok?(ctx[1]) && (q38-layers-ok?(ctx[3]) && (q38-handle-ok?(kth-tv-h(ctx[4])) && (q38-handle-ok?(kth-tv-h(ctx[5])) && q38-handle-ok?(kth-tv-h(ctx[6])))));
    def q38-free-handle(h) = h <= 0 ? 0 : (Comparable) metal_buf_free(h) == 1 ? 1 : 0;
    def q38-free-handles(hs) = (Comparable) len(hs) == 0 ? 0 : (Number) q38-free-handle(hs[0]) + (Number) q38-free-handles(hs[1:]);
    // A planar tensor view carries its two device arrays after the file view: [h rows cols type qs sc]. They are the process's own
    // allocations (the file view is the shared mapping), so they are freed and counted with it.
    def q38-tv-planar?(tv) = len(tv) > 4;
    def q38-tv-extra(tv) = q38-tv-planar?(tv) ? 2 : 0;
    def q38-free-tv-extra(tv) = q38-tv-planar?(tv) ? (Number) q38-free-handle(tv[4]) + (Number) q38-free-handle(tv[5]) : 0;
    def q38-free-tvs(tvs) = (Comparable) len(tvs) == 0 ? 0 : (Number) q38-free-handle(kth-tv-h(tvs[0])) + (Number) ((Number) q38-free-tv-extra(tvs[0]) + (Number) q38-free-tvs(tvs[1:]));
    def q38-free-layers(lays) = (Comparable) len(lays) == 0 ? 0 : (Number) q38-free-tvs(lays[0]) + (Number) q38-free-layers(lays[1:]);
    def q38-free-state-row(row) = sum([q38-free-handle(row[0]), q38-free-handle(row[1]), q38-free-handle(row[2]), q38-free-handle(row[3])]);
    def q38-free-state(sts) = (Comparable) len(sts) == 0 ? 0 : (Number) q38-free-state-row(sts[0]) + (Number) q38-free-state(sts[1:]);
    def q38-tvs-extra(tvs) = (Comparable) len(tvs) == 0 ? 0 : (Number) q38-tv-extra(tvs[0]) + (Number) q38-tvs-extra(tvs[1:]);
    def q38-layer-handle-count(lays) = (Comparable) len(lays) == 0 ? 0 : (Number) len(lays[0]) + (Number) ((Number) q38-tvs-extra(lays[0]) + (Number) q38-layer-handle-count(lays[1:]));
    // Exact resident weight traffic of one token forward.  Large matrices are
    // streamed in full; token_embd contributes one selected row.  This is read
    // from the opened tensor views, not inferred from a model-size label.
    def q38-tv-storage-bytes(tv) = kth-tybytes(kth-tv-ty(tv), kth-tv-r(tv) * kth-tv-c(tv));
    def q38-tv-row-bytes(tv) = kth-tybytes(kth-tv-ty(tv), kth-tv-c(tv));
    def q38-tvs-storage-bytes(tvs) = (Comparable) len(tvs) == 0 ? 0 : (Number) q38-tv-storage-bytes(tvs[0]) + (Number) q38-tvs-storage-bytes(tvs[1:]);
    def q38-layers-storage-bytes(lays) = (Comparable) len(lays) == 0 ? 0 : (Number) q38-tvs-storage-bytes(lays[0]) + (Number) q38-layers-storage-bytes(lays[1:]);
    def q38-forward-weight-bytes(ctx) = sum([q38-tv-row-bytes(ctx[4]), q38-tv-storage-bytes(ctx[5]), q38-tv-storage-bytes(ctx[6]), q38-layers-storage-bytes(ctx[3])]);
    def q38-state-row-handle-count(row) = sum([row[0] > 0 ? 1 : 0, row[1] > 0 ? 1 : 0, row[2] > 0 ? 1 : 0, row[3] > 0 ? 1 : 0]);
    def q38-state-handle-count(sts) = (Comparable) len(sts) == 0 ? 0 : (Number) q38-state-row-handle-count(sts[0]) + (Number) q38-state-handle-count(sts[1:]);
    def q38-close-expected(ctx, sts) = (Number) len(ctx[1]) + (Number) ((Number) q38-layer-handle-count(ctx[3]) + (Number) ((Number) 3 + (Number) ((Number) q38-tv-extra(ctx[6]) + (Number) q38-state-handle-count(sts))));
    def q38-close(ctx, sts) = {
        metal_sync();
        sum([q38-free-handles(ctx[1]), q38-free-layers(ctx[3]), q38-free-handle(kth-tv-h(ctx[4])), q38-free-handle(kth-tv-h(ctx[5])), q38-free-handle(kth-tv-h(ctx[6])), q38-free-tv-extra(ctx[6]), q38-free-state(sts)]);
    };
    // ── the planar copy of the Q8_0 matrices, built on the device ──────────
    // q38-planarize reads every Q8_0 matrix of the context whose width is a multiple of 512 (all of this model's) through the repack kernel
    // into the process's own two arrays and returns the context with those views: layers (slot 3) and the head projection (slot 6).
    // The embedding table keeps its mapped view (one row is read a token) and prefill keeps reading the mapped blocks (its matmul is
    // unchanged). The cost is a second resident copy of the matrices for this process; the planar sidecar a mapped file would hold
    // once for every process is what removes it.
    def q38-planar-ok?(tv) = (Comparable) kth-tv-ty(tv) == 8 && ((Number) kth-tv-c(tv) % 512 == 0 && q38-tv-planar?(tv) == false);
    def q38-planar-tv(ps, tv) = q38-planar-ok?(tv) ? {
        let nb = (Number) kth-tv-r(tv) * (Number) kth-tv-c(tv) / 32;
        let qs = metal_buf_alloc(nb * 32);
        let sc = metal_buf_alloc(nb * 2);
        metal_enqueue(ps[q38-rpk-index()], md-bind16([kth-tv-h(tv), qs, sc], [nb], 256, 0, 0, 0), nb);
        [kth-tv-h(tv), kth-tv-r(tv), kth-tv-c(tv), kth-tv-ty(tv), qs, sc];
    } : tv;
    def q38-planar-layer(ps, tvs) = (Comparable) len(tvs) == 0 ? [] : cons(q38-planar-tv(ps, tvs[0]), q38-planar-layer(ps, tvs[1:]));
    def q38-planar-layers(ps, lays) = (Comparable) len(lays) == 0 ? [] : cons(q38-planar-layer(ps, lays[0]), q38-planar-layers(ps, lays[1:]));
    def q38-planarize(ctx) {
        metal_batch_concurrent();
        let lays = q38-planar-layers(ctx[0], ctx[3]);
        let proj = q38-planar-tv(ctx[0], ctx[6]);
        metal_sync();
        [ctx[0], ctx[1], ctx[2], lays, ctx[4], ctx[5], proj, ctx[7], ctx[8], ctx[9], ctx[10]];
    }
    0;
}
