; qwen4exp-flash-next-layout.fk — exact split-shard tensor layout for 48 layers.
;
; Each suffix table walks each data shard once. A layer view carries the mmap
; handle, per-expert rows, columns, declared type, slice count and source shard.
; There is no single-file fiction and no type inferred from a family name.
;
; preludes: form/form-stdlib/qwen4exp-split-gguf.fk form/form-stdlib/qwen4exp-flash-next-graph.bml

(do
    (defn q4gl-suffixes ()
        (list
            ".hc_attn_norm.weight" ".hc_attn_down.weight" ".hc_attn_up.weight" ".hc_attn_inject.weight"
            ".hc_ffn_norm.weight" ".hc_ffn_down.weight" ".hc_ffn_up.weight" ".hc_ffn_inject.weight"
            ".ffn_gate_inp.weight" ".ffn_gate_exps.weight" ".ffn_up_exps.weight" ".ffn_down_exps.weight"
            ".ffn_gate_inp_shexp.weight" ".ffn_gate_shexp.weight" ".ffn_up_shexp.weight" ".ffn_down_shexp.weight"
            ".attn_qkv.weight" ".ssm_conv1d.weight" ".ssm_alpha.weight" ".ssm_beta.weight"
            ".ssm_a" ".ssm_dt.bias" ".ssm_norm.weight" ".attn_gate.weight" ".ssm_out.weight"
            ".attn_q.weight" ".attn_k.weight" ".attn_v.weight" ".attn_q_norm.weight" ".attn_k_norm.weight"
            ".attn_output.weight" ".indexer.q_proj.weight" ".indexer.k_proj.weight"
            ".indexer.q_norm.weight" ".indexer.k_norm.weight"))

    (defn q4gl-tabs-go (src2 src3 suffixes acc)
        (if (eq (len suffixes) 0) (reverse acc)
            (q4gl-tabs-go src2 src3 (tail suffixes)
                (cons (q4sg-tab src2 src3 (head suffixes)) acc))))
    (defn q4gl-tabs (src2 src3)
        (q4gl-tabs-go src2 src3 (q4gl-suffixes) (empty)))
    (defn q4gl-tv (paths src2 src3 tabs k layer)
        (q4sg-tv-at paths src2 src3 (q4sg-tab-for (nth tabs k) layer)))

    (defn q4gl-common (paths src2 src3 tabs layer)
        (list
            (q4gl-tv paths src2 src3 tabs 0 layer)  (q4gl-tv paths src2 src3 tabs 1 layer)
            (q4gl-tv paths src2 src3 tabs 2 layer)  (q4gl-tv paths src2 src3 tabs 3 layer)
            (q4gl-tv paths src2 src3 tabs 4 layer)  (q4gl-tv paths src2 src3 tabs 5 layer)
            (q4gl-tv paths src2 src3 tabs 6 layer)  (q4gl-tv paths src2 src3 tabs 7 layer)
            (q4gl-tv paths src2 src3 tabs 8 layer)  (q4gl-tv paths src2 src3 tabs 9 layer)
            (q4gl-tv paths src2 src3 tabs 10 layer) (q4gl-tv paths src2 src3 tabs 11 layer)
            (q4gl-tv paths src2 src3 tabs 12 layer) (q4gl-tv paths src2 src3 tabs 13 layer)
            (q4gl-tv paths src2 src3 tabs 14 layer) (q4gl-tv paths src2 src3 tabs 15 layer)))

    ; Common indices 0..15 above. Linear tail 16..24; full tail 16..25.
    (defn q4gl-layer (paths src2 src3 tabs layer)
        (if (eq (q4g-full layer) 1)
            (append (q4gl-common paths src2 src3 tabs layer)
                (list
                    (q4gl-tv paths src2 src3 tabs 25 layer) (q4gl-tv paths src2 src3 tabs 26 layer)
                    (q4gl-tv paths src2 src3 tabs 27 layer) (q4gl-tv paths src2 src3 tabs 28 layer)
                    (q4gl-tv paths src2 src3 tabs 29 layer) (q4gl-tv paths src2 src3 tabs 30 layer)
                    (q4gl-tv paths src2 src3 tabs 31 layer) (q4gl-tv paths src2 src3 tabs 32 layer)
                    (q4gl-tv paths src2 src3 tabs 33 layer) (q4gl-tv paths src2 src3 tabs 34 layer)))
            (append (q4gl-common paths src2 src3 tabs layer)
                (list
                    (q4gl-tv paths src2 src3 tabs 16 layer) (q4gl-tv paths src2 src3 tabs 17 layer)
                    (q4gl-tv paths src2 src3 tabs 18 layer) (q4gl-tv paths src2 src3 tabs 19 layer)
                    (q4gl-tv paths src2 src3 tabs 20 layer) (q4gl-tv paths src2 src3 tabs 21 layer)
                    (q4gl-tv paths src2 src3 tabs 22 layer) (q4gl-tv paths src2 src3 tabs 23 layer)
                    (q4gl-tv paths src2 src3 tabs 24 layer)))))
    (defn q4gl-layers-go (paths src2 src3 tabs layer acc)
        (if (ge layer 48) (reverse acc)
            (q4gl-layers-go paths src2 src3 tabs (add layer 1)
                (cons (q4gl-layer paths src2 src3 tabs layer) acc))))
    (defn q4gl-layers (paths src2 src3)
        (do (let tabs (q4gl-tabs src2 src3))
            (q4gl-layers-go paths src2 src3 tabs 0 (empty))))

    ; [token embedding, head hc norm/down/up, output projection,
    ; PLE table/key/value/norm-key/norm-query/norm-conv/conv]
    (defn q4gl-model (paths src2 src3)
        (list
            (q4sg-tv-named paths src2 src3 "token_embd.weight")
            (q4sg-tv-named paths src2 src3 "output_hc_norm.weight")
            (q4sg-tv-named paths src2 src3 "output_hc_down.weight")
            (q4sg-tv-named paths src2 src3 "output_hc_up.weight")
            (q4sg-tv-named paths src2 src3 "output.weight")
            (q4sg-tv-named paths src2 src3 "per_layer_token_embd.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_key.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_value.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_norm_key.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_norm_query.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_norm_conv.weight")
            (q4sg-tv-named paths src2 src3 "blk.1.ple_conv1d.weight")))

    (defn q4gl-free-tv (tv) (if (gt (q4tv-h tv) 0) (metal_buf_free (q4tv-h tv)) 0))
    (defn q4gl-free-list (xs)
        (if (eq (len xs) 0) 1
            (do (q4gl-free-tv (head xs)) (q4gl-free-list (tail xs)))))
    (defn q4gl-free-layers (lays)
        (if (eq (len lays) 0) 1
            (do (q4gl-free-list (head lays)) (q4gl-free-layers (tail lays)))))
    0)
