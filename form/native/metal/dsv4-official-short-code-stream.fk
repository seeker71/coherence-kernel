; Four-token resident-session vector from the model producer's public official
; fixture.  The expected bytes are the producer's greedy continuation, not a
; Form-authored target.  This exercises prefill once, then three autoregressive
; decode passes through the already-open model and persistent KV caches.
;
; lineage:
; https://github.com/tylerwagler/ds4/tree/main/tests/test-vectors
;
; preludes: native/metal/dsv4-live-generate.fk

(do
    (let model (dsv4-local-model-resource))
    (let run
        (dsv4-live-run
            "Complete the C statement with the next exact token only:\nreturn snprintf(buf, sizeof(buf), \"%d\", value"
            4))
    (dsv4-live-render model run)
    (let result-ids (nth run 1))
    (let result-text
        (tkz-decode-text (tkz-src model) result-ids))
    (if (and
            (eq (len result-ids) 4)
            (str_eq result-text "```c\nreturn"))
        255
        0))
