// dsv4-ledger.fk -- the DeepSeek-V4 driver's op ledger: ONE observation row per token and per stage, read from the carrier's own counters, that a band can pin as a ceiling.
//
// WHY A LEDGER. The Swift reference runner (metal_dsv4_stack.sh, history 93154a720) was held to a count it printed every run: dispatches a token, barriers a token, command buffers, host waits, the bytes of weight a token must read.
// This lane is a Form cell driving the same device, and its cost is those counts times what one of each costs THIS lane (a dispatch is about 20 us of host here, 1.1 us in Swift): so the counts are the thing to hold.
// A row is read, not estimated: the carrier counts every enqueue and every wait (metal_live words 7 and 8), the buffers standing (word 2), the device's own busy microseconds (word 11); the plan counts the barriers it
// placed, the batches it handed to the queue, the host reads the loop made, and the plans that ran short (dsv4-kernels.fk dkr-hz). A band that runs a token and compares the row to a ceiling fails when an op count regresses.
//
// A ROW is a record: dispatches, barriers, cbs (command buffers: the batches handed to the queue, plus the one the final wait drains), syncs, readbacks (host reads of device buffers), allocs (the buffers standing rose by this:
// zero for a token), gpu_us (the device's busy time over the row's waits), wall_ms, miss (plans that ran short or long: zero), bytes (the weight bytes the token's dispatches must read: dll-token-bytes), and the arena's own
// counts (all 0 of a whole-stack token): fills (the span fills of the experts the layers missed), fdisp (their copy dispatches, among the dispatches: none when the fill door preads the span), emiss and ehit (experts the layers
// missed and hit in the arena's cache), ebytes (the bytes the fills carry). The arena mode has its own ceilings (dll-arena-ceil: a sync a block and one at the close, one id read a block, dispatches plus the copy dispatches)
// and the whole-stack mode keeps its own.
// A STAGE row is [block, dispatches, bytes]: the block's enqueue count as the layer answered it and the bytes it reads (dll-layer-bytes: every dense tensor whole, the router and the compressor whole, each routed stack at
// used experts of its stride; the KV traffic is position-dependent and left out).
//
// Proven by: native/metal/tests/dsv4-ledger-band.bml (the rows of a prefill and of decode steps on the fixtures, against the ceilings pinned there, the serial run against the concurrent one).
import form-stdlib/core.fk;
import form-stdlib/dsv4-layout.fk;
import form-stdlib/dsv4-kernels.fk;
import native/metal/dsv4-bind.fk;
import native/metal/dsv4-open.fk;
import native/metal/dsv4-layer.fk;
import native/metal/dsv4-token-handle.fk;
section [form.bml] {
    // ---- the mark: the counters now ---------------------------------------------------------------------------------------
    // [dispatches, syncs, gpu_us, buffers standing, wall_ms, barriers, command buffers, plan misses, host reads, span fills, experts missed, experts hit, bytes the fills carry, copy dispatches of the fills, the process's CPU microseconds, then the host's time columns: encoding CPU, waits ms, plan ms, plan CPU, fills ms, fills CPU, reads CPU]
    def dll-mark() {
        let l = metal_live();
        [l[7], l[8], l[11], l[2], now_unix_ms(), dkr-hz-get("bar"), dkr-hz-get("cbs"), dkr-hz-get("miss"), dkr-hz-get("reads"), dkr-hz-get("fills"), dkr-hz-get("fmiss"), dkr-hz-get("fhit"), dkr-hz-get("fbytes"), dkr-hz-get("fdisp"),
            host_cpu_us(), dkr-hz-get("tm-enc"), dkr-hz-get("tm-sync"), dkr-hz-get("tm-plan"), dkr-hz-get("tm-plan-cpu"), dkr-hz-get("tm-fill"), dkr-hz-get("tm-fill-cpu"), dkr-hz-get("tm-read"), dkr-hz-get("npicks"), dkr-hz-get("picks")];
    }
    // the row between two marks: the batches handed to the queue are counted (and, in the arena mode, each layer's drained batch), and the batch the last wait drained is one more. The arena's own counts ride in the row:
    // fills (the span fills, three a missed expert), fdisp (the fills' copy dispatches, among the dispatches: 0 when the fill door preads the span, one a fill on the view road), emiss and ehit (experts missed and hit, over the
    // layers the row ran), ebytes (the bytes the fills carry); all 0 of a whole-stack token
    def dll-row(a, b, bytes) = record_new(0, "dispatches", b[0] - a[0], "syncs", b[1] - a[1], "gpu_us", b[2] - a[2], "allocs", b[3] - a[3], "wall_ms", b[4] - a[4],
        "barriers", b[5] - a[5], "cbs", (b[6] - a[6]) + 1, "miss", b[7] - a[7], "readbacks", b[8] - a[8], "bytes", bytes, "fills", b[9] - a[9], "emiss", b[10] - a[10], "ehit", b[11] - a[11], "ebytes", b[12] - a[12], "fdisp", b[13] - a[13],
        "cpu_us", b[14] - a[14], "enc_us", b[15] - a[15], "sync_ms", b[16] - a[16], "plan_ms", b[17] - a[17], "plan_us", b[18] - a[18], "fill_ms", b[19] - a[19], "fill_us", b[20] - a[20], "read_us", b[21] - a[21], "picks", dll-picks-between(a[22], b[22], b[23]));
    // THE EXPERT PICKS A ROW MADE, layer order: [[layer, [ids]]...], from the picks kept between two marks (newest first in the plan record: the first b - a of them are this row's); [] when nothing was kept (the arena off, or the option)
    def dll-take(xs, n) = (n <= 0 || nil?(xs)) ? [] : cons(xs[0], dll-take(xs[1:], n - 1));
    def dll-picks-between(na, nb, list) = reverse(dll-take(list, nb - na));
    // THE HOST'S TIME IN COLUMNS (readings, not ceilings; the clocks are dsv4-kernels.fk's tm- keys): wall_ms is the row's wall; gpu_us the device's busy time; sync_ms the wall the host spent in waits (the device running,
    // the host idle); enc_us the CPU the stages' encoding took (the dispatches built and enqueued); plan_ms and plan_us a layer's id read, cache and slot write (wall, CPU); fill_ms and fill_us the layers' span fills (wall,
    // CPU: a pread's wait on the disk is wall and not CPU); read_us the host reads; cpu_us the process's CPU over the row (the host's own work all told, wait and disk excluded). `other_ms` is what no column names:
    // the wall less the waits, the plan, the fills, and the encoding and reads (microseconds to milliseconds). IT MAY READ NEGATIVE: enc_us and read_us are the whole process's CPU clock, the rest are wall clocks, and CPU and wall differ. The wall clock reads whole milliseconds, so a row's wall-clock columns are good to a few milliseconds.
    def dll-other-ms(row) = record_get(row, "wall_ms") - record_get(row, "sync_ms") - record_get(row, "plan_ms") - record_get(row, "fill_ms") - (record_get(row, "enc_us") + record_get(row, "read_us")) / 1000;
    def dll-keys() = ["dispatches", "barriers", "cbs", "syncs", "readbacks", "allocs", "bytes", "gpu_us", "wall_ms", "miss", "fills", "fdisp", "emiss", "ehit", "ebytes", "cpu_us", "enc_us", "sync_ms", "plan_ms", "plan_us", "fill_ms", "fill_us", "read_us"];
    def dll-field-go(row, ks) = nil?(ks) ? "" : (" " ++ ks[0] ++ "=" ++ record_get(row, ks[0]).str() ++ dll-field-go(row, ks[1:]));
    // one line, key=value, that a receipt can quote and a band can parse: `ledger <label> dispatches=.. barriers=.. ...`
    def dll-line(label, row) = "ledger " ++ label ++ dll-field-go(row, dll-keys()) ++ " other_ms=" ++ dll-other-ms(row).str();
    // THE ROAD A ROW'S FILLS TOOK: the fill door preads a span into its slot and makes no dispatch; the view road makes one copy dispatch a fill (and takes the fill the door refused), so the door's fills are fills - fdisp.
    // "none" when the row filled nothing (every expert a hit, or a whole-stack token), "door" when no fill dispatched, "view" when every fill did, "mixed" between
    def dll-fills-door(row) = record_get(row, "fills") - record_get(row, "fdisp");
    def dll-road(row) = record_get(row, "fills") == 0 ? "none" : (record_get(row, "fdisp") == 0 ? "door" : (record_get(row, "fdisp") == record_get(row, "fills") ? "view" : "mixed"));

    // ---- the ceilings: a row is within them when no count passed its ceiling (gpu_us and wall_ms are readings, not ceilings, and are not held) ----------------------------
    def dll-held-keys() = ["dispatches", "barriers", "cbs", "syncs", "readbacks", "allocs", "bytes", "miss"];
    def dll-within-go(row, ceil, ks) = nil?(ks) ? true : ((!record_has(ceil, ks[0]) || record_get(row, ks[0]) <= record_get(ceil, ks[0])) && dll-within-go(row, ceil, ks[1:]));
    def dll-within?(row, ceil) = dll-within-go(row, ceil, dll-held-keys());
    // the keys a row passed its ceiling by (what a failing band prints)
    def dll-over-go(row, ceil, ks) = nil?(ks) ? "" : (((record_has(ceil, ks[0]) && record_get(row, ks[0]) > record_get(ceil, ks[0])) ? (" " ++ ks[0] ++ " " ++ record_get(row, ks[0]).str() ++ ">" ++ record_get(ceil, ks[0]).str()) : "") ++ dll-over-go(row, ceil, ks[1:]));
    def dll-over(row, ceil) = dll-over-go(row, ceil, dll-held-keys());

    // ---- the dispatches a block enqueues, from the layout alone (the formula the row is held to) -------------------------------------------------------------------------
    // attention half: hc_pre 4, norm 1, q_a and kv 2, then norms, q_b, head norm, two ropes, the kv round and append, the three attention stages, the inverse rope, the grouped output, output_b: 14, hc_post 1 = 22; a
    // compressing block adds the two projections and the state write (3) and, at a window boundary, the pool, the shift (ratio 4), the norm, the rope, the round and the append (6 at ratio 4, 5 otherwise).
    // FFN half: hc_pre 4, norm 1, router 1, routing 3 (hashed) or 2, experts 4, shared 4, slot sum 1, hc_post 1 = 19 or 18.
    def dll-attn-count(ratio, pos) = 22 + (ratio == 0 ? 0 : 3 + ((((pos + 1) % ratio) == 0) ? (ratio == 4 ? 6 : 5) : 0));
    def dll-ffn-count(hashed) = hashed ? 19 : 18;
    // THE MODEL IS ALL THE FORMULA READS: dvl-open's layout record of a bare header (observe/dsv4-token-run.bml's dry plan prices the real file from it) and a context's dso-geo are the same record, so the plan and the row
    // are one arithmetic (the -m forms take the model, the plain forms a context)
    def dll-block-count-m(m, il, pos) = dll-attn-count(dvl-l(m, il, "ratio"), pos) + dll-ffn-count(dvl-l(m, il, "hashed"));
    def dll-blocks-count-m(m, il, n, pos) = il == n ? 0 : dll-block-count-m(m, il, pos) + dll-blocks-count-m(m, il + 1, n, pos);
    def dll-token-count-m(m, pos) = 2 + dll-blocks-count-m(m, 0, record_get(m, "layers-n"), pos) + 8;
    def dll-block-count(ctx, il, pos) = dll-block-count-m(dso-geo(ctx), il, pos);
    // a decode step: embed 2, the blocks, the head 7 and its NaN scan 1
    def dll-token-count(ctx, pos) = dll-token-count-m(dso-geo(ctx), pos);

    // ---- THE ARENA MODE'S COUNTS (dsv4-arena.fk, dsv4-token-handle.fk dth-layer-arena): a block syncs ONCE, between its first half and the experts, to read the router's ids ----------------------------------------------
    // syncs: one a block and the wait that closes the token (or the prefill position); host reads: ONE a block (the ids: used words in one dkr-rd) and, at a head, the two the argmax makes; command buffers: each block's drained
    // batch, the batch handed to the queue after every second block (after every block at submit_every 1: dll-arena-cbs follows dkr-every), and the one the closing wait drains; dispatches: the formula's plus the copy dispatches of the fills that took the view road (the row's own `fdisp`; the fill
    // door makes none); span fills: three a missed expert (the row's `fills`); buffers made: none (the span views a fill names are freed at the wait that closes the token); plans short or long: none
    def dll-layers-n(m) = record_get(m, "layers-n");
    def dll-arena-syncs(m) = dll-layers-n(m) + 1;
    def dll-arena-reads(m, headed) = dll-layers-n(m) + (headed ? 2 : 0);
    def dll-arena-cbs(m) = dll-layers-n(m) + (dll-layers-n(m) / dkr-every()) + 1;
    // the ceilings of a row whose fills made `fdisp` copy dispatches at position pos, with or without its head, reading `bytes`; barriers are bounded by the dispatches
    def dll-arena-ceil(m, pos, headed, fdisp, bytes) {
        let d = dll-token-count-m(m, pos) - (headed ? 0 : 8) + fdisp;
        record_new(0, "dispatches", d, "barriers", d, "cbs", dll-arena-cbs(m), "syncs", dll-arena-syncs(m), "readbacks", dll-arena-reads(m, headed), "allocs", 0, "bytes", bytes, "miss", 0);
    }

    // ---- the bytes a token must read ---------------------------------------------------------------------------------------------------------------------------------------
    def dll-expert-stack?(n) = n == "ffn_gate_exps.weight" || n == "ffn_up_exps.weight" || n == "ffn_down_exps.weight";
    def dll-view-bytes(ctx, il, leaf) {
        let v = dkl-view(ctx, il, leaf);
        let used = record_get(dso-geo(ctx), "used");
        dll-expert-stack?(leaf) ? used * (dvb-v-bytes(v) / dvb-d2(v)) : dvb-v-bytes(v);
    }
    // the leaves of a block's name list (the part after "blk.<il>.")
    def dll-leaf(il, name) = substring(name, str_len(dkl-name(il, "")), str_len(name));
    def dll-hash-leaf?(leaf) = leaf == "ffn_gate_tid2eid.weight";
    // ONE SUM, TWO READERS OF A LEAF: `of` answers the bytes of one leaf, from the opened views (a context) or from the header's layout rows (a bare model: the dry plan); the hash table of a hashed block is read on
    // the device by the token id carried as a constant and is not weight a token reads
    def dll-names-bytes-with(of, il, names) = nil?(names) ? 0 : ((dll-hash-leaf?(dll-leaf(il, names[0])) ? 0 : of(dll-leaf(il, names[0]))) + dll-names-bytes-with(of, il, names[1:]));
    def dll-layer-bytes(ctx, il) = dll-names-bytes-with(leaf => dll-view-bytes(ctx, il, leaf), il, dvl-l(dso-geo(ctx), il, "names"));
    def dll-layers-bytes(ctx, il, n) = il == n ? 0 : dll-layer-bytes(ctx, il) + dll-layers-bytes(ctx, il + 1, n);
    // the header's reading of a leaf: its layout row's bytes, a routed stack at the experts used of its stride (nexp of its layer)
    def dll-row-bytes(m, il, leaf) {
        let ix = record_get(m, "index");
        let name = dkl-name(il, leaf);
        let b = dvl-has?(ix, name) ? dvl-r-bytes(dvl-row-of(ix, name)) : 0;
        dll-expert-stack?(leaf) ? record_get(m, "used") * (b / dvl-l(m, il, "nexp")) : b;
    }
    def dll-layer-bytes-m(m, il) = dll-names-bytes-with(leaf => dll-row-bytes(m, il, leaf), il, dvl-l(m, il, "names"));
    def dll-layers-bytes-m(m, il, n) = il == n ? 0 : dll-layer-bytes-m(m, il) + dll-layers-bytes-m(m, il + 1, n);
    // the embedding row (one F16 row of token_embd) and the head (the three small tensors, the norm, the output matrix whole)
    def dll-head-names() = ["output_hc_fn.weight", "output_hc_scale.weight", "output_hc_base.weight", "output_norm.weight", "output.weight"];
    def dll-names-sum(of, names) = nil?(names) ? 0 : of(names[0]) + dll-names-sum(of, names[1:]);
    def dll-head-bytes(ctx) = dll-names-sum(name => dvb-v-bytes(dso-view(ctx, name)), dll-head-names());
    def dll-head-bytes-m(m) = dll-names-sum(name => (dvl-has?(record_get(m, "index"), name) ? dvl-r-bytes(dvl-row-of(record_get(m, "index"), name)) : 0), dll-head-names());
    def dll-token-bytes(ctx) = 2 * record_get(dso-geo(ctx), "e") + dll-layers-bytes(ctx, 0, record_get(dso-geo(ctx), "layers-n")) + dll-head-bytes(ctx);
    def dll-token-bytes-m(m) = 2 * record_get(m, "e") + dll-layers-bytes-m(m, 0, record_get(m, "layers-n")) + dll-head-bytes-m(m);

    // ---- one observed decode step: [next id, row] --------------------------------------------------------------------------------------------------------------------
    def dsv4-decode-observed(ctx, sts, id, pos) {
        let a = dll-mark();
        let nid = dsv4-decode(ctx, sts, id, pos);
        let b = dll-mark();
        [nid, dll-row(a, b, dll-token-bytes(ctx))];
    }
    // the stage rows of the last observed token: [block, dispatches, bytes], ascending (the loop notes each block's enqueue count while "observe" reads 1)
    def dll-stages-go(ctx, noted) = nil?(noted) ? [] : cons([noted[0][0], noted[0][1], dll-layer-bytes(ctx, noted[0][0])], dll-stages-go(ctx, noted[1:]));
    def dsv4-decode-staged(ctx, sts, id, pos) {
        let o = dkr-hz-put("observe", 1);
        let cleared = dkr-hz-put("stages", []);
        let seen = dsv4-decode-observed(ctx, sts, id, pos);
        let stopped = dkr-hz-put("observe", 0);
        [seen[0], seen[1], reverse(dll-stages-go(ctx, dkr-hz-get("stages")))];
    }

    // ---- THE ATTRIBUTION ROW: which kernels keep the device busy ---------------------------------------------------------------------------------------------
    // A production token's gpu_us is the sum over its ~65 command buffers of the span the device reports for each; it says how long the device was busy, not with what. This row answers with what: ONE decode token run in
    // the attribution mode (dsv4-kernels.fk dkr-attr-begin: every dispatch its own command buffer, enqueued, synced, read; the token's wall clock is not a measurement and the mode is never production's), each
    // dispatch's device microseconds kept with its pipeline, its first buffer (the weight of a matvec, the arena's buffer of an expert stack) and its stage ("layer-a:17": the attention half and the FFN's first half of block 17;
    // "layer-b:17": the experts, the shared expert, the slot sum and hc_post; "embed", "head", "scan"). The rows are tallied by FAMILY (what the dispatch is), by KERNEL (its pipeline's name) and by BLOCK, and
    // THE SUM OF EACH TALLY IS THE TOKEN'S DEVICE TIME EXACTLY (the rows are the growth of metal_live word 11 between dispatches, so the sum telescopes, and the band holds it equal to the word's growth over the token read
    // independently). Each dispatch carries the per-command-buffer launch the device charges any buffer, so `floor` (the smallest span any dispatch read) is reported and the family table prints its share beside the raw sum.
    // THE FAMILIES: a matvec is placed by the tensor its first buffer is (the loop that names a leaf: attn_q_a, attn_kv, attn_q_b and attn_output_a/b are "dense matvecs (attention)"; attn_compressor_* "compressor";
    // ffn_gate_inp "router"; ffn_gate_exps and ffn_up_exps "experts gate/up", ffn_down_exps "experts down", whether the stack's own view or a layer's arena buffer; *_shexp "shared expert"; hc_*_fn "hyper-connection"),
    // every other dispatch by its pipeline's name (the MLA kernels, the rope, the KV round and append "attention (MLA)"; the compressor's own kernels "compressor"; the top-k and hash routing "router"; the id-weighted
    // SwiGLU "experts gate/up"; the plain SwiGLU and the slot sum "shared expert"; the hyper-connection kernels "hyper-connection"; the weighted norms "norms"; a view fill's copy "fills (copy kernels)"), and the stages
    // "head" and "scan" claim every dispatch they run ("head") and "embed" ("embedding"). The compressor's emit shares the norm, the rope, the KV round and the append kernels with the attention and those dispatches are counted
    // under their kernel's family, not the compressor's: the family "compressor" is the compressor's own projections and kernels.
    def dll-has?(s, part) = str_find(s, part, 0) >= 0;
    def dll-leaf-of(name) = str_find(name, "blk.", 0) == 0 ? substring(name, str_find(name, ".", 4) + 1, str_len(name)) : name;
    def dll-stage-tag(stage) = substring(stage, 0, str_find(stage, ":", 0));
    def dll-stage-block(stage) = str_to_int(substring(stage, str_find(stage, ":", 0) + 1, str_len(stage)));
    // the rules are ordered lists, the first that matches wins: the tensor's leaf first (a matvec is what its weight is), then the pipeline's name; "hc_attn_fn" and "attn_compressor" come before "attn_"
    def dll-leaf-rules() = [["_shexp", "shared expert"], ["ffn_gate_exps", "experts gate/up"], ["ffn_up_exps", "experts gate/up"], ["ffn_down_exps", "experts down"], ["attn_compressor", "compressor"], ["ffn_gate_inp", "router"],
        ["hc_attn_fn", "hyper-connection"], ["hc_ffn_fn", "hyper-connection"], ["attn_", "dense matvecs (attention)"]];
    def dll-kernel-rules() = [["form_hc_", "hyper-connection"], ["form_dsv4_hc_post", "hyper-connection"], ["form_mla_attend", "attention (MLA)"], ["form_mla_headrms", "attention (MLA)"], ["form_dsv4_rope", "attention (MLA)"],
        ["form_dsv4_kv_fp8", "attention (MLA)"], ["form_dkv_append", "attention (MLA)"], ["form_dsv4_comp_", "compressor"], ["form_dsv4_topk", "router"], ["form_dsv4_hash", "router"], ["form_dsv4_swiglu_id", "experts gate/up"],
        ["form_dsv4_swiglu_f32", "shared expert"], ["form_dsv4_sum_slots", "shared expert"], ["rmsnorm", "norms"], ["form_dsv4_copy", "fills (copy kernels)"]];
    def dll-first-rule(rules, s, d) = len(rules) == 0 ? d : (dll-has?(s, rules[0][0]) ? rules[0][1] : dll-first-rule(rules[1:], s, d));
    def dll-family(tag, kname, leaf) = (tag == "head" || tag == "scan") ? "head" : (tag == "embed" ? "embedding" : dll-first-rule(dll-leaf-rules(), leaf, dll-first-rule(dll-kernel-rules(), kname, "other")));
    // handle -> name tables, built once from the context (not per dispatch): the pipelines' names, and the leaf of every tensor the driver binds plus the arena's buffers
    def dll-pipe-names-go(ctx, names, rec) = len(names) == 0 ? rec : { let h = dso-pipe(ctx, names[0]); let k = h > 0 ? record_set(rec, h.str(), names[0]) : 0; dll-pipe-names-go(ctx, names[1:], rec); };
    def dll-pipe-names(ctx) = dll-pipe-names-go(ctx, dkr-all-names(dkr-graph-units()), record_new(0));
    def dll-leaves-go(ctx, names, rec) = len(names) == 0 ? rec : { let h = dso-handle(ctx, names[0]); let k = h > 0 ? record_set(rec, h.str(), dll-leaf-of(names[0])) : 0; dll-leaves-go(ctx, names[1:], rec); };
    def dll-arena-leaves-go(ctx, il, n, rec) = il == n ? rec : {
        let a = record_set(rec, dxa-bufs(ctx, il)[0].str(), "ffn_gate_exps.weight");
        let b = record_set(rec, dxa-bufs(ctx, il)[1].str(), "ffn_up_exps.weight");
        let c = record_set(rec, dxa-bufs(ctx, il)[2].str(), "ffn_down_exps.weight");
        dll-arena-leaves-go(ctx, il + 1, n, rec);
    };
    def dll-leaf-names(ctx) {
        let rec = dll-leaves-go(ctx, dvl-driver-names(dso-geo(ctx)), record_new(0));
        dxa-on?(ctx) ? dll-arena-leaves-go(ctx, 0, record_get(dso-geo(ctx), "layers-n"), rec) : rec;
    }
    def dll-lookup(rec, h, d) = record_has(rec, h.str()) ? record_get(rec, h.str()) : d;
    // one raw row [pipeline, first buffer, device us, stage] -> [family, kernel, stage, us]
    def dll-classify-row(pn, ln, r) {
        let kname = dll-lookup(pn, r[0], "?");
        let leaf = dll-lookup(ln, r[1], "");
        [dll-family(dll-stage-tag(r[3]), kname, leaf), kname, r[3], r[2]];
    }
    def dll-classify(pn, ln, rows) = len(rows) == 0 ? [] : cons(dll-classify-row(pn, ln, rows[0]), dll-classify(pn, ln, rows[1:]));
    // a tally of [key, us] items: [[key, count, us]] in the order the keys first appear
    def dll-tally-go(items, rec) {
        len(items) == 0 ? 0 : {
            let k = items[0][0];
            let held = record_has(rec, k) ? record_get(rec, k) : [0, 0];
            let a = record_set(rec, k, [held[0] + 1, held[1] + items[0][1]]);
            let b = record_has(rec, k) && held[0] > 0 ? 0 : record_set(rec, "~keys", append(record_get(rec, "~keys"), [k]));
            dll-tally-go(items[1:], rec);
        };
    }
    def dll-tally-rows(rec, keys) = len(keys) == 0 ? [] : cons([keys[0], record_get(rec, keys[0])[0], record_get(rec, keys[0])[1]], dll-tally-rows(rec, keys[1:]));
    def dll-tally(items) { let rec = record_new(0, "~keys", []); let done = dll-tally-go(items, rec); dll-tally-rows(rec, record_get(rec, "~keys")); }
    def dll-pick(cls, i) = len(cls) == 0 ? [] : cons([cls[0][i], cls[0][3]], dll-pick(cls[1:], i));
    def dll-sum-us(items) = len(items) == 0 ? 0 : items[0][1] + dll-sum-us(items[1:]);
    def dll-min-us(cls, best) = len(cls) == 0 ? best : dll-min-us(cls[1:], cls[0][3] < best ? cls[0][3] : best);
    // the tally's third column summed
    def dll-tally-total(t) = len(t) == 0 ? 0 : t[0][2] + dll-tally-total(t[1:]);
    def dll-tally-count(t) = len(t) == 0 ? 0 : t[0][1] + dll-tally-count(t[1:]);
    // the blocks: [block, half-a us, half-b us], ascending; a whole-stack block (one stage "layer") reports its time as half a and 0 as half b
    def dll-stage-us(stages, key) = len(stages) == 0 ? 0 : (stages[0][0] == key ? stages[0][2] : dll-stage-us(stages[1:], key));
    def dll-blocks-go(stages, il, n) = il == n ? [] : cons([il, dll-stage-us(stages, "layer-a:" ++ il.str()) + dll-stage-us(stages, "layer:" ++ il.str()), dll-stage-us(stages, "layer-b:" ++ il.str())], dll-blocks-go(stages, il + 1, n));
    // the row: dispatches, us (the rows' sum), gpu_us (the word's growth over the token, read independently), floor (the smallest span read), families, kernels, stages (every stage key), blocks, wall_ms, fill_ms (the arena's host preads)
    def dll-attribution(ctx, rows, gpu, wall, fillms) {
        let cls = dll-classify(dll-pipe-names(ctx), dll-leaf-names(ctx), rows);
        let fam = dll-tally(dll-pick(cls, 0));
        let ker = dll-tally(dll-pick(cls, 1));
        let stg = dll-tally(dll-pick(cls, 2));
        record_new(0, "dispatches", len(cls), "us", dll-tally-total(fam), "gpu_us", gpu, "floor", len(cls) == 0 ? 0 : dll-min-us(cls, 1000000000), "families", fam, "kernels", ker, "stages", stg,
            "blocks", dll-blocks-go(stg, 0, record_get(dso-geo(ctx), "layers-n")), "wall_ms", wall, "fill_ms", fillms);
    }
    // THE OBSERVATION: one decode token in the attribution mode; [next id, the attribution row]. The device's word is read before and after on its own (after a sync), the fills' host milliseconds are the growth of the arena's counter.
    def dll-fill-ms(ctx) = dxa-on?(ctx) ? dxa-get(ctx, "ms-fill") : 0;
    def dll-attribute-decode(ctx, sts, id, pos) {
        let s0 = metal_sync();
        let g0 = metal_live()[11];
        let f0 = dll-fill-ms(ctx);
        let t0 = host_monotonic_ms();
        let begun = dkr-attr-begin();
        let nid = dsv4-decode(ctx, sts, id, pos);
        let rows = dkr-attr-end();
        let t1 = host_monotonic_ms();
        let s1 = metal_sync();
        let g1 = metal_live()[11];
        [nid, dll-attribution(ctx, rows, g1 - g0, t1 - t0, dll-fill-ms(ctx) - f0)];
    }
    // the row's sums are the token's device time: every tally's total is the rows' sum, the rows' sum is the word's growth, the count of dispatches is every tally's count
    def dll-attr-sums-ok?(a) = record_get(a, "us") == record_get(a, "gpu_us") && dll-tally-total(record_get(a, "families")) == record_get(a, "us") && dll-tally-total(record_get(a, "kernels")) == record_get(a, "us")
        && dll-tally-total(record_get(a, "stages")) == record_get(a, "us") && dll-tally-count(record_get(a, "families")) == record_get(a, "dispatches") && dll-tally-count(record_get(a, "kernels")) == record_get(a, "dispatches")
        && dll-tally-count(record_get(a, "stages")) == record_get(a, "dispatches") && dll-blocks-total(record_get(a, "blocks")) + dll-non-block-us(record_get(a, "stages")) == record_get(a, "us");
    def dll-blocks-total(bs) = len(bs) == 0 ? 0 : bs[0][1] + bs[0][2] + dll-blocks-total(bs[1:]);
    def dll-non-block-us(stages) = len(stages) == 0 ? 0 : ((dll-stage-tag(stages[0][0]) == "embed" || dll-stage-tag(stages[0][0]) == "head" || dll-stage-tag(stages[0][0]) == "scan") ? stages[0][2] : 0) + dll-non-block-us(stages[1:]);
    // ---- the row as lines and as JSON (the token door prints and keeps them) ---------------------------------------------------------------------------------
    def dll-pct10(us, total) = total <= 0 ? 0 : (us * 1000) / total;
    def dll-pct-text(p) = (p / 10).str() ++ "." ++ (p % 10).str();
    def dll-fam-line(f, total, floor) = "  " ++ f[0] ++ ": " ++ f[1].str() ++ " dispatches, " ++ f[2].str() ++ " us (" ++ dll-pct-text(dll-pct10(f[2], total)) ++ " percent), " ++ (f[1] == 0 ? 0 : f[2] / f[1]).str() ++ " us a dispatch, " ++ (f[2] - f[1] * floor).str() ++ " us over the per-buffer floor";
    def dll-fam-lines(fs, total, floor) = len(fs) == 0 ? [] : cons(dll-fam-line(fs[0], total, floor), dll-fam-lines(fs[1:], total, floor));
    // the n heaviest of a tally, by us (selection, no sort primitive needed)
    def dll-heaviest(t, n) = n == 0 || len(t) == 0 ? [] : { let b = dll-max-of(t, t[0]); cons(b, dll-heaviest(dll-without(t, b), n - 1)); };
    def dll-max-of(t, best) = len(t) == 0 ? best : dll-max-of(t[1:], t[0][2] > best[2] ? t[0] : best);
    def dll-without(t, x) = len(t) == 0 ? [] : (t[0][0] == x[0] ? t[1:] : cons(t[0], dll-without(t[1:], x)));
    def dll-attr-lines(a) {
        let total = record_get(a, "us");
        let floor = record_get(a, "floor");
        append(["[dsv4-attribution] one decode token, every dispatch its own command buffer: " ++ record_get(a, "dispatches").str() ++ " dispatches, device " ++ total.str() ++ " us (the word's growth over the token: " ++ record_get(a, "gpu_us").str() ++ "), the smallest span read " ++ floor.str()
            ++ " us, wall " ++ record_get(a, "wall_ms").str() ++ " ms (a measurement of nothing: 1,900 waits), the fills' host preads " ++ record_get(a, "fill_ms").str() ++ " ms"],
         append(dll-fam-lines(dll-heaviest(record_get(a, "families"), 12), total, floor),
          cons("[dsv4-attribution] the heaviest kernels:", dll-fam-lines(dll-heaviest(record_get(a, "kernels"), 12), total, floor))));
    }
    def dll-q(s) = "\"" ++ s ++ "\"";
    def dll-kv(k, v) = dll-q(k) ++ ":" ++ v;
    def dll-obj(xs) = byte_to_str(123) ++ dll-join(xs, ",") ++ byte_to_str(125);
    def dll-tally-json(t) = "[" ++ dll-join(map(x => dll-obj([dll-kv("key", dll-q(x[0])), dll-kv("n", x[1].str()), dll-kv("us", x[2].str())]), t), ",") ++ "]";
    def dll-join(xs, sep) = len(xs) == 0 ? "" : (len(xs) == 1 ? xs[0] : xs[0] ++ sep ++ dll-join(xs[1:], sep));
    def dll-blocks-json(bs) = "[" ++ dll-join(map(b => "[" ++ b[0].str() ++ "," ++ b[1].str() ++ "," ++ b[2].str() ++ "]", bs), ",") ++ "]";
    def dll-attr-json(a) = dll-obj([dll-kv("dispatches", record_get(a, "dispatches").str()), dll-kv("us", record_get(a, "us").str()), dll-kv("gpu_us", record_get(a, "gpu_us").str()), dll-kv("floor_us", record_get(a, "floor").str()),
        dll-kv("wall_ms", record_get(a, "wall_ms").str()), dll-kv("fill_ms", record_get(a, "fill_ms").str()), dll-kv("families", dll-tally-json(record_get(a, "families"))), dll-kv("kernels", dll-tally-json(record_get(a, "kernels"))),
        dll-kv("blocks_a_b_us", dll-blocks-json(record_get(a, "blocks")))]);
    0;
}
