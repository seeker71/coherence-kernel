; floor-derive.fk — the bandwidth floor per model, DERIVED from each file's own tensor table.
;
; The floor-first method this repo learned expensively (receipts 2026-07-30-floor-first,
; -false-dial, -cheap-dear): before optimizing, state what a token CANNOT cost less than. A
; decode step must read every live weight byte once: every blk.* tensor, the final norm, and
; the unembedding — which is token_embd itself when the table carries no output.weight (tied
; is a fact about the table, never a convention). The embedding GATHER reads one row (d bytes,
; ~10^-5 of the total) and the KV cache at witness positions reads ~pos*kvd*8*nLayer bytes
; (~10^-3 of the total at pos <= 21); both are printed so the smallness is witnessed, not
; asserted. floor_ms = live_bytes / measured read bandwidth (bw-probe.fk, re-derived per run,
; never quoted).
;
; preludes: native/metal/dense-token-handle.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY

(do
    (defn fld-models ()
        (list (list "llama1b"    "/Users/ursmuff/.ollama/models/blobs/sha256-74701a8c35f6c8d9a4b91f3f3497643001d63e0c7a84e085bed452548fa88d45")
              (list "llama3b"    "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff")
              (list "minicpm5"   "/Users/ursmuff/.ollama/models/blobs/sha256-0dc7638539067268774c275a14a6ec9c7e01f7eeb2cff606c8590361fa527e4c")
              (list "moondream"  "/Users/ursmuff/.ollama/models/blobs/sha256-e554c6b9de016673fd2c732e0342967727e9659ca5f853a4947cc96263fa602b")
              (list "nanbeige"   "/Users/ursmuff/.cache/huggingface/hub/models--owao--Nanbeige4.2-3B-GGUF/blobs/9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104")
              (list "dsr1q32"    "/Users/ursmuff/.ollama/models/blobs/sha256-6150cb382311b69f09cc0f9a1b69fc029cbd742b66bb8ec531aa5ecf5c613e93")
              (list "qwencoder32" "/Users/ursmuff/.ollama/models/blobs/sha256-67f5470b8d17b37fb49e76ad797dd6eda93997499c3031aa33a6ac3f77804668")
              (list "qwen72"     "/Users/ursmuff/.ollama/models/blobs/sha256-6e7fdda508e91cb0f63de5c15ff79ac63a1584ccafd751c07ca12b7f442101b8")))

    (defn fld-blk? (name) (if (ge (str_len name) 4) (str_eq (substring name 0 4) "blk.") false))

    ; sum every blk.* row's priced bytes in one walk
    (defn fld-blk-sum (tab acc)
        (if (eq (len tab) 0) acc
            (fld-blk-sum (tail tab)
                (add acc (if (fld-blk? (nth (head tab) 0)) (nth (head tab) 5) 0)))))

    (defn fld-row-bytes (tab name)
        (do (let r (dth-row-find tab name))
            (if (eq r 0) 0 (nth r 5))))

    ; num_loops: a looped file (nanbeige) walks its blk.* weights once PER LOOP each token
    (defn fld-one (name path)
        (do (let src (dth-src path))
            (let arch (gmt-str src "general.architecture"))
            (let tab (dth-table src))
            (let nLoop (dth-u32-or src (dth-key arch "num_loops") 1))
            (let nLayer (gmt-u32 src (dth-key arch "block_count")))
            (let blkB (mul (fld-blk-sum tab 0) nLoop))
            (let normB (add (fld-row-bytes tab "output_norm.weight")
                            (fld-row-bytes tab "output_norm.bias")))
            (let tied (eq (dth-row-find tab "output.weight") 0))
            (let headB (if tied (fld-row-bytes tab "token_embd.weight")
                           (add (fld-row-bytes tab "output.weight")
                                (fld-row-bytes tab "output.bias"))))
            (let ropeB (fld-row-bytes tab "rope_freqs.weight"))
            (let live (add blkB (add normB (add headB ropeB))))
            (let dModel (gmt-u32 src (dth-key arch "embedding_length")))
            (let nHead (gmt-u32 src (dth-key arch "attention.head_count")))
            (let nKV (gmt-u32 src (dth-key arch "attention.head_count_kv")))
            (let headDim (dth-u32-or src (dth-key arch "attention.key_length") (div dModel nHead)))
            (let kvAt21 (mul (mul (mul (mul nKV headDim) 8) (mul nLayer nLoop)) 21))
            (print (str_concat name
                   (str_concat " arch=" (str_concat arch
                   (str_concat " tied=" (str_concat (if tied "1" "0")
                   (str_concat " live_bytes=" (str_concat (int_to_str live)
                   (str_concat " gather_bytes=" (str_concat (int_to_str (mul dModel 4))
                   (str_concat " kv_bytes_at_pos21=" (int_to_str kvAt21))))))))))))
            0))

    (defn fld-walk (ms)
        (if (eq (len ms) 0) 0
            (do (fld-one (nth (head ms) 0) (nth (head ms) 1))
                (fld-walk (tail ms)))))

    (fld-walk (fld-models))
    0)
