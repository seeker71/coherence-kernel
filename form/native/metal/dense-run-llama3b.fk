; dense-run-llama3b.fk — llama3.2:3b through dense-token-handle.fk, TWO prompts, full id streams.
;
; This driver exists for the stream gate: first-token-only was proven blind (the dense band's own
; M-2/M-4), so every change to the lane must show the FULL id stream for at least two prompts
; unchanged. Sequential prompts through one open are clean: positions restart at 0 and attention
; reads only rows 0..pos, every one of which the new prompt has rewritten.
;
; preludes: native/metal/dense-token-handle.fk

(do
    (defn dr3-blob () "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff")

    (defn dr3-join (xs acc)
        (if (eq (len xs) 0) acc
            (dr3-join (tail xs) (str_concat acc (str_concat " " (int_to_str (head xs)))))))

    (defn dr3-run (st tag prompt n)
        (do (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2))
            (let lays (nth st 3)) (let cks (nth st 4)) (let cvs (nth st 5))
            (let embTv (nth st 6)) (let onormTv (nth st 7)) (let projTv (nth st 8))
            (let src (nth st 10))
            (let ids (dtk-encode src prompt))
            (print (str_concat tag (str_concat "_prompt_ids=" (dr3-join ids ""))))
            (let tE (now_unix_ms))
            (let pf (dth-prefill ps bs geo lays cks cvs embTv onormTv projTv ids 0))
            (let tF (now_unix_ms))
            (let first (nth pf 0))
            (let tG (now_unix_ms))
            (let rest (dth-generate ps bs geo lays cks cvs embTv onormTv projTv first (len ids) (sub n 1) (empty)))
            (let tH (now_unix_ms))
            (let got (append (list first) rest))
            (print (str_concat tag (str_concat "_prefill_ms=" (int_to_str (sub tF tE)))))
            (print (str_concat tag (str_concat "_ids=" (dr3-join got ""))))
            (print (str_concat tag (str_concat "_decode_ms=" (int_to_str (sub tH tG)))))
            (print (str_concat tag (str_concat "_text=" (l3d-text src got))))
            0))

    (let live (md-door-live?))
    (print (if live "door=live" "door=DEAD"))

    (let tA (now_unix_ms))
    (let st (dth-open (dr3-blob) 256 (sub 0 1)))
    (let tB (now_unix_ms))
    (print (str_concat "arch=" (nth st 9)))
    (print (str_concat "open_ms=" (int_to_str (sub tB tA))))
    (print (str_concat "pipes_ok=" (if (dth-pipe-ok? (nth st 0)) "1" "0")))

    (dr3-run st "p1" "The capital of France is" 16)
    (dr3-run st "p2" "Once upon a time" 16)

    (print (metal_status))
    0)
