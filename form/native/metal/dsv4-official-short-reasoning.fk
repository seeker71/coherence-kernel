; Live semantic vector from the model producer's public official fixture.
; The official DeepSeek V4 Flash continuation for this exact no-system,
; no-thinking prompt begins with the bytes "16".  This is an external
; falsifier for the complete tokenizer -> 43-layer prefill -> output-head path,
; not a self-authored expected logit.
;
; lineage:
; https://github.com/tylerwagler/ds4/tree/main/tests/test-vectors
;
; preludes: native/metal/dsv4-live-generate.fk

(do
    (let model (dsv4-local-model-resource))
    (let run
        (dsv4-live-run
            "Answer with only the number: 2048 divided by 128 is"
            1))
    (dsv4-live-render model run)
    (let result-ids (nth run 1))
    (if (and
            (eq (len result-ids) 1)
            (eq (head result-ids) 926))
        255
        0))
