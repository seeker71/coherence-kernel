; The model's forward-path KV round trip: E4M3FN in 64-wide groups over
; the 448 non-RoPE values, followed by F16 rounding over the whole row.
(do
    (defn dsv4-kv-round-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nstatic inline float ds4_e4m3_mag(int i){int e=(i>>3)&15;int m=i&7;return(e==0)?(float(m)*0.001953125f):((1.0f+float(m)*0.125f)*metal::exp2(float(e-7)));}static inline float ds4_e4m3_round(float v){float sgn=(v<0.0f)?-1.0f:1.0f;float ax=metal::min(metal::abs(v),448.0f);int lo=0;int hi=126;for(int it=0;it<7;++it){if(lo>=hi)break;int mid=(lo+hi+1)>>1;if(ds4_e4m3_mag(mid)<=ax)lo=mid;else hi=mid-1;}int best=lo;if(best<126){float bd=metal::abs(ax-ds4_e4m3_mag(best));float nd=metal::abs(ax-ds4_e4m3_mag(best+1));if(nd<bd||(nd==bd&&((best+1)&1)==0&&(best&1)!=0))best=best+1;}return sgn*ds4_e4m3_mag(best);}static inline float ds4_ceil_log2(float t){uint b=as_type<uint>(t);int e=int((b>>23)&255u)-127;uint frac=b&8388607u;return float((frac==0u)?e:(e+1));}kernel void form_dsv4_kv_fp8_f16_round(device const float* v [[buffer(0)]],device float* out [[buffer(1)]],constant uint& hd [[buffer(2)]],constant uint& nrot [[buffer(3)]],uint i [[thread_position_in_grid]]){if(i!=0u)return;for(uint j=0u;j<hd;++j)out[j]=v[j];uint nnope=hd-nrot;for(uint off=0u;off+64u<=nnope;off+=64u){float amax=0.0f;for(uint j=0u;j<64u;++j){float a=metal::abs(out[off+j]);if(a>amax)amax=a;}if(amax<1.0e-4f)amax=1.0e-4f;float sc=metal::exp2(ds4_ceil_log2(amax/448.0f));for(uint j=0u;j<64u;++j){float w=out[off+j]/sc;w=metal::clamp(w,-448.0f,448.0f);out[off+j]=ds4_e4m3_round(w)*sc;}}for(uint j=0u;j<hd;++j)out[j]=float(half(out[j]));}\n")
    0)
