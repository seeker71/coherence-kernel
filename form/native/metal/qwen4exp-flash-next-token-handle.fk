// qwen4exp-flash-next-token-handle.fk — one real qwen4exp token through Form/Metal.
//
// The high-level order is owned by qwen4exp-flash-next-graph.bml. This cell is
// its handle scheduler: split GGUF tensors stay mmap-backed, all matvec and graph
// arithmetic stays in the Form-emitted Metal unit, expert ids stay GPU-resident,
// recurrent/KV state is explicit, and no llama process or external runtime is
// present. Dense attention is exact while npos <= the file's 2048-token QSA
// budget; the sparse selector for deeper positions is the remaining graph organ.
//
import form/native/metal/qwen4exp-flash-next-layout.fk;
import form/native/metal/qwen4exp-flash-next-graph-jit.fk;
import form/form-stdlib/native-model-tensor-ledger.bml;
section [form.bml] {
    // Geometry and f32 constants pinned by this exact qwen4exp artifact.
    def q4t-eps-bits() = 897988541;
    def q4t-gdn-scale-bits() = 1035273459;
    def q4t-attn-scale-bits() = 1031798784;
    def q4t-ple-scale-bits() = 1017243803;
    def q4t-rope-base-bits() = 1259902592;
    def q4t-dense-exact-radius() = 2048;
    def q4t-b16(bufs, consts) = md-bind16(bufs, consts, 256, 0, 0, 0);
    def q4t-mv(ps, tv, x, y) = q4eq-all-mv(ps, q4tv-h(tv), x, y, q4tv-ty(tv), q4tv-r(tv), q4tv-c(tv), 0, 0);
    def q4t-mv-selected(ps, tv, x, y, ids, rank) = q4eq-all-mv-selected(ps, q4tv-h(tv), x, y, ids, rank, q4tv-ty(tv), q4tv-r(tv), q4tv-c(tv), 0);
    // bs indices:
    // 0 emb, 1 residualHC, 2 xn/keyNorm, 3 low, 4 hcGate, 5 mixed,
    // 6 inject, 7 block, 8 qkv, 9 alpha, 10 beta, 11 z, 12 deltaOut,
    // 13 gdnNorm, 14 qRaw, 15 q, 16 qGate, 17 k, 18 v, 19 attn,
    // 20 score, 21 router, 22 ids, 23 weights, 24..28 routed expert,
    // 29..33 shared expert, 34 logits, 35..38 argmax, 39 PLE ids,
    // 40 PLE emb, 41 PLE key, 42 PLE value, 43 PLE query/norm,
    // 44 PLE gated, 45..47 PLE uint64 tables, 48 PLE history.
    def q4t-alloc-sizes(sizes) = (Comparable) len(sizes) == 0 ? [] : cons(sizes[0] > 0 ? metal_buf_alloc(sizes[0]) : 0, q4t-alloc-sizes(sizes[1:]));
    def q4t-bufs(maxpos) = q4t-alloc-sizes(nmtl-qwen-scratch-sizes(maxpos));
    // Linear layers own a four-position GDN conv row and 48x128x128 state.
    // Full layers own fp16 K/V. Zero fill is the carrier's allocation contract.
    def q4t-state-go(layer, maxpos, acc) = layer >= 48 ? reverse(acc) : q4t-state-go((Number) layer + (Number) 1, maxpos, cons(q4t-alloc-sizes(nmtl-qwen-state-sizes(layer, maxpos, q4g-full(layer))), acc));
    def q4t-state(maxpos) = q4t-state-go(0, maxpos, empty());
    def q4t-le-bytes(n, k) = k <= 0 ? "" : ((String) byte_to_str(n % 256) + q4t-le-bytes(n / 256, k - 1));
    def q4t-u64-list(xs) = (Comparable) len(xs) == 0 ? "" : ((String) q4t-le-bytes(xs[0], 8) + q4t-u64-list(xs[1:]));
    def q4t-ple-multipliers() = [23703573157769, 20109073645365, 8052911324071];
    def q4t-ple-offsets() = [0, 20000003, 40000026, 60000059, 80000106, 100000165, 120000228, 140000297, 160000374, 180000455, 200000548, 220000655, 240000802, 260000955, 280001114, 300001275];
    def q4t-ple-sizes() = [20000003, 20000023, 20000033, 20000047, 20000059, 20000063, 20000069, 20000077, 20000081, 20000093, 20000107, 20000147, 20000153, 20000159, 20000161, 20000171];
    def q4t-write-ple-tables(bs) = [metal_buf_write(bs[45], 0, q4t-u64-list(q4t-ple-multipliers())), metal_buf_write(bs[46], 0, q4t-u64-list(q4t-ple-offsets())), metal_buf_write(bs[47], 0, q4t-u64-list(q4t-ple-sizes()))];
    def q4t-embed(qps, gps, bs, emb, id) = {
        metal_enqueue(qps[13], q4t-b16([q4tv-h(emb), bs[0]], [id, 2560]), 2560);
        q4gj-hc-repeat(gps, bs[0], bs[1]);
        1;
    };
    def q4t-hc-mix(qps, gps, bs, lay, base) = {
        q4gj-hc-norm(gps, bs[1], q4tv-h(nth(lay, base)), bs[2], q4t-eps-bits());
        q4t-mv(qps, nth(lay, (Number) base + (Number) 1), bs[2], bs[3]);
        q4gj-low-act(gps, bs[3]);
        q4t-mv(qps, nth(lay, (Number) base + (Number) 2), bs[3], bs[4]);
        q4gj-hc-mix(gps, bs[2], bs[4], bs[5]);
        q4t-mv(qps, nth(lay, (Number) base + (Number) 3), bs[2], bs[6]);
        1;
    };
    def q4t-head-mix(qps, gps, bs, model) = {
        q4gj-hc-norm(gps, bs[1], q4tv-h(model[1]), bs[2], q4t-eps-bits());
        q4t-mv(qps, model[2], bs[2], bs[3]);
        q4gj-low-act(gps, bs[3]);
        q4t-mv(qps, model[3], bs[3], bs[4]);
        q4gj-hc-mix(gps, bs[2], bs[4], bs[5]);
        1;
    };
    def q4t-ple(qps, gps, bs, model, cur, prev1, prev2) = {
        q4gj-ple-hash(gps, bs[39], bs[45], bs[46], bs[47], cur, prev1, prev2);
        metal_enqueue(qps[9], q4t-b16([q4tv-h(model[5]), bs[39], bs[40]], [160, 16]), 2560);
        q4t-mv(qps, model[6], bs[40], bs[41]);
        q4t-mv(qps, model[7], bs[40], bs[42]);
        q4gj-hc-norm(gps, bs[41], q4tv-h(model[8]), bs[2], q4t-eps-bits());
        q4gj-hc-norm(gps, bs[1], q4tv-h(model[9]), bs[43], q4t-eps-bits());
        q4gj-ple-gate(gps, bs[2], bs[43], bs[42], bs[44], q4t-ple-scale-bits());
        q4gj-hc-norm(gps, bs[44], q4tv-h(model[10]), bs[43], q4t-eps-bits());
        q4gj-ple-conv(gps, bs[48], bs[43], q4tv-h(model[11]), bs[44], bs[1]);
        1;
    };
    def q4t-linear(aps, qps, gps, bs, lay, st) = {
        q4t-mv(qps, lay[16], bs[5], bs[8]);
        q4t-mv(qps, lay[18], bs[5], bs[9]);
        q4t-mv(qps, lay[19], bs[5], bs[10]);
        q4t-mv(qps, lay[23], bs[5], bs[11]);
        metal_enqueue(aps[7], q4t-b16([st[0], bs[8], q4tv-h(lay[17]), bs[8]], [10240, 4]), 10240);
        metal_enqueue(aps[8], q4t-b16([bs[8]], [10240]), 10240);
        metal_enqueue(aps[9], q4t-b16([bs[8]], [32, 128, q4t-eps-bits()]), 32);
        metal_enqueue(aps[10], q4t-b16([bs[9], bs[10], q4tv-h(lay[20]), q4tv-h(lay[21]), bs[9], bs[10]], [48]), 48);
        metal_enqueue(aps[11], q4t-b16([st[1], bs[8], bs[9], bs[10], bs[12]], [48, 128, 128, 16, q4t-gdn-scale-bits()]), 48 * 128);
        q4gj-gdn-norm-sigmoid(gps, bs[12], q4tv-h(lay[22]), bs[11], bs[13], q4t-eps-bits());
        q4t-mv(qps, lay[24], bs[13], bs[7]);
        1;
    };
    def q4t-full(aps, qps, gps, bs, lay, st, pos, maxpos) = {
        q4t-mv(qps, lay[16], bs[5], bs[14]);
        q4t-mv(qps, lay[17], bs[5], bs[17]);
        q4t-mv(qps, lay[18], bs[5], bs[18]);
        metal_enqueue(aps[14], q4t-b16([bs[14], bs[15]], [6144, 256, 0]), 6144);
        metal_enqueue(aps[14], q4t-b16([bs[14], bs[16]], [6144, 256, 256]), 6144);
        metal_enqueue(aps[13], q4t-b16([bs[15], q4tv-h(lay[19]), bs[15]], [24, 256, q4t-eps-bits()]), 24);
        metal_enqueue(aps[13], q4t-b16([bs[17], q4tv-h(lay[20]), bs[17]], [2, 256, q4t-eps-bits()]), 2);
        metal_enqueue(aps[15], q4t-b16([bs[15]], [24, 256, 64, pos, q4t-rope-base-bits()]), 24 * 32);
        metal_enqueue(aps[15], q4t-b16([bs[17]], [2, 256, 64, pos, q4t-rope-base-bits()]), 2 * 32);
        q4gj-cache-half(gps, bs[17], st[2], 512, pos);
        q4gj-cache-half(gps, bs[18], st[3], 512, pos);
        q4gj-gqa-half(gps, bs[15], st[2], st[3], bs[19], bs[20], (Number) pos + (Number) 1, q4t-attn-scale-bits(), maxpos);
        metal_enqueue(aps[17], q4t-b16([bs[19], bs[16]], [6144]), 6144);
        q4t-mv(qps, lay[21], bs[19], bs[7]);
        1;
    };
    def q4t-experts-go(aps, qps, bs, lay, rank) = rank >= 10 ? 1 : {
        q4t-mv-selected(qps, lay[9], bs[5], bs[24], bs[22], rank);
        q4t-mv-selected(qps, lay[10], bs[5], bs[25], bs[22], rank);
        metal_enqueue(aps[18], q4t-b16([bs[24], bs[25], bs[26]], [640]), 640);
        q4t-mv-selected(qps, lay[11], bs[26], bs[27], bs[22], rank);
        metal_enqueue((Comparable) rank == 0 ? aps[21] : aps[22], q4t-b16([bs[27], bs[28], bs[23]], [rank, 2560]), 2560);
        q4t-experts-go(aps, qps, bs, lay, (Number) rank + (Number) 1);
    };
    def q4t-batch-experts?(lay) = ((Comparable) q4tv-ty(lay[9]) == 17 ? 1 : (Comparable) q4tv-ty(lay[9]) == 18) ? ((Comparable) q4tv-ty(lay[10]) == 17 ? 1 : (Comparable) q4tv-ty(lay[10]) == 18) ? (Comparable) q4tv-ty(lay[11]) == 20 : 0 : 0;
    def q4t-experts-batch(aps, qps, gps, bs, lay) = {
        q4eq-all-mv-selected-batch(qps, q4tv-h(lay[9]), bs[5], bs[24], bs[22], q4tv-ty(lay[9]), 640, 2560, 10, 0);
        q4eq-all-mv-selected-batch(qps, q4tv-h(lay[10]), bs[5], bs[25], bs[22], q4tv-ty(lay[10]), 640, 2560, 10, 0);
        metal_enqueue(aps[18], q4t-b16([bs[24], bs[25], bs[26]], [6400]), 6400);
        q4eq-iq4nl-mv-selected-batch(qps, q4tv-h(lay[11]), bs[26], bs[27], bs[22], 2560, 640, 10, 0);
        q4gj-moe-reduce(gps, bs[27], bs[23], bs[28]);
        1;
    };
    def q4t-moe(aps, qps, gps, bs, lay) = {
        q4t-mv(qps, lay[8], bs[5], bs[21]);
        q4gj-route(gps, bs[21], bs[22], bs[23]);
        (Comparable) q4t-batch-experts?(lay) == 1 ? q4t-experts-batch(aps, qps, gps, bs, lay) : q4t-experts-go(aps, qps, bs, lay, 0);
        q4t-mv(qps, lay[13], bs[5], bs[29]);
        q4t-mv(qps, lay[14], bs[5], bs[30]);
        metal_enqueue(aps[18], q4t-b16([bs[29], bs[30], bs[31]], [640]), 640);
        q4t-mv(qps, lay[15], bs[31], bs[32]);
        q4t-mv(qps, lay[12], bs[5], bs[33]);
        metal_enqueue(aps[23], q4t-b16([bs[32], bs[28], bs[33]], [2560]), 2560);
        1;
    };
    def q4t-block(aps, qps, gps, bs, model, lay, st, layer, pos, maxpos, cur, prev1, prev2) = {
        (Comparable) q4g-ple(layer) == 1 ? q4t-ple(qps, gps, bs, model, cur, prev1, prev2) : 0;
        q4t-hc-mix(qps, gps, bs, lay, 0);
        (Comparable) q4g-full(layer) == 1 ? q4t-full(aps, qps, gps, bs, lay, st, pos, maxpos) : q4t-linear(aps, qps, gps, bs, lay, st);
        q4gj-hc-combine(gps, bs[1], bs[7], bs[6]);
        q4t-hc-mix(qps, gps, bs, lay, 4);
        q4t-moe(aps, qps, gps, bs, lay);
        q4gj-hc-combine(gps, bs[1], bs[28], bs[6]);
        1;
    };
    def q4t-blocks(aps, qps, gps, bs, model, lays, sts, layer, pos, maxpos, cur, prev1, prev2) = layer >= 48 ? 1 : {
        q4t-block(aps, qps, gps, bs, model, nth(lays, layer), nth(sts, layer), layer, pos, maxpos, cur, prev1, prev2);
        q4t-blocks(aps, qps, gps, bs, model, lays, sts, (Number) layer + (Number) 1, pos, maxpos, cur, prev1, prev2);
    };
    def q4t-head(aps, qps, gps, bs, model) = {
        q4t-head-mix(qps, gps, bs, model);
        // The head is a dependent three-stage chain. The ordinary layer
        // scheduler can use implicit serial ordering, but both reductions
        // are cooperative threadgroups and must observe the preceding
        // buffer writes explicitly.
        q4eq-all-mv(qps, q4tv-h(model[4]), bs[5], bs[34], q4tv-ty(model[4]), q4tv-r(model[4]), q4tv-c(model[4]), 0, 1);
        metal_enqueue(aps[25], md-bind16([bs[34], bs[35], bs[36]], [248320, 1024], 1024, 0, 1, 1), 1024);
        metal_enqueue(aps[26], md-bind16([bs[35], bs[36], bs[37], bs[38]], [1024], 1024, 0, 1, 1), 1);
        kth-u32at(metal_buf_read(bs[37], 0, 4), 0);
    };
    // ctx = [attention pipes, quant pipes, graph pipes, scratch, layers,
    //        model tensors, state, maxpos].
    // Prompt ingestion advances every resident organ but does not project the
    // 248320-column vocabulary.  The five-dispatch head mixer is retained: a
    // live differential showed that its scratch image is part of the next
    // token's current schedule (omitting it changed 271 to 353).  The caller
    // evaluates the final prompt token with q4t-forward so vocabulary logits
    // and argmax exist exactly once.
    def q4t-ingest(ctx, id, pos, prev1, prev2) = {
        let aps = ctx[0];
        let qps = ctx[1];
        let gps = ctx[2];
        let bs = ctx[3];
        let lays = ctx[4];
        let model = ctx[5];
        let sts = ctx[6];
        let maxpos = ctx[7];
        q4t-embed(qps, gps, bs, model[0], id);
        q4t-blocks(aps, qps, gps, bs, model, lays, sts, 0, pos, maxpos, id, prev1, prev2);
        q4t-head-mix(qps, gps, bs, model);
        metal_sync();
        1;
    };
    def q4t-forward(ctx, id, pos, prev1, prev2) = {
        let aps = ctx[0];
        let qps = ctx[1];
        let gps = ctx[2];
        let bs = ctx[3];
        let lays = ctx[4];
        let model = ctx[5];
        let sts = ctx[6];
        let maxpos = ctx[7];
        q4t-embed(qps, gps, bs, model[0], id);
        q4t-blocks(aps, qps, gps, bs, model, lays, sts, 0, pos, maxpos, id, prev1, prev2);
        // Keep the currently serial layer schedule intact. The cooperative
        // vocab reductions use the carrier's explicit dependency protocol,
        // so they begin in a bounded concurrent batch after layer state is
        // complete. The prefill fusion pass can join these without changing
        // this parity boundary.
        metal_sync();
        metal_batch_concurrent();
        q4t-head(aps, qps, gps, bs, model);
    };
    def q4t-paths(prefix) = [(prefix + "00001-of-00003.gguf"), (prefix + "00002-of-00003.gguf"), (prefix + "00003-of-00003.gguf")];
    def q4t-open(prefix, maxpos) = {
        let paths = q4t-paths(prefix);
        let src2 = eqr-of-file(paths[1], 0, 16000000);
        let src3 = eqr-of-file(paths[2], 0, 16000000);
        let unit = q4gj-msl();
        let aps = q38-pipes(unit);
        let qps = q4eq-all-pipes(unit);
        let gps = q4gj-pipes(unit);
        let bs = q4t-bufs(maxpos);
        let lays = q4gl-layers(paths, src2, src3);
        let model = q4gl-model(paths, src2, src3);
        let sts = q4t-state(maxpos);
        q4t-write-ple-tables(bs);
        [aps, qps, gps, bs, lays, model, sts, maxpos];
    };
    def q4t-free-handles(xs) = (Comparable) len(xs) == 0 ? 1 : {
        xs[0] > 0 ? metal_buf_free(xs[0]) : 0;
        q4t-free-handles(xs[1:]);
    };
    def q4t-free-state(sts) = (Comparable) len(sts) == 0 ? 1 : {
        q4t-free-handles(sts[0]);
        q4t-free-state(sts[1:]);
    };
    def q4t-state-handles(sts) = (Comparable) len(sts) == 0 ? [] : append(nmtl-positive-values(sts[0]), q4t-state-handles(sts[1:]));
    def q4t-state-sizes-go(layer, maxpos) = layer >= 48 ? [] : append(nmtl-positive-values(nmtl-qwen-state-sizes(layer, maxpos, q4g-full(layer))), q4t-state-sizes-go((Number) layer + (Number) 1, maxpos));
    def q4t-ledger-groups(ctx, parent, owner, epoch) = {
        let mappedHandles = append(q4gl-layer-handles(ctx[4]), q4gl-list-handles(ctx[5]));
        let mappedSizes = append(q4gl-layer-sizes(ctx[4]), q4gl-list-sizes(ctx[5]));
        [nmtl-group("tensor.qwen38.mapped", parent, owner, "mapped-tensors", mappedHandles, mappedSizes, epoch, "gguf.record-bytes+metal_buf_from_file", ["model", "memory", "tensor", "metal", "gpu", "layer"]), nmtl-group("tensor.qwen38.scratch", parent, owner, "allocated-tensors", ctx[3], nmtl-qwen-scratch-sizes(ctx[7]), epoch, "q4t-bufs+native-model-tensor-ledger", ["model", "memory", "tensor", "metal", "gpu", "scratch"]), nmtl-group("tensor.qwen38.state", parent, owner, "allocated-state", q4t-state-handles(ctx[6]), q4t-state-sizes-go(0, ctx[7]), epoch, "q4t-state+native-model-tensor-ledger", ["model", "memory", "tensor", "metal", "gpu", "substate", "layer"])];
    };
    def q4t-close(ctx) = {
        q4t-free-handles(ctx[3]);
        q4gl-free-layers(ctx[4]);
        q4gl-free-list(ctx[5]);
        q4t-free-state(ctx[6]);
        1;
    };
    0;
}
