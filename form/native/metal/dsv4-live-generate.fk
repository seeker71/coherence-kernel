; Direct Form-native DS4 generation entry.
;
; The final expression is intentionally a direct function call. The source
; runner therefore lowers the entry recipe to ARM64 in-process and dispatches
; it through the native Value ABI when the complete call graph is lowerable.
; Tensor operations remain Form-emitted Metal kernels in the resident session.
;
; preludes: native/metal/dsv4-native-session.fk form-stdlib/dsv4-generation-request.fk config/dsv4-local-resource.fk

(do
    (defn dsv4-live-chat-ids (model question)
        (do
            (let src (tkz-src model))
            (append
                (list
                    (tkz-stored-id-of src "<｜begin▁of▁sentence｜>")
                    (tkz-stored-id-of src "<｜User｜>"))
                (append
                    (tkz-encode src question)
                    (list
                        (tkz-stored-id-of src "<｜Assistant｜>")
                        (tkz-stored-id-of src "</think>"))))))

    (defn dsv4-live-run (question n)
        (do
            (let model (dsv4-local-model-resource))
            (let prompt-ids (dsv4-live-chat-ids model question))
            (let result-ids
                (dns-generate-ids-jit
                    (dsv4-local-jit-carrier-resource)
                    prompt-ids
                    n))
            (list prompt-ids result-ids)))

    (defn dsv4-live-render (model run)
        (do
            (let prompt-ids (nth run 0))
            (let result-ids (nth run 1))
            (let src (tkz-src model))
            (print_str (str_concat "NATIVE prompt-token-count="
                (int_to_str (len prompt-ids))))
            (print_str (str_concat "NATIVE result-token-ids="
                (dgr-ids-csv result-ids)))
            (print_str (str_concat "NATIVE result-text="
                (tkz-decode-text src result-ids)))
            (print_str
                "NATIVE route=form-arm64-jit+form-metal remote=0 network=0 shell=0")
            0))

    (defn dsv4-live-generate (question n)
        (do
            (let model (dsv4-local-model-resource))
            (dsv4-live-render model (dsv4-live-run question n))
            0))

    0)
