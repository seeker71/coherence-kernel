; dense-run-moondream.fk — moondream2's phi2 text stack end to end: parallel residual, LayerNorm
; with bias, fused qkv split on the device, half-split rope over 32 of 64 dims, GELU, Q4_0
; weights. A RUN DRIVER, not the band.
;
; preludes: native/metal/dense-token-handle.fk

(do
    (defn drp-blob () "/Users/ursmuff/.ollama/models/blobs/sha256-e554c6b9de016673fd2c732e0342967727e9659ca5f853a4947cc96263fa602b")
    (defn drp-prompt () "The capital of France is")

    (defn drp-join (xs acc)
        (if (eq (len xs) 0) acc
            (drp-join (tail xs) (str_concat acc (str_concat " " (int_to_str (head xs)))))))

    (let live (md-door-live?))
    (print (if live "door=live" "door=DEAD"))

    (let tA (now_unix_ms))
    (let st (dth-p2-open (drp-blob) 256))
    (let tB (now_unix_ms))
    (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2))
    (let lays (nth st 3)) (let cks (nth st 4)) (let cvs (nth st 5))
    (let embTv (nth st 6)) (let onormTv (nth st 7)) (let onormB (nth st 8))
    (let projTv (nth st 9)) (let projB (nth st 10))
    (let src (nth st 12))

    (print (str_concat "arch=" (nth st 11)))
    (print (str_concat "open_ms=" (int_to_str (sub tB tA))))
    (print (str_concat "geo d/dff/nh/nkv/hd/kvd/vocab/nlayer/rd="
        (drp-join (list (nth geo 0) (nth geo 1) (nth geo 2) (nth geo 3) (nth geo 4) (nth geo 5)
                        (nth geo 7) (nth geo 12) (nth geo 15)) "")))
    (print (str_concat "pipes_ok=" (if (dth-pipe-ok? ps) "1" "0")))

    (let tC (now_unix_ms))
    (let ids (dtk-encode src (drp-prompt)))
    (let tD (now_unix_ms))
    (print (str_concat "tokenize_ms=" (int_to_str (sub tD tC))))
    (print (str_concat "prompt_ids=" (drp-join ids "")))

    (let tE (now_unix_ms))
    (let pf (dth-p2-prefill ps bs geo lays cks cvs embTv onormTv onormB projTv projB ids 0))
    (let tF (now_unix_ms))
    (let first (nth pf 0))
    (print (str_concat "first_id=" (int_to_str first)))
    (print (str_concat "prefill_ms=" (int_to_str (sub tF tE))))

    (let tG (now_unix_ms))
    (let rest (dth-p2-generate ps bs geo lays cks cvs embTv onormTv onormB projTv projB first (len ids) 15 (empty)))
    (let tH (now_unix_ms))
    (let got (append (list first) rest))
    (print (str_concat "ids=" (drp-join got "")))
    (print (str_concat "decode_ms=" (int_to_str (sub tH tG))))

    (print (str_concat "text=" (l3d-text src got)))
    (print (metal_status))
    0)
