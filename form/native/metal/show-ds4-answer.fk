; show-ds4-answer.fk — decode the sealed DS4 stream to the words it actually generated.
; The ids are the witnessed greedy continuation of "The capital of France is" (prompt 671 6102 294
; 8760 344, then the 25 generated) from stack-stream-probe's STREAM MATCH 25/25, canonical file.
; preludes: form-stdlib/dsv4-tokenizer.fk
(do
    (let src (read_file_slice
        "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf"
        0 8388608))
    (defn sda-go (src ids)
        (if (eq (len ids) 0) 0
            (do (print_str (tkz-decode-id-bytes src (head ids)))
                (sda-go src (tail ids)))))
    (print_str "=== prompt ===")
    (sda-go src (list 671 6102 294 8760 344))
    (print_str "")
    (print_str "=== DS4 form-native continuation (25 tokens, greedy) ===")
    (sda-go src (list 11111 16 455 6102 294 8760 344 11111 16 455 6102 294 8760 344
                  11111 16 455 6102 294 8760 344 11111 16 455 6102 294))
    (print_str "")
    0)
