// qwen35-crystal.fk — pre-crystallized open: the long chain's derived integers,
// frozen once, keyed by the artifact's content seal.
//
// Measured 2026-08-24 (an open-cost probe, split by phase): a fresh generate paid
// 16.3 s of open (7.1 s q38-tabs, 15.0 s layer tv derivation, 1.1 s three
// head-tensor scans), 7.0 s of tokenizer (four full-vocab special-id scans and
// five constant scaffold encodes), and 0.7 s of required-size — ~25 s of walker
// re-deriving integers that cannot change while the seal holds. This cell is
// the crystallize-on-heat law (jit-decision.fk) applied one level up: the
// recipe here is not a function's asm but an OPEN's derived table. Both doors:
//   pre  — the precrystallize pass freezes ahead of any ask;
//   heat — fcmg-fresh freezes on the first ask that finds no crystal
// (this recipe's one firing costs seconds, so the crystallize threshold is 1
// where jd-crystallize? asks 5 of a cheap one; same law, heat priced in ms).
// Either way every later open walks the flat recording, not the header.
//
// The key is the .form-seal line (content hash), never mtime — the .fkb cache
// taught that lesson (an edit inside one second was invisible). A crystal
// whose key line differs from the live seal is dead ice: ignored, refrozen.
//
// Nothing here is trusted unfrozen: the proof re-derives
// the scan path and demands row-for-row equality plus the same first token
// from both opens (the band that runs it is pending in this tree).
//
import native/metal/qwen35-dense-token-handle.fk;
import form-stdlib/qwen35-tokenizer.fk;
import form-stdlib/qwen35-artifact-seal-reader.fk;
section [form.bml] {
    def qsx-path(path) = (path + ".form-crystal");
    def qsx-magic() = 9380001;
    // ---- trim a possible trailing newline from a whole-file read ----------
    def qsx-trim(s) = {
        let n = len(s);
        (Comparable) n == 0 ? s : (Comparable) str_byte_at(s, n - 1) == 10 ? substring(s, 0, n - 1) : s;
    };
    def qsx-seal-line(path) = qsx-trim(read_file(qaf-seal-path-for(path)));
    // ---- one derived tensor row: everything kth-tv-at computes, as ints ---
    def qsx-row(src, base, off) = [(Number) base + (Number) egg-ti-dataoff(src, off), kth-bytes(src, off), egg-ti-ndims(src, off) > 1 ? egg-ti-dim(src, off, 1) : 1, egg-ti-dim(src, off, 0), egg-ti-type(src, off)];
    def qsx-row-for(src, base, tabs, k, l) = qsx-row(src, base, gti-off-for(nth(tabs, k), l));
    // mirror of q38-layer, collecting rows instead of buffer views
    def qsx-common-rows(src, base, tabs, l) = [qsx-row-for(src, base, tabs, 0, l), qsx-row-for(src, base, tabs, 1, l), qsx-row-for(src, base, tabs, 2, l), qsx-row-for(src, base, tabs, 3, l), qsx-row-for(src, base, tabs, 4, l)];
    def qsx-layer-rows(src, base, tabs, l, interval) = kth-full?(l, interval) ? append(qsx-common-rows(src, base, tabs, l), [qsx-row-for(src, base, tabs, 14, l), qsx-row-for(src, base, tabs, 15, l), qsx-row-for(src, base, tabs, 16, l), qsx-row-for(src, base, tabs, 17, l), qsx-row-for(src, base, tabs, 18, l), qsx-row-for(src, base, tabs, 19, l)]) : append(qsx-common-rows(src, base, tabs, l), [qsx-row-for(src, base, tabs, 5, l), qsx-row-for(src, base, tabs, 6, l), qsx-row-for(src, base, tabs, 7, l), qsx-row-for(src, base, tabs, 8, l), qsx-row-for(src, base, tabs, 9, l), qsx-row-for(src, base, tabs, 10, l), qsx-row-for(src, base, tabs, 11, l), qsx-row-for(src, base, tabs, 12, l), qsx-row-for(src, base, tabs, 13, l)]);
    def qsx-all-layer-rows(src, base, tabs, l, n, interval, acc) = l >= n ? acc : qsx-all-layer-rows(src, base, tabs, (Number) l + (Number) 1, n, interval, append(acc, [qsx-layer-rows(src, base, tabs, l, interval)]));
    // ---- serialization: one int per line under the key line ---------------
    def qsx-int-line(v) = (v.str() + "\n");
    def qsx-ints-text(xs, acc) = (Comparable) len(xs) == 0 ? acc : qsx-ints-text(xs[1:], ((String) acc + qsx-int-line(xs[0])));
    def qsx-seq-text(ids) = qsx-ints-text(ids, qsx-int-line(len(ids)));
    def qsx-row-text(row) = qsx-ints-text(row, "");
    def qsx-rows-text(rows, acc) = (Comparable) len(rows) == 0 ? acc : qsx-rows-text(rows[1:], ((String) acc + qsx-row-text(rows[0])));
    def qsx-layer-text(rows) = ((String) qsx-int-line(len(rows)) + qsx-rows-text(rows, ""));
    def qsx-layers-text(lrows, acc) = (Comparable) len(lrows) == 0 ? acc : qsx-layers-text(lrows[1:], ((String) acc + qsx-layer-text(lrows[0])));
    // ---- freeze: derive once, write the recording --------------------------
    // Freeze pays the full scan exactly once; that firing IS the heat.
    def qsx-freeze(path) = {
        let src = eqr-of-file(path, 0, 40000000);
        let base = egg-data-base(src, 32);
        let tabs = q38-tabs(src);
        let geo = q38-geo(src, 128);
        let n = geo[21];
        let interval = geo[22];
        let lrows = qsx-all-layer-rows(src, base, tabs, 0, n, interval, []);
        let erow = qsx-row(src, base, egg-find-tensor(src, "token_embd.weight"));
        let orow = qsx-row(src, base, egg-find-tensor(src, "output_norm.weight"));
        let prow = qsx-row(src, base, egg-find-tensor(src, "output.weight"));
        let required = q38-required-size(src, base);
        let ims = q35-special-id(src, "<|im_start|>");
        let ime = q35-special-id(src, "<|im_end|>");
        let ths = q35-special-id(src, "<think>");
        let the = q35-special-id(src, "</think>");
        let text = ((qsx-seal-line(path) + "\n") + (qsx-int-line(qsx-magic()) + (qsx-ints-text([ims, ime, ths, the], "") + (qsx-seq-text(q35-encode(src, "user\n")) + (qsx-seq-text(q35-encode(src, "\n")) + (qsx-seq-text(q35-encode(src, "assistant\n")) + (qsx-seq-text(q35-encode(src, "\n\n")) + (qsx-int-line(required) + (qsx-int-line(n) + (qsx-int-line(interval) + ((String) qsx-layers-text(lrows, "") + qsx-rows-text([erow, orow, prow], ""))))))))))));
        write_file(qsx-path(path), text);
    };
    // ---- parse: a cursor over the int lines --------------------------------
    // each reader answers (list value next-pos)
    def qsx-parse-int(s, n, i, acc) = i >= n ? [acc, i] : {
        let c = str_byte_at(s, i);
        (Comparable) c == 10 ? [acc, (Number) i + (Number) 1] : qsx-parse-int(s, n, (Number) i + (Number) 1, (Number) (acc * 10) + (Number) (c - 48));
    };
    def qsx-take-ints(s, n, i, k, acc) = (Comparable) k == 0 ? [reverse(acc), i] : {
        let r = qsx-parse-int(s, n, i, 0);
        qsx-take-ints(s, n, r[1], k - 1, cons(r[0], acc));
    };
    def qsx-take-seq(s, n, i) = {
        let c = qsx-parse-int(s, n, i, 0);
        qsx-take-ints(s, n, c[1], c[0], []);
    };
    def qsx-take-rows(s, n, i, k, acc) = (Comparable) k == 0 ? [reverse(acc), i] : {
        let r = qsx-take-ints(s, n, i, 5, []);
        qsx-take-rows(s, n, r[1], k - 1, cons(r[0], acc));
    };
    def qsx-take-layers(s, n, i, k, acc) = (Comparable) k == 0 ? [reverse(acc), i] : {
        let cnt = qsx-parse-int(s, n, i, 0);
        let rows = qsx-take-rows(s, len(s), cnt[1], cnt[0], []);
        qsx-take-layers(s, n, rows[1], k - 1, cons(rows[0], acc));
    };
    // qsx-load -> (list 0) when absent, keyless, or foreign; else
    // (list 1 ims ime ths the useq nlseq aseq tseq required nlayers interval
    //         layer-rows erow orow prow)
    def qsx-load-parsed(s, n, i) = {
        let magic = qsx-parse-int(s, n, i, 0);
        !((Comparable) magic[0] == qsx-magic()) ? [0] : {
            let sp = qsx-take-ints(s, n, magic[1], 4, []);
            let u = qsx-take-seq(s, n, sp[1]);
            let nl = qsx-take-seq(s, n, u[1]);
            let a = qsx-take-seq(s, n, nl[1]);
            let t = qsx-take-seq(s, n, a[1]);
            let req = qsx-parse-int(s, n, t[1], 0);
            let nlay = qsx-parse-int(s, n, req[1], 0);
            let ivl = qsx-parse-int(s, n, nlay[1], 0);
            let lrows = qsx-take-layers(s, n, ivl[1], nlay[0], []);
            let heads = qsx-take-rows(s, n, lrows[1], 3, []);
            [1, sp[0][0], sp[0][1], sp[0][2], sp[0][3], u[0], nl[0], a[0], t[0], req[0], nlay[0], ivl[0], lrows[0], heads[0][0], heads[0][1], heads[0][2]];
        };
    };
    def qsx-load(path) = (Comparable) fs_exists(qsx-path(path)) == 0 ? [0] : {
        let s = read_file(qsx-path(path));
        let n = len(s);
        let key = qsx-seal-line(path);
        let kn = len(key);
        n < (Number) kn + (Number) 2 ? [0] : !((String) substring(s, 0, kn) == key) ? [0] : qsx-load-parsed(s, n, (Number) kn + (Number) 1);
    };
    // ---- rebuild: the open that walks the recording ------------------------
    def qsx-tv(path, row) = [metal_buf_from_file(path, row[0], row[1]), row[2], row[3], row[4]];
    def qsx-tvs(path, rows, acc) = (Comparable) len(rows) == 0 ? acc : qsx-tvs(path, rows[1:], append(acc, [qsx-tv(path, rows[0])]));
    def qsx-lays(path, lrows, acc) = (Comparable) len(lrows) == 0 ? acc : qsx-lays(path, lrows[1:], append(acc, [qsx-tvs(path, lrows[0], [])]));
    // mirror of q38-open, tensor views from the recording instead of the scan
    def qsx-open(path, maxpos, x) = take(10, qsx-open-span(path, maxpos, x, 1));
    def qsx-open-span(path, maxpos, x, span) = {
        let _artifact-begin = q38oo-artifact-begin();
        let src = eqr-of-file(path, 0, 40000000);
        let base = egg-data-base(src, 32);
        let _artifact-ready = q38oo-artifact-ready();
        let _geometry-begin = q38oo-geometry-begin();
        let geo = q38-geo(src, maxpos);
        let _geometry-ready = q38oo-geometry-ready();
        let _pipeline-begin = q38oo-pipeline-begin();
        let ps = q38-pipes(q38-msl());
        let _pipeline-ready = q38oo-pipeline-ready();
        let convcap = qlslc-bs2-allocation-capacity(geo);
        let _scratch-begin = q38oo-scratch-begin();
        let bs = kth-bufs-span(geo[0], convcap, geo[3] * geo[5], geo[3], geo[10], 1, geo[12] * geo[14], geo[20], maxpos, geo[12], geo[19], span);
        let _scratch-ready = q38oo-scratch-ready();
        let _layer-begin = q38oo-layer-begin();
        let lays = qsx-lays(path, x[12], []);
        let _layer-ready = q38oo-layer-ready();
        let _tensor-begin = q38oo-tensor-begin();
        let embTv = qsx-tv(path, x[13]);
        let onormTv = qsx-tv(path, x[14]);
        let projTv = qsx-tv(path, x[15]);
        let _tensor-ready = q38oo-tensor-ready();
        let _open-ready = q38oo-open-ready();
        [ps, bs, geo, lays, embTv, onormTv, projTv, src, base, path, span];
    };
    // ---- the chat sequence with every constant piece already ice ----------
    def qsx-chat-ids(src, prompt, x) = tkz-cat([x[1]], tkz-cat(x[5], tkz-cat(q35-encode(src, prompt), tkz-cat([x[2]], tkz-cat(x[6], tkz-cat([x[1]], tkz-cat(x[7], tkz-cat([x[3]], tkz-cat(x[8], tkz-cat([x[4]], x[8]))))))))));
    def qsx-required(x) = x[9];
    def qsx-ime(x) = x[2];
    0;
}
