; work-replay-ask.fk — ONE ad-hoc prompt through a local dense lane, by hand.
;
; The replay LOOP is form/native/metal/work-replay-loop.fk — it iterates the corpus,
; senses each continuation inside the loop and lands living rows. This cell is the
; single-ask hand probe beside it: any prompt, any blob, no judge — it holds no
; opinion about the answer, it prints what the lane computed and honest ms.
;
; Direct-source Form reads no argv, so the run arrives in files:
;   /tmp/work-replay-blob    — GGUF blob path (dense arch through dth-open)
;   /tmp/work-replay-prompt  — the continuation prompt, verbatim bytes
;   /tmp/work-replay-n       — decode token count, decimal
;
;   ./fkwu-metal --src form/native/metal/work-replay-ask.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY
;
; preludes: native/metal/dense-token-handle.fk

(do
    (defn wra-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n") (wra-trim-loop s (sub n 1))
                (substring s 0 n))))
    (defn wra-file (p)
        (if (eq (fs_exists p) 0) ""
            (wra-trim-loop (read_file p) (str_len (read_file p)))))
    (defn wra-prompt-raw (p)
        (if (eq (fs_exists p) 0) "" (read_file p)))

    (defn wra-join (xs acc)
        (if (eq (len xs) 0) acc
            (wra-join (tail xs) (str_concat acc (str_concat " " (int_to_str (head xs)))))))

    (let blob (wra-file "/tmp/work-replay-blob"))
    (let prompt (wra-prompt-raw "/tmp/work-replay-prompt"))
    (let nstr (wra-file "/tmp/work-replay-n"))
    (let n (if (eq (str_len nstr) 0) 64 (str_to_int nstr)))

    (if (eq (str_len blob) 0)
        (print "work-replay-ask: write the blob path to /tmp/work-replay-blob first")
        (do (let live (md-door-live?))
            (print (if live "door=live" "door=DEAD"))
            (let tA (now_unix_ms))
            (let ids0 (list 0))
            (let st (dth-open blob 1536 (sub 0 1)))
            (let tB (now_unix_ms))
            (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2))
            (let lays (nth st 3)) (let cks (nth st 4)) (let cvs (nth st 5))
            (let src (nth st 10))
            (print (str_concat "arch=" (nth st 9)))
            (print (str_concat "open_ms=" (int_to_str (sub tB tA))))
            (let tC (now_unix_ms))
            (let ids (dtk-encode src prompt))
            (let tD (now_unix_ms))
            (print (str_concat "prompt_tokens=" (int_to_str (len ids))))
            (print (str_concat "tokenize_ms=" (int_to_str (sub tD tC))))
            (let tE (now_unix_ms))
            (let pf (dth-prefill ps bs geo lays cks cvs (nth st 6) (nth st 7) (nth st 8) ids 0))
            (let tF (now_unix_ms))
            (let first (nth pf 0))
            (print (str_concat "prefill_ms=" (int_to_str (sub tF tE))))
            (let tG (now_unix_ms))
            (let rest (dth-generate ps bs geo lays cks cvs (nth st 6) (nth st 7) (nth st 8)
                                    first (len ids) (sub n 1) (empty)))
            (let tH (now_unix_ms))
            (let got (append (list first) rest))
            (print (str_concat "decode_ms=" (int_to_str (sub tH tG))))
            (print (str_concat "ids=" (wra-join got "")))
            (print "<<TEXT>>")
            (print (l3d-text src got))
            (print "<<END>>")
            (print (metal_status))
            0)))
