; Hash-layer expert selection and live router weighting.
(do
    (defn dsv4-hash-route-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_hash_route(device const float* logits [[buffer(0)]], device const int* table_row [[buffer(1)]], device uint* ids [[buffer(2)]], device float* weights [[buffer(3)]], constant uint& selected [[buffer(4)]], constant float& weight_scale [[buffer(5)]], constant float& floor_sum [[buffer(6)]], uint gid [[thread_position_in_grid]]) { if(gid!=0u)return; float total=0.0f; for(uint i=0;i<selected;i++){ int id=table_row[i]; ids[i]=uint(id); float x=log(1.0f+exp(logits[id])); float p=sqrt(x); weights[i]=p; total+=p; } total=max(total,floor_sum); for(uint i=0;i<selected;i++)weights[i]=weights[i]*weight_scale/total; }\n")
    0)
