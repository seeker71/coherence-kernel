// qwen35-dense-spec.fk — speculative decoding for the dense Qwen3.5/Qwen3.8 lane, from the MTP head the GGUF already carries.
//
// Decode is bound by streaming every weight once a token. Checking k drafted tokens is ONE weight pass (a span through the
// layers), so the tokens the model accepts of its own draft are tokens the bandwidth wall did not charge for. The draft is the
// model's own MTP head: blk.<nL> (one full-attention block, dense FFN) and the four nextn tensors. The graph, as llama.cpp
// builds it (src/models/qwen35.cpp graph_mtp), read from the source:
//     h' = rms(h, hnorm)   e' = rms(embed(token), enorm)   cur = eh_proj . [e' ; h']        (e' first, then h')
//     cur = cur + FullAttnBlock(rms(cur, attn_norm))        (its own K/V cache, position = the token's position)
//     cur = cur + FFN(rms(cur, post_attention_norm))
//     h_next = rms(cur, shared_head_norm)                   (the hidden the NEXT chained draft step takes as its h)
//     logits = output.weight . h_next                       (the main model's own head)
// where h is the main model's hidden AFTER output_norm at the position before the token (h_nextn = result_norm), and the
// token is the one sampled from that hidden: the head at position q pairs (h_{q-1}, x_q) and predicts x_{q+1}.
//
// WHAT THIS FILE ADDS, all appended and local (its own pipeline list, so the lane's 63 pipelines keep their indices):
//   * mvk: a Q8_0 matvec over NT activation columns (NT = 1..8) that reads each weight once and keeps the wide matvec's
//     arithmetic and reduction order exactly, token by token (a verification column is the same bits as a decode matvec).
//   * snapshot variants of the two recurrences (conv window, delta state): after every token but the last of a span they write
//     the state they reached into a per-layer snapshot slot, so a rejected draft restores by a copy, never by recompute.
//   * span embedding from a device id buffer, row concat, span argmax: a verified step needs no host round trip but one.
//
import native/metal/qwen35-dense-token-handle.fk;
import native/metal/qwen35-dense-mm.fk;
section [form.bml] {
    def q38s-cat(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + q38s-cat(parts[1:]));
    def q38s-nt-max() = 8;
    // ── mvk ────────────────────────────────────────────────────────────────
    def q38s-mvk-msl(nt) = q38s-cat(["kernel void form_q38s_mvk", nt.str(), " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], constant uint& ystride [[buffer(5)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 ntg [[threads_per_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { threadgroup float sh[", (nt * 64).str(), "]; uint nb = cols / 32u; uint r0 = tgpig.x * 2u; uint nsg = (uint)ntg.x / 32u; uint stride = nsg * 8u; ushort ix = tiisg / 4u; ushort il = tiisg - ix * 4u; uint ib0 = (uint)sgitg * 8u + (uint)ix; float sumf[", (nt * 2).str(), "]; for (uint a = 0u; a < ", (nt * 2).str(), "u; ++a) { sumf[a] = 0.0f; } for (uint ib = ib0; ib < nb; ib += stride) { char4 wa[2]; char4 wc[2]; float dd[2]; for (ushort row = 0u; row < 2u; ++row) { uint r = r0 + (uint)row; if (r >= rows) { wa[row] = char4(0); wc[row] = char4(0); dd[row] = 0.0f; } else { ulong bo = ((ulong)r * (ulong)nb + (ulong)ib) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); device const uchar* qs = qb + bo + 2ul + (ulong)((uint)il * 8u); wa[row] = char4(*(device const packed_char4*)(qs)); wc[row] = char4(*(device const packed_char4*)(qs + 4)); dd[row] = float(as_type<half>(h)); } } for (uint t = 0u; t < ", nt.str(), "u; ++t) { device const float* yb = x + (ulong)t * (ulong)cols + (ulong)ib * 32ul + (ulong)il * 8ul; packed_float4 ya = *(device const packed_float4*)(yb); packed_float4 yc = *(device const packed_float4*)(yb + 4); for (ushort row = 0u; row < 2u; ++row) { float sumq = 0.0f; sumq = metal::fma(float(wa[row].x), ya.x, sumq); sumq = metal::fma(float(wa[row].y), ya.y, sumq); sumq = metal::fma(float(wa[row].z), ya.z, sumq); sumq = metal::fma(float(wa[row].w), ya.w, sumq); sumq = metal::fma(float(wc[row].x), yc.x, sumq); sumq = metal::fma(float(wc[row].y), yc.y, sumq); sumq = metal::fma(float(wc[row].z), yc.z, sumq); sumq = metal::fma(float(wc[row].w), yc.w, sumq); sumf[t * 2u + (uint)row] = metal::fma(sumq, dd[row], sumf[t * 2u + (uint)row]); } } } for (uint a = 0u; a < ", (nt * 2).str(), "u; ++a) { sumf[a] = metal::simd_sum(sumf[a]); } if (sgitg == 0u) { for (uint a = 0u; a < ", (nt * 2).str(), "u; ++a) { sh[a * 32u + (uint)tiisg] = 0.0f; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) { for (uint a = 0u; a < ", (nt * 2).str(), "u; ++a) { sh[a * 32u + (uint)sgitg] = sumf[a]; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); for (uint a = 0u; a < ", (nt * 2).str(), "u; ++a) { float tot = metal::simd_sum(sh[a * 32u + (uint)tiisg]); if (tiisg == 0u && sgitg == 0u) { uint t = a / 2u; uint r = r0 + (a - t * 2u); if (r < rows) { y[(ulong)t * (ulong)ystride + (ulong)r] = tot; } } } }"]);
    def q38s-mvk-all-go(nt) = nt > q38s-nt-max() ? "" : ((String) q38s-mvk-msl(nt) + q38s-mvk-all-go(nt + 1));
    // the same kernel with rr rows a group instead of two: every activation load is reused across rr rows, so the activation traffic
    // through the caches (which at NT columns is NT times the weights' and what the 2-row kernel's NT=4..8 time is made of) falls to
    // 2/rr of it. Per row and token the arithmetic and the order of its sums are the 2-row kernel's, so the answers are the same bytes.
    def q38s-mvr-msl(nt, rr) = q38s-cat(["kernel void form_q38s_mvr", rr.str(), "_", nt.str(), " (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], constant uint& ystride [[buffer(5)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 ntg [[threads_per_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { threadgroup float sh[", (nt * rr * 32).str(), "]; uint nb = cols / 32u; uint r0 = tgpig.x * ", rr.str(), "u; uint nsg = (uint)ntg.x / 32u; uint stride = nsg * 8u; ushort ix = tiisg / 4u; ushort il = tiisg - ix * 4u; uint ib0 = (uint)sgitg * 8u + (uint)ix; float sumf[", (nt * rr).str(), "]; for (uint a = 0u; a < ", (nt * rr).str(), "u; ++a) { sumf[a] = 0.0f; } for (uint ib = ib0; ib < nb; ib += stride) { char4 wa[", rr.str(), "]; char4 wc[", rr.str(), "]; float dd[", rr.str(), "]; for (ushort row = 0u; row < ", rr.str(), "u; ++row) { uint r = r0 + (uint)row; if (r >= rows) { wa[row] = char4(0); wc[row] = char4(0); dd[row] = 0.0f; } else { ulong bo = ((ulong)r * (ulong)nb + (ulong)ib) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); device const uchar* qs = qb + bo + 2ul + (ulong)((uint)il * 8u); wa[row] = char4(*(device const packed_char4*)(qs)); wc[row] = char4(*(device const packed_char4*)(qs + 4)); dd[row] = float(as_type<half>(h)); } } for (uint t = 0u; t < ", nt.str(), "u; ++t) { device const float* yb = x + (ulong)t * (ulong)cols + (ulong)ib * 32ul + (ulong)il * 8ul; packed_float4 ya = *(device const packed_float4*)(yb); packed_float4 yc = *(device const packed_float4*)(yb + 4); for (ushort row = 0u; row < ", rr.str(), "u; ++row) { float sumq = 0.0f; sumq = metal::fma(float(wa[row].x), ya.x, sumq); sumq = metal::fma(float(wa[row].y), ya.y, sumq); sumq = metal::fma(float(wa[row].z), ya.z, sumq); sumq = metal::fma(float(wa[row].w), ya.w, sumq); sumq = metal::fma(float(wc[row].x), yc.x, sumq); sumq = metal::fma(float(wc[row].y), yc.y, sumq); sumq = metal::fma(float(wc[row].z), yc.z, sumq); sumq = metal::fma(float(wc[row].w), yc.w, sumq); sumf[t * ", rr.str(), "u + (uint)row] = metal::fma(sumq, dd[row], sumf[t * ", rr.str(), "u + (uint)row]); } } } for (uint a = 0u; a < ", (nt * rr).str(), "u; ++a) { sumf[a] = metal::simd_sum(sumf[a]); } if (sgitg == 0u) { for (uint a = 0u; a < ", (nt * rr).str(), "u; ++a) { sh[a * 32u + (uint)tiisg] = 0.0f; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) { for (uint a = 0u; a < ", (nt * rr).str(), "u; ++a) { sh[a * 32u + (uint)sgitg] = sumf[a]; } } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); for (uint a = 0u; a < ", (nt * rr).str(), "u; ++a) { float tot = metal::simd_sum(sh[a * 32u + (uint)tiisg]); if (tiisg == 0u && sgitg == 0u) { uint t = a / ", rr.str(), "u; uint r = r0 + (a - t * ", rr.str(), "u); if (r < rows) { y[(ulong)t * (ulong)ystride + (ulong)r] = tot; } } } }"]);
    def q38s-mvr-all-go(nt, rr) = nt > q38s-nt-max() ? "" : ((String) q38s-mvr-msl(nt, rr) + q38s-mvr-all-go(nt + 1, rr));
    // qs index of the four-row kernel at nt columns; the 2-row family is qs[nt - 1]
    def q38s-mvr-index(rr, nt) = 14 + (nt - 1);
    def q38s-mvr-pipes-go(msl, rr, nt) = nt > q38s-nt-max() ? [] : cons(metal_pipeline(msl, "form_q38s_mvr" + (rr.str() + ("_" + nt.str()))), q38s-mvr-pipes-go(msl, rr, nt + 1));
    // ── embedding a span of tokens whose ids live on the device (the drafts the chain just chose) ──
    def q38s-embed-msl() = "kernel void form_q38s_embed_ids (device const uchar* qb [[buffer(0)]], device const uint* ids [[buffer(1)]], device float* d [[buffer(2)]], constant uint& n [[buffer(3)]], constant uint& ntok [[buffer(4)]], constant uint& idoff [[buffer(5)]], uint gid [[thread_position_in_grid]]) { uint t = gid / n; if (t >= ntok) return; uint i = gid - t * n; ulong idx = (ulong)ids[idoff + t] * (ulong)n + (ulong)i; ulong blk = idx / 32ul; uint k = (uint)(idx - blk * 32ul); ulong b = blk * 34ul; ushort hb = (ushort)qb[b] | ((ushort)qb[b + 1ul] << 8); float dd = float(as_type<half>(hb)); float q = float(as_type<char>(qb[b + 2ul + (ulong)k])); d[(ulong)t * (ulong)n + (ulong)i] = dd * q; }";
    // y[t] = [a[t] ; b[t]], rows of n floats: the input of eh_proj
    def q38s-concat-msl() = "kernel void form_q38s_concat2 (device const float* a [[buffer(0)]], device const float* b [[buffer(1)]], device float* y [[buffer(2)]], constant uint& n [[buffer(3)]], constant uint& ntok [[buffer(4)]], uint gid [[thread_position_in_grid]]) { uint w = 2u * n; uint t = gid / w; if (t >= ntok) return; uint i = gid - t * w; y[(ulong)t * (ulong)w + (ulong)i] = i < n ? a[(ulong)t * (ulong)n + (ulong)i] : b[(ulong)t * (ulong)n + (ulong)(i - n)]; }";
    // ── the two recurrences with a snapshot of the state after every token but the last ──
    // The bodies are q38-conv-span-msl and q38-delta-span-msl line for line; the only addition is the write into snap.
    def q38s-conv-snap-msl() = "kernel void form_q38s_conv_snap (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], device float* snap [[buffer(4)]], constant uint& nch [[buffer(5)]], constant uint& kw [[buffer(6)]], constant uint& stride [[buffer(7)]], constant uint& ntok [[buffer(8)]], constant uint& snapstride [[buffer(9)]], uint c [[thread_position_in_grid]]) { if (c >= nch) return; uint b = c * kw; for (uint t = 0u; t < ntok; ++t) { for (uint j = 0u; j + 1u < kw; ++j) { win[b + j] = win[b + j + 1u]; } win[b + kw - 1u] = x[t * stride + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + win[b + j] * w[b + j]; } y[t * stride + c] = acc; if (t + 1u < ntok) { for (uint j = 0u; j < kw; ++j) { snap[t * snapstride + b + j] = win[b + j]; } } } }";
    def q38s-delta-snap-msl() = "kernel void form_q38s_delta_snap (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], device float* snap [[buffer(5)]], constant uint& nv [[buffer(6)]], constant uint& dv [[buffer(7)]], constant uint& dk [[buffer(8)]], constant uint& nk [[buffer(9)]], constant float& qscale [[buffer(10)]], constant uint& cstride [[buffer(11)]], constant uint& gstride [[buffer(12)]], constant uint& ostride [[buffer(13)]], constant uint& ntok [[buffer(14)]], constant uint& snapstride [[buffer(15)]], uint gid [[thread_position_in_grid]]) { if (gid >= nv * dv) return; uint h = gid / dv; uint i = gid - h * dv; uint kh = h - (h / nk) * nk; uint r = (h * dv + i) * dk; for (uint t = 0u; t < ntok; ++t) { uint co = t * cstride; device const float* q = c + co + kh * dk; device const float* k = c + co + nk * dk + kh * dk; float v = c[co + 2u * nk * dk + h * dv + i]; float al = alpha[t * gstride + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[t * gstride + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); if (t + 1u < ntok) { snap[t * snapstride + r + j] = sn; } } o[t * ostride + h * dv + i] = acc; } }";
    // the gated-delta recurrence as the prefill lane's simdgroup-a-state-row kernel (q38-gdnsg-msl in the prefill-gemm branch: the row's 128 values live
    // four to a lane in registers across the token loop, its two row reductions are simd_sums), with the snapshot of the state after every token but
    // the last written a float4 a lane. dk must be 128. The matrix-unit check (q38s-fast) takes it: the sums associate in the hardware's order.
    def q38s-delta-sg-msl() = "kernel void form_q38s_delta_sg_snap (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], device float* snap [[buffer(5)]], constant uint& nv [[buffer(6)]], constant uint& dv [[buffer(7)]], constant uint& dk [[buffer(8)]], constant uint& nk [[buffer(9)]], constant float& qscale [[buffer(10)]], constant uint& cstride [[buffer(11)]], constant uint& gstride [[buffer(12)]], constant uint& ostride [[buffer(13)]], constant uint& ntok [[buffer(14)]], constant uint& snapstride [[buffer(15)]], uint grp [[threadgroup_position_in_grid]], uint sgi [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]) { uint row = grp * 4u + sgi; if (row >= nv * dv) return; uint h = row / dv; uint i = row - h * dv; uint kh = h - (h / nk) * nk; device float4* sp = (device float4*)(S + (ulong)row * 128ul) + lane; float4 s = *sp; for (uint t = 0u; t < ntok; ++t) { uint co = t * cstride; float4 k4 = float4(((device const packed_float4*)(c + co + nk * 128u + kh * 128u))[lane]); float4 q4 = float4(((device const packed_float4*)(c + co + kh * 128u))[lane]); float v = c[co + 2u * nk * 128u + h * dv + i]; float al = alpha[t * gstride + h]; float bt = beta[t * gstride + h]; float4 sp4 = s * al; float4 pr = sp4 * k4; float pred = metal::simd_sum((pr.x + pr.y) + (pr.z + pr.w)); float err = v - pred; float bw = bt * err; s = sp4 + bw * k4; if (t + 1u < ntok) { ((device float4*)(snap + (ulong)t * (ulong)snapstride + (ulong)row * 128ul))[lane] = s; } float4 ac = s * (qscale * q4); float accv = metal::simd_sum((ac.x + ac.y) + (ac.z + ac.w)); if (lane == 0u) { o[t * ostride + h * dv + i] = accv; } } *sp = s; }";
    // ── span attention that IS the decode attention ──
    // q38-gqa-tg-msl (the kernel a decode token runs: one 256-thread group a head, simdgroup trees, fma) with the token axis added: a group is
    // a (token, head), token t attends over pos0 + t + 1 positions, and its q row, y row and score rows sit at the lane's span layout
    // (row = t * nq + h; S = row * sstride; E = (ntok * nq + row) * sstride). The arithmetic of every score, max, exp, sum and value fold is
    // the decode kernel's own, so a check position's attention is the decode position's, bit for bit (the lane's span kernel, q38pa,
    // folds in another order and moved the winning logit by 1-2 ulp at most positions).
    def q38s-gqa-msl() = "kernel void form_q38s_gqa_span (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& pos0 [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& ntok [[buffer(11)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { uint row = tgpig.x; uint tk = row / nq; if (tk >= ntok) return; uint h = row - tk * nq; uint npos = pos0 + tk + 1u; threadgroup float sh[16]; uint lid = (uint)sgitg * 32u + (uint)tiisg; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = row * hd; uint koff = kvh * hd; uint S = row * sstride; uint E = (ntok * nq + row) * sstride; for (uint t = lid; t < npos; t += 256u) { float acc = 0.0f; for (uint c = 0u; c < hd; ++c) { acc = metal::fma(q[qoff + c], kc[t * KVD + koff + c], acc); } sc[S + t] = acc * scale; } metal::threadgroup_barrier(metal::mem_flags::mem_device); float mx = -3.4e38f; for (uint t = lid; t < npos; t += 256u) { float v = sc[S + t]; if (v > mx) { mx = v; } } mx = metal::simd_max(mx); if (tiisg == 0) { sh[sgitg] = mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float gmx = sh[0]; for (uint k = 1u; k < 8u; ++k) { if (sh[k] > gmx) { gmx = sh[k]; } } float se = 0.0f; for (uint t = lid; t < npos; t += 256u) { float e = fexp(sc[S + t] - gmx); sc[E + t] = e; se = se + e; } se = metal::simd_sum(se); if (tiisg == 0) { sh[8u + sgitg] = se; } metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup); float tot = 0.0f; for (uint k = 0u; k < 8u; ++k) { tot = tot + sh[8u + k]; } float inv = 1.0f / tot; for (uint c = lid; c < hd; c += 256u) { float acc = 0.0f; for (uint t = 0u; t < npos; ++t) { acc = metal::fma(vc[t * KVD + koff + c], sc[E + t], acc); } y[qoff + c] = acc * inv; } }";
    // ── the argmax over every position of a span: stage one a chunk a thread (the lane's rule: strict >, lowest index wins), stage two a
    // threadgroup a position folding the partials ascending. out/oval are written at ooff + position.
    def q38s-argpart-msl() = "kernel void form_q38s_argmax_part (device const float* x [[buffer(0)]], device uint* pi [[buffer(1)]], device float* pv [[buffer(2)]], constant uint& n [[buffer(3)]], constant uint& parts [[buffer(4)]], constant uint& ntok [[buffer(5)]], uint gid [[thread_position_in_grid]]) { uint t = gid / parts; if (t >= ntok) return; uint p = gid - t * parts; ulong xo = (ulong)t * (ulong)n; uint chunk = (n + parts - 1u) / parts; uint lo = p * chunk; uint hi = lo + chunk; if (hi > n) hi = n; if (lo >= hi) { pi[t * parts + p] = 0u; pv[t * parts + p] = x[xo]; return; } uint best = lo; float bv = x[xo + lo]; uint i = lo + 1u; while (i < hi) { float xv = x[xo + i]; if (xv > bv) { bv = xv; best = i; } i += 1u; } pi[t * parts + p] = best; pv[t * parts + p] = bv; }";
    def q38s-argcomb-msl() = "kernel void form_q38s_argmax_comb (device const uint* pi [[buffer(0)]], device const float* pv [[buffer(1)]], device uint* out [[buffer(2)]], device float* oval [[buffer(3)]], constant uint& parts [[buffer(4)]], constant uint& ooff [[buffer(5)]], uint tg [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]], uint nt [[threads_per_threadgroup]]) { threadgroup uint li[4096]; threadgroup float lv[4096]; uint po = tg * parts; uint j = t; while (j < parts) { li[j] = pi[po + j]; lv[j] = pv[po + j]; j += nt; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (t != 0u) return; uint best = li[0]; float bv = lv[0]; uint p = 1u; while (p < parts) { if (lv[p] > bv) { bv = lv[p]; best = li[p]; } p += 1u; } out[ooff + tg] = best; oval[ooff + tg] = bv; }";
    def q38s-msl() = ("#include <metal_stdlib>\n#pragma clang fp contract(off)\n" + (ldm-msl-helpers() + (q38s-mvk-all-go(1) + (q38s-embed-msl() + (q38s-concat-msl() + (q38s-conv-snap-msl() + (q38s-delta-snap-msl() + (q38s-argpart-msl() + (q38s-argcomb-msl() + (q38s-mvr-all-go(1, 4) + (q38s-gqa-msl() + (q38f-msl-go(q38f-prod()) + q38s-delta-sg-msl()))))))))))));
    def q38s-pipe-gqa() = 22;
    // qs: 0..7 mvk NT 1..8, 8 embed ids, 9 concat2, 10 conv snap, 11 delta snap, 12 argmax part, 13 argmax comb, 14..21 four rows a group
    // NT 1..8, 22 the span attention (eight rows a group was measured with the 4-row one and never won: removed, the pipeline table holds 128)
    def q38s-pipe-embed() = 8;
    def q38s-pipe-concat() = 9;
    def q38s-pipe-conv() = 10;
    def q38s-pipe-delta() = 11;
