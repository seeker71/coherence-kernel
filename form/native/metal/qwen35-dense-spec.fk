        let bs = ctx[1];
        let geo = ctx[2];
        metal_enqueue(qs[q38s-pipe-embed()], md-bind16([kth-tv-h(ctx[4]), sx[0], bs[33]], [geo[0], ntok, 0], 256, 0, 0, 1), geo[0] * ntok);
        q38s-layers(ps, qs, bs, geo, ctx[3], sts, sx[9], 0, geo[21], ntok, pos0);
        q38s-head-check(ctx, qs, sx, ntok);
    };
    // output_norm over the span's residual rows (kept in sx[6]: the MTP block's next input), the vocab head over every row, the argmax of every row
    def q38s-head-check(ctx, qs, sx, ntok) = {
        let ps = ctx[0];
        let bs = ctx[1];
        let geo = ctx[2];
        q38-rms-span(ps, bs[33], ctx[5], sx[6], geo[0], geo[6], ntok, 1);
        q38s-mv(ps, qs, ctx[6], sx[6], sx[1], ntok, geo[19], 1);
        metal_enqueue(qs[q38s-pipe-argpart()], q38-b16([sx[1], sx[2], sx[3]], [geo[19], 1024, ntok], 0, 1), 1024 * ntok);
        metal_enqueue(qs[q38s-pipe-argcomb()], md-bind16([sx[2], sx[3], sx[4], sx[5]], [1024, 0], 1024, 0, 1, 1), ntok);
        1;
    };
    // rejected drafts advanced the recurrent layers past the accepted token: put the state after token m back (a device copy a layer)
    def q38s-restore-go(ps, geo, sts, snps, l, nL, m, convn, deltan) = l >= nL ? 1 : {
        let sn = nth(snps, l);
        let st = nth(sts, l);
        (Comparable) sn[0] == 0 ? 0 : {
            metal_enqueue(ps[32], q38-b16([sn[0], st[0]], [convn, m * convn], 0, 1), convn);
            metal_enqueue(ps[32], q38-b16([sn[1], st[1]], [deltan, m * deltan], 0, 1), deltan);
            1;
        };
        q38s-restore-go(ps, geo, sts, snps, l + 1, nL, m, convn, deltan);
    };
    def q38s-restore(ctx, sts, sx, m) = q38s-restore-go(ctx[0], ctx[2], sts, sx[9], 0, ctx[2][21], m, q38-recur-conv-n(ctx[2]), q38-recur-delta-n(ctx[2]));
    // ── one speculative step: ONE batch, ONE wait. ──
    // x pending at position p; cu-ids / cu-pos0: the tokens the MTP block has yet to take (their hidden rows are sx[6] rows 0..): the last is x;
    // slot: the snapshot to restore first (-1: none). Returns [drafts 1..k, verified 0..k].
    // phased = 1 waits after each section (the restore, the catch-up with the first draft, the chain, the check) and times it: the
    // diagnostic split, which costs the syncs it measures; phased = 0 is the one-wait step.
    def q38s-mark(phased) {
        phased == 1 ? {
            metal_sync();
            metal_batch_concurrent();
            host_monotonic_ms();
        } : 0;
    }
    def q38s-step(ctx, qs, sts, sx, x, p, k, cu-ids, cu-pos0, slot, phased) {
        let ps = ctx[0];
        let bs = ctx[1];
        let geo = ctx[2];
        let l0 = metal_live();
        let ta = host_monotonic_ms();
        let w0 = metal_buf_write(sx[0], 0, md-le32(x));
        let w1 = metal_buf_write(sx[0], 32, q38s-ids-bytes(cu-ids));
        metal_batch_concurrent();
        let t0 = host_monotonic_ms();
        slot >= 0 ? q38s-restore(ctx, sts, sx, slot) : 0;
        let t1 = q38s-mark(phased);
        let ncu = len(cu-ids);
        q38s-mtp-forward(ps, qs, bs, geo, sx[10], sx[11], ctx[4], sx[0], 8, sx[6], ncu, cu-pos0);
        q38s-draft-head(ps, qs, bs, geo, sx, ctx[6], ncu - 1, 1);
        let handed = q38-handover();
        let t2 = q38s-mark(phased);
        q38s-chain(ps, qs, bs, geo, sx, ctx[4], ctx[6], 2, k, p);
        let t3 = q38s-mark(phased);
        q38s-verify(ctx, qs, sts, sx, k + 1, p);
        let tb = host_monotonic_ms();
        let ver = metal_buf_read(sx[4], 0, (k + 1) * 4);
        let toks = metal_buf_read(sx[0], 0, (k + 1) * 4);
        let vals = metal_buf_read(sx[5], 0, (k + 1) * 4);
        let t4 = host_monotonic_ms();
        let l1 = metal_live();
        [q38s-u32s(toks, 0, k + 1), q38s-u32s(ver, 0, k + 1), tb - ta, phased == 1 ? [t1 - t0, t2 - t1, t3 - t2, t4 - t3] : [0, 0, 0, 0], [(l1[11] - l0[11]) / 1000, l1[7] - l0[7]], q38s-u32s(vals, 0, k + 1)];
    }
    // the longest prefix of the drafts d[1..k] that the model's own next tokens v[0..k-1] repeat
    def q38s-accept-go(d, v, j, k) = j > k ? k : (Comparable) d[j] == v[j - 1] ? q38s-accept-go(d, v, j + 1, k) : j - 1;
    // ── prefill for speculation ──
    // The lane's layer-major span prefill, then what the head needs of it: the hidden rows after output_norm for every prompt position,
    // and the MTP block's own position 0 (token 0 with a zero hidden, as llama.cpp pairs it). Returns [x0, N]: the model's first token.
    def q38s-prefill(ctx, qs, sts, sx, ids) {
        let ps = ctx[0];
        let bs = ctx[1];
        let geo = ctx[2];
        let n = len(ids);
        let r = q38-prefill-span-batched(ps, bs, geo, ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0);
        metal_batch_concurrent();
        q38-rms-span(ps, bs[33], ctx[5], sx[6], geo[0], geo[6], n, 1);
        let w = metal_buf_write(sx[0], 32, md-le32(ids[0]));
        q38s-mtp-forward(ps, qs, bs, geo, sx[10], sx[11], ctx[4], sx[0], 8, sx[8], 1, 0);
        metal_sync();
        r;
    }
    // per draft position j = 1..kmax: how many steps accepted it (the step used kcur drafts: positions past it were not tried), and tried
    def q38s-hits-go(m, j, kcur, kmax) = j > kmax ? [] : cons(j <= kcur && m >= j ? 1 : 0, q38s-hits-go(m, j + 1, kcur, kmax));
    def q38s-tries-go(j, kcur, kmax) = j > kmax ? [] : cons(j <= kcur ? 1 : 0, q38s-tries-go(j + 1, kcur, kmax));
    def q38s-add-go(a, b) = (Comparable) len(a) == 0 ? [] : cons(a[0] + b[0], q38s-add-go(a[1:], b[1:]));
    def q38s-zeros(n) = n <= 0 ? [] : cons(0, q38s-zeros(n - 1));
    def q38s-fill(n, v) = n <= 0 ? [] : cons(v, q38s-fill(n - 1, v));
    // How many drafts the next step makes. ema[j-1] is the running share (percent) of steps that accepted draft position j when it was
    // tried; a position costs the check about a fifth of a token (a column of the matvec, a row of attention, a snapshot) plus the chain's
    // 7 ms, so it pays when more than about a third of the steps take it. The policy tries one position past the last that paid, and
    // never fewer than one. adapt = 0 keeps k fixed.
    def q38s-ema-go(ema, m, j, kcur) = (Comparable) len(ema) == 0 ? [] : cons(j <= kcur ? (ema[0] * 7 + (m >= j ? 300 : 0)) / 10 : ema[0], q38s-ema-go(ema[1:], m, j + 1, kcur));
    def q38s-next-k(ema, j) = j <= 1 ? 1 : ema[j - 1] >= 35 ? j : q38s-next-k(ema, j - 1);
    // stats: [steps, host ms before the wait, ms of the wait, restore, catch-up+draft, chain, check (phased only), device busy ms, dispatches,
    // then per draft position j how many steps accepted it, then how many tried it]; trace: [accepted, step ms, device busy ms, host ms] a step
    def q38s-gen-go(ctx, qs, sts, sx, x, p, kcur, kmax, adapt, ema, cu-ids, cu-pos0, slot, want, acc, stats, trace, phased, vacc) = len(acc) >= want ? [take(want, acc), stats, trace, take(want, vacc)] : {
        let t0 = host_monotonic_ms();
        let out = q38s-step(ctx, qs, sts, sx, x, p, kcur, cu-ids, cu-pos0, slot, phased);
        let t1 = host_monotonic_ms();
        let d = out[0];
        let v = out[1];
        let ph = out[3];
        let m = q38s-accept-go(d, v, 1, kcur);
        let said = append(take(m, d[1:]), [v[m]]);
        let st2 = q38s-add-go(stats, cons(1, cons(out[2], cons((t1 - t0) - out[2], cons(ph[0], cons(ph[1], cons(ph[2], cons(ph[3], cons(out[4][0], cons(out[4][1], append(q38s-hits-go(m, 1, kcur, kmax), q38s-tries-go(1, kcur, kmax))))))))))));
        let ema2 = q38s-ema-go(ema, m, 1, kcur);
        let knext = (Comparable) adapt == 1 ? q38s-next-k(ema2, kcur + 1 > kmax ? kmax : kcur + 1) : kcur;
        q38s-gen-go(ctx, qs, sts, sx, v[m], p + m + 1, knext, kmax, adapt, ema2, said, p + 1, m < kcur ? m : -1, want, append(acc, said), st2, append(trace, [[m, t1 - t0, out[4][0], out[2]]]), phased, append(vacc, take(m + 1, out[5])));
    };
    // x0 pending at position N; the first catch-up is the whole prompt after position 0, then x0. k is the most drafts a step makes;
    // adapt = 1 starts at two and lets the acceptance decide, adapt = 0 makes k every step.
    // The snapshots hold the sx's own kmax slots (q38s-open): asking for more drafts than that is clamped to it, never written past.
    def q38s-generate-a(ctx, qs, sts, sx, ids, x0, k, want, phased, adapt) = q38s-generate-b(ctx, qs, sts, sx, ids, x0, k > sx[12] ? sx[12] : k, want, phased, adapt);
    def q38s-generate-b(ctx, qs, sts, sx, ids, x0, k, want, phased, adapt) = q38s-gen-go(ctx, qs, sts, sx, x0, len(ids), (Comparable) adapt == 1 ? (k < 2 ? k : 2) : k, k, adapt, q38s-fill(k, 100), append(ids[1:], [x0]), 1, -1, want, [], q38s-zeros(9 + 2 * k), [], phased, []);
    def q38s-generate(ctx, qs, sts, sx, ids, x0, k, want, phased) = q38s-generate-a(ctx, qs, sts, sx, ids, x0, k, want, phased, 0);
    0;
}
