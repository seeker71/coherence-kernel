; dsv4-decode-form.fk — the DS4 decode loop held by a FORM CELL, on the handle door.
;
; WHAT THIS IS AND WHAT IT IS NOT, said first so no one reads a rung as the stair.
; metal_dsv4_stack.sh produces a bit-exact 43-layer DS4 stream at ~28 t/s and stays the fidelity and
; performance oracle. Its kernels ARE emitted by Form cells — but its LOOP is a ~2200-line Swift
; heredoc compiled by swiftc inside a 2538-line bash file. This cell is the beginning of that loop
; coming home to Form: the geometry is read from the file's own header BY THIS CELL, the weights are
; mmap'd resident through metal_buf_from_file, the MSL is taken from the body's own emitters IN
; PROCESS (no file round-trip, no awk), and every dispatch is enqueued from Form.
;
; WHAT IS PROVEN HERE TODAY (2026-08-04): the door carries, the geometry is read from the header and
; not hardcoded, and one real token's embedding row comes off the real 9.1 GB file through a real GPU
; dispatch and matches this body's own f16->f32 widening bit for bit. That is one rung. The 43-layer
; argmax against the oracle is NOT proven here and this cell does not claim it — see the UNFINISHED
; block at the bottom, which names exactly what is missing and why.
;
; ── THREE THINGS THE DOOR DOES NOT CARRY, MEASURED THROUGH IT, NOT READ OFF A DOC ─────────────────
;
; 1. FP CONTRACTION. metal_pipeline compiles with newLibraryWithSource:options:nil. Probed with
;    a=b=1+2^-12 (0x3F800800), c=-1.0 — inputs chosen so the product genuinely ROUNDS, because the
;    first values tried made it exact and the two agreed for a reason that had nothing to do with
;    contraction (a green that proved nothing; the shape this body calls numb-green):
;        through the door   a*b+c = 973079552 == fma(a,b,c)     -> CONTRACTED
;        non-contracted                973078528
;    metal_dsv4_stack.sh compiles every metallib with -ffp-contract=off and ds4-order-match.fk states
;    the whole bit-exactness rests on that. So the door fuses where the oracle does not, and a stream
;    built on it would be plausible and wrong.
;    THE CELL FIXES THIS ITSELF, because the cell emits the MSL: dfd-msl-pragma prepends
;    "#pragma clang fp contract(off)", and with it the same probe answers 973078528 / 973079552,
;    correctly different. ("#pragma METAL fp math_mode(safe)" does NOT stop contraction — also probed.)
;
; 2. THREADGROUP SIZE — WAS NOT EXPRESSIBLE, NOW IS (closed by the door in 66111c9ea, same day).
;    The gap: metal_enqueue took tg = min(maxTotalThreadsPerThreadgroup, threads), while the oracle's
;    enc(pipeline, n, cap) takes an INDEPENDENT cap. Real oracle call sites where cap is not n:
;    enc(pQ80, rows*32, 256), enc(pMx8, rows*32, 256), enc(pQ8aQuant, blocks*q8aThreads, 64),
;    enc(pQ2kDeq, rows*cols, 256), enc(pAttAcc, nHead*headDim, tgSmall). Any kernel that stages into
;    threadgroup memory or takes a group-wide fold would have been partitioned differently here.
;    The door did NOT grow a fourth argument, and the reason is worth carrying: past arity 3 an op is
;    handed a CONS LIST in slot 1 (fkwu-uni.c:6920, fk_node rows are four wide), and making the
;    ~2600x/token primitive walk a cons chain is the wrong trade. The BINDING STRING grew instead:
;
;        u32 n_buf | u32 handle[n_buf] | u32 n_const | u32 value[n_const]
;                                      [ u32 threads_per_group | u32 threadgroup_bytes ]
;
;    Exactly two legal lengths, base and base+8; anything else is refused out loud. 0 = prior
;    behaviour. VERIFIED HERE FROM THE GPU rather than from the note: a kernel reporting its own
;    threads_per_threadgroup at grid 1024 answered 1024 free, 256 asked 256, 64 asked 64, and a
;    16-byte binding was refused with `binding is 16 bytes; ... 12 (no tail) or 20 (with ...)` and did
;    not dispatch. dfd-bind-tg below emits the tail; the base form stays legal, which is why this
;    cell's own bindings did not change.
;
; 3. CONSTANTS ARE u32 ONLY. The binding string carries 4-byte constants and the carrier setBytes them
;    at length 4. dsv4-token.fk's form_dsv4_embed_f16 declares `constant ulong& base` because the
;    ORACLE hands it one big windowed view whose second window begins ~85 GiB in, past 2^32. This door
;    does not have that problem — metal_buf_from_file maps THE TENSOR, and metal_enqueue binds at the
;    handle's own view offset, so the kernel sees the tensor starting at 0 and the row offset is
;    token*n_embd*2, which for this file's vocabulary is ~1.06e9 and fits a u32 with room. So this cell
;    emits a u32-base variant of that one kernel rather than asking the door to grow. The arithmetic is
;    untouched — float(as_type<half>(h)) either way — so the values are the oracle's values.
;
; preludes: native/metal/dsv4-stack-real.fk

(do
    ; ================= little-endian u32, the door's one wire format =================
    ; The binding string and every constant the door carries are u32 LE. Built here from bytes so the
    ; layout is the CELL's decision, exactly as the carrier's header says it should be.
    (defn dfd-u32 (n)
        (str_concat
            (str_concat (byte_to_str (mod n 256))
                        (byte_to_str (mod (div n 256) 256)))
            (str_concat (byte_to_str (mod (div n 65536) 256))
                        (byte_to_str (mod (div n 16777216) 256)))))

    (defn dfd-rd32 (s o)
        (add (str_byte_at s o)
             (add (mul 256 (str_byte_at s (add o 1)))
                  (add (mul 65536 (str_byte_at s (add o 2)))
                       (mul 16777216 (str_byte_at s (add o 3)))))))

    (defn dfd-rd16 (s o)
        (add (str_byte_at s o) (mul 256 (str_byte_at s (add o 1)))))

    ; the optional trailing pair (note 2). `base` is a complete binding; this appends the oracle's
    ; per-dispatch cap and the threadgroup byte count. Kept beside dfd-u32 rather than inlined at the
    ; call sites, because the next rung — form_mla_rmsnorm_reduce, which folds across a threadgroup —
    ; is the first kernel that cannot be dispatched without it, and every kernel after it needs the
    ; same tail. threads_per_group is a CAP, not a grid: the door takes
    ; min(maxTotalThreadsPerThreadgroup, cap) and does not clamp it to the dispatch width.
    (defn dfd-bind-tg (base tpg tgbytes)
        (str_concat base (str_concat (dfd-u32 tpg) (dfd-u32 tgbytes))))

    ; ================= the pragma the door's compile needs =================
    ; Not decoration. See note 1 in the header — without this the door contracts a*b+c into an fma and
    ; the stream diverges from the oracle while still looking like language.
    (defn dfd-msl-pragma () "#pragma clang fp contract(off)\n")

    ; ================= geometry, read from the file's own header =================
    ; Never hardcoded. Every one of these is a walk of the bytes the file actually carries, through the
    ; body's own gguf reader. A recipe that assumes 4096 is a recipe that is fluently wrong on the next
    ; file.
    (defn dfd-src (path) (eqr-of-file path 0 (gm-window)))
    (defn dfd-tabs (src path name) (add (egg-data-base src (gm-alignment))
                                        (egg-ti-dataoff src (egg-find-tensor src name))))
    (defn dfd-ttype (src name) (egg-ti-type src (egg-find-tensor src name)))
    (defn dfd-td0   (src name) (egg-ti-dim0 src (egg-find-tensor src name)))
    (defn dfd-td1   (src name) (gm-dimk src (egg-find-tensor src name) 1))
    (defn dfd-tbytes (src name) (gm-bytes src (egg-find-tensor src name)))

    ; ================= the embed kernel, u32-base variant (note 3) =================
    (defn dfd-embed-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat "#include <metal_stdlib>\nusing namespace metal;\n"
            (str_concat "kernel void form_dsv4_embed_f16_u32(device const uchar* src [[buffer(0)]], device float* dst [[buffer(1)]], constant uint& base [[buffer(2)]], constant uint& n [[buffer(3)]], uint gid [[thread_position_in_grid]]) { "
                        "if (gid < n) { ushort h = *(device const ushort*)(src + base + gid*2u); dst[gid] = float(as_type<half>(h)); } }"))))

    ; ================= this body's OWN f16 -> f32 widening, as BITS =================
    ; The cross-check for the GPU's answer, and it is deliberately not a float comparison: the widening
    ; from IEEE half to IEEE single is a pure bit rearrangement, so the honest gate is EQUALITY of the
    ; 32 bits, not an epsilon.
    ;
    ; THE SIX THAT WERE NOT COVERED, AND WHY THEY ARE NOW. The first cut widened only normals and
    ; ZERO, and COUNTED everything else as `odd` rather than folding it into `ok`. On the real
    ; token_embd row for token 671 that left ok=4090 bad=0 odd=6 — six lanes of a real weight row
    ; that the check was silent about. Six unverified lanes are not a rounding detail; they are the
    ; exact place a wrong answer could sit and still read green, so they are widened here rather than
    ; excused. A half DENORMAL is m * 2^-24 with no implicit leading one, so it renormalizes: with p
    ; the highest set bit of m, the f32 exponent field is p+103 and the mantissa is (m - 2^p) shifted
    ; left by 23-p. inf/nan carries e=255 and the payload, which is the standard widening.
    (defn dfd-hibit-go (m p) (if (lt m 2) p (dfd-hibit-go (div m 2) (add p 1))))
    (defn dfd-hibit (m) (dfd-hibit-go m 0))
    (defn dfd-pow2 (k) (if (eq k 0) 1 (mul 2 (dfd-pow2 (sub k 1)))))

    (defn dfd-h2f (b)
        (do (let s (div b 32768))
            (let e (mod (div b 1024) 32))
            (let m (mod b 1024))
            (if (eq e 31)
                (add (mul s 2147483648) (add 2139095040 (mul m 8192)))
                (if (eq e 0)
                    (if (eq m 0)
                        (mul s 2147483648)
                        (do (let p (dfd-hibit m))
                            (add (mul s 2147483648)
                                 (add (mul (add p 103) 8388608)
                                      (mul (sub m (dfd-pow2 p)) (dfd-pow2 (sub 23 p)))))))
                    (add (mul s 2147483648) (add (mul (add e 112) 8388608) (mul m 8192)))))))

    ; every half is widened now, so `odd` counts only what this cell still refuses — which is nothing.
    ; It is KEPT rather than deleted: a nonzero odd in a later run is the honest way for a case this
    ; body has not met to announce itself instead of being averaged into a pass.
    (defn dfd-h-odd? (b) 0)

    ; walk the row: count bit-exact agreements, disagreements, and un-widened (odd) halfs
    (defn dfd-cmp-go (raw got i n ok bad odd)
        (if (ge i n) (cons ok (cons bad (cons odd 0)))
            (do (let h (dfd-rd16 raw (mul i 2)))
                (if (eq (dfd-h-odd? h) 1)
                    (dfd-cmp-go raw got (add i 1) n ok bad (add odd 1))
                    (if (eq (dfd-h2f h) (dfd-rd32 got (mul i 4)))
                        (dfd-cmp-go raw got (add i 1) n (add ok 1) bad odd)
                        (dfd-cmp-go raw got (add i 1) n ok (add bad 1) odd))))))

    ; ================= RUNG 1: one real token's embedding, file -> GPU -> back =================
    ; Geometry from the header, weights mmap'd resident, MSL from this cell, dispatch from Form.
    (defn dfd-embed (path token)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let vocab (dfd-td1 src "token_embd.weight"))
            (let ety (dfd-ttype src "token_embd.weight"))
            (let abs (dfd-tabs src path "token_embd.weight"))
            (let nby (dfd-tbytes src "token_embd.weight"))
            (print (str_concat "GEOM n_embd=" (int_to_str nembd)))
            (print (str_concat "GEOM vocab=" (int_to_str vocab)))
            (print (str_concat "GEOM embd_type=" (int_to_str ety)))
            (print (str_concat "GEOM embd_abs=" (int_to_str abs)))
            (print (str_concat "GEOM embd_bytes=" (int_to_str nby)))
            (let wh (metal_buf_from_file path abs nby))
            (print (str_concat "BUF weights=" (int_to_str wh)))
            (let oh (metal_buf_alloc (mul nembd 4)))
            (let pipe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (print (str_concat "PIPE embed=" (int_to_str pipe)))
            (let rowoff (mul (mul token nembd) 2))
            (let bind (str_concat
                          (str_concat (dfd-u32 2) (str_concat (dfd-u32 wh) (dfd-u32 oh)))
                          (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))))
            (let e (metal_enqueue pipe bind nembd))
            (print (str_concat "ENQ=" (int_to_str e)))
            (let got (metal_buf_read oh 0 (mul nembd 4)))
            (print (str_concat "READ bytes=" (int_to_str (str_len got))))
            ; the same row's raw bytes, read straight off the file by this cell
            (let raw (eqr-of-file path (add abs rowoff) (mul nembd 2)))
            (let r (dfd-cmp-go raw got 0 nembd 0 0 0))
            (print (str_concat "BITEXACT ok=" (int_to_str (head r))))
            (print (str_concat "BITEXACT bad=" (int_to_str (head (tail r)))))
            (print (str_concat "BITEXACT odd=" (int_to_str (head (tail (tail r))))))
            (print (metal_status))
            ; the facts, in the order a band folds them. Returned rather than only printed, so the
            ; band reads what the run actually produced instead of re-deriving it.
            (cons (head r) (cons (head (tail r)) (cons (head (tail (tail r)))
                (cons nembd (cons vocab (cons ety (cons abs (cons nby
                (cons (metal_status) (cons (add abs rowoff) 0))))))))))))

    ; ================= the contraction probe, as a callable the band can fold =================
    ; Answers 1 when the pragma this cell emits actually suppresses contraction THROUGH THIS DOOR.
    ; a=b=1+2^-12, c=-1.0, chosen so the product rounds: mul-then-add 973078528, fma 973079552.
    ; A cell that emits the pragma and never checks it has a comment, not a guarantee.
    (defn dfd-contract-ok? ()
        (do (let msl (str_concat (dfd-msl-pragma)
                (str_concat "#include <metal_stdlib>\nusing namespace metal;\n"
                    "kernel void fpk(device const float* v [[buffer(0)]], device float* y [[buffer(1)]], uint g [[thread_position_in_grid]]) { float a=v[0]; float b=v[1]; float c=v[2]; y[0]=a*b+c; y[1]=fma(a,b,c); }")))
            (let pipe (metal_pipeline msl "fpk"))
            (let vi (metal_buf_alloc 16))
            (let vo (metal_buf_alloc 16))
            (let w (metal_buf_write vi 0
                (str_concat (str_concat (dfd-u32 1065355264) (dfd-u32 1065355264))
                            (str_concat (dfd-u32 3212836864) (dfd-u32 0)))))
            (let bind (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 vi) (dfd-u32 vo)))
                                  (dfd-u32 0)))
            (let e (metal_enqueue pipe bind 1))
            (let o (metal_buf_read vo 0 16))
            (if (eq (dfd-rd32 o 0) 973078528)
                (if (eq (dfd-rd32 o 4) 973079552) 1 0)
                0)))

    ; ═══════════════ RUNG 2: RMSNORM over the embedded row (reduce / apply) ═══════════════
    ; The first kernel with real arithmetic, and therefore the first place the contract pragma is
    ; load-bearing rather than precautionary: `sumsq + x[j]*x[j]` is a multiply feeding an add, which is
    ; exactly what an unpinned compiler fuses.
    ;
    ; WHY reduce/apply AND NOT rmsnorm_wide. The oracle runs form_mla_rmsnorm_wide_f32 in production and
    ; keeps reduce/apply "in the library as the read-back reference" (metal_dsv4_stack.sh:1075). The
    ; reference pair is the right first rung: its fold is 32 lanes of contiguous spans plus one
    ; simd_sum, which is a shape this cell can state exactly, where wide's fold is threadgroup-strided
    ; and depends on a group size the door only gained today.
    ;
    ; THE DISPATCH SHAPE MATTERS AND IS NOT FREE. reduce is `if (lane >= 32u) return;` over
    ; thread_position_in_grid and folds with metal::simd_sum, so it needs EXACTLY ONE SIMDGROUP: 32
    ; threads capped to a 32-wide group. Dispatched free, the door would take
    ; min(maxTotalThreadsPerThreadgroup, 32) — which is also 32 here, so this one happens to survive a
    ; free dispatch. It is pinned anyway, because "correct by coincidence at this width" is not a
    ; property the next width inherits.

    (defn dfd-f32at (s o) (fd-value (dfd-rd32 s o) 8 23))
    (defn dfd-f16at (s o) (fd-f16 (dfd-rd16 s o)))

    ; the reference fold, in Form's own fp64, over the SAME f16 bytes whose widening bit-64 already
    ; pinned. This is the independent anchor for the REDUCE step.
    (defn dfd-sumsq (raw i n acc)
        (if (ge i n) acc
            (do (let v (dfd-f16at raw (mul i 2)))
                (dfd-sumsq raw (add i 1) n (add acc (mul v v))))))

    ; the reference apply, and the bar is against the VECTOR'S SCALE rather than each element's own
    ; magnitude — the body's own precedent (overfine, corpus row 934): two folds that very nearly
    ; cancel at one element make its relative error meaningless while the vector is fine.
    (defn dfd-maxdiff (raw wraw got inv i n acc)
        (if (ge i n) acc
            (do (let r (mul (mul (dfd-f16at raw (mul i 2)) inv) (dfd-f32at wraw (mul i 4))))
                (let d (abs (sub (dfd-f32at got (mul i 4)) r)))
                (dfd-maxdiff raw wraw got inv (add i 1) n (if (gt d acc) d acc)))))
    (defn dfd-maxref (raw wraw inv i n acc)
        (if (ge i n) acc
            (do (let r (abs (mul (mul (dfd-f16at raw (mul i 2)) inv) (dfd-f32at wraw (mul i 4)))))
                (dfd-maxref raw wraw inv (add i 1) n (if (gt r acc) r acc)))))

    ; eps as the file itself carries it. 897988541 = 0x358637BD = f32(1e-6), derived by hand
    ; (107<<23 | 407485) and confirmed to decode to 9.999999974752427e-07 — the exact value the Go
    ; arm's manifest walk printed for deepseek4.attention.layer_norm_rms_epsilon. Three roads.
    (defn dfd-eps-bits () 897988541)

    ; ── SYNTHETIC TRUTH for the pair, and it is the strongest bit in this rung ──
    ; The real-row anchors below are fp64-vs-fp32 MAGNITUDE checks with a stated tolerance; this one is
    ; EXACT and hand-computed, which is the difference between "nothing structural is broken" and "this
    ; is the right number". x=2.0, g=1.0, eps=0:
    ;     sumsq = 4n, ms = 4, rms = 2, inv = 0.5, out = 1.0 — every step exact in f32, no rounding.
    ; 2.0 = 0x40000000, 1.0 = 0x3F800000, 0.5 = 0x3F000000, written down without a tool.
    ; A wrong n, a lane span that misses or double-counts, a dropped g, or an inv that is not the
    ; reciprocal all move the answer off 0x3F800000.
    (defn dfd-fill (h i n v)
        (if (ge i n) 0 (do (metal_buf_write h (mul i 4) (dfd-u32 v)) (dfd-fill h (add i 1) n v))))
    (defn dfd-count-eq (s i n want acc)
        (if (ge i n) acc
            (dfd-count-eq s (add i 1) n want (if (eq (dfd-rd32 s (mul i 4)) want) (add acc 1) acc))))

    (defn dfd-rmsnorm-synth (n)
        (do (let msl (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pr (metal_pipeline msl "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline msl "form_mla_rmsnorm_apply_f32"))
            (let xb (metal_buf_alloc (mul n 4)))
            (let gb (metal_buf_alloc (mul n 4)))
            (let ob (metal_buf_alloc (mul n 4)))
            (let ib (metal_buf_alloc 4))
            (let f1 (dfd-fill xb 0 n 1073741824))
            (let f2 (dfd-fill gb 0 n 1065353216))
            (let e1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 n) (dfd-u32 0)))) 32 0) 32))
            (let iv (metal_buf_read ib 0 4))
            (let e2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gb))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 n))) n))
            (let out (metal_buf_read ob 0 (mul n 4)))
            (print (str_concat "SYNTH inv_bits=" (str_concat (int_to_str (dfd-rd32 iv 0)) " (want 1056964608)")))
            (print (str_concat "SYNTH lanes_eq_one=" (str_concat (int_to_str (dfd-count-eq out 0 n 1065353216 0))
                   (str_concat " of " (int_to_str n)))))
            (if (eq (dfd-rd32 iv 0) 1056964608)
                (if (eq (dfd-count-eq out 0 n 1065353216 0) n) 1 0) 0)))

    (defn dfd-rmsnorm-rung (path token)
        (do
            (let src (dfd-src path))
            (let n (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.0.attn_norm.weight"))
            (let gty (dfd-ttype src "blk.0.attn_norm.weight"))
            (let gn (dfd-td0 src "blk.0.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.0.attn_norm.weight"))
            (print (str_concat "GEOM attn_norm_abs=" (int_to_str gabs)))
            (print (str_concat "GEOM attn_norm_type=" (int_to_str gty)))
            (print (str_concat "GEOM attn_norm_n=" (int_to_str gn)))

            (let msl (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline msl "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline msl "form_mla_rmsnorm_apply_f32"))

            (let wh (metal_buf_from_file path eabs ebytes))
            (let gh (metal_buf_from_file path gabs gbytes))
            (let xb (metal_buf_alloc (mul n 4)))
            (let ob (metal_buf_alloc (mul n 4)))
            (let ib (metal_buf_alloc 4))
            (let rowoff (mul (mul token n) 2))

            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 wh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 n)))) n))
            ; reduce — 32 threads, group pinned to 32 so simd_sum folds one simdgroup
            (let e1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 n) (dfd-u32 (dfd-eps-bits)))))
                32 0) 32))
            (let e2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gh))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 n))) n))
            (print (str_concat "ENQ embed/reduce/apply=" (str_concat (int_to_str e0)
                   (str_concat "/" (str_concat (int_to_str e1) (str_concat "/" (int_to_str e2)))))))

            (let ivb (metal_buf_read ib 0 4))
            (let got (metal_buf_read ob 0 (mul n 4)))
            (let inv (dfd-f32at ivb 0))
            (print (str_concat "GPU inv=" (float_to_str inv)))

            ; --- anchor 1: the REDUCE, via implied mean-square. No sqrt is needed on this side, which
            ; is the point: 1/(inv*inv) - eps must be the mean square the fp64 fold computed.
            (let raw (eqr-of-file path (add eabs rowoff) (mul n 2)))
            (let refms (div (dfd-sumsq raw 0 n 0.0) n))
            (let impms (sub (div 1.0 (mul inv inv)) (fd-value (dfd-eps-bits) 8 23)))
            (let rel1 (div (abs (sub impms refms)) refms))
            (print (str_concat "ref_ms (x1e6)=" (float_to_str (mul refms 1000000.0))))
            (print (str_concat "implied_ms (x1e6)=" (float_to_str (mul impms 1000000.0))))
            (print (str_concat "REL reduce (parts per billion)=" (float_to_str (mul rel1 1000000000.0))))

            ; --- anchor 2: the APPLY, against the vector's scale
            (let wraw (eqr-of-file path gabs (mul n 4)))
            (let md (dfd-maxdiff raw wraw got inv 0 n 0.0))
            (let mr (dfd-maxref raw wraw inv 0 n 0.0))
            (let rel2 (div md mr))
            (print (str_concat "max|gpu-ref| (x1e9)=" (float_to_str (mul md 1000000000.0))))
            (print (str_concat "max|ref|=" (float_to_str mr)))
            (print (str_concat "REL apply (parts per billion)=" (float_to_str (mul rel2 1000000000.0))))
            (print (metal_status))
            ; rowaddr and gabs are RETURNED so the band can pin them. Without that these two
            ; relative errors are COMOVED: the fp64 reference reads `raw` at the same computed row and
            ; `wraw` at the same computed weight address the GPU was handed, so a wrong row or a wrong
            ; norm tensor moves BOTH sides and the agreement is automatic. Measured, not reasoned —
            ; mutation N5 (wrong row) answered 2047 and N1 (output_norm for attn_norm) answered 1791
            ; where 767 was predicted. Same defect as M2, twice more, in one rung.
            (cons rel1 (cons rel2 (cons gabs (cons (metal_status)
                (cons n (cons (add eabs rowoff) 0))))))))

    ; ═══════════════ RUNG 3: the MLA q/kv projections (MXFP8, type 41) ═══════════════
    ; blk.0.attn_q_a.weight is [4096 x 1024] and blk.0.attn_kv.weight is [4096 x 512], both GGUF type
    ; 41. The Go arm's byte counts confirm the plane-split layout arithmetically before any kernel
    ; runs: nel = 4096*1024 = 4194304, and 4194304 + 4194304/32 = 4325376, which is exactly the
    ; tensor's size. Payload plane first, one E8M0 scale byte per 32 weights after it at offset nel.
    ;
    ; THE SYNTHETIC, AND WHAT IT DOES NOT COVER — said because a synthetic that is not bounded is a
    ; claim. mxm_e8m0(e) = 2^(e-127) so scale byte 127 is 1.0; mx8_val is E4M3 (sign<<7 | exp<<3 |
    ; mant, bias 7) so payload byte 56 = 0x38 is 1.0. With x = 1.0 everywhere, every term is 1.0 and
    ; y[r] = cols = 4096.0 = 0x45800000. Every partial sum is an integer below 2^24, so that answer is
    ; exact NO MATTER HOW THE FOLD ASSOCIATES. That is the strength and the limit in one sentence: it
    ; proves the decode, the scale-plane origin, and that all `cols` columns were visited exactly once
    ; — and it is BLIND to association, which is the very thing ds4-order-match.fk exists for. The
    ; association is what the real-weight check below is for, and neither bit is the other's evidence.
    ; the MXFP8 unit as TEXT. dsv4-token.fk's dsv4-mx8-matvec-msl PRINTS it (the bash lane greps the
    ; stream between MSL and END); this cell needs the same bytes as a value, so it composes the same
    ; two pieces the printer composes and hands them straight to metal_pipeline. Same text, no file.
    (defn dfd-mx8-msl ()
        (str_concat (qml-msl-header)
                    (mx8m-msl-unit "form_dsv4_mx8_dequant" "form_dsv4_mx8_matvec")))

    (defn dfd-fillb (h i n v)
        (if (ge i n) 0 (do (metal_buf_write h i (byte_to_str v)) (dfd-fillb h (add i 1) n v))))

    (defn dfd-mx8-synth (rows cols)
        (do (let msl (str_concat (dfd-msl-pragma) (dfd-mx8-msl)))
            (let p (metal_pipeline msl "form_dsv4_mx8_matvec"))
            (let nel (mul rows cols))
            (let wb (metal_buf_alloc (add nel (div nel 32))))
            (let xb (metal_buf_alloc (mul cols 4)))
            (let yb (metal_buf_alloc (mul rows 4)))
            (let f1 (dfd-fillb wb 0 nel 56))                       ; payload: E4M3 1.0
            (let f2 (dfd-fillb wb nel (add nel (div nel 32)) 127))  ; scale plane: E8M0 1.0
            (let f3 (dfd-fill xb 0 cols 1065353216))                ; x = 1.0f
            (let e (metal_enqueue p (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 wb) (dfd-u32 xb)) (dfd-u32 yb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 rows) (dfd-u32 cols)) (dfd-u32 nel))))
                256 0) (mul rows 32)))
            (let y (metal_buf_read yb 0 (mul rows 4)))
            (print (str_concat "MX8SYNTH y[0] bits=" (str_concat (int_to_str (dfd-rd32 y 0))
                   (str_concat "  want " (int_to_str 1166016512)))))
            (print (str_concat "MX8SYNTH rows_eq=" (str_concat (int_to_str (dfd-count-eq y 0 rows 1166016512 0))
                   (str_concat " of " (int_to_str rows)))))
            (if (eq (dfd-count-eq y 0 rows 1166016512 0) rows) 1 0)))

    ; ── TYPE-DISPATCHED MATVEC. The file decides: each tensor's own GGUF type picks the kernel and
    ; the reference reader, exactly as the oracle's dispatch "reads each tensor's own type". The
    ; canonical imatrix file (AProjQ8) carries the attention projections as Q8_0 (type 8); the reap25
    ; specimen carried them MXFP8 (type 41). Both paths live here; an unpriced type is a spoken
    ; refusal (0 pipeline), never a guess.
    (defn dfd-q80-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat "#include <metal_stdlib>\nusing namespace metal;\n" (dom-q80-mv-ds4-body))))
    (defn dfd-wat (ty wraw nel idx)
        (if (eq ty 8) (q80-flat-at wraw 0 idx) (mxp8-at wraw 0 nel idx)))
    (defn dfd-mv-pipe (ty)
        (if (eq ty 8) (metal_pipeline (dfd-q80-msl) "form_dsv4_q80_matvec_ds4")
        (if (eq ty 41) (metal_pipeline (str_concat (dfd-msl-pragma) (dfd-mx8-msl)) "form_dsv4_mx8_matvec")
            0)))
    ; the ds4-order Q8_0 kernel is threadgroup-shaped: one 256-wide group per TWO rows, float x in.
    (defn dfd-mv-enq (p ty w x y rows cols)
        (if (eq ty 8)
            (metal_enqueue p (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 w) (dfd-u32 x)) (dfd-u32 y)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rows) (dfd-u32 cols))))
                256 0) (mul (div (add rows 1) 2) 256))
            (metal_enqueue p (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 w) (dfd-u32 x)) (dfd-u32 y)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 rows) (dfd-u32 cols)) (dfd-u32 (mul rows cols)))))
                256 0) (mul rows 32))))

    ; the real projection, against the body's OWN reader for the tensor's type folded in fp64. That reader is
    ; a different text from the MSL kernel — a Form recipe, not the emitted C — so this is two roads to
    ; one number rather than one road walked twice. EIGHT ROWS, not 1024: each row is a 4096-term fp64
    ; fold in Form, and 1024 of them is 4.2M interpreted operations. Eight is enough to catch a decode
    ; fault, a wrong row stride, or a scale-plane origin off by anything, all of which are uniform
    ; across rows; it would NOT catch a fault that only touches high row indices, and that is stated
    ; rather than hidden behind the word "verified".
    (defn dfd-mx8dot (ty wraw nel cols xraw r j acc)
        (if (ge j cols) acc
            (dfd-mx8dot ty wraw nel cols xraw r (add j 1)
                (add acc (mul (dfd-wat ty wraw nel (add (mul r cols) j))
                              (dfd-f32at xraw (mul j 4)))))))
    ; THE BAR IS AGAINST THE VECTOR'S SCALE, NOT EACH ELEMENT'S OWN MAGNITUDE — the body's own
    ; precedent (overfine, corpus row 934), and this rung is exactly the case it was written for. A
    ; 4096-term signed dot in fp32 against the same dot in fp64 lands at ~1e-6 PER ELEMENT here
    ; (measured 1018 ppb) purely because y[0] = 0.017 is a near-cancellation of terms of scale ~0.1 —
    ; the element's own magnitude is not the quantity the error should be judged against. Against the
    ; row-vector's scale the same disagreement is what it actually is: f32 rounding.
    (defn dfd-mx8-maxdiff (ty wraw nel cols xraw got r nr acc)
        (if (ge r nr) acc
            (do (let d (abs (sub (dfd-f32at got (mul r 4)) (dfd-mx8dot ty wraw nel cols xraw r 0 0.0))))
                (dfd-mx8-maxdiff ty wraw nel cols xraw got (add r 1) nr (if (gt d acc) d acc)))))
    (defn dfd-mx8-maxref (ty wraw nel cols xraw r nr acc)
        (if (ge r nr) acc
            (do (let a (abs (dfd-mx8dot ty wraw nel cols xraw r 0 0.0)))
                (dfd-mx8-maxref ty wraw nel cols xraw (add r 1) nr (if (gt a acc) a acc)))))
    (defn dfd-mx8-cmp (ty wraw nel cols xraw got r nr acc)
        (div (dfd-mx8-maxdiff ty wraw nel cols xraw got 0 nr 0.0)
             (dfd-mx8-maxref ty wraw nel cols xraw 0 nr 0.0)))

    ; the real q_a projection: embed -> rmsnorm -> MXFP8 matvec, all enqueued from Form, then eight
    ; rows folded independently in fp64. Returns (maxrel qabs rows cols) so the band can PIN the
    ; address rather than trust a relative error computed at whatever address the code chose — the
    ; comoved lesson, applied before the mutation rather than after it this time.
    (defn dfd-mla-rung (path token)
        (do
            (let src (dfd-src path))
            (let n (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.0.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.0.attn_norm.weight"))
            (let qabs (dfd-tabs src path "blk.0.attn_q_a.weight"))
            (let qbytes (dfd-tbytes src "blk.0.attn_q_a.weight"))
            (let qty (dfd-ttype src "blk.0.attn_q_a.weight"))
            (let cols (dfd-td0 src "blk.0.attn_q_a.weight"))
            (let rows (dfd-td1 src "blk.0.attn_q_a.weight"))
            (let nel (mul rows cols))
            (print (str_concat "GEOM q_a abs=" (str_concat (int_to_str qabs)
                   (str_concat " type=" (str_concat (int_to_str qty)
                   (str_concat " rows=" (str_concat (int_to_str rows)
                   (str_concat " cols=" (int_to_str cols)))))))))
            (print (str_concat "GEOM q_a bytes=" (str_concat (int_to_str qbytes)
                   (str_concat "  nel+nel/32=" (int_to_str (add nel (div nel 32)))))))

            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let pm (dfd-mv-pipe qty))

            (let wh (metal_buf_from_file path eabs ebytes))
            (let gh (metal_buf_from_file path gabs gbytes))
            (let qh (metal_buf_from_file path qabs qbytes))
            (let xb (metal_buf_alloc (mul n 4)))
            (let ob (metal_buf_alloc (mul n 4)))
            (let ib (metal_buf_alloc 4))
            (let yb (metal_buf_alloc (mul rows 4)))
            (let rowoff (mul (mul token n) 2))

            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 wh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 n)))) n))
            (let e1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 n) (dfd-u32 (dfd-eps-bits)))))
                32 0) 32))
            (let e2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gh))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 n))) n))
            (let e3 (dfd-mv-enq pm qty qh ob yb rows cols))
            (print (str_concat "ENQ e/r/a/m=" (str_concat (int_to_str e0) (str_concat (int_to_str e1)
                   (str_concat (int_to_str e2) (int_to_str e3))))))

            (let got (metal_buf_read yb 0 (mul rows 4)))
            (let normed (metal_buf_read ob 0 (mul n 4)))
            (let wraw (eqr-of-file path qabs qbytes))
            (let mx (dfd-mx8-cmp qty wraw nel cols normed got 0 8 0.0))
            (print (str_concat "MX8 real maxrel over 8 rows (ppb)=" (float_to_str (mul mx 1000000000.0))))
            (print (str_concat "y[0]=" (float_to_str (dfd-f32at got 0))))
            (print (str_concat "y[1]=" (float_to_str (dfd-f32at got 4))))
            (print (metal_status))
            (cons mx (cons qabs (cons rows (cons cols (cons (add eabs rowoff) 0)))))))

    ; ═══════════════ RUNG 4: q_b / kv_a_norm / headrms — and the ORDER-SENSITIVE synthetic ═══════════
    ;
    ; ── the order-sensitive synthetic, built once for every rung after this ──
    ; The uniform synthetic (bit 2048) is exact under ANY association, so it cannot see fold order —
    ; and from the attention split onward, order is the whole question (ds4-order-match.fk exists
    ; because of it). This probe discriminates: weights all 1.0 (E4M3 56 / E8M0 127), x[0] = 2^24,
    ; x[1..31] = 1.0, rest 0. In fp64 the truth is 2^24 + 31. In f32, the kernel's stated fold —
    ; ascending within the 32-group — computes 2^24 + 1 thirty-one times, and each lands on a
    ; tie-to-even that rounds BACK to 2^24 (spacing is 2 there; mantissa 0 is the even neighbor). A
    ; reversed or pairwise fold sums the ones first and lands on 2^24 + 32. Verified by f32-step
    ; simulation before this was written: ascending = 1266679808, reversed = 1266679824. So EXACT
    ; equality with 0x4B800000 is a fold-ORDER witness, not just a decode witness, and 16 bits
    ; separate the two answers.
    (defn dfd-mx8-ordersynth ()
        (do (let rows 8)
            (let cols 4096)
            (let nel (mul rows cols))
            (let p (metal_pipeline (str_concat (dfd-msl-pragma) (dfd-mx8-msl)) "form_dsv4_mx8_matvec"))
            (let wb (metal_buf_alloc (add nel (div nel 32))))
            (let xb (metal_buf_alloc (mul cols 4)))
            (let yb (metal_buf_alloc (mul rows 4)))
            (let f1 (dfd-fillb wb 0 nel 56))
            (let f2 (dfd-fillb wb nel (add nel (div nel 32)) 127))
            (let f3 (metal_buf_write xb 0 (dfd-u32 1266679808)))       ; x[0] = 2^24
            (let f4 (dfd-fill xb 1 32 1065353216))                     ; x[1..31] = 1.0, rest stay 0
            (let e (metal_enqueue p (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 wb) (dfd-u32 xb)) (dfd-u32 yb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 rows) (dfd-u32 cols)) (dfd-u32 nel))))
                256 0) (mul rows 32)))
            (let y (metal_buf_read yb 0 (mul rows 4)))
            (print (str_concat "ORDER y[0] bits=" (str_concat (int_to_str (dfd-rd32 y 0))
                   "  (ascending=1266679808, reversed=1266679824, fp64 truth=2^24+31)")))
            (if (eq (dfd-count-eq y 0 rows 1266679808 0) rows) 1 0)))

    ; ── fp64 references for the new steps. Each step's reference reads the GPU's INPUT buffer for
    ; that step and the weights at the pinned address, so the chain is covered by induction: step k's
    ; input is step k-1's separately-checked output — the same buffer, not a re-derivation. What a
    ; step check must NOT do is read its expectation through the step's own arithmetic; none does.
    (defn dfd-rms-ref (xraw graw got n)
        (do (let ss (dfd-sumsq-f32 xraw 0 n 0.0))
            (let inv (div 1.0 (tn-sqrt (add (div ss n) (fd-value (dfd-eps-bits) 8 23)))))
            (let md (dfd-rmsref-maxdiff xraw graw got inv 0 n 0.0))
            (let mr (dfd-rmsref-maxref xraw graw inv 0 n 0.0))
            (div md mr)))
    (defn dfd-sumsq-f32 (s i n acc)
        (if (ge i n) acc
            (do (let v (dfd-f32at s (mul i 4)))
                (dfd-sumsq-f32 s (add i 1) n (add acc (mul v v))))))
    (defn dfd-rmsref-maxdiff (xraw graw got inv i n acc)
        (if (ge i n) acc
            (do (let r (mul (mul (dfd-f32at xraw (mul i 4)) inv) (dfd-f32at graw (mul i 4))))
                (let d (abs (sub (dfd-f32at got (mul i 4)) r)))
                (dfd-rmsref-maxdiff xraw graw got inv (add i 1) n (if (gt d acc) d acc)))))
    (defn dfd-rmsref-maxref (xraw graw inv i n acc)
        (if (ge i n) acc
            (do (let r (abs (mul (mul (dfd-f32at xraw (mul i 4)) inv) (dfd-f32at graw (mul i 4)))))
                (dfd-rmsref-maxref xraw graw inv (add i 1) n (if (gt r acc) r acc)))))

    ; headrms reference over ALL 64 heads: unweighted, per-head fold of hd terms.
    (defn dfd-headrms-head (qraw got h hd acc)
        (do (let base (mul h hd))
            (let ss (dfd-sumsq-f32-off qraw base 0 hd 0.0))
            (let inv (div 1.0 (tn-sqrt (add (div ss hd) (fd-value (dfd-eps-bits) 8 23)))))
            (let md (dfd-hr-maxdiff qraw got base inv 0 hd 0.0))
            (let mr (dfd-hr-maxref qraw base inv 0 hd 0.0))
            (let rel (div md mr))
            (if (gt rel acc) rel acc)))
    (defn dfd-sumsq-f32-off (s base i n acc)
        (if (ge i n) acc
            (do (let v (dfd-f32at s (mul (add base i) 4)))
                (dfd-sumsq-f32-off s base (add i 1) n (add acc (mul v v))))))
    (defn dfd-hr-maxdiff (qraw got base inv i n acc)
        (if (ge i n) acc
            (do (let r (mul (dfd-f32at qraw (mul (add base i) 4)) inv))
                (let d (abs (sub (dfd-f32at got (mul (add base i) 4)) r)))
                (dfd-hr-maxdiff qraw got base inv (add i 1) n (if (gt d acc) d acc)))))
    (defn dfd-hr-maxref (qraw base inv i n acc)
        (if (ge i n) acc
            (do (let r (abs (mul (dfd-f32at qraw (mul (add base i) 4)) inv)))
                (dfd-hr-maxref qraw base inv (add i 1) n (if (gt r acc) r acc)))))
    (defn dfd-headrms-all (qraw got h nh hd acc)
        (if (ge h nh) acc
            (dfd-headrms-all qraw got (add h 1) nh hd (dfd-headrms-head qraw got h hd acc))))

    ; ═══════════════ RUNG 5: RoPE + the sink-softmax attention, continuing the same chain ═══════════
    ; The freqs are COMPUTED ON THE DEVICE by a kernel this cell emits — freqs[k] = pow(base, -2k/64)
    ; with base = 10000.0 read from the file's own KV (deepseek4.rope.freq_base; layer 0 is a ratio-0
    ; raw-regime layer, so fscale = 1 and no YaRN ramp — the compressed reduction belongs to layer 2+
    ; and is NOT claimed here). freqs[0] = pow(base, 0) must be EXACTLY 1.0f: that is an identity of
    ; the function, not a tolerance. The fp64 rope reference reads the freqs BACK from the device and
    ; widens them, so a wrong pow shows up as a wrong freqs[0] or as a rope mismatch, never as a
    ; comoved agreement. pos = 7.0 (f32 bits 1088421888, exact), sign +1. The NOPE dims (0..447 of
    ; each head) are a pure COPY in the kernel, so their check is BIT EQUALITY, not a tolerance.
    (defn dfd-freqs-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat "#include <metal_stdlib>\nusing namespace metal;\n"
            "kernel void dfd_freqs(device float* f [[buffer(0)]], constant uint& npair [[buffer(1)]], constant uint& nrot [[buffer(2)]], constant float& base [[buffer(3)]], uint k [[thread_position_in_grid]]) { if (k < npair) f[k] = metal::pow(base, -2.0f * float(k) / float(nrot)); }")))

    (defn dfd-rope-pair-ref (x0 x1 a which)
        (if (eq which 0)
            (sub (mul x0 (fcos a)) (mul x1 (fsin a)))
            (add (mul x0 (fsin a)) (mul x1 (fcos a)))))
    ; pos is a PARAMETER, not a literal: the forward rope passes +7.0 and rung 6's INVERSE rope
    ; passes -7.0, because the kernel's sign = -1 multiplies only sin(a) — which is exactly the
    ; negated angle (cos even, sin odd). One reference text serves both directions.
    (defn dfd-rope-tail-md (inraw outraw freqraw hbase pos k acc)
        (if (ge k 32) acc
            (do (let lo (add hbase (add 448 (mul k 2))))
                (let a (mul pos (fd-value (dfd-rd32 freqraw (mul k 4)) 8 23)))
                (let x0 (dfd-f32at inraw (mul lo 4)))
                (let x1 (dfd-f32at inraw (mul (add lo 1) 4)))
                (let d0 (abs (sub (dfd-f32at outraw (mul lo 4)) (dfd-rope-pair-ref x0 x1 a 0))))
                (let d1 (abs (sub (dfd-f32at outraw (mul (add lo 1) 4)) (dfd-rope-pair-ref x0 x1 a 1))))
                (let d (if (gt d0 d1) d0 d1))
                (dfd-rope-tail-md inraw outraw freqraw hbase pos (add k 1) (if (gt d acc) d acc)))))
    (defn dfd-rope-tail-mr (inraw freqraw hbase pos k acc)
        (if (ge k 32) acc
            (do (let lo (add hbase (add 448 (mul k 2))))
                (let a (mul pos (fd-value (dfd-rd32 freqraw (mul k 4)) 8 23)))
                (let x0 (dfd-f32at inraw (mul lo 4)))
                (let x1 (dfd-f32at inraw (mul (add lo 1) 4)))
                (let r0 (abs (dfd-rope-pair-ref x0 x1 a 0)))
                (let r1 (abs (dfd-rope-pair-ref x0 x1 a 1)))
                (let r (if (gt r0 r1) r0 r1))
                (dfd-rope-tail-mr inraw freqraw hbase pos (add k 1) (if (gt r acc) r acc)))))
    (defn dfd-nope-eq (inraw outraw hbase j acc)
        (if (ge j 448) acc
            (dfd-nope-eq inraw outraw hbase (add j 1)
                (if (eq (dfd-rd32 inraw (mul (add hbase j) 4)) (dfd-rd32 outraw (mul (add hbase j) 4)))
                    (add acc 1) acc))))

    ; the attend reference: per head, one KV row, the sink in the max and in the denominator —
    ; mla-attn.fk's own softmax shape, folded in fp64 with tn-exp and tn-sqrt.
    (defn dfd-att-dot (qraw kraw hbase j acc)
        (if (ge j 512) acc
            (dfd-att-dot qraw kraw hbase (add j 1)
                (add acc (mul (dfd-f32at qraw (mul (add hbase j) 4)) (dfd-f32at kraw (mul j 4)))))))
    (defn dfd-att-w (qraw kraw sraw h)
        (do (let s (mul (div 1.0 (tn-sqrt 512.0)) (dfd-att-dot qraw kraw (mul h 512) 0 0.0)))
            (let sink (dfd-f32at sraw (mul h 4)))
            (let m (if (gt sink s) sink s))
            (let e (tn-exp (sub s m)))
            (div e (add (tn-exp (sub sink m)) e))))
    (defn dfd-att-head-md (qraw kraw sraw haraw h d acc w)
        (if (ge d 512) acc
            (do (let dd (abs (sub (dfd-f32at haraw (mul (add (mul h 512) d) 4))
                                  (mul (dfd-f32at kraw (mul d 4)) w))))
                (dfd-att-head-md qraw kraw sraw haraw h (add d 1) (if (gt dd acc) dd acc) w))))
    (defn dfd-att-head-mr (kraw d acc w)
        (if (ge d 512) acc
            (do (let r (abs (mul (dfd-f32at kraw (mul d 4)) w)))
                (dfd-att-head-mr kraw (add d 1) (if (gt r acc) r acc) w))))
    (defn dfd-att-all-md (qraw kraw sraw haraw h acc)
        (if (ge h 64) acc
            (dfd-att-all-md qraw kraw sraw haraw (add h 1)
                (dfd-att-head-md qraw kraw sraw haraw h 0 acc (dfd-att-w qraw kraw sraw h)))))
    (defn dfd-att-all-mr (qraw kraw sraw h acc)
        (if (ge h 64) acc
            (dfd-att-all-mr qraw kraw sraw (add h 1)
                (dfd-att-head-mr kraw 0 acc (dfd-att-w qraw kraw sraw h)))))

    ; ═══════════════ RUNG 6: the attention block's exit — inverse rope, output_a (GROUPED), output_b ═
    ; attn_output_a is the kernel where 4096 means two different things one dispatch apart (its cols is
    ; 8 heads x 512 = the input GROUP width; output_b's OUTPUT is 4096 = n_embd), which is why the
    ; grouped matvec exists at all. The rank is NOT taken on faith from a constant: the band derives it
    ; from pinned geometry as rows*cols/hu_len = 8192*4096/32768 = 1024, so a wrong rank in the cell's
    ; dispatch cannot agree its way past the reference.
    (defn dfd-mx8g-msl ()
        (str_concat (qml-msl-header) (str_concat (mx8m-msl-helpers) (dsv4-mx8-grouped-body))))
    ; the Q8_0 grouped unit — the TEXT is dsv4-forward-real.fk's own dsv4-q80-grouped-body, the same
    ; bytes the bash lane compiles, taken in process. The pragma is prepended here because this door
    ; compiles options:nil (header note 1); the bash lane gets it from -ffp-contract=off instead.
    (defn dfd-q80g-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
        (str_concat (q80-msl-spine)
        (str_concat (q80-msl-weight) (dsv4-q80-grouped-body))))))
    ; type-dispatched GROUPED pipeline + enqueue, mirroring dfd-mv-pipe/dfd-mv-enq: the file's own
    ; tensor type picks the kernel; an unpriced type is a spoken refusal (0), never a guess. Both
    ; kernels share one signature (rows, cols, nel, rank; one simdgroup per row) so one enqueue
    ; serves both. tg capped 64 — the oracle's tgFree default for exactly this dispatch.
    (defn dfd-mvg-pipe (ty)
        (if (eq ty 8) (metal_pipeline (dfd-q80g-msl) "form_dsv4_q80_matvec_grouped")
        (if (eq ty 41) (metal_pipeline (str_concat (dfd-msl-pragma) (dfd-mx8g-msl)) "form_dsv4_mx8_matvec_grouped")
            0)))
    (defn dfd-mvg-enq (p w x y rows cols rank)
        (metal_enqueue p (dfd-bind-tg
            (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 w) (dfd-u32 x)) (dfd-u32 y)))
                        (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 rows) (dfd-u32 cols))
                                                            (str_concat (dfd-u32 (mul rows cols)) (dfd-u32 rank)))))
            64 0) (mul rows 32)))

    ; ═══════════════ RUNG 7: the fp8+f16 KV round (ds4.c:3211, IN the forward path) ═══════════════
    ; After the k row is roped, ds4.c ROUNDS it before attention sees it: the leading 448 NOPE dims
    ; through E4M3FN in 64-wide groups with a power-of-two group scale, then the WHOLE 512 row
    ; through f16. Skipping it is wrong by ~1e-2, not by float precision. The kernel text is
    ; dsv4-mla-real.fk's own (the par twin the oracle runs, pipe(lCore, "..._round_par")); this cell
    ; adds the pragma the door's options:nil compile needs.
    (defn dfd-kvq-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
        (str_concat (dsv4-kvq-body) (dsv4-kvq-par-body)))))

    ; ── the Form fp64 reference — a DIFFERENT TEXT from the MSL, built on format-arith's fq- spine.
    ; Every step below is exact in fp64 over f32 inputs: the group amax is a max of exact values, the
    ; scale is a power of two (division by it exact), the E4M3 magnitudes are exactly representable,
    ; and the ladder's distance comparisons subtract nearby exact values. The ONE rounding the f32
    ; kernel performs that fp64 does not share — amax/448.0f — is emulated with fq-quant(...,23).
    ; So the check demands BIT EQUALITY on all 512 lanes, not a tolerance.
    (defn dfd-kvq-e4m3-mag (i)
        (if (lt i 8) (mul i 0.001953125)
            (mul (add 1.0 (mul (mod i 8) 0.125)) (fq-pow2 (sub (div i 8) 7)))))
    ; largest index whose magnitude does not exceed ax (the ladder is ascending)
    (defn dfd-kvq-ladder (ax i best)
        (if (gt i 126) best
            (if (gt (dfd-kvq-e4m3-mag i) ax) best
                (dfd-kvq-ladder ax (add i 1) i))))
    ; ds4.c's nearest with tie to the EVEN INDEX: move up only on a strict win, or on a tie when the
    ; neighbor's index is even and best's is odd.
    (defn dfd-kvq-round (v)
        (do (let sgn (if (lt v 0.0) -1.0 1.0))
            (let ax0 (abs v))
            (let ax (if (gt ax0 448.0) 448.0 ax0))
            (let best (dfd-kvq-ladder ax 0 0))
            (let bd (abs (sub ax (dfd-kvq-e4m3-mag best))))
            (let nd (if (lt best 126) (abs (sub ax (dfd-kvq-e4m3-mag (add best 1)))) 1000000.0))
            (let pick (if (lt nd bd) (add best 1)
                      (if (eq nd bd)
                          (if (eq (mod best 2) 1) (add best 1) best)
                          best)))
            (mul sgn (dfd-kvq-e4m3-mag pick))))
    ; ceil(log2(amax/448)) off the f32 quotient's own exponent field: k = e when the quotient IS a
    ; power of two, else e+1. 953267991 is f32(1e-4), the kernel's own floor literal, as bits.
    (defn dfd-kvq-scale (amax0)
        (do (let flo (fd-value 953267991 8 23))
            (let amax (if (lt amax0 flo) flo amax0))
            (let t (fq-quant (div amax 448.0) 23))
            (let e (fq-exponent t))
            (fq-pow2 (if (eq t (fq-pow2 e)) e (add e 1)))))
    (defn dfd-kvq-amax (raw base j acc)
        (if (ge j 64) acc
            (do (let a (abs (dfd-f32at raw (mul (add base j) 4))))
                (dfd-kvq-amax raw base (add j 1) (if (gt a acc) a acc)))))
    ; IEEE half of an f32 value, denormals included: normals quantize the mantissa to 10 stored bits
    ; (fq-quant); below 2^-14 the grid is fixed at 2^-24 and the round is RNE on that grid.
    (defn dfd-f16-rne (x)
        (if (eq x 0.0) 0.0
            (do (let ax (abs x))
                (let sgn (if (lt x 0.0) -1.0 1.0))
                (if (ge (fq-exponent ax) (sub 0 14))
                    (fq-quant x 10)
                    (mul sgn (mul (fq-rne (mul ax 16777216.0)) (fq-pow2 (sub 0 24))))))))
    ; one lane's reference: fp8 path for the 7 NOPE groups, then f16 across the whole row
    (defn dfd-kvq-ref (raw i sc)
        (do (let v (dfd-f32at raw (mul i 4)))
            (if (lt i 448)
                (do (let w0 (div v sc))
                    (let w (if (gt w0 448.0) 448.0 (if (lt w0 -448.0) -448.0 w0)))
                    (dfd-f16-rne (mul (dfd-kvq-round w) sc)))
                (dfd-f16-rne v))))
    ; count bit-equal lanes; the group scale is recomputed at each group boundary
    (defn dfd-kvq-cmp (inraw outraw i sc acc)
        (if (ge i 512) acc
            (do (let sc2 (if (lt i 448)
                             (if (eq (mod i 64) 0) (dfd-kvq-scale (dfd-kvq-amax inraw i 0 0.0)) sc)
                             sc))
                (dfd-kvq-cmp inraw outraw (add i 1) sc2
                    (if (eq (dfd-kvq-ref inraw i sc2) (dfd-f32at outraw (mul i 4))) (add acc 1) acc)))))

    ; ── SYNTHETIC TRUTH for the round, hand-computed, the tie rule on the knife edge ──
    ; Group 0 carries amax = 448 so the scale is exactly 1 (448/448 = 1.0, a power of two, k = 0) and
    ; the E4M3 ladder is exercised bare: lane 0 = 448 (the top magnitude, index 126, stays), lane 1 =
    ; 1.0625 (EXACT midpoint of 1.0 [index 56] and 1.125 [57]; tie, best even, stays -> 1.0), lane 2 =
    ; 1.1875 (EXACT midpoint of 1.125 [57] and 1.25 [58]; tie, best odd, moves -> 1.25), lanes 3..63 =
    ; 1.0 (on-grid, unmoved). Groups 1..6 are all zero (the amax floor path; zero stays zero). The
    ; roped tail 448..511 = 1.5, f16-identity. A wrong tie direction, a wrong scale, a wrong group
    ; seam, or a missing f16 stage each move at least one pinned lane.
    (defn dfd-kvq-synth ()
        (do (let p (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par"))
            (let vb (metal_buf_alloc 2048))
            (let ob (metal_buf_alloc 2048))
            (let f1 (dfd-fill vb 3 64 1065353216))
            (let f2 (metal_buf_write vb 0 (dfd-u32 1138753536)))
            (let f3 (metal_buf_write vb 4 (dfd-u32 1065877504)))
            (let f4 (metal_buf_write vb 8 (dfd-u32 1066926080)))
            ; groups 1..6 are zeroed EXPLICITLY — a fresh device allocation owes no one zeroes
            (let f5 (dfd-fill vb 64 448 0))
            (let f6 (dfd-fill vb 448 512 1069547520))
            (let e (metal_enqueue p (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 vb) (dfd-u32 ob)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
            (let o (metal_buf_read ob 0 2048))
            (print (str_concat "KVQSYNTH lanes 0/1/2/3/64/448 = " (str_concat (int_to_str (dfd-rd32 o 0))
                   (str_concat "/" (str_concat (int_to_str (dfd-rd32 o 4))
                   (str_concat "/" (str_concat (int_to_str (dfd-rd32 o 8))
                   (str_concat "/" (str_concat (int_to_str (dfd-rd32 o 12))
                   (str_concat "/" (str_concat (int_to_str (dfd-rd32 o 256))
                   (str_concat "/" (int_to_str (dfd-rd32 o 1792))))))))))))))
            (if (eq (dfd-rd32 o 0) 1138753536)
                (if (eq (dfd-rd32 o 4) 1065353216)
                    (if (eq (dfd-rd32 o 8) 1067450368)
                        (if (eq (dfd-rd32 o 12) 1065353216)
                            (if (eq (dfd-rd32 o 256) 0)
                                (if (eq (dfd-rd32 o 1792) 1069547520) 1 0) 0) 0) 0) 0) 0)))

    ; the grouped fp64 reference: tensor row r consumes the (r/rank)-th cols-wide slice of x.
    (defn dfd-mx8g-dot (ty wraw nel cols rank xraw r j acc)
        (if (ge j cols) acc
            (dfd-mx8g-dot ty wraw nel cols rank xraw r (add j 1)
                (add acc (mul (dfd-wat ty wraw nel (add (mul r cols) j))
                              (dfd-f32at xraw (mul (add (mul (div r rank) cols) j) 4)))))))
    (defn dfd-mx8g-md (ty wraw nel cols rank xraw got rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let d (abs (sub (dfd-f32at got (mul r 4)) (dfd-mx8g-dot ty wraw nel cols rank xraw r 0 0.0))))
                (dfd-mx8g-md ty wraw nel cols rank xraw got (tail rowsl) (if (gt d acc) d acc)))))
    (defn dfd-mx8g-mr (ty wraw nel cols rank xraw rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let a (abs (dfd-mx8g-dot ty wraw nel cols rank xraw r 0 0.0)))
                (dfd-mx8g-mr ty wraw nel cols rank xraw (tail rowsl) (if (gt a acc) a acc)))))
    ; plain-mx8 ref over a chosen row list (rung 3's helper walks rows 0..nr; this one samples)
    (defn dfd-mx8-md-rows (ty wraw nel cols xraw got rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let d (abs (sub (dfd-f32at got (mul r 4)) (dfd-mx8dot ty wraw nel cols xraw r 0 0.0))))
                (dfd-mx8-md-rows ty wraw nel cols xraw got (tail rowsl) (if (gt d acc) d acc)))))
    (defn dfd-mx8-mr-rows (ty wraw nel cols xraw rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let a (abs (dfd-mx8dot ty wraw nel cols xraw r 0 0.0)))
                (dfd-mx8-mr-rows ty wraw nel cols xraw (tail rowsl) (if (gt a acc) a acc)))))

    (defn dfd-mla2-rung (path token)
        (do
            (let src (dfd-src path))
            (let n (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.0.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.0.attn_norm.weight"))
            (let qabs (dfd-tabs src path "blk.0.attn_q_a.weight"))
            (let qbytes (dfd-tbytes src "blk.0.attn_q_a.weight"))
            (let kvabs (dfd-tabs src path "blk.0.attn_kv.weight"))
            (let kvbytes (dfd-tbytes src "blk.0.attn_kv.weight"))
            (let kvrows (dfd-td1 src "blk.0.attn_kv.weight"))
            (let qanabs (dfd-tabs src path "blk.0.attn_q_a_norm.weight"))
            (let qanbytes (dfd-tbytes src "blk.0.attn_q_a_norm.weight"))
            (let qan-n (dfd-td0 src "blk.0.attn_q_a_norm.weight"))
            (let kvanabs (dfd-tabs src path "blk.0.attn_kv_a_norm.weight"))
            (let kvanbytes (dfd-tbytes src "blk.0.attn_kv_a_norm.weight"))
            (let kvan-n (dfd-td0 src "blk.0.attn_kv_a_norm.weight"))
            (let qbabs (dfd-tabs src path "blk.0.attn_q_b.weight"))
            (let qbbytes (dfd-tbytes src "blk.0.attn_q_b.weight"))
            (let qbcols (dfd-td0 src "blk.0.attn_q_b.weight"))
            (let qbrows (dfd-td1 src "blk.0.attn_q_b.weight"))
            (let qbnel (mul qbrows qbcols))
            (let qaty (dfd-ttype src "blk.0.attn_q_a.weight"))
            (let kvty (dfd-ttype src "blk.0.attn_kv.weight"))
            (let qbty (dfd-ttype src "blk.0.attn_q_b.weight"))
            (print (str_concat "GEOM proj types q_a/kv/q_b=" (str_concat (int_to_str qaty)
                   (str_concat "/" (str_concat (int_to_str kvty) (str_concat "/" (int_to_str qbty)))))))
            (print (str_concat "GEOM q_a_norm abs=" (str_concat (int_to_str qanabs) (str_concat " n=" (int_to_str qan-n)))))
            (print (str_concat "GEOM kv_a_norm abs=" (str_concat (int_to_str kvanabs) (str_concat " n=" (int_to_str kvan-n)))))
            (print (str_concat "GEOM q_b abs=" (str_concat (int_to_str qbabs)
                   (str_concat " rows=" (str_concat (int_to_str qbrows) (str_concat " cols=" (int_to_str qbcols)))))))
            (print (str_concat "GEOM kv abs=" (str_concat (int_to_str kvabs) (str_concat " rows=" (int_to_str kvrows)))))

            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let ph (metal_pipeline mslm "form_mla_headrms_f32"))
            (let pmqa (dfd-mv-pipe qaty))
            (let pmkv (dfd-mv-pipe kvty))
            (let pmqb (dfd-mv-pipe qbty))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let gh (metal_buf_from_file path gabs gbytes))
            (let qah (metal_buf_from_file path qabs qbytes))
            (let kvh (metal_buf_from_file path kvabs kvbytes))
            (let qanh (metal_buf_from_file path qanabs qanbytes))
            (let kvanh (metal_buf_from_file path kvanabs kvanbytes))
            (let qbh (metal_buf_from_file path qbabs qbbytes))
            (let xb (metal_buf_alloc (mul n 4)))
            (let ib (metal_buf_alloc 4))
            (let ob (metal_buf_alloc (mul n 4)))
            (let qlb (metal_buf_alloc (mul qan-n 4)))
            (let ib2 (metal_buf_alloc 4))
            (let qlnb (metal_buf_alloc (mul qan-n 4)))
            (let klb (metal_buf_alloc (mul kvan-n 4)))
            (let ib3 (metal_buf_alloc 4))
            (let klnb (metal_buf_alloc (mul kvan-n 4)))
            (let qqb (metal_buf_alloc (mul qbrows 4)))
            (let qhb (metal_buf_alloc (mul qbrows 4)))
            (let rowoff (mul (mul token n) 2))

            ; the eleven dispatches, one open batch, ONE sync (at the first read)
            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 n)))) n))
            (let e1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 n) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gh))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 n))) n))
            (let e3 (dfd-mv-enq pmqa qaty qah ob qlb qan-n n))
            (let e4 (dfd-mv-enq pmkv kvty kvh ob klb kvrows n))
            (let e5 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qlb) (dfd-u32 ib2)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 qan-n) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e6 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 qlb) (dfd-u32 qanh))
                                                                (str_concat (dfd-u32 qlnb) (dfd-u32 ib2))))
                            (str_concat (dfd-u32 1) (dfd-u32 qan-n))) qan-n))
            (let e7 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 klb) (dfd-u32 ib3)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 kvan-n) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e8 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 klb) (dfd-u32 kvanh))
                                                                (str_concat (dfd-u32 klnb) (dfd-u32 ib3))))
                            (str_concat (dfd-u32 1) (dfd-u32 kvan-n))) kvan-n))
            (let e9 (dfd-mv-enq pmqb qbty qbh qlnb qqb qbrows qbcols))
            (let e10 (metal_enqueue ph
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qqb) (dfd-u32 qhb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512)) (dfd-u32 (dfd-eps-bits))))) 64))
            (print (str_concat "ENQ 11 dispatches sum=" (int_to_str (add e0 (add e1 (add e2 (add e3 (add e4
                (add e5 (add e6 (add e7 (add e8 (add e9 e10)))))))))))))

            ; the ONE sync happens inside the first read
            (let qlraw (metal_buf_read qlb 0 (mul qan-n 4)))
            (let qlnraw (metal_buf_read qlnb 0 (mul qan-n 4)))
            (let klraw (metal_buf_read klb 0 (mul kvan-n 4)))
            (let klnraw (metal_buf_read klnb 0 (mul kvan-n 4)))
            (let qqraw (metal_buf_read qqb 0 (mul qbrows 4)))
            (let qhraw (metal_buf_read qhb 0 (mul qbrows 4)))

            (let qangraw (eqr-of-file path qanabs qanbytes))
            (let kvangraw (eqr-of-file path kvanabs kvanbytes))
            (let relqln (dfd-rms-ref qlraw qangraw qlnraw qan-n))
            (let relkln (dfd-rms-ref klraw kvangraw klnraw kvan-n))
            (print (str_concat "REL q_a_norm (ppb)=" (float_to_str (mul relqln 1000000000.0))))
            (print (str_concat "REL kv_a_norm (ppb)=" (float_to_str (mul relkln 1000000000.0))))

            (let qbwraw (eqr-of-file path qbabs qbbytes))
            (let relqb (dfd-mx8-cmp qbty qbwraw qbnel qbcols qlnraw qqraw 0 8 0.0))
            (print (str_concat "REL q_b 8 rows (ppb)=" (float_to_str (mul relqb 1000000000.0))))

            (let relhr (dfd-headrms-all qqraw qhraw 0 64 512 0.0))
            (print (str_concat "REL headrms 64 heads (ppb)=" (float_to_str (mul relhr 1000000000.0))))

            ; ── rung 5 continues the SAME batch: freqs -> rope(q,64h) -> rope(k,1h) -> attend ──
            (let snkabs (dfd-tabs src path "blk.0.attn_sinks.weight"))
            (let snkbytes (dfd-tbytes src "blk.0.attn_sinks.weight"))
            (print (str_concat "GEOM sinks abs=" (int_to_str snkabs)))
            (let snkh (metal_buf_from_file path snkabs snkbytes))
            (let pf (metal_pipeline (dfd-freqs-msl) "dfd_freqs"))
            (let pro (metal_pipeline mslm "form_mla_rope_f32"))
            (let pat (metal_pipeline mslm "form_mla_attend_f32"))
            (let fb (metal_buf_alloc 128))
            (let qrb (metal_buf_alloc (mul qbrows 4)))
            (let krb (metal_buf_alloc (mul 512 4)))
            (let hab (metal_buf_alloc (mul qbrows 4)))
            ; base = 10000.0f (bits 1176256512), from the file's KV deepseek4.rope.freq_base
            (let e11 (metal_enqueue pf
                (str_concat (str_concat (dfd-u32 1) (dfd-u32 fb))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64)) (dfd-u32 1176256512)))) 32))
            ; rope q: nh=64 hd=512 nrot=64 pos=7.0f sign=+1.0f
            (let e12 (metal_enqueue pro
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 qhb) (dfd-u32 qrb)) (dfd-u32 fb)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 1088421888) (dfd-u32 1065353216)))))) qbrows))
            ; rope k: nh=1
            (let e13 (metal_enqueue pro
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 klnb) (dfd-u32 krb)) (dfd-u32 fb)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 1) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 1088421888) (dfd-u32 1065353216)))))) 512))
            ; the fp8+f16 round, BETWEEN the rope and the attention — where ds4.c:3211 puts it. The
            ; par kernel needs its whole row in ONE threadgroup (the group scales stage through
            ; threadgroup memory), so tg is pinned to 512, the oracle's own enc(pKvq, headDim, headDim).
            (let pkq (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par"))
            (let kqb (metal_buf_alloc (mul 512 4)))
            (let e13b (metal_enqueue pkq (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 krb) (dfd-u32 kqb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
            ; attend: nh=64 hd=512 nrows=1 scale=1/sqrt(512) (bits 1026884851, Form-verified in band)
            ; — and its K row is now the ROUNDED one, as the oracle's gpuAttend(qr, kq, snk) reads it
            (let e14 (metal_enqueue pat
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 qrb) (dfd-u32 kqb))
                                                                (str_concat (dfd-u32 hab) (dfd-u32 snkh))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 1) (dfd-u32 1026884851))))) 64))
            (print (str_concat "ENQ rope/attend=" (str_concat (int_to_str e11) (str_concat (int_to_str e12)
                   (str_concat (int_to_str e13) (int_to_str e14))))))

            ; ── rung 6 continues the SAME batch: inverse rope -> grouped output_a -> output_b ──
            ; the oracle's exit is gpuRope(ha, nHead, pos, il, TRUE) -> gpuGrouped(w.oa, hu) ->
            ; gpuMx8(w.ob, lo). The RANK is not taken on faith: it is DERIVED from pinned geometry as
            ; oa_rows*oa_cols/hu_len = 8192*4096/32768 = 1024, so a wrong rank in this dispatch cannot
            ; agree its way past a reference that samples rows on BOTH sides of every group seam.
            (let oaabs (dfd-tabs src path "blk.0.attn_output_a.weight"))
            (let oabytes (dfd-tbytes src "blk.0.attn_output_a.weight"))
            (let oaty (dfd-ttype src "blk.0.attn_output_a.weight"))
            (let oacols (dfd-td0 src "blk.0.attn_output_a.weight"))
            (let oarows (dfd-td1 src "blk.0.attn_output_a.weight"))
            (let obabs (dfd-tabs src path "blk.0.attn_output_b.weight"))
            (let obbytes (dfd-tbytes src "blk.0.attn_output_b.weight"))
            (let obty (dfd-ttype src "blk.0.attn_output_b.weight"))
            (let obcols (dfd-td0 src "blk.0.attn_output_b.weight"))
            (let obrows (dfd-td1 src "blk.0.attn_output_b.weight"))
            (let orank (div (mul oarows oacols) qbrows))
            (print (str_concat "GEOM output_a abs=" (str_concat (int_to_str oaabs)
                   (str_concat " type=" (str_concat (int_to_str oaty)
                   (str_concat " rows=" (str_concat (int_to_str oarows)
                   (str_concat " cols=" (str_concat (int_to_str oacols)
                   (str_concat " rank=" (int_to_str orank)))))))))))
            (print (str_concat "GEOM output_b abs=" (str_concat (int_to_str obabs)
                   (str_concat " type=" (str_concat (int_to_str obty)
                   (str_concat " rows=" (str_concat (int_to_str obrows)
                   (str_concat " cols=" (int_to_str obcols)))))))))
            (let pg (dfd-mvg-pipe oaty))
            (let pob (dfd-mv-pipe obty))
            (let oah (metal_buf_from_file path oaabs oabytes))
            (let obh (metal_buf_from_file path obabs obbytes))
            (let hub (metal_buf_alloc (mul qbrows 4)))
            (let lob (metal_buf_alloc (mul oarows 4)))
            (let aob (metal_buf_alloc (mul obrows 4)))
            ; inverse rope: same kernel, sign = -1.0f (bits 3212836864); pos stays +7.0f, as the
            ; oracle passes it. sign only multiplies sin(a), so this IS the negated angle.
            (let e15 (metal_enqueue pro
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 hab) (dfd-u32 hub)) (dfd-u32 fb)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 1088421888) (dfd-u32 3212836864)))))) qbrows))
            (let e16 (dfd-mvg-enq pg oah hub lob oarows oacols orank))
            (let e17 (dfd-mv-enq pob obty obh lob aob obrows obcols))
            (print (str_concat "ENQ irope/grouped/output_b=" (str_concat (int_to_str e15)
                   (str_concat (int_to_str e16) (int_to_str e17)))))

            (let fraw (metal_buf_read fb 0 128))
            (let qrraw (metal_buf_read qrb 0 (mul qbrows 4)))
            (let krraw (metal_buf_read krb 0 (mul 512 4)))
            (let kqraw (metal_buf_read kqb 0 (mul 512 4)))
            (let haraw (metal_buf_read hab 0 (mul qbrows 4)))
            (let snkraw (eqr-of-file path snkabs snkbytes))
            (print (str_concat "freqs[0] bits=" (int_to_str (dfd-rd32 fraw 0))))

            ; rope: NOPE bit-equality on k row + q head 0, tail vs fp64 on the same two heads
            (let nopeeq (add (dfd-nope-eq klnraw krraw 0 0 0) (dfd-nope-eq qhraw qrraw 0 0 0)))
            (let rmd (dfd-rope-tail-md klnraw krraw fraw 0 7.0 0
                      (dfd-rope-tail-md qhraw qrraw fraw 0 7.0 0 0.0)))
            (let rmr (dfd-rope-tail-mr klnraw fraw 0 7.0 0
                      (dfd-rope-tail-mr qhraw fraw 0 7.0 0 0.0)))
            (let relrope (div rmd rmr))
            (print (str_concat "NOPE bit-equal dims=" (str_concat (int_to_str nopeeq) " of 896")))
            (print (str_concat "REL rope tails (ppb)=" (float_to_str (mul relrope 1000000000.0))))

            ; the KV round: BIT EQUALITY on all 512 lanes against the fq- spine reference — the
            ; input is the GPU's actual roped row (induction), the arithmetic is ds4.c's, transcribed
            ; as a different text.
            (let kvqeq (dfd-kvq-cmp krraw kqraw 0 1.0 0))
            (print (str_concat "KVROUND bit-equal lanes=" (str_concat (int_to_str kvqeq) " of 512")))

            ; attend: all 64 heads vs fp64, against the output vector's scale — reading the ROUNDED
            ; K row, the buffer the GPU's attend actually read
            (let amd (dfd-att-all-md qrraw kqraw snkraw haraw 0 0.0))
            (let amr (dfd-att-all-mr qrraw kqraw snkraw 0 0.0))
            (let relatt (div amd amr))
            (print (str_concat "REL attend 64 heads (ppb)=" (float_to_str (mul relatt 1000000000.0))))

            ; ── rung 6 references. Induction as before: each step's fp64 reference reads the GPU's
            ; ACTUAL input buffer for that step and weights at the pinned file addresses.
            (let huraw (metal_buf_read hub 0 (mul qbrows 4)))
            (let loraw (metal_buf_read lob 0 (mul oarows 4)))
            (let aoraw (metal_buf_read aob 0 (mul obrows 4)))

            ; inverse rope: NOPE dims are a copy checked as a copy (heads 0 and 63, 896 dims), and
            ; the rotated tails against fcos/fsin in fp64 at the NEGATED angle (pos = -7.0).
            (let nope6 (add (dfd-nope-eq haraw huraw 0 0 0) (dfd-nope-eq haraw huraw 32256 0 0)))
            (let imd (dfd-rope-tail-md haraw huraw fraw 32256 -7.0 0
                      (dfd-rope-tail-md haraw huraw fraw 0 -7.0 0 0.0)))
            (let imr (dfd-rope-tail-mr haraw fraw 32256 -7.0 0
                      (dfd-rope-tail-mr haraw fraw 0 -7.0 0 0.0)))
            (let relir (div imd imr))
            (print (str_concat "IROPE NOPE bit-equal dims=" (str_concat (int_to_str nope6) " of 896")))
            (print (str_concat "REL inverse-rope tails (ppb)=" (float_to_str (mul relir 1000000000.0))))

            ; grouped output_a: eight rows ON BOTH SIDES of group seams — {0,1} in group 0,
            ; {1024,1025} astride the rank-1024 seam, {4096,4097} at group 4, {7168,7169} at group 7.
            ; A wrong rank moves the group a sampled row reads and the reference catches it at the seam.
            (let oawraw (eqr-of-file path oaabs oabytes))
            (let oanel (mul oarows oacols))
            (let grows (cons 0 (cons 1 (cons 1024 (cons 1025 (cons 4096 (cons 4097 (cons 7168 (cons 7169 0)))))))))
            (let relgrp (div (dfd-mx8g-md oaty oawraw oanel oacols orank huraw loraw grows 0.0)
                             (dfd-mx8g-mr oaty oawraw oanel oacols orank huraw grows 0.0)))
            (print (str_concat "REL grouped output_a 8 rows (ppb)=" (float_to_str (mul relgrp 1000000000.0))))

            ; output_b: eight sampled rows of the plain matvec, 8192-term fp64 folds each.
            (let obwraw (eqr-of-file path obabs obbytes))
            (let obnel (mul obrows obcols))
            (let brows (cons 0 (cons 1 (cons 1365 (cons 1366 (cons 2730 (cons 2731 (cons 4094 (cons 4095 0)))))))))
            (let relob (div (dfd-mx8-md-rows obty obwraw obnel obcols loraw aoraw brows 0.0)
                            (dfd-mx8-mr-rows obty obwraw obnel obcols loraw brows 0.0)))
            (print (str_concat "REL output_b 8 rows (ppb)=" (float_to_str (mul relob 1000000000.0))))
            (print (str_concat "attn_out[0]=" (float_to_str (dfd-f32at aoraw 0))))
            (print (metal_status))
            (cons relqln (cons relkln (cons relqb (cons relhr
                (cons qanabs (cons kvanabs (cons qbabs (cons kvabs
                (cons (add eabs rowoff) (cons qbrows (cons qbcols
                (cons relrope (cons relatt (cons nopeeq
                (cons snkabs (cons (dfd-rd32 fraw 0) (cons (dfd-rd32 fraw 4)
                (cons oaabs (cons obabs (cons oarows (cons oacols (cons obcols
                (cons orank (cons oaty (cons obty
                (cons nope6 (cons relir (cons relgrp (cons relob
                (cons kvqeq 0))))))))))))))))))))))))))))))))

    ; ═══════════════ RUNG 8: the growing KV cache — a REAL PROMPT'S five rows, then attend ═════════
    ; "The capital of France is" -> ids 671 6102 294 8760 344, encoded by the body's OWN tokenizer
    ; cell (dsv4-tokenizer-cli.fk), the one authority on what a token is. Each position runs the k
    ; chain at ITS OWN position (embed -> rmsnorm -> kv -> kv_a_norm -> rope(pos t) -> fp8+f16 round)
    ; and the rounded row is APPENDED into a cache buffer — the oracle's gpuKvAppend, as a
    ; cell-emitted copy kernel. Then the LAST token's q chain runs at pos 4 and the sink-softmax
    ; attend folds ALL FIVE rows (nrows = 5), which is gpuAttendSplit's arithmetic with nComp = 0.
    ; The intermediate buffers are REUSED across positions — the batch is serial, so position t's
    ; nine dispatches read what position t wrote, and the handle count stays flat.
    (defn dfd-append-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
            "kernel void dfd_kv_append(device const float* src [[buffer(0)]], device float* cache [[buffer(1)]], constant uint& row [[buffer(2)]], constant uint& hd [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i < hd) cache[row * hd + i] = src[i]; }")))
    ; position as f32 bits and as fp64, from a table rather than a conversion — eight literals a
    ; reader can check by eye against the IEEE layout (5.0=0x40A00000, 6.0=0x40C00000, 7.0=0x40E00000)
    (defn dfd-posbits (t) (nth (cons 0 (cons 1065353216 (cons 1073741824 (cons 1077936128
        (cons 1082130432 (cons 1084227584 (cons 1086324736 (cons 1088421888 0)))))))) t))
    (defn dfd-posf (t) (nth (cons 0.0 (cons 1.0 (cons 2.0 (cons 3.0
        (cons 4.0 (cons 5.0 (cons 6.0 (cons 7.0 0)))))))) t))

    ; one position of the prefill: nine dispatches, five reads, four checks. H is the handle list:
    ; 0 pe, 1 pr, 2 pa, 3 pmkv, 4 pro, 5 pkq, 6 pap, 7 embh, 8 gh, 9 kvh, 10 kvanh, 11 fb,
    ; 12 xb, 13 ib, 14 ob, 15 klb, 16 ib3, 17 klnb, 18 krb, 19 kqb, 20 cacheb
    (defn dfd-kvc-pos (path H id t eabs kvraw kvty nembd)
        (do
            (let rowoff (mul (mul id nembd) 2))
            (let e0 (metal_enqueue (nth H 0)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth H 7)) (dfd-u32 (nth H 12))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let e1 (metal_enqueue (nth H 1) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth H 12)) (dfd-u32 (nth H 13))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e2 (metal_enqueue (nth H 2)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth H 12)) (dfd-u32 (nth H 8)))
                                                                (str_concat (dfd-u32 (nth H 14)) (dfd-u32 (nth H 13)))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let e3 (dfd-mv-enq (nth H 3) kvty (nth H 9) (nth H 14) (nth H 15) 512 nembd))
            (let e4 (metal_enqueue (nth H 1) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth H 15)) (dfd-u32 (nth H 16))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e5 (metal_enqueue (nth H 2)
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth H 15)) (dfd-u32 (nth H 10)))
                                                                (str_concat (dfd-u32 (nth H 17)) (dfd-u32 (nth H 16)))))
                            (str_concat (dfd-u32 1) (dfd-u32 512))) 512))
            (let e6 (metal_enqueue (nth H 4)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth H 17)) (dfd-u32 (nth H 18))) (dfd-u32 (nth H 11))))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 1) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 (dfd-posbits t)) (dfd-u32 1065353216)))))) 512))
            (let e7 (metal_enqueue (nth H 5) (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth H 18)) (dfd-u32 (nth H 19))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
            (let e8 (metal_enqueue (nth H 6)
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth H 19)) (dfd-u32 (nth H 20))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 t) (dfd-u32 512)))) 512))
            ; the reads drain the batch; each check reads the GPU's ACTUAL buffers for its step
            (let xraw (metal_buf_read (nth H 12) 0 (mul nembd 4)))
            (let obraw (metal_buf_read (nth H 14) 0 (mul nembd 4)))
            (let klraw (metal_buf_read (nth H 15) 0 2048))
            (let klnraw (metal_buf_read (nth H 17) 0 2048))
            (let krraw (metal_buf_read (nth H 18) 0 2048))
            (let kqraw (metal_buf_read (nth H 19) 0 2048))
            (let fraw (metal_buf_read (nth H 11) 0 128))
            ; c1: the embedding, bit-exact against the file's own bytes at THIS id's row
            (let eraw (eqr-of-file path (add eabs rowoff) (mul nembd 2)))
            (let c1r (dfd-cmp-go eraw xraw 0 nembd 0 0 0))
            (let c1 (if (eq (head c1r) nembd) (if (eq (head (tail c1r)) 0) 1 0) 0))
            ; c2: the kv matvec, two sampled rows against the fp64 fold of the file's own bytes
            (let mrows (cons t (cons (add t 256) 0)))
            (let c2rel (div (dfd-mx8-md-rows kvty kvraw (mul 512 nembd) nembd obraw klraw mrows 0.0)
                            (dfd-mx8-mr-rows kvty kvraw (mul 512 nembd) nembd obraw mrows 0.0)))
            (let c2 (if (lt c2rel 0.000001) 1 0))
            ; c3: the rope at THIS position — NOPE bit-equal, tails vs fp64 at pos t
            (let c3ne (dfd-nope-eq klnraw krraw 0 0 0))
            (let c3rel (div (dfd-rope-tail-md klnraw krraw fraw 0 (dfd-posf t) 0 0.0)
                            (dfd-rope-tail-mr klnraw fraw 0 (dfd-posf t) 0 0.0)))
            (let c3 (if (eq c3ne 448) (if (lt c3rel 0.000001) 1 0) 0))
            ; c4: the round, bit-exact on all 512 lanes
            (let c4 (if (eq (dfd-kvq-cmp krraw kqraw 0 1.0 0) 512) 1 0))
            (let flag (mul c1 (mul c2 (mul c3 c4))))
            (print (str_concat "PREFILL t=" (str_concat (int_to_str t)
                   (str_concat " id=" (str_concat (int_to_str id)
                   (str_concat " c1/c2/c3/c4=" (str_concat (int_to_str c1)
                   (str_concat (int_to_str c2) (str_concat (int_to_str c3) (int_to_str c4))))))))))
            (cons flag (cons (add eabs rowoff) (cons kqraw 0)))))

    (defn dfd-kvc-loop (path H ids t eabs kvraw kvty nembd)
        (if (eq (len ids) 0) 0
            (cons (dfd-kvc-pos path H (head ids) t eabs kvraw kvty nembd)
                  (dfd-kvc-loop path H (tail ids) (add t 1) eabs kvraw kvty nembd))))

    ; the cache row t must be BIT-EQUAL to the snapshot taken from the round's own output buffer
    ; the moment position t finished — this is the bit that owns WHERE the append wrote
    (defn dfd-kvc-roweq (cacheraw snap t i acc)
        (if (ge i 512) acc
            (dfd-kvc-roweq cacheraw snap t (add i 1)
                (if (eq (dfd-rd32 cacheraw (mul (add (mul t 512) i) 4)) (dfd-rd32 snap (mul i 4)))
                    (add acc 1) acc))))
    (defn dfd-kvc-asm (cacheraw recs t acc)
        (if (eq (len recs) 0) acc
            (dfd-kvc-asm cacheraw (tail recs) (add t 1)
                (mul acc (if (eq (dfd-kvc-roweq cacheraw (head (tail (tail (head recs)))) t 0 0) 512) 1 0)))))

    ; ── the fp64 multi-row sink-softmax reference (tn-exp / tn-sqrt), sampled heads, all rows ──
    (defn dfd-a5-dot (qraw craw hbase cbase j acc)
        (if (ge j 512) acc
            (dfd-a5-dot qraw craw hbase cbase (add j 1)
                (add acc (mul (dfd-f32at qraw (mul (add hbase j) 4)) (dfd-f32at craw (mul (add cbase j) 4)))))))
    (defn dfd-a5-score (qraw craw h j scale)
        (mul scale (dfd-a5-dot qraw craw (mul h 512) (mul j 512) 0 0.0)))
    (defn dfd-a5-maxs (qraw craw h nr j scale m)
        (if (ge j nr) m
            (do (let s (dfd-a5-score qraw craw h j scale))
                (dfd-a5-maxs qraw craw h nr (add j 1) scale (if (gt s m) s m)))))
    (defn dfd-a5-se (qraw craw h nr j scale m acc)
        (if (ge j nr) acc
            (dfd-a5-se qraw craw h nr (add j 1) scale m
                (add acc (tn-exp (sub (dfd-a5-score qraw craw h j scale) m))))))
    (defn dfd-a5-outd (qraw craw h nr j d scale m denom acc)
        (if (ge j nr) (div acc denom)
            (dfd-a5-outd qraw craw h nr (add j 1) d scale m denom
                (add acc (mul (tn-exp (sub (dfd-a5-score qraw craw h j scale) m))
                              (dfd-f32at craw (mul (add (mul j 512) d) 4)))))))
    (defn dfd-a5-head-md (qraw craw haraw h nr d scale m denom acc)
        (if (ge d 512) acc
            (do (let r (dfd-a5-outd qraw craw h nr 0 d scale m denom 0.0))
                (let dd (abs (sub (dfd-f32at haraw (mul (add (mul h 512) d) 4)) r)))
                (dfd-a5-head-md qraw craw haraw h nr (add d 1) scale m denom (if (gt dd acc) dd acc)))))
    (defn dfd-a5-head-mr (qraw craw h nr d scale m denom acc)
        (if (ge d 512) acc
            (do (let r (abs (dfd-a5-outd qraw craw h nr 0 d scale m denom 0.0)))
                (dfd-a5-head-mr qraw craw h nr (add d 1) scale m denom (if (gt r acc) r acc)))))
    (defn dfd-a5-heads (qraw craw sraw haraw hl nr scale mdmr)
        (if (eq (len hl) 0) mdmr
            (do (let h (head hl))
                (let sink (dfd-f32at sraw (mul h 4)))
                (let m (dfd-a5-maxs qraw craw h nr 0 scale sink))
                (let denom (add (tn-exp (sub sink m)) (dfd-a5-se qraw craw h nr 0 scale m 0.0)))
                (let md (dfd-a5-head-md qraw craw haraw h nr 0 scale m denom (head mdmr)))
                (let mr (dfd-a5-head-mr qraw craw h nr 0 scale m denom (head (tail mdmr))))
                (dfd-a5-heads qraw craw sraw haraw (tail hl) nr scale (cons md (cons mr 0))))))

    (defn dfd-kvc-run (path ids)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.0.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.0.attn_norm.weight"))
            (let kvabs (dfd-tabs src path "blk.0.attn_kv.weight"))
            (let kvbytes (dfd-tbytes src "blk.0.attn_kv.weight"))
            (let kvty (dfd-ttype src "blk.0.attn_kv.weight"))
            (let qabs (dfd-tabs src path "blk.0.attn_q_a.weight"))
            (let qbytes (dfd-tbytes src "blk.0.attn_q_a.weight"))
            (let qaty (dfd-ttype src "blk.0.attn_q_a.weight"))
            (let qanabs (dfd-tabs src path "blk.0.attn_q_a_norm.weight"))
            (let qanbytes (dfd-tbytes src "blk.0.attn_q_a_norm.weight"))
            (let qbabs (dfd-tabs src path "blk.0.attn_q_b.weight"))
            (let qbbytes (dfd-tbytes src "blk.0.attn_q_b.weight"))
            (let qbty (dfd-ttype src "blk.0.attn_q_b.weight"))
            (let snkabs (dfd-tabs src path "blk.0.attn_sinks.weight"))
            (let snkbytes (dfd-tbytes src "blk.0.attn_sinks.weight"))
            (let nr (len ids))

            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let ph (metal_pipeline mslm "form_mla_headrms_f32"))
            (let pro (metal_pipeline mslm "form_mla_rope_f32"))
            (let pat (metal_pipeline mslm "form_mla_attend_f32"))
            (let pf (metal_pipeline (dfd-freqs-msl) "dfd_freqs"))
            (let pkq (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par"))
            (let pap (metal_pipeline (dfd-append-msl) "dfd_kv_append"))
            (let pmkv (dfd-mv-pipe kvty))
            (let pmqa (dfd-mv-pipe qaty))
            (let pmqb (dfd-mv-pipe qbty))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let gh (metal_buf_from_file path gabs gbytes))
            (let kvh (metal_buf_from_file path kvabs kvbytes))
            (let kvanh (metal_buf_from_file path (dfd-tabs src path "blk.0.attn_kv_a_norm.weight")
                                                 (dfd-tbytes src "blk.0.attn_kv_a_norm.weight")))
            (let qah (metal_buf_from_file path qabs qbytes))
            (let qanh (metal_buf_from_file path qanabs qanbytes))
            (let qbh (metal_buf_from_file path qbabs qbbytes))
            (let snkh (metal_buf_from_file path snkabs snkbytes))
            (let fb (metal_buf_alloc 128))
            (let xb (metal_buf_alloc (mul nembd 4)))
            (let ib (metal_buf_alloc 4))
            (let ob (metal_buf_alloc (mul nembd 4)))
            (let klb (metal_buf_alloc 2048))
            (let ib3 (metal_buf_alloc 4))
            (let klnb (metal_buf_alloc 2048))
            (let krb (metal_buf_alloc 2048))
            (let kqb (metal_buf_alloc 2048))
            (let cacheb (metal_buf_alloc (mul nr 2048)))
            (let qlb (metal_buf_alloc 4096))
            (let ib2 (metal_buf_alloc 4))
            (let qlnb (metal_buf_alloc 4096))
            (let qqb (metal_buf_alloc 131072))
            (let qhb (metal_buf_alloc 131072))
            (let qrb (metal_buf_alloc 131072))
            (let hab (metal_buf_alloc 131072))
            (print "RUNG8 handles: 12 pipelines + 8 file views + 17 device buffers on top of the chain's 54")

            ; freqs once — the table is position-independent; each rope reads it with its own pos
            (let ef (metal_enqueue pf
                (str_concat (str_concat (dfd-u32 1) (dfd-u32 fb))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64)) (dfd-u32 1176256512)))) 32))

            (let H (cons pe (cons pr (cons pa (cons pmkv (cons pro (cons pkq (cons pap
                    (cons embh (cons gh (cons kvh (cons kvanh (cons fb
                    (cons xb (cons ib (cons ob (cons klb (cons ib3 (cons klnb
                    (cons krb (cons kqb (cons cacheb 0))))))))))))))))))))))
            (let kvraw (eqr-of-file path kvabs kvbytes))
            (let recs (dfd-kvc-loop path H ids 0 eabs kvraw kvty nembd))
            (let pflag (mul (head (nth recs 0)) (mul (head (nth recs 1)) (mul (head (nth recs 2))
                       (mul (head (nth recs 3)) (head (nth recs 4)))))))

            ; the LAST token's q chain, at the last position
            (let lastid (nth ids (sub nr 1)))
            (let lastpos (sub nr 1))
            (let rowoff (mul (mul lastid nembd) 2))
            (let f0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let f1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let f2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gh))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let f3 (dfd-mv-enq pmqa qaty qah ob qlb 1024 nembd))
            (let f4 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qlb) (dfd-u32 ib2)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let f5 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 qlb) (dfd-u32 qanh))
                                                                (str_concat (dfd-u32 qlnb) (dfd-u32 ib2))))
                            (str_concat (dfd-u32 1) (dfd-u32 1024))) 1024))
            (let f6 (dfd-mv-enq pmqb qbty qbh qlnb qqb 32768 1024))
            (let f7 (metal_enqueue ph
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qqb) (dfd-u32 qhb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512)) (dfd-u32 (dfd-eps-bits))))) 64))
            (let f8 (metal_enqueue pro
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 qhb) (dfd-u32 qrb)) (dfd-u32 fb)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 (dfd-posbits lastpos)) (dfd-u32 1065353216)))))) 32768))
            ; attend over ALL nr rows of the cache — the sink in the max and in the denominator
            (let f9 (metal_enqueue pat
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 qrb) (dfd-u32 cacheb))
                                                                (str_concat (dfd-u32 hab) (dfd-u32 snkh))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 nr) (dfd-u32 1026884851))))) 64))

            (let qrraw (metal_buf_read qrb 0 131072))
            (let habraw (metal_buf_read hab 0 131072))
            (let cacheraw (metal_buf_read cacheb 0 (mul nr 2048)))
            (let snkraw (eqr-of-file path snkabs snkbytes))

            (let asm (dfd-kvc-asm cacheraw recs 0 1))
            (print (str_concat "CACHE assembly rows bit-equal = " (int_to_str asm)))

            (let scale (div 1.0 (tn-sqrt 512.0)))
            (let hl (cons 0 (cons 9 (cons 18 (cons 27 (cons 36 (cons 45 (cons 54 (cons 63 0)))))))))
            (let mdmr (dfd-a5-heads qrraw cacheraw snkraw habraw hl nr scale (cons 0.0 (cons 0.0 0))))
            (let relatt5 (div (head mdmr) (head (tail mdmr))))
            (print (str_concat "REL attend-5 8 heads (ppb)=" (float_to_str (mul relatt5 1000000000.0))))
            (print (metal_status))
            (cons pflag (cons (head (tail (nth recs 0))) (cons (head (tail (nth recs 1)))
                (cons (head (tail (nth recs 2))) (cons (head (tail (nth recs 3)))
                (cons (head (tail (nth recs 4))) (cons asm (cons relatt5
                (cons (add eabs rowoff) 0)))))))))))

    ; ═══════════════ RUNG 9: the SECOND cache — the compressor lane on the first ratio-4 layer ═════
    ; blk.2 is the first layer whose compress_ratio is nonzero (the file's own
    ; deepseek4.attention.compress_ratios array, walked by the Go arm: 0 0 4 128 4 128 ...), so it is
    ; the first layer that carries the second cache's four tensors. The RECIPE is
    ; dsv4-compressor.fk's — five-way mutation-proven at band 2047, the ratio-4 eight-candidate trap
    ; documented inside it — and the KERNEL TEXT is the same file's dcp-msl-appendix, the exact bytes
    ; the bash lane compiles into its kv unit. This cell adds only the pragma the door's options:nil
    ; compile needs, and the dispatches.
    ;
    ; THE RAW LANE ON A RATIO LAYER ROPES WITH THE COMPRESSED-BASE TABLE. ropeFreqs(il) in the oracle
    ; builds ONE freq table per layer: base 160000 (deepseek4.attention.compress_rope_freq_base) with
    ; the YaRN ramp, used by the raw k rope at TRUE pos, the q rope, AND the compressor's comp_pos
    ; rope alike. So rung 9's eight raw positions are ALSO the first witness of the YaRN table in the
    ; k chain. The scalars, each read from the file's own KV by the Go arm:
    ;     scaling.factor 16 -> fscale = 1/16 = 0.0625      original_context_length 65536
    ;     yarn_beta_fast 32, yarn_beta_slow 1              compress_rope_freq_base 160000
    ; The ramp bounds are DERIVED, then pinned: corr(beta) = nrot*ln(octx/(2*pi*beta))/(2*ln(base)),
    ; corr(32) = 15.4533 -> lo = 15, corr(1) = 24.7084 -> hi = 25. Both are far from an integer, so
    ; the f32/fp64 seam cannot move the floor/ceil. The device computes the table; the band pins
    ; freqs[0] (identity 1.0), freqs[1] (pure pow, below the ramp), freqs[20] (INSIDE the ramp,
    ; factor 0.0625*0.5 + 0.5 = 0.53125) and freqs[25] (past it, factor 0.0625) against Form fp64.
    (defn dfd-yarn-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat "#include <metal_stdlib>\nusing namespace metal;\n"
            "kernel void dfd_yarn_freqs(device float* f [[buffer(0)]], constant uint& npair [[buffer(1)]], constant uint& nrot [[buffer(2)]], constant float& base [[buffer(3)]], constant float& fscale [[buffer(4)]], constant float& lo [[buffer(5)]], constant float& hi [[buffer(6)]], uint k [[thread_position_in_grid]]) { if (k >= npair) return; float t = metal::pow(base, -2.0f * float(k) / float(nrot)); float y = (float(k) - lo) / metal::max(0.001f, hi - lo); float ramp = 1.0f - metal::min(1.0f, metal::max(0.0f, y)); f[k] = t * (fscale * (1.0f - ramp) + ramp); }")))

    ; the compressor unit and the f16 matvec, both the body's own texts, pragma prepended (note 1)
    (defn dfd-comp-msl ()
        (str_concat (dfd-msl-pragma) (str_concat (qml-msl-header) (dcp-msl-appendix))))
    (defn dfd-f16-msl ()
        (str_concat (dfd-msl-pragma) (str_concat (qml-msl-header) (dsv4-f16-matvec-body))))

    ; ── the f16 projections are checked by EXACT f32-fold EMULATION, not by an fp64 tolerance.
    ; form_dsv4_f16_matvec is one thread per row folding ASCENDING in f32 — a serial 4096-term fold
    ; whose accumulation error grows with n, and it was MEASURED here at 4499 ppb against fp64, over
    ; the 1e-6 bar that fits the tree-folded kernels. The honest response is not a looser bar: every
    ; step of that fold is exactly representable in fp64 (an f16 x f32 product is 35 mantissa bits),
    ; and fq-quant(...,23) reproduces each f32 rounding, so the fold can be emulated BIT-EXACTLY and
    ; the check upgraded to equality. This also witnesses fold ORDER and contraction: an fma where
    ; the pragma failed, or a reordered fold, lands on different bits.
    (defn dfd-fq32 (v) (if (eq v 0.0) 0.0 (fq-quant v 23)))
    (defn dfd-f16dot-sim (wraw xraw r cols j acc)
        (if (ge j cols) acc
            (dfd-f16dot-sim wraw xraw r cols (add j 1)
                (dfd-fq32 (add acc (dfd-fq32 (mul (dfd-f16at wraw (mul (add (mul r cols) j) 2))
                                                  (dfd-f32at xraw (mul j 4)))))))))
    (defn dfd-f16mv-simeq (wraw cols xraw got rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let s (dfd-f16dot-sim wraw xraw r cols 0 0.0))
                (dfd-f16mv-simeq wraw cols xraw got (tail rowsl)
                    (mul acc (if (eq s (dfd-f32at got (mul r 4))) 1 0))))))

    ; buffer read-backs as Form fp64 lists, for the recipe's state machine
    (defn dfd-f32list (s i n)
        (if (ge i n) 0 (cons (dfd-f32at s (mul i 4)) (dfd-f32list s (add i 1) n))))
    ; the ape plane as a flat Form list, widened from the FILE's own f16 bytes — the independent
    ; anchor for the bias the device's state kernel reads through its handle
    (defn dfd-f16list (s i n)
        (if (ge i n) 0 (cons (dfd-f16at s (mul i 2)) (dfd-f16list s (add i 1) n))))
    ; vector-scale relative error between a GPU row and a Form fp64 list
    (defn dfd-lst-md (got lst i acc)
        (if (eq (len lst) 0) acc
            (do (let d (abs (sub (dfd-f32at got (mul i 4)) (head lst))))
                (dfd-lst-md got (tail lst) (add i 1) (if (gt d acc) d acc)))))
    (defn dfd-lst-mr (lst acc)
        (if (eq (len lst) 0) acc
            (do (let a (abs (head lst)))
                (dfd-lst-mr (tail lst) (if (gt a acc) a acc)))))

    ; ── one position of the compressor lane, AFTER dfd-kvc-pos has run the raw lane at the same
    ; position (the comp projections read the SAME xn the raw kv projection read — buffer H14, still
    ; intact because the batch is serial and position t+1 has not started).
    ; C: 0 pf16, 1 pcstate, 2 pcpool, 3 pcshift, 4 ckvh, 5 cgth, 6 apeh, 7 cnmh,
    ;    8 ckvb, 9 cscb, 10 skvb, 11 sscb, 12 pooledb, 13 ib4, 14 nrmb, 15 crb, 16 cqb, 17 ccacheb
    ; Returns (cons st2 (projkv projsc wrec)) where wrec = 0 off-boundary, else
    ; (poolrel normrel nope tailrel roundeq cqraw).
    (defn dfd-cp9-pos (H C t st apeflat ckvw cgtw cnmw fraw)
        (do
            (let ekv (metal_enqueue (nth C 0)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth C 4)) (dfd-u32 (nth H 14))) (dfd-u32 (nth C 8))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 4096)))) 1024))
            (let esc (metal_enqueue (nth C 0)
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth C 5)) (dfd-u32 (nth H 14))) (dfd-u32 (nth C 9))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 4096)))) 1024))
            ; the ratio-4 two-lane row: the CURRENT window writes rows [ratio, 2*ratio) — row 4 + t%4.
            ; This offset is the trap dsv4-compressor.fk documents; mutation S1 removes it.
            (let est (metal_enqueue (nth C 1)
                (str_concat (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 (nth C 8)) (dfd-u32 (nth C 9)))
                                                                (str_concat (str_concat (dfd-u32 (nth C 6)) (dfd-u32 (nth C 10))) (dfd-u32 (nth C 11)))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 1024) (dfd-u32 (add 4 (mod t 4)))) (dfd-u32 (mod t 4))))) 1024))
            (let obraw (metal_buf_read (nth H 14) 0 16384))
            (let ckvraw (metal_buf_read (nth C 8) 0 4096))
            (let cscraw (metal_buf_read (nth C 9) 0 4096))
            ; sampled rows BIT-EQUAL to the exact f32-fold emulation over the file's bytes at the
            ; pinned addresses and the GPU's own xn (induction) — 1 when every sampled row matches
            (let prows (cons t (cons (add t 512) 0)))
            (let pkv (dfd-f16mv-simeq ckvw 4096 obraw ckvraw prows 1))
            (let psc (dfd-f16mv-simeq cgtw 4096 obraw cscraw prows 1))
            ; the recipe's state machine takes the GPU's OWN projections (induction — they are
            ; anchored by pkv/psc) and the ape read from the FILE, not from the device
            (let st1 (dcp-update st 4 512 t (dfd-f32list ckvraw 0 1024) (dfd-f32list cscraw 0 1024) apeflat))
            (if (eq (mod (add t 1) 4) 0)
                (do
                    (let epl (metal_enqueue (nth C 2)
                        (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth C 10)) (dfd-u32 (nth C 11))) (dfd-u32 (nth C 12))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 4)))) 512))
                    (let esh (metal_enqueue (nth C 3)
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth C 10)) (dfd-u32 (nth C 11))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 4)))) 4096))
                    (let er (metal_enqueue (nth H 1) (dfd-bind-tg
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth C 12)) (dfd-u32 (nth C 13))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
                    (let ea (metal_enqueue (nth H 2)
                        (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 (nth C 12)) (dfd-u32 (nth C 7)))
                                                                        (str_concat (dfd-u32 (nth C 14)) (dfd-u32 (nth C 13)))))
                                    (str_concat (dfd-u32 1) (dfd-u32 512))) 512))
                    ; comp_pos = t+1-ratio, rotated with the LAYER'S OWN compressed freqs (H11)
                    (let ero (metal_enqueue (nth H 4)
                        (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 (nth C 14)) (dfd-u32 (nth C 15))) (dfd-u32 (nth H 11))))
                                    (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 1) (dfd-u32 512))
                                        (str_concat (dfd-u32 64) (str_concat (dfd-u32 (dfd-posbits (sub t 3))) (dfd-u32 1065353216)))))) 512))
                    (let ekq (metal_enqueue (nth H 5) (dfd-bind-tg
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth C 15)) (dfd-u32 (nth C 16))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 512) (dfd-u32 64)))) 512 0) 512))
                    (let eap (metal_enqueue (nth H 6)
                        (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth C 16)) (dfd-u32 (nth C 17))))
                                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 (div (sub t 3) 4)) (dfd-u32 512)))) 512))
                    (let pooledraw (metal_buf_read (nth C 12) 0 2048))
                    (let nrmraw (metal_buf_read (nth C 14) 0 2048))
                    (let crraw (metal_buf_read (nth C 15) 0 2048))
                    (let cqraw (metal_buf_read (nth C 16) 0 2048))
                    ; the pool against the RECIPE in fp64 — the state evolved entirely on the Form
                    ; side, so a wrong device row index, a wrong ape column, a wrong candidate offset
                    ; or a missing shift cannot move both sides together
                    (let pref (dcp-pool st1 4 512))
                    (let poolrel (div (dfd-lst-md pooledraw pref 0 0.0) (dfd-lst-mr pref 0.0)))
                    (let normrel (dfd-rms-ref pooledraw cnmw nrmraw 512))
                    (let nope (dfd-nope-eq nrmraw crraw 0 0 0))
                    (let tailrel (div (dfd-rope-tail-md nrmraw crraw fraw 0 (dfd-posf (sub t 3)) 0 0.0)
                                      (dfd-rope-tail-mr nrmraw fraw 0 (dfd-posf (sub t 3)) 0 0.0)))
                    (let roundeq (dfd-kvq-cmp crraw cqraw 0 1.0 0))
                    (cons (dcp-shift st1 4 512)
                          (cons pkv (cons psc (cons (cons poolrel (cons normrel (cons nope (cons tailrel (cons roundeq (cons cqraw 0)))))) 0)))))
                (cons st1 (cons pkv (cons psc (cons 0 0)))))))

    (defn dfd-cp9-max2 (a b) (if (gt a b) a b))
    ; the loop: raw lane first (dfd-kvc-pos, unchanged), then the comp lane at the same position.
    ; Returns a list of (rawrec projkv projsc wrec) per position.
    (defn dfd-cp9-loop (path H C ids t st apeflat ckvw cgtw cnmw fraw eabs kvraw nembd)
        (if (eq (len ids) 0) 0
            (do (let kr (dfd-kvc-pos path H (head ids) t eabs kvraw 8 nembd))
                (let cr (dfd-cp9-pos H C t st apeflat ckvw cgtw cnmw fraw))
                (cons (cons kr (tail cr))
                      (dfd-cp9-loop path H C (tail ids) (add t 1) (head cr)
                                    apeflat ckvw cgtw cnmw fraw eabs kvraw nembd)))))

    ; comp cache row w must be bit-equal to the round's own output the moment window w closed
    (defn dfd-cp9-asm (ccraw recs w acc)
        (if (eq (len recs) 0) acc
            (do (let wrec (nth (head recs) 3))
                (if (eq (len wrec) 0)
                    (dfd-cp9-asm ccraw (tail recs) w acc)
                    (dfd-cp9-asm ccraw (tail recs) (add w 1)
                        (mul acc (if (eq (dfd-kvc-roweq ccraw (nth wrec 5) w 0 0) 512) 1 0)))))))
    (defn dfd-cp9-wfold (recs which acc)
        (if (eq (len recs) 0) acc
            (do (let wrec (nth (head recs) 3))
                (if (eq (len wrec) 0)
                    (dfd-cp9-wfold (tail recs) which acc)
                    (dfd-cp9-wfold (tail recs) which (dfd-cp9-max2 acc (nth wrec which)))))))
    (defn dfd-cp9-wmin (recs which acc)
        (if (eq (len recs) 0) acc
            (do (let wrec (nth (head recs) 3))
                (if (eq (len wrec) 0)
                    (dfd-cp9-wmin (tail recs) which acc)
                    (dfd-cp9-wmin (tail recs) which (if (lt (nth wrec which) acc) (nth wrec which) acc))))))
    (defn dfd-cp9-pfold (recs acc)
        (if (eq (len recs) 0) acc
            (dfd-cp9-pfold (tail recs) (mul acc (head (nth (head recs) 0))))))
    (defn dfd-cp9-projfold (recs acc)
        (if (eq (len recs) 0) acc
            (dfd-cp9-projfold (tail recs) (mul acc (mul (nth (head recs) 1) (nth (head recs) 2))))))
    (defn dfd-cp9-rowaddr (recs i) (head (tail (nth (nth recs i) 0))))

    (defn dfd-comp-run (path ids)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.2.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.2.attn_norm.weight"))
            (let kvabs (dfd-tabs src path "blk.2.attn_kv.weight"))
            (let kvbytes (dfd-tbytes src "blk.2.attn_kv.weight"))
            (let kvty (dfd-ttype src "blk.2.attn_kv.weight"))
            (let kvanabs (dfd-tabs src path "blk.2.attn_kv_a_norm.weight"))
            (let kvanbytes (dfd-tbytes src "blk.2.attn_kv_a_norm.weight"))
            (let qabs (dfd-tabs src path "blk.2.attn_q_a.weight"))
            (let qbytes (dfd-tbytes src "blk.2.attn_q_a.weight"))
            (let qaty (dfd-ttype src "blk.2.attn_q_a.weight"))
            (let qanabs (dfd-tabs src path "blk.2.attn_q_a_norm.weight"))
            (let qanbytes (dfd-tbytes src "blk.2.attn_q_a_norm.weight"))
            (let qbabs (dfd-tabs src path "blk.2.attn_q_b.weight"))
            (let qbbytes (dfd-tbytes src "blk.2.attn_q_b.weight"))
            (let qbty (dfd-ttype src "blk.2.attn_q_b.weight"))
            (let snkabs (dfd-tabs src path "blk.2.attn_sinks.weight"))
            (let snkbytes (dfd-tbytes src "blk.2.attn_sinks.weight"))
            (let ckvabs (dfd-tabs src path "blk.2.attn_compressor_kv.weight"))
            (let ckvbytes (dfd-tbytes src "blk.2.attn_compressor_kv.weight"))
            (let ckvty (dfd-ttype src "blk.2.attn_compressor_kv.weight"))
            (let cgtabs (dfd-tabs src path "blk.2.attn_compressor_gate.weight"))
            (let cgtbytes (dfd-tbytes src "blk.2.attn_compressor_gate.weight"))
            (let apeabs (dfd-tabs src path "blk.2.attn_compressor_ape.weight"))
            (let apebytes (dfd-tbytes src "blk.2.attn_compressor_ape.weight"))
            (let aped0 (dfd-td0 src "blk.2.attn_compressor_ape.weight"))
            (let aped1 (dfd-td1 src "blk.2.attn_compressor_ape.weight"))
            (let cnmabs (dfd-tabs src path "blk.2.attn_compressor_norm.weight"))
            (let cnmbytes (dfd-tbytes src "blk.2.attn_compressor_norm.weight"))
            (let cnmd0 (dfd-td0 src "blk.2.attn_compressor_norm.weight"))
            (let nr (len ids))
            (print (str_concat "GEOM blk2 comp ckv/cgt/ape/cnm abs=" (str_concat (int_to_str ckvabs)
                   (str_concat "/" (str_concat (int_to_str cgtabs)
                   (str_concat "/" (str_concat (int_to_str apeabs)
                   (str_concat "/" (int_to_str cnmabs)))))))))
            (print (str_concat "GEOM blk2 ape dims=" (str_concat (int_to_str aped0)
                   (str_concat "x" (str_concat (int_to_str aped1)
                   (str_concat " cnm n=" (str_concat (int_to_str cnmd0)
                   (str_concat " ckv type=" (int_to_str ckvty)))))))))
            (print (str_concat "GEOM blk2 attn_norm/kv/q_a/q_b/sinks abs=" (str_concat (int_to_str gabs)
                   (str_concat "/" (str_concat (int_to_str kvabs)
                   (str_concat "/" (str_concat (int_to_str qabs)
                   (str_concat "/" (str_concat (int_to_str qbabs)
                   (str_concat "/" (int_to_str snkabs)))))))))))

            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let ph (metal_pipeline mslm "form_mla_headrms_f32"))
            (let pro (metal_pipeline mslm "form_mla_rope_f32"))
            (let pam (metal_pipeline mslm "form_mla_attend_mixed_f32"))
            (let pf (metal_pipeline (dfd-yarn-msl) "dfd_yarn_freqs"))
            (let pkq (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par"))
            (let pap (metal_pipeline (dfd-append-msl) "dfd_kv_append"))
            (let pmkv (dfd-mv-pipe kvty))
            (let pmqa (dfd-mv-pipe qaty))
            (let pmqb (dfd-mv-pipe qbty))
            (let cmsl (dfd-comp-msl))
            (let pci (metal_pipeline cmsl "form_dsv4_comp_init_f32"))
            (let pcs (metal_pipeline cmsl "form_dsv4_comp_state_f32"))
            (let pcp (metal_pipeline cmsl "form_dsv4_comp_pool_f32"))
            (let pcsh (metal_pipeline cmsl "form_dsv4_comp_shift_f32"))
            (let pf16 (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec"))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let gh (metal_buf_from_file path gabs gbytes))
            (let kvh (metal_buf_from_file path kvabs kvbytes))
            (let kvanh (metal_buf_from_file path kvanabs kvanbytes))
            (let qah (metal_buf_from_file path qabs qbytes))
            (let qanh (metal_buf_from_file path qanabs qanbytes))
            (let qbh (metal_buf_from_file path qbabs qbbytes))
            (let snkh (metal_buf_from_file path snkabs snkbytes))
            (let ckvh (metal_buf_from_file path ckvabs ckvbytes))
            (let cgth (metal_buf_from_file path cgtabs cgtbytes))
            (let apeh (metal_buf_from_file path apeabs apebytes))
            (let cnmh (metal_buf_from_file path cnmabs cnmbytes))
            (let fb (metal_buf_alloc 128))
            (let xb (metal_buf_alloc (mul nembd 4)))
            (let ib (metal_buf_alloc 4))
            (let ob (metal_buf_alloc (mul nembd 4)))
            (let klb (metal_buf_alloc 2048))
            (let ib3 (metal_buf_alloc 4))
            (let klnb (metal_buf_alloc 2048))
            (let krb (metal_buf_alloc 2048))
            (let kqb (metal_buf_alloc 2048))
            (let cacheb (metal_buf_alloc (mul nr 2048)))
            (let ckvb (metal_buf_alloc 4096))
            (let cscb (metal_buf_alloc 4096))
            (let skvb (metal_buf_alloc 32768))
            (let sscb (metal_buf_alloc 32768))
            (let pooledb (metal_buf_alloc 2048))
            (let ib4 (metal_buf_alloc 4))
            (let nrmb (metal_buf_alloc 2048))
            (let crb (metal_buf_alloc 2048))
            (let cqb (metal_buf_alloc 2048))
            (let ccacheb (metal_buf_alloc 4096))
            (let qlb (metal_buf_alloc 4096))
            (let ib2 (metal_buf_alloc 4))
            (let qlnb (metal_buf_alloc 4096))
            (let qqb (metal_buf_alloc 131072))
            (let qhb (metal_buf_alloc 131072))
            (let qrb (metal_buf_alloc 131072))
            (let hab (metal_buf_alloc 131072))
            ; 17 pipeline requests dedupe to 15 (the three Q8_0 matvecs share one text+name);
            ; witnessed by metal_status: buffers=39 (12 nocopy file views + 27 device), pipelines=15
            (print "RUNG9 handles: 15 pipelines + 12 file views + 27 device buffers this rung (54 of 8192)")

            ; the YaRN table, computed ON the device: base 160000.0f (bits 1209810944), fscale
            ; 0.0625f (1031798784), lo 15.0f (1097859072), hi 25.0f (1103626240) — all four IEEE
            ; layouts checkable by eye; base and factor provenanced to the file's own KV above
            (let ef (metal_enqueue pf
                (str_concat (str_concat (dfd-u32 1) (dfd-u32 fb))
                            (str_concat (dfd-u32 6) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64))
                                (str_concat (str_concat (dfd-u32 1209810944) (dfd-u32 1031798784))
                                            (str_concat (dfd-u32 1097859072) (dfd-u32 1103626240)))))) 32))
            ; the comp state planes, born 0 / NEG_INF by the recipe's own init kernel
            (let ei (metal_enqueue pci
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 skvb) (dfd-u32 sscb)))
                            (str_concat (dfd-u32 1) (dfd-u32 8192))) 8192))
            (let fraw (metal_buf_read fb 0 128))
            (print (str_concat "YARN freqs[0] bits=" (int_to_str (dfd-rd32 fraw 0))))

            (let H (cons pe (cons pr (cons pa (cons pmkv (cons pro (cons pkq (cons pap
                    (cons embh (cons gh (cons kvh (cons kvanh (cons fb
                    (cons xb (cons ib (cons ob (cons klb (cons ib3 (cons klnb
                    (cons krb (cons kqb (cons cacheb 0))))))))))))))))))))))
            (let C (cons pf16 (cons pcs (cons pcp (cons pcsh
                    (cons ckvh (cons cgth (cons apeh (cons cnmh
                    (cons ckvb (cons cscb (cons skvb (cons sscb
                    (cons pooledb (cons ib4 (cons nrmb (cons crb (cons cqb (cons ccacheb 0)))))))))))))))))))
            (let kvraw (eqr-of-file path kvabs kvbytes))
            (let ckvw (eqr-of-file path ckvabs ckvbytes))
            (let cgtw (eqr-of-file path cgtabs cgtbytes))
            (let apew (eqr-of-file path apeabs apebytes))
            (let cnmw (eqr-of-file path cnmabs cnmbytes))
            (let apeflat (dfd-f16list apew 0 4096))
            (let st0 (dcp-state-new 4 512))
            (let recs (dfd-cp9-loop path H C ids 0 st0 apeflat ckvw cgtw cnmw fraw eabs kvraw nembd))

            (let pflag (dfd-cp9-pfold recs 1))
            (let projeq (dfd-cp9-projfold recs 1))
            (let poolrel (dfd-cp9-wfold recs 0 0.0))
            (let normrel (dfd-cp9-wfold recs 1 0.0))
            (let nopemin (dfd-cp9-wmin recs 2 448))
            (let tailrel (dfd-cp9-wfold recs 3 0.0))
            (let roundmin (dfd-cp9-wmin recs 4 512))
            (print (str_concat "CP9 raw pflag=" (int_to_str pflag)))
            (print (str_concat "CP9 f16 projections f32-fold bit-equal (32 rows) = " (int_to_str projeq)))
            (print (str_concat "CP9 REL pool vs recipe (ppb)=" (float_to_str (mul poolrel 1000000000.0))))
            (print (str_concat "CP9 REL comp norm (ppb)=" (float_to_str (mul normrel 1000000000.0))))
            (print (str_concat "CP9 comp rope NOPE min=" (str_concat (int_to_str nopemin) " of 448")))
            (print (str_concat "CP9 REL comp rope tails (ppb)=" (float_to_str (mul tailrel 1000000000.0))))
            (print (str_concat "CP9 comp round bit-equal min=" (str_concat (int_to_str roundmin) " of 512")))

            ; the LAST token's q chain at the last position, layer-2 tensors, the YaRN table
            (let lastid (nth ids (sub nr 1)))
            (let lastpos (sub nr 1))
            (let rowoff (mul (mul lastid nembd) 2))
            (let f0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let f1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let f2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 gh))
                                                                (str_concat (dfd-u32 ob) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let f3 (dfd-mv-enq pmqa qaty qah ob qlb 1024 nembd))
            (let f4 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qlb) (dfd-u32 ib2)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1024) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let f5 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 qlb) (dfd-u32 qanh))
                                                                (str_concat (dfd-u32 qlnb) (dfd-u32 ib2))))
                            (str_concat (dfd-u32 1) (dfd-u32 1024))) 1024))
            (let f6 (dfd-mv-enq pmqb qbty qbh qlnb qqb 32768 1024))
            (let f7 (metal_enqueue ph
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 qqb) (dfd-u32 qhb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512)) (dfd-u32 (dfd-eps-bits))))) 64))
            (let f8 (metal_enqueue pro
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 qhb) (dfd-u32 qrb)) (dfd-u32 fb)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (dfd-u32 64) (dfd-u32 512))
                                (str_concat (dfd-u32 64) (str_concat (dfd-u32 (dfd-posbits lastpos)) (dfd-u32 1065353216)))))) 32768))
            ; ONE softmax over the raw window AND the compressed rows — attend_mixed, nrows=8 ncomp=2
            (let f9 (metal_enqueue pam
                (str_concat (str_concat (dfd-u32 5) (str_concat (str_concat (str_concat (dfd-u32 qrb) (dfd-u32 cacheb))
                                                                            (str_concat (dfd-u32 ccacheb) (dfd-u32 hab)))
                                                                (dfd-u32 snkh)))
                            (str_concat (dfd-u32 5) (str_concat (str_concat (str_concat (dfd-u32 64) (dfd-u32 512)) (dfd-u32 nr))
                                                                (str_concat (dfd-u32 2) (dfd-u32 1026884851))))) 64))

            (let qrraw (metal_buf_read qrb 0 131072))
            (let habraw (metal_buf_read hab 0 131072))
            (let cacheraw (metal_buf_read cacheb 0 (mul nr 2048)))
            (let ccraw (metal_buf_read ccacheb 0 4096))
            (let snkraw (eqr-of-file path snkabs snkbytes))

            (let asm (dfd-cp9-asm ccraw recs 0 1))
            (print (str_concat "CP9 comp cache assembly rows bit-equal = " (int_to_str asm)))

            ; the fp64 mixed reference IS the multi-row reference over the CONCATENATED planes:
            ; attend_mixed folds raw rows 0..nr-1 then comp rows 0..1 in that order, which is exactly
            ; dfd-a5-heads over the 10 contiguous rows of (raw ++ comp)
            (let allrows (str_concat cacheraw ccraw))
            (let scale (div 1.0 (tn-sqrt 512.0)))
            (let hl (cons 0 (cons 21 (cons 42 (cons 63 0)))))
            (let mdmr (dfd-a5-heads qrraw allrows snkraw habraw hl (add nr 2) scale (cons 0.0 (cons 0.0 0))))
            (let relmix (div (head mdmr) (head (tail mdmr))))
            (print (str_concat "CP9 REL attend-mixed 4 heads 10 rows (ppb)=" (float_to_str (mul relmix 1000000000.0))))
            (print (metal_status))
            (cons pflag (cons projeq (cons poolrel (cons normrel (cons nopemin (cons tailrel
                (cons roundmin (cons asm (cons relmix
                (cons ckvabs (cons cgtabs (cons apeabs (cons cnmabs
                (cons gabs (cons kvabs (cons qabs (cons qbabs (cons snkabs
                (cons aped0 (cons aped1 (cons cnmd0 (cons ckvty
                (cons (dfd-rd32 fraw 0) (cons (dfd-rd32 fraw 4) (cons (dfd-rd32 fraw 80) (cons (dfd-rd32 fraw 100)
                (cons (dfd-cp9-rowaddr recs 5) (cons (dfd-cp9-rowaddr recs 6) (cons (dfd-cp9-rowaddr recs 7)
                (cons (metal_status)
                (cons (dfd-cp9-rowaddr recs 0) (cons (dfd-cp9-rowaddr recs 1) (cons (dfd-cp9-rowaddr recs 2)
                (cons (dfd-cp9-rowaddr recs 3) (cons (dfd-cp9-rowaddr recs 4) 0)))))))))))))))))))))))))))))))))))))

    ; ═══════════════ RUNG 10: the MoE — both routing regimes, the experts, the shared lane ═════════
    ; The FFN half of a layer, on the canonical imatrix file, whose expert stacks are UNIFORM and read
    ; from the file's own table (never the metadata): every layer's gate/up is IQ2_XXS (type 16)
    ; [4096 x 2048 x 256] and every down is Q2_K (type 10) [2048 x 4096 x 256] — 256 experts at ALL 43
    ; layers (dim[2] == 256 throughout; the 192-expert REAP pruning lives on the reap25 specimen, not
    ; here). Routing: blk.0-2 by the ffn_gate_tid2eid I32 table on the TOKEN id (forepick, row 867),
    ; blk.3+ by sqrt-softplus biased-top-6 (ds4.c:10665, form_dsv4_topk_weights's split twins) —
    ; NOT moe-gate.fk, whose softmax rule is a different animal (rung-9 receipt carries the probe).
    ; Scalars from the file's own KV via the Go arm: expert_used_count 6, expert_weights_scale 1.5,
    ; expert_gating_func 4, hash_layer_count 3, swiglu_clamp_exp = 10.0 at every one of 43 layers.
    ; Every kernel text is the body's own, already carried by this cell's prelude closure; this cell
    ; adds only the pragma (door note 1) and the dispatches.
    (defn dfd-ffn-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (dsv4-moe-msl-unit)
        (str_concat (dsv4-hash-select-body)
        (str_concat (dsv4-hash-probs-body)
        (str_concat (dsv4-hash-wts-body)
        (str_concat (dsv4-topk-split-body)
        (str_concat (dsv4-topk-select-tg6-body) (dom-ffn-appendix)))))))))
    ; the routed-expert units, minimal: header + that type's own proven helpers + the experts kernel.
    ; dom-iq2-experts4-body is documented bit-identical to the one-expert-at-a-time kernel (only the
    ; reads change); dom-q2k-experts-body is ds4.c:3480's own plain ASCENDING scalar sum, which is
    ; also exactly the shape a fp64 reference can fold.
    (defn dfd-iq2e-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
        (str_concat (iq2m-msl-helpers) (dom-iq2-experts4-body)))))
    (defn dfd-q2ke-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
        (str_concat (q2km-msl-helpers) (dom-q2k-experts-body)))))

    ; ── the IQ2_XXS fp64 reference: iq2xxs-dequant.fk's OWN carver (band-proven, a different text
    ; from the MSL), fed per-block byte LISTS built from the file's own bytes at the computed slice.
    (defn dfd-blist (s off n)
        (if (eq n 0) 0 (cons (str_byte_at s off) (dfd-blist s (add off 1) (sub n 1)))))
    (defn dfd-iq2dot-blk (bl xraw x0 j acc)
        (if (ge j 256) acc
            (dfd-iq2dot-blk bl xraw x0 (add j 1)
                (add acc (mul (iq2-at bl 0 j) (dfd-f32at xraw (mul (add x0 j) 4)))))))
    (defn dfd-iq2dot-row (rowraw xraw blk nblk acc)
        (if (ge blk nblk) acc
            (dfd-iq2dot-row rowraw xraw (add blk 1) nblk
                (dfd-iq2dot-blk (dfd-blist rowraw (mul blk 66) 66) xraw (mul blk 256) 0 acc))))
    ; two sampled rows per slot, both expert stacks; got index = slot*rows + r. The slice address is
    ; base + id*stride + r*rowbytes, id read from the GPU's OWN ids buffer (induction — the routing
    ; bit owns the ids), stride from the file's own byte count / 256.
    (defn dfd-iq2e-md (path base stride idsraw xraw got rows sl acc)
        (if (ge sl 6) acc
            (do (let id (dfd-rd32 idsraw (mul sl 4)))
                (let r1 sl)
                (let r2 (add (div rows 2) sl))
                (let b1 (add base (add (mul id stride) (mul r1 1056))))
                (let b2 (add base (add (mul id stride) (mul r2 1056))))
                (let d1 (abs (sub (dfd-f32at got (mul (add (mul sl rows) r1) 4))
                                  (dfd-iq2dot-row (eqr-of-file path b1 1056) xraw 0 16 0.0))))
                (let d2 (abs (sub (dfd-f32at got (mul (add (mul sl rows) r2) 4))
                                  (dfd-iq2dot-row (eqr-of-file path b2 1056) xraw 0 16 0.0))))
                (dfd-iq2e-md path base stride idsraw xraw got rows (add sl 1)
                    (if (gt d1 acc) (if (gt d2 d1) d2 d1) (if (gt d2 acc) d2 acc))))))
    (defn dfd-iq2e-mr (path base stride idsraw xraw rows sl acc)
        (if (ge sl 6) acc
            (do (let id (dfd-rd32 idsraw (mul sl 4)))
                (let b1 (add base (add (mul id stride) (mul sl 1056))))
                (let a1 (abs (dfd-iq2dot-row (eqr-of-file path b1 1056) xraw 0 16 0.0)))
                (dfd-iq2e-mr path base stride idsraw xraw rows (add sl 1) (if (gt a1 acc) a1 acc)))))
    ; the Q2_K fp64 reference: q2k-dequant.fk's carver (string-based), same sampling shape; the down
    ; kernel's x is SLOT-STRIDED (xe = x + slot*cols), mirrored here.
    (defn dfd-q2kdot-row (rowraw midraw x0 cols j acc)
        (if (ge j cols) acc
            (dfd-q2kdot-row rowraw midraw x0 cols (add j 1)
                (add acc (mul (q2k-at rowraw 0 j) (dfd-f32at midraw (mul (add x0 j) 4)))))))
    (defn dfd-q2ke-md (path base stride idsraw midraw got rows cols sl acc)
        (if (ge sl 6) acc
            (do (let id (dfd-rd32 idsraw (mul sl 4)))
                (let r1 sl)
                (let r2 (add (div rows 2) sl))
                (let rb (mul (div cols 256) 84))
                (let b1 (add base (add (mul id stride) (mul r1 rb))))
                (let b2 (add base (add (mul id stride) (mul r2 rb))))
                (let d1 (abs (sub (dfd-f32at got (mul (add (mul sl rows) r1) 4))
                                  (dfd-q2kdot-row (eqr-of-file path b1 rb) midraw (mul sl cols) cols 0 0.0))))
                (let d2 (abs (sub (dfd-f32at got (mul (add (mul sl rows) r2) 4))
                                  (dfd-q2kdot-row (eqr-of-file path b2 rb) midraw (mul sl cols) cols 0 0.0))))
                (dfd-q2ke-md path base stride idsraw midraw got rows cols (add sl 1)
                    (if (gt d1 acc) (if (gt d2 d1) d2 d1) (if (gt d2 acc) d2 acc))))))
    (defn dfd-q2ke-mr (path base stride idsraw midraw rows cols sl acc)
        (if (ge sl 6) acc
            (do (let id (dfd-rd32 idsraw (mul sl 4)))
                (let rb (mul (div cols 256) 84))
                (let b1 (add base (add (mul id stride) (mul sl rb))))
                (let a1 (abs (dfd-q2kdot-row (eqr-of-file path b1 rb) midraw (mul sl cols) cols 0 0.0)))
                (dfd-q2ke-mr path base stride idsraw midraw rows cols (add sl 1) (if (gt a1 acc) a1 acc)))))

    ; ── the router weights, EMULATED bit-for-bit: w[j] = f32(f32(p/s) * wscale) with s the ascending
    ; f32 sum of the six selected probs, floored at 2^-14 — the kernel's own expression, per step, on
    ; the GPU's OWN probs (induction; the probs bit owns them). Equality, not a tolerance.
    ; f32 DIVISION, emulated exactly. fq-quant(div p s) rounds TWICE (fp64 then f32) where the
    ; kernel's division rounds once — a double-rounding hazard that BIT this rung: blk.3's weights
    ; read 5/6 equal on the first run while blk.0's read 6/6, both from the same emulation. The
    ; correctly-rounded f32 quotient is the candidate c minimizing |p - c*s| — EXACT in fp64, because
    ; c*s is a 24x24-bit product (48 bits) and p is f32 — with a tie taken by the even mantissa
    ; (representable in 22 bits). The wrong instrument was not the tolerance this time; it was the
    ; emulation itself, and the fix is a residual argmin, not a looser bar.
    (defn dfd-f32ulp (c) (fq-pow2 (sub (fq-exponent (abs c)) 23)))
    (defn dfd-mant-even? (c) (if (eq (fq-quant c 22) c) 1 0))
    (defn dfd-resid (p s c) (abs (sub p (mul c s))))
    (defn dfd-f32div-pick (p s a b)
        (do (let ra (dfd-resid p s a))
            (let rb (dfd-resid p s b))
            (if (lt rb ra) b
                (if (eq rb ra) (if (eq (dfd-mant-even? b) 1) b a) a))))
    (defn dfd-f32div (p s)
        (if (eq p 0.0) 0.0
            (do (let c0 (dfd-fq32 (div p s)))
                (let u (dfd-f32ulp c0))
                (let cp (dfd-fq32 (add c0 u)))
                (let cm (dfd-fq32 (sub c0 u)))
                (dfd-f32div-pick p s (dfd-f32div-pick p s c0 cp) cm))))

    (defn dfd-wts-sum (probsraw idsraw j n acc)
        (if (ge j n) acc
            (dfd-wts-sum probsraw idsraw (add j 1) n
                (dfd-fq32 (add acc (dfd-f32at probsraw (mul (dfd-rd32 idsraw (mul j 4)) 4)))))))
    ; THE WEIGHT CHECK IS A DERIVED BOUND, NOT BIT EQUALITY, AND THE REASON IS THE DOOR'S DIVISION.
    ; First written as bit equality against the residual-argmin division above, it read 6/6 on blk.0
    ; and 2/6 on blk.3 — the mismatches all ONE ULP. The cause is not the emulation: this door
    ; compiles options:nil and the ORACLE's own metallibs compile with only -ffp-contract=off, so
    ; BOTH run Metal fast-math division (a reciprocal shape, <= 2.5 ulp by the MSL precision table),
    ; and a correctly-rounded reference cannot be bit-equal to it. The recorded stream's own division
    ; is this one. So the bound is DERIVED: 2.5 ulp (fast div) + 0.5 (the *wscale round) with margin
    ; -> 4 ulp of the correctly-rounded weight. The bias-in-weight asymmetry this check exists to
    ; catch sits ~1e6 ulp away; the discrimination is untouched. blk.0's first-run 6/6 was LUCK.
    (defn dfd-wts-eq (probsraw idsraw wtsraw s j n acc)
        (if (ge j n) acc
            (do (let p (dfd-f32at probsraw (mul (dfd-rd32 idsraw (mul j 4)) 4)))
                (let w (dfd-fq32 (mul (dfd-f32div p s) 1.5)))
                (let g (dfd-f32at wtsraw (mul j 4)))
                (let ok (if (le (abs (sub g w)) (mul 4.0 (dfd-f32ulp w))) 1 0))
                (if (eq ok 0)
                    (print (str_concat "WTS OUT OF BOUND slot " (str_concat (int_to_str j)
                           (str_concat " emu=" (str_concat (float_to_str w)
                           (str_concat " gpu=" (float_to_str g)))))))
                    0)
                (dfd-wts-eq probsraw idsraw wtsraw s (add j 1) n (mul acc ok)))))
    (defn dfd-wts-check (probsraw idsraw wtsraw n)
        (do (let s0 (dfd-wts-sum probsraw idsraw 0 n 0.0))
            (let s (if (lt s0 0.00006103515625) 0.00006103515625 s0))
            (dfd-wts-eq probsraw idsraw wtsraw s 0 n 1)))

    ; ── sqrt-softplus probs vs fp64, the kernel's own branch rule (z>20 pass, z<-20 exp, else
    ; ln(1+exp)) folded with tn-exp / fln / tn-sqrt — the body's own series in fp64.
    (defn dfd-softplus64 (z)
        (if (gt z 20.0) z (if (lt z -20.0) (tn-exp z) (fln (add 1.0 (tn-exp z))))))
    (defn dfd-probs-md (lraw praw i n acc)
        (if (ge i n) acc
            (do (let r (tn-sqrt (dfd-softplus64 (dfd-f32at lraw (mul i 4)))))
                (let d (abs (sub (dfd-f32at praw (mul i 4)) r)))
                (dfd-probs-md lraw praw (add i 1) n (if (gt d acc) d acc)))))
    (defn dfd-probs-mr (lraw i n acc)
        (if (ge i n) acc
            (do (let r (abs (tn-sqrt (dfd-softplus64 (dfd-f32at lraw (mul i 4))))))
                (dfd-probs-mr lraw (add i 1) n (if (gt r acc) r acc)))))

    ; ── the clamped-SwiGLU reference per element (dsv4-forward.fk's own dsv4-cl-hi/lo + ln-silu):
    (defn dfd-mid64 (g u w lim)
        (mul (mul (ln-silu (dsv4-cl-hi g lim)) (dsv4-cl-lo (dsv4-cl-hi u lim) lim)) w))
    ; sampled dims 0..31 of every slot, against the GPU's own gate/up/wts (induction)
    (defn dfd-mid-md (gateraw upraw wtsraw midraw n sl j acc)
        (if (ge sl 6) acc
            (if (ge j 32)
                (dfd-mid-md gateraw upraw wtsraw midraw n (add sl 1) 0 acc)
                (do (let o (mul (add (mul sl n) j) 4))
                    (let r (dfd-mid64 (dfd-f32at gateraw o) (dfd-f32at upraw o)
                                      (dfd-f32at wtsraw (mul sl 4)) 10.0))
                    (let d (abs (sub (dfd-f32at midraw o) r)))
                    (dfd-mid-md gateraw upraw wtsraw midraw n sl (add j 1) (if (gt d acc) d acc))))))
    (defn dfd-mid-mr (gateraw upraw wtsraw n sl j acc)
        (if (ge sl 6) acc
            (if (ge j 32)
                (dfd-mid-mr gateraw upraw wtsraw n (add sl 1) 0 acc)
                (do (let o (mul (add (mul sl n) j) 4))
                    (let r (abs (dfd-mid64 (dfd-f32at gateraw o) (dfd-f32at upraw o)
                                           (dfd-f32at wtsraw (mul sl 4)) 10.0)))
                    (dfd-mid-mr gateraw upraw wtsraw n sl (add j 1) (if (gt r acc) r acc))))))

    ; ── the reduce, EMULATED: out[d] = ascending f32 sum over the six slot planes. All 4096 dims.
    (defn dfd-red-one (partsraw d n sl acc)
        (if (ge sl 6) acc
            (dfd-red-one partsraw d n (add sl 1)
                (dfd-fq32 (add acc (dfd-f32at partsraw (mul (add (mul sl n) d) 4)))))))
    (defn dfd-red-eq (partsraw moeraw n d acc)
        (if (ge d n) acc
            (dfd-red-eq partsraw moeraw n (add d 1)
                (add acc (if (eq (dfd-red-one partsraw d n 0 0.0) (dfd-f32at moeraw (mul d 4))) 1 0)))))
    ; the final add: ffn_out[d] = f32(moe[d] + shared[d]) (scale a=1 writes moe exactly; axpy's
    ; p = 1.0*shared is exact; ONE f32 add). All 4096, equality.
    (defn dfd-add-eq (moeraw sharedraw outraw n d acc)
        (if (ge d n) acc
            (dfd-add-eq moeraw sharedraw outraw n (add d 1)
                (add acc (if (eq (dfd-fq32 (add (dfd-f32at moeraw (mul d 4)) (dfd-f32at sharedraw (mul d 4))))
                             (dfd-f32at outraw (mul d 4))) 1 0)))))

    ; ── the shared expert's Q8_0 fp64 reference over sampled rows (q80-flat-at, q8-0-msl.fk's
    ; band-proven reader — a different text from the MSL).
    (defn dfd-q80dot (wraw cols xraw r j acc)
        (if (ge j cols) acc
            (dfd-q80dot wraw cols xraw r (add j 1)
                (add acc (mul (q80-flat-at wraw 0 (add (mul r cols) j)) (dfd-f32at xraw (mul j 4)))))))
    (defn dfd-q80-md-rows (wraw cols xraw got rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let ref (dfd-q80dot wraw cols xraw r 0 0.0))
                (let d (abs (sub (dfd-f32at got (mul r 4)) ref)))
                (dfd-q80-md-rows wraw cols xraw got (tail rowsl) (if (gt d acc) d acc)))))
    (defn dfd-q80-mr-rows (wraw cols xraw rowsl acc)
        (if (eq (len rowsl) 0) acc
            (do (let r (head rowsl))
                (let a (abs (dfd-q80dot wraw cols xraw r 0 0.0)))
                (dfd-q80-mr-rows wraw cols xraw (tail rowsl) (if (gt a acc) a acc)))))

    ; ── the biased-top-k SELECTION reference: the kernel's own scan (strict >, first-index-wins,
    ; shift-down) run in Form over the GPU's OWN sc buffer — comparisons on exact f32 values, so the
    ; six chosen ids must be EQUAL, not close. The bias enters ONLY here; the weight emulation above
    ; reads probs, never sc — a kernel that weighted by the biased score fails the weight equality.
    (defn dfd-tk-take (sl n) (if (eq n 0) 0 (cons (head sl) (dfd-tk-take (tail sl) (sub n 1)))))
    (defn dfd-tk-ins (sl i si j)
        (if (eq j 0) (cons (cons i (cons si 0)) (dfd-tk-take sl (sub (len sl) 1)))
            (cons (head sl) (dfd-tk-ins (tail sl) i si (sub j 1)))))
    (defn dfd-tk-findj (sl si j)
        (if (ge j (len sl)) -1
            (do (let e (nth sl j))
                (if (lt (head e) 0) j
                    (if (gt si (head (tail e))) j (dfd-tk-findj sl si (add j 1)))))))
    (defn dfd-tk-scan (scraw i n sl)
        (if (ge i n) sl
            (do (let si (dfd-f32at scraw (mul i 4)))
                (let j (dfd-tk-findj sl si 0))
                (dfd-tk-scan scraw (add i 1) n (if (lt j 0) sl (dfd-tk-ins sl i si j))))))
    (defn dfd-tk-empty (n) (if (eq n 0) 0 (cons (cons -1 (cons 0.0 0)) (dfd-tk-empty (sub n 1)))))
    (defn dfd-tk-ideq (sl idsraw j acc)
        (if (eq (len sl) 0) acc
            (dfd-tk-ideq (tail sl) idsraw (add j 1)
                (add acc (if (eq (head (head sl)) (dfd-rd32 idsraw (mul j 4))) 1 0)))))
    ; sc bit-equality: sc[i] = f32(probs[i] + bias[i]) — one f32 add on the GPU's own probs and the
    ; FILE's own bias bytes. All 256, equality.
    (defn dfd-sc-eq (praw biasraw scraw i n acc)
        (if (ge i n) acc
            (dfd-sc-eq praw biasraw scraw (add i 1) n
                (add acc (if (eq (dfd-fq32 (add (dfd-f32at praw (mul i 4)) (dfd-f32at biasraw (mul i 4))))
                             (dfd-f32at scraw (mul i 4))) 1 0)))))

    ; shared-lane swiglu reference over dims 0..63 at w = 1
    (defn dfd-smid-md (gv uv mv j acc)
        (if (ge j 64) acc
            (do (let r (dfd-mid64 (dfd-f32at gv (mul j 4)) (dfd-f32at uv (mul j 4)) 1.0 10.0))
                (let d (abs (sub (dfd-f32at mv (mul j 4)) r)))
                (dfd-smid-md gv uv mv (add j 1) (if (gt d acc) d acc)))))
    (defn dfd-smid-mr (gv uv j acc)
        (if (ge j 64) acc
            (do (let r (abs (dfd-mid64 (dfd-f32at gv (mul j 4)) (dfd-f32at uv (mul j 4)) 1.0 10.0)))
                (dfd-smid-mr gv uv (add j 1) (if (gt r acc) r acc)))))

    (defn dfd-moe-run (path token)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let fnabs (dfd-tabs src path "blk.0.ffn_norm.weight"))
            (let fnbytes (dfd-tbytes src "blk.0.ffn_norm.weight"))
            (let giabs (dfd-tabs src path "blk.0.ffn_gate_inp.weight"))
            (let gibytes (dfd-tbytes src "blk.0.ffn_gate_inp.weight"))
            (let girows (dfd-td1 src "blk.0.ffn_gate_inp.weight"))
            (let tid2abs (dfd-tabs src path "blk.0.ffn_gate_tid2eid.weight"))
            (let tid2bytes (dfd-tbytes src "blk.0.ffn_gate_tid2eid.weight"))
            (let gxabs (dfd-tabs src path "blk.0.ffn_gate_exps.weight"))
            (let gxbytes (dfd-tbytes src "blk.0.ffn_gate_exps.weight"))
            (let gxty (dfd-ttype src "blk.0.ffn_gate_exps.weight"))
            (let gxd2 (gm-dimk src (egg-find-tensor src "blk.0.ffn_gate_exps.weight") 2))
            (let uxabs (dfd-tabs src path "blk.0.ffn_up_exps.weight"))
            (let uxbytes (dfd-tbytes src "blk.0.ffn_up_exps.weight"))
            (let dxabs (dfd-tabs src path "blk.0.ffn_down_exps.weight"))
            (let dxbytes (dfd-tbytes src "blk.0.ffn_down_exps.weight"))
            (let dxty (dfd-ttype src "blk.0.ffn_down_exps.weight"))
            (let nff (dfd-td1 src "blk.0.ffn_gate_exps.weight"))
            (let strideg (div gxbytes gxd2))
            (let strided (div dxbytes gxd2))
            (let sgabs (dfd-tabs src path "blk.0.ffn_gate_shexp.weight"))
            (let sgbytes (dfd-tbytes src "blk.0.ffn_gate_shexp.weight"))
            (let suabs (dfd-tabs src path "blk.0.ffn_up_shexp.weight"))
            (let subytes (dfd-tbytes src "blk.0.ffn_up_shexp.weight"))
            (let sdabs (dfd-tabs src path "blk.0.ffn_down_shexp.weight"))
            (let sdbytes (dfd-tbytes src "blk.0.ffn_down_shexp.weight"))
            (let sgty (dfd-ttype src "blk.0.ffn_gate_shexp.weight"))
            (let fn3abs (dfd-tabs src path "blk.3.ffn_norm.weight"))
            (let fn3bytes (dfd-tbytes src "blk.3.ffn_norm.weight"))
            (let gi3abs (dfd-tabs src path "blk.3.ffn_gate_inp.weight"))
            (let gi3bytes (dfd-tbytes src "blk.3.ffn_gate_inp.weight"))
            (let bi3abs (dfd-tabs src path "blk.3.exp_probs_b.bias"))
            (let bi3bytes (dfd-tbytes src "blk.3.exp_probs_b.bias"))
            (print (str_concat "GEOM ffn gate/up/down exps abs=" (str_concat (int_to_str gxabs)
                   (str_concat "/" (str_concat (int_to_str uxabs)
                   (str_concat "/" (str_concat (int_to_str dxabs)
                   (str_concat " types=" (str_concat (int_to_str gxty)
                   (str_concat "/" (str_concat (int_to_str dxty)
                   (str_concat " d2=" (str_concat (int_to_str gxd2)
                   (str_concat " nff=" (int_to_str nff)))))))))))))))
            (print (str_concat "GEOM strides g/d=" (str_concat (int_to_str strideg)
                   (str_concat "/" (str_concat (int_to_str strided)
                   (str_concat " gate_inp=" (str_concat (int_to_str giabs)
                   (str_concat " tid2eid=" (str_concat (int_to_str tid2abs)
                   (str_concat " ffn_norm=" (int_to_str fnabs)))))))))))
            (print (str_concat "GEOM shexp g/u/d abs=" (str_concat (int_to_str sgabs)
                   (str_concat "/" (str_concat (int_to_str suabs)
                   (str_concat "/" (str_concat (int_to_str sdabs)
                   (str_concat " blk3 gi/bias/fn=" (str_concat (int_to_str gi3abs)
                   (str_concat "/" (str_concat (int_to_str bi3abs)
                   (str_concat "/" (int_to_str fn3abs)))))))))))))

            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let fmsl (dfd-ffn-msl))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let pf16 (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec"))
            (let phsel (metal_pipeline fmsl "form_dsv4_hash_select"))
            (let phprb (metal_pipeline fmsl "form_dsv4_hash_probs"))
            (let phwts (metal_pipeline fmsl "form_dsv4_hash_wts"))
            (let ptkp (metal_pipeline fmsl "form_dsv4_topk_probs"))
            (let ptks (metal_pipeline fmsl "form_dsv4_topk_select_tg6"))
            (let pswg (metal_pipeline fmsl "form_dsv4_swiglu_f32"))
            (let pswge (metal_pipeline fmsl "form_dsv4_swiglu_experts"))
            (let pmred (metal_pipeline fmsl "form_dsv4_moe_reduce"))
            (let pscl (metal_pipeline fmsl "form_dsv4_scale_f32"))
            (let paxp (metal_pipeline fmsl "form_dsv4_axpy_f32"))
            (let piq2 (metal_pipeline (dfd-iq2e-msl) "form_dsv4_iq2_matvec_experts4"))
            (let pq2k (metal_pipeline (dfd-q2ke-msl) "form_dsv4_q2k_matvec_experts"))
            (let pq80 (dfd-mv-pipe sgty))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let fnh (metal_buf_from_file path fnabs fnbytes))
            (let gih (metal_buf_from_file path giabs gibytes))
            (let tid2h (metal_buf_from_file path tid2abs tid2bytes))
            (let gxh (metal_buf_from_file path gxabs gxbytes))
            (let uxh (metal_buf_from_file path uxabs uxbytes))
            (let dxh (metal_buf_from_file path dxabs dxbytes))
            (let sgh (metal_buf_from_file path sgabs sgbytes))
            (let suh (metal_buf_from_file path suabs subytes))
            (let sdh (metal_buf_from_file path sdabs sdbytes))
            (let fn3h (metal_buf_from_file path fn3abs fn3bytes))
            (let gi3h (metal_buf_from_file path gi3abs gi3bytes))
            (let bi3h (metal_buf_from_file path bi3abs bi3bytes))
            (let xb (metal_buf_alloc (mul nembd 4)))
            (let ib (metal_buf_alloc 4))
            (let nrmb (metal_buf_alloc (mul nembd 4)))
            (let logitsb (metal_buf_alloc 1024))
            (let idsb (metal_buf_alloc 24))
            (let wtsb (metal_buf_alloc 24))
            (let probsb (metal_buf_alloc 1024))
            (let gateb (metal_buf_alloc 49152))
            (let upb (metal_buf_alloc 49152))
            (let midb (metal_buf_alloc 49152))
            (let partsb (metal_buf_alloc 98304))
            (let moeb (metal_buf_alloc (mul nembd 4)))
            (let sgvb (metal_buf_alloc (mul nff 4)))
            (let suvb (metal_buf_alloc (mul nff 4)))
            (let smidb (metal_buf_alloc (mul nff 4)))
            (let sharedb (metal_buf_alloc (mul nembd 4)))
            (let ffnoutb (metal_buf_alloc (mul nembd 4)))
            (let logits3b (metal_buf_alloc 1024))
            (let probs3b (metal_buf_alloc 1024))
            (let sc3b (metal_buf_alloc 1024))
            (let ids3b (metal_buf_alloc 24))
            (let wts3b (metal_buf_alloc 24))
            (let clvb (metal_buf_alloc 16))
            (let club (metal_buf_alloc 16))
            (let clob (metal_buf_alloc 16))
            (print "RUNG10 handles: 15 pipeline requests (embed/rmsnorm/f16/q80 dedupe with the chain's) + 13 file views + 26 device buffers")

            ; ── blk.0, the HASH layer: embed -> ffn_norm rmsnorm -> router logits -> table read ->
            ; probs -> weights -> gate/up experts -> swiglu -> down -> reduce -> shared -> add.
            (let rowoff (mul (mul token nembd) 2))
            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let e1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 fnh))
                                                                (str_concat (dfd-u32 nrmb) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let e3 (metal_enqueue pf16
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 gih) (dfd-u32 nrmb)) (dfd-u32 logitsb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 girows) (dfd-u32 nembd)))) girows))
            (let e4 (metal_enqueue phsel
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 tid2h) (dfd-u32 idsb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 token) (dfd-u32 6)))) 6))
            (let e5 (metal_enqueue phprb (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 logitsb) (dfd-u32 probsb)))
                            (str_concat (dfd-u32 1) (dfd-u32 256))) 32 0) 256))
            ; wscale 1.5f = bits 1069547520
            (let e6 (metal_enqueue phwts
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 probsb) (dfd-u32 idsb)) (dfd-u32 wtsb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 6) (dfd-u32 1069547520)))) 1))
            (let e7 (metal_enqueue piq2 (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 gxh) (dfd-u32 nrmb))
                                                                (str_concat (dfd-u32 gateb) (dfd-u32 idsb))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 nembd))
                                                                (str_concat (dfd-u32 strideg) (dfd-u32 6)))))
                64 0) (mul 6 (mul (div nff 4) 32))))
            (let e8 (metal_enqueue piq2 (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 uxh) (dfd-u32 nrmb))
                                                                (str_concat (dfd-u32 upb) (dfd-u32 idsb))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 nembd))
                                                                (str_concat (dfd-u32 strideg) (dfd-u32 6)))))
                64 0) (mul 6 (mul (div nff 4) 32))))
            ; clamp 10.0f = bits 1092616192
            (let e9 (metal_enqueue pswge (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 gateb) (dfd-u32 upb))
                                                                (str_concat (dfd-u32 midb) (dfd-u32 wtsb))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 6)) (dfd-u32 1092616192))))
                32 0) (mul 6 nff)))
            (let e10 (metal_enqueue pq2k (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 dxh) (dfd-u32 midb))
                                                                (str_concat (dfd-u32 partsb) (dfd-u32 idsb))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 nembd) (dfd-u32 nff))
                                                                (str_concat (dfd-u32 strided) (dfd-u32 6)))))
                64 0) (mul 6 nembd)))
            (let e11 (metal_enqueue pmred (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 partsb) (dfd-u32 moeb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 6)))) 32 0) nembd))
            ; the shared lane: two Q8_0 projections off ffn_norm, swiglu at w=1, the down projection
            (let e12 (dfd-mv-enq pq80 sgty sgh nrmb sgvb nff nembd))
            (let e13 (dfd-mv-enq pq80 sgty suh nrmb suvb nff nembd))
            (let e14 (metal_enqueue pswg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 sgvb) (dfd-u32 suvb)) (dfd-u32 smidb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 1065353216)) (dfd-u32 1092616192)))) nff))
            (let e15 (dfd-mv-enq pq80 sgty sdh smidb sharedb nembd nff))
            ; SET-then-ADD, never memset (asktoll): scale a=1 defines ffn_out, axpy adds the shared
            (let e16 (metal_enqueue pscl (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 moeb) (dfd-u32 ffnoutb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1065353216) (dfd-u32 nembd)))) 32 0) nembd))
            (let e17 (metal_enqueue paxp (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 sharedb) (dfd-u32 ffnoutb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1065353216) (dfd-u32 nembd)))) 32 0) nembd))
            (print (str_concat "ENQ rung10 blk0 18 dispatches sum=" (int_to_str (add e0 (add e1 (add e2 (add e3
                (add e4 (add e5 (add e6 (add e7 (add e8 (add e9 (add e10 (add e11
                (add e12 (add e13 (add e14 (add e15 (add e16 e17))))))))))))))))))))

            ; ── the reads drain the batch; every reference below reads the GPU's ACTUAL buffers
            (let nrmraw (metal_buf_read nrmb 0 (mul nembd 4)))
            (let logitsraw (metal_buf_read logitsb 0 1024))
            (let idsraw (metal_buf_read idsb 0 24))
            (let probsraw (metal_buf_read probsb 0 1024))
            (let wtsraw (metal_buf_read wtsb 0 24))
            (let gateraw (metal_buf_read gateb 0 49152))
            (let upraw (metal_buf_read upb 0 49152))
            (let midraw (metal_buf_read midb 0 49152))
            (let partsraw (metal_buf_read partsb 0 98304))
            (let moeraw (metal_buf_read moeb 0 (mul nembd 4)))
            (let sgvraw (metal_buf_read sgvb 0 (mul nff 4)))
            (let suvraw (metal_buf_read suvb 0 (mul nff 4)))
            (let smidraw (metal_buf_read smidb 0 (mul nff 4)))
            (let sharedraw (metal_buf_read sharedb 0 (mul nembd 4)))
            (let ffnoutraw (metal_buf_read ffnoutb 0 (mul nembd 4)))

            ; router logits: the F16 serial fold, bit-equal by exact f32 emulation (rung 9's upgraded
            ; instrument) on the six SELECTED rows plus rows 0 and 255
            (let giraw (eqr-of-file path giabs gibytes))
            (let selrows (cons (dfd-rd32 idsraw 0) (cons (dfd-rd32 idsraw 4) (cons (dfd-rd32 idsraw 8)
                         (cons (dfd-rd32 idsraw 12) (cons (dfd-rd32 idsraw 16) (cons (dfd-rd32 idsraw 20)
                         (cons 0 (cons 255 0)))))))))
            (let f16eq (dfd-f16mv-simeq giraw nembd nrmraw logitsraw selrows 1))
            (print (str_concat "MOE router logits f32-fold bit-equal (8 rows) = " (int_to_str f16eq)))
            (print (str_concat "MOE hash ids = " (str_concat (int_to_str (dfd-rd32 idsraw 0))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 idsraw 4))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 idsraw 8))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 idsraw 12))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 idsraw 16))
                   (str_concat " " (int_to_str (dfd-rd32 idsraw 20))))))))))))))
            (let relprobs (div (dfd-probs-md logitsraw probsraw 0 256 0.0)
                               (dfd-probs-mr logitsraw 0 256 0.0)))
            (print (str_concat "MOE REL probs sqrt-softplus (ppb)=" (float_to_str (mul relprobs 1000000000.0))))
            (let wtseq (dfd-wts-check probsraw idsraw wtsraw 6))
            (print (str_concat "MOE weights within 4 ulp of exact (fast-math div declared) = " (int_to_str wtseq)))

            (let relgate (div (dfd-iq2e-md path gxabs strideg idsraw nrmraw gateraw nff 0 0.0)
                              (dfd-iq2e-mr path gxabs strideg idsraw nrmraw nff 0 0.0)))
            (let relup (div (dfd-iq2e-md path uxabs strideg idsraw nrmraw upraw nff 0 0.0)
                            (dfd-iq2e-mr path uxabs strideg idsraw nrmraw nff 0 0.0)))
            (print (str_concat "MOE REL iq2 gate experts 12 rows (ppb)=" (float_to_str (mul relgate 1000000000.0))))
            (print (str_concat "MOE REL iq2 up experts 12 rows (ppb)=" (float_to_str (mul relup 1000000000.0))))
            (let relmid (div (dfd-mid-md gateraw upraw wtsraw midraw nff 0 0 0.0)
                             (dfd-mid-mr gateraw upraw wtsraw nff 0 0 0.0)))
            (print (str_concat "MOE REL swiglu 6x32 (ppb)=" (float_to_str (mul relmid 1000000000.0))))
            (let reldown (div (dfd-q2ke-md path dxabs strided idsraw midraw partsraw nembd nff 0 0.0)
                              (dfd-q2ke-mr path dxabs strided idsraw midraw nembd nff 0 0.0)))
            (print (str_concat "MOE REL q2k down experts 12 rows (ppb)=" (float_to_str (mul reldown 1000000000.0))))
            (let redeq (dfd-red-eq partsraw moeraw nembd 0 0))
            (print (str_concat "MOE reduce f32-emulated bit-equal dims=" (str_concat (int_to_str redeq)
                   (str_concat " of " (int_to_str nembd)))))

            (let sgraw (eqr-of-file path sgabs sgbytes))
            (let suraw (eqr-of-file path suabs subytes))
            (let sdraw (eqr-of-file path sdabs sdbytes))
            (let shrows (cons 0 (cons 1 (cons 1000 (cons 2047 0)))))
            (let sdrows (cons 0 (cons 1 (cons 2000 (cons 4095 0)))))
            (let relsg (div (dfd-q80-md-rows sgraw nembd nrmraw sgvraw shrows 0.0)
                            (dfd-q80-mr-rows sgraw nembd nrmraw shrows 0.0)))
            (let relsu (div (dfd-q80-md-rows suraw nembd nrmraw suvraw shrows 0.0)
                            (dfd-q80-mr-rows suraw nembd nrmraw shrows 0.0)))
            (let relsd (div (dfd-q80-md-rows sdraw nff smidraw sharedraw sdrows 0.0)
                            (dfd-q80-mr-rows sdraw nff smidraw sdrows 0.0)))
            (let relsh (dfd-cp9-max2 relsg (dfd-cp9-max2 relsu relsd)))
            (print (str_concat "MOE REL shared q8_0 g/u/d 4 rows each (ppb)=" (float_to_str (mul relsh 1000000000.0))))
            ; shared swiglu at w=1 over dims 0..63
            (let relsmid (div (dfd-smid-md sgvraw suvraw smidraw 0 0.0)
                              (dfd-smid-mr sgvraw suvraw 0 0.0)))
            (print (str_concat "MOE REL shared swiglu 64 dims (ppb)=" (float_to_str (mul relsmid 1000000000.0))))
            (let addeq (dfd-add-eq moeraw sharedraw ffnoutraw nembd 0 0))
            (print (str_concat "MOE final add bit-equal dims=" (str_concat (int_to_str addeq)
                   (str_concat " of " (int_to_str nembd)))))

            ; ── the CLAMP witnessed on the device: gate = up = 12.0 (bits 1094713344) > lim = 10,
            ; w = 1. The GPU must land on the CLAMPED fp64 value and be far from the unclamped one.
            (let c1 (dfd-fill clvb 0 4 1094713344))
            (let c2 (dfd-fill club 0 4 1094713344))
            (let ec (metal_enqueue pswg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 clvb) (dfd-u32 club)) (dfd-u32 clob)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 4) (dfd-u32 1065353216)) (dfd-u32 1092616192)))) 4))
            (let clraw (metal_buf_read clob 0 16))
            (let clref (dfd-mid64 12.0 12.0 1.0 10.0))
            (let clnref (dfd-mid64 12.0 12.0 1.0 0.0))
            (let clgot (dfd-f32at clraw 0))
            (let clampok (if (lt (div (abs (sub clgot clref)) (abs clref)) 0.000001)
                             (if (gt (div (abs (sub clgot clnref)) (abs clnref)) 0.001) 1 0) 0))
            (print (str_concat "MOE clamp witness got/clamped/unclamped = " (str_concat (float_to_str clgot)
                   (str_concat "/" (str_concat (float_to_str clref) (str_concat "/" (float_to_str clnref)))))))

            ; ── blk.3, the LEARNED regime: the same activation machinery at blk.3's ffn_norm, the
            ; router logits, then sqrt-softplus probs + biased sc and the tg6 selection.
            (let f0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let f1 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let f2 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 xb) (dfd-u32 fn3h))
                                                                (str_concat (dfd-u32 nrmb) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let f3 (metal_enqueue pf16
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 gi3h) (dfd-u32 nrmb)) (dfd-u32 logits3b)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 girows) (dfd-u32 nembd)))) girows))
            (let f4 (metal_enqueue ptkp (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 logits3b) (dfd-u32 bi3h))
                                                                (str_concat (dfd-u32 probs3b) (dfd-u32 sc3b))))
                            (str_concat (dfd-u32 1) (dfd-u32 256))) 32 0) 256))
            (let f5 (metal_enqueue ptks (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 probs3b) (dfd-u32 sc3b))
                                                                (str_concat (dfd-u32 ids3b) (dfd-u32 wts3b))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 256) (dfd-u32 6)) (dfd-u32 1069547520))))
                256 0) 256))
            (let nrm3raw (metal_buf_read nrmb 0 (mul nembd 4)))
            (let logits3raw (metal_buf_read logits3b 0 1024))
            (let probs3raw (metal_buf_read probs3b 0 1024))
            (let sc3raw (metal_buf_read sc3b 0 1024))
            (let ids3raw (metal_buf_read ids3b 0 24))
            (let wts3raw (metal_buf_read wts3b 0 24))
            (let gi3raw (eqr-of-file path gi3abs gi3bytes))
            (let bi3raw (eqr-of-file path bi3abs bi3bytes))
            (let rows3 (cons 0 (cons 100 (cons 200 (cons 255 0)))))
            (let f16eq3 (dfd-f16mv-simeq gi3raw nembd nrm3raw logits3raw rows3 1))
            (let relprobs3 (div (dfd-probs-md logits3raw probs3raw 0 256 0.0)
                                (dfd-probs-mr logits3raw 0 256 0.0)))
            (let sceq3 (dfd-sc-eq probs3raw bi3raw sc3raw 0 256 0))
            (let sel3 (dfd-tk-scan sc3raw 0 256 (dfd-tk-empty 6)))
            (let seleq3 (dfd-tk-ideq sel3 ids3raw 0 0))
            (let wtseq3 (dfd-wts-check probs3raw ids3raw wts3raw 6))
            (print (str_concat "MOE blk3 topk ids = " (str_concat (int_to_str (dfd-rd32 ids3raw 0))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 ids3raw 4))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 ids3raw 8))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 ids3raw 12))
                   (str_concat " " (str_concat (int_to_str (dfd-rd32 ids3raw 16))
                   (str_concat " " (int_to_str (dfd-rd32 ids3raw 20))))))))))))))
            (print (str_concat "MOE blk3 logits bit-equal 4 rows=" (str_concat (int_to_str f16eq3)
                   (str_concat " REL probs (ppb)=" (str_concat (float_to_str (mul relprobs3 1000000000.0))
                   (str_concat " sc bit-equal=" (str_concat (int_to_str sceq3)
                   (str_concat " sel-eq=" (str_concat (int_to_str seleq3)
                   (str_concat " wts-4ulp=" (int_to_str wtseq3)))))))))))
            (print (metal_status))
            ; facts, indexed — the band pins the addresses to the Go arm's literals, the hash ids to
            ; the file's own row (read independently and pinned as literals), and the derived
            ; expert-147 slice address 14641984 + 147*2162688 = 332557120.
            (cons f16eq (cons (dfd-rd32 idsraw 0) (cons (dfd-rd32 idsraw 4) (cons (dfd-rd32 idsraw 8)
            (cons (dfd-rd32 idsraw 12) (cons (dfd-rd32 idsraw 16) (cons (dfd-rd32 idsraw 20)
            (cons tid2abs (cons relprobs (cons wtseq
            (cons relgate (cons relup (cons relmid (cons clampok
            (cons reldown (cons redeq (cons relsh (cons relsmid (cons addeq
            (cons f16eq3 (cons relprobs3 (cons sceq3 (cons seleq3 (cons wtseq3
            (cons gxabs (cons uxabs (cons dxabs (cons giabs (cons fnabs
            (cons sgabs (cons suabs (cons sdabs
            (cons gi3abs (cons bi3abs (cons fn3abs
            (cons gxty (cons dxty (cons gxd2 (cons nff
            (cons (add eabs rowoff)
            (cons (add gxabs (mul (dfd-rd32 idsraw 0) strideg))
            (cons strideg (cons strided
            (cons (metal_status) 0))))))))))))))))))))))))))))))))))))))))))))))

    ; ═══════════════ RUNG 11: the hyper-connection frame — broadcast, split, Sinkhorn, wsum, post ══
    ; HC is the residual stream of this model: there is no plain residual anywhere in it. The kernels
    ; are dsv4-hc-msl.fk's own (the same texts the bash lane compiles), the fp64 recipe is
    ; dsv4-hc.fk's (band 63, proven against an independent ds4.c transcription to 1e-9). Real
    ; weights: blk.0's hc_attn_fn [16384 x 24] F16, hc_attn_scale [3] F32, hc_attn_base [24] F32.
    ; The block_out fed to hc_post here is the embedded row itself — a real vector through a proven
    ; step, DECLARED as a stand-in: the real wiring (MLA out -> hc_post) is the single-layer rung's.
    ; HC_ITERS = 20 and HC_EPS = f32(1e-6) — the oracle's own scalars (metal_dsv4_stack.sh:238).
    (defn dfd-slice-msl ()
        (str_concat (dfd-msl-pragma)
        (str_concat (qml-msl-header)
            "kernel void dfd_slice(device const float* src [[buffer(0)]], device float* dst [[buffer(1)]], constant uint& off [[buffer(2)]], constant uint& n [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i < n) dst[i] = src[off + i]; }")))
    (defn dfd-hc-msl () (str_concat (dfd-msl-pragma) (hc-msl-unit)))

    ; broadcast is a copy and is checked as a copy: out[h*n+d] must be bit-equal to x[d], all 4*4096
    (defn dfd-bc-eq (xraw outraw g n acc)
        (if (ge g (mul 4 n)) acc
            (dfd-bc-eq xraw outraw (add g 1) n
                (add acc (if (eq (dfd-rd32 outraw (mul g 4)) (dfd-rd32 xraw (mul (mod g n) 4))) 1 0)))))
    ; the no-weight rmsnorm in fp64 (inv from the body's own fold; the wide kernel's tree fold and
    ; fast-math division land at rounding scale, judged against the vector's scale)
    (defn dfd-nw-md (xraw outraw inv i n acc)
        (if (ge i n) acc
            (do (let d (abs (sub (dfd-f32at outraw (mul i 4)) (mul (dfd-f32at xraw (mul i 4)) inv))))
                (dfd-nw-md xraw outraw inv (add i 1) n (if (gt d acc) d acc)))))
    (defn dfd-nw-mr (xraw inv i n acc)
        (if (ge i n) acc
            (do (let r (abs (mul (dfd-f32at xraw (mul i 4)) inv)))
                (dfd-nw-mr xraw inv (add i 1) n (if (gt r acc) r acc)))))
    ; wsum, emulated bit-exactly: acc = fq32(acc + fq32(stream*w)) ascending over the 4 streams
    (defn dfd-wsum-one (residraw splitraw d n h acc)
        (if (ge h 4) acc
            (dfd-wsum-one residraw splitraw d n (add h 1)
                (dfd-fq32 (add acc (dfd-fq32 (mul (dfd-f32at residraw (mul (add (mul h n) d) 4))
                                                  (dfd-f32at splitraw (mul h 4)))))))))
    (defn dfd-wsum-eq (residraw splitraw curraw n d acc)
        (if (ge d n) acc
            (dfd-wsum-eq residraw splitraw curraw n (add d 1)
                (add acc (if (eq (dfd-wsum-one residraw splitraw d n 0 0.0)
                             (dfd-f32at curraw (mul d 4))) 1 0)))))
    ; hc_post, emulated bit-exactly, INCLUDING the transpose read comb[dst + src*n_hc] (ds4.c:9786):
    ; the ascending src fold, then block_out[d]*post[dst] + acc — one mul, one add, each rounds once
    (defn dfd-post-acc (combraw residraw dst d n src acc)
        (if (ge src 4) acc
            (dfd-post-acc combraw residraw dst d n (add src 1)
                (dfd-fq32 (add acc (dfd-fq32 (mul (dfd-f32at combraw (mul (add dst (mul src 4)) 4))
                                                  (dfd-f32at residraw (mul (add (mul src n) d) 4)))))))))
    (defn dfd-post-eq (blockraw residraw postraw combraw outraw n g acc)
        (if (ge g (mul 4 n)) acc
            (do (let dst (div g n))
                (let d (mod g n))
                (let ref (dfd-fq32 (add (dfd-fq32 (mul (dfd-f32at blockraw (mul d 4))
                                                       (dfd-f32at postraw (mul dst 4))))
                                        (dfd-post-acc combraw residraw dst d n 0 0.0))))
                (dfd-post-eq blockraw residraw postraw combraw outraw n (add g 1)
                    (add acc (if (eq ref (dfd-f32at outraw (mul g 4))) 1 0))))))
    ; a slice is a copy and is checked as a copy
    (defn dfd-slice-eq (splitraw sliceraw off n i acc)
        (if (ge i n) acc
            (dfd-slice-eq splitraw sliceraw off n (add i 1)
                (mul acc (if (eq (dfd-rd32 sliceraw (mul i 4)) (dfd-rd32 splitraw (mul (add off i) 4))) 1 0)))))
    (defn dfd-iota (i n) (if (ge i n) 0 (cons i (dfd-iota (add i 1) n))))

    (defn dfd-hc-run (path token)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let hafabs (dfd-tabs src path "blk.0.hc_attn_fn.weight"))
            (let hafbytes (dfd-tbytes src "blk.0.hc_attn_fn.weight"))
            (let hafd0 (dfd-td0 src "blk.0.hc_attn_fn.weight"))
            (let hafd1 (dfd-td1 src "blk.0.hc_attn_fn.weight"))
            (let hafty (dfd-ttype src "blk.0.hc_attn_fn.weight"))
            (let hasabs (dfd-tabs src path "blk.0.hc_attn_scale.weight"))
            (let hasbytes (dfd-tbytes src "blk.0.hc_attn_scale.weight"))
            (let habsabs (dfd-tabs src path "blk.0.hc_attn_base.weight"))
            (let habsbytes (dfd-tbytes src "blk.0.hc_attn_base.weight"))
            (let hffabs (dfd-tabs src path "blk.0.hc_ffn_fn.weight"))
            (let hfsabs (dfd-tabs src path "blk.0.hc_ffn_scale.weight"))
            (let hfbabs (dfd-tabs src path "blk.0.hc_ffn_base.weight"))
            (print (str_concat "GEOM hc_attn fn/scale/base abs=" (str_concat (int_to_str hafabs)
                   (str_concat "/" (str_concat (int_to_str hasabs)
                   (str_concat "/" (str_concat (int_to_str habsabs)
                   (str_concat " fn dims=" (str_concat (int_to_str hafd0)
                   (str_concat "x" (str_concat (int_to_str hafd1)
                   (str_concat " type=" (int_to_str hafty)))))))))))))
            (print (str_concat "GEOM hc_ffn fn/scale/base abs=" (str_concat (int_to_str hffabs)
                   (str_concat "/" (str_concat (int_to_str hfsabs)
                   (str_concat "/" (int_to_str hfbabs)))))))

            (let hmsl (dfd-hc-msl))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pbc (metal_pipeline hmsl "form_hc_broadcast_f32"))
            (let pnw (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32"))
            (let pf16 (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec"))
            (let psq4 (metal_pipeline hmsl "form_hc_split_seq4_f32"))
            (let pwsum (metal_pipeline hmsl "form_hc_wsum_f32"))
            (let ppost (metal_pipeline hmsl "form_hc_post_f32"))
            (let pslc (metal_pipeline (dfd-slice-msl) "dfd_slice"))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let hafh (metal_buf_from_file path hafabs hafbytes))
            (let hash (metal_buf_from_file path hasabs hasbytes))
            (let habh (metal_buf_from_file path habsabs habsbytes))
            (let xb (metal_buf_alloc (mul nembd 4)))
            (let residb (metal_buf_alloc (mul (mul 4 nembd) 4)))
            (let flatb (metal_buf_alloc (mul (mul 4 nembd) 4)))
            (let mixb (metal_buf_alloc 96))
            (let splitb (metal_buf_alloc 96))
            (let postb (metal_buf_alloc 16))
            (let combb (metal_buf_alloc 64))
            (let curb (metal_buf_alloc (mul nembd 4)))
            (let hcoutb (metal_buf_alloc (mul (mul 4 nembd) 4)))
            (print "RUNG11 handles: 8 pipeline requests (embed/f16 dedupe) + 4 file views + 9 device buffers")

            (let rowoff (mul (mul token nembd) 2))
            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let e1 (metal_enqueue pbc
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 residb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) (mul 4 nembd)))
            ; the wide norm: ONE 1024-thread group striding the 16384-wide row (the oracle's own shape)
            (let e2 (metal_enqueue pnw (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 residb) (dfd-u32 flatb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 (mul 4 nembd)) (dfd-u32 (dfd-eps-bits))))) 1024 0) 1024))
            (let e3 (metal_enqueue pf16
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 hafh) (dfd-u32 flatb)) (dfd-u32 mixb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 hafd1) (dfd-u32 (mul 4 nembd))))) hafd1))
            ; the split: sigmoid pre/post + the 20-iteration Sinkhorn, one thread, iters a RUNTIME
            ; uniform (an unrun iteration is not a computed zero — edgedrop)
            (let e4 (metal_enqueue psq4
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 mixb) (dfd-u32 hash))
                                                                (str_concat (dfd-u32 habh) (dfd-u32 splitb))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 4) (dfd-u32 20)) (dfd-u32 (dfd-eps-bits))))) 1))
            ; post/comb slices for hc_post — the door binds handles at fixed offsets, so a slice is
            ; an explicit COPY dispatch, checked as a copy
            (let e5 (metal_enqueue pslc
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 splitb) (dfd-u32 postb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 4)))) 4))
            (let e6 (metal_enqueue pslc
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 splitb) (dfd-u32 combb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 8) (dfd-u32 16)))) 16))
            (let e7 (metal_enqueue pwsum
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 residb) (dfd-u32 splitb)) (dfd-u32 curb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) nembd))
            (let e8 (metal_enqueue ppost
                (str_concat (str_concat (dfd-u32 5) (str_concat (str_concat (str_concat (dfd-u32 xb) (dfd-u32 residb))
                                                                            (str_concat (dfd-u32 postb) (dfd-u32 combb)))
                                                                (dfd-u32 hcoutb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) (mul 4 nembd)))
            (print (str_concat "ENQ rung11 9 dispatches sum=" (int_to_str (add e0 (add e1 (add e2 (add e3
                (add e4 (add e5 (add e6 (add e7 e8)))))))))))

            (let xraw (metal_buf_read xb 0 (mul nembd 4)))
            (let residraw (metal_buf_read residb 0 (mul (mul 4 nembd) 4)))
            (let flatraw (metal_buf_read flatb 0 (mul (mul 4 nembd) 4)))
            (let mixraw (metal_buf_read mixb 0 96))
            (let splitraw (metal_buf_read splitb 0 96))
            (let postraw (metal_buf_read postb 0 16))
            (let combraw (metal_buf_read combb 0 64))
            (let curraw (metal_buf_read curb 0 (mul nembd 4)))
            (let hcoutraw (metal_buf_read hcoutb 0 (mul (mul 4 nembd) 4)))

            (let bceq (dfd-bc-eq xraw residraw 0 nembd 0))
            (print (str_concat "HC broadcast bit-equal=" (str_concat (int_to_str bceq)
                   (str_concat " of " (int_to_str (mul 4 nembd))))))
            (let ss (dfd-sumsq-f32 residraw 0 (mul 4 nembd) 0.0))
            (let inv (div 1.0 (tn-sqrt (add (div ss (mul 4 nembd)) (fd-value (dfd-eps-bits) 8 23)))))
            (let relnw (div (dfd-nw-md residraw flatraw inv 0 (mul 4 nembd) 0.0)
                            (dfd-nw-mr residraw inv 0 (mul 4 nembd) 0.0)))
            (print (str_concat "HC REL rmsnorm-nw wide (ppb)=" (float_to_str (mul relnw 1000000000.0))))
            (let hafraw (eqr-of-file path hafabs hafbytes))
            (let fneq (dfd-f16mv-simeq hafraw (mul 4 nembd) flatraw mixraw (dfd-iota 0 hafd1) 1))
            (print (str_concat "HC fn matvec f32-fold bit-equal (24 rows)=" (int_to_str fneq)))
            ; the split vs the RECIPE (dsv4-hc.fk, band 63) in fp64: mix from the GPU (anchored by the
            ; fn bit), scale and base from the FILE's own bytes at the pinned addresses
            (let hasraw (eqr-of-file path hasabs hasbytes))
            (let habraw (eqr-of-file path habsabs habsbytes))
            (let sref (hc-split-flat (hc-split (dfd-f32list mixraw 0 24)
                                              (dfd-f32list hasraw 0 3)
                                              (dfd-f32list habraw 0 24)
                                              4 20 (fd-value (dfd-eps-bits) 8 23))))
            (let relsplit (div (dfd-lst-md splitraw sref 0 0.0) (dfd-lst-mr sref 0.0)))
            (print (str_concat "HC REL split+sinkhorn20 vs recipe (ppb)=" (float_to_str (mul relsplit 1000000000.0))))
            (let sliceeq (mul (dfd-slice-eq splitraw postraw 4 4 0 1)
                              (dfd-slice-eq splitraw combraw 8 16 0 1)))
            (print (str_concat "HC post/comb slices bit-equal=" (int_to_str sliceeq)))
            (let wsumeq (dfd-wsum-eq residraw splitraw curraw nembd 0 0))
            (print (str_concat "HC wsum f32-emulated bit-equal dims=" (str_concat (int_to_str wsumeq)
                   (str_concat " of " (int_to_str nembd)))))
            (let posteq (dfd-post-eq xraw residraw postraw combraw hcoutraw nembd 0 0))
            (print (str_concat "HC post f32-emulated bit-equal (transpose read)=" (str_concat (int_to_str posteq)
                   (str_concat " of " (int_to_str (mul 4 nembd))))))
            (print (metal_status))
            (cons bceq (cons relnw (cons fneq (cons relsplit (cons sliceeq (cons wsumeq (cons posteq
                (cons hafabs (cons hasabs (cons habsabs (cons hffabs (cons hfsabs (cons hfbabs
                (cons hafd0 (cons hafd1 (cons hafty
                (cons (add eabs rowoff) (cons (metal_status) 0))))))))))))))))))))

    ; ═══════════════ RUNG 12: the EXIT HEAD — hc collapse -> output_norm -> output.weight -> argmax ═
    ; The oracle's nativeExitHead, dispatch for dispatch: rmsnorm_nw over the four streams -> the
    ; output_hc_fn F16 matvec (4 rows) -> headw (sigmoid weights) -> wsum collapse -> output_norm
    ; rmsnorm -> the Q8_0 unembedding [4096 -> 129280] -> argmax. The residual fed here is
    ; broadcast(embed) — a real vector through proven steps, DECLARED as a stand-in exactly as rung
    ; 11 declares its block_out: this rung owns the HEAD's arithmetic; the model's actual argmax
    ; belongs to the stacked rungs and is NOT claimed here.
    (defn dfd-headw-md (preraw scraw bsraw hwraw i acc)
        (if (ge i 4) acc
            (do (let z (add (mul (dfd-f32at preraw (mul i 4)) (dfd-f32at scraw 0))
                            (dfd-f32at bsraw (mul i 4))))
                (let r (add (div 1.0 (add 1.0 (tn-exp (sub 0.0 z)))) (fd-value (dfd-eps-bits) 8 23)))
                (let d (abs (sub (dfd-f32at hwraw (mul i 4)) r)))
                (dfd-headw-md preraw scraw bsraw hwraw (add i 1) (if (gt d acc) d acc)))))
    (defn dfd-headw-mr (preraw scraw bsraw i acc)
        (if (ge i 4) acc
            (do (let z (add (mul (dfd-f32at preraw (mul i 4)) (dfd-f32at scraw 0))
                            (dfd-f32at bsraw (mul i 4))))
                (let r (abs (add (div 1.0 (add 1.0 (tn-exp (sub 0.0 z)))) (fd-value (dfd-eps-bits) 8 23))))
                (dfd-headw-mr preraw scraw bsraw (add i 1) (if (gt r acc) r acc)))))
    ; Form argmax over the GPU's logits: exact f32 comparisons, ties to the LOWEST index (strict >)
    (defn dfd-argmax-go (lraw i n bi bv)
        (if (ge i n) (cons bi (cons bv 0))
            (do (let v (dfd-f32at lraw (mul i 4)))
                (if (gt v bv) (dfd-argmax-go lraw (add i 1) n i v)
                    (dfd-argmax-go lraw (add i 1) n bi bv)))))
    ; the runner-up, for the tie margin the stream rung will need
    (defn dfd-arg2-go (lraw i n skip bi bv)
        (if (ge i n) (cons bi (cons bv 0))
            (do (let v (dfd-f32at lraw (mul i 4)))
                (if (eq i skip) (dfd-arg2-go lraw (add i 1) n skip bi bv)
                    (if (gt v bv) (dfd-arg2-go lraw (add i 1) n skip i v)
                        (dfd-arg2-go lraw (add i 1) n skip bi bv))))))

    (defn dfd-exit-run (path token)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let ohfabs (dfd-tabs src path "output_hc_fn.weight"))
            (let ohfbytes (dfd-tbytes src "output_hc_fn.weight"))
            (let ohfd0 (dfd-td0 src "output_hc_fn.weight"))
            (let ohfd1 (dfd-td1 src "output_hc_fn.weight"))
            (let ohsabs (dfd-tabs src path "output_hc_scale.weight"))
            (let ohsbytes (dfd-tbytes src "output_hc_scale.weight"))
            (let ohbabs (dfd-tabs src path "output_hc_base.weight"))
            (let ohbbytes (dfd-tbytes src "output_hc_base.weight"))
            (let onabs (dfd-tabs src path "output_norm.weight"))
            (let onbytes (dfd-tbytes src "output_norm.weight"))
            (let owabs (dfd-tabs src path "output.weight"))
            (let owbytes (dfd-tbytes src "output.weight"))
            (let owty (dfd-ttype src "output.weight"))
            (let vocab (dfd-td1 src "output.weight"))
            (print (str_concat "GEOM exit ohf/ohs/ohb abs=" (str_concat (int_to_str ohfabs)
                   (str_concat "/" (str_concat (int_to_str ohsabs)
                   (str_concat "/" (str_concat (int_to_str ohbabs)
                   (str_concat " fn dims=" (str_concat (int_to_str ohfd0)
                   (str_concat "x" (int_to_str ohfd1)))))))))))
            (print (str_concat "GEOM exit onorm/oweight abs=" (str_concat (int_to_str onabs)
                   (str_concat "/" (str_concat (int_to_str owabs)
                   (str_concat " ow type=" (str_concat (int_to_str owty)
                   (str_concat " vocab=" (int_to_str vocab)))))))))

            (let hmsl (dfd-hc-msl))
            (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
            (let pe (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
            (let pbc (metal_pipeline hmsl "form_hc_broadcast_f32"))
            (let pnw (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32"))
            (let pf16 (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec"))
            (let phw (metal_pipeline hmsl "form_hc_headw_f32"))
            (let pwsum (metal_pipeline hmsl "form_hc_wsum_f32"))
            (let pr (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
            (let pa (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
            (let pq80 (dfd-mv-pipe owty))

            (let embh (metal_buf_from_file path eabs ebytes))
            (let ohfh (metal_buf_from_file path ohfabs ohfbytes))
            (let ohsh (metal_buf_from_file path ohsabs ohsbytes))
            (let ohbh (metal_buf_from_file path ohbabs ohbbytes))
            (let onh (metal_buf_from_file path onabs onbytes))
            (let owh (metal_buf_from_file path owabs owbytes))
            (let xb (metal_buf_alloc (mul nembd 4)))
            (let residb (metal_buf_alloc (mul (mul 4 nembd) 4)))
            (let flatb (metal_buf_alloc (mul (mul 4 nembd) 4)))
            (let preb (metal_buf_alloc 16))
            (let hwb (metal_buf_alloc 16))
            (let collb (metal_buf_alloc (mul nembd 4)))
            (let ib (metal_buf_alloc 4))
            (let normedb (metal_buf_alloc (mul nembd 4)))
            (let logitsb (metal_buf_alloc (mul vocab 4)))
            (print "RUNG12 handles: 9 pipeline requests (most dedupe) + 6 file views + 9 device buffers")

            (let rowoff (mul (mul token nembd) 2))
            (let e0 (metal_enqueue pe
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 embh) (dfd-u32 xb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 rowoff) (dfd-u32 nembd)))) nembd))
            (let e1 (metal_enqueue pbc
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 xb) (dfd-u32 residb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) (mul 4 nembd)))
            (let e2 (metal_enqueue pnw (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 residb) (dfd-u32 flatb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 (mul 4 nembd)) (dfd-u32 (dfd-eps-bits))))) 1024 0) 1024))
            (let e3 (metal_enqueue pf16
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 ohfh) (dfd-u32 flatb)) (dfd-u32 preb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 ohfd1) (dfd-u32 (mul 4 nembd))))) ohfd1))
            (let e4 (metal_enqueue phw
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 preb) (dfd-u32 ohsh))
                                                                (str_concat (dfd-u32 ohbh) (dfd-u32 hwb))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 (dfd-eps-bits))))) 4))
            (let e5 (metal_enqueue pwsum
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 residb) (dfd-u32 hwb)) (dfd-u32 collb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) nembd))
            (let e6 (metal_enqueue pr (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 collb) (dfd-u32 ib)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 (dfd-eps-bits))))) 32 0) 32))
            (let e7 (metal_enqueue pa
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 collb) (dfd-u32 onh))
                                                                (str_concat (dfd-u32 normedb) (dfd-u32 ib))))
                            (str_concat (dfd-u32 1) (dfd-u32 nembd))) nembd))
            (let e8 (dfd-mv-enq pq80 owty owh normedb logitsb vocab nembd))
            (print (str_concat "ENQ rung12 9 dispatches sum=" (int_to_str (add e0 (add e1 (add e2 (add e3
                (add e4 (add e5 (add e6 (add e7 e8)))))))))))

            (let residraw (metal_buf_read residb 0 (mul (mul 4 nembd) 4)))
            (let flatraw (metal_buf_read flatb 0 (mul (mul 4 nembd) 4)))
            (let preraw (metal_buf_read preb 0 16))
            (let hwraw (metal_buf_read hwb 0 16))
            (let collraw (metal_buf_read collb 0 (mul nembd 4)))
            (let ivraw (metal_buf_read ib 0 4))
            (let normedraw (metal_buf_read normedb 0 (mul nembd 4)))
            (let logitsraw (metal_buf_read logitsb 0 (mul vocab 4)))

            (let ss (dfd-sumsq-f32 residraw 0 (mul 4 nembd) 0.0))
            (let inv (div 1.0 (tn-sqrt (add (div ss (mul 4 nembd)) (fd-value (dfd-eps-bits) 8 23)))))
            (let relnw (div (dfd-nw-md residraw flatraw inv 0 (mul 4 nembd) 0.0)
                            (dfd-nw-mr residraw inv 0 (mul 4 nembd) 0.0)))
            (print (str_concat "EXIT REL rmsnorm-nw (ppb)=" (float_to_str (mul relnw 1000000000.0))))
            (let ohfraw (eqr-of-file path ohfabs ohfbytes))
            (let preeq (dfd-f16mv-simeq ohfraw (mul 4 nembd) flatraw preraw (dfd-iota 0 ohfd1) 1))
            (print (str_concat "EXIT pre matvec f32-fold bit-equal (4 rows)=" (int_to_str preeq)))
            (let ohsraw (eqr-of-file path ohsabs ohsbytes))
            (let ohbraw (eqr-of-file path ohbabs ohbbytes))
            (let relhw (div (dfd-headw-md preraw ohsraw ohbraw hwraw 0 0.0)
                            (dfd-headw-mr preraw ohsraw ohbraw 0 0.0)))
            (print (str_concat "EXIT REL headw sigmoid (ppb)=" (float_to_str (mul relhw 1000000000.0))))
            (let colleq (dfd-wsum-eq residraw hwraw collraw nembd 0 0))
            (print (str_concat "EXIT collapse wsum bit-equal dims=" (str_concat (int_to_str colleq)
                   (str_concat " of " (int_to_str nembd)))))
            ; output_norm: rung-2's own reference machinery over the GPU's collapsed vector
            (let onraw (eqr-of-file path onabs onbytes))
            (let inv2 (dfd-f32at ivraw 0))
            (let refms (div (dfd-sumsq-f32 collraw 0 nembd 0.0) nembd))
            (let impms (sub (div 1.0 (mul inv2 inv2)) (fd-value (dfd-eps-bits) 8 23)))
            (let relred (div (abs (sub impms refms)) refms))
            (let relon (dfd-rms-ref collraw onraw normedraw nembd))
            (print (str_concat "EXIT REL output_norm reduce/apply (ppb)=" (str_concat
                   (float_to_str (mul relred 1000000000.0))
                   (str_concat "/" (float_to_str (mul relon 1000000000.0))))))
            ; the unembedding at eight sampled rows INCLUDING the argmax row and the runner-up
            (let am (dfd-argmax-go logitsraw 0 vocab 0 (dfd-f32at logitsraw 0)))
            (let am2 (dfd-arg2-go logitsraw 0 vocab (head am) 0 (sub (dfd-f32at logitsraw 0) 1000000.0)))
            (let owraw (eqr-of-file path owabs owbytes))
            (let lrows (cons (head am) (cons (head am2) (cons 0 (cons 1 (cons 64639 (cons 64640
                       (cons 129278 (cons 129279 0)))))))))
            (let rellog (div (dfd-q80-md-rows owraw nembd normedraw logitsraw lrows 0.0)
                             (dfd-q80-mr-rows owraw nembd normedraw lrows 0.0)))
            (print (str_concat "EXIT REL logits 8 rows (ppb)=" (float_to_str (mul rellog 1000000000.0))))
            (print (str_concat "EXIT head-on-embedding argmax id/logit=" (str_concat (int_to_str (head am))
                   (str_concat "/" (str_concat (float_to_str (head (tail am)))
                   (str_concat "  runner-up " (str_concat (int_to_str (head am2))
                   (str_concat "/" (float_to_str (head (tail am2)))))))))))
            (print (metal_status))
            (cons relnw (cons preeq (cons relhw (cons colleq (cons relred (cons relon (cons rellog
                (cons (head am) (cons (head am2)
                (cons ohfabs (cons ohsabs (cons ohbabs (cons onabs (cons owabs
                (cons owty (cons vocab (cons ohfd0 (cons ohfd1
                (cons (add eabs rowoff) (cons (metal_status) 0))))))))))))))))))))))

    ; ═══════════════ RUNG 13: ONE COMPLETE LAYER, END TO END, at one position ═══════════════
    ; blk.0 at pos 0 for token 671, every stage wired the way the oracle wires it: broadcast ->
    ; hcPre(attn) -> MLA (rungs 4-7's chain, input = the hc-reduced stream, growing cache nrows=1)
    ; -> hcPost -> hcPre(ffn) -> ffn_norm -> MoE + shared (rung 10) -> hcPost. No stage input is a
    ; stand-in any more; every seam is checked by the reference machinery the earlier rungs proved,
    ; reading the GPU's ACTUAL upstream buffers (induction).
    (defn dfd-layer-run (path token)
        (do
            (let src (dfd-src path))
            (let nembd (dfd-td0 src "token_embd.weight"))
            (let eabs (dfd-tabs src path "token_embd.weight"))
            (let ebytes (dfd-tbytes src "token_embd.weight"))
            (let gabs (dfd-tabs src path "blk.0.attn_norm.weight"))
            (let gbytes (dfd-tbytes src "blk.0.attn_norm.weight"))
            (let qabs (dfd-tabs src path "blk.0.attn_q_a.weight"))
            (let qbytes (dfd-tbytes src "blk.0.attn_q_a.weight"))
            (let qaty (dfd-ttype src "blk.0.attn_q_a.weight"))
            (let kvabs (dfd-tabs src path "blk.0.attn_kv.weight"))
            (let kvbytes (dfd-tbytes src "blk.0.attn_kv.weight"))
            (let qanabs (dfd-tabs src path "blk.0.attn_q_a_norm.weight"))
            (let qanbytes (dfd-tbytes src "blk.0.attn_q_a_norm.weight"))
            (let kvanabs (dfd-tabs src path "blk.0.attn_kv_a_norm.weight"))
