            (let g8 (metal_enqueue pswge (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 gateb) (dfd-u32 upb))
                                                                (str_concat (dfd-u32 midb) (dfd-u32 wtsb))))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 6)) (dfd-u32 1092616192))))
                32 0) 12288))
            (let g9 (metal_enqueue pq2k (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 dxh) (dfd-u32 midb))
                                                                (str_concat (dfd-u32 partsb) (dfd-u32 idsb))))
                            (str_concat (dfd-u32 4) (str_concat (str_concat (dfd-u32 nembd) (dfd-u32 nff))
                                                                (str_concat (dfd-u32 strided) (dfd-u32 6)))))
                64 0) 24576))
            (let g10 (metal_enqueue pmred (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 partsb) (dfd-u32 moeb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 nembd) (dfd-u32 6)))) 32 0) nembd))
            (let g11 (dfd-mv-enq pmv sgty sgh fnrmb sgvb nff nembd))
            (let g12 (dfd-mv-enq pmv sgty suh fnrmb suvb nff nembd))
            (let g13 (metal_enqueue pswg
                (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 sgvb) (dfd-u32 suvb)) (dfd-u32 smidb)))
                            (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 nff) (dfd-u32 1065353216)) (dfd-u32 1092616192)))) nff))
            (let g14 (dfd-mv-enq pmv sgty sdh smidb sharedb nembd nff))
            (let g15 (metal_enqueue pscl (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 moeb) (dfd-u32 ffnoutb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1065353216) (dfd-u32 nembd)))) 32 0) nembd))
            (let g16 (metal_enqueue paxp (dfd-bind-tg
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 sharedb) (dfd-u32 ffnoutb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 1065353216) (dfd-u32 nembd)))) 32 0) nembd))
            ; G. out streams = hcPost(ffnOut, afterAttn, ffn split)
            (let g17 (metal_enqueue ppost
                (str_concat (str_concat (dfd-u32 5) (str_concat (str_concat (str_concat (dfd-u32 ffnoutb) (dfd-u32 aftb))
                                                                            (str_concat (dfd-u32 fpostb) (dfd-u32 fcombb)))
                                                                (dfd-u32 outb)))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 nembd)))) 16384))
            (print "ENQ rung13 ~48 dispatches enqueued, one batch")

            ; ── the reads drain the batch; the join checks, each on the GPU's ACTUAL buffers
            (let residraw (metal_buf_read residb 0 65536))
            (let asplitraw (metal_buf_read asplitb 0 96))
            (let acurraw (metal_buf_read acurb 0 (mul nembd 4)))
            (let xnraw (metal_buf_read xnb 0 (mul nembd 4)))
            (let krraw (metal_buf_read krb 0 2048))
            (let kqraw (metal_buf_read kqb 0 2048))
            (let qrraw (metal_buf_read qrb 0 131072))
            (let habraw (metal_buf_read hab 0 131072))
            (let loraw (metal_buf_read lob 0 32768))
            (let aoraw (metal_buf_read aob 0 (mul nembd 4)))
            (let apostraw (metal_buf_read apostb 0 16))
            (let acombraw (metal_buf_read acombb 0 64))
            (let aftraw (metal_buf_read aftb 0 65536))
            (let fsplitraw (metal_buf_read fsplitb 0 96))
            (let fcurraw (metal_buf_read fcurb 0 (mul nembd 4)))
            (let fnrmraw (metal_buf_read fnrmb 0 (mul nembd 4)))
            (let idsraw (metal_buf_read idsb 0 24))
            (let partsraw (metal_buf_read partsb 0 98304))
            (let moeraw (metal_buf_read moeb 0 (mul nembd 4)))
            (let sharedraw (metal_buf_read sharedb 0 (mul nembd 4)))
            (let ffnoutraw (metal_buf_read ffnoutb 0 (mul nembd 4)))
            (let fpostraw (metal_buf_read fpostb 0 16))
            (let fcombraw (metal_buf_read fcombb 0 64))
            (let outraw (metal_buf_read outb 0 65536))

            (let j1 (dfd-wsum-eq residraw asplitraw acurraw nembd 0 0))
            (let gwraw (eqr-of-file path gabs (mul nembd 4)))
            (let j2 (dfd-rms-ref acurraw gwraw xnraw nembd))
            (let j3 (dfd-kvq-cmp krraw kqraw 0 1.0 0))
            (let snkraw (eqr-of-file path snkabs snkbytes))
            (let j4md (dfd-att-all-md qrraw kqraw snkraw habraw 0 0.0))
            (let j4 (div j4md (dfd-att-all-mr qrraw kqraw snkraw 0 0.0)))
            (let obwraw (eqr-of-file path obabs obbytes))
            (let brows (cons 0 (cons 1 (cons 2047 (cons 4095 0)))))
            (let j5 (div (dfd-mx8-md-rows obty obwraw (mul 4096 8192) 8192 loraw aoraw brows 0.0)
                         (dfd-mx8-mr-rows obty obwraw (mul 4096 8192) 8192 loraw brows 0.0)))
            (let j6 (dfd-post-eq aoraw residraw apostraw acombraw aftraw nembd 0 0))
            (let j7 (dfd-wsum-eq aftraw fsplitraw fcurraw nembd 0 0))
            (let fnwraw (eqr-of-file path fnabs (mul nembd 4)))
            (let j8 (dfd-rms-ref fcurraw fnwraw fnrmraw nembd))
            (let j9 (div (dfd-iq2e-md path gxabs strideg idsraw fnrmraw (metal_buf_read gateb 0 49152) nff 0 0.0)
                         (dfd-iq2e-mr path gxabs strideg idsraw fnrmraw nff 0 0.0)))
            (let j10 (dfd-red-eq partsraw moeraw nembd 0 0))
            (let j11 (dfd-add-eq moeraw sharedraw ffnoutraw nembd 0 0))
            (let j12 (dfd-post-eq ffnoutraw aftraw fpostraw fcombraw outraw nembd 0 0))
            ; the two splits vs the recipe, mix from the GPU, scale/base from the file
            (let hasraw (eqr-of-file path hasabs hasbytes))
            (let habraw2 (eqr-of-file path habsabs habsbytes))
            (let amixraw (metal_buf_read amixb 0 96))
            (let asref (hc-split-flat (hc-split (dfd-f32list amixraw 0 24) (dfd-f32list hasraw 0 3)
                                               (dfd-f32list habraw2 0 24) 4 20 (fd-value (dfd-eps-bits) 8 23))))
            (let j13 (div (dfd-lst-md asplitraw asref 0 0.0) (dfd-lst-mr asref 0.0)))
            (let hfsraw (eqr-of-file path hfsabs hfsbytes))
            (let hfbraw (eqr-of-file path hfbabs hfbbytes))
            (let fmixraw (metal_buf_read fmixb 0 96))
            (let fsref (hc-split-flat (hc-split (dfd-f32list fmixraw 0 24) (dfd-f32list hfsraw 0 3)
                                               (dfd-f32list hfbraw 0 24) 4 20 (fd-value (dfd-eps-bits) 8 23))))
            (let j14 (div (dfd-lst-md fsplitraw fsref 0 0.0) (dfd-lst-mr fsref 0.0)))
            (print (str_concat "LAYER j1 attn-wsum bit=" (str_concat (int_to_str j1)
                   (str_concat " j2 attn_norm ppb=" (str_concat (float_to_str (mul j2 1000000000.0))
                   (str_concat " j3 kvround=" (str_concat (int_to_str j3)
                   (str_concat " j4 attend ppb=" (float_to_str (mul j4 1000000000.0))))))))))
            (print (str_concat "LAYER j5 output_b ppb=" (str_concat (float_to_str (mul j5 1000000000.0))
                   (str_concat " j6 attn-post bit=" (str_concat (int_to_str j6)
                   (str_concat " j7 ffn-wsum bit=" (str_concat (int_to_str j7)
                   (str_concat " j8 ffn_norm ppb=" (float_to_str (mul j8 1000000000.0))))))))))
            (print (str_concat "LAYER j9 iq2-gate ppb=" (str_concat (float_to_str (mul j9 1000000000.0))
                   (str_concat " j10 reduce bit=" (str_concat (int_to_str j10)
                   (str_concat " j11 add bit=" (str_concat (int_to_str j11)
                   (str_concat " j12 out-post bit=" (int_to_str j12)))))))))
            (print (str_concat "LAYER j13 attn-split ppb=" (str_concat (float_to_str (mul j13 1000000000.0))
                   (str_concat " j14 ffn-split ppb=" (float_to_str (mul j14 1000000000.0))))))
            (print (metal_status))
            (cons j1 (cons j2 (cons j3 (cons j4 (cons j5 (cons j6 (cons j7 (cons j8
                (cons j9 (cons j10 (cons j11 (cons j12 (cons j13 (cons j14
                (cons (add eabs rowoff) (cons (metal_status) 0))))))))))))))))))

    ; ================= UNFINISHED, named so it cannot be mistaken for done =================
    ; - Rungs 1-13 run and are banded from this cell: the attention block, both KV caches, the MoE
    ;   (both routing regimes on this file's uniform IQ2_XXS/Q2_K experts, the shared lane, the
    ;   clamp witnessed on device), the hyper-connection frames with the 20-iteration Sinkhorn, the
    ;   exit head, and the JOINED single layer (blk.0 end to end at pos 0).
    ; - The 43-layer stack and the greedy stream live in native/metal/dsv4-decode-stack.fk
    ;   (rung 14), which preludes this cell and adds the LOOP, not new arithmetic. The stream is
    ;   diffed against the bash lane's receipt-recorded ids on the canonical file
    ;   (receipts/2026-07-30-order-match.md): 24/24, plus the lane's own 25th.
    ; - Still open past rung 14: SPEED (ms/token vs the recorded 28 t/s — the Form-side argmax and
    ;   the serial encode are the first costs; measure quiet, never under a sibling's load); the
    ;   ratio-128 layers' emitted rows (no run has crossed pos 127 on this device); the indexer
    ;   mask stays inert below 2048 tokens (top_k 512) and is declared, not implemented
    ;   (dsv4-compressor.fk's aporon radius); the MLA scores/stats/acc split (the oracle's
    ;   production attend) is not mirrored — attend_mixed carries the fold here.
    ; - Instrument boundary, learned at rung 10 and carried forward: EQUALITY is for PINNED ops
    ;   (adds, muls — they held bit equality across every lane asked); an op whose rounding the
    ;   COMPILER owns (fast-math division, on this door and in the oracle's own metallibs alike)
    ;   gets a bound DERIVED from its documented ulp, never a negotiated tolerance.
    0)
