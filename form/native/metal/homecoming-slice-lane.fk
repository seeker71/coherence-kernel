; homecoming-slice-lane.fk — the ask wrapper the homecoming census names: a dense Metal lane,
; callable as a function. Takes a blob path, reads the ten slice rows straight from the
; distillation corpus (never a hand copy), asks each question as a completion, and scores the
; text against the rented answer on record with hwc-hit?. The hit count is the measurement
; either way — a low number is the distance, not a failure.
;
; A RUN LANE, not a band: the census's scoring logic is proven four-way by
; learn/tests/homecoming-work-census-band.fk; this cell is the carrier that takes it to the
; device. One model per process (an open holds ~197 buffer slots of 198), so each model gets a
; thin driver beside this cell, the dense-run family's own precedent.
;
; run FROM THE REPO ROOT: ./fkwu-metal --src form/native/metal/homecoming-slice-run-llama1b.fk
;
; preludes: native/metal/dense-token-handle.fk learn/homecoming-distillation-corpus.fk learn/homecoming-work-census.fk

(do
    (defn hsl-run-q (st id n)
        (do (let r (hdc-row-for-id id))
            (let prompt (hwc-prompt-for (hdc-q r)))
            (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2))
            (let lays (nth st 3)) (let cks (nth st 4)) (let cvs (nth st 5))
            (let embTv (nth st 6)) (let onormTv (nth st 7)) (let projTv (nth st 8))
            (let src (nth st 10))
            (let ids (dtk-encode src prompt))
            (let pf (dth-prefill ps bs geo lays cks cvs embTv onormTv projTv ids 0))
            (let first (nth pf 0))
            (let rest (dth-generate ps bs geo lays cks cvs embTv onormTv projTv
                                    first (len ids) (sub n 1) (empty)))
            (let got (append (list first) rest))
            (let text (l3d-text src got))
            (let hit (hwc-hit? text (hdc-a r) (hdc-fresh r)))
            (print (str_concat "q" (str_concat (int_to_str id) (str_concat "_text=" text))))
            (print (str_concat "q" (str_concat (int_to_str id)
                (str_concat "_expect=" (str_concat (hdc-a r)
                    (str_concat " hit=" (int_to_str hit)))))))
            hit))

    (defn hsl-run-all (st ids n acc)
        (if (eq (len ids) 0) acc
            (hsl-run-all st (tail ids) n (add acc (hsl-run-q st (head ids) n)))))

    (defn hsl-slice (tag blob n)
        (do (let live (md-door-live?))
            (print (if live "door=live" "door=DEAD"))
            (let tA (now_unix_ms))
            (let st (dth-open blob 256 (sub 0 1)))
            (let tB (now_unix_ms))
            (print (str_concat tag (str_concat "_arch=" (nth st 9))))
            (print (str_concat tag (str_concat "_open_ms=" (int_to_str (sub tB tA)))))
            (let tC (now_unix_ms))
            (let hits (hsl-run-all st (hwc-slice-ids) n 0))
            (let tD (now_unix_ms))
            (print (str_concat tag (str_concat "_ask_ms=" (int_to_str (sub tD tC)))))
            (print (str_concat tag (str_concat "_hits=" (str_concat (int_to_str hits) "/10"))))
            (print (metal_status))
            hits))
    0)
