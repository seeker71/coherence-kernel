; Position-bearing trailing RoPE for DS4 Q/K states.
(do
    (defn dsv4-rope-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_rope_f32(device const float* x [[buffer(0)]],device float* out [[buffer(1)]],constant uint& heads [[buffer(2)]],constant uint& width [[buffer(3)]],constant uint& rotated [[buffer(4)]],constant float& position [[buffer(5)]],constant float& frequency_base [[buffer(6)]],constant float& sign [[buffer(7)]],constant uint& compressed [[buffer(8)]],constant float& scale_factor [[buffer(9)]],constant float& original_context [[buffer(10)]],constant float& beta_fast [[buffer(11)]],constant float& beta_slow [[buffer(12)]],uint h [[thread_position_in_grid]]){if(h>=heads)return;uint b=h*width;uint plain=width-rotated;for(uint j=0;j<plain;j++)out[b+j]=x[b+j];float fscale=(compressed!=0u&&scale_factor>0.0f)?(1.0f/scale_factor):1.0f;float ext=(compressed!=0u&&scale_factor>1.0f)?1.0f:0.0f;float lo=0.0f,hi=0.0f;if(ext!=0.0f){float den=2.0f*log(frequency_base);lo=max(0.0f,floor(float(rotated)*log(original_context/(beta_fast*2.0f*M_PI_F))/den));hi=min(float(rotated-1u),ceil(float(rotated)*log(original_context/(beta_slow*2.0f*M_PI_F))/den));}for(uint k=0;k<rotated/2;k++){float base_freq=pow(frequency_base,-2.0f*float(k)/float(rotated));float ramp=0.0f;if(ext!=0.0f){float y=(float(k)-lo)/max(0.001f,hi-lo);ramp=(1.0f-clamp(y,0.0f,1.0f))*ext;}float freq=base_freq*(fscale*(1.0f-ramp)+ramp);float a=position*freq;float c=cos(a);float s=sign*sin(a);uint p=b+plain+2*k;float x0=x[p],x1=x[p+1];out[p]=x0*c-x1*s;out[p+1]=x0*s+x1*c;}}\n")
    0)
