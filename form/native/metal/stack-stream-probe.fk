; stack-stream-probe.fk — rung-14 witness: first token, then the 25-step greedy stream.
; Witness probe, committed with its receipt. The recorded ids it diffs against are the bash lane's own
; (receipts/2026-07-30-order-match.md): prompt 671 6102 294 8760 344 ->
; 11111 16 455 6102 294 8760 344 repeating (period 7), 24 recorded from ds4, 25th ours = 6102.
; preludes: native/metal/dsv4-decode-stack.fk

(do
    (let prompt (cons 671 (cons 6102 (cons 294 (cons 8760 (cons 344 0))))))
    (let gen (dfd-stack-stream "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf" prompt 25))
    (let rec (cons 11111 (cons 16 (cons 455 (cons 6102 (cons 294 (cons 8760 (cons 344
              (cons 11111 (cons 16 (cons 455 (cons 6102 (cons 294 (cons 8760 (cons 344
              (cons 11111 (cons 16 (cons 455 (cons 6102 (cons 294 (cons 8760 (cons 344
              (cons 11111 (cons 16 (cons 455 (cons 6102 0))))))))))))))))))))))))))
    (defn diffgo (a b i acc)
        (if (eq (len a) 0) acc
            (if (eq (len b) 0) acc
                (diffgo (tail a) (tail b) (add i 1)
                    (add acc (if (eq (head a) (head b)) 1 0))))))
    (print "=== generated ===")
    (defn pr (l) (if (eq (len l) 0) 0 (do (print (int_to_str (head l))) (pr (tail l)))))
    (pr gen)
    (print (str_concat "STREAM MATCH count vs recorded 25 = " (int_to_str (diffgo gen rec 0 0))))
    0)
