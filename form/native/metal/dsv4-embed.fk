; dsv4-embed.fk — narrow Form authority for the DS4 F16 embedding kernel.
;
; The source is a value so an in-process Metal session can compile it directly;
; emitters may print the same value without maintaining a second spelling.

(do
    (defn dsv4-embed-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_embed_f16(device const uchar* src [[buffer(0)]], device float* dst [[buffer(1)]], constant ulong& base [[buffer(2)]], constant uint& n [[buffer(3)]], uint gid [[thread_position_in_grid]]) { if (gid < n) { ushort h = *(device const ushort*)(src + base + (ulong)gid*2); dst[gid] = float(as_type<half>(h)); } }\n")
    0)
