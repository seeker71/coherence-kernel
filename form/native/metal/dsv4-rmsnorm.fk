; Narrow Form authority for weighted RMSNorm in the DS4 attention path.
(do
    (defn dsv4-rmsnorm-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nstatic inline float form_rms_sqrt(float v) { if (v <= 0.0f) return 0.0f; float g=v; for(int i=0;i<50;i++) g=0.5f*(g+v/g); return g; }\nkernel void form_dsv4_rmsnorm_f32(device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* out [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& eps [[buffer(4)]], uint i [[thread_position_in_grid]]) { if(i!=0u)return; float ss=0.0f; for(uint j=0;j<n;j++)ss=ss+x[j]*x[j]; float inv=1.0f/form_rms_sqrt(ss/float(n)+eps); for(uint j=0;j<n;j++)out[j]=(x[j]*inv)*g[j]; }\nkernel void form_dsv4_head_rmsnorm_f32(device const float* x [[buffer(0)]], device const float* unused [[buffer(1)]], device float* out [[buffer(2)]], constant uint& width [[buffer(3)]], constant float& eps [[buffer(4)]], uint h [[thread_position_in_grid]]) { uint base=h*width; float ss=0.0f; for(uint j=0;j<width;j++)ss=ss+x[base+j]*x[base+j]; float inv=1.0f/form_rms_sqrt(ss/float(width)+eps); for(uint j=0;j<width;j++)out[base+j]=x[base+j]*inv; }\n")
    0)
