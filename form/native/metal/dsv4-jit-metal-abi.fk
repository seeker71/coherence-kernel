; Form-native ARM64 -> Metal dispatcher ABI.
;
; This cell emits and executes the controller instruction that was previously
; only named: call an address supplied as data, or return 0 when the address is
; absent. It does not invent an address. The current host ingress passes one
; tagged Value and exposes no operation that resolves an already-linked symbol,
; so address=0 is the exact first unrepresentable value in the DS4 JIT path.
;
; Once the host publishes the existing Metal dispatcher address as a Value,
; the same emitted bytes take that address through BLR without another compiler,
; walker, shell, source string, or external toolchain.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk

(do
    ; ABI = ("dsv4-jit-metal-abi" address callable value-abi operation)
    (defn djma-abi (address callable operation)
        (list "dsv4-jit-metal-abi" address callable "value->value" operation))

    (defn djma-address (a) (nth a 1))
    (defn djma-callable (a) (nth a 2))

    ; x0 carries the dispatcher address:
    ;   cbz x0, absent
    ;   blr x0
    ;   ret
    ; absent:
    ;   movz w0,#0
    ;   ret
    (defn djma-controller-bytes ()
        (fa-image
            (list
                (fa-cbz-x 0 3)
                (fa-blr 0)
                (fa-ret)
                (fa-movz 0 0)
                (fa-ret))))

    (defn djma-run (abi)
        (if (eq (djma-callable abi) 1)
            (native_call_bytes (djma-controller-bytes) (djma-address abi))
            (native_call_bytes (djma-controller-bytes) 0)))

    ; Live current floor: the Form image is executable; the dispatcher address
    ; is not observable through any current primitive, so the controller takes
    ; its explicit absent path instead of crashing or pretending to dispatch.
    (defn dsv4-jit-metal-address-floor ()
        (djma-run (djma-abi 0 0 "metal_model_dispatch")))

    0)
