; dsl-l3-probe.fk — ladder level 3: ONE position through all 43 layers, decomposed.
; Per position: host-encode ms (embed + broadcast + 43 layers of enqueues), GPU-drain ms
; (a 4-byte read closing the batch), and at generating positions the head's read+argmax.
; Witness probe, committed with its receipt.
; preludes: native/metal/dsv4-decode-stack.fk

(do
    (defn l3-pos (P S Ls X ids pos promptlen)
        (do (let token (nth ids pos))
            (let th0 (now_unix_ms))
            ; RUNG 15: each position is its own drained batch; re-arm concurrent before the first enqueue.
            (let cbatch (metal_batch_concurrent))
            (let e0 (metal_enqueue (nth P 0) (dfd-b16
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 63)) (dfd-u32 (nth S 0))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 (mul (mul token 4096) 2)) (dfd-u32 4096)))) 0) 4096))
            (let e1 (metal_enqueue (nth P 1) (dfd-b16
                (str_concat (str_concat (dfd-u32 2) (str_concat (dfd-u32 (nth S 0)) (dfd-u32 (nth S 1))))
                            (str_concat (dfd-u32 2) (str_concat (dfd-u32 4) (dfd-u32 4096)))) 1) 16384))
            (let fin (dfd-st-layers-go P S Ls 0 pos token (nth S 1) (nth S 2)))
            (let th1 (now_unix_ms))
            (let drain (metal_buf_read (nth S 2) 0 4))
            (let th2 (now_unix_ms))
            (let hd (if (ge pos (sub promptlen 1))
                (do (let ta (now_unix_ms))
                    (let am (dfd-st-head P S X pos fin))
                    (let tb (now_unix_ms))
                    (print (str_concat "  head_total_ms=" (str_concat (int_to_str (sub tb ta))
                           (str_concat " next=" (int_to_str (head am))))))
                    (head am))
                0))
            (print (str_concat "L3 pos=" (str_concat (int_to_str pos)
                (str_concat " encode_ms=" (str_concat (int_to_str (sub th1 th0))
                (str_concat " drain_ms=" (int_to_str (sub th2 th1))))))))
            hd))
    (defn l3-walk (P S Ls X ids pos ntotal promptlen)
        (if (ge pos ntotal) 0
            (do (let nid (l3-pos P S Ls X ids pos promptlen))
                (l3-walk P S Ls X (if (gt nid 0) (dfd-append1 ids nid) ids)
                         (add pos 1) ntotal promptlen))))

    (let path "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf")
    (let ts0 (now_unix_ms))
    (let src (dfd-src path))
    (let nlayers 43)
    (let hashn (dfd-st-hashcount src))
    (let ratios (dfd-st-ratios src (add nlayers 1)))
    (let kvcap 12)
    (let tt0 (now_unix_ms))
    (let tab (dfd-stt src))
    (let tt1 (now_unix_ms))
    (print (str_concat "SETUP one_walk_table_ms=" (int_to_str (sub tt1 tt0))))
    (let eabs (dfd-stt-abs tab "token_embd.weight"))
    (let ebytes (dfd-stt-bytes tab "token_embd.weight"))
    (let embh (metal_buf_from_file path eabs ebytes))
    (let ts1 (now_unix_ms))
    (print (str_concat "SETUP header+embed_ms=" (int_to_str (sub ts1 ts0))))

    (let hmsl (dfd-hc-msl))
    (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
    (let fmsl (dfd-ffn-msl))
    (let cmsl (dfd-comp-msl))
    (let P (cons (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32")
           (cons (metal_pipeline hmsl "form_hc_broadcast_f32")
           (cons (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32")
           (cons (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec")
           (cons (metal_pipeline hmsl "form_hc_split_seq4_f32")
           (cons (metal_pipeline hmsl "form_hc_wsum_f32")
           (cons (metal_pipeline hmsl "form_hc_post_f32")
           (cons (metal_pipeline (dfd-slice-msl) "dfd_slice")
           (cons (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32")
           (cons (metal_pipeline mslm "form_mla_rmsnorm_apply_f32")
           (cons (metal_pipeline mslm "form_mla_headrms_f32")
           (cons (metal_pipeline mslm "form_mla_rope_f32")
           (cons (metal_pipeline mslm "form_mla_attend_mixed_f32")
           (cons (metal_pipeline (dfd-freqs-msl) "dfd_freqs")
           (cons (metal_pipeline (dfd-kvq-msl) "form_dsv4_kv_fp8_f16_round_par")
           (cons (metal_pipeline (dfd-append-msl) "dfd_kv_append")
           (cons (dfd-mv-pipe 8)
           (cons (dfd-mvg-pipe 8)
           (cons (metal_pipeline fmsl "form_dsv4_hash_select")
           (cons (metal_pipeline fmsl "form_dsv4_hash_probs")
           (cons (metal_pipeline fmsl "form_dsv4_hash_wts")
           (cons (metal_pipeline fmsl "form_dsv4_topk_probs")
           (cons (metal_pipeline fmsl "form_dsv4_topk_select_tg6")
           (cons (metal_pipeline fmsl "form_dsv4_swiglu_f32")
           (cons (metal_pipeline fmsl "form_dsv4_swiglu_experts")
           (cons (metal_pipeline fmsl "form_dsv4_moe_reduce")
           (cons (metal_pipeline fmsl "form_dsv4_scale_f32")
           (cons (metal_pipeline fmsl "form_dsv4_axpy_f32")
           (cons (metal_pipeline (dfd-iq2e-msl) "form_dsv4_iq2_matvec_experts4")
           (cons (metal_pipeline (dfd-q2ke-msl) "form_dsv4_q2k_matvec_experts")
           (cons (metal_pipeline cmsl "form_dsv4_comp_state_f32")
           (cons (metal_pipeline cmsl "form_dsv4_comp_pool_f32")
           (cons (metal_pipeline cmsl "form_dsv4_comp_shift_f32")
           (cons (metal_pipeline hmsl "form_hc_headw_f32") 0)))))))))))))))))))))))))))))))))))
    (let pci (metal_pipeline cmsl "form_dsv4_comp_init_f32"))
    (let ts2 (now_unix_ms))
    (print (str_concat "SETUP pipelines_ms=" (int_to_str (sub ts2 ts1))))

    (let S (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 65536)
           (cons (metal_buf_alloc 65536)
           (cons (metal_buf_alloc 65536)
           (cons (metal_buf_alloc 96)
           (cons (metal_buf_alloc 96)
           (cons (metal_buf_alloc 16)
           (cons (metal_buf_alloc 64)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 4096)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 4096)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 131072)
           (cons (metal_buf_alloc 131072)
           (cons (metal_buf_alloc 131072)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 131072)
           (cons (metal_buf_alloc 131072)
           (cons (metal_buf_alloc 32768)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 65536)
           (cons (metal_buf_alloc 96)
           (cons (metal_buf_alloc 96)
           (cons (metal_buf_alloc 16)
           (cons (metal_buf_alloc 64)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 1024)
           (cons (metal_buf_alloc 24)
           (cons (metal_buf_alloc 24)
           (cons (metal_buf_alloc 1024)
           (cons (metal_buf_alloc 1024)
           (cons (metal_buf_alloc 49152)
           (cons (metal_buf_alloc 49152)
           (cons (metal_buf_alloc 49152)
           (cons (metal_buf_alloc 98304)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 8192)
           (cons (metal_buf_alloc 8192)
           (cons (metal_buf_alloc 8192)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 128)
           (cons (metal_buf_alloc 128)
           (cons (metal_buf_alloc 4096)
           (cons (metal_buf_alloc 4096)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 2048)
           (cons (metal_buf_alloc 2048)
           (cons 0 (cons 0 (cons 0 (cons 0 (cons 0
           (cons embh 0)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
    (let ef0 (metal_enqueue (nth P 13)
        (str_concat (str_concat (dfd-u32 1) (dfd-u32 (nth S 49)))
                    (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64)) (dfd-u32 1176256512)))) 32))
    (let pfy (metal_pipeline (dfd-yarn-msl) "dfd_yarn_freqs"))
    (let efy (metal_enqueue pfy
        (str_concat (str_concat (dfd-u32 1) (dfd-u32 (nth S 50)))
                    (str_concat (dfd-u32 6) (str_concat (str_concat (dfd-u32 32) (dfd-u32 64))
                        (str_concat (str_concat (dfd-u32 1209810944) (dfd-u32 1031798784))
                                    (str_concat (dfd-u32 1097859072) (dfd-u32 1103626240)))))) 32))
    (let ts3 (now_unix_ms))
    (print (str_concat "SETUP scratch+freqs_ms=" (int_to_str (sub ts3 ts2))))

    (let Ls (dfd-st-build tab path 0 nlayers hashn kvcap ratios))
    (let ts4 (now_unix_ms))
    (print (str_concat "SETUP views_43_layers_ms=" (int_to_str (sub ts4 ts3))))
    (let ci (dfd-st-compinit pci Ls))
    (let X (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_fn.weight") (dfd-stt-bytes tab "output_hc_fn.weight"))
           (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_scale.weight") (dfd-stt-bytes tab "output_hc_scale.weight"))
           (cons (metal_buf_from_file path (dfd-stt-abs tab "output_hc_base.weight") (dfd-stt-bytes tab "output_hc_base.weight"))
           (cons (metal_buf_from_file path (dfd-stt-abs tab "output_norm.weight") (dfd-stt-bytes tab "output_norm.weight"))
           (cons (metal_buf_from_file path (dfd-stt-abs tab "output.weight") (dfd-stt-bytes tab "output.weight"))
           (cons (metal_buf_alloc 16)
           (cons (metal_buf_alloc 16)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 4)
           (cons (metal_buf_alloc 16384)
           (cons (metal_buf_alloc 517120)
                 0))))))))))))
    (let ts5 (now_unix_ms))
    (print (str_concat "SETUP compinit+head_ms=" (int_to_str (sub ts5 ts4))))

    ; ═══ the ladder inside the ONE living session — setup above paid once, each level ms ═══
    (let L0 (head Ls))
    (let oah (nth L0 8))
    (let xh (nth S 23))
    (let yh (nth S 24))
    ; L1 plain kernel (form_dsv4_q80_matvec_ds4 — the head/output_b lane)
    (let w0 (dfd-mv-enq (nth P 16) 8 oah xh yh 8192 4096))
    (let wr0 (metal_buf_read yh 0 4))
    (defn l1-plain (P oah xh yh n)
        (if (le n 0) 0 (do (dfd-mv-enq (nth P 16) 8 oah xh yh 8192 4096) (l1-plain P oah xh yh (sub n 1)))))
    (let ta0 (now_unix_ms))
    (let a0 (l1-plain P oah xh yh 64))
    (let ar0 (metal_buf_read yh 0 4))
    (let ta1 (now_unix_ms))
    (print (str_concat "L1a plain_x64_ms=" (str_concat (int_to_str (sub ta1 ta0))
        (str_concat " us_per=" (str_concat (int_to_str (div (mul (sub ta1 ta0) 1000) 64))
        (str_concat " floor_us=74 GBs=" (int_to_str (div (mul 35651584 64) (mul (if (le (sub ta1 ta0) 0) 1 (sub ta1 ta0)) 1000000)))))))))
    ; L1b grouped kernel (form_dsv4_q80_matvec_grouped rank 1024 — the stack's own oa lane)
    (defn l1-grp (P oah xh yh n)
        (if (le n 0) 0 (do (dfd-mvg-enq (nth P 17) oah xh yh 8192 4096 1024) (l1-grp P oah xh yh (sub n 1)))))
    (let wg (l1-grp P oah xh yh 1))
    (let wgr (metal_buf_read yh 0 4))
    (let tb0 (now_unix_ms))
    (let b0g (l1-grp P oah xh yh 64))
    (let br0 (metal_buf_read yh 0 4))
    (let tb1 (now_unix_ms))
    (print (str_concat "L1b grouped_x64_ms=" (str_concat (int_to_str (sub tb1 tb0))
        (str_concat " us_per=" (str_concat (int_to_str (div (mul (sub tb1 tb0) 1000) 64))
        (str_concat " GBs=" (int_to_str (div (mul 35651584 64) (mul (if (le (sub tb1 tb0) 0) 1 (sub tb1 tb0)) 1000000)))))))))
    ; L2 in-session: binding build alone, x1000
    (defn l2-bind (oah xh yh) (dfd-bind-tg
        (str_concat (str_concat (dfd-u32 3) (str_concat (str_concat (dfd-u32 oah) (dfd-u32 xh)) (dfd-u32 yh)))
                    (str_concat (dfd-u32 2) (str_concat (dfd-u32 8192) (dfd-u32 4096)))) 256 0))
    (defn l2-bloop (oah xh yh n acc)
        (if (le n 0) acc (l2-bloop oah xh yh (sub n 1) (add acc (str_len (l2-bind oah xh yh))))))
    (let tc0 (now_unix_ms))
    (let c0l (l2-bloop oah xh yh 1000 0))
    (let tc1 (now_unix_ms))
    (print (str_concat "L2a bind_x1000_ms_in_session=" (int_to_str (sub tc1 tc0))))
    ; L2d in-session: the head's argmax pair over real bytes
    (let lraw (metal_buf_read oah 0 517120))
    (let td0 (now_unix_ms))
    (let am (dfd-argmax-go lraw 0 129280 0 (dfd-f32at lraw 0)))
    (let td1 (now_unix_ms))
    (print (str_concat "L2d argmax_ms_in_session=" (int_to_str (sub td1 td0))))

    ; ═══ L3/L4: the position walk, per-position encode vs drain vs head ═══
    (let prompt (cons 671 (cons 6102 (cons 294 (cons 8760 (cons 344 0))))))
    (let g (l3-walk P S Ls X prompt 0 10 5))
    (print (metal_status))
    0)
