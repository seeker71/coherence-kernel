; dsl-pipes-probe.fk — which pipeline is handle 0? Prints all 34 + pci + pfy.
; preludes: native/metal/dsv4-decode-form.fk

(do
    (defn pp (nm h) (print (str_concat nm (str_concat "=" (int_to_str h)))))
    (let hmsl (dfd-hc-msl))
    (let mslm (str_concat (dfd-msl-pragma) (mla-msl-unit)))
    (let fmsl (dfd-ffn-msl))
    (let cmsl (dfd-comp-msl))
    (pp "p0_embed" (metal_pipeline (dfd-embed-msl) "form_dsv4_embed_f16_u32"))
    (pp "p1_bcast" (metal_pipeline hmsl "form_hc_broadcast_f32"))
    (pp "p2_nw" (metal_pipeline hmsl "form_hc_rmsnorm_nw_wide_f32"))
    (pp "p3_f16" (metal_pipeline (dfd-f16-msl) "form_dsv4_f16_matvec"))
    (pp "p4_split" (metal_pipeline hmsl "form_hc_split_seq4_f32"))
    (pp "p5_wsum" (metal_pipeline hmsl "form_hc_wsum_f32"))
    (pp "p6_post" (metal_pipeline hmsl "form_hc_post_f32"))
    (pp "p7_slice" (metal_pipeline (dfd-slice-msl) "dfd_slice"))
    (pp "p8_reduce" (metal_pipeline mslm "form_mla_rmsnorm_reduce_f32"))
    (pp "p9_apply" (metal_pipeline mslm "form_mla_rmsnorm_apply_f32"))
    (pp "p10_headrms" (metal_pipeline mslm "form_mla_headrms_f32"))
    (pp "p11_rope" (metal_pipeline mslm "form_mla_rope_f32"))
    (pp "p12_attend" (metal_pipeline mslm "form_mla_attend_mixed_f32"))
    (pp "p13_freqs" (metal_pipeline (dfd-freqs-msl) "dfd_freqs"))
    (pp "p14_kvq" (metal_pipeline mslm "form_dsv4_kv_fp8_f16_round_par"))
    (pp "p15_append" (metal_pipeline (dfd-append-msl) "dfd_kv_append"))
    (pp "p16_mv8" (dfd-mv-pipe 8))
    (pp "p17_mvg8" (dfd-mvg-pipe 8))
    (pp "p18_hsel" (metal_pipeline fmsl "form_dsv4_hash_select"))
    (pp "p19_hprb" (metal_pipeline fmsl "form_dsv4_hash_probs"))
    (pp "p20_hwts" (metal_pipeline fmsl "form_dsv4_hash_wts"))
    (pp "p21_tkp" (metal_pipeline fmsl "form_dsv4_topk_probs"))
    (pp "p22_tks" (metal_pipeline fmsl "form_dsv4_topk_select_tg6"))
    (pp "p23_swg" (metal_pipeline fmsl "form_dsv4_swiglu_f32"))
    (pp "p24_swge" (metal_pipeline fmsl "form_dsv4_swiglu_experts"))
    (pp "p25_mred" (metal_pipeline fmsl "form_dsv4_moe_reduce"))
    (pp "p26_scl" (metal_pipeline fmsl "form_dsv4_scale_f32"))
    (pp "p27_axp" (metal_pipeline fmsl "form_dsv4_axpy_f32"))
    (pp "p28_iq2" (metal_pipeline (dfd-iq2e-msl) "form_dsv4_iq2_matvec_experts4"))
    (pp "p29_q2k" (metal_pipeline (dfd-q2ke-msl) "form_dsv4_q2k_matvec_experts"))
    (pp "p30_cs" (metal_pipeline cmsl "form_dsv4_comp_state_f32"))
    (pp "p31_cp" (metal_pipeline cmsl "form_dsv4_comp_pool_f32"))
    (pp "p32_csh" (metal_pipeline cmsl "form_dsv4_comp_shift_f32"))
    (pp "p33_hw" (metal_pipeline hmsl "form_hc_headw_f32"))
    (pp "pci" (metal_pipeline cmsl "form_dsv4_comp_init_f32"))
    (pp "pfy" (metal_pipeline (dfd-yarn-msl) "dfd_yarn_freqs"))
    (print (metal_status))
    0)
