; dense-run-dsr1q32.fk — DeepSeek-R1-Distill-Qwen-32B (qwen2: neox rope, qkv bias) end to end through dense-token-handle.fk: the file's own
; geometry, the body's tokenizer (longest-match, stated), 16 layers on the GPU, greedy stream,
; the body's detokenizer, honest ms. A RUN DRIVER, not the band — the band predicts and gates;
; this prints what happened.
;
; preludes: native/metal/dense-token-handle.fk

(do
    (defn drd-blob () "/Users/ursmuff/.ollama/models/blobs/sha256-6150cb382311b69f09cc0f9a1b69fc029cbd742b66bb8ec531aa5ecf5c613e93")
    (defn drd-prompt () "The capital of France is")

    (defn drd-join (xs acc)
        (if (eq (len xs) 0) acc
            (drd-join (tail xs) (str_concat acc (str_concat " " (int_to_str (head xs)))))))

    (let live (md-door-live?))
    (print (if live "door=live" "door=DEAD"))

    (let tA (now_unix_ms))
    (let st (dth-open (drd-blob) 256 (sub 0 1)))
    (let tB (now_unix_ms))
    (let ps (nth st 0)) (let bs (nth st 1)) (let geo (nth st 2))
    (let lays (nth st 3)) (let cks (nth st 4)) (let cvs (nth st 5))
    (let embTv (nth st 6)) (let onormTv (nth st 7)) (let projTv (nth st 8))
    (let src (nth st 10))

    (print (str_concat "arch=" (nth st 9)))
    (print (str_concat "open_ms=" (int_to_str (sub tB tA))))
    (print (str_concat "geo d/dff/nh/nkv/hd/kvd/vocab/nlayer/qout/style/rd/nloop="
        (drd-join (list (nth geo 0) (nth geo 1) (nth geo 2) (nth geo 3) (nth geo 4) (nth geo 5)
                        (nth geo 7) (nth geo 12) (nth geo 13) (nth geo 14) (nth geo 15) (nth geo 16)) "")))
    (print (str_concat "pipes_ok=" (if (dth-pipe-ok? ps) "1" "0")))

    (let tC (now_unix_ms))
    (let ids (dtk-encode src (drd-prompt)))
    (let tD (now_unix_ms))
    (print (str_concat "tokenize_ms=" (int_to_str (sub tD tC))))
    (print (str_concat "prompt_ids=" (drd-join ids "")))

    (let tE (now_unix_ms))
    (let pf (dth-prefill ps bs geo lays cks cvs embTv onormTv projTv ids 0))
    (let tF (now_unix_ms))
    (let first (nth pf 0))
    (print (str_concat "first_id=" (int_to_str first)))
    (print (str_concat "prefill_ms=" (int_to_str (sub tF tE))))

    (let tG (now_unix_ms))
    (let rest (dth-generate ps bs geo lays cks cvs embTv onormTv projTv first (len ids) 15 (empty)))
    (let tH (now_unix_ms))
    (let got (append (list first) rest))
    (print (str_concat "ids=" (drd-join got "")))
    (print (str_concat "decode_ms=" (int_to_str (sub tH tG))))

    (print (str_concat "text=" (l3d-text src got)))
    (print (metal_status))
    0)
