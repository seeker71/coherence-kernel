; sha256-arm64-jit.fk — Form-emitted SHA-256 compression for Apple arm64.
;
; Form owns the instruction image, state, constants, padding, file admission,
; and digest rendering.  The existing form_cpu_jit carrier only installs and
; calls these bytes over unified handles.  Four SHA rounds are performed by
; each SHA256H/SHA256H2 pair; SHA256SU0/SU1 extend the rolling schedule.
;
; ABI fixed by the carrier:
;   x0 = void **buffers  [message, state, round constants]
;   x1 = uint32_t *constants  [64-byte block count]
;   x2 = thread count (unused)
;
; preludes: form-stdlib/form-asm.fk form-stdlib/sha256.fk form-stdlib/metal-door.fk

(do
    (defn saj-byte-string (bytes)
        (if (eq (len bytes) 0) ""
            (str_concat (byte_to_str (head bytes))
                        (saj-byte-string (tail bytes)))))

    (defn saj-u32-le (w)
        (list (band w 255)
              (band (shr_u32 w 8) 255)
              (band (shr_u32 w 16) 255)
              (band (shr_u32 w 24) 255)))
    (defn saj-u32-list-le (words)
        (if (eq (len words) 0) (list)
            (append-list (saj-u32-le (head words))
                         (saj-u32-list-le (tail words)))))
    (defn saj-initial-state-bytes ()
        (saj-byte-string (saj-u32-list-le (sha256-h-init))))
    (defn saj-round-constant-bytes ()
        (saj-byte-string (saj-u32-list-le (sha256-k))))

    (defn saj-msg-reg (group) (add 4 (mod group 4)))
    (defn saj-round-instructions (group)
        (do
            (let msg (saj-msg-reg group))
            (let next (saj-msg-reg (add group 1)))
            (let next2 (saj-msg-reg (add group 2)))
            (let next3 (saj-msg-reg (add group 3)))
            (let schedule
                (if (lt group 4) (list)
                    (list (fa-sha256su0 msg next)
                          (fa-sha256su1 msg next2 next3))))
            (append-list schedule
                (list
                    (fa-vorr 16 msg msg)          ; wk = message vector
                    (fa-ldr-q 18 5 group)         ; k[group*4 .. group*4+3]
                    (fa-vadd-s 16 16 18)          ; wk += k
                    (fa-vorr 17 0 0)              ; save old abcd
                    (fa-sha256h 0 1 16)
                    (fa-sha256h2 1 17 16)))))
    (defn saj-rounds (group)
        (if (eq group 16) (list)
            (append-list (saj-round-instructions group)
                         (saj-rounds (add group 1)))))

    (defn saj-loop-core ()
        (append-list
            (list
                (fa-vorr 2 0 0)       ; saved abcd
                (fa-vorr 3 1 1)       ; saved efgh
                (fa-ldr-q 4 3 0)
                (fa-ldr-q 5 3 1)
                (fa-ldr-q 6 3 2)
                (fa-ldr-q 7 3 3)
                (fa-vrev32-b 4 4)
                (fa-vrev32-b 5 5)
                (fa-vrev32-b 6 6)
                (fa-vrev32-b 7 7))
            (append-list (saj-rounds 0)
                (list
                    (fa-vadd-s 0 0 2)
                    (fa-vadd-s 1 1 3)
                    (fa-add-x-imm 3 3 64)
                    (fa-sub 6 6 1)
                    (fa-cmp 6 0)))))

    (defn saj-instruction-list ()
        (do
            (let loop-core (saj-loop-core))
            (append-list
                (list
                    (fa-ldr 3 0 0)       ; message buffer
                    (fa-ldr 4 0 1)       ; state buffer
                    (fa-ldr 5 0 2)       ; K buffer
                    (fa-ldr-w 6 1 0)     ; block count
                    (fa-ldr-q 0 4 0)     ; abcd
                    (fa-ldr-q 1 4 1))    ; efgh
                (append-list loop-core
                    (list
                        (fa-bcond 1 (sub 0 (len loop-core))) ; b.ne block loop
                        (fa-str-q 0 4 0)
                        (fa-str-q 1 4 1)
                        (fa-ret))))))
    (defn saj-image () (fa-image (saj-instruction-list)))
    (defn saj-code () (saj-byte-string (saj-image)))

    ; Convert the two little-endian Q stores back to SHA's canonical byte order.
    (defn saj-word-be-from-state (raw off)
        (str_concat (byte_to_str (str_byte_at raw (add off 3)))
        (str_concat (byte_to_str (str_byte_at raw (add off 2)))
        (str_concat (byte_to_str (str_byte_at raw (add off 1)))
                    (byte_to_str (str_byte_at raw off))))))
    (defn saj-state-digest-from (raw off)
        (if (eq off 32) ""
            (str_concat (saj-word-be-from-state raw off)
                        (saj-state-digest-from raw (add off 4)))))
    (defn saj-state-digest (raw) (saj-state-digest-from raw 0))

    (defn saj-zero-string (count)
        (if (le count 0) ""
            (str_concat (byte_to_str 0) (saj-zero-string (sub count 1)))))
    (defn saj-be64-list (n remaining acc)
        (if (eq remaining 0) acc
            (saj-be64-list (div n 256) (sub remaining 1)
                           (cons (mod n 256) acc))))
    (defn saj-padding-block (tail-bytes total-bytes)
        (do
            (let used (str_len tail-bytes))
            (str_concat tail-bytes
                (str_concat (byte_to_str 128)
                    (str_concat (saj-zero-string (sub 55 used))
                        (saj-byte-string
                            (saj-be64-list (mul total-bytes 8) 8 (list))))))))

    ; Continue an unpadded SHA state across a handle whose byte count is an
    ; exact number of 64-byte blocks.  This is the resumable downloader seam:
    ; the returned 32 bytes are the actual eight hardware-updated state words.
    ; A CONDITIONAL EFFECT MUST BE A NAMED RECIPE, not an `if` in a let's value.
    ; form-flatten.fk's flt-do-let-store-op decides whether a let gets a real
    ; frame slot by looking at the HEAD op of its value and nothing deeper: an op
    ; named in host-effect-grammar.fk stores, a call to a known recipe stores, and
    ; everything else is SUBSTITUTED into the environment and re-evaluated at every
    ; mention.  `(let ran (if c (metal_enqueue …) 0))` has `if` at its head, so it
    ; was re-dispatched on each read of `ran`, and `(let raw (if (eq ran 1)
    ; (metal_buf_read …) ""))` re-read on each mention of `raw` — the guards then
    ; disagreed with each other and this recipe answered "" (2026-08-20, witnessed
    ; through the emitted walker while the source runner, which binds lets once,
    ; answered correctly).  Each conditional effect below is a recipe, so the let
    ; binds a CALL and stores.  The head-op-only decision is the deeper thread and
    ; is named in receipts/2026-08-20-the-let-that-allocated-four-times.md.
    (defn saj-dispatch (message state rounds block-count sw kw)
        (if (and (eq sw 32) (eq kw 256))
            (metal_enqueue (metal_pipeline (saj-code) "form_cpu_jit")
                (md-bind (list message state rounds) (list block-count)) 1)
            0))
    (defn saj-read-state (ran state)
        (if (eq ran 1) (metal_buf_read state 0 32) ""))
    (defn saj-compress-handle-state (message state-raw block-count)
        (if (not (eq (str_len state-raw) 32)) ""
            (if (eq block-count 0) state-raw
                (do
                    (let state (metal_buf_alloc 32))
                    (let rounds (metal_buf_alloc 256))
                    (if (or (le message 0) (or (le state 0) (le rounds 0))) ""
                        (do
                            (let sw (metal_buf_write state 0 state-raw))
                            (let kw (metal_buf_write rounds 0 (saj-round-constant-bytes)))
                            (let ran (saj-dispatch message state rounds block-count sw kw))
                            (let raw (saj-read-state ran state))
                            (let f0 (metal_buf_free state))
                            (let f1 (metal_buf_free rounds))
                            (if (and (eq (str_len raw) 32) (and (eq f0 1) (eq f1 1)))
                                raw "")))))))

    (defn saj-file-prefix-state (path byte-count)
        (if (or (lt byte-count 0) (not (eq (mod byte-count 64) 0))) ""
            (if (eq byte-count 0) (saj-initial-state-bytes)
                (do
                    (let message (metal_buf_from_file path 0 byte-count))
                    (if (le message 0) ""
                        (do
                            (let raw (saj-compress-handle-state message
                                (saj-initial-state-bytes) (div byte-count 64)))
                            (let freed (metal_buf_free message))
                            (if (eq freed 1) raw "")))))))

    ; Same law as saj-dispatch above: the conditional is a recipe, so the let that
    ; holds its answer stores instead of re-running it.  Here the cost of getting
    ; it wrong was exact — `freed` is read before `raw` in the closing guard, so an
    ; inlined `raw` re-entered the compressor with a handle that had just been
    ; released, and the whole digest came back empty.
    (defn saj-compress-written (pad state-raw pw)
        (if (eq pw 64) (saj-compress-handle-state pad state-raw 1) ""))

    (defn saj-final-digest-from-state (state-raw tail-bytes total-bytes)
        (if (or (not (eq (str_len state-raw) 32))
             (or (not (eq (str_len tail-bytes) (mod total-bytes 64)))
                 (ge (str_len tail-bytes) 56))) ""
            (do
                (let padding (saj-padding-block tail-bytes total-bytes))
                (let pad (metal_buf_alloc 64))
                (if (le pad 0) ""
                    (do
                        (let pw (metal_buf_write pad 0 padding))
                        (let raw (saj-compress-written pad state-raw pw))
                        (let freed (metal_buf_free pad))
                        (if (and (eq freed 1) (eq (str_len raw) 32))
                            (saj-state-digest raw) ""))))))

    ; A byte-list can enter the same Form-emitted arm64 compressor without a
    ; filesystem crossing.  The bridge materializes only one bounded 64-byte
    ; string at a time; it never builds a second whole-message string and it
    ; walks the list once.  The remaining tail is at most 63 bytes.
    (defn saj-split-byte-string (bytes remaining acc)
        (if (eq remaining 0) (list acc bytes)
            (if (nil? bytes) (list "" (list))
                (saj-split-byte-string
                    (tail bytes) (sub remaining 1)
                    (str_concat acc (byte_to_str (head bytes)))))))

    (defn saj-write-byte-blocks (message bytes block-count offset)
        (if (eq block-count 0) (list bytes 1)
            (do
                (let split (saj-split-byte-string bytes 64 ""))
                (let block (nth split 0))
                (let rest (nth split 1))
                (let wrote (metal_buf_write message offset block))
                (if (eq wrote 64)
                    (saj-write-byte-blocks
                        message rest (sub block-count 1) (add offset 64))
                    (list bytes 0)))))

    (defn saj-prefix-byte-state (bytes prefix-size)
        (if (eq prefix-size 0)
            (list (saj-initial-state-bytes) bytes 1)
            (do
                (let message (metal_buf_alloc prefix-size))
                (if (le message 0) (list "" bytes 0)
                    (do
                        (let written (saj-write-byte-blocks
                            message bytes (div prefix-size 64) 0))
                        (let state
                            (if (eq (nth written 1) 1)
                                (saj-compress-handle-state message
                                    (saj-initial-state-bytes)
                                    (div prefix-size 64))
                                ""))
                        (let freed (metal_buf_free message))
                        (if (and (eq freed 1) (eq (str_len state) 32))
                            (list state (nth written 0) 1)
                            (list "" bytes 0)))))))

    ; Unlike the older downloader helper, this padding accepts either final
    ; SHA shape: one block for tails 0..55, two blocks for tails 56..63.
    (defn saj-padding-string (tail-bytes total-bytes)
        (do
            (let used (str_len tail-bytes))
            (let zeros
                (if (le used 55) (sub 55 used) (sub 119 used)))
            (str_concat tail-bytes
                (str_concat (byte_to_str 128)
                    (str_concat (saj-zero-string zeros)
                        (saj-byte-string
                            (saj-be64-list (mul total-bytes 8) 8 (list))))))))

    (defn saj-compress-padding-written
        (padding state-raw wrote block-count)
        (if (eq wrote (mul block-count 64))
            (saj-compress-handle-state padding state-raw block-count) ""))

    (defn saj-final-byte-list-digest (state-raw tail total-bytes)
        (if (not (eq (len tail) (mod total-bytes 64))) ""
            (do
                (let tail-bytes (saj-byte-string tail))
                (let padding-bytes
                    (saj-padding-string tail-bytes total-bytes))
                (let padding-size (str_len padding-bytes))
                (let padding (metal_buf_alloc padding-size))
                (if (le padding 0) ""
                    (do
                        (let wrote
                            (metal_buf_write padding 0 padding-bytes))
                        (let raw (saj-compress-padding-written padding
                            state-raw wrote (div padding-size 64)))
                        (let freed (metal_buf_free padding))
                        (if (and (eq freed 1) (eq (str_len raw) 32))
                            (saj-state-digest raw) ""))))))

    (defn saj-final-tail-digest (state-raw tail-bytes total-bytes)
        (if (not (eq (str_len tail-bytes) (mod total-bytes 64))) ""
            (do
                (let padding-bytes
                    (saj-padding-string tail-bytes total-bytes))
                (let padding-size (str_len padding-bytes))
                (let padding (metal_buf_alloc padding-size))
                (if (le padding 0) ""
                    (do
                        (let wrote
                            (metal_buf_write padding 0 padding-bytes))
                        (let raw (saj-compress-padding-written padding
                            state-raw wrote (div padding-size 64)))
                        (let freed (metal_buf_free padding))
                        (if (and (eq freed 1) (eq (str_len raw) 32))
                            (saj-state-digest raw) ""))))))

    ; Canonical 32 digest bytes, or "" when the carrier declines.  The Form
    ; recipe still owns padding, constants and emitted instructions; Metal is
    ; the chosen execution organ for the compression rounds.
    (defn saj-bytes-digest (bytes)
        (do
            (let total-bytes (len bytes))
            (let tail-size (mod total-bytes 64))
            (let prefix-size (sub total-bytes tail-size))
            (let prefix (saj-prefix-byte-state bytes prefix-size))
            (if (not (eq (nth prefix 2) 1)) ""
                (saj-final-byte-list-digest
                    (nth prefix 0) (nth prefix 1) total-bytes))))

    ; The current carrier has a bulk byte-list -> file door and a no-copy
    ; file -> Metal handle door, but no bulk byte-list -> Metal handle door.
    ; This explicitly named crossing uses those two existing doors so the SHA
    ; rounds take milliseconds rather than hundreds of evaluator transitions.
    ; Its directory claim is atomic, its result retains all release evidence,
    ; and a caller can turn any non-ready row toward the resident bridge above.
    (defn saj-bulk-row
        (status digest byte-count wrote file-released dir-released)
        (list "sha256-arm64-jit-bulk-byte-crossing-v1" status digest
              byte-count wrote file-released dir-released))
    (defn saj-bulk-row? (row)
        (if (eq (len row) 7)
            (str_eq (nth row 0)
                "sha256-arm64-jit-bulk-byte-crossing-v1") 0))
    (defn saj-bulk-ready? (row)
        (if (saj-bulk-row? row) (str_eq (nth row 1) "ready") 0))
    (defn saj-bulk-digest (row) (nth row 2))
    (defn saj-bulk-dir-candidate (scope stamp byte-count attempt)
        (str_concat (temp_dir)
            (str_concat "/form-sha256-jit-"
            (str_concat scope
            (str_concat "-"
            (str_concat (int_to_str stamp)
            (str_concat "-"
            (str_concat (int_to_str byte-count)
            (str_concat "-" (int_to_str attempt))))))))))
    (defn saj-bulk-claim-dir (scope stamp byte-count attempt)
        (if (ge attempt 64) (nothing)
            (do
                (let path
                    (saj-bulk-dir-candidate
                        scope stamp byte-count attempt))
                (let made (host_dir_mkdir path))
                (if (eq made 1) path
                    (saj-bulk-claim-dir
                        scope stamp byte-count (add attempt 1))))))
    (defn saj-file-digest-any-tail (path total-bytes)
        (if (lt total-bytes 0) ""
            (do
                (let tail-size (mod total-bytes 64))
                (let prefix-size (sub total-bytes tail-size))
                (let state-raw (saj-file-prefix-state path prefix-size))
                (let tail (read_file_slice path prefix-size tail-size))
                (saj-final-tail-digest state-raw tail total-bytes))))
    (defn saj-bytes-digest-bulk (bytes scope)
        (do
            (let byte-count (len bytes))
            (let dir
                (saj-bulk-claim-dir scope (now_unix_ms) byte-count 0))
            (if (nothing? dir)
                (saj-bulk-row "scratch-claim-refused" ""
                    byte-count 0 (nothing) (nothing))
                (do
                    (let path (str_concat dir "/bytes"))
                    (let wrote (file_append_bytes path bytes))
                    (let digest
                        (if (eq wrote byte-count)
                            (saj-file-digest-any-tail path byte-count) ""))
                    (let file-released (fs_remove path))
                    (let dir-released (fs_rmdir dir))
                    (if (and (eq (str_len digest) 32)
                             (and (eq file-released 0)
                                  (eq dir-released 0)))
                        (saj-bulk-row "ready" digest byte-count wrote
                            file-released dir-released)
                        (saj-bulk-row "crossing-refused" digest byte-count
                            wrote file-released dir-released))))))

    ; A cold byte-admission boundary often needs both the digest and one raw
    ; string cursor.  This sibling performs the bulk write once, reads the same
    ; bytes once, and releases the scratch carrier before returning either.
    (defn saj-carrier-row
        (status digest raw byte-count wrote file-released dir-released)
        (list "sha256-arm64-jit-byte-carrier-v1" status digest raw
              byte-count wrote file-released dir-released))
    (defn saj-carrier-row? (row)
        (if (eq (len row) 8)
            (str_eq (nth row 0) "sha256-arm64-jit-byte-carrier-v1") 0))
    (defn saj-carrier-ready? (row)
        (if (saj-carrier-row? row) (str_eq (nth row 1) "ready") 0))
    (defn saj-carrier-digest (row) (nth row 2))
    (defn saj-carrier-raw (row) (nth row 3))
    (defn saj-bytes-observe-bulk (bytes scope)
        (do
            (let byte-count (len bytes))
            (let dir
                (saj-bulk-claim-dir scope (now_unix_ms) byte-count 0))
            (if (nothing? dir)
                (saj-carrier-row "scratch-claim-refused" "" ""
                    byte-count 0 (nothing) (nothing))
                (do
                    (let path (str_concat dir "/bytes"))
                    (let wrote (file_append_bytes path bytes))
                    (let digest
                        (if (eq wrote byte-count)
                            (saj-file-digest-any-tail path byte-count) ""))
                    (let raw
                        (if (eq wrote byte-count)
                            (read_file_slice path 0 byte-count) ""))
                    (let file-released (fs_remove path))
                    (let dir-released (fs_rmdir dir))
                    (if (and (eq (str_len digest) 32)
                             (and (eq (str_len raw) byte-count)
                             (and (eq file-released 0)
                                  (eq dir-released 0))))
                        (saj-carrier-row "ready" digest raw byte-count wrote
                            file-released dir-released)
                        (saj-carrier-row "crossing-refused" digest raw
                            byte-count wrote file-released dir-released))))))

    ; Returns canonical 32 digest bytes, or an empty string on any admission
    ; failure.  The caller compares it with artifact manifest data.
    (defn saj-file-digest (path total-bytes)
        (if (or (le total-bytes 0) (ge (mod total-bytes 64) 56)) ""
            (do
                (let tail-size (mod total-bytes 64))
                (let prefix-size (sub total-bytes tail-size))
                (let state-raw (saj-file-prefix-state path prefix-size))
                (let tail (read_file_slice path prefix-size tail-size))
                (saj-final-digest-from-state state-raw tail total-bytes))))
    0)
