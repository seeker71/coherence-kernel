// sha256-arm64-jit.fk — Form-emitted SHA-256 compression for Apple arm64.
//
// Form owns the instruction image, state, constants, padding, file admission,
// and digest rendering.  The seed's door for Form-emitted CPU images
// (jit_cpu_run) installs these words through its one page door and calls them
// over the body's own bytes.  Four SHA rounds are performed by each
// SHA256H/SHA256H2 pair; SHA256SU0/SU1 extend the rolling schedule.
//
// The image's ABI (the door calls fn(bufs, consts, 1)):
//   x0 = void **buffers  [message, state, round constants]
//   x1 = uint32_t *constants  [64-byte block count]
//   x2 = 1 (unused)
//
import form-stdlib/form-asm.fk;
import form-stdlib/sha256.fk;
section [form.bml] {
    def saj-byte-string(bytes) = (Comparable) len(bytes) == 0 ? "" : ((String) byte_to_str(bytes[0]) + saj-byte-string(bytes[1:]));
    def saj-u32-le(w) = [band(w, 255), band(shr_u32(w, 8), 255), band(shr_u32(w, 16), 255), band(shr_u32(w, 24), 255)];
    def saj-u32-list-le(words) = (Comparable) len(words) == 0 ? [] : append-list(saj-u32-le(words[0]), saj-u32-list-le(words[1:]));
    def saj-initial-state-bytes() = saj-byte-string(saj-u32-list-le(sha256-h-init()));
    def saj-round-constant-bytes() = saj-byte-string(saj-u32-list-le(sha256-k()));
    def saj-msg-reg(group) = (Number) 4 + (Number) (group % 4);
    def saj-round-instructions(group) = {
        let msg = saj-msg-reg(group);
        let next = saj-msg-reg((Number) group + (Number) 1);
        let next2 = saj-msg-reg((Number) group + (Number) 2);
        let next3 = saj-msg-reg((Number) group + (Number) 3);
        let schedule = group < 4 ? [] : [fa-sha256su0(msg, next), fa-sha256su1(msg, next2, next3)];
        append-list(schedule, [fa-vorr(16, msg, msg),         // wk = message vector
fa-ldr-q(18, 5, group),         // k[group*4 .. group*4+3]
fa-vadd-s(16, 16, 18),         // wk += k
fa-vorr(17, 0, 0),         // save old abcd
fa-sha256h(0, 1, 16), fa-sha256h2(1, 17, 16)]);
    };
    def saj-rounds(group) = (Comparable) group == 16 ? [] : append-list(saj-round-instructions(group), saj-rounds((Number) group + (Number) 1));
    def saj-loop-core() = append-list([fa-vorr(2, 0, 0),     // saved abcd
fa-vorr(3, 1, 1),     // saved efgh
fa-ldr-q(4, 3, 0), fa-ldr-q(5, 3, 1), fa-ldr-q(6, 3, 2), fa-ldr-q(7, 3, 3), fa-vrev32-b(4, 4), fa-vrev32-b(5, 5), fa-vrev32-b(6, 6), fa-vrev32-b(7, 7)], append-list(saj-rounds(0), [fa-vadd-s(0, 0, 2), fa-vadd-s(1, 1, 3), fa-add-x-imm(3, 3, 64), fa-sub(6, 6, 1), fa-cmp(6, 0)]));
    def saj-instruction-list() = {
        let loop-core = saj-loop-core();
        append-list([fa-ldr(3, 0, 0),         // message buffer
fa-ldr(4, 0, 1),         // state buffer
fa-ldr(5, 0, 2),         // K buffer
fa-ldr-w(6, 1, 0),         // block count
fa-ldr-q(0, 4, 0),         // abcd
fa-ldr-q(1, 4, 1)],         // efgh
append-list(loop-core, [fa-bcond(1, 0 - len(loop-core)),         // b.ne block loop
fa-str-q(0, 4, 0), fa-str-q(1, 4, 1), fa-ret()]));
    };
    def saj-image() = fa-image(saj-instruction-list());
    def saj-code() = saj-byte-string(saj-image());
    // Convert the two little-endian Q stores back to SHA's canonical byte order.
    def saj-word-be-from-state(raw, off) = (byte_to_str(str_byte_at(raw, (Number) off + (Number) 3)) + (byte_to_str(str_byte_at(raw, (Number) off + (Number) 2)) + ((String) byte_to_str(str_byte_at(raw, (Number) off + (Number) 1)) + byte_to_str(str_byte_at(raw, off)))));
    def saj-state-digest-from(raw, off) = (Comparable) off == 32 ? "" : ((String) saj-word-be-from-state(raw, off) + saj-state-digest-from(raw, (Number) off + (Number) 4));
    def saj-state-digest(raw) = saj-state-digest-from(raw, 0);
    def saj-zero-string(count) = count <= 0 ? "" : ((String) byte_to_str(0) + saj-zero-string(count - 1));
    def saj-be64-list(n, remaining, acc) = (Comparable) remaining == 0 ? acc : saj-be64-list(n / 256, remaining - 1, cons(n % 256, acc));
    def saj-padding-block(tail-bytes, total-bytes) = {
        let used = len(tail-bytes);
        (tail-bytes + (byte_to_str(128) + ((String) saj-zero-string(55 - used) + saj-byte-string(saj-be64-list(total-bytes * 8, 8, [])))));
    };
    // ONE COMPRESSION RUN through the seed's door for Form-emitted CPU images (jit_cpu_run): [the message (a string where
    // it lies, or a file span mapped for the run), the 32 state bytes written back, the round constants] and the block
    // count; the 32 bytes answered are the eight hardware-updated state words, so a state continues across runs (the
    // resumable downloader seam). No buffer is allocated or released per run, and no carrier is asked.
    def saj-compress(message, state-raw, block-count) = !((Comparable) len(state-raw) == 32) ? "" : (Comparable) block-count == 0 ? state-raw : saj-written(jit_cpu_run([saj-image-bytes, [message, [state-raw], saj-round-bytes], [block-count]]));
    def saj-written(answer) = nothing?(answer) ? "" : answer[0];
    // THE FILE IS HASHED IN CHUNKS. SHA-256 is sequential, so the file is walked in order: each chunk is a span mapped for its run and released after, compressed from the 32-byte state the chunk before
    // left (saj-compress carries it); the state after the last chunk is the state one span over the whole file would have left, bit for bit. A chunk is a multiple of 64 (a block) and of the 16 KiB page, and
    // bounds the mapping (the 86,720,111,488 B DeepSeek-V4 IQ2XXS build is walked in 4 GiB spans); a band hands a tiny chunk to the same walk (saj-file-prefix-state-chunked) so a small synthetic file crosses many seams.
    def saj-chunk-bytes() = 4294967296;
    def saj-chunk-ok?(chunk) = chunk > 0 && (chunk % 64) == 0;
    def saj-file-prefix-state(path, byte-count) = saj-file-prefix-state-chunked(path, byte-count, saj-chunk-bytes());
    def saj-file-prefix-state-chunked(path, byte-count, chunk) = byte-count < 0 || !((Comparable) (byte-count % 64) == 0) || !saj-chunk-ok?(chunk) ? "" : (Comparable) byte-count == 0 ? saj-initial-state-bytes() : saj-chunk-walk(path, byte-count, chunk, 0, saj-initial-state-bytes());
    def saj-chunk-walk(path, byte-count, chunk, off, state-raw) = off >= byte-count ? state-raw : !((Comparable) len(state-raw) == 32) ? "" : saj-chunk-step(path, byte-count, chunk, off, state-raw, (byte-count - off) < chunk ? (byte-count - off) : chunk);
    def saj-chunk-step(path, byte-count, chunk, off, state-raw, span) = saj-chunk-walk(path, byte-count, chunk, off + span, saj-compress(["file", path, off, span], state-raw, span / 64));
    def saj-final-digest-from-state(state-raw, tail-bytes, total-bytes) = !((Comparable) len(state-raw) == 32) || (!((Comparable) len(tail-bytes) == total-bytes % 64) || len(tail-bytes) >= 56) ? "" : saj-digest-of(saj-compress(saj-padding-block(tail-bytes, total-bytes), state-raw, 1));
    def saj-digest-of(raw) = (Comparable) len(raw) == 32 ? saj-state-digest(raw) : "";
    // Unlike the older downloader helper, this padding accepts either final
    // SHA shape: one block for tails 0..55, two blocks for tails 56..63.
    def saj-padding-string(tail-bytes, total-bytes) = {
        let used = len(tail-bytes);
        let zeros = used <= 55 ? 55 - used : 119 - used;
        (tail-bytes + (byte_to_str(128) + ((String) saj-zero-string(zeros) + saj-byte-string(saj-be64-list(total-bytes * 8, 8, [])))));
    };
    def saj-final-tail-digest(state-raw, tail-bytes, total-bytes) = !((Comparable) len(tail-bytes) == total-bytes % 64) ? "" : saj-final-padded(state-raw, saj-padding-string(tail-bytes, total-bytes));
    def saj-final-padded(state-raw, padding) = saj-digest-of(saj-compress(padding, state-raw, len(padding) / 64));
    def saj-file-digest-any-tail(path, total-bytes) = saj-file-digest-any-tail-chunked(path, total-bytes, saj-chunk-bytes());
    def saj-file-digest-any-tail-chunked(path, total-bytes, chunk) = total-bytes < 0 ? "" : {
        let tail-size = total-bytes % 64;
        let prefix-size = total-bytes - tail-size;
        let state-raw = saj-file-prefix-state-chunked(path, prefix-size, chunk);
        let tail = read_file_slice(path, prefix-size, tail-size);
        saj-final-tail-digest(state-raw, tail, total-bytes);
    };
    // Returns canonical 32 digest bytes, or an empty string on any admission
    // failure.  The caller compares it with artifact manifest data.
    def saj-file-digest(path, total-bytes) = saj-file-digest-chunked(path, total-bytes, saj-chunk-bytes());
    def saj-file-digest-chunked(path, total-bytes, chunk) = total-bytes <= 0 || total-bytes % 64 >= 56 ? "" : {
        let tail-size = total-bytes % 64;
        let prefix-size = total-bytes - tail-size;
        let state-raw = saj-file-prefix-state-chunked(path, prefix-size, chunk);
        let tail = read_file_slice(path, prefix-size, tail-size);
        saj-final-digest-from-state(state-raw, tail, total-bytes);
    };
    // made once when the unit loads: the image and the constants are built byte by byte, and every run would build them
    let saj-image-bytes = saj-code();
    let saj-round-bytes = saj-round-constant-bytes();
    0;
}
