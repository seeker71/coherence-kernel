; Form-native address inquiry for the DS4 tensors needed by the next live layer stages.
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q4k-dequant.fk form-stdlib/equireach-gguf.fk native/metal/whole-tensor-residency.fk
(do
    (defn dti-path ()
        "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")
    (defn dti-num (x) (print_str (str_concat (int_to_str x) "\n")))
    (defn dti-one (src data-base off name)
        (do
            (print_str name)
            (dti-num (egg-ti-type src off))
            (dti-num (egg-ti-dim src off 0))
            (dti-num (egg-ti-dim src off 1))
            (dti-num (if (gt (egg-ti-ndims src off) 2) (egg-ti-dim src off 2) 1))
            (dti-num (add data-base (egg-ti-dataoff src off)))
            0))
    (defn dti-visit (src data-base off)
        (if (eq (egg-name-eq src off "blk.0.hc_ffn_fn.weight") 1)
            (dti-one src data-base off "blk.0.hc_ffn_fn.weight")
        (if (eq (egg-name-eq src off "blk.0.hc_ffn_scale.weight") 1)
            (dti-one src data-base off "blk.0.hc_ffn_scale.weight")
        (if (eq (egg-name-eq src off "blk.0.hc_ffn_base.weight") 1)
            (dti-one src data-base off "blk.0.hc_ffn_base.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_norm.weight") 1)
            (dti-one src data-base off "blk.0.ffn_norm.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_gate_tid2eid.weight") 1)
            (dti-one src data-base off "blk.0.ffn_gate_tid2eid.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_gate_inp.weight") 1)
            (dti-one src data-base off "blk.0.ffn_gate_inp.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_gate_exps.weight") 1)
            (dti-one src data-base off "blk.0.ffn_gate_exps.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_up_exps.weight") 1)
            (dti-one src data-base off "blk.0.ffn_up_exps.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_down_exps.weight") 1)
            (dti-one src data-base off "blk.0.ffn_down_exps.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_gate_shexp.weight") 1)
            (dti-one src data-base off "blk.0.ffn_gate_shexp.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_up_shexp.weight") 1)
            (dti-one src data-base off "blk.0.ffn_up_shexp.weight")
        (if (eq (egg-name-eq src off "blk.0.ffn_down_shexp.weight") 1)
            (dti-one src data-base off "blk.0.ffn_down_shexp.weight")
            0)))))))))))))
    (defn dti-walk (src data-base off remaining)
        (if (eq remaining 0) 0
            (do
                (dti-visit src data-base off)
                (dti-walk src data-base (egg-ti-next src off) (sub remaining 1)))))
    (defn main (arg)
        (do
            (let src (eqr-of-file (dti-path) 0 (wtr-header-window)))
            (let data-base (egg-data-base src (wtr-alignment)))
            (dti-walk src data-base (egg-tinfo-start src) (egg-tensor-count src))
            0))
    (main 0))
