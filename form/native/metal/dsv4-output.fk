; Form-owned final-logit choice and live top-candidate framebuffer for DS4.
(do
    (defn dsv4-argmax-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_argmax_f32(device const float* logits [[buffer(0)]], device uint* token [[buffer(1)]], device float* score [[buffer(2)]], constant uint& n [[buffer(3)]], uint gid [[thread_position_in_grid]]) { if (gid != 0u) return; uint ids[8]; float vals[8]; for (uint k = 0u; k < 8u; ++k) { ids[k] = 0u; vals[k] = -INFINITY; } for (uint i = 0u; i < n; ++i) { float v = logits[i]; if (!isfinite(v)) continue; for (uint k = 0u; k < 8u; ++k) { if (v > vals[k] || (v == vals[k] && i < ids[k])) { for (uint j = 7u; j > k; --j) { vals[j] = vals[j - 1u]; ids[j] = ids[j - 1u]; } vals[k] = v; ids[k] = i; break; } } } for (uint k = 0u; k < 8u; ++k) { token[k] = ids[k]; score[k] = vals[k]; } }\n")
    0)
