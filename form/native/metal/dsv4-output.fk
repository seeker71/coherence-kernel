; Form-owned final-logit choice for DS4.
(do
    (defn dsv4-argmax-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_argmax_f32(device const float* logits [[buffer(0)]], device uint* token [[buffer(1)]], device float* score [[buffer(2)]], constant uint& n [[buffer(3)]], uint gid [[thread_position_in_grid]]) { if (gid != 0u) return; uint best = 0u; float bv = -INFINITY; for (uint i = 0u; i < n; ++i) { float v = logits[i]; if (isfinite(v) && v > bv) { bv = v; best = i; } } token[0] = best; score[0] = bv; }\n")
    0)
