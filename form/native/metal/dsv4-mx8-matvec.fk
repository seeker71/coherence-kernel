; Narrow Form authority for the DS4 type-41 MXFP8 fused matvec.
; preludes: form-stdlib/mxfp8-msl.fk form-stdlib/qk-matvec-lane.fk
(do
    (defn dsv4-mx8-matvec-source ()
        (str_concat (qml-msl-header)
            (str_concat
                (mx8m-matvec-msl "form_dsv4_mx8_matvec")
                "static inline uint mx8_sf_off(uint r,uint g,uint ng){return r*ng+g;} kernel void form_dsv4_mx8_grouped_matvec (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], constant uint& nel [[buffer(5)]], constant uint& rows_per_group [[buffer(6)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint r=gid/32u; if(r>=rows)return; uint group=r/rows_per_group; uint ng=cols/32u; float sumf=0.0f; for(uint g=lane;g<ng;g+=32u){ float s=mxm_e8m0(int(qb[nel+mx8_sf_off(r,g,ng)])); uint p=r*cols+g*32u; device const float* xv=x+group*cols+g*32u; float acc=0.0f; for(uint m=0u;m<32u;m++)acc+=xv[m]*mx8_val(int(qb[p+m])); sumf+=s*acc; } float sv=metal::simd_sum(sumf); if(lane==0u)y[r]=sv; }")))
    0)
