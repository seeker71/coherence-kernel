; Narrow Form authority for the DS4 F16-weight / F32-input matvec.

(do
    (defn dsv4-f16-matvec-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_f16_matvec(device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint r [[thread_position_in_grid]]) { if (r >= rows) return; float acc = 0.0f; ulong base = (ulong)r * (ulong)cols; for (uint j = 0u; j < cols; ++j) { ushort h = *(device const ushort*)(qb + (base + (ulong)j) * 2ul); acc = acc + float(as_type<half>(h)) * x[j]; } y[r] = acc; }\n")
    0)
