; qwen35-crystal-band.fk — the frozen open equals the scanned open, witnessed.
;
; Verdict 255:
;   1   crystal file present and keyed to the live seal
;   2   scaffold ids: qsx-chat-ids == q35-chat-ids on the same prompt
;   4   every recorded layer row equals a fresh scan in all five fields
;       (offset bytes rows cols type), and opened tv shapes agree
;   8   all five fields of the recorded head rows (embd, output_norm, output)
;       equal a fresh scan, and opened tv shapes agree
;   16  required-size equals the scan's
;   32  crystal open answers the current q38 ctx shape (11 fields, handles ok)
;       and its explicit scratch span equals the scanned open's span
;   64  the same first token from both opens at pos 0
;   128 both opens release every handle
;
; preludes: native/metal/qwen35-crystal.fk

(do
    (defn qxb-tv-eq (a b)
        (if (eq (kth-tv-r a) (kth-tv-r b))
            (if (eq (kth-tv-c a) (kth-tv-c b))
                (if (eq (kth-tv-ty a) (kth-tv-ty b)) 1 0) 0) 0))
    (defn qxb-tvs-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (qxb-tv-eq (head as) (head bs)) 1)
                    (qxb-tvs-eq (tail as) (tail bs)) 0))))
    (defn qxb-lays-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (qxb-tvs-eq (head as) (head bs)) 1)
                    (qxb-lays-eq (tail as) (tail bs)) 0))))
    (defn qxb-row-tv-shape-eq (row tv)
        (if (eq (nth row 2) (kth-tv-r tv))
            (if (eq (nth row 3) (kth-tv-c tv))
                (if (eq (nth row 4) (kth-tv-ty tv)) 1 0) 0) 0))
    (defn qxb-row-eq (a b)
        (if (eq (nth a 0) (nth b 0))
            (if (eq (nth a 1) (nth b 1))
                (if (eq (nth a 2) (nth b 2))
                    (if (eq (nth a 3) (nth b 3))
                        (if (eq (nth a 4) (nth b 4)) 1 0) 0) 0) 0) 0))
    (defn qxb-rows-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (qxb-row-eq (head as) (head bs)) 1)
                    (qxb-rows-eq (tail as) (tail bs)) 0))))
    (defn qxb-layer-rows-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (qxb-rows-eq (head as) (head bs)) 1)
                    (qxb-layer-rows-eq (tail as) (tail bs)) 0))))
    (defn qxb-ids-eq (as bs)
        (if (eq (len as) 0) (if (eq (len bs) 0) 1 0)
            (if (eq (len bs) 0) 0
                (if (eq (head as) (head bs)) (qxb-ids-eq (tail as) (tail bs)) 0))))
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let x (qsx-load path))
    (let src (eqr-of-file path 0 40000000))
    (let base (egg-data-base src 32))
    (let tabs (q38-tabs src))
    (let fresh-layer-rows
        (qsx-all-layer-rows src base tabs 0 (nth x 10) (nth x 11) (empty)))
    (let fresh-head-rows
        (list (qsx-row src base (egg-find-tensor src "token_embd.weight"))
              (qsx-row src base (egg-find-tensor src "output_norm.weight"))
              (qsx-row src base (egg-find-tensor src "output.weight"))))
    (let scan-ids (q35-chat-ids src "band"))
    (let ice-ids (qsx-chat-ids src "band" x))
    (let scan-req (q38-required-size src base))
    (let ctx-scan (q38-open path 32))
    (let ctx-ice (qsx-open path 32 x))
    (let sts-a (q38-new-state (nth ctx-scan 2)))
    (let sts-b (q38-new-state (nth ctx-ice 2)))
    (let tok-a (q38-forward (nth ctx-scan 0) (nth ctx-scan 1) (nth ctx-scan 2) (nth ctx-scan 3)
                            sts-a (nth ctx-scan 4) (nth ctx-scan 5) (nth ctx-scan 6) (head scan-ids) 0))
    (let tok-b (q38-forward (nth ctx-ice 0) (nth ctx-ice 1) (nth ctx-ice 2) (nth ctx-ice 3)
                            sts-b (nth ctx-ice 4) (nth ctx-ice 5) (nth ctx-ice 6) (head ice-ids) 0))
    (let rel-a (if (eq (q38-close ctx-scan sts-a) (q38-close-expected ctx-scan sts-a)) 1 0))
    (let rel-b (if (eq (q38-close ctx-ice sts-b) (q38-close-expected ctx-ice sts-b)) 1 0))
    (add (if (eq (nth x 0) 1) 1 0)
    (add (if (eq (qxb-ids-eq scan-ids ice-ids) 1) 2 0)
    (add (if (and (eq (qxb-layer-rows-eq (nth x 12) fresh-layer-rows) 1)
                  (eq (qxb-lays-eq (nth ctx-scan 3) (nth ctx-ice 3)) 1)) 4 0)
    (add (if (and (eq (qxb-rows-eq
                            (list (nth x 13) (nth x 14) (nth x 15))
                            fresh-head-rows) 1)
                  (and (eq (qxb-row-tv-shape-eq (nth x 13) (nth ctx-scan 4)) 1)
                       (and (eq (qxb-row-tv-shape-eq (nth x 14) (nth ctx-scan 5)) 1)
                            (eq (qxb-row-tv-shape-eq (nth x 15) (nth ctx-scan 6)) 1)))) 8 0)
    (add (if (eq (qsx-required x) scan-req) 16 0)
    (add (if (and (eq (len ctx-ice) 11)
                  (and (eq (q38-context-ok? ctx-ice) 1)
                       (eq (q38-ctx-span ctx-ice) (q38-ctx-span ctx-scan)))) 32 0)
    (add (if (eq tok-a tok-b) 64 0)
         (if (if (eq rel-a 1) (eq rel-b 1) 0) 128 0)))))))))
