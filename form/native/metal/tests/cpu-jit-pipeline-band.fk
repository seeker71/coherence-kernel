; cpu-jit-pipeline-band.fk — Form emits AArch64, the unified handle carrier
; installs it with MAP_JIT, and the emitted function mutates a real buffer.
;
; Signature fixed by the carrier membrane:
;   x0 = void **buffers, x1 = uint32_t *constants, x2 = thread count.
;
; preludes: form-stdlib/form-asm.fk form-stdlib/metal-door.fk

(do
    (defn cjpb-byte-string (bytes)
        (if (eq (len bytes) 0) ""
            (str_concat (byte_to_str (head bytes))
                        (cjpb-byte-string (tail bytes)))))
    (let image
        (fa-image (list
            (fa-ldr 3 0 0)       ; x3 = buffers[0]
            (fa-ldr-w 4 1 0)     ; w4 = constants[0]
            (fa-ldr-w 5 3 0)     ; w5 = buffers[0][0]
            (fa-add-r 5 5 4)     ; w5 += w4
            (fa-str-w 5 3 0)     ; buffers[0][0] = w5
            (fa-ret))))
    (let code (cjpb-byte-string image))
    (let buffer (metal_buf_alloc 4))
    (metal_buf_write buffer 0 (md-le32 7))
    (let pipeline (metal_pipeline code "form_cpu_jit"))
    (let same-pipeline (metal_pipeline code "form_cpu_jit"))
    (let enqueued (metal_enqueue pipeline (md-bind (list buffer) (list 5)) 1))
    (let result (metal_buf_read buffer 0 4))
    (let status (metal_status))
    (let freed (metal_buf_free buffer))
    (sum (list
        (if (gt pipeline 0) 1 0)
        (if (eq same-pipeline pipeline) 2 0)
        (if (eq enqueued 1) 4 0)
        (if (and (eq (str_len result) 4)
                 (and (eq (str_byte_at result 0) 12)
                  (and (eq (str_byte_at result 1) 0)
                   (and (eq (str_byte_at result 2) 0)
                        (eq (str_byte_at result 3) 0))))) 8 0)
        (if (ge (str_find status "cpu_jit_dispatch=1" 0) 0) 16 0)
        (if (eq freed 1) 32 0))))
