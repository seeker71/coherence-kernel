; qwen4exp-flash-next-layout-band.fk — static layout index contract.
;
; preludes: form/native/metal/qwen4exp-flash-next-layout.fk
;
; Verdict 255. Live mapping is a separate observer.

(do
    (defn q4glb-bit (ok bit) (if ok bit 0))
    (let s (q4gl-suffixes))
    (let c0 (q4glb-bit (eq (len s) 35) 1))
    (let c1 (q4glb-bit (str_eq (nth s 0) ".hc_attn_norm.weight") 2))
    (let c2 (q4glb-bit (str_eq (nth s 8) ".ffn_gate_inp.weight") 4))
    (let c3 (q4glb-bit (str_eq (nth s 16) ".attn_qkv.weight") 8))
    (let c4 (q4glb-bit (str_eq (nth s 25) ".attn_q.weight") 16))
    (let c5 (q4glb-bit (str_eq (nth s 31) ".indexer.q_proj.weight") 32))
    (let c6 (q4glb-bit (if (eq (q4g-full 3) 1) (eq (q4g-full 2) 0) 0) 64))
    (let c7 (q4glb-bit (if (eq (q4g-ple 1) 1) (eq (q4g-ple 0) 0) 0) 128))
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7))))))))
