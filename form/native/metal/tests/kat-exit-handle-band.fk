; tests/kat-exit-handle-band.fk — does a FORM CELL holding the loop reproduce metal_kat_exit.sh?
;
; PROOF LEVEL: FOURTH-ARM ONLY. Bit 1 is the canary; without a live handle door the fold answers 0,
; which is a refusal and not a verdict. A skip is not a pass.
;
; Verdict 63 = 1 + 2 + 4 + 8 + 16 + 32, power-of-two weights so a reader can subtract a failure out
; of the total instead of guessing which of several decimal digits moved.
;
;   bit  1  THE DOOR IS REAL. metal_status says metal_linked=true AND metal_door=handle. Every
;           other primitive in this path answers an integer and a numb call answers 0, so this is
;           the only one whose answer cannot be counterfeited. Asked before anything else.
;   bit  2  THE GEOMETRY IS THE FILE'S. token_embd is Q3_K (11), output is Q8_0 (8), output_norm is
;           F32 (0), read from the tensor table — and the three byte lengths kxh-bytes prices from
;           those types are all positive. The types are CHECKED rather than assumed because a
;           length computed with the wrong pricing maps a region that exists and decodes to noise:
;           that is the failure this body calls numb-green, right-shaped and wrong-meaning.
;   bit  4  EVERY KERNEL COMPILED. Four nonzero pipeline handles. A zero is an MSL diagnostic the
;           carrier is holding, and dispatching past it reads a zeroed buffer back as an id.
;   bit  8  THE 17 GB FILE IS WRAPPED, NOT COPIED. Three no-copy buffers: the embedding row, the
;           F32 gains, and the 540 MB Q8_0 projection. The carrier RECORDS a fallback to copying
;           rather than hiding it, so this count is evidence and not decoration.
;   bit 16  THE ID AGREES WITH THE ATTESTANT. Token 100 through embed -> output_norm -> the
;           vocabulary projection -> a greedy pick gives 3637. That is metal_kat_exit.sh's answer,
;           re-witnessed on this machine on 2026-08-04 (logit 10.066510 over 248 320 rows) rather
;           than quoted from yesterday's receipt.
;   bit 32  THE LOOP CARRIES. Four steps, each feeding its own id back in: 16 dispatches, 4 syncs —
;           one per step, at the four bytes of readback. The exit path holds no state between
;           steps, so the ids CYCLE, and that cycle is the honest signature of a memoryless path
;           rather than a defect. What is proven here is the carriage, not a continuation.
;
; WHAT BIT 16 CANNOT SEE, FOUND BY MUTATING IT AND BEING WRONG. The prediction written before the
; run was that feeding the vocabulary projection the RAW embedding instead of the normed vector
; would drop bit 16 and give 47. It gave 63: the argmax was still 3637. The first explanation to
; reach for is that RMSNorm is a positive scalar multiple and an argmax cannot see one — but that
; explanation is false here, and it was checked rather than assumed: KAT's output_norm gains run
; from 0.767578125 to 3.484375 over all 2048 entries, so the norm genuinely turns the vector. The
; winner survives the turn anyway. So bit 16 is sensitive to the norm being THERE (mutation M-K3
; sent its output to a different buffer, left the projection reading zeros, and the bit fell to 47
; exactly as predicted) and is NOT sensitive to the norm's GAIN VECTOR being right. A gain vector
; quietly read from the wrong offset would pass this band. That is a hole, it is named, and it is
; not repaired by rewording the bit: closing it needs a reference the body computes in fp64, the
; way metal_first_token.sh's gates 2-4 judge three points on the token's own path. UNFINISHED.
;
; WHAT THIS BAND MUST NOT BE READ AS SAYING. The vector handed to the projection is the EMBEDDING,
; not the hidden state of 41 blocks. So 3637 is a MECHANISM witness and not the token KAT-Coder
; would emit. metal_kat_exit.sh says exactly this about itself and the claim does not get larger by
; being reproduced through a different door. What is new here is who held the loop.
;
; preludes: native/metal/kat-exit-handle.fk

(do
    (defn keb-token () 100)

    (let live (md-door-live?))

    (let h (kce-hdr))
    (let base (egg-data-base h (kce-align)))
    (let oe (egg-find-tensor h "token_embd.weight"))
    (let oo (egg-find-tensor h "output.weight"))
    (let onm (egg-find-tensor h "output_norm.weight"))
    (let ne0 (egg-ti-dim h oe 0))
    (let rows (egg-ti-dim h oo 1))
    (let cols (egg-ti-dim h oo 0))
    (let rowBytes (kxh-bytes (egg-ti-type h oe) ne0))
    (let outBytes (kxh-bytes (egg-ti-type h oo) (mul rows cols)))
    (let normBytes (kxh-bytes (egg-ti-type h onm) ne0))

    (let geo-ok (if (eq (egg-ti-type h oe) 11)
                    (if (eq (egg-ti-type h oo) 8)
                        (if (eq (egg-ti-type h onm) 0)
                            (if (gt rowBytes 0) (if (gt outBytes 0) (gt normBytes 0) false) false)
                            false)
                        false)
                    false))

    (let msl (kxh-msl))
    (let pQ3 (metal_pipeline msl "form_q3k_dequant_f32"))
    (let pNrm (metal_pipeline msl "form_mla_rmsnorm_f32"))
    (let pMv (metal_pipeline msl "form_q8_0_matvec_f32"))
    (let pArg (metal_pipeline msl "form_argmax_f32"))
    (let pipes-ok (if (gt pQ3 0) (if (gt pNrm 0) (if (gt pMv 0) (gt pArg 0) false) false) false))

    (let normH (metal_buf_from_file (kce-path) (add base (egg-ti-dataoff h onm)) normBytes))
    (let outH (metal_buf_from_file (kce-path) (add base (egg-ti-dataoff h oo)) outBytes))
    (let bEmb (metal_buf_alloc (mul ne0 4)))
    (let bH (metal_buf_alloc (mul ne0 4)))
    (let bLog (metal_buf_alloc (mul rows 4)))
    (let bOutI (metal_buf_alloc 16))
    (let bOutV (metal_buf_alloc 16))

    (let c (list (kce-path) ne0 (div ne0 256) normH rows cols pQ3 pNrm pMv pArg
                 bEmb bH bLog bOutI bOutV outH (add base (egg-ti-dataoff h oe)) rowBytes
                 (md-f32-bits (div 1.0 1000000.0))))

    (let one (kxh-step c (keb-token)))
    ; the embedding row is a fresh no-copy view per step, so the count grows with the loop; the
    ; three that matter are the ones taken before any step ran.
    (let resident (md-status-has? "mmap_nocopy_buffers=3"))

    (let ids (kxh-steps c (keb-token) 4 (empty)))
    (let shape-ok (if (md-status-has? "total_dispatch=20") (md-status-has? "total_sync=5") false))

    (add (if live 1 0)
    (add (if live (if geo-ok 2 0) 0)
    (add (if live (if pipes-ok 4 0) 0)
    (add (if live (if resident 8 0) 0)
    (add (if live (if (eq one 3637) 16 0) 0)
         (if live (if (eq (len ids) 4) (if shape-ok 32 0) 0) 0)))))))
