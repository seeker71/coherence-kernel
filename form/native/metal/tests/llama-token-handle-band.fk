; tests/llama-token-handle-band.fk — does a FORM CELL holding the decode loop produce the
; attestant's tokens?
;
; PROOF LEVEL: FOURTH-ARM ONLY (metal_* pf-arm-mask 8, probed 2026-09-03). Every bit below needs a live Metal device behind the handle door,
; which only fkwu on a Mac has (Metal linked automatically by validate.sh's build_fkwu_src). On
; any other arm this is not a failure and must not be reported as one — bit 1 is the canary and
; the fold answers 0 without it, which is a REFUSAL, not a verdict. A skip is not a pass and a
; zero is not a pass either.
;
; Verdict 255 = 1 + 2 + 4 + 8 + 16 + 32 + 64 + 128. POWER-OF-TWO BIT WEIGHTS, so the number names
; exactly which claims held: a decimal-digit fold rounds past its fifteenth reading on the TS arm
; and two different failures can share a total. There is no arm here but the fourth, and the rule
; is kept anyway, because the point of the weights is that a reader can subtract.
;
;   bit   1  THE DOOR IS REAL. metal_status says metal_linked=true AND metal_door=handle. Asked
;            first and asked of the one primitive that SPEAKS: every other call in this band
;            answers an integer, and an unbound name under axiom 5 recovers to nothing and answers
;            0, so a numb call and a refusal are the same shape. Nothing below is believed without
;            this.
;   bit   2  THE GEOMETRY IS THE FILE'S. block_count, embedding_length, feed_forward_length, the
;            two head counts, rope.dimension_count and vocab_size are read from the blob's own
;            metadata KVs and are self-consistent (head_dim * head_count == embedding_length, and
;            head_count divisible by head_count_kv). Not one of them is typed into this band as an
;            expected value, because a band that asserts 3072 is a band that passes on a file it
;            never read.
;   bit   4  EVERY KERNEL COMPILED. All eleven pipelines answer a nonzero handle. A zero here is
;            an MSL diagnostic the carrier is holding in metal_status, and dispatching past it
;            would run nothing and read back a zeroed buffer as an id.
;   bit   8  THE WEIGHTS ARE RESIDENT AND NOT COPIED. metal_status reports 256 no-copy buffers —
;            255 tensor views plus rope_freqs — so the model's own page-cache pages are what the
;            GPU reads. A fallback to copying is RECORDED by the carrier, not silent, and it would
;            move this count.
;   bit  16  ONE TOKEN AGREES WITH THE ATTESTANT. Prompt [128000, 791, 6864, 315, 9822, 374] into
;            the loop, and the first generated id is 12366. That id is metal_first_token.sh's, on
;            this blob, re-witnessed 2026-08-04 rather than quoted from a document.
;   bit  32  THE STREAM AGREES, ALL TWELVE. Not the first id alone: an embedding gather and a
;            vocabulary projection that are right at position 0 say nothing about a KV cache, and
;            the KV cache is the part of this port that could not be a bind and had to become a
;            move. Twelve ids is twelve positions of cache reuse.
;   bit  64  THE LOOP NEVER WAITS. 8177 dispatches over 17 forwards (481 per token: the two-stage
;            argmax is one dispatch more than the single-thread scan was) and exactly 17 syncs —
;            one per token, at the four bytes of readback, and nowhere else. This is the bit that
;            proves the SHAPE the seam measurement asked for, now over CONCURRENT batches whose
;            hazards the cell declares itself.
;   bit 128  THE BODY READS ITS OWN ANSWER. The twelve ids through the body's own detokenizer spell
;            " Paris. The capital of Italy is Rome. The capital of" — the attestant's text, with no
;            host anywhere in the path.
;
; WHAT THIS BAND CANNOT SEE, said here so nobody reads it as saying more. It does not gate the
; tokenizer: the prompt ids are the attestant's, so that the decode path is judged alone. It does
; not gate speed. And it speaks for GGUF v3 llama-architecture files whose quantization is
; Q6_K/Q4_K/F32 — wtr-bytes prices nothing else and would map a length of 0.
;
; preludes: native/metal/llama-token-handle.fk form-stdlib/llama3-detokenize.fk form-stdlib/model-registry.bml

(do
    (defn ltb-blob () (mr-path (mr-find "llama32-3b")))
    (defn ltb-prompt () (list 128000 791 6864 315 9822 374))
    (defn ltb-want () (list 12366 13 578 6864 315 15704 374 22463 13 578 6864 315))
    (defn ltb-want-text () " Paris. The capital of Italy is Rome. The capital of")

    (defn ltb-eqlist (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) true
                (if (eq (head a) (head b)) (ltb-eqlist (tail a) (tail b)) false))
            false))

    ; The door first, and nothing else believed without it.
    (let live (md-door-live?))

    (let src (lth-src (ltb-blob)))
    (let base (egg-data-base src (wtr-alignment)))
    (let nLayer (gmt-u32 src "llama.block_count"))
    (let dModel (gmt-u32 src "llama.embedding_length"))
    (let dFF (gmt-u32 src "llama.feed_forward_length"))
    (let nHead (gmt-u32 src "llama.attention.head_count"))
    (let nKV (gmt-u32 src "llama.attention.head_count_kv"))
    (let headDim (gmt-u32 src "llama.rope.dimension_count"))
    (let vocabN (gmt-u32 src "llama.vocab_size"))
    (let ropeBase (gmt-f32 src "llama.rope.freq_base"))
    (let rmsEps (gmt-f32 src "llama.attention.layer_norm_rms_epsilon"))

    ; SELF-CONSISTENT, not equal to a number this band remembers.
    (let geo-ok (if (gt nLayer 0)
                    (if (eq (mul headDim nHead) dModel)
                        (if (eq (mod nHead nKV) 0)
                            (if (gt dFF 0) (if (gt vocabN 0) (gt ropeBase 0.0) false) false)
                            false)
                        false)
                    false))

    (let kvd (mul nKV headDim))
    (let maxpos 256)
    (let ps (lth-pipes (lth-msl)))
    (let pipes-ok (lth-pipe-ok? ps))

    (let bs (lth-bufs dModel dFF vocabN nHead maxpos))
    (let lays (lth-layers src base (ltb-blob) 0 nLayer (empty)))
    (let cks (lth-cache nLayer kvd maxpos (empty)))
    (let cvs (lth-cache nLayer kvd maxpos (empty)))
    (let embTv (lth-tv src base (ltb-blob) "token_embd.weight"))
    (let onormTv (lth-tv src base (ltb-blob) "output_norm.weight"))
    (let projTv (lth-out-tv src base (ltb-blob)))
    (let ropeH (lth-tv-h (lth-tv src base (ltb-blob) "rope_freqs.weight")))
    (let resident (md-status-has? "mmap_nocopy_buffers=256"))

    (let g (list dModel dFF nHead nKV headDim kvd maxpos vocabN
                 (md-f32-bits rmsEps) (md-f32-bits ropeBase)
                 (md-f32-bits (div 1.0 (math_sqrt (add headDim 0.0)))) ropeH nLayer))

    (let pf (lth-prefill ps bs g lays cks cvs embTv onormTv projTv (ltb-prompt) 0))
    (let first (nth pf 0))
    (let rest (lth-generate ps bs g lays cks cvs embTv onormTv projTv first 6 11 (empty)))
    (let got (append (list first) rest))

    ; ONE SYNC PER FORWARD, and the dispatch count that goes with it. Read out of the carrier's own
    ; counters rather than counted here, so an edit to lth-block moves the number instead of
    ; agreeing with a hand tally that stopped being true.
    (let shape-ok (if (md-status-has? "total_dispatch=8177") (md-status-has? "total_sync=17") false))

    (let text (l3d-text src got))

    (add (if live 1 0)
    (add (if live (if geo-ok 2 0) 0)
    (add (if live (if pipes-ok 4 0) 0)
    (add (if live (if resident 8 0) 0)
    (add (if live (if (eq first 12366) 16 0) 0)
    (add (if live (if (ltb-eqlist got (ltb-want)) 32 0) 0)
    (add (if live (if shape-ok 64 0) 0)
         (if live (if (str_eq text (ltb-want-text)) 128 0) 0)))))))))
