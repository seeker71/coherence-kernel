// qwen35-dense-spec-identity-band.bml — speculative decoding says what the plain greedy decode says, on the real Qwen3.8-27B Q8_0.
//
// The model opens once (under the memory lease). Three prompts, each decoded plain and speculatively from fresh states, ids and the
// winning logit's bits compared position by position (form-stdlib/bml/qwen38-spec-witness.bml):
//   1   the sky prompt, 2 drafts, 32 tokens: the same ids, and the head's winning-logit word equal at every one of the 32 positions
//   2   those ids are the 32 the lane has always said for that prompt (12515 7701 6105 ... 18016 13)
//   4   a code prompt, 3 drafts (every draft position accepted, four tokens a step), 32 tokens: the same ids, every word equal
//   8   an arbitrary 40-id prompt, 3 drafts, 40 tokens: the same ids, every word equal, AND drafts were rejected (the recurrent state was
//       restored from its snapshots and the decode went on exactly as the plain one did)
//   16  the speculation spoke more than a token a step on the sky and code prompts
//   32  the code prompt again with the adaptive policy (at most 5 drafts a step, the number chosen from the acceptance seen): the same ids,
//       every winning-logit word equal
// The band writes nothing and leaves the lease released. It needs the 29 GB file and a Metal device: seconds of decode, about a minute
// of opening; run it inside the GPU quiet window like every timed lane.
// Verdict 63
// REQUIRES: a live Metal device and the Qwen3.8-27B-Q8_0.gguf
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/form-cli-model-session.fk native/metal/qwen35-dense-spec.fk form-stdlib/bml/qwen38-spec-witness.bml
section [form.bml] {
 class Q38SpecIdentityBand {
  def qib-file() = "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
  def qib-pinned() = "12515 7701 6105 1521 33470 303 279 8964 579 16078 43000 22602 89661 314 37728 11 1680 430 6105 321 76990 11 777 13057 1056 4860 89661 1040 2438 321 18016 13 ";
  def qib-ids(n, i) = i >= n ? [] : cons(1000 + ((i * 37) % 5000), qib-ids(n, i + 1));
  def qib-say(s) = print_str("[q38-spec-identity] " ++ s);
  // the same ids and every winning-logit word equal
  def qib-exact(w) = (w[0] == 1) && (w[2] == 0) ? 1 : 0;
  def qib-hits(stats, j, k) = j > k ? "" : " p" ++ j.str() ++ " " ++ q38sw-hits(stats, j).str() ++ qib-hits(stats, j + 1, k);
  def qib-show(label, w, k) = qib-say(label ++ ": ids " ++ (w[0] == 1 ? "identical" : "DIFFER") ++ ", winning-logit words equal " ++ w[1].str() ++ ", differ " ++ w[2].str() ++ ", " ++ q38sw-steps(w[3]).str() ++ " steps, steps that took draft position" ++ qib-hits(w[3], 1, k));
  def qib-three(ctx, qs, src) {
   let sx = q38s-open(ctx, 5, 48);
   let sky = q38sw-compare(ctx, qs, sx, q35-chat-ids(src, "Explain in two sentences why the sky is blue."), 32, 2);
   let shown1 = qib-show("sky k=2", sky, 2);
   let code = q38sw-compare(ctx, qs, sx, q35-chat-ids(src, "Write a Python function that checks whether a string is a palindrome."), 32, 3);
   let shown2 = qib-show("code k=3", code, 3);
   let syn = q38sw-compare(ctx, qs, sx, qib-ids(40, 0), 40, 3);
   let shown3 = qib-show("arbitrary ids k=3", syn, 3);
   let ada = q38sw-compare-a(ctx, qs, sx, q35-chat-ids(src, "Write a Python function that checks whether a string is a palindrome."), 32, 5, 1);
   let shown4 = qib-show("code adaptive<=5", ada, 5);
   let closed = q38s-close(sx);
   let b32 = qib-exact(ada) == 1 ? 32 : 0;
   let b1 = qib-exact(sky);
   let b2 = (String) q38sw-idstr(sky[4]) == qib-pinned() ? 2 : 0;
   let b4 = qib-exact(code) == 1 ? 4 : 0;
   let rejected = q38sw-hits(syn[3], 3) < q38sw-steps(syn[3]) ? 1 : 0;
   let b8 = (qib-exact(syn) == 1) && (rejected == 1) ? 8 : 0;
   let b16 = (q38sw-steps(sky[3]) < 32) && (q38sw-steps(code[3]) < 32) ? 16 : 0;
   qib-say("bits " ++ b1.str() ++ " " ++ b2.str() ++ " " ++ b4.str() ++ " " ++ b8.str() ++ " " ++ b16.str() ++ " " ++ b32.str() ++ "; arbitrary-ids steps that rejected a draft: " ++ (q38sw-steps(syn[3]) - q38sw-hits(syn[3], 3)).str());
   b1 + b2 + b4 + b8 + b16 + b32;
  }
  def qib-open(path) {
   let src = fcmg-src(path);
   let maxpos = 48 + 40 + 3 + 16;
   let own = fcms-qwen-own(src, maxpos);
   let weights = fcms-weights-bytes(path);
   let granted = mg-lease("q38 spec identity band", path, weights, own);
   !mg-granted?(granted) ? qib-held(granted) : qib-leased(path, src, maxpos);
  }
  def qib-held(granted) {
   qib-say("held: " ++ granted[1]);
   0;
  }
  def qib-leased(path, src, maxpos) {
   let ctx = q38-open-span(path, maxpos, 49);
   let verdict = (Comparable) q38-context-ok?(ctx) == 1 ? qib-opened(ctx, src) : 0;
   let unleased = mg-release();
   verdict;
  }
  def qib-opened(ctx, src) {
   let qs = q38s-pipes(q38s-msl());
   let v = q38s-pipes-ok?(qs) ? qib-three(ctx, qs, src) : 0;
   let closed = q38-close(ctx, []);
   v;
  }
  def qib-run() = qib-open(qib-file());
 }
 qib-run();
}
