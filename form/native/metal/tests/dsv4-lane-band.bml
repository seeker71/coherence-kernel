 let r512 = try (String) u1 == "hi" && (String) u2 == "h\\xf0\\x9f\\x98" && str_len(u3) == 4 && str_byte_at(u3, 0) == 240 && str_byte_at(u3, 3) == 128 && (String) u4 == "a\\xc3" && str_len(u5) == 3 && (String) u6 == "\\xe2\\x82"
