 let r32 = try len(ctx2) == 13 && fcms-maxpos(s2) == 2048 && len(ids3) == 9 && (String) fcms-ending(s2c) == "context-limit" && fcms-pos(s2c) == 2049 && fcms-pending(s2c) == 0 - 1
