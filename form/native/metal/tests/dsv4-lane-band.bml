 let r64 = try kStop > 0 && stopId >= 0 && stopId < 32 && fcds-stops(srcB) == [stopId] && ids5 == walkA[0:kStop] && (String) fcms-ending(s3b) == "eos" && fcms-pending(s3b) == stopId && fcms-live?(s3b) == 1 && (String) oneStop[0] == "ok" && oneStop[2] == walkA[0:kStop] && (String) oneStop[4] == "eos"
