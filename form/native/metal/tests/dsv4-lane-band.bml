 // 1024: a second state the driver refused, and a prefill that stops, end the renewal by name with the first stream intact
 let sR = fcms-open-reserved(pathA, dlb-prompt(), dlb-n(), "full");
 let liveR = dvb-live();
 let readingR = fcmr-reading("dsv4-lane-band", "independent-stream-needed", 0, json-node-string("fresh conversation state"), json-node-string("existing conversation state"));
