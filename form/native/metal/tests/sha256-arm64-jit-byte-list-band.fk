; sha256-arm64-jit-byte-list-band.fk -- byte-list messages reach the existing
; Form-emitted Apple arm64 SHA-256 compressor without a filesystem crossing.
;
; The boundary cases witness both legal padding shapes.  The larger row
; witnesses that the bridge streams bounded 64-byte strings into one resident
; buffer rather than materializing a second whole-message string.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/sha256.fk form-stdlib/str-byte-at.fk form-stdlib/hex.fk form-stdlib/metal-door.fk native/metal/sha256-arm64-jit.fk

(do
    (defn sajbl-bytes (remaining seed acc)
        (if (eq remaining 0) (reverse acc)
            (sajbl-bytes (sub remaining 1) (add seed 17)
                (cons (mod seed 256) acc))))
    (defn sajbl-same? (bytes)
        (str_eq (saj-bytes-digest bytes)
                (saj-byte-string (sha256 bytes))))

    (let b0 (list))
    (let b3 (list 97 98 99))
    (let b55 (sajbl-bytes 55 3 (list)))
    (let b56 (sajbl-bytes 56 5 (list)))
    (let b63 (sajbl-bytes 63 7 (list)))
    (let b64 (sajbl-bytes 64 11 (list)))
    (let b65 (sajbl-bytes 65 13 (list)))
    (let b4096 (sajbl-bytes 4096 19 (list)))
    (let bulk (saj-bytes-digest-bulk b4096 "byte-list-band"))
    (let carrier (saj-bytes-observe-bulk b4096 "byte-list-band-carrier"))
    (sum (list
        (if (sajbl-same? b0) 1 0)
        (if (sajbl-same? b3) 2 0)
        (if (sajbl-same? b55) 4 0)
        (if (sajbl-same? b56) 8 0)
        (if (sajbl-same? b63) 16 0)
        (if (sajbl-same? b64) 32 0)
        (if (sajbl-same? b65) 64 0)
        (if (sajbl-same? b4096) 128 0)
        (if (and (saj-bulk-ready? bulk)
                 (str_eq (saj-bulk-digest bulk)
                         (saj-byte-string (sha256 b4096)))) 256 0)
        (if (and (saj-carrier-ready? carrier)
                 (and (str_eq (saj-carrier-digest carrier)
                              (saj-byte-string (sha256 b4096)))
                      (eq (str_len (saj-carrier-raw carrier)) 4096)))
            512 0))))
