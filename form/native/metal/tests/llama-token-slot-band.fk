; tests/llama-token-slot-band.fk — does the SLOT rung produce the attestant's stream, inside the
; bound it states?
;
; PROOF LEVEL: FOURTH-ARM ONLY, exactly as its sibling: every bit needs a live Metal device behind
; the handle door. On any other arm bit 1 stays 0 and the fold answers 0 — a REFUSAL, not a
; verdict. A skip is not a pass and a zero is not a pass either.
;
; PREREGISTERED before its first run, 2026-08-18: predicted verdict 255. The twelve want-ids are
; the attestant band's own pinned literals, unchanged — the slot rung is valid only if the stream
; a person receives is the SAME stream. The pace is printed, never gated: passing means the stream
; is valid, nothing more, nothing less.
;
; Verdict 255 = 1+2+4+8+16+32+64+128, POWER-OF-TWO BIT WEIGHTS so a reader can subtract:
;   bit   1  THE DOOR IS REAL. metal_status: metal_linked=true AND metal_door=handle.
;   bit   2  THE WIDTHS ARE ADMISSIBLE. qsl-admissible? — cols a whole multiple of 256 — asked of
;            every width the twins will walk: dModel, dFF, kvd, and the LM head's cols, all read
;            from the blob's own metadata, none typed here as a number.
;   bit   4  EVERY KERNEL COMPILED, the attestant's fifteen AND the three twins (Q6_K slot,
;            Q4_K slot4, Q4_K slot4c — the 2026-08-18 composed stone): all eighteen pipelines
;            answer a nonzero handle.
;   bit   8  THE WEIGHTS ARE RESIDENT AND NOT COPIED. mmap_nocopy_buffers=256, as the sibling.
;   bit  16  THE FIRST TOKEN AGREES: id 12366.
;   bit  32  THE STREAM AGREES, ALL TWELVE — twelve positions of KV-cache reuse through the twins.
;   bit  64  THE BOUND HOLDS WHERE IT IS STATED. On the final forward's LM head (Q6_K, the
;            decisive row family), the serial attestant kernel is dispatched beside the slot's on
;            the SAME resident x, and for eight real full-width rows — the seven distinct ids of
;            the stream and row 0 — the band computes B_r = SUM_j |w_rj * x_j| in Form from the
;            blob's own bytes (q6m-flat-at) and the drained x, and checks
;            |slot_r − serial_r| <= (qsl-bound-coeff cols) * 2^-24 * B_r  on every probe row.
;            The whole-tensor witness is tests/qk-matvec-split-band.fk; this re-checks the same
;            inequality at the exact place the token was decided.
;   bit 128  THE BODY READS ITS OWN ANSWER: the twelve ids detokenize to the attestant's text.
;
; WHAT THIS BAND CANNOT SEE: the tokenizer (prompt ids are the attestant's, decode judged alone);
; the Q4_K parity stone still owed (named in qk-matvec-slot.fk, measured 1.57–1.67x of ggml); and
; any width whose cols is not a multiple of 256 — qsl-admissible? refuses those to the serial lane.
;
; preludes: native/metal/llama-token-slot.fk form-stdlib/llama3-detokenize.fk

(do
    (defn lsb-blob () "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff")
    (defn lsb-prompt () (list 128000 791 6864 315 9822 374))
    (defn lsb-want () (list 12366 13 578 6864 315 15704 374 22463 13 578 6864 315))
    (defn lsb-want-text () " Paris. The capital of Italy is Rome. The capital of")
    (defn lsb-probe-rows () (list 12366 13 578 6864 315 15704 22463 0))

    (defn lsb-eqlist (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) true
                (if (eq (head a) (head b)) (lsb-eqlist (tail a) (tail b)) false))
            false))
    (defn lsb-abs (v) (if (lt v 0.0) (sub 0.0 v) v))

    ; binary32 from four little-endian bytes of a drained buffer string, via the generic decoder
    (defn lsb-f32-at (s off)
        (fd-value (add (str_byte_at s off)
                  (add (mul 256 (str_byte_at s (add off 1)))
                  (add (mul 65536 (str_byte_at s (add off 2)))
                       (mul 16777216 (str_byte_at s (add off 3)))))) 8 23))

    ; B_r over one full-width row: weights from the blob's own bytes, x from the drained string
    (defn lsb-br-go (src wbase xs r cols j acc)
        (if (ge j cols) acc
            (lsb-br-go src wbase xs r cols (add j 1)
                (add acc (lsb-abs (mul (q6m-flat-at src wbase (add (mul r cols) j))
                                       (lsb-f32-at xs (mul j 4))))))))
    (defn lsb-br (src wbase xs r cols) (lsb-br-go src wbase xs r cols 0 0.0))

    ; a defn frame sees only its parameters — every buffer, handle and constant arrives by hand
    (defn lsb-row-ok (logh serh src2 wbase xs2 cols cf uu r)
        (do
            (let slotv (lsb-f32-at (metal_buf_read logh (mul r 4) 4) 0))
            (let serv  (lsb-f32-at (metal_buf_read serh (mul r 4) 4) 0))
            (let br (lsb-br src2 wbase xs2 r cols))
            (le (lsb-abs (sub slotv serv)) (mul (mul cf uu) br))))
    (defn lsb-rows-ok (logh serh src2 wbase xs2 cols cf uu rows)
        (if (eq (len rows) 0) true
            (if (lsb-row-ok logh serh src2 wbase xs2 cols cf uu (head rows))
                (lsb-rows-ok logh serh src2 wbase xs2 cols cf uu (tail rows))
                false)))

    ; the door first, and nothing below believed without it
    (let live (md-door-live?))

    (let src (lth-src (lsb-blob)))
    (let base (egg-data-base src (wtr-alignment)))
    (let nLayer (gmt-u32 src "llama.block_count"))
    (let dModel (gmt-u32 src "llama.embedding_length"))
    (let dFF (gmt-u32 src "llama.feed_forward_length"))
    (let nHead (gmt-u32 src "llama.attention.head_count"))
    (let nKV (gmt-u32 src "llama.attention.head_count_kv"))
    (let headDim (gmt-u32 src "llama.rope.dimension_count"))
    (let vocabN (gmt-u32 src "llama.vocab_size"))
    (let ropeBase (gmt-f32 src "llama.rope.freq_base"))
    (let rmsEps (gmt-f32 src "llama.attention.layer_norm_rms_epsilon"))
    (let kvd (mul nKV headDim))
    (let maxpos 256)

    (let ps (lts-pipes (lts-msl)))
    (let pipes-ok (lth-pipe-ok? ps))

    (let bs (lth-bufs dModel dFF vocabN nHead maxpos))
    (let lays (lth-layers src base (lsb-blob) 0 nLayer (empty)))
    (let cks (lth-cache nLayer kvd maxpos (empty)))
    (let cvs (lth-cache nLayer kvd maxpos (empty)))
    (let embTv (lth-tv src base (lsb-blob) "token_embd.weight"))
    (let onormTv (lth-tv src base (lsb-blob) "output_norm.weight"))
    (let projTv (lth-out-tv src base (lsb-blob)))
    (let ropeH (lth-tv-h (lth-tv src base (lsb-blob) "rope_freqs.weight")))
    (let resident (md-status-has? "mmap_nocopy_buffers=256"))

    (let admissible (if (eq (qsl-admissible? dModel) 1)
                        (if (eq (qsl-admissible? dFF) 1)
                            (if (eq (qsl-admissible? kvd) 1)
                                (eq (qsl-admissible? (lth-tv-c projTv)) 1)
                                false)
                            false)
                        false))

    (let g (list dModel dFF nHead nKV headDim kvd maxpos vocabN
                 (md-f32-bits rmsEps) (md-f32-bits ropeBase)
                 (md-f32-bits (div 1.0 (math_sqrt (add headDim 0.0)))) ropeH nLayer))

    ; the stream, clocked; the clock is printed and never gated
    (let t0 (now_unix_ms))
    (let pf (lth-prefill ps bs g lays cks cvs embTv onormTv projTv (lsb-prompt) 0))
    (let t1 (now_unix_ms))
    (let first (nth pf 0))
    (let rest (lth-generate ps bs g lays cks cvs embTv onormTv projTv first 6 11 (empty)))
    (let t2 (now_unix_ms))
    (let got (append (list first) rest))
    (let _p1 (print_str (str_concat "prefill-ms " (int_to_str (sub t1 t0)))))
    (let _p2 (print_str (str_concat "decode-ms " (int_to_str (sub t2 t1)))))

    ; THE BOUND PROBE. bs 1 still holds the final normed x; bs 11 the slot logits. The serial
    ; attestant head is dispatched beside them into a scratch, and the first drain syncs it.
    ; This dispatch opens a fresh SERIAL batch (the loop's batches are drained), so its barrier
    ; word is 0 — the door refuses barrier_before outside a concurrent batch, and the first draft
    ; of this band learned that by reading zeros it had never asked about. The enqueue's own
    ; answer is therefore part of bit 64: a refused comparison cannot certify a bound.
    (let scratch (metal_buf_alloc (mul vocabN 4)))
    (let sd (metal_enqueue (nth ps 2)
                 (md-bind16 (list (lth-tv-h projTv) (nth bs 1) scratch)
                            (list (lth-tv-r projTv) (lth-tv-c projTv)) 256 0 0 0)
                 (lth-tv-r projTv)))
    (let xs (metal_buf_read (nth bs 1) 0 (mul dModel 4)))
    (let embAbs (egg-tensor-abs src base "token_embd.weight"))
    (let bound-ok (if (eq sd 1)
                      (lsb-rows-ok (nth bs 11) scratch src embAbs xs dModel
                                   (add (qsl-bound-coeff dModel) 0.0)
                                   (div 1.0 16777216.0)
                                   (lsb-probe-rows))
                      false))

    (let text (l3d-text src got))

    (add (if live 1 0)
    (add (if live (if admissible 2 0) 0)
    (add (if live (if pipes-ok 4 0) 0)
    (add (if live (if resident 8 0) 0)
    (add (if live (if (eq first 12366) 16 0) 0)
    (add (if live (if (lsb-eqlist got (lsb-want)) 32 0) 0)
    (add (if live (if bound-ok 64 0) 0)
         (if live (if (str_eq text (lsb-want-text)) 128 0) 0)))))))))
