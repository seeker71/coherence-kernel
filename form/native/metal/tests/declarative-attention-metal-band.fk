; Physical selected-row attention against the existing dense GQA kernel.
; Verdict 255. Four query heads share two KV heads across 513 positions;
; focus crosses a 256-thread boundary. Reference KV is gathered only by this
; test. The production kernel indexes the untouched resident cache directly.
; preludes: native/metal/qwen35-dense-token-handle.fk

(do
    (defn damb-data (n i salt)
        (if (ge i n) ""
            (str_concat (md-le32 (md-f32-bits (div (add (sub (mod (add (mul i 13) salt) 31) 15) 0.0) 8.0)))
                        (damb-data n (add i 1) salt))))
    (defn damb-gather (bytes state p n)
        (if (ge p n) ""
            (str_concat (if (da-visible state p n) (substring bytes (mul p 64) (mul (add p 1) 64)) "")
                        (damb-gather bytes state (add p 1) n))))
    (defn damb-nans (n) (if (eq n 0) "" (str_concat (md-le32 2143289344) (damb-nans (sub n 1)))))
    (defn damb-poison (bytes state p n)
        (if (ge p n) ""
            (str_concat (if (da-visible state p n) (substring bytes (mul p 64) (mul (add p 1) 64)) (damb-nans 16))
                        (damb-poison bytes state (add p 1) n))))
    (defn damb-scoped (scope q k v out sc)
        (do (metal_batch_concurrent)
            (dam-enqueue scope q k v out sc 513 4 2 8 (md-f32-bits 0.5) 513)
            (metal_buf_read out 0 128)))
    (defn damb-dense (pipe state qb keys values refk refv out scratch)
        (do
            (metal_buf_write refk 0 (damb-gather keys state 0 513))
            (metal_buf_write refv 0 (damb-gather values state 0 513))
            (metal_batch_concurrent)
            (metal_enqueue pipe
                (md-bind16 (list qb refk refv out scratch)
                    (list (da-attended state 513) 4 2 8 (md-f32-bits 0.5) 513) 256 0 1 1) 4)
            (metal_buf_read out 0 128)))
    (defn damb-free (bufs) (if (eq (len bufs) 0) 0 (add (metal_buf_free (head bufs)) (damb-free (tail bufs)))))
    (if (eq (md-door-live?) 0)
        (do (print "SKIP metal carrier unavailable") 0)
        (do
            (let device (dam-open))
            (let dense (metal_pipeline (q38-msl) "form_gqa_decode_tg_f32"))
            (let cfg (da-config 2 500 508 (list (list 1 2 250) (list 2 250 500))))
            (let global (da-initial cfg))
            (let focus (da-feed-output global "<focus magic_chunks=\"2\">" cfg))
            (let local (da-feed-output focus "</focus><local>" cfg))
            (let restore (da-feed-output local "</local>" cfg))
            (let q (metal_buf_alloc 128))
            (let k (metal_buf_alloc 32832))
            (let v (metal_buf_alloc 32832))
            (let out (metal_buf_alloc 128))
            (let sc (metal_buf_alloc 16416))
            (let rk (metal_buf_alloc 32832))
            (let rv (metal_buf_alloc 32832))
            (let ro (metal_buf_alloc 128))
            (let rs (metal_buf_alloc 16416))
            (let keys (damb-data 8208 0 3))
            (let values (damb-data 8208 0 7))
            (metal_buf_write q 0 (damb-data 32 0 11))
            (metal_buf_write k 0 keys)
            (metal_buf_write v 0 values)
            (let gs (dam-select device global))
            (let g (damb-scoped gs q k v out sc))
            (let gr (damb-dense dense global q keys values rk rv ro rs))
            (let fs (dam-select device focus))
            (let f (damb-scoped fs q k v out sc))
            (let fr (damb-dense dense focus q keys values rk rv ro rs))
            (metal_buf_write k 0 (damb-poison keys focus 0 513))
            (metal_buf_write v 0 (damb-poison values focus 0 513))
            (let poison (damb-scoped fs q k v out sc))
            (metal_buf_write k 0 keys)
            (metal_buf_write v 0 values)
            (let ls (dam-select device local))
            (let l (damb-scoped ls q k v out sc))
            (let lr (damb-dense dense local q keys values rk rv ro rs))
            (let restored (damb-scoped (dam-select device restore) q k v out sc))
            (let unchanged (and (str_eq keys (metal_buf_read k 0 32832)) (str_eq values (metal_buf_read v 0 32832))))
            (let freed (add (dam-close device) (damb-free (list q k v out sc rk rv ro rs))))
            (print (list "attended-positions" (da-attended global 513) (da-attended focus 513) (da-attended local 513) (da-attended restore 513)))
            (sum (list
                (if (and (gt dense 0) (not (nothing? device))) 1 0)
                (if (and (eq (str_len g) 128) (str_eq g gr)) 2 0)
                (if (and (eq (str_len f) 128) (str_eq f fr)) 4 0)
                (if (str_eq poison f) 8 0)
                (if (and (eq (str_len l) 128) (str_eq l lr)) 16 0)
                (if (and (str_eq restored gr) unchanged) 32 0)
                (if (and (eq (dam-valid? fs 507) 0) (eq (dam-attended fs 513) 265)) 64 0)
                (if (eq freed 10) 128 0))))))
