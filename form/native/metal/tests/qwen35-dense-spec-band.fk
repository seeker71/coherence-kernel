; qwen35-dense-spec-band.fk — the pieces of speculative decoding, each against the lane's own kernel, on small synthetic fixtures.
;
; Real Metal dispatch. No model is admitted; the end-to-end witness (same token ids as the plain greedy decode, rejected drafts
; restored) is observe/q38-spec-run.bml and its band observe/q38-spec-identity-band.bml, which need the 29 GB file.
;
;   1   the spec pipelines compile (q38s-mode-slot() of them, then the numerics mode and its tuning), and the lane's own pipeline list is untouched (63)
;   2   mvk, the small-batch Q8_0 matvec, NT = 1..8 columns, two and four rows a group: every column is BYTE FOR BYTE the lane's wide matvec on that token's
;       activations (rows odd so a group's second row can fall past the end; output pitch exceeds rows and its padding keeps its sentinel)
;   4   the conv recurrence with snapshots: outputs and final window byte for byte the lane's span kernel; snapshot t byte for byte the
;       window the lane's kernel reaches over tokens 0..t; the restore copy (the lane's source-offset copy) puts it back exactly
;   8   the delta recurrence, the same three claims
;   16  the span argmax: every row's greedy id (a tie goes to the lowest index) and its value; the tie row also agrees with the lane's
;       single-row argmax kernels
;   32  embedding from device ids (the drafts the chain chose) is the lane's row dequant, idoff included; concat is [a ; b] a row
;   64  the accept rule (the longest prefix of drafts the model repeats) and the id bytes round trip
;   128 the span attention (a group a (token, head)) is the decode attention kernel's own arithmetic: every token's output row is byte for
;       byte what the lane's decode kernel gives it over the same K/V and the same npos (positions past 256, so the strided loops wrap)
;
; Verdict 255
; REQUIRES: a live Metal device
; preludes: native/metal/qwen35-dense-spec.fk form-stdlib/f16-decode.fk form-stdlib/lora-adapter.bml
(do
 (defn qdsb-repeat (text n acc) (if (le n 0) acc (qdsb-repeat text (sub n 1) (str_concat acc text))))
 (defn qdsb-pat (n seed i acc)
  (if (ge i n) acc
   (qdsb-pat n seed (add i 1) (str_concat acc (md-le32 (md-f32-bits (div (mul 1.0 (sub (mod (add (mul i 17) seed) 257) 128)) 128.0)))))))
 (defn qdsb-pos (n seed i acc)
  (if (ge i n) acc
   (qdsb-pos n seed (add i 1) (str_concat acc (md-le32 (md-f32-bits (div (mul 1.0 (add 40 (mod (mul (add i seed) 13) 200))) 256.0)))))))
 ; Q8_0 weights: nblk blocks of [f16 scale (a small normal one) | 32 int8]
 (defn qdsb-q32 (i j acc) (if (ge j 32) acc (qdsb-q32 i (add j 1) (str_concat acc (byte_to_str (mod (add (mul i 31) (add (mul j 29) 7)) 256))))))
 (defn qdsb-w8 (nblk i acc)
  (if (ge i nblk) acc
   (qdsb-w8 nblk (add i 1) (str_concat acc (str_concat (byte_to_str (mod (mul i 53) 256)) (str_concat (byte_to_str (add 40 (mod i 8))) (qdsb-q32 i 0 "")))))))
 ; ── 2: mvk against the wide matvec ──
 (defn qdsb-col (ps wh rows cols input batch pitch nt t sentinel)
  (do
   (let x (metal_buf_alloc (mul cols 4)))
   (let y (metal_buf_alloc (mul rows 4)))
   (let wrote (metal_buf_write x 0 (substring input (mul t (mul cols 4)) (mul (add t 1) (mul cols 4)))))
   (metal_batch_concurrent)
   (let ref (q38-mv ps (list wh rows cols 8) x y 1))
   (let expected (metal_buf_read y 0 (mul rows 4)))
   (let actual (substring batch (mul t (mul pitch 4)) (mul 4 (add (mul t pitch) rows))))
   (let padding (substring batch (mul 4 (add (mul t pitch) rows)) (mul 4 (mul (add t 1) pitch))))
   (let released (add (metal_buf_free x) (metal_buf_free y)))
   (if (and (gt ref 0) (and (str_eq expected actual) (str_eq padding sentinel))) 1 0)))
 (defn qdsb-cols (ps wh rows cols input batch pitch nt t sentinel)
  (if (ge t nt) 1 (if (eq (qdsb-col ps wh rows cols input batch pitch nt t sentinel) 1) (qdsb-cols ps wh rows cols input batch pitch nt (add t 1) sentinel) 0)))
 (defn qdsb-mvk (ps qs wh rows cols input nt rr)
  (do
   (let pitch (add rows 3))
   (let sentinel (qdsb-repeat (md-le32 (md-f32-bits 42.25)) 3 ""))
   (let x (metal_buf_alloc (mul (mul nt cols) 4)))
   (let y (metal_buf_alloc (mul (mul nt pitch) 4)))
   (let w1 (metal_buf_write x 0 (substring input 0 (mul (mul nt cols) 4))))
   (let w2 (metal_buf_write y 0 (qdsb-repeat (md-le32 (md-f32-bits 42.25)) (mul nt pitch) "")))
   (metal_batch_concurrent)
   (let dispatched (q38s-mv-r ps qs (list wh rows cols 8) x y nt pitch 1 rr))
   (let batch (metal_buf_read y 0 (mul (mul nt pitch) 4)))
   (let same (qdsb-cols ps wh rows cols input batch pitch nt 0 sentinel))
   (let freed (add (metal_buf_free x) (metal_buf_free y)))
   (print (list "mvk" "rows-a-group" rr "nt" nt "rows" rows "cols" cols "every-column-the-wide-matvec" same))
   (if (and (gt dispatched 0) (eq same 1)) 1 0)))
 (defn qdsb-mvk-all (ps qs wh rows cols input nt rr)
  (if (gt nt 8) 1 (if (eq (qdsb-mvk ps qs wh rows cols input nt rr) 1) (qdsb-mvk-all ps qs wh rows cols input (add nt 1) rr) 0)))
 ; ── 4: conv with snapshots ──
 (defn qdsb-conv (ps qs which ntok)
  (do
   (let nch 10) (let kw 4) (let stride 12)
   (let win (metal_buf_alloc (mul (mul nch kw) 4)))
   (let x (metal_buf_alloc (mul (mul 8 stride) 4)))
   (let w (metal_buf_alloc (mul (mul nch kw) 4)))
   (let y (metal_buf_alloc (mul (mul 8 stride) 4)))
   (let snap (metal_buf_alloc (mul (mul 8 (mul nch kw)) 4)))
   (let w0 (metal_buf_write win 0 (qdsb-pat (mul nch kw) 5 0 "")))
   (let w1 (metal_buf_write x 0 (qdsb-pat (mul 8 stride) 11 0 "")))
   (let w2 (metal_buf_write w 0 (qdsb-pat (mul nch kw) 23 0 "")))
   (metal_batch_concurrent)
   (let e (if (eq which 0)
    (metal_enqueue (nth ps (qlslc-conv-span-pipeline)) (md-bind16 (list win x w y) (list nch kw stride ntok) 256 0 0 1) nch)
    (metal_enqueue (nth qs (q38s-pipe-conv)) (md-bind16 (list win x w y snap) (list nch kw stride ntok (mul nch kw)) 256 0 0 1) nch)))
   (let rwin (metal_buf_read win 0 (mul (mul nch kw) 4)))
   (let ry (metal_buf_read y 0 (mul (mul ntok stride) 4)))
   (let rsnap (metal_buf_read snap 0 (mul (mul 8 (mul nch kw)) 4)))
   (let freed (sum (list (metal_buf_free win) (metal_buf_free x) (metal_buf_free w) (metal_buf_free y) (metal_buf_free snap))))
   (list rwin ry rsnap e)))
 ; the restore: the lane's source-offset copy takes snapshot slot m into a state buffer
 (defn qdsb-restore (ps snap-bytes n m)
  (do
   (let sh (metal_buf_alloc (str_len snap-bytes)))
   (let st (metal_buf_alloc (mul n 4)))
   (let w0 (metal_buf_write sh 0 snap-bytes))
   (metal_batch_concurrent)
   (let e (metal_enqueue (nth ps 32) (q38-b16 (list sh st) (list n (mul m n)) 0 1) n))
   (let out (metal_buf_read st 0 (mul n 4)))
   (let freed (add (metal_buf_free sh) (metal_buf_free st)))
   out))
 (defn qdsb-conv-slots (ps qs full t)
  (if (ge t 3) 1
   (do
    (let oracle (qdsb-conv ps qs 0 (add t 1)))
    (let slot (substring (nth full 2) (mul t (mul 40 4)) (mul (add t 1) (mul 40 4))))
    (let restored (qdsb-restore ps (nth full 2) 40 t))
    (if (and (str_eq (nth oracle 0) slot) (str_eq (nth oracle 0) restored)) (qdsb-conv-slots ps qs full (add t 1)) 0))))
 (defn qdsb-conv-band (ps qs)
  (do
   (let lane (qdsb-conv ps qs 0 4))
   (let spec (qdsb-conv ps qs 1 4))
   (let same (and (gt (nth lane 3) 0) (and (gt (nth spec 3) 0) (and (str_eq (nth lane 0) (nth spec 0)) (str_eq (nth lane 1) (nth spec 1))))))
   (let slots (qdsb-conv-slots ps qs spec 0))
   (print (list "conv" "final-and-outputs-equal-lane" same "snapshots-and-restore" slots))
   (if (and same (eq slots 1)) 1 0)))
 ; ── 8: delta with snapshots ──
 (defn qdsb-delta (ps qs which ntok)
  (do
   (let nv 4) (let dv 4) (let dk 8) (let nk 2) (let cstride 50) (let gstride 5) (let ostride 18) (let sn (mul nv (mul dv dk)))
   (let S (metal_buf_alloc (mul sn 4)))
   (let c (metal_buf_alloc (mul (mul 8 cstride) 4)))
   (let al (metal_buf_alloc (mul (mul 8 gstride) 4)))
   (let be (metal_buf_alloc (mul (mul 8 gstride) 4)))
   (let o (metal_buf_alloc (mul (mul 8 ostride) 4)))
   (let snap (metal_buf_alloc (mul (mul 8 sn) 4)))
   (let w0 (metal_buf_write S 0 (qdsb-pat sn 3 0 "")))
   (let w1 (metal_buf_write c 0 (qdsb-pat (mul 8 cstride) 9 0 "")))
   (let w2 (metal_buf_write al 0 (qdsb-pos (mul 8 gstride) 1 0 "")))
   (let w3 (metal_buf_write be 0 (qdsb-pos (mul 8 gstride) 7 0 "")))
   (let qscale (md-f32-bits 0.35355339))
   (metal_batch_concurrent)
   (let e (if (eq which 0)
    (metal_enqueue (nth ps (qlslc-delta-span-pipeline)) (md-bind16 (list S c al be o) (list nv dv dk nk qscale cstride gstride ostride ntok) 256 0 0 1) (mul nv dv))
    (metal_enqueue (nth qs (q38s-pipe-delta)) (md-bind16 (list S c al be o snap) (list nv dv dk nk qscale cstride gstride ostride ntok sn) 256 0 0 1) (mul nv dv))))
   (let rS (metal_buf_read S 0 (mul sn 4)))
   (let ro (metal_buf_read o 0 (mul (mul ntok ostride) 4)))
   (let rsnap (metal_buf_read snap 0 (mul (mul 8 sn) 4)))
   (let freed (sum (list (metal_buf_free S) (metal_buf_free c) (metal_buf_free al) (metal_buf_free be) (metal_buf_free o) (metal_buf_free snap))))
   (list rS ro rsnap e)))
 (defn qdsb-delta-slots (ps qs full t)
  (if (ge t 3) 1
   (do
    (let oracle (qdsb-delta ps qs 0 (add t 1)))
    (let slot (substring (nth full 2) (mul t (mul 128 4)) (mul (add t 1) (mul 128 4))))
    (let restored (qdsb-restore ps (nth full 2) 128 t))
    (if (and (str_eq (nth oracle 0) slot) (str_eq (nth oracle 0) restored)) (qdsb-delta-slots ps qs full (add t 1)) 0))))
 (defn qdsb-delta-band (ps qs)
  (do
   (let lane (qdsb-delta ps qs 0 4))
   (let spec (qdsb-delta ps qs 1 4))
   (let same (and (gt (nth lane 3) 0) (and (gt (nth spec 3) 0) (and (str_eq (nth lane 0) (nth spec 0)) (str_eq (nth lane 1) (nth spec 1))))))
   (let slots (qdsb-delta-slots ps qs spec 0))
   (print (list "delta" "final-and-outputs-equal-lane" same "snapshots-and-restore" slots))
   (if (and same (eq slots 1)) 1 0)))
 ; ── 16: the span argmax ──
 (defn qdsb-logit (row i)
  (if (eq row 0) (if (eq i 1234) 500.0 (div (mul 1.0 (mod (mul i 7) 1000)) 10.0))
   (if (eq row 1) (if (or (eq i 5) (eq i 2999)) 400.0 (div (mul 1.0 (mod (mul i 11) 900)) 10.0))
    (if (eq i 0) 9.0 (div (mul 1.0 (mod i 5)) 10.0)))))
 (defn qdsb-logits (row i n acc) (if (ge i n) acc (qdsb-logits row (add i 1) n (str_concat acc (md-le32 (md-f32-bits (qdsb-logit row i)))))))
 (defn qdsb-argmax-band (ps qs)
  (do
   (let n 3000)
   (let r0 (qdsb-logits 0 0 n ""))
   (let r1 (qdsb-logits 1 0 n ""))
   (let r2 (qdsb-logits 2 0 n ""))
   (let lg (metal_buf_alloc (mul (mul 3 n) 4)))
   (let pidx (metal_buf_alloc (mul (mul 3 1024) 4)))
   (let pv (metal_buf_alloc (mul (mul 3 1024) 4)))
   (let out (metal_buf_alloc 64))
   (let ov (metal_buf_alloc 64))
   (let w0 (metal_buf_write lg 0 (str_concat r0 (str_concat r1 r2))))
   (metal_batch_concurrent)
   (let e1 (metal_enqueue (nth qs (q38s-pipe-argpart)) (q38-b16 (list lg pidx pv) (list n 1024 3) 0 1) (mul 1024 3)))
   (let e2 (metal_enqueue (nth qs (q38s-pipe-argcomb)) (md-bind16 (list pidx pv out ov) (list 1024 2) 1024 0 1 1) 3))
   (let ids (metal_buf_read out 0 20))
   (let vals (metal_buf_read ov 0 20))
   ; the lane's single-row kernels on the tie row
   (let l1 (metal_buf_alloc (mul n 4)))
   (let lpi (metal_buf_alloc 4096))
   (let lpv (metal_buf_alloc 4096))
   (let lout (metal_buf_alloc 16))
   (let lov (metal_buf_alloc 16))
   (let w1 (metal_buf_write l1 0 r1))
   (metal_batch_concurrent)
   (let e3 (metal_enqueue (nth ps 25) (q38-b16 (list l1 lpi lpv) (list n 1024) 0 1) 1024))
   (let e4 (metal_enqueue (nth ps 26) (md-bind16 (list lpi lpv lout lov) (list 1024) 1024 0 1 1) 1))
   (let lane-id (kth-u32at (metal_buf_read lout 0 4) 0))
   (let freed (sum (list (metal_buf_free lg) (metal_buf_free pidx) (metal_buf_free pv) (metal_buf_free out) (metal_buf_free ov) (metal_buf_free l1) (metal_buf_free lpi) (metal_buf_free lpv) (metal_buf_free lout) (metal_buf_free lov))))
   (print (list "argmax" "ids" (kth-u32at ids 2) (kth-u32at ids 3) (kth-u32at ids 4) "lane-on-the-tie-row" lane-id))
   ; the outputs land at ooff + row: 2, 3, 4
   (if (and (and (gt e1 0) (gt e2 0)) (and (and (eq (kth-u32at ids 2) 1234) (eq (kth-u32at ids 3) 5)) (and (eq (kth-u32at ids 4) 0) (and (eq lane-id 5) (str_eq (substring vals 8 12) (md-le32 (md-f32-bits 500.0))))))) 1 0)))
 ; ── 32: embed from device ids; concat ──
 (defn qdsb-lane-rows (ps wh n ids acc)
  (if (eq (len ids) 0) acc
   (do
    (let d (metal_buf_alloc (mul n 4)))
    (metal_batch_concurrent)
    (let e (metal_enqueue (nth ps 30) (q38-b16 (list wh d) (list (mul (nth ids 0) n) n) 0 1) n))
    (let row (metal_buf_read d 0 (mul n 4)))
    (let f (metal_buf_free d))
    (qdsb-lane-rows ps wh n (drop 1 ids) (str_concat acc row)))))
 (defn qdsb-embed-band (ps qs)
  (do
   (let n 64)
   (let wh (metal_buf_alloc (mul 10 34)))
   (let w0 (metal_buf_write wh 0 (qdsb-w8 10 0 "")))
   (let idb (metal_buf_alloc 64))
   (let w1 (metal_buf_write idb 0 (q38s-ids-bytes (list 3 0 4))))
   (let d (metal_buf_alloc (mul (mul 3 n) 4)))
   (let d2 (metal_buf_alloc (mul (mul 2 n) 4)))
   (metal_batch_concurrent)
   (let e (metal_enqueue (nth qs (q38s-pipe-embed)) (md-bind16 (list wh idb d) (list n 3 0) 256 0 0 1) (mul n 3)))
   (let e2 (metal_enqueue (nth qs (q38s-pipe-embed)) (md-bind16 (list wh idb d2) (list n 2 1) 256 0 0 1) (mul n 2)))
   (let mine (metal_buf_read d 0 (mul (mul 3 n) 4)))
   (let mine2 (metal_buf_read d2 0 (mul (mul 2 n) 4)))
   (let lane (qdsb-lane-rows ps wh n (list 3 0 4) ""))
   (let lane2 (qdsb-lane-rows ps wh n (list 0 4) ""))
   ; concat: two rows of 6
   (let a (metal_buf_alloc 48))
   (let b (metal_buf_alloc 48))
   (let y (metal_buf_alloc 96))
   (let wa (metal_buf_write a 0 (qdsb-pat 12 2 0 "")))
   (let wb (metal_buf_write b 0 (qdsb-pat 12 40 0 "")))
   (metal_batch_concurrent)
   (let e3 (metal_enqueue (nth qs (q38s-pipe-concat)) (md-bind16 (list a b y) (list 6 2) 256 0 0 1) 24))
   (let cat (metal_buf_read y 0 96))
   (let pa (qdsb-pat 12 2 0 ""))
   (let pb (qdsb-pat 12 40 0 ""))
   (let want (str_concat (substring pa 0 24) (str_concat (substring pb 0 24) (str_concat (substring pa 24 48) (substring pb 24 48)))))
   (let freed (sum (list (metal_buf_free wh) (metal_buf_free idb) (metal_buf_free d) (metal_buf_free d2) (metal_buf_free a) (metal_buf_free b) (metal_buf_free y))))
   (print (list "embed" "ids-equal-lane" (str_eq mine lane) "idoff" (str_eq mine2 lane2) "concat" (str_eq cat want)))
   (if (and (and (gt e 0) (gt e3 0)) (and (str_eq mine lane) (and (str_eq mine2 lane2) (str_eq cat want)))) 1 0)))
 ; ── 128: the span attention is the decode attention, bit for bit ──
 (defn qdsb-gqa-tok (ps q kc vc mine nq nkv hd pos0 sstride scale t ntok)
  (if (ge t ntok) 1
   (do
    (let rowb (mul (mul nq hd) 4))
    (let qt (metal_buf_alloc rowb))
    (let yt (metal_buf_alloc rowb))
    (let sct (metal_buf_alloc (mul (mul 2 nq) (mul sstride 4))))
    (let w (metal_buf_write qt 0 (metal_buf_read q (mul t rowb) rowb)))
    (metal_batch_concurrent)
    (let e (metal_enqueue (nth ps (qlslc-cooperative-gqa-pipeline)) (md-bind16 (list qt kc vc yt sct) (list (add pos0 (add t 1)) nq nkv hd scale sstride) 256 0 1 1) nq))
    (let ref (metal_buf_read yt 0 rowb))
    (let freed (sum (list (metal_buf_free qt) (metal_buf_free yt) (metal_buf_free sct))))
    (if (and (gt e 0) (str_eq ref (substring mine (mul t rowb) (mul (add t 1) rowb)))) (qdsb-gqa-tok ps q kc vc mine nq nkv hd pos0 sstride scale (add t 1) ntok) 0))))
 (defn qdsb-gqa-band (ps qs)
  (do
   (let nq 4) (let nkv 2) (let hd 8) (let pos0 300) (let ntok 3) (let sstride 512) (let kvd 16)
   (let qn (mul ntok (mul nq hd)))
   (let kn (mul (add pos0 ntok) kvd))
   (let q (metal_buf_alloc (mul qn 4)))
   (let kc (metal_buf_alloc (mul kn 4)))
   (let vc (metal_buf_alloc (mul kn 4)))
   (let y (metal_buf_alloc (mul qn 4)))
   (let sc (metal_buf_alloc (mul (mul (mul 2 (mul ntok nq)) sstride) 4)))
   (let w0 (metal_buf_write q 0 (qdsb-pat qn 3 0 "")))
   (let w1 (metal_buf_write kc 0 (qdsb-pat kn 7 0 "")))
   (let w2 (metal_buf_write vc 0 (qdsb-pat kn 19 0 "")))
   (let scale (md-f32-bits 0.35355339))
   (metal_batch_concurrent)
   (let e (metal_enqueue (nth qs (q38s-pipe-gqa)) (md-bind16 (list q kc vc y sc) (list pos0 nq nkv hd scale sstride ntok) 256 0 1 1) (mul nq ntok)))
   (let mine (metal_buf_read y 0 (mul qn 4)))
   (let same (qdsb-gqa-tok ps q kc vc mine nq nkv hd pos0 sstride scale 0 ntok))
   (let freed (sum (list (metal_buf_free q) (metal_buf_free kc) (metal_buf_free vc) (metal_buf_free y) (metal_buf_free sc))))
   (print (list "gqa-span" "every-token-the-decode-kernel" same))
   (if (and (gt e 0) (eq same 1)) 1 0)))
 ; ── 64: the accept rule and the id bytes ──
 (defn qdsb-rules ()
  (do
   (let a (q38s-accept-go (list 9 5 6 7) (list 5 6 9 1) 1 3))
   (let b (q38s-accept-go (list 9 5 6 7) (list 4 6 7 1) 1 3))
   (let c (q38s-accept-go (list 9 5 6 7) (list 5 6 7 8) 1 3))
   (let d (q38s-accept-go (list 9 5) (list 5 8) 1 1))
   (let r (q38s-u32s (q38s-ids-bytes (list 7 65536 3 4294967295)) 0 4))
   (print (list "rules" a b c d r))
   (if (and (and (eq a 2) (eq b 0)) (and (eq c 3) (and (eq d 1) (and (eq (nth r 0) 7) (and (eq (nth r 1) 65536) (and (eq (nth r 2) 3) (eq (nth r 3) 4294967295))))))) 1 0)))
 (let msl (q38-msl))
 (let ps (q38-pipes msl))
 (let qs (q38s-pipes (q38s-msl)))
 (let pipes-ok (if (and (eq (len ps) 63) (and (eq (len qs) (add (q38s-mode-slot) 2)) (and (q38s-pipes-ok? qs) (eq (nth (metal_live) 2) 0)))) 1 0))
 ; 5 rows, 4096 columns: all eight simdgroups and the stride loop, the second row of the last group past the end
 (let rows 5) (let cols 2112)
 (let weights (qdsb-w8 (mul rows (div cols 32)) 0 ""))
 (let wh (metal_buf_alloc (str_len weights)))
 (let w0 (metal_buf_write wh 0 weights))
 (let input (qdsb-pat (mul 8 cols) 0 0 ""))
 (let mvk2 (qdsb-mvk-all ps qs wh rows cols input 1 2))
 (let mvk4 (qdsb-mvk-all ps qs wh rows cols input 1 4))
 (let mvk (if (and (eq mvk2 1) (eq mvk4 1)) 1 0))
 (let mvkfree (metal_buf_free wh))
 (let conv (qdsb-conv-band ps qs))
 (let delta (qdsb-delta-band ps qs))
 (let arg (qdsb-argmax-band ps qs))
 (let emb (qdsb-embed-band ps qs))
 (let rules (qdsb-rules))
 (let gqa (qdsb-gqa-band ps qs))
 (let verdict (sum (list pipes-ok (mul 2 mvk) (mul 4 conv) (mul 8 delta) (mul 16 arg) (mul 32 emb) (mul 64 rules) (mul 128 gqa))))
 (if (eq verdict 255) verdict (form_error (str_concat "qwen35 dense spec band failed: " (int_to_str verdict)))))
