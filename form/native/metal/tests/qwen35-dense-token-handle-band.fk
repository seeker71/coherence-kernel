; qwen35-dense-token-handle-band.fk — the observed Qwen3.8 GGUF declares the
; geometry and Form emits every Metal pipeline the dense hybrid walker needs.
;
; It reads configuration from the sealed GGUF header; no Qwen3.8 geometry is
; admitted from this test as runtime config.
;
; preludes: native/metal/qwen35-dense-token-handle.fk
(do
    (let path "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf")
    (let src (eqr-of-file path 0 40000000))
    (let geo (q38-geo src 128))
    (let pipes (q38-pipes (q38-msl)))
    (sum (list
        (if (str_eq (gmt-str src "general.architecture") "qwen35") 1 0)
        (if (eq (nth geo 0) 5120) 2 0)
        (if (eq (nth geo 1) 10240) 4 0)
        (if (eq (nth geo 2) 16) 8 0)
        (if (eq (nth geo 3) 48) 16 0)
        (if (eq (nth geo 4) 128) 32 0)
        (if (eq (nth geo 10) 17408) 64 0)
        (if (eq (nth geo 12) 24) 128 0)
        (if (eq (nth geo 13) 4) 256 0)
        (if (eq (nth geo 14) 256) 512 0)
        (if (eq (nth geo 15) 64) 1024 0)
        (if (eq (nth geo 19) 248320) 2048 0)
        (if (eq (nth geo 21) 64) 4096 0)
        (if (eq (nth geo 22) 4) 8192 0)
        (if (eq (nth geo 23) 4) 16384 0)
        (if (eq (len pipes) 32) 32768 0)
        (if (kth-pipes-ok? pipes) 65536 0))))
