; qwen4exp-flash-next-token-handle-band.fk — native scheduler/state contract.
;
; preludes: form/native/metal/qwen4exp-flash-next-token-handle.fk
;
; Verdict 2047. The sibling live observer runs real model weights.

(do
    (defn q4tb-bit (ok bit) (if ok bit 0))
    (defn q4tb-live? (xs)
        (if (eq (len xs) 0) 1
            (if (gt (head xs) 0) (q4tb-live? (tail xs)) 0)))
    (defn q4tb-state-live? (sts)
        (if (eq (len sts) 0) 1
            (if (eq (q4tb-live? (if (eq (q4g-full (sub 48 (len sts))) 1)
                    (list (nth (head sts) 2) (nth (head sts) 3))
                    (list (nth (head sts) 0) (nth (head sts) 1)))) 1)
                (q4tb-state-live? (tail sts)) 0)))
    (let bs (q4t-bufs 2))
    (let sts (q4t-state 2))
    (let c0 (q4tb-bit (eq (len bs) 49) 1))
    (let c1 (q4tb-bit (eq (q4tb-live? bs) 1) 2))
    (let c2 (q4tb-bit (eq (len sts) 48) 4))
    (let c3 (q4tb-bit (eq (q4tb-state-live? sts) 1) 8))
    (let c4 (q4tb-bit (if (eq (len (q4t-ple-multipliers)) 3)
        (eq (str_len (q4t-u64-list (q4t-ple-multipliers))) 24) 0) 16))
    (let c5 (q4tb-bit (if (eq (len (q4t-ple-offsets)) 16)
        (eq (str_len (q4t-u64-list (q4t-ple-offsets))) 128) 0) 32))
    (let c6 (q4tb-bit (if (eq (len (q4t-ple-sizes)) 16)
        (eq (str_len (q4t-u64-list (q4t-ple-sizes))) 128) 0) 64))
    (let c7 (q4tb-bit (if (eq (q4t-dense-exact-radius) 2048)
        (eq (q4t-attn-scale-bits) 1031798784) 0) 128))
    (let c8 (q4tb-bit (if (eq (q4g-full 3) 1)
        (if (eq (q4g-ple 1) 1) (eq (q4g-linear-layers) 36) 0) 0) 256))
    (let c9 (q4tb-bit (if (eq (q4eq-all-supported? 17) 1)
        (if (eq (q4eq-all-supported? 18) 1) (eq (q4eq-all-supported? 20) 1) 0) 0) 512))
    (let source (read_file "form/native/metal/qwen4exp-flash-next-token-handle.fk"))
    (let c10 (q4tb-bit (and (ge (str_find source "(defn q4t-ingest" 0) 0)
        (ge (str_find source "live differential showed that its scratch image" 0) 0)) 1024))
    (q4t-free-handles bs)
    (q4t-free-state sts)
    (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 c10)))))))))))
