; Real Metal row decode from a committed two-row Q4_K fixture.
; Expected 31. Row 1 must use its own block; no live state writes.
; preludes: form-stdlib/qwen-lora-train.fk
(do
 (defn q38eb-equal (src xs i)
  (if (nil? xs) 1
   (if (lt (abs (sub (head xs) (q4m-flat-at src 0 (add 256 i)))) 0.000001)
    (q38eb-equal src (tail xs) (add i 1)) 0)))
 (let path "form/form-stdlib/tests/fixtures/q4k-two-superblocks.bin")
 (let src (eqr-of-file path 0 288))
 (let pipes (q38-pipes (q38-msl)))
 (let qb (metal_buf_from_file path 0 288))
 (let out (metal_buf_alloc 1024))
 (let began (metal_batch_concurrent))
 (let ran (q38-embed pipes (list out) (list 256) (list qb 2 256 12) 1 0))
 (let raw (metal_buf_read out 0 1024))
 (let values (qlt-f32s raw 256))
 (let released (add (metal_buf_free qb) (metal_buf_free out)))
 (sum (list
  (if (and (eq (q38e-index 8) 30) (eq (q38e-index 12) 49)) 1 0)
  (if (lt (q38e-index 999) 0) 2 0)
  (if (eq (len values) 256) 4 0)
  (if (and (eq (len values) 256) (q38eb-equal src values 0)) 8 0)
  (if (eq released 2) 16 0))))
