; view-residency-band.fk — a model larger than one MTLBuffer, resident as views, read back byte for
; byte against a plain file read.
;
; The file is the LARGEST gguf the model registry names. The ceiling is the device's own answer,
; bisected by native/metal/view-residency.bml; nothing here is typed from a device. A file no larger
; than one buffer leaves bit 1 unset, and says so.
;
; Bits, one meaning each:
;   1    ONE buffer over the whole file is refused by the device
;   2    the ceiling the body bisected is admitted, and one page more (still inside the file) is refused
;   4    windowed-residency.fk's view set over that ceiling has at least two views, every one admitted
;   8    every tensor in the file's own table lies wholly inside its view
;   16   the first tensor past the ceiling: its first 64 KiB read on the GPU through its view at the
;        body's inner offset equals read_file_slice at its absolute offset
;   32   that tensor's last 64 KiB, likewise
;   64   the 64 KiB spanning the ceiling (the cut one buffer would make), read through the view that
;        holds it, equals the file read
;   128  the first read taken one page off the body's inner offset does NOT equal the file read
;   256  that tensor bound as its OWN view (the dense lane's per-tensor binding) reads the same bytes
;
; Expected: 511
;
; preludes: native/metal/view-residency.bml form-stdlib/model-registry.bml

(do
    (defn vresb-gguf? (path)
        (if (gt (str_len path) 5)
            (str_eq (substring path (sub (str_len path) 5) (str_len path)) ".gguf")
            false))
    (defn vresb-larger? (path best)
        (if (str_eq best "") true (gt (file_size path) (file_size best))))
    (defn vresb-largest (rows best)
        (if (eq (len rows) 0) best
            (vresb-largest (tail rows)
                (if (vresb-gguf? (mr-path (head rows)))
                    (if (vresb-larger? (mr-path (head rows)) best) (mr-path (head rows)) best)
                    best))))
    (vres-witness (vresb-largest (mr-registry) "") (wr-page)))
