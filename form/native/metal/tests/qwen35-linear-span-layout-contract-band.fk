; qwen35-linear-span-layout-contract-band.fk — pure witness for logical rows,
; producer-selected bs2 pitch, shared head bias, and pipeline continuity.
;
; Verdict 65535 (16 bits):
;   1      linear logical row width is geo[1]
;   2      full logical row width is 2*nq*hd
;   4      full width selects output pitch when larger
;   8      linear width selects output pitch when larger
;   16     selected output pitch and allocation capacity agree
;   32     logical row width remains distinct from larger output pitch
;   64     every bs2 token starts at token*producer-selected-pitch
;   128    both pitched written extents fit both synthetic allocations
;   256    valid shared bias index 0 is present integer 0
;   512    valid shared bias index 1 is present integer 1
;   1024   bias stays h across tokens while activation offset advances
;   2048   invalid token/head returns nothing, distinct from 0 and 1
;   4096   cooperative decode GQA remains pipeline 39
;   8192   future linear-span pipelines append exactly at 40..46
;   16384  the contract is contiguous and ascending from the GQA index — the
;          property that actually holds a merge, since a gap or a repeat is how
;          one line's insertion silently redirects another line's dispatch
;   32768  the complete contract is pure data over two geometry sides
;
; preludes: native/metal/qwen35-linear-span-layout-contract.fk

(do
    (defn qlslcb-bit (ok bit) (if ok bit 0))

    ; Holds the shape rather than the numbers: each index exactly one above the
    ; one before it. A literal list catches a change; this catches the two ways
    ; a change goes wrong — a gap leaves an unnamed pipeline reachable only by a
    ; hand-written integer, and a repeat gives one index two meanings.
    (defn qlslcb-ascending-by-one? (xs)
        (if (le (len xs) 1) 1
            (if (eq (nth xs 1) (add (nth xs 0) 1))
                (qlslcb-ascending-by-one? (tail xs)) 0)))
    (defn qlslcb-list-eq? (a b)
        (if (not (eq (len a) (len b))) 0
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b))
                    (qlslcb-list-eq? (tail a) (tail b)) 0))))

    (defn qwen35-linear-span-layout-contract-band ()
        (do
            ; Qwen-like full-dominant side: 2*24*256 = 12288 > 10240.
            (let full-dominant (qlslc-geometry 10240 24 256))
            ; Same head geometry, but a synthetic wider linear projection.
            (let linear-dominant (qlslc-geometry 16384 24 256))
            (let ntok 3)
            (let bias0 (qlslc-shared-head-bias-index 0 0 24))
            (let bias1 (qlslc-shared-head-bias-index 1 1 24))
            (let bias-late (qlslc-shared-head-bias-index 7 5 24))
            (let packed-late (qlslc-packed-head-index 7 5 24))
            (let bad-head (qlslc-shared-head-bias-index 0 24 24))
            (let bad-token (qlslc-shared-head-bias-index -1 0 24))
            (let pipelines (qlslc-pipeline-contract))

            (sum (list
                (qlslcb-bit (eq (qlslc-linear-logical-rows full-dominant)
                                10240) 1)
                (qlslcb-bit (eq (qlslc-full-logical-rows full-dominant)
                                12288) 2)
                (qlslcb-bit (eq (qlslc-bs2-output-pitch full-dominant)
                                12288) 4)
                (qlslcb-bit (eq (qlslc-bs2-output-pitch linear-dominant)
                                16384) 8)
                (qlslcb-bit (and
                    (eq (qlslc-bs2-output-pitch full-dominant)
                        (qlslc-bs2-allocation-capacity full-dominant))
                    (eq (qlslc-bs2-output-pitch linear-dominant)
                        (qlslc-bs2-allocation-capacity linear-dominant))) 16)
                (qlslcb-bit (and
                    (not (eq (qlslc-linear-logical-rows full-dominant)
                             (qlslc-bs2-output-pitch full-dominant)))
                    (not (eq (qlslc-full-logical-rows linear-dominant)
                             (qlslc-bs2-output-pitch linear-dominant)))) 32)
                (qlslcb-bit (and
                    (eq (qlslc-bs2-token-offset full-dominant 2) 24576)
                    (eq (qlslc-bs2-token-offset linear-dominant 2) 32768)) 64)
                (qlslcb-bit (and
                    (eq (qlslc-layout-valid? full-dominant ntok) 1)
                    (eq (qlslc-layout-valid? linear-dominant ntok) 1)) 128)
                (qlslcb-bit (and (not (nothing? bias0)) (eq bias0 0)) 256)
                (qlslcb-bit (and (not (nothing? bias1)) (eq bias1 1)) 512)
                (qlslcb-bit (and (eq bias-late 5)
                    (and (eq packed-late 173)
                         (not (eq bias-late packed-late)))) 1024)
                (qlslcb-bit (and (nothing? bad-head)
                    (and (nothing? bad-token)
                    (and (not (nothing? bias0))
                    (and (not (nothing? bias1))
                         (not (eq bias0 bias1)))))) 2048)
                (qlslcb-bit (eq (qlslc-cooperative-gqa-pipeline) 39) 4096)
                (qlslcb-bit (qlslcb-list-eq? pipelines
                    (list 39 40 41 42 43 44 45 46)) 8192)
                (qlslcb-bit (eq (qlslcb-ascending-by-one? pipelines) 1) 16384)
                ; Reaching this bit means both max branches, both pitched
                ; extents, all index signals, and the appended mapping were
                ; computed without source emission or any carrier call.
                (qlslcb-bit 1 32768)))))

    (qwen35-linear-span-layout-contract-band))
