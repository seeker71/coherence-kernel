; qwen35-linear-span-layout-contract-band.fk — pure witness for allocation,
; packed strides, shared head bias, and pipeline continuity.
;
; Verdict 32767 (15 bits):
;   1      packed linear stride is geo[1]
;   2      packed full stride is 2*nq*hd
;   4      full stride wins allocation capacity when larger
;   8      linear stride wins allocation capacity when larger
;   16     allocation capacity is not substituted for packed linear stride
;   32     allocation capacity is not substituted for packed full stride
;   64     token offsets use their block's packed stride
;   128    both packed layouts fit both synthetic allocation capacities
;   256    valid shared bias index 0 is present integer 0
;   512    valid shared bias index 1 is present integer 1
;   1024   bias stays h across tokens while activation offset advances
;   2048   invalid token/head returns nothing, distinct from 0 and 1
;   4096   cooperative decode GQA remains pipeline 39
;   8192   future linear-span pipelines append exactly at 40..44
;   16384  the complete contract is pure data over two geometry sides
;
; preludes: native/metal/qwen35-linear-span-layout-contract.fk

(do
    (defn qlslcb-bit (ok bit) (if ok bit 0))
    (defn qlslcb-list-eq? (a b)
        (if (not (eq (len a) (len b))) 0
            (if (eq (len a) 0) 1
                (if (eq (head a) (head b))
                    (qlslcb-list-eq? (tail a) (tail b)) 0))))

    (defn qwen35-linear-span-layout-contract-band ()
        (do
            ; Qwen-like full-dominant side: 2*24*256 = 12288 > 10240.
            (let full-dominant (qlslc-geometry 10240 24 256))
            ; Same head geometry, but a synthetic wider linear projection.
            (let linear-dominant (qlslc-geometry 16384 24 256))
            (let ntok 3)
            (let bias0 (qlslc-shared-head-bias-index 0 0 24))
            (let bias1 (qlslc-shared-head-bias-index 1 1 24))
            (let bias-late (qlslc-shared-head-bias-index 7 5 24))
            (let packed-late (qlslc-packed-head-index 7 5 24))
            (let bad-head (qlslc-shared-head-bias-index 0 24 24))
            (let bad-token (qlslc-shared-head-bias-index -1 0 24))
            (let pipelines (qlslc-pipeline-contract))

            (sum (list
                (qlslcb-bit (eq (qlslc-packed-linear-stride full-dominant)
                                10240) 1)
                (qlslcb-bit (eq (qlslc-packed-full-stride full-dominant)
                                12288) 2)
                (qlslcb-bit (eq (qlslc-allocation-capacity full-dominant)
                                12288) 4)
                (qlslcb-bit (eq (qlslc-allocation-capacity linear-dominant)
                                16384) 8)
                (qlslcb-bit (not (eq
                    (qlslc-allocation-capacity full-dominant)
                    (qlslc-packed-linear-stride full-dominant))) 16)
                (qlslcb-bit (not (eq
                    (qlslc-allocation-capacity linear-dominant)
                    (qlslc-packed-full-stride linear-dominant))) 32)
                (qlslcb-bit (and
                    (eq (qlslc-linear-token-offset full-dominant 2) 20480)
                    (and
                        (eq (qlslc-full-token-offset full-dominant 2) 24576)
                        (not (eq
                            (qlslc-linear-token-offset full-dominant 2)
                            (mul 2 (qlslc-allocation-capacity
                                      full-dominant)))))) 64)
                (qlslcb-bit (and
                    (eq (qlslc-layout-valid? full-dominant ntok) 1)
                    (eq (qlslc-layout-valid? linear-dominant ntok) 1)) 128)
                (qlslcb-bit (and (not (nothing? bias0)) (eq bias0 0)) 256)
                (qlslcb-bit (and (not (nothing? bias1)) (eq bias1 1)) 512)
                (qlslcb-bit (and (eq bias-late 5)
                    (and (eq packed-late 173)
                         (not (eq bias-late packed-late)))) 1024)
                (qlslcb-bit (and (nothing? bad-head)
                    (and (nothing? bad-token)
                    (and (not (nothing? bias0))
                    (and (not (nothing? bias1))
                         (not (eq bias0 bias1)))))) 2048)
                (qlslcb-bit (eq (qlslc-cooperative-gqa-pipeline) 39) 4096)
                (qlslcb-bit (qlslcb-list-eq? pipelines
                    (list 39 40 41 42 43 44)) 8192)
                ; Reaching this bit means both max branches, both packed
                ; layouts, all index signals, and the future mapping were
                ; computed without source emission or any carrier call.
                (qlslcb-bit 1 16384)))))

    (qwen35-linear-span-layout-contract-band))
