; writable-file-handle-band.fk — the existing Metal file-handle door persists
; a byte write only when Form explicitly supplies a negative view length.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk

(do
    (let path "/tmp/form-writable-file-handle-band.bin")
    (write_file path "a")
    (let h (metal_buf_from_file path 0 (sub 0 3)))
    (let n (metal_buf_write h 1 "bc"))
    (let before-free (read_file_slice path 0 3))
    (let freed (metal_buf_free h))
    (sum (list
        (if (gt h 0) 1 0)
        (if (eq n 2) 2 0)
        (if (eq (file_size path) 3) 4 0)
        (if (str_eq before-free "abc") 8 0)
        (if (eq freed 1) 16 0))))
