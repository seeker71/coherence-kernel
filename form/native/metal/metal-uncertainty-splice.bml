//////////////////////////////////////////////////////////////////////
//
// metal-uncertainty-splice.bml — STONE 43's read-only extension, spliced by the body.
//
// metal_uncertainty.sh measures the logit vector of the proven llama3.2:3b
// forward without forking metal_first_token.sh. This door reads the host
// harness, asks that each of four anchor lines occurs exactly once, sets the
// measurement block and three hooks beside them, and writes the copy the
// carrier runs. An anchor that has moved or doubled refuses the whole splice
// rather than patch something else: the host is the only proven forward this
// program has, and a guess would drift away from it.
//
// stdin, one path per line: the host harness, the patched copy to write, and
// the Swift measurement block (the carrier's own heredoc, bytes as written).
//
//   ./fkwu form/native/metal/metal-uncertainty-splice.bml < paths
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class MetalUncertaintySplice {
        // (anchor, what to set beside it, which side) — applied in this order, each to the text the last one left.
        def mus-anchors(block) = list(
            list("func forward(_ id: Int, _ pos: Int) -> Int {", str_concat(block, "\n"), "before"),
            list("    return Int(bOutI.contents().bindMemory(to: UInt32.self, capacity: 1)[0])", "    if uncRecording { uncMeasure() }\n", "before"),
            list("    usePartsNow = 1; fastOps = true; mvNow = .slot", "\n    uncRecording = uncOn", "after"),
            list("                 encodeS, g.prefill, promptIds.count, g.decode, g.forwards, encodeS + g.prefill + g.decode))", "\n    if uncOn { uncReport(promptIds.count) }", "after"));
        def mus-count(text, needle, from, n) {
            let i = str_find(text, needle, from);
            if lt(i, 0) then n else mus-count(text, needle, add(i, str_len(needle)), add(n, 1));
        }
        def mus-refuse(anchor, n) {
            let said = print_str(str_concat("REFUSED  the anchor is not unique (", str_concat(int_to_str(n), str_concat(" occurrences) in the host harness:\n  ", str_concat(anchor, "\n         metal_first_token.sh has drifted; this extension will not guess.")))));
            form_error("metal uncertainty splice refused");
        }
        def mus-one(text, row) {
            let anchor = nth(row, 0);
            let n = mus-count(text, anchor, 0, 0);
            let at = str_find(text, anchor, 0);
            let cut = if str_eq(nth(row, 2), "before") then at else add(at, str_len(anchor));
            if not(eq(n, 1)) then mus-refuse(anchor, n) else str_concat(substring(text, 0, cut), str_concat(nth(row, 1), substring(text, cut, str_len(text))));
        }
        def mus-apply(text, rows) = if nil?(rows) then text else mus-apply(mus-one(text, head(rows)), tail(rows));
        def mus-chomp(s) = if eq(str_len(s), 0) then s else if or(eq(str_byte_at(s, sub(str_len(s), 1)), 10), eq(str_byte_at(s, sub(str_len(s), 1)), 13)) then mus-chomp(substring(s, 0, sub(str_len(s), 1))) else s;
        def mus-line() {
            let raw = read_line();
            if nothing?(raw) then "" else mus-chomp(raw);
        }
        def mus-run() {
            let host = mus-line();
            let dst = mus-line();
            let blockPath = mus-line();
            let src = read_file(host);
            let block = read_file(blockPath);
            let spliced = if or(nothing?(src), nothing?(block)) then form_error("metal uncertainty splice: host or block unread") else mus-apply(src, mus-anchors(block));
            let written = write_file(dst, spliced);
            if not(eq(written, str_len(spliced))) then form_error("metal uncertainty splice: patched copy incomplete") else str_concat("  splice OK — 4 anchors matched exactly, ", str_concat(int_to_str(str_len(src)), str_concat(" bytes -> ", int_to_str(str_len(spliced)))));
        }
    }
    mus-run();
}
