; Sink-aware single-row MLA attention for one DS4 decode position.
(do
    (defn dsv4-attention-source ()
        "#include <metal_stdlib>\nusing namespace metal;\nkernel void form_dsv4_attention_one_f32(device const float* q [[buffer(0)]], device const float* kv [[buffer(1)]], device const float* sinks [[buffer(2)]], device float* out [[buffer(3)]], constant uint& heads [[buffer(4)]], constant uint& width [[buffer(5)]], constant float& scale [[buffer(6)]], uint h [[thread_position_in_grid]]) { if(h>=heads)return; uint b=h*width; float score=0.0f; for(uint j=0;j<width;j++)score+=q[b+j]*kv[j]; score*=scale; float m=max(score,sinks[h]); float row=exp(score-m); float weight=row/(exp(sinks[h]-m)+row); for(uint j=0;j<width;j++)out[b+j]=kv[j]*weight; }\n")
    0)
