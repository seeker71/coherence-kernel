// source-artifact-probe.fk -- Layer 8c source artifact observation adapter.
//
// This layer supplies the descriptor rows that Layer 8b said would arrive from a
// future host/compiler probe. It is a thin observation-to-descriptor adapter:
// probe rows carry source/program-image/native paths, observed exists/size/mtime,
// and declared identity/integrity fields. The adapter constructs `sad-*`
// descriptors and delegates route/plan decisions to `sad-route` and
// `rap-plan-from-descriptors`.
//
// Probe outcomes are deliberately three-state:
//   absent artifact              -> sad-no-artifact, safe source compile
//   present but unvouched        -> sad-no-artifact, safe source compile
//   contradictory/unidentifiable -> invalid descriptors, investigate
//
// The layer does not hash bytes, verify seals, parse source, sniff path
// extensions, write artifacts, load `.fkb`, call `.dylib`, install a selector,
// decide direct the source door admission, or grow the C seed. The optional live
// observation helpers read only stat facts through `form-fs` doors; hashes,
// seal/proof/callable/lowerable, and includes-tbl remain declarations supplied
// by the caller.
//
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk
section [form.bml] {
    def sap-feature(name, status) = list("source-artifact-probe-feature", name, status);
    def sap-feature-name(f) = nth(f, 1);
    def sap-feature-status(f) = nth(f, 2);
    def source-artifact-probe-manifest() = list(sap-feature("constructs-sad-descriptors", 1), sap-feature("delegates-routing-to-sac", 1), sap-feature("delegates-validation-to-sad", 1), sap-feature("delegates-plan-to-rap", 1), sap-feature("observed-fields-are-declarations", 1), sap-feature("present-unvouched-degrades-to-missing", 1), sap-feature("absent-artifact-is-cache-miss", 1), sap-feature("contradictory-observation-investigates", 1), sap-feature("no-seal-verification", 1), sap-feature("no-artifact-load", 1), sap-feature("no-runtime-selector", 1), sap-feature("read-only-no-disk-write", 1), sap-feature("form-fs-doors-only", 1), sap-feature("no-kind-from-extension", 1), sap-feature("no-byte-hash", 1), sap-feature("no-c-seed-growth", 1));
    def source-artifact-probe-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) sap-feature-name(head(fs)) == name && (Comparable) sap-feature-status(head(fs)) == 1 ? 1 : source-artifact-probe-manifest-has?(name, tail(fs));
    def sap-role-source() = "source";
    def sap-role-program-image-fkb() = "program-image-fkb";
    def sap-role-native-dylib() = "native-dylib";
    def sap-nonempty?(s) = str_len(s) > 0;
    def sap-bit?(x) = (Comparable) x == 0 ? 1 : (Comparable) x == 1 ? 1 : 0;
    // observation = ("source-artifact-probe-observation" role path exists size
    //                mtime source-hash content-hash seal-ok proof callable
    //                lowerable includes-tbl)
    def sap-observation(role, path, exists, size, mtime, source-hash, content-hash, seal-ok, proof, callable, lowerable, includes-tbl) = list("source-artifact-probe-observation", role, path, exists, size, mtime, source-hash, content-hash, seal-ok, proof, callable, lowerable, includes-tbl);
    def sap-observation?(o) = (String) nth(o, 0) == "source-artifact-probe-observation";
    def sap-observation-role(o) = nth(o, 1);
    def sap-observation-path(o) = nth(o, 2);
    def sap-observation-exists(o) = nth(o, 3);
    def sap-observation-size(o) = nth(o, 4);
    def sap-observation-mtime(o) = nth(o, 5);
    def sap-observation-source-hash(o) = nth(o, 6);
    def sap-observation-content-hash(o) = nth(o, 7);
    def sap-observation-seal-ok(o) = nth(o, 8);
    def sap-observation-proof(o) = nth(o, 9);
    def sap-observation-callable(o) = nth(o, 10);
    def sap-observation-lowerable(o) = nth(o, 11);
    def sap-observation-includes-tbl(o) = nth(o, 12);
    // Source rows reuse the generic observation shape. The seal/proof fields
    // below are shape fillers only and never reach a source descriptor.
    def sap-source-observation(path, exists, size, mtime, source-hash) = sap-observation(sap-role-source(), path, exists, size, mtime, source-hash, "", 1, 0, 0, 0, 0);
    def sap-program-image-fkb-observation(path, exists, size, mtime, source-hash, content-hash, seal-ok, includes-tbl) = sap-observation(sap-role-program-image-fkb(), path, exists, size, mtime, source-hash, content-hash, seal-ok, 0, 0, 0, includes-tbl);
    def sap-native-dylib-observation(path, exists, size, mtime, source-hash, content-hash, seal-ok, proof, callable, lowerable) = sap-observation(sap-role-native-dylib(), path, exists, size, mtime, source-hash, content-hash, seal-ok, proof, callable, lowerable, 0);
    def sap-bundle(source, fkb, dylib) = list("source-artifact-probe-bundle", source, fkb, dylib);
    def sap-bundle?(b) = (String) nth(b, 0) == "source-artifact-probe-bundle";
    def sap-bundle-source(b) = nth(b, 1);
    def sap-bundle-fkb(b) = nth(b, 2);
    def sap-bundle-dylib(b) = nth(b, 3);
    def sap-role?(o, role) = (String) sap-observation-role(o) == role;
    def sap-observation-shape-valid?(o) = sap-observation?(o) ? sap-bit?(sap-observation-exists(o)) ? sap-bit?(sap-observation-seal-ok(o)) ? sap-bit?(sap-observation-proof(o)) ? sap-bit?(sap-observation-callable(o)) ? sap-bit?(sap-observation-lowerable(o)) ? sap-bit?(sap-observation-includes-tbl(o)) : 0 : 0 : 0 : 0 : 0 : 0;
    def sap-observation-contradictory?(o) = sap-observation-shape-valid?(o) ? (Comparable) sap-observation-exists(o) == 0 ? sap-observation-mtime(o) > 0 ? 1 : sap-observation-size(o) >= 0 ? 1 : 0 : sap-nonempty?(sap-observation-path(o)) ? sap-observation-size(o) >= 0 ? sap-observation-mtime(o) > 0 ? 0 : 1 : 1 : 1 : 1;
    def sap-observation-consistent?(o) = sap-observation-shape-valid?(o) ? (Comparable) sap-observation-contradictory?(o) == 0 ? 1 : 0 : 0;
    def sap-observation-present?(o) = sap-observation-consistent?(o) ? (Comparable) sap-observation-exists(o) == 1 ? 1 : 0 : 0;
    def sap-observation-absent?(o) = sap-observation-consistent?(o) ? (Comparable) sap-observation-exists(o) == 0 ? 1 : 0 : 0;
    def sap-source-identifiable?(o) = sap-role?(o, sap-role-source()) ? sap-observation-present?(o) ? sap-nonempty?(sap-observation-source-hash(o)) ? 1 : 0 : 0 : 0;
    def sap-artifact-vouched?(o, role) = sap-role?(o, role) ? sap-observation-present?(o) ? sap-nonempty?(sap-observation-source-hash(o)) ? sap-nonempty?(sap-observation-content-hash(o)) ? 1 : 0 : 0 : 0 : 0;
    def sap-artifact-compatible?(o, role) = sap-role?(o, role) ? sap-observation-consistent?(o) : 0;
    def sap-artifact-unvouched?(o, role) = sap-artifact-compatible?(o, role) ? sap-observation-present?(o) ? (Comparable) sap-artifact-vouched?(o, role) == 0 ? 1 : 0 : 0 : 0;
    def sap-invalid-source() = sad-source("", "", 0);
    def sap-source-descriptor(o) = sap-source-identifiable?(o) ? sad-source(sap-observation-path(o), sap-observation-source-hash(o), sap-observation-mtime(o)) : sap-invalid-source();
    def sap-fkb-descriptor(o) = sap-artifact-vouched?(o, sap-role-program-image-fkb()) ? sad-program-image-fkb(sad-version-program-image-fkb(), sap-observation-path(o), sap-observation-source-hash(o), sap-observation-content-hash(o), sap-observation-mtime(o), sap-observation-seal-ok(o), sap-observation-includes-tbl(o)) : sad-no-artifact();
    def sap-dylib-descriptor(o) = sap-artifact-vouched?(o, sap-role-native-dylib()) ? sad-native-dylib(sad-version-native-dylib(), sap-observation-path(o), sap-observation-source-hash(o), sap-observation-content-hash(o), sap-observation-mtime(o), sap-observation-seal-ok(o), sap-observation-proof(o), sap-observation-callable(o), sap-observation-lowerable(o)) : sad-no-artifact();
    def sap-probe-valid?(b) = sap-bundle?(b) ? sap-source-identifiable?(sap-bundle-source(b)) ? sap-artifact-compatible?(sap-bundle-fkb(b), sap-role-program-image-fkb()) ? sap-artifact-compatible?(sap-bundle-dylib(b), sap-role-native-dylib()) : 0 : 0 : 0;
    def sap-descriptor-triple(b) = sap-probe-valid?(b) ? list(sap-source-descriptor(sap-bundle-source(b)), sap-fkb-descriptor(sap-bundle-fkb(b)), sap-dylib-descriptor(sap-bundle-dylib(b))) : list(sap-invalid-source(), sad-no-artifact(), sad-no-artifact());
    def sap-triple-source(t) = nth(t, 0);
    def sap-triple-fkb(t) = nth(t, 1);
    def sap-triple-dylib(t) = nth(t, 2);
    def sap-delegated-route(b) = {
        let t = sap-descriptor-triple(b);
        sad-route(sap-triple-source(t), sap-triple-fkb(t), sap-triple-dylib(t));
    };
    def sap-plan-from-probe(b) = {
        let t = sap-descriptor-triple(b);
        rap-plan-from-descriptors(sap-triple-source(t), sap-triple-fkb(t), sap-triple-dylib(t));
    };
    def sap-observe-source(path, source-hash) = sap-source-observation(path, fs-exists?(path), fs-stat-size(path), fs-stat-mtime(path), source-hash);
    def sap-observe-program-image-fkb(path, source-hash, content-hash, seal-ok, includes-tbl) = sap-program-image-fkb-observation(path, fs-exists?(path), fs-stat-size(path), fs-stat-mtime(path), source-hash, content-hash, seal-ok, includes-tbl);
    def sap-observe-native-dylib(path, source-hash, content-hash, seal-ok, proof, callable, lowerable) = sap-native-dylib-observation(path, fs-exists?(path), fs-stat-size(path), fs-stat-mtime(path), source-hash, content-hash, seal-ok, proof, callable, lowerable);
}
