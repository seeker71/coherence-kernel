
(let SpeakerTurn (language-template-with-members "SpeakerTurn" (list "TMove") (list (language-template-member "move" "TMove") (language-template-member "act" "int") (language-template-member "prompt" "String"))))
(defn SpeakerAuthorityPath () "form/form-stdlib/bml/form-cli-speaker-home.bml")
(defn SpeakerAuthorityKind () "high-bml-class-template-field")
(defn FormSpeakerHomeAuthority () (list "abstraction" "FormSpeakerHomeAuthority" (list) (list) (list "SpeakerAuthorityPath" "SpeakerAuthorityKind") (list) (list)))
(defn ObservedRemoteEvents () 95)
(defn FqtLora () 0)
(defn NativeVoice () 0)
(defn AdapterPath () ".form-lora-adapter")
(defn SpeakerTag () "Speaker: ")
(defn ControlTag () "Control: ")
(defn fspk-authority () FormSpeakerHomeAuthority)
(defn fspk-pattern () (list "next" "act" "prompt" "home"))
(defn fspk-missing () (list "native-nl-voice" "gguf-lora-load" "typed-move-to-addressed-recipe-execution" "graph-topology" "abstraction-class"))
(defn fspk-models () (fqt-fit (fpl-corpus 1 1) (fpl-skills)))
(defn fspk-next (s) (nth (fpl-skills) (fqt-predict-index (fspk-models) s)))
(defn fspk-act (move) (if (str_eq move "ground-first") 0 (if (str_eq move "walk-lane") 1 (if (str_eq move "one-turn") 2 (if (str_eq move "tool-pick") 3 (if (str_eq move "mill-observe") 4 (if (str_eq move "land") 5 (if (str_eq move "no-transcript") 6 7))))))))
(defn fspk-prompt (s) (str_concat (fqt-overlay-prefix) (str_concat "
" (str_concat (SpeakerTag) (str_concat (fspk-next s) (str_concat "
" (str_concat (ControlTag) (str_concat (fqt-verdict-name s) (str_concat "
" s)))))))))
(defn fcmg-teach (prompt) (fspk-prompt prompt))
(defn fspk-heldout () (fpl-heldout-correct (fpl-corpus 1 1)))
(defn fspk-home () (if (and (eq (fspk-heldout) 72) (eq (FqtLora) 0)) 1 0))
(defn fspk-fuel () (fpl-situation "ground-first" "how" 0 (SplitTrain)))
(defn fspk-bit (ok bit) (if ok bit 0))
(defn fspk-check () (do (let sit (fpl-situation "walk-lane" "how" 0 (SplitHeldout))) (let p (fspk-prompt sit)) (let c0 (fspk-bit (eq (fspk-heldout) 72) 1)) (let c1 (fspk-bit (ge (str_find p (SpeakerTag) 0) 0) 2)) (let c2 (fspk-bit (ge (str_find p (ControlTag) 0) 0) 4)) (let c3 (fspk-bit (ge (str_find p "walk-lane" 0) 0) 8)) (let c4 (fspk-bit (eq (fspk-act "tool-pick") 3) 16)) (let c5 (fspk-bit (eq (ObservedRemoteEvents) 95) 32)) (let c6 (fspk-bit (and (eq (FqtLora) 0) (eq (fqt-lora?) 0)) 64)) (let c7 (fspk-bit (and (eq (NativeVoice) 0) (eq (fspk-home) 1)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormSpeakerHome () (list "abstraction" "FormSpeakerHome" (list "T") (list "fspk-models" "fspk-next" "fspk-act" "fspk-prompt" "fcmg-teach" "fspk-heldout" "fspk-home" "fspk-fuel" "fspk-bit" "fspk-check") (list "ObservedRemoteEvents" "FqtLora" "NativeVoice" "AdapterPath" "SpeakerTag" "ControlTag") (list "fspk-authority") (list "fspk-pattern" "fspk-missing")))
0
