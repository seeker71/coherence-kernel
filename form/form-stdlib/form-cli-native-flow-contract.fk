; form-cli-native-flow-contract.fk — do not confuse local with Form-native.
;
; A response is end-to-end Form-native only when generation remains inside the
; invocation container. Local weights and Form-owned routing are insufficient.
;
; preludes: form-stdlib/core.fk

(do
    ; (form-routing local-weights host-exec shell swift remote network)
    (defn fnfc-flow
        (form-routing local-weights host-exec shell swift remote network)
        (list form-routing local-weights host-exec shell swift remote network))

    (defn fnfc-form-routing (x) (nth x 0))
    (defn fnfc-local-weights (x) (nth x 1))
    (defn fnfc-host-exec (x) (nth x 2))
    (defn fnfc-shell (x) (nth x 3))
    (defn fnfc-swift (x) (nth x 4))
    (defn fnfc-remote (x) (nth x 5))
    (defn fnfc-network (x) (nth x 6))

    (defn fnfc-local-offline? (x)
        (if (and (eq (fnfc-local-weights x) 1)
                 (and (eq (fnfc-remote x) 0)
                      (eq (fnfc-network x) 0)))
            1 0))

    (defn fnfc-end-to-end-form-native? (x)
        (if (and (eq (fnfc-form-routing x) 1)
             (and (eq (fnfc-local-weights x) 1)
             (and (eq (fnfc-host-exec x) 0)
             (and (eq (fnfc-shell x) 0)
             (and (eq (fnfc-swift x) 0)
             (and (eq (fnfc-remote x) 0)
                  (eq (fnfc-network x) 0)))))))
            1 0))

    (defn fnfc-current-ds4-flow ()
        (fnfc-flow 1 1 1 1 1 0 0))

    0)
