; form-cli-allowance-birth-run.fk — watch JIT birth the 5 BML named.
;
; Also asks the GPU the same add. MLX stays an organ, not a second binary;
; this sitting has no MLX dispatch primitive for this add.
;
; preludes: form-stdlib/form-asm.fk form-stdlib/metal-door.fk form-stdlib/form-cli-allowance-birth.bml observe/bidirectional-framebuffer-channel.fk

(do
    (defn alb-bytes (xs)
        (if (eq (len xs) 0) ""
            (str_concat (byte_to_str (head xs)) (alb-bytes (tail xs)))))
    (defn alb-nl () (byte_to_str 10))
    (defn alb-msl ()
        (str_concat "#include <metal_stdlib>"
        (str_concat (alb-nl)
        (str_concat "using namespace metal;"
        (str_concat (alb-nl)
                    "kernel void form_allowance_add(device uint *a [[buffer(0)]], constant uint &b [[buffer(1)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] + b; }")))))
    (print "form-cli executed allowance-birth\n")
    (print "form-cli bml lhs=")
    (print (int_to_str (alb-lhs)))
    (print " rhs=")
    (print (int_to_str (alb-rhs)))
    (print " bml=")
    (print (int_to_str (alb-bml)))
    (print "\n")
    (let image
        (fa-image (list
            (fa-ldr 3 0 0)
            (fa-ldr-w 4 1 0)
            (fa-ldr-w 5 3 0)
            (fa-add-r 5 5 4)
            (fa-str-w 5 3 0)
            (fa-ret))))
    (let code (alb-bytes image))
    (let buffer (metal_buf_alloc 4))
    (metal_buf_write buffer 0 (md-le32 (alb-lhs)))
    (let pipeline (metal_pipeline code "form_cpu_jit"))
    (let enqueued (metal_enqueue pipeline (md-bind (list buffer) (list (alb-rhs))) 1))
    (let result (metal_buf_read buffer 0 4))
    (print "form-cli jit pipeline=")
    (print (int_to_str pipeline))
    (print " enqueue=")
    (print (int_to_str enqueued))
    (print " byte0=")
    (print (int_to_str (str_byte_at result 0)))
    (print "\n")
    (let gbuf (metal_buf_alloc 4))
    (metal_buf_write gbuf 0 (md-le32 (alb-lhs)))
    (let gpipe (metal_pipeline (alb-msl) "form_allowance_add"))
    (let genq (metal_enqueue gpipe (md-bind (list gbuf) (list (alb-rhs))) 1))
    (let gsync (metal_sync))
    (let gres (metal_buf_read gbuf 0 4))
    (print "form-cli gpu pipeline=")
    (print (int_to_str gpipe))
    (print " enqueue=")
    (print (int_to_str genq))
    (print " sync=")
    (print (int_to_str gsync))
    (print " byte0=")
    (print (int_to_str (str_byte_at gres 0)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli metal=\n")
    (print (metal_status))
    (print "\n")
    (metal_buf_free buffer)
    (metal_buf_free gbuf)
    0)
