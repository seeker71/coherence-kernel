// Opt-in Qwen generation with reversible attention declarations.
// Caller owns an admitted q38 context and a fresh stream state. The prompt is
// fully prefetched once; only generated bytes can drive the scope parser.
// preludes: native/metal/qwen35-dense-token-handle.fk form-stdlib/dsv4-tokenizer.fk

section [form.bml] {
    class FormCliDeclarativeAttention {
        def qdag-instruction() = "Use <global> to locate context, <focus magic_chunks=\"1\"> to read a named chunk, and <local> to work from extracted facts. Close each span with its matching tag. Multiple chunk ids use commas without spaces. The question, instructions, and generated response remain available. Return to global whenever more evidence is needed.";
        // Result: status, generated ids, parser state, next cache position,
        // actual selected-position total, equivalent full-position total,
        // decode forwards. Totals cover executed decode forwards only.
        def qdag-result(status, out, state, pos, attended, full, forwards) = list(status, reverse(out), state, pos, attended, full, forwards);
        def qdag-forward(ctx, sts, id, pos, scope, enabled) = if eq(enabled, 1) then q38-forward-scoped(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), sts, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), id, pos, scope) else q38-forward(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), sts, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), id, pos);
        def qdag-prefill(ctx, sts, ids) = q38-prefill(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), sts, nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), ids, 0);
        def qdag-loop(ctx, sts, cfg, device, scope, state, id, pos, left, stops, enabled, out, attended, full, forwards) = if lt(id, 0) then qdag-result("forward-refused", out, state, pos, attended, full, forwards) else if da-member(id, stops) then qdag-result("stop", out, state, pos, attended, full, forwards) else qdag-output(ctx, sts, cfg, device, scope, state, id, pos, left, stops, enabled, out, attended, full, forwards);
        def qdag-output(ctx, sts, cfg, device, scope, state, id, pos, left, stops, enabled, out, attended, full, forwards) {
            let nextState = da-feed-output(state, tkz-decode-text(nth(ctx, 7), list(id)), cfg);
            let output = cons(id, out);
            if le(left, 1) then qdag-result("budget", output, nextState, pos, attended, full, forwards)
            else qdag-advance(ctx, sts, cfg, device, if eq(da-transitions(nextState), da-transitions(state)) then scope else dam-select(device, nextState), nextState, id, pos, left, stops, enabled, output, attended, full, forwards);
        }
        def qdag-advance(ctx, sts, cfg, device, scope, state, id, pos, left, stops, enabled, out, attended, full, forwards) {
            if nothing?(scope) then qdag-result("scope-refused", out, state, pos, attended, full, forwards)
            else qdag-forwarded(ctx, sts, cfg, device, scope, state, qdag-forward(ctx, sts, id, pos, scope, enabled), pos, left, stops, enabled, out, attended, full, forwards);
        }
        def qdag-forwarded(ctx, sts, cfg, device, scope, state, next, pos, left, stops, enabled, out, attended, full, forwards) = if lt(next, 0) then qdag-result("forward-refused", out, state, pos, attended, full, forwards) else qdag-loop(ctx, sts, cfg, device, scope, state, next, add(pos, 1), sub(left, 1), stops, enabled, out, add(attended, if eq(enabled, 1) then dam-attended(scope, add(pos, 1)) else add(pos, 1)), add(full, add(pos, 1)), add(forwards, 1));
        def qdag-generate(ctx, sts, cfg, ids, budget, stops, enabled) = if nothing?(cfg) then list("config-refused") else if not(eq(nth(cfg, 2), len(ids))) then list("prompt-coordinates-refused") else if le(len(ids), 0) then list("empty-prompt") else if le(budget, 0) then list("empty-budget") else if gt(add(len(ids), budget), nth(nth(ctx, 2), 18)) then list("cache-capacity-refused") else qdag-open(ctx, sts, cfg, ids, budget, stops, enabled, dam-open());
        def qdag-open(ctx, sts, cfg, ids, budget, stops, enabled, device) {
            if nothing?(device) then list("metal-scope-unavailable") else qdag-run(ctx, sts, cfg, ids, budget, stops, enabled, device, dam-select(device, da-initial(cfg)));
        }
        def qdag-run(ctx, sts, cfg, ids, budget, stops, enabled, device, scope) {
            if nothing?(scope) then qdag-close-result(device, list("scope-refused")) else qdag-prefilled(ctx, sts, cfg, budget, stops, enabled, device, scope, qdag-prefill(ctx, sts, ids));
        }
        def qdag-prefilled(ctx, sts, cfg, budget, stops, enabled, device, scope, prefill) {
            let result = qdag-loop(ctx, sts, cfg, device, scope, da-initial(cfg), nth(prefill, 0), nth(prefill, 1), budget, stops, enabled, list(), 0, 0, 0);
            qdag-close-result(device, result);
        }
        def qdag-close-result(device, result) {
            let closed = dam-close(device);
            if eq(closed, 1) then result else list("scope-release-failed", result);
        }
    }
    0;
}
