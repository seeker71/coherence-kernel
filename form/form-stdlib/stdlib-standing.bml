//////////////////////////////////////////////////////////////////////
//
// stdlib-standing.bml — the stdlib's standing, read while it runs.
//
// C++ settles its library before the program starts: a template becomes an
// instance at compile time, so its first call is already warm. This body
// settles its library while it runs: a recipe starts walked, meets the heat
// door after FK_F64_HEAT calls, and crystallizes a native instance for each
// signature it meets, or declines, and the hot rows name the door it met.
// So the standing of a family is what its recipe does cold, what it becomes
// warm, and which of its defns carry the work natively, asked afresh each
// time. The authoring altitude is observe/authoring-altitude-run.fk's to say.
//
// preludes: form-stdlib/core.fk
//
// The observe/stdlib-standing-run.fk door only asks this class. It answers
// the count of families whose named defns all read a native state.
//
section [form.bml] {
    class StdlibStanding {
        def sst-add(a, b) = add(a, b);
        def sst-dbl(x) = mul(x, 2);
        def sst-even?(x) = eq(mod(x, 2), 0);
        def sst-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), sst-cat(tail(parts)));

        // ---- one driver per family: n calls of its stand-in, folded to an int ----
        def sst-d-accumulate(n, xs, t) = if le(n, 0) then t else sst-d-accumulate(sub(n, 1), xs, add(t, foldl(sst-add, 0, xs)));
        def sst-d-transform(n, xs, t) = if le(n, 0) then t else sst-d-transform(sub(n, 1), xs, add(t, len(map(sst-dbl, xs))));
        def sst-d-copy-if(n, xs, t) = if le(n, 0) then t else sst-d-copy-if(sub(n, 1), xs, add(t, len(filter(sst-even?, xs))));
        def sst-d-iota-take(n, xs, t) = if le(n, 0) then t else sst-d-iota-take(sub(n, 1), xs, add(t, len(take(5, range(0, 19)))));
        def sst-d-reduce(n, xs, t) = if le(n, 0) then t else sst-d-reduce(sub(n, 1), xs, add(t, add(sum(xs), maximum(xs))));
        def sst-d-to-string(n, xs, t) = if le(n, 0) then t else sst-d-to-string(sub(n, 1), xs, add(t, str_len(int_to_str(add(n, 123456789)))));
        def sst-d-stoi(n, xs, t) = if le(n, 0) then t else sst-d-stoi(sub(n, 1), xs, add(t, str_to_int("123456789")));
        def sst-d-to-chars(n, xs, t) = if le(n, 0) then t else sst-d-to-chars(sub(n, 1), xs, add(t, str_len(float-repr(add(0.1, mul(n, 0.001))))));

        // ---- the families: the C++ name, its driver, the defns that carry it ----
        def sst-families() = list(list("accumulate", sst-d-accumulate, list("foldl")), list("transform", sst-d-transform, list("map-onto", "reverse-onto")), list("copy_if", sst-d-copy-if, list("filter-onto")), list("iota+take", sst-d-iota-take, list("range-down", "take-onto")), list("reduce", sst-d-reduce, list("sum-onto", "maximum-onto")), list("to_string", sst-d-to-string, list("int_to_str", "fstr-int-str", "fstr-digits")), list("stoi", sst-d-stoi, list("str_to_int", "fstr-to-int-loop")), list("to_chars", sst-d-to-chars, list("float-repr", "fr-digits", "fr-me", "d4w", "d4w-run", "d4w-scale")));

        // ---- reading ----
        def sst-cpu(d, n, xs) {
            let t0 = host_cpu_us();
            let r = d(n, xs, 0);
            if lt(r, 0) then -1 else sub(host_cpu_us(), t0);
        }
        def sst-state(name, rows) = if eq(len(rows), 0) then -99 else if str_eq(nth(head(rows), 1), name) then nth(head(rows), 7) else sst-state(name, tail(rows));
        def sst-states(names, rows) = if eq(len(names), 0) then "" else sst-cat(list(" ", head(names), "=", int_to_str(sst-state(head(names), rows)), sst-states(tail(names), rows)));
        def sst-warm?(names, rows) = if eq(len(names), 0) then 1 else if lt(sst-state(head(names), rows), 1) then 0 else sst-warm?(tail(names), rows);
        // cold: 32 calls, whose inner loops stay under the heat door; warm: 512 calls past it
        def sst-ns(us, calls) = div(mul(us, 1000), calls);
        def sst-family(fam, xs) {
            let cold = sst-ns(sst-cpu(nth(fam, 1), 32, xs), 32);
            let heat = sst-cpu(nth(fam, 1), 2048, xs);
            let warm = sst-ns(sst-cpu(nth(fam, 1), 512, xs), 512);
            let rows = kernel_page_hot(host_pid(), 600);
            print(sst-cat(list(nth(fam, 0), "  cold ", int_to_str(cold), " ns  warm ", int_to_str(warm), " ns a call  x", int_to_str(div(cold, if lt(warm, 1) then 1 else warm)), " ", sst-states(nth(fam, 2), rows))));
            sst-warm?(nth(fam, 2), rows);
        }
        def sst-each(fams, xs, acc) = if eq(len(fams), 0) then acc else sst-each(tail(fams), xs, add(acc, sst-family(head(fams), xs)));
        def sst-run() {
            print("stdlib standing, read while it runs: cold is walked, warm is past the heat door");
            print("states: 2 native loop, 1 native leaf, -1 declined, -1xxx refused op tag xxx, -99 not hot");
            let warm = sst-each(sst-families(), range(1, 20), 0);
            print(sst-cat(list("families warm: ", int_to_str(warm), " of ", int_to_str(len(sst-families())))));
            warm;
        }
    }
    sst-run();
}
