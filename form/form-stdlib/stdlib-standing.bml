//////////////////////////////////////////////////////////////////////
//
// stdlib-standing.bml — the stdlib's standing, measured beside the host's C++.
//
// C++ settles its library before the program starts; this body settles it while
// it runs: a recipe starts walked, meets the heat door after FK_F64_HEAT calls,
// and crystallizes a native instance per signature it meets, or declines, and
// the hot rows name the door it met. Each family's core.fk stand-in and the
// host's C++ standard library (tests/oracles/stdlib-standing-oracle.cpp) do the
// same work and are measured the same way: process CPU time at the host clock's
// resolution, the first 32 calls from a cold start, then the median of five
// 512-call batches past warm-up. The body is measured first and the reference
// after it, never together. The authoring altitude is
// observe/authoring-altitude-run.fk's to say.
//
// The GPU column is the chooser's first reading: the same family's recipe lowered by
// form-stdlib/bml/gpu-lower.bml from its own nodes, run over a resident buffer with the
// answer read back (so the wait is paid), wall time per call at the organ's 19 elements and
// at 100,000, beside the body's own warm reading at 100,000. A family without a list
// recipe or with string work has no GPU lane and says so.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/gpu-lower.bml
//
// The observe/stdlib-standing-run.fk door only asks this class. It answers the
// count of families whose named defns all read a native state.
//
section [form.bml] {
    class StdlibStanding {
        def sst-add(a, b) = (a + b);
        def sst-dbl(x) = (x * 2);
        def sst-even?(x) = ((Comparable) (x % 2) == 0);
        def sst-cat(parts) = if ((Comparable) len(parts) == 0) then "" else str_concat(head(parts), sst-cat(tail(parts)));
        def sst-nl() = byte_to_str(10);

        // ---- one driver per family: n calls of its stand-in, folded to an int ----
        def sst-d-accumulate(n, xs, t) = if (n <= 0) then t else sst-d-accumulate((n - 1), xs, (t + foldl(sst-add, 0, xs)));
        def sst-d-transform(n, xs, t) = if (n <= 0) then t else sst-d-transform((n - 1), xs, (t + len(map(sst-dbl, xs))));
        def sst-d-copy-if(n, xs, t) = if (n <= 0) then t else sst-d-copy-if((n - 1), xs, (t + len(filter(sst-even?, xs))));
        def sst-d-iota-take(n, xs, t) = if (n <= 0) then t else sst-d-iota-take((n - 1), xs, (t + len(take(5, range(0, 19)))));
        def sst-d-reduce(n, xs, t) = if (n <= 0) then t else sst-d-reduce((n - 1), xs, (t + (sum(xs) + maximum(xs))));
        def sst-d-to-string(n, xs, t) = if (n <= 0) then t else sst-d-to-string((n - 1), xs, (t + str_len(int_to_str((n + 123456789)))));
        def sst-d-stoi(n, xs, t) = if (n <= 0) then t else sst-d-stoi((n - 1), xs, (t + str_to_int("123456789")));
        def sst-d-to-chars(n, xs, t) = if (n <= 0) then t else sst-d-to-chars((n - 1), xs, (t + str_len(float-repr((0.1 + (n * 0.001))))));

        // ---- the families: the C++ name, its driver, the defns that carry it ----
        def sst-families() = list(list("accumulate", sst-d-accumulate, list("foldl")), list("transform", sst-d-transform, list("map-onto", "reverse-onto")), list("copy_if", sst-d-copy-if, list("filter-onto")), list("iota+take", sst-d-iota-take, list("range-down", "take-onto")), list("reduce", sst-d-reduce, list("sum-onto", "maximum-onto")), list("to_string", sst-d-to-string, list("int_to_str", "fstr-int-str", "fstr-digits")), list("stoi", sst-d-stoi, list("str_to_int", "fstr-to-int-loop")), list("to_chars", sst-d-to-chars, list("float-repr", "fr-digits", "fr-me", "d4w", "d4w-run", "d4w-scale")));

        // ---- measuring the body ----
        def sst-cpu(d, n, xs) {
            let t0 = host_cpu_us();
            let r = d(n, xs, 0);
            if (r < 0) then -1 else (host_cpu_us() - t0);
        }
        def sst-ns(us, calls) = ((us * 1000) / calls);
        def sst-ins(x, s) = if ((Comparable) len(s) == 0) then list(x) else if (x <= head(s)) then cons(x, s) else cons(head(s), sst-ins(x, tail(s)));
        def sst-sort(xs, acc) = if ((Comparable) len(xs) == 0) then acc else sst-sort(tail(xs), sst-ins(head(xs), acc));
        def sst-median(xs) = nth(sst-sort(xs, list()), (len(xs) / 2));
        def sst-batch(d, xs) = sst-ns(sst-cpu(d, 512, xs), 512);
        def sst-warm5(d, xs) = sst-median(list(sst-batch(d, xs), sst-batch(d, xs), sst-batch(d, xs), sst-batch(d, xs), sst-batch(d, xs)));
        def sst-state(name, rows) = if ((Comparable) len(rows) == 0) then -99 else if ((String) nth(head(rows), 1) == name) then nth(head(rows), 7) else sst-state(name, tail(rows));
        def sst-states(names, rows) = if ((Comparable) len(names) == 0) then "" else sst-cat(list(" ", head(names), "=", int_to_str(sst-state(head(names), rows)), sst-states(tail(names), rows)));
        def sst-warm?(names, rows) = if ((Comparable) len(names) == 0) then 1 else if (sst-state(head(names), rows) < 1) then 0 else sst-warm?(tail(names), rows);
        // a family's body reading: name, cold ns, warm ns, its defns' states, fully warm
        def sst-measure(fam, xs) {
            let cold = sst-ns(sst-cpu(nth(fam, 1), 32, xs), 32);
            let heat = sst-cpu(nth(fam, 1), 2048, xs);
            let warm = sst-warm5(nth(fam, 1), xs);
            let rows = kernel_page_hot(host_pid(), 600);
            list(nth(fam, 0), cold, warm, sst-states(nth(fam, 2), rows), sst-warm?(nth(fam, 2), rows));
        }
        def sst-measure-all(fams, xs) = if ((Comparable) len(fams) == 0) then list() else cons(sst-measure(head(fams), xs), sst-measure-all(tail(fams), xs));

        // ---- the GPU lane, after the body: the same recipe lowered from its nodes, resident data ----
        def sst-gpu-spec(name) = if ((String) name == "accumulate") then list("foldl", list(list(0, "sst-add"))) else if ((String) name == "transform") then list("map-onto", list(list(0, "sst-dbl"))) else if ((String) name == "copy_if") then list("filter-onto", list(list(0, "sst-even?"))) else if ((String) name == "reduce") then list("sum-onto", list()) else list();
        def sst-floats(xs) = if ((Comparable) len(xs) == 0) then list() else cons((head(xs) + 0.0), sst-floats(tail(xs)));
        // one call: enqueue, read the answer (the wait), free the out buffer
        def sst-gpu-call(prog, h, n) {
            let out = gl-run(prog, list(h), n, 0.0, list());
            let v = gl-read(out);
            let freed = metal_buf_free(out);
            v;
        }
        def sst-gpu-calls(prog, h, n, k, seen) = if (k <= 0) then 0 else sst-gpu-calls(prog, h, n, (k - 1), sst-gpu-call(prog, h, n));
        // wall ns per call over 512 calls, each with its answer read back; -1 when the lane declines
        def sst-gpu-ns(spec, xs) {
            let prog = gl-program-bound(nth(spec, 0), nth(spec, 1));
            let h = if gl-ok?(prog) then gl-f32-buf(sst-floats(xs)) else 0;
            let warm = if gl-ok?(prog) then sst-gpu-calls(prog, h, len(xs), 8, 0) else 0;
            let t0 = host_monotonic_ms();
            let ran = if gl-ok?(prog) then sst-gpu-calls(prog, h, len(xs), 512, 0) else 0;
            let t1 = host_monotonic_ms();
            let freed = if gl-ok?(prog) then metal_buf_free(h) else 0;
            if gl-ok?(prog) then (((t1 - t0) * 1000000) / 512) else -1;
        }
        def sst-gpu-text(name, xs, big) {
            let spec = sst-gpu-spec(name);
            if ((Comparable) len(spec) == 0) then "  gpu: no lane" else sst-cat(list("  gpu wall ", int_to_str(sst-gpu-ns(spec, xs)), " ns/call at 19, ", int_to_str(sst-gpu-ns(spec, big)), " at 100k resident (", nth(spec, 0), ")"));
        }
        // the body's own warm reading at 100k, so the two sizes name the crossover
        def sst-big-text(fam, big) = if ((Comparable) len(sst-gpu-spec(nth(fam, 0))) == 0) then "" else sst-cat(list("  body warm at 100k ", int_to_str(sst-batch(nth(fam, 1), big)), " ns/call"));

        // ---- measuring the host's C++, after the body ----
        def sst-host(cmd) {
            let v = host-exec(cmd, "");
            if nothing?(v) then "" else v;
        }
        def sst-chomp(s) = if (str_len(s) < 1) then s else if ((Comparable) str_byte_at(s, (str_len(s) - 1)) == 10) then substring(s, 0, (str_len(s) - 1)) else s;
        def sst-oracle-cpp() = "form/form-stdlib/tests/oracles/stdlib-standing-oracle.cpp";
        def sst-oracle-cmd() = sst-cat(list("d=`mktemp -d` && c++ -std=c++20 -O2 ", sst-oracle-cpp(), " -o $d/oracle && $d/oracle && rm -rf $d"));
        def sst-oracle-line(f, acc) = if (len(f) < 3) then acc else cons(list(nth(f, 0), str_to_int(nth(f, 1)), str_to_int(nth(f, 2))), acc);
        def sst-oracle-keep(lines, acc) = if ((Comparable) len(lines) == 0) then acc else sst-oracle-keep(tail(lines), sst-oracle-line(split-on(head(lines), " "), acc));
        def sst-oracle-rows(text) = sst-oracle-keep(split-on(text, sst-nl()), list());
        def sst-oracle-row(name, rows) = if ((Comparable) len(rows) == 0) then list() else if ((String) nth(head(rows), 0) == name) then head(rows) else sst-oracle-row(name, tail(rows));

        // ---- the reading ----
        // the clock's floor: a batch reading at or under res/calls is under the clock, and says so
        def sst-res(refs) {
            let r = sst-oracle-row("clock-res-ns", refs);
            if ((Comparable) len(r) == 0) then 1000 else nth(r, 1);
        }
        def sst-q(v, floor) = if (v <= floor) then sst-cat(list("under ", int_to_str((floor + 1)))) else int_to_str(v);
        // a ratio to one decimal, from integer tenths
        def sst-x(a, b) {
            let t = ((a * 10) / (if (b < 1) then 1 else b));
            sst-cat(list(int_to_str((t / 10)), ".", int_to_str((t % 10))));
        }
        def sst-cmp(bw, cw, wf) = if (cw <= wf) then sst-cat(list("body at least x", sst-x(bw, (wf + 1)), " the reference")) else if (bw >= cw) then sst-cat(list("body x", sst-x(bw, cw), " the reference")) else sst-cat(list("reference x", sst-x(cw, bw), " the body"));
        def sst-ref-text(r, cf, wf) = if ((Comparable) len(r) == 0) then "reference no reading" else sst-cat(list("c++ cold ", sst-q(nth(r, 1), cf), " warm ", sst-q(nth(r, 2), wf), " ns"));
        def sst-say(b, refs) {
            let r = sst-oracle-row(nth(b, 0), refs);
            let cf = (sst-res(refs) / 32);
            let wf = (sst-res(refs) / 512);
            print(sst-cat(list(nth(b, 0), "  body cold ", sst-q(nth(b, 1), cf), " warm ", sst-q(nth(b, 2), wf), " ns  ", sst-ref-text(r, cf, wf), "  warm: ", if ((Comparable) len(r) == 0) then "unmeasured" else sst-cmp(nth(b, 2), nth(r, 2), wf), " ", nth(b, 3))));
            nth(b, 4);
        }
        def sst-say-all(bs, refs, acc) = if ((Comparable) len(bs) == 0) then acc else sst-say-all(tail(bs), refs, (acc + sst-say(head(bs), refs)));
        def sst-gpu-all(fams, xs, big) = if ((Comparable) len(fams) == 0) then 0 else sst-gpu-one(head(fams), tail(fams), xs, big);
        def sst-gpu-one(fam, rest, xs, big) {
            let shown = print(sst-cat(list("chooser ", nth(fam, 0), sst-gpu-text(nth(fam, 0), xs, big), sst-big-text(fam, big))));
            sst-gpu-all(rest, xs, big);
        }
        def sst-run() {
            print(sst-cat(list("stdlib standing, measured: host load ", sst-chomp(sst-host("sysctl -n vm.loadavg")), "  reference ", sst-chomp(sst-host("c++ --version | head -1")))));
            print("both sides: process CPU time, cold = the first 32 calls, warm = median of five 512-call batches past warm-up");
            print("states: 2 native loop, 1 native leaf, -1 declined, -1xxx refused op tag xxx, -99 not hot");
            let body = sst-measure-all(sst-families(), range(1, 20));
            let refs = sst-oracle-rows(sst-host(sst-oracle-cmd()));
            let warm = sst-say-all(body, refs, 0);
            let big = range(1, 100001);
            let gpu = sst-gpu-all(sst-families(), range(1, 20), big);
            print(sst-cat(list("families fully warm: ", int_to_str(warm), " of ", int_to_str(len(sst-families())), "  reference rows: ", int_to_str(len(refs)))));
            warm;
        }
    }
    sst-run();
}
