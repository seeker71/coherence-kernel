//////////////////////////////////////////////////////////////////////
//
// form-cli-session-local.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-session-local.bml
//
// Formulas over session counts. No prompt bytes and no fixed target. Every
// denominator is recomputed from the presented census. Train sources are Form organs.
//
// Proven by: form-stdlib/tests/form-cli-session-local-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SessionRow<TCount> {
        member requests: TCount;
        member remoteTurns: TCount;
        member native: TCount;
        member local: TCount;
    }

    class FormSessionLocalAuthority {
        field SessionLocalAuthorityPath = "form/form-stdlib/bml/form-cli-session-local.bml";
        field SessionLocalAuthorityKind = "high-bml-class-template-field";
    }

    class FormSessionLocal<T> {
        field CensusRule = "fresh-denominator-no-fixed-target";
        field OneTurn = 1;
        field ThisNative = 414;
        field ThisLocal = 473;
        field ThisRemote = 105;
        field LogSessions = 61;
        field LogUsers = 233;
        field LogAsst = 623;
        field ClaudeMains = 48;
        field ClaudeUsers = 15292;
        field ClaudeAsst = 29739;
        field ClaudeTools = 14358;
        field ClaudeBash = 11549;
        field ClaudeFkwu = 1502;
        field ClaudeWeb = 80;
        field TrainMint = "form/form-stdlib/form-cli-knowledge-mint.bml";
        field TrainCorpus = "learn/corpus-teach-samples.fk";
        field TrainOverlay = "form/form-stdlib/form-cli-qwen-teach-layer.fk";
        field TrainLora = "form/form-stdlib/form-cli-lora-writer.bml";
        field TrainReady = "form/form-stdlib/form-cli-local-ready.bml";
        field TrainExec = "form/form-stdlib/form-cli-ingest-exec.bml";

        ref fsl-authority = FormSessionLocalAuthority;
        thought fsl-pattern = list("count", "leak", "train-from-form", "fresh-census");

        def fsl-leak(remote, requests) = if le(remote, requests) then 0 else sub(remote, requests);

        def fsl-event-local-ppm(native, local, remote) {
            let tot = add(native, add(local, remote));
            if eq(tot, 0) then 0 else div(mul(add(native, local), 1000000), tot);
        }

        def fsl-session-local(remote-present, resolved) = if eq(fot-next-drop(1, resolved, remote-present), NextStop()) then 1 else 0;

        def fsl-unresolved(shape-ready, native-hit) = if eq(fcr-walk(native-hit, shape-ready), 2) then 1 else 0;

        def fsl-tool-coverable-ppm(tools, web) = if eq(tools, 0) then 0 else div(mul(sub(tools, web), 1000000), tools);

        def fsl-bit(ok, bit) = if ok then bit else 0;

        def fsl-check() {
            let c0 = fsl-bit(eq(fsl-leak(105, 1), 104), 1);
            let c1 = fsl-bit(eq(fsl-leak(623, 233), 390), 2);
            let c2 = fsl-bit(eq(fsl-event-local-ppm(414, 473, 105), 894153), 4);
            let c3 = fsl-bit(eq(fsl-session-local(0, 1), 1), 8);
            let c4 = fsl-bit(eq(fsl-session-local(1, 0), 0), 16);
            let c5 = fsl-bit(eq(fsl-unresolved(0, 0), 1), 32);
            let c6 = fsl-bit(eq(fsl-unresolved(1, 0), 0), 64);
            let c7 = fsl-bit(and(eq(fsl-event-local-ppm(ThisNative(), ThisLocal(), ThisRemote()), 894153), eq(fsl-tool-coverable-ppm(ClaudeTools(), ClaudeWeb()), 994428)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
