; dsv4-token-recipe-swap.fk — a bounded Form-native alternative to one DS4 argmax token.
;
; The DeepSeek-V4-Flash lane already produces a default token. This cell gives that token one
; inspectable alternative: any Form recipe may run inside the SAME absolute deadline and the SAME
; Metal-bandwidth envelope, return a candidate token, and replace the default only when its witnessed
; vitality is strictly higher. A missing, declined, late, over-bandwidth, unwitnessed, or tied result
; acknowledges nothing and the default token stays. The default is never silently lost.
;
; The concrete DS4 envelope is grounded in receipts/2026-07-31-the-bus-and-the-two-arms.md and
; receipts/2026-08-01-the-model-is-useful.md:
;   34 ms/token observed generation floor; 471 GB/s measured resident-memory bus;
;   9.103 GB of model weight bytes touched per default token.
; At those measurements the shared window can carry 16.014 GB, leaving 6.911 GB for one alternative
; while the default remains available. Callers may supply a newly measured envelope; these numbers are
; a named baseline, not universal hardware constants.
;
; The five core axioms are limits, not decorative scores:
;   axiom 1 — timeout is the explicit "nothing" state, never a failed or zero token;
;   axiom 2 — window, offer, candidate, choice, trial, and baseline are tagged cells;
;   axiom 3 — installation returns a NEW baseline carrying the old baseline as its parent;
;   axiom 4 — only an offered, trusted, observed boundary result may cross;
;   axiom 5 — every recipe offer acknowledges with exactly nothing, 0, 1, or node.
;
; Honest execution seam: dtrs-run-live invokes a Form function value and measures it with the native
; clock. The current evaluator cannot preempt an arbitrary in-process recipe. A recipe must therefore
; cooperate with the absolute deadline it is passed; a late return is discarded as nothing after the
; fact. Metal carriers can enforce the deadline at submit/fence boundaries. dtrs-run-observed is the
; pure, four-way witness door for receipts from such a carrier. This cell does not call a rented model,
; manufacture a vitality score, or claim that post-hoc rejection is preemption.
;
; preludes: form-stdlib/core.fk

(do
    ; ---- measured DS4 starting envelope ---------------------------------
    (defn dtrs-dsv4-model-id () "superdeepseek-v4-flash")
    (defn dtrs-dsv4-timeout-ms () 34)
    (defn dtrs-dsv4-bandwidth-bytes-per-ms () 471000000)
    (defn dtrs-dsv4-default-bytes () 9103000000)

    ; ---- one absolute window shared by default + one recipe -------------
    (defn dtrs-window (started timeout-ms bandwidth-bytes-per-ms default-bytes)
        (list "dsv4-token-swap-window" started timeout-ms bandwidth-bytes-per-ms default-bytes))
    (defn dtrs-window? (w)
        (if (eq (len w) 5) (str_eq (nth w 0) "dsv4-token-swap-window") false))
    (defn dtrs-window-start (w) (nth w 1))
    (defn dtrs-window-timeout (w) (nth w 2))
    (defn dtrs-window-bandwidth (w) (nth w 3))
    (defn dtrs-window-default-bytes (w) (nth w 4))
    (defn dtrs-window-deadline (w) (add (dtrs-window-start w) (dtrs-window-timeout w)))
    (defn dtrs-window-byte-cap (w) (mul (dtrs-window-timeout w) (dtrs-window-bandwidth w)))
    (defn dtrs-window-recipe-room (w)
        (sub (dtrs-window-byte-cap w) (dtrs-window-default-bytes w)))
    (defn dtrs-dsv4-window (started)
        (dtrs-window started
            (dtrs-dsv4-timeout-ms)
            (dtrs-dsv4-bandwidth-bytes-per-ms)
            (dtrs-dsv4-default-bytes)))
    (defn dtrs-window-valid? (w)
        (if (dtrs-window? w)
            (and (gt (dtrs-window-timeout w) 0)
            (and (gt (dtrs-window-bandwidth w) 0)
            (and (ge (dtrs-window-default-bytes w) 0)
                 (ge (dtrs-window-byte-cap w) (dtrs-window-default-bytes w)))))
            false))

    ; ---- recipe acknowledgement and witnessed vitality ------------------
    (defn dtrs-ack-valid? (ack)
        (if (str_eq ack "nothing") 1
            (if (str_eq ack "0") 1
                (if (str_eq ack "1") 1
                    (if (str_eq ack "node") 1 0)))))
    (defn dtrs-token-ack? (ack)
        (if (or (str_eq ack "1") (str_eq ack "node")) 1 0))
    (defn dtrs-score-valid? (score) (if (and (ge score 0) (le score 100)) 1 0))
    (defn dtrs-min-score (xs best)
        (if (eq (len xs) 0) best
            (dtrs-min-score (tail xs) (if (lt (head xs) best) (head xs) best))))
    ; Vitality is a floor across quality/trust/resonance/sovereignty/energy/freshness.
    ; One broken axis cannot be averaged away by five flattering ones.
    (defn dtrs-vitality (quality trust resonance sovereignty energy freshness)
        (dtrs-min-score (list trust resonance sovereignty energy freshness) quality))

    (defn dtrs-offer (ack token bytes vitality witness)
        (list "dsv4-token-recipe-offer" ack token bytes vitality witness))
    (defn dtrs-offer? (o)
        (if (eq (len o) 6) (str_eq (nth o 0) "dsv4-token-recipe-offer") false))
    (defn dtrs-offer-ack (o) (nth o 1))
    (defn dtrs-offer-token (o) (nth o 2))
    (defn dtrs-offer-bytes (o) (nth o 3))
    (defn dtrs-offer-vitality (o) (nth o 4))
    (defn dtrs-offer-witness (o) (nth o 5))
    (defn dtrs-offer-valid? (o)
        (if (dtrs-offer? o)
            (and (eq (dtrs-ack-valid? (dtrs-offer-ack o)) 1)
            (and (ge (dtrs-offer-token o) 0)
            (and (ge (dtrs-offer-bytes o) 0)
            (and (eq (dtrs-score-valid? (dtrs-offer-vitality o)) 1)
                 (gt (str_len (dtrs-offer-witness o)) 0)))))
            false))

    ; ---- a recipe result crossing the axiom-4 boundary ------------------
    (defn dtrs-candidate (recipe-id offer started finished offered trusted observed reversible)
        (list "dsv4-token-recipe-candidate" recipe-id offer started finished
              offered trusted observed reversible))
    (defn dtrs-candidate? (c)
        (if (eq (len c) 9) (str_eq (nth c 0) "dsv4-token-recipe-candidate") false))
    (defn dtrs-candidate-recipe (c) (nth c 1))
    (defn dtrs-candidate-offer (c) (nth c 2))
    (defn dtrs-candidate-start (c) (nth c 3))
    (defn dtrs-candidate-finish (c) (nth c 4))
    (defn dtrs-candidate-offered (c) (nth c 5))
    (defn dtrs-candidate-trusted (c) (nth c 6))
    (defn dtrs-candidate-observed (c) (nth c 7))
    (defn dtrs-candidate-reversible (c) (nth c 8))
    (defn dtrs-candidate-token (c) (dtrs-offer-token (dtrs-candidate-offer c)))
    (defn dtrs-candidate-vitality (c) (dtrs-offer-vitality (dtrs-candidate-offer c)))
    (defn dtrs-candidate-bytes (c) (dtrs-offer-bytes (dtrs-candidate-offer c)))
    (defn dtrs-candidate-boundary-ok? (c)
        (if (and (eq (dtrs-candidate-offered c) 1)
            (and (eq (dtrs-candidate-trusted c) 1)
            (and (eq (dtrs-candidate-observed c) 1)
                 (eq (dtrs-candidate-reversible c) 1)))) 1 0))
    (defn dtrs-candidate-in-window? (w c)
        (if (and (ge (dtrs-candidate-start c) (dtrs-window-start w))
                 (le (dtrs-candidate-finish c) (dtrs-window-deadline w))) 1 0))
    (defn dtrs-candidate-within-bandwidth? (w c)
        (if (le (add (dtrs-window-default-bytes w) (dtrs-candidate-bytes c))
                (dtrs-window-byte-cap w)) 1 0))

    ; State is ordered so a silence remains silence even if its placeholder fields are otherwise poor.
    (defn dtrs-candidate-state (w c)
        (if (not (dtrs-window-valid? w)) "invalid-window"
        (if (not (dtrs-candidate? c)) "invalid-cell"
        (if (eq (str_len (dtrs-candidate-recipe c)) 0) "invalid-recipe"
        (if (not (dtrs-offer? (dtrs-candidate-offer c))) "invalid-offer"
        (if (eq (dtrs-ack-valid? (dtrs-offer-ack (dtrs-candidate-offer c))) 0) "invalid-ack"
        (if (or (str_eq (dtrs-offer-ack (dtrs-candidate-offer c)) "nothing")
                (str_eq (dtrs-offer-ack (dtrs-candidate-offer c)) "0")) "ack-nothing"
        (if (not (dtrs-offer-valid? (dtrs-candidate-offer c))) "invalid-offer"
        (if (eq (dtrs-candidate-boundary-ok? c) 0) "boundary-hold"
        (if (eq (dtrs-candidate-in-window? w c) 0) "timeout-nothing"
        (if (eq (dtrs-candidate-within-bandwidth? w c) 0) "bandwidth-nothing"
            "admissible")))))))))))
    (defn dtrs-candidate-admissible? (w c)
        (if (str_eq (dtrs-candidate-state w c) "admissible") 1 0))

    ; ---- execute any Form recipe function --------------------------------
    ; recipef receives (context default-token absolute-deadline) and returns dtrs-offer.
    (defn dtrs-run-observed
        (recipef context recipe-id w default-token started finished offered trusted observed reversible)
        (dtrs-candidate recipe-id
            (recipef context default-token (dtrs-window-deadline w))
            started finished offered trusted observed reversible))
    (defn dtrs-run-live
        (recipef context recipe-id w default-token offered trusted observed reversible)
        (do
            (let started (now_unix_ms))
            (let offer (recipef context default-token (dtrs-window-deadline w)))
            (let finished (now_unix_ms))
            (dtrs-candidate recipe-id offer started finished offered trusted observed reversible)))

    ; ---- default, selection, and fallback --------------------------------
    (defn dtrs-default-candidate (w baseline token vitality witness)
        (dtrs-candidate
            (dtrs-baseline-recipe baseline)
            (dtrs-offer "1" token (dtrs-window-default-bytes w) vitality witness)
            (dtrs-window-start w) (dtrs-window-deadline w) 1 1 1 1))
    (defn dtrs-choice (candidate alternative-state reason)
        (list "dsv4-token-swap-choice" candidate alternative-state reason))
    (defn dtrs-choice? (c)
        (if (eq (len c) 4) (str_eq (nth c 0) "dsv4-token-swap-choice") false))
    (defn dtrs-choice-candidate (c) (nth c 1))
    (defn dtrs-choice-alternative-state (c) (nth c 2))
    (defn dtrs-choice-reason (c) (nth c 3))
    (defn dtrs-choice-token (c) (dtrs-candidate-token (dtrs-choice-candidate c)))
    (defn dtrs-choice-recipe (c) (dtrs-candidate-recipe (dtrs-choice-candidate c)))

    (defn dtrs-select (w default alternative)
        (do
            (let state (dtrs-candidate-state w alternative))
            (if (and (str_eq state "admissible")
                     (gt (dtrs-candidate-vitality alternative) (dtrs-candidate-vitality default)))
                (dtrs-choice alternative state "recipe-more-vital")
                (dtrs-choice default state
                    (if (str_eq state "admissible") "default-more-vital-or-tie" state)))))

    (defn dtrs-best-candidate (w current alternatives)
        (if (eq (len alternatives) 0) current
            (do
                (let c (head alternatives))
                (let next (if (and (eq (dtrs-candidate-admissible? w c) 1)
                                    (gt (dtrs-candidate-vitality c) (dtrs-candidate-vitality current)))
                                c current))
                (dtrs-best-candidate w next (tail alternatives)))))
    (defn dtrs-candidate-bytes-total (alternatives)
        (if (eq (len alternatives) 0) 0
            (add (dtrs-candidate-bytes (head alternatives))
                 (dtrs-candidate-bytes-total (tail alternatives)))))
    (defn dtrs-select-any (w default alternatives)
        (if (gt (dtrs-candidate-bytes-total alternatives) (dtrs-window-recipe-room w))
            (dtrs-choice default "alternatives-over-bandwidth" "bandwidth-nothing")
        (do
            (let best (dtrs-best-candidate w default alternatives))
            (if (gt (dtrs-candidate-vitality best) (dtrs-candidate-vitality default))
                (dtrs-choice best "admissible" "recipe-more-vital")
                (dtrs-choice default "no-more-vital-alternative" "default-more-vital-or-tie")))))

    ; ---- learning and reversible baseline installation ------------------
    (defn dtrs-trial
        (baseline-recipe challenger-recipe baseline-vitality challenger-vitality admissible meaning-ok witness)
        (list "dsv4-token-swap-trial" baseline-recipe challenger-recipe baseline-vitality
              challenger-vitality admissible meaning-ok witness))
    (defn dtrs-trial? (t)
        (if (eq (len t) 8) (str_eq (nth t 0) "dsv4-token-swap-trial") false))
    (defn dtrs-trial-baseline-recipe (t) (nth t 1))
    (defn dtrs-trial-challenger-recipe (t) (nth t 2))
    (defn dtrs-trial-baseline-vitality (t) (nth t 3))
    (defn dtrs-trial-challenger-vitality (t) (nth t 4))
    (defn dtrs-trial-admissible (t) (nth t 5))
    (defn dtrs-trial-meaning-ok (t) (nth t 6))
    (defn dtrs-trial-witness (t) (nth t 7))
    (defn dtrs-trial-safe? (t)
        (if (dtrs-trial? t)
            (and (eq (dtrs-score-valid? (dtrs-trial-baseline-vitality t)) 1)
            (and (eq (dtrs-score-valid? (dtrs-trial-challenger-vitality t)) 1)
            (and (eq (dtrs-trial-admissible t) 1)
            (and (eq (dtrs-trial-meaning-ok t) 1)
                 (gt (str_len (dtrs-trial-witness t)) 0)))))
            false))
    (defn dtrs-trials-safe? (ts)
        (if (eq (len ts) 0) 1
            (if (dtrs-trial-safe? (head ts)) (dtrs-trials-safe? (tail ts)) 0)))
    (defn dtrs-trials-one-challenger? (ts recipe-id)
        (if (eq (len ts) 0) 1
            (if (str_eq (dtrs-trial-challenger-recipe (head ts)) recipe-id)
                (dtrs-trials-one-challenger? (tail ts) recipe-id) 0)))
    (defn dtrs-trials-one-baseline? (ts recipe-id)
        (if (eq (len ts) 0) 1
            (if (str_eq (dtrs-trial-baseline-recipe (head ts)) recipe-id)
                (dtrs-trials-one-baseline? (tail ts) recipe-id) 0)))
    (defn dtrs-baseline-vitality-total (ts)
        (if (eq (len ts) 0) 0
            (add (dtrs-trial-baseline-vitality (head ts)) (dtrs-baseline-vitality-total (tail ts)))))
    (defn dtrs-challenger-vitality-total (ts)
        (if (eq (len ts) 0) 0
            (add (dtrs-trial-challenger-vitality (head ts)) (dtrs-challenger-vitality-total (tail ts)))))
    (defn dtrs-challenger-wins (ts)
        (if (eq (len ts) 0) 0
            (add (if (gt (dtrs-trial-challenger-vitality (head ts))
                         (dtrs-trial-baseline-vitality (head ts))) 1 0)
                 (dtrs-challenger-wins (tail ts)))))
    (defn dtrs-promote? (ts min-samples)
        (if (and (gt (len ts) 0) (ge (len ts) min-samples))
            (and (eq (dtrs-trials-safe? ts) 1)
            (and (eq (dtrs-trials-one-challenger? ts (dtrs-trial-challenger-recipe (head ts))) 1)
            (and (gt (dtrs-challenger-wins ts) (div (len ts) 2))
                 (gt (dtrs-challenger-vitality-total ts) (dtrs-baseline-vitality-total ts)))))
            false))

    (defn dtrs-baseline (recipe-id vitality generation parent witness-count status)
        (list "dsv4-token-swap-baseline" recipe-id vitality generation parent witness-count status))
    (defn dtrs-baseline? (b)
        (if (eq (len b) 7) (str_eq (nth b 0) "dsv4-token-swap-baseline") false))
    (defn dtrs-baseline-recipe (b) (nth b 1))
    (defn dtrs-baseline-vitality (b) (nth b 2))
    (defn dtrs-baseline-generation (b) (nth b 3))
    (defn dtrs-baseline-parent (b) (nth b 4))
    (defn dtrs-baseline-witness-count (b) (nth b 5))
    (defn dtrs-baseline-status (b) (nth b 6))
    (defn dtrs-initial-baseline (vitality)
        (dtrs-baseline (dtrs-dsv4-model-id) vitality 0 (list) 0 "installed-default"))
    ; Returning a new cell is the installation offer. The caller may repoint its baseline name to it;
    ; the old cell remains reachable through parent and can be restored without reconstruction.
    (defn dtrs-install (baseline trials min-samples)
        (if (and (dtrs-promote? trials min-samples)
                 (eq (dtrs-trials-one-baseline? trials (dtrs-baseline-recipe baseline)) 1))
            (dtrs-baseline
                (dtrs-trial-challenger-recipe (head trials))
                (div (dtrs-challenger-vitality-total trials) (len trials))
                (add (dtrs-baseline-generation baseline) 1)
                baseline
                (len trials)
                "installed-more-vital")
            baseline))

    0)
