// dsv4-token-recipe-swap.fk — a bounded Form-native alternative to one DS4 argmax token.
//
// The DeepSeek-V4-Flash lane already produces a default token. This cell gives that token one
// inspectable alternative: any Form recipe may run inside the SAME absolute deadline and the SAME
// Metal-bandwidth envelope, return a candidate token, and replace the default only when its witnessed
// vitality is strictly higher. A missing, declined, late, over-bandwidth, unwitnessed, or tied result
// acknowledges nothing and the default token stays. The default is never silently lost.
//
// The concrete DS4 envelope is grounded in the receipts "the bus and the two arms" (2026-07-31) and
// "the model is useful" (2026-08-01), kept in git history:
//   34 ms/token observed generation floor; 471 GB/s measured resident-memory bus;
//   9.103 GB of model weight bytes touched per default token.
// At those measurements the shared window can carry 16.014 GB, leaving 6.911 GB for one alternative
// while the default remains available. Callers may supply a newly measured envelope; these numbers are
// a named baseline, not universal hardware constants.
//
// The five core axioms are limits, not decorative scores:
//   axiom 1 — timeout is the explicit "nothing" state, never a failed or zero token;
//   axiom 2 — window, offer, candidate, choice, trial, and baseline are tagged cells;
//   axiom 3 — installation returns a NEW baseline carrying the old baseline as its parent;
//   axiom 4 — only an offered, trusted, observed boundary result may cross;
//   axiom 5 — every recipe offer acknowledges with exactly nothing, 0, 1, or node.
//
// Honest execution seam: dtrs-run-live invokes a Form function value and measures it with the native
// clock. The current evaluator cannot preempt an arbitrary in-process recipe. A recipe must therefore
// cooperate with the absolute deadline it is passed; a late return is discarded as nothing after the
// fact. Metal carriers can enforce the deadline at submit/fence boundaries. dtrs-run-observed is the
// pure, four-way witness door for receipts from such a carrier. This cell does not call a rented model,
// manufacture a vitality score, or claim that post-hoc rejection is preemption.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    // ---- measured DS4 starting envelope ---------------------------------
    def dtrs-dsv4-model-id() = "superdeepseek-v4-flash";
    def dtrs-dsv4-timeout-ms() = 34;
    def dtrs-dsv4-bandwidth-bytes-per-ms() = 471000000;
    def dtrs-dsv4-default-bytes() = 9103000000;
    // ---- one absolute window shared by default + one recipe -------------
    def dtrs-window(started, timeout-ms, bandwidth-bytes-per-ms, default-bytes) = ["dsv4-token-swap-window", started, timeout-ms, bandwidth-bytes-per-ms, default-bytes];
    def dtrs-window?(w) = (Comparable) len(w) == 5 ? (String) w[0] == "dsv4-token-swap-window" : false;
    def dtrs-window-start(w) = w[1];
    def dtrs-window-timeout(w) = w[2];
    def dtrs-window-bandwidth(w) = w[3];
    def dtrs-window-default-bytes(w) = w[4];
    def dtrs-window-deadline(w) = dtrs-window-start(w) + dtrs-window-timeout(w);
    def dtrs-window-byte-cap(w) = dtrs-window-timeout(w) * dtrs-window-bandwidth(w);
    def dtrs-window-recipe-room(w) = dtrs-window-byte-cap(w) - dtrs-window-default-bytes(w);
    def dtrs-dsv4-window(started) = dtrs-window(started, dtrs-dsv4-timeout-ms(), dtrs-dsv4-bandwidth-bytes-per-ms(), dtrs-dsv4-default-bytes());
    def dtrs-window-valid?(w) = dtrs-window?(w) ? dtrs-window-timeout(w) > 0 && (dtrs-window-bandwidth(w) > 0 && (dtrs-window-default-bytes(w) >= 0 && dtrs-window-byte-cap(w) >= dtrs-window-default-bytes(w))) : false;
    // ---- recipe acknowledgement and witnessed vitality ------------------
    def dtrs-ack-valid?(ack) = (String) ack == "nothing" ? 1 : (String) ack == "0" ? 1 : (String) ack == "1" ? 1 : (String) ack == "node" ? 1 : 0;
    def dtrs-token-ack?(ack) = (String) ack == "1" || (String) ack == "node" ? 1 : 0;
    def dtrs-score-valid?(score) = score >= 0 && score <= 100 ? 1 : 0;
    def dtrs-min-score(xs, best) = (Comparable) len(xs) == 0 ? best : dtrs-min-score(tail(xs), head(xs) < best ? head(xs) : best);
    // Vitality is a floor across quality/trust/resonance/sovereignty/energy/freshness.
    // One broken axis cannot be averaged away by five flattering ones.
    def dtrs-vitality(quality, trust, resonance, sovereignty, energy, freshness) = dtrs-min-score([trust, resonance, sovereignty, energy, freshness], quality);
    def dtrs-offer(ack, token, bytes, vitality, witness) = ["dsv4-token-recipe-offer", ack, token, bytes, vitality, witness];
    def dtrs-offer?(o) = (Comparable) len(o) == 6 ? (String) o[0] == "dsv4-token-recipe-offer" : false;
    def dtrs-offer-ack(o) = o[1];
    def dtrs-offer-token(o) = o[2];
    def dtrs-offer-bytes(o) = o[3];
    def dtrs-offer-vitality(o) = o[4];
    def dtrs-offer-witness(o) = o[5];
    def dtrs-offer-valid?(o) = dtrs-offer?(o) ? (Comparable) dtrs-ack-valid?(dtrs-offer-ack(o)) == 1 && (dtrs-offer-token(o) >= 0 && (dtrs-offer-bytes(o) >= 0 && ((Comparable) dtrs-score-valid?(dtrs-offer-vitality(o)) == 1 && str_len(dtrs-offer-witness(o)) > 0))) : false;
    // ---- a recipe result crossing the axiom-4 boundary ------------------
    def dtrs-candidate(recipe-id, offer, started, finished, offered, trusted, observed, reversible) = ["dsv4-token-recipe-candidate", recipe-id, offer, started, finished, offered, trusted, observed, reversible];
    def dtrs-candidate?(c) = (Comparable) len(c) == 9 ? (String) c[0] == "dsv4-token-recipe-candidate" : false;
    def dtrs-candidate-recipe(c) = c[1];
    def dtrs-candidate-offer(c) = c[2];
    def dtrs-candidate-start(c) = c[3];
    def dtrs-candidate-finish(c) = c[4];
    def dtrs-candidate-offered(c) = c[5];
    def dtrs-candidate-trusted(c) = c[6];
    def dtrs-candidate-observed(c) = c[7];
    def dtrs-candidate-reversible(c) = c[8];
    def dtrs-candidate-token(c) = dtrs-offer-token(dtrs-candidate-offer(c));
    def dtrs-candidate-vitality(c) = dtrs-offer-vitality(dtrs-candidate-offer(c));
    def dtrs-candidate-bytes(c) = dtrs-offer-bytes(dtrs-candidate-offer(c));
    def dtrs-candidate-boundary-ok?(c) = (Comparable) dtrs-candidate-offered(c) == 1 && ((Comparable) dtrs-candidate-trusted(c) == 1 && ((Comparable) dtrs-candidate-observed(c) == 1 && (Comparable) dtrs-candidate-reversible(c) == 1)) ? 1 : 0;
    def dtrs-candidate-in-window?(w, c) = dtrs-candidate-start(c) >= dtrs-window-start(w) && dtrs-candidate-finish(c) <= dtrs-window-deadline(w) ? 1 : 0;
    def dtrs-candidate-within-bandwidth?(w, c) = dtrs-window-default-bytes(w) + dtrs-candidate-bytes(c) <= dtrs-window-byte-cap(w) ? 1 : 0;
    // State is ordered so a silence remains silence even if its placeholder fields are otherwise poor.
    def dtrs-candidate-state(w, c) = !dtrs-window-valid?(w) ? "invalid-window" : !dtrs-candidate?(c) ? "invalid-cell" : (Comparable) str_len(dtrs-candidate-recipe(c)) == 0 ? "invalid-recipe" : !dtrs-offer?(dtrs-candidate-offer(c)) ? "invalid-offer" : (Comparable) dtrs-ack-valid?(dtrs-offer-ack(dtrs-candidate-offer(c))) == 0 ? "invalid-ack" : (String) dtrs-offer-ack(dtrs-candidate-offer(c)) == "nothing" || (String) dtrs-offer-ack(dtrs-candidate-offer(c)) == "0" ? "ack-nothing" : !dtrs-offer-valid?(dtrs-candidate-offer(c)) ? "invalid-offer" : (Comparable) dtrs-candidate-boundary-ok?(c) == 0 ? "boundary-hold" : (Comparable) dtrs-candidate-in-window?(w, c) == 0 ? "timeout-nothing" : (Comparable) dtrs-candidate-within-bandwidth?(w, c) == 0 ? "bandwidth-nothing" : "admissible";
    def dtrs-candidate-admissible?(w, c) = (String) dtrs-candidate-state(w, c) == "admissible" ? 1 : 0;
    // ---- execute any Form recipe function --------------------------------
    // recipef receives (context default-token absolute-deadline) and returns dtrs-offer.
    def dtrs-run-observed(recipef, context, recipe-id, w, default-token, started, finished, offered, trusted, observed, reversible) = dtrs-candidate(recipe-id, recipef(context, default-token, dtrs-window-deadline(w)), started, finished, offered, trusted, observed, reversible);
    def dtrs-run-live(recipef, context, recipe-id, w, default-token, offered, trusted, observed, reversible) = {
        let started = now_unix_ms();
        let offer = recipef(context, default-token, dtrs-window-deadline(w));
        let finished = now_unix_ms();
        dtrs-candidate(recipe-id, offer, started, finished, offered, trusted, observed, reversible);
    };
    // ---- default, selection, and fallback --------------------------------
    def dtrs-default-candidate(w, baseline, token, vitality, witness) = dtrs-candidate(dtrs-baseline-recipe(baseline), dtrs-offer("1", token, dtrs-window-default-bytes(w), vitality, witness), dtrs-window-start(w), dtrs-window-deadline(w), 1, 1, 1, 1);
    def dtrs-choice(candidate, alternative-state, reason) = ["dsv4-token-swap-choice", candidate, alternative-state, reason];
    def dtrs-choice?(c) = (Comparable) len(c) == 4 ? (String) c[0] == "dsv4-token-swap-choice" : false;
    def dtrs-choice-candidate(c) = c[1];
    def dtrs-choice-alternative-state(c) = c[2];
    def dtrs-choice-reason(c) = c[3];
    def dtrs-choice-token(c) = dtrs-candidate-token(dtrs-choice-candidate(c));
    def dtrs-choice-recipe(c) = dtrs-candidate-recipe(dtrs-choice-candidate(c));
    def dtrs-select(w, default, alternative) = {
        let state = dtrs-candidate-state(w, alternative);
        (String) state == "admissible" && dtrs-candidate-vitality(alternative) > dtrs-candidate-vitality(default) ? dtrs-choice(alternative, state, "recipe-more-vital") : dtrs-choice(default, state, (String) state == "admissible" ? "default-more-vital-or-tie" : state);
    };
    def dtrs-best-candidate(w, current, alternatives) = (Comparable) len(alternatives) == 0 ? current : {
        let c = head(alternatives);
        let next = (Comparable) dtrs-candidate-admissible?(w, c) == 1 && dtrs-candidate-vitality(c) > dtrs-candidate-vitality(current) ? c : current;
        dtrs-best-candidate(w, next, tail(alternatives));
    };
    def dtrs-candidate-bytes-total(alternatives) = (Comparable) len(alternatives) == 0 ? 0 : dtrs-candidate-bytes(head(alternatives)) + dtrs-candidate-bytes-total(tail(alternatives));
    def dtrs-select-any(w, default, alternatives) = dtrs-candidate-bytes-total(alternatives) > dtrs-window-recipe-room(w) ? dtrs-choice(default, "alternatives-over-bandwidth", "bandwidth-nothing") : {
        let best = dtrs-best-candidate(w, default, alternatives);
        dtrs-candidate-vitality(best) > dtrs-candidate-vitality(default) ? dtrs-choice(best, "admissible", "recipe-more-vital") : dtrs-choice(default, "no-more-vital-alternative", "default-more-vital-or-tie");
    };
    // ---- learning and reversible baseline installation ------------------
    def dtrs-trial(baseline-recipe, challenger-recipe, baseline-vitality, challenger-vitality, admissible, meaning-ok, witness) = ["dsv4-token-swap-trial", baseline-recipe, challenger-recipe, baseline-vitality, challenger-vitality, admissible, meaning-ok, witness];
    def dtrs-trial?(t) = (Comparable) len(t) == 8 ? (String) t[0] == "dsv4-token-swap-trial" : false;
    def dtrs-trial-baseline-recipe(t) = t[1];
    def dtrs-trial-challenger-recipe(t) = t[2];
    def dtrs-trial-baseline-vitality(t) = t[3];
    def dtrs-trial-challenger-vitality(t) = t[4];
    def dtrs-trial-admissible(t) = t[5];
    def dtrs-trial-meaning-ok(t) = t[6];
    def dtrs-trial-witness(t) = t[7];
    def dtrs-trial-safe?(t) = dtrs-trial?(t) ? (Comparable) dtrs-score-valid?(dtrs-trial-baseline-vitality(t)) == 1 && ((Comparable) dtrs-score-valid?(dtrs-trial-challenger-vitality(t)) == 1 && ((Comparable) dtrs-trial-admissible(t) == 1 && ((Comparable) dtrs-trial-meaning-ok(t) == 1 && str_len(dtrs-trial-witness(t)) > 0))) : false;
    def dtrs-trials-safe?(ts) = (Comparable) len(ts) == 0 ? 1 : dtrs-trial-safe?(head(ts)) ? dtrs-trials-safe?(tail(ts)) : 0;
    def dtrs-trials-one-challenger?(ts, recipe-id) = (Comparable) len(ts) == 0 ? 1 : (String) dtrs-trial-challenger-recipe(head(ts)) == recipe-id ? dtrs-trials-one-challenger?(tail(ts), recipe-id) : 0;
    def dtrs-trials-one-baseline?(ts, recipe-id) = (Comparable) len(ts) == 0 ? 1 : (String) dtrs-trial-baseline-recipe(head(ts)) == recipe-id ? dtrs-trials-one-baseline?(tail(ts), recipe-id) : 0;
    def dtrs-baseline-vitality-total(ts) = (Comparable) len(ts) == 0 ? 0 : dtrs-trial-baseline-vitality(head(ts)) + dtrs-baseline-vitality-total(tail(ts));
    def dtrs-challenger-vitality-total(ts) = (Comparable) len(ts) == 0 ? 0 : dtrs-trial-challenger-vitality(head(ts)) + dtrs-challenger-vitality-total(tail(ts));
    def dtrs-challenger-wins(ts) = (Comparable) len(ts) == 0 ? 0 : (dtrs-trial-challenger-vitality(head(ts)) > dtrs-trial-baseline-vitality(head(ts)) ? 1 : 0) + dtrs-challenger-wins(tail(ts));
    def dtrs-promote?(ts, min-samples) = len(ts) > 0 && len(ts) >= min-samples ? (Comparable) dtrs-trials-safe?(ts) == 1 && ((Comparable) dtrs-trials-one-challenger?(ts, dtrs-trial-challenger-recipe(head(ts))) == 1 && (dtrs-challenger-wins(ts) > len(ts) / 2 && dtrs-challenger-vitality-total(ts) > dtrs-baseline-vitality-total(ts))) : false;
    def dtrs-baseline(recipe-id, vitality, generation, parent, witness-count, status) = ["dsv4-token-swap-baseline", recipe-id, vitality, generation, parent, witness-count, status];
    def dtrs-baseline?(b) = (Comparable) len(b) == 7 ? (String) b[0] == "dsv4-token-swap-baseline" : false;
    def dtrs-baseline-recipe(b) = b[1];
    def dtrs-baseline-vitality(b) = b[2];
    def dtrs-baseline-generation(b) = b[3];
    def dtrs-baseline-parent(b) = b[4];
    def dtrs-baseline-witness-count(b) = b[5];
    def dtrs-baseline-status(b) = b[6];
    def dtrs-initial-baseline(vitality) = dtrs-baseline(dtrs-dsv4-model-id(), vitality, 0, [], 0, "installed-default");
    // Returning a new cell is the installation offer. The caller may repoint its baseline name to it;
    // the old cell remains reachable through parent and can be restored without reconstruction.
    def dtrs-install(baseline, trials, min-samples) = dtrs-promote?(trials, min-samples) && (Comparable) dtrs-trials-one-baseline?(trials, dtrs-baseline-recipe(baseline)) == 1 ? dtrs-baseline(dtrs-trial-challenger-recipe(head(trials)), dtrs-challenger-vitality-total(trials) / len(trials), dtrs-baseline-generation(baseline) + 1, baseline, len(trials), "installed-more-vital") : baseline;
    0;
}
