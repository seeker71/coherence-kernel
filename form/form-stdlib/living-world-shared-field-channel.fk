; living-world-shared-field-channel.fk -- one live, ontology-open offer/ack
; membrane for session outcomes, tending responses, and native questions.
;
; The channel has no task verbs, action taxonomy, answer set, label vocabulary,
; or remote route.  Its one offered action is itself a cell.  Every input is
; either a consented session entry or an ordinary living-world entry whose
; offered interface admits that exact action.  Unknown input shapes and action
; mismatches leave only a content-blind refusal event.
;
; After every admitted entry, the channel re-observes transition and learned-
; symbol recurrence.  It records waiting, dissent, and explicit silence, and
; integrates only a current proposal whose complete participant field has
; independently acknowledged ONE.  The same offered action used at every
; input boundary is used for integration; the channel invents no new power.
;
; A question is an ordinary attributed payload.  Its answer is reconstructed
; from the current session transition field, current learned symbol cells, and
; an exact trace.  Zero surfaces remains explicitly unvoiced, several remain
; plural, and alternatives and unknowns pass through unchanged.
;
; witnessed: 2026-08-09 -> 2147483647 on fkwu
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk

(let LWSF-SESSION    (bp "LWSF-SESSION"))
(let LWSF-QUESTION   (bp "LWSF-QUESTION"))
(let LWSF-ANSWER     (bp "LWSF-ANSWER"))
(let LWSF-SETTLEMENT (bp "LWSF-SETTLEMENT"))
(let LWSF-STATE      (bp "LWSF-STATE"))
(let LWSF-STEP       (bp "LWSF-STEP"))

; A session entry carries the exact existing offer and consent cells.  `now`
; is an observation used only by the consent expiry contract.
(defn lwsf-session (offer consent action now)
    (intern_node LWSF-SESSION
        (list offer consent action (intern_trivial_int now)
              (lwo-local-path))))
(defn lwsf-session? (cell)
    (if (and (eq (lwo-category? cell LWSF-SESSION) 1)
             (eq (len (node_children cell)) 5)) 1 0))
(defn lwsf-session-offer (entry) (nth (node_children entry) 0))
(defn lwsf-session-consent (entry) (nth (node_children entry) 1))
(defn lwsf-session-action (entry) (nth (node_children entry) 2))
(defn lwsf-session-now (entry)
    (node_value (nth (node_children entry) 3)))

; Questions contain only an exact session context.  They cross through an
; ordinary LWT entry, so source, provenance, interface, consent, and receipt
; remain the living-world membrane's concern rather than fields on a question.
(defn lwsf-question (context)
    (intern_node LWSF-QUESTION (list context (lwo-local-path))))
(defn lwsf-question? (cell)
    (if (and (eq (lwo-category? cell LWSF-QUESTION) 1)
             (and (eq (len (node_children cell)) 2)
                  (eq (lwsn-context-valid?
                        (nth (node_children cell) 0)) 1))) 1 0))
(defn lwsf-question-context (question) (nth (node_children question) 0))

; State forms a content-addressed lineage.  It carries no mutable slot and no
; global authority: world, recurrence threshold, one exact channel action,
; and the optional preceding state are its complete present composition.
(defn lwsf-state (world threshold action previous)
    (intern_node LWSF-STATE
        (list world (intern_trivial_int threshold) action previous
              (lwo-local-path))))
(defn lwsf-state? (cell) (lwo-category? cell LWSF-STATE))
(defn lwsf-state-world (state) (nth (node_children state) 0))
(defn lwsf-state-threshold (state)
    (node_value (nth (node_children state) 1)))
(defn lwsf-state-action (state) (nth (node_children state) 2))
(defn lwsf-state-previous (state) (nth (node_children state) 3))
(defn lwsf-open (threshold action)
    (if (lt threshold 1) (lwo-none)
        (lwsf-state (lwo-empty-world) threshold action (lwo-none))))

(defn lwsf-world-entry? (cell)
    (if (and (eq (lwo-category? cell LWT-ENTRY) 1)
             (eq (len (node_children cell)) 2)) 1 0))

(defn lwsf-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwsf-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwsf-field-union (left right)
    (lwsf-field-union-items (lwo-field-items left) right))

; Result of re-observing the field after one input.  Proposals and outcomes
; retain waiting and dissent as first-class evidence.  `integrated` contains
; only candidates that became current during this settlement movement.
(defn lwsf-settlement (world proposals outcomes integrated)
    (intern_node LWSF-SETTLEMENT
        (list world proposals outcomes integrated (lwo-local-path))))
(defn lwsf-settlement? (cell)
    (lwo-category? cell LWSF-SETTLEMENT))
(defn lwsf-settlement-world (settlement)
    (nth (node_children settlement) 0))
(defn lwsf-settlement-proposals (settlement)
    (nth (node_children settlement) 1))
(defn lwsf-settlement-outcomes (settlement)
    (nth (node_children settlement) 2))
(defn lwsf-settlement-integrated (settlement)
    (nth (node_children settlement) 3))

(defn lwsf-settle-transition-items
    (world items action outcomes integrated)
    (if (eq (len items) 0) (list world outcomes integrated)
        (do
            (let proposal (head items))
            (let outcome (lwt-evaluate-proposal world proposal))
            (let candidate (lwt-proposal-candidate proposal))
            (let should-integrate
                (if (and (node_eq (lwt-outcome-status outcome)
                                  (lwt-status-acknowledged))
                         (eq (lwtf-integrated-current?
                                world candidate) 0)) 1 0))
            (let next-world
                (if (eq should-integrate 0) world
                    (lwt-round-world
                        (lwtf-integrate
                            (lwt-round world
                                (lwo-field (list proposal))
                                (lwo-empty-field) (lwo-none))
                            proposal action))))
            (let became-current
                (if (and (eq should-integrate 1)
                         (eq (lwtf-integrated-current?
                                next-world candidate) 1)) 1 0))
            (lwsf-settle-transition-items next-world (tail items) action
                (lwo-field-add outcomes outcome)
                (if (eq became-current 1)
                    (lwo-field-add integrated candidate) integrated)))))

(defn lwsf-settle-symbol-items
    (world items action outcomes integrated)
    (if (eq (len items) 0) (list world outcomes integrated)
        (do
            (let proposal (head items))
            (let outcome (lwt-evaluate-proposal world proposal))
            (let candidate (lwt-proposal-candidate proposal))
            (let should-integrate
                (if (and (node_eq (lwt-outcome-status outcome)
                                  (lwt-status-acknowledged))
                         (eq (lwsl-integrated-current?
                                world candidate) 0)) 1 0))
            (let next-world
                (if (eq should-integrate 0) world
                    (lwt-round-world
                        (lwsl-integrate
                            (lwt-round world
                                (lwo-field (list proposal))
                                (lwo-empty-field) (lwo-none))
                            proposal action))))
            (let became-current
                (if (and (eq should-integrate 1)
                         (eq (lwsl-integrated-current?
                                next-world candidate) 1)) 1 0))
            (lwsf-settle-symbol-items next-world (tail items) action
                (lwo-field-add outcomes outcome)
                (if (eq became-current 1)
                    (lwo-field-add integrated candidate) integrated)))))

(defn lwsf-settle (world threshold action)
    (do
        (let transition-proposals (lwtf-proposals world threshold))
        (let transition
            (lwsf-settle-transition-items world
                (lwo-field-items transition-proposals) action
                (lwo-empty-field) (lwo-empty-field)))
        (let transition-world (nth transition 0))
        (let symbol-proposals (lwsl-proposals transition-world threshold))
        (let symbol
            (lwsf-settle-symbol-items transition-world
                (lwo-field-items symbol-proposals) action
                (nth transition 1) (nth transition 2)))
        (lwsf-settlement (nth symbol 0)
            (lwsf-field-union symbol-proposals transition-proposals)
            (nth symbol 1) (nth symbol 2))))

(defn lwsf-current-symbol-items (world items symbols)
    (if (eq (len items) 0) symbols
        (do
            (let candidate (head items))
            (lwsf-current-symbol-items world (tail items)
                (if (eq (lwsl-integrated-current? world candidate) 1)
                    (lwo-field-add symbols candidate) symbols)))))
(defn lwsf-current-symbols (world)
    (lwsf-current-symbol-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

; The answer keeps both structural and expressive acknowledgements.  The
; structural ack may be ONE or NODE even when voice remains NOTHING because a
; current derivation has not yet learned a surface.
(defn lwsf-answer-cell (question trace symbols plan)
    (do
        (let prediction (lwsn-trace-prediction trace))
        (intern_node LWSF-ANSWER
            (list question trace prediction symbols plan
                  (lwtf-prediction-ack prediction)
                  (if (node_eq plan (lwo-none)) (oac-nothing)
                      (lwtx-plan-ack plan))
                  (lwtf-prediction-alternatives prediction)
                  (lwtf-prediction-unknown prediction)
                  (lwo-local-path)))))
(defn lwsf-answer? (cell) (lwo-category? cell LWSF-ANSWER))
(defn lwsf-answer-question (answer) (nth (node_children answer) 0))
(defn lwsf-answer-trace (answer) (nth (node_children answer) 1))
(defn lwsf-answer-prediction (answer) (nth (node_children answer) 2))
(defn lwsf-answer-symbols (answer) (nth (node_children answer) 3))
(defn lwsf-answer-plan (answer) (nth (node_children answer) 4))
(defn lwsf-answer-ack (answer) (nth (node_children answer) 5))
(defn lwsf-answer-voice-ack (answer) (nth (node_children answer) 6))
(defn lwsf-answer-alternatives (answer) (nth (node_children answer) 7))
(defn lwsf-answer-unknown (answer) (nth (node_children answer) 8))

(defn lwsf-answer-for (world question)
    (if (or (eq (lwsf-question? question) 0)
            (eq (lwo-active? world question) 0)) (lwo-none)
        (do
            (let context (lwsf-question-context question))
            (let trace (lwsn-trace world context))
            (let prediction (lwsn-trace-prediction trace))
            (let symbols (lwsf-current-symbols world))
            (let plan (lwtx-plan-for world prediction symbols))
            (lwsf-answer-cell question trace symbols plan))))

; One step keeps the exact input, preceding/successor state, boundary receipt,
; settlement, and optional native answer.  It is a derivation cell, not a log
; string and not an authority grant.
(defn lwsf-step (input prior state boundary settlement answer)
    (intern_node LWSF-STEP
        (list input prior state boundary settlement answer
              (lwo-local-path))))
(defn lwsf-step? (cell) (lwo-category? cell LWSF-STEP))
(defn lwsf-step-input (step) (nth (node_children step) 0))
(defn lwsf-step-prior (step) (nth (node_children step) 1))
(defn lwsf-step-state (step) (nth (node_children step) 2))
(defn lwsf-step-boundary (step) (nth (node_children step) 3))
(defn lwsf-step-settlement (step) (nth (node_children step) 4))
(defn lwsf-step-answer (step) (nth (node_children step) 5))

(defn lwsf-boundary-ack (boundary)
    (if (eq (lwsn-receipt? boundary) 1)
        (lwsn-receipt-ack boundary)
        (lwo-transition-ack boundary)))
(defn lwsf-step-ack (step)
    (lwsf-boundary-ack (lwsf-step-boundary step)))

(defn lwsf-content-blind-boundary (world action)
    (lwrs-content-blind-refusal world action (oac-zero)))

(defn lwsf-apply-session (state input)
    (if (not (node_eq (lwsf-session-action input)
                      (lwsf-state-action state)))
        (lwsf-content-blind-boundary
            (lwsf-state-world state) (lwsf-state-action state))
        (lwsn-receive (lwsf-state-world state)
            (lwsf-session-offer input)
            (lwsf-session-consent input)
            (lwsf-state-action state)
            (lwsf-session-now input))))

(defn lwsf-apply-world-entry (state input)
    (if (not (node_eq (lwt-entry-action input)
                      (lwsf-state-action state)))
        (lwsf-content-blind-boundary
            (lwsf-state-world state) (lwsf-state-action state))
        (lwo-receive (lwsf-state-world state)
            (lwt-entry-offer input) (lwsf-state-action state))))

(defn lwsf-boundary-world (boundary)
    (if (eq (lwsn-receipt? boundary) 1)
        (lwsn-receipt-world boundary)
        (lwo-transition-world boundary)))

(defn lwsf-input-question (input boundary)
    (if (eq (lwsf-world-entry? input) 0) (lwo-none)
        (if (eq (oac-one? (lwsf-boundary-ack boundary)) 0) (lwo-none)
            (do
                (let payload (lwo-offer-payload (lwt-entry-offer input)))
                (if (eq (lwsf-question? payload) 1)
                    payload (lwo-none))))))

(defn lwsf-apply (state input)
    (if (eq (lwsf-state? state) 0) (lwo-none)
        (if (lt (lwsf-state-threshold state) 1) (lwo-none)
            (do
            (let boundary
                (if (eq (lwsf-session? input) 1)
                    (lwsf-apply-session state input)
                    (if (eq (lwsf-world-entry? input) 1)
                        (lwsf-apply-world-entry state input)
                        (lwsf-content-blind-boundary
                            (lwsf-state-world state)
                            (lwsf-state-action state)))))
            (let settlement
                (lwsf-settle (lwsf-boundary-world boundary)
                    (lwsf-state-threshold state)
                    (lwsf-state-action state)))
            (let successor
                (lwsf-state (lwsf-settlement-world settlement)
                    (lwsf-state-threshold state)
                    (lwsf-state-action state) state))
            (let question (lwsf-input-question input boundary))
            (let answer
                (if (node_eq question (lwo-none)) (lwo-none)
                    (lwsf-answer-for
                        (lwsf-state-world successor) question)))
            (lwsf-step input state successor boundary settlement answer)))))

(defn lwsf-progress-target (step)
    (do
        (let world (lwsf-state-world (lwsf-step-state step)))
        (let settlement (lwsf-step-settlement step))
        (lcfb-cat (list
            "cells:" (int_to_str
                (lwo-field-size (lwo-world-cells world)))
            ":attributions:" (int_to_str
                (lwo-field-size (lwo-world-attributions world)))
            ":proposals:" (int_to_str
                (lwo-field-size
                    (lwsf-settlement-proposals settlement)))
            ":integrated:" (int_to_str
                (lwo-field-size
                    (lwsf-settlement-integrated settlement)))
            ":ack:" (int_to_str (oac-kind (lwsf-step-ack step)))))))

; The observed entry point emits before work begins and immediately after the
; new content-addressed state is available.  Projection is aggregate-only;
; exact cells remain in the same native framebuffer for explicit readback.
(defn lwsf-apply-observed (state input started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-shared-field"
                "offer" "enter" "form-native" "lwsf-apply"
                "content-addressed-cell" (mul ordinal 2) started
                "form/form-stdlib/living-world-shared-field-channel.fk"
                337 19))
        (let step (lwsf-apply state input))
        (let left
            (lcfb-call-stream "living-world-shared-field"
                "field" "modify" "form-native" "lwsf-settle"
                (lwsf-progress-target step) (add (mul ordinal 2) 1) started
                "form/form-stdlib/living-world-shared-field-channel.fk"
                341 17))
        step))

0
