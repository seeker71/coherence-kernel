; vedic-chat.fk — jyotisha as a native chat: a question in, the attested cast out.
;
; THE ASK (Urs, 2026-09-18): "My Vedic chat for Urs." A door where a question in plain
; words returns a Vedic reading of a real birth-moment, computed on this body, with no
; rented astrologer service in the loop. The chart it answers from by default is the one
; the body already attests (receipts/2026-08-01-genekey-urs.md): 6 October 1971, 09:15
; CET = 08:15 UT, Luzern, 47.05 N 8.31 E.
;
; WHAT WAS ALREADY HERE. Every longitude comes from the proven stack: hgp-sun / hgp-moon /
; hgp-planet (genekey-profile.fk, riding ephemeris-sun/moon/planets at a fractional day
; with the of-date fold), node-omega-raw (ephemeris-nodes.fk), and the twelve rashis in
; zodiac-channel.fk. This cell adds what jyotisha needs on top of a sidereal relabel:
;
;   THE AYANAMSA, DATED   (vc-lahiri nf)          Lahiri (Chitrapaksha) at a day, not the
;                                                  integer 24 celestial-pole-channel carries
;                                                  at degree resolution: 23.8532 at J2000,
;                                                  moving 50.29 arcsec/yr with precession.
;   THE 27 NAKSHATRAS     (nakshatras)             a guidance-channel table: deity/symbol
;                                                  keynote and Vimshottari lord per star;
;                                                  (vc-nakshatra slon) (vc-pada slon)
;   THE NINE GRAHAS       (grahas-sanskrit) (grahas-english)  two tongues, one address
;                                                  each - Surya and Sun are one cell.
;   THE LAGNA             (vc-lagna moment)        the ascendant from sidereal time,
;                                                  obliquity and latitude (Meeus 12.4 GMST)
;   THE BHAVAS            whole-sign houses from the lagna
;   THE VIMSHOTTARI DASHA (vc-dashas moment)       the 120-year cycle from the Moon's
;                                                  nakshatra, dated from birth
;   THE CHAT              (vedic-respond q)        words in, the reading out - Urs's chart
;                         (vedic-respond-for q moment year)   any birth-moment
;
; HONEST FLOOR. Longitudes carry the stack's own accuracy: Sun ~0.01 deg, Moon ~0.2-0.3
; deg, Kepler planets a few tenths, mean node exact to its own model. Rashis (30 deg) and
; nakshatras (13.33 deg) are solid at that floor; a pada (3.33 deg) near a seam may sit
; on its neighbour; a dasha boundary carries the Moon's error stretched by the lord's
; years (0.3 deg of Moon is ~5 months inside a Venus period). The lagna moves one degree
; every four minutes of clock, so it is as good as the birth clock. The names and their
; keynotes are documented tradition, reported as attested; the cast is the empirical
; edge-set and the meaning stays with the person (modality-lattices.form,
; lc-cross-modal-unity). An unseeded key answers honest absence, never a made-up reading.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/celestial-pole-channel.fk form-stdlib/trig.fk form-stdlib/ephemeris-sun.fk form-stdlib/ephemeris-moon.fk form-stdlib/ephemeris-nodes.fk form-stdlib/ephemeris-planets.fk form-stdlib/iching-channel.fk form-stdlib/hd-mandala-wheel.fk form-stdlib/genekey-profile.fk form-stdlib/zodiac-channel.fk
;

(do
    ;; ================================================================
    ;; THE TABLES - data riding the one engine (guidance-channel.fk)
    ;; ================================================================

    ;; --- the 27 nakshatras: key = index along the sidereal ecliptic (13.333 deg each),
    ;;     address 8000+i (the star cell), speak = deity / symbol keynote + Vimshottari lord.
    (defn nakshatras ()
        (list
            (gc-entry 0  8000 "Ashwini - the horse-headed twin physicians; swift beginnings, healing (lord Ketu)" "lc-cross-modal-unity")
            (gc-entry 1  8001 "Bharani - Yama's star, the bearer; carrying life through its thresholds (lord Shukra/Venus)" "lc-cross-modal-unity")
            (gc-entry 2  8002 "Krittika - Agni's razor and flame; cutting to the essential (lord Surya/Sun)" "lc-cross-modal-unity")
            (gc-entry 3  8003 "Rohini - Prajapati's red cart; fertile growth, the beloved of the Moon (lord Chandra/Moon)" "lc-cross-modal-unity")
            (gc-entry 4  8004 "Mrigashira - Soma's deer head; the searching, gentle seeker (lord Mangala/Mars)" "lc-cross-modal-unity")
            (gc-entry 5  8005 "Ardra - Rudra's teardrop; the storm that clears (lord Rahu)" "lc-cross-modal-unity")
            (gc-entry 6  8006 "Punarvasu - Aditi's quiver; the return of the light, renewal (lord Guru/Jupiter)" "lc-cross-modal-unity")
            (gc-entry 7  8007 "Pushya - Brihaspati's nourishing udder; care that feeds (lord Shani/Saturn)" "lc-cross-modal-unity")
            (gc-entry 8  8008 "Ashlesha - the coiled serpent of the Nagas; the embrace that binds (lord Budha/Mercury)" "lc-cross-modal-unity")
            (gc-entry 9  8009 "Magha - the throne of the ancestors; lineage and authority (lord Ketu)" "lc-cross-modal-unity")
            (gc-entry 10 8010 "Purva Phalguni - Bhaga's front legs of the bed; enjoyment, rest, creativity (lord Shukra/Venus)" "lc-cross-modal-unity")
            (gc-entry 11 8011 "Uttara Phalguni - Aryaman's back legs of the bed; friendship and patronage (lord Surya/Sun)" "lc-cross-modal-unity")
            (gc-entry 12 8012 "Hasta - Savitar's hand; skill, craft, the deft touch (lord Chandra/Moon)" "lc-cross-modal-unity")
            (gc-entry 13 8013 "Chitra - Vishvakarma's bright jewel; the maker of beautiful forms (lord Mangala/Mars)" "lc-cross-modal-unity")
            (gc-entry 14 8014 "Swati - Vayu's young sprout in the wind; independence, movement (lord Rahu)" "lc-cross-modal-unity")
            (gc-entry 15 8015 "Vishakha - the triumphal arch of Indra-Agni; single-pointed purpose (lord Guru/Jupiter)" "lc-cross-modal-unity")
            (gc-entry 16 8016 "Anuradha - Mitra's lotus; devotion and friendship across distance (lord Shani/Saturn)" "lc-cross-modal-unity")
            (gc-entry 17 8017 "Jyeshtha - Indra's earring, the elder; protective seniority (lord Budha/Mercury)" "lc-cross-modal-unity")
            (gc-entry 18 8018 "Mula - Nirriti's bundle of roots; going to the root of things (lord Ketu)" "lc-cross-modal-unity")
            (gc-entry 19 8019 "Purva Ashadha - Apas' winnowing fan; the invincible early victory (lord Shukra/Venus)" "lc-cross-modal-unity")
            (gc-entry 20 8020 "Uttara Ashadha - the elephant's tusk of the Vishvadevas; the final, lasting victory (lord Surya/Sun)" "lc-cross-modal-unity")
            (gc-entry 21 8021 "Shravana - Vishnu's ear, the three footprints; listening, learning (lord Chandra/Moon)" "lc-cross-modal-unity")
            (gc-entry 22 8022 "Dhanishta - the drum of the eight Vasus; rhythm and abundance (lord Mangala/Mars)" "lc-cross-modal-unity")
            (gc-entry 23 8023 "Shatabhisha - Varuna's hundred healers, the empty circle; the veiled remedy (lord Rahu)" "lc-cross-modal-unity")
            (gc-entry 24 8024 "Purva Bhadrapada - Aja Ekapada's front of the cot; the fire of transformation (lord Guru/Jupiter)" "lc-cross-modal-unity")
            (gc-entry 25 8025 "Uttara Bhadrapada - Ahir Budhnya's back of the cot; the serpent of the deep, wisdom at rest (lord Shani/Saturn)" "lc-cross-modal-unity")
            (gc-entry 26 8026 "Revati - Pushan's fish; the nourisher of journeys, safe passage (lord Budha/Mercury)" "lc-cross-modal-unity")))

    ;; --- the nine grahas, two tongues at one address each (9000+i). key = graha index:
    ;;     0 Sun 1 Moon 2 Mars 3 Mercury 4 Jupiter 5 Venus 6 Saturn 7 Rahu 8 Ketu.
    ;;     The keynotes are the classical karakas, reported as tradition.
    (defn grahas-sanskrit ()
        (list
            (gc-entry 0 9000 "Surya - the Sun; the self, vitality, the soul's light" "lc-cross-modal-unity")
            (gc-entry 1 9001 "Chandra - the Moon; the mind, feeling, the mother, receptivity" "lc-cross-modal-unity")
            (gc-entry 2 9002 "Mangala - Mars; energy, courage, action, the brother" "lc-cross-modal-unity")
            (gc-entry 3 9003 "Budha - Mercury; speech, intellect, exchange, learning" "lc-cross-modal-unity")
            (gc-entry 4 9004 "Guru - Jupiter; wisdom, the teacher, expansion, grace" "lc-cross-modal-unity")
            (gc-entry 5 9005 "Shukra - Venus; love, beauty, relationship, the arts" "lc-cross-modal-unity")
            (gc-entry 6 9006 "Shani - Saturn; discipline, time, patience, karma ripening" "lc-cross-modal-unity")
            (gc-entry 7 9007 "Rahu - the north node; hunger, the worldly pull, the unfamiliar" "lc-cross-modal-unity")
            (gc-entry 8 9008 "Ketu - the south node; release, the already-known, liberation" "lc-cross-modal-unity")))
    (defn grahas-english ()
        (list
            (gc-entry 0 9000 "Sun" "lc-cross-modal-unity")
            (gc-entry 1 9001 "Moon" "lc-cross-modal-unity")
            (gc-entry 2 9002 "Mars" "lc-cross-modal-unity")
            (gc-entry 3 9003 "Mercury" "lc-cross-modal-unity")
            (gc-entry 4 9004 "Jupiter" "lc-cross-modal-unity")
            (gc-entry 5 9005 "Venus" "lc-cross-modal-unity")
            (gc-entry 6 9006 "Saturn" "lc-cross-modal-unity")
            (gc-entry 7 9007 "Rahu" "lc-cross-modal-unity")
            (gc-entry 8 9008 "Ketu" "lc-cross-modal-unity")))
    (defn graha-speak (i) (gc-speak (grahas-sanskrit) i))
    (defn graha-english (i) (gc-speak (grahas-english) i))
    ;; the Sanskrit name alone: the speak text up to its first " - "
    (defn graha-name (i)
        (do (let s (graha-speak i))
            (substring s 0 (str_find s " - " 0))))
    (defn graha-one-cell? (i)
        (if (eq (gc-same-cell? (grahas-sanskrit) i (grahas-english) i) 1) 1 0))
    (defn nakshatra-speak (i) (gc-speak (nakshatras) i))
    (defn nakshatra-name (i)
        (do (let s (nakshatra-speak i))
            (substring s 0 (str_find s " - " 0))))
    (defn nakshatra-coverage () (gc-coverage (nakshatras)))
    ;; the rashi name alone, read from zodiac-channel's Vedic face ("Mesha (Aries) - ...")
    (defn rashi-name (i)
        (do (let s (vedic-rashi-speak i))
            (substring s 0 (str_find s " (" 0))))
    ;; the Western name in the parenthesis, so a reader in either tongue lands
    (defn rashi-western (i)
        (do (let s (vedic-rashi-speak i))
            (let a (add (str_find s "(" 0) 1))
            (substring s a (str_find s ")" a))))

    ;; --- the Vimshottari lords, in dasha order; a nakshatra's lord is index mod 9 ---
    ;;     (graha key, years). Ketu 7 · Venus 20 · Sun 6 · Moon 10 · Mars 7 · Rahu 18 ·
    ;;     Jupiter 16 · Saturn 19 · Mercury 17 = 120.
    (defn dasha-lords () (list 8 5 0 1 2 7 4 6 3))
    (defn dasha-years () (list 7 20 6 10 7 18 16 19 17))
    (defn dasha-lord-of-nakshatra (n) (nth (dasha-lords) (mod n 9)))
    (defn dasha-cycle-years () (sum (dasha-years)))

    ;; ================================================================
    ;; THE COMPUTATION - sidereal reductions over the proven longitudes
    ;; ================================================================

    ;; Lahiri (Chitrapaksha) ayanamsa at a fractional day nf from J2000: 23 deg 51' 11.5"
    ;; at J2000.0, carried forward at general precession 50.29 arcsec/yr = 0.000038246
    ;; deg/day (the same constant hgp-of-date folds with).
    (defn vc-lahiri-j2000 () 23.8532)
    (defn vc-lahiri (nf) (add (vc-lahiri-j2000) (mul 0.000038246 nf)))
    (defn vc-sidereal (lon nf) (fnorm360 (sub lon (vc-lahiri nf))))

    ;; the reductions, floored on the full float so a body near a seam lands right
    (defn vc-rashi (slon) (floor (div slon 30.0)))
    (defn vc-deg-in-rashi (slon) (sub slon (mul 30.0 (vc-rashi slon))))
    (defn vc-nakshatra (slon) (floor (div (mul slon 27.0) 360.0)))
    (defn vc-pada (slon) (add 1 (mod (floor (div (mul slon 108.0) 360.0)) 4)))
    ;; how far through its nakshatra a longitude sits, 0..1 (the dasha balance reads this)
    (defn vc-nakshatra-frac (slon)
        (do (let x (div (mul slon 27.0) 360.0))
            (sub x (floor x))))

    ;; --- a birth-moment: (y m d ut-hour ut-minute lat-north lon-east) ---------------
    (defn vc-moment (y m d uth utm lat lon) (list y m d uth utm lat lon))
    (defn vc-y   (mo) (nth mo 0))
    (defn vc-m   (mo) (nth mo 1))
    (defn vc-d   (mo) (nth mo 2))
    (defn vc-uth (mo) (nth mo 3))
    (defn vc-utm (mo) (nth mo 4))
    (defn vc-lat (mo) (nth mo 5))
    (defn vc-lon (mo) (nth mo 6))
    (defn vc-nf  (mo) (hgp-n (vc-y mo) (vc-m mo) (vc-d mo) (vc-uth mo) (vc-utm mo)))
    ;; the body's attested ground: Urs, 1971-10-06 09:15 CET (08:15 UT), Luzern
    (defn urs-birth-moment () (vc-moment 1971 10 6 8 15 47.05 8.31))
    (defn urs-birth-words () "6 October 1971, 09:15 CET (08:15 UT), Luzern (47.05 N, 8.31 E)")

    ;; --- each graha's tropical (of-date) longitude at nf --------------------------------
    (defn vc-tropical (key nf)
        (if (eq key 0) (hgp-sun nf)
        (if (eq key 1) (hgp-moon nf)
        (if (eq key 2) (hgp-planet (mars-elements) nf)
        (if (eq key 3) (hgp-planet (mercury-elements) nf)
        (if (eq key 4) (hgp-planet (jupiter-elements) nf)
        (if (eq key 5) (hgp-planet (venus-elements) nf)
        (if (eq key 6) (hgp-planet (saturn-elements) nf)
        (if (eq key 7) (fnorm360 (node-omega-raw nf))
                       (fnorm360 (add (node-omega-raw nf) 180.0)))))))))))

    ;; --- a placement is an edge: (graha-key sidereal-lon rashi nakshatra pada) ---------
    (defn vc-placement (key nf)
        (do (let slon (vc-sidereal (vc-tropical key nf) nf))
            (list key slon (vc-rashi slon) (vc-nakshatra slon) (vc-pada slon))))
    (defn pl-key  (p) (nth p 0))
    (defn pl-slon (p) (nth p 1))
    (defn pl-rashi (p) (nth p 2))
    (defn pl-nak  (p) (nth p 3))
    (defn pl-pada (p) (nth p 4))
    (defn vc-chart-walk (nf k acc)
        (if (gt k 8) acc (vc-chart-walk nf (add k 1) (append acc (list (vc-placement k nf))))))
    ;; the cast: nine placements, Sun through Ketu
    (defn vc-chart (mo) (vc-chart-walk (vc-nf mo) 0 (empty)))
    (defn vc-graha (mo key) (vc-placement key (vc-nf mo)))

    ;; --- the lagna: the ascendant of the birth-moment ---------------------------------
    ;; Greenwich mean sidereal time (Meeus 12.4) at nf days from J2000, degrees.
    (defn vc-gmst (nf)
        (do (let T (div nf 36525.0))
            (fnorm360 (add (add 280.46061837 (mul 360.98564736629 nf))
                           (sub (mul 0.000387933 (mul T T))
                                (div (mul T (mul T T)) 38710000.0))))))
    (defn vc-obliquity (nf)
        (do (let T (div nf 36525.0))
            (sub 23.439291111 (mul 0.013004167 T))))
    (defn vc-ramc (mo) (fnorm360 (add (vc-gmst (vc-nf mo)) (mul 1.0 (vc-lon mo)))))
    ;; asc = atan2(cos RAMC, -(sin eps * tan phi + cos eps * sin RAMC))
    (defn vc-lagna-tropical (mo)
        (do (let R (deg2rad (vc-ramc mo)))
            (let e (deg2rad (vc-obliquity (vc-nf mo))))
            (let phi (deg2rad (mul 1.0 (vc-lat mo))))
            (let tanphi (div (fsin phi) (fcos phi)))
            (let y (fcos R))
            (let x (mul -1.0 (add (mul (fsin e) tanphi) (mul (fcos e) (fsin R)))))
            (fnorm360 (mul (fatan2 y x) 57.29577951308232))))
    (defn vc-lagna (mo) (vc-sidereal (vc-lagna-tropical mo) (vc-nf mo)))
    (defn vc-lagna-rashi (mo) (vc-rashi (vc-lagna mo)))
    ;; whole-sign bhava: the lagna's rashi is house 1
    (defn vc-house (rashi lagna-rashi) (add 1 (mod (add (sub rashi lagna-rashi) 12) 12)))

    ;; --- the Vimshottari dasha: the 120-year cycle read from the Moon's nakshatra ------
    (defn vc-decimal-year (mo)
        (add (mul 1.0 (vc-y mo))
             (div (add (mul 1.0 (sub (jdn (vc-y mo) (vc-m mo) (vc-d mo)) (jdn (vc-y mo) 1 1)))
                       (div (add (mul 1.0 (vc-uth mo)) (div (mul 1.0 (vc-utm mo)) 60.0)) 24.0))
                  365.25)))
    ;; a dasha row: (lord-key start-year end-year)
    (defn ds-lord  (r) (nth r 0))
    (defn ds-start (r) (nth r 1))
    (defn ds-end   (r) (nth r 2))
    (defn vc-dasha-walk (i start k acc)
        (if (eq k 0) acc
            (do (let j (mod i 9))
                (let end (add start (mul 1.0 (nth (dasha-years) j))))
                (vc-dasha-walk (add i 1) end (sub k 1)
                    (append acc (list (list (nth (dasha-lords) j) start end)))))))
    (defn vc-dashas (mo)
        (do (let moon (vc-graha mo 1))
            (let n (pl-nak moon))
            (let i (mod n 9))
            (let birth (vc-decimal-year mo))
            (let balance (mul (mul 1.0 (nth (dasha-years) i)) (sub 1.0 (vc-nakshatra-frac (pl-slon moon)))))
            (let first (list (nth (dasha-lords) i) birth (add birth balance)))
            (vc-dasha-walk (add i 1) (add birth balance) 8 (list first))))
    (defn vc-dasha-find (rows year)
        (if (eq (len rows) 0) (empty)
            (if (lt year (ds-end (head rows))) (head rows) (vc-dasha-find (tail rows) year))))
    ;; the mahadasha running at a decimal year (empty list past the cycle)
    (defn vc-dasha-at (mo year) (vc-dasha-find (vc-dashas mo) (mul 1.0 year)))
    (defn vc-dasha-lord-at (mo year)
        (do (let r (vc-dasha-at mo year))
            (if (eq (len r) 0) -1 (ds-lord r))))

    ;; ================================================================
    ;; THE CHAT - words in, the reading out
    ;; ================================================================

    ;; two decimals, ASCII: 14.8412 -> "14.84"
    (defn vc-fmt2 (x)
        (do (let i (floor x))
            (let f (floor (add (mul (sub x (mul 1.0 i)) 100.0) 0.5)))
            (let i2 (if (eq f 100) (add i 1) i))
            (let f2 (if (eq f 100) 0 f))
            (str_concat (int_to_str i2)
                (str_concat "." (str_concat (if (lt f2 10) "0" "") (int_to_str f2))))))
    (defn vc-year-words (y)
        (do (let i (floor y))
            (let mth (add 1 (floor (mul (sub y (mul 1.0 i)) 12.0))))
            (str_concat (int_to_str i) (str_concat "-" (str_concat (if (lt mth 10) "0" "") (int_to_str mth))))))

    ;; one placement as a line: "Chandra (Moon): Mesha (Aries) 14.84 deg - Bharani pada 1 - house 7"
    (defn vc-placement-line (p lagna-rashi)
        (str_concat (graha-name (pl-key p))
        (str_concat " (" (str_concat (graha-english (pl-key p))
        (str_concat "): " (str_concat (rashi-name (pl-rashi p))
        (str_concat " (" (str_concat (rashi-western (pl-rashi p))
        (str_concat ") " (str_concat (vc-fmt2 (vc-deg-in-rashi (pl-slon p)))
        (str_concat " deg - " (str_concat (nakshatra-name (pl-nak p))
        (str_concat " pada " (str_concat (int_to_str (pl-pada p))
        (str_concat " - house " (int_to_str (vc-house (pl-rashi p) lagna-rashi)))))))))))))))))
    (defn vc-lines (ps lagna-rashi acc)
        (if (eq (len ps) 0) acc
            (vc-lines (tail ps) lagna-rashi
                (str_concat acc (str_concat (vc-placement-line (head ps) lagna-rashi) "\n")))))
    (defn vc-lagna-line (mo)
        (do (let l (vc-lagna mo))
            (str_concat "Lagna (ascendant): " (str_concat (rashi-name (vc-rashi l))
            (str_concat " (" (str_concat (rashi-western (vc-rashi l))
            (str_concat ") " (str_concat (vc-fmt2 (vc-deg-in-rashi l))
            (str_concat " deg - " (str_concat (nakshatra-name (vc-nakshatra l))
            (str_concat " pada " (int_to_str (vc-pada l)))))))))))))
    (defn vc-chart-words (mo)
        (str_concat (str_concat (vc-lagna-line mo) "\n")
                    (vc-lines (vc-chart mo) (vc-lagna-rashi mo) "")))

    ;; one graha in depth: its line, its karakas, its rashi and nakshatra keynotes
    (defn vc-graha-words (mo key)
        (do (let p (vc-graha mo key))
            (str_concat (vc-placement-line p (vc-lagna-rashi mo))
            (str_concat "\n" (str_concat (graha-speak key)
            (str_concat "\n" (str_concat (vedic-rashi-speak (pl-rashi p))
            (str_concat "\n" (nakshatra-speak (pl-nak p))))))))))

    (defn vc-dasha-row-words (r year)
        (str_concat "  " (str_concat (graha-name (ds-lord r))
        (str_concat " (" (str_concat (graha-english (ds-lord r))
        (str_concat ") " (str_concat (vc-year-words (ds-start r))
        (str_concat " to " (str_concat (vc-year-words (ds-end r))
                  (if (lt year (ds-end r)) (if (ge year (ds-start r)) "   <- running" "") ""))))))))))
    (defn vc-dasha-rows-words (rows year acc)
        (if (eq (len rows) 0) acc
            (vc-dasha-rows-words (tail rows) year
                (str_concat acc (str_concat (vc-dasha-row-words (head rows) year) "\n")))))
    (defn vc-dasha-words (mo year)
        (do (let moon (vc-graha mo 1))
            (let r (vc-dasha-at mo year))
            (str_concat "Vimshottari mahadashas from the Moon in "
            (str_concat (nakshatra-name (pl-nak moon))
            (str_concat " (birth balance of the "
            (str_concat (graha-name (dasha-lord-of-nakshatra (pl-nak moon)))
            (str_concat " period):\n"
            (str_concat (vc-dasha-rows-words (vc-dashas mo) (mul 1.0 year) "")
            (if (eq (len r) 0)
                "The 120-year cycle has completed for the year asked."
                (str_concat "Running in " (str_concat (int_to_str (floor (mul 1.0 year)))
                (str_concat ": the " (str_concat (graha-name (ds-lord r))
                (str_concat " mahadasha - " (graha-speak (ds-lord r))))))))))))))))

    (defn vc-ayanamsa-words (mo)
        (str_concat "One sky, two astrologies. The Lahiri ayanamsa at this birth is "
        (str_concat (vc-fmt2 (vc-lahiri (vc-nf mo)))
                    " deg: the sidereal (Vedic) longitude is the tropical (Western) longitude minus that. Aries and Mesha are one sign wearing two tongues; what differs is which sign a degree falls in.")))

    (defn vc-help-words (mo)
        (str_concat "This door reads a Vedic (jyotisha) chart cast on this body for the birth-moment "
        (str_concat (if (eq (vc-y mo) 1971) (urs-birth-words) "given")
        ". Ask about: chart (every graha), lagna, moon, sun, mars, mercury, jupiter, venus, saturn, rahu, ketu, nakshatra, dasha (add a year, e.g. dasha 2030), houses, ayanamsa. The cast is empirical; the names are attested tradition; the meaning stays yours.")))

    ;; --- does the question carry any of these words? (a lowercase and a capitalised face) --
    (defn vc-asks-any (q words)
        (if (eq (len words) 0) 0
            (if (ge (str_find q (head words) 0) 0) 1 (vc-asks-any q (tail words)))))
    ;; a 4-digit year inside the question, or -1: the first "19xx"/"20xx"/"21xx" run
    (defn vc-year-scan (q i)
        (if (gt (add i 4) (str_len q)) -1
            (do (let s (substring q i (add i 4)))
                (let v (str_to_int s))
                (if (ge v 1900) (if (le v 2200) v (vc-year-scan q (add i 1))) (vc-year-scan q (add i 1))))))
    (defn vc-year-in (q) (vc-year-scan q 0))

    ;; the dispatcher: the first matching topic answers
    (defn vedic-respond-for (q mo year)
        (do (let yr (if (ge (vc-year-in q) 0) (vc-year-in q) year))
            (if (eq (vc-asks-any q (list "chart" "Chart" "kundali" "Kundali" "everything" "all grahas" "planets" "Planets" "grahas" "Grahas")) 1)
                (str_concat "The cast for " (str_concat (if (eq (vc-y mo) 1971) (urs-birth-words) "the birth-moment given") (str_concat ":\n" (vc-chart-words mo))))
            (if (eq (vc-asks-any q (list "lagna" "Lagna" "ascendant" "Ascendant" "rising" "Rising")) 1)
                (str_concat (vc-lagna-line mo) (str_concat "\n" (vedic-rashi-speak (vc-lagna-rashi mo))))
            (if (eq (vc-asks-any q (list "dasha" "Dasha" "period" "Period" "mahadasha" "Mahadasha" "running" "now" "today" "current")) 1)
                (vc-dasha-words mo yr)
            (if (eq (vc-asks-any q (list "house" "House" "bhava" "Bhava")) 1)
                (str_concat "Whole-sign bhavas from the lagna:\n" (vc-chart-words mo))
            (if (eq (vc-asks-any q (list "ayanamsa" "Ayanamsa" "sidereal" "Sidereal" "tropical" "Tropical")) 1)
                (vc-ayanamsa-words mo)
            (if (eq (vc-asks-any q (list "nakshatra" "Nakshatra" "star" "Star" "janma" "Janma")) 1)
                (do (let moon (vc-graha mo 1))
                    (str_concat "Janma nakshatra (the Moon's star): " (str_concat (nakshatra-speak (pl-nak moon))
                    (str_concat "\npada " (str_concat (int_to_str (pl-pada moon))
                    (str_concat ", at " (str_concat (vc-fmt2 (vc-deg-in-rashi (pl-slon moon)))
                    (str_concat " deg " (rashi-name (pl-rashi moon))))))))))
            (if (eq (vc-asks-any q (list "moon" "Moon" "chandra" "Chandra" "mind" "rashi" "Rashi")) 1) (vc-graha-words mo 1)
            (if (eq (vc-asks-any q (list "sun" "Sun" "surya" "Surya")) 1) (vc-graha-words mo 0)
            (if (eq (vc-asks-any q (list "mars" "Mars" "mangala" "Mangala")) 1) (vc-graha-words mo 2)
            (if (eq (vc-asks-any q (list "mercury" "Mercury" "budha" "Budha")) 1) (vc-graha-words mo 3)
            (if (eq (vc-asks-any q (list "jupiter" "Jupiter" "guru" "Guru" "brihaspati")) 1) (vc-graha-words mo 4)
            (if (eq (vc-asks-any q (list "venus" "Venus" "shukra" "Shukra")) 1) (vc-graha-words mo 5)
            (if (eq (vc-asks-any q (list "saturn" "Saturn" "shani" "Shani")) 1) (vc-graha-words mo 6)
            (if (eq (vc-asks-any q (list "rahu" "Rahu")) 1) (vc-graha-words mo 7)
            (if (eq (vc-asks-any q (list "ketu" "Ketu")) 1) (vc-graha-words mo 8)
            (if (eq (vc-asks-any q (list "node" "Node" "karmic" "axis")) 1)
                (str_concat (vc-graha-words mo 7) (str_concat "\n\n" (vc-graha-words mo 8)))
                (vc-help-words mo)))))))))))))))))))

    ;; Urs's chat: the attested birth-moment, the year given for the dasha question
    (defn vedic-respond-in (q year) (vedic-respond-for q (urs-birth-moment) year))
    ;; and with no year in hand, the cycle is still shown; "running" needs a year in the question
    (defn vedic-respond (q) (vedic-respond-for q (urs-birth-moment) (if (ge (vc-year-in q) 0) (vc-year-in q) 2026)))

    (defn vedic-chat-teaching () "lc-cross-modal-unity")

    0)
