; stdin Form CLI for daily content-identity comparison.
; preludes: form-stdlib/core.fk form-stdlib/native-model-evidence-delta.fk

(do
    (defn nmedc-kvi (key value)
        (str_concat key (str_concat "=" (str_concat (int_to_str value) "\n"))))
    (defn nmedc-kvs (key value)
        (str_concat key (str_concat "=" (str_concat value "\n"))))
    (let candidate (read_line))
    (let dataset (read_line))
    (let contract (read_line))
    (let prior-candidate (read_line))
    (let prior-dataset (read_line))
    (let prior-contract (read_line))
    (print_str
        (str_concat "schema=native-model-evidence-delta-v1\n"
            (str_concat
                (nmedc-kvs "evidence_state"
                    (nmed-evidence-state candidate dataset contract
                        prior-candidate prior-dataset prior-contract))
                (str_concat
                    (nmedc-kvi "candidate_identity_changed"
                        (nmed-candidate-changed? candidate prior-candidate))
                    (str_concat
                        (nmedc-kvi "dataset_identity_changed"
                            (nmed-dataset-changed? dataset prior-dataset))
                        (str_concat
                            (nmedc-kvi "contract_identity_changed"
                                (nmed-contract-changed? contract prior-contract))
                            (nmedc-kvi "comparison_admissible"
                                (nmed-comparison-admissible? candidate dataset contract
                                    prior-candidate prior-dataset prior-contract))))))))
    0)
