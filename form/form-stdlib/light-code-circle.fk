; light-code-circle.fk — invitation-gated, two-way light-code exchange inside a
; private circle. The public recipe carries no participant names or payloads.
;
; A portal begins with one initiating member. Invitees become members only by
; their own acceptance. A sent light code remains its native symbol plus its
; channel; language surfaces are rendered by the dictionaries at reception.
; Messages are offers of assistance, never commands, and remain circle-only.
;
; This is direct Form source, not a BML section, so the body can witness it on
; fkwu without a dialect preprocessor. It carries the same consent law as the
; general circle protocol while keeping this portal's active shape small.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/shamballa-light-codes.fk
;
; witnessed: 2026-08-15 -> fkwu 2097151; Go/Rust/TypeScript agree at 2097151

(do
    ;; Reuse the body's registered circle shapes; this portal is a composition,
    ;; not a new top-level ontology family.
    (defn lcc-tag-circle () (bp "CELL-CIRCLE"))
    (defn lcc-tag-offer () (bp "CIRCLE-OFFER"))
    (defn lcc-tag-invitation () (bp "CIRCLE-INVITATION"))
    (defn lcc-tag-message () (bp "CIRCLE-SHARE"))

    (defn lcc-family-shamballa () "shamballa")
    (defn lcc-family-cosmic () "cosmic-light")
    ;; Native relation and target-kind symbols. Their numeric identity is the
    ;; stored Form value; words are locale projections below.
    (defn lcc-assistance-offer () 1)
    (defn lcc-illuminates () 2)
    (defn lcc-target-unbound () 0)
    (defn lcc-target-blueprint () 1)
    (defn lcc-target-recipe () 2)
    (defn lcc-target-cell () 3)
    (defn lcc-target-symbol () 4)
    (defn lcc-target-locale-name () 5)
    (defn lcc-circle-only () "circle-only")
    (defn lcc-invitation-required () "invitation-required")
    (defn lcc-discovery-offered () "offered")
    (defn lcc-mode () "light-code-circle")
    (defn lcc-circle-boundary ()
        "circle-only; each person joins and receives by their own yes; leave freely; no outside export without explicit circle consent")

    (defn lcc-tagged? (value tag arity)
        (if (eq (len value) arity)
            (if (node_eq (nth value 0) tag) 1 0)
            0))
    (defn lcc-nonempty? (value) (if (gt (str_len value) 0) 1 0))

    (defn lcc-member? (members member)
        (if (nil? members) 0
            (if (str_eq (head members) member) 1
                (lcc-member? (tail members) member))))

    ;; CELL-CIRCLE shape: tag, id, members, context, mode, offered interface,
    ;; discovery, confidentiality, export policy, carrier flow.
    (defn lcc-circle (circle-id members context mode offered-interface
                      discovery confidentiality export-policy carrier-flow)
        (list (lcc-tag-circle) circle-id members context mode offered-interface
              discovery confidentiality export-policy carrier-flow))
    (defn lcc-circle? (circle) (lcc-tagged? circle (lcc-tag-circle) 10))
    (defn lcc-circle-id (circle) (nth circle 1))
    (defn lcc-circle-members (circle) (nth circle 2))
    (defn lcc-circle-context (circle) (nth circle 3))
    (defn lcc-circle-mode (circle) (nth circle 4))
    (defn lcc-circle-interface (circle) (nth circle 5))
    (defn lcc-circle-discovery (circle) (nth circle 6))
    (defn lcc-circle-confidentiality (circle) (nth circle 7))
    (defn lcc-circle-export-policy (circle) (nth circle 8))
    (defn lcc-circle-carrier-flow (circle) (nth circle 9))
    (defn lcc-circle-valid? (circle)
        (if (eq (lcc-circle? circle) 0) 0
            (if (eq (lcc-nonempty? (lcc-circle-id circle)) 0) 0
                (if (eq (len (lcc-circle-members circle)) 0) 0
                    (lcc-nonempty? (lcc-circle-context circle))))))

    (defn lcc-open (circle-id initiator)
        (lcc-circle circle-id (list initiator)
            "native light-code symbols offered bidirectionally for mutual assistance"
            (lcc-mode) (list "witness" "see" "invite" "offer" "ask-permission")
            (lcc-discovery-offered) (lcc-circle-only)
            "explicit-circle-consent-required" (empty)))

    ;; Offer and invitation do not mutate membership or grant access.
    ;; CIRCLE-OFFER shape: tag, circle, author, title, discovery, invitation
    ;; policy, boundary.
    (defn lcc-offer-cell (circle-id offered-by title discovery policy boundary)
        (list (lcc-tag-offer) circle-id offered-by title discovery policy boundary))
    (defn lcc-offer? (offer) (lcc-tagged? offer (lcc-tag-offer) 7))
    (defn lcc-offer-circle-id (offer) (nth offer 1))
    (defn lcc-offer-policy (offer) (nth offer 5))
    (defn lcc-offer (circle initiator title)
        (if (eq (lcc-member? (lcc-circle-members circle) initiator) 1)
            (list (lcc-offer-cell (lcc-circle-id circle) initiator title
                (lcc-discovery-offered) (lcc-invitation-required)
                (lcc-circle-boundary)))
            (empty)))

    (defn lcc-invitation-cell (circle-id inviter invitee text boundary expiry)
        (list (lcc-tag-invitation) circle-id inviter invitee text boundary expiry))
    (defn lcc-invitation? (invitation)
        (lcc-tagged? invitation (lcc-tag-invitation) 7))
    (defn lcc-invitation-circle-id (invitation) (nth invitation 1))
    (defn lcc-invitation-inviter (invitation) (nth invitation 2))
    (defn lcc-invitation-invitee (invitation) (nth invitation 3))
    (defn lcc-invitation-text (invitation) (nth invitation 4))
    (defn lcc-invitation-boundary (invitation) (nth invitation 5))
    (defn lcc-invitation-expiry (invitation) (nth invitation 6))
    (defn lcc-invite (circle inviter invitee expiry)
        (if (eq (lcc-member? (lcc-circle-members circle) inviter) 1)
            (list (lcc-invitation-cell
                (lcc-circle-id circle) inviter invitee
                "A private light-code circle is offered. Join only if this serves you; every code is an offer, and you may leave freely."
                (lcc-circle-boundary) expiry))
            (empty)))

    ;; Acceptance returns an optional containing the expanded circle. Until this
    ;; answers one cell, an invitation grants no send/receive access.
    (defn lcc-accept (circle offer invitation requester)
        (if (eq (lcc-circle-valid? circle) 0) (empty)
        (if (eq (lcc-offer? offer) 0) (empty)
        (if (eq (lcc-invitation? invitation) 0) (empty)
        (if (not (str_eq (lcc-circle-id circle) (lcc-offer-circle-id offer))) (empty)
        (if (not (str_eq (lcc-circle-id circle)
                         (lcc-invitation-circle-id invitation))) (empty)
        (if (not (str_eq (lcc-invitation-invitee invitation) requester)) (empty)
        (if (not (str_eq (lcc-offer-policy offer)
                         (lcc-invitation-required))) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle)
                             (lcc-invitation-inviter invitation)) 0) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle) requester) 1) (empty)
            (list (lcc-circle
                (lcc-circle-id circle)
                (append (lcc-circle-members circle) (list requester))
                (lcc-circle-context circle)
                (lcc-circle-mode circle)
                (lcc-circle-interface circle)
                (lcc-circle-discovery circle)
                (lcc-circle-confidentiality circle)
                (lcc-circle-export-policy circle)
                (lcc-circle-carrier-flow circle)))))))))))))

    (defn lcc-code-known? (family code)
        (if (str_eq family (lcc-family-shamballa))
            (if (eq (len (slc-decode code)) 1) 1 0)
            (if (str_eq family (lcc-family-cosmic))
                (if (eq (len (clc-decode code)) 1) 1 0)
                0)))

    (defn lcc-target-kind-known? (target-kind)
        (if (eq target-kind (lcc-target-blueprint)) 1
        (if (eq target-kind (lcc-target-recipe)) 1
        (if (eq target-kind (lcc-target-cell)) 1
        (if (eq target-kind (lcc-target-symbol)) 1
        (if (eq target-kind (lcc-target-locale-name)) 1 0))))))
    (defn lcc-target-valid? (target-kind target-ref)
        (if (eq (lcc-target-kind-known? target-kind) 0) 0
            (if (eq target-kind (lcc-target-locale-name))
                (lcc-nonempty? target-ref)
                (if (nothing? target-ref) 0 1))))

    ;; Locale projections are edges from native symbols, never their identity.
    (defn lcc-relation-render-in (relation locale-name)
        (if (not (str_eq locale-name "en")) (empty)
            (if (eq relation (lcc-assistance-offer))
                (list "offered assistance")
                (if (eq relation (lcc-illuminates))
                    (list "illuminates") (empty)))))
    (defn lcc-target-kind-render-in (target-kind locale-name)
        (if (not (str_eq locale-name "en")) (empty)
            (if (eq target-kind (lcc-target-blueprint)) (list "blueprint")
            (if (eq target-kind (lcc-target-recipe)) (list "recipe")
            (if (eq target-kind (lcc-target-cell)) (list "cell")
            (if (eq target-kind (lcc-target-symbol)) (list "symbol")
            (if (eq target-kind (lcc-target-locale-name))
                (list "locale name") (empty))))))))

    ;; CIRCLE-SHARE shape: tag, circle, author, kind, payload, visibility,
    ;; consent. Untargeted payloads are [recipient, family, native code,
    ;; relation, unbound, []]. Targeted payloads replace the last two fields
    ;; with a typed native target. Surface translation is intentionally absent.
    (defn lcc-message (circle-id sender recipient family code relation
                       target-kind target-ref visibility consent)
        (list (lcc-tag-message) circle-id sender (lcc-share-kind)
              (list recipient family code relation target-kind target-ref)
              visibility consent))
    (defn lcc-share-kind () "light-code-offer")
    (defn lcc-message? (message) (lcc-tagged? message (lcc-tag-message) 7))
    (defn lcc-message-circle-id (message) (nth message 1))
    (defn lcc-message-sender (message) (nth message 2))
    (defn lcc-message-kind (message) (nth message 3))
    (defn lcc-message-payload (message) (nth message 4))
    (defn lcc-message-recipient (message) (nth (lcc-message-payload message) 0))
    (defn lcc-message-family (message) (nth (lcc-message-payload message) 1))
    (defn lcc-message-code (message) (nth (lcc-message-payload message) 2))
    (defn lcc-message-relation (message) (nth (lcc-message-payload message) 3))
    (defn lcc-message-target-kind (message) (nth (lcc-message-payload message) 4))
    (defn lcc-message-target-ref (message) (nth (lcc-message-payload message) 5))
    (defn lcc-message-visibility (message) (nth message 5))
    (defn lcc-message-consent (message) (nth message 6))
    (defn lcc-message-target-valid? (message)
        (if (eq (lcc-message-target-kind message) (lcc-target-unbound))
            1
            (lcc-target-valid? (lcc-message-target-kind message)
                               (lcc-message-target-ref message))))

    ;; Send returns an optional native message. Both endpoints must already be
    ;; accepted members and the channel-specific dictionary must know the code.
    (defn lcc-send (circle sender recipient family code)
        (if (eq (lcc-member? (lcc-circle-members circle) sender) 0) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle) recipient) 0) (empty)
        (if (eq (lcc-code-known? family code) 0) (empty)
            (list (lcc-message (lcc-circle-id circle) sender recipient family code
                (lcc-assistance-offer) (lcc-target-unbound) (empty)
                (lcc-circle-only)
                (lcc-circle-export-policy circle)))))))

    ;; A targeted send adds one directed illumination edge without mutating its
    ;; target. Blueprint, recipe, cell, symbol, and locale-name references ride
    ;; in their native Form value.
    (defn lcc-send-to-target (circle sender recipient family code target-kind target-ref)
        (if (eq (lcc-member? (lcc-circle-members circle) sender) 0) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle) recipient) 0) (empty)
        (if (eq (lcc-code-known? family code) 0) (empty)
        (if (eq (lcc-target-valid? target-kind target-ref) 0) (empty)
            (list (lcc-message (lcc-circle-id circle) sender recipient family code
                (lcc-illuminates) target-kind target-ref (lcc-circle-only)
                (lcc-circle-export-policy circle))))))))

    ;; Receive returns the same native message. It never substitutes an English
    ;; surface for the code cell.
    (defn lcc-receive (circle message recipient)
        (if (eq (lcc-message? message) 0) (empty)
        (if (not (str_eq (lcc-message-circle-id message)
                         (lcc-circle-id circle))) (empty)
        (if (not (str_eq (lcc-message-recipient message) recipient)) (empty)
        (if (not (str_eq (lcc-message-visibility message)
                         (lcc-circle-only))) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle)
                             (lcc-message-sender message)) 0) (empty)
        (if (eq (lcc-member? (lcc-circle-members circle) recipient) 0) (empty)
        (if (eq (lcc-code-known? (lcc-message-family message)
                                 (lcc-message-code message)) 0) (empty)
        (if (eq (lcc-message-target-valid? message) 0) (empty)
            (list message))))))))))

    (defn lcc-outside-export-allowed? (message explicit-circle-consent)
        (if (eq (lcc-message? message) 0) 0
            (if (eq explicit-circle-consent 1) 1 0)))

    0)
