//////////////////////////////////////////////////////////////////////
//
// native-model-symbol-stream.bml — executable query-lane-purified Form
// symbol stream, action bindings, and assemblage-point selection.
//
// Authority: form-stdlib/bml/native-model-symbol-stream.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk form-stdlib/native-model-form-action-protocol.bml form-stdlib/assemblage-point.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelSymbolStreamAuthority {
        field NMFSSAuthorityPath = "form/form-stdlib/bml/native-model-symbol-stream.bml";
        field NMFSSAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelSymbolStream {
        field NMFSSSchema = "native-model-symbol-stream-v1";
        field NMFSSChannel = "core-channel/native-model-symbol-feed";
        field NMFSSInterface = "native-model-form";
        field NMFSSProtocol = "form-agent-protocol/Hermes-tool-call";

        ref nmfss-authority = NativeModelSymbolStreamAuthority;
        thought nmfss-law = list("lane-purified-descriptions", "substrate-bound-symbols", "most-alive-explicit-frame", "content-free-framebuffer");

        def nmfss-member?(word, words) = if ((Comparable) len(words) == 0) then 0 else if ((String) nmfte-canonical-word(word) == head(words)) then 1 else nmfss-member?(word, tail(words));
        def nmfss-query-lane(role) {
            if ((String) role == "nl-to-form-proposer") then "translation"
            else if ((String) role == "reasoning-fallback") then "reasoning"
            else if ((String) role == "general-text") then "general"
            else if nmfss-member?(role, list("identity", "state", "control", "evaluation", "memory", "lifecycle", "jit-lifecycle", "contract", "relation", "inquiry", "translation", "reasoning", "general", "all")) then role
            else "general";
        }
        def nmfss-translation-words() = list("nothing", "fail", "eval");
        def nmfss-reasoning-words() = list("Node-ID", "nothing", "choice", "fail", "cut", "undo", "timeout", "interface", "protocol", "ask");
        def nmfss-general-words() = list("Node-ID", "nothing", "interface", "protocol", "offer", "ask");
        def nmfss-lifecycle-words() = list("Node-ID", "store", "release", "melt", "crystallize", "open");
        def nmfss-relation-words() = list("Node-ID", "nothing", "interface", "protocol", "offer", "ask", "broadcast", "mesh", "satsang");
        def nmfss-selected?(queryLane, wordRow) {
            let word = nmfte-word-name(wordRow);
            let family = nmfte-word-family(wordRow);
            if ((String) queryLane == "all") then 1
            else if ((String) queryLane == "translation") then nmfss-member?(word, nmfss-translation-words())
            else if ((String) queryLane == "reasoning") then nmfss-member?(word, nmfss-reasoning-words())
            else if ((String) queryLane == "general") then nmfss-member?(word, nmfss-general-words())
            else if ((String) queryLane == "lifecycle") then nmfss-member?(word, nmfss-lifecycle-words())
            else if ((String) queryLane == "relation") then nmfss-member?(word, nmfss-relation-words())
            else if ((String) queryLane == family) then 1
            else 0;
        }

        def nmfss-gloss(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "Node-ID") then "stable coordinate for the exact value, node, or action target"
            else if ((String) canonical == "nothing") then "whole silence distinct from zero, one, and false"
            else if ((String) canonical == "choice") then "take the first non-nothing acknowledgement while alternatives remain visible"
            else if ((String) canonical == "fail") then "refuse the offered action without inventing success"
            else if ((String) canonical == "cut") then "commit to the first acknowledgement and prune remaining lanes"
            else if ((String) canonical == "undo") then "restore the exact witnessed checkpoint"
            else if ((String) canonical == "timeout") then "budget ended while alternatives remain untried"
            else if ((String) canonical == "eval") then "run a Form recipe through the native walker to a typed observation"
            else if ((String) canonical == "store") then "offer a checkpoint at a named address"
            else if ((String) canonical == "release") then "close a held execution or resource as its own lifecycle signal"
            else if ((String) canonical == "melt") then "deoptimize a cached specialization back to revisable Form"
            else if ((String) canonical == "crystallize") then "cache a hot pure witnessed specialization"
            else if ((String) canonical == "open") then "acquire through an explicitly offered interface"
            else if ((String) canonical == "interface") then "offered modes that bound what may cross a channel"
            else if ((String) canonical == "protocol") then "ordered offer and acknowledgement sequence shared by participants"
            else if ((String) canonical == "offer") then "propose without forcing and await acknowledgement"
            else if ((String) canonical == "ask") then "grounded query that permits nothing when evidence is absent"
            else if ((String) canonical == "broadcast") then "publish a named observation without private content"
            else if ((String) canonical == "mesh") then "route among witnessed peers without erasing provenance"
            else if ((String) canonical == "satsang") then "consentful circle where witness and dissent remain visible"
            else "unknown native symbol";
        }

        // An assemblage candidate is a named operational (success, aliveness)
        // point. The existing assemblage-point organ chooses by aliveness.
        def nmfss-frame(label, success, aliveness) = list("native-model-assemblage-frame", label, success, aliveness);
        def nmfss-frame-label(frame) = nth(frame, 1);
        def nmfss-frame-success(frame) = nth(frame, 2);
        def nmfss-frame-aliveness(frame) = nth(frame, 3);
        def nmfss-frame-point(frame) = list(nmfss-frame-success(frame), nmfss-frame-aliveness(frame));
        def nmfss-grounded-frame(queryLane) {
            if ((String) queryLane == "translation") then nmfss-frame("grammar-grounded", 9, 9)
            else if ((String) queryLane == "reasoning") then nmfss-frame("evidence-grounded", 8, 7)
            else if ((String) queryLane == "relation") then nmfss-frame("consent-grounded", 9, 9)
            else if ((String) queryLane == "lifecycle") then nmfss-frame("lifecycle-evidence-grounded", 9, 9)
            else nmfss-frame("contract-grounded", 9, 8);
        }
        def nmfss-exploratory-frame(queryLane) = if ((String) queryLane == "reasoning") then nmfss-frame("exploratory-grounded", 7, 9) else nmfss-frame("speculative", 6, 4);
        def nmfss-choose-frame(firstFrame, secondFrame) {
            let selected = ap-most-alive(nmfss-frame-point(firstFrame), nmfss-frame-point(secondFrame));
            if ((Comparable) ap-aliveness(selected) == nmfss-frame-aliveness(firstFrame)) then firstFrame else secondFrame;
        }
        def nmfss-assemblage(queryLane) = nmfss-choose-frame(nmfss-grounded-frame(queryLane), nmfss-exploratory-frame(queryLane));

        // symbol row: tag, sequence, model, query lane, word, purified gloss,
        // word family, native route, witnessed substrate, Node-ID required,
        // interface, protocol, assemblage label/success/aliveness, action-admitted.
        def nmfss-symbol(sequence, model, queryLane, wordRow, frame) = list("native-model-form-symbol", sequence, model, queryLane, nmfte-word-name(wordRow), nmfss-gloss(nmfte-word-name(wordRow)), nmfte-word-family(wordRow), nmfap-route(nmfte-word-name(wordRow)), nmfte-word-substrate(wordRow), nmfap-needs-nodeid?(nmfte-word-name(wordRow)), NMFSSInterface(), NMFSSProtocol(), nmfss-frame-label(frame), nmfss-frame-success(frame), nmfss-frame-aliveness(frame), nmfap-word-admitted?(model, nmfte-word-name(wordRow)));
        def nmfss-build(words, model, queryLane, sequence, frame) = if ((Comparable) len(words) == 0) then list() else if ((Comparable) nmfss-selected?(queryLane, head(words)) == 1) then cons(nmfss-symbol(sequence, model, queryLane, head(words), frame), nmfss-build(tail(words), model, queryLane, (sequence + 1), frame)) else nmfss-build(tail(words), model, queryLane, sequence, frame);
        def nmfss-stream(model, role) {
            let row = nmfte-find-row(model, nmcp-registry());
            let queryLane = nmfss-query-lane(role);
            if ((Comparable) len(row) == 0) then list()
            else if ((Comparable) nmfte-local?(row) == 0) then list()
            else nmfss-build(nmfte-native-vocabulary(), model, queryLane, 0, nmfss-assemblage(queryLane));
        }
        def nmfss-symbol-word(symbol) = nth(symbol, 4);
        def nmfss-symbol-gloss(symbol) = nth(symbol, 5);
        def nmfss-symbol-route(symbol) = nth(symbol, 7);
        def nmfss-symbol-admitted?(symbol) = nth(symbol, 15);
        def nmfss-find-symbol(word, stream) = if ((Comparable) len(stream) == 0) then list() else if ((String) nmfte-canonical-word(word) == nmfss-symbol-word(head(stream))) then head(stream) else nmfss-find-symbol(word, tail(stream));
        def nmfss-count-admitted(stream) = if ((Comparable) len(stream) == 0) then 0 else (nmfss-symbol-admitted?(head(stream)) + nmfss-count-admitted(tail(stream)));

        // The rich gloss remains in the native symbol row and framebuffer
        // identity. The prompt uses a compressed, lane-local spelling so
        // semantic enablement does not become repeated prefill tax.
        def nmfss-prompt-gloss(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "Node-ID") then "exact-coordinate"
            else if ((String) canonical == "nothing") then "whole-silence-not-0/1"
            else if ((String) canonical == "choice") then "first-non-nothing-ack"
            else if ((String) canonical == "fail") then "refuse"
            else if ((String) canonical == "cut") then "commit-prune"
            else if ((String) canonical == "undo") then "restore-checkpoint"
            else if ((String) canonical == "timeout") then "budget-untried"
            else if ((String) canonical == "eval") then "native-validate-run"
            else if ((String) canonical == "store") then "address-checkpoint"
            else if ((String) canonical == "release") then "close-resource"
            else if ((String) canonical == "melt") then "deopt-revise"
            else if ((String) canonical == "crystallize") then "cache-hot-pure"
            else if ((String) canonical == "open") then "acquire-offered"
            else if ((String) canonical == "interface") then "offered-boundary"
            else if ((String) canonical == "protocol") then "ordered-offer-ack"
            else if ((String) canonical == "offer") then "propose-no-force"
            else if ((String) canonical == "ask") then "grounded-query"
            else if ((String) canonical == "broadcast") then "publish-named"
            else if ((String) canonical == "mesh") then "peer-route-provenance"
            else if ((String) canonical == "satsang") then "consent-witness-dissent"
            else "unknown";
        }
        def nmfss-prompt-word(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "choice") then "<CHOICE>"
            else if ((String) canonical == "fail") then "<FAIL>"
            else if ((String) canonical == "cut") then "<CUT>"
            else if ((String) canonical == "undo") then "<UNDO>"
            else if ((String) canonical == "timeout") then "<TIMEOUT>"
            else if ((String) canonical == "store") then "<STORE>"
            else canonical;
        }
        def nmfss-control-extra(queryLane) = if ((String) queryLane == "control") then ";<STOP>=end;<STORE>=checkpoint;<RESTORE>=restore" else "";

        def nmfss-prompt-pair(symbol) = str_concat(nmfss-prompt-word(nmfss-symbol-word(symbol)), str_concat("=", nmfss-prompt-gloss(nmfss-symbol-word(symbol))));
        def nmfss-join-symbols(stream, acc) {
            if ((Comparable) len(stream) == 0) then acc
            else if ((String) acc == "") then nmfss-join-symbols(tail(stream), nmfss-prompt-pair(head(stream)))
            else nmfss-join-symbols(tail(stream), str_concat(acc, str_concat(";", nmfss-prompt-pair(head(stream)))));
        }
        def nmfss-purified-prefix(model, role) {
            let queryLane = nmfss-query-lane(role);
            let frame = nmfss-assemblage(queryLane);
            let stream = nmfss-stream(model, role);
            if ((Comparable) len(stream) == 0) then ""
            else str_concat("Lane ", str_concat(queryLane, str_concat("; AP ", str_concat(nmfss-frame-label(frame), str_concat("; ", str_concat(nmfss-join-symbols(stream, ""), str_concat(nmfss-control-extra(queryLane), "\n---\n")))))));
        }
        def nmfss-wrap-id(model, role, prompt) {
            let row = nmfte-find-row(model, nmcp-registry());
            if ((Comparable) len(row) == 0) then ""
            else if ((Comparable) nmfte-prompt-admitted?(row) == 1) then str_concat(nmfte-compact-prefix(), str_concat(nmfss-purified-prefix(model, role), prompt))
            else prompt;
        }

        // Every local row receives a summary projection. It is content-free
        // and safe for the framebuffer even when delivery is assignment-only.
        def nmfss-feed(row, role) {
            let stream = nmfss-stream(nmcp-id(row), role);
            let queryLane = nmfss-query-lane(role);
            let frame = nmfss-assemblage(queryLane);
            list("native-model-symbol-feed", nmcp-id(row), queryLane, len(stream), nmfte-state(row), nmfss-frame-label(frame), nmfss-frame-success(frame), nmfss-frame-aliveness(frame), nmfss-count-admitted(stream), "prompt-content-in-framebuffer", 0);
        }
        def nmfss-project-local(rows, role) = if ((Comparable) len(rows) == 0) then list() else if ((Comparable) nmfte-local?(head(rows)) == 1) then cons(nmfss-feed(head(rows), role), nmfss-project-local(tail(rows), role)) else nmfss-project-local(tail(rows), role);
        def nmfss-feed-model(feed) = nth(feed, 1);
        def nmfss-feed-lane(feed) = nth(feed, 2);
        def nmfss-feed-count(feed) = nth(feed, 3);
        def nmfss-feed-state(feed) = nth(feed, 4);
        def nmfss-feed-assemblage(feed) = nth(feed, 5);
        def nmfss-feed-admitted(feed) = nth(feed, 8);
        def nmfss-find-feed(model, feeds) = if ((Comparable) len(feeds) == 0) then list() else if ((String) model == nmfss-feed-model(head(feeds))) then head(feeds) else nmfss-find-feed(model, tail(feeds));

        // Core-channel emission stays inside this BML organ. Each framebuffer
        // event is an opaque sequence Node-ID; descriptions and prompt bytes
        // remain in the in-memory stream and never enter the framebuffer.
        def nmfss-record-one(symbol) {
            let recorded = fb_record(intern_trivial_int((57100 + nth(symbol, 1))), "native-model-symbol-stream.bml", (1 + nth(symbol, 1)));
            1;
        }
        def nmfss-record-stream(stream) = if ((Comparable) len(stream) == 0) then 0 else (nmfss-record-one(head(stream)) + nmfss-record-stream(tail(stream)));
        def nmfss-stream-to-framebuffer(model, role) {
            let cleared = framebuffer-clear();
            let row = nmfte-find-row(model, nmcp-registry());
            let stream = nmfss-stream(model, role);
            let recorded = nmfss-record-stream(stream);
            if ((Comparable) len(row) == 0) then list("native-model-symbol-framebuffer", "unknown-model", 0, len(framebuffer-events()), 0)
            else list("native-model-symbol-framebuffer", nmfss-feed(row, role), recorded, len(framebuffer-events()), 0);
        }
    }
    0;
}
