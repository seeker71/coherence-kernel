// bml-native-source-control.fk - bounded source-control transfer floor.
//
// This is the minimum executable row for BML source control transfer before the
// broad grammar lowerer is complete: source receipts become Form-native break,
// continue, throw, and try/catch effect rows. It does not claim arbitrary
// while/for/switch lowering.
//
// preludes: form-stdlib/core.fk
//
section [form.bml] {
    def bnsc-source(language, path, line) = list("source", language, path, line);
    def bnsc-source-language(source) = nth(source, 1);
    def bnsc-source-path(source) = nth(source, 2);
    def bnsc-source-line(source) = nth(source, 3);
    def bnsc-effect(kind, label, value, primitive, source) = list("bml-native-source-control-effect", kind, label, value, primitive, source);
    def bnsc-effect?(row) = (Comparable) len(row) == 6 ? (String) nth(row, 0) == "bml-native-source-control-effect" : 0;
    def bnsc-effect-kind(row) = nth(row, 1);
    def bnsc-effect-label(row) = nth(row, 2);
    def bnsc-effect-value(row) = nth(row, 3);
    def bnsc-effect-primitive(row) = nth(row, 4);
    def bnsc-effect-source(row) = nth(row, 5);
    def bnsc-break(label, source) = bnsc-effect("break", label, 0, "stop", source);
    def bnsc-continue(label, source) = bnsc-effect("continue", label, 0, "choice", source);
    def bnsc-throw(value, source) = bnsc-effect("throw", "", value, "fail", source);
    def bnsc-value(value, source) = bnsc-effect("value", "", value, "return", source);
    def bnsc-loop-state(mode, label, cursor, value, source) = list("bml-native-source-control-loop", mode, label, cursor, value, source);
    def bnsc-loop-mode(state) = nth(state, 1);
    def bnsc-loop-label(state) = nth(state, 2);
    def bnsc-loop-cursor(state) = nth(state, 3);
    def bnsc-loop-value(state) = nth(state, 4);
    def bnsc-loop-source(state) = nth(state, 5);
    def bnsc-loop-step(state, effect) = (String) bnsc-effect-kind(effect) == "break" ? bnsc-loop-state("stopped", bnsc-effect-label(effect), bnsc-loop-cursor(state), 0, bnsc-effect-source(effect)) : (String) bnsc-effect-kind(effect) == "continue" ? bnsc-loop-state("running", bnsc-effect-label(effect), bnsc-loop-cursor(state) + 1, 0, bnsc-effect-source(effect)) : (String) bnsc-effect-kind(effect) == "throw" ? bnsc-loop-state("failed", bnsc-loop-label(state), bnsc-loop-cursor(state), bnsc-effect-value(effect), bnsc-effect-source(effect)) : bnsc-loop-state("running", bnsc-loop-label(state), bnsc-loop-cursor(state), bnsc-effect-value(effect), bnsc-loop-source(state));
    def bnsc-catch(effect, handler-value, source) = (String) bnsc-effect-kind(effect) == "throw" ? bnsc-value(handler-value, source) : effect;
    def bnsc-try-catch(body-effect, handler-value, source) = bnsc-catch(body-effect, handler-value, source);
    def bnsc-required-primitives(_x) = list("stop", "choice", "fail", "return");
    def bnsc-required-primitive-count(_x) = len(bnsc-required-primitives(0));
    def bnsc-next-code-point() = "form/form-stdlib/grammars/bml.fk:general break/continue/throw/try-catch source nodes -> bml-native-source-control effects";
    0;
}
