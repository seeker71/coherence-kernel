; form-cli-resident-multi-skill-loop.fk -- pure evidence ledger for several
; executable Form teaching/check movements inside one resident model context.
;
; This cell opens no model and executes no carrier.  It binds the physical
; driver's snapshots to exact content-addressed knowledge, teaching, attempt,
; verdict, refinement, and acknowledgment rows.  A repaired BML crossing is
; honestly labelled supervised embodiment and receives no held-out generative
; mastery credit.  The independent fgsg gate remains that authority.
;
; preludes: form-stdlib/form-cli-nodeid-knowledge-session.fk form-stdlib/generative-form-skill-gate.fk form-stdlib/native-model-evidence.fk
; Proven by: form-stdlib/tests/form-cli-resident-multi-skill-loop-band.fk

(defn fmsl-cat (parts)
        (if (nil? parts) ""
            (str_concat (head parts) (fmsl-cat (tail parts)))))
    (defn fmsl-all? (values)
        (if (nil? values) 1
            (if (head values) (fmsl-all? (tail values)) 0)))

    ; ---- typed, recomputable content addresses -----------------------
    (defn fmsl-typed-digest (kind content)
        (list "resident-multi-skill-digest-v1" kind
            (nmfe-sha256 (nmfe-fields (list kind content)))))
    (defn fmsl-digest-kind (digest) (nth digest 1))
    (defn fmsl-digest-sha (digest) (nth digest 2))
    (defn fmsl-typed-digest-valid? (digest kind content)
        (if (not (eq (len digest) 3)) 0
        (if (not (str_eq (nth digest 0)
            "resident-multi-skill-digest-v1")) 0
        (if (not (str_eq (fmsl-digest-kind digest) kind)) 0
        (if (not (eq (nmfe-sha256? (fmsl-digest-sha digest)) 1)) 0
            (if (str_eq (fmsl-digest-sha digest)
                (fmsl-digest-sha (fmsl-typed-digest kind content))) 1 0))))))

    ; ---- one strict knowledge request/result/source/content binding --
    (defn fmsl-knowledge-response (concept source-path)
        (fmsl-cat (list "knowledge-held " concept " source=" source-path)))
    (defn fmsl-request-material (kind coordinate surface)
        (nmfe-fields (list kind coordinate surface)))
    (defn fmsl-source-material (source-id source-path)
        (nmfe-fields (list source-id source-path)))
    (defn fmsl-result-material
        (status reason source-id source-path content frame)
        (nmfe-fields (list status reason source-id source-path content frame)))
    (defn fmsl-knowledge-binding
        (concept request-kind request-coordinate request-surface
         status reason source-id source-path content frame response)
        (list "resident-knowledge-binding-v1"
            concept request-kind request-coordinate request-surface
            status reason source-id source-path content frame response
            (fmsl-typed-digest "strict-request"
                (fmsl-request-material request-kind request-coordinate
                    request-surface))
            (fmsl-typed-digest "strict-result"
                (fmsl-result-material status reason source-id source-path
                    content frame))
            (fmsl-typed-digest "source"
                (fmsl-source-material source-id source-path))
            (fmsl-typed-digest "content" content)
            (fmsl-typed-digest "typed-observation" frame)
            (fmsl-typed-digest "model-knowledge-response" response)))
    (defn fmsl-kb-concept (binding) (nth binding 1))
    (defn fmsl-kb-request-kind (binding) (nth binding 2))
    (defn fmsl-kb-request-coordinate (binding) (nth binding 3))
    (defn fmsl-kb-request-surface (binding) (nth binding 4))
    (defn fmsl-kb-status (binding) (nth binding 5))
    (defn fmsl-kb-reason (binding) (nth binding 6))
    (defn fmsl-kb-source-id (binding) (nth binding 7))
    (defn fmsl-kb-source-path (binding) (nth binding 8))
    (defn fmsl-kb-content (binding) (nth binding 9))
    (defn fmsl-kb-frame (binding) (nth binding 10))
    (defn fmsl-kb-response (binding) (nth binding 11))
    (defn fmsl-knowledge-binding-valid? (binding)
        (if (not (eq (len binding) 18)) 0
        (if (not (str_eq (nth binding 0)
            "resident-knowledge-binding-v1")) 0
        (do
            (let concept (fmsl-kb-concept binding))
            (let kind (fmsl-kb-request-kind binding))
            (let coordinate (fmsl-kb-request-coordinate binding))
            (let surface (fmsl-kb-request-surface binding))
            (let status (fmsl-kb-status binding))
            (let reason (fmsl-kb-reason binding))
            (let source-id (fmsl-kb-source-id binding))
            (let source-path (fmsl-kb-source-path binding))
            (let content (fmsl-kb-content binding))
            (let frame (fmsl-kb-frame binding))
            (let response (fmsl-kb-response binding))
            (fmsl-all? (list
                (psci-concept-key-valid? concept)
                (str_eq kind "concept")
                (str_eq coordinate concept)
                (str_eq surface (fknq-concept-surface concept))
                (str_eq status "hit")
                (if (eq (str_len reason) 0) 0 1)
                (psci-source-id-valid? source-id)
                (if (eq (str_len source-path) 0) 0 1)
                (if (eq (str_len content) 0) 0 1)
                (fknsc-observation-valid? frame)
                (if (ge (str_find frame content 0) 0) 1 0)
                (str_eq response
                    (fmsl-knowledge-response concept source-path))
                (fmsl-typed-digest-valid? (nth binding 12)
                    "strict-request"
                    (fmsl-request-material kind coordinate surface))
                (fmsl-typed-digest-valid? (nth binding 13)
                    "strict-result"
                    (fmsl-result-material status reason source-id source-path
                        content frame))
                (fmsl-typed-digest-valid? (nth binding 14) "source"
                    (fmsl-source-material source-id source-path))
                (fmsl-typed-digest-valid? (nth binding 15) "content" content)
                (fmsl-typed-digest-valid? (nth binding 16)
                    "typed-observation" frame)
                (fmsl-typed-digest-valid? (nth binding 17)
                    "model-knowledge-response" response)))))))

    ; evidence retains the physical one-query counters plus their exact row.
    (defn fmsl-knowledge-evidence
        (status crossed callbacks lookups injections scannerless pretokenized
         model-executed strict exact-request response-used binding)
        (list "resident-knowledge-evidence-v1" status crossed callbacks
            lookups injections scannerless pretokenized model-executed strict
            exact-request response-used binding))
    (defn fmsl-ke-binding (evidence) (nth evidence 12))
    (defn fmsl-knowledge-evidence-valid? (evidence)
        (if (not (eq (len evidence) 13)) 0
        (if (not (str_eq (nth evidence 0)
            "resident-knowledge-evidence-v1")) 0
            (fmsl-all? (list
                (str_eq (nth evidence 1) "hit")
                (eq (nth evidence 2) 1)
                (eq (nth evidence 3) 1)
                (eq (nth evidence 4) 1)
                (eq (nth evidence 5) 1)
                (eq (nth evidence 6) 1)
                (eq (nth evidence 7) 0)
                (eq (nth evidence 8) 0)
                (eq (nth evidence 9) 1)
                (eq (nth evidence 10) 1)
                (eq (nth evidence 11) 1)
                (fmsl-knowledge-binding-valid?
                    (fmsl-ke-binding evidence)))))))

    ; ---- exact concept/challenge-bound teaching ----------------------
    (defn fmsl-challenge-material (challenge)
        (nmfe-fields (list
            (int_to_str (fgsg-challenge-bml-value challenge))
            (int_to_str (fgsg-challenge-input challenge))
            (int_to_str (fgsg-challenge-checkpoint challenge))
            (int_to_str (fgsg-challenge-timeout-budget challenge))
            (fgsg-challenge-plane challenge)
            (int_to_str (fgsg-challenge-heat challenge))
            (int_to_str (fgsg-challenge-pure challenge)))))
    (defn fmsl-teaching-frame (concept)
        (do
            (let challenge (fgsg-challenge))
            (fmsl-cat (list
                "<|form:resident-teaching|>\nversion=resident-multi-skill-v2"
                "\nconcept=" concept
                "\nconcept-digest="
                (fmsl-digest-sha (fmsl-typed-digest "teaching-concept" concept))
                "\nchallenge-digest="
                (fmsl-digest-sha (fmsl-typed-digest "teaching-challenge"
                    (fmsl-challenge-material challenge)))
                "\nBML=write one method plus invocation; it must parse and agree in direct and Form-lowered execution"
                "\nBMF=author a custom grammar consumed by the scannerless raw-byte live cursor; its alternative must undo then cut on the consuming branch"
                "\nFORM=compose the requested NodeID micro-thought with choice, cut, undo, timeout, nothing, value-present zero and one, checkpoint restore, thought routing, and auto-JIT evidence"
                "\nresponse=<BML>...</BML><BMF>...</BMF><FORM>...</FORM>"
                "\nmodel-executed-form=0\n<|/form:resident-teaching|>"))))
    (defn fmsl-teach-valid? (frame)
        (if (not (eq (str_find frame "<|form:resident-teaching|>" 0) 0)) 0
        (if (not (ge (str_find frame "\nconcept-digest=" 0) 0)) 0
        (if (not (ge (str_find frame "\nchallenge-digest=" 0) 0)) 0
        (if (not (ge (str_find frame "scannerless raw-byte live cursor" 0) 0)) 0
        (if (not (ge (str_find frame "nothing, value-present zero and one" 0) 0)) 0
            (if (ge (str_find frame "<|/form:resident-teaching|>" 0) 0) 1 0)))))))
    (defn fmsl-teaching-bound? (concept frame)
        (if (and (eq (fmsl-teach-valid? frame) 1)
            (str_eq frame (fmsl-teaching-frame concept))) 1 0))

    ; ---- canonical serialization of exact executable candidates/verdicts --
    (defn fmsl-candidate-material (candidate)
        (if (not (eq (fgsg-candidate? candidate) 1)) "nothing"
            (nmfe-fields (list
                (fgsg-candidate-bml candidate)
                (fgsg-candidate-bmf candidate)
                (fgsg-candidate-form candidate)))))
    (defn fmsl-bml-observation-material (row)
        (if (not (eq (len row) 6)) "invalid"
            (nmfe-fields (list (nth row 0)
                (int_to_str (nth row 1)) (int_to_str (nth row 2))
                (int_to_str (nth row 3)) (int_to_str (nth row 4))
                (int_to_str (nth row 5))))))
    (defn fmsl-bmf-observation-material (row)
        (if (not (eq (len row) 15)) "invalid"
            (nmfe-fields (list (nth row 0) (nth row 1)
                (int_to_str (nth row 2)) (int_to_str (nth row 3))
                (int_to_str (nth row 4)) (int_to_str (nth row 5))
                (int_to_str (nth row 6)) (int_to_str (nth row 7))
                (int_to_str (nth row 8)) (int_to_str (nth row 9))
                (int_to_str (nth row 10)) (int_to_str (nth row 11))
                (int_to_str (nth row 12)) (int_to_str (nth row 13))
                (int_to_str (nth row 14))))))
    (defn fmsl-form-observation-material (row)
        (if (not (eq (len row) 23)) "invalid"
            (nmfe-fields (list (nth row 0)
                (int_to_str (nth row 1)) (int_to_str (nth row 2))
                (int_to_str (nth row 3)) (int_to_str (nth row 4))
                (nth row 5) (int_to_str (nth row 6))
                (int_to_str (nth row 7)) (int_to_str (nth row 8))
                (int_to_str (nth row 9)) (int_to_str (nth row 10))
                (int_to_str (nth row 11)) (int_to_str (nth row 12))
                (int_to_str (nth row 13)) (nth row 14)
                (int_to_str (nth row 15)) (int_to_str (nth row 16))
                (int_to_str (nth row 17)) (int_to_str (nth row 18))
                (nth row 19) (int_to_str (nth row 20)) (nth row 21)
                (int_to_str (nth row 22))))))
    (defn fmsl-verdict-material (candidate-digest verdict)
        (if (not (eq (len verdict) 12)) "invalid"
            (nmfe-fields (list candidate-digest
                (int_to_str (fgsg-verdict-overall verdict))
                (int_to_str (fgsg-verdict-bml verdict))
                (int_to_str (fgsg-verdict-bmf verdict))
                (int_to_str (fgsg-verdict-form verdict))
                (int_to_str (fgsg-verdict-leakage verdict))
                (int_to_str (fgsg-verdict-model-executed? verdict))
                (int_to_str (fgsg-verdict-native-carrier-executed? verdict))
                (fmsl-bml-observation-material
                    (fgsg-verdict-bml-observation verdict))
                (fmsl-bmf-observation-material
                    (fgsg-verdict-bmf-observation verdict))
                (fmsl-form-observation-material
                    (fgsg-verdict-form-observation verdict))))))

    ; ---- nothing/0/1/failure/timeout stay typed and distinct ----------
    (defn fmsl-signal-trace-for (status)
        (if (str_eq status "value") "choice>cut>crystallize"
        (if (str_eq status "nothing") "choice>nothing>undo>refine"
        (if (str_eq status "timeout") "choice>timeout>undo>release"
            "choice>failure>undo>refine"))))
    (defn fmsl-signal (status present value)
        (list "resident-control-signal-v1" status present value
            (fmsl-signal-trace-for status)))
    (defn fmsl-signal-status (signal) (nth signal 1))
    (defn fmsl-signal-present? (signal) (nth signal 2))
    (defn fmsl-signal-value (signal) (nth signal 3))
    (defn fmsl-signal-trace (signal) (nth signal 4))
    (defn fmsl-signal-material (signal)
        (nmfe-fields (list (fmsl-signal-status signal)
            (int_to_str (fmsl-signal-present? signal))
            (int_to_str (fmsl-signal-value signal))
            (fmsl-signal-trace signal))))
    (defn fmsl-signal-valid? (signal)
        (if (not (eq (len signal) 5)) 0
        (if (not (str_eq (nth signal 0) "resident-control-signal-v1")) 0
        (do
            (let status (fmsl-signal-status signal))
            (let present (fmsl-signal-present? signal))
            (let value (fmsl-signal-value signal))
            (if (not (str_eq (fmsl-signal-trace signal)
                (fmsl-signal-trace-for status))) 0
            (if (str_eq status "value")
                (if (eq present 1) 1 0)
            (if (or (str_eq status "nothing")
                (or (str_eq status "timeout") (str_eq status "failure")))
                (if (and (eq present 0) (eq value 0)) 1 0)
                0)))))))
    (defn fmsl-signal-from-verdict (verdict)
        (if (eq (fgsg-verdict-overall verdict) 1)
            (fmsl-signal "value" 1 1)
            (fmsl-signal "failure" 0 0)))

    ; ---- two retained, non-replayable model attempts ------------------
    ; attempt = tag index role parent text text-digest candidate
    ;           candidate-digest verdict verdict-digest signal signal-digest
    ;           leakage attempt-digest
    (defn fmsl-attempt-material
        (index role parent text-digest candidate-digest verdict-digest
         signal-digest leakage)
        (nmfe-fields (list (int_to_str index) role parent text-digest
            candidate-digest verdict-digest signal-digest
            (int_to_str leakage))))
    (defn fmsl-candidate-attempt (index role parent text)
        (do
            (let candidate (fgsg-candidate-from-text text))
            (let verdict (fgsg-verify candidate (fgsg-challenge)))
            (let signal (if (nothing? candidate)
                (if (eq (str_len text) 0) (fmsl-signal "nothing" 0 0)
                    (fmsl-signal "failure" 0 0))
                (fmsl-signal-from-verdict verdict)))
            (let text-sha (fmsl-digest-sha
                (fmsl-typed-digest "model-attempt-text" text)))
            (let candidate-sha (fmsl-digest-sha
                (fmsl-typed-digest "model-candidate"
                    (fmsl-candidate-material candidate))))
            (let verdict-sha (fmsl-digest-sha
                (fmsl-typed-digest "execution-verdict"
                    (fmsl-verdict-material candidate-sha verdict))))
            (let signal-sha (fmsl-digest-sha
                (fmsl-typed-digest "control-signal"
                    (fmsl-signal-material signal))))
            (let leakage (add (fgsg-verdict-leakage verdict)
                (fgsg-material-leakage-one text)))
            (list "resident-model-attempt-v1" index role parent text
                (fmsl-typed-digest "model-attempt-text" text)
                candidate
                (fmsl-typed-digest "model-candidate"
                    (fmsl-candidate-material candidate))
                verdict
                (fmsl-typed-digest "execution-verdict"
                    (fmsl-verdict-material candidate-sha verdict))
                signal
                (fmsl-typed-digest "control-signal"
                    (fmsl-signal-material signal))
                leakage
                (fmsl-typed-digest "model-attempt"
                    (fmsl-attempt-material index role parent text-sha
                        candidate-sha verdict-sha signal-sha leakage)))))
    (defn fmsl-ack-attempt (index parent text)
        (do
            (let signal (if (str_eq text "embodied and held")
                (fmsl-signal "value" 1 1) (fmsl-signal "failure" 0 0)))
            (let text-digest (fmsl-typed-digest "model-attempt-text" text))
            (let candidate-digest (fmsl-typed-digest "model-candidate" "nothing"))
            (let verdict-digest (fmsl-typed-digest "execution-verdict" "nothing"))
            (let signal-digest (fmsl-typed-digest "control-signal"
                (fmsl-signal-material signal)))
            (let leakage (fgsg-material-leakage-one text))
            (list "resident-model-attempt-v1" index "ack" parent text
                text-digest (nothing) candidate-digest (nothing)
                verdict-digest signal signal-digest leakage
                (fmsl-typed-digest "model-attempt"
                    (fmsl-attempt-material index "ack" parent
                        (fmsl-digest-sha text-digest)
                        (fmsl-digest-sha candidate-digest)
                        (fmsl-digest-sha verdict-digest)
                        (fmsl-digest-sha signal-digest) leakage)))))
    (defn fmsl-attempt-index (attempt) (nth attempt 1))
    (defn fmsl-attempt-role (attempt) (nth attempt 2))
    (defn fmsl-attempt-parent (attempt) (nth attempt 3))
    (defn fmsl-attempt-text (attempt) (nth attempt 4))
    (defn fmsl-attempt-candidate (attempt) (nth attempt 6))
    (defn fmsl-attempt-candidate-sha (attempt)
        (fmsl-digest-sha (nth attempt 7)))
    (defn fmsl-attempt-verdict (attempt) (nth attempt 8))
    (defn fmsl-attempt-verdict-sha (attempt)
        (fmsl-digest-sha (nth attempt 9)))
    (defn fmsl-attempt-signal (attempt) (nth attempt 10))
    (defn fmsl-attempt-signal-sha (attempt)
        (fmsl-digest-sha (nth attempt 11)))
    (defn fmsl-attempt-leakage (attempt) (nth attempt 12))
    (defn fmsl-attempt-sha (attempt) (fmsl-digest-sha (nth attempt 13)))
    (defn fmsl-ack-attempt-valid? (attempt)
        (do
            (let text (fmsl-attempt-text attempt))
            (let expected (fmsl-ack-attempt (fmsl-attempt-index attempt)
                (fmsl-attempt-parent attempt) text))
            (fmsl-all? (list
                (str_eq text "embodied and held")
                (fmsl-typed-digest-valid? (nth attempt 5)
                    "model-attempt-text" text)
                (nothing? (fmsl-attempt-candidate attempt))
                (fmsl-typed-digest-valid? (nth attempt 7)
                    "model-candidate" "nothing")
                (nothing? (fmsl-attempt-verdict attempt))
                (fmsl-typed-digest-valid? (nth attempt 9)
                    "execution-verdict" "nothing")
                (fmsl-signal-valid? (fmsl-attempt-signal attempt))
                (str_eq (fmsl-attempt-signal-sha attempt)
                    (fmsl-attempt-signal-sha expected))
                (eq (fmsl-attempt-leakage attempt)
                    (fmsl-attempt-leakage expected))
                (str_eq (fmsl-attempt-sha attempt)
                    (fmsl-attempt-sha expected))))))
    (defn fmsl-candidate-attempt-valid? (attempt)
        (do
            (let text (fmsl-attempt-text attempt))
            (let parsed (fgsg-candidate-from-text text))
            (let expected (fmsl-candidate-attempt
                (fmsl-attempt-index attempt) (fmsl-attempt-role attempt)
                (fmsl-attempt-parent attempt) text))
            (fmsl-all? (list
                (if (nothing? parsed) 0 1)
                (eq (fgsg-candidate? (fmsl-attempt-candidate attempt)) 1)
                (fmsl-typed-digest-valid? (nth attempt 5)
                    "model-attempt-text" text)
                (fmsl-typed-digest-valid? (nth attempt 7)
                    "model-candidate"
                    (fmsl-candidate-material
                        (fmsl-attempt-candidate attempt)))
                (str_eq (fmsl-attempt-candidate-sha attempt)
                    (fmsl-attempt-candidate-sha expected))
                (fmsl-typed-digest-valid? (nth attempt 9)
                    "execution-verdict"
                    (fmsl-verdict-material
                        (fmsl-attempt-candidate-sha attempt)
                        (fmsl-attempt-verdict attempt)))
                (str_eq (fmsl-attempt-verdict-sha attempt)
                    (fmsl-attempt-verdict-sha expected))
                (fmsl-signal-valid? (fmsl-attempt-signal attempt))
                (str_eq (fmsl-attempt-signal-sha attempt)
                    (fmsl-attempt-signal-sha expected))
                (eq (fmsl-attempt-leakage attempt)
                    (fmsl-attempt-leakage expected))
                (str_eq (fmsl-attempt-sha attempt)
                    (fmsl-attempt-sha expected))))))
    (defn fmsl-attempt-valid? (attempt)
        (if (not (eq (len attempt) 14)) 0
        (if (not (str_eq (nth attempt 0) "resident-model-attempt-v1")) 0
        (if (str_eq (fmsl-attempt-role attempt) "ack")
            (fmsl-ack-attempt-valid? attempt)
        (if (or (str_eq (fmsl-attempt-role attempt) "candidate")
                (str_eq (fmsl-attempt-role attempt) "refinement"))
            (fmsl-candidate-attempt-valid? attempt)
            0)))))

    ; ---- candidate-specific supervised BML repair --------------------
    (defn fmsl-bml-repair-source ()
        "int Shift(int n) { return n + 8; }\nreturn Shift(65);\n")
    (defn fmsl-bml-repair (failed-attempt)
        (do
            (let source (fmsl-bml-repair-source))
            (let observed (fgsg-bml-observe source))
            (list "resident-bml-supervised-repair-v1"
                (fmsl-attempt-candidate-sha failed-attempt)
                (fmsl-typed-digest "failed-attempt"
                    (fmsl-attempt-sha failed-attempt))
                source (fmsl-typed-digest "repair-bml-source" source)
                (nth observed 3) (nth observed 5)
                (fgsg-bml-pass? observed (fgsg-challenge))
                (fgsg-material-leakage-one source)
                "supervised-embodiment" 0)))
    (defn fmsl-bml-repair-valid? (failed-attempt repair)
        (if (not (eq (len repair) 11)) 0
        (if (not (str_eq (nth repair 0)
            "resident-bml-supervised-repair-v1")) 0
        (do
            (let expected (fmsl-bml-repair failed-attempt))
            (fmsl-all? (list
                (eq (fmsl-attempt-valid? failed-attempt) 1)
                (eq (fgsg-verdict-bml
                    (fmsl-attempt-verdict failed-attempt)) 0)
                (str_eq (nth repair 1) (nth expected 1))
                (fmsl-typed-digest-valid? (nth repair 2) "failed-attempt"
                    (fmsl-attempt-sha failed-attempt))
                (str_eq (nth repair 3) (fmsl-bml-repair-source))
                (fmsl-typed-digest-valid? (nth repair 4)
                    "repair-bml-source" (nth repair 3))
                (eq (nth repair 5) 73)
                (eq (nth repair 6) 73)
                (eq (nth repair 7) 1)
                (eq (nth repair 8) 0)
                (str_eq (nth repair 9) "supervised-embodiment")
                (eq (nth repair 10) 0)))))))

    ; ---- exact check frame binds candidate + verdict + signal --------
    (defn fmsl-check-frame (attempt)
        (do
            (let verdict (fmsl-attempt-verdict attempt))
            (let failed-bml (if (eq (fgsg-verdict-bml verdict) 0)
                (fmsl-bml-repair attempt) (nothing)))
            (fmsl-cat (list
                "<|form:resident-check|>\nversion=resident-multi-skill-v2"
                "\nattempt=" (int_to_str (fmsl-attempt-index attempt))
                "\nattempt-digest=" (fmsl-attempt-sha attempt)
                "\ncandidate-digest=" (fmsl-attempt-candidate-sha attempt)
                "\nverdict-digest=" (fmsl-attempt-verdict-sha attempt)
                "\nsignal-digest=" (fmsl-attempt-signal-sha attempt)
                "\noverall=" (int_to_str (fgsg-verdict-overall verdict))
                "\nbml=" (int_to_str (fgsg-verdict-bml verdict))
                "\nbmf=" (int_to_str (fgsg-verdict-bmf verdict))
                "\nform=" (int_to_str (fgsg-verdict-form verdict))
                "\nleakage=" (int_to_str (fmsl-attempt-leakage attempt))
                (if (nothing? failed-bml) ""
                    (fmsl-cat (list
                        "\nrepair-lane=supervised-embodiment"
                        "\nheldout-generative-mastery=0"
                        "\nfailed-candidate-digest=" (nth failed-bml 1)
                        "\naccepted-bml-source-sha="
                            (fmsl-digest-sha (nth failed-bml 4))
                        "\naccepted-bml-direct=" (int_to_str (nth failed-bml 5))
                        "\naccepted-bml-lowered=" (int_to_str (nth failed-bml 6))
                        "\naccepted-bml-source:\n" (nth failed-bml 3))))
                "\nnext=" (if (eq (fgsg-verdict-overall verdict) 1)
                    "reply exactly embodied and held"
                    "undo and refine the exact failed candidate")
                "\n<|/form:resident-check|>"))))
    (defn fmsl-check-valid? (attempt frame)
        (if (not (eq (fmsl-attempt-valid? attempt) 1)) 0
        (if (not (str_eq frame (fmsl-check-frame attempt))) 0
        (if (not (eq (str_find frame "<|form:resident-check|>" 0) 0)) 0
        (if (not (ge (str_find frame "\nattempt-digest=" 0) 0)) 0
        (if (not (ge (str_find frame "\nverdict-digest=" 0) 0)) 0
            (if (ge (str_find frame "<|/form:resident-check|>" 0) 0) 1 0)))))))

    ; ---- opaque resident handles and monotone ledger -----------------
    (defn fmsl-snapshot (session)
        (list "resident-session-snapshot-v1" (fcms-status session)
            (fcms-reason session) (head (fcms-ctx session))
            (head (fcms-sts session)) (fcms-maxpos session)
            (fcms-pos session) (fcms-pending session) (fcms-stopped? session)
            (fcms-prompt-ids session) (fcms-generated-ids session)
            (fcms-injected-ids session) (fcms-observations session)))
    (defn fmsl-snapshot-same? (a b)
        (if (and (node_eq (nth a 3) (nth b 3))
            (and (node_eq (nth a 4) (nth b 4))
            (and (eq (nth a 5) (nth b 5))
            (and (eq (nth a 6) (nth b 6))
            (and (eq (nth a 7) (nth b 7))
            (and (eq (nth a 8) (nth b 8))
            (and (eq (nth a 9) (nth b 9))
            (and (eq (nth a 10) (nth b 10))
            (and (eq (nth a 11) (nth b 11))
                 (eq (nth a 12) (nth b 12))))))))))) 1 0))
    (defn fmsl-snapshot-step? (a b observations generated injection)
        (if (not (and (eq (len a) 13) (eq (len b) 13))) 0
        (if (not (and (str_eq (nth a 0) "resident-session-snapshot-v1")
            (str_eq (nth b 0) "resident-session-snapshot-v1"))) 0
        (fmsl-all? (list
            (str_eq (nth a 1) "live") (str_eq (nth b 1) "live")
            (node_eq (nth a 3) (nth b 3))
            (node_eq (nth a 4) (nth b 4))
            (eq (nth a 5) (nth b 5))
            (eq (nth a 9) (nth b 9))
            (ge (nth b 6) (nth a 6))
            (ge (nth b 10) (nth a 10))
            (ge (nth b 11) (nth a 11))
            (eq (nth b 12) (add (nth a 12) observations))
            (if (eq generated 1)
                (if (gt (nth b 10) (nth a 10)) 1 0)
                (if (eq (nth b 10) (nth a 10)) 1 0))
            (if (eq injection 1)
                (if (gt (nth b 11) (nth a 11)) 1 0)
                (if (eq (nth b 11) (nth a 11)) 1 0)))))))

    ; finalization retains the optional fourth check and exact final ack.
    (defn fmsl-finalization
        (branch final-check ack-text final-checked acknowledged)
        (list "resident-finalization-v1" branch final-check ack-text
            (fmsl-typed-digest "success-ack" ack-text)
            final-checked acknowledged))
    (defn fmsl-finalization-branch (row) (nth row 1))
    (defn fmsl-finalization-check (row) (nth row 2))
    (defn fmsl-finalization-ack (row) (nth row 3))
    (defn fmsl-finalization-checked (row) (nth row 5))
    (defn fmsl-finalization-acknowledged (row) (nth row 6))

    ; skill evidence distinguishes unassisted held-out generation from an
    ; exact supervised repair.  Neither claims execution inside the model.
    (defn fmsl-skill-evidence (attempt lane)
        (list "resident-skill-evidence-v1" lane
            (if (str_eq lane "independent-generative") 0 1)
            (if (str_eq lane "independent-generative") 1 0)
            (fmsl-attempt-candidate-sha attempt)
            (fmsl-attempt-verdict-sha attempt)
            (fmsl-attempt-verdict attempt) 0 0))
    (defn fmsl-skill-evidence-valid? (evidence attempt lane)
        (if (not (eq (len evidence) 9)) 0
        (if (not (str_eq (nth evidence 0)
            "resident-skill-evidence-v1")) 0
            (fmsl-all? (list
                (str_eq (nth evidence 1) lane)
                (eq (nth evidence 2)
                    (if (str_eq lane "independent-generative") 0 1))
                (eq (nth evidence 3)
                    (if (str_eq lane "independent-generative") 1 0))
                (str_eq (nth evidence 4)
                    (fmsl-attempt-candidate-sha attempt))
                (str_eq (nth evidence 5)
                    (fmsl-attempt-verdict-sha attempt))
                (eq (fgsg-verdict-overall (nth evidence 6)) 1)
                (eq (nth evidence 7) 0)
                (eq (nth evidence 8) 0))))))

    ; loop = six base snapshots, exact bindings, two attempts, optional final
    ; check/ack snapshots, and explicit physical release evidence.
    (defn fmsl-loop
        (opened knowledge taught generated checked resumed
         knowledge-evidence skill-evidence signal knowledge-frame teach-frame
         check-frame attempt-one attempt-two finalization
         open-count reencoded release)
        (list "resident-multi-skill-loop-v2" opened knowledge taught generated
            checked resumed knowledge-evidence skill-evidence signal
            knowledge-frame teach-frame check-frame attempt-one attempt-two
            finalization open-count reencoded release))
    (defn fmsl-loop-valid? (loop)
        (if (not (eq (len loop) 19)) 0
        (if (not (str_eq (nth loop 0) "resident-multi-skill-loop-v2")) 0
        (do
            (let opened (nth loop 1))
            (let knowledge (nth loop 2))
            (let taught (nth loop 3))
            (let generated (nth loop 4))
            (let checked (nth loop 5))
            (let resumed (nth loop 6))
            (let knowledge-evidence (nth loop 7))
            (let skill-evidence (nth loop 8))
            (let signal (nth loop 9))
            (let knowledge-frame (nth loop 10))
            (let teach-frame (nth loop 11))
            (let check-frame (nth loop 12))
            (let attempt-one (nth loop 13))
            (let attempt-two (nth loop 14))
            (let finalization (nth loop 15))
            (let branch (fmsl-finalization-branch finalization))
            (let first-pass (eq (fgsg-verdict-overall
                (fmsl-attempt-verdict attempt-one)) 1))
            (let final-attempt (if first-pass attempt-one attempt-two))
            (let lane (if first-pass "independent-generative"
                "supervised-embodiment"))
            (let final-checked (fmsl-finalization-checked finalization))
            (let acknowledged
                (fmsl-finalization-acknowledged finalization))
            (fmsl-all? (list
                (fmsl-knowledge-evidence-valid? knowledge-evidence)
                (str_eq knowledge-frame
                    (fmsl-kb-frame (fmsl-ke-binding knowledge-evidence)))
                (fmsl-teaching-bound?
                    (fmsl-kb-concept (fmsl-ke-binding knowledge-evidence))
                    teach-frame)
                (fmsl-attempt-valid? attempt-one)
                (fmsl-attempt-valid? attempt-two)
                (eq (fmsl-attempt-index attempt-one) 1)
                (str_eq (fmsl-attempt-role attempt-one) "candidate")
                (str_eq (fmsl-attempt-parent attempt-one) "root")
                (eq (fmsl-attempt-index attempt-two) 2)
                (str_eq (fmsl-attempt-parent attempt-two)
                    (nmfe-sha256 check-frame))
                (eq (fmsl-attempt-leakage attempt-one) 0)
                (eq (fmsl-attempt-leakage attempt-two) 0)
                (str_eq check-frame (fmsl-check-frame attempt-one))
                (fmsl-check-valid? attempt-one check-frame)
                (str_eq branch (if first-pass "first-pass"
                    "supervised-refinement"))
                (str_eq (fmsl-attempt-role attempt-two)
                    (if first-pass "ack" "refinement"))
                (if first-pass 1
                    (eq (fgsg-verdict-overall
                        (fmsl-attempt-verdict attempt-two)) 1))
                (str_eq (fmsl-finalization-check finalization)
                    (if first-pass check-frame
                        (fmsl-check-frame attempt-two)))
                (fmsl-check-valid? final-attempt
                    (fmsl-finalization-check finalization))
                (str_eq (fmsl-finalization-ack finalization)
                    "embodied and held")
                (fmsl-typed-digest-valid? (nth finalization 4)
                    "success-ack" "embodied and held")
                (fmsl-skill-evidence-valid? skill-evidence
                    final-attempt lane)
                (fmsl-signal-valid? signal)
                (str_eq (fmsl-signal-material signal)
                    (fmsl-signal-material
                        (fmsl-attempt-signal final-attempt)))
                (eq (fmsl-signal-present? signal) 1)
                (eq (fmsl-signal-value signal) 1)
                (fmsl-snapshot-step? opened knowledge 1 1 1)
                (fmsl-snapshot-step? knowledge taught 1 0 1)
                (fmsl-snapshot-step? taught generated 0 1 0)
                (fmsl-snapshot-step? generated checked 1 0 1)
                (fmsl-snapshot-step? checked resumed 0 1 0)
                (if first-pass
                    (fmsl-all? (list
                        (eq (fmsl-snapshot-same? checked final-checked) 1)
                        (eq (fmsl-snapshot-same? resumed acknowledged) 1)))
                    (fmsl-all? (list
                        (eq (fmsl-snapshot-same? resumed final-checked) 0)
                        (eq (fmsl-snapshot-step? resumed final-checked 1 0 1) 1)
                        (eq (fmsl-snapshot-step? final-checked acknowledged
                            0 1 0) 1))))
                (eq (nth loop 16) 1)
                (eq (nth loop 17) 0)
                (eq (nth loop 18) 1)))))))

0
