//////////////////////////////////////////////////////////////////////
// lora-voice.bml — the body's teacher material as chat rows, written by
// the body itself: every corpus row (the question it could not answer,
// the fresh word that answered it) and every receipt section (Sema's own
// voice), one JSON line each, split ten-to-one into train and valid.
//
// Training and adapter asking use the same native 3B model and full LoRA layers.
// The adapterless routed ask retains the native dense 1B door.
// The supervisor exposes actual process exits and per-stage learning events.
import form/form-stdlib/core.fk;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/line-grammar.fk;
import form/form-stdlib/spool-bell-transport.fk;
import learn/homecoming-distillation-corpus.fk;
import form/form-stdlib/native-ask.bml;
import form/form-stdlib/native-lora-worker.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraVoice {
        field LVData = ".form-lora-voice-native";
        field LVIters = 600;
        def lv-cat(parts) = if ((Comparable) len(parts) == 0) then "" else ((String) parts[0] + lv-cat(parts[1:]));
        def lv-q() = byte_to_str(34);
        def lv-esc-byte(c) = if ((Comparable) c == 34) then ((String) byte_to_str(92) + lv-q()) else if ((Comparable) c == 92) then ((String) byte_to_str(92) + byte_to_str(92)) else if ((Comparable) c == 10) then (byte_to_str(92) + "n") else if ((Comparable) c == 9) then (byte_to_str(92) + "t") else if (c < 32) then " " else byte_to_str(c);
        def lv-esc-go(s, i, acc) = if (i >= len(s)) then acc else lv-esc-go(s, (i + 1), ((String) acc + lv-esc-byte(str_byte_at(s, i))));
        def lv-esc(s) = lv-esc-go(s, 0, "");
        def lv-row(user, assistant) = lv-cat(["{", lv-q(), "messages", lv-q(), ":[{", lv-q(), "role", lv-q(), ":", lv-q(), "user", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(user), lv-q(), "},{", lv-q(), "role", lv-q(), ":", lv-q(), "assistant", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(assistant), lv-q(), "}]}", byte_to_str(10)]);
        def lv-join(ws) = if ((Comparable) len(ws) == 0) then "" else if ((Comparable) len(ws[1:]) == 0) then ws[0] else (ws[0] + (" " + lv-join(ws[1:])));
        def lv-corpus-row(r) = lv-row(lv-cat(["The body asks the smallest question it cannot yet answer natively: ", lv-join(r[2]), "?"]), lv-cat([r[4], ". The word the body did not have for ", lv-join(r[2]), "; offered ", r[1].str(), " by ", r[5], "."]));
        def lv-split-path(data, i) = ((String) data + (if ((Comparable) (i % 10) == 0) then "/valid.jsonl" else "/train.jsonl"));
        def lv-put(data, i, line) = sbt-append(lv-split-path(data, i), line);
        def lv-corpus-emit(data, rows, i) = if ((Comparable) len(rows) == 0) then i else lv-corpus-emit-next(data, rows[1:], (i + 1), lv-put(data, i, lv-corpus-row(rows[0])));
        def lv-corpus-emit-next(data, rows, i, wrote) = lv-corpus-emit(data, rows, i);
        def lv-title(text) = trim(substring(text, 0, if (str_find(text, byte_to_str(10), 0) < 0) then len(text) else str_find(text, byte_to_str(10), 0)));
        def lv-strip-hash(t) = if ((len(t) > 0) && ((Comparable) str_byte_at(t, 0) == 35)) then lv-strip-hash(substring(t, 1, len(t))) else trim(t);
        def lv-section-row(title, sec) {
            let nl = str_find(sec, byte_to_str(10), 0);
            let head = if (nl < 0) then trim(sec) else trim(substring(sec, 0, nl));
            let body = if (nl < 0) then "" else trim(substring(sec, (nl + 1), len(sec)));
            if ((len(body) < 80) || (len(body) > 1800)) then "" else lv-row(lv-cat(["From the receipt ", lv-q(), title, lv-q(), ", speak the section ", lv-q(), head, lv-q(), " in Sema", byte_to_str(39), "s voice."]), body);
        }
        def lv-sections-emit(data, title, secs, i) = if ((Comparable) len(secs) == 0) then i else lv-sections-emit-one(data, title, secs, i, lv-section-row(title, secs[0]));
        def lv-sections-emit-one(data, title, secs, i, line) = if ((Comparable) len(line) == 0) then lv-sections-emit(data, title, secs[1:], i) else lv-sections-emit-next(data, title, secs[1:], (i + 1), lv-put(data, i, line));
        def lv-sections-emit-next(data, title, secs, i, wrote) = lv-sections-emit(data, title, secs, i);
        def lv-receipt-emit(data, path, i) {
            let text = read_file(path);
            if nothing?(text) then i else lv-sections-emit(data, lv-strip-hash(lv-title(text)), split-on(text, (byte_to_str(10) + "## "))[1:], i);
        }
        def lv-receipts-emit(data, dir, names, i) = if ((Comparable) len(names) == 0) then i else lv-receipts-emit(data, dir, names[1:], lv-receipt-emit(data, fs-path-join(dir, names[0]), i));
        // the git history: every landing is a teaching, dated and attributed; one host
        // read of the log (records on byte 30, fields on byte 31), parsed natively.
        //
        // git ITSELF stays a crossing, and the reason is measured rather than assumed:
        // its object store is zlib-deflated and this body carries no inflate, so nothing
        // here can read a commit body that git cannot. What came home is the SHELL that
        // stood around it. host_spawn_at execs the argument list itself — no quoting to
        // get wrong, and git's own voice lands in a file instead of being swallowed —
        // and the log goes to a path named after this process's pid, because siblings
        // share /tmp. Measured on this Mac 2026-09-09: 3,581,274 bytes, byte-identical
        // to the shell's answer, 36 ms against 40.
        //
        // The OTHER shell-free door cannot carry this read, and that is why the pipe is
        // a file. host_capture answers out of a 1 MiB static buffer: asked for the same
        // log it returned 1,048,575 bytes and no refusal, losing 2,532,699 of the body's
        // own history silently. A crossing that tells the truth beats a native that
        // does not.
        def lv-rs() = byte_to_str(30);
        def lv-fs() = byte_to_str(31);
        def lv-git-argv() = ["git", "log", "--no-merges", "--format=%h%x1f%ad%x1f%an%x1f%s%x1f%b%x1e", "--date=short"];
        def lv-git-out() = ("/tmp/lora-voice-history-" + (host_pid().str() + ".txt"));
        def lv-git-err() = (lv-git-out() + ".err");
        def lv-git-row(rec) {
            let f = split-on(rec, lv-fs());
            if (len(f) < 5) then "" else if (len(f[3]) < 12) then "" else lv-row(lv-cat(["From the landing ", trim(f[1]), " ", trim(f[0]), " by ", trim(f[2]), ", speak what landed and why."]), lv-cat([trim(f[3]), if (len(trim(f[4])) < 20) then "" else ((String) byte_to_str(10) + substring(trim(f[4]), 0, if (len(trim(f[4])) > 1600) then 1600 else len(trim(f[4]))))]));
        }
        def lv-git-emit(data, recs, i) = if ((Comparable) len(recs) == 0) then i else lv-git-emit-one(data, recs[1:], i, lv-git-row(recs[0]));
        def lv-git-emit-one(data, recs, i, line) = if ((Comparable) len(line) == 0) then lv-git-emit(data, recs, i) else lv-git-emit-next(data, recs, (i + 1), lv-put(data, i, line));
        def lv-git-emit-next(data, recs, i, wrote) = lv-git-emit(data, recs, i);
        // a refusal is not a pid: the door judges the argv and the three redirects
        // before it forks, so a history that could not be read answers a negative
        // number here and emits no rows rather than half of them
        def lv-git-read(pid) = if (pid < 0) then "" else lv-git-waited(host_wait(pid));
        def lv-git-waited(w) = read_file_slice_or_empty(read_file(lv-git-out()));
        def lv-history-emit(data, i) {
            let stale = fs-remove-file(lv-git-out());
            let text = lv-git-read(host_spawn_at(lv-git-argv(), ["/dev/null", lv-git-out(), lv-git-err()]));
            let n = lv-git-emit(data, split-on(text, lv-rs()), i);
            let spent = fs-remove-file(lv-git-out());
            let voice = fs-remove-file(lv-git-err());
            n;
        }
        def read_file_slice_or_empty(t) = if nothing?(t) then "" else t;
        def lv-emit(data) {
            let made = fs-mkdir(data);
            let c1 = fs-remove-file((data + "/train.jsonl"));
            let c2 = fs-remove-file((data + "/valid.jsonl"));
            let ncorpus = lv-corpus-emit(data, hdc-rows(), 1);
            let nr = lv-receipts-emit(data, "receipts", fs-list("receipts"), ncorpus);
            let nh = lv-history-emit(data, nr);
            let nd = lv-distill-emit(data, nh);
            let np = lv-perception-emit(data, nd);
            let n = lv-rumi-emit(data, np);
            [(ncorpus - 1), (nr - ncorpus), (nh - nr), (n - 1), (np - nd)];
        }
        def lv-model() = mr-path(mr-find("llama32-3b-mlx-4bit"));
        field LVMaxTokens = 0;
        field LVTracked = "form/form-stdlib/adapters/llama-3.2-3b-voice";
        def lv-adapter-path(data) = if (file_size((data + "/adapter/native-current")) > 0) then (data + "/adapter") else if (file_size((data + "/adapter/adapters.safetensors")) > 0) then (data + "/adapter") else LVTracked();
        def lv-training?(data) = nlw-running(data);
        def lv-train-request(data,model,iters) = ntr-request(model,lv-adapter-path(data),data,(data + "/adapter"),iters,4,0.0001,0,8);
        def lv-launch(data,iters) = nlw-launch(lv-train-request(data,lv-model(),iters),data)[0];
        def lv-txt(t) = if nothing?(t) then "" else t;
        def lv-said(raw) = trim(lv-txt(raw));
        // The 1B comparison door keeps its own identity. Both school samples below
        // use the exact same 3B base, with only adapter ownership changing.
        def lv-native-lane() = "native-dense-llama32-1b-on-metal";
        def lv-model-lane() = "native-affine-llama32-3b-on-metal";
        def lv-lora-lane() = "native-lora-llama32-3b-on-metal";
        def lv-route(adapter) = if ((Comparable) len(adapter) == 0) then "native" else "native-lora";
        def lv-route-why(adapter) = if ((Comparable) len(adapter) == 0) then "the native dense 1B asking door" else ("the adapter's 3B base and full LoRA on native Metal: " + adapter);
        def lv-events() = (".hearth/native-voice-" + (host_pid().str() + ".jsonl"));
        def lv-model-ask-r(adapter,prompt,maxTokens) {
            if (file_size((lv-model() + "/model.safetensors")) <= 0) then ["","no-local-checkpoint",lv-model-lane()]
            else if ((len(adapter) > 0) && (file_size((nag-resolve(adapter) + "/adapters.safetensors")) <= 0)) then ["","no-adapter",lv-lora-lane()]
            else lv-r-model(nlg-once(lv-model(),adapter,prompt,maxTokens,"","",lv-events()));
        }
        def lv-lora-ask-r(adapter,prompt,maxTokens) = lv-r-lora(lv-model-ask-r(adapter,prompt,maxTokens));
        def lv-ask-r(adapter,prompt,maxTokens) = if ((Comparable) len(adapter) == 0) then lv-r-native(na-chat-ask(prompt,if ((Comparable) maxTokens == 0) then NAPositions() else maxTokens)) else lv-lora-ask-r(adapter,prompt,maxTokens);
        def lv-r-model(r) = [r[0],r[1],lv-model-lane()];
        def lv-r-lora(r) = [r[0],r[1],lv-lora-lane()];
        def lv-r-native(r) = [na-said(r),na-why(r),lv-native-lane()];
        def lv-r-said(r) = r[0];
        def lv-r-why(r) = r[1];
        def lv-r-lane(r) = r[2];
        def lv-r-answered?(r) = ((Comparable) len(r[1]) == 0);
        def lv-complete(r) = if lv-r-answered?(r) then lv-r-said(r) else nothing();
        def lv-model-ask(data,prompt,withAdapter) = lv-model-ask-n(data,prompt,withAdapter,LVMaxTokens());
        def lv-model-ask-at(adapter,prompt,maxTokens) = lv-complete(lv-model-ask-r(adapter,prompt,maxTokens));
        def lv-model-ask-n(data,prompt,withAdapter,maxTokens) = lv-model-ask-at(if ((Comparable) withAdapter == 1) then lv-adapter-path(data) else "",prompt,maxTokens);
        def lv-ask(data,prompt,withAdapter) = lv-ask-n(data,prompt,withAdapter,LVMaxTokens());
        def lv-ask-at(adapter,prompt,maxTokens) = lv-complete(lv-ask-r(adapter,prompt,maxTokens));
        def lv-ask-n(data,prompt,withAdapter,maxTokens) = lv-ask-at(if ((Comparable) withAdapter == 1) then lv-adapter-path(data) else "",prompt,maxTokens);
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceDistill {
        // rows the resident taught (distill.jsonl) fold into TRAIN only; the held-out set stays the judge
        def lv-distill-lines(data) = split-on(read_file_slice_or_empty(read_file((data + "/distill.jsonl"))), byte_to_str(10));
        def lv-distill-emit-go(data, lines, i) = if ((Comparable) len(lines) == 0) then i else if (len(lines[0]) < 20) then lv-distill-emit-go(data, lines[1:], i) else lv-distill-emit-next(data, lines[1:], (i + 1), sbt-append((data + "/train.jsonl"), ((String) lines[0] + byte_to_str(10))));
        def lv-distill-emit-next(data, lines, i, wrote) = lv-distill-emit-go(data, lines, i);
        def lv-distill-emit(data, i) = lv-distill-emit-go(data, lv-distill-lines(data), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoicePerception {
        // the rows the body wrote from what it perceived (perception.jsonl)
        // fold into TRAIN only, like the distilled and the Rumi rows: the
        // held-out set stays corpus questions, so a room cannot grade itself
        def lv-perception-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file((data + "/perception.jsonl"))), byte_to_str(10)), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceRumi {
        // Rumi continuation rows (rumi.jsonl) fold into TRAIN only, like the distilled rows
        def lv-rumi-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file((data + "/rumi.jsonl"))), byte_to_str(10)), i);
    }
    0;
}
