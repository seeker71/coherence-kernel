//////////////////////////////////////////////////////////////////////
// lora-voice.bml — the body's teacher material as chat rows, written by
// the body itself: every corpus row (the question it could not answer,
// the fresh word that answered it) and every receipt section (Sema's own
// voice), one JSON line each, split ten-to-one into train and valid.
//
// One crossing remains, and it is named where it is: the TRAINER
// (mlx_lm on this Mac) until native training callers replace it.
// An ask with no adapter goes to `native-ask.bml` (llama32-1b dense).
// An ask WEARING an adapter goes to `native-llama-voice.bml` (llama32-3b
// LoRA on Metal). `lv-cross-ask` keeps the mlx generate membrane for
// side-by-side grades. `lv-route` answers which door an ask takes and
// `lv-route-why` says why.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/spool-bell-transport.fk learn/homecoming-distillation-corpus.fk form/form-stdlib/native-ask.bml form/form-stdlib/native-llama-voice.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraVoice {
        field LVData = ".form-lora-voice-native";
        field LVVenv = "/Users/ursmuff/.mlx-venv";
        field LVModelDir = "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--Llama-3.2-3B-Instruct-4bit/snapshots";
        field LVIters = 600;
        def lv-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), lv-cat(tail(parts)));
        def lv-q() = byte_to_str(34);
        def lv-esc-byte(c) = if eq(c, 34) then str_concat(byte_to_str(92), lv-q()) else if eq(c, 92) then str_concat(byte_to_str(92), byte_to_str(92)) else if eq(c, 10) then str_concat(byte_to_str(92), "n") else if eq(c, 9) then str_concat(byte_to_str(92), "t") else if lt(c, 32) then " " else byte_to_str(c);
        def lv-esc-go(s, i, acc) = if ge(i, str_len(s)) then acc else lv-esc-go(s, add(i, 1), str_concat(acc, lv-esc-byte(str_byte_at(s, i))));
        def lv-esc(s) = lv-esc-go(s, 0, "");
        def lv-row(user, assistant) = lv-cat(list("{", lv-q(), "messages", lv-q(), ":[{", lv-q(), "role", lv-q(), ":", lv-q(), "user", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(user), lv-q(), "},{", lv-q(), "role", lv-q(), ":", lv-q(), "assistant", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(assistant), lv-q(), "}]}", byte_to_str(10)));
        def lv-join(ws) = if eq(len(ws), 0) then "" else if eq(len(tail(ws)), 0) then head(ws) else str_concat(head(ws), str_concat(" ", lv-join(tail(ws))));
        def lv-corpus-row(r) = lv-row(lv-cat(list("The body asks the smallest question it cannot yet answer natively: ", lv-join(nth(r, 2)), "?")), lv-cat(list(nth(r, 4), ". The word the body did not have for ", lv-join(nth(r, 2)), "; offered ", int_to_str(nth(r, 1)), " by ", nth(r, 5), ".")));
        def lv-split-path(data, i) = str_concat(data, if eq(mod(i, 10), 0) then "/valid.jsonl" else "/train.jsonl");
        def lv-put(data, i, line) = sbt-append(lv-split-path(data, i), line);
        def lv-corpus-emit(data, rows, i) = if eq(len(rows), 0) then i else lv-corpus-emit-next(data, tail(rows), add(i, 1), lv-put(data, i, lv-corpus-row(head(rows))));
        def lv-corpus-emit-next(data, rows, i, wrote) = lv-corpus-emit(data, rows, i);
        def lv-title(text) = trim(substring(text, 0, if lt(str_find(text, byte_to_str(10), 0), 0) then str_len(text) else str_find(text, byte_to_str(10), 0)));
        def lv-strip-hash(t) = if and(gt(str_len(t), 0), eq(str_byte_at(t, 0), 35)) then lv-strip-hash(substring(t, 1, str_len(t))) else trim(t);
        def lv-section-row(title, sec) {
            let nl = str_find(sec, byte_to_str(10), 0);
            let head = if lt(nl, 0) then trim(sec) else trim(substring(sec, 0, nl));
            let body = if lt(nl, 0) then "" else trim(substring(sec, add(nl, 1), str_len(sec)));
            if or(lt(str_len(body), 80), gt(str_len(body), 1800)) then "" else lv-row(lv-cat(list("From the receipt ", lv-q(), title, lv-q(), ", speak the section ", lv-q(), head, lv-q(), " in Sema", byte_to_str(39), "s voice.")), body);
        }
        def lv-sections-emit(data, title, secs, i) = if eq(len(secs), 0) then i else lv-sections-emit-one(data, title, secs, i, lv-section-row(title, head(secs)));
        def lv-sections-emit-one(data, title, secs, i, line) = if eq(str_len(line), 0) then lv-sections-emit(data, title, tail(secs), i) else lv-sections-emit-next(data, title, tail(secs), add(i, 1), lv-put(data, i, line));
        def lv-sections-emit-next(data, title, secs, i, wrote) = lv-sections-emit(data, title, secs, i);
        def lv-receipt-emit(data, path, i) {
            let text = read_file(path);
            if nothing?(text) then i else lv-sections-emit(data, lv-strip-hash(lv-title(text)), tail(split-on(text, str_concat(byte_to_str(10), "## "))), i);
        }
        def lv-receipts-emit(data, dir, names, i) = if eq(len(names), 0) then i else lv-receipts-emit(data, dir, tail(names), lv-receipt-emit(data, fs-path-join(dir, head(names)), i));
        // the git history: every landing is a teaching, dated and attributed; one host
        // read of the log (records on byte 30, fields on byte 31), parsed natively.
        //
        // git ITSELF stays a crossing, and the reason is measured rather than assumed:
        // its object store is zlib-deflated and this body carries no inflate, so nothing
        // here can read a commit body that git cannot. What came home is the SHELL that
        // stood around it. host_spawn_at execs the argument list itself — no quoting to
        // get wrong, and git's own voice lands in a file instead of being swallowed —
        // and the log goes to a path named after this process's pid, because siblings
        // share /tmp. Measured on this Mac 2026-09-09: 3,581,274 bytes, byte-identical
        // to the shell's answer, 36 ms against 40.
        //
        // The OTHER shell-free door cannot carry this read, and that is why the pipe is
        // a file. host_capture answers out of a 1 MiB static buffer: asked for the same
        // log it returned 1,048,575 bytes and no refusal, losing 2,532,699 of the body's
        // own history silently. A crossing that tells the truth beats a native that
        // does not.
        def lv-rs() = byte_to_str(30);
        def lv-fs() = byte_to_str(31);
        def lv-git-argv() = list("git", "log", "--no-merges", "--format=%h%x1f%ad%x1f%an%x1f%s%x1f%b%x1e", "--date=short");
        def lv-git-out() = str_concat("/tmp/lora-voice-history-", str_concat(int_to_str(host_pid()), ".txt"));
        def lv-git-err() = str_concat(lv-git-out(), ".err");
        def lv-git-row(rec) {
            let f = split-on(rec, lv-fs());
            if lt(len(f), 5) then "" else if lt(str_len(nth(f, 3)), 12) then "" else lv-row(lv-cat(list("From the landing ", trim(nth(f, 1)), " ", trim(nth(f, 0)), " by ", trim(nth(f, 2)), ", speak what landed and why.")), lv-cat(list(trim(nth(f, 3)), if lt(str_len(trim(nth(f, 4))), 20) then "" else str_concat(byte_to_str(10), substring(trim(nth(f, 4)), 0, if gt(str_len(trim(nth(f, 4))), 1600) then 1600 else str_len(trim(nth(f, 4))))))));
        }
        def lv-git-emit(data, recs, i) = if eq(len(recs), 0) then i else lv-git-emit-one(data, tail(recs), i, lv-git-row(head(recs)));
        def lv-git-emit-one(data, recs, i, line) = if eq(str_len(line), 0) then lv-git-emit(data, recs, i) else lv-git-emit-next(data, recs, add(i, 1), lv-put(data, i, line));
        def lv-git-emit-next(data, recs, i, wrote) = lv-git-emit(data, recs, i);
        // a refusal is not a pid: the door judges the argv and the three redirects
        // before it forks, so a history that could not be read answers a negative
        // number here and emits no rows rather than half of them
        def lv-git-read(pid) = if lt(pid, 0) then "" else lv-git-waited(host_wait(pid));
        def lv-git-waited(w) = read_file_slice_or_empty(read_file(lv-git-out()));
        def lv-history-emit(data, i) {
            let stale = fs-remove-file(lv-git-out());
            let text = lv-git-read(host_spawn_at(lv-git-argv(), list("/dev/null", lv-git-out(), lv-git-err())));
            let n = lv-git-emit(data, split-on(text, lv-rs()), i);
            let spent = fs-remove-file(lv-git-out());
            let voice = fs-remove-file(lv-git-err());
            n;
        }
        def read_file_slice_or_empty(t) = if nothing?(t) then "" else t;
        def lv-emit(data) {
            let made = fs-mkdir(data);
            let c1 = fs-remove-file(str_concat(data, "/train.jsonl"));
            let c2 = fs-remove-file(str_concat(data, "/valid.jsonl"));
            let ncorpus = lv-corpus-emit(data, hdc-rows(), 1);
            let nr = lv-receipts-emit(data, "receipts", fs-list("receipts"), ncorpus);
            let nh = lv-history-emit(data, nr);
            let nd = lv-distill-emit(data, nh);
            let np = lv-perception-emit(data, nd);
            let n = lv-rumi-emit(data, np);
            list(sub(ncorpus, 1), sub(nr, ncorpus), sub(nh, nr), sub(n, 1), sub(np, nd));
        }
        def lv-model() {
            let snaps = fs-list(LVModelDir());
            if eq(len(snaps), 0) then "" else fs-path-join(LVModelDir(), head(snaps));
        }
        def lv-train-cmd(data, model, iters) = lv-cat(list("( ", LVVenv(), "/bin/python -m mlx_lm lora --model ", model, " --train --data ", data, " --iters ", int_to_str(iters), " --batch-size 4 --num-layers 8 --learning-rate 1e-4 --max-seq-length 1024 --adapter-path ", data, "/adapter --save-every 100 --steps-per-eval 100 > ", data, "/train.log 2>&1; echo $? > ", data, "/train.rc ) >/dev/null 2>&1 &"));
        def lv-training?(data) = if eq(fs-exists?(str_concat(data, "/train.log")), 0) then 0 else if eq(fs-exists?(str_concat(data, "/train.rc")), 1) then 0 else 1;
        // one held-out question, answered by the base and by the adapter (one crossing each)
        // 60 tokens answers a corpus question, whose word is the first thing
        // said. It TRUNCATES a perception answer, whose shape is the last —
        // and a grader reading a cut answer scores the cut, not the model.
        field LVMaxTokens = 60;
        def lv-ask-cmd(model, adapter, prompt) = lv-ask-cmd-n(model, adapter, prompt, LVMaxTokens());
        def lv-ask-cmd-n(model, adapter, prompt, maxTokens) = lv-cat(list(LVVenv(), "/bin/python -m mlx_lm generate --model ", model, if eq(str_len(adapter), 0) then "" else str_concat(" --adapter-path ", adapter), " --max-tokens ", int_to_str(maxTokens), " --prompt '", prompt, "' 2>/dev/null | tail -n +1"));
        // the adapter's home: the local training folder when one stands, else the
        // committed one — a locally trained preference is vital and travels as ice
        field LVTracked = "form/form-stdlib/adapters/llama-3.2-3b-voice";
        def lv-adapter-path(data) = if gt(file_size(str_concat(data, "/adapter/adapters.safetensors")), 0) then str_concat(data, "/adapter") else LVTracked();
        // What the crossing hands back is not what the model said: mlx_lm wraps
        // the answer in its own banner and follows it with a speed report. A
        // reader that takes the whole of it reads the BANNER as the model's
        // first word, and a grader built on first-word equality then scores
        // every answer wrong with no sign that anything is amiss. So the
        // transport's framing comes off here, once, where the crossing is.
        field LVBanner = "==========";
        def lv-txt(t) = if nothing?(t) then "" else t;
        def lv-said(raw) = lv-said-of(lv-txt(raw));
        def lv-said-of(s) = lv-said-at(s, str_find(s, LVBanner(), 0));
        def lv-said-at(s, a) = if lt(a, 0) then trim(s) else lv-said-cut(s, add(a, str_len(LVBanner())));
        def lv-said-cut(s, from) = lv-said-end(s, from, str_find(s, LVBanner(), from));
        def lv-said-end(s, from, b) = if lt(b, 0) then trim(substring(s, from, str_len(s))) else trim(substring(s, from, b));
        // ── the crossing, always, and named as one ────────────────────────
        // These three keep the membrane on purpose. A base-versus-adapter
        // grade must hold the MODEL still while the adapter moves, so the
        // school asks through here and not through the routed door below.
        def lv-cross-ask(data, prompt, withAdapter) = host-exec(lv-ask-cmd(lv-model(), if eq(withAdapter, 1) then lv-adapter-path(data) else "", prompt), "");
        def lv-cross-ask-at(adapter, prompt, maxTokens) = host-exec(lv-ask-cmd-n(lv-model(), adapter, prompt, maxTokens), "");
        def lv-cross-ask-n(data, prompt, withAdapter, maxTokens) = host-exec(lv-ask-cmd-n(lv-model(), if eq(withAdapter, 1) then lv-adapter-path(data) else "", prompt, maxTokens), "");

        // ── which door an ask takes, and why ──────────────────────────────
        // An ask with no adapter goes to the body's own dense lane on this
        // Mac's metal — llama32-1b through `dense-token-handle`, nothing
        // crossed. An ask WEARING an adapter goes to the native LoRA lane
        // — llama32-3b through `nlg-ask`, the worn adapter on Metal.
        // mlx_lm generate remains as `lv-cross-ask` for side-by-side grades.
        // mlx_lm train remains the trainer crossing.
        //
        // The dense native lane is the SMALLER model, and where its answer is
        // worse the measurement says so rather than the routing hiding it:
        // `observe/lora-voice-ask-run.fk` asks one question three ways and
        // prints the three answers beside each other.
        def lv-native-lane() = "native-dense-llama32-1b-on-metal";
        def lv-lora-lane() = "native-lora-llama32-3b-on-metal";
        def lv-cross-lane() = "mlx-crossing-llama32-3b-instruct-4bit";
        def lv-route(adapter) = if eq(str_len(adapter), 0) then "native" else "native-lora";
        def lv-route-why(adapter) {
            if eq(str_len(adapter), 0) then "the body's own dense lane on this Mac's metal; no membrane crossed"
            else str_concat("native LoRA lane on this Mac's metal; llama32-3b wearing ", adapter);
        }
        // the full-truth door: (text reason lane). A reason is empty exactly
        // when a lane answered; a refusal names which — no model, a prompt
        // with no room left in the cache, a missing adapter, a crossing that vanished.
        def lv-lora-ask-r(adapter, prompt, maxTokens) {
            let base = nlg-base();
            if le(file_size(str_concat(base, "/model.safetensors")), 0) then list("", "no-local-checkpoint", lv-lora-lane())
            else if le(file_size(str_concat(adapter, "/adapters.safetensors")), 0) then list("", "no-adapter", lv-lora-lane())
            else lv-r-lora(nlg-once(base, adapter, prompt, maxTokens, "", "", ""));
        }
        def lv-ask-r(adapter, prompt, maxTokens) {
            if eq(str_len(adapter), 0) then lv-r-native(na-chat-ask(prompt, maxTokens))
            else lv-lora-ask-r(adapter, prompt, maxTokens);
        }
        def lv-r-native(r) = list(na-said(r), na-why(r), lv-native-lane());
        def lv-r-lora(r) = list(head(r), nth(r, 1), lv-lora-lane());
        def lv-r-cross(raw) = if nothing?(raw) then list("", "crossing-vanished", lv-cross-lane()) else list(lv-said(raw), "", lv-cross-lane());
        def lv-r-said(r) = head(r);
        def lv-r-why(r) = nth(r, 1);
        def lv-r-lane(r) = nth(r, 2);
        def lv-r-answered?(r) = if eq(str_len(nth(r, 1)), 0) then 1 else 0;

        // the routed doors: the body's own lane unless an adapter is worn
        def lv-ask(data, prompt, withAdapter) = lv-ask-n(data, prompt, withAdapter, LVMaxTokens());
        def lv-ask-at(adapter, prompt, maxTokens) = lv-r-said(lv-ask-r(adapter, prompt, maxTokens));
        def lv-ask-n(data, prompt, withAdapter, maxTokens) = lv-ask-at(if eq(withAdapter, 1) then lv-adapter-path(data) else "", prompt, maxTokens);
        def lv-launch(data, iters) = if eq(lv-training?(data), 1) then "already-training" else if eq(str_len(lv-model()), 0) then "no-model" else if nothing?(host-exec(lv-train-cmd(data, lv-model(), iters), "")) then "launch-vanished" else "launched";
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceDistill {
        // rows the resident taught (hearth-distill-run) fold into TRAIN only; the held-out set stays the judge
        def lv-distill-lines(data) = split-on(read_file_slice_or_empty(read_file(str_concat(data, "/distill.jsonl"))), byte_to_str(10));
        def lv-distill-emit-go(data, lines, i) = if eq(len(lines), 0) then i else if lt(str_len(head(lines)), 20) then lv-distill-emit-go(data, tail(lines), i) else lv-distill-emit-next(data, tail(lines), add(i, 1), sbt-append(str_concat(data, "/train.jsonl"), str_concat(head(lines), byte_to_str(10))));
        def lv-distill-emit-next(data, lines, i, wrote) = lv-distill-emit-go(data, lines, i);
        def lv-distill-emit(data, i) = lv-distill-emit-go(data, lv-distill-lines(data), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoicePerception {
        // the rows the body wrote from what it perceived (perception-rows-run)
        // fold into TRAIN only, like the distilled and the Rumi rows: the
        // held-out set stays corpus questions, so a room cannot grade itself
        def lv-perception-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file(str_concat(data, "/perception.jsonl"))), byte_to_str(10)), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceRumi {
        // Rumi continuation rows (rumi-rows-run) fold into TRAIN only, like the distilled rows
        def lv-rumi-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file(str_concat(data, "/rumi.jsonl"))), byte_to_str(10)), i);
    }
    0;
}
