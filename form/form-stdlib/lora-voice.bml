//////////////////////////////////////////////////////////////////////
// lora-voice.bml — the body's teacher material as chat rows, written by
// the body itself: every corpus row (the question it could not answer,
// the fresh word that answered it) and every receipt section (Sema's own
// voice), one JSON line each, split ten-to-one into train and valid.
//
// Training and adapter asking use the same native 3B model and full LoRA layers.
// The adapterless routed ask retains the native dense 1B door.
// The supervisor exposes actual process exits and per-stage learning events.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/spool-bell-transport.fk learn/homecoming-distillation-corpus.fk form/form-stdlib/native-ask.bml form/form-stdlib/native-lora-worker.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraVoice {
        field LVData = ".form-lora-voice-native";
        field LVIters = 600;
        def lv-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ lv-cat(tail(parts));
        def lv-q() = byte_to_str(34);
        def lv-esc-byte(c) = (Comparable) c == 34 ? byte_to_str(92) ++ lv-q() : (Comparable) c == 92 ? byte_to_str(92) ++ byte_to_str(92) : (Comparable) c == 10 ? byte_to_str(92) ++ "n" : (Comparable) c == 9 ? byte_to_str(92) ++ "t" : c < 32 ? " " : byte_to_str(c);
        def lv-esc-go(s, i, acc) = i >= str_len(s) ? acc : lv-esc-go(s, i + 1, acc ++ lv-esc-byte(str_byte_at(s, i)));
        def lv-esc(s) = lv-esc-go(s, 0, "");
        def lv-row(user, assistant) = lv-cat(list("{", lv-q(), "messages", lv-q(), ":[{", lv-q(), "role", lv-q(), ":", lv-q(), "user", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(user), lv-q(), "},{", lv-q(), "role", lv-q(), ":", lv-q(), "assistant", lv-q(), ",", lv-q(), "content", lv-q(), ":", lv-q(), lv-esc(assistant), lv-q(), "}]}", byte_to_str(10)));
        def lv-join(ws) = (Comparable) len(ws) == 0 ? "" : (Comparable) len(tail(ws)) == 0 ? head(ws) : head(ws) ++ " " ++ lv-join(tail(ws));
        def lv-corpus-row(r) = lv-row(lv-cat(list("The body asks the smallest question it cannot yet answer natively: ", lv-join(r[2]), "?")), lv-cat(list(r[4], ". The word the body did not have for ", lv-join(r[2]), "; offered ", int_to_str(r[1]), " by ", r[5], ".")));
        def lv-split-path(data, i) = data ++ ((Comparable) (i % 10) == 0 ? "/valid.jsonl" : "/train.jsonl");
        def lv-put(data, i, line) = sbt-append(lv-split-path(data, i), line);
        def lv-corpus-emit(data, rows, i) = (Comparable) len(rows) == 0 ? i : lv-corpus-emit-next(data, tail(rows), i + 1, lv-put(data, i, lv-corpus-row(head(rows))));
        def lv-corpus-emit-next(data, rows, i, wrote) = lv-corpus-emit(data, rows, i);
        def lv-title(text) = trim(substring(text, 0, str_find(text, byte_to_str(10), 0) < 0 ? str_len(text) : str_find(text, byte_to_str(10), 0)));
        def lv-strip-hash(t) = (str_len(t) > 0) && ((Comparable) str_byte_at(t, 0) == 35) ? lv-strip-hash(substring(t, 1, str_len(t))) : trim(t);
        def lv-section-row(title, sec) {
            let nl = str_find(sec, byte_to_str(10), 0);
            let head = nl < 0 ? trim(sec) : trim(substring(sec, 0, nl));
            let body = nl < 0 ? "" : trim(substring(sec, nl + 1, str_len(sec)));
            (str_len(body) < 80) || (str_len(body) > 1800) ? "" : lv-row(lv-cat(list("From the receipt ", lv-q(), title, lv-q(), ", speak the section ", lv-q(), head, lv-q(), " in Sema", byte_to_str(39), "s voice.")), body);
        }
        def lv-sections-emit(data, title, secs, i) = (Comparable) len(secs) == 0 ? i : lv-sections-emit-one(data, title, secs, i, lv-section-row(title, head(secs)));
        def lv-sections-emit-one(data, title, secs, i, line) = (Comparable) str_len(line) == 0 ? lv-sections-emit(data, title, tail(secs), i) : lv-sections-emit-next(data, title, tail(secs), i + 1, lv-put(data, i, line));
        def lv-sections-emit-next(data, title, secs, i, wrote) = lv-sections-emit(data, title, secs, i);
        def lv-receipt-emit(data, path, i) {
            let text = read_file(path);
            nothing?(text) ? i : lv-sections-emit(data, lv-strip-hash(lv-title(text)), tail(split-on(text, byte_to_str(10) ++ "## ")), i);
        }
        def lv-receipts-emit(data, dir, names, i) = (Comparable) len(names) == 0 ? i : lv-receipts-emit(data, dir, tail(names), lv-receipt-emit(data, fs-path-join(dir, head(names)), i));
        // the git history: every landing is a teaching, dated and attributed; one host
        // read of the log (records on byte 30, fields on byte 31), parsed natively.
        //
        // git ITSELF stays a crossing, and the reason is measured rather than assumed:
        // its object store is zlib-deflated and this body carries no inflate, so nothing
        // here can read a commit body that git cannot. What came home is the SHELL that
        // stood around it. host_spawn_at execs the argument list itself — no quoting to
        // get wrong, and git's own voice lands in a file instead of being swallowed —
        // and the log goes to a path named after this process's pid, because siblings
        // share /tmp. Measured on this Mac 2026-09-09: 3,581,274 bytes, byte-identical
        // to the shell's answer, 36 ms against 40.
        //
        // The OTHER shell-free door cannot carry this read, and that is why the pipe is
        // a file. host_capture answers out of a 1 MiB static buffer: asked for the same
        // log it returned 1,048,575 bytes and no refusal, losing 2,532,699 of the body's
        // own history silently. A crossing that tells the truth beats a native that
        // does not.
        def lv-rs() = byte_to_str(30);
        def lv-fs() = byte_to_str(31);
        def lv-git-argv() = list("git", "log", "--no-merges", "--format=%h%x1f%ad%x1f%an%x1f%s%x1f%b%x1e", "--date=short");
        def lv-git-out() = "/tmp/lora-voice-history-" ++ int_to_str(host_pid()) ++ ".txt";
        def lv-git-err() = lv-git-out() ++ ".err";
        def lv-git-row(rec) {
            let f = split-on(rec, lv-fs());
            len(f) < 5 ? "" : str_len(f[3]) < 12 ? "" : lv-row(lv-cat(list("From the landing ", trim(f[1]), " ", trim(f[0]), " by ", trim(f[2]), ", speak what landed and why.")), lv-cat(list(trim(f[3]), str_len(trim(f[4])) < 20 ? "" : byte_to_str(10) ++ substring(trim(f[4]), 0, str_len(trim(f[4])) > 1600 ? 1600 : str_len(trim(f[4]))))));
        }
        def lv-git-emit(data, recs, i) = (Comparable) len(recs) == 0 ? i : lv-git-emit-one(data, tail(recs), i, lv-git-row(head(recs)));
        def lv-git-emit-one(data, recs, i, line) = (Comparable) str_len(line) == 0 ? lv-git-emit(data, recs, i) : lv-git-emit-next(data, recs, i + 1, lv-put(data, i, line));
        def lv-git-emit-next(data, recs, i, wrote) = lv-git-emit(data, recs, i);
        // a refusal is not a pid: the door judges the argv and the three redirects
        // before it forks, so a history that could not be read answers a negative
        // number here and emits no rows rather than half of them
        def lv-git-read(pid) = pid < 0 ? "" : lv-git-waited(host_wait(pid));
        def lv-git-waited(w) = read_file_slice_or_empty(read_file(lv-git-out()));
        def lv-history-emit(data, i) {
            let stale = fs-remove-file(lv-git-out());
            let text = lv-git-read(host_spawn_at(lv-git-argv(), list("/dev/null", lv-git-out(), lv-git-err())));
            let n = lv-git-emit(data, split-on(text, lv-rs()), i);
            let spent = fs-remove-file(lv-git-out());
            let voice = fs-remove-file(lv-git-err());
            n;
        }
        def read_file_slice_or_empty(t) = t ?? "";
        def lv-emit(data) {
            let made = fs-mkdir(data);
            let c1 = fs-remove-file(data ++ "/train.jsonl");
            let c2 = fs-remove-file(data ++ "/valid.jsonl");
            let ncorpus = lv-corpus-emit(data, hdc-rows(), 1);
            let nr = lv-receipts-emit(data, "receipts", fs-list("receipts"), ncorpus);
            let nh = lv-history-emit(data, nr);
            let nd = lv-distill-emit(data, nh);
            let np = lv-perception-emit(data, nd);
            let n = lv-rumi-emit(data, np);
            list(ncorpus - 1, nr - ncorpus, nh - nr, n - 1, np - nd);
        }
        def lv-model() = mr-path(mr-find("llama32-3b-mlx-4bit"));
        field LVMaxTokens = 0;
        field LVTracked = "form/form-stdlib/adapters/llama-3.2-3b-voice";
        def lv-adapter-path(data) = file_size(data ++ "/adapter/native-current") > 0 ? data ++ "/adapter" : file_size(data ++ "/adapter/adapters.safetensors") > 0 ? data ++ "/adapter" : LVTracked();
        def lv-training?(data) = nlw-running(data);
        def lv-train-request(data,model,iters) = ntr-request(model,lv-adapter-path(data),data,data ++ "/adapter",iters,4,0.0001,0,8);
        def lv-launch(data,iters) = head(nlw-launch(lv-train-request(data,lv-model(),iters),data));
        def lv-txt(t) = t ?? "";
        def lv-said(raw) = trim(lv-txt(raw));
        // The 1B comparison door keeps its own identity. Both school samples below
        // use the exact same 3B base, with only adapter ownership changing.
        def lv-native-lane() = "native-dense-llama32-1b-on-metal";
        def lv-model-lane() = "native-affine-llama32-3b-on-metal";
        def lv-lora-lane() = "native-lora-llama32-3b-on-metal";
        def lv-route(adapter) = (Comparable) str_len(adapter) == 0 ? "native" : "native-lora";
        def lv-route-why(adapter) = (Comparable) str_len(adapter) == 0 ? "the native dense 1B asking door" : "the adapter's 3B base and full LoRA on native Metal: " ++ adapter;
        def lv-events() = ".hearth/native-voice-" ++ int_to_str(host_pid()) ++ ".jsonl";
        def lv-model-ask-r(adapter,prompt,maxTokens) {
            file_size(lv-model() ++ "/model.safetensors") <= 0 ? list("","no-local-checkpoint",lv-model-lane())
            : (str_len(adapter) > 0) && (file_size(nag-resolve(adapter) ++ "/adapters.safetensors") <= 0) ? list("","no-adapter",lv-lora-lane())
            : lv-r-model(nlg-once(lv-model(),adapter,prompt,maxTokens,"","",lv-events()));
        }
        def lv-lora-ask-r(adapter,prompt,maxTokens) = lv-r-lora(lv-model-ask-r(adapter,prompt,maxTokens));
        def lv-ask-r(adapter,prompt,maxTokens) = (Comparable) str_len(adapter) == 0 ? lv-r-native(na-chat-ask(prompt,(Comparable) maxTokens == 0 ? NAPositions() : maxTokens)) : lv-lora-ask-r(adapter,prompt,maxTokens);
        def lv-r-model(r) = list(head(r),r[1],lv-model-lane());
        def lv-r-lora(r) = list(head(r),r[1],lv-lora-lane());
        def lv-r-native(r) = list(na-said(r),na-why(r),lv-native-lane());
        def lv-r-said(r) = head(r);
        def lv-r-why(r) = r[1];
        def lv-r-lane(r) = r[2];
        def lv-r-answered?(r) = (Comparable) str_len(r[1]) == 0;
        def lv-complete(r) = lv-r-answered?(r) ? lv-r-said(r) : nothing();
        def lv-model-ask(data,prompt,withAdapter) = lv-model-ask-n(data,prompt,withAdapter,LVMaxTokens());
        def lv-model-ask-at(adapter,prompt,maxTokens) = lv-complete(lv-model-ask-r(adapter,prompt,maxTokens));
        def lv-model-ask-n(data,prompt,withAdapter,maxTokens) = lv-model-ask-at((Comparable) withAdapter == 1 ? lv-adapter-path(data) : "",prompt,maxTokens);
        def lv-ask(data,prompt,withAdapter) = lv-ask-n(data,prompt,withAdapter,LVMaxTokens());
        def lv-ask-at(adapter,prompt,maxTokens) = lv-complete(lv-ask-r(adapter,prompt,maxTokens));
        def lv-ask-n(data,prompt,withAdapter,maxTokens) = lv-ask-at((Comparable) withAdapter == 1 ? lv-adapter-path(data) : "",prompt,maxTokens);
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceDistill {
        // rows the resident taught (distill.jsonl) fold into TRAIN only; the held-out set stays the judge
        def lv-distill-lines(data) = split-on(read_file_slice_or_empty(read_file(data ++ "/distill.jsonl")), byte_to_str(10));
        def lv-distill-emit-go(data, lines, i) = (Comparable) len(lines) == 0 ? i : str_len(head(lines)) < 20 ? lv-distill-emit-go(data, tail(lines), i) : lv-distill-emit-next(data, tail(lines), i + 1, sbt-append(data ++ "/train.jsonl", head(lines) ++ byte_to_str(10)));
        def lv-distill-emit-next(data, lines, i, wrote) = lv-distill-emit-go(data, lines, i);
        def lv-distill-emit(data, i) = lv-distill-emit-go(data, lv-distill-lines(data), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoicePerception {
        // the rows the body wrote from what it perceived (perception.jsonl)
        // fold into TRAIN only, like the distilled and the Rumi rows: the
        // held-out set stays corpus questions, so a room cannot grade itself
        def lv-perception-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file(data ++ "/perception.jsonl")), byte_to_str(10)), i);
    }
    0;
}
section [form.bml] {
    class FormLoraVoiceRumi {
        // Rumi continuation rows (rumi.jsonl) fold into TRAIN only, like the distilled rows
        def lv-rumi-emit(data, i) = lv-distill-emit-go(data, split-on(read_file_slice_or_empty(read_file(data ++ "/rumi.jsonl")), byte_to_str(10)), i);
    }
    0;
}
