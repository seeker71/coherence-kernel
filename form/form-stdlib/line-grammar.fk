; line-grammar.fk — the shared helpers every line-based grammar reaches for
;
; preludes: form-stdlib/core.fk
;
; Digested from 6 file-header grammars (markdown.fk, json.fk, yaml.fk,
; python.fk, typescript.fk, rust.fk, go.fk) shipped Oct 2026-05-21
; through 2026-05-22 morning. Each grammar duplicated ~50 lines of
; lines-from-source / trim / is-blank? / find-from / split-on / etc.
; Extracted here so the grammars become thin: just their unique
; dispatch + emission logic.
;
; What the digest revealed:
;   1. Line-based parsing is the dominant pattern for text formats —
;      tokens are lines, not individual characters.
;   2. The numeric type=99 doc-band emerged organically and works.
;   3. Source attribution flows through every grammar without resistance
;      (intern_node_at on every line-derived Recipe).
;   4. Comment styles vary (// for ts/rust/go, # for python/yaml, ; for
;      form) but the SHAPE is identical: "trim leading ws, check first
;      char". Each grammar defines its own is-comment? via the shared
;      starts-with? / char_at primitives — no parameterization needed.
;   5. The form .fk language is sufficient for all 8 grammars without
;      needing any kernel extensions beyond intern_node_at + node_eq.
;
; This file lives at form-stdlib/line-grammar.fk (one level above
; grammars/) so all per-tongue grammars can load it as a shared layer
; between core.fk and the grammar itself.

(do
    ;; ──────────────────────────────────────────────────────────────────
    ;; character predicates (codepoint-level)
    ;; ──────────────────────────────────────────────────────────────────

    (defn is-ws-cp (cp)
        (or (eq cp 32) (or (eq cp 9) (or (eq cp 10) (eq cp 13)))))

    (defn is-digit-cp (cp) (and (ge cp 48) (le cp 57)))

    (defn is-alpha-cp (cp)
        (or (and (ge cp 65) (le cp 90))
            (or (and (ge cp 97) (le cp 122))
                (eq cp 95))))

    (defn is-ident-cont-cp (cp)
        (or (is-alpha-cp cp)
            (or (is-digit-cp cp)
                (or (eq cp 45) (eq cp 63)))))

    ;; ──────────────────────────────────────────────────────────────────
    ;; whitespace trimming
    ;; ──────────────────────────────────────────────────────────────────

    ;; Both trims used to CUT a fresh string per whitespace byte: leading fed
    ;; itself s[1..] and trailing fed itself s[..len-1], so trimming k bytes off
    ;; a row of length n interned k strings totalling about k*n bytes, and `trim`
    ;; did it twice. The bearing census over the locale-row walk read 1,177,051
    ;; calls to each on 2026-09-07. Now each walks BYTE OFFSETS and makes at most
    ;; one cut, so the work is the whitespace run and the interning is one string.
    ;;
    ;; `(ord (char_at s i))` became `(str_byte_at s i)`, which is the same value
    ;; on fkwu — char_at is a one-byte substring and ord is str_byte_at of it —
    ;; and is the same value on every arm, which the old form was not: rust and
    ;; ts answer the axiom-1 absence for a cut that severs a character, so
    ;; `char_at` at the LAST byte of a row ending in Persian handed `ord` an
    ;; absence there and a byte here. Neither reading is whitespace, so no
    ;; answer moves; the door simply stopped asking a question two arms cannot
    ;; hold. Pinned by tests/line-grammar-search-equivalence-band.fk (4095),
    ;; which keeps both cutting bodies verbatim and demands agreement.

    (defn ws-run-start (s i len)
        (if (ge i len) i
            (if (is-ws-cp (str_byte_at s i)) (ws-run-start s (add i 1) len) i)))

    (defn ws-run-end (s j)
        (if (le j 0) 0
            (if (is-ws-cp (str_byte_at s (sub j 1))) (ws-run-end s (sub j 1)) j)))

    (defn trim-leading-ws (s)
        (do (let len (str_len s))
            (let i (ws-run-start s 0 len))
            (if (eq i 0) s (substring s i len))))

    (defn trim-trailing-ws (s)
        (do (let len (str_len s))
            (let j (ws-run-end s len))
            (if (eq j len) s (substring s 0 j))))

    (defn trim (s)
        (do (let len (str_len s))
            (let i (ws-run-start s 0 len))
            (let j (ws-run-end s len))
            (if (le j i) ""
                (if (and (eq i 0) (eq j len)) s (substring s i j)))))

    (defn is-blank? (text) (eq (str_len (trim text)) 0))

    ;; ──────────────────────────────────────────────────────────────────
    ;; lines-from-source: byte stream → list of (text, line-num) pairs
    ;; ──────────────────────────────────────────────────────────────────
    ;; Splits on \n. The newline char itself is not included in the
    ;; resulting line text. Line numbers are 1-indexed. A trailing
    ;; newline produces no extra empty line; a source without trailing
    ;; newline still emits its final partial line.

    (defn reverse-acc-loop (xs acc)
        (if (eq (len xs) 0) acc
            (reverse-acc-loop (tail xs) (cons (head xs) acc))))
    (defn reverse-acc (xs) (reverse-acc-loop xs (empty)))

    (defn nil? (xs) (eq (len xs) 0))

    (defn nth (xs n)
        (if (eq n 0) (head xs)
            (nth (tail xs) (sub n 1))))

    (defn append (xs ys)
        (if (nil? xs) ys
            (cons (head xs) (append (tail xs) ys))))

    (defn lines-from-source (s)
        (lines-loop s 0 0 1 (empty)))

    ;; The scan asked `(str_len s)` again at every byte of the file and read the
    ;; byte as `(ord (char_at s i))` — a one-byte CUT interned per byte, then a
    ;; second walker frame to read its first byte back out. A megabyte of source
    ;; interned a million throwaway strings to find its newlines. The length is
    ;; hoisted into the loop now and the byte is read straight through the
    ;; native. `lines-loop` keeps its five-argument shape, because it is a name
    ;; other units can reach, and hands off once per call rather than per byte.

    (defn lines-loop (s i start line acc)
        (lines-scan s i start line acc (str_len s)))

    (defn lines-scan (s i start line acc len)
        (if (eq i len)
            (if (gt i start)
                (reverse-acc (cons (list (substring s start i) line) acc))
                (reverse-acc acc))
            (if (eq (str_byte_at s i) 10)
                (lines-scan s (add i 1) (add i 1) (add line 1)
                            (cons (list (substring s start i) line) acc) len)
                (lines-scan s (add i 1) start line acc len))))

    (defn line-text (ln) (head ln))
    (defn line-num  (ln) (head (tail ln)))

    ;; ──────────────────────────────────────────────────────────────────
    ;; prefix detection
    ;; ──────────────────────────────────────────────────────────────────

    ;; This one cuts too, and it was LEFT ALONE. A first-byte gate ahead of the
    ;; cut was written and measured against this body on 2026-09-08 — 240,000
    ;; misses over the real locale rows, 25 ms cutting against 26 ms gated — so
    ;; it bought nothing and was removed rather than shipped. The markers this
    ;; door is asked about are one to five bytes long, which is a cut `substring`
    ;; now makes natively; the pool pressure that made the old search degrade
    ;; needs a cut worth degrading over. Pinned by the equivalence band all the
    ;; same, so the next reader inherits the measurement and not the temptation.

    (defn starts-with? (text prefix)
        (if (lt (str_len text) (str_len prefix)) false
            (str_eq (substring text 0 (str_len prefix)) prefix)))

    ;; starts-with-keyword? — like starts-with? but requires that the
    ;; character immediately after the prefix is whitespace, so we don't
    ;; match `funky` as starting-with-keyword `fun`. Returns false if
    ;; the prefix exactly equals the whole text (no separator).
    (defn starts-with-keyword? (text kw)
        (and (starts-with? text kw)
             (and (gt (str_len text) (str_len kw))
                  (is-ws-cp (ord (char_at text (str_len kw)))))))

    ;; ──────────────────────────────────────────────────────────────────
    ;; substringing search
    ;; ──────────────────────────────────────────────────────────────────

    ;; THERE IS ONE SEARCH IN THIS BODY AND IT LIVES IN core.fk.
    ;;
    ;; `find-loop` used to be a second one: it cut `(substring s i (add i nlen))`
    ;; at EVERY offset and compared the piece, re-measuring both lengths on each
    ;; position as well. core.fk's `str_find` had already been healed off exactly
    ;; that shape — read one byte, compare further only when it matches the
    ;; needle's first — but this copy kept the old cost, and the callers above it
    ;; are how the body reads everything: `split-on` is a loop over `find-from`,
    ;; and more than thirty units prelude this file.
    ;;
    ;; The bearing census over the locale-row walk read it on 2026-09-07 as the
    ;; single heaviest composed door in the body: 34,264,886 walker entries,
    ;; 57.4% of the walking, five doors leaning on it — every one of those
    ;; entries interning a string it threw away. Routing here removes the second
    ;; search rather than making it faster: the meaning is now stated in one
    ;; place, and a heal to `str_find` reaches every reader at once.
    ;;
    ;; THE CLAMP IS THE OLD BEHAVIOUR, WRITTEN DOWN. A negative `start` used to
    ;; scan harmlessly toward zero — the cut clamped, the lengths never matched,
    ;; nothing could match before 0 — so `find-from s n -3` answered as if it
    ;; were `0`. `str_find` would instead hand `str_byte_at` a negative index,
    ;; which fkwu answers and form-kernel-go and form-kernel-rust take as fatal
    ;; (core.fk names that measurement). So the clamp stays here, where the
    ;; callers are, and the equivalence band asks for it.
    ;;
    ;; Pinned by tests/line-grammar-search-equivalence-band.fk (4095), which
    ;; keeps the allocating loop verbatim as its reference.

    (defn find-from (s needle start)
        (str_find s needle (if (lt start 0) 0 start)))

    ;; ──────────────────────────────────────────────────────────────────
    ;; split on substringing
    ;; ──────────────────────────────────────────────────────────────────
    ;; Splits text on every occurrence of sep. Empty leading/trailing
    ;; pieces are preserved (matches Python's str.split semantics).

    (defn split-on (s sep)
        (split-on-loop s sep 0 (empty)))

    (defn split-on-loop (s sep i acc)
        (do
            (let pos (find-from s sep i))
            (if (lt pos 0)
                (reverse-acc (cons (substring s i (str_len s)) acc))
                (split-on-loop s sep (add pos (str_len sep))
                                (cons (substring s i pos) acc)))))

    ;; ──────────────────────────────────────────────────────────────────
    ;; pick-min: smallest non-negative value, with fallback
    ;; ──────────────────────────────────────────────────────────────────
    ;; Used by grammars to find the earliest of multiple delimiters
    ;; (e.g. "where does this identifier end? at the first space or
    ;; brace, whichever comes first").

    (defn pick-min (a b fallback)
        (if (lt a 0)
            (if (lt b 0) fallback b)
            (if (lt b 0) a
                (if (lt a b) a b))))
)
