; dsv4-tokenizer-cli.fk — stdin door for the DS4 byte-level BPE tokenizer.
;
; Run through the native program-image selector (never `fkwu --src`):
;   printf 'encode The capital of France is\n' | ./fkwu form/form-stdlib/dsv4-tokenizer-cli.fk
;   printf 'decode 19129\n' | ./fkwu form/form-stdlib/dsv4-tokenizer-cli.fk
;
; The selected GGUF is the locally admitted DS4 Flash artifact. Decode emits
; byte values and lowercase hex as the canonical answer; text is an additional
; readable view because arbitrary bytes are not safely representable as a Form
; string.
;
; preludes: form-stdlib/dsv4-tokenizer.fk

(do
    (defn dtc-model ()
        "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")

    (defn dtc-ids-text (ids)
        (if (eq (len ids) 0) ""
            (dtc-ids-tail (tail ids) (int_to_str (head ids)))))
    (defn dtc-ids-tail (ids acc)
        (if (eq (len ids) 0) acc
            (dtc-ids-tail (tail ids)
                (str_concat (str_concat acc " ") (int_to_str (head ids))))))

    (defn dtc-hex-digit (n)
        (byte_to_str (if (lt n 10) (add 48 n) (add 87 n))))
    (defn dtc-byte-hex (b)
        (str_concat (dtc-hex-digit (div b 16)) (dtc-hex-digit (mod b 16))))
    (defn dtc-bytes-hex (bs)
        (dtc-bytes-hex-acc bs ""))
    (defn dtc-bytes-hex-acc (bs acc)
        (if (eq (len bs) 0) acc
            (dtc-bytes-hex-acc (tail bs)
                (str_concat acc (dtc-byte-hex (head bs))))))

    (defn dtc-encode-line (src line)
        (do (let prompt (substring line 7 (str_len line)))
            (let ids (tkz-encode src prompt))
            (print_str "channel=ds4.tokenizer.form-native")
            (print_str "operation=encode")
            (print_str (str_concat "token_ids=" (dtc-ids-text ids)))
            (print_str (str_concat "token_count=" (int_to_str (len ids))))
            ids))

    (defn dtc-decode-id (src id)
        (do (let bs (tkz-decode-id-bytes src id))
            (print_str "channel=ds4.tokenizer.form-native")
            (print_str "operation=decode")
            (print_str (str_concat "token_id=" (int_to_str id)))
            (print_str (str_concat "bytes_hex=" (dtc-bytes-hex bs)))
            (print_str (str_concat "text=" (tkz-render-acc bs "")))
            bs))

    (defn dtc-main (line)
        (do (let src (tkz-src (dtc-model)))
            (if (eq (substring line 0 (min2 7 (str_len line))) "encode ")
                (dtc-encode-line src line)
            (if (eq (substring line 0 (min2 7 (str_len line))) "decode ")
                (dtc-decode-id src (str_to_int (substring line 7 (str_len line))))
                (do
                    (print_str "usage=encode <text> | decode <token-id>")
                    (empty))))))

    (dtc-main (read_line)))
