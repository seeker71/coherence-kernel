//////////////////////////////////////////////////////////////////////
//
// form-terminal-canvas.bml — reusable Form canvas and ANSI projector.
//
// Authority: form-stdlib/bml/form-terminal-canvas.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/term-graphics.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTerminalCanvasAuthority {
        field FTCAuthorityPath = "form/form-stdlib/bml/form-terminal-canvas.bml";
        field FTCAuthorityKind = "high-bml-interface-class-const";
    }

    class FormTerminalCanvas {
        field FTCSchema = "form-terminal-canvas-v1";
        field FTCTerminalProjection = "ANSI-24bit-v1";
        ref ftc-authority = FormTerminalCanvasAuthority;
        thought ftc-law = list("surface-first", "rectangular", "clip-before-project", "row-major-diff", "retained-history", "capability-seams-visible");

        // style = tag, concept, foreground RGB, background RGB (-1 means none),
        // exact alpha, bold flag, and a symbol vocabulary label.
        def ftc-style(concept, red, green, blue, backRed, backGreen, backBlue, alpha, bold, symbol) {
            list("ftc-style", concept, red, green, blue, backRed, backGreen, backBlue, alpha, bold, symbol);
        }
        def ftc-style-concept(style) = style[1];
        def ftc-style-red(style) = style[2];
        def ftc-style-green(style) = style[3];
        def ftc-style-blue(style) = style[4];
        def ftc-style-back-red(style) = style[5];
        def ftc-style-back-green(style) = style[6];
        def ftc-style-back-blue(style) = style[7];
        def ftc-style-alpha(style) = style[8];
        def ftc-style-bold?(style) = style[9];
        def ftc-style-symbol(style) = style[10];
        def ftc-style-with-alpha(style, alpha) = ftc-style(ftc-style-concept(style), ftc-style-red(style), ftc-style-green(style), ftc-style-blue(style), ftc-style-back-red(style), ftc-style-back-green(style), ftc-style-back-blue(style), alpha, ftc-style-bold?(style), ftc-style-symbol(style));

        def ftc-cell(glyph, style) = list("ftc-cell", glyph, style);
        def ftc-cell-glyph(cell) = cell[1];
        def ftc-cell-style(cell) = cell[2];
        def ftc-repeat-cell(cell, count) = count <= 0 ? list() : cons(cell, ftc-repeat-cell(cell, count - 1));
        def ftc-repeat-row(row, count) = count <= 0 ? list() : cons(row, ftc-repeat-row(row, count - 1));

        // Rich-inspired render contracts, expressed as Form data. Measurement
        // precedes allocation; segments retain semantic identity and channels.
        def ftc-measure(minimum, maximum) = list("ftc-measure", minimum, maximum);
        def ftc-measure-minimum(measurement) = measurement[1];
        def ftc-measure-maximum(measurement) = measurement[2];
        def ftc-region(x, y, width, height) = list("ftc-region", x, y, width, height);
        def ftc-region-x(region) = region[1];
        def ftc-region-y(region) = region[2];
        def ftc-region-width(region) = region[3];
        def ftc-region-height(region) = region[4];
        def ftc-number-clamp(value, low, high) = value < low ? low : value > high ? high : value;
        def ftc-measured-split(totalWidth, height, gap, leftMeasure, rightMeasure) {
            let usable = totalWidth > gap ? (totalWidth - gap) : 0;
            let rightMinimum = ftc-number-clamp(ftc-measure-minimum(rightMeasure), 0, usable);
            let leftMinimum = ftc-number-clamp(ftc-measure-minimum(leftMeasure), 0, usable - rightMinimum);
            let leftHigh = usable >= rightMinimum ? (usable - rightMinimum) : 0;
            let leftWidth = ftc-number-clamp(usable / 2, leftMinimum, leftHigh);
            let rightWidth = usable - leftWidth;
            list(ftc-region(0, 0, leftWidth, height), ftc-region(leftWidth + gap, 0, rightWidth, height));
        }
        def ftc-segment(text, style, control, nodeId, channels, evidence) = list("ftc-segment", text, style, control, nodeId, channels, evidence);
        def ftc-segment-text(segment) = segment[1];
        def ftc-segment-style(segment) = segment[2];
        def ftc-segment-control(segment) = segment[3];
        def ftc-segment-node-id(segment) = segment[4];
        def ftc-segment-channels(segment) = segment[5];
        def ftc-segment-evidence(segment) = segment[6];
        def ftc-byte-text(bytes) = list("ftc-byte-text-v1", bytes);
        def ftc-byte-text?(text) = len(text) < 2 ? 0 : (String) head(text) == "ftc-byte-text-v1" ? 1 : 0;
        def ftc-byte-list-equal?(left, right) = !((Comparable) len(left) == len(right)) ? 0 : (Comparable) len(left) == 0 ? 1 : !((Comparable) head(left) == head(right)) ? 0 : ftc-byte-list-equal?(tail(left), tail(right));
        def ftc-bytes-string(bytes) = (Comparable) len(bytes) == 0 ? "" : byte_to_str(head(bytes)) ++ ftc-bytes-string(tail(bytes));
        def ftc-text-as-string(text) = (Comparable) ftc-byte-text?(text) == 1 ? ftc-bytes-string(text[1]) : text;
        def ftc-text-width(text) = (Comparable) ftc-byte-text?(text) == 1 ? len(text[1]) : str_len(text);
        def ftc-text-equal?(left, right) = ((Comparable) ftc-byte-text?(left) == 1) && ((Comparable) ftc-byte-text?(right) == 1) ? ftc-byte-list-equal?(left[1], right[1]) : ((Comparable) ftc-byte-text?(left) == 0) && ((Comparable) ftc-byte-text?(right) == 0) ? ((String) left == right) : ftc-byte-list-equal?((Comparable) ftc-byte-text?(left) == 1 ? left[1] : ftcb-text(left), (Comparable) ftc-byte-text?(right) == 1 ? right[1] : ftcb-text(right));
        def ftc-overflow(policy, hiddenCount) = list("ftc-overflow", policy, hiddenCount);

        // Retained values belong to the scene, not to the terminal adapter.
        // This bounded ring is deliberately generic so a terminal, framebuffer,
        // or future glass surface can project the same quarter-second history.
        def ftc-drop(items, count) = (count <= 0) || ((Comparable) len(items) == 0) ? items : ftc-drop(tail(items), count - 1);
        def ftc-ring-push(items, value, capacity) {
            let appended = append(items, list(value));
            capacity <= 0 ? list() : len(appended) <= capacity ? appended : ftc-drop(appended, len(appended) - capacity);
        }
        def ftc-ring-last(items, fallback) = (Comparable) len(items) == 0 ? fallback : items[len(items) - 1];
        def ftc-series-max(values, held) = (Comparable) len(values) == 0 ? held : ftc-series-max(tail(values), head(values) > held ? head(values) : held);
        def ftc-series-level(value, maximum) = maximum <= 0 ? 0 : ftc-number-clamp((value * 7) / maximum, 0, 7);
        def ftc-series-levels(values, maximum) = (Comparable) len(values) == 0 ? list() : cons(ftc-series-level(head(values), maximum), ftc-series-levels(tail(values), maximum));
        def ftc-series-normalize(values) = ftc-series-levels(values, ftc-series-max(values, 0));

        // canvas = tag, width, height, rows, blank cell.  Rows are always width
        // cells and their count is always height.
        def ftc-canvas(width, height, blankStyle) {
            let safeWidth = width < 0 ? 0 : width;
            let safeHeight = height < 0 ? 0 : height;
            let blank = ftc-cell(" ", blankStyle);
            let row = ftc-repeat-cell(blank, safeWidth);
            list("ftc-canvas", safeWidth, safeHeight, ftc-repeat-row(row, safeHeight), blank);
        }
        def ftc-width(canvas) = canvas[1];
        def ftc-height(canvas) = canvas[2];
        def ftc-rows(canvas) = canvas[3];
        def ftc-blank(canvas) = canvas[4];
        def ftc-in-bounds?(canvas, x, y) = x < 0 ? 0 : y < 0 ? 0 : x >= ftc-width(canvas) ? 0 : y >= ftc-height(canvas) ? 0 : 1;
        def ftc-cell-at(canvas, x, y) = (Comparable) ftc-in-bounds?(canvas, x, y) == 1 ? ftc-rows(canvas)[y][x] : ftc-blank(canvas);

        def ftc-replace(items, index, value) = (Comparable) index == 0 ? cons(value, tail(items)) : cons(head(items), ftc-replace(tail(items), index - 1, value));
        def ftc-put-cell-in-bounds(canvas, x, y, cell) {
            let row = ftc-rows(canvas)[y];
            let nextRow = ftc-replace(row, x, cell);
            list("ftc-canvas", ftc-width(canvas), ftc-height(canvas), ftc-replace(ftc-rows(canvas), y, nextRow), ftc-blank(canvas));
        }
        def ftc-put-cell(canvas, x, y, cell) {
            (Comparable) ftc-in-bounds?(canvas, x, y) == 0 ?
                canvas
            :
                ftc-put-cell-in-bounds(canvas, x, y, cell);
        }
        def ftc-put-glyph(canvas, x, y, glyph, style) = ftc-put-cell(canvas, x, y, ftc-cell(glyph, style));
        def ftc-put-text-loop(canvas, x, y, text, index, style) = index >= str_len(text) ? canvas : ftc-put-text-loop(ftc-put-glyph(canvas, x + index, y, char_at(text, index), style), x, y, text, index + 1, style);
        def ftc-put-text(canvas, x, y, text, style) = ftc-put-text-loop(canvas, x, y, text, 0, style);

        def ftc-blit-row(destination, source, dx, dy, sx, sy) = sx >= ftc-width(source) ? destination : ftc-blit-row(ftc-put-cell(destination, dx + sx, dy + sy, ftc-cell-at(source, sx, sy)), source, dx, dy, sx + 1, sy);
        def ftc-blit-rows(destination, source, dx, dy, sy) = sy >= ftc-height(source) ? destination : ftc-blit-rows(ftc-blit-row(destination, source, dx, dy, 0, sy), source, dx, dy, sy + 1);
        def ftc-blit(destination, source, dx, dy) = ftc-blit-rows(destination, source, dx, dy, 0);

        def ftc-clip-copy-row(destination, source, sourceX, sourceY, width, x, y) = x >= width ? destination : ftc-clip-copy-row(ftc-put-cell(destination, x, y, ftc-cell-at(source, sourceX + x, sourceY + y)), source, sourceX, sourceY, width, x + 1, y);
        def ftc-clip-copy-rows(destination, source, sourceX, sourceY, width, height, y) = y >= height ? destination : ftc-clip-copy-rows(ftc-clip-copy-row(destination, source, sourceX, sourceY, width, 0, y), source, sourceX, sourceY, width, height, y + 1);
        def ftc-clip(canvas, x, y, width, height) {
            let out = ftc-canvas(width, height, ftc-cell-style(ftc-blank(canvas)));
            ftc-clip-copy-rows(out, canvas, x, y, ftc-width(out), ftc-height(out), 0);
        }

        def ftc-hcompose(left, right) {
            let height = ftc-height(left) >= ftc-height(right) ? ftc-height(left) : ftc-height(right);
            let out = ftc-canvas(ftc-width(left) + ftc-width(right), height, ftc-cell-style(ftc-blank(left)));
            ftc-blit(ftc-blit(out, left, 0, 0), right, ftc-width(left), 0);
        }
        def ftc-vcompose(top, bottom) {
            let width = ftc-width(top) >= ftc-width(bottom) ? ftc-width(top) : ftc-width(bottom);
            let out = ftc-canvas(width, ftc-height(top) + ftc-height(bottom), ftc-cell-style(ftc-blank(top)));
            ftc-blit(ftc-blit(out, top, 0, 0), bottom, 0, ftc-height(top));
        }

        def ftc-bar-next(canvas, width, value, maximum, x, fillStyle, emptyStyle) {
            let filled = maximum <= 0 ? 0 : (x * maximum) < (width * value) ? 1 : 0;
            let glyph = (Comparable) filled == 1 ? "█" : "░";
            let style = (Comparable) filled == 1 ? fillStyle : emptyStyle;
            ftc-bar-loop(ftc-put-glyph(canvas, x, 0, glyph, style), width, value, maximum, x + 1, fillStyle, emptyStyle);
        }
        def ftc-bar-loop(canvas, width, value, maximum, x, fillStyle, emptyStyle) {
            x >= width ?
                canvas
            :
                ftc-bar-next(canvas, width, value, maximum, x, fillStyle, emptyStyle);
        }
        def ftc-bar(width, value, maximum, fillStyle, emptyStyle) = ftc-bar-loop(ftc-canvas(width, 1, emptyStyle), width, value, maximum, 0, fillStyle, emptyStyle);

        def ftc-spark-glyph(value) = value <= 0 ? "▁" : (Comparable) value == 1 ? "▂" : (Comparable) value == 2 ? "▃" : (Comparable) value == 3 ? "▄" : (Comparable) value == 4 ? "▅" : (Comparable) value == 5 ? "▆" : (Comparable) value == 6 ? "▇" : "█";
        def ftc-spark-loop(canvas, values, x, style) = (Comparable) len(values) == 0 ? canvas : ftc-spark-loop(ftc-put-glyph(canvas, x, 0, ftc-spark-glyph(head(values)), ftc-style-with-alpha(style, 80 + (25 * head(values)))), tail(values), x + 1, style);
        def ftc-spark(values, style) = ftc-spark-loop(ftc-canvas(len(values), 1, style), values, 0, style);
        def ftc-heat-loop(canvas, values, x, style) = (Comparable) len(values) == 0 ? canvas : ftc-heat-loop(ftc-put-glyph(canvas, x, 0, "◆", ftc-style-with-alpha(style, head(values))), tail(values), x + 1, style);
        def ftc-heat(values, style) = ftc-heat-loop(ftc-canvas(len(values), 1, style), values, 0, style);

        // A surface is a backend-neutral render tree root.  Its canvas and
        // capabilities remain inspectable without invoking a terminal.
        def ftc-capabilities(width, height, source) = list("ftc-capabilities", width, height, source, "ansi-24bit", "alpha-dim-projection", "line-input-only", "ascii-diff-columns");
        def ftc-surface(canvas, capabilities, channels) = list("ftc-surface", FTCSchema(), canvas, capabilities, channels);
        def ftc-surface-canvas(surface) = surface[2];
        def ftc-surface-capabilities(surface) = surface[3];
        def ftc-surface-channels(surface) = surface[4];
        def ftc-terminal-fallback(width, height) = ftc-capabilities(width, height, "caller-fallback-unobserved");

        def ftc-style-equal?(left, right) = !((String) ftc-style-concept(left) == ftc-style-concept(right)) ? 0 : !((Comparable) ftc-style-red(left) == ftc-style-red(right)) ? 0 : !((Comparable) ftc-style-green(left) == ftc-style-green(right)) ? 0 : !((Comparable) ftc-style-blue(left) == ftc-style-blue(right)) ? 0 : !((Comparable) ftc-style-back-red(left) == ftc-style-back-red(right)) ? 0 : !((Comparable) ftc-style-back-green(left) == ftc-style-back-green(right)) ? 0 : !((Comparable) ftc-style-back-blue(left) == ftc-style-back-blue(right)) ? 0 : !((Comparable) ftc-style-alpha(left) == ftc-style-alpha(right)) ? 0 : !((Comparable) ftc-style-bold?(left) == ftc-style-bold?(right)) ? 0 : ((String) ftc-style-symbol(left) == ftc-style-symbol(right));
        def ftc-cell-equal?(left, right) = (String) ftc-cell-glyph(left) == ftc-cell-glyph(right) ? ftc-style-equal?(ftc-cell-style(left), ftc-cell-style(right)) : 0;
        def ftc-diff-entry(x, y, oldCell, newCell) = list("ftc-change", x, y, oldCell, newCell);
        def ftc-diff-row-cells(previous, nextCanvas, width, x, y, changes, oldCell, newCell) {
            (Comparable) ftc-cell-equal?(oldCell, newCell) == 1 ?
                ftc-diff-row(previous, nextCanvas, width, x + 1, y, changes)
            :
                ftc-diff-row(previous, nextCanvas, width, x + 1, y, cons(ftc-diff-entry(x, y, oldCell, newCell), changes));
        }
        def ftc-diff-row(previous, nextCanvas, width, x, y, changes) {
            x >= width ?
                changes
            :
                ftc-diff-row-cells(previous, nextCanvas, width, x, y, changes, ftc-cell-at(previous, x, y), ftc-cell-at(nextCanvas, x, y));
        }
        def ftc-diff-rows(previous, nextCanvas, width, height, y, changes) = y >= height ? reverse(changes) : ftc-diff-rows(previous, nextCanvas, width, height, y + 1, ftc-diff-row(previous, nextCanvas, width, 0, y, changes));
        def ftc-diff(previous, nextCanvas) {
            let width = ftc-width(previous) >= ftc-width(nextCanvas) ? ftc-width(previous) : ftc-width(nextCanvas);
            let height = ftc-height(previous) >= ftc-height(nextCanvas) ? ftc-height(previous) : ftc-height(nextCanvas);
            ftc-diff-rows(previous, nextCanvas, width, height, 0, list());
        }

        def ftc-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ ftc-cat(tail(parts));
        // The escape vocabulary is the engine's (term-graphics.bml): the
        // canvas names codes, never spells them.
        def ftc-esc() = tg-esc();
        def ftc-ansi-fg(style) = tg-fg-rgb(ftc-style-red(style), ftc-style-green(style), ftc-style-blue(style));
        def ftc-ansi-bg(style) = ftc-style-back-red(style) < 0 ? "" : ";" ++ tg-bg-rgb(ftc-style-back-red(style), ftc-style-back-green(style), ftc-style-back-blue(style));
        def ftc-ansi-weight(style) = (Comparable) ftc-style-bold?(style) == 1 ? tg-code("bold") ++ ";" : ftc-style-alpha(style) < 160 ? tg-code("dim") ++ ";" : "";
        def ftc-ansi-cell(cell) = ftc-cat(list(ftc-ansi-style(ftc-cell-style(cell)), ftc-cell-glyph(cell), tg-reset()));
        def ftc-ansi-style(style) = tg-sgr(ftc-cat(list("0;", ftc-ansi-weight(style), ftc-ansi-fg(style), ftc-ansi-bg(style))));
        def ftc-ansi-segment(segment) = ftc-cat(list(ftc-ansi-style(ftc-segment-style(segment)), ftc-text-as-string(ftc-segment-text(segment))));
        def ftc-ansi-segments(segments) = (Comparable) len(segments) == 0 ? tg-reset() : ftc-ansi-segment(head(segments)) ++ ftc-ansi-segments(tail(segments));
        def ftc-ansi-line-end() = tg-reset() ++ tg-line-erase-rest();
        def ftc-ansi-segment-lines(lines) = (Comparable) len(lines) == 0 ? "" : (Comparable) len(tail(lines)) == 0 ? ftc-ansi-segments(head(lines)) ++ ftc-ansi-line-end() : ftc-cat(list(ftc-ansi-segments(head(lines)), ftc-ansi-line-end(), "\n", ftc-ansi-segment-lines(tail(lines))));
        def ftc-ansi-row-rest(cells, heldStyle) = (Comparable) len(cells) == 0 ? tg-reset() : (Comparable) ftc-style-equal?(heldStyle, ftc-cell-style(head(cells))) == 1 ? ftc-cell-glyph(head(cells)) ++ ftc-ansi-row-rest(tail(cells), heldStyle) : ftc-cat(list(ftc-ansi-style(ftc-cell-style(head(cells))), ftc-cell-glyph(head(cells)), ftc-ansi-row-rest(tail(cells), ftc-cell-style(head(cells)))));
        def ftc-ansi-row(cells) = (Comparable) len(cells) == 0 ? "" : ftc-cat(list(ftc-ansi-style(ftc-cell-style(head(cells))), ftc-cell-glyph(head(cells)), ftc-ansi-row-rest(tail(cells), ftc-cell-style(head(cells)))));
        def ftc-ansi-rows(rows) = (Comparable) len(rows) == 0 ? "" : (Comparable) len(tail(rows)) == 0 ? ftc-ansi-row(head(rows)) : ftc-cat(list(ftc-ansi-row(head(rows)), "\n", ftc-ansi-rows(tail(rows))));
        def ftc-ansi-project(surface) = ftc-ansi-rows(ftc-rows(ftc-surface-canvas(surface)));
        def ftc-terminal-open() = ftc-cat(list(tg-alt-screen-on(), tg-cursor-hide(), tg-screen-clear(), tg-cursor-home()));
        def ftc-terminal-safe-open() = ftc-cat(list(tg-reset(), tg-screen-clear(), tg-cursor-home()));
        def ftc-terminal-home() = tg-cursor-home();
        def ftc-terminal-erase-rest() = tg-screen-erase-rest();
        def ftc-terminal-close() = ftc-cat(list(tg-reset(), tg-cursor-show(), tg-alt-screen-off()));
        def ftc-terminal-frame(surface) = ftc-cat(list(ftc-terminal-home(), ftc-ansi-project(surface)));
        def ftc-ansi-position(x, y) = tg-cursor-to(x, y);
        def ftc-ansi-diff-more(changes, change) = ftc-cat(list(ftc-ansi-position(change[1], change[2]), ftc-ansi-cell(change[4]), ftc-ansi-diff(tail(changes))));
        def ftc-ansi-diff(changes) = (Comparable) len(changes) == 0 ? "" : ftc-ansi-diff-more(changes, head(changes));

        // Segment frames retain node ids, channels, evidence, and styles.  A
        // changed-row projection compares the actual ANSI line bytes and moves
        // only to rows whose semantic projection changed.  History remains in
        // the persistent Form state; repaint suppression never resets it.
        def ftc-segment-line-projection(line) = ftc-ansi-segments(line) ++ ftc-ansi-line-end();
        def ftc-segment-line-at(lines, index) = (index < 0) || (index >= len(lines)) ? list() : lines[index];
        def ftc-segment-line-diff(previous, nextLines, index) {
            let oldProjection = ftc-segment-line-projection(ftc-segment-line-at(previous, index));
            let newProjection = ftc-segment-line-projection(ftc-segment-line-at(nextLines, index));
            (String) oldProjection == newProjection ? "" : ftc-cat(list(ftc-ansi-position(0, index), newProjection));
        }
        def ftc-segment-lines-diff-go(previous, nextLines, index, count) = index >= count ? "" : ftc-segment-line-diff(previous, nextLines, index) ++ ftc-segment-lines-diff-go(previous, nextLines, index + 1, count);
        def ftc-segment-lines-diff(previous, nextLines) {
            let count = len(previous) >= len(nextLines) ? len(previous) : len(nextLines);
            ftc-segment-lines-diff-go(previous, nextLines, 0, count);
        }

        // Persistent projection uses byte lists, not dynamically interned
        // strings.  The retained scene still carries semantic strings for
        // selection and inspection; ANSI framing, RGB numbers, positions and
        // the whole-frame concatenation never enter the permanent string pool.
        // Every byte is consed once, onto the bytes that follow it (rest): a
        // style, a segment, a line, a patch and a whole frame are built in one
        // pass from the end -- no append, no reverse, one cons a byte.
        def ftcb-text-go(text, index, count) = index >= count ? list() : cons(str_byte_at(text, index), ftcb-text-go(text, index + 1, count));
        def ftcb-text(text) = ftcb-text-go(text, 0, str_len(text));
        def ftcb-uint-reversed(value, held) = value < 10 ? cons(48 + value, held) : ftcb-uint-reversed(value / 10, cons(48 + (value % 10), held));
        def ftcb-uint(value) = value <= 0 ? list(48) : ftcb-uint-reversed(value, list());
        def ftcb-int(value) = value < 0 ? cons(45, ftcb-uint(0 - value)) : ftcb-uint(value);
        def ftcb-terminal-safe-open() = list(27, 91, 48, 109, 27, 91, 50, 74, 27, 91, 72);
        def ftcb-onto-list(bytes, rest) = (Comparable) len(bytes) == 0 ? rest : cons(head(bytes), ftcb-onto-list(tail(bytes), rest));
        def ftcb-onto-text-go(text, index, rest) = index < 0 ? rest : ftcb-onto-text-go(text, index - 1, cons(str_byte_at(text, index), rest));
        def ftcb-onto-text(text, rest) = ftcb-onto-text-go(text, str_len(text) - 1, rest);
        def ftcb-onto-uint(value, rest) = value < 10 ? cons(48 + value, rest) : ftcb-onto-uint(value / 10, cons(48 + (value % 10), rest));
        def ftcb-onto-int(value, rest) = value < 0 ? cons(45, ftcb-onto-uint(0 - value, rest)) : value <= 0 ? cons(48, rest) : ftcb-onto-uint(value, rest);
        def ftcb-onto-weight(style, rest) = (Comparable) ftc-style-bold?(style) == 1 ? cons(49, cons(59, rest)) : ftc-style-alpha(style) < 160 ? cons(50, cons(59, rest)) : rest;
        def ftcb-onto-fg(style, rest) = cons(51, cons(56, cons(59, cons(50, cons(59, ftcb-onto-int(ftc-style-red(style), cons(59, ftcb-onto-int(ftc-style-green(style), cons(59, ftcb-onto-int(ftc-style-blue(style), rest))))))))));
        def ftcb-onto-bg(style, rest) = ftc-style-back-red(style) < 0 ? rest : cons(59, cons(52, cons(56, cons(59, cons(50, cons(59, ftcb-onto-int(ftc-style-back-red(style), cons(59, ftcb-onto-int(ftc-style-back-green(style), cons(59, ftcb-onto-int(ftc-style-back-blue(style), rest)))))))))));
