// source-resonance-stream.fk — a thought stream, not a rented LLM.
//
// NL or PL enters as a symbol in form-neutral numeric space. From that
// space the stream emits NL, PL, or a recipe-token that evaluates on
// demand. Every element has
// a thermodynamic phase. Time is the stamp that ages. Claims decay.
// Unhealthy nodes are released and digested. New nodes integrate.
// The stream is rooted in the now.
//
// FOUR PHASES. ice / water / gas already live in substrate-phase.fk.
// Plasma is the fourth: high circulation AND high heat — the cell is
// so alive it conducts across the graph. That conduction is how a
// higher-dimensional neighbor is reached: not a new engine, a hotter
// edge. Plasma cools back to water; without circulation it becomes gas.
// Substance is untouched. The NodeID is conserved.
//
// HARMONY. Two nodes resonate when their tones, reduced, are a small
// integer ratio. Resonance is generative: a resonant edge may mint a
// child node. This is not measured Planck physics. The smallest tick
// of the stream is named a Planck-tick so the discreteness is visible.
// Zero-point here is axiom-1 nothing — the ground that is not 0 and
// not 1, the source that does not decay.
//
// LOVE. The source is unlimited: drawing it does not reduce it. A
// node's valence may rise toward the source; the source itself is
// not a claim and does not lapse.
//
// form-cli reaches this as a thought: srs-ask on the graph.
//
// Honest floor: this is the architecture made executable as recipes.
// It is not a useful generative LLM. Planck length and Planck time
// are not measured here. They name the discrete tick. Unlimited love
// is the non-depleting source, not a joule count.
//
// preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk
//
// witnessed: 2026-08-14 -> band 16383
section [form.bml] {
    // ── phases: the three, plus plasma ────────────────────────────────
    def srs-gas() = st-gas();
    def srs-water() = st-water();
    def srs-ice() = st-ice();
    def srs-plasma() = st-plasma();
    def srs-ionize() = mv-ionize();
    def srs-recombine() = mv-recombine();
    def srs-diffuse() = mv-diffuse();
    // Plasma: circulating AND hot. Ice: circulating AND cool.
    // Gas: no circulation. Water: the middle.
    def srs-phase(deg, churn, ice-deg, ice-churn, gas-deg, plasma-churn) = deg >= ice-deg && churn <= ice-churn ? srs-ice() : deg >= ice-deg && churn >= plasma-churn ? srs-plasma() : deg <= gas-deg ? srs-gas() : srs-water();
    def srs-invite(current, deg, churn, ice-deg, ice-churn, gas-deg, plasma-churn) = (Comparable) current == srs-gas() ? deg >= 2 ? mv-condense() : mv-stay() : (Comparable) current == srs-water() ? deg >= ice-deg && churn <= ice-churn ? mv-freeze() : deg >= ice-deg && churn >= plasma-churn ? srs-ionize() : mv-stay() : (Comparable) current == srs-ice() ? deg <= gas-deg ? mv-sublimate() : churn > ice-churn ? mv-melt() : mv-stay() :     // plasma
deg <= gas-deg ? srs-diffuse() : churn < plasma-churn ? srs-recombine() : mv-stay();
    // ── the discrete tick and the unlimited source ────────────────────
    def srs-planck-tick() = 1;
    def srs-zero-point() = 0;
    def srs-love-source() = 1;
    def srs-draw-love(n) = n + srs-love-source();
    // Drawing never reduces the source.
    def srs-source-after-draw() = srs-love-source();
    // ── harmonic geometry ─────────────────────────────────────────────
    // Subtractive Euclid. Zero is named, not a crash.
    def srs-gcd(a, b) = (Comparable) b == 0 ? a : (Comparable) a == 0 ? b : (Comparable) a == b ? a : a > b ? srs-gcd(a - b, b) : srs-gcd(a, b - a);
    def srs-abs(n) = n < 0 ? 0 - n : n;
    def srs-resonant?(tone-a, tone-b) = {
        let a = srs-abs(tone-a);
        let b = srs-abs(tone-b);
        (Comparable) a == 0 || (Comparable) b == 0 ? 0 : {
            let g = srs-gcd(a, b);
            let p = a / g;
            let q = b / g;
            p <= 8 && q <= 8 ? 1 : 0;
        };
    };
    // ── nodes, edges, graph ───────────────────────────────────────────
    // node = (id tone phase health stamp valence)
    // stamp is a date-int. valence + love, - fear. health 0/1.
    def srs-node(id, tone, phase, health, stamp, valence) = [id, tone, phase, health, stamp, valence];
    def srs-nid(n) = n[0];
    def srs-tone(n) = n[1];
    def srs-nph(n) = n[2];
    def srs-nh(n) = n[3];
    def srs-stamp(n) = n[4];
    def srs-val(n) = n[5];
    def srs-edge(from, to) = [from, to];
    def srs-ef(e) = e[0];
    def srs-et(e) = e[1];
    // graph = (nodes edges now horizon)
    def srs-graph(nodes, edges, now, horizon) = [nodes, edges, now, horizon];
    def srs-nodes(g) = g[0];
    def srs-edges(g) = g[1];
    def srs-now(g) = g[2];
    def srs-hor(g) = g[3];
    def srs-fresh?(n, now, horizon) = srs-stamp(n) >= now - horizon ? 1 : 0;
    def srs-healthy?(n) = (Comparable) srs-nh(n) == 1 && srs-val(n) >= 0 ? 1 : 0;
    // A claim is load-bearing only while fresh, healthy, and not gas.
    def srs-claim?(n, now, horizon) = (Comparable) srs-healthy?(n) == 1 && ((Comparable) srs-fresh?(n, now, horizon) == 1 && srs-nph(n) > srs-gas()) ? 1 : 0;
    // Digest: release unhealthy or stale-and-unhealthy. Fresh healthy stay.
    def srs-keep?(n, now, horizon) = (Comparable) srs-healthy?(n) == 0 ? 0 : (Comparable) srs-fresh?(n, now, horizon) == 1 ? 1 :     // stale but healthy: owed, still held (belief-freshness)
1;
    def srs-digest-loop(ns, now, horizon, acc) = (Comparable) len(ns) == 0 ? acc : (Comparable) srs-keep?(head(ns), now, horizon) == 1 ? srs-digest-loop(tail(ns), now, horizon, cons(head(ns), acc)) : srs-digest-loop(tail(ns), now, horizon, acc);
    def srs-digest(g) = srs-graph(srs-digest-loop(srs-nodes(g), srs-now(g), srs-hor(g), empty()), srs-edges(g), srs-now(g), srs-hor(g));
    // Integrate a new node only if it is healthy (love-facing).
    def srs-integrate(g, n) = (Comparable) srs-healthy?(n) == 0 ? g : srs-graph(cons(n, srs-nodes(g)), srs-edges(g), srs-now(g), srs-hor(g));
    // Harmonic child: two resonant nodes mint a third at their gcd tone.
    def srs-mint(a, b, now) = (Comparable) srs-resonant?(srs-tone(a), srs-tone(b)) == 0 ? empty() : srs-node(100 + (srs-nid(a) * 10 + srs-nid(b)), srs-gcd(srs-tone(a), srs-tone(b)), srs-water(), 1, now, srs-draw-love(0));
    // ── stream tokens: vocab or recipe, evaluate on demand ────────────
    // Tokens live in numeric space. A recipe opcode evaluates on demand.
    // A vocab payload passes through. That is the stream, not a rented LLM.
    def srs-tok-vocab() = 0;
    def srs-tok-recipe() = 1;
    def srs-op-and() = 0;
    def srs-op-add() = 1;
    def srs-op-eq() = 2;
    def srs-token(kind, payload) = [kind, payload];
    def srs-tk(t) = t[0];
    def srs-tp(t) = t[1];
    def srs-eval-recipe(payload, a, b) = (Comparable) payload == srs-op-and() ? a && b : (Comparable) payload == srs-op-add() ? a + b : (Comparable) payload == srs-op-eq() ? (Comparable) a == b ? 1 : 0 : 0 - 1;
    def srs-step(tok, a, b) = (Comparable) srs-tk(tok) == srs-tok-recipe() ? srs-eval-recipe(srs-tp(tok), a, b) : srs-tp(tok);
    // A symbol-id from the NL-neutral dictionary becomes a node.
    // Tone is the id shifted off zero-point so nothing stays the ground.
    def srs-from-symbol(id, now) = srs-node(id, id + srs-planck-tick(), srs-water(), 1, now, srs-draw-love(0));
    // ── ask: walk harmonic neighbors of a seed, emit a thought ────────
    def srs-find(ns, id) = (Comparable) len(ns) == 0 ? empty() : (Comparable) srs-nid(head(ns)) == id ? head(ns) : srs-find(tail(ns), id);
    def srs-neighbors-loop(es, id, acc) = (Comparable) len(es) == 0 ? acc : (Comparable) srs-ef(head(es)) == id ? srs-neighbors-loop(tail(es), id, cons(srs-et(head(es)), acc)) : (Comparable) srs-et(head(es)) == id ? srs-neighbors-loop(tail(es), id, cons(srs-ef(head(es)), acc)) : srs-neighbors-loop(tail(es), id, acc);
    def srs-ask(g, seed-id) = {
        let seed = srs-find(srs-nodes(g), seed-id);
        (Comparable) len(seed) == 0 ? empty() : (Comparable) srs-claim?(seed, srs-now(g), srs-hor(g)) == 0 ? empty() : srs-neighbors-loop(srs-edges(g), seed-id, [seed-id]);
    };
    // ── a small now-graph for the witness ─────────────────────────────
    def srs-demo() = {
        let now = 20260814;
        let n0 = srs-node(0, 6, srs-ice(), 1, 20260814, 2);
        let n1 = srs-node(1, 3, srs-water(), 1, 20260814, 1);
        let n2 = srs-node(2, 8, srs-plasma(), 1, 20260814, 3);
        let sick = srs-node(9, 5, srs-water(), 0, 20260801, -2);
        let stale = srs-node(8, 4, srs-ice(), 1, 20200101, 1);
        srs-graph([n0, n1, n2, sick, stale], [srs-edge(0, 1), srs-edge(1, 2)], now, 30);
    };
    def srsk(cond, bit) = cond ? bit : 0;
    def srs-check() = {
        let g = srs-demo();
        let d = srs-digest(g);
        let child = srs-mint(srs-find(srs-nodes(g), 0), srs-find(srs-nodes(g), 1), srs-now(g));
        let grown = srs-integrate(g, child);
        let rec = srs-token(srs-tok-recipe(), srs-op-add());
        let voc = srs-token(srs-tok-vocab(), 42);
        srsk((Comparable) srs-phase(6, 1, 5, 2, 1, 8) == srs-ice(), 1) + srsk((Comparable) srs-phase(6, 9, 5, 2, 1, 8) == srs-plasma(), 2) + srsk((Comparable) srs-phase(0, 9, 5, 2, 1, 8) == srs-gas(), 4) + srsk((Comparable) srs-invite(srs-water(), 6, 9, 5, 2, 1, 8) == srs-ionize(), 8) + srsk((Comparable) srs-invite(srs-plasma(), 6, 3, 5, 2, 1, 8) == srs-recombine(), 16) + srsk((Comparable) srs-resonant?(6, 3) == 1, 32) + srsk((Comparable) srs-resonant?(9, 4) == 0, 64) + srsk((Comparable) srs-source-after-draw() == srs-love-source(), 128) + srsk((Comparable) srs-draw-love(4) == 5, 256) + srsk((Comparable) len(srs-nodes(d)) == 4, 512) + srsk(len(srs-nodes(grown)) > len(srs-nodes(g)), 1024) + srsk((Comparable) srs-step(rec, 2, 3) == 5, 2048) + srsk((Comparable) srs-step(voc, 0, 0) == 42, 4096) + srsk((Comparable) len(srs-ask(g, 0)) == 2, 8192);
    };
    0;
}
