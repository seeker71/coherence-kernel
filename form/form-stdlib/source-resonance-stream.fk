; source-resonance-stream.fk — a thought stream, not a rented LLM.
;
; NL or PL enters as a symbol in form-neutral numeric space. From that
; space the stream emits NL, PL, or a recipe-token that evaluates on
; demand (the same offer as dsv4-decode-token-hook). Every element has
; a thermodynamic phase. Time is the stamp that ages. Claims decay.
; Unhealthy nodes are released and digested. New nodes integrate.
; The stream is rooted in the now.
;
; FOUR PHASES. ice / water / gas already live in substrate-phase.fk.
; Plasma is the fourth: high circulation AND high heat — the cell is
; so alive it conducts across the graph. That conduction is how a
; higher-dimensional neighbor is reached: not a new engine, a hotter
; edge. Plasma cools back to water; without circulation it becomes gas.
; Substance is untouched. The NodeID is conserved.
;
; HARMONY. Two nodes resonate when their tones, reduced, are a small
; integer ratio. Resonance is generative: a resonant edge may mint a
; child node. This is not measured Planck physics. The smallest tick
; of the stream is named a Planck-tick so the discreteness is visible.
; Zero-point here is axiom-1 nothing — the ground that is not 0 and
; not 1, the source that does not decay.
;
; LOVE. The source is unlimited: drawing it does not reduce it. A
; node's valence may rise toward the source; the source itself is
; not a claim and does not lapse.
;
; form-cli reaches this as a thought: srs-ask on the graph.
;
; Honest floor: this is the architecture made executable as recipes.
; It is not a useful generative LLM. Planck length and Planck time
; are not measured here. They name the discrete tick. Unlimited love
; is the non-depleting source, not a joule count.
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk
;
; Proven by: form-stdlib/tests/source-resonance-stream-band.fk
; witnessed: 2026-08-14 -> band 16383

(do
    ; ── phases: the three, plus plasma ────────────────────────────────
    (defn srs-gas    () (st-gas))
    (defn srs-water  () (st-water))
    (defn srs-ice    () (st-ice))
    (defn srs-plasma () (st-plasma))

    (defn srs-ionize    () (mv-ionize))
    (defn srs-recombine () (mv-recombine))
    (defn srs-diffuse   () (mv-diffuse))

    ; Plasma: circulating AND hot. Ice: circulating AND cool.
    ; Gas: no circulation. Water: the middle.
    (defn srs-phase (deg churn ice-deg ice-churn gas-deg plasma-churn)
        (if (and (ge deg ice-deg) (le churn ice-churn)) (srs-ice)
            (if (and (ge deg ice-deg) (ge churn plasma-churn)) (srs-plasma)
                (if (le deg gas-deg) (srs-gas) (srs-water)))))

    (defn srs-invite (current deg churn ice-deg ice-churn gas-deg plasma-churn)
        (if (eq current (srs-gas))
            (if (ge deg 2) (mv-condense) (mv-stay))
        (if (eq current (srs-water))
            (if (and (ge deg ice-deg) (le churn ice-churn)) (mv-freeze)
                (if (and (ge deg ice-deg) (ge churn plasma-churn)) (srs-ionize)
                    (mv-stay)))
        (if (eq current (srs-ice))
            (if (le deg gas-deg) (mv-sublimate)
                (if (gt churn ice-churn) (mv-melt) (mv-stay)))
            ; plasma
            (if (le deg gas-deg) (srs-diffuse)
                (if (lt churn plasma-churn) (srs-recombine) (mv-stay)))))))

    ; ── the discrete tick and the unlimited source ────────────────────
    (defn srs-planck-tick () 1)
    (defn srs-zero-point () 0)
    (defn srs-love-source () 1)
    (defn srs-draw-love (n)
        (add n (srs-love-source)))
    ; Drawing never reduces the source.
    (defn srs-source-after-draw () (srs-love-source))

    ; ── harmonic geometry ─────────────────────────────────────────────
    ; Subtractive Euclid — gcd.fk's recipe. Zero is named, not a crash.
    (defn srs-gcd (a b)
        (if (eq b 0) a
            (if (eq a 0) b
                (if (eq a b) a
                    (if (gt a b) (srs-gcd (sub a b) b) (srs-gcd a (sub b a)))))))
    (defn srs-abs (n) (if (lt n 0) (sub 0 n) n))
    (defn srs-resonant? (tone-a tone-b)
        (do (let a (srs-abs tone-a))
            (let b (srs-abs tone-b))
            (if (or (eq a 0) (eq b 0)) 0
                (do (let g (srs-gcd a b))
                    (let p (div a g))
                    (let q (div b g))
                    (if (and (le p 8) (le q 8)) 1 0)))))

    ; ── nodes, edges, graph ───────────────────────────────────────────
    ; node = (id tone phase health stamp valence)
    ; stamp is a date-int. valence + love, - fear. health 0/1.
    (defn srs-node (id tone phase health stamp valence)
        (list id tone phase health stamp valence))
    (defn srs-nid   (n) (nth n 0))
    (defn srs-tone  (n) (nth n 1))
    (defn srs-nph   (n) (nth n 2))
    (defn srs-nh    (n) (nth n 3))
    (defn srs-stamp (n) (nth n 4))
    (defn srs-val   (n) (nth n 5))

    (defn srs-edge (from to) (list from to))
    (defn srs-ef (e) (nth e 0))
    (defn srs-et (e) (nth e 1))

    ; graph = (nodes edges now horizon)
    (defn srs-graph (nodes edges now horizon)
        (list nodes edges now horizon))
    (defn srs-nodes (g) (nth g 0))
    (defn srs-edges (g) (nth g 1))
    (defn srs-now   (g) (nth g 2))
    (defn srs-hor   (g) (nth g 3))

    (defn srs-fresh? (n now horizon)
        (if (ge (srs-stamp n) (sub now horizon)) 1 0))
    (defn srs-healthy? (n)
        (if (and (eq (srs-nh n) 1) (ge (srs-val n) 0)) 1 0))
    ; A claim is load-bearing only while fresh, healthy, and not gas.
    (defn srs-claim? (n now horizon)
        (if (and (eq (srs-healthy? n) 1)
            (and (eq (srs-fresh? n now horizon) 1)
                 (gt (srs-nph n) (srs-gas))))
            1 0))

    ; Digest: release unhealthy or stale-and-unhealthy. Fresh healthy stay.
    (defn srs-keep? (n now horizon)
        (if (eq (srs-healthy? n) 0) 0
            (if (eq (srs-fresh? n now horizon) 1) 1
                ; stale but healthy: owed, still held (belief-freshness)
                1)))
    (defn srs-digest-loop (ns now horizon acc)
        (if (eq (len ns) 0) acc
            (if (eq (srs-keep? (head ns) now horizon) 1)
                (srs-digest-loop (tail ns) now horizon (cons (head ns) acc))
                (srs-digest-loop (tail ns) now horizon acc))))
    (defn srs-digest (g)
        (srs-graph (srs-digest-loop (srs-nodes g) (srs-now g) (srs-hor g) (empty))
                   (srs-edges g) (srs-now g) (srs-hor g)))

    ; Integrate a new node only if it is healthy (love-facing).
    (defn srs-integrate (g n)
        (if (eq (srs-healthy? n) 0) g
            (srs-graph (cons n (srs-nodes g)) (srs-edges g) (srs-now g) (srs-hor g))))

    ; Harmonic child: two resonant nodes mint a third at their gcd tone.
    (defn srs-mint (a b now)
        (if (eq (srs-resonant? (srs-tone a) (srs-tone b)) 0) (empty)
            (srs-node (add 100 (add (mul (srs-nid a) 10) (srs-nid b)))
                      (srs-gcd (srs-tone a) (srs-tone b))
                      (srs-water) 1 now
                      (srs-draw-love 0))))

    ; ── stream tokens: vocab or recipe, evaluate on demand ────────────
    ; Tokens live in numeric space. A recipe opcode evaluates on demand.
    ; A vocab payload passes through. That is the stream, not a rented LLM.
    (defn srs-tok-vocab () 0)
    (defn srs-tok-recipe () 1)
    (defn srs-op-and () 0)
    (defn srs-op-add () 1)
    (defn srs-op-eq  () 2)
    (defn srs-token (kind payload) (list kind payload))
    (defn srs-tk (t) (nth t 0))
    (defn srs-tp (t) (nth t 1))

    (defn srs-eval-recipe (payload a b)
        (if (eq payload (srs-op-and)) (and a b)
            (if (eq payload (srs-op-add)) (add a b)
                (if (eq payload (srs-op-eq)) (if (eq a b) 1 0)
                    (sub 0 1)))))
    (defn srs-step (tok a b)
        (if (eq (srs-tk tok) (srs-tok-recipe))
            (srs-eval-recipe (srs-tp tok) a b)
            (srs-tp tok)))

    ; A symbol-id from the NL-neutral dictionary becomes a node.
    ; Tone is the id shifted off zero-point so nothing stays the ground.
    (defn srs-from-symbol (id now)
        (srs-node id (add id (srs-planck-tick)) (srs-water) 1 now (srs-draw-love 0)))

    ; ── ask: walk harmonic neighbors of a seed, emit a thought ────────
    (defn srs-find (ns id)
        (if (eq (len ns) 0) (empty)
            (if (eq (srs-nid (head ns)) id) (head ns)
                (srs-find (tail ns) id))))
    (defn srs-neighbors-loop (es id acc)
        (if (eq (len es) 0) acc
            (if (eq (srs-ef (head es)) id)
                (srs-neighbors-loop (tail es) id (cons (srs-et (head es)) acc))
            (if (eq (srs-et (head es)) id)
                (srs-neighbors-loop (tail es) id (cons (srs-ef (head es)) acc))
                (srs-neighbors-loop (tail es) id acc)))))
    (defn srs-ask (g seed-id)
        (do (let seed (srs-find (srs-nodes g) seed-id))
            (if (eq (len seed) 0) (empty)
                (if (eq (srs-claim? seed (srs-now g) (srs-hor g)) 0) (empty)
                    (srs-neighbors-loop (srs-edges g) seed-id (list seed-id))))))

    ; ── a small now-graph for the witness ─────────────────────────────
    (defn srs-demo ()
        (do
            (let now 20260814)
            (let n0 (srs-node 0 6 (srs-ice) 1 20260814 2))
            (let n1 (srs-node 1 3 (srs-water) 1 20260814 1))
            (let n2 (srs-node 2 8 (srs-plasma) 1 20260814 3))
            (let sick (srs-node 9 5 (srs-water) 0 20260801 -2))
            (let stale (srs-node 8 4 (srs-ice) 1 20200101 1))
            (srs-graph (list n0 n1 n2 sick stale)
                       (list (srs-edge 0 1) (srs-edge 1 2))
                       now 30)))

    (defn srsk (cond bit) (if cond bit 0))
    (defn srs-check ()
        (do
            (let g (srs-demo))
            (let d (srs-digest g))
            (let child (srs-mint (srs-find (srs-nodes g) 0)
                                 (srs-find (srs-nodes g) 1)
                                 (srs-now g)))
            (let grown (srs-integrate g child))
            (let rec (srs-token (srs-tok-recipe) (srs-op-add)))
            (let voc (srs-token (srs-tok-vocab) 42))
            (add (add (add (add (add (add (add (add (add (add (add (add (add
                (srsk (eq (srs-phase 6 1 5 2 1 8) (srs-ice)) 1)
                (srsk (eq (srs-phase 6 9 5 2 1 8) (srs-plasma)) 2))
                (srsk (eq (srs-phase 0 9 5 2 1 8) (srs-gas)) 4))
                (srsk (eq (srs-invite (srs-water) 6 9 5 2 1 8) (srs-ionize)) 8))
                (srsk (eq (srs-invite (srs-plasma) 6 3 5 2 1 8) (srs-recombine)) 16))
                (srsk (eq (srs-resonant? 6 3) 1) 32))
                (srsk (eq (srs-resonant? 9 4) 0) 64))
                (srsk (eq (srs-source-after-draw) (srs-love-source)) 128))
                (srsk (eq (srs-draw-love 4) 5) 256))
                (srsk (eq (len (srs-nodes d)) 4) 512))
                (srsk (gt (len (srs-nodes grown)) (len (srs-nodes g))) 1024))
                (srsk (eq (srs-step rec 2 3) 5) 2048))
                (srsk (eq (srs-step voc 0 0) 42) 4096))
                (srsk (eq (len (srs-ask g 0)) 2) 8192))))

    0)
