// sha256.fk — FIPS 180-4 SHA-256, expressed as a Form recipe.
//
// preludes: form-stdlib/core.fk
//
// source-door surface seam (2026-07-17): the streaming entry's `string_byte_fold`
// is a sibling-kernel native with no fkwu counterpart. A consumer that
// walks the streaming lane preludes
// form-stdlib/string-byte-fold-src-shim.fk (the same contract as real Form
// tissue, byte-recursion depth wall named there) BEFORE this file.
//
// Canonical truth: this recipe MEANS sha256. A kernel with the bitwise
// primitives (band, bor, bxor, bnot_u32, shl_u32, shr_u32, rotr_u32,
// add_u32) can compute the hash from this definition alone — no host
// sha-library required. The recipe stays sovereign across cells.
//
// Opt-in bootstrap: cells that need host-speed dispatch can do
//
//   (register_jit "sha256" "sha256_bytes")
//
// and every (sha256 bytes) call swaps to the kernel's host-native
// implementation. Both paths produce byte-identical output for every
// input — verifiable against FIPS 180-4 test vectors and against each
// other in 20-sha256-as-recipe.
section [form.bml] {
    //; ---- THE LIST FLOOR THIS CELL STANDS ON ------------------------
    //; The `; preludes:` line above is recursive, so core.fk arrives with this
    //; file and `nil?` and `append` are already in scope. No copy of them is
    //; kept here. `nth-rec`, `append-1` and `append-list` keep their names
    //; because the digest cells that prelude this file alone reach them by name.
    //;
    //; `nth-rec` IS the native `nth`. The two meanings are held against each
    //; other over every edge: one
    //; answer at every index inside the list, and where they part the walked
    //; form was the weaker one — at a negative index its base case is an
    //; equality with 0 and its step moves away from it, so it never returned.
    //; One caution travels with the native, for whoever indexes from a
    //; subtraction: fkwu's `nth` CLAMPS a negative index to the first element
    //; and hands it back as a live int, while Go and Rust answer null there.
    //; Every index this cell asks for is inside its list by construction —
    //; state and h8 are 8-lists read at 0..7, k-list and w-list are 64-lists
    //; read at 0..63, a block is 64 bytes read at 0..63, and build-schedule's
    //; i-15, i-2, i-16, i-7 for i in 16..63 land in 0..61 of a list already i
    //; long — and so is every index this file's callers ask for. The digests
    //; never stand where the two meanings used to part.
    def nth-rec(xs, i) = nth(xs, i);
    //; append-1 and append-list mean `(append xs (list x))` and `append`, and
    //; the band proves both. They reach core's `append` against the arithmetic:
    //; `append` is not a native and forwarding adds a frame, so routing there
    //; should have cost. The locale walk said otherwise — 119,437,393 walker
    //; steps with the private bodies, 60,064,908 with these — and the heat
    //; ledger says why. Asked after that same workload: `append` carries
    //; crystal 3 and 1,010,134 heat for work that walked 30,191,048 times
    //; here; `nil?` has no row at all. The private copies carried crystal -1.
    //; A shared door is WARM — the whole body's calls push it past the JIT's
    //; threshold and it stops walking — and a private copy is cold by
    //; construction, because nothing else ever calls it. The duplicate's price
    //; was never the duplication. It was standing outside everyone else's heat.
    def append-1(xs, x) = append(xs, list(x));
    def append-list(xs, ys) = append(xs, ys);
    //; ---- BIG-ENDIAN BYTE / WORD ENCODING ---------------------------
    def u32-to-bytes(w) = list(band(shr_u32(w, 24), 255), band(shr_u32(w, 16), 255), band(shr_u32(w, 8), 255), band(w, 255));
    def bytes-to-u32(b0, b1, b2, b3) = bor(shl_u32(b0, 24), bor(shl_u32(b1, 16), bor(shl_u32(b2, 8), b3)));
    //; ---- PADDING (FIPS 180-4 §5.1.1) -------------------------------
    //; Append 0x80, then zero bytes until len ≡ 56 (mod 64), then the
    //; original message bit-length as a 64-bit big-endian integer.
    //; This implementation assumes byte-length fits in u29 (≤ 64 MB);
    //; sufficient for demo inputs and most cell-to-cell payloads.
    def zero-pad(xs) = (Comparable) (len(xs) % 64) == 56 ? xs : zero-pad(append-1(xs, 0));
    def pad-message(bytes) = {
        let orig-len = len(bytes);
        let bits-lo = orig-len * 8;
        let with-bit = append-1(bytes, 128);
        let padded = zero-pad(with-bit);
        append-list(padded, list(0, 0, 0, 0, band(shr_u32(bits-lo, 24), 255), band(shr_u32(bits-lo, 16), 255), band(shr_u32(bits-lo, 8), 255), band(bits-lo, 255)));
    };
    //; ---- INITIAL HASH VALUES (FIPS 180-4 §5.3.3) -------------------
    //; Values above INT32_MAX use their signed two's-complement spelling.
    //; The u32 primitives interpret both spellings identically, while fkwu's
    //; direct-source .fkb serializer currently admits only signed int32
    //; literals.  This keeps the canonical recipe byte-identical and runnable
    //; directly instead of hiding a source rewrite in a carrier.
    def sha256-h-init() = list(1779033703, 0 - 1150833019, 1013904242, 0 - 1521486534, 1359893119, 0 - 1694144372, 528734635, 1541459225);
    //; ---- ROUND CONSTANTS (FIPS 180-4 §4.2.2) -----------------------
    def sha256-k() = list(1116352408, 1899447441, 0 - 1245643825, 0 - 373957723, 961987163, 1508970993, 0 - 1841331548, 0 - 1424204075, 0 - 670586216, 310598401, 607225278, 1426881987, 1925078388, 0 - 2132889090, 0 - 1680079193, 0 - 1046744716, 0 - 459576895, 0 - 272742522, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 0 - 1740746414, 0 - 1473132947, 0 - 1341970488, 0 - 1084653625, 0 - 958395405, 0 - 710438585, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 0 - 2117940946, 0 - 1838011259, 0 - 1564481375, 0 - 1474664885, 0 - 1035236496, 0 - 949202525, 0 - 778901479, 0 - 694614492, 0 - 200395387, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 0 - 2067236844, 0 - 1933114872, 0 - 1866530822, 0 - 1538233109, 0 - 1090935817, 0 - 965641998);
    //; ---- BUILD 64-WORD MESSAGE SCHEDULE FROM 16 INPUT WORDS --------
    //; w[i] = w[i-16] + s0(w[i-15]) + w[i-7] + s1(w[i-2])   (i ≥ 16)
    def sigma-0(x) = bxor(rotr_u32(x, 7), bxor(rotr_u32(x, 18), shr_u32(x, 3)));
    def sigma-1(x) = bxor(rotr_u32(x, 17), bxor(rotr_u32(x, 19), shr_u32(x, 10)));
    def build-schedule(w, i) = (Comparable) i == 64 ? w : {
        let x = nth(w, i - 15);
        let y = nth(w, i - 2);
        let new-w = add_u32(nth(w, i - 16), add_u32(sigma-0(x), add_u32(nth(w, i - 7), sigma-1(y))));
        build-schedule(append-1(w, new-w), i + 1);
    };
    //; ---- COMPRESSION ROUND -----------------------------------------
    //; Working variables a..h evolve through 64 rounds.
    def big-sigma-0(x) = bxor(rotr_u32(x, 2), bxor(rotr_u32(x, 13), rotr_u32(x, 22)));
    def big-sigma-1(x) = bxor(rotr_u32(x, 6), bxor(rotr_u32(x, 11), rotr_u32(x, 25)));
    def ch(x, y, z) = bxor(band(x, y), band(bnot_u32(x), z));
    def maj(x, y, z) = bxor(band(x, y), bxor(band(x, z), band(y, z)));
    //; State as 8-element list: (a b c d e f g h).
    def compress-round(state, w-list, k-list, i) = (Comparable) i == 64 ? state : {
        let a = nth(state, 0);
        let b = nth(state, 1);
        let c = nth(state, 2);
        let d = nth(state, 3);
        let e = nth(state, 4);
        let f = nth(state, 5);
        let g = nth(state, 6);
        let h = nth(state, 7);
        let t1 = add_u32(h, add_u32(big-sigma-1(e), add_u32(ch(e, f, g), add_u32(nth(k-list, i), nth(w-list, i)))));
        let t2 = add_u32(big-sigma-0(a), maj(a, b, c));
        compress-round(list(add_u32(t1, t2), a, b, c, add_u32(d, t1), e, f, g), w-list, k-list, i + 1);
    };
    //; ---- PER-BLOCK PROCESSING --------------------------------------
    //; Pull 16 u32 words from a 64-byte block (starting at offset off).
    def block-to-words-rec(block, i, acc) = (Comparable) i == 16 ? acc : {
        let p = i * 4;
        let word = bytes-to-u32(nth(block, p), nth(block, p + 1), nth(block, p + 2), nth(block, p + 3));
        block-to-words-rec(block, i + 1, append-1(acc, word));
    };
    def process-block(state, block) = {
        let w16 = block-to-words-rec(block, 0, list());
        let w64 = build-schedule(w16, 16);
        let new-state = compress-round(state, w64, sha256-k(), 0);
        //; Add new state to incoming state, element-wise (u32).
        list(add_u32(nth(state, 0), nth(new-state, 0)), add_u32(nth(state, 1), nth(new-state, 1)), add_u32(nth(state, 2), nth(new-state, 2)), add_u32(nth(state, 3), nth(new-state, 3)), add_u32(nth(state, 4), nth(new-state, 4)), add_u32(nth(state, 5), nth(new-state, 5)), add_u32(nth(state, 6), nth(new-state, 6)), add_u32(nth(state, 7), nth(new-state, 7)));
    };
    //; ---- SPLIT PADDED MESSAGE INTO 64-BYTE BLOCKS, PROCESS EACH ----
    def take-rec(xs, n, acc) = (Comparable) n == 0 ? acc : take-rec(tail(xs), n - 1, append-1(acc, head(xs)));
    def drop-rec(xs, n) = (Comparable) n == 0 ? xs : drop-rec(tail(xs), n - 1);
    def process-all-blocks(state, msg) = (Comparable) len(msg) == 0 ? state : process-all-blocks(process-block(state, take-rec(msg, 64, list())), drop-rec(msg, 64));
    //; ---- STREAMING STRING INPUT ------------------------------------
    //; The ordinary `sha256` entry above accepts a byte-list, which is the
    //; right shape for bounded Form values.  Live request bodies already live
    //; in a kernel string pool.  Turning one of those strings into an N-cell
    //; list before hashing needlessly makes both stack and arena pressure grow
    //; with the request.  The streaming entry keeps exactly four values:
    //;
    //;   (total-byte-length reversed-partial partial-length h8)
    //;
    //; `reversed-partial` is never longer than 63 bytes.  The carrier's
    //; This bounded Form loop supplies raw UTF-8 byte integers and calls this
    //; transition. SHA padding and every compression round remain here; there
    //; is no host SHA or crypto shortcut.
    def sha256-stream-state(total, reversed-partial, partial-length, h8) = list(total, reversed-partial, partial-length, h8);
    def sha256-stream-total(state) = nth(state, 0);
    def sha256-stream-reversed-partial(state) = nth(state, 1);
    def sha256-stream-partial-length(state) = nth(state, 2);
    def sha256-stream-h8(state) = nth(state, 3);
    def sha256-stream-initial() = sha256-stream-state(0, list(), 0, sha256-h-init());
    //; Local bounded reverse: unlike a general input walk this can recurse at
    //; most 64 times, because a full block is compressed immediately.
    def sha256-stream-reverse-onto(xs, acc) = nil?(xs) ? acc : sha256-stream-reverse-onto(tail(xs), cons(head(xs), acc));
    def sha256-stream-reverse(xs) = sha256-stream-reverse-onto(xs, list());
    def sha256-stream-byte-step(state, byte) = {
        let next-total = sha256-stream-total(state) + 1;
        let next-reversed = cons(byte, sha256-stream-reversed-partial(state));
        let next-length = sha256-stream-partial-length(state) + 1;
        (Comparable) next-length == 64 ? sha256-stream-state(next-total, list(), 0, process-block(sha256-stream-h8(state), sha256-stream-reverse(next-reversed))) : sha256-stream-state(next-total, next-reversed, next-length, sha256-stream-h8(state));
    };
    def sha256-stream-fold-string-loop(state, message, index) = index >= str_len(message) ? state : sha256-stream-fold-string-loop(sha256-stream-byte-step(state, str_byte_at(message, index)), message, index + 1);
    def sha256-stream-fold-string-from(state, message) = sha256-stream-fold-string-loop(state, message, 0);
    //; FIPS 180-4 appends the message length modulo 2^64.  Splitting the byte
    //; length before multiplying keeps the low word in range and represents the
    //; full 64-bit bit length as two big-endian u32 words.
    def sha256-stream-bit-length-bytes(total) = {
        let bits-hi = total / 536870912 % 4294967296;
        let bits-lo = total % 536870912 * 8;
        append-list(u32-to-bytes(bits-hi), u32-to-bytes(bits-lo));
    };
    def sha256-stream-h8-bytes(h8) = append-list(u32-to-bytes(nth(h8, 0)), append-list(u32-to-bytes(nth(h8, 1)), append-list(u32-to-bytes(nth(h8, 2)), append-list(u32-to-bytes(nth(h8, 3)), append-list(u32-to-bytes(nth(h8, 4)), append-list(u32-to-bytes(nth(h8, 5)), append-list(u32-to-bytes(nth(h8, 6)), u32-to-bytes(nth(h8, 7)))))))));
    //; Only one or two bounded blocks exist here: partial is 0..63 bytes,
    //; followed by 0x80, zero padding, and the fixed eight-byte length.
    def sha256-stream-finalize(state) = {
        let partial = sha256-stream-reverse(sha256-stream-reversed-partial(state));
        let with-bit = append-1(partial, 128);
        let padded = zero-pad(with-bit);
        let final-blocks = append-list(padded, sha256-stream-bit-length-bytes(sha256-stream-total(state)));
        sha256-stream-h8-bytes(process-all-blocks(sha256-stream-h8(state), final-blocks));
    };
    //; Raw UTF-8 string -> canonical 32-byte SHA-256 digest, without an
    //; input-sized Form list or input-sized Form recursion.
    def sha256-stream-string(message) = sha256-stream-finalize(sha256-stream-fold-string-from(sha256-stream-initial(), message));
    //; ---- THE CANONICAL ENTRY POINT ---------------------------------
    //; (sha256 bytes-list) → 32-byte digest as list of ints.
    def sha256(bytes) = {
        let padded = pad-message(bytes);
        let final = process-all-blocks(sha256-h-init(), padded);
        append-list(u32-to-bytes(nth(final, 0)), append-list(u32-to-bytes(nth(final, 1)), append-list(u32-to-bytes(nth(final, 2)), append-list(u32-to-bytes(nth(final, 3)), append-list(u32-to-bytes(nth(final, 4)), append-list(u32-to-bytes(nth(final, 5)), append-list(u32-to-bytes(nth(final, 6)), u32-to-bytes(nth(final, 7)))))))));
    };
}
