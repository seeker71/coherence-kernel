// peer-turnwheel.fk — many requests, one admitted residence: a cooperative
// token-step scheduler in pure Form. Weights are shared because the residence
// already shares them; KV branches are isolated because q38-new-state already
// hands each conversation its own buffer-handle value. What was missing was
// only the wheel.
//
// THE SHAPE, grounded in the cells it composes with:
//   fcmg's residence header: "the stream state is NOT part of it: state is
//   what one conversation writes" — so one residence, N states, is the
//   EXISTING contract, not an extension. Every q38 decode step threads sts
//   explicitly, so a scheduler that holds N rows and steps them round-robin
//   is continuous batching at interleave granularity — request concurrency,
//   fairness, cancellation and budgets — with zero carrier growth. True
//   batched matmul (one kernel, many rows) is the carrier's later win and is
//   named, not needed, for concurrency to be real.
//
// THE STEPPER IS A FUNCTION VALUE, the answerer discipline again:
//   (stepper sctx row-state) -> (list token row-state' sctx')
// where token is an int, nothing when the model declined, or the stop mark.
// The band drives synthetic steppers; the live q38 stepper binds in the
// resident process, one seam, no reshaping.
//
// THE SIGNALS, each structural:
//   choice   a row finishing leaves the wheel smaller; whoever reads results
//            chooses what to do with them — the wheel never picks a winner
//   cut      wt-cut drops a row NOW; its releaser is returned to the caller,
//            never invoked behind its back (a GPU state deserves an explicit
//            death, and q38-free-state is that door)
//   undo     KV is mutable GPU memory, so undo is REPLAY: every row keeps
//            its emitted tokens, and wt-replay-of hands back the history a
//            fresh state can re-prefill — undo that pretends KV can rewind
//            in place would be the .fkb bug in a new body
//   timeout  per-row step budgets, decremented by the wheel itself; an
//            exhausted row closes as "timeout" with its partial kept
//   nothing  a stepper answering nothing closes the row as "declined",
//            distinct from a row that emitted the stop mark ("done") and
//            from one that ran out ("timeout")
//
// preludes: form-stdlib/core.fk
//
section [form.bml] {
    def wt-stop() = -1;
    // ── a row: one request's whole life on the wheel ───────────────────────
    def wt-row(id, rstate, budget, releaser) = [id, rstate, budget, [], "live", releaser];
    def wt-id(r) = r[0];
    def wt-rstate(r) = r[1];
    def wt-budget(r) = r[2];
    def wt-toks(r) = r[3];
    def wt-status(r) = r[4];
    def wt-releaser(r) = r[5];
    def wt-with(r, rstate, budget, toks, status) = [wt-id(r), rstate, budget, toks, status, wt-releaser(r)];
    // ── the wheel: rows + the shared stepper context, threaded whole ───────
    def wt-wheel(rows, sctx) = [rows, sctx];
    def wt-rows(w) = w[0];
    def wt-sctx(w) = w[1];
    def wt-live?(r) = (String) wt-status(r) == "live" ? 1 : 0;
    def wt-live-count(rs, n) = (Comparable) len(rs) == 0 ? n : wt-live-count(tail(rs), n + wt-live?(head(rs)));
    // ── one revolution: every live row steps once, in order ────────────────
    def wt-step-row(stepper, sctx, r) = (Comparable) wt-live?(r) == 0 ? [r, sctx] : wt-budget(r) <= 0 ? [wt-with(r, wt-rstate(r), 0, wt-toks(r), "timeout"), sctx] : {
        let out = stepper(sctx, wt-rstate(r));
        let tok = out[0];
        let rs2 = out[1];
        let sc2 = out[2];
        nothing?(tok) ? [wt-with(r, rs2, wt-budget(r), wt-toks(r), "declined"), sc2] : (Comparable) tok == wt-stop() ? [wt-with(r, rs2, wt-budget(r), wt-toks(r), "done"), sc2] : [wt-with(r, rs2, wt-budget(r) - 1, append(wt-toks(r), [tok]), "live"), sc2];
    };
    def wt-turn-go(stepper, rs, sctx, out) = (Comparable) len(rs) == 0 ? wt-wheel(reverse(out), sctx) : {
        let sr = wt-step-row(stepper, sctx, head(rs));
        wt-turn-go(stepper, tail(rs), sr[1], cons(sr[0], out));
    };
    def wt-turn(w, stepper) = wt-turn-go(stepper, wt-rows(w), wt-sctx(w), []);
    // run revolutions until no row is live or the wheel budget ends
    def wt-run(w, stepper, wheels) = wheels <= 0 ? w : (Comparable) wt-live-count(wt-rows(w), 0) == 0 ? w : wt-run(wt-turn(w, stepper), stepper, wheels - 1);
    // ── cut: drop a row NOW; hand its releaser back, never invoke it ───────
    // returns (list wheel' releaser) — releaser is nothing if the id is absent
    def wt-cut-go(rs, id, out, found) = (Comparable) len(rs) == 0 ? [reverse(out), found] : (Comparable) wt-id(head(rs)) == id ? wt-cut-go(tail(rs), id, cons(wt-with(head(rs), wt-rstate(head(rs)), wt-budget(head(rs)), wt-toks(head(rs)), "cut"), out), wt-releaser(head(rs))) : wt-cut-go(tail(rs), id, cons(head(rs), out), found);
    def wt-cut(w, id) = {
        let g = wt-cut-go(wt-rows(w), id, [], nothing());
        [wt-wheel(g[0], wt-sctx(w)), g[1]];
    };
    // ── undo as replay: the tokens a fresh state can re-prefill ────────────
    def wt-replay-of(w, id) = {
        let r = wt-find(wt-rows(w), id);
        nothing?(r) ? nothing() : wt-toks(r);
    };
    def wt-find(rs, id) = (Comparable) len(rs) == 0 ? nothing() : (Comparable) wt-id(head(rs)) == id ? head(rs) : wt-find(tail(rs), id);
    0;
}
