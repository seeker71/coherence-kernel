//////////////////////////////////////////////////////////////////////
//
// form-glass-sensor-rows.bml — metric rows cross a gift frame as cells.
//
// Authority: form-stdlib/form-glass-sensor-rows.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-gift-frame.bml
//
// A sensor process gathers the rows that fork or scan -- host, process, owner,
// storage, queue -- at its own cadence and GIVES them into a gift frame per
// sensor. The glass, on its frame path, only asks each frame's sequence
// (microseconds) and re-reads a frame when the sequence moved. The frame holds
// list(schema, sensor, epoch, rows) as the seed own node words -- node_gift_write
// gives it, node_gift_read takes it, no wire and no parser between; a received
// row is the same cell the sensor built. Every row set read from a frame carries
// the frame own witness row (shm name, sequence). A sensor not standing is named absent.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassSensorRowsAuthority {
        field FGSRAuthorityPath = "form/form-stdlib/form-glass-sensor-rows.bml";
        field FGSRAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassSensorRows {
        field FGSRSchema = "form-glass-sensor-rows-v1";
        field FGSRPublisherPrefix = "glass.sensor.";
        field FGSRFrameBytes = 262144;
        field FGSRFieldCount = 18;
        field FGSRDefaultCadenceMs = 1000;
        field FGSRSilentFactor = 3;
        ref fgsr-authority = FormGlassSensorRowsAuthority;
        thought fgsr-law = list("rows-are-the-observer-shape", "seq-before-read", "absent-says-absent", "cells-cross-as-cells", "no-parser-on-the-frame-path");

        // A sensor is body-local when what it MEASURES is body-local. The ear's
        // spool and owner lease belong to this body root; so do the hearth
        // spools the queue sensor counts (`.hearth/task.spool`, relative), and
        // so are the cache and source roots the storage sensor scans (`form/…`,
        // `observe/`, relative). Their shared frames carry that same scope;
        // another checkout is another hearth, not a newer publication of this
        // one. Machine sensors — the accelerator, the host, the process table —
        // stay shared, because the machine is what they measure.
        //
        // Measured 2026-09-10, three sensor fleets standing on this Mac from
        // three checkouts, all publishing `glass.sensor.queue` into one
        // machine-wide frame: consecutive reads of the same door alternated
        // `queue-task-frames=1 … durable spools only` with
        // `queue-task-frames=0 … no durable spools` — the 1 was a six-day-old
        // task frame in /Users/ursmuff/source/coherence-kernel, the 0 was a
        // Codex worktree with no spools at all. Forty ticks of a read-only
        // watch: 39 word changes on the queue rows and 17–18 on each storage
        // catalog row, none of them a change in any body. The bounded door was
        // acquitted in the same measurement — ten runs left the task spool's
        // size and mtime untouched and created no spool here, so the observer
        // was never in this reading; two bodies were.
        def fgsr-body-local?(sensor) = (String) sensor == "ear" ? 1 : (String) sensor == "queue" ? 1 : (String) sensor == "storage" ? 1 : 0;
        def fgsr-publisher-in(sensor, bodyRoot) = FGSRPublisherPrefix() ++ (fgsr-body-local?(sensor) ? sensor ++ "@" ++ bodyRoot : sensor);
        def fgsr-publisher(sensor) = fgsr-publisher-in(sensor, fgsr-body-local?(sensor) ? host_cwd() : "");

        // --- wire: one row per line, eighteen constructor fields joined by | -----
        def fgsr-row-wire(row) = fgd-cat(list(
            row[1], "|", row[2], "|", row[3], "|", row[4], "|", int_to_str(row[5]), "|", row[6], "|", int_to_str(row[7]), "|", row[8], "|", int_to_str(row[9]), "|", int_to_str(row[10]), "|", int_to_str(row[11]), "|", int_to_str(row[12]), "|", row[13], "|", row[14], "|", row[15], "|", row[16], "|", row[17], "|", row[18]));
        def fgsr-rows-wire(rows) = (Comparable) len(rows) == 0 ? "" : (Comparable) len(rows) == 1 ? fgsr-row-wire(head(rows)) : fgsr-row-wire(head(rows)) ++ byte_to_str(10) ++ fgsr-rows-wire(tail(rows));
        def fgsr-wire(sensor, epoch, rows) = fgd-cat(list(FGSRSchema(), "|", sensor, "|", int_to_str(epoch), "|", int_to_str(len(rows)), byte_to_str(10), fgsr-rows-wire(rows)));

        // --- parse -------------------------------------------------------------
        def fgsr-split-go(text, sep, from, acc) {
            let at = str_find(text, sep, from);
            at < 0 ? reverse(cons(substring(text, from, str_len(text)), acc)) : fgsr-split-go(text, sep, at + str_len(sep), cons(substring(text, from, at), acc));
        }
        def fgsr-split(text, sep) = (Comparable) str_len(text) == 0 ? list() : fgsr-split-go(text, sep, 0, list());
        def fgsr-int-of(text) = (Comparable) str_len(text) == 0 ? 0 : str_to_int(text);
        def fgsr-row-of(fields) = !((Comparable) len(fields) == FGSRFieldCount()) ? list() : fgo-metric(fields[0], fields[1], fields[2], fields[3], fgsr-int-of(fields[4]), fields[5], fgsr-int-of(fields[6]), fields[7], fgsr-int-of(fields[8]), fgsr-int-of(fields[9]), fgsr-int-of(fields[10]), fgsr-int-of(fields[11]), fields[12], fields[13], fields[14], fields[15], fields[16], fields[17]);
        def fgsr-rows-of(lines) = (Comparable) len(lines) == 0 ? list() : fgsr-rows-of-next(fgsr-row-of(fgsr-split(head(lines), "|")), tail(lines));
        def fgsr-rows-of-next(row, rest) = (Comparable) len(row) == 0 ? fgsr-rows-of(rest) : cons(row, fgsr-rows-of(rest));
        // list(schema, sensor, epoch, rows) or list() when the text is not this wire
        def fgsr-parse(text) {
            let lines = fgsr-split(text, byte_to_str(10));
            let header = (Comparable) len(lines) == 0 ? list() : fgsr-split(head(lines), "|");
            (len(header) < 4) || (!((String) header[0] == FGSRSchema())) ? list() : list(FGSRSchema(), header[1], fgsr-int-of(header[2]), fgsr-rows-of(tail(lines)));
        }
        def fgsr-parsed-sensor(p) = p[1];
        def fgsr-parsed-epoch(p) = p[2];
        def fgsr-parsed-rows(p) = p[3];

        // --- give (the sensor side): the frame carries list(schema, sensor, epoch, rows, cadence) as cells ---
        // the cadence is the sensor's own declaration, in ms between gives; a reader that sees no new give past
        // three cadences marks the frame silent -- a live process whose frame stopped moving is not a live number
        def fgsr-declared-cadence(sensor) = (String) sensor == "jungle" ? 1000 : (String) sensor == "prosody" ? 100 : (String) sensor == "ear" ? 100 : (String) sensor == "machine" ? 50 : (String) sensor == "glass" ? 50 : (String) sensor == "queue" ? 250 : (String) sensor == "organs" ? 500 : (String) sensor == "host" ? 1500 : (String) sensor == "storage" ? 5000 : (String) sensor == "census" ? 10000 : FGSRDefaultCadenceMs();
        def fgsr-frame-at(sensor, epoch, rows, cadence) = list(FGSRSchema(), sensor, epoch, rows, cadence);
        def fgsr-frame(sensor, epoch, rows) = fgsr-frame-at(sensor, epoch, rows, fgsr-declared-cadence(sensor));
        def fgsr-frame-cadence(f) = len(f) >= 5 ? f[4] : FGSRDefaultCadenceMs();
        def fgsr-give(sensor, epoch, rows) = fgsr-give-at(sensor, epoch, rows, fgsr-declared-cadence(sensor));
        def fgsr-give-at(sensor, epoch, rows, cadence) {
            let handle = ggf-offer(fgsr-publisher(sensor), FGSRFrameBytes());
            let seq = nothing?(handle) ? nothing() : node_gift_write(handle, fgsr-frame-at(sensor, epoch, rows, cadence));
            let released = ggf-release(handle);
            nothing?(seq) ? list(GGFSchema(), "refused", fgsr-publisher(sensor), "", -1) : list(GGFSchema(), "given", fgsr-publisher(sensor), "", seq);
        }

        // --- take (the glass side): seq first, read the cells only when it moved ---
        // held = list(seq, epoch, rows, cadence); answers a new held or the same one.
        def fgsr-held-at(seq, epoch, rows, cadence) = list(seq, epoch, rows, cadence);
        def fgsr-held(seq, epoch, rows) = fgsr-held-at(seq, epoch, rows, FGSRDefaultCadenceMs());
        def fgsr-held-cadence(h) = len(h) < 4 ? FGSRDefaultCadenceMs() : h[3];
        def fgsr-held-seq(h) = (Comparable) len(h) == 0 ? -1 : h[0];
        def fgsr-held-epoch(h) = (Comparable) len(h) == 0 ? -1 : h[1];
        def fgsr-held-rows(h) = (Comparable) len(h) == 0 ? list() : h[2];
        def fgsr-frame-valid?(f) = nothing?(f) ? 0 : (!((Comparable) len(f) == 4)) && (!((Comparable) len(f) == 5)) ? 0 : !((String) f[0] == FGSRSchema()) ? 0 : 1;
        def fgsr-take(sensor, held) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let seq = ggf-seq(handle);
            let moved = nothing?(handle) ? 0 : (Comparable) seq == fgsr-held-seq(held) ? 0 : 1;
            let frame = (Comparable) moved == 1 ? node_gift_read(handle) : nothing();
            let released = ggf-release(handle);
            (Comparable) moved == 0 ? held : !((Comparable) fgsr-frame-valid?(frame) == 1) ? held : fgsr-held-at(seq, frame[2], frame[3], fgsr-frame-cadence(frame));
        }
        def fgsr-standing?(sensor) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let standing = nothing?(handle) ? 0 : 1;
            let released = ggf-release(handle);
            standing;
        }
        // --- the kept lane: the same take and give over a handle the glass keeps open for its life (ggf-kept-*) ---
        // held carries the frame's shm name as a fifth cell, so the frame row names its read surface without hashing the publisher again
        def fgsr-held-named(seq, epoch, rows, cadence, name) = list(seq, epoch, rows, cadence, name);
        def fgsr-held-name(h, sensor) = len(h) < 5 ? ggf-name(fgsr-publisher(sensor)) : h[4];
        def fgsr-take-held(handle, name, held) {
            let seq = ggf-seq(handle);
            let moved = nothing?(handle) ? 0 : (Comparable) seq == fgsr-held-seq(held) ? 0 : 1;
            let frame = (Comparable) moved == 1 ? node_gift_read(handle) : nothing();
            (Comparable) moved == 0 ? held : !((Comparable) fgsr-frame-valid?(frame) == 1) ? held : fgsr-held-named(seq, frame[2], frame[3], fgsr-frame-cadence(frame), name);
        }
        def fgsr-give-held(handle, sensor, epoch, rows) {
            let seq = nothing?(handle) ? nothing() : node_gift_write(handle, fgsr-frame(sensor, epoch, rows));
            nothing?(seq) ? list(GGFSchema(), "refused", fgsr-publisher(sensor), "", -1) : list(GGFSchema(), "given", fgsr-publisher(sensor), "", seq);
        }
        // when no sensor stands, one row says so by name instead of silence
        def fgsr-absent-row(sensor) = fgo-unavailable("sensor", "sensor-" ++ sensor, "sensor " ++ sensor, "rows", "membrane", "gift:" ++ fgsr-publisher(sensor), "health", "no sensor process is giving this frame; run observe/form-glass-sensors-live.fk");
        // the read surface names itself: one row per frame read -- the shared-memory name, the sequence the rows were taken at, and
        // whether the publisher is still giving: age past three declared cadences is silent, and every row taken from a silent frame
        // carries that truth instead of a confident number (an alive process whose newest frame is hours old is not a live gauge)
        def fgsr-age-at(held, epoch) = fgsr-held-epoch(held) < 0 ? -1 : epoch >= fgsr-held-epoch(held) ? (epoch - fgsr-held-epoch(held)) : 0;
        def fgsr-silent?(held, epoch) = fgsr-age-at(held, epoch) < 0 ? 0 : fgsr-age-at(held, epoch) > (FGSRSilentFactor() * fgsr-held-cadence(held)) ? 1 : 0;
        def fgsr-silence-note(held, epoch) = fgd-cat(list("silent: last give ", fgd-format-age-ms(fgsr-age-at(held, epoch)), " ago, declared cadence ", int_to_str(fgsr-held-cadence(held)), " ms; the publisher is alive-and-silent or gone, its numbers are not current"));
        def fgsr-frame-row-value(sensor, held, epoch) = (Comparable) fgsr-silent?(held, epoch) == 1 ? fgo-int("gift", "frame." ++ sensor, "gift frame " ++ sensor, fgsr-held-seq(held), "sequence", 0, "unified", "silent", "shm:" ++ fgsr-held-name(held, sensor), "silent", "gift", fgsr-silence-note(held, epoch)) : fgo-int("gift", "frame." ++ sensor, "gift frame " ++ sensor, fgsr-held-seq(held), "sequence", 0, "unified", "physical-live", "shm:" ++ fgsr-held-name(held, sensor), "live", "gift", fgd-cat(list("sequence of the shared-memory frame these rows were read from; the frame is the read surface; cadence ", int_to_str(fgsr-held-cadence(held)), " ms, age ", fgd-format-age-ms(fgsr-age-at(held, epoch)))));
        def fgsr-frame-row-at(sensor, held, epoch) = fgo-observe-row(fgsr-frame-row-value(sensor, held, epoch), fgsr-held-epoch(held), fgsr-held-seq(held));
        def fgsr-frame-row(sensor, held) = fgsr-frame-row-at(sensor, held, now_unix_ms());
        // A row with its own clock keeps it. Otherwise the carried frame gives
        // its publication age, not a newly invented sensor capture time.
        def fgsr-publication-stamps(rows, held) = (Comparable) len(rows) == 0 ? list() : cons(fgo-observed-epoch(head(rows)) < 0 ? fgo-observe-row(head(rows), fgsr-held-epoch(held), fgsr-held-seq(held)) : head(rows), fgsr-publication-stamps(tail(rows), held));
        def fgsr-rows-or-absent-at(sensor, held, epoch) {
            let rows = fgsr-publication-stamps(fgsr-held-rows(held), held);
            (Comparable) len(rows) == 0 ? list(fgsr-absent-row(sensor)) : (Comparable) fgsr-silent?(held, epoch) == 1 ? cons(fgsr-frame-row-at(sensor, held, epoch), fgo-rows-with-truth(rows, "silent", "silent")) : cons(fgsr-frame-row-at(sensor, held, epoch), rows);
        }
        def fgsr-rows-or-absent(sensor, held) = fgsr-rows-or-absent-at(sensor, held, now_unix_ms());
    }
    0;
}
