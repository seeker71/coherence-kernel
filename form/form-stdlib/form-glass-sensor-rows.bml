//////////////////////////////////////////////////////////////////////
//
// form-glass-sensor-rows.bml — metric rows cross a gift frame as cells.
//
// Authority: form-stdlib/bml/form-glass-sensor-rows.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-gift-frame.bml
//
// A sensor process gathers the rows that fork or scan -- host, process, owner,
// storage, queue -- at its own cadence and GIVES them into a gift frame per
// sensor. The glass, on its frame path, only asks each frame's sequence
// (microseconds) and re-reads a frame when the sequence moved. The frame holds
// list(schema, sensor, epoch, rows) as the seed own node words -- node_gift_write
// gives it, node_gift_read takes it, no wire and no parser between; a received
// row is the same cell the sensor built. Every row set read from a frame carries
// the frame own witness row (shm name, sequence). A sensor not standing is named absent.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassSensorRowsAuthority {
        field FGSRAuthorityPath = "form/form-stdlib/bml/form-glass-sensor-rows.bml";
        field FGSRAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassSensorRows {
        field FGSRSchema = "form-glass-sensor-rows-v1";
        field FGSRPublisherPrefix = "glass.sensor.";
        field FGSRFrameBytes = 262144;
        field FGSRFieldCount = 18;
        field FGSRDefaultCadenceMs = 1000;
        field FGSRSilentFactor = 3;
        ref fgsr-authority = FormGlassSensorRowsAuthority;
        thought fgsr-law = list("rows-are-the-observer-shape", "seq-before-read", "absent-says-absent", "cells-cross-as-cells", "no-parser-on-the-frame-path");

        // The ear's spool and owner lease belong to this body root. Its shared
        // frame must carry the same scope; another checkout is another speaker,
        // not a newer publication of this speaker. Machine sensors stay shared.
        def fgsr-body-local?(sensor) = str_eq(sensor, "ear");
        def fgsr-publisher-in(sensor, bodyRoot) = str_concat(FGSRPublisherPrefix(), if fgsr-body-local?(sensor) then str_concat(sensor, str_concat("@", bodyRoot)) else sensor);
        def fgsr-publisher(sensor) = fgsr-publisher-in(sensor, if fgsr-body-local?(sensor) then host_cwd() else "");

        // --- wire: one row per line, eighteen constructor fields joined by | -----
        def fgsr-row-wire(row) = fgd-cat(list(
            nth(row, 1), "|", nth(row, 2), "|", nth(row, 3), "|", nth(row, 4), "|", int_to_str(nth(row, 5)), "|", nth(row, 6), "|", int_to_str(nth(row, 7)), "|", nth(row, 8), "|", int_to_str(nth(row, 9)), "|", int_to_str(nth(row, 10)), "|", int_to_str(nth(row, 11)), "|", int_to_str(nth(row, 12)), "|", nth(row, 13), "|", nth(row, 14), "|", nth(row, 15), "|", nth(row, 16), "|", nth(row, 17), "|", nth(row, 18)));
        def fgsr-rows-wire(rows) = if eq(len(rows), 0) then "" else if eq(len(rows), 1) then fgsr-row-wire(head(rows)) else str_concat(fgsr-row-wire(head(rows)), str_concat(byte_to_str(10), fgsr-rows-wire(tail(rows))));
        def fgsr-wire(sensor, epoch, rows) = fgd-cat(list(FGSRSchema(), "|", sensor, "|", int_to_str(epoch), "|", int_to_str(len(rows)), byte_to_str(10), fgsr-rows-wire(rows)));

        // --- parse -------------------------------------------------------------
        def fgsr-split-go(text, sep, from, acc) {
            let at = str_find(text, sep, from);
            if lt(at, 0) then reverse(cons(substring(text, from, str_len(text)), acc)) else fgsr-split-go(text, sep, add(at, str_len(sep)), cons(substring(text, from, at), acc));
        }
        def fgsr-split(text, sep) = if eq(str_len(text), 0) then list() else fgsr-split-go(text, sep, 0, list());
        def fgsr-int-of(text) = if eq(str_len(text), 0) then 0 else str_to_int(text);
        def fgsr-row-of(fields) = if not(eq(len(fields), FGSRFieldCount())) then list() else fgo-metric(nth(fields, 0), nth(fields, 1), nth(fields, 2), nth(fields, 3), fgsr-int-of(nth(fields, 4)), nth(fields, 5), fgsr-int-of(nth(fields, 6)), nth(fields, 7), fgsr-int-of(nth(fields, 8)), fgsr-int-of(nth(fields, 9)), fgsr-int-of(nth(fields, 10)), fgsr-int-of(nth(fields, 11)), nth(fields, 12), nth(fields, 13), nth(fields, 14), nth(fields, 15), nth(fields, 16), nth(fields, 17));
        def fgsr-rows-of(lines) = if eq(len(lines), 0) then list() else fgsr-rows-of-next(fgsr-row-of(fgsr-split(head(lines), "|")), tail(lines));
        def fgsr-rows-of-next(row, rest) = if eq(len(row), 0) then fgsr-rows-of(rest) else cons(row, fgsr-rows-of(rest));
        // list(schema, sensor, epoch, rows) or list() when the text is not this wire
        def fgsr-parse(text) {
            let lines = fgsr-split(text, byte_to_str(10));
            let header = if eq(len(lines), 0) then list() else fgsr-split(head(lines), "|");
            if or(lt(len(header), 4), not(str_eq(nth(header, 0), FGSRSchema()))) then list() else list(FGSRSchema(), nth(header, 1), fgsr-int-of(nth(header, 2)), fgsr-rows-of(tail(lines)));
        }
        def fgsr-parsed-sensor(p) = nth(p, 1);
        def fgsr-parsed-epoch(p) = nth(p, 2);
        def fgsr-parsed-rows(p) = nth(p, 3);

        // --- give (the sensor side): the frame carries list(schema, sensor, epoch, rows, cadence) as cells ---
        // the cadence is the sensor's own declaration, in ms between gives; a reader that sees no new give past
        // three cadences marks the frame silent -- a live process whose frame stopped moving is not a live number
        def fgsr-declared-cadence(sensor) = if str_eq(sensor, "jungle") then 1000 else if str_eq(sensor, "prosody") then 100 else if str_eq(sensor, "ear") then 100 else if str_eq(sensor, "machine") then 50 else if str_eq(sensor, "glass") then 50 else if str_eq(sensor, "queue") then 250 else if str_eq(sensor, "organs") then 500 else if str_eq(sensor, "host") then 1500 else if str_eq(sensor, "storage") then 5000 else FGSRDefaultCadenceMs();
        def fgsr-frame-at(sensor, epoch, rows, cadence) = list(FGSRSchema(), sensor, epoch, rows, cadence);
        def fgsr-frame(sensor, epoch, rows) = fgsr-frame-at(sensor, epoch, rows, fgsr-declared-cadence(sensor));
        def fgsr-frame-cadence(f) = if ge(len(f), 5) then nth(f, 4) else FGSRDefaultCadenceMs();
        def fgsr-give(sensor, epoch, rows) = fgsr-give-at(sensor, epoch, rows, fgsr-declared-cadence(sensor));
        def fgsr-give-at(sensor, epoch, rows, cadence) {
            let handle = ggf-offer(fgsr-publisher(sensor), FGSRFrameBytes());
            let seq = if nothing?(handle) then nothing() else node_gift_write(handle, fgsr-frame-at(sensor, epoch, rows, cadence));
            let released = ggf-release(handle);
            if nothing?(seq) then list(GGFSchema(), "refused", fgsr-publisher(sensor), "", -1) else list(GGFSchema(), "given", fgsr-publisher(sensor), "", seq);
        }

        // --- take (the glass side): seq first, read the cells only when it moved ---
        // held = list(seq, epoch, rows, cadence); answers a new held or the same one.
        def fgsr-held-at(seq, epoch, rows, cadence) = list(seq, epoch, rows, cadence);
        def fgsr-held(seq, epoch, rows) = fgsr-held-at(seq, epoch, rows, FGSRDefaultCadenceMs());
        def fgsr-held-cadence(h) = if lt(len(h), 4) then FGSRDefaultCadenceMs() else nth(h, 3);
        def fgsr-held-seq(h) = if eq(len(h), 0) then -1 else nth(h, 0);
        def fgsr-held-epoch(h) = if eq(len(h), 0) then -1 else nth(h, 1);
        def fgsr-held-rows(h) = if eq(len(h), 0) then list() else nth(h, 2);
        def fgsr-frame-valid?(f) = if nothing?(f) then 0 else if and(not(eq(len(f), 4)), not(eq(len(f), 5))) then 0 else if not(str_eq(nth(f, 0), FGSRSchema())) then 0 else 1;
        def fgsr-take(sensor, held) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let seq = ggf-seq(handle);
            let moved = if nothing?(handle) then 0 else if eq(seq, fgsr-held-seq(held)) then 0 else 1;
            let frame = if eq(moved, 1) then node_gift_read(handle) else nothing();
            let released = ggf-release(handle);
            if eq(moved, 0) then held else if not(eq(fgsr-frame-valid?(frame), 1)) then held else fgsr-held-at(seq, nth(frame, 2), nth(frame, 3), fgsr-frame-cadence(frame));
        }
        def fgsr-standing?(sensor) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let standing = if nothing?(handle) then 0 else 1;
            let released = ggf-release(handle);
            standing;
        }
        // --- the kept lane: the same take and give over a handle the glass keeps open for its life (ggf-kept-*) ---
        // held carries the frame's shm name as a fifth cell, so the frame row names its read surface without hashing the publisher again
        def fgsr-held-named(seq, epoch, rows, cadence, name) = list(seq, epoch, rows, cadence, name);
        def fgsr-held-name(h, sensor) = if lt(len(h), 5) then ggf-name(fgsr-publisher(sensor)) else nth(h, 4);
        def fgsr-take-held(handle, name, held) {
            let seq = ggf-seq(handle);
            let moved = if nothing?(handle) then 0 else if eq(seq, fgsr-held-seq(held)) then 0 else 1;
            let frame = if eq(moved, 1) then node_gift_read(handle) else nothing();
            if eq(moved, 0) then held else if not(eq(fgsr-frame-valid?(frame), 1)) then held else fgsr-held-named(seq, nth(frame, 2), nth(frame, 3), fgsr-frame-cadence(frame), name);
        }
        def fgsr-give-held(handle, sensor, epoch, rows) {
            let seq = if nothing?(handle) then nothing() else node_gift_write(handle, fgsr-frame(sensor, epoch, rows));
            if nothing?(seq) then list(GGFSchema(), "refused", fgsr-publisher(sensor), "", -1) else list(GGFSchema(), "given", fgsr-publisher(sensor), "", seq);
        }
        // when no sensor stands, one row says so by name instead of silence
        def fgsr-absent-row(sensor) = fgo-unavailable("sensor", str_concat("sensor-", sensor), str_concat("sensor ", sensor), "rows", "membrane", str_concat("gift:", fgsr-publisher(sensor)), "health", "no sensor process is giving this frame; run observe/form-glass-sensors-live.fk");
        // the read surface names itself: one row per frame read -- the shared-memory name, the sequence the rows were taken at, and
        // whether the publisher is still giving: age past three declared cadences is silent, and every row taken from a silent frame
        // carries that truth instead of a confident number (an alive process whose newest frame is hours old is not a live gauge)
        def fgsr-age-at(held, epoch) = if lt(fgsr-held-epoch(held), 0) then -1 else if ge(epoch, fgsr-held-epoch(held)) then sub(epoch, fgsr-held-epoch(held)) else 0;
        def fgsr-silent?(held, epoch) = if lt(fgsr-age-at(held, epoch), 0) then 0 else if gt(fgsr-age-at(held, epoch), mul(FGSRSilentFactor(), fgsr-held-cadence(held))) then 1 else 0;
        def fgsr-silence-note(held, epoch) = fgd-cat(list("silent: last give ", fgd-format-age-ms(fgsr-age-at(held, epoch)), " ago, declared cadence ", int_to_str(fgsr-held-cadence(held)), " ms; the publisher is alive-and-silent or gone, its numbers are not current"));
        def fgsr-frame-row-value(sensor, held, epoch) = if eq(fgsr-silent?(held, epoch), 1) then fgo-int("gift", str_concat("frame.", sensor), str_concat("gift frame ", sensor), fgsr-held-seq(held), "sequence", 0, "unified", "silent", str_concat("shm:", fgsr-held-name(held, sensor)), "silent", "gift", fgsr-silence-note(held, epoch)) else fgo-int("gift", str_concat("frame.", sensor), str_concat("gift frame ", sensor), fgsr-held-seq(held), "sequence", 0, "unified", "physical-live", str_concat("shm:", fgsr-held-name(held, sensor)), "live", "gift", fgd-cat(list("sequence of the shared-memory frame these rows were read from; the frame is the read surface; cadence ", int_to_str(fgsr-held-cadence(held)), " ms, age ", fgd-format-age-ms(fgsr-age-at(held, epoch)))));
        def fgsr-frame-row-at(sensor, held, epoch) = fgo-observe-row(fgsr-frame-row-value(sensor, held, epoch), fgsr-held-epoch(held), fgsr-held-seq(held));
        def fgsr-frame-row(sensor, held) = fgsr-frame-row-at(sensor, held, now_unix_ms());
        // A row with its own clock keeps it. Otherwise the carried frame gives
        // its publication age, not a newly invented sensor capture time.
        def fgsr-publication-stamps(rows, held) = if eq(len(rows), 0) then list() else cons(if lt(fgo-observed-epoch(head(rows)), 0) then fgo-observe-row(head(rows), fgsr-held-epoch(held), fgsr-held-seq(held)) else head(rows), fgsr-publication-stamps(tail(rows), held));
        def fgsr-rows-or-absent-at(sensor, held, epoch) {
            let rows = fgsr-publication-stamps(fgsr-held-rows(held), held);
            if eq(len(rows), 0) then list(fgsr-absent-row(sensor)) else if eq(fgsr-silent?(held, epoch), 1) then cons(fgsr-frame-row-at(sensor, held, epoch), fgo-rows-with-truth(rows, "silent", "silent")) else cons(fgsr-frame-row-at(sensor, held, epoch), rows);
        }
        def fgsr-rows-or-absent(sensor, held) = fgsr-rows-or-absent-at(sensor, held, now_unix_ms());
    }
    0;
}
