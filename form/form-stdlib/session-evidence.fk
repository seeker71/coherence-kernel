; session-evidence.fk — trust gate for a local transcript session bundle.
;
; The host carrier moves audio and computes hashes. This Form cell owns the
; meaning of the evidence: explicit consent, private local storage, complete
; source links, honest unknown speakers, and observed ASR. A participant-reviewed
; name is known; every other speaker remains unknown. Unknown is healthy evidence,
; not a vacancy to fill with a guess.
;
; preludes: form-stdlib/core.fk

(do
    (defn ses-consent? (explicit) (if (eq explicit 1) 1 0))
    (defn ses-local? (local) (if (eq local 1) 1 0))
    (defn ses-private? (private-local) (if (eq private-local 1) 1 0))
    (defn ses-complete? (complete) (if (eq complete 1) 1 0))
    (defn ses-has-segments? (segments) (if (gt segments 0) 1 0))

    (defn ses-speaker-partition? (segments known unknown)
        (if (and (ge known 0)
                 (and (ge unknown 0) (eq (add known unknown) segments))) 1 0))

    (defn ses-overlap-honest? (segments overlap)
        (if (and (ge overlap 0) (ge segments overlap)) 1 0))

    (defn ses-all-source-linked? (segments source-links)
        (if (eq segments source-links) 1 0))

    (defn ses-quotes-grounded? (source-links quotes)
        (if (and (ge quotes 0) (ge source-links quotes)) 1 0))

    (defn ses-audio-present? (audio-bytes)
        (if (gt audio-bytes 44) 1 0))

    (defn ses-timeline-sane? (start-ms end-ms)
        (if (and (ge start-ms 0) (gt end-ms start-ms)) 1 0))

    (defn ses-integrity? (integrity) (if (eq integrity 1) 1 0))
    (defn ses-asr-observed? (observed) (if (eq observed 1) 1 0))

    ; Known labels must all carry participant/human review evidence. This is the
    ; boundary that prevents a diarizer's convenient guess from becoming identity.
    (defn ses-known-labels-reviewed? (known reviewed)
        (if (and (ge reviewed 0) (eq known reviewed)) 1 0))

    ; Verdict 16383 means all fourteen trust dimensions were observed together.
    (defn ses-session-verdict
        (consent local private-local complete segments known unknown overlap source-links
         quotes audio-bytes start-ms end-ms integrity asr-observed reviewed)
        (do
            (let c0  (if (eq (ses-consent? consent) 1) 1 0))
            (let c1  (if (eq (ses-local? local) 1) 2 0))
            (let c2  (if (eq (ses-private? private-local) 1) 4 0))
            (let c3  (if (eq (ses-complete? complete) 1) 8 0))
            (let c4  (if (eq (ses-has-segments? segments) 1) 16 0))
            (let c5  (if (eq (ses-speaker-partition? segments known unknown) 1) 32 0))
            (let c6  (if (eq (ses-overlap-honest? segments overlap) 1) 64 0))
            (let c7  (if (eq (ses-all-source-linked? segments source-links) 1) 128 0))
            (let c8  (if (eq (ses-quotes-grounded? source-links quotes) 1) 256 0))
            (let c9  (if (eq (ses-audio-present? audio-bytes) 1) 512 0))
            (let c10 (if (eq (ses-timeline-sane? start-ms end-ms) 1) 1024 0))
            (let c11 (if (eq (ses-integrity? integrity) 1) 2048 0))
            (let c12 (if (eq (ses-asr-observed? asr-observed) 1) 4096 0))
            (let c13 (if (eq (ses-known-labels-reviewed? known reviewed) 1) 8192 0))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6
                (add c7 (add c8 (add c9 (add c10 (add c11 (add c12 c13)))))))))))))))

    0)
