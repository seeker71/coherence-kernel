; q3k-demo.fk — the Q3_K fixture and the recipe's answer, for the device gate.
;
; The block is q3k-dequant-band.fk's, byte for byte, so the GPU is judged on the
; same superblock the recipe was judged on against ggml. Emitted on fkwu with
; print_str; every float crosses as round(x * 1e9), and the stream is read to its
; END sentinel rather than filtered by content — a Q3_K block is full of
; legitimate zero bytes and `grep -v '^0$'` would eat them, which is how the
; router's first dispatch was corrupted.
;
; preludes: form-stdlib/core.fk form-stdlib/f16-decode.fk form-stdlib/q3k-dequant.fk

(do
    (defn q3d-nl (s) (print_str s))
    (defn q3d-i (n) (q3d-nl (int_to_str n)))
    (defn q3d-scaled (x) (math_floor (add (mul x 1000000000.0) 0.5)))
    (defn q3d-ilist (xs) (if (eq (len xs) 0) (q3d-nl "ENDVEC") (do (q3d-i (head xs)) (q3d-ilist (tail xs)))))
    (defn q3d-ivec (name xs) (do (q3d-nl (str_concat "VEC " name)) (q3d-ilist xs)))
    (defn q3d-scalar (name v) (do (q3d-nl (str_concat "SCALAR " name)) (q3d-i v)))

    (defn q3d-blk ()
        (list 5 42 79 116 153 190 227 8 45 82 119 156 193 230 11 48
              85 122 159 196 233 14 51 88 125 162 199 236 17 54 91 128
              11 64 117 170 223 20 73 126 179 232 29 82 135 188 241 38
              91 144 197 250 47 100 153 206 3 56 109 162 215 12 65 118
              171 224 21 74 127 180 233 30 83 136 189 242 39 92 145 198
              251 48 101 154 207 4 57 110 163 216 13 66 119 172 225 22
              7 36 65 94 123 152 181 210 239 12 41 70
              0 52))
    ; all 256 weights the recipe produces, scaled to nine digits
    (defn q3d-all (i acc)
        (if (ge i 256) (reverse acc)
            (q3d-all (add i 1) (cons (q3d-scaled (q3k-at (q3d-blk) i)) acc))))

    (defn q3d-emit-all ()
        (do
            (q3d-nl "Q3KDEMO")
            (q3d-scalar "nblocks" 1)
            (q3d-ivec "blockBytes" (q3d-blk))
            (q3d-ivec "expectE9" (q3d-all 0 (empty)))
            (q3d-nl "END")
            0))
    0)
