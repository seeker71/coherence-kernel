
(let CoverRow (language-template-with-members "CoverRow" (list "TCount") (list (language-template-member "trainN" "TCount") (language-template-member "correct" "TCount") (language-template-member "heldout" "TCount") (language-template-member "ppm" "TCount"))))
(defn CoverAuthorityPath () "form/form-stdlib/bml/form-cli-lora-cover.bml")
(defn CoverAuthorityKind () "high-bml-class-template-field")
(defn FormLoraCoverAuthority () (list "abstraction" "FormLoraCoverAuthority" (list) (list) (list "CoverAuthorityPath" "CoverAuthorityKind") (list) (list)))
(defn TargetMostPpm () 950000)
(defn TargetLocalPpm () 990000)
(defn ThisNative () 414)
(defn ThisLocal () 473)
(defn ThisRemote () 105)
(defn FqtLora () 0)
(defn AdapterPath () ".form-lora-adapter")
(defn fco-authority () FormLoraCoverAuthority)
(defn fco-pattern () (list "sweep" "ppm" "remaining" "train-overlay"))
(defn fco-ppm (c n) (if (eq n 0) 0 (div (mul c 1000000) n)))
(defn fco-need-hits (c n target) (do (let want (div (add (mul target n) 999999) 1000000)) (if (ge c want) 0 (sub want c))))
(defn fco-need-events () (do (let tot (add (ThisNative) (add (ThisLocal) (ThisRemote)))) (let have (add (ThisNative) (ThisLocal))) (let want (div (mul (TargetLocalPpm) tot) 1000000)) (if (ge have want) 0 (sub want have))))
(defn fco-session-ppm () (do (let tot (add (ThisNative) (add (ThisLocal) (ThisRemote)))) (fco-ppm (add (ThisNative) (ThisLocal)) tot)))
(defn fco-lens-at (tn) (do (let rows (fls-corpus tn 1)) (let c (fls-heldout-correct rows)) (let h (fls-count-split rows (SplitHeldout))) (list tn (fls-n tn 1) c h (fco-ppm c h))))
(defn fco-lane-at (tn) (do (let rows (fln-corpus tn 1)) (let c (fln-heldout-correct rows)) (let h (fln-count-split rows (SplitHeldout))) (list tn (fln-n tn 1) c h (fco-ppm c h))))
(defn fco-more-tn (ppm1 ppm2 tn1 tn2 target) (if (ge ppm2 target) 0 (if (le ppm2 ppm1) (sub 0 1) (if (eq (sub tn2 tn1) 0) (sub 0 1) (div (add (mul (sub target ppm2) (sub tn2 tn1)) (sub ppm2 ppm1)) (sub ppm2 ppm1))))))
(defn fco-nth (row i) (nth row i))
(defn fco-fqt-lora () (FqtLora))
(defn fco-bit (ok bit) (if ok bit 0))
(defn fco-check () (do (let a (fco-lens-at 1)) (let c (fco-nth a 2)) (let h (fco-nth a 3)) (let ppm (fco-nth a 4)) (let c0 (fco-bit (eq c 72) 1)) (let c1 (fco-bit (eq h 72) 2)) (let c2 (fco-bit (eq ppm 1000000) 4)) (let c3 (fco-bit (eq (fco-need-hits c h (TargetMostPpm)) 0) 8)) (let c4 (fco-bit (eq (fco-need-hits c h (TargetLocalPpm)) 0) 16)) (let c5 (fco-bit (eq (fco-session-ppm) 894153) 32)) (let c6 (fco-bit (eq (fco-need-events) 95) 64)) (let c7 (fco-bit (and (eq (FqtLora) 0) (eq (fqt-lora?) 0)) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormLoraCover () (list "abstraction" "FormLoraCover" (list "T") (list "fco-ppm" "fco-need-hits" "fco-need-events" "fco-session-ppm" "fco-lens-at" "fco-lane-at" "fco-more-tn" "fco-nth" "fco-fqt-lora" "fco-bit" "fco-check") (list "TargetMostPpm" "TargetLocalPpm" "ThisNative" "ThisLocal" "ThisRemote" "FqtLora" "AdapterPath") (list "fco-authority") (list "fco-pattern")))
0
