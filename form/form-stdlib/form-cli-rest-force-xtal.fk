
(defn RestForceAuthorityPath () "form/form-stdlib/bml/form-cli-restanswer.bml")
(defn RestForceAuthorityKind () "high-bml-class-template-field")
(defn FormRestForceAuthority () (list "abstraction" "FormRestForceAuthority" (list) (list) (list "RestForceAuthorityPath" "RestForceAuthorityKind") (list) (list)))
(defn OpAdd () 3)
(defn OpSub () 4)
(defn OpMul () 5)
(defn OpNone () 0)
(defn LitTag () 1)
(defn GateSeed () 5151)
(defn rfb-authority () FormRestForceAuthority)
(defn rfb-pattern () (list "lower" "cold-walk" "birth-once" "unlowerable-visible" "agree-with-organ"))
(defn rfb-op-tag (op) (if (str_eq op "add") (OpAdd) (if (str_eq op "sub") (OpSub) (if (str_eq op "mul") (OpMul) (OpNone)))))
(defn rfb-emit-lit (x prog) (do (let p2 (lg-cat prog (list (list (LitTag) x)))) (list p2 (sub (len p2) 1))))
(defn rfb-emit-operand (x prog) (if (eq (lg-defer? x) 1) (rfb-emit x prog) (rfb-emit-lit x prog)))
(defn rfb-emit-close (tag ea eb) (do (let p3 (lg-cat (nth eb 0) (list (list tag (nth ea 1) (nth eb 1))))) (list p3 (sub (len p3) 1))))
(defn rfb-emit-b (tag ea p) (do (let eb (rfb-emit-operand (nth p 3) (nth ea 0))) (if (nothing? eb) (nothing) (rfb-emit-close tag ea eb))))
(defn rfb-emit-a (tag p prog) (do (let ea (rfb-emit-operand (nth p 2) prog)) (if (nothing? ea) (nothing) (rfb-emit-b tag ea p))))
(defn rfb-emit (p prog) (do (let tag (rfb-op-tag (nth p 1))) (if (eq tag 0) (nothing) (rfb-emit-a tag p prog))))
(defn rfb-lower (p) (rfb-emit p (tail (list "x"))))
(defn rfb-force (g p) (do (let low (rfb-lower p)) (if (nothing? low) (list (lg-force p) "form-unlowerable" g 0) (hg-request g (nth low 0) (nth low 1) 0))))
(defn rfb-run (g p n v route borns) (do (if (eq n 0) (list v route g borns) (rfb-step g p n borns))))
(defn rfb-step (g p n borns) (do (let r (rfb-force g p)) (rfb-run (nth r 2) p (sub n 1) (nth r 0) (nth r 1) (add borns (nth r 3)))))
(defn rfb-bit (ok bit) (if ok bit 0))
(defn rfb-check () (do (let rest (lg-defer "mul" 6 7)) (let nested (lg-defer "add" (lg-defer "mul" 6 7) (lg-defer "sub" 9 4))) (let odd (lg-defer "eq" 5 5)) (let cold (rfb-force (hg-gate (GateSeed)) rest)) (let four (rfb-run (hg-gate (GateSeed)) rest 4 0 "" 0)) (let fifth (rfb-force (nth four 2) rest)) (let sixth (rfb-force (nth fifth 2) rest)) (let deep (rfb-force (hg-gate (GateSeed)) nested)) (let stray (rfb-force (hg-gate (GateSeed)) odd)) (let c0 (rfb-bit (eq (nth cold 0) 42) 1)) (let c1 (rfb-bit (str_eq (nth cold 1) "form") 2)) (let c2 (rfb-bit (eq (nth fifth 3) 1) 4)) (let c3 (rfb-bit (str_eq (nth sixth 1) "native") 8)) (let c4 (rfb-bit (eq (nth sixth 0) 42) 16)) (let c5 (rfb-bit (eq (nth deep 0) 47) 32)) (let c6 (rfb-bit (str_eq (nth stray 1) "form-unlowerable") 64)) (let c7 (rfb-bit (eq (nth stray 0) 1) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn rfb-agree () (do (let rest (lg-defer "mul" 6 7)) (let nested (lg-defer "add" (lg-defer "mul" 6 7) (lg-defer "sub" 9 4))) (let a0 (rfb-bit (value_eq (rfb-lower rest) (rfj-lower rest)) 1)) (let a1 (rfb-bit (value_eq (rfb-lower nested) (rfj-lower nested)) 2)) (let a2 (rfb-bit (eq (nth (rfb-force (hg-gate 717) rest) 0) (nth (rfj-force (hg-gate 717) rest) 0)) 4)) (let a3 (rfb-bit (eq (nothing? (rfb-lower (lg-defer "eq" 1 1))) (nothing? (rfj-lower (lg-defer "eq" 1 1)))) 8)) (add a0 (add a1 (add a2 a3)))))
(defn FormRestForce () (list "abstraction" "FormRestForce" (list) (list "rfb-op-tag" "rfb-emit-lit" "rfb-emit-operand" "rfb-emit-close" "rfb-emit-b" "rfb-emit-a" "rfb-emit" "rfb-lower" "rfb-force" "rfb-run" "rfb-step" "rfb-bit" "rfb-check" "rfb-agree") (list "OpAdd" "OpSub" "OpMul" "OpNone" "LitTag" "GateSeed") (list "rfb-authority") (list "rfb-pattern")))
0
