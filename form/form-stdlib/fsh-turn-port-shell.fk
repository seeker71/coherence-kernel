; fsh-turn-port-shell.fk -- closed Form-only `turn-port` shell extension.
;
; This is a command/refusal seam, not a process surface.  Its sole accepted
; grammar is `turn-port <lowercase-64-hex-exchange-id>`.  It accepts no
; operation, executable, path, working-directory, or hardware selector.  A
; valid request carries a Form-native plan whose capability stage is
; `native-pending-discovery`, with executable and argv both `none`, and exits
; 69 to make the unavailable executor visible to Form control flow.  Malformed
; requests exit 64.  No resource discovery or attestation occurs in this cell.
;
; The extension late-binds shell-exec's command and plan seams only when its
; closed word is present.  Every other AST node delegates to the base Form
; evaluator/planner unchanged; neither layer invokes a host process.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/grammar-loader.fk form-stdlib/shell-grammar.fk form-stdlib/voice-traits.fk form-stdlib/feature-vector.fk form-stdlib/voice-diarize.fk form-stdlib/fsh-turn-process-spec.fk form-stdlib/nearest-shape.fk form-stdlib/shell-exec.fk
;
; Proven by: form-stdlib/tests/fsh-turn-port-shell-band.fk

(do
    ; -- closed Form contract ------------------------------------------------
    (defn fshtp-command-name () "turn-port")
    (defn fshtp-valid-no-executor-exit () 69)
    (defn fshtp-malformed-exit () 64)
    (defn fshtp-refused-arity () "refused-turn-port-arity")

    ; The shell adds only its closed arity rule.  Identity, capability stage,
    ; and non-executable envelope come from fsh-turn-process-spec so the two
    ; Form surfaces cannot drift into distinct request contracts.
    (defn fshtp-one-arg? (args) (if (eq (len args) 1) 1 0))
    (defn fshtp-input-id (args)
        (if (eq (fshtp-one-arg? args) 1) (head args) ""))
    (defn fshtp-id-valid? (exchange-id)
        (fshps-exchange-id? exchange-id))
    (defn fshtp-arity-plan ()
        (fshps-plan-for "" (fshtp-refused-arity)))
    (defn fshtp-plan (args)
        (if (eq (fshtp-one-arg? args) 1)
            (fshps-plan (fshtp-input-id args))
            (fshtp-arity-plan)))
    (defn fshtp-render-plan (args)
        (fshps-render-plan-loop (fshtp-plan args)))
    (defn fshtp-exit (args)
        (if (and (eq (fshtp-one-arg? args) 1)
                 (eq (fshtp-id-valid? (fshtp-input-id args)) 1))
            (fshtp-valid-no-executor-exit)
            (fshtp-malformed-exit)))
    (defn fshtp-turn-port (args stdin)
        (list (fshtp-render-plan args) (fshtp-exit args)))

    ; -- late-bound evaluator -------------------------------------------------
    (defn fshtp-turn-port-node? (node)
        (str_eq (sh-tag node) (fshtp-command-name)))
    (defn fshtp-eval-turn-port (node env stdin)
        (do
            (let args (sh-collect-args (sh-rest node) env))
            (let result (fshtp-turn-port args stdin))
            (let exit-code (nth result 1))
            (list (nth result 0)
                  (sh-env-set env "?" (int_to_str exit-code))
                  exit-code)))
    (defn sh-eval-command (node env stdin)
        (if (fshtp-turn-port-node? node)
            (fshtp-eval-turn-port node env stdin)
            (sh-eval-command-default node env stdin)))

    ; -- late-bound planner ---------------------------------------------------
    ; `native-unavailable` distinguishes this closed request from a native
    ; builtin that can already compute a result.  The plan carries no executor
    ; and does not attest any local resource use.
    (defn fshtp-plan-kind () "native-unavailable")
    (defn fshtp-plan-command (node)
        (do
            (let parts (sh-rest node))
            (let args (sh-collect-args parts (sh-env-empty)))
            (let redirs (sh-collect-redirs parts))
            (list (list (fshtp-plan-kind) (fshtp-command-name) args redirs))))
    (defn sh-plan-command (node)
        (if (fshtp-turn-port-node? node)
            (fshtp-plan-command node)
            (sh-plan-command-default node)))
)
