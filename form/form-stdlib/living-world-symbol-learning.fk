; living-world-symbol-learning.fk -- recurring situated surfaces may become symbols.
;
; The module begins with no vocabulary. Participants offer observations that
; locate an exact referent, optional coordinate, surface, lens, acknowledgement, and
; evidence. Source identity remains outside the observation and is recovered
; only from active attribution edges. Content-identical observations from
; distinct sources recur as one cell with multiple witnesses.
;
; For one referent/coordinate/surface, ONE observations of that exact surface are
; support; ONE observations of a different surface and explicit alternative
; NODEs remain alternatives; ZERO remains dissent; NOTHING remains silence;
; other NODE acknowledgements remain unresolved. Every active attribution in
; every class governs admission. No majority can erase a minority observation.
;
; A symbol proposal requires an offered distinct-support threshold, then crosses
; the ordinary unanimous offer/ack membrane. Evidence arrival or revocation
; changes the exact evidence set and makes prior proposals/candidates stale.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk

(let LWSL-OBSERVATION (bp "LWSL-OBSERVATION"))
(let LWSL-EVIDENCE    (bp "LWSL-EVIDENCE"))
(let LWSL-EVIDENCE-SET (bp "LWSL-EVIDENCE-SET"))
(let LWSL-ORIGIN      (bp "LWSL-ORIGIN"))

; children: referent, coordinate, exact surface, lens, ack, evidence, local path
(defn lwsl-observation-at (referent coordinate surface lens ack evidence)
    (intern_node LWSL-OBSERVATION
        (list referent coordinate
              (intern_trivial_string surface) lens ack evidence
              (lwo-local-path))))
(defn lwsl-observation (referent position surface lens ack evidence)
    (lwsl-observation-at referent (intern_trivial_int position)
        surface lens ack evidence))
(defn lwsl-observation? (cell) (lwo-category? cell LWSL-OBSERVATION))
(defn lwsl-observation-referent (observation)
    (nth (node_children observation) 0))
(defn lwsl-observation-coordinate (observation)
    (nth (node_children observation) 1))
(defn lwsl-observation-positioned? (observation)
    (if (and (eq (lwsl-observation? observation) 1)
             (and (eq (node_level
                        (lwsl-observation-coordinate observation)) 1)
                  (eq (node_type
                        (lwsl-observation-coordinate observation)) 1))) 1 0))
(defn lwsl-observation-position (observation)
    (node_value (lwsl-observation-coordinate observation)))
(defn lwsl-observation-surface-cell (observation)
    (nth (node_children observation) 2))
(defn lwsl-observation-surface (observation)
    (node_value (lwsl-observation-surface-cell observation)))
(defn lwsl-observation-lens (observation)
    (nth (node_children observation) 3))
(defn lwsl-observation-ack (observation)
    (nth (node_children observation) 4))
(defn lwsl-observation-evidence (observation)
    (nth (node_children observation) 5))
(defn lwsl-observation-path (observation)
    (nth (node_children observation) 6))

(defn lwsl-observation-valid? (observation)
    (if (and (eq (lwsl-observation? observation) 1)
             (eq (oac-valid-ack?
                   (lwsl-observation-ack observation)) 1)) 1 0))

(defn lwsl-same-coordinate? (observation referent coordinate)
    (if (and (node_eq (lwsl-observation-referent observation) referent)
             (node_eq (lwsl-observation-coordinate observation)
                      coordinate)) 1 0))

; children: observation and all of its current attribution witnesses
(defn lwsl-evidence (observation attributions)
    (intern_node LWSL-EVIDENCE (list observation attributions)))
(defn lwsl-evidence-observation (evidence) (nth (node_children evidence) 0))
(defn lwsl-evidence-attributions (evidence) (nth (node_children evidence) 1))

; children: supports, alternatives, dissents, silences, unresolved
(defn lwsl-evidence-set (supports alternatives dissents silences unresolved)
    (intern_node LWSL-EVIDENCE-SET
        (list supports alternatives dissents silences unresolved)))
(defn lwsl-evidence-set? (cell) (lwo-category? cell LWSL-EVIDENCE-SET))
(defn lwsl-evidence-supports (set) (nth (node_children set) 0))
(defn lwsl-evidence-alternatives (set) (nth (node_children set) 1))
(defn lwsl-evidence-dissents (set) (nth (node_children set) 2))
(defn lwsl-evidence-silences (set) (nth (node_children set) 3))
(defn lwsl-evidence-unresolved (set) (nth (node_children set) 4))

(defn lwsl-classify-evidence
    (observation evidence surface supports alternatives dissents silences unresolved)
    (do
        (let ack (lwsl-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (str_eq (lwsl-observation-surface observation) surface)
                (lwsl-evidence-set (lwo-field-add supports evidence)
                    alternatives dissents silences unresolved)
                (lwsl-evidence-set supports
                    (lwo-field-add alternatives evidence)
                    dissents silences unresolved))
            (if (eq (oac-zero? ack) 1)
                (lwsl-evidence-set supports alternatives
                    (lwo-field-add dissents evidence) silences unresolved)
                (if (eq (oac-nothing? ack) 1)
                    (lwsl-evidence-set supports alternatives dissents
                        (lwo-field-add silences evidence) unresolved)
                    (if (and (eq (oac-node? ack) 1)
                             (eq (oac-alternative?
                                  (oac-payload ack)) 1))
                        (lwsl-evidence-set supports
                            (lwo-field-add alternatives evidence)
                            dissents silences unresolved)
                        (lwsl-evidence-set supports alternatives dissents
                            silences (lwo-field-add unresolved evidence))))))))

(defn lwsl-collect-items
    (world items referent coordinate surface supports alternatives dissents silences unresolved)
    (if (eq (len items) 0)
        (lwsl-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            ; Form evaluates call arguments eagerly. Guard cheap shape/domain
            ; tests before lwo-active?, whose attribution walk is global.
            (if (eq (lwsl-observation-valid? observation) 0)
                (lwsl-collect-items world (tail items)
                    referent coordinate surface supports alternatives dissents
                    silences unresolved)
                (if (eq (lwsl-same-coordinate?
                            observation referent coordinate) 0)
                    (lwsl-collect-items world (tail items)
                        referent coordinate surface supports alternatives
                        dissents silences unresolved)
                    (if (eq (lwo-active? world observation) 0)
                        (lwsl-collect-items world (tail items)
                            referent coordinate surface supports alternatives
                            dissents silences unresolved)
                        (do
                            (let classified
                                (lwsl-classify-evidence observation
                                    (lwsl-evidence observation
                                        (lwo-active-attributions-for
                                            world observation))
                                    surface supports alternatives dissents
                                    silences unresolved))
                            (lwsl-collect-items world (tail items)
                                referent coordinate surface
                                (lwsl-evidence-supports classified)
                                (lwsl-evidence-alternatives classified)
                                (lwsl-evidence-dissents classified)
                                (lwsl-evidence-silences classified)
                                (lwsl-evidence-unresolved classified)))))))))

(defn lwsl-evidence-for-at (world referent coordinate surface)
    (lwsl-collect-items world
        (lwo-field-items (lwo-world-cells world))
        referent coordinate surface
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwsl-evidence-for (world referent position surface)
    (lwsl-evidence-for-at world referent (intern_trivial_int position) surface))

(defn lwsl-field-attribution-count-items (items count)
    (if (eq (len items) 0) count
        (lwsl-field-attribution-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwsl-evidence-attributions (head items)))))))

(defn lwsl-field-attribution-count (field)
    (lwsl-field-attribution-count-items (lwo-field-items field) 0))
(defn lwsl-support-count (set)
    (lwsl-field-attribution-count (lwsl-evidence-supports set)))
(defn lwsl-alternative-count (set)
    (lwsl-field-attribution-count (lwsl-evidence-alternatives set)))
(defn lwsl-dissent-count (set)
    (lwsl-field-attribution-count (lwsl-evidence-dissents set)))
(defn lwsl-silence-count (set)
    (lwsl-field-attribution-count (lwsl-evidence-silences set)))
(defn lwsl-unresolved-count (set)
    (lwsl-field-attribution-count (lwsl-evidence-unresolved set)))

(defn lwsl-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwsl-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwsl-witnesses-from-evidence-items (items field)
    (if (eq (len items) 0) field
        (lwsl-witnesses-from-evidence-items (tail items)
            (lwsl-field-union-items
                (lwo-field-items
                    (lwsl-evidence-attributions (head items)))
                field))))

(defn lwsl-witnesses (set)
    (do
        (let supports
            (lwsl-witnesses-from-evidence-items
                (lwo-field-items (lwsl-evidence-supports set))
                (lwo-empty-field)))
        (let alternatives
            (lwsl-witnesses-from-evidence-items
                (lwo-field-items (lwsl-evidence-alternatives set)) supports))
        (let dissents
            (lwsl-witnesses-from-evidence-items
                (lwo-field-items (lwsl-evidence-dissents set)) alternatives))
        (let silences
            (lwsl-witnesses-from-evidence-items
                (lwo-field-items (lwsl-evidence-silences set)) dissents))
        (lwsl-witnesses-from-evidence-items
            (lwo-field-items (lwsl-evidence-unresolved set)) silences)))

(defn lwsl-origin (referent coordinate surface evidence threshold)
    (intern_node LWSL-ORIGIN
        (list referent coordinate
              (intern_trivial_string surface) evidence
              (intern_trivial_int threshold) (lwo-local-path))))

(defn lwsl-proposal-for (world observation threshold)
    (if (eq (lwsl-observation-valid? observation) 0) (lwo-none)
        (if (eq (oac-one? (lwsl-observation-ack observation)) 0)
            (lwo-none)
            (if (eq (lwo-active? world observation) 0) (lwo-none)
                (do
                    (let referent (lwsl-observation-referent observation))
                    (let coordinate (lwsl-observation-coordinate observation))
                    (let surface (lwsl-observation-surface observation))
                    (let evidence
                        (lwsl-evidence-for-at
                            world referent coordinate surface))
                    (if (lt (lwsl-support-count evidence) threshold)
                        (lwo-none)
                        (do
                            (let symbol
                                (lwnv-symbol-at
                                    referent coordinate surface evidence))
                            (let witnesses (lwsl-witnesses evidence))
                            (let origin
                                (lwsl-origin referent coordinate surface
                                    evidence threshold))
                            (let candidate
                                (lwo-emergent symbol witnesses
                                    (intern_trivial_int
                                        (lwsl-support-count evidence))
                                    (intern_trivial_int
                                        (lwo-field-size witnesses))
                                    (intern_trivial_int threshold) origin))
                            (lwt-proposal candidate
                                (lwt-sources-from-attributions
                                    (lwo-field-items witnesses)
                                    (lwo-empty-field))
                                origin))))))))

(defn lwsl-proposals-items (world items threshold field)
    (if (eq (len items) 0) field
        (do
            (let proposal (lwsl-proposal-for world (head items) threshold))
            (lwsl-proposals-items world (tail items) threshold
                (if (node_eq proposal (lwo-none)) field
                    (lwo-field-add field proposal))))))

(defn lwsl-proposals (world threshold)
    (lwsl-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwsl-symbol-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (and (eq (lwnv-symbol-valid?
                           (lwo-emergent-shape candidate)) 1)
                  (eq (lwsl-evidence-set?
                        (lwnv-symbol-evidence
                          (lwo-emergent-shape candidate))) 1))) 1 0))

; Evidence classes are the existing local acknowledgement distinctions:
; support, alternative, dissent, silence, and unresolved.  The numeric selector
; is private control flow, never an offered ontology or stored semantic label.
(defn lwsl-observation-in-class?
    (observation referent coordinate surface class)
    (if (eq (lwsl-observation-valid? observation) 0) 0
        (if (eq (lwsl-same-coordinate?
                    observation referent coordinate) 0) 0
            (do
                (let ack (lwsl-observation-ack observation))
                (if (eq class 0)
                    (if (and (eq (oac-one? ack) 1)
                             (str_eq (lwsl-observation-surface observation)
                                surface)) 1 0)
                    (if (eq class 1)
                        (if (or
                                (and (eq (oac-one? ack) 1)
                                     (not (str_eq
                                        (lwsl-observation-surface observation)
                                        surface)))
                                (and (eq (oac-node? ack) 1)
                                     (eq (oac-alternative?
                                            (oac-payload ack)) 1))) 1 0)
                        (if (eq class 2) (oac-zero? ack)
                            (if (eq class 3) (oac-nothing? ack)
                                (if (and (eq (oac-node? ack) 1)
                                         (eq (oac-alternative?
                                                (oac-payload ack)) 0))
                                    1 0)))))))))

(defn lwsl-evidence-items-snapshot-current?
    (world items referent coordinate surface class)
    (if (eq (len items) 0) 1
        (do
            (let evidence (head items))
            (let observation (lwsl-evidence-observation evidence))
            (if (eq (lwsl-observation-in-class? observation
                        referent coordinate surface class) 0) 0
                (if (not (node_eq
                            (lwsl-evidence-attributions evidence)
                            (lwo-active-attributions-for
                                world observation))) 0
                    (lwsl-evidence-items-snapshot-current? world
                        (tail items) referent coordinate surface class))))))

(defn lwsl-evidence-items-have-observation? (items observation)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwsl-evidence-observation (head items)) observation) 1
            (lwsl-evidence-items-have-observation?
                (tail items) observation))))

(defn lwsl-evidence-set-has-observation? (evidence observation)
    (if (eq (lwsl-evidence-items-have-observation?
                (lwo-field-items (lwsl-evidence-supports evidence))
                observation) 1) 1
        (if (eq (lwsl-evidence-items-have-observation?
                    (lwo-field-items (lwsl-evidence-alternatives evidence))
                    observation) 1) 1
            (if (eq (lwsl-evidence-items-have-observation?
                        (lwo-field-items (lwsl-evidence-dissents evidence))
                        observation) 1) 1
                (if (eq (lwsl-evidence-items-have-observation?
                            (lwo-field-items (lwsl-evidence-silences evidence))
                            observation) 1) 1
                    (lwsl-evidence-items-have-observation?
                        (lwo-field-items
                            (lwsl-evidence-unresolved evidence))
                        observation))))))

(defn lwsl-no-new-coordinate-observation-items?
    (world items evidence referent coordinate)
    (if (eq (len items) 0) 1
        (do
            (let observation (head items))
            (if (eq (lwsl-observation-valid? observation) 0)
                (lwsl-no-new-coordinate-observation-items?
                    world (tail items) evidence referent coordinate)
                (if (eq (lwsl-same-coordinate?
                            observation referent coordinate) 0)
                    (lwsl-no-new-coordinate-observation-items?
                        world (tail items) evidence referent coordinate)
                    (if (eq (lwo-active? world observation) 0)
                        (lwsl-no-new-coordinate-observation-items?
                            world (tail items) evidence referent coordinate)
                        (if (eq (lwsl-evidence-set-has-observation?
                                    evidence observation) 1)
                            (lwsl-no-new-coordinate-observation-items?
                                world (tail items) evidence referent coordinate)
                            0)))))))

(defn lwsl-evidence-snapshot-current?
    (world evidence referent coordinate surface)
    (if (eq (lwsl-evidence-items-snapshot-current? world
                (lwo-field-items (lwsl-evidence-supports evidence))
                referent coordinate surface 0) 0) 0
        (if (eq (lwsl-evidence-items-snapshot-current? world
                    (lwo-field-items (lwsl-evidence-alternatives evidence))
                    referent coordinate surface 1) 0) 0
            (if (eq (lwsl-evidence-items-snapshot-current? world
                        (lwo-field-items (lwsl-evidence-dissents evidence))
                        referent coordinate surface 2) 0) 0
                (if (eq (lwsl-evidence-items-snapshot-current? world
                            (lwo-field-items (lwsl-evidence-silences evidence))
                            referent coordinate surface 3) 0) 0
                    (if (eq (lwsl-evidence-items-snapshot-current? world
                                (lwo-field-items
                                    (lwsl-evidence-unresolved evidence))
                                referent coordinate surface 4) 0) 0
                        (lwsl-no-new-coordinate-observation-items? world
                            (lwo-field-items (lwo-world-cells world)) evidence
                            referent coordinate)))))))

(defn lwsl-candidate-current? (world candidate)
    (if (eq (lwsl-symbol-candidate? candidate) 0) 0
        (do
            (let symbol (lwo-emergent-shape candidate))
            (let evidence (lwnv-symbol-evidence symbol))
            (let witnesses (lwsl-witnesses evidence))
            (if (and (node_eq witnesses
                         (lwo-emergent-witnesses candidate))
                     (and (eq (lwsl-support-count evidence)
                              (lwo-emergent-coherence candidate))
                          (and (eq (lwo-field-size witnesses)
                                   (lwo-emergent-resonance candidate))
                               (and (ge (lwsl-support-count evidence)
                                        (lwo-emergent-threshold candidate))
                                    (eq (lwsl-evidence-snapshot-current? world
                                            evidence
                                            (lwnv-symbol-referent symbol)
                                            (lwnv-symbol-coordinate symbol)
                                            (lwnv-symbol-surface symbol))
                                        1))))) 1 0))))

(defn lwsl-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwsl-candidate-current? world candidate) 1)) 1 0))

(defn lwsl-current-candidate-for-symbol-items (world items symbol)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let candidate (head items))
            (if (and (eq (lwsl-integrated-current? world candidate) 1)
                     (node_eq (lwo-emergent-shape candidate) symbol))
                candidate
                (lwsl-current-candidate-for-symbol-items
                    world (tail items) symbol)))))

(defn lwsl-current-candidate-for-symbol (world symbol)
    (lwsl-current-candidate-for-symbol-items world
        (lwo-field-items (lwo-world-cells world)) symbol))

(defn lwsl-integrate (round proposal action)
    (if (eq (lwsl-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
