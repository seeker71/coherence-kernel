; bmf-grammar.fk -- recursive grammar waist over the BMF cursor.
;
; Layer 3 is the grammar-as-data fixpoint: named rules, recursive ref, rep/sep,
; captures, templates, and cursor-native grammar sugar. `g-match-rule` remains a
; prefix matcher for composition; `g-parse-full` is the trusted whole-source door.
;
; A grammar stays data: its rules, patterns and templates are lists any reader walks. A
; reading goes through that data's compiled form (the gx- section below), made once per
; rule set in a process: numbered pattern tags, references that hold their rule, and for
; every reference and alternation the bytes its patterns can begin at. The reader walks a
; position over the source string.
;
; preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk

(do
    (defn bg-feature (name status) (list "bmf-grammar-layer-feature" name status))
    (defn bg-feature-name (f) (nth f 1))
    (defn bg-feature-status (f) (nth f 2))
    (defn bmf-grammar-language-manifest ()
        (list
            (bg-feature "grammar-value" 1)
            (bg-feature "multi-rule" 1)
            (bg-feature "ref-recursion" 1)
            (bg-feature "rep-sep" 1)
            (bg-feature "capture-values" 1)
            (bg-feature "template-emit" 1)
            (bg-feature "template-splice" 1)
            (bg-feature "literal-sugar" 1)
            (bg-feature "expression-sugar" 1)
            (bg-feature "full-parse" 1)
            (bg-feature "no-line-grammar" 1)))
    (defn bmf-grammar-manifest-has? (name fs)
        (if (nil? fs) 0
            (if (and (str_eq (bg-feature-name (head fs)) name)
                     (eq (bg-feature-status (head fs)) 1))
                1
                (bmf-grammar-manifest-has? name (tail fs)))))

    (defn nlist (xs) (cons "L" xs))
    (defn nlist-items (v) (tail v))

    (defn gc-get (caps name)
        (if (eq caps (empty)) (intern_trivial_string "")
            (if (str_eq (head (head caps)) name) (head (tail (head caps)))
                (gc-get (tail caps) name))))

    ;; A grammar carries its rules and, built once, an index from each rule's name to
    ;; the first rule of that name: a reference is one read, not a walk of the list.
    (defn grammar (start rules) (list "G" start rules (g-index rules (record_new 0))))
    (defn g-index (rs tab)
        (if (nil? rs) tab
            (g-index (tail rs)
                (if (eq (record_get tab (head (head rs))) 0) (record_set tab (head (head rs)) (head rs)) tab))))
    (defn g-start (g) (nth g 1))
    (defn g-rules (g) (nth g 2))
    (defn rule3 (name pat tpl) (list name pat tpl))
    (defn rule3m (name pat tpl) (list name pat tpl "memo"))
    (defn r3-pat (r) (nth r 1))
    (defn r3-tpl (r) (nth r 2))
    (defn g-rule (g name)
        (if (nil? (tail (tail (tail g)))) (g-rule-find (g-rules g) name)
            (do (let r (record_get (nth g 3) name))
                (if (eq r 0) (empty) r))))
    (defn g-rule-find (rs name)
        (if (nil? rs) (empty)
            (if (str_eq (head (head rs)) name) (head rs)
                (g-rule-find (tail rs) name))))

    ;; A rule marked "memo" (rule3m) is read once at each place of a source the whole-source
    ;; door armed: its reading there does not depend on how it was reached, so a retry from
    ;; the same place -- an alternative, a longer form, a block read again as its other kind --
    ;; takes the reading it already has. A source then costs its length, not its nesting.
    ;; A record's read walks its keys, so the memo is a record of records: a rule's readings
    ;; over each 1024 bytes of source sit in one record keyed by the place.
    ;; The seed roots every record value. A parse owner releases both levels
    ;; after keeping its result; dropping the grammar alone retains its readings.
    (defn g-release-values (keys record)
        (if (nil? keys) 0
            (do (record_set record (head keys) 0)
                (g-release-values (tail keys) record))))
    (defn g-release-shards (keys memo)
        (if (nil? keys) 0
            (do (let shard (record_get memo (head keys)))
                (if (eq shard 0) 0 (g-release-values (record_keys shard) shard))
                (record_set memo (head keys) 0)
                (g-release-shards (tail keys) memo))))
    (defn g-memo-release (g)
        (do (let memo (nth g 4))
            (let keys (record_keys memo))
            (let started (host_monotonic_ms))
            (g-release-shards keys memo)
            (fb_record (intern_node (intern_trivial_string "parse-release")
                (list (intern_trivial_int (len keys))
                      (intern_trivial_int (sub (host_monotonic_ms) started)))) "bmf.grammar" 0)
            0))
    (defn g-armed (g)
        (list "G" (g-start g) (g-rules g)
              (if (nil? (tail (tail (tail g)))) (g-index (g-rules g) (record_new 0)) (nth g 3))
              (record_new 0)))
    ;; A traced grammar (g-traced) also keeps the farthest place a rule could not begin reading and
    ;; the rules that could not begin there: the stop a refusal names. A traced reading tries every
    ;; rule where the source tried it, so each one that could not begin is noted.
    (defn g-traced (g)
        (list "G" (g-start g) (g-rules g)
              (if (nil? (tail (tail (tail g)))) (g-index (g-rules g) (record_new 0)) (nth g 3))
              (record_new 0) (g-far-new)))
    (defn g-far-new ()
        (do (let far (record_new 0))
            (record_set far "at" -1)
            (record_set far "want" (empty))
            far))
    (defn g-far (g) (nth g 5))
    (defn g-far-note (far name pos)
        (do (let at (record_get far "at"))
            (if (gt pos at)
                (do (record_set far "at" pos)
                    (record_set far "want" (list name)))
                (if (and (eq pos at) (not (g-far-has? (record_get far "want") name)))
                    (record_set far "want" (cons name (record_get far "want")))
                    0))))
    (defn g-far-has? (names name)
        (if (nil? names) 0
            (if (str_eq (head names) name) 1 (g-far-has? (tail names) name))))
    (defn rok? (rr) (str_eq (head rr) "rok"))
    (defn rok-node (rr) (nth rr 1))
    (defn rok-cur (rr) (nth rr 2))

    ;; cursor scans other readers share: to the closing quote q past escapes, and over a
    ;; generic argument list <...> (nothing when a ( ) ; { } comes first)
    (defn gm-q-scan (c q)
        (if (cur-eof? c) c
            (if (eq (cur-peek c) q) c
                (if (eq (cur-peek c) 92) (gm-q-scan (cur-advance c 2) q)
                    (gm-q-scan (cur-advance c 1) q)))))
    (defn gen-scan (c depth)
        (if (cur-eof? c) (empty)
            (do (let cp (cur-peek c))
                (if (eq cp 62) (if (eq depth 1) (cur-advance c 1) (gen-scan (cur-advance c 1) (sub depth 1)))
                (if (eq cp 60) (gen-scan (cur-advance c 1) (add depth 1))
                (if (eq cp 40) (empty)
                (if (eq cp 41) (empty)
                (if (eq cp 59) (empty)
                (if (eq cp 123) (empty)
                (if (eq cp 125) (empty)
                    (gen-scan (cur-advance c 1) depth)))))))))))

    (defn bmf-unescape-str-loop (s i acc)
        (if (ge i (str_len s)) acc
            (do
                (let ch (char_at s i))
                (if (and (str_eq ch "\\") (lt (add i 1) (str_len s)))
                    (do
                        (let nx (char_at s (add i 1)))
                        (let lit
                            (if (str_eq nx "n") "\n"
                            (if (str_eq nx "t") "\t"
                            (if (str_eq nx "r") "\r"
                            (if (str_eq nx "\\") "\\"
                            (if (str_eq nx "\"") "\""
                                nx))))))
                        (bmf-unescape-str-loop s (add i 2) (str_concat acc lit)))
                    (bmf-unescape-str-loop s (add i 1) (str_concat acc ch))))))
    (defn bmf-unescape-str (s) (bmf-unescape-str-loop s 0 ""))

    ;; ── the compiled reader ──────────────────────────────────────────────
    ;; Read as data at every step, a grammar cost a string compare per pattern tag, a rule
    ;; found by name per reference, a cursor row per byte and every alternative tried at
    ;; every place: about fifty microseconds a byte. Compiled once, a pattern is a numbered
    ;; op, a reference holds its rule in a cell, and each reference and alternation carries
    ;; FIRST: the bytes at which its pattern can begin. A pattern that cannot begin at the
    ;; byte under the cursor fails there having built nothing, so the reader does not try it:
    ;; the reading and every node it makes, in their order, are the ones the data gives.
    ;; A traced grammar is compiled without FIRST, so each rule that could not begin is
    ;; tried and noted, as a refusal reads it.
    ;;
    ;; A byte set lives over index i = byte + 1 (0 is the end of the source): ascending
    ;; ranges (list lo hi) that neither touch nor overlap while it is computed, then 257 bytes
    ;; of text ("1" in it, "0" not) the reader asks with one str_byte_at.
    (let GX-NL (byte_to_str 10))
    (let GX-UNIT (list "U"))
    (defn gs-none () (empty))
    (defn gs-all () (list (list 0 256)))
    (defn gs-one (i) (list (list i i)))
    ;; a union merges the two lists by where their ranges begin, then joins ranges that touch
    (defn gs-or (a b) (gs-join (gs-merge a b)))
    (defn gs-merge (a b)
        (if (nil? a) b
            (if (nil? b) a
                (if (le (head (head a)) (head (head b)))
                    (cons (head a) (gs-merge (tail a) b))
                    (cons (head b) (gs-merge a (tail b)))))))
    (defn gs-join (xs)
        (if (nil? xs) xs
            (if (nil? (tail xs)) xs
                (do (let x (head xs))
                    (let y (head (tail xs)))
                    (if (le (head y) (add (nth x 1) 1))
                        (gs-join (cons (list (head x) (if (gt (nth y 1) (nth x 1)) (nth y 1) (nth x 1))) (tail (tail xs))))
                        (cons x (gs-join (tail xs))))))))
    (defn gs-has? (set i)
        (if (nil? set) 0
            (if (lt i (head (head set))) 0
                (if (le i (nth (head set) 1)) 1 (gs-has? (tail set) i)))))
    (defn gs-repeat (t k)
        (if (le k 0) ""
            (if (eq k 1) t
                (do (let h (gs-repeat t (div k 2)))
                    (str_concat (str_concat h h) (if (eq (mod k 2) 1) t ""))))))
    ;; the set as text: runs of "0" and "1" cut from two held 257-byte runs
    (defn gs-run (t k)
        (do (let key (str_concat " run" t))
            (let held (record_get GX-CLASSES key))
            (substring (if (eq held 0) (gs-held-run key t) held) 0 k)))
    (defn gs-held-run (key t) (do (let r (gs-repeat t 257)) (record_set GX-CLASSES key r) r))
    (defn gs-text (set) (gs-text-from set 0 ""))
    (defn gs-text-from (set i acc)
        (if (nil? set) (str_concat acc (gs-run "0" (sub 257 i)))
            (gs-text-from (tail set) (add (nth (head set) 1) 1)
                (str_concat acc (str_concat (gs-run "0" (sub (head (head set)) i))
                    (gs-run "1" (add (sub (nth (head set) 1) (head (head set))) 1)))))))

    ;; a named byte class (cp-in-class?) as (list text set), read once in a process
    (let GX-CLASSES (record_new 0))
    (defn gx-class (cls)
        (do (let held (record_get GX-CLASSES cls))
            (if (eq held 0)
                (do (let set (gx-class-set cls 0 -1 (empty)))
                    (let made (list (gs-text set) set))
                    (record_set GX-CLASSES cls made)
                    made)
                held)))
    ;; one pass over the bytes, a range closed where the class ends
    (defn gx-class-set (cls b start acc)
        (if (gt b 255) (reverse (if (ge start 0) (cons (list (add start 1) 256) acc) acc))
            (if (cp-in-class? b cls)
                (gx-class-set cls (add b 1) (if (lt start 0) b start) acc)
                (gx-class-set cls (add b 1) -1 (if (ge start 0) (cons (list (add start 1) b) acc) acc)))))
    (defn gx-every ()
        (do (let held (record_get GX-CLASSES " every"))
            (if (eq held 0)
                (do (let t (gs-text (gs-all))) (record_set GX-CLASSES " every" t) t)
                held)))

    ;; FIRST of a pattern: (list set nullable). The set holds every index at which reading the
    ;; pattern may consume, build or succeed with a reading of its own; nullable says it may
    ;; also succeed there having read and built nothing. At any other index a pattern that is
    ;; not nullable fails having built nothing. A `not` builds "" when its pattern fails, so it
    ;; is read everywhere; a rule that may read nothing still builds its template, so a
    ;; reference to it is tried everywhere too.
    (defn gf (pat rf)
        (do (let tag (head pat))
            (if (str_eq tag "ref") (gf-ref (record_get rf (nth pat 1)))
            (if (str_eq tag "cap") (gf (nth pat 2) rf)
            (if (str_eq tag "lit") (gf-lit (nth pat 1))
            (if (str_eq tag "seq") (gf-seq (tail pat) rf)
            (if (str_eq tag "alt") (gf-alt (tail pat) rf)
            (if (str_eq tag "run") (list (nth (gx-class (nth pat 1)) 1) 0)
            (if (or (str_eq tag "opt") (str_eq tag "rep")) (list (head (gf (nth pat 1) rf)) 1)
            (if (str_eq tag "sep") (gf-sep (gf (nth pat 1) rf))
            (if (str_eq tag "str") (list (gs-one 35) 0)
            (if (str_eq tag "char") (list (gs-one 40) 0)
            (if (str_eq tag "num") (list (nth (gx-class "digit") 1) 0)
            (if (or (str_eq tag "infix") (or (str_eq tag "chain") (or (str_eq tag "ternary") (str_eq tag "leaf"))))
                (gf-strict (gf (nth pat 1) rf))
            (if (str_eq tag "not") (list (gs-all) 0)
                (list (gs-none) 0))))))))))))))))
    (defn gf-strict (f) (if (eq (nth f 1) 1) (list (gs-all) 0) (list (head f) 0)))
    (defn gf-ref (f) (if (eq f 0) (list (gs-none) 0) (gf-strict f)))
    (defn gf-lit (s) (if (eq (str_len s) 0) (list (gs-none) 1) (list (gs-one (add (str_byte_at s 0) 1)) 0)))
    (defn gf-seq (parts rf)
        (if (nil? parts) (list (gs-none) 1)
            (do (let f (gf (head parts) rf))
                (if (eq (nth f 1) 1)
                    (do (let rest (gf-seq (tail parts) rf))
                        (list (gs-or (head f) (head rest)) (nth rest 1)))
                    f))))
    (defn gf-alt (alts rf)
        (if (nil? alts) (list (gs-none) 0)
            (do (let f (gf (head alts) rf))
                (let rest (gf-alt (tail alts) rf))
                (list (gs-or (head f) (head rest)) (if (eq (nth f 1) 1) 1 (nth rest 1))))))
    (defn gf-sep (f) (if (eq (nth f 1) 1) (list (gs-all) 1) (list (head f) 1)))
    ;; the rules a name reads: the first rule of each name, as g-index keeps them
    (defn gx-unique (rs seen)
        (if (nil? rs) (empty)
            (if (eq (record_get seen (head (head rs))) 0)
                (do (record_set seen (head (head rs)) 1)
                    (cons (head rs) (gx-unique (tail rs) seen)))
                (gx-unique (tail rs) seen))))
    ;; every rule's FIRST grows from nothing until a round moves none; read in the order a
    ;; depth-first walk of the references finishes them, a rule's FIRST mostly stands on
    ;; FIRSTs already read, and two or three rounds settle it
    (defn gf-refs (pat acc)
        (do (let tag (head pat))
            (if (str_eq tag "ref") (cons (nth pat 1) acc)
            (if (str_eq tag "cap") (gf-refs (nth pat 2) acc)
            (if (or (str_eq tag "seq") (str_eq tag "alt")) (gf-refs-all (tail pat) acc)
            (if (or (str_eq tag "sep") (or (str_eq tag "chain") (str_eq tag "ternary")))
                (gf-refs (nth pat 1) (gf-refs (nth pat 2) acc))
            (if (or (str_eq tag "opt") (or (str_eq tag "rep") (or (str_eq tag "not") (or (str_eq tag "leaf") (str_eq tag "infix")))))
                (gf-refs (nth pat 1) acc)
                acc)))))))
    (defn gf-refs-all (ps acc) (if (nil? ps) acc (gf-refs-all (tail ps) (gf-refs (head ps) acc))))
    (defn gf-visit (name src seen acc)
        (if (eq (record_get seen name) 0)
            (do (record_set seen name 1)
                (let r (record_get src name))
                (if (eq r 0) acc (cons r (gf-visit-all (gf-refs (nth r 1) (empty)) src seen acc))))
            acc))
    (defn gf-visit-all (names src seen acc)
        (if (nil? names) acc (gf-visit-all (tail names) src seen (gf-visit (head names) src seen acc))))
    (defn gf-order (rs src seen acc)
        (if (nil? rs) (reverse acc) (gf-order (tail rs) src seen (gf-visit (head (head rs)) src seen acc))))
    (defn gf-start (rs rf)
        (if (nil? rs) rf (do (record_set rf (head (head rs)) (list (gs-none) 0)) (gf-start (tail rs) rf))))
    (defn gf-round (rs rf moved)
        (if (nil? rs) moved
            (do (let now (gf (nth (head rs) 1) rf))
                (if (eq now (record_get rf (head (head rs)))) (gf-round (tail rs) rf moved)
                    (do (record_set rf (head (head rs)) now) (gf-round (tail rs) rf 1))))))
    (defn gf-fix (rs rf) (if (eq (gf-round rs rf 0) 1) (gf-fix rs rf) rf))

    ;; compiled ops: 1 ref, 2 cap, 3 lit, 4 keyword, 5 seq, 6 alt over byte groups, 7 run,
    ;; 8 opt, 9 rep, 10 sep, 11 str, 12 char, 13 num, 14 infix, 15 chain, 16 ternary,
    ;; 17 not, 18 leaf, 19 never, 20 alt over every alternative.
    ;; ctx: (list firsts cells prune ref-texts)
    (defn gc-pat (pat ctx)
        (do (let tag (head pat))
            (if (str_eq tag "ref") (gc-ref (nth pat 1) ctx)
            (if (str_eq tag "cap") (list 2 (nth pat 1) (gc-pat (nth pat 2) ctx))
            (if (str_eq tag "lit")
                (if (gt (len pat) 2)
                    (list 4 (nth pat 1) (str_len (nth pat 1)) (if (gt (len pat) 3) 1 0) (head (gx-class "bmlname")))
                    (list 3 (nth pat 1) (str_len (nth pat 1))))
            (if (str_eq tag "seq") (list 5 (gc-list (tail pat) ctx))
            (if (str_eq tag "alt") (gc-alt (tail pat) ctx)
            (if (str_eq tag "run") (list 7 (head (gx-class (nth pat 1))))
            (if (str_eq tag "opt") (list 8 (gc-pat (nth pat 1) ctx))
            (if (str_eq tag "rep") (list 9 (gc-pat (nth pat 1) ctx))
            (if (str_eq tag "sep") (list 10 (gc-pat (nth pat 1) ctx) (gc-pat (nth pat 2) ctx))
            (if (str_eq tag "str") (list 11)
            (if (str_eq tag "char") (list 12)
            (if (str_eq tag "num") (list 13)
            (if (str_eq tag "infix") (gc-infix (gc-pat (nth pat 1) ctx) (nth pat 2))
            (if (str_eq tag "chain") (list 15 (gc-pat (nth pat 1) ctx) (gc-pat (nth pat 2) ctx) (if (gt (len pat) 3) 1 0))
            (if (str_eq tag "ternary")
                (list 16 (gc-pat (nth pat 1) ctx) (gc-pat (nth pat 2) ctx) (if (gt (len pat) 3) (nth pat 3) "UE-COND-TERNARY"))
            (if (str_eq tag "not") (list 17 (gc-pat (nth pat 1) ctx))
            (if (str_eq tag "leaf") (list 18 (gc-pat (nth pat 1) ctx) (gc-follow (nth pat 2)))
                (list 19))))))))))))))))))))
    (defn gc-list (ps ctx) (if (nil? ps) (empty) (cons (gc-pat (head ps) ctx) (gc-list (tail ps) ctx))))
    ;; A reference holds its rule: the compiled rule itself (op 23), its pattern inline when
    ;; the rule reads one pattern through (op 22), or, closing a cycle back to a rule still
    ;; being compiled, the cell that rule fills (op 1).
    (defn gc-ref (name ctx)
        (do (let cell (record_get (nth ctx 1) name))
            (if (eq cell 0) (list 19)
                (do (let text (gc-ref-text name ctx))
                    (if (eq (record_get (nth ctx 6) name) 1) (list 1 cell text)
                        (do (let r (gc-rule-named name ctx))
                            (if (eq (nth r 4) 1)
                                (if (eq (nth r 3) 0) (list 22 (nth r 1) text (head r)) (list 23 r text))
                                (list 23 r text))))))))
    (defn gc-rule-named (name ctx)
        (do (let done (record_get (nth ctx 5) name))
            (if (eq done 0)
                (do (record_set (nth ctx 6) name 1)
                    (let r (gc-rule (record_get (nth ctx 4) name) ctx))
                    (record_set (nth ctx 6) name 0)
                    (record_set (nth ctx 5) name r)
                    (record_set (record_get (nth ctx 1) name) "r" r)
                    r)
                done)))
    (defn gc-ref-text (name ctx)
        (if (eq (nth ctx 2) 0) (gx-every)
            (do (let held (record_get (nth ctx 3) name))
                (if (eq held 0)
                    (do (let t (gs-text (head (gf-ref (record_get (head ctx) name)))))
                        (record_set (nth ctx 3) name t)
                        t)
                    held))))
    ;; An alternation reads the byte under the cursor once: its table holds, at index i, 48 +
    ;; the group of alternatives that can begin there, in their order.
    (defn gc-alt (alts ctx)
        (if (eq (nth ctx 2) 0) (list 20 (gc-list alts ctx))
            (do (let units (gc-units alts ctx))
                (gc-dispatch 6 (gc-unit-ops units) (gc-unit-firsts units)))))
    ;; A run of alternatives that are rules whose sequences begin alike -- a block read as a
    ;; value and as statements, `def f(x) {` and `def f(x) =` -- reads the shared beginning
    ;; once and then each rule's rest in order: the readings a retry from the same place would
    ;; give, without reading that place again. A unit is (list op first).
    (defn gc-units (alts ctx)
        (if (nil? alts) (empty)
            (do (let run (gc-run-of alts ctx))
                (if (nil? (tail run))
                    (cons (list (gc-pat (head alts) ctx) (gf (head alts) (head ctx))) (gc-units (tail alts) ctx))
                    (cons (gc-factored run ctx) (gc-units (gc-drop (len run) alts) ctx))))))
    (defn gc-drop (k xs) (if (eq k 0) xs (gc-drop (sub k 1) (tail xs))))
    ;; the factorable source rule a pattern refers to: a rule read without memo whose
    ;; pattern is a sequence, or 0
    (defn gc-seq-rule (pat ctx)
        (if (not (str_eq (head pat) "ref")) 0
            (do (let r (record_get (nth ctx 4) (nth pat 1)))
                (if (eq r 0) 0
                    (if (gt (len r) 3) 0
                        (if (str_eq (head (nth r 1)) "seq") r 0))))))
    ;; the longest run from the head whose rules share at least their first part
    (defn gc-run-of (alts ctx)
        (do (let r (gc-seq-rule (head alts) ctx))
            (if (eq r 0) (list (head alts))
                (cons (head alts) (gc-run-more (tail alts) ctx (tail (nth r 1)))))))
    (defn gc-run-more (alts ctx prefix)
        (if (nil? alts) (empty)
            (do (let r (gc-seq-rule (head alts) ctx))
                (if (eq r 0) (empty)
                    (do (let shared (gc-common prefix (tail (nth r 1))))
                        (if (nil? shared) (empty)
                            (cons (head alts) (gc-run-more (tail alts) ctx shared))))))))
    (defn gc-common (a b)
        (if (or (nil? a) (nil? b)) (empty)
            (if (eq (head a) (head b)) (cons (head a) (gc-common (tail a) (tail b))) (empty))))
    (defn gc-prefix-of (run ctx acc)
        (if (nil? run) acc
            (gc-prefix-of (tail run) ctx (gc-common acc (tail (nth (gc-seq-rule (head run) ctx) 1))))))
    ;; op 21: (list 21 prefix (list (list rest template name) ...))
    (defn gc-factored (run ctx)
        (do (let prefix (gc-prefix-of (tail run) ctx (tail (nth (gc-seq-rule (head run) ctx) 1))))
            (list (list 21 (gc-list prefix ctx) (gc-members run (len prefix) ctx))
                  (gc-run-first run ctx))))
    (defn gc-members (run k ctx)
        (if (nil? run) (empty)
            (do (let r (gc-seq-rule (head run) ctx))
                (cons (list (gc-list (gc-drop k (tail (nth r 1))) ctx) (gc-tpl (nth r 2)) (head r))
                      (gc-members (tail run) k ctx)))))
    (defn gc-run-first (run ctx)
        (if (nil? (tail run)) (gf (head run) (head ctx))
            (do (let f (gf (head run) (head ctx)))
                (let rest (gc-run-first (tail run) ctx))
                (list (gs-or (head f) (head rest)) 0))))
    (defn gc-unit-ops (us) (if (nil? us) (empty) (cons (head (head us)) (gc-unit-ops (tail us)))))
    (defn gc-unit-firsts (us) (if (nil? us) (empty) (cons (nth (head us) 1) (gc-unit-firsts (tail us)))))
    ;; The table is built from where the units' FIRST ranges begin and end: between two such
    ;; cuts every index sees the same alternatives.
    (defn gc-dispatch (op items firsts)
        (do (let cuts (gc-below (gc-cuts firsts (list 0))))
            (let sigs (gc-cut-sigs firsts cuts))
            (let distinct (gc-distinct sigs (empty)))
            (if (and (eq op 6) (and (nil? (tail distinct)) (eq (str_len (head distinct)) (len items))))
                (list 20 items)
                (list op (gc-table cuts sigs distinct "") (if (eq op 6) (gc-alt-groups distinct items) (gc-groups distinct items))))))
    ;; an alternation's group is the one alternative itself when one can begin there, (19)
    ;; when none can, else (20 alternatives)
    (defn gc-alt-groups (distinct items)
        (if (nil? distinct) (empty)
            (do (let ops (gc-pick (head distinct) 0 items))
                (cons (if (nil? ops) (list 19) (if (nil? (tail ops)) (head ops) (list 20 ops)))
                      (gc-alt-groups (tail distinct) items)))))
    (defn gc-cut (v xs)
        (if (nil? xs) (list v)
            (if (lt v (head xs)) (cons v xs)
                (if (eq v (head xs)) xs (cons (head xs) (gc-cut v (tail xs)))))))
    (defn gc-cuts-of (set xs)
        (if (nil? set) xs (gc-cuts-of (tail set) (gc-cut (add (nth (head set) 1) 1) (gc-cut (head (head set)) xs)))))
    (defn gc-cuts (firsts xs) (if (nil? firsts) xs (gc-cuts (tail firsts) (gc-cuts-of (head (head firsts)) xs))))
    (defn gc-below (xs) (if (nil? xs) (empty) (if (ge (head xs) 257) (empty) (cons (head xs) (gc-below (tail xs))))))
    (defn gc-cut-sigs (firsts cuts)
        (if (nil? cuts) (empty) (cons (gc-sig firsts (head cuts) 0 "") (gc-cut-sigs firsts (tail cuts)))))
    (defn gc-sig (firsts i j acc)
        (if (nil? firsts) acc
            (gc-sig (tail firsts) i (add j 1)
                (if (or (eq (nth (head firsts) 1) 1) (gs-has? (head (head firsts)) i))
                    (str_concat acc (byte_to_str (add 48 j)))
                    acc))))
    (defn gc-member? (s xs) (if (nil? xs) 0 (if (str_eq (head xs) s) 1 (gc-member? s (tail xs)))))
    (defn gc-distinct (sigs acc)
        (if (nil? sigs) (reverse acc)
            (gc-distinct (tail sigs) (if (gc-member? (head sigs) acc) acc (cons (head sigs) acc)))))
    (defn gc-index-of (s xs k) (if (str_eq (head xs) s) k (gc-index-of s (tail xs) (add k 1))))
    (defn gc-table (cuts sigs distinct acc)
        (if (nil? cuts) acc
            (gc-table (tail cuts) (tail sigs) distinct
                (str_concat acc (gs-repeat (byte_to_str (add 48 (gc-index-of (head sigs) distinct 0)))
                    (sub (if (nil? (tail cuts)) 257 (head (tail cuts))) (head cuts)))))))
    (defn gc-pick (sig k items)
        (if (ge k (str_len sig)) (empty)
            (cons (nth items (sub (str_byte_at sig k) 48)) (gc-pick sig (add k 1) items))))
    (defn gc-groups (distinct items)
        (if (nil? distinct) (empty) (cons (gc-pick (head distinct) 0 items) (gc-groups (tail distinct) items))))
    ;; an operator row: (list symbol length name precedence call right), grouped by the byte the
    ;; symbol begins with, so the reader tries only the symbols that begin under the cursor
    (defn gc-infix (operand table)
        (do (let es (gc-ops table))
            (let d (gc-dispatch 14 es (gc-op-firsts es)))
            (list 14 operand (nth d 1) (nth d 2))))
    (defn gc-ops (table) (if (nil? table) (empty) (cons (gc-op (head table)) (gc-ops (tail table)))))
    (defn gc-op (e)
        (list (head e) (str_len (head e)) (nth e 1) (nth e 2)
              (if (and (gt (len e) 3) (str_eq (nth e 3) "call")) 1 0)
              (if (gt (len e) 4) 1 0)))
    (defn gc-op-firsts (es) (if (nil? es) (empty) (cons (gf-lit (head (head es))) (gc-op-firsts (tail es)))))
    (defn gc-follow (bytes) (gs-text (gc-follow-set bytes 0 (gs-none))))
    (defn gc-follow-set (bytes k acc)
        (if (ge k (str_len bytes)) acc
            (gc-follow-set bytes (add k 1) (gs-or acc (gs-one (add (str_byte_at bytes k) 1))))))
    ;; a compiled rule: (list name pattern template memo through memo-prefix at-key got-key). A
    ;; rule that captures one pattern whole and splices it (cap v p, splice v) reads p's value
    ;; through.
    (defn gc-rule (r ctx)
        (do (let pat (nth r 1))
            (let tpl (nth r 2))
            (let through (and (str_eq (head pat) "cap") (and (str_eq (head tpl) "splice") (str_eq (nth pat 1) (nth tpl 1)))))
            (list (head r)
                  (gc-pat (if through (nth pat 2) pat) ctx)
                  (gc-tpl tpl)
                  (if (gt (len r) 3) 1 0)
                  (if through 1 0)
                  (str_concat (head r) "@")
                  (str_concat (head r) "@at")
                  (str_concat (head r) "@got"))))
    ;; compiled templates: 1 emit (name holder kids), 2 splice, 3 splice-int, 4 splice-neg,
    ;; 5 bind, 6 const, 7 const-int, 8 const-bool, 9 wrap-rest, 10 "?"; a kid may be 11
    ;; splice*. An emit's holder keeps its category once the first node asked it.
    (defn gc-tpl (t)
        (do (let tag (head t))
            (if (str_eq tag "emit") (list 1 (nth t 1) (record_new 0) (gc-kids (nth t 2)))
            (if (str_eq tag "splice") (list 2 (nth t 1))
            (if (str_eq tag "splice-int") (list 3 (nth t 1))
            (if (str_eq tag "splice-neg") (list 4 (nth t 1))
            (if (str_eq tag "bind") (list 5 (nth t 1) (nth t 2))
            (if (str_eq tag "const") (list 6 (nth t 1))
            (if (str_eq tag "const-int") (list 7 (nth t 1))
            (if (str_eq tag "const-bool") (list 8 (nth t 1))
            (if (str_eq tag "wrap-rest") (list 9 (nth t 1) (nth t 2) (nth t 3))
                (list 10))))))))))))
    (defn gc-kids (ks)
        (if (nil? ks) (empty)
            (cons (if (str_eq (head (head ks)) "splice*") (list 11 (nth (head ks) 1)) (gc-tpl (head ks)))
                  (gc-kids (tail ks)))))
    ;; ctx: (list firsts cells prune ref-texts rules-by-name compiled open)
    (defn gx-compile (rules prune)
        (do (let rs (gx-unique rules (record_new 0)))
            (let src (g-index rs (record_new 0)))
            (let rf (if (eq prune 1) (gf-fix (gf-order rs src (record_new 0) (empty)) (gf-start rs (record_new 0))) (record_new 0)))
            (let cells (gx-cells rs (record_new 0)))
            (gx-fill rs (list rf cells prune (record_new 0) src (record_new 0) (record_new 0)))
            cells))
    (defn gx-cells (rs cells)
        (if (nil? rs) cells (gx-cells (tail rs) (record_set cells (head (head rs)) (record_new 0)))))
    (defn gx-fill (rs ctx)
        (if (nil? rs) 0
            (do (gc-rule-named (head (head rs)) ctx)
                (gx-fill (tail rs) ctx))))
    ;; the compiled rule sets this process holds, newest first: a record of "rules" and its
    ;; "pruned" and "traced" forms. A set is found by eq, which answers at once for the same list.
    (let GX-GRAMMARS (record_set (record_new 0) "all" (empty)))
    (defn gx-compiled (rules traced)
        (do (let entry (gx-entry (record_get GX-GRAMMARS "all") rules))
            (let slot (if traced "traced" "pruned"))
            (let held (record_get entry slot))
            (if (eq held 0)
                (do (let made (gx-compile rules (if traced 0 1)))
                    (record_set entry slot made)
                    made)
                held)))
    (defn gx-entry (es rules)
        (if (nil? es)
            (do (let fresh (record_set (record_new 0) "rules" rules))
                (record_set GX-GRAMMARS "all" (cons fresh (record_get GX-GRAMMARS "all")))
                fresh)
            (if (eq (record_get (head es) "rules") rules) (head es) (gx-entry (tail es) rules))))

    ;; ── the reader: a position over the source text s of length n ───────
    ;; A reading is (cons end (cons value captures)) -- its end, its value, then the captures
    ;; as its tail -- or 0 when the pattern does not hold. x is the parse's
    ;; (list memo far pruned latest), memo, far and latest 0 when the grammar carries none.
    ;; The reader is written in the words a Form page keeps in machine code -- if, let, the
    ;; int compares, calls, cons, head, tail, nth, str_byte_at -- so a hot reader walks little.
    (defn gx-ok (e v caps) (cons e (cons v caps)))
    (defn gx-sw (s n p)
        (do (let b (str_byte_at s p))
            (if (gt b 47) p
                (if (gt b 32) (if (eq b 47) (gx-sw-slash s n p) p)
                    (if (eq b 32) (gx-sw s n (add p 1))
                        (if (eq b 10) (gx-sw s n (add p 1))
                            (if (eq b 9) (gx-sw s n (add p 1))
                                (if (eq b 13) (gx-sw s n (add p 1)) p))))))))
    ;; a comment is crossed by one native find to its end
    (defn gx-sw-slash (s n p)
        (do (let b (str_byte_at s (add p 1)))
            (if (eq b 47) (gx-sw s n (gx-past (str_find s GX-NL (add p 2)) 1 n))
                (if (eq b 42) (gx-sw s n (gx-past (str_find s "*/" (add p 2)) 2 n)) p))))
    (defn gx-past (e w n) (if (lt e 0) n (add e w)))
    (defn gx-at? (s i lit j k)
        (if (ge j k) 1
            (if (eq (str_byte_at s (add i j)) (str_byte_at lit j)) (gx-at? s i lit (add j 1) k) 0)))
    (defn gx-in? (set b) (eq (str_byte_at set (add b 1)) 49))

    (defn gx (s n x p c caps)
        (do (let op (head p))
            (if (eq op 22) (gx-thru s n x p c caps)
            (if (eq op 23) (gx-ref-rule s n x p c caps)
            (if (eq op 2) (gx-cap s n x p c caps)
            (if (eq op 5) (gx-seq s n x (nth p 1) c caps)
            (if (eq op 3) (gx-lit s n p c caps)
            (if (eq op 6) (gx s n x (nth (nth p 2) (sub (str_byte_at (nth p 1) (add (str_byte_at s (gx-sw s n c)) 1)) 48)) c caps)
            (if (eq op 7) (gx-run s n p c caps)
            (if (eq op 4) (gx-kw s n p c caps)
            (if (eq op 20) (gx-alts s n x (nth p 1) c caps)
            (if (eq op 8) (gx-opt s n x p c caps)
            (if (eq op 9) (gx-rep s n x (nth p 1) c caps (empty))
            (if (eq op 10) (gx-sep s n x p c caps)
            (if (eq op 11) (gx-str s n c caps)
            (if (eq op 13) (gx-num s n c caps)
            (if (eq op 14)
                (do (let m (gx s n x (nth p 1) c caps))
                    (if (eq m 0) 0 (gx-infix-loop s n x p (nth m 1) (tail (tail m)) (head m) 0)))
            (if (eq op 15)
                (do (let m (gx s n x (nth p 1) c caps))
                    (if (eq m 0) 0 (gx-chain-loop s n x (nth p 2) (nth m 1) (tail (tail m)) (head m) (nth p 3))))
            (if (eq op 16) (gx-ternary s n x p c caps)
            (if (eq op 18) (gx-leaf s n x p c caps)
            (if (eq op 12) (gx-char s n c caps)
            (if (eq op 21) (gx-fact s n x p c caps)
            (if (eq op 1) (gx-ref s n x p c caps)
            (if (eq op 17) (if (eq (gx s n x (nth p 1) c caps) 0) (cons c (cons (intern_trivial_string "") caps)) 0)
                0))))))))))))))))))))))))

    ;; A reference: the rule is read only where its FIRST holds the byte past the space. A
    ;; byte above 47 is neither space nor the slash a comment begins with, so most places
    ;; are their own place past the space.
    (defn gx-ref-rule (s n x p c caps)
        (do (let b (str_byte_at s c))
            (let cs (if (gt b 47) c (gx-sw s n c)))
            (if (eq (str_byte_at (nth p 2) (add (if (eq cs c) b (str_byte_at s cs)) 1)) 49)
                (if (eq (nth (nth p 1) 3) 0) (gx-rule-run s n x (nth p 1) c cs caps)
                    (if (eq (nth x 2) 1)
                        (if (eq (head x) 0) (gx-rule-run s n x (nth p 1) c cs caps) (gx-rule-latest s n x (nth p 1) c cs caps))
                        (gx-rule s n x (nth p 1) c cs caps)))
                0)))
    (defn gx-ref (s n x p c caps)
        (do (let b (str_byte_at s c))
            (let cs (if (gt b 47) c (gx-sw s n c)))
            (if (eq (str_byte_at (nth p 2) (add (if (eq cs c) b (str_byte_at s cs)) 1)) 49)
                (do (let r (record_get (nth p 1) "r"))
                    (if (eq (nth r 3) 0) (gx-rule-run s n x r c cs caps)
                        (if (eq (nth x 2) 1)
                            (if (eq (head x) 0) (gx-rule-run s n x r c cs caps) (gx-rule-latest s n x r c cs caps))
                            (gx-rule s n x r c cs caps))))
                0)))
    ;; a rule read through: its one pattern's value is the reading, and the pattern's own
    ;; reading answers when it stands at the place it was given with the captures it was given
    (defn gx-thru (s n x p c caps)
        (do (let b (str_byte_at s c))
            (let cs (if (gt b 47) c (gx-sw s n c)))
            (if (eq (str_byte_at (nth p 2) (add (if (eq cs c) b (str_byte_at s cs)) 1)) 49)
                (do (let m (gx s n x (nth p 1) cs (empty)))
                    (if (eq m 0)
                        (do (if (eq (nth x 1) 0) 0 (g-far-note (nth x 1) (nth p 3) cs)) 0)
                        (if (eq c cs)
                            (if (eq (tail (tail m)) caps) m (cons (head m) (cons (nth m 1) caps)))
                            (cons (if (eq (head m) cs) c (head m)) (cons (nth m 1) caps)))))
                0)))
    ;; A rule marked memo keeps its reading at a place. A pruned reading reads each shared
    ;; beginning once (op 21), so the one retry left is the next one -- a block's last
    ;; expression read as a statement and then as its value -- and the rule's latest reading
    ;; answers it. A traced reading retries as the data does and keeps every reading.
    (defn gx-rule (s n x r c cs caps)
        (if (eq (nth r 3) 0) (gx-rule-run s n x r c cs caps)
            (if (eq (head x) 0) (gx-rule-run s n x r c cs caps)
                (if (eq (nth x 2) 1) (gx-rule-latest s n x r c cs caps) (gx-rule-memo s n x r c cs caps)))))
    ;; Every primitive skips the space before it, so the primitives a rule tries one after
    ;; another at one place would each cross the same comment. The rule crosses it once
    ;; and hands them the place past it; a reading that took nothing answers the place
    ;; it was given, so no space is consumed that was not read.
    (defn gx-rule-run (s n x r c cs caps)
        (do (let m (gx s n x (nth r 1) cs (empty)))
            (if (eq m 0)
                (do (if (eq (nth x 1) 0) 0 (g-far-note (nth x 1) (head r) cs)) 0)
                (if (eq (nth r 4) 1)
                    (if (eq c cs)
                        (if (eq (tail (tail m)) caps) m (cons (head m) (cons (nth m 1) caps)))
                        (cons (if (eq (head m) cs) c (head m)) (cons (nth m 1) caps)))
                    (cons (if (eq (head m) cs) c (head m)) (cons (gx-build (nth r 2) (tail (tail m))) caps))))))
    ;; the latest reading of each memo rule sits in the parse's own record, keyed by the rule
    (defn gx-rule-latest (s n x r c cs caps)
        (do (let slot (nth x 3))
            (let got (record_get slot (nth r 7)))
            (if (if (eq got 0) 0 (eq (record_get slot (nth r 6)) c))
                (if (eq got 1) 0 (cons (head got) (cons (nth got 1) caps)))
                (do (let m (gx-rule-run s n x r c cs caps))
                    (record_set slot (nth r 6) c)
                    (record_set slot (nth r 7) (if (eq m 0) 1 m))
                    m))))
    ;; op 21: the shared beginning read once at the place past the space, then each rule's
    ;; rest from where it ended, with the captures it made; the first rule whose rest holds
    ;; builds its template, as its own reading would
    (defn gx-fact (s n x p c caps)
        (do (let cs (gx-sw s n c))
            (let pm (gx-seq s n x (nth p 1) cs (empty)))
            (if (eq pm 0) 0 (gx-fact-rest s n x (nth p 2) c cs pm caps))))
    (defn gx-fact-rest (s n x ms c cs pm caps)
        (if (eq ms (empty)) 0
            (do (let m (gx-seq s n x (head (head ms)) (head pm) (tail (tail pm))))
                (if (eq m 0) (gx-fact-rest s n x (tail ms) c cs pm caps)
                    (cons (if (eq (head m) cs) c (head m)) (cons (gx-build (nth (head ms) 1) (tail (tail m))) caps))))))
    (defn gx-rule-memo (s n x r c cs caps)
        (do (let shard (gx-memo-shard (head x) (str_concat (nth r 5) (int_to_str (div c 1024)))))
            (let key (int_to_str c))
            (let hit (record_get shard key))
            (if (eq hit 0)
                (do (let m (gx-rule-run s n x r c cs caps))
                    (record_set shard key (if (eq m 0) 1 m))
                    m)
                (if (eq hit 1) 0 (cons (head hit) (cons (nth hit 1) caps))))))
    (defn gx-memo-shard (memo k)
        (do (let held (record_get memo k))
            (if (eq held 0)
                (do (let fresh (record_new 0))
                    (record_set memo k fresh)
                    fresh)
                held)))

    (defn gx-cap (s n x p c caps)
        (do (let m (gx s n x (nth p 2) c caps))
            (if (eq m 0) 0 (cons (head m) (cons GX-UNIT (cons (cons (nth p 1) (cons (nth m 1) (empty))) (tail (tail m))))))))
    (defn gx-seq (s n x parts c caps)
        (if (eq parts (empty)) (cons c (cons GX-UNIT caps))
            (do (let m (gx s n x (head parts) c caps))
                (if (eq m 0) 0 (gx-seq s n x (tail parts) (head m) (tail (tail m)))))))
    (defn gx-alts (s n x alts c caps)
        (if (eq alts (empty)) 0
            (do (let m (gx s n x (head alts) c caps))
                (if (eq m 0) (gx-alts s n x (tail alts) c caps) m))))
    (defn gx-opt (s n x p c caps)
        (do (let m (gx s n x (nth p 1) c caps))
            (if (eq m 0) (cons c (cons GX-UNIT caps)) m)))
    (defn gx-rep (s n x inner c caps acc)
        (do (let m (gx s n x inner c caps))
            (if (eq m 0) (cons c (cons (nlist (reverse acc)) caps))
                (if (gt (head m) c)
                    (gx-rep s n x inner (head m) (tail (tail m)) (cons (nth m 1) acc))
                    (cons c (cons (nlist (reverse acc)) caps))))))
    (defn gx-sep (s n x p c caps)
        (do (let m (gx s n x (nth p 1) c caps))
            (if (eq m 0) (cons c (cons (nlist (empty)) caps))
                (gx-sep-loop s n x (nth p 1) (nth p 2) (head m) (tail (tail m)) (cons (nth m 1) (empty))))))
    (defn gx-sep-loop (s n x inner sepp c caps acc)
        (do (let ms (gx s n x sepp c caps))
            (if (eq ms 0) (cons c (cons (nlist (reverse acc)) caps))
                (do (let mi (gx s n x inner (head ms) (tail (tail ms))))
                    (if (eq mi 0) (cons c (cons (nlist (reverse acc)) caps))
                        (gx-sep-loop s n x inner sepp (head mi) (tail (tail mi)) (cons (nth mi 1) acc)))))))

    ;; a literal; a keyword is one where the next byte cannot continue a name -- so `empty`
    ;; is a keyword and `emptyRows` / `empty?(x)` are names that begin with one. A value
    ;; keyword (empty, nothing, true, false) is a name when a call follows it.
    (defn gx-lit (s n p c caps)
        (do (let cc (gx-sw s n c))
            (if (gx-at? s cc (nth p 1) 0 (nth p 2)) (cons (add cc (nth p 2)) (cons GX-UNIT caps)) 0)))
    (defn gx-kw (s n p c caps)
        (do (let cc (gx-sw s n c))
            (let k (nth p 2))
            (if (gx-at? s cc (nth p 1) 0 k)
                (do (let e (add cc k))
                    (if (ge e n) (cons e (cons GX-UNIT caps))
                        (if (eq (str_byte_at (nth p 4) (add (str_byte_at s e) 1)) 49) 0
                            (if (eq (nth p 3) 1)
                                (if (eq (str_byte_at s (gx-sw s n e)) 40) 0 (cons e (cons GX-UNIT caps)))
                                (cons e (cons GX-UNIT caps))))))
                0)))
    (defn gx-run (s n p c caps)
        (do (let cc (gx-sw s n c))
            (let cls (nth p 1))
            (if (eq (str_byte_at cls (add (str_byte_at s cc) 1)) 49)
                (do (let e (gx-scan s cls (add cc 1)))
                    (cons e (cons (intern_trivial_string (substring s cc e)) caps)))
                0)))
    (defn gx-scan (s cls i) (if (gx-in? cls (str_byte_at s i)) (gx-scan s cls (add i 1)) i))
    ;; a quoted text: past escapes to its closing quote. Its value unescapes; text with no
    ;; escape and no byte past ASCII is already its own value.
    (defn gx-qscan (s n i q)
        (if (ge i n) i
            (do (let b (str_byte_at s i))
                (if (eq b q) i (if (eq b 92) (gx-qscan s n (add i 2) q) (gx-qscan s n (add i 1) q))))))
    (defn gx-str (s n c caps)
        (do (let cc (gx-sw s n c))
            (if (eq (str_byte_at s cc) 34)
                (do (let e (gx-qscan s n (add cc 1) 34))
                    (if (eq (str_byte_at s e) 34)
                        (cons (add e 1) (cons (intern_trivial_string (gx-unescape (substring s (add cc 1) e))) caps))
                        0))
                0)))
    (defn gx-unescape (t) (if (and (lt (str_find t "\\" 0) 0) (gx-ascii? t 0 (str_len t))) t (bmf-unescape-str t)))
    (defn gx-ascii? (t i k) (if (ge i k) 1 (if (lt (str_byte_at t i) 128) (gx-ascii? t (add i 1) k) 0)))
    (defn gx-char (s n c caps)
        (do (let cc (gx-sw s n c))
            (if (eq (str_byte_at s cc) 39)
                (do (let e (gx-qscan s n (add cc 1) 39))
                    (if (eq (str_byte_at s e) 39)
                        (gx-ok (add e 1) (intern_trivial_string (substring s (add cc 1) e)) caps)
                        0))
                0)))
    ;; a number: digits, a fraction, an exponent (e or E, a sign, digits) -- 1e-12, 2.5E+3
    (defn gx-digit? (b) (if (lt b 48) 0 (if (gt b 57) 0 1)))
    (defn gx-digits (s i) (if (gx-digit? (str_byte_at s i)) (gx-digits s (add i 1)) i))
    (defn gx-num (s n c caps)
        (do (let cc (gx-sw s n c))
            (if (gx-digit? (str_byte_at s cc))
                (do (let e (gx-num-exp s (gx-num-frac s (gx-digits s (add cc 1)))))
                    (cons e (cons (intern_trivial_string (substring s cc e)) caps)))
                0)))
    (defn gx-num-frac (s i)
        (if (eq (str_byte_at s i) 46)
            (if (gx-digit? (str_byte_at s (add i 1))) (gx-digits s (add i 2)) i)
            i))
    (defn gx-num-exp (s i)
        (do (let b (str_byte_at s i))
            (if (eq b 101) (gx-num-exp-at s i)
                (if (eq b 69) (gx-num-exp-at s i) i))))
    (defn gx-num-exp-at (s i)
        (do (let b2 (str_byte_at s (add i 1)))
            (let d (if (eq b2 45) (add i 2) (if (eq b2 43) (add i 2) (add i 1))))
            (if (gx-digit? (str_byte_at s d)) (gx-digits s (add d 1)) i)))

    ;; A leaf: a pattern whose reading is the whole operand when one of the follow bytes
    ;; comes next -- a string or a number standing before , ] ) has no operator, call or
    ;; ternary after it, so the chain of rules that would find that out is spared. Any
    ;; other follower leaves the reading to the alternatives after it.
    (defn gx-leaf (s n x p c caps)
        (do (let m (gx s n x (nth p 1) c caps))
            (if (eq m 0) 0
                (if (gx-in? (nth p 2) (str_byte_at s (gx-sw s n (head m)))) m 0))))

    ;; Operators climb by precedence; a call row gives a library operation the same
    ;; machinery, and a row marked right associates to the right.
    (defn gx-climb (s n x p c caps minp)
        (do (let m (gx s n x (nth p 1) c caps))
            (if (eq m 0) 0 (gx-infix-loop s n x p (nth m 1) (tail (tail m)) (head m) minp))))
    (defn gx-infix-loop (s n x p lhs caps c minp)
        (do (let cc (gx-sw s n c))
            (let opm (gx-peek-op-in s cc (nth (nth p 3) (sub (str_byte_at (nth p 2) (add (str_byte_at s cc) 1)) 48))))
            (if (eq opm 0) (cons c (cons lhs caps))
                (do (let e (head opm))
                    (let prec (nth e 3))
                    (if (gt minp prec) (cons c (cons lhs caps))
                        (do (let rhs (gx-climb s n x p (nth opm 1) caps (if (eq (nth e 5) 1) prec (add prec 1))))
                            (if (eq rhs 0) (cons c (cons lhs caps))
                                (gx-infix-loop s n x p (gx-infix-node e lhs (nth rhs 1)) (tail (tail rhs)) (head rhs) minp))))))))
    (defn gx-peek-op-in (s cc es)
        (if (eq es (empty)) 0
            (if (gx-at? s cc (head (head es)) 0 (nth (head es) 1))
                (cons (head es) (cons (add cc (nth (head es) 1)) (empty)))
                (gx-peek-op-in s cc (tail es)))))
    (defn gx-infix-node (e lhs rhs)
        (if (eq (nth e 4) 1)
            (intern_node (bmf-bp "fncall") (list
                (intern_node (bmf-bp "ident") (list (intern_trivial_string (nth e 2)))) lhs rhs))
            (intern_node (bmf-bp (nth e 2)) (list lhs rhs))))

    ;; A pure chain (a fourth element on the pattern) is the functional dialect's: an index
    ;; `[` must touch the term it indexes, and `++` is never a postfix step -- it stays whole
    ;; for the infix reader, where it joins two strings.
    (defn gx-member-name ()
        (do (let held (record_get GX-CLASSES " member"))
            (if (eq held 0)
                (do (let op (list 7 (head (gx-class "alnum")))) (record_set GX-CLASSES " member" op) op)
                held)))
    (defn gx-chain-loop (s n x exprp acc caps c pure)
        (do (let cc (gx-sw s n c))
            (let b (str_byte_at s cc))
            (if (ge cc n) (cons c (cons acc caps))
            (if (eq b 46) (gx-chain-member s n x exprp acc caps c cc pure)
            (if (eq (str_byte_at s (if (eq pure 1) c cc)) 91)
                (gx-chain-index s n x exprp acc caps c (gx-sw s n (add (if (eq pure 1) c cc) 1)) pure)
            (if (eq pure 0) (gx-chain-step s n x exprp acc caps c cc pure)
                (do (let call (if (eq b 40) (gx-args s n x exprp (add cc 1) caps)
                                  (if (eq b 60) (gx-call-generic s n x exprp cc caps) 0)))
                    (if (eq call 0) (cons c (cons acc caps))
                        (gx-chain-loop s n x exprp (intern_node (bmf-bp "fncall") (cons acc (head call))) caps (nth call 1) pure)))))))))
    (defn gx-chain-member (s n x exprp acc caps c cc pure)
        (do (let idm (gx-run s n (gx-member-name) (add cc 1) caps))
            (if (eq idm 0) (gx-ok c acc caps)
                (do (let mem (intern_node (bmf-bp "UE-ACCESS-MEMBER") (cons acc (cons (nth idm 1) (empty)))))
                    (let call (gx-call-suffix s n x exprp (head idm) caps))
                    (if (eq call 0) (gx-chain-loop s n x exprp mem caps (head idm) pure)
                        (gx-chain-loop s n x exprp (intern_node (bmf-bp "fncall") (cons mem (head call))) caps (nth call 1) pure))))))
    ;; the free dialect's postfix ++ and --, else a call
    (defn gx-chain-step (s n x exprp acc caps c cc pure)
        (if (gx-twice? s cc 43) (gx-ok (add cc 2) (intern_node (bmf-bp "UE-MATH-INC") (cons acc (empty))) caps)
            (if (gx-twice? s cc 45) (gx-ok (add cc 2) (intern_node (bmf-bp "UE-MATH-DEC") (cons acc (empty))) caps)
                (do (let call (gx-call-suffix s n x exprp cc caps))
                    (if (eq call 0) (gx-ok c acc caps)
                        (gx-chain-loop s n x exprp (intern_node (bmf-bp "fncall") (cons acc (head call))) caps (nth call 1) pure))))))
    (defn gx-twice? (s i b) (if (eq (str_byte_at s i) b) (eq (str_byte_at s (add i 1)) b) 0))
    (defn gx-chain-index (s n x exprp acc caps checkpoint at pure)
        (do (let missing (intern_node (bmf-bp "fncall") (list (intern_node (bmf-bp "ident") (list (intern_trivial_string "nothing"))))))
            (let first (if (eq (str_byte_at s at) 58) (gx-ok at missing caps) (gx s n x exprp at caps)))
            (if (eq first 0) (gx-ok checkpoint acc caps)
                (do (let next (gx-sw s n (head first)))
                    (let b (str_byte_at s next))
                    (if (eq b 93)
                        (gx-chain-loop s n x exprp (intern_node (bmf-bp "UE-ACCESS-INDEX") (list acc (nth first 1))) caps (add next 1) pure)
                    (if (eq b 58) (gx-chain-slice s n x exprp acc caps checkpoint next first missing pure)
                        (gx-ok checkpoint acc caps)))))))
    (defn gx-chain-slice (s n x exprp acc caps checkpoint next first missing pure)
        (do (let end (gx-sw s n (add next 1)))
            (let last (if (eq (str_byte_at s end) 93) (gx-ok end missing caps) (gx s n x exprp end caps)))
            (if (eq last 0) (gx-ok checkpoint acc caps)
                (do (let close (gx-sw s n (head last)))
                    (if (eq (str_byte_at s close) 93)
                        (gx-chain-loop s n x exprp
                            (intern_node (bmf-bp "fncall") (list
                                (intern_node (bmf-bp "ident") (list (intern_trivial_string "$bml-slice")))
                                acc (nth first 1) (nth last 1))) caps (add close 1) pure)
                        (gx-ok checkpoint acc caps))))))
    ;; call arguments: ( args ) or a generic <...> before them; nothing when no call follows
    (defn gx-call-suffix (s n x exprp c caps)
        (do (let cc (gx-sw s n c))
            (let b (str_byte_at s cc))
            (if (eq b 40) (gx-args s n x exprp (add cc 1) caps)
                (if (eq b 60) (gx-call-generic s n x exprp cc caps) 0))))
    (defn gx-call-generic (s n x exprp cc caps)
        (do (let gc (gx-gen-scan s n (add cc 1) 1))
            (if (lt gc 0) 0
                (do (let cg (gx-sw s n gc))
                    (if (eq (str_byte_at s cg) 40) (gx-args s n x exprp (add cg 1) caps) 0)))))
    (defn gx-gen-scan (s n i depth)
        (if (ge i n) -1
            (do (let b (str_byte_at s i))
                (if (eq b 62) (if (eq depth 1) (add i 1) (gx-gen-scan s n (add i 1) (sub depth 1)))
                (if (eq b 60) (gx-gen-scan s n (add i 1) (add depth 1))
                (if (gx-gen-stop? b) -1
                    (gx-gen-scan s n (add i 1) depth)))))))
    (defn gx-gen-stop? (b)
        (if (eq b 40) 1 (if (eq b 41) 1 (if (eq b 59) 1 (if (eq b 123) 1 (eq b 125))))))
    (defn gx-args (s n x exprp c caps)
        (do (let cc (gx-sw s n c))
            (if (eq (str_byte_at s cc) 41) (cons (empty) (cons (add cc 1) (empty)))
                (gx-args-loop s n x exprp c caps (empty)))))
    (defn gx-args-loop (s n x exprp c caps acc)
        (do (let m (gx s n x exprp c caps))
            (if (eq m 0) (cons (empty) (cons c (empty)))
                (do (let cc (gx-sw s n (head m)))
                    (let more (cons (nth m 1) acc))
                    (let b (str_byte_at s cc))
                    (if (eq b 44) (gx-args-loop s n x exprp (add cc 1) caps more)
                        (if (eq b 41) (cons (reverse more) (cons (add cc 1) (empty)))
                            (cons (reverse more) (cons (head m) (empty)))))))))

    (defn gx-ternary (s n x p c caps)
        (do (let m (gx s n x (nth p 1) c caps))
            (if (eq m 0) 0
                (do (let cc (gx-sw s n (head m)))
                    (if (eq (str_byte_at s cc) 63) (gx-ternary-arms s n x p m cc caps)
                        (if (eq (tail (tail m)) caps) m (cons (head m) (cons (nth m 1) caps))))))))
    (defn gx-ternary-arms (s n x p m cc caps)
        (do (let tm (gx s n x (nth p 2) (add cc 1) caps))
            (if (eq tm 0) 0
                (do (let cb (gx-sw s n (head tm)))
                    (if (eq (str_byte_at s cb) 58)
                        (do (let em (gx s n x (nth p 2) (add cb 1) caps))
                            (if (eq em 0) 0
                                (gx-ok (head em) (intern_node (bmf-bp (nth p 3)) (list (nth m 1) (nth tm 1) (nth em 1))) caps)))
                        0)))))

    ;; the record of the latest memo readings, kept in the memo the parse owner releases
    (defn gx-latest (memo) (if (eq memo 0) 0 (gx-memo-shard memo "latest")))
    ;; A reading over a cursor: a string surface is read in place; any other surface is
    ;; read whole into a string first, since a reading backtracks over it.
    (defn gx-text (sf) (if (str_eq (surf-kind sf) "file-window") (read_file (surf-payload sf)) ""))
    (defn g-match-rule (g name c0)
        (do (let c (if (str_eq (surf-kind (cur-surface c0)) "string") c0
                (cursor-row (surface-string (gx-text (cur-surface c0))) (cur-pos c0) (empty))))
            (let traced (gt (len g) 5))
            (let cell (record_get (gx-compiled (g-rules g) traced) name))
            (if (eq cell 0) (list "rno")
                (do (let s (surf-payload (cur-surface c)))
                    (let n (str_len s))
                    (let pos (cur-pos c))
                    (let memo (if (gt (len g) 4) (nth g 4) 0))
                    (let m (gx-rule s n (list memo (if traced (nth g 5) 0) (if traced 0 1) (gx-latest (if traced 0 memo)))
                        (record_get cell "r") pos (gx-sw s n pos) (empty)))
                    (if (eq m 0) (list "rno")
                        (list "rok" (nth m 1)
                            (if (eq (head m) pos) c (cursor-row (cur-surface c) (head m) (cur-state c)))))))))

    ;; a template built from a reading's captures (gc-tpl's ops)
    (defn gx-build (t caps)
        (do (let op (head t))
            (if (eq op 1)
                (do (let held (record_get (nth t 2) "c"))
                    (intern_node (if (eq held 0) (gx-cat t) held) (gx-kids (nth t 3) caps)))
            (if (eq op 2) (gc-get caps (nth t 1))
            ;; bind: a name alone, or $bml-typed[name, type] when a contract was captured
            (if (eq op 5)
                (do (let n (gc-get caps (nth t 1)))
                    (let ty (gc-get caps (nth t 2)))
                    (if (str_eq (node_value ty) "") n
                        (intern_node (bmf-bp "fncall")
                            (list (intern_node (bmf-bp "ident") (list (intern_trivial_string "$bml-typed"))) n ty))))
            (if (eq op 6) (intern_trivial_string (nth t 1))
            (if (eq op 3) (g-build-num (node_value (gc-get caps (nth t 1))))
            (if (eq op 4) (g-build-num (str_concat "-" (node_value (gc-get caps (nth t 1)))))
            (if (eq op 7) (intern_trivial_int (nth t 1))
            (if (eq op 8) (intern_trivial_bool (nth t 1))
            ;; wrap-rest: the first capture alone when the repeated capture is empty,
            ;; else fncall[ident name, first, rest...] -- one parse, no wrapper for
            ;; the common case (an operand with no ?? after it)
            (if (eq op 9)
                (do (let first (gc-get caps (nth t 1)))
                    (let rest (nlist-items (gc-get caps (nth t 2))))
                    (if (nil? rest) first
                        (intern_node (bmf-bp "fncall")
                            (cons (intern_node (bmf-bp "ident") (list (intern_trivial_string (nth t 3))))
                                  (cons first rest)))))
                (intern_trivial_string "?"))))))))))))
    ;; an emit's category, made the first time a node asks it and held by the emit after
    (defn gx-cat (t) (do (let cat (bmf-bp (nth t 1))) (record_set (nth t 2) "c" cat) cat))
    ;; gm-num scans "d+" or "d+.d+" as one text; the template that splices it
    ;; interns the kind the text spells. str_to_int over "1.5" answered 1 --
    ;; the cursor lane truncated every decimal literal silently (form.lift has
    ;; no line-compiler verifier to catch it; form.bml's did, and fell back).
    (defn g-build-num (text)
        (if (or (ge (str_find text "." 0) 0)
                (or (ge (str_find text "e" 0) 0) (ge (str_find text "E" 0) 0)))
            (intern_trivial_float text)
            (intern_trivial_int (str_to_int text))))
    (defn gx-kids (kids caps)
        (if (eq kids (empty)) (empty)
            (do (let k (head kids))
                (if (eq (head k) 11)
                    (append (nlist-items (gc-get caps (nth k 1))) (gx-kids (tail kids) caps))
                    (cons (gx-build k caps) (gx-kids (tail kids) caps))))))

    (defn g-parse (g src)
        (do (let rr (g-match-rule g (g-start g) (cursor-str src)))
            (if (rok? rr) (rok-node rr) (intern_trivial_string "PARSE-FAIL"))))
    (defn g-complete? (rr)
        (if (rok? rr) (cur-eof? (skip-ws (rok-cur rr))) 0))
    (defn g-match-full-rule (g name c)
        (do (let rr (g-match-rule g name c))
            (if (g-complete? rr) rr (list "rno"))))
    (defn g-parse-full (g src)
        (do (let owned (g-armed g))
            (let rr (g-match-rule owned (g-start g) (cursor-str src)))
            (let result (if (g-complete? rr) (rok-node rr) (intern_trivial_string "PARSE-FAIL")))
            (g-memo-release owned)
            result))

    (defn p-lit (s) (list "lit" s))
    (defn p-kw (s) (list "lit" s "kw"))
    (defn p-kw-value (s) (list "lit" s "kw" "value"))
    (defn p-ref (n) (list "ref" n))
    (defn p-run (cls) (list "run" cls))
    (defn p-cap (n p) (list "cap" n p))
    (defn p-opt (p) (list "opt" p))
    (defn p-not (p) (list "not" p))
    (defn p-rep (p) (list "rep" p))
    (defn p-sep (p s) (list "sep" p s))
    (defn p-str () (list "str"))
    (defn p-char () (list "char"))
    (defn p-num () (list "num"))
    (defn p-infix (operand table) (list "infix" operand table))
    (defn p-chain (base exprp) (list "chain" base exprp))
    (defn p-chain-pure (base exprp) (list "chain" base exprp "pure"))
    (defn p-leaf (p follow) (list "leaf" p follow))
    (defn p-ternary (cond branch) (list "ternary" cond branch))
    (defn p-ternary-as (cond branch op) (list "ternary" cond branch op))
    (defn t-emit (op kids) (list "emit" op kids))
    (defn t-splice (n) (list "splice" n))
    (defn t-splice-int (n) (list "splice-int" n))
    (defn t-splice-neg (n) (list "splice-neg" n))
    (defn t-bind (name type) (list "bind" name type))
    (defn t-splices (n) (list "splice*" n))
    (defn t-wrap-rest (first rest name) (list "wrap-rest" first rest name))
    (defn t-const (s) (list "const" s))
    (defn t-const-int (n) (list "const-int" n))
    (defn t-const-bool (n) (list "const-bool" n))
)
