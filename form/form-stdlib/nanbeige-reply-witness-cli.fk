; stdin: carrier revision, size, sha256, runtime revision, prompt-id, response
; preludes: form-stdlib/core.fk form-stdlib/nanbeige-gguf-admission.fk form-stdlib/nanbeige-reply-witness.fk

(do
    (let revision (read_line))
    (let size (str_to_int (read_line)))
    (let sha (read_line))
    (let runtime-revision (read_line))
    (let prompt-id (read_line))
    (let response (read_line))
    (print_str
        (str_concat "reply_verified="
            (str_concat
                (int_to_str
                    (nbrw-verify? revision size sha runtime-revision
                                  prompt-id response))
                "\n"))))
