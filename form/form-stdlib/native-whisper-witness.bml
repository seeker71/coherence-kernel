// Reproducible public-audio witness. Artifacts go only to the caller's directory.
// preludes: form-stdlib/native-whisper-transcribe.bml
section [form.bml] {
 class NativeWhisperWitness {
  def nww-header(n) = enw-bytes-str(append([82,73,70,70],append(ln-u32-bytes((36 + n)),append([87,65,86,69,102,109,116,32],append(ln-u32-bytes(16),append([1,0,1,0],append(ln-u32-bytes(16000),append(ln-u32-bytes(32000),append([2,0,16,0,100,97,116,97],ln-u32-bytes(n))))))))));
  def nww-wav(path,pcm) = nag-write(path,str_concat(nww-header(str_len(pcm)),pcm));
  def nww-get(r,k) = node_value(json-object-get(r,k));
  def nww-one(dir,name,path,cancel) {
   let stem = str_concat(dir,str_concat("/",name));
   let r = nwt-transcribe(nws-base(),path,"",str_concat(stem,".stream"),cancel,str_concat(stem,".events.jsonl"));
   let written = nag-write(str_concat(stem,".json"),json-emit-precise(r));
   let shown = print_str(str_concat(name,str_concat(" ",json-emit-precise(r))));
   r;
  }
  def nww-reference(dir,name,language) {
   let stem = str_concat("model/fixtures/whisper-native/",name);
   let result = nww-one(dir,name,str_concat(stem,".wav"),"");
   (((String) nww-get(result,"status") == "completed") && (((String) nww-get(result,"language") == language) && ((String) nww-get(result,"text") == trim(read_file(str_concat(stem,".txt"))))));
  }
  def nww-run(dir) {
   let made = fs-mkdir(dir); let public = "model/fixtures/whisper-tiny/lingua-libre-book-16k.wav";
   let pcm = read_file_slice(public,44,(file_size(public) - 44));
   let longpath = str_concat(dir,"/two-books.wav"); let longwav = nww-wav(longpath,str_concat(pcm,str_concat(enw-zeros(byte_to_str(0),(960000 - str_len(pcm))),pcm)));
   let silentpath = str_concat(dir,"/silence.wav"); let silentwav = nww-wav(silentpath,enw-zeros(byte_to_str(0),32000));
   let tailpath = str_concat(dir,"/book-then-silence.wav"); let tailwav = nww-wav(tailpath,str_concat(pcm,enw-zeros(byte_to_str(0),(1024000 - str_len(pcm)))));
   let book = nww-one(dir,"book",public,""); let long = nww-one(dir,"long",longpath,""); let silence = nww-one(dir,"silence",silentpath,""); let silentTail = nww-one(dir,"silent-tail",tailpath,"");
   let cancel = str_concat(dir,"/cancel"); let signal = nag-write(cancel,"cancel"); let cancelled = nww-one(dir,"cancelled",public,cancel);
   let single = (((String) nww-get(book,"status") == "completed") && (((String) nww-get(book,"text") == "book.") && (((Comparable) nww-get(book,"sampled_tokens") == 5) && ((Comparable) nww-get(book,"model_forward_tokens") == 7))));
   let multiple = (((String) nww-get(long,"status") == "completed") && (((String) nww-get(long,"text") == "book. book.") && (((Comparable) nww-get(long,"windows") == 2) && ((Comparable) nww-get(long,"processed_samples") == 491392))));
   let quiet = (((String) nww-get(silence,"status") == "completed") && ((Comparable) str_len(nww-get(silence,"text")) == 0));
   let stopped = (((String) nww-get(cancelled,"status") == "cancelled") && (((Comparable) nww-get(cancelled,"windows") == 0) && ((Comparable) nww-get(cancelled,"sampled_tokens") == 0)));
   let tailquiet = (((String) nww-get(silentTail,"status") == "completed") && (((String) nww-get(silentTail,"text") == "book.") && (((Comparable) nww-get(silentTail,"windows") == 2) && ((Comparable) nww-get(silentTail,"sampled_tokens") == 5))));
   let english = nww-reference(dir,"en_GB-cori-high","en"); let german = nww-reference(dir,"de_DE-thorsten-high","de"); let persian = nww-reference(dir,"fa_IR-amir-medium","fa");
   let freed = ((Comparable) metal_live()[2] == 0); let report = [single,multiple,quiet,tailquiet,stopped,english,german,persian,freed];
   let pass = ((Value) report == [1,1,1,1,1,1,1,1,1]);
   let saved = nag-write(str_concat(dir,"/checks.txt"),str_concat(int_to_str(if pass then 511 else 0),"\n"));
   let shown = print(report);
   if pass then 511 else form_error("native Whisper live witness failed; retained evidence names the case");
  }
 }
 0;
}
