// Reproducible public-audio witness. Artifacts go only to the caller's directory.
// preludes: form-stdlib/native-whisper-transcribe.bml
section [form.bml] {
 class NativeWhisperWitness {
  def nww-header(n) = enw-bytes-str(append(list(82,73,70,70),append(ln-u32-bytes(36 + n),append(list(87,65,86,69,102,109,116,32),append(ln-u32-bytes(16),append(list(1,0,1,0),append(ln-u32-bytes(16000),append(ln-u32-bytes(32000),append(list(2,0,16,0,100,97,116,97),ln-u32-bytes(n))))))))));
  def nww-wav(path,pcm) = nag-write(path,nww-header(str_len(pcm)) ++ pcm);
  def nww-get(r,k) = node_value(json-object-get(r,k));
  def nww-one(dir,name,path,cancel) {
   let stem = dir ++ "/" ++ name;
   let r = nwt-transcribe(nws-base(),path,"",stem ++ ".stream",cancel,stem ++ ".events.jsonl");
   let written = nag-write(stem ++ ".json",json-emit-precise(r));
   let shown = print_str(name ++ " " ++ json-emit-precise(r));
   r;
  }
  def nww-reference(dir,name,language) {
   let stem = "model/fixtures/whisper-native/" ++ name;
   let result = nww-one(dir,name,stem ++ ".wav","");
   ((String) nww-get(result,"status") == "completed") && (((String) nww-get(result,"language") == language) && ((String) nww-get(result,"text") == trim(read_file(stem ++ ".txt"))));
  }
  def nww-run(dir) {
   let made = fs-mkdir(dir); let public = "model/fixtures/whisper-tiny/lingua-libre-book-16k.wav";
   let pcm = read_file_slice(public,44,file_size(public) - 44);
   let longpath = dir ++ "/two-books.wav"; let longwav = nww-wav(longpath,pcm ++ enw-zeros(byte_to_str(0),960000 - str_len(pcm)) ++ pcm);
   let silentpath = dir ++ "/silence.wav"; let silentwav = nww-wav(silentpath,enw-zeros(byte_to_str(0),32000));
   let tailpath = dir ++ "/book-then-silence.wav"; let tailwav = nww-wav(tailpath,pcm ++ enw-zeros(byte_to_str(0),1024000 - str_len(pcm)));
   let book = nww-one(dir,"book",public,""); let long = nww-one(dir,"long",longpath,""); let silence = nww-one(dir,"silence",silentpath,""); let silentTail = nww-one(dir,"silent-tail",tailpath,"");
   let cancel = dir ++ "/cancel"; let signal = nag-write(cancel,"cancel"); let cancelled = nww-one(dir,"cancelled",public,cancel);
   let single = ((String) nww-get(book,"status") == "completed") && (((String) nww-get(book,"text") == "book.") && (((Comparable) nww-get(book,"sampled_tokens") == 5) && ((Comparable) nww-get(book,"model_forward_tokens") == 7)));
   let multiple = ((String) nww-get(long,"status") == "completed") && (((String) nww-get(long,"text") == "book. book.") && (((Comparable) nww-get(long,"windows") == 2) && ((Comparable) nww-get(long,"processed_samples") == 491392)));
   let quiet = ((String) nww-get(silence,"status") == "completed") && ((Comparable) str_len(nww-get(silence,"text")) == 0);
   let stopped = ((String) nww-get(cancelled,"status") == "cancelled") && (((Comparable) nww-get(cancelled,"windows") == 0) && ((Comparable) nww-get(cancelled,"sampled_tokens") == 0));
   let tailquiet = ((String) nww-get(silentTail,"status") == "completed") && (((String) nww-get(silentTail,"text") == "book.") && (((Comparable) nww-get(silentTail,"windows") == 2) && ((Comparable) nww-get(silentTail,"sampled_tokens") == 5)));
   let english = nww-reference(dir,"en_GB-cori-high","en"); let german = nww-reference(dir,"de_DE-thorsten-high","de"); let persian = nww-reference(dir,"fa_IR-amir-medium","fa");
   let freed = (Comparable) metal_live()[2] == 0; let report = list(single,multiple,quiet,tailquiet,stopped,english,german,persian,freed);
   let pass = (Value) report == list(1,1,1,1,1,1,1,1,1);
   let saved = nag-write(dir ++ "/checks.txt",int_to_str(pass ? 511 : 0) ++ "\n");
   let shown = print(report);
   pass ? 511 : form_error("native Whisper live witness failed; retained evidence names the case");
  }
 }
 0;
}
