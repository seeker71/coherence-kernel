// public-source-concept-shards.fk -- streamed, resumable repository registry.
//
// The 30-source public-source-concept-index is the small in-memory proof.  This
// cell carries the same source/entry NodeIDs across the live repository without
// retaining one giant path or entry list:
//
//   family source tree -> hex path plan -> bounded cursor batches
//                      -> family / path-hash-bucket / one entry artifact
//
// Every artifact is an independently replaceable typed record.  Incremental
// rebuild overwrites exactly that source coordinate; it never appends a stale
// historical entry or needs a flattened table.  Worker processes may stop at
// any batch boundary and resume from the persisted byte cursor.
//
// Concept keys are born scannerlessly from public source observations: a
// path-hash-unique coordinate, normalized path stem, bounded first title line,
// and the first visible defn/defdata/class/grammar name where present.  At least
// the unique source coordinate is always usable.  No source payload is stored.
//
// Sources larger than 16 MiB are honestly named `over-budget` and remain in
// every denominator.  The source digest is streamed through bounded windows
// and concept extraction reads only the bounded head, so this is an elapsed-
// work admission bound rather than a retained-source-body bound.  The current
// body maximum is below 1 MiB; every present source can enter without claiming
// that a finite worker has infinite fuel.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk
section [form.bml] {
    def pscish-schema() = "public-source-concept-shards-v1";
    def pscish-record-schema() = "pscish-entry-v2";
    def pscish-build-state-schema() = "pscish-build-state-v1";
    def pscish-validate-state-schema() = "pscish-validate-state-v1";
    def pscish-batch-size() = 32;
    def pscish-max-source-bytes() = 16777216;
    def pscish-source-over-budget?(size) = size > pscish-max-source-bytes() ? 1 : 0;
    def pscish-head-bytes() = 4096;
    def pscish-plan-window() = 1024;
    def pscish-request-name() = "public-source-concept-shard-request-v1";
    def pscish-request-path-at(control-dir) = fs-path-join(control-dir, pscish-request-name());
    // Compatibility door for a directly invoked worker.  The bounded driver
    // below uses an artifact/family-isolated temp root instead, so an unrelated
    // band cannot replace a live worker's control row between write and read.
    def pscish-request-path() = pscish-request-path-at(fs-temp-dir());
    // ---- bounded scannerless concept birth -------------------------------
    def pscish-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def pscish-key-byte?(b) = b >= 97 && b <= 122 || b >= 48 && b <= 57 ? 1 : 0;
    def pscish-source-name-byte?(b) = b >= 65 && b <= 90 || (b >= 97 && b <= 122 || (b >= 48 && b <= 57 || ((Comparable) b == 45 || ((Comparable) b == 95 || ((Comparable) b == 63 || (Comparable) b == 33))))) ? 1 : 0;
    def pscish-normalize-loop(raw, at, max, out, pending-separator) = at >= str_len(raw) || str_len(out) >= max ? out : {
        let b = pscish-lower-byte(str-byte-at(raw, at));
        (Comparable) pscish-key-byte?(b) == 1 ? {
            let room = max - str_len(out);
            let separated = (Comparable) pending-separator == 1 && str_len(out) > 0 ? room > 1 ? str_concat(out, "-") : out : out;
            str_len(separated) >= max ? separated : pscish-normalize-loop(raw, at + 1, max, str_concat(separated, byte_to_str(b)), 0);
        } : pscish-normalize-loop(raw, at + 1, max, out, str_len(out) > 0 ? 1 : 0);
    };
    def pscish-normalize(raw, max) = pscish-normalize-loop(raw, 0, max, "", 0);
    def pscish-clip-key(key) = str_len(key) <= psci-max-concept-key-bytes() ? key : substring(key, 0, psci-max-concept-key-bytes());
    def pscish-prefixed-key(prefix, value) = (Comparable) str_len(value) == 0 ? "" : pscish-clip-key(str_concat(prefix, value));
    def pscish-path-hash(path) = hex-encode(sha256-stream-string(path));
    def pscish-control-dir(artifact, family) = fs-path-join(fs-temp-dir(), str_concat("pscish-control-", str_concat(substring(pscish-path-hash(str_concat(artifact, str_concat("|", family))), 0, 32), str_concat("-", family))));
    def pscish-path-stem(path) = {
        let base = fs-path-basename(path);
        let ext = fs-path-extension(base);
        (Comparable) str_len(ext) == 0 ? base : substring(base, 0, str_len(base) - str_len(ext));
    };
    def pscish-unique-key(family, path) = {
        let stem = pscish-normalize(pscish-path-stem(path), 24);
        let named = (Comparable) str_len(stem) == 0 ? "source" : stem;
        pscish-clip-key(str_concat("source-", str_concat(family, str_concat("-", str_concat(named, str_concat("-", substring(pscish-path-hash(path), 0, 16)))))));
    };
    def pscish-first-line(text) = {
        let at = str_find(text, "\n", 0);
        at < 0 ? text : substring(text, 0, at);
    };
    def pscish-title-key(head) = pscish-prefixed-key("title-", pscish-normalize(pscish-first-line(head), 40));
    def pscish-name-end(text, at) = at >= str_len(text) ? at : (Comparable) pscish-source-name-byte?(str-byte-at(text, at)) == 1 ? pscish-name-end(text, at + 1) : at;
    def pscish-name-after(text, marker) = {
        let found = str_find(text, marker, 0);
        found < 0 ? "" : {
            let start = found + str_len(marker);
            let end = pscish-name-end(text, start);
            end <= start ? "" : substring(text, start, end);
        };
    };
    def pscish-defn-key(head) = pscish-prefixed-key("defn-", pscish-normalize(pscish-name-after(head, "(defn "), 40));
    def pscish-defdata-key(head) = pscish-prefixed-key("defdata-", pscish-normalize(pscish-name-after(head, "(defdata "), 36));
    def pscish-class-key(head) = pscish-prefixed-key("class-", pscish-normalize(pscish-name-after(head, "class "), 40));
    def pscish-line-start-before(text, at) = at <= 0 ? 0 : (Comparable) str-byte-at(text, at - 1) == 10 ? at : pscish-line-start-before(text, at - 1);
    def pscish-grammar-key(head) = {
        let at = str_find(head, "::=", 0);
        at < 0 ? "" : {
            let start = pscish-line-start-before(head, at);
            pscish-prefixed-key("grammar-", pscish-normalize(substring(head, start, at), 38));
        };
    };
    def pscish-key-member?(key, keys) = nil?(keys) ? 0 : (String) key == head(keys) ? 1 : pscish-key-member?(key, tail(keys));
    def pscish-add-key(keys, key) = (Comparable) psci-concept-key-valid?(key) == 0 || (Comparable) pscish-key-member?(key, keys) == 1 ? keys : len(keys) >= psci-max-concept-keys() ? keys : cons(key, keys);
    def pscish-derived-keys-at(root, family, path) = {
        let full = fs-path-join(root, path);
        let head = fs-read-slice(full, 0, fs-stat-size(full) < pscish-head-bytes() ? fs-stat-size(full) : pscish-head-bytes());
        let k0 = pscish-add-key(empty(), pscish-unique-key(family, path));
        let k1 = pscish-add-key(k0, pscish-prefixed-key("path-", pscish-normalize(pscish-path-stem(path), 40)));
        let k2 = pscish-add-key(k1, pscish-title-key(head));
        let k3 = pscish-add-key(k2, pscish-defn-key(head));
        let k4 = pscish-add-key(k3, pscish-defdata-key(head));
        let k5 = pscish-add-key(k4, pscish-class-key(head));
        let k6 = pscish-add-key(k5, pscish-grammar-key(head));
        reverse(k6);
    };
    // ---- small typed text codecs ----------------------------------------
    def pscish-split-loop(text, delimiter, start, acc) = {
        let at = str_find(text, delimiter, start);
        at < 0 ? reverse(cons(substring(text, start, str_len(text)), acc)) : pscish-split-loop(text, delimiter, at + str_len(delimiter), cons(substring(text, start, at), acc));
    };
    def pscish-split(text, delimiter) = pscish-split-loop(text, delimiter, 0, empty());
    def pscish-join-loop(parts, delimiter, out) = nil?(parts) ? out : pscish-join-loop(tail(parts), delimiter, (Comparable) str_len(out) == 0 ? head(parts) : str_concat(out, str_concat(delimiter, head(parts))));
    def pscish-join(parts, delimiter) = pscish-join-loop(parts, delimiter, "");
    def pscish-string-hex(s) = hex-encode(host-abi-string-to-bytes(s));
    def pscish-hex-string(h) = (Comparable) hex-valid?(h) == 0 ? "" : host-abi-bytes-to-string(hex-decode(h));
    // Worker restarts expose a narrow seam: numeric intern_node coordinates are
    // process-local observations, not stable serialized addresses.  Keep those
    // observed NodeIDs as telemetry, while these canonical child digests carry
    // stable cross-process content identity.  Validation reconstructs the node
    // in its own process and checks these keys; it never compares local numeric
    // coordinates from two different processes.
    def pscish-source-content-key(source) = hex-encode(sha256-stream-string(pscish-join(list(psci-source-family(source), pscish-string-hex(psci-source-path(source)), psci-source-id(source), int_to_str(psci-source-size(source))), "|")));
    def pscish-entry-content-key(entry) = hex-encode(sha256-stream-string(pscish-join(list(pscish-source-content-key(psci-entry-source(entry)), pscish-join(psci-entry-keys(entry), ",")), "|")));
    // record fields: schema | family | path-hex | digest-hex | size |
    //   observed-source-nodeid | observed-entry-nodeid |
    //   source-content-key | entry-content-key | unique-key | keys-csv
    def pscish-render-entry(entry) = {
        let source = psci-entry-source(entry);
        let family = psci-source-family(source);
        let path = psci-source-path(source);
        let keys = psci-entry-keys(entry);
        pscish-join(list(pscish-record-schema(), family, pscish-string-hex(path), substring(psci-source-id(source), 7, 71), int_to_str(psci-source-size(source)), psci-node-key(source), psci-node-key(entry), pscish-source-content-key(source), pscish-entry-content-key(entry), pscish-unique-key(family, path), pscish-join(keys, ",")), "|");
    };
    // parsed record = (schema family path source-id size source entry unique keys
    //                  observed-source-nodeid observed-entry-nodeid
    //                  source-content-key entry-content-key)
    def pscish-parse-entry(text) = {
        let fields = pscish-split(text, "|");
        !((Comparable) len(fields) == 11) ? empty() : !((String) nth(fields, 0) == pscish-record-schema()) ? empty() : {
            let family = nth(fields, 1);
            let path = pscish-hex-string(nth(fields, 2));
            let source-id = str_concat("sha256:", nth(fields, 3));
            let size = str_to_int(nth(fields, 4));
            let keys = pscish-split(nth(fields, 10), ",");
            (Comparable) psci-path-valid-for-family?(path, family) == 0 || ((Comparable) psci-source-id-valid?(source-id) == 0 || (size < 0 || (Comparable) psci-concept-keys-valid?(keys) == 0)) ? empty() : {
                let source = psci-source-node(family, path, source-id, size);
                let entry = psci-entry(source, keys);
                !((String) nth(fields, 7) == pscish-source-content-key(source)) || (!((String) nth(fields, 8) == pscish-entry-content-key(entry)) || (!((String) nth(fields, 9) == pscish-unique-key(family, path)) || (Comparable) pscish-key-member?(nth(fields, 9), keys) == 0)) ? empty() : list(pscish-record-schema(), family, path, source-id, size, source, entry, nth(fields, 9), keys, nth(fields, 5), nth(fields, 6), nth(fields, 7), nth(fields, 8));
            };
        };
    };
    def pscish-record-family(r) = nth(r, 1);
    def pscish-record-path(r) = nth(r, 2);
    def pscish-record-source-id(r) = nth(r, 3);
    def pscish-record-size(r) = nth(r, 4);
    def pscish-record-source(r) = nth(r, 5);
    def pscish-record-entry(r) = nth(r, 6);
    def pscish-record-unique-key(r) = nth(r, 7);
    def pscish-record-keys(r) = nth(r, 8);
    def pscish-record-observed-source-nodeid(r) = nth(r, 9);
    def pscish-record-observed-entry-nodeid(r) = nth(r, 10);
    def pscish-record-source-content-key(r) = nth(r, 11);
    def pscish-record-entry-content-key(r) = nth(r, 12);
    // ---- sharded artifact coordinates -----------------------------------
    def pscish-plan-path(artifact, family) = fs-path-join(artifact, str_concat(family, ".plan"));
    def pscish-build-state-path(artifact, family) = fs-path-join(artifact, str_concat(family, ".build.state"));
    def pscish-validate-state-path(artifact, family) = fs-path-join(artifact, str_concat(family, ".validate.state"));
    def pscish-shards-root(artifact) = fs-path-join(artifact, "shards");
    def pscish-family-shard-root(artifact, family) = fs-path-join(pscish-shards-root(artifact), family);
    def pscish-entry-artifact-path(artifact, family, path) = {
        let hash = pscish-path-hash(path);
        fs-path-join(fs-path-join(pscish-family-shard-root(artifact, family), substring(hash, 0, 2)), str_concat(hash, ".psci"));
    };
    def pscish-ensure-artifact-dirs(artifact, family, path) = {
        let _a = fs-mkdir(artifact);
        let _s = fs-mkdir(pscish-shards-root(artifact));
        let _f = fs-mkdir(pscish-family-shard-root(artifact, family));
        let hash = pscish-path-hash(path);
        let _b = fs-mkdir(fs-path-join(pscish-family-shard-root(artifact, family), substring(hash, 0, 2)));
        1;
    };
    // ---- streamed family plan -------------------------------------------
    def pscish-plan-append(plan, path) = fs-append-bytes(plan, host-abi-string-to-bytes(str_concat(pscish-string-hex(path), "\n")));
    def pscish-plan-dir-loop(root, relative, names, family, plan, count) = nil?(names) ? count : {
        let name = head(names);
        let path = fs-path-join(relative, name);
        let full = fs-path-join(root, path);
        (Comparable) psci-hidden-name?(name) == 1 ? pscish-plan-dir-loop(root, relative, tail(names), family, plan, count) : (Comparable) psci-path-valid-for-family?(path, family) == 1 ? {
            let _append = pscish-plan-append(plan, path);
            pscish-plan-dir-loop(root, relative, tail(names), family, plan, count + 1);
        } : {
            let children = fs-list(full);
            let nested = nil?(children) ? count : pscish-plan-dir-loop(root, path, children, family, plan, count);
            pscish-plan-dir-loop(root, relative, tail(names), family, plan, nested);
        };
    };
    def pscish-build-state(cursor, planned, indexed, over-budget, failures, collisions, done) = list(pscish-build-state-schema(), cursor, planned, indexed, over-budget, failures, collisions, done);
    def pscish-render-build-state(s) = pscish-join(list(nth(s, 0), int_to_str(nth(s, 1)), int_to_str(nth(s, 2)), int_to_str(nth(s, 3)), int_to_str(nth(s, 4)), int_to_str(nth(s, 5)), int_to_str(nth(s, 6)), int_to_str(nth(s, 7))), "|");
    def pscish-parse-build-state(text) = {
        let f = pscish-split(text, "|");
        !((Comparable) len(f) == 8) || !((String) nth(f, 0) == pscish-build-state-schema()) ? pscish-build-state(0, 0, 0, 0, 0, 0, 0) : pscish-build-state(str_to_int(nth(f, 1)), str_to_int(nth(f, 2)), str_to_int(nth(f, 3)), str_to_int(nth(f, 4)), str_to_int(nth(f, 5)), str_to_int(nth(f, 6)), str_to_int(nth(f, 7)));
    };
    // A state file a fresh family has not written yet reads as "": fs-read-text answers a file that is
    // not there with no string, and the parsers split what they read.
    def pscish-read-text-or-empty(path) = fs-stat-size(path) >= 0 ? fs-read-text(path) : "";
    def pscish-read-build-state(artifact, family) = pscish-parse-build-state(pscish-read-text-or-empty(pscish-build-state-path(artifact, family)));
    def pscish-write-build-state(artifact, family, state) = fs-write-text(pscish-build-state-path(artifact, family), pscish-render-build-state(state));
    // A family replan replaces its owned per-source artifacts.  Merely
    // overwriting paths still present in the new plan leaves a removed or
    // renamed source as a valid-looking ghost in the physical shard buckets.
    // Bucket directories may remain; only this organ's .psci files are owned.
    // result = removed failures.
    def pscish-clear-entry-files-loop(dir, names, removed, failures) = nil?(names) ? list(removed, failures) : {
        let name = head(names);
        let path = fs-path-join(dir, name);
        !((Comparable) psci-ends-with?(name, ".psci") == 1) ? pscish-clear-entry-files-loop(dir, tail(names), removed, failures) : {
            let _remove = fs-remove-file(path);
            let gone = fs-stat-size(path) < 0 ? 1 : 0;
            pscish-clear-entry-files-loop(dir, tail(names), removed + gone, failures + ((Comparable) gone == 1 ? 0 : 1));
        };
    };
    def pscish-clear-family-buckets-loop(family-root, buckets, removed, failures) = nil?(buckets) ? list(removed, failures) : {
        let dir = fs-path-join(family-root, head(buckets));
        let next = (Comparable) fs-is-dir?(dir) == 1 ? pscish-clear-entry-files-loop(dir, fs-list(dir), removed, failures) : list(removed, failures);
        pscish-clear-family-buckets-loop(family-root, tail(buckets), nth(next, 0), nth(next, 1));
    };
    def pscish-clear-family-artifacts-at(artifact, family) = {
        let family-root = pscish-family-shard-root(artifact, family);
        !((Comparable) fs-is-dir?(family-root) == 1) ? list(0, 0) : pscish-clear-family-buckets-loop(family-root, fs-list(family-root), 0, 0);
    };
    def pscish-count-entry-files-loop(names, count) = nil?(names) ? count : pscish-count-entry-files-loop(tail(names), count + ((Comparable) psci-ends-with?(head(names), ".psci") == 1 ? 1 : 0));
    def pscish-count-family-buckets-loop(family-root, buckets, count) = nil?(buckets) ? count : {
        let dir = fs-path-join(family-root, head(buckets));
        let next = (Comparable) fs-is-dir?(dir) == 1 ? pscish-count-entry-files-loop(fs-list(dir), count) : count;
        pscish-count-family-buckets-loop(family-root, tail(buckets), next);
    };
    def pscish-entry-artifact-count-at(artifact, family) = {
        let family-root = pscish-family-shard-root(artifact, family);
        !((Comparable) fs-is-dir?(family-root) == 1) ? 0 : pscish-count-family-buckets-loop(family-root, fs-list(family-root), 0);
    };
    def pscish-init-family-at(root, artifact, family) = {
        let f = psci-find-family(family, psci-families());
        !((Comparable) len(f) == 2) ? 0 : {
            let _a = fs-mkdir(artifact);
            let _s = fs-mkdir(pscish-shards-root(artifact));
            let _f = fs-mkdir(pscish-family-shard-root(artifact, family));
            let cleared = pscish-clear-family-artifacts-at(artifact, family);
            let plan = pscish-plan-path(artifact, family);
            let _empty = fs-write-text(plan, "");
            let relative = psci-family-root(f);
            let full = fs-path-join(root, relative);
            let planned = pscish-plan-dir-loop(root, relative, fs-list(full), family, plan, 0);
            let state = pscish-build-state(0, planned, 0, 0, nth(cleared, 1), 0, (Comparable) planned == 0 ? 1 : 0);
            let _bs = pscish-write-build-state(artifact, family, state);
            let _vs = pscish-write-validate-state(artifact, family, pscish-validate-state(0, 0, 0, 0, 0, 0, 0));
            planned;
        };
    };
    // plan step = (status encoded-line next-cursor), status 1 row, 0 EOF,
    // -1 malformed/over-budget line.
    def pscish-plan-step(plan, cursor) = {
        let size = fs-stat-size(plan);
        size < 0 || cursor >= size ? list(0, "", cursor) : {
            let window = fs-read-slice(plan, cursor, pscish-plan-window());
            let at = str_find(window, "\n", 0);
            at < 0 ? list(-1, "", size) : list(1, substring(window, 0, at), cursor + (at + 1));
        };
    };
    def pscish-plan-decode-path(encoded) = pscish-hex-string(encoded);
    // upsert result = (ok collision).  A path-hash collision never overwrites
    // the other coordinate; it remains visible for the live ambiguity count.
    def pscish-upsert-source-at(root, artifact, family, path) = (Comparable) psci-path-valid-for-family?(path, family) == 0 ? list(0, 0) : {
        let size = fs-stat-size(fs-path-join(root, path));
        size < 0 || (Comparable) pscish-source-over-budget?(size) == 1 ? list(0, 0) : {
            let keys = pscish-derived-keys-at(root, family, path);
            let entry = psci-register-at(root, family, path, keys);
            nothing?(entry) ? list(0, 0) : {
                let _dirs = pscish-ensure-artifact-dirs(artifact, family, path);
                let target = pscish-entry-artifact-path(artifact, family, path);
                let existing = fs-stat-size(target) >= 0 ? pscish-parse-entry(fs-read-text(target)) : empty();
                len(existing) > 0 && !((String) pscish-record-path(existing) == path) ? list(0, 1) : fs-write-text(target, pscish-render-entry(entry)) > 0 ? list(1, 0) : list(0, 0);
            };
        };
    };
    def pscish-build-batch-loop(root, artifact, family, plan, cursor, planned, indexed, over-budget, failures, collisions, fuel) = fuel <= 0 ? pscish-build-state(cursor, planned, indexed, over-budget, failures, collisions, cursor >= fs-stat-size(plan) ? 1 : 0) : {
        let step = pscish-plan-step(plan, cursor);
        (Comparable) nth(step, 0) == 0 ? pscish-build-state(cursor, planned, indexed, over-budget, failures, collisions, 1) : nth(step, 0) < 0 ? pscish-build-state(nth(step, 2), planned, indexed, over-budget, failures + 1, collisions, 1) : {
            let path = pscish-plan-decode-path(nth(step, 1));
            let next = nth(step, 2);
            (Comparable) psci-path-valid-for-family?(path, family) == 0 ? pscish-build-batch-loop(root, artifact, family, plan, next, planned, indexed, over-budget, failures + 1, collisions, fuel - 1) : {
                let size = fs-stat-size(fs-path-join(root, path));
                (Comparable) pscish-source-over-budget?(size) == 1 ? pscish-build-batch-loop(root, artifact, family, plan, next, planned, indexed, over-budget + 1, failures, collisions, fuel - 1) : {
                    let outcome = pscish-upsert-source-at(root, artifact, family, path);
                    pscish-build-batch-loop(root, artifact, family, plan, next, planned, indexed + nth(outcome, 0), over-budget, failures + ((Comparable) nth(outcome, 0) == 0 && (Comparable) nth(outcome, 1) == 0 ? 1 : 0), collisions + nth(outcome, 1), fuel - 1);
                };
            };
        };
    };
    def pscish-build-batch-at(root, artifact, family, fuel) = {
        let plan = pscish-plan-path(artifact, family);
        let old = pscish-read-build-state(artifact, family);
        let next = pscish-build-batch-loop(root, artifact, family, plan, nth(old, 1), nth(old, 2), nth(old, 3), nth(old, 4), nth(old, 5), nth(old, 6), fuel);
        let _write = pscish-write-build-state(artifact, family, next);
        next;
    };
    // ---- streamed current-content validation -----------------------------
    def pscish-validate-state(cursor, checked, current, stale, missing, invalid, done) = list(pscish-validate-state-schema(), cursor, checked, current, stale, missing, invalid, done);
    def pscish-render-validate-state(s) = pscish-join(list(nth(s, 0), int_to_str(nth(s, 1)), int_to_str(nth(s, 2)), int_to_str(nth(s, 3)), int_to_str(nth(s, 4)), int_to_str(nth(s, 5)), int_to_str(nth(s, 6)), int_to_str(nth(s, 7))), "|");
    def pscish-parse-validate-state(text) = {
        let f = pscish-split(text, "|");
        !((Comparable) len(f) == 8) || !((String) nth(f, 0) == pscish-validate-state-schema()) ? pscish-validate-state(0, 0, 0, 0, 0, 0, 0) : pscish-validate-state(str_to_int(nth(f, 1)), str_to_int(nth(f, 2)), str_to_int(nth(f, 3)), str_to_int(nth(f, 4)), str_to_int(nth(f, 5)), str_to_int(nth(f, 6)), str_to_int(nth(f, 7)));
    };
    def pscish-read-validate-state(artifact, family) = pscish-parse-validate-state(pscish-read-text-or-empty(pscish-validate-state-path(artifact, family)));
    def pscish-write-validate-state(artifact, family, state) = fs-write-text(pscish-validate-state-path(artifact, family), pscish-render-validate-state(state));
    def pscish-reset-validation-at(artifact, family) = pscish-write-validate-state(artifact, family, pscish-validate-state(0, 0, 0, 0, 0, 0, 0));
    // row validation = current/stale/missing/invalid flags.
    def pscish-validate-source-at(root, artifact, family, path) = {
        let target = pscish-entry-artifact-path(artifact, family, path);
        fs-stat-size(target) < 0 ? list(0, 0, 1, 0) : {
            let record = pscish-parse-entry(fs-read-text(target));
            (Comparable) len(record) == 0 ? list(0, 0, 0, 1) : !((String) pscish-record-path(record) == path) ? list(0, 0, 0, 1) : {
                let full = fs-path-join(root, path);
                let size = fs-stat-size(full);
                size < 0 ? list(0, 1, 0, 0) : {
                    let current = psci-source-node(family, path, fkss-source-id(full), size);
                    node_eq(current, pscish-record-source(record)) ? list(1, 0, 0, 0) : list(0, 1, 0, 0);
                };
            };
        };
    };
    def pscish-validate-batch-loop(root, artifact, family, plan, cursor, checked, current, stale, missing, invalid, fuel) = fuel <= 0 ? pscish-validate-state(cursor, checked, current, stale, missing, invalid, cursor >= fs-stat-size(plan) ? 1 : 0) : {
        let step = pscish-plan-step(plan, cursor);
        (Comparable) nth(step, 0) == 0 ? pscish-validate-state(cursor, checked, current, stale, missing, invalid, 1) : nth(step, 0) < 0 ? pscish-validate-state(nth(step, 2), checked, current, stale, missing, invalid + 1, 1) : {
            let path = pscish-plan-decode-path(nth(step, 1));
            let next = nth(step, 2);
            let size = fs-stat-size(fs-path-join(root, path));
            // Over-budget sources remain in the denominator but are
            // not expected to have an artifact in this first breath.
            (Comparable) pscish-source-over-budget?(size) == 1 ? pscish-validate-batch-loop(root, artifact, family, plan, next, checked, current, stale, missing, invalid, fuel - 1) : {
                let v = pscish-validate-source-at(root, artifact, family, path);
                pscish-validate-batch-loop(root, artifact, family, plan, next, checked + 1, current + nth(v, 0), stale + nth(v, 1), missing + nth(v, 2), invalid + nth(v, 3), fuel - 1);
            };
        };
    };
    def pscish-validate-batch-at(root, artifact, family, fuel) = {
        let plan = pscish-plan-path(artifact, family);
        let old = pscish-read-validate-state(artifact, family);
        let next = pscish-validate-batch-loop(root, artifact, family, plan, nth(old, 1), nth(old, 2), nth(old, 3), nth(old, 4), nth(old, 5), nth(old, 6), fuel);
        let _write = pscish-write-validate-state(artifact, family, next);
        next;
    };
    // ---- exact lookup over entry artifacts, no source path input ----------
    // lookup accumulator = (distinct-match-count record)
    def pscish-lookup-record-acc(record, key, acc) = (Comparable) len(record) == 0 || (Comparable) pscish-key-member?(key, pscish-record-keys(record)) == 0 ? acc : (Comparable) nth(acc, 0) == 0 ? list(1, record) : (String) pscish-record-path(record) == pscish-record-path(nth(acc, 1)) ? acc : list(nth(acc, 0) + 1, nth(acc, 1));
    def pscish-lookup-files-loop(dir, names, key, acc) = nil?(names) ? acc : {
        let name = head(names);
        let path = fs-path-join(dir, name);
        let record = (Comparable) psci-ends-with?(name, ".psci") == 1 ? pscish-parse-entry(fs-read-text(path)) : empty();
        pscish-lookup-files-loop(dir, tail(names), key, pscish-lookup-record-acc(record, key, acc));
    };
    def pscish-lookup-buckets-loop(family-root, buckets, key, acc) = nil?(buckets) ? acc : {
        let dir = fs-path-join(family-root, head(buckets));
        let next = pscish-lookup-files-loop(dir, fs-list(dir), key, acc);
        pscish-lookup-buckets-loop(family-root, tail(buckets), key, next);
    };
    def pscish-lookup-family-acc(artifact, family, key, acc) = {
        let root = pscish-family-shard-root(artifact, family);
        pscish-lookup-buckets-loop(root, fs-list(root), key, acc);
    };
    def pscish-lookup-families-loop(artifact, families, key, acc) = nil?(families) ? acc : pscish-lookup-families-loop(artifact, tail(families), key, pscish-lookup-family-acc(artifact, psci-family-id(head(families)), key, acc));
    // result = (schema status reason key family path source-id fresh rebuild
    //           match-count source-node entry-node model-executed)
    def pscish-lookup-at(root, artifact, key) = (Comparable) psci-concept-key-valid?(key) == 0 ? list(pscish-schema(), "nothing", "invalid-concept-key", "", "", "", "", 0, 0, 0, psci-absent-node(), psci-absent-node(), 0) : {
        let acc = pscish-lookup-families-loop(artifact, psci-families(), key, list(0, empty()));
        (Comparable) nth(acc, 0) == 0 ? list(pscish-schema(), "nothing", "concept-not-registered", key, "", "", "", 0, 0, 0, psci-absent-node(), psci-absent-node(), 0) : nth(acc, 0) > 1 ? list(pscish-schema(), "nothing", "ambiguous-concept-key", key, "", "", "", 0, 0, nth(acc, 0), psci-absent-node(), psci-absent-node(), 0) : {
            let record = nth(acc, 1);
            let v = pscish-validate-source-at(root, artifact, pscish-record-family(record), pscish-record-path(record));
            (Comparable) nth(v, 0) == 1 ? list(pscish-schema(), "hit", "current-content-addressed-source", key, pscish-record-family(record), pscish-record-path(record), pscish-record-source-id(record), 1, 0, 1, pscish-record-source(record), pscish-record-entry(record), 0) : list(pscish-schema(), "nothing", "source-rebuild-needed", key, pscish-record-family(record), pscish-record-path(record), pscish-record-source-id(record), 0, 1, 1, pscish-record-source(record), pscish-record-entry(record), 0);
        };
    };
    def pscish-lookup-status(r) = nth(r, 1);
    def pscish-lookup-reason(r) = nth(r, 2);
    def pscish-lookup-family(r) = nth(r, 4);
    def pscish-lookup-path(r) = nth(r, 5);
    def pscish-lookup-fresh?(r) = nth(r, 7);
    def pscish-lookup-rebuild?(r) = nth(r, 8);
    def pscish-lookup-match-count(r) = nth(r, 9);
    // ---- request and worker protocol ------------------------------------
    // request = action|root-hex|artifact-hex|family
    def pscish-render-request(action, root, artifact, family) = pscish-join(list(action, pscish-string-hex(root), pscish-string-hex(artifact), family), "|");
    def pscish-parse-request(text) = {
        let f = pscish-split(text, "|");
        !((Comparable) len(f) == 4) ? empty() : {
            let action = nth(f, 0);
            let root = pscish-hex-string(nth(f, 1));
            let artifact = pscish-hex-string(nth(f, 2));
            let family = nth(f, 3);
            (Comparable) str_len(root) == 0 || ((Comparable) str_len(artifact) == 0 || (Comparable) psci-family-valid?(family) == 0) ? empty() : list(action, root, artifact, family);
        };
    };
    def pscish-write-request-at(control-dir, action, root, artifact, family) = {
        let _dir = fs-mkdir(control-dir);
        fs-write-text(pscish-request-path-at(control-dir), pscish-render-request(action, root, artifact, family));
    };
    def pscish-write-request(action, root, artifact, family) = pscish-write-request-at(fs-temp-dir(), action, root, artifact, family);
    // ---- live coverage from persisted states + fresh census --------------
    // family row = (schema family denominator planned indexed current
    //               over-budget failures collisions stale missing invalid
    //               percent plan-current rebuild-needed)
    def pscish-family-report-at(root, artifact, family) = {
        let b = pscish-read-build-state(artifact, family);
        let v = pscish-read-validate-state(artifact, family);
        let denominator = psci-count-repository-family-at(root, family);
        let current = nth(v, 3);
        let plan-current = (Comparable) denominator == nth(b, 2) ? 1 : 0;
        let rebuild = (Comparable) plan-current == 1 && ((Comparable) nth(b, 5) == 0 && ((Comparable) nth(b, 6) == 0 && ((Comparable) nth(v, 4) == 0 && ((Comparable) nth(v, 5) == 0 && (Comparable) nth(v, 6) == 0)))) ? 0 : 1;
        list("public-source-shard-family-report-v1", family, denominator, nth(b, 2), nth(b, 3), current, nth(b, 4), nth(b, 5), nth(b, 6), nth(v, 4), nth(v, 5), nth(v, 6), psci-percent(current, denominator), plan-current, rebuild);
    };
    def pscish-family-reports-at(root, artifact, families) = nil?(families) ? empty() : cons(pscish-family-report-at(root, artifact, psci-family-id(head(families))), pscish-family-reports-at(root, artifact, tail(families)));
    def pscish-report-sum(rows, at) = nil?(rows) ? 0 : nth(head(rows), at) + pscish-report-sum(tail(rows), at);
    def pscish-report-all(rows, at, expected) = nil?(rows) ? 1 : (Comparable) nth(head(rows), at) == expected ? pscish-report-all(tail(rows), at, expected) : 0;
    // report = (schema denominator planned indexed current over-budget
    //           failures unique-coordinate-ambiguities stale missing invalid
    //           retrieval-percent threshold95 plan-current rebuild-needed
    //           model-executed family-rows)
    def pscish-report-at(root, artifact) = {
        let rows = pscish-family-reports-at(root, artifact, psci-families());
        let denominator = pscish-report-sum(rows, 2);
        let planned = pscish-report-sum(rows, 3);
        let indexed = pscish-report-sum(rows, 4);
        let current = pscish-report-sum(rows, 5);
        let over-budget = pscish-report-sum(rows, 6);
        let failures = pscish-report-sum(rows, 7);
        let collisions = pscish-report-sum(rows, 8);
        let stale = pscish-report-sum(rows, 9);
        let missing = pscish-report-sum(rows, 10);
        let invalid = pscish-report-sum(rows, 11);
        let percent = psci-percent(current, denominator);
        let plan-current = pscish-report-all(rows, 13, 1);
        let rebuild = (Comparable) plan-current == 1 && ((Comparable) failures == 0 && ((Comparable) collisions == 0 && ((Comparable) stale == 0 && ((Comparable) missing == 0 && (Comparable) invalid == 0)))) ? 0 : 1;
        list("public-source-concept-shard-report-v1", denominator, planned, indexed, current, over-budget, failures, collisions, stale, missing, invalid, percent, percent >= 95 && (Comparable) rebuild == 0 ? 1 : 0, plan-current, rebuild, 0, rows);
    };
    def pscish-report-denominator(r) = nth(r, 1);
    def pscish-report-planned(r) = nth(r, 2);
    def pscish-report-indexed(r) = nth(r, 3);
    def pscish-report-current(r) = nth(r, 4);
    def pscish-report-over-budget(r) = nth(r, 5);
    def pscish-report-failures(r) = nth(r, 6);
    def pscish-report-ambiguities(r) = nth(r, 7);
    def pscish-report-stale(r) = nth(r, 8);
    def pscish-report-missing(r) = nth(r, 9);
    def pscish-report-invalid(r) = nth(r, 10);
    def pscish-report-retrieval-percent(r) = nth(r, 11);
    def pscish-report-threshold95?(r) = nth(r, 12);
    def pscish-report-plan-current?(r) = nth(r, 13);
    def pscish-report-rebuild-needed?(r) = nth(r, 14);
    def pscish-report-model-executed?(r) = nth(r, 15);
    def pscish-report-family-rows(r) = nth(r, 16);
    0;
}
