//////////////////////////////////////////////////////////////////////
// voice-say.bml — the body's own speaking voice, on this Mac's metal.
//
// macOS carries 186 voices and not one of them speaks Persian, and the
// ones it does carry are the old formant kind. So the body keeps its own:
// neural voices that run here, one per tongue, under ~/.local/share/piper-voices
// (the open VITS models, read straight off their files).
//
// The ear detects a tongue and the tongue lane renders 32 of them. This
// map holds a mouth for 29 of those 32. Malay, Tagalog and Tamil have
// no voice model at all — none exists to fetch — so they stay absent
// and say so, rather than being spoken in a mouth that is not theirs.
//
// Each voice was chosen by listening, not by reading a name: the mouth
// spoke one line and the body's own ear (whisper-large-v3-turbo) wrote
// down what it heard. The voice whose line came back whole won its tongue.
// Where a high-quality model existed and was heard whole, it was preferred.
//
// EVERY STEP OF A LINE IS THE BODY'S OWN, AND NO PROCESS STANDS IN THE PATH. Letters to phonemes is
// `voice-g2p.bml`: the tables the body holds (taught lines, taught words, and the words its own T5 model answered,
// put through the learned bridge — `voice-g2p-bridge.bml`). Phonemes to ids is `voice-phoneme.bml`, which reads the
// voice's own `.onnx.json` and builds the exact int64 row. The whole VITS — text encoder, stochastic duration predictor,
// flow and HiFi-GAN vocoder — runs on this Mac's own metal (`voice-pass.bml`, answering the same samples
// onnxruntime answers to six decimals, `tests/voice-pass-band.fk`). The samples turn to signed 16-bit on that
// device and sound through `sense_speaker_play_at`, the twin of the `sense_mic_*` ears, on this Mac's own AudioQueue at
// the voice's OWN rate.
//
// A tongue has a NATIVE mouth when its voice is on disk, the voice reads espeak-style phonemes, and the body holds
// tables for it (`vs-native?`). A tongue with a voice and no native route — the four whose phonemes the body cannot
// produce at all (zh pinyin, ja, th, he), and every tongue the body has no tables for yet — answers "no native mouth
// for X yet". It is never spoken through anything else.
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/line-grammar.fk;
import form/form-stdlib/spool-bell-transport.fk;
import form/form-stdlib/voice-pass.bml;
import form/form-stdlib/voice-g2p.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoiceSay {
        field VSRoot = "/Users/ursmuff/.local/share/piper-voices";
        def vs-cat(xs) = if ((Comparable) len(xs) == 0) then "" else ((String) xs[0] + vs-cat(xs[1:]));
        // the voice each tongue speaks with; a tongue absent here has no mouth yet
        def vs-voices-1() = [["en", "en_GB-cori-high"], ["pt", "pt_BR-cadu-medium"], ["fa", "fa_IR-amir-medium"], ["id", "id_ID-news_tts-medium"], ["de", "de_DE-thorsten-high"], ["fr", "fr_FR-tom-medium"], ["zh", "zh_CN-xiao_ya-medium"], ["es", "es_AR-daniela-high"], ["ru", "ru_RU-ruslan-medium"], ["it", "it_IT-serena-high"]];
        def vs-voices-2() = [["ja", "ja_JA-hi_fi_captain-medium"], ["ko", "ko_KR-kss-medium"], ["ar", "ar_JO-kareem-medium"], ["hi", "hi_IN-rohan-medium"], ["tr", "tr_TR-dfki-medium"], ["nl", "nl_NL-ronnie-medium"], ["pl", "pl_PL-bass-high"], ["ro", "ro_RO-mihai-medium"], ["sv", "sv_SE-lisa-medium"], ["uk", "uk_UA-tetiana-high"]];
        def vs-voices-3() = [["vi", "vi_VN-vais1000-medium"], ["th", "th_TH-tsync2-medium"], ["he", "he_IL-saspeech-medium"], ["el", "el_GR-joy-medium"], ["cs", "cs_CZ-kasandra-medium"], ["hu", "hu_HU-berta-medium"], ["bn", "bn_BD-google-medium"], ["ur", "ur_PK-aegis_female-medium"], ["sw", "sw_CD-lanfrica-medium"]];
        def vs-voices() = append(vs-voices-1(), append(vs-voices-2(), vs-voices-3()));
        def vs-voice-of(rows, code) = if ((Comparable) len(rows) == 0) then "" else if ((String) rows[0][0] == code) then rows[0][1] else vs-voice-of(rows[1:], code);
        def vs-voice(code) = vs-voice-of(vs-voices(), code);
        def vs-model(code) = vs-cat([VSRoot(), "/", vs-voice(code), ".onnx"]);
        def vs-has-voice?(code) = if ((Comparable) len(vs-voice(code)) == 0) then 0 else if (file_size(vs-model(code)) >= 0) then 1 else 0;
        def vs-tongues-with-voice(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-has-voice?(rows[0][0]) == 1) then cons(rows[0][0], vs-tongues-with-voice(rows[1:])) else vs-tongues-with-voice(rows[1:]);
        def vs-tongues() = vs-tongues-with-voice(vs-voices());
        def vs-tongues-text-go(codes) = if ((Comparable) len(codes) == 0) then "" else if ((Comparable) len(codes[1:]) == 0) then codes[0] else vs-cat([codes[0], " ", vs-tongues-text-go(codes[1:])]);
        def vs-tongues-text() = vs-tongues-text-go(vs-tongues());
        def vs-mouth-count() = len(vs-tongues());
        // the mouths the body holds, one to a line: tongue, voice, and whether the model is here
        def vs-mouths-go(rows) = if ((Comparable) len(rows) == 0) then "" else vs-cat([rows[0][0], "  ", rows[0][1], if ((Comparable) vs-has-voice?(rows[0][0]) == 1) then "" else "  (model not on disk)", "\n", vs-mouths-go(rows[1:])]);
        def vs-mouths() = vs-mouths-go(vs-voices());
        // The mouth signs what it says. Nothing the ear writes names a speaker — `kind=said` is the
        // tongue lane's word for its own rendering, not a claim about a voice — so a line the body
        // spoke and then heard is indistinguishable from a line the room spoke, and the perception
        // rows drop both (perception-rows.bml: words travel only behind `who=` and a `src=` naming a
        // mouth of this body). A frame written here, at the moment of speaking, is that signature:
        // the body knowing its own voice, so its own words can reach its own learning.
        def vs-nl() = byte_to_str(10);
        def vs-kv(k, v) = vs-cat([k, "=", v, vs-nl()]);
        def vs-sign(code, text) {
            let frame = vs-cat(["<|ear:frame|>", vs-nl(), vs-kv("t", now_unix_ms().str()), vs-kv("kind", "spoke"), vs-kv("who", "sema"), vs-kv("src", "voice-say"), vs-kv("lang", code), vs-kv("heard", text), vs-kv("line", text), vs-kv("db", "0"), vs-kv("nsp", "0"), "<|/ear:frame|>", vs-nl()]);
            sbt-append(".hearth/ear.spool", frame);
        }

        // ── the native mouth ─────────────────────────────────────────────────────────────
        // A voice whose phonemes are espeak's, and for which the body holds tables, is spoken whole in the body: the id
        // row from the voice's own table, the whole VITS on this Mac's metal, the samples turned to signed 16-bit on the
        // same device, and the air through the seed's own mouth at the voice's OWN rate.
        def vs-has-tables?(code) = if (file_size(vg-path(code, "word")) > 0) then 1 else if (file_size(vg-path(code, "line")) > 0) then 1 else 0;
        def vs-native?(code) = if ((Comparable) vs-has-voice?(code) == 0) then 0 else if ((String) vp-phoneme-type(vp-cfg(vs-voice(code))) != "espeak") then 0 else vs-has-tables?(code);
        // the body's tables, loaded for the tongue, then the chain: taught line, taught words, model-bridged words
        def vs-phonemes-with(ltab, wtab, mtab, text) = vg-phonemes(ltab, wtab, mtab, text);
        def vs-phonemes-home(code, text) = vg-phonemes(vg-load(code, "line"), vg-load(code, "word"), vg-load(code, "model"), text);
        // what the speaking path calls: the body's tables; nothing() is an honest answer when a word is not held
        def vs-phonemes(code, text) = vs-phonemes-home(code, text);
        // why a tongue has no native mouth, in the body's own words
        def vs-no-route(code) = if ((String) vp-phoneme-type(vp-cfg(vs-voice(code))) != "espeak") then vs-cat(["no native mouth for ", code, " yet — its voice reads ", vp-phoneme-type(vp-cfg(vs-voice(code))), " phonemes, which the body cannot produce"]) else vs-cat(["no native mouth for ", code, " yet — the body holds no tables that read its letters to sounds"]);
        // the whole line, rendered and sounded by the body — (played, samples)
        def vs-native-speak(code, text) {
            let cfg = vp-cfg(vs-voice(code));
            let heard = vs-phonemes(code, text);
            let phs = if nothing?(heard) then [] else heard;
            let ids = if ((Comparable) len(phs) == 0) then [] else vp-ids(cfg, phs);
            let st = if ((Comparable) len(ids) == 0) then [] else vv-open(vp-model-path(vs-voice(code)));
            let ok = if ((Comparable) len(st) == 0) then 0 else vv-open-ok?(st);
            let o = if ((Comparable) ok == 1) then vv-render(st, ids, 1.0) else [];
            let pcm = if ((Comparable) ok == 1) then vv-pcm(st, o) else "";
            let played = if ((Comparable) ok == 1) then sense_speaker_play_at(pcm, vp-sample-rate(cfg)) else -1;
            let signed = if (played > 0) then vs-sign(code, text) else 0;
            // Never a bare no. The pass already holds vv-open-why, which names exactly where this
            // export parts from the one the pass was built on — and this line used to throw that
            // away and say "refused", so a voice whose model is present, mapped and 63 MB looked
            // like a wall (corpus rows 1415 heldno, 1416 heardshort). Form native heals and
            // integrates, or releases: the wound is carried with its own name attached.
            if ((Comparable) len(phs) == 0) then vs-cat(["no phonemes for this line in ", code, " yet — a word its tables do not hold (observe/voice-g2p-grow-run.fk grows them)"])
                else if ((Comparable) ok == 0) then vs-cat(["unhealed native voice for ", code, ": ", vv-open-why(st)])
                else if (played < 0) then vs-cat(["rendered natively, but no mouth sounded it (", played.str(), ")"])
                else vs-cat(["spoke in ", code, " natively — ", played.str(), " samples from ", len(ids).str(), " ids"]);
        }
        def vs-say(code, text) = if ((Comparable) vs-has-voice?(code) == 0) then vs-cat(["no mouth for ", code, " yet — the tongues that speak are ", vs-tongues-text()]) else if ((Comparable) len(trim(text)) == 0) then "nothing to say" else if ((Comparable) vs-native?(code) == 1) then vs-native-speak(code, text) else vs-no-route(code);
        // which tongues the body renders itself, and which have a voice and no native route yet
        def vs-native-codes-go(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-native?(rows[0][0]) == 1) then cons(rows[0][0], vs-native-codes-go(rows[1:])) else vs-native-codes-go(rows[1:]);
        def vs-no-route-codes-go(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-has-voice?(rows[0][0]) == 0) then vs-no-route-codes-go(rows[1:]) else if ((Comparable) vs-native?(rows[0][0]) == 1) then vs-no-route-codes-go(rows[1:]) else cons(rows[0][0], vs-no-route-codes-go(rows[1:]));
        def vs-native-codes() = vs-native-codes-go(vs-voices());
        def vs-no-route-codes() = vs-no-route-codes-go(vs-voices());
        def vs-native-count() = len(vs-native-codes());
        // the same line in several tongues, one after the other
        def vs-say-many-go(codes, text, acc) = if ((Comparable) len(codes) == 0) then acc else vs-say-many-go(codes[1:], text, vs-cat([acc, if ((Comparable) len(acc) == 0) then "" else "; ", vs-say(codes[0], text)]));
        def vs-say-many(codes, text) = vs-say-many-go(codes, text, "");
        // "en pt fa id" — a line of tongue codes, spoken in the order written
        def vs-drop-empty(xs) = if ((Comparable) len(xs) == 0) then [] else if ((Comparable) len(trim(xs[0])) == 0) then vs-drop-empty(xs[1:]) else cons(trim(xs[0]), vs-drop-empty(xs[1:]));
        def vs-codes-of(s) = vs-drop-empty(split-on(s, " "));
        def vs-say-tongues(codes, text) = vs-say-many(vs-codes-of(codes), text);
    }
    0;
}
