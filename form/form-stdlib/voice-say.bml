//////////////////////////////////////////////////////////////////////
// voice-say.bml — the body's own speaking voice, on this Mac's metal.
//
// macOS carries 186 voices and not one of them speaks Persian, and the
// ones it does carry are the old formant kind. So the body keeps its own:
// neural voices that run here (piper, ONNX on the CPU), one per tongue,
// under ~/.local/share/piper-voices.
//
// The ear detects a tongue and the tongue lane renders 32 of them. This
// map now holds a mouth for 29 of those 32. Malay, Tagalog and Tamil have
// no piper voice at all — no model exists to fetch — so they stay absent
// and say so, rather than being spoken in a mouth that is not theirs.
//
// Each voice was chosen by listening, not by reading a name: the mouth
// spoke one line and the body's own ear (whisper-large-v3-turbo) wrote
// down what it heard. The voice whose line came back whole won its tongue.
// Where a high-quality model existed and was heard whole, it was preferred.
//
// There used to be TWO crossings, and the second one was the quiet one. The
// rendering left through piper and the SOUNDING left through afplay, so a host
// process stood in the middle of the body's own voice at its very last step:
// the body could hear a room and had no door that made a sound. Since
// 2026-09-08 it has one — `sense_speaker_play_at`, the twin of the `sense_mic_*`
// ears, on this Mac's own AudioQueue — and `vs-play` below reads the wav's own
// chunks, takes the rate off its `fmt ` header rather than assuming the ear's
// 16 kHz (these voices render at 22050), and hands the samples straight to it.
// That crossing is gone. The air is the body's.
//
// The one that is left is named, and since 2026-09-09 it is ONE STEP rather than four.
// Inside piper a line travels four: letters to phonemes, phonemes to ids, ids through
// the VITS graph, spectrogram to samples. Three of them are home. `voice-phoneme.bml`
// reads the voice's own `.onnx.json` and builds the exact int64 row piper builds;
// `voice-onnx.bml` reads the model itself straight off the file with no protobuf
// library; and `voice-pass.bml` runs the whole VITS — text encoder, stochastic duration
// predictor, flow and HiFi-GAN vocoder — on this Mac's own metal, answering the same
// samples onnxruntime answers, to six decimals, on medium voices and high ones alike
// (`tests/voice-pass-band.fk`, 4095).
//
// WHAT STILL CROSSES IS LETTERS TO PHONEMES, and it crosses differently by tongue.
// Twenty-five of these twenty-nine are `phoneme_type: espeak`, and for those the crossing
// is now a phoneme LIST and nothing else — espeak-ng is a rule engine and a dictionary per
// tongue and has no native twin here yet. Four carry their own engine besides (zh pinyin,
// ja, th, he); for those the whole rendering still leaves through piper, because the body
// cannot yet produce their phonemes at all. `vs-native?` answers which is which, and
// `vs-say` takes the native path when it can and the standing crossing when it cannot.
// preludes: form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/spool-bell-transport.fk form/form-stdlib/voice-pass.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormVoiceSay {
        field VSRoot = "/Users/ursmuff/.local/share/piper-voices";
        field VSPiper = "/Users/ursmuff/.mlx-venv/bin/piper";
        def vs-cat(xs) = if ((Comparable) len(xs) == 0) then "" else str_concat(head(xs), vs-cat(tail(xs)));
        // the voice each tongue speaks with; a tongue absent here has no mouth yet
        def vs-voices-1() = [["en", "en_GB-cori-high"], ["pt", "pt_BR-cadu-medium"], ["fa", "fa_IR-amir-medium"], ["id", "id_ID-news_tts-medium"], ["de", "de_DE-thorsten-high"], ["fr", "fr_FR-tom-medium"], ["zh", "zh_CN-xiao_ya-medium"], ["es", "es_AR-daniela-high"], ["ru", "ru_RU-ruslan-medium"], ["it", "it_IT-serena-high"]];
        def vs-voices-2() = [["ja", "ja_JA-hi_fi_captain-medium"], ["ko", "ko_KR-kss-medium"], ["ar", "ar_JO-kareem-medium"], ["hi", "hi_IN-rohan-medium"], ["tr", "tr_TR-dfki-medium"], ["nl", "nl_NL-ronnie-medium"], ["pl", "pl_PL-bass-high"], ["ro", "ro_RO-mihai-medium"], ["sv", "sv_SE-lisa-medium"], ["uk", "uk_UA-tetiana-high"]];
        def vs-voices-3() = [["vi", "vi_VN-vais1000-medium"], ["th", "th_TH-tsync2-medium"], ["he", "he_IL-saspeech-medium"], ["el", "el_GR-joy-medium"], ["cs", "cs_CZ-kasandra-medium"], ["hu", "hu_HU-berta-medium"], ["bn", "bn_BD-google-medium"], ["ur", "ur_PK-aegis_female-medium"], ["sw", "sw_CD-lanfrica-medium"]];
        def vs-voices() = append(vs-voices-1(), append(vs-voices-2(), vs-voices-3()));
        def vs-voice-of(rows, code) = if ((Comparable) len(rows) == 0) then "" else if ((String) head(head(rows)) == code) then head(rows)[1] else vs-voice-of(tail(rows), code);
        def vs-voice(code) = vs-voice-of(vs-voices(), code);
        def vs-model(code) = vs-cat([VSRoot(), "/", vs-voice(code), ".onnx"]);
        def vs-has-voice?(code) = if ((Comparable) str_len(vs-voice(code)) == 0) then 0 else if (file_size(vs-model(code)) >= 0) then 1 else 0;
        def vs-tongues-with-voice(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-has-voice?(head(head(rows))) == 1) then cons(head(head(rows)), vs-tongues-with-voice(tail(rows))) else vs-tongues-with-voice(tail(rows));
        def vs-tongues() = vs-tongues-with-voice(vs-voices());
        def vs-tongues-text-go(codes) = if ((Comparable) len(codes) == 0) then "" else if ((Comparable) len(tail(codes)) == 0) then head(codes) else vs-cat([head(codes), " ", vs-tongues-text-go(tail(codes))]);
        def vs-tongues-text() = vs-tongues-text-go(vs-tongues());
        def vs-mouth-count() = len(vs-tongues());
        // the mouths the body holds, one to a line: tongue, voice, and whether the model is here
        def vs-mouths-go(rows) = if ((Comparable) len(rows) == 0) then "" else vs-cat([head(head(rows)), "  ", head(rows)[1], if ((Comparable) vs-has-voice?(head(head(rows))) == 1) then "" else "  (model not on disk)", "\n", vs-mouths-go(tail(rows))]);
        def vs-mouths() = vs-mouths-go(vs-voices());
        // ONE crossing now, and it is named: the text on piper's stdin, a wav out. The
        // SOUNDING used to be a second crossing on the same line — `afplay "$W"` — and it
        // is gone. The body has its own mouth since 2026-09-08 (sense_speaker_play_at, the
        // twin of the sense_mic_* ears), so what leaves this cell is a rendering, and the
        // air is the seed's own.
        def vs-wav(code) = vs-cat([".hearth/voice-", code, ".wav"]);
        // piper runs with the voice store as its working directory, because the Chinese
        // pinyin lane looks for its lookup tables in ./g2pW and they live beside the voices;
        // the wav still lands in the body's own .hearth, named absolutely before the cd.
        def vs-command(code, text) = vs-cat(["mkdir -p \"$PWD/.hearth\" && W=\"$PWD/", vs-wav(code), "\" && cd ", VSRoot(), " && printf '%s' \"", text, "\" | ", VSPiper(), " -m ", vs-model(code), " -f \"$W\" >/dev/null 2>&1 && echo rendered"]);
        // ── the wav, read by the body and sounded by the body ────────────────────────────
        // The rate is READ, never assumed. These voices render at 22050 Hz, not at the
        // ear's 16 kHz, and a 22050 Hz voice through a 16 kHz queue comes back a fourth
        // low and 1.38x slow — measured on .hearth/voice-en.wav the day this door opened.
        // The chunks are walked rather than counted from 44, so a voice model that one day
        // writes a LIST chunk is still heard instead of being played from the wrong offset.
        def vs-u16(s, i) = (str_byte_at(s, i) + (256 * str_byte_at(s, (i + 1))));
        def vs-u32(s, i) = (vs-u16(s, i) + (65536 * vs-u16(s, (i + 2))));
        def vs-even(n) = if ((Comparable) (n % 2) == 0) then n else (n + 1);
        def vs-chunk(s, i, tag) = if ((i + 8) >= str_len(s)) then -1 else if ((String) substring(s, i, (i + 4)) == tag) then i else vs-chunk(s, ((i + 8) + vs-even(vs-u32(s, (i + 4)))), tag);
        def vs-play(p) = vs-play-h(p, read_file_slice(p, 0, 4096));
        def vs-play-h(p, h) = if (str_len(h) < 44) then -4 else vs-play-at(p, h, vs-chunk(h, 12, "fmt "), vs-chunk(h, 12, "data"));
        // mono 16-bit is what this mouth holds; anything else is named, not played wrong
        def vs-play-at(p, h, f, d) = if ((f < 0) || (d < 0)) then -4 else if (((Comparable) vs-u16(h, (f + 10)) != 1) || ((Comparable) vs-u16(h, (f + 22)) != 16)) then -4 else sense_speaker_play_at(read_file_slice(p, (d + 8), vs-u32(h, (d + 4))), vs-u32(h, (f + 12)));
        // The mouth signs what it says. Nothing the ear writes names a speaker — `kind=said` is the
        // tongue lane's word for its own rendering, not a claim about a voice — so a line the body
        // spoke and then heard is indistinguishable from a line the room spoke, and the perception
        // rows drop both (perception-rows.bml: words travel only behind `who=` and a `src=` naming a
        // mouth of this body). A frame written here, at the moment of speaking, is that signature:
        // the body knowing its own voice, so its own words can reach its own learning.
        def vs-nl() = byte_to_str(10);
        def vs-kv(k, v) = vs-cat([k, "=", v, vs-nl()]);
        def vs-sign(code, text) {
            let frame = vs-cat(["<|ear:frame|>", vs-nl(), vs-kv("t", int_to_str(now_unix_ms())), vs-kv("kind", "spoke"), vs-kv("who", "sema"), vs-kv("src", "voice-say"), vs-kv("lang", code), vs-kv("heard", text), vs-kv("line", text), vs-kv("db", "0"), vs-kv("nsp", "0"), "<|/ear:frame|>", vs-nl()]);
            sbt-append(".hearth/ear.spool", frame);
        }
        // the speaking path proper — reached only once a mouth and a line are both here.
        // Two steps now, and they fail apart: the rendering can refuse (piper, the one
        // crossing left) and the sounding can refuse (the body's own door), and a caller
        // is told which. A line only signs itself once it has actually sounded.
        def vs-speak(code, text) {
            let made = fs-mkdir(".hearth");
            let rendered = host-exec(vs-command(code, text), "");
            let played = if nothing?(rendered) then -1 else vs-play(vs-wav(code));
            let signed = if (played > 0) then vs-sign(code, text) else 0;
            if nothing?(rendered) then "the voice refused"
                else if ((Comparable) played == -4) then "rendered, but that wav is not a shape this mouth holds"
                else if (played < 0) then vs-cat(["rendered, but no mouth sounded it (", int_to_str(played), ")"])
                else vs-cat(["spoke in ", code, " — ", int_to_str(played), " samples"]);
        }

        // ── the native mouth: the crossing shrunk to letters->phonemes ───────────────────
        // The espeak crossing hands back one phoneme a line and nothing else — no wav, no
        // model, no rate, no samples. Everything after it is this seed's: the id row from the
        // voice's own table, the whole VITS on this Mac's metal, the samples turned to signed
        // 16-bit on the same device, and the air through the seed's own mouth at the voice's
        // OWN rate. A tongue whose phonemes the body cannot produce at all takes the standing
        // path instead, and says which it took.
        field VSPy = "/Users/ursmuff/.mlx-venv/bin/python";
        def vs-espeak-code(code) = vp-espeak-voice(vp-cfg(vs-voice(code)));
        def vs-native?(code) = if ((Comparable) vs-has-voice?(code) == 0) then 0 else if ((String) vp-phoneme-type(vp-cfg(vs-voice(code))) == "espeak") then 1 else 0;
        def vs-phon-command(code, text) = vs-cat([VSPy(), " -c \"from piper.phonemize_espeak import EspeakPhonemizer;import sys;[print(ph) for s in EspeakPhonemizer().phonemize(sys.argv[1],sys.argv[2]) for ph in s]\" \"", vs-espeak-code(code), "\" \"", text, "\""]);
        def vs-phonemes(code, text) {
            let out = host-exec(vs-phon-command(code, text), "");
            if nothing?(out) then [] else vp-lines-of(out);
        }
        // the whole line, rendered and sounded by the body — (played, samples)
        def vs-native-speak(code, text) {
            let cfg = vp-cfg(vs-voice(code));
            let phs = vs-phonemes(code, text);
            let ids = if ((Comparable) len(phs) == 0) then [] else vp-ids(cfg, phs);
            let st = if ((Comparable) len(ids) == 0) then [] else vv-open(vp-model-path(vs-voice(code)));
            let ok = if ((Comparable) len(st) == 0) then 0 else vv-open-ok?(st);
            let o = if ((Comparable) ok == 1) then vv-render(st, ids, 1.0) else [];
            let pcm = if ((Comparable) ok == 1) then vv-pcm(st, o) else "";
            let played = if ((Comparable) ok == 1) then sense_speaker_play_at(pcm, vp-sample-rate(cfg)) else -1;
            let signed = if (played > 0) then vs-sign(code, text) else 0;
            // Never a bare no. The pass already holds vv-open-why, which names exactly where this
            // export parts from the one the pass was built on — and this line used to throw that
            // away and say "refused", so a voice whose model is present, mapped and 63 MB looked
            // like a wall (corpus rows 1415 heldno, 1416 heardshort). Form native heals and
            // integrates, or releases: the wound is carried with its own name attached.
            if ((Comparable) len(phs) == 0) then vs-cat(["no phonemes for ", code, " yet — its letters have no walk to sounds here"])
                else if ((Comparable) ok == 0) then vs-cat(["unhealed native voice for ", code, ": ", vv-open-why(st)])
                else if (played < 0) then vs-cat(["rendered natively, but no mouth sounded it (", int_to_str(played), ")"])
                else vs-cat(["spoke in ", code, " natively — ", int_to_str(played), " samples from ", int_to_str(len(ids)), " ids"]);
        }
        def vs-say(code, text) = if ((Comparable) vs-has-voice?(code) == 0) then vs-cat(["no mouth for ", code, " yet — the tongues that speak are ", vs-tongues-text()]) else if ((Comparable) str_len(trim(text)) == 0) then "nothing to say" else if ((Comparable) vs-native?(code) == 1) then vs-native-speak(code, text) else vs-speak(code, text);
        // which tongues the body renders itself, and which still leave whole
        def vs-native-codes-go(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-native?(head(head(rows))) == 1) then cons(head(head(rows)), vs-native-codes-go(tail(rows))) else vs-native-codes-go(tail(rows));
        def vs-crossing-codes-go(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) vs-native?(head(head(rows))) == 1) then vs-crossing-codes-go(tail(rows)) else cons(head(head(rows)), vs-crossing-codes-go(tail(rows)));
        def vs-native-codes() = vs-native-codes-go(vs-voices());
        def vs-crossing-codes() = vs-crossing-codes-go(vs-voices());
        def vs-native-count() = len(vs-native-codes());
        // the same line in several tongues, one after the other
        def vs-say-many-go(codes, text, acc) = if ((Comparable) len(codes) == 0) then acc else vs-say-many-go(tail(codes), text, vs-cat([acc, if ((Comparable) str_len(acc) == 0) then "" else "; ", vs-say(head(codes), text)]));
        def vs-say-many(codes, text) = vs-say-many-go(codes, text, "");
        // "en pt fa id" — a line of tongue codes, spoken in the order written
        def vs-drop-empty(xs) = if ((Comparable) len(xs) == 0) then [] else if ((Comparable) str_len(trim(head(xs))) == 0) then vs-drop-empty(tail(xs)) else cons(trim(head(xs)), vs-drop-empty(tail(xs)));
        def vs-codes-of(s) = vs-drop-empty(split-on(s, " "));
        def vs-say-tongues(codes, text) = vs-say-many(vs-codes-of(codes), text);
    }
    0;
}
