    (defn qfl-latch-path () (ftl-latch-path))
    (defn qfl-control (name tag gloss) (ftl-control name tag gloss))
    (defn qfl-ctl-name (r) (ftl-ctl-name r))
    (defn qfl-ctl-tag (r) (ftl-ctl-tag r))
    (defn qfl-ctl-gloss (r) (ftl-ctl-gloss r))
    (defn qfl-concept (name gloss) (ftl-concept name gloss))
    (defn qfl-name (r) (ftl-name r))
    (defn qfl-gloss (r) (ftl-gloss r))
    (defn qfl-controls () (ftl-controls))
    (defn qfl-concepts () (ftl-concepts))
    (defn qfl-locate (name) (ftl-locate name))
    (defn qfl-has? (name) (ftl-has? name))
    (defn qfl-ctl-locate (name) (ftl-ctl-locate name))
    (defn qfl-system-text () (ftl-system-text))
    (defn qfl-wrapped-prompt (prompt) (ftl-wrapped-prompt prompt))
