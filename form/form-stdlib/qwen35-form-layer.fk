// qwen35-form-layer.fk — compatibility door for the shareable teaching layer.
//
// The teaching meaning lives in form-teach-layer.fk and is not Qwen's. These
// names keep the generate prelude and the 1023 band speaking the first sitting's
// vocabulary while Qwen and DeepSeek live side by side.
//
// preludes: form-stdlib/form-teach-layer.fk
// witnessed: 2026-08-19 -> 1023
section [form.bml] {
    def qfl-latch-path() = ftl-latch-path();
    def qfl-control(name, tag, gloss) = ftl-control(name, tag, gloss);
    def qfl-ctl-name(r) = ftl-ctl-name(r);
    def qfl-ctl-tag(r) = ftl-ctl-tag(r);
    def qfl-ctl-gloss(r) = ftl-ctl-gloss(r);
    def qfl-concept(name, gloss) = ftl-concept(name, gloss);
    def qfl-name(r) = ftl-name(r);
    def qfl-gloss(r) = ftl-gloss(r);
    def qfl-controls() = ftl-controls();
    def qfl-concepts() = ftl-concepts();
    def qfl-locate(name) = ftl-locate(name);
    def qfl-has?(name) = ftl-has?(name);
    def qfl-ctl-locate(name) = ftl-ctl-locate(name);
    def qfl-system-text() = ftl-system-text();
    def qfl-wrapped-prompt(prompt) = ftl-wrapped-prompt(prompt);
    def qfl-on-text?(s) = ftl-on-text?(s);
    def qfl-armed?() = ftl-armed?();
    def qfl-status-text() = ftl-status-text();
    def qfl-cli(arg) = ftl-cli(arg);
    0;
}
