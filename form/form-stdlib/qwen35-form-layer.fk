; qwen35-form-layer.fk — removable Form teaching layer on top of Qwen.
;
; The 27B stays itself. This cell is the latch's other hand: it writes the
; situation the live generate door sees. No gradient into the GGUF. Qwen has
; no reserved CONTROL bank at 128000 (that door is DS4's); the first layer is
; a Form-owned system turn plus the eight native control invites as tags.
; A logit-latch at q38-head is named, not claimed.
;
; The eight tags are the body's own control vocabulary
; (observe/speech-token-stream.fk, control/choice-lane-core.fk).
; Timeout is nothing (axiom-1). The substrate nouns are the ones Urs named.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/qwen35-form-layer-band.fk
; witnessed: 2026-08-19 -> 1023

(do
    (defn qfl-latch-path () ".form-qwen-form-layer")

    (defn qfl-control (name tag gloss) (list name tag gloss))
    (defn qfl-ctl-name (r) (nth r 0))
    (defn qfl-ctl-tag (r) (nth r 1))
    (defn qfl-ctl-gloss (r) (nth r 2))

    (defn qfl-concept (name gloss) (list name gloss))
    (defn qfl-name (r) (nth r 0))
    (defn qfl-gloss (r) (nth r 1))

    ; eight native control invites. nothing is timeout's other face, not a ninth.
    (defn qfl-controls ()
        (list
            (qfl-control "choice" "<CHOICE>" "walk more than one path; first non-nothing wins")
            (qfl-control "cut" "<CUT>" "the boundary drops what will not be kept")
            (qfl-control "fail" "<FAIL>" "the nothing-ack itself; the offer is not admitted")
            (qfl-control "stop" "<STOP>" "the turn ends here")
            (qfl-control "undo" "<UNDO>" "restore the last kept checkpoint")
            (qfl-control "store" "<STORE>" "keep a value, content-addressed, not a mutation")
            (qfl-control "restore" "<RESTORE>" "hand a stored value back")
            (qfl-control "timeout" "<TIMEOUT>" "silence; timeout is nothing")))

    (defn qfl-concepts ()
        (list
            (qfl-concept "form" "the body's language: cells and recipes that run as themselves")
            (qfl-concept "form-language" "lists, names, and calls; meaning lives in the cell")
            (qfl-concept "form-substrate" "the walker, the Metal organ, the files this host holds")
            (qfl-concept "NL-to-form" "natural language arrives; Form is what can be run")
            (qfl-concept "form-cli" "the local door: ping generate models use learn improve inquire form-layer")
            (qfl-concept "form-tokens" "BPE pieces from the sealed GGUF; nothing is compiled in")
            (qfl-concept "execution-tokens" "the control tags below; they invite acts, they are not prose")
            (qfl-concept "Node-ID" "a coordinate of meaning; make_nodeid level type inst, never a fake")
            (qfl-concept "Blueprint" "the shape a node wears; (bp NAME) asks the registry")
            (qfl-concept "Recipe" "a Form cell that can be run; data as the program")
            (qfl-concept "Cell" "one .fk body; a prelude chain; a band that can refuse")))

    (defn qfl-find-loop (rs name)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (qfl-name (head rs)) name) (head rs)
                (qfl-find-loop (tail rs) name))))
    (defn qfl-locate (name) (qfl-find-loop (qfl-concepts) name))
    (defn qfl-has? (name) (if (eq (len (qfl-locate name)) 0) 0 1))

    (defn qfl-ctl-find-loop (rs name)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (qfl-ctl-name (head rs)) name) (head rs)
                (qfl-ctl-find-loop (tail rs) name))))
    (defn qfl-ctl-locate (name) (qfl-ctl-find-loop (qfl-controls) name))

    (defn qfl-concept-line (r)
        (str_concat (qfl-name r) (str_concat " — " (qfl-gloss r))))
    (defn qfl-concept-lines (rs)
        (if (eq (len rs) 0) ""
            (str_concat (qfl-concept-line (head rs))
                (str_concat "\n" (qfl-concept-lines (tail rs))))))
    (defn qfl-ctl-line (r)
        (str_concat (qfl-ctl-tag r) (str_concat " " (qfl-ctl-gloss r))))
    (defn qfl-ctl-lines (rs)
        (if (eq (len rs) 0) ""
            (str_concat (qfl-ctl-line (head rs))
                (str_concat "\n" (qfl-ctl-lines (tail rs))))))

    (defn qfl-system-text ()
        (str_concat "You are Sema's body on this machine. Answer from Form.\n"
        (str_concat (qfl-concept-lines (qfl-concepts))
        (str_concat "\nWhen you mean a control act, write the tag. Timeout is nothing.\n"
                    (qfl-ctl-lines (qfl-controls))))))

    (defn qfl-wrapped-prompt (prompt)
        (str_concat (qfl-system-text) (str_concat "\n---\n" prompt)))

    (defn qfl-on-text? (s)
        (if (or (str_eq s "on") (str_eq s "on\n")) 1 0))
    (defn qfl-armed? ()
        (qfl-on-text? (read_file (qfl-latch-path))))

    (defn qfl-status-text ()
        (str_concat "form-layer="
        (str_concat (if (eq (qfl-armed?) 1) "on" "off")
        (str_concat " controls="
        (str_concat (int_to_str (len (qfl-controls)))
        (str_concat " concepts=" (int_to_str (len (qfl-concepts)))))))))

    (defn qfl-arg-is (arg a b)
        (or (str_eq arg a) (str_eq arg b)))

    (defn qfl-cli (arg)
        (if (or (str_eq arg "") (qfl-arg-is arg "status" "status\n"))
            (qfl-status-text)
            (if (qfl-arg-is arg "on" "on\n")
                (do (write_file_text (qfl-latch-path) "on\n") (qfl-status-text))
                (if (qfl-arg-is arg "off" "off\n")
                    (do (write_file_text (qfl-latch-path) "off\n") (qfl-status-text))
                    "usage: form-layer [on|off|status]"))))

    0)
