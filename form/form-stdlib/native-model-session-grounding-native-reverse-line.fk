; native-model-session-grounding-native-reverse-line.fk -- exact prior-line
; location and read from a sealed local JSONL file, with bounded live progress.
; preludes: form-stdlib/native-model-session-grounding-native-minimize.fk

(do
    (defn nmsgn-reverse-line (line start)
        (list "native-session-reverse-line-v1" line start))
    (defn nmsgn-reverse-line-text (row) (nth row 1))
    (defn nmsgn-reverse-line-start (row) (nth row 2))
    (defn nmsgn-last-newline-loop (text cursor latest)
        (do
            (let found (str_find text "\n" cursor))
            (if (lt found 0) latest
                (nmsgn-last-newline-loop text (add found 1) found))))
    (defn nmsgn-last-newline (text)
        (nmsgn-last-newline-loop text 0 -1))
    (defn nmsgn-trim-reverse-end (path end)
        (if (le end 0) 0
            (do
                (let last (fs-read-slice path (sub end 1) 1))
                (if (or (str_eq last "\n") (str_eq last "\r"))
                    (nmsgn-trim-reverse-end path (sub end 1)) end))))
    (defn nmsgn-reverse-line-start-search
        (path probe-end session-address rows chunks started)
        (if (le probe-end 0) 0
            (do
                ; Most session rows are small.  An 8 KiB backward window keeps
                ; their locator cost proportional while exact long rows chain
                ; as many windows as they need; no row is truncated.
                (let start
                    (if (gt probe-end 8192) (sub probe-end 8192) 0))
                (let chunk (fs-read-slice path start (sub probe-end start)))
                (let newline (nmsgn-last-newline chunk))
                (let progress
                    (if (or (lt newline 0) (gt chunks 0))
                        (nmsgn-pair-row-frame session-address "newline-search"
                            rows start (str_len chunk)
                            (add 40000 (add (mul rows 1000) chunks))
                            started 36)
                        0))
                (if (ge newline 0) (add start (add newline 1))
                    (if (eq start 0) 0
                        (nmsgn-reverse-line-start-search path start
                            session-address rows (add chunks 1) started))))))
    (defn nmsgn-read-previous-line
        (path cursor session-address rows started)
        (do
            (let line-end (nmsgn-trim-reverse-end path cursor))
            (if (le line-end 0) (nmsgn-reverse-line "" 0)
                (do
                    (let line-start
                        (nmsgn-reverse-line-start-search path line-end
                            session-address rows 0 started))
                    (nmsgn-reverse-line
                        (fs-read-slice path line-start (sub line-end line-start))
                        line-start)))))
    0)
