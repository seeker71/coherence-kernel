; form-cli-knowledge-mint-run.fk — mint Form samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-knowledge-mint-xtal.fk

(do
    (let rows (fkm-corpus 3 1))
    (let n (fkm-n 3 1))
    (let models (fqt-fit rows (fkm-controls)))
    (let correct (fqt-heldout-correct-loop models rows))
    (let authored (fqt-heldout-correct))
    (print_str (str_concat "fkm n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fkm unique=" (str_concat (int_to_str (fkm-unique rows)) "\n")))
    (print_str (str_concat "fkm leakage=" (str_concat (int_to_str (fkm-leakage rows)) "\n")))
    (print_str (str_concat "fkm heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fkm heldout-n=" (str_concat (int_to_str (fkm-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fkm authored-heldout-correct=" (str_concat (int_to_str authored) "/6\n")))
    (print_str (str_concat "fkm lora-writer=" (str_concat (int_to_str (fkm-lora-writer)) "\n")))
    (print_str (str_concat "fkm check=" (str_concat (int_to_str (fkm-check)) "\n")))
    (print_str (str_concat "fkm scale-5-2=" (str_concat (int_to_str (fkm-n 5 2)) "\n")))
    0)
