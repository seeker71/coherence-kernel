; form-knowledge-signal-floor-render.fk — the floor table as a computed value.
;
; WHY THIS EXISTS. The finding lived in a comment. form-knowledge-signal-floor.fk
; computes floor, lift and headroom correctly, and then nothing read it: the
; table carrying the actual teaching was prose typed into a band header by hand.
; A number typed into a comment cannot drift back into agreement with the cell
; beneath it, and only a person can read it.
;
; THE SEALED ANSWERS ARE LOOKED UP, NEVER QUOTED. Writing the first draft of this
; cell I copied three expected answers from memory rather than reading them, and
; every one of the three was wrong — invented text that scored a plausible floor
; and rendered a clean table. The table was right about numbers it had been fed
; and the numbers were fiction. So this cell holds NO expected answer. It holds
; row ids, and asks fkh3-find-row for the sealed text. An id that does not exist
; yields nothing rather than a guess, and a sealed answer that is edited upstream
; changes this table on the next run with no hand anywhere.
;
; Quoted here and nowhere else: the banked scores observed 2026-08-26. Those are
; history. Everything else — floor, witness, lift, headroom, evidential? — is
; derived at read time from the sealed answer alone. No model, no carrier, no
; rerun.
;
; preludes: form-stdlib/form-knowledge-signal-floor.fk
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk
;
; Proven by: form-stdlib/tests/form-knowledge-signal-floor-render-band.fk

(do
    ; ── rows: an id and the score banked against it. No answer text. ───────
    (defn fksfr-row (id score) (list id score))
    (defn fksfr-row-id (r)    (nth r 0))
    (defn fksfr-row-score (r) (nth r 1))

    (defn fksfr-rows ()
        (list (fksfr-row "v312" 162162) (fksfr-row "v315"  32787)
              (fksfr-row "v324"      0) (fksfr-row "v323" 285714)
              (fksfr-row "v316" 909091) (fksfr-row "v301"  58824)))
    (defn fksfr-count () (len (fksfr-rows)))

    ; The sealed answer is asked for, never held. A missing id is nothing.
    (defn fksfr-expected (id)
        (do (let r (fkh3-find-row id (fkh3-rows)))
            (if (eq (len r) 0) (nothing) (fkh3-expected r))))

    (defn fksfr-pad (s w)
        (if (ge (str_len s) w) s (fksfr-pad (str_concat s " ") w)))
    (defn fksfr-lpad (s w)
        (if (ge (str_len s) w) s (fksfr-lpad (str_concat " " s) w)))
    (defn fksfr-num (n w) (fksfr-lpad (int_to_str n) w))

    (defn fksfr-line (r)
        (do (let e (fksfr-expected (fksfr-row-id r)))
            (if (nothing? e)
                (str_concat (fksfr-pad (fksfr-row-id r) 6) "  sealed answer not found")
                (do (let rd (fksf-read e (fksfr-row-score r)))
                    (str_concat
                        (str_concat (fksfr-pad (fksfr-row-id r) 6)
                                    (fksfr-num (fksf-read-floor rd) 8))
                        (str_concat
                            (str_concat "  " (fksfr-pad (str_concat "\""
                                (str_concat (fksf-read-witness rd) "\"")) 11))
                            (str_concat (fksfr-num (fksf-read-score rd) 8)
                                (str_concat (fksfr-num (fksf-read-lift rd) 10)
                                    (if (eq (fksf-read-evidential rd) 1)
                                        "   evidence" "   -")))))))))

    (defn fksfr-lines-loop (rs out)
        (if (eq (len rs) 0) out
            (fksfr-lines-loop (tail rs)
                (str_concat out (str_concat (fksfr-line (head rs)) "\n")))))
    (defn fksfr-header ()
        "row   floor      via         score      lift  carries\n")
    (defn fksfr-table ()
        (str_concat (fksfr-header) (fksfr-lines-loop (fksfr-rows) "")))

    ; ── the finding, counted rather than asserted ──────────────────────────
    (defn fksfr-evidential-loop (rs n)
        (if (eq (len rs) 0) n
            (do (let r (head rs))
                (let e (fksfr-expected (fksfr-row-id r)))
                (fksfr-evidential-loop (tail rs)
                    (if (nothing? e) n
                        (add n (fksf-evidential? e (fksfr-row-score r))))))))
    (defn fksfr-evidential-count () (fksfr-evidential-loop (fksfr-rows) 0))
    (defn fksfr-hollow-count () (sub (fksfr-count) (fksfr-evidential-count)))

    0)
