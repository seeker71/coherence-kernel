; form-knowledge-signal-floor-render.fk — readings over observations. The table
; is one projection and not the subject.
;
; WHAT WAS WRONG WITH THE FIRST VERSION OF THIS CELL, kept here because the
; correction is the teaching. It held six rows and six scores as constants and
; rendered them to a padded string. Three faults, each worth naming:
;
;   The six were chosen because a comment had chosen them. Thirty rows are
;   sealed. An arbitrary selection inherited from prose was cast into code.
;
;   The scores were constants, so the next evaluation run would leave this cell
;   quietly wrong — the very staleness the cell was written to cure, moved from
;   the answers to the scores. Same disease, new organ.
;
;   The output was text. A padded string composes with nothing: no gate branches
;   on it, no fold accumulates it, no cell filters it. It is where data stops
;   being able to flow. An instrument whose output type cannot be consumed is
;   unwired BY CONSTRUCTION, and no amount of remembering to wire it will help.
;
; SO THE GRAIN IS THE OBSERVATION. An observation is one row id and one score
; someone measured. A reading is what the floor says about it. Readings fold,
; filter and compose; the table is a projection over readings that a caller may
; take or ignore, and nothing upstream knows it exists.
;
; TOTAL OVER ANY SET. Give it six observations or all thirty or one from a run
; that happens tomorrow. Nothing here names how many there are, and no score
; lives in this file except inside the one clearly dated historical set below.
;
; SEALED ANSWERS ARE LOOKED UP, NEVER HELD. The first draft copied three from
; memory and all three were invented; the floors were plausible and the finding
; was false. A cell that cannot hold an answer cannot invent one, so this one
; holds ids and asks fkh3-find-row. An unsealed id reads as nothing, never as a
; zero, and is absent from a count rather than counted against it.
;
; preludes: form-stdlib/form-knowledge-signal-floor.fk
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk
;
; Proven by: form-stdlib/tests/form-knowledge-signal-floor-render-band.fk

(do
    ; ── an observation: one id, one measured score ─────────────────────────
    (defn fksfr-obs (id score) (list id score))
    (defn fksfr-obs-id (o)    (nth o 0))
    (defn fksfr-obs-score (o) (nth o 1))

    ; The sealed answer is asked for, never held.
    (defn fksfr-expected (id)
        (do (let r (fkh3-find-row id (fkh3-rows)))
            (if (eq (len r) 0) (nothing) (fkh3-expected r))))

    ; ── a reading: the floor's word about one observation ──────────────────
    ; nothing when the id was never sealed — an unmeasurable row is not a
    ; failing row, and folding it into a count would report something untrue.
    (defn fksfr-reading (o)
        (do (let e (fksfr-expected (fksfr-obs-id o)))
            (if (nothing? e) (nothing)
                (list "floor-reading-v1" (fksfr-obs-id o)
                      (fksf-read e (fksfr-obs-score o))))))
    (defn fksfr-reading-id (r)   (nth r 1))
    (defn fksfr-reading-read (r) (nth r 2))

    ; append concatenates two LISTS. A reading IS a list, so (append out r)
    ; splices its three fields in as loose elements and the next fold reads a
    ; string where a reading should be. Preflight cannot see it: the name
    ; resolves and the arity is right. In a body where every value is a list,
    ; append cannot tell "add this element" from "splice this list", and only
    ; the caller's (list r) carries the difference.
    (defn fksfr-readings-loop (os out)
        (if (eq (len os) 0) out
            (do (let r (fksfr-reading (head os)))
                (fksfr-readings-loop (tail os)
                    (if (nothing? r) out (append out (list r)))))))
    (defn fksfr-readings (observations) (fksfr-readings-loop observations (list)))

    ; ── folds over READINGS, never over observations ───────────────────────
    ; A count that takes observations hides a full re-derivation of the sealed
    ; set behind what looks like a fold. Taking readings makes the one
    ; transformation explicit and happen once: readings are the value, and
    ; everything downstream folds, filters or renders THEM.
    (defn fksfr-count-loop (rs want n)
        (if (eq (len rs) 0) n
            (fksfr-count-loop (tail rs) want
                (add n (if (eq (fksf-read-evidential
                                   (fksfr-reading-read (head rs))) want) 1 0)))))
    (defn fksfr-evidential-count (readings) (fksfr-count-loop readings 1 0))
    (defn fksfr-hollow-count (readings)     (fksfr-count-loop readings 0 0))

    ; ── the projection: optional, downstream, knows nothing upstream ───────
    (defn fksfr-pad (s w)
        (if (ge (str_len s) w) s (fksfr-pad (str_concat s " ") w)))
    (defn fksfr-lpad (s w)
        (if (ge (str_len s) w) s (fksfr-lpad (str_concat " " s) w)))
    (defn fksfr-num (n w) (fksfr-lpad (int_to_str n) w))

    (defn fksfr-line (reading)
        (do (let d (fksfr-reading-read reading))
            (str_concat
                (str_concat (fksfr-pad (fksfr-reading-id reading) 6)
                            (fksfr-num (fksf-read-floor d) 8))
                (str_concat
                    (str_concat "  " (fksfr-pad (str_concat "\""
                        (str_concat (fksf-read-witness d) "\"")) 11))
                    (str_concat (fksfr-num (fksf-read-score d) 8)
                        (str_concat (fksfr-num (fksf-read-lift d) 10)
                            (if (eq (fksf-read-evidential d) 1)
                                "   evidence" "   -")))))))

    (defn fksfr-lines-loop (rs out)
        (if (eq (len rs) 0) out
            (fksfr-lines-loop (tail rs)
                (str_concat out (str_concat (fksfr-line (head rs)) "\n")))))
    (defn fksfr-header ()
        "row   floor      via         score      lift  carries\n")
    (defn fksfr-table (readings)
        (str_concat (fksfr-header) (fksfr-lines-loop readings "")))

    ; ── one dated observation set, named as the history it is ──────────────
    ; Quoted, not computed. Six scores observed 2026-08-26. These are not "the
    ; rows" — they are one measurement of six of the thirty that are sealed.
    (defn fksfr-banked-2026-08-26 ()
        (list (fksfr-obs "v312" 162162) (fksfr-obs "v315"  32787)
              (fksfr-obs "v324"      0) (fksfr-obs "v323" 285714)
              (fksfr-obs "v316" 909091) (fksfr-obs "v301"  58824)))

    0)
