; living-world-symbol.fk -- an offered referent may carry an offered surface.
;
; This is data identity only. It contains no vocabulary, language, grammar,
; truth rule, or authority. Direct offers and evidence-derived candidates share
; this exact cell shape so voice can inspect provenance rather than translate
; between parallel symbol models.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk

(let LWNV-SYMBOL (bp "LWNV-SYMBOL"))

; children: referent, optional coordinate cell, exact surface segment,
;           evidence, local path. Spacing and punctuation remain in the offer.
;
; A coordinate is opaque identity, not an imposed axis or numeric order. It may
; be a slot, relation anchor, lens-local address, blueprint, recipe, or any
; other cell participants consent to offer. The legacy numeric constructor is
; retained as one optional lens for already-witnessed position-based voice.
(defn lwnv-symbol-at (referent coordinate surface evidence)
    (intern_node LWNV-SYMBOL
        (list referent coordinate
              (intern_trivial_string surface) evidence
              (lwo-local-path))))
(defn lwnv-symbol (referent position surface evidence)
    (lwnv-symbol-at referent (intern_trivial_int position) surface evidence))
(defn lwnv-symbol? (cell) (lwo-category? cell LWNV-SYMBOL))
(defn lwnv-symbol-referent (symbol) (nth (node_children symbol) 0))
(defn lwnv-symbol-coordinate (symbol) (nth (node_children symbol) 1))
(defn lwnv-symbol-positioned? (symbol)
    (if (and (eq (lwnv-symbol? symbol) 1)
             (and (eq (node_level (lwnv-symbol-coordinate symbol)) 1)
                  (eq (node_type (lwnv-symbol-coordinate symbol)) 1))) 1 0))
(defn lwnv-symbol-position (symbol)
    (node_value (lwnv-symbol-coordinate symbol)))
(defn lwnv-symbol-surface-cell (symbol) (nth (node_children symbol) 2))
(defn lwnv-symbol-surface (symbol)
    (node_value (lwnv-symbol-surface-cell symbol)))
(defn lwnv-symbol-evidence (symbol) (nth (node_children symbol) 3))
(defn lwnv-symbol-path (symbol) (nth (node_children symbol) 4))
(defn lwnv-symbol-valid? (symbol) (lwnv-symbol? symbol))
(defn lwnv-positioned-symbol-valid? (symbol)
    (if (and (eq (lwnv-symbol? symbol) 1)
             (and (eq (lwnv-symbol-positioned? symbol) 1)
                  (ge (lwnv-symbol-position symbol) 0))) 1 0))

0
