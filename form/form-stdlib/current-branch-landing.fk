// current-branch-landing.fk — Form-owned recipe for the current branch land path.
//
// This cell owns the shape: prove, push, PR, wait, API merge, branch cleanup,
// and optional deploy settle. Host git/GitHub/network effects remain explicit
// passthrough carriers until fsh host-effect coverage grows.
section [form.bml] {
    def cbl-cat3(a, b, c) = str_concat(a, str_concat(b, c));
    def cbl-cat4(a, b, c, d) = str_concat(a, str_concat(b, str_concat(c, d)));
    def cbl-cat5(a, b, c, d, e) = str_concat(a, str_concat(b, str_concat(c, str_concat(d, e))));
    def cbl-push-command(branch, upstream) = (String) upstream == str_concat("origin/", branch) ? cbl-cat3("git push --force-with-lease origin HEAD:", branch, "") : cbl-cat3("git push -u origin HEAD:", branch, "");
    def cbl-api-merge-command(repo, pr-number, merge-method) = cbl-cat5("gh api -X PUT repos/", repo, "/pulls/", pr-number, str_concat("/merge -f merge_method=", merge-method));
    def cbl-api-delete-command(repo, branch) = cbl-cat4("gh api -X DELETE repos/", repo, "/git/refs/heads/", branch);
    def cbl-deploy-settle-command(api-url, web-url) = cbl-cat5("bash scripts/settle_public_deploy.sh ", api-url, " ", web-url, "");
    def cbl-entry-command(settle?) = settle? ? "form-cli land --merge --settle-deploy" : "form-cli land --merge";
    def cbl-host-effect-boundary() = "carrier:form-native-plan; host-effects:explicit-git-gh-network-passthrough; retiring-bridge:python-orchestrator";
    def cbl-plan-receipt() = "current-branch-landing:plan-native; proof:four-way-band; effects:host-passthrough; entry:form-cli land";
    def cbl-checks-green?(check-count, failed-count, pending-count, allow-empty?) = failed-count > 0 ? false : pending-count > 0 ? false : check-count > 0 ? true : allow-empty?;
    def cbl-readiness(pr-state, draft?, review-decision, merge-state, check-count, failed-count, pending-count, allow-empty?) = !((String) pr-state == "OPEN") ? "blocked" : draft? ? "blocked" : (String) review-decision == "CHANGES_REQUESTED" ? "blocked" : failed-count > 0 ? "blocked" : (String) merge-state == "DIRTY" || (String) merge-state == "BEHIND" ? "needs_rebase" : (String) merge-state == "CLEAN" && cbl-checks-green?(check-count, failed-count, pending-count, allow-empty?) ? "ready" : "waiting";
    def cbl-readiness-after-push(pr-state, draft?, review-decision, merge-state, check-count, failed-count, pending-count, allow-empty?, refreshing?) = !((String) pr-state == "OPEN") ? "blocked" : draft? ? "blocked" : (String) review-decision == "CHANGES_REQUESTED" ? "blocked" : (String) merge-state == "DIRTY" || (String) merge-state == "BEHIND" ? "needs_rebase" : refreshing? && failed-count > 0 ? "waiting" : cbl-readiness(pr-state, draft?, review-decision, merge-state, check-count, failed-count, pending-count, allow-empty?);
}
