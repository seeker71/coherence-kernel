// selective-ssm.fk — the SELECTIVE state-space step (what makes Mamba *Mamba*).
//
// ssm-scan carried a state with FIXED A/B/C — every input updates the state the same way,
// so it cannot choose what to remember. Mamba's leap is SELECTIVITY: the gate depends on
// the INPUT. A salient input drives a strong state update; a faint input barely registers.
// The model learns to focus on content and skip the rest — input-dependent dynamics, the
// one idea that separates a state-space model from a mere linear recurrence.
//
// Here the gate delta(x) = the input's own salience; the step scales the input's
// contribution by its salience: h' = decay*h + delta(x) * (B*x). A loud token leaves a big
// imprint; a quiet one passes through. Compared head-to-head with the non-selective step,
// the selective state remembers the salient token far more strongly.
//
// All pure; four-way (Go/Rust/TS/fkwu).
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def v-dot(a, b) = (Comparable) len(a) == 0 ? 0.0 : head(a) * head(b) + v-dot(tail(a), tail(b));
    def m-vec(rows, x) = (Comparable) len(rows) == 0 ? list() : cons(v-dot(head(rows), x), m-vec(tail(rows), x));
    def v-add(a, b) = (Comparable) len(a) == 0 ? list() : cons(head(a) + head(b), v-add(tail(a), tail(b)));
    def v-scale(s, v) = (Comparable) len(v) == 0 ? list() : cons(s * head(v), v-scale(s, tail(v)));
    // the GATE: salience of the input (here, its first component — content-dependent)
    def delta(x) = head(x);
    // SELECTIVE step: input scaled by its own salience -> the model selects what to keep
    def sel-next(decay, B, h, x) = v-add(v-scale(decay, h), v-scale(delta(x), m-vec(B, x)));
    // non-selective step (ssm-scan's): every input weighted the same
    def flat-next(decay, B, h, x) = v-add(v-scale(decay, h), m-vec(B, x));
    def sel-final(decay, B, h, xs) = (Comparable) len(xs) == 0 ? h : sel-final(decay, B, sel-next(decay, B, h, head(xs)), tail(xs));
    def flat-final(decay, B, h, xs) = (Comparable) len(xs) == 0 ? h : flat-final(decay, B, flat-next(decay, B, h, head(xs)), tail(xs));
    def sig1(x) = math_floor(x * 1000);
    // ── fixture: a FAINT, a LOUD, a FAINT input. Will the model focus on the loud one? ──
    def ss-B() = list(list(1.0, 0.0), list(0.0, 1.0));
    def ss-h0() = list(0.0, 0.0);
    def ss-xs() = list(list(0.1, 0.0), list(2.0, 0.0), list(0.1, 0.0));
    def ss-decay() = 0.5;
    def ss-faint() = list(0.1, 0.0);
    def ss-loud() = list(2.0, 0.0);
    def ssk(cond, bit) = cond ? bit : 0;
    def ss-gate-content() = ssk(delta(ss-loud()) > delta(ss-faint()), 1);
    def ss-sel-final() = ssk((Comparable) sig1(head(sel-final(ss-decay(), ss-B(), ss-h0(), ss-xs()))) == 2012, 10);
    def ss-flat-final() = ssk((Comparable) sig1(head(flat-final(ss-decay(), ss-B(), ss-h0(), ss-xs()))) == 1125, 100);
    def ss-sel-stronger() = ssk(sig1(head(sel-final(ss-decay(), ss-B(), ss-h0(), ss-xs()))) > sig1(head(flat-final(ss-decay(), ss-B(), ss-h0(), ss-xs()))), 1000);
    def ss-gate-20x() = ssk(sig1(delta(ss-loud())) >= 10 * sig1(delta(ss-faint())), 10000);
    def selective-ssm-check() = ss-gate-content() + ss-sel-final() + ss-flat-final() + ss-sel-stronger() + ss-gate-20x();
}
