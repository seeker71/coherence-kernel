// oracle-distill.fk — learn from an oracle (local or remote teacher) by distillation.
// The student's error to the teacher drops over distillation; a student whose error on UNSEEN input is also low
// learned the MEANING (sovereign), one whose unseen-error stays high only mimicked the seen (a copy). A local
// oracle and a remote oracle are both valid teachers. Honest floor: errors are scalars modeling the real
// distillation; the LOGIC (error-drops, generalizes->sovereign, mimics->copy) is the shape.
// preludes: form-stdlib/core.fk
section [form.bml] {
    def od-kind(d) = head(d);
    def od-before(d) = head(tail(d));
    def od-after(d) = head(tail(tail(d)));
    def od-new(d) = head(tail(tail(tail(d))));
    def od-distills?(d) = od-before(d) > od-after(d) ? 1 : 0;
    def od-sovereign?(d) = 3 > od-new(d) ? 1 : 0;
    def od-oracle-ok?(d) = od-kind(d) > 0 ? 1 : 0;
    def odk(cond, bit) = cond ? bit : 0;
    def oracle-distill-check() = odk((Comparable) od-distills?(list(1, 8, 2, 2)) == 1, 1) + odk((Comparable) od-sovereign?(list(1, 8, 2, 2)) == 1, 10) + odk((Comparable) od-sovereign?(list(1, 8, 2, 9)) == 0, 100) + odk((Comparable) od-oracle-ok?(list(1, 8, 2, 2)) == 1, 1000) + odk((Comparable) od-oracle-ok?(list(2, 8, 2, 2)) == 1, 10000);
}
