//////////////////////////////////////////////////////////////////////
//
// form-cli-knowledge-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-knowledge-mint.bml
//
// Mints Form-native (split, class, situation) rows from body phrases.
// Combinatorial mix is the diversity — unlimited N, no remote oracle.
// Overlay fit reuses the teach-layer centroid. LoRA writer stays 0.
//
// Proven by: form-stdlib/tests/form-cli-knowledge-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
    }

    class FormKnowledgeMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-knowledge-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormKnowledgeMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NControls = 6;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fkm-authority = FormKnowledgeMintAuthority;
        thought fkm-pattern = list("mint", "heldout", "overlay-fit", "lora-waits");
        thought fkm-controls = list("nothing", "cut", "stop", "undo", "timeout", "choice");
        thought fkm-contexts = list("proof", "compiler pass", "form-cli walk", "generate door", "share stamp", "one-turn budget", "Metal organ", "local overlay");

        def fkm-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fkm-nothing-stems() = list("vacant silence is a whole attestation", "absence is complete without a payload", "axiom-1 quiet answers as nothing", "honest vacant finding stays silence");
        def fkm-cut-stems() = list("prune one branch at the checkpoint", "unresolved-call has two opposite repairs", "abandon this path and pivot", "cut the branch and keep walking");
        def fkm-stop-stems() = list("the loop halts on a green band", "stale fkb means rebuild then stop", "walker-ends the turn here", "stop after the generate-pass");
        def fkm-undo-stems() = list("tree-heal restores the prior-cell", "unbalanced-source wants a byte-for-byte restore", "undo the objected edit", "the prior-cell returns exactly");
        def fkm-timeout-stems() = list("observation-window closed without a verdict", "deadline elapsed while still live", "one-turn budget ended incomplete", "allotted-interval closed the wait");
        def fkm-choice-stems() = list("consent-bearing continuations wait", "alternatives need a person to select", "reversible-paths carry different tradeoffs", "a genuine decision-point needs consent");

        def fkm-stems(class) = if str_eq(class, "nothing") then fkm-nothing-stems() else if str_eq(class, "cut") then fkm-cut-stems() else if str_eq(class, "stop") then fkm-stop-stems() else if str_eq(class, "undo") then fkm-undo-stems() else if str_eq(class, "timeout") then fkm-timeout-stems() else fkm-choice-stems();

        def fkm-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fkm-situation(class, i, split) {
            let ctxs = fkm-contexts();
            let stems = fkm-stems(class);
            let ctx = nth(ctxs, fkm-mix(i, len(ctxs)));
            let stem = nth(stems, fkm-mix(i, len(stems)));
            str_concat(fkm-prefix(split), str_concat(ctx, str_concat(" ", str_concat(stem, str_concat(" case ", int_to_str(i))))));
        }

        def fkm-row(class, i, split) = list(split, class, fkm-situation(class, i, split));

        def fkm-class-rows(class, i, n, split, acc) = if eq(i, n) then acc else fkm-class-rows(class, add(i, 1), n, split, cons(fkm-row(class, i, split), acc));

        def fkm-all-classes(names, tn, hn, acc) = if eq(len(names), 0) then acc else fkm-all-classes(tail(names), tn, hn, fkm-class-rows(head(names), 0, hn, SplitHeldout(), fkm-class-rows(head(names), 0, tn, SplitTrain(), acc)));

        def fkm-corpus(tn, hn) = fkm-all-classes(fkm-controls(), tn, hn, tail(list("x")));

        def fkm-n(tn, hn) = mul(NControls(), add(tn, hn));

        def fkm-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fkm-has-situation(tail(rows), s);

        def fkm-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fkm-train-only(tail(rows), cons(head(rows), acc)) else fkm-train-only(tail(rows), acc);

        def fkm-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fkm-has-situation(fkm-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fkm-leakage-loop(all, tail(rows)));

        def fkm-leakage(rows) = fkm-leakage-loop(rows, rows);

        def fkm-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fkm-has-situation(seen, nth(head(rows), 2)), 1) then fkm-unique-loop(tail(rows), seen) else fkm-unique-loop(tail(rows), cons(head(rows), seen));

        def fkm-unique(rows) = fkm-unique-loop(rows, tail(list("x")));

        def fkm-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fkm-count-split(tail(rows), split));

        def fkm-lora-writer() = LoraWriter();

        def fkm-mix-diverse() = if eq(fkm-mix(0, 8), fkm-mix(1, 8)) then 0 else 1;

        def fkm-bit(ok, bit) = if ok then bit else 0;

        def fkm-check() {
            let rows = fkm-corpus(3, 1);
            let n = fkm-n(3, 1);
            let models = fqt-fit(rows, fkm-controls());
            let correct = fqt-heldout-correct-loop(models, rows);
            let c0 = fkm-bit(eq(n, 24), 1);
            let c1 = fkm-bit(eq(fkm-mix-diverse(), 1), 2);
            let c2 = fkm-bit(eq(fkm-leakage(rows), 0), 4);
            let c3 = fkm-bit(eq(fkm-unique(rows), n), 8);
            let c4 = fkm-bit(and(eq(fkm-count-split(rows, SplitTrain()), 18), eq(fkm-count-split(rows, SplitHeldout()), 6)), 16);
            let c5 = fkm-bit(ge(correct, 4), 32);
            let c6 = fkm-bit(eq(fkm-lora-writer(), 0), 64);
            let c7 = fkm-bit(eq(fkm-n(5, 2), 42), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
