// Exact BPE artifact reader. Qwen's vocabulary/merge data belongs to its
// sealed model epoch; Form grammar remains scannerless. The shared native
// reuse owner retains only touched, validated rows until the epoch is released.
// index = status, reason, root, vcount, vcap, vwidth, mcount, lcap, rcap, mwidth, owner
// lookup = status, value, present, probes. IDs zero and one are present values.
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/line-grammar.fk form-stdlib/bml/owned-reuse.bml
section [form.bml] {
 class QwenLiveArtifactReader {
  def qtf2r-bytes-string(bs,acc) = nil?(bs) ? acc : qtf2r-bytes-string(tail(bs),str_concat(acc,byte_to_str(head(bs))));
  def qtf2r-bytes-cmp(a,b) = nil?(a) ? (nil?(b) ? 0 : -1) : nil?(b) ? 1 : head(a) < head(b) ? -1 : head(a) > head(b) ? 1 : qtf2r-bytes-cmp(tail(a),tail(b));
  def qtf2r-nibble(byte) = byte >= 48 && byte <= 57 ? byte - 48 : byte >= 65 && byte <= 70 ? byte - 55 : byte >= 97 && byte <= 102 ? byte - 87 : -1;
  def qtf2r-hex(s,i,n,acc) {
   if (i >= n) then reverse(acc) else if (i + 1 >= n || n > str_len(s)) then nothing() else {
    let hi = qtf2r-nibble(str_byte_at(s,i)); let lo = qtf2r-nibble(str_byte_at(s,i + 1));
    hi < 0 || lo < 0 ? nothing() : qtf2r-hex(s,i + 2,n,cons(hi * 16 + lo,acc));
   };
  }
  def qtf2r-digits(s,i) = i >= str_len(s) ? 1 : str_byte_at(s,i) >= 48 && str_byte_at(s,i) <= 57 ? qtf2r-digits(s,i + 1) : 0;
  def qtf2r-number(s) = str_len(s) > 0 && qtf2r-digits(s,0) ? str_to_int(s) : nothing();
  def qtf2r-none(status,reason,root) = [status,reason,root,0,0,0,0,0,0,0];
  def qtf2r-open(path,liveSeal) {
   let root = str_concat(path,".form-tokfast-v2");
   let manifest = fs-path-join(root,"manifest.row"); let vocab = fs-path-join(root,"vocab.rows"); let merges = fs-path-join(root,"merge.rows");
   if (!fs-exists?(manifest)) then qtf2r-none("absent","manifest-absent",root)
   else if (!fs-exists?(vocab) || !fs-exists?(merges)) then qtf2r-none("absent","row-artifact-absent",root)
   else qtf2r-manifest(root,liveSeal,split-on(fs-read-text(manifest),"|"),vocab,merges);
  }
  def qtf2r-manifest(root,liveSeal,fields,vocab,merges) {
   if (len(fields) != 10) then qtf2r-none("failure","manifest-fields",root) else {
    let raw = fields[9]; let newline = str_len(raw) > 0 && str_byte_at(raw,str_len(raw) - 1) == 10;
    let hex = newline ? substring(raw,0,str_len(raw) - 1) : ""; let bytes = qtf2r-hex(hex,0,str_len(hex),[]);
    let numbers = map(qtf2r-number,take(8,tail(fields)));
    let shaped = newline && !nothing?(bytes) && all?(n => !nothing?(n),numbers);
    if (head(fields) != "QTF2" || !shaped || head(numbers) != len(bytes)) then qtf2r-none("failure","manifest-shape",root)
    else {
     let vc = numbers[1]; let vl = numbers[2]; let vw = numbers[3];
     let mc = numbers[4]; let ml = numbers[5]; let mr = numbers[6]; let mw = numbers[7];
     let index = ["current","seal-and-extents-current",root,vc,vl,vw,mc,ml,mr,mw];
     if (qtf2r-bytes-string(bytes,"") != liveSeal) then ["stale","seal-mismatch",root,vc,vl,vw,mc,ml,mr,mw]
     else if (vw != 21 + 2 * vl || mw != 28 + 2 * (ml + mr)) then ["failure","row-width",root,vc,vl,vw,mc,ml,mr,mw]
     else if (fs-stat-size(vocab) != vc * vw || fs-stat-size(merges) != mc * mw) then ["failure","row-extents",root,vc,vl,vw,mc,ml,mr,mw]
     else append(index,[reuse-open([root,liveSeal],index,qtf2r-row,value => !nothing?(value))]);
    };
   };
  }
  def qtf2r-row(index,key) {
   let vocab = head(key) == "vocab"; let mid = key[1]; let count = index[vocab ? 3 : 6];
   let width = index[vocab ? 5 : 9];
   if (mid < 0 || mid >= count) then nothing() else {
    let row = fs-read-slice(fs-path-join(index[2],vocab ? "vocab.rows" : "merge.rows"),mid * width,width);
    str_len(row) != width ? nothing() : qtf2r-row-value(index,row,vocab,width);
   };
  }
  def qtf2r-row-value(index,row,vocab,width) {
   let ll = qtf2r-number(substring(row,2,8)); let rl = vocab ? 0 : qtf2r-number(substring(row,9,15));
   let value = qtf2r-number(substring(row,vocab ? 9 : 16,vocab ? 19 : 26));
   let lcap = index[vocab ? 4 : 7]; let rcap = vocab ? 0 : index[8];
   let start = vocab ? 20 : 27; let rightStart = start + 2 * lcap;
   if (substring(row,0,2) != (vocab ? "V|" : "M|") || str_byte_at(row,width - 1) != 10 || str_byte_at(row,8) != 124 || str_byte_at(row,vocab ? 19 : 15) != 124 || (!vocab && str_byte_at(row,26) != 124) || nothing?(ll) || nothing?(rl) || nothing?(value) || ll > lcap || rl > rcap) then nothing() else {
    let left = qtf2r-hex(substring(row,start,start + 2 * ll),0,2 * ll,[]);
    let right = vocab ? [] : qtf2r-hex(substring(row,rightStart,rightStart + 2 * rl),0,2 * rl,[]);
    nothing?(left) || nothing?(right) ? nothing() : [left,right,value];
   };
  }
  def qtf2r-release(index) = len(index) > 10 ? reuse-release(index[10]) : 1;
  def qtf2r-find(index,kind,left,right,lo,hi,probes) {
   if (head(index) != "current") then [head(index),nothing(),0,probes]
   else if (lo >= hi) then ["miss",nothing(),0,probes]
   else if (len(index) <= 10 || (kind != "vocab" && kind != "merge")) then ["failure",nothing(),0,probes]
   else {
    let mid = (lo + hi) / 2; let row = reuse-call(index[10],[kind,mid]);
    if nothing?(row) then ["failure",nothing(),0,probes] else {
     let first = qtf2r-bytes-cmp(head(row),left); let cmp = kind == "vocab" || first != 0 ? first : qtf2r-bytes-cmp(row[1],right);
     cmp == 0 ? ["hit",row[2],1,probes + 1] : cmp < 0 ? qtf2r-find(index,kind,left,right,mid + 1,hi,probes + 1) : qtf2r-find(index,kind,left,right,lo,mid,probes + 1);
    };
   };
  }
  def qtf2r-best(index,syms,i,found,pos,rank,probes) {
   if (i + 1 >= len(syms)) then ["ok",pos,rank,found,probes] else {
    let one = qtf2r-find(index,"merge",syms[i],syms[i + 1],0,index[6],0);
    if (head(one) != "hit" && head(one) != "miss") then [head(one),0,0,0,probes + one[3]] else {
     let hit = one[2]; let next = hit ? one[1] : 0; let better = hit && (!found || next < rank);
     qtf2r-best(index,syms,i + 1,hit ? 1 : found,better ? i : pos,better ? next : rank,probes + one[3]);
    };
   };
  }
 }
 0;
}
