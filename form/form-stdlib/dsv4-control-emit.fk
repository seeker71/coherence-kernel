; dsv4-control-emit.fk — the wiring shape: the earned classifier writes the live adapter slot.
;
; The DS4 stack loads a five-line f32 text artifact on every run (metal_dsv4_stack.sh:104,
; overridable by FORM_DS4_CONTROL_ADAPTER) and its own gate has already proven the plumbing:
; each line i, as a bias on token 128000+i, independently selects its control token while every
; non-control logit stays bit-identical ("FIVE CONTROL ROWS SELECTABLE ... plumbing witness
; only, no semantic-training claim", :2230). Five STATIC floats cannot read a situation — so
; the statics are not the classifier; the WRITING is. This cell is the joint: the centroids
; earned leakage-free on 2026-08-18 (fresh_correct=65 vs baseline 30, fresh_leakage=0,
; tests/dsv4-control-fresh-band.fk 31) read the situation and write their verdict into the
; slot just before decode. The stack changes by zero lines.
;
; Line order is the stack's own: line i -> token 128000+i -> (dct-names) order
; NIL CUT FAIL TIMEOUT CHOICE. The strength travels as a STRING so the emitted bytes are
; exact and readable; the plumbing gate showed +1 over the running max selects, so any
; dominating strength (the band uses "50.0") makes the verdict the decoded control token.
;
; What this claims and what it does not: with this joint, TRAINED values chosen by a
; leakage-free fit select the correct control token at the real exit head on held-out
; situations — the trained adapter is live. It is NOT a gradient delta to the base tensors;
; the base model's every non-control logit stays bit-identical, by the stack's own gate.
;
; preludes: form-stdlib/dsv4-control-adapter.fk

(do
    ; the verdict: fit on the standing train rows, predict the situation's class index
    (defn dce-models ()
        (dca-fit (dcc-corpus) (dct-names)))
    (defn dce-verdict-index (s) (dca-predict-index (dce-models) s))

    ; five lines, one-hot at idx carrying the strength string, newline-terminated
    (defn dce-lines-go (i idx strength)
        (if (eq i 5) ""
            (str_concat (if (eq i idx) strength "0.0")
            (str_concat "\n" (dce-lines-go (add i 1) idx strength)))))
    (defn dce-lines (idx strength) (dce-lines-go 0 idx strength))
    (defn dce-zero-lines () (dce-lines 5 "0.0"))

    ; emit: write the verdict for situation s into the artifact at path; answer the index
    (defn dce-emit (path s strength)
        (do (let idx (dce-verdict-index s))
            (let _w (write_file_text path (dce-lines idx strength)))
            idx))
    (defn dce-zero (path) (write_file_text path (dce-zero-lines)))
    0)
