; native-model-session-grounding-native.fk -- direct Form-native orchestrator
; for privacy-minimized real-session grounding.  Discovery, transient reduction,
; report projection, and the call framebuffer are separate cacheable cells.
;
; All observations are diagnostic/non-promotion evidence.  This cell grants no
; training, publication, relationship-memory, promotion, or answer authority.
; preludes: form-stdlib/core.fk form-stdlib/record-src-shim.fk form-stdlib/rag-embed.fk form-stdlib/rag-retrieve.fk form-stdlib/native-model-session-grounding.fk form-stdlib/native-model-evidence-delta.fk observe/live-call-framebuffer.fk form-stdlib/native-model-session-grounding-native-common.fk form-stdlib/native-model-session-grounding-native-candidate.fk form-stdlib/native-model-session-grounding-native-session.fk form-stdlib/native-model-session-grounding-native-discovery.fk form-stdlib/native-model-session-grounding-native-minimize.fk form-stdlib/native-model-session-grounding-native-reverse.fk form-stdlib/native-model-session-grounding-native-report.fk

(do
    ; Only this ranking boundary adapts minimal public candidate cells to the
    ; existing evaluator interface.  Private discovery/minimization therefore
    ; has no embedding or ranking closure.
    (defn nmsgn-evaluator-candidates (rows)
        (if (eq (len rows) 0) (list)
            (cons (nmsg-candidate (nmsgn-candidate-id (head rows))
                                  (nmsgn-candidate-text (head rows)))
                  (nmsgn-evaluator-candidates (tail rows)))))
    (defn nmsgn-run
        (consent-token owner-surface repo-root codex-home index-path state-root
         salt-path file-limit candidate-limit expiry-ms default-kind lens started)
        (if (or (not (str_eq consent-token
                        "diagnostic-observation-consent-v1"))
                (or (lt file-limit 1)
                    (or (lt candidate-limit 2)
                        (or (eq (fs-is-file? index-path) 0)
                            (eq (fs-is-file? salt-path) 0)))))
            (nmsgn-result
                "schema=native-model-session-grounding-refusal-v1\nexecution_success=0\nreason=missing-or-invalid-explicit-consent-or-local-input\n"
                "" "" 0 0 (nmsg-invalid-report 0 "" "") (list))
            (do
                (let phase-discovery-enter
                    (lcfb-call-stream "native-session-grounding"
                        "session-discovery" "enter" "form-native"
                        "root-session-select" "private-metadata-only" 2 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        32 21))
                (let sessions-state
                    (nmsgn-select-sessions codex-home repo-root file-limit
                        (div (now_unix_ms) 1000) started))
                (let sessions (nmsgn-selection-selected sessions-state))
                (let phase-discovery-leave
                    (lcfb-call-stream "native-session-grounding"
                        "session-discovery" "leave" "form-native"
                        "root-session-select" "private-metadata-only" 3 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        42 21))
                (let salt-raw (fs-read-text salt-path))
                (let salt
                    (if (gt (str_find salt-raw "\n" 0) 0)
                        (substring salt-raw 0 (str_find salt-raw "\n" 0))
                        salt-raw))
                (let phase-pairs-enter
                    (lcfb-call-stream "native-session-grounding" "pair-scan"
                        "enter" "form-native" "reverse-latest-completed-pair"
                        "private-language-transient" 4 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        53 21))
                (let raw-pairs
                    (nmsgn-scan-sessions-reverse sessions started))
                (let phase-pairs-leave
                    (lcfb-call-stream "native-session-grounding" "pair-scan"
                        "leave" "form-native" "reverse-latest-completed-pair"
                        "private-language-transient" 5 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        61 21))
                (let phase-index-enter
                    (lcfb-call-stream "native-session-grounding" "index-scan"
                        "enter" "form-native" "bounded-stream-select"
                        "public-valid-count-cited-and-fallback" 6 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        67 21))
                (let index-state
                    (nmsgn-index-scan repo-root index-path
                        (nmsgn-pairs-latest-completion raw-pairs)
                        candidate-limit started))
                (let candidates
                    (nmsgn-cat-lists (nmsgn-index-cited index-state)
                        (nmsgn-index-fallback index-state)))
                (let labels
                    (nmsgn-labels
                        (nmsgn-pairs-latest-completion raw-pairs) candidates))
                (let pairs (nmsgn-pairs-finalize raw-pairs labels salt))
                (let safe-pairs (nmsgn-safe-pairs pairs))
                (let phase-index-leave
                    (lcfb-call-stream "native-session-grounding" "index-scan"
                        "leave" "form-native" "bounded-stream-select"
                        "public-valid-count-cited-and-fallback" 7 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        85 21))
                (let admitted (nmsgn-admit labels candidates candidate-limit))
                (let query-digest (nmsgn-safe-pairs-digest safe-pairs))
                (let candidate-digest
                    (nmsgn-sha256 (nmsgn-cat
                        (list salt "\n" (nmsgn-candidate-message admitted)))))
                (let dataset-digest
                    (nmsgn-sha256 (nmsgn-cat
                        (list salt "\n" (nmsgn-safe-pairs-when safe-pairs) "\n"
                              query-digest "\n" (nmsgn-label-message labels)))))
                (let contract-digest (nmsgn-contract-digest repo-root))
                (let episode
                    (nmsg-episode (nmsgn-safe-pairs-when safe-pairs)
                        (nmsgn-pairs-latest-query pairs) query-digest labels))
                (let phase-replay-enter
                    (lcfb-call-stream "native-session-grounding" "native-replay"
                        "enter" "form-native" "lexical-rank"
                        "four-candidate-local-placement" 8 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        104 21))
                (let observation
                    (nmsg-observe (nmsgn-evaluator-candidates admitted)
                        (list episode)
                        candidate-digest dataset-digest))
                (let scalar (nth observation 0))
                (let result-rows (nth observation 1))
                (let rank (if (eq (len result-rows) 1)
                    (nmsg-result-rank (head result-rows)) 0))
                (let phase-replay-leave
                    (lcfb-call-stream "native-session-grounding" "native-replay"
                        "leave" "form-native" "lexical-rank"
                        "four-candidate-local-placement" 9 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        118 21))
                (let prior-path (nmsgn-prior-path state-root))
                (let prior-text (if (str_eq prior-path "") ""
                    (fs-read-text prior-path)))
                (let prior-candidate
                    (nmsgn-report-value prior-text "candidate_set_sha256"))
                (let prior-dataset
                    (nmsgn-report-value prior-text "dataset_sha256"))
                (let prior-contract
                    (nmsgn-report-value prior-text
                        "evaluation_contract_sha256"))
                (let comparison
                    (nmed-comparison-admissible? candidate-digest dataset-digest
                        contract-digest prior-candidate prior-dataset
                        prior-contract))
                (let evidence-state
                    (nmed-evidence-state candidate-digest dataset-digest
                        contract-digest prior-candidate prior-dataset
                        prior-contract))
                (let candidate-changed
                    (nmed-candidate-changed? candidate-digest prior-candidate))
                (let dataset-changed
                    (nmed-dataset-changed? dataset-digest prior-dataset))
                (let contract-changed
                    (nmed-contract-changed? contract-digest prior-contract))

                ; Owner surface is content-addressed here so the safe handoff
                ; never needs the raw owner label.
                (let owner-digest
                    (nmsgn-sha256
                        (nmsgn-cat (list salt "\n" owner-surface))))
                (let cells 0)
                (let attributions 0)
                (let report-path
                    (fs-path-join state-root
                        (nmsgn-cat (list "session-grounding-form-native-"
                            (int_to_str (now_unix_ms)) ".txt"))))
                (let text
                    (nmsgn-render-report
                        (nmsgn-selection-source-count sessions-state)
                        (len sessions)
                        (nmsgn-count-unchanged-sessions sessions)
                        (nmsgn-count-changed-sessions sessions)
                        (nmsgn-safe-pairs-completed safe-pairs)
                        (nmsgn-safe-pairs-labeled safe-pairs)
                        (nmsgn-index-valid index-state)
                        (len admitted) scalar rank query-digest
                        candidate-digest dataset-digest contract-digest
                        prior-path prior-text comparison evidence-state
                        candidate-changed dataset-changed contract-changed
                        cells attributions (sub (now_unix_ms) started)
                        lens expiry-ms default-kind report-path))
                (let phase-report-enter
                    (lcfb-call-stream "native-session-grounding" "safe-report"
                        "enter" "form-native" "aggregate-write"
                        "privacy-safe-report-only" 10 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        175 21))
                (let written (fs-write-text report-path text))
                (let phase-report-leave
                    (lcfb-call-stream "native-session-grounding" "safe-report"
                        "leave" "form-native" "aggregate-write"
                        "privacy-safe-report-only" 11 started
                        "form/form-stdlib/native-model-session-grounding-native.fk"
                        182 21))
                (nmsgn-result text report-path prior-path cells attributions
                    scalar result-rows))))
    0)
