// form-cli-peer-source-symbol-action.fk -- a caller-owned, retained-index
// source-definition action. It asks where a Form symbol is born without a
// model forward, a tokenizer, a new filesystem read, or a static fn map.
//
// The index is built once by the live caller under its meaning epoch. A query
// is one of value (one birth), choice (plurality, stale index, or malformed
// atom), or nothing (no birth). It never turns a stale snapshot into a silent
// rescan and never routes the question through Qwen as a fallback.
//
// preludes: form-stdlib/form-cli-peer-direct-source-action.fk form-stdlib/source-of.fk
section [form.bml] {
    // result = session, snapshot query, response, elapsed, signal, reason,
    // knowledge contribution. The peer contribution remains zero: a source
    // relation is evidence for later work, not a repository mutation.
    def fcpssa-version() = "form-cli-peer-source-symbol-action-v1";
    def fcpssa-result(session, query, response, elapsed-ms, signal, reason, knowledge-contribution) = list(fcpssa-version(), session, query, response, elapsed-ms, signal, reason, knowledge-contribution);
    def fcpssa-session(r) = nth(r, 1);
    def fcpssa-query(r) = nth(r, 2);
    def fcpssa-response(r) = nth(r, 3);
    def fcpssa-elapsed-ms(r) = nth(r, 4);
    def fcpssa-signal(r) = nth(r, 5);
    def fcpssa-reason(r) = nth(r, 6);
    def fcpssa-knowledge-contribution(r) = nth(r, 7);
    def fcpssa-result?(r) = nothing?(r) ? 0 : !((Comparable) len(r) == 8) ? 0 : (String) nth(r, 0) == fcpssa-version();
    def fcpssa-source-index(source-ctx) = nothing?(source-ctx) || len(source-ctx) < 5 ? nothing() : nth(source-ctx, 4);
    def fcpssa-paths(query) = {
        let raw = sof-query-raw(query);
        nothing?(raw) ? list() : (String) nth(raw, 0) == "one" ? list(nth(raw, 1)) : nth(raw, 1);
    };
    def fcpssa-join-paths(paths) = (Comparable) len(paths) == 0 ? "" : (Comparable) len(tail(paths)) == 0 ? head(paths) : str_concat(head(paths), str_concat(",", fcpssa-join-paths(tail(paths))));
    def fcpssa-render(query) = str_concat("<|form:source-symbol|>\n", str_concat("signal=", str_concat(sof-query-signal(query), str_concat("\nreason=", str_concat(sof-query-reason(query), str_concat("\nsymbol=", str_concat(sof-query-name(query), str_concat("\nrequested-epoch=", str_concat(int_to_str(sof-query-requested-epoch(query)), str_concat("\nsnapshot-epoch=", str_concat(nothing?(sof-query-snapshot-epoch(query)) ? "" : int_to_str(sof-query-snapshot-epoch(query)), str_concat("\nsource-paths=", str_concat(fcpssa-join-paths(fcpssa-paths(query)), "\n<|/form:source-symbol|>")))))))))))));
    def fcpssa-from-query(session, query, elapsed-ms) = fcpssa-result(session, query, fcpssa-render(query), elapsed-ms, sof-query-signal(query), sof-query-reason(query), (String) sof-query-signal(query) == "value" ? 1 : 0);
    def fcpssa-refused(session, reason) = fcpssa-result(session, sof-snapshot-query(nothing(), 0, ""), "", 0, "choice", reason, 0);
    def fcpssa-lookup-count(direct) = {
        let query = fcpssa-query(direct);
        !((Comparable) sof-snapshot-query?(query) == 1) || ((String) sof-query-reason(query) == "source-index-absent" || ((String) sof-query-reason(query) == "source-index-stale" || (String) sof-query-reason(query) == "symbol-shape-refused")) ? 0 : 1;
    };
    def fcpssa-lifecycle(direct) = (String) fcpssa-signal(direct) == "choice" ? "source-index,choice,release" : "source-index,release";
    def fcpssa-peer(direct) = fcpa-result-full(fcpssa-session(direct), direct, fcpssa-response(direct), fcpssa-elapsed-ms(direct), 0, "source-symbol", 0, fcpssa-signal(direct), "form-source-index", 0, nothing(), 0, 0, fcpssa-lifecycle(direct), fcpssa-lookup-count(direct));
    def fcpssa-run(session, task-kind, task-text, source-ctx, expected-epoch) = !((String) task-kind == "source-symbol") ? fcpssa-refused(session, "source-symbol-requires-source-symbol-task") : {
        let started = now_unix_ms();
        let query = sof-snapshot-query(fcpssa-source-index(source-ctx), expected-epoch, task-text);
        fcpssa-from-query(session, query, now_unix_ms() - started);
    };
    def fcpssa-run-peer(stream, session, task-node, source-ctx, expected-epoch) = {
        let task = fcpsi-find-task(fcpsi-tasks(stream), task-node);
        nothing?(task) ? list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) : {
            let direct = fcpssa-run(session, fcpsi-task-kind(task), fcpsi-task-text(task), source-ctx, expected-epoch);
            let peer = fcpssa-peer(direct);
            let candidate = fcpsi-peer-result(stream, task-node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        };
    };
    0;
}
