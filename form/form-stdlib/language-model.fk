// language-model.fk - generic source-language class/template object model.
//
// Template/member values are the focused foundation; this cell extends them
// with classes and KernelHTTP route members.
//
// preludes: form-stdlib/core.fk form-stdlib/language-template.fk form-stdlib/kernel-http.fk
//
// BML, TypeScript, Go, C#, math, sound, and future grammars may all lower into
// these same Form-native language objects. The grammar name belongs at the
// parser/lens boundary; the runtime object model stays language-neutral.
//; The five class tag lets stand at UNIT level, not inside the do: a do-level let
//; is a name a defn frame cannot see on fkwu (the same seam compiler.fk's rule
//; tables and form-bml-cursor-parse's grammar crossed on 2026-08-17). The do
//; reopens after them; values and once-evaluation unchanged.
section [form.bml] {
    let LANGUAGE-CLASS-TAG = 44004;
    let LANGUAGE-CLASS-MEMBER-TAG = 44005;
    let LANGUAGE-CLASS-MEMBER-KIND-FIELD = 44201;
    let LANGUAGE-CLASS-MEMBER-KIND-METHOD = 44202;
    let LANGUAGE-CLASS-MEMBER-KIND-ROUTE = 44203;
    {
        def language-class-member(kind, name, value-type, value) = [LANGUAGE-CLASS-MEMBER-TAG, kind, name, value-type, value];
        def language-class-member-field(name, value-type, value) = language-class-member(LANGUAGE-CLASS-MEMBER-KIND-FIELD, name, value-type, value);
        def language-class-member-method(name, method) = language-class-member(LANGUAGE-CLASS-MEMBER-KIND-METHOD, name, "method", method);
        def language-class-member-route(name, route) = language-class-member(LANGUAGE-CLASS-MEMBER-KIND-ROUTE, name, "KernelHTTPRoute", route);
        def language-class-member?(value) = (Comparable) len(value) == 5 ? (Comparable) value[0] == LANGUAGE-CLASS-MEMBER-TAG : false;
        def language-class-member-kind(member) = member[1];
        def language-class-member-name(member) = member[2];
        def language-class-member-type(member) = member[3];
        def language-class-member-value(member) = member[4];
        def language-class-member-valid?(member) = language-class-member?(member) ? str_len(language-class-member-name(member)) > 0 && str_len(language-class-member-type(member)) > 0 : false;
        def language-class-members-valid?(members) = nil?(members) ? true : language-class-member-valid?(head(members)) && language-class-members-valid?(tail(members));
        def language-class(class-name, template, type-arguments, members) = [LANGUAGE-CLASS-TAG, class-name, template, type-arguments, members];
        def language-class?(value) = (Comparable) len(value) == 5 ? (Comparable) value[0] == LANGUAGE-CLASS-TAG : false;
        def language-class-name(class-value) = class-value[1];
        def language-class-template(class-value) = class-value[2];
        def language-class-type-arguments(class-value) = class-value[3];
        def language-class-members(class-value) = class-value[4];
        def language-class-member-named(members, name) = nil?(members) ? empty() : (String) language-class-member-name(head(members)) == name ? head(members) : language-class-member-named(tail(members), name);
        def language-class-route-member(class-value) = language-class-member-named(language-class-members(class-value), "route");
        def language-class-valid?(class-value) = language-class?(class-value) ? str_len(language-class-name(class-value)) > 0 && (language-template-valid?(language-class-template(class-value)) && ((Comparable) len(language-class-type-arguments(class-value)) == len(language-template-parameters(language-class-template(class-value))) && language-class-members-valid?(language-class-members(class-value)))) : false;
        def language-route-class(class-name, template, type-arguments, route-name, method, pattern, priority, handler, required-header, pressure-budget) = language-class(class-name, template, type-arguments, [language-class-member-route("route", kh-route(route-name, method, pattern, priority, handler, required-header, pressure-budget))]);
        def language-route-class-route-data(class-name, template, type-arguments, route-id, handler) = language-class(class-name, template, type-arguments, [language-class-member-route("route", kh-route-data-ref(route-id, handler))]);
        def language-route-class?(value) = language-class?(value) ? language-class-member?(language-class-route-member(value)) : false;
        def language-route-class-name(route-class) = language-class-name(route-class);
        def language-route-class-template(route-class) = language-class-template(route-class);
        def language-route-class-type-arguments(route-class) = language-class-type-arguments(route-class);
        def language-route-class-kernel-route(route-class) = language-class-member-value(language-class-route-member(route-class));
        def language-route-class-valid?(route-class) = language-route-class?(route-class) ? language-class-valid?(route-class) && ((Comparable) language-class-member-kind(language-class-route-member(route-class)) == LANGUAGE-CLASS-MEMBER-KIND-ROUTE && (kh-route-valid?(language-route-class-kernel-route(route-class)) || kh-route-data-ref-valid?(language-route-class-kernel-route(route-class)))) : false;
        0;
    };
}
