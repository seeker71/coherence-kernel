; living-world-relation-learning.fk -- recurring situated relations may become edges.
;
; No relation vocabulary is built in. Participants offer an exact relation
; cell, two current symbol candidates, an optional lens, an acknowledgement,
; optional alternatives, an optional unknowable remainder, and evidence.
; Source identity remains in active attribution edges rather than payloads.
;
; For one relation and unordered endpoint pair, ONE in the proposed direction
; supports it; ONE in the inverse direction remains an alternative; ZERO is
; dissent; NOTHING is silence; alternative NODEs remain alternatives; other
; NODEs remain unresolved. Optional observation fields are never defaulted.
; Every active attribution in every class governs admission.
;
; A relation proposal requires an offered distinct-support threshold and the
; ordinary unanimous membrane. Endpoint, evidence, or attribution movement
; makes the old candidate stale without erasing it.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk

(let LWRL-OBSERVATION  (bp "LWRL-OBSERVATION"))
(let LWRL-EVIDENCE     (bp "LWRL-EVIDENCE"))
(let LWRL-EVIDENCE-SET (bp "LWRL-EVIDENCE-SET"))
(let LWRL-EDGE         (bp "LWRL-EDGE"))
(let LWRL-ORIGIN       (bp "LWRL-ORIGIN"))

; children: relation, left, right, optional lens, ack, optional alternatives,
;           optional unknown, evidence, local path
(defn lwrl-observation
    (relation left right lens ack alternatives unknown evidence)
    (intern_node LWRL-OBSERVATION
        (list relation left right lens ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwrl-observation? (cell)
    (lwo-category? cell LWRL-OBSERVATION))
(defn lwrl-observation-relation (observation)
    (nth (node_children observation) 0))
(defn lwrl-observation-left (observation)
    (nth (node_children observation) 1))
(defn lwrl-observation-right (observation)
    (nth (node_children observation) 2))
(defn lwrl-observation-lens (observation)
    (nth (node_children observation) 3))
(defn lwrl-observation-ack (observation)
    (nth (node_children observation) 4))
(defn lwrl-observation-alternatives (observation)
    (nth (node_children observation) 5))
(defn lwrl-observation-unknown (observation)
    (nth (node_children observation) 6))
(defn lwrl-observation-evidence (observation)
    (nth (node_children observation) 7))
(defn lwrl-observation-path (observation)
    (nth (node_children observation) 8))

(defn lwrl-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwrl-observation-valid? (observation)
    (if (and (eq (lwrl-observation? observation) 1)
             (and (not (node_eq
                         (lwrl-observation-left observation)
                         (lwrl-observation-right observation)))
                  (and (eq (oac-valid-ack?
                             (lwrl-observation-ack observation)) 1)
                       (and (eq (lwo-category?
                                  (lwrl-observation-alternatives observation)
                                  LWO-FIELD) 1)
                            (eq (lwrl-optional-unknown-valid?
                                  (lwrl-observation-unknown observation))
                                1))))) 1 0))

(defn lwrl-exact-direction? (observation relation left right)
    (if (and (node_eq (lwrl-observation-relation observation) relation)
             (and (node_eq (lwrl-observation-left observation) left)
                  (node_eq (lwrl-observation-right observation) right))) 1 0))
(defn lwrl-inverse-direction? (observation relation left right)
    (if (and (node_eq (lwrl-observation-relation observation) relation)
             (and (node_eq (lwrl-observation-left observation) right)
                  (node_eq (lwrl-observation-right observation) left))) 1 0))
(defn lwrl-same-pair? (observation relation left right)
    (if (or (eq (lwrl-exact-direction?
                   observation relation left right) 1)
            (eq (lwrl-inverse-direction?
                   observation relation left right) 1)) 1 0))

; children: observation and all current attribution witnesses for it
(defn lwrl-evidence (observation attributions)
    (intern_node LWRL-EVIDENCE (list observation attributions)))
(defn lwrl-evidence-observation (evidence)
    (nth (node_children evidence) 0))
(defn lwrl-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

; children: supports, alternatives, dissents, silences, unresolved
(defn lwrl-evidence-set (supports alternatives dissents silences unresolved)
    (intern_node LWRL-EVIDENCE-SET
        (list supports alternatives dissents silences unresolved)))
(defn lwrl-evidence-set? (cell)
    (lwo-category? cell LWRL-EVIDENCE-SET))
(defn lwrl-evidence-supports (set) (nth (node_children set) 0))
(defn lwrl-evidence-alternatives (set) (nth (node_children set) 1))
(defn lwrl-evidence-dissents (set) (nth (node_children set) 2))
(defn lwrl-evidence-silences (set) (nth (node_children set) 3))
(defn lwrl-evidence-unresolved (set) (nth (node_children set) 4))

(defn lwrl-classify-evidence
    (observation evidence relation left right
     supports alternatives dissents silences unresolved)
    (do
        (let ack (lwrl-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (eq (lwrl-exact-direction?
                       observation relation left right) 1)
                (lwrl-evidence-set (lwo-field-add supports evidence)
                    alternatives dissents silences unresolved)
                (lwrl-evidence-set supports
                    (lwo-field-add alternatives evidence)
                    dissents silences unresolved))
            (if (eq (oac-zero? ack) 1)
                (lwrl-evidence-set supports alternatives
                    (lwo-field-add dissents evidence) silences unresolved)
                (if (eq (oac-nothing? ack) 1)
                    (lwrl-evidence-set supports alternatives dissents
                        (lwo-field-add silences evidence) unresolved)
                    (if (and (eq (oac-node? ack) 1)
                             (eq (oac-alternative?
                                   (oac-payload ack)) 1))
                        (lwrl-evidence-set supports
                            (lwo-field-add alternatives evidence)
                            dissents silences unresolved)
                        (lwrl-evidence-set supports alternatives dissents
                            silences (lwo-field-add unresolved evidence))))))))

(defn lwrl-collect-items
    (world items relation left right
     supports alternatives dissents silences unresolved)
    (if (eq (len items) 0)
        (lwrl-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            ; Form evaluates call arguments eagerly. Guard cheap shape/domain
            ; tests before lwo-active?, whose attribution walk is global.
            (if (eq (lwrl-observation-valid? observation) 0)
                (lwrl-collect-items world (tail items)
                    relation left right supports alternatives dissents
                    silences unresolved)
                (if (eq (lwrl-same-pair?
                            observation relation left right) 0)
                    (lwrl-collect-items world (tail items)
                        relation left right supports alternatives dissents
                        silences unresolved)
                    (if (eq (lwo-active? world observation) 0)
                        (lwrl-collect-items world (tail items)
                            relation left right supports alternatives dissents
                            silences unresolved)
                        (do
                            (let classified
                                (lwrl-classify-evidence observation
                                    (lwrl-evidence observation
                                        (lwo-active-attributions-for
                                            world observation))
                                    relation left right supports alternatives
                                    dissents silences unresolved))
                            (lwrl-collect-items world (tail items)
                                relation left right
                                (lwrl-evidence-supports classified)
                                (lwrl-evidence-alternatives classified)
                                (lwrl-evidence-dissents classified)
                                (lwrl-evidence-silences classified)
                                (lwrl-evidence-unresolved classified)))))))))

(defn lwrl-evidence-for (world relation left right)
    (lwrl-collect-items world
        (lwo-field-items (lwo-world-cells world)) relation left right
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwrl-field-attribution-count-items (items count)
    (if (eq (len items) 0) count
        (lwrl-field-attribution-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwrl-evidence-attributions (head items)))))))
(defn lwrl-field-attribution-count (field)
    (lwrl-field-attribution-count-items (lwo-field-items field) 0))
(defn lwrl-support-count (set)
    (lwrl-field-attribution-count (lwrl-evidence-supports set)))
(defn lwrl-alternative-count (set)
    (lwrl-field-attribution-count (lwrl-evidence-alternatives set)))
(defn lwrl-dissent-count (set)
    (lwrl-field-attribution-count (lwrl-evidence-dissents set)))
(defn lwrl-silence-count (set)
    (lwrl-field-attribution-count (lwrl-evidence-silences set)))
(defn lwrl-unresolved-count (set)
    (lwrl-field-attribution-count (lwrl-evidence-unresolved set)))

(defn lwrl-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwrl-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwrl-witnesses-from-evidence-items (items field)
    (if (eq (len items) 0) field
        (lwrl-witnesses-from-evidence-items (tail items)
            (lwrl-field-union-items
                (lwo-field-items
                    (lwrl-evidence-attributions (head items))) field))))
(defn lwrl-witnesses (set)
    (do
        (let supports
            (lwrl-witnesses-from-evidence-items
                (lwo-field-items (lwrl-evidence-supports set))
                (lwo-empty-field)))
        (let alternatives
            (lwrl-witnesses-from-evidence-items
                (lwo-field-items (lwrl-evidence-alternatives set)) supports))
        (let dissents
            (lwrl-witnesses-from-evidence-items
                (lwo-field-items (lwrl-evidence-dissents set)) alternatives))
        (let silences
            (lwrl-witnesses-from-evidence-items
                (lwo-field-items (lwrl-evidence-silences set)) dissents))
        (lwrl-witnesses-from-evidence-items
            (lwo-field-items (lwrl-evidence-unresolved set)) silences)))

; children: offered relation, directional endpoints, exact evidence, local path
(defn lwrl-edge (relation left right evidence)
    (intern_node LWRL-EDGE
        (list relation left right evidence (lwo-local-path))))
(defn lwrl-edge? (cell) (lwo-category? cell LWRL-EDGE))
(defn lwrl-edge-relation (edge) (nth (node_children edge) 0))
(defn lwrl-edge-left (edge) (nth (node_children edge) 1))
(defn lwrl-edge-right (edge) (nth (node_children edge) 2))
(defn lwrl-edge-evidence (edge) (nth (node_children edge) 3))
(defn lwrl-edge-path (edge) (nth (node_children edge) 4))
(defn lwrl-edge-valid? (edge)
    (if (and (eq (lwrl-edge? edge) 1)
             (and (not (node_eq (lwrl-edge-left edge)
                                 (lwrl-edge-right edge)))
                  (eq (lwrl-evidence-set?
                        (lwrl-edge-evidence edge)) 1))) 1 0))

(defn lwrl-origin (relation left right evidence threshold)
    (intern_node LWRL-ORIGIN
        (list relation left right evidence (intern_trivial_int threshold)
              (lwo-local-path))))

(defn lwrl-endpoints-current? (world left right)
    (if (and (eq (lwsl-integrated-current? world left) 1)
             (eq (lwsl-integrated-current? world right) 1)) 1 0))

(defn lwrl-proposal-for (world observation threshold)
    (if (eq (lwrl-observation-valid? observation) 0) (lwo-none)
        (if (eq (oac-one? (lwrl-observation-ack observation)) 0)
            (lwo-none)
            (if (eq (lwo-active? world observation) 0) (lwo-none)
                (do
                    (let relation (lwrl-observation-relation observation))
                    (let left (lwrl-observation-left observation))
                    (let right (lwrl-observation-right observation))
                    (if (eq (lwrl-endpoints-current?
                                world left right) 0)
                        (lwo-none)
                        (do
                            (let evidence
                                (lwrl-evidence-for
                                    world relation left right))
                            (if (lt (lwrl-support-count evidence) threshold)
                                (lwo-none)
                                (do
                                    (let edge
                                        (lwrl-edge relation left right evidence))
                                    (let witnesses (lwrl-witnesses evidence))
                                    (let origin
                                        (lwrl-origin relation left right
                                            evidence threshold))
                                    (let candidate
                                        (lwo-emergent edge witnesses
                                            (intern_trivial_int
                                                (lwrl-support-count evidence))
                                            (intern_trivial_int
                                                (lwo-field-size witnesses))
                                            (intern_trivial_int threshold)
                                            origin))
                                    (lwt-proposal candidate
                                        (lwt-sources-from-attributions
                                            (lwo-field-items witnesses)
                                            (lwo-empty-field))
                                        origin))))))))))

(defn lwrl-proposals-items (world items threshold field)
    (if (eq (len items) 0) field
        (do
            (let proposal (lwrl-proposal-for world (head items) threshold))
            (lwrl-proposals-items world (tail items) threshold
                (if (node_eq proposal (lwo-none)) field
                    (lwo-field-add field proposal))))))
(defn lwrl-proposals (world threshold)
    (lwrl-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwrl-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrl-edge-valid?
                   (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwrl-candidate-current? (world candidate)
    (if (eq (lwrl-candidate? candidate) 0) 0
        (do
            (let edge (lwo-emergent-shape candidate))
            (let evidence
                (lwrl-evidence-for world
                    (lwrl-edge-relation edge)
                    (lwrl-edge-left edge)
                    (lwrl-edge-right edge)))
            (let witnesses (lwrl-witnesses evidence))
            (if (and (eq (lwrl-endpoints-current? world
                           (lwrl-edge-left edge)
                           (lwrl-edge-right edge)) 1)
                     (and (node_eq evidence (lwrl-edge-evidence edge))
                          (and (node_eq witnesses
                                   (lwo-emergent-witnesses candidate))
                               (and (eq (lwrl-support-count evidence)
                                        (lwo-emergent-coherence candidate))
                                    (and (eq (lwo-field-size witnesses)
                                             (lwo-emergent-resonance candidate))
                                         (ge (lwrl-support-count evidence)
                                             (lwo-emergent-threshold
                                                candidate))))))) 1 0))))

(defn lwrl-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrl-candidate-current? world candidate) 1)) 1 0))

(defn lwrl-integrate (round proposal action)
    (if (eq (lwrl-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
