; public-source-concept-index-run.fk -- bounded live coverage telemetry for the
; public concept index.  It renders counts and NodeID only, never source bytes.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk

(do
    (defn pscir-print-family-rows (rows)
        (if (nil? rows) 0
            (do
                (let row (head rows))
                (print_str (str_concat "family=" (str_concat (nth row 1)
                    (str_concat " registered=" (str_concat (int_to_str (nth row 2))
                    (str_concat " index-integrated=" (str_concat
                        (int_to_str (nth row 3))
                    (str_concat " repository=" (str_concat (int_to_str (nth row 4))
                    (str_concat " percent=" (str_concat (int_to_str (nth row 5))
                        "\n")))))))))))
                (pscir-print-family-rows (tail rows)))))
    (let index (psci-public-sample-index-at "."))
    (let coverage (psci-coverage-at "." index))
    (print_str (str_concat "index-nodeid=" (str_concat (nth coverage 1) "\n")))
    (print_str (str_concat "families=" (str_concat
        (int_to_str (psci-coverage-family-count coverage)) "\n")))
    (print_str (str_concat "families-at-least-two=" (str_concat
        (int_to_str (psci-coverage-families-at-least-two coverage)) "\n")))
    (print_str (str_concat "registered-sources=" (str_concat
        (int_to_str (psci-coverage-registered coverage)) "\n")))
    (print_str (str_concat "index-integrated-sources=" (str_concat
        (int_to_str (psci-coverage-index-integrated coverage)) "\n")))
    (print_str (str_concat "repository-sources=" (str_concat
        (int_to_str (psci-coverage-repository coverage)) "\n")))
    (print_str (str_concat "registered-percent=" (str_concat
        (int_to_str (psci-coverage-registered-percent coverage)) "\n")))
    (print_str (str_concat "index-integrated-percent=" (str_concat
        (int_to_str (psci-coverage-index-integrated-percent coverage)) "\n")))
    (print_str (str_concat "model-integrated-sources=" (str_concat
        (int_to_str (psci-coverage-model-integrated coverage)) "\n")))
    (print_str (str_concat "model-integrated-percent=" (str_concat
        (int_to_str (psci-coverage-model-integrated-percent coverage)) "\n")))
    (print_str (str_concat "concept-keys=" (str_concat
        (int_to_str (psci-coverage-concept-keys coverage)) "\n")))
    (pscir-print-family-rows (psci-coverage-family-rows coverage))
    0)
