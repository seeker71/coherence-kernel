; living-world-recipe-execution.fk -- a consented Recipe moves inside the body.
;
; A Recipe is exact source carried as a content-addressed cell beside an
; explicit evaluator/effect/budget contract. The current realization door is
; form-eval-full: a Form-native, numeric/control evaluator with a finite named
; primitive surface and no host, file, or network operations. This interface
; vocabulary is execution substrate, not a domain ontology or answer table.
; A parameter-bearing Recipe receives only explicitly offered bindings: each
; safe symbol retains its exact source cell, integer projection, evidence,
; attribution witnesses, and local path.  The evaluator consumes that native
; environment directly; no source-text substitution or C-seed extension occurs.
;
; Execution is an observation, never authority. The exact Recipe, declaration,
; input, result, alternatives, unknowable remainder, choice, flow, changes, and
; active attribution witnesses remain in one trace. A proposal is governed by
; every current holder of Recipe, declaration, and input. Integration re-runs
; the Recipe and requires exact trace identity plus ordinary unanimous active
; acknowledgements. Revocation or source/evidence movement makes it stale.
;
; The evaluator is effect-contained but not gas-bounded: source byte budget is
; enforced, while unbounded user recursion can still fail to terminate. Timeout
; supervision belongs to the existing sender-authored timeout contract and is
; not fabricated inside a completed trace. form-eval-full's historical
; `nothing` literal is numeric zero; executable Recipes exclude that token so
; this layer cannot collapse immediate absence, zero, or timed expiration.
;
; witnessed: 2026-08-07 -> unbound, bound, and scoped-projection bands 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk

(let LWRE-EVALUATOR (bp "LWRE-EVALUATOR"))
(let LWRE-EFFECT    (bp "LWRE-EFFECT"))
(let LWRE-CONTRACT  (bp "LWRE-CONTRACT"))
(let LWRE-RECIPE    (bp "LWRE-RECIPE"))
(let LWRE-PROJECTION (bp "LWRE-PROJECTION"))
(let LWRE-BINDING   (bp "LWRE-BINDING"))
(let LWRE-BINDINGS  (bp "LWRE-BINDINGS"))
(let LWRE-RESULT    (bp "LWRE-RESULT"))
(let LWRE-TRACE     (bp "LWRE-TRACE"))
(let LWRE-ORIGIN    (bp "LWRE-ORIGIN"))

; The evaluator identity includes the actual finite interface it implements.
(defn lwre-form-evaluator ()
    (intern_node LWRE-EVALUATOR
        (list
            (intern_trivial_string "form-eval-full-v2")
            (intern_trivial_string
                "add sub mul div mod le lt gt ge eq ne and or not")
            (intern_trivial_string "if do let defn call")
            (intern_trivial_string "nothing-token-excluded")
            (lwo-local-path))))

; A separate evaluator identity keeps every historical unbound Recipe exact.
; The implementation is still form-eval-full; only its admitted interface is
; wider: an environment of explicitly offered numeric bindings.
(defn lwre-bound-form-evaluator ()
    (intern_node LWRE-EVALUATOR
        (list
            (intern_trivial_string "form-eval-full-v2-bound-v1")
            (intern_trivial_string
                "add sub mul div mod le lt gt ge eq ne and or not")
            (intern_trivial_string "if do let defn call")
            (intern_trivial_string "offered-numeric-bindings")
            (intern_trivial_string "nothing-token-excluded")
            (lwo-local-path))))

(defn lwre-pure-effect ()
    (intern_node LWRE-EFFECT
        (list
            (intern_trivial_string "numeric-result")
            (intern_trivial_string "no-host-file-network-effect")
            (lwo-local-path))))

; children: evaluator, effect, positive source-byte budget, optional evidence,
;           local path
(defn lwre-contract (evaluator effect budget evidence)
    (intern_node LWRE-CONTRACT
        (list evaluator effect (intern_trivial_int budget) evidence
              (lwo-local-path))))
(defn lwre-contract? (cell) (lwo-category? cell LWRE-CONTRACT))
(defn lwre-contract-evaluator (contract) (nth (node_children contract) 0))
(defn lwre-contract-effect (contract) (nth (node_children contract) 1))
(defn lwre-contract-budget (contract)
    (node_value (nth (node_children contract) 2)))
(defn lwre-contract-evidence (contract) (nth (node_children contract) 3))
(defn lwre-contract-path (contract) (nth (node_children contract) 4))

(defn lwre-form-contract (budget evidence)
    (lwre-contract (lwre-form-evaluator) (lwre-pure-effect)
        budget evidence))

(defn lwre-bound-form-contract (budget evidence)
    (lwre-contract (lwre-bound-form-evaluator) (lwre-pure-effect)
        budget evidence))

(defn lwre-unbound-contract? (contract)
    (if (node_eq (lwre-contract-evaluator contract)
                 (lwre-form-evaluator)) 1 0))
(defn lwre-bound-contract? (contract)
    (if (node_eq (lwre-contract-evaluator contract)
                 (lwre-bound-form-evaluator)) 1 0))

(defn lwre-contract-valid? (contract)
    (if (and (eq (lwre-contract? contract) 1)
             (and (or (eq (lwre-unbound-contract? contract) 1)
                      (eq (lwre-bound-contract? contract) 1))
                  (and (node_eq (lwre-contract-effect contract)
                                (lwre-pure-effect))
                       (gt (lwre-contract-budget contract) 0)))) 1 0))

; children: exact source string cell, evaluator contract, optional evidence,
;           local path
(defn lwre-recipe (source contract evidence)
    (intern_node LWRE-RECIPE
        (list (intern_trivial_string source) contract evidence
              (lwo-local-path))))
(defn lwre-recipe? (cell) (lwo-category? cell LWRE-RECIPE))
(defn lwre-recipe-source-cell (recipe) (nth (node_children recipe) 0))
(defn lwre-recipe-source (recipe)
    (node_value (lwre-recipe-source-cell recipe)))
(defn lwre-recipe-contract (recipe) (nth (node_children recipe) 1))
(defn lwre-recipe-evidence (recipe) (nth (node_children recipe) 2))
(defn lwre-recipe-path (recipe) (nth (node_children recipe) 3))

(defn lwre-text-match-at? (source token source-pos token-pos)
    (if (eq token-pos (str_len token)) 1
        (if (ge source-pos (str_len source)) 0
            (if (eq (ord (char_at source source-pos))
                    (ord (char_at token token-pos)))
                (lwre-text-match-at? source token
                    (add source-pos 1) (add token-pos 1)) 0))))

(defn lwre-text-has-from? (source token pos)
    (if (gt (add pos (str_len token)) (str_len source)) 0
        (if (eq (lwre-text-match-at? source token pos 0) 1) 1
            (lwre-text-has-from? source token (add pos 1)))))

(defn lwre-text-has? (source token)
    (if (eq (str_len token) 0) 1
        (lwre-text-has-from? source token 0)))

(defn lwre-recipe-valid? (recipe)
    (if (and (eq (lwre-recipe? recipe) 1)
             (and (eq (lwre-contract-valid?
                           (lwre-recipe-contract recipe)) 1)
                  (and (le (str_len (lwre-recipe-source recipe))
                           (lwre-contract-budget
                             (lwre-recipe-contract recipe)))
                       (eq (lwre-text-has?
                              (lwre-recipe-source recipe) "nothing") 0)))) 1 0))

(defn lwre-evaluate (recipe)
    (fef-eval (lwre-recipe-source recipe)))

; --- explicitly offered parameter environment ---------------------------

; A scoped projection lets a holder offer a numeric view without adding a new
; attribution to the globally interned scalar.  Its scope and source are exact
; active cells; the integer is observed inside the offered projection.  This
; keeps unrelated historical witness sets stable when a familiar value enters
; a new local invocation.  Alternatives and unknowability remain beside the
; projection rather than being coerced into its primary numeric view.
(defn lwre-projection
    (scope source value alternatives unknown evidence)
    (intern_node LWRE-PROJECTION
        (list scope source value alternatives unknown evidence
              (lwo-local-path))))
(defn lwre-projection? (cell) (lwo-category? cell LWRE-PROJECTION))
(defn lwre-projection-scope (projection) (nth (node_children projection) 0))
(defn lwre-projection-source (projection) (nth (node_children projection) 1))
(defn lwre-projection-value (projection) (nth (node_children projection) 2))
(defn lwre-projection-alternatives (projection)
    (nth (node_children projection) 3))
(defn lwre-projection-unknown (projection) (nth (node_children projection) 4))
(defn lwre-projection-evidence (projection) (nth (node_children projection) 5))
(defn lwre-projection-path (projection) (nth (node_children projection) 6))
(defn lwre-projection-valid? (projection)
    (if (and (eq (lwre-projection? projection) 1)
             (and (not (node_eq
                          (lwre-projection-scope projection) (lwo-none)))
                  (and (not (node_eq
                              (lwre-projection-source projection)
                              (lwo-none)))
                       (and (eq (node_type
                                  (lwre-projection-value projection)) 1)
                            (and (eq (lwo-category?
                                      (lwre-projection-alternatives projection)
                                      LWO-FIELD) 1)
                                 (or (node_eq
                                       (lwre-projection-unknown projection)
                                       (lwo-none))
                                     (eq (lwlc-unknown?
                                           (lwre-projection-unknown projection))
                                         1))))))) 1 0))
(defn lwre-projection-current? (world projection)
    (if (and (eq (lwre-projection-valid? projection) 1)
             (and (eq (lwo-active? world projection) 1)
                  (and (eq (lwo-active? world
                              (lwre-projection-scope projection)) 1)
                       (eq (lwo-active? world
                              (lwre-projection-source projection)) 1)))) 1 0))

; A binding does not claim what its source means.  It only says that, for
; this invocation, a caller offers one safe Form symbol as the numeric value
; projected by an exact source cell.  Historical direct values remain exact;
; a scoped projection may occupy the value-carrier slot instead.  Source,
; carrier, numeric view, binding, and evidence remain content-addressed and
; independently revocable.
(defn lwre-binding (name source value evidence)
    (intern_node LWRE-BINDING
        (list (intern_trivial_string name) source value evidence
              (lwo-local-path))))
(defn lwre-projected-binding (name projection evidence)
    (lwre-binding name (lwre-projection-source projection)
        projection evidence))
(defn lwre-binding? (cell) (lwo-category? cell LWRE-BINDING))
(defn lwre-binding-name-cell (binding) (nth (node_children binding) 0))
(defn lwre-binding-name (binding) (node_value (lwre-binding-name-cell binding)))
(defn lwre-binding-source (binding) (nth (node_children binding) 1))
(defn lwre-binding-carrier (binding) (nth (node_children binding) 2))
(defn lwre-binding-projection (binding)
    (if (eq (lwre-projection?
                (lwre-binding-carrier binding)) 1)
        (lwre-binding-carrier binding) (lwo-none)))
(defn lwre-binding-value (binding)
    (do
        (let carrier (lwre-binding-carrier binding))
        (if (eq (lwre-projection? carrier) 1)
            (lwre-projection-value carrier) carrier)))
(defn lwre-binding-evidence (binding) (nth (node_children binding) 3))
(defn lwre-binding-path (binding) (nth (node_children binding) 4))

(defn lwre-binding-name-char-safe? (code)
    (if (or (eq code 32)
            (or (eq code 9)
                (or (eq code 10)
                    (or (eq code 13)
                        (or (eq code 40) (eq code 41)))))) 0 1))
(defn lwre-binding-name-chars-safe? (name pos)
    (if (ge pos (str_len name)) 1
        (if (eq (lwre-binding-name-char-safe?
                    (ord (char_at name pos))) 1)
            (lwre-binding-name-chars-safe? name (add pos 1)) 0)))
(defn lwre-binding-name-safe? (name)
    (if (eq (str_len name) 0) 0
        (do
            (let first (ord (char_at name 0)))
            (if (or (and (ge first 48) (le first 57))
                    (or (str_eq name "true")
                        (or (str_eq name "false")
                            (str_eq name "nothing")))) 0
                (lwre-binding-name-chars-safe? name 0)))))
(defn lwre-binding-valid? (binding)
    (if (and (eq (lwre-binding? binding) 1)
             (and (eq (lwre-binding-name-safe?
                          (lwre-binding-name binding)) 1)
                  (and (not (node_eq
                                (lwre-binding-source binding) (lwo-none)))
                       (do
                           (let carrier (lwre-binding-carrier binding))
                           (if (eq (lwre-projection? carrier) 1)
                               (if (and (eq (lwre-projection-valid?
                                               carrier) 1)
                                        (node_eq
                                          (lwre-binding-source binding)
                                          (lwre-projection-source carrier)))
                                   1 0)
                               (if (eq (node_type carrier) 1) 1 0)))))) 1 0))

(defn lwre-bindings (items) (intern_node LWRE-BINDINGS items))
(defn lwre-bindings? (cell) (lwo-category? cell LWRE-BINDINGS))
(defn lwre-binding-items (bindings) (node_children bindings))
(defn lwre-empty-bindings () (lwre-bindings (list)))
(defn lwre-binding-name-in-items? (name items)
    (if (eq (len items) 0) 0
        (if (str_eq name (lwre-binding-name (head items))) 1
            (lwre-binding-name-in-items? name (tail items)))))
(defn lwre-bindings-valid-items? (remaining seen)
    (if (eq (len remaining) 0) 1
        (do
            (let binding (head remaining))
            (if (and (eq (lwre-binding-valid? binding) 1)
                     (eq (lwre-binding-name-in-items?
                            (lwre-binding-name binding) seen) 0))
                (lwre-bindings-valid-items?
                    (tail remaining) (cons binding seen)) 0))))
(defn lwre-bindings-valid? (bindings)
    (if (eq (lwre-bindings? bindings) 0) 0
        (lwre-bindings-valid-items?
            (lwre-binding-items bindings) (list))))
(defn lwre-bindings-current-items? (world items)
    (if (eq (len items) 0) 1
        (do
            (let binding (head items))
            (if (and (eq (lwo-active? world binding) 1)
                     (and (eq (lwo-active? world
                                (lwre-binding-source binding)) 1)
                          (do
                              (let projection
                                  (lwre-binding-projection binding))
                              (if (node_eq projection (lwo-none))
                                  (lwo-active? world
                                      (lwre-binding-value binding))
                                  (lwre-projection-current?
                                      world projection)))))
                (lwre-bindings-current-items? world (tail items)) 0))))
(defn lwre-bindings-current? (world bindings)
    (if (and (eq (lwre-bindings-valid? bindings) 1)
             (eq (lwre-bindings-current-items?
                    world (lwre-binding-items bindings)) 1)) 1 0))
(defn lwre-binding-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwre-binding-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwre-binding-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let binding (head items))
            (let with-binding
                (lwre-binding-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world binding)) field))
            (let with-source
                (lwre-binding-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world
                            (lwre-binding-source binding)))
                    with-binding))
            (let projection (lwre-binding-projection binding))
            (let with-carrier
                (if (node_eq projection (lwo-none))
                    (lwre-binding-field-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world
                                (lwre-binding-value binding)))
                        with-source)
                    (do
                        (let with-projection
                            (lwre-binding-field-union-items
                                (lwo-field-items
                                    (lwo-active-attributions-for
                                        world projection))
                                with-source))
                        (lwre-binding-field-union-items
                            (lwo-field-items
                                (lwo-active-attributions-for world
                                    (lwre-projection-scope projection)))
                            with-projection))))
            (lwre-binding-witnesses-items
                world (tail items) with-carrier))))
(defn lwre-binding-witnesses (world bindings)
    (lwre-binding-witnesses-items world
        (lwre-binding-items bindings) (lwo-empty-field)))
(defn lwre-bindings-env-items (items env)
    (if (eq (len items) 0) env
        (do
            (let binding (head items))
            (lwre-bindings-env-items (tail items)
                (fef-bind-var (lwre-binding-name binding)
                    (node_value (lwre-binding-value binding)) env)))))
(defn lwre-bindings-env (bindings)
    (lwre-bindings-env-items (lwre-binding-items bindings)
        (list (list "" 0 0 0))))
(defn lwre-evaluate-bound (recipe bindings)
    (fef-v (fef-expr (lwre-recipe-source recipe) 0
        (lwre-bindings-env bindings))))

; primary is the exact native numeric result cell. Alternatives and unknown
; may coexist without changing that observation.
(defn lwre-result (primary alternatives unknown evidence)
    (intern_node LWRE-RESULT
        (list primary alternatives unknown evidence (lwo-local-path))))
(defn lwre-result? (cell) (lwo-category? cell LWRE-RESULT))
(defn lwre-result-primary (result) (nth (node_children result) 0))
(defn lwre-result-alternatives (result) (nth (node_children result) 1))
(defn lwre-result-unknown (result) (nth (node_children result) 2))
(defn lwre-result-evidence (result) (nth (node_children result) 3))
(defn lwre-result-path (result) (nth (node_children result) 4))
(defn lwre-result-valid? (result)
    (if (and (eq (lwre-result? result) 1)
             (and (eq (lwo-category?
                           (lwre-result-alternatives result)
                           LWO-FIELD) 1)
                  (or (node_eq (lwre-result-unknown result) (lwo-none))
                      (eq (lwlc-unknown?
                            (lwre-result-unknown result)) 1)))) 1 0))

(defn lwre-lens-in-items? (lens items)
    (if (eq (len items) 0) 0
        (if (node_eq lens (head items)) 1
            (lwre-lens-in-items? lens (tail items)))))

(defn lwre-lens-current? (world declaration lens)
    (if (and (eq (lwlc-declaration-current? world declaration) 1)
             (and (eq (lwlc-recipe-lens? lens) 1)
                  (and (eq (lwre-lens-in-items? lens
                                (lwlc-stack-applied-lenses
                                  (lwlc-declaration-stack declaration))) 1)
                       (and (eq (lwre-recipe-valid?
                                   (lwlc-lens-payload lens)) 1)
                            (eq (lwo-active? world
                                  (lwlc-lens-payload lens)) 1))))) 1 0))

(defn lwre-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwre-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwre-witnesses (world declaration recipe before)
    (do
        (let with-recipe
            (lwre-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world recipe))
                (lwo-empty-field)))
        (let with-declaration
            (lwre-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world declaration))
                with-recipe))
        (lwre-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world before))
            with-declaration)))
(defn lwre-witnesses-bound (world declaration recipe before bindings)
    (lwre-field-union-items
        (lwo-field-items (lwre-binding-witnesses world bindings))
        (lwre-witnesses world declaration recipe before)))

; children: declaration, exact lens, Recipe, before, result, flow, changes,
;           optional choice, witness attributions, optional evidence, path
(defn lwre-trace
    (declaration lens recipe before result flow changes choice witnesses evidence)
    (intern_node LWRE-TRACE
        (list declaration lens recipe before result flow changes choice
              witnesses evidence (lwo-local-path))))
(defn lwre-trace-bound
    (declaration lens recipe before result flow changes choice witnesses
     evidence bindings)
    (if (eq (len (lwre-binding-items bindings)) 0)
        (lwre-trace declaration lens recipe before result flow changes choice
            witnesses evidence)
        (intern_node LWRE-TRACE
            (list declaration lens recipe before result flow changes choice
                  witnesses evidence bindings (lwo-local-path)))))
(defn lwre-trace? (cell) (lwo-category? cell LWRE-TRACE))
(defn lwre-trace-declaration (trace) (nth (node_children trace) 0))
(defn lwre-trace-lens (trace) (nth (node_children trace) 1))
(defn lwre-trace-recipe (trace) (nth (node_children trace) 2))
(defn lwre-trace-before (trace) (nth (node_children trace) 3))
(defn lwre-trace-result (trace) (nth (node_children trace) 4))
(defn lwre-trace-flow (trace) (nth (node_children trace) 5))
(defn lwre-trace-changes (trace) (nth (node_children trace) 6))
(defn lwre-trace-choice (trace) (nth (node_children trace) 7))
(defn lwre-trace-witnesses (trace) (nth (node_children trace) 8))
(defn lwre-trace-evidence (trace) (nth (node_children trace) 9))
(defn lwre-trace-bindings (trace)
    (if (eq (len (node_children trace)) 11) (lwre-empty-bindings)
        (nth (node_children trace) 10)))
(defn lwre-trace-path (trace)
    (if (eq (len (node_children trace)) 11)
        (nth (node_children trace) 10)
        (nth (node_children trace) 11)))

(defn lwre-execute-bound
    (world declaration lens before bindings alternatives unknown choice flow
     changes evidence)
    (if (or (eq (lwre-lens-current? world declaration lens) 0)
            (or (eq (lwo-active? world before) 0)
                (or (eq (lwre-bindings-valid? bindings) 0)
                    (or (and (eq (len (lwre-binding-items bindings)) 0)
                             (eq (lwre-unbound-contract?
                                    (lwre-recipe-contract
                                      (lwlc-lens-payload lens))) 0))
                        (or (and (gt (len (lwre-binding-items bindings)) 0)
                                 (eq (lwre-bound-contract?
                                        (lwre-recipe-contract
                                          (lwlc-lens-payload lens))) 0))
                            (or (and (gt (len
                                          (lwre-binding-items bindings)) 0)
                                     (eq (lwre-bindings-current?
                                            world bindings) 0))
                                (or (eq (lwo-category?
                                          alternatives LWO-FIELD) 0)
                                    (or (and
                                          (not (node_eq unknown (lwo-none)))
                                          (eq (lwlc-unknown? unknown) 0))
                                        (eq (lwlc-choice-valid?
                                              choice) 0)))))))))
        (lwo-none)
        (do
            (let recipe (lwlc-lens-payload lens))
            (let result
                (lwre-result
                    (intern_trivial_int
                        (if (eq (len
                                  (lwre-binding-items bindings)) 0)
                            (lwre-evaluate recipe)
                            (lwre-evaluate-bound recipe bindings)))
                    alternatives unknown evidence))
            (lwre-trace-bound declaration lens recipe before result flow
                changes choice
                (lwre-witnesses-bound
                    world declaration recipe before bindings)
                evidence bindings))))

(defn lwre-execute
    (world declaration lens before alternatives unknown choice flow changes evidence)
    (lwre-execute-bound world declaration lens before (lwre-empty-bindings)
        alternatives unknown choice flow changes evidence))

(defn lwre-trace-current? (world trace)
    (if (eq (lwre-trace? trace) 0) 0
        (do
            (let result (lwre-trace-result trace))
            (if (eq (lwre-result-valid? result) 0) 0
                (if (node_eq trace
                        (lwre-execute-bound world
                            (lwre-trace-declaration trace)
                            (lwre-trace-lens trace)
                            (lwre-trace-before trace)
                            (lwre-trace-bindings trace)
                            (lwre-result-alternatives result)
                            (lwre-result-unknown result)
                            (lwre-trace-choice trace)
                            (lwre-trace-flow trace)
                            (lwre-trace-changes trace)
                            (lwre-trace-evidence trace))) 1 0)))))

(defn lwre-origin (trace)
    (intern_node LWRE-ORIGIN (list trace (lwo-local-path))))

(defn lwre-proposal-bound
    (world declaration lens before bindings alternatives unknown choice flow
     changes evidence)
    (do
        (let trace
            (lwre-execute-bound world declaration lens before bindings
                alternatives unknown choice flow changes evidence))
        (if (node_eq trace (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwre-trace-witnesses trace))
                (let count (lwo-field-size witnesses))
                (let origin (lwre-origin trace))
                (let candidate
                    (lwo-emergent trace witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwre-proposal
    (world declaration lens before alternatives unknown choice flow changes evidence)
    (lwre-proposal-bound world declaration lens before (lwre-empty-bindings)
        alternatives unknown choice flow changes evidence))

(defn lwre-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwre-trace-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))

(defn lwre-integrate (round proposal action)
    (if (eq (lwre-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

