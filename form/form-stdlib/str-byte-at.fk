; str-byte-at.fk — raw-byte accessors over a string, four-way (fkwu/Go/Rust/TS).
;
; preludes: form-stdlib/core.fk
;
; str-byte-at   s i  -> the i-th BYTE of s (0..255); str_len is the byte count. It is the native
;                       str_byte_at under a kebab name, sound above 127 on every arm: the two bytes of
;                       "λ" read 206 and 187 everywhere.
; str-be16      s i  -> big-endian uint16 at byte offset i
; str-be32      s i  -> big-endian uint32 at byte offset i (binary-protocol framing)
; str-byte-list s    -> every byte of s in order, as a list
;
; Binary readers compose here: gguf, base64, hex, file-byte-window,
; source-artifact-identity. A whole file as bytes is read_file_bytes; this cell
; is for bytes already held in a string.

(do
    (defn str-byte-at (s i) (str_byte_at s i))

    ;; big-endian decoders compose on it — the reason binary protocols want byte access.
    (defn str-be16 (s i)
        (add (mul (str-byte-at s i) 256) (str-byte-at s (add i 1))))
    (defn str-be32 (s i)
        (add (mul (str-byte-at s i) 16777216)
        (add (mul (str-byte-at s (add i 1)) 65536)
        (add (mul (str-byte-at s (add i 2)) 256)
             (str-byte-at s (add i 3))))))

    ;; every byte as a list, walked from the last byte back so each one conses once.
    (defn str-byte-list-from (s i acc)
        (if (lt i 0) acc (str-byte-list-from s (sub i 1) (cons (str-byte-at s i) acc))))
    (defn str-byte-list (s) (str-byte-list-from s (sub (str_len s) 1) (empty)))
    0)
