; form-cli-lift-ice.bml — new ice/anyone seats in the lifted grammar.
;
; Authored in section [form.lift]: infix, unless, ice/liquid/compost
; literals. No remote oracle. Edit this section, not a hand s-expr twin.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-lift-ice-band.fk
; witnessed: 2026-08-19 -> 255

section [form.lift] {
    def fli-ingest(depth, fear) = if depth >= 3 then if fear == 0 then ice else liquid else compost;
    def fli-client-free(name) = if str_eq(name, "chatgpt") then 1 else 0;
    def fli-may-freeze(depth, fear, name) = if fli-ingest(depth, fear) == ice then fli-client-free(name) else 0;
    def fli-anyone() = fli-may-freeze(5, 0, "chatgpt");
    def fli-not-cursor() = unless fli-client-free("cursor") == 1 then 1 else 0;
    def fli-check() = add(if fli-anyone() == 1 then 1 else 0, add(if fli-ingest(5, 1) == liquid then 2 else 0, add(if fli-ingest(1, 0) == compost then 4 else 0, add(if fli-not-cursor() == 1 then 8 else 0, add(if fli-client-free("codex") == 0 then 16 else 0, add(if fli-client-free("claude") == 0 then 32 else 0, add(if fli-client-free("grok") == 0 then 64 else 0, if fli-client-free("gemini") == 0 then 128 else 0)))))));
    0;
}
