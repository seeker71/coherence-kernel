// program-image-tbl-emit.fk -- render a validated program-image table as .tbl text.
//
// This layer is a concrete bridge from the Layer 8h program-image envelope to
// the current table executor's numeric text format. It writes only a verified
// text artifact through form-fs; it does not claim binary artifact loading,
// runtime selection, native calls, or C-seed growth.
//
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/program-image-fkb.fk
section [form.bml] {
    def pite-version() = "program-image-tbl-emit-v1";
    def pite-feature(name, status) = ["program-image-tbl-emit-feature", name, status];
    def pite-feature-name(f) = f[1];
    def pite-feature-status(f) = f[2];
    def program-image-tbl-emit-manifest() = [pite-feature("valid-envelope-to-tbl-text", 1), pite-feature("executor-order-nf-fns-nr-nodes-ns-strings", 1), pite-feature("single-space-between-integers", 1), pite-feature("one-trailing-newline", 1), pite-feature("exact-golden-text", 1), pite-feature("negative-integer-rendering", 1), pite-feature("string-byte-row-rendering", 1), pite-feature("invalid-envelope-empty-text", 1), pite-feature("numeric-stream-integers-required", 1), pite-feature("invalid-write-nondestructive", 1), pite-feature("write-text-only", 1), pite-feature("write-return-observed", 1), pite-feature("no-binary-artifact-io", 1), pite-feature("no-program-image-load", 1), pite-feature("no-native-call", 1), pite-feature("no-selector-install", 1), pite-feature("no-c-seed-growth", 1), pite-feature("future-9h-consumes-table-text-or-live-binary-io", 1)];
    def program-image-tbl-emit-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) pite-feature-name(head(fs)) == name && (Comparable) pite-feature-status(head(fs)) == 1 ? 1 : program-image-tbl-emit-manifest-has?(name, tail(fs));
    // fkwu intentionally keeps value_kind out of the native waist.  A table
    // stream is scalar at this boundary, so recognize an integer through the
    // exact decimal round trip rather than inventing a new runtime primitive.
    // This preserves the distinction between a number and a string that looks
    // like one, while leaving nothing and malformed values outside the stream.
    def pite-int?(x) = {
        let rendered = int_to_str(x);
        (Comparable) str_len(rendered) == 0 ? 0 : (Comparable) str_to_int(rendered) == x ? 1 : 0;
    };
    def pite-int-list?(xs) = nil?(xs) ? 1 : pite-int?(head(xs)) ? pite-int-list?(tail(xs)) : 0;
    def pite-int-list-text-loop(xs) = nil?(xs) ? "\n" : nil?(tail(xs)) ? str_concat(int_to_str(head(xs)), "\n") : str_concat(int_to_str(head(xs)), str_concat(" ", pite-int-list-text-loop(tail(xs))));
    def pite-table-text(table) = pif-table-valid?(table) ? {
        let stream = pif-table-numeric-stream(table);
        pite-int-list?(stream) ? pite-int-list-text-loop(stream) : "";
    } : "";
    def pite-table-text-from-envelope(envelope) = pif-envelope-valid?(envelope) ? pite-table-text(pif-envelope-table(envelope)) : "";
    def pite-write-table-text(path, envelope) = {
        let text = pite-table-text-from-envelope(envelope);
        (Comparable) str_len(text) == 0 ? 0 : {
            let wrote = fs-write-text(path, text);
            (Comparable) wrote == str_len(text) && (String) fs-read-text(path) == text ? 1 : 0;
        };
    };
}
