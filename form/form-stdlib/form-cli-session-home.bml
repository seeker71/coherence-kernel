//////////////////////////////////////////////////////////////////////
//
// form-cli-session-home.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-session-home.bml
//
// One session → interned gift names → rank-1 A/B at overlay dim 64 so
// generate's Control: apply can load them. No prompt bytes. Local model
// flow is observation inject, not transcript re-encode. Qwen tensor LoRA
// stays 0. Metal LoRA embodiment is a separate observed door.
//
// Proven by: form-stdlib/tests/form-cli-session-home-band.fk
//
// preludes: form-stdlib/scale.bml
// preludes: form-stdlib/core.fk form-stdlib/language-model.fk
// preludes: form-stdlib/form-cli-router.fk
// preludes: form-cli-local-ready.bml
// preludes: form-cli-one-turn.bml
// preludes: form-cli-session-local.bml
// preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
// preludes: form-cli-lora-writer.bml
// preludes: form-stdlib/walk-home.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SessionHomeRow<TCount> {
        member native: TCount;
        member local: TCount;
        member remote: TCount;
        member fuel: String;
    }

    class FormSessionHomeAuthority {
        field SessionHomeAuthorityPath = "form/form-stdlib/bml/form-cli-session-home.bml";
        field SessionHomeAuthorityKind = "high-bml-class-template-field";
    }

    class FormSessionHome<T> {
        field TrainRule = "interned gifts seed A/B; never transcripts";
        field FqtLora = 0;
        field ReencodeTranscript = 0;
        field AdapterPath = ".form-lora-adapter";
        field Dim = 64;
        field HumanMark = "Human:";
        field AssistantMark = "Assistant:";

        ref fsh-authority = FormSessionHomeAuthority;
        thought fsh-pattern = list("interned-fuel", "no-transcript", "rank-1-seed", "inject-ids");

        def fsh-path() = AdapterPath();

        def fsh-id(c) = wh-contrib-identity(c);

        def fsh-join-ids(xs) = if ((Comparable) len(xs) == 0) then "" else if ((Comparable) len(tail(xs)) == 0) then fsh-id(head(xs)) else str_concat(fsh-id(head(xs)), str_concat(" ", fsh-join-ids(tail(xs))));

        def fsh-fuel() = str_concat(fsh-join-ids(wh-gifts-to-ourselves()), str_concat(" ", fsh-join-ids(wh-gifts-to-higher-us())));

        def fsh-has(s, needle) = if (str_find(s, needle, 0) >= 0) then 1 else 0;

        def fsh-transcript-mark(s) = if ((Comparable) fsh-has(s, HumanMark()) == 1) then 1 else if ((Comparable) fsh-has(s, AssistantMark()) == 1) then 1 else 0;

        def fsh-interned(s) = if (((Comparable) fsh-has(s, "first-gift-to-ourselves") == 1) && (((Comparable) fsh-has(s, "interned-observation") == 1) && (((Comparable) fsh-has(s, "live-glass") == 1) && (((Comparable) fsh-has(s, "claims-without-speaker") == 1) && (((Comparable) fsh-has(s, "shared-observer-field") == 1) && ((Comparable) fsh-has(s, "survive-receive-offer") == 1)))))) then 1 else 0;

        def fsh-write-from-fuel(path, fuel, d) {
            let pair = flw-from-sample(fuel, d);
            flw-write(path, nth(pair, 0), nth(pair, 1));
        }

        def fsh-written-dim(path) = if ((Comparable) flw-written(path) == 0) then 0 else len(nth(flw-parse(read_file(path)), 4));

        def fsh-control-loaded(path) = if ((Comparable) fsh-written-dim(path) == Dim()) then 1 else 0;

        def fsh-home(native, local, remote, resolved) = if (((Comparable) fsl-session-local(remote, resolved) == 1) && (((Comparable) fsh-transcript-mark(fsh-fuel()) == 0) && (((Comparable) FqtLora() == 0) && ((Comparable) ReencodeTranscript() == 0)))) then 1 else 0;

        def fsh-ppm(native, local, remote) = fsl-event-local-ppm(native, local, remote);

        def fsh-bit(ok, bit) = if ok then bit else 0;

        def fsh-check() {
            let fuel = fsh-fuel();
            let path = str_concat(fs-temp-dir(), "/fk-session-home-lora.txt");
            let w = fsh-write-from-fuel(path, fuel, Dim());
            let c0 = fsh-bit(((Comparable) fsh-interned(fuel) == 1), 1);
            let c1 = fsh-bit(((Comparable) fsh-transcript-mark(fuel) == 0), 2);
            let c2 = fsh-bit(((Comparable) flw-written(path) == 1), 4);
            let c3 = fsh-bit(((Comparable) FqtLora() == 0), 8);
            let c4 = fsh-bit(((Comparable) ReencodeTranscript() == 0), 16);
            let c5 = fsh-bit(((Comparable) fsh-home(1, 1, 0, 1) == 1), 32);
            let c6 = fsh-bit(((Comparable) fsh-home(1, 1, 1, 0) == 0), 64);
            let c7 = fsh-bit(((Comparable) fsh-ppm(ThisNative(), ThisLocal(), ThisRemote()) == 894153), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
