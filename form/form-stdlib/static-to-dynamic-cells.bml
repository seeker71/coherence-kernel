; static-to-dynamic-cells.bml - Form-native cells for static memory release.
;
; preludes: form-stdlib/core.fk
;
; Static files can remain useful source tissue, but attention should not keep
; re-discovering the same desire forever. Each static source names a successor
; cell, evidence count, proof command, and release gate. When every row is live,
; the lane is in its end-state: wellness reads the dynamic cell state instead of
; reporting `wants_dynamic` attention.

section [form.bml] {
    let std_tag_surface = bp("STATIC-DYNAMIC-SURFACE");
    let std_tag_successor = bp("STATIC-DYNAMIC-SUCCESSOR");
    let std_tag_lane = bp("STATIC-DYNAMIC-LANE");

    def std-bool-score(ok, score) = ok ? score : 0;
    def std-tagged?(value, tag, arity) = (Comparable) len(value) == arity ? node_eq(value[0], tag) : false;
    def std-nonempty-string?(value) = str_len(value) > 0;

    def std-state-wanting() = "wanting";
    def std-state-live() = "live";
    def std-state-released() = "released";

    def std-successor(id, carrier, proof_command, release_gate) = list(std_tag_successor, id, carrier, proof_command, release_gate);
    def std-successor?(successor) = std-tagged?(successor, std_tag_successor, 5);
    def std-successor-id(successor) = successor[1];
    def std-successor-carrier(successor) = successor[2];
    def std-successor-proof-command(successor) = successor[3];
    def std-successor-release-gate(successor) = successor[4];
    def std-successor-valid?(successor) = std-successor?(successor) ? (std-nonempty-string?(std-successor-id(successor)) && (std-nonempty-string?(std-successor-carrier(successor)) && (std-nonempty-string?(std-successor-proof-command(successor)) && std-nonempty-string?(std-successor-release-gate(successor))))) : false;

    def std-surface(source_path, kind, successor, source_signal_count, evidence_count, state, resources) = list(std_tag_surface, source_path, kind, successor, source_signal_count, evidence_count, state, resources);
    def std-surface?(surface) = std-tagged?(surface, std_tag_surface, 8);
    def std-surface-source-path(surface) = surface[1];
    def std-surface-kind(surface) = surface[2];
    def std-surface-successor(surface) = surface[3];
    def std-surface-source-signal-count(surface) = surface[4];
    def std-surface-evidence-count(surface) = surface[5];
    def std-surface-state(surface) = surface[6];
    def std-surface-resources(surface) = surface[7];
    def std-surface-valid?(surface) = std-surface?(surface) ? (std-nonempty-string?(std-surface-source-path(surface)) && (std-nonempty-string?(std-surface-kind(surface)) && (std-successor-valid?(std-surface-successor(surface)) && ((std-surface-source-signal-count(surface) > 0) && ((std-surface-evidence-count(surface) > 0) && (std-nonempty-string?(std-surface-state(surface)) && std-nonempty-string?(std-surface-resources(surface)))))))) : false;
    def std-surface-live?(surface) = std-surface-valid?(surface) ? ((String) std-surface-state(surface) == std-state-live()) : false;
    def std-surface-released?(surface) = std-surface-valid?(surface) ? ((String) std-surface-state(surface) == std-state-released()) : false;
    def std-surface-active?(surface) = std-surface-live?(surface) ? true : std-surface-released?(surface);

    def std-surfaces-valid?(surfaces) = nil?(surfaces) ? true : std-surface-valid?(head(surfaces)) ? std-surfaces-valid?(tail(surfaces)) : false;
    def std-live-count(surfaces) = nil?(surfaces) ? 0 : ((std-surface-live?(head(surfaces)) ? 1 : 0) + std-live-count(tail(surfaces)));
    def std-active-count(surfaces) = nil?(surfaces) ? 0 : ((std-surface-active?(head(surfaces)) ? 1 : 0) + std-active-count(tail(surfaces)));
    def std-source-signal-total(surfaces) = nil?(surfaces) ? 0 : (std-surface-source-signal-count(head(surfaces)) + std-source-signal-total(tail(surfaces)));
    def std-evidence-total(surfaces) = nil?(surfaces) ? 0 : (std-surface-evidence-count(head(surfaces)) + std-evidence-total(tail(surfaces)));
    def std-basis-points(part, total) = (Comparable) total == 0 ? 0 : ((part * 10000) / total);

    def std-lane(name, north_star, surfaces) = list(std_tag_lane, name, north_star, surfaces);
    def std-lane?(lane) = std-tagged?(lane, std_tag_lane, 4);
    def std-lane-name(lane) = lane[1];
    def std-lane-north-star(lane) = lane[2];
    def std-lane-surfaces(lane) = lane[3];
    def std-lane-valid?(lane) = std-lane?(lane) ? (std-nonempty-string?(std-lane-name(lane)) && (std-nonempty-string?(std-lane-north-star(lane)) && ((len(std-lane-surfaces(lane)) > 0) && std-surfaces-valid?(std-lane-surfaces(lane))))) : false;
    def std-lane-end-state?(lane) = std-lane-valid?(lane) ? ((Comparable) std-active-count(std-lane-surfaces(lane)) == len(std-lane-surfaces(lane))) : false;
    def std-lane-live-bp(lane) = std-lane-valid?(lane) ? std-basis-points(std-live-count(std-lane-surfaces(lane)), len(std-lane-surfaces(lane))) : 0;
    def std-lane-attention-needed?(lane) = std-lane-end-state?(lane) ? false : true;

    def std-sample-surfaces() {
        list(
            std-surface("kernels/BOOTSTRAP_COMPOST_MANIFEST.md", "static release ledger", std-successor("substrate:compost-release-ledger-cells", "form/form-stdlib/static-to-dynamic-cells.bml", "make static-to-dynamic-tending", "candidate admission + successor path + live-consumer read + proof command"), 34, 4, std-state-live(), "attention chooses transmutation work by score/category/gate"),
            std-surface("kernels/PHASE_A_FIRING_QUESTIONS.md", "static firing-question narrative", std-successor("substrate:metabolic-attestation-cells", "form/form-stdlib/static-to-dynamic-cells.bml", "make static-to-dynamic-tending", "per-cell classifier signals + successor path + proof command"), 14, 4, std-state-live(), "manual narrative walks become queueable attestations"),
            std-surface("docs/shared/agent-start-packet.md", "static compressed agent memory", std-successor("substrate:generated-agent-start-packet", "form/form-stdlib/static-to-dynamic-cells.bml", "make static-to-dynamic-tending", "start packet sections sourced from live wellness + route state + release cells"), 21, 4, std-state-live(), "agents arrive through generated live context instead of stale hand memory"),
            std-surface("docs/system_audit/native_route_goal_state.json", "static route-promotion snapshot", std-successor("substrate:native-route-goal-cells", "form/form-stdlib/native-route-goal-cells.bml", "make native-route-goal-tending", "runtime events + BML/front-door catalogs + route proof state"), 1, 4, std-state-live(), "route attention is a Form cell queue instead of a frozen JSON queue")
        );
    }

    def std-sample-lane() = std-lane("static-to-dynamic-lane", "Static memory remains source tissue while dynamic successor cells carry attention, proof, and release state.", std-sample-surfaces());

    0;
}
