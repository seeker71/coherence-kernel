// form-cli-model-ds4.fk -- DeepSeek-V4's seat at the generate and session doors: the lane switch, the prompt hook, the one-shot run, the session open, the walk's endings and the renewal's pieces, all over the Form-native Metal driver.
//
// THE LANE IS WIRED. fcds-lane-wired? is 1 and model-registry.bml's mr-lane-rows row for deepseek4 reads (dsv4, 1): the two are twins (this file cannot import the registry, which imports generate) and form-stdlib/tests/dsv4-door-band.bml
// fails when they differ. A deepseek4 file takes this seat at the session door (form-cli-model-session.fk, past the seal and the registry's row) and at the generate door (form-cli-model-generate.fk fcmg-ds4-door-with?); every
// Qwen door is what it was: fcds-route answers "qwen35" for a qwen35 file whatever the flag says. The physical witness of the lane is the validation of 2026-10-03/04 on the 80 GiB IQ2XXS file (receipts/dsv4-token-runs.jsonl,
// docs/evidence/fkwu/dsv4-token-run-*.txt); this seat calls the driver's functions and holds none of its arithmetic.
//
// THE PROMPT HOOK. The arch's tokenizer is dsv4-tokenizer.fk, read from the file's own header (the gpt2 byte-level BPE of the joyai-llm split), and a prompt is wrapped in the chat template the way the recorded references were taken
// (bml/dsv4-chat-template.bml: BOS, the system text "You are a helpful assistant", the User marker, the prompt, the Assistant marker, <think>; the 14 ids of "The capital of France is" are pinned by
// ds4-recorded-references-band). fcds-prompt-ids answers [] (never a guess) for a file whose vocabulary lacks a marker. fcds-raw-ids is the bare tokenizer (the recorded 24-token stream's five ids). The stop ids are the header's
// tokenizer.ggml.eos_token_id, and the text a run answers is the tokenizer's decode with no half character (an incomplete UTF-8 tail is written \xNN; the ids are the exact record).
//
// THE OPEN. The routed experts are never mapped whole: fcds-open-context opens the context in the ARENA mode (dsv4-open-arena, native/metal/dsv4-arena.fk: the dense tensors mapped, each layer holding dls-cache-experts experts in
// buffers allocated once, a missing expert copied from the file by its own span), the one open the token door (observe/dsv4-token-run.bml) and the validation window run. A whole-stack open made the device read every page of every
// stack a dispatch bound: on 2026-10-03 19:04 WITA the first real token read the whole 80 GiB file and pushed 27.7 GiB of other processes' memory to swap. The memory the session asks the governor for is dsv4-lease.fk's derived working set
// (dense + that arena + the KV at the session's capacity) with mg-kv-margin() private, exactly the call the Qwen door makes; a held answer opens nothing and is named host-memory-held:<reason>.
//
// THE POSITION LIMIT. The driver serves positions 0 through 2047 (fcds-indexer-limit): a ratio-4 block refuses at position 2048 and later, where the indexer stops being inert (dsv4-layer.fk, dth-pos-ok?; the 126 indexer tensors are
// in the file and not in the driver's plan). A session's capacity is the window asked for, cut to that limit (fcds-capacity) and refused when it passes the header's own context_length (as Qwen's is); a walk never runs into the refusal
// silently: it stops with a NAMED ending (fcds-gen, fcds-ending-of): "eos" (a stop id), "max-tokens" (the allowance spent), "context-limit" (the last position the capacity serves was consumed; the usage line says which position),
// "step-refused" (the driver refused a step inside the limit). fcds-usage-line states the ending and the limit.
//
// THE RUN AND THE SESSION. fcds-run is the one-shot (generate door): encode, open the driver at capacity prompt + n + 1 (cut to the limit), write the rope tables, make the state, prefill (the head asked once, at the last prompt token),
// greedy steps, close in synced rounds, decode the text. fcds-open-parts is the session open: the lease first (the injected `lease`: the governor's mg-lease at the door), then the same open, state and prefill, answered as the
// parts form-cli-model-session.fk builds its session record from. A refusal before the context exists gives the lease back here; a refusal after leaves the context and state in the record for the session's own release
// (fcms-release-ok?), as the Qwen door does. fcds-forward is the session's one step (the next id, or -1 as q38-forward answers it).
//
// THE RENEWAL (form-cli-model-renew.bml): Qwen's renewal holds a second KV state while the new prompt prefills and retires the old one. DeepSeek's is the same move over the same weights and the same arena: the KV capacity is the position
// capacity, so a renewed stream starts again at position 0 and its window is the whole limit again. fcds-fresh-state, fcds-fresh-prefill and fcds-state-release are its three driver calls.
//
// WHAT IS NOT WIRED (named): the observation crossing (typed Form observations enter Qwen's ChatML; the DeepSeek session refuses an observation, ds4-observation-not-wired), the sampler (greedy only), the draft and adapter lanes, the
// positions from 2048 (the indexer).
//
// Proven by: form-stdlib/tests/dsv4-door-band.bml (the dispatch and the twin switch, the prompt hook, the registry's row, the sidecar rule), form-stdlib/tests/dsv4-lease-band.bml (the lease figures),
// native/metal/tests/dsv4-door-run-band.bml (the open, step and one-shot on a fixture), native/metal/tests/dsv4-lane-band.bml (the whole flow through the session door on a fixture with a vocabulary).
import form-stdlib/core.fk;
import form-stdlib/str-byte-at.fk;
import form-stdlib/equireach.fk;
import form-stdlib/gguf-meta.fk;
import form-stdlib/dsv4-tokenizer.fk;
import form-stdlib/dsv4-layout.fk;
import form-stdlib/dsv4-lease.fk;
import form-stdlib/bml/form-token-decode-batch.bml;
import form-stdlib/bml/dsv4-chat-template.bml;
import form-stdlib/bml/memory-governor.bml;
import native/metal/dsv4-token-handle.fk;
section [form.bml] {
    // ---- the switch and the route ----------------------------------------------------------------------------------
    def fcds-lane-wired?() = 1;
    // the lane's name in the registry's row (model-registry.bml mr-lane-rows: deepseek4, dsv4, 1)
    def fcds-lane-name() = "dsv4";
    // "qwen35" for a qwen35 file whatever the flag says; "deepseek4" only when the flag says wired; every other case refuses with the door's own words
    def fcds-route(arch, wired) = (String) arch == "qwen35" ? "qwen35" : ((String) arch == "deepseek4" && (Comparable) wired == 1) ? "deepseek4" : "refuse";
    def fcds-lane-route(arch) = fcds-route(arch, fcds-lane-wired?());
    def fcds-lane?(arch) = (String) fcds-lane-route(arch) == "deepseek4" ? 1 : 0;

    // ---- the prompt hook ----------------------------------------------------------------------------------------------
    def fcds-system-text() = dct-system-default();
    // a header with no vocabulary has no markers to find and nothing to encode with (the decoder reads pieces at offsets the missing token array would give it: found 2026-10-03 on the fixture, which carries none, where the one-shot read forever)
    def fcds-vocab?(src) = tkz-vocab-n(src) > 0;
    def fcds-chat-ids(src, prompt) = fcds-vocab?(src) ? dct-ids(src, fcds-system-text(), prompt, true) : nothing();
    // the chat template's ids, or [] when the file's vocabulary does not hold a marker
    // an empty prompt is no turn: the template alone is not a question (the open reads zero ids and says so, as it did for the bare tokenizer's empty answer)
    def fcds-prompt-ids(src, prompt) = str_len(prompt) == 0 ? [] : fcds-ids-or-none(fcds-chat-ids(src, prompt));
    def fcds-ids-or-none(ids) = nothing?(ids) ? [] : ids;
    // the bare tokenizer: no template, no begin token (the shape the recorded 24-token stream was taken with)
    def fcds-raw-ids(src, prompt) = fcds-vocab?(src) ? tkz-encode(src, prompt) : [];
    // a file without its tokens has nothing to say the ids could be turned into; one pass over the vocabulary renders every id (form-token-decode-batch.bml, the walk Qwen's text takes)
    def fcds-text(src, ids) = fcds-vocab?(src) ? fcds-render-bytes(ftdb-bytes(src, ids)) : "";
    // THE TEXT HOLDS NO HALF CHARACTER. The ids' bytes are one run, so a character the tokens split lies whole inside it; only the run's END can stop mid-character (a walk ends between the tokens of one). The
    // bytes of an incomplete UTF-8 tail are not text: they are written out as \xNN (visible, and the ids stay the exact record) where a bare partial sequence would be a broken string. Qwen's text keeps its own renderer.
    def fcds-lead-need(b) = b >= 240 ? 4 : (b >= 224 ? 3 : (b >= 192 ? 2 : 1));
    def fcds-cont?(b) = b >= 128 && b < 192;
    // the index where an incomplete sequence at the end of bs begins, or the length when the end is whole
    def fcds-tail-start(bs, n, k) = (k > 3 || k > n) ? n : (fcds-cont?(bs[n - k]) ? fcds-tail-start(bs, n, k + 1) : (fcds-lead-need(bs[n - k]) > k ? n - k : n));
    def fcds-hex-digit(v) = substring("0123456789abcdef", v, v + 1);
    def fcds-escape-bytes(bs) = len(bs) == 0 ? "" : "\\x" ++ fcds-hex-digit(bs[0] / 16) ++ fcds-hex-digit(bs[0] % 16) ++ fcds-escape-bytes(bs[1:]);
    def fcds-render-bytes(bs) = fcds-render-cut(bs, fcds-tail-start(bs, len(bs), 1));
    def fcds-render-cut(bs, cut) = tkz-render-acc(bs[0:cut], "") ++ fcds-escape-bytes(bs[cut:]);
    def fcds-stops(src) {
        let e = gmt-u32(src, "tokenizer.ggml.eos_token_id");
        e == gmt-absent() ? [] : [e];
    }
    def fcds-context-length(src) = gmt-u32(src, "deepseek4.context_length");
    def fcds-over-context?(src, maxpos) {
        let limit = fcds-context-length(src);
        limit != gmt-absent() && maxpos > limit;
    }

    // ---- the position limit ----------------------------------------------------------------------------------------------
    // the first position the driver refuses: a ratio-4 block runs positions 0 through 2047 (dth-pos-ok?, dsv4-layer.fk); the lane band reads the driver's own refusal at 2047 and 2048 on a fixture and holds this number to it
    def fcds-indexer-limit() = 2048;
    // the positions a session or a run on this file can serve: the header's context cut to the driver's
    def fcds-served-positions(src) {
        let l = fcds-context-length(src);
        (l == gmt-absent() || l > fcds-indexer-limit()) ? fcds-indexer-limit() : l;
    }
    // the capacity a window asked for becomes: itself, or the positions the driver serves
    def fcds-capacity(src, wanted) = wanted > fcds-served-positions(src) ? fcds-served-positions(src) : wanted;
    // the capacity an opened context holds (already cut to the limit) and the last position it serves
    def fcds-capacity-of(ctx) = dso-cap(ctx);
    def fcds-last-position(ctx) = dso-cap(ctx) - 1;
    // the last position the DRIVER serves for this file (2047 on the real one): the limit a walk can never pass, whatever capacity a window asked for
    def fcds-driver-limit(src) = fcds-served-positions(src) - 1;
    // the last position a session consumed: the next to consume less one, and never past the capacity (a step refused at the limit moved the counter on without consuming)
    def fcds-consumed(pos, capacity) = (pos - 1) < (capacity - 1) ? pos - 1 : capacity - 1;
    // the driver's gaps (a tensor whose type its role has no kernel for), read from the header alone: the first one's name, or "" for none
    def fcds-first-gap(path) {
        let m = dvl-open(dvl-src(path));
        let gaps = nothing?(m) ? [] : dvl-driver-gaps(m);
        len(gaps) == 0 ? "" : gaps[0];
    }

    // ---- the walk's endings ----------------------------------------------------------------------------------------------
    // the one-shot's greedy loop: n tokens at most from `id` at `pos`, the driver's own decode and position check; answers [ids, ending]
    def fcds-gen(ctx, sts, id, pos, n, stops, acc) = n <= 0 ? [acc, "max-tokens"] : !dsv4-position-ok?(ctx, pos) ? [acc, "context-limit"] : fcds-gen-step(ctx, sts, id, pos, n, stops, acc, dsv4-decode(ctx, sts, id, pos));
    def fcds-gen-step(ctx, sts, id, pos, n, stops, acc, nid) = nothing?(nid) ? [acc, "step-refused"] : dth-stop?(nid, stops) ? [acc, "eos"] : fcds-gen(ctx, sts, nid, pos + 1, n - 1, stops, append(acc, [nid]));
    // the ending of a session's walk (fcms-walk answers [ids, pending, pos, stopped]): the pending id read as a stop id is "eos", a refused step is the limit when the position it was asked at is one the driver refuses
    def fcds-ending-of(ctx, stops, walked) = walked[3] == 0 ? "max-tokens" : (walked[1] >= 0 && dth-stop?(walked[1], stops)) ? "eos" : !dsv4-position-ok?(ctx, walked[2] - 1) ? "context-limit" : "step-refused";
    // the usage line: the counts, the ending, the last position consumed, the capacity the session holds and the driver's own limit (2047 on the real file) apart
    def fcds-usage-line(prompt-count, generated, ending, position, capacity, limit) = "usage: prompt_tokens=" ++ prompt-count.str() ++ " generated_tokens=" ++ generated.str() ++ " ending=" ++ ending ++ " position=" ++ position.str() ++ " capacity=" ++ capacity.str() ++ " position_limit=" ++ limit.str();

    // ---- the one step the session takes -------------------------------------------------------------------------------
    // the next id, or -1 (q38-forward's own word for a step that did not arrive)
    def fcds-forward(ctx, sts, id, pos) {
        let nid = dsv4-decode(ctx, sts, id, pos);
        nothing?(nid) ? 0 - 1 : nid;
    }

    // ---- the session open: [status, reason, ctx, sts, maxpos, pos, pending, prompt-count] --------------------------------------
    def fcds-parts-none(reason) = ["nothing", reason, [], [], 0, 0, 0 - 1, 0];
    // the memory lease as the door asks it: the governor's grant, keyed by the file (mg-lease: who, key, shared bytes, private bytes)
    def fcds-lease-door() = (who, key, shared, priv) => mg-lease(who, key, shared, priv);
    def fcds-open-parts(path, src, prompt, requested-maxpos, reserve) = fcds-open-parts-with(fcds-lease-door(), path, src, prompt, requested-maxpos, reserve);
    def fcds-open-parts-with(lease, path, src, prompt, requested-maxpos, reserve) {
        let ids = fcds-prompt-ids(src, prompt);
        let count = len(ids);
        let wanted = reserve > 0 ? count + reserve : requested-maxpos;
        let maxpos = fcds-capacity(src, wanted);
        let gap = count > 0 ? fcds-first-gap(path) : "";
        count <= 0 ? fcds-parts-none("initial-turn-encoded-no-ids") : (wanted <= count || fcds-over-context?(src, wanted) || maxpos <= count) ? fcds-parts-none("session-context-window-refused") : (String) gap != "" ? fcds-parts-none("model-driver-gap:" ++ gap) : fcds-open-leased-with(lease, path, ids, maxpos);
    }
    def fcds-open-leased(path, ids, maxpos) = fcds-open-leased-with(fcds-lease-door(), path, ids, maxpos);
    def fcds-open-leased-with(lease, path, ids, maxpos) {
        let shared = dls-weights-bytes-at(path, maxpos);
        let granted = lease("model session " ++ path, path, shared, mg-kv-margin());
        mg-granted?(granted) ? fcds-open-context(path, ids, maxpos) : fcds-held(path, shared, granted);
    }
    def fcds-held(path, shared, v) {
        let said = print_str(mg-line("model session " ++ path, mg-need-of(v, shared + mg-kv-margin()), v));
        fcds-parts-none("host-memory-held:" ++ v[1]);
    }
    def fcds-open-context(path, ids, maxpos) {
        let ctx = dsv4-open-arena(path, maxpos, 1, dls-cache-experts());
        len(ctx) != 13 ? fcds-unleased("model-context-open-refused") : fcds-open-state(ids, maxpos, ctx);
    }
    def fcds-unleased(reason) {
        let unleased = mg-release();
        fcds-parts-none(reason);
    }
    // a session's end: every handle of the context (its experts' arena among them) and of the state freed in synced rounds, the lease given back; the handles still held (0 is released)
    def fcds-release(ctx, sts) {
        let left = dsv4-close(ctx, sts);
        let unleased = mg-release();
        len(left);
    }
    def fcds-open-state(ids, maxpos, ctx) {
        let prepared = dsv4-prepare(ctx);
        let sts = prepared == 1 ? dsv4-new-state(ctx[2], ctx[0], maxpos) : nothing();
        nothing?(sts) ? fcds-close-unleased(ctx, "model-stream-state-refused") : fcds-prefill(ids, ctx, sts, maxpos);
    }
    def fcds-close-unleased(ctx, reason) {
        let left = dsv4-close(ctx, []);
        fcds-unleased(reason);
    }
    def fcds-prefill(ids, ctx, sts, maxpos) {
        let pf = dsv4-prefill-span-sliced(ctx, sts, ids, 0);
        nothing?(pf) ? ["nothing", "model-prefill-refused", ctx, sts, maxpos, 0, 0 - 1, len(ids)] : ["live", "opened-ds4-driver", ctx, sts, maxpos, pf[1], pf[0], len(ids)];
    }

    // ---- the one-shot (generate door): ["ok", prompt-count, ids, text, ending, last-position] or ["refused", reason] ------------------------------
    // `loaded` is called once the driver is open (the admission queue's load slot frees then, as the Qwen door frees it)
    def fcds-run(path, prompt, n, loaded) {
        let src = tkz-src(path);
        let ids = fcds-prompt-ids(src, prompt);
        let cap = fcds-capacity(src, len(ids) + n + 1);
        let gap = len(ids) > 0 ? fcds-first-gap(path) : "";
        len(ids) == 0 ? ["refused", "tokenizer produced no prompt tokens"] : (n <= 0 || fcds-over-context?(src, len(ids) + n + 1)) ? ["refused", "requested context exceeds the model limit or asks for no tokens"] : cap <= len(ids) ? ["refused", "the prompt leaves no position to answer in: the driver serves positions 0 through " ++ (fcds-served-positions(src) - 1).str()] : (String) gap != "" ? ["refused", "model driver gap: " ++ gap] : fcds-run-open(path, src, ids, n, cap, loaded);
    }
    def fcds-run-open(path, src, ids, n, cap, loaded) {
        let ctx = dsv4-open-arena(path, cap, 1, dls-cache-experts());
        let freed = loaded();
        len(ctx) != 13 ? ["refused", "model context did not open"] : fcds-run-state(src, ids, n, cap, ctx);
    }
    def fcds-run-state(src, ids, n, cap, ctx) {
        let prepared = dsv4-prepare(ctx);
        let sts = prepared == 1 ? dsv4-new-state(ctx[2], ctx[0], cap) : nothing();
        nothing?(sts) ? fcds-run-closed(dsv4-close(ctx, []), ["refused", "model stream state did not open"]) : fcds-run-walk(src, ids, n, ctx, sts);
    }
    def fcds-run-walk(src, ids, n, ctx, sts) {
        let stops = fcds-stops(src);
        let pf = dsv4-prefill-span-sliced(ctx, sts, ids, 0);
        let first = nothing?(pf) ? nothing() : pf[0];
        let stopped = nothing?(pf) ? 0 : ((len(stops) > 0 && first == stops[0]) ? 1 : 0);
        let walked = (nothing?(pf) || stopped == 1) ? [[], stopped == 1 ? "eos" : "step-refused"] : fcds-gen(ctx, sts, first, pf[1], n - 1, stops, []);
        let out = (nothing?(pf) || stopped == 1) ? [] : cons(first, walked[0]);
        let result = nothing?(pf) ? ["refused", "model prefill refused"] : ["ok", len(ids), out, fcds-text(src, out), walked[1], fcds-capacity-of(ctx), fcds-driver-limit(src)];
        fcds-run-closed(dsv4-close(ctx, sts), result);
    }
    // a run that did not release every handle is refused, never hidden
    def fcds-run-closed(left, result) = len(left) == 0 ? result : ["refused", "model handle close mismatch; " ++ left.str()];

    // ---- the renewal's driver calls ----------------------------------------------------------------------------------------
    // a second stream state over the same context: nothing when the driver refuses it
    def fcds-fresh-state(ctx) = dsv4-new-state(ctx[2], ctx[0], dso-cap(ctx));
    // the ids at positions 0...: [pending, next position] or nothing (a refusal before any enqueue leaves every cache as it was)
    def fcds-fresh-prefill(ctx, sts, ids) = dsv4-prefill-span-sliced(ctx, sts, ids, 0);
    // the handles a state holds, and its release in synced rounds (the handles still held: empty is released)
    // a second state the driver refused is nothing: it holds no handle and has none to release (the renewal's discard asks both of it)
    def fcds-state-count(sts) = nothing?(sts) ? 0 : len(dsv4-state-handles(sts));
    def fcds-state-release(sts) = nothing?(sts) ? [] : dsv4-free-state(sts);
    // the vocabulary a prompt id must lie inside
    def fcds-vocab-of(ctx) = record_get(ctx[2], "vocab");
    0;
}
