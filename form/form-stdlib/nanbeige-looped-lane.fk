; nanbeige-looped-lane.fk — executable architecture and admission knowledge.
;
; This cell does not pretend that borrowed weights are Form-native.  It makes
; the released Nanbeige4.2-3B execution shape and the local-route gate native:
; 22 unique decoder layers are applied twice, with a norm after each pass and
; loop-isolated KV cache slots.  The checkpoint remains a local-process
; challenger until an installed artifact passes parity and sealed evaluation.
;
; Source identities and the fuller analysis live in:
;   receipts/2026-07-24-nanbeige-looped-transformer-ingest.md
;
; preludes: form-stdlib/core.fk
; witnessed: 2026-07-24 -> direct-source fkwu 4095

(do
    ; Architecture is data so later checkpoints can change it without changing
    ; the executor or router law.
    ; name unique-layers loops hidden intermediate q-heads kv-heads head-dim
    ; vocab context norm-each-loop cache-isolated
    (defn nbll-architecture
        (name layers loops hidden intermediate qheads kvheads hdim vocab context norm cache)
        (list name layers loops hidden intermediate qheads kvheads hdim vocab context norm cache))
    (defn nbll-name (a) (nth a 0))
    (defn nbll-layers (a) (nth a 1))
    (defn nbll-loops (a) (nth a 2))
    (defn nbll-hidden (a) (nth a 3))
    (defn nbll-intermediate (a) (nth a 4))
    (defn nbll-qheads (a) (nth a 5))
    (defn nbll-kvheads (a) (nth a 6))
    (defn nbll-head-dim (a) (nth a 7))
    (defn nbll-vocab (a) (nth a 8))
    (defn nbll-context (a) (nth a 9))
    (defn nbll-norm-each-loop? (a) (nth a 10))
    (defn nbll-cache-isolated? (a) (nth a 11))

    (defn nbll-nanbeige42 ()
        (nbll-architecture "Nanbeige4.2-3B" 22 2 3072 10752 48 8 128
                           166144 262144 1 1))

    (defn nbll-effective-layer-applications (a)
        (mul (nbll-layers a) (nbll-loops a)))
    ; Weight-bearing decoder blocks stay unique; execution depth grows.
    (defn nbll-unique-layer-count (a) (nbll-layers a))
    (defn nbll-weight-reuse-factor (a) (nbll-loops a))
    (defn nbll-gqa-groups (a) (div (nbll-qheads a) (nbll-kvheads a)))

    ; The upstream cache index is layer_idx + loop_idx * num_hidden_layers.
    ; Isolating the slots is semantic: pass two must not attend to pass one's KV.
    (defn nbll-cache-slot (a loop-index layer-index)
        (add layer-index (mul loop-index (nbll-layers a))))
    (defn nbll-valid-index? (a loop-index layer-index)
        (if (and (ge loop-index 0) (lt loop-index (nbll-loops a)))
            (if (and (ge layer-index 0) (lt layer-index (nbll-layers a))) 1 0)
            0))

    ; A compact native executor witness. `weights` are shared data, not copied
    ; per loop. Each unique layer is the affine residual x <- x*w_i+b_i.
    ; This is an executable semantic skeleton, not the released neural model.
    (defn nbll-layer-step (x weight)
        (add (mul x (nth weight 0)) (nth weight 1)))
    (defn nbll-stack-loop (weights remaining x)
        (if (eq remaining 0) x
            (nbll-stack-loop (tail weights) (sub remaining 1)
                             (nbll-layer-step x (head weights)))))
    (defn nbll-stack (weights x)
        (nbll-stack-loop weights (len weights) x))
    (defn nbll-execute-loops (weights remaining x)
        (if (eq remaining 0) x
            (nbll-execute-loops weights (sub remaining 1)
                                (nbll-stack weights x))))

    ; Local challenger observation:
    ; installed identity-stable parity samples quality-delta-ppm
    ; memory-fit context-fit latency-fit thermal-fit license-ok
    (defn nbll-observation
        (installed stable parity samples delta memory context latency thermal license)
        (list installed stable parity samples delta memory context latency thermal license))
    (defn nbll-admissible? (o min-samples min-delta)
        (if (and (eq (nth o 0) 1) (eq (nth o 1) 1))
            (if (and (eq (nth o 2) 1) (ge (nth o 3) min-samples))
                (if (gt (nth o 4) min-delta)
                    (if (and (eq (nth o 5) 1) (eq (nth o 6) 1))
                        (if (and (eq (nth o 7) 1) (eq (nth o 8) 1))
                            (if (eq (nth o 9) 1) 1 0)
                            0)
                        0)
                    0)
                0)
            0))
    (defn nbll-route (observation incumbent min-samples min-delta)
        (if (eq (nbll-admissible? observation min-samples min-delta) 1)
            "nanbeige42-3b-local"
            incumbent))
    0)
