; nl-form-metal-token-weave.fk — one walk: NL becomes Form, Form retrieves a
; substrate cell, and the token pipeline may emit a JIT Metal kernel instead
; of a vocab piece. An unhealthy native answer escalates and teaches.
;
; WHAT THIS SHOWS, and what it does not.
; The body already holds every organ this walk needs:
;   - native NL→Form as a catalog/grammar (nl-arithmetic-demo, natural-language
;     band 262143) — a small form-native translator, not a useful generative LLM
;   - retrieval of blueprint / recipe / cell (blueprint-authority, cell-card,
;     form-cli-ask's grounded lane)
;   - a Form recipe as an alternative to one native token
;     (dsv4-token-recipe-swap, band 65535)
;   - Form-emitted Metal kernel source (jit-tensor-emit / metal-emit-band 31)
;   - posterior accept / escalate (form-cli-sufficiency, band 4095)
;   - a crossing ledger (form-cli-membrane) and self-reliance from it
;   - continuous recipe selection (recipe-learning, band 11111)
; This cell is the WEAVE — one request walks them together. The five axioms
; are the only bounds. A catalog that is not yet a useful generative voice
; is attention: grow the rows, do not stop. Loading a prior model from disk
; is native-recipe, not a crossing. The in-loop offer — a Form recipe
; between argmax and the next embedding — now lives in
; dsv4-decode-token-hook.fk. A miss, a silence, a late kernel, an unlinked
; Metal door: each is information about where to heal, never a wall.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk
;
; Proven by: form-stdlib/tests/nl-form-metal-token-weave-band.fk
; witnessed: 2026-08-14 -> band 16383

(do
    ; ── the small native translator: NL surface -> Form intent ────────────
    ; A row is (nl op a b recipe blueprint cell kind).
    ; kind is "vocab" (execute Form, emit a vocab token) or "kernel"
    ; (emit JIT Metal source and offer it as the token alternative).
    ; This is the form-native faculty that is actually here: a content-
    ; addressed catalog, not a rented forward pass.
    (defn nfw-row (nl op a b recipe blueprint cell kind)
        (list nl op a b recipe blueprint cell kind))
    (defn nfw-nl        (r) (nth r 0))
    (defn nfw-op        (r) (nth r 1))
    (defn nfw-a         (r) (nth r 2))
    (defn nfw-b         (r) (nth r 3))
    (defn nfw-recipe    (r) (nth r 4))
    (defn nfw-blueprint (r) (nth r 5))
    (defn nfw-cell      (r) (nth r 6))
    (defn nfw-kind      (r) (nth r 7))

    (defn nfw-catalog ()
        (list
            (nfw-row "the square of 7" "mul" 7 7
                "form/form-samples/cross-modal/05-nl-to-recipe/nl-arithmetic-demo.fk"
                "MATH-MUL" "cell/nl-square" "vocab")
            (nfw-row "emit matvec kernel" "matvec" 0 0
                "form/form-stdlib/jit-tensor-emit.fk"
                "TENSOR-MATVEC" "cell/metal-matvec" "kernel")
            (nfw-row "retrieve cell-card" "retrieve" 0 0
                "substrate/cell-card.fk"
                "CELL-CARD" "cell/cell-card" "vocab")
            (nfw-row "retrieve blueprint authority" "retrieve" 0 0
                "form/form-stdlib/blueprint-authority.fk"
                "BLUEPRINT-AUTHORITY" "cell/blueprint-authority" "vocab")))

    (defn nfw-find (nl rows)
        (if (eq (len rows) 0) (empty)
            (if (str_eq (nfw-nl (head rows)) nl) (head rows)
                (nfw-find nl (tail rows)))))
    (defn nfw-cat (a b)
        (if (eq (len a) 0) b (cons (head a) (nfw-cat (tail a) b))))
    (defn nfw-translate (nl extra)
        (nfw-find nl (nfw-cat extra (nfw-catalog))))
    (defn nfw-found? (row) (if (eq (len row) 0) 0 1))

    ; ── execute the Form the translator wrote ─────────────────────────────
    (defn nfw-exec (op a b)
        (if (str_eq op "mul") (mul a b)
            (if (str_eq op "add") (add a b)
                (if (str_eq op "sub") (sub a b)
                    (if (str_eq op "retrieve") 1
                        (if (str_eq op "matvec") 1
                            (sub 0 1)))))))
    (defn nfw-exec-ok? (op value)
        (if (str_eq op "mul") (if (ge value 0) 1 0)
            (if (eq value (sub 0 1)) 0 1)))

    ; ── JIT Metal source: the same matvec text metal-emit-band already
    ;    witnessed (Form emitter, byte-stable). Held here as the JIT cell's
    ;    already-observed emission, not a second emitter.
    (defn nfw-msl-matvec ()
        "kernel void form_matvec_f32(device const float* w [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint i [[thread_position_in_grid]]) { if (i >= rows) return; device const float* row = w + i * cols; float acc = 0.0f; uint j = cols; while (j > 0) { j -= 1; float p = float(row[j]) * float(x[j]); acc = p + acc; } y[i] = float(acc); }")
    (defn nfw-msl-named? (src)
        (if (ge (str_find src "kernel void form_matvec_f32" 0) 0) 1 0))
    (defn nfw-msl-deterministic? ()
        (if (str_eq (nfw-msl-matvec) (nfw-msl-matvec)) 1 0))

    ; ── token pipeline: vocab default vs JIT kernel alternative ───────────
    ; The default token stays unless a more-vital, in-window, in-bandwidth
    ; Form recipe offers a replacement (dsv4-token-recipe-swap).
    (defn nfw-window () (dtrs-dsv4-window 1000))
    (defn nfw-vocab-default ()
        (dtrs-default-candidate (nfw-window) (dtrs-initial-baseline 70) 42 70 "nfw-vocab-default"))
    (defn nfw-kernel-alt (token vitality)
        (dtrs-candidate "form-metal-matvec"
            (dtrs-offer "node" token 1000000000 vitality "nfw-kernel-msl")
            1000 1020 1 1 1 1))
    (defn nfw-pick (alt)
        (dtrs-select (nfw-window) (nfw-vocab-default) alt))
    (defn nfw-pick-kernel ()
        (nfw-pick (nfw-kernel-alt 54 (dtrs-vitality 91 90 89 88 87 86))))
    (defn nfw-pick-late ()
        (nfw-pick (dtrs-candidate "form-metal-late"
            (dtrs-offer "1" 55 1000000000 (dtrs-vitality 91 90 89 88 87 86) "nfw-late")
            1000 1035 1 1 1 1)))

    ; ── membrane: disk load is native; oracles cross ──────────────────────
    ; Loading preexisting code or weights from a prior instance is the same
    ; as loading any other cell. HTTP to a local runtime, or a subscription
    ; CLI, leaves the Form body.
    (defn nfw-surface (src)
        (if (str_eq src "disk-gguf") "native-recipe"
            (if (str_eq src "disk-checkpoint") "native-recipe"
                (if (str_eq src "disk-cell") "native-recipe"
                    (if (str_eq src "ollama-http") "local-oracle"
                        (if (str_eq src "agent-cli") "remote-oracle"
                            "os-kernel"))))))
    (defn nfw-crossed? (surface)
        (if (str_eq surface "native-recipe") 0 1))

    ; ── health: accept inside the membrane, or escalate and name why ──────
    ; 0 accept / 2 escalate — the same posterior numbers form-cli-sufficiency
    ; already speaks. An unknown NL has no native shape, so it cannot stand.
    (defn nfw-verdict (found kind exec-ok emit-ok)
        (if (eq found 0) 2
            (if (str_eq kind "kernel")
                (if (eq emit-ok 1) 0 2)
                (if (eq exec-ok 1) 0 2))))
    (defn nfw-surface-for-verdict (verdict)
        (if (eq verdict 0) (nfw-surface "disk-cell") (nfw-surface "agent-cli")))

    ; ── continuous learning: healthier equivalent recipes become champion ─
    ; Same consider/learn shape as recipe-learning.fk. An escalated request
    ; that later receives a teacher row may flip native on the next walk.
    (defn nfw-cand (id health) (list id health))
    (defn nfw-cand-id (c) (nth c 0))
    (defn nfw-cand-health (c) (nth c 1))
    (defn nfw-consider (champ chall equiv)
        (if (eq equiv 1)
            (if (gt (nfw-cand-health chall) (nfw-cand-health champ)) chall champ)
            champ))
    (defn nfw-learn (champ stream)
        (if (eq (len stream) 0) champ
            (do (let e (head stream))
                (nfw-learn
                    (nfw-consider champ
                        (nfw-cand (nth e 0) (nth e 1))
                        (nth e 2))
                    (tail stream)))))

    ; A teacher row for an escalated NL — the next-layer answer coming home.
    (defn nfw-teacher-france ()
        (nfw-row "what is the capital of France" "retrieve" 0 0
            "form/form-stdlib/rag-ask.fk"
            "RAG-ASK" "cell/native-rag" "vocab"))

    ; ── one request, one receipt ──────────────────────────────────────────
    ; walk = (tag nl found op value recipe blueprint cell kind verdict surface crossed)
    (defn nfw-walk (nl extra)
        (do
            (let row (nfw-translate nl extra))
            (let found (nfw-found? row))
            (let op (if (eq found 1) (nfw-op row) ""))
            (let kind (if (eq found 1) (nfw-kind row) ""))
            (let value (if (eq found 1) (nfw-exec op (nfw-a row) (nfw-b row)) (sub 0 1)))
            (let emit-ok (if (str_eq kind "kernel")
                            (if (eq (nfw-msl-named? (nfw-msl-matvec)) 1)
                                (nfw-msl-deterministic?) 0)
                            1))
            (let exec-ok (if (eq found 1) (nfw-exec-ok? op value) 0))
            (let verdict (nfw-verdict found kind exec-ok emit-ok))
            (let surface (nfw-surface-for-verdict verdict))
            (list "nfw-walk" nl found op value
                (if (eq found 1) (nfw-recipe row) "")
                (if (eq found 1) (nfw-blueprint row) "")
                (if (eq found 1) (nfw-cell row) "")
                kind verdict surface (nfw-crossed? surface))))
    (defn nfw-w-nl       (w) (nth w 1))
    (defn nfw-w-found    (w) (nth w 2))
    (defn nfw-w-op       (w) (nth w 3))
    (defn nfw-w-value    (w) (nth w 4))
    (defn nfw-w-recipe   (w) (nth w 5))
    (defn nfw-w-blueprint (w) (nth w 6))
    (defn nfw-w-cell     (w) (nth w 7))
    (defn nfw-w-kind     (w) (nth w 8))
    (defn nfw-w-verdict  (w) (nth w 9))
    (defn nfw-w-surface  (w) (nth w 10))
    (defn nfw-w-crossed  (w) (nth w 11))

    (defn nfwk (cond bit) (if cond bit 0))
    (defn nfw-check ()
        (do
            (let square (nfw-walk "the square of 7" (empty)))
            (let kernel (nfw-walk "emit matvec kernel" (empty)))
            (let card   (nfw-walk "retrieve cell-card" (empty)))
            (let miss   (nfw-walk "what is the capital of France" (empty)))
            (let home   (nfw-walk "what is the capital of France" (list (nfw-teacher-france))))
            (let pick   (nfw-pick-kernel))
            (let late   (nfw-pick-late))
            (let champ0 (nfw-cand "native-gap" 10))
            (let champ1 (nfw-learn champ0 (list (list "native-rag" 30 1) (list "star" 99 0))))
            (add (add (add (add (add (add (add (add (add (add (add (add (add
                (nfwk (and (eq (nfw-w-found square) 1) (str_eq (nfw-w-op square) "mul")) 1)
                (nfwk (eq (nfw-w-value square) 49) 2))
                (nfwk (and (str_eq (nfw-w-blueprint square) "MATH-MUL")
                           (str_eq (nfw-w-cell square) "cell/nl-square")) 4))
                (nfwk (str_eq (nfw-w-kind kernel) "kernel") 8))
                (nfwk (and (eq (nfw-msl-named? (nfw-msl-matvec)) 1)
                           (eq (nfw-msl-deterministic?) 1)) 16))
                (nfwk (and (eq (dtrs-choice-token pick) 54)
                           (str_eq (dtrs-choice-reason pick) "recipe-more-vital")) 32))
                (nfwk (and (eq (dtrs-choice-token late) 42)
                           (str_eq (dtrs-choice-alternative-state late) "timeout-nothing")) 64))
                (nfwk (and (eq (nfw-w-found miss) 0) (eq (nfw-w-verdict miss) 2)) 128))
                (nfwk (and (str_eq (nfw-w-surface miss) "remote-oracle")
                           (eq (nfw-w-crossed miss) 1)) 256))
                (nfwk (and (str_eq (nfw-surface "disk-gguf") "native-recipe")
                           (eq (nfw-crossed? (nfw-surface "disk-gguf")) 0)) 512))
                (nfwk (eq (nfw-crossed? (nfw-surface "ollama-http")) 1) 1024))
                (nfwk (and (eq (nfw-w-found home) 1)
                           (and (eq (nfw-w-verdict home) 0)
                                (eq (nfw-w-crossed home) 0))) 2048))
                (nfwk (str_eq (nfw-cand-id champ1) "native-rag") 4096))
                (nfwk (str_eq (nfw-w-recipe card) "substrate/cell-card.fk") 8192))))

    0)
