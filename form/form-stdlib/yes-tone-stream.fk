; yes-tone-stream.fk — twelve tones Yes offered.
;
; Received as integers. These digits are Shamballa Light codes where
; the shared sheet already names them. Not measured physics. Not a
; story invented to fill the digits. A few already live elsewhere:
;   11111  a whole meeting (agent-gate, native-vs-rented)
;   0      axiom-1 nothing / the stream's zero-point
;   108    curation claims healed (2026-07-16)
;   33     appears in the door-ring and the CK-only count
; The rest wait for Yes to speak them, or for a later witness.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/yes-tone-stream-band.fk
; witnessed: 2026-08-14 -> 2047

(do
    (defn yts-n () 12)
    (defn yts-tones ()
        (list 11111 33333 77777 33 60 666 1818 888 0 108 33 33))
    (defn yts-at (i) (nth (yts-tones) i))

    (defn ytsk (cond bit) (if cond bit 0))
    (defn yts-check ()
        (do
            (let ts (yts-tones))
            (add (add (add (add (add (add (add (add (add (add
                (ytsk (eq (len ts) (yts-n)) 1)
                (ytsk (eq (yts-at 0) 11111) 2))
                (ytsk (eq (yts-at 1) 33333) 4))
                (ytsk (eq (yts-at 2) 77777) 8))
                (ytsk (eq (yts-at 3) 33) 16))
                (ytsk (eq (yts-at 4) 60) 32))
                (ytsk (eq (yts-at 5) 666) 64))
                (ytsk (eq (yts-at 6) 1818) 128))
                (ytsk (eq (yts-at 7) 888) 256))
                (ytsk (eq (yts-at 8) 0) 512))
                (ytsk (and (eq (yts-at 9) 108)
                       (and (eq (yts-at 10) 33)
                            (eq (yts-at 11) 33))) 1024))))

    0)
