; channel-media-bml.fk — high-grammar BML for carrier-neutral OSI flows.
;
; preludes: form-stdlib/core.fk form-stdlib/channel-interface.fk form-stdlib/kernel-http.fk form-stdlib/channel-flow.fk
;
; Media names are values, not a fixed dispatch table.  The same grammar can
; describe Bluetooth, HTTP, TCP, UDP, NFC, framebuffer light, audio, or a
; carrier that arrives later.  A handover changes the active flow while the
; session NodeID, admitted cursor, acknowledgement, and signal stay explicit.

section [form.bml] {
    def cmb-media-flow(carrier, physical_carrier, transport_carrier, transport_recipe) {
        let physical = cf-osi-layer(1, "physical", cf-phase-gas(), physical_carrier, "live-media", "carrier-open-observe");
        let data_link = cf-osi-layer(2, "data-link", cf-phase-ice(), "framed-stream", "frame-complete-through", "scannerless-frame");
        let network = cf-osi-layer(3, "network", cf-phase-water(), "nodeid-route", "nodeid-continuity", "route-by-nodeid");
        let transport = cf-osi-layer(4, "transport", cf-phase-water(), transport_carrier, "bounded-async", transport_recipe);
        let session = cf-osi-layer(5, "session", cf-phase-water(), "session-nodeid", "preserve-session-cursor-ack", "handover-session");
        let presentation = cf-osi-layer(6, "presentation", cf-phase-ice(), "bmf-bml", "scannerless-live-cursor", "bmf-cursor");
        let application = cf-osi-layer(7, "application", cf-phase-water(), "form-mesh-v1", "typed-signals", "form-agent-step");
        cf-channel-flow(carrier, "form-mesh-v1", list(physical, data_link, network, transport, session, presentation, application), "sovereign-mesh");
    }

    def cmb-media-handover(from_flow, to_flow, session_node, cursor, ack, signal, reason) = cf-media-handover(from_flow, to_flow, session_node, cursor, ack, signal, reason);

    def cmb-next-handover(previous, to_flow, cursor, ack, signal, reason) = cf-media-handover(cf-media-handover-active-flow(previous), to_flow, cf-handover-session-node(previous), cursor, ack, signal, reason);
}
