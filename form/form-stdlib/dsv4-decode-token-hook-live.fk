; dsv4-decode-token-hook-live.fk — watch the hook, then let a JIT Metal
; kernel stand in for one token on this device.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk form-stdlib/dsv4-decode-token-hook.fk
;
; PROOF LEVEL: FOURTH-ARM ONLY — metal_matvec_f32 is this kernel's organ (pf-arm-mask 8, probed 2026-09-03).

(do
    (defn ddthl-nl () (byte_to_str 10))
    (defn ddthl-pow2 (k) (if (le k 0) 1 (mul 2 (ddthl-pow2 (sub k 1)))))
    (defn ddthl-e (n e) (if (lt n 2) e (ddthl-e (floor (div n 2)) (add e 1))))
    (defn ddthl-bits (n)
        (if (eq n 0) 0
            (do (let e (ddthl-e n 0))
                (let m (sub (floor (div (mul n 8388608) (ddthl-pow2 e))) 8388608))
                (add (mul (add e 127) 8388608) m))))
    (defn ddthl-u32 (v)
        (str_concat (byte_to_str (mod v 256))
        (str_concat (byte_to_str (mod (floor (div v 256)) 256))
        (str_concat (byte_to_str (mod (floor (div v 65536)) 256))
                    (byte_to_str (mod (floor (div v 16777216)) 256))))))
    (defn ddthl-f32 (n) (ddthl-u32 (ddthl-bits n)))
    (defn ddthl-seq (i n acc) (if (gt i n) acc (ddthl-seq (add i 1) n (str_concat acc (ddthl-f32 i)))))
    (defn ddthl-model ()
        (str_concat (ddthl-u32 4)
        (str_concat (ddthl-u32 4)
        (str_concat (ddthl-seq 1 16 "")
                    (ddthl-seq 1 4 "")))))
    (defn ddthl-msl ()
        (str_concat "#include <metal_stdlib>" (str_concat (ddthl-nl)
        (str_concat "using namespace metal;" (str_concat (ddthl-nl)
        (str_concat "kernel void form_fkwu_generic_matvec_f32(" (str_concat (ddthl-nl)
        (str_concat "  device const float *w [[buffer(0)]]," (str_concat (ddthl-nl)
        (str_concat "  device const float *x [[buffer(1)]]," (str_concat (ddthl-nl)
        (str_concat "  device float *y [[buffer(2)]]," (str_concat (ddthl-nl)
        (str_concat "  constant uint &rows [[buffer(3)]]," (str_concat (ddthl-nl)
        (str_concat "  constant uint &cols [[buffer(4)]]," (str_concat (ddthl-nl)
        (str_concat "  uint gid [[thread_position_in_grid]]) {" (str_concat (ddthl-nl)
        (str_concat "  if (gid >= rows) return;" (str_concat (ddthl-nl)
        (str_concat "  float a = 0.0f;" (str_concat (ddthl-nl)
        (str_concat "  for (uint j = 0; j < cols; j++) a += w[gid*cols + j] * x[j];" (str_concat (ddthl-nl)
        (str_concat "  y[gid] = a;" (str_concat (ddthl-nl)
                    "}" )))))))))))))))))))))))))))

    ; The recipe: compile+dispatch the JIT kernel. If the GPU returns the
    ; hand-checkable y, offer token 2 (more vital). Silence keeps argmax.
    (defn ddthl-gpu-reply ()
        (metal_matvec_f32 (ddthl-msl) "form_fkwu_generic_matvec_f32" (ddthl-model)))
    (defn ddthl-gpu-ok? (reply)
        (if (ge (str_find reply "y=30 70 110 150" 0) 0) 1 0))
    (defn ddthl-gpu-alt (reply)
        (if (eq (ddthl-gpu-ok? reply) 1)
            (ddth-kernel-alt 2)
            (ddth-silent-alt)))

    (print "ddth-live attestant=")
    (print (int_to_str (head (ddth-attestant))))
    (print " ")
    (print (int_to_str (head (tail (ddth-attestant)))))
    (print "\n")
    (print "ddth-live swapped=")
    (print (int_to_str (head (ddth-run (list (ddth-kernel-alt 2) (empty)) 2))))
    (print " ")
    (print (int_to_str (head (tail (ddth-run (list (ddth-kernel-alt 2) (empty)) 2)))))
    (print "\n")

    (let reply (ddthl-gpu-reply))
    (print "ddth-live metal-linked=")
    (print (if (ge (str_find reply "metal_linked=true" 0) 0) "1" "0"))
    (print "\n")
    (print "ddth-live metal-y-ok=")
    (print (int_to_str (ddthl-gpu-ok? reply)))
    (print "\n")

    (let gpu-stream (ddth-run (list (ddthl-gpu-alt reply) (empty)) 2))
    (print "ddth-live gpu-in-loop=")
    (print (int_to_str (head gpu-stream)))
    (print " ")
    (print (int_to_str (head (tail gpu-stream))))
    (print "\n")
    (print "ddth-live check=")
    (print (int_to_str (ddth-check)))
    (print "\n")
    (print reply)
    0)
