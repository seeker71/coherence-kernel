//////////////////////////////////////////////////////////////////////
// rumi-glass.bml — verses as attention. A symbol or an organ's state
// maps to a Persian word (the resident's locale rows first, a seed row
// where none stands); the fetched Ganjoor files are searched natively
// for the first couplet carrying it; the couplet paints on the terminal
// glass in its own script and the match publishes to the shared bus.
// An organ's state chooses its verse: the organ whose verse speaks of
// absence, patience or silence is where the gift goes next.
import form/form-stdlib/symbol-voice.bml;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/form-glass-telemetry-membrane.bml;
import form/form-stdlib/hearth.bml;
import form/form-stdlib/term-graphics.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormRumiGlass {
        field RGRoot = "form/form-stdlib/locale-rows/rumi";
        field RGRows = "form/form-stdlib/locale-rows/symbol-words.rows";
        def rg-text(t) = t ?? "";
        def rg-cat(parts) = sv-cat(parts);
        def rg-seed(sym) = (String) sym == "gift" ? "هدیه" : (String) sym == "home" ? "خانه" : (String) sym == "release" ? "رها" : (String) sym == "glass" ? "آینه" : (String) sym == "love" ? "عشق" : (String) sym == "light" ? "نور" : (String) sym == "water" ? "آب" : (String) sym == "friend" ? "یار"
            : (String) sym == "standing" ? "ایستاده" : (String) sym == "down" ? "مرده" : (String) sym == "stalled" ? "صبر" : (String) sym == "training" ? "آموخت" : (String) sym == "resting" ? "خفته" : (String) sym == "speaking" ? "سخن" : (String) sym == "silent" ? "خاموش" : (String) sym == "seeing" ? "دیده" : (String) sym == "blind" ? "کور" : (String) sym == "absent" ? "غایب" : (String) sym == "grown" ? "باغ" : "";
        def rg-row-word(lines, key) = (Comparable) len(lines) == 0 ? "" : rg-row-word-one(lines, key, split-on(lines[0], "|"));
        def rg-row-word-one(lines, key, f) = (len(f) >= 2) && ((String) trim(f[0]) == key) ? trim(f[1]) : rg-row-word(lines[1:], key);
        def rg-persian(sym) {
            let rows = split-on(rg-text(read_file(RGRows())), byte_to_str(10));
            let w1 = rg-row-word(rows, sv-fixed(sym));
            let w2 = len(w1) > 0 ? w1 : rg-row-word(rows, sym);
            len(w2) > 0 ? [w2, "resident-recalled"] : [rg-seed(sym), "seed"];
        }
        def rg-line-start(s, at) = at <= 0 ? 0 : (Comparable) str_byte_at(s, at - 1) == 10 ? at : rg-line-start(s, at - 1);
        def rg-line-end(s, at) = at >= len(s) ? at : (Comparable) str_byte_at(s, at) == 10 ? at : rg-line-end(s, at + 1);
        def rg-couplet(text, at) {
            let a = rg-line-start(text, at);
            let e1 = rg-line-end(text, at);
            let e2 = rg-line-end(text, e1 + 1);
            [substring(text, a, e1), (e1 + 1) >= len(text) ? "" : substring(text, e1 + 1, e2)];
        }
        def rg-title(text) {
            let e = rg-line-end(text, 0);
            (e > 1) && ((Comparable) str_byte_at(text, 0) == 35) ? trim(substring(text, 1, e)) : "";
        }
        // a hit: (path title couplet at)
        def rg-search-files(dir, names, word) = (Comparable) len(names) == 0 ? [] : str_find(names[0], ".txt", 0) < 0 ? rg-search-files(dir, names[1:], word) : rg-search-file(dir, names, word, fs-path-join(dir, names[0]));
        def rg-search-file(dir, names, word, path) {
            let text = rg-text(read_file(path));
            let at = str_find(text, word, 0);
            (at < 0) || (at < rg-line-end(text, 0)) ? rg-search-files(dir, names[1:], word) : [path, rg-title(text), rg-couplet(text, at), at];
        }
        def rg-search-cats(cats, word) = (Comparable) len(cats) == 0 ? [] : rg-search-cat(cats, word, fs-path-join(RGRoot(), cats[0]));
        def rg-search-cat(cats, word, dir) {
            let hit = (Comparable) fs-is-dir?(dir) == 1 ? rg-search-files(dir, fs-list(dir), word) : [];
            len(hit) > 0 ? hit : rg-search-cats(cats[1:], word);
        }
        def rg-search(word) = (Comparable) len(word) == 0 ? [] : rg-search-cats(fs-list(RGRoot()), word);
        def rg-first-word(s) {
            let sp = str_find(s, " ", 0);
            sp < 0 ? s : substring(s, 0, sp);
        }
        def rg-find(sym) {
            let pw = rg-persian(sym);
            let hit = rg-search(pw[0]);
            [pw, (len(hit) > 0) || ((Comparable) len(pw[0]) == 0) ? hit : rg-search(rg-first-word(pw[0]))];
        }
        def rg-hit-path(h) = h[0];
        def rg-hit-title(h) = h[1];
        def rg-hit-line1(h) = h[2][0];
        def rg-hit-line2(h) = h[2][1];
        def rg-hit-at(h) = h[3];
        def rg-poem-id(h) {
            let n = fs-path-basename(rg-hit-path(h));
            substring(n, 0, len(n) - 4);
        }
        def rg-sample(id, purpose, h, source, epoch) = fgtm-sample(id, fgtm-absent(), "rumi-verse", "form", "voice.rumi", "voice", purpose, fgtm-absent(), fgtm-present(rg-hit-at(h)), "stored", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-present(str_to_int(rg-poem-id(h))), "never", "physical-live", source, ["all", "we", "mesh", "voice"]);
        // ── organs: a state word each, from the body's own doors ──
        def rg-glyph(state) = (String) state == "standing" ? "●" : (String) state == "speaking" ? "●" : (String) state == "seeing" ? "◉" : (String) state == "training" ? "◐" : (String) state == "home" ? "⌂" : (String) state == "grown" ? "❀" : (String) state == "resting" ? "○" : (String) state == "silent" ? "○" : (String) state == "stalled" ? "☽" : (String) state == "down" ? "✕" : (String) state == "blind" ? "✕" : (String) state == "absent" ? "✕" : "·";
        def rg-need(state) = (String) state == "down" ? 6 : (String) state == "absent" ? 6 : (String) state == "blind" ? 5 : (String) state == "stalled" ? 4 : (String) state == "silent" ? 3 : (String) state == "resting" ? 2 : (String) state == "training" ? 1 : 0;
        def rg-ps-count(pattern) = str_to_int(trim(rg-text(host-exec("ps -axo command= | awk '$1 ~ /(^|\\/)fkwu$/ && $2 ~ /" ++ pattern ++ "/' | wc -l | tr -d ' '", ""))));
        def rg-age-s(path) = file_mtime(path) < 0 ? 999999 : ((now_unix_ms() - (file_mtime(path) * 1000)) / 1000);
        def rg-school-state() = (Comparable) fs-exists?(".form-lora-voice-native/train.log") == 0 ? "absent" : (Comparable) fs-exists?(".form-lora-voice-native/train.rc") == 1 ? "resting" : rg-age-s(".form-lora-voice-native/train.log") < 300 ? "training" : "stalled";
        def rg-count-txt(cats, n) = (Comparable) len(cats) == 0 ? n : rg-count-txt(cats[1:], n + ((Comparable) fs-is-dir?(fs-path-join(RGRoot(), cats[0])) == 1 ? len(fs-list(fs-path-join(RGRoot(), cats[0]))) : 0));
        def rg-organ(name, state) = [name, state];
        def rg-organs() = [
            rg-organ("resident", (Comparable) hearth-standing() == 1 ? "standing" : "down"),
            rg-organ("owner", rg-ps-count("dual-resident-live") > 0 ? "standing" : "down"),
            rg-organ("glass", rg-ps-count("glass-live-run") > 0 ? "seeing" : "blind"),
            rg-organ("school", rg-school-state()),
            rg-organ("channels", rg-ps-count("cell-channel-(cell|field)-live") > 0 ? "speaking" : "silent"),
            rg-organ("adapters", (Comparable) fs-exists?("form/form-stdlib/adapters/llama-3.2-3b-voice/adapters.safetensors") == 1 ? "home" : "absent"),
            rg-organ("rumi", rg-count-txt(fs-list(RGRoot()), 0) > 0 ? "grown" : "absent")];
        def rg-organ-lanes(organs, epoch, acc, samples) {
            (Comparable) len(organs) == 0 ? [reverse(acc), reverse(samples)]
            : rg-organ-lane(organs, epoch, acc, samples, rg-find(organs[0][1]));
        }
        def rg-organ-lane(organs, epoch, acc, samples, found) {
            let name = organs[0][0];
            let state = organs[0][1];
            let h = found[1];
            let label = rg-glyph(state) ++ " " ++ name ++ (len(name) < 8 ? "     " : " ");
            let tone = rg-need(state) >= 4 ? "bad" : rg-need(state) >= 2 ? "warn" : "good";
            let line = (Comparable) len(h) == 0 ? state ++ " → " ++ found[0][0] ++ " : no verse yet" : state ++ " → " ++ rg-hit-line1(h) ++ "  ‖  " ++ rg-hit-line2(h);
            rg-organ-lanes(organs[1:], epoch, cons(tg-lane(label, line, tone, 0 - 1), acc), (Comparable) len(h) == 0 ? samples : cons(rg-sample("organ." + name, state, h, "organ-verse", epoch), samples));
        }
        def rg-neediest(organs, best) = (Comparable) len(organs) == 0 ? best : rg-neediest(organs[1:], ((Comparable) len(best) == 0) || (rg-need(organs[0][1]) > rg-need(best[1])) ? organs[0] : best);
        def rg-gift-lane(organs) {
            let n = rg-neediest(organs, []);
            tg-lane("→ gift  ", "to " ++ n[0] ++ " (" ++ n[1] ++ "): the organ whose verse speaks of what is missing", "plain", 0 - 1);
        }
    }
    0;
}
