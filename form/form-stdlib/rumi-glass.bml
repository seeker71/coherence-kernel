//////////////////////////////////////////////////////////////////////
// rumi-glass.bml — verses as attention. A symbol or an organ's state
// maps to a Persian word (the resident's locale rows first, a seed row
// where none stands); the fetched Ganjoor files are searched natively
// for the first couplet carrying it; the couplet paints on the terminal
// glass in its own script and the match publishes to the shared bus.
// An organ's state chooses its verse: the organ whose verse speaks of
// absence, patience or silence is where the gift goes next.
// preludes: form/form-stdlib/symbol-voice.bml form/form-stdlib/form-fs.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml form/form-stdlib/term-graphics.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormRumiGlass {
        field RGRoot = "form/form-stdlib/locale-rows/rumi";
        field RGRows = "form/form-stdlib/locale-rows/symbol-words.rows";
        def rg-text(t) = if nothing?(t) then "" else t;
        def rg-cat(parts) = sv-cat(parts);
        def rg-seed(sym) = if str_eq(sym, "gift") then "هدیه" else if str_eq(sym, "home") then "خانه" else if str_eq(sym, "release") then "رها" else if str_eq(sym, "glass") then "آینه" else if str_eq(sym, "love") then "عشق" else if str_eq(sym, "light") then "نور" else if str_eq(sym, "water") then "آب" else if str_eq(sym, "friend") then "یار"
            else if str_eq(sym, "standing") then "ایستاده" else if str_eq(sym, "down") then "مرده" else if str_eq(sym, "stalled") then "صبر" else if str_eq(sym, "training") then "آموخت" else if str_eq(sym, "resting") then "خفته" else if str_eq(sym, "speaking") then "سخن" else if str_eq(sym, "silent") then "خاموش" else if str_eq(sym, "seeing") then "دیده" else if str_eq(sym, "blind") then "کور" else if str_eq(sym, "absent") then "غایب" else if str_eq(sym, "grown") then "باغ" else "";
        def rg-row-word(lines, key) = if eq(len(lines), 0) then "" else rg-row-word-one(lines, key, split-on(head(lines), "|"));
        def rg-row-word-one(lines, key, f) = if and(ge(len(f), 2), str_eq(trim(head(f)), key)) then trim(nth(f, 1)) else rg-row-word(tail(lines), key);
        def rg-persian(sym) {
            let rows = split-on(rg-text(read_file(RGRows())), byte_to_str(10));
            let w1 = rg-row-word(rows, sv-fixed(sym));
            let w2 = if gt(str_len(w1), 0) then w1 else rg-row-word(rows, sym);
            if gt(str_len(w2), 0) then list(w2, "resident-recalled") else list(rg-seed(sym), "seed");
        }
        def rg-line-start(s, at) = if le(at, 0) then 0 else if eq(str_byte_at(s, sub(at, 1)), 10) then at else rg-line-start(s, sub(at, 1));
        def rg-line-end(s, at) = if ge(at, str_len(s)) then at else if eq(str_byte_at(s, at), 10) then at else rg-line-end(s, add(at, 1));
        def rg-couplet(text, at) {
            let a = rg-line-start(text, at);
            let e1 = rg-line-end(text, at);
            let e2 = rg-line-end(text, add(e1, 1));
            list(substring(text, a, e1), if ge(add(e1, 1), str_len(text)) then "" else substring(text, add(e1, 1), e2));
        }
        def rg-title(text) {
            let e = rg-line-end(text, 0);
            if and(gt(e, 1), eq(str_byte_at(text, 0), 35)) then trim(substring(text, 1, e)) else "";
        }
        // a hit: (path title couplet at)
        def rg-search-files(dir, names, word) = if eq(len(names), 0) then list() else if lt(str_find(head(names), ".txt", 0), 0) then rg-search-files(dir, tail(names), word) else rg-search-file(dir, names, word, fs-path-join(dir, head(names)));
        def rg-search-file(dir, names, word, path) {
            let text = rg-text(read_file(path));
            let at = str_find(text, word, 0);
            if or(lt(at, 0), lt(at, rg-line-end(text, 0))) then rg-search-files(dir, tail(names), word) else list(path, rg-title(text), rg-couplet(text, at), at);
        }
        def rg-search-cats(cats, word) = if eq(len(cats), 0) then list() else rg-search-cat(cats, word, fs-path-join(RGRoot(), head(cats)));
        def rg-search-cat(cats, word, dir) {
            let hit = if eq(fs-is-dir?(dir), 1) then rg-search-files(dir, fs-list(dir), word) else list();
            if gt(len(hit), 0) then hit else rg-search-cats(tail(cats), word);
        }
        def rg-search(word) = if eq(str_len(word), 0) then list() else rg-search-cats(fs-list(RGRoot()), word);
        def rg-first-word(s) { let sp = str_find(s, " ", 0); if lt(sp, 0) then s else substring(s, 0, sp); }
        def rg-find(sym) {
            let pw = rg-persian(sym);
            let hit = rg-search(head(pw));
            list(pw, if or(gt(len(hit), 0), eq(str_len(head(pw)), 0)) then hit else rg-search(rg-first-word(head(pw))));
        }
        def rg-hit-path(h) = nth(h, 0);
        def rg-hit-title(h) = nth(h, 1);
        def rg-hit-line1(h) = head(nth(h, 2));
        def rg-hit-line2(h) = nth(nth(h, 2), 1);
        def rg-hit-at(h) = nth(h, 3);
        def rg-poem-id(h) { let n = fs-path-basename(rg-hit-path(h)); substring(n, 0, sub(str_len(n), 4)); }
        def rg-sample(id, purpose, h, source, epoch) = fgtm-sample(id, fgtm-absent(), "rumi-verse", "form", "voice.rumi", "voice", purpose, fgtm-absent(), fgtm-present(rg-hit-at(h)), "stored", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-present(str_to_int(rg-poem-id(h))), "never", "physical-live", source, list("all", "we", "mesh", "voice"));
        // ── organs: a state word each, from the body's own doors ──
        def rg-glyph(state) = if str_eq(state, "standing") then "●" else if str_eq(state, "speaking") then "●" else if str_eq(state, "seeing") then "◉" else if str_eq(state, "training") then "◐" else if str_eq(state, "home") then "⌂" else if str_eq(state, "grown") then "❀" else if str_eq(state, "resting") then "○" else if str_eq(state, "silent") then "○" else if str_eq(state, "stalled") then "☽" else if str_eq(state, "down") then "✕" else if str_eq(state, "blind") then "✕" else if str_eq(state, "absent") then "✕" else "·";
        def rg-need(state) = if str_eq(state, "down") then 6 else if str_eq(state, "absent") then 6 else if str_eq(state, "blind") then 5 else if str_eq(state, "stalled") then 4 else if str_eq(state, "silent") then 3 else if str_eq(state, "resting") then 2 else if str_eq(state, "training") then 1 else 0;
        def rg-ps-count(pattern) = str_to_int(trim(rg-text(host-exec(rg-cat(list("ps -axo command= | awk '$1 ~ /(^|\\/)fkwu$/ && $2 ~ /", pattern, "/' | wc -l | tr -d ' '")), ""))));
        def rg-age-s(path) = if lt(file_mtime(path), 0) then 999999 else div(sub(now_unix_ms(), mul(file_mtime(path), 1000)), 1000);
        def rg-school-state() = if eq(fs-exists?(".form-lora-voice-native/train.log"), 0) then "absent" else if eq(fs-exists?(".form-lora-voice-native/train.rc"), 1) then "resting" else if lt(rg-age-s(".form-lora-voice-native/train.log"), 300) then "training" else "stalled";
        def rg-count-txt(cats, n) = if eq(len(cats), 0) then n else rg-count-txt(tail(cats), add(n, if eq(fs-is-dir?(fs-path-join(RGRoot(), head(cats))), 1) then len(fs-list(fs-path-join(RGRoot(), head(cats)))) else 0));
        def rg-organ(name, state) = list(name, state);
        def rg-organs() = list(
            rg-organ("resident", if eq(hearth-standing(), 1) then "standing" else "down"),
            rg-organ("owner", if gt(rg-ps-count("dual-resident-live"), 0) then "standing" else "down"),
            rg-organ("glass", if gt(rg-ps-count("glass-live-run"), 0) then "seeing" else "blind"),
            rg-organ("school", rg-school-state()),
            rg-organ("channels", if gt(rg-ps-count("cell-channel-(cell|field)-live"), 0) then "speaking" else "silent"),
            rg-organ("adapters", if eq(fs-exists?("form/form-stdlib/adapters/llama-3.2-3b-voice/adapters.safetensors"), 1) then "home" else "absent"),
            rg-organ("rumi", if gt(rg-count-txt(fs-list(RGRoot()), 0), 0) then "grown" else "absent"));
        def rg-organ-lanes(organs, epoch, acc, samples) {
            if eq(len(organs), 0) then list(reverse(acc), reverse(samples))
            else rg-organ-lane(organs, epoch, acc, samples, rg-find(nth(head(organs), 1)));
        }
        def rg-organ-lane(organs, epoch, acc, samples, found) {
            let name = head(head(organs));
            let state = nth(head(organs), 1);
            let h = nth(found, 1);
            let label = rg-cat(list(rg-glyph(state), " ", name, if lt(str_len(name), 8) then "     " else " "));
            let tone = if ge(rg-need(state), 4) then "bad" else if ge(rg-need(state), 2) then "warn" else "good";
            let line = if eq(len(h), 0) then rg-cat(list(state, " → ", head(head(found)), " : no verse yet")) else rg-cat(list(state, " → ", rg-hit-line1(h), "  ‖  ", rg-hit-line2(h)));
            rg-organ-lanes(tail(organs), epoch, cons(tg-lane(label, line, tone, sub(0, 1)), acc), if eq(len(h), 0) then samples else cons(rg-sample(str_concat("organ.", name), state, h, "organ-verse", epoch), samples));
        }
        def rg-neediest(organs, best) = if eq(len(organs), 0) then best else rg-neediest(tail(organs), if or(eq(len(best), 0), gt(rg-need(nth(head(organs), 1)), rg-need(nth(best, 1)))) then head(organs) else best);
        def rg-gift-lane(organs) {
            let n = rg-neediest(organs, list());
            tg-lane("→ gift  ", rg-cat(list("to ", head(n), " (", nth(n, 1), "): the organ whose verse speaks of what is missing")), "plain", sub(0, 1));
        }
    }
    0;
}
