; grok-host-learn.fk — host Grok turns enter the session learner.
;
; It can. nsm-record retains a caller-teaching example from a host turn.
; Prompt and completion stay in the private home. Stdout carries identities
; and hashes, never the prose. Drain/kick is a later GPU sitting.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/json.fk
; preludes: form-stdlib/native-session-memory.bml
; witnessed: 2026-09-10 -> grok-host-learn-band 15

(do
    (defn ghl-can () 1)
    (defn ghl-route () "grok-host")
    (defn ghl-pair (path) (parse-json "grok-host-pair" (read_file path)))
    (defn ghl-str (doc k) (nsm-str doc k))
    (defn ghl-record (home path)
        (do
            (let doc (ghl-pair path))
            (nsm-record home (ghl-str doc "session") (ghl-str doc "event")
                (ghl-route) (ghl-str doc "prompt") (ghl-str doc "completion")
                "caller-teaching" "host-turn-intercept" 0)))
    (defn ghl-objective (home dir)
        (nsm-str (nsm-json (nsm-at dir "record.json")) "objective"))
    0)
