// native-model-native-hierarchy.fk — native-first text generation routing.
//
// Engine presence, artifact presence, and observed execution are deliberately
// separate.  A large model file plus a native executable is not an executable
// lane until that exact pairing has answered.  Network/carrier lanes can remain
// useful comparators without outranking direct Metal.
//
// witnessed: 2026-07-26 -> direct Metal Llama executable; DS4's full artifact
// has 1406/1406 byte layouts and arithmetic understood by Form but no complete
// decoded-token witness; Nanbeige has a proven direct-Metal weight foundation but its
// full two-loop graph is not yet exposed through a native walker port.
// witnessed: 2026-08-31 -> Qwen3.8 Flash Next UD-Q2_K_XL has a complete
// no-server Form/Metal tokenizer, resident state, prefill, two-token parity,
// decode, substate lookup, and generation path. It is execution-ready as an
// explicit reasoning fallback while its 90% performance gate remains failing.
section [form.bml] {
    def nmnh-row(id, engine, artifact, engine-ready, artifact-ready, execution-ready, direct-metal, membrane, priority, status) = ["native-model-native-hierarchy", id, engine, artifact, engine-ready, artifact-ready, execution-ready, direct-metal, membrane, priority, status];
    def nmnh-id(row) = row[1];
    def nmnh-engine-ready?(row) = row[4];
    def nmnh-artifact-ready?(row) = row[5];
    def nmnh-execution-ready?(row) = row[6];
    def nmnh-direct-metal?(row) = row[7];
    def nmnh-membrane?(row) = row[8];
    def nmnh-priority(row) = row[9];
    def nmnh-status(row) = row[10];
    def nmnh-ready?(row, allow-membrane) = (Comparable) nmnh-engine-ready?(row) == 1 && ((Comparable) nmnh-artifact-ready?(row) == 1 && ((Comparable) nmnh-execution-ready?(row) == 1 && ((Comparable) nmnh-membrane?(row) == 0 || (Comparable) allow-membrane == 1)));
    def nmnh-better(a, b, allow-membrane) = !nmnh-ready?(a, allow-membrane) ? b : !nmnh-ready?(b, allow-membrane) ? a : nmnh-direct-metal?(a) > nmnh-direct-metal?(b) ? a : nmnh-direct-metal?(a) < nmnh-direct-metal?(b) ? b : nmnh-priority(a) >= nmnh-priority(b) ? a : b;
    def nmnh-select-loop(rows, best, allow-membrane) = (Comparable) len(rows) == 0 ? best : nmnh-select-loop(tail(rows), nmnh-better(head(rows), best, allow-membrane), allow-membrane);
    def nmnh-none() = nmnh-row("none", "none", "none", 0, 0, 0, 0, 0, 0, "unavailable");
    def nmnh-select(rows, allow-membrane) = nmnh-select-loop(rows, nmnh-none(), allow-membrane);
    def nmnh-observed-local-rows() = [nmnh-row("deepseek.ds4-metal", "ds4@efdadd41e20134af4f3381e1ed90e96fe4faef6f", "ds4flash-v5mx-reap25-type40-type41:91321404640", 1, 1, 0, 1, 0, 100, "layout-native:1406-of-1406;arithmetic-native:1406-of-1406;stack-and-exit-observed:43-of-43@473-gates;token-id:19129;autoregressive-kv-loop-pending"), nmnh-row("llama32.form-metal", "form-native-metal-first-token", "sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff", 1, 1, 1, 1, 0, 90, "observed:direct-metal-decoded-autoregressive-text"), nmnh-row("challenger.qwen38-flash-next-q2-metal", "form-native-qwen4exp-flash-next-token-handle", "Qwen3.8-Flash-Next-UD-Q2_K_XL:three-shard-digests-pending", 1, 1, 1, 1, 0, 80, "observed:no-server-two-token-parity;tokenizer-state-prefill-decode-generate-substate-ready;performance:failing-90pct-gate"), nmnh-row("nanbeige42.form-metal", "form-native-looped-transformer-metal", "sha256-9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104", 0, 1, 0, 1, 0, 95, "metal-weight-foundation-observed;pending:native-quantized-metal-execution-port"), nmnh-row("nanbeige42.llamacpp-comparator", "llama.cpp-nanbeige42@d28da865bf284acaecc98ad18a3c1f607c0fd754", "sha256-9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104", 1, 1, 1, 0, 1, 10, "observed:diagnostic-loopback-comparator")];
    def nmnh-default-id() = nmnh-id(nmnh-select(nmnh-observed-local-rows(), 0));
    def nmnh-comparator-id() = nmnh-id(nmnh-select(nmnh-observed-local-rows(), 1));
    def nmnh-find-id(id, rows) = (Comparable) len(rows) == 0 ? nmnh-none() : (String) id == nmnh-id(head(rows)) ? head(rows) : nmnh-find-id(id, tail(rows));
    // Role-specific routing does not rewrite the generic priority order. The
    // 3B stays the ingress model; Qwen is admitted only at the explicit
    // reasoning-fallback seam.
    def nmnh-ingress-id() = {
        let row = nmnh-find-id("llama32.form-metal", nmnh-observed-local-rows());
        nmnh-ready?(row, 0) ? nmnh-id(row) : "none";
    };
    def nmnh-reasoning-fallback-id() = {
        let row = nmnh-find-id("challenger.qwen38-flash-next-q2-metal", nmnh-observed-local-rows());
        nmnh-ready?(row, 0) ? nmnh-id(row) : "none";
    };
    0;
}
