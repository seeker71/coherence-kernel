; native-model-native-hierarchy.fk — native-first text generation routing.
;
; Engine presence, artifact presence, and observed execution are deliberately
; separate.  A large model file plus a native executable is not an executable
; lane until that exact pairing has answered.  Network/carrier lanes can remain
; useful comparators without outranking direct Metal.
;
; witnessed: 2026-07-26 -> direct Metal Llama executable; DS4's full artifact
; has 1406/1406 byte layouts and arithmetic understood by Form but no complete
; decoded-token witness; Nanbeige has a proven direct-Metal weight foundation but its
; full two-loop graph is not yet exposed through a native walker port.

(do
    (defn nmnh-row (id engine artifact engine-ready artifact-ready execution-ready direct-metal membrane priority status)
        (list "native-model-native-hierarchy" id engine artifact engine-ready artifact-ready
            execution-ready direct-metal membrane priority status))

    (defn nmnh-id (row) (nth row 1))
    (defn nmnh-engine-ready? (row) (nth row 4))
    (defn nmnh-artifact-ready? (row) (nth row 5))
    (defn nmnh-execution-ready? (row) (nth row 6))
    (defn nmnh-direct-metal? (row) (nth row 7))
    (defn nmnh-membrane? (row) (nth row 8))
    (defn nmnh-priority (row) (nth row 9))
    (defn nmnh-status (row) (nth row 10))

    (defn nmnh-ready? (row allow-membrane)
        (and
            (eq (nmnh-engine-ready? row) 1)
            (and
                (eq (nmnh-artifact-ready? row) 1)
                (and
                    (eq (nmnh-execution-ready? row) 1)
                    (or
                        (eq (nmnh-membrane? row) 0)
                        (eq allow-membrane 1))))))

    (defn nmnh-better (a b allow-membrane)
        (if (not (nmnh-ready? a allow-membrane)) b
            (if (not (nmnh-ready? b allow-membrane)) a
                (if (gt (nmnh-direct-metal? a) (nmnh-direct-metal? b)) a
                    (if (lt (nmnh-direct-metal? a) (nmnh-direct-metal? b)) b
                        (if (ge (nmnh-priority a) (nmnh-priority b)) a b))))))

    (defn nmnh-select-loop (rows best allow-membrane)
        (if (eq (len rows) 0) best
            (nmnh-select-loop (tail rows)
                (nmnh-better (head rows) best allow-membrane)
                allow-membrane)))

    (defn nmnh-none ()
        (nmnh-row "none" "none" "none" 0 0 0 0 0 0 "unavailable"))

    (defn nmnh-select (rows allow-membrane)
        (nmnh-select-loop rows (nmnh-none) allow-membrane))

    (defn nmnh-observed-local-rows ()
        (list
            (nmnh-row
                "deepseek.ds4-metal"
                "ds4@efdadd41e20134af4f3381e1ed90e96fe4faef6f"
                "ds4flash-v5mx-reap25-type40-type41:91321404640"
                1 1 0 1 0 100
                "layout-native:1406-of-1406;arithmetic-native:1406-of-1406;full-token-pending")
            (nmnh-row
                "llama32.form-metal"
                "form-native-metal-first-token"
                "sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff"
                1 1 1 1 0 90
                "observed:direct-metal-decoded-autoregressive-text")
            (nmnh-row
                "nanbeige42.form-metal"
                "form-native-looped-transformer-metal"
                "sha256-9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104"
                0 1 0 1 0 95
                "metal-weight-foundation-observed;pending:native-quantized-metal-execution-port")
            (nmnh-row
                "nanbeige42.llamacpp-comparator"
                "llama.cpp-nanbeige42@d28da865bf284acaecc98ad18a3c1f607c0fd754"
                "sha256-9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104"
                1 1 1 0 1 10
                "observed:diagnostic-loopback-comparator")))

    (defn nmnh-default-id ()
        (nmnh-id (nmnh-select (nmnh-observed-local-rows) 0)))

    (defn nmnh-comparator-id ()
        (nmnh-id (nmnh-select (nmnh-observed-local-rows) 1)))

    0)
