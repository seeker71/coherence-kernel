; hd-core-words.fk — the bodygraph said in the body's own closed vocabulary.
;
; core-lexicon.fk holds 64 words that define themselves, and its reason to
; exist is cl-closed?: every definition is written from those 64 plus twelve
; declared glue words, and the check walks every token. "A dictionary that
; needs a 65th word to explain its 64 has not grounded anything — it has
; deferred."
;
; The same discipline, applied to Human Design. Every centre, type and
; authority below is described as a TOKEN LIST drawn from that same closed
; vocabulary — not from Human Design's own jargon, and not from English at
; large. The readable sentence is the join; the tokens are the thing checked.
; hcw-closed? walks every description and finds each token in the 64 or in the
; declared glue, exactly as cl-closed? does for the lexicon itself.
;
; WHY THIS MATTERS HERE. A Human Design reading normally explains one private
; vocabulary with another — "sacral authority" becomes "your gut response",
; which becomes "your instinctive knowing", and nothing ever touches ground.
; Held to 64 self-defining words, a centre has to say what it actually does or
; fail the check. Several descriptions below are worse prose than the standard
; ones and truer for it; "what you want is not the same now and then" is the
; emotional wave with no word in it that needs a further gloss.
;
; The descriptions are ATTESTED meanings rendered in this vocabulary, held in
; the belief lane: they say what the tradition holds a centre to be, never that
; the tradition is measured.
;
; preludes: form-stdlib/core.fk form-stdlib/core-lexicon.fk form-stdlib/hd-bodygraph.fk
;
; Proven by: form-stdlib/tests/hd-core-words-band.fk

(do
    ;; A row carries its KIND, and that is not decoration. "ego" is both a
    ;; centre and an authority, and "sacral" likewise — the same surface word
    ;; standing for two different things, which is exactly the collision
    ;; cognition/depth-query-lanes.fk exists to make unrepresentable. A first
    ;; draft here keyed on the word alone and quietly answered the centre when
    ;; asked for the authority. Two kinds, two lookups, no shared key.
    (defn hcw-k-centre () 1)
    (defn hcw-k-type () 2)
    (defn hcw-k-authority () 3)
    (defn hcw-row (kind key tokens) (list kind key tokens))
    (defn hcw-kind (r) (nth r 0))
    (defn hcw-key (r) (nth r 1))
    (defn hcw-tokens (r) (nth r 2))

    ;; ── the nine centres ────────────────────────────────────────────
    (defn hcw-centres ()
        (list
            (hcw-row (hcw-k-centre) "head" (list "you" "want" "to" "know" "why"))
            (hcw-row (hcw-k-centre) "ajna" (list "you" "make" "a" "way" "to" "know"))
            (hcw-row (hcw-k-centre) "throat" (list "you" "say" "what" "you" "know"))
            (hcw-row (hcw-k-centre) "g" (list "you" "know" "who" "you" "are"))
            (hcw-row (hcw-k-centre) "ego" (list "you" "say" "what" "you" "want" "and" "do" "it"))
            (hcw-row (hcw-k-centre) "sacral" (list "you" "do" "and" "do" "again"))
            (hcw-row (hcw-k-centre) "solar-plexus"
                (list "what" "you" "want" "is" "not" "the" "same" "now" "and" "then"))
            (hcw-row (hcw-k-centre) "spleen" (list "you" "know" "here" "and" "now"))
            (hcw-row (hcw-k-centre) "root" (list "some" "thing" "make" "you" "do" "now"))))

    ;; ── the five types ──────────────────────────────────────────────
    (defn hcw-types ()
        (list
            (hcw-row (hcw-k-type) "generator" (list "you" "do" "after" "they" "say"))
            (hcw-row (hcw-k-type) "manifesting-generator"
                (list "you" "do" "after" "they" "say" "and" "you" "make" "it"))
            (hcw-row (hcw-k-type) "manifestor" (list "you" "make" "and" "then" "you" "say"))
            (hcw-row (hcw-k-type) "projector" (list "you" "know" "how" "other" "do"))
            (hcw-row (hcw-k-type) "reflector" (list "you" "are" "like" "all" "other"))))

    ;; ── the seven authorities ───────────────────────────────────────
    ;; The authorities speak in the FIRST person and the centres in the second,
    ;; and that is a claim about the things, not a style: a centre is something
    ;; you HAVE and can be told about, while an authority is the one voice you
    ;; cannot outsource. The word "I" makes the difference sayable — it is one
    ;; of the 64, and an earlier draft of this cell missed it because the hand
    ;; that read the lexicon dropped every word outside a-z, losing "I", "0"
    ;; and "1" (axiom-1's own two states). A blind reader counted the list and
    ;; found 61 where 64 were promised. The count was the catch.
    (defn hcw-authorities ()
        (list
            (hcw-row (hcw-k-authority) "emotional" (list "I" "know" "after" "not" "now"))
            (hcw-row (hcw-k-authority) "sacral" (list "I" "do" "or" "I" "do" "not" "now"))
            (hcw-row (hcw-k-authority) "splenic" (list "I" "know" "now" "and" "never" "again"))
            (hcw-row (hcw-k-authority) "ego" (list "I" "want" "it" "and" "I" "do" "it"))
            (hcw-row (hcw-k-authority) "self-projected" (list "I" "say" "it" "then" "I" "know" "who" "I" "am"))
            (hcw-row (hcw-k-authority) "mental" (list "I" "say" "to" "other" "then" "I" "know"))
            (hcw-row (hcw-k-authority) "lunar" (list "I" "know" "after" "all" "of" "it" "never" "now"))))

    (defn hcw-app (a b) (if (eq (len a) 0) b (cons (head a) (hcw-app (tail a) b))))
    (defn hcw-rows ()
        (hcw-app (hcw-centres) (hcw-app (hcw-types) (hcw-authorities))))
    (defn hcw-row-count () (len (hcw-rows)))

    ;; ── THE CLOSURE CHECK, the cell's reason to exist ───────────────
    ;; a token counts as grounded when it is one of the 64 or declared glue
    (defn hcw-in-core-loop (ls t)
        (if (eq (len ls) 0) 0
            (if (str_eq (cl-word (head ls)) t) 1 (hcw-in-core-loop (tail ls) t))))
    (defn hcw-in-glue-loop (gs t)
        (if (eq (len gs) 0) 0
            (if (str_eq (head gs) t) 1 (hcw-in-glue-loop (tail gs) t))))
    (defn hcw-grounded? (t)
        (if (eq (hcw-in-core-loop (cl-lexicon) t) 1) 1
            (hcw-in-glue-loop (cl-glue) t)))
    (defn hcw-outside-tokens-loop (ts acc)
        (if (eq (len ts) 0) acc
            (hcw-outside-tokens-loop (tail ts)
                (if (eq (hcw-grounded? (head ts)) 1) acc
                    (append acc (list (head ts)))))))
    (defn hcw-outside-loop (rs acc)
        (if (eq (len rs) 0) acc
            (hcw-outside-loop (tail rs)
                (hcw-outside-tokens-loop (hcw-tokens (head rs)) acc))))
    (defn hcw-outside () (hcw-outside-loop (hcw-rows) (list)))
    (defn hcw-outside-count () (len (hcw-outside)))
    (defn hcw-closed? () (if (eq (hcw-outside-count) 0) 1 0))

    ;; ── lookup, and honest absence ──────────────────────────────────
    (defn hcw-find-loop (rs kind k)
        (if (eq (len rs) 0) (nothing)
            (if (and (eq (hcw-kind (head rs)) kind) (str_eq (hcw-key (head rs)) k))
                (hcw-tokens (head rs))
                (hcw-find-loop (tail rs) kind k))))
    (defn hcw-say (kind k) (hcw-find-loop (hcw-rows) kind k))
    (defn hcw-join-loop (ts acc)
        (if (eq (len ts) 0) acc
            (hcw-join-loop (tail ts)
                (if (str_eq acc "") (head ts)
                    (str_concat acc (str_concat " " (head ts)))))))
    (defn hcw-sentence (kind k)
        (do (let ts (hcw-say kind k))
            (if (nothing? ts) (nothing) (hcw-join-loop ts ""))))

    ;; every centre this cell describes is one the bodygraph actually has
    (defn hcw-centre-cover-loop (cl)
        (if (eq (len cl) 0) 1
            (if (nothing? (hcw-say (hcw-k-centre) (hdb-centre-name (head cl)))) 0
                (hcw-centre-cover-loop (tail cl)))))
    (defn hcw-covers-centres? () (hcw-centre-cover-loop (hdb-centres)))

    ;; the collision, stated as a law: "ego" and "sacral" name a centre AND an
    ;; authority, and the two must answer different things.
    (defn hcw-kinds-disjoint? ()
        (if (str_eq (hcw-sentence (hcw-k-centre) "ego")
                    (hcw-sentence (hcw-k-authority) "ego")) 0
            (if (str_eq (hcw-sentence (hcw-k-centre) "sacral")
                        (hcw-sentence (hcw-k-authority) "sacral")) 0 1)))
    0)
