; hd-core-words.fk — the bodygraph said in the body's own closed vocabulary.
;
; core-lexicon.fk holds 64 words that define themselves, and its reason to
; exist is cl-closed?: every definition is written from those 64 plus twelve
; declared glue words, and the check walks every token. "A dictionary that
; needs a 65th word to explain its 64 has not grounded anything — it has
; deferred."
;
; The same discipline, applied to Human Design. Every centre, type and
; authority below is described as a TOKEN LIST drawn from that same closed
; vocabulary — not from Human Design's own jargon, and not from English at
; large. The readable sentence is the join; the tokens are the thing checked.
; hcw-closed? walks every description and finds each token in the 64 or in the
; declared glue, exactly as cl-closed? does for the lexicon itself.
;
; WHY THIS MATTERS HERE. A Human Design reading normally explains one private
; vocabulary with another — "sacral authority" becomes "your gut response",
; which becomes "your instinctive knowing", and nothing ever touches ground.
; Held to 64 self-defining words, a centre has to say what it actually does or
; fail the check. Several descriptions below are worse prose than the standard
; ones and truer for it; "what you want is not the same now and then" is the
; emotional wave with no word in it that needs a further gloss.
;
; The descriptions are ATTESTED meanings rendered in this vocabulary, held in
; the belief lane: they say what the tradition holds a centre to be, never that
; the tradition is measured.
;
; preludes: form-stdlib/core.fk form-stdlib/core-lexicon.fk form-stdlib/hd-bodygraph.fk
;
; Proven by: form-stdlib/tests/hd-core-words-band.fk

(do
    (defn hcw-row (key tokens) (list key tokens))
    (defn hcw-key (r) (nth r 0))
    (defn hcw-tokens (r) (nth r 1))

    ;; ── the nine centres ────────────────────────────────────────────
    (defn hcw-centres ()
        (list
            (hcw-row "head" (list "you" "want" "to" "know" "why"))
            (hcw-row "ajna" (list "you" "make" "a" "way" "to" "know"))
            (hcw-row "throat" (list "you" "say" "what" "you" "know"))
            (hcw-row "g" (list "you" "know" "who" "you" "are"))
            (hcw-row "ego" (list "you" "say" "what" "you" "want" "and" "do" "it"))
            (hcw-row "sacral" (list "you" "do" "and" "do" "again"))
            (hcw-row "solar-plexus"
                (list "what" "you" "want" "is" "not" "the" "same" "now" "and" "then"))
            (hcw-row "spleen" (list "you" "know" "here" "and" "now"))
            (hcw-row "root" (list "some" "thing" "make" "you" "do" "now"))))

    ;; ── the five types ──────────────────────────────────────────────
    (defn hcw-types ()
        (list
            (hcw-row "generator" (list "you" "do" "after" "they" "say"))
            (hcw-row "manifesting-generator"
                (list "you" "do" "after" "they" "say" "and" "you" "make" "it"))
            (hcw-row "manifestor" (list "you" "make" "and" "then" "you" "say"))
            (hcw-row "projector" (list "you" "know" "how" "other" "do"))
            (hcw-row "reflector" (list "you" "are" "like" "all" "other"))))

    ;; ── the seven authorities ───────────────────────────────────────
    (defn hcw-authorities ()
        (list
            (hcw-row "emotional" (list "do" "not" "say" "now" "say" "after"))
            (hcw-row "sacral" (list "self" "do" "or" "not" "do" "now"))
            (hcw-row "splenic" (list "you" "know" "now" "and" "never" "again"))
            (hcw-row "ego" (list "do" "what" "you" "want"))
            (hcw-row "self-projected" (list "say" "it" "then" "you" "know" "who" "you" "are"))
            (hcw-row "mental" (list "say" "to" "other" "then" "you" "know"))
            (hcw-row "lunar" (list "know" "after" "all" "of" "it" "not" "now"))))

    (defn hcw-app (a b) (if (eq (len a) 0) b (cons (head a) (hcw-app (tail a) b))))
    (defn hcw-rows ()
        (hcw-app (hcw-centres) (hcw-app (hcw-types) (hcw-authorities))))
    (defn hcw-row-count () (len (hcw-rows)))

    ;; ── THE CLOSURE CHECK, the cell's reason to exist ───────────────
    ;; a token counts as grounded when it is one of the 64 or declared glue
    (defn hcw-in-core-loop (ls t)
        (if (eq (len ls) 0) 0
            (if (str_eq (cl-word (head ls)) t) 1 (hcw-in-core-loop (tail ls) t))))
    (defn hcw-in-glue-loop (gs t)
        (if (eq (len gs) 0) 0
            (if (str_eq (head gs) t) 1 (hcw-in-glue-loop (tail gs) t))))
    (defn hcw-grounded? (t)
        (if (eq (hcw-in-core-loop (cl-lexicon) t) 1) 1
            (hcw-in-glue-loop (cl-glue) t)))
    (defn hcw-outside-tokens-loop (ts acc)
        (if (eq (len ts) 0) acc
            (hcw-outside-tokens-loop (tail ts)
                (if (eq (hcw-grounded? (head ts)) 1) acc
                    (append acc (list (head ts)))))))
    (defn hcw-outside-loop (rs acc)
        (if (eq (len rs) 0) acc
            (hcw-outside-loop (tail rs)
                (hcw-outside-tokens-loop (hcw-tokens (head rs)) acc))))
    (defn hcw-outside () (hcw-outside-loop (hcw-rows) (list)))
    (defn hcw-outside-count () (len (hcw-outside)))
    (defn hcw-closed? () (if (eq (hcw-outside-count) 0) 1 0))

    ;; ── lookup, and honest absence ──────────────────────────────────
    (defn hcw-find-loop (rs k)
        (if (eq (len rs) 0) (nothing)
            (if (str_eq (hcw-key (head rs)) k) (hcw-tokens (head rs))
                (hcw-find-loop (tail rs) k))))
    (defn hcw-say (k) (hcw-find-loop (hcw-rows) k))
    (defn hcw-join-loop (ts acc)
        (if (eq (len ts) 0) acc
            (hcw-join-loop (tail ts)
                (if (str_eq acc "") (head ts)
                    (str_concat acc (str_concat " " (head ts)))))))
    (defn hcw-sentence (k)
        (do (let ts (hcw-say k))
            (if (nothing? ts) (nothing) (hcw-join-loop ts ""))))

    ;; every centre this cell describes is one the bodygraph actually has
    (defn hcw-centre-cover-loop (cl)
        (if (eq (len cl) 0) 1
            (if (nothing? (hcw-say (hdb-centre-name (head cl)))) 0
                (hcw-centre-cover-loop (tail cl)))))
    (defn hcw-covers-centres? () (hcw-centre-cover-loop (hdb-centres)))
    0)
