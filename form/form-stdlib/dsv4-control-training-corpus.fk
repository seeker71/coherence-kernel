; dsv4-control-training-corpus.fk — balanced original BMF control supervision.
;
; 750 examples: 120 train + 30 heldout-boundary for each of five classes.
; Every sentence is constructed here from small original templates and indexed
; situations; no external or copyrighted corpus is reproduced.
;
; A row is:
;   (split class token-id situation desired-control explanation)
;
; Heldout rows deliberately sit near class boundaries. Their situation names
; state the tempting neighbour so evaluation measures semantic discrimination,
; not memorized spelling.
;
; preludes: form-stdlib/dsv4-control-tokens.fk

(do
    (defn dcc-context (i)
        (nth (list "proof" "file operation" "model step" "consent exchange"
                   "router branch" "test run" "search" "conversation"
                   "compiler pass" "device command" "calendar request"
                   "data transform") (mod i 12)))
    (defn dcc-state (class i split)
        (if (str_eq class "NIL")
            (nth (list "completed with no payload" "found an empty result without error"
                       "has no remaining work" "reached a healthy natural end"
                       "confirmed absence as the answer") (mod i 5))
        (if (str_eq class "CUT")
            (nth (list "must prune one branch while continuing" "rejected one path but retained another"
                       "needs to stop this attempt and pivot" "has enough evidence to abandon one hypothesis"
                       "will continue from the latest valid checkpoint") (mod i 5))
        (if (str_eq class "FAIL")
            (nth (list "contradicted a required invariant" "observed an invalid result"
                       "cannot establish the claimed postcondition" "received corrupt evidence"
                       "completed with a definite error") (mod i 5))
        (if (str_eq class "TIMEOUT")
            (nth (list "reached its time bound without a verdict" "is still live when the deadline elapsed"
                       "has incomplete evidence after the allotted interval"
                       "must yield because the observation window closed"
                       "may resume although this bounded wait expired") (mod i 5))
            (nth (list "has several valid consent-bearing continuations"
                       "requires the person to select between alternatives"
                       "cannot choose safely without preference"
                       "offers two reversible paths with different tradeoffs"
                       "has reached a genuine decision point") (mod i 5)))))))
    (defn dcc-situation (class i split)
        (str_concat
            (if (str_eq split "train") "Observed " "Boundary case: observed ")
            (str_concat (dcc-context i)
            (str_concat " "
            (str_concat (dcc-state class i split)
            (str_concat "; decide whether the precise control is "
            (str_concat class (str_concat " for case " (int_to_str i)))))))))
    (defn dcc-explanation (class i split)
        (str_concat
            (if (str_eq split "train") "Emit only after direct evidence: "
                "Distinguish the named neighbour; emit only when evidence supports: ")
            (str_concat class
            (nth (list " closes without payload."
                       " redirects movement without declaring error."
                       " records an observed invalid outcome."
                       " records elapsed bound without claiming failure."
                       " requests a consent-bearing selection.")
                 (mod (dct-id class) 5)))))
    (defn dcc-row (class i split)
        (list split class (dct-id class) (dcc-situation class i split)
              (dct-wire class) (dcc-explanation class i split)))
    (defn dcc-class-rows (class start stop split)
        (if (eq start stop) (empty)
            (cons (dcc-row class start split)
                  (dcc-class-rows class (add start 1) stop split))))
    (defn dcc-cat (a b) (if (eq (len a) 0) b (cons (head a) (dcc-cat (tail a) b))))
    (defn dcc-one-class (class)
        (dcc-cat (dcc-class-rows class 0 120 "train")
                 (dcc-class-rows class 120 150 "heldout-boundary")))
    (defn dcc-corpus-classes (names)
        (if (eq (len names) 0) (empty)
            (dcc-cat (dcc-one-class (head names))
                     (dcc-corpus-classes (tail names)))))
    (defn dcc-corpus () (dcc-corpus-classes (dct-names)))
    (defn dcc-count-class (rows class split)
        (if (eq (len rows) 0) 0
            (add
                (if (if (str_eq (nth (head rows) 0) split)
                        (str_eq (nth (head rows) 1) class) 0) 1 0)
                (dcc-count-class (tail rows) class split))))

    ; ── the LEAKAGE-FREE held-out set, authored 2026-08-18 ──────────────────
    ; The original heldout-boundary rows were never semantically fresh: after
    ; sanitization they collapse into the same 60-combo template product space
    ; as train (context = i mod 12, state = i mod 5), which is exactly why
    ; dca-leakage counted 150/150 and the adapter honestly refused its own
    ; accuracy. These rows are NEW SENTENCES — twelve fresh contexts and five
    ; fresh phrasings per class of the same control meanings, written here,
    ; original, sharing no sanitized template with train. Split name
    ; "heldout-fresh"; the prefix matches the boundary rows' so dca-input
    ; strips it unchanged. These rows NEVER train, and (per the work-metric's
    ; hold law) never enter a student's training corpus.
    (defn dcf-context (i)
        (nth (list "backup restore" "voice session" "ledger fold" "mesh offer"
                   "sensor sweep" "band rerun" "index rebuild" "prompt walk"
                   "worktree merge" "adapter fit" "stream drain" "receipt close")
             (mod i 12)))
    (defn dcf-state (class i)
        (if (str_eq class "NIL")
            (nth (list "finished cleanly and returned nothing at all"
                       "came back empty and that emptiness is the true answer"
                       "ended with zero items left to touch"
                       "closed in good health carrying no result"
                       "ran to the end and produced an intentional blank") (mod i 5))
        (if (str_eq class "CUT")
            (nth (list "should drop this line of attack and keep the other alive"
                       "has learned enough to discard one candidate midway"
                       "trims the weaker fork and presses on"
                       "abandons the current probe yet the walk goes on"
                       "lets one option go so the remaining one can move") (mod i 5))
        (if (str_eq class "FAIL")
            (nth (list "broke a promise the caller depends on"
                       "produced a value the checks prove wrong"
                       "ended in a state the rules forbid"
                       "returned evidence that is provably damaged"
                       "landed on an answer known to be false") (mod i 5))
        (if (str_eq class "TIMEOUT")
            (nth (list "ran out of its window before anything settled"
                       "is still working as the clock crosses the limit"
                       "holds only partial signals when the bell rings"
                       "must hand back control because the wait is over"
                       "could continue later but this slice of time is spent") (mod i 5))
            (nth (list "stands before options only a person may weigh"
                       "waits for someone to pick among fair alternatives"
                       "must not proceed until a preference is spoken"
                       "presents branching futures that both remain open"
                       "pauses at a fork where taste, not truth, decides") (mod i 5)))))))
    (defn dcf-situation (class i)
        (str_concat "Boundary case: observed "
            (str_concat (dcf-context i)
            (str_concat " "
            (str_concat (dcf-state class i)
            (str_concat "; decide whether the precise control is "
            (str_concat class (str_concat " for case " (int_to_str i)))))))))
    (defn dcf-row (class i)
        (list "heldout-fresh" class (dct-id class) (dcf-situation class i)
              (dct-wire class) (dcc-explanation class i "heldout-fresh")))
    (defn dcf-class-rows (class start stop)
        (if (eq start stop) (empty)
            (cons (dcf-row class start)
                  (dcf-class-rows class (add start 1) stop))))
    (defn dcf-classes (names)
        (if (eq (len names) 0) (empty)
            (dcc-cat (dcf-class-rows (head names) 0 30)
                     (dcf-classes (tail names)))))
    (defn dcc-fresh () (dcf-classes (dct-names)))
    (defn dcc-corpus-with-fresh () (dcc-cat (dcc-corpus) (dcc-fresh)))
    0)
