; dsv4-control-training-corpus.fk — balanced original BMF control supervision.
;
; 750 examples: 120 train + 30 heldout-boundary for each of five classes.
; Every sentence is constructed here from small original templates and indexed
; situations; no external or copyrighted corpus is reproduced.
;
; A row is:
;   (split class token-id situation desired-control explanation)
;
; Heldout rows deliberately sit near class boundaries. Their situation names
; state the tempting neighbour so evaluation measures semantic discrimination,
; not memorized spelling.
;
; preludes: form-stdlib/dsv4-control-tokens.fk

(do
    (defn dcc-context (i)
        (nth (list "proof" "file operation" "model step" "consent exchange"
                   "router branch" "test run" "search" "conversation"
                   "compiler pass" "device command" "calendar request"
                   "data transform") (mod i 12)))
    (defn dcc-state (class i split)
        (if (eq class "NIL")
            (nth (list "completed with no payload" "found an empty result without error"
                       "has no remaining work" "reached a healthy natural end"
                       "confirmed absence as the answer") (mod i 5))
        (if (eq class "CUT")
            (nth (list "must prune one branch while continuing" "rejected one path but retained another"
                       "needs to stop this attempt and pivot" "has enough evidence to abandon one hypothesis"
                       "will continue from the latest valid checkpoint") (mod i 5))
        (if (eq class "FAIL")
            (nth (list "contradicted a required invariant" "observed an invalid result"
                       "cannot establish the claimed postcondition" "received corrupt evidence"
                       "completed with a definite error") (mod i 5))
        (if (eq class "TIMEOUT")
            (nth (list "reached its time bound without a verdict" "is still live when the deadline elapsed"
                       "has incomplete evidence after the allotted interval"
                       "must yield because the observation window closed"
                       "may resume although this bounded wait expired") (mod i 5))
            (nth (list "has several valid consent-bearing continuations"
                       "requires the person to select between alternatives"
                       "cannot choose safely without preference"
                       "offers two reversible paths with different tradeoffs"
                       "has reached a genuine decision point") (mod i 5)))))))
    (defn dcc-situation (class i split)
        (str_concat
            (if (eq split "train") "Observed " "Boundary case: observed ")
            (str_concat (dcc-context i)
            (str_concat " "
            (str_concat (dcc-state class i split)
            (str_concat "; decide whether the precise control is "
            (str_concat class (str_concat " for case " (int_to_str i)))))))))
    (defn dcc-explanation (class i split)
        (str_concat
            (if (eq split "train") "Emit only after direct evidence: "
                "Distinguish the named neighbour; emit only when evidence supports: ")
            (str_concat class
            (nth (list " closes without payload."
                       " redirects movement without declaring error."
                       " records an observed invalid outcome."
                       " records elapsed bound without claiming failure."
                       " requests a consent-bearing selection.")
                 (mod (dct-id class) 5)))))
    (defn dcc-row (class i split)
        (list split class (dct-id class) (dcc-situation class i split)
              (dct-wire class) (dcc-explanation class i split)))
    (defn dcc-class-rows (class start stop split)
        (if (eq start stop) (empty)
            (cons (dcc-row class start split)
                  (dcc-class-rows class (add start 1) stop split))))
    (defn dcc-cat (a b) (if (eq (len a) 0) b (cons (head a) (dcc-cat (tail a) b))))
    (defn dcc-one-class (class)
        (dcc-cat (dcc-class-rows class 0 120 "train")
                 (dcc-class-rows class 120 150 "heldout-boundary")))
    (defn dcc-corpus-classes (names)
        (if (eq (len names) 0) (empty)
            (dcc-cat (dcc-one-class (head names))
                     (dcc-corpus-classes (tail names)))))
    (defn dcc-corpus () (dcc-corpus-classes (dct-names)))
    (defn dcc-count-class (rows class split)
        (if (eq (len rows) 0) 0
            (add
                (if (if (eq (nth (head rows) 0) split)
                        (eq (nth (head rows) 1) class) 0) 1 0)
                (dcc-count-class (tail rows) class split))))
    0)
