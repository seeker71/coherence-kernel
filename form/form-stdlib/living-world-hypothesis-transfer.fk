; living-world-hypothesis-transfer.fk -- current hypothesis execution may
; describe, but never install, an exact transition for an offered context.
;
; Participants offer one exact relation between a current hypothesis-tissue
; execution and an independently active transition context.  The relation
; carries an optional lens, a four-arm acknowledgement, alternatives, an
; optional unknowable remainder, and evidence.  Recurrence counts distinct
; active sources.  Every holder then governs an ordinary unanimous proposal.
;
; ONE must acknowledge the execution's exact output and may describe one inert
; transition observation.  ZERO, NOTHING, alternatives, and other NODE
; acknowledgements remain valid evidence but describe no transition.  Even an
; admitted transfer plan cannot modify the transition field: participants must
; re-offer its exact successor through the existing transition membrane.
;
; This interface contains no domain, operator, task, class, output, surface,
; ranking, default, or remote route.  It grants no authority beyond the exact
; current execution, context, offer, and independent re-offers involved.
;
; witnessed: 2026-08-09 -> 33554431 on fkwu
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-hypothesis-tissue.fk

(let LWHTR-OFFER  (bp "LWHTR-OFFER"))
(let LWHTR-PLAN   (bp "LWHTR-PLAN"))
(let LWHTR-ORIGIN (bp "LWHTR-ORIGIN"))

; children: exact execution, exact context, optional lens, four-arm ack,
; alternatives, optional unknown, evidence, local path
(defn lwhtr-offer
    (execution context lens ack alternatives unknown evidence)
    (intern_node LWHTR-OFFER
        (list execution context lens ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwhtr-offer? (cell)
    (if (and (eq (lwo-category? cell LWHTR-OFFER) 1)
             (eq (len (node_children cell)) 8)) 1 0))
(defn lwhtr-offer-execution (offer) (nth (node_children offer) 0))
(defn lwhtr-offer-context (offer) (nth (node_children offer) 1))
(defn lwhtr-offer-lens (offer) (nth (node_children offer) 2))
(defn lwhtr-offer-ack (offer) (nth (node_children offer) 3))
(defn lwhtr-offer-alternatives (offer) (nth (node_children offer) 4))
(defn lwhtr-offer-unknown (offer) (nth (node_children offer) 5))
(defn lwhtr-offer-evidence (offer) (nth (node_children offer) 6))
(defn lwhtr-offer-path (offer) (nth (node_children offer) 7))

(defn lwhtr-optional-lens-valid? (lens)
    (if (node_eq lens (lwo-none)) 1 (lwlc-lens? lens)))

(defn lwhtr-one-coherent? (offer)
    (node_eq (oac-payload (lwhtr-offer-ack offer))
        (lwht-execution-output (lwhtr-offer-execution offer))))

(defn lwhtr-alternative-coherent? (offer)
    (do
        (let alternative (oac-payload (lwhtr-offer-ack offer)))
        (if (and
                (node_eq (oac-alternative-reference alternative)
                    (lwhtr-offer-execution offer))
                (not (node_eq
                    (oac-alternative-offered alternative) (lwo-none))))
            1 0)))

(defn lwhtr-ack-coherent? (offer)
    (do
        (let ack (lwhtr-offer-ack offer))
        (if (eq (oac-one? ack) 1) (lwhtr-one-coherent? offer)
            (if (eq (oac-zero? ack) 1) 1
                (if (eq (oac-nothing? ack) 1) 1
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwhtr-alternative-coherent? offer)
                        1))))))

(defn lwhtr-offer-valid? (offer)
    (if (eq (lwhtr-offer? offer) 0) 0
        (if (eq (lwht-execution?
                    (lwhtr-offer-execution offer)) 0) 0
            (if (eq (lwtf-context?
                        (lwhtr-offer-context offer)) 0) 0
                (if (eq (lwhtr-optional-lens-valid?
                            (lwhtr-offer-lens offer)) 0) 0
                    (if (eq (oac-valid-ack?
                                (lwhtr-offer-ack offer)) 0) 0
                        (if (eq (lwo-category?
                                    (lwhtr-offer-alternatives offer)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwph-optional-unknown-valid?
                                      (lwhtr-offer-unknown offer)) 0) 0
                                (lwhtr-ack-coherent? offer)))))))))

(defn lwhtr-offer-current? (world offer)
    (if (and (eq (lwhtr-offer-valid? offer) 1)
             (and (eq (lwo-active? world offer) 1)
                  (and (eq (lwht-execution-current? world
                              (lwhtr-offer-execution offer)) 1)
                       (and (eq (lwo-active? world
                                    (lwhtr-offer-context offer)) 1)
                            (or (node_eq (lwhtr-offer-lens offer)
                                    (lwo-none))
                                (eq (lwo-active? world
                                    (lwhtr-offer-lens offer)) 1)))))) 1 0))

(defn lwhtr-witnesses (world offer)
    (lwo-active-attributions-for world offer))

(defn lwhtr-sources (world offer)
    (lwt-sources-from-attributions
        (lwo-field-items (lwhtr-witnesses world offer))
        (lwo-empty-field)))

(defn lwhtr-transition-for-offer (offer)
    (if (eq (oac-one? (lwhtr-offer-ack offer)) 0) (lwo-none)
        (lwtf-observation
            (lwhtr-offer-context offer)
            (lwht-execution-output (lwhtr-offer-execution offer))
            (lwhtr-offer-lens offer))))

; children: exact offer, optional inert transition observation, exact ack,
; alternatives, optional unknown, attribution witnesses, distinct sources,
; threshold, local path
(defn lwhtr-plan-cell (offer transition witnesses sources threshold)
    (intern_node LWHTR-PLAN
        (list offer transition (lwhtr-offer-ack offer)
              (lwhtr-offer-alternatives offer)
              (lwhtr-offer-unknown offer) witnesses sources
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwhtr-plan? (cell)
    (if (and (eq (lwo-category? cell LWHTR-PLAN) 1)
             (eq (len (node_children cell)) 9)) 1 0))
(defn lwhtr-plan-offer (plan) (nth (node_children plan) 0))
(defn lwhtr-plan-transition (plan) (nth (node_children plan) 1))
(defn lwhtr-plan-ack (plan) (nth (node_children plan) 2))
(defn lwhtr-plan-alternatives (plan) (nth (node_children plan) 3))
(defn lwhtr-plan-unknown (plan) (nth (node_children plan) 4))
(defn lwhtr-plan-witnesses (plan) (nth (node_children plan) 5))
(defn lwhtr-plan-sources (plan) (nth (node_children plan) 6))
(defn lwhtr-plan-threshold (plan)
    (node_value (nth (node_children plan) 7)))
(defn lwhtr-plan-path (plan) (nth (node_children plan) 8))

(defn lwhtr-plan-for (world offer threshold)
    (if (or (lt threshold 1)
            (eq (lwhtr-offer-current? world offer) 0)) (lwo-none)
        (do
            (let witnesses (lwhtr-witnesses world offer))
            (let sources (lwhtr-sources world offer))
            (if (lt (lwo-field-size sources) threshold) (lwo-none)
                (lwhtr-plan-cell offer
                    (lwhtr-transition-for-offer offer)
                    witnesses sources threshold)))))

(defn lwhtr-origin (offer threshold)
    (intern_node LWHTR-ORIGIN
        (list offer (intern_trivial_int threshold) (lwo-local-path))))

(defn lwhtr-proposal-for (world offer threshold)
    (do
        (let plan (lwhtr-plan-for world offer threshold))
        (if (node_eq plan (lwo-none)) (lwo-none)
            (do
                (let sources (lwhtr-plan-sources plan))
                (let witnesses (lwhtr-plan-witnesses plan))
                (let origin (lwhtr-origin offer threshold))
                (let candidate
                    (lwo-emergent plan witnesses
                        (intern_trivial_int (lwo-field-size sources))
                        (intern_trivial_int (lwo-field-size witnesses))
                        (intern_trivial_int threshold) origin))
                (lwt-proposal candidate sources origin)))))

(defn lwhtr-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwhtr-plan?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwhtr-candidate-fresh? (world candidate)
    (if (eq (lwhtr-candidate? candidate) 0) 0
        (do
            (let plan (lwo-emergent-shape candidate))
            (let proposal
                (lwhtr-proposal-for world
                    (lwhtr-plan-offer plan)
                    (lwhtr-plan-threshold plan)))
            (if (node_eq proposal (lwo-none)) 0
                (if (node_eq candidate
                        (lwt-proposal-candidate proposal)) 1 0)))))

(defn lwhtr-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwhtr-candidate-fresh? world
            (lwt-proposal-candidate proposal))))

(defn lwhtr-integrate (round proposal action)
    (if (eq (lwhtr-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwhtr-candidate-active? (world candidate)
    (if (and (eq (lwhtr-candidate-fresh? world candidate) 1)
             (eq (lwo-active? world candidate) 1)) 1 0))

(defn lwhtr-transition-successor (world candidate)
    (if (eq (lwhtr-candidate-active? world candidate) 0) (lwo-none)
        (lwhtr-plan-transition (lwo-emergent-shape candidate))))
