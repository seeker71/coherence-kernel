; living-world-session-learning.fk -- consented private-session outcomes may
; become ordinary ontology-open transition evidence without importing text,
; answer vocabulary, or authority.
;
; The membrane sees only canonical digest cells for dataset, query, candidate
; set, evaluation contract, offered outcomes, alternatives, and evidence.  A
; source stays outside the offered content and enters only through the ordinary
; living-world attribution edge.  ONE admits one transition observation whose
; next value may itself contain zero-to-many offered outcomes.  ZERO, immediate
; NOTHING, and unresolved/alternative NODE acknowledgements remain admitted
; evidence but cannot become transition support.
;
; Consent reuses the privacy-minimized session consent cell.  Its optional lens
; must be absent or an exact live lens declaration.  Expiry returns a retained
; OAC time outcome and crosses no source or offered payload; immediate NOTHING
; is an admitted evidence cell and therefore cannot collapse to expired
; NOTHING.  Recurrence, tending, integration, revocation, plurality, and
; currentness are inherited from the existing living-world organs.
;
; witnessed: 2026-08-09 -> 134217727 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/native-model-evidence.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-session-observation.fk

(let LWSN-CONTEXT  (bp "LWSN-CONTEXT"))
(let LWSN-OFFER    (bp "LWSN-OFFER"))
(let LWSN-ANSWER   (bp "LWSN-ANSWER"))
(let LWSN-EVIDENCE (bp "LWSN-EVIDENCE"))
(let LWSN-UNKNOWNS (bp "LWSN-UNKNOWNS"))
(let LWSN-RECEIPT  (bp "LWSN-RECEIPT"))
(let LWSN-ADMITTED (bp "LWSN-ADMITTED"))
(let LWSN-REFUSED  (bp "LWSN-REFUSED"))
(let LWSN-EXPIRED  (bp "LWSN-EXPIRED"))
(let LWSN-TRACE    (bp "LWSN-TRACE"))

(defn lwsn-state (kind) (intern_node kind (empty)))
(defn lwsn-admitted () (lwsn-state LWSN-ADMITTED))
(defn lwsn-refused () (lwsn-state LWSN-REFUSED))
(defn lwsn-expired () (lwsn-state LWSN-EXPIRED))

; The context is an identity-alignment boundary, not a task taxonomy.
(defn lwsn-context (dataset query candidates contract)
    (intern_node LWSN-CONTEXT
        (list dataset query candidates contract (lwo-local-path))))
(defn lwsn-context? (cell) (lwo-category? cell LWSN-CONTEXT))
(defn lwsn-context-dataset (context) (nth (node_children context) 0))
(defn lwsn-context-query (context) (nth (node_children context) 1))
(defn lwsn-context-candidates (context) (nth (node_children context) 2))
(defn lwsn-context-contract (context) (nth (node_children context) 3))
(defn lwsn-context-valid? (context)
    (if (eq (lwsn-context? context) 0) 0
        (if (not (eq (len (node_children context)) 5)) 0
            (if (eq (lwrs-digest? (lwsn-context-dataset context)) 0) 0
                (if (eq (lwrs-digest? (lwsn-context-query context)) 0) 0
                    (if (eq (lwrs-digest?
                                (lwsn-context-candidates context)) 0) 0
                        (lwrs-digest?
                            (lwsn-context-contract context))))))))
(defn lwsn-context-aligned? (left right)
    (if (and (eq (lwsn-context-valid? left) 1)
             (and (eq (lwsn-context-valid? right) 1)
                  (node_eq left right))) 1 0))

(defn lwsn-digest-items? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwrs-digest? (head items)) 1)
            (lwsn-digest-items? (tail items)) 0)))
(defn lwsn-digest-field? (field)
    (if (eq (lwo-category? field LWO-FIELD) 0) 0
        (lwsn-digest-items? (lwo-field-items field))))
(defn lwsn-unknown-valid? (unknown)
    (if (node_eq unknown (lwo-none)) 1
        (if (eq (lwlc-unknown? unknown) 0) 0
            (lwrs-digest? (lwlc-unknown-evidence unknown)))))
(defn lwsn-lens-valid? (lens)
    (if (node_eq lens (lwo-none)) 1
        (lwlc-declaration-valid? lens)))

; children: exact aligned context, offered outcome digests, acknowledgement,
; explicit alternative digests, optional unknowable, digest evidence, path.
(defn lwsn-offer
    (context outcomes ack alternatives unknown evidence)
    (intern_node LWSN-OFFER
        (list context outcomes ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwsn-offer? (cell) (lwo-category? cell LWSN-OFFER))
(defn lwsn-offer-context (offer) (nth (node_children offer) 0))
(defn lwsn-offer-outcomes (offer) (nth (node_children offer) 1))
(defn lwsn-offer-ack (offer) (nth (node_children offer) 2))
(defn lwsn-offer-alternatives (offer) (nth (node_children offer) 3))
(defn lwsn-offer-unknown (offer) (nth (node_children offer) 4))
(defn lwsn-offer-evidence (offer) (nth (node_children offer) 5))

(defn lwsn-node-ack-safe? (context ack)
    (if (eq (oac-node? ack) 0) 1
        (if (eq (oac-alternative-ack? ack) 1)
            (do
                (let alternative (oac-payload ack))
                (if (and
                        (or (node_eq
                                (oac-alternative-reference alternative)
                                context)
                            (eq (lwrs-digest?
                                (oac-alternative-reference alternative)) 1))
                        (and (eq (lwrs-digest?
                                    (oac-alternative-offered alternative)) 1)
                             (eq (lwrs-digest?
                                    (oac-alternative-evidence alternative)) 1)))
                    1 0))
            (lwrs-digest? (oac-payload ack)))))

(defn lwsn-ack-coherent? (offer)
    (do
        (let ack (lwsn-offer-ack offer))
        (if (eq (oac-valid-ack? ack) 0) 0
            (if (eq (oac-one? ack) 1)
                (if (and (gt (lwo-field-size
                                (lwsn-offer-outcomes offer)) 0)
                         (eq (lwo-field-has?
                                (lwsn-offer-outcomes offer)
                                (oac-payload ack)) 1)) 1 0)
                (lwsn-node-ack-safe?
                    (lwsn-offer-context offer) ack)))))

(defn lwsn-offer-valid? (offer)
    (if (eq (lwsn-offer? offer) 0) 0
        (if (not (eq (len (node_children offer)) 7)) 0
            (if (eq (lwsn-context-valid?
                        (lwsn-offer-context offer)) 0) 0
                (if (eq (lwsn-digest-field?
                            (lwsn-offer-outcomes offer)) 0) 0
                    (if (eq (lwsn-digest-field?
                                (lwsn-offer-alternatives offer)) 0) 0
                        (if (eq (lwsn-unknown-valid?
                                    (lwsn-offer-unknown offer)) 0) 0
                            (if (eq (lwrs-digest?
                                        (lwsn-offer-evidence offer)) 0) 0
                                (lwsn-ack-coherent? offer)))))))))

; ONE answers may remain plural.  Their exact alternatives and unknown are
; retained beside the supported outcomes; no winner is chosen here.
(defn lwsn-answer (offer)
    (intern_node LWSN-ANSWER
        (list (lwsn-offer-outcomes offer)
              (lwsn-offer-alternatives offer)
              (lwsn-offer-unknown offer)
              (lwsn-offer-ack offer)
              (lwo-local-path))))
(defn lwsn-answer? (cell) (lwo-category? cell LWSN-ANSWER))
(defn lwsn-answer-outcomes (answer) (nth (node_children answer) 0))
(defn lwsn-answer-alternatives (answer) (nth (node_children answer) 1))
(defn lwsn-answer-unknown (answer) (nth (node_children answer) 2))

; Non-ONE acknowledgements are evidence, not transition support.
(defn lwsn-evidence (offer lens)
    (intern_node LWSN-EVIDENCE
        (list offer lens (lwo-local-path))))
(defn lwsn-evidence? (cell) (lwo-category? cell LWSN-EVIDENCE))
(defn lwsn-evidence-offer (evidence) (nth (node_children evidence) 0))
(defn lwsn-evidence-lens (evidence) (nth (node_children evidence) 1))

(defn lwsn-transition-context (context)
    (lwtf-context (list context)))
(defn lwsn-transition-observation (offer lens)
    (lwtf-observation
        (lwsn-transition-context (lwsn-offer-context offer))
        (lwsn-answer offer) lens))
(defn lwsn-admitted-payload (offer lens)
    (if (eq (oac-one? (lwsn-offer-ack offer)) 1)
        (lwsn-transition-observation offer lens)
        (lwsn-evidence offer lens)))

(defn lwsn-consent-valid? (consent)
    (if (eq (lwrs-consent-shape-valid? consent) 0) 0
        (lwsn-lens-valid? (lwrs-consent-lens consent))))
(defn lwsn-consent-scopes? (consent offer action)
    (if (and
            (node_eq (lwrs-consent-dataset consent)
                     (lwsn-context-dataset
                        (lwsn-offer-context offer)))
            (eq (lwo-field-has?
                    (lwrs-consent-interface consent) action) 1)) 1 0))

(defn lwsn-timeout-for-consent (consent)
    (oac-timeout
        (lwrs-consent-expiry consent)
        (if (node_eq (lwrs-consent-expiry-default consent) (lwo-none))
            (oac-no-default)
            (lwrs-consent-expiry-default consent))
        (lwrs-consent-purpose consent)))

; children: successor world, boundary ack, admitted/refused/expired state,
; admitted payload or NONE, valid scope or NONE, timing outcome or NONE, path.
(defn lwsn-receipt (world ack state payload scope timing)
    (intern_node LWSN-RECEIPT
        (list world ack state payload scope timing (lwo-local-path))))
(defn lwsn-receipt? (cell) (lwo-category? cell LWSN-RECEIPT))
(defn lwsn-receipt-world (receipt) (nth (node_children receipt) 0))
(defn lwsn-receipt-ack (receipt) (nth (node_children receipt) 1))
(defn lwsn-receipt-state (receipt) (nth (node_children receipt) 2))
(defn lwsn-receipt-payload (receipt) (nth (node_children receipt) 3))
(defn lwsn-receipt-scope (receipt) (nth (node_children receipt) 4))
(defn lwsn-receipt-timing (receipt) (nth (node_children receipt) 5))

(defn lwsn-content-blind-receipt (world action ack state timing scope)
    (do
        (let transition (lwrs-content-blind-refusal world action ack))
        (lwsn-receipt (lwo-transition-world transition) ack state
            (lwo-none) scope timing)))

(defn lwsn-receive (world offer consent action now)
    (if (eq (lwsn-offer-valid? offer) 0)
        (lwsn-content-blind-receipt world action (oac-zero)
            (lwsn-refused) (lwo-none) (lwo-none))
        (if (eq (lwsn-consent-valid? consent) 0)
            (lwsn-content-blind-receipt world action (oac-zero)
                (lwsn-refused) (lwo-none) (lwo-none))
            (if (or (eq (lwsn-consent-scopes? consent offer action) 0)
                    (or (eq (lwrs-consent-revocable consent) 0)
                        (eq (lwrs-consent-receipt consent) 0)))
                (lwsn-content-blind-receipt world action (oac-zero)
                    (lwsn-refused) (lwo-none) (lwo-none))
                (if (eq (lwrs-consent-expired? consent now) 1)
                    (do
                        (let timing
                            (oac-timeout-condense
                                (lwsn-timeout-for-consent consent)
                                (intern_trivial_int now)))
                        (lwsn-content-blind-receipt world action
                            (oac-time-outcome-ack timing)
                            (lwsn-expired) timing consent))
                    (do
                        (let payload
                            (lwsn-admitted-payload offer
                                (lwrs-consent-lens consent)))
                        (let transition
                            (lwo-receive world
                                (lwo-offer
                                    (lwrs-consent-owner consent)
                                    (lwrs-consent-interface consent) 1
                                    payload offer 1)
                                action))
                        (lwsn-receipt
                            (lwo-transition-world transition)
                            (lwo-transition-ack transition)
                            (lwsn-admitted) payload consent
                            (lwo-none))))))))

; A single admitted payload is the revocable unit.  Foreign release remains an
; ordinary ZERO at the organ boundary because ownership lives in attribution.
(defn lwsn-revoke
    (world receipt source action reason provenance)
    (if (or (eq (lwsn-receipt? receipt) 0)
            (not (node_eq (lwsn-receipt-state receipt)
                          (lwsn-admitted))))
        (lwo-transition world (oac-zero))
        (lwo-receive world
            (lwo-offer source (lwo-interface (list action)) 1
                (lwo-revocation (lwsn-receipt-payload receipt)
                    source reason provenance)
                provenance 1)
            action)))

(defn lwsn-payload-context? (payload context)
    (if (eq (lwsn-evidence? payload) 1)
        (node_eq
            (lwsn-offer-context (lwsn-evidence-offer payload)) context)
        (if (eq (lwtf-observation? payload) 0) 0
            (if (eq (lwsn-answer?
                        (lwtf-observation-next payload)) 0) 0
                (node_eq (lwtf-observation-context payload)
                    (lwsn-transition-context context))))))

(defn lwsn-payload-alternatives (payload)
    (if (eq (lwsn-evidence? payload) 1)
        (lwsn-offer-alternatives (lwsn-evidence-offer payload))
        (lwsn-answer-alternatives
            (lwtf-observation-next payload))))
(defn lwsn-payload-unknown (payload)
    (if (eq (lwsn-evidence? payload) 1)
        (lwsn-offer-unknown (lwsn-evidence-offer payload))
        (lwsn-answer-unknown
            (lwtf-observation-next payload))))

(defn lwsn-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwsn-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwsn-collect-context-items
    (world items context evidence alternatives unknowns)
    (if (eq (len items) 0) (list evidence alternatives unknowns)
        (do
            (let payload (head items))
            (if (or (eq (lwsn-payload-context? payload context) 0)
                    (eq (lwo-active? world payload) 0))
                (lwsn-collect-context-items world (tail items) context
                    evidence alternatives unknowns)
                (do
                    (let unknown (lwsn-payload-unknown payload))
                    (lwsn-collect-context-items world (tail items) context
                        (lwo-field-add evidence payload)
                        (lwsn-field-union-items
                            (lwo-field-items
                                (lwsn-payload-alternatives payload))
                            alternatives)
                        (if (node_eq unknown (lwo-none)) unknowns
                            (lwo-field-add unknowns unknown))))))))

(defn lwsn-context-evidence (world context)
    (lwsn-collect-context-items world
        (lwo-field-items (lwo-world-cells world)) context
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)))
(defn lwsn-evidence-field (collected) (nth collected 0))
(defn lwsn-alternatives-field (collected) (nth collected 1))
(defn lwsn-unknowns-field (collected) (nth collected 2))
(defn lwsn-unknown-projection (unknowns)
    (if (eq (lwo-field-size unknowns) 0) (lwo-none)
        (if (eq (lwo-field-size unknowns) 1)
            (head (lwo-field-items unknowns))
            (intern_node LWSN-UNKNOWNS
                (list unknowns (lwo-local-path))))))

(defn lwsn-predict (world context)
    (do
        (let collected (lwsn-context-evidence world context))
        (lwtf-predict world (lwsn-transition-context context)
            (lwsn-alternatives-field collected)
            (lwsn-unknown-projection
                (lwsn-unknowns-field collected)))))

; The trace is reconstructible from the current world.  It grants neither the
; prediction nor its offered outcomes more authority than their attributions.
(defn lwsn-trace (world context)
    (do
        (let collected (lwsn-context-evidence world context))
        (let prediction (lwsn-predict world context))
        (intern_node LWSN-TRACE
            (list context prediction
                  (lwsn-evidence-field collected)
                  (lwsn-alternatives-field collected)
                  (lwsn-unknowns-field collected)
                  (lwtf-prediction-derivations prediction)
                  (lwo-local-path)))))
(defn lwsn-trace? (cell) (lwo-category? cell LWSN-TRACE))
(defn lwsn-trace-context (trace) (nth (node_children trace) 0))
(defn lwsn-trace-prediction (trace) (nth (node_children trace) 1))
(defn lwsn-trace-evidence (trace) (nth (node_children trace) 2))
(defn lwsn-trace-current? (world trace)
    (if (eq (lwsn-trace? trace) 0) 0
        (if (node_eq trace
                (lwsn-trace world (lwsn-trace-context trace))) 1 0)))

0
