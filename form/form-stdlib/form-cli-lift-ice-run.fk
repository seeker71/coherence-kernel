; form-cli-lift-ice-run.fk — use the crystallized form.lift feature.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-lift-ice.bml

(do
    (print "form-cli executed lift-ice\n")
    (print "form-cli anyone=")
    (print (int_to_str (fli-anyone)))
    (print " not-cursor=")
    (print (int_to_str (fli-not-cursor)))
    (print " ingest-fear=")
    (print (int_to_str (fli-ingest 5 1)))
    (print " ingest-shallow=")
    (print (int_to_str (fli-ingest 1 0)))
    (print " check=")
    (print (int_to_str (fli-check)))
    (print "\n")
    0)
