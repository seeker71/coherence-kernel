; form-program-image-bmf-request-birth.fk -- one bounded scannerless BMF
; request frame is consumed by an admitted full PIF and births the exact
; Form knowledge request NodeID category 31.2.0.98.
;
; The raw OFFER value is the only string input.  The image itself locates the
; opener/closer, enforces the 96-byte payload and 64-byte concept-coordinate
; bounds, rejects nested/trailing/malformed syntax, validates each coordinate
; byte, and interns the six canonical request children.  No caller-side parse
; or fixture coordinate participates.
;
; A valid frame returns the request node itself.  A completed non-ready parse
; returns [status, reason, nothing, 0, 1]: typed nothing remains present inside
; the record and scannerless=1 remains distinct from pretokenized=0.  Parser
; budget outcomes are returned records; exhausted image fuel remains the outer
; FPCPF timeout with output-count zero.  This cell performs no filesystem,
; host, model, Metal, network, C, flatten, or operation-table action.
;
; Honest floor: this first image births the canonical `concept=` request.  The
; sibling `nodeid=` grammar remains outside this image until its four decimal
; coordinates receive the same byte-local proof.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-full-pif-call-adapter.fk
; Proven by: form-stdlib/tests/form-program-image-bmf-request-birth-band.fk

(do
    (defn fpbr-version () "form-program-image-bmf-request-birth-v1")
    (defn fpbr-symbol () "scannerless/nodeid-request-birth")
    (defn fpbr-open () "<|form:nodeid-knowledge-query|>")
    (defn fpbr-close () "<|/form:nodeid-knowledge-query|>")
    (defn fpbr-concept-prefix () "concept=")
    (defn fpbr-max-payload-bytes () 96)
    (defn fpbr-max-concept-bytes () 64)
    (defn fpbr-max-frame-bytes () 159)

    ; Node ids are written beside each row.  Five image-local functions are
    ; rooted at scanner=139, status-record=11, concept-byte-loop=37,
    ; literal-match=169, and literal-find=190.
    (defn fpbr-nodes ()
        (list
            ; status-record([status, reason]) ->
            ; [status, reason, nothing, pretokenized=0, scannerless=1]
            (pif-node-row 2 0 0 0)       ; 0 input
            (pif-node-row 1 0 0 0)       ; 1 int 0
            (pif-node-row 1 1 0 0)       ; 2 int 1
            (pif-node-row 23 0 1 0)      ; 3 status
            (pif-node-row 23 0 2 0)      ; 4 reason
            (pif-node-row 137 0 0 0)     ; 5 typed nothing
            (pif-node-row 18 0 0 0)      ; 6 empty list
            (pif-node-row 19 2 6 0)      ; 7 [1]
            (pif-node-row 19 1 7 0)      ; 8 [0,1]
            (pif-node-row 19 5 8 0)      ; 9 [nothing,0,1]
            (pif-node-row 19 4 9 0)      ; 10 [reason,nothing,0,1]
            (pif-node-row 19 3 10 0)     ; 11 status-record root

            ; concept-byte-loop([coordinate, at]).  Its only recursive edge
            ; advances `at`; main has already established 1..64 bytes.
            (pif-node-row 2 0 0 0)       ; 12 validator input
            (pif-node-row 23 12 1 0)     ; 13 coordinate
            (pif-node-row 23 12 2 0)     ; 14 at
            (pif-node-row 25 13 0 0)     ; 15 coordinate length
            (pif-node-row 102 14 15 0)   ; 16 at == length
            (pif-node-row 28 13 14 0)    ; 17 byte at coordinate[at]
            (pif-node-row 1 97 0 0)      ; 18 'a'
            (pif-node-row 1 122 0 0)     ; 19 'z'
            (pif-node-row 1 48 0 0)      ; 20 '0'
            (pif-node-row 1 57 0 0)      ; 21 '9'
            (pif-node-row 1 45 0 0)      ; 22 '-'
            (pif-node-row 5 18 17 0)     ; 23 'a' <= byte
            (pif-node-row 5 17 19 0)     ; 24 byte <= 'z'
            (pif-node-row 6 23 24 1)     ; 25 lowercase
            (pif-node-row 5 20 17 0)     ; 26 '0' <= byte
            (pif-node-row 5 17 21 0)     ; 27 byte <= '9'
            (pif-node-row 6 26 27 1)     ; 28 digit
            (pif-node-row 102 17 22 0)   ; 29 hyphen
            (pif-node-row 6 28 2 29)     ; 30 digit or hyphen
            (pif-node-row 6 25 2 30)     ; 31 valid byte
            (pif-node-row 3 14 2 0)      ; 32 at + 1
            (pif-node-row 19 32 6 0)     ; 33 [at+1]
            (pif-node-row 19 13 33 0)    ; 34 [coordinate,at+1]
            (pif-node-row 12 2 34 0)     ; 35 recursive validator call
            (pif-node-row 6 31 35 1)     ; 36 invalid byte -> 0
            (pif-node-row 6 16 2 36)     ; 37 validator root

            ; scanner(raw OFFER string)
            (pif-node-row 2 0 0 0)       ; 38 surface
            (pif-node-row 25 38 0 0)     ; 39 surface length
            (pif-node-row 24 0 0 0)      ; 40 opener
            (pif-node-row 24 1 0 0)      ; 41 closer
            (pif-node-row 24 2 0 0)      ; 42 concept=
            (pif-node-row 1 31 0 0)      ; 43 opener length / category p
            (pif-node-row 1 32 0 0)      ; 44 closer length
            (pif-node-row 1 159 0 0)     ; 45 frame bound
            (pif-node-row 1 96 0 0)      ; 46 payload bound
            (pif-node-row 1 64 0 0)      ; 47 coordinate bound
            (pif-node-row 1 8 0 0)       ; 48 prefix length
            (pif-node-row 1 98 0 0)      ; 49 category instance
            (pif-node-row 1 2 0 0)       ; 50 category lens
            (pif-node-row 12 3 143 0)    ; 51 opener literal-match from byte 0
            (pif-node-row 102 51 2 0)    ; 52 exact opener matched

            ; Returned status records are constructed in-image and keep typed
            ; nothing, literal zero, and literal one as different children.
            (pif-node-row 24 3 0 0)      ; 53 "nothing"
            (pif-node-row 24 4 0 0)      ; 54 no-token reason
            (pif-node-row 19 54 6 0)     ; 55 [reason]
            (pif-node-row 19 53 55 0)    ; 56 [status,reason]
            (pif-node-row 12 1 56 0)     ; 57 missing opener record
            (pif-node-row 24 5 0 0)      ; 58 incomplete reason
            (pif-node-row 19 58 6 0)     ; 59 [reason]
            (pif-node-row 19 53 59 0)    ; 60 [status,reason]
            (pif-node-row 12 1 60 0)     ; 61 held-incomplete record
            (pif-node-row 24 6 0 0)      ; 62 "timeout"
            (pif-node-row 24 7 0 0)      ; 63 frame-budget reason
            (pif-node-row 19 63 6 0)     ; 64 [reason]
            (pif-node-row 19 62 64 0)    ; 65 [status,reason]
            (pif-node-row 12 1 65 0)     ; 66 frame-budget record
            (pif-node-row 24 8 0 0)      ; 67 "failure"
            (pif-node-row 24 9 0 0)      ; 68 trailing reason
            (pif-node-row 19 68 6 0)     ; 69 [reason]
            (pif-node-row 19 67 69 0)    ; 70 [status,reason]
            (pif-node-row 12 1 70 0)     ; 71 trailing record
            (pif-node-row 24 10 0 0)     ; 72 payload-budget reason
            (pif-node-row 19 72 6 0)     ; 73 [reason]
            (pif-node-row 19 62 73 0)    ; 74 [status,reason]
            (pif-node-row 12 1 74 0)     ; 75 payload-budget record
            (pif-node-row 24 11 0 0)     ; 76 nested reason
            (pif-node-row 19 76 6 0)     ; 77 [reason]
            (pif-node-row 19 67 77 0)    ; 78 [status,reason]
            (pif-node-row 12 1 78 0)     ; 79 nested record
            (pif-node-row 24 12 0 0)     ; 80 unknown-kind reason
            (pif-node-row 19 80 6 0)     ; 81 [reason]
            (pif-node-row 19 67 81 0)    ; 82 [status,reason]
            (pif-node-row 12 1 82 0)     ; 83 unknown-kind record
            (pif-node-row 24 13 0 0)     ; 84 invalid-coordinate reason
            (pif-node-row 19 84 6 0)     ; 85 [reason]
            (pif-node-row 19 67 85 0)    ; 86 [status,reason]
            (pif-node-row 12 1 86 0)     ; 87 invalid-coordinate record

            ; Frame structure and payload extraction.
            (pif-node-row 12 4 146 0)    ; 88 bytewise closer find after opener
            (pif-node-row 103 88 1 0)    ; 89 closer absent
            (pif-node-row 103 45 39 0)   ; 90 frame bound < length
            (pif-node-row 6 90 66 61)    ; 91 over-budget / incomplete
            (pif-node-row 3 88 44 0)     ; 92 end after closer
            (pif-node-row 102 92 39 0)   ; 93 consumes all bytes
            (pif-node-row 29 38 43 88)   ; 94 payload
            (pif-node-row 25 94 0 0)     ; 95 payload length
            (pif-node-row 103 46 95 0)   ; 96 payload > 96
            (pif-node-row 12 4 193 0)    ; 97 nested opener bytewise find
            (pif-node-row 103 97 1 0)    ; 98 no nested opener
            (pif-node-row 12 4 196 0)    ; 99 nested closer bytewise find
            (pif-node-row 103 99 1 0)    ; 100 no nested closer
            (pif-node-row 6 98 100 1)    ; 101 no nested delimiter
            (pif-node-row 12 3 200 0)    ; 102 concept= literal-match at byte 0
            (pif-node-row 102 102 2 0)   ; 103 exact prefix matched
            (pif-node-row 29 94 48 95)   ; 104 coordinate from OFFER bytes
            (pif-node-row 25 104 0 0)    ; 105 coordinate length
            (pif-node-row 103 1 105 0)   ; 106 nonempty
            (pif-node-row 5 105 47 0)    ; 107 coordinate <= 64
            (pif-node-row 19 1 6 0)      ; 108 [0]
            (pif-node-row 19 104 108 0)  ; 109 [coordinate,0]
            (pif-node-row 12 2 109 0)    ; 110 byte validator
            (pif-node-row 6 107 110 1)   ; 111 bound then bytes
            (pif-node-row 6 106 111 1)   ; 112 nonempty then valid

            ; Exact category 31.2.0.98 and exact six canonical children.
            (pif-node-row 19 49 6 0)     ; 113 [98]
            (pif-node-row 19 1 113 0)    ; 114 [0,98]
            (pif-node-row 19 50 114 0)   ; 115 [2,0,98]
            (pif-node-row 19 43 115 0)   ; 116 [31,2,0,98]
            (pif-node-row 91 116 0 0)    ; 117 request category
            (pif-node-row 24 14 0 0)     ; 118 "concept"
            (pif-node-row 46 118 0 0)    ; 119 kind child
            (pif-node-row 46 104 0 0)    ; 120 extracted coordinate child
            (pif-node-row 43 46 0 0)     ; 121 payload-bound child
            (pif-node-row 43 2 0 0)      ; 122 lookup-count child
            (pif-node-row 43 1 0 0)      ; 123 pretokenized child
            (pif-node-row 24 15 0 0)     ; 124 cursor identity
            (pif-node-row 46 124 0 0)    ; 125 cursor child
            (pif-node-row 19 125 6 0)    ; 126 [cursor]
            (pif-node-row 19 123 126 0)  ; 127 [0,cursor]
            (pif-node-row 19 122 127 0)  ; 128 [1,0,cursor]
            (pif-node-row 19 121 128 0)  ; 129 [96,1,0,cursor]
            (pif-node-row 19 120 129 0)  ; 130 [coordinate,...]
            (pif-node-row 19 119 130 0)  ; 131 [concept,coordinate,...]
            (pif-node-row 47 117 131 0)  ; 132 exact request node

            ; Only the selected branch executes.  Semantic timeouts are
            ; records; insufficient walker fuel cannot reach a fake output.
            (pif-node-row 6 112 132 87)  ; 133 valid / invalid coordinate
            (pif-node-row 6 103 133 83)  ; 134 concept / unknown kind
            (pif-node-row 6 101 134 79)  ; 135 nested / clean
            (pif-node-row 6 96 75 135)   ; 136 payload budget / payload
            (pif-node-row 6 93 136 71)   ; 137 exact end / trailing
            (pif-node-row 6 89 91 137)   ; 138 absent close / complete
            (pif-node-row 6 52 138 57)   ; 139 scanner root

            ; Generic literal-match([raw, raw-at, literal, literal-at]).  It
            ; advances both byte coordinates through CALL + byte_at; reaching
            ; the literal end succeeds, raw exhaustion or mismatch returns 0.
            (pif-node-row 19 1 6 0)      ; 140 [0]
            (pif-node-row 19 40 140 0)   ; 141 [opener,0]
            (pif-node-row 19 1 141 0)    ; 142 [0,opener,0]
            (pif-node-row 19 38 142 0)   ; 143 opener match argument
            (pif-node-row 19 41 6 0)     ; 144 [closer]
            (pif-node-row 19 43 144 0)   ; 145 [31,closer]
            (pif-node-row 19 38 145 0)   ; 146 closer find argument
            (pif-node-row 2 0 0 0)       ; 147 literal-match input
            (pif-node-row 23 147 1 0)    ; 148 raw
            (pif-node-row 23 147 2 0)    ; 149 raw-at
            (pif-node-row 23 147 50 0)   ; 150 literal
            (pif-node-row 1 3 0 0)       ; 151 int 3
            (pif-node-row 23 147 151 0)  ; 152 literal-at
            (pif-node-row 25 148 0 0)    ; 153 raw length
            (pif-node-row 25 150 0 0)    ; 154 literal length
            (pif-node-row 102 152 154 0) ; 155 literal complete
            (pif-node-row 103 149 153 0) ; 156 raw-at < raw length
            (pif-node-row 28 148 149 0)  ; 157 raw byte
            (pif-node-row 28 150 152 0)  ; 158 literal byte
            (pif-node-row 102 157 158 0) ; 159 bytes equal
            (pif-node-row 3 149 2 0)     ; 160 next raw-at
            (pif-node-row 3 152 2 0)     ; 161 next literal-at
            (pif-node-row 19 161 6 0)    ; 162 [next literal-at]
            (pif-node-row 19 150 162 0)  ; 163 [literal,next literal-at]
            (pif-node-row 19 160 163 0)  ; 164 [next raw-at,...]
            (pif-node-row 19 148 164 0)  ; 165 recursive match argument
            (pif-node-row 12 3 165 0)    ; 166 recursive literal-match
            (pif-node-row 6 159 166 1)   ; 167 equal / mismatch
            (pif-node-row 6 156 167 1)   ; 168 raw available / exhausted
            (pif-node-row 6 155 2 168)   ; 169 literal-match root

            ; Generic literal-find([raw, at, literal]).  Each candidate byte
            ; invokes literal-match; misses advance exactly one raw byte.
            (pif-node-row 2 0 0 0)       ; 170 literal-find input
            (pif-node-row 23 170 1 0)    ; 171 raw
            (pif-node-row 23 170 2 0)    ; 172 at
            (pif-node-row 23 170 50 0)   ; 173 literal
            (pif-node-row 25 171 0 0)    ; 174 raw length
            (pif-node-row 25 173 0 0)    ; 175 literal length
            (pif-node-row 4 174 175 0)   ; 176 last possible start
            (pif-node-row 5 172 176 0)   ; 177 at <= last start
            (pif-node-row 19 1 6 0)      ; 178 [literal-at=0]
            (pif-node-row 19 173 178 0)  ; 179 [literal,0]
            (pif-node-row 19 172 179 0)  ; 180 [at,literal,0]
            (pif-node-row 19 171 180 0)  ; 181 match argument
            (pif-node-row 12 3 181 0)    ; 182 literal-match candidate
            (pif-node-row 3 172 2 0)     ; 183 next at
            (pif-node-row 19 173 6 0)    ; 184 [literal]
            (pif-node-row 19 183 184 0)  ; 185 [next at,literal]
            (pif-node-row 19 171 185 0)  ; 186 recursive find argument
            (pif-node-row 12 4 186 0)    ; 187 recursive literal-find
            (pif-node-row 6 182 172 187) ; 188 found at / continue
            (pif-node-row 1 -1 0 0)      ; 189 absent sentinel
            (pif-node-row 6 177 188 189) ; 190 literal-find root

            ; Forward argument nodes let the scanner use the same generic
            ; bytewise organs for nested delimiters and the concept prefix.
            (pif-node-row 19 40 6 0)     ; 191 [opener]
            (pif-node-row 19 1 191 0)    ; 192 [0,opener]
            (pif-node-row 19 94 192 0)   ; 193 payload opener find argument
            (pif-node-row 19 41 6 0)     ; 194 [closer]
            (pif-node-row 19 1 194 0)    ; 195 [0,closer]
            (pif-node-row 19 94 195 0)   ; 196 payload closer find argument
            (pif-node-row 19 1 6 0)      ; 197 [literal-at=0]
            (pif-node-row 19 42 197 0)   ; 198 [concept=,0]
            (pif-node-row 19 1 198 0)    ; 199 [raw-at=0,concept=,0]
            (pif-node-row 19 94 199 0))) ; 200 prefix match argument

    (defn fpbr-string-rows ()
        (list
            (list 60 124 102 111 114 109 58 110 111 100 101 105 100 45 107
                  110 111 119 108 101 100 103 101 45 113 117 101 114 121 124 62)
            (list 60 124 47 102 111 114 109 58 110 111 100 101 105 100 45 107
                  110 111 119 108 101 100 103 101 45 113 117 101 114 121 124 62)
            (list 99 111 110 99 101 112 116 61)
            (list 110 111 116 104 105 110 103)
            (list 110 111 45 107 110 111 119 108 101 100 103 101 45 116 111 107 101 110)
            (list 104 101 108 100 45 105 110 99 111 109 112 108 101 116 101)
            (list 116 105 109 101 111 117 116)
            (list 102 114 97 109 101 45 98 117 100 103 101 116 45 101 120 99 101 101 100 101 100)
            (list 102 97 105 108 117 114 101)
            (list 116 114 97 105 108 105 110 103 45 98 121 116 101 115)
            (list 112 97 121 108 111 97 100 45 98 117 100 103 101 116 45 101 120 99 101 101 100 101 100)
            (list 110 101 115 116 101 100 45 107 110 111 119 108 101 100 103 101 45 116 111 107 101 110)
            (list 117 110 107 110 111 119 110 45 114 101 113 117 101 115 116 45 107 105 110 100)
            (list 105 110 118 97 108 105 100 45 99 111 110 99 101 112 116 45 99 111 111 114 100 105 110 97 116 101)
            (list 99 111 110 99 101 112 116)
            (list 98 109 102 45 99 111 114 101 45 114 97 119 45 98 121 116 101 45 99 117 114 115 111 114 45 118 49)))

    (defn fpbr-table ()
        (pif-table-image 5 (list 139 11 37 169 190)
            201 (fpbr-nodes) 16 (fpbr-string-rows)))
    (defn fpbr-symbol-image ()
        (pif-symbol-image 5
            (list
                (pif-symbol-row 0 (fpbr-symbol))
                (pif-symbol-row 1 "scannerless/request-status-record")
                (pif-symbol-row 2 "scannerless/concept-byte-loop")
                (pif-symbol-row 3 "scannerless/literal-match")
                (pif-symbol-row 4 "scannerless/literal-find"))
            5
            (list
                (pif-node-symbol-row 11 1 (empty))
                (pif-node-symbol-row 37 2
                    (list (pif-symbol-dependency-target 2 37)))
                (pif-node-symbol-row 139 0
                    (list (pif-symbol-dependency-target 1 11)
                          (pif-symbol-dependency-target 2 37)
                          (pif-symbol-dependency-target 3 169)
                          (pif-symbol-dependency-target 4 190)))
                (pif-node-symbol-row 169 3
                    (list (pif-symbol-dependency-target 3 169)))
                (pif-node-symbol-row 190 4
                    (list (pif-symbol-dependency-target 3 169)
                          (pif-symbol-dependency-target 4 190))))))
    (defn fpbr-pif ()
        (pif-envelope-with-symbols
            "form/form-stdlib/form-program-image-bmf-request-birth.fk"
            "sha:scannerless-request-birth-source" 1
            "resident:scannerless/nodeid-request-birth"
            "sha:scannerless-request-birth-content" 1 1
            (fpbr-table) (fpbr-symbol-image)))
    (defn fpbr-envelope ()
        (do
            (let pif (fpbr-pif))
            (let source (pif-source-from-envelope pif))
            (let fkb (pif-descriptor-from-envelope pif))
            (rale-envelope-from-selection source fkb (sad-no-artifact)
                (ras-selection-from-plan
                    (rap-plan-from-descriptors source fkb (sad-no-artifact))))))
    (defn fpbr-admission ()
        (do
            (let pif (fpbr-pif))
            (let payload
                (pifbd-payload
                    (pif-envelope-source-path pif)
                    (pif-envelope-source-hash pif)
                    (pif-envelope-source-mtime pif)
                    (pif-envelope-artifact-path pif)
                    (pif-envelope-seal-ok pif)
                    (pif-envelope-table pif)
                    (pif-envelope-symbol-image pif)))
            (pifbd-admission
                (list "scannerless-request-birth-admission")
                (pifbd-decoded-row payload 1)
                pif (pifbd-status-admitted) (pifbd-reason-admitted))))

    ; Exact image recipe, call, grant, raw OFFER, and receiver are all retained
    ; so fpcpf-receipt-observed? can repeat the same full walk.
    (defn fpbr-callee-binding ()
        (fpcpf-binding (fpbr-symbol)
            (fpcpf-pirc-envelope (fpbr-pif))))
    (defn fpbr-caller-binding ()
        (fpcpf-binding "scannerless/request-frame-caller"
            (fpcpf-pirc-envelope (fpbr-pif))))
    (defn fpbr-capability ()
        (fcatw-sequence "scannerless-request-birth-capability-v1"
            (list (fpbr-callee-binding))))
    (defn fpbr-call ()
        (fpcpf-call-binding (fpbr-caller-binding) "consume-one-frame"
            (fpbr-callee-binding) (fpbr-capability)))
    (defn fpbr-protocol ()
        (fpcpf-registry
            (list (fpbr-caller-binding) (fpbr-callee-binding))
            (list (fpbr-capability))
            (list (fpbr-call))))
    (defn fpbr-receiver ()
        (fpcpf-receiver (fpbr-callee-binding)
            (fpbr-envelope) (fpbr-admission)
            (pise-request-by-canonical-key (fpbr-symbol))))
    (defn fpbr-offer (surface fuel correlation)
        (fpcpf-offer (fpbr-call) correlation
            (list (fpcpf-value (rpmw-kind-string) surface)) fuel))
    (defn fpbr-execute (surface fuel correlation)
        (do
            (let offer (fpbr-offer surface fuel correlation))
            (fpcpf-execute (fpbr-protocol) offer (fpbr-receiver))))

    0)
