; source-compiler-runtime-image.fk -- explicit sibling-carrier .fkb emission.
;
; Pure source compilation lives in source-compiler.fk and runs on fkwu.  This
; optional late module changes only fsc-compile-section: it persists the Recipe
; with write_form_binary and returns a walk_recipe_here load driver.  Those
; operations remain genuine Go/Rust/TypeScript carrier capabilities and stay
; loud on fkwu; nothing is stubbed or reported written when it was not.
;
; preludes: form-stdlib/source-compiler.fk

(do
    (defn fsc-section-image-path (out-path dialect-name)
        (str_concat out-path (str_concat "." (str_concat dialect-name ".fkb"))))

    (defn fsc-section-load-driver (path)
        (str_concat "(walk_recipe_here (read_form_binary "
            (str_concat (fsc-q path) "))\n")))

    (defn fsc-compile-section (dialect-name body out-path)
        (do
            (let recipe (fsc-compile-section-recipe dialect-name body))
            (let image-path (fsc-section-image-path out-path dialect-name))
            (let wrote (write_form_binary image-path recipe))
            (if (le wrote 0)
                (fsc-compiler-error
                    (str_concat "failed to write section image: " image-path))
                (fsc-section-load-driver image-path))))
    0)
