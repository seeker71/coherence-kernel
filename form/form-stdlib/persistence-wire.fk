; persistence-wire.fk — the store's file door, split out of persistence.fk
; 2026-08-28.
;
; preludes: form-stdlib/core.fk form-stdlib/channel.fk form-stdlib/channel-wire.fk form-stdlib/persistence.fk
;
; WHY THIS IS ITS OWN CELL. cell-store-create / cell-put / store-cells /
; lookup-cell are the only things in the persistence layer that open a store
; file. They reach it through channel-create / channel-append / channel-read,
; which reach read_form_binary / write_form_binary — natives that go / rust / ts
; carry and fkwu does not.
;
; This split is the second half of one repair. channel-wire.fk (same day) took
; the door out of channel.fk; without this cell persistence.fk would simply have
; become the door's new mouth, because it preludes channel-wire.fk for its own
; four calls and forty-odd cells prelude persistence.fk for the CELL shape alone
; — mesh-organ-senses, gpu-mesh-sense, mesh-quorum, sense-loop, mesh-sensings,
; loop-stewardship, world-model-growth, fleet-fathom and organ-reading among
; them, each measured cold carrying exactly the same four unresolved calls with
; a verdict that already agreed on all four arms. Closing one mouth and opening
; another moves a wound; it does not heal it.
;
; What stays in persistence.fk is everything that is only shape: CELL-V0, the
; ps- list helpers, make-cell-recipe, the cell accessors, ps-msgs-to-cells,
; ps-scan, cell-found? and cell-of. A list needs no host.
;
; Same repair as cache-binary.fk (2026-08-14) and symbols-wire.fk (2026-08-28):
; a cell should not hand its callers a door they did not ask for and cannot open
; on their own arm.
;
; Callers today: form-stdlib/boot.fk, form-stdlib/mesh-sensings-store.fk,
; form-stdlib/tests/boot-band.fk and form-stdlib/tests/persistence-band.fk.

;; --- store create --------------------------------------------------

;; cell-store-create — start an empty cell store at path. A store IS a
;; channel; cells are its messages. Overwrites any prior file.
(defn cell-store-create (path) (channel-create path))

;; --- write -----------------------------------------------------------

;; cell-put path name domain blueprint ctor -> cell count after write.
;; Appends a CELL message to the store; the cell is now durable on disk.
;; A re-put under the same domain plus name is last-write-wins — lookup
;; returns the most recent.
(defn cell-put (path name domain blueprint ctor)
    (channel-append path
        (channel-message (make-cell-recipe name domain blueprint ctor))))

;; --- read all ------------------------------------------------------

;; store-cells path -> list of every CELL Recipe in the store, in append
;; order. The durable lattice read back from disk. ps-msgs-to-cells, the
;; fold it hands the messages to, stays in persistence.fk.
(defn store-cells (path)
    (ps-msgs-to-cells (channel-read path) (list)))

;; --- lookup --------------------------------------------------------

;; lookup-cell path domain name -> the Form-native equivalent of Python
;; lookup_cell. Returns a list holding the cell if present, else empty.
;; ps-scan, the fold that keeps the last match, stays in persistence.fk.
(defn lookup-cell (path domain name)
    (ps-scan (store-cells path) domain name (list)))

0
