; living-world-contention-tending.fk -- disagreement may grow a local context.
;
; A participant may offer a stance toward one route of an admitted contention
; question.  The source is recovered only from the stance attribution edge;
; it is never trusted from payload.  ONE supports that route, ZERO rejects it,
; NOTHING is explicit silence, and absence remains missing.  A resolution can
; be proposed only when every current question holder actively supports the
; same route and no holder retains a conflicting active stance.
;
; The resolution is scoped to the exact question and retains the complete
; route field and stance evidence.  It neither modifies either mapping nor
; declares an endpoint globally true.  All question holders cross another
; unanimous offer/ack boundary.  Revocation or changed stance evidence makes
; the proposal stale and blocks integration.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk

(let LWCTD-STANCE            (bp "LWCTD-STANCE"))
(let LWCTD-STANCE-EVIDENCE   (bp "LWCTD-STANCE-EVIDENCE"))
(let LWCTD-RESOLUTION        (bp "LWCTD-RESOLUTION"))
(let LWCTD-RESOLUTION-ORIGIN (bp "LWCTD-RESOLUTION-ORIGIN"))

; children: question candidate, selected route, acknowledgment, offered
;           evidence, local path.  Source identity deliberately is absent.
(defn lwctd-stance (question-candidate route ack evidence)
    (intern_node LWCTD-STANCE
        (list question-candidate route ack evidence (lwo-local-path))))
(defn lwctd-stance? (cell) (lwo-category? cell LWCTD-STANCE))
(defn lwctd-stance-question (stance) (nth (node_children stance) 0))
(defn lwctd-stance-route (stance) (nth (node_children stance) 1))
(defn lwctd-stance-ack (stance) (nth (node_children stance) 2))
(defn lwctd-stance-offered-evidence (stance) (nth (node_children stance) 3))
(defn lwctd-stance-path (stance) (nth (node_children stance) 4))

(defn lwctd-stance-ack-valid? (ack)
    (if (or (eq (oac-one? ack) 1)
            (or (eq (oac-zero? ack) 1)
                (or (eq (oac-nothing? ack) 1)
                    (eq (oac-alternative-ack? ack) 1)))) 1 0))

(defn lwctd-stance-alternative? (stance)
    (oac-alternative-ack? (lwctd-stance-ack stance)))

; A timed stance stores the complete OAC-TIME-OUTCOME as its offered evidence
; and repeats the exact condensed ack in its ack slot. Immediate NOTHING has
; no such outcome; expired-to-NOTHING does.
(defn lwctd-stance-timed? (stance)
    (if (and (eq (oac-time-outcome?
                      (lwctd-stance-offered-evidence stance)) 1)
             (node_eq (lwctd-stance-ack stance)
                      (oac-time-outcome-ack
                        (lwctd-stance-offered-evidence stance)))) 1 0))

(defn lwctd-stance-expired-to-nothing? (stance)
    (if (and (eq (lwctd-stance-timed? stance) 1)
             (eq (oac-nothing?
                    (lwctd-stance-ack stance)) 1)) 1 0))

(defn lwctd-contention-question-current? (world question-candidate)
    (if (and (eq (lwen-question-candidate? question-candidate) 1)
             (and (eq (lwo-active? world question-candidate) 1)
                  (and (eq (lwen-question-current?
                               world question-candidate) 1)
                       (node_eq
                           (lwen-question-kind
                               (lwo-emergent-shape question-candidate))
                           (lwen-contention))))) 1 0))

(defn lwctd-stance-valid? (world stance)
    (if (eq (lwctd-stance? stance) 0) 0
        (do
            (let question-candidate (lwctd-stance-question stance))
            (if (and
                    (eq (lwctd-contention-question-current?
                            world question-candidate) 1)
                    (and
                        (eq (lwo-field-has?
                            (lwen-question-routes
                                (lwo-emergent-shape question-candidate))
                            (lwctd-stance-route stance)) 1)
                        (and (eq (lwctd-stance-ack-valid?
                                     (lwctd-stance-ack stance)) 1)
                             (if (eq (lwctd-stance-alternative? stance) 1)
                                 (node_eq
                                    (oac-alternative-reference
                                        (oac-payload
                                            (lwctd-stance-ack stance)))
                                    question-candidate)
                                 1)))) 1 0))))

(defn lwctd-stance-for-question?
    (world stance question-candidate)
    (if (and (eq (lwctd-stance-valid? world stance) 1)
             (node_eq (lwctd-stance-question stance)
                      question-candidate)) 1 0))

; status: 0 missing, 1 immediate silence, 2 exact support, 3 conflict,
;         4 offered alternative, 5 expired-to-nothing.
; A timeout with a declared default is classified by its condensed ack while
; retaining the timed outcome in stance evidence. Rejection of the selected
; route or support for another route conflicts.
(defn lwctd-source-route-status-items
    (world items question route source
     saw-silence saw-one saw-conflict saw-alternative saw-timeout)
    (if (eq (len items) 0)
        (if (eq saw-alternative 1) 4
            (if (eq saw-conflict 1) 3
                (if (eq saw-timeout 1) 5
                    (if (eq saw-one 1) 2
                        (if (eq saw-silence 1) 1 0)))))
        (do
            (let stance (head items))
            (if (and
                    (eq (lwctd-stance-for-question?
                            world stance question) 1)
                    (eq (lwo-active-by? world stance source) 1))
                (do
                    (let ack (lwctd-stance-ack stance))
                    (let same
                        (if (node_eq
                                (lwctd-stance-route stance) route) 1 0))
                    (lwctd-source-route-status-items world (tail items)
                        question route source
                        (if (and (eq (oac-nothing? ack) 1)
                                 (eq (lwctd-stance-timed? stance) 0))
                            1 saw-silence)
                        (if (and (eq (oac-one? ack) 1)
                                 (eq same 1)) 1 saw-one)
                        (if (or
                                (and (eq (oac-zero? ack) 1)
                                     (eq same 1))
                                (and (eq (oac-one? ack) 1)
                                     (eq same 0))) 1 saw-conflict)
                        (if (eq (lwctd-stance-alternative? stance) 1)
                            1 saw-alternative)
                        (if (eq (lwctd-stance-expired-to-nothing?
                                    stance) 1) 1 saw-timeout)))
                (lwctd-source-route-status-items world (tail items)
                    question route source
                    saw-silence saw-one saw-conflict
                    saw-alternative saw-timeout)))))

(defn lwctd-source-route-status (world question route source)
    (lwctd-source-route-status-items world
        (lwo-field-items (lwo-world-cells world))
        question route source 0 0 0 0 0))

(defn lwctd-sources-support-route? (world question route sources)
    (if (eq (len sources) 0) 1
        (if (eq (lwctd-source-route-status
                    world question route (head sources)) 2)
            (lwctd-sources-support-route?
                world question route (tail sources)) 0)))

(defn lwctd-question-sources (world question-candidate)
    (lwt-sources-from-attributions
        (lwo-field-items
            (lwo-active-attributions-for world question-candidate))
        (lwo-empty-field)))

(defn lwctd-route-ready? (world question-candidate route)
    (if (eq (lwctd-contention-question-current?
                world question-candidate) 0) 0
        (do
            (let question (lwo-emergent-shape question-candidate))
            (if (eq (lwo-field-has?
                        (lwen-question-routes question) route) 0) 0
                (lwctd-sources-support-route? world question-candidate route
                    (lwo-field-items
                        (lwctd-question-sources
                            world question-candidate)))))))

(defn lwctd-stance-evidence (stance attributions)
    (intern_node LWCTD-STANCE-EVIDENCE (list stance attributions)))
(defn lwctd-stance-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwctd-evidence-items (world items question acc)
    (if (eq (len items) 0) acc
        (do
            (let stance (head items))
            (lwctd-evidence-items world (tail items) question
                (if (and
                        (eq (lwctd-stance-for-question?
                                world stance question) 1)
                        (eq (lwo-active? world stance) 1))
                    (lwo-field-add acc
                        (lwctd-stance-evidence stance
                            (lwo-active-attributions-for world stance)))
                    acc)))))

(defn lwctd-evidence-for (world question)
    (lwctd-evidence-items world
        (lwo-field-items (lwo-world-cells world)) question
        (lwo-empty-field)))

(defn lwctd-evidence-witnesses-items (items acc)
    (if (eq (len items) 0) acc
        (lwctd-evidence-witnesses-items (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lwctd-stance-evidence-attributions (head items))) acc))))

(defn lwctd-resolution-witnesses (world question evidence)
    (lwctd-evidence-witnesses-items
        (lwo-field-items evidence)
        (lwo-active-attributions-for world question)))

; children: question, selected route, complete active stance evidence,
;           original alternatives, question attributions, local path
(defn lwctd-resolution (world question route evidence)
    (intern_node LWCTD-RESOLUTION
        (list question route evidence
              (lwen-question-routes (lwo-emergent-shape question))
              (lwo-active-attributions-for world question)
              (lwo-local-path))))
(defn lwctd-resolution? (cell) (lwo-category? cell LWCTD-RESOLUTION))
(defn lwctd-resolution-question (resolution) (nth (node_children resolution) 0))
(defn lwctd-resolution-route (resolution) (nth (node_children resolution) 1))
(defn lwctd-resolution-evidence (resolution) (nth (node_children resolution) 2))
(defn lwctd-resolution-alternatives (resolution) (nth (node_children resolution) 3))
(defn lwctd-resolution-question-attributions (resolution)
    (nth (node_children resolution) 4))
(defn lwctd-resolution-path (resolution) (nth (node_children resolution) 5))

(defn lwctd-resolution-origin (resolution witnesses)
    (intern_node LWCTD-RESOLUTION-ORIGIN (list resolution witnesses)))

(defn lwctd-resolution-proposal (world question route)
    (if (eq (lwctd-route-ready? world question route) 0) (lwo-none)
        (do
            (let evidence (lwctd-evidence-for world question))
            (let witnesses
                (lwctd-resolution-witnesses world question evidence))
            (let resolution
                (lwctd-resolution world question route evidence))
            (let origin (lwctd-resolution-origin resolution witnesses))
            (let candidate
                (lwo-emergent resolution witnesses
                    (intern_trivial_int
                        (lwo-field-size
                            (lwctd-question-sources world question)))
                    (intern_trivial_int (lwo-field-size evidence))
                    (intern_trivial_int (lwo-field-size witnesses))
                    origin))
            (lwt-proposal candidate
                (lwctd-question-sources world question) origin))))

(defn lwctd-resolution-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwctd-resolution?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwctd-resolution-current? (world candidate)
    (if (eq (lwctd-resolution-candidate? candidate) 0) 0
        (do
            (let resolution (lwo-emergent-shape candidate))
            (let fresh
                (lwctd-resolution-proposal world
                    (lwctd-resolution-question resolution)
                    (lwctd-resolution-route resolution)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))

(defn lwctd-resolution-steady? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwctd-resolution-current? world candidate) 1)) 1 0))

(defn lwctd-active-resolution-for-items? (world items question)
    (if (eq (len items) 0) 0
        (do
            (let candidate (head items))
            (if (and (eq (lwctd-resolution-candidate? candidate) 1)
                     (and (eq (lwctd-resolution-steady?
                                  world candidate) 1)
                          (node_eq
                            (lwctd-resolution-question
                                (lwo-emergent-shape candidate))
                            question)))
                1
                (lwctd-active-resolution-for-items?
                    world (tail items) question)))))

(defn lwctd-active-resolution-for? (world question)
    (lwctd-active-resolution-for-items? world
        (lwo-field-items (lwo-world-cells world)) question))

(defn lwctd-proposals-for-routes (world question routes acc)
    (if (eq (len routes) 0) acc
        (do
            (let proposal
                (lwctd-resolution-proposal
                    world question (head routes)))
            (lwctd-proposals-for-routes world question (tail routes)
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwctd-resolution-proposals-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let question (head items))
            (lwctd-resolution-proposals-items world (tail items)
                (if (or
                        (eq (lwctd-contention-question-current?
                                world question) 0)
                        (eq (lwctd-active-resolution-for?
                                world question) 1)) acc
                    (lwctd-proposals-for-routes world question
                        (lwo-field-items
                            (lwen-question-routes
                                (lwo-emergent-shape question))) acc))))))

(defn lwctd-resolution-proposals (world)
    (lwctd-resolution-proposals-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwctd-integrate-resolution (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwctd-resolution-current?
                    (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
