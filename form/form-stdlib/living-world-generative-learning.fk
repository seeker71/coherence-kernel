; living-world-generative-learning.fk -- observed voice may reopen the field.
;
; A participant may offer an outcome for one exact native continuation trace.
; The outcome carries no task name, language tag, answer class, vocabulary, or
; remote route: only the trace, an optional expected link, an optional observed
; link, an optional coordinate and surface, its four-arm acknowledgment,
; optional live lens declaration, alternatives, unknown, and evidence.
;
; Exact outcome recurrence may propose a learning plan.  Every active outcome
; holder governs that proposal.  Even an integrated plan cannot add a
; transition or surface to the world: it can only describe exact ordinary
; observations which participants must re-offer through the existing living
; membrane.  The transition must become independently current before a surface
; observation can be described.  This keeps feedback, structural learning,
; expression learning, and outward voice as separate authority boundaries.
;
; A proposal is fresh only while the trace it answers is current.  Once its
; plan is admitted, the plan may remain active while its own re-offered
; transition changes that trace; its evidence snapshot still has to remain
; current.  Revocation therefore releases the learning plan without silently
; revoking transition or expression cells that holders separately re-offered.
;
; witnessed: 2026-08-09 -> 1048575 on fkwu
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-generative-continuation.fk

(let LWGL-OUTCOME (bp "LWGL-OUTCOME"))
(let LWGL-PLAN    (bp "LWGL-PLAN"))
(let LWGL-ORIGIN  (bp "LWGL-ORIGIN"))

; children: exact trace, optional expected link, optional observed link,
; optional coordinate, optional exact surface string, four-arm acknowledgment,
; optional declaration, alternatives, optional unknown, evidence, local path
(defn lwgl-outcome
    (trace expected observed coordinate surface ack declaration alternatives
     unknown evidence)
    (intern_node LWGL-OUTCOME
        (list trace expected observed coordinate surface ack declaration
              alternatives unknown evidence (lwo-local-path))))
(defn lwgl-outcome? (cell)
    (if (and (eq (lwo-category? cell LWGL-OUTCOME) 1)
             (eq (len (node_children cell)) 11)) 1 0))
(defn lwgl-outcome-trace (outcome) (nth (node_children outcome) 0))
(defn lwgl-outcome-expected (outcome) (nth (node_children outcome) 1))
(defn lwgl-outcome-observed (outcome) (nth (node_children outcome) 2))
(defn lwgl-outcome-coordinate (outcome) (nth (node_children outcome) 3))
(defn lwgl-outcome-surface-cell (outcome) (nth (node_children outcome) 4))
(defn lwgl-outcome-surface (outcome)
    (node_value (lwgl-outcome-surface-cell outcome)))
(defn lwgl-outcome-ack (outcome) (nth (node_children outcome) 5))
(defn lwgl-outcome-declaration (outcome) (nth (node_children outcome) 6))
(defn lwgl-outcome-alternatives (outcome) (nth (node_children outcome) 7))
(defn lwgl-outcome-unknown (outcome) (nth (node_children outcome) 8))
(defn lwgl-outcome-evidence (outcome) (nth (node_children outcome) 9))
(defn lwgl-outcome-path (outcome) (nth (node_children outcome) 10))

(defn lwgl-string-cell? (cell)
    (if (and (eq (node_level cell) 1)
             (eq (node_type cell) 2)) 1 0))
(defn lwgl-optional-link-valid? (link)
    (if (node_eq link (lwo-none)) 1 (lwsg-link-valid? link)))
(defn lwgl-optional-surface-valid? (surface)
    (if (node_eq surface (lwo-none)) 1 (lwgl-string-cell? surface)))
(defn lwgl-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))

(defn lwgl-one-coherent? (outcome)
    (do
        (let expected (lwgl-outcome-expected outcome))
        (let observed (lwgl-outcome-observed outcome))
        (if (or (node_eq observed (lwo-none))
                (not (node_eq (oac-payload
                                (lwgl-outcome-ack outcome)) observed))) 0
            (if (node_eq expected (lwo-none)) 1
                (if (node_eq expected observed) 1 0)))))

(defn lwgl-zero-coherent? (outcome)
    (do
        (let expected (lwgl-outcome-expected outcome))
        (let observed (lwgl-outcome-observed outcome))
        (if (or (node_eq expected (lwo-none))
                (or (node_eq observed (lwo-none))
                    (node_eq expected observed))) 0 1)))

(defn lwgl-nothing-coherent? (outcome)
    (if (and (node_eq (lwgl-outcome-observed outcome) (lwo-none))
             (node_eq (lwgl-outcome-surface-cell outcome) (lwo-none))) 1 0))

(defn lwgl-alternative-coherent? (outcome)
    (do
        (let alternative (oac-payload (lwgl-outcome-ack outcome)))
        (if (and (node_eq (oac-alternative-reference alternative)
                          (lwgl-outcome-trace outcome))
                 (node_eq (oac-alternative-offered alternative)
                          (lwgl-outcome-observed outcome))) 1 0)))

(defn lwgl-other-node-coherent? (outcome)
    (if (and (node_eq (lwgl-outcome-observed outcome) (lwo-none))
             (node_eq (lwgl-outcome-surface-cell outcome) (lwo-none))) 1 0))

(defn lwgl-ack-coherent? (outcome)
    (do
        (let ack (lwgl-outcome-ack outcome))
        (if (eq (oac-one? ack) 1) (lwgl-one-coherent? outcome)
            (if (eq (oac-zero? ack) 1) (lwgl-zero-coherent? outcome)
                (if (eq (oac-nothing? ack) 1)
                    (lwgl-nothing-coherent? outcome)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwgl-alternative-coherent? outcome)
                        (lwgl-other-node-coherent? outcome)))))))

(defn lwgl-outcome-valid? (outcome)
    (if (eq (lwgl-outcome? outcome) 0) 0
        (if (eq (lwsg-trace? (lwgl-outcome-trace outcome)) 0) 0
            (if (eq (lwgl-optional-link-valid?
                        (lwgl-outcome-expected outcome)) 0) 0
                (if (eq (lwgl-optional-link-valid?
                            (lwgl-outcome-observed outcome)) 0) 0
                    (if (eq (lwgl-optional-surface-valid?
                                (lwgl-outcome-surface-cell outcome)) 0) 0
                        (if (eq (oac-valid-ack?
                                    (lwgl-outcome-ack outcome)) 0) 0
                            (if (eq (lwgl-optional-declaration-valid?
                                      (lwgl-outcome-declaration outcome)) 0) 0
                                (if (eq (lwo-category?
                                          (lwgl-outcome-alternatives outcome)
                                          LWO-FIELD) 0) 0
                                    (if (eq (lwsg-unknown-valid?
                                              (lwgl-outcome-unknown outcome)) 0)
                                        0
                                        (lwgl-ack-coherent?
                                            outcome)))))))))))

(defn lwgl-outcome-current? (world outcome)
    (if (and (eq (lwgl-outcome-valid? outcome) 1)
             (and (eq (lwo-active? world outcome) 1)
                  (eq (lwsg-trace-current?
                        world (lwgl-outcome-trace outcome)) 1))) 1 0))

(defn lwgl-learnable? (outcome)
    (if (or (eq (oac-one? (lwgl-outcome-ack outcome)) 1)
            (or (eq (oac-zero? (lwgl-outcome-ack outcome)) 1)
                (eq (oac-alternative-ack?
                      (lwgl-outcome-ack outcome)) 1))) 1 0))

(defn lwgl-transition-for-outcome (outcome)
    (if (or (eq (lwgl-learnable? outcome) 0)
            (node_eq (lwgl-outcome-observed outcome) (lwo-none)))
        (lwo-none)
        (lwtf-observation
            (lwsg-request-context
                (lwsg-trace-request (lwgl-outcome-trace outcome)))
            (lwgl-outcome-observed outcome)
            (lwsg-link-lens (lwgl-outcome-observed outcome)))))

(defn lwgl-witnesses (world outcome)
    (lwo-active-attributions-for world outcome))

; children: exact outcome, optional transition observation, optional coordinate,
; optional surface, exact acknowledgment, declaration, alternatives, unknown,
; exact attribution witnesses, recurrence threshold, local path
(defn lwgl-plan-cell
    (outcome transition witnesses threshold)
    (intern_node LWGL-PLAN
        (list outcome transition
              (lwgl-outcome-coordinate outcome)
              (lwgl-outcome-surface-cell outcome)
              (lwgl-outcome-ack outcome)
              (lwgl-outcome-declaration outcome)
              (lwgl-outcome-alternatives outcome)
              (lwgl-outcome-unknown outcome)
              witnesses (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwgl-plan? (cell)
    (if (and (eq (lwo-category? cell LWGL-PLAN) 1)
             (eq (len (node_children cell)) 11)) 1 0))
(defn lwgl-plan-outcome (plan) (nth (node_children plan) 0))
(defn lwgl-plan-transition (plan) (nth (node_children plan) 1))
(defn lwgl-plan-coordinate (plan) (nth (node_children plan) 2))
(defn lwgl-plan-surface-cell (plan) (nth (node_children plan) 3))
(defn lwgl-plan-surface (plan) (node_value (lwgl-plan-surface-cell plan)))
(defn lwgl-plan-ack (plan) (nth (node_children plan) 4))
(defn lwgl-plan-declaration (plan) (nth (node_children plan) 5))
(defn lwgl-plan-alternatives (plan) (nth (node_children plan) 6))
(defn lwgl-plan-unknown (plan) (nth (node_children plan) 7))
(defn lwgl-plan-witnesses (plan) (nth (node_children plan) 8))
(defn lwgl-plan-threshold (plan)
    (node_value (nth (node_children plan) 9)))
(defn lwgl-plan-path (plan) (nth (node_children plan) 10))

(defn lwgl-plan-for (world outcome threshold)
    (if (or (lt threshold 1)
            (eq (lwgl-outcome-current? world outcome) 0)) (lwo-none)
        (do
            (let witnesses (lwgl-witnesses world outcome))
            (if (lt (lwo-field-size witnesses) threshold) (lwo-none)
                (lwgl-plan-cell outcome
                    (lwgl-transition-for-outcome outcome)
                    witnesses threshold)))))

(defn lwgl-origin (outcome threshold)
    (intern_node LWGL-ORIGIN
        (list outcome (intern_trivial_int threshold) (lwo-local-path))))

(defn lwgl-proposal-for (world outcome threshold)
    (do
        (let plan (lwgl-plan-for world outcome threshold))
        (if (node_eq plan (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwgl-plan-witnesses plan))
                (let count (lwo-field-size witnesses))
                (let origin (lwgl-origin outcome threshold))
                (let candidate
                    (lwo-emergent plan witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int threshold) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwgl-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwgl-plan? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwgl-candidate-fresh? (world candidate)
    (if (eq (lwgl-candidate? candidate) 0) 0
        (do
            (let plan (lwo-emergent-shape candidate))
            (let fresh
                (lwgl-proposal-for world
                    (lwgl-plan-outcome plan)
                    (lwgl-plan-threshold plan)))
            (if (node_eq fresh (lwo-none)) 0
                (if (node_eq candidate
                        (lwt-proposal-candidate fresh)) 1 0)))))

(defn lwgl-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwgl-candidate-fresh? world
            (lwt-proposal-candidate proposal))))

(defn lwgl-integrate (round proposal action)
    (if (eq (lwgl-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; Once a fresh plan crossed its membrane, its exact feedback evidence remains
; the currentness boundary.  The old trace may become stale because the plan's
; separately re-offered transition changed the answer it originally observed.
(defn lwgl-candidate-active? (world candidate)
    (if (and (eq (lwgl-candidate? candidate) 1)
             (eq (lwo-active? world candidate) 1))
        (do
            (let plan (lwo-emergent-shape candidate))
            (let outcome (lwgl-plan-outcome plan))
            (let witnesses (lwgl-witnesses world outcome))
            (if (and (eq (lwgl-outcome-valid? outcome) 1)
                     (and (eq (lwo-active? world outcome) 1)
                          (and (node_eq witnesses
                                (lwgl-plan-witnesses plan))
                               (ge (lwo-field-size witnesses)
                                   (lwgl-plan-threshold plan))))) 1 0))
        0))

(defn lwgl-transition-successor (world candidate)
    (if (eq (lwgl-candidate-active? world candidate) 0) (lwo-none)
        (lwgl-plan-transition (lwo-emergent-shape candidate))))

(defn lwgl-transition-candidate (world plan)
    (do
        (let proposal
            (lwtf-proposal-for world
                (lwgl-plan-transition plan)
                (lwgl-plan-threshold plan)))
        (if (node_eq proposal (lwo-none)) (lwo-none)
            (lwt-proposal-candidate proposal))))

(defn lwgl-expression-successor (world candidate)
    (if (eq (lwgl-candidate-active? world candidate) 0) (lwo-none)
        (do
            (let plan (lwo-emergent-shape candidate))
            (if (or (node_eq (lwgl-plan-transition plan) (lwo-none))
                    (node_eq (lwgl-plan-surface-cell plan) (lwo-none)))
                (lwo-none)
                (do
                    (let transition-candidate
                        (lwgl-transition-candidate world plan))
                    (if (or (node_eq transition-candidate (lwo-none))
                            (eq (lwtf-integrated-current?
                                  world transition-candidate) 0))
                        (lwo-none)
                        (do
                            (let derivation
                                (lwtf-derivation world transition-candidate))
                            (lwsl-observation-at derivation
                                (lwgl-plan-coordinate plan)
                                (lwgl-plan-surface plan)
                                (lwgl-plan-declaration plan)
                                (oac-one derivation) candidate))))))))

(defn lwgl-progress-target (proposal)
    (if (node_eq proposal (lwo-none)) "proposal:nothing"
        (do
            (let plan
                (lwo-emergent-shape
                    (lwt-proposal-candidate proposal)))
            (lcfb-cat (list
                "witnesses:"
                (int_to_str (lwo-field-size (lwgl-plan-witnesses plan)))
                ":ack:" (int_to_str (oac-kind (lwgl-plan-ack plan)))
                ":transition:"
                (int_to_str
                    (if (node_eq (lwgl-plan-transition plan)
                                 (lwo-none)) 0 1))
                ":surface:"
                (int_to_str
                    (if (node_eq (lwgl-plan-surface-cell plan)
                                 (lwo-none)) 0 1)))))))

(defn lwgl-proposal-for-observed
    (world outcome threshold started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-generative-learning"
                "outcome" "enter" "form-native" "lwgl-proposal-for"
                "content-addressed-feedback" (mul ordinal 2) started
                "form/form-stdlib/living-world-generative-learning.fk"
                328 13))
        (let proposal (lwgl-proposal-for world outcome threshold))
        (let left
            (lcfb-call-stream "living-world-generative-learning"
                "plan" "modify" "form-native" "lwgl-proposal-for"
                (lwgl-progress-target proposal) (add (mul ordinal 2) 1)
                started
                "form/form-stdlib/living-world-generative-learning.fk"
                335 13))
        proposal))

(defn lwgl-integrate-observed
    (round proposal action started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-generative-learning"
                "plan" "enter" "form-native" "lwgl-integrate"
                (lwgl-progress-target proposal) (mul ordinal 2) started
                "form/form-stdlib/living-world-generative-learning.fk"
                347 13))
        (let next (lwgl-integrate round proposal action))
        (let candidate (lwt-proposal-candidate proposal))
        (let left
            (lcfb-call-stream "living-world-generative-learning"
                "field" "modify" "form-native" "lwgl-integrate"
                (lcfb-cat (list "active:"
                    (int_to_str
                        (lwgl-candidate-active?
                            (lwt-round-world next) candidate))))
                (add (mul ordinal 2) 1) started
                "form/form-stdlib/living-world-generative-learning.fk"
                355 13))
        next))
