; mla-msl.fk — Multi-head Latent Attention (mla-attn.fk) lifted to Metal kernels the BODY emits.
;
; WHY THIS EXISTS. Stone 22 proved the MLA recipe on the CPU (mla-attn.fk, band 63, against an
; independent fp64 transcription of ds4.c). Stone 1 measured the pure CPU-recipe attention lane at
; ~51 min/token for a 3B model at real width. DeepSeek-V4-Flash at real width on CPU recipes is
; infeasible. A real token needs MLA on the GPU. This file is that: the low-rank Q/KV projections, the
; two RMSNorms (embed-space and rank-space), the per-head unweighted RMSNorm, the trailing-nrot RoPE,
; the single-latent-row attention with the per-head SINK logit, the inverse-RoPE, and the grouped
; low-rank output projection — each a Metal kernel, every character authored here.
;
; THE ARITHMETIC IS THE RECIPE'S, TO THE ASSOCIATION. The determinism discipline of trig.fk and
; transformer-numerics.fk ("the recipe DEFINES the reduction order, so every kernel computes the same
; bits") is carried onto the GPU: this file does NOT call metal::exp, metal::sqrt, metal::sin. It
; transcribes tn-exp (14-term Taylor with argument halving), tn-sqrt (Newton, 50 iters from the value),
; and fsin/fcos (round-reduce + 10-term Taylor) into Metal, and it matches the FOLD DIRECTION of every
; reduction: tb-dot is a RIGHT fold (so mla_dot walks columns DESCENDING), ln-sumsq-acc / tn-sum /
; tb-weighted-acc are LEFT folds (so those loops ascend). The consequence: the ONLY difference between
; this body's fp64 answer and the GPU's f32 answer is the WORKING PRECISION — f32 vs fp64 over an
; identical operation graph — not a different approximation and not a different summation order. So the
; gate is a derived f32 bound, not a vendor-transcendental tolerance. `selfgauge`.
;
; THE SLOT (asktoll, corpus row 849). The attention kernel's thread map is ONE THREAD PER HEAD: head h
; is the thread's slot, so the per-head SINK logit sinks[h] and the softmax denominator are read/computed
; ONCE per slot and reused across all hd output dims — never recomputed per output element. That is the
; grain of the ask the recipe's shape hands us: n_head_kv = 1, one latent row shared by every query head,
; each head an independent softmax over that row set. The inverse-RoPE kernel is per-head for the same
; reason. The projection/norm kernels are one-thread-per-output-row (matvec) or one-thread (the single
; embed-space norm), the ordinary GPU shapes, kept order-identical to the recipe.
;
; NO `using namespace metal;`, ONE `#include <metal_stdlib>`. The same discipline q6k-msl.fk / mxfp4-msl.fk
; keep: emitting a second `using namespace metal;` makes this body's own `round` ambiguous and the unit
; stops compiling. This file makes ZERO metal:: library calls at all (every transcendental is
; transcribed), so nothing needs qualifying; the header is emitted once by mla-msl-unit.
;
; THE RADIUS THIS CELL SPEAKS FOR (aporon) — read it before believing the gate.
;   * NOT bit-exact. f32 vs fp64 over transcendentals cannot be bit-exact; the claim is agreement within
;     a stated f32 bound on a >=2-position example that exercises RoPE (RoPE is the identity at pos 0 —
;     hushfold, corpus row 865 — so a one-position test cannot witness it; the demo runs positions 0,1,2).
;   * NOT the real dims. The demo is E=4, R=3, nh=2, hd=4, nrot=2, ng=2; V4-Flash is nh=64, hd=512,
;     nrot=64, n_embd=4096, 43 layers. The kernels are dim-generic (rows/cols/nh/hd are runtime uniforms)
;     but no gate here has SEEN the real dims. The attend kernel's per-head accumulator is a private
;     array capped at MLA_MAX_HD (512, = V4-Flash's head_dim); above that it is WRONG, not slow.
;   * NOT YaRN, NOT the E4M3 cache encoding, NOT the residual/MoE half of the layer, NOT a resident
;     real weight tensor. Same gaps mla-attn.fk's radius names. This is the attention block's arithmetic,
;     on the GPU, once, at toy rank.
;   * mla_round is a range-reduce that is exact only while |x| stays within a few periods of 2*pi (it
;     rounds by truncation, no metal::rint). The demo's rope angles are pos*base^(-2k/nrot) with
;     pos in {0,1,2} and base 10000, i.e. |angle| <= 2 — never near a half-integer of TAU. Real positions
;     in the thousands need a proper round; named, not hidden.
;   * The pair FREQUENCIES base^(-2k/nrot) are precomputed by the body (rope-freq-theta -> fpow -> math_exp)
;     and handed to the rope kernel as a small buffer: the kernel computes angle = pos*freq and the
;     rotation and its trig, but not the frequency table. That table is position-INDEPENDENT layout, so
;     computing it once on the host is the honest split, and it is stated here.
;
; Kin: mla-attn.fk (the CPU recipe this equals — mla_dot mirrors tb-dot's right fold, the attend kernel
; mirrors mla-attend-head's sink softmax), mxfp4-msl.fk / qk-matvec-slot.fk (the emit idiom, the slot
; discipline, the read-back-into-Form gate, the no-header rule), trig.fk / transformer-numerics.fk (the
; deterministic series this transcribes), mla-demo.fk (the shared toy fixture and the reference printers).
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/mla-msl-band.fk (the emitted text: one header, no using-namespace, one
;            spine, every kernel present, the structural index maps against the recipe's slicing) and
;            form/native/metal/metal_mla_gpu.sh (the GPU, Mac-only: every stage and the reassembled
;            cache-row and block-output against the fp64 recipe at positions 0,1,2 within the f32 bound).

(do
    ; ================= the structural index maps, read back into Form =================
    ; The offsets the emitted kernels compute, in Form, so mla-msl-band.fk can falsify the TEXT's
    ; indexing against mla-attn.fk's own slicing (tb-vslice h*hd, the tail at hd-nrot, the grouped
    ; g*gdim) rather than trust that the C string got them right. A transposed offset that compiles and
    ; runs is the failure this guards (q6k-msl.fk's read-back lesson).
    (defn mlm-head-base (h hd) (mul h hd))              ; head h's slice start in an nh*hd vector
    (defn mlm-nnope (hd nrot) (sub hd nrot))            ; the non-rotated front width
    (defn mlm-pair-lo (h hd nnope k) (add (mul h hd) (add nnope (mul 2 k))))  ; pair k's first index
    (defn mlm-npair (nrot) (div nrot 2))
    (defn mlm-gout-base (g gdim) (mul g gdim))          ; group g's slice start (grouped output)
    (defn mlm-gdim (nh ng hd) (mul (div nh ng) hd))     ; each group's width = (nh/ng)*hd

    ; ================= the emitted MSL =================
    ; One fragment per meaning, composed by str_concat, so a diff of the emitted text points at a recipe.

    ; --- the numerics spine: abs, Newton sqrt (tn-sqrt), Taylor exp (tn-exp), round-reduced sin/cos
    ;     (fsin/fcos), and the RIGHT-fold dot (tb-dot). Emitted ONCE for the whole unit. ---
    (defn mla-msl-spine ()
        "static inline float mla_abs(float x) { return (x < 0.0f) ? -x : x; } static inline float mla_sqrt(float v) { if (v <= 0.0f) return 0.0f; float g = v; for (int n = 0; n < 50; ++n) { g = 0.5f * (g + v / g); } return g; } static inline float mla_exp_small(float x) { float term = 1.0f; float acc = 1.0f; for (int n = 1; n <= 14; ++n) { term = term * (x / float(n)); acc = acc + term; } return acc; } static inline float mla_pow2k(float v, int k) { for (int i = 0; i < k; ++i) v = v * v; return v; } static inline float mla_exp(float x) { float a = x; int k = 0; while (mla_abs(a) > 0.5f) { a = a * 0.5f; k = k + 1; } return mla_pow2k(mla_exp_small(a), k); } static inline float mla_round(float z) { return float(int(z + ((z >= 0.0f) ? 0.5f : -0.5f))); } static inline float mla_sin(float x) { float r = x - 6.283185307179586f * mla_round(x / 6.283185307179586f); float x2 = r * r; float term = r; float acc = 0.0f; for (int k = 0; k < 10; ++k) { acc = acc + term; term = (term * -1.0f * x2) / (float(2 * (k + 1)) * float(2 * (k + 1) + 1)); } return acc; } static inline float mla_cos(float x) { return mla_sin(x + 1.5707963267948966f); } static inline float mla_dot(device const float* a, device const float* b, uint n) { float acc = 0.0f; for (int c = int(n) - 1; c >= 0; --c) acc = a[uint(c)] * b[uint(c)] + acc; return acc; } static inline float mla_dot4(device const float* a, device const float* b, uint n) { float acc = 0.0f; int c = int(n) - 1; for (; c >= 3; c -= 4) { float4 av = float4(*(device const packed_float4*)(a + (c - 3))); float4 bv = float4(*(device const packed_float4*)(b + (c - 3))); acc = av.w * bv.w + acc; acc = av.z * bv.z + acc; acc = av.y * bv.y + acc; acc = av.x * bv.x + acc; } for (; c >= 0; --c) acc = a[uint(c)] * b[uint(c)] + acc; return acc; } ")

    ; --- kernel: the weighted RMSNorm (ln-rmsnorm), embed-space or rank-space. sumsq is ln-sumsq-acc's
    ;     LEFT fold (ascending); out = (x * (1/rms)) * g, matching tn-scale then ln-mul2. One thread. ---
    (defn mla-rmsnorm-body ()
        "kernel void form_mla_rmsnorm_f32(device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* out [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& eps [[buffer(4)]], uint i [[thread_position_in_grid]]) { if (i != 0u) return; float sumsq = 0.0f; for (uint j = 0u; j < n; ++j) sumsq = sumsq + x[j] * x[j]; float ms = sumsq / float(n); float rms = mla_sqrt(ms + eps); float inv = 1.0f / rms; for (uint j = 0u; j < n; ++j) out[j] = (x[j] * inv) * g[j]; } ")

    ; --- THE SAME WEIGHTED NORM, SPLIT AND FOLDED ACROSS A SIMDGROUP. Profiling named the one-thread
    ;     version the second most expensive kernel in the whole stack: 1232 calls a run, each walking
    ;     4096 elements twice on a single lane. ds4 accumulates this sum of squares in DOUBLE
    ;     (ds4.c:6638), so a lone f32 chain is not the faithful shape either — thirty-two lanes over
    ;     contiguous slices, combined by simd_sum, both shortens every chain and shortens the wall.
    ;     The apply half has no association to preserve and becomes one thread per element. ---
    (defn mla-rmsnorm-reduce-body ()
        "kernel void form_mla_rmsnorm_reduce_f32(device const float* x [[buffer(0)]], device float* inv [[buffer(1)]], constant uint& n [[buffer(2)]], constant float& eps [[buffer(3)]], uint lane [[thread_position_in_grid]]) { if (lane >= 32u) return; uint per = (n + 31u) / 32u; uint lo = lane * per; uint hi = (lo + per < n) ? (lo + per) : n; float s = 0.0f; for (uint j = lo; j < hi; ++j) s = s + x[j] * x[j]; float sumsq = metal::simd_sum(s); if (lane != 0u) return; float ms = sumsq / float(n); inv[0] = 1.0f / mla_sqrt(ms + eps); } ")
    (defn mla-rmsnorm-apply-body ()
        "kernel void form_mla_rmsnorm_apply_f32(device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* out [[buffer(2)]], device const float* inv [[buffer(3)]], constant uint& n [[buffer(4)]], uint j [[thread_position_in_grid]]) { if (j >= n) return; out[j] = (x[j] * inv[0]) * g[j]; } ")

    ; --- kernel: the RMSNorm the ORACLE actually writes (metal/norm.metal kernel_rms_norm_fuse_impl).
    ;     Read there, not inferred: ds4 gives a row ONE THREADGROUP, strides every thread over the row,
    ;     folds with simd_sum and a second simd_sum across the simdgroups' partials, and then applies
    ;     the scale IN THE SAME KERNEL. Two things ours had that the reference does not: a 32-lane
    ;     ceiling on a 4096-wide row, and a second dispatch to apply what the first one found. The fold
    ;     association is the reference's own, so this is not a liberty taken — it is the recipe read. ---
    (defn mla-rmsnorm-wide-body ()
        "kernel void form_mla_rmsnorm_wide_f32(device const float* x [[buffer(0)]], device const float* g [[buffer(1)]], device float* out [[buffer(2)]], constant uint& n [[buffer(3)]], constant float& eps [[buffer(4)]], ushort3 tpitg [[thread_position_in_threadgroup]], ushort3 ntg [[threads_per_threadgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]]) { threadgroup float sh[32]; if (sgitg == 0u) sh[tiisg] = 0.0f; float s = 0.0f; for (uint j = tpitg.x; j < n; j += ntg.x) { float v = x[j]; s = s + v * v; } s = metal::simd_sum(s); metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) sh[sgitg] = s; metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); s = metal::simd_sum(sh[tiisg]); float inv = 1.0f / mla_sqrt(s / float(n) + eps); if ((n & 3u) == 0u) { uint n4 = n >> 2u; for (uint j = tpitg.x; j < n4; j += ntg.x) { float4 xv = float4(*(device const packed_float4*)(x + 4u * j)); float4 gv = float4(*(device const packed_float4*)(g + 4u * j)); float4 r; r.x = (xv.x * inv) * gv.x; r.y = (xv.y * inv) * gv.y; r.z = (xv.z * inv) * gv.z; r.w = (xv.w * inv) * gv.w; *(device packed_float4*)(out + 4u * j) = packed_float4(r); } return; } for (uint j = tpitg.x; j < n; j += ntg.x) out[j] = (x[j] * inv) * g[j]; } ")

    ; --- kernel: plain f32 matvec (tb-matvec). Row r per thread; the dot is tb-dot's RIGHT fold, so the
    ;     column loop DESCENDS. Serves Wqa, Wqb, Wkv, the grouped was[g], and the final wb. ---
    (defn mla-matvec-body ()
        "kernel void form_mla_matvec_f32(device const float* W [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint r [[thread_position_in_grid]]) { if (r >= rows) return; float acc = 0.0f; for (int c = int(cols) - 1; c >= 0; --c) acc = W[r * cols + uint(c)] * x[uint(c)] + acc; y[r] = acc; } ")

    ; --- kernel: the per-head UNWEIGHTED RMSNorm (mla-head-rms, ds4's head_rms_norm_inplace). One thread
    ;     per head; g = 1, so out = x * (1/rms). ---
    (defn mla-headrms-body ()
        "kernel void form_mla_headrms_f32(device const float* q [[buffer(0)]], device float* out [[buffer(1)]], constant uint& nh [[buffer(2)]], constant uint& hd [[buffer(3)]], constant float& eps [[buffer(4)]], uint h [[thread_position_in_grid]]) { if (h >= nh) return; uint base = h * hd; float sumsq = 0.0f; for (uint j = 0u; j < hd; ++j) sumsq = sumsq + q[base + j] * q[base + j]; float ms = sumsq / float(hd); float inv = 1.0f / mla_sqrt(ms + eps); for (uint j = 0u; j < hd; ++j) out[base + j] = q[base + j] * inv; } ")

    ; --- kernel: the per-head RMSNorm in the oracle's shape. One THREADGROUP per head instead of one
    ;     THREAD: sixty-four threads were walking 512 elements twice each, reading and writing 256 KiB
    ;     at 3.6 GB/s on a device that does hundreds. tgpig.x names the head; the fold is norm.metal's. ---
    (defn mla-headrms-wide-body ()
        "kernel void form_mla_headrms_wide_f32(device const float* q [[buffer(0)]], device float* out [[buffer(1)]], constant uint& nh [[buffer(2)]], constant uint& hd [[buffer(3)]], constant float& eps [[buffer(4)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 tpitg [[thread_position_in_threadgroup]], ushort3 ntg [[threads_per_threadgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]]) { threadgroup float sh[32]; uint h = tgpig.x; if (h >= nh) return; uint base = h * hd; if (sgitg == 0u) sh[tiisg] = 0.0f; float s = 0.0f; for (uint j = tpitg.x; j < hd; j += ntg.x) { float v = q[base + j]; s = s + v * v; } s = metal::simd_sum(s); metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) sh[sgitg] = s; metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); s = metal::simd_sum(sh[tiisg]); float inv = 1.0f / mla_sqrt(s / float(hd) + eps); for (uint j = tpitg.x; j < hd; j += ntg.x) out[base + j] = q[base + j] * inv; } ")

    ; --- kernel: the trailing-nrot RoPE (mla-rope-heads / mla-rope-tail). One thread per head. The front
    ;     hd-nrot dims are copied bit-untouched; the tail is rotated pair-adjacent. sign = +1 forward
    ;     (query and cache row) and -1 inverse (the attention OUTPUT). freqs[k] = base^(-2k/nrot) is the
    ;     body's rope-freq-theta, handed in; the kernel forms angle = pos*freq and the rotation's trig. ---
    (defn mla-rope-body ()
        "kernel void form_mla_rope_f32(device const float* v [[buffer(0)]], device float* out [[buffer(1)]], device const float* freqs [[buffer(2)]], constant uint& nh [[buffer(3)]], constant uint& hd [[buffer(4)]], constant uint& nrot [[buffer(5)]], constant float& pos [[buffer(6)]], constant float& sign [[buffer(7)]], uint gid [[thread_position_in_grid]]) { if (gid >= nh * hd) return; uint h = gid / hd; uint j = gid - h * hd; uint base = h * hd; uint nnope = hd - nrot; if (j < nnope) { out[base + j] = v[base + j]; return; } uint r = j - nnope; uint npair = nrot / 2u; if (r >= 2u * npair) return; uint k = r / 2u; float a = pos * freqs[k]; float ca = mla_cos(a); float sa = sign * mla_sin(a); uint lo = base + nnope + 2u * k; float x0 = v[lo]; float x1 = v[lo + 1u]; if (r - k * 2u == 0u) { out[lo] = x0 * ca - x1 * sa; } else { out[lo + 1u] = x0 * sa + x1 * ca; } } ")

    ; --- kernel: the single-latent-row attention with the per-head SINK (mla-attend-head / mla-attn-heads).
    ;     THE SLOT: one thread per head. K and V are the SAME row (rows[j*hd..]). The sink is a learned
    ;     logit that enters the softmax DENOMINATOR ONLY (no value of its own), so a row's weights sum to
    ;     LESS than 1. Two passes in the recipe's order: (1) max over (sink :: scores); (2) exp, the LEFT
    ;     fold sum tn-sum, and the LEFT fold weighted accumulate tb-weighted-acc; denom = exp(sink-m) +
    ;     sum(e); out = acc * (1/denom). The dot is tb-dot's right fold (mla_dot). ---
    (defn mla-attend-body ()
        "kernel void form_mla_attend_f32(device const float* q [[buffer(0)]], device const float* rows [[buffer(1)]], device float* out [[buffer(2)]], device const float* sinks [[buffer(3)]], constant uint& nh [[buffer(4)]], constant uint& hd [[buffer(5)]], constant uint& nrows [[buffer(6)]], constant float& scale [[buffer(7)]], uint h [[thread_position_in_grid]]) { if (h >= nh) return; device const float* qh = q + h * hd; float sink = sinks[h]; float m = sink; for (uint j = 0u; j < nrows; ++j) { float s = scale * mla_dot(qh, rows + j * hd, hd); if (s > m) m = s; } float acc[MLA_MAX_HD]; for (uint d = 0u; d < hd; ++d) acc[d] = 0.0f; float se = 0.0f; for (uint j = 0u; j < nrows; ++j) { float s = scale * mla_dot(qh, rows + j * hd, hd); float e = mla_exp(s - m); se = se + e; device const float* rj = rows + j * hd; for (uint d = 0u; d < hd; ++d) acc[d] = acc[d] + rj[d] * e; } float denom = mla_exp(sink - m) + se; float inv = 1.0f / denom; for (uint d = 0u; d < hd; ++d) out[h * hd + d] = acc[d] * inv; } ")

    ; --- kernel: the SAME attention over TWO row arenas (ds4.c:12567 layer_attention_mixed_one). A
    ;     compressing layer attends over its raw sliding window AND the compressed rows the second cache
    ;     holds (dsv4-compressor.fk), one softmax across the union with the sink still in the denominator
    ;     only. Two buffers rather than one concatenated arena because the raw arena's frontier sentinel
    ;     is a live falsifier — appending the compressed rows into it would overwrite the evidence.
    ;     ds4's mask argument is omitted here on purpose: indexer_allowed_decode_one (:12822) returns
    ;     all-allowed whenever n_comp <= top_k, and top_k is 512, so below 2048 tokens on a ratio-4 layer
    ;     there is nothing to mask. A carrier past that must refuse, not pretend. ---
    (defn mla-attend-mixed-body ()
        "kernel void form_mla_attend_mixed_f32(device const float* q [[buffer(0)]], device const float* rows [[buffer(1)]], device const float* crows [[buffer(2)]], device float* out [[buffer(3)]], device const float* sinks [[buffer(4)]], constant uint& nh [[buffer(5)]], constant uint& hd [[buffer(6)]], constant uint& nrows [[buffer(7)]], constant uint& ncomp [[buffer(8)]], constant float& scale [[buffer(9)]], uint h [[thread_position_in_grid]]) { if (h >= nh) return; device const float* qh = q + h * hd; float sink = sinks[h]; float m = sink; for (uint j = 0u; j < nrows; ++j) { float s = scale * mla_dot(qh, rows + j * hd, hd); if (s > m) m = s; } for (uint j = 0u; j < ncomp; ++j) { float s = scale * mla_dot(qh, crows + j * hd, hd); if (s > m) m = s; } float acc[MLA_MAX_HD]; for (uint d = 0u; d < hd; ++d) acc[d] = 0.0f; float se = 0.0f; for (uint j = 0u; j < nrows; ++j) { float s = scale * mla_dot(qh, rows + j * hd, hd); float e = mla_exp(s - m); se = se + e; device const float* rj = rows + j * hd; for (uint d = 0u; d < hd; ++d) acc[d] = acc[d] + rj[d] * e; } for (uint j = 0u; j < ncomp; ++j) { float s = scale * mla_dot(qh, crows + j * hd, hd); float e = mla_exp(s - m); se = se + e; device const float* rj = crows + j * hd; for (uint d = 0u; d < hd; ++d) acc[d] = acc[d] + rj[d] * e; } float denom = mla_exp(sink - m) + se; float inv = 1.0f / denom; for (uint d = 0u; d < hd; ++d) out[h * hd + d] = acc[d] * inv; } ")

    ; THE SAME ATTENTION IN THREE STAGES, order untouched. The single-kernel form runs one thread per
    ; HEAD — 64 threads on a 40-core device — computes every score TWICE (once to find the max, once to
    ; weight it), and carries a 512-float private array that cannot live in registers. ds4 has no
    ; separate attention stage at all in its decode list; it fuses. We cannot fuse without changing the
    ; THE SCORES KERNEL READS ITS TWO VECTORS FOUR AT A TIME, and that is not a reassociation. A dot of
    ; head_dim = 512 is a thread's whole loop here — one thread to a (head, row) pair, 1024 scalar
    ; device loads per thread, and at position 30 only nh*(pos+1+ncomp) = 2432 threads to hide their
    ; latency behind. FORM_DS4_DOUBLE priced the kernel at 1.6 ms of a 39 ms token for 43 asks.
    ; mla_dot4 walks the SAME descending index — c, c-1, c-2, c-3 read out of one packed_float4 as
    ; .w, .z, .y, .x, in that order, into the same accumulator — and takes the tail scalar when n is
    ; not a multiple of four, so it is mla_dot's answer for every n and every alignment. What changes
    ; is that a thread issues a quarter of the load instructions. This is the same reading that turned
    ; the Q2_K expert kernel's thirty-six scalar loads into nine (ds4-order-match.fk).
    ; association, but we CAN stop recomputing and stop serialising:
    ;   scores: one thread per (head, row) — each dot computed ONCE
    ;   stats : one thread per head — max, exp, running sum, denominator, all in the recipe order
    ;   acc   : one thread per (head, d) — the ascending-j chain each output dim already had
    ; Every fold keeps its direction and its operands, so the answer is bit-identical; what changes is
    ; that 64 threads become 32 768 and the duplicate dot disappears.
    (defn mla-attend-split-body ()
        "kernel void form_mla_attend_scores(device const float* q [[buffer(0)]], device const float* rows [[buffer(1)]], device const float* crows [[buffer(2)]], device float* sco [[buffer(3)]], constant uint& nh [[buffer(4)]], constant uint& hd [[buffer(5)]], constant uint& nrows [[buffer(6)]], constant uint& ncomp [[buffer(7)]], constant float& scale [[buffer(8)]], uint gid [[thread_position_in_grid]]) { uint tot = nrows + ncomp; if (gid >= nh * tot) return; uint h = gid / tot; uint j = gid - h * tot; device const float* rj = (j < nrows) ? (rows + j * hd) : (crows + (j - nrows) * hd); sco[gid] = scale * mla_dot4(q + h * hd, rj, hd); } kernel void form_mla_attend_stats(device const float* sco [[buffer(0)]], device const float* sinks [[buffer(1)]], device float* ex [[buffer(2)]], device float* inv [[buffer(3)]], constant uint& nh [[buffer(4)]], constant uint& ntot [[buffer(5)]], uint h [[thread_position_in_grid]]) { if (h >= nh) return; device const float* s = sco + h * ntot; device float* e = ex + h * ntot; float sink = sinks[h]; float m = sink; for (uint j = 0u; j < ntot; ++j) { if (s[j] > m) m = s[j]; } float se = 0.0f; for (uint j = 0u; j < ntot; ++j) { float v = mla_exp(s[j] - m); e[j] = v; se = se + v; } inv[h] = 1.0f / (mla_exp(sink - m) + se); } kernel void form_mla_attend_acc(device const float* rows [[buffer(0)]], device const float* crows [[buffer(1)]], device const float* ex [[buffer(2)]], device const float* inv [[buffer(3)]], device float* out [[buffer(4)]], constant uint& nh [[buffer(5)]], constant uint& hd [[buffer(6)]], constant uint& nrows [[buffer(7)]], constant uint& ncomp [[buffer(8)]], uint gid [[thread_position_in_grid]]) { if (gid >= nh * hd) return; uint h = gid / hd; uint d = gid - h * hd; uint ntot = nrows + ncomp; device const float* e = ex + h * ntot; float acc = 0.0f; for (uint j = 0u; j < nrows; ++j) acc = acc + rows[j * hd + d] * e[j]; for (uint j = 0u; j < ncomp; ++j) acc = acc + crows[j * hd + d] * e[nrows + j]; out[gid] = acc * inv[h]; } "
)

    ; --- ONE translation unit: the body's one metal_stdlib, the MLA_MAX_HD cap, the spine once, then the
    ;     kernels. A carrier compiles exactly this; it composes nothing itself. ---
    (defn mla-msl-unit ()
        (str_concat "#include <metal_stdlib>\n#define MLA_MAX_HD 512\n"
        (str_concat (mla-msl-spine)
        (str_concat (mla-rmsnorm-body)
        (str_concat (mla-rmsnorm-reduce-body)
        (str_concat (mla-rmsnorm-apply-body)
        (str_concat (mla-matvec-body)
        (str_concat (mla-headrms-body)
        (str_concat (mla-rmsnorm-wide-body)
        (str_concat (mla-headrms-wide-body)
        (str_concat (mla-rope-body)
        (str_concat (mla-attend-body)
        (str_concat (mla-attend-mixed-body) (mla-attend-split-body))))))))))))))

    0)
