; form-recipe-native-thought-cross-cell.fk — a content-addressed recipe
; request is consumed by the scannerless BMF byte cursor, offered to the
; existing on-demand native recipe executor, then its typed execution
; observation crosses the real serialized froc channel into a distinct cell.
;
; This cell separates mechanism from effect. `frnt-bmf-consume` and the rich
; identity/lens constructors are pure. `frnt-cross-live-result` transports an
; already-observed live result. Only `frnt-run-live` invokes
; `frexl-execute-stream`, which is the existing Metal JIT/execution boundary.
;
; BMF HERE MEANS THE EXISTING BMF CURSOR. The request surface first passes
; byte-by-byte through bmf-core.fk's immutable cursor (`cur-peek`,
; `cur-advance`) with a finite budget. No token list, vocabulary, merge pass,
; line grammar, or tokenizer pre-step is constructed. The exact bytes consumed
; by that cursor are the only bytes later offered to `frexl-execute-stream`.
;
; IDENTITIES. The parsed frex request NodeID addresses exactly one recipe
; NodeID. The receiver's two lens NodeIDs each retain surface, request, recipe,
; generated-code, execution, typed observation, emitter, receiver, channel,
; and received-cell identities, plus all physical flags. Nothing is inferred
; from a fused projection.
;
; SIGNALS. A complete addressed request records choice/cut/release. A malformed
; request records choice/failure/undo/refine/cut/release. Budget exhaustion is
; timeout/cut/undo/refine/release. Execution lifecycle remains the existing
; frex trace. Present 0, present 1, and nothing remain separate fields.
;
; No mesh or model execution is claimed here. The underlying froc ack keeps
; `mesh-transported=0`; `model-executed` is copied from the actual live result.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk
; preludes: form-stdlib/form-recipe-observation-cross-cell.fk
;
; Pure/edge proof:
; form-stdlib/tests/form-recipe-native-thought-cross-cell-band.fk

(do
    ; ── identities ───────────────────────────────────────────────────
    (defn frnt-surface-category () (make_nodeid 31 2 0 79))
    (defn frnt-scan-category () (make_nodeid 31 2 0 80))
    (defn frnt-lens-category () (make_nodeid 31 2 0 81))
    (defn frnt-ack-category () (make_nodeid 31 2 0 82))
    (defn frnt-event-category () (make_nodeid 31 2 0 83))
    (defn frnt-trace-category () (make_nodeid 31 2 0 84))
    (defn frnt-stage-category () (make_nodeid 31 2 0 85))

    (defn frnt-absent () (frex-absent-token))
    (defn frnt-node-or-absent (node)
        (if (nothing? node) (frnt-absent) node))

    ; ── scannerless BMF surface and lifecycle ───────────────────────
    (defn frnt-surface (text)
        (intern_node (frnt-surface-category)
            (list (intern_trivial_string text)
                  (intern_trivial_int (str_len text))
                  (intern_trivial_int 0)
                  (intern_trivial_string "bmf-core-raw-byte-cursor-v1"))))
    (defn frnt-surface-text (surface)
        (node_value (nth (node_children surface) 0)))
    (defn frnt-surface-bytes (surface)
        (node_value (nth (node_children surface) 1)))
    (defn frnt-surface-pretokenized? (surface)
        (node_value (nth (node_children surface) 2)))

    (defn frnt-event (request recipe action signal at)
        (intern_node (frnt-event-category)
            (list (frnt-node-or-absent request)
                  (frnt-node-or-absent recipe)
                  (intern_trivial_string action)
                  (intern_trivial_string signal)
                  (intern_trivial_int at))))
    (defn frnt-event-action (event)
        (node_value (nth (node_children event) 2)))
    (defn frnt-trace (kind events)
        (intern_node (frnt-trace-category)
            (cons (intern_trivial_string kind) events)))
    (defn frnt-trace-events (trace) (tail (node_children trace)))
    (defn frnt-events-have? (events action)
        (if (eq (len events) 0) 0
            (if (str_eq (frnt-event-action (head events)) action) 1
                (frnt-events-have? (tail events) action))))
    (defn frnt-trace-has? (trace action)
        (frnt-events-have? (frnt-trace-events trace) action))
    (defn frnt-events-actions (events)
        (if (eq (len events) 0) ""
            (if (eq (len (tail events)) 0)
                (frnt-event-action (head events))
                (str_concat (frnt-event-action (head events))
                    (str_concat "," (frnt-events-actions (tail events)))))))
    (defn frnt-trace-actions (trace)
        (frnt-events-actions (frnt-trace-events trace)))
    (defn frnt-add-event (events request recipe action signal at)
        (append events (list (frnt-event request recipe action signal at))))

    (defn frnt-success-events (request recipe at)
        (do
            (let a (frnt-add-event (empty) request recipe
                                   "choice" "bmf-raw-byte-cursor" 0))
            (let b (frnt-add-event a request recipe
                                   "cut" "one-addressed-recipe" at))
            (frnt-add-event b request recipe
                            "release" "bmf-cursor-context" at)))
    (defn frnt-failure-events (request recipe reason at)
        (do
            (let a (frnt-add-event (empty) request recipe
                                   "choice" "bmf-raw-byte-cursor" 0))
            (let b (frnt-add-event a request recipe "failure" reason at))
            (let c (frnt-add-event b request recipe "undo" reason at))
            (let d (frnt-add-event c request recipe
                                   "refine" "request-surface" at))
            (let e (frnt-add-event d request recipe "cut" reason at))
            (frnt-add-event e request recipe
                            "release" "bmf-cursor-context" at)))
    (defn frnt-timeout-events (at)
        (do
            (let a (frnt-add-event (empty) (nothing) (nothing)
                                   "choice" "bmf-raw-byte-cursor" 0))
            (let b (frnt-add-event a (nothing) (nothing)
                                   "timeout" "cursor-step-budget" at))
            (let c (frnt-add-event b (nothing) (nothing)
                                   "cut" "cursor-step-budget" at))
            (let d (frnt-add-event c (nothing) (nothing)
                                   "undo" "partial-surface" at))
            (let e (frnt-add-event d (nothing) (nothing)
                                   "refine" "larger-explicit-budget" at))
            (frnt-add-event e (nothing) (nothing)
                            "release" "bmf-cursor-context" at)))

    ; fold row = state consumed cursor-position cursor
    (defn frnt-fold-row (state consumed cursor)
        (list state consumed (cur-pos cursor) cursor))
    (defn frnt-fold-state (row) (nth row 0))
    (defn frnt-fold-consumed (row) (nth row 1))
    (defn frnt-fold-position (row) (nth row 2))
    (defn frnt-bmf-fold (cursor budget consumed)
        (if (eq (cur-eof? cursor) 1)
            (frnt-fold-row "complete" consumed cursor)
            (if (le budget 0)
                (frnt-fold-row "timeout" consumed cursor)
                (frnt-bmf-fold (cur-advance cursor 1) (sub budget 1)
                    (str_concat consumed (byte_to_str (cur-peek cursor)))))))

    ; scan children:
    ; surface request recipe status reason consumed bytes position
    ; pretokenized trace
    (defn frnt-scan (surface request recipe status reason consumed position events)
        (intern_node (frnt-scan-category)
            (list surface
                  (frnt-node-or-absent request)
                  (frnt-node-or-absent recipe)
                  (intern_trivial_string status)
                  (intern_trivial_string reason)
                  (intern_trivial_string consumed)
                  (intern_trivial_int (str_len consumed))
                  (intern_trivial_int position)
                  (intern_trivial_int 0)
                  (frnt-trace "bmf-request-cursor" events))))
    (defn frnt-scan-surface (scan) (nth (node_children scan) 0))
    (defn frnt-scan-request (scan) (nth (node_children scan) 1))
    (defn frnt-scan-recipe (scan) (nth (node_children scan) 2))
    (defn frnt-scan-status (scan)
        (node_value (nth (node_children scan) 3)))
    (defn frnt-scan-reason (scan)
        (node_value (nth (node_children scan) 4)))
    (defn frnt-scan-consumed (scan)
        (node_value (nth (node_children scan) 5)))
    (defn frnt-scan-bytes (scan)
        (node_value (nth (node_children scan) 6)))
    (defn frnt-scan-position (scan)
        (node_value (nth (node_children scan) 7)))
    (defn frnt-scan-pretokenized? (scan)
        (node_value (nth (node_children scan) 8)))
    (defn frnt-scan-trace (scan) (nth (node_children scan) 9))
    (defn frnt-scan-request-row (scan)
        (frex-parse (frnt-scan-consumed scan)))

    (defn frnt-bmf-consume (text budget)
        (do
            (let surface (frnt-surface text))
            (let folded (frnt-bmf-fold (cursor-str text) budget ""))
            (if (str_eq (frnt-fold-state folded) "timeout")
                (frnt-scan surface (nothing) (nothing) "timeout"
                    "cursor-step-budget" (frnt-fold-consumed folded)
                    (frnt-fold-position folded)
                    (frnt-timeout-events (frnt-fold-position folded)))
                (do
                    (let consumed (frnt-fold-consumed folded))
                    (let request (frex-parse consumed))
                    (if (eq (frex-request-ready? request) 1)
                        (frnt-scan surface (frex-request-token request)
                            (frex-request-recipe request) "ready" "ready"
                            consumed (frnt-fold-position folded)
                            (frnt-success-events (frex-request-token request)
                                (frex-request-recipe request)
                                (frnt-fold-position folded)))
                        (frnt-scan surface (nothing) (nothing) "failure"
                            (frex-request-reason request) consumed
                            (frnt-fold-position folded)
                            (frnt-failure-events (nothing) (nothing)
                                (frex-request-reason request)
                                (frnt-fold-position folded))))))))
    (defn frnt-bmf-consume-default (text)
        (frnt-bmf-consume text (frex-max-frame-bytes)))

    (defn frnt-addressed-request? (scan)
        (if (not (str_eq (frnt-scan-status scan) "ready")) 0
        (if (not (eq (frnt-scan-pretokenized? scan) 0)) 0
        (if (not (eq (frex-request-node-valid? (frnt-scan-request scan)) 1)) 0
        (if (not (eq (frex-recipe-valid? (frnt-scan-recipe scan)) 1)) 0
        (if (not (node_eq (nth (node_children (frnt-scan-request scan)) 0)
                               (frnt-scan-recipe scan))) 0
        (if (not (eq (frnt-scan-bytes scan)
                     (frnt-scan-position scan))) 0
            (if (str_eq (frnt-scan-consumed scan)
                        (frnt-surface-text (frnt-scan-surface scan))) 1 0))))))))

    ; ── receiver's two fully attributed lenses ──────────────────────
    ; lens children:
    ; name carrier surface request recipe code execution observation
    ; emitter receiver channel received status reason result-carrier
    ; present value stream-bytes pretokenized source-generated native-generated
    ; recipe-executed model-executed buffer-released
    (defn frnt-lens (name scan live crossing-ack)
        (do
            (let pure (frexl-result-pure live))
            (intern_node (frnt-lens-category)
                (list
                    (intern_trivial_string name)
                    (intern_trivial_string (lens-carrier name))
                    (frnt-scan-surface scan)
                    (frex-result-request pure)
                    (frex-result-recipe pure)
                    (frexl-result-code live)
                    (frexl-result-execution live)
                    (frexl-result-observation live)
                    (froc-ack-emitter crossing-ack)
                    (froc-ack-receiver crossing-ack)
                    (froc-ack-channel crossing-ack)
                    (froc-ack-received crossing-ack)
                    (intern_trivial_string (frexl-result-status live))
                    (intern_trivial_string (frexl-result-reason live))
                    (intern_trivial_string (frexl-result-carrier live))
                    (intern_trivial_int (frexl-result-value-present? live))
                    (intern_trivial_int (frexl-result-value live))
                    (intern_trivial_int (frexl-result-stream-bytes live))
                    (intern_trivial_int (frexl-result-pretokenized? live))
                    (intern_trivial_int (frexl-result-source-generated? live))
                    (intern_trivial_int
                        (frexl-result-native-code-generated? live))
                    (intern_trivial_int (frexl-result-executed? live))
                    (intern_trivial_int (frexl-result-model-executed? live))
                    (intern_trivial_int
                        (frexl-result-buffer-released? live))))))
    (defn frnt-lens-name (lens)
        (node_value (nth (node_children lens) 0)))
    (defn frnt-lens-surface (lens) (nth (node_children lens) 2))
    (defn frnt-lens-request (lens) (nth (node_children lens) 3))
    (defn frnt-lens-recipe (lens) (nth (node_children lens) 4))
    (defn frnt-lens-code (lens) (nth (node_children lens) 5))
    (defn frnt-lens-execution (lens) (nth (node_children lens) 6))
    (defn frnt-lens-observation (lens) (nth (node_children lens) 7))
    (defn frnt-lens-emitter (lens) (nth (node_children lens) 8))
    (defn frnt-lens-receiver (lens) (nth (node_children lens) 9))
    (defn frnt-lens-channel (lens) (nth (node_children lens) 10))
    (defn frnt-lens-received (lens) (nth (node_children lens) 11))
    (defn frnt-lens-status (lens)
        (node_value (nth (node_children lens) 12)))
    (defn frnt-lens-reason (lens)
        (node_value (nth (node_children lens) 13)))
    (defn frnt-lens-carrier (lens)
        (node_value (nth (node_children lens) 14)))
    (defn frnt-lens-value-present? (lens)
        (node_value (nth (node_children lens) 15)))
    (defn frnt-lens-value (lens)
        (node_value (nth (node_children lens) 16)))
    (defn frnt-lens-stream-bytes (lens)
        (node_value (nth (node_children lens) 17)))
    (defn frnt-lens-pretokenized? (lens)
        (node_value (nth (node_children lens) 18)))
    (defn frnt-lens-source-generated? (lens)
        (node_value (nth (node_children lens) 19)))
    (defn frnt-lens-native-generated? (lens)
        (node_value (nth (node_children lens) 20)))
    (defn frnt-lens-recipe-executed? (lens)
        (node_value (nth (node_children lens) 21)))
    (defn frnt-lens-model-executed? (lens)
        (node_value (nth (node_children lens) 22)))
    (defn frnt-lens-buffer-released? (lens)
        (node_value (nth (node_children lens) 23)))

    (defn frnt-lens-retains? (lens scan live crossing-ack)
        (do
            (let pure (frexl-result-pure live))
            (if (and (node_eq (frnt-lens-surface lens)
                              (frnt-scan-surface scan))
                (and (node_eq (frnt-lens-request lens)
                              (frex-result-request pure))
                (and (node_eq (frnt-lens-recipe lens)
                              (frex-result-recipe pure))
                (and (node_eq (frnt-lens-code lens)
                              (frexl-result-code live))
                (and (node_eq (frnt-lens-execution lens)
                              (frexl-result-execution live))
                (and (node_eq (frnt-lens-observation lens)
                              (frexl-result-observation live))
                (and (node_eq (frnt-lens-emitter lens)
                              (froc-ack-emitter crossing-ack))
                (and (node_eq (frnt-lens-receiver lens)
                              (froc-ack-receiver crossing-ack))
                (and (node_eq (frnt-lens-channel lens)
                              (froc-ack-channel crossing-ack))
                     (node_eq (frnt-lens-received lens)
                              (froc-ack-received crossing-ack))))))))))) 1 0)))

    ; ── rich acknowledgment ─────────────────────────────────────────
    ; ack children:
    ; scan request recipe code execution observation crossing-ack
    ; meaning vitality status reason carrier present value stream-bytes
    ; pretokenized source-generated native-generated recipe-executed
    ; model-executed buffer-released last-error
    (defn frnt-ack (scan live crossing-ack last-error)
        (do
            (let pure (frexl-result-pure live))
            (let meaning (frnt-lens "meaning" scan live crossing-ack))
            (let vitality (frnt-lens "vitality" scan live crossing-ack))
            (intern_node (frnt-ack-category)
                (list scan
                    (frex-result-request pure)
                    (frex-result-recipe pure)
                    (frexl-result-code live)
                    (frexl-result-execution live)
                    (frexl-result-observation live)
                    crossing-ack meaning vitality
                    (intern_trivial_string (frexl-result-status live))
                    (intern_trivial_string (frexl-result-reason live))
                    (intern_trivial_string (frexl-result-carrier live))
                    (intern_trivial_int (frexl-result-value-present? live))
                    (intern_trivial_int (frexl-result-value live))
                    (intern_trivial_int (frexl-result-stream-bytes live))
                    (intern_trivial_int (frexl-result-pretokenized? live))
                    (intern_trivial_int (frexl-result-source-generated? live))
                    (intern_trivial_int
                        (frexl-result-native-code-generated? live))
                    (intern_trivial_int (frexl-result-executed? live))
                    (intern_trivial_int (frexl-result-model-executed? live))
                    (intern_trivial_int
                        (frexl-result-buffer-released? live))
                    (intern_trivial_string last-error)))))
    (defn frnt-ack-scan (ack) (nth (node_children ack) 0))
    (defn frnt-ack-request (ack) (nth (node_children ack) 1))
    (defn frnt-ack-recipe (ack) (nth (node_children ack) 2))
    (defn frnt-ack-code (ack) (nth (node_children ack) 3))
    (defn frnt-ack-execution (ack) (nth (node_children ack) 4))
    (defn frnt-ack-observation (ack) (nth (node_children ack) 5))
    (defn frnt-ack-crossing (ack) (nth (node_children ack) 6))
    (defn frnt-ack-meaning (ack) (nth (node_children ack) 7))
    (defn frnt-ack-vitality (ack) (nth (node_children ack) 8))
    (defn frnt-ack-status (ack)
        (node_value (nth (node_children ack) 9)))
    (defn frnt-ack-reason (ack)
        (node_value (nth (node_children ack) 10)))
    (defn frnt-ack-carrier (ack)
        (node_value (nth (node_children ack) 11)))
    (defn frnt-ack-value-present? (ack)
        (node_value (nth (node_children ack) 12)))
    (defn frnt-ack-value (ack)
        (node_value (nth (node_children ack) 13)))
    (defn frnt-ack-stream-bytes (ack)
        (node_value (nth (node_children ack) 14)))
    (defn frnt-ack-pretokenized? (ack)
        (node_value (nth (node_children ack) 15)))
    (defn frnt-ack-source-generated? (ack)
        (node_value (nth (node_children ack) 16)))
    (defn frnt-ack-native-generated? (ack)
        (node_value (nth (node_children ack) 17)))
    (defn frnt-ack-recipe-executed? (ack)
        (node_value (nth (node_children ack) 18)))
    (defn frnt-ack-model-executed? (ack)
        (node_value (nth (node_children ack) 19)))
    (defn frnt-ack-buffer-released? (ack)
        (node_value (nth (node_children ack) 20)))
    (defn frnt-ack-last-error (ack)
        (node_value (nth (node_children ack) 21)))

    (defn frnt-ack-retains? (ack live)
        (do
            (let crossing (frnt-ack-crossing ack))
            (let meaning (frnt-ack-meaning ack))
            (let vitality (frnt-ack-vitality ack))
            (if (and (node_eq (frnt-ack-observation ack)
                              (frexl-result-observation live))
                (and (node_eq (froc-ack-observation crossing)
                              (frexl-result-observation live))
                (and (not (node_eq meaning vitality))
                (and (eq (frnt-lens-retains? meaning
                            (frnt-ack-scan ack) live crossing) 1)
                     (eq (frnt-lens-retains? vitality
                            (frnt-ack-scan ack) live crossing) 1))))) 1 0)))

    ; ── crossing composition ────────────────────────────────────────
    ; result = scan live froc-crossing rich-ack
    (defn frnt-result (scan live crossing ack)
        (list scan live crossing ack))
    (defn frnt-result-scan (result) (nth result 0))
    (defn frnt-result-live (result) (nth result 1))
    (defn frnt-result-crossing (result) (nth result 2))
    (defn frnt-result-ack (result) (nth result 3))

    (defn frnt-cross-live-result (scan live channel-path persistence-path
                                  persistence-requested last-error)
        (do
            (let emitter (froc-emitter))
            (let receiver (froc-receiver))
            (let channel (froc-channel emitter receiver))
            (let envelope
                (froc-envelope-from-live emitter receiver channel live))
            (let rendered (frexl-live-render live))
            (let emit (froc-emit channel-path envelope (str_len rendered)))
            (let crossing-ack (froc-receive channel-path 0 receiver channel emit
                persistence-path persistence-requested))
            (let crossing (froc-crossing live envelope emit crossing-ack))
            (let ack (frnt-ack scan live crossing-ack last-error))
            (frnt-result scan live crossing ack)))

    ; The one effectful entry. The exact BMF-consumed bytes, not the caller's
    ; original string object, enter the existing raw-stream Metal executor.
    (defn frnt-run-live (surface channel-path persistence-path
                         persistence-requested)
        (do
            (let scan (frnt-bmf-consume-default surface))
            (let live (frexl-execute-stream (frnt-scan-consumed scan)))
            (let last-error (metal_status))
            (frnt-cross-live-result scan live channel-path persistence-path
                                    persistence-requested last-error)))

    ; ── framebuffer stage cells for the effectful driver ────────────
    (defn frnt-stage (index name parent scan live crossing-ack)
        (intern_node (frnt-stage-category)
            (list (intern_trivial_int index)
                  (intern_trivial_string name)
                  (frnt-node-or-absent parent)
                  (frnt-node-or-absent scan)
                  (if (nothing? live) (frnt-absent)
                      (frexl-result-observation live))
                  (if (nothing? crossing-ack) (frnt-absent)
                      (froc-ack-channel crossing-ack))
                  (intern_trivial_string
                    (if (nothing? live) "nothing"
                        (frexl-result-status live)))
                  (intern_trivial_int
                    (if (nothing? live) 0
                        (frexl-result-value-present? live)))
                  (intern_trivial_int
                    (if (nothing? live) 0 (frexl-result-value live)))
                  (intern_trivial_int
                    (if (nothing? live) 0
                        (frexl-result-native-code-generated? live)))
                  (intern_trivial_int
                    (if (nothing? live) 0 (frexl-result-executed? live)))
                  (intern_trivial_int
                    (if (nothing? live) 0
                        (frexl-result-model-executed? live)))
                  (intern_trivial_int
                    (if (nothing? live) 0
                        (frexl-result-buffer-released? live))))))
    (defn frnt-stage-index (stage)
        (node_value (nth (node_children stage) 0)))
    (defn frnt-stage-name (stage)
        (node_value (nth (node_children stage) 1)))

    0)
