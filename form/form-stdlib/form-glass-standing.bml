//////////////////////////////////////////////////////////////////////
//
// form-glass-standing.bml — which organs are MEANT to keep giving.
//
// Urs, 2026-09-09, reading a slot silent for 49.5 hours: "something is
// not alive."
//
// The roster records when each name last spoke, and that is a fact about
// the past. It cannot say whether a name ever means to speak again, so a
// band that published once and finished and an organ that was meant to
// keep giving and stopped read exactly alike an hour later. No lens can
// separate them, because the difference is not in the evidence -- it is
// in the INTENT, and intent has to be declared by the one who holds it.
//
// So this door holds the declaration and nothing else: a publisher, the
// cadence it promises, and the cell that gives it. Every row here is
// grounded in the giving cell's own words, never in a number chosen
// here. A publisher that is not declared is NEVER called stopped -- it
// simply never promised, and silence from something that made no promise
// is not a wound.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-crossings.bml form/form-stdlib/form-choice-flow-glass.bml

section [form.bml] {
    class FormGlassStanding {
        field FGSTSchema = "form-glass-standing-v1";
        // how many cadences of silence before a promise is visibly unkept --
        // the same factor the choice and sensor lanes already hold
        field FGSTSilentFactor = 3;

        // ---- one declared organ ----------------------------------------------
        def fgst-organ(publisher, cadenceMs, door) = list(FGSTSchema(), publisher, cadenceMs, door);
        def fgst-publisher(o) = o[1];
        def fgst-cadence(o) = o[2];
        def fgst-door(o) = o[3];
        def fgst-organ?(o) = len(o) < 4 ? 0 : (String) head(o) == FGSTSchema() ? 1 : 0;
        def fgst-window(o) = FGSTSilentFactor() * fgst-cadence(o);

        // ---- the declaration -------------------------------------------------
        // organs: observe/form-glass-organs-live.fk says in its own header that
        // it reads and gives every 500 ms.
        // choices: observe/form-choice-flow-live.fk runs fcfg-loop, whose class
        // holds FCFGCadenceMs -- the lane's own promise, taken from the lane.
        // Nothing else is listed, because nothing else has a cadence this door
        // can read from the cell that gives it, and a promise invented here
        // would be a number wearing a declaration's clothes.
        def fgst-declared() = list(
            fgst-organ("organs", 500, "observe/form-glass-organs-live.fk"),
            fgst-organ("choices", FCFGCadenceMs(), "observe/form-choice-flow-live.fk"));
        def fgst-declared-for(ds, publisher) = (Comparable) len(ds) == 0 ? list() : (String) fgst-publisher(head(ds)) == publisher ? head(ds) : fgst-declared-for(tail(ds), publisher);
        def fgst-declared?(ds, publisher) = (Comparable) len(fgst-declared-for(ds, publisher)) == 0 ? 0 : 1;

        // ---- what a declaration lets the body say -----------------------------
        // "breathing"   spoke inside its own promised window
        // "stopped"     stood, and then went quiet past its own window: a wound,
        //               and the only reading here that is one
        // "never-stood" declared, and no roster row has ever carried its name
        def fgst-state(o, ageMs) = ageMs < 0 ? "never-stood" : ageMs > fgst-window(o) ? "stopped" : "breathing";
        def fgst-reading(o, ageMs) = list(fgst-publisher(o), fgst-state(o, ageMs), ageMs, fgst-window(o), fgst-door(o));
        def fgst-reading-publisher(r) = head(r);
        def fgst-reading-state(r) = r[1];
        def fgst-reading-age(r) = r[2];
        def fgst-reading-window(r) = r[3];
        def fgst-reading-door(r) = r[4];
        def fgst-stopped?(r) = (String) fgst-reading-state(r) == "breathing" ? 0 : 1;

        // ---- reading the declaration against the live roster -------------------
        // The age comes from the roster stamp, so this costs no frame open: the
        // slots are already in hand from fgx-roster-slots.
        def fgst-age-at(slots, root, publisher, now) {
            let spoke = fgx-spoke-of(slots, fgtm-space(root, publisher));
            spoke < 0 ? -1 : spoke > now ? 0 : (now - spoke);
        }
        def fgst-age-in(slots, root, publisher) = fgst-age-at(slots, root, publisher, now_unix_ms());
        def fgst-assess-in(ds, slots, root) = (Comparable) len(ds) == 0 ? list() : cons(fgst-reading(head(ds), fgst-age-in(slots, root, fgst-publisher(head(ds)))), fgst-assess-in(tail(ds), slots, root));
        def fgst-assess(slots, root) = fgst-assess-in(fgst-declared(), slots, root);
        def fgst-unkept(rs) = (Comparable) len(rs) == 0 ? list() : (Comparable) fgst-stopped?(head(rs)) == 1 ? cons(head(rs), fgst-unkept(tail(rs))) : fgst-unkept(tail(rs));
        def fgst-kept(rs) = (Comparable) len(rs) == 0 ? list() : (Comparable) fgst-stopped?(head(rs)) == 1 ? fgst-kept(tail(rs)) : cons(head(rs), fgst-kept(tail(rs)));
    }
    0;
}
