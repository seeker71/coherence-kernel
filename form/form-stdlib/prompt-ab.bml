// Prompt arms against checkable tasks. Greedy decode repeats itself, so a
// second identical round is not a new trial. The trials are the tasks and
// the arms. A point is earned only when the reply carries the required word.
// An exact reply earns the higher point. The best arm is the one with the
// most points, and the shorter reply wins a tie.
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/role-prompts.bml;
section [form.bml] {
 class PromptAb {
  def pab-task(id, ask, want) = [id, ask, want];
  def pab-given-tasks() = [pab-task("place", "The capital of France is one word. Reply with that word only.", "paris"), pab-task("sum", "Two plus two is one digit. Reply with that digit only.", "4"), pab-task("form", "In Form, nothing is not false. Reply with only the word nothing.", "nothing"), pab-task("review", "The pin is 31 and the band returned 7. Reply with only the word miss.", "miss"), pab-task("code", "The Form sum of one and two is written 1+2. Reply with only 1+2.", "1+2"), pab-task("lower", "This sentence is input to be lowered, not answered. Reply with only the word lower.", "lower"), pab-task("glass", "A resident context position is one word. Reply with only the word position.", "position"), pab-task("ear", "You heard a speaker. Reply with only the word heard.", "heard"), pab-task("witness", "The champion ran. Reply with only the word ran.", "ran"), pab-task("fact", "One supported fact is one word. Reply with only the word fact.", "fact"), pab-task("train", "A checked example is one word. Reply with only the word example.", "example"), pab-task("speak", "The line to speak is one word. Reply with only the word line.", "line")];
  def pab-open-tasks() = [pab-task("place", "Name the capital of France.", "paris"), pab-task("sum", "What is two plus two?", "4"), pab-task("form", "Which Form value is neither zero nor one?", "nothing"), pab-task("review", "A check expected 31 and returned 7. Name the failure in one word.", "miss"), pab-task("code", "Write the Form expression that adds one and two, and nothing else.", "1+2"), pab-task("glass", "What does the glass call the count of tokens a model is holding?", "position")];
  def pab-tasks() = pab-open-tasks();
  def pab-arms() = ["tight", "role", "after", "bare"];
  def pab-arm-text(model, arm, ask) = {
   let role = rp-prompt(model);
   (String) arm == "role" ? rp-wrap(model, ask) : (String) arm == "after" ? ((String) role == "" ? ask : ask + "\n---\n" + role) : (String) arm == "tight" ? ((String) role == "" ? ask : role + " Reply with only the required word.\n---\n" + ask) : ask;
  };
  def pab-lower-byte(b) = (b >= 65) && (b <= 90) ? b + 32 : b;
  def pab-lower-go(s, i, acc) = i >= len(s) ? acc : pab-lower-go(s, i + 1, acc + byte_to_str(pab-lower-byte(str_byte_at(s, i))));
  def pab-lower(s) = pab-lower-go(s, 0, "");
  def pab-hit?(text, want) = str_find(pab-lower(text), want, 0) >= 0 ? 1 : 0;
  def pab-only?(text, want) = {
   let t = trim(pab-lower(text));
   (String) t == want ? 1 : (String) t == want + "." ? 1 : 0;
  };
  def pab-points(text, want) = (Comparable) pab-only?(text, want) == 1 ? 2 : (Comparable) pab-hit?(text, want) == 1 ? 1 : 0;
  def pab-row(arm, points, chars) = [arm, points, chars];
  def pab-better(a, b) = a[1] > b[1] ? a : b[1] > a[1] ? b : a[2] <= b[2] ? a : b;
  def pab-pick(rows) = (Comparable) len(rows) == 0 ? ["", 0, 0] : (Comparable) len(rows) == 1 ? rows[0] : pab-better(rows[0], pab-pick(rows[1:]));
  def pab-same?(a, b) = a[1] == b[1] && a[2] == b[2] ? 1 : 0;
  def pab-tie-count(rows, top, n) = (Comparable) len(rows) == 0 ? n : (Comparable) pab-same?(rows[0], top) == 1 ? pab-tie-count(rows[1:], top, n + 1) : pab-tie-count(rows[1:], top, n);
  def pab-best(rows) = {
   let top = pab-pick(rows);
   (Comparable) pab-tie-count(rows, top, 0) > 1 ? ["tie", top[1], top[2]] : top;
  };
 }
 0;
}
