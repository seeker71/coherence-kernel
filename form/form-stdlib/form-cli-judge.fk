; form-cli-judge.fk — score the REASONING lane: how well a native answer covers
; the agent's, graded 0..100 by a judge.
;
; preludes: form-stdlib/core.fk
;
; Tool selection (form-cli-score / form-cli-predict) is a SET problem — exact,
; cheap, and the native model already wins it. Reasoning is the hard lane: the
; native answer must cover the SUBSTANCE of the agent's, which set-overlap can't
; measure. So a judge (a local oracle, the membrane crossing) rates each native
; answer 0..100 for how well it covers the agent's reference; this recipe is the
; rubric and the tally over those scores — the proven (four-way) logic, the judge
; is the carrier.
;
; A judged sample is one native score in 0..100. The recipe grades it, counts
; passes at a threshold, sums for the average, and reports whether the native
; reaches a majority — the same champion-challenger shape, on a graded lane.
;
; Proven by: form-stdlib/tests/form-cli-judge-band.fk

; grade a score: 0 poor (<=25) / 1 weak (<=50) / 2 partial (<=75) / 3 strong
(defn fcj-grade (score)
    (if (le score 25) 0
        (if (le score 50) 1
            (if (le score 75) 2 3))))
(defn fcj-grade-poor () 0)
(defn fcj-grade-weak () 1)
(defn fcj-grade-partial () 2)
(defn fcj-grade-strong () 3)

; does a score clear the bar?
(defn fcj-pass? (score threshold) (if (ge score threshold) 1 0))

; tallies over a list of scores
(defn fcj-passed (scores threshold)
    (if (eq (len scores) 0) 0
        (add (fcj-pass? (head scores) threshold) (fcj-passed (tail scores) threshold))))
(defn fcj-count-grade (scores g)
    (if (eq (len scores) 0) 0
        (add (if (eq (fcj-grade (head scores)) g) 1 0) (fcj-count-grade (tail scores) g))))
(defn fcj-total (scores) (len scores))
(defn fcj-sum (scores)
    (if (eq (len scores) 0) 0 (add (head scores) (fcj-sum (tail scores)))))
; (the average is sum/total — computed by the carrier; div is kept off the
;  four-way path so the tally stays integer-identical on every arm.)

; native reaches the lane when a majority of samples pass the threshold
(defn fcj-native-reaches? (scores threshold)
    (if (ge (add (fcj-passed scores threshold) (fcj-passed scores threshold)) (len scores)) 1 0))

; ── needle sensing — the judge without an oracle in the loop (2026-08-09) ──
; The WORK-REPLAY line needed this organ to sense a continuation INSIDE the ask
; loop, with no second model crossing: an answer's judge line, compiled to needle
; groups, and the sense computed by the kernel. A needle is (kind text) over a
; PRE-LOWERED hay (the caller lowers; this cell stays byte-honest):
;   kind 0  plain substring
;   kind 1  digit-bounded  — "249" is not sensed inside "2492492854"
;   kind 2  word-bounded   — "mod" is not sensed inside "model"
;   kind 3  exact paren run — thirteen is not sensed inside fourteen
; A group senses when ALL its needles are found; the answer carries when ANY
; group senses. fcj-sense-best keeps the CLOSEST group as (matched size) — the
; cross-multiplied compare keeps div off the four-way path, this cell's own rule.
; Proven by: learn/tests/work-replay-sense-band.fk (mutation-tested — a sense
; that cannot fail is not a sense).
(defn fcj-digit-byte? (b) (if (and (ge b 48) (le b 57)) 1 0))
(defn fcj-word-byte? (b)
    (if (eq (fcj-digit-byte? b) 1) 1
        (if (and (ge b 97) (le b 122)) 1
            (if (and (ge b 65) (le b 90)) 1
                (if (eq b 95) 1 0)))))
(defn fcj-needle (k s) (list k s))
(defn fcj-sense-bound-ok? (hay j k kind)
    (if (eq kind 0) 1
    (if (eq kind 1)
        (if (eq (if (eq j 0) 0 (fcj-digit-byte? (str_byte_at hay (sub j 1)))) 0)
            (if (eq (if (ge k (str_len hay)) 0 (fcj-digit-byte? (str_byte_at hay k))) 0) 1 0) 0)
    (if (eq kind 2)
        (if (eq (if (eq j 0) 0 (fcj-word-byte? (str_byte_at hay (sub j 1)))) 0)
            (if (eq (if (ge k (str_len hay)) 0 (fcj-word-byte? (str_byte_at hay k))) 0) 1 0) 0)
    ; kind 3: the run ends where the needle ends, and no digit leads into it
    (if (eq (if (eq j 0) 0 (fcj-digit-byte? (str_byte_at hay (sub j 1)))) 0)
        (if (eq (if (ge k (str_len hay)) 1 (if (eq (str_byte_at hay k) 41) 0 1)) 1) 1 0) 0)))))
(defn fcj-sense-scan (hay needle kind i)
    (do (let j (str_find hay needle i))
        (if (lt j 0) 0
            (if (eq (fcj-sense-bound-ok? hay j (add j (str_len needle)) kind) 1) 1
                (fcj-sense-scan hay needle kind (add j 1))))))
(defn fcj-needle-sensed? (hay pair) (fcj-sense-scan hay (nth pair 1) (nth pair 0) 0))
(defn fcj-group-matched (hay pairs)
    (if (eq (len pairs) 0) 0
        (add (fcj-needle-sensed? hay (head pairs)) (fcj-group-matched hay (tail pairs)))))
(defn fcj-group-senses? (hay pairs) (if (eq (fcj-group-matched hay pairs) (len pairs)) 1 0))
(defn fcj-sense-carries? (hay groups)
    (if (eq (len groups) 0) 0
        (if (eq (fcj-group-senses? hay (head groups)) 1) 1
            (fcj-sense-carries? hay (tail groups)))))
; the closest group as (matched size): m1/t1 beats m2/t2 when m1*t2 > m2*t1 —
; cross-multiplied, exact, no div. A full group (m = t) beats every partial.
(defn fcj-sense-best-loop (hay groups bm bt)
    (if (eq (len groups) 0) (list bm bt)
        (do (let m (fcj-group-matched hay (head groups)))
            (let t (len (head groups)))
            (if (gt (mul m bt) (mul bm t))
                (fcj-sense-best-loop hay (tail groups) m t)
                (fcj-sense-best-loop hay (tail groups) bm bt)))))
(defn fcj-sense-best (hay groups) (fcj-sense-best-loop hay groups 0 1))

0
