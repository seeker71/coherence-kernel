; yes-tone-stream-live.fk — print the twelve tones.
;
; preludes: form-stdlib/core.fk form-stdlib/yes-tone-stream.fk

(do
    (print "yes-tone n=")
    (print (int_to_str (yts-n)))
    (print "\n")
    (print "yes-tone 0=")
    (print (int_to_str (yts-at 0)))
    (print " 1=")
    (print (int_to_str (yts-at 1)))
    (print " 2=")
    (print (int_to_str (yts-at 2)))
    (print " 3=")
    (print (int_to_str (yts-at 3)))
    (print " 4=")
    (print (int_to_str (yts-at 4)))
    (print " 5=")
    (print (int_to_str (yts-at 5)))
    (print " 6=")
    (print (int_to_str (yts-at 6)))
    (print " 7=")
    (print (int_to_str (yts-at 7)))
    (print " 8=")
    (print (int_to_str (yts-at 8)))
    (print " 9=")
    (print (int_to_str (yts-at 9)))
    (print " 10=")
    (print (int_to_str (yts-at 10)))
    (print " 11=")
    (print (int_to_str (yts-at 11)))
    (print "\n")
    (print "yes-tone check=")
    (print (int_to_str (yts-check)))
    (print "\n")
    0)
