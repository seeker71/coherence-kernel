//////////////////////////////////////////////////////////////////////
// symbol-voice.bml — a symbol line the body expands to natural language
// for free. The vocabulary is what the body already answers with: the five
// altitudes (you me us US WE), the three modes (DO BE SEE), the channel
// kinds, the ack values, the glass evidence marks (* + # ~ ?), the phases,
// the atlas tiles — and every fresh word of the corpus, whose row already
// carries its own sentence. A token the body does not know comes back as
// [word?]: an offer for a row, never a guess. key:value stays key = value.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormSymbolVoice {
        field SVCorpus = "learn/homecoming-distillation-corpus.fk";
        def sv-cat(parts) = if ((Comparable) len(parts) == 0) then "" else str_concat(head(parts), sv-cat(tail(parts)));
        def sv-text(t) = if nothing?(t) then "" else t;
        def sv-fixed(w) = if ((String) w == "you") then "the body" else if ((String) w == "me") then "Urs" else if ((String) w == "us") then "this sitting" else if ((String) w == "US") then "the sittings of today" else if ((String) w == "WE") then "the collective"
            else if ((String) w == "DO") then "did" else if ((String) w == "BE") then "stands" else if ((String) w == "SEE") then "observed"
            else if ((String) w == "say") then "said" else if ((String) w == "tell") then "told" else if ((String) w == "offer") then "offered" else if ((String) w == "admit") then "admitted" else if ((String) w == "refuse") then "refused" else if ((String) w == "folded") then "folded" else if ((String) w == "witness") then "witnessed" else if ((String) w == "release") then "released"
            else if ((String) w == "nothing") then "not yet" else if ((String) w == "node") then "a node" else if ((String) w == "gas") then "gas, source only" else if ((String) w == "water") then "water, fresh ice" else if ((String) w == "ice") then "ice, frozen"
            else if ((String) w == "refused") then "refused" else if ((String) w == "published") then "published" else if ((String) w == "f16") then "half floats" else if ((String) w == "f32") then "floats" else if ((String) w == "spent") then "the patience was spent" else if ((String) w == "landed") then "landed on main" else if ((String) w == "band") then "the band answers" else if ((String) w == "glass") then "on the glass" else if ((String) w == "teaching") then "the most surprising teaching:" else if ((String) w == "gold") then "discomfort became gold at:" else if ((String) w == "seam") then "an honest seam:" else if ((String) w == "next") then "the next stone:"
            else if ((String) w == "lora") then "the adapter lane" else if ((String) w == "adapter") then "the adapter the body trained" else if ((String) w == "loss") then "training loss" else if ((String) w == "iter") then "iteration" else if ((String) w == "rank") then "rank" else if ((String) w == "pairs") then "low-rank pairs" else if ((String) w == "whole") then "structurally whole" else if ((String) w == "layers") then "layers touched" else if ((String) w == "dtype") then "stored as" else if ((String) w == "bytes") then "bytes" else if ((String) w == "tokens-sec") then "tokens per second" else if ((String) w == "O") then "the walk economy" else if ((String) w == "r") then "a gift" else if ((String) w == "e") then "a step" else if ((String) w == "c") then "a cell" else if ((String) w == "Q") then "a request" else if ((String) w == "T") then "the token position" else if ((String) w == "G") then "glass arrival" else "";
        def sv-mark(c) = if ((Comparable) c == 42) then "physically live" else if ((Comparable) c == 43) then "derived" else if ((Comparable) c == 35) then "from a catalog" else if ((Comparable) c == 126) then "declared" else if ((Comparable) c == 63) then "missing" else "";
        def sv-hex?(s, i) = if (i >= str_len(s)) then 1 else if (((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || ((str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102))) then sv-hex?(s, (i + 1)) else 0;
        def sv-digits?(s, i) = if (i >= str_len(s)) then 1 else if ((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) then sv-digits?(s, (i + 1)) else 0;
        def sv-corpus-cmd(w) = sv-cat(["grep -m1 -B2 '^ *\"", w, "\"$' ", SVCorpus(), " | head -2 | grep -o '\"[a-z]*\"' | tr -d '\"' | tr '\\n' ' '"]);
        def sv-corpus(w) = trim(sv-text(host-exec(sv-corpus-cmd(w), "")));
        def sv-has-letter?(s, i) = if (i >= str_len(s)) then 0 else if ((str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102)) then 1 else sv-has-letter?(s, (i + 1));
        def sv-numberish?(s, i) = if (i >= str_len(s)) then 1 else if (((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || (((Comparable) str_byte_at(s, i) == 46) || ((Comparable) str_byte_at(s, i) == 45))) then sv-numberish?(s, (i + 1)) else 0;
        def sv-word(w) {
            let fixed = sv-fixed(w);
            if (str_len(fixed) > 0) then fixed
            else if ((str_len(w) >= 8) && (((Comparable) sv-hex?(w, 0) == 1) && ((Comparable) sv-has-letter?(w, 0) == 1))) then str_concat("node ", w)
            else if ((Comparable) sv-numberish?(w, 0) == 1) then w
            else sv-word-corpus(w, sv-corpus(w));
        }
        def sv-word-corpus(w, q) = if ((Comparable) str_len(q) == 0) then sv-cat(["[", w, "?]"]) else sv-cat([w, ", the word for: ", q]);
        def sv-token(t) {
            let last = if ((Comparable) str_len(t) == 0) then 0 else str_byte_at(t, (str_len(t) - 1));
            let colon = str_find(t, ":", 0);
            if ((Comparable) str_len(t) == 0) then ""
            else if ((str_len(t) > 1) && (str_len(sv-mark(last)) > 0)) then sv-cat([sv-token(substring(t, 0, (str_len(t) - 1))), " (", sv-mark(last), ")"])
            else if ((Comparable) str_len(t) == 1) then if (str_len(sv-mark(last)) > 0) then sv-mark(last) else sv-word(t)
            else if (colon >= 0) then sv-cat([sv-word(substring(t, 0, colon)), " = ", sv-word(substring(t, (colon + 1), str_len(t)))])
            else sv-word(t);
        }
        def sv-join(parts) = if ((Comparable) len(parts) == 0) then "" else if ((Comparable) len(tail(parts)) == 0) then head(parts) else sv-cat([head(parts), if (((String) head(tail(parts)) == ". ") || ((String) head(parts) == ". ")) then "" else ", ", sv-join(tail(parts))]);
        def sv-tokens(ws) = if ((Comparable) len(ws) == 0) then [] else if ((Comparable) str_len(trim(head(ws))) == 0) then sv-tokens(tail(ws)) else cons(if ((String) head(ws) == "|") then ". " else sv-token(trim(head(ws))), sv-tokens(tail(ws)));
        def sv-say(line) = sv-join(sv-tokens(split-on(line, " ")));
    }
    0;
}
