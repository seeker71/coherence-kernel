//////////////////////////////////////////////////////////////////////
// symbol-voice.bml — a symbol line the body expands to natural language
// for free. The vocabulary is what the body already answers with: the five
// altitudes (you me us US WE), the three modes (DO BE SEE), the channel
// kinds, the ack values, the glass evidence marks (* + # ~ ?), the phases,
// the atlas tiles — and every fresh word of the corpus, whose row already
// carries its own sentence. A token the body does not know comes back as
// [word?]: an offer for a row, never a guess. key:value stays key = value.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormSymbolVoice {
        field SVCorpus = "learn/homecoming-distillation-corpus.fk";
        def sv-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), sv-cat(tail(parts)));
        def sv-text(t) = if nothing?(t) then "" else t;
        def sv-fixed(w) = if str_eq(w, "you") then "the body" else if str_eq(w, "me") then "Urs" else if str_eq(w, "us") then "this sitting" else if str_eq(w, "US") then "the sittings of today" else if str_eq(w, "WE") then "the collective"
            else if str_eq(w, "DO") then "did" else if str_eq(w, "BE") then "stands" else if str_eq(w, "SEE") then "observed"
            else if str_eq(w, "say") then "said" else if str_eq(w, "tell") then "told" else if str_eq(w, "offer") then "offered" else if str_eq(w, "admit") then "admitted" else if str_eq(w, "refuse") then "refused" else if str_eq(w, "folded") then "folded" else if str_eq(w, "witness") then "witnessed" else if str_eq(w, "release") then "released"
            else if str_eq(w, "nothing") then "not yet" else if str_eq(w, "node") then "a node" else if str_eq(w, "gas") then "gas, source only" else if str_eq(w, "water") then "water, fresh ice" else if str_eq(w, "ice") then "ice, frozen"
            else if str_eq(w, "spent") then "the patience was spent" else if str_eq(w, "landed") then "landed on main" else if str_eq(w, "band") then "the band answers" else if str_eq(w, "glass") then "on the glass" else if str_eq(w, "teaching") then "the most surprising teaching:" else if str_eq(w, "gold") then "discomfort became gold at:" else if str_eq(w, "seam") then "an honest seam:" else if str_eq(w, "next") then "the next stone:"
            else if str_eq(w, "O") then "the walk economy" else if str_eq(w, "r") then "a gift" else if str_eq(w, "e") then "a step" else if str_eq(w, "c") then "a cell" else if str_eq(w, "Q") then "a request" else if str_eq(w, "T") then "the token position" else if str_eq(w, "G") then "glass arrival" else "";
        def sv-mark(c) = if eq(c, 42) then "physically live" else if eq(c, 43) then "derived" else if eq(c, 35) then "from a catalog" else if eq(c, 126) then "declared" else if eq(c, 63) then "missing" else "";
        def sv-hex?(s, i) = if ge(i, str_len(s)) then 1 else if or(and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)), and(ge(str_byte_at(s, i), 97), le(str_byte_at(s, i), 102))) then sv-hex?(s, add(i, 1)) else 0;
        def sv-digits?(s, i) = if ge(i, str_len(s)) then 1 else if and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)) then sv-digits?(s, add(i, 1)) else 0;
        def sv-corpus-cmd(w) = sv-cat(list("grep -m1 -B2 '^ *\"", w, "\"$' ", SVCorpus(), " | head -2 | grep -o '\"[a-z]*\"' | tr -d '\"' | tr '\\n' ' '"));
        def sv-corpus(w) = trim(sv-text(host-exec(sv-corpus-cmd(w), "")));
        def sv-word(w) {
            let fixed = sv-fixed(w);
            if gt(str_len(fixed), 0) then fixed
            else if and(ge(str_len(w), 8), eq(sv-hex?(w, 0), 1)) then str_concat("node ", w)
            else if eq(sv-digits?(w, 0), 1) then w
            else sv-word-corpus(w, sv-corpus(w));
        }
        def sv-word-corpus(w, q) = if eq(str_len(q), 0) then sv-cat(list("[", w, "?]")) else sv-cat(list(w, ", the word for: ", q));
        def sv-token(t) {
            let last = if eq(str_len(t), 0) then 0 else str_byte_at(t, sub(str_len(t), 1));
            let colon = str_find(t, ":", 0);
            if eq(str_len(t), 0) then ""
            else if and(gt(str_len(t), 1), gt(str_len(sv-mark(last)), 0)) then sv-cat(list(sv-token(substring(t, 0, sub(str_len(t), 1))), " (", sv-mark(last), ")"))
            else if eq(str_len(t), 1) then if gt(str_len(sv-mark(last)), 0) then sv-mark(last) else sv-word(t)
            else if ge(colon, 0) then sv-cat(list(sv-word(substring(t, 0, colon)), " = ", sv-word(substring(t, add(colon, 1), str_len(t)))))
            else sv-word(t);
        }
        def sv-join(parts) = if eq(len(parts), 0) then "" else if eq(len(tail(parts)), 0) then head(parts) else sv-cat(list(head(parts), if or(str_eq(head(tail(parts)), ". "), str_eq(head(parts), ". ")) then "" else ", ", sv-join(tail(parts))));
        def sv-tokens(ws) = if eq(len(ws), 0) then list() else if eq(str_len(trim(head(ws))), 0) then sv-tokens(tail(ws)) else cons(if str_eq(head(ws), "|") then ". " else sv-token(trim(head(ws))), sv-tokens(tail(ws)));
        def sv-say(line) = sv-join(sv-tokens(split-on(line, " ")));
    }
    0;
}
