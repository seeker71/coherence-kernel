//////////////////////////////////////////////////////////////////////
// symbol-voice.bml — a symbol line the body expands to natural language
// for free. The vocabulary is what the body already answers with: the five
// altitudes (you me us US WE), the three modes (DO BE SEE), the channel
// kinds, the ack values, the glass evidence marks (* + # ~ ?), the phases,
// the atlas tiles — and every fresh word of the corpus, whose row already
// carries its own sentence. A token the body does not know comes back as
// [word?]: an offer for a row, never a guess. key:value stays key = value.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormSymbolVoice {
        field SVCorpus = "learn/homecoming-distillation-corpus.fk";
        def sv-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ sv-cat(tail(parts));
        def sv-text(t) = t ?? "";
        def sv-fixed(w) = (String) w == "you" ? "the body" : (String) w == "me" ? "Urs" : (String) w == "us" ? "this sitting" : (String) w == "US" ? "the sittings of today" : (String) w == "WE" ? "the collective"
            : (String) w == "DO" ? "did" : (String) w == "BE" ? "stands" : (String) w == "SEE" ? "observed"
            : (String) w == "say" ? "said" : (String) w == "tell" ? "told" : (String) w == "offer" ? "offered" : (String) w == "admit" ? "admitted" : (String) w == "refuse" ? "refused" : (String) w == "folded" ? "folded" : (String) w == "witness" ? "witnessed" : (String) w == "release" ? "released"
            : (String) w == "nothing" ? "not yet" : (String) w == "node" ? "a node" : (String) w == "gas" ? "gas, source only" : (String) w == "water" ? "water, fresh ice" : (String) w == "ice" ? "ice, frozen"
            : (String) w == "refused" ? "refused" : (String) w == "published" ? "published" : (String) w == "f16" ? "half floats" : (String) w == "f32" ? "floats" : (String) w == "spent" ? "the patience was spent" : (String) w == "landed" ? "landed on main" : (String) w == "band" ? "the band answers" : (String) w == "glass" ? "on the glass" : (String) w == "teaching" ? "the most surprising teaching:" : (String) w == "gold" ? "discomfort became gold at:" : (String) w == "seam" ? "an honest seam:" : (String) w == "next" ? "the next stone:"
            : (String) w == "lora" ? "the adapter lane" : (String) w == "adapter" ? "the adapter the body trained" : (String) w == "loss" ? "training loss" : (String) w == "iter" ? "iteration" : (String) w == "rank" ? "rank" : (String) w == "pairs" ? "low-rank pairs" : (String) w == "whole" ? "structurally whole" : (String) w == "layers" ? "layers touched" : (String) w == "dtype" ? "stored as" : (String) w == "bytes" ? "bytes" : (String) w == "tokens-sec" ? "tokens per second" : (String) w == "O" ? "the walk economy" : (String) w == "r" ? "a gift" : (String) w == "e" ? "a step" : (String) w == "c" ? "a cell" : (String) w == "Q" ? "a request" : (String) w == "T" ? "the token position" : (String) w == "G" ? "glass arrival" : "";
        def sv-mark(c) = (Comparable) c == 42 ? "physically live" : (Comparable) c == 43 ? "derived" : (Comparable) c == 35 ? "from a catalog" : (Comparable) c == 126 ? "declared" : (Comparable) c == 63 ? "missing" : "";
        def sv-hex?(s, i) = i >= str_len(s) ? 1 : ((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || ((str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102)) ? sv-hex?(s, i + 1) : 0;
        def sv-digits?(s, i) = i >= str_len(s) ? 1 : (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? sv-digits?(s, i + 1) : 0;
        def sv-corpus-cmd(w) = "grep -m1 -B2 '^ *\"" ++ w ++ "\"$' " ++ SVCorpus() ++ " | head -2 | grep -o '\"[a-z]*\"' | tr -d '\"' | tr '\\n' ' '";
        def sv-corpus(w) = trim(sv-text(host-exec(sv-corpus-cmd(w), "")));
        def sv-has-letter?(s, i) = i >= str_len(s) ? 0 : (str_byte_at(s, i) >= 97) && (str_byte_at(s, i) <= 102) ? 1 : sv-has-letter?(s, i + 1);
        def sv-numberish?(s, i) = i >= str_len(s) ? 1 : ((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || (((Comparable) str_byte_at(s, i) == 46) || ((Comparable) str_byte_at(s, i) == 45)) ? sv-numberish?(s, i + 1) : 0;
        def sv-word(w) {
            let fixed = sv-fixed(w);
            str_len(fixed) > 0 ? fixed
            : (str_len(w) >= 8) && (((Comparable) sv-hex?(w, 0) == 1) && ((Comparable) sv-has-letter?(w, 0) == 1)) ? "node " ++ w
            : (Comparable) sv-numberish?(w, 0) == 1 ? w
            : sv-word-corpus(w, sv-corpus(w));
        }
        def sv-word-corpus(w, q) = (Comparable) str_len(q) == 0 ? ("[" ++ w ++ "?]") : (w ++ ", the word for: " ++ q);
        def sv-token(t) {
            let last = (Comparable) str_len(t) == 0 ? 0 : str_byte_at(t, str_len(t) - 1);
            let colon = str_find(t, ":", 0);
            (Comparable) str_len(t) == 0 ? ""
            : (str_len(t) > 1) && (str_len(sv-mark(last)) > 0) ? (sv-token(substring(t, 0, str_len(t) - 1)) ++ " (" ++ sv-mark(last) ++ ")")
            : (Comparable) str_len(t) == 1 ? (str_len(sv-mark(last)) > 0 ? sv-mark(last) : sv-word(t))
            : colon >= 0 ? (sv-word(substring(t, 0, colon)) ++ " = " ++ sv-word(substring(t, colon + 1, str_len(t))))
            : sv-word(t);
        }
        def sv-join(parts) = (Comparable) len(parts) == 0 ? "" : (Comparable) len(tail(parts)) == 0 ? head(parts) : (head(parts) ++ (((String) head(tail(parts)) == ". ") || ((String) head(parts) == ". ") ? "" : ", ") ++ sv-join(tail(parts)));
        def sv-tokens(ws) = (Comparable) len(ws) == 0 ? list() : (Comparable) str_len(trim(head(ws))) == 0 ? sv-tokens(tail(ws)) : cons((String) head(ws) == "|" ? ". " : sv-token(trim(head(ws))), sv-tokens(tail(ws)));
        def sv-say(line) = sv-join(sv-tokens(split-on(line, " ")));
    }
    0;
}
