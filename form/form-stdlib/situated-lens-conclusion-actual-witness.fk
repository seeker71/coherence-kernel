; situated-lens-conclusion-actual-witness.fk — bind the pure relation law to
; fkwu's actual nothing / 0 / 1 terminal values.
;
; SINGLE-WITNESS (fkwu): the four-way band proves the structural law.
; witnessed: 2026-07-26 -> 7 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk

(do
    (defn slca-bit (condition bit) (if condition bit 0))
    (let lens (cwi-lens 1 2 3 4))
    (let field
        (list
            (slc-observation 10 lens 1 6 9001)
            (slc-observation 11 lens 0 6 9002)))
    (let missing
        (slc-actual
            (slc-settle-situated "WE" "we" "what"
                0 5 field 12 lens 1)))
    (let zero
        (slc-actual
            (slc-settle-situated "WE" "we" "what"
                1 5 field 11 lens 1)))
    (let one
        (slc-actual
            (slc-settle-situated "WE" "we" "what"
                0 5 field 10 lens 1)))
    (add
        (slca-bit (nothing? missing) 1)
        (add
            (slca-bit (eq zero 0) 2)
            (slca-bit (eq one 1) 4))))
