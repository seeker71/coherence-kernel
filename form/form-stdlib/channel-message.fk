; channel-message.fk — the pure, carrier-independent channel envelope.
;
; Message identity does not need file persistence.  Keeping the CHANNEL-MSG
; blueprint and its wrap/unwrap pair here lets semantic users exchange message
; cells on fkwu without importing channel.fk's host-I/O lane.  channel.fk adds
; read/write transport around this same envelope on kernels that carry it.
;
; preludes: form-stdlib/core.fk

(let CHANNEL-MSG (bp "CHANNEL-MSG"))

; The only child is the payload, so two equal payload recipes produce the
; same content-addressed message cell.
(defn channel-message (payload-recipe)
  (intern_node CHANNEL-MSG (list payload-recipe)))

(defn channel-msg-payload (msg)
  (head (node_children msg)))

0
