; living-world-transition-field.fk -- an ontology-open next-change field.
;
; Context is an ordered list of arbitrary offered cells, not a fixed history
; width or a table of action classes.  An observation joins that context to an
; arbitrary next cell under an optional offered lens.  Source, provenance, and
; consent remain outside the observation in ordinary living-world attribution
; edges, so content-identical observations can recur across independent sources.
;
; Recurrence may propose an emergent transition but grants no authority.  Every
; active supporting source is a participant; unanimous tending is required for
; integration.  Currentness reconstructs the exact proposal from current
; attribution evidence, so source-local revocation stales only the derivations
; that depended on it while retaining history and unrelated branches.
;
; Prediction never forces one winner.  It retains every current derivation,
; every actively observed possibility (including not-yet-recurrent cells), an
; optional alternatives field, and an optional unknown cell.  Its acknowledgment
; is NOTHING for no current next, ONE for one exact next, or NODE for plurality.
; The answer path is Form-only and has no remote or imported-answer route.
;
; witnessed: 2026-08-08 -> 262143 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk

(let LWTF-CONTEXT     (bp "LWTF-CONTEXT"))
(let LWTF-OBSERVATION (bp "LWTF-OBSERVATION"))
(let LWTF-ORIGIN      (bp "LWTF-ORIGIN"))
(let LWTF-DERIVATION  (bp "LWTF-DERIVATION"))
(let LWTF-PREDICTION  (bp "LWTF-PREDICTION"))

; Context width and member kinds are deliberately unconstrained.
(defn lwtf-context (items) (intern_node LWTF-CONTEXT items))
(defn lwtf-context? (cell) (lwo-category? cell LWTF-CONTEXT))
(defn lwtf-context-items (context) (node_children context))

; children: context, next cell, optional offered lens, local path
(defn lwtf-observation (context next lens)
    (intern_node LWTF-OBSERVATION
        (list context next lens (lwo-local-path))))
(defn lwtf-observation? (cell)
    (if (and (eq (lwo-category? cell LWTF-OBSERVATION) 1)
             (eq (lwtf-context?
                    (nth (node_children cell) 0)) 1)) 1 0))
(defn lwtf-observation-context (observation)
    (nth (node_children observation) 0))
(defn lwtf-observation-next (observation)
    (nth (node_children observation) 1))
(defn lwtf-observation-lens (observation)
    (nth (node_children observation) 2))
(defn lwtf-observation-matches? (observation context)
    (if (and (eq (lwtf-observation? observation) 1)
             (node_eq (lwtf-observation-context observation) context)) 1 0))

; Origin excludes the whole world identity.  Only exact observation evidence
; and threshold determine it, so response arrival does not stale its proposal.
(defn lwtf-origin (observation witnesses threshold)
    (intern_node LWTF-ORIGIN
        (list observation witnesses (intern_trivial_int threshold)
              (lwo-local-path))))

(defn lwtf-proposal-for (world observation threshold)
    (if (eq (lwtf-observation? observation) 0) (lwo-none)
        (do
            (let witnesses
                (lwo-active-attributions-for world observation))
            (let count (lwo-field-size witnesses))
            (if (or (eq (lwo-active? world observation) 0)
                    (lt count threshold))
                (lwo-none)
                (do
                    (let origin (lwtf-origin observation witnesses threshold))
                    (let candidate
                        (lwo-emergent observation witnesses
                            (intern_trivial_int count)
                            (intern_trivial_int count)
                            (intern_trivial_int threshold) origin))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items witnesses) (lwo-empty-field))
                        origin))))))

(defn lwtf-proposals-items (world items threshold proposals)
    (if (eq (len items) 0) proposals
        (do
            (let observation (head items))
            (if (eq (lwtf-observation? observation) 0)
                (lwtf-proposals-items world (tail items) threshold proposals)
                (do
                    (let proposal
                        (lwtf-proposal-for world observation threshold))
                    (lwtf-proposals-items world (tail items) threshold
                        (if (node_eq proposal (lwo-none)) proposals
                            (lwo-field-add proposals proposal))))))))

(defn lwtf-proposals (world threshold)
    (lwtf-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwtf-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtf-observation?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwtf-candidate-current? (world candidate)
    (if (eq (lwtf-candidate? candidate) 0) 0
        (do
            (let fresh
                (lwtf-proposal-for world
                    (lwo-emergent-shape candidate)
                    (lwo-emergent-threshold candidate)))
            (if (node_eq fresh (lwo-none)) 0
                (if (node_eq candidate
                        (lwt-proposal-candidate fresh)) 1 0)))))

(defn lwtf-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtf-candidate-current? world candidate) 1)) 1 0))

(defn lwtf-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtf-candidate-current? world
            (lwt-proposal-candidate proposal))))

(defn lwtf-integrate (round proposal action)
    (if (eq (lwtf-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; children: current candidate, exact observation, active integration
; attributions, current recurrence witnesses, origin, local path
(defn lwtf-derivation (world candidate)
    (intern_node LWTF-DERIVATION
        (list candidate (lwo-emergent-shape candidate)
              (lwo-active-attributions-for world candidate)
              (lwo-emergent-witnesses candidate)
              (lwo-emergent-provenance candidate)
              (lwo-local-path))))
(defn lwtf-derivation? (cell) (lwo-category? cell LWTF-DERIVATION))
(defn lwtf-derivation-candidate (derivation)
    (nth (node_children derivation) 0))
(defn lwtf-derivation-observation (derivation)
    (nth (node_children derivation) 1))
(defn lwtf-derivation-next (derivation)
    (lwtf-observation-next
        (lwtf-derivation-observation derivation)))
(defn lwtf-derivation-attributions (derivation)
    (nth (node_children derivation) 2))
(defn lwtf-derivation-witnesses (derivation)
    (nth (node_children derivation) 3))

(defn lwtf-derivation-current? (world derivation)
    (if (eq (lwtf-derivation? derivation) 0) 0
        (do
            (let candidate (lwtf-derivation-candidate derivation))
            (if (and (eq (lwtf-integrated-current? world candidate) 1)
                     (node_eq derivation
                        (lwtf-derivation world candidate))) 1 0))))

(defn lwtf-derivations-items (world items context derivations)
    (if (eq (len items) 0) derivations
        (do
            (let candidate (head items))
            (if (eq (lwtf-candidate? candidate) 0)
                (lwtf-derivations-items
                    world (tail items) context derivations)
                (do
                    (let observation (lwo-emergent-shape candidate))
                    (if (and (eq (lwtf-observation-matches?
                                    observation context) 1)
                             (eq (lwtf-integrated-current?
                                    world candidate) 1))
                        (lwtf-derivations-items world (tail items) context
                            (lwo-field-add derivations
                                (lwtf-derivation world candidate)))
                        (lwtf-derivations-items
                            world (tail items) context derivations)))))))

(defn lwtf-derivations (world context)
    (lwtf-derivations-items world
        (lwo-field-items (lwo-world-cells world)) context
        (lwo-empty-field)))

(defn lwtf-possibilities-items (world items context possibilities)
    (if (eq (len items) 0) possibilities
        (do
            (let observation (head items))
            (if (and (eq (lwtf-observation-matches?
                            observation context) 1)
                     (eq (lwo-active? world observation) 1))
                (lwtf-possibilities-items world (tail items) context
                    (lwo-field-add possibilities
                        (lwtf-observation-next observation)))
                (lwtf-possibilities-items
                    world (tail items) context possibilities)))))

(defn lwtf-possibilities (world context)
    (lwtf-possibilities-items world
        (lwo-field-items (lwo-world-cells world)) context
        (lwo-empty-field)))

(defn lwtf-nexts-items (derivations nexts)
    (if (eq (len derivations) 0) nexts
        (do
            (let observation
                (lwtf-derivation-observation (head derivations)))
            (lwtf-nexts-items (tail derivations)
                (lwo-field-add nexts
                    (lwtf-observation-next observation))))))

(defn lwtf-nexts (derivations)
    (lwtf-nexts-items (lwo-field-items derivations) (lwo-empty-field)))

; children: context, derivations, current next cells, all active observed
; possibilities, optional alternatives, optional unknown, ack, local path
(defn lwtf-prediction-cell
    (context derivations nexts possibilities alternatives unknown ack)
    (intern_node LWTF-PREDICTION
        (list context derivations nexts possibilities alternatives unknown ack
              (lwo-local-path))))

(defn lwtf-predict (world context alternatives unknown)
    (do
        (let derivations (lwtf-derivations world context))
        (let nexts (lwtf-nexts derivations))
        (let count (lwo-field-size nexts))
        (let ack
            (if (eq count 0) (oac-nothing)
                (if (eq count 1)
                    (oac-one (head (lwo-field-items nexts)))
                    (oac-node nexts))))
        (lwtf-prediction-cell context derivations nexts
            (lwtf-possibilities world context)
            alternatives unknown ack)))

(defn lwtf-prediction? (cell) (lwo-category? cell LWTF-PREDICTION))
(defn lwtf-prediction-context (prediction)
    (nth (node_children prediction) 0))
(defn lwtf-prediction-derivations (prediction)
    (nth (node_children prediction) 1))
(defn lwtf-prediction-nexts (prediction)
    (nth (node_children prediction) 2))
(defn lwtf-prediction-possibilities (prediction)
    (nth (node_children prediction) 3))
(defn lwtf-prediction-alternatives (prediction)
    (nth (node_children prediction) 4))
(defn lwtf-prediction-unknown (prediction)
    (nth (node_children prediction) 5))
(defn lwtf-prediction-ack (prediction)
    (nth (node_children prediction) 6))

(defn lwtf-prediction-current? (world prediction)
    (if (eq (lwtf-prediction? prediction) 0) 0
        (if (node_eq prediction
                (lwtf-predict world
                    (lwtf-prediction-context prediction)
                    (lwtf-prediction-alternatives prediction)
                    (lwtf-prediction-unknown prediction))) 1 0)))

0
