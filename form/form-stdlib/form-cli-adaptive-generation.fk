; form-cli-adaptive-generation.fk — pure selection and evidence face.
;
; preludes: form-stdlib/core.fk
;
; The carrier-facing runner invokes models; this cell keeps the meaning in Form:
; cheap local, then strongest local, then remote, with every observed response
; retained and an explicit exhausted miss.

(do
    (defn fnr-usable? (reply)
        (if (and (gt (str_len reply) 80)
                 (and (ge (str_find reply "GROUNDING:" 0) 0)
                      (and (ge (str_find reply "ANSWER:" 0) 0)
                           (and (ge (str_find reply "UNCERTAINTY:" 0) 0)
                                (and (lt (str_find reply "true by definition" 0) 0)
                                     (and (lt (str_find reply "unchangeable" 0) 0)
                                          (lt (str_find reply "without proof" 0) 0)))))))
            1 0))

    (defn fnr-selection (selected reply cheap strong remote exhausted)
        (list selected reply cheap strong remote exhausted))
    (defn fnr-s-selected (s) (nth s 0))
    (defn fnr-s-reply (s) (nth s 1))
    (defn fnr-s-cheap (s) (nth s 2))
    (defn fnr-s-strong (s) (nth s 3))
    (defn fnr-s-remote (s) (nth s 4))
    (defn fnr-s-exhausted (s) (nth s 5))

    (defn fnr-select-adaptive (cheap strong remote)
        (if (eq (fnr-usable? cheap) 1)
            (fnr-selection "local-cheap" cheap cheap "" "" 0)
            (if (eq (fnr-usable? strong) 1)
                (fnr-selection "local-strong" strong cheap strong "" 0)
                (if (eq (fnr-usable? remote) 1)
                    (fnr-selection "remote" remote cheap strong remote 0)
                    (fnr-selection "miss" "" cheap strong remote 1)))))

    (defn fnr-adaptive-evidence (prompt native-miss selection)
        (do
            (let a (str_concat "FORM-CLI-INFERENCE v1\nNATIVE-MISS " native-miss))
            (let b (str_concat a (str_concat "\nPROMPT-BEGIN\n" prompt)))
            (let c (str_concat b (str_concat "\nPROMPT-END\nCHEAP-BEGIN\n"
                                             (fnr-s-cheap selection))))
            (let d (str_concat c (str_concat "\nCHEAP-END\nSTRONG-BEGIN\n"
                                             (fnr-s-strong selection))))
            (let e (str_concat d (str_concat "\nSTRONG-END\nREMOTE-BEGIN\n"
                                             (fnr-s-remote selection))))
            (let f (str_concat e (str_concat "\nREMOTE-END\nSELECTED "
                                             (fnr-s-selected selection))))
            (str_concat f (str_concat "\nEXHAUSTED "
                (if (eq (fnr-s-exhausted selection) 1) "1" "0")))))

    (defn fnr-render-selection (selection)
        (do
            (let a (str_concat (fnr-s-reply selection)
                        (str_concat "\nform-cli-generation-lane:"
                                    (fnr-s-selected selection))))
            (let b (str_concat a
                        "\nform-cli-native-attempts:1\nform-cli-native-accepted:0"))
            (let c (str_concat b
                        (str_concat "\nform-cli-local-cheap-attempts:"
                            (if (gt (str_len (fnr-s-cheap selection)) 0) "1" "0"))))
            (let d (str_concat c
                        (str_concat "\nform-cli-local-cheap-accepted:"
                            (if (str_eq (fnr-s-selected selection) "local-cheap") "1" "0"))))
            (let e (str_concat d
                        (str_concat "\nform-cli-local-strong-attempts:"
                            (if (gt (str_len (fnr-s-strong selection)) 0) "1" "0"))))
            (let f (str_concat e
                        (str_concat "\nform-cli-local-strong-accepted:"
                            (if (str_eq (fnr-s-selected selection) "local-strong") "1" "0"))))
            (let g (str_concat f
                        (str_concat "\nform-cli-remote-attempts:"
                            (if (gt (str_len (fnr-s-remote selection)) 0) "1" "0"))))
            (let h (str_concat g
                        (str_concat "\nform-cli-remote-accepted:"
                            (if (str_eq (fnr-s-selected selection) "remote") "1" "0"))))
            (str_concat h
                (str_concat "\nform-cli-exhausted:"
                    (if (eq (fnr-s-exhausted selection) 1) "1" "0")))))
    0)
