// runtime-artifact-retry.fk -- Layer 9d retained operation outcome face.
//
// This layer consumes Layer 9c `runtime-artifact-outcome` rows and emits retry
// rows. An admitted failure stays with its owning operation for repair;
// this layer never fabricates another selection. It does not generate runtime
// observations, load or walk `.fkb`, load or call `.dylib`, bind symbols,
// decide source-runner admission, reverify proof/callable receipts, or grow the
// C seed.
//
// Retry matrix:
//   repair-required                               -> waiting-repair
//   complete                                      -> terminal-complete
//   pending-observation                           -> waiting-observation
//   investigate                                   -> terminal-investigate
//   refused                                       -> terminal-refused
//   hard observation status                       -> investigate
//   malformed outcome                             -> refused
//
// The row carries the exact source outcome as provenance. The actual runner
// owns repair events and re-observes that same operation; its new outcome enters
// rao-outcome-from-selection-observation, and success becomes terminal-complete.
// This synthetic row layer owns no event subscription or execution continuation.
//
import form-stdlib/core.fk;
import form-stdlib/source-artifact-cache.fk;
import form-stdlib/source-artifact-descriptor.fk;
import form-stdlib/runtime-artifact-plan.fk;
import form-stdlib/runtime-artifact-selector.fk;
import form-stdlib/runtime-artifact-outcome.fk;
section [form.bml] {
    def rar-feature(name, status) = ["runtime-artifact-retry-feature", name, status];
    def rar-feature-name(f) = f[1];
    def rar-feature-status(f) = f[2];
    def runtime-artifact-retry-manifest() = [rar-feature("retry-face-not-execution", 1), rar-feature("consumes-rao-outcome-only", 1), rar-feature("total-retry-row", 1), rar-feature("admitted-failure-waits-for-owner-repair", 1), rar-feature("hard-outcomes-do-not-retry", 1), rar-feature("no-fabricated-next-selection", 1), rar-feature("retry-row-carries-source-outcome", 1), rar-feature("no-descriptor-consumption", 1), rar-feature("no-rap-plan-consumption", 1), rar-feature("no-observation-generation", 1), rar-feature("no-runtime-load-walk-call-exec", 1), rar-feature("no-fallback-execution-or-retry-loop", 1), rar-feature("no-admission-policy", 1), rar-feature("no-seal-proof-callable-reverify", 1), rar-feature("no-c-seed-growth-or-selector-install", 1)];
    def runtime-artifact-retry-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rar-feature-name(fs[0]) == name && (Comparable) rar-feature-status(fs[0]) == 1 ? 1 : runtime-artifact-retry-manifest-has?(name, fs[1:]);
    def rar-status-retry-ready() = "retry-ready";
    def rar-status-terminal-complete() = "terminal-complete";
    def rar-status-waiting-observation() = "waiting-observation";
    def rar-status-waiting-repair() = "waiting-repair";
    def rar-status-terminal-investigate() = "terminal-investigate";
    def rar-status-terminal-refused() = "terminal-refused";
    def rar-status-investigate() = "investigate";
    def rar-status-refused() = "refused";
    def rar-reason-owner-repair-required() = "owner-repair-required";
    def rar-reason-invalid-repair-outcome() = "invalid-repair-required-outcome";
    def rar-reason-terminal-complete() = "terminal-complete";
    def rar-reason-waiting-observation() = "waiting-observation";
    def rar-reason-outcome-investigates() = "outcome-investigates";
    def rar-reason-outcome-refused() = "outcome-refused";
    def rar-reason-unknown-outcome-status() = "unknown-outcome-status";
    def rar-reason-malformed-outcome() = "malformed-outcome";
    def rar-no-selection() = ["runtime-artifact-no-retry-selection"];
    def rar-no-selection?(s) = (Comparable) len(s) == 1 ? (String) s[0] == "runtime-artifact-no-retry-selection" : 0;
    // retry = ("runtime-artifact-retry" source-outcome prior-route
    //          prior-attempted fallback next-selection status reason
    //          prior-outcome-status prior-outcome-reason)
    def rar-retry(source-outcome, prior-route, prior-attempted, fallback, next-selection, status, reason, prior-status, prior-reason) = ["runtime-artifact-retry", source-outcome, prior-route, prior-attempted, fallback, next-selection, status, reason, prior-status, prior-reason];
    def rar-retry?(r) = (Comparable) len(r) == 10 ? (String) r[0] == "runtime-artifact-retry" : 0;
    def rar-retry-source-outcome(r) = r[1];
    def rar-retry-prior-route(r) = r[2];
    def rar-retry-prior-attempted(r) = r[3];
    def rar-retry-fallback(r) = r[4];
    def rar-retry-next-selection(r) = r[5];
    def rar-retry-status(r) = r[6];
    def rar-retry-reason(r) = r[7];
    def rar-retry-prior-status(r) = r[8];
    def rar-retry-prior-reason(r) = r[9];
    def rar-source-selected?(o) = (String) rao-outcome-selection-status(o) == ras-status-selected();
    def rar-soft-observation?(o) = rao-soft-status?(rao-outcome-observation-status(o));
    def rar-row-from-outcome(o, next-selection, status, reason) = rar-retry(o, rao-outcome-route(o), rao-outcome-attempted(o), rao-outcome-fallback(o), next-selection, status, reason, rao-outcome-status(o), rao-outcome-reason(o));
    def rar-refused-row() = rar-retry(["runtime-artifact-malformed-outcome"], rao-route-unknown(), rao-action-none(), rao-action-none(), rar-no-selection(), rar-status-refused(), rar-reason-malformed-outcome(), rar-status-refused(), rar-reason-malformed-outcome());
    def rar-no-selection-row(o, status, reason) = rar-row-from-outcome(o, rar-no-selection(), status, reason);
    def rar-retry-from-repair-required(o) = rar-source-selected?(o) && rar-soft-observation?(o) ? rar-no-selection-row(o, rar-status-waiting-repair(), rar-reason-owner-repair-required()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-invalid-repair-outcome());
    def rar-retry-from-outcome(o) = (Comparable) rao-outcome?(o) == 1 ? (String) rao-outcome-status(o) == rao-status-repair-required() ? rar-retry-from-repair-required(o) : (String) rao-outcome-status(o) == rao-status-complete() ? rar-no-selection-row(o, rar-status-terminal-complete(), rar-reason-terminal-complete()) : (String) rao-outcome-status(o) == rao-status-pending-observation() ? rar-no-selection-row(o, rar-status-waiting-observation(), rar-reason-waiting-observation()) : (String) rao-outcome-status(o) == rao-status-investigate() ? rar-no-selection-row(o, rar-status-terminal-investigate(), rar-reason-outcome-investigates()) : (String) rao-outcome-status(o) == rao-status-refused() ? rar-no-selection-row(o, rar-status-terminal-refused(), rar-reason-outcome-refused()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-unknown-outcome-status()) : rar-refused-row();
}
