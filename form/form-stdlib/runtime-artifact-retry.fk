// runtime-artifact-retry.fk -- Layer 9d fallback re-selection face.
//
// This layer consumes Layer 9c `runtime-artifact-outcome` rows and emits retry
// rows. It may request a new synthetic `ras-selection` for the two reviewed
// fallback pairings, but it does not execute that fallback, generate runtime
// observations, load or walk `.fkb`, load or call `.dylib`, bind symbols,
// decide source-runner admission, reverify proof/callable receipts, or grow the
// C seed.
//
// Retry matrix:
//   fallback-available, run-native -> run-program-image  -> retry-ready
//   fallback-available, run-program-image -> compile-source -> retry-ready
//   complete                                      -> terminal-complete
//   pending-observation                           -> waiting-observation
//   investigate                                   -> terminal-investigate
//   refused                                       -> terminal-refused
//   hard observation status                       -> investigate
//   unknown fallback pairing                      -> investigate
//   malformed outcome                             -> refused
//
// The retry row carries the full source outcome as provenance. The nested
// selection is a next-request row, not proof that the fallback ran or succeeded.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk
section [form.bml] {
    def rar-feature(name, status) = ["runtime-artifact-retry-feature", name, status];
    def rar-feature-name(f) = f[1];
    def rar-feature-status(f) = f[2];
    def runtime-artifact-retry-manifest() = [rar-feature("retry-face-not-execution", 1), rar-feature("consumes-rao-outcome-only", 1), rar-feature("total-retry-row", 1), rar-feature("fallback-available-only-retries", 1), rar-feature("hard-outcomes-do-not-retry", 1), rar-feature("synthetic-fallback-selection-not-from-plan", 1), rar-feature("known-pairing-table-only", 1), rar-feature("retry-row-carries-source-outcome", 1), rar-feature("no-descriptor-consumption", 1), rar-feature("no-rap-plan-consumption", 1), rar-feature("no-observation-generation", 1), rar-feature("no-runtime-load-walk-call-exec", 1), rar-feature("no-fallback-execution-or-retry-loop", 1), rar-feature("no-admission-policy", 1), rar-feature("no-seal-proof-callable-reverify", 1), rar-feature("no-c-seed-growth-or-selector-install", 1)];
    def runtime-artifact-retry-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rar-feature-name(head(fs)) == name && (Comparable) rar-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-retry-manifest-has?(name, tail(fs));
    def rar-status-retry-ready() = "retry-ready";
    def rar-status-terminal-complete() = "terminal-complete";
    def rar-status-waiting-observation() = "waiting-observation";
    def rar-status-terminal-investigate() = "terminal-investigate";
    def rar-status-terminal-refused() = "terminal-refused";
    def rar-status-investigate() = "investigate";
    def rar-status-refused() = "refused";
    def rar-reason-fallback-reselected-program-image() = "fallback-reselected-program-image";
    def rar-reason-fallback-reselected-compile-source() = "fallback-reselected-compile-source";
    def rar-reason-terminal-complete() = "terminal-complete";
    def rar-reason-waiting-observation() = "waiting-observation";
    def rar-reason-outcome-investigates() = "outcome-investigates";
    def rar-reason-outcome-refused() = "outcome-refused";
    def rar-reason-hard-outcome-no-retry() = "hard-outcome-no-retry";
    def rar-reason-corrupt-fallback-available() = "corrupt-fallback-available";
    def rar-reason-unknown-fallback-pairing() = "unknown-fallback-pairing";
    def rar-reason-unknown-outcome-status() = "unknown-outcome-status";
    def rar-reason-malformed-outcome() = "malformed-outcome";
    def rar-no-selection() = ["runtime-artifact-no-retry-selection"];
    def rar-no-selection?(s) = (Comparable) len(s) == 1 ? (String) s[0] == "runtime-artifact-no-retry-selection" : 0;
    // retry = ("runtime-artifact-retry" source-outcome prior-route
    //          prior-attempted fallback next-selection status reason
    //          prior-outcome-status prior-outcome-reason)
    def rar-retry(source-outcome, prior-route, prior-attempted, fallback, next-selection, status, reason, prior-status, prior-reason) = ["runtime-artifact-retry", source-outcome, prior-route, prior-attempted, fallback, next-selection, status, reason, prior-status, prior-reason];
    def rar-retry?(r) = (Comparable) len(r) == 10 ? (String) r[0] == "runtime-artifact-retry" : 0;
    def rar-retry-source-outcome(r) = r[1];
    def rar-retry-prior-route(r) = r[2];
    def rar-retry-prior-attempted(r) = r[3];
    def rar-retry-fallback(r) = r[4];
    def rar-retry-next-selection(r) = r[5];
    def rar-retry-status(r) = r[6];
    def rar-retry-reason(r) = r[7];
    def rar-retry-prior-status(r) = r[8];
    def rar-retry-prior-reason(r) = r[9];
    def rar-next-program-image-selection() = ras-selection(sac-run-fkb(), rap-act-run-program-image(), rap-act-compile-source(), ras-status-selected(), 1, 0, ras-reason-selected-program-image());
    def rar-next-compile-source-selection() = ras-selection(sac-run-source-compile(), rap-act-compile-source(), rap-act-none(), ras-status-selected(), 0, 0, ras-reason-selected-compile-source());
    def rar-known-native-fallback?(o) = (String) rao-outcome-attempted(o) == rap-act-run-native() ? (String) rao-outcome-fallback(o) == rap-act-run-program-image() : 0;
    def rar-known-fkb-fallback?(o) = (String) rao-outcome-attempted(o) == rap-act-run-program-image() ? (String) rao-outcome-fallback(o) == rap-act-compile-source() : 0;
    def rar-fallback-present?(o) = (String) rao-outcome-fallback(o) == rap-act-none() ? 0 : 1;
    def rar-source-selected?(o) = (String) rao-outcome-selection-status(o) == ras-status-selected();
    def rar-soft-observation?(o) = rao-soft-status?(rao-outcome-observation-status(o));
    def rar-hard-observation?(o) = rao-hard-status?(rao-outcome-observation-status(o));
    def rar-row-from-outcome(o, next-selection, status, reason) = rar-retry(o, rao-outcome-route(o), rao-outcome-attempted(o), rao-outcome-fallback(o), next-selection, status, reason, rao-outcome-status(o), rao-outcome-reason(o));
    def rar-refused-row() = rar-retry(["runtime-artifact-malformed-outcome"], rao-route-unknown(), rao-action-none(), rao-action-none(), rar-no-selection(), rar-status-refused(), rar-reason-malformed-outcome(), rar-status-refused(), rar-reason-malformed-outcome());
    def rar-no-selection-row(o, status, reason) = rar-row-from-outcome(o, rar-no-selection(), status, reason);
    def rar-retry-from-fallback-available(o) = (Comparable) rar-source-selected?(o) == 1 ? (Comparable) rar-fallback-present?(o) == 1 ? (Comparable) rar-hard-observation?(o) == 1 ? rar-no-selection-row(o, rar-status-investigate(), rar-reason-hard-outcome-no-retry()) : (Comparable) rar-soft-observation?(o) == 1 ? (Comparable) rar-known-native-fallback?(o) == 1 ? rar-row-from-outcome(o, rar-next-program-image-selection(), rar-status-retry-ready(), rar-reason-fallback-reselected-program-image()) : (Comparable) rar-known-fkb-fallback?(o) == 1 ? rar-row-from-outcome(o, rar-next-compile-source-selection(), rar-status-retry-ready(), rar-reason-fallback-reselected-compile-source()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-unknown-fallback-pairing()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-corrupt-fallback-available()) : rar-no-selection-row(o, rar-status-refused(), rar-reason-corrupt-fallback-available()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-corrupt-fallback-available());
    def rar-retry-from-outcome(o) = (Comparable) rao-outcome?(o) == 1 ? (String) rao-outcome-status(o) == rao-status-fallback-available() ? rar-retry-from-fallback-available(o) : (String) rao-outcome-status(o) == rao-status-complete() ? rar-no-selection-row(o, rar-status-terminal-complete(), rar-reason-terminal-complete()) : (String) rao-outcome-status(o) == rao-status-pending-observation() ? rar-no-selection-row(o, rar-status-waiting-observation(), rar-reason-waiting-observation()) : (String) rao-outcome-status(o) == rao-status-investigate() ? rar-no-selection-row(o, rar-status-terminal-investigate(), rar-reason-outcome-investigates()) : (String) rao-outcome-status(o) == rao-status-refused() ? rar-no-selection-row(o, rar-status-terminal-refused(), rar-reason-outcome-refused()) : rar-no-selection-row(o, rar-status-investigate(), rar-reason-unknown-outcome-status()) : rar-refused-row();
}
