; form-cli-core-run.fk — form-cli names the vital floor this turn.
;
; The binary ./form/form-cli already ran inquire-core and ping.
; This door is current source. Measured share lives at form-cli-share-run.fk;
; this core floor does not redeclare it.
; When form-cli-review-gap converges, the remote reviewer retires.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk form-stdlib/form-cli-review-gap.fk

(do
    (print_str
        (str_concat "form-cli executed core\n"
        (str_concat "form-cli share=run form/form-stdlib/form-cli-share-run.fk\n"
        (str_concat "form-cli remote-role=review+inbound-plugin\nform-cli free-remote=run form/form-stdlib/form-cli-free-remote-run.fk\nform-cli review-gap-converged-tol10="
        (str_concat (int_to_str (frg-converged? (list 80 40 90) (list 75 70 88) 10))
        (str_concat "\nform-cli review-gap-converged-tol1="
        (str_concat (int_to_str (frg-converged? (list 80 40 90) (list 75 70 88) 1))
        (str_concat "\n" (fcl-spoken-answer)))))))))
    0)
