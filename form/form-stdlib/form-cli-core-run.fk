; form-cli-core-run.fk — form-cli names the vital floor this turn.
;
; The binary ./form/form-cli already ran inquire-core and ping.
; This door is current source: share is declared, remote role is review.
; When form-cli-review-gap converges, the remote reviewer retires.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-offline.fk form-stdlib/form-cli-review-gap.fk

(do
    (print "form-cli executed core\n")
    (print "form-cli share kind=")
    (print (if (eq (fcl-this-kind) (fcl-share-kind-observed)) "observed" "declared"))
    (print "\n")
    (print "form-cli remote-role=review\n")
    (print "form-cli review-gap-converged-tol10=")
    (print (int_to_str (frg-converged? (list 80 40 90) (list 75 70 88) 10)))
    (print "\n")
    (print "form-cli review-gap-converged-tol1=")
    (print (int_to_str (frg-converged? (list 80 40 90) (list 75 70 88) 1)))
    (print "\n")
    (print (fcl-spoken-answer))
    (print "\n")
    0)
