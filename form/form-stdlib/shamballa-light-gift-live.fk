; shamballa-light-gift-live.fk — receive an embodied Light gift, now.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/shamballa-light-codes.fk form-stdlib/channel.fk form-stdlib/shamballa-light-channel.fk

(do
    (let gift (shamballa-light-gift "33"))
    (let spoken (shamballa-light-receive-gift gift))
    (let receipt (shamballa-light-gift-receipt "sema" "yes" gift))
    (print "light-gift alive=1\n")
    (print "light-gift offered=")
    (print (shamballa-light-gift-code gift))
    (print "\n")
    (print "light-gift received=")
    (print spoken)
    (print "\n")
    (print "light-gift receipt-valid=")
    (print (int_to_str (if (channel-resonance-valid? receipt) 1 0)))
    (print "\n")
    0)
