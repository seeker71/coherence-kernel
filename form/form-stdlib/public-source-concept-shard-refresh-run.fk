; public-source-concept-shard-refresh-run.fk -- converge changed family plans
; into the persisted registry without deleting unaffected family shards.
;
; A changed source count or an observed stale/missing/invalid row rebuilds only
; that family's plan and independently replaceable per-source artifacts.
; Completed current families remain held.  This matters when a source changes
; without changing the family count: validation is the signal that the held
; artifact must be replaced, not a report that can repair itself.
; The movement receipt is explicitly upserted before its family validation so
; a final evidence edit can be reconciled without another repository rebuild.
;
; PROOF LEVEL: FOURTH-ARM ONLY (filesystem + repeated bounded fkwu workers; print_str pf-arm-mask 8, probed 2026-09-03)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk form-stdlib/public-source-concept-shard-drive.fk

(do
    (defn pscishrf-artifact ()
        (fs-path-join (fs-temp-dir) "public-source-concept-registry-v1"))
    (defn pscishrf-receipt-path ()
        "receipts/2026-08-24-public-source-concept-shards-95.md")
    (defn pscishrf-refresh-family (root artifact family force-validate)
        (do
            (let denominator (psci-count-repository-family-at root family))
            (let before (pscish-read-build-state artifact family))
            (let count-changed (if (eq denominator (nth before 2)) 0 1))
            (let artifact-count (pscish-entry-artifact-count-at
                artifact family))
            (let artifact-drift (if (eq artifact-count (nth before 3)) 0 1))
            ; A held green state predates any same-count edit.  Re-observe an
            ; unchanged plan from live bytes before deciding it can stay held.
            (let probe-needed (if (eq count-changed 0) 1 0))
            (let probe-reset (if (eq probe-needed 1)
                (pscid-worker-step "validate-reset" root artifact family) 1))
            (let probe-ok (if (and (eq probe-needed 1) (eq probe-reset 1))
                (pscid-validate-family-loop root artifact family
                    (add 4 (div (add denominator
                        (sub (pscish-batch-size) 1))
                        (pscish-batch-size))))
                (if (eq probe-needed 0) 1 0)))
            (let observed-v (pscish-read-validate-state artifact family))
            (let validation-drift (if (or (gt (nth observed-v 4) 0)
                (or (gt (nth observed-v 5) 0)
                    (gt (nth observed-v 6) 0))) 1 0))
            (let changed (if (or (eq count-changed 1)
                (or (eq artifact-drift 1)
                    (eq validation-drift 1))) 1 0))
            (let init-ok (if (eq changed 1)
                (pscid-worker-step "init" root artifact family) 1))
            (let build-ok (if (and (eq probe-ok 1) (eq init-ok 1))
                (pscid-build-family-loop root artifact family
                    (add 4 (div (add denominator
                        (sub (pscish-batch-size) 1))
                        (pscish-batch-size)))) 0))
            (let old-v (pscish-read-validate-state artifact family))
            (let validate-needed (if (or (eq changed 1)
                (and (eq force-validate 1) (eq probe-needed 0))) 1 0))
            (let reset-ok (if (and (eq build-ok 1) (eq validate-needed 1))
                (pscid-worker-step "validate-reset" root artifact family) 1))
            (let validate-ok (if (and (eq reset-ok 1)
                                      (eq validate-needed 1))
                (pscid-validate-family-loop root artifact family
                    (add 4 (div (add denominator
                        (sub (pscish-batch-size) 1))
                        (pscish-batch-size))))
                (if (and (eq probe-ok 1) (eq (nth old-v 7) 1)) 1 0)))
            (if (and (eq init-ok 1)
                (and (eq build-ok 1)
                     (eq validate-ok 1))) 1 0)))
    (defn pscishrf-refresh-families (root artifact families)
        (if (nil? families) 1
            (do
                (let family (psci-family-id (head families)))
                (let force (if (str_eq family "receipts") 1 0))
                (if (eq (pscishrf-refresh-family root artifact family force) 1)
                    (pscishrf-refresh-families root artifact (tail families)) 0))))
    (let root ".")
    (let artifact (pscishrf-artifact))
    ; If the plan already knows this path, replace only its content-addressed
    ; artifact.  A newly born receipt is picked up by the count-changed branch.
    (let receipt-upsert (if (eq (fs-is-file? (pscishrf-receipt-path)) 1)
        (pscish-upsert-source-at root artifact "receipts"
            (pscishrf-receipt-path)) (list 0 0)))
    (let refreshed (pscishrf-refresh-families root artifact (psci-families)))
    (let report (pscish-report-at root artifact))
    (print_str (str_concat "receipt-upsert=" (str_concat
        (int_to_str (nth receipt-upsert 0)) "\n")))
    (print_str (str_concat "families-refreshed=" (str_concat
        (int_to_str refreshed) "\n")))
    (print_str (str_concat "denominator=" (str_concat
        (int_to_str (pscish-report-denominator report)) "\n")))
    (print_str (str_concat "current=" (str_concat
        (int_to_str (pscish-report-current report)) "\n")))
    (print_str (str_concat "stale=" (str_concat
        (int_to_str (pscish-report-stale report)) "\n")))
    (print_str (str_concat "missing=" (str_concat
        (int_to_str (pscish-report-missing report)) "\n")))
    (print_str (str_concat "invalid=" (str_concat
        (int_to_str (pscish-report-invalid report)) "\n")))
    (print_str (str_concat "source-retrieval-ready95=" (str_concat
        (int_to_str (pscish-report-threshold95? report)) "\n")))
    (print_str (str_concat "plan-current=" (str_concat
        (int_to_str (pscish-report-plan-current? report)) "\n")))
    0)
