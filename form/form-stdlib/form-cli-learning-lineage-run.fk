; form-cli-learning-lineage-run.fk — visible actual lineage plus the controlled
; fixed-suite promotion contract.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-learning-lineage.fk
; witnessed: 2026-08-17 -> working observation prints actual and fixture lanes

(defn fcllr-join (xs)
    (if (eq (len xs) 0) "" (str_concat (head xs) (fcllr-join (tail xs)))))
(defn fcllr-vector (v)
    (fcllr-join (list (int_to_str (nth v 0)) "/"
        (int_to_str (nth v 1)) "/" (int_to_str (nth v 2)))))
(defn fcllr-round-line (name r causal)
    (do
        (let before (fcll-o-share (fcll-before r)))
        (let after (fcll-o-share (fcll-after r)))
        (let delta (fcll-share-delta r))
        (fcllr-join (list name
            " teacher=" (fcll-teacher r) " carrier=" (fcll-carrier r)
            " before=" (fcllr-vector before) " after=" (fcllr-vector after)
            " delta=" (fcllr-vector delta)
            " home-delta=" (int_to_str (fcll-home-delta r))
            " fine-tune=" (fcll-fine-tune r)
            " native/design/logic/flow="
            (int_to_str (fcll-native-change r)) "/"
            (int_to_str (fcll-design-change r)) "/"
            (int_to_str (fcll-logic-change r)) "/"
            (int_to_str (fcll-flow-change r))
            " causal=" causal "\n"))))

(do
    (let actual (fcll-actual-round))
    (let local-round (fcll-fixture-local-round))
    (let native-round (fcll-fixture-native-round))
    (print_str (fcllr-join (list
        "form-cli learning lineage\n"
        (fcllr-round-line "actual" actual "unproven-workloads-differ")
        "actual-source remote-model-teacher=0 user-teacher=1 remote-carried=1\n"
        "actual-reading local+5 remote-1 native-4 home+1; contextual movement, not fine-tune causality\n"
        "actual-embodiment fine-tune=none native=form-rollout-meter design=teacher-carrier-separation logic=withhold-unreconciled flow=resumable-refresh\n"
        (fcllr-round-line "fixture-local" local-round "fixture-contract-not-production")
        (fcllr-round-line "fixture-native" native-round "fixture-contract-not-production")
        "healthy-invariant home-share-nondecreasing=1 remote-share-nonincreasing=1 heldout-before-local=1 native-band-before-native=1\n"
        "local-is-a-bridge: requiring local to rise while it becomes native would misread successful transfer\n")))
    0)
