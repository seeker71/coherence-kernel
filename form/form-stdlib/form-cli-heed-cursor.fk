// form-cli-heed-cursor.fk — the production bridge: a live streaming cursor that
// carries a Form knowledge query from the model's own decoded stream into a
// Form lookup, and the typed observation back in as ordinary prefill.
//
// THE HONEST SEAM, and it is the same one form-knowledge-query-token.fk names.
// The model emits ids. A forward pass produces a distribution over ids and
// NOTHING ELSE — no logit executed the lookup. This cursor recognizes a COMPLETE
// envelope in the bytes those ids decode to, pauses decoding, and offers the
// surface to a lookup. The answer re-enters as prefill before the next model
// token. `fhc-model-executed` is 0 by construction.
//
// STREAMING, NOT PRE-MATERIALIZED. There is no ops table, no flattened surface,
// no pre-built token index, and no pretokenization here. The cursor holds bytes
// only, under two named caps in the current mechanism:
//
//   before an open mark   at most fhm-detect-cap() — just enough tail for an
//                         open mark split across tokens to still form
//   while holding a frame from the open mark onward, refused past fhm-hold-cap()
//
// THE OPEN MARK IS NEVER CLIPPED AWAY. An earlier draft kept one rolling window
// clipped from the left at frame width. An over-long query pushed its own open
// mark out of that window, the frame never completed, and the model asked and
// heard nothing back — no observation, no reason, no status. Silence that a
// status could have named is the one failure this cell must not have. Now, once
// an open mark is seen the window holds FROM it, and outgrowing fhm-hold-cap()
// is an observation: `nothing` with reason query-budget-exceeded, and no IO.
//
// TIMEOUT IS A NAMED OBSERVATION CARRYING ITS MEASUREMENT, never a bit. A lookup
// that runs long is reported as nothing with reason lookup-late-<n>ms, and the
// elapsed reading is kept in the cursor so a witness reads the margin rather
// than a verdict someone already collapsed to 0/1.
//
// THE MODEL CROSSES AS FIVE FUNCTION VALUES OVER AN OPAQUE CTX, so this cell
// names no model, no device, and no corpus, and preflights clean on any kernel:
//   stepf    (ctx id pos)   -> next id            one forward pass, argmax
//   prefillf (ctx ids pos)  -> (list first pos')  incremental prefill, SAME state
//   decodef  (ctx ids)      -> text               ids to bytes
//   encodef  (ctx text)     -> ids                bytes to ids
//   lookupf  (ctx surface local-ready) -> (list status span reason)
//
// WHY THE CTX IS THREADED AND NOT CLOSED OVER. This dialect has no lambda, so a
// two-argument stepf could never reach a live model's pipelines, buffers,
// geometry, layers, decode state and tensor views. ctx carries exactly that,
// and this cell never looks inside it. The live Qwen lane packs
// (ps bs geo lays sts embTv onormTv projTv src); a band packs 0.
//
// WHY lookupf RETURNS A TRIPLE AND NOT AN ABI RESULT. This cell names no ABI at
// all. status is one of hit/miss/nothing, span is the already-rendered typed
// observation, reason is free text. The adapter that turns a knowledge ABI into
// that triple lives beside it, so the cursor mechanism and any ABI can land in either
// order and a second substrate needs a second adapter, not a second cursor.
//
// WHY PREFILL IS THE WHOLE PERFORMANCE ARGUMENT. prefillf threads the SAME
// decode state at a position, so every position before the injection keeps the
// KV rows it was written with. An injected observation costs its own span, not
// the context it lands in.
//
// THE BOUND is form-cli-heedmark's, mapped onto the adapter's status:
//   hit         the typed observation enters, attribution carried by the adapter
//   miss        the typed observation enters, answer empty — a model told
//               nothing invents the row the body does not hold
//   nothing     nothing enters; axiom-1. Covers a declined frame, an over-budget
//               frame (no IO at all), and a late lookup (named with its ms)
//   spent       the per-turn budget is gone; the envelope is NOT executed and
//               the mark stays plain text. Checked BEFORE any lookup.
//
// PRELUDE ORDER IS LOAD-BEARING. language-template.fk comes BEFORE the xtal: the
// lowered HeedRequest template calls language-template-with-members, and without
// it first the chain reports a ts-only lane seam and every verdict downstream is
// a fold over nothing. Dependency-first, full closure — a sibling's prelude does
// not count for this unit.
//
// preludes: form-stdlib/core.fk form-stdlib/language-template.fk form-stdlib/form-cli-heedmark.bml
//
section [form.bml] {
    // ── the two bounded windows ────────────────────────────────────────────
    def fhc-detect-cap() = fhm-detect-cap();
    def fhc-hold-cap() = fhm-hold-cap();
    def fhc-clip-left(s, cap) = str_len(s) <= cap ? s : substring(s, str_len(s) - cap, str_len(s));
    // Feed one token's bytes. Before an open mark, keep only enough tail for a
    // split open mark to form. From an open mark onward, keep FROM it — the
    // mark is never clipped away, which is what makes an over-long query
    // observable instead of silent.
    def fhc-feed(window, text) = {
        let w = str_concat(window, text);
        let o = str_find(w, HeedOpen(), 0);
        o < 0 ? fhc-clip-left(w, fhc-detect-cap()) : substring(w, o, str_len(w));
    };
    // ── the scan: none | held | complete | over-budget ─────────────────────
    // held is not a failure. It is the cursor waiting for the close mark, and it
    // is why a multi-token envelope survives a byte-BPE that splits it.
    def fhc-has-close?(window, o) = str_find(window, HeedClose(), o + str_len(HeedOpen())) >= 0 ? 1 : 0;
    def fhc-scan(window) = {
        let o = str_find(window, HeedOpen(), 0);
        o < 0 ? fhm-state-none() : {
            let hc = fhc-has-close?(window, o);
            (Comparable) hc == 1 ? fhm-state-complete() : (Comparable) fhm-over-budget?(str_len(window), hc) == 1 ? fhm-state-over() : fhm-state-held();
        };
    };
    // The surface fkqt-parse wants: opens with the open mark, closes with the
    // close mark, no trailing bytes. The stream grammar intentionally permits
    // that exact frame inside ordinary decoded output: leading/trailing model
    // bytes remain in `out`, while only this sliced frame crosses the strict
    // parser. Prompt examples never cross this cursor; only newly decoded ids do.
    def fhc-frame(window) = {
        let o = str_find(window, HeedOpen(), 0);
        o < 0 ? "" : {
            let c = str_find(window, HeedClose(), o + str_len(HeedOpen()));
            c < 0 ? "" : substring(window, o, c + str_len(HeedClose()));
        };
    };
    // ── the two-phase ledger ───────────────────────────────────────────────
    // (phase query-left answer-left query-cut timeout answer-cap answer-cut).
    // answer-left holds the reserve
    // from the start and is UNTOUCHABLE while phase is PhaseQuery — that is what
    // non-borrowable means here, and it is why query verbosity can never reach
    // the answer. Opening the answer phase zeroes the query remainder into `cut`
    // rather than carrying it: unused query fuel is cut, not banked.
    def fhc-ledger(phase, query-left, answer-left, cut, timeout, answer-cap, answer-cut) = [phase, query-left, answer-left, cut, timeout, answer-cap, answer-cut];
    def fhc-ledger-phase(l) = l[0];
    def fhc-ledger-query(l) = l[1];
    def fhc-ledger-answer(l) = l[2];
    def fhc-ledger-cut(l) = l[3];
    def fhc-ledger-timeout(l) = l[4];
    def fhc-ledger-answer-cap(l) = l[5];
    def fhc-ledger-answer-cut(l) = l[6];
    def fhc-ledger-two-phase(query, reserve) = fhc-ledger(PhaseQuery(), query, reserve, 0, 0, reserve, 0);
    // A fungible budget is one phase with no reserve — the old contract, kept
    // exactly so the existing entry points mean what they always meant.
    def fhc-ledger-fungible(n) = fhc-ledger(PhaseQuery(), n, 0, 0, 0, 0, 0);
    def fhc-steps-left(l) = (Comparable) fhc-ledger-phase(l) == PhaseQuery() ? fhc-ledger-query(l) : fhc-ledger-answer(l);
    def fhc-ledger-spend(l) = (Comparable) fhc-ledger-phase(l) == PhaseQuery() ? fhc-ledger(PhaseQuery(), fhc-ledger-query(l) - 1, fhc-ledger-answer(l), fhc-ledger-cut(l), fhc-ledger-timeout(l), fhc-ledger-answer-cap(l), fhc-ledger-answer-cut(l)) : fhc-ledger(PhaseAnswer(), fhc-ledger-query(l), fhc-ledger-answer(l) - 1, fhc-ledger-cut(l), fhc-ledger-timeout(l), fhc-ledger-answer-cap(l), fhc-ledger-answer-cut(l));
    // Opened ONLY after a typed hit/miss observation has actually been injected.
    def fhc-ledger-open-answer(l) = {
        // A recursive query is composed inside the current answer phase.
        // When it closes, unused answer fuel is cut and a fresh immutable
        // reserve opens.  It is observable separately from query fuel cut.
        let answer-cut = (Comparable) fhc-ledger-phase(l) == PhaseAnswer() ? fhc-ledger-answer(l) : 0;
        fhc-ledger(PhaseAnswer(), 0, fhc-ledger-answer-cap(l), fhc-ledger-cut(l) + fhc-ledger-query(l), fhc-ledger-timeout(l), fhc-ledger-answer-cap(l), fhc-ledger-answer-cut(l) + answer-cut);
    };
    def fhc-ledger-mark-timeout(l) = fhc-ledger(fhc-ledger-phase(l), fhc-ledger-query(l), fhc-ledger-answer(l), fhc-ledger-cut(l), 1, fhc-ledger-answer-cap(l), fhc-ledger-answer-cut(l));
    // ── cursor state ───────────────────────────────────────────────────────
    // Internal shape:
    //   (window budget honor-attempts injected-ids records
    //    close-commits terminal-forwards injection-refusals
    //    frame-refusals elapsed-ms ledger query-tokens answer-tokens
    //    bytes stopped)
    //
    // The adapter contract remains the generic triple `(status span reason)`.
    // Records retain a bounded copy plus one cursor-owned injection note; a live
    // report can therefore distinguish an honor attempt from source IO without
    // teaching this model-neutral cell any source schema.
    def fhc-evidence-span-cap() = 2048;
    def fhc-evidence-reason-cap() = 192;
    def fhc-evidence-clip(s, cap) = str_len(s) <= cap ? s : substring(s, 0, cap);
    def fhc-record(status, span, reason, note) = [status, fhc-evidence-clip(span, fhc-evidence-span-cap()), fhc-evidence-clip(reason, fhc-evidence-reason-cap()), note];
    def fhc-record-status(r) = r[0];
    def fhc-record-span(r) = r[1];
    def fhc-record-reason(r) = r[2];
    def fhc-record-note(r) = r[3];
    def fhc-record-of-honor(h, note) = fhc-record(fhc-honor-status(h), fhc-honor-span(h), fhc-honor-reason(h), note);
    def fhc-records-of-statuses(statuses) = nil?(statuses) ? empty() : cons(fhc-record(head(statuses), "", "", ""), fhc-records-of-statuses(tail(statuses)));
    // Compatibility constructor for pure callers that only carry statuses.
    def fhc-cursor(window, budget, attempts, injected, honored) = fhc-state-full(window, budget, attempts, injected, fhc-records-of-statuses(honored), 0, 0, 0, 0, 0);
    def fhc-state(window, budget, attempts, injected, records, commits, terminals, refusals) = fhc-state-full(window, budget, attempts, injected, records, commits, terminals, refusals, 0, 0);
    def fhc-state-full(window, budget, attempts, injected, records, commits, terminals, injection-refusals, frame-refusals, elapsed) = fhc-state-2p-full(window, budget, attempts, injected, records, commits, terminals, injection-refusals, frame-refusals, elapsed, fhc-ledger-fungible(0), 0, 0, 0, 0);
    def fhc-state-2p-full(window, budget, attempts, injected, records, commits, terminals, injection-refusals, frame-refusals, elapsed, ledger, query-tokens, answer-tokens, bytes, stopped) = [window, budget, attempts, injected, records, commits, terminals, injection-refusals, frame-refusals, elapsed, ledger, query-tokens, answer-tokens, bytes, stopped];
    def fhc-window(c) = c[0];
    def fhc-budget(c) = c[1];
    def fhc-attempts(c) = c[2];
    // Kept as a compatibility alias. It never claims source IO; reports use the
    // explicit honor-attempt and source-search names.
    def fhc-lookups(c) = fhc-attempts(c);
    def fhc-injected(c) = c[3];
    def fhc-records(c) = c[4];
    def fhc-statuses-of-records(records) = nil?(records) ? empty() : cons(fhc-record-status(head(records)), fhc-statuses-of-records(tail(records)));
    def fhc-honored(c) = fhc-statuses-of-records(fhc-records(c));
    def fhc-close-commits(c) = c[5];
    def fhc-terminal-forwards(c) = c[6];
    def fhc-injection-refusals(c) = c[7];
    def fhc-frame-refusals(c) = c[8];
    // Compatibility name used by the adversarial cursor band.
    def fhc-refused(c) = fhc-frame-refusals(c);
    def fhc-elapsed(c) = c[9];
    def fhc-ledger-of(c) = c[10];
    def fhc-query-tokens(c) = c[11];
    def fhc-answer-tokens(c) = c[12];
    def fhc-bytes(c) = c[13];
    def fhc-stopped?(c) = c[14];
    def fhc-phase(c) = fhc-ledger-phase(fhc-ledger-of(c));
    def fhc-cut(c) = fhc-ledger-cut(fhc-ledger-of(c));
    def fhc-timeout?(c) = fhc-ledger-timeout(fhc-ledger-of(c));
    def fhc-query-left(c) = fhc-ledger-query(fhc-ledger-of(c));
    def fhc-answer-left(c) = fhc-ledger-answer(fhc-ledger-of(c));
    def fhc-answer-cap(c) = fhc-ledger-answer-cap(fhc-ledger-of(c));
    def fhc-answer-cut(c) = fhc-ledger-answer-cut(fhc-ledger-of(c));
    def fhc-fresh(budget) = fhc-state-full("", budget, 0, 0, empty(), 0, 0, 0, 0, 0);
    def fhc-fresh-2p(heeds, query, reserve) = fhc-state-2p-full("", heeds, 0, 0, empty(), 0, 0, 0, 0, 0, fhc-ledger-two-phase(query, reserve), 0, 0, 0, 0);
    def fhc-with-ledger(c, ledger) = fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), fhc-records(c), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), ledger, fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
    def fhc-with-window(c, window) = fhc-state-2p-full(window, fhc-budget(c), fhc-attempts(c), fhc-injected(c), fhc-records(c), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-of(c), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
    def fhc-with-terminal-forward(c) = fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), fhc-records(c), fhc-close-commits(c), fhc-terminal-forwards(c) + 1, fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-of(c), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
    // ── status -> the current heedmark mechanism ───────────────────────────
    def fhc-outcome-of(status) = (String) status == "hit" ? OutHit() : (String) status == "miss" ? OutMiss() : (String) status == "spent" ? OutSpent() : OutNothing();
    def fhc-enters?(status) = fhm-injects-span(fhc-outcome-of(status));
    def fhc-knowledge?(status) = fhm-injects-knowledge(fhc-outcome-of(status));
    def fhc-stop?(id, stops) = (Comparable) len(stops) == 0 ? 0 : (Comparable) id == head(stops) ? 1 : fhc-stop?(id, tail(stops));
    // ── honoring one complete envelope ─────────────────────────────────────
    // Budget is read BEFORE the lookup: a spent turn performs no IO. The clock
    // is read on both sides, so lateness is measured rather than assumed.
    // Returns (status span reason elapsed-ms).
    def fhc-honor(ctx, lookupf, local-ready, budget, frame) = budget <= 0 ? ["spent", "", "budget-spent", 0] : {
        let t0 = now_unix_ms();
        let r = lookupf(ctx, frame, local-ready);
        let elapsed = now_unix_ms() - t0;
        (Comparable) fhm-late?(elapsed) == 1 ? ["nothing", "", fhm-late-reason(elapsed), elapsed] : [r[0], r[1], r[2], elapsed];
    };
    // An over-budget frame: named, and NO lookup runs at all.
    def fhc-refusal() = ["nothing", "", fhm-over-reason(), 0];
    def fhc-honor-status(h) = h[0];
    def fhc-honor-span(h) = h[1];
    def fhc-honor-reason(h) = h[2];
    def fhc-honor-elapsed(h) = h[3];
    // The span that enters is whatever the adapter rendered. This cell does not
    // invent a second format and does not read an ABI to find out. The mechanism
    // still gates: nothing and spent enter nothing whatever the adapter handed
    // back.
    def fhc-span-of(status, span) = (Comparable) fhc-enters?(status) == 0 ? "" : span;
    // ── the loop ───────────────────────────────────────────────────────────
    // Returns (out cursor pos). out is the model's own id stream; injected
    // observation ids are counted in the cursor, never mixed into out, so a
    // witness can always tell what the model said from what the body answered.
    // ── closing, and the three different ways a walk can end ───────────────
    // STOP, TIMEOUT and ordinary end are three facts, not one. A scorer that
    // cannot tell them apart records a miss the model never made.
    //   stop     the model emitted a stop id — it finished on purpose
    //   timeout  the query budget ran out while a frame was still HELD. The
    //            decode timed out and the answer alternative was never tried;
    //            that is a named observation, NOT exhaustion.
    //   end      steps ran out with nothing held
    // Already-emitted model state is never undone here. The walk records what
    // happened; it does not rewind the stream.
    def fhc-note(c, reason) = fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), append(fhc-records(c), [fhc-record(reason, "", reason, fhm-timeout-alternative())]), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-mark-timeout(fhc-ledger-of(c)), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
    def fhc-mark-stopped(c) = fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), fhc-records(c), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-of(c), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), 1);
    def fhc-close(c, out, pos) = (Comparable) fhc-phase(c) == PhaseQuery() && (String) fhc-scan(fhc-window(c)) == fhm-state-held() ? [out, fhc-note(c, fhm-timeout-reason()), pos] : [out, c, pos];
    // ── the fourth ending: the body closes what the model left open ────────
    // stop, timeout and end are three facts; this is a fourth, kept just as
    // distinct. When the QUERY budget dies with a frame still HELD and a real
    // answer reserve exists, the partial surface is not discarded: the body
    // appends the close mark itself, honors ONE lookup on that body-closed
    // frame through the ordinary resume machinery (hit and miss inject a
    // typed observation and open the reserve; nothing and spent inject
    // nothing and the walk ends as before), and every such walk carries a
    // "body-closed" record so no scorer can mistake a body-closed frame for
    // a model-closed one. Fungible walks (answer-cap 0) keep the old timeout
    // ending byte-for-byte — the reserve is what makes continuing honest.
    // Witnessed need: 2026-08-30, two live runs whose models asked correct
    // questions and starved mid-envelope (the T3 partial surface was exactly
    // `bootstrap/ground`).
    def fhc-with-body-closed(c) = fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), append(fhc-records(c), [fhc-record("body-closed", "", "query-timeout-body-closed", "held-frame-honored")]), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-of(c), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
    def fhc-close-honoring(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, out) = (Comparable) fhc-phase(c) == PhaseQuery() && ((String) fhc-scan(fhc-window(c)) == fhm-state-held() && fhc-ledger-answer-cap(fhc-ledger-of(c)) > 0) ? fhc-resume(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, fhc-with-body-closed(c), str_concat(fhc-window(c), HeedClose()), out) : fhc-close(c, out, pos);
    // Bounded non-content telemetry, counted AT the live cursor: how many tokens
    // and bytes streamed in which phase. Never the stream itself.
    def fhc-count(c, txt) = {
        let l = fhc-ledger-of(c);
        let query? = (Comparable) fhc-ledger-phase(l) == PhaseQuery();
        fhc-state-2p-full(fhc-window(c), fhc-budget(c), fhc-attempts(c), fhc-injected(c), fhc-records(c), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c), fhc-elapsed(c), fhc-ledger-spend(l), query? ? fhc-query-tokens(c) + 1 : fhc-query-tokens(c), query? ? fhc-answer-tokens(c) : fhc-answer-tokens(c) + 1, fhc-bytes(c) + str_len(txt), fhc-stopped?(c));
    };
    // ── the walk ───────────────────────────────────────────────────────────
    def fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, out) = fhc-steps-left(fhc-ledger-of(c)) <= 0 ? fhc-close-honoring(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, out) : {
        let nid = stepf(ctx, id, pos);
        // stepf consumed `id` at pos even when the id it predicts is a
        // stop. Position and telemetry both retain that terminal step.
        nid < 0 ? fhc-close(fhc-with-terminal-forward(c), out, pos + 1) : (Comparable) fhc-stop?(nid, stops) == 1 ? [out, fhc-mark-stopped(fhc-with-terminal-forward(c)), pos + 1] : {
            let txt = decodef(ctx, [nid]);
            fhc-dispatch(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, nid, pos + 1, stops, fhc-count(c, txt), fhc-feed(fhc-window(c), txt), append(out, [nid]));
        };
    };
    // One token has been fed into the window; decide what it made.
    def fhc-dispatch(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, w, out) = {
        let state = fhc-scan(w);
        (String) state == fhm-state-complete() ? fhc-resume(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, w, out) : (String) state == fhm-state-over() ? fhc-refuse(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, out) : fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, fhc-with-window(c, w), out);
    };
    // ── compatibility delegates ────────────────────────────────────────────
    // The old entry points keep their exact signatures and their exact meaning:
    // one fungible budget, no reserve. Everything already written against them
    // reads what it always read. New callers take the two-phase entries below.
    def fhc-run(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, n, stops, c, out) = fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, fhc-with-ledger(c, fhc-ledger-fungible(n)), out);
    // ── the seeded entry, and why it exists ────────────────────────────────
    // A prefill answers with the FIRST GENERATED TOKEN — the argmax at the last
    // prompt position — and the position after it. That token is part of the
    // model's reply. An earlier wiring passed it to fhc-run as the `id` input
    // only, so it drove the next forward pass but its own bytes never reached
    // the window and it never reached `out`.
    //
    // The live witness is what found this. Qwen emitted a complete envelope and
    // the cursor read `|form:knowledge-query|>` — the leading `<` was the seed
    // token, dropped — so the open mark never matched and lookups stayed 0.
    // Three green bands had missed it, because a scripted stepper starts from a
    // synthetic id that was never meant to be part of the stream.
    //
    // Seed the window and the output with that token, then walk. A seed that is
    // itself a whole envelope is honored like any other completion.
    def fhc-seed-into(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, stops, c) = seed < 0 ? [empty(), c, pos] : (Comparable) fhc-stop?(seed, stops) == 1 ? [empty(), fhc-mark-stopped(c), pos] : {
        let txt = decodef(ctx, [seed]);
        fhc-dispatch(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, stops, fhc-count(c, txt), fhc-feed("", txt), [seed]);
    };
    def fhc-run-seeded(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, n, stops, budget) = fhc-seed-into(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, stops, fhc-with-ledger(fhc-fresh(budget), fhc-ledger-fungible(n)));
    // ── the two-phase entries ──────────────────────────────────────────────
    // heeds is the lookup budget; query is the step budget for composing a
    // knowledge query; reserve is the non-borrowable answer budget that opens
    // only once a typed observation has actually been injected.
    def fhc-run-2p(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, heeds, query, reserve, out) = fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, fhc-fresh-2p(heeds, query, reserve), out);
    def fhc-run-seeded-2p(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, stops, heeds, query, reserve) = fhc-seed-into(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, seed, pos, stops, fhc-fresh-2p(heeds, query, reserve));
    // An over-long query. The window is reset so the stream can carry on, the
    // refusal is counted, and the budget is UNTOUCHED — no lookup ran, so none
    // was spent. The reason is the parser's own named nothing.
    def fhc-refuse(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, out) = fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, fhc-state-2p-full("", fhc-budget(c), fhc-attempts(c), fhc-injected(c), append(fhc-records(c), [fhc-record(fhm-over-reason(), "", fhm-over-reason(), "no-source-io")]), fhc-close-commits(c), fhc-terminal-forwards(c), fhc-injection-refusals(c), fhc-frame-refusals(c) + 1, fhc-elapsed(c), fhc-ledger-of(c), fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c)), out);
    // q38-prefill has already answered its first id: it is a decoded model
    // token, not the prior id that stepf consumes. Accept it into BOTH the
    // bounded byte window and model output before asking for another forward.
    // Calling fhc-run directly at this seam would step first and silently lose
    // it. pos remains the position where first will be consumed on the next
    // step, exactly like the `(cons first (q38-generate ...))` contract.
    def fhc-walk-decoded-first(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, first, pos, stops, c, out) = fhc-steps-left(fhc-ledger-of(c)) <= 0 ? fhc-close-honoring(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, first, pos, stops, c, out) : first < 0 ? fhc-close(c, out, pos) : (Comparable) fhc-stop?(first, stops) == 1 ? [out, fhc-mark-stopped(c), pos] : {
        let txt = decodef(ctx, [first]);
        let w = fhc-feed(fhc-window(c), txt);
        let out2 = append(out, [first]);
        fhc-dispatch(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, first, pos, stops, fhc-count(c, txt), w, out2);
    };
    // Compatibility door: one fungible budget, as before.
    def fhc-run-decoded-first(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, first, pos, n, stops, c, out) = fhc-walk-decoded-first(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, first, pos, stops, fhc-with-ledger(c, fhc-ledger-fungible(n)), out);
    // A complete frame: honor it, prefill what enters, RESET the window so the
    // same envelope cannot fire twice, and carry on from where prefill left off.
    // A complete frame: honor it, prefill what enters, RESET the window so the
    // same envelope cannot fire twice, and carry on from where prefill left off.
    //
    // THE RESERVE OPENS HERE AND NOWHERE ELSE, and only when a span was actually
    // injected. A hit or a miss puts a typed observation in the stream, so the
    // model is owed room to answer it: the answer phase opens at full reserve and
    // whatever query budget is left is CUT into the ledger's `cut` rather than
    // carried. This is what makes the last query slot safe — a valid query that
    // closes on its final step still opens a full reserve.
    //
    // nothing and spent inject nothing, so they open nothing, cut nothing, and
    // spend no reserve. The walk simply continues in the phase it was already in.
    def fhc-resume(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c, w, out) = {
        let h = fhc-honor(ctx, lookupf, local-ready, fhc-budget(c), fhc-frame(w));
        let status = fhc-honor-status(h);
        let span = fhc-span-of(status, fhc-honor-span(h));
        let ids = (Comparable) str_len(span) == 0 ? empty() : encodef(ctx, span);
        let spent? = (String) status == "spent";
        let l = fhc-ledger-of(c);
        let opens? = (Comparable) fhm-opens-reserve(fhc-outcome-of(status)) == 1 && fhc-ledger-answer-cap(l) > 0 ? 1 : 0;
        // The current ledger or a real non-borrowable reserve must leave at
        // least one model-output slot after the observation. In particular,
        // a two-phase close on the final query slot may enter because its
        // answer reserve is still whole; a fungible final slot may not.
        let has-output? = (Comparable) opens? == 1 ? 1 : fhc-steps-left(l) > 0 ? 1 : 0;
        // A typed observation is useful only if at least one subsequent
        // model token can be returned. The lookup outcome and its bounded
        // evidence remain visible, but no close commit or observation
        // prefill is spent at the end of the output budget.
        let no-output? = len(ids) > 0 && (Comparable) has-output? == 0 ? 1 : 0;
        let enters? = len(ids) > 0 && (Comparable) no-output? == 0 ? 1 : 0;
        let note = (Comparable) no-output? == 1 ? "no-post-observation-output-budget" : "";
        let entered-ids = (Comparable) enters? == 1 ? ids : empty();
        let l2 = (Comparable) enters? == 1 && (Comparable) opens? == 1 ? fhc-ledger-open-answer(l) : l;
        let c2 = fhc-state-2p-full("", spent? ? fhc-budget(c) : fhc-budget(c) - 1, spent? ? fhc-attempts(c) : fhc-attempts(c) + 1, fhc-injected(c) + len(entered-ids), append(fhc-records(c), [fhc-record-of-honor(h, note)]), fhc-close-commits(c) + enters?, fhc-terminal-forwards(c), fhc-injection-refusals(c) + no-output?, fhc-frame-refusals(c), fhc-elapsed(c) + fhc-honor-elapsed(h), l2, fhc-query-tokens(c), fhc-answer-tokens(c), fhc-bytes(c), fhc-stopped?(c));
        (Comparable) enters? == 0 ?         // No observation enters: preserve the ordinary autoregressive
        // path. The completed closing id is consumed by the next stepf.
fhc-walk(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, id, pos, stops, c2, out) : {
            // The close id is output but not yet in KV: stepf predicted
            // it from the prior id. Commit it first, then place the
            // observation at the returned next position. The first id
            // decoded by observation prefill is model output too, so it
            // crosses the same bounded first-token door rather than
            // becoming a hidden resume seed.
            let committed = prefillf(ctx, [id], pos);
            let pf = prefillf(ctx, entered-ids, committed[1]);
            fhc-walk-decoded-first(ctx, stepf, prefillf, decodef, encodef, lookupf, local-ready, pf[0], pf[1], stops, c2, out);
        };
    };
    // ── the seam a carrier reads ───────────────────────────────────────────
    def fhc-out(r) = r[0];
    def fhc-cursor-of(r) = r[1];
    def fhc-pos(r) = r[2];
    def fhc-model-executed() = 0;
    0;
}
