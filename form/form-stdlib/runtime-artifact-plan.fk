// runtime-artifact-plan.fk -- Layer 9a plan face for source artifacts.
//
// This is a plan row layer, not installed runtime execution. It consumes the
// Layer 8b descriptors, asks `sad-route` for the route, and turns that route
// into observable runtime intent: primary action, fallback action, skip fields,
// deopt-anchor presence, and compile-output intent.
//
// It does not decide direct the source door admission, re-run route freshness policy,
// read or write disk, load a program-image `.fkb`, load or call a `.dylib`,
// verify seals, execute native bytes, or grow the C seed.
//
// Frequency note: `rap-` is fresh as a prefix, but it appears as a substring in
// words like `wrap-`; use `(rap-` when grepping for this layer.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk
section [form.bml] {
    def rap-feature(name, status) = ["runtime-artifact-plan-feature", name, status];
    def rap-feature-name(f) = f[1];
    def rap-feature-status(f) = f[2];
    def runtime-artifact-plan-manifest() = [rap-feature("plan-face-not-execution", 1), rap-feature("derives-from-sad-route", 1), rap-feature("routing-owned-by-sac", 1), rap-feature("skips-derived-from-sac", 1), rap-feature("invalid-investigates", 1), rap-feature("fkb-fallback-required-for-native", 1), rap-feature("deopt-anchor-observability", 1), rap-feature("no-disk-io", 1), rap-feature("no-runtime-load", 1), rap-feature("no-admission-policy", 1), rap-feature("no-c-seed-growth", 1), rap-feature("no-seal-verification", 1)];
    def runtime-artifact-plan-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rap-feature-name(head(fs)) == name && (Comparable) rap-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-plan-manifest-has?(name, tail(fs));
    def rap-act-investigate() = "investigate";
    def rap-act-compile-source() = "compile-source";
    def rap-act-run-program-image() = "run-program-image";
    def rap-act-run-native() = "run-native";
    def rap-act-none() = "none";
    def rap-no-output() = ["runtime-artifact-no-output"];
    // plan = ("runtime-artifact-plan" route primary fallback skip-parse
    //         skip-recompute deopt-anchor compile-output)
    def rap-plan(route, primary, fallback, skip-parse, skip-recompute, deopt-anchor, compile-output) = ["runtime-artifact-plan", route, primary, fallback, skip-parse, skip-recompute, deopt-anchor, compile-output];
    def rap-plan-route(p) = p[1];
    def rap-plan-primary(p) = p[2];
    def rap-plan-fallback(p) = p[3];
    def rap-plan-skip-parse(p) = p[4];
    def rap-plan-skip-recompute(p) = p[5];
    def rap-plan-deopt-anchor(p) = p[6];
    def rap-plan-compile-output(p) = p[7];
    def rap-primary-from-route(route) = (Comparable) route == sad-route-invalid() ? rap-act-investigate() : (Comparable) route == sac-run-source-compile() ? rap-act-compile-source() : (Comparable) route == sac-run-fkb() ? rap-act-run-program-image() : (Comparable) route == sac-run-dylib() ? rap-act-run-native() : rap-act-investigate();
    def rap-fallback-from-route(route) = (Comparable) route == sac-run-fkb() ? rap-act-compile-source() : (Comparable) route == sac-run-dylib() ? rap-act-run-program-image() : rap-act-none();
    def rap-output-from-route(route, dylib) = (Comparable) route == sac-run-source-compile() ? sad-compile-output-from-dylib(dylib) : rap-no-output();
    def rap-plan-from-route-state(route, state, dylib) = (Comparable) route == sad-route-invalid() ? rap-plan(route, rap-act-investigate(), rap-act-none(), 0, 0, 0, rap-no-output()) : rap-plan(route, rap-primary-from-route(route), rap-fallback-from-route(route), sac-skips-parse?(state), sac-skips-recompute?(state), sac-fkb-ready?(state), rap-output-from-route(route, dylib));
    def rap-plan-from-descriptors(source, fkb, dylib) = {
        let route = sad-route(source, fkb, dylib);
        (Comparable) route == sad-route-invalid() ? rap-plan-from-route-state(route, sac-state(0, -1, -1, 0, 0, 0, 0, 0, 0), dylib) : rap-plan-from-route-state(route, sad-derived-state(source, fkb, dylib), dylib);
    };
}
