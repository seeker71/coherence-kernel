//////////////////////////////////////////////////////////////////////
//
// perception-rows.bml — a day the body perceived, written as rows it can
// be trained on.
//
// preludes: form/form-stdlib/lora-voice.bml form/form-stdlib/str-byte-at.fk form/form-stdlib/sha256.fk form/form-stdlib/hex.fk
//
// The ear writes frames and the glass paints them and then the day is
// gone: the spool is a session's scratch, and nothing the body perceived
// reaches what the body IS. This cell is the lane between. It reads
// frames — the ear's own <|ear:frame|> blocks, key=value lines — and folds
// each into a training row in the same shape lora-voice already emits, so
// the trainer that stands reads them with no change.
//
// Three things a row must be able to say.
//
// WHERE IT CAME FROM. Every row carries its source in the question:
// which spool, which frame of how many, the frame's own epoch stamp, the
// day and hour that stamp lands on (computed here, no host date), and
// which organ wrote it. A row that cannot name its frame is not a
// perception row.
//
// WHOSE WORDS THEY ARE. The mic hears a room. It cannot tell the body's
// own mouth from the person sitting in front of it, and no field in the
// ear's frames today attests who spoke — `kind=said` is the TONGUE lane's
// word for its rendering having settled, not the body's word for having
// spoken. So the gate is a whitelist and it is closed by default: words
// travel only when the frame carries BOTH an explicit `who=` and a `src=`
// naming an organ of this body (pr-mouths). Everything else keeps its
// axes and drops its words, and says in the row that it dropped them.
// On today's spools that is every frame. That is the honest reading, not
// a shortfall: the room is Urs's, and a training set is forever.
//
// RENTED TEXT NEVER ENTERS. The same gate answers it. `src=` must be one
// of this body's own organs; a frame stamped by anything else — a rented
// model, an imported transcript — fails the whitelist even when it names
// a speaker. Nothing here reads a corpus, a model, or the network; every
// byte in every row comes from the frames or from the body's own folds.
//
// What a row therefore carries is the SHAPE of a moment: the room's level
// band, the lane's state, how many words stood and in which tongue, the
// doubt the pass reported, each stage's latency, and the moment's own
// content address — pr-shape-node, sha256 over the shape string, the same
// construction the body's meanings use for their anchors. A shape is
// addressable, so a room's recurring shapes are countable, and "how a line
// is usually said here" is answerable without one word of anyone's speech.
//
// Moments that repeat their shape fold into one row: the body keeps where
// something changed, so the row set is a model of the room and not a log
// of it. Two rows close each spool — the day's own shape, and what recurs
// in it.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormPerceptionRowsAuthority {
        field PRAuthorityPath = "form/form-stdlib/perception-rows.bml";
        field PRAuthorityKind = "high-bml-interface-class-const";
    }

    class FormPerceptionRows {
        field PRSchema = "perception-rows-v1";
        field PROpen = "<|ear:frame|>";
        field PRClose = "<|/ear:frame|>";
        field PRWhoKey = "who";
        field PRSrcKey = "src";
        field PRSpool = ".hearth/ear.spool";
        field PROut = "perception.jsonl";
        // the newest slice of a spool a fold walks; a day at the ear's own
        // cadence is far more frames than one recursion should carry
        field PRTailBytes = 400000;
        field PRTopShapes = 5;
        // the shortest line worth asking the rows about
        field PRLeakMin = 12;
        // How many of a spool's lines the door offers to the rows. str_find is
        // a recipe, not a native, so one line against a megabyte of rows is a
        // walk in interpreted Form and seven hundred of them do not finish.
        // The number is therefore small on purpose and the door SAYS how many
        // it checked: a spot check named as one is honest, a spot check
        // reported as a guarantee is not. The whole guarantee is structural
        // and sits beside it — words reach a row only through pr-words-say,
        // which only an attested frame opens, so attested=0 IS the proof, and
        // this scan is what looks anyway.
        field PRGateLines = 20;
        ref pr-authority = FormPerceptionRowsAuthority;
        thought pr-law = list("a-row-names-its-frame", "words-need-an-attested-mouth", "axes-survive-a-dropped-line", "only-this-body-writes-rows", "shape-is-addressable", "change-is-kept-repetition-folds");

        def pr-cat(parts) = lv-cat(parts);
        def pr-text(t) = if nothing?(t) then "" else t;
        def pr-or-of(v, d) = if eq(str_len(v), 0) then d else v;

        // ── frames: one block is key=value lines ───────────────────────────
        def pr-line-end(s, i) = if ge(i, str_len(s)) then i else if eq(str_byte_at(s, i), 10) then i else pr-line-end(s, add(i, 1));
        def pr-key-at(f, key) = str_find(f, str_concat(byte_to_str(10), str_concat(key, "=")), 0);
        def pr-field(f, key) = pr-field-at(f, pr-key-at(f, key), add(str_len(key), 2));
        def pr-field-at(f, at, skip) = if lt(at, 0) then "" else substring(f, add(at, skip), pr-line-end(f, add(at, skip)));
        def pr-field-or(f, key, dflt) = pr-or-of(pr-field(f, key), dflt);
        def pr-has?(f, key) = if lt(pr-key-at(f, key), 0) then 0 else 1;
        def pr-int-of(v) = if eq(str_len(v), 0) then 0 else str_to_int(v);
        def pr-int(f, key) = pr-int-of(pr-field(f, key));
        def pr-tail(text) = if le(str_len(text), PRTailBytes()) then text else pr-tail-cut(text, substring(text, sub(str_len(text), PRTailBytes()), str_len(text)));
        def pr-tail-cut(text, slice) = pr-tail-from(slice, str_find(slice, PROpen(), 0));
        def pr-tail-from(slice, at) = if lt(at, 0) then "" else substring(slice, at, str_len(slice));
        def pr-frames-go(text, from, acc) = pr-frames-at(text, acc, str_find(text, PROpen(), from));
        def pr-frames-at(text, acc, o) = if lt(o, 0) then reverse(acc) else pr-frames-cut(text, acc, o, str_find(text, PRClose(), o));
        def pr-frames-cut(text, acc, o, c) = if lt(c, 0) then reverse(acc) else pr-frames-go(text, add(c, str_len(PRClose())), cons(substring(text, o, add(c, str_len(PRClose()))), acc));
        def pr-frames(text) = pr-frames-go(pr-tail(text), 0, list());

        // ── the line, and how many words stood in it ───────────────────────
        def pr-line(f) = pr-line-of(pr-field(f, "heard"), pr-field(f, "live"));
        def pr-line-of(heard, live) = if gt(str_len(heard), 0) then heard else live;
        def pr-tongue(f) = pr-or-of(pr-field(f, "lang"), pr-or-of(pr-field(f, "livelang"), "no-tongue"));
        def pr-word-byte?(b) = if and(ge(b, 97), le(b, 122)) then 1 else if and(ge(b, 65), le(b, 90)) then 1 else if and(ge(b, 48), le(b, 57)) then 1 else if ge(b, 128) then 1 else 0;
        def pr-count-go(s, i, inw, n) = if ge(i, str_len(s)) then add(n, inw) else pr-count-at(s, i, inw, n, pr-word-byte?(str_byte_at(s, i)));
        def pr-count-at(s, i, inw, n, w) = if eq(w, 1) then pr-count-go(s, add(i, 1), 1, n) else pr-count-go(s, add(i, 1), 0, add(n, inw));
        def pr-words(line) = pr-count-go(line, 0, 0, 0);

        // ── the bands a moment falls in ────────────────────────────────────
        def pr-db-band(f) = if eq(pr-has?(f, "db"), 0) then "no-level" else pr-db-band-of(pr-int(f, "db"));
        def pr-db-band-of(db) = if le(db, -100) then "silent" else if le(db, -55) then "under-the-line" else if le(db, -40) then "quiet" else if le(db, -25) then "speaking" else "loud";
        def pr-len-band(n) = if eq(n, 0) then "no-line" else if le(n, 3) then "short" else if le(n, 9) then "phrase" else if le(n, 20) then "sentence" else "passage";
        def pr-state-say(kind) = if str_eq(kind, "born") then "just opened" else if str_eq(kind, "done") then "ended" else if str_eq(kind, "quiet") then "under the speech floor" else if str_eq(kind, "live") then "holding a line that is still growing" else if str_eq(kind, "heard") then "holding a line that closed" else if str_eq(kind, "saying") then "rendering the line into its tongues" else if str_eq(kind, "said") then "settled on its rendering" else kind;

        // ── the moment's own address: the same construction a meaning uses ──
        def pr-shape(f) = pr-cat(list(pr-field-or(f, "kind", "no-kind"), "|", pr-tongue(f), "|", pr-len-band(pr-words(pr-line(f))), "|", pr-db-band(f)));
        def pr-node(text) = substring(hex-encode(sha256(sbt-bytes-of(text, 0, str_len(text), list()))), 0, 8);
        def pr-shape-node(f) = pr-node(pr-shape(f));

        // ── which organ wrote this frame ───────────────────────────────────
        def pr-organ(f) = pr-or-of(pr-field(f, PRSrcKey()), pr-organ-of(f));
        def pr-organ-of(f) = if eq(pr-has?(f, "tongues"), 1) then "ear-tongue" else if eq(pr-has?(f, "ntok"), 1) then "ear-live" else if eq(pr-has?(f, "db"), 1) then "ear-live" else "unknown";

        // ── the gate on words: closed unless this body's own mouth attests ──
        def pr-mouths() = list("voice-say", "mouth", "fixture");
        def pr-member?(xs, x) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), x) then 1 else pr-member?(tail(xs), x);
        def pr-attested?(f) = pr-attested-of(pr-field(f, PRWhoKey()), pr-field(f, PRSrcKey()), pr-line(f));
        def pr-attested-of(who, src, line) = if eq(str_len(line), 0) then 0 else if eq(str_len(who), 0) then 0 else pr-member?(pr-mouths(), src);

        // ── the day and hour a stamp lands on, folded here, no host date ────
        def pr-civil(days) {
            let z = add(days, 719468);
            let era = div(z, 146097);
            let doe = sub(z, mul(era, 146097));
            let yoe = div(sub(add(sub(doe, div(doe, 1460)), div(doe, 36524)), div(doe, 146096)), 365);
            let doy = sub(doe, sub(add(mul(365, yoe), div(yoe, 4)), div(yoe, 100)));
            let mp = div(add(mul(5, doy), 2), 153);
            let dd = add(sub(doy, div(add(mul(153, mp), 2), 5)), 1);
            let mm = if lt(mp, 10) then add(mp, 3) else sub(mp, 9);
            list(add(add(yoe, mul(era, 400)), if le(mm, 2) then 1 else 0), mm, dd);
        }
        def pr-pad2(n) = if lt(n, 10) then str_concat("0", int_to_str(n)) else int_to_str(n);
        def pr-day-text(ms) = pr-day-of(pr-civil(div(ms, 86400000)));
        def pr-day-of(c) = pr-cat(list(int_to_str(head(c)), "-", pr-pad2(nth(c, 1)), "-", pr-pad2(nth(c, 2))));
        def pr-hour(ms) = div(mod(div(ms, 1000), 86400), 3600);
        def pr-when(ms) = if le(ms, 0) then "no stamp" else pr-cat(list(pr-day-text(ms), " ", pr-pad2(pr-hour(ms)), "h UTC"));

        // ── where a row came from: the sentence every row carries ──────────
        def pr-source(spool, i, n, f) = pr-cat(list("source ", spool, ", frame ", int_to_str(i), " of ", int_to_str(n), ", t=", pr-field-or(f, "t", "absent"), ", ", pr-when(pr-int(f, "t")), ", organ ", pr-organ(f)));

        // ── the axes, said in the body's own words ─────────────────────────
        def pr-db-say(f) = if eq(pr-has?(f, "db"), 0) then "no level" else pr-cat(list(pr-field(f, "db"), " dBFS, ", pr-db-band(f)));
        def pr-line-say(f) = pr-line-say-of(f, pr-words(pr-line(f)));
        def pr-line-say-of(f, n) = if eq(n, 0) then "No line stands." else pr-cat(list("A line of ", int_to_str(n), " words stands in ", pr-tongue(f), ", ", pr-len-band(n), ", doubt ", pr-field-or(f, "nsp", "absent"), "."));
        def pr-lat-say(f) = pr-cat(list(pr-lat-one(f, "heardms", "heard in"), pr-lat-one(f, "livems", "the live pass in"), pr-lat-one(f, "encms", "encode in"), pr-lat-one(f, "decms", "decode in"), pr-lat-one(f, "saidms", "the rendering behind by"), pr-tok-say(f)));
        def pr-lat-one(f, key, say) = if eq(pr-has?(f, key), 0) then "" else if le(pr-int(f, key), 0) then "" else pr-cat(list(" It was ", say, " ", pr-field(f, key), " ms."));
        def pr-tok-say(f) = if eq(pr-has?(f, "ntok"), 0) then "" else pr-cat(list(" The pass ran ", pr-field(f, "ntok"), " tokens."));
        def pr-tongues-say(f) = if eq(pr-has?(f, "tongues"), 0) then "" else pr-cat(list(" The tongue lane holds it in ", pr-field(f, "tongues"), "."));
        def pr-axes-say(f) = pr-cat(list("The room reads ", pr-db-say(f), " and the lane is ", pr-state-say(pr-field-or(f, "kind", "no-kind")), ". ", pr-line-say(f), pr-lat-say(f), pr-tongues-say(f), " Its shape is ", pr-shape(f), ", node ", pr-shape-node(f), "."));
        def pr-words-say(f) = if eq(pr-attested?(f), 1) then pr-cat(list(" ", pr-field(f, PRWhoKey()), " said it: ", pr-line(f))) else pr-drop-say(f);
        def pr-drop-say(f) = if eq(str_len(pr-line(f)), 0) then "" else " Its words are not carried: no frame in this room attests who spoke, so the shape stands and the speech stays where it was said.";

        // ── one moment, one row ────────────────────────────────────────────
        def pr-ask(f) = if eq(pr-attested?(f), 1) then "what did the body perceive, and what was said?" else "what did the body perceive?";
        def pr-moment-row(spool, i, n, f) = lv-row(pr-cat(list(pr-source(spool, i, n, f), " — ", pr-ask(f))), pr-cat(list(pr-axes-say(f), pr-words-say(f))));

        // ── the day's own shape: one fold, no words ────────────────────────
        // acc = (n first last dbmin dbmax heard attested words)
        def pr-fold(frames, a) = if eq(len(frames), 0) then a else pr-fold(tail(frames), pr-fold-one(head(frames), a));
        def pr-fold-one(f, a) = pr-fold-at(f, a, pr-int(f, "t"), pr-words(pr-line(f)));
        def pr-fold-at(f, a, t, w) = list(
            add(head(a), 1),
            if or(eq(head(a), 0), lt(t, nth(a, 1))) then t else nth(a, 1),
            if gt(t, nth(a, 2)) then t else nth(a, 2),
            if and(eq(pr-has?(f, "db"), 1), or(eq(head(a), 0), lt(pr-int(f, "db"), nth(a, 3)))) then pr-int(f, "db") else nth(a, 3),
            if and(eq(pr-has?(f, "db"), 1), gt(pr-int(f, "db"), nth(a, 4))) then pr-int(f, "db") else nth(a, 4),
            add(nth(a, 5), if str_eq(pr-field(f, "kind"), "heard") then 1 else 0),
            add(nth(a, 6), pr-attested?(f)),
            add(nth(a, 7), w));
        def pr-fold-zero() = list(0, 0, 0, 0, -9999, 0, 0, 0);
        def pr-day(frames) = pr-fold(frames, pr-fold-zero());
        def pr-span-say(a) = if le(nth(a, 1), 0) then "no stamps" else pr-cat(list("from ", pr-when(nth(a, 1)), " to ", pr-when(nth(a, 2)), ", ", int_to_str(div(sub(nth(a, 2), nth(a, 1)), 1000)), " seconds of room"));
        def pr-day-row(spool, frames) = pr-day-row-of(spool, frames, pr-day(frames));
        // the day's answer on its own: the body's own sentence about its own
        // room, so a lane that wants to ASK the body about that room can put
        // the body's own words in the question rather than fresh prose
        def pr-day-said(frames) = pr-day-said-of(pr-day(frames));
        def pr-day-said-of(a) = pr-cat(list("The room stood ", pr-span-say(a), ". ", int_to_str(head(a)), " frames: ", int_to_str(nth(a, 5)), " lines closed, ", int_to_str(nth(a, 7)), " words heard across them, ", int_to_str(nth(a, 6)), " of them attested. Its floor was ", int_to_str(nth(a, 3)), " dBFS and its loudest reading ", int_to_str(nth(a, 4)), " dBFS. ", pr-carry-say(nth(a, 6), head(a))));
        def pr-day-row-of(spool, frames, a) = lv-row(
            pr-cat(list("source ", spool, ", the whole spool, ", int_to_str(head(a)), " frames — what is the shape of this room?")),
            pr-day-said-of(a));
        def pr-carry-say(att, n) = if eq(att, 0) then "No words are carried out of this room: not one frame attests who spoke." else pr-cat(list(int_to_str(att), " of ", int_to_str(n), " frames name their mouth; the rest keep their shape and leave their words."));

        // ── what recurs: shapes counted, addressed, never words ────────────
        def pr-bump(rows, shape, node) = if eq(len(rows), 0) then list(list(shape, node, 1)) else pr-bump-at(rows, shape, node, head(rows));
        def pr-bump-at(rows, shape, node, r) = if str_eq(head(r), shape) then cons(list(head(r), nth(r, 1), add(nth(r, 2), 1)), tail(rows)) else cons(r, pr-bump(tail(rows), shape, node));
        def pr-shapes-go(frames, rows) = if eq(len(frames), 0) then rows else pr-shapes-go(tail(frames), pr-bump(rows, pr-shape(head(frames)), pr-shape-node(head(frames))));
        def pr-shapes(frames) = pr-shapes-go(frames, list());
        // the count travels beside the row: `or` weighs both arms, so an
        // empty best must never be asked for its third field
        def pr-best(rows, best, bc) = if eq(len(rows), 0) then best else pr-best-at(tail(rows), best, bc, head(rows));
        def pr-best-at(rest, best, bc, r) = if gt(nth(r, 2), bc) then pr-best(rest, r, nth(r, 2)) else pr-best(rest, best, bc);
        def pr-drop(rows, r) = if eq(len(rows), 0) then list() else if str_eq(head(head(rows)), head(r)) then tail(rows) else cons(head(rows), pr-drop(tail(rows), r));
        def pr-top(rows, k) = if or(le(k, 0), eq(len(rows), 0)) then list() else pr-top-at(rows, k, pr-best(rows, list(), -1));
        def pr-top-at(rows, k, b) = cons(b, pr-top(pr-drop(rows, b), sub(k, 1)));
        def pr-top-say(tops, n) = if eq(len(tops), 0) then "" else pr-cat(list(" ", head(head(tops)), " — node ", nth(head(tops), 1), " — stood ", int_to_str(nth(head(tops), 2)), " of ", int_to_str(n), " frames.", pr-top-say(tail(tops), n)));
        // what recurs, said on its own, as many shapes as the caller has room
        // for — the same sentence the recur row carries, cut to k
        def pr-recur-said-k(frames, k) = pr-recur-said-of(pr-shapes(frames), len(frames), k);
        def pr-recur-said-of(rows, n, k) = pr-cat(list("Across ", int_to_str(n), " frames the room took ", int_to_str(len(rows)), " distinct shapes, a shape holding the lane state, the tongue, how long the line ran and where the level sat.", pr-top-say(pr-top(rows, k), n)));
        def pr-recur-row(spool, frames) = pr-recur-row-of(spool, frames, pr-shapes(frames), len(frames));
        def pr-recur-row-of(spool, frames, rows, n) = lv-row(
            pr-cat(list("source ", spool, ", the whole spool, ", int_to_str(n), " frames — how is a line usually said in this room?")),
            pr-cat(list("Across ", int_to_str(n), " frames the room took ", int_to_str(len(rows)), " distinct shapes, a shape holding the lane's state, the tongue, how long the line ran and where the level sat.", pr-top-say(pr-top(rows, PRTopShapes()), n), " Each shape is addressed by the content of its own name, so a room can be recognised again without keeping one word of what was said in it.")));

        // ── change is kept, repetition folds ───────────────────────────────
        def pr-keep?(f, prev) = if eq(pr-attested?(f), 1) then 1 else if str_eq(pr-shape(f), prev) then 0 else 1;

        // ── the gate, checked against what it actually wrote ───────────────
        // A closed gate is a claim until something looks. This takes every
        // line the spool carries and asks the emitted rows whether it is in
        // there. It answers a number, and the band gives it a line that IS
        // present so a checker that can only say zero is caught.
        def pr-lines-go(frames, prev, acc) = if eq(len(frames), 0) then acc else pr-lines-at(tail(frames), prev, acc, pr-line(head(frames)));
        def pr-lines-at(rest, prev, acc, line) = if lt(str_len(line), PRLeakMin()) then pr-lines-go(rest, prev, acc) else if str_eq(line, prev) then pr-lines-go(rest, prev, acc) else pr-lines-go(rest, line, cons(line, acc));
        def pr-lines(frames) = pr-lines-go(frames, "", list());
        def pr-leaks-go(rowtext, lines, n) = if eq(len(lines), 0) then n else pr-leaks-go(rowtext, tail(lines), add(n, if lt(str_find(rowtext, head(lines), 0), 0) then 0 else 1));
        def pr-leaks(rowtext, frames) = pr-leaks-go(rowtext, pr-lines(frames), 0);
        def pr-cap(xs, n) = if or(le(n, 0), eq(len(xs), 0)) then list() else cons(head(xs), pr-cap(tail(xs), sub(n, 1)));
        // (checked found) — how many lines were offered, and how many landed
        def pr-gate(rowtext, frames) = pr-gate-of(rowtext, pr-cap(pr-lines(frames), PRGateLines()));
        def pr-gate-of(rowtext, lines) = list(len(lines), pr-leaks-go(rowtext, lines, 0));
    }
    0;
}

section [form.bml] {
    class FormPerceptionRowsEmit {
        // effectful: the pure folds above are what a band reads
        def pr-out-path(data) = str_concat(data, str_concat("/", PROut()));
        def pr-moments-go(path, spool, all, frames, i, n, prev, kept) {
            if eq(len(frames), 0) then kept
            else pr-moments-at(path, spool, all, frames, i, n, prev, kept, pr-keep?(head(frames), prev));
        }
        def pr-moments-at(path, spool, all, frames, i, n, prev, kept, keep) {
            if eq(keep, 0) then pr-moments-go(path, spool, all, tail(frames), add(i, 1), n, prev, kept)
            else pr-moments-next(path, spool, all, tail(frames), add(i, 1), n, pr-shape(head(frames)), add(kept, 1), sbt-append(path, pr-moment-row(spool, i, n, head(frames))));
        }
        def pr-moments-next(path, spool, all, frames, i, n, prev, kept, wrote) = pr-moments-go(path, spool, all, frames, i, n, prev, kept);
        // (frames kept attested shapes)
        def pr-emit(spool, data) = pr-emit-of(spool, data, pr-frames(pr-text(read_file(spool))));
        def pr-emit-of(spool, data, frames) {
            let made = fs-mkdir(data);
            let path = pr-out-path(data);
            let cleared = fs-remove-file(path);
            let kept = pr-moments-go(path, spool, frames, frames, 1, len(frames), "", 0);
            let d = sbt-append(path, pr-day-row(spool, frames));
            let r = sbt-append(path, pr-recur-row(spool, frames));
            list(len(frames), kept, nth(pr-day(frames), 6), len(pr-shapes(frames)));
        }
        // every spool a hand has left in the tree, folded into one row file
        def pr-append-of(spool, data, frames) {
            let path = pr-out-path(data);
            let kept = pr-moments-go(path, spool, frames, frames, 1, len(frames), "", 0);
            let d = sbt-append(path, pr-day-row(spool, frames));
            let r = sbt-append(path, pr-recur-row(spool, frames));
            list(len(frames), kept, nth(pr-day(frames), 6), len(pr-shapes(frames)));
        }
        def pr-append(spool, data) = pr-append-of(spool, data, pr-frames(pr-text(read_file(spool))));
        // one spool's lines, asked of the rows that were actually written
        def pr-leak-scan(spool, rowtext) = pr-gate(rowtext, pr-frames(pr-text(read_file(spool))));
        def pr-rows-text(data) = pr-text(read_file(pr-out-path(data)));
        // a school of its own: perception is a few percent of the shared lane,
        // and a few percent cannot be read in an answer. Split the rows alone,
        // ten to one, into a folder the same trainer reads, so what the room
        // taught can be heard against the model that never sat in it.
        def pr-school-go(out, lines, i) = if eq(len(lines), 0) then i else if lt(str_len(head(lines)), 20) then pr-school-go(out, tail(lines), i) else pr-school-next(out, tail(lines), add(i, 1), lv-put(out, i, str_concat(head(lines), byte_to_str(10))));
        def pr-school-next(out, lines, i, wrote) = pr-school-go(out, lines, i);
        def pr-school(data, out) {
            let made = fs-mkdir(out);
            let c1 = fs-remove-file(str_concat(out, "/train.jsonl"));
            let c2 = fs-remove-file(str_concat(out, "/valid.jsonl"));
            sub(pr-school-go(out, split-on(pr-rows-text(data), byte_to_str(10)), 1), 1);
        }
    }
    0;
}
