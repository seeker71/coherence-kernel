
(do (defn SoftmaxSum () "m1x3 1 2 3 softmax sum") (defn SoftmaxScale () "m1x3 1 2 3 softmax 1000 mul sum") (defn AttnSharp () "m1x2 40 0 m2x2 1 0 0 1 matmul softmax m2x1 100 0 matmul") (defn AttnUniform () "m1x2 0 0 m2x2 1 0 0 1 matmul softmax m2x1 10 30 matmul") (defn Add () "2 3 add") (defn JitArg () 2) (defn JitLit () 3) (defn JitRoot () 2) (defn fcg-pattern () (list "softmax" "matmul" "attention")) (defn fcg-softmax-sum () (SoftmaxSum)) (defn fcg-softmax-scale () (SoftmaxScale)) (defn fcg-attn-sharp () (AttnSharp)) (defn fcg-attn-uniform () (AttnUniform)) (defn fcg-add () (Add)) (defn fcg-check () (do (let b0 (if (str_eq (fcg-softmax-sum) "m1x3 1 2 3 softmax sum") 1 0)) (let b1 (if (str_eq (fcg-softmax-scale) "m1x3 1 2 3 softmax 1000 mul sum") 2 0)) (let b2 (if (str_eq (fcg-attn-sharp) "m1x2 40 0 m2x2 1 0 0 1 matmul softmax m2x1 100 0 matmul") 4 0)) (let b3 (if (str_eq (fcg-attn-uniform) "m1x2 0 0 m2x2 1 0 0 1 matmul softmax m2x1 10 30 matmul") 8 0)) (let b4 (if (str_eq (fcg-add) "2 3 add") 16 0)) (let b5 (if (eq (JitArg) 2) (if (eq (JitLit) 3) 32 0) 0)) (add b0 (add b1 (add b2 (add b3 (add b4 b5))))))) (defn FormCliGpu () (list "abstraction" "FormCliGpu" (list "T") (list "fcg-softmax-sum" "fcg-softmax-scale" "fcg-attn-sharp" "fcg-attn-uniform" "fcg-add" "fcg-check") (list "SoftmaxSum" "SoftmaxScale" "AttnSharp" "AttnUniform" "Add" "JitArg" "JitLit" "JitRoot") (list) (list "fcg-pattern"))) 0)
