
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-lane-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormLaneMintAuthority () (list "abstraction" "FormLaneMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 41)
(defn NLanes () 9)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fln-authority () FormLaneMintAuthority)
(defn fln-pattern () (list "cartesian" "inquiry-plane" "knowledge-query" "form-cli-walk"))
(defn fln-lanes () (list "when" "where" "which" "what" "who" "how" "why" "knowledge-query" "walk"))
(defn fln-computable () (list "when" "where" "which"))
(defn fln-skills () (list "bml" "bmf" "lift-sexp" "node-lookup" "craft-cell" "framebuffer" "micro-thought" "evaluate" "channel" "protocol" "axiom" "satsang" "nothing" "timeout" "trust" "choice-undo" "embodied-memory" "assemblage" "human-design" "gene-keys" "astrology" "physics" "chemistry" "biology" "quantum" "math" "logic" "shape-match" "time-direction" "phase" "frequency" "vitality" "consent" "four-way" "collapse" "jit" "iching" "codon" "ifs" "organic" "rag-heed"))
(defn fln-sources () (list "presence/inquiry-planes.fk" "form/form-stdlib/form-cli-qwen-teach-layer.fk" "form/form-stdlib/form-cli-universe-mint.bml" "form/form-stdlib/form-cli-unique-mint.bml" "form/form-stdlib/form-cli-domain-mint.bml" "form/form-stdlib/form-cli-organ-mint.bml"))
(defn fln-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fln-gloss-of (pairs skill) (if (eq (len pairs) 0) skill (if (str_eq (nth (head pairs) 0) skill) (nth (head pairs) 1) (fln-gloss-of (tail pairs) skill))))
(defn fln-glosses () (list (list "bml" "BML executable source authority") (list "bmf" "scannerless BMF byte-fold no tokenizer") (list "lift-sexp" "form.lift s-expression to infix thought") (list "node-lookup" "knowledge-query envelope anchor then path") (list "craft-cell" "NodeID Blueprint Recipe Cell intern") (list "framebuffer" "execute observe control re-observe") (list "micro-thought" "thought kernel inquiry plane abstain") (list "evaluate" "walker recipe typed observation release") (list "channel" "CHANNEL-V0 honor interface never invade") (list "protocol" "run and speak are one offer") (list "axiom" "five axioms then theorems") (list "satsang" "circle witnesses dissent stays visible") (list "nothing" "first-class silence not a missing zero") (list "timeout" "budget ended alternatives untried") (list "trust" "receipts before trust judged not credulity") (list "choice-undo" "choice and undo are native primitives") (list "embodied-memory" "checkpoint value not a reasoning chain") (list "assemblage" "switch frame by aliveness not success") (list "human-design" "rave mandala date becomes a gate") (list "gene-keys" "shadow gift siddhi hologenetic profile") (list "astrology" "one sky two astrologies ayanamsa") (list "physics" "force energy wave field from the 64") (list "chemistry" "bond is hold as one whole depth three") (list "biology" "life grow sense a living cell") (list "quantum" "observer-effect named as a borrow") (list "math" "number set function proof") (list "logic" "backward-chaining goal forward axioms") (list "shape-match" "nearest-shape agreeing bins no float") (list "time-direction" "Julian Day north star moves") (list "phase" "ice water gas orthogonal to substance") (list "frequency" "fear-love spectrum from text") (list "vitality" "weakest life-good first extraction loses") (list "consent" "exposure rests closed carrier reads Form") (list "four-way" "Go Rust TypeScript fkwu no trusted prover") (list "collapse" "same Blueprint one cell link restatements") (list "jit" "hot and pure crystallizes hysteresis") (list "iching" "three tongues one cell two different 64s") (list "codon" "amino-acid rings not a faked codon table") (list "ifs" "Self protectors exiles eight C faces") (list "organic" "pattern adapt body feel flow rhythm") (list "rag-heed" "grounded NodeID envelope then prefill")))
(defn fln-gloss (skill) (fln-gloss-of (fln-glosses) skill))
(defn fln-ask (lane gloss) (if (str_eq lane "when") (str_concat "When is this computable: " gloss) (if (str_eq lane "where") (str_concat "Where is the NodeID for: " gloss) (if (str_eq lane "which") (str_concat "Which cell answers: " gloss) (if (str_eq lane "what") (str_concat "What is: " gloss) (if (str_eq lane "who") (str_concat "Who offers: " gloss) (if (str_eq lane "how") (str_concat "How does the body: " gloss) (if (str_eq lane "why") (str_concat "Why does Form: " gloss) (if (str_eq lane "knowledge-query") (str_concat "Emit knowledge-query envelope ANCHOR PATH for: " gloss) (str_concat "Walk native then local then remote for: " gloss))))))))))
(defn fln-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fln-situation (skill lane i split) (str_concat (fln-prefix split) (str_concat (fln-ask lane (fln-gloss skill)) (str_concat " case " (int_to_str i)))))
(defn fln-row (skill lane i split) (list split lane (fln-situation skill lane i split)))
(defn fln-i-rows (skill lane i n split acc) (if (eq i n) acc (fln-i-rows skill lane (add i 1) n split (cons (fln-row skill lane i split) acc))))
(defn fln-lane-rows (skill lanes n split acc) (if (eq (len lanes) 0) acc (fln-lane-rows skill (tail lanes) n split (fln-i-rows skill (head lanes) 0 n split acc))))
(defn fln-skill-rows (skills tn hn acc) (if (eq (len skills) 0) acc (fln-skill-rows (tail skills) tn hn (fln-lane-rows (head skills) (fln-lanes) hn (SplitHeldout) (fln-lane-rows (head skills) (fln-lanes) tn (SplitTrain) acc)))))
(defn fln-corpus (tn hn) (fln-skill-rows (fln-skills) tn hn (tail (list "x"))))
(defn fln-n (tn hn) (mul (len (fln-skills)) (mul (len (fln-lanes)) (add tn hn))))
(defn fln-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fln-has-situation (tail rows) s))))
(defn fln-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fln-train-only (tail rows) (cons (head rows) acc)) (fln-train-only (tail rows) acc))))
(defn fln-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fln-has-situation (fln-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fln-leakage-loop all (tail rows)))))
(defn fln-leakage (rows) (fln-leakage-loop rows rows))
(defn fln-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fln-has-situation seen (nth (head rows) 2)) 1) (fln-unique-loop (tail rows) seen) (fln-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fln-unique (rows) (fln-unique-loop rows (tail (list "x"))))
(defn fln-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fln-count-split (tail rows) split))))
(defn fln-lora-writer () (LoraWriter))
(defn fln-mix-diverse () (if (eq (fln-mix 0 9) (fln-mix 1 9)) 0 1))
(defn fln-pair-hit (rows skill lane) (fln-has-situation rows (fln-situation skill lane 0 (SplitTrain))))
(defn fln-lane-cover (rows skill lanes) (if (eq (len lanes) 0) 1 (if (eq (fln-pair-hit rows skill (head lanes)) 0) 0 (fln-lane-cover rows skill (tail lanes)))))
(defn fln-skill-cover (rows skills) (if (eq (len skills) 0) 1 (if (eq (fln-lane-cover rows (head skills) (fln-lanes)) 0) 0 (fln-skill-cover rows (tail skills)))))
(defn fln-covers-all (rows) (fln-skill-cover rows (fln-skills)))
(defn fln-computable? (lane) (if (str_eq lane "when") 1 (if (str_eq lane "where") 1 (if (str_eq lane "which") 1 0))))
(defn fln-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fln-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fln-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fln-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fln-heldout-hit models names (head rows)) (fln-heldout-correct-loop models names (tail rows)))))
(defn fln-heldout-correct (rows) (do (let names (fln-lanes)) (let models (fqt-fit rows names)) (fln-heldout-correct-loop models names rows)))
(defn fln-bit (ok bit) (if ok bit 0))
(defn fln-check () (do (let rows (fln-corpus 1 1)) (let n (fln-n 1 1)) (let correct (fln-heldout-correct rows)) (let c0 (fln-bit (eq n 738) 1)) (let c1 (fln-bit (eq (fln-mix-diverse) 1) 2)) (let c2 (fln-bit (eq (fln-leakage rows) 0) 4)) (let c3 (fln-bit (eq (fln-unique rows) n) 8)) (let c4 (fln-bit (and (eq (fln-count-split rows (SplitTrain)) 369) (eq (fln-count-split rows (SplitHeldout)) 369)) 16)) (let c5 (fln-bit (ge correct 328) 32)) (let c6 (fln-bit (eq (fln-lora-writer) 0) 64)) (let c7 (fln-bit (and (eq (fln-covers-all rows) 1) (and (eq (fln-computable? "when") 1) (eq (fln-computable? "why") 0))) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormLaneMint () (list "abstraction" "FormLaneMint" (list "T") (list "fln-mix" "fln-gloss-of" "fln-glosses" "fln-gloss" "fln-ask" "fln-prefix" "fln-situation" "fln-row" "fln-i-rows" "fln-lane-rows" "fln-skill-rows" "fln-corpus" "fln-n" "fln-has-situation" "fln-train-only" "fln-leakage-loop" "fln-leakage" "fln-unique-loop" "fln-unique" "fln-count-split" "fln-lora-writer" "fln-mix-diverse" "fln-pair-hit" "fln-lane-cover" "fln-skill-cover" "fln-covers-all" "fln-computable?" "fln-predict" "fln-heldout-hit" "fln-heldout-correct-loop" "fln-heldout-correct" "fln-bit" "fln-check") (list "MixA" "MixB" "NSkills" "NLanes" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fln-authority") (list "fln-pattern" "fln-lanes" "fln-computable" "fln-skills" "fln-sources")))
