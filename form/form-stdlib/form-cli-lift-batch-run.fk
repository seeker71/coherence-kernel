; form-cli-lift-batch-run.fk — print the 95% climb floor.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-lift-batch.bml

(do
    (print "form-cli executed lift-batch\n")
    (print "form-cli authored=")
    (print (int_to_str (flb-authored)))
    (print " high-before=")
    (print (int_to_str (flb-high-before)))
    (print " this-batch=")
    (print (int_to_str (flb-this-batch)))
    (print " high-after=")
    (print (int_to_str (flb-high-after)))
    (print " need=")
    (print (int_to_str (flb-need)))
    (print " target=")
    (print (int_to_str (flb-target-pct)))
    (print " next=")
    (print (head (flb-next)))
    (print " check=")
    (print (int_to_str (flb-check)))
    (print "\n")
    0)
