// kernel-core-self.fk - compiler-backed minimal kernel core image
//
// The BML source remains the authority. This file is a small Form compiler
// surface that parses the source, reads executable count methods from the
// source model, and emits the KERNEL-CORE-IMAGE as a compiler-object value.
//
// Proven by: form-stdlib/tests/kernel-core-self-proof.fk (verdict 43) and
//           form-stdlib/tests/kernel-core-image-compiler-proof.fk (verdict 33),
//           each on fkwu, Go, Rust and TS: the source scan, the node
//           projections and the .fkb image pair run on every arm, and the
//           kernel's primitives are read from fkwu's own native manifest.
// Witnesses: the compiler observes the witness recipes it embeds and voices
//           a missing one through organ-health.bml; nothing walks a witness.
//
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
    def kernel-core-source-path(_x) = "form-stdlib/bml/kernel-core.bml";
    def kernel-core-default-image-path(_x) = "/tmp/kernel-core-self-image.fkb";
    def kernel-core-self-class(model) = bml-model-find-class(model, "KernelCoreSelf");
    def kernel-core-source-method(class-component, method-name) = bml-find-method(bml-class-own-methods(class-component), method-name);
    def kernel-core-source-method-value(class-component, method-name) = {
        let tokens = bml-body-source-values(bml-method-body(kernel-core-source-method(class-component, method-name)));
        str_to_int(nth(tokens, 1));
    };
    def kernel-core-witness-plus(_x) = intern_node(bp("add"), list(intern_trivial_int(2), intern_trivial_int(3)));
    def kernel-core-witness-condition(_x) = intern_node(bp("gt"), list(intern_trivial_int(5), intern_trivial_int(3)));
    def kernel-core-witness-if(_x) = intern_node(bp("if"), list(kernel-core-witness-condition(0), intern_trivial_int(8), intern_trivial_int(13)));
    def kernel-core-witness-do(_x) = intern_node(bp("do"), list(intern_trivial_int(1), kernel-core-witness-plus(0), intern_node(bp("mul"), list(kernel-core-witness-plus(0), intern_trivial_int(4)))));
    //; The compiler observes the witnesses it emitted: each witness slot of
    //; an image holds the recipe its constructor builds (one content address),
    //; and the do witness holds the plus witness as one node. A miss is named.
    def kernel-core-witness-misses(image) = {
        let kids = node_children(image);
        append(node_eq(nth(kids, 6), kernel-core-witness-plus(0)) ? empty() : list("plus"), append(node_eq(nth(kids, 7), kernel-core-witness-if(0)) ? empty() : list("if"), node_eq(nth(kids, 8), kernel-core-witness-do(0)) && node_eq(nth(node_children(nth(kids, 8)), 1), nth(kids, 6)) ? empty() : list("do")));
    };
    def kernel-core-join(names) = (Comparable) len(names) == 0 ? "" : (Comparable) len(tail(names)) == 0 ? head(names) : str_concat(head(names), str_concat(",", kernel-core-join(tail(names))));
    //; A whole image passes through silent. An image missing a witness speaks
    //; one organ-health reading that names it, and is handed on unchanged.
    def kernel-core-witness-health(image) = kernel-core-witness-heard(image, kernel-core-witness-misses(image));
    def kernel-core-witness-heard(image, misses) = (Comparable) len(misses) == 0 ? image : {
        oh-voice(oh-reading("kernel-core-image-compiler", int_to_str(host_pid()), "witness", json-node-string("observed"), json-node-string(str_concat("missing:", kernel-core-join(misses))), json-node-int(0), list(oh-need("witness-recipe", json-node-string(kernel-core-join(misses)))), list("request-evidence", "revise"), json-node-object(list(oh-s("image", "KERNEL-CORE-IMAGE")))));
        image;
    };
    def kernel-core-image-node(source-path, image-path, primitive-count, dispatch-count, proof-count) = intern_node(bp("KERNEL-CORE-IMAGE"), list(intern_trivial_string(source-path), intern_trivial_string(image-path), intern_trivial_string("kernel-core-self"), intern_trivial_int(primitive-count), intern_trivial_int(dispatch-count), intern_trivial_int(proof-count), kernel-core-witness-plus(0), kernel-core-witness-if(0), kernel-core-witness-do(0)));
    def kernel-core-compiler-flow(_x) = compiler-flow("kernel-core-image-compiler", list(compiler-stage("source-scan", "Read kernel-core BML source.", "grammars/bml.fk", "BML source tokens", "bml-source-scan-file"), compiler-stage("source-parse", "Parse declarations into an observable source model.", "BML declaration parser", "KernelCoreSelf class model", "bml-source-file-parse-declarations"), compiler-stage("source-read", "Read the literal each source-declared count method returns.", "bml-method-body", "primitive, dispatch, and proof counts", "kernel-core-source-method-value"), compiler-stage("image-emit", "Emit the minimal self image as a NodeID.", "compiler-object", "KERNEL-CORE-IMAGE", "kernel-core-image-node"), compiler-stage("binary-roundtrip", "Persist and reload the image through .fkb.", "write_form_binary/read_form_binary", ".fkb image identity", "kernel-core-image-compiler-proof.fk")));
    def kernel-core-compile-image(source-path, image-path) = {
        let parsed = bml-source-file-parse-declarations(source-path);
        let model = bml-source-declaration-model(parsed);
        let self-class = kernel-core-self-class(model);
        let primitive-count = kernel-core-source-method-value(self-class, "RequiredPrimitiveCount");
        let dispatch-count = kernel-core-source-method-value(self-class, "RequiredDispatchCount");
        let proof-count = kernel-core-source-method-value(self-class, "RequiredProofCount");
        let image = kernel-core-witness-health(kernel-core-image-node(source-path, image-path, primitive-count, dispatch-count, proof-count));
        compiler-object("kernel-core-image", image, list(source-path, image-path, parsed, model, kernel-core-compiler-flow(0)), compiler-identity-inverse);
    };
    def kernel-core-compiled-image-node(compiled) = compiler-object-value(compiled);
    def kernel-core-compiled-source-path(compiled) = nth(compiler-object-source(compiled), 0);
    def kernel-core-compiled-image-path(compiled) = nth(compiler-object-source(compiled), 1);
    def kernel-core-compiled-parse(compiled) = nth(compiler-object-source(compiled), 2);
    def kernel-core-compiled-model(compiled) = nth(compiler-object-source(compiled), 3);
    def kernel-core-compiled-flow(compiled) = nth(compiler-object-source(compiled), 4);
    def kernel-core-write-compiled-image(compiled) = write_form_binary(kernel-core-compiled-image-path(compiled), kernel-core-compiled-image-node(compiled));
}
