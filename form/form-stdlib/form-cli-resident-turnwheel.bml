//////////////////////////////////////////////////////////////////////
//
// form-cli-resident-turnwheel.bml — executable BML for the one local
// resident turnwheel. Its lowering supplies the status vocabulary used by
// form-cli-resident-turnwheel.fk itself.
//
// No grammar here reaches a tokenizer. Stages remain scannerless Form rows,
// and the compiled methods are ordinary Form source/JIT candidates.
//
// High-grammar authority:
//   form/form-stdlib/bml/form-cli-resident-turnwheel.bml
//
//////////////////////////////////////////////////////////////////////

; preludes: form-stdlib/language-template.fk

section [form.bml] {
    template ResidentTurnStage<TId> {
        member id: TId;
        member phase: String;
        member signal: String;
        member gas: int;
        member tokens: int;
    }

    class FormCliResidentTurnwheel<T> {
        field PhaseProgram = "program";
        field PhasePrefill = "prefill";
        field PhaseModel = "model";
        field PhaseReturned = "program-returned";
        field PhasePrefillError = "prefill-error";
        field SignalLive = "live";
        field SignalReturned = "returned";
        field SignalDone = "done";
        field SignalNothing = "nothing";
        field SignalChoice = "choice";
        field SignalCut = "cut";
        field SignalUndo = "undo";
        field SignalTimeout = "timeout";
        field SignalFailure = "failure";
        field SignalRefused = "refused";
        field SignalRelease = "release";
        field CursorRoute = "scannerless-byte-fold-no-tokenizer";
        field FrameRule = "id-phase-signal-gas-tokens-no-prompt-or-answer-bytes";
        field PresenceRule = "nothing-is-not-zero-or-one";

        thought fcrtbml-pattern = list("resident-row", "scannerless-stage", "nodeid-jit-route", "choice-cut-undo-timeout", "stop-carried");

        def fcrtbml-terminal(signal) = if str_eq(signal, SignalReturned()) then 1 else if str_eq(signal, SignalDone()) then 1 else if str_eq(signal, SignalNothing()) then 1 else if str_eq(signal, SignalChoice()) then 1 else if str_eq(signal, SignalCut()) then 1 else if str_eq(signal, SignalTimeout()) then 1 else if str_eq(signal, SignalFailure()) then 1 else if str_eq(signal, SignalRefused()) then 1 else if str_eq(signal, SignalRelease()) then 1 else 0;

        def fcrtbml-runnable(signal, gas) = if eq(fcrtbml-terminal(signal), 1) then 0 else if eq(gas, 0) then 0 else 1;

        def fcrtbml-runnable-phase(phase) = if str_eq(phase, PhaseProgram()) then 1 else if str_eq(phase, PhasePrefill()) then 1 else if str_eq(phase, PhaseModel()) then 1 else 0;

        def fcrtbml-stop-carries(stopped) = if eq(stopped, 1) then 1 else 0;

        def fcrtbml-check() {
            let c0 = if str_eq(PhaseModel(), "model") then 1 else 0;
            let c1 = if eq(fcrtbml-terminal(SignalReturned()), 1) then 2 else 0;
            let c2 = if eq(fcrtbml-terminal(SignalDone()), 1) then 4 else 0;
            let c3 = if eq(fcrtbml-terminal(SignalLive()), 0) then 8 else 0;
            let c4 = if eq(fcrtbml-runnable(SignalLive(), 1), 1) then 16 else 0;
            let c5 = if eq(fcrtbml-runnable(SignalLive(), 0), 0) then 32 else 0;
            let c6 = if eq(fcrtbml-terminal(SignalCut()), 1) then 64 else 0;
            let c7 = if eq(fcrtbml-terminal(SignalRelease()), 1) then 128 else 0;
            let c8 = if eq(fcrtbml-stop-carries(1), 1) then 256 else 0;
            let c9 = if eq(fcrtbml-stop-carries(0), 0) then 512 else 0;
            let c10 = if eq(fcrtbml-runnable-phase(PhaseProgram()), 1) then if eq(fcrtbml-runnable-phase(PhasePrefillError()), 0) then 1024 else 0 else 0;
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, add(c7, add(c8, add(c9, c10))))))))));
        }
    }
    0;
}
