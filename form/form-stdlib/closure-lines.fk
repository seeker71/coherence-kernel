; closure-lines.fk — read a line of an fkwu closure back to the unit that wrote it.
;
; `./fkwu --closure <unit> <out>` joins every unit of a closure into one plain-Form
; file and heads each unit's text with a line "; unit: <path>". A sibling kernel
; reports a stop at a line of that file; this unit names the authored unit and
; the line within it.

(do
  (defn cl-marker? (s at) (eq (str_find s "; unit: " at) at))
  (defn cl-line-end (s at)
    (let e (str_find s (byte_to_str 10) at)
      (if (lt e 0) (str_len s) e)))
  (defn cl-walk (s at line want unit start)
    (if (ge at (str_len s))
        (nothing)
        (do
          (let end (cl-line-end s at))
          (let mark (cl-marker? s at))
          (if (eq line want)
              (if (or mark (eq unit (nothing)))
                  (nothing)
                  (list unit (sub line start)))
              (cl-walk s (add end 1) (add line 1) want
                       (if mark (substring s (add at 8) end) unit)
                       (if mark line start))))))
  (defn cl-unit-at (text line) (cl-walk text 0 1 line (nothing) 0))
  0)
