//////////////////////////////////////////////////////////////////////
// IQ3_XXS executable byte geometry. Authority: bml/iq3xxs-layout.bml.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ3XXSLayoutAuthority {
        field IQ3XXSAuthorityPath = "form/form-stdlib/bml/iq3xxs-layout.bml";
        field IQ3XXSAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ3XXSLayout {
        field IQ3XXSGGMLType = 18;
        field IQ3XXSBlockElements = 256;
        field IQ3XXSBlockBytes = 98;
        field IQ3XXSQuantOffset = 2;
        field IQ3XXSQuantBytes = 64;
        field IQ3XXSAuxOffset = 66;
        field IQ3XXSAuxBytes = 32;
        field IQ3XXSGroupsPerBlock = 8;
        field IQ3XXSGroupElements = 32;
        field IQ3XXSGridEntries = 256;
        field IQ3XXSSIMDWidth = 32;
        field IQ3XXSSlotRows = 4;

        ref iq3x-authority = IQ3XXSLayoutAuthority;
        thought iq3x-pattern = list("type18", "256-elements", "98-bytes", "two-grid-bytes-per-eight", "four-seven-bit-signs", "four-bit-group-scale");

        def iq3x-mod(x, n) = sub(x, mul(div(x, n), n));
        def iq3x-pow2(k) = if le(k, 0) then 1 else mul(2, iq3x-pow2(sub(k, 1)));
        def iq3x-u32(bytes, off) = add(nth(bytes, off), add(mul(256, nth(bytes, add(off, 1))), add(mul(65536, nth(bytes, add(off, 2))), mul(16777216, nth(bytes, add(off, 3))))));
        def iq3x-within(i) = iq3x-mod(i, IQ3XXSBlockElements());
        def iq3x-group(i) = div(iq3x-within(i), IQ3XXSGroupElements());
        def iq3x-rem(i) = iq3x-mod(iq3x-within(i), IQ3XXSGroupElements());
        def iq3x-l(i) = div(iq3x-rem(i), 8);
        def iq3x-j(i) = iq3x-mod(iq3x-rem(i), 8);
        def iq3x-quant-byte-offset(base, i) = add(add(base, IQ3XXSQuantOffset()), add(mul(iq3x-group(i), 8), add(mul(iq3x-l(i), 2), div(iq3x-j(i), 4))));
        def iq3x-grid-index(bytes, base, i) = nth(bytes, iq3x-quant-byte-offset(base, i));
        def iq3x-aux(bytes, base, i) = iq3x-u32(bytes, add(add(base, IQ3XXSAuxOffset()), mul(iq3x-group(i), 4)));
        def iq3x-sign-index(bytes, base, i) = iq3x-mod(div(iq3x-aux(bytes, base, i), iq3x-pow2(mul(7, iq3x-l(i)))), 128);
        def iq3x-scale-code(bytes, base, i) = div(iq3x-aux(bytes, base, i), iq3x-pow2(28));
        def iq3x-grid-byte(word, j) = iq3x-mod(div(word, iq3x-pow2(mul(8, iq3x-mod(j, 4)))), 256);
        def iq3x-slot-threads(rows) = mul(div(add(rows, sub(IQ3XXSSlotRows(), 1)), IQ3XXSSlotRows()), IQ3XXSSIMDWidth());
        def iq3x-slot-admissible(rows, cols) = if lt(rows, 1) then 0 else if eq(iq3x-mod(cols, IQ3XXSBlockElements()), 0) then 1 else 0;
        def iq3x-within-block(i) = if lt(i, 0) then 0 else if lt(i, IQ3XXSBlockElements()) then 1 else 0;
    }
    0;
}
