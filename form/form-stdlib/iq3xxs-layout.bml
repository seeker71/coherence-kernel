//////////////////////////////////////////////////////////////////////
// IQ3_XXS executable byte geometry. Authority: this file.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ3XXSLayoutAuthority {
        field IQ3XXSAuthorityPath = "form/form-stdlib/iq3xxs-layout.bml";
        field IQ3XXSAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ3XXSLayout {
        field IQ3XXSGGMLType = 18;
        field IQ3XXSBlockElements = 256;
        field IQ3XXSBlockBytes = 98;
        field IQ3XXSQuantOffset = 2;
        field IQ3XXSQuantBytes = 64;
        field IQ3XXSAuxOffset = 66;
        field IQ3XXSAuxBytes = 32;
        field IQ3XXSGroupsPerBlock = 8;
        field IQ3XXSGroupElements = 32;
        field IQ3XXSGridEntries = 256;
        field IQ3XXSSIMDWidth = 32;
        field IQ3XXSSlotRows = 4;

        ref iq3x-authority = IQ3XXSLayoutAuthority;
        thought iq3x-pattern = list("type18", "256-elements", "98-bytes", "two-grid-bytes-per-eight", "four-seven-bit-signs", "four-bit-group-scale");

        def iq3x-mod(x, n) = x - ((x / n) * n);
        def iq3x-pow2(k) = k <= 0 ? 1 : (2 * iq3x-pow2(k - 1));
        def iq3x-u32(bytes, off) = bytes[off] + ((256 * bytes[off + 1]) + ((65536 * bytes[off + 2]) + (16777216 * bytes[off + 3])));
        def iq3x-within(i) = iq3x-mod(i, IQ3XXSBlockElements());
        def iq3x-group(i) = iq3x-within(i) / IQ3XXSGroupElements();
        def iq3x-rem(i) = iq3x-mod(iq3x-within(i), IQ3XXSGroupElements());
        def iq3x-l(i) = iq3x-rem(i) / 8;
        def iq3x-j(i) = iq3x-mod(iq3x-rem(i), 8);
        def iq3x-quant-byte-offset(base, i) = (base + IQ3XXSQuantOffset()) + ((iq3x-group(i) * 8) + ((iq3x-l(i) * 2) + (iq3x-j(i) / 4)));
        def iq3x-grid-index(bytes, base, i) = bytes[iq3x-quant-byte-offset(base, i)];
        def iq3x-aux(bytes, base, i) = iq3x-u32(bytes, (base + IQ3XXSAuxOffset()) + (iq3x-group(i) * 4));
        def iq3x-sign-index(bytes, base, i) = iq3x-mod(iq3x-aux(bytes, base, i) / iq3x-pow2(7 * iq3x-l(i)), 128);
        def iq3x-scale-code(bytes, base, i) = iq3x-aux(bytes, base, i) / iq3x-pow2(28);
        def iq3x-grid-byte(word, j) = iq3x-mod(word / iq3x-pow2(8 * iq3x-mod(j, 4)), 256);
        def iq3x-slot-threads(rows) = ((rows + (IQ3XXSSlotRows() - 1)) / IQ3XXSSlotRows()) * IQ3XXSSIMDWidth();
        def iq3x-slot-admissible(rows, cols) = rows < 1 ? 0 : (Comparable) iq3x-mod(cols, IQ3XXSBlockElements()) == 0 ? 1 : 0;
        def iq3x-within-block(i) = i < 0 ? 0 : i < IQ3XXSBlockElements() ? 1 : 0;
    }
    0;
}
