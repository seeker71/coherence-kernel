; fsh-turn-process-spec.fk -- a pure Form-native one-id capability plan.
;
; The public Form contract accepts exactly one canonical lowercase 64-hex
; exchange identity.  It has no operation, resource mode, executable, path,
; working-directory, or argument selector.  The fixed capability stage names
; the honest current state: `native-pending-discovery`.  It is not evidence
; that any hardware resource was discovered, opened, or used.
;
; This cell is a specification/refusal layer, not an executor.  A valid
; identity produces an inspectable non-executable plan with executable and argv
; both `none`, then explicitly refuses the absent Form-native child executor.
; No caller can turn this data into a command.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk

(do
    ; -- fixed Form contract -------------------------------------------------
    (defn fshps-schema () "fsh-turn-process-spec-v2")
    (defn fshps-kind () "native-turn-capability-request")
    (defn fshps-execution () "non-executable")
    (defn fshps-capability-stage () "native-pending-discovery")
    (defn fshps-executable () "none")
    (defn fshps-argv () "none")
    (defn fshps-refused-no-executor ()
        "refused-no-form-native-child-executor")
    (defn fshps-refused-invalid-exchange-id () "refused-invalid-exchange-id")

    ; -- canonical exchange identity ----------------------------------------
    ; The sole public argument is lowercase hex.  An uppercase spelling is a
    ; distinct, refused input rather than an alternate spelling of a request.
    (defn fshps-lower-hex-byte? (b)
        (if (or (and (ge b 48) (le b 57))
                (and (ge b 97) (le b 102))) 1 0))
    (defn fshps-exchange-id-loop? (exchange-id i)
        (if (ge i (str_len exchange-id)) 1
            (if (eq (fshps-lower-hex-byte? (str-byte-at exchange-id i)) 1)
                (fshps-exchange-id-loop? exchange-id (add i 1))
                0)))
    (defn fshps-exchange-id? (exchange-id)
        (if (eq (str_len exchange-id) 64)
            (fshps-exchange-id-loop? exchange-id 0)
            0))
    (defn fshps-request-admitted? (exchange-id)
        (fshps-exchange-id? exchange-id))
    (defn fshps-safe-exchange-id (exchange-id)
        (if (eq (fshps-exchange-id? exchange-id) 1) exchange-id ""))
    (defn fshps-decision (exchange-id)
        (if (eq (fshps-exchange-id? exchange-id) 1)
            (fshps-refused-no-executor)
            (fshps-refused-invalid-exchange-id)))

    ; -- canonical capability plan ------------------------------------------
    ; This exact ordered envelope is deliberately smaller than the former
    ; process-shaped plan: until discovery, attestation, and a native executor
    ; exist, there is no honest operation or resource path to publish.
    (defn fshps-plan-field-names ()
        (list "schema" "kind" "execution" "capability_stage" "exchange_id"
              "executable" "argv" "decision"))
    (defn fshps-entry (name value) (list name value))
    (defn fshps-entry-name (entry) (nth entry 0))
    (defn fshps-entry-value (entry) (nth entry 1))
    (defn fshps-plan-for (safe-exchange-id decision)
        (list
            (fshps-entry "schema" (fshps-schema))
            (fshps-entry "kind" (fshps-kind))
            (fshps-entry "execution" (fshps-execution))
            (fshps-entry "capability_stage" (fshps-capability-stage))
            (fshps-entry "exchange_id" safe-exchange-id)
            (fshps-entry "executable" (fshps-executable))
            (fshps-entry "argv" (fshps-argv))
            (fshps-entry "decision" decision)))
    (defn fshps-plan (exchange-id)
        (fshps-plan-for (fshps-safe-exchange-id exchange-id)
                        (fshps-decision exchange-id)))
    (defn fshps-plan-value-loop (plan name)
        (if (eq (len plan) 0) ""
            (if (eq (len (head plan)) 2)
                (if (str_eq (fshps-entry-name (head plan)) name)
                    (fshps-entry-value (head plan))
                    (fshps-plan-value-loop (tail plan) name))
                "")))
    (defn fshps-plan-value (plan name)
        (fshps-plan-value-loop plan name))
    (defn fshps-plan-keys? (plan names)
        (if (eq (len plan) 0)
            (if (eq (len names) 0) 1 0)
            (if (eq (len names) 0) 0
                (if (and (eq (len (head plan)) 2)
                         (str_eq (fshps-entry-name (head plan)) (head names)))
                    (fshps-plan-keys? (tail plan) (tail names))
                    0))))
    (defn fshps-entry-equal? (left right)
        (if (and (eq (len left) 2) (eq (len right) 2))
            (if (and (str_eq (fshps-entry-name left) (fshps-entry-name right))
                     (str_eq (fshps-entry-value left) (fshps-entry-value right))) 1 0)
            0))
    (defn fshps-plan-equal? (left right)
        (if (eq (len left) 0)
            (if (eq (len right) 0) 1 0)
            (if (eq (len right) 0) 0
                (if (eq (fshps-entry-equal? (head left) (head right)) 1)
                    (fshps-plan-equal? (tail left) (tail right))
                    0))))
    ; `canonical?` permits an identity-shaped invalid-id refusal but rejects a
    ; changed stage, executor, argv, or decision.  `admitted?` is narrower:
    ; it means the identity is canonical, never that anything ran.
    (defn fshps-plan-canonical? (plan)
        (if (eq (fshps-plan-keys? plan (fshps-plan-field-names)) 0) 0
            (do
                (let exchange-id (fshps-plan-value plan "exchange_id"))
                (fshps-plan-equal? plan (fshps-plan exchange-id)))))
    (defn fshps-plan-admitted? (plan)
        (if (eq (fshps-plan-canonical? plan) 0) 0
            (fshps-request-admitted?
                (fshps-plan-value plan "exchange_id"))))
    (defn fshps-plan-valid? (plan) (fshps-plan-admitted? plan))

    ; Rendering observes only the plan data.  The explicitly empty executor
    ; fields remain visible so no reader mistakes an admitted identity for a
    ; local child, remote call, or resource-use observation.
    (defn fshps-render-entry (entry)
        (str_concat (fshps-entry-name entry)
            (str_concat "=" (str_concat (fshps-entry-value entry) "\n"))))
    (defn fshps-render-plan-loop (plan)
        (if (eq (len plan) 0) ""
            (str_concat (fshps-render-entry (head plan))
                        (fshps-render-plan-loop (tail plan)))))
    (defn fshps-render-plan (exchange-id)
        (fshps-render-plan-loop (fshps-plan exchange-id)))

    ; Named capability boundary: a future native executor must follow
    ; separately observed discovery and attestation before this can change.
    (defn fshps-child-execution-available? () 0)
    (defn fshps-child-decision (exchange-id)
        (fshps-decision exchange-id))

    0)
