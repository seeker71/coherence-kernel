// form-cli-local-law.fk — the ordinary local law of the form-cli loop.
//
// preludes: form-stdlib/core.fk
//
// The local law is core-only and witnessable alone, without the form-cli loop's
// twelve-cell chain. land-cadence.fk and form-cli-share-run.fk prelude this cell.
//
// Ordinary form-cli law, always on — a slice, not a mode you enter.
// When the local lane is quiet and the dish is quiet, the miss is silence.
// Generic share constructors live here for pure, local proofs. A live share
// is measured from completed-turn carrier evidence; this cell does not invent
// one when that evidence is absent.
// Edit / commit / review / crystallize are local with or without a network.
// push is host git — silence offline, local when the net is up. Remote lives
// inside form-cli and only when the local lane cannot answer AND a network is
// present.
// One runner. With no network, oracle becomes nothing — not a remote call.
section [form.bml] {
    def fcl-lane-local() = "local";
    def fcl-lane-oracle() = "oracle";
    def fcl-lane-nothing() = "nothing";
    def fcl-route-net(confidence, threshold, net) = confidence >= threshold ? fcl-lane-local() : (Comparable) net == 0 ? fcl-lane-nothing() : fcl-lane-oracle();
    // The turn this prompt is. Edit / commit / review / crystallize stay local.
    // push is host git; without a network it is silence.
    def fcl-step-edit() = 0;
    def fcl-step-commit() = 1;
    def fcl-step-review() = 2;
    def fcl-step-crystallize() = 3;
    def fcl-step-push() = 4;
    def fcl-step-lane(step, net) = (Comparable) step == fcl-step-push() ? (Comparable) net == 0 ? fcl-lane-nothing() : fcl-lane-local() : fcl-lane-local();
    // An answer's share. Three parts of 100, offered by form-cli.
    //   native — a Form recipe ran (this runner, this cell)
    //   local  — this machine (Metal, disk, host git)
    //   remote — a network mind (the voice in the water)
    def fcl-share(native, local, remote) = [native, local, remote];
    def fcl-sh-native(s) = s[0];
    def fcl-sh-local(s) = s[1];
    def fcl-sh-remote(s) = s[2];
    def fcl-share-sum(s) = fcl-sh-native(s) + fcl-sh-local(s) + fcl-sh-remote(s);
    def fcl-share-ok?(s) = (Comparable) fcl-share-sum(s) == 100 ? 1 : 0;
    // THREE EVIDENCE STATES, and the walked tally that can earn the second.
    // Main's line named the states as data; this line built the count. Neither is the
    // other's rival: the kind says WHICH sort of number is being held, the walked fold
    // is the tally main's note called waiting work. The live evidence cell, not this
    // core-only law, decides which state a completed turn has earned.
    def fcl-share-kind-declared() = 0;
    def fcl-share-kind-observed() = 1;
    def fcl-share-kind-embodied() = 2;
    def fcl-share-kind-name(kind) = (Comparable) kind == fcl-share-kind-observed() ? "observed" : (Comparable) kind == fcl-share-kind-embodied() ? "embodied" : "declared";
    def fcl-spoken-answer() = "Form speaks first; this machine carries; water answers only gaps.";
    // The DECLARED share, under both names. fcl-this-turn is main's and its callers
    // keep it; fcl-share-intended says out loud what sort of number it is. "This turn"
    // observed no turn — fcl-share-ok? read 1 forever because 50+20+30 is 100 by
    // construction.
    //   50 native — fkwu prints the walk, the share, the living floors, the answer
    //   20 local  — this Mac's fkwu + Metal
    //   30 remote — the remaining greeting around that print
    def fcl-this-kind() = fcl-share-kind-declared();
    def fcl-this-turn() = fcl-share(50, 20, 30);
    def fcl-share-intended() = fcl-this-turn();
    // WALKED — the same three fields, counted from the lanes a turn actually took.
    // fcr-walk already observes; nothing was counting its answers. Pure over a list of
    // ints, so this cell keeps preluding core.fk alone and the caller supplies the walks.
    def fcl-count-lane(walks, lane) = (Comparable) len(walks) == 0 ? 0 : ((Comparable) head(walks) == lane ? 1 : 0) + fcl-count-lane(tail(walks), lane);
    def fcl-share-walked(walks) = fcl-share(fcl-count-lane(walks, 0), fcl-count-lane(walks, 1), fcl-count-lane(walks, 2));
    // a walked share is admissible when every lane taken was counted. This CAN fail —
    // hand it a lane outside 0..2 and it does — which is the difference from
    // fcl-share-ok? on a literal.
    def fcl-walked-ok?(walks) = (Comparable) fcl-share-sum(fcl-share-walked(walks)) == len(walks) ? 1 : 0;
    def fcl-walked-kind() = fcl-share-kind-observed();
}
