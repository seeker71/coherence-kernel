; living-world-expression-composition.fk -- admitted local forms may compose
; without one becoming a grammar or a hidden default.
;
; Two distinct current structural mappings are composable only when the first
; target category and arity exactly meet the second source category and arity.
; Compatibility creates a proposal, never authority.  Every active holder of
; both mappings participates in a new offer/ack boundary before the chain is
; admitted.  Applying an admitted chain to new participant-offered material is
; another proposal governed by chain and material holders.
;
; A composed application retains its input, intermediate bridge, final
; sequence, both exact mappings, both uncertainty cells, attribution witnesses,
; and local path.  Zero current applications yields incomplete, one yields a
; locally renderable sequence, and many remains explicit ambiguity with no
; primary.  Declaration, live lens layers, alternatives, unknowable remainder,
; choice, and sender-authored timeout are independently optional.  A final
; offer/ack membrane precedes speech.  Revocation at any earlier layer leaves
; history present and makes every dependent successor stale.
;
; Honest floor: this composes two learned structural orderings.  It does not
; learn general syntax, semantics, morphology, autonomous enquiry, or an
; unrestricted generative voice.
; witnessed: 2026-08-08 -> 32767 on fkwu
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk

(let LWX-COMPOSITION-CHAIN              (bp "LWX-COMPOSITION-CHAIN"))
(let LWX-COMPOSITION-CHAIN-ORIGIN       (bp "LWX-COMPOSITION-CHAIN-ORIGIN"))
(let LWX-COMPOSITION-DERIVATION         (bp "LWX-COMPOSITION-DERIVATION"))
(let LWX-COMPOSITION-APPLICATION        (bp "LWX-COMPOSITION-APPLICATION"))
(let LWX-COMPOSITION-APPLICATION-ORIGIN (bp "LWX-COMPOSITION-APPLICATION-ORIGIN"))
(let LWX-COMPOSITION-PLAN               (bp "LWX-COMPOSITION-PLAN"))
(let LWX-COMPOSITION-UTTERANCE          (bp "LWX-COMPOSITION-UTTERANCE"))
(let LWX-COMPOSITION-UTTERANCE-ORIGIN   (bp "LWX-COMPOSITION-UTTERANCE-ORIGIN"))

; --- mapping-chain proposal and admission ----------------------------

(defn lwxc-signatures-compose? (first-signature second-signature)
    (if (and (node_eq
                (lwr-signature-target-category first-signature)
                (lwr-signature-source-category second-signature))
             (eq (lwr-signature-target-arity first-signature)
                 (lwr-signature-source-arity second-signature))) 1 0))

(defn lwxc-composable? (world first-candidate second-candidate)
    (if (and (not (node_eq first-candidate second-candidate))
             (and (eq (lwxb-mapping-current? world first-candidate) 1)
                  (and (eq (lwxb-mapping-current?
                              world second-candidate) 1)
                       (lwxc-signatures-compose?
                          (lwr-mapping-signature
                              (lwo-emergent-shape first-candidate))
                          (lwr-mapping-signature
                              (lwo-emergent-shape second-candidate)))))) 1 0))

; children: first and second mapping candidates, exact signatures,
; uncertainty from each mapping, and local path
(defn lwxc-chain (first-candidate second-candidate)
    (do
        (let first-mapping (lwo-emergent-shape first-candidate))
        (let second-mapping (lwo-emergent-shape second-candidate))
        (intern_node LWX-COMPOSITION-CHAIN
            (list first-candidate second-candidate
                  (lwr-mapping-signature first-mapping)
                  (lwr-mapping-signature second-mapping)
                  (lwr-mapping-uncertainty first-mapping)
                  (lwr-mapping-uncertainty second-mapping)
                  (lwo-local-path)))))
(defn lwxc-chain? (cell)
    (lwo-category? cell LWX-COMPOSITION-CHAIN))
(defn lwxc-chain-first-candidate (chain)
    (nth (node_children chain) 0))
(defn lwxc-chain-second-candidate (chain)
    (nth (node_children chain) 1))
(defn lwxc-chain-first-signature (chain)
    (nth (node_children chain) 2))
(defn lwxc-chain-second-signature (chain)
    (nth (node_children chain) 3))
(defn lwxc-chain-first-uncertainty (chain)
    (nth (node_children chain) 4))
(defn lwxc-chain-second-uncertainty (chain)
    (nth (node_children chain) 5))
(defn lwxc-chain-path (chain) (nth (node_children chain) 6))

(defn lwxc-chain-witnesses (world first-candidate second-candidate)
    (lwxb-field-union-items
        (lwo-field-items
            (lwo-active-attributions-for world second-candidate))
        (lwo-active-attributions-for world first-candidate)))

(defn lwxc-chain-origin (chain witnesses)
    (intern_node LWX-COMPOSITION-CHAIN-ORIGIN
        (list chain witnesses (lwo-local-path))))

(defn lwxc-chain-emergent (world first-candidate second-candidate)
    (if (eq (lwxc-composable?
                world first-candidate second-candidate) 0) (lwo-none)
        (do
            (let chain (lwxc-chain first-candidate second-candidate))
            (let witnesses
                (lwxc-chain-witnesses
                    world first-candidate second-candidate))
            (let origin (lwxc-chain-origin chain witnesses))
            (lwo-emergent chain witnesses
                (intern_trivial_int
                    (add (lwo-emergent-coherence first-candidate)
                         (lwo-emergent-coherence second-candidate)))
                (intern_trivial_int 2)
                (intern_trivial_int (lwo-field-size witnesses)) origin))))

(defn lwxc-chain-proposal (world first-candidate second-candidate)
    (do
        (let candidate
            (lwxc-chain-emergent world first-candidate second-candidate))
        (if (node_eq candidate (lwo-none)) (lwo-none)
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items (lwo-emergent-witnesses candidate))
                    (lwo-empty-field))
                (lwo-emergent-provenance candidate)))))

(defn lwxc-chain-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwxc-chain? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwxc-chain-candidate-current? (world candidate)
    (if (eq (lwxc-chain-candidate? candidate) 0) 0
        (do
            (let chain (lwo-emergent-shape candidate))
            (let expected
                (lwxc-chain-emergent world
                    (lwxc-chain-first-candidate chain)
                    (lwxc-chain-second-candidate chain)))
            (if (node_eq expected (lwo-none)) 0
                (node_eq candidate expected)))))

(defn lwxc-chain-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwxc-chain-candidate-current? world candidate) 1)) 1 0))

(defn lwxc-integrate-chain (round proposal action)
    (if (or (eq (lwt-proposal? proposal) 0)
            (eq (lwxc-chain-candidate-current?
                    (lwt-round-world round)
                    (lwt-proposal-candidate proposal)) 0))
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- a chain derives an unseen sequence under another membrane --------

; children: exact chain, new input, derived bridge, derived output, local path
(defn lwxc-derivation (chain input bridge output)
    (intern_node LWX-COMPOSITION-DERIVATION
        (list chain input bridge output (lwo-local-path))))
(defn lwxc-derivation? (cell)
    (lwo-category? cell LWX-COMPOSITION-DERIVATION))
(defn lwxc-derivation-chain (derivation)
    (nth (node_children derivation) 0))
(defn lwxc-derivation-input (derivation)
    (nth (node_children derivation) 1))
(defn lwxc-derivation-bridge (derivation)
    (nth (node_children derivation) 2))
(defn lwxc-derivation-output (derivation)
    (nth (node_children derivation) 3))
(defn lwxc-derivation-path (derivation)
    (nth (node_children derivation) 4))

(defn lwxc-derive (chain input)
    (do
        (let bridge
            (lwr-apply-mapping
                (lwo-emergent-shape
                    (lwxc-chain-first-candidate chain)) input))
        (if (node_eq bridge (lwo-none)) (lwo-none)
            (do
                (let output
                    (lwr-apply-mapping
                        (lwo-emergent-shape
                            (lwxc-chain-second-candidate chain)) bridge))
                (if (or (node_eq output (lwo-none))
                        (eq (lwtv-sequence? output) 0)) (lwo-none)
                    (lwxc-derivation chain input bridge output))))))

; children: chain candidate, derivation, active chain attributions,
; active input attributions, and local path
(defn lwxc-application
    (chain-candidate derivation chain-attributions input-attributions)
    (intern_node LWX-COMPOSITION-APPLICATION
        (list chain-candidate derivation chain-attributions
              input-attributions (lwo-local-path))))
(defn lwxc-application? (cell)
    (lwo-category? cell LWX-COMPOSITION-APPLICATION))
(defn lwxc-application-chain-candidate (application)
    (nth (node_children application) 0))
(defn lwxc-application-derivation (application)
    (nth (node_children application) 1))
(defn lwxc-application-chain-attributions (application)
    (nth (node_children application) 2))
(defn lwxc-application-input-attributions (application)
    (nth (node_children application) 3))
(defn lwxc-application-path (application)
    (nth (node_children application) 4))

(defn lwxc-application-witnesses
    (chain-attributions input-attributions)
    (lwxb-field-union-items
        (lwo-field-items input-attributions) chain-attributions))

(defn lwxc-application-origin (application witnesses)
    (intern_node LWX-COMPOSITION-APPLICATION-ORIGIN
        (list application witnesses (lwo-local-path))))

(defn lwxc-application-emergent (world chain-candidate input)
    (if (or (eq (lwxc-chain-integrated-current?
                    world chain-candidate) 0)
            (eq (lwxb-material-current? world input) 0)) (lwo-none)
        (do
            (let chain (lwo-emergent-shape chain-candidate))
            (let derivation (lwxc-derive chain input))
            (if (node_eq derivation (lwo-none)) (lwo-none)
                (do
                    (let chain-attributions
                        (lwo-active-attributions-for world chain-candidate))
                    (let input-attributions
                        (lwo-active-attributions-for world input))
                    (let witnesses
                        (lwxc-application-witnesses
                            chain-attributions input-attributions))
                    (let application
                        (lwxc-application chain-candidate derivation
                            chain-attributions input-attributions))
                    (let origin
                        (lwxc-application-origin application witnesses))
                    (lwo-emergent application witnesses
                        (intern_trivial_int
                            (lwo-emergent-coherence chain-candidate))
                        (intern_trivial_int 2)
                        (intern_trivial_int (lwo-field-size witnesses))
                        origin))))))

(defn lwxc-application-proposal (world chain-candidate input)
    (do
        (let candidate
            (lwxc-application-emergent world chain-candidate input))
        (if (node_eq candidate (lwo-none)) (lwo-none)
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items (lwo-emergent-witnesses candidate))
                    (lwo-empty-field))
                (lwo-emergent-provenance candidate)))))

(defn lwxc-application-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwxc-application?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwxc-application-candidate-current? (world candidate)
    (if (eq (lwxc-application-candidate? candidate) 0) 0
        (do
            (let application (lwo-emergent-shape candidate))
            (let derivation (lwxc-application-derivation application))
            (let expected
                (lwxc-application-emergent world
                    (lwxc-application-chain-candidate application)
                    (lwxc-derivation-input derivation)))
            (if (node_eq expected (lwo-none)) 0
                (node_eq candidate expected)))))

(defn lwxc-application-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwxc-application-candidate-current?
                    world candidate) 1)) 1 0))

(defn lwxc-integrate-application (round proposal action)
    (if (or (eq (lwt-proposal? proposal) 0)
            (eq (lwxc-application-candidate-current?
                    (lwt-round-world round)
                    (lwt-proposal-candidate proposal)) 0))
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- zero / one / many composed expression plans ---------------------

(defn lwxc-applications-for-material? (world items material)
    (if (eq (len items) 0) 1
        (do
            (let candidate (head items))
            (if (and (eq (lwxc-application-integrated-current?
                            world candidate) 1)
                     (node_eq
                        (lwxc-derivation-input
                            (lwxc-application-derivation
                                (lwo-emergent-shape candidate))) material))
                (lwxc-applications-for-material?
                    world (tail items) material) 0))))

; children mirror the expression-plan optional surface while retaining
; composed applications as their own exact kind
(defn lwxc-plan-cell
    (material applications sequence status options declaration alternatives
     unknown choice timeout evidence)
    (intern_node LWX-COMPOSITION-PLAN
        (list material applications sequence status options declaration
              alternatives unknown choice timeout evidence (lwo-local-path))))
(defn lwxc-plan? (cell) (lwo-category? cell LWX-COMPOSITION-PLAN))
(defn lwxc-plan-material (plan) (nth (node_children plan) 0))
(defn lwxc-plan-applications (plan) (nth (node_children plan) 1))
(defn lwxc-plan-sequence (plan) (nth (node_children plan) 2))
(defn lwxc-plan-status (plan) (nth (node_children plan) 3))
(defn lwxc-plan-options (plan) (nth (node_children plan) 4))
(defn lwxc-plan-declaration (plan) (nth (node_children plan) 5))
(defn lwxc-plan-alternatives (plan) (nth (node_children plan) 6))
(defn lwxc-plan-unknown (plan) (nth (node_children plan) 7))
(defn lwxc-plan-choice (plan) (nth (node_children plan) 8))
(defn lwxc-plan-timeout (plan) (nth (node_children plan) 9))
(defn lwxc-plan-evidence (plan) (nth (node_children plan) 10))
(defn lwxc-plan-path (plan) (nth (node_children plan) 11))

(defn lwxc-plan-options-valid?
    (world material applications declaration alternatives unknown choice timeout)
    (if (and (eq (lwo-category? applications LWO-FIELD) 1)
             (and (eq (lwo-category? alternatives LWO-FIELD) 1)
                  (and (eq (lwxb-optional-declaration-current?
                              world declaration) 1)
                       (and (eq (lwxb-optional-unknown-valid? unknown) 1)
                            (and (eq (lwlc-choice-valid? choice) 1)
                                 (eq (lwxb-optional-timeout-valid?
                                       timeout) 1))))))
        (lwxc-applications-for-material? world
            (lwo-field-items applications) material) 0))

(defn lwxc-plan-for
    (world material applications declaration alternatives unknown choice
     timeout evidence)
    (if (or (eq (lwxb-material-current? world material) 0)
            (eq (lwxc-plan-options-valid? world material applications
                    declaration alternatives unknown choice timeout) 0))
        (lwo-none)
        (do
            (let count (lwo-field-size applications))
            (if (eq count 0)
                (lwxc-plan-cell material applications
                    (lwtv-sequence (empty)) (lwxb-incomplete) applications
                    declaration alternatives unknown choice timeout evidence)
                (if (eq count 1)
                    (do
                        (let application
                            (lwo-emergent-shape
                                (head (lwo-field-items applications))))
                        (lwxc-plan-cell material applications
                            (lwxc-derivation-output
                                (lwxc-application-derivation application))
                            (lwxb-ready) applications declaration alternatives
                            unknown choice timeout evidence))
                    (lwxc-plan-cell material applications
                        (lwtv-sequence (empty)) (lwxb-ambiguous) applications
                        declaration alternatives unknown choice timeout
                        evidence))))))

(defn lwxc-plan-current? (world plan)
    (if (eq (lwxc-plan? plan) 0) 0
        (node_eq plan
            (lwxc-plan-for world (lwxc-plan-material plan)
                (lwxc-plan-applications plan)
                (lwxc-plan-declaration plan)
                (lwxc-plan-alternatives plan)
                (lwxc-plan-unknown plan) (lwxc-plan-choice plan)
                (lwxc-plan-timeout plan) (lwxc-plan-evidence plan)))))

(defn lwxc-time-observation (plan observed-time)
    (if (or (node_eq (lwxc-plan-timeout plan) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense (lwxc-plan-timeout plan) observed-time)))

; --- local composed voice and final consent --------------------------

(defn lwxc-plan-witnesses (world plan)
    (do
        (let with-material
            (lwxb-add-attributions world (lwxc-plan-material plan)
                (lwo-empty-field)))
        (let with-applications
            (lwxb-witness-cells world
                (lwo-field-items (lwxc-plan-applications plan))
                with-material))
        (let with-symbols
            (lwxb-witness-cells world
                (lwtv-sequence-items (lwxc-plan-sequence plan))
                with-applications))
        (if (node_eq (lwxc-plan-declaration plan) (lwo-none)) with-symbols
            (lwxb-add-attributions world
                (lwxc-plan-declaration plan) with-symbols))))

; children: exact plan, local surface, immediate ONE, alternatives,
; optional unknown/choice/timeout, witnesses, evidence, and local path
(defn lwxc-utterance-cell (plan surface witnesses)
    (intern_node LWX-COMPOSITION-UTTERANCE
        (list plan (intern_trivial_string surface)
              (oac-one (lwxc-plan-sequence plan))
              (lwxc-plan-alternatives plan) (lwxc-plan-unknown plan)
              (lwxc-plan-choice plan) (lwxc-plan-timeout plan) witnesses
              (lwxc-plan-evidence plan) (lwo-local-path))))
(defn lwxc-utterance? (cell)
    (lwo-category? cell LWX-COMPOSITION-UTTERANCE))
(defn lwxc-utterance-plan (utterance) (nth (node_children utterance) 0))
(defn lwxc-utterance-surface-cell (utterance)
    (nth (node_children utterance) 1))
(defn lwxc-utterance-surface (utterance)
    (node_value (lwxc-utterance-surface-cell utterance)))
(defn lwxc-utterance-immediate (utterance)
    (nth (node_children utterance) 2))
(defn lwxc-utterance-alternatives (utterance)
    (nth (node_children utterance) 3))
(defn lwxc-utterance-unknown (utterance)
    (nth (node_children utterance) 4))
(defn lwxc-utterance-choice (utterance)
    (nth (node_children utterance) 5))
(defn lwxc-utterance-timeout (utterance)
    (nth (node_children utterance) 6))
(defn lwxc-utterance-witnesses (utterance)
    (nth (node_children utterance) 7))
(defn lwxc-utterance-evidence (utterance)
    (nth (node_children utterance) 8))
(defn lwxc-utterance-path (utterance)
    (nth (node_children utterance) 9))

(defn lwxc-emit-from-plan (world plan)
    (if (or (eq (lwxc-plan-current? world plan) 0)
            (eq (lwxb-ready? (lwxc-plan-status plan)) 0)) (lwo-none)
        (lwxc-utterance-cell plan
            (lwtv-render-items
                (lwtv-sequence-items (lwxc-plan-sequence plan)) "")
            (lwxc-plan-witnesses world plan))))

(defn lwxc-utterance-current? (world utterance)
    (if (eq (lwxc-utterance? utterance) 0) 0
        (node_eq utterance
            (lwxc-emit-from-plan world
                (lwxc-utterance-plan utterance)))))

(defn lwxc-utterance-origin (utterance)
    (intern_node LWX-COMPOSITION-UTTERANCE-ORIGIN
        (list utterance (lwo-local-path))))

(defn lwxc-utterance-proposal (world plan)
    (do
        (let utterance (lwxc-emit-from-plan world plan))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwxc-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwxc-utterance-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int
                            (len (lwtv-sequence-items
                                (lwxc-plan-sequence plan))))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwxc-utterance-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwxc-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))

(defn lwxc-integrate-utterance (round proposal action)
    (if (eq (lwxc-utterance-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))
