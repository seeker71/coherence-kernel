; living-world-trace-relation.fk -- experience may propose a relation.
;
; A current integrated native execution trace is already a content-addressed
; account of declaration, lens stack, Recipe, before, result, flow, changes,
; choice, evidence, and witnesses.  This organ lets holders optionally reflect
; that account as a directional relation hypothesis.  It names no relation,
; task, surface, ontology, or answer.  The relation predicate is derived only
; from the exact trace Recipe/declaration/lens and an optional offered view.
;
; One reflection is retained but cannot propose.  Recurrent independent
; reflections may propose a hypothesis, which still crosses the ordinary
; unanimous tending membrane.  Independent sources outside the hypothesis
; witnesses must then re-observe it before a relation edge may be proposed.
; The edge crosses a second unanimous membrane.  Revocation at either earlier
; layer makes dependent currentness lapse without erasing history.
;
; Endpoint symbols are separately learned candidates whose referents must be
; the trace's exact before and result cells.  Surface vocabulary therefore
; remains outside this organ.  Optional view, alternatives, unknown, choice,
; and timeout remain absent when absent and retain their exact cells when
; offered.  Immediate absence, pending time, and expired condensation are
; separate observations.
;
; witnessed: 2026-08-08 -> hypothesis/edge bands 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk

(let LWTR-OFFER                (bp "LWTR-OFFER"))
(let LWTR-OFFER-EVIDENCE       (bp "LWTR-OFFER-EVIDENCE"))
(let LWTR-RELATION             (bp "LWTR-RELATION"))
(let LWTR-HYPOTHESIS           (bp "LWTR-HYPOTHESIS"))
(let LWTR-HYPOTHESIS-ORIGIN    (bp "LWTR-HYPOTHESIS-ORIGIN"))
(let LWTR-ATTESTATION          (bp "LWTR-ATTESTATION"))
(let LWTR-ATTESTATION-EVIDENCE (bp "LWTR-ATTESTATION-EVIDENCE"))
(let LWTR-ATTESTATION-SET      (bp "LWTR-ATTESTATION-SET"))
(let LWTR-UNCERTAINTY          (bp "LWTR-UNCERTAINTY"))
(let LWTR-EDGE-ORIGIN          (bp "LWTR-EDGE-ORIGIN"))

; children: integrated execution basis, optional learned left/right endpoint
; candidates, optional offered view, alternatives, optional unknown, optional
; choice, optional timeout, evidence, local path
(defn lwtr-offer
    (basis left right view alternatives unknown choice timeout evidence)
    (intern_node LWTR-OFFER
        (list basis left right view alternatives unknown choice timeout
              evidence (lwo-local-path))))
(defn lwtr-offer? (cell) (lwo-category? cell LWTR-OFFER))
(defn lwtr-offer-basis (offer) (nth (node_children offer) 0))
(defn lwtr-offer-left (offer) (nth (node_children offer) 1))
(defn lwtr-offer-right (offer) (nth (node_children offer) 2))
(defn lwtr-offer-view (offer) (nth (node_children offer) 3))
(defn lwtr-offer-alternatives (offer) (nth (node_children offer) 4))
(defn lwtr-offer-unknown (offer) (nth (node_children offer) 5))
(defn lwtr-offer-choice (offer) (nth (node_children offer) 6))
(defn lwtr-offer-timeout (offer) (nth (node_children offer) 7))
(defn lwtr-offer-offered-evidence (offer) (nth (node_children offer) 8))
(defn lwtr-offer-path (offer) (nth (node_children offer) 9))

(defn lwtr-execution-basis-shape? (basis)
    (if (and (eq (lwo-category? basis LWO-EMERGENT) 1)
             (eq (lwre-trace? (lwo-emergent-shape basis)) 1)) 1 0))
(defn lwtr-execution-basis-current? (world basis)
    (if (and (eq (lwtr-execution-basis-shape? basis) 1)
             (and (eq (lwo-active? world basis) 1)
                  (eq (lwre-trace-current? world
                        (lwo-emergent-shape basis)) 1))) 1 0))

(defn lwtr-optional-symbol-candidate? (candidate)
    (if (or (node_eq candidate (lwo-none))
            (eq (lwsl-symbol-candidate? candidate) 1)) 1 0))
(defn lwtr-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwtr-optional-timeout-valid? (timeout)
    (if (or (node_eq timeout (lwo-none))
            (eq (oac-timeout? timeout) 1)) 1 0))
(defn lwtr-offer-shape-valid? (offer)
    (if (and (eq (lwtr-offer? offer) 1)
             (and (eq (lwtr-execution-basis-shape?
                        (lwtr-offer-basis offer)) 1)
                  (and (eq (lwtr-optional-symbol-candidate?
                             (lwtr-offer-left offer)) 1)
                       (and (eq (lwtr-optional-symbol-candidate?
                                  (lwtr-offer-right offer)) 1)
                            (and (or (node_eq (lwtr-offer-left offer)
                                               (lwo-none))
                                     (or (node_eq (lwtr-offer-right offer)
                                                   (lwo-none))
                                         (not (node_eq
                                                (lwtr-offer-left offer)
                                                (lwtr-offer-right offer)))))
                                 (and (eq (lwo-category?
                                           (lwtr-offer-alternatives offer)
                                           LWO-FIELD) 1)
                                      (and (eq (lwtr-optional-unknown-valid?
                                                (lwtr-offer-unknown offer)) 1)
                                           (and (eq (lwlc-choice-valid?
                                                     (lwtr-offer-choice offer)) 1)
                                                (eq (lwtr-optional-timeout-valid?
                                                      (lwtr-offer-timeout offer))
                                                    1))))))))) 1 0))
(defn lwtr-offer-complete? (offer)
    (if (and (eq (lwtr-offer-shape-valid? offer) 1)
             (and (not (node_eq (lwtr-offer-left offer) (lwo-none)))
                  (not (node_eq (lwtr-offer-right offer) (lwo-none))))) 1 0))

(defn lwtr-left-referent (offer)
    (lwnv-symbol-referent
        (lwo-emergent-shape (lwtr-offer-left offer))))
(defn lwtr-right-referent (offer)
    (lwnv-symbol-referent
        (lwo-emergent-shape (lwtr-offer-right offer))))
(defn lwtr-trace-before (offer)
    (lwre-trace-before
        (lwo-emergent-shape (lwtr-offer-basis offer))))
(defn lwtr-trace-after (offer)
    (lwre-result-primary
        (lwre-trace-result
            (lwo-emergent-shape (lwtr-offer-basis offer)))))

(defn lwtr-offer-current? (world offer)
    (if (or (eq (lwtr-offer-complete? offer) 0)
            (eq (lwo-active? world offer) 0)) 0
        (if (or (eq (lwtr-execution-basis-current?
                      world (lwtr-offer-basis offer)) 0)
                (or (eq (lwsl-integrated-current?
                          world (lwtr-offer-left offer)) 0)
                    (eq (lwsl-integrated-current?
                          world (lwtr-offer-right offer)) 0))) 0
            (if (or (not (node_eq (lwtr-left-referent offer)
                                  (lwtr-trace-before offer)))
                    (not (node_eq (lwtr-right-referent offer)
                                  (lwtr-trace-after offer)))) 0
                (if (node_eq (lwtr-offer-view offer) (lwo-none)) 1
                    (lwo-active? world (lwtr-offer-view offer)))))))

; The predicate is structural identity derived from the executed Recipe and
; its declaration/lenses plus an optional participant-offered view.  It owns
; no semantic name.
(defn lwtr-relation-for (offer)
    (do
        (let trace (lwo-emergent-shape (lwtr-offer-basis offer)))
        (intern_node LWTR-RELATION
            (list (lwre-trace-recipe trace)
                  (lwre-trace-declaration trace)
                  (lwre-trace-lens trace)
                  (lwtr-offer-view offer)
                  (lwo-local-path)))))
(defn lwtr-relation? (cell) (lwo-category? cell LWTR-RELATION))
(defn lwtr-relation-recipe (relation) (nth (node_children relation) 0))
(defn lwtr-relation-declaration (relation) (nth (node_children relation) 1))
(defn lwtr-relation-trace-lens (relation) (nth (node_children relation) 2))
(defn lwtr-relation-view (relation) (nth (node_children relation) 3))
(defn lwtr-relation-path (relation) (nth (node_children relation) 4))

(defn lwtr-time-observation (offer observed-time)
    (do
        (let timeout (lwtr-offer-timeout offer))
        (if (or (node_eq timeout (lwo-none))
                (node_eq observed-time (lwo-none)))
            (lwo-none)
            (oac-timeout-condense timeout observed-time))))

(defn lwtr-offer-matches? (world offer relation left right)
    (if (and (eq (lwtr-offer-current? world offer) 1)
             (and (node_eq (lwtr-relation-for offer) relation)
                  (and (node_eq (lwtr-offer-left offer) left)
                       (node_eq (lwtr-offer-right offer) right)))) 1 0))

; children: exact reflection offer and all its current attributions
(defn lwtr-offer-evidence (offer attributions)
    (intern_node LWTR-OFFER-EVIDENCE (list offer attributions)))
(defn lwtr-offer-evidence-offer (evidence) (nth (node_children evidence) 0))
(defn lwtr-offer-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwtr-collect-offers (world items relation left right field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (lwtr-collect-offers world (tail items) relation left right
                (if (eq (lwtr-offer-matches?
                            world offer relation left right) 1)
                    (lwo-field-add field
                        (lwtr-offer-evidence offer
                            (lwo-active-attributions-for world offer)))
                    field)))))
(defn lwtr-offer-evidence-for (world relation left right)
    (lwtr-collect-offers world
        (lwo-field-items (lwo-world-cells world)) relation left right
        (lwo-empty-field)))

(defn lwtr-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwtr-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwtr-attribution-field-for-offers (items field)
    (if (eq (len items) 0) field
        (lwtr-attribution-field-for-offers (tail items)
            (lwtr-field-union-items
                (lwo-field-items
                    (lwtr-offer-evidence-attributions (head items)))
                field))))
(defn lwtr-offer-attributions (offer-evidence)
    (lwtr-attribution-field-for-offers
        (lwo-field-items offer-evidence) (lwo-empty-field)))
(defn lwtr-distinct-source-count (attributions)
    (lwo-field-size
        (lwt-sources-from-attributions
            (lwo-field-items attributions) (lwo-empty-field))))

(defn lwtr-dependency-attributions-for-offer (world offer witnesses)
    (do
        (let with-basis
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-offer-basis offer))) witnesses))
        (let with-left
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-offer-left offer))) with-basis))
        (let with-right
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-offer-right offer))) with-left))
        (let with-offer
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world offer)) with-right))
        (if (node_eq (lwtr-offer-view offer) (lwo-none)) with-offer
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-offer-view offer))) with-offer))))
(defn lwtr-witnesses-for-offers (world items witnesses)
    (if (eq (len items) 0) witnesses
        (lwtr-witnesses-for-offers world (tail items)
            (lwtr-dependency-attributions-for-offer world
                (lwtr-offer-evidence-offer (head items)) witnesses))))
(defn lwtr-witnesses (world offer-evidence)
    (lwtr-witnesses-for-offers world
        (lwo-field-items offer-evidence) (lwo-empty-field)))

(defn lwtr-offer-alternative-items (items field)
    (if (eq (len items) 0) field
        (lwtr-offer-alternative-items (tail items)
            (lwtr-field-union-items
                (lwo-field-items
                    (lwtr-offer-alternatives
                        (lwtr-offer-evidence-offer (head items)))) field))))
(defn lwtr-offer-unknown-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwtr-offer-unknown
                    (lwtr-offer-evidence-offer (head items))))
            (lwtr-offer-unknown-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwtr-offer-choice-items (items field)
    (if (eq (len items) 0) field
        (do
            (let choice
                (lwtr-offer-choice
                    (lwtr-offer-evidence-offer (head items))))
            (lwtr-offer-choice-items (tail items)
                (if (node_eq choice (lwo-none)) field
                    (lwo-field-add field choice))))))
(defn lwtr-offer-timeout-items (items field)
    (if (eq (len items) 0) field
        (do
            (let timeout
                (lwtr-offer-timeout
                    (lwtr-offer-evidence-offer (head items))))
            (lwtr-offer-timeout-items (tail items)
                (if (node_eq timeout (lwo-none)) field
                    (lwo-field-add field timeout))))))

; children: derived relation, endpoint candidates, exact recurrent offers,
; retained alternatives/unknowns/choices/timeouts, witnesses, threshold, path
(defn lwtr-hypothesis
    (relation left right offer-evidence alternatives unknowns choices timeouts
     witnesses threshold)
    (intern_node LWTR-HYPOTHESIS
        (list relation left right offer-evidence alternatives unknowns choices
              timeouts witnesses (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwtr-hypothesis? (cell) (lwo-category? cell LWTR-HYPOTHESIS))
(defn lwtr-hypothesis-relation (hypothesis) (nth (node_children hypothesis) 0))
(defn lwtr-hypothesis-left (hypothesis) (nth (node_children hypothesis) 1))
(defn lwtr-hypothesis-right (hypothesis) (nth (node_children hypothesis) 2))
(defn lwtr-hypothesis-offers (hypothesis) (nth (node_children hypothesis) 3))
(defn lwtr-hypothesis-alternatives (hypothesis) (nth (node_children hypothesis) 4))
(defn lwtr-hypothesis-unknowns (hypothesis) (nth (node_children hypothesis) 5))
(defn lwtr-hypothesis-choices (hypothesis) (nth (node_children hypothesis) 6))
(defn lwtr-hypothesis-timeouts (hypothesis) (nth (node_children hypothesis) 7))
(defn lwtr-hypothesis-witnesses (hypothesis) (nth (node_children hypothesis) 8))
(defn lwtr-hypothesis-threshold (hypothesis)
    (node_value (nth (node_children hypothesis) 9)))
(defn lwtr-hypothesis-path (hypothesis) (nth (node_children hypothesis) 10))

(defn lwtr-hypothesis-for (world offer threshold)
    (if (eq (lwtr-offer-current? world offer) 0) (lwo-none)
        (do
            (let relation (lwtr-relation-for offer))
            (let left (lwtr-offer-left offer))
            (let right (lwtr-offer-right offer))
            (let offer-evidence
                (lwtr-offer-evidence-for world relation left right))
            (let attributions (lwtr-offer-attributions offer-evidence))
            (if (lt (lwtr-distinct-source-count attributions) threshold)
                (lwo-none)
                (do
                    (let items (lwo-field-items offer-evidence))
                    (lwtr-hypothesis relation left right offer-evidence
                        (lwtr-offer-alternative-items items (lwo-empty-field))
                        (lwtr-offer-unknown-items items (lwo-empty-field))
                        (lwtr-offer-choice-items items (lwo-empty-field))
                        (lwtr-offer-timeout-items items (lwo-empty-field))
                        (lwtr-witnesses world offer-evidence) threshold))))))

(defn lwtr-hypothesis-origin (hypothesis)
    (intern_node LWTR-HYPOTHESIS-ORIGIN
        (list hypothesis (intern_trivial_int
                           (lwtr-hypothesis-threshold hypothesis))
              (lwo-local-path))))
(defn lwtr-hypothesis-proposal-for (world offer threshold)
    (do
        (let hypothesis (lwtr-hypothesis-for world offer threshold))
        (if (node_eq hypothesis (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwtr-hypothesis-witnesses hypothesis))
                (let sources
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field)))
                (let count (lwo-field-size sources))
                (let origin (lwtr-hypothesis-origin hypothesis))
                (let candidate
                    (lwo-emergent hypothesis witnesses
                        (intern_trivial_int
                            (lwtr-distinct-source-count
                                (lwtr-offer-attributions
                                    (lwtr-hypothesis-offers hypothesis))))
                        (intern_trivial_int (lwo-field-size witnesses))
                        (intern_trivial_int threshold) origin))
                (lwt-proposal candidate sources origin)))))

(defn lwtr-hypothesis-proposals-items (world items threshold field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (let proposal
                (if (eq (lwtr-offer? offer) 1)
                    (lwtr-hypothesis-proposal-for world offer threshold)
                    (lwo-none)))
            (lwtr-hypothesis-proposals-items world (tail items) threshold
                (if (node_eq proposal (lwo-none)) field
                    (lwo-field-add field proposal))))))
(defn lwtr-hypothesis-proposals (world threshold)
    (lwtr-hypothesis-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwtr-hypothesis-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtr-hypothesis?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwtr-first-offer (hypothesis)
    (lwtr-offer-evidence-offer
        (head (lwo-field-items (lwtr-hypothesis-offers hypothesis)))))
(defn lwtr-hypothesis-candidate-current? (world candidate)
    (if (eq (lwtr-hypothesis-candidate? candidate) 0) 0
        (do
            (let hypothesis (lwo-emergent-shape candidate))
            (let current
                (lwtr-hypothesis-for world (lwtr-first-offer hypothesis)
                    (lwtr-hypothesis-threshold hypothesis)))
            (if (and (node_eq hypothesis current)
                     (node_eq (lwo-emergent-witnesses candidate)
                              (lwtr-hypothesis-witnesses current))) 1 0))))
(defn lwtr-hypothesis-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtr-hypothesis-candidate-current?
                    world candidate) 1)) 1 0))
(defn lwtr-hypothesis-integrate (round proposal action)
    (if (eq (lwtr-hypothesis-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; children: integrated hypothesis candidate, ack, alternatives, optional
; unknown, evidence, local path
(defn lwtr-attestation
    (hypothesis ack alternatives unknown evidence)
    (intern_node LWTR-ATTESTATION
        (list hypothesis ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwtr-attestation? (cell) (lwo-category? cell LWTR-ATTESTATION))
(defn lwtr-attestation-hypothesis (attestation)
    (nth (node_children attestation) 0))
(defn lwtr-attestation-ack (attestation) (nth (node_children attestation) 1))
(defn lwtr-attestation-alternatives (attestation)
    (nth (node_children attestation) 2))
(defn lwtr-attestation-unknown (attestation) (nth (node_children attestation) 3))
(defn lwtr-attestation-offered-evidence (attestation)
    (nth (node_children attestation) 4))
(defn lwtr-attestation-path (attestation) (nth (node_children attestation) 5))

(defn lwtr-attestation-shape-valid? (attestation)
    (if (and (eq (lwtr-attestation? attestation) 1)
             (and (eq (lwtr-hypothesis-candidate?
                         (lwtr-attestation-hypothesis attestation)) 1)
                  (and (eq (oac-valid-ack?
                             (lwtr-attestation-ack attestation)) 1)
                       (and (eq (lwo-category?
                                  (lwtr-attestation-alternatives attestation)
                                  LWO-FIELD) 1)
                            (eq (lwtr-optional-unknown-valid?
                                  (lwtr-attestation-unknown attestation))
                                1))))) 1 0))

(defn lwtr-source-in-attributions? (items source)
    (if (eq (len items) 0) 0
        (if (node_eq (lwo-attribution-source (head items)) source) 1
            (lwtr-source-in-attributions? (tail items) source))))
(defn lwtr-attribution-sources-outside? (items excluded)
    (if (eq (len items) 0) 1
        (if (eq (lwtr-source-in-attributions? excluded
                    (lwo-attribution-source (head items))) 1) 0
            (lwtr-attribution-sources-outside? (tail items) excluded))))
(defn lwtr-attestation-ack-coherent? (attestation)
    (do
        (let ack (lwtr-attestation-ack attestation))
        (if (eq (oac-one? ack) 1)
            (node_eq (oac-payload ack)
                (lwtr-hypothesis-relation
                    (lwo-emergent-shape
                        (lwtr-attestation-hypothesis attestation))))
            1)))
(defn lwtr-attestation-current? (world attestation)
    (if (or (eq (lwtr-attestation-shape-valid? attestation) 0)
            (or (eq (lwo-active? world attestation) 0)
                (eq (lwtr-attestation-ack-coherent? attestation) 0))) 0
        (do
            (let candidate (lwtr-attestation-hypothesis attestation))
            (if (and (eq (lwtr-hypothesis-integrated-current?
                            world candidate) 1)
                     (eq (lwtr-attribution-sources-outside?
                            (lwo-field-items
                                (lwo-active-attributions-for
                                    world attestation))
                            (lwo-field-items
                                (lwo-emergent-witnesses candidate))) 1)) 1 0))))

; children: exact attestation and its active independent attributions
(defn lwtr-attestation-evidence (attestation attributions)
    (intern_node LWTR-ATTESTATION-EVIDENCE
        (list attestation attributions)))
(defn lwtr-attestation-evidence-attestation (evidence)
    (nth (node_children evidence) 0))
(defn lwtr-attestation-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

; children: supports, alternatives, dissents, silences, unresolved
(defn lwtr-attestation-set
    (supports alternatives dissents silences unresolved)
    (intern_node LWTR-ATTESTATION-SET
        (list supports alternatives dissents silences unresolved)))
(defn lwtr-attestation-set? (cell)
    (lwo-category? cell LWTR-ATTESTATION-SET))
(defn lwtr-attestation-supports (set) (nth (node_children set) 0))
(defn lwtr-attestation-set-alternatives (set)
    (nth (node_children set) 1))
(defn lwtr-attestation-dissents (set) (nth (node_children set) 2))
(defn lwtr-attestation-silences (set) (nth (node_children set) 3))
(defn lwtr-attestation-unresolved (set) (nth (node_children set) 4))
(defn lwtr-empty-attestation-set ()
    (lwtr-attestation-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwtr-classify-attestation (evidence set)
    (do
        (let attestation
            (lwtr-attestation-evidence-attestation evidence))
        (let ack (lwtr-attestation-ack attestation))
        (if (eq (oac-one? ack) 1)
            (lwtr-attestation-set
                (lwo-field-add (lwtr-attestation-supports set) evidence)
                (lwtr-attestation-set-alternatives set)
                (lwtr-attestation-dissents set)
                (lwtr-attestation-silences set)
                (lwtr-attestation-unresolved set))
            (if (eq (oac-zero? ack) 1)
                (lwtr-attestation-set
                    (lwtr-attestation-supports set)
                    (lwtr-attestation-set-alternatives set)
                    (lwo-field-add (lwtr-attestation-dissents set) evidence)
                    (lwtr-attestation-silences set)
                    (lwtr-attestation-unresolved set))
                (if (eq (oac-nothing? ack) 1)
                    (lwtr-attestation-set
                        (lwtr-attestation-supports set)
                        (lwtr-attestation-set-alternatives set)
                        (lwtr-attestation-dissents set)
                        (lwo-field-add
                            (lwtr-attestation-silences set) evidence)
                        (lwtr-attestation-unresolved set))
                    (if (or (eq (oac-alternative-ack? ack) 1)
                            (and (eq (oac-node? ack) 1)
                                 (eq (oac-alternative?
                                       (oac-payload ack)) 1)))
                        (lwtr-attestation-set
                            (lwtr-attestation-supports set)
                            (lwo-field-add
                                (lwtr-attestation-set-alternatives set)
                                evidence)
                            (lwtr-attestation-dissents set)
                            (lwtr-attestation-silences set)
                            (lwtr-attestation-unresolved set))
                        (lwtr-attestation-set
                            (lwtr-attestation-supports set)
                            (lwtr-attestation-set-alternatives set)
                            (lwtr-attestation-dissents set)
                            (lwtr-attestation-silences set)
                            (lwo-field-add
                                (lwtr-attestation-unresolved set)
                                evidence))))))))

(defn lwtr-collect-attestations (world items candidate set)
    (if (eq (len items) 0) set
        (do
            (let attestation (head items))
            (lwtr-collect-attestations world (tail items) candidate
                (if (and (eq (lwtr-attestation? attestation) 1)
                         (and (node_eq
                                (lwtr-attestation-hypothesis attestation)
                                candidate)
                              (eq (lwtr-attestation-current?
                                    world attestation) 1)))
                    (lwtr-classify-attestation
                        (lwtr-attestation-evidence attestation
                            (lwo-active-attributions-for world attestation))
                        set)
                    set)))))
(defn lwtr-attestations-for (world candidate)
    (lwtr-collect-attestations world
        (lwo-field-items (lwo-world-cells world)) candidate
        (lwtr-empty-attestation-set)))

(defn lwtr-attribution-field-for-attestations (items field)
    (if (eq (len items) 0) field
        (lwtr-attribution-field-for-attestations (tail items)
            (lwtr-field-union-items
                (lwo-field-items
                    (lwtr-attestation-evidence-attributions (head items)))
                field))))
(defn lwtr-attestation-witnesses (set)
    (do
        (let supports
            (lwtr-attribution-field-for-attestations
                (lwo-field-items (lwtr-attestation-supports set))
                (lwo-empty-field)))
        (let alternatives
            (lwtr-attribution-field-for-attestations
                (lwo-field-items
                    (lwtr-attestation-set-alternatives set))
                supports))
        (let dissents
            (lwtr-attribution-field-for-attestations
                (lwo-field-items (lwtr-attestation-dissents set))
                alternatives))
        (let silences
            (lwtr-attribution-field-for-attestations
                (lwo-field-items (lwtr-attestation-silences set))
                dissents))
        (lwtr-attribution-field-for-attestations
            (lwo-field-items (lwtr-attestation-unresolved set)) silences)))
(defn lwtr-attestation-source-count (field)
    (lwtr-distinct-source-count
        (lwtr-attribution-field-for-attestations
            (lwo-field-items field) (lwo-empty-field))))
(defn lwtr-support-count (set)
    (lwtr-attestation-source-count (lwtr-attestation-supports set)))
(defn lwtr-dissent-count (set)
    (lwtr-attestation-source-count (lwtr-attestation-dissents set)))

(defn lwtr-attestation-alternative-cells (items field)
    (if (eq (len items) 0) field
        (do
            (let attestation
                (lwtr-attestation-evidence-attestation (head items)))
            (lwtr-attestation-alternative-cells (tail items)
                (lwtr-field-union-items
                    (lwo-field-items
                        (lwtr-attestation-alternatives attestation))
                    field)))))
(defn lwtr-attestation-unknown-cells (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwtr-attestation-unknown
                    (lwtr-attestation-evidence-attestation (head items))))
            (lwtr-attestation-unknown-cells (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))

; children: retained hypothesis/attestation alternatives, dissents, silences,
; unresolved responses, unknowns, local path
(defn lwtr-uncertainty (hypothesis set)
    (do
        (let all
            (append
                (lwo-field-items (lwtr-attestation-supports set))
                (append
                    (lwo-field-items
                        (lwtr-attestation-set-alternatives set))
                    (append
                        (lwo-field-items (lwtr-attestation-dissents set))
                        (append
                            (lwo-field-items (lwtr-attestation-silences set))
                            (lwo-field-items
                                (lwtr-attestation-unresolved set)))))))
        (intern_node LWTR-UNCERTAINTY
            (list (lwtr-hypothesis-alternatives hypothesis)
                  (lwtr-attestation-alternative-cells all (lwo-empty-field))
                  (lwtr-attestation-dissents set)
                  (lwtr-attestation-silences set)
                  (lwtr-attestation-unresolved set)
                  (lwtr-hypothesis-unknowns hypothesis)
                  (lwtr-attestation-unknown-cells all (lwo-empty-field))
                  (lwo-local-path)))))
(defn lwtr-uncertainty? (cell) (lwo-category? cell LWTR-UNCERTAINTY))
(defn lwtr-uncertainty-hypothesis-alternatives (uncertainty)
    (nth (node_children uncertainty) 0))
(defn lwtr-uncertainty-attestation-alternatives (uncertainty)
    (nth (node_children uncertainty) 1))
(defn lwtr-uncertainty-dissents (uncertainty)
    (nth (node_children uncertainty) 2))
(defn lwtr-uncertainty-silences (uncertainty)
    (nth (node_children uncertainty) 3))
(defn lwtr-uncertainty-unresolved (uncertainty)
    (nth (node_children uncertainty) 4))
(defn lwtr-uncertainty-hypothesis-unknowns (uncertainty)
    (nth (node_children uncertainty) 5))
(defn lwtr-uncertainty-attestation-unknowns (uncertainty)
    (nth (node_children uncertainty) 6))
(defn lwtr-uncertainty-path (uncertainty) (nth (node_children uncertainty) 7))

(defn lwtr-edge-witnesses (world hypothesis-candidate set)
    (do
        (let hypothesis (lwo-emergent-shape hypothesis-candidate))
        (let with-hypothesis
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for
                        world hypothesis-candidate))
                (lwo-empty-field)))
        (let with-left
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-hypothesis-left hypothesis)))
                with-hypothesis))
        (let with-right
            (lwtr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwtr-hypothesis-right hypothesis)))
                with-left))
        (lwtr-field-union-items
            (lwo-field-items (lwtr-attestation-witnesses set)) with-right)))

(defn lwtr-edge-origin (hypothesis-candidate set threshold)
    (intern_node LWTR-EDGE-ORIGIN
        (list hypothesis-candidate set (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwtr-edge-origin-hypothesis (origin)
    (nth (node_children origin) 0))
(defn lwtr-edge-origin-attestations (origin)
    (nth (node_children origin) 1))
(defn lwtr-edge-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))

; The generic relation constructor retains five evidence dimensions beyond
; subject/predicate/object.  The base organ intentionally exposes only those
; first three; this membrane names its own exact view of the remaining cells.
(defn lwtr-edge-evidence (relation) (nth (node_children relation) 3))
(defn lwtr-edge-coherence-cell (relation) (nth (node_children relation) 4))
(defn lwtr-edge-resonance-cell (relation) (nth (node_children relation) 5))
(defn lwtr-edge-uncertainty (relation) (nth (node_children relation) 6))
(defn lwtr-edge-provenance (relation) (nth (node_children relation) 7))

(defn lwtr-edge-candidate-for (world hypothesis-candidate threshold)
    (if (eq (lwtr-hypothesis-integrated-current?
                world hypothesis-candidate) 0) (lwo-none)
        (do
            (let hypothesis (lwo-emergent-shape hypothesis-candidate))
            (let set (lwtr-attestations-for world hypothesis-candidate))
            (if (or (lt (lwtr-support-count set) threshold)
                    (gt (lwtr-dissent-count set) 0)) (lwo-none)
                (do
                    (let witnesses
                        (lwtr-edge-witnesses
                            world hypothesis-candidate set))
                    (let origin
                        (lwtr-edge-origin
                            hypothesis-candidate set threshold))
                    (let relation
                        (lwo-relation
                            (lwtr-hypothesis-left hypothesis)
                            (lwtr-hypothesis-relation hypothesis)
                            (lwtr-hypothesis-right hypothesis)
                            set
                            (intern_trivial_int (lwtr-support-count set))
                            (intern_trivial_int (lwo-field-size witnesses))
                            (lwtr-uncertainty hypothesis set)
                            hypothesis-candidate))
                    (lwo-emergent relation witnesses
                        (intern_trivial_int (lwtr-support-count set))
                        (intern_trivial_int (lwo-field-size witnesses))
                        (intern_trivial_int threshold) origin))))))

(defn lwtr-edge-proposal (world hypothesis-candidate threshold)
    (do
        (let candidate
            (lwtr-edge-candidate-for world hypothesis-candidate threshold))
        (if (node_eq candidate (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwo-emergent-witnesses candidate))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    (lwo-emergent-provenance candidate))))))

(defn lwtr-edge-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (and (eq (lwo-relation?
                        (lwo-emergent-shape candidate)) 1)
                  (eq (lwo-category?
                        (lwo-emergent-provenance candidate)
                        LWTR-EDGE-ORIGIN) 1))) 1 0))
(defn lwtr-edge-candidate-current? (world candidate)
    (if (eq (lwtr-edge-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let current
                (lwtr-edge-candidate-for world
                    (lwtr-edge-origin-hypothesis origin)
                    (lwtr-edge-origin-threshold origin)))
            (if (node_eq candidate current) 1 0))))
(defn lwtr-edge-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtr-edge-candidate-current? world candidate) 1)) 1 0))
(defn lwtr-edge-integrate (round proposal action)
    (if (eq (lwtr-edge-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
