   let norm = nam-rms(hx,model[3],hn,inv,g[0],ht,g[7]);
   let out = nam-linear(model[2],hn,logits,ht,0);
   let done = nam-sync();
   [logits,blocks[1],hn,hx,inv,[ib,x,scratch,hx,hn,inv,logits],t,ht];
  }
  def nll-forward-handles(blocks) = if nil?(blocks) then [] else append(head(blocks)[1],nll-forward-handles(tail(blocks)));
  def nll-forward-close(r) = nam-free(append(r[5],nll-forward-handles(r[1])));
  def nll-select(logits,vocab) {
   let out = nam-alloc(1);
   let rc = nll-run("nll_argmax",[logits,out],[vocab],1,1);
   let value = ln-u32-le(metal_buf_read(out,0,4),0);
   let released = nam-free([out]);
   value;
  }
  def nll-select-except(logits,vocab,skip) {
   let out = nam-alloc(1);
   let rc = nll-run("nll_argmax_except",[logits,out],[vocab,skip],1,1);
   let value = ln-u32-le(metal_buf_read(out,0,4),0);
   let released = nam-free([out]);
   value;
  }
  def nll-select-except2(logits,vocab,skip,skip2) {
   let out = nam-alloc(1);
   let rc = nll-run("nll_argmax_except2",[logits,out],[vocab,skip,skip2],1,1);
   let value = ln-u32-le(metal_buf_read(out,0,4),0);
   let released = nam-free([out]);
   value;
  }
 }
 0;
}
