// form-agent-repo-contribution.fk — a bounded repository sense-and-change
// transaction for a resident Form agent.
//
// This is capability data, not an operation table.  A caller offers one root,
// one allowed relative-path prefix, a byte extent, and a test-route NodeID.
// Source discovery and testing arrive as function values, so new lookup organs
// and new test recipes do not require another dispatcher seat here.
//
// A change is proposed before it can move.  Apply re-reads the current bytes,
// requires one exact old span, writes candidate and recovery siblings, asks the
// supplied test callback before and after the atomic rename, and restores the
// recovery image when the live-path test does not answer value.  `nothing`,
// refusal, choice, failure and timeout remain distinct results; integer 0 and 1
// are values only inside a successful test result.
//
// No SHA is paid for bookkeeping.  The proposal NodeID is interned from the
// exact capability/path/old/new/test values already in hand.  The source body is
// truth, that NodeID is the within-residence address, and the exact-old match is
// the freshness membrane.
//
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/native-edit.fk
section [form.bml] {
    def farc-capability(root, prefix, max-bytes, test-route) = ["form-agent-repo-capability-v1", root, prefix, max-bytes, test-route];
    def farc-capability?(c) = nothing?(c) ? 0 : !((Comparable) len(c) == 5) ? 0 : !((String) c[0] == "form-agent-repo-capability-v1") ? 0 : (Comparable) str_len(c[1]) == 0 || (Comparable) str_len(c[2]) == 0 ? 0 : c[3] <= 0 ? 0 : nothing?(c[4]) ? 0 : 1;
    def farc-cap-root(c) = c[1];
    def farc-cap-prefix(c) = c[2];
    def farc-cap-max-bytes(c) = c[3];
    def farc-cap-test-route(c) = c[4];
    def farc-relative-path?(path) = (Comparable) str_len(path) == 0 || ((Comparable) str_byte_at(path, 0) == 47 || (str_find(path, "..", 0) >= 0 || str_find(path, "\\", 0) >= 0)) ? 0 : 1;
    def farc-path-admitted?(cap, path) = (Comparable) farc-capability?(cap) == 0 ? 0 : (Comparable) farc-relative-path?(path) == 0 ? 0 : (Comparable) str_find(path, farc-cap-prefix(cap), 0) == 0 && (Comparable) fs-suffix?(path, ".fk") == 1 ? 1 : 0;
    def farc-full-path(cap, path) = fs-path-join(farc-cap-root(cap), path);
    // A discovery callback returns source-of's honest shape:
    //   ("one" path), ("choice" paths), or nothing.
    def farc-discovery-paths-admitted?(cap, paths) = nil?(paths) ? 1 : (Comparable) farc-path-admitted?(cap, head(paths)) == 1 ? farc-discovery-paths-admitted?(cap, tail(paths)) : 0;
    def farc-source-result(status, reason, paths, text) = ["form-agent-repo-source-v1", status, reason, paths, text];
    def farc-source-status(r) = r[1];
    def farc-source-reason(r) = r[2];
    def farc-source-paths(r) = r[3];
    def farc-source-text(r) = r[4];
    def farc-read(cap, path) = (Comparable) farc-path-admitted?(cap, path) == 0 ? farc-source-result("refused", "path-capability-refused", [], "") : {
        let full = farc-full-path(cap, path);
        let size = fs-stat-size(full);
        size < 0 ? farc-source-result("nothing", "source-absent", [path], "") : size > farc-cap-max-bytes(cap) ? farc-source-result("refused", "source-byte-extent-refused", [path], "") : farc-source-result("value", "source-read", [path], fs-read-slice(full, 0, size));
    };
    def farc-find(cap, lookupf, ctx, name) = {
        let found = lookupf(ctx, name);
        nothing?(found) ? farc-source-result("nothing", "source-name-unborn", [], "") : (String) head(found) == "one" ? farc-read(cap, found[1]) : (String) head(found) == "choice" ? {
            let paths = found[1];
            (Comparable) farc-discovery-paths-admitted?(cap, paths) == 1 ? farc-source-result("choice", "source-name-plural", paths, "") : farc-source-result("refused", "discovery-left-capability", paths, "");
        } : farc-source-result("failure", "discovery-shape-malformed", [], "");
    };
    // Proposal identity is computed from exact values.  It is not a curated
    // function number and does not claim persistence across a fresh intern table.
    def farc-proposal-category() = intern_trivial_string("form-agent-repo-proposal-v1");
    def farc-capability-token(cap) = intern_node(intern_trivial_string("form-agent-repo-capability-v1"), [intern_trivial_string(farc-cap-root(cap)), intern_trivial_string(farc-cap-prefix(cap)), intern_trivial_int(farc-cap-max-bytes(cap)), farc-cap-test-route(cap)]);
    def farc-proposal(cap, path, old, new) = intern_node(farc-proposal-category(), [farc-capability-token(cap), intern_trivial_string(path), intern_trivial_string(old), intern_trivial_string(new), farc-cap-test-route(cap)]);
    def farc-proposal?(p) = nothing?(p) ? 0 : !node_eq(node_category(p), farc-proposal-category()) ? 0 : (Comparable) len(node_children(p)) == 5 ? 1 : 0;
    def farc-proposal-capability(p) = node_children(p)[0];
    def farc-proposal-path(p) = node_value(node_children(p)[1]);
    def farc-proposal-old(p) = node_value(node_children(p)[2]);
    def farc-proposal-new(p) = node_value(node_children(p)[3]);
    def farc-proposal-test-route(p) = node_children(p)[4];
    def farc-proposal-bound?(cap, p) = (Comparable) farc-proposal?(p) == 0 ? 0 : !node_eq(farc-proposal-capability(p), farc-capability-token(cap)) ? 0 : !node_eq(farc-proposal-test-route(p), farc-cap-test-route(cap)) ? 0 : farc-path-admitted?(cap, farc-proposal-path(p));
    // Test callbacks answer this typed shape.  A zero or one is present only
    // when status=value; raw numbers and raw nothing are never interpreted.
    def farc-test-result(status, reason, present, value) = ["form-agent-repo-test-v1", status, reason, present, value];
    def farc-test-result?(r) = nothing?(r) ? 0 : !((Comparable) len(r) == 5) ? 0 : (String) r[0] == "form-agent-repo-test-v1" ? 1 : 0;
    def farc-test-status(r) = r[1];
    def farc-test-reason(r) = r[2];
    def farc-test-present?(r) = r[3];
    def farc-test-value(r) = r[4];
    def farc-test-passed?(r) = (Comparable) farc-test-result?(r) == 0 ? 0 : (String) farc-test-status(r) == "value" && (Comparable) farc-test-present?(r) == 1 ? (Comparable) farc-test-value(r) == 1 ? 1 : 0 : 0;
    // Receipt keeps before/after path, proposal NodeID, exact signal, test
    // observations, byte counts and lifecycle.  No prose is asked to stand in
    // for an effect.
    def farc-receipt(status, reason, proposal, before-bytes, after-bytes, pre, post, trace) = ["form-agent-repo-receipt-v1", status, reason, proposal, before-bytes, after-bytes, pre, post, trace];
    def farc-status(r) = r[1];
    def farc-reason(r) = r[2];
    def farc-receipt-proposal(r) = r[3];
    def farc-before-bytes(r) = r[4];
    def farc-after-bytes(r) = r[5];
    def farc-pretest(r) = r[6];
    def farc-posttest(r) = r[7];
    def farc-trace(r) = r[8];
    def farc-no(status, reason, proposal, trace) = farc-receipt(status, reason, proposal, 0, 0, nothing(), nothing(), trace);
    def farc-apply(cap, grants, verifyf, testf, ctx, proposal) = (Comparable) farc-proposal-bound?(cap, proposal) == 0 ? farc-no("refused", "proposal-capability-refused", proposal, ["choice", "refused", "release"]) : !node_eq(grants, farc-capability-token(cap)) ? farc-no("refused", "capability-not-granted", proposal, ["choice", "refused", "release"]) : {
        let path = farc-proposal-path(proposal);
        let full = farc-full-path(cap, path);
        let before = fs-read-text(full);
        let old = farc-proposal-old(proposal);
        let new = farc-proposal-new(proposal);
        let occurrences = ne-count(before, old);
        (Comparable) occurrences == 0 ? farc-no("nothing", "expected-old-absent", proposal, ["choice", "nothing", "release"]) : occurrences > 1 ? farc-no("choice", "expected-old-plural", proposal, ["choice", "release"]) : {
            let candidate = ne-replace-first(before, old, new);
            str_len(candidate) > farc-cap-max-bytes(cap) ? farc-no("refused", "candidate-byte-extent-refused", proposal, ["choice", "refused", "release"]) : {
                let pre = verifyf(ctx, farc-proposal-test-route(proposal), candidate);
                (Comparable) farc-test-passed?(pre) == 0 ? farc-receipt((Comparable) farc-test-result?(pre) == 1 ? farc-test-status(pre) : "failure", (Comparable) farc-test-result?(pre) == 1 ? farc-test-reason(pre) : "pretest-shape-malformed", proposal, str_len(before), str_len(before), pre, nothing(), ["choice", "failure", "undo", "release"]) : {
                    let suffix = str_concat(".form-agent-", int_to_str(node_inst(proposal)));
                    let candidate-path = str_concat(full, str_concat(suffix, ".candidate"));
                    let recovery-path = str_concat(full, str_concat(suffix, ".recovery"));
                    let backup-write = fs-write-text(recovery-path, before);
                    let candidate-write = (Comparable) backup-write == str_len(before) ? fs-write-text(candidate-path, candidate) : -1;
                    !((Comparable) backup-write == str_len(before)) || !((Comparable) candidate-write == str_len(candidate)) ? {
                        fs-remove-file(candidate-path);
                        fs-remove-file(recovery-path);
                        farc-receipt("failure", "stage-write-refused", proposal, str_len(before), str_len(before), pre, nothing(), ["choice", "failure", "undo", "release"]);
                    } : !((String) fs-read-text(candidate-path) == candidate) ? {
                        fs-remove-file(candidate-path);
                        fs-remove-file(recovery-path);
                        farc-receipt("failure", "stage-readback-mismatch", proposal, str_len(before), str_len(before), pre, nothing(), ["choice", "failure", "undo", "release"]);
                    } : !((Comparable) fs-rename(candidate-path, full) == 0) ? {
                        fs-remove-file(candidate-path);
                        fs-remove-file(recovery-path);
                        farc-receipt("failure", "atomic-rename-refused", proposal, str_len(before), str_len(before), pre, nothing(), ["choice", "failure", "undo", "release"]);
                    } : {
                        let post = testf(ctx, farc-proposal-test-route(proposal), full);
                        (Comparable) farc-test-passed?(post) == 1 ? {
                            fs-remove-file(recovery-path);
                            farc-receipt("value", "applied-and-observed", proposal, str_len(before), str_len(candidate), pre, post, ["choice", "crystallize", "release"]);
                        } : {
                            let restored = fs-rename(recovery-path, full);
                            farc-receipt((Comparable) restored == 0 ? "failure" : "failure", (Comparable) restored == 0 ? "posttest-failed-restored" : "posttest-failed-restore-refused", proposal, str_len(before), (Comparable) restored == 0 ? str_len(before) : str_len(candidate), pre, post, ["choice", "failure", "undo", "release"]);
                        };
                    };
                };
            };
        };
    };
    0;
}
