; living-world-action-cycle.fk -- offered action can become observed learning.
;
; No action names or task taxonomy live here. A participant may offer any
; content-addressed focus, action, declaration, lens, before-cell, prediction,
; alternatives, unknowable remainder, choice, and optional timeout. Exact
; recurrence forms intention evidence. A primary exists only when exactly one
; current Recipe intention reaches the offered threshold; zero or several
; eligible intentions remain OPEN with every alternative intact.
;
; Selection, execution, observation, learning, and the next offer are separate
; authority boundaries. Native Recipe execution derives its own exact
; before->result delta; it never accepts a caller-authored value as the observed
; change. Prediction match uses ONE, mismatch offers the actual delta through
; NODE/ALTERNATIVE, absence of a prediction uses NODE, and inability to execute
; uses NOTHING. Immediate response and timeout condensation remain different
; cells and may coexist in one execution observation.
;
; Independent observers may confirm, correct, remain silent, or offer another
; delta. A correction creates only a revision hypothesis. Even an integrated
; learning cell cannot activate its successor action offer: participants must
; offer that successor again through the ordinary living-world membrane.
;
; witnessed: 2026-08-07 -> selection/execution/learning 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk

(let LWAC-OFFER               (bp "LWAC-OFFER"))
(let LWAC-INTENTION           (bp "LWAC-INTENTION"))
(let LWAC-OFFER-EVIDENCE      (bp "LWAC-OFFER-EVIDENCE"))
(let LWAC-INTENTION-EVIDENCE  (bp "LWAC-INTENTION-EVIDENCE"))
(let LWAC-FIELD               (bp "LWAC-FIELD"))
(let LWAC-READY               (bp "LWAC-READY"))
(let LWAC-OPEN                (bp "LWAC-OPEN"))
(let LWAC-UNRESOLVED          (bp "LWAC-UNRESOLVED"))
(let LWAC-SELECTION-ORIGIN    (bp "LWAC-SELECTION-ORIGIN"))
(let LWAC-DELTA               (bp "LWAC-DELTA"))
(let LWAC-FLOW                (bp "LWAC-FLOW"))
(let LWAC-EXECUTION           (bp "LWAC-EXECUTION"))
(let LWAC-EXECUTION-ORIGIN    (bp "LWAC-EXECUTION-ORIGIN"))
(let LWAC-OBSERVATION         (bp "LWAC-OBSERVATION"))
(let LWAC-LEARNING            (bp "LWAC-LEARNING"))
(let LWAC-CONFIRM             (bp "LWAC-CONFIRM"))
(let LWAC-REVISE              (bp "LWAC-REVISE"))
(let LWAC-WAIT                (bp "LWAC-WAIT"))
(let LWAC-NODE-RETURN         (bp "LWAC-NODE-RETURN"))
(let LWAC-REVISION            (bp "LWAC-REVISION"))
(let LWAC-LEARNING-ORIGIN     (bp "LWAC-LEARNING-ORIGIN"))

(defn lwac-status (kind) (intern_node kind (empty)))
(defn lwac-ready () (lwac-status LWAC-READY))
(defn lwac-open () (lwac-status LWAC-OPEN))
(defn lwac-confirm () (lwac-status LWAC-CONFIRM))
(defn lwac-revise () (lwac-status LWAC-REVISE))
(defn lwac-wait () (lwac-status LWAC-WAIT))
(defn lwac-node-return () (lwac-status LWAC-NODE-RETURN))
(defn lwac-ready? (status) (if (node_eq status (lwac-ready)) 1 0))
(defn lwac-open? (status) (if (node_eq status (lwac-open)) 1 0))
(defn lwac-revise? (status) (if (node_eq status (lwac-revise)) 1 0))

(defn lwac-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwac-optional-timeout-valid? (timeout)
    (if (or (node_eq timeout (lwo-none))
            (eq (oac-timeout-valid? timeout) 1)) 1 0))

; children: focus, opaque action, declaration, lens, before, optional predicted
; delta, explicit alternatives, optional unknown, optional choice, optional
; timeout contract, evidence, local path
(defn lwac-offer
    (focus action declaration lens before prediction alternatives unknown
     choice timeout evidence)
    (intern_node LWAC-OFFER
        (list focus action declaration lens before prediction alternatives
              unknown choice timeout evidence (lwo-local-path))))
(defn lwac-offer? (cell) (lwo-category? cell LWAC-OFFER))
(defn lwac-offer-focus (offer) (nth (node_children offer) 0))
(defn lwac-offer-action (offer) (nth (node_children offer) 1))
(defn lwac-offer-declaration (offer) (nth (node_children offer) 2))
(defn lwac-offer-lens (offer) (nth (node_children offer) 3))
(defn lwac-offer-before (offer) (nth (node_children offer) 4))
(defn lwac-offer-prediction (offer) (nth (node_children offer) 5))
(defn lwac-offer-alternatives (offer) (nth (node_children offer) 6))
(defn lwac-offer-unknown (offer) (nth (node_children offer) 7))
(defn lwac-offer-choice (offer) (nth (node_children offer) 8))
(defn lwac-offer-timeout (offer) (nth (node_children offer) 9))
(defn lwac-offer-evidence (offer) (nth (node_children offer) 10))
(defn lwac-offer-path (offer) (nth (node_children offer) 11))

; children: before, after, exact lens, local path
(defn lwac-delta (before after lens)
    (intern_node LWAC-DELTA (list before after lens (lwo-local-path))))
(defn lwac-delta? (cell) (lwo-category? cell LWAC-DELTA))
(defn lwac-delta-before (delta) (nth (node_children delta) 0))
(defn lwac-delta-after (delta) (nth (node_children delta) 1))
(defn lwac-delta-lens (delta) (nth (node_children delta) 2))
(defn lwac-delta-path (delta) (nth (node_children delta) 3))
(defn lwac-optional-delta-valid? (delta)
    (if (or (node_eq delta (lwo-none))
            (eq (lwac-delta? delta) 1)) 1 0))

(defn lwac-offer-valid? (offer)
    (if (eq (lwac-offer? offer) 0) 0
        (if (eq (lwlc-declaration-valid?
                    (lwac-offer-declaration offer)) 0) 0
            (if (eq (lwlc-lens? (lwac-offer-lens offer)) 0) 0
                (if (eq (lwac-optional-delta-valid?
                            (lwac-offer-prediction offer)) 0) 0
                    (if (eq (lwo-category?
                                (lwac-offer-alternatives offer)
                                LWO-FIELD) 0) 0
                        (if (eq (lwac-optional-unknown-valid?
                                    (lwac-offer-unknown offer)) 0) 0
                            (if (eq (lwlc-choice-valid?
                                        (lwac-offer-choice offer)) 0) 0
                                (lwac-optional-timeout-valid?
                                    (lwac-offer-timeout offer))))))))))

; Intention identity deliberately excludes offered evidence and source.
; Every other optional declaration stays part of the exact proposal identity.
(defn lwac-intention
    (focus action declaration lens before prediction alternatives unknown
     choice timeout)
    (intern_node LWAC-INTENTION
        (list focus action declaration lens before prediction alternatives
              unknown choice timeout (lwo-local-path))))
(defn lwac-intention? (cell) (lwo-category? cell LWAC-INTENTION))
(defn lwac-intention-focus (intent) (nth (node_children intent) 0))
(defn lwac-intention-action (intent) (nth (node_children intent) 1))
(defn lwac-intention-declaration (intent) (nth (node_children intent) 2))
(defn lwac-intention-lens (intent) (nth (node_children intent) 3))
(defn lwac-intention-before (intent) (nth (node_children intent) 4))
(defn lwac-intention-prediction (intent) (nth (node_children intent) 5))
(defn lwac-intention-alternatives (intent) (nth (node_children intent) 6))
(defn lwac-intention-unknown (intent) (nth (node_children intent) 7))
(defn lwac-intention-choice (intent) (nth (node_children intent) 8))
(defn lwac-intention-timeout (intent) (nth (node_children intent) 9))
(defn lwac-intention-path (intent) (nth (node_children intent) 10))

(defn lwac-intention-for-offer (offer)
    (if (eq (lwac-offer-valid? offer) 0) (lwo-none)
        (lwac-intention
            (lwac-offer-focus offer)
            (lwac-offer-action offer)
            (lwac-offer-declaration offer)
            (lwac-offer-lens offer)
            (lwac-offer-before offer)
            (lwac-offer-prediction offer)
            (lwac-offer-alternatives offer)
            (lwac-offer-unknown offer)
            (lwac-offer-choice offer)
            (lwac-offer-timeout offer))))

; children: exact offer, its active attributions
(defn lwac-offer-evidence-cell (offer attributions)
    (intern_node LWAC-OFFER-EVIDENCE (list offer attributions)))
(defn lwac-offer-evidence? (cell)
    (lwo-category? cell LWAC-OFFER-EVIDENCE))
(defn lwac-offer-evidence-offer (evidence)
    (nth (node_children evidence) 0))
(defn lwac-offer-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwac-collect-offers (world items focus field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (if (eq (lwac-offer? offer) 0)
                (lwac-collect-offers world (tail items) focus field)
                (if (eq (lwac-offer-valid? offer) 0)
                    (lwac-collect-offers world (tail items) focus field)
                    (if (node_eq (lwac-offer-focus offer) focus)
                        (if (eq (lwo-active? world offer) 1)
                            (lwac-collect-offers world (tail items) focus
                                (lwo-field-add field
                                    (lwac-offer-evidence-cell offer
                                        (lwo-active-attributions-for
                                            world offer))))
                            (lwac-collect-offers world (tail items)
                                focus field))
                        (lwac-collect-offers world (tail items)
                            focus field)))))))
(defn lwac-offers-for (world focus)
    (lwac-collect-offers world
        (lwo-field-items (lwo-world-cells world)) focus
        (lwo-empty-field)))

(defn lwac-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwac-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwac-intention-offer-evidence-items
    (items intention offers witnesses)
    (if (eq (len items) 0) (list offers witnesses)
        (do
            (let evidence (head items))
            (let offer (lwac-offer-evidence-offer evidence))
            (let next-intention (lwac-intention-for-offer offer))
            (if (node_eq next-intention intention)
                (lwac-intention-offer-evidence-items (tail items) intention
                    (lwo-field-add offers evidence)
                    (lwac-field-union-items
                        (lwo-field-items
                            (lwac-offer-evidence-attributions evidence))
                        witnesses))
                (lwac-intention-offer-evidence-items (tail items) intention
                    offers witnesses)))))

; children: exact intention, matching offer evidence, offer attributions
(defn lwac-intention-evidence (intention offers witnesses)
    (intern_node LWAC-INTENTION-EVIDENCE
        (list intention offers witnesses)))
(defn lwac-intention-evidence? (cell)
    (lwo-category? cell LWAC-INTENTION-EVIDENCE))
(defn lwac-intention-evidence-intention (evidence)
    (nth (node_children evidence) 0))
(defn lwac-intention-evidence-offers (evidence)
    (nth (node_children evidence) 1))
(defn lwac-intention-evidence-witnesses (evidence)
    (nth (node_children evidence) 2))

(defn lwac-evidence-for-intention (offer-items intention)
    (do
        (let pair
            (lwac-intention-offer-evidence-items offer-items intention
                (lwo-empty-field) (lwo-empty-field)))
        (lwac-intention-evidence intention (nth pair 0) (nth pair 1))))

(defn lwac-candidates-have-intention? (items intention)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwac-intention-evidence-intention (head items)) intention)
            1
            (lwac-candidates-have-intention? (tail items) intention))))

(defn lwac-collect-candidates (offer-items remaining candidates)
    (if (eq (len remaining) 0) candidates
        (do
            (let intention
                (lwac-intention-for-offer
                    (lwac-offer-evidence-offer (head remaining))))
            (if (eq (lwac-candidates-have-intention?
                        (lwo-field-items candidates) intention) 1)
                (lwac-collect-candidates offer-items (tail remaining)
                    candidates)
                (lwac-collect-candidates offer-items (tail remaining)
                    (lwo-field-add candidates
                        (lwac-evidence-for-intention
                            offer-items intention)))))))

(defn lwac-candidates-for (offers)
    (do
        (let items (lwo-field-items offers))
        (lwac-collect-candidates items items (lwo-empty-field))))

(defn lwac-intention-current? (world intention)
    (if (eq (lwac-intention? intention) 0) 0
        (if (or (node_eq (lwac-intention-focus intention) (lwo-none))
                (node_eq (lwac-intention-action intention) (lwo-none))) 0
            (if (eq (lwo-active? world
                        (lwac-intention-focus intention)) 0) 0
                (if (eq (lwo-active? world
                            (lwac-intention-action intention)) 0) 0
                    (if (eq (lwo-active? world
                                (lwac-intention-before intention)) 0) 0
                        (lwre-lens-current? world
                            (lwac-intention-declaration intention)
                            (lwac-intention-lens intention))))))))

(defn lwac-candidate-eligible? (world evidence threshold)
    (if (and (eq (lwac-intention-current? world
                       (lwac-intention-evidence-intention evidence)) 1)
             (ge (lwo-field-size
                     (lwac-intention-evidence-witnesses evidence))
                 threshold)) 1 0))

(defn lwac-eligible-items (world items threshold field)
    (if (eq (len items) 0) field
        (lwac-eligible-items world (tail items) threshold
            (if (eq (lwac-candidate-eligible?
                        world (head items) threshold) 1)
                (lwo-field-add field (head items)) field))))

(defn lwac-offered-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwac-offered-alternatives-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwac-offer-alternatives
                        (lwac-offer-evidence-offer (head items))))
                field))))
(defn lwac-offered-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwac-offer-unknown
                    (lwac-offer-evidence-offer (head items))))
            (lwac-offered-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))

(defn lwac-dependency-witnesses (world intention field)
    (do
        (let with-focus
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwac-intention-focus intention))) field))
        (let with-action
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwac-intention-action intention))) with-focus))
        (let with-declaration
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwac-intention-declaration intention))) with-action))
        (let with-recipe
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwlc-lens-payload
                            (lwac-intention-lens intention))))
                with-declaration))
        (lwac-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world
                    (lwac-intention-before intention))) with-recipe)))

(defn lwac-field-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let evidence (head items))
            (let with-offers
                (lwac-field-union-items
                    (lwo-field-items
                        (lwac-intention-evidence-witnesses evidence)) field))
            (lwac-field-witnesses-items world (tail items)
                (lwac-dependency-witnesses world
                    (lwac-intention-evidence-intention evidence)
                    with-offers)))))

(defn lwac-candidate-alternatives-items (items primary field)
    (if (eq (len items) 0) field
        (lwac-candidate-alternatives-items (tail items) primary
            (if (node_eq (head items) primary) field
                (lwo-field-add field (head items))))))

(defn lwac-unresolved (focus candidates threshold)
    (intern_node LWAC-UNRESOLVED
        (list focus candidates (intern_trivial_int threshold)
              (lwo-local-path))))

; children: focus, READY/OPEN, optional primary intention evidence, every
; candidate, alternatives, offered unknowns, optional derived unknown,
; witnesses, threshold, local path
(defn lwac-field
    (focus status primary candidates alternatives unknowns derived-unknown
     witnesses threshold)
    (intern_node LWAC-FIELD
        (list focus status primary candidates alternatives unknowns
              derived-unknown witnesses (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwac-field? (cell) (lwo-category? cell LWAC-FIELD))
(defn lwac-field-focus (field) (nth (node_children field) 0))
(defn lwac-field-status (field) (nth (node_children field) 1))
(defn lwac-field-primary (field) (nth (node_children field) 2))
(defn lwac-field-candidates (field) (nth (node_children field) 3))
(defn lwac-field-alternatives (field) (nth (node_children field) 4))
(defn lwac-field-unknowns (field) (nth (node_children field) 5))
(defn lwac-field-derived-unknown (field) (nth (node_children field) 6))
(defn lwac-field-witnesses (field) (nth (node_children field) 7))
(defn lwac-field-threshold-cell (field) (nth (node_children field) 8))
(defn lwac-field-threshold (field)
    (node_value (lwac-field-threshold-cell field)))
(defn lwac-field-path (field) (nth (node_children field) 9))

(defn lwac-field-for (world focus threshold)
    (do
        (let offers (lwac-offers-for world focus))
        (let offer-items (lwo-field-items offers))
        (let candidates (lwac-candidates-for offers))
        (let candidate-items (lwo-field-items candidates))
        (let eligible
            (lwac-eligible-items world candidate-items threshold
                (lwo-empty-field)))
        (let eligible-items (lwo-field-items eligible))
        (let ready (if (eq (len eligible-items) 1) 1 0))
        (let primary
            (if (eq ready 1) (head eligible-items) (lwo-none)))
        (let offered-alternatives
            (lwac-offered-alternatives-items offer-items
                (lwo-empty-field)))
        (let alternatives
            (lwac-candidate-alternatives-items candidate-items primary
                offered-alternatives))
        (let unknowns
            (lwac-offered-unknowns-items offer-items (lwo-empty-field)))
        (let derived-unknown
            (if (eq ready 1) (lwo-none)
                (lwlc-unknown
                    (lwac-unresolved focus candidates threshold))))
        (let witnesses
            (lwac-field-witnesses-items world candidate-items
                (lwo-empty-field)))
        (lwac-field focus
            (if (eq ready 1) (lwac-ready) (lwac-open))
            primary candidates alternatives unknowns derived-unknown
            witnesses threshold)))

(defn lwac-selection-origin (focus threshold)
    (intern_node LWAC-SELECTION-ORIGIN
        (list focus (intern_trivial_int threshold) (lwo-local-path))))

(defn lwac-selection-proposal (world focus threshold)
    (do
        (let field (lwac-field-for world focus threshold))
        (if (eq (lwac-ready? (lwac-field-status field)) 0) (lwo-none)
            (do
                (let witnesses (lwac-field-witnesses field))
                (let count (lwo-field-size witnesses))
                (let origin (lwac-selection-origin focus threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwac-selection-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwac-field? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwac-selection-candidate-current? (world candidate)
    (if (eq (lwac-selection-candidate? candidate) 0) 0
        (do
            (let field (lwo-emergent-shape candidate))
            (let current
                (lwac-field-for world (lwac-field-focus field)
                    (lwac-field-threshold field)))
            (if (and (eq (lwac-ready? (lwac-field-status current)) 1)
                     (and (node_eq field current)
                          (node_eq (lwo-emergent-witnesses candidate)
                              (lwac-field-witnesses current)))) 1 0))))
(defn lwac-selection-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwac-selection-candidate-current?
                    world candidate) 1)) 1 0))
(defn lwac-selection-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwac-selection-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwac-selection-integrate (round proposal action)
    (if (eq (lwac-selection-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- local execution and observed delta ---------------------------------

(defn lwac-flow (selection intention)
    (intern_node LWAC-FLOW
        (list selection intention (lwac-intention-focus intention)
              (lwac-intention-action intention)
              (lwac-intention-declaration intention)
              (lwac-intention-lens intention)
              (lwac-intention-before intention)
              (lwo-local-path))))
(defn lwac-flow? (cell) (lwo-category? cell LWAC-FLOW))

(defn lwac-trace-for (world selection evidence)
    (if (eq (lwac-selection-integrated-current?
                world selection) 0) (lwo-none)
        (do
            (let field (lwo-emergent-shape selection))
            (let primary (lwac-field-primary field))
            (let intention (lwac-intention-evidence-intention primary))
            (let flow (lwac-flow selection intention))
            (let first
                (lwre-execute world
                    (lwac-intention-declaration intention)
                    (lwac-intention-lens intention)
                    (lwac-intention-before intention)
                    (lwo-empty-field) (lwo-none)
                    (lwac-intention-choice intention)
                    flow (lwo-none) evidence))
            (if (node_eq first (lwo-none)) (lwo-none)
                (do
                    (let delta
                        (lwac-delta
                            (lwre-trace-before first)
                            (lwre-result-primary
                                (lwre-trace-result first))
                            (lwre-trace-lens first)))
                    (lwre-execute world
                        (lwac-intention-declaration intention)
                        (lwac-intention-lens intention)
                        (lwac-intention-before intention)
                        (lwo-empty-field) (lwo-none)
                        (lwac-intention-choice intention)
                        flow delta evidence))))))

(defn lwac-comparison (prediction actual evidence)
    (if (node_eq prediction (lwo-none)) (oac-node actual)
        (if (node_eq prediction actual) (oac-one actual)
            (oac-alternative-ack prediction actual evidence))))

(defn lwac-time-observation (intention observed-time)
    (do
        (let timeout (lwac-intention-timeout intention))
        (if (or (node_eq timeout (lwo-none))
                (node_eq observed-time (lwo-none)))
            (lwo-none)
            (oac-timeout-condense timeout observed-time))))

; children: integrated selection, exact intention, native trace, optional
; prediction, derived actual delta, immediate comparison ack, optional observed
; time, optional timeout pending/outcome, retained alternatives, offered
; unknowns, evidence, local path
(defn lwac-execution
    (selection intention trace prediction actual comparison observed-time
     time-observation alternatives unknowns evidence)
    (intern_node LWAC-EXECUTION
        (list selection intention trace prediction actual comparison
              observed-time time-observation alternatives unknowns evidence
              (lwo-local-path))))
(defn lwac-execution? (cell) (lwo-category? cell LWAC-EXECUTION))
(defn lwac-execution-selection (execution) (nth (node_children execution) 0))
(defn lwac-execution-intention (execution) (nth (node_children execution) 1))
(defn lwac-execution-trace (execution) (nth (node_children execution) 2))
(defn lwac-execution-prediction (execution) (nth (node_children execution) 3))
(defn lwac-execution-actual (execution) (nth (node_children execution) 4))
(defn lwac-execution-comparison (execution) (nth (node_children execution) 5))
(defn lwac-execution-observed-time (execution)
    (nth (node_children execution) 6))
(defn lwac-execution-time-observation (execution)
    (nth (node_children execution) 7))
(defn lwac-execution-alternatives (execution)
    (nth (node_children execution) 8))
(defn lwac-execution-unknowns (execution) (nth (node_children execution) 9))
(defn lwac-execution-evidence (execution) (nth (node_children execution) 10))
(defn lwac-execution-path (execution) (nth (node_children execution) 11))

(defn lwac-execution-for (world selection observed-time evidence)
    (do
        (let trace (lwac-trace-for world selection evidence))
        (if (node_eq trace (lwo-none)) (lwo-none)
            (do
                (let field (lwo-emergent-shape selection))
                (let primary (lwac-field-primary field))
                (let intention (lwac-intention-evidence-intention primary))
                (let actual (lwre-trace-changes trace))
                (let prediction (lwac-intention-prediction intention))
                (lwac-execution selection intention trace prediction actual
                    (lwac-comparison prediction actual evidence)
                    observed-time
                    (lwac-time-observation intention observed-time)
                    (lwac-field-alternatives field)
                    (lwac-field-unknowns field) evidence)))))

(defn lwac-execution-current? (world execution)
    (if (eq (lwac-execution? execution) 0) 0
        (if (node_eq execution
                (lwac-execution-for world
                    (lwac-execution-selection execution)
                    (lwac-execution-observed-time execution)
                    (lwac-execution-evidence execution))) 1 0)))

(defn lwac-execution-witnesses (world execution)
    (do
        (let with-selection
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwac-execution-selection execution)))
                (lwo-empty-field)))
        (lwac-field-union-items
            (lwo-field-items
                (lwre-trace-witnesses
                    (lwac-execution-trace execution)))
            with-selection)))

(defn lwac-execution-origin (execution)
    (intern_node LWAC-EXECUTION-ORIGIN
        (list execution (lwo-local-path))))
(defn lwac-execution-proposal (world selection observed-time evidence)
    (do
        (let execution
            (lwac-execution-for world selection observed-time evidence))
        (if (node_eq execution (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwac-execution-witnesses world execution))
                (let count (lwo-field-size witnesses))
                (let origin (lwac-execution-origin execution))
                (let candidate
                    (lwo-emergent execution witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwac-execution-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwac-execution?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwac-execution-candidate-current? (world candidate)
    (if (eq (lwac-execution-candidate? candidate) 0) 0
        (do
            (let execution (lwo-emergent-shape candidate))
            (let current
                (lwac-execution-for world
                    (lwac-execution-selection execution)
                    (lwac-execution-observed-time execution)
                    (lwac-execution-evidence execution)))
            (if (and (node_eq execution current)
                     (node_eq (lwo-emergent-witnesses candidate)
                         (lwac-execution-witnesses world current))) 1 0))))
(defn lwac-execution-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwac-execution-candidate-current?
                    world candidate) 1)) 1 0))
(defn lwac-execution-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwac-execution-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwac-execution-integrate (round proposal action)
    (if (eq (lwac-execution-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- independently offered observation and revision ----------------------

; children: integrated execution candidate, optional observed delta, exact
; acknowledgment, alternatives, optional unknown, optional timeout evidence,
; offered evidence, local path
(defn lwac-observation
    (execution observed ack alternatives unknown time-observation evidence)
    (intern_node LWAC-OBSERVATION
        (list execution observed ack alternatives unknown time-observation
              evidence (lwo-local-path))))
(defn lwac-observation? (cell) (lwo-category? cell LWAC-OBSERVATION))
(defn lwac-observation-execution (observation)
    (nth (node_children observation) 0))
(defn lwac-observation-observed (observation)
    (nth (node_children observation) 1))
(defn lwac-observation-ack (observation) (nth (node_children observation) 2))
(defn lwac-observation-alternatives (observation)
    (nth (node_children observation) 3))
(defn lwac-observation-unknown (observation)
    (nth (node_children observation) 4))
(defn lwac-observation-time (observation)
    (nth (node_children observation) 5))
(defn lwac-observation-evidence (observation)
    (nth (node_children observation) 6))
(defn lwac-observation-path (observation) (nth (node_children observation) 7))

(defn lwac-optional-time-observation-valid? (observation)
    (if (or (node_eq observation (lwo-none))
            (or (eq (oac-time-pending? observation) 1)
                (eq (oac-time-outcome? observation) 1))) 1 0))

(defn lwac-observation-ack-coherent? (observation)
    (do
        (let ack (lwac-observation-ack observation))
        (let observed (lwac-observation-observed observation))
        (let execution
            (lwo-emergent-shape
                (lwac-observation-execution observation)))
        (let actual (lwac-execution-actual execution))
        (if (eq (oac-one? ack) 1)
            (if (and (node_eq observed actual)
                     (node_eq (oac-payload ack) actual)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (not (node_eq observed (lwo-none)))
                         (not (node_eq observed actual))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (do
                            (let alternative (oac-payload ack))
                            (if (and (node_eq
                                      (oac-alternative-reference alternative)
                                      actual)
                                     (and (node_eq
                                      (oac-alternative-offered alternative)
                                      observed)
                                      (eq (lwac-delta? observed) 1))) 1 0))
                        (if (and (eq (oac-node? ack) 1)
                                 (and (node_eq (oac-payload ack) observed)
                                      (eq (lwac-delta? observed) 1))) 1 0)))))))

(defn lwac-observation-valid? (observation)
    (if (eq (lwac-observation? observation) 0) 0
        (if (eq (lwac-execution-candidate?
                    (lwac-observation-execution observation)) 0) 0
            (if (eq (lwo-category?
                        (lwac-observation-alternatives observation)
                        LWO-FIELD) 0) 0
                (if (eq (lwac-optional-unknown-valid?
                            (lwac-observation-unknown observation)) 0) 0
                    (if (eq (lwac-optional-time-observation-valid?
                                (lwac-observation-time observation)) 0) 0
                        (lwac-observation-ack-coherent? observation)))))))

(defn lwac-independent-observation-attributions-items
    (world items execution field)
    (if (eq (len items) 0) field
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwac-independent-observation-attributions-items
                world (tail items) execution
                (if (eq (lwo-active-by? world execution source) 1) field
                    (lwo-field-add field attribution))))))

(defn lwac-independent-observation-attributions (world observation)
    (lwac-independent-observation-attributions-items world
        (lwo-field-items
            (lwo-active-attributions-for world observation))
        (lwac-observation-execution observation) (lwo-empty-field)))

(defn lwac-learning-alternatives (execution observation)
    (lwac-field-union-items
        (lwo-field-items (lwac-observation-alternatives observation))
        (lwac-execution-alternatives execution)))

(defn lwac-learning-unknowns (execution observation)
    (do
        (let unknown (lwac-observation-unknown observation))
        (if (node_eq unknown (lwo-none))
            (lwac-execution-unknowns execution)
            (lwo-field-add (lwac-execution-unknowns execution) unknown))))

; children: original intention, old optional prediction, newly observed delta,
; execution, observation, local path
(defn lwac-revision (intention prior proposed execution observation)
    (intern_node LWAC-REVISION
        (list intention prior proposed execution observation
              (lwo-local-path))))
(defn lwac-revision? (cell) (lwo-category? cell LWAC-REVISION))
(defn lwac-revision-intention (revision) (nth (node_children revision) 0))
(defn lwac-revision-prior (revision) (nth (node_children revision) 1))
(defn lwac-revision-proposed (revision) (nth (node_children revision) 2))
(defn lwac-revision-execution (revision) (nth (node_children revision) 3))
(defn lwac-revision-observation (revision) (nth (node_children revision) 4))
(defn lwac-revision-path (revision) (nth (node_children revision) 5))

; children: execution candidate, observation, state, optional revision,
; alternatives, unknowns, optional timeout evidence, local path
(defn lwac-learning
    (execution observation state revision alternatives unknowns time-observation)
    (intern_node LWAC-LEARNING
        (list execution observation state revision alternatives unknowns
              time-observation (lwo-local-path))))
(defn lwac-learning? (cell) (lwo-category? cell LWAC-LEARNING))
(defn lwac-learning-execution (learning) (nth (node_children learning) 0))
(defn lwac-learning-observation (learning) (nth (node_children learning) 1))
(defn lwac-learning-state (learning) (nth (node_children learning) 2))
(defn lwac-learning-revision (learning) (nth (node_children learning) 3))
(defn lwac-learning-alternative-field (learning)
    (nth (node_children learning) 4))
(defn lwac-learning-unknowns-field (learning)
    (nth (node_children learning) 5))
(defn lwac-learning-time (learning) (nth (node_children learning) 6))
(defn lwac-learning-path (learning) (nth (node_children learning) 7))

(defn lwac-learning-for (world observation threshold)
    (if (eq (lwac-observation-valid? observation) 0) (lwo-none)
        (do
            (let execution-candidate
                (lwac-observation-execution observation))
            (if (eq (lwac-execution-integrated-current?
                        world execution-candidate) 0) (lwo-none)
                (do
                    (let observer-witnesses
                        (lwac-independent-observation-attributions
                            world observation))
                    (if (lt (lwo-field-size observer-witnesses) threshold)
                        (lwo-none)
                        (do
                            (let execution
                                (lwo-emergent-shape execution-candidate))
                            (let ack (lwac-observation-ack observation))
                            (let comparison
                                (lwac-execution-comparison execution))
                            (let state
                                (if (eq (oac-nothing? ack) 1) (lwac-wait)
                                    (if (or
                                          (eq (oac-alternative-ack?
                                                comparison) 1)
                                          (or (eq (oac-zero? ack) 1)
                                              (eq (oac-alternative-ack?
                                                    ack) 1)))
                                        (lwac-revise)
                                        (if (eq (oac-one? ack) 1)
                                            (lwac-confirm)
                                            (lwac-node-return)))))
                            (let revision
                                (if (eq (lwac-revise? state) 0) (lwo-none)
                                    (lwac-revision
                                        (lwac-execution-intention execution)
                                        (lwac-execution-prediction execution)
                                        (if (node_eq
                                                (lwac-observation-observed
                                                    observation)
                                                (lwo-none))
                                            (lwac-execution-actual execution)
                                            (lwac-observation-observed
                                                observation))
                                        execution observation)))
                            (lwac-learning execution-candidate observation
                                state revision
                                (lwac-learning-alternatives
                                    execution observation)
                                (lwac-learning-unknowns execution observation)
                                (lwac-observation-time observation)))))))))

(defn lwac-learning-witnesses (world observation)
    (lwac-field-union-items
        (lwo-field-items
            (lwac-independent-observation-attributions world observation))
        (lwo-active-attributions-for world
            (lwac-observation-execution observation))))

(defn lwac-learning-origin (observation threshold)
    (intern_node LWAC-LEARNING-ORIGIN
        (list observation (intern_trivial_int threshold)
              (lwo-local-path))))

(defn lwac-learning-proposal (world observation threshold)
    (do
        (let learning (lwac-learning-for world observation threshold))
        (if (node_eq learning (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwac-learning-witnesses world observation))
                (let count (lwo-field-size witnesses))
                (let origin (lwac-learning-origin observation threshold))
                (let candidate
                    (lwo-emergent learning witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwac-learning-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwac-learning?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwac-learning-threshold (proposal)
    (node_value
        (nth (node_children (lwt-proposal-origin proposal)) 1)))
(defn lwac-learning-candidate-current? (world candidate threshold)
    (if (eq (lwac-learning-candidate? candidate) 0) 0
        (do
            (let learning (lwo-emergent-shape candidate))
            (let observation (lwac-learning-observation learning))
            (let current (lwac-learning-for world observation threshold))
            (if (and (node_eq learning current)
                     (node_eq (lwo-emergent-witnesses candidate)
                         (lwac-learning-witnesses world observation))) 1 0))))
(defn lwac-learning-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwac-learning-candidate-current? world
            (lwt-proposal-candidate proposal)
            (lwac-learning-threshold proposal))))
(defn lwac-learning-integrated-current? (world candidate threshold)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwac-learning-candidate-current?
                    world candidate threshold) 1)) 1 0))
(defn lwac-learning-integrate (round proposal action)
    (if (eq (lwac-learning-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; An integrated revision can describe the next exact offer, but does not add
; it to the world. A participant must still offer this cell through a membrane.
(defn lwac-successor-offer (world learning-candidate threshold)
    (if (eq (lwac-learning-integrated-current?
                world learning-candidate threshold) 0) (lwo-none)
        (do
            (let learning (lwo-emergent-shape learning-candidate))
            (let revision (lwac-learning-revision learning))
            (if (eq (lwac-revision? revision) 0) (lwo-none)
                (do
                    (let intention (lwac-revision-intention revision))
                    (lwac-offer
                        (lwac-intention-focus intention)
                        (lwac-intention-action intention)
                        (lwac-intention-declaration intention)
                        (lwac-intention-lens intention)
                        (lwac-intention-before intention)
                        (lwac-revision-proposed revision)
                        (lwac-intention-alternatives intention)
                        (lwac-intention-unknown intention)
                        (lwac-intention-choice intention)
                        (lwac-intention-timeout intention)
                        learning-candidate))))))

0
