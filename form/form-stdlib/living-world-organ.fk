; living-world-organ.fk -- an axiom-born, ontology-open world organ.
;
; This is the first executable membrane of the living world-model goal.  It
; imposes only structural envelopes required by the five core axioms: a field,
; a world-state, an offer, an attribution, a relation, a revocation, a question,
; an answer, and an observable boundary event.  The kinds, names, predicates,
; and compositions carried through those envelopes are offered cells.  This
; file contains no domain taxonomy and no remote-oracle route.
;
; Present shape is identity: every durable value is intern_node tissue.  A
; changed world is a new NodeID and the prior world remains reachable.  Shared
; meaning is not ownership transfer: each accepted (source,payload) pair mints
; its own attribution.  A source may revoke only its own attribution; the same
; payload remains active while any other unrevoked attribution holds it.
;
; Relations are hypotheses, never overwritten truths.  Relations sharing a
; subject and predicate but carrying different objects are both retained and
; produce a content-addressed contradiction event.  Answers return every
; active relation plus the active attributions that derive it; absence is the
; first-class NOTHING ack.  The answer path is pure Form tissue and performs no
; host I/O or network call.
;
; Emergence is represented without a fixed concept vocabulary: any offered
; shape can be proposed with a content-addressed witness field, coherence and
; resonance readings, and an offered threshold.  Readiness means only that the
; stated evidence satisfies the stated threshold; it grants no authority.
;
; Honest floor: this membrane does not yet discover candidate shapes from a
; stream by itself, persist a world between processes, or generate natural
; language.  It makes those future movements able to enter without replacing
; consent, uncertainty, provenance, contradiction, or reversibility.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk

(let LWO-FIELD         (bp "LWO-FIELD"))
(let LWO-WORLD         (bp "LWO-WORLD"))
(let LWO-OFFER         (bp "LWO-OFFER"))
(let LWO-TRANSITION    (bp "LWO-TRANSITION"))
(let LWO-ATTRIBUTION   (bp "LWO-ATTRIBUTION"))
(let LWO-RELATION      (bp "LWO-RELATION"))
(let LWO-REVOCATION    (bp "LWO-REVOCATION"))
(let LWO-QUESTION      (bp "LWO-QUESTION"))
(let LWO-DERIVATION    (bp "LWO-DERIVATION"))
(let LWO-ANSWER        (bp "LWO-ANSWER"))
(let LWO-BOUNDARY      (bp "LWO-BOUNDARY"))
(let LWO-CONTRADICTION (bp "LWO-CONTRADICTION"))
(let LWO-SILENCE       (bp "LWO-SILENCE"))
(let LWO-EMERGENT      (bp "LWO-EMERGENT"))
(let LWO-LOCAL-PATH    (bp "LWO-LOCAL-PATH"))
(let LWO-NONE          (bp "LWO-NONE"))

; --- generic content-addressed fields ------------------------------------
(defn lwo-field (items) (intern_node LWO-FIELD items))
(defn lwo-empty-field () (lwo-field (empty)))
(defn lwo-field-items (field) (node_children field))

(defn lwo-member? (items wanted)
    (if (eq (len items) 0) 0
        (if (node_eq (head items) wanted) 1
            (lwo-member? (tail items) wanted))))

(defn lwo-field-has? (field wanted)
    (lwo-member? (lwo-field-items field) wanted))

(defn lwo-field-add (field value)
    (if (eq (lwo-field-has? field value) 1) field
        (lwo-field (cons value (lwo-field-items field)))))

(defn lwo-field-size (field) (len (lwo-field-items field)))

; Any blueprint cell may be supplied by an offering cell.  The organ does not
; enumerate concept kinds; it only performs the kernel's native composition.
(defn lwo-compose (kind children) (intern_node kind children))

(defn lwo-none () (intern_node LWO-NONE (empty)))
(defn lwo-local-path () (intern_node LWO-LOCAL-PATH (empty)))

(defn lwo-category? (node category)
    (if (node_eq (node_category node) category) 1 0))

; --- world state ----------------------------------------------------------
; children: cells, relations, attributions, revocations, events
(defn lwo-world (cells relations attributions revocations events)
    (intern_node LWO-WORLD
        (list cells relations attributions revocations events)))

(defn lwo-empty-world ()
    (lwo-world (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
               (lwo-empty-field) (lwo-empty-field)))

(defn lwo-world-cells        (world) (nth (node_children world) 0))
(defn lwo-world-relations    (world) (nth (node_children world) 1))
(defn lwo-world-attributions (world) (nth (node_children world) 2))
(defn lwo-world-revocations  (world) (nth (node_children world) 3))
(defn lwo-world-events       (world) (nth (node_children world) 4))

(defn lwo-world-has? (world cell)
    (lwo-field-has? (lwo-world-cells world) cell))

; --- interface, offer, and transition ------------------------------------
; Interface actions are offered cells, not a closed mode enumeration.
(defn lwo-interface (actions) (lwo-field actions))

; children: source, interface, explicit-consent, payload, provenance, receipt
(defn lwo-offer (source interface explicit-consent payload provenance receipt)
    (intern_node LWO-OFFER
        (list source interface (intern_trivial_int explicit-consent)
              payload provenance (intern_trivial_int receipt))))

(defn lwo-offer-source     (offer) (nth (node_children offer) 0))
(defn lwo-offer-interface  (offer) (nth (node_children offer) 1))
(defn lwo-offer-consent    (offer) (node_value (nth (node_children offer) 2)))
(defn lwo-offer-payload    (offer) (nth (node_children offer) 3))
(defn lwo-offer-provenance (offer) (nth (node_children offer) 4))
(defn lwo-offer-receipt    (offer) (node_value (nth (node_children offer) 5)))

(defn lwo-offer-valid? (offer action)
    (if (and (eq (lwo-offer-consent offer) 1)
             (and (eq (lwo-offer-receipt offer) 1)
                  (eq (lwo-field-has? (lwo-offer-interface offer) action) 1)))
        1 0))

(defn lwo-transition (world ack)
    (intern_node LWO-TRANSITION (list world ack)))
(defn lwo-transition-world (transition) (nth (node_children transition) 0))
(defn lwo-transition-ack   (transition) (nth (node_children transition) 1))

; --- attribution and revocation ------------------------------------------
(defn lwo-attribution (payload source provenance)
    (intern_node LWO-ATTRIBUTION (list payload source provenance)))
(defn lwo-attribution-payload (attribution) (nth (node_children attribution) 0))
(defn lwo-attribution-source  (attribution) (nth (node_children attribution) 1))

(defn lwo-revocation (target source reason provenance)
    (intern_node LWO-REVOCATION (list target source reason provenance)))
(defn lwo-revocation-target (revocation) (nth (node_children revocation) 0))
(defn lwo-revocation-source (revocation) (nth (node_children revocation) 1))

(defn lwo-attribution-matches? (attribution payload source)
    (if (and (node_eq (lwo-attribution-payload attribution) payload)
             (node_eq (lwo-attribution-source attribution) source)) 1 0))

(defn lwo-owned-by-items? (items payload source)
    (if (eq (len items) 0) 0
        (if (eq (lwo-attribution-matches? (head items) payload source) 1) 1
            (lwo-owned-by-items? (tail items) payload source))))

(defn lwo-owned-by? (world payload source)
    (lwo-owned-by-items? (lwo-field-items (lwo-world-attributions world))
                         payload source))

(defn lwo-revokes? (revocation payload source)
    (if (and (node_eq (lwo-revocation-target revocation) payload)
             (node_eq (lwo-revocation-source revocation) source)) 1 0))

(defn lwo-revoked-by-items? (items payload source)
    (if (eq (len items) 0) 0
        (if (eq (lwo-revokes? (head items) payload source) 1) 1
            (lwo-revoked-by-items? (tail items) payload source))))

(defn lwo-attribution-revoked? (world payload source)
    (lwo-revoked-by-items? (lwo-field-items (lwo-world-revocations world))
                           payload source))

(defn lwo-active-by? (world payload source)
    (if (and (eq (lwo-owned-by? world payload source) 1)
             (eq (lwo-attribution-revoked? world payload source) 0)) 1 0))

(defn lwo-active-attribution? (world attribution)
    (lwo-active-by? world
        (lwo-attribution-payload attribution)
        (lwo-attribution-source attribution)))

(defn lwo-active-payload-items? (world items payload)
    (if (eq (len items) 0) 0
        (do (let attribution (head items))
            (if (and (node_eq (lwo-attribution-payload attribution) payload)
                     (eq (lwo-active-attribution? world attribution) 1)) 1
                (lwo-active-payload-items? world (tail items) payload)))))

(defn lwo-active? (world payload)
    (lwo-active-payload-items? world
        (lwo-field-items (lwo-world-attributions world)) payload))

; --- hypotheses, contradiction, and derivation ---------------------------
; subject, predicate, object, evidence, coherence, resonance, uncertainty,
; provenance are all offered cells.  The organ grants none of them truth.
(defn lwo-relation
    (subject predicate object evidence coherence resonance uncertainty provenance)
    (intern_node LWO-RELATION
        (list subject predicate object evidence coherence resonance uncertainty provenance)))

(defn lwo-relation-subject   (relation) (nth (node_children relation) 0))
(defn lwo-relation-predicate (relation) (nth (node_children relation) 1))
(defn lwo-relation-object    (relation) (nth (node_children relation) 2))

(defn lwo-relation? (cell) (lwo-category? cell LWO-RELATION))
(defn lwo-revocation? (cell) (lwo-category? cell LWO-REVOCATION))

(defn lwo-relations-conflict? (a b)
    (if (and (node_eq (lwo-relation-subject a) (lwo-relation-subject b))
             (and (node_eq (lwo-relation-predicate a) (lwo-relation-predicate b))
                  (not (node_eq (lwo-relation-object a) (lwo-relation-object b)))))
        1 0))

(defn lwo-contradiction (existing arriving)
    (intern_node LWO-CONTRADICTION (list existing arriving)))

(defn lwo-add-contradictions (world items arriving events)
    (if (eq (len items) 0) events
        (do (let existing (head items))
            (let next-events
                (if (and (eq (lwo-active? world existing) 1)
                         (eq (lwo-relations-conflict? existing arriving) 1))
                    (lwo-field-add events
                        (lwo-contradiction existing arriving))
                    events))
            (lwo-add-contradictions world (tail items) arriving next-events))))

(defn lwo-boundary-event (source action ack)
    (intern_node LWO-BOUNDARY (list source action ack)))

(defn lwo-accept-normal (world offer action)
    (do
        (let payload (lwo-offer-payload offer))
        (let source (lwo-offer-source offer))
        (let ack (oac-one payload))
        (let attribution
            (lwo-attribution payload source (lwo-offer-provenance offer)))
        (let next-cells (lwo-field-add (lwo-world-cells world) payload))
        (let next-attributions
            (lwo-field-add (lwo-world-attributions world) attribution))
        (let next-relations
            (if (eq (lwo-relation? payload) 1)
                (lwo-field-add (lwo-world-relations world) payload)
                (lwo-world-relations world)))
        (let next-events
            (lwo-field-add (lwo-world-events world)
                (lwo-boundary-event source action ack)))
        (let final-events
            (if (eq (lwo-relation? payload) 1)
                (lwo-add-contradictions world
                    (lwo-field-items (lwo-world-relations world))
                    payload next-events)
                next-events))
        (lwo-transition
            (lwo-world next-cells next-relations next-attributions
                       (lwo-world-revocations world) final-events)
            ack)))

(defn lwo-accept-revocation (world offer action)
    (do
        (let revocation (lwo-offer-payload offer))
        (let source (lwo-offer-source offer))
        (let target (lwo-revocation-target revocation))
        (if (and (node_eq source (lwo-revocation-source revocation))
                 (eq (lwo-owned-by? world target source) 1))
            (do
                (let ack (oac-one revocation))
                (let events
                    (lwo-field-add (lwo-world-events world)
                        (lwo-boundary-event source action ack)))
                (lwo-transition
                    (lwo-world (lwo-world-cells world)
                               (lwo-world-relations world)
                               (lwo-world-attributions world)
                               (lwo-field-add (lwo-world-revocations world) revocation)
                               events)
                    ack))
            (lwo-transition
                (lwo-world (lwo-world-cells world)
                           (lwo-world-relations world)
                           (lwo-world-attributions world)
                           (lwo-world-revocations world)
                           (lwo-field-add (lwo-world-events world)
                               ; Refusal is observable, but the unaccepted
                               ; source/payload do not cross the membrane.
                               (lwo-boundary-event (lwo-none) action (oac-zero))))
                (oac-zero)))))

(defn lwo-receive (world offer action)
    (if (eq (lwo-offer-valid? offer action) 0)
        (lwo-transition
            (lwo-world (lwo-world-cells world)
                       (lwo-world-relations world)
                       (lwo-world-attributions world)
                       (lwo-world-revocations world)
                       (lwo-field-add (lwo-world-events world)
                           ; Invalid offers leave only a content-blind boundary
                           ; event.  Neither source identity nor payload enters.
                           (lwo-boundary-event (lwo-none)
                                               action (oac-zero))))
            (oac-zero))
        (if (eq (lwo-revocation? (lwo-offer-payload offer)) 1)
            (lwo-accept-revocation world offer action)
            (lwo-accept-normal world offer action))))

; Silence is observable without inventing content for the silent cell.
(defn lwo-silence (world)
    (do
        (let silence (intern_node LWO-SILENCE (list (oac-nothing))))
        (lwo-transition
            (lwo-world (lwo-world-cells world)
                       (lwo-world-relations world)
                       (lwo-world-attributions world)
                       (lwo-world-revocations world)
                       (lwo-field-add (lwo-world-events world) silence))
            (oac-nothing))))

; --- ontology-open question and answer -----------------------------------
(defn lwo-question (focus) (intern_node LWO-QUESTION (list focus)))
(defn lwo-question-focus (question) (nth (node_children question) 0))

(defn lwo-active-attributions-for-items (world items payload acc)
    (if (eq (len items) 0) acc
        (do (let attribution (head items))
            (if (and (node_eq (lwo-attribution-payload attribution) payload)
                     (eq (lwo-active-attribution? world attribution) 1))
                (lwo-active-attributions-for-items world (tail items) payload
                    (lwo-field-add acc attribution))
                (lwo-active-attributions-for-items world (tail items) payload acc)))))

(defn lwo-active-attributions-for (world payload)
    (lwo-active-attributions-for-items world
        (lwo-field-items (lwo-world-attributions world)) payload
        (lwo-empty-field)))

(defn lwo-derivation (relation attributions)
    (intern_node LWO-DERIVATION (list relation attributions)))

(defn lwo-derive-items (world items focus acc)
    (if (eq (len items) 0) acc
        (do (let relation (head items))
            (if (and (node_eq (lwo-relation-subject relation) focus)
                     (eq (lwo-active? world relation) 1))
                (lwo-derive-items world (tail items) focus
                    (lwo-field-add acc
                        (lwo-derivation relation
                            (lwo-active-attributions-for world relation))))
                (lwo-derive-items world (tail items) focus acc)))))

(defn lwo-answer (world question)
    (do
        (let derivations
            (lwo-derive-items world
                (lwo-field-items (lwo-world-relations world))
                (lwo-question-focus question) (lwo-empty-field)))
        (let ack
            (if (eq (lwo-field-size derivations) 0)
                (oac-nothing)
                (oac-node derivations)))
        (intern_node LWO-ANSWER
            (list question derivations ack (lwo-local-path)))))

(defn lwo-answer-question    (answer) (nth (node_children answer) 0))
(defn lwo-answer-derivations (answer) (nth (node_children answer) 1))
(defn lwo-answer-ack         (answer) (nth (node_children answer) 2))
(defn lwo-answer-path        (answer) (nth (node_children answer) 3))

; --- evidence-bounded emergence ------------------------------------------
; The threshold and readings are supplied as cells.  Readiness is an evidence
; statement only; acceptance still requires an ordinary consented offer.
(defn lwo-emergent (shape witnesses coherence resonance threshold provenance)
    (intern_node LWO-EMERGENT
        (list shape witnesses coherence resonance threshold provenance)))

(defn lwo-emergent-shape     (candidate) (nth (node_children candidate) 0))
(defn lwo-emergent-witnesses (candidate) (nth (node_children candidate) 1))
(defn lwo-emergent-coherence (candidate) (node_value (nth (node_children candidate) 2)))
(defn lwo-emergent-resonance (candidate) (node_value (nth (node_children candidate) 3)))
(defn lwo-emergent-threshold (candidate) (node_value (nth (node_children candidate) 4)))
(defn lwo-emergent-provenance (candidate) (nth (node_children candidate) 5))

(defn lwo-all-active? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwo-witness-active? world (head items)) 1)
            (lwo-all-active? world (tail items)) 0)))

(defn lwo-witness-active? (world witness)
    (if (eq (lwo-category? witness LWO-ATTRIBUTION) 1)
        (lwo-active-attribution? world witness)
        (lwo-active? world witness)))

(defn lwo-emergent-ready? (world candidate)
    (if (and (ge (lwo-field-size (lwo-emergent-witnesses candidate))
                 (lwo-emergent-threshold candidate))
             (and (eq (lwo-all-active? world
                           (lwo-field-items (lwo-emergent-witnesses candidate))) 1)
                  (and (gt (lwo-emergent-coherence candidate) 0)
                       (gt (lwo-emergent-resonance candidate) 0)))) 1 0))

0
