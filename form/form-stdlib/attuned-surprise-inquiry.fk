; attuned-surprise-inquiry.fk — prediction outcomes enter inquiry without
; surprise becoming a sovereign rank.
;
; `active-inference.fk` is a specialized prediction-relation organ. It can say
; whether predicted and actual matched. `attuned-inquiry.fk` is the relational
; organ that hears edge, breath, mode, vitality, and grounding. This bridge
; composes them without letting prediction error choose a winner:
;
;   prediction relation -> one inspectable signal -> arrival-ordered braid
;
; Every event stays in the braid. Surprise is carried as a witnessed bit, not
; converted into a priority score. Vitality is supplied independently; a large
; mismatch cannot manufacture aliveness, and a matching event with living
; grounding can still move and become learning. Edge and breath keep their
; specialized authority: hold stays held, uncarried weight rests, and play
; remains admissible without surprise.
;
; Proven by:
; form-stdlib/tests/attuned-surprise-inquiry-band.fk (four-way; verdict 1023)
;
; preludes: form-stdlib/core.fk form-stdlib/form-freq-check.fk form-stdlib/active-inference.fk form-stdlib/attuned-inquiry.fk

(do
    ; event = id, grounding, vitality, mode, predicted, actual, edge, breath.
    ; Prediction is only one relation inside the offered movement.
    (defn asi-event
        (id grounding vitality mode predicted actual edge breath)
        (list id grounding vitality mode predicted actual edge breath))
    (defn asi-event-id (event) (nth event 0))
    (defn asi-event-grounding (event) (nth event 1))
    (defn asi-event-vitality (event) (nth event 2))
    (defn asi-event-mode (event) (nth event 3))
    (defn asi-event-predicted (event) (nth event 4))
    (defn asi-event-actual (event) (nth event 5))
    (defn asi-event-edge (event) (nth event 6))
    (defn asi-event-breath (event) (nth event 7))

    ; Delegate the prediction relation unchanged. This bridge adds no second
    ; surprise detector and never turns the result into an ordering weight.
    (defn asi-event-step (event)
        (list (asi-event-predicted event) (asi-event-actual event)))
    (defn asi-event-surprised? (event)
        (ai-surprised? (asi-event-step event)))

    ; Vitality, edge, breath, and mode remain independent of surprise.
    (defn asi-event-inquiry (event)
        (ati-inquiry
            (asi-event-id event)
            (asi-event-grounding event)
            (asi-event-vitality event)
            (asi-event-mode event)
            (asi-event-edge event)
            (asi-event-breath event)))

    ; signal = tag, id, predicted, actual, surprise-bit, attuned movement.
    ; Both sides of the prediction relation stay inspectable.
    (defn asi-signal (event)
        (list "asi-signal"
              (asi-event-id event)
              (asi-event-predicted event)
              (asi-event-actual event)
              (asi-event-surprised? event)
              (ati-movement (asi-event-inquiry event))))
    (defn asi-signal-id (signal) (nth signal 1))
    (defn asi-signal-predicted (signal) (nth signal 2))
    (defn asi-signal-actual (signal) (nth signal 3))
    (defn asi-signal-surprised? (signal) (nth signal 4))
    (defn asi-signal-movement (signal) (nth signal 5))

    ; BRAID, never rank: mapping preserves every event and arrival order.
    (defn asi-braid (events)
        (if (eq (len events) 0)
            (empty)
            (cons (asi-signal (head events))
                  (asi-braid (tail events)))))

    ; A moved/wandered/played event learns whether prediction matched or not.
    ; Hold/rest/tend continue to receive ati-witness's tended relation.
    (defn asi-witness (event)
        (ati-witness
            (ati-movement (asi-event-inquiry event))
            (asi-event-surprised? event)))

    0)
