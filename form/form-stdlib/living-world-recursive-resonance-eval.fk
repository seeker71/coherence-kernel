; living-world-recursive-resonance-eval.fk -- rebuild through an observed path.
;
; Evaluation is local and structural.  The input must have the exact recursive
; category/arity skeleton witnessed by the correspondence.  Every reference
; path must resolve; ambiguity or structural drift returns first-class none.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-recursive-resonance.fk

(defn lwrr-at-path-items (cell indexes)
    (if (eq (len indexes) 0) cell
        (do
            (let index (node_value (head indexes)))
            (let children (node_children cell))
            (if (or (lt index 0) (ge index (len children)))
                (lwo-none)
                (lwrr-at-path-items (nth children index) (tail indexes))))))

(defn lwrr-at-path (cell path)
    (lwrr-at-path-items cell (lwrr-path-items path)))

(defn lwrr-eval-items (templates input)
    (if (eq (len templates) 0) (empty)
        (do
            (let value (lwrr-eval-template (head templates) input))
            (if (node_eq value (lwo-none)) (empty)
                (cons value (lwrr-eval-items (tail templates) input))))))

(defn lwrr-eval-build (term input)
    (do
        (let templates (lwrr-build-templates term))
        (let values (lwrr-eval-items templates input))
        (if (not (eq (len values) (len templates)))
            (lwo-none)
            (intern_node (lwrr-build-category term) values))))

(defn lwrr-eval-template (term input)
    (if (eq (lwrr-ref? term) 1)
        (lwrr-at-path input (lwrr-ref-path term))
        (if (eq (lwrr-constant? term) 1)
            (lwrr-constant-cell term)
            (if (eq (lwrr-build? term) 1)
                (lwrr-eval-build term input)
                (lwo-none)))))

(defn lwrr-apply-signature (signature input)
    (if (or (eq (lwrr-signature-valid? signature) 0)
            (not (node_eq (lwrr-skeleton input)
                          (lwrr-signature-source-skeleton signature))))
        (lwo-none)
        (do
            (let output
                (lwrr-eval-template (lwrr-signature-template signature) input))
            (if (or (node_eq output (lwo-none))
                    (not (node_eq (lwrr-skeleton output)
                                  (lwrr-signature-target-skeleton signature))))
                (lwo-none)
                output))))
