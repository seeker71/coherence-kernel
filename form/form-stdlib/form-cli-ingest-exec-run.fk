; form-cli-ingest-exec-run.fk — witness native ingest returns, no Qwen.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/equivalence-collapse.fk form-stdlib/knowledge-ingest.fk
; preludes: ingest/name-build-observe.fk
; preludes: form-stdlib/form-cli-ingest-exec-xtal.fk

(do
    (print_str (str_concat "fie check=" (str_concat (int_to_str (fie-check)) "\n")))
    (print_str (str_concat "fie collapse=" (str_concat (fie-observe (CollapsePath)) "\n")))
    (print_str (str_concat "fie depth=" (str_concat (fie-observe (DepthPath)) "\n")))
    (print_str (str_concat "fie nbo=" (str_concat (fie-observe (NboPath)) "\n")))
    0)
