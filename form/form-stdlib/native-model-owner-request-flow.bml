//////////////////////////////////////////////////////////////////////
//
// native-model-owner-request-flow.bml — observable resident Qwen request.
//
// Authority: form-stdlib/bml/native-model-owner-request-flow.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/native-model-token-flow.bml form/form-stdlib/native-model-owner-cadence.bml form/form-stdlib/native-model-tensor-ledger.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelOwnerRequestFlow {
        def NMOFRoot() = hearth-telemetry-root();
        field NMOFPublisher = "form-cli-model-flow";
        field NMOFModel = "qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field NMOFModelId = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field NMOFTokenId = "tokens.qwen3.8-flash-next.ud-q2_k_xl.unsloth.position";
        field NMOFLayers = 48;
        field NMOFPollAttempts = 240;

        def nmof-find-sample(rows, id) = if ((Comparable) len(rows) == 0) then [] else if ((String) fgtm-sample-id(head(rows)) == id) then head(rows) else nmof-find-sample(tail(rows), id);
        def nmof-reading-samples(reading) = if (!((String) fgtm-read-state-status(reading) == "current")) then [] else if (!((Comparable) fgtm-field-present?(fgtm-read-state-value(reading)) == 1)) then [] else fgtm-snapshot-samples(fgtm-field-value(fgtm-read-state-value(reading)));
        def nmof-current-samples(publisher) = nmof-reading-samples(fgtm-read-current(NMOFRoot(), publisher));
        def nmof-token-sample(rows) = nmof-find-sample(rows, NMOFTokenId());
        def nmof-model-sample(rows) = nmof-find-sample(rows, NMOFModelId());
        def nmof-position(rows) {
            let sample = nmof-token-sample(rows);
            if ((Comparable) len(sample) == 0) then -1 else if ((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) then fgtm-field-value(fgtm-sample-capacity(sample)) else -1;
        }
        def nmof-model-handle(rows) {
            let sample = nmof-model-sample(rows);
            if ((Comparable) len(sample) == 0) then fgtm-absent() else fgtm-sample-handle(sample);
        }
        def nmof-sleep-quarter() = host-exec("/bin/sleep 0.25", "");
        def nmof-poll-position(publisher, before, attempts) {
            let rows = nmof-current-samples(publisher);
            let position = nmof-position(rows);
            if (position > before) then ["native-model-owner-flow-complete-v1", "completed", position, now_unix_ms(), rows] else if (attempts <= 0) then ["native-model-owner-flow-complete-v1", "timeout", position, now_unix_ms(), rows] else nmof-poll-position-after-wait(publisher, before, attempts);
        }
        def nmof-poll-position-after-wait(publisher, before, attempts) {
            let waited = nmof-sleep-quarter();
            nmof-poll-position(publisher, before, (attempts - 1));
        }

        def nmof-fields(tokenPosition, tokenId, layerIndex, tensorName, tensorBytes, expertIndex, expertWeight, metalPipeline, metalHandle, framebufferNode, startUs, endUs, durationUs) = [tokenPosition, tokenId, layerIndex, tensorName, tensorBytes, expertIndex, expertWeight, metalPipeline, metalHandle, framebufferNode, startUs, endUs, durationUs];
        def nmof-blank() = nmof-fields(fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent());
        def nmof-event-lifecycle(flowId, owner, stage, sequence, parent, fields, epoch, lifecycle, evidence, source) {
            let node = nmtf-form-event-node(NMOFPublisher(), flowId, stage, sequence);
            let binding = fnc-from-node(node, "cell", nmtf-stage-kind(stage));
            nmtf-event-categorized(nmtf-node-id-string(node), parent, NMOFPublisher(), flowId, stage, sequence, owner, NMOFModel(), fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], fields[7], fields[8], fields[9], fields[10], fields[11], fields[12], epoch, lifecycle, evidence, source, binding);
        }
        def nmof-event(flowId, owner, stage, sequence, parent, fields, epoch, evidence, source) = nmof-event-lifecycle(flowId, owner, stage, sequence, parent, fields, epoch, "active", evidence, source);
        def nmof-request-event(flowId, owner, epoch, lifecycle, evidence, source) = nmof-event-lifecycle(flowId, owner, "request", 1, fgtm-absent(), nmof-blank(), epoch, lifecycle, evidence, source);
        def nmof-parent(event) = fgtm-present(nmtf-event-node-id(event));
        def nmof-publish(events) = nmtf-publish-events(NMOFRoot(), NMOFPublisher(), now_unix_ms(), events);
        def nmof-publish-completed-chain(q, t, l, x, e, m, f, g) {
            nmof-publish([q, t, l, x, e, m, f, g]);
        }
        def nmof-complete(publisher, flowId, q, beforeRows, started, completion) {
            let [_, _, position, finished, afterRows] = completion;
            let handle = nmof-model-handle(afterRows);
            let request = nmof-request-event(flowId, publisher, started, "completed", "physical-live", "form-cli.model-flow");
            let token = nmof-event-lifecycle(flowId, publisher, "token", 2, nmof-parent(request), nmof-fields(fgtm-present(position), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent()), finished, "completed", "physical-live", "model.context-position");
            let layer = nmof-event-lifecycle(flowId, publisher, "layer", 3, nmof-parent(token), nmof-fields(fgtm-absent(), fgtm-absent(), fgtm-present((NMOFLayers() - 1)), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent()), finished, "completed", "derived-window", "q4s-evaluate-one.48-layer-boundary");
            let tensor = nmof-event-lifecycle(flowId, publisher, "tensor", 4, nmof-parent(layer), nmof-fields(fgtm-absent(), fgtm-absent(), fgtm-present((NMOFLayers() - 1)), fgtm-present("qwen38.scratch-state"), fgtm-present(nmtl-qwen-allocated-bytes(128, NMOFLayers(), 4)), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent()), finished, "completed", "derived-window", "native-model-tensor-ledger");
            let expert = nmof-event-lifecycle(flowId, publisher, "expert", 5, nmof-parent(tensor), nmof-fields(fgtm-absent(), fgtm-absent(), fgtm-present((NMOFLayers() - 1)), fgtm-present("top10.ids-gpu-resident"), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent()), finished, "completed", "derived-window", "q4t-route.executed-selection-not-retained");
            let metal = nmof-event-lifecycle(flowId, publisher, "metal", 6, nmof-parent(expert), nmof-fields(fgtm-absent(), fgtm-absent(), fgtm-present((NMOFLayers() - 1)), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-present("owner-command.position-window"), handle, fgtm-absent(), fgtm-present((started * 1000)), fgtm-present((finished * 1000)), fgtm-present(((finished - started) * 1000))), finished, "completed", "derived-window", "owner-command.physical-position-window");
            let framebuffer = nmof-event-lifecycle(flowId, publisher, "framebuffer", 7, nmof-parent(metal), nmof-blank(), finished, "completed", "physical-live", "model.owner.glass-snapshot");
            let glass = nmof-event-lifecycle(flowId, publisher, "glass", 8, nmof-parent(framebuffer), nmof-blank(), now_unix_ms(), "completed", "physical-live", "model-flow-owner-client");
            let published = nmof-publish-completed-chain(request, token, layer, tensor, expert, metal, framebuffer, glass);
            ["native-model-owner-request-flow-v1", "completed", "publisher", publisher, "flow", flowId, "position-before", nmof-position(beforeRows), "position-after", position, "duration-ms", (finished - started), "tensor-bytes", nmtl-qwen-allocated-bytes(128, NMOFLayers(), 4), "layers", NMOFLayers(), "publish", published[1]];
        }
        def nmof-run(publisher) {
            let beforeRows = nmof-current-samples(publisher);
            let before = nmof-position(beforeRows);
            let started = now_unix_ms();
            let flowId = str_concat("form-cli-model-flow.f", int_to_str(started));
            let request = nmof-request-event(flowId, publisher, started, "active", "physical-live", "form-cli.model-flow");
            let first = nmof-publish([request]);
            let offered = if ((before >= 0) && ((String) first[1] == "published")) then nmdoc-offer-command(publisher, "qwen-step") else nmdoc-command-result("refused", "qwen-step");
            if (!((String) nmdoc-command-status(offered) == "offered")) then ["native-model-owner-request-flow-v1", "refused", "before-position", before, "command", nmdoc-command-status(offered)] else nmof-after-offer(publisher, flowId, request, beforeRows, started, before);
        }
        def nmof-after-offer(publisher, flowId, request, beforeRows, started, before) {
            let completion = nmof-poll-position(publisher, before, NMOFPollAttempts());
            if ((String) completion[1] == "completed") then nmof-complete(publisher, flowId, request, beforeRows, started, completion) else nmof-timeout(publisher, flowId, before, started, completion);
        }
        def nmof-timeout(publisher, flowId, before, started, completion) {
            let terminal = nmof-publish([nmof-request-event(flowId, publisher, started, "failed", "physical-live", "model-flow.timeout")]);
            ["native-model-owner-request-flow-v1", "timeout", "publisher", publisher, "flow", flowId, "position-before", before, "position-last", completion[2], "elapsed-ms", (completion[3] - started), "publish", terminal[1]];
        }
        def nmof-run-current() {
            let observed = now_unix_ms();
            let correlation = nmdoc-discover(nmdoc-self-pid(), observed, 1);
            if (!((Comparable) nmdoc-correlation?(correlation) == 1)) then ["native-model-owner-request-flow-v1", "refused", "reason", "current-owner-not-discovered"] else if (!((Comparable) nmdoc-exact-binding?(correlation) == 1)) then ["native-model-owner-request-flow-v1", "refused", "reason", "current-owner-not-exactly-bound"] else if (!((Comparable) nmdoc-target-alive?(correlation) == 1)) then ["native-model-owner-request-flow-v1", "refused", "reason", "current-owner-not-alive"] else nmof-run(nmdoc-target-publisher(correlation));
        }
        def nmof-summary(result) {
            let status = if (len(result) < 2) then "malformed" else result[1];
            if (((String) status == "completed") && (len(result) >= 18)) then fgtm-cat(["model-flow-status=completed\npublisher=", result[3], "\nflow=", result[5], "\nposition=", int_to_str(result[7]), "->", int_to_str(result[9]), "\nduration-ms=", int_to_str(result[11]), "\ntensor-bytes=", int_to_str(result[13]), "\nlayers=", int_to_str(result[15]), "\npublish=", result[17]]) else if (len(result) >= 4) then fgtm-cat(["model-flow-status=", status, "\n", result[2], "=", result[3]]) else str_concat("model-flow-status=", status);
        }
    }
    0;
}
