    def qtf2-rec-begin-merges(r) = !((String) qtf2-rec-status(r) == "open") ? r : qtf2-recorder("open", "recording", qtf2-rec-root(r), qtf2-rec-seal(r), qtf2-rec-vcap(r), qtf2-rec-lcap(r), qtf2-rec-rcap(r), "merge", qtf2-rec-vcount(r), qtf2-rec-mcount(r), qtf2-rec-has-v?(r), qtf2-rec-last-v(r), qtf2-rec-has-m?(r), qtf2-rec-last-l(r), qtf2-rec-last-r(r));
    def qtf2-rec-merge(r, left, right, rank) = !((String) qtf2-rec-status(r) == "open") ? r : !((String) qtf2-rec-phase(r) == "merge") ? qtf2-rec-fail(r, "merge-before-phase") : (Comparable) qtf2-rec-has-m?(r) == 1 && !(qtf2-merge-key-cmp(qtf2-rec-last-l(r), qtf2-rec-last-r(r), left, right) < 0) ? qtf2-rec-fail(r, "merge-not-strictly-sorted") : {
