; form-cell-servant.fk — one resident fkwu compiles and executes arriving Form
; source without restarting. This is the pure turnwheel under
; observe/form-cell-resident-live.fk: task bytes arrive as fcpa-task-frames
; through the proven scannerless cursor (fcpsi-feed), a `cell-eval` task's body
; is evaluated in place by fef-eval-state, and the ENVIRONMENT PERSISTS across
; tasks — a defn born in one task answers a call in the next, in the same
; process, with no new fkwu. Starting a fresh process per cell is the shape
; this replaces; one residence, fed through a spool, is the preferred door.
;
; The served grammar today is form-eval-full's proven core: integers, if/do/
; let/defn, user calls, and the fourteen-op table. Strings, lists and floats
; live in grammars/form-eval.fk's fe-eval and join when that door gains the
; resident environment; native dispatch from inside eval is the named next
; stone (form-eval-full.fk's own words at its op table). An unbound name in a
; task is a loud death of the residence, never a quiet wrong answer — the
; process-field census then shows the ghost presence, which is the honest
; residue the sweep door clears.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-eval-full.fk
; preludes: form-stdlib/form-cli-peer-agent.fk
; preludes: form-stdlib/form-cli-peer-stream-ingress.fk
;
; Proven by: form-stdlib/tests/form-cell-servant-band.fk

(do
    ; state = (mark cursor env served)
    (defn fcsv-new ()
        (list "form-cell-servant-v1" (fcpsi-fresh-cursor "cell-servant")
            (fef-empty-env) 0))
    (defn fcsv-cursor (s) (nth s 1))
    (defn fcsv-env (s) (nth s 2))
    (defn fcsv-served (s) (nth s 3))

    ; ── reply frames: the same marker discipline as tasks ──────────────────
    (defn fcsv-reply-open () "<|form:agent-reply|>")
    (defn fcsv-reply-close () "<|/form:agent-reply|>")
    (defn fcsv-reply-line (name value)
        (str_concat "\n" (str_concat name (str_concat "=" value))))
    (defn fcsv-reply-frame (turn kind signal value)
        (str_concat (fcsv-reply-open)
        (str_concat (fcsv-reply-line "turn" (int_to_str turn))
        (str_concat (fcsv-reply-line "kind" kind)
        (str_concat (fcsv-reply-line "signal" signal)
        (str_concat (fcsv-reply-line "value" value)
        (str_concat "\n" (str_concat (fcsv-reply-close) "\n"))))))))
    (defn fcsv-reply-field (frame name)
        (do (let key (str_concat "\n" (str_concat name "=")))
            (let at (str_find frame key 0))
            (if (lt at 0) ""
                (do (let start (add at (str_len key)))
                    (let stop (str_find frame "\n" start))
                    (substring frame start
                        (if (lt stop 0) (str_len frame) stop))))))

    ; ── one task through the resident evaluator ────────────────────────────
    ; -> (reply-text env'). A kind this servant does not serve answers
    ; `choice`, environment untouched; the task stays visible, never silently
    ; swallowed.
    (defn fcsv-task-reply (env task)
        (do (let kind (fcpsi-task-kind task))
            (if (str_eq kind "cell-eval")
                (do (let r (fef-eval-state (fcpsi-task-text task) env))
                    (list (fcsv-reply-frame (fcpsi-task-turn task) kind
                        "value" (int_to_str (fef-v r))) (fef-e r)))
                (list (fcsv-reply-frame (fcpsi-task-turn task) kind
                    "choice" "kind-not-served") env))))

    ; walk the completed frames of one feed: -> (env served replies)
    (defn fcsv-frames-go (env frames ends served replies)
        (if (eq (len frames) 0) (list env served replies)
            (do (let task (fcpsi-frame-parse "cell-servant" served 0
                    (head frames) (head ends)))
                (if (nothing? task)
                    (fcsv-frames-go env (tail frames) (tail ends)
                        (add served 1)
                        (append replies (list (fcsv-reply-frame 0 "malformed"
                            "failure" "task-frame-malformed"))))
                    (do (let out (fcsv-task-reply env task))
                        (fcsv-frames-go (nth out 1) (tail frames) (tail ends)
                            (add served 1)
                            (append replies (list (nth out 0)))))))))

    ; feed one arriving chunk: -> (state' replies). Mid-frame bytes are held
    ; by the cursor as nothing-yet; a malformed frame earns a failure reply
    ; and the residence continues — only an unbound name inside a served
    ; task's own source can end it, loudly.
    (defn fcsv-feed (s chunk)
        (do (let fed (fcpsi-feed (fcsv-cursor s) chunk))
            (let walked (fcsv-frames-go (fcsv-env s) (nth fed 1) (nth fed 3)
                (fcsv-served s) (list)))
            (list (list "form-cell-servant-v1" (nth fed 0) (nth walked 0)
                    (nth walked 1))
                (nth walked 2))))
    0)
