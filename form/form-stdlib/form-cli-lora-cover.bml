//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-cover.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lora-cover.bml
//
// Overlay train + coverage curve. Remaining mill samples are 0
// when heldout already meets the most-responses ppm. Remaining
// session events are a different count: remote planner, not more
// of the same cartesian. fqt-lora? stays 0.
//
// Proven by: form-stdlib/tests/form-cli-lora-cover-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template CoverRow<TCount> {
        member trainN: TCount;
        member correct: TCount;
        member heldout: TCount;
        member ppm: TCount;
    }

    class FormLoraCoverAuthority {
        field CoverAuthorityPath = "form/form-stdlib/bml/form-cli-lora-cover.bml";
        field CoverAuthorityKind = "high-bml-class-template-field";
    }

    class FormLoraCover<T> {
        field TargetMostPpm = 950000;
        field TargetLocalPpm = 990000;
        field ThisNative = 414;
        field ThisLocal = 473;
        field ThisRemote = 105;
        field FqtLora = 0;
        field AdapterPath = ".form-lora-adapter";

        ref fco-authority = FormLoraCoverAuthority;
        thought fco-pattern = list("sweep", "ppm", "remaining", "train-overlay");

        def fco-ppm(c, n) = if eq(n, 0) then 0 else div(mul(c, 1000000), n);

        def fco-need-hits(c, n, target) {
            let want = div(add(mul(target, n), 999999), 1000000);
            if ge(c, want) then 0 else sub(want, c);
        }

        def fco-need-events() {
            let tot = add(ThisNative(), add(ThisLocal(), ThisRemote()));
            let have = add(ThisNative(), ThisLocal());
            let want = div(mul(TargetLocalPpm(), tot), 1000000);
            if ge(have, want) then 0 else sub(want, have);
        }

        def fco-session-ppm() {
            let tot = add(ThisNative(), add(ThisLocal(), ThisRemote()));
            fco-ppm(add(ThisNative(), ThisLocal()), tot);
        }

        def fco-lens-at(tn) {
            let rows = fls-corpus(tn, 1);
            let c = fls-heldout-correct(rows);
            let h = fls-count-split(rows, SplitHeldout());
            list(tn, fls-n(tn, 1), c, h, fco-ppm(c, h));
        }

        def fco-lane-at(tn) {
            let rows = fln-corpus(tn, 1);
            let c = fln-heldout-correct(rows);
            let h = fln-count-split(rows, SplitHeldout());
            list(tn, fln-n(tn, 1), c, h, fco-ppm(c, h));
        }

        def fco-more-tn(ppm1, ppm2, tn1, tn2, target) = if ge(ppm2, target) then 0 else if le(ppm2, ppm1) then sub(0, 1) else if eq(sub(tn2, tn1), 0) then sub(0, 1) else div(add(mul(sub(target, ppm2), sub(tn2, tn1)), sub(ppm2, ppm1)), sub(ppm2, ppm1));

        def fco-nth(row, i) = nth(row, i);

        def fco-fqt-lora() = FqtLora();

        def fco-bit(ok, bit) = if ok then bit else 0;

        def fco-check() {
            let a = fco-lens-at(1);
            let c = fco-nth(a, 2);
            let h = fco-nth(a, 3);
            let ppm = fco-nth(a, 4);
            let c0 = fco-bit(eq(c, 72), 1);
            let c1 = fco-bit(eq(h, 72), 2);
            let c2 = fco-bit(eq(ppm, 1000000), 4);
            let c3 = fco-bit(eq(fco-need-hits(c, h, TargetMostPpm()), 0), 8);
            let c4 = fco-bit(eq(fco-need-hits(c, h, TargetLocalPpm()), 0), 16);
            let c5 = fco-bit(eq(fco-session-ppm(), 894153), 32);
            let c6 = fco-bit(eq(fco-need-events(), 95), 64);
            let c7 = fco-bit(and(eq(FqtLora(), 0), eq(fqt-lora?(), 0)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
