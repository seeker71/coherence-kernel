
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn CorpusAuthorityPath () "form/form-stdlib/bml/form-cli-lora-corpus.bml")
(defn CorpusAuthorityKind () "high-bml-class-template-field")
(defn FormLoraCorpusAuthority () (list "abstraction" "FormLoraCorpusAuthority" (list) (list) (list "CorpusAuthorityPath" "CorpusAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 8)
(defn NLanes () 9)
(defn TrainN () 12)
(defn HeldoutN () 4)
(defn Dim () 64)
(defn FqtLora () 0)
(defn CorpusPath () ".form-lora-corpus")
(defn AdapterPath () ".form-lora-adapter")
(defn Pipe () "|")
(defn Nl () "
")
(defn flc-authority () FormLoraCorpusAuthority)
(defn flc-pattern () (list "enough" "gitignored" "rank-1-seed" "qwen-frozen"))
(defn flc-n () (mul (NSkills) (mul (NLanes) (add (TrainN) (HeldoutN)))))
(defn flc-scale-20-5 () (mul (NSkills) (mul (NLanes) (add 20 5))))
(defn flc-line (row) (str_concat (nth row 0) (str_concat (Pipe) (str_concat (nth row 1) (str_concat (Pipe) (str_concat (nth row 2) (Nl)))))))
(defn flc-print-one (row rest) (do (print_str (flc-line row)) (flc-print rest)))
(defn flc-print (rows) (if (eq (len rows) 0) 0 (flc-print-one (head rows) (tail rows))))
(defn flc-join (rows acc) (if (eq (len rows) 0) acc (flc-join (tail rows) (str_concat acc (flc-line (head rows))))))
(defn flc-body (rows) (flc-join rows ""))
(defn flc-fuel-loop (rows n acc) (if (eq n 0) acc (if (eq (len rows) 0) acc (flc-fuel-loop (tail rows) (sub n 1) (str_concat acc (nth (head rows) 2))))))
(defn flc-fuel (rows) (flc-fuel-loop rows (NSkills) ""))
(defn flc-fqt-lora () (FqtLora))
(defn flc-path () (CorpusPath))
(defn flc-dim () (Dim))
(defn flc-bit (ok bit) (if ok bit 0))
(defn flc-check () (do (let n (flc-n)) (let c0 (flc-bit (eq n 1152) 1)) (let c1 (flc-bit (and (eq (TrainN) 12) (eq (HeldoutN) 4)) 2)) (let c2 (flc-bit (eq (Dim) 64) 4)) (let c3 (flc-bit (eq (FqtLora) 0) 8)) (let c4 (flc-bit (str_eq (CorpusPath) ".form-lora-corpus") 16)) (let c5 (flc-bit (eq (flc-scale-20-5) 1800) 32)) (let c6 (flc-bit (str_eq (AdapterPath) ".form-lora-adapter") 64)) (let c7 (flc-bit (eq (fqt-lora?) 0) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormLoraCorpus () (list "abstraction" "FormLoraCorpus" (list "T") (list "flc-n" "flc-scale-20-5" "flc-line" "flc-print-one" "flc-print" "flc-join" "flc-body" "flc-fuel-loop" "flc-fuel" "flc-fqt-lora" "flc-path" "flc-dim" "flc-bit" "flc-check") (list "MixA" "MixB" "NSkills" "NLanes" "TrainN" "HeldoutN" "Dim" "FqtLora" "CorpusPath" "AdapterPath" "Pipe" "Nl") (list "flc-authority") (list "flc-pattern")))
0
