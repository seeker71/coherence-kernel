// Measurement JSON: finite binary64 values round-trip without fixed-decimal loss.
// Form expands the exact dyadic value with small integer limbs, then chooses the
// shortest rounded decimal that parses back to that same value (at most 17 digits).
// The ordinary six-decimal display formatter keeps its existing UI contract.
import form-stdlib/json.fk;
section [form.bml] {
 class PreciseJson {
  def jpf-limbs(n) = if (n < 10000000) then [n] else cons((n % 10000000),jpf-limbs((n / 10000000)));
  def jpf-mul(xs,n,carry) = if nil?(xs) then if ((Comparable) carry == 0) then [] else [carry] else jpf-mul-word(xs,n,((xs[0] * n) + carry));
  def jpf-mul-word(xs,n,v) = cons((v % 10000000),jpf-mul(xs[1:],n,(v / 10000000)));
  def jpf-pow(xs,n,count) = if ((Comparable) count == 0) then xs else jpf-pow(jpf-mul(xs,n,0),n,(count - 1));
  def jpf-tail-text(xs) = if nil?(xs) then "" else ((String) fstr-pad-left(xs[0].str(),7) + jpf-tail-text(xs[1:]));
  def jpf-limb-text(xs) = (xs[0].str() + jpf-tail-text(xs[1:]));
  def jpf-norm(v,e) = if (v >= 2.0) then jpf-norm((v / 2.0),(e + 1)) else if (v < 1.0) then jpf-norm((v * 2.0),(e - 1)) else [float_to_int((v * 4503599627370496.0)),(e - 52)];
  def jpf-exact(v) {
   let norm = jpf-norm(v,0); let e = norm[1]; let digits = jpf-limb-text(reverse(jpf-pow(jpf-limbs(norm[0]),if (e < 0) then 5 else 2,abs(e))));
   [digits,((len(digits) - (if (e < 0) then (0 - e) else 0)) - 1)];
  }
  def jpf-nonzero(s,i) = if (i >= len(s)) then 0 else if (!((Comparable) str_byte_at(s,i) == 48)) then 1 else jpf-nonzero(s,(i + 1));
  def jpf-round(s,n,e) {
   if (len(s) <= n) then [s,e] else jpf-rounded(s,n,e,str_to_int(substring(s,0,n)));
  }
  def jpf-rounded(s,n,e,prefix) {
   let next = (str_byte_at(s,n) - 48); let up = ((next > 5) || (((Comparable) next == 5) && (jpf-nonzero(s,(n + 1)) || ((Comparable) (prefix % 2) == 1))));
   let rounded = (prefix + (if up then 1 else 0)).str();
   [rounded,(e + (if (len(rounded) > n) then 1 else 0))];
  }
  def jpf-zeros(n) = if (n <= 0) then "" else ("0" + jpf-zeros((n - 1)));
  def jpf-render(digits,e) {
   let d = fstr-trim-trailing-zeros(digits); let n = len(d);
   if ((e < -6) || (e > 15)) then (substring(d,0,1) + ((if (n > 1) then ("." + substring(d,1,n)) else "") + ("e" + e.str()))) else if (e < 0) then ("0." + ((String) jpf-zeros(((0 - e) - 1)) + d)) else if (e >= (n - 1)) then ((String) d + jpf-zeros(((e + 1) - n))) else (substring(d,0,(e + 1)) + ("." + substring(d,(e + 1),n)));
  }
  def jpf-shortest(v,digits,e,n) {
   let pair = jpf-round(digits,n,e); let candidate = jpf-render(pair[0],pair[1]);
   if ((Comparable) str_to_float(candidate) == v) then candidate else if (n >= 17) then jpf-render(digits,e) else jpf-shortest(v,digits,e,(n + 1));
  }
  def float-precise-str(v) {
   if (!((Comparable) (v - v) == 0.0)) then form_error("non-finite value has no JSON number") else if ((Comparable) v == 0.0) then "0" else jpf-signed(v,jpf-exact(abs(v)));
  }
  def jpf-signed(v,exact) = ((String) (if (v < 0.0) then "-" else "") + jpf-shortest(abs(v),exact[0],exact[1],1));
  def json-precise-float(v) = json-node-float-text(float-precise-str(v));
  def json-emit-precise(node) {
   let cat = node_category(node);
   if node_eq(cat,JSON-OBJECT()) then ("{" + (jpf-children(node_children(node)) + "}")) else if node_eq(cat,JSON-ARRAY()) then ("[" + (jpf-children(node_children(node)) + "]")) else if node_eq(cat,JSON-PAIR()) then (json-quote-string(json-pair-key(node)) + (":" + json-emit-precise(json-pair-value(node)))) else if (((Comparable) node_level(node) == 1) && ((Comparable) node_type(node) == 7)) then float-precise-str(node_value(node)) else json-emit(node);
  }
  def jpf-children(nodes) = if nil?(nodes) then "" else ((String) json-emit-precise(nodes[0]) + (if nil?(nodes[1:]) then "" else ("," + jpf-children(nodes[1:]))));
 }
 0;
}
