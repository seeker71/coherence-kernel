// Measurement JSON: finite binary64 values round-trip without fixed-decimal loss.
// Form expands the exact dyadic value with small integer limbs, then chooses the
// shortest rounded decimal that parses back to that same value (at most 17 digits).
// The ordinary six-decimal display formatter keeps its existing UI contract.
// preludes: form-stdlib/json.fk
section [form.bml] {
 class PreciseJson {
  def jpf-limbs(n) = n < 10000000 ? list(n) : cons(n % 10000000,jpf-limbs(n / 10000000));
  def jpf-mul(xs,n,carry) = nil?(xs) ? ((Comparable) carry == 0 ? list() : list(carry)) : jpf-mul-word(xs,n,(head(xs) * n) + carry);
  def jpf-mul-word(xs,n,v) = cons(v % 10000000,jpf-mul(tail(xs),n,v / 10000000));
  def jpf-pow(xs,n,count) = (Comparable) count == 0 ? xs : jpf-pow(jpf-mul(xs,n,0),n,count - 1);
  def jpf-tail-text(xs) = nil?(xs) ? "" : fstr-pad-left(int_to_str(head(xs)),7) ++ jpf-tail-text(tail(xs));
  def jpf-limb-text(xs) = int_to_str(head(xs)) ++ jpf-tail-text(tail(xs));
  def jpf-norm(v,e) = v >= 2.0 ? jpf-norm(v / 2.0,e + 1) : v < 1.0 ? jpf-norm(v * 2.0,e - 1) : list(float_to_int(v * 4503599627370496.0),e - 52);
  def jpf-exact(v) {
   let norm = jpf-norm(v,0); let e = norm[1]; let digits = jpf-limb-text(reverse(jpf-pow(jpf-limbs(head(norm)),e < 0 ? 5 : 2,abs(e))));
   list(digits,(str_len(digits) - (e < 0 ? (0 - e) : 0)) - 1);
  }
  def jpf-nonzero(s,i) = i >= str_len(s) ? 0 : !((Comparable) str_byte_at(s,i) == 48) ? 1 : jpf-nonzero(s,i + 1);
  def jpf-round(s,n,e) {
   str_len(s) <= n ? list(s,e) : jpf-rounded(s,n,e,str_to_int(substring(s,0,n)));
  }
  def jpf-rounded(s,n,e,prefix) {
   let next = str_byte_at(s,n) - 48; let up = (next > 5) || (((Comparable) next == 5) && (jpf-nonzero(s,n + 1) || ((Comparable) (prefix % 2) == 1)));
   let rounded = int_to_str(prefix + (up ? 1 : 0));
   list(rounded,e + (str_len(rounded) > n ? 1 : 0));
  }
  def jpf-zeros(n) = n <= 0 ? "" : "0" ++ jpf-zeros(n - 1);
  def jpf-render(digits,e) {
   let d = fstr-trim-trailing-zeros(digits); let n = str_len(d);
   (e < -6) || (e > 15) ? substring(d,0,1) ++ (n > 1 ? "." ++ substring(d,1,n) : "") ++ "e" ++ int_to_str(e) : e < 0 ? "0." ++ jpf-zeros((0 - e) - 1) ++ d : e >= (n - 1) ? d ++ jpf-zeros((e + 1) - n) : substring(d,0,e + 1) ++ "." ++ substring(d,e + 1,n);
  }
  def jpf-shortest(v,digits,e,n) {
   let pair = jpf-round(digits,n,e); let candidate = jpf-render(head(pair),pair[1]);
   (Comparable) str_to_float(candidate) == v ? candidate : n >= 17 ? jpf-render(digits,e) : jpf-shortest(v,digits,e,n + 1);
  }
  def float-precise-str(v) {
   !((Comparable) (v - v) == 0.0) ? form_error("non-finite value has no JSON number") : (Comparable) v == 0.0 ? "0" : jpf-signed(v,jpf-exact(abs(v)));
  }
  def jpf-signed(v,exact) = (v < 0.0 ? "-" : "") ++ jpf-shortest(abs(v),head(exact),exact[1],1);
  def json-precise-float(v) = json-node-float-text(float-precise-str(v));
  def json-emit-precise(node) {
   let cat = node_category(node);
   node_eq(cat,JSON-OBJECT()) ? "{" ++ jpf-children(node_children(node)) ++ "}" : node_eq(cat,JSON-ARRAY()) ? "[" ++ jpf-children(node_children(node)) ++ "]" : node_eq(cat,JSON-PAIR()) ? json-quote-string(json-pair-key(node)) ++ ":" ++ json-emit-precise(json-pair-value(node)) : ((Comparable) node_level(node) == 1) && ((Comparable) node_type(node) == 7) ? float-precise-str(node_value(node)) : json-emit(node);
  }
  def jpf-children(nodes) = nil?(nodes) ? "" : json-emit-precise(head(nodes)) ++ (nil?(tail(nodes)) ? "" : "," ++ jpf-children(tail(nodes)));
 }
 0;
}
