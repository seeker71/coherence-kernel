// Measurement JSON: finite binary64 values round-trip without fixed-decimal loss.
// Form expands the exact dyadic value with small integer limbs, then chooses the
// shortest rounded decimal that parses back to that same value (at most 17 digits).
// The ordinary six-decimal display formatter keeps its existing UI contract.
// preludes: form-stdlib/json.fk
section [form.bml] {
 class PreciseJson {
  def jpf-limbs(n) = if lt(n,10000000) then list(n) else cons(mod(n,10000000),jpf-limbs(div(n,10000000)));
  def jpf-mul(xs,n,carry) = if nil?(xs) then if eq(carry,0) then list() else list(carry) else jpf-mul-word(xs,n,add(mul(head(xs),n),carry));
  def jpf-mul-word(xs,n,v) = cons(mod(v,10000000),jpf-mul(tail(xs),n,div(v,10000000)));
  def jpf-pow(xs,n,count) = if eq(count,0) then xs else jpf-pow(jpf-mul(xs,n,0),n,sub(count,1));
  def jpf-tail-text(xs) = if nil?(xs) then "" else str_concat(fstr-pad-left(int_to_str(head(xs)),7),jpf-tail-text(tail(xs)));
  def jpf-limb-text(xs) = str_concat(int_to_str(head(xs)),jpf-tail-text(tail(xs)));
  def jpf-norm(v,e) = if ge(v,2.0) then jpf-norm(div(v,2.0),add(e,1)) else if lt(v,1.0) then jpf-norm(mul(v,2.0),sub(e,1)) else list(float_to_int(mul(v,4503599627370496.0)),sub(e,52));
  def jpf-exact(v) {
   let norm = jpf-norm(v,0); let e = nth(norm,1); let digits = jpf-limb-text(reverse(jpf-pow(jpf-limbs(head(norm)),if lt(e,0) then 5 else 2,abs(e))));
   list(digits,sub(sub(str_len(digits),if lt(e,0) then sub(0,e) else 0),1));
  }
  def jpf-nonzero(s,i) = if ge(i,str_len(s)) then 0 else if not(eq(str_byte_at(s,i),48)) then 1 else jpf-nonzero(s,add(i,1));
  def jpf-round(s,n,e) {
   if le(str_len(s),n) then list(s,e) else jpf-rounded(s,n,e,str_to_int(substring(s,0,n)));
  }
  def jpf-rounded(s,n,e,prefix) {
   let next = sub(str_byte_at(s,n),48); let up = or(gt(next,5),and(eq(next,5),or(jpf-nonzero(s,add(n,1)),eq(mod(prefix,2),1))));
   let rounded = int_to_str(add(prefix,if up then 1 else 0));
   list(rounded,add(e,if gt(str_len(rounded),n) then 1 else 0));
  }
  def jpf-zeros(n) = if le(n,0) then "" else str_concat("0",jpf-zeros(sub(n,1)));
  def jpf-render(digits,e) {
   let d = fstr-trim-trailing-zeros(digits); let n = str_len(d);
   if or(lt(e,-6),gt(e,15)) then str_concat(substring(d,0,1),str_concat(if gt(n,1) then str_concat(".",substring(d,1,n)) else "",str_concat("e",int_to_str(e)))) else if lt(e,0) then str_concat("0.",str_concat(jpf-zeros(sub(sub(0,e),1)),d)) else if ge(e,sub(n,1)) then str_concat(d,jpf-zeros(sub(add(e,1),n))) else str_concat(substring(d,0,add(e,1)),str_concat(".",substring(d,add(e,1),n)));
  }
  def jpf-shortest(v,digits,e,n) {
   let pair = jpf-round(digits,n,e); let candidate = jpf-render(head(pair),nth(pair,1));
   if eq(str_to_float(candidate),v) then candidate else if ge(n,17) then jpf-render(digits,e) else jpf-shortest(v,digits,e,add(n,1));
  }
  def float-precise-str(v) {
   if not(eq(sub(v,v),0.0)) then form_error("non-finite value has no JSON number") else if eq(v,0.0) then "0" else jpf-signed(v,jpf-exact(abs(v)));
  }
  def jpf-signed(v,exact) = str_concat(if lt(v,0.0) then "-" else "",jpf-shortest(abs(v),head(exact),nth(exact,1),1));
  def json-precise-float(v) = json-node-float-text(float-precise-str(v));
  def json-emit-precise(node) {
   let cat = node_category(node);
   if node_eq(cat,JSON-OBJECT()) then str_concat("{",str_concat(jpf-children(node_children(node)),"}")) else if node_eq(cat,JSON-ARRAY()) then str_concat("[",str_concat(jpf-children(node_children(node)),"]")) else if node_eq(cat,JSON-PAIR()) then str_concat(json-quote-string(json-pair-key(node)),str_concat(":",json-emit-precise(json-pair-value(node)))) else if and(eq(node_level(node),1),eq(node_type(node),7)) then float-precise-str(node_value(node)) else json-emit(node);
  }
  def jpf-children(nodes) = if nil?(nodes) then "" else str_concat(json-emit-precise(head(nodes)),if nil?(tail(nodes)) then "" else str_concat(",",jpf-children(tail(nodes))));
 }
 0;
}
