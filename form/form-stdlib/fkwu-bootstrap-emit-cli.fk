; fkwu-bootstrap-emit-cli.fk — emit the generic table walker from Form on fkwu.
;
; This is the native maintainer door for the temporary checkout witness.  It
; replaces the Go proof-sibling regeneration path: the emitter recipe is Form,
; the evaluator is fkwu, and stdout is the generated C artifact.
;
; preludes: form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/host-io-fs-fkwu-emit.fk form-stdlib/fkc-table-serialize.fk form-stdlib/hati-os-kernel-emit.fk

(do
    ; The serializer prelude contains optional table-text doors.  Emitting the
    ; walker does not call them, but fkwu resolves every call site eagerly; this
    ; local signature keeps the unused optional door explicit on this lane.
    (defn form_table_text (roots rows) "")
    (fkc-emit-universal))
