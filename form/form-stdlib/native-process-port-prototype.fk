; native-process-port-prototype.fk -- isolated Form-authored native process port.
;
; This is deliberately NOT wired into form-cli, fsh, the turn controller, any
; adapter, or the C seed. It gives the next membrane a small executable shape
; that Form can emit today: an absolute argv crosses directly into execve; the
; parent's stdin, stdout, and stderr each cross through explicit pipes; and the
; parent returns the child's waitpid status. There is no command string, PATH
; lookup, shell parser, or network primitive in the emitted program.
;
; Invocation of the emitted carrier:
;   fk-native-process-port /absolute/program arg0 arg1 ...
;
; The parent side streams stdin to the child and forwards the child's stdout and
; stderr to its own descriptors. Its process exit status is the observed child
; exit (or 128 + signal). It is a transport prototype, not an authorization or
; retention policy: a future Form controller must bind identities, bounds,
; consent, and content-blind receipts before it can become a turn carrier.
;
; Compile its no-network native echo/cat/status witness with:
;   form/scripts/native_process_port_prototype_test.sh
;
; preludes: form-stdlib/core.fk

(do
    (defn fnpp-headers ()
        "#define _POSIX_C_SOURCE 200809L\n#include <errno.h>\n#include <fcntl.h>\n#include <poll.h>\n#include <signal.h>\n#include <stddef.h>\n#include <string.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n\nextern char **environ;\n\n")
    (defn fnpp-close-helper ()
        "static void fnpp_close_fd(int *fd) {\n    if (*fd >= 0) {\n        while (close(*fd) < 0 && errno == EINTR) { }\n        *fd = -1;\n    }\n}\n\n")
    (defn fnpp-io-helpers ()
        "static int fnpp_set_nonblock(int fd) {\n    int flags = fcntl(fd, F_GETFL, 0);\n    if (flags < 0) return -1;\n    return fcntl(fd, F_SETFL, flags | O_NONBLOCK);\n}\n\nstatic int fnpp_write_all(int fd, const char *buf, size_t count) {\n    size_t at = 0;\n    while (at < count) {\n        ssize_t wrote = write(fd, buf + at, count - at);\n        if (wrote > 0) {\n            at += (size_t)wrote;\n            continue;\n        }\n        if (wrote < 0 && errno == EINTR) continue;\n        return -1;\n    }\n    return 0;\n}\n\nstatic int fnpp_drain_to(int *from, int to) {\n    char buf[4096];\n    for (;;) {\n        ssize_t got = read(*from, buf, sizeof(buf));\n        if (got > 0) {\n            if (fnpp_write_all(to, buf, (size_t)got) < 0) return -1;\n            continue;\n        }\n        if (got == 0) {\n            fnpp_close_fd(from);\n            return 0;\n        }\n        if (errno == EINTR) continue;\n        if (errno == EAGAIN || errno == EWOULDBLOCK) return 0;\n        fnpp_close_fd(from);\n        return -1;\n    }\n}\n\nstatic int fnpp_status_code(int status) {\n    if (WIFEXITED(status)) return WEXITSTATUS(status);\n    if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);\n    return 125;\n}\n\n")
    (defn fnpp-port-main ()
        "static int fnpp_run(int argc, char **argv) {\n    int in_pipe[2] = { -1, -1 };\n    int out_pipe[2] = { -1, -1 };\n    int err_pipe[2] = { -1, -1 };\n    int source_open = 1;\n    int child_input_open = 1;\n    int child_status = 125;\n    int child_reaped = 0;\n    int failed = 0;\n    pid_t child = -1;\n    void (*old_sigpipe)(int) = SIG_DFL;\n    char input[4096];\n    size_t input_at = 0;\n    size_t input_end = 0;\n\n    /* Direct argv only: no PATH lookup and no command-string interpreter. */\n    if (argc < 2 || argv[1] == 0 || argv[1][0] != '/') return 64;\n    if (pipe(in_pipe) < 0 || pipe(out_pipe) < 0 || pipe(err_pipe) < 0) {\n        failed = 1;\n        goto done;\n    }\n\n    child = fork();\n    if (child < 0) {\n        failed = 1;\n        goto done;\n    }\n    if (child == 0) {\n        signal(SIGPIPE, SIG_DFL);\n        if (dup2(in_pipe[0], STDIN_FILENO) < 0 ||\n            dup2(out_pipe[1], STDOUT_FILENO) < 0 ||\n            dup2(err_pipe[1], STDERR_FILENO) < 0) _exit(126);\n        fnpp_close_fd(&in_pipe[0]);\n        fnpp_close_fd(&in_pipe[1]);\n        fnpp_close_fd(&out_pipe[0]);\n        fnpp_close_fd(&out_pipe[1]);\n        fnpp_close_fd(&err_pipe[0]);\n        fnpp_close_fd(&err_pipe[1]);\n        execve(argv[1], &argv[1], environ);\n        _exit(errno == ENOENT ? 127 : 126);\n    }\n\n    old_sigpipe = signal(SIGPIPE, SIG_IGN);\n    fnpp_close_fd(&in_pipe[0]);\n    fnpp_close_fd(&out_pipe[1]);\n    fnpp_close_fd(&err_pipe[1]);\n    if (fnpp_set_nonblock(in_pipe[1]) < 0 ||\n        fnpp_set_nonblock(out_pipe[0]) < 0 ||\n        fnpp_set_nonblock(err_pipe[0]) < 0) {\n        failed = 1;\n        goto done;\n    }\n\n    for (;;) {\n        struct pollfd watched[4];\n        int source_slot = -1;\n        int input_slot = -1;\n        int out_slot = -1;\n        int err_slot = -1;\n        int slots = 0;\n        int polled;\n\n        if (!child_reaped) {\n            pid_t seen = waitpid(child, &child_status, WNOHANG);\n            if (seen == child) {\n                child_reaped = 1;\n                if (child_input_open) {\n                    fnpp_close_fd(&in_pipe[1]);\n                    child_input_open = 0;\n                }\n            } else if (seen < 0 && errno != EINTR) {\n                failed = 1;\n                goto done;\n            }\n        }\n        if (!source_open && child_input_open && input_at == input_end) {\n            fnpp_close_fd(&in_pipe[1]);\n            child_input_open = 0;\n        }\n        if (child_reaped && out_pipe[0] < 0 && err_pipe[0] < 0) break;\n\n        if (source_open && child_input_open && input_at == input_end) {\n            source_slot = slots;\n            watched[slots].fd = STDIN_FILENO;\n            watched[slots].events = POLLIN;\n            watched[slots].revents = 0;\n            slots += 1;\n        }\n        if (child_input_open && input_at < input_end) {\n            input_slot = slots;\n            watched[slots].fd = in_pipe[1];\n            watched[slots].events = POLLOUT;\n            watched[slots].revents = 0;\n            slots += 1;\n        }\n        if (out_pipe[0] >= 0) {\n            out_slot = slots;\n            watched[slots].fd = out_pipe[0];\n            watched[slots].events = POLLIN;\n            watched[slots].revents = 0;\n            slots += 1;\n        }\n        if (err_pipe[0] >= 0) {\n            err_slot = slots;\n            watched[slots].fd = err_pipe[0];\n            watched[slots].events = POLLIN;\n            watched[slots].revents = 0;\n            slots += 1;\n        }\n        if (slots == 0) {\n            pid_t waited;\n            do { waited = waitpid(child, &child_status, 0); } while (waited < 0 && errno == EINTR);\n            if (waited != child) { failed = 1; goto done; }\n            child_reaped = 1;\n            continue;\n        }\n\n        polled = poll(watched, (nfds_t)slots, -1);\n        if (polled < 0) {\n            if (errno == EINTR) continue;\n            failed = 1;\n            goto done;\n        }\n        if (source_slot >= 0 && watched[source_slot].revents != 0) {\n            ssize_t got = read(STDIN_FILENO, input, sizeof(input));\n            if (got > 0) {\n                input_at = 0;\n                input_end = (size_t)got;\n            } else if (got == 0) {\n                source_open = 0;\n            } else if (errno != EINTR) {\n                failed = 1;\n                goto done;\n            }\n        }\n        if (input_slot >= 0 && watched[input_slot].revents != 0) {\n            if (watched[input_slot].revents & (POLLERR | POLLHUP | POLLNVAL)) {\n                fnpp_close_fd(&in_pipe[1]);\n                child_input_open = 0;\n            } else {\n                ssize_t wrote = write(in_pipe[1], input + input_at, input_end - input_at);\n                if (wrote > 0) {\n                    input_at += (size_t)wrote;\n                } else if (wrote < 0 && errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) {\n                    fnpp_close_fd(&in_pipe[1]);\n                    child_input_open = 0;\n                }\n            }\n        }\n        if (out_slot >= 0 && watched[out_slot].revents != 0) {\n            if (fnpp_drain_to(&out_pipe[0], STDOUT_FILENO) < 0) { failed = 1; goto done; }\n        }\n        if (err_slot >= 0 && watched[err_slot].revents != 0) {\n            if (fnpp_drain_to(&err_pipe[0], STDERR_FILENO) < 0) { failed = 1; goto done; }\n        }\n    }\n\ndone:\n    fnpp_close_fd(&in_pipe[0]);\n    fnpp_close_fd(&in_pipe[1]);\n    fnpp_close_fd(&out_pipe[0]);\n    fnpp_close_fd(&out_pipe[1]);\n    fnpp_close_fd(&err_pipe[0]);\n    fnpp_close_fd(&err_pipe[1]);\n    if (child > 0 && !child_reaped) {\n        int ignored_status;\n        kill(child, SIGTERM);\n        while (waitpid(child, &ignored_status, 0) < 0 && errno == EINTR) { }\n    }\n    if (child > 0) signal(SIGPIPE, old_sigpipe);\n    if (failed) return 125;\n    return fnpp_status_code(child_status);\n}\n\n")
    (defn fnpp-self-test ()
        "#ifdef FNPP_SELFTEST\nstatic int fnpp_selftest_case(char **argv, int argc, const char *input, size_t input_len, const char *want, size_t want_len, int want_status) {\n    int source[2] = { -1, -1 };\n    int captured[2] = { -1, -1 };\n    char got[4096];\n    size_t got_len = 0;\n    int status = 125;\n    pid_t child;\n    if (input_len > 0 && (pipe(source) < 0 || fnpp_write_all(source[1], input, input_len) < 0)) return 1;\n    if (input_len > 0) fnpp_close_fd(&source[1]);\n    if (pipe(captured) < 0) return 1;\n    child = fork();\n    if (child < 0) return 1;\n    if (child == 0) {\n        if (input_len > 0 && dup2(source[0], STDIN_FILENO) < 0) _exit(126);\n        if (dup2(captured[1], STDOUT_FILENO) < 0) _exit(126);\n        fnpp_close_fd(&source[0]);\n        fnpp_close_fd(&source[1]);\n        fnpp_close_fd(&captured[0]);\n        fnpp_close_fd(&captured[1]);\n        _exit(fnpp_run(argc, argv));\n    }\n    fnpp_close_fd(&source[0]);\n    fnpp_close_fd(&source[1]);\n    fnpp_close_fd(&captured[1]);\n    for (;;) {\n        ssize_t read_now = read(captured[0], got + got_len, sizeof(got) - got_len);\n        if (read_now > 0) { got_len += (size_t)read_now; continue; }\n        if (read_now == 0) break;\n        if (errno == EINTR) continue;\n        fnpp_close_fd(&captured[0]);\n        return 1;\n    }\n    fnpp_close_fd(&captured[0]);\n    while (waitpid(child, &status, 0) < 0 && errno == EINTR) { }\n    if (!WIFEXITED(status) || WEXITSTATUS(status) != want_status) return 1;\n    if (got_len != want_len) return 1;\n    return memcmp(got, want, want_len) == 0 ? 0 : 1;\n}\n\nstatic int fnpp_selftest(void) {\n    char port_name[] = { 102, 107, 45, 110, 97, 116, 105, 118, 101, 45, 112, 114, 111, 99, 101, 115, 115, 45, 112, 111, 114, 116, 0 };\n    char echo_program[] = { 47, 98, 105, 110, 47, 101, 99, 104, 111, 0 };\n    char echo_message[] = { 70, 79, 82, 77, 95, 78, 65, 84, 73, 86, 69, 95, 68, 73, 82, 69, 67, 84, 95, 65, 82, 71, 86, 0 };\n    char echo_want[] = { 70, 79, 82, 77, 95, 78, 65, 84, 73, 86, 69, 95, 68, 73, 82, 69, 67, 84, 95, 65, 82, 71, 86, 10 };\n    char cat_program[] = { 47, 98, 105, 110, 47, 99, 97, 116, 0 };\n    char stdin_text[] = { 70, 79, 82, 77, 95, 78, 65, 84, 73, 86, 69, 95, 83, 84, 68, 73, 78, 10 };\n    char false_program[] = { 47, 117, 115, 114, 47, 98, 105, 110, 47, 102, 97, 108, 115, 101, 0 };\n    char empty[] = { 0 };\n    char *echo_argv[] = { port_name, echo_program, echo_message, 0 };\n    char *cat_argv[] = { port_name, cat_program, 0 };\n    char *false_argv[] = { port_name, false_program, 0 };\n    if (fnpp_selftest_case(echo_argv, 3, empty, 0, echo_want, 24, 0) != 0) return 1;\n    if (fnpp_selftest_case(cat_argv, 2, stdin_text, 18, stdin_text, 18, 0) != 0) return 2;\n    if (fnpp_selftest_case(false_argv, 2, empty, 0, empty, 0, 1) != 0) return 3;\n    return 0;\n}\n\nint main(void) { return fnpp_selftest(); }\n#else\nint main(int argc, char **argv) { return fnpp_run(argc, argv); }\n#endif\n")
    (defn fnpp-emit ()
        (str_concat (fnpp-headers)
        (str_concat (fnpp-close-helper)
        (str_concat (fnpp-io-helpers)
        (str_concat (fnpp-port-main) (fnpp-self-test))))))
    (fnpp-emit))
