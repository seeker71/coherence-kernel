; form-knowledge-query-memory-neutral.fk — the crossing with its answer stage
; left OPEN. A caller names who answers, or nothing crosses.
;
; WHY THIS CELL IS SEPARATE AND STAYS EMPTY OF CARRIAGE. The earlier crossing
; cell reached a peer directly, which made a machine address part of the primary
; path: every caller inherited a dependency on something listening somewhere.
; This cell inherits none. Its answer stage is a hole, and the shape that fills
; it is a function value over an opaque caller context — the idiom
; form-cli-heed-cursor.fk states and form-cli-model-generate.fk already uses to
; hand a live model to a cursor without the cursor naming one.
;
;   (answerer actx prompt) -> (list reply actx')
;
; That return shape is not invented here. It is exactly what
; fcmg-generate-resident already answers, so the resident Form-native generator
; needs no wrapper at all, and a comparator needs an adapter rather than a place
; in this file.
;
; NO DEFAULT AND NO FALLBACK. fqmn-cross takes the answerer and the caller
; context as ordinary arguments. There is no four-argument variant, no ambient
; choice, and no "if none was given, use X". Omitting an answerer is a missing
; argument, not a quiet decision made on the caller's behalf. That is the whole
; mechanism by which a comparator can never become primary by accident.
;
; THE CALLER CONTEXT IS THREADED, NEVER HELD. actx goes in, actx' comes back,
; and this cell never looks inside either. A residence that must survive across
; calls survives because the caller keeps what it was handed back — the same
; discipline fcmg's own residence follows.
;
; WHAT A FILE-WIDE READING OF THIS SOURCE SHOULD FIND. Zero occurrences of a
; machine address, a listening number, a wire verb, or the two words that name
; either end of a connection. The band asserts exactly that against these bytes,
; because a topology claim that lives only in a comment is a claim about what
; somebody meant rather than about what the file says.
;
; NOTHING IS NOT ZERO, AT EVERY STAGE. A stage that could not run says nothing —
; axiom-1's third state. A stage that ran and found none says so as a grounded
; answer. A refusing answerer yields nothing, never an empty string dressed as a
; reply.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk
; preludes: form-stdlib/form-knowledge-query-memory-exec.fk
;
; Proven by: form-stdlib/tests/form-knowledge-query-memory-neutral-band.fk

(do
    ; ── frames, owned here so this cell depends on no carriage-bearing kin ──
    (defn fqmn-frame (stage state detail) (list "frame" stage state detail))
    (defn fqmn-frame-stage (f)  (nth f 1))
    (defn fqmn-frame-state (f)  (nth f 2))
    (defn fqmn-frame-detail (f) (nth f 3))

    (defn fqmn-state-ran ()     "ran")
    (defn fqmn-state-refused () "refused")
    (defn fqmn-state-nothing () "nothing")
    (defn fqmn-state? (s)
        (if (or (str_eq s (fqmn-state-ran))
                (or (str_eq s (fqmn-state-refused))
                    (str_eq s (fqmn-state-nothing)))) 1 0))
    (defn fqmn-nothing-frame? (f)
        (if (str_eq (fqmn-frame-state f) (fqmn-state-nothing)) 1 0))

    (defn fqmn-stage-at (frames i)
        (if (lt i (len frames)) (nth frames i) (nothing)))

    ; ── a peer that thinks out loud, and the thought is not the answer ─────
    ; A reply may open a deliberation block. Handing that block back as the
    ; answer would answer with the route instead of the destination, and
    ; handing back a cut-off one would answer with a fragment of a route. The
    ; closing mark is the seam; an unfinished deliberation is nothing.
    (defn fqmn-think-open ()  "<think>")
    (defn fqmn-think-close () "</think>")
    (defn fqmn-trim-loop (s i n)
        (if (ge i n) ""
            (do (let b (str_byte_at s i))
                (if (or (eq b 32) (or (eq b 10) (or (eq b 13) (eq b 9))))
                    (fqmn-trim-loop s (add i 1) n)
                    (substring s i n)))))
    (defn fqmn-trim (s) (fqmn-trim-loop s 0 (str_len s)))
    (defn fqmn-answer-part (reply)
        (do (let at (str_find reply (fqmn-think-close) 0))
            (if (lt at 0)
                (if (ge (str_find reply (fqmn-think-open) 0) 0) (nothing)
                    (fqmn-trim reply))
                (fqmn-trim (substring reply
                    (add at (str_len (fqmn-think-close))) (str_len reply))))))

    ; ── what the answer stage carries ──────────────────────────────────────
    (defn fqmn-cat3 (a b c) (str_concat a (str_concat b c)))
    (defn fqmn-answer-prompt (observation question)
        (fqmn-cat3
            "Answer only from the observation below. If it does not contain the answer, reply exactly: nothing.\n\n"
            observation
            (fqmn-cat3 "\n\nQuestion: " question "\nAnswer: ")))

    ; ── the crossing ───────────────────────────────────────────────────────
    ; Returns (list frames actx'). Frames come back in every outcome, so a
    ; crossing that stopped says WHERE, and the caller always receives its
    ; context back even when nothing was asked of it.
    (defn fqmn-result (frames actx) (list frames actx))
    (defn fqmn-frames-of (r) (nth r 0))
    (defn fqmn-ctx-of (r)    (nth r 1))

    (defn fqmn-answer-of (r)
        (do (let f (fqmn-stage-at (fqmn-frames-of r) 4))
            (if (nothing? f) (nothing)
                (if (eq (fqmn-nothing-frame? f) 1) (nothing)
                    (fqmn-frame-detail f)))))

    (defn fqmn-cross (index-path request question answerer actx)
        (do
            (let reason (fkqmx-refuse-reason request))
            (if (not (str_eq reason "ready"))
                (fqmn-result
                    (list (fqmn-frame "request" (fqmn-state-refused) reason))
                    actx)
                (do
                    (let recipe (fkqmx-request-recipe request))
                    (let bytes (fkqmx-query-bytes recipe))
                    (let obs (fkqmx-execute-at index-path request 0))
                    (let status (fkqmx-obs-status obs))
                    (let f1 (fqmn-frame "request" (fqmn-state-ran) reason))
                    (let f2 (fqmn-frame "query" (fqmn-state-ran) bytes))
                    (let f3 (fqmn-frame "lookup" (fqmn-state-ran) status))
                    (if (not (str_eq status "hit"))
                        ; the lookup RAN and found nothing to answer from, so
                        ; the answerer is never called: an unasked stage is
                        ; nothing, and a lookup that ran is not an absence
                        (fqmn-result
                            (list f1 f2 f3
                                (fqmn-frame "ask" (fqmn-state-nothing) status)
                                (fqmn-frame "answer" (fqmn-state-nothing) status))
                            actx)
                        (do
                            (let span (fkqmx-obs-span obs))
                            (let out (answerer actx
                                (fqmn-answer-prompt span question)))
                            (let reply (nth out 0))
                            (let actx2 (nth out 1))
                            (if (nothing? reply)
                                (fqmn-result
                                    (list f1 f2 f3
                                        (fqmn-frame "ask" (fqmn-state-ran) "asked")
                                        (fqmn-frame "answer" (fqmn-state-nothing)
                                            "answerer-declined"))
                                    actx2)
                                (do (let part (fqmn-answer-part reply))
                                    (if (nothing? part)
                                        (fqmn-result
                                            (list f1 f2 f3
                                                (fqmn-frame "ask" (fqmn-state-ran) "asked")
                                                (fqmn-frame "answer" (fqmn-state-nothing)
                                                    "deliberation-unfinished"))
                                            actx2)
                                        (fqmn-result
                                            (list f1 f2 f3
                                                (fqmn-frame "ask" (fqmn-state-ran) "asked")
                                                (fqmn-frame "answer" (fqmn-state-ran) part))
                                            actx2))))))))))

    (defn fqmn-model-executed () 0)

    0)
