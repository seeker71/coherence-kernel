; living-world-recursive-proposal.fk -- nested recurrence asks the whole field.
;
; Distinct supporting correspondences must meet the offered threshold.  Every
; active support and counterexample attribution becomes a witness and every
; contributing source becomes a participant.  Readiness is evidence, never
; authority; the ordinary tending offer/ack cycle remains the only door.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-recursive-evidence.fk

(let LWRR-ORIGIN (bp "LWRR-ORIGIN"))

(defn lwrr-origin (signature evidence-set witnesses)
    (intern_node LWRR-ORIGIN
        (list signature (lwrr-evidence-supports evidence-set)
              (lwrr-evidence-counterexamples evidence-set)
              (lwrr-evidence-observations evidence-set) witnesses)))

(defn lwrr-proposal-evidence-ready? (signature evidence-set threshold)
    (if (and (eq (lwrr-signature-valid? signature) 1)
             (ge (lwo-field-size (lwrr-evidence-supports evidence-set))
                 threshold)) 1 0))

(defn lwrr-proposal-from-evidence (signature evidence-set threshold)
    (do
        (let witnesses (lwrr-evidence-witnesses evidence-set))
        (let mapping (lwrr-mapping-for signature evidence-set))
        (let origin (lwrr-origin signature evidence-set witnesses))
        (let candidate
            (lwo-emergent mapping witnesses
                (intern_trivial_int
                    (lwo-field-size (lwrr-evidence-supports evidence-set)))
                (intern_trivial_int
                    (lwrr-ref-count (lwrr-signature-template signature)))
                (intern_trivial_int threshold) origin))
        (lwt-proposal candidate
            (lwt-sources-from-attributions
                (lwo-field-items witnesses) (lwo-empty-field))
            origin)))

(defn lwrr-proposal-for (world correspondence threshold)
    (if (or (eq (lwr-correspondence? correspondence) 0)
            (eq (lwo-active? world correspondence) 0))
        (lwo-none)
        (do
            (let signature (lwrr-signature-for correspondence))
            (let evidence-set (lwrr-evidence-set-for world signature))
            (if (eq (lwrr-proposal-evidence-ready?
                        signature evidence-set threshold) 0)
                (lwo-none)
                (lwrr-proposal-from-evidence
                    signature evidence-set threshold)))))

(defn lwrr-proposals-items (world items threshold acc)
    (if (eq (len items) 0) acc
        (do
            (let proposal (lwrr-proposal-for world (head items) threshold))
            (lwrr-proposals-items world (tail items) threshold
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwrr-proposals (world threshold)
    (lwrr-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwrr-tend (world entries threshold prior)
    (do
        (let received (lwt-receive-stream world entries))
        (lwt-round received (lwrr-proposals received threshold)
                   (lwo-empty-field) prior)))
