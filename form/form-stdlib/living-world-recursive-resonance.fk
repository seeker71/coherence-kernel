; living-world-recursive-resonance.fk -- nested structure can become a lens.
;
; A recursive correspondence lens is derived only from present composition.
; Every source tree becomes a value-abstract skeleton of categories and arities.
; A target subtree identical to exactly one source subtree becomes a path
; reference.  Multiple source occurrences remain ambiguous.  An unmatched
; target composite is rebuilt recursively; an unmatched leaf remains an
; observed constant.  Nothing here names a language, domain, task, or answer.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk

(let LWRR-SKELETON  (bp "LWRR-SKELETON"))
(let LWRR-ATOM      (bp "LWRR-ATOM"))
(let LWRR-PATH      (bp "LWRR-PATH"))
(let LWRR-REF       (bp "LWRR-REF"))
(let LWRR-CONSTANT  (bp "LWRR-CONSTANT"))
(let LWRR-AMBIGUOUS (bp "LWRR-AMBIGUOUS"))
(let LWRR-SEQUENCE  (bp "LWRR-SEQUENCE"))
(let LWRR-BUILD     (bp "LWRR-BUILD"))
(let LWRR-SIGNATURE (bp "LWRR-SIGNATURE"))

; --- value-abstract recursive skeleton -----------------------------------
(defn lwrr-skeleton-items (items)
    (if (eq (len items) 0) (empty)
        (cons (lwrr-skeleton (head items))
              (lwrr-skeleton-items (tail items)))))

(defn lwrr-skeleton (cell)
    (if (eq (len (node_children cell)) 0)
        ; An indivisible value has an atomic structural role.  Its exact
        ; identity remains in the correspondence/template evidence; it must
        ; not become an imported vocabulary class in the domain skeleton.
        (intern_node LWRR-SKELETON (list LWRR-ATOM))
        (intern_node LWRR-SKELETON
            (cons (node_category cell)
                  (lwrr-skeleton-items (node_children cell))))))

; --- source-tree paths and exact occurrences -----------------------------
(defn lwrr-path (indexes) (intern_node LWRR-PATH indexes))
(defn lwrr-empty-path () (lwrr-path (empty)))
(defn lwrr-path-items (path) (node_children path))
(defn lwrr-path-append (path index)
    (lwrr-path
        (append (lwrr-path-items path)
                (list (intern_trivial_int index)))))

(defn lwrr-find-paths-items (items wanted path index acc)
    (if (eq (len items) 0) acc
        (do
            (let child-path (lwrr-path-append path index))
            (let with-child
                (lwrr-find-paths-node (head items) wanted child-path acc))
            (lwrr-find-paths-items (tail items) wanted path
                                   (add index 1) with-child))))

(defn lwrr-find-paths-node (cell wanted path acc)
    (do
        (let with-self
            (if (node_eq cell wanted) (lwo-field-add acc path) acc))
        (lwrr-find-paths-items (node_children cell) wanted path 0 with-self)))

(defn lwrr-find-paths (source wanted)
    (lwrr-find-paths-node source wanted (lwrr-empty-path)
                          (lwo-empty-field)))

; --- recursive target template -------------------------------------------
(defn lwrr-ref (path) (intern_node LWRR-REF (list path)))
(defn lwrr-constant (cell) (intern_node LWRR-CONSTANT (list cell)))
(defn lwrr-ambiguous (cell paths)
    (intern_node LWRR-AMBIGUOUS (list cell paths)))
(defn lwrr-sequence (items) (intern_node LWRR-SEQUENCE items))
(defn lwrr-build (category templates)
    (intern_node LWRR-BUILD (list category (lwrr-sequence templates))))

(defn lwrr-ref? (term) (lwo-category? term LWRR-REF))
(defn lwrr-constant? (term) (lwo-category? term LWRR-CONSTANT))
(defn lwrr-ambiguous? (term) (lwo-category? term LWRR-AMBIGUOUS))
(defn lwrr-build? (term) (lwo-category? term LWRR-BUILD))
(defn lwrr-ref-path (term) (nth (node_children term) 0))
(defn lwrr-constant-cell (term) (nth (node_children term) 0))
(defn lwrr-build-category (term) (nth (node_children term) 0))
(defn lwrr-build-templates (term)
    (node_children (nth (node_children term) 1)))

(defn lwrr-template-items (source target-items)
    (if (eq (len target-items) 0) (empty)
        (cons (lwrr-template-for source (head target-items))
              (lwrr-template-items source (tail target-items)))))

(defn lwrr-template-for (source target)
    (do
        (let paths (lwrr-find-paths source target))
        (let count (lwo-field-size paths))
        (if (eq count 1)
            (lwrr-ref (head (lwo-field-items paths)))
            (if (gt count 1)
                (lwrr-ambiguous target paths)
                (if (eq (len (node_children target)) 0)
                    (lwrr-constant target)
                    (lwrr-build (node_category target)
                        (lwrr-template-items source
                                             (node_children target))))))))

; --- transparent template counts -----------------------------------------
(defn lwrr-ref-count-items (items)
    (if (eq (len items) 0) 0
        (add (lwrr-ref-count (head items))
             (lwrr-ref-count-items (tail items)))))
(defn lwrr-ref-count (term)
    (if (eq (lwrr-ref? term) 1) 1
        (if (eq (lwrr-build? term) 1)
            (lwrr-ref-count-items (lwrr-build-templates term)) 0)))

(defn lwrr-ambiguous-count-items (items)
    (if (eq (len items) 0) 0
        (add (lwrr-ambiguous-count (head items))
             (lwrr-ambiguous-count-items (tail items)))))
(defn lwrr-ambiguous-count (term)
    (if (eq (lwrr-ambiguous? term) 1) 1
        (if (eq (lwrr-build? term) 1)
            (lwrr-ambiguous-count-items (lwrr-build-templates term)) 0)))

(defn lwrr-constant-count-items (items)
    (if (eq (len items) 0) 0
        (add (lwrr-constant-count (head items))
             (lwrr-constant-count-items (tail items)))))
(defn lwrr-constant-count (term)
    (if (eq (lwrr-constant? term) 1) 1
        (if (eq (lwrr-build? term) 1)
            (lwrr-constant-count-items (lwrr-build-templates term)) 0)))

; children: source skeleton, target skeleton, recursive target template
(defn lwrr-signature (source-skeleton target-skeleton template)
    (intern_node LWRR-SIGNATURE
        (list source-skeleton target-skeleton template)))
(defn lwrr-signature-source-skeleton (signature)
    (nth (node_children signature) 0))
(defn lwrr-signature-target-skeleton (signature)
    (nth (node_children signature) 1))
(defn lwrr-signature-template (signature)
    (nth (node_children signature) 2))

(defn lwrr-signature-for (correspondence)
    (do
        (let source (lwr-correspondence-source correspondence))
        (let target (lwr-correspondence-target correspondence))
        (lwrr-signature (lwrr-skeleton source) (lwrr-skeleton target)
                        (lwrr-template-for source target))))

(defn lwrr-signature-domain-eq? (a b)
    (if (and (node_eq (lwrr-signature-source-skeleton a)
                      (lwrr-signature-source-skeleton b))
             (node_eq (lwrr-signature-target-skeleton a)
                      (lwrr-signature-target-skeleton b))) 1 0))

(defn lwrr-signature-valid? (signature)
    (do
        (let template (lwrr-signature-template signature))
        (if (and (gt (lwrr-ref-count template) 0)
                 (eq (lwrr-ambiguous-count template) 0)) 1 0)))
