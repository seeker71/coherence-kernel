//////////////////////////////////////////////////////////////////////
//
// form-cli-jit.bml
//
// The JIT is Form. One thought, emitted on demand onto whatever organ
// can run it. C does not own the algorithm. C installs and calls.
//
//   f(n) = n * Mul + Add     sample 5 -> 22
//
// CPU   — form-lower emits AArch64; jit_leaf_inram and form_cpu_jit run it
// Metal — this class emits MSL; metal_pipeline compiles it on the GPU
// MLX   — this class emits postfix; mlx_run is the dumb stack
//
// Proven by: form-stdlib/tests/form-cli-jit-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormJit<T> {
        field Mul = 3;
        field Add = 7;
        field Sample = 5;
        field Expect = 22;
        field CpuDoor = "jit_leaf_inram";
        field MetalDoor = "metal_pipeline";
        field MlxDoor = "mlx_run";

        thought fjit-pattern = list("cpu", "metal", "mlx");

        def fjit-spc() = " ";
        def fjit-nl() = byte_to_str(10);

        def fjit-mlx(n) = str_concat(int_to_str(n), str_concat(fjit-spc(), str_concat(int_to_str(Mul()), str_concat(" mul ", str_concat(int_to_str(Add()), " add")))));

        def fjit-msl() {
            let n = fjit-nl();
            str_concat("#include <metal_stdlib>", str_concat(n, str_concat("using namespace metal;", str_concat(n, str_concat("kernel void form_jit_f(device uint *a [[buffer(0)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] * ", str_concat(int_to_str(Mul()), str_concat(" + ", str_concat(int_to_str(Add()), "; }"))))))));
        }

        def fjit-check() {
            let b0 = if eq(Mul(), 3) then if eq(Add(), 7) then 1 else 0 else 0;
            let b1 = if eq(Sample(), 5) then if eq(Expect(), 22) then 2 else 0 else 0;
            let b2 = if str_eq(fjit-mlx(Sample()), "5 3 mul 7 add") then 4 else 0;
            let b3 = if str_eq(CpuDoor(), "jit_leaf_inram") then 8 else 0;
            let b4 = if str_eq(MetalDoor(), "metal_pipeline") then 16 else 0;
            let b5 = if str_eq(MlxDoor(), "mlx_run") then 32 else 0;
            add(b0, add(b1, add(b2, add(b3, add(b4, b5)))));
        }
    }
    0;
}
