// form-cli-model-spec.fk — the model session's speculative walk: what a plain Qwen session owns beside its target, and how the session holds it.
//
// A plain Qwen3.8-27B session (form-cli-model-session.fk) says its greedy tokens speculatively by default: the DFlash2 block-diffusion drafter
// (a 2 GB Q8_0 file beside the target's) proposes a block, the target checks it in one weight pass on the matrix unit, and what it accepts is bandwidth the
// wall did not charge for (qwen35-dense-session-spec.fk holds the walk and its contract; qwen35-dense-dflash.fk the drafter).
//
// WHERE IT LIVES. Slot 19 of the session record (after the adapter carrier 15, the sampler 16, the cursor epoch 17, the draft lane 18) holds the OWNER, one mutable
// record: the drafter, its scratch and the walk's persistent choices. Every copy of the session (fcms-with-stream, fcmd-inherit) carries it.
//   open      fcms-open-granted opens it after the target's context and state, before the prompt's prefill, so the prefill's own batch captures the five tapped
//             hidden states the drafter reads (the tap, q38-lm-layers-span-t) and commits them as it goes: a prompt is never run twice, and the drafter is the
//             prompt's by the time the open returns. The drafter's file pages are mapped and touched lazily (the head's rows at the first prefill slice, each layer's
//             weights at the first draft), and its memory is leased beside the target's (mg-lease with the empty key adds to this process's promise).
//   observe   every observation's prefill (fcms-observe-ids) carries the tap too; a renewal's fresh stream re-arms it (fcmr-prefill-of).
//   generate  the greedy walk of a plain session is the speculative one (fcms-generate-spec) while the owner is ready: the drafter holds every position the stream
//             holds, in this stream, and the measured yield beats the plain token. Anything else is the plain planned walk, and the generation says why:
//             a fifth element of the generation (fcms-generation-spec) names the reason or reports the walk (never a silent downgrade).
//   release   fcms-release-ok? closes the drafter and its scratch with the same expected-against-closed count as every other owner.
// Off by choice: FORM_SPEC=off in the environment. The drafter's file: FORM_SPEC_DRAFT, or the sibling of the target (models/qwen38-dflash2/).
import native/metal/qwen35-dense-session-spec.fk;
import form-stdlib/bml/memory-governor.bml;
section [form.bml] {
    def fcsp-slot() = 19;
    def fcsp-target-tail() = "/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
    def fcsp-drafter-tail() = "/qwen38-dflash2/Qwen3.8-27B-DFlash2-Q8_0.gguf";
    def fcsp-tail?(path, tail) = len(path) > len(tail) && (String) substring(path, len(path) - len(tail), len(path)) == tail;
    def fcsp-drafter-path(path) = {
        let named = host_getenv("FORM_SPEC_DRAFT") ?? "";
        (String) named != "" ? named : fcsp-tail?(path, fcsp-target-tail()) ? substring(path, 0, len(path) - len(fcsp-target-tail())) ++ fcsp-drafter-tail() : "";
    };
    def fcsp-wanted?() = (String) (host_getenv("FORM_SPEC") ?? "") != "off";
    // ── the owner in the session ──
    def fcsp-owner(s) = len(s) > fcsp-slot() ? s[fcsp-slot()] : nothing();
    def fcsp-pad(s) = len(s) >= fcsp-slot() ? s : fcsp-pad(append(s, [len(s) == 17 || len(s) == 18 ? nothing() : []]));
    def fcsp-with-owner(s, o) = append(take(fcsp-slot(), fcsp-pad(s)), cons(o, drop(fcsp-slot() + 1, s)));
    def fcsp-has?(s) = !nothing?(fcsp-owner(s)) && (String) value_kind(fcsp-owner(s)) == "record" ? 1 : 0;
    // the minimum walk the speculative step is taken for: one id is the pending token alone (no forward in either walk)
    def fcsp-min-walk() = 2;
    def fcsp-tap(s) = q38x-tap(fcsp-owner(s));
    // the stream the owner belongs to: the first handle of the stream state (every handle carries its allocation's generation)
    def fcsp-stamp(sts) = len(sts) > 0 ? nth(sts, 0)[0] : 0;
    def fcsp-attach(s, o, sts) = {
        record_set(o, "stamp", fcsp-stamp(sts));
        fcsp-with-owner(s, o);
    };
    // a renewal's fresh stream: the owner's context starts again at position 0 and the new stream is its stream (the old stream's rows are overwritten as the new ones commit)
    def fcsp-renew-tap(s) = fcsp-has?(s) == 1 && q38x-on?(fcsp-owner(s)) == 1 ? {
        record_set(fcsp-owner(s), "stamp", nothing());
        record_set(fcsp-owner(s), "committed", 0);
        fcsp-tap(s);
    } : nothing();
    def fcsp-restamp(s, sts) = fcsp-has?(s) == 1 ? {
        record_set(fcsp-owner(s), "stamp", fcsp-stamp(sts));
        s;
    } : s;
    // ── open ──
    // the owner for a stream context: opened and leased, or a record that names why speculation is off for this session
    def fcsp-open(path,ctx,maxpos) = fcsp-open-retaining(path,ctx,maxpos,q38x-off("spec-opening"));
    def fcsp-off(owner,reason) {record_set(owner,"reason",reason);owner;}
    def fcsp-open-retaining(path,ctx,maxpos,owner) = !fcsp-wanted?() ? fcsp-off(owner,"spec-off:disabled-by-FORM_SPEC") : fcsp-open-for-owned(owner,path,ctx,maxpos,fcsp-drafter-path(path));
    // A single-token cursor cannot use a drafted block. Choose its owner before
    // prefill so it never leases a drafter or records hidden states for one.
    def fcsp-open-plain(path, ctx, maxpos) = q38x-off("spec-off:single-token-cursor");
    def fcsp-open-plain-retaining(path,ctx,maxpos,owner) = fcsp-off(owner,"spec-off:single-token-cursor");
    def fcsp-open-for(path,ctx,maxpos,dpath) = fcsp-open-for-owned(q38x-off("spec-opening"),path,ctx,maxpos,dpath);
    def fcsp-open-for-owned(owner,path,ctx,maxpos,dpath) = (String) dpath == "" ? fcsp-off(owner,"spec-off:no-drafter-for-model") : len(ctx) < 11 || q38-ctx-span(ctx) < 2 ? fcsp-off(owner,"spec-off:prefill-span-1") : (file_size(dpath) ?? 0) <= 0 ? fcsp-off(owner,"spec-off:drafter-file-missing") : fcsp-lease(owner,ctx,maxpos,dpath);
    def fcsp-lease(owner,ctx,maxpos,dpath) = {
        let shared = file_size(dpath);
        let plan=q38x-plan(ctx,dpath,maxpos);let own=q38x-own-bytes(plan);
        let granted=mg-lease-retaining("drafter " ++ dpath,dpath,shared,own,token=>record_set(owner,"reservation",token));
        let token=mg-reservation-of(granted);
        if record?(token) then record_set(owner,"reservation",token) else 0;
        record_set(owner,"lease-bytes",shared+own);
        record_set(owner,"allocation-bytes",own);record_set(owner,"drafter-layers",plan[0][2]);record_set(owner,"capture-rows",plan[0][3]);
        if !mg-granted?(granted) then fcsp-off(owner,"spec-off:drafter-memory-held:" ++ granted[1]) else q38x-open-owned(owner,ctx,dpath,maxpos,plan);
        if mg-granted?(granted) && q38x-on?(owner)==1 then mg-reservation-ack(mg-reservation-part(token,"allocation"),own) else 0;
        if q38x-owned(owner)==0 then fcsp-release-reservation(owner) else 0;
        owner;
    };
    def fcsp-release-reservation(owner) = !record?(owner) || !record?(record_get(owner,"reservation")) ? 1 : q38x-owned(owner)>0 ? 0 : {
        let returned=mg-reservation-release(record_get(owner,"reservation"));
        if returned then record_set(owner,"lease-bytes",0) else 0;returned;
    };
    // ── the walk's report ──
    // "spec dflash: 31 tokens, 6 speculative steps (51/10 tokens a step, next k 7, yield 4110/1000 of a plain token), 480 ms" or "spec-off:<why>"
    def fcsp-report(o, walked, ms) = {
        let st = walked[4];
        "spec dflash: " ++ len(walked[0]).str() ++ " tokens, " ++ st[2].str() ++ " speculative steps (" ++ (st[2] <= 0 ? 0 : (st[3] * 10) / st[2]).str() ++ "/10 tokens a step, next k " ++ st[1].str() ++ ", yield " ++ q38x-yield(st[0]).str() ++ "/1000 of a plain token), " ++ ms.str() ++ " ms";
    };
    // one line a walk, for a session that has a drafter: the live log of a long turn says which walks were speculative, how long each took and why one was not
    def fcsp-announce(mode, tokens, ms, note) = {
        let said = print_str("form-session-walk " ++ mode ++ " tokens=" ++ tokens.str() ++ " ms=" ++ ms.str() ++ " " ++ note);
        note;
    };
    def fcsp-owned(s) = q38x-owned(fcsp-owner(s));
    def fcsp-close(s) = q38x-close(fcsp-owner(s));
    0;
}
