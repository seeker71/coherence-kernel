// form-nodeid-knowledge-query.fk -- a scannerless local-stream request joins
// the persisted public-source concept shards to the existing current-source
// knowledge result and typed-observation path.
//
// SURFACE:
//   <|form:nodeid-knowledge-query|>concept=<bounded-concept-key><|/form:nodeid-knowledge-query|>
//   <|form:nodeid-knowledge-query|>nodeid=@p.l.t.i<|/form:nodeid-knowledge-query|>
//
// The caller supplies a concept coordinate or a reconstructed source/entry
// NodeID, never a source path.  bmf-core's immutable raw-byte cursor consumes
// the surface with explicit fuel before parsing.  A ready request performs one
// registry lookup.  A unique current shard then supplies the one exact path to
// form-cli-heed-current-source's existing bounded one-file result/observation
// functions.  No tokenizer, global source scan, flattened table, ops table, C,
// model call, Metal call, or remote lane participates.
//
// IDENTITIES.  The registry's original source and entry NodeIDs remain direct
// children of bridge source/entry tokens.  The bridge request, executor and
// observation are separate content-addressed nodes.  Their five reserved
// categories are, respectively, 31.2.0.96 through 31.2.0.100.  The observation
// also retains the existing fhcs typed current-source observation NodeID.
//
// STATES.  hit, miss and nothing do not collapse.  stale and ambiguous are
// explicit registry outcomes; timeout and failure are explicit cursor/parser
// outcomes.  Lifecycle traces retain choice/cut/undo/refine/release.  Every
// observation carries literal 0/1 flags and model-executed=0.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/bmf-core.fk
// preludes: form-stdlib/form-knowledge-query-token.fk
// preludes: form-stdlib/form-knowledge-source-search.fk
// preludes: form-stdlib/form-cli-heed-current-source.fk
// preludes: form-stdlib/public-source-concept-index.fk
// preludes: form-stdlib/public-source-concept-shards.fk
//
section [form.bml] {
    // ---- grammar and bounds ---------------------------------------------
    def fknq-open() = "<|form:nodeid-knowledge-query|>";
    def fknq-close() = "<|/form:nodeid-knowledge-query|>";
    def fknq-observation-open() = "<|form:nodeid-knowledge-observation|>";
    def fknq-observation-close() = "<|/form:nodeid-knowledge-observation|>";
    def fknq-max-payload-bytes() = 96;
    def fknq-max-frame-bytes() = str_len(fknq-open()) + (fknq-max-payload-bytes() + str_len(fknq-close()));
    def fknq-max-lookups() = 1;
    def fknq-default-artifact() = fs-path-join(fs-temp-dir(), "public-source-concept-registry-v1");
    // ---- five explicit bridge identities -------------------------------
    def fknq-source-category() = make_nodeid(31, 2, 0, 96);
    def fknq-entry-category() = make_nodeid(31, 2, 0, 97);
    def fknq-request-category() = make_nodeid(31, 2, 0, 98);
    def fknq-executor-category() = make_nodeid(31, 2, 0, 99);
    def fknq-observation-category() = make_nodeid(31, 2, 0, 100);
    def fknq-absent() = psci-absent-node();
    def fknq-node-or-absent(node) = nothing?(node) ? fknq-absent() : node;
    def fknq-node-key(node) = str_concat("@", psci-node-key(node));
    // These wrappers preserve, rather than replace, the registry identities.
    def fknq-source-token(source) = intern_node(fknq-source-category(), [source, intern_trivial_string(psci-source-family(source)), intern_trivial_string(psci-source-path(source)), intern_trivial_string(psci-source-id(source))]);
    def fknq-source-token-valid?(token) = nothing?(token) ? 0 : !node_eq(node_category(token), fknq-source-category()) ? 0 : !((Comparable) len(node_children(token)) == 4) ? 0 : psci-source-node-valid?(head(node_children(token)));
    def fknq-source-original(token) = head(node_children(token));
    def fknq-entry-token(entry) = intern_node(fknq-entry-category(), [entry, fknq-source-token(psci-entry-source(entry)), intern_trivial_int(len(psci-entry-keys(entry)))]);
    def fknq-entry-token-valid?(token) = nothing?(token) ? 0 : !node_eq(node_category(token), fknq-entry-category()) ? 0 : !((Comparable) len(node_children(token)) == 3) ? 0 : psci-entry-valid?(head(node_children(token)));
    def fknq-entry-original(token) = head(node_children(token));
    def fknq-request-token(kind, coordinate) = intern_node(fknq-request-category(), [intern_trivial_string(kind), intern_trivial_string(coordinate), intern_trivial_int(fknq-max-payload-bytes()), intern_trivial_int(fknq-max-lookups()), intern_trivial_int(0), intern_trivial_string("bmf-core-raw-byte-cursor-v1")]);
    def fknq-request-kind(request) = node_value(node_children(request)[0]);
    def fknq-request-coordinate(request) = node_value(node_children(request)[1]);
    def fknq-request-valid?(request) = nothing?(request) ? 0 : !node_eq(node_category(request), fknq-request-category()) ? 0 : !((Comparable) len(node_children(request)) == 6) ? 0 : !((Comparable) node_value(node_children(request)[3]) == 1) ? 0 : !((Comparable) node_value(node_children(request)[4]) == 0) ? 0 : (String) fknq-request-kind(request) == "concept" ? psci-concept-key-valid?(fknq-request-coordinate(request)) : (String) fknq-request-kind(request) == "nodeid" ? ric-node-id-valid?(fknq-request-coordinate(request)) : 0;
    def fknq-executor-token() = intern_node(fknq-executor-category(), [intern_trivial_string("form/form-stdlib/form-nodeid-knowledge-query.fk"), intern_trivial_string("fkwu-after-bmf-stream-parse"), intern_trivial_int(fknq-max-lookups()), fkqt-executor-token(), intern_trivial_int(0)]);
    // ---- raw-byte BMF cursor --------------------------------------------
    // fold = (state consumed position cursor)
    def fknq-fold-row(state, consumed, cursor) = [state, consumed, cur-pos(cursor), cursor];
    def fknq-fold-state(row) = row[0];
    def fknq-fold-consumed(row) = row[1];
    def fknq-fold-position(row) = row[2];
    // The live session has already assembled at most one bounded frame through
    // its immutable byte cursor.  Re-walking that held frame recursively built
    // every consumed prefix and retained the recursive arguments in the emitted
    // walker; an 87-byte scan alone grew to 19.4 GB before returning.  Consume
    // the remaining raw-byte window once.  This is still scannerless: no token
    // stream or grammar pre-pass is born, budget is charged in bytes, and a
    // timeout retains exactly one bounded partial slice and cursor coordinate.
    def fknq-bmf-step-width(cursor, budget) = {
        let remain = surf-len(cur-surface(cursor)) - cur-pos(cursor);
        min2(budget, remain);
    };
    def fknq-bmf-fold(cursor, budget, consumed) = (Comparable) cur-eof?(cursor) == 1 ? fknq-fold-row("complete", consumed, cursor) : budget <= 0 ? fknq-fold-row("timeout", consumed, cursor) : {
        let width = fknq-bmf-step-width(cursor, budget);
        let end = cur-pos(cursor) + width;
        let next = cur-advance(cursor, width);
        let held = str_concat(consumed, cur-slice(cursor, end));
        (Comparable) cur-eof?(next) == 1 ? fknq-fold-row("complete", held, next) : fknq-fold-row("timeout", held, next);
    };
    // parse = (status reason kind coordinate)
    def fknq-parse-row(status, reason, kind, coordinate) = [status, reason, kind, coordinate];
    def fknq-parse-payload(payload) = (Comparable) str_find(payload, "concept=", 0) == 0 ? {
        let coordinate = substring(payload, 8, str_len(payload));
        (Comparable) psci-concept-key-valid?(coordinate) == 1 ? fknq-parse-row("ready", "ready", "concept", coordinate) : fknq-parse-row("failure", "invalid-concept-coordinate", "", "");
    } : (Comparable) str_find(payload, "nodeid=", 0) == 0 ? {
        let coordinate = substring(payload, 7, str_len(payload));
        (Comparable) ric-node-id-valid?(coordinate) == 1 ? fknq-parse-row("ready", "ready", "nodeid", coordinate) : fknq-parse-row("failure", "invalid-nodeid-coordinate", "", "");
    } : fknq-parse-row("failure", "unknown-request-kind", "", "");
    def fknq-parse(surface) = !((Comparable) str_find(surface, fknq-open(), 0) == 0) ? fknq-parse-row("nothing", "no-knowledge-token", "", "") : {
        let close-at = str_find(surface, fknq-close(), str_len(fknq-open()));
        close-at < 0 ? str_len(surface) > fknq-max-frame-bytes() ? fknq-parse-row("timeout", "frame-budget-exceeded", "", "") : fknq-parse-row("nothing", "held-incomplete", "", "") : !((Comparable) (close-at + str_len(fknq-close())) == str_len(surface)) ? fknq-parse-row("failure", "trailing-bytes", "", "") : {
            let payload = substring(surface, str_len(fknq-open()), close-at);
            str_len(payload) > fknq-max-payload-bytes() ? fknq-parse-row("timeout", "payload-budget-exceeded", "", "") : str_find(payload, fknq-open(), 0) >= 0 || str_find(payload, fknq-close(), 0) >= 0 ? fknq-parse-row("failure", "nested-knowledge-token", "", "") : fknq-parse-payload(payload);
        };
    };
    // scan = (status reason request consumed position pretokenized scannerless)
    def fknq-scan-row(status, reason, request, consumed, position) = [status, reason, fknq-node-or-absent(request), consumed, position, 0, 1];
    def fknq-scan-status(scan) = scan[0];
    def fknq-scan-reason(scan) = scan[1];
    def fknq-scan-request(scan) = scan[2];
    def fknq-scan-consumed(scan) = scan[3];
    def fknq-scan-position(scan) = scan[4];
    def fknq-scan-pretokenized?(scan) = scan[5];
    def fknq-scan-scannerless?(scan) = scan[6];
    // The resident/live membrane is the cursor: it retains split openers and at
    // most one bounded frame across decoded byte chunks.  Once that frame is
    // complete, constructing a second cursor row inside the emitted carrier is
    // redundant and physically divergent (the emitted helper admitted four
    // bytes and kept position zero while direct source admitted the frame).
    // Admit the held raw surface exactly once.  This remains scannerless and
    // preserves a single byte-budget slice for timeout evidence.
    def fknq-bmf-consume(surface, budget) = {
        let observed = str_len(surface);
        budget <= 0 ? fknq-scan-row("timeout", "cursor-step-budget", nothing(), "", 0) : observed > budget ? fknq-scan-row("timeout", "cursor-step-budget", nothing(), substring(surface, 0, budget), budget) : {
            let parsed = fknq-parse(surface);
            let status = parsed[0];
            let request = (String) status == "ready" ? fknq-request-token(parsed[2], parsed[3]) : nothing();
            fknq-scan-row(status, parsed[1], request, surface, observed);
        };
    };
    def fknq-bmf-consume-default(surface) = fknq-bmf-consume(surface, fknq-max-frame-bytes());
    def fknq-concept-surface(coordinate) = str_concat(fknq-open(), str_concat("concept=", str_concat(coordinate, fknq-close())));
    def fknq-nodeid-surface(coordinate) = str_concat(fknq-open(), str_concat("nodeid=", str_concat(coordinate, fknq-close())));
    // ---- one persisted-registry lookup ---------------------------------
    // registry result = (schema status reason kind coordinate family path id
    //                    fresh rebuild matches source entry model-executed
    //                    lookup-count)
    def fknq-registry-result(status, reason, request, family, path, source-id, fresh, rebuild, matches, source, entry, lookup-count) = ["form-nodeid-knowledge-registry-result-v1", status, reason, (Comparable) fknq-request-valid?(request) == 1 ? fknq-request-kind(request) : "", (Comparable) fknq-request-valid?(request) == 1 ? fknq-request-coordinate(request) : "", family, path, source-id, fresh, rebuild, matches, fknq-node-or-absent(source), fknq-node-or-absent(entry), 0, lookup-count];
    def fknq-registry-status(r) = r[1];
    def fknq-registry-reason(r) = r[2];
    def fknq-registry-family(r) = r[5];
    def fknq-registry-path(r) = r[6];
    def fknq-registry-source-id(r) = r[7];
    def fknq-registry-fresh?(r) = r[8];
    def fknq-registry-rebuild?(r) = r[9];
    def fknq-registry-matches(r) = r[10];
    def fknq-registry-source(r) = r[11];
    def fknq-registry-entry(r) = r[12];
    def fknq-registry-model-executed?(r) = r[13];
    def fknq-registry-lookup-count(r) = r[14];
    def fknq-record-matches-request?(record, request) = (Comparable) len(record) == 0 || (Comparable) fknq-request-valid?(request) == 0 ? 0 : (String) fknq-request-kind(request) == "concept" ? pscish-key-member?(fknq-request-coordinate(request), pscish-record-keys(record)) : (String) fknq-request-coordinate(request) == fknq-node-key(pscish-record-source(record)) || (String) fknq-request-coordinate(request) == fknq-node-key(pscish-record-entry(record)) ? 1 : 0;
    // accumulator = (distinct-match-count first-record)
    def fknq-registry-record-acc(record, request, acc) = (Comparable) fknq-record-matches-request?(record, request) == 0 ? acc : (Comparable) acc[0] == 0 ? [1, record] : (String) pscish-record-path(record) == pscish-record-path(acc[1]) ? acc : [acc[0] + 1, acc[1]];
    def fknq-registry-files-loop(dir, names, request, acc) = nil?(names) ? acc : {
        let name = head(names);
        let path = fs-path-join(dir, name);
        let record = (Comparable) psci-ends-with?(name, ".psci") == 1 ? pscish-parse-entry(fs-read-text(path)) : empty();
        fknq-registry-files-loop(dir, tail(names), request, fknq-registry-record-acc(record, request, acc));
    };
    def fknq-registry-buckets-loop(family-root, buckets, request, acc) = nil?(buckets) ? acc : {
        let dir = fs-path-join(family-root, head(buckets));
        let next = fknq-registry-files-loop(dir, fs-list(dir), request, acc);
        fknq-registry-buckets-loop(family-root, tail(buckets), request, next);
    };
    def fknq-registry-families-loop(artifact, families, request, acc) = nil?(families) ? acc : {
        let root = pscish-family-shard-root(artifact, psci-family-id(head(families)));
        let next = fknq-registry-buckets-loop(root, fs-list(root), request, acc);
        fknq-registry-families-loop(artifact, tail(families), request, next);
    };
    def fknq-registry-lookup-at(root, artifact, request) = (Comparable) fknq-request-valid?(request) == 0 ? fknq-registry-result("failure", "invalid-request-node", request, "", "", "", 0, 0, 0, nothing(), nothing(), 0) : !((Comparable) fs-is-dir?(pscish-shards-root(artifact)) == 1) ? fknq-registry-result("failure", "registry-unavailable", request, "", "", "", 0, 0, 0, nothing(), nothing(), 1) : {
        let acc = fknq-registry-families-loop(artifact, psci-families(), request, [0, empty()]);
        (Comparable) acc[0] == 0 ? fknq-registry-result("miss", (String) fknq-request-kind(request) == "concept" ? "concept-not-registered" : "nodeid-not-registered", request, "", "", "", 0, 0, 0, nothing(), nothing(), 1) : acc[0] > 1 ? fknq-registry-result("ambiguous", "ambiguous-registry-request", request, "", "", "", 0, 0, acc[0], nothing(), nothing(), 1) : {
            let record = acc[1];
            let source = pscish-record-source(record);
            let entry = pscish-record-entry(record);
            let v = pscish-validate-source-at(root, artifact, pscish-record-family(record), pscish-record-path(record));
            (Comparable) v[0] == 1 ? fknq-registry-result("hit", "current-content-addressed-source", request, pscish-record-family(record), pscish-record-path(record), pscish-record-source-id(record), 1, 0, 1, source, entry, 1) : fknq-registry-result("stale", "source-rebuild-needed", request, pscish-record-family(record), pscish-record-path(record), pscish-record-source-id(record), 0, 1, 1, source, entry, 1);
        };
    };
    // ---- existing current-source query/result/typed observation ----------
    def fknq-query-text(request, entry) = (String) fknq-request-kind(request) == "concept" ? fknq-request-coordinate(request) : (Comparable) psci-entry-valid?(entry) == 1 ? head(psci-entry-keys(entry)) : "";
    def fknq-empty-current-result(reason) = fkss-result("nothing", reason, "", "", 0, -1, "", 0, 0, 0, -1, 0);
    // One carrier read births one immutable Form string.  Digest, atom matches,
    // answer offset and answer bytes are all derived from that same value, so an
    // A -> B -> A filesystem mutation cannot pair B answer bytes with A's
    // digest.  The final streaming rehash below is a separate freshness
    // observation; it never supplies the retained answer.
    def fknq-snapshot-source-id(snapshot) = str_concat("sha256:", hex-encode(sha256-stream-string(snapshot)));
    def fknq-snapshot-observe-loop(snapshot, atoms, matched, first) = nil?(atoms) ? [matched, first] : {
        let at = fkss-find-ci(snapshot, head(atoms));
        fknq-snapshot-observe-loop(snapshot, tail(atoms), matched + (at >= 0 ? 1 : 0), first < 0 && at >= 0 ? at : first);
    };
    def fknq-current-snapshot-result(relative, atoms, hit-reason, snapshot, available, observed-size) = {
        let size = str_len(snapshot);
        let source-id = fknq-snapshot-source-id(snapshot);
        !((Comparable) available == 1) || !((Comparable) observed-size == size) ? fkss-result("stale", "current-source-changed-during-snapshot", source-id, relative, 0, -1, "", 1, 1, available, size, 0) : {
            let observed = fknq-snapshot-observe-loop(snapshot, atoms, 0, -1);
            let first = observed[1];
            let start = fkss-answer-start(first, size);
            let end = fkss-min(size, start + fkss-answer-limit());
            fkss-result("hit", hit-reason, source-id, relative, observed[0], first, substring(snapshot, start, end), 1, 1, 1, size, start);
        };
    };
    def fknq-current-snapshot-result-at(root, relative, atoms, hit-reason) = {
        let full = fs-path-join(root, relative);
        let before-size = fs-stat-size(full);
        (Comparable) fhcs-relative-source-path?(relative) == 0 || (before-size < 0 || !((Comparable) fs-is-file?(full) == 1)) ? fkss-result("miss", "direct-source-path-unavailable", "", relative, 0, -1, "", 1, 1, 0, -1, 0) : {
            let snapshot = fs-read-text(full);
            let after-size = fs-stat-size(full);
            let available = fs-is-file?(full);
            fknq-current-snapshot-result(relative, atoms, hit-reason, snapshot, available, after-size);
        };
    };
    // This pure constructor is the injection seam for the final currentness
    // proof: disagreement retains the latest identity evidence, clears the
    // answer, and becomes stale rather than hit, miss, or numeric zero.
    def fknq-current-result-recheck(current, source-id, size) = !((String) fkss-status(current) == "hit") ? current : (String) source-id == fkss-source-id-of(current) && (Comparable) size == fkss-source-size(current) ? current : fkss-result("stale", "current-source-changed-during-read", source-id, fkss-source-path(current), 0, -1, "", fkss-inventory-count(current), fkss-eligible-count(current), fkss-accessible-count(current), size, 0);
    def fknq-current-result-recheck-at(root, current) = !((String) fkss-status(current) == "hit") ? current : {
        let full = fs-path-join(root, fkss-source-path(current));
        let size = fs-stat-size(full);
        size < 0 ? fknq-current-result-recheck(current, "", -1) : fknq-current-result-recheck(current, fkss-source-id(full), size);
    };
    def fknq-current-source-result-at(root, registry, request) = {
        let query = fknq-query-text(request, fknq-registry-entry(registry));
        let atoms = fhcs-atoms(query);
        nil?(atoms) ? fknq-empty-current-result("no-query-atoms") : {
            let current = fknq-current-snapshot-result-at(root, fknq-registry-path(registry), atoms, "concept-registry-current-source-hit");
            fknq-current-result-recheck-at(root, current);
        };
    };
    def fknq-fkqt-request(request, entry) = {
        let query = fknq-query-text(request, entry);
        fkqt-request("ready", "ready", query, fkqt-query-token(query));
    };
    def fknq-existing-observation(request, registry, current, local-ready) = !((String) fknq-final-status(registry, current) == "hit") ? fknq-absent() : {
        let fkrequest = fknq-fkqt-request(request, fknq-registry-entry(registry));
        let path = fkqt-clip(fkss-source-path(current), fkqt-max-source-bytes());
        let answer = fkss-answer(current);
        let key = fhcs-answer-key(answer);
        let lane = fkqt-route-lane(fkss-status(current), local-ready);
        fhcs-observation-token(fkrequest, current, path, answer, key, lane);
    };
    // ---- outcome and lifecycle ------------------------------------------
    def fknq-trace-hit() = ["choice", "cut", "release"];
    def fknq-trace-miss() = ["choice", "cut", "release"];
    def fknq-trace-nothing() = ["choice", "release"];
    def fknq-trace-stale() = ["choice", "stale", "undo", "refine", "release"];
    def fknq-trace-ambiguous() = ["choice", "ambiguous", "undo", "refine", "cut", "release"];
    def fknq-trace-timeout() = ["choice", "timeout", "cut", "undo", "refine", "release"];
    def fknq-trace-failure() = ["choice", "failure", "undo", "refine", "cut", "release"];
    def fknq-trace-for(status) = (String) status == "hit" ? fknq-trace-hit() : (String) status == "miss" ? fknq-trace-miss() : (String) status == "nothing" ? fknq-trace-nothing() : (String) status == "stale" ? fknq-trace-stale() : (String) status == "ambiguous" ? fknq-trace-ambiguous() : (String) status == "timeout" ? fknq-trace-timeout() : fknq-trace-failure();
    def fknq-trace-actions(trace) = pscish-join(trace, ",");
    def fknq-trace-has?(trace, action) = nil?(trace) ? 0 : (String) head(trace) == action ? 1 : fknq-trace-has?(tail(trace), action);
    // A registry hit is only one axis of the claim.  Correlate its held source
    // and entry with one another and with the later current-source identity.
    // This is deliberately stricter than checking two independent "hit"
    // strings: path, digest, size, family, freshness, and lookup cardinality
    // must describe one source coordinate.
    def fknq-registry-source-bound?(registry) = !((String) fknq-registry-status(registry) == "hit") ? 0 : {
        let source = fknq-registry-source(registry);
        let entry = fknq-registry-entry(registry);
        (Comparable) psci-source-node-valid?(source) == 0 ? 0 : (Comparable) psci-entry-valid?(entry) == 0 ? 0 : !node_eq(psci-entry-source(entry), source) ? 0 : !((String) fknq-registry-family(registry) == psci-source-family(source)) ? 0 : !((String) fknq-registry-path(registry) == psci-source-path(source)) ? 0 : !((String) fknq-registry-source-id(registry) == psci-source-id(source)) ? 0 : !((Comparable) fknq-registry-fresh?(registry) == 1) ? 0 : !((Comparable) fknq-registry-rebuild?(registry) == 0) ? 0 : !((Comparable) fknq-registry-matches(registry) == 1) ? 0 : (Comparable) fknq-registry-lookup-count(registry) == 1 ? 1 : 0;
    };
    def fknq-current-identity-bound?(registry, current) = (Comparable) fknq-registry-source-bound?(registry) == 0 ? 0 : {
        let source = fknq-registry-source(registry);
        !((String) fkss-source-id-of(current) == psci-source-id(source)) ? 0 : !((String) fkss-source-path(current) == psci-source-path(source)) ? 0 : (Comparable) fkss-source-size(current) == psci-source-size(source) ? 1 : 0;
    };
    def fknq-current-hit-bound?(registry, current) = !((String) fkss-status(current) == "hit") ? 0 : fknq-current-identity-bound?(registry, current);
    def fknq-final-status(registry, current) = !((String) fknq-registry-status(registry) == "hit") ? fknq-registry-status(registry) : (Comparable) fknq-registry-source-bound?(registry) == 0 ? "stale" : (String) fkss-status(current) == "hit" ? (Comparable) fknq-current-hit-bound?(registry, current) == 1 ? "hit" : "stale" : (String) fkss-status(current) == "miss" ? (Comparable) fknq-current-identity-bound?(registry, current) == 1 ? "miss" : "stale" : (String) fkss-status(current) == "nothing" ? "nothing" : (String) fkss-status(current) == "stale" ? "stale" : "failure";
    def fknq-final-reason(registry, current) = !((String) fknq-registry-status(registry) == "hit") ? fknq-registry-reason(registry) : (Comparable) fknq-registry-source-bound?(registry) == 0 ? "current-source-binding-drift" : (String) fkss-status(current) == "hit" && (Comparable) fknq-current-hit-bound?(registry, current) == 0 || (String) fkss-status(current) == "miss" && (Comparable) fknq-current-identity-bound?(registry, current) == 0 ? "current-source-binding-drift" : fkss-reason(current);
    def fknq-final-fresh?(registry, current) = !((String) fknq-registry-status(registry) == "hit") ? fknq-registry-fresh?(registry) : (Comparable) fknq-registry-source-bound?(registry) == 0 ? 0 : (String) fkss-status(current) == "hit" || (String) fkss-status(current) == "miss" ? (Comparable) fknq-current-identity-bound?(registry, current) == 1 ? fknq-registry-fresh?(registry) : 0 : 0;
    def fknq-final-rebuild?(registry, current) = (String) fknq-final-status(registry, current) == "stale" ? 1 : fknq-registry-rebuild?(registry);
    // observation children:
    // status reason request executor source-token entry-token source-original
    // entry-original existing-fhcs-observation family path source-id answer-key
    // answer fresh rebuild matches lookup-count hit-count executed
    // model-executed pretokenized scannerless trace current-path current-id
    // current-size
    def fknq-observation-node(status, reason, scan, registry, current, existing, trace) = {
        let source = fknq-registry-source(registry);
        let entry = fknq-registry-entry(registry);
        let source-valid = psci-source-node-valid?(source);
        let entry-valid = psci-entry-valid?(entry);
        let source-token = (Comparable) source-valid == 1 ? fknq-source-token(source) : fknq-absent();
        let entry-token = (Comparable) entry-valid == 1 ? fknq-entry-token(entry) : fknq-absent();
        let answer = (String) status == "hit" ? fkss-answer(current) : "";
        let hit-count = (String) status == "hit" ? 1 : 0;
        let executed = (Comparable) fknq-registry-lookup-count(registry) == 1 ? 1 : 0;
        intern_node(fknq-observation-category(), [intern_trivial_string(status), intern_trivial_string(reason), fknq-scan-request(scan), fknq-executor-token(), source-token, entry-token, (Comparable) source-valid == 1 ? source : fknq-absent(), (Comparable) entry-valid == 1 ? entry : fknq-absent(), existing, intern_trivial_string(fknq-registry-family(registry)), intern_trivial_string(fknq-registry-path(registry)), intern_trivial_string(fknq-registry-source-id(registry)), intern_trivial_string(fhcs-answer-key(answer)), intern_trivial_string(answer), intern_trivial_int(fknq-final-fresh?(registry, current)), intern_trivial_int(fknq-final-rebuild?(registry, current)), intern_trivial_int(fknq-registry-matches(registry)), intern_trivial_int(fknq-registry-lookup-count(registry)), intern_trivial_int(hit-count), intern_trivial_int(executed), intern_trivial_int(0), intern_trivial_int(fknq-scan-pretokenized?(scan)), intern_trivial_int(fknq-scan-scannerless?(scan)), intern_trivial_string(fknq-trace-actions(trace)), intern_trivial_string(fkss-source-path(current)), intern_trivial_string(fkss-source-id-of(current)), intern_trivial_int(fkss-source-size(current))]);
    };
    // result = status reason source-token entry-token request executor
    //          observation existing-observation source-original entry-original
    //          path answer trace fresh rebuild matches lookup hit executed
    //          model-executed pretokenized scannerless
    def fknq-result-from-evidence(scan, registry, current, local-ready) = {
        let status = fknq-final-status(registry, current);
        let reason = fknq-final-reason(registry, current);
        let request = fknq-scan-request(scan);
        let source = fknq-registry-source(registry);
        let entry = fknq-registry-entry(registry);
        let source-token = (Comparable) psci-source-node-valid?(source) == 1 ? fknq-source-token(source) : fknq-absent();
        let entry-token = (Comparable) psci-entry-valid?(entry) == 1 ? fknq-entry-token(entry) : fknq-absent();
        let existing = fknq-existing-observation(request, registry, current, local-ready);
        let trace = fknq-trace-for(status);
        let observation = fknq-observation-node(status, reason, scan, registry, current, existing, trace);
        let hit-count = (String) status == "hit" ? 1 : 0;
        let executed = (Comparable) fknq-registry-lookup-count(registry) == 1 ? 1 : 0;
        let answer = (String) status == "hit" ? fkss-answer(current) : "";
        [status, reason, source-token, entry-token, request, fknq-executor-token(), observation, existing, source, entry, fknq-registry-path(registry), answer, trace, fknq-final-fresh?(registry, current), fknq-final-rebuild?(registry, current), fknq-registry-matches(registry), fknq-registry-lookup-count(registry), hit-count, executed, 0, fknq-scan-pretokenized?(scan), fknq-scan-scannerless?(scan)];
    };
    def fknq-result-from-scan(scan) = {
        let status = fknq-scan-status(scan);
        let registry = fknq-registry-result(status, fknq-scan-reason(scan), fknq-scan-request(scan), "", "", "", 0, 0, 0, nothing(), nothing(), 0);
        fknq-result-from-evidence(scan, registry, fknq-empty-current-result(fknq-scan-reason(scan)), 0);
    };
    def fknq-status(r) = r[0];
    def fknq-reason(r) = r[1];
    def fknq-source(r) = r[2];
    def fknq-entry(r) = r[3];
    def fknq-request(r) = r[4];
    def fknq-executor(r) = r[5];
    def fknq-observation(r) = r[6];
    def fknq-existing-current-observation(r) = r[7];
    def fknq-source-original-of(r) = r[8];
    def fknq-entry-original-of(r) = r[9];
    def fknq-source-path(r) = r[10];
    def fknq-answer(r) = r[11];
    def fknq-trace(r) = r[12];
    def fknq-fresh?(r) = r[13];
    def fknq-rebuild?(r) = r[14];
    def fknq-match-count(r) = r[15];
    def fknq-lookup-count(r) = r[16];
    def fknq-hit-count(r) = r[17];
    def fknq-executed?(r) = r[18];
    def fknq-model-executed?(r) = r[19];
    def fknq-pretokenized?(r) = r[20];
    def fknq-scannerless?(r) = r[21];
    def fknq-current-source-path-of(r) = node_value(node_children(fknq-observation(r))[24]);
    def fknq-current-source-id-of(r) = node_value(node_children(fknq-observation(r))[25]);
    def fknq-current-source-size-of(r) = node_value(node_children(fknq-observation(r))[26]);
    // This is the only effectful bridge door.  Parsing completes before any
    // registry or source file is opened.
    def fknq-execute-at(root, artifact, surface, local-ready, budget) = {
        let scan = fknq-bmf-consume(surface, budget);
        !((String) fknq-scan-status(scan) == "ready") ? fknq-result-from-scan(scan) : {
            let request = fknq-scan-request(scan);
            let registry = fknq-registry-lookup-at(root, artifact, request);
            let current = (String) fknq-registry-status(registry) == "hit" ? fknq-current-source-result-at(root, registry, request) : fknq-empty-current-result(fknq-registry-reason(registry));
            fknq-result-from-evidence(scan, registry, current, local-ready);
        };
    };
    def fknq-execute(surface, local-ready) = {
        let root = fhcs-default-root();
        (String) root == "" ? fknq-result-from-scan(fknq-scan-row("failure", "body-root-unresolved", nothing(), "", 0)) : fknq-execute-at(root, fknq-default-artifact(), surface, local-ready, fknq-max-frame-bytes());
    };
    0;
}
