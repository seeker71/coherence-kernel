; living-world-resonance-application.fk -- an inferred lens asks before acting.
;
; A structurally inferred mapping already crossed one unanimous offer/ack
; boundary.  Applying it to a new active cell is a distinct movement with a
; distinct affected field.  This cell derives the proposed output locally, then
; makes holders of the mapping and holders of the input participants in a new
; proposal.  Computation is not authority: only their unanimous active
; acknowledgment lets the application enter the world.
;
; Kept as a separate cell from induction so the source-native compiler and the
; living organ can observe each movement independently.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk

(let LWR-APPLICATION        (bp "LWR-APPLICATION"))
(let LWR-APPLICATION-EVIDENCE (bp "LWR-APPLICATION-EVIDENCE"))
(let LWR-APPLICATION-ORIGIN (bp "LWR-APPLICATION-ORIGIN"))

(defn lwr-mapping-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwr-mapping? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwr-output-items (terms input-items)
    (if (eq (len terms) 0) (empty)
        (do
            (let term (head terms))
            (let value
                (if (eq (lwr-slot? term) 1)
                    (nth input-items (lwr-slot-index term))
                    (if (eq (lwr-constant? term) 1)
                        (lwr-constant-value term)
                        (lwo-none))))
            (if (node_eq value (lwo-none)) (empty)
                (cons value (lwr-output-items (tail terms) input-items))))))

(defn lwr-apply-mapping (mapping input)
    (do
        (let signature (lwr-mapping-signature mapping))
        (let template (lwr-signature-template signature))
        (let input-items (node_children input))
        (if (or (eq (lwr-signature-valid? signature) 0)
                (or (not (node_eq (node_category input)
                                  (lwr-signature-source-category signature)))
                    (not (eq (len input-items)
                             (lwr-signature-source-arity signature)))))
            (lwo-none)
            (do
                (let output-items
                    (lwr-output-items (lwr-template-items template) input-items))
                (if (not (eq (len output-items)
                             (lwr-signature-target-arity signature)))
                    (lwo-none)
                    (intern_node (lwr-signature-target-category signature)
                                 output-items))))))

; children: integrated mapping candidate, input, derived output, mapping,
;           uncertainty, active mapping attributions, active input
;           attributions, local path
(defn lwr-application
    (mapping-candidate input output mapping mapping-attributions input-attributions)
    (intern_node LWR-APPLICATION
        (list mapping-candidate input output mapping
              (lwr-mapping-uncertainty mapping)
              mapping-attributions input-attributions (lwo-local-path))))
(defn lwr-application? (cell) (lwo-category? cell LWR-APPLICATION))
(defn lwr-application-mapping-candidate (application)
    (nth (node_children application) 0))
(defn lwr-application-input (application) (nth (node_children application) 1))
(defn lwr-application-output (application) (nth (node_children application) 2))
(defn lwr-application-mapping (application) (nth (node_children application) 3))
(defn lwr-application-uncertainty (application) (nth (node_children application) 4))
(defn lwr-application-mapping-attributions (application)
    (nth (node_children application) 5))
(defn lwr-application-input-attributions (application)
    (nth (node_children application) 6))
(defn lwr-application-path (application) (nth (node_children application) 7))

(defn lwr-application-origin (mapping-candidate input application witnesses)
    (intern_node LWR-APPLICATION-ORIGIN
        (list mapping-candidate input application witnesses)))

(defn lwr-application-evidence (world mapping-candidate input)
    (do
        (let mapping-attributions
            (lwo-active-attributions-for world mapping-candidate))
        (let input-attributions
            (lwo-active-attributions-for world input))
        (intern_node LWR-APPLICATION-EVIDENCE
            (list mapping-attributions input-attributions
                (lwr-field-union-items
                    (lwo-field-items input-attributions)
                    mapping-attributions)))))
(defn lwr-application-evidence-mapping-attributions (evidence)
    (nth (node_children evidence) 0))
(defn lwr-application-evidence-input-attributions (evidence)
    (nth (node_children evidence) 1))
(defn lwr-application-evidence-witnesses (evidence)
    (nth (node_children evidence) 2))

(defn lwr-application-emergent (mapping-candidate input mapping output evidence)
    (do
        (let witnesses (lwr-application-evidence-witnesses evidence))
        (let application
            (lwr-application mapping-candidate input output mapping
                (lwr-application-evidence-mapping-attributions evidence)
                (lwr-application-evidence-input-attributions evidence)))
        (let origin
            (lwr-application-origin mapping-candidate input application witnesses))
        (lwo-emergent application witnesses
            (intern_trivial_int
                (lwo-field-size (lwr-mapping-supports mapping)))
            (intern_trivial_int
                (lwr-template-slot-count
                    (lwr-signature-template
                        (lwr-mapping-signature mapping))))
            (intern_trivial_int (lwo-field-size witnesses))
            origin)))

(defn lwr-application-proposal-from-output
    (world mapping-candidate input mapping output)
    (do
        (let evidence
            (lwr-application-evidence world mapping-candidate input))
        (let candidate
            (lwr-application-emergent
                mapping-candidate input mapping output evidence))
        (lwt-proposal candidate
            (lwt-sources-from-attributions
                (lwo-field-items (lwo-emergent-witnesses candidate))
                (lwo-empty-field))
            (lwo-emergent-provenance candidate))))

(defn lwr-application-proposal (world mapping-candidate input)
    (if (or (eq (lwr-mapping-candidate? mapping-candidate) 0)
            (or (eq (lwo-active? world mapping-candidate) 0)
                (or (eq (lwo-emergent-ready? world mapping-candidate) 0)
                    (eq (lwo-active? world input) 0))))
        (lwo-none)
        (do
            (let mapping (lwo-emergent-shape mapping-candidate))
            (let output (lwr-apply-mapping mapping input))
            (if (node_eq output (lwo-none)) (lwo-none)
                (lwr-application-proposal-from-output
                    world mapping-candidate input mapping output)))))

(defn lwr-application-round (world mapping-candidate input prior)
    (do
        (let proposal
            (lwr-application-proposal world mapping-candidate input))
        (lwt-round world
            (if (node_eq proposal (lwo-none))
                (lwo-empty-field)
                (lwo-field-add (lwo-empty-field) proposal))
            (lwo-empty-field) prior)))
