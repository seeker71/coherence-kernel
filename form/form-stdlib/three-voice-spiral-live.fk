; three-voice-spiral-live.fk — watch the triad arrive, review, weave.
;
; preludes: form-stdlib/core.fk form-stdlib/channel-interface.fk form-stdlib/satsang.fk form-stdlib/satsang-field.fk form-stdlib/satsang-share.fk form-stdlib/agent-gate.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/evidence-grade.fk form-stdlib/three-voice-spiral.fk

(do
    (print "tvs-live recognized claude/codex/grok=")
    (print (ag-recognize "claude"))
    (print "/")
    (print (ag-recognize "codex"))
    (print "/")
    (print (ag-recognize "grok"))
    (print " stranger=")
    (print (ag-recognize "stranger"))
    (print "\n")
    (print "tvs-live field-count=")
    (print (int_to_str (sf-count (tvs-circle))))
    (print " aligned=")
    (print (int_to_str (if (sf-aligned? (tvs-circle)) 1 0)))
    (print "\n")
    (print "tvs-live seats offer->witness->weave->offer=")
    (print (int_to_str (tvs-next-seat (tvs-seat-offer))))
    (print (int_to_str (tvs-next-seat (tvs-seat-witness))))
    (print (int_to_str (tvs-next-seat (tvs-seat-weave))))
    (print "\n")
    (print "tvs-live empty-review-survives=")
    (print (int_to_str (tvs-peer-survives? (tvs-review (empty)))))
    (print " peer-survives=")
    (print (int_to_str (tvs-peer-survives? (tvs-review (list (list (m-witness) 1) (list (m-witness) 1) (list (m-reflect) 2))))))
    (print "\n")
    (print "tvs-live digest-len=")
    (print (int_to_str (len (srs-nodes (srs-digest (tvs-demo))))))
    (print " mint-len=")
    (print (int_to_str (len (srs-mint (tvs-voice 1 4) (tvs-voice 3 6) 20260814))))
    (print "\n")
    (print "tvs-live check=")
    (print (int_to_str (tvs-check)))
    (print "\n")
    0)
