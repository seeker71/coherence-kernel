// nl-translate.fk — Form-native NL -> NL translation through the language-neutral
// pivot. The reusable BODY behind the translate band (four-way)
// and the live carrier.
//
// surface --g-parse(tongue grammar)--> raw node --normalize(lexicon)--> PIVOT
// PIVOT --decode(target tongue)--> target surface
//
// Each tongue is its own grammar over the ONE engine; content words normalize
// through a lexicon onto ONE pivot node (one cell, many tongues), so
// "the source is native" and "sumber adalah asli" intern to the SAME node. Adding
// a tongue is adding a (grammar, lexicon-direction, decoder) — pivot and engine
// never change. Grammars are nullary defns (global, fourth-arm-safe), not top-level
// lets, so the carrier and the band can both call tr-en-id / tr-id-en directly.
section [form.bml] {
    def nlt-s(x) = intern_trivial_string(x);
    def nlt-kidv(n, i) = node_value(nth(node_children(n), i));
    def nlt-sp(a, b) = (a + (" " + b));
    //; --- the two tongue grammars (data over the one engine) ---
    def nl-en() = grammar("s", [rule3("s", p-cap("v", p-ref("prop")), t-splice("v")), rule3("prop", ["seq", p-lit("the"), p-cap("s", p-run("alpha")), p-lit("is"), p-cap("a", p-run("alpha"))], t-emit("property", [t-splice("s"), t-splice("a")]))]);
    def nl-id() = grammar("s", [rule3("s", p-cap("v", p-ref("prop")), t-splice("v")), rule3("prop", ["seq", p-cap("s", p-run("alpha")), p-lit("adalah"), p-cap("a", p-run("alpha"))], t-emit("property", [t-splice("s"), t-splice("a")]))]);
    //; --- the lexicon AS DATA: rows of (symbol phase en id). The pivot speaks the
    //; body's OWN neutral symbol — n0, n1, … — NOT any tongue's lemma, so no language
    //; is privileged ("source", "sumber", "shan" are equal doors onto n0). The symbol
    //; is a door over the numeric NodeID (identity invariant under renaming); the
    //; self-authored-symbol-space MDL loop refines it toward minimal (frequent → short).
    //; PHASE is the thermodynamic state of the substrate: ice = frozen,
    //; load-bearing, widely referenced; water = actively circulating; gas = provisional,
    //; just-invented. A symbol phase-changes WITHIN its identity as it settles.
    //; A tongue is a COLUMN, a word a ROW: grown by ingesting the parallel corpus.
    //; the SEED lexicon — structural words, hand-curated, ICE (frozen, load-bearing)
    def nlt-seed-lexicon() = [    //;     symbol  phase    en         id
["n0", "ice", "source", "sumber"], ["n1", "ice", "native", "asli"], ["n2", "ice", "kernel", "inti"], ["n3", "water", "body", "tubuh"], ["n4", "water", "cell", "sel"], ["n5", "water", "recipe", "resep"], ["n6", "gas", "witness", "saksi"]];
    //; list append, cons-based (core-free so it runs raw AND four-way)
    def nlt-cat(a, b) = (Comparable) len(a) == 0 ? b : cons(a[0], nlt-cat(a[1:], b));
    //; the full lexicon = SEED (ice) ++ CORPUS (water). The corpus is GROWN from the
    //; parallel locale corpus by the Form projector nl-lexicon-grow.fk into
    //; nl-lexicon-data.fk (defn nlt-corpus-lexicon), loaded as a prelude before this cell.
    def nlt-lexicon() = nlt-cat(nlt-seed-lexicon(), nlt-corpus-lexicon());
    //; generic lookup: scan rows for column-i == w, return column-j; passthrough unknown
    def nlt-find(rows, i, w) = nil?(rows) ? empty() : (String) nth(rows[0], i) == w ? rows[0] : nlt-find(rows[1:], i, w);
    def nlt-pick(r, j, w) = nil?(r) ? w : nth(r, j);
    def nlt-map(i, j, w) = nlt-pick(nlt-find(nlt-lexicon(), i, w), j, w);
    //; columns: 0=neutral symbol, 1=phase, 2=en, 3=id. concept ≡ the neutral symbol.
    def nlt-en-to-symbol(w) = nlt-map(2, 0, w);
    // en surface  -> neutral symbol
    def nlt-symbol-to-en(sy) = nlt-map(0, 2, sy);
    // neutral symbol -> en surface
    def nlt-id-to-symbol(w) = nlt-map(3, 0, w);
    // id surface  -> neutral symbol
    def nlt-symbol-to-id(sy) = nlt-map(0, 3, sy);
    // neutral symbol -> id surface
    def nlt-phase(sy) = nlt-map(0, 1, sy);
    // neutral symbol -> thermodynamic phase
    //; --- normalize raw parse -> PIVOT ---
    def norm-en(n) = intern_node(bp("property"), [nlt-s(nlt-en-to-symbol(nlt-kidv(n, 0))), nlt-s(nlt-en-to-symbol(nlt-kidv(n, 1)))]);
    def norm-id(n) = intern_node(bp("property"), [nlt-s(nlt-id-to-symbol(nlt-kidv(n, 0))), nlt-s(nlt-id-to-symbol(nlt-kidv(n, 1)))]);
    //; --- decode PIVOT -> a tongue's surface ---
    def dec-en(p) = nlt-sp("the", nlt-sp(nlt-symbol-to-en(nlt-kidv(p, 0)), nlt-sp("is", nlt-symbol-to-en(nlt-kidv(p, 1)))));
    def dec-id(p) = nlt-sp(nlt-symbol-to-id(nlt-kidv(p, 0)), nlt-sp("adalah", nlt-symbol-to-id(nlt-kidv(p, 1))));
    //; --- the translators: encode one tongue -> pivot -> decode the other ---
    //; the ENCODER owns surface normalization (str-normalize from string-case.fk:
    //; lowercase + strip punctuation), so noisy real input — "The Source Is Native." —
    //; canonicalizes INSIDE Form, not in a shell carrier.
    def tr-en-id(x) = dec-id(norm-en(g-parse(nl-en(), str-normalize(x))));
    def tr-id-en(x) = dec-en(norm-id(g-parse(nl-id(), str-normalize(x))));
    0;
}
