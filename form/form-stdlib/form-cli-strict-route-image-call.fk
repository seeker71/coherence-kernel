; form-cli-strict-route-image-call.fk -- one pure strict route-admission
; decision expressed as an admitted caller/callee program-image exchange.
;
; The caller offers three already-observed, typed facts:
;
;   [request-valid, request-kind, route-present]
;
; The callee image returns present integer 1 only when both flags are exact 1
; and the kind is exact "concept".  Every other well-typed offer returns
; present integer 0 with output-count 1.  It never turns disagreement into
; nothing, refusal, or timeout.  Exact fuel 17 completes; fuel 16 times out
; with no fabricated output.
;
; The receipt retains the receiver-owned registry, exact OFFER, exact ACK, and
; deterministic ack-observed verdict.  CALL_BINDING retains the actual caller
; and callee images; the explicit capability grant is separate from relation
; admission.  The caller image is initiating identity only and is not claimed
; as executed by the current protocol.
;
; This cell is pure Form.  It has no filesystem, host process, HTTP, model,
; Metal, flattening, function-map, or persistence authority.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-call-protocol.fk
; Proven by: form-stdlib/tests/form-cli-strict-route-image-call-band.fk

(do
    ; Rows use only the compact resident image's existing semantics:
    ; ARG, INT, NTH, STRING, STR_EQ, INT_EQ, and MUL.
    ;
    ; node 4  = request-valid == 1
    ; node 7  = request-kind == "concept"
    ; node 8  = node4 * node7
    ; node 11 = route-present == 1
    ; node 12 = node8 * node11
    (defn fcsri-image ()
        (fcatw-image
            (list (fcatw-kind-int) (fcatw-kind-string) (fcatw-kind-int))
            (list
                (fcatw-row 2 0 0 0)
                (fcatw-row 1 0 0 0)
                (fcatw-row 23 0 1 0)
                (fcatw-row 1 1 0 0)
                (fcatw-row 102 2 3 0)
                (fcatw-row 23 0 3 0)
                (fcatw-row 24 0 0 0)
                (fcatw-row 26 5 6 0)
                (fcatw-row 42 4 7 0)
                (fcatw-row 1 2 0 0)
                (fcatw-row 23 0 9 0)
                (fcatw-row 102 10 3 0)
                (fcatw-row 42 8 11 0))
            (list "concept") 12))

    ; receipt = [protocol-registry, offer, ack, ack-observed]
    ; Correlation is supplied as an interned node by the caller.  Evaluator
    ; fuel bounds only the callee image walk; the pure protocol envelope is not
    ; mislabeled as fuel-metered work.
    (defn fcsri-receipt
        (request-valid request-kind route-present correlation fuel)
        (do
            (let caller-image (fcatw-image (empty)
                (list (fcatw-row 1 710071 0 0)) (empty) 0))
            (let callee-image (fcsri-image))
            (let caller (fcatw-binding
                "form-cli/strict-route-requester" caller-image))
            (let callee (fcatw-binding
                "form-cli/strict-route-admission" callee-image))
            (let capability (intern_trivial_string
                "form-cli/strict-route-admission-capability-v1"))
            (let call (fpcp-call-binding caller "admit-strict-route"
                callee capability))
            (let protocol (fpcp-registry
                (fcatw-registry (list caller callee))
                (list capability) (list call)))
            (let offer (fpcp-offer call correlation
                (list
                    (fpcp-value (fcatw-kind-int) request-valid)
                    (fpcp-value (fcatw-kind-string) request-kind)
                    (fpcp-value (fcatw-kind-int) route-present))
                fuel))
            (let ack (fpcp-execute protocol offer))
            (list protocol offer ack
                (fpcp-ack-observed? protocol offer ack))))

    0)
