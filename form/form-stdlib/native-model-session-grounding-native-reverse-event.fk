; native-model-session-grounding-native-reverse-event.fk -- pure transition
; from one transient JSONL row to reverse latest-pair search state.
; preludes: form-stdlib/native-model-session-grounding-native-minimize.fk

(do
    ; tag, next mode, next completion, found-valid-pair, timestamp, query.
    (defn nmsgn-reverse-event (mode completion found when query)
        (list "native-session-reverse-event-v1" mode completion found when query))
    (defn nmsgn-reverse-event-mode (row) (nth row 1))
    (defn nmsgn-reverse-event-completion (row) (nth row 2))
    (defn nmsgn-reverse-event-found (row) (nth row 3))
    (defn nmsgn-reverse-event-when (row) (nth row 4))
    (defn nmsgn-reverse-event-query (row) (nth row 5))
    (defn nmsgn-reverse-event-step (mode completion line)
        (do
            (let event-message
                (if (ge (str_find line "\"event_msg\"" 0) 0) 1 0))
            (let task-complete
                (if (and (eq event-message 1)
                         (ge (str_find line "\"task_complete\"" 0) 0)) 1 0))
            (let user-message
                (if (and (eq event-message 1)
                         (ge (str_find line "\"user_message\"" 0) 0)) 1 0))
            (let next-completion
                (if (eq task-complete 1)
                    (nmsgn-json-string line "last_agent_message") completion))
            (let next-mode
                (if (and (eq task-complete 1)
                         (gt (str_len next-completion) 0)) 1 mode))
            (let candidate
                (if (and (eq next-mode 1) (eq user-message 1)) 1 0))
            (let when
                (if (eq candidate 1) (nmsgn-json-string line "timestamp") ""))
            (let query
                (if (eq candidate 1) (nmsgn-json-string line "message") ""))
            (let found
                (if (and (gt (str_len when) 0) (gt (str_len query) 0)) 1 0))
            (nmsgn-reverse-event next-mode next-completion found when query)))
    0)
