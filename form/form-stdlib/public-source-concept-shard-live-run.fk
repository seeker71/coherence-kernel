; public-source-concept-shard-live-run.fk -- rebuild and validate the live
; family-sharded public concept registry, then render bounded count telemetry.
;
; The artifact remains under the host temp directory for later exact concept
; lookup and incremental per-source refresh.  This run deliberately rebuilds
; from an empty artifact so its witness has no inherited stale rows.
;
; PROOF LEVEL: FOURTH-ARM ONLY (filesystem + repeated bounded fkwu workers; print_str pf-arm-mask 8, probed 2026-09-03)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/public-source-concept-index.fk form-stdlib/public-source-concept-shards.fk form-stdlib/public-source-concept-shard-drive.fk

(do
    (defn pscishlr-artifact ()
        (fs-path-join (fs-temp-dir) "public-source-concept-registry-v1"))
    (defn pscishlr-print-family-rows (rows)
        (if (nil? rows) 0
            (do
                (let row (head rows))
                (print_str (str_concat "family=" (str_concat (nth row 1)
                (str_concat " denominator=" (str_concat (int_to_str (nth row 2))
                (str_concat " indexed=" (str_concat (int_to_str (nth row 4))
                (str_concat " current=" (str_concat (int_to_str (nth row 5))
                (str_concat " over-budget=" (str_concat (int_to_str (nth row 6))
                (str_concat " stale=" (str_concat (int_to_str (nth row 9))
                (str_concat " missing=" (str_concat (int_to_str (nth row 10))
                (str_concat " invalid=" (str_concat (int_to_str (nth row 11))
                (str_concat " percent=" (str_concat (int_to_str (nth row 12))
                (str_concat " plan-current=" (str_concat (int_to_str (nth row 13))
                    "\n")))))))))))))))))))))
                (pscishlr-print-family-rows (tail rows)))))
    (let root ".")
    (let artifact (pscishlr-artifact))
    (let _old (fs-remove-tree artifact))
    (let _mkdir (fs-mkdir artifact))
    (let families (psci-families))
    (let init-ok (pscid-init-families root artifact families))
    (let build-ok (if (eq init-ok 1)
        (pscid-build-families root artifact families) 0))
    (let reset-ok (if (eq build-ok 1)
        (pscid-reset-validations root artifact families) 0))
    (let validate-ok (if (eq reset-ok 1)
        (pscid-validate-families root artifact families) 0))
    (let report (pscish-report-at root artifact))
    (print_str (str_concat "schema=" (str_concat (nth report 0) "\n")))
    (print_str (str_concat "artifact=" (str_concat artifact "\n")))
    (print_str (str_concat "init-ok=" (str_concat (int_to_str init-ok) "\n")))
    (print_str (str_concat "build-ok=" (str_concat (int_to_str build-ok) "\n")))
    (print_str (str_concat "validate-ok=" (str_concat (int_to_str validate-ok) "\n")))
    (print_str (str_concat "source-size-budget=" (str_concat
        (int_to_str (pscish-max-source-bytes)) "\n")))
    (print_str (str_concat "directory-entry-bound=" "16384\n"))
    (print_str (str_concat "denominator=" (str_concat
        (int_to_str (pscish-report-denominator report)) "\n")))
    (print_str (str_concat "planned=" (str_concat
        (int_to_str (pscish-report-planned report)) "\n")))
    (print_str (str_concat "indexed=" (str_concat
        (int_to_str (pscish-report-indexed report)) "\n")))
    (print_str (str_concat "current=" (str_concat
        (int_to_str (pscish-report-current report)) "\n")))
    (print_str (str_concat "over-budget=" (str_concat
        (int_to_str (pscish-report-over-budget report)) "\n")))
    (print_str (str_concat "failures=" (str_concat
        (int_to_str (pscish-report-failures report)) "\n")))
    (print_str (str_concat "unique-coordinate-ambiguities=" (str_concat
        (int_to_str (pscish-report-ambiguities report)) "\n")))
    (print_str (str_concat "stale=" (str_concat
        (int_to_str (pscish-report-stale report)) "\n")))
    (print_str (str_concat "missing=" (str_concat
        (int_to_str (pscish-report-missing report)) "\n")))
    (print_str (str_concat "invalid=" (str_concat
        (int_to_str (pscish-report-invalid report)) "\n")))
    (print_str (str_concat "source-retrieval-percent=" (str_concat
        (int_to_str (pscish-report-retrieval-percent report)) "\n")))
    (print_str (str_concat "source-retrieval-ready95=" (str_concat
        (int_to_str (pscish-report-threshold95? report)) "\n")))
    (print_str (str_concat "plan-current=" (str_concat
        (int_to_str (pscish-report-plan-current? report)) "\n")))
    (print_str (str_concat "rebuild-needed=" (str_concat
        (int_to_str (pscish-report-rebuild-needed? report)) "\n")))
    (print_str (str_concat "model-executed=" (str_concat
        (int_to_str (pscish-report-model-executed? report)) "\n")))
    (pscishlr-print-family-rows (pscish-report-family-rows report))
    0)
