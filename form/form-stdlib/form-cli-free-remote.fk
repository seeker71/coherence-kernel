; form-cli-free-remote.fk — form-cli partners with free remote minds.
;
; Yes's north star: form-cli with a free ChatGPT, or any other free remote
; AI, as functional and vital as it can be. Native still speaks first.
; This machine still carries. Water answers only gaps.
;
; Observed floor, this sitting:
;   inbound  ChatGPT free already meets the body through the plugin
;            (plugin/chatgpt-plugin.fk, auth none). That is the free
;            ChatGPT joint. It is not an outbound ChatGPT API.
;   outbound the ChatGPT REST API is metered, so it stays absent from
;            this catalog. Groq / Gemini-free / OpenRouter-free /
;            Hugging Face sit as host-owed OpenAI-compat faces.
;   walk     fcr-walk: native, then local, then remote.
;   voice    oracle-regent while the native heir is unproven
;            (form-cli-oracle-loop.fk); capture is unconditional.
;   retire   review-gap: remote review leaves when the internal judge
;            matches.
;
; No C seed growth. POST is a Form-rendered HTTP/1.0 request for
; tls_request / http-client; this cell does not send a completion
; without a host-reported ready face, and it never invents a key.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk form-stdlib/form-cli-review-gap.fk form-stdlib/form-cli-local-law.fk form-stdlib/form-cli-oracle-loop.fk
; Proven by: form-stdlib/tests/form-cli-free-remote-band.fk
; witnessed: 2026-08-19 -> 2047

(do
    ; A face: name, direction, role, cost, state, transport.
    (defn ffr-face (name direction role cost state transport)
        (list name direction role cost state transport))
    (defn ffr-name       (f) (nth f 0))
    (defn ffr-direction  (f) (nth f 1))
    (defn ffr-role       (f) (nth f 2))
    (defn ffr-cost       (f) (nth f 3))
    (defn ffr-state      (f) (nth f 4))
    (defn ffr-transport  (f) (nth f 5))

    (defn ffr-dir-in  () "inbound")
    (defn ffr-dir-out () "outbound")
    (defn ffr-cost-free    () "free")
    (defn ffr-cost-metered () "metered")
    (defn ffr-state-observed  () "observed")
    (defn ffr-state-host-owed () "host-owed")
    (defn ffr-state-absent    () "absent")

    (defn ffr-catalog ()
        (list
            (ffr-face "chatgpt-plugin" "inbound"  "ground"
                      "free"    "observed"  "plugin-serve")
            (ffr-face "groq"           "outbound" "oracle-regent"
                      "free"    "host-owed" "openai-compat")
            (ffr-face "gemini-free"    "outbound" "oracle-regent"
                      "free"    "host-owed" "openai-compat")
            (ffr-face "openrouter-free" "outbound" "review"
                      "free"    "host-owed" "openai-compat")
            (ffr-face "huggingface"    "outbound" "oracle-regent"
                      "free"    "host-owed" "openai-compat")
            (ffr-face "chatgpt-api"    "outbound" "oracle-regent"
                      "metered" "absent"    "openai-compat")))

    (defn ffr-n () (len (ffr-catalog)))

    (defn ffr-find-loop (xs name)
        (if (eq (len xs) 0) (empty)
            (if (str_eq (ffr-name (head xs)) name) (head xs)
                (ffr-find-loop (tail xs) name))))
    (defn ffr-find (name) (ffr-find-loop (ffr-catalog) name))

    (defn ffr-free? (f) (str_eq (ffr-cost f) (ffr-cost-free)))
    (defn ffr-ready? (f) (str_eq (ffr-state f) (ffr-state-observed)))
    (defn ffr-metered? (f) (str_eq (ffr-cost f) (ffr-cost-metered)))

    (defn ffr-n-free-loop (xs)
        (if (eq (len xs) 0) 0
            (add (if (ffr-free? (head xs)) 1 0)
                 (ffr-n-free-loop (tail xs)))))
    (defn ffr-n-free () (ffr-n-free-loop (ffr-catalog)))
    (defn ffr-n-ready-loop (xs)
        (if (eq (len xs) 0) 0
            (add (if (and (ffr-free? (head xs)) (ffr-ready? (head xs))) 1 0)
                 (ffr-n-ready-loop (tail xs)))))
    (defn ffr-n-ready () (ffr-n-ready-loop (ffr-catalog)))

    ; Native hit never leaves. Quiet local with a ready free face and
    ; water present may speak. Metered faces never enter this door.
    (defn ffr-may-speak? (native-hit local-ready net face-ready)
        (if (eq (fcr-walk native-hit local-ready) (fcr-lane-remote))
            (if (eq net 1)
                (if (eq face-ready 1) 1 0)
                0)
            0))

    (defn ffr-chatgpt-inbound () (ffr-find "chatgpt-plugin"))
    (defn ffr-chatgpt-outbound () (ffr-find "chatgpt-api"))

    ; JSON string escape for the OpenAI-compat envelope.
    (defn ffr-esc-byte (b)
        (if (eq b 92) "\\\\"
            (if (eq b 34) "\\\""
                (if (eq b 10) "\\n"
                    (byte_to_str b)))))
    (defn ffr-esc-loop (s i n acc)
        (if (ge i n) acc
            (ffr-esc-loop s (add i 1) n
                (str_concat acc (ffr-esc-byte (str_byte_at s i))))))
    (defn ffr-esc (s) (ffr-esc-loop s 0 (str_len s) ""))

    (defn ffr-chat-body (model prompt)
        (str_concat "{\"model\":\""
        (str_concat model
        (str_concat "\",\"messages\":[{\"role\":\"user\",\"content\":\""
        (str_concat (ffr-esc prompt)
                    "\"}],\"max_tokens\":128}")))))

    (defn ffr-render-post (host path body)
        (str_concat "POST "
        (str_concat path
        (str_concat " HTTP/1.0\r\nHost: "
        (str_concat host
        (str_concat "\r\nContent-Type: application/json\r\nContent-Length: "
        (str_concat (int_to_str (str_len body))
        (str_concat "\r\nConnection: close\r\n\r\n" body))))))))

    (defn ffr-groq-host () "api.groq.com")
    (defn ffr-groq-path () "/openai/v1/chat/completions")
    (defn ffr-groq-model () "llama-3.1-8b-instant")

    ; Capture every remote turn. Same 5-tuple as the oracle loop.
    (defn ffr-capture (request reference native grounded judge-score)
        (fcol-capture request reference native grounded judge-score))

    ; Standing review pair from core-run: not yet retired at tol 1.
    (defn ffr-review-ins () (list 80 40 90))
    (defn ffr-review-ors () (list 75 70 88))
    (defn ffr-review-retired? ()
        (frg-converged? (ffr-review-ins) (ffr-review-ors) 1))

    (defn ffr-spoken ()
        (str_concat "form-cli free-remote: ChatGPT free arrives inbound through the plugin. "
        (str_concat "The ChatGPT API is metered, so outbound ChatGPT stays absent. "
        (str_concat "Groq and other host-owed API faces wait on a reported endpoint. An API is not a client. "
                    (fcl-spoken-answer)))))

    (defn ffrk (cond bit) (if cond bit 0))
    (defn ffr-check ()
        (add (add (add (add (add (add (add (add (add (add
            (ffrk (eq (ffr-n) 6) 1)
            (ffrk (and (str_eq (ffr-direction (ffr-chatgpt-inbound)) (ffr-dir-in))
                       (and (ffr-free? (ffr-chatgpt-inbound))
                            (ffr-ready? (ffr-chatgpt-inbound)))) 2))
            (ffrk (and (ffr-metered? (ffr-chatgpt-outbound))
                       (str_eq (ffr-state (ffr-chatgpt-outbound)) (ffr-state-absent))) 4))
            (ffrk (and (eq (ffr-n-free) 5) (eq (ffr-n-ready) 1)) 8))
            (ffrk (eq (ffr-may-speak? 1 1 1 1) 0) 16))
            (ffrk (eq (ffr-may-speak? 0 1 1 1) 0) 32))
            (ffrk (eq (ffr-may-speak? 0 0 1 1) 1) 64))
            (ffrk (eq (ffr-may-speak? 0 0 0 1) 0) 128))
            (ffrk (and (ge (str_find (ffr-chat-body (ffr-groq-model) "hello") "hello" 0) 0)
                       (ge (str_find (ffr-render-post (ffr-groq-host) (ffr-groq-path)
                            (ffr-chat-body (ffr-groq-model) "hello")) "POST " 0) 0)) 256))
            (ffrk (str_eq (fcol-cap-lane (ffr-capture "q" "r" "n" 1 20))
                          "oracle-regent") 512))
            (ffrk (eq (ffr-review-retired?) 0) 1024)))

    0)
