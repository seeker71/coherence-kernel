// jit-once-born.fk — one birth per program shape UNDER ONE MEANING, threaded
// as data. Request by interned structural identity; compile only on first
// meeting; dissolution is a membrane act with observable counts, never a
// silent fallback.
//
// CONVERGED, second morning: the numeric stand-in key is gone. Identity is
// jssc's discipline — intern_node over an exact int list — under this cell's
// OWN category and version, because an identity's category is part of its
// meaning and borrowing jssc's would let a lowered program collide with a
// decision-value list that flattens alike.
//
// FLATTENING IS INJECTIVE. An adversarial review found the real hole in the
// folded key: nested rows flattened bare lose tree shape, and two different
// programs could share a key — the one failure with no observable signal,
// wrong machine code answering under route "native". Each row therefore
// enters the identity as (row-length, row ints...), which makes the flat
// list a bijection of the nested one; interning does the rest exactly.
//
// THE EPOCH LIVES IN THE REGISTRY, NOT THE CALLER. Two flows threading their
// own epoch copies can validate stale entries or dissolve each other's fresh
// ones in a ping-pong the counters read as routine churn. Here the registry
// carries the epoch it was born under; births stamp FROM the registry; a
// request needs no epoch argument at all. Freshness changes only by passing
// the whole registry through jonb-membrane with a new epoch, which sweeps:
// stale entries (old meaning) and corrupt entries (retained image no longer
// folds to its birth image-id) dissolve SEPARATELY and countably. Identity
// includes the epoch, so a dead meaning is not detected on the hot path —
// it is unreachable.
//
// ROUTES ARE EXPLICIT: "native" | "form" | "refused", and nothing for a
// malformed request. The form route is a real interpreter over the same
// op-tag program (tags 1 LIT, 2 ARG, 3 ADD, 4 SUB, 5 MUL, 8 DIV, 14 EQ and
// 6 COND).  Equality and branch are pure Form-native bytecode already lowered
// by form-lower, so a high-BML finite decision can be cached as the same
// NodeID-addressed native page rather than re-entering source text.  Host
// coupled tags still refuse by name, so
// native-vs-form agreement is bandable, and a host without the door answers
// honestly instead of pretending to be the JIT.
//
// preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk
//
section [form.bml] {
    // ── identity: own category, version, epoch, injective shape ────────────
    def jonb-category() = make_nodeid(31, 2, 0, 181);
    def jonb-version() = "jit-once-born-v2";
    def jonb-flat-row(row, acc) = jonb-flat-ints(row, cons(len(row), acc));
    def jonb-flat-ints(xs, acc) = (Comparable) len(xs) == 0 ? acc : jonb-flat-ints(tail(xs), cons(head(xs), acc));
    def jonb-flat-rows(rows, acc) = (Comparable) len(rows) == 0 ? acc : jonb-flat-rows(tail(rows), jonb-flat-row(head(rows), acc));
    def jonb-flat(prog, root, epoch) = reverse(cons(root, jonb-flat-rows(prog, [epoch])));
    def jonb-int-nodes(xs, acc) = (Comparable) len(xs) == 0 ? reverse(acc) : jonb-int-nodes(tail(xs), cons(intern_trivial_int(head(xs)), acc));
    def jonb-identity(prog, root, epoch) = intern_node(jonb-category(), cons(intern_trivial_string(jonb-version()), jonb-int-nodes(jonb-flat(prog, root, epoch), empty())));
    // ── the image's own identity, folded at birth and at membranes only ────
    def jonb-image-id(img) = jonb-img-fold(img, 1073741789, 5381);
    def jonb-img-fold(xs, m, acc) = (Comparable) len(xs) == 0 ? acc : jonb-img-fold(tail(xs), m, (acc * 33 + head(xs)) % m);
    // ── the registry: (list epoch entries); entry = (identity image image-id)
    def jonb-registry(epoch) = [epoch, []];
    def jonb-epoch(reg) = reg[0];
    def jonb-entries(reg) = reg[1];
    def jonb-size(reg) = len(jonb-entries(reg));
    def jonb-find(es, id) = (Comparable) len(es) == 0 ? nothing() : (Comparable) ((Value) head(es)[0] == id) == 1 ? head(es) : jonb-find(tail(es), id);
    def jonb-lookup(reg, prog, root) = {
        let e = jonb-find(jonb-entries(reg), jonb-identity(prog, root, jonb-epoch(reg)));
        nothing?(e) ? nothing() : e[1];
    };
    // a birth that produced no image is refused, never indexed
    def jonb-retain(reg, id, img) = nothing?(img) ? nothing() : (Comparable) len(img) == 0 ? nothing() : [jonb-epoch(reg), cons([id, img, jonb-image-id(img), [0, id, img]], jonb-entries(reg))];
    // ── the form route: the same program, interpreted ──────────────────────
    def jonb-eval(prog, i, arg) = {
        let row = prog[i];
        let tag = row[0];
        (Comparable) tag == 1 ? row[1] : (Comparable) tag == 2 ? arg : (Comparable) tag == 3 ? jonb-eval(prog, row[1], arg) + jonb-eval(prog, row[2], arg) : (Comparable) tag == 4 ? jonb-eval(prog, row[1], arg) - jonb-eval(prog, row[2], arg) : (Comparable) tag == 5 ? jonb-eval(prog, row[1], arg) * jonb-eval(prog, row[2], arg) : (Comparable) tag == 8 ? jonb-eval(prog, row[1], arg) / jonb-eval(prog, row[2], arg) : (Comparable) tag == 14 ? (Comparable) jonb-eval(prog, row[1], arg) == jonb-eval(prog, row[2], arg) ? 1 : 0 : (Comparable) tag == 6 ? (Comparable) jonb-eval(prog, row[1], arg) == 0 ? jonb-eval(prog, row[3], arg) : jonb-eval(prog, row[2], arg) : nothing();
    };
    // ── request: exactly one birth per (shape, meaning); routes explicit ───
    // returns (list value route reg' born). One retained Form request carries
    // [invoke, structural identity, image] through the existing inram door.
    // The carrier reads the image only at first crystallization; later calls reach its page
    // by the interned NodeID index. No new fixed primitive seat names this flow.
    def jonb-exec(request, prog, root, arg, reg, born) = {
        let native = jit_leaf_inram(request, arg);
        nothing?(native) ? [jonb-eval(prog, root, arg), "form", reg, born] : [native, "native", reg, born];
    };
    def jonb-request(reg, prog, root, arg) = {
        let id = jonb-identity(prog, root, jonb-epoch(reg));
        let e = jonb-find(jonb-entries(reg), id);
        nothing?(e) ? {
            let img = lo-compile-fn(prog, root);
            let reg2 = jonb-retain(reg, id, img);
            nothing?(reg2) ? [jonb-eval(prog, root, arg), "refused", reg, 0] : jonb-exec(head(jonb-entries(reg2))[3], prog, root, arg, reg2, 1);
        } : jonb-exec(e[3], prog, root, arg, reg, 0);
    };
    // the form route, requestable by name — a host without the door, or a
    // caller checking agreement, asks for it explicitly
    def jonb-request-form(reg, prog, root, arg) = [jonb-eval(prog, root, arg), "form", reg, 0];
    // ── the membrane: new meaning in, dissolutions out, all counted ────────
    // returns (list reg' dissolved-stale dissolved-corrupt kept)
    def jonb-membrane(reg, new-epoch) = {
        let same = (Comparable) jonb-epoch(reg) == new-epoch;
        jonb-sweep-go(jonb-entries(reg), new-epoch, same, [], 0, 0);
    };
    def jonb-sweep-go(es, new-epoch, same, kept, st, co) = (Comparable) len(es) == 0 ? [[new-epoch, reverse(kept)], st, co, len(kept)] : {
        let e = head(es);
        (Comparable) same == 0 ? {
            let released = jonb-release-entry(e);
            jonb-sweep-go(tail(es), new-epoch, same, kept, st + 1, co);
        } : (Comparable) jonb-image-id(e[1]) == e[2] ? jonb-sweep-go(tail(es), new-epoch, same, cons(e, kept), st, co) : {
            let released = jonb-release-entry(e);
            jonb-sweep-go(tail(es), new-epoch, same, kept, st, co + 1);
        };
    };
    def jonb-release-entry(e) = jit_leaf_inram([1, e[0], empty()], 0);
    // ── the audited flow ───────────────────────────────────────────────────
    def jonb-run-all(reg, jobs, results, borns) = (Comparable) len(jobs) == 0 ? [results, reg, borns] : {
        let j = head(jobs);
        let r = jonb-request(reg, j[0], j[1], j[2]);
        jonb-run-all(r[2], tail(jobs), append(results, [r[0]]), borns + r[3]);
    };
    0;
}
