; jit-once-born.fk — one birth per program shape UNDER ONE MEANING, threaded
; as data. Request by interned structural identity; compile only on first
; meeting; dissolution is a membrane act with observable counts, never a
; silent fallback.
;
; CONVERGED, second morning: the numeric stand-in key is gone. Identity is
; jssc's discipline — intern_node over an exact int list — under this cell's
; OWN category and version, because an identity's category is part of its
; meaning and borrowing jssc's would let a lowered program collide with a
; decision-value list that flattens alike.
;
; FLATTENING IS INJECTIVE. An adversarial review found the real hole in the
; folded key: nested rows flattened bare lose tree shape, and two different
; programs could share a key — the one failure with no observable signal,
; wrong machine code answering under route "native". Each row therefore
; enters the identity as (row-length, row ints...), which makes the flat
; list a bijection of the nested one; interning does the rest exactly.
;
; THE EPOCH LIVES IN THE REGISTRY, NOT THE CALLER. Two flows threading their
; own epoch copies can validate stale entries or dissolve each other's fresh
; ones in a ping-pong the counters read as routine churn. Here the registry
; carries the epoch it was born under; births stamp FROM the registry; a
; request needs no epoch argument at all. Freshness changes only by passing
; the whole registry through jonb-membrane with a new epoch, which sweeps:
; stale entries (old meaning) and corrupt entries (retained image no longer
; folds to its birth image-id) dissolve SEPARATELY and countably. Identity
; includes the epoch, so a dead meaning is not detected on the hot path —
; it is unreachable.
;
; ROUTES ARE EXPLICIT: "native" | "form" | "refused", and nothing for a
; malformed request. The form route is a real interpreter over the same
; op-tag program (tags 1 LIT, 2 ARG, 3 ADD, 4 SUB, 5 MUL, 8 DIV — the pure
; leaf subset; 6/9/10/11 are host-coupled and refuse by name), so
; native-vs-form agreement is bandable, and a host without the door answers
; honestly instead of pretending to be the JIT.
;
; preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk
;
; Proven by: form-stdlib/tests/jit-once-born-band.fk

(do
    ; ── identity: own category, version, epoch, injective shape ────────────
    (defn jonb-category () (make_nodeid 31 2 0 181))
    (defn jonb-version () "jit-once-born-v2")

    (defn jonb-flat-row (row acc)
        (jonb-flat-ints row (cons (len row) acc)))
    (defn jonb-flat-ints (xs acc)
        (if (eq (len xs) 0) acc
            (jonb-flat-ints (tail xs) (cons (head xs) acc))))
    (defn jonb-flat-rows (rows acc)
        (if (eq (len rows) 0) acc
            (jonb-flat-rows (tail rows) (jonb-flat-row (head rows) acc))))
    (defn jonb-flat (prog root epoch)
        (reverse (cons root (jonb-flat-rows prog (list epoch)))))

    (defn jonb-int-nodes (xs acc)
        (if (eq (len xs) 0) (reverse acc)
            (jonb-int-nodes (tail xs) (cons (intern_trivial_int (head xs)) acc))))
    (defn jonb-identity (prog root epoch)
        (intern_node (jonb-category)
            (cons (intern_trivial_string (jonb-version))
                  (jonb-int-nodes (jonb-flat prog root epoch) (empty)))))

    ; ── the image's own identity, folded at birth and at membranes only ────
    (defn jonb-image-id (img) (jonb-img-fold img 1073741789 5381))
    (defn jonb-img-fold (xs m acc)
        (if (eq (len xs) 0) acc
            (jonb-img-fold (tail xs) m (mod (add (mul acc 33) (head xs)) m))))

    ; ── the registry: (list epoch entries); entry = (identity image image-id)
    (defn jonb-registry (epoch) (list epoch (list)))
    (defn jonb-epoch (reg) (nth reg 0))
    (defn jonb-entries (reg) (nth reg 1))
    (defn jonb-size (reg) (len (jonb-entries reg)))

    (defn jonb-find (es id)
        (if (eq (len es) 0) (nothing)
            (if (eq (value_eq (nth (head es) 0) id) 1) (head es)
                (jonb-find (tail es) id))))
    (defn jonb-lookup (reg prog root)
        (do (let e (jonb-find (jonb-entries reg)
                (jonb-identity prog root (jonb-epoch reg))))
            (if (nothing? e) (nothing) (nth e 1))))

    ; a birth that produced no image is refused, never indexed
    (defn jonb-retain (reg id img)
        (if (nothing? img) (nothing)
            (if (eq (len img) 0) (nothing)
                (list (jonb-epoch reg)
                      (cons (list id img (jonb-image-id img))
                            (jonb-entries reg))))))

    ; ── the form route: the same program, interpreted ──────────────────────
    (defn jonb-eval (prog i arg)
        (do (let row (nth prog i))
            (let tag (nth row 0))
            (if (eq tag 1) (nth row 1)
            (if (eq tag 2) arg
            (if (eq tag 3) (add (jonb-eval prog (nth row 1) arg)
                                (jonb-eval prog (nth row 2) arg))
            (if (eq tag 4) (sub (jonb-eval prog (nth row 1) arg)
                                (jonb-eval prog (nth row 2) arg))
            (if (eq tag 5) (mul (jonb-eval prog (nth row 1) arg)
                                (jonb-eval prog (nth row 2) arg))
            (if (eq tag 8) (div (jonb-eval prog (nth row 1) arg)
                                (jonb-eval prog (nth row 2) arg))
                (nothing)))))))))

    ; ── request: exactly one birth per (shape, meaning); routes explicit ───
    ; returns (list value route reg' born)
    (defn jonb-request (reg prog root arg)
        (do (let id (jonb-identity prog root (jonb-epoch reg)))
            (let e (jonb-find (jonb-entries reg) id))
            (if (nothing? e)
                (do (let img (lo-compile-fn prog root))
                    (let reg2 (jonb-retain reg id img))
                    (if (nothing? reg2)
                        (list (jonb-eval prog root arg) "refused" reg 0)
                        (list (jit_leaf_inram img arg) "native" reg2 1)))
                (list (jit_leaf_inram (nth e 1) arg) "native" reg 0))))

    ; the form route, requestable by name — a host without the door, or a
    ; caller checking agreement, asks for it explicitly
    (defn jonb-request-form (reg prog root arg)
        (list (jonb-eval prog root arg) "form" reg 0))

    ; ── the membrane: new meaning in, dissolutions out, all counted ────────
    ; returns (list reg' dissolved-stale dissolved-corrupt kept)
    (defn jonb-membrane (reg new-epoch)
        (do (let same (eq (jonb-epoch reg) new-epoch))
            (jonb-sweep-go (jonb-entries reg) new-epoch same (list) 0 0)))
    (defn jonb-sweep-go (es new-epoch same kept st co)
        (if (eq (len es) 0)
            (list (list new-epoch (reverse kept)) st co (len kept))
            (do (let e (head es))
                (if (eq same 0)
                    (jonb-sweep-go (tail es) new-epoch same kept (add st 1) co)
                    (if (eq (jonb-image-id (nth e 1)) (nth e 2))
                        (jonb-sweep-go (tail es) new-epoch same (cons e kept) st co)
                        (jonb-sweep-go (tail es) new-epoch same kept st (add co 1)))))))

    ; ── the audited flow ───────────────────────────────────────────────────
    (defn jonb-run-all (reg jobs results borns)
        (if (eq (len jobs) 0) (list results reg borns)
            (do (let j (head jobs))
                (let r (jonb-request reg (nth j 0) (nth j 1) (nth j 2)))
                (jonb-run-all (nth r 2) (tail jobs)
                    (append results (list (nth r 0)))
                    (add borns (nth r 3))))))
    0)
