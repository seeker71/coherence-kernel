section [form.bml] {
    class FormGlassLiveUIAuthority {
        field FGLUIAuthorityPath = "form/form-stdlib/bml/form-glass-live-ui.bml";
        field FGLUIAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassLiveUI {
        field FGLUISchema = "form-glass-live-ui-v2";
        ref fglui-authority = FormGlassLiveUIAuthority;
        thought fglui-law = list("observed-frame-history", "measured-layout", "typed-non-values", "six-focus-views", "dense-kt-atlas", "resource-frame-raster", "phase-and-channel-flow", "evidence-drilldown", "no-wrap-no-scroll", "bounded-import-shards");
    }
    0;
}
