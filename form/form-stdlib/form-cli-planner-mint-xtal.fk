
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-planner-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormPlannerMintAuthority () (list "abstraction" "FormPlannerMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NeedEvents () 95)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fpl-authority () FormPlannerMintAuthority)
(defn fpl-pattern () (list "ground" "walk" "one-turn" "tool" "observe" "land" "no-transcript" "pending"))
(defn fpl-lanes () (list "when" "where" "which" "what" "who" "how" "why" "knowledge-query" "walk"))
(defn fpl-skills () (list "ground-first" "walk-lane" "one-turn" "tool-pick" "mill-observe" "land" "no-transcript" "pending-honest"))
(defn fpl-sources () (list "AGENTS.md" "form/form-stdlib/form-cli-local-ready.bml" "form/form-stdlib/form-cli-one-turn.bml" "form/form-stdlib/form-cli-session-local.bml" "form/form-stdlib/land-cadence.fk" "observe/preflight.fk" "ingest/name-build-observe.fk" "docs/live-dynamic-diagnostics.md"))
(defn fpl-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fpl-ground-stems () (list "read the cell before speaking a structural answer" "a miss is honest say it is not here rather than inventing" "relay what you find attributed to where it lives" "form-first before the rented voice"))
(defn fpl-walk-stems () (list "native then local then remote form-cli first" "fcr-walk hit ready selects lane 0 or 1 or 2" "unknown miss stays remote a known Form repair is local-ready" "water answers only gaps"))
(defn fpl-turn-stems () (list "one local turn is the request remote reviews at most once" "a third remote is leak not another attempt" "remote absent is timeout stop after local" "fot-next-drop when remote-present is 0"))
(defn fpl-tool-stems () (list "form-run wraps observed shells so the framebuffer keeps the receipt" "grep the body before writing a sibling cell" "read the organ then write the mill" "host rg and ls are local-ready not a remote oracle"))
(defn fpl-observe-stems () (list "name then write BML then compile then band then keep only if the kernel stops objecting" "a green number with nonzero exit is a fold over nothing" "delete stale fkb before believing a verdict" "preflight before you trust the band"))
(defn fpl-land-stems () (list "fetch origin rebase push no force" "unexplained deletions stay unstaged" "even and clean is a clear picture nothing to land this breath" "quiet water turns push into silence"))
(defn fpl-quiet-stems () (list "never store private prompt or answer in the framebuffer" "count tools and lanes not the words of the turn" "serialized-tool-output-span-bytes stays 0" "learn the shape of the planner not the chat"))
(defn fpl-pending-stems () (list "fqt-lora stays 0 until generate loads tensors" "pending is honest a named gap is a work order" "do not dress a declared offering as a counted share" "Qwen GGUF stays frozen"))
(defn fpl-stems (class) (if (str_eq class "ground-first") (fpl-ground-stems) (if (str_eq class "walk-lane") (fpl-walk-stems) (if (str_eq class "one-turn") (fpl-turn-stems) (if (str_eq class "tool-pick") (fpl-tool-stems) (if (str_eq class "mill-observe") (fpl-observe-stems) (if (str_eq class "land") (fpl-land-stems) (if (str_eq class "no-transcript") (fpl-quiet-stems) (fpl-pending-stems)))))))))
(defn fpl-ask (lane gloss) (if (str_eq lane "when") (str_concat "When is this computable: " gloss) (if (str_eq lane "where") (str_concat "Where is the NodeID for: " gloss) (if (str_eq lane "which") (str_concat "Which cell answers: " gloss) (if (str_eq lane "what") (str_concat "What is: " gloss) (if (str_eq lane "who") (str_concat "Who offers: " gloss) (if (str_eq lane "how") (str_concat "How does the body: " gloss) (if (str_eq lane "why") (str_concat "Why does Form: " gloss) (if (str_eq lane "knowledge-query") (str_concat "Emit knowledge-query envelope ANCHOR PATH for: " gloss) (str_concat "Walk native then local then remote for: " gloss))))))))))
(defn fpl-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fpl-situation (skill lane i split) (do (let stems (fpl-stems skill)) (let stem (nth stems (fpl-mix i (len stems)))) (str_concat (fpl-prefix split) (str_concat (fpl-ask lane stem) (str_concat " case " (int_to_str i))))))
(defn fpl-row (skill lane i split) (list split skill (fpl-situation skill lane i split)))
(defn fpl-i-rows (skill lane i n split acc) (if (eq i n) acc (fpl-i-rows skill lane (add i 1) n split (cons (fpl-row skill lane i split) acc))))
(defn fpl-lane-rows (skill lanes n split acc) (if (eq (len lanes) 0) acc (fpl-lane-rows skill (tail lanes) n split (fpl-i-rows skill (head lanes) 0 n split acc))))
(defn fpl-skill-rows (skills tn hn acc) (if (eq (len skills) 0) acc (fpl-skill-rows (tail skills) tn hn (fpl-lane-rows (head skills) (fpl-lanes) hn (SplitHeldout) (fpl-lane-rows (head skills) (fpl-lanes) tn (SplitTrain) acc)))))
(defn fpl-corpus (tn hn) (fpl-skill-rows (fpl-skills) tn hn (tail (list "x"))))
(defn fpl-n (tn hn) (mul (len (fpl-skills)) (mul (len (fpl-lanes)) (add tn hn))))
(defn fpl-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fpl-has-situation (tail rows) s))))
(defn fpl-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fpl-train-only (tail rows) (cons (head rows) acc)) (fpl-train-only (tail rows) acc))))
(defn fpl-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fpl-has-situation (fpl-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fpl-leakage-loop all (tail rows)))))
(defn fpl-leakage (rows) (fpl-leakage-loop rows rows))
(defn fpl-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fpl-has-situation seen (nth (head rows) 2)) 1) (fpl-unique-loop (tail rows) seen) (fpl-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fpl-unique (rows) (fpl-unique-loop rows (tail (list "x"))))
(defn fpl-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fpl-count-split (tail rows) split))))
(defn fpl-lora-writer () (LoraWriter))
(defn fpl-mix-diverse () (if (eq (fpl-mix 0 9) (fpl-mix 1 9)) 0 1))
(defn fpl-pair-hit (rows skill lane) (fpl-has-situation rows (fpl-situation skill lane 0 (SplitTrain))))
(defn fpl-lane-cover (rows skill lanes) (if (eq (len lanes) 0) 1 (if (eq (fpl-pair-hit rows skill (head lanes)) 0) 0 (fpl-lane-cover rows skill (tail lanes)))))
(defn fpl-skill-cover (rows skills) (if (eq (len skills) 0) 1 (if (eq (fpl-lane-cover rows (head skills) (fpl-lanes)) 0) 0 (fpl-skill-cover rows (tail skills)))))
(defn fpl-covers-all (rows) (fpl-skill-cover rows (fpl-skills)))
(defn fpl-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fpl-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fpl-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fpl-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fpl-heldout-hit models names (head rows)) (fpl-heldout-correct-loop models names (tail rows)))))
(defn fpl-heldout-correct (rows) (do (let names (fpl-skills)) (let models (fqt-fit rows names)) (fpl-heldout-correct-loop models names rows)))
(defn fpl-bit (ok bit) (if ok bit 0))
(defn fpl-check () (do (let rows (fpl-corpus 1 1)) (let n (fpl-n 1 1)) (let correct (fpl-heldout-correct rows)) (let c0 (fpl-bit (eq n 144) 1)) (let c1 (fpl-bit (eq (fpl-mix-diverse) 1) 2)) (let c2 (fpl-bit (eq (fpl-leakage rows) 0) 4)) (let c3 (fpl-bit (eq (fpl-unique rows) n) 8)) (let c4 (fpl-bit (and (eq (fpl-count-split rows (SplitTrain)) 72) (eq (fpl-count-split rows (SplitHeldout)) 72)) 16)) (let c5 (fpl-bit (ge correct 54) 32)) (let c6 (fpl-bit (and (eq (fpl-lora-writer) 0) (eq (NeedEvents) 95)) 64)) (let c7 (fpl-bit (eq (fpl-covers-all rows) 1) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormPlannerMint () (list "abstraction" "FormPlannerMint" (list "T") (list "fpl-mix" "fpl-ground-stems" "fpl-walk-stems" "fpl-turn-stems" "fpl-tool-stems" "fpl-observe-stems" "fpl-land-stems" "fpl-quiet-stems" "fpl-pending-stems" "fpl-stems" "fpl-ask" "fpl-prefix" "fpl-situation" "fpl-row" "fpl-i-rows" "fpl-lane-rows" "fpl-skill-rows" "fpl-corpus" "fpl-n" "fpl-has-situation" "fpl-train-only" "fpl-leakage-loop" "fpl-leakage" "fpl-unique-loop" "fpl-unique" "fpl-count-split" "fpl-lora-writer" "fpl-mix-diverse" "fpl-pair-hit" "fpl-lane-cover" "fpl-skill-cover" "fpl-covers-all" "fpl-predict" "fpl-heldout-hit" "fpl-heldout-correct-loop" "fpl-heldout-correct" "fpl-bit" "fpl-check") (list "MixA" "MixB" "NeedEvents" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fpl-authority") (list "fpl-pattern" "fpl-lanes" "fpl-skills" "fpl-sources")))
0
