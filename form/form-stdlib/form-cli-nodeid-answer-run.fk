; form-cli-nodeid-answer-run.fk — print a delayed recipe pointer.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-nodeid-answer.fk

(do
    (print_str (fnid-speak))
    (print_str (fnid-force-speak))
    (print_str (str_concat "fnid-check=" (str_concat (int_to_str (fnid-check)) "\n")))
    0)
