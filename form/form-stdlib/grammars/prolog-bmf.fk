// grammars/prolog-bmf.fk - Prolog grammar as native BMF object rules
import form-stdlib/dialect-categories.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/compiler.fk;
section [form.bml] {
    //
    // Per-dialect category constants (PL-BMF-*) are declared as data in
    // form-stdlib/form-ontology.json, and form-ontology-loader.fk materializes the
    // Form-side bindings. This file references them as free identifiers; load
    // form-ontology-loader.fk as a prelude before this file.
    //
    // Every rule is reversible: => names the emit direction (source objects →
    // interned recipe node) and <= names the source direction (recipe node →
    // source objects), so one rule set carries Prolog in both directions and
    // bmf-roundtrip can prove source → node → source on each rule.
    //; top-level: a let here is a global the defns below can see -- on fkwu a do-local let never reaches a defn frame
    def prolog-src-keyword(value) = bmf-atom("prolog-keyword", value);
    def prolog-src-name(value) = bmf-atom("prolog-name", value);
    def prolog-src-op(value) = bmf-atom("prolog-op", value);
    def prolog-src-string(value) = bmf-atom("prolog-string", value);
    def prolog-src-int(value) = bmf-atom("prolog-int", value);
    def prolog-kw(value) = object-lit("prolog-keyword", value);
    def prolog-op(value) = object-lit("prolog-op", value);
    def prolog-name(capture-name) = ["capture", capture-name, object-lit("prolog-name", "")];
    def prolog-string-lit(capture-name) = ["capture", capture-name, object-lit("prolog-string", "")];
    def prolog-int-lit(capture-name) = ["capture", capture-name, object-lit("prolog-int", "")];
    def plbmf-value(objects, capture-name) = bmf-collection-value(objects, capture-name);
    def plbmf-string(objects, capture-name) = intern_trivial_string(plbmf-value(objects, capture-name));
    def plbmf-int(objects, capture-name) = intern_trivial_int(str_to_int(plbmf-value(objects, capture-name)));
    def plbmf-node-kids(object) = node_children(bmf-object-value(object));
    //; --- facts: ground clauses with no body --------------------------
    def plbmf-emit-fact0(objects) = intern_node(PL-BMF-FACT, [plbmf-string(objects, "name")]);
    def plbmf-source-fact0(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op(".")];
    };
    def plbmf-emit-fact1(objects) = intern_node(PL-BMF-FACT, [plbmf-string(objects, "name"), plbmf-string(objects, "arg")]);
    def plbmf-source-fact1(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(")"), prolog-src-op(".")];
    };
    def plbmf-emit-fact2(objects) = intern_node(PL-BMF-FACT, [plbmf-string(objects, "name"), plbmf-string(objects, "a"), plbmf-string(objects, "b")]);
    def plbmf-source-fact2(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(","), prolog-src-name(node_value(kids[2])), prolog-src-op(")"), prolog-src-op(".")];
    };
    //; --- rules: head :- body --------------------------------------------
    def plbmf-emit-rule1(objects) = intern_node(PL-BMF-RULE, [plbmf-string(objects, "head"), plbmf-string(objects, "hx"), plbmf-string(objects, "goal"), plbmf-string(objects, "gx")]);
    def plbmf-source-rule1(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(")"), prolog-src-op(":-"), prolog-src-name(node_value(kids[2])), prolog-src-op("("), prolog-src-name(node_value(kids[3])), prolog-src-op(")"), prolog-src-op(".")];
    };
    def plbmf-emit-rule2(objects) = intern_node(PL-BMF-RULE, [plbmf-string(objects, "head"), plbmf-string(objects, "hx"), plbmf-string(objects, "hz"), plbmf-string(objects, "g1"), plbmf-string(objects, "a1"), plbmf-string(objects, "a2"), plbmf-string(objects, "g2"), plbmf-string(objects, "b1"), plbmf-string(objects, "b2")]);
    def plbmf-source-rule2(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(","), prolog-src-name(node_value(kids[2])), prolog-src-op(")"), prolog-src-op(":-"), prolog-src-name(node_value(kids[3])), prolog-src-op("("), prolog-src-name(node_value(kids[4])), prolog-src-op(","), prolog-src-name(node_value(kids[5])), prolog-src-op(")"), prolog-src-op(","), prolog-src-name(node_value(kids[6])), prolog-src-op("("), prolog-src-name(node_value(kids[7])), prolog-src-op(","), prolog-src-name(node_value(kids[8])), prolog-src-op(")"), prolog-src-op(".")];
    };
    def plbmf-emit-rule-cut(objects) = intern_node(PL-BMF-CUT, [plbmf-string(objects, "head"), plbmf-string(objects, "goal")]);
    def plbmf-source-rule-cut(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op(":-"), prolog-src-name(node_value(kids[1])), prolog-src-op(","), prolog-src-op("!"), prolog-src-op(".")];
    };
    //; --- directives and queries ---------------------------------------
    def plbmf-emit-directive(objects) = intern_node(PL-BMF-DIRECTIVE, [plbmf-string(objects, "goal")]);
    def plbmf-source-directive(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-op(":-"), prolog-src-name(node_value(kids[0])), prolog-src-op(".")];
    };
    def plbmf-emit-directive-call1(objects) = intern_node(PL-BMF-DIRECTIVE, [plbmf-string(objects, "goal"), plbmf-string(objects, "arg")]);
    def plbmf-source-directive-call1(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-op(":-"), prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(")"), prolog-src-op(".")];
    };
    def plbmf-emit-query2(objects) = intern_node(PL-BMF-QUERY, [plbmf-string(objects, "goal"), plbmf-string(objects, "a"), plbmf-string(objects, "b")]);
    def plbmf-source-query2(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-op("?-"), prolog-src-name(node_value(kids[0])), prolog-src-op("("), prolog-src-name(node_value(kids[1])), prolog-src-op(","), prolog-src-name(node_value(kids[2])), prolog-src-op(")"), prolog-src-op(".")];
    };
    //; --- arithmetic, lists, unification, DCG ---------------------------
    def plbmf-emit-is-add(objects) = intern_node(PL-BMF-IS, [plbmf-string(objects, "target"), plbmf-string(objects, "a"), plbmf-string(objects, "b")]);
    def plbmf-source-is-add(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-keyword("is"), prolog-src-name(node_value(kids[1])), prolog-src-op("+"), prolog-src-name(node_value(kids[2]))];
    };
    def plbmf-emit-is-add-int(objects) = intern_node(PL-BMF-IS, [plbmf-string(objects, "target"), plbmf-string(objects, "a"), plbmf-int(objects, "value")]);
    def plbmf-source-is-add-int(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-keyword("is"), prolog-src-name(node_value(kids[1])), prolog-src-op("+"), prolog-src-int(node_value(kids[2]).str())];
    };
    def plbmf-emit-cons(objects) = intern_node(PL-BMF-LIST, [plbmf-string(objects, "head"), plbmf-string(objects, "tail")]);
    def plbmf-source-cons(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-op("["), prolog-src-name(node_value(kids[0])), prolog-src-op("|"), prolog-src-name(node_value(kids[1])), prolog-src-op("]")];
    };
    def plbmf-emit-nil-list(_objects) = intern_node(PL-BMF-LIST, []);
    def plbmf-source-nil-list(_object) = [prolog-src-op("["), prolog-src-op("]")];
    def plbmf-emit-unify(objects) = intern_node(PL-BMF-UNIFY, [plbmf-string(objects, "x"), plbmf-string(objects, "y")]);
    def plbmf-source-unify(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("="), prolog-src-name(node_value(kids[1]))];
    };
    def plbmf-emit-dcg2(objects) = intern_node(PL-BMF-DCG, [plbmf-string(objects, "head"), plbmf-string(objects, "b1"), plbmf-string(objects, "b2")]);
    def plbmf-source-dcg2(object) = {
        let kids = plbmf-node-kids(object);
        [prolog-src-name(node_value(kids[0])), prolog-src-op("-->"), prolog-src-name(node_value(kids[1])), prolog-src-op(","), prolog-src-name(node_value(kids[2])), prolog-src-op(".")];
    };
    let prolog-bmf-native-section = [bmf-native("plbmf-emit-fact0", plbmf-emit-fact0, PL-BMF-FACT), bmf-native("plbmf-emit-fact1", plbmf-emit-fact1, PL-BMF-FACT), bmf-native("plbmf-emit-fact2", plbmf-emit-fact2, PL-BMF-FACT), bmf-native("plbmf-emit-rule1", plbmf-emit-rule1, PL-BMF-RULE), bmf-native("plbmf-emit-rule2", plbmf-emit-rule2, PL-BMF-RULE), bmf-native("plbmf-emit-rule-cut", plbmf-emit-rule-cut, PL-BMF-CUT), bmf-native("plbmf-emit-directive", plbmf-emit-directive, PL-BMF-DIRECTIVE), bmf-native("plbmf-emit-directive-call1", plbmf-emit-directive-call1, PL-BMF-DIRECTIVE), bmf-native("plbmf-emit-query2", plbmf-emit-query2, PL-BMF-QUERY), bmf-native("plbmf-emit-is-add", plbmf-emit-is-add, PL-BMF-IS), bmf-native("plbmf-emit-is-add-int", plbmf-emit-is-add-int, PL-BMF-IS), bmf-native("plbmf-emit-cons", plbmf-emit-cons, PL-BMF-LIST), bmf-native("plbmf-emit-nil-list", plbmf-emit-nil-list, PL-BMF-LIST), bmf-native("plbmf-emit-unify", plbmf-emit-unify, PL-BMF-UNIFY), bmf-native("plbmf-emit-dcg2", plbmf-emit-dcg2, PL-BMF-DCG)];
}
section [prolog.bmf] {
      fact0 ::= $name:name "." => plbmf-emit-fact0 <= plbmf-source-fact0;
      fact1 ::= $name:name "(" $arg:name ")" "." => plbmf-emit-fact1 <= plbmf-source-fact1;
      fact2 ::= $name:name "(" $a:name "," $b:name ")" "." => plbmf-emit-fact2 <= plbmf-source-fact2;
      rule1 ::= $head:name "(" $hx:name ")" ":-" $goal:name "(" $gx:name ")" "." => plbmf-emit-rule1 <= plbmf-source-rule1;
      rule2 ::= $head:name "(" $hx:name "," $hz:name ")" ":-" $g1:name "(" $a1:name "," $a2:name ")" "," $g2:name "(" $b1:name "," $b2:name ")" "." => plbmf-emit-rule2 <= plbmf-source-rule2;
      rule-cut ::= $head:name ":-" $goal:name "," "!" "." => plbmf-emit-rule-cut <= plbmf-source-rule-cut;
      directive ::= ":-" $goal:name "." => plbmf-emit-directive <= plbmf-source-directive;
      directive-call1 ::= ":-" $goal:name "(" $arg:name ")" "." => plbmf-emit-directive-call1 <= plbmf-source-directive-call1;
      query2 ::= "?-" $goal:name "(" $a:name "," $b:name ")" "." => plbmf-emit-query2 <= plbmf-source-query2;
      is-add ::= $target:name "is" $a:name "+" $b:name => plbmf-emit-is-add <= plbmf-source-is-add;
      is-add-int ::= $target:name "is" $a:name "+" $value:int => plbmf-emit-is-add-int <= plbmf-source-is-add-int;
      cons ::= "[" $head:name "|" $tail:name "]" => plbmf-emit-cons <= plbmf-source-cons;
      nil-list ::= "[" "]" => plbmf-emit-nil-list <= plbmf-source-nil-list;
      unify ::= $x:name "=" $y:name => plbmf-emit-unify <= plbmf-source-unify;
      dcg2 ::= $head:name "-->" $b1:name "," $b2:name "." => plbmf-emit-dcg2 <= plbmf-source-dcg2;
    }

section [form.bml] {
    def prolog-bmf-rule-name(r) = r[0];
    def prolog-bmf-find-rule(rule-name, rules) = nil?(rules) ? empty() : (String) prolog-bmf-rule-name(rules[0]) == rule-name ? rules[0] : prolog-bmf-find-rule(rule-name, rules[1:]);
    def apply-prolog-bmf-rule(rule-name, object-stream) = apply-object-rule(prolog-bmf-find-rule(rule-name, prolog-bmf-rules), object-stream);
    let prolog-recipe-section = form-rule-recipe-section("prolog", [compiler-rule("prolog", "fact", "Prolog fact source objects", plbmf-emit-fact2), compiler-rule("prolog", "rule", "Prolog clause source objects", plbmf-emit-rule2), compiler-rule("prolog", "directive", "Prolog directive source objects", plbmf-emit-directive), compiler-rule("prolog", "query", "Prolog query source objects", plbmf-emit-query2), compiler-rule("prolog", "is", "Prolog arithmetic evaluation source objects", plbmf-emit-is-add), compiler-rule("prolog", "list", "Prolog list cell source objects", plbmf-emit-cons), compiler-rule("prolog", "cut", "Prolog committing clause source objects", plbmf-emit-rule-cut), compiler-rule("prolog", "unify", "Prolog unification source objects", plbmf-emit-unify), compiler-rule("prolog", "dcg", "Prolog DCG rule source objects", plbmf-emit-dcg2)]);
    let prolog-form-source = form-source("prolog", [prolog-bmf-second, prolog-recipe-section]);
    let prolog-bmf-dialect = bmf-dialect("prolog", form-section-object(prolog-bmf-second), prolog-bmf-native-section, prolog-bmf-rules);
    0;
}
