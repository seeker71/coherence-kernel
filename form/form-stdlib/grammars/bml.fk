// grammars/bml.fk - BML object compiler and runtime support
import form-stdlib/dialect-categories.fk
//
import form-stdlib/source-compiler.fk
//
import form-stdlib/compiler.fk
//
import form-stdlib/bml/source-scan.bml
//
import form-stdlib/hati-os-kernel.fk
//
import form-stdlib/fkc-table-serialize.fk
//
import form-stdlib/bml-native-interface-package-import.fk
//
import form-stdlib/bml-native-source-control.fk
//
import form-stdlib/form-control-backtracking-ml.fk
//
import form-stdlib/bml/bml-compiler-health.bml
//
import form-stdlib/organ-care.bml
section [form.bml] {
    //; --- source objects ---------------------------------------------
    def bml-src-keyword(value) = bmf-atom("bml-keyword", value);
    def bml-src-name(value) = bmf-atom("bml-name", value);
    def bml-src-op(value) = bmf-atom("bml-op", value);
    def bml-src-int(value) = bmf-atom("bml-int", value);
    def bml-src-float(value) = bmf-atom("bml-float", value);
    def bml-src-string(value) = bmf-atom("bml-string", value);
    def bml-src-char(value) = bmf-atom("bml-char", value);
    def bml-src-prop(value) = bmf-atom("bml-property", value);
    def bml-src-list(value) = bmf-atom("bml-list", value);
    def bml-src-code(value) = bmf-atom("bml-code", value);
    //; --- file source scanner ----------------------------------------
    //; This is the real file boundary for BML proof: bytes on disk become
    //; BML source objects before any BMF rule or lowering can run.
    def bml-source-keywords(_x) = ["package", "import", "class", "interface", "template", "section", "syntax", "const", "enum", "operator", "for", "while", "loop", "switch", "select", "case", "default", "if", "else", "if_fail", "while_success", "return", "break", "continue", "try", "catch", "throw", "fail", "cut", "mark", "save", "restore", "discard", "choice", "asm", "instanceof", "library", "naming", "conventions", "DefaultMethods", "Nil", "Fail", "EndOfFile", "EndOfLine", "Cut", "MultiMatch", "Primitive"];
    def bml-source-properties(_x) = ["public", "private", "protected", "abstract", "static", "final", "default", "delegate", "shared", "get", "put", "strict", "relaxed", "deferred", "native", "exception", "explicit", "extern", "library", "name", "guid", "operator", "coercion", "reassign", "array", "exclusive", "in", "out", "inout", "assign", "inline", "hidden", "singleton", "unique", "struct", "noobject", "dynamic", "alias", "outer", "nostate"];
    def bml-source-name-kind(value) = fsc-string-list-contains?(bml-source-keywords(0), value) ? "bml-keyword" : fsc-string-list-contains?(bml-source-properties(0), value) ? "bml-property" : "bml-name";
    def bml-source-scan-name-token(start) = {
        let read = fsc-source-scan-name-loop(start, start);
        let value = read[0];
        let end = read[1];
        fsc-scan-result(fsc-source-object(bml-source-name-kind(value), value, start, end), end);
    };
    def bml-source-hex-digit?(ch) = fsc-digit?(ch) || ((String) ch == "a" || ((String) ch == "A" || ((String) ch == "b" || ((String) ch == "B" || ((String) ch == "c" || ((String) ch == "C" || ((String) ch == "d" || ((String) ch == "D" || ((String) ch == "e" || ((String) ch == "E" || ((String) ch == "f" || (String) ch == "F")))))))))));
    def bml-source-bin-digit?(ch) = (String) ch == "0" || (String) ch == "1";
    def bml-source-exponent-marker?(ch) = (String) ch == "e" || (String) ch == "E";
    def bml-source-sign?(ch) = (String) ch == "+" || (String) ch == "-";
    def bml-source-scan-exponent-digits-loop(cursor) = fsc-source-cursor-end?(cursor) ? cursor : fsc-digit?(fsc-source-cursor-char(cursor)) ? bml-source-scan-exponent-digits-loop(fsc-source-cursor-advance(cursor)) : cursor;
    def bml-source-scan-exponent-if-present(cursor) = fsc-source-cursor-end?(cursor) ? cursor : bml-source-exponent-marker?(fsc-source-cursor-char(cursor)) ? {
        let after-marker = fsc-source-cursor-advance(cursor);
        let digit-start = !fsc-source-cursor-end?(after-marker) && bml-source-sign?(fsc-source-cursor-char(after-marker)) ? fsc-source-cursor-advance(after-marker) : after-marker;
        !fsc-source-cursor-end?(digit-start) && fsc-digit?(fsc-source-cursor-char(digit-start)) ? bml-source-scan-exponent-digits-loop(digit-start) : cursor;
    } : cursor;
    def bml-source-scan-fraction-loop(start-cursor, cursor) = fsc-source-cursor-end?(cursor) ? [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor] : {
        let ch = fsc-source-cursor-char(cursor);
        fsc-digit?(ch) ? bml-source-scan-fraction-loop(start-cursor, fsc-source-cursor-advance(cursor)) : [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor];
    };
    def bml-source-scan-decimal-or-float(start, int-kind) = {
        let read = fsc-source-scan-int-loop(start, start);
        let after-int = read[1];
        !fsc-source-cursor-end?(after-int) && (String) fsc-source-cursor-char(after-int) == "." ? {
            let after-dot = fsc-source-cursor-advance(after-int);
            !fsc-source-cursor-end?(after-dot) && fsc-digit?(fsc-source-cursor-char(after-dot)) ? {
                let frac = bml-source-scan-fraction-loop(start, after-dot);
                let end = bml-source-scan-exponent-if-present(frac[1]);
                fsc-scan-result(fsc-source-object("bml-float", fsc-source-cursor-slice(start, fsc-source-cursor-offset(start), fsc-source-cursor-offset(end)), start, end), end);
            } : fsc-scan-result(fsc-source-object(int-kind, read[0], start, after-int), after-int);
        } : fsc-scan-result(fsc-source-object(int-kind, read[0], start, after-int), after-int);
    };
    def bml-source-scan-hex-int-loop(start-cursor, cursor) = fsc-source-cursor-end?(cursor) ? [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor] : {
        let ch = fsc-source-cursor-char(cursor);
        bml-source-hex-digit?(ch) ? bml-source-scan-hex-int-loop(start-cursor, fsc-source-cursor-advance(cursor)) : [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor];
    };
    def bml-source-scan-bin-int-loop(start-cursor, cursor) = fsc-source-cursor-end?(cursor) ? [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor] : {
        let ch = fsc-source-cursor-char(cursor);
        bml-source-bin-digit?(ch) ? bml-source-scan-bin-int-loop(start-cursor, fsc-source-cursor-advance(cursor)) : [fsc-source-cursor-slice(start-cursor, fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(cursor)), cursor];
    };
    def bml-source-scan-prefixed-int(start, int-kind) = {
        let is-hex = fsc-source-cursor-prefix?(start, "0x") || fsc-source-cursor-prefix?(start, "0X");
        let is-bin = fsc-source-cursor-prefix?(start, "0b") || fsc-source-cursor-prefix?(start, "0B");
        is-hex ? {
            let read = bml-source-scan-hex-int-loop(start, fsc-source-advance-n(start, 2));
            fsc-scan-result(fsc-source-object(int-kind, read[0], start, read[1]), read[1]);
        } : is-bin ? {
            let read = bml-source-scan-bin-int-loop(start, fsc-source-advance-n(start, 2));
            fsc-scan-result(fsc-source-object(int-kind, read[0], start, read[1]), read[1]);
        } : bml-source-scan-decimal-or-float(start, int-kind);
    };
    def bml-source-escape-char(ch) = (String) ch == byte_to_str(92) ? byte_to_str(92) : (String) ch == "'" ? byte_to_str(39) : (String) ch == "\"" ? byte_to_str(34) : (String) ch == "n" ? byte_to_str(10) : (String) ch == "t" ? byte_to_str(9) : (String) ch == "r" ? byte_to_str(13) : (String) ch == "0" ? byte_to_str(0) : ch;
    def bml-source-scan-char-loop(cursor, acc) = fsc-source-cursor-end?(cursor) ? [acc, cursor] : {
        let ch = fsc-source-cursor-char(cursor);
        (String) ch == "'" ? [acc, fsc-source-cursor-advance(cursor)] : (String) ch == byte_to_str(92) && !fsc-source-cursor-end?(fsc-source-cursor-advance(cursor)) ? {
            let next-cursor = fsc-source-cursor-advance(cursor);
            let escaped = bml-source-escape-char(fsc-source-cursor-char(next-cursor));
            bml-source-scan-char-loop(fsc-source-cursor-advance(next-cursor), ((String) acc + escaped));
        } : bml-source-scan-char-loop(fsc-source-cursor-advance(cursor), ((String) acc + ch));
    };
    def bml-source-scan-char(start) = {
        let body-start = fsc-source-cursor-advance(start);
        let read = bml-source-scan-char-loop(body-start, "");
        let value = read[0];
        let end = read[1];
        fsc-scan-result(fsc-source-object("bml-char", value, start, end), end);
    };
    def bml-source-ops(_x) = ["<<prim", ".*", "::=", "=>", "<=", ">>>=", ">>=", "<<=", ">>>", ">>", "<<", "++", "--", "==", "!=", ">=", "<=", ":=", "*=", "/=", "%=", "+=", "-=", "&=", "|=", "^=", "&&", "||", "..", "#(", "{", "}", "(", ")", "[", "]", ";", ",", ":", ".", "+", "-", "*", "/", "%", "=", "'", "<", ">", "!", "~", "?", "|", "&", "^", "$"];
    def bml-source-dialect(_x) = fsc-source-dialect(bml-source-keywords(0), "bml-keyword", "bml-name", "bml-int", "bml-string", "bml-op", "bml-eof", bml-source-ops(0));
    def bml-source-lexicon(_x) = ["source-lexicon", bml-source-keywords(0), bml-source-properties(0), "bml-keyword", "bml-property", "bml-name", "bml-int", "bml-float", "bml-string", "bml-char", "bml-op", bml-source-ops(0), bml-line-comment-prefix(0), bml-block-comment-open(0), bml-block-comment-close(0)];
    def bml-line-comment-prefix(_x) = ("/" + "/");
    def bml-block-comment-open(_x) = ("/" + "*");
    def bml-block-comment-close(_x) = ("*" + "/");
    def bml-source-skip-line-comment(cursor) = fsc-source-cursor-end?(cursor) ? cursor : (String) fsc-source-cursor-char(cursor) == "\n" ? cursor : bml-source-skip-line-comment(fsc-source-cursor-advance(cursor));
    def bml-source-skip-block-comment(cursor) = fsc-source-cursor-end?(cursor) ? cursor : fsc-source-cursor-prefix?(cursor, bml-block-comment-close(0)) ? fsc-source-advance-n(cursor, 2) : bml-source-skip-block-comment(fsc-source-cursor-advance(cursor));
    def bml-source-scan-skip(cursor) = {
        let start = fsc-source-scan-skip(cursor);
        fsc-source-cursor-prefix?(start, bml-line-comment-prefix(0)) ? bml-source-scan-skip(bml-source-skip-line-comment(fsc-source-advance-n(start, 2))) : fsc-source-cursor-prefix?(start, bml-block-comment-open(0)) ? bml-source-scan-skip(bml-source-skip-block-comment(fsc-source-advance-n(start, 2))) : start;
    };
    def bml-source-scan-next(cursor) = {
        let start = bml-source-scan-skip(cursor);
        let ch = fsc-source-cursor-char(start);
        fsc-source-cursor-end?(start) ? fsc-scan-result(fsc-source-object("bml-eof", "", start, start), start) : (String) ch == "\"" ? fsc-source-scan-string(start, "bml-string") : (String) ch == "'" ? bml-source-scan-char(start) : fsc-digit?(ch) ? bml-source-scan-prefixed-int(start, "bml-int") : fsc-source-name-start-char?(ch) ? bml-source-scan-name-token(start) : fsc-source-scan-op(start, "bml-op", bml-source-ops(0));
    };
    def bml-source-scan-text-loop(cursor, acc) = {
        let result = bml-source-scan-next(cursor);
        let object = fsc-scan-result-object(result);
        (String) bmf-object-kind(object) == "bml-eof" ? reverse-list(acc) : bml-source-scan-text-loop(fsc-scan-result-cursor(result), cons(object, acc));
    };
    def bml-source-scan-text(source) = bml-source-scan-text-loop(fsc-source-cursor(source, 0, 1, 0), []);
    def bml-source-scan-file-form(path) = bml-source-scan-text-loop(fsc-file-source-cursor(path, 0, 1, 0, file_size(path)), []);
    def bml-source-scan-file(path) = source-scan-file(path, bml-source-lexicon(0));
    def bml-kw(value) = object-lit("bml-keyword", value);
    def bml-op(value) = object-lit("bml-op", value);
    def bml-ref(name) = object-lit("bml-ref", name);
    def bml-name(capture-name) = ["capture", capture-name, object-lit("bml-name", "")];
    def bml-int-lit(capture-name) = ["capture", capture-name, object-lit("bml-int", "")];
    def bml-float-lit(capture-name) = ["capture", capture-name, object-lit("bml-float", "")];
    def bml-string-lit(capture-name) = ["capture", capture-name, object-lit("bml-string", "")];
    def bml-char-lit(capture-name) = ["capture", capture-name, object-lit("bml-char", "")];
    def bml-prop(capture-name) = ["capture", capture-name, object-lit("bml-property", "")];
    //; --- AST helpers --------------------------------------------------
    def bml-cap-str(objects, capture-name) = intern_trivial_string(bmf-collection-value(objects, capture-name));
    def bml-int-hex-char-value(ch) = (String) ch == "0" ? 0 : (String) ch == "1" ? 1 : (String) ch == "2" ? 2 : (String) ch == "3" ? 3 : (String) ch == "4" ? 4 : (String) ch == "5" ? 5 : (String) ch == "6" ? 6 : (String) ch == "7" ? 7 : (String) ch == "8" ? 8 : (String) ch == "9" ? 9 : (String) ch == "a" ? 10 : (String) ch == "A" ? 10 : (String) ch == "b" ? 11 : (String) ch == "B" ? 11 : (String) ch == "c" ? 12 : (String) ch == "C" ? 12 : (String) ch == "d" ? 13 : (String) ch == "D" ? 13 : (String) ch == "e" ? 14 : (String) ch == "E" ? 14 : (String) ch == "f" ? 15 : (String) ch == "F" ? 15 : 0;
    def bml-int-parse-based-loop(value, index, end, base, acc) = index >= end ? acc : bml-int-parse-based-loop(value, (Number) index + (Number) 1, end, base, (Number) (acc * base) + (Number) bml-int-hex-char-value(substring(value, index, (Number) index + (Number) 1)));
    def bml-int-prefixed?(value, prefix) = len(value) < 2 ? false : (String) substring(value, 0, 2) == prefix;
    def bml-int-value(value) = bml-int-prefixed?(value, "0x") || bml-int-prefixed?(value, "0X") ? bml-int-parse-based-loop(value, 2, len(value), 16, 0) : bml-int-prefixed?(value, "0b") || bml-int-prefixed?(value, "0B") ? bml-int-parse-based-loop(value, 2, len(value), 2, 0) : str_to_int(value);
    def bml-cap-int(objects, capture-name) = intern_trivial_int(bml-int-value(bmf-collection-value(objects, capture-name)));
    def bml-cap-float(objects, capture-name) = intern_trivial_float(bmf-collection-value(objects, capture-name));
    def bml-ast-int(n) = intern_node(BML-AST-INT, [intern_trivial_int(n)]);
    def bml-ast-float-node(value) = intern_node(BML-AST-FLOAT, [value]);
    def bml-ast-string(s) = intern_node(BML-AST-STRING, [intern_trivial_string(s)]);
    def bml-ast-name(s) = intern_node(BML-AST-NAME, [intern_trivial_string(s)]);
    def bml-ast-add(left, right) = intern_node(BML-AST-ADD, [left, right]);
    def bml-ast-call(name, arg) = intern_node(BML-AST-CALL, [intern_trivial_string(name), arg]);
    def bml-ast-call-args(name, args) = bml-ast-call(name, bml-ast-array(args));
    def bml-ast-this-field(field-name) = bml-ast-call("__hati_field_get", bml-ast-string(field-name));
    def bml-ast-this-field-set(field-name, value) = bml-ast-call-args("__hati_field_set", [bml-ast-string(field-name), value]);
    def bml-ast-package(name) = intern_node(BML-AST-PACKAGE, [intern_trivial_string(name)]);
    def bml-ast-import(name, star) = intern_node(BML-AST-IMPORT, [intern_trivial_string(name), intern_trivial_string(star)]);
    def bml-ast-interface(name, parent, body) = intern_node(BML-AST-INTERFACE, [intern_trivial_string(name), intern_trivial_string(parent), body]);
    def bml-ast-return(expr) = intern_node(BML-AST-RETURN, [expr]);
    def bml-ast-block(items) = intern_node(BML-AST-BLOCK, items);
    def bml-ast-method(name, body) = intern_node(BML-AST-METHOD, [intern_trivial_string(name), body]);
    def bml-ast-method-parameter-name(parameters) = nil?(parameters) ? "" : bml-parameter-name(parameters[0]);
    //; A parameter keeps its declared type: it rides the method node as a
    //; BML-AST-FIELD (type, name), the shape a typed slot already has, so
    //; overload resolution can read what the source declared.
    def bml-ast-method-parameter-nodes(parameters) = nil?(parameters) ? [] : cons(bml-ast-field(bml-parameter-type(parameters[0]), bml-parameter-name(parameters[0])), bml-ast-method-parameter-nodes(parameters[1:]));
    def bml-ast-method-with-parameters(name, body, parameters) = intern_node(BML-AST-METHOD, append([intern_trivial_string(name), body], bml-ast-method-parameter-nodes(parameters)));
    //; A generic method carries its type parameters as one BML-AST-TEMPLATE
    //; child holding their names, between the body and the parameters.
    def bml-ast-generic-method(name, body, type-params, parameters) = intern_node(BML-AST-METHOD, append([intern_trivial_string(name), body, intern_node(BML-AST-TEMPLATE, bml-ast-name-nodes(type-params))], bml-ast-method-parameter-nodes(parameters)));
    //; A method's declared return type rides its node as one trailing
    //; BML-AST-STRING child; the parameter readers pass it by, and a call's
    //; static type reads it. An empty type adds nothing.
    def bml-ast-with-return(method, return-type) = (String) return-type == "" ? method : intern_node(BML-AST-METHOD, append(node_children(method), [bml-ast-string(return-type)]));
    //; a STRING composite, not a leaf that answers its own category
    def bml-method-return-child?(child) = node_eq(node_category(child), BML-AST-STRING) ? (Comparable) len(node_children(child)) == 1 : false;
    def bml-method-node-return-from(node, index) = index >= len(node_children(node)) ? "" : bml-method-return-child?(bml-node-child(node, index)) ? node_value(bml-node-child(bml-node-child(node, index), 0)) : bml-method-node-return-from(node, (Number) index + (Number) 1);
    def bml-method-node-return-type(node) = bml-method-node-return-from(node, 2);
    def bml-ast-name-nodes(names) = nil?(names) ? [] : cons(bml-ast-name(names[0]), bml-ast-name-nodes(names[1:]));
    def bml-ast-class(name, base, sections) = intern_node(BML-AST-CLASS, [intern_trivial_string(name), intern_trivial_string(base), sections]);
    def bml-ast-section(properties, body) = intern_node(BML-AST-SECTION, [properties, body]);
    def bml-ast-field(field-type, name) = intern_node(BML-AST-FIELD, [intern_trivial_string(field-type), intern_trivial_string(name)]);
    def bml-ast-const(const-type, name, value) = intern_node(BML-AST-CONST, [intern_trivial_string(const-type), intern_trivial_string(name), value]);
    def bml-ast-choose(branches) = intern_node(BML-AST-CHOOSE, branches);
    def bml-ast-fail(_x) = intern_node(BML-AST-FAIL, []);
    def bml-ast-cut(_x) = intern_node(BML-AST-CUT, []);
    def bml-ast-save(_x) = intern_node(BML-AST-SAVE, []);
    def bml-ast-restore(_x) = intern_node(BML-AST-RESTORE, []);
    def bml-ast-discard(_x) = intern_node(BML-AST-DISCARD, []);
    def bml-ast-break(label) = intern_node(BML-AST-BREAK, [intern_trivial_string(label)]);
    def bml-ast-continue(label) = intern_node(BML-AST-CONTINUE, [intern_trivial_string(label)]);
    def bml-ast-throw(expr) = intern_node(BML-AST-THROW, [expr]);
    def bml-ast-try(body, handler) = intern_node(BML-AST-TRY, [body, handler]);
    def bml-ast-char(value) = intern_node(BML-AST-CHAR, [intern_trivial_string(value)]);
    def bml-ast-array(items) = intern_node(BML-AST-ARRAY, items);
    def bml-ast-while-success(body) = intern_node(BML-AST-WHILE, [body]);
    //; --- BML compiler component objects -----------------------------
    //; BML support is a compiler band above the kernel. Source sections
    //; reduce into reversible BMF object cells whose values are these
    //; generic BML component objects. Later runtime passes can lower the
    //; component values onward, or into a denser authoring dialect.
    def comp-bml-component(kind, fields) = ["comp-bml-component", kind, fields];
    def comp-bml-kind(component) = component[1];
    def comp-bml-fields(component) = component[2];
    def bml-component-kind?(component, kind) = (String) comp-bml-kind(component) == kind;
    def bml-model(classes, interfaces) = ["bml-model", classes, interfaces];
    def bml-model-classes(model) = model[1];
    def bml-model-interfaces(model) = model[2];
    def bml-interface-ref-component(name) = comp-bml-component("InterfaceRef", [name]);
    def bml-components-of-kind(items, kind) = nil?(items) ? [] : {
        let item = items[0];
        let rest = bml-components-of-kind(items[1:], kind);
        bml-component-kind?(item, kind) ? cons(item, rest) : rest;
    };
    def bml-class-name(class-component) = comp-bml-fields(class-component)[0];
    def bml-class-properties(class-component) = comp-bml-fields(class-component)[1];
    def bml-class-supers(class-component) = comp-bml-fields(class-component)[2];
    def bml-class-body(class-component) = comp-bml-fields(class-component)[3];
    def bml-class-structural-base-name(class-component) = nil?(bml-class-supers(class-component)) ? "" : bml-class-supers(class-component)[0];
    def bml-class-delegation-base-names(class-component) = nil?(bml-class-supers(class-component)) ? [] : bml-class-supers(class-component)[1:];
    def bml-interface-name(interface-component) = comp-bml-fields(interface-component)[0];
    def bml-interface-properties(interface-component) = comp-bml-fields(interface-component)[1];
    def bml-interface-parent-name(interface-component) = comp-bml-fields(interface-component)[2];
    def bml-interface-body(interface-component) = comp-bml-fields(interface-component)[3];
    def bml-section-body(section-component) = comp-bml-fields(section-component)[2];
    def bml-field-type(field-component) = comp-bml-fields(field-component)[0];
    def bml-field-name(field-component) = comp-bml-fields(field-component)[1];
    def bml-method-return(method-component) = comp-bml-fields(method-component)[0];
    def bml-method-name(method-component) = comp-bml-fields(method-component)[1];
