; grammars/bml.fk - BML object compiler and runtime support
; preludes: form-stdlib/dialect-categories.fk form-stdlib/source-compiler.fk form-stdlib/compiler.fk form-stdlib/bml/source-scan.bml form-stdlib/hati-os-kernel.fk form-stdlib/fkc-table-serialize.fk form-stdlib/bml-native-interface-package-import.fk form-stdlib/bml-native-source-control.fk form-stdlib/form-control-backtracking-ml.fk form-stdlib/bml/bml-compiler-health.bml form-stdlib/organ-care.bml
;
; Reference shape: the 2000 BML/JBML compiler lowers BMF matches into
; component objects, then into an instruction stream for a backtracking VM.
; This file keeps that shape in Form data so Python, Go, Rust, TypeScript,
; and future languages can reuse the same compiler bands.

; Per-dialect BML-AST-* category constants are declared as data in
; form-stdlib/form-ontology.json and emitted into
; form-stdlib/dialect-categories.fk by form-stdlib/bml/ontology-emit.bml. This
; file references them as free identifiers; load dialect-categories.fk as
; a prelude before this file.

(do
    ;; --- source objects ---------------------------------------------

    (defn bml-src-keyword (value) (bmf-atom "bml-keyword" value))
    (defn bml-src-name (value) (bmf-atom "bml-name" value))
    (defn bml-src-op (value) (bmf-atom "bml-op" value))
    (defn bml-src-int (value) (bmf-atom "bml-int" value))
    (defn bml-src-float (value) (bmf-atom "bml-float" value))
    (defn bml-src-string (value) (bmf-atom "bml-string" value))
    (defn bml-src-char (value) (bmf-atom "bml-char" value))
    (defn bml-src-prop (value) (bmf-atom "bml-property" value))
    (defn bml-src-list (value) (bmf-atom "bml-list" value))
    (defn bml-src-code (value) (bmf-atom "bml-code" value))

    ;; --- file source scanner ----------------------------------------
    ;; This is the real file boundary for BML proof: bytes on disk become
    ;; BML source objects before any BMF rule or BMA lowering can run.

    (defn bml-source-keywords (_x)
        (list "package" "import" "class" "interface" "template" "section"
              "syntax" "const" "enum" "operator" "for" "while" "loop"
              "switch" "select" "case" "default" "if" "else" "if_fail"
              "while_success" "return" "break" "continue" "try" "catch"
              "throw" "fail" "cut" "mark" "save" "restore" "discard"
              "choice" "choose" "asm" "instanceof" "library" "naming"
              "conventions" "DefaultMethods" "Nil" "Fail" "EndOfFile"
              "EndOfLine" "Cut" "MultiMatch" "Primitive"))

    (defn bml-source-properties (_x)
        (list "public" "private" "protected" "abstract" "static" "final"
              "default" "delegate" "shared" "get" "put" "strict" "relaxed"
              "deferred" "native" "exception" "explicit" "extern" "library"
              "name" "guid" "operator" "coercion" "reassign" "array"
              "exclusive" "in" "out" "inout" "assign" "inline" "hidden"
              "singleton" "unique" "struct" "noobject" "dynamic" "alias"
              "outer" "nostate"))

    (defn bml-source-name-kind (value)
        (if (fsc-string-list-contains? (bml-source-keywords 0) value)
            "bml-keyword"
            (if (fsc-string-list-contains? (bml-source-properties 0) value)
                "bml-property"
                "bml-name")))

    (defn bml-source-scan-name-token (start)
        (do
            (let read (fsc-source-scan-name-loop start start))
            (let value (nth read 0))
            (let end (nth read 1))
            (fsc-scan-result
                (fsc-source-object
                    (bml-source-name-kind value)
                    value
                    start
                    end)
                end)))

    (defn bml-source-hex-digit? (ch)
        (or (fsc-digit? ch)
            (or (str_eq ch "a")
            (or (str_eq ch "A")
            (or (str_eq ch "b")
            (or (str_eq ch "B")
            (or (str_eq ch "c")
            (or (str_eq ch "C")
            (or (str_eq ch "d")
            (or (str_eq ch "D")
            (or (str_eq ch "e")
            (or (str_eq ch "E")
            (or (str_eq ch "f")
                (str_eq ch "F"))))))))))))))

    (defn bml-source-bin-digit? (ch)
        (or (str_eq ch "0") (str_eq ch "1")))

    (defn bml-source-exponent-marker? (ch)
        (or (str_eq ch "e") (str_eq ch "E")))

    (defn bml-source-sign? (ch)
        (or (str_eq ch "+") (str_eq ch "-")))

    (defn bml-source-scan-exponent-digits-loop (cursor)
        (if (fsc-source-cursor-end? cursor) cursor
            (if (fsc-digit? (fsc-source-cursor-char cursor))
                (bml-source-scan-exponent-digits-loop
                    (fsc-source-cursor-advance cursor))
                cursor)))

    (defn bml-source-scan-exponent-if-present (cursor)
        (if (fsc-source-cursor-end? cursor) cursor
            (if (bml-source-exponent-marker? (fsc-source-cursor-char cursor))
                (do
                    (let after-marker (fsc-source-cursor-advance cursor))
                    (let digit-start
                        (if (and (not (fsc-source-cursor-end? after-marker))
                                 (bml-source-sign?
                                    (fsc-source-cursor-char after-marker)))
                            (fsc-source-cursor-advance after-marker)
                            after-marker))
                    (if (and (not (fsc-source-cursor-end? digit-start))
                             (fsc-digit? (fsc-source-cursor-char digit-start)))
                        (bml-source-scan-exponent-digits-loop digit-start)
                        cursor))
                cursor)))

    (defn bml-source-scan-fraction-loop (start-cursor cursor)
        (if (fsc-source-cursor-end? cursor)
            (list (fsc-source-cursor-slice
                       start-cursor
                       (fsc-source-cursor-offset start-cursor)
                       (fsc-source-cursor-offset cursor))
                  cursor)
            (do
                (let ch (fsc-source-cursor-char cursor))
                (if (fsc-digit? ch)
                    (bml-source-scan-fraction-loop
                        start-cursor
                        (fsc-source-cursor-advance cursor))
                    (list (fsc-source-cursor-slice
                               start-cursor
                               (fsc-source-cursor-offset start-cursor)
                               (fsc-source-cursor-offset cursor))
                          cursor)))))

    (defn bml-source-scan-decimal-or-float (start int-kind)
        (do
            (let read (fsc-source-scan-int-loop start start))
            (let after-int (nth read 1))
            (if (and (not (fsc-source-cursor-end? after-int))
                     (str_eq (fsc-source-cursor-char after-int) "."))
                (do
                    (let after-dot (fsc-source-cursor-advance after-int))
                    (if (and (not (fsc-source-cursor-end? after-dot))
                             (fsc-digit? (fsc-source-cursor-char after-dot)))
                        (do
                            (let frac
                                (bml-source-scan-fraction-loop
                                    start
                                    after-dot))
                            (let end
                                (bml-source-scan-exponent-if-present
                                    (nth frac 1)))
                            (fsc-scan-result
                                (fsc-source-object
                                    "bml-float"
                                    (fsc-source-cursor-slice
                                        start
                                        (fsc-source-cursor-offset start)
                                        (fsc-source-cursor-offset end))
                                    start
                                    end)
                                end))
                        (fsc-scan-result
                            (fsc-source-object int-kind (nth read 0) start after-int)
                            after-int)))
                (fsc-scan-result
                    (fsc-source-object int-kind (nth read 0) start after-int)
                    after-int))))

    (defn bml-source-scan-hex-int-loop (start-cursor cursor)
        (if (fsc-source-cursor-end? cursor)
            (list (fsc-source-cursor-slice
                       start-cursor
                       (fsc-source-cursor-offset start-cursor)
                       (fsc-source-cursor-offset cursor))
                  cursor)
            (do
                (let ch (fsc-source-cursor-char cursor))
                (if (bml-source-hex-digit? ch)
                    (bml-source-scan-hex-int-loop
                        start-cursor
                        (fsc-source-cursor-advance cursor))
                    (list (fsc-source-cursor-slice
                               start-cursor
                               (fsc-source-cursor-offset start-cursor)
                               (fsc-source-cursor-offset cursor))
                          cursor)))))

    (defn bml-source-scan-bin-int-loop (start-cursor cursor)
        (if (fsc-source-cursor-end? cursor)
            (list (fsc-source-cursor-slice
                       start-cursor
                       (fsc-source-cursor-offset start-cursor)
                       (fsc-source-cursor-offset cursor))
                  cursor)
            (do
                (let ch (fsc-source-cursor-char cursor))
                (if (bml-source-bin-digit? ch)
                    (bml-source-scan-bin-int-loop
                        start-cursor
                        (fsc-source-cursor-advance cursor))
                    (list (fsc-source-cursor-slice
                               start-cursor
                               (fsc-source-cursor-offset start-cursor)
                               (fsc-source-cursor-offset cursor))
                          cursor)))))

    (defn bml-source-scan-prefixed-int (start int-kind)
        (do
            (let is-hex
                (or (fsc-source-cursor-prefix? start "0x")
                    (fsc-source-cursor-prefix? start "0X")))
            (let is-bin
                (or (fsc-source-cursor-prefix? start "0b")
                    (fsc-source-cursor-prefix? start "0B")))
            (if is-hex
                (do
                    (let read
                        (bml-source-scan-hex-int-loop
                            start
                            (fsc-source-advance-n start 2)))
                    (fsc-scan-result
                        (fsc-source-object int-kind (nth read 0) start (nth read 1))
                        (nth read 1)))
            (if is-bin
                (do
                    (let read
                        (bml-source-scan-bin-int-loop
                            start
                            (fsc-source-advance-n start 2)))
                    (fsc-scan-result
                        (fsc-source-object int-kind (nth read 0) start (nth read 1))
                        (nth read 1)))
                (bml-source-scan-decimal-or-float start int-kind)))))

    (defn bml-source-escape-char (ch)
        (if (str_eq ch (byte_to_str 92)) (byte_to_str 92)
        (if (str_eq ch "'") (byte_to_str 39)
        (if (str_eq ch "\"") (byte_to_str 34)
        (if (str_eq ch "n") (byte_to_str 10)
        (if (str_eq ch "t") (byte_to_str 9)
        (if (str_eq ch "r") (byte_to_str 13)
        (if (str_eq ch "0") (byte_to_str 0)
            ch))))))))

    (defn bml-source-scan-char-loop (cursor acc)
        (if (fsc-source-cursor-end? cursor)
            (list acc cursor)
            (do
                (let ch (fsc-source-cursor-char cursor))
                (if (str_eq ch "'")
                    (list acc (fsc-source-cursor-advance cursor))
                (if (and (str_eq ch (byte_to_str 92))
                         (not (fsc-source-cursor-end?
                                (fsc-source-cursor-advance cursor))))
                    (do
                        (let next-cursor (fsc-source-cursor-advance cursor))
                        (let escaped (bml-source-escape-char
                                        (fsc-source-cursor-char next-cursor)))
                        (bml-source-scan-char-loop
                            (fsc-source-cursor-advance next-cursor)
                            (str_concat acc escaped)))
                    (bml-source-scan-char-loop
                        (fsc-source-cursor-advance cursor)
                        (str_concat acc ch)))))))

    (defn bml-source-scan-char (start)
        (do
            (let body-start (fsc-source-cursor-advance start))
            (let read (bml-source-scan-char-loop body-start ""))
            (let value (nth read 0))
            (let end (nth read 1))
            (fsc-scan-result
                (fsc-source-object "bml-char" value start end)
                end)))

    (defn bml-source-ops (_x)
        (list "<<prim" ".*" "::=" "=>" "<=" ">>>=" ">>=" "<<=" ">>>"
              ">>" "<<" "++" "--" "==" "!=" ">=" "<=" ":=" "*=" "/="
              "%=" "+=" "-=" "&=" "|=" "^=" "&&" "||" ".." "#("
              "{" "}" "(" ")" "[" "]" ";" "," ":" "." "+" "-" "*" "/"
              "%" "=" "'" "<" ">" "!" "~" "?" "|" "&" "^" "$"))

    (defn bml-source-dialect (_x)
        (fsc-source-dialect
            (bml-source-keywords 0)
            "bml-keyword"
            "bml-name"
            "bml-int"
            "bml-string"
            "bml-op"
            "bml-eof"
            (bml-source-ops 0)))

    (defn bml-source-lexicon (_x)
        (list "source-lexicon"
              (bml-source-keywords 0)
              (bml-source-properties 0)
              "bml-keyword"
              "bml-property"
              "bml-name"
              "bml-int"
              "bml-float"
              "bml-string"
              "bml-char"
              "bml-op"
              (bml-source-ops 0)
              (bml-line-comment-prefix 0)
              (bml-block-comment-open 0)
              (bml-block-comment-close 0)))

    (defn bml-line-comment-prefix (_x) (str_concat "/" "/"))
    (defn bml-block-comment-open (_x) (str_concat "/" "*"))
    (defn bml-block-comment-close (_x) (str_concat "*" "/"))

    (defn bml-source-skip-line-comment (cursor)
        (if (fsc-source-cursor-end? cursor) cursor
            (if (str_eq (fsc-source-cursor-char cursor) "\n") cursor
                (bml-source-skip-line-comment
                    (fsc-source-cursor-advance cursor)))))

    (defn bml-source-skip-block-comment (cursor)
        (if (fsc-source-cursor-end? cursor) cursor
            (if (fsc-source-cursor-prefix? cursor (bml-block-comment-close 0))
                (fsc-source-advance-n cursor 2)
                (bml-source-skip-block-comment
                    (fsc-source-cursor-advance cursor)))))

    (defn bml-source-scan-skip (cursor)
        (do
            (let start (fsc-source-scan-skip cursor))
            (if (fsc-source-cursor-prefix? start (bml-line-comment-prefix 0))
                (bml-source-scan-skip
                    (bml-source-skip-line-comment
                        (fsc-source-advance-n start 2)))
            (if (fsc-source-cursor-prefix? start (bml-block-comment-open 0))
                (bml-source-scan-skip
                    (bml-source-skip-block-comment
                        (fsc-source-advance-n start 2)))
                start))))

    (defn bml-source-scan-next (cursor)
        (do
            (let start (bml-source-scan-skip cursor))
            (let ch (fsc-source-cursor-char start))
            (if (fsc-source-cursor-end? start)
                (fsc-scan-result
                    (fsc-source-object "bml-eof" "" start start)
                    start)
            (if (str_eq ch "\"")
                (fsc-source-scan-string start "bml-string")
            (if (str_eq ch "'")
                (bml-source-scan-char start)
            (if (fsc-digit? ch)
                (bml-source-scan-prefixed-int start "bml-int")
            (if (fsc-source-name-start-char? ch)
                (bml-source-scan-name-token start)
                (fsc-source-scan-op
                    start
                    "bml-op"
                    (bml-source-ops 0)))))))))

    (defn bml-source-scan-text-loop (cursor acc)
        (do
            (let result (bml-source-scan-next cursor))
            (let object (fsc-scan-result-object result))
            (if (str_eq (bmf-object-kind object) "bml-eof")
                (reverse-list acc)
                (bml-source-scan-text-loop
                    (fsc-scan-result-cursor result)
                    (cons object acc)))))

    (defn bml-source-scan-text (source)
        (bml-source-scan-text-loop
            (fsc-source-cursor source 0 1 0)
            (empty)))

    (defn bml-source-scan-file-form (path)
        (bml-source-scan-text-loop
            (fsc-file-source-cursor path 0 1 0 (file_size path))
            (empty)))

    (defn bml-source-scan-file (path)
        (source-scan-file path (bml-source-lexicon 0)))

    (defn bml-kw (value) (object-lit "bml-keyword" value))
    (defn bml-op (value) (object-lit "bml-op" value))
    (defn bml-ref (name) (object-lit "bml-ref" name))
    (defn bml-name (capture-name) (list "capture" capture-name (object-lit "bml-name" "")))
    (defn bml-int-lit (capture-name) (list "capture" capture-name (object-lit "bml-int" "")))
    (defn bml-float-lit (capture-name) (list "capture" capture-name (object-lit "bml-float" "")))
    (defn bml-string-lit (capture-name) (list "capture" capture-name (object-lit "bml-string" "")))
    (defn bml-char-lit (capture-name) (list "capture" capture-name (object-lit "bml-char" "")))
    (defn bml-prop (capture-name) (list "capture" capture-name (object-lit "bml-property" "")))

    ;; --- AST helpers --------------------------------------------------

    (defn bml-cap-str (objects capture-name)
        (intern_trivial_string (bmf-collection-value objects capture-name)))

    (defn bml-int-hex-char-value (ch)
        (if (str_eq ch "0") 0
        (if (str_eq ch "1") 1
        (if (str_eq ch "2") 2
        (if (str_eq ch "3") 3
        (if (str_eq ch "4") 4
        (if (str_eq ch "5") 5
        (if (str_eq ch "6") 6
        (if (str_eq ch "7") 7
        (if (str_eq ch "8") 8
        (if (str_eq ch "9") 9
        (if (str_eq ch "a") 10
        (if (str_eq ch "A") 10
        (if (str_eq ch "b") 11
        (if (str_eq ch "B") 11
        (if (str_eq ch "c") 12
        (if (str_eq ch "C") 12
        (if (str_eq ch "d") 13
        (if (str_eq ch "D") 13
        (if (str_eq ch "e") 14
        (if (str_eq ch "E") 14
        (if (str_eq ch "f") 15
        (if (str_eq ch "F") 15 0)))))))))))))))))))))))

    (defn bml-int-parse-based-loop (value index end base acc)
        (if (ge index end) acc
            (bml-int-parse-based-loop
                value
                (add index 1)
                end
                base
                (add (mul acc base)
                     (bml-int-hex-char-value
                        (substring value index (add index 1)))))))

    (defn bml-int-prefixed? (value prefix)
        (if (lt (str_len value) 2) false
            (str_eq (substring value 0 2) prefix)))

    (defn bml-int-value (value)
        (if (or (bml-int-prefixed? value "0x")
                (bml-int-prefixed? value "0X"))
            (bml-int-parse-based-loop value 2 (str_len value) 16 0)
        (if (or (bml-int-prefixed? value "0b")
                (bml-int-prefixed? value "0B"))
            (bml-int-parse-based-loop value 2 (str_len value) 2 0)
            (str_to_int value))))

    (defn bml-cap-int (objects capture-name)
        (intern_trivial_int (bml-int-value (bmf-collection-value objects capture-name))))

    (defn bml-cap-float (objects capture-name)
        (intern_trivial_float (bmf-collection-value objects capture-name)))

    (defn bml-ast-int (n)
        (intern_node BML-AST-INT (list (intern_trivial_int n))))

    (defn bml-ast-float-node (value)
        (intern_node BML-AST-FLOAT (list value)))

    (defn bml-ast-string (s)
        (intern_node BML-AST-STRING (list (intern_trivial_string s))))

    (defn bml-ast-name (s)
        (intern_node BML-AST-NAME (list (intern_trivial_string s))))

    (defn bml-ast-add (left right)
        (intern_node BML-AST-ADD (list left right)))

    (defn bml-ast-call (name arg)
        (intern_node BML-AST-CALL
                     (list (intern_trivial_string name) arg)))

    (defn bml-ast-call-args (name args)
        (bml-ast-call name (bml-ast-array args)))

    (defn bml-ast-this-field (field-name)
        (bml-ast-call "__hati_field_get" (bml-ast-string field-name)))

    (defn bml-ast-this-field-set (field-name value)
        (bml-ast-call-args
            "__hati_field_set"
            (list (bml-ast-string field-name) value)))

    (defn bml-ast-package (name)
        (intern_node BML-AST-PACKAGE (list (intern_trivial_string name))))

    (defn bml-ast-import (name star)
        (intern_node BML-AST-IMPORT
                     (list (intern_trivial_string name)
                           (intern_trivial_string star))))

    (defn bml-ast-interface (name parent body)
        (intern_node BML-AST-INTERFACE
                     (list (intern_trivial_string name)
                           (intern_trivial_string parent)
                           body)))

    (defn bml-ast-return (expr)
        (intern_node BML-AST-RETURN (list expr)))

    (defn bml-ast-block (items)
        (intern_node BML-AST-BLOCK items))

    (defn bml-ast-method (name body)
        (intern_node BML-AST-METHOD (list (intern_trivial_string name) body)))

    (defn bml-ast-method-parameter-name (parameters)
        (if (nil? parameters) "" (bml-parameter-name (head parameters))))

    ;; A parameter keeps its declared type: it rides the method node as a
    ;; BML-AST-FIELD (type, name), the shape a typed slot already has, so
    ;; overload resolution can read what the source declared.
    (defn bml-ast-method-parameter-nodes (parameters)
        (if (nil? parameters)
            (empty)
            (cons
                (bml-ast-field
                    (bml-parameter-type (head parameters))
                    (bml-parameter-name (head parameters)))
                (bml-ast-method-parameter-nodes (tail parameters)))))

    (defn bml-ast-method-with-parameters (name body parameters)
        (intern_node BML-AST-METHOD
                     (append
                        (list
                            (intern_trivial_string name)
                            body)
                        (bml-ast-method-parameter-nodes parameters))))

    ;; A generic method carries its type parameters as one BML-AST-TEMPLATE
    ;; child holding their names, between the body and the parameters.
    (defn bml-ast-generic-method (name body type-params parameters)
        (intern_node BML-AST-METHOD
                     (append
                        (list
                            (intern_trivial_string name)
                            body
                            (intern_node BML-AST-TEMPLATE
                                         (bml-ast-name-nodes type-params)))
                        (bml-ast-method-parameter-nodes parameters))))

    (defn bml-ast-name-nodes (names)
        (if (nil? names)
            (empty)
            (cons (bml-ast-name (head names)) (bml-ast-name-nodes (tail names)))))

    (defn bml-ast-class (name base sections)
        (intern_node BML-AST-CLASS
                     (list (intern_trivial_string name)
                           (intern_trivial_string base)
                           sections)))

    (defn bml-ast-section (properties body)
        (intern_node BML-AST-SECTION (list properties body)))

    (defn bml-ast-field (field-type name)
        (intern_node BML-AST-FIELD
                     (list (intern_trivial_string field-type)
                           (intern_trivial_string name))))

    (defn bml-ast-const (const-type name value)
        (intern_node BML-AST-CONST
                     (list (intern_trivial_string const-type)
                           (intern_trivial_string name)
                           value)))

    (defn bml-ast-choose (branches)
        (intern_node BML-AST-CHOOSE branches))

    (defn bml-ast-fail (_x) (intern_node BML-AST-FAIL (empty)))
    (defn bml-ast-cut (_x) (intern_node BML-AST-CUT (empty)))
    (defn bml-ast-save (_x) (intern_node BML-AST-SAVE (empty)))
    (defn bml-ast-restore (_x) (intern_node BML-AST-RESTORE (empty)))
    (defn bml-ast-discard (_x) (intern_node BML-AST-DISCARD (empty)))
    (defn bml-ast-break (label)
        (intern_node BML-AST-BREAK (list (intern_trivial_string label))))
    (defn bml-ast-continue (label)
        (intern_node BML-AST-CONTINUE (list (intern_trivial_string label))))
    (defn bml-ast-throw (expr)
        (intern_node BML-AST-THROW (list expr)))
    (defn bml-ast-try (body handler)
        (intern_node BML-AST-TRY (list body handler)))
    (defn bml-ast-char (value)
        (intern_node BML-AST-CHAR (list (intern_trivial_string value))))
    (defn bml-ast-array (items)
        (intern_node BML-AST-ARRAY items))
    (defn bml-ast-while-success (body)
        (intern_node BML-AST-WHILE (list body)))

    ;; --- BML compiler component objects -----------------------------
    ;; BML support is a compiler band above the kernel. Source sections
    ;; reduce into reversible BMF object cells whose values are these
    ;; generic BML component objects. Later runtime passes can lower the
    ;; component values into BMA ops or into a denser authoring dialect.

    (defn comp-bml-component (kind fields)
        (list "comp-bml-component" kind fields))

    (defn comp-bml-kind (component)
        (nth component 1))

    (defn comp-bml-fields (component)
        (nth component 2))

    (defn bml-component-kind? (component kind)
        (str_eq (comp-bml-kind component) kind))

    (defn bml-model (classes interfaces)
        (list "bml-model" classes interfaces))

    (defn bml-model-classes (model) (nth model 1))
    (defn bml-model-interfaces (model) (nth model 2))

    (defn bml-interface-ref-component (name)
        (comp-bml-component "InterfaceRef" (list name)))

    (defn bml-components-of-kind (items kind)
        (if (nil? items) (empty)
            (do
                (let item (head items))
                (let rest (bml-components-of-kind (tail items) kind))
                (if (bml-component-kind? item kind)
                    (cons item rest)
                    rest))))

    (defn bml-class-name (class-component)
        (nth (comp-bml-fields class-component) 0))

    (defn bml-class-properties (class-component)
        (nth (comp-bml-fields class-component) 1))

    (defn bml-class-supers (class-component)
        (nth (comp-bml-fields class-component) 2))

    (defn bml-class-body (class-component)
        (nth (comp-bml-fields class-component) 3))

    (defn bml-class-structural-base-name (class-component)
        (if (nil? (bml-class-supers class-component)) ""
            (head (bml-class-supers class-component))))

    (defn bml-class-delegation-base-names (class-component)
        (if (nil? (bml-class-supers class-component)) (empty)
            (tail (bml-class-supers class-component))))

    (defn bml-interface-name (interface-component)
        (nth (comp-bml-fields interface-component) 0))

    (defn bml-interface-properties (interface-component)
        (nth (comp-bml-fields interface-component) 1))

    (defn bml-interface-parent-name (interface-component)
        (nth (comp-bml-fields interface-component) 2))

    (defn bml-interface-body (interface-component)
        (nth (comp-bml-fields interface-component) 3))

    (defn bml-section-body (section-component)
        (nth (comp-bml-fields section-component) 2))

    (defn bml-field-type (field-component)
        (nth (comp-bml-fields field-component) 0))

    (defn bml-field-name (field-component)
        (nth (comp-bml-fields field-component) 1))

    (defn bml-method-return (method-component)
        (nth (comp-bml-fields method-component) 0))

    (defn bml-method-name (method-component)
        (nth (comp-bml-fields method-component) 1))

    (defn bml-method-body (method-component)
        (nth (comp-bml-fields method-component) 3))

    (defn bml-method-parameters (method-component)
        (if (gt (len (comp-bml-fields method-component)) 4)
            (nth (comp-bml-fields method-component) 4)
            (empty)))

    (defn bml-parameter-type (parameter-component)
        (nth (comp-bml-fields parameter-component) 0))

    (defn bml-parameter-name (parameter-component)
        (nth (comp-bml-fields parameter-component) 1))

    (defn bml-interface-ref-name (interface-ref)
        (head (comp-bml-fields interface-ref)))

    (defn bml-include-path (include-component)
        (head (comp-bml-fields include-component)))

    (defn bml-property-component (name value)
        (comp-bml-component "Property" (list name value)))

    (defn bml-property-name (property)
        (nth (comp-bml-fields property) 0))

    (defn bml-property-value (property)
        (nth (comp-bml-fields property) 1))

    (defn bml-properties-find (properties name)
        (if (nil? properties) (empty)
            (if (str_eq (bml-property-name (head properties)) name)
                (head properties)
                (bml-properties-find (tail properties) name))))

    (defn bml-properties-has? (properties name)
        (if (nil? (bml-properties-find properties name)) false true))

    (defn bml-properties-value (properties name default-value)
        (do
            (let property (bml-properties-find properties name))
            (if (nil? property) default-value
                (bml-property-value property))))

    (defn bml-access-level (properties)
        (if (bml-properties-has? properties "private") "private"
            (if (bml-properties-has? properties "protected") "protected"
                (if (bml-properties-has? properties "public") "public"
                    (bml-properties-value properties "access" "public")))))

    (defn bml-section-name (section-component)
        (nth (comp-bml-fields section-component) 0))

    (defn bml-section-properties (section-component)
        (nth (comp-bml-fields section-component) 1))

    (defn bml-field-properties (field-component)
        (nth (comp-bml-fields field-component) 2))

    (defn bml-field-init (field-component)
        (if (gt (len (comp-bml-fields field-component)) 3)
            (nth (comp-bml-fields field-component) 3)
            (empty)))

    (defn bml-const-type (const-component)
        (nth (comp-bml-fields const-component) 0))

    (defn bml-const-name (const-component)
        (nth (comp-bml-fields const-component) 1))

    (defn bml-const-properties (const-component)
        (nth (comp-bml-fields const-component) 2))

    (defn bml-const-value (const-component)
        (nth (comp-bml-fields const-component) 3))

    (defn bml-method-properties (method-component)
        (nth (comp-bml-fields method-component) 2))

    (defn bml-constructor-name (constructor-component)
        (nth (comp-bml-fields constructor-component) 0))

    (defn bml-constructor-properties (constructor-component)
        (nth (comp-bml-fields constructor-component) 1))

    (defn bml-constructor-body (constructor-component)
        (nth (comp-bml-fields constructor-component) 2))

    (defn bml-constructor-parameters (constructor-component)
        (if (gt (len (comp-bml-fields constructor-component)) 3)
            (nth (comp-bml-fields constructor-component) 3)
            (empty)))

    (defn bml-token-cursor-with-rest (tokens index rest)
        (list "bml-token-cursor" tokens index rest))

    (defn bml-token-cursor (tokens index)
        (bml-token-cursor-with-rest tokens index (drop index tokens)))

    (defn bml-token-cursor? (cursor)
        (if (nil? cursor) false
            (str_eq (head cursor) "bml-token-cursor")))

    (defn bml-token-cursor-tokens (cursor)
        (nth cursor 1))

    (defn bml-token-cursor-index (cursor)
        (nth cursor 2))

    (defn bml-token-cursor-rest (cursor)
        (if (gt (len cursor) 3)
            (nth cursor 3)
            (drop (bml-token-cursor-index cursor)
                  (bml-token-cursor-tokens cursor))))

    (defn bml-token-cursor-end? (cursor)
        (nil? (bml-token-cursor-rest cursor)))

    (defn bml-token-cursor-current (cursor)
        (head (bml-token-cursor-rest cursor)))

    (defn bml-token-cursor-advance (cursor)
        (bml-token-cursor-with-rest
            (bml-token-cursor-tokens cursor)
            (add (bml-token-cursor-index cursor) 1)
            (tail (bml-token-cursor-rest cursor))))

    (defn bml-token-span (start length token-values)
        (list "bml-token-span" start length token-values))

    (defn bml-token-span? (span)
        (if (nil? span) false
            (str_eq (head span) "bml-token-span")))

    (defn bml-token-span-start (span)
        (nth span 1))

    (defn bml-token-span-length (span)
        (nth span 2))

    (defn bml-token-span-values (span)
        (nth span 3))

    (defn bml-body-source-with-span (token-values token-span)
        (comp-bml-component "BodySource" (list token-values token-span)))

    (defn bml-body-source (token-values)
        (bml-body-source-with-span
            token-values
            (bml-token-span 0 (len token-values) token-values)))

    (defn bml-body-source-values (body-component)
        (head (comp-bml-fields body-component)))

    ;; The scanned objects of a body, when the parser kept them: what the
    ;; statement grammar re-reads when a parsed class reaches Hati.
    (defn bml-body-source-objects (body-component)
        (if (gt (len (comp-bml-fields body-component)) 2)
            (nth (comp-bml-fields body-component) 2)
            (empty)))

    (defn bml-body-source-span (body-component)
        (if (gt (len (comp-bml-fields body-component)) 1)
            (nth (comp-bml-fields body-component) 1)
            (bml-token-span
                0
                (len (bml-body-source-values body-component))
                (bml-body-source-values body-component))))

    (defn bml-string-list-contains? (items value)
        (if (nil? items) false
            (if (str_eq (head items) value) true
                (bml-string-list-contains? (tail items) value))))

    (defn bml-body-source-contains? (body-component value)
        (bml-string-list-contains?
            (bml-body-source-values body-component)
            value))

    (defn bml-bmf-as-string-special-escape (next)
        (if (str_eq next (byte_to_str 92)) next
        (if (str_eq next (byte_to_str 39)) next
        (if (str_eq next (byte_to_str 34)) next
        (if (str_eq next "n") (byte_to_str 10)
        (if (str_eq next "t") (byte_to_str 9)
        (if (str_eq next "r") ""
            (empty))))))))

    (defn bml-bmf-as-string-known-escape? (next)
        (or (str_eq next (byte_to_str 92))
        (or (str_eq next (byte_to_str 39))
        (or (str_eq next (byte_to_str 34))
        (or (str_eq next "n")
        (or (str_eq next "t")
            (str_eq next "r")))))))

    (defn bml-bmf-as-string-loop (str-value i acc)
        (if (ge i (str_len str-value)) acc
            (do
                (let ch (char_at str-value i))
                (if (and (str_eq ch (byte_to_str 92))
                         (lt (add i 1) (str_len str-value)))
                    (do
                        (let next (char_at str-value (add i 1)))
                        (let escaped (bml-bmf-as-string-special-escape next))
                        (if (bml-bmf-as-string-known-escape? next)
                            (bml-bmf-as-string-loop
                                str-value
                                (add i 2)
                                (str_concat acc escaped))
                            (bml-bmf-as-string-loop
                                str-value
                                (add i 1)
                                (str_concat acc ch))))
                    (bml-bmf-as-string-loop
                        str-value
                        (add i 1)
                        (str_concat acc ch))))))

    (defn bml-bmf-as-string (str-value)
        (bml-bmf-as-string-loop str-value 0 ""))

    (defn bml-bmf-as-bml-string-escape (ch)
        (if (str_eq ch (byte_to_str 92))
            (str_concat (byte_to_str 92) (byte_to_str 92))
        (if (str_eq ch (byte_to_str 34))
            (str_concat (byte_to_str 92) (byte_to_str 34))
        (if (str_eq ch (byte_to_str 10))
            (str_concat (byte_to_str 92) "n")
        (if (str_eq ch (byte_to_str 13))
            (str_concat (byte_to_str 92) "r")
        (if (str_eq ch (byte_to_str 9))
            (str_concat (byte_to_str 92) "t")
        (if (eq (ord ch) 0)
            (str_concat (byte_to_str 92) "0")
            ch)))))))

    (defn bml-bmf-as-bml-string-loop (str-value i acc)
        (if (ge i (str_len str-value)) acc
            (bml-bmf-as-bml-string-loop
                str-value
                (add i 1)
                (str_concat
                    acc
                    (bml-bmf-as-bml-string-escape
                        (char_at str-value i))))))

    ; KNOWN GAP, NOT A CHOICE. `nil?` is a LIST cell (core.fk names why), so on fkwu this reads 1 for
    ; every string and this cell returns "" for every literal it is asked to escape. The fix its kin
    ; in ask-native-lane.fk and rag-ask.fk took — `(eq (str_len s) 0)` — cannot simply be dropped in
    ; here: `str-value` arrives from `(record_get env "strValue")`, and a missing key gives a null
    ; that rust and ts REFUSE to hand to `str_len`. Closing this needs a four-way "absent or empty"
    ; door that neither `nil?` nor `str_len` alone is, and a band that exercises the missing-key path.
    (defn bml-bmf-as-bml-string (str-value)
        (if (nil? str-value) ""
            (bml-bmf-as-bml-string-loop str-value 0 "")))

    (defn bml-body-source-as-string-shape? (body-component)
        (and (bml-body-source-contains? body-component "StringBuffer")
             (and (bml-body-source-contains? body-component "switch")
                  (bml-body-source-contains? body-component "strValue"))))

    (defn bml-body-source-as-bml-string-shape? (body-component)
        (and (bml-body-source-contains? body-component "StringBuffer")
             (and (bml-body-source-contains? body-component "select")
                  (bml-body-source-contains? body-component "strValue"))))

    (defn bml-body-source-exec-as-string (body-component env)
        (if (bml-body-source-as-string-shape? body-component)
            (bml-bmf-as-string (record_get env "strValue"))
            ""))

    (defn bml-body-source-exec-as-bml-string (body-component env)
        (if (bml-body-source-as-bml-string-shape? body-component)
            (bml-bmf-as-bml-string (record_get env "strValue"))
            ""))

    (defn bml-body-source-assignment-at? (values)
        (if (gt (len values) 3)
            (if (str_eq (nth values 1) "=")
                (str_eq (nth values 3) ";")
                false)
            false))

    (defn bml-body-source-assignment-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-assignment-at? values)
                (bml-body-source-assignment-count-loop
                    (drop 4 values)
                    (add count 1))
                (bml-body-source-assignment-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-assignment-count (body-component)
        (bml-body-source-assignment-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-exec-assignments-loop (values self env)
        (if (nil? values) self
            (if (bml-body-source-assignment-at? values)
                (do
                    (record_set
                        self
                        (head values)
                        (record_get env (nth values 2)))
                    (bml-body-source-exec-assignments-loop
                        (drop 4 values)
                        self
                        env))
                (bml-body-source-exec-assignments-loop
                    (tail values)
                    self
                    env))))

    (defn bml-body-source-exec-assignments (body-component self env)
        (bml-body-source-exec-assignments-loop
            (bml-body-source-values body-component)
            self
            env))

    (defn bml-body-source-return-member-add-at? (values)
        (if (gt (len values) 8)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) ".")
                    (if (str_eq (nth values 4) "+")
                        (if (str_eq (nth values 6) ".")
                            (str_eq (nth values 8) ";")
                            false)
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-member-add-loop? (values)
        (if (nil? values) false
            (if (bml-body-source-return-member-add-at? values) true
                (bml-body-source-return-member-add-loop? (tail values)))))

    (defn bml-body-source-return-member-add? (body-component)
        (bml-body-source-return-member-add-loop?
            (bml-body-source-values body-component)))

    (defn bml-body-source-return-member-eq-at? (values)
        (if (gt (len values) 6)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) "==")
                    (if (str_eq (nth values 4) ".")
                        (str_eq (nth values 6) ";")
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-member-eq-loop? (values)
        (if (nil? values) false
            (if (bml-body-source-return-member-eq-at? values) true
                (bml-body-source-return-member-eq-loop? (tail values)))))

    (defn bml-body-source-return-member-eq? (body-component)
        (bml-body-source-return-member-eq-loop?
            (bml-body-source-values body-component)))

    (defn bml-body-source-return-member-eq-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-member-eq-at? values)
                (bml-body-source-return-member-eq-count-loop
                    (drop 7 values)
                    (add count 1))
                (bml-body-source-return-member-eq-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-member-eq-count (body-component)
        (bml-body-source-return-member-eq-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-return-object-at? (values)
        (if (gt (len values) 2)
            (if (str_eq (head values) "return")
                (str_eq (nth values 2) ";")
                false)
            false))

    (defn bml-body-source-return-object-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-object-at? values)
                (bml-body-source-return-object-count-loop
                    (drop 3 values)
                    (add count 1))
                (bml-body-source-return-object-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-object-count (body-component)
        (bml-body-source-return-object-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-object-value (self env name)
        (if (str_eq name "null") (empty)
            (if (record_has self name)
                (record_get self name)
                (record_get env name))))

    (defn bml-body-source-member-value (self env object-name member-name)
        (record_get
            (bml-body-source-object-value self env object-name)
            member-name))

    (defn bml-body-source-return-receiver-call0-at? (values)
        (if (gt (len values) 6)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) ".")
                    (if (str_eq (nth values 4) "(")
                        (if (str_eq (nth values 5) ")")
                            (str_eq (nth values 6) ";")
                            false)
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-receiver-call0-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-receiver-call0-at? values)
                (bml-body-source-return-receiver-call0-count-loop
                    (drop 7 values)
                    (add count 1))
                (bml-body-source-return-receiver-call0-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-receiver-call0-count (body-component)
        (bml-body-source-return-receiver-call0-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-return-receiver-call0-eq-string-at? (values)
        (if (gt (len values) 8)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) ".")
                    (if (str_eq (nth values 4) "(")
                        (if (str_eq (nth values 5) ")")
                            (if (str_eq (nth values 6) "==")
                                (str_eq (nth values 8) ";")
                                false)
                            false)
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-receiver-call0-eq-string-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-receiver-call0-eq-string-at? values)
                (bml-body-source-return-receiver-call0-eq-string-count-loop
                    (drop 9 values)
                    (add count 1))
                (bml-body-source-return-receiver-call0-eq-string-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-receiver-call0-eq-string-count (body-component)
        (bml-body-source-return-receiver-call0-eq-string-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-return-implicit-call1-receiver-call0-at? (values)
        (if (gt (len values) 9)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) "(")
                    (if (str_eq (nth values 4) ".")
                        (if (str_eq (nth values 6) "(")
                            (if (str_eq (nth values 7) ")")
                                (if (str_eq (nth values 8) ")")
                                    (str_eq (nth values 9) ";")
                                    false)
                                false)
                            false)
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-implicit-call1-receiver-call0-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-implicit-call1-receiver-call0-at? values)
                (bml-body-source-return-implicit-call1-receiver-call0-count-loop
                    (drop 10 values)
                    (add count 1))
                (bml-body-source-return-implicit-call1-receiver-call0-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-implicit-call1-receiver-call0-count (body-component)
        (bml-body-source-return-implicit-call1-receiver-call0-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-return-constructor3-at? (values)
        (if (gt (len values) 9)
            (if (str_eq (head values) "return")
                (if (str_eq (nth values 2) "(")
                    (if (str_eq (nth values 4) ",")
                        (if (str_eq (nth values 6) ",")
                            (if (str_eq (nth values 8) ")")
                                (str_eq (nth values 9) ";")
                                false)
                            false)
                        false)
                    false)
                false)
            false))

    (defn bml-body-source-return-constructor3-count-loop (values count)
        (if (nil? values) count
            (if (bml-body-source-return-constructor3-at? values)
                (bml-body-source-return-constructor3-count-loop
                    (drop 10 values)
                    (add count 1))
                (bml-body-source-return-constructor3-count-loop
                    (tail values)
                    count))))

    (defn bml-body-source-return-constructor3-count (body-component)
        (bml-body-source-return-constructor3-count-loop
            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-if-local-eq-string-return-true-at? (values)
        (if (gt (len values) 8)
            (if (str_eq (head values) "if")
                (if (str_eq (nth values 1) "(")
                    (if (str_eq (nth values 3) "==")
                        (if (str_eq (nth values 5) ")")
                            (if (str_eq (nth values 6) "return")
                                (if (str_eq (nth values 7) "true")
                                    (str_eq (nth values 8) ";")
                                    false)
                                false)
                            false)
                        false)
