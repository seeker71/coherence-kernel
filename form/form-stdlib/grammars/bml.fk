            (bml-body-source-values body-component)
            0))

    (defn bml-body-source-object-value (self env name)
        (if (str_eq name "null") (empty)
            (if (record_has self name)
                (record_get self name)
                (record_get env name))))

    (defn bml-body-source-member-value (self env object-name member-name)
        (record_get
            (bml-body-source-object-value self env object-name)
            member-name))

