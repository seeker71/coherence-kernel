    def bml-source-parse-array-suffix(type-name, objects) = bml-source-token-value?(objects[0], "[") ? bml-source-token-value?(objects[1], "]") ? [(type-name + "[]"), drop(2, objects)] : [type-name, objects] : [type-name, objects];
    def bml-source-parse-type(objects) = {
