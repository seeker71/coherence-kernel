            "AssignParameterProperty" "MemberProperty" "GetMemberProperty"
            "PutMemberProperty" "DelegateMemberProperty" "InlineMemberProperty"
            "ConstMemberProperty" "AccessProperty" "PublicAccessProperty"
            "PrivateAccessProperty" "ProtectedAccessProperty" "Properties" "spc"
            "Statement" "CodeBlock" "ExpressionStatement" "BMLLabel" "For" "While"
            "Loop" "CaseExpr" "Case" "Switch" "SwitchBlock" "Select" "Fail" "With"
            "Choose" "If" "Return" "Break" "Continue" "Try" "Throw" "asmId"
            "asmClassUse" "Asm" "asmBlock" "asmLocalDecl" "asmStatement" "asmArgument"
            "asmConst" "asmLabelDecl" "asmMethodRef" "asmMethodSignature" "asmReg"
            "op" "Expression" "BaseExpr" "Identifier" "LocalField" "ConstExpression"
            "float" "Char" "Array" "Block" "Anonymous" "Arguments"
            "TypeCastOp" "SelectOp" "ItemAtOp" "IfOp" "BMFRule" "BMFLit" "BMFRange"
            "BMFChar" "BMFBasis" "BMFLiteral" "BMFCall" "BMFCallBase" "BMFPrim"
            "BMFInline" "BMFTag" "BMFExpr" "BMFTerm" "BMFFactor" "BMFItemMethod"
            "BMFItem" "BMFOpt" "BMFMust" "BMFAttribute"))

    (let bml-thesis-bmf-primitives
        (list "Nil" "Fail" "EndOfFile" "EndOfLine" "Cut" "MultiMatch" "Primitive"))

    (let bml-thesis-bmf-primitive-rule-names
        (list "bmf-nil" "bmf-fail" "bmf-end-of-file" "bmf-end-of-line"
              "bmf-cut-primitive" "bmf-multi-match" "bmf-primitive-base"))

    (let bml-compiler-rules
        (list
            (list "bml-package"
                  (list "sequence" (bml-kw "package") (list "capture" "name" (object-lit "bml-name" "")) (bml-op ";"))
                  bml-compile-package
                  bmf-identity-inverse)
            (list "bml-import"
                  (list "sequence" (bml-kw "import") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "star" (object-lit "bml-op" "")) (bml-op ";"))
                  bml-compile-import
                  bmf-identity-inverse)
            (list "bml-binary-type"
                  (list "sequence" (bml-kw "binary") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "fields" (object-lit "bml-list" "")))
                  bml-compile-binary-type
                  bmf-identity-inverse)
            (list "bml-class"
                  (list "sequence" (bml-kw "class") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (list "capture" "supers" (object-lit "bml-list" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-class
                  bmf-identity-inverse)
            (list "bml-interface"
                  (list "sequence" (bml-kw "interface") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (list "capture" "parent" (object-lit "bml-name" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-interface
                  bmf-identity-inverse)
            (list "bml-template"
                  (list "sequence" (bml-kw "template") (list "capture" "parameters" (object-lit "bml-list" "")) (list "capture" "kind" (object-lit "bml-name" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-template
                  bmf-identity-inverse)
            (list "bml-section"
                  (list "sequence" (bml-kw "section") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-section
                  bmf-identity-inverse)
            (list "bml-syntax"
                  (list "sequence" (bml-kw "syntax") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "rules" (object-lit "bml-list" "")) (list "capture" "attributes" (object-lit "bml-list" "")))
                  bml-compile-syntax
                  bmf-identity-inverse)
            (list "bml-field"
                  (list "sequence" (list "capture" "type" (object-lit "bml-name" "")) (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (bml-op ";"))
                  bml-compile-field
                  bmf-identity-inverse)
            (list "bml-const"
                  (list "sequence" (bml-kw "const") (list "capture" "type" (object-lit "bml-name" "")) (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (bml-op "=") (list "capture" "value" (object-lit "bml-int" "")))
                  bml-compile-const
                  bmf-identity-inverse)
            (list "bml-enum"
                  (list "sequence" (bml-kw "enum") (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (list "capture" "base" (object-lit "bml-name" "")) (list "capture" "values" (object-lit "bml-list" "")))
                  bml-compile-enum
                  bmf-identity-inverse)
            (list "bml-method"
                  (list "sequence" (list "capture" "return" (object-lit "bml-name" "")) (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-method
                  bmf-identity-inverse)
            (list "bml-parameter"
                  (list "sequence" (list "capture" "type" (object-lit "bml-name" "")) (list "capture" "name" (object-lit "bml-name" "")) (list "capture" "properties" (object-lit "bml-list" "")))
                  bml-compile-parameter
                  bmf-identity-inverse)
            (list "bml-property"
                  (list "sequence" (list "capture" "name" (object-lit "bml-property" "")) (list "capture" "value" (object-lit "bml-name" "")))
                  bml-compile-property
                  bmf-identity-inverse)
            (list "bml-statement"
                  (list "sequence" (list "capture" "kind" (object-lit "bml-keyword" "")) (list "capture" "value" (object-lit "bml-name" "")) (list "capture" "body" (object-lit "bml-list" "")))
                  bml-compile-statement
                  bmf-identity-inverse)
            (list "bml-expression"
                  (list "sequence" (list "capture" "kind" (object-lit "bml-name" "")) (list "capture" "left" (object-lit "bml-name" "")) (list "capture" "right" (object-lit "bml-name" "")))
                  bml-compile-expression
                  bmf-identity-inverse)
            (list "bml-asm"
                  (list "sequence" (bml-kw "asm") (list "capture" "locals" (object-lit "bml-list" "")) (list "capture" "statements" (object-lit "bml-list" "")) (list "capture" "blocks" (object-lit "bml-list" "")))
                  bml-compile-asm
                  bmf-identity-inverse)
            (list "bml-main-rule"
                  (list "capture" "item" (object-lit "bml-list" ""))
                  bml-compile-main-rule
                  bmf-identity-inverse)
            (list "bml-file"
                  (list "capture" "items" (object-lit "bml-list" ""))
                  bml-compile-file
                  bmf-identity-inverse)))

    (let bml-compiler-rule-index
        (object-rule-set-index bml-compiler-rules))

    (defn bml-compiler-rule-name (r) (head r))

    (defn bml-compiler-find-rule (rule-name rules)
        (if (nil? rules) (empty)
            (if (str_eq (bml-compiler-rule-name (head rules)) rule-name)
                (head rules)
                (bml-compiler-find-rule rule-name (tail rules)))))

    (defn bml-compiler-has-rule? (rule-name)
        (if (nil? (bml-compiler-find-rule rule-name bml-compiler-rules)) false true))

    (defn bml-compiler-rule-count-loop (rules)
        (if (nil? rules) 0
            (add 1 (bml-compiler-rule-count-loop (tail rules)))))

    (defn bml-compiler-rule-count (_x)
        (bml-compiler-rule-count-loop bml-compiler-rules))

    (defn bml-reference-rule-count (_x)
        (len bml-reference-rule-names))

    (defn bml-thesis-bmf-primitive-count (_x)
        (len bml-thesis-bmf-primitives))

    (defn apply-bml-compiler-rule (rule-name objects)
        (apply-object-rule (bml-compiler-find-rule rule-name bml-compiler-rules) objects))

    (defn apply-bml-compiler-first-rule (objects)
        (apply-indexed-object-rule-set bml-compiler-rule-index objects))

    ;; --- BMF rule emitters ------------------------------------------

    (defn bml-emit-class-header (objects)
        (bml-ast-class
            (bmf-collection-value objects "name")
            (bmf-collection-value objects "base")
            (intern_node BML-AST-BLOCK (empty))))

    (defn bml-emit-class-two-base-header (objects)
        (comp-bml-component
            "Class"
            (list
                (bmf-collection-value objects "name")
                (empty)
                (list (bmf-collection-value objects "first")
                      (bmf-collection-value objects "second"))
                (empty))))

    (defn bml-source-class-header (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "class")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ":")
                  (bml-src-name (node_value (head (tail kids)))))))

    (defn bml-emit-interface-header (objects)
        (bml-ast-interface
            (bmf-collection-value objects "name")
            (bmf-collection-value objects "parent")
            (intern_node BML-AST-BLOCK (empty))))

    (defn bml-source-interface-header (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "interface")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ":")
                  (bml-src-name (node_value (head (tail kids)))))))

    (defn bml-emit-package-simple (objects)
        (bml-ast-package (bmf-collection-value objects "name")))

    (defn bml-source-package-simple (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "package")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ";"))))

    (defn bml-emit-import-simple (objects)
        (bml-ast-import (bmf-collection-value objects "name") ""))

    (defn bml-source-import-simple (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "import")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ";"))))

    (defn bml-emit-import-star-simple (objects)
        (bml-ast-import (bmf-collection-value objects "name") ".*"))

    (defn bml-source-import-star-simple (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "import")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ".*")
                  (bml-src-op ";"))))

    (defn bml-emit-section-header (objects)
        (bml-ast-section
            (intern_node BML-AST-NAME
                         (list (bml-cap-str objects "property")))
            (intern_node BML-AST-BLOCK (empty))))

    (defn bml-emit-field (objects)
        (bml-ast-field
            (bmf-collection-value objects "type")
            (bmf-collection-value objects "name")))

    (defn bml-source-field (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-name (node_value (head kids)))
                  (bml-src-name (node_value (head (tail kids))))
                  (bml-src-op ";"))))

    (defn bml-emit-const-int (objects)
        (bml-ast-const
            (bmf-collection-value objects "type")
            (bmf-collection-value objects "name")
            (intern_node BML-AST-INT (list (bml-cap-int objects "value")))))

    (defn bml-source-const-int (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let value-node (head (tail (tail kids))))
            (list (bml-src-keyword "const")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-name (node_value (head (tail kids))))
                  (bml-src-op "=")
                  (bml-src-int (int_to_str (node_value (head (node_children value-node)))))
                  (bml-src-op ";"))))

    (defn bml-emit-return-int (objects)
        (bml-ast-return
            (intern_node BML-AST-INT (list (bml-cap-int objects "value")))))

    (defn bml-emit-return-float (objects)
        (bml-ast-return
            (bml-ast-float-node (bml-cap-float objects "value"))))

    (defn bml-emit-return-char (objects)
        (bml-ast-return
            (bml-ast-char (bmf-collection-value objects "value"))))

    (defn bml-emit-return-name (objects)
        (bml-ast-return
            (bml-ast-name (bmf-collection-value objects "name"))))

    (defn bml-emit-return-name-add-int (objects)
        (bml-ast-return
            (bml-ast-add
                (bml-ast-name (bmf-collection-value objects "name"))
                (intern_node BML-AST-INT (list (bml-cap-int objects "value"))))))

    (defn bml-emit-return-call-int (objects)
        (bml-ast-return
            (bml-ast-call
                (bmf-collection-value objects "callee")
                (intern_node BML-AST-INT
                             (list (bml-cap-int objects "value"))))))

    (defn bml-emit-return-call-two-int (objects)
        (bml-ast-return
            (bml-ast-call-args
                (bmf-collection-value objects "callee")
                (list
                    (intern_node BML-AST-INT
                                 (list (bml-cap-int objects "left")))
                    (intern_node BML-AST-INT
                                 (list (bml-cap-int objects "right")))))))

    (defn bml-source-return-int (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let value-node (head kids))
            (list (bml-src-keyword "return")
                  (bml-src-int (int_to_str (node_value (head (node_children value-node)))))
                  (bml-src-op ";"))))

    (defn bml-source-return-name (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let name-node (head kids))
            (list (bml-src-keyword "return")
                  (bml-src-name (node_value (head (node_children name-node))))
                  (bml-src-op ";"))))

    (defn bml-source-return-name-add-int (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let add-node (head kids))
            (let name-node (bml-node-child add-node 0))
            (let value-node (bml-node-child add-node 1))
            (list (bml-src-keyword "return")
                  (bml-src-name (node_value (head (node_children name-node))))
                  (bml-src-op "+")
                  (bml-src-int (int_to_str (node_value (head (node_children value-node)))))
                  (bml-src-op ";"))))

    (defn bml-emit-break-simple (objects)
        (bml-ast-break (bmf-collection-value objects "label")))

    (defn bml-source-break-simple (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "break")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ";"))))

    (defn bml-emit-continue-simple (objects)
        (bml-ast-continue (bmf-collection-value objects "label")))

    (defn bml-source-continue-simple (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-keyword "continue")
                  (bml-src-name (node_value (head kids)))
                  (bml-src-op ";"))))

    (defn bml-emit-throw-int (objects)
        (bml-ast-throw
            (intern_node BML-AST-INT (list (bml-cap-int objects "value")))))

    (defn bml-source-throw-int (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let value-node (head kids))
            (list (bml-src-keyword "throw")
                  (bml-src-int (int_to_str (node_value (head (node_children value-node)))))
                  (bml-src-op ";"))))

    (defn bml-emit-try-throw-return (objects)
        (bml-ast-try
            (bml-ast-block
                (list (bml-ast-throw
                        (intern_node BML-AST-INT
                                     (list (bml-cap-int objects "throw-value"))))))
            (bml-ast-block
                (list (bml-ast-return
                        (intern_node BML-AST-INT
                                     (list (bml-cap-int objects "return-value"))))))))

    (defn bml-source-try-throw-return (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let body (head kids))
            (let handler (head (tail kids)))
            (let throw-node (head (node_children body)))
            (let return-node (head (node_children handler)))
            (let throw-value-node (head (node_children throw-node)))
            (let return-value-node (head (node_children return-node)))
            (list (bml-src-keyword "try") (bml-src-op "{")
                  (bml-src-keyword "throw")
                  (bml-src-int (int_to_str (node_value (head (node_children throw-value-node)))))
                  (bml-src-op ";") (bml-src-op "}")
                  (bml-src-keyword "catch") (bml-src-op "{")
                  (bml-src-keyword "return")
                  (bml-src-int (int_to_str (node_value (head (node_children return-value-node)))))
                  (bml-src-op ";") (bml-src-op "}"))))

    (defn bml-emit-char-lit (objects)
        (bml-ast-char (bmf-collection-value objects "value")))

    (defn bml-source-char-lit (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (list (bml-src-char (node_value (head kids))))))

    (defn bml-emit-array-int (objects)
        (bml-ast-array
            (list (intern_node BML-AST-INT (list (bml-cap-int objects "value"))))))

    (defn bml-source-array-int (object)
        (do
            (let kids (node_children (bmf-object-value object)))
            (let value-node (head kids))
            (list (bml-src-op "#(")
                  (bml-src-int (int_to_str (node_value (head (node_children value-node)))))
                  (bml-src-op ")"))))

    (defn bml-emit-method-return-add (objects)
        (bml-ast-method
            (bmf-collection-value objects "name")
            (bml-ast-return
                (bml-ast-add
                    (intern_node BML-AST-INT (list (bml-cap-int objects "left")))
                    (intern_node BML-AST-INT (list (bml-cap-int objects "right")))))))

    (defn bml-emit-method-param-return-add (objects)
        (bml-ast-method-with-parameters
            (bmf-collection-value objects "name")
            (bml-ast-return
                (bml-ast-add
                    (bml-ast-name (bmf-collection-value objects "param-ref"))
                    (intern_node BML-AST-INT
                                 (list (bml-cap-int objects "value")))))
            (list
                (bml-parameter-component
                    (bmf-collection-value objects "param-type")
                    (bmf-collection-value objects "param-name")))))

    (defn bml-emit-method-two-param-return-add (objects)
        (bml-ast-method-with-parameters
            (bmf-collection-value objects "name")
            (bml-ast-return
                (bml-ast-add
                    (bml-ast-name (bmf-collection-value objects "left-ref"))
                    (bml-ast-name (bmf-collection-value objects "right-ref"))))
            (list
                (bml-parameter-component
                    (bmf-collection-value objects "left-type")
                    (bmf-collection-value objects "left-name"))
                (bml-parameter-component
                    (bmf-collection-value objects "right-type")
                    (bmf-collection-value objects "right-name")))))

    (defn bml-emit-method-return-this-field-add-int (objects)
        (bml-ast-method
            (bmf-collection-value objects "name")
            (bml-ast-return
                (bml-ast-add
                    (bml-ast-this-field (bmf-collection-value objects "field"))
                    (intern_node BML-AST-INT
                                 (list (bml-cap-int objects "value")))))))

    (defn bml-emit-method-set-this-field-return (objects)
        (bml-ast-method
            (bmf-collection-value objects "name")
            (bml-ast-block
                (list
                    (bml-ast-this-field-set
                        (bmf-collection-value objects "field")
                        (intern_node BML-AST-INT
                                     (list (bml-cap-int objects "value"))))
                    (bml-ast-return
                        (bml-ast-this-field
                            (bmf-collection-value objects "return-field")))))))

    (defn bml-emit-class-field-method-return-this-field-add-int (objects)
        (do
            (let field
                (bml-ast-field
                    (bmf-collection-value objects "field-type")
                    (bmf-collection-value objects "field-name")))
            (let method
                (bml-ast-method
                    (bmf-collection-value objects "method-name")
                    (bml-ast-return
                        (bml-ast-add
                            (bml-ast-this-field
                                (bmf-collection-value objects "return-field"))
                            (intern_node BML-AST-INT
                                         (list (bml-cap-int objects "value")))))))
            (bml-ast-class
                (bmf-collection-value objects "class-name")
                (bmf-collection-value objects "base")
                (bml-ast-block
                    (list
                        (bml-ast-section
                            (bml-ast-name
                                (bmf-collection-value objects "section-property"))
                            (bml-ast-block (list field method))))))))

    (defn bml-emit-choose-fail-int (objects)
        (bml-ast-choose
            (list
                (bml-ast-block (list (bml-ast-fail 0)))
                (bml-ast-block
                    (list (bml-ast-return
                            (intern_node BML-AST-INT
                                         (list (bml-cap-int objects "value")))))))))

    (defn bml-emit-if-fail-fail-return-int (objects)
        (bml-ast-choose
            (list
                (bml-ast-block (list (bml-ast-fail 0)))
                (bml-ast-block
                    (list (bml-ast-return
                            (intern_node BML-AST-INT
                                         (list (bml-cap-int objects "value")))))))))

    (defn bml-emit-while-success-fail-return-int (objects)
        (bml-ast-block
            (list
                (bml-ast-while-success
                    (bml-ast-block (list (bml-ast-fail 0))))
                (bml-ast-return
                    (intern_node BML-AST-INT
                                 (list (bml-cap-int objects "value")))))))

    (defn bml-emit-fail-simple (_objects)
        (bml-ast-fail 0))

    (defn bml-source-fail-simple (_object)
        (list (bml-src-keyword "fail") (bml-src-op ";")))

    (defn bml-emit-cut-simple (_objects)
        (bml-ast-cut 0))

    (defn bml-source-cut-simple (_object)
        (list (bml-src-keyword "cut") (bml-src-op ";")))

    (defn bml-emit-mark-simple (_objects)
        (bml-ast-save 0))

    (defn bml-source-mark-simple (_object)
        (list (bml-src-keyword "mark") (bml-src-op ";")))

    (defn bml-emit-restore-simple (_objects)
        (bml-ast-restore 0))

    (defn bml-source-restore-simple (_object)
        (list (bml-src-keyword "restore") (bml-src-op ";")))

    (defn bml-emit-discard-simple (_objects)
        (bml-ast-discard 0))

    (defn bml-source-discard-simple (_object)
        (list (bml-src-keyword "discard") (bml-src-op ";")))

    (defn bml-emit-save-simple (_objects)
        (bml-ast-save 0))

    (defn bml-source-save-simple (_object)
        (list (bml-src-keyword "save") (bml-src-op ";")))

    (defn bml-emit-state-int (objects)
        (bml-ast-block
            (list (bml-ast-save 0)
                  (intern_node BML-AST-INT (list (bml-cap-int objects "value")))
                  (bml-ast-discard 0))))

    (defn bml-emit-node-source (objects)
        (compiler-object "bml-source-node" objects objects compiler-identity-inverse))

    ;; --- BML rulebook ------------------------------------------------

    (let bml-bmf-reference-model
        (comp-bmf-syntax
            "BML"
            "bml"
            "file"
            (list
                (comp-bmf-rule "Rule" (empty) (comp-bmf-sequence (empty)) (comp-bmf-process "Invoke" "Object"))
                (comp-bmf-rule "Sequence" (empty) (comp-bmf-sequence (empty)) (empty))
                (comp-bmf-rule "Branch" (empty) (comp-bmf-branch (empty)) (empty))
                (comp-bmf-rule "Repeat" (empty) (comp-bmf-repeat (empty) 0 2147483647) (empty))
                (comp-bmf-rule "Tag" (empty) (comp-bmf-tag "" (empty)) (empty))
                (comp-bmf-rule "RuleCall" (empty) (comp-bmf-rule-call "name" (empty)) (empty))
                (comp-bmf-rule "MethodCall" (empty) (comp-bmf-method-call "name" (empty)) (empty))
                (comp-bmf-rule "Primitive" (empty) (comp-bmf-primitive "Cut" (empty)) (empty))
                (comp-bmf-rule "CharRange" (empty) (comp-bmf-char-range "a" "z") (empty))
                (comp-bmf-rule "CharChain" (empty) (comp-bmf-char-chain "literal") (empty)))
            (empty)
            (empty)))

    section [bml.bmf] {
      bml-comment-line ::= "/" "/" char-not-eol eol => bml-emit-node-source;
      bml-comment-nest ::= "/" "*" bml-comment-body "*" "/" => bml-emit-node-source;
      file ::= init main-rule eof => bml-emit-node-source;
      main-rule ::= include binary-type naming-conventions default-methods package import class interface template asm statement => bml-emit-node-source;
      package ::= "package" spc cut package-name ";" => bml-emit-node-source;
      import ::= "import" spc cut full-class-name import-star ";" => bml-emit-node-source;
      binary-type ::= "binary" cut $name:name "[" binary-field-list "]" => bml-emit-node-source;
      naming-conventions ::= "naming" cut "conventions" "{" type-naming-conventions operator-naming-conventions "}" => bml-emit-node-source;
      type-naming-decl ::= full-class-name cut "=" $name:name eol => bml-emit-node-source;
      operator-naming-decl ::= "'" op-name "'" cut "=" $name:name eol => bml-emit-node-source;
      default-methods ::= "DefaultMethods" cut "{" method "}" => bml-emit-node-source;
      package-simple ::= "package" $name:name ";" => bml-emit-package-simple <= bml-source-package-simple;
      file-package-one ::= "package" $name:name ";" => bml-emit-file-package-one;
      file-package-two ::= "package" $first:name "." $second:name ";" => bml-emit-file-package-two;
      import-simple ::= "import" $name:name ";" => bml-emit-import-simple <= bml-source-import-simple;
      import-star-simple ::= "import" $name:name ".*" ";" => bml-emit-import-star-simple <= bml-source-import-star-simple;
      file-import-one-star ::= "import" $name:name ".*" ";" => bml-emit-file-import-one-star;
      file-import-two-star ::= "import" $first:name "." $second:name ".*" ";" => bml-emit-file-import-two-star;
      file-include ::= "#" $directive:name $path:string => bml-emit-file-include;
      class-header ::= "class" $name:name ":" $base:name => bml-emit-class-header <= bml-source-class-header;
      class-two-base-header ::= "class" $name:name ":" $first:name "," $second:name => bml-emit-class-two-base-header;
      file-class-empty-two-base ::= "class" $name:name "[" $property:property "]" ":" $first:name "," $second:name "{" "}" => bml-emit-file-class-empty-two-base;
      file-class-section-field ::= "class" $name:name "[" $property:property "]" ":" $base:name "{" "section" "[" $section-property:property "]" "{" $field-type:name $field-name:name ";" "}" "}" => bml-emit-file-class-section-field;
      file-class-section-field-primitive ::= "class" $name:name "[" $property:property "]" ":" "Primitive" "{" "section" "[" $section-property:property "]" "{" $field-type:name $field-name:name ";" "}" "}" => bml-emit-file-class-section-field-primitive;
      file-class-section-const-string ::= "class" $name:name "[" $property:property "]" ":" $base:name "{" "section" "[" "class" "," $section-property:property "]" "{" "const" $const-type:name $const-name:name "=" $const-value:string ";" "}" "}" => bml-emit-file-class-section-const-string;
      file-class-section-return-method ::= "class" $name:name "[" $property:property "]" ":" $base:name "{" "section" "[" $section-property:property "]" "{" $return-type:name $method-name:name "(" ")" "{" "return" $return-value:int ";" "}" "}" "}" => bml-emit-file-class-section-return-method;
      class-field-method-return-this-field-add-int ::= "class" $class-name:name "[" $property:property "]" ":" $base:name "{" "section" "[" $section-property:property "]" "{" $field-type:name $field-name:name ";" $method-type:name $method-name:name "(" ")" "{" "return" $self:name "." $return-field:name "+" $value:int ";" "}" "}" "}" => bml-emit-class-field-method-return-this-field-add-int;
      file-class-primitive-cut ::= "class" "Cut" "[" $property:property "]" ":" "Primitive" "{" "section" "[" $section-property:property "]" "{" $match-return:name $match-name:name "(" $context-type:name $context-name:name "," $env-type:name $env-name:name "," $tag-type:name $tag-name:name ")" "{" $system-name:name "." "Cut" "(" $arg-object:name "." $argument-name:name "(" $arg-index:int ")" ")" ";" "}" $as-string-return:name $as-string-name:name "(" ")" "{" "return" $as-string-value:string ";" "}" $as-create-return:name $as-create-name:name "(" ")" "{" "return" $as-create-value:string ";" "}" "}" "}" => bml-emit-file-class-primitive-cut;
      class ::= "class" spc cut class-name properties super-class-list class-block => bml-emit-node-source;
      interface-header ::= "interface" $name:name ":" $parent:name => bml-emit-interface-header <= bml-source-interface-header;
      file-interface-empty ::= "interface" $name:name ":" $parent:name "{" "}" => bml-emit-file-interface-empty;
      interface ::= "interface" cut class-name properties parent-interface interface-block => bml-emit-node-source;
      template ::= "template" "<" cut template-parameter-list ">" class-or-interface => bml-emit-node-source;
      section-header ::= "section" "[" $property:property "]" => bml-emit-section-header;
      section-comma-header ::= "section" "[" $first:property "," $second:property "]" => bml-emit-node-source;
      section-named-header ::= "section" $name:name "[" $property:property "]" => bml-emit-node-source;
      section-named-comma-header ::= "section" $name:name "[" $first:property "," $second:property "]" => bml-emit-node-source;
      section-library-header ::= "section" "[" "library" "=" $value:string "]" => bml-emit-node-source;
      class-section ::= "section" spc cut properties class-block => bml-emit-node-source;
      syntax-section ::= "syntax" spc cut "[" $name:name "]" "{" bmf-rule-list bmf-attribute-list "}" => bml-emit-node-source;
      class-block ::= "{" template class-section syntax-section class-interface code-block class const method field "}" => bml-emit-node-source;
      interface-block ::= "{" interface-section constant method "}" => bml-emit-node-source;
      interface-ref ::= bml-class-use method-params array-definition-list => bml-emit-node-source;
      array-definition ::= "[" range "]" => bml-emit-node-source;
      field ::= $type:name $name:name ";" => bml-emit-field <= bml-source-field;
      field-definition ::= interface-ref field-list => bml-emit-node-source;
      member-field ::= field-name properties field-init => bml-emit-node-source;
      const-int ::= "const" $type:name $name:name "=" $value:int ";" => bml-emit-const-int <= bml-source-const-int;
      const ::= "const" spc cut interface-ref field-name properties "=" expression => bml-emit-node-source;
      enum ::= "enum" spc cut class-name properties enum-base "{" enum-const-list "}" => bml-emit-node-source;
      property ::= member-property "|" parameter-property "|" method-property "|" array-property "|" access-property "|" class-def-property "|" library-property "|" name-property "|" guid-property => bml-emit-node-source;
      properties ::= "[" property-list "]" => bml-emit-node-source;
      method-return-add ::= $type:name $name:name "(" ")" "{" "return" $left:int "+" $right:int ";" "}" => bml-emit-method-return-add;
      method-param-return-add ::= $type:name $name:name "(" $param-type:name $param-name:name ")" "{" "return" $param-ref:name "+" $value:int ";" "}" => bml-emit-method-param-return-add;
      method-two-param-return-add ::= $type:name $name:name "(" $left-type:name $left-name:name "," $right-type:name $right-name:name ")" "{" "return" $left-ref:name "+" $right-ref:name ";" "}" => bml-emit-method-two-param-return-add;
      method-return-this-field-add-int ::= $type:name $name:name "(" ")" "{" "return" $self:name "." $field:name "+" $value:int ";" "}" => bml-emit-method-return-this-field-add-int;
      method-set-this-field-return ::= $type:name $name:name "(" ")" "{" $self:name "." $field:name "=" $value:int ";" "return" $return-self:name "." $return-field:name ";" "}" => bml-emit-method-set-this-field-return;
      method ::= method-head properties code-block => bml-emit-node-source;
      method-head ::= "operator" spc cut full-class-name "|" interface-ref method-name => bml-emit-node-source;
      parameter ::= field-definition => bml-emit-node-source;
      statement ::= for while loop switch select if if-fail while-success return break continue try throw fail mark-simple cut-simple with choice choose asm expression-statement code-block => bml-emit-node-source;
      code-block ::= "{" cut statement-list "}" => bml-emit-node-source;
      expression-statement ::= expression ";" => bml-emit-node-source;
      for ::= label "for" "(" cut for-init expression ";" expression ")" statement => bml-emit-node-source;
      while ::= label "while" "(" cut expression ")" statement => bml-emit-node-source;
      if-fail ::= "if_fail" code-block => bml-emit-node-source;
      while-success ::= "while_success" code-block => bml-emit-node-source;
      if-fail-fail-return-int ::= "if_fail" "{" "return" $value:int ";" "}" "fail" ";" => bml-emit-if-fail-fail-return-int;
      while-success-fail-return-int ::= "while_success" "{" "fail" ";" "}" "return" $value:int ";" => bml-emit-while-success-fail-return-int;
      loop ::= label "loop" spc cut statement => bml-emit-node-source;
      switch ::= "switch" "(" cut expression ")" switch-block => bml-emit-node-source;
      select ::= "select" "(" cut expression ")" switch-block => bml-emit-node-source;
      case ::= "case" spc cut case-expr ":" statement-list => bml-emit-node-source;
      default-case ::= "default" ":" cut statement-list => bml-emit-node-source;
      if ::= "if" "(" cut expression ")" statement "else" spc cut statement => bml-emit-node-source;
      return-int ::= "return" $value:int ";" => bml-emit-return-int <= bml-source-return-int;
      return-float ::= "return" $value:float ";" => bml-emit-return-float;
      return-char ::= "return" $value:char ";" => bml-emit-return-char;
      return-name-add-int ::= "return" $name:name "+" $value:int ";" => bml-emit-return-name-add-int <= bml-source-return-name-add-int;
      return-call-int ::= "return" $callee:name "(" $value:int ")" ";" => bml-emit-return-call-int;
      return-call-two-int ::= "return" $callee:name "(" $left:int "," $right:int ")" ";" => bml-emit-return-call-two-int;
      return-name ::= "return" $name:name ";" => bml-emit-return-name <= bml-source-return-name;
      return ::= "return" expression ";" => bml-emit-node-source;
      break-simple ::= "break" $label:name ";" => bml-emit-break-simple <= bml-source-break-simple;
      break ::= "break" label-name ";" cut => bml-emit-node-source;
      continue-simple ::= "continue" $label:name ";" => bml-emit-continue-simple <= bml-source-continue-simple;
      continue ::= "continue" label-name ";" cut => bml-emit-node-source;
      try-throw-return ::= "try" "{" "throw" $throw-value:int ";" "}" "catch" "{" "return" $return-value:int ";" "}" => bml-emit-try-throw-return <= bml-source-try-throw-return;
      try ::= "try" spc cut statement "catch" "(" interface-ref field-name properties ")" statement => bml-emit-node-source;
      throw-int ::= "throw" $value:int ";" => bml-emit-throw-int <= bml-source-throw-int;
      throw ::= "throw" spc cut expression ";" cut => bml-emit-node-source;
      fail-simple ::= "fail" ";" => bml-emit-fail-simple <= bml-source-fail-simple;
      fail ::= fail-simple => bml-emit-node-source;
      cut-simple ::= "cut" ";" => bml-emit-cut-simple <= bml-source-cut-simple;
      mark-simple ::= "mark" ";" => bml-emit-mark-simple <= bml-source-mark-simple;
      restore-simple ::= "restore" ";" => bml-emit-restore-simple <= bml-source-restore-simple;
      discard-simple ::= "discard" ";" => bml-emit-discard-simple <= bml-source-discard-simple;
      save-simple ::= "save" ";" => bml-emit-save-simple <= bml-source-save-simple;
      nostate-property ::= "nostate" => bml-emit-node-source;
      choice-fail-int ::= "choice" "{" "fail" ";" "}" "," "{" "return" $value:int ";" "}" => bml-emit-choose-fail-int;
      choice ::= "choice" code-block choose-tail => bml-emit-node-source;
      choose-fail-int ::= "choose" "{" "fail" ";" "}" "," "{" "return" $value:int ";" "}" => bml-emit-choose-fail-int;
      choose ::= "choose" code-block choose-tail => bml-emit-node-source;
      asm ::= "asm" cut "{" asm-local-decl-list asm-statement-list "}" => bml-emit-node-source;
      asm-block ::= ".begin" cut asm-local-decl-list asm-statement-list ".end" => bml-emit-node-source;
      expression ::= op base-expr => bml-emit-node-source;
      base-expr ::= "(" expression ")" "|" identifier "|" const-expression => bml-emit-node-source;
      identifier ::= interface-ref local-field-list => bml-emit-node-source;
      const-expression ::= float "|" int "|" string "|" char "|" array "|" block "|" anonymous => bml-emit-node-source;
      float ::= signed-digits "." digits exponent => bml-emit-node-source;
      char-lit ::= $value:char => bml-emit-char-lit <= bml-source-char-lit;
      char ::= char-lit => bml-emit-node-source;
      array-int ::= "#(" $value:int ")" => bml-emit-array-int <= bml-source-array-int;
      array ::= "#(" expression-list ")" => bml-emit-node-source;
      block ::= interface-ref "(" parameter-list ")" properties code-block => bml-emit-node-source;
      anonymous ::= "class" spc cut bml-class-use "(" parameter-list ")" properties class-block => bml-emit-node-source;
      arguments ::= expression-list => bml-emit-node-source;
      op-select ::= "." select-op => bml-emit-node-source;
      op-item-at ::= "[" item-at-op "]" => bml-emit-node-source;
      op-call ::= "(" arguments ")" => bml-emit-node-source;
      op-instanceof ::= "instanceof" => bml-emit-node-source;
      op-type-cast ::= "(" type-cast-op ")" => bml-emit-node-source;
      op-prefix-inc ::= "++" => bml-emit-node-source;
      op-prefix-dec ::= "--" => bml-emit-node-source;
      op-not ::= "!" => bml-emit-node-source;
      op-bit-not ::= "~" => bml-emit-node-source;
      op-neg ::= "-" => bml-emit-node-source;
      op-pos ::= "+" => bml-emit-node-source;
      op-post-inc ::= "++" => bml-emit-node-source;
      op-post-dec ::= "--" => bml-emit-node-source;
      op-mul ::= "*" => bml-emit-node-source;
      op-div ::= "/" => bml-emit-node-source;
      op-mod ::= "%" => bml-emit-node-source;
      op-add ::= "+" => bml-emit-node-source;
      op-sub ::= "-" => bml-emit-node-source;
      op-shl ::= "<<" => bml-emit-node-source;
      op-shr-unsigned ::= ">>>" => bml-emit-node-source;
      op-shr ::= ">>" => bml-emit-node-source;
      op-lt ::= "<" => bml-emit-node-source;
      op-le ::= "<=" => bml-emit-node-source;
      op-gt ::= ">" => bml-emit-node-source;
      op-ge ::= ">=" => bml-emit-node-source;
      op-eq ::= "==" => bml-emit-node-source;
      op-ne ::= "!=" => bml-emit-node-source;
      op-bit-and ::= "&" => bml-emit-node-source;
      op-bit-xor ::= "^" => bml-emit-node-source;
      op-bit-or ::= "|" => bml-emit-node-source;
      op-and ::= "&&" => bml-emit-node-source;
      op-or ::= "||" => bml-emit-node-source;
      op-if ::= "?" if-op ":" => bml-emit-node-source;
      op-assign-ref ::= ":=" => bml-emit-node-source;
      op-assign ::= "=" => bml-emit-node-source;
      op-mul-assign ::= "*=" => bml-emit-node-source;
      op-div-assign ::= "/=" => bml-emit-node-source;
      op-mod-assign ::= "%=" => bml-emit-node-source;
      op-add-assign ::= "+=" => bml-emit-node-source;
      op-sub-assign ::= "-=" => bml-emit-node-source;
      op-shl-assign ::= "<<=" => bml-emit-node-source;
      op-shr-assign ::= ">>=" => bml-emit-node-source;
      op-and-assign ::= "&=" => bml-emit-node-source;
      op-or-assign ::= "|=" => bml-emit-node-source;
      op-xor-assign ::= "^=" => bml-emit-node-source;
      bmf-rule ::= bmf-call "::=" bmf-rule-body ";" cut => bml-emit-node-source;
      bmf-lit ::= bmf-bang-prefix string bmf-bang-suffix => bml-emit-node-source;
      bmf-range ::= bmf-char ".." bmf-char => bml-emit-node-source;
      bmf-char ::= "\\" cut int "|" "'" cut bmf-char-body "'" => bml-emit-node-source;
      bmf-basis ::= bmf-range "|" bmf-lit "|" bmf-call-base "|" bmf-primitive => bml-emit-node-source;
      bmf-literal ::= float "|" int "|" string "|" "#" cut field-name => bml-emit-node-source;
      bmf-call ::= $base:name bmf-call-args => bml-emit-node-source;
      bmf-call-base ::= bmf-call => bml-emit-node-source;
      bmf-primitive ::= bmf-nil "|" bmf-fail "|" bmf-end-of-file "|" bmf-end-of-line "|" bmf-cut-primitive "|" bmf-multi-match "|" bmf-primitive-base => bml-emit-node-source;
      bmf-nil ::= "Nil" => bml-emit-node-source;
      bmf-fail ::= "Fail" => bml-emit-node-source;
      bmf-end-of-file ::= "EndOfFile" => bml-emit-node-source;
      bmf-end-of-line ::= "EndOfLine" => bml-emit-node-source;
      bmf-cut-primitive ::= "Cut" => bml-emit-node-source;
      bmf-multi-match ::= "MultiMatch" => bml-emit-node-source;
      bmf-multi-match-count ::= "MultiMatch" "(" bmf-expr "," int ")" => bml-emit-node-source;
      bmf-primitive-base ::= "Primitive" => bml-emit-node-source;
      bmf-prim ::= "<<prim" spc id ">>" => bml-emit-node-source;
      bmf-inline ::= "<<" bmf-expr ">>" => bml-emit-node-source;
      bmf-tag ::= "$" $tag:name cut ":" => bml-emit-node-source;
      bmf-expr ::= bmf-term bmf-expr-tail => bml-emit-node-source;
      bmf-term ::= bmf-factor bmf-term-tail => bml-emit-node-source;
      bmf-factor ::= bmf-tag bmf-factor-body => bml-emit-node-source;
      bmf-item-method ::= bmf-item "." cut bmf-call-base => bml-emit-node-source;
      bmf-item ::= bmf-opt "|" bmf-basis "|" bmf-must => bml-emit-node-source;
      bmf-opt ::= "[" cut bmf-expr "]" => bml-emit-node-source;
      bmf-must ::= int "(" bmf-expr ")" int => bml-emit-node-source;
      bmf-attribute ::= id-list code-block => bml-emit-node-source;
      state-int ::= "save" ";" $value:int ";" "discard" ";" => bml-emit-state-int;
    }

    (let bml-bmf-rule-index
        (object-rule-set-index bml-bmf-rules))

    (defn bml-bmf-rule-name (r) (head r))

    (defn bml-bmf-find-rule (rule-name rules)
        (if (nil? rules) (empty)
            (if (str_eq (bml-bmf-rule-name (head rules)) rule-name)
                (head rules)
                (bml-bmf-find-rule rule-name (tail rules)))))

    (defn apply-bml-bmf-rule (rule-name objects)
        (apply-object-rule (bml-bmf-find-rule rule-name bml-bmf-rules) objects))

    (defn apply-bml-bmf-first-rule (objects)
        (apply-indexed-object-rule-set bml-bmf-rule-index objects))

    (defn bml-bmf-match-node (match)
        (bmf-object-value (cap-get (match-caps match) "result")))

    (defn bml-source-executable-rules (_x)
        (list "if-fail-fail-return-int"
              "while-success-fail-return-int"
              "try-throw-return"
              "break-simple"
              "continue-simple"
              "choice-fail-int"
              "choose-fail-int"
              "state-int"
              "class-field-method-return-this-field-add-int"
              "method-set-this-field-return"
              "method-return-this-field-add-int"
              "method-two-param-return-add"
              "method-param-return-add"
              "const-int"
              "return-call-two-int"
              "return-call-int"
              "return-name-add-int"
              "return-name"
              "return-char"
              "return-float"
              "return-int"
              "fail-simple"
              "cut-simple"
              "mark-simple"
              "restore-simple"
              "discard-simple"
              "save-simple"
              "array-int"
              "throw-int"))

    (defn bml-source-declaration-rules (_x)
        (list "file-include"
              "file-class-primitive-cut"
              "file-class-section-return-method"
              "file-class-section-const-string"
              "file-class-section-field-primitive"
              "file-class-section-field"
              "file-class-empty-two-base"
              "file-interface-empty"
              "file-package-two"
              "file-package-one"
              "file-import-two-star"
              "file-import-one-star"))

    (defn bml-bmf-rules-by-names (rule-names)
        (if (nil? rule-names) (empty)
            (cons (bml-bmf-find-rule (head rule-names) bml-bmf-rules)
                  (bml-bmf-rules-by-names (tail rule-names)))))

    (let bml-source-executable-rule-index
        (object-rule-set-index
            (bml-bmf-rules-by-names (bml-source-executable-rules 0))))

    (let bml-source-declaration-rule-index
        (object-rule-set-index
            (bml-bmf-rules-by-names (bml-source-declaration-rules 0))))

    (defn bml-source-executable-rule-index-known-count (_x)
        (object-rule-dispatch-index-known-count bml-source-executable-rule-index))

    (defn bml-source-executable-rule-index-candidate-count (objects)
        (object-rule-dispatch-index-candidate-count
            bml-source-executable-rule-index
            objects))

    (defn bml-source-executable-rule-index-skip-count (objects)
        (object-rule-dispatch-index-skip-count
            bml-source-executable-rule-index
            objects))

    (defn bml-source-executable-rule-index-bucket-count (_x)
        (object-rule-dispatch-index-bucket-count bml-source-executable-rule-index))

    (defn bml-source-executable-rule-index-segment-count (_x)
        (object-rule-dispatch-index-segment-count bml-source-executable-rule-index))

    (defn bml-source-declaration-rule-index-known-count (_x)
        (object-rule-dispatch-index-known-count bml-source-declaration-rule-index))

    (defn bml-source-declaration-rule-index-candidate-count (objects)
        (object-rule-dispatch-index-candidate-count
            bml-source-declaration-rule-index
            objects))

    (defn bml-source-declaration-rule-index-skip-count (objects)
        (object-rule-dispatch-index-skip-count
            bml-source-declaration-rule-index
            objects))

    (defn bml-source-declaration-rule-index-bucket-count (_x)
        (object-rule-dispatch-index-bucket-count bml-source-declaration-rule-index))

    (defn bml-source-declaration-rule-index-segment-count (_x)
        (object-rule-dispatch-index-segment-count bml-source-declaration-rule-index))

    (defn bml-source-parse-step (ok rule node rest)
        (list "bml-source-parse-step" ok rule node rest))

    (defn bml-source-parse-step-ok? (step) (nth step 1))
    (defn bml-source-parse-step-rule (step) (nth step 2))
    (defn bml-source-parse-step-node (step) (nth step 3))
    (defn bml-source-parse-step-rest (step) (nth step 4))

    (defn bml-source-parse-executable-step-loop (objects rule-names)
        (if (nil? rule-names)
            (bml-source-parse-step false "" (empty) objects)
            (do
                (let rule-name (head rule-names))
                (let m (apply-bml-bmf-rule rule-name objects))
                (if (match? m)
                    (bml-source-parse-step
                        true
                        rule-name
                        (bml-bmf-match-node m)
                        (match-rest m))
                    (bml-source-parse-executable-step-loop
                        objects
                        (tail rule-names))))))

    (defn bml-source-parse-indexed-step (objects rule-index)
        (do
            (let m (apply-indexed-object-rule-set rule-index objects))
            (if (match? m)
                (do
                    (let result (cap-get (match-caps m) "result"))
                    (bml-source-parse-step
                        true
                        (bmf-object-kind result)
                        (bmf-object-value result)
                        (match-rest m)))
                (bml-source-parse-step false "" (empty) objects))))

    (defn bml-source-token-value? (object value)
        (if (nil? object) false
            (str_eq (bmf-object-value object) value)))

    (defn bml-source-name-token? (object)
        (if (nil? object) false
            (if (str_eq (bmf-object-kind object) "bml-name") true
                (str_eq (bmf-object-kind object) "bml-keyword"))))

    (defn bml-source-property-token? (object)
        (if (nil? object) false
            (str_eq (bmf-object-kind object) "bml-property")))

    (defn bml-source-property-name-token? (object)
        (if (bml-source-name-token? object) true
            (bml-source-property-token? object)))

    (defn bml-source-token-values (objects)
        (if (nil? objects) (empty)
            (cons
                (bmf-object-value (head objects))
                (bml-source-token-values (tail objects)))))

    (defn bml-source-property-value-parse (objects)
        (if (bml-source-token-value? (head objects) "=")
            (list (bmf-object-value (nth objects 1)) (drop 2 objects))
            (list "true" objects)))

    (defn bml-source-properties-loop (objects acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (do
                (let object (head objects))
                (if (bml-source-token-value? object "]")
                    (list (reverse-list acc) (tail objects))
                (if (bml-source-token-value? object ",")
                    (bml-source-properties-loop (tail objects) acc)
                (if (bml-source-property-name-token? object)
                    (do
                        (let value-parse
                            (bml-source-property-value-parse (tail objects)))
                        (bml-source-properties-loop
                            (nth value-parse 1)
                            (cons
                                (bml-property-component
                                    (bmf-object-value object)
                                    (nth value-parse 0))
                                acc)))
                    (bml-source-properties-loop (tail objects) acc)))))))

    (defn bml-source-properties-parse (objects)
        (if (bml-source-token-value? (head objects) "[")
            (bml-source-properties-loop (tail objects) (empty))
            (list (empty) objects)))

    (defn bml-source-class-property-parse (objects)
        (bml-source-properties-parse objects))

    ;; After a dot any word reads as a name segment: a property word
    ;; (native, public, get, ...) or a keyword names a path segment there.
    (defn bml-source-parse-qualified-name-loop (objects current)
        (if (nil? objects)
            (list current objects)
            (if (bml-source-token-value? (head objects) ".")
                (if (bml-source-property-name-token? (nth objects 1))
                    (bml-source-parse-qualified-name-loop
                        (drop 2 objects)
                        (str_concat
                            (str_concat current ".")
                            (bmf-object-value (nth objects 1))))
                    (list current objects))
                (list current objects))))

    (defn bml-source-parse-qualified-name (objects)
        (if (bml-source-name-token? (head objects))
            (bml-source-parse-qualified-name-loop
                (tail objects)
                (bmf-object-value (head objects)))
            (list "" objects)))

    (defn bml-source-token-values-concat-loop (objects acc)
        (if (nil? objects) acc
            (bml-source-token-values-concat-loop
                (tail objects)
                (str_concat acc (bmf-object-value (head objects))))))

    (defn bml-source-token-values-concat (objects)
        (bml-source-token-values-concat-loop objects ""))

    (defn bml-source-collect-angle-loop (objects depth acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (do
                (let object (head objects))
                (let value (bmf-object-value object))
                (if (str_eq value "<")
                    (bml-source-collect-angle-loop
                        (tail objects)
                        (add depth 1)
                        (cons object acc))
                (if (str_eq value ">")
                    (if (eq depth 1)
                        (list (reverse-list acc) (tail objects))
                        (bml-source-collect-angle-loop
                            (tail objects)
                            (sub depth 1)
                            (cons object acc)))
                    (bml-source-collect-angle-loop
                        (tail objects)
                        depth
                        (cons object acc)))))))

    (defn bml-source-parse-generic-suffix (type-name objects)
        (if (bml-source-token-value? (head objects) "<")
            (do
                (let generic-parse
                    (bml-source-collect-angle-loop (tail objects) 1 (empty)))
                (list
                    (str_concat
                        (str_concat type-name "<")
                        (str_concat
                            (bml-source-token-values-concat (nth generic-parse 0))
                            ">"))
                    (nth generic-parse 1)))
            (list type-name objects)))

    (defn bml-source-parse-array-suffix (type-name objects)
        (if (bml-source-token-value? (head objects) "[")
            (if (bml-source-token-value? (nth objects 1) "]")
                (list (str_concat type-name "[]") (drop 2 objects))
                (list type-name objects))
            (list type-name objects)))

    (defn bml-source-parse-type (objects)
        (do
            (let name-parse (bml-source-parse-qualified-name objects))
            (let type-name (nth name-parse 0))
            (let rest (nth name-parse 1))
            (let generic-parse
                (bml-source-parse-generic-suffix type-name rest))
            (bml-source-parse-array-suffix
                (nth generic-parse 0)
                (nth generic-parse 1))))

    (defn bml-source-brace-collect-state (cursor depth acc done body rest steps)
        (list "bml-source-brace-collect-state"
              cursor depth acc done body rest steps))

    (defn bml-source-brace-collect-state? (state)
        (if (nil? state) false
            (str_eq (head state) "bml-source-brace-collect-state")))

    (defn bml-source-brace-collect-cursor (state) (nth state 1))
    (defn bml-source-brace-collect-depth (state) (nth state 2))
    (defn bml-source-brace-collect-acc (state) (nth state 3))
    (defn bml-source-brace-collect-done? (state) (nth state 4))
    (defn bml-source-brace-collect-body (state) (nth state 5))
    (defn bml-source-brace-collect-rest (state) (nth state 6))
    (defn bml-source-brace-collect-steps (state) (nth state 7))

    (defn bml-source-brace-collect-finish (state body rest)
        (bml-source-brace-collect-state
            (bml-source-brace-collect-cursor state)
            (bml-source-brace-collect-depth state)
            (bml-source-brace-collect-acc state)
            true
            body
            rest
            (bml-source-brace-collect-steps state)))

    (defn bml-source-brace-collect-step (state)
        (if (bml-source-brace-collect-done? state) state
            (do
                (let cursor (bml-source-brace-collect-cursor state))
                (if (bml-token-cursor-end? cursor)
                    (bml-source-brace-collect-finish
                        state
                        (reverse-list (bml-source-brace-collect-acc state))
                        (empty))
                (do
                (let object (bml-token-cursor-current cursor))
                (let value (bmf-object-value object))
                (let next-cursor (bml-token-cursor-advance cursor))
                (let next-steps
                    (add (bml-source-brace-collect-steps state) 1))
                (if (str_eq value "{")
                    (bml-source-brace-collect-state
                        next-cursor
                        (add (bml-source-brace-collect-depth state) 1)
                        (cons object (bml-source-brace-collect-acc state))
                        false
                        (empty)
                        (empty)
                        next-steps)
                (if (str_eq value "}")
                    (if (eq (bml-source-brace-collect-depth state) 1)
                        (bml-source-brace-collect-state
                            next-cursor
                            (bml-source-brace-collect-depth state)
                            (bml-source-brace-collect-acc state)
                            true
                            (reverse-list (bml-source-brace-collect-acc state))
                            (bml-token-cursor-rest next-cursor)
                            next-steps)
                        (bml-source-brace-collect-state
                            next-cursor
                            (sub (bml-source-brace-collect-depth state) 1)
                            (cons object
                                  (bml-source-brace-collect-acc state))
                            false
                            (empty)
                            (empty)
                            next-steps))
                    (bml-source-brace-collect-state
                        next-cursor
                        (bml-source-brace-collect-depth state)
                        (cons object (bml-source-brace-collect-acc state))
                        false
                        (empty)
                        (empty)
                        next-steps))))))))

    (defn bml-source-brace-collect-run (state)
        (if (bml-source-brace-collect-done? state) state
            (bml-source-brace-collect-run
                (bml-source-brace-collect-step state))))

    (defn bml-source-collect-balanced-brace-state (objects)
        (if (bml-source-token-value? (head objects) "{")
            (bml-source-brace-collect-run
                (bml-source-brace-collect-state
                    (bml-token-cursor objects 1)
                    1
                    (empty)
                    false
                    (empty)
                    (empty)
                    0))
            (bml-source-brace-collect-state
                (bml-token-cursor objects 0)
                0
                (empty)
                true
                (empty)
                objects
                0)))

    (defn bml-source-collect-balanced-brace (objects)
        (do
            (let state (bml-source-collect-balanced-brace-state objects))
            (list
                (bml-source-brace-collect-body state)
                (bml-source-brace-collect-rest state))))

    (defn bml-source-collect-balanced-paren-loop (objects depth acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (do
                (let object (head objects))
                (let value (bmf-object-value object))
                (if (str_eq value "(")
                    (bml-source-collect-balanced-paren-loop
                        (tail objects)
                        (add depth 1)
                        (cons object acc))
                (if (str_eq value ")")
                    (if (eq depth 1)
                        (list (reverse-list acc) (tail objects))
                        (bml-source-collect-balanced-paren-loop
                            (tail objects)
                            (sub depth 1)
                            (cons object acc)))
                    (bml-source-collect-balanced-paren-loop
                        (tail objects)
                        depth
                        (cons object acc)))))))

    (defn bml-source-collect-balanced-paren (objects)
        (if (bml-source-token-value? (head objects) "(")
            (bml-source-collect-balanced-paren-loop (tail objects) 1 (empty))
            (list (empty) objects)))

    (defn bml-source-collect-until-semicolon-loop (objects acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (if (bml-source-token-value? (head objects) ";")
                (list (reverse-list acc) (tail objects))
                (bml-source-collect-until-semicolon-loop
                    (tail objects)
                    (cons (head objects) acc)))))

    (defn bml-source-parse-one-parameter (objects)
        (do
            (let type-parse (bml-source-parse-type objects))
            (let param-type (nth type-parse 0))
            (let after-type (nth type-parse 1))
            (let name-object (head after-type))
            (if (bml-source-name-token? name-object)
                (list
                    (bml-parameter-component
                        param-type
                        (bmf-object-value name-object))
                    (tail after-type))
                (list (empty) objects))))

    (defn bml-source-parse-parameters-loop (objects acc)
        (if (nil? objects)
            (reverse-list acc)
            (if (bml-source-token-value? (head objects) ",")
                (bml-source-parse-parameters-loop (tail objects) acc)
                (do
                    (let parsed (bml-source-parse-one-parameter objects))
                    (let parameter (nth parsed 0))
                    (if (nil? parameter)
                        (reverse-list acc)
                        (bml-source-parse-parameters-loop
                            (nth parsed 1)
                            (cons parameter acc)))))))

    (defn bml-source-parse-parameters (objects)
        (bml-source-parse-parameters-loop objects (empty)))

    (defn bml-source-body-source-from-tokens (tokens)
        (do
            (let cursor (bml-token-cursor tokens 0))
            (let values
                (bml-source-token-values
                    (bml-token-cursor-rest cursor)))
            (bml-body-source-with-span
                values
                (bml-token-span
                    (bml-token-cursor-index cursor)
                    (len values)
                    values))))

    (defn bml-source-class-supers-loop (objects acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (do
                (let value (bmf-object-value (head objects)))
                (if (str_eq value "{")
                    (list (reverse-list acc) objects)
                (if (str_eq value ",")
                    (bml-source-class-supers-loop (tail objects) acc)
                    (do
                        (let type-parse (bml-source-parse-type objects))
                        (let super-name (nth type-parse 0))
                        (let rest (nth type-parse 1))
                        (if (str_eq super-name "")
                            (bml-source-class-supers-loop (tail objects) acc)
                            (bml-source-class-supers-loop
                                rest
                                (cons super-name acc)))))))))

    (defn bml-source-class-supers-parse (objects)
        (if (bml-source-token-value? (head objects) ":")
            (bml-source-class-supers-loop (tail objects) (empty))
            (list (empty) objects)))

    (defn bml-source-skip-balanced-brace-loop (objects depth)
        (if (nil? objects) objects
            (do
                (let value (bmf-object-value (head objects)))
                (if (str_eq value "{")
                    (bml-source-skip-balanced-brace-loop (tail objects) (add depth 1))
                (if (str_eq value "}")
                    (if (eq depth 1)
                        (tail objects)
                        (bml-source-skip-balanced-brace-loop (tail objects) (sub depth 1)))
                    (bml-source-skip-balanced-brace-loop (tail objects) depth))))))

    (defn bml-source-skip-class-body (objects)
        (if (bml-source-token-value? (head objects) "{")
            (bml-source-skip-balanced-brace-loop (tail objects) 1)
            objects))

    (defn bml-source-parse-field-after-name (field-type field-name objects)
        (do
            (let properties-parse (bml-source-properties-parse objects))
            (let properties (nth properties-parse 0))
            (let after-properties (nth properties-parse 1))
            (if (bml-source-token-value? (head after-properties) "=")
                (do
                    (let init-parse
                        (bml-source-collect-until-semicolon-loop
                            (tail after-properties)
                            (empty)))
                    (bml-source-parse-step
                        true
                        "file-class-field"
                        (comp-bml-component
                            "Field"
                            (list
                                field-type
                                field-name
                                properties
                                (bml-source-token-values (nth init-parse 0))))
                        (nth init-parse 1)))
            (if (bml-source-token-value? (head after-properties) ";")
                (bml-source-parse-step
                    true
                    "file-class-field"
                    (comp-bml-component
                        "Field"
                        (list field-type field-name properties (empty)))
                    (tail after-properties))
                (bml-source-parse-step false "" (empty) objects)))))

    (defn bml-source-parse-const (objects)
        (if (bml-source-token-value? (head objects) "const")
            (do
                (let type-parse (bml-source-parse-type (tail objects)))
                (let const-type (nth type-parse 0))
                (let after-type (nth type-parse 1))
                (let name-object (head after-type))
                (if (bml-source-name-token? name-object)
                    (do
                        (let const-name (bmf-object-value name-object))
                        (let properties-parse
                            (bml-source-properties-parse (tail after-type)))
                        (let properties (nth properties-parse 0))
                        (let after-properties (nth properties-parse 1))
                        (if (bml-source-token-value? (head after-properties) "=")
                            (do
                                (let value-parse
                                    (bml-source-collect-until-semicolon-loop
                                        (tail after-properties)
                                        (empty)))
                                (bml-source-parse-step
                                    true
                                    "file-class-const"
                                    (comp-bml-component
                                        "Const"
                                        (list
                                            const-type
                                            const-name
                                            properties
                                            (head
                                                (bml-source-token-values
                                                    (nth value-parse 0)))))
                                    (nth value-parse 1)))
                        (if (bml-source-token-value? (head after-properties) ";")
                            (bml-source-parse-step
                                true
                                "file-class-const"
                                (comp-bml-component
                                    "Const"
                                    (list const-type const-name properties ""))
                                (tail after-properties))
                            (bml-source-parse-step false "" (empty) objects))))
                    (bml-source-parse-step false "" (empty) objects)))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-method-after-name (class-name return-type method-name objects)
        (if (bml-source-token-value? (head objects) "(")
            (do
                (let parameter-parse (bml-source-collect-balanced-paren objects))
                (let parameters (bml-source-parse-parameters (nth parameter-parse 0)))
                (let after-parameters (nth parameter-parse 1))
                (let properties-parse
                    (bml-source-properties-parse after-parameters))
                (let properties (nth properties-parse 0))
                (let after-properties (nth properties-parse 1))
                (if (bml-source-token-value? (head after-properties) "{")
                    (do
                        (let body-parse
                            (bml-source-collect-balanced-brace after-properties))
                        (bml-source-parse-step
                            true
                            "file-class-method"
                            (comp-bml-component
                                "Method"
                                (list
                                    return-type
                                    method-name
                                    properties
                                    (bml-source-body-source-from-tokens
                                        (nth body-parse 0))
                                    parameters))
                            (nth body-parse 1)))
                    (if (bml-source-token-value? (head after-properties) ";")
                        (bml-source-parse-step
                            true
                            "file-method-signature"
                            (comp-bml-component
                                "Method"
                                (list
                                    return-type
                                    method-name
                                    properties
                                    (bml-body-source-with-span
                                        (empty)
                                        (bml-token-span 0 0 (empty)))
                                    parameters))
                            (tail after-properties))
                        (bml-source-parse-step false "" (empty) objects))))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-typed-member (class-name objects)
        (do
            (let type-parse (bml-source-parse-type objects))
            (let member-type (nth type-parse 0))
            (let after-type (nth type-parse 1))
            (let member-object (head after-type))
            (if (bml-source-token-value? member-object "operator")
                (do
                    (let op-token (nth after-type 1))
                    (bml-source-parse-method-after-name
                        class-name
                        member-type
                        (str_concat "operator" (bmf-object-value op-token))
                        (drop 2 after-type)))
            (if (bml-source-name-token? member-object)
                (do
                    (let member-name (bmf-object-value member-object))
                    (let after-name (tail after-type))
                    (if (bml-source-token-value? (head after-name) "(")
                        (bml-source-parse-method-after-name
                            class-name
                            member-type
                            member-name
                            after-name)
                        (bml-source-parse-field-after-name
                            member-type
                            member-name
                            after-name)))
                (bml-source-parse-step false "" (empty) objects)))))

    (defn bml-source-parse-constructor (class-name objects)
        (if (bml-source-token-value? (head objects) class-name)
            (if (bml-source-token-value? (nth objects 1) "(")
                (do
                    (let parameter-parse
                        (bml-source-collect-balanced-paren (tail objects)))
                    (let parameters
                        (bml-source-parse-parameters (nth parameter-parse 0)))
                    (let after-parameters (nth parameter-parse 1))
                    (let properties-parse
                        (bml-source-properties-parse after-parameters))
                    (let properties (nth properties-parse 0))
                    (let after-properties (nth properties-parse 1))
                    (if (bml-source-token-value? (head after-properties) "{")
                        (do
                            (let body-parse
                                (bml-source-collect-balanced-brace
                                    after-properties))
                            (bml-source-parse-step
                                true
                                "file-class-constructor"
                                (comp-bml-component
                                    "Constructor"
                                    (list
                                        class-name
                                        properties
                                        (bml-source-body-source-from-tokens
                                            (nth body-parse 0))
                                        parameters))
                                (nth body-parse 1)))
                        (bml-source-parse-step false "" (empty) objects)))
                (bml-source-parse-step false "" (empty) objects))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-section (class-name objects)
        (if (bml-source-token-value? (head objects) "section")
            (do
                (let properties-parse
                    (bml-source-properties-parse (tail objects)))
                (let properties (nth properties-parse 0))
                (let after-properties (nth properties-parse 1))
                (if (bml-source-token-value? (head after-properties) "{")
                    (do
                        (let members
                            (bml-source-parse-class-members-until-close
                                class-name
                                (tail after-properties)))
                        (bml-source-parse-step
                            true
                            "file-class-section"
                            (comp-bml-component
                                "Section"
                                (list "" properties (nth members 0)))
                            (nth members 1)))
                    (bml-source-parse-step false "" (empty) objects)))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-syntax-section (objects)
        (if (bml-source-token-value? (head objects) "syntax")
            (if (bml-source-token-value? (nth objects 1) "[")
                (if (bml-source-name-token? (nth objects 2))
                    (if (bml-source-token-value? (nth objects 3) "]")
                        (if (bml-source-token-value? (nth objects 4) "{")
                            (do
                                (let body-parse
                                    (bml-source-collect-balanced-brace
                                        (drop 4 objects)))
                                (bml-source-parse-step
                                    true
                                    "file-class-syntax"
                                    (comp-bml-component
                                        "Syntax"
                                        (list
                                            (bmf-object-value (nth objects 2))
                                            (bml-source-token-values
                                                (nth body-parse 0))
                                            (empty)))
                                    (nth body-parse 1)))
                            (bml-source-parse-step false "" (empty) objects))
                        (bml-source-parse-step false "" (empty) objects))
                    (bml-source-parse-step false "" (empty) objects))
                (bml-source-parse-step false "" (empty) objects))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-class-member (class-name objects)
        (if (nil? objects)
            (bml-source-parse-step false "" (empty) objects)
            (if (bml-source-token-value? (head objects) "section")
                (bml-source-parse-section class-name objects)
            (if (bml-source-token-value? (head objects) "syntax")
                (bml-source-parse-syntax-section objects)
            (if (bml-source-token-value? (head objects) "const")
                (bml-source-parse-const objects)
                (do
                    (let constructor-step
                        (bml-source-parse-constructor class-name objects))
                    (if (bml-source-parse-step-ok? constructor-step)
                        constructor-step
                        (bml-source-parse-typed-member class-name objects))))))))

    (defn bml-source-parse-class-members-loop (class-name objects acc)
        (if (nil? objects)
            (reverse-list acc)
            (do
                (let step (bml-source-parse-class-member class-name objects))
                (if (bml-source-parse-step-ok? step)
                    (bml-source-parse-class-members-loop
                        class-name
                        (bml-source-parse-step-rest step)
                        (cons (bml-source-parse-step-node step) acc))
                    (bml-source-parse-class-members-loop
                        class-name
                        (tail objects)
                        acc)))))

    (defn bml-source-parse-class-members (class-name objects)
        (bml-source-parse-class-members-loop class-name objects (empty)))

    (defn bml-source-parse-class-members-until-close-loop (class-name objects acc)
        (if (nil? objects)
            (list (reverse-list acc) objects)
            (if (bml-source-token-value? (head objects) "}")
                (list (reverse-list acc) (tail objects))
                (do
                    (let step (bml-source-parse-class-member class-name objects))
                    (if (bml-source-parse-step-ok? step)
                        (bml-source-parse-class-members-until-close-loop
                            class-name
                            (bml-source-parse-step-rest step)
                            (cons (bml-source-parse-step-node step) acc))
                        (bml-source-parse-class-members-until-close-loop
                            class-name
                            (tail objects)
                            acc))))))

    (defn bml-source-parse-class-members-until-close (class-name objects)
        (bml-source-parse-class-members-until-close-loop
            class-name
            objects
            (empty)))

    (defn bml-source-name-in-list? (names name)
        (if (nil? names) false
            (if (str_eq (head names) name) true
                (bml-source-name-in-list? (tail names) name))))

    (defn bml-source-class-body-enabled? (name)
        (bml-source-name-in-list?
            (list
                "RuleProcess" "Rule" "BMF"
                "LanguageProfile" "CompilerStage" "GrammarCapsule"
                "LanguagePort" "CompilerFlow" "CompilerCompiler"
                "CompilerDeclaration" "CompilerSectionModel"
                "CompilerUnitModel" "BMLDeclarationLoweringStage"
                "BMLSourceLoweringFlow" "SelfHostingPlan"
                "BMLSourceDeclaration" "BMLParsedSourceParser"
                "BMLCompilerBootstrapImage" "BMLBootstrapRatchet"
                "BMLCompilerImageEmitter"
                "BMLSourceCarrier"
                "BMLCompilerDeclarationLoweringStage"
                "BMLCompilerSourceLoweringFlow"
                "KernelCorePrimitive" "KernelCoreImage"
                "KernelCoreSelf"
                "CSharpLanguage" "JavaLanguage" "TypeScriptLanguage"
                "GoLanguage" "RustLanguage" "BMLLanguage"
                "ModernBMLCompiler")
            name))

    (defn bml-source-interface-body-enabled? (name)
        (bml-source-name-in-list?
            (list
                "BMLSourceParser"
                "KernelCoreObservable")
            name))

    (defn bml-source-direct-class-parser? (objects)
        (if (bml-source-token-value? (head objects) "class")
            (do
                (let name (bmf-object-value (nth objects 1)))
                (if (str_eq name "RuleProcess") true
                    (if (str_eq name "Rule") true
                        (str_eq name "BMF"))))
            false))

    (defn bml-source-final-companion-shell-class? (name)
        (str_eq name "BMF"))

    (defn bml-source-class-shell-rest (name body-start)
        (if (bml-source-final-companion-shell-class? name)
            (empty)
            (bml-source-skip-class-body body-start)))

    (defn bml-source-class-shell-rule-name (name)
        (if (bml-source-final-companion-shell-class? name)
            "file-class-eof-shell"
            "file-class-balanced-shell"))

    (defn bml-source-parse-class-body-component (class-name properties supers body-start)
        (do
            (let members
                (bml-source-parse-class-members-until-close
                    class-name
                    (tail body-start)))
            (bml-source-parse-step
                true
                "file-class-body"
                (comp-bml-component
                    "Class"
                    (list
                        class-name
                        properties
                        supers
                        (nth members 0)))
                (nth members 1))))

    (defn bml-source-parse-class-shell-component (class-name properties supers body-start)
        (bml-source-parse-step
            true
            (bml-source-class-shell-rule-name class-name)
            (comp-bml-component
                "Class"
                (list
                    class-name
                    properties
                    supers
                    (empty)))
            (bml-source-class-shell-rest class-name body-start)))

    (defn bml-source-parse-balanced-class-shell (objects)
        (if (bml-source-token-value? (head objects) "class")
            (do
                (let name-object (nth objects 1))
                (if (bml-source-name-token? name-object)
                    (do
                        (let class-name (bmf-object-value name-object))
                        (let property-parse (bml-source-class-property-parse (drop 2 objects)))
                        (let properties (nth property-parse 0))
                        (let after-properties (nth property-parse 1))
                        (let super-parse (bml-source-class-supers-parse after-properties))
                        (let supers (nth super-parse 0))
                        (let body-start (nth super-parse 1))
                        (if (bml-source-token-value? (head body-start) "{")
                            (if (bml-source-class-body-enabled? class-name)
                                (bml-source-parse-class-body-component
                                    class-name
                                    properties
                                    supers
                                    body-start)
                                (bml-source-parse-class-shell-component
                                    class-name
                                    properties
                                    supers
                                    body-start))
                            (bml-source-parse-step false "" (empty) objects)))
                    (bml-source-parse-step false "" (empty) objects)))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-interface-parent-parse (objects)
        (if (bml-source-token-value? (head objects) ":")
            (do
                (let parent-parse (bml-source-parse-type (tail objects)))
                (list (nth parent-parse 0) (nth parent-parse 1)))
            (list "" objects)))

    (defn bml-source-parse-balanced-interface-shell (objects)
        (if (bml-source-token-value? (head objects) "interface")
            (do
                (let name-object (nth objects 1))
                (if (bml-source-name-token? name-object)
                    (do
                        (let interface-name (bmf-object-value name-object))
                        (let property-parse
                            (bml-source-class-property-parse (drop 2 objects)))
                        (let properties (nth property-parse 0))
                        (let after-properties (nth property-parse 1))
                        (let parent-parse
                            (bml-source-interface-parent-parse after-properties))
                        (let parent (nth parent-parse 0))
                        (let body-start (nth parent-parse 1))
                        (if (bml-source-token-value? (head body-start) "{")
                            (if (bml-source-interface-body-enabled? interface-name)
                                (do
                                    (let members
                                        (bml-source-parse-class-members-until-close
                                            interface-name
                                            (tail body-start)))
                                    (bml-source-parse-step
                                        true
                                        "file-interface-body"
                                        (comp-bml-component
                                            "Interface"
                                            (list
                                                interface-name
                                                properties
                                                parent
                                                (nth members 0)))
                                        (nth members 1)))
                                (bml-source-parse-step
                                    true
                                    "file-interface-balanced-shell"
                                    (comp-bml-component
                                        "Interface"
                                        (list
                                            interface-name
                                            properties
                                            parent
                                            (empty)))
                                    (bml-source-skip-class-body body-start)))
                            (bml-source-parse-step false "" (empty) objects)))
                    (bml-source-parse-step false "" (empty) objects)))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-template-parameter-name? (object)
        (if (bml-source-name-token? object)
            (not (str_eq (bmf-object-value object) "Object"))
            false))

    (defn bml-source-template-parameter-names-loop (objects acc)
        (if (nil? objects)
            (reverse-list acc)
            (if (bml-source-template-parameter-name? (head objects))
                (bml-source-template-parameter-names-loop
                    (tail objects)
                    (cons (bmf-object-value (head objects)) acc))
                (bml-source-template-parameter-names-loop
                    (tail objects)
                    acc))))

    (defn bml-source-template-parameter-names (objects)
        (bml-source-template-parameter-names-loop objects (empty)))

    (defn bml-source-template-parameters-parse (objects)
        (if (bml-source-token-value? (head objects) "template")
            (if (bml-source-token-value? (nth objects 1) "<")
                (do
                    (let params-parse
                        (bml-source-collect-angle-loop (drop 2 objects) 1 (empty)))
                    (list
                        (bml-source-template-parameter-names (nth params-parse 0))
                        (nth params-parse 1)))
                (list (empty) objects))
            (list (empty) objects)))

    (defn bml-source-template-body-step (objects)
        (if (bml-source-token-value? (head objects) "class")
            (bml-source-parse-balanced-class-shell objects)
            (if (bml-source-token-value? (head objects) "interface")
                (bml-source-parse-balanced-interface-shell objects)
                (bml-source-parse-step false "" (empty) objects))))

    (defn bml-source-template-kind-from-node (node)
        (if (bml-component-kind? node "Class") "class"
            (if (bml-component-kind? node "Interface") "interface"
                "")))

    (defn bml-source-parse-template-declaration (objects)
        (if (bml-source-token-value? (head objects) "template")
            (do
                (let params-parse
                    (bml-source-template-parameters-parse objects))
                (let body-step
                    (bml-source-template-body-step (nth params-parse 1)))
                (if (bml-source-parse-step-ok? body-step)
                    (bml-source-parse-step
                        true
                        "file-template-shell"
                        (comp-bml-component
                            "Template"
                            (list
                                (nth params-parse 0)
                                (bml-source-template-kind-from-node
                                    (bml-source-parse-step-node body-step))
                                (list (bml-source-parse-step-node body-step))))
                        (bml-source-parse-step-rest body-step))
                    (bml-source-parse-step false "" (empty) objects)))
            (bml-source-parse-step false "" (empty) objects)))

    (defn bml-source-parse-executable-step (objects)
        (do
            (let step
                (bml-source-parse-indexed-step
                    objects
                    bml-source-executable-rule-index))
            (if (bml-source-parse-step-ok? step)
                step
                (bml-ctl-parse-general objects))))

    ;; --- general executable statements -------------------------------
    ;; A fixed rulebook shape answers first and keeps its rule name. A
    ;; statement no fixed shape reads is read here: a nested block, a
    ;; method with a statement-list body, a mutable local declaration, an
    ;; assignment, a const, or a return, over one small expression grammar
    ;; (literals, names, #( ) array literals, a[i] indexing, parentheses,
    ;; +). Declare, assign and index ride BML-AST-CALL under reserved
    ;; names, the home `this.f = N` already has in __hati_field_set, so no
    ;; category coordinate is minted for them.

    (defn bml-ast-local (local-type name value)
        (bml-ast-call-args
            "__bnml_declare"
            (list (bml-ast-string local-type) (bml-ast-string name) value)))

    (defn bml-ast-assign (name value)
        (bml-ast-call-args
            "__bnml_assign"
            (list (bml-ast-string name) value)))

    (defn bml-ast-index (target at)
        (bml-ast-call-args "__bml_index" (list target at)))

    ;; a CALL-shaped node whose first child is no string names no call
    (defn bml-call-named? (node name)
        (if (node_eq (node_category node) BML-AST-CALL)
            (if (eq (len (node_children node)) 2)
                (if (str_eq (value_kind (bml-call-name node)) "string")
                    (str_eq (bml-call-name node) name)
                    false)
                false)
            false))

    (defn bml-bnml-declare-node? (node)
        (bml-call-named? node "__bnml_declare"))

    (defn bml-bnml-assign-node? (node)
        (bml-call-named? node "__bnml_assign"))

    (defn bml-index-node? (node)
        (bml-call-named? node "__bml_index"))

    (defn bml-bnml-target-name (node)
        (do
            (let args (bml-call-args node))
            (node_value
                (bml-node-child
                    (if (bml-bnml-declare-node? node) (nth args 1) (head args))
                    0))))

    (defn bml-bnml-value (node)
        (do
            (let args (bml-call-args node))
            (if (bml-bnml-declare-node? node) (nth args 2) (nth args 1))))

    (defn bml-index-target (node)
        (head (bml-call-args node)))

    (defn bml-index-at (node)
        (nth (bml-call-args node) 1))

    (defn bml-ast-list-set (target at value)
        (bml-ast-call-args "__bml_list_set" (list target at value)))

    (defn bml-list-set-node? (node)
        (bml-call-named? node "__bml_list_set"))

    (defn bml-list-set-value (node)
        (nth (bml-call-args node) 2))

    (defn bml-index-base (node)
        (if (bml-index-node? node)
            (bml-index-base (bml-index-target node))
            node))

    ;; The whole array an index chain's assignment leaves: set(a, i, v)
    ;; for a[i] = v, set(a, i, set(a[i], j, v)) for a[i][j] = v.
    (defn bml-index-set-value (target value)
        (if (bml-index-node? target)
            (bml-index-set-value
                (bml-index-target target)
                (bml-ast-list-set
                    (bml-index-target target)
                    (bml-index-at target)
                    value))
            value))

    (defn bml-expr-result (ok node rest)
        (list "bml-expr-result" ok node rest))

    (defn bml-expr-ok? (result) (nth result 1))
    (defn bml-expr-node (result) (nth result 2))
    (defn bml-expr-rest (result) (nth result 3))

    (defn bml-expr-fail (objects)
        (bml-expr-result false (empty) objects))

    (defn bml-source-token-at? (objects index value)
        (bml-source-token-value? (head (drop index objects)) value))

    (defn bml-source-name-kind-token? (object)
        (if (nil? object) false
            (str_eq (bmf-object-kind object) "bml-name")))

    (defn bml-source-parse-primary (objects)
        (if (nil? objects)
            (bml-expr-fail objects)
            (do
                (let object (head objects))
                (let kind (bmf-object-kind object))
                (let value (bmf-object-value object))
                (if (str_eq kind "bml-int")
                    (bml-expr-result true (bml-ast-int (bml-int-value value)) (tail objects))
                (if (str_eq kind "bml-float")
                    (bml-expr-result true (bml-ast-float-node (intern_trivial_float value)) (tail objects))
                (if (str_eq kind "bml-string")
                    (bml-expr-result true (bml-ast-string value) (tail objects))
                (if (str_eq kind "bml-char")
                    (bml-expr-result true (bml-ast-char value) (tail objects))
                (if (or (str_eq kind "bml-name") (str_eq kind "bml-property"))
                    (bml-source-parse-name-primary objects)
                (if (str_eq value "#(")
                    (bml-source-parse-array-literal (tail objects))
                (if (str_eq value "(")
                    (bml-source-parse-paren-expr (tail objects))
                    (bml-expr-fail objects)))))))))))

    (defn bml-source-parse-array-literal (objects)
        (if (bml-source-token-value? (head objects) ")")
            (bml-expr-result true (bml-ast-array (empty)) (tail objects))
            (bml-source-parse-array-items objects (empty))))

    (defn bml-source-parse-array-items (objects items)
        (do
            (let item (bml-source-parse-expr objects))
            (if (bml-expr-ok? item)
                (do
                    (let after (bml-expr-rest item))
                    (let acc (cons (bml-expr-node item) items))
                    (if (bml-source-token-value? (head after) ",")
                        (bml-source-parse-array-items (tail after) acc)
                    (if (bml-source-token-value? (head after) ")")
                        (bml-expr-result true (bml-ast-array (reverse-list acc)) (tail after))
                        (bml-expr-fail objects))))
                (bml-expr-fail objects))))

    (defn bml-source-parse-paren-expr (objects)
        (do
            (let inner (bml-source-parse-expr objects))
            (if (bml-expr-ok? inner)
                (if (bml-source-token-value? (head (bml-expr-rest inner)) ")")
                    (bml-expr-result true (bml-expr-node inner) (tail (bml-expr-rest inner)))
                    (bml-expr-fail objects))
                (bml-expr-fail objects))))

    ;; A name may be qualified (A.B.c, resolved through package and import
    ;; scope) and may call; each argument is an expression.
    (defn bml-source-parse-name-primary (objects)
        (do
            (let name-parse (bml-source-parse-path-name objects))
            (let name (nth name-parse 0))
            (let rest (nth name-parse 1))
            (if (bml-source-token-value? (head rest) "(")
                (if (bml-source-token-value? (nth rest 1) ")")
                    (bml-expr-result
                        true
                        (bml-source-call-node name (empty))
                        (drop 2 rest))
                    (bml-source-parse-call-args name (tail rest) (empty)))
                (bml-expr-result true (bml-ctl-name-node name) rest))))

    (defn bml-source-parse-call-args (name objects args)
        (do
            (let arg (bml-source-parse-expr objects))
            (if (bml-expr-ok? arg)
                (do
                    (let after (bml-expr-rest arg))
                    (let acc (cons (bml-expr-node arg) args))
                    (if (bml-source-token-value? (head after) ",")
                        (bml-source-parse-call-args name (tail after) acc)
                    (if (bml-source-token-value? (head after) ")")
                        (bml-expr-result
                            true
                            (bml-source-call-node name (reverse-list acc))
                            (tail after))
                        (bml-expr-fail objects))))
                (bml-expr-fail objects))))

    ;; One non-array argument keeps the single-argument call shape; zero,
    ;; several, or one array argument travel inside an argument array,
    ;; which bml-call-args unpacks.
    (defn bml-source-call-node (name args)
        (if (eq (len args) 1)
            (if (node_eq (node_category (head args)) BML-AST-ARRAY)
                (bml-ast-call-args name args)
                (bml-ast-call name (head args)))
            (bml-ast-call-args name args)))

    (defn bml-source-parse-postfix (objects)
        (do
            (let primary (bml-source-parse-primary objects))
            (if (bml-expr-ok? primary)
                (bml-source-parse-index-tail
                    (bml-expr-node primary)
                    (bml-expr-rest primary))
                primary)))

    (defn bml-source-parse-index-tail (node objects)
        (if (bml-source-token-value? (head objects) "[")
            (do
                (let at (bml-source-parse-expr (tail objects)))
                (if (bml-expr-ok? at)
                    (if (bml-source-token-value? (head (bml-expr-rest at)) "]")
                        (bml-source-parse-index-tail
                            (bml-ast-index node (bml-expr-node at))
                            (tail (bml-expr-rest at)))
                        (bml-expr-fail objects))
                    (bml-expr-fail objects)))
            (bml-expr-result true node objects)))

    ; one expression grammar: unary ! and -, then BML's operator rules by
    ; precedence (op-or, op-and, op-eq/op-ne, op-lt/le/gt/ge, op-add/op-sub,
    ; op-mul), each left-associative, over postfix operands
    (defn bml-source-parse-expr (objects)
        (bml-ctl-parse-binary objects 1))

    (defn bml-source-parse-expr-semicolon (objects)
        (do
            (let parsed (bml-source-parse-expr objects))
            (if (bml-expr-ok? parsed)
                (if (bml-source-token-value? (head (bml-expr-rest parsed)) ";")
                    (bml-expr-result
                        true
                        (bml-expr-node parsed)
                        (tail (bml-expr-rest parsed)))
                    (bml-expr-fail objects))
                (bml-expr-fail objects))))

    (defn bml-source-parse-no-step (objects)
        (bml-source-parse-step false "" (empty) objects))

    (defn bml-source-parse-general-step (objects)
        (if (nil? objects)
            (bml-source-parse-no-step objects)
        (if (bml-source-token-value? (head objects) "{")
            (bml-source-parse-block-step objects)
        (if (bml-source-token-value? (head objects) "return")
            (bml-source-parse-return-expr-step objects)
        (if (bml-source-token-value? (head objects) "const")
            (bml-source-parse-const-expr-step objects)
        (if (bml-source-token-value? (head objects) "package")
            (bml-source-scoped-package objects)
        (if (bml-source-token-value? (head objects) "import")
            (bml-source-scoped-import objects)
        (if (bml-source-name-kind-token? (head objects))
            (bml-source-parse-name-led-step objects)
            (bml-source-parse-no-step objects)))))))))

    (defn bml-source-parse-statements-until-close (objects nodes)
        (if (nil? objects)
            (list false (reverse-list nodes) objects)
        (if (bml-source-token-value? (head objects) "}")
            (list true (reverse-list nodes) (tail objects))
            (do
                (let step (bml-source-parse-executable-step objects))
                (if (bml-source-parse-step-ok? step)
                    (bml-source-parse-statements-until-close
                        (bml-source-parse-step-rest step)
                        (cons (bml-source-parse-step-node step) nodes))
                    (list false (reverse-list nodes) objects))))))

    (defn bml-source-parse-block-step (objects)
        (do
            (let body
                (bml-source-parse-statements-until-close (tail objects) (empty)))
            (if (head body)
                (bml-source-parse-step
                    true
                    "block"
                    (bml-ast-block (nth body 1))
                    (nth body 2))
                (bml-source-parse-no-step objects))))

    (defn bml-source-parse-return-expr-step (objects)
        (do
            (let value (bml-source-parse-expr-semicolon (tail objects)))
            (if (bml-expr-ok? value)
                (bml-source-parse-step
                    true
                    "return-expr"
                    (bml-ast-return (bml-expr-node value))
                    (bml-expr-rest value))
                (bml-source-parse-no-step objects))))

    (defn bml-source-local-head? (objects)
        (if (bml-source-name-kind-token? (head objects))
            (bml-source-token-at? objects 1 "=")
            false))

    (defn bml-source-method-head? (objects)
        (if (bml-source-name-kind-token? (head objects))
            (bml-source-token-at? objects 1 "(")
            false))

    (defn bml-source-parse-const-expr-step (objects)
        (do
            (let type-parse (bml-source-parse-type (tail objects)))
            (let after-type (nth type-parse 1))
            (if (bml-source-local-head? after-type)
                (do
                    (let value
                        (bml-source-parse-expr-semicolon (drop 2 after-type)))
                    (if (bml-expr-ok? value)
                        (bml-source-parse-step
                            true
                            "const-expr"
                            (bml-ast-const
                                (nth type-parse 0)
                                (bmf-object-value (head after-type))
                                (bml-expr-node value))
                            (bml-expr-rest value))
                        (bml-source-parse-no-step objects)))
                (bml-source-parse-no-step objects))))

    (defn bml-source-parse-name-led-step (objects)
        (if (bml-source-assign-head? objects)
            (bml-source-parse-assign-step objects)
            (do
                (let type-parse (bml-source-parse-type objects))
                (let after-type (nth type-parse 1))
                (if (bml-source-local-head? after-type)
                    (bml-source-parse-local-step
                        (nth type-parse 0)
                        after-type
                        objects)
                (if (bml-source-method-head? after-type)
                    (bml-source-parse-method-body-step after-type objects)
                    (bml-source-parse-no-step objects))))))

    ;; NAME "=", or NAME "[" that opens no array type (int[] x), heads an
    ;; assignment.
    (defn bml-source-assign-head? (objects)
        (if (bml-source-token-at? objects 1 "=")
            true
            (if (bml-source-token-at? objects 1 "[")
                (not (bml-source-token-at? objects 2 "]"))
                false)))

    (defn bml-source-parse-assign-step (objects)
        (if (bml-source-token-at? objects 1 "[")
            (bml-source-parse-index-assign-step objects)
            (do
                (let value (bml-source-parse-expr-semicolon (drop 2 objects)))
                (if (bml-expr-ok? value)
                    (bml-source-parse-step
                        true
                        "assign"
                        (bml-ast-assign
                            (bmf-object-value (head objects))
                            (bml-expr-node value))
                        (bml-expr-rest value))
                    (bml-source-parse-no-step objects)))))

    (defn bml-source-index-assign-head? (target)
        (if (bml-expr-ok? target)
            (if (bml-index-node? (bml-expr-node target))
                (if (node_eq
                        (node_category (bml-index-base (bml-expr-node target)))
                        BML-AST-NAME)
                    (bml-source-token-value? (head (bml-expr-rest target)) "=")
                    false)
                false)
            false))

    ;; a[i] = v; reads as a = a with element i set, so declare, assign and
    ;; the frame keep one home; an index chain sets its innermost element.
    (defn bml-source-parse-index-assign-step (objects)
        (do
            (let target (bml-source-parse-postfix objects))
            (if (bml-source-index-assign-head? target)
                (do
                    (let value
                        (bml-source-parse-expr-semicolon (tail (bml-expr-rest target))))
                    (if (bml-expr-ok? value)
                        (bml-source-parse-step
                            true
                            "index-assign"
                            (bml-ast-assign
                                (bml-local-name (bml-index-base (bml-expr-node target)))
                                (bml-index-set-value
                                    (bml-expr-node target)
                                    (bml-expr-node value)))
                            (bml-expr-rest value))
                        (bml-source-parse-no-step objects)))
                (bml-source-parse-no-step objects))))

    (defn bml-source-parse-local-step (local-type after-type objects)
        (do
            (let value (bml-source-parse-expr-semicolon (drop 2 after-type)))
            (if (bml-expr-ok? value)
                (bml-source-parse-step
                    true
                    "local-decl"
                    (bml-ast-local
                        local-type
                        (bmf-object-value (head after-type))
                        (bml-expr-node value))
                    (bml-expr-rest value))
                (bml-source-parse-no-step objects))))

    (defn bml-source-split-at-close-paren (objects acc)
        (if (nil? objects)
            (list false (reverse-list acc) objects)
            (if (bml-source-token-value? (head objects) ")")
                (list true (reverse-list acc) (tail objects))
                (bml-source-split-at-close-paren
                    (tail objects)
                    (cons (head objects) acc)))))

    ;; any parameter count, through the shared parameter parser; a list
    ;; whose parameters do not all parse does not make a method.
    (defn bml-source-parse-method-body-step (after-type objects)
        (do
            (let split
                (bml-source-split-at-close-paren (drop 2 after-type) (empty)))
            (let after-params (nth split 2))
            (let parameters (bml-source-parse-parameters (nth split 1)))
            (if (if (head split)
                    (if (bml-source-token-value? (head after-params) "{")
                        (eq (len parameters)
                            (bml-source-scoped-parameter-count (nth split 1)))
                        false)
                    false)
                (do
                    (let body
                        (bml-source-parse-statements-until-close
                            (tail after-params)
                            (empty)))
                    (if (head body)
                        (bml-source-parse-step
                            true
                            "method-body"
                            (bml-ast-method-with-parameters
                                (bmf-object-value (head after-type))
                                (bml-ast-block (nth body 1))
                                parameters)
                            (nth body 2))
                        (bml-source-parse-no-step objects)))
                (bml-source-parse-no-step objects))))

    (defn bml-source-exec-parse-result (ok nodes rest rules)
        (list "bml-source-exec-parse-result" ok nodes rest rules))

    (defn bml-source-exec-parse-ok? (result) (nth result 1))
    (defn bml-source-exec-parse-nodes (result) (nth result 2))
    (defn bml-source-exec-parse-rest (result) (nth result 3))
    (defn bml-source-exec-parse-rules (result) (nth result 4))
    (defn bml-source-exec-parse-node (result)
        (bml-ast-block (bml-source-exec-parse-nodes result)))

    (defn bml-source-parse-executable-stream-loop (objects nodes rules)
        (if (nil? objects)
            (bml-source-exec-parse-result
                true
                (reverse-list nodes)
                objects
                (reverse-list rules))
            (do
                (let step (bml-source-parse-executable-step objects))
                (if (bml-source-parse-step-ok? step)
                    (bml-source-parse-executable-stream-loop
                        (bml-source-parse-step-rest step)
                        (cons (bml-source-parse-step-node step) nodes)
                        (cons (bml-source-parse-step-rule step) rules))
                    (bml-source-exec-parse-result
                        false
                        (reverse-list nodes)
                        objects
                        (reverse-list rules))))))

    (defn bml-source-parse-executable-stream (objects)
        (bml-source-parse-executable-stream-loop
            objects
            (empty)
            (empty)))

    (defn bml-source-file-parse-executable (path)
        (bml-source-parse-executable-stream (bml-source-scan-file path)))

    (defn bml-source-file-compile-executable (path)
        (bml-compile-program
            (bml-source-exec-parse-node
                (bml-source-file-parse-executable path))))

    ;; --- source control statements ----------------------------------
    ;; The general driver reads blocks, locals, assignment, const, return
    ;; and methods. Control reads here first: if/else, while, for, loop,
    ;; switch, labeled loops, break/continue, throw and try/catch; after
    ;; the driver declines, the forms it leaves (this.f = e, x++ and x op= e,
    ;; a call as a statement) read here too. The one expression grammar
    ;; climbs BML's own operator rules (op-or .. op-mul); each operator but
    ;; op-add is a reserved __bml_op-* method call, the __hati_* idiom, so
    ;; no category is minted.

    (defn bml-ast-if (test-node then-node else-node)
        (intern_node BML-AST-IF (list test-node then-node else-node)))

    (defn bml-ast-while (test-node body label)
        (intern_node BML-AST-WHILE
                     (list test-node body (intern_trivial_string label))))

    (defn bml-ast-for (label init test-node update body)
        (intern_node BML-AST-FOR
                     (list (intern_trivial_string label) init test-node update body)))

    (defn bml-ast-loop (label body)
        (bml-ast-for label (bml-ast-block (empty)) (bml-ast-int 1)
                     (bml-ast-block (empty)) body))

    ; a catch parameter is a bnml local declared from the thrown value
    (defn bml-ast-try-catch (body handler catch-decl)
        (intern_node BML-AST-TRY (list body handler catch-decl)))

    (defn bml-ast-thrown (_x)
        (bml-ast-call "__bml_thrown" (bml-ast-int 0)))

    (defn bml-ast-switch (label scrutinee clauses)
        (bml-ast-call-args
            "__bml_switch"
            (list scrutinee (bml-ast-array clauses) (bml-ast-string label))))

    (defn bml-ast-switch-clause (value default-clause stmts)
        (if default-clause
            (bml-ast-call "__bml_default" (bml-ast-block stmts))
            (bml-ast-call-args "__bml_case" (list value (bml-ast-block stmts)))))

    (defn bml-ctl-step (rule node rest)
        (bml-source-parse-step true rule node rest))

    (defn bml-ctl-token-is? (object kind value)
        (if (nil? object)
            false
            (if (str_eq (bmf-object-kind object) kind)
                (str_eq (bmf-object-value object) value)
                false)))

    (defn bml-ctl-op? (object value)
        (bml-ctl-token-is? object "bml-op" value))

    (defn bml-ctl-keyword? (object value)
        (bml-ctl-token-is? object "bml-keyword" value))

    (defn bml-ctl-plain-name? (object)
        (if (nil? object)
            false
            (str_eq (bmf-object-kind object) "bml-name")))

    ; a label is a name in its own namespace; BML's lexicon also lists
    ; words such as `outer` as properties, and those read as labels too
    (defn bml-ctl-label-token? (object)
        (if (bml-ctl-plain-name? object)
            true
            (bml-source-property-token? object)))

    (defn bml-ctl-second (objects)
        (if (nil? objects)
            (empty)
            (if (nil? (tail objects)) (empty) (head (tail objects)))))

    (defn bml-ctl-third (objects)
        (if (nil? objects) (empty) (bml-ctl-second (tail objects))))

    (defn bml-ctl-op-rule (value)
        (if (str_eq value "||") "op-or"
        (if (str_eq value "&&") "op-and"
        (if (str_eq value "==") "op-eq"
        (if (str_eq value "!=") "op-ne"
        (if (str_eq value "<") "op-lt"
        (if (str_eq value "<=") "op-le"
        (if (str_eq value ">") "op-gt"
        (if (str_eq value ">=") "op-ge"
        (if (str_eq value "+") "op-add"
        (if (str_eq value "-") "op-sub"
        (if (str_eq value "*") "op-mul"
            ""))))))))))))

    (defn bml-ctl-op-prec (rule)
        (if (str_eq rule "op-or") 1
        (if (str_eq rule "op-and") 2
        (if (str_eq rule "op-eq") 3
        (if (str_eq rule "op-ne") 3
        (if (str_eq rule "op-lt") 4
        (if (str_eq rule "op-le") 4
        (if (str_eq rule "op-gt") 4
        (if (str_eq rule "op-ge") 4
        (if (str_eq rule "op-add") 5
        (if (str_eq rule "op-sub") 5
        (if (str_eq rule "op-mul") 6
            0))))))))))))

    (defn bml-ctl-head-op-rule (objects)
        (if (nil? objects)
            ""
            (if (str_eq (bmf-object-kind (head objects)) "bml-op")
                (bml-ctl-op-rule (bmf-object-value (head objects)))
                "")))

    (defn bml-ctl-op-call-name (rule)
        (str_concat "__bml_" rule))

    (defn bml-ast-op (rule args)
        (if (str_eq rule "op-add")
            (bml-ast-add (head args) (head (tail args)))
            (bml-ast-call-args (bml-ctl-op-call-name rule) args)))

    (defn bml-ctl-parse-binary (objects min-prec)
        (do
            (let left (bml-ctl-parse-unary objects))
            (if (bml-expr-ok? left)
                (bml-ctl-parse-binary-loop
                    (bml-expr-node left)
                    (bml-expr-rest left)
                    min-prec)
                left)))

    (defn bml-ctl-parse-binary-loop (left objects min-prec)
        (do
            (let rule (bml-ctl-head-op-rule objects))
            (let prec (bml-ctl-op-prec rule))
            (if (eq prec 0)
                (bml-expr-result true left objects)
            (if (lt prec min-prec)
                (bml-expr-result true left objects)
                (bml-ctl-parse-binary-right
                    rule
                    left
                    (bml-ctl-parse-binary (tail objects) (add prec 1))
                    min-prec)))))

    (defn bml-ctl-parse-binary-right (rule left right min-prec)
        (if (bml-expr-ok? right)
            (bml-ctl-parse-binary-loop
                (bml-ast-op rule (list left (bml-expr-node right)))
                (bml-expr-rest right)
                min-prec)
            right))

    (defn bml-ctl-parse-unary (objects)
        (if (bml-ctl-op? (head objects) "!")
            (bml-ctl-expr-unary "op-not" (bml-ctl-parse-unary (tail objects)))
        (if (bml-ctl-op? (head objects) "-")
            (bml-ctl-expr-unary "op-neg" (bml-ctl-parse-unary (tail objects)))
            (bml-source-parse-postfix objects))))

    (defn bml-ctl-expr-unary (rule result)
        (if (bml-expr-ok? result)
            (bml-expr-result
                true
                (bml-ast-op rule (list (bml-expr-node result)))
                (bml-expr-rest result))
            result))

    (defn bml-ctl-expr-before (result value)
        (if (bml-expr-ok? result)
            (if (bml-ctl-op? (head (bml-expr-rest result)) value)
                (bml-expr-result true (bml-expr-node result) (tail (bml-expr-rest result)))
                (bml-expr-fail (bml-expr-rest result)))
            result))

    ; this.f in an expression reads record-backed self
    (defn bml-ctl-name-node (name)
        (if (bml-ctl-str-prefix? name "this.")
            (bml-ast-this-field (substring name 5 (str_len name)))
            (bml-ast-name name)))

    (defn bml-ctl-control-keyword? (object)
        (if (bml-ctl-keyword? object "if") true
        (if (bml-ctl-keyword? object "while") true
        (if (bml-ctl-keyword? object "for") true
        (if (bml-ctl-keyword? object "loop") true
        (if (bml-ctl-keyword? object "switch") true
        (if (bml-ctl-keyword? object "break") true
        (if (bml-ctl-keyword? object "continue") true
        (if (bml-ctl-keyword? object "throw") true
            (bml-ctl-keyword? object "try"))))))))))

    (defn bml-ctl-statement-head? (objects)
        (if (bml-ctl-control-keyword? (head objects))
            true
            (bml-ctl-labeled? objects)))

    (defn bml-ctl-parse-general (objects)
        (if (bml-ctl-statement-head? objects)
            (bml-ctl-parse-statement objects)
            (bml-ctl-parse-after-general (bml-source-parse-general-step objects) objects)))

    (defn bml-ctl-parse-after-general (step objects)
        (if (bml-source-parse-step-ok? step)
            step
            (bml-ctl-parse-simple objects)))

    (defn bml-ctl-parse-statement (objects)
        (do
            (let object (head objects))
            (if (bml-ctl-keyword? object "if")
                (bml-ctl-parse-if (tail objects))
            (if (bml-ctl-keyword? object "while")
                (bml-ctl-parse-while "" (tail objects))
            (if (bml-ctl-keyword? object "for")
                (bml-ctl-parse-for "" (tail objects))
            (if (bml-ctl-keyword? object "loop")
                (bml-ctl-parse-loop "" (tail objects))
            (if (bml-ctl-keyword? object "switch")
                (bml-ctl-parse-switch "" (tail objects))
            (if (bml-ctl-keyword? object "break")
                (bml-ctl-parse-jump "break" (tail objects))
            (if (bml-ctl-keyword? object "continue")
                (bml-ctl-parse-jump "continue" (tail objects))
            (if (bml-ctl-keyword? object "throw")
                (bml-ctl-parse-throw (tail objects))
            (if (bml-ctl-keyword? object "try")
                (bml-ctl-parse-try (tail objects))
                (bml-ctl-parse-labeled objects))))))))))))

    (defn bml-ctl-parse-condition (objects)
        (if (bml-ctl-op? (head objects) "(")
            (bml-ctl-expr-before (bml-source-parse-expr (tail objects)) ")")
            (bml-expr-fail objects)))

    (defn bml-ctl-parse-if (objects)
        (bml-ctl-parse-if-test (bml-ctl-parse-condition objects) objects))

    (defn bml-ctl-parse-if-test (test objects)
        (if (bml-expr-ok? test)
            (bml-ctl-parse-if-then
                (bml-expr-node test)
                (bml-source-parse-executable-step (bml-expr-rest test))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-if-then (test-node then-step objects)
        (if (bml-source-parse-step-ok? then-step)
            (bml-ctl-parse-if-else
                test-node
                (bml-source-parse-step-node then-step)
                (bml-source-parse-step-rest then-step)
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-if-else (test-node then-node after-then objects)
        (if (bml-ctl-keyword? (head after-then) "else")
            (bml-ctl-finish-if
                test-node
                then-node
                (bml-source-parse-executable-step (tail after-then))
                objects)
            (bml-ctl-step
                "control-if"
                (bml-ast-if test-node then-node (bml-ast-block (empty)))
                after-then)))

    (defn bml-ctl-finish-if (test-node then-node else-step objects)
        (if (bml-source-parse-step-ok? else-step)
            (bml-ctl-step
                "control-if"
                (bml-ast-if test-node then-node (bml-source-parse-step-node else-step))
                (bml-source-parse-step-rest else-step))
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-while (label objects)
        (bml-ctl-parse-while-test label (bml-ctl-parse-condition objects) objects))

    (defn bml-ctl-parse-while-test (label test objects)
        (if (bml-expr-ok? test)
            (bml-ctl-finish-while
                label
                (bml-expr-node test)
                (bml-source-parse-executable-step (bml-expr-rest test))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-finish-while (label test-node body-step objects)
        (if (bml-source-parse-step-ok? body-step)
            (bml-ctl-step
                "control-while"
                (bml-ast-while test-node (bml-source-parse-step-node body-step) label)
                (bml-source-parse-step-rest body-step))
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-loop (label objects)
        (bml-ctl-finish-loop label (bml-source-parse-executable-step objects) objects))

    (defn bml-ctl-finish-loop (label body-step objects)
        (if (bml-source-parse-step-ok? body-step)
            (bml-ctl-step
                "control-loop"
                (bml-ast-loop label (bml-source-parse-step-node body-step))
                (bml-source-parse-step-rest body-step))
            (bml-source-parse-no-step objects)))

    ; a for init is the driver's local declaration or assignment (its ";"
    ; included); the test ends at ";", the update at ")"
    (defn bml-ctl-parse-for-init (objects)
        (if (bml-ctl-op? (head objects) ";")
            (bml-ctl-step "for-init" (bml-ast-block (empty)) (tail objects))
            (if (bml-source-name-kind-token? (head objects))
                (bml-source-parse-name-led-step objects)
                (bml-source-parse-no-step objects))))

    (defn bml-ctl-parse-for-test (objects)
        (if (bml-ctl-op? (head objects) ";")
            (bml-expr-result true (bml-ast-int 1) (tail objects))
            (bml-ctl-expr-before (bml-source-parse-expr objects) ";")))

    (defn bml-ctl-parse-for-update (objects)
        (if (bml-ctl-op? (head objects) ")")
            (bml-expr-result true (bml-ast-block (empty)) (tail objects))
            (bml-ctl-expr-before (bml-ctl-parse-update objects) ")")))

    (defn bml-ctl-parse-for (label objects)
        (if (bml-ctl-op? (head objects) "(")
            (bml-ctl-parse-for-after-init
                label
                (bml-ctl-parse-for-init (tail objects))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-for-after-init (label init-step objects)
        (if (bml-source-parse-step-ok? init-step)
            (bml-ctl-parse-for-after-test
                label
                (bml-source-parse-step-node init-step)
                (bml-ctl-parse-for-test (bml-source-parse-step-rest init-step))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-for-after-test (label init test objects)
        (if (bml-expr-ok? test)
            (bml-ctl-parse-for-after-update
                label
                init
                (bml-expr-node test)
                (bml-ctl-parse-for-update (bml-expr-rest test))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-for-after-update (label init test-node update objects)
        (if (bml-expr-ok? update)
            (bml-ctl-finish-for
                label
                init
                test-node
                (bml-expr-node update)
                (bml-source-parse-executable-step (bml-expr-rest update))
                objects)
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-finish-for (label init test-node update-node body-step objects)
        (if (bml-source-parse-step-ok? body-step)
            (bml-ctl-step
                "control-for"
                (bml-ast-for label init test-node update-node
                             (bml-source-parse-step-node body-step))
                (bml-source-parse-step-rest body-step))
            (bml-source-parse-no-step objects)))

    ; x = e, x += e, x -= e, x *= e, x++, x-- as the driver's bnml assignment
    (defn bml-ctl-parse-update (objects)
        (if (bml-ctl-plain-name? (head objects))
            (bml-ctl-parse-update-op
                (bmf-object-value (head objects))
                (bml-ctl-second objects)
                (tail (tail objects))
                objects)
            (bml-expr-fail objects)))

    (defn bml-ctl-parse-update-op (name op-object after-op objects)
        (if (bml-ctl-op? op-object "=")
            (bml-ctl-expr-assign name "" (bml-source-parse-expr after-op))
        (if (bml-ctl-op? op-object "+=")
            (bml-ctl-expr-assign name "op-add" (bml-source-parse-expr after-op))
        (if (bml-ctl-op? op-object "-=")
            (bml-ctl-expr-assign name "op-sub" (bml-source-parse-expr after-op))
        (if (bml-ctl-op? op-object "*=")
            (bml-ctl-expr-assign name "op-mul" (bml-source-parse-expr after-op))
        (if (bml-ctl-op? op-object "++")
            (bml-ctl-expr-assign name "op-add" (bml-expr-result true (bml-ast-int 1) after-op))
        (if (bml-ctl-op? op-object "--")
            (bml-ctl-expr-assign name "op-sub" (bml-expr-result true (bml-ast-int 1) after-op))
            (bml-expr-fail objects))))))))

    (defn bml-ctl-expr-assign (name rule value)
        (if (bml-expr-ok? value)
            (bml-expr-result
                true
                (bml-ast-assign
                    name
                    (if (str_eq rule "")
                        (bml-expr-node value)
                        (bml-ast-op rule (list (bml-ast-name name) (bml-expr-node value)))))
                (bml-expr-rest value))
            value))

    (defn bml-ctl-parse-switch (label objects)
        (bml-ctl-parse-switch-open label (bml-ctl-parse-condition objects) objects))

    (defn bml-ctl-parse-switch-open (label scrutinee objects)
        (if (bml-expr-ok? scrutinee)
            (if (bml-ctl-op? (head (bml-expr-rest scrutinee)) "{")
                (bml-ctl-parse-switch-clauses
                    label
                    (bml-expr-node scrutinee)
                    (tail (bml-expr-rest scrutinee))
                    (empty))
                (bml-source-parse-no-step objects))
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-switch-clauses (label scrutinee objects clauses)
        (if (bml-ctl-op? (head objects) "}")
            (bml-ctl-step
                "control-switch"
                (bml-ast-switch label scrutinee (reverse-list clauses))
                (tail objects))
        (if (bml-ctl-keyword? (head objects) "case")
            (bml-ctl-parse-case-head
                label
                scrutinee
                (bml-ctl-expr-before (bml-source-parse-expr (tail objects)) ":")
                clauses)
        (if (bml-ctl-keyword? (head objects) "default")
            (if (bml-ctl-op? (bml-ctl-second objects) ":")
                (bml-ctl-parse-clause-body
                    label scrutinee (empty) true (tail (tail objects)) (empty) clauses)
                (bml-source-parse-no-step objects))
            (bml-source-parse-no-step objects)))))

    (defn bml-ctl-parse-case-head (label scrutinee value clauses)
        (if (bml-expr-ok? value)
            (bml-ctl-parse-clause-body
                label scrutinee (bml-expr-node value) false
                (bml-expr-rest value) (empty) clauses)
            (bml-source-parse-no-step (bml-expr-rest value))))

    (defn bml-ctl-clause-end? (objects)
        (if (nil? objects)
            true
        (if (bml-ctl-op? (head objects) "}")
            true
        (if (bml-ctl-keyword? (head objects) "case")
            true
            (bml-ctl-keyword? (head objects) "default")))))

    (defn bml-ctl-parse-clause-body (label scrutinee value default-clause objects stmts clauses)
        (if (bml-ctl-clause-end? objects)
            (bml-ctl-parse-switch-clauses
                label
                scrutinee
                objects
                (cons (bml-ast-switch-clause value default-clause (reverse-list stmts))
                      clauses))
            (bml-ctl-parse-clause-statement
                label scrutinee value default-clause
                (bml-source-parse-executable-step objects)
                stmts clauses)))

    (defn bml-ctl-parse-clause-statement (label scrutinee value default-clause step stmts clauses)
        (if (bml-source-parse-step-ok? step)
            (bml-ctl-parse-clause-body
                label scrutinee value default-clause
                (bml-source-parse-step-rest step)
                (cons (bml-source-parse-step-node step) stmts)
                clauses)
            (bml-source-parse-no-step (bml-source-parse-step-rest step))))

    (defn bml-ctl-parse-jump (kind objects)
        (if (bml-ctl-op? (head objects) ";")
            (bml-ctl-step (str_concat "control-" kind) (bml-ctl-jump-node kind "") (tail objects))
        (if (bml-ctl-label-token? (head objects))
            (if (bml-ctl-op? (bml-ctl-second objects) ";")
                (bml-ctl-step
                    (str_concat "control-" kind)
                    (bml-ctl-jump-node kind (bmf-object-value (head objects)))
                    (tail (tail objects)))
                (bml-source-parse-no-step objects))
            (bml-source-parse-no-step objects))))

    (defn bml-ctl-jump-node (kind label)
        (if (str_eq kind "break")
            (bml-ast-break label)
            (bml-ast-continue label)))

    (defn bml-ctl-parse-throw (objects)
        (bml-ctl-finish-throw
            (bml-ctl-expr-before (bml-source-parse-expr objects) ";")
            objects))

    (defn bml-ctl-finish-throw (value objects)
        (if (bml-expr-ok? value)
            (bml-ctl-step "control-throw" (bml-ast-throw (bml-expr-node value)) (bml-expr-rest value))
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-try (objects)
        (bml-ctl-parse-try-body (bml-source-parse-executable-step objects) objects))

    (defn bml-ctl-parse-try-body (body-step objects)
        (if (bml-source-parse-step-ok? body-step)
            (if (bml-ctl-keyword? (head (bml-source-parse-step-rest body-step)) "catch")
                (bml-ctl-parse-catch
                    (bml-source-parse-step-node body-step)
                    (tail (bml-source-parse-step-rest body-step)))
                (bml-source-parse-no-step objects))
            (bml-source-parse-no-step objects)))

    (defn bml-ctl-parse-catch (body objects)
        (if (bml-ctl-op? (head objects) "(")
            (bml-ctl-parse-catch-param body (bml-source-collect-balanced-paren objects))
            (bml-ctl-finish-try
                body
                (bml-ast-block (empty))
                (bml-source-parse-executable-step objects))))

    (defn bml-ctl-parse-catch-param (body collected)
        (bml-ctl-finish-try
            body
            (bml-ctl-catch-decl (nth collected 0))
            (bml-source-parse-executable-step (nth collected 1))))

    (defn bml-ctl-catch-decl (tokens)
        (if (nil? tokens)
            (bml-ast-block (empty))
            (bml-ast-local
                (if (nil? (tail tokens)) "" (bmf-object-value (head tokens)))
                (bml-ctl-last-name tokens)
                (bml-ast-thrown 0))))

    (defn bml-ctl-last-name (tokens)
        (if (nil? tokens)
            ""
            (if (nil? (tail tokens))
                (if (bml-ctl-plain-name? (head tokens)) (bmf-object-value (head tokens)) "")
                (bml-ctl-last-name (tail tokens)))))

    (defn bml-ctl-finish-try (body catch-decl handler-step)
        (if (bml-source-parse-step-ok? handler-step)
            (bml-ctl-step
                "control-try"
                (bml-ast-try-catch body (bml-source-parse-step-node handler-step) catch-decl)
                (bml-source-parse-step-rest handler-step))
            (bml-source-parse-no-step (bml-source-parse-step-rest handler-step))))

    (defn bml-ctl-label-target? (object)
        (if (bml-ctl-keyword? object "for")
            true
        (if (bml-ctl-keyword? object "while")
            true
        (if (bml-ctl-keyword? object "loop")
            true
            (bml-ctl-keyword? object "switch")))))

    (defn bml-ctl-labeled? (objects)
        (if (bml-ctl-label-token? (head objects))
            (if (bml-ctl-op? (bml-ctl-second objects) ":")
                (bml-ctl-label-target? (bml-ctl-third objects))
                false)
            false))

    (defn bml-ctl-parse-labeled (objects)
        (bml-ctl-parse-labeled-keyword
            (bmf-object-value (head objects))
            (bml-ctl-third objects)
            (tail (tail (tail objects)))))

    (defn bml-ctl-parse-labeled-keyword (label keyword-object after-keyword)
        (if (bml-ctl-keyword? keyword-object "for")
            (bml-ctl-parse-for label after-keyword)
        (if (bml-ctl-keyword? keyword-object "while")
            (bml-ctl-parse-while label after-keyword)
        (if (bml-ctl-keyword? keyword-object "loop")
            (bml-ctl-parse-loop label after-keyword)
            (bml-ctl-parse-switch label after-keyword)))))

    (defn bml-ctl-field-assignment? (objects)
        (if (bml-ctl-token-is? (head objects) "bml-name" "this")
            (if (bml-ctl-op? (bml-ctl-second objects) ".")
                (bml-ctl-op? (bml-ctl-second (tail (tail objects))) "=")
                false)
            false))

    (defn bml-ctl-parse-simple (objects)
        (if (bml-ctl-field-assignment? objects)
            (bml-ctl-finish-simple
                "control-field-assign"
                (bml-ctl-expr-field-set
                    (bmf-object-value (bml-ctl-third objects))
                    (bml-source-parse-expr (drop 4 objects)))
                objects)
            (bml-ctl-parse-simple-update (bml-ctl-parse-update objects) objects)))

    (defn bml-ctl-parse-simple-update (update objects)
        (if (bml-expr-ok? update)
            (bml-ctl-finish-simple "control-update" update objects)
            (bml-ctl-finish-simple "control-expression" (bml-source-parse-expr objects) objects)))

    (defn bml-ctl-expr-field-set (field value)
        (if (bml-expr-ok? value)
            (bml-expr-result
                true
                (bml-ast-this-field-set field (bml-expr-node value))
                (bml-expr-rest value))
            value))

    (defn bml-ctl-finish-simple (rule result objects)
        (bml-ctl-finish-simple-result rule (bml-ctl-expr-before result ";") objects))

    (defn bml-ctl-finish-simple-result (rule finished objects)
        (if (bml-expr-ok? finished)
            (bml-ctl-step rule (bml-expr-node finished) (bml-expr-rest finished))
            (bml-source-parse-no-step objects)))

    (defn bml-source-parse-declaration-step (objects)
        (if (bml-source-token-value? (head objects) "template")
            (bml-source-parse-template-declaration objects)
        (if (bml-source-direct-class-parser? objects)
            (bml-source-parse-balanced-class-shell objects)
            (do
                (let step
                    (bml-source-parse-indexed-step
                        objects
                        bml-source-declaration-rule-index))
                (if (bml-source-parse-step-ok? step)
                    step
                    (do
                        (let class-step
                            (bml-source-parse-balanced-class-shell objects))
                        (if (bml-source-parse-step-ok? class-step)
                            class-step
                            (bml-source-parse-balanced-interface-shell objects))))))))

    (defn bml-source-parse-declaration-stream-loop (objects nodes rules)
        (if (nil? objects)
            (bml-source-exec-parse-result
                true
                (reverse-list nodes)
                objects
                (reverse-list rules))
            (do
                (let step (bml-source-parse-declaration-step objects))
                (if (bml-source-parse-step-ok? step)
                    (bml-source-parse-declaration-stream-loop
                        (bml-source-parse-step-rest step)
                        (cons (bml-source-parse-step-node step) nodes)
                        (cons (bml-source-parse-step-rule step) rules))
                    (bml-source-exec-parse-result
                        false
                        (reverse-list nodes)
                        objects
                        (reverse-list rules))))))

    (defn bml-source-parse-declaration-stream (objects)
        (bml-source-parse-declaration-stream-loop
            objects
            (empty)
            (empty)))

    (defn bml-source-file-parse-declarations (path)
        (bml-source-parse-declaration-stream (bml-source-scan-file path)))

    (defn bml-source-declaration-model (result)
        (do
            (let nodes (bml-source-exec-parse-nodes result))
            (bml-model-with-scope
                (bml-components-of-kind nodes "Class")
                (bml-components-of-kind nodes "Interface")
                (bml-source-declaration-scope nodes))))

    (defn bml-thesis-bmf-primitive-rule-count-loop (rule-names)
        (if (nil? rule-names) 0
            (add
                (if (nil? (bml-bmf-find-rule (head rule-names) bml-bmf-rules)) 0 1)
                (bml-thesis-bmf-primitive-rule-count-loop (tail rule-names)))))

    (defn bml-thesis-bmf-primitive-rule-count (_x)
        (bml-thesis-bmf-primitive-rule-count-loop bml-thesis-bmf-primitive-rule-names))

    ;; --- native source sections -------------------------------------

    (let bml-bmf-section bml-bmf-second)

    (let bml-bmf-native-section
        (list
            (bmf-native "bml-emit-package-simple" bml-emit-package-simple BML-AST-PACKAGE)
            (bmf-native "bml-emit-import-simple" bml-emit-import-simple BML-AST-IMPORT)
            (bmf-native "bml-emit-import-star-simple" bml-emit-import-star-simple BML-AST-IMPORT)
            (bmf-native "bml-emit-class-header" bml-emit-class-header BML-AST-CLASS)
            (bmf-native "bml-emit-interface-header" bml-emit-interface-header BML-AST-INTERFACE)
            (bmf-native "bml-emit-section-header" bml-emit-section-header BML-AST-SECTION)
            (bmf-native "bml-emit-field" bml-emit-field BML-AST-FIELD)
            (bmf-native "bml-emit-const-int" bml-emit-const-int BML-AST-CONST)
            (bmf-native "bml-emit-return-int" bml-emit-return-int BML-AST-RETURN)
            (bmf-native "bml-emit-return-float" bml-emit-return-float BML-AST-RETURN)
            (bmf-native "bml-emit-return-char" bml-emit-return-char BML-AST-RETURN)
            (bmf-native "bml-emit-return-name" bml-emit-return-name BML-AST-RETURN)
            (bmf-native "bml-emit-return-name-add-int" bml-emit-return-name-add-int BML-AST-RETURN)
            (bmf-native "bml-emit-return-call-int" bml-emit-return-call-int BML-AST-RETURN)
            (bmf-native "bml-emit-return-call-two-int" bml-emit-return-call-two-int BML-AST-RETURN)
            (bmf-native "bml-emit-break-simple" bml-emit-break-simple BML-AST-BREAK)
            (bmf-native "bml-emit-continue-simple" bml-emit-continue-simple BML-AST-CONTINUE)
            (bmf-native "bml-emit-throw-int" bml-emit-throw-int BML-AST-THROW)
            (bmf-native "bml-emit-try-throw-return" bml-emit-try-throw-return BML-AST-TRY)
            (bmf-native "bml-emit-fail-simple" bml-emit-fail-simple BML-AST-FAIL)
            (bmf-native "bml-emit-cut-simple" bml-emit-cut-simple BML-AST-CUT)
            (bmf-native "bml-emit-mark-simple" bml-emit-mark-simple BML-AST-SAVE)
            (bmf-native "bml-emit-restore-simple" bml-emit-restore-simple BML-AST-RESTORE)
            (bmf-native "bml-emit-discard-simple" bml-emit-discard-simple BML-AST-DISCARD)
            (bmf-native "bml-emit-save-simple" bml-emit-save-simple BML-AST-SAVE)
            (bmf-native "bml-emit-char-lit" bml-emit-char-lit BML-AST-CHAR)
            (bmf-native "bml-emit-array-int" bml-emit-array-int BML-AST-ARRAY)
            (bmf-native "bml-emit-method-return-add" bml-emit-method-return-add BML-AST-METHOD)
            (bmf-native "bml-emit-method-param-return-add" bml-emit-method-param-return-add BML-AST-METHOD)
            (bmf-native "bml-emit-method-two-param-return-add" bml-emit-method-two-param-return-add BML-AST-METHOD)
            (bmf-native "bml-emit-method-return-this-field-add-int" bml-emit-method-return-this-field-add-int BML-AST-METHOD)
            (bmf-native "bml-emit-method-set-this-field-return" bml-emit-method-set-this-field-return BML-AST-METHOD)
            (bmf-native "bml-emit-class-field-method-return-this-field-add-int" bml-emit-class-field-method-return-this-field-add-int BML-AST-CLASS)
            (bmf-native "bml-emit-choose-fail-int" bml-emit-choose-fail-int BML-AST-CHOOSE)
            (bmf-native "bml-emit-if-fail-fail-return-int" bml-emit-if-fail-fail-return-int BML-AST-CHOOSE)
            (bmf-native "bml-emit-while-success-fail-return-int" bml-emit-while-success-fail-return-int BML-AST-WHILE)
            (bmf-native "bml-emit-state-int" bml-emit-state-int BML-AST-BLOCK)))

    (let bml-recipe-section
        (form-rule-recipe-section "bml"
            (list
                (compiler-rule "bml" "class-header" "BML class source objects" bml-emit-class-header)
                (compiler-rule "bml" "interface-header" "BML interface source objects" bml-emit-interface-header)
                (compiler-rule "bml" "package-simple" "BML package source objects" bml-emit-package-simple)
                (compiler-rule "bml" "import-simple" "BML import source objects" bml-emit-import-simple)
                (compiler-rule "bml" "section-header" "BML section source objects" bml-emit-section-header)
                (compiler-rule "bml" "return-int" "BML return object to BMA ops" bml-emit-return-int)
                (compiler-rule "bml" "return-float" "BML float return object to BMA ops" bml-emit-return-float)
                (compiler-rule "bml" "return-char" "BML char return object to BMA ops" bml-emit-return-char)
                (compiler-rule "bml" "return-name" "BML bound-name return object to BMA ops" bml-emit-return-name)
                (compiler-rule "bml" "return-name-add-int" "BML bound-name add return object to BMA ops" bml-emit-return-name-add-int)
                (compiler-rule "bml" "return-call-int" "BML known method call return object to BMA ops" bml-emit-return-call-int)
                (compiler-rule "bml" "return-call-two-int" "BML known two-argument method call return object to BMA ops" bml-emit-return-call-two-int)
                (compiler-rule "bml" "break-simple" "BML break object to BMA ops" bml-emit-break-simple)
                (compiler-rule "bml" "continue-simple" "BML continue object to BMA ops" bml-emit-continue-simple)
                (compiler-rule "bml" "throw-int" "BML throw object to BMA ops" bml-emit-throw-int)
                (compiler-rule "bml" "try-throw-return" "BML try object to BMA ops" bml-emit-try-throw-return)
                (compiler-rule "bml" "fail-simple" "BML fail primitive to BMA ops" bml-emit-fail-simple)
                (compiler-rule "bml" "cut-simple" "BML cut primitive to BMA ops" bml-emit-cut-simple)
                (compiler-rule "bml" "mark-simple" "BML mark primitive to BMA save ops" bml-emit-mark-simple)
                (compiler-rule "bml" "restore-simple" "BML restore primitive to BMA restore ops" bml-emit-restore-simple)
                (compiler-rule "bml" "discard-simple" "BML discard primitive to BMA discard ops" bml-emit-discard-simple)
                (compiler-rule "bml" "save-simple" "BML save primitive to BMA save ops" bml-emit-save-simple)
                (compiler-rule "bml" "char-lit" "BML char literal source objects" bml-emit-char-lit)
                (compiler-rule "bml" "array-int" "BML array literal source objects" bml-emit-array-int)
                (compiler-rule "bml" "method-return-add" "BML method object to BMA ops" bml-emit-method-return-add)
                (compiler-rule "bml" "method-param-return-add" "BML one-parameter method object to BMA ops" bml-emit-method-param-return-add)
                (compiler-rule "bml" "method-two-param-return-add" "BML two-parameter method object to BMA ops" bml-emit-method-two-param-return-add)
                (compiler-rule "bml" "method-return-this-field-add-int" "BML method-scope field read object to Hati ops" bml-emit-method-return-this-field-add-int)
                (compiler-rule "bml" "method-set-this-field-return" "BML method-scope field write object to Hati ops" bml-emit-method-set-this-field-return)
                (compiler-rule "bml" "class-field-method-return-this-field-add-int" "BML class field plus field-reading method object to Hati ops" bml-emit-class-field-method-return-this-field-add-int)
                (compiler-rule "bml" "choice-fail-int" "BML thesis choice object to BMA ops" bml-emit-choose-fail-int)
                (compiler-rule "bml" "choose-fail-int" "BML choice object to BMA ops" bml-emit-choose-fail-int)
                (compiler-rule "bml" "if-fail-fail-return-int" "BML if_fail fallback object to BMA ops" bml-emit-if-fail-fail-return-int)
                (compiler-rule "bml" "while-success-fail-return-int" "BML while_success object to BMA ops" bml-emit-while-success-fail-return-int)
                (compiler-rule "bml" "state-int" "BML state object to BMA ops" bml-emit-state-int))))

    (let bml-form-source
        (form-source "bml" (list bml-bmf-section bml-recipe-section)))

    (let bml-bmf-dialect
        (bmf-dialect "bml"
                     (form-section-object bml-bmf-section)
                     bml-bmf-native-section
                     bml-bmf-rules))

    ;; --- BMA-like program lowering ----------------------------------

    (defn bma-op (name value)
        (comp-op name value comp-op-identity-inverse))

    (defn bma-push-int (n) (bma-op "push-int" n))
    (defn bma-push-lit (value) (bma-op "push-lit" value))
    (defn bma-add (_x) (bma-op "add" 0))
    (defn bma-return (_x) (bma-op "return" 0))
    (defn bma-break (label) (bma-op "break" label))
    (defn bma-continue (label) (bma-op "continue" label))
    (defn bma-throw (_x) (bma-op "throw" 0))
    (defn bma-raise (_x) (bma-op "raise" 0))
    (defn bma-resume (_x) (bma-op "resume" 0))
    (defn bma-save (_x) (bma-op "save" 0))
    (defn bma-mark (_x) (bma-op "mark" 0))
    (defn bma-restore (_x) (bma-op "restore" 0))
    (defn bma-discard (_x) (bma-op "discard" 0))
    (defn bma-nostate (_x) (bma-op "nostate" 0))
    (defn bma-fail (_x) (bma-op "fail" 0))
    (defn bma-cut (_x) (bma-op "cut" 0))
    (defn bma-choose (branches) (bma-op "choose" branches))
    (defn bma-try (branches) (bma-op "try" branches))
    (defn bma-while-success (body) (bma-op "while-success" body))

    (defn bml-node-child (node index)
        (nth (node_children node) index))

    (defn bml-local-binding (name value bind-env)
        (list "bml-local-binding" name value bind-env))

    (defn bml-local-binding-name (binding) (nth binding 1))
    (defn bml-local-binding-value (binding) (nth binding 2))
    (defn bml-local-binding-env (binding) (nth binding 3))

    (defn bml-local-name (node)
        (node_value (bml-node-child node 0)))

    (defn bml-local-const-name (node)
        (node_value (bml-node-child node 1)))

    (defn bml-local-const-value (node)
        (bml-node-child node 2))

    (defn bml-class-node-name (node)
        (node_value (bml-node-child node 0)))

    (defn bml-field-node-type (node)
        (node_value (bml-node-child node 0)))

    (defn bml-field-node-name (node)
        (node_value (bml-node-child node 1)))

    (defn bml-method-node-name (node)
        (node_value (bml-node-child node 0)))

    (defn bml-method-node-body (node)
        (bml-node-child node 1))

    (defn bml-method-node-parameters (node)
        (if (gt (len (node_children node)) 2)
            (bml-method-node-parameters-from node 2)
            (empty)))

    (defn bml-method-node-parameters-from (node index)
        (if (ge index (len (node_children node)))
            (empty)
            (cons
                (bml-parameter-component "" (node_value (bml-node-child node index)))
                (bml-method-node-parameters-from node (add index 1)))))

    (defn bml-method-node-first-parameter-name (node)
        (do
            (let params (bml-method-node-parameters node))
            (if (nil? params) "" (bml-parameter-name (head params)))))

    (defn bml-call-name (node)
        (node_value (bml-node-child node 0)))

    (defn bml-call-arg (node)
        (bml-node-child node 1))

    (defn bml-call-args (node)
        (if (node_eq (node_category (bml-call-arg node)) BML-AST-ARRAY)
            (node_children (bml-call-arg node))
            (list (bml-call-arg node))))

    (defn bml-local-lookup (env name)
        (do
            (let direct (bml-local-lookup-direct env name))
            (if (nil? direct)
                (bml-scope-lookup-qualified env name)
                direct)))

    (defn bml-local-lookup-direct (env name)
        (if (nil? env)
            (empty)
            (if (str_eq (bml-local-binding-name (head env)) name)
                (head env)
                (bml-local-lookup-direct (tail env) name))))

    (defn bml-local-bind-const (env node)
        (cons
            (bml-local-binding
                (bml-local-const-name node)
                (bml-local-const-value node)
                env)
            env))

    (defn bml-local-bind-method (env node)
        (cons
            (bml-local-binding
                (bml-method-node-name node)
                node
                env)
            env))

    (defn bml-local-env-after-node (node env)
        (if (node_eq (node_category node) BML-AST-CONST)
            (bml-bnml-bind-const env node)
        (if (node_eq (node_category node) BML-AST-METHOD)
            (bml-local-bind-method env node)
            (bml-bnml-env-after-node node env))))

    ;; --- mutable locals: bnml frame bindings ---------------------------
    ;; A declared or assigned local binds a bnml binding: its value node
    ;; and env (the BMA lane reads by substitution) plus a kind and a frame
    ;; slot key (the Hati lane writes and reads the frame). The key is the
    ;; name and the env depth at its declaration, so a shadowing declaration
    ;; owns its own slot. A block keeps its declarations inside and lets an
    ;; assignment to a name declared outside it ride out to what follows.

    (defn bml-bnml-binding (name value bind-env kind key)
        (list "bml-local-binding" name value bind-env kind key))

    (defn bml-local-binding-kind (binding)
        (if (gt (len binding) 4) (nth binding 4) ""))

    (defn bml-local-binding-key (binding) (nth binding 5))

    (defn bml-bnml-binding? (binding)
        (if (nil? binding)
            false
            (not (str_eq (bml-local-binding-kind binding) ""))))

    (defn bml-bnml-new-key (name env)
        (str_concat name (str_concat "@" (int_to_str (bml-bnml-depth env)))))

    ;; How deep a binding sits: its env's length, plus the depth of the call
    ;; an inlined BMA callee was compiled from, so a callee's slots never
    ;; share a key with its caller's.
    (defn bml-bnml-depth (env)
        (add (len env) (bml-bnml-base env)))

    (defn bml-bnml-base (env)
        (if (nil? env)
            0
            (if (str_eq (bml-local-binding-kind (head env)) "bnml-base")
                (bml-local-binding-key (head env))
                (bml-bnml-base (tail env)))))

    (defn bml-bnml-with-base (callee-env caller-env)
        (cons
            (bml-bnml-binding "__bnml_base" (empty) callee-env "bnml-base" (bml-bnml-depth caller-env))
            callee-env))

    (defn bml-bnml-assign-key (node env)
        (do
            (let binding (bml-local-lookup env (bml-bnml-target-name node)))
            (if (bml-bnml-binding? binding)
                (bml-local-binding-key binding)
                (bml-bnml-new-key (bml-bnml-target-name node) env))))

    (defn bml-bnml-bind-node (env node kind key)
        (cons
            (bml-bnml-binding
                (bml-bnml-target-name node)
                (bml-bnml-value node)
                env
                kind
                key)
            env))

    (defn bml-bnml-bind-const (env node)
        (if (bml-bnml-reads-mutable? (bml-local-const-value node) env)
            (cons
                (bml-bnml-binding
                    (bml-local-const-name node)
                    (bml-local-const-value node)
                    env
                    "bnml-const"
                    (bml-bnml-new-key (bml-local-const-name node) env))
                env)
            (bml-local-bind-const env node)))

    ;; BML-AST categories are trivial ints, so a literal leaf answers
    ;; node_category with itself: the leaf 13 reads as NAME, 35 as CALL. A
    ;; name node is the one that also carries its one name child.
    (defn bml-bnml-reads-mutable? (node env)
        (if (bml-name-node? node)
            (bml-bnml-binding? (bml-local-lookup env (bml-local-name node)))
            (bml-bnml-any-reads-mutable? (node_children node) env)))

    (defn bml-name-node? (node)
        (if (node_eq (node_category node) BML-AST-NAME)
            (eq (len (node_children node)) 1)
            false))

    (defn bml-bnml-any-reads-mutable? (nodes env)
        (if (nil? nodes)
            false
            (if (bml-bnml-reads-mutable? (head nodes) env)
                true
                (bml-bnml-any-reads-mutable? (tail nodes) env))))

    (defn bml-bnml-env-after-node (node env)
        (if (bml-bnml-top-node? node)
            (bml-local-env-after-node (head (bml-call-args node)) env)
        (if (node_eq (node_category node) BML-AST-SAVE)
            (cons (bml-bnml-binding "__bnml_mark" (empty) env "bnml-mark" "") env)
        (if (node_eq (node_category node) BML-AST-RESTORE)
            (bml-bnml-env-after-restore env)
        (if (node_eq (node_category node) BML-AST-DISCARD)
            (bml-bnml-env-after-discard env)
            (bml-bnml-env-after-core node env))))))

    (defn bml-bnml-env-after-core (node env)
        (if (node_eq (node_category node) BML-AST-BLOCK)
            (bml-bnml-block-env-after node env)
        (if (bml-bnml-declare-node? node)
            (bml-bnml-bind-node
                env
                node
                "bnml-declare"
                (bml-bnml-new-key (bml-bnml-target-name node) env))
        (if (bml-bnml-assign-node? node)
            (bml-bnml-bind-node
                env
                node
                "bnml-assign"
                (bml-bnml-assign-key node env))
            env))))

    (defn bml-bnml-fold-env (nodes env)
        (if (nil? nodes)
            env
            (bml-bnml-fold-env
                (tail nodes)
                (bml-local-env-after-node (head nodes) env))))

    (defn bml-bnml-block-env-after (node env)
        (do
            (let inner (bml-bnml-fold-env (node_children node) env))
            (bml-bnml-outward
                (reverse-list (take (sub (len inner) (len env)) inner))
                (empty)
                env)))

    (defn bml-bnml-outward (bindings declared env)
        (if (nil? bindings)
            env
            (do
                (let binding (head bindings))
                (let name (bml-local-binding-name binding))
                (if (bml-bnml-rides-out? (bml-local-binding-kind binding))
                    (if (fsc-string-list-contains? declared name)
                        (bml-bnml-outward (tail bindings) declared env)
                        (bml-bnml-outward (tail bindings) declared (cons binding env)))
                    (bml-bnml-outward (tail bindings) (cons name declared) env)))))

    (defn bml-compile-children (children)
        (bml-compile-children-in children (empty)))

    (defn bml-compile-child-in (node env)
        (if (node_eq (node_category node) BML-AST-METHOD)
            (empty)
            (bml-compile-node-in node env)))

    (defn bml-compile-children-in (children env)
        (if (nil? children)
            (empty)
            (append
                (bml-compile-child-in (head children) env)
                (bml-compile-children-in
                    (tail children)
                    (bml-local-env-after-node (head children) env)))))

    (defn bml-compile-choose-branches-in (branches env)
        (if (nil? branches)
            (empty)
            (cons
                (bml-compile-node-in (head branches) env)
                (bml-compile-choose-branches-in (tail branches) env))))

    (defn bml-compile-node (node)
        (if (bml-bnml-uses-locals? node)
            (cons (bma-frame-init 0) (bml-compile-node-in node (empty)))
            (bml-compile-node-in node (empty))))

    (defn bml-call-bind-first-arg (method-node call-node env)
        (do
            (let param-name (bml-method-node-first-parameter-name method-node))
            (if (str_eq param-name "")
                env
                (cons
                    (bml-local-binding
                        param-name
                        (bml-call-arg call-node)
                        env)
                    env))))

    (defn bml-call-bind-args-loop (state env)
        (do
            (let params (head state))
            (let args (head (tail state)))
            (if (or (nil? params) (nil? args))
                env
                (bml-call-bind-args-loop
                    (list (tail params) (tail args))
                    (cons
                        (bml-local-binding
                            (bml-parameter-name (head params))
                            (head args)
                            env)
                        env)))))

    (defn bml-call-bind-args (method-node call-node env)
        (bml-call-bind-args-loop
            (list
                (bml-method-node-parameters method-node)
                (bml-call-args call-node))
            env))

    ;; A call resolves as on Hati: the name through package and import
    ;; scope, the overload by arity, and the callee's body in the callee's
    ;; own unit env with its parameters bound to arguments read in the
    ;; caller's env. What cannot resolve compiles to its named refusal.
    ;; Reserved __ names (field access, arg slots) keep their own lanes.
    (defn bml-compile-call-in (node env)
        (if (bml-scope-prefix? (bml-call-name node) "__")
            (empty)
            (do
                (let name (bml-scope-resolve-name env (bml-call-name node)))
                (let binding (bml-local-lookup-direct env name))
                (if (nil? binding)
                    (bml-bma-refusal
                        (bml-scope-unbound-call-reason env (bml-call-name node)))
                (if (not (bml-bma-method-value? (bml-local-binding-value binding)))
                    (bml-bma-refusal "call/not-method")
                    (do
                        (let method-binding
                            (bml-bma-method-binding-for-arity
                                env
                                name
                                (len (bml-call-args node))))
                        (if (nil? method-binding)
                            (bml-bma-refusal "call/arity")
                            (do
                                (let method-node (bml-local-binding-value method-binding))
                                (bml-compile-callee-body-in
                                    (bml-method-node-body method-node)
                                    (bml-bma-bind-params
                                        (bml-method-node-parameters method-node)
                                        (bml-call-args node)
                                        env
                                        (bml-bnml-with-base (bml-bma-home-env method-node env) env)))))))))))

    ;; A callee's final return is the call's value: inlined BMA keeps the
    ;; caller's stream running instead of ending it at the callee's return.
    (defn bml-compile-callee-body-in (body env)
        (if (node_eq (node_category body) BML-AST-RETURN)
            (bml-compile-node-in (bml-node-child body 0) env)
        (if (node_eq (node_category body) BML-AST-BLOCK)
            (bml-compile-callee-children-in (node_children body) env)
            (bml-compile-node-in body env))))

    (defn bml-compile-callee-children-in (children env)
        (if (nil? children)
            (empty)
            (if (nil? (tail children))
                (bml-compile-callee-body-in (head children) env)
                (append
                    (bml-compile-callee-statement-in (head children) env)
                    (bml-compile-callee-children-in
                        (tail children)
                        (bml-local-env-after-node (head children) env))))))

    ;; Inside an inlined callee a binding statement leaves nothing on the
    ;; stack under the call's result: a const that reads no mutable local
    ;; only binds; a local, an assignment, or a const that reads one stores
    ;; its value in the floor frame and drops it. A nested block's
    ;; statements follow the same rule.
    (defn bml-compile-callee-statement-in (node env)
        (if (node_eq (node_category node) BML-AST-CONST)
            (if (bml-bnml-reads-mutable? (bml-local-const-value node) env)
                (append (bml-compile-const-in node env) (list (bma-drop 0)))
                (empty))
        (if (bml-bnml-declare-node? node)
            (append (bml-compile-node-in node env) (list (bma-drop 0)))
        (if (bml-bnml-assign-node? node)
            (append (bml-compile-node-in node env) (list (bma-drop 0)))
        (if (node_eq (node_category node) BML-AST-BLOCK)
            (bml-compile-callee-block-in (node_children node) env)
            (bml-compile-child-in node env))))))

    (defn bml-compile-callee-block-in (children env)
        (if (nil? children)
            (empty)
            (append
                (bml-compile-callee-statement-in (head children) env)
                (bml-compile-callee-block-in
                    (tail children)
                    (bml-local-env-after-node (head children) env)))))

    (defn bml-compile-node-in (node env)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-INT)
                (list (bma-push-int (node_value (bml-node-child node 0))))
            (if (node_eq cat BML-AST-FLOAT)
                (list (bma-push-lit (bml-node-child node 0)))
            (if (node_eq cat BML-AST-STRING)
                (list (bma-push-lit (node_value (bml-node-child node 0))))
            (if (node_eq cat BML-AST-CHAR)
                (list (bma-push-lit (node_value (bml-node-child node 0))))
            (if (node_eq cat BML-AST-ARRAY)
                (bml-compile-children-in (node_children node) env)
            (if (node_eq cat BML-AST-ADD)
                (append (bml-compile-node-in (bml-node-child node 0) env)
                        (append (bml-compile-node-in (bml-node-child node 1) env)
                                (list (bma-add 0))))
            (if (node_eq cat BML-AST-CONST)
                (bml-compile-const-in node env)
            (if (node_eq cat BML-AST-NAME)
                (bml-compile-name-in node env)
            (if (node_eq cat BML-AST-CALL)
                (bml-compile-call-node-in node env)
            (if (node_eq cat BML-AST-RETURN)
                (append (bml-compile-value-in (bml-node-child node 0) env)
                        (list (bma-return 0)))
            (if (node_eq cat BML-AST-BREAK)
                (list (bma-break (node_value (bml-node-child node 0))))
            (if (node_eq cat BML-AST-CONTINUE)
                (list (bma-continue (node_value (bml-node-child node 0))))
            (if (node_eq cat BML-AST-THROW)
                (append (bml-compile-node-in (bml-node-child node 0) env)
                        (list (bma-throw 0)))
            (if (node_eq cat BML-AST-TRY)
                (list (bma-try
                        (list (bml-compile-node-in (bml-node-child node 0) env)
                              (bml-compile-node-in (bml-node-child node 1) env))))
            (if (node_eq cat BML-AST-WHILE)
                (list (bma-while-success
                        (bml-compile-node-in (bml-node-child node 0) env)))
            (if (node_eq cat BML-AST-METHOD)
                (bml-compile-node-in
                    (bml-method-node-body node)
                    (bml-call-bind-first-arg
                        node
                        (bml-ast-call "" (bml-ast-int 0))
                        env))
            (if (node_eq cat BML-AST-BLOCK)
                (bml-compile-children-in (node_children node) env)
            (if (node_eq cat BML-AST-CHOOSE)
                (list (bma-choose (bml-compile-choose-branches-in (node_children node) env)))
            (if (node_eq cat BML-AST-FAIL)
                (list (bma-fail 0))
            (if (node_eq cat BML-AST-CUT)
                (list (bma-cut 0))
            (if (node_eq cat BML-AST-SAVE)
                (list (bma-save 0))
            (if (node_eq cat BML-AST-RESTORE)
                (list (bma-restore 0))
            (if (node_eq cat BML-AST-DISCARD)
                (list (bma-discard 0))
                (empty))))))))))))))))))))))))))

    ;; A program is a unit: one scope rule on both lanes.
    (defn bml-compile-program (node)
        (bml-compile-unit-program node (empty)))

    ;; --- BMA-like runtime -------------------------------------------

    (defn bma-bin-add (s)
        (do
            (let right (comp-vm-pop-value s))
            (let s1 (comp-vm-pop-state s))
            (let left (comp-vm-pop-value s1))
            (let s2 (comp-vm-pop-state s1))
            (comp-vm-push s2 (add left right))))

    (defn bma-exec-choose-branches (branches state)
        (if (nil? branches)
            (comp-vm-with-mode state "fail")
            (do
                (let branch-state (bma-exec-ops (head branches) (comp-vm-with-mode state "run")))
                (if (str_eq (comp-vm-mode branch-state) "fail")
                    (bma-exec-choose-branches (tail branches) state)
                    branch-state))))

    (defn bma-exec-try-branches (branches state)
        (do
            (let body-state (bma-exec-ops (head branches) (comp-vm-with-mode state "run")))
            (if (str_eq (comp-vm-mode body-state) "throw")
                (bma-exec-ops (head (tail branches)) (comp-vm-with-mode state "run"))
                body-state)))

    (defn bma-while-success-iteration-limit (_x) 64)

    (defn bma-exec-while-success-loop (body state remaining)
        (if (eq remaining 0)
            (comp-vm-with-mode state "fail")
            (do
                (let body-state (bma-exec-ops body (comp-vm-with-mode state "run")))
                (if (str_eq (comp-vm-mode body-state) "fail")
                    (comp-vm-with-mode state "run")
                    (if (str_eq (comp-vm-mode body-state) "run")
                        (bma-exec-while-success-loop body body-state (sub remaining 1))
                        body-state)))))

    (defn bma-exec-while-success (body state)
        (do
            (bma-exec-while-success-loop
                body
                state
                (bma-while-success-iteration-limit 0))))

    (defn bma-exec-op (op state)
        (do
            (let name (comp-op-name op))
            (if (str_eq name "push-int") (comp-vm-push state (comp-op-value op))
            (if (str_eq name "push-lit") (comp-vm-push state (comp-op-value op))
            (if (str_eq name "add") (bma-bin-add state)
            (if (str_eq name "return") (comp-vm-with-mode state "return")
            (if (str_eq name "break") (comp-vm-with-mode state "break")
            (if (str_eq name "continue") (comp-vm-with-mode state "continue")
            (if (str_eq name "throw") (comp-vm-with-mode state "throw")
            (if (str_eq name "raise") (comp-vm-with-mode state "raise")
            (if (str_eq name "resume") (comp-vm-with-mode state "run")
            (if (str_eq name "save") (comp-vm-save state)
            (if (str_eq name "mark") (comp-vm-save state)
            (if (str_eq name "restore") (comp-vm-restore state)
            (if (str_eq name "discard") (comp-vm-discard state)
            (if (str_eq name "nostate") state
            (if (str_eq name "fail") (comp-vm-with-mode state "fail")
            (if (str_eq name "cut") (comp-vm-with-mode state "cut")
            (if (str_eq name "choose") (bma-exec-choose-branches (comp-op-value op) state)
            (if (str_eq name "try") (bma-exec-try-branches (comp-op-value op) state)
            (if (str_eq name "while-success") (bma-exec-while-success (comp-op-value op) state)
                (bma-exec-array-op op state))))))))))))))))))))))

    (defn bma-exec-ops (ops state)
        (if (nil? ops) state
            (if (str_eq (comp-vm-mode state) "run")
                (bma-exec-ops (tail ops) (bma-exec-op (head ops) state))
                state)))

    (defn bma-run-program (program)
        (bma-exec-ops (comp-program-ops program) (comp-vm-empty 0)))

    (defn bma-run-value (program)
        (comp-vm-pop-value (bma-run-program program)))

    ;; Thesis exit proof: record the executable BMA stream in forward
    ;; DO mode, then replay the trace backward in UNDO mode by restoring
    ;; each op's saved pre-state.
    (defn bma-trace-entry (mode op before after)
        (list "bma-trace-entry" mode (comp-op-name op) before after))

    (defn bma-trace-mode (entry) (nth entry 1))
    (defn bma-trace-op-name (entry) (nth entry 2))
    (defn bma-trace-before (entry) (nth entry 3))
    (defn bma-trace-after (entry) (nth entry 4))

    (defn bma-trace-result (state trace)
        (list "bma-trace-result" state trace))

    (defn bma-trace-result-state (result) (nth result 1))
    (defn bma-trace-result-trace (result) (nth result 2))

    (defn bma-run-program-forward-trace-loop (ops state trace)
        (if (nil? ops)
            (bma-trace-result state (reverse trace))
            (if (str_eq (comp-vm-mode state) "run")
                (do
                    (let op (head ops))
                    (let after (bma-exec-op op state))
                    (bma-run-program-forward-trace-loop
                        (tail ops)
                        after
                        (cons (bma-trace-entry "DO" op state after) trace)))
                (bma-trace-result state (reverse trace)))))

    (defn bma-run-program-forward-trace (program)
        (bma-run-program-forward-trace-loop
            (comp-program-ops program)
            (comp-vm-empty 0)
            (empty)))

    (defn bma-run-program-backward-trace-loop (entries state trace)
        (if (nil? entries)
            (bma-trace-result state (reverse trace))
            (do
                (let entry (head entries))
                (let before (bma-trace-before entry))
                (let op (bma-op (bma-trace-op-name entry) 0))
                (bma-run-program-backward-trace-loop
                    (tail entries)
                    before
                    (cons (bma-trace-entry "UNDO" op state before) trace)))))

    (defn bma-run-program-backward-trace (forward-result)
        (bma-run-program-backward-trace-loop
            (reverse (bma-trace-result-trace forward-result))
            (bma-trace-result-state forward-result)
            (empty)))

    (defn bma-forward-backward-result (forward-state restored-state trace)
        (list "bma-forward-backward" forward-state restored-state trace))

    (defn bma-forward-backward-forward-state (result) (nth result 1))
    (defn bma-forward-backward-restored-state (result) (nth result 2))
    (defn bma-forward-backward-trace (result) (nth result 3))

    ;; --- BMA values: arrays, index, mutable-local calls -----------------
    ;; A value position (a return, an array element, an index target)
    ;; builds an array literal into one list; a bare array statement keeps
    ;; pushing its items. Declare and assign push their value like a const.

    (defn bma-array (n) (bma-op "array" n))
    (defn bma-index (_x) (bma-op "index" 0))

    (defn bml-compile-value-in (node env)
        (if (node_eq (node_category node) BML-AST-ARRAY)
            (append
                (bml-compile-values-in (node_children node) env)
                (list (bma-array (len (node_children node)))))
        (if (node_eq (node_category node) BML-AST-NAME)
            (do
                (let binding (bml-local-lookup env (bml-local-name node)))
                (if (nil? binding)
                    (bml-bma-refusal "name/unbound")
                (if (bml-bma-method-value? (bml-local-binding-value binding))
                    (bml-bma-refusal "name/method")
                (if (bml-bnml-binding? binding)
                    (list (bma-lget (bml-local-binding-key binding)))
                    (bml-compile-value-in
                        (bml-local-binding-value binding)
                        (bml-local-binding-env binding))))))
            (bml-compile-node-in node env))))

    ;; A const that reads a mutable local keeps what it read in its own slot.
    (defn bml-compile-const-in (node env)
        (if (bml-bnml-reads-mutable? (bml-local-const-value node) env)
            (append
                (bml-compile-value-in (bml-local-const-value node) env)
                (list (bma-lset (bml-bnml-new-key (bml-local-const-name node) env))))
            (bml-compile-node-in (bml-local-const-value node) env)))

    ;; A leaf (no children) is a value, never a statement: the walk asks
    ;; only nodes that carry children.
    (defn bml-bnml-uses-locals? (node)
        (if (eq (len (node_children node)) 0)
            false
        (if (bml-bnml-declare-node? node)
            true
        (if (bml-bnml-assign-node? node)
            true
            (bml-bnml-any-uses-locals? (node_children node))))))

    (defn bml-bnml-any-uses-locals? (nodes)
        (if (nil? nodes)
            false
            (if (bml-bnml-uses-locals? (head nodes))
                true
                (bml-bnml-any-uses-locals? (tail nodes)))))

    (defn bml-compile-values-in (nodes env)
        (if (nil? nodes)
            (empty)
            (append
                (bml-compile-value-in (head nodes) env)
                (bml-compile-values-in (tail nodes) env))))

    (defn bml-compile-call-node-in (node env)
        (if (bml-bnml-declare-node? node)
            (append
                (bml-compile-value-in (bml-bnml-value node) env)
                (list (bma-lset (bml-bnml-new-key (bml-bnml-target-name node) env))))
        (if (bml-bnml-assign-node? node)
            (append
                (bml-compile-value-in (bml-bnml-value node) env)
                (list (bma-lset (bml-bnml-assign-key node env))))
        (if (bml-index-node? node)
            (append
                (bml-compile-value-in (bml-index-target node) env)
                (append
                    (bml-compile-node-in (bml-index-at node) env)
                    (list (bma-index 0))))
        (if (bml-list-set-node? node)
            (append
                (bml-compile-value-in (bml-index-target node) env)
                (append
                    (bml-compile-node-in (bml-index-at node) env)
                    (append
                        (bml-compile-value-in (bml-list-set-value node) env)
                        (list (bma-list-set 0)))))
            (bml-compile-call-in node env))))))

    (defn bma-list-set (_x) (bma-op "list-set" 0))

    (defn bma-exec-array-op (op state)
        (if (str_eq (comp-op-name op) "array")
            (bma-exec-make-array (comp-op-value op) state (empty))
        (if (str_eq (comp-op-name op) "index")
            (bma-exec-index state)
        (if (str_eq (comp-op-name op) "list-set")
            (bma-exec-list-set state)
        (if (str_eq (comp-op-name op) "frame")
            (comp-vm-push state (empty))
        (if (str_eq (comp-op-name op) "lset")
            (bma-exec-lset (comp-op-value op) state)
        (if (str_eq (comp-op-name op) "lget")
            (bma-exec-lget (comp-op-value op) state)
        (if (str_eq (comp-op-name op) "drop")
            (comp-vm-pop-state state)
            state))))))))

    ;; The mutable-local frame rides the floor of the value stack, so every
    ;; stack snapshot (save, a choose branch, a try) carries the locals too.
    (defn bma-frame-init (_x) (bma-op "frame" 0))
    (defn bma-lset (key) (bma-op "lset" key))
    (defn bma-lget (key) (bma-op "lget" key))
    (defn bma-drop (_x) (bma-op "drop" 0))

    (defn bma-frame-rows-get (rows key)
        (if (nil? rows)
            0
            (if (str_eq (head (head rows)) key)
                (head (tail (head rows)))
                (bma-frame-rows-get (tail rows) key))))

    (defn bma-frame-rows-set (rows key value)
        (if (nil? rows)
            (list (list key value))
            (if (str_eq (head (head rows)) key)
                (cons (list key value) (tail rows))
                (cons (head rows) (bma-frame-rows-set (tail rows) key value)))))

    (defn bma-stack-floor (stack)
        (if (nil? (tail stack)) (head stack) (bma-stack-floor (tail stack))))

    (defn bma-stack-with-floor (stack floor)
        (if (nil? (tail stack))
            (list floor)
            (cons (head stack) (bma-stack-with-floor (tail stack) floor))))

    (defn bma-exec-lset (key s)
        (do
            (let stack (comp-vm-stack s))
            (comp-vm-state
                (bma-stack-with-floor
                    stack
                    (bma-frame-rows-set (bma-stack-floor stack) key (head stack)))
                (comp-vm-snapshots s)
                (comp-vm-mode s))))

    (defn bma-exec-lget (key s)
        (comp-vm-push s (bma-frame-rows-get (bma-stack-floor (comp-vm-stack s)) key)))

    ;; Past the end the write is dropped; the Hati list-set function agrees.
    (defn bml-list-set-at (items at value)
        (if (nil? items)
            items
            (if (eq at 0)
                (cons value (tail items))
                (cons (head items) (bml-list-set-at (tail items) (sub at 1) value)))))

    (defn bma-exec-list-set (s)
        (do
            (let value (comp-vm-pop-value s))
            (let s1 (comp-vm-pop-state s))
            (let at (comp-vm-pop-value s1))
            (let s2 (comp-vm-pop-state s1))
            (let items (comp-vm-pop-value s2))
            (let s3 (comp-vm-pop-state s2))
            (comp-vm-push s3 (bml-list-set-at items at value))))

    (defn bma-exec-make-array (n state items)
        (if (le n 0)
            (comp-vm-push state items)
            (bma-exec-make-array
                (sub n 1)
                (comp-vm-pop-state state)
                (cons (comp-vm-pop-value state) items))))

    (defn bma-exec-index (s)
        (do
            (let at (comp-vm-pop-value s))
            (let s1 (comp-vm-pop-state s))
            (let items (comp-vm-pop-value s1))
            (let s2 (comp-vm-pop-state s1))
            (comp-vm-push s2 (nth items at))))

    (defn bma-run-forward-backward (program)
        (do
            (let forward (bma-run-program-forward-trace program))
            (let backward (bma-run-program-backward-trace forward))
            (bma-forward-backward-result
                (bma-trace-result-state forward)
                (bma-trace-result-state backward)
                (append (bma-trace-result-trace forward)
                        (bma-trace-result-trace backward)))))

    ;; --- BML to Hati native image lowering -----------------------------

    (defn bml-hati-native-north-star ()
        "original BML/BMF/Form compiler sources compile themselves into versioned .fkb images and Hati fourth-kernel native binaries with full class, template, generic, method, state, exception, and physical-lane support")

    (defn bml-hati-native-floor ()
        "supported native subsets include lexical const/name binding, package-qualified names, import-resolved symbols linked across source units into one table, one- and two-argument method parameter binding, methods of any parameter count, known method calls, general calls with nested, bound-name, sum and package-receiver arguments, method-scope class field read/write through record-backed self, named class method dispatch, class construction defaults, arity-aware overload dispatch, arity-selected compiled overload calls, template/generic metadata, mutable locals rebound through a per-call bnml frame (nested-block rebinding included), array literals and a[i] indexing, source-level if/else, while, for, loop, switch, labeled break/continue, return, and try/throw/catch through a Form-native mode/value/dispatch protocol whose transfers are bml-native-source-control effect rows, clang oracle assembly receipts, and Form-native JIT runtime model rows for macos-arm64 and android-arm64; they must produce loadable Hati tables with parity proof; unsupported BML shapes, including unresolved names, unbound calls, unresolved imports, value-receiver dispatch, unbound or const assignment targets, indexes already seen out of range or into a non-array, break/continue without a target, with, control nested inside a non-control container, arity mismatch, missing class methods, full class construction syntax, type/generic overload resolution, and template/generic specialization, must be named before table emission, and a name the lowering cannot resolve lowers to a named refusal literal, never to a valid zero result")

    (defn bml-hati-native-next-step ()
        "lift full class construction syntax, template/generic specialization, type/generic overload resolution, value-receiver and interface dispatch on the scoped call floor")

    (defn bml-hati-lower-result (expr pool)
        (list "bml-hati-lower-result" expr pool))

    (defn bml-hati-lower-expr (result) (nth result 1))
    (defn bml-hati-lower-pool (result) (nth result 2))

    (defn bml-hati-fns-result (fns pool)
        (list "bml-hati-fns-result" fns pool))

    (defn bml-hati-fns-result-fns (result) (nth result 1))
    (defn bml-hati-fns-result-pool (result) (nth result 2))

    ;; The image reads refusals out of its own pool too, so a lowering that
    ;; named a refusal keeps the image unsupported even if no pass listed it.
    (defn bml-hati-image (fns pool source-node unsupported)
        (list "bml-hati-image" (bml-hati-link-list-set fns) pool source-node
              (bml-hati-reasons-merge unsupported (bml-hati-pool-refusals pool))))

    (defn bml-hati-image-fns (image) (nth image 1))
    (defn bml-hati-image-pool (image) (nth image 2))
    (defn bml-hati-image-source-node (image) (nth image 3))
    (defn bml-hati-image-unsupported (image) (nth image 4))
    (defn bml-hati-image-supported? (image)
        (eq (len (bml-hati-image-unsupported image)) 0))

    (defn bml-hati-pool-index-loop (pool value index)
        (if (nil? pool)
            -1
            (if (str_eq (head pool) value)
                index
                (bml-hati-pool-index-loop (tail pool) value (add index 1)))))

    (defn bml-hati-pool-index (pool value)
        (bml-hati-pool-index-loop pool value 0))

    (defn bml-hati-pool-entry (index pool)
        (list "bml-hati-pool-entry" index pool))

    (defn bml-hati-pool-entry-index (entry) (nth entry 1))
    (defn bml-hati-pool-entry-pool (entry) (nth entry 2))

    (defn bml-hati-pool-ensure (pool value)
        (do
            (let index (bml-hati-pool-index pool value))
            (if (eq index -1)
                (bml-hati-pool-entry (len pool) (append pool (list value)))
                (bml-hati-pool-entry index pool))))

    (defn bml-hati-float-scale-literal () "0.000001")

    (defn bml-hati-float-micros (float-node)
        (float_to_int
            (round_ndigits
                (mul (float_value float-node) 1000000.0)
                0)))

    ;; --- Hati: mutable locals through the bnml frame, arrays, index ----
    ;; A function body that declares or assigns opens its frame once per
    ;; call: frame slot 1 (tag 109) holds a fresh recipe record (tag 64)
    ;; whose blueprint row names BML-MUTABLE-LOCAL-FRAME. Declare and assign
    ;; are record sets (tag 98) at the binding's slot key; a read is a
    ;; record get (tag 97). An index is nth (tag 23) over the cons list an
    ;; array literal lowers to.

    (defn bml-hati-frame-slot () 1)

    (defn bml-hati-bnml-frame-blueprint-name () "BML-MUTABLE-LOCAL-FRAME")

    (defn bml-hati-bnml-frame-expr ()
        (fk-node 110 (fk-lit (bml-hati-frame-slot))))

    (defn bml-bnml-needs-frame? (node)
        (if (bml-bnml-mark-node? node)
            true
        (if (eq (len (node_children node)) 0)
            false
        (if (bml-bnml-declare-node? node)
            true
        (if (bml-bnml-assign-node? node)
            true
        (if (node_eq (node_category node) BML-AST-METHOD)
            false
            (bml-bnml-any-needs-frame? (node_children node))))))))

    (defn bml-bnml-any-needs-frame? (nodes)
        (if (nil? nodes)
            false
            (if (bml-bnml-needs-frame? (head nodes))
                true
                (bml-bnml-any-needs-frame? (tail nodes)))))

    ;; A body with snapshots starts its frame with an empty __marks stack.
    (defn bml-hati-bnml-body-in (nodes result)
        (if (bml-bnml-any-needs-frame? nodes)
            (do
                (let entry
                    (bml-hati-pool-ensure
                        (bml-hati-lower-pool result)
                        (bml-hati-bnml-frame-blueprint-name)))
                (let marks-entry
                    (bml-hati-pool-ensure
                        (bml-hati-pool-entry-pool entry)
                        (bml-bnml-marks-key)))
                (let marked (bml-bnml-any-marks? nodes))
                (bml-hati-lower-result
                    (fk-node 109
                        (ms-intern
                            (fk-lit (bml-hati-frame-slot))
                            (ms-intern
                                (fk-node 64
                                    (fk-cons
                                        (fk-cons
                                            (fk-lit 0)
                                            (fk-cons
                                                (fk-bp
                                                    (fk-slit
                                                        (bml-hati-pool-entry-index entry)
                                                        (bml-hati-bnml-frame-blueprint-name)))
                                                (fk-empty)))
                                        (if marked
                                            (fk-cons
                                                (fk-cons
                                                    (fk-slit
                                                        (bml-hati-pool-entry-index marks-entry)
                                                        (bml-bnml-marks-key))
                                                    (fk-cons (fk-empty) (fk-empty)))
                                                (fk-empty))
                                            (fk-empty))))
                                (bml-hati-lower-expr result))))
                    (if marked
                        (bml-hati-pool-entry-pool marks-entry)
                        (bml-hati-pool-entry-pool entry))))
            result))

    (defn bml-hati-lower-method-body-in (node pool env)
        (bml-hati-bnml-body-in
            (list (bml-method-node-body node))
            (bml-hati-lower-node-in-env
                (bml-bnml-top-body-node (bml-method-node-body node))
                pool
                (bml-hati-method-param-env node env))))

    ;; a store answers the value it stored, as BMA's store leaves it on top
    (defn bml-hati-lower-bnml-store (key value-node pool env)
        (do
            (let value (bml-hati-lower-node-in-env value-node pool env))
            (let slot (bml-hati-pool-ensure (bml-hati-lower-pool value) key))
            (bml-hati-lower-result
                (fk-sequence
                    (fk-rset
                        (bml-hati-bnml-frame-expr)
                        (fk-slit (bml-hati-pool-entry-index slot) key)
                        (bml-hati-lower-expr value))
                    (fk-rget
                        (bml-hati-bnml-frame-expr)
                        (fk-slit (bml-hati-pool-entry-index slot) key)))
                (bml-hati-pool-entry-pool slot))))

    ;; --- Hati: save/restore/discard as one state snapshot ---------------
    ;; The state is the mutable locals and the value the statement list
    ;; stands on. A body that takes a snapshot keeps that value in the
    ;; frame's __top slot (each statement that yields a value writes it),
    ;; and the frame keeps a stack of snapshots under __marks: save pushes
    ;; the live slots and __top, restore writes them back and pops, discard
    ;; pops. BMA's stack snapshot holds the same state: its locals ride the
    ;; floor of the stack it snapshots.

    (defn bml-bnml-top-key () "__top")
    (defn bml-bnml-marks-key () "__marks")

    (defn bml-bnml-mark-node? (node)
        (if (node_eq node (bml-ast-save 0))
            true
        (if (node_eq node (bml-ast-restore 0))
            true
            (node_eq node (bml-ast-discard 0)))))

    (defn bml-bnml-has-marks? (node)
        (if (bml-bnml-mark-node? node)
            true
        (if (eq (len (node_children node)) 0)
            false
        (if (node_eq (node_category node) BML-AST-METHOD)
            false
            (bml-bnml-any-marks? (node_children node))))))

    (defn bml-bnml-any-marks? (nodes)
        (if (nil? nodes)
            false
            (if (bml-bnml-has-marks? (head nodes))
                true
                (bml-bnml-any-marks? (tail nodes)))))

    (defn bml-bnml-top-node? (node)
        (bml-call-named? node "__bnml_top"))

    ;; each statement that yields a value writes it to __top on its way
    (defn bml-bnml-top-rewrite (node)
        (if (node_eq (node_category node) BML-AST-BLOCK)
            (bml-ast-block (bml-bnml-top-rewrite-list (node_children node)))
        (if (bml-bnml-mark-node? node)
            node
        (if (node_eq (node_category node) BML-AST-METHOD)
            node
            (bml-ast-call-args "__bnml_top" (list node))))))

    (defn bml-bnml-top-rewrite-list (nodes)
        (if (nil? nodes)
            (empty)
            (cons
                (bml-bnml-top-rewrite (head nodes))
                (bml-bnml-top-rewrite-list (tail nodes)))))

    (defn bml-bnml-top-body (nodes)
        (if (bml-bnml-any-marks? nodes) (bml-bnml-top-rewrite-list nodes) nodes))

    (defn bml-bnml-top-body-node (node)
        (if (bml-bnml-has-marks? node) (bml-bnml-top-rewrite node) node))

    (defn bml-bnml-rides-out? (kind)
        (if (str_eq kind "bnml-assign")
            true
        (if (str_eq kind "bnml-mark")
            true
            (str_eq kind "bnml-unmark"))))

    ;; the snapshot a restore or discard answers to: the newest save that
    ;; no later discard dropped
    (defn bml-bnml-active-mark (env skip)
        (if (nil? env)
            (empty)
            (do
                (let kind (bml-local-binding-kind (head env)))
                (if (str_eq kind "bnml-unmark")
                    (bml-bnml-active-mark (tail env) (add skip 1))
                (if (str_eq kind "bnml-mark")
                    (if (eq skip 0)
                        (head env)
                        (bml-bnml-active-mark (tail env) (sub skip 1)))
                    (bml-bnml-active-mark (tail env) skip))))))

    (defn bml-bnml-env-after-restore (env)
        (do
            (let mark (bml-bnml-active-mark env 0))
            (if (nil? mark) env (bml-local-binding-env mark))))

    (defn bml-bnml-env-after-discard (env)
        (if (nil? (bml-bnml-active-mark env 0))
            env
            (cons (bml-bnml-binding "__bnml_unmark" (empty) env "bnml-unmark" "") env)))

    (defn bml-bnml-mark-need (env reason)
        (if (nil? (bml-bnml-active-mark env 0)) (list reason) (empty)))

    (defn bml-bnml-slot-kind? (kind)
        (if (str_eq kind "bnml-declare")
            true
        (if (str_eq kind "bnml-assign")
            true
            (str_eq kind "bnml-const"))))

    ;; every slot a binding in env names, shadowed ones included
    (defn bml-bnml-snapshot-keys (env keys)
        (if (nil? env)
            keys
            (if (bml-bnml-slot-kind? (bml-local-binding-kind (head env)))
                (if (fsc-string-list-contains? keys (bml-local-binding-key (head env)))
                    (bml-bnml-snapshot-keys (tail env) keys)
                    (bml-bnml-snapshot-keys
                        (tail env)
                        (cons (bml-local-binding-key (head env)) keys)))
                (bml-bnml-snapshot-keys (tail env) keys))))

    (defn bml-hati-bnml-get (key pool)
        (do
            (let slot (bml-hati-pool-ensure pool key))
            (bml-hati-lower-result
                (fk-rget
                    (bml-hati-bnml-frame-expr)
                    (fk-slit (bml-hati-pool-entry-index slot) key))
                (bml-hati-pool-entry-pool slot))))

    (defn bml-hati-bnml-set (key value-expr pool)
        (do
            (let slot (bml-hati-pool-ensure pool key))
            (bml-hati-lower-result
                (fk-rset
                    (bml-hati-bnml-frame-expr)
                    (fk-slit (bml-hati-pool-entry-index slot) key)
                    value-expr)
                (bml-hati-pool-entry-pool slot))))

    ;; the snapshot: each slot's value, then __top last
    (defn bml-hati-snapshot-expr (keys pool)
        (if (nil? keys)
            (do
                (let top (bml-hati-bnml-get (bml-bnml-top-key) pool))
                (bml-hati-lower-result
                    (fk-cons (bml-hati-lower-expr top) (fk-empty))
                    (bml-hati-lower-pool top)))
            (do
                (let first (bml-hati-bnml-get (head keys) pool))
                (let rest (bml-hati-snapshot-expr (tail keys) (bml-hati-lower-pool first)))
                (bml-hati-lower-result
                    (fk-cons (bml-hati-lower-expr first) (bml-hati-lower-expr rest))
                    (bml-hati-lower-pool rest)))))

    (defn bml-hati-then-top (effect)
        (do
            (let top (bml-hati-bnml-get (bml-bnml-top-key) (bml-hati-lower-pool effect)))
            (bml-hati-lower-result
                (fk-sequence (bml-hati-lower-expr effect) (bml-hati-lower-expr top))
                (bml-hati-lower-pool top))))

    (defn bml-hati-lower-top (node pool env)
        (do
            (let inner (bml-hati-lower-node-in-env (head (bml-call-args node)) pool env))
            (bml-hati-then-top
                (bml-hati-bnml-set
                    (bml-bnml-top-key)
                    (bml-hati-lower-expr inner)
                    (bml-hati-lower-pool inner)))))

    (defn bml-hati-lower-save-in (pool env)
        (do
            (let snap (bml-hati-snapshot-expr (bml-bnml-snapshot-keys env (empty)) pool))
            (let marks (bml-hati-bnml-get (bml-bnml-marks-key) (bml-hati-lower-pool snap)))
            (bml-hati-then-top
                (bml-hati-bnml-set
                    (bml-bnml-marks-key)
                    (fk-cons (bml-hati-lower-expr snap) (bml-hati-lower-expr marks))
                    (bml-hati-lower-pool marks)))))

    (defn bml-hati-restore-sets (keys at snap pool)
        (if (nil? keys)
            (bml-hati-lower-result (fk-lit 0) pool)
            (do
                (let one (bml-hati-bnml-set (head keys) (fk-nth snap (fk-lit at)) pool))
                (let rest (bml-hati-restore-sets (tail keys) (add at 1) snap (bml-hati-lower-pool one)))
                (bml-hati-lower-result
                    (fk-sequence (bml-hati-lower-expr one) (bml-hati-lower-expr rest))
                    (bml-hati-lower-pool rest)))))

    (defn bml-hati-lower-restore-in (pool env)
        (do
            (let mark (bml-bnml-active-mark env 0))
            (if (nil? mark)
                (bml-hati-lower-result (fk-lit 0) pool)
                (do
                    (let keys
                        (append
                            (bml-bnml-snapshot-keys (bml-local-binding-env mark) (empty))
                            (list (bml-bnml-top-key))))
                    (let marks (bml-hati-bnml-get (bml-bnml-marks-key) pool))
                    (let sets
                        (bml-hati-restore-sets
                            keys
                            0
                            (fk-head (bml-hati-lower-expr marks))
                            (bml-hati-lower-pool marks)))
                    (let pop
                        (bml-hati-bnml-set
                            (bml-bnml-marks-key)
                            (fk-tail (bml-hati-lower-expr marks))
                            (bml-hati-lower-pool sets)))
                    (bml-hati-then-top
                        (bml-hati-lower-result
                            (fk-sequence (bml-hati-lower-expr sets) (bml-hati-lower-expr pop))
                            (bml-hati-lower-pool pop)))))))

    (defn bml-hati-lower-discard-in (pool env)
        (do
            (let marks (bml-hati-bnml-get (bml-bnml-marks-key) pool))
            (bml-hati-then-top
                (bml-hati-bnml-set
                    (bml-bnml-marks-key)
                    (fk-tail (bml-hati-lower-expr marks))
                    (bml-hati-lower-pool marks)))))

    (defn bml-hati-lower-name-node-in (node pool env)
        (do
            (let binding (bml-local-lookup env (bml-local-name node)))
            (if (bml-bnml-binding? binding)
                (do
                    (let slot
                        (bml-hati-pool-ensure pool (bml-local-binding-key binding)))
                    (bml-hati-lower-result
                        (fk-rget
                            (bml-hati-bnml-frame-expr)
                            (fk-slit
                                (bml-hati-pool-entry-index slot)
                                (bml-local-binding-key binding)))
                        (bml-hati-pool-entry-pool slot)))
                (bml-hati-lower-name-in node pool env))))

    (defn bml-hati-lower-const-node-in (node pool env)
        (if (bml-bnml-reads-mutable? (bml-local-const-value node) env)
            (bml-hati-lower-bnml-store
                (bml-bnml-new-key (bml-local-const-name node) env)
                (bml-local-const-value node)
                pool
                env)
            (bml-hati-lower-node-in-env (bml-local-const-value node) pool env)))

    (defn bml-hati-lower-call-node-in (node pool env)
        (if (bml-bnml-top-node? node)
            (bml-hati-lower-top node pool env)
            (bml-hati-lower-call-node-core node pool env)))

    (defn bml-hati-lower-call-node-core (node pool env)
        (if (bml-bnml-declare-node? node)
            (bml-hati-lower-bnml-store
                (bml-bnml-new-key (bml-bnml-target-name node) env)
                (bml-bnml-value node)
                pool
                env)
        (if (bml-bnml-assign-node? node)
            (bml-hati-lower-bnml-store
                (bml-bnml-assign-key node env)
                (bml-bnml-value node)
                pool
                env)
        (if (bml-index-node? node)
            (do
                (let target
                    (bml-hati-lower-node-in-env (bml-index-target node) pool env))
                (let at
                    (bml-hati-lower-node-in-env
                        (bml-index-at node)
                        (bml-hati-lower-pool target)
                        env))
                (bml-hati-lower-result
                    (fk-nth (bml-hati-lower-expr target) (bml-hati-lower-expr at))
                    (bml-hati-lower-pool at)))
        (if (bml-list-set-node? node)
            (bml-hati-lower-list-set node pool env)
            (bml-hati-lower-call-in node pool env))))))

    (defn bml-hati-lower-list-set (node pool env)
        (do
            (let target
                (bml-hati-lower-node-in-env (bml-index-target node) pool env))
            (let at
                (bml-hati-lower-node-in-env
                    (bml-index-at node)
                    (bml-hati-lower-pool target)
                    env))
            (let value
                (bml-hati-lower-node-in-env
                    (bml-list-set-value node)
                    (bml-hati-lower-pool at)
                    env))
            (bml-hati-lower-result
                (fk-icall
                    (fk-cons (bml-hati-list-set-slot) (fk-cons (fk-lit 3) (fk-empty)))
                    (fk-cons
                        (bml-hati-lower-expr target)
                        (fk-cons
                            (bml-hati-lower-expr at)
                            (fk-cons (bml-hati-lower-expr value) (fk-empty)))))
                (bml-hati-lower-pool value))))

    ;; An element assignment calls one shared list-set function. A table
    ;; that needs it carries it last, and every call site reads that index.
    (defn bml-hati-list-set-slot ()
        (fk-node 24 (ms-intern (ms-cell 0) (intern_trivial_string "__bml_list_set_fn"))))

    (defn bml-hati-list-set-fn (self-index)
        (do
            (let xs (fk-nth (fk-arg) (fk-lit 0)))
            (let at (fk-nth (fk-arg) (fk-lit 1)))
            (let value (fk-nth (fk-arg) (fk-lit 2)))
            (fk-if
                (fk-node 102 (ms-intern (fk-len xs) (fk-lit 0)))
                xs
                (fk-if
                    (fk-node 102 (ms-intern at (fk-lit 0)))
                    (fk-cons value (fk-tail xs))
                    (fk-cons
                        (fk-head xs)
                        (fk-icall
                            (fk-cons
                                (fk-lit self-index)
                                (fk-cons (fk-lit 3) (fk-empty)))
                            (fk-cons
                                (fk-tail xs)
                                (fk-cons
                                    (fk-sub at (fk-lit 1))
                                    (fk-cons value (fk-empty))))))))))

    (defn bml-hati-mentions? (node needle)
        (if (node_eq node needle)
            true
            (bml-hati-any-mentions? (node_children node) needle)))

    (defn bml-hati-any-mentions? (nodes needle)
        (if (nil? nodes)
            false
            (if (bml-hati-mentions? (head nodes) needle)
                true
                (bml-hati-any-mentions? (tail nodes) needle))))

    (defn bml-hati-relink (node needle replacement)
        (if (node_eq node needle)
            replacement
            (if (eq (len (node_children node)) 0)
                node
                (intern_node
                    (node_category node)
                    (bml-hati-relink-all (node_children node) needle replacement)))))

    (defn bml-hati-relink-all (nodes needle replacement)
        (if (nil? nodes)
            (empty)
            (cons
                (bml-hati-relink (head nodes) needle replacement)
                (bml-hati-relink-all (tail nodes) needle replacement))))

    (defn bml-hati-link-list-set (fns)
        (if (bml-hati-any-mentions? fns (bml-hati-list-set-slot))
            (append
                (bml-hati-relink-all
                    fns
                    (bml-hati-list-set-slot)
                    (fk-lit (len fns)))
                (list (bml-hati-list-set-fn (len fns))))
            fns))

    (defn bml-hati-unsupported-name-node-in (node env)
        (if (bml-bnml-binding? (bml-local-lookup env (bml-local-name node)))
            (empty)
            (bml-hati-unsupported-name-in node env)))

    (defn bml-hati-unsupported-call-node-in (node env)
        (if (bml-bnml-declare-node? node)
            (bml-hati-unsupported-node-in (bml-bnml-value node) env)
        (if (bml-bnml-assign-node? node)
            (append
                (bml-hati-unsupported-assign-target (bml-bnml-target-name node) env)
                (bml-hati-unsupported-node-in (bml-bnml-value node) env))
        (if (if (bml-index-node? node) true (bml-list-set-node? node))
            (append
                (bml-hati-unsupported-call-args-in (bml-call-args node) env)
                (bml-hati-unsupported-index-shape node env))
            (bml-hati-unsupported-call-in node env)))))

    (defn bml-hati-unsupported-assign-target (name env)
        (do
            (let binding (bml-local-lookup env name))
            (if (nil? binding)
                (list "assign/unbound")
            (if (bml-bnml-binding? binding)
                (empty)
            (if (bml-hati-arg-node? (bml-local-binding-value binding))
                (empty)
            (if (bml-hati-arg-at-node? (bml-local-binding-value binding))
                (empty)
            (if (bml-hati-method-ref? (bml-local-binding-value binding))
                (list "assign/method")
                (list "assign/const"))))))))

    ;; What the compiler already sees of a value: an array literal and its
    ;; length, an int literal, another scalar, or nothing known (a
    ;; parameter, a call). A local reads as the binding its path holds; an
    ;; element set keeps its array's length.
    (defn bml-hati-static-value (node env)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-NAME)
                (do
                    (let binding (bml-local-lookup env (bml-local-name node)))
                    (if (nil? binding)
                        (list "unknown")
                    (if (bml-hati-arg-node? (bml-local-binding-value binding))
                        (list "unknown")
                    (if (bml-hati-arg-at-node? (bml-local-binding-value binding))
                        (list "unknown")
                    (if (bml-hati-method-ref? (bml-local-binding-value binding))
                        (list "unknown")
                        (bml-hati-static-value
                            (bml-local-binding-value binding)
                            (bml-local-binding-env binding)))))))
            (if (bml-list-set-node? node)
                (bml-hati-static-value (bml-index-target node) env)
            (if (node_eq cat BML-AST-ARRAY)
                (list "array" (len (node_children node)))
            (if (node_eq cat BML-AST-INT)
                (list "int" (node_value (bml-node-child node 0)))
            (if (node_eq cat BML-AST-FLOAT)
                (list "scalar")
            (if (node_eq cat BML-AST-STRING)
                (list "scalar")
            (if (node_eq cat BML-AST-CHAR)
                (list "scalar")
                (list "unknown"))))))))))

    (defn bml-hati-unsupported-index-shape (node env)
        (do
            (let target (bml-hati-static-value (bml-index-target node) env))
            (let at (bml-hati-static-value (bml-index-at node) env))
            (if (str_eq (head target) "array")
                (if (str_eq (head at) "int")
                    (if (lt (nth at 1) 0)
                        (list "index/out-of-range")
                        (if (ge (nth at 1) (nth target 1))
                            (list "index/out-of-range")
                            (empty)))
                    (empty))
            (if (str_eq (head target) "int")
                (list "index/not-array")
            (if (str_eq (head target) "scalar")
                (list "index/not-array")
                (empty))))))

    (defn bml-hati-lower-string-in (value pool)
        (do
            (let entry (bml-hati-pool-ensure pool value))
            (bml-hati-lower-result
                (fk-slit
                    (bml-hati-pool-entry-index entry)
                    value)
                (bml-hati-pool-entry-pool entry))))

    (defn bml-hati-node-fail? (node)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-FAIL)
                true
            (if (node_eq cat BML-AST-BLOCK)
                (if (eq (len (node_children node)) 1)
                    (bml-hati-node-fail? (head (node_children node)))
                    false)
                false))))

    (defn bml-hati-unsupported-reasons-text (reasons)
        (if (nil? reasons)
            ""
        (if (nil? (tail reasons))
            (head reasons)
            (str_concat
                (head reasons)
                (str_concat "," (bml-hati-unsupported-reasons-text (tail reasons)))))))

    (defn bml-hati-unsupported-table-file (image)
        (str_concat
            "BML-HATI-UNSUPPORTED "
            (bml-hati-unsupported-reasons-text
                (bml-hati-image-unsupported image))))

    (defn bml-hati-unsupported-nodes-in (nodes)
        (bml-hati-unsupported-nodes-in-env nodes (empty)))

    (defn bml-hati-unsupported-nodes-in-env (nodes env)
        (if (bml-ctl-function-entry? nodes env)
            (bml-ctl-unsupported-function nodes env)
            (bml-hati-unsupported-nodes-in-env-core nodes env)))

    (defn bml-hati-unsupported-nodes-in-env-core (nodes env)
        (if (nil? nodes)
            (empty)
            (append
                (bml-hati-unsupported-node-in (head nodes) env)
                (bml-hati-unsupported-nodes-in-env
                    (tail nodes)
                    (bml-local-env-after-node (head nodes) env)))))

    (defn bml-hati-unsupported-choose-in (branches)
        (bml-hati-unsupported-choose-in-env branches (empty)))

    (defn bml-hati-unsupported-choose-in-env (branches env)
        (if (nil? branches)
            (list "choose/no-success-branch")
            (if (bml-hati-node-fail? (head branches))
                (bml-hati-unsupported-choose-in-env (tail branches) env)
                (append
                    (bml-hati-unsupported-node-in (head branches) env)
                    (bml-hati-unsupported-nodes-in-env (tail branches) env)))))

    (defn bml-hati-unsupported-node (node)
        (bml-hati-unsupported-node-in node (empty)))

    (defn bml-hati-arg-node ()
        (bml-ast-call "__hati_arg" (bml-ast-int 0)))

    (defn bml-hati-arg-node? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (str_eq (bml-call-name node) "__hati_arg")
            false))

    (defn bml-hati-arg-at-node (index)
        (bml-ast-call "__hati_arg_at" (bml-ast-int index)))

    (defn bml-hati-arg-at-node? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (str_eq (bml-call-name node) "__hati_arg_at")
            false))

    (defn bml-hati-arg-at-index (node)
        (node_value (bml-node-child (bml-call-arg node) 0)))

    (defn bml-hati-field-get-node? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (str_eq (bml-call-name node) "__hati_field_get")
            false))

    (defn bml-hati-field-set-node? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (str_eq (bml-call-name node) "__hati_field_set")
            false))

    (defn bml-hati-method-ref (index arity)
        (bml-ast-call-args
            "__hati_method"
            (list (bml-ast-int index) (bml-ast-int arity))))

    (defn bml-hati-method-ref? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (str_eq (bml-call-name node) "__hati_method")
            false))

    (defn bml-hati-method-ref-index (node)
        (do
            (let arg (bml-call-arg node))
            (if (node_eq (node_category arg) BML-AST-ARRAY)
                (node_value (bml-node-child (head (node_children arg)) 0))
                (node_value (bml-node-child arg 0)))))

    (defn bml-hati-method-ref-arity (node)
        (do
            (let arg (bml-call-arg node))
            (if (node_eq (node_category arg) BML-AST-ARRAY)
                (node_value (bml-node-child (head (tail (node_children arg))) 0))
                1)))

    (defn bml-hati-method-binding-for-arity (env name arity)
        (bml-hati-method-binding-for-arity-in
            env
            (bml-scope-resolve-name env name)
            arity))

    (defn bml-hati-method-binding-for-arity-in (env name arity)
        (if (nil? env)
            (empty)
            (do
                (let binding (head env))
                (let value (bml-local-binding-value binding))
                (if (str_eq (bml-local-binding-name binding) name)
                    (if (bml-hati-method-ref? value)
                        (if (eq (bml-hati-method-ref-arity value) arity)
                            binding
                            (bml-hati-method-binding-for-arity-in
                                (tail env)
                                name
                                arity))
                        (bml-hati-method-binding-for-arity-in
                            (tail env)
                            name
                            arity))
                    (bml-hati-method-binding-for-arity-in
                        (tail env)
                        name
                        arity)))))

    (defn bml-hati-bind-methods (methods env index)
        (if (nil? methods)
            env
            (bml-hati-bind-methods
                (tail methods)
                (cons
                    (bml-local-binding
                        (bml-method-node-name (head methods))
                        (bml-hati-method-ref
                            index
                            (len (bml-method-node-parameters (head methods))))
                        env)
                    env)
                (add index 1))))

    (defn bml-hati-method-param-env (method-node env)
        (bml-ctl-bind-fn-index
            method-node
            env
            (bml-hati-method-param-env-bind method-node env)))

    (defn bml-hati-method-param-env-bind (method-node env)
        (do
            (let params (bml-method-node-parameters method-node))
            (if (le (len params) 1)
                (do
                    (let param-name (bml-method-node-first-parameter-name method-node))
                    (if (str_eq param-name "")
                        env
                        (cons
                            (bml-local-binding
                                param-name
                                (bml-hati-arg-node)
                                env)
                            env)))
                (bml-hati-method-param-env-many (list params 0) env))))

    (defn bml-hati-method-param-env-many (state env)
        (do
            (let params (head state))
            (let index (head (tail state)))
            (if (nil? params)
                env
                (bml-hati-method-param-env-many
                    (list (tail params) (add index 1))
                    (cons
                        (bml-local-binding
                            (bml-parameter-name (head params))
                            (bml-hati-arg-at-node index)
                            env)
                        env)))))

    (defn bml-node-method? (node)
        (node_eq (node_category node) BML-AST-METHOD))

    (defn bml-node-field? (node)
        (node_eq (node_category node) BML-AST-FIELD))

    (defn bml-hati-method-nodes (nodes)
        (if (nil? nodes)
            (empty)
            (if (bml-node-method? (head nodes))
                (cons (head nodes) (bml-hati-method-nodes (tail nodes)))
                (bml-hati-method-nodes (tail nodes)))))

    (defn bml-hati-main-nodes (nodes)
        (if (nil? nodes)
            (empty)
            (if (bml-node-method? (head nodes))
                (bml-hati-main-nodes (tail nodes))
                (cons (head nodes) (bml-hati-main-nodes (tail nodes))))))

    (defn bml-hati-field-nodes (nodes)
        (if (nil? nodes)
            (empty)
            (if (bml-node-field? (head nodes))
                (cons (head nodes) (bml-hati-field-nodes (tail nodes)))
                (bml-hati-field-nodes (tail nodes)))))

    (defn bml-hati-unsupported-methods-in (methods env)
        (if (nil? methods)
            (empty)
            (append
                (bml-hati-unsupported-node-in
                    (bml-method-node-body (head methods))
                    (bml-hati-method-param-env (head methods) env))
                (bml-hati-unsupported-methods-in (tail methods) env))))

    (defn bml-hati-unsupported-name-in (node env)
        (do
            (let binding (bml-local-lookup env (bml-local-name node)))
            (if (nil? binding)
                (list "name/unbound")
            (if (bml-hati-arg-node? (bml-local-binding-value binding))
                (empty)
            (if (bml-hati-method-ref? (bml-local-binding-value binding))
                (list "name/method")
                (bml-hati-unsupported-node-in
                    (bml-local-binding-value binding)
                    (bml-local-binding-env binding)))))))

    (defn bml-hati-unsupported-call-in (node env)
        (if (bml-hati-arg-node? node)
            (empty)
        (if (bml-hati-arg-at-node? node)
            (empty)
        (if (bml-hati-field-get-node? node)
            (if (eq (len (bml-call-args node)) 1)
                (bml-hati-unsupported-call-args-in (bml-call-args node) env)
                (list "field/get-arity"))
        (if (bml-hati-field-set-node? node)
            (if (eq (len (bml-call-args node)) 2)
                (bml-hati-unsupported-call-args-in (bml-call-args node) env)
                (list "field/set-arity"))
            (do
                (let binding (bml-local-lookup env (bml-call-name node)))
                (if (nil? binding)
                    (list (bml-scope-unbound-call-reason env (bml-call-name node)))
                (if (bml-hati-method-ref? (bml-local-binding-value binding))
                    (if (nil?
                            (bml-hati-method-binding-for-arity
                                env
                                (bml-call-name node)
                                (len (bml-call-args node))))
                        (list "call/arity")
                        (bml-hati-unsupported-call-args-in
                            (bml-call-args node)
                            env))
                    (list "call/not-method")))))))))

    (defn bml-hati-unsupported-call-args-in (args env)
        (if (nil? args)
            (empty)
            (append
                (bml-hati-unsupported-node-in (head args) env)
                (bml-hati-unsupported-call-args-in (tail args) env))))

    (defn bml-hati-unsupported-node-in (node env)
        (if (bml-ctl-expr-node? node)
            (bml-ctl-unsupported-reserved node env)
        (if (bml-ctl-statement-node? node)
            (if (bml-ctl-env-active? env)
                (list "control/nested")
                (bml-ctl-unsupported-function (list node) env))
            (bml-hati-unsupported-node-in-core node env))))

    (defn bml-hati-unsupported-node-in-core (node env)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-INT)
                (empty)
            (if (node_eq cat BML-AST-FLOAT)
                (empty)
            (if (node_eq cat BML-AST-STRING)
                (empty)
            (if (node_eq cat BML-AST-CHAR)
                (empty)
            (if (node_eq cat BML-AST-ADD)
                (append
                    (bml-hati-unsupported-node-in (bml-node-child node 0) env)
                    (bml-hati-unsupported-node-in (bml-node-child node 1) env))
            (if (node_eq cat BML-AST-CONST)
                (bml-hati-unsupported-node-in (bml-local-const-value node) env)
            (if (node_eq cat BML-AST-NAME)
                (bml-hati-unsupported-name-node-in node env)
            (if (node_eq cat BML-AST-CALL)
                (bml-hati-unsupported-call-node-in node env)
            (if (node_eq cat BML-AST-RETURN)
                (bml-hati-unsupported-node-in (bml-node-child node 0) env)
            (if (node_eq cat BML-AST-METHOD)
                (bml-hati-unsupported-node-in
                    (bml-method-node-body node)
                    (bml-hati-method-param-env node env))
            (if (node_eq cat BML-AST-BLOCK)
                (bml-hati-unsupported-nodes-in-env (node_children node) env)
            (if (node_eq cat BML-AST-CHOOSE)
                (bml-hati-unsupported-choose-in-env (node_children node) env)
            (if (node_eq cat BML-AST-PACKAGE)
                (list "package/outside-unit")
            (if (node_eq cat BML-AST-IMPORT)
                (list "import/outside-unit")
            (if (node_eq cat BML-AST-INTERFACE)
                (list "interface")
            (if (node_eq cat BML-AST-CLASS)
                (bml-hati-unsupported-class-in node env)
            (if (node_eq cat BML-AST-SECTION)
                (bml-hati-unsupported-section-in node env)
            (if (node_eq cat BML-AST-FIELD)
                (empty)
            (if (node_eq cat BML-AST-ARRAY)
                (bml-hati-unsupported-call-args-in (node_children node) env)
            (if (node_eq cat BML-AST-WHILE)
                (list "while")
            (if (node_eq cat BML-AST-FAIL)
                (list "fail")
            (if (node_eq cat BML-AST-CUT)
                (list "cut")
            (if (node_eq cat BML-AST-SAVE)
                (empty)
            (if (node_eq cat BML-AST-RESTORE)
                (bml-bnml-mark-need env "restore/no-mark")
            (if (node_eq cat BML-AST-DISCARD)
                (bml-bnml-mark-need env "discard/no-mark")
                (list "unknown"))))))))))))))))))))))))))))

    (defn bml-hati-unsupported-section-in (node env)
        (bml-hati-unsupported-nodes-in-env
            (node_children (bml-node-child node 1))
            env))

    (defn bml-hati-class-method-nodes-loop (sections)
        (if (nil? sections)
            (empty)
            (append
                (bml-hati-method-nodes
                    (node_children (bml-node-child (head sections) 1)))
                (bml-hati-class-method-nodes-loop (tail sections)))))

    (defn bml-hati-class-method-nodes (node)
        (bml-hati-class-method-nodes-loop
            (node_children (bml-node-child node 2))))

    (defn bml-hati-class-field-nodes-loop (sections)
        (if (nil? sections)
            (empty)
            (append
                (bml-hati-field-nodes
                    (node_children (bml-node-child (head sections) 1)))
                (bml-hati-class-field-nodes-loop (tail sections)))))

    (defn bml-hati-class-field-nodes (node)
        (bml-hati-class-field-nodes-loop
            (node_children (bml-node-child node 2))))

    (defn bml-hati-construct-default-fields (fields self)
        (if (nil? fields)
            self
            (bml-hati-construct-default-fields
                (tail fields)
                (record_set self (bml-field-node-name (head fields)) 0))))

    (defn bml-hati-construct-class-defaults (node)
        (bml-hati-construct-default-fields
            (bml-hati-class-field-nodes node)
            (record_new
                (make_nodeid 1 9 2026 617)
                "bmlClass"
                (bml-class-node-name node))))

    (defn bml-hati-unsupported-class-in (node env)
        (do
            (let methods (bml-hati-class-method-nodes node))
            (let method-env (bml-hati-bind-methods methods env 0))
            (bml-hati-unsupported-methods-in methods method-env)))

    (defn bml-hati-lower-nodes-in (nodes pool)
        (bml-hati-lower-nodes-in-env nodes pool (empty)))

    (defn bml-hati-lower-nodes-in-env (nodes pool env)
        (if (bml-ctl-function-entry? nodes env)
            (bml-ctl-lower-function nodes pool env)
            (bml-hati-lower-nodes-in-env-core nodes pool env)))

    (defn bml-hati-lower-nodes-in-env-core (nodes pool env)
        (if (nil? nodes)
            (bml-hati-lower-result (fk-lit 0) pool)
        (if (nil? (tail nodes))
            (bml-hati-lower-node-in-env (head nodes) pool env)
            (do
                (let first (bml-hati-lower-node-in-env (head nodes) pool env))
                (let rest
                    (bml-hati-lower-nodes-in-env
                        (tail nodes)
                        (bml-hati-lower-pool first)
                        (bml-local-env-after-node (head nodes) env)))
                (bml-hati-lower-result
                    (fk-sequence
                        (bml-hati-lower-expr first)
                        (bml-hati-lower-expr rest))
                    (bml-hati-lower-pool rest))))))

    (defn bml-hati-lower-choose-in (branches pool)
        (bml-hati-lower-choose-in-env branches pool (empty)))

    (defn bml-hati-lower-choose-in-env (branches pool env)
        (if (nil? branches)
            (bml-hati-lower-result (fk-lit 0) pool)
            (if (bml-hati-node-fail? (head branches))
                (bml-hati-lower-choose-in-env (tail branches) pool env)
                (bml-hati-lower-node-in-env (head branches) pool env))))

    (defn bml-hati-lower-float-in (float-node pool)
        (do
            (let entry
                (bml-hati-pool-ensure
                    pool
                    (bml-hati-float-scale-literal)))
            (bml-hati-lower-result
                (fk-mul
                    (fk-lit (bml-hati-float-micros float-node))
                    (fk-f64
                        (bml-hati-pool-entry-index entry)
                        (bml-hati-float-scale-literal)))
                (bml-hati-pool-entry-pool entry))))

    (defn bml-hati-lower-node-in (node pool)
        (bml-hati-lower-node-in-env node pool (empty)))

    (defn bml-hati-lower-name-in (node pool env)
        (do
            (let binding (bml-local-lookup env (bml-local-name node)))
            (if (nil? binding)
                (bml-hati-lower-refusal "name/unbound" pool)
            (if (bml-hati-arg-node? (bml-local-binding-value binding))
                (bml-hati-lower-result (fk-arg) pool)
            (if (bml-hati-method-ref? (bml-local-binding-value binding))
                (bml-hati-lower-refusal "name/method" pool)
                (bml-hati-lower-node-in-env
                    (bml-local-binding-value binding)
                    pool
                    (bml-local-binding-env binding)))))))

    (defn bml-hati-lower-method-ref-call (node method-ref pool env)
        (do
            (let arg
                (bml-hati-lower-node-in-env
                    (if (eq (bml-hati-method-ref-arity method-ref) 1)
                        (head (bml-call-args node))
                        (bml-call-arg node))
                    pool
                    env))
            (bml-hati-lower-result
                (if (le (bml-hati-method-ref-arity method-ref) 1)
                    (fk-call
                        (bml-hati-method-ref-index method-ref)
                        (bml-hati-lower-expr arg))
                    (fk-icall
                        (fk-cons
                            (fk-lit (bml-hati-method-ref-index method-ref))
                            (fk-cons
                                (fk-lit (bml-hati-method-ref-arity method-ref))
                                (fk-empty)))
                        (bml-hati-lower-expr arg)))
                (bml-hati-lower-pool arg))))

    (defn bml-hati-lower-call-in (node pool env)
        (if (bml-hati-arg-node? node)
            (bml-hati-lower-result (fk-arg) pool)
        (if (bml-hati-arg-at-node? node)
            (bml-hati-lower-result
                (fk-nth
                    (fk-arg)
                    (fk-lit (bml-hati-arg-at-index node)))
                pool)
        (if (bml-hati-field-get-node? node)
            (do
                (let key (bml-hati-lower-node-in-env (bml-call-arg node) pool env))
                (bml-hati-lower-result
                    (fk-rget (fk-arg) (bml-hati-lower-expr key))
                    (bml-hati-lower-pool key)))
        (if (bml-hati-field-set-node? node)
            (do
                (let args (bml-call-args node))
                (let key (bml-hati-lower-node-in-env (head args) pool env))
                (let value
                    (bml-hati-lower-node-in-env
                        (head (tail args))
                        (bml-hati-lower-pool key)
                        env))
                (bml-hati-lower-result
                    (fk-rset
                        (fk-arg)
                        (bml-hati-lower-expr key)
                        (bml-hati-lower-expr value))
                    (bml-hati-lower-pool value)))
            (do
                (let binding (bml-local-lookup env (bml-call-name node)))
                (if (nil? binding)
                    (bml-hati-lower-refusal
                        (bml-scope-unbound-call-reason env (bml-call-name node))
                        pool)
                (if (bml-hati-method-ref? (bml-local-binding-value binding))
                    (do
                        (let method-binding
                            (bml-hati-method-binding-for-arity
                                env
                                (bml-call-name node)
                                (len (bml-call-args node))))
                        (if (nil? method-binding)
                            (bml-hati-lower-refusal "call/arity" pool)
                            (bml-hati-lower-method-ref-call
                                node
                                (bml-local-binding-value method-binding)
                                pool
                                env)))
                    (bml-hati-lower-refusal "call/not-method" pool)))))))))

    (defn bml-hati-lower-array-in (nodes pool env)
        (if (nil? nodes)
            (bml-hati-lower-result (fk-empty) pool)
            (do
                (let first (bml-hati-lower-node-in-env (head nodes) pool env))
                (let rest
                    (bml-hati-lower-array-in
                        (tail nodes)
                        (bml-hati-lower-pool first)
                        env))
                (bml-hati-lower-result
                    (fk-cons
                        (bml-hati-lower-expr first)
                        (bml-hati-lower-expr rest))
                    (bml-hati-lower-pool rest)))))

    (defn bml-hati-lower-node-in-env (node pool env)
        (if (bml-ctl-expr-node? node)
            (bml-ctl-lower-reserved node pool env)
        (if (bml-ctl-statement-node? node)
            (if (bml-ctl-env-active? env)
                (bml-hati-lower-refusal "control/nested" pool)
                (bml-ctl-lower-function (list node) pool env))
            (bml-hati-lower-node-in-env-core node pool env))))

    (defn bml-hati-lower-node-in-env-core (node pool env)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-INT)
                (bml-hati-lower-result
                    (fk-lit (node_value (bml-node-child node 0)))
                    pool)
            (if (node_eq cat BML-AST-FLOAT)
                (bml-hati-lower-float-in (bml-node-child node 0) pool)
            (if (node_eq cat BML-AST-STRING)
                (bml-hati-lower-string-in
                    (node_value (bml-node-child node 0))
                    pool)
            (if (node_eq cat BML-AST-CHAR)
                (bml-hati-lower-string-in
                    (node_value (bml-node-child node 0))
                    pool)
            (if (node_eq cat BML-AST-ARRAY)
                (bml-hati-lower-array-in (node_children node) pool env)
            (if (node_eq cat BML-AST-ADD)
                (do
                    (let left (bml-hati-lower-node-in-env (bml-node-child node 0) pool env))
                    (let right
                        (bml-hati-lower-node-in-env
                            (bml-node-child node 1)
                            (bml-hati-lower-pool left)
                            env))
                    (bml-hati-lower-result
                        (fk-add
                            (bml-hati-lower-expr left)
                            (bml-hati-lower-expr right))
                        (bml-hati-lower-pool right)))
            (if (node_eq cat BML-AST-CONST)
                (bml-hati-lower-const-node-in node pool env)
            (if (node_eq cat BML-AST-NAME)
                (bml-hati-lower-name-node-in node pool env)
            (if (node_eq cat BML-AST-CALL)
                (bml-hati-lower-call-node-in node pool env)
            (if (node_eq cat BML-AST-RETURN)
                (bml-hati-lower-node-in-env (bml-node-child node 0) pool env)
            (if (node_eq cat BML-AST-METHOD)
                (bml-hati-lower-method-body-in node pool env)
            (if (node_eq cat BML-AST-BLOCK)
                (bml-hati-lower-nodes-in-env (node_children node) pool env)
            (if (node_eq cat BML-AST-CHOOSE)
                (bml-hati-lower-choose-in-env (node_children node) pool env)
            (if (node_eq cat BML-AST-WHILE)
                (bml-hati-lower-result (fk-lit 0) pool)
            (if (node_eq cat BML-AST-FAIL)
                (bml-hati-lower-result (fk-lit 0) pool)
            (if (node_eq cat BML-AST-CUT)
                (bml-hati-lower-result (fk-lit 0) pool)
            (if (node_eq cat BML-AST-SAVE)
                (bml-hati-lower-save-in pool env)
            (if (node_eq cat BML-AST-RESTORE)
                (bml-hati-lower-restore-in pool env)
            (if (node_eq cat BML-AST-DISCARD)
                (bml-hati-lower-discard-in pool env)
                (bml-hati-lower-result (fk-lit 0) pool))))))))))))))))))))))

    (defn bml-hati-compile-class-image (node)
        (do
            (let methods (bml-hati-class-method-nodes node))
            (let method-env (bml-hati-bind-methods methods (empty) 0))
            (let unsupported (bml-hati-unsupported-methods-in methods method-env))
            (let methods-lowered
                (bml-hati-lower-methods-in methods (empty) method-env))
            (bml-hati-image
                (bml-hati-fns-result-fns methods-lowered)
                (bml-hati-fns-result-pool methods-lowered)
                node
                unsupported)))

    (defn bml-hati-class-method-index-loop (methods name index)
        (if (nil? methods)
            -1
            (if (str_eq (bml-method-node-name (head methods)) name)
                index
                (bml-hati-class-method-index-loop
                    (tail methods)
                    name
                    (add index 1)))))

    (defn bml-hati-class-method-index (node name)
        (bml-hati-class-method-index-loop
            (bml-hati-class-method-nodes node)
            name
            0))

    (defn bml-hati-class-method-index-arity-loop (methods name arity index)
        (if (nil? methods)
            -1
            (if (str_eq (bml-method-node-name (head methods)) name)
                (if (eq (len (bml-method-node-parameters (head methods))) arity)
                    index
                    (bml-hati-class-method-index-arity-loop
                        (tail methods)
                        name
                        arity
                        (add index 1)))
                (bml-hati-class-method-index-arity-loop
                    (tail methods)
                    name
                    arity
                    (add index 1)))))

    (defn bml-hati-class-method-index-arity (node name arity)
        (bml-hati-class-method-index-arity-loop
            (bml-hati-class-method-nodes node)
            name
            arity
            0))

    (defn bml-hati-run-class-method-with-arg (node method-name arg)
        (do
            (let image (bml-hati-compile-class-image node))
            (let method-index (bml-hati-class-method-index node method-name))
            (if (not (bml-hati-image-supported? image))
                (bml-hati-unsupported-table-file image)
            (if (eq method-index -1)
                "BML-HATI-UNSUPPORTED method/not-found"
                (fkm-walk
                    (bml-hati-image-fns image)
                    (nth (bml-hati-image-fns image) method-index)
                    arg)))))

    (defn bml-hati-run-class-method-with-arg-arity (node method-name arity arg)
        (do
            (let image (bml-hati-compile-class-image node))
            (let method-index
                (bml-hati-class-method-index-arity node method-name arity))
            (if (not (bml-hati-image-supported? image))
                (bml-hati-unsupported-table-file image)
            (if (eq method-index -1)
                "BML-HATI-UNSUPPORTED method/arity-not-found"
                (fkm-walk
                    (bml-hati-image-fns image)
                    (nth (bml-hati-image-fns image) method-index)
                    arg)))))

    (defn bml-hati-lower-methods-in (methods pool env)
        (if (nil? methods)
            (bml-hati-fns-result (empty) pool)
            (do
                (let first
                    (bml-hati-lower-method-body-in (head methods) pool env))
                (let rest
                    (bml-hati-lower-methods-in
                        (tail methods)
                        (bml-hati-lower-pool first)
                        env))
                (bml-hati-fns-result
                    (cons
                        (bml-hati-lower-expr first)
                        (bml-hati-fns-result-fns rest))
                    (bml-hati-fns-result-pool rest)))))

    (defn bml-hati-compile-block-image (node)
        (bml-scope-compile-block-image node (empty)))

    (defn bml-hati-compile-image (node)
        (do
            (if (node_eq (node_category node) BML-AST-BLOCK)
                (bml-hati-compile-block-image node)
            (if (node_eq (node_category node) BML-AST-CLASS)
                (bml-hati-compile-class-image node)
                (do
                    (let unsupported (bml-hati-unsupported-node node))
                    (let lowered
                        (bml-hati-bnml-body-in
                            (list node)
                            (bml-hati-lower-node-in (bml-bnml-top-body-node node) (empty))))
                    (bml-hati-image
                        (list (bml-hati-lower-expr lowered))
                        (bml-hati-lower-pool lowered)
                        node
                        unsupported))))))

    (defn bml-hati-compile-program (node)
        (do
            (let image (bml-hati-compile-image node))
            (if (bml-hati-image-supported? image)
                (bml-hati-image-fns image)
                (bml-hati-unsupported-table-file image))))

    (defn bml-hati-run-value (node)
        (do
            (let image (bml-hati-compile-image node))
            (if (bml-hati-image-supported? image)
                (fkm-run (bml-hati-image-fns image) 0)
                (bml-hati-unsupported-table-file image))))

    (defn bml-hati-run-value-with-arg (node arg)
        (do
            (let image (bml-hati-compile-image node))
            (if (bml-hati-image-supported? image)
                (fkm-run (bml-hati-image-fns image) arg)
                (bml-hati-unsupported-table-file image))))

    (defn bml-hati-table-file (image)
        (if (bml-hati-image-supported? image)
            (fks-table-file
                (bml-hati-image-fns image)
                (bml-hati-image-pool image))
            (bml-hati-unsupported-table-file image)))

    (defn bml-hati-table-file-from-node (node)
        (bml-hati-table-file (bml-hati-compile-image node)))

    ;; --- package/import scope, general calls, many-argument methods ---
    ;; A source unit is a parsed block. Its package and import declarations
    ;; become bnii rows (bml-native-interface-package-import.fk) and those
    ;; rows decide which names each unit sees. Units reachable through
    ;; imports link into one Hati table: the importing unit's main is
    ;; function 0, its own methods follow, then each linked unit's methods
    ;; in link order. A name nothing in scope resolves lowers to a named
    ;; refusal literal, never to a zero.

    ;; source: package and import declarations, read from
    ;; bml-source-parse-general-step; the parameter count a method's
    ;; tokens promise, checked by bml-source-parse-method-body-step.

    (defn bml-source-scoped-fail (objects)
        (bml-source-parse-step false "" (empty) objects))

    ;; A path (package, import, a qualified reference) may begin with any
    ;; word: a name, a keyword, or a property word such as `native`.
    (defn bml-source-parse-path-name (objects)
        (if (bml-source-property-name-token? (head objects))
            (bml-source-parse-qualified-name-loop
                (tail objects)
                (bmf-object-value (head objects)))
            (list "" objects)))

    (defn bml-source-scoped-package (objects)
        (do
            (let name-parse (bml-source-parse-path-name (tail objects)))
            (let name (nth name-parse 0))
            (let rest (nth name-parse 1))
            (if (str_eq name "")
                (bml-source-scoped-fail objects)
                (if (bml-source-token-value? (head rest) ";")
                    (bml-source-parse-step
                        true
                        "package-scope"
                        (bml-ast-package name)
                        (tail rest))
                    (bml-source-scoped-fail objects)))))

    (defn bml-source-scoped-import (objects)
        (do
            (let name-parse (bml-source-parse-path-name (tail objects)))
            (let name (nth name-parse 0))
            (let rest (nth name-parse 1))
            (if (str_eq name "")
                (bml-source-scoped-fail objects)
            (if (bml-source-token-value? (head rest) ";")
                (bml-source-parse-step
                    true
                    "import-scope"
                    (bml-ast-import name "")
                    (tail rest))
            (if (bml-source-token-value? (head rest) ".*")
                (if (bml-source-token-value? (nth rest 1) ";")
                    (bml-source-parse-step
                        true
                        "import-star-scope"
                        (bml-ast-import name ".*")
                        (drop 2 rest))
                    (bml-source-scoped-fail objects))
                (bml-source-scoped-fail objects))))))

    (defn bml-source-scoped-comma-count (objects depth count)
        (if (nil? objects)
            count
            (do
                (let value (bmf-object-value (head objects)))
                (if (str_eq value "<")
                    (bml-source-scoped-comma-count (tail objects) (add depth 1) count)
                (if (str_eq value ">")
                    (bml-source-scoped-comma-count (tail objects) (sub depth 1) count)
                (if (str_eq value ",")
                    (bml-source-scoped-comma-count
                        (tail objects)
                        depth
                        (if (eq depth 0) (add count 1) count))
                    (bml-source-scoped-comma-count (tail objects) depth count)))))))

    ;; the parameter count the tokens promise: one more than the top-level
    ;; commas, zero for an empty list.
    (defn bml-source-scoped-parameter-count (objects)
        (if (nil? objects)
            0
            (add (bml-source-scoped-comma-count objects 0 0) 1)))

    ;; declaration stream: Package/Import/Interface components as bnii rows.

    (defn bml-model-with-scope (classes interfaces scope)
        (list "bml-model" classes interfaces scope))

    (defn bml-model-scope (model) (nth model 3))

    (defn bml-scope-suffix? (text suffix)
        (if (lt (str_len text) (str_len suffix))
            false
            (str_eq
                (substring text (sub (str_len text) (str_len suffix)) (str_len text))
                suffix)))

    (defn bml-source-declaration-import-module (name selector)
        (if (str_eq selector ".*")
            (if (bml-scope-suffix? name ".*")
                (substring name 0 (sub (str_len name) 2))
                name)
            name))

    (defn bml-source-declaration-import-rows (imports source)
        (if (nil? imports)
            (empty)
            (do
                (let fields (comp-bml-fields (head imports)))
                (cons
                    (bnii-import
                        (bml-source-declaration-import-module (nth fields 0) (nth fields 1))
                        (nth fields 1)
                        source)
                    (bml-source-declaration-import-rows (tail imports) source)))))

    (defn bml-source-declaration-member-names (members)
        (if (nil? members)
            (empty)
            (do
                (let member (head members))
                (let rest (bml-source-declaration-member-names (tail members)))
                (if (bml-component-kind? member "Method")
                    (cons (nth (comp-bml-fields member) 1) rest)
                (if (bml-component-kind? member "Section")
                    (append
                        (bml-source-declaration-member-names
                            (nth (comp-bml-fields member) 2))
                        rest)
                    rest)))))

    (defn bml-source-declaration-interface-rows (interfaces source)
        (if (nil? interfaces)
            (empty)
            (do
                (let fields (comp-bml-fields (head interfaces)))
                (cons
                    (bnii-interface
                        (nth fields 0)
                        (nth fields 2)
                        (bml-source-declaration-member-names (nth fields 3))
                        (empty)
                        source)
                    (bml-source-declaration-interface-rows (tail interfaces) source)))))

    (defn bml-source-declaration-scope (nodes)
        (do
            (let packages (bml-components-of-kind nodes "Package"))
            (let source (bnii-source "bml" "" 0))
            (bnii-unit
                (bnii-package
                    (if (nil? packages) "" (head (comp-bml-fields (head packages))))
                    source)
                (bml-source-declaration-import-rows
                    (bml-components-of-kind nodes "Import")
                    source)
                (bml-source-declaration-interface-rows
                    (bml-components-of-kind nodes "Interface")
                    source))))

    ;; executable units: package/import nodes as bnii rows.

    (defn bml-scope-declaration? (node)
        (if (node_eq (node_category node) BML-AST-PACKAGE)
            true
            (node_eq (node_category node) BML-AST-IMPORT)))

    (defn bml-scope-unit-nodes (node)
        (if (node_eq (node_category node) BML-AST-BLOCK)
            (node_children node)
            (list node)))

    (defn bml-scope-nodes-of (nodes cat)
        (if (nil? nodes)
            (empty)
            (if (node_eq (node_category (head nodes)) cat)
                (cons (head nodes) (bml-scope-nodes-of (tail nodes) cat))
                (bml-scope-nodes-of (tail nodes) cat))))

    (defn bml-scope-main-nodes (nodes)
        (if (nil? nodes)
            (empty)
            (if (bml-node-method? (head nodes))
                (bml-scope-main-nodes (tail nodes))
            (if (bml-scope-declaration? (head nodes))
                (bml-scope-main-nodes (tail nodes))
                (cons (head nodes) (bml-scope-main-nodes (tail nodes)))))))

    (defn bml-scope-package-name (nodes)
        (do
            (let packages (bml-scope-nodes-of nodes BML-AST-PACKAGE))
            (if (nil? packages)
                ""
                (node_value (bml-node-child (head packages) 0)))))

    (defn bml-scope-import-rows (imports source)
        (if (nil? imports)
            (empty)
            (cons
                (bnii-import
                    (node_value (bml-node-child (head imports) 0))
                    (node_value (bml-node-child (head imports) 1))
                    source)
                (bml-scope-import-rows (tail imports) source))))

    (defn bml-scope-unit-rows-at (node path)
        (do
            (let nodes (bml-scope-unit-nodes node))
            (let source (bnii-source "bml" path 0))
            (bnii-unit
                (bnii-package (bml-scope-package-name nodes) source)
                (bml-scope-import-rows
                    (bml-scope-nodes-of nodes BML-AST-IMPORT)
                    source)
                (empty))))

    (defn bml-scope-unit-rows (node)
        (bml-scope-unit-rows-at node ""))

    (defn bml-scope-unit (pos node)
        (do
            (let nodes (bml-scope-unit-nodes node))
            (list "bml-scope-unit"
                  pos
                  (bml-scope-unit-rows node)
                  (bml-hati-method-nodes nodes)
                  (bml-scope-main-nodes nodes)
                  nodes)))

    (defn bml-scope-unit-pos (unit) (nth unit 1))
    (defn bml-scope-unit-rows-of (unit) (nth unit 2))
    (defn bml-scope-unit-methods (unit) (nth unit 3))
    (defn bml-scope-unit-mains (unit) (nth unit 4))
    (defn bml-scope-unit-all-nodes (unit) (nth unit 5))

    (defn bml-scope-unit-package (unit)
        (bnii-unit-package-name (bml-scope-unit-rows-of unit)))

    (defn bml-scope-unit-imports (unit)
        (bnii-unit-imports (bml-scope-unit-rows-of unit)))

    (defn bml-scope-units-from (units pos)
        (if (nil? units)
            (empty)
            (cons
                (bml-scope-unit pos (head units))
                (bml-scope-units-from (tail units) (add pos 1)))))

    ;; names: A.B.c has qualifier A.B and leaf c.

    (defn bml-scope-last-dot-from (name from found)
        (do
            (let at (str_find name "." from))
            (if (lt at 0)
                found
                (bml-scope-last-dot-from name (add at 1) at))))

    (defn bml-scope-qualifier (name)
        (do
            (let at (bml-scope-last-dot-from name 0 -1))
            (if (lt at 0) "" (substring name 0 at))))

    (defn bml-scope-leaf (name)
        (do
            (let at (bml-scope-last-dot-from name 0 -1))
            (if (lt at 0) name (substring name (add at 1) (str_len name)))))

    (defn bml-scope-qualify (package name)
        (if (str_eq package "")
            name
            (str_concat (str_concat package ".") name)))

    (defn bml-scope-prefix? (text prefix)
        (eq (str_find text prefix 0) 0))

    ;; imports: `import P.*;` sees every symbol of package P by leaf and by
    ;; qualified name; `import P;` sees them qualified only; `import P.s;`
    ;; (or `import s;` for the default package) sees one symbol.

    (defn bml-scope-units-in (units package)
        (if (nil? units)
            (empty)
            (if (str_eq (bml-scope-unit-package (head units)) package)
                (cons (head units) (bml-scope-units-in (tail units) package))
                (bml-scope-units-in (tail units) package))))

    (defn bml-scope-methods-define? (methods name)
        (if (nil? methods)
            false
            (if (str_eq (bml-method-node-name (head methods)) name)
                true
                (bml-scope-methods-define? (tail methods) name))))

    (defn bml-scope-consts-define? (nodes name)
        (if (nil? nodes)
            false
            (if (node_eq (node_category (head nodes)) BML-AST-CONST)
                (if (str_eq (bml-local-const-name (head nodes)) name)
                    true
                    (bml-scope-consts-define? (tail nodes) name))
                (bml-scope-consts-define? (tail nodes) name))))

    (defn bml-scope-unit-defines? (unit name)
        (if (bml-scope-methods-define? (bml-scope-unit-methods unit) name)
            true
            (bml-scope-consts-define? (bml-scope-unit-mains unit) name)))

    (defn bml-scope-units-defining (units name)
        (if (nil? units)
            (empty)
            (if (bml-scope-unit-defines? (head units) name)
                (cons (head units) (bml-scope-units-defining (tail units) name))
                (bml-scope-units-defining (tail units) name))))

    (defn bml-scope-import-target (mode package symbol units)
        (list "bml-scope-import-target" mode package symbol units))

    (defn bml-scope-target-mode (target) (nth target 1))
    (defn bml-scope-target-package (target) (nth target 2))
    (defn bml-scope-target-symbol (target) (nth target 3))
    (defn bml-scope-target-units (target) (nth target 4))

    (defn bml-scope-resolve-import (all-units row)
        (do
            (let module (bnii-import-module row))
            (let package-units (bml-scope-units-in all-units module))
            (if (eq (bnii-import-star? row) 1)
                (bml-scope-import-target "star" module "" package-units)
            (if (not (nil? package-units))
                (bml-scope-import-target "package" module "" package-units)
                (bml-scope-import-target
                    "symbol"
                    (bml-scope-qualifier module)
                    (bml-scope-leaf module)
                    (bml-scope-units-defining
                        (bml-scope-units-in all-units (bml-scope-qualifier module))
                        (bml-scope-leaf module)))))))

    (defn bml-scope-import-units (all-units rows)
        (if (nil? rows)
            (empty)
            (append
                (bml-scope-target-units (bml-scope-resolve-import all-units (head rows)))
                (bml-scope-import-units all-units (tail rows)))))

    (defn bml-scope-unit-linked? (linked unit)
        (if (nil? linked)
            false
            (if (eq (bml-scope-unit-pos (head linked)) (bml-scope-unit-pos unit))
                true
                (bml-scope-unit-linked? (tail linked) unit))))

    ;; breadth-first over imports from the main unit, each unit once.
    (defn bml-scope-link-order (all-units pending linked)
        (if (nil? pending)
            (reverse-list linked)
            (do
                (let unit (head pending))
                (if (bml-scope-unit-linked? linked unit)
                    (bml-scope-link-order all-units (tail pending) linked)
                    (bml-scope-link-order
                        all-units
                        (append
                            (tail pending)
                            (bml-scope-import-units all-units (bml-scope-unit-imports unit)))
                        (cons unit linked))))))

    (defn bml-scope-symbol (package name ref node pos)
        (list "bml-scope-symbol" package name ref node pos))

    (defn bml-scope-symbol-package (symbol) (nth symbol 1))
    (defn bml-scope-symbol-name (symbol) (nth symbol 2))
    (defn bml-scope-symbol-ref (symbol) (nth symbol 3))
    (defn bml-scope-symbol-node (symbol) (nth symbol 4))
    (defn bml-scope-symbol-pos (symbol) (nth symbol 5))

    (defn bml-scope-method-symbols (unit methods index)
        (if (nil? methods)
            (empty)
            (cons
                (bml-scope-symbol
                    (bml-scope-unit-package unit)
                    (bml-method-node-name (head methods))
                    (bml-hati-method-ref
                        index
                        (len (bml-method-node-parameters (head methods))))
                    (head methods)
                    (bml-scope-unit-pos unit))
                (bml-scope-method-symbols unit (tail methods) (add index 1)))))

    (defn bml-scope-symbols-from (linked index)
        (if (nil? linked)
            (empty)
            (append
                (bml-scope-method-symbols
                    (head linked)
                    (bml-scope-unit-methods (head linked))
                    index)
                (bml-scope-symbols-from
                    (tail linked)
                    (add index (len (bml-scope-unit-methods (head linked))))))))

    (defn bml-scope-link (node units)
        (do
            (let main (bml-scope-unit 0 node))
            (let all-units (cons main (bml-scope-units-from units 1)))
            (let linked (bml-scope-link-order all-units (list main) (empty)))
            (list "bml-scope-link"
                  main
                  all-units
                  linked
                  (bml-scope-symbols-from linked 1))))

    (defn bml-scope-link-main (link) (nth link 1))
    (defn bml-scope-link-all (link) (nth link 2))
    (defn bml-scope-link-linked (link) (nth link 3))
    (defn bml-scope-link-symbols (link) (nth link 4))

    ;; environments: the package binding at the base, imported symbols over
    ;; it, the unit's own methods on top (so a local method shadows an
    ;; on-demand import). Hati binds method refs, BMA binds method nodes.

    (defn bml-scope-package-key (_x) "__bml_package")

    (defn bml-scope-link-key (_x) "__bml_link")

    ;; BMA inlines calls, so its env also carries the link and the lane's
    ;; symbols: a callee's body compiles in its own unit's env, rebuilt from
    ;; them at the call.
    (defn bml-scope-base-env (link unit symbols lane)
        (do
            (let held
                (if (str_eq lane "bma")
                    (list
                        (bml-local-binding
                            (bml-scope-link-key 0)
                            (list link symbols)
                            (empty)))
                    (empty)))
            (if (str_eq (bml-scope-unit-package unit) "")
                held
                (cons
                    (bml-local-binding
                        (bml-scope-package-key 0)
                        (bml-ast-package (bml-scope-unit-package unit))
                        (empty))
                    held))))

    ;; a const symbol carries its value node and the env that value reads
    (defn bml-scope-const-symbol (package name value env pos)
        (list "bml-scope-const" package name value env pos))

    (defn bml-scope-const-symbol? (symbol)
        (str_eq (head symbol) "bml-scope-const"))

    (defn bml-scope-symbol-value (symbol lane)
        (if (bml-scope-const-symbol? symbol)
            (nth symbol 3)
        (if (str_eq lane "bma")
            (bml-scope-symbol-node symbol)
            (bml-scope-symbol-ref symbol))))

    (defn bml-scope-symbol-env (symbol)
        (if (bml-scope-const-symbol? symbol)
            (nth symbol 4)
            (empty)))

    (defn bml-scope-bind (env name symbol lane)
        (cons
            (bml-local-binding
                name
                (bml-scope-symbol-value symbol lane)
                (bml-scope-symbol-env symbol))
            env))

    (defn bml-scope-bind-target-symbol (env target symbol lane)
        (do
            (let mode (bml-scope-target-mode target))
            (let package (bml-scope-symbol-package symbol))
            (let name (bml-scope-symbol-name symbol))
            (if (not (str_eq package (bml-scope-target-package target)))
                env
            (if (str_eq mode "package")
                (bml-scope-bind env (bml-scope-qualify package name) symbol lane)
            (if (str_eq mode "star")
                (bml-scope-bind
                    (bml-scope-bind env (bml-scope-qualify package name) symbol lane)
                    name
                    symbol
                    lane)
            (if (str_eq name (bml-scope-target-symbol target))
                (bml-scope-bind
                    (if (str_eq package "")
                        env
                        (bml-scope-bind env (bml-scope-qualify package name) symbol lane))
                    name
                    symbol
                    lane)
                env))))))

    (defn bml-scope-bind-target (env target symbols lane)
        (if (nil? symbols)
            env
            (bml-scope-bind-target
                (bml-scope-bind-target-symbol env target (head symbols) lane)
                target
                (tail symbols)
                lane)))

    (defn bml-scope-import-env (all-units rows symbols env lane)
        (if (nil? rows)
            env
            (bml-scope-import-env
                all-units
                (tail rows)
                symbols
                (bml-scope-bind-target
                    env
                    (bml-scope-resolve-import all-units (head rows))
                    symbols
                    lane)
                lane)))

    (defn bml-scope-own-env (symbols pos env lane)
        (if (nil? symbols)
            env
            (bml-scope-own-env
                (tail symbols)
                pos
                (if (eq (bml-scope-symbol-pos (head symbols)) pos)
                    (bml-scope-bind
                        env
                        (bml-scope-symbol-name (head symbols))
                        (head symbols)
                        lane)
                    env)
                lane)))

    (defn bml-scope-unit-env-with (link unit symbols lane)
        (bml-scope-own-env
            symbols
            (bml-scope-unit-pos unit)
            (bml-scope-import-env
                (bml-scope-link-all link)
                (bml-scope-unit-imports unit)
                symbols
                (bml-scope-base-env link unit symbols lane)
                lane)
            lane))

    ;; A unit's top-level consts, in source order, each bound to the env its
    ;; value reads: the unit's methods and imports and the consts before it.
    (defn bml-scope-consts-fold (nodes env unit acc)
        (if (nil? nodes)
            (reverse-list acc)
            (if (node_eq (node_category (head nodes)) BML-AST-CONST)
                (bml-scope-consts-fold
                    (tail nodes)
                    (bml-local-env-after-node (head nodes) env)
                    unit
                    (cons
                        (bml-scope-const-symbol
                            (bml-scope-unit-package unit)
                            (bml-local-const-name (head nodes))
                            (bml-local-const-value (head nodes))
                            env
                            (bml-scope-unit-pos unit))
                        acc))
                (bml-scope-consts-fold (tail nodes) env unit acc))))

    ;; Consts gather importee first (reverse link order), so a const built
    ;; from a const its unit imports finds that const already bound.
    (defn bml-scope-consts-loop (link units known lane)
        (if (nil? units)
            known
            (bml-scope-consts-loop
                link
                (tail units)
                (append
                    known
                    (bml-scope-consts-fold
                        (bml-scope-unit-mains (head units))
                        (bml-scope-unit-env-with
                            link
                            (head units)
                            (append (bml-scope-link-symbols link) known)
                            lane)
                        (head units)
                        (empty)))
                lane)))

    ;; every symbol a lane binds: the linked methods, then the linked consts
    (defn bml-scope-lane-symbols (link lane)
        (append
            (bml-scope-link-symbols link)
            (bml-scope-consts-loop
                link
                (reverse-list (bml-scope-link-linked link))
                (empty)
                lane)))

    (defn bml-scope-unit-env (link unit lane)
        (bml-scope-unit-env-with
            link
            unit
            (bml-scope-lane-symbols link lane)
            lane))

    ;; lookup: a name qualified by the unit's own package names its member.

    (defn bml-scope-own-name (env name)
        (if (lt (str_find name "." 0) 0)
            name
            (do
                (let binding (bml-local-lookup-direct env (bml-scope-package-key 0)))
                (if (nil? binding)
                    name
                    (do
                        (let prefix
                            (str_concat
                                (node_value
                                    (bml-node-child (bml-local-binding-value binding) 0))
                                "."))
                        (if (bml-scope-prefix? name prefix)
                            (substring name (str_len prefix) (str_len name))
                            name))))))

    (defn bml-scope-lookup-qualified (env name)
        (do
            (let own-name (bml-scope-own-name env name))
            (if (str_eq own-name name)
                (empty)
                (bml-local-lookup-direct env own-name))))

    (defn bml-scope-resolve-name (env name)
        (if (nil? (bml-local-lookup-direct env name))
            (bml-scope-own-name env name)
            name))

    ;; a receiver that is a bound value asks for class dispatch, a later
    ;; wave; a receiver nothing binds is an unbound call.
    (defn bml-scope-unbound-call-reason (env name)
        (do
            (let at (str_find name "." 0))
            (if (lt at 0)
                "call/unbound"
                (if (nil? (bml-local-lookup env (substring name 0 at)))
                    "call/unbound"
                    "call/receiver-dispatch"))))

    ;; refusals: the lowering names what it cannot resolve.

    (defn bml-hati-refusal-prefix (_x) "BML-HATI-UNSUPPORTED ")

    (defn bml-hati-lower-refusal (reason pool)
        (bml-hati-lower-string-in
            (str_concat (bml-hati-refusal-prefix 0) reason)
            pool))

    (defn bml-hati-pool-refusals (pool)
        (if (nil? pool)
            (empty)
            (do
                (let rest (bml-hati-pool-refusals (tail pool)))
                (if (bml-scope-prefix? (head pool) (bml-hati-refusal-prefix 0))
                    (cons
                        (substring
                            (head pool)
                            (str_len (bml-hati-refusal-prefix 0))
                            (str_len (head pool)))
                        rest)
                    rest))))

    (defn bml-hati-reasons-merge (reasons extra)
        (if (nil? extra)
            reasons
            (bml-hati-reasons-merge
                (if (fsc-string-list-contains? reasons (head extra))
                    reasons
                    (append reasons (list (head extra))))
                (tail extra))))

    ;; link reasons: a second package declaration, an import no unit meets.

    (defn bml-scope-import-reasons (all-units rows)
        (if (nil? rows)
            (empty)
            (append
                (if (nil? (bml-scope-target-units (bml-scope-resolve-import all-units (head rows))))
                    (list "import/unresolved")
                    (empty))
                (bml-scope-import-reasons all-units (tail rows)))))

    (defn bml-scope-unit-reasons (all-units unit)
        (append
            (if (gt (len (bml-scope-nodes-of (bml-scope-unit-all-nodes unit) BML-AST-PACKAGE)) 1)
                (list "package/duplicate")
                (empty))
            (bml-scope-import-reasons all-units (bml-scope-unit-imports unit))))

    (defn bml-scope-link-reasons-loop (all-units linked)
        (if (nil? linked)
            (empty)
            (append
                (bml-scope-unit-reasons all-units (head linked))
                (bml-scope-link-reasons-loop all-units (tail linked)))))

    (defn bml-scope-link-reasons (link)
        (bml-scope-link-reasons-loop
            (bml-scope-link-all link)
            (bml-scope-link-linked link)))

    ;; --- homes: the source units in the tree a name can come from -----
    ;; The walk reads the tree's own top-level directories; dot-directories
    ;; hold caches, scratch and other worktrees, and band helpers, seedbank
    ;; copies and toolchain trees are not units, so it passes them by.
    ;; A text match is only a candidate: the unit must parse and declare the
    ;; package, or define the name, before it counts as a home.

    (defn bml-scope-home-skips (_x)
        (list "tests" ".cache" "seedbank" "node_modules" "target"))

    (defn bml-scope-home-root? (name)
        (if (bml-scope-prefix? name ".") false (fs_is_dir name)))

    (defn bml-scope-home-paths (root rows needle acc)
        (if (nil? rows)
            acc
            (do
                (let path (str_concat root (str_concat "/" (head (head rows)))))
                (bml-scope-home-paths
                    root
                    (tail rows)
                    needle
                    (if (ge (str_find (read_file path) needle 0) 0)
                        (cons path acc)
                        acc)))))

    (defn bml-scope-home-roots (roots needle acc)
        (if (nil? roots)
            (reverse-list acc)
            (bml-scope-home-roots
                (tail roots)
                needle
                (if (bml-scope-home-root? (head roots))
                    (bml-scope-home-paths
                        (head roots)
                        (source_inventory (head roots) ".bml" (bml-scope-home-skips 0))
                        needle
                        acc)
                    acc))))

    (defn bml-scope-text-homes (needle)
        (bml-scope-home-roots (fs_list ".") needle (empty)))

    (defn bml-scope-load-unit (path)
        (bml-source-exec-parse-node
            (bml-source-parse-executable-stream (bml-source-scan-file path))))

    (defn bml-scope-paths-where (paths keep? key)
        (if (nil? paths)
            (empty)
            (if (keep? (bml-scope-unit 0 (bml-scope-load-unit (head paths))) key)
                (cons (head paths) (bml-scope-paths-where (tail paths) keep? key))
                (bml-scope-paths-where (tail paths) keep? key))))

    (defn bml-scope-declares-package? (unit package)
        (str_eq (bml-scope-unit-package unit) package))

    ;; the units that declare `package P;` -- an import's explicit home
    (defn bml-scope-package-homes (package)
        (bml-scope-paths-where
            (bml-scope-text-homes (str_concat "package " (str_concat package ";")))
            bml-scope-declares-package?
            package))

    ;; the units that define a name: evidence for a bare name no import
    ;; covers, never loaded on its behalf. A BML source unit counts when it
    ;; parses and defines the method or const; an organ counts by its own
    ;; `def name(` spelling.
    (defn bml-scope-name-homes (name)
        (bml-scope-new-homes
            (bml-scope-text-homes (str_concat "def " (str_concat name "(")))
            (empty)
            (bml-scope-paths-where
                (bml-scope-text-homes (str_concat name "("))
                bml-scope-unit-defines?
                name)))

    ;; the modules an import row asks for when no supplied unit answers it
    (defn bml-scope-unresolved-modules (all-units rows)
        (if (nil? rows)
            (empty)
            (if (nil? (bml-scope-target-units (bml-scope-resolve-import all-units (head rows))))
                (cons
                    (if (eq (bnii-import-star? (head rows)) 1)
                        (bnii-import-module (head rows))
                        (bml-scope-import-home-package all-units (head rows)))
                    (bml-scope-unresolved-modules all-units (tail rows)))
                (bml-scope-unresolved-modules all-units (tail rows)))))

    ;; `import P;` names package P itself; `import P.s;` asks for P's unit
    (defn bml-scope-import-home-package (all-units row)
        (do
            (let module (bnii-import-module row))
            (if (nil? (bml-scope-package-homes module))
                (bml-scope-qualifier module)
                module)))

    (defn bml-scope-link-unresolved-modules (link)
        (bml-scope-link-unresolved-loop
            (bml-scope-link-all link)
            (bml-scope-link-linked link)))

    (defn bml-scope-link-unresolved-loop (all-units linked)
        (if (nil? linked)
            (empty)
            (append
                (bml-scope-unresolved-modules all-units (bml-scope-unit-imports (head linked)))
                (bml-scope-link-unresolved-loop all-units (tail linked)))))

    (defn bml-scope-strings-hold? (values value)
        (if (nil? values)
            false
            (if (str_eq (head values) value)
                true
                (bml-scope-strings-hold? (tail values) value))))

    (defn bml-scope-new-homes (paths held acc)
        (if (nil? paths)
            acc
            (bml-scope-new-homes
                (tail paths)
                held
                (if (bml-scope-strings-hold? (append held acc) (head paths))
                    acc
                    (append acc (list (head paths)))))))

    (defn bml-scope-homes-of (modules)
        (if (nil? modules)
            (empty)
            (append
                (bml-scope-package-homes (head modules))
                (bml-scope-homes-of (tail modules)))))

    ;; Heal an import that resolves nowhere: load each unit that declares the
    ;; package it names, and repeat for the imports those units bring, until
    ;; no new home appears. Answers (list units loaded-paths still-missing);
    ;; the caller re-links and re-observes.
    (defn bml-scope-heal-imports (node units loaded)
        (do
            (let link (bml-scope-link node units))
            (let missing (bml-scope-link-unresolved-modules link))
            (let fresh (bml-scope-new-homes (bml-scope-homes-of missing) loaded (empty)))
            (if (nil? fresh)
                (list units loaded missing)
                (bml-scope-heal-imports
                    node
                    (append units (bml-scope-load-units fresh))
                    (append loaded fresh)))))

    (defn bml-scope-load-units (paths)
        (if (nil? paths)
            (empty)
            (cons
                (bml-scope-load-unit (head paths))
                (bml-scope-load-units (tail paths)))))

    ;; compile: the main unit plus every unit its imports reach.

    (defn bml-scope-linked-unsupported (link units symbols)
        (if (nil? units)
            (empty)
            (append
                (bml-hati-unsupported-methods-in
                    (bml-scope-unit-methods (head units))
                    (bml-scope-unit-env-with link (head units) symbols "hati"))
                (bml-scope-linked-unsupported link (tail units) symbols))))

    (defn bml-scope-lower-linked (link units symbols pool)
        (if (nil? units)
            (bml-hati-fns-result (empty) pool)
            (do
                (let first
                    (bml-hati-lower-methods-in
                        (bml-scope-unit-methods (head units))
                        pool
                        (bml-scope-unit-env-with link (head units) symbols "hati")))
                (let rest
                    (bml-scope-lower-linked
                        link
                        (tail units)
                        symbols
                        (bml-hati-fns-result-pool first)))
                (bml-hati-fns-result
                    (append
                        (bml-hati-fns-result-fns first)
                        (bml-hati-fns-result-fns rest))
                    (bml-hati-fns-result-pool rest)))))

    (defn bml-scope-compile-block-image (node units)
        (do
            (let link (bml-scope-link node units))
            (let main (bml-scope-link-main link))
            (let methods (bml-scope-unit-methods main))
            (let main-nodes (bml-scope-unit-mains main))
            (let symbols (bml-scope-lane-symbols link "hati"))
            (let method-env (bml-scope-unit-env-with link main symbols "hati"))
            (let others (tail (bml-scope-link-linked link)))
            (let unsupported
                (append
                    (bml-scope-link-reasons link)
                    (append
                        (bml-hati-unsupported-nodes-in-env main-nodes method-env)
                        (append
                            (bml-hati-unsupported-methods-in methods method-env)
                            (bml-scope-linked-unsupported link others symbols)))))
            (let main-lowered
                (bml-hati-bnml-body-in
                    main-nodes
                    (bml-hati-lower-nodes-in-env (bml-bnml-top-body main-nodes) (empty) method-env)))
            (let methods-lowered
                (bml-hati-lower-methods-in
                    methods
                    (bml-hati-lower-pool main-lowered)
                    method-env))
            (let others-lowered
                (bml-scope-lower-linked
                    link
                    others
                    symbols
                    (bml-hati-fns-result-pool methods-lowered)))
            (bml-hati-image
                (cons
                    (bml-hati-lower-expr main-lowered)
                    (append
                        (bml-hati-fns-result-fns methods-lowered)
                        (bml-hati-fns-result-fns others-lowered)))
                (bml-hati-fns-result-pool others-lowered)
                node
                unsupported)))

    (defn bml-hati-compile-unit-image (node units)
        (if (node_eq (node_category node) BML-AST-BLOCK)
            (bml-scope-compile-block-image node units)
            (bml-hati-compile-image node)))

    (defn bml-hati-run-unit-value (node units)
        (do
            (let image (bml-hati-compile-unit-image node units))
            (if (bml-hati-image-supported? image)
                (fkm-run (bml-hati-image-fns image) 0)
                (bml-hati-unsupported-table-file image))))

    (defn bml-compile-unit-program (node units)
        (do
            (let link (bml-scope-link node units))
            (comp-program
                "bma"
                (bml-bma-with-frame
                    (bml-bma-link-uses-locals? node link)
                    (bml-compile-node-in
                        node
                        (bml-scope-unit-env link (bml-scope-link-main link) "bma"))))))

    ;; A program whose units declare or assign opens the floor frame first.
    (defn bml-bma-with-frame (uses ops)
        (if uses (cons (bma-frame-init 0) ops) ops))

    (defn bml-bma-units-use-locals? (units)
        (if (nil? units)
            false
            (if (bml-bnml-any-uses-locals? (bml-scope-unit-all-nodes (head units)))
                true
                (bml-bma-units-use-locals? (tail units)))))

    (defn bml-bma-link-uses-locals? (node link)
        (if (bml-bnml-uses-locals? node)
            true
            (bml-bma-units-use-locals? (bml-scope-link-linked link))))

    ;; --- BMA: the same scope rule, inlined ---------------------------

    (defn bml-bma-refusal (reason)
        (list (bma-push-lit (str_concat (bml-hati-refusal-prefix 0) reason))))

    (defn bml-bma-method-value? (value)
        (node_eq (node_category value) BML-AST-METHOD))

    ;; A mutable local reads its slot in the frame on the stack floor; any
    ;; other name reads by substitution.
    (defn bml-compile-name-in (node env)
        (do
            (let binding (bml-local-lookup env (bml-local-name node)))
            (if (nil? binding)
                (bml-bma-refusal "name/unbound")
            (if (bml-bma-method-value? (bml-local-binding-value binding))
                (bml-bma-refusal "name/method")
            (if (bml-bnml-binding? binding)
                (list (bma-lget (bml-local-binding-key binding)))
                (bml-compile-node-in
                    (bml-local-binding-value binding)
                    (bml-local-binding-env binding)))))))

    (defn bml-bma-method-binding-for-arity (env name arity)
        (if (nil? env)
            (empty)
            (do
                (let binding (head env))
                (if (str_eq (bml-local-binding-name binding) name)
                    (if (bml-bma-method-value? (bml-local-binding-value binding))
                        (if (eq (len (bml-method-node-parameters
                                        (bml-local-binding-value binding)))
                                arity)
                            binding
                            (bml-bma-method-binding-for-arity (tail env) name arity))
                        (bml-bma-method-binding-for-arity (tail env) name arity))
                    (bml-bma-method-binding-for-arity (tail env) name arity)))))

    ;; parameters bind to argument nodes read in the caller's env, over the
    ;; callee's own env
    (defn bml-bma-bind-params (params args arg-env body-env)
        (if (or (nil? params) (nil? args))
            body-env
            (bml-bma-bind-params
                (tail params)
                (tail args)
                arg-env
                (cons
                    (bml-local-binding
                        (bml-parameter-name (head params))
                        (head args)
                        arg-env)
                    body-env))))

    (defn bml-scope-nodes-hold? (nodes node)
        (if (nil? nodes)
            false
            (if (node_eq (head nodes) node)
                true
                (bml-scope-nodes-hold? (tail nodes) node))))

    (defn bml-scope-home-unit (units method-node)
        (if (nil? units)
            (empty)
            (if (bml-scope-nodes-hold? (bml-scope-unit-methods (head units)) method-node)
                (head units)
                (bml-scope-home-unit (tail units) method-node))))

    ;; the env of the unit that defines a method, rebuilt from the link the
    ;; env carries; a method no linked unit holds at top level (one declared
    ;; in a nested block) reads the env it was reached from
    (defn bml-bma-home-env (method-node env)
        (do
            (let held (bml-local-lookup-direct env (bml-scope-link-key 0)))
            (if (nil? held)
                env
                (do
                    (let link (head (bml-local-binding-value held)))
                    (let symbols (head (tail (bml-local-binding-value held))))
                    (let home
                        (bml-scope-home-unit (bml-scope-link-linked link) method-node))
                    (if (nil? home)
                        env
                        (bml-scope-unit-env-with link home symbols "bma"))))))

    ;; refusals a BMA program carries; running it answers them the way a
    ;; Hati image does, before any op runs
    (defn bml-bma-refusal-text? (value)
        (if (str_eq (value_kind value) "string")
            (bml-scope-prefix? value (bml-hati-refusal-prefix 0))
            false))

    (defn bml-bma-op-refusals (op)
        (do
            (let name (comp-op-name op))
            (if (str_eq name "push-lit")
                (if (bml-bma-refusal-text? (comp-op-value op))
                    (list
                        (substring
                            (comp-op-value op)
                            (str_len (bml-hati-refusal-prefix 0))
                            (str_len (comp-op-value op))))
                    (empty))
            (if (or (str_eq name "choose") (str_eq name "try"))
                (bml-bma-branch-refusals (comp-op-value op))
            (if (str_eq name "while-success")
                (bml-bma-ops-refusals (comp-op-value op))
                (empty))))))

    (defn bml-bma-ops-refusals (ops)
        (if (nil? ops)
            (empty)
            (append
                (bml-bma-op-refusals (head ops))
                (bml-bma-ops-refusals (tail ops)))))

    (defn bml-bma-branch-refusals (branches)
        (if (nil? branches)
            (empty)
            (append
                (bml-bma-ops-refusals (head branches))
                (bml-bma-branch-refusals (tail branches)))))

    (defn bml-bma-run-unit-value (node units)
        (do
            (let program (bml-compile-unit-program node units))
            (let reasons
                (bml-hati-reasons-merge
                    (bml-hati-reasons-merge
                        (empty)
                        (bml-scope-link-reasons (bml-scope-link node units)))
                    (bml-bma-ops-refusals (comp-program-ops program))))
            (if (nil? reasons)
                (bma-run-value program)
                (str_concat
                    (bml-hati-refusal-prefix 0)
                    (bml-hati-unsupported-reasons-text reasons)))))

    ;; --- BML source control -> Hati native table ---------------------
    ;; A function body carrying source control lowers through one
    ;; Form-native protocol held in the run's memory cells: MODE (0 runs),
    ;; VALUE (a return's value), THROWN (a throw's value), DISPATCH (loop
    ;; re-entry) and FRAME (the bnml frame a re-entry carries). Every
    ;; transfer is a bml-native-source-control effect row (break -> stop,
    ;; continue -> choice, throw -> fail, return -> return): its mode is
    ;; the primitive's place in bnsc-required-primitives (a break/continue
    ;; also carries its target), a loop answers each effect as
    ;; bnsc-loop-step reads it, and a catch receives the effect
    ;; bnsc-try-catch turns into a value. A loop re-enters its own function
    ;; through DISPATCH (Form recursion) and binds frame slot 1 to the frame
    ;; it left; statements after a transfer are guarded by MODE; the
    ;; epilogue turns RETURN into the function's value and hands THROW
    ;; outward.

    (defn bml-ctl-mode-cell (_x) 4000)
    (defn bml-ctl-value-cell (_x) 4001)
    (defn bml-ctl-thrown-cell (_x) 4002)
    (defn bml-ctl-dispatch-cell (_x) 4003)
    (defn bml-ctl-frame-cell (_x) 4004)

    ; switch cells: a block of 1024 per function index
    (defn bml-ctl-var-cell (fn-index id)
        (add 4096 (add (mul fn-index 1024) id)))

    (defn bml-ctl-source (_x)
        (bnsc-source "bml" "form/form-stdlib/grammars/bml.fk" 0))

    (defn bml-ctl-index-of (value values index)
        (if (nil? values)
            -1
            (if (str_eq (head values) value)
                index
                (bml-ctl-index-of value (tail values) (add index 1)))))

    (defn bml-ctl-primitive-mode (primitive)
        (add 1 (bml-ctl-index-of primitive (bnsc-required-primitives 0) 0)))

    (defn bml-ctl-targeted-kind? (kind)
        (if (str_eq kind "break") true (str_eq kind "continue")))

    (defn bml-ctl-effect-mode (effect target-id)
        (if (bml-ctl-targeted-kind? (bnsc-effect-kind effect))
            (add (bml-ctl-primitive-mode (bnsc-effect-primitive effect))
                 (mul 8 target-id))
            (bml-ctl-primitive-mode (bnsc-effect-primitive effect))))

    (defn bml-ctl-break-mode (id)
        (bml-ctl-effect-mode (bnsc-break "" (bml-ctl-source 0)) id))

    (defn bml-ctl-continue-mode (id)
        (bml-ctl-effect-mode (bnsc-continue "" (bml-ctl-source 0)) id))

    (defn bml-ctl-throw-mode (_x)
        (bml-ctl-effect-mode (bnsc-throw 0 (bml-ctl-source 0)) 0))

    (defn bml-ctl-return-mode (_x)
        (bml-ctl-effect-mode (bnsc-value 0 (bml-ctl-source 0)) 0))

    (defn bml-ctl-catch-mode (_x)
        (if (str_eq
                (bnsc-effect-kind
                    (bnsc-try-catch
                        (bnsc-throw 0 (bml-ctl-source 0))
                        0
                        (bml-ctl-source 0)))
                "value")
            (bml-ctl-throw-mode 0)
            -1))

    (defn bml-ctl-loop-reaction (effect)
        (bnsc-loop-mode
            (bnsc-loop-step
                (bnsc-loop-state "running" "" 0 0 (bml-ctl-source 0))
                effect)))

    (defn bml-ctl-form-native-primitives (_x)
        (list "if" "recursion" "stop" "choice" "fail"))

    (defn bml-ctl-all-member? (values pool)
        (if (nil? values)
            true
            (if (lt (bml-ctl-index-of (head values) pool 0) 0)
                false
                (bml-ctl-all-member? (tail values) pool))))

    (defn bml-ctl-form-native-covered? (_x)
        (bml-ctl-all-member?
            (bml-ctl-form-native-primitives 0)
            (append (fcml-required-control-primitives)
                    (fcml-required-backtracking-primitives))))

    (defn bml-ctl-fk-eq (a b)
        (fk-node 80 (ms-intern a b)))

    (defn bml-ctl-get-cell (cell)
        (fk-get (fk-lit cell)))

    (defn bml-ctl-set-cell (cell value)
        (fk-set (fk-lit cell) value))

    (defn bml-ctl-mode-is (mode)
        (bml-ctl-fk-eq (bml-ctl-get-cell (bml-ctl-mode-cell 0)) (fk-lit mode)))

    (defn bml-ctl-set-mode (mode)
        (bml-ctl-set-cell (bml-ctl-mode-cell 0) (fk-lit mode)))

    (defn bml-ctl-guard (expr)
        (fk-if (fk-le (bml-ctl-get-cell (bml-ctl-mode-cell 0)) (fk-lit 0))
               expr
               (fk-lit 0)))

    (defn bml-ctl-st (pool helpers next-id)
        (list "bml-ctl-st" pool helpers next-id))
    (defn bml-ctl-st-pool (st) (nth st 1))
    (defn bml-ctl-st-helpers (st) (nth st 2))
    (defn bml-ctl-st-next (st) (nth st 3))
    (defn bml-ctl-st-with-pool (st pool)
        (bml-ctl-st pool (bml-ctl-st-helpers st) (bml-ctl-st-next st)))
    (defn bml-ctl-st-take-id (st)
        (bml-ctl-st
            (bml-ctl-st-pool st)
            (bml-ctl-st-helpers st)
            (add (bml-ctl-st-next st) 1)))
    (defn bml-ctl-st-add-helper (st id expr)
        (bml-ctl-st
            (bml-ctl-st-pool st)
            (cons (list id expr) (bml-ctl-st-helpers st))
            (bml-ctl-st-next st)))

    (defn bml-ctl-r (expr st) (list "bml-ctl-r" expr st))
    (defn bml-ctl-r-expr (r) (nth r 1))
    (defn bml-ctl-r-st (r) (nth r 2))

    (defn bml-ctl-refuse (reason st)
        (do
            (let refused (bml-hati-lower-refusal reason (bml-ctl-st-pool st)))
            (bml-ctl-r
                (bml-hati-lower-expr refused)
                (bml-ctl-st-with-pool st (bml-hati-lower-pool refused)))))

    (defn bml-ctl-ctx (fn-index targets frame)
        (list "bml-ctl-ctx" fn-index targets frame))
    (defn bml-ctl-ctx-fn (ctx) (nth ctx 1))
    (defn bml-ctl-ctx-targets (ctx) (nth ctx 2))
    (defn bml-ctl-ctx-frame? (ctx) (nth ctx 3))
    (defn bml-ctl-ctx-push (ctx kind label id)
        (bml-ctl-ctx
            (bml-ctl-ctx-fn ctx)
            (cons (list kind label id) (bml-ctl-ctx-targets ctx))
            (bml-ctl-ctx-frame? ctx)))

    (defn bml-ctl-target-accepts? (target kind label)
        (if (str_eq kind "continue")
            (if (str_eq (nth target 0) "loop")
                (if (str_eq label "") true (str_eq (nth target 1) label))
                false)
            (if (str_eq label "") true (str_eq (nth target 1) label))))

    (defn bml-ctl-target-id (targets kind label)
        (if (nil? targets)
            -1
            (if (bml-ctl-target-accepts? (head targets) kind label)
                (nth (head targets) 2)
                (bml-ctl-target-id (tail targets) kind label))))

    (defn bml-ctl-env-active (env)
        (cons (bml-local-binding "__bml_ctl_active" (bml-ast-int 1) env) env))

    (defn bml-ctl-env-active? (env)
        (not (nil? (bml-local-lookup env "__bml_ctl_active"))))

    (defn bml-ctl-env-fn-index (env)
        (do
            (let binding (bml-local-lookup env "__bml_fn_index"))
            (if (nil? binding)
                0
                (node_value (bml-node-child (bml-local-binding-value binding) 0)))))

    ; a method body learns its own table index from the method env; a bare
    ; method image has no env and is function 0; a method the env does not
    ; name reads -1, and its loops are refused rather than re-entering main
    (defn bml-ctl-bind-fn-index (method-node method-env param-env)
        (if (nil? method-env)
            param-env
            (cons
                (bml-local-binding
                    "__bml_fn_index"
                    (bml-ast-int (bml-ctl-method-index method-node method-env))
                    param-env)
                param-env)))

    (defn bml-ctl-method-index (method-node method-env)
        (do
            (let binding
                (bml-hati-method-binding-for-arity
                    method-env
                    (bml-method-node-name method-node)
                    (len (bml-method-node-parameters method-node))))
            (if (nil? binding)
                -1
                (bml-hati-method-ref-index (bml-local-binding-value binding)))))

    (defn bml-ctl-frame-rebind (expr)
        (fk-node 109
            (ms-intern
                (fk-lit (bml-hati-frame-slot))
                (ms-intern (bml-ctl-get-cell (bml-ctl-frame-cell 0)) expr))))

    (defn bml-ctl-with-frame (ctx expr)
        (if (bml-ctl-ctx-frame? ctx)
            (bml-ctl-frame-rebind expr)
            expr))

    (defn bml-ctl-reenter-call (fn-index id)
        (fk-sequence
            (bml-ctl-set-cell (bml-ctl-dispatch-cell 0) (fk-lit id))
            (fk-call fn-index (fk-arg))))

    (defn bml-ctl-reenter (ctx id)
        (if (bml-ctl-ctx-frame? ctx)
            (fk-sequence
                (bml-ctl-set-cell (bml-ctl-frame-cell 0) (bml-hati-bnml-frame-expr))
                (bml-ctl-reenter-call (bml-ctl-ctx-fn ctx) id))
            (bml-ctl-reenter-call (bml-ctl-ctx-fn ctx) id)))

    (defn bml-ctl-str-prefix? (value prefix)
        (if (lt (str_len value) (str_len prefix))
            false
            (str_eq (substring value 0 (str_len prefix)) prefix)))

    (defn bml-ctl-op-node? (node)
        (if (node_eq (node_category node) BML-AST-CALL)
            (bml-ctl-str-prefix? (bml-call-name node) "__bml_op-")
            false))

    (defn bml-ctl-thrown-node? (node) (bml-call-named? node "__bml_thrown"))
    (defn bml-ctl-switch-node? (node) (bml-call-named? node "__bml_switch"))

    (defn bml-ctl-expr-node? (node)
        (if (bml-ctl-op-node? node) true (bml-ctl-thrown-node? node)))

    (defn bml-ctl-while-node? (node)
        (if (node_eq (node_category node) BML-AST-WHILE)
            (eq (len (node_children node)) 3)
            false))

    ; a trivial leaf answers node_category with its own value (leaf 22
    ; reads as IF), so only a node that carries children is a statement
    (defn bml-ctl-statement-node? (node)
        (if (nil? (node_children node))
            false
            (bml-ctl-statement-node-in? node)))

    (defn bml-ctl-statement-node-in? (node)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-IF)
                true
            (if (node_eq cat BML-AST-FOR)
                true
            (if (node_eq cat BML-AST-WITH)
                true
            (if (node_eq cat BML-AST-TRY)
                true
            (if (node_eq cat BML-AST-THROW)
                true
            (if (node_eq cat BML-AST-BREAK)
                true
            (if (node_eq cat BML-AST-CONTINUE)
                true
            (if (bml-ctl-while-node? node)
                true
                (bml-ctl-switch-node? node)))))))))))

    (defn bml-ctl-bearing? (node)
        (if (bml-ctl-statement-node? node)
            true
            (do
                (let cat (node_category node))
                (if (node_eq cat BML-AST-BLOCK)
                    (bml-ctl-any-bearing? (node_children node))
                (if (node_eq cat BML-AST-CHOOSE)
                    (bml-ctl-any-bearing? (node_children node))
                    false)))))

    (defn bml-ctl-any-bearing? (nodes)
        (if (nil? nodes)
            false
            (if (bml-ctl-bearing? (head nodes))
                true
                (bml-ctl-any-bearing? (tail nodes)))))

    (defn bml-ctl-function-entry? (nodes env)
        (if (bml-ctl-env-active? env)
            false
            (bml-ctl-any-bearing? nodes)))

    (defn bml-ctl-effect-node? (node)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-BREAK)
                true
            (if (node_eq cat BML-AST-CONTINUE)
                true
            (if (node_eq cat BML-AST-THROW)
                true
                (node_eq cat BML-AST-RETURN))))))

    (defn bml-ctl-node-effect (node)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-BREAK)
                (bnsc-break (bml-local-name node) (bml-ctl-source 0))
            (if (node_eq cat BML-AST-CONTINUE)
                (bnsc-continue (bml-local-name node) (bml-ctl-source 0))
            (if (node_eq cat BML-AST-THROW)
                (bnsc-throw (bml-node-child node 0) (bml-ctl-source 0))
                (bnsc-value (bml-node-child node 0) (bml-ctl-source 0)))))))

    (defn bml-ctl-lower-function (nodes pool env)
        (do
            (let fn-index (bml-ctl-env-fn-index env))
            (let body-r
                (bml-ctl-lower-stmts
                    nodes
                    (bml-ctl-st pool (empty) 1)
                    (bml-ctl-env-active env)
                    (bml-ctl-ctx fn-index (empty) (bml-bnml-any-needs-frame? nodes))))
            (bml-hati-lower-result
                (bml-ctl-dispatch
                    (bml-ctl-st-helpers (bml-ctl-r-st body-r))
                    (fk-sequence (bml-ctl-r-expr body-r) (bml-ctl-epilogue 0)))
                (bml-ctl-st-pool (bml-ctl-r-st body-r)))))

    (defn bml-ctl-epilogue (_x)
        (fk-if (bml-ctl-mode-is (bml-ctl-return-mode 0))
               (fk-sequence
                   (bml-ctl-set-mode 0)
                   (bml-ctl-get-cell (bml-ctl-value-cell 0)))
               (fk-if (bml-ctl-mode-is (bml-ctl-throw-mode 0))
                      (bml-ctl-get-cell (bml-ctl-thrown-cell 0))
                      (fk-lit 0))))

    (defn bml-ctl-dispatch (helpers main-expr)
        (if (nil? helpers)
            main-expr
            (fk-if
                (bml-ctl-fk-eq
                    (bml-ctl-get-cell (bml-ctl-dispatch-cell 0))
                    (fk-lit (head (head helpers))))
                (fk-sequence
                    (bml-ctl-set-cell (bml-ctl-dispatch-cell 0) (fk-lit 0))
                    (head (tail (head helpers))))
                (bml-ctl-dispatch (tail helpers) main-expr))))

    (defn bml-ctl-lower-expr (node st env)
        (do
            (let lowered (bml-hati-lower-node-in-env node (bml-ctl-st-pool st) env))
            (bml-ctl-r
                (bml-hati-lower-expr lowered)
                (bml-ctl-st-with-pool st (bml-hati-lower-pool lowered)))))

    (defn bml-ctl-lower-stmts (nodes st env ctx)
        (if (nil? nodes)
            (bml-ctl-r (fk-lit 0) st)
            (bml-ctl-lower-stmts-after
                (bml-ctl-lower-stmt (head nodes) st env ctx)
                (tail nodes)
                (bml-ctl-env-after (head nodes) env)
                ctx)))

    (defn bml-ctl-lower-stmts-after (first-r nodes env ctx)
        (if (nil? nodes)
            first-r
            (bml-ctl-lower-stmts-join
                first-r
                (bml-ctl-lower-stmts nodes (bml-ctl-r-st first-r) env ctx))))

    (defn bml-ctl-lower-stmts-join (first-r rest-r)
        (bml-ctl-r
            (fk-sequence
                (bml-ctl-r-expr first-r)
                (bml-ctl-guard (bml-ctl-r-expr rest-r)))
            (bml-ctl-r-st rest-r)))

    (defn bml-ctl-lower-stmt (node st env ctx)
        (if (nil? (bml-ctl-promoted node env))
            (bml-ctl-lower-stmt-in node st env ctx)
            (bml-ctl-lower-stmts
                (append (bml-ctl-promoted node env) (list node))
                st
                env
                ctx)))

    ; a parameter a control statement assigns becomes a frame local just
    ; before it, declared from the parameter's value, so a loop's back-edge
    ; and a branch's join both read the assignment
    (defn bml-ctl-assigned-names (node)
        (if (bml-bnml-assign-node? node)
            (cons (bml-bnml-target-name node) (bml-ctl-assigned-names-in (node_children node)))
            (if (node_eq (node_category node) BML-AST-METHOD)
                (empty)
                (bml-ctl-assigned-names-in (node_children node)))))

    (defn bml-ctl-assigned-names-in (nodes)
        (if (nil? nodes)
            (empty)
            (append
                (bml-ctl-assigned-names (head nodes))
                (bml-ctl-assigned-names-in (tail nodes)))))

    (defn bml-ctl-param-binding? (binding)
        (if (nil? binding)
            false
            (if (bml-bnml-binding? binding)
                false
                (if (bml-hati-arg-node? (bml-local-binding-value binding))
                    true
                    (bml-hati-arg-at-node? (bml-local-binding-value binding))))))

    (defn bml-ctl-promotions (names env seen)
        (if (nil? names)
            (empty)
            (if (fsc-string-list-contains? seen (head names))
                (bml-ctl-promotions (tail names) env seen)
                (if (bml-ctl-param-binding? (bml-local-lookup env (head names)))
                    (cons
                        (bml-ast-local "" (head names) (bml-ast-name (head names)))
                        (bml-ctl-promotions (tail names) env (cons (head names) seen)))
                    (bml-ctl-promotions (tail names) env (cons (head names) seen))))))

    (defn bml-ctl-promoted (node env)
        (if (bml-ctl-statement-node? node)
            (bml-ctl-promotions (bml-ctl-assigned-names node) env (empty))
            (empty)))

    (defn bml-ctl-env-after (node env)
        (bml-local-env-after-node
            node
            (bml-bnml-fold-env (bml-ctl-promoted node env) env)))

    (defn bml-ctl-lower-stmt-in (node st env ctx)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-BLOCK)
                (bml-ctl-lower-stmts (node_children node) st env ctx)
            (if (node_eq cat BML-AST-IF)
                (bml-ctl-lower-if node st env ctx)
            (if (bml-ctl-while-node? node)
                (bml-ctl-lower-loop (bml-ctl-while-parts node) st env ctx)
            (if (node_eq cat BML-AST-FOR)
                (bml-ctl-lower-loop (bml-ctl-for-parts node) st env ctx)
            (if (bml-ctl-switch-node? node)
                (bml-ctl-lower-switch node st env ctx)
            (if (bml-ctl-effect-node? node)
                (bml-ctl-lower-effect (bml-ctl-node-effect node) st env ctx)
            (if (node_eq cat BML-AST-TRY)
                (bml-ctl-lower-try node st env ctx)
            (if (node_eq cat BML-AST-WITH)
                (bml-ctl-refuse "with" st)
            (if (node_eq cat BML-AST-METHOD)
                (bml-ctl-refuse "control/nested-method" st)
                (bml-ctl-lower-expr node st env))))))))))))

    (defn bml-ctl-lower-effect (effect st env ctx)
        (if (bml-ctl-targeted-kind? (bnsc-effect-kind effect))
            (bml-ctl-lower-jump effect (bml-ctl-effect-target effect ctx) st)
            (bml-ctl-lower-transfer effect st env)))

    (defn bml-ctl-effect-target (effect ctx)
        (bml-ctl-target-id
            (bml-ctl-ctx-targets ctx)
            (bnsc-effect-kind effect)
            (bnsc-effect-label effect)))

    (defn bml-ctl-jump-reason (effect)
        (str_concat
            (bnsc-effect-kind effect)
            (if (str_eq (bnsc-effect-label effect) "") "/outside-loop" "/label")))

    (defn bml-ctl-lower-jump (effect target st)
        (if (lt target 0)
            (bml-ctl-refuse (bml-ctl-jump-reason effect) st)
            (bml-ctl-r (bml-ctl-set-mode (bml-ctl-effect-mode effect target)) st)))

    (defn bml-ctl-transfer-cell (effect)
        (if (str_eq (bnsc-effect-kind effect) "throw")
            (bml-ctl-thrown-cell 0)
            (bml-ctl-value-cell 0)))

    (defn bml-ctl-lower-transfer (effect st env)
        (do
            (let value-r (bml-ctl-lower-expr (bnsc-effect-value effect) st env))
            (bml-ctl-r
                (fk-sequence
                    (bml-ctl-set-cell (bml-ctl-transfer-cell effect) (bml-ctl-r-expr value-r))
                    (fk-if (bml-ctl-mode-is 0)
                           (bml-ctl-set-mode (bml-ctl-effect-mode effect 0))
                           (fk-lit 0)))
                (bml-ctl-r-st value-r))))

    (defn bml-ctl-lower-if (node st env ctx)
        (do
            (let test-r (bml-ctl-lower-expr (bml-node-child node 0) st env))
            (let then-r (bml-ctl-lower-stmt (bml-node-child node 1) (bml-ctl-r-st test-r) env ctx))
            (let else-r (bml-ctl-lower-stmt (bml-node-child node 2) (bml-ctl-r-st then-r) env ctx))
            (bml-ctl-r
                (fk-if (bml-ctl-r-expr test-r)
                       (bml-ctl-guard (bml-ctl-r-expr then-r))
                       (bml-ctl-guard (bml-ctl-r-expr else-r)))
                (bml-ctl-r-st else-r))))

    (defn bml-ctl-loop-parts (label init test-node update body)
        (list "bml-ctl-loop" label init test-node update body))
    (defn bml-ctl-loop-label (parts) (nth parts 1))
    (defn bml-ctl-loop-init (parts) (nth parts 2))
    (defn bml-ctl-loop-test (parts) (nth parts 3))
    (defn bml-ctl-loop-update (parts) (nth parts 4))
    (defn bml-ctl-loop-body (parts) (nth parts 5))

    (defn bml-ctl-while-parts (node)
        (bml-ctl-loop-parts
            (node_value (bml-node-child node 2))
            (bml-ast-block (empty))
            (bml-node-child node 0)
            (bml-ast-block (empty))
            (bml-node-child node 1)))

    (defn bml-ctl-for-parts (node)
        (bml-ctl-loop-parts
            (node_value (bml-node-child node 0))
            (bml-node-child node 1)
            (bml-node-child node 2)
            (bml-node-child node 3)
            (bml-node-child node 4)))

    (defn bml-ctl-reaction-code (reaction next)
        (if (str_eq reaction "stopped")
            (bml-ctl-set-mode 0)
            (if (str_eq reaction "running")
                (fk-sequence (bml-ctl-set-mode 0) next)
                (fk-lit 0))))

    ; mode 0 is a body that finished as a value; any mode the loop does not
    ; own (a throw, a return, an outer target) passes outward as bnsc reads
    ; a throw: failed.
    (defn bml-ctl-loop-react (id next)
        (fk-if (bml-ctl-mode-is 0)
               (bml-ctl-reaction-code
                   (bml-ctl-loop-reaction (bnsc-value 0 (bml-ctl-source 0)))
                   next)
        (fk-if (bml-ctl-mode-is (bml-ctl-continue-mode id))
               (bml-ctl-reaction-code
                   (bml-ctl-loop-reaction (bnsc-continue "" (bml-ctl-source 0)))
                   next)
        (fk-if (bml-ctl-mode-is (bml-ctl-break-mode id))
               (bml-ctl-reaction-code
                   (bml-ctl-loop-reaction (bnsc-break "" (bml-ctl-source 0)))
                   next)
               (bml-ctl-reaction-code
                   (bml-ctl-loop-reaction (bnsc-throw 0 (bml-ctl-source 0)))
                   next)))))

    (defn bml-ctl-lower-loop (parts st env ctx)
        (if (lt (bml-ctl-ctx-fn ctx) 0)
            (bml-ctl-refuse "loop/function-index" st)
            (bml-ctl-lower-loop-in parts st env ctx)))

    (defn bml-ctl-lower-loop-in (parts st env ctx)
        (do
            (let id (bml-ctl-st-next st))
            (let init-r
                (bml-ctl-lower-stmt (bml-ctl-loop-init parts) (bml-ctl-st-take-id st) env ctx))
            (let inner-env (bml-local-env-after-node (bml-ctl-loop-init parts) env))
            (let inner-ctx (bml-ctl-ctx-push ctx "loop" (bml-ctl-loop-label parts) id))
            (let test-r
                (bml-ctl-lower-expr (bml-ctl-loop-test parts) (bml-ctl-r-st init-r) inner-env))
            (let body-r
                (bml-ctl-lower-stmt (bml-ctl-loop-body parts) (bml-ctl-r-st test-r) inner-env inner-ctx))
            (let update-r
                (bml-ctl-lower-stmt (bml-ctl-loop-update parts) (bml-ctl-r-st body-r) inner-env inner-ctx))
            (let reenter (bml-ctl-reenter ctx id))
            (bml-ctl-r
                (fk-sequence (bml-ctl-r-expr init-r) (bml-ctl-guard reenter))
                (bml-ctl-st-add-helper
                    (bml-ctl-r-st update-r)
                    id
                    (bml-ctl-with-frame
                        ctx
                        (fk-if (bml-ctl-r-expr test-r)
                               (bml-ctl-guard
                                   (fk-sequence
                                       (bml-ctl-r-expr body-r)
                                       (bml-ctl-loop-react
                                           id
                                           (fk-sequence
                                               (bml-ctl-r-expr update-r)
                                               (bml-ctl-guard reenter)))))
                               (fk-lit 0)))))))

    (defn bml-ctl-switch-scrutinee (node) (head (bml-call-args node)))
    (defn bml-ctl-switch-clauses (node) (node_children (head (tail (bml-call-args node)))))
    (defn bml-ctl-switch-label (node)
        (node_value (bml-node-child (head (tail (tail (bml-call-args node)))) 0)))
    (defn bml-ctl-default-clause? (clause) (bml-call-named? clause "__bml_default"))
    (defn bml-ctl-case-clause? (clause) (bml-call-named? clause "__bml_case"))
    (defn bml-ctl-case-value (clause) (head (bml-call-args clause)))
    (defn bml-ctl-clause-body (clause)
        (if (bml-ctl-default-clause? clause)
            (bml-call-arg clause)
            (head (tail (bml-call-args clause)))))

    (defn bml-ctl-lower-switch (node st env ctx)
        (do
            (let id (bml-ctl-st-next st))
            (let fn-index (bml-ctl-ctx-fn ctx))
            (let value-cell (bml-ctl-var-cell fn-index id))
            (let hit-cell (bml-ctl-var-cell fn-index (add id 1)))
            (let scrutinee-r
                (bml-ctl-lower-expr
                    (bml-ctl-switch-scrutinee node)
                    (bml-ctl-st-take-id (bml-ctl-st-take-id st))
                    env))
            (let any-r
                (bml-ctl-lower-any-case
                    (bml-ctl-switch-clauses node)
                    value-cell
                    (bml-ctl-r-st scrutinee-r)
                    env))
            (let clauses-r
                (bml-ctl-lower-clauses
                    (bml-ctl-switch-clauses node)
                    value-cell
                    hit-cell
                    (bml-ctl-r-expr any-r)
                    (bml-ctl-r-st any-r)
                    env
                    (bml-ctl-ctx-push ctx "switch" (bml-ctl-switch-label node) id)))
            (bml-ctl-r
                (fk-sequence
                    (bml-ctl-set-cell value-cell (bml-ctl-r-expr scrutinee-r))
                    (fk-sequence
                        (bml-ctl-set-cell hit-cell (fk-lit 0))
                        (fk-sequence
                            (bml-ctl-r-expr clauses-r)
                            (fk-if (bml-ctl-mode-is (bml-ctl-break-mode id))
                                   (bml-ctl-reaction-code
                                       (bml-ctl-loop-reaction
                                           (bnsc-break "" (bml-ctl-source 0)))
                                       (fk-lit 0))
                                   (fk-lit 0)))))
                (bml-ctl-r-st clauses-r))))

    (defn bml-ctl-lower-case-match (clause value-cell st env)
        (do
            (let value-r (bml-ctl-lower-expr (bml-ctl-case-value clause) st env))
            (bml-ctl-r
                (bml-ctl-fk-eq (bml-ctl-get-cell value-cell) (bml-ctl-r-expr value-r))
                (bml-ctl-r-st value-r))))

    (defn bml-ctl-lower-any-case (clauses value-cell st env)
        (if (nil? clauses)
            (bml-ctl-r (fk-lit 0) st)
            (if (bml-ctl-case-clause? (head clauses))
                (bml-ctl-lower-any-case-join
                    (bml-ctl-lower-case-match (head clauses) value-cell st env)
                    (tail clauses)
                    value-cell
                    env)
                (bml-ctl-lower-any-case (tail clauses) value-cell st env))))

    (defn bml-ctl-lower-any-case-join (match-r clauses value-cell env)
        (do
            (let rest-r
                (bml-ctl-lower-any-case clauses value-cell (bml-ctl-r-st match-r) env))
            (bml-ctl-r
                (fk-if (bml-ctl-r-expr match-r) (fk-lit 1) (bml-ctl-r-expr rest-r))
                (bml-ctl-r-st rest-r))))

    (defn bml-ctl-lower-clauses (clauses value-cell hit-cell any-expr st env ctx)
        (if (nil? clauses)
            (bml-ctl-r (fk-lit 0) st)
            (bml-ctl-lower-clause
                (head clauses)
                (tail clauses)
                value-cell
                hit-cell
                any-expr
                (if (bml-ctl-default-clause? (head clauses))
                    (bml-ctl-r (fk-if any-expr (fk-lit 0) (fk-lit 1)) st)
                    (bml-ctl-lower-case-match (head clauses) value-cell st env))
                env
                ctx)))

    (defn bml-ctl-lower-clause (clause clauses value-cell hit-cell any-expr match-r env ctx)
        (do
            (let body-r
                (bml-ctl-lower-stmt (bml-ctl-clause-body clause) (bml-ctl-r-st match-r) env ctx))
            (let rest-r
                (bml-ctl-lower-clauses
                    clauses value-cell hit-cell any-expr (bml-ctl-r-st body-r) env ctx))
            (let hit-zero (fk-le (bml-ctl-get-cell hit-cell) (fk-lit 0)))
            (bml-ctl-r
                (fk-sequence
                    (bml-ctl-guard
                        (fk-sequence
                            (fk-if hit-zero
                                   (bml-ctl-set-cell hit-cell (bml-ctl-r-expr match-r))
                                   (fk-lit 0))
                            (fk-if hit-zero (fk-lit 0) (bml-ctl-r-expr body-r))))
                    (bml-ctl-r-expr rest-r))
                (bml-ctl-r-st rest-r))))

    (defn bml-ctl-try-decl (node)
        (if (gt (len (node_children node)) 2)
            (bml-node-child node 2)
            (bml-ast-block (empty))))

    (defn bml-ctl-lower-try (node st env ctx)
        (do
            (let body-r (bml-ctl-lower-stmt (bml-node-child node 0) st env ctx))
            (let decl-r
                (bml-ctl-lower-stmt (bml-ctl-try-decl node) (bml-ctl-r-st body-r) env ctx))
            (let handler-r
                (bml-ctl-lower-stmt
                    (bml-node-child node 1)
                    (bml-ctl-r-st decl-r)
                    (bml-local-env-after-node (bml-ctl-try-decl node) env)
                    ctx))
            (bml-ctl-r
                (fk-sequence
                    (bml-ctl-r-expr body-r)
                    (fk-if (bml-ctl-mode-is (bml-ctl-catch-mode 0))
                           (fk-sequence
                               (bml-ctl-set-mode 0)
                               (fk-sequence (bml-ctl-r-expr decl-r) (bml-ctl-r-expr handler-r)))
                           (fk-lit 0)))
                (bml-ctl-r-st handler-r))))

    (defn bml-ctl-op-rule-of (node)
        (substring (bml-call-name node) 6 (str_len (bml-call-name node))))

    (defn bml-ctl-known-op-rules (_x)
        (list "op-lt" "op-le" "op-gt" "op-ge" "op-eq" "op-ne" "op-and" "op-or"
              "op-sub" "op-mul" "op-not" "op-neg"))

    (defn bml-ctl-known-op? (node)
        (ge (bml-ctl-index-of (bml-ctl-op-rule-of node) (bml-ctl-known-op-rules 0) 0) 0))

    (defn bml-ctl-binary-op (rule a b)
        (if (str_eq rule "op-lt")
            (fk-if (fk-le (fk-lit 0) (fk-sub a b)) (fk-lit 0) (fk-lit 1))
        (if (str_eq rule "op-le")
            (fk-le a b)
        (if (str_eq rule "op-gt")
            (fk-if (fk-le (fk-sub a b) (fk-lit 0)) (fk-lit 0) (fk-lit 1))
        (if (str_eq rule "op-ge")
            (fk-le (fk-lit 0) (fk-sub a b))
        (if (str_eq rule "op-eq")
            (bml-ctl-fk-eq a b)
        (if (str_eq rule "op-ne")
            (fk-if (bml-ctl-fk-eq a b) (fk-lit 0) (fk-lit 1))
        (if (str_eq rule "op-and")
            (fk-if a (fk-if b (fk-lit 1) (fk-lit 0)) (fk-lit 0))
        (if (str_eq rule "op-or")
            (fk-if a (fk-lit 1) (fk-if b (fk-lit 1) (fk-lit 0)))
        (if (str_eq rule "op-sub")
            (fk-sub a b)
            (fk-mul a b)))))))))))

    (defn bml-ctl-unary-op (rule a)
        (if (str_eq rule "op-not")
            (fk-if a (fk-lit 0) (fk-lit 1))
            (fk-sub (fk-lit 0) a)))

    (defn bml-ctl-lower-reserved (node pool env)
        (if (bml-ctl-thrown-node? node)
            (bml-hati-lower-result (bml-ctl-get-cell (bml-ctl-thrown-cell 0)) pool)
            (if (bml-ctl-known-op? node)
                (bml-ctl-lower-op node pool env)
                (bml-hati-lower-refusal "op/unknown" pool))))

    (defn bml-ctl-lower-op (node pool env)
        (do
            (let args (bml-call-args node))
            (let left (bml-hati-lower-node-in-env (head args) pool env))
            (if (nil? (tail args))
                (bml-hati-lower-result
                    (bml-ctl-unary-op (bml-ctl-op-rule-of node) (bml-hati-lower-expr left))
                    (bml-hati-lower-pool left))
                (bml-ctl-lower-op-right
                    (bml-ctl-op-rule-of node)
                    left
                    (bml-hati-lower-node-in-env
                        (head (tail args))
                        (bml-hati-lower-pool left)
                        env)))))

    (defn bml-ctl-lower-op-right (rule left right)
        (bml-hati-lower-result
            (bml-ctl-binary-op rule (bml-hati-lower-expr left) (bml-hati-lower-expr right))
            (bml-hati-lower-pool right)))

    (defn bml-ctl-unsupported-reserved (node env)
        (if (bml-ctl-thrown-node? node)
            (empty)
            (if (bml-ctl-known-op? node)
                (bml-ctl-unsupported-exprs (bml-call-args node) env)
                (list "op/unknown"))))

    (defn bml-ctl-unsupported-exprs (nodes env)
        (if (nil? nodes)
            (empty)
            (append
                (bml-hati-unsupported-node-in (head nodes) env)
                (bml-ctl-unsupported-exprs (tail nodes) env))))

    (defn bml-ctl-unsupported-function (nodes env)
        (bml-ctl-unsupported-stmts
            nodes
            (bml-ctl-env-active env)
            (bml-ctl-ctx (bml-ctl-env-fn-index env) (empty) false)))

    (defn bml-ctl-unsupported-stmts (nodes env ctx)
        (if (nil? nodes)
            (empty)
            (append
                (bml-ctl-unsupported-stmt (head nodes) env ctx)
                (bml-ctl-unsupported-stmts
                    (tail nodes)
                    (bml-ctl-env-after (head nodes) env)
                    ctx))))

    (defn bml-ctl-unsupported-stmt (node env ctx)
        (do
            (let cat (node_category node))
            (if (node_eq cat BML-AST-BLOCK)
                (bml-ctl-unsupported-stmts (node_children node) env ctx)
            (if (node_eq cat BML-AST-IF)
                (append
                    (bml-hati-unsupported-node-in (bml-node-child node 0) env)
                    (append
                        (bml-ctl-unsupported-stmt (bml-node-child node 1) env ctx)
                        (bml-ctl-unsupported-stmt (bml-node-child node 2) env ctx)))
            (if (bml-ctl-while-node? node)
                (bml-ctl-unsupported-loop (bml-ctl-while-parts node) env ctx)
            (if (node_eq cat BML-AST-FOR)
                (bml-ctl-unsupported-loop (bml-ctl-for-parts node) env ctx)
            (if (bml-ctl-switch-node? node)
                (bml-ctl-unsupported-switch node env ctx)
            (if (node_eq cat BML-AST-BREAK)
                (bml-ctl-unsupported-jump node ctx)
            (if (node_eq cat BML-AST-CONTINUE)
                (bml-ctl-unsupported-jump node ctx)
            (if (node_eq cat BML-AST-THROW)
                (bml-hati-unsupported-node-in (bml-node-child node 0) env)
            (if (node_eq cat BML-AST-TRY)
                (bml-ctl-unsupported-try node env ctx)
            (if (node_eq cat BML-AST-WITH)
                (list "with")
            (if (node_eq cat BML-AST-METHOD)
                (list "control/nested-method")
                (bml-hati-unsupported-node-in node env))))))))))))))

    (defn bml-ctl-unsupported-loop (parts env ctx)
        (do
            (let inner-env (bml-local-env-after-node (bml-ctl-loop-init parts) env))
            (let inner-ctx (bml-ctl-ctx-push ctx "loop" (bml-ctl-loop-label parts) 0))
            (append
                (if (lt (bml-ctl-ctx-fn ctx) 0) (list "loop/function-index") (empty))
                (append
                    (bml-ctl-unsupported-stmt (bml-ctl-loop-init parts) env ctx)
                    (append
                        (bml-hati-unsupported-node-in (bml-ctl-loop-test parts) inner-env)
                        (append
                            (bml-ctl-unsupported-stmt (bml-ctl-loop-body parts) inner-env inner-ctx)
                            (bml-ctl-unsupported-stmt (bml-ctl-loop-update parts) inner-env inner-ctx)))))))

    (defn bml-ctl-unsupported-jump (node ctx)
        (do
            (let effect (bml-ctl-node-effect node))
            (if (lt (bml-ctl-effect-target effect ctx) 0)
                (list (bml-ctl-jump-reason effect))
                (empty))))

    (defn bml-ctl-unsupported-switch (node env ctx)
        (append
            (bml-hati-unsupported-node-in (bml-ctl-switch-scrutinee node) env)
            (bml-ctl-unsupported-clauses
                (bml-ctl-switch-clauses node)
                env
                (bml-ctl-ctx-push ctx "switch" (bml-ctl-switch-label node) 0))))

    (defn bml-ctl-unsupported-clauses (clauses env ctx)
        (if (nil? clauses)
            (empty)
            (append
                (bml-ctl-unsupported-clause (head clauses) env ctx)
                (bml-ctl-unsupported-clauses (tail clauses) env ctx))))

    (defn bml-ctl-unsupported-clause (clause env ctx)
        (if (bml-ctl-default-clause? clause)
            (bml-ctl-unsupported-stmt (bml-ctl-clause-body clause) env ctx)
        (if (bml-ctl-case-clause? clause)
            (append
                (bml-hati-unsupported-node-in (bml-ctl-case-value clause) env)
                (bml-ctl-unsupported-stmt (bml-ctl-clause-body clause) env ctx))
            (list "switch/clause"))))

    (defn bml-ctl-unsupported-try (node env ctx)
        (append
            (bml-ctl-unsupported-stmt (bml-node-child node 0) env ctx)
            (append
                (bml-ctl-unsupported-stmt (bml-ctl-try-decl node) env ctx)
                (bml-ctl-unsupported-stmt
                    (bml-node-child node 1)
                    (bml-local-env-after-node (bml-ctl-try-decl node) env)
                    ctx))))

    (defn bma-trace-count-mode (trace mode)
        (if (nil? trace) 0
            (add
                (if (str_eq (bma-trace-mode (head trace)) mode) 1 0)
                (bma-trace-count-mode (tail trace) mode))))

    (defn bma-trace-count-op (trace op-name)
        (if (nil? trace) 0
            (add
                (if (str_eq (bma-trace-op-name (head trace)) op-name) 1 0)
                (bma-trace-count-op (tail trace) op-name))))

    0)
