    (defn bml-body-source-self-args-append-current (current acc)
        (if (str_eq current "") acc
            (cons current acc)))

    (defn bml-body-source-self-args-loop (values depth current acc)
        (if (nil? values)
            (reverse-list
                (bml-body-source-self-args-append-current current acc))
            (do
                (let value (head values))
                (if (eq depth 0)
                    (if (str_eq value ")")
                        (reverse-list
                            (bml-body-source-self-args-append-current
                                current
                                acc))
                    (if (str_eq value ",")
                        (bml-body-source-self-args-loop
                            (tail values)
                            0
                            ""
                            (bml-body-source-self-args-append-current
                                current
                                acc))
                    (if (str_eq value "(")
                        (bml-body-source-self-args-loop
                            (tail values)
                            1
                            current
                            acc)
                    (if (str_eq value "<")
                        (bml-body-source-self-args-loop
                            (tail values)
                            1
                            current
                            acc)
                        (bml-body-source-self-args-loop
                            (tail values)
                            0
                            (if (str_eq current "") value current)
                            acc)))))
                    (if (str_eq value ")")
                        (bml-body-source-self-args-loop
                            (tail values)
                            (sub depth 1)
                            current
                            acc)
                    (if (str_eq value ">")
                        (bml-body-source-self-args-loop
                            (tail values)
                            (sub depth 1)
                            current
                            acc)
                    (if (str_eq value "(")
                        (bml-body-source-self-args-loop
                            (tail values)
                            (add depth 1)
                            current
                            acc)
                    (if (str_eq value "<")
                        (bml-body-source-self-args-loop
                            (tail values)
                            (add depth 1)
                            current
                            acc)
                        (bml-body-source-self-args-loop
                            (tail values)
                            depth
                            current
                            acc)))))))))

