    def bml-source-parse-qualified-name(objects) = bml-source-name-token?(objects[0]) ? bml-source-parse-qualified-name-loop(objects[1:], bmf-object-value(objects[0])) : ["", objects];
    def bml-source-token-values-concat-loop(objects, acc) = nil?(objects) ? acc : bml-source-token-values-concat-loop(objects[1:], ((String) acc + bmf-object-value(objects[0])));
    def bml-source-token-values-concat(objects) = bml-source-token-values-concat-loop(objects, "");
