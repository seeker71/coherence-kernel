    //; its bmlClass (the image's class when it names none) and that class's
    //; id in this image's layout, so a method table reads it as it reads a
    //; record new made. A record new made, or a value that is no record,
    //; passes as it is.
    def bml-hati-host-record(node, self) = (record?(self) ? !nrr-owned(0, self) : false) ? {
        let named = record_has(self, "bmlClass") ? record_get(self, "bmlClass") : "";
        let class-name = ((String) value_kind(named) == "string" ? len(named) > 0 : false) ? named : bml-class-node-name(node);
        let entry = bml-hati-layout-class(bml-hati-build-layout([node], 0), class-name);
        nil?(entry) ? self : {
            record_set(self, "bmlClass", class-name);
            record_set(self, "bmlClassId", bml-hati-class-id(entry));
            self;
        };
    } : self;
    //; The constructor family of a class: its fields and constructors.
    def bml-hati-construction-members(nodes, ctor-name) = nil?(nodes) ? [] : (node_eq(node_category(nodes[0]), BML-AST-FIELD) ? true : node_eq(node_category(nodes[0]), BML-AST-METHOD) ? (String) bml-method-node-name(nodes[0]) == ctor-name : false) ? cons(nodes[0], bml-hati-construction-members(nodes[1:], ctor-name)) : bml-hati-construction-members(nodes[1:], ctor-name);
    def bml-hati-construction-view(class-node) = intern_node(BML-AST-CLASS, append([bml-node-child(class-node, 0), bml-node-child(class-node, 1), bml-hati-bridge-sections(bml-hati-construction-members(bml-hati-decl-members(class-node), bml-hati-type-base(bml-class-node-name(class-node))))], drop(3, node_children(class-node))));
    0;
}
