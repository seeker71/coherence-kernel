    ;; `if ( ... ) statement [else statement]` holds its statements behind a
    ;; guard. The return a body answers directly is the first one no guard
    ;; holds -- in operator== the final `return m_hItem == hOther.Item;`,
    ;; not the guarded `return false;` before it.
    (defn bml-body-source-if-guard-at? (values)
        (if (gt (len values) 1)
            (if (str_eq (head values) "if")
                (str_eq (nth values 1) "(")
                false)
            false))

    (defn bml-body-source-skip-closing (values open close depth)
        (if (nil? values)
            values
            (if (str_eq (head values) open)
                (bml-body-source-skip-closing (tail values) open close (add depth 1))
            (if (str_eq (head values) close)
                (if (eq depth 0)
                    (tail values)
                    (bml-body-source-skip-closing (tail values) open close (sub depth 1)))
                (bml-body-source-skip-closing (tail values) open close depth)))))

    (defn bml-body-source-skip-past-semicolon (values)
        (if (nil? values)
            values
            (if (str_eq (head values) ";")
                (tail values)
                (bml-body-source-skip-past-semicolon (tail values)))))

    (defn bml-body-source-skip-statement (values)
        (if (nil? values)
            values
            (if (str_eq (head values) "{")
                (bml-body-source-skip-closing (tail values) "{" "}" 0)
            (if (bml-body-source-if-guard-at? values)
                (bml-body-source-skip-if-guard values)
                (bml-body-source-skip-past-semicolon values)))))

    (defn bml-body-source-skip-if-guard (values)
        (do
            (let after-guard
                (bml-body-source-skip-statement
                    (bml-body-source-skip-closing (drop 2 values) "(" ")" 0)))
            (if (nil? after-guard)
                after-guard
                (if (str_eq (head after-guard) "else")
                    (bml-body-source-skip-statement (tail after-guard))
                    after-guard))))

    (defn bml-body-source-exec-return-loop (values self env)
        (if (nil? values) (empty)
            (if (bml-body-source-if-guard-at? values)
                (bml-body-source-exec-return-loop
                    (bml-body-source-skip-if-guard values)
                    self
                    env)
            (if (bml-body-source-return-member-add-at? values)
                (bml-body-source-eval-return-member-add-at values self env)
            (if (bml-body-source-return-member-eq-at? values)
                (bml-body-source-eval-return-member-eq-at values self env)
            (if (bml-body-source-return-object-at? values)
                (bml-body-source-eval-return-object-at values self env)
            (if (bml-body-source-return-receiver-call0-at? values)
                (bml-body-source-eval-return-receiver-call0-at values self env)
            (if (bml-body-source-return-receiver-call0-eq-string-at? values)
                (bml-body-source-eval-return-receiver-call0-eq-string-at values self env)
            (if (bml-body-source-return-implicit-call1-receiver-call0-at? values)
                (bml-body-source-eval-return-implicit-call1-receiver-call0-at values self env)
            (if (bml-body-source-return-constructor3-at? values)
                (bml-body-source-eval-return-constructor3-at values self env)
                (bml-body-source-exec-return-loop
                    (tail values)
                    self
                    env)))))))))))

