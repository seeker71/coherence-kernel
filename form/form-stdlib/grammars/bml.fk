    def bml-source-brace-collect-state(cursor, depth, acc, done, body, rest, steps) = ["bml-source-brace-collect-state", cursor, depth, acc, done, body, rest, steps];
    def bml-source-brace-collect-state?(state) = nil?(state) ? false : (String) state[0] == "bml-source-brace-collect-state";
