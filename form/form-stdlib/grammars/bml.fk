    def bml-source-brace-collect-steps(state) = state[7];
    def bml-source-brace-collect-finish(state, body, rest) = bml-source-brace-collect-state(bml-source-brace-collect-cursor(state), bml-source-brace-collect-depth(state), bml-source-brace-collect-acc(state), true, body, rest, bml-source-brace-collect-steps(state));
    def bml-source-brace-collect-step(state) = bml-source-brace-collect-done?(state) ? state : {
