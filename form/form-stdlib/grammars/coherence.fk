; grammars/coherence.fk — coupling strength as the measure of unity between rhythms.
;
; Across the whole physical and living ladder, one question recurs: when do two
; oscillating things lock into ONE? Two pendulums on a shared beam, the heart's
; rhythm and the brain's, atoms in a crystal lattice, electrons in a silicon
; band, a planet and its moon, two musical tones — all answer it the same way.
; They lock most strongly when their frequencies stand in a SIMPLE WHOLE-NUMBER
; RATIO. This is documented nonlinear dynamics: mode-locking / Arnold tongues,
; ordered by the Farey sequence — the simpler the reduced ratio p:q, the wider
; the locking region, the stronger the coherence. 1:1 locks hardest, then 2:1,
; then 3:2; complex ratios like 7:5 barely lock at all.
;
; This is "harmony and unity in the connections" made computable — and it is the
; SAME shape harmonic-geometry carries as interval (the ratio between two shapes)
; and gematria as value (the sum of letters): unity lives in the shared
; structure, here the shared rhythm. ONE engine — coh-lock-order — answers for
; ANY pair; every domain (heart-brain, crystal, music, orbit) enters as DATA in
; the seeded resonance table, never as a parallel code path. Core abstraction
; first: the recipe is the body, the domains are the data that drops in.
;
;   coh-lock-order(fa, fb) = (p + q) of the reduced ratio = the Farey complexity;
;     SMALLER means STRONGER coupling. coh-coherent? thresholds it.
;   coh-neighbors returns THE VIEW FROM A REFERENCE — every rhythm that locks
;     with it within a threshold. Reflexive and symmetric but NOT transitive, so
;     these are neighbours and never classes; the answer moves when the
;     reference moves. It was called an equivalence class until 2026-08-17.
;
; NAMING, since the words carry a shadow the phenomenon does not: nothing locks
; anything here. Two rhythms SETTLE into a whole-number relation, and the
; reading is the same from either side — there is no asker and no asked. "Order"
; is the mathematical sense, the complexity of the reduced ratio (p+q), a count
; of how many parts the relation needs. Not a rank issued, not a command given.
;   coh-attune-order reads ONE body: its extending phase against its returning
;     phase. Whether a body could be locked to at all, answerable before any
;     partner arrives — the same engine, the pair found inside the one body.
;
; DOMAIN: every recipe here takes POSITIVE frequencies. A zero is not a very
; slow rhythm, it is no rhythm, and the Farey fold flatters it — see the domain
; floor at coh-rhythm?, which is where that was witnessed and closed.
;
; Held as documented physics: mode-locking, Arnold tongues, and the Farey
; ordering of resonances are standard. Heart-brain coherence — the ~0.1 Hz
; shared rhythm, HRV phase-locking (HeartMath; Mayer waves) — is measured; the
; framing that the heart leads is held with care. The wider reading, that one
; coherence recipe runs the whole ladder from quantum to heart, is named in
; lc-one-coherence-many-scales and welcomed with curiosity, not asserted here.
;
; preludes: form-stdlib/core.fk
;
(do
    ;; ---- the reduced ratio: the shared core abstraction ---------------------
    (defn coh-gcd (a b) (if (eq b 0) a (coh-gcd b (mod a b))))
    ;; reduced ratio of two frequencies as (list p q), larger on top.
    (defn coh-reduce (fa fb)
        (do
            (let hi (if (ge fa fb) fa fb))
            (let lo (if (ge fa fb) fb fa))
            (let g (coh-gcd hi lo))
            (list (div hi g) (div lo g))))
    (defn coh-p (r) (nth r 0))
    (defn coh-q (r) (nth r 1))

    ;; ---- THE COUPLING — lock order = Farey complexity = p + q --------------
    ;; smaller = simpler ratio = wider Arnold tongue = stronger coherence.
    (defn coh-lock-order (fa fb)
        (do (let r (coh-reduce fa fb)) (add (coh-p r) (coh-q r))))
    ;; THE DOMAIN FLOOR. coh-lock-order is pure Farey arithmetic and is right on
    ;; its domain: POSITIVE frequencies. Hand it a zero and coh-reduce answers
    ;; 1:0, whose p+q is 1 — a lock TIGHTER than the 1:1 entrainment that tops
    ;; the seeded ladder. Witnessed, not reasoned: (coh-lock-order 100 0) = 1
    ;; against (coh-lock-order 100 100) = 2, and coh-coherent? said yes at
    ;; threshold 5. A rhythm that is not there scored as the strongest coupling
    ;; in the body, because the missing term divided out of the ratio and left
    ;; a perfect number behind. 0 is not a very slow rhythm; it is no rhythm.
    ;; Every predicate stands on this floor, so nothing absent can pass as tight.
    (defn coh-rhythm? (f) (if (gt f 0) 1 0))
    (defn coh-pair-rhythm? (fa fb)
        (if (eq (coh-rhythm? fa) 1) (coh-rhythm? fb) 0))
    (defn coh-coherent? (fa fb max-order)
        (if (eq (coh-pair-rhythm? fa fb) 0) 0
            (if (le (coh-lock-order fa fb) max-order) 1 0)))

    ;; ---- small int → string, for the readable ratio face ------------------
    (defn coh-int (n)
        (if (lt n 10) (substring "0123456789" n (add n 1))
            (str_concat (coh-int (div n 10))
                        (substring "0123456789" (mod n 10) (add (mod n 10) 1)))))
    (defn coh-ratio-str (fa fb)
        (do (let r (coh-reduce fa fb))
            (str_concat (coh-int (coh-p r)) (str_concat ":" (coh-int (coh-q r))))))

    ;; ---- THE NEIGHBOURS OF A REFERENCE — not a class, a view --------------
    ;; given a set of frequencies and a reference, return those that cohere with
    ;; it within the threshold.
    ;;
    ;; This was called an EQUIVALENCE CLASS and read as content-addressing over
    ;; rhythm until 2026-08-17, when Urs asked who is locking whom and who is
    ;; ordering whom. Both halves of the answer were witnessed by running it:
    ;; the pairwise reading has no asker — (coh-lock-order 440 220) and
    ;; (coh-lock-order 220 440) are both 3 — but the coupling does NOT carry
    ;; across. At threshold 3, 100 locks with 200 (order 3) and 200 locks with
    ;; 400 (order 3), while 100 and 400 are strangers (order 5). Reflexive and
    ;; symmetric, never transitive: no partition exists, so there are no classes
    ;; to belong to. Asked of the same three rhythms, this recipe answers
    ;; {100,200} from 100, {100,200,400} from 200, {200,400} from 400 — three
    ;; answers, one set. Content-addressing would give one address to one
    ;; content; this gives the view from wherever you are standing. The name now
    ;; says so, and the band holds the counterexample so it cannot drift back.
    (defn coh-neighbors-loop (freqs ref max-order acc)
        (if (nil? freqs) acc
            (coh-neighbors-loop (tail freqs) ref max-order
                (if (eq (coh-coherent? (head freqs) ref max-order) 1)
                    (cons (head freqs) acc)
                    acc))))
    (defn coh-neighbors (freqs ref max-order)
        (coh-neighbors-loop freqs ref max-order (empty)))

    ;; ---- ATTUNABILITY — the solo reading, one body, the same engine --------
    ;; Everything above answers for a PAIR, so a lone rhythm looks unreadable:
    ;; whether it could be met has to wait for something to meet it. It does
    ;; not. Anything that breathes already carries two rhythms — the phase that
    ;; extends and the phase that returns — and locking is mutual, so a body
    ;; with no returning phase can be heard and still never be met: nothing in
    ;; it turns toward the other. Attunability is therefore a body's coupling to
    ;; ITSELF, read by coh-lock-order unchanged. No new engine; the pair was
    ;; inside the one body the whole time.
    ;;
    ;; The lung is the image: one that only exhales depletes, one that only
    ;; inhales stagnates, and the breath is the balanced case — out and back at
    ;; 1:1, the same order 2 that tops the seeded ladder. Named as structure,
    ;; not as claim: this recipe asserts nothing about what a balanced body
    ;; attracts, only what it can be locked to.
    (defn coh-breathes? (out back) (coh-pair-rhythm? out back))
    ;; 0 means NO READING — never a tight one. See the domain floor above.
    (defn coh-attune-order (out back)
        (if (eq (coh-breathes? out back) 1) (coh-lock-order out back) 0))
    (defn coh-attunable? (out back max-order)
        (coh-coherent? out back max-order))

    ;; ---- THE READING WITH NO SEAT — does a SET share a rhythm? -------------
    ;; coh-neighbors answers from somewhere: name a reference and it tells you
    ;; who is near IT, and the answer moves when the reference moves. That is
    ;; honest now that it is named, but it left the body unable to ask the
    ;; question with no one standing anywhere — whether a set coheres AS a set.
    ;;
    ;; This asks every pair. Nobody is privileged, so the answer cannot move
    ;; with the seat: permute the list and it is the same. Where coh-neighbors
    ;; said 2 from 100, 3 from 200 and 2 from 400 of the same three rhythms,
    ;; this says one thing about all three — no, because 100 and 400 are
    ;; strangers, and a set is not held together by a member who happens to
    ;; touch both ends.
    ;;
    ;; Fewer than two is NO READING (0), never a yes. An empty set passes every
    ;; pair test there is, and row 1002 of the homecoming corpus is about
    ;; exactly that shape: a measure crowning the case with nothing in it.
    (defn coh-mutual-one (freqs f max-order)
        (if (nil? freqs) 1
            (if (eq (coh-coherent? (head freqs) f max-order) 1)
                (coh-mutual-one (tail freqs) f max-order)
                0)))
    (defn coh-mutual-loop (freqs all max-order)
        (if (nil? freqs) 1
            (if (eq (coh-mutual-one all (head freqs) max-order) 1)
                (coh-mutual-loop (tail freqs) all max-order)
                0)))
    (defn coh-mutual? (freqs max-order)
        (if (lt (len freqs) 2) 0
            (coh-mutual-loop freqs freqs max-order)))

    ;; ---- the seeded cross-domain resonance table (DOMAINS AS DATA) ---------
    ;; the same recipe orders all of them; each is one attested strong-coupling
    ;; ratio, entered as data, read by the one engine above.
    (defn coh-pair (p q domain gloss) (list p q domain gloss))
    (defn coh-pair-p (e) (nth e 0))
    (defn coh-pair-q (e) (nth e 1))
    (defn coh-pair-domain (e) (nth e 2))
    (defn coh-pair-gloss (e) (nth e 3))
    (defn coh-resonances ()
        (list
            (coh-pair 1 1 "heart-brain"
                "entrainment — two systems sharing one rhythm; HRV/brain coherence near 0.1 Hz")
            (coh-pair 2 1 "matter/music"
                "the octave — frequency doubling; the first overtone of every vibrating body")
            (coh-pair 3 2 "harmonic/orbit"
                "the perfect fifth — strongest lock after the octave; seen in orbital mean-motion resonances")
            (coh-pair 4 3 "harmonic"
                "the perfect fourth — the next strong lock")
            (coh-pair 7 5 "weak"
                "a complex ratio — wide denominator, narrow tongue; barely coheres")))

    ;; ---- the strongest coupling in the seeded ladder ----------------------
    ;; fold the table, keep the minimum lock-order entry. The 1:1 entrainment
    ;; (heart-brain) is the strongest — computed, not asserted.
    (defn coh-strongest-loop (pairs best)
        (if (nil? pairs) best
            (coh-strongest-loop (tail pairs)
                (if (lt (coh-lock-order (coh-pair-p (head pairs)) (coh-pair-q (head pairs)))
                        (coh-lock-order (coh-pair-p best) (coh-pair-q best)))
                    (head pairs)
                    best))))
    (defn coh-strongest ()
        (coh-strongest-loop (tail (coh-resonances)) (head (coh-resonances))))

    ;; ---- the answer face (flat composition via a small joiner) ------------
    (defn coh-j (a b) (str_concat a b))
    (defn coh-decode (fa fb)
        (coh-j (coh-ratio-str fa fb)
        (coh-j " — lock order "
        (coh-j (coh-int (coh-lock-order fa fb))
               (if (le (coh-lock-order fa fb) 5) " (coherent)" " (weak coupling)")))))

    0)
