// grammars/python-bmf.fk - Python grammar as native BMF object rules
import form-stdlib/form-ontology-loader.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/compiler.fk;
section [form.bml] {
    //
    // The Python path below matches BMF source objects directly. There is no
    // host parser, no lexical layer, and no TypeScript lowering in this file:
    // a sensing layer supplies BMF stack objects, rules consume those objects,
    // and completed matches emit reversible Form objects.
    //
    // PY-BMF category coordinates live in the reviewed Form blueprint table.
    // form-ontology-loader.fk binds their names before callers are compiled.
    //; top-level: a let here is a global the defns below can see -- on fkwu a do-local let never reaches a defn frame
    //; --- source-object helpers ---------------------------------------
    def py-keyword(value) = bmf-atom("py-keyword", value);
    def py-name(value) = bmf-atom("py-name", value);
    def py-op(value) = bmf-atom("py-op", value);
    def py-int(value) = bmf-atom("py-int", value);
    def py-float(value) = bmf-atom("py-float", value);
    def py-string(value) = bmf-atom("py-string", value);
    def py-bytes(value) = bmf-atom("py-bytes", value);
    def py-fstring(value) = bmf-atom("py-fstring", value);
    def py-tstring(value) = bmf-atom("py-tstring", value);
    def py-layout(value) = bmf-atom("py-layout", value);
    //; Python source sensing is dialect data, not a host tokenizer. The
    //; generic Form source scanner reads characters, attaches cursor ranges,
    //; and emits these BMF source objects for the Python rules below.
    let python-source-keywords = ["import", "from", "as", "def", "return", "class", "pass", "if", "else", "elif", "while", "for", "in", "with", "async", "await", "try", "except", "finally", "raise", "True", "False", "None", "not", "and", "or", "yield", "global", "nonlocal", "del", "assert", "match", "case", "lambda", "is", "type"];
    let python-source-ops = ["**=", "//=", ">>=", "<<=", ":=", "==", "!=", "<=", ">=", "->", "@=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "**", "//", "<<", ">>", "...", "(", ")", "[", "]", "{", "}", ",", ":", ".", ";", "@", "=", "+", "-", "*", "/", "%", "&", "|", "^", "~", "<", ">", "!"];
    def python-source-dialect(_unused) = fsc-source-dialect(python-source-keywords, "py-keyword", "py-name", "py-int", "py-string", "py-op", "py-eof", python-source-ops);
    def python-source-quote?(ch) = (String) ch == "\"" || (String) ch == "'";
    def python-source-string-prefix?(ch) = (String) ch == "r" || ((String) ch == "R" || ((String) ch == "b" || ((String) ch == "B" || ((String) ch == "f" || ((String) ch == "F" || ((String) ch == "t" || ((String) ch == "T" || ((String) ch == "u" || (String) ch == "U"))))))));
    def python-source-prefix-has?(prefix, low, up) = fsc-contains?(prefix, low) || fsc-contains?(prefix, up);
    def python-source-prefix-string-kind(prefix) = python-source-prefix-has?(prefix, "f", "F") ? "py-fstring" : python-source-prefix-has?(prefix, "t", "T") ? "py-tstring" : python-source-prefix-has?(prefix, "b", "B") ? "py-bytes" : "py-string";
    def python-source-skip-comment(cursor) = fsc-source-cursor-end?(cursor) ? cursor : (String) fsc-source-cursor-char(cursor) == "\n" ? fsc-source-cursor-advance(cursor) : python-source-skip-comment(fsc-source-cursor-advance(cursor));
    def python-source-scan-skip(cursor) = fsc-source-cursor-end?(cursor) ? cursor : fsc-space?(fsc-source-cursor-char(cursor)) ? python-source-scan-skip(fsc-source-cursor-advance(cursor)) : (String) fsc-source-cursor-char(cursor) == "#" ? python-source-scan-skip(python-source-skip-comment(cursor)) : cursor;
    //; Slice the source text between two cursor offsets. Both cursors must
    //; share the same underlying source. Used by scanners that track start
    //; and end positions and extract the token text once via substring —
    //; O(N) instead of O(N²) per-byte str_concat accumulation.
    def python-source-cursor-slice(start-cursor, end-cursor) = fsc-source-cursor-file?(start-cursor) ? read_file_slice(fsc-source-cursor-source(start-cursor), fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(end-cursor) - fsc-source-cursor-offset(start-cursor)) : substring(fsc-source-cursor-source(start-cursor), fsc-source-cursor-offset(start-cursor), fsc-source-cursor-offset(end-cursor));
    //; Track start/end positions through the loop; extract the token text
    //; once at termination. The returned (list value cursor) shape is
    //; preserved so callers don't change. Backslash escapes still consume
    //; two characters in source — the slice carries both verbatim, which
    //; matches the prior accumulator's behaviour (it appended the char
    //; after the backslash, never the backslash itself; the prior shape
    //; was lossy on backslashes and the slice preserves them as written).
    def python-source-scan-string-loop(start-cursor, cursor, quote) = fsc-source-cursor-end?(cursor) ? [python-source-cursor-slice(start-cursor, cursor), cursor] : (String) fsc-source-cursor-char(cursor) == "\\" ? python-source-scan-string-loop(start-cursor, fsc-source-cursor-advance(fsc-source-cursor-advance(cursor)), quote) : (String) fsc-source-cursor-char(cursor) == quote ? [python-source-cursor-slice(start-cursor, cursor), fsc-source-cursor-advance(cursor)] : python-source-scan-string-loop(start-cursor, fsc-source-cursor-advance(cursor), quote);
    def python-source-scan-triple-string-loop(start-cursor, cursor, quote) = fsc-source-cursor-end?(cursor) ? [python-source-cursor-slice(start-cursor, cursor), cursor] : fsc-source-cursor-prefix?(cursor, quote) && (fsc-source-cursor-prefix?(fsc-source-cursor-advance(cursor), quote) && fsc-source-cursor-prefix?(fsc-source-cursor-advance(fsc-source-cursor-advance(cursor)), quote)) ? [python-source-cursor-slice(start-cursor, cursor), fsc-source-advance-n(cursor, 3)] : python-source-scan-triple-string-loop(start-cursor, fsc-source-cursor-advance(cursor), quote);
    def python-source-scan-string-at(start, quote, string-kind) = {
        let open-quote = fsc-source-cursor-char(start);
        fsc-source-cursor-prefix?(start, open-quote) && (fsc-source-cursor-prefix?(fsc-source-cursor-advance(start), open-quote) && fsc-source-cursor-prefix?(fsc-source-cursor-advance(fsc-source-cursor-advance(start)), open-quote)) ? {
            let body-start = fsc-source-advance-n(start, 3);
            let read = python-source-scan-triple-string-loop(body-start, body-start, open-quote);
            fsc-scan-result(fsc-source-object(string-kind, read[0], start, read[1]), read[1]);
        } : {
            let body-start = fsc-source-cursor-advance(start);
            (String) fsc-source-cursor-char(body-start) == open-quote ? fsc-scan-result(fsc-source-object(string-kind, "", start, fsc-source-cursor-advance(body-start)), fsc-source-cursor-advance(body-start)) : {
                let read = python-source-scan-string-loop(body-start, body-start, open-quote);
                fsc-scan-result(fsc-source-object(string-kind, read[0], start, read[1]), read[1]);
            };
        };
    };
    def python-source-prefixed-string-prefix-len(cursor) = {
        let ch = fsc-source-cursor-char(cursor);
        let next = fsc-source-cursor-char(fsc-source-cursor-advance(cursor));
        let after-next = fsc-source-cursor-char(fsc-source-advance-n(cursor, 2));
        python-source-string-prefix?(ch) && (python-source-string-prefix?(next) && python-source-quote?(after-next)) ? 2 : python-source-string-prefix?(ch) && python-source-quote?(next) ? 1 : 0;
    };
    def python-source-scan-prefixed-string(start, prefix-len) = {
        let quote-start = fsc-source-advance-n(start, prefix-len);
        let prefix = python-source-cursor-slice(start, quote-start);
        python-source-scan-string-at(quote-start, fsc-source-cursor-char(quote-start), python-source-prefix-string-kind(prefix));
    };
    def python-source-prefixed-string-start?(cursor) = python-source-prefixed-string-prefix-len(cursor) > 0;
    def python-source-int-char?(ch) = fsc-digit?(ch) || (String) ch == "_";
    def python-source-scan-int-loop(start-cursor, cursor) = fsc-source-cursor-end?(cursor) ? [python-source-cursor-slice(start-cursor, cursor), cursor] : {
        let ch = fsc-source-cursor-char(cursor);
        python-source-int-char?(ch) ? python-source-scan-int-loop(start-cursor, fsc-source-cursor-advance(cursor)) : [python-source-cursor-slice(start-cursor, cursor), cursor];
    };
    //; A float literal is an integer digit-run, a single ".", and a
    //; fractional digit-run (e.g. 0.5, 2.25, 1.0). The scanner reads the
    //; whole-number part first; if the very next char is "." AND the char
    //; after it is a digit, it is a float — consume the "." and the
    //; fractional digits and emit a "py-float" source object carrying the
    //; full "N.M" slice. Otherwise (no dot, or a dot not followed by a
    //; digit — attribute access "obj.field", or the "2." of "2.method()")
    //; the token stays "py-int" and the "." is left for the op scanner so
    //; the existing ATTR / method-call shapes are untouched. Exponents
    //; (1e9) and leading-dot floats (.5) are a later breath — every demo
    //; today uses the N.M shape.
    def python-source-scan-int(start) = {
        let read = python-source-scan-int-loop(start, start);
        let after-int = read[1];
        !fsc-source-cursor-end?(after-int) && (String) fsc-source-cursor-char(after-int) == "." ? {
            let after-dot = fsc-source-cursor-advance(after-int);
            !fsc-source-cursor-end?(after-dot) && fsc-digit?(fsc-source-cursor-char(after-dot)) ? {
                let frac = python-source-scan-int-loop(after-dot, after-dot);
                let end = frac[1];
                fsc-scan-result(fsc-source-object("py-float", python-source-cursor-slice(start, end), start, end), end);
            } : fsc-scan-result(fsc-source-object("py-int", read[0], start, after-int), after-int);
        } : fsc-scan-result(fsc-source-object("py-int", read[0], start, after-int), after-int);
    };
    def python-source-scan-next(cursor) = {
        let start = python-source-scan-skip(cursor);
        let ch = fsc-source-cursor-char(start);
        let prefix-len = python-source-prefixed-string-prefix-len(start);
        fsc-source-cursor-end?(start) ? fsc-scan-result(fsc-source-object("py-eof", "", start, start), start) : prefix-len > 0 ? python-source-scan-prefixed-string(start, prefix-len) : python-source-quote?(ch) ? python-source-scan-string-at(start, ch, "py-string") : fsc-digit?(ch) ? python-source-scan-int(start) : fsc-source-name-start-char?(ch) ? fsc-source-scan-name(start, python-source-keywords, "py-keyword", "py-name") : fsc-source-scan-op(start, "py-op", python-source-ops);
    };
    def python-source-scan-text-loop(cursor, acc) = {
        let result = python-source-scan-next(cursor);
        let object = fsc-scan-result-object(result);
        (String) bmf-object-kind(object) == "py-eof" ? reverse-list(acc) : python-source-scan-text-loop(fsc-scan-result-cursor(result), cons(object, acc));
    };
    def python-source-scan-text(source) = python-source-scan-text-loop(fsc-source-cursor(source, 0, 1, 0), []);
    def python-source-scan-file(path) = python-source-scan-text-loop(fsc-file-source-cursor(path, 0, 1, 0, file_size(path)), []);
    //; Python layout is part of the language grammar. The scanner reads source
    //; objects first, then derives NEWLINE/INDENT/DEDENT/ENDMARKER objects from
    //; source coordinates so CPython-shaped rules can refer to layout explicitly.
    def py-newline() = py-layout("NEWLINE");
    def py-indent() = py-layout("INDENT");
    def py-dedent() = py-layout("DEDENT");
    def py-endmarker() = py-layout("ENDMARKER");
    def python-layout-dedents(from-indent, to-indent, acc) = from-indent <= to-indent ? acc : python-layout-dedents(from-indent - 4, to-indent, cons(py-dedent(), acc));
    def python-layout-shift(prev-indent, next-indent, acc) = next-indent > prev-indent ? cons(py-indent(), acc) : next-indent < prev-indent ? python-layout-dedents(prev-indent, next-indent, acc) : acc;
    def python-source-layout-loop(objects, prev-line, prev-indent, current-line-start?, acc) = nil?(objects) ? reverse-list(cons(py-endmarker(), python-layout-dedents(prev-indent, 0, acc))) : {
        let object = objects[0];
        let line = python-source-object-line(object);
        let col = python-source-object-col(object);
        let new-line? = line > prev-line;
        let with-newline = new-line? ? cons(py-newline(), acc) : acc;
        let with-layout = new-line? ? python-layout-shift(prev-indent, col, with-newline) : with-newline;
        python-source-layout-loop(objects[1:], line, new-line? ? col : prev-indent, false, cons(object, with-layout));
    };
    def python-source-layout-objects(objects) = python-source-layout-loop(objects, 1, 0, true, []);
    def python-source-scan-text-with-layout(source) = python-source-layout-objects(python-source-scan-text(source));
    def python-source-scan-file-with-layout(path) = python-source-layout-objects(python-source-scan-file(path));
    //; --- generic Python module parse objects --------------------------
    //;
    //; This is the first whole-file parser entry above source sensing. It keeps
    //; source objects intact, groups them into logical statements using source
    //; coordinates and bracket depth, and emits Form-native BMF objects that can
    //; be queried or reversed without the sample-module rule.
    def python-source-object-span(object) = bmf-object-source-span(object)[0];
    def python-source-object-line(object) = fsc-repo-text-line-number(python-source-object-span(object));
    def python-source-object-col(object) = fsc-repo-text-line-start-col(python-source-object-span(object));
    def python-source-open-group?(object) = (String) bmf-object-kind(object) == "py-op" && ((String) bmf-object-value(object) == "(" || ((String) bmf-object-value(object) == "[" || (String) bmf-object-value(object) == "{"));
    def python-source-close-group?(object) = (String) bmf-object-kind(object) == "py-op" && ((String) bmf-object-value(object) == ")" || ((String) bmf-object-value(object) == "]" || (String) bmf-object-value(object) == "}"));
    def python-source-depth-after(depth, object) = python-source-open-group?(object) ? (Number) depth + (Number) 1 : python-source-close-group?(object) ? depth > 0 ? depth - 1 : 0 : depth;
    def python-statement-kind-from-first(object) = (String) bmf-object-kind(object) == "py-keyword" ? bmf-object-value(object) : (String) bmf-object-kind(object) == "py-op" && (String) bmf-object-value(object) == "@" ? "decorator" : "expr";
    def python-statement-kind(objects) = nil?(objects) ? "empty" : python-statement-kind-from-first(objects[0]);
    def python-statement-indent(objects) = nil?(objects) ? 0 : python-source-object-col(objects[0]);
    def python-parse-statement(objects) = bmf-object("py-statement", [python-statement-kind(objects), python-statement-indent(objects), python-statement-cpython-rule-from-tokens(objects), len(objects)], bmf-collection(objects), bmf-identity-inverse);
    def python-statement-kind-value(statement) = bmf-object-value(statement)[0];
    def python-statement-indent-value(statement) = bmf-object-value(statement)[1];
    def python-statement-tokens(statement) = bmf-collection-items(bmf-object-source(statement));
    def python-token-value?(object, value) = (String) bmf-object-value(object) == value;
    def python-statement-token-value?(tokens, index, value) = len(tokens) > index && python-token-value?(nth(tokens, index), value);
    def python-statement-cpython-rule-from-tokens(tokens) = nil?(tokens) ? "empty" : python-statement-token-value?(tokens, 0, "from") ? "import_stmt" : python-statement-token-value?(tokens, 0, "import") ? "import_stmt" : python-statement-token-value?(tokens, 0, "return") ? "return_stmt" : python-statement-token-value?(tokens, 0, "raise") ? "raise_stmt" : python-statement-token-value?(tokens, 0, "pass") ? "pass_stmt" : python-statement-token-value?(tokens, 0, "del") ? "del_stmt" : python-statement-token-value?(tokens, 0, "yield") ? "yield_stmt" : python-statement-token-value?(tokens, 0, "assert") ? "assert_stmt" : python-statement-token-value?(tokens, 0, "break") ? "break_stmt" : python-statement-token-value?(tokens, 0, "continue") ? "continue_stmt" : python-statement-token-value?(tokens, 0, "global") ? "global_stmt" : python-statement-token-value?(tokens, 0, "nonlocal") ? "nonlocal_stmt" : python-statement-token-value?(tokens, 0, "class") ? "class_def" : python-statement-token-value?(tokens, 0, "def") ? "function_def" : python-statement-token-value?(tokens, 0, "async") && python-statement-token-value?(tokens, 1, "def") ? "function_def" : python-statement-token-value?(tokens, 0, "if") ? "if_stmt" : python-statement-token-value?(tokens, 0, "while") ? "while_stmt" : python-statement-token-value?(tokens, 0, "for") || python-statement-token-value?(tokens, 0, "async") && python-statement-token-value?(tokens, 1, "for") ? "for_stmt" : python-statement-token-value?(tokens, 0, "with") || python-statement-token-value?(tokens, 0, "async") && python-statement-token-value?(tokens, 1, "with") ? "with_stmt" : python-statement-token-value?(tokens, 0, "try") ? "try_stmt" : python-statement-token-value?(tokens, 0, "match") ? "match_stmt" : python-statement-token-value?(tokens, 0, "type") ? "type_alias" : python-statement-token-value?(tokens, 1, "=") ? "assignment" : python-statement-token-value?(tokens, 1, ":=") ? "assignment_expression" : "star_expressions";
    def python-statement-cpython-rule(statement) = bmf-object-value(statement)[2];
    def python-statement-token-count(statement) = bmf-object-value(statement)[3];
    def python-parse-module-object(statements, source-objects) = bmf-object("py-module", bmf-collection(statements), bmf-empty(0), bmf-identity-inverse);
    def python-module-statements(module) = bmf-collection-items(bmf-object-value(module));
    def python-module-source-objects-loop(statements, acc) = nil?(statements) ? reverse-list(acc) : python-module-source-objects-loop(statements[1:], append(reverse-list(python-statement-tokens(statements[0])), acc));
    def python-module-source-objects(module) = python-module-source-objects-loop(python-module-statements(module), []);
    def python-statement-tree(statement, children) = bmf-object("py-statement-tree", [python-statement-kind-value(statement), python-statement-indent-value(statement), python-statement-cpython-rule(statement), python-statement-token-count(statement), bmf-collection(children)], bmf-object-source(statement), bmf-identity-inverse);
    def python-statement-tree-kind(tree) = bmf-object-value(tree)[0];
    def python-statement-tree-indent(tree) = bmf-object-value(tree)[1];
    def python-statement-tree-tokens(tree) = bmf-collection-items(bmf-object-source(tree));
    def python-statement-tree-children(tree) = bmf-collection-items(bmf-object-value(tree)[4]);
    def python-statement-tree-cpython-rule(tree) = bmf-object-value(tree)[2];
    def python-statement-tree-token-count(tree) = bmf-object-value(tree)[3];
    def python-parse-block-result(trees, rest) = ["python-parse-block-result", trees, rest];
    def python-parse-block-result-trees(result) = result[1];
    def python-parse-block-result-rest(result) = result[2];
    def python-parse-statement-trees-loop(statements, indent, acc) = nil?(statements) ? python-parse-block-result(reverse-list(acc), []) : {
        let statement = statements[0];
        let statement-indent = python-statement-indent-value(statement);
        statement-indent < indent ? python-parse-block-result(reverse-list(acc), statements) : statement-indent > indent ? python-parse-block-result(reverse-list(acc), statements) : {
            let rest = statements[1:];
            let child-result = !nil?(rest) && python-statement-indent-value(rest[0]) > statement-indent ? python-parse-statement-trees-loop(rest, python-statement-indent-value(rest[0]), []) : python-parse-block-result([], rest);
            let tree = python-statement-tree(statement, python-parse-block-result-trees(child-result));
            python-parse-statement-trees-loop(python-parse-block-result-rest(child-result), indent, cons(tree, acc));
        };
    };
    def python-parse-statement-trees(statements) = python-parse-block-result-trees(python-parse-statement-trees-loop(statements, 0, []));
    def python-parse-module-tree-object(module) = bmf-object("py-module-tree", bmf-collection(python-parse-statement-trees(python-module-statements(module))), bmf-object-source(module), bmf-identity-inverse);
    def python-module-tree-statements(module-tree) = bmf-collection-items(bmf-object-value(module-tree));
    def python-parse-module-tree-file(path) = python-parse-module-tree-object(python-parse-module-file(path));
    def python-parse-module-finish(current, statements, source-objects) = python-parse-module-object(reverse-list(nil?(current) ? statements : cons(python-parse-statement(reverse-list(current)), statements)), source-objects);
    def python-parse-module-loop(remaining, current, current-line, depth, statements, source-objects) = nil?(remaining) ? python-parse-module-finish(current, statements, source-objects) : {
        let object = remaining[0];
        let line = python-source-object-line(object);
        let next-depth = python-source-depth-after(depth, object);
        nil?(current) ? python-parse-module-loop(remaining[1:], [object], line, next-depth, statements, source-objects) : line > current-line && (Comparable) depth == 0 ? python-parse-module-loop(remaining[1:], [object], line, next-depth, cons(python-parse-statement(reverse-list(current)), statements), source-objects) : python-parse-module-loop(remaining[1:], cons(object, current), line, next-depth, statements, source-objects);
    };
    def python-parse-module-objects(source-objects) = python-parse-module-loop(source-objects, [], 0, 0, [], source-objects);
    def python-parse-module-text(source) = python-parse-module-objects(python-source-scan-text(source));
    def python-parse-module-file(path) = python-parse-module-objects(python-source-scan-file(path));
    def kw(value) = object-lit("py-keyword", value);
    def op(value) = object-lit("py-op", value);
    def name(capture-name) = ["capture", capture-name, object-lit("py-name", "")];
    def int-lit(capture-name) = ["capture", capture-name, object-lit("py-int", "")];
    def float-lit(capture-name) = ["capture", capture-name, object-lit("py-float", "")];
    def string-lit(capture-name) = ["capture", capture-name, object-lit("py-string", "")];
    def bytes-lit(capture-name) = ["capture", capture-name, object-lit("py-bytes", "")];
    def fstring-lit(capture-name) = ["capture", capture-name, object-lit("py-fstring", "")];
    def tstring-lit(capture-name) = ["capture", capture-name, object-lit("py-tstring", "")];
    //; Generic source-section aliases. The source compiler names helpers
    //; from the section dialect (`python-kw`, `python-name`, ...), while the
    //; older hand-authored Python rules keep their shorter local names.
    def python-kw(value) = kw(value);
    def python-op(value) = op(value);
    def python-name(capture-name) = name(capture-name);
    def python-int-lit(capture-name) = int-lit(capture-name);
    def python-float-lit(capture-name) = float-lit(capture-name);
    def python-string-lit(capture-name) = string-lit(capture-name);
    def python-bytes-lit(capture-name) = bytes-lit(capture-name);
    def python-fstring-lit(capture-name) = fstring-lit(capture-name);
    def python-tstring-lit(capture-name) = tstring-lit(capture-name);
    //; --- capture helpers ---------------------------------------------
    def pybmf-value(objects, capture-name) = bmf-collection-value(objects, capture-name);
    def pybmf-trivial-string(objects, capture-name) = intern_trivial_string(pybmf-value(objects, capture-name));
    def pybmf-trivial-int(objects, capture-name) = intern_trivial_int(str_to_int(pybmf-value(objects, capture-name)));
    def pybmf-empty-string(_objects) = intern_trivial_string("");
    def pybmf-node-kids(object) = node_children(bmf-object-value(object));
    //; --- emitters -----------------------------------------------------
    def pybmf-emit-import(objects) = intern_node(PY-BMF-IMPORT, [pybmf-trivial-string(objects, "module"), pybmf-trivial-string(objects, "alias")]);
