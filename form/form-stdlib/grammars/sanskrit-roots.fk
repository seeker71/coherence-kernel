// grammars/sanskrit-roots.fk — Sanskrit as the original substrate: dhātu roots,
// words, and the vibrational seed-syllables (bija mantras).
//
// Pāṇini's Dhātupāṭha (~5th c. BCE) lists ~1,943 dhātu — atomic verbal roots,
// each an encoded core meaning — and his Ashtadhyayi gives ordered rules that
// GENERATE the whole language from them: "all words in Sanskrit are ultimately
// derived from these dhātu." That is exactly the substrate: a finite set of
// primitives + composition rules → an unbounded space of structured forms, each
// derivable back to its roots. A word IS its derivation, as a NodeID IS its
// content-address. The oldest formal generative grammar is a content-addressed
// lattice. See lc-panini-the-first-substrate.
//
// ROMANIZATION IS THE KERNEL-COMPARABLE TRUTH. The kernel's string ops measure
// multi-byte text in DIFFERENT units per kernel (Rust counts Unicode scalars,
// Go/TS count bytes — verified: str_len("कर्म") = 4 on Rust, 12 on Go/TS), so
// native Devanāgarī is NOT three-way safe inside .fk data. So this grammar's
// comparable fields are IAST romanization (ASCII, byte-parity-identical); the
// native Devanāgarī for each entry lives in the comment beside it and, in full,
// in the concept doc (markdown renders it perfectly). Present native script to
// humans via the doc; compute on romanization in the kernel.
//
// Two faces, both source-marked (documented scholarship, not channeled):
//   - DHĀTU decoder: a word → its root + the root's meaning + gloss. The "root
//     of each word" made queryable; words sharing a root form its family
//     (content-addressing by dhātu).
//   - BIJA decoder: a seed-syllable → its chakra locus + element + gloss.
// HONEST PARTIAL: seeded with well-attested entries only; honest absence for the
// rest of the ~1,943 roots — never a fabricated table.
//
import form-stdlib/core.fk;
//
section [form.bml] {
    //; ====================================================================
    //; DHĀTU — verbal roots. entry = (word, root, root-meaning, gloss, native).
    //; IAST remains the cross-kernel comparison key; native Devanāgarī is now
    //; first-class local content and can be used for lookup on fkwu/form-cli.
    //; ====================================================================
    def dhatu-entry(word, root, root-meaning, gloss, native) = [word, root, root-meaning, gloss, native];
    def dhatu-word(e) = e[0];
    def dhatu-root(e) = e[1];
    def dhatu-root-meaning(e) = e[2];
    def dhatu-gloss(e) = e[3];
    def dhatu-native(e) = e[4];
    //; The seeded lexicon — attested word→root derivations. Several are the roots
    //; of the body's own lc-w-* Sanskrit cells (e.g. spanda, shakti share the
    //; generative-vibration field these roots name).
    def dhatu-lexicon() = [    //; कर्म  √कृ
dhatu-entry("karma", "sqrt-kr", "to do, to make", "action, deed — that which is done", "कर्म"),     //; धर्म  √धृ
dhatu-entry("dharma", "sqrt-dhr", "to hold, to bear, to sustain", "that which upholds — law, duty, the sustaining order", "धर्म"),     //; प्राण  √अन्
dhatu-entry("prana", "sqrt-an", "to breathe", "breath, life-force — the breathing of the living", "प्राण"),     //; संस्कार  √कृ
dhatu-entry("samskara", "sqrt-kr", "to do, to make", "putting-together, refinement — an impression formed by action", "संस्कार"),     //; तपस्  √तप्
dhatu-entry("tapas", "sqrt-tap", "to heat, to burn", "ascetic heat, disciplined fire — transformation by inner heat", "तपस्"),     //; योग  √युज्
dhatu-entry("yoga", "sqrt-yuj", "to yoke, to join, to unite", "union, yoking — joining the individual to the whole", "योग"),     //; बुद्ध  √बुध्
dhatu-entry("buddha", "sqrt-budh", "to awaken, to know", "the awakened one — one in whom knowing has woken", "बुद्ध"),     //; मन्त्र  √मन्
dhatu-entry("mantra", "sqrt-man", "to think", "instrument of thought — that which carries the mind across", "मन्त्र")];
    def dhatu-scan(entries, word) = nil?(entries) ? empty() : (String) dhatu-word(entries[0]) == word || (String) dhatu-native(entries[0]) == word ? [entries[0]] : dhatu-scan(entries[1:], word);
    def dhatu-decode(word) = dhatu-scan(dhatu-lexicon(), word);
    def dhatu-found?(r) = (Comparable) len(r) == 1 ? 1 : 0;
    def dhatu-of(r) = r[0];
    //; words sharing a root — the root's family. content-addressing by dhātu:
    //; karma and samskara both grow from √कृ (sqrt-kr). The substrate's
    //; equivalence class, keyed by root instead of by gematria-value.
    def dhatu-family-loop(entries, root, acc) = nil?(entries) ? acc : dhatu-family-loop(entries[1:], root, (String) dhatu-root(entries[0]) == root ? cons(dhatu-word(entries[0]), acc) : acc);
    def dhatu-family(root) = dhatu-family-loop(dhatu-lexicon(), root, empty());
    def dhatu-answer(word) = {
        let r = dhatu-decode(word);
        (Comparable) dhatu-found?(r) == 1 ? (dhatu-native(dhatu-of(r)) + (" (" + (dhatu-word(dhatu-of(r)) + (") — root " + (dhatu-root(dhatu-of(r)) + (" (" + (dhatu-root-meaning(dhatu-of(r)) + (") : " + dhatu-gloss(dhatu-of(r)))))))))) : "unknown — this word has no seeded dhātu derivation; honest absence, not fabricated";
    };
    //; ====================================================================
    //; BIJA — seed-syllables. entry = (roman, chakra-roman, element, gloss),
    //; romanized. Native Devanāgarī (लं वं रं यं हं ॐ) in comments + the doc.
    //; ====================================================================
    def bija-entry(roman, chakra, element, gloss) = [roman, chakra, element, gloss];
    def bija-roman(e) = e[0];
    def bija-chakra(e) = e[1];
    def bija-element(e) = e[2];
    def bija-gloss(e) = e[3];
    def bija-lexicon() = [bija-entry("LAM", "Muladhara", "earth",     // लं
"root chakra, base of the spine — grounding"), bija-entry("VAM", "Svadhisthana", "water",     // वं
"sacral chakra, lower abdomen — flow, creativity"), bija-entry("RAM", "Manipura", "fire",     // रं
"solar-plexus chakra — will, transformation"), bija-entry("YAM", "Anahata", "air",     // यं
"heart chakra — love, the unstruck sound"), bija-entry("HAM", "Vishuddha", "ether",     // हं
"throat chakra — voice, expression"), bija-entry("OM", "Ajna", "light",     // ॐ
"third-eye chakra — the primordial sound AUM; insight")];
    def bija-scan(entries, roman) = nil?(entries) ? empty() : (String) bija-roman(entries[0]) == roman ? [entries[0]] : bija-scan(entries[1:], roman);
    def bija-decode(roman) = bija-scan(bija-lexicon(), roman);
    def bija-found?(r) = (Comparable) len(r) == 1 ? 1 : 0;
    def bija-of(r) = r[0];
    def bija-answer(roman) = {
        let r = bija-decode(roman);
        (Comparable) bija-found?(r) == 1 ? (bija-roman(bija-of(r)) + (" — " + (bija-chakra(bija-of(r)) + (" (" + (bija-element(bija-of(r)) + (") : " + bija-gloss(bija-of(r)))))))) : "unknown — this syllable has no seeded bija mapping; honest absence";
    };
    0;
}
