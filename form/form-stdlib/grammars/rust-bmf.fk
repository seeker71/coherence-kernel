// grammars/rust-bmf.fk - Rust grammar as native BMF object rules
import form-stdlib/dialect-categories.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/compiler.fk;
section [form.bml] {
    //
    // Per-dialect category constants (RS-BMF-*) are declared as data in
    // form-stdlib/form-ontology.json; form/scripts/bp-table-emit.bml bakes them into
    // the kernel-native bp table, and form-ontology-loader.fk materializes the
    // Form-side bindings. This file references them as free identifiers; load
    // form-ontology-loader.fk as a prelude before this file.
    //; top-level: a let here is a global the defns below can see -- on fkwu a do-local let never reaches a defn frame
    def rust-src-keyword(value) = bmf-atom("rust-keyword", value);
    def rust-src-name(value) = bmf-atom("rust-name", value);
    def rust-src-op(value) = bmf-atom("rust-op", value);
    def rust-src-string(value) = bmf-atom("rust-string", value);
    def rust-src-int(value) = bmf-atom("rust-int", value);
    def rust-kw(value) = object-lit("rust-keyword", value);
    def rust-op(value) = object-lit("rust-op", value);
    def rust-name(capture-name) = ["capture", capture-name, object-lit("rust-name", "")];
    def rust-string-lit(capture-name) = ["capture", capture-name, object-lit("rust-string", "")];
    def rust-int-lit(capture-name) = ["capture", capture-name, object-lit("rust-int", "")];
    def rsbmf-value(objects, capture-name) = bmf-collection-value(objects, capture-name);
    def rsbmf-string(objects, capture-name) = intern_trivial_string(rsbmf-value(objects, capture-name));
    def rsbmf-node-kids(object) = node_children(bmf-object-value(object));
    def rsbmf-emit-use(objects) = intern_node(RS-BMF-USE, [rsbmf-string(objects, "path")]);
    def rsbmf-emit-mod(objects) = intern_node(RS-BMF-MOD, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-fn0(objects) = intern_node(RS-BMF-FN, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-fn1(objects) = intern_node(RS-BMF-FN, [rsbmf-string(objects, "name"), rsbmf-string(objects, "arg")]);
    def rsbmf-emit-fn-return-add(objects) = intern_node(RS-BMF-FN, [rsbmf-string(objects, "name"), rsbmf-string(objects, "a"), rsbmf-string(objects, "atype"), rsbmf-string(objects, "b"), rsbmf-string(objects, "btype"), rsbmf-string(objects, "rtype"), rsbmf-string(objects, "left"), rsbmf-string(objects, "right")]);
    def rsbmf-source-fn-return-add(object) = {
        let kids = node_children(bmf-object-value(object));
        [rust-src-keyword("fn"), rust-src-name(node_value(kids[0])), rust-src-op("("), rust-src-name(node_value(kids[1])), rust-src-op(":"), rust-src-name(node_value(kids[2])), rust-src-op(","), rust-src-name(node_value(kids[3])), rust-src-op(":"), rust-src-name(node_value(kids[4])), rust-src-op(")"), rust-src-op("->"), rust-src-name(node_value(kids[5])), rust-src-op("{"), rust-src-keyword("return"), rust-src-name(node_value(kids[6])), rust-src-op("+"), rust-src-name(node_value(kids[7])), rust-src-op(";"), rust-src-op("}")];
    };
    def rsbmf-emit-struct(objects) = intern_node(RS-BMF-STRUCT, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-enum(objects) = intern_node(RS-BMF-ENUM, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-impl(objects) = intern_node(RS-BMF-IMPL, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-trait(objects) = intern_node(RS-BMF-TRAIT, [rsbmf-string(objects, "name")]);
    def rsbmf-emit-macro(objects) = intern_node(RS-BMF-MACRO, [rsbmf-string(objects, "name"), rsbmf-string(objects, "arg")]);
    def rsbmf-source-macro(object) = {
        let kids = node_children(bmf-object-value(object));
        [rust-src-name(node_value(kids[0])), rust-src-op("!"), rust-src-op("("), rust-src-string(node_value(kids[1:][0])), rust-src-op(")"), rust-src-op(";")];
    };
    def rsbmf-emit-let-ident(objects) = intern_node(RS-BMF-LET, [rsbmf-string(objects, "name"), rsbmf-string(objects, "value")]);
    def rsbmf-source-let-ident(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("let"), rust-src-name(node_value(kids[0])), rust-src-op("="), rust-src-name(node_value(kids[1])), rust-src-op(";")];
    };
    def rsbmf-int(objects, capture-name) = intern_trivial_int(str_to_int(rsbmf-value(objects, capture-name)));
    def rsbmf-emit-let-int(objects) = intern_node(RS-BMF-LET, [rsbmf-string(objects, "name"), rsbmf-int(objects, "value")]);
    def rsbmf-source-let-int(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("let"), rust-src-name(node_value(kids[0])), rust-src-op("="), rust-src-int(node_value(kids[1]).str()), rust-src-op(";")];
    };
    def rsbmf-emit-return-ident(objects) = intern_node(RS-BMF-RETURN, [rsbmf-string(objects, "value")]);
    def rsbmf-source-return-ident(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("return"), rust-src-name(node_value(kids[0])), rust-src-op(";")];
    };
    def rsbmf-emit-match-default-ident(objects) = intern_node(RS-BMF-MATCH, [rsbmf-string(objects, "value"), rsbmf-string(objects, "arm"), rsbmf-string(objects, "result")]);
    def rsbmf-source-match-default-ident(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("match"), rust-src-name(node_value(kids[0])), rust-src-op("{"), rust-src-name(node_value(kids[1])), rust-src-op("=>"), rust-src-name(node_value(kids[2])), rust-src-op("}")];
    };
    def rsbmf-emit-if-pass(objects) = intern_node(RS-BMF-IF, [rsbmf-string(objects, "cond")]);
    def rsbmf-source-if-pass(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("if"), rust-src-name(node_value(kids[0])), rust-src-op("{"), rust-src-op("}")];
    };
    def rsbmf-emit-loop-empty(_objects) = intern_node(RS-BMF-LOOP, []);
    def rsbmf-source-loop-empty(_object) = [rust-src-keyword("loop"), rust-src-op("{"), rust-src-op("}")];
    def rsbmf-emit-async-fn0(objects) = intern_node(RS-BMF-ASYNC, [rsbmf-string(objects, "name")]);
    def rsbmf-source-async-fn0(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("async"), rust-src-keyword("fn"), rust-src-name(node_value(kids[0])), rust-src-op("("), rust-src-op(")"), rust-src-op("{"), rust-src-op("}")];
    };
    def rsbmf-emit-fn-result-ok(objects) = intern_node(RS-BMF-RESULT, [rsbmf-string(objects, "name"), rsbmf-string(objects, "result"), rsbmf-string(objects, "ok"), rsbmf-string(objects, "err"), rsbmf-string(objects, "ctor"), rsbmf-string(objects, "value")]);
    def rsbmf-source-fn-result-ok(object) = {
        let kids = rsbmf-node-kids(object);
        [rust-src-keyword("fn"), rust-src-name(node_value(kids[0])), rust-src-op("("), rust-src-op(")"), rust-src-op("->"), rust-src-name(node_value(kids[1])), rust-src-op("<"), rust-src-name(node_value(kids[2])), rust-src-op(","), rust-src-name(node_value(kids[3])), rust-src-op(">"), rust-src-op("{"), rust-src-name(node_value(kids[4])), rust-src-op("("), rust-src-name(node_value(kids[5])), rust-src-op(")"), rust-src-op("}")];
    };
    let rust-bmf-native-section = [bmf-native("rsbmf-emit-use", rsbmf-emit-use, RS-BMF-USE), bmf-native("rsbmf-emit-mod", rsbmf-emit-mod, RS-BMF-MOD), bmf-native("rsbmf-emit-fn0", rsbmf-emit-fn0, RS-BMF-FN), bmf-native("rsbmf-emit-fn1", rsbmf-emit-fn1, RS-BMF-FN), bmf-native("rsbmf-emit-fn-return-add", rsbmf-emit-fn-return-add, RS-BMF-FN), bmf-native("rsbmf-emit-struct", rsbmf-emit-struct, RS-BMF-STRUCT), bmf-native("rsbmf-emit-enum", rsbmf-emit-enum, RS-BMF-ENUM), bmf-native("rsbmf-emit-impl", rsbmf-emit-impl, RS-BMF-IMPL), bmf-native("rsbmf-emit-trait", rsbmf-emit-trait, RS-BMF-TRAIT), bmf-native("rsbmf-emit-macro", rsbmf-emit-macro, RS-BMF-MACRO), bmf-native("rsbmf-emit-let-ident", rsbmf-emit-let-ident, RS-BMF-LET), bmf-native("rsbmf-emit-let-int", rsbmf-emit-let-int, RS-BMF-LET), bmf-native("rsbmf-emit-return-ident", rsbmf-emit-return-ident, RS-BMF-RETURN), bmf-native("rsbmf-emit-match-default-ident", rsbmf-emit-match-default-ident, RS-BMF-MATCH), bmf-native("rsbmf-emit-if-pass", rsbmf-emit-if-pass, RS-BMF-IF), bmf-native("rsbmf-emit-loop-empty", rsbmf-emit-loop-empty, RS-BMF-LOOP), bmf-native("rsbmf-emit-async-fn0", rsbmf-emit-async-fn0, RS-BMF-ASYNC), bmf-native("rsbmf-emit-fn-result-ok", rsbmf-emit-fn-result-ok, RS-BMF-RESULT)];
}
section [rust.bmf] {
      use ::= "use" $path:string ";" => rsbmf-emit-use;
      pub-use ::= "pub" "use" $path:string ";" => rsbmf-emit-use;
      mod ::= "mod" $name:name ";" => rsbmf-emit-mod;
      pub-mod ::= "pub" "mod" $name:name ";" => rsbmf-emit-mod;
      fn0 ::= "fn" $name:name "(" ")" "{" "}" => rsbmf-emit-fn0;
      fn1 ::= "fn" $name:name "(" $arg:name ")" "{" "}" => rsbmf-emit-fn1;
      fn-return-add ::= "fn" $name:name "(" $a:name ":" $atype:name "," $b:name ":" $btype:name ")" "->" $rtype:name "{" "return" $left:name "+" $right:name ";" "}" => rsbmf-emit-fn-return-add <= rsbmf-source-fn-return-add;
      struct ::= "struct" $name:name "{" "}" => rsbmf-emit-struct;
      enum ::= "enum" $name:name "{" "}" => rsbmf-emit-enum;
      impl ::= "impl" $name:name "{" "}" => rsbmf-emit-impl;
      trait ::= "trait" $name:name "{" "}" => rsbmf-emit-trait;
      macro-call ::= $name:name "!" "(" $arg:string ")" ";" => rsbmf-emit-macro <= rsbmf-source-macro;
      let-ident ::= "let" $name:name "=" $value:name ";" => rsbmf-emit-let-ident <= rsbmf-source-let-ident;
      let-int ::= "let" $name:name "=" $value:int ";" => rsbmf-emit-let-int <= rsbmf-source-let-int;
      return-ident ::= "return" $value:name ";" => rsbmf-emit-return-ident <= rsbmf-source-return-ident;
      match-default-ident ::= "match" $value:name "{" $arm:name "=>" $result:name "}" => rsbmf-emit-match-default-ident <= rsbmf-source-match-default-ident;
      if-pass ::= "if" $cond:name "{" "}" => rsbmf-emit-if-pass <= rsbmf-source-if-pass;
      loop-empty ::= "loop" "{" "}" => rsbmf-emit-loop-empty <= rsbmf-source-loop-empty;
      async-fn0 ::= "async" "fn" $name:name "(" ")" "{" "}" => rsbmf-emit-async-fn0 <= rsbmf-source-async-fn0;
      fn-result-ok ::= "fn" $name:name "(" ")" "->" $result:name "<" $ok:name "," $err:name ">" "{" $ctor:name "(" $value:name ")" "}" => rsbmf-emit-fn-result-ok <= rsbmf-source-fn-result-ok;
    }

section [form.bml] {
    def rust-bmf-rule-name(r) = r[0];
    def rust-bmf-find-rule(rule-name, rules) = nil?(rules) ? empty() : (String) rust-bmf-rule-name(rules[0]) == rule-name ? rules[0] : rust-bmf-find-rule(rule-name, rules[1:]);
    def apply-rust-bmf-rule(rule-name, object-stream) = apply-object-rule(rust-bmf-find-rule(rule-name, rust-bmf-rules), object-stream);
    let rust-recipe-section = form-rule-recipe-section("rust", [compiler-rule("rust", "use", "Rust use source objects", rsbmf-emit-use), compiler-rule("rust", "mod", "Rust module source objects", rsbmf-emit-mod), compiler-rule("rust", "fn", "Rust function source objects", rsbmf-emit-fn0), compiler-rule("rust", "fn-return-add", "Rust function addition source objects", rsbmf-emit-fn-return-add), compiler-rule("rust", "struct", "Rust struct source objects", rsbmf-emit-struct), compiler-rule("rust", "impl", "Rust impl source objects", rsbmf-emit-impl), compiler-rule("rust", "trait", "Rust trait source objects", rsbmf-emit-trait), compiler-rule("rust", "let", "Rust let source objects", rsbmf-emit-let-ident), compiler-rule("rust", "return", "Rust return source objects", rsbmf-emit-return-ident), compiler-rule("rust", "match", "Rust match source objects", rsbmf-emit-match-default-ident), compiler-rule("rust", "if", "Rust if source objects", rsbmf-emit-if-pass), compiler-rule("rust", "loop", "Rust loop source objects", rsbmf-emit-loop-empty), compiler-rule("rust", "async-fn", "Rust async function source objects", rsbmf-emit-async-fn0), compiler-rule("rust", "result-fn", "Rust Result-returning function source objects", rsbmf-emit-fn-result-ok)]);
    let rust-form-source = form-source("rust", [rust-bmf-second, rust-recipe-section]);
    let rust-bmf-dialect = bmf-dialect("rust", form-section-object(rust-bmf-second), rust-bmf-native-section, rust-bmf-rules);
    0;
}
