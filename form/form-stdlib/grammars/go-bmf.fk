section [form.bml] {
    // grammars/go-bmf.fk - Go grammar as native BMF object rules
import form-stdlib/dialect-categories.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/compiler.fk;
    //
    // Per-dialect category constants (GO-BMF-*) are declared as data in
    // form-stdlib/form-ontology.json; form/scripts/bp-table-emit.bml bakes them into
    // the kernel-native bp table, and form-ontology-loader.fk materializes the
    // Form-side bindings. This file references them as free identifiers; load
    // form-ontology-loader.fk as a prelude before this file.
    //; top-level: a let here is a global the defns below can see -- on fkwu a do-local let never reaches a defn frame
    def go-src-keyword(value) = bmf-atom("go-keyword", value);
    def go-src-name(value) = bmf-atom("go-name", value);
    def go-src-op(value) = bmf-atom("go-op", value);
    def go-src-string(value) = bmf-atom("go-string", value);
    def go-src-int(value) = bmf-atom("go-int", value);
    def go-kw(value) = object-lit("go-keyword", value);
    def go-op(value) = object-lit("go-op", value);
    def go-name(capture-name) = ["capture", capture-name, object-lit("go-name", "")];
    def go-string-lit(capture-name) = ["capture", capture-name, object-lit("go-string", "")];
    def go-int-lit(capture-name) = ["capture", capture-name, object-lit("go-int", "")];
    def gobmf-value(objects, capture-name) = bmf-collection-value(objects, capture-name);
    def gobmf-string(objects, capture-name) = intern_trivial_string(gobmf-value(objects, capture-name));
    def gobmf-int(objects, capture-name) = intern_trivial_int(str_to_int(gobmf-value(objects, capture-name)));
    def gobmf-node-kids(object) = node_children(bmf-object-value(object));
    def gobmf-emit-package(objects) = intern_node(GO-BMF-PACKAGE, [gobmf-string(objects, "name")]);
    def gobmf-source-package(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("package"), go-src-name(node_value(kids[0]))];
    };
    def gobmf-emit-import(objects) = intern_node(GO-BMF-IMPORT, [gobmf-string(objects, "path")]);
    def gobmf-source-import(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("import"), go-src-string(node_value(kids[0]))];
    };
    def gobmf-emit-func0(objects) = intern_node(GO-BMF-FUNC, [gobmf-string(objects, "name")]);
    def gobmf-source-func0(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("func"), go-src-name(node_value(kids[0])), go-src-op("("), go-src-op(")"), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-func2(objects) = intern_node(GO-BMF-FUNC, [gobmf-string(objects, "name"), gobmf-string(objects, "a"), gobmf-string(objects, "b")]);
    def gobmf-source-func2(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("func"), go-src-name(node_value(kids[0])), go-src-op("("), go-src-name(node_value(kids[1])), go-src-op(","), go-src-name(node_value(kids[2])), go-src-op(")"), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-func-return-add(objects) = intern_node(GO-BMF-FUNC, [gobmf-string(objects, "name"), gobmf-string(objects, "a"), gobmf-string(objects, "atype"), gobmf-string(objects, "b"), gobmf-string(objects, "btype"), gobmf-string(objects, "rtype"), gobmf-string(objects, "left"), gobmf-string(objects, "right")]);
    def gobmf-source-func-return-add(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("func"), go-src-name(node_value(kids[0])), go-src-op("("), go-src-name(node_value(kids[1])), go-src-name(node_value(kids[2])), go-src-op(","), go-src-name(node_value(kids[3])), go-src-name(node_value(kids[4])), go-src-op(")"), go-src-name(node_value(kids[5])), go-src-op("{"), go-src-keyword("return"), go-src-name(node_value(kids[6])), go-src-op("+"), go-src-name(node_value(kids[7])), go-src-op("}")];
    };
    def gobmf-emit-method0(objects) = intern_node(GO-BMF-METHOD, [gobmf-string(objects, "recv"), gobmf-string(objects, "name")]);
    def gobmf-source-method0(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("func"), go-src-op("("), go-src-name(node_value(kids[0])), go-src-op(")"), go-src-name(node_value(kids[1])), go-src-op("("), go-src-op(")"), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-struct(objects) = intern_node(GO-BMF-STRUCT, [gobmf-string(objects, "name")]);
    def gobmf-source-struct(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("type"), go-src-name(node_value(kids[0])), go-src-keyword("struct"), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-interface(objects) = intern_node(GO-BMF-INTERFACE, [gobmf-string(objects, "name")]);
    def gobmf-source-interface(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("type"), go-src-name(node_value(kids[0])), go-src-keyword("interface"), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-var-int(objects) = intern_node(GO-BMF-VAR, [gobmf-string(objects, "name"), gobmf-int(objects, "value")]);
    def gobmf-source-var-int(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("var"), go-src-name(node_value(kids[0])), go-src-op("="), go-src-int(node_value(kids[1:][0]).str())];
    };
    def gobmf-emit-const-string(objects) = intern_node(GO-BMF-CONST, [gobmf-string(objects, "name"), gobmf-string(objects, "value")]);
    def gobmf-source-const-string(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("const"), go-src-name(node_value(kids[0])), go-src-op("="), go-src-string(node_value(kids[1]))];
    };
    def gobmf-emit-return-ident(objects) = intern_node(GO-BMF-RETURN, [gobmf-string(objects, "value")]);
    def gobmf-source-return-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("return"), go-src-name(node_value(kids[0]))];
    };
    def gobmf-emit-return-int(objects) = intern_node(GO-BMF-RETURN, [gobmf-int(objects, "value")]);
    def gobmf-source-return-int(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("return"), go-src-int(node_value(kids[0]).str())];
    };
    def gobmf-emit-assign-ident(objects) = intern_node(GO-BMF-ASSIGN, [gobmf-string(objects, "target"), intern_trivial_string("="), gobmf-string(objects, "value")]);
    def gobmf-emit-assign-int(objects) = intern_node(GO-BMF-ASSIGN, [gobmf-string(objects, "target"), intern_trivial_string("="), gobmf-int(objects, "value")]);
    def gobmf-emit-short-var-ident(objects) = intern_node(GO-BMF-ASSIGN, [gobmf-string(objects, "target"), intern_trivial_string(":="), gobmf-string(objects, "value")]);
    def gobmf-emit-short-var-int(objects) = intern_node(GO-BMF-ASSIGN, [gobmf-string(objects, "target"), intern_trivial_string(":="), gobmf-int(objects, "value")]);
    def gobmf-source-assign-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op(node_value(kids[1])), go-src-name(node_value(kids[2]))];
    };
    def gobmf-source-assign-int(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op(node_value(kids[1])), go-src-int(node_value(kids[2]).str())];
    };
    def gobmf-emit-call0(objects) = intern_node(GO-BMF-CALL, [gobmf-string(objects, "callee")]);
    def gobmf-source-call0(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("("), go-src-op(")")];
    };
    def gobmf-emit-call1-ident(objects) = intern_node(GO-BMF-CALL, [gobmf-string(objects, "callee"), gobmf-string(objects, "arg")]);
    def gobmf-source-call1-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("("), go-src-name(node_value(kids[1])), go-src-op(")")];
    };
    def gobmf-emit-selector(objects) = intern_node(GO-BMF-SELECTOR, [gobmf-string(objects, "object"), gobmf-string(objects, "field")]);
    def gobmf-source-selector(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("."), go-src-name(node_value(kids[1]))];
    };
    def gobmf-emit-index-int(objects) = intern_node(GO-BMF-INDEX, [gobmf-string(objects, "object"), gobmf-int(objects, "index")]);
    def gobmf-source-index-int(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("["), go-src-int(node_value(kids[1]).str()), go-src-op("]")];
    };
    def gobmf-emit-if-pass(objects) = intern_node(GO-BMF-IF, [gobmf-string(objects, "cond")]);
    def gobmf-source-if-pass(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("if"), go-src-name(node_value(kids[0])), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-for-range-pass(objects) = intern_node(GO-BMF-FOR, [gobmf-string(objects, "key"), gobmf-string(objects, "value"), gobmf-string(objects, "iter")]);
    def gobmf-source-for-range-pass(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("for"), go-src-name(node_value(kids[0])), go-src-op(","), go-src-name(node_value(kids[1])), go-src-op(":="), go-src-keyword("range"), go-src-name(node_value(kids[2])), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-go-call0(objects) = intern_node(GO-BMF-GO, [gobmf-string(objects, "callee")]);
    def gobmf-source-go-call0(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("go"), go-src-name(node_value(kids[0])), go-src-op("("), go-src-op(")")];
    };
    def gobmf-emit-defer-call0(objects) = intern_node(GO-BMF-DEFER, [gobmf-string(objects, "callee")]);
    def gobmf-source-defer-call0(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("defer"), go-src-name(node_value(kids[0])), go-src-op("("), go-src-op(")")];
    };
    def gobmf-emit-type-alias(objects) = intern_node(GO-BMF-TYPE, [gobmf-string(objects, "name"), gobmf-string(objects, "target")]);
    def gobmf-source-type-alias(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("type"), go-src-name(node_value(kids[0])), go-src-op("="), go-src-name(node_value(kids[1]))];
    };
    def gobmf-emit-switch-case-empty(objects) = intern_node(GO-BMF-SWITCH, [gobmf-string(objects, "value"), gobmf-string(objects, "case")]);
    def gobmf-source-switch-case-empty(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("switch"), go-src-name(node_value(kids[0])), go-src-op("{"), go-src-keyword("case"), go-src-name(node_value(kids[1])), go-src-op(":"), go-src-op("}")];
    };
    def gobmf-emit-select-recv-case-empty(objects) = intern_node(GO-BMF-SELECT, [gobmf-string(objects, "target"), gobmf-string(objects, "channel")]);
    def gobmf-source-select-recv-case-empty(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-keyword("select"), go-src-op("{"), go-src-keyword("case"), go-src-name(node_value(kids[0])), go-src-op(":="), go-src-op("<-"), go-src-name(node_value(kids[1])), go-src-op(":"), go-src-op("}")];
    };
    def gobmf-emit-chan-send-ident(objects) = intern_node(GO-BMF-CHAN, [intern_trivial_string("send"), gobmf-string(objects, "channel"), gobmf-string(objects, "value")]);
    def gobmf-source-chan-send-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[1])), go-src-op("<-"), go-src-name(node_value(kids[2]))];
    };
    def gobmf-emit-chan-recv-ident(objects) = intern_node(GO-BMF-CHAN, [intern_trivial_string("recv"), gobmf-string(objects, "channel")]);
    def gobmf-source-chan-recv-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-op("<-"), go-src-name(node_value(kids[1]))];
    };
    def gobmf-emit-composite-empty(objects) = intern_node(GO-BMF-COMPOSITE, [gobmf-string(objects, "type")]);
    def gobmf-source-composite-empty(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("{"), go-src-op("}")];
    };
    def gobmf-emit-composite-field-ident(objects) = intern_node(GO-BMF-COMPOSITE, [gobmf-string(objects, "type"), gobmf-string(objects, "field"), gobmf-string(objects, "value")]);
    def gobmf-source-composite-field-ident(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-name(node_value(kids[0])), go-src-op("{"), go-src-name(node_value(kids[1])), go-src-op(":"), go-src-name(node_value(kids[2])), go-src-op("}")];
    };
    def gobmf-emit-pointer-type(objects) = intern_node(GO-BMF-PTR-TYPE, [gobmf-string(objects, "name")]);
    def gobmf-source-pointer-type(object) = {
        let kids = gobmf-node-kids(object);
        [go-src-op("*"), go-src-name(node_value(kids[0]))];
    };
    let go-bmf-native-section = [bmf-native("gobmf-emit-package", gobmf-emit-package, GO-BMF-PACKAGE), bmf-native("gobmf-emit-import", gobmf-emit-import, GO-BMF-IMPORT), bmf-native("gobmf-emit-func0", gobmf-emit-func0, GO-BMF-FUNC), bmf-native("gobmf-emit-func-return-add", gobmf-emit-func-return-add, GO-BMF-FUNC), bmf-native("gobmf-emit-method0", gobmf-emit-method0, GO-BMF-METHOD), bmf-native("gobmf-emit-struct", gobmf-emit-struct, GO-BMF-STRUCT), bmf-native("gobmf-emit-interface", gobmf-emit-interface, GO-BMF-INTERFACE), bmf-native("gobmf-emit-var-int", gobmf-emit-var-int, GO-BMF-VAR), bmf-native("gobmf-emit-const-string", gobmf-emit-const-string, GO-BMF-CONST), bmf-native("gobmf-emit-return-ident", gobmf-emit-return-ident, GO-BMF-RETURN), bmf-native("gobmf-emit-return-int", gobmf-emit-return-int, GO-BMF-RETURN), bmf-native("gobmf-emit-assign-ident", gobmf-emit-assign-ident, GO-BMF-ASSIGN), bmf-native("gobmf-emit-assign-int", gobmf-emit-assign-int, GO-BMF-ASSIGN), bmf-native("gobmf-emit-short-var-ident", gobmf-emit-short-var-ident, GO-BMF-ASSIGN), bmf-native("gobmf-emit-short-var-int", gobmf-emit-short-var-int, GO-BMF-ASSIGN), bmf-native("gobmf-emit-call0", gobmf-emit-call0, GO-BMF-CALL), bmf-native("gobmf-emit-call1-ident", gobmf-emit-call1-ident, GO-BMF-CALL), bmf-native("gobmf-emit-selector", gobmf-emit-selector, GO-BMF-SELECTOR), bmf-native("gobmf-emit-index-int", gobmf-emit-index-int, GO-BMF-INDEX), bmf-native("gobmf-emit-if-pass", gobmf-emit-if-pass, GO-BMF-IF), bmf-native("gobmf-emit-for-range-pass", gobmf-emit-for-range-pass, GO-BMF-FOR), bmf-native("gobmf-emit-go-call0", gobmf-emit-go-call0, GO-BMF-GO), bmf-native("gobmf-emit-defer-call0", gobmf-emit-defer-call0, GO-BMF-DEFER), bmf-native("gobmf-emit-type-alias", gobmf-emit-type-alias, GO-BMF-TYPE), bmf-native("gobmf-emit-switch-case-empty", gobmf-emit-switch-case-empty, GO-BMF-SWITCH), bmf-native("gobmf-emit-select-recv-case-empty", gobmf-emit-select-recv-case-empty, GO-BMF-SELECT), bmf-native("gobmf-emit-chan-send-ident", gobmf-emit-chan-send-ident, GO-BMF-CHAN), bmf-native("gobmf-emit-chan-recv-ident", gobmf-emit-chan-recv-ident, GO-BMF-CHAN), bmf-native("gobmf-emit-composite-empty", gobmf-emit-composite-empty, GO-BMF-COMPOSITE), bmf-native("gobmf-emit-composite-field-ident", gobmf-emit-composite-field-ident, GO-BMF-COMPOSITE), bmf-native("gobmf-emit-pointer-type", gobmf-emit-pointer-type, GO-BMF-PTR-TYPE)];
}
section [go.bmf] {
      package ::= "package" $name:name => gobmf-emit-package <= gobmf-source-package;
      import ::= "import" $path:string => gobmf-emit-import <= gobmf-source-import;
      func0 ::= "func" $name:name "(" ")" "{" "}" => gobmf-emit-func0 <= gobmf-source-func0;
      func2 ::= "func" $name:name "(" $a:name "," $b:name ")" "{" "}" => gobmf-emit-func2 <= gobmf-source-func2;
      func-return-add ::= "func" $name:name "(" $a:name $atype:name "," $b:name $btype:name ")" $rtype:name "{" "return" $left:name "+" $right:name "}" => gobmf-emit-func-return-add <= gobmf-source-func-return-add;
      method0 ::= "func" "(" $recv:name ")" $name:name "(" ")" "{" "}" => gobmf-emit-method0 <= gobmf-source-method0;
      struct ::= "type" $name:name "struct" "{" "}" => gobmf-emit-struct <= gobmf-source-struct;
      interface ::= "type" $name:name "interface" "{" "}" => gobmf-emit-interface <= gobmf-source-interface;
      var-int ::= "var" $name:name "=" $value:int => gobmf-emit-var-int <= gobmf-source-var-int;
      const-string ::= "const" $name:name "=" $value:string => gobmf-emit-const-string <= gobmf-source-const-string;
      return-ident ::= "return" $value:name => gobmf-emit-return-ident <= gobmf-source-return-ident;
      return-int ::= "return" $value:int => gobmf-emit-return-int <= gobmf-source-return-int;
      assign-ident ::= $target:name "=" $value:name => gobmf-emit-assign-ident <= gobmf-source-assign-ident;
      assign-int ::= $target:name "=" $value:int => gobmf-emit-assign-int <= gobmf-source-assign-int;
      short-var-ident ::= $target:name ":=" $value:name => gobmf-emit-short-var-ident <= gobmf-source-assign-ident;
      short-var-int ::= $target:name ":=" $value:int => gobmf-emit-short-var-int <= gobmf-source-assign-int;
      call0 ::= $callee:name "(" ")" => gobmf-emit-call0 <= gobmf-source-call0;
      call1-ident ::= $callee:name "(" $arg:name ")" => gobmf-emit-call1-ident <= gobmf-source-call1-ident;
      selector ::= $object:name "." $field:name => gobmf-emit-selector <= gobmf-source-selector;
      index-int ::= $object:name "[" $index:int "]" => gobmf-emit-index-int <= gobmf-source-index-int;
      if-pass ::= "if" $cond:name "{" "}" => gobmf-emit-if-pass <= gobmf-source-if-pass;
      for-range-pass ::= "for" $key:name "," $value:name ":=" "range" $iter:name "{" "}" => gobmf-emit-for-range-pass <= gobmf-source-for-range-pass;
      go-call0 ::= "go" $callee:name "(" ")" => gobmf-emit-go-call0 <= gobmf-source-go-call0;
      defer-call0 ::= "defer" $callee:name "(" ")" => gobmf-emit-defer-call0 <= gobmf-source-defer-call0;
      type-alias ::= "type" $name:name "=" $target:name => gobmf-emit-type-alias <= gobmf-source-type-alias;
      switch-case-empty ::= "switch" $value:name "{" "case" $case:name ":" "}" => gobmf-emit-switch-case-empty <= gobmf-source-switch-case-empty;
      select-recv-case-empty ::= "select" "{" "case" $target:name ":=" "<-" $channel:name ":" "}" => gobmf-emit-select-recv-case-empty <= gobmf-source-select-recv-case-empty;
      chan-send-ident ::= $channel:name "<-" $value:name => gobmf-emit-chan-send-ident <= gobmf-source-chan-send-ident;
      chan-recv-ident ::= "<-" $channel:name => gobmf-emit-chan-recv-ident <= gobmf-source-chan-recv-ident;
      composite-empty ::= $type:name "{" "}" => gobmf-emit-composite-empty <= gobmf-source-composite-empty;
      composite-field-ident ::= $type:name "{" $field:name ":" $value:name "}" => gobmf-emit-composite-field-ident <= gobmf-source-composite-field-ident;
      pointer-type ::= "*" $name:name => gobmf-emit-pointer-type <= gobmf-source-pointer-type;
    }

section [form.bml] {
    def go-bmf-rule-name(r) = r[0];
    def go-bmf-find-rule(rule-name, rules) = nil?(rules) ? [] : (String) go-bmf-rule-name(rules[0]) == rule-name ? rules[0] : go-bmf-find-rule(rule-name, rules[1:]);
    def apply-go-bmf-rule(rule-name, object-stream) = apply-object-rule(go-bmf-find-rule(rule-name, go-bmf-rules), object-stream);
