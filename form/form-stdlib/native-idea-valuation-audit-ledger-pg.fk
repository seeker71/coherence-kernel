; native-idea-valuation-audit-ledger-pg.fk — the Postgres door for the idea
; valuation audit ledger, split out of native-idea-valuation-audit-ledger.fk
; 2026-08-28.
;
; preludes: form-stdlib/core.fk form-stdlib/application-graph-node-port.fk form-stdlib/application-graph-node-port-pg.fk form-stdlib/native-mutation-side-effects.fk form-stdlib/native-mutation-side-effects-pg.fk form-stdlib/native-idea-valuation-audit-ledger.fk
;
; WHY THIS IS ITS OWN CELL. nival-create-audit-ledger-table,
; nival-record-valuation-change and nival-record-batch-valuation-change are the
; only things in the audit ledger that reach pg_exec, and pg_exec is native on
; go / rust / ts and ABSENT on fkwu. nival-run-idea-update-with-valuation-audit
; names no native itself but calls agn-update-node, the nms- wrappers and
; nival-record-valuation-change — all doors that moved — so it travels with
; them. Because they were named inside the parent cell, every chain that
; preluded it inherited the absence as unresolved calls, and fkwu resolves every
; call site in a whole prelude chain while go / rust / ts bind lazily on
; execution: a band that never reaches the door still walled on the fourth arm.
;
; The hash-chain SQL — nival-audit-ledger-ddl-sql, nival-metadata-json,
; nival-valuation-change-insert-sql, nival-hash-recompute-sql,
; nival-audit-ledger-contract-json — asks only for str_concat, which every arm
; has, so it stays in native-idea-valuation-audit-ledger.fk where the band can
; prove the sha256 chain shape four-way.
;
; This follows cache-binary.fk (2026-08-14) and symbols-wire.fk (2026-08-28):
; a cell should not hand its callers a door they did not ask for and cannot open
; on their own arm.
;
; Callers today: form-stdlib/native-mutation-public-gate-pg.fk and
; form-stdlib/integration/native-idea-valuation-audit-ledger-live.fk.

(do
    ;; (nival-create-audit-ledger-table conn) → conn. pgcrypto plus the
    ;; idempotent audit_ledger DDL.
    (defn nival-create-audit-ledger-table (conn)
        (do
            (pg_exec conn (nival-pgcrypto-extension-sql))
            (pg_exec conn (nival-audit-ledger-ddl-sql))
            conn))

    ;; (nival-record-valuation-change conn ...) → conn. One VALUATION_CHANGE
    ;; row appended onto the sha256 hash chain.
    (defn nival-record-valuation-change (conn idea-id field old-value-json new-value-json)
        (do
            (nival-create-audit-ledger-table conn)
            (pg_exec conn (nival-valuation-change-insert-sql
                idea-id
                field
                old-value-json
                new-value-json
                (nival-reason field idea-id)))
            conn))

    ;; (nival-record-batch-valuation-change conn ...) → conn. Same append, with
    ;; the batch reason text.
    (defn nival-record-batch-valuation-change (conn idea-id field old-value-json new-value-json)
        (do
            (nival-create-audit-ledger-table conn)
            (pg_exec conn (nival-valuation-change-insert-sql
                idea-id
                field
                old-value-json
                new-value-json
                (nival-batch-reason field idea-id)))
            conn))

    ;; (nival-run-idea-update-with-valuation-audit conn ...) → conn. The graph
    ;; update, the route-local side effects, and the audit-ledger append in one
    ;; Form-native flow.
    (defn nival-run-idea-update-with-valuation-audit
        (conn mutation-id revision-id node-id name description phase property-patch fields-changed contributor-key-hash author field old-value-json new-value-json)
        (do
            (agn-update-node conn revision-id node-id name description phase property-patch fields-changed "kernel-route-runner" author)
            (nms-create-receipts-table conn)
            (nms-record-cache-invalidation conn mutation-id node-id)
            (if (gt (str_len contributor-key-hash) 0)
                (nms-audit-contributor-key conn contributor-key-hash)
                conn)
            (nms-record-rollback-receipt conn mutation-id node-id)
            (nival-record-valuation-change conn node-id field old-value-json new-value-json)
            conn))

    0)
