//////////////////////////////////////////////////////////////////////
//
// native-whisper-quiet-witness.bml
//
// The quiet two-second fixture is not a transcription-parity success.
// This organ preserves the disagreement as an observed claim: tiny's
// pinned line versus large-v3-turbo on the same WAV. It does not
// rewrite the expected transcript to make them match.
//
// preludes: form-stdlib/native-whisper-transcribe.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeWhisperQuietWitness {
        field FixturePath = "form/form-stdlib/tests/fixtures/ear-okay-2s.wav";
        field TinyPin = "Okay, let's try the guitar.";

        def nwwq-path() = FixturePath();
        def nwwq-tiny() = TinyPin();
        def nwwq-disagreed(tiny, large) = if eq(str_len(large), 0) then 0 else if str_eq(tiny, large) then 0 else 1;
        def nwwq-fixture() = if gt(file_size(nwwq-path()), 0) then 1 else 0;
        def nwwq-text(r) = node_value(json-object-get(r, "text"));
        def nwwq-status(r) = node_value(json-object-get(r, "status"));
        def nwwq-run(events) = nwt-transcribe(nws-base(), nwwq-path(), "en", "", "", events);
        def nwwq-check() {
            let pin = nwwq-tiny();
            let c0 = if eq(nwwq-fixture(), 1) then 1 else 0;
            let c1 = if gt(str_len(pin), 0) then 2 else 0;
            let c2 = if eq(nwwq-disagreed(pin, pin), 0) then 4 else 0;
            add(c0, add(c1, c2));
        }
    }
    0;
}
