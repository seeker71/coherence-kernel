// form-cli-peer-contribution-turnwheel.fk — the resident Form peer joins the
// append-only scannerless turnwheel without surrendering its model/KV residence.
//
// A model result is staged as data before egress.  The exact response bytes and
// their byte count are appended in one physical call; only an observed append
// promotes the returned session and marks the task NodeID seen.  A failed append
// keeps the stage, so the next turn retries persistence without regenerating.
//
// The physical live door may wait on spool-bell-transport between turns.  This
// cell itself neither opens a model nor waits: callers supply an already-live
// session.  CPU/file work and native Metal model work therefore remain distinct
// observable stages, while an external MLX trainer may continue independently.
//
import form-stdlib/form-cli-peer-policy-route.fk;
import form-stdlib/form-cli-peer-source-symbol-action.fk;
import form-stdlib/bml/form-cli-peer-source-roots.bml;
import form-stdlib/bml/form-cli-peer-hearth-telemetry-action.bml;
import form-stdlib/bml/form-cli-peer-direct-answer-bridge.bml;
import form-stdlib/bml/form-cli-peer-provider-receipt.bml;
import form-stdlib/bml/form-cli-peer-token-receipt-ledger.bml;
import form-stdlib/form-cli-peer-heldout-direct-learning.fk;
import form-stdlib/receipt-texture.bml;
// Proven by: form-stdlib/tests/form-cli-peer-contribution-turnwheel-band.fk
section [form.bml] {
    def fcpct-output-open() = "<|form:peer-contribution|>";
    def fcpct-response-open() = "<|form:response|>\n";
    def fcpct-output-close() = "\n<|/form:peer-contribution|>";
    // This names the caller-owned effect surface loaded at live birth. It is
    // deliberately distinct from a hot-swappable policy epoch: policy may
    // select this action, but cannot add it to an older resident image.
    def fcpct-source-action-capability() = "form-cli-peer-source-action-v1";
    def fcpct-direct-answer-action-capability() = "form-cli-peer-direct-answer-v1";
    def fcpct-hearth-telemetry-action-capability() = fcphta-version();
    // The response is length-carried rather than line-carried. Newlines and
    // marker-looking bytes inside model speech are ordinary payload bytes.
    def fcpct-output-frame(task, candidate, signal, contribution, elapsed, response, peer) = (fcpct-output-open() + (fcpat-field("task-node", fcpat-node-text(fcpsi-task-node(task))) + (fcpat-field("candidate-node", fcpat-node-text(fcpsi-candidate-node(candidate))) + (fcpat-field("exchange", fcpsi-task-exchange(task).str()) + (fcpat-field("turn", fcpsi-task-turn(task).str()) + (fcpat-field("signal", signal) + (fcpat-field("contribution", contribution.str()) + (fcpat-field("elapsed-ms", elapsed.str()) + (fcpat-field("route", fcpa-route(peer)) + (fcpat-field("callback-calls", fcpa-callback-calls(peer).str()) + (fcpat-field("tool-status", fcpa-tool-status(peer)) + (fcpat-field("carrier", fcpa-carrier(peer)) + (fcpat-field("value-present", fcpa-value-present?(peer).str()) + (fcpat-field("value", (Comparable) fcpa-value-present?(peer) == 1 ? fcpa-value(peer).str() : "") + (fcpat-field("native-code-generated", fcpa-native-code-generated?(peer).str()) + (fcpat-field("injected-bytes", fcpa-injected-bytes(peer).str()) + (fcpat-field("lookup-count", fcpa-lookup-count(peer).str()) + (fcpat-field("lifecycle", fcpa-lifecycle(peer)) + (fcpat-field("response-bytes", len(response).str()) + ("\n" + (fcpct-response-open() + ((String) response + fcpct-output-close()))))))))))))))))))))));
    def fcpct-output-response(frame) = {
        let key = "\nresponse-bytes=";
        let key-at = str_find(frame, key, 0);
        key-at < 0 ? nothing() : {
            let n-start = key-at + len(key);
            let n-end = str_find(frame, "\n", n-start);
            let body-mark = str_find(frame, fcpct-response-open(), n-end);
            n-end < 0 || body-mark < 0 ? nothing() : {
                let count = str_to_int(substring(frame, n-start, n-end));
                let body-start = body-mark + len(fcpct-response-open());
                let body-end = body-start + count;
                count < 0 || body-end > len(frame) ? nothing() : substring(frame, body-start, body-end);
            };
        };
    };
    // A source-world terminal is content-free durable evidence. The structured
    // ap-msg remains in the peer cursor; this frame records its admission in
    // the same append as the ordinary contribution receipt, without copying
    // source or answer bytes into egress.
    def fcpct-field-rows(rows) = nil?(rows) ? "" : ((String) fcpat-field(rows[0][0], rows[0][1]) + fcpct-field-rows(rows[1:]));
    def fcpct-source-direct?(peer) = !((String) fcpa-route(peer) == "source-knowledge") ? 0 : nothing?(fcpa-cursor(peer)) ? 0 : fcpdsa-result?(fcpa-cursor(peer));
    def fcpct-source-direct(peer) = fcpa-cursor(peer);
    def fcpct-source-raw(peer) = fcpdsa-result-value(fcpct-source-direct(peer));
    def fcpct-source-hit?(peer) = {
        let raw = fcpct-source-raw(peer);
        nothing?(raw) ? 0 : (String) fknq-status(raw) == "hit" ? 1 : 0;
    };
    def fcpct-source-world-yes(peer) = nothing?(fcpdsa-world-message(fcpct-source-direct(peer))) ? 0 : 1;
    def fcpct-source-receipt?(peer) = fcaip-receipt?(fcpdsa-answer-receipt(fcpct-source-direct(peer)));
    def fcpct-source-phase-text(peer, index) = (Comparable) fcpct-source-receipt?(peer) == 1 ? fcaip-phase(fcpdsa-answer-receipt(fcpct-source-direct(peer)), index).str() : "";
    def fcpct-source-node-text(raw) = nothing?(raw) ? "" : fcpat-node-text(raw);
    def fcpct-source-world-frame(task, peer) = !((Comparable) fcpct-source-direct?(peer) == 1) ? "" : {
        let direct = fcpct-source-direct(peer);
        let raw = fcpdsa-result-value(direct);
        let hit = fcpct-source-hit?(peer);
        let request = (Comparable) hit == 1 ? fcpct-source-node-text(fknq-request(raw)) : "";
        let source = (Comparable) hit == 1 ? fcpct-source-node-text(fknq-source-original-of(raw)) : "";
        let entry = (Comparable) hit == 1 ? fcpct-source-node-text(fknq-entry-original-of(raw)) : "";
        let path = (Comparable) hit == 1 ? fknq-source-path(raw) : "";
        let source-id = (Comparable) hit == 1 ? fknq-current-source-id-of(raw) : "";
        let answer-bytes = (Comparable) hit == 1 ? len(fknq-answer(raw)) : 0;
        ("<|form:source-world|>" + (fcpct-field-rows([["source-action", fcpct-source-action-capability()], ["task-node", fcpat-node-text(fcpsi-task-node(task))], ["task-key", fcpct-task-key(task)], ["call-id", fcpct-task-key(task)], ["provenance", "resident-peer"], ["request-node", request], ["source-node", source], ["entry-node", entry], ["source-path", path], ["current-source-id", source-id], ["answer-bytes", answer-bytes.str()], ["lookup-count", fcpdsa-lookup-count(direct).str()], ["model-executed", nothing?(raw) ? "0" : fknq-model-executed?(raw).str()], ["scannerless", nothing?(raw) ? "0" : fknq-scannerless?(raw).str()], ["pif-recipe", pise-request-canonical-key(rpicr-recipe-identity())], ["pif-load", fcpct-source-phase-text(peer, 0)], ["pif-call", fcpct-source-phase-text(peer, 1)], ["pif-return", fcpct-source-phase-text(peer, 2)], ["pif-fault", fcpct-source-phase-text(peer, 3)], ["pif-timeout", fcpct-source-phase-text(peer, 4)], ["pif-release", fcpct-source-phase-text(peer, 5)], ["resident-value", (Comparable) fcpdsa-value-present?(direct) == 1 ? fcpdsa-value(direct).str() : ""], ["world-admitted", fcpct-source-world-yes(peer).str()], ["knowledge-contribution", fcpdsa-knowledge-contribution(direct).str()], ["mutation-contribution", fcpdsa-mutation-contribution(direct).str()]]) + "\n<|/form:source-world|>"));
    };
    def fcpct-node-from-text(text) = {
        let start = len(text) > 0 && (Comparable) str_byte_at(text, 0) == 64 ? 1 : 0;
        let a = str_find(text, ".", start);
        let b = a < 0 ? -1 : str_find(text, ".", a + 1);
        let c = b < 0 ? -1 : str_find(text, ".", b + 1);
        a < 0 || (b < 0 || c < 0) ? nothing() : make_nodeid(str_to_int(substring(text, start, a)), str_to_int(substring(text, a + 1, b)), str_to_int(substring(text, b + 1, c)), str_to_int(substring(text, c + 1, len(text))));
    };
    // Startup recovery is one bounded sequential scan of durable egress. The
    // hot path thereafter uses structural NodeIDs already held in memory.
    def fcpct-recovery-nodes-go(text, at, out) = {
        let key = "\ntask-node=";
        let found = str_find(text, key, at);
        found < 0 ? reverse(out) : {
            let start = found + len(key);
            let stop = str_find(text, "\n", start);
            stop < 0 ? reverse(out) : {
                let node = fcpct-node-from-text(substring(text, start, stop));
                fcpct-recovery-nodes-go(text, stop + 1, nothing?(node) ? out : cons(node, out));
            };
        };
    };
    def fcpct-recovery-nodes(text) = nothing?(text) ? [] : fcpct-recovery-nodes-go(text, 0, []);
    // Cross-residence replay identity comes from the protocol, not from an
    // intern table's visible instance coordinate. Within one endpoint,
    // exchange+turn is stable while intern order may evolve after hot swaps.
    def fcpct-task-key(task) = (fcpsi-task-exchange(task).str() + ("/" + fcpsi-task-turn(task).str()));
    def fcpct-key-seen?(keys, key) = (Comparable) len(keys) == 0 ? 0 : (String) keys[0] == key ? 1 : fcpct-key-seen?(keys[1:], key);
    def fcpct-recovery-keys-go(text, at, out) = {
        let exchange-key = "\nexchange=";
        let turn-key = "\nturn=";
        let exchange-at = str_find(text, exchange-key, at);
        exchange-at < 0 ? reverse(out) : {
            let exchange-start = exchange-at + len(exchange-key);
            let exchange-end = str_find(text, "\n", exchange-start);
            let turn-at = exchange-end < 0 ? -1 : str_find(text, turn-key, exchange-end);
            let turn-start = turn-at < 0 ? -1 : turn-at + len(turn-key);
            let turn-end = turn-start < 0 ? -1 : str_find(text, "\n", turn-start);
            exchange-end < 0 || (turn-start < 0 || turn-end < 0) ? reverse(out) : fcpct-recovery-keys-go(text, turn-end + 1, cons((substring(text, exchange-start, exchange-end) + ("/" + substring(text, turn-start, turn-end))), out));
        };
    };
    def fcpct-recovery-keys-from(text) = nothing?(text) ? [] : fcpct-recovery-keys-go(text, 0, []);
    // stage = exact task, peer result/new session, candidate, in-memory ack,
    // and exact bytes waiting for one append.
    def fcpct-stage(task, peer, candidate, ack, frame) = ["form-cli-peer-contribution-stage-v1", task, peer, candidate, ack, frame];
    def fcpct-stage-task(s) = s[1];
    def fcpct-stage-peer(s) = s[2];
    def fcpct-stage-candidate(s) = s[3];
    def fcpct-stage-ack(s) = s[4];
    def fcpct-stage-frame(s) = s[5];
    def fcpct-stage-with-frame(s, frame) = fcpct-stage(fcpct-stage-task(s), fcpct-stage-peer(s), fcpct-stage-candidate(s), fcpct-stage-ack(s), frame);
    // These receipts are typed action outputs, never a parse of answer bytes.
    // The local direct receipt and a later provider receipt have to share their
    // BML-owned NodeID before the ledger can expose a ratio.
    def fcpct-token-receipt(task, peer) = (String) fcpa-route(peer) == fcpdab-route() ? fcpdab-local-token-receipt(task, peer) : (String) fcpa-route(peer) == fcprr-route() ? fcprr-receipt-of(fcpa-cursor(peer)) : nothing();
    def fcpct-token-comparison-frame(ledger, task, peer) = {
        let receipt = fcpct-token-receipt(task, peer);
        nothing?(receipt) ? "" : fcptrl-frame(fcptrl-comparison(ledger, receipt));
    };
    def fcpct-token-receipt-frame(task, peer) = fcptrl-receipt-frame(fcpct-token-receipt(task, peer));
    // The turn's own choice receipt (receipt-texture.bml's Next stone).
    // Everything below is either read straight off the completed crossing
    // (fcpa-value-present?, fcpa-route, fcpa-elapsed-ms, fcpa-tool-status) or
    // is a fixed structural name for this organ; nothing is a guess standing
    // in for a measurement. Outcome is binary — success when a value was
    // structurally observed, silence otherwise — because value-present? is
    // the only measured signal at this boundary; the turnwheel has no
    // separate structural signal for a failed crossing, so it never mints a
    // "fail" outcome it did not observe. Certainty, and the branch-feedback/
    // alignment/knowing/trust value quad, are judgments no organ measures
    // here (R11's own report named certainty and alignment together as what
    // wiring here would otherwise fabricate); they stand at their honest
    // floor, 0, which cr-score-valid? accepts as "not yet known" without
    // reading as a scored, plausible-looking number.
    def fcpct-choice-outcome(peer) = (Comparable) fcpa-value-present?(peer) == 1 ? cr-outcome-success() : cr-outcome-silence();
    def fcpct-choice-knowing(outcome) = (String) outcome == cr-outcome-success() ? "meaning" : "benefit-of-silence";
    def fcpct-choice-trace(outcome) = (String) outcome == cr-outcome-success() ? cr-choice-trace(1, 1, 0, 0) : cr-choice-trace(1, 0, 0, 1);
    def fcpct-choice-selected-path(peer, outcome) = (String) outcome == cr-outcome-silence() ? "none" : fcpa-route(peer);
    def fcpct-choice-cost(peer) = fcpa-elapsed-ms(peer) < 0 ? 0 : fcpa-elapsed-ms(peer);
    def fcpct-choice-organ() = "form-cli-peer-contribution-turnwheel.fk";
    def fcpct-choice-organ-path() = "form/form-stdlib/form-cli-peer-contribution-turnwheel.fk";
    def fcpct-choice-value() = cr-choice-value(cr-kind-core-alignment(), 0, 0, 0, 0);
    def fcpct-choice-receipt(task, peer, now) = {
        let outcome = fcpct-choice-outcome(peer);
        cr-choice-receipt(fcpsi-task-text(task), fcpa-route(peer), "TURN", [], fcpct-choice-selected-path(peer, outcome), outcome, 0, fcpct-choice-value(), fcpa-tool-status(peer), fcpct-choice-organ(), fcpct-choice-organ-path(), now, fcpct-choice-cost(peer), fcpct-choice-trace(outcome));
    };
    // Pairs the receipt with the share receipt-texture.bml's own adapter
    // already reads off fcpct-token-receipt. A route the token ledger never
    // receipted (recipe, source-knowledge, policy) has no measured share, so
    // rtex-share-of-token-receipt answers nothing and texture-of folds to
    // nothing, unposted — never a fabricated entry standing in for one.
    def fcpct-choice-texture(task, peer, now) = texture-of(fcpct-choice-receipt(task, peer, now), rtex-share-of-token-receipt(fcpct-token-receipt(task, peer), fcpct-choice-knowing(fcpct-choice-outcome(peer))));
    def fcpct-make-stage(transport, task, peer, candidate-result, ledger) = {
        let candidate = fcpsi-result-value(candidate-result);
        let signal = fcpsi-result-signal(candidate-result);
        let contribution = fcpa-contribution(peer);
        let response = fcpa-response(peer);
        // The caller receives the direct result before it can be made
        // durable.  A sealed held-out prompt is evaluated here, once, and
        // its redacted learning evidence becomes part of this same staged
        // append.  Any append refusal therefore holds the exact evidence
        // beside the exact answer/session and never asks the model again.
        let heldout-frame = fcphtl-frame(task, peer);
        let ack = fcpat-task-ack(transport, task, "agent", signal, 1, fcpsi-candidate-node(candidate), fcpsi-candidate-state(candidate), "");
        fcpct-stage(task, peer, candidate, ack, (heldout-frame + (fcpdab-token-frame(task, peer) + (fcpct-token-receipt-frame(task, peer) + (fcpct-token-comparison-frame(ledger, task, peer) + ((String) fcpct-source-world-frame(task, peer) + fcpct-output-frame(task, candidate, signal, contribution, fcpa-elapsed-ms(peer), response, peer)))))));
    };
    // state = transport, currently committed session, optional durable-output
    // stage, completed count, executed-recipe contribution count, and stable
    // protocol replay keys recovered from durable egress, plus optional
    // caller-born patch and source contexts. Their authority exists only in
    // resident memory; neither is accepted from task bytes or policy images.
    def fcpct-state(transport, session, staged, completed, contributions, recovery-keys, patch-ctx, source-ctx, token-ledger) = ["form-cli-peer-contribution-turnwheel-v4", transport, session, staged, completed, contributions, recovery-keys, patch-ctx, source-ctx, token-ledger];
    def fcpct-transport(s) = s[1];
    def fcpct-session(s) = s[2];
    def fcpct-staged(s) = s[3];
    def fcpct-completed(s) = s[4];
    def fcpct-contributions(s) = s[5];
    def fcpct-recovery-keys(s) = s[6];
    def fcpct-patch-context(s) = s[7];
    def fcpct-source-context(s) = s[8];
    def fcpct-token-ledger(s) = s[9];
    def fcpct-new(transport, session) = fcpct-state(transport, session, nothing(), 0, 0, [], nothing(), nothing(), fcptrl-empty());
    def fcpct-new-with-patch(transport, session, patch-ctx) = fcpct-state(transport, session, nothing(), 0, 0, [], patch-ctx, nothing(), fcptrl-empty());
    def fcpct-new-with-source(transport, session, source-ctx) = fcpct-state(transport, session, nothing(), 0, 0, [], nothing(), source-ctx, fcptrl-empty());
    // Keep the strict-query context ABI in its first four seats. The fifth
    // seat is an already-computed definition index, born with the residence;
    // neither task bytes nor a policy image can nominate its directories,
    // epoch, or contents.
    def fcpct-source-context-with-index(root, artifact, local-ready, frame-budget, source-index) = [root, artifact, local-ready, frame-budget, source-index];
    def fcpct-source-context-index(source-ctx) = nothing?(source-ctx) || len(source-ctx) < 5 ? nothing() : source-ctx[4];
    def fcpct-transport-meaning-epoch(transport) = {
        let host = ritj-host(fcpat-join(transport));
        let shared = wt-sctx(le-w(fcrt-lw(host)));
        jonb-epoch(fcrt-shared-registry(shared));
    };
    // One live birth resolves this context once. The selected policy action may
    // choose the fixed source effect, but cannot choose any member of it. The
    // definition scan is a cold birth observation; later queries remain inside
    // this retained value until the meaning epoch changes.
    def fcpct-live-source-context(meaning-epoch) = {
        let root = fhcs-default-root();
        let artifact = fknq-default-artifact();
        (String) root == "" ? nothing() : fcpct-source-context-with-index(root, artifact, 0, fknq-max-frame-bytes(), sof-snapshot-build(meaning-epoch, fcpsr-resident-source-roots(root)));
    };
    def fcpct-live-new(transport, session) = fcpct-new-with-source(transport, session, fcpct-live-source-context(fcpct-transport-meaning-epoch(transport)));
    def fcpct-with(s, transport, session, staged, completed, contributions) = fcpct-state(transport, session, staged, completed, contributions, fcpct-recovery-keys(s), fcpct-patch-context(s), fcpct-source-context(s), fcpct-token-ledger(s));
    def fcpct-with-token-ledger(s, ledger) = fcpct-state(fcpct-transport(s), fcpct-session(s), fcpct-staged(s), fcpct-completed(s), fcpct-contributions(s), fcpct-recovery-keys(s), fcpct-patch-context(s), fcpct-source-context(s), ledger);
    def fcpct-with-recovery-keys(s, keys) = fcpct-state(fcpct-transport(s), fcpct-session(s), fcpct-staged(s), fcpct-completed(s), fcpct-contributions(s), keys, fcpct-patch-context(s), fcpct-source-context(s), fcpct-token-ledger(s));
    def fcpct-recover(s, durable-egress) = fcpct-with-token-ledger(fcpct-with-recovery-keys(s, fcpct-recovery-keys-from(durable-egress)), fcptrl-recover(durable-egress));
    def fcpct-task-durable?(s, task) = fcpct-key-seen?(fcpct-recovery-keys(s), fcpct-task-key(task));
    def fcpct-result(state, signal, present, value, reason) = ["form-cli-peer-contribution-result-v1", state, signal, present, value, reason];
    def fcpct-result-state(r) = r[1];
    def fcpct-result-signal(r) = r[2];
    def fcpct-result-present?(r) = r[3];
    def fcpct-result-value(r) = r[4];
    def fcpct-result-reason(r) = r[5];
    def fcpct-transport-with-peer-pending(transport, peer, pending) = fcpat-with(transport, fcpat-join(transport), peer, fcpat-reader-row(transport), pending, fcpat-acks(transport), fcpat-events(transport), fcpat-released?(transport));
    // Append is the commit point. Session promotion and seen admission occur
    // only after the durable carrier accepted the whole length-framed result.
    def fcpct-persist-staged(s) = nothing?(fcpct-staged(s)) ? fcpct-result(s, "nothing", 0, nothing(), "no-staged-result") : {
        let staged = fcpct-staged(s);
        let transport = fcpct-transport(s);
        let task = fcpct-stage-task(staged);
        let ack = fcpct-stage-ack(staged);
        let total = file_append_bytes(fcpat-egress(transport), fcpat-bytes((fcpct-stage-frame(staged) + "\n")));
        total < 0 ? {
            let failed = fcpat-observe(transport, fcpsi-task-exchange(task), "agent-egress", "failure", total);
            fcpct-result(fcpct-with(s, failed, fcpct-session(s), staged, fcpct-completed(s), fcpct-contributions(s)), "failure", 0, nothing(), "egress-append-refused");
        } : {
            let t1 = fcpat-with(transport, fcpat-join(transport), fcpat-peer(transport), fcpat-reader-row(transport), fcpat-pending(transport), append(fcpat-acks(transport), [ack]), fcpat-events(transport), fcpat-released?(transport));
            let t2 = fcpat-with-seen(t1, cons(fcpsi-task-node(task), fcpat-seen(t1)));
            let t3 = fcpat-observe(t2, fcpsi-task-exchange(task), "agent-egress", fcpat-ack-signal(ack), total);
            let peer = fcpct-stage-peer(staged);
            let contribution = fcpa-contribution(peer);
            let next0 = fcpct-with(s, t3, fcpa-session(peer), nothing(), fcpct-completed(s) + 1, fcpct-contributions(s) + contribution);
            let receipt = fcpct-token-receipt(task, peer);
            let next1 = fcpct-with-token-ledger(next0, fcptrl-admit(fcpct-token-ledger(s), receipt));
            let next = fcpct-with-recovery-keys(next1, cons(fcpct-task-key(task), fcpct-recovery-keys(next1)));
            fcpct-result(next, fcpat-ack-signal(ack), 1, fcpct-stage-candidate(staged), "durable-before-seen");
        };
    };
    // Pure staging seam used by the band and by alternative model carriers.
    def fcpct-stage-peer-result(s, task, peer, candidate-result, peer-state) = {
        let transport = fcpct-transport(s);
        let t2 = fcpct-transport-with-peer-pending(transport, peer-state, fcpat-pending(transport)[1:]);
        fcpct-with(s, t2, fcpct-session(s), fcpct-make-stage(t2, task, peer, candidate-result, fcpct-token-ledger(s)), fcpct-completed(s), fcpct-contributions(s));
    };
    // A policy transition is a real durable event but never a generated model
    // answer or recipe contribution. It keeps the same session value and uses
    // the ordinary candidate/append transaction so a failed egress cannot make
    // the task seen. The content-free policy frame precedes the result frame.
    def fcpct-policy-peer(session, response) = fcpa-result-full(session, nothing(), response, 0, 0, "policy", 0, "hit", "form-jit-policy", 0, nothing(), 0, 0, "choice,cut,release", 0);
    def fcpct-policy-response(phase, selection) = ("policy " + (phase + (": " + (fcpr-selection-signal(selection) + (" / " + fcpr-selection-reason(selection))))));
    def fcpct-stage-with-policy-frame(s, task, selection, phase) = {
        let staged = fcpct-staged(s);
        fcpct-with(s, fcpct-transport(s), fcpct-session(s), fcpct-stage-with-frame(staged, ((String) fcpr-frame(task, selection, phase) + fcpct-stage-frame(staged))), fcpct-completed(s), fcpct-contributions(s));
    };
    def fcpct-stage-policy-result(s, task, selection, phase) = {
        let transport = fcpct-transport(s);
        let response = fcpct-policy-response(phase, selection);
        let peer = fcpct-policy-peer(fcpct-session(s), response);
        let candidate = fcpsi-peer-result(fcpat-peer(transport), fcpsi-task-node(task), response, 0, nothing());
        fcpct-stage-with-policy-frame(fcpct-stage-peer-result(s, task, peer, candidate, fcpsi-result-state(candidate)), task, selection, phase);
    };
    // The only effectful model crossing: an already-live session enters and the
    // returned session remains staged until its result is durable.
    def fcpct-run-head-peer(s, budget, now) = {
        let transport = fcpct-transport(s);
        (Comparable) len(fcpat-pending(transport)) == 0 ? fcpct-result(s, "nothing", 0, nothing(), "no-complete-task") : {
            let task = fcpat-pending(transport)[0];
            (Comparable) fcpat-task-seen?(transport, task) == 1 || (Comparable) fcpct-task-durable?(s, task) == 1 ? {
                let t2 = fcpct-transport-with-peer-pending(transport, fcpat-peer(transport), fcpat-pending(transport)[1:]);
                fcpct-result(fcpct-with(s, t2, fcpct-session(s), fcpct-staged(s), fcpct-completed(s), fcpct-contributions(s)), "deduplicated", 1, fcpsi-task-node(task), "durable-task-node-seen");
            } : (String) fcpsi-task-kind(task) == "publish" ? {
                let published = fcpr-publish(transport, task, now);
                let s1 = fcpct-with(s, fcpr-selection-transport(published), fcpct-session(s), fcpct-staged(s), fcpct-completed(s), fcpct-contributions(s));
                fcpct-persist-staged(fcpct-stage-policy-result(s1, task, published, "publish"));
            } : {
                let selected = fcpr-select(transport, task);
                let s1 = fcpct-with(s, fcpr-selection-transport(selected), fcpct-session(s), fcpct-staged(s), fcpct-completed(s), fcpct-contributions(s));
                nothing?(fcpr-selection-action(selected)) ? fcpct-persist-staged(fcpct-stage-policy-result(s1, task, selected, "select")) : {
                    let transport1 = fcpct-transport(s1);
                    // Direct source work branches before the
                    // model-facing observer. Policy chooses
                    // the action only; source authority and
                    // call identity are born by this state.
                    let ran = (String) fcpr-selection-action(selected) == "source-knowledge" ? fcpdsa-run-peer(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task), fcpct-source-context(s1), fcpct-task-key(task), "resident-peer") : (String) fcpr-selection-action(selected) == "source-symbol" ? fcpssa-run-peer(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task), fcpct-source-context(s1), fcpct-transport-meaning-epoch(transport1)) : (String) fcpr-selection-action(selected) == "hearth-telemetry" ? fcphta-run-peer(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task)) : (String) fcpr-selection-action(selected) == "provider-receipt" ? fcprr-run-peer(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task)) : (String) fcpr-selection-action(selected) == fcpdab-route() ? fcpdab-run-peer(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task), budget) : {
                        let stage-context = fcpa-knowledge-stage-egress-context(fcpat-egress(transport1), fcpat-node-text(fcpsi-task-node(task)), fcpct-task-key(task));
                        fcpsi-run-peer-with-action-with-patch-with-stage-context(fcpat-peer(transport1), fcpct-session(s1), fcpsi-task-node(task), budget, fcpct-patch-context(s1), fcpr-selection-action(selected), fcpa-knowledge-stage-observer-with-context, stage-context);
                    };
                    let peer = ran[1];
                    let candidate-result = ran[2];
                    let staged = fcpct-stage-peer-result(s1, task, peer, candidate-result, ran[0]);
                    fcpct-persist-staged(fcpct-stage-with-policy-frame(staged, task, selected, "select"));
                };
            };
        };
    };
    // One shared revolution: retry durable output first; otherwise admit one
    // bounded byte delta and actuate at most one complete task.
    def fcpct-turn(s, now, budget) = !nothing?(fcpct-staged(s)) ? fcpct-persist-staged(s) : {
        let read = fcpat-reader-step(fcpct-transport(s), now);
        let s1 = fcpct-with(s, fcpat-result-state(read), fcpct-session(s), nothing(), fcpct-completed(s), fcpct-contributions(s));
        (Comparable) len(fcpat-pending(fcpct-transport(s1))) == 0 ? fcpct-result(s1, fcpat-result-signal(read), fcpat-result-present?(read), fcpat-result-value(read), "reader-quantum") : fcpct-run-head-peer(s1, budget, now);
    };
    0;
}
