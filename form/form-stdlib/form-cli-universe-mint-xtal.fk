
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-universe-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormUniverseMintAuthority () (list "abstraction" "FormUniverseMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 8)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fum-authority () FormUniverseMintAuthority)
(defn fum-pattern () (list "mint" "heldout" "overlay-fit" "lora-waits"))
(defn fum-skills () (list "bml" "bmf" "lift-sexp" "node-lookup" "craft-cell" "framebuffer" "micro-thought" "evaluate"))
(defn fum-contexts () (list "scannerless cursor" "form.lift dialect" "generate door" "one-turn budget" "Metal organ" "local overlay" "recipe-exec session" "bidirectional diagnostic"))
(defn fum-sources () (list "form/form-stdlib/bml-bmf-stream-curriculum.bml" "form/form-stdlib/grammars/form-lift.fk" "form/form-stdlib/form-cli-qwen-teach-layer.fk" "observe/bidirectional-framebuffer-channel.fk" "observe/inquiry-planes.fk" "docs/live-dynamic-diagnostics.md"))
(defn fum-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fum-bml-stems () (list "BML is an executable source and authority whose lessons lower into Form" "section form.bml compiles through the cursor into recipes the walker runs" "high-grammar authority lives beside the executable companion" "class template field thought and allow are BML organs"))
(defn fum-bmf-stems () (list "a custom BMF grammar is walker-carried data that lowers named fields" "streaming transmutation consumes bytes directly with no tokenizer pre-step" "the live cursor folds raw bytes and preserves state across every chunk boundary" "scannerless-byte-fold is the cursor route never a token list"))
(defn fum-lift-stems () (list "form.lift sits above form.bml adding infix unless when ice liquid compost" "thought name args lowers to a recursive fndef micro-thought" "an s-expression defn lifts to a form.lift def with infix plus" "nothing is control empty is the list they are not the same"))
(defn fum-lookup-stems () (list "emit one complete knowledge-query envelope with compact anchor first and repo-relative path second" "wait for the typed observation then answer only what was requested" "a source-bound caller already carries the path the model owns only the discriminative anchor" "typed hit or miss opens the answer reserve typed nothing opens none"))
(defn fum-craft-stems () (list "NodeID names a cell in the graph after a recipe is interned" "Blueprint is the declared shape a recipe fills" "a recipe is Form the walker runs and a cell is a living organ" "a raw-byte recipe-birth frame interns an invented recipe as a NodeID"))
(defn fum-fb-stems () (list "execute then observe then outbound frame then adjudicate then inbound control then re-observe" "every framebuffer message carries direction exchange-id kind payload and alternative-node" "never store private prompt or answer content in the framebuffer" "a logged event without an applied response is observation not bidirectionality"))
(defn fum-thought-stems () (list "thought kernels route by inquiry plane and missing evidence remains nothing" "when where which are computable what who how why are learned" "a thought name args is a recursive micro-thought the walker can run" "invent a bounded affine recipe and request physical execution by NodeID"))
(defn fum-eval-stems () (list "evaluate is the walker running a recipe to a typed observation" "release is a distinct signal after execution never the same as generate" "a generation plan is not live native execution without separate carrier evidence" "request artifact execution observation refinement crystallization dissolution and release stay distinct"))
(defn fum-stems (class) (if (str_eq class "bml") (fum-bml-stems) (if (str_eq class "bmf") (fum-bmf-stems) (if (str_eq class "lift-sexp") (fum-lift-stems) (if (str_eq class "node-lookup") (fum-lookup-stems) (if (str_eq class "craft-cell") (fum-craft-stems) (if (str_eq class "framebuffer") (fum-fb-stems) (if (str_eq class "micro-thought") (fum-thought-stems) (fum-eval-stems)))))))))
(defn fum-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fum-situation (class i split) (do (let ctxs (fum-contexts)) (let stems (fum-stems class)) (let ctx (nth ctxs (fum-mix i (len ctxs)))) (let stem (nth stems (fum-mix i (len stems)))) (str_concat (fum-prefix split) (str_concat ctx (str_concat " " (str_concat stem (str_concat " case " (int_to_str i))))))))
(defn fum-row (class i split) (list split class (fum-situation class i split)))
(defn fum-class-rows (class i n split acc) (if (eq i n) acc (fum-class-rows class (add i 1) n split (cons (fum-row class i split) acc))))
(defn fum-all-classes (names tn hn acc) (if (eq (len names) 0) acc (fum-all-classes (tail names) tn hn (fum-class-rows (head names) 0 hn (SplitHeldout) (fum-class-rows (head names) 0 tn (SplitTrain) acc)))))
(defn fum-corpus (tn hn) (fum-all-classes (fum-skills) tn hn (tail (list "x"))))
(defn fum-n (tn hn) (mul (NSkills) (add tn hn)))
(defn fum-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fum-has-situation (tail rows) s))))
(defn fum-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fum-train-only (tail rows) (cons (head rows) acc)) (fum-train-only (tail rows) acc))))
(defn fum-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fum-has-situation (fum-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fum-leakage-loop all (tail rows)))))
(defn fum-leakage (rows) (fum-leakage-loop rows rows))
(defn fum-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fum-has-situation seen (nth (head rows) 2)) 1) (fum-unique-loop (tail rows) seen) (fum-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fum-unique (rows) (fum-unique-loop rows (tail (list "x"))))
(defn fum-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fum-count-split (tail rows) split))))
(defn fum-lora-writer () (LoraWriter))
(defn fum-mix-diverse () (if (eq (fum-mix 0 8) (fum-mix 1 8)) 0 1))
(defn fum-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fum-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fum-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fum-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fum-heldout-hit models names (head rows)) (fum-heldout-correct-loop models names (tail rows)))))
(defn fum-heldout-correct (rows) (do (let names (fum-skills)) (let models (fqt-fit rows names)) (fum-heldout-correct-loop models names rows)))
(defn fum-bit (ok bit) (if ok bit 0))
(defn fum-check () (do (let rows (fum-corpus 3 1)) (let n (fum-n 3 1)) (let correct (fum-heldout-correct rows)) (let c0 (fum-bit (eq n 32) 1)) (let c1 (fum-bit (eq (fum-mix-diverse) 1) 2)) (let c2 (fum-bit (eq (fum-leakage rows) 0) 4)) (let c3 (fum-bit (eq (fum-unique rows) n) 8)) (let c4 (fum-bit (and (eq (fum-count-split rows (SplitTrain)) 24) (eq (fum-count-split rows (SplitHeldout)) 8)) 16)) (let c5 (fum-bit (ge correct 6) 32)) (let c6 (fum-bit (eq (fum-lora-writer) 0) 64)) (let c7 (fum-bit (eq (fum-n 5 2) 56) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormUniverseMint () (list "abstraction" "FormUniverseMint" (list "T") (list "fum-mix" "fum-bml-stems" "fum-bmf-stems" "fum-lift-stems" "fum-lookup-stems" "fum-craft-stems" "fum-fb-stems" "fum-thought-stems" "fum-eval-stems" "fum-stems" "fum-prefix" "fum-situation" "fum-row" "fum-class-rows" "fum-all-classes" "fum-corpus" "fum-n" "fum-has-situation" "fum-train-only" "fum-leakage-loop" "fum-leakage" "fum-unique-loop" "fum-unique" "fum-count-split" "fum-lora-writer" "fum-mix-diverse" "fum-predict" "fum-heldout-hit" "fum-heldout-correct-loop" "fum-heldout-correct" "fum-bit" "fum-check") (list "MixA" "MixB" "NSkills" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fum-authority") (list "fum-pattern" "fum-skills" "fum-contexts" "fum-sources")))
0
