; living-world-recipe-tree-relation-prospective.fk -- an admitted recurrent
; relation may participate in a fresh prospective composition without promoting
; the relation Recipe or choosing among plural applicable relations.
;
; The arriving suite must be current, source-disjoint from every relation's
; learning suite, and binding-identity-disjoint from both the successor history
; and those relation suites.  For a resolved ONE case, zero applicable current
; relations falls back to the existing successor composition; one executes that
; relation's already-consented operator; many execute every applicable relation
; and retain every distinct output.  Silence, timeout, alternatives, unknowns,
; and lenses pass through unchanged.  This layer is diagnostic only.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk

(let LWRRP-COMPOSITION (bp "LWRRP-COMPOSITION"))
(let LWRRP-DERIVATION  (bp "LWRRP-DERIVATION"))

; children: exact revised successor, all admitted relation candidates, path.
(defn lwrrp-composition (candidate relations)
    (intern_node LWRRP-COMPOSITION
        (list candidate relations (lwo-local-path))))
(defn lwrrp-composition-candidate (composition)
    (nth (node_children composition) 0))
(defn lwrrp-composition-relations (composition)
    (nth (node_children composition) 1))

(defn lwrrp-history-bindings-items (items field)
    (if (eq (len items) 0) field
        (do
            (let relation (head items))
            (let origin (lwo-emergent-provenance relation))
            (let relation-suite (lwrro-origin-suite origin))
            (lwrrp-history-bindings-items (tail items)
                (lwrtr-union-items
                    (lwo-field-items
                        (lwps-dataset-bindings
                            (lwps-suite-dataset relation-suite)))
                    field)))))
(defn lwrrp-history-bindings (candidate relations)
    (lwrrp-history-bindings-items (lwo-field-items relations)
        (lwrtrp-history-bindings candidate)))
(defn lwrrp-identity-clean? (candidate relations suite)
    (if (eq (lwps-suite-shape-valid? suite) 0) 0
        (lwps-fields-disjoint?
            (lwps-split-prospective (lwps-suite-split suite))
            (lwrrp-history-bindings candidate relations))))

(defn lwrrp-relations-current-items? (world candidate items)
    (if (eq (len items) 0) 1
        (do
            (let relation (head items))
            (if (and (eq (lwrro-integrated-current? world relation) 1)
                     (node_eq
                        (lwrro-origin-parent
                            (lwo-emergent-provenance relation))
                        candidate))
                (lwrrp-relations-current-items?
                    world candidate (tail items)) 0))))
(defn lwrrp-relation-sources-clean-items?
    (world suite-sources items)
    (if (eq (len items) 0) 1
        (do
            (let relation (head items))
            (let origin (lwo-emergent-provenance relation))
            (let relation-sources
                (lwrtep-suite-sources world (lwrro-origin-suite origin)))
            (if (eq (lwps-fields-disjoint?
                        suite-sources relation-sources) 1)
                (lwrrp-relation-sources-clean-items?
                    world suite-sources (tail items)) 0))))
(defn lwrrp-source-clean? (world candidate relations suite threshold)
    (if (or (lt threshold 1)
            (eq (lwo-field-size relations) 0)) 0
        (do
            (let suite-sources (lwrtep-suite-sources world suite))
            (if (and (ge (lwo-field-size suite-sources) threshold)
                     (and (eq (lwrtrp-source-clean?
                                world candidate suite threshold) 1)
                          (eq (lwrrp-relation-sources-clean-items?
                                world suite-sources
                                (lwo-field-items relations)) 1))) 1 0))))
(defn lwrrp-ready? (world candidate relations suite threshold)
    (if (eq (lwps-suite-current? world suite threshold) 0) 0
        (if (eq (lwrtrh-integrated-current? world candidate) 0) 0
            (if (eq (lwrrp-relations-current-items?
                        world candidate (lwo-field-items relations)) 0) 0
                (if (eq (lwrrp-identity-clean?
                            candidate relations suite) 0) 0
                    (lwrrp-source-clean?
                        world candidate relations suite threshold))))))

(defn lwrrp-relation-applies? (relation case)
    (do
        (let invariant
            (lwrro-choice-invariant (lwo-emergent-shape relation)))
        (let binding
            (lwrrn-binding-by-name
                (lwre-binding-items (lwps-case-bindings case))
                (lwrrn-invariant-name invariant)))
        (if (node_eq binding (lwo-none)) 0
            (node_eq (lwre-binding-value binding)
                (lwrrn-invariant-value invariant)))))

; children: exact relation candidate, invariant/trial/Recipe, bindings, output,
; exact bit, and local path.
(defn lwrrp-derivation (relation case output exact)
    (do
        (let choice (lwo-emergent-shape relation))
        (let trial (lwrro-choice-trial choice))
        (intern_node LWRRP-DERIVATION
            (list relation (lwrro-choice-invariant choice) trial
                  (lwrrn-trial-recipe trial) (lwps-case-bindings case) output
                  (intern_trivial_int exact) (lwo-local-path)))))
(defn lwrrp-derive-relations
    (items case expected derivations outputs matches)
    (if (eq (len items) 0) (list derivations outputs matches)
        (do
            (let relation (head items))
            (if (eq (lwrrp-relation-applies? relation case) 0)
                (lwrrp-derive-relations (tail items) case expected
                    derivations outputs matches)
                (do
                    (let trial
                        (lwrro-choice-trial
                            (lwo-emergent-shape relation)))
                    (let output
                        (intern_trivial_int
                            (lwre-evaluate-bound
                                (lwrrn-trial-recipe trial)
                                (lwps-case-bindings case))))
                    (let exact (if (node_eq output expected) 1 0))
                    (let derivation
                        (lwrrp-derivation relation case output exact))
                    (lwrrp-derive-relations (tail items) case expected
                        (lwo-field-add derivations derivation)
                        (lwo-field-add outputs output)
                        (if (eq exact 1)
                            (lwo-field-add matches derivation) matches)))))))

(defn lwrrp-place (candidate relations case)
    (do
        (let ack (lwps-case-immediate case))
        (if (eq (oac-one? ack) 0) (lwrtrp-place candidate case)
            (do
                (let related
                    (lwrrp-derive-relations (lwo-field-items relations)
                        case (oac-payload ack) (lwo-empty-field)
                        (lwo-empty-field) (lwo-empty-field)))
                (if (eq (lwo-field-size (nth related 0)) 0)
                    (lwrtrp-place candidate case)
                    (lwps-placement case (nth related 0) (nth related 1)
                        (nth related 2) (lwps-case-time case)
                        (lwps-case-alternatives case)
                        (lwps-case-unknown case) (lwps-case-lens case)
                        (lwps-case-evidence case)))))))
(defn lwrrp-place-items (items candidate relations field)
    (if (eq (len items) 0) field
        (lwrrp-place-items (tail items) candidate relations
            (lwo-field-add field
                (lwrrp-place candidate relations (head items))))))

(defn lwrrp-evaluate-ready (candidate relations suite)
    (do
        (let dataset (lwps-suite-dataset suite))
        (let composition (lwrrp-composition candidate relations))
        (let placements
            (lwrrp-place-items
                (lwo-field-items (lwps-dataset-cases dataset))
                candidate relations (lwo-empty-field)))
        (lwps-evaluation composition dataset (lwps-suite-split suite)
            (lwps-suite-contract suite) placements
            (lwps-metrics-for placements))))
(defn lwrrp-evaluate (world candidate relations suite threshold)
    (if (eq (lwrrp-ready?
                world candidate relations suite threshold) 0) (lwo-none)
        (lwrrp-evaluate-ready candidate relations suite)))
(defn lwrrp-compare (world candidate relations suite threshold)
    (if (eq (lwrrp-ready?
                world candidate relations suite threshold) 0) (lwo-none)
        (lwps-compare (lwrtrp-evaluate-new-ready candidate suite)
            (lwrrp-evaluate-ready candidate relations suite))))

(defn lwrrp-progress-target (comparison)
    (if (node_eq comparison (lwo-none)) "comparison:nothing"
        (do
            (let delta
                (lwps-delta-values (lwps-comparison-delta comparison)))
            (lcfb-cat (list
                "admissible:"
                (int_to_str (lwps-comparison-admissible comparison))
                ":repeated:"
                (int_to_str (lwps-comparison-repeated comparison))
                ":exact-delta:" (int_to_str (nth delta 2))
                ":plural-delta:" (int_to_str (nth delta 3))
                ":contradicted-delta:" (int_to_str (nth delta 4)))))))

; witnessed: 2026-08-09 -> relation-aware prospective composition observed on fkwu
