// Reversible attention scopes, driven only by generated output bytes.
// Source: https://arxiv.org/abs/2609.02737 (protocol); native interval plan here.
// Prelude/response positions stay absolute. A declaration never evicts KV.
// preludes: form-stdlib/core.fk

section [form.bml] {
    class DeclarativeAttention {
        field DAControlBytes = 128;
        field DAFocusOpen = "<focus magic_chunks=\"";
        field DAMaxChunks = 64;

        // config: prefix end, question start, response start, ordered chunks.
        // chunk: positive id, inclusive start, exclusive end.
        def da-member(x, xs) = if ((Comparable) len(xs) == 0) then 0 else if ((Comparable) x == head(xs)) then 1 else da-member(x, tail(xs));
        def da-chunks-valid(xs, lower, upper, seen) = if ((Comparable) len(xs) == 0) then 1 else if (!((Comparable) len(head(xs)) == 3)) then 0 else da-chunk-valid(head(xs), tail(xs), lower, upper, seen);
        def da-chunk-valid(c, rest, lower, upper, seen) = if (c[0] <= 0) then 0 else if da-member(c[0], seen) then 0 else if (c[1] < lower) then 0 else if (c[2] <= c[1]) then 0 else if (c[2] > upper) then 0 else da-chunks-valid(rest, c[2], upper, cons(c[0], seen));
        def da-config(prefixEnd, questionStart, responseStart, chunks) = if (prefixEnd < 0) then nothing() else if (questionStart < prefixEnd) then nothing() else if (responseStart <= questionStart) then nothing() else if (len(chunks) > DAMaxChunks()) then nothing() else if ((Comparable) da-chunks-valid(chunks, prefixEnd, questionStart, []) == 0) then nothing() else [prefixEnd, questionStart, responseStart, chunks];

        // state: mode, static ranges, live tail start, pending control bytes,
        // refused controls, completed transitions, first response position.
        // Static ranges are resolved ONLY at a completed mode transition.
        def da-state(mode, ranges, tailStart, pending, refused, transitions, responseStart) = [mode, ranges, tailStart, pending, refused, transitions, responseStart];
        def da-initial(cfg) = if nothing?(cfg) then nothing() else da-state(0, [], 0, "", 0, 0, cfg[2]);
        def da-mode(s) = s[0];
        def da-ranges(s) = s[1];
        def da-tail(s) = s[2];
        def da-pending(s) = s[3];
        def da-refused(s) = s[4];
        def da-transitions(s) = s[5];
        def da-held(s, text) = da-state(da-mode(s), da-ranges(s), da-tail(s), text, da-refused(s), da-transitions(s), s[6]);
        def da-global(s, refused) = da-state(0, [], 0, "", (da-refused(s) + refused), (da-transitions(s) + 1), s[6]);
        def da-prefix(cfg) = if ((Comparable) cfg[0] == 0) then [] else [[0, cfg[0]]];
        def da-selected(chunks, ids) = if ((Comparable) len(chunks) == 0) then [] else if da-member(head(chunks)[0], ids) then cons([head(chunks)[1], head(chunks)[2]], da-selected(tail(chunks), ids)) else da-selected(tail(chunks), ids);
        def da-local(s, cfg) = da-state(2, da-prefix(cfg), cfg[1], "", da-refused(s), (da-transitions(s) + 1), cfg[2]);
        def da-focus(s, cfg, ids) {
            let ranges = da-selected(cfg[3], ids);
            if ((Comparable) len(ids) == 0) then da-global(s, 1) else if (!((Comparable) len(ranges) == len(ids))) then da-global(s, 1) else da-state(1, append(da-prefix(cfg), ranges), cfg[1], "", da-refused(s), (da-transitions(s) + 1), cfg[2]);
        }
        def da-digits(text, i) = if (i >= str_len(text)) then 1 else if ((ord(char_at(text, i)) >= 48) && (ord(char_at(text, i)) <= 57)) then da-digits(text, (i + 1)) else 0;
        def da-id(text) = if ((Comparable) str_len(text) == 0) then 0 else if ((Comparable) da-digits(text, 0) == 0) then 0 else if (!((String) int_to_str(str_to_int(text)) == text)) then 0 else str_to_int(text);
        def da-ids(text, acc) {
            let comma = str_find(text, ",", 0);
            let part = if (comma < 0) then text else substring(text, 0, comma);
            let id = da-id(part);
            if (id <= 0) then [] else if da-member(id, acc) then [] else if (comma < 0) then reverse(cons(id, acc)) else da-ids(substring(text, (comma + 1), str_len(text)), cons(id, acc));
        }
        def da-tag(s, tag, cfg) {
            if ((String) tag == "<local>") then da-local(s, cfg)
            else if (((String) tag == "<global>") || (((String) tag == "</global>") || (((String) tag == "</focus>") || ((String) tag == "</local>")))) then da-global(s, 0)
            else if ((Comparable) str_find(tag, "<focus", 0) == 0) then da-focus-tag(s, tag, cfg)
            else da-held(s, "");
        }
        def da-focus-tag(s, tag, cfg) = if (!((Comparable) str_find(tag, DAFocusOpen(), 0) == 0)) then da-global(s, 1) else if (!((String) substring(tag, (str_len(tag) - 2), str_len(tag)) == "\">")) then da-global(s, 1) else da-focus(s, cfg, da-ids(substring(tag, str_len(DAFocusOpen()), (str_len(tag) - 2)), []));
        def da-byte(s, c, cfg) {
            if ((String) c == "<") then da-held(s, c)
            else if ((Comparable) str_len(da-pending(s)) == 0) then s
            else da-control-byte(s, c, cfg, str_concat(da-pending(s), c));
        }
        def da-control-byte(s, c, cfg, held) = if (str_len(held) > DAControlBytes()) then da-global(s, 1) else if ((String) c == ">") then da-tag(s, held, cfg) else da-held(s, held);
        def da-feed-go(s, text, i, cfg) = if (i >= str_len(text)) then s else da-feed-go(da-byte(s, char_at(text, i), cfg), text, (i + 1), cfg);
        def da-feed-output(s, text, cfg) = if nothing?(s) then nothing() else if nothing?(cfg) then nothing() else da-feed-go(s, text, 0, cfg);
        def da-range-count(ranges) = if ((Comparable) len(ranges) == 0) then 0 else ((head(ranges)[1] - head(ranges)[0]) + da-range-count(tail(ranges)));
        def da-attended(s, npos) = if (npos < s[6]) then nothing() else (da-range-count(da-ranges(s)) + (npos - da-tail(s)));
        def da-in-ranges(pos, ranges) = if ((Comparable) len(ranges) == 0) then 0 else if ((pos >= head(ranges)[0]) && (pos < head(ranges)[1])) then 1 else da-in-ranges(pos, tail(ranges));
        def da-visible(s, pos, npos) = if ((pos < 0) || (pos >= npos)) then 0 else if (pos >= da-tail(s)) then 1 else da-in-ranges(pos, da-ranges(s));
    }
    0;
}
