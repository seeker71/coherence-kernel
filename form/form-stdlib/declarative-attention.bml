// Reversible attention scopes, driven only by generated output bytes.
// Source: https://arxiv.org/abs/2609.02737 (protocol); native interval plan here.
// Prelude/response positions stay absolute. A declaration never evicts KV.
// preludes: form-stdlib/core.fk

section [form.bml] {
    class DeclarativeAttention {
        field DAControlBytes = 128;
        field DAFocusOpen = "<focus magic_chunks=\"";
        field DAMaxChunks = 64;

        // config: prefix end, question start, response start, ordered chunks.
        // chunk: positive id, inclusive start, exclusive end.
        def da-member(x, xs) = (Comparable) len(xs) == 0 ? 0 : (Comparable) x == head(xs) ? 1 : da-member(x, tail(xs));
        def da-chunks-valid(xs, lower, upper, seen) = (Comparable) len(xs) == 0 ? 1 : !((Comparable) len(head(xs)) == 3) ? 0 : da-chunk-valid(head(xs), tail(xs), lower, upper, seen);
        def da-chunk-valid(c, rest, lower, upper, seen) = c[0] <= 0 ? 0 : da-member(c[0], seen) ? 0 : c[1] < lower ? 0 : c[2] <= c[1] ? 0 : c[2] > upper ? 0 : da-chunks-valid(rest, c[2], upper, cons(c[0], seen));
        def da-config(prefixEnd, questionStart, responseStart, chunks) = prefixEnd < 0 ? nothing() : questionStart < prefixEnd ? nothing() : responseStart <= questionStart ? nothing() : len(chunks) > DAMaxChunks() ? nothing() : (Comparable) da-chunks-valid(chunks, prefixEnd, questionStart, list()) == 0 ? nothing() : list(prefixEnd, questionStart, responseStart, chunks);

        // state: mode, static ranges, live tail start, pending control bytes,
        // refused controls, completed transitions, first response position.
        // Static ranges are resolved ONLY at a completed mode transition.
        def da-state(mode, ranges, tailStart, pending, refused, transitions, responseStart) = list(mode, ranges, tailStart, pending, refused, transitions, responseStart);
        def da-initial(cfg) = nothing?(cfg) ? nothing() : da-state(0, list(), 0, "", 0, 0, cfg[2]);
        def da-mode(s) = s[0];
        def da-ranges(s) = s[1];
        def da-tail(s) = s[2];
        def da-pending(s) = s[3];
        def da-refused(s) = s[4];
        def da-transitions(s) = s[5];
        def da-held(s, text) = da-state(da-mode(s), da-ranges(s), da-tail(s), text, da-refused(s), da-transitions(s), s[6]);
        def da-global(s, refused) = da-state(0, list(), 0, "", da-refused(s) + refused, da-transitions(s) + 1, s[6]);
        def da-prefix(cfg) = (Comparable) cfg[0] == 0 ? list() : list(list(0, cfg[0]));
        def da-selected(chunks, ids) = (Comparable) len(chunks) == 0 ? list() : da-member(head(chunks)[0], ids) ? cons(list(head(chunks)[1], head(chunks)[2]), da-selected(tail(chunks), ids)) : da-selected(tail(chunks), ids);
        def da-local(s, cfg) = da-state(2, da-prefix(cfg), cfg[1], "", da-refused(s), da-transitions(s) + 1, cfg[2]);
        def da-focus(s, cfg, ids) {
            let ranges = da-selected(cfg[3], ids);
            (Comparable) len(ids) == 0 ? da-global(s, 1) : !((Comparable) len(ranges) == len(ids)) ? da-global(s, 1) : da-state(1, append(da-prefix(cfg), ranges), cfg[1], "", da-refused(s), da-transitions(s) + 1, cfg[2]);
        }
        def da-digits(text, i) = i >= str_len(text) ? 1 : (ord(char_at(text, i)) >= 48) && (ord(char_at(text, i)) <= 57) ? da-digits(text, i + 1) : 0;
        def da-id(text) = (Comparable) str_len(text) == 0 ? 0 : (Comparable) da-digits(text, 0) == 0 ? 0 : !((String) int_to_str(str_to_int(text)) == text) ? 0 : str_to_int(text);
        def da-ids(text, acc) {
            let comma = str_find(text, ",", 0);
            let part = comma < 0 ? text : substring(text, 0, comma);
            let id = da-id(part);
            id <= 0 ? list() : da-member(id, acc) ? list() : comma < 0 ? reverse(cons(id, acc)) : da-ids(substring(text, comma + 1, str_len(text)), cons(id, acc));
        }
        def da-tag(s, tag, cfg) {
            (String) tag == "<local>" ? da-local(s, cfg)
            : ((String) tag == "<global>") || (((String) tag == "</global>") || (((String) tag == "</focus>") || ((String) tag == "</local>"))) ? da-global(s, 0)
            : (Comparable) str_find(tag, "<focus", 0) == 0 ? da-focus-tag(s, tag, cfg)
            : da-held(s, "");
        }
        def da-focus-tag(s, tag, cfg) = !((Comparable) str_find(tag, DAFocusOpen(), 0) == 0) ? da-global(s, 1) : !((String) substring(tag, str_len(tag) - 2, str_len(tag)) == "\">") ? da-global(s, 1) : da-focus(s, cfg, da-ids(substring(tag, str_len(DAFocusOpen()), str_len(tag) - 2), list()));
        def da-byte(s, c, cfg) {
            (String) c == "<" ? da-held(s, c)
            : (Comparable) str_len(da-pending(s)) == 0 ? s
            : da-control-byte(s, c, cfg, da-pending(s) ++ c);
        }
        def da-control-byte(s, c, cfg, held) = str_len(held) > DAControlBytes() ? da-global(s, 1) : (String) c == ">" ? da-tag(s, held, cfg) : da-held(s, held);
        def da-feed-go(s, text, i, cfg) = i >= str_len(text) ? s : da-feed-go(da-byte(s, char_at(text, i), cfg), text, i + 1, cfg);
        def da-feed-output(s, text, cfg) = nothing?(s) ? nothing() : nothing?(cfg) ? nothing() : da-feed-go(s, text, 0, cfg);
        def da-range-count(ranges) = (Comparable) len(ranges) == 0 ? 0 : ((head(ranges)[1] - head(ranges)[0]) + da-range-count(tail(ranges)));
        def da-attended(s, npos) = npos < s[6] ? nothing() : (da-range-count(da-ranges(s)) + (npos - da-tail(s)));
        def da-in-ranges(pos, ranges) = (Comparable) len(ranges) == 0 ? 0 : (pos >= head(ranges)[0]) && (pos < head(ranges)[1]) ? 1 : da-in-ranges(pos, tail(ranges));
        def da-visible(s, pos, npos) = (pos < 0) || (pos >= npos) ? 0 : pos >= da-tail(s) ? 1 : da-in-ranges(pos, da-ranges(s));
    }
    0;
}
