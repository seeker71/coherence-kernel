// land-cadence.fk — siblings land on origin as ordinary breath.
//
// Urs asked that pull and push stop waiting for one pair of hands.
// This cell is that breath: every thirty minutes, and at the close of
// a ready movement, a sibling fetches origin, rebases onto origin/main,
// and pushes. Urs is a cell in the same organ.
//
// Unexplained deletions stay unstaged. Fast-forward and rebase carry
// the line. Force-push stays closed. A conflict keeps both meanings
// and continues. Quiet water turns push into silence (form-cli-local-law).
// Even and clean is a clear picture: nothing to land this breath.
// The organ keeps living. Repeating that picture in chat is noise.
// Before any landing act the drift gates run as one door
// (gate/drift-gates.bml): a red gate lands nothing (lc-land). Beside the
// gates, three lenses are read every breath (lr- rows: authoring altitude,
// carrier mass, belief stamps) and laid against the previous breath's
// readings: moved, steady, first-reading, unobserved. A reading never
// refuses; only a gate does.
//
// preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk
// Proven by: form-stdlib/tests/land-cadence-band.fk
// witnessed: 2026-09-04 -> 2097151
section [form.bml] {
    def lc-interval-minutes() = 30;
    def lc-even() = 0;
    def lc-ahead() = 1;
    def lc-behind() = 2;
    def lc-diverge() = 3;
    def lc-clean() = 0;
    def lc-related() = 1;
    def lc-unrelated() = 2;
    def lc-act-clear() = 0;
    def lc-act-push() = 1;
    def lc-act-rebase-push() = 2;
    def lc-act-resolve() = 3;
    def lc-act-wait-water() = 4;
    def lc-act-hold() = 5;
    def lc-act-commit-land() = 6;
    def lc-act-gate-refused() = 7;
    def lc-seat-sibling() = 0;
    def lc-seat-bus() = 1;
    def lc-shape(ahead, behind) = (Comparable) ahead == 0 && (Comparable) behind == 0 ? lc-even() : (Comparable) behind == 0 ? lc-ahead() : (Comparable) ahead == 0 ? lc-behind() : lc-diverge();
    // dirty / conflict / net are 0-or-1-or-2 integers. Host git is the carrier.
    def lc-act(shape, dirty, conflict, net) = (Comparable) dirty == lc-unrelated() ? lc-act-hold() : (Comparable) conflict == 1 ? lc-act-resolve() : (Comparable) shape == lc-even() ? (Comparable) dirty == lc-related() ? lc-act-commit-land() : lc-act-clear() : (Comparable) net == 0 ? lc-act-wait-water() : (Comparable) dirty == lc-related() ? lc-act-commit-land() : (Comparable) shape == lc-ahead() ? lc-act-push() : lc-act-rebase-push();
    // gates is the drift-gates door's answer: 1 when every gate is green
    // (dg-green?), 0 when any refused. A red gate lands nothing: the acts
    // that land — push, rebase-push, commit-land — become gate-refused;
    // clear, resolve, wait and hold pass through untouched.
    def lc-lands?(act) = (Comparable) act == lc-act-push() || ((Comparable) act == lc-act-rebase-push() || (Comparable) act == lc-act-commit-land()) ? 1 : 0;
    def lc-land(act, gates) = (Comparable) gates == 0 && (Comparable) lc-lands?(act) == 1 ? lc-act-gate-refused() : act;
    def lc-seat() = lc-seat-sibling();
    def lc-force?() = 0;
    def lc-due?(elapsed) = elapsed >= lc-interval-minutes() ? 1 : 0;
    def lc-voice-speak() = 0;
    def lc-voice-quiet() = 1;
    // same-picture = 1 when SHA and shape match the last breath.
    // Repeating a clear picture stays quiet. A first clear, or any land, speaks.
    def lc-voice(act, same-picture) = (Comparable) act == lc-act-clear() && (Comparable) same-picture == 1 ? lc-voice-quiet() : lc-voice-speak();
    def lc-push-lane(net) = fcl-step-lane(fcl-step-push(), net);
    // ---- readings: the three lenses beside the gates. A reading never refuses.
    // The alignment plan keeps itself honest with three numbers the body reads about itself on
    // every landing: authoring altitude, carrier mass, belief stamps. Each
    // lens is a door that prints its report and then its field code as the
    // last line. The breath runs the door, takes the last non-blank line as
    // the reading, and lays it beside the previous breath's reading, kept at
    // hearth-readings as name=value lines; then it says, per lens, moved /
    // steady / first-reading / unobserved. Only a gate refuses: the landing
    // act (lc-land) never reads these rows. The door (land-cadence-live.fk)
    // runs the lenses through host fkwu, the carrier; this recipe reads their
    // words. Authored in .fk because this cell has no .bml authority — the
    // altitude gap is named, not hidden.
    def lr-lens-row(name, command) = list(name, command);
    def lr-name(row) = nth(row, 0);
    def lr-command(row) = nth(row, 1);
    def lr-lenses() = list(lr-lens-row("altitude", "./fkwu observe/authoring-altitude-run.fk"), lr-lens-row("carrier", "./fkwu observe/carrier-mass.bml"), lr-lens-row("beliefs", "./fkwu observe/belief-stamps.bml"));
    def lr-word-unobserved() = "unobserved";
    def lr-word-first() = "first-reading";
    def lr-word-steady() = "steady";
    def lr-word-moved() = "moved";
    // the last non-blank line: trailing newlines shed, then the text after the last newline
    def lr-nl() = byte_to_str(10);
    def lr-nl?(s, i) = (Comparable) ord(char_at(s, i)) == 10;
    def lr-end(s, i) = i < 0 ? -1 : lr-nl?(s, i) ? lr-end(s, i - 1) : i;
    def lr-start(s, i) = i < 0 ? 0 : lr-nl?(s, i) ? i + 1 : lr-start(s, i - 1);
    def lr-last-line-to(s, end) = end < 0 ? "" : substring(s, lr-start(s, end), end + 1);
    def lr-last-line(s) = lr-last-line-to(s, lr-end(s, str_len(s) - 1));
    // a reading is a number. A field code of 0 is each lens's own word for
    // "no reading" (carrier-mass: "0 is an absence, not a mass"; belief-stamps
    // answers 0 when the epoch cannot be read), so 0 reads as unobserved too.
    def lr-digit?(c) = ord(c) >= 48 && ord(c) <= 57;
    def lr-digits-from(s, i) = i >= str_len(s) ? 1 : lr-digit?(char_at(s, i)) ? lr-digits-from(s, i + 1) : 0;
    def lr-digits?(s) = (Comparable) str_len(s) == 0 ? 0 : lr-digits-from(s, 0);
    def lr-value-of-line(l) = (Comparable) lr-digits?(l) == 0 ? lr-word-unobserved() : (String) l == "0" ? lr-word-unobserved() : l;
    def lr-value(out) = nothing?(out) ? lr-word-unobserved() : lr-value-of-line(lr-last-line(out));
    def lr-observed?(value) = (String) value == lr-word-unobserved() ? 0 : 1;
    // the memory: name=value lines. "" when the name has no line, or when the
    // memory was never written (read_file answers nothing for an absent file).
    def lr-key(name) = str_concat(lr-nl(), str_concat(name, "="));
    def lr-cut(hay, from, nl) = substring(hay, from, nl < 0 ? str_len(hay) : nl);
    def lr-prev-at(hay, at) = at < 0 ? "" : lr-cut(hay, at, str_find(hay, lr-nl(), at));
    def lr-after(at, klen) = at < 0 ? -1 : at + klen;
    def lr-prev-in(hay, name) = lr-prev-at(hay, lr-after(str_find(hay, lr-key(name), 0), str_len(lr-key(name))));
    def lr-prev(text, name) = nothing?(text) ? "" : lr-prev-in(str_concat(lr-nl(), text), name);
    // the verdict, and a row: name, value, previous value, verdict
    def lr-verdict(value, prev) = (Comparable) lr-observed?(value) == 0 ? lr-word-unobserved() : (Comparable) str_len(prev) == 0 ? lr-word-first() : (String) value == prev ? lr-word-steady() : lr-word-moved();
    def lr-row-of(name, value, prev) = list(name, value, prev, lr-verdict(value, prev));
    def lr-row(name, out, prev-text) = lr-row-of(name, lr-value(out), lr-prev(prev-text, name));
    def lr-row-name(r) = nth(r, 0);
    def lr-row-value(r) = nth(r, 1);
    def lr-row-prev(r) = nth(r, 2);
    def lr-row-verdict(r) = nth(r, 3);
    // the printed line: "reading carrier=16190043414133 moved from 16190043414130";
    // an unobserved lens says so once and names what the memory keeps
    def lr-unobserved?(r) = (String) lr-row-verdict(r) == lr-word-unobserved();
    def lr-keeps(r) = (Comparable) str_len(lr-row-prev(r)) == 0 ? "" : str_concat(" (memory keeps ", str_concat(lr-row-prev(r), ")"));
    def lr-tail(r) = (String) lr-row-verdict(r) == lr-word-moved() ? str_concat(" from ", lr-row-prev(r)) : lr-unobserved?(r) ? lr-keeps(r) : "";
    def lr-said(r) = lr-unobserved?(r) ? lr-word-unobserved() : str_concat(lr-row-value(r), str_concat(" ", lr-row-verdict(r)));
    def lr-line(r) = str_concat("reading ", str_concat(lr-row-name(r), str_concat("=", str_concat(lr-said(r), lr-tail(r)))));
    // what the memory keeps: this breath's value, or the last observed one when
    // the lens was not read this breath — an absence never overwrites a reading
    def lr-keep(r) = (Comparable) lr-observed?(lr-row-value(r)) == 1 ? lr-row-value(r) : lr-row-prev(r);
    def lr-memory-line(r) = (Comparable) str_len(lr-keep(r)) == 0 ? "" : str_concat(lr-row-name(r), str_concat("=", str_concat(lr-keep(r), lr-nl())));
    def lr-memory(rows) = (Comparable) len(rows) == 0 ? "" : str_concat(lr-memory-line(head(rows)), lr-memory(tail(rows)));
    // how many rows speak a word; the summary line
    def lr-count(rows, word) = (Comparable) len(rows) == 0 ? 0 : ((String) lr-row-verdict(head(rows)) == word ? 1 : 0) + lr-count(tail(rows), word);
    def lr-summary(rows) = str_concat("land-cadence readings moved=", str_concat(int_to_str(lr-count(rows, lr-word-moved())), str_concat(" steady=", str_concat(int_to_str(lr-count(rows, lr-word-steady())), str_concat(" first=", str_concat(int_to_str(lr-count(rows, lr-word-first())), str_concat(" unobserved=", str_concat(int_to_str(lr-count(rows, lr-word-unobserved())), " (a reading never refuses; only a gate does)"))))))));
    def lck(cond, bit) = cond ? bit : 0;
    def lc-check() = {
        // a planted memory, as the previous breath would have left it
        let mem = "altitude=1140020001448\ncarrier=16190043414130\nbeliefs=487457005\n";
        // four planted rows, one per word a reading can speak
        let rows = list(lr-row("altitude", "pictures=114\n1140020001448\n", mem), lr-row("carrier", "field = 16190043414133\n16190043414133\n", mem), lr-row("beliefs", nothing(), mem), lr-row("seed", "16190\n", mem));
        lck((Comparable) lc-interval-minutes() == 30, 1) + lck((Comparable) lc-act(lc-even(), lc-clean(), 0, 1) == lc-act-clear(), 2) + lck((Comparable) lc-act(lc-ahead(), lc-clean(), 0, 1) == lc-act-push(), 4) + lck((Comparable) lc-act(lc-behind(), lc-clean(), 0, 1) == lc-act-rebase-push(), 8) + lck((Comparable) lc-act(lc-diverge(), lc-clean(), 0, 1) == lc-act-rebase-push(), 16) + lck((Comparable) lc-act(lc-ahead(), lc-clean(), 0, 0) == lc-act-wait-water(), 32) + lck((Comparable) lc-act(lc-ahead(), lc-clean(), 1, 1) == lc-act-resolve(), 64) + lck((Comparable) lc-act(lc-ahead(), lc-unrelated(), 0, 1) == lc-act-hold(), 128) + lck((Comparable) lc-force?() == 0, 256) + lck((Comparable) lc-seat() == lc-seat-sibling(), 512) + lck((Comparable) lc-due?(30) == 1 && (Comparable) lc-due?(29) == 0, 1024) + lck((String) lc-push-lane(1) == "local" && (String) lc-push-lane(0) == "nothing", 2048) + lck((Comparable) lc-act(lc-even(), lc-related(), 0, 1) == lc-act-commit-land(), 4096) + lck((Comparable) lc-voice(lc-act-clear(), 1) == lc-voice-quiet() && ((Comparable) lc-voice(lc-act-clear(), 0) == lc-voice-speak() && (Comparable) lc-voice(lc-act-push(), 1) == lc-voice-speak()), 8192) + lck((Comparable) lc-land(lc-act-push(), 0) == lc-act-gate-refused() && ((Comparable) lc-land(lc-act-rebase-push(), 0) == lc-act-gate-refused() && (Comparable) lc-land(lc-act-commit-land(), 0) == lc-act-gate-refused()), 16384) + lck((Comparable) lc-land(lc-act-push(), 1) == lc-act-push() && ((Comparable) lc-land(lc-act-clear(), 0) == lc-act-clear() && (Comparable) lc-land(lc-act-hold(), 0) == lc-act-hold()), 32768) +         // a reading is the lens's trailing field code: the last non-blank line, blank tail shed
lck((String) lr-value("pictures=114\ncells=1448\n1140020001448\n\n") == "1140020001448" && ((String) lr-value("16190043414133") == "16190043414133" && (String) lr-last-line("a\nb\n") == "b"), 65536) +         // moved and steady are read against the planted previous breath
lck((String) lr-row-verdict(nth(rows, 1)) == lr-word-moved() && ((String) lr-row-prev(nth(rows, 1)) == "16190043414130" && ((String) lr-row-verdict(nth(rows, 0)) == lr-word-steady() && (String) lr-line(nth(rows, 1)) == "reading carrier=16190043414133 moved from 16190043414130")), 131072) +         // no previous reading - no memory at all, or no line for this lens - is a first reading
lck((String) lr-row-verdict(lr-row("carrier", "5\n", nothing())) == lr-word-first() && ((String) lr-row-verdict(nth(rows, 3)) == lr-word-first() && (String) lr-line(nth(rows, 3)) == "reading seed=16190 first-reading"), 262144) +         // a lens that answers nothing, or no number, or its own 0, reads unobserved - and the memory keeps the last reading
lck((String) lr-row-verdict(nth(rows, 2)) == lr-word-unobserved() && ((String) lr-line(nth(rows, 2)) == "reading beliefs=unobserved (memory keeps 487457005)" && ((String) lr-keep(nth(rows, 2)) == "487457005" && ((String) lr-value("") == lr-word-unobserved() && ((String) lr-value("carrier mass: host-exec answered nothing\n0\n") == lr-word-unobserved() && (String) lr-value("fkwu: error: something\n") == lr-word-unobserved())))), 524288) +         // readings never gate: rows speaking every word sit beside the landing act and the act is the gate's alone
lck((Comparable) lr-count(rows, lr-word-moved()) == 1 && (Comparable) lr-count(rows, lr-word-steady()) == 1 && ((Comparable) lr-count(rows, lr-word-first()) == 1 && (Comparable) lr-count(rows, lr-word-unobserved()) == 1 && ((String) lr-memory(rows) == "altitude=1140020001448\ncarrier=16190043414133\nbeliefs=487457005\nseed=16190\n" && ((Comparable) lc-land(lc-act-push(), 1) == lc-act-push() && (Comparable) lc-land(lc-act-push(), 0) == lc-act-gate-refused()))), 1048576);
    };
    0;
}
