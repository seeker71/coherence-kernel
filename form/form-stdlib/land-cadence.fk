; land-cadence.fk — siblings land on origin as ordinary breath.
;
; Urs asked that pull and push stop waiting for one pair of hands.
; This cell is that breath: every thirty minutes, and at the close of
; a ready movement, a sibling fetches origin, rebases onto origin/main,
; and pushes. Urs is a cell in the same organ.
;
; Unexplained deletions stay unstaged. Fast-forward and rebase carry
; the line. Force-push stays closed. A conflict keeps both meanings
; and continues. Quiet water turns push into silence (form-cli-local-law).
; Even and clean is a clear picture: nothing to land this breath.
; The organ keeps living. Repeating that picture in chat is noise.
; Before any landing act the drift gates run as one door
; (gate/drift-gates.bml): a red gate lands nothing (lc-land). Beside the
; gates, three lenses are read every breath (lr- rows: authoring altitude,
; carrier mass, belief stamps) and laid against the previous breath's
; readings: moved, steady, first-reading, unobserved. A reading never
; refuses; only a gate does.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk
; Proven by: form-stdlib/tests/land-cadence-band.fk
; witnessed: 2026-09-04 -> 2097151

(do
    (defn lc-interval-minutes () 30)

    (defn lc-even    () 0)
    (defn lc-ahead   () 1)
    (defn lc-behind  () 2)
    (defn lc-diverge () 3)

    (defn lc-clean     () 0)
    (defn lc-related   () 1)
    (defn lc-unrelated () 2)

    (defn lc-act-clear        () 0)
    (defn lc-act-push         () 1)
    (defn lc-act-rebase-push  () 2)
    (defn lc-act-resolve      () 3)
    (defn lc-act-wait-water   () 4)
    (defn lc-act-hold         () 5)
    (defn lc-act-commit-land  () 6)
    (defn lc-act-gate-refused () 7)

    (defn lc-seat-sibling () 0)
    (defn lc-seat-bus     () 1)

    (defn lc-shape (ahead behind)
        (if (and (eq ahead 0) (eq behind 0)) (lc-even)
            (if (eq behind 0) (lc-ahead)
                (if (eq ahead 0) (lc-behind)
                    (lc-diverge)))))

    ; dirty / conflict / net are 0-or-1-or-2 integers. Host git is the carrier.
    (defn lc-act (shape dirty conflict net)
        (if (eq dirty (lc-unrelated)) (lc-act-hold)
            (if (eq conflict 1) (lc-act-resolve)
                (if (eq shape (lc-even))
                    (if (eq dirty (lc-related)) (lc-act-commit-land) (lc-act-clear))
                    (if (eq net 0) (lc-act-wait-water)
                        (if (eq dirty (lc-related)) (lc-act-commit-land)
                            (if (eq shape (lc-ahead)) (lc-act-push)
                                (lc-act-rebase-push))))))))

    ; gates is the drift-gates door's answer: 1 when every gate is green
    ; (dg-green?), 0 when any refused. A red gate lands nothing: the acts
    ; that land — push, rebase-push, commit-land — become gate-refused;
    ; clear, resolve, wait and hold pass through untouched.
    (defn lc-lands? (act)
        (if (or (eq act (lc-act-push))
                (or (eq act (lc-act-rebase-push)) (eq act (lc-act-commit-land)))) 1 0))
    (defn lc-land (act gates)
        (if (and (eq gates 0) (eq (lc-lands? act) 1)) (lc-act-gate-refused) act))

    (defn lc-seat () (lc-seat-sibling))
    (defn lc-force? () 0)
    (defn lc-due? (elapsed)
        (if (ge elapsed (lc-interval-minutes)) 1 0))

    (defn lc-voice-speak () 0)
    (defn lc-voice-quiet () 1)

    ; same-picture = 1 when SHA and shape match the last breath.
    ; Repeating a clear picture stays quiet. A first clear, or any land, speaks.
    (defn lc-voice (act same-picture)
        (if (and (eq act (lc-act-clear)) (eq same-picture 1))
            (lc-voice-quiet)
            (lc-voice-speak)))

    (defn lc-push-lane (net)
        (fcl-step-lane (fcl-step-push) net))

    ; ---- readings: the three lenses beside the gates. A reading never refuses.
    ; The alignment plan (receipts/2026-09-04-north-star-alignment-plan.md)
    ; keeps itself honest with three numbers the body reads about itself on
    ; every landing: authoring altitude, carrier mass, belief stamps. Each
    ; lens is a door that prints its report and then its field code as the
    ; last line. The breath runs the door, takes the last non-blank line as
    ; the reading, and lays it beside the previous breath's reading, kept at
    ; hearth-readings as name=value lines; then it says, per lens, moved /
    ; steady / first-reading / unobserved. Only a gate refuses: the landing
    ; act (lc-land) never reads these rows. The door (land-cadence-live.fk)
    ; runs the lenses through host fkwu, the carrier; this recipe reads their
    ; words. Authored in .fk because this cell has no .bml authority — the
    ; altitude gap is named, not hidden.
    (defn lr-lens-row (name command) (list name command))
    (defn lr-name (row) (nth row 0))
    (defn lr-command (row) (nth row 1))
    (defn lr-lenses () (list
        (lr-lens-row "altitude" "./fkwu observe/authoring-altitude-run.fk")
        (lr-lens-row "carrier"  "./fkwu observe/carrier-mass.bml")
        (lr-lens-row "beliefs"  "./fkwu observe/belief-stamps.bml")))

    (defn lr-word-unobserved () "unobserved")
    (defn lr-word-first      () "first-reading")
    (defn lr-word-steady     () "steady")
    (defn lr-word-moved      () "moved")

    ; the last non-blank line: trailing newlines shed, then the text after the last newline
    (defn lr-nl () (byte_to_str 10))
    (defn lr-nl? (s i) (eq (ord (char_at s i)) 10))
    (defn lr-end (s i) (if (lt i 0) -1 (if (lr-nl? s i) (lr-end s (sub i 1)) i)))
    (defn lr-start (s i) (if (lt i 0) 0 (if (lr-nl? s i) (add i 1) (lr-start s (sub i 1)))))
    (defn lr-last-line-to (s end) (if (lt end 0) "" (substring s (lr-start s end) (add end 1))))
    (defn lr-last-line (s) (lr-last-line-to s (lr-end s (sub (str_len s) 1))))

    ; a reading is a number. A field code of 0 is each lens's own word for
    ; "no reading" (carrier-mass: "0 is an absence, not a mass"; belief-stamps
    ; answers 0 when the epoch cannot be read), so 0 reads as unobserved too.
    (defn lr-digit? (c) (and (ge (ord c) 48) (le (ord c) 57)))
    (defn lr-digits-from (s i) (if (ge i (str_len s)) 1 (if (lr-digit? (char_at s i)) (lr-digits-from s (add i 1)) 0)))
    (defn lr-digits? (s) (if (eq (str_len s) 0) 0 (lr-digits-from s 0)))
    (defn lr-value-of-line (l) (if (eq (lr-digits? l) 0) (lr-word-unobserved) (if (str_eq l "0") (lr-word-unobserved) l)))
    (defn lr-value (out) (if (nothing? out) (lr-word-unobserved) (lr-value-of-line (lr-last-line out))))
    (defn lr-observed? (value) (if (str_eq value (lr-word-unobserved)) 0 1))

    ; the memory: name=value lines. "" when the name has no line, or when the
    ; memory was never written (read_file answers nothing for an absent file).
    (defn lr-key (name) (str_concat (lr-nl) (str_concat name "=")))
    (defn lr-cut (hay from nl) (substring hay from (if (lt nl 0) (str_len hay) nl)))
    (defn lr-prev-at (hay at) (if (lt at 0) "" (lr-cut hay at (str_find hay (lr-nl) at))))
    (defn lr-after (at klen) (if (lt at 0) -1 (add at klen)))
    (defn lr-prev-in (hay name) (lr-prev-at hay (lr-after (str_find hay (lr-key name) 0) (str_len (lr-key name)))))
    (defn lr-prev (text name) (if (nothing? text) "" (lr-prev-in (str_concat (lr-nl) text) name)))

    ; the verdict, and a row: name, value, previous value, verdict
    (defn lr-verdict (value prev)
        (if (eq (lr-observed? value) 0) (lr-word-unobserved)
            (if (eq (str_len prev) 0) (lr-word-first)
                (if (str_eq value prev) (lr-word-steady) (lr-word-moved)))))
    (defn lr-row-of (name value prev) (list name value prev (lr-verdict value prev)))
    (defn lr-row (name out prev-text) (lr-row-of name (lr-value out) (lr-prev prev-text name)))
    (defn lr-row-name (r) (nth r 0))
    (defn lr-row-value (r) (nth r 1))
    (defn lr-row-prev (r) (nth r 2))
    (defn lr-row-verdict (r) (nth r 3))

    ; the printed line: "reading carrier=16190043414133 moved from 16190043414130";
    ; an unobserved lens says so once and names what the memory keeps
    (defn lr-unobserved? (r) (str_eq (lr-row-verdict r) (lr-word-unobserved)))
    (defn lr-keeps (r) (if (eq (str_len (lr-row-prev r)) 0) "" (str_concat " (memory keeps " (str_concat (lr-row-prev r) ")"))))
    (defn lr-tail (r) (if (str_eq (lr-row-verdict r) (lr-word-moved)) (str_concat " from " (lr-row-prev r)) (if (lr-unobserved? r) (lr-keeps r) "")))
    (defn lr-said (r) (if (lr-unobserved? r) (lr-word-unobserved) (str_concat (lr-row-value r) (str_concat " " (lr-row-verdict r)))))
    (defn lr-line (r) (str_concat "reading " (str_concat (lr-row-name r) (str_concat "=" (str_concat (lr-said r) (lr-tail r))))))

    ; what the memory keeps: this breath's value, or the last observed one when
    ; the lens was not read this breath — an absence never overwrites a reading
    (defn lr-keep (r) (if (eq (lr-observed? (lr-row-value r)) 1) (lr-row-value r) (lr-row-prev r)))
    (defn lr-memory-line (r) (if (eq (str_len (lr-keep r)) 0) "" (str_concat (lr-row-name r) (str_concat "=" (str_concat (lr-keep r) (lr-nl))))))
    (defn lr-memory (rows) (if (eq (len rows) 0) "" (str_concat (lr-memory-line (head rows)) (lr-memory (tail rows)))))

    ; how many rows speak a word; the summary line
    (defn lr-count (rows word) (if (eq (len rows) 0) 0 (add (if (str_eq (lr-row-verdict (head rows)) word) 1 0) (lr-count (tail rows) word))))
    (defn lr-summary (rows) (str_concat "land-cadence readings moved=" (str_concat (int_to_str (lr-count rows (lr-word-moved))) (str_concat " steady=" (str_concat (int_to_str (lr-count rows (lr-word-steady))) (str_concat " first=" (str_concat (int_to_str (lr-count rows (lr-word-first))) (str_concat " unobserved=" (str_concat (int_to_str (lr-count rows (lr-word-unobserved))) " (a reading never refuses; only a gate does)")))))))))

    (defn lck (cond bit) (if cond bit 0))
    (defn lc-check ()
        (do
            ; a planted memory, as the previous breath would have left it
            (let mem "altitude=1140020001448\ncarrier=16190043414130\nbeliefs=487457005\n")
            ; four planted rows, one per word a reading can speak
            (let rows (list (lr-row "altitude" "pictures=114\n1140020001448\n" mem)
                            (lr-row "carrier" "field = 16190043414133\n16190043414133\n" mem)
                            (lr-row "beliefs" (nothing) mem)
                            (lr-row "seed" "16190\n" mem)))
            (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add (add
                (lck (eq (lc-interval-minutes) 30) 1)
                (lck (eq (lc-act (lc-even) (lc-clean) 0 1) (lc-act-clear)) 2))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 0 1) (lc-act-push)) 4))
                (lck (eq (lc-act (lc-behind) (lc-clean) 0 1) (lc-act-rebase-push)) 8))
                (lck (eq (lc-act (lc-diverge) (lc-clean) 0 1) (lc-act-rebase-push)) 16))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 0 0) (lc-act-wait-water)) 32))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 1 1) (lc-act-resolve)) 64))
                (lck (eq (lc-act (lc-ahead) (lc-unrelated) 0 1) (lc-act-hold)) 128))
                (lck (eq (lc-force?) 0) 256))
                (lck (eq (lc-seat) (lc-seat-sibling)) 512))
                (lck (and (eq (lc-due? 30) 1) (eq (lc-due? 29) 0)) 1024))
                (lck (and (str_eq (lc-push-lane 1) "local")
                          (str_eq (lc-push-lane 0) "nothing")) 2048))
                (lck (eq (lc-act (lc-even) (lc-related) 0 1) (lc-act-commit-land)) 4096))
                (lck (and (eq (lc-voice (lc-act-clear) 1) (lc-voice-quiet))
                      (and (eq (lc-voice (lc-act-clear) 0) (lc-voice-speak))
                           (eq (lc-voice (lc-act-push) 1) (lc-voice-speak)))) 8192))
                (lck (and (eq (lc-land (lc-act-push) 0) (lc-act-gate-refused))
                      (and (eq (lc-land (lc-act-rebase-push) 0) (lc-act-gate-refused))
                           (eq (lc-land (lc-act-commit-land) 0) (lc-act-gate-refused)))) 16384))
                (lck (and (eq (lc-land (lc-act-push) 1) (lc-act-push))
                      (and (eq (lc-land (lc-act-clear) 0) (lc-act-clear))
                           (eq (lc-land (lc-act-hold) 0) (lc-act-hold)))) 32768))
                ; a reading is the lens's trailing field code: the last non-blank line, blank tail shed
                (lck (and (str_eq (lr-value "pictures=114\ncells=1448\n1140020001448\n\n") "1140020001448")
                      (and (str_eq (lr-value "16190043414133") "16190043414133")
                           (str_eq (lr-last-line "a\nb\n") "b"))) 65536))
                ; moved and steady are read against the planted previous breath
                (lck (and (str_eq (lr-row-verdict (nth rows 1)) (lr-word-moved))
                      (and (str_eq (lr-row-prev (nth rows 1)) "16190043414130")
                      (and (str_eq (lr-row-verdict (nth rows 0)) (lr-word-steady))
                           (str_eq (lr-line (nth rows 1)) "reading carrier=16190043414133 moved from 16190043414130")))) 131072))
                ; no previous reading - no memory at all, or no line for this lens - is a first reading
                (lck (and (str_eq (lr-row-verdict (lr-row "carrier" "5\n" (nothing))) (lr-word-first))
                      (and (str_eq (lr-row-verdict (nth rows 3)) (lr-word-first))
                           (str_eq (lr-line (nth rows 3)) "reading seed=16190 first-reading"))) 262144))
                ; a lens that answers nothing, or no number, or its own 0, reads unobserved - and the memory keeps the last reading
                (lck (and (str_eq (lr-row-verdict (nth rows 2)) (lr-word-unobserved))
                      (and (str_eq (lr-line (nth rows 2)) "reading beliefs=unobserved (memory keeps 487457005)")
                      (and (str_eq (lr-keep (nth rows 2)) "487457005")
                      (and (str_eq (lr-value "") (lr-word-unobserved))
                      (and (str_eq (lr-value "carrier mass: host-exec answered nothing\n0\n") (lr-word-unobserved))
                           (str_eq (lr-value "fkwu: error: something\n") (lr-word-unobserved))))))) 524288))
                ; readings never gate: rows speaking every word sit beside the landing act and the act is the gate's alone
                (lck (and (and (eq (lr-count rows (lr-word-moved)) 1) (eq (lr-count rows (lr-word-steady)) 1))
                      (and (and (eq (lr-count rows (lr-word-first)) 1) (eq (lr-count rows (lr-word-unobserved)) 1))
                      (and (str_eq (lr-memory rows) "altitude=1140020001448\ncarrier=16190043414133\nbeliefs=487457005\nseed=16190\n")
                      (and (eq (lc-land (lc-act-push) 1) (lc-act-push))
                           (eq (lc-land (lc-act-push) 0) (lc-act-gate-refused)))))) 1048576))))

    0)
