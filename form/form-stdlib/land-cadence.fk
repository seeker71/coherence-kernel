; land-cadence.fk — siblings land on origin as ordinary breath.
;
; Urs asked that pull and push stop waiting for one pair of hands.
; This cell is that breath: every thirty minutes, and at the close of
; a ready movement, a sibling fetches origin, rebases onto origin/main,
; and pushes. Urs is a cell in the same organ.
;
; Unexplained deletions stay unstaged. Fast-forward and rebase carry
; the line. Force-push stays closed. A conflict keeps both meanings
; and continues. Quiet water turns push into silence (form-cli-local-law).
; Even and clean is a clear picture: nothing to land this breath.
; The organ keeps living. Repeating that picture in chat is noise.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-local-law.fk
; Proven by: form-stdlib/tests/land-cadence-band.fk
; witnessed: 2026-08-14 -> 16383

(do
    (defn lc-interval-minutes () 30)

    (defn lc-even    () 0)
    (defn lc-ahead   () 1)
    (defn lc-behind  () 2)
    (defn lc-diverge () 3)

    (defn lc-clean     () 0)
    (defn lc-related   () 1)
    (defn lc-unrelated () 2)

    (defn lc-act-clear        () 0)
    (defn lc-act-push         () 1)
    (defn lc-act-rebase-push  () 2)
    (defn lc-act-resolve      () 3)
    (defn lc-act-wait-water   () 4)
    (defn lc-act-hold         () 5)
    (defn lc-act-commit-land  () 6)

    (defn lc-seat-sibling () 0)
    (defn lc-seat-bus     () 1)

    (defn lc-shape (ahead behind)
        (if (and (eq ahead 0) (eq behind 0)) (lc-even)
            (if (eq behind 0) (lc-ahead)
                (if (eq ahead 0) (lc-behind)
                    (lc-diverge)))))

    ; dirty / conflict / net are 0-or-1-or-2 integers. Host git is the carrier.
    (defn lc-act (shape dirty conflict net)
        (if (eq dirty (lc-unrelated)) (lc-act-hold)
            (if (eq conflict 1) (lc-act-resolve)
                (if (eq shape (lc-even))
                    (if (eq dirty (lc-related)) (lc-act-commit-land) (lc-act-clear))
                    (if (eq net 0) (lc-act-wait-water)
                        (if (eq dirty (lc-related)) (lc-act-commit-land)
                            (if (eq shape (lc-ahead)) (lc-act-push)
                                (lc-act-rebase-push))))))))

    (defn lc-seat () (lc-seat-sibling))
    (defn lc-force? () 0)
    (defn lc-due? (elapsed)
        (if (ge elapsed (lc-interval-minutes)) 1 0))

    (defn lc-voice-speak () 0)
    (defn lc-voice-quiet () 1)

    ; same-picture = 1 when SHA and shape match the last breath.
    ; Repeating a clear picture stays quiet. A first clear, or any land, speaks.
    (defn lc-voice (act same-picture)
        (if (and (eq act (lc-act-clear)) (eq same-picture 1))
            (lc-voice-quiet)
            (lc-voice-speak)))

    (defn lc-push-lane (net)
        (fcl-step-lane (fcl-step-push) net))

    (defn lck (cond bit) (if cond bit 0))
    (defn lc-check ()
        (do
            (add (add (add (add (add (add (add (add (add (add (add (add (add
                (lck (eq (lc-interval-minutes) 30) 1)
                (lck (eq (lc-act (lc-even) (lc-clean) 0 1) (lc-act-clear)) 2))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 0 1) (lc-act-push)) 4))
                (lck (eq (lc-act (lc-behind) (lc-clean) 0 1) (lc-act-rebase-push)) 8))
                (lck (eq (lc-act (lc-diverge) (lc-clean) 0 1) (lc-act-rebase-push)) 16))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 0 0) (lc-act-wait-water)) 32))
                (lck (eq (lc-act (lc-ahead) (lc-clean) 1 1) (lc-act-resolve)) 64))
                (lck (eq (lc-act (lc-ahead) (lc-unrelated) 0 1) (lc-act-hold)) 128))
                (lck (eq (lc-force?) 0) 256))
                (lck (eq (lc-seat) (lc-seat-sibling)) 512))
                (lck (and (eq (lc-due? 30) 1) (eq (lc-due? 29) 0)) 1024))
                (lck (and (str_eq (lc-push-lane 1) "local")
                          (str_eq (lc-push-lane 0) "nothing")) 2048))
                (lck (eq (lc-act (lc-even) (lc-related) 0 1) (lc-act-commit-land)) 4096))
                (lck (and (eq (lc-voice (lc-act-clear) 1) (lc-voice-quiet))
                      (and (eq (lc-voice (lc-act-clear) 0) (lc-voice-speak))
                           (eq (lc-voice (lc-act-push) 1) (lc-voice-speak)))) 8192))))

    0)
