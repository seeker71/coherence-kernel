        def fglat-arrow(id) = ftc-segment("->", fgd-neutral(96), "none", id, list("atlas", "channel"), "declared");
        def fglat-metric-stage-value(metric) = if and(eq(fgo-int-value(metric), 0), eq(fgd-semantic-zero-state?(fgo-lifecycle(metric)), 1)) then fglat-compact-zero(fgo-lifecycle(metric)) else fgd-format-count(fgo-int-value(metric));
        def fglat-pick-live-metric(primary, fallback) = if eq(fglat-metric-live?(primary), 1) then primary else fallback;
        def fglat-aggregate-pipeline-line(metrics, samples, observations) {
            let queueDepth = fgd-find-metric(metrics, "queue-depth");
            let queueFrames = fgd-find-metric(metrics, "queue-task-frames");
            let queue = if eq(fglat-metric-live?(queueDepth), 1) then queueDepth else queueFrames;
            let queueState = fgd-find-metric(metrics, "queue-state");
            let token = fglat-find-sample-kind(samples, "token-position");
            let ownerTokens = fglui-owner-token-fallback-samples(samples);
            let tokenChosen = if gt(len(token), 0) then token else if gt(len(ownerTokens), 0) then head(ownerTokens) else list();
            let expert = fglat-find-sample-kind(samples, "expert-pack");
            let tensor = fglui-find-observation(observations, "tensor.owner.allocated");
            let ownerMetal = fglui-find-observation(observations, "mapping.owner.mmap-buffer-handles");
