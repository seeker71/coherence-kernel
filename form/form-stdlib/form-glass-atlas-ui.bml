            cons(ftc-segment((Comparable) live == 1 ? "LIVE   " : "MIXED  ", fgd-title(), "none", "atlas.pipeline.flow", list("atlas", "channel", "token-flow"), (Comparable) live == 1 ? "physical-live" : "declared"), list(fglat-live-stage("request", "Q", chosen), fglat-arrow("channel.request-token"), fglat-live-stage("token", "T", chosen), fglat-arrow("channel.token-layer"), fglat-live-stage("layer", "L", chosen), fglat-arrow("channel.layer-tensor"), fglat-live-stage("tensor", "X", chosen), fglat-arrow("channel.tensor-expert"), fglat-live-stage("expert", "E", chosen), fglat-arrow("channel.expert-metal"), fglat-live-stage("metal", "M", chosen), fglat-arrow("channel.metal-framebuffer"), fglat-live-stage("framebuffer", "F", chosen), fglat-arrow("channel.framebuffer-glass"), fglat-live-stage("glass", "G", chosen)));
        }
        def fglat-live-pipeline-line(samples) = fglat-token-pipeline-line(samples);
        def fglat-pipeline-line(metrics, samples, observations) = fglat-pipeline-line-in(fgd-metric-index(metrics), samples, observations);
        def fglat-pipeline-line-in(index, samples, observations) = (Comparable) fglui-token-flow-present?(samples) == 1 ? fglat-token-pipeline-line(samples) : fglat-aggregate-pipeline-line-in(index, samples, observations);

        // these free-percent thresholds mirror form-resource-host-pressure's FRGHPWarningFreePercent/FRGHPCriticalFreePercent; they are held here so the render path never loads the governor chain, and fglat-level-number is the same scale the governor publishes
        def fglat-pressure-level(free) = free < 0 ? "gap" : free <= 5 ? "crit" : free <= 10 ? "warn" : "ok";
        def fglat-level-number(level) = (String) level == "crit" ? 2 : (String) level == "warn" ? 1 : (String) level == "ok" ? 0 : -1;
        // a field with no reading names who owes it: every "?" on this glass carries the door behind it.
        // host/process/owner are the sensor names observe/form-glass-sensors-live.fk gives under; dual-liveness
        // and owner-pid are the two steps of the owner-liveness publication; token, metal_live and governor
        // name the sample kind, the word door and the publisher a reading would come from.
        def fglat-door(door) = "?" ++ door;
        // the metric index is keyed by id alone and two domains publish "allocated-bytes"; a row read by domain says which device answered
        def fglat-domain-metric(rows, domain, id) = (Comparable) len(rows) == 0 ? list() : ((String) fgo-domain(head(rows)) == domain) && ((String) fgo-id(head(rows)) == id) ? head(rows) : fglat-domain-metric(tail(rows), domain, id);
        // four distinct states used to read "absent": the owner sensor has not given, no liveness publisher stands, the liveness row carries no pid, the owner pid is gone
        def fglat-owner-absent-text(present) = (Comparable) fglat-metric-live?(present) == 0 ? fglat-door("owner") : !((Comparable) fgo-int-value(present) == 0) ? fglat-door("owner-rss") : (String) fgo-lifecycle(present) == "released" ? "dead" : (String) fgo-source(present) == "owner-liveness handle" ? fglat-door("owner-pid") : fglat-door("dual-liveness");
        def fglat-owner-doing-text(metrics) = fglat-owner-doing-text-in(fgd-metric-index(metrics));
        def fglat-owner-doing-text-in(index) {
            let present = fgd-index-find(index, "model-owner-present");
            let rss = fgd-index-find(index, "model-owner-rss");
            let cpu = fgd-index-find(index, "model-owner-cpu");
            (Comparable) fglat-metric-current?(rss) == 1 ? fgd-cat(list("owner=", fgd-format-bytes(fgo-int-value(rss)), " cpu=", fglat-cpu-text(cpu))) : "owner=" ++ fglat-owner-absent-text(present);
        }
        // the owner's device bytes when an owner stands; otherwise this Glass process's own Metal ledger, scoped by name so the two are never confused
        def fglat-owner-gpu-text(metal, metrics) {
            let self = fglat-domain-metric(metrics, "metal", "allocated-bytes");
            (!((Comparable) len(metal) == 0)) && ((Comparable) fgtm-field-present?(fgtm-sample-bytes(metal)) == 1) ? fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(metal))) ++ "@owner" : (Comparable) fglat-metric-current?(self) == 1 ? fgd-format-bytes(fgo-int-value(self)) ++ "@glass" : (Comparable) len(self) == 0 ? fglat-door("machine") : fglat-door("metal_live");
        }
        // the measured level over the governor's own critical level, and where it was read: the published frame first, then the same vm_stat door the publisher itself samples
        def fglat-gov-level-text(level, critical, source) = fgd-cat(list(int_to_str(level), "/", int_to_str(critical), source));
        def fglat-governor-text(pressure, level) {
            let local = fglat-level-number(level);
            (!((Comparable) len(pressure) == 0)) && (((Comparable) fgtm-field-present?(fgtm-sample-bytes(pressure)) == 1) && ((Comparable) fgtm-field-present?(fgtm-sample-capacity(pressure)) == 1)) ? fglat-gov-level-text(fgtm-field-value(fgtm-sample-bytes(pressure)), fgtm-field-value(fgtm-sample-capacity(pressure)), "@governor") : local >= 0 ? int_to_str(local) ++ "@vm_stat" : fglat-door("governor");
        }
        def fglat-disk-rate-text(disk, tps) = (Comparable) fglat-metric-current?(disk) == 1 ? ((String) fgo-unit(disk) == "centi-MB/s" ? fgd-cat(list(int_to_str(fgo-int-value(disk) / 100), ".", (fgo-int-value(disk) % 100) < 10 ? "0" : "", int_to_str(fgo-int-value(disk) % 100), "MB/s")) : (String) fgo-unit(disk) == "MB/s" ? int_to_str(fgo-int-value(disk)) ++ "MB/s" : fglat-door("host")) : (Comparable) fglat-metric-current?(tps) == 1 ? int_to_str(fgo-int-value(tps)) ++ "tps" : fglat-door("host");
        def fglat-doing-line(metrics, samples, epoch, width) = fglat-doing-line-in(fgd-metric-index(fglat-current-metrics(metrics)), metrics, samples, epoch, width);
        def fglat-doing-line-in(index, metrics, samples, epoch, width) {
            let cpus = fglat-process-suffix-metrics(fglat-current-metrics(metrics), "-cpu");
            let rsses = fglat-process-suffix-metrics(fglat-current-metrics(metrics), "-rss");
            let maxCpu = fglat-metric-max(cpus, 0);
            let sumRss = fglat-metric-sum(rsses, 0);
            let pageins = fgd-index-find(index, "pageins");
            let pinDelta = fgd-index-find(index, "pageins-delta");
            let disk = fgd-index-find(index, "disk-mbps");
            let tps = fgd-index-find(index, "disk-tps");
            let load = fgd-index-find(index, "load-1");
            let metal = fglat-find-sample-id(samples, "memory.owner.metal-current-allocated");
            let mapped = fglat-find-sample-id(samples, "mapped.qwen3.8-flash-next");
            let pinText = (Comparable) fglat-metric-current?(pinDelta) == 1 ? ((Comparable) fgo-int-value(pinDelta) == 0 ? "0" : "+" ++ fgd-format-count(fgo-int-value(pinDelta))) : (Comparable) fglat-metric-current?(pageins) == 1 ? fgd-format-count(fgo-int-value(pageins)) : fglat-door("host");
            let loadText = (Comparable) fglat-metric-current?(load) == 1 ? fgd-cat(list(" load=", int_to_str(fgo-int-value(load) / 10), ".", int_to_str(fgo-int-value(load) % 10))) : "";
            fgd-segment-line(fgd-cat(list("DOING dsk=", fglat-disk-rate-text(disk, tps), " ", fglat-token-stall-text(samples, epoch), " n=", int_to_str(len(rsses)), " cpuT=", (Comparable) len(cpus) == 0 ? fglat-door("process") : fgd-format-count(maxCpu / 1000) ++ "ms", " rss=", (Comparable) len(rsses) == 0 ? fglat-door("process") : fgd-format-bytes(sumRss), " pin=", pinText, loadText, " ", fglat-owner-doing-text-in(index), " gpu=", fglat-owner-gpu-text(metal, metrics))), width, fgd-style-for-plane("cpu", 255, maxCpu > 200 ? 1 : 0), "atlas.doing", list("atlas", "process", "health", "flow"), "physical-live");
        }
        def fglat-pressure-line(metrics, samples, history, width) = fglat-pressure-line-in(fgd-metric-index(metrics), samples, history, width);
        def fglat-pressure-line-in(index, samples, history, width) {
            let freeM = fgd-index-find(index, "memory-free");
            let free = (Comparable) fglat-metric-current?(freeM) == 1 ? fgo-int-value(freeM) : -1;
            let rss = fgd-index-find(index, "model-owner-rss");
            let cpu = fgd-index-find(index, "model-owner-cpu");
            let compressor = fgd-index-find(index, "compressor-pages");
            let fileBacked = fgd-index-find(index, "file-backed-pages");
            let pressure = fglat-find-sample-kind(samples, "pressure");
            let level = fglat-pressure-level(free);
            let used = free < 0 ? fglat-door("host") : int_to_str(100 - free);
            let present = fgd-index-find(index, "model-owner-present");
            let rssText = (Comparable) fglat-metric-current?(rss) == 1 ? fgd-format-bytes(fgo-int-value(rss)) : fglat-owner-absent-text(present);
            let cpuText = (Comparable) fglat-metric-current?(cpu) == 1 ? fglat-cpu-text(cpu) : fglat-owner-absent-text(present);
            let gov = fglat-governor-text(pressure, level);
            fgd-segment-line(fgd-cat(list("PRESS free=", free < 0 ? fglat-door("host") : int_to_str(free) ++ "%", " used=", used, "% ", level, " file=", (Comparable) fglat-metric-current?(fileBacked) == 1 ? fgd-format-count(fgo-int-value(fileBacked)) : fglat-door("host"), " cmp=", (Comparable) fglat-metric-current?(compressor) == 1 ? fgd-format-count(fgo-int-value(compressor)) : fglat-door("host"), " rss=", rssText, " cpu=", cpuText, " gov=", gov, " g", fglat-phase-move(history, 10), "w", fglat-phase-move(history, 11), "i", fglat-phase-move(history, 12))), width, fgd-style-for-plane("unified", (String) level == "ok" ? 220 : 255, ((String) level == "warn") || ((String) level == "crit") ? 1 : 0), "atlas.pressure", list("atlas", "pressure", "memory", "health"), free < 0 ? "unavailable" : "physical-live");
        }
        // "n=4 next=<one door>" leaves three of the four unnamed and nothing
        // on the glass to reach them by: the right column renders present rows
        // only, so a seam the line counts is a seam a reader cannot read.  The
        // line names every distinct door instead, deduplicated -- two routes
        // waiting on the same owner are one door to build -- and says how many
        // it had to leave for the inspector when the width runs out.
        def fglat-seam-door-held?(doors, door) = (Comparable) len(doors) == 0 ? 0 : (String) head(doors) == door ? 1 : fglat-seam-door-held?(tail(doors), door);
        def fglat-seam-doors-go(rows, acc) = (Comparable) len(rows) == 0 ? reverse(acc) : (Comparable) fglat-seam-door-held?(acc, fgo-source(head(rows))) == 1 ? fglat-seam-doors-go(tail(rows), acc) : fglat-seam-doors-go(tail(rows), cons(fgo-source(head(rows)), acc));
        def fglat-seam-doors(rows) = fglat-seam-doors-go(rows, list());
        def fglat-seam-door-text(doors, room) = (Comparable) len(doors) == 0 ? "" : room <= 0 ? " +" ++ int_to_str(len(doors)) ++ " more" : " " ++ head(doors) ++ fglat-seam-door-text(tail(doors), room - 1);
        def fglat-seam-line(missing, width) = (Comparable) len(missing) == 0 ? fgd-segment-line("SEAM 0 live tiles occupy the rows; missing doors named here", width, fgd-ready(), "atlas.seam", list("atlas", "health", "evidence"), "physical-live") : fgd-segment-line(fgd-cat(list("SEAM n=", int_to_str(len(missing)), " doors:", fglat-seam-door-text(fglat-seam-doors(missing), fglat-seam-room(width)))), width, fgd-health(), "atlas.seam", list("atlas", "health", "evidence"), "unavailable");
        // one door name runs about thirty columns; the line keeps the count and
        // the "+N more" tail readable at every width the glass is opened at
        def fglat-seam-room(width) = fgd-max(1, (width - 24) / 30);
        def fglat-shown(count, capacity) = fgd-min(count, capacity);
        def fglat-rows-needed(count, cap, ceiling) = fgd-min(ceiling, (count + (cap - 1)) / cap);
        def fglat-rows-granted(needed, available) = fgd-min(needed, fgd-max(0, available));
        def fglat-omitted-count-for-rows(metrics, samples, observations, width, rowBudget) {
            let cap = fglat-capacity(width);
            let knownMetrics = fglat-moving-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let valuedSamples = fglat-valued-samples(samples);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, rowBudget - 12);
            let sampleFloor = 3;
            let metricBudget = fgd-max(0, tileRows - sampleFloor);
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), metricBudget);
            let afterKnownMetrics = tileRows - knownMetricRows;
            let missingMetricRows = 0;
            let afterMetrics = afterKnownMetrics;
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(valuedSamples), cap, tileRows), afterMetrics);
            let afterSamples = afterMetrics - sampleRows;
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = afterSamples - knownObservationRows;
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            fglat-omitted-of(len(knownMetrics), len(valuedSamples), len(knownObservations), len(seamObservations), cap, knownMetricRows, sampleRows, knownObservationRows, seamObservationRows);
        }
        // the count the lines-budget already knows: what each family holds less what its granted rows can show
        def fglat-omitted-of(knownMetrics, valuedSamples, knownObservations, seamObservations, cap, knownMetricRows, sampleRows, knownObservationRows, seamObservationRows) {
            let shownMetrics = fglat-shown(knownMetrics, cap * knownMetricRows);
            let shownSamples = fglat-shown(valuedSamples, cap * sampleRows);
            let shownObservations = fglat-shown(knownObservations, cap * knownObservationRows) + fglat-shown(seamObservations, cap * seamObservationRows);
            fgd-max(0, (knownMetrics - shownMetrics) + ((valuedSamples - shownSamples) + (knownObservations - shownObservations)));
        }
        def fglat-omitted-count(metrics, samples, observations, width) = fglat-omitted-count-for-rows(metrics, samples, observations, width, 999);

        def fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) = fglat-lines-budget-in(metrics, samples, observations, history, epoch, width, rowBudget, fgd-metric-index(metrics));
        def fglat-lines-budget-in(metrics, samples, observations, history, epoch, width, rowBudget, index) {
            let cap = fglat-capacity(width);
            let knownMetrics = fglat-moving-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let valuedSamples = fglat-valued-samples(samples);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, rowBudget - 12);
            let sampleFloor = 3;
            let metricBudget = fgd-max(0, tileRows - sampleFloor);
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), metricBudget);
            let afterKnownMetrics = tileRows - knownMetricRows;
            let missingMetricRows = 0;
            let afterMetrics = afterKnownMetrics;
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(valuedSamples), cap, tileRows), afterMetrics);
            let afterSamples = afterMetrics - sampleRows;
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = afterSamples - knownObservationRows;
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            let omitted = fglat-omitted-of(len(knownMetrics), len(valuedSamples), len(knownObservations), len(seamObservations), cap, knownMetricRows, sampleRows, knownObservationRows, seamObservationRows);
            let title = fgd-title-segment-line(fgd-cat(list("LIVE VALUE ATLAS 5c-KTVVV m", int_to_str(len(metrics)), " s", int_to_str(len(samples)), " o", int_to_str(len(observations)), " drop=", int_to_str(omitted), " cap=", int_to_str(cap), "/row")), width, "section.atlas");
            let metricLines = fglat-metric-lines(knownMetrics, width, knownMetricRows);
