        }
        def fglat-observation-segment(observation, epoch) {
            let provenance = fgov2-observation-provenance(observation);
            ftc-segment(fglat-observation-token(observation, epoch), fglat-state-style(fgd-style-for-plane(fgov2-observation-plane(observation), fglat-age-alpha-ms(fglat-observation-age-ms(observation, epoch)), 0), fglat-observation-state(observation)), "none", fglat-observation-projection-id(observation), list("atlas", "selector.observation." ++ fgov2-observation-id(observation), fgov2-observation-kind(observation), fgov2-observation-plane(observation), fgov2-observation-access(observation)), fgov2-provenance-evidence(provenance));
        }
        def fglat-observation-segments(rows, epoch, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-observation-segment(head(rows), epoch), fglat-observation-segments(tail(rows), epoch, count - 1));
        def fglat-observation-row(rows, epoch, width) = cons(fglat-prefix("o"), fglat-observation-segments(rows, epoch, fglat-capacity(width)));
        def fglat-observation-lines(rows, epoch, width, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-observation-row(rows, epoch, width), fglat-observation-lines(fgd-drop(rows, fglat-capacity(width)), epoch, width, count - 1));

        def fglat-ascii-glyph(level) = level <= 0 ? "." : (Comparable) level == 1 ? ":" : (Comparable) level == 2 ? "-" : (Comparable) level == 3 ? "=" : (Comparable) level == 4 ? "+" : (Comparable) level == 5 ? "*" : (Comparable) level == 6 ? "#" : "@";
        def fglat-ascii-glyphs(values, levels) = (Comparable) len(levels) == 0 ? "" : (head(values) < 0 ? "?" : fglat-ascii-glyph(head(levels))) ++ fglat-ascii-glyphs(tail(values), tail(levels));
        // The spark occupies its whole field, newest flush against the reading,
        // and a field with less history than columns is BLANK on the left --
        // never filled with a glyph, which would invent frames nobody observed.
        // Without this the spark was as wide as the history happened to be, so
        // the "=" and the reading marched right as the ring filled and every
        // column meant a different age from one minute to the next.
        def fglat-spark(values, width) {
            let visible = fglui-last-n(values, fgd-max(1, width));
            let glyphs = fglat-ascii-glyphs(visible, ftc-series-normalize(fglui-good-values(visible)));
            fgd-run(FGLAtlasBlank(), fgd-max(0, width - str_len(glyphs))) ++ glyphs;
        }
        def fglat-window-deltas(history, index) = (Comparable) len(history) == 0 ? list() : cons(-1, tail(fglui-deltas(history, index)));
        def fglat-flow-known?(history, latest, delta) = latest < 0 ? 0 : len(history) > 0 ? 1 : 0;
