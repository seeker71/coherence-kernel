section [form.bml] {
    class FormGlassAtlasUI {
        field FGLAtlasShardSchema = "form-glass-atlas-ui-v1";
        field FGLAtlasTokenWidth = 5;

        // One fixed-width ASCII tile is KTVVV: kind, truth, and a compact real
        // value. Plane is foreground hue, lifecycle is background, age is
        // alpha, and activity is bold. Exact values and provenance remain on
        // the selectable segment. No Unicode-width guess enters capacity.
        def fglat-plane-symbol(plane) = if str_eq(plane, "form") then "F" else if str_eq(plane, "cpu") then "C" else if str_eq(plane, "cpu-arena") then "C" else if str_eq(plane, "cpu-stack") then "C" else if str_eq(plane, "gpu") then "G" else if str_eq(plane, "metal") then "M" else if str_eq(plane, "unified-gpu") then "M" else if str_eq(plane, "mlx") then "X" else if str_eq(plane, "unified") then "U" else if str_eq(plane, "os-memory") then "U" else if str_eq(plane, "disk") then "D" else if str_eq(plane, "disk-cache") then "D" else if str_eq(plane, "mapped-file") then "D" else if str_eq(plane, "network") then "N" else if str_eq(plane, "membrane") then "|" else ".";
        // Age rungs are this atlas's DATA; the engine's tg-rung reads them.
        def fglat-age-rungs-ms() = list(250, 1000, 5000, 30000, 300000, 3600000, 86400000);
        def fglat-age-rungs-seconds() = list(1, 5, 30, 300, 3600, 86400);
        def fglat-age-symbol-ms(age) = if lt(age, 0) then "-" else int_to_str(tg-rung(age, fglat-age-rungs-ms()));
        def fglat-age-symbol-seconds(age) = if lt(age, 0) then "-" else int_to_str(add(1, tg-rung(age, fglat-age-rungs-seconds())));
        def fglat-age-alpha-ms(age) = if lt(age, 0) then 72 else nth(list(255, 220, 176, 112, 64), tg-rung(age, list(1000, 5000, 60000, 3600000)));
        def fglat-val(text) = fgd-pad-right(if le(str_len(text), 3) then text else substring(text, 0, 3), 3);
        def fglat-capacity(width) = fgd-max(1, div(fgd-max(1, sub(width, 2)), FGLAtlasTokenWidth()));
        def fglat-prefix(label) = ftc-segment(fgd-pad-right(label, 2), fgd-title(), "none", str_concat("atlas.", label), list("atlas", "control"), "declared");
        def fglat-kind-symbol(kind) = if str_eq(kind, "cell") then "c" else if str_eq(kind, "blueprint") then "b" else if str_eq(kind, "recipe") then "r" else if str_eq(kind, "tensor") then "t" else if str_eq(kind, "memory") then "m" else if str_eq(kind, "cache") then "C" else if str_eq(kind, "catalog") then "C" else if str_eq(kind, "storage") then "S" else if str_eq(kind, "model") then "M" else if str_eq(kind, "weights") then "W" else if str_eq(kind, "budget") then "B" else if str_eq(kind, "expert-pack") then "E" else if str_eq(kind, "expert-route") then "E" else if str_eq(kind, "layer") then "L" else if str_eq(kind, "kv-substate") then "K" else if str_eq(kind, "token-position") then "T" else if str_eq(kind, "queue") then "Q" else if str_eq(kind, "request") then "Q" else if str_eq(kind, "jit") then "J" else if str_eq(kind, "primitive") then "P" else if str_eq(kind, "kernel") then "k" else if str_eq(kind, "host") then "h" else if str_eq(kind, "metal") then "G" else if str_eq(kind, "mlx") then "X" else if str_eq(kind, "framebuffer") then "F" else if str_eq(kind, "glass-flow") then "g" else if str_eq(kind, "event") then "e" else if str_eq(kind, "process") then "p" else if str_eq(kind, "organ") then "O" else ".";
        def fglat-disposition-symbol(state) = if str_eq(state, "active") then ">" else if str_eq(state, "live") then ">" else if str_eq(state, "loading") then ">" else if str_eq(state, "prefilling") then ">" else if str_eq(state, "compiling") then ">" else if str_eq(state, "ready") then "=" else if str_eq(state, "resident") then "=" else if str_eq(state, "pinned") then "=" else if str_eq(state, "mapped") then "=" else if str_eq(state, "stored") then "=" else if str_eq(state, "crystallized") then "=" else if str_eq(state, "cooling") then "v" else if str_eq(state, "meltable") then "v" else if str_eq(state, "released") then "v" else if str_eq(state, "failed") then "!" else ".";
        def fglat-active-state?(state) = if str_eq(state, "active") then 1 else if str_eq(state, "live") then 1 else if str_eq(state, "loading") then 1 else if str_eq(state, "prefilling") then 1 else if str_eq(state, "compiling") then 1 else 0;
        def fglat-ready-state?(state) = if str_eq(state, "ready") then 1 else if str_eq(state, "resident") then 1 else if str_eq(state, "pinned") then 1 else 0;
        def fglat-stored-state?(state) = if str_eq(state, "mapped") then 1 else if str_eq(state, "stored") then 1 else if str_eq(state, "crystallized") then 1 else 0;
        def fglat-cooling-state?(state) = if str_eq(state, "cooling") then 1 else if str_eq(state, "meltable") then 1 else if str_eq(state, "released") then 1 else 0;
        def fglat-state-back-red(state) = if eq(fglat-active-state?(state), 1) then 8 else if eq(fglat-ready-state?(state), 1) then 8 else if eq(fglat-stored-state?(state), 1) then 38 else if eq(fglat-cooling-state?(state), 1) then 20 else if str_eq(state, "failed") then 48 else -1;
        def fglat-state-back-green(state) = if eq(fglat-active-state?(state), 1) then 40 else if eq(fglat-ready-state?(state), 1) then 24 else if eq(fglat-stored-state?(state), 1) then 26 else if eq(fglat-cooling-state?(state), 1) then 20 else if str_eq(state, "failed") then 8 else -1;
        def fglat-state-back-blue(state) = if eq(fglat-active-state?(state), 1) then 24 else if eq(fglat-ready-state?(state), 1) then 40 else if eq(fglat-stored-state?(state), 1) then 8 else if eq(fglat-cooling-state?(state), 1) then 20 else if str_eq(state, "failed") then 8 else -1;
        def fglat-state-style(base, state) = ftc-style(ftc-style-concept(base), ftc-style-red(base), ftc-style-green(base), ftc-style-blue(base), fglat-state-back-red(state), fglat-state-back-green(state), fglat-state-back-blue(state), ftc-style-alpha(base), fglat-active-state?(state), ftc-style-symbol(base));
        def fglat-evidence-alpha(evidence) = if str_eq(evidence, "physical-live") then 220 else if str_eq(evidence, "derived-window") then 176 else if str_eq(evidence, "catalog") then 144 else if str_eq(evidence, "declared") then 112 else 64;

        def fglat-missing-metrics(rows) = if eq(len(rows), 0) then list() else if eq(fgo-present?(head(rows)), 0) then cons(head(rows), fglat-missing-metrics(tail(rows))) else fglat-missing-metrics(tail(rows));
        def fglat-token-value(text) = fgd-pad-right(fgd-fit(text, 3), 3);
        def fglat-token-value-bytes(bytes) = fgdb-pad-right(fgdb-fit(bytes, 3), 3);
        def fglat-metric-value(metric) = if eq(fgo-present?(metric), 0) then "---" else if str_eq(fgo-value-kind(metric), "text") then fglat-token-value(fgo-text-value(metric)) else if str_eq(fgo-unit(metric), "bytes") then fglat-token-value(fgd-format-bytes(fgo-int-value(metric))) else fglat-token-value(fgd-format-count(fgo-int-value(metric)));
        def fglat-metric-token(metric) = fgd-cat(list(fglat-kind-symbol(fgo-domain(metric)), fgd-truth-symbol(fgo-evidence(metric)), fglat-metric-value(metric)));
        def fglat-metric-value-bytes(metric) = if eq(fgo-present?(metric), 0) then fgdb-text("---") else if str_eq(fgo-value-kind(metric), "text") then fglat-token-value-bytes(fgdb-text(fgo-text-value(metric))) else if str_eq(fgo-unit(metric), "bytes") then fglat-token-value-bytes(fgdb-format-bytes(fgo-int-value(metric))) else fglat-token-value-bytes(fgdb-format-count(fgo-int-value(metric)));
        def fglat-metric-token-bytes(metric) = fgdb-cat(list(fgdb-text(fglat-kind-symbol(fgo-domain(metric))), fgdb-text(fgd-truth-symbol(fgo-evidence(metric))), fglat-metric-value-bytes(metric)));
        def fglat-metric-segment(metric) = ftc-segment(ftc-byte-text(fglat-metric-token-bytes(metric)), fglat-state-style(ftc-style-with-alpha(fgd-style-for-metric(metric), fglat-age-alpha-ms(fgo-age(metric))), fgo-lifecycle(metric)), "none", if eq(fgo-nodeid-bound?(metric), 1) then fgo-nodeid-value(metric) else str_concat("metric.", fgo-id(metric)), list("atlas", str_concat("selector.metric.", fgo-id(metric)), fgo-channel(metric), fgo-domain(metric)), fgo-evidence(metric));
        def fglat-metric-segments(rows, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-metric-segment(head(rows)), fglat-metric-segments(tail(rows), sub(count, 1)));
        def fglat-metric-row(rows, width) = cons(fglat-prefix("m"), fglat-metric-segments(rows, fglat-capacity(width)));
        def fglat-metric-lines(rows, width, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-metric-row(rows, width), fglat-metric-lines(fgd-drop(rows, fglat-capacity(width)), width, sub(count, 1)));

        // Counter-like owner samples carry their measured value in capacity;
        // handles are identity/access doors and must not hide that value.
        def fglat-sample-value(sample) = if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fglat-token-value(fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample)))) else if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fglat-token-value(fgd-format-count(fgtm-field-value(fgtm-sample-capacity(sample)))) else if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then fglat-token-value(fgd-cat(list("h", int_to_str(fgtm-field-value(fgtm-sample-handle(sample)))))) else "---";
        def fglat-sample-token(sample, epoch) = fgd-cat(list(fglat-kind-symbol(fgtm-sample-kind(sample)), fgd-truth-symbol(fgtm-sample-evidence(sample)), fglat-sample-value(sample)));
        def fglat-sample-value-bytes(sample) = if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fglat-token-value-bytes(fgdb-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample)))) else if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fglat-token-value-bytes(fgdb-format-count(fgtm-field-value(fgtm-sample-capacity(sample)))) else if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then fglat-token-value-bytes(fgdb-cat(list(fgdb-text("h"), fgdb-int(fgtm-field-value(fgtm-sample-handle(sample)))))) else fgdb-text("---");
        def fglat-sample-token-bytes(sample) = fgdb-cat(list(fgdb-text(fglat-kind-symbol(fgtm-sample-kind(sample))), fgdb-text(fgd-truth-symbol(fgtm-sample-evidence(sample))), fglat-sample-value-bytes(sample)));
        def fglat-sample-segment(sample, epoch) = ftc-segment(ftc-byte-text(fglat-sample-token-bytes(sample)), fglat-state-style(fgd-sample-style(sample, epoch), fgtm-sample-lifecycle(sample)), "none", fgd-sample-projection-id(sample), append(list("atlas", str_concat("selector.sample.", fgtm-sample-id(sample))), fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fglat-sample-segments(rows, epoch, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-sample-segment(head(rows), epoch), fglat-sample-segments(tail(rows), epoch, sub(count, 1)));
        def fglat-sample-row(rows, epoch, width) = cons(fglat-prefix("s"), fglat-sample-segments(rows, epoch, fglat-capacity(width)));
        def fglat-sample-lines(rows, epoch, width, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-sample-row(rows, epoch, width), fglat-sample-lines(fgd-drop(rows, fglat-capacity(width)), epoch, width, sub(count, 1)));

        def fglat-observation-prefix(truth) = if eq(fgov2-measured?(truth), 1) then "*" else if eq(fgov2-stale?(truth), 1) then "+" else if eq(fgov2-error?(truth), 1) then "!" else if eq(fgov2-absent?(truth), 1) then "-" else "?";
        def fglat-truth-text(truth, unit) = if str_eq(unit, "state") then fgov2-truth-value(truth) else if str_eq(unit, "bytes") then fgd-format-bytes(fgov2-truth-value(truth)) else fgd-format-count(fgov2-truth-value(truth));
        def fglat-observation-value(observation) {
            let truth = fgov2-observation-measurement(observation);
            if or(eq(fgov2-measured?(truth), 1), eq(fgov2-stale?(truth), 1)) then fglat-truth-text(truth, fgov2-observation-unit(observation)) else "--";
        }
        def fglat-observation-state(observation) {
            let truth = fgov2-observation-state(observation);
            if eq(fgov2-measured?(truth), 1) then fgov2-truth-value(truth) else fgov2-truth-kind(truth);
        }
        def fglat-observation-age-ms(observation, epoch) {
            let truth = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            if not(eq(fgov2-measured?(truth), 1)) then -1 else if ge(epoch, fgov2-truth-value(truth)) then sub(epoch, fgov2-truth-value(truth)) else 0;
        }
        def fglat-observation-projection-node(observation) {
            let provenance = fgov2-observation-provenance(observation);
            intern_node_at(bp(FGDValueProjectionEvent()), list(intern_trivial_string("observation"), intern_trivial_string(fgov2-observation-id(observation)), intern_trivial_string(fgov2-observation-kind(observation)), intern_trivial_string(fgov2-observation-subtype(observation)), intern_trivial_string(fgov2-observation-unit(observation)), intern_trivial_string(fgov2-observation-plane(observation)), intern_trivial_string(fgov2-observation-access(observation))), "form/form-stdlib/form-glass-atlas-ui.bml", 1, 1);
        }
        def fglat-observation-projection-id(observation) = fgo-node-id(fglat-observation-projection-node(observation));
        def fglat-observation-token(observation, epoch) {
            let measurement = fgov2-observation-measurement(observation);
            let state = fglat-observation-state(observation);
            fgd-cat(list(fglat-kind-symbol(fgov2-observation-kind(observation)), fglat-observation-prefix(measurement), fglat-token-value(fglat-observation-value(observation))));
        }
        def fglat-observation-value-bytes(observation) {
            let truth = fgov2-observation-measurement(observation);
            if not(or(eq(fgov2-measured?(truth), 1), eq(fgov2-stale?(truth), 1))) then fgdb-text("--") else if str_eq(fgov2-observation-unit(observation), "state") then fgdb-text(fgov2-truth-value(truth)) else if str_eq(fgov2-observation-unit(observation), "bytes") then fgdb-format-bytes(fgov2-truth-value(truth)) else fgdb-format-count(fgov2-truth-value(truth));
        }
        def fglat-observation-token-bytes(observation) = fgdb-cat(list(fgdb-text(fglat-kind-symbol(fgov2-observation-kind(observation))), fgdb-text(fglat-observation-prefix(fgov2-observation-measurement(observation))), fglat-token-value-bytes(fglat-observation-value-bytes(observation))));
        def fglat-observation-segment(observation, epoch) {
            let provenance = fgov2-observation-provenance(observation);
            let measurement = fgov2-observation-measurement(observation);
            ftc-segment(ftc-byte-text(fglat-observation-token-bytes(observation)), fglat-state-style(fgd-style-for-plane(fgov2-observation-plane(observation), fglat-age-alpha-ms(fglat-observation-age-ms(observation, epoch)), 0), fglat-observation-state(observation)), "none", fglat-observation-projection-id(observation), list("atlas", str_concat("selector.observation.", fgov2-observation-id(observation)), fgov2-observation-kind(observation), fgov2-observation-plane(observation), fgov2-observation-access(observation)), fgov2-provenance-evidence(provenance));
        }
        def fglat-observation-segments(rows, epoch, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-observation-segment(head(rows), epoch), fglat-observation-segments(tail(rows), epoch, sub(count, 1)));
        def fglat-observation-row(rows, epoch, width) = cons(fglat-prefix("o"), fglat-observation-segments(rows, epoch, fglat-capacity(width)));
        def fglat-observation-lines(rows, epoch, width, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(fglat-observation-row(rows, epoch, width), fglat-observation-lines(fgd-drop(rows, fglat-capacity(width)), epoch, width, sub(count, 1)));

        def fglat-ascii-glyph(level) = if le(level, 0) then "." else if eq(level, 1) then ":" else if eq(level, 2) then "-" else if eq(level, 3) then "=" else if eq(level, 4) then "+" else if eq(level, 5) then "*" else if eq(level, 6) then "#" else "@";
        def fglat-ascii-glyphs(values, levels) = if eq(len(levels), 0) then "" else str_concat(if lt(head(values), 0) then "?" else fglat-ascii-glyph(head(levels)), fglat-ascii-glyphs(tail(values), tail(levels)));
        def fglat-spark(values, width) {
            let visible = fglui-last-n(values, fgd-max(1, width));
            fglat-ascii-glyphs(visible, ftc-series-normalize(fglui-good-values(visible)));
        }
        def fglat-window-deltas(history, index) = if eq(len(history), 0) then list() else cons(-1, tail(fglui-deltas(history, index)));
        def fglat-flow-known?(history, latest, delta) = if lt(latest, 0) then 0 else if eq(delta, 1) then if lt(len(history), 2) then 0 else 1 else if gt(len(history), 0) then 1 else 0;
        // Atlas has only a few cells per lane, so its semantic-zero suffix is
        // deliberately compact: u=microseconds, d=dispatches, r=requests,
        // j=JIT calls, n=nodes, B=bytes, b=batches.  The selectable segment
        // carries the full glass.monitor scope.
        def fglat-zero-gauge(label, value) = if not(eq(value, 0)) then fglui-value(value) else if str_eq(label, "G") then "0u" else if str_eq(label, "C") then "0u" else if str_eq(label, "D") then "0d" else if str_eq(label, "Q") then "0r" else if str_eq(label, "J") then "0j" else if str_eq(label, "c") then "0n" else if str_eq(label, "R") then "0B" else if str_eq(label, "I") then "0b" else "0";
        def fglat-flow-half(label, history, index, delta, width, plane) {
            let values = if eq(delta, 1) then fglat-window-deltas(history, index) else fglui-values(history, index);
            let missing = fglui-missing(history, index);
            let latest = if eq(len(values), 0) then -1 else if eq(delta, 1) then nth(values, sub(len(values), 1)) else fglui-last(history, index);
            let known = fglat-flow-known?(history, latest, delta);
            let sparkWidth = fgd-max(4, sub(width, 8));
            ftc-segment(fgd-fit(fgd-cat(list(label, fglat-spark(values, sparkWidth), "=", if eq(known, 1) then fglat-zero-gauge(label, latest) else "?")), width), fgd-style-for-plane(plane, if eq(known, 1) then 176 else 72, 0), "none", str_concat("flow.glass-monitor.", label), list("atlas", "flow", plane, "scope.glass.monitor"), if eq(known, 1) then "derived-window" else "unavailable");
        }
        def fglat-flow-row(leftLabel, leftIndex, leftDelta, leftPlane, rightLabel, rightIndex, rightDelta, rightPlane, history, width) {
            let half = div(sub(width, 1), 2);
            list(fglat-flow-half(leftLabel, history, leftIndex, leftDelta, half, leftPlane), ftc-segment("|", fgd-neutral(96), "none", "atlas.flow.divider", list("atlas", "flow"), "declared"), fglat-flow-half(rightLabel, history, rightIndex, rightDelta, sub(width, add(half, 1)), rightPlane));
        }
        def fglat-flow-lines(history, width) = list(fglat-flow-row("G", 2, 1, "metal", "C", 3, 1, "cpu", history, width), fglat-flow-row("D", 4, 1, "form", "Q", 5, 0, "membrane", history, width), fglat-flow-row("J", 6, 1, "cpu", "c", 7, 0, "form", history, width), fglat-flow-row("R", 8, 0, "unified", "I", 9, 0, "metal", history, width));

        def fglat-string-delta(history) {
            let values = fglat-window-deltas(history, 18);
            if lt(len(history), 2) then -1 else nth(values, sub(len(values), 1));
        }
        def fglat-string-rate(history) {
            let delta = fglat-string-delta(history);
            let elapsed = fglui-frame-delta(history);
            if or(lt(delta, 0), le(elapsed, 0)) then -1 else div(mul(delta, 1000), elapsed);
        }
        def fglat-string-line(metrics, history, width) {
            let total = fglui-last(history, 18);
            let delta = fglat-string-delta(history);
            let rate = fglat-string-rate(history);
            let growth = fgd-find-metric(metrics, "strings-growth");
            let growthText = if or(eq(len(growth), 0), eq(fgo-present?(growth), 0)) then "?" else fgd-cat(list(fgd-format-count(fgo-int-value(growth)), "/", fgd-format-count(fgo-capacity(growth))));
            let known = if and(ge(total, 0), and(ge(delta, 0), ge(rate, 0))) then 1 else 0;
            fgd-segment-line(fgd-cat(list("STR scope=glass n=", if ge(total, 0) then fgd-format-count(total) else "?", " d=", if ge(delta, 0) then fgd-format-count(delta) else "?", "/frame rate=", if ge(rate, 0) then fgd-format-count(rate) else "?", "/s growth=", growthText, " impact=unbounded-pool+selfmolt")), width, fgd-style-for-plane("cpu", if eq(known, 1) then 220 else 72, if gt(delta, 0) then 1 else 0), "flow.strings", list("atlas", "flow", "string", "memory"), if eq(known, 1) then "derived-window" else "unavailable");
        }

        // A full-screen resource-lane x observed-frame raster exposes the
        // retained ring directly. Every activity glyph is an independently
        // selectable lane+epoch cell whose retained evidence is never upgraded.
        def fglat-raster-cell-glyph(value, level) = if lt(value, 0) then "?" else fglat-ascii-glyph(level);
        def fglat-raster-cell-next(points, values, levels, laneId, index, delta, plane) {
            let value = head(values);
            let point = head(points);
            let epoch = fgd-flow-value(point, 1);
            let evidence = if lt(value, 0) then "unavailable" else if eq(delta, 1) then "derived-window" else fgd-flow-evidence(point, index);
            cons(ftc-segment(fglat-raster-cell-glyph(value, head(levels)), fgd-style-for-plane(plane, fglat-evidence-alpha(evidence), 0), "none", str_concat("raster.cell.", str_concat(laneId, str_concat(".t", int_to_str(epoch)))), list("raster", "history", plane, laneId, int_to_str(epoch)), evidence), fglat-raster-cell-segments(tail(points), tail(values), tail(levels), laneId, index, delta, plane));
        }
        def fglat-raster-cell-segments(points, values, levels, laneId, index, delta, plane) {
            if or(eq(len(points), 0), or(eq(len(values), 0), eq(len(levels), 0))) then list() else fglat-raster-cell-next(points, values, levels, laneId, index, delta, plane);
        }
        def fglat-raster-row(label, id, history, index, delta, width, plane) {
            let values = if eq(delta, 1) then fglat-window-deltas(history, index) else fglui-values(history, index);
            let sparkWidth = fgd-max(4, sub(width, 16));
            let visiblePoints = fglui-last-n(history, sparkWidth);
            let visibleValues = fglui-last-n(values, sparkWidth);
            let latest = if eq(len(visibleValues), 0) then -1 else nth(visibleValues, sub(len(visibleValues), 1));
            let latestPoint = if eq(len(visiblePoints), 0) then list() else nth(visiblePoints, sub(len(visiblePoints), 1));
            let latestEvidence = if lt(latest, 0) then "unavailable" else if eq(delta, 1) then "derived-window" else fgd-flow-evidence(latestPoint, index);
            let prefix = ftc-segment(fgd-cat(list(fgd-pad-right(label, 5), " ")), fgd-style-for-plane(plane, 176, 0), "none", str_concat("raster.lane.", id), list("raster", "history", plane, id), "declared");
            let cells = fglat-raster-cell-segments(visiblePoints, visibleValues, ftc-series-normalize(fglui-good-values(visibleValues)), id, index, delta, plane);
            let suffixWidth = fgd-max(0, sub(width, add(6, len(visibleValues))));
            let suffix = ftc-segment(fgd-fit(fgd-cat(list(" ", fglui-value(latest))), suffixWidth), fgd-style-for-plane(plane, fglat-evidence-alpha(latestEvidence), 0), "none", str_concat("raster.latest.", id), list("raster", "history", plane, id), latestEvidence);
            append(list(prefix), append(cells, list(suffix)));
        }
        def fglat-raster-lanes(history, width) = list(fglat-raster-row("GPUd", "gpu-busy-delta", history, 2, 1, width, "metal"), fglat-raster-row("JITus", "cpu-jit-microseconds-delta", history, 3, 1, width, "cpu"), fglat-raster-row("DISPd", "dispatch-delta", history, 4, 1, width, "form"), fglat-raster-row("QUEUE", "queue-depth", history, 5, 0, width, "membrane"), fglat-raster-row("JIT#", "jit-call-count-delta", history, 6, 1, width, "cpu"), fglat-raster-row("NODES", "glass-nodeid-count", history, 7, 0, width, "form"), fglat-raster-row("FREE", "memory-free", history, 8, 0, width, "unified"), fglat-raster-row("FLY", "metal-in-flight", history, 9, 0, width, "metal"), fglat-raster-row("GAS", "phase-gas", history, 10, 0, width, "form"), fglat-raster-row("WATER", "phase-water", history, 11, 0, width, "membrane"), fglat-raster-row("ICE", "phase-ice", history, 12, 0, width, "disk"), fglat-raster-row("TOKEN", "token-position", history, 13, 0, width, "form"), fglat-raster-row("TENS", "tensor-bytes", history, 14, 0, width, "unified"), fglat-raster-row("TAGS", "channel-tag-memberships", history, 15, 0, width, "membrane"), fglat-raster-row("FBACK", "framebuffer-accepted", history, 16, 0, width, "form"));
        def fglat-raster-visible-history(history, width) = fglui-last-n(history, fgd-max(4, sub(width, 16)));
        def fglat-raster-visible-points(history, width) = mul(15, len(fglat-raster-visible-history(history, width)));
        def fglat-raster-span-ms(history, width) {
            let visible = fglat-raster-visible-history(history, width);
            if lt(len(visible), 2) then 0 else fgd-max(0, sub(fgd-flow-value(nth(visible, sub(len(visible), 1)), 1), fgd-flow-value(head(visible), 1)));
        }
        def fglat-raster-lines(history, width, rowBudget) {
            let title = fgd-title-segment-line(fgd-cat(list("RESOURCE x FRAME RASTER lanes=15 retained=", int_to_str(len(history)), " cells=", int_to_str(fglat-raster-visible-points(history, width)), " span=", int_to_str(fglat-raster-span-ms(history, width)), "ms")), width, "section.raster");
            let legend = fgd-segment-line("frames -> newest | glyph relative | ? gap | each cell=id+epoch+truth | TICK=dt", width, fgd-neutral(176), "raster.legend", list("raster", "history", "control"), "declared");
            fgd-take(append(list(title), append(fglat-raster-lanes(history, width), list(legend))), rowBudget);
        }

        def fglat-phase-move(history, index) = if lt(len(history), 2) then "." else if or(lt(fgd-flow-value(nth(history, sub(len(history), 1)), index), 0), lt(fgd-flow-value(nth(history, sub(len(history), 2)), index), 0)) then "." else if gt(fgd-flow-value(nth(history, sub(len(history), 1)), index), fgd-flow-value(nth(history, sub(len(history), 2)), index)) then "^" else if lt(fgd-flow-value(nth(history, sub(len(history), 1)), index), fgd-flow-value(nth(history, sub(len(history), 2)), index)) then "v" else "=";
        def fglat-phase-segment(label, history, index, width, plane) {
            let values = fglui-values(history, index);
            let latest = fglui-last(history, index);
            let sparkWidth = fgd-max(2, sub(width, 7));
            let text = fgd-cat(list(label, fglat-spark(values, sparkWidth), " ", if lt(latest, 0) then "?" else fgd-format-count(latest), fglat-phase-move(history, index)));
            ftc-segment(fgd-pad-right(fgd-fit(text, width), width), fgd-style-for-plane(plane, if lt(latest, 0) then 72 else 220, 0), "none", str_concat("phase.", label), list("atlas", "phase", plane), if lt(latest, 0) then "unavailable" else "derived-window");
        }
        def fglat-phase-line(history, width) {
            let gap = 3;
            let part = div(sub(width, mul(gap, 2)), 3);
            let last = sub(width, add(mul(part, 2), mul(gap, 2)));
            list(fglat-phase-segment("g", history, 10, part, "form"), ftc-segment("<=>", fgd-neutral(128), "none", "phase.gas-water", list("atlas", "phase"), "declared"), fglat-phase-segment("w", history, 11, part, "membrane"), ftc-segment("<=>", fgd-neutral(128), "none", "phase.water-ice", list("atlas", "phase"), "declared"), fglat-phase-segment("i", history, 12, last, "disk-cache"));
        }

        def fglat-find-sample-kind(rows, kind) = if eq(len(rows), 0) then list() else if str_eq(fgtm-sample-kind(head(rows)), kind) then head(rows) else fglat-find-sample-kind(tail(rows), kind);
        def fglat-count-sample-kind(rows, kind) = if eq(len(rows), 0) then 0 else add(if str_eq(fgtm-sample-kind(head(rows)), kind) then 1 else 0, fglat-count-sample-kind(tail(rows), kind));
        def fglat-sample-capacity-total(rows, kind) = if eq(len(rows), 0) then 0 else add(if and(str_eq(fgtm-sample-kind(head(rows)), kind), eq(fgtm-field-present?(fgtm-sample-capacity(head(rows))), 1)) then fgtm-field-value(fgtm-sample-capacity(head(rows))) else 0, fglat-sample-capacity-total(tail(rows), kind));
        def fglat-stage-text(label, truth, value) = fgd-pad-right(fgd-fit(fgd-cat(list(label, truth, fglat-val(value))), 5), 5);
        def fglat-stage(label, truth, value, id, plane, evidence, channels) = ftc-segment(fglat-stage-text(label, truth, value), fgd-style-for-plane(plane, if str_eq(evidence, "unavailable") then 72 else 220, 0), "none", id, channels, evidence);
        def fglat-arrow(id) = ftc-segment("->", fgd-neutral(96), "none", id, list("atlas", "channel"), "declared");
        def fglat-aggregate-pipeline-line(metrics, samples, observations) {
            let queue = fgd-find-metric(metrics, "queue-depth");
            let queueState = fgd-find-metric(metrics, "queue-state");
            let token = fglat-find-sample-kind(samples, "token-position");
            let expert = fglat-find-sample-kind(samples, "expert-pack");
            let tensor = fglui-find-observation(observations, "tensor.owner.allocated");
            let ownerMetal = fglui-find-observation(observations, "mapping.owner.mmap-buffer-handles");
            let metal = if gt(len(ownerMetal), 0) then ownerMetal else fglui-find-observation(observations, "metal.pending");
            let accepted = fgd-find-metric(metrics, "accepted");
            let organ = fglat-find-sample-kind(samples, "organ");
            let queueKnown = gt(len(queue), 0);
            let queueOff = gt(len(queueState), 0);
            let tokenKnown = gt(len(token), 0);
            let expertKnown = gt(len(expert), 0);
            let tensorKnown = if eq(len(tensor), 0) then 0 else fglui-observation-available?(tensor);
            let metalKnown = if eq(len(metal), 0) then 0 else fglui-observation-available?(metal);
            cons(ftc-segment("SCHEMA ", fgd-neutral(96), "none", "atlas.pipeline.schema", list("atlas", "channel", "schema"), "declared"), list(fglat-stage("Q", if eq(queueKnown, 1) then fgd-truth-symbol(fgo-evidence(queue)) else if eq(queueOff, 1) then "#" else "?", if eq(queueKnown, 1) then fgd-format-count(fgo-int-value(queue)) else if eq(queueOff, 1) then "off" else "--", if eq(queueKnown, 1) then "metric.queue-depth" else "metric.queue-state", "membrane", if eq(queueKnown, 1) then fgo-evidence(queue) else if eq(queueOff, 1) then fgo-evidence(queueState) else "unavailable", list("atlas", "request", "queue")), fglat-arrow("channel.request-token"), fglat-stage("T", if eq(tokenKnown, 1) then fgd-truth-symbol(fgtm-sample-evidence(token)) else "?", if eq(tokenKnown, 1) then fgd-format-count(fglat-sample-capacity-total(samples, "token-position")) else "--", if eq(tokenKnown, 1) then fgtm-sample-id(token) else "seam.token-position", "form", if eq(tokenKnown, 1) then fgtm-sample-evidence(token) else "unavailable", list("atlas", "token", "model")), fglat-arrow("channel.token-layer"), fglat-stage("L", if eq(expertKnown, 1) then fgd-truth-symbol(fgtm-sample-evidence(expert)) else "?", if eq(expertKnown, 1) then fgd-format-count(fglat-count-sample-kind(samples, "expert-pack")) else "--", if eq(expertKnown, 1) then fgtm-sample-id(expert) else "seam.layer-activation", "metal", if eq(expertKnown, 1) then fgtm-sample-evidence(expert) else "unavailable", list("atlas", "layer", "expert")), fglat-arrow("channel.layer-tensor"), fglat-stage("X", if eq(tensorKnown, 1) then fglat-observation-prefix(fgov2-observation-measurement(tensor)) else "?", if eq(tensorKnown, 1) then fglat-observation-value(tensor) else "--", "tensor.owner.allocated", "unified", if eq(tensorKnown, 1) then fgov2-provenance-evidence(fgov2-observation-provenance(tensor)) else "unavailable", list("atlas", "tensor", "memory")), fglat-arrow("channel.tensor-metal"), fglat-stage("M", if eq(metalKnown, 1) then fglat-observation-prefix(fgov2-observation-measurement(metal)) else "?", if eq(metalKnown, 1) then fglat-observation-value(metal) else "--", "mapping.owner.mmap-buffer-handles", "metal", if eq(metalKnown, 1) then fgov2-provenance-evidence(fgov2-observation-provenance(metal)) else "unavailable", list("atlas", "metal", "gpu")), fglat-arrow("channel.metal-framebuffer"), fglat-stage("F", if gt(len(accepted), 0) then fgd-truth-symbol(fgo-evidence(accepted)) else "?", if gt(len(accepted), 0) then fgd-format-count(fgo-int-value(accepted)) else "--", "metric.accepted", "form", if gt(len(accepted), 0) then fgo-evidence(accepted) else "unavailable", list("atlas", "framebuffer", "core")), fglat-arrow("channel.framebuffer-glass"), fglat-stage("G", if gt(len(organ), 0) then fgd-truth-symbol(fgtm-sample-evidence(organ)) else "?", if gt(len(organ), 0) then fgd-format-count(fglat-count-sample-kind(samples, "organ")) else "--", if gt(len(organ), 0) then fgtm-sample-id(organ) else "seam.glass-organ", "form", if gt(len(organ), 0) then fgtm-sample-evidence(organ) else "unavailable", list("atlas", "glass", "organ"))));
        }

        def fglat-live-stage(stage, label, samples) {
            let sample = fglui-flow-stage-sample(samples, stage);
            if eq(len(sample), 0) then fglat-stage(label, "?", "--", str_concat("seam.", str_concat(stage, "-flow")), if str_eq(stage, "request") then "membrane" else if str_eq(stage, "token") then "form" else if str_eq(stage, "framebuffer") then "form" else if str_eq(stage, "glass") then "form" else if str_eq(stage, "tensor") then "unified" else "metal", "unavailable", list("atlas", "token-flow", str_concat("stage-", stage))) else fglat-stage(label, fgd-truth-symbol(fgtm-sample-evidence(sample)), fglui-token-flow-compact-value(sample), fgtm-sample-selection-id(sample), fgtm-sample-plane(sample), fgtm-sample-evidence(sample), append(list("atlas"), fgtm-sample-channels(sample)));
        }
        def fglat-token-pipeline-line(samples) {
            let chosen = fglui-token-flow-samples(samples);
            let live = fglui-token-flow-all-physical?(chosen);
            cons(ftc-segment(if eq(live, 1) then "LIVE   " else "MIXED  ", fgd-title(), "none", "atlas.pipeline.flow", list("atlas", "channel", "token-flow"), if eq(live, 1) then "physical-live" else "declared"), list(fglat-live-stage("request", "Q", chosen), fglat-arrow("channel.request-token"), fglat-live-stage("token", "T", chosen), fglat-arrow("channel.token-layer"), fglat-live-stage("layer", "L", chosen), fglat-arrow("channel.layer-tensor"), fglat-live-stage("tensor", "X", chosen), fglat-arrow("channel.tensor-expert"), fglat-live-stage("expert", "E", chosen), fglat-arrow("channel.expert-metal"), fglat-live-stage("metal", "M", chosen), fglat-arrow("channel.metal-framebuffer"), fglat-live-stage("framebuffer", "F", chosen), fglat-arrow("channel.framebuffer-glass"), fglat-live-stage("glass", "G", chosen)));
        }
        def fglat-live-pipeline-line(samples) = fglat-token-pipeline-line(samples);
        def fglat-pipeline-line(metrics, samples, observations) = if eq(fglui-token-flow-present?(samples), 1) then fglat-token-pipeline-line(samples) else fglat-aggregate-pipeline-line(metrics, samples, observations);

        def fglat-shown(count, capacity) = fgd-min(count, capacity);
        def fglat-rows-needed(count, cap, ceiling) = fgd-min(ceiling, div(add(count, sub(cap, 1)), cap));
        def fglat-rows-granted(needed, available) = fgd-min(needed, fgd-max(0, available));
        def fglat-omitted-count-for-rows(metrics, samples, observations, width, rowBudget) {
            let cap = fglat-capacity(width);
            let knownMetrics = fgd-present-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, sub(rowBudget, 9));
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), tileRows);
            let afterKnownMetrics = sub(tileRows, knownMetricRows);
            let missingMetricRows = fglat-rows-granted(fglat-rows-needed(len(missingMetrics), cap, tileRows), afterKnownMetrics);
            let afterMetrics = sub(afterKnownMetrics, missingMetricRows);
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(samples), cap, tileRows), afterMetrics);
            let afterSamples = sub(afterMetrics, sampleRows);
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = sub(afterSamples, knownObservationRows);
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            let shownMetrics = add(fglat-shown(len(knownMetrics), mul(cap, knownMetricRows)), fglat-shown(len(missingMetrics), mul(cap, missingMetricRows)));
            let shownSamples = fglat-shown(len(samples), mul(cap, sampleRows));
            let shownObservations = add(fglat-shown(len(knownObservations), mul(cap, knownObservationRows)), fglat-shown(len(seamObservations), mul(cap, seamObservationRows)));
            fgd-max(0, add(sub(len(metrics), shownMetrics), add(sub(len(samples), shownSamples), sub(len(observations), shownObservations))));
        }
        def fglat-omitted-count(metrics, samples, observations, width) = fglat-omitted-count-for-rows(metrics, samples, observations, width, 999);

        def fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) {
            let cap = fglat-capacity(width);
            let knownMetrics = fgd-present-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, sub(rowBudget, 9));
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), tileRows);
            let afterKnownMetrics = sub(tileRows, knownMetricRows);
            let missingMetricRows = fglat-rows-granted(fglat-rows-needed(len(missingMetrics), cap, tileRows), afterKnownMetrics);
            let afterMetrics = sub(afterKnownMetrics, missingMetricRows);
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(samples), cap, tileRows), afterMetrics);
            let afterSamples = sub(afterMetrics, sampleRows);
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = sub(afterSamples, knownObservationRows);
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            let omitted = fglat-omitted-count-for-rows(metrics, samples, observations, width, rowBudget);
            let title = fgd-title-segment-line(fgd-cat(list("LIVE VALUE ATLAS 5c-KTVVV m", int_to_str(len(metrics)), " s", int_to_str(len(samples)), " o", int_to_str(len(observations)), " drop=", int_to_str(omitted), " cap=", int_to_str(fglat-capacity(width)), "/row")), width, "section.atlas");
            let metricLines = append(fglat-metric-lines(knownMetrics, width, knownMetricRows), fglat-metric-lines(missingMetrics, width, missingMetricRows));
            let sampleLines = fglat-sample-lines(samples, epoch, width, sampleRows);
            let observationLines = append(fglat-observation-lines(knownObservations, epoch, width, knownObservationRows), fglat-observation-lines(seamObservations, epoch, width, seamObservationRows));
            let legend = fgd-segment-line("KTVVV kind truth value | select for exact value+field/event provenance", width, fgd-neutral(176), "atlas.legend", list("atlas", "evidence", "age", "state", "control"), "declared");
            let populated = append(list(title, fglat-phase-line(history, width), fglat-pipeline-line(metrics, samples, observations), fglat-string-line(metrics, history, width)), append(fglat-flow-lines(history, width), append(metricLines, append(sampleLines, observationLines))));
            fgd-take(append(populated, list(legend)), rowBudget);
        }
        def fglat-lines(metrics, samples, observations, history, epoch, width) = fglat-lines-budget(metrics, samples, observations, history, epoch, width, 999);
    }
    0;
}
