fglat-arrow("channel.tensor-metal"), fglat-stage("M", if eq(metalKnown, 1) then fglat-observation-prefix(fgov2-observation-measurement(metal)) else "?", if eq(metalKnown, 1) then fglat-observation-value(metal) else "--", "mapping.owner.mmap-buffer-handles", "metal", if eq(metalKnown, 1) then fgov2-provenance-evidence(fgov2-observation-provenance(metal)) else "unavailable", list("atlas", "metal", "gpu")), fglat-arrow("channel.metal-framebuffer"), fglat-stage("F", if eq(frameLive, 1) then fgd-truth-symbol(fgo-evidence(frame)) else "?", if eq(frameLive, 1) then fglat-metric-stage-value(frame) else "--", if eq(frameLive, 1) then str_concat("metric.", fgo-id(frame)) else "metric.accepted", "form", if eq(frameLive, 1) then fgo-evidence(frame) else "unavailable", list("atlas", "framebuffer", "core")), fglat-arrow("channel.framebuffer-glass"), fglat-stage("G", if gt(len(organ), 0) then fgd-truth-symbol(fgtm-sample-evidence(organ)) else "?", if gt(len(organ), 0) then fgd-format-count(fglat-count-sample-kind(samples, "organ")) else "--", if gt(len(organ), 0) then fgtm-sample-id(organ) else "seam.glass-organ", "form", if gt(len(organ), 0) then fgtm-sample-evidence(organ) else "unavailable", list("atlas", "glass", "organ"))));
        }

        def fglat-live-stage(stage, label, samples) {
            let sample = fglui-flow-stage-sample(samples, stage);
            if eq(len(sample), 0) then fglat-stage(label, "?", "--", str_concat("seam.", str_concat(stage, "-flow")), if str_eq(stage, "request") then "membrane" else if str_eq(stage, "token") then "form" else if str_eq(stage, "framebuffer") then "form" else if str_eq(stage, "glass") then "form" else if str_eq(stage, "tensor") then "unified" else "metal", "unavailable", list("atlas", "token-flow", str_concat("stage-", stage))) else fglat-stage(label, fgd-truth-symbol(fgtm-sample-evidence(sample)), fglui-token-flow-compact-value(sample), fgtm-sample-selection-id(sample), fgtm-sample-plane(sample), fgtm-sample-evidence(sample), append(list("atlas"), fgtm-sample-channels(sample)));
        }
        def fglat-token-pipeline-line(samples) {
            let chosen = fglui-token-flow-samples(samples);
            let live = fglui-token-flow-all-physical?(chosen);
            cons(ftc-segment(if eq(live, 1) then "LIVE   " else "MIXED  ", fgd-title(), "none", "atlas.pipeline.flow", list("atlas", "channel", "token-flow"), if eq(live, 1) then "physical-live" else "declared"), list(fglat-live-stage("request", "Q", chosen), fglat-arrow("channel.request-token"), fglat-live-stage("token", "T", chosen), fglat-arrow("channel.token-layer"), fglat-live-stage("layer", "L", chosen), fglat-arrow("channel.layer-tensor"), fglat-live-stage("tensor", "X", chosen), fglat-arrow("channel.tensor-expert"), fglat-live-stage("expert", "E", chosen), fglat-arrow("channel.expert-metal"), fglat-live-stage("metal", "M", chosen), fglat-arrow("channel.metal-framebuffer"), fglat-live-stage("framebuffer", "F", chosen), fglat-arrow("channel.framebuffer-glass"), fglat-live-stage("glass", "G", chosen)));
        }
        def fglat-live-pipeline-line(samples) = fglat-token-pipeline-line(samples);
        def fglat-pipeline-line(metrics, samples, observations) = if eq(fglui-token-flow-present?(samples), 1) then fglat-token-pipeline-line(samples) else fglat-aggregate-pipeline-line(metrics, samples, observations);

        def fglat-pressure-level(free) = if lt(free, 0) then "gap" else if le(free, 5) then "crit" else if le(free, 10) then "warn" else "ok";
        def fglat-owner-doing-text(metrics) {
            let present = fgd-find-metric(metrics, "model-owner-present");
            let rss = fgd-find-metric(metrics, "model-owner-rss");
            let cpu = fgd-find-metric(metrics, "model-owner-cpu");
            if eq(fglat-metric-live?(rss), 1) then fgd-cat(list("owner=", fgd-format-bytes(fgo-int-value(rss)), " cpu=", fgd-format-count(div(fgo-int-value(cpu), 10)), "%")) else if and(eq(fglat-metric-live?(present), 1), eq(fgo-int-value(present), 0)) then if str_eq(fgo-lifecycle(present), "released") then "owner=dead" else "owner=absent" else "owner=absent";
        }
        def fglat-doing-line(metrics, samples, epoch, width) {
            let cpus = fglat-process-suffix-metrics(metrics, "-cpu");
            let rsses = fglat-process-suffix-metrics(metrics, "-rss");
            let maxCpu = fglat-metric-max(cpus, 0);
            let sumRss = fglat-metric-sum(rsses, 0);
            let pageins = fgd-find-metric(metrics, "pageins");
            let pinDelta = fgd-find-metric(metrics, "pageins-delta");
            let disk = fgd-find-metric(metrics, "disk-mbps");
            let tps = fgd-find-metric(metrics, "disk-tps");
            let load = fgd-find-metric(metrics, "load-1");
            let metal = fglat-find-sample-id(samples, "memory.owner.metal-current-allocated");
            let mapped = fglat-find-sample-id(samples, "mapped.qwen3.8-flash-next");
            let pinText = if eq(fglat-metric-live?(pinDelta), 1) then if eq(fgo-int-value(pinDelta), 0) then "0" else str_concat("+", fgd-format-count(fgo-int-value(pinDelta))) else if eq(fglat-metric-live?(pageins), 1) then fgd-format-count(fgo-int-value(pageins)) else "?";
            let loadText = if eq(fglat-metric-live?(load), 1) then fgd-cat(list(" load=", int_to_str(div(fgo-int-value(load), 10)), ".", int_to_str(mod(fgo-int-value(load), 10)))) else "";
            fgd-segment-line(fgd-cat(list("DOING n=", int_to_str(len(rsses)), " cpu=", fgd-format-count(div(maxCpu, 10)), "% rss=", if eq(sumRss, 0) then "?" else fgd-format-bytes(sumRss), loadText, " ", fglat-owner-doing-text(metrics), " ", fglat-token-stall-text(samples, epoch), " pin=", pinText, " dsk=", if eq(fglat-metric-live?(disk), 1) then str_concat(int_to_str(fgo-int-value(disk)), "MB/s") else if eq(fglat-metric-live?(tps), 1) then str_concat(int_to_str(fgo-int-value(tps)), "tps") else "?", " ", fglat-sample-bytes-text(metal))), width, fgd-style-for-plane("cpu", 255, if gt(maxCpu, 200) then 1 else 0), "atlas.doing", list("atlas", "process", "health", "flow"), "physical-live");
        }
        def fglat-pressure-line(metrics, samples, history, width) {
            let freeM = fgd-find-metric(metrics, "memory-free");
            let free = if eq(fglat-metric-live?(freeM), 1) then fgo-int-value(freeM) else -1;
            let rss = fgd-find-metric(metrics, "model-owner-rss");
            let cpu = fgd-find-metric(metrics, "model-owner-cpu");
            let compressor = fgd-find-metric(metrics, "compressor-pages");
            let fileBacked = fgd-find-metric(metrics, "file-backed-pages");
            let pressure = fglat-find-sample-kind(samples, "pressure");
            let level = fglat-pressure-level(free);
            let used = if lt(free, 0) then "?" else int_to_str(sub(100, free));
            let rssText = if eq(fglat-metric-live?(rss), 1) then fgd-format-bytes(fgo-int-value(rss)) else "?";
            let cpuText = if eq(fglat-metric-live?(cpu), 1) then str_concat(fgd-format-count(div(fgo-int-value(cpu), 10)), "%") else "?";
            let gov = if eq(len(pressure), 0) then "?" else if eq(fgtm-field-present?(fgtm-sample-capacity(pressure)), 1) then fgd-format-count(fgtm-field-value(fgtm-sample-capacity(pressure))) else fgtm-sample-purpose(pressure);
            fgd-segment-line(fgd-cat(list("PRESS free=", if lt(free, 0) then "?" else str_concat(int_to_str(free), "%"), " used=", used, "% ", level, " file=", if eq(fglat-metric-live?(fileBacked), 1) then fgd-format-count(fgo-int-value(fileBacked)) else "?", " cmp=", if eq(fglat-metric-live?(compressor), 1) then fgd-format-count(fgo-int-value(compressor)) else "?", " rss=", rssText, " cpu=", cpuText, " gov=", gov, " g", fglat-phase-move(history, 10), "w", fglat-phase-move(history, 11), "i", fglat-phase-move(history, 12))), width, fgd-style-for-plane("unified", if str_eq(level, "ok") then 220 else 255, if or(str_eq(level, "warn"), str_eq(level, "crit")) then 1 else 0), "atlas.pressure", list("atlas", "pressure", "memory", "health"), if lt(free, 0) then "unavailable" else "physical-live");
        }
        def fglat-seam-line(missing, width) = if eq(len(missing), 0) then fgd-segment-line("SEAM 0 live tiles occupy the rows; missing doors named here", width, fgd-ready(), "atlas.seam", list("atlas", "health", "evidence"), "physical-live") else fgd-segment-line(fgd-cat(list("SEAM n=", int_to_str(len(missing)), " next=", fgo-source(head(missing)))), width, fgd-health(), "atlas.seam", list("atlas", "health", "evidence"), "unavailable");
        def fglat-shown(count, capacity) = fgd-min(count, capacity);
        def fglat-rows-needed(count, cap, ceiling) = fgd-min(ceiling, div(add(count, sub(cap, 1)), cap));
        def fglat-rows-granted(needed, available) = fgd-min(needed, fgd-max(0, available));
        def fglat-omitted-count-for-rows(metrics, samples, observations, width, rowBudget) {
            let cap = fglat-capacity(width);
            let knownMetrics = fglat-moving-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let valuedSamples = fglat-valued-samples(samples);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, sub(rowBudget, 12));
            let sampleFloor = 3;
            let metricBudget = fgd-max(0, sub(tileRows, sampleFloor));
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), metricBudget);
            let afterKnownMetrics = sub(tileRows, knownMetricRows);
            let missingMetricRows = 0;
            let afterMetrics = afterKnownMetrics;
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(valuedSamples), cap, tileRows), afterMetrics);
            let afterSamples = sub(afterMetrics, sampleRows);
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = sub(afterSamples, knownObservationRows);
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            let shownMetrics = fglat-shown(len(knownMetrics), mul(cap, knownMetricRows));
            let shownSamples = fglat-shown(len(valuedSamples), mul(cap, sampleRows));
            let shownObservations = add(fglat-shown(len(knownObservations), mul(cap, knownObservationRows)), fglat-shown(len(seamObservations), mul(cap, seamObservationRows)));
            fgd-max(0, add(sub(len(knownMetrics), shownMetrics), add(sub(len(valuedSamples), shownSamples), sub(len(knownObservations), shownObservations))));
        }
        def fglat-omitted-count(metrics, samples, observations, width) = fglat-omitted-count-for-rows(metrics, samples, observations, width, 999);

        def fglat-lines-budget(metrics, samples, observations, history, epoch, width, rowBudget) {
            let cap = fglat-capacity(width);
            let knownMetrics = fglat-moving-metrics(metrics);
            let missingMetrics = fglat-missing-metrics(metrics);
            let valuedSamples = fglat-valued-samples(samples);
            let knownObservations = fglui-available-observations(observations);
            let seamObservations = fglui-seam-observations(observations);
            let tileRows = fgd-max(0, sub(rowBudget, 12));
            let sampleFloor = 3;
            let metricBudget = fgd-max(0, sub(tileRows, sampleFloor));
            let knownMetricRows = fglat-rows-granted(fglat-rows-needed(len(knownMetrics), cap, tileRows), metricBudget);
            let afterKnownMetrics = sub(tileRows, knownMetricRows);
            let missingMetricRows = 0;
            let afterMetrics = afterKnownMetrics;
            let sampleRows = fglat-rows-granted(fglat-rows-needed(len(valuedSamples), cap, tileRows), afterMetrics);
            let afterSamples = sub(afterMetrics, sampleRows);
            let knownObservationRows = fglat-rows-granted(fglat-rows-needed(len(knownObservations), cap, tileRows), afterSamples);
            let afterKnownObservations = sub(afterSamples, knownObservationRows);
            let seamObservationRows = fglat-rows-granted(fglat-rows-needed(len(seamObservations), cap, tileRows), afterKnownObservations);
            let omitted = fglat-omitted-count-for-rows(metrics, samples, observations, width, rowBudget);
            let title = fgd-title-segment-line(fgd-cat(list("LIVE VALUE ATLAS 5c-KTVVV m", int_to_str(len(metrics)), " s", int_to_str(len(samples)), " o", int_to_str(len(observations)), " drop=", int_to_str(omitted), " cap=", int_to_str(fglat-capacity(width)), "/row")), width, "section.atlas");
            let metricLines = fglat-metric-lines(knownMetrics, width, knownMetricRows);
            let sampleLines = fglat-sample-lines(valuedSamples, epoch, width, sampleRows);
            let observationLines = append(fglat-observation-lines(knownObservations, epoch, width, knownObservationRows), fglat-observation-lines(seamObservations, epoch, width, seamObservationRows));
            let legend = fgd-segment-line(fgd-cat(list("now *", int_to_str(add(fglat-ev-count-metrics(metrics, "physical-live"), fglat-ev-count-samples(samples, "physical-live"))), " +", int_to_str(add(fglat-ev-count-metrics(metrics, "derived-window"), fglat-ev-count-samples(samples, "derived-window"))), " #", int_to_str(add(fglat-ev-count-metrics(metrics, "catalog"), fglat-ev-count-samples(samples, "catalog"))), " ?", int_to_str(len(missingMetrics)), " valued-s=", int_to_str(len(valuedSamples)))), width, fgd-neutral(176), "atlas.legend", list("atlas", "evidence", "age", "state", "control"), "physical-live");
            let populated = append(list(title, fglat-phase-line(history, width), fglat-pipeline-line(metrics, samples, observations), fglat-string-line(metrics, history, width), fglat-doing-line(metrics, samples, epoch, width), fglat-pressure-line(metrics, samples, history, width), fglat-seam-line(missingMetrics, width)), append(fglat-flow-lines(history, width), append(metricLines, append(sampleLines, observationLines))));
            fgd-take(append(populated, list(legend)), rowBudget);
        }
        def fglat-lines(metrics, samples, observations, history, epoch, width) = fglat-lines-budget(metrics, samples, observations, history, epoch, width, 999);
    }
    0;
}
