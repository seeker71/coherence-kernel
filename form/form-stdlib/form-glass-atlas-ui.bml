section [form.bml] {
    class FormGlassAtlasUI {
        field FGLAtlasShardSchema = "form-glass-atlas-ui-v1";
        field FGLAtlasTokenWidth = 5;
        // The reading at the end of a flow half is a FIXED field, so the "=" and
        // the spark before it never move. Urs, 2026-09-10: the numbers "are not
        // fixed width aligned ... the data is bouncing when the number width is
        // changing". The spark was sized from what the reading left, so one
        // character more of number shifted every glyph in the sparkline by a
        // column -- and a sparkline whose columns move is not a sparkline: a
        // given column has to mean a given age, or two frames cannot be
        // compared, which is the only thing the shape is for.
        // Eleven is measured, not guessed: the widest readings this glass
        // renders are 0r(empty) and 49M/2613G at nine, and the semantic zeros
        // and the ? sit well inside that.
        field FGLAtlasReadWidth = 11;
        // A pad taken by SLICING a constant, not by concatenating a space at a
        // time: fgd-repeat costs one allocation per column, and the spark pads
        // eight halves every frame.
        field FGLAtlasBlank = "                                                                    ";

        // One fixed-width ASCII tile is KTVVV: kind, truth, and a compact real
        // value. Plane is foreground hue, lifecycle is background, age is
        // alpha, and activity is bold. Exact values and provenance remain on
        // the selectable segment. No Unicode-width guess enters capacity.
        def fglat-plane-symbol(plane) = (String) plane == "form" ? "F" : (String) plane == "cpu" ? "C" : (String) plane == "cpu-arena" ? "C" : (String) plane == "cpu-stack" ? "C" : (String) plane == "gpu" ? "G" : (String) plane == "metal" ? "M" : (String) plane == "unified-gpu" ? "M" : (String) plane == "unified" ? "U" : (String) plane == "os-memory" ? "U" : (String) plane == "disk" ? "D" : (String) plane == "disk-cache" ? "D" : (String) plane == "mapped-file" ? "D" : (String) plane == "network" ? "N" : (String) plane == "membrane" ? "|" : ".";
        // Age rungs are this atlas's DATA; the engine's tg-rung reads them.
        def fglat-age-rungs-ms() = list(250, 1000, 5000, 30000, 300000, 3600000, 86400000);
        def fglat-age-rungs-seconds() = list(1, 5, 30, 300, 3600, 86400);
        def fglat-age-symbol-ms(age) = age < 0 ? "-" : int_to_str(tg-rung(age, fglat-age-rungs-ms()));
        def fglat-age-symbol-seconds(age) = age < 0 ? "-" : int_to_str(1 + tg-rung(age, fglat-age-rungs-seconds()));
        def fglat-age-alpha-ms(age) = age < 0 ? 72 : list(255, 220, 176, 112, 64)[tg-rung(age, list(1000, 5000, 60000, 3600000))];
        def fglat-val(text) = fgd-pad-right(str_len(text) <= 3 ? text : substring(text, 0, 3), 3);
        def fglat-capacity(width) = fgd-max(1, fgd-max(1, width - 2) / FGLAtlasTokenWidth());
        def fglat-prefix(label) = ftc-segment(fgd-pad-right(label, 2), fgd-title(), "none", "atlas." ++ label, list("atlas", "control"), "declared");
        // the kinds the live rows carry most (every kernel's page rows, the host, the frames) are read first
        def fglat-kind-symbol(kind) = (String) kind == "kernel" ? "k" : (String) kind == "host" ? "h" : (String) kind == "process" ? "p" : (String) kind == "framebuffer" ? "F" : (String) kind == "cell" ? "c" : (String) kind == "blueprint" ? "b" : (String) kind == "recipe" ? "r" : (String) kind == "tensor" ? "t" : (String) kind == "memory" ? "m" : (String) kind == "cache" ? "C" : (String) kind == "catalog" ? "C" : (String) kind == "storage" ? "S" : (String) kind == "model" ? "M" : (String) kind == "weights" ? "W" : (String) kind == "budget" ? "B" : (String) kind == "expert-pack" ? "E" : (String) kind == "expert-route" ? "E" : (String) kind == "layer" ? "L" : (String) kind == "kv-substate" ? "K" : (String) kind == "token-position" ? "T" : (String) kind == "queue" ? "Q" : (String) kind == "request" ? "Q" : (String) kind == "channel" ? "=" : (String) kind == "jit" ? "J" : (String) kind == "primitive" ? "P" : (String) kind == "metal" ? "G" : (String) kind == "glass-flow" ? "g" : (String) kind == "event" ? "e" : (String) kind == "organ" ? "O" : ".";
        def fglat-disposition-symbol(state) = (String) state == "active" ? ">" : (String) state == "live" ? ">" : (String) state == "loading" ? ">" : (String) state == "prefilling" ? ">" : (String) state == "compiling" ? ">" : (String) state == "ready" ? "=" : (String) state == "resident" ? "=" : (String) state == "pinned" ? "=" : (String) state == "mapped" ? "=" : (String) state == "stored" ? "=" : (String) state == "crystallized" ? "=" : (String) state == "cooling" ? "v" : (String) state == "meltable" ? "v" : (String) state == "released" ? "v" : (String) state == "failed" ? "!" : ".";
        def fglat-active-state?(state) = (String) state == "active" ? 1 : (String) state == "live" ? 1 : (String) state == "loading" ? 1 : (String) state == "prefilling" ? 1 : (String) state == "compiling" ? 1 : 0;
        def fglat-ready-state?(state) = (String) state == "ready" ? 1 : (String) state == "resident" ? 1 : (String) state == "pinned" ? 1 : 0;
        def fglat-stored-state?(state) = (String) state == "mapped" ? 1 : (String) state == "stored" ? 1 : (String) state == "crystallized" ? 1 : 0;
        def fglat-cooling-state?(state) = (String) state == "cooling" ? 1 : (String) state == "meltable" ? 1 : (String) state == "released" ? 1 : 0;
        // a state is classified once (active, ready, stored, cooling, failed, other) and the background and weight read off that class
        def fglat-state-class(state) = (Comparable) fglat-active-state?(state) == 1 ? 0 : (Comparable) fglat-ready-state?(state) == 1 ? 1 : (Comparable) fglat-stored-state?(state) == 1 ? 2 : (Comparable) fglat-cooling-state?(state) == 1 ? 3 : (String) state == "failed" ? 4 : 5;
        def fglat-state-back-red-of(class) = list(8, 8, 38, 20, 48, -1)[class];
        def fglat-state-back-green-of(class) = list(40, 24, 26, 20, 8, -1)[class];
        def fglat-state-back-blue-of(class) = list(24, 40, 8, 20, 8, -1)[class];
        def fglat-state-style-alpha(base, state, alpha) {
            let class = fglat-state-class(state);
            ftc-style(ftc-style-concept(base), ftc-style-red(base), ftc-style-green(base), ftc-style-blue(base), fglat-state-back-red-of(class), fglat-state-back-green-of(class), fglat-state-back-blue-of(class), alpha, (Comparable) class == 0 ? 1 : 0, ftc-style-symbol(base));
        }
        def fglat-state-style(base, state) = fglat-state-style-alpha(base, state, ftc-style-alpha(base));
        def fglat-evidence-alpha(evidence) = (String) evidence == "physical-live" ? 220 : (String) evidence == "derived-window" ? 176 : (String) evidence == "catalog" ? 144 : (String) evidence == "declared" ? 112 : 64;

        def fglat-missing-metrics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fgo-present?(head(rows)) == 0 ? cons(head(rows), fglat-missing-metrics(tail(rows))) : fglat-missing-metrics(tail(rows));
        def fglat-token-value(text) = fgd-pad-right(fgd-fit(text, 3), 3);
        def fglat-compact-zero(state) = (String) state == "idle" ? "0i" : (String) state == "empty" ? "0e" : (String) state == "drained" ? "0d" : (String) state == "quiet" ? "0q" : "0";
        def fglat-metric-live?(metric) = (Comparable) len(metric) == 0 ? 0 : fgo-present?(metric);
        // Retained tiles may show last-observed values; headline gauges may not.
        def fglat-metric-current?(metric) = !((Comparable) fglat-metric-live?(metric) == 1) ? 0 : (String) fgo-lifecycle(metric) == "silent" ? 0 : (String) fgo-lifecycle(metric) == "stale" ? 0 : (String) fgo-lifecycle(metric) == "contended" ? 0 : (String) fgo-evidence(metric) == "physical-live" ? 1 : ((String) fgo-evidence(metric) == "derived-window");
        def fglat-current-metrics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglat-metric-current?(head(rows)) == 1 ? cons(head(rows), fglat-current-metrics(tail(rows))) : fglat-current-metrics(tail(rows));
        def fglat-cpu-text(cpu) = !((Comparable) fglat-metric-current?(cpu) == 1) ? "?" : (String) fgo-unit(cpu) == "microseconds" ? fgd-format-count(fgo-int-value(cpu) / 1000) ++ "ms-total" : (String) fgo-unit(cpu) == "tenths-percent" ? fgd-cat(list(int_to_str(fgo-int-value(cpu) / 10), ".", int_to_str(fgo-int-value(cpu) % 10), "%")) : "?";
        def fglat-moving-metric?(metric) = (Comparable) fglat-metric-live?(metric) == 0 ? 0 : (String) fgo-value-kind(metric) == "text" ? 1 : !((Comparable) fgo-int-value(metric) == 0) ? 1 : (Comparable) fgd-semantic-zero-state?(fgo-lifecycle(metric)) == 1 ? 0 : 1;
        def fglat-moving-metrics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglat-moving-metric?(head(rows)) == 1 ? cons(head(rows), fglat-moving-metrics(tail(rows))) : fglat-moving-metrics(tail(rows));
        def fglat-id-ends?(id, suffix) = str_len(id) < str_len(suffix) ? 0 : ((String) substring(id, str_len(id) - str_len(suffix), str_len(id)) == suffix);
        def fglat-process-suffix-metrics(rows, suffix) = (Comparable) len(rows) == 0 ? list() : ((String) fgo-domain(head(rows)) == "process") && (((Comparable) fglat-metric-live?(head(rows)) == 1) && ((Comparable) fglat-id-ends?(fgo-id(head(rows)), suffix) == 1)) ? cons(head(rows), fglat-process-suffix-metrics(tail(rows), suffix)) : fglat-process-suffix-metrics(tail(rows), suffix);
        def fglat-metric-max(rows, held) = (Comparable) len(rows) == 0 ? held : fgo-int-value(head(rows)) > held ? fglat-metric-max(tail(rows), fgo-int-value(head(rows))) : fglat-metric-max(tail(rows), held);
        def fglat-metric-sum(rows, held) = (Comparable) len(rows) == 0 ? held : fglat-metric-sum(tail(rows), held + fgo-int-value(head(rows)));
        def fglat-find-sample-id(rows, id) = (Comparable) len(rows) == 0 ? list() : (String) fgtm-sample-id(head(rows)) == id ? head(rows) : fglat-find-sample-id(tail(rows), id);
        def fglat-token-stall-max-ms() = 5000;
        def fglat-token-stall-age-ms(sample, epoch) = (Comparable) fgtm-field-present?(fgtm-sample-write-epoch(sample)) == 0 ? -1 : epoch >= fgtm-field-value(fgtm-sample-write-epoch(sample)) ? (epoch - fgtm-field-value(fgtm-sample-write-epoch(sample))) : 0;
        def fglat-token-stall-one(token, epoch) {
            let age = fglat-token-stall-age-ms(token, epoch);
            age < 0 ? "T=unclocked" : age > fglat-token-stall-max-ms() ? fgd-cat(list("T=stale age=", fgd-format-age-ms(age))) : fgd-cat(list("T*p", int_to_str(fgtm-field-value(fgtm-sample-capacity(token))), " stall=", fgd-format-age-ms(age)));
        }
        def fglat-token-stall-text(samples, epoch) {
            let tokens = fglui-owner-token-fallback-samples(samples);
            (Comparable) len(tokens) == 0 ? "T=" ++ fglat-door("token") : fglat-token-stall-one(head(tokens), epoch);
        }
        def fglat-metric-value(metric) = (Comparable) fglat-metric-live?(metric) == 0 ? "---" : (String) fgo-value-kind(metric) == "text" ? fglat-token-value(fgo-text-value(metric)) : ((Comparable) fgo-int-value(metric) == 0) && ((Comparable) fgd-semantic-zero-state?(fgo-lifecycle(metric)) == 1) ? fglat-token-value(fglat-compact-zero(fgo-lifecycle(metric))) : (String) fgo-unit(metric) == "bytes" ? fglat-token-value(fgd-format-bytes(fgo-int-value(metric))) : fglat-token-value(fgd-format-count(fgo-int-value(metric)));
        def fglat-metric-token(metric) = fglat-kind-symbol(fgo-domain(metric)) ++ fgd-truth-symbol(fgo-evidence(metric)) ++ fglat-metric-value(metric);
        def fglat-metric-segment(metric) = ftc-segment(fglat-metric-token(metric), fglat-state-style-alpha(fgd-style-for-metric(metric), fgo-lifecycle(metric), fglat-age-alpha-ms(fgo-age(metric))), "none", (Comparable) fgo-nodeid-bound?(metric) == 1 ? fgo-nodeid-value(metric) : "metric." ++ fgo-id(metric), append(list("atlas", "selector.metric." ++ fgo-id(metric)), fgd-metric-channels(metric)), fgo-evidence(metric));
        def fglat-metric-segments(rows, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-metric-segment(head(rows)), fglat-metric-segments(tail(rows), count - 1));
        def fglat-metric-row(rows, width) = cons(fglat-prefix("m"), fglat-metric-segments(rows, fglat-capacity(width)));
        def fglat-metric-lines(rows, width, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-metric-row(rows, width), fglat-metric-lines(fgd-drop(rows, fglat-capacity(width)), width, count - 1));

        // Counter-like owner samples carry their measured value in capacity;
        // handles are identity/access doors and must not hide that value.
        // A heat of zero is not a value. The row-picker below has always said so
        // (it asks for heat > 0); this renderer did not, so a row whose only
        // number was a published zero showed "0" on the atlas as though that
        // zero had been measured. Two doors, one question: they answer together
        // now, and a row with no number falls through to its handle.
        def fglat-heat-value?(sample) = (Comparable) fgtm-field-present?(fgtm-sample-heat(sample)) == 1 ? (fgtm-field-value(fgtm-sample-heat(sample)) > 0) : 0;
        def fglat-sample-value(sample) = (Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1 ? fglat-token-value(fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample)))) : (Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? fglat-token-value(fgd-format-count(fgtm-field-value(fgtm-sample-capacity(sample)))) : (Comparable) fglat-heat-value?(sample) == 1 ? fglat-token-value(fgd-format-count(fgtm-field-value(fgtm-sample-heat(sample)))) : (Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1 ? fglat-token-value(fgd-cat(list("h", int_to_str(fgtm-field-value(fgtm-sample-handle(sample)))))) : "---";
        def fglat-sample-token(sample, epoch) = fglat-kind-symbol(fgtm-sample-kind(sample)) ++ fgd-truth-symbol(fgtm-sample-evidence(sample)) ++ fglat-sample-value(sample);
        def fglat-sample-segment(sample, epoch) = ftc-segment(fglat-sample-token(sample, epoch), fglat-state-style(fgd-sample-style(sample, epoch), fgtm-sample-lifecycle(sample)), "none", fgd-sample-projection-id(sample), append(list("atlas", "selector.sample." ++ fgtm-sample-id(sample), "selector." ++ fgtm-sample-selection-id(sample)), fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fglat-sample-segments(rows, epoch, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-sample-segment(head(rows), epoch), fglat-sample-segments(tail(rows), epoch, count - 1));
        def fglat-sample-row(rows, epoch, width) = cons(fglat-prefix("s"), fglat-sample-segments(rows, epoch, fglat-capacity(width)));
        def fglat-sample-lines(rows, epoch, width, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(fglat-sample-row(rows, epoch, width), fglat-sample-lines(fgd-drop(rows, fglat-capacity(width)), epoch, width, count - 1));
        def fglat-valued-sample?(sample) = (Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1 ? 1 : (Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? 1 : (Comparable) fglat-heat-value?(sample) == 1 ? 1 : ((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1);
        def fglat-valued-samples(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglat-valued-sample?(head(rows)) == 1 ? cons(head(rows), fglat-valued-samples(tail(rows))) : fglat-valued-samples(tail(rows));
        def fglat-ev-count-metrics(rows, ev) = (Comparable) len(rows) == 0 ? 0 : (((String) fgo-evidence(head(rows)) == ev ? 1 : 0) + fglat-ev-count-metrics(tail(rows), ev));
        def fglat-ev-count-samples(rows, ev) = (Comparable) len(rows) == 0 ? 0 : (((String) fgtm-sample-evidence(head(rows)) == ev ? 1 : 0) + fglat-ev-count-samples(tail(rows), ev));
        // the legend's three evidence counts (live, derived, catalog) over metrics and samples in one walk each
        def fglat-ev-bump(triple, ev) = (String) ev == "physical-live" ? list(triple[0] + 1, triple[1], triple[2]) : (String) ev == "derived-window" ? list(triple[0], triple[1] + 1, triple[2]) : (String) ev == "catalog" ? list(triple[0], triple[1], triple[2] + 1) : triple;
        def fglat-ev-triple-metrics(rows, triple) = (Comparable) len(rows) == 0 ? triple : fglat-ev-triple-metrics(tail(rows), fglat-ev-bump(triple, fgo-evidence(head(rows))));
        def fglat-ev-triple-samples(rows, triple) = (Comparable) len(rows) == 0 ? triple : fglat-ev-triple-samples(tail(rows), fglat-ev-bump(triple, fgtm-sample-evidence(head(rows))));
        def fglat-ev-triple(metrics, samples) = fglat-ev-triple-samples(samples, fglat-ev-triple-metrics(metrics, list(0, 0, 0)));

        def fglat-observation-prefix(truth) = (Comparable) fgov2-measured?(truth) == 1 ? "*" : (Comparable) fgov2-stale?(truth) == 1 ? "+" : (Comparable) fgov2-error?(truth) == 1 ? "!" : (Comparable) fgov2-absent?(truth) == 1 ? "-" : "?";
        def fglat-truth-text(truth, unit) = (String) unit == "state" ? fgov2-truth-value(truth) : (String) unit == "bytes" ? fgd-format-bytes(fgov2-truth-value(truth)) : fgd-format-count(fgov2-truth-value(truth));
        def fglat-observation-value(observation) {
            let truth = fgov2-observation-measurement(observation);
            ((Comparable) fgov2-measured?(truth) == 1) || ((Comparable) fgov2-stale?(truth) == 1) ? fglat-truth-text(truth, fgov2-observation-unit(observation)) : "--";
        }
        def fglat-observation-state(observation) {
            let truth = fgov2-observation-state(observation);
            (Comparable) fgov2-measured?(truth) == 1 ? fgov2-truth-value(truth) : fgov2-truth-kind(truth);
        }
        def fglat-observation-age-ms(observation, epoch) {
            let truth = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            !((Comparable) fgov2-measured?(truth) == 1) ? -1 : epoch >= fgov2-truth-value(truth) ? (epoch - fgov2-truth-value(truth)) : 0;
        }
        def fglat-observation-projection-node(observation) {
            let provenance = fgov2-observation-provenance(observation);
            fgo-field-node(fgd-value-projection-category(), list(intern_trivial_string("observation"), intern_trivial_string(fgov2-observation-id(observation)), intern_trivial_string(fgov2-observation-kind(observation)), intern_trivial_string(fgov2-observation-subtype(observation)), intern_trivial_string(fgov2-observation-unit(observation)), intern_trivial_string(fgov2-observation-plane(observation)), intern_trivial_string(fgov2-observation-access(observation))), "form/form-stdlib/form-glass-atlas-ui.bml", 1, 1);
        }
        def fglat-observation-projection-id(observation) = fgo-node-id(fglat-observation-projection-node(observation));
        def fglat-observation-token(observation, epoch) {
            let measurement = fgov2-observation-measurement(observation);
