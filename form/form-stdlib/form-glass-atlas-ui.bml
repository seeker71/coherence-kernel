        }
        def fglat-flow-total-text(standing, delta) = if eq(delta, 0) then "" else if lt(standing, 0) then "" else str_concat("/", fgd-format-count(standing));
        def fglat-flow-half(label, history, index, delta, width, plane) {
            let values = fglat-flow-values(history, index, delta);
            let latest = if eq(len(values), 0) then -1 else nth(values, sub(len(values), 1));
            let known = fglat-flow-known?(history, latest, delta);
            let evidence = fglat-lane-evidence(history, index);
            let standing = fglat-flow-standing(history, index);
