        // forced into the other's
        def fglat-tile-metric?(row) = (Comparable) len(row) == 0 ? 0 : (String) head(row) == FGTMSchema() ? 0 : 1;
        def fglat-say-metric(row) = fgd-cat(list(fgo-label(row), " = ", fgd-metric-value(row), (String) fgo-unit(row) == "" ? "" : " " ++ fgo-unit(row), " | ", fgo-lifecycle(row), ", ", fgo-evidence(row), " | read by ", fgo-source(row), (String) fgo-note(row) == "" ? "" : " | " ++ fgo-note(row)));
        def fglat-say-sample(row) = fgd-cat(list(fgtm-sample-id(row), " = ", fgtm-sample-purpose(row), " | ", fgtm-sample-lifecycle(row), ", ", fgtm-sample-evidence(row), " | ", fgtm-sample-kind(row), " of ", fgtm-sample-owner(row), " on ", fgtm-sample-plane(row)));
        def fglat-say-tile(row) = (Comparable) len(row) == 0 ? "no tile selected -- the atlas is empty" : (Comparable) fglat-tile-metric?(row) == 1 ? fglat-say-metric(row) : fglat-say-sample(row);
