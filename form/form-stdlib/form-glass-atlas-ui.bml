            let sparkWidth = fgd-max(4, sub(width, add(9, str_len(totalText))));
            ftc-segment(fgd-fit(fgd-cat(list(label, fgd-truth-symbol(evidence), fglat-spark(values, sparkWidth), "=", if eq(known, 1) then fglat-zero-gauge(label, latest) else "?", totalText)), width), fgd-style-for-plane(plane, if eq(known, 1) then 176 else 72, 0), "none", str_concat("flow.glass-monitor.", label), list("atlas", "flow", plane, "scope.glass.monitor", str_concat("source.", fglat-lane-source(history, index))), evidence);
        }
        def fglat-flow-row(leftLabel, leftIndex, leftDelta, leftPlane, rightLabel, rightIndex, rightDelta, rightPlane, history, width) {
            let half = div(sub(width, 1), 2);
            list(fglat-flow-half(leftLabel, history, leftIndex, leftDelta, half, leftPlane), ftc-segment("|", fgd-neutral(96), "none", "atlas.flow.divider", list("atlas", "flow"), "declared"), fglat-flow-half(rightLabel, history, rightIndex, rightDelta, sub(width, add(half, 1)), rightPlane));
        }
        def fglat-flow-lines(history, width) = list(fglat-flow-row("G", 2, 1, "metal", "C", 3, 1, "cpu", history, width), fglat-flow-row("D", 4, 1, "form", "Q", 5, 0, "membrane", history, width), fglat-flow-row("J", 6, 1, "cpu", "c", 7, 0, "form", history, width), fglat-flow-row("R", 8, 0, "unified", "I", 9, 0, "metal", history, width));

        def fglat-string-delta(history) {
            let values = fglat-window-deltas(history, 18);
            if lt(len(history), 2) then -1 else nth(values, sub(len(values), 1));
        }
        def fglat-string-rate(history) {
            let delta = fglat-string-delta(history);
            let elapsed = fglui-frame-delta(history);
            if or(lt(delta, 0), le(elapsed, 0)) then -1 else div(mul(delta, 1000), elapsed);
        }
        def fglat-string-line(metrics, history, width) {
            let total = fglui-last(history, 18);
            let delta = fglat-string-delta(history);
            let rate = fglat-string-rate(history);
            let growth = fgd-find-metric(metrics, "strings-growth");
            let growthText = if or(eq(len(growth), 0), eq(fgo-present?(growth), 0)) then "?" else fgd-cat(list(fgd-format-count(fgo-int-value(growth)), "/", fgd-format-count(fgo-capacity(growth))));
            let known = if and(ge(total, 0), and(ge(delta, 0), ge(rate, 0))) then 1 else 0;
            fgd-segment-line(fgd-cat(list("STR scope=glass n=", if ge(total, 0) then fgd-format-count(total) else "?", " d=", if ge(delta, 0) then fgd-format-count(delta) else "?", "/frame rate=", if ge(rate, 0) then fgd-format-count(rate) else "?", "/s growth=", growthText, " impact=unbounded-pool+selfmolt")), width, fgd-style-for-plane("cpu", if eq(known, 1) then 220 else 72, if gt(delta, 0) then 1 else 0), "flow.strings", list("atlas", "flow", "string", "memory"), if eq(known, 1) then "derived-window" else "unavailable");
        }

        // A full-screen resource-lane x observed-frame raster exposes the
        // retained ring directly. Every activity glyph is an independently
        // selectable lane+epoch cell whose retained evidence is never upgraded.
        def fglat-raster-cell-glyph(value, level) = if lt(value, 0) then "?" else fglat-ascii-glyph(level);
        def fglat-raster-cell-next(points, values, levels, laneId, index, delta, plane) {
            let value = head(values);
