            let evidences = fglat-ev-triple(metrics, samples);
            let legend = fgd-segment-line(fgd-cat(list("now *", int_to_str(evidences[0]), " +", int_to_str(evidences[1]), " #", int_to_str(evidences[2]), " ?", int_to_str(len(missingMetrics)), " valued-s=", int_to_str(len(valuedSamples)))), width, fgd-neutral(176), "atlas.legend", list("atlas", "evidence", "age", "state", "control"), "physical-live");
            let populated = append(list(title, fglat-phase-line(history, width), fglat-pipeline-line-in(index, samples, observations), fglat-string-line-in(index, history, width), fglat-doing-line-in(index, metrics, samples, epoch, width), fglat-pressure-line-in(index, samples, history, width), fglat-seam-line(missingMetrics, width)), append(fglat-flow-lines(history, width), append(metricLines, append(sampleLines, observationLines))));
