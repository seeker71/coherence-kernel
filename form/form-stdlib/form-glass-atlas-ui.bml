//////////////////////////////////////////////////////////////////////
//
// form-glass-atlas-ui.bml — dense symbolic live-data atlas.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/term-graphics.bml form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/bml/form-glass-observation-v2.bml form/form-stdlib/form-glass-flow-ui.bml form/form-stdlib/form-glass-observation-ui.bml
//
