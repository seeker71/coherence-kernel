//////////////////////////////////////////////////////////////////////
//
// native-model-side-by-side.bml — executable all-model comparison.
//
// Authority: form-stdlib/bml/native-model-side-by-side.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk form-stdlib/native-model-form-action-protocol.bml form-stdlib/assemblage-point.fk form-stdlib/native-model-symbol-stream.bml
//
// The registry projection is exhaustive.  The capability overlay is narrow
// and evidence-bound: rows without a direct witness say `unmeasured`.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelSideBySideAuthority {
        field NMSSAuthorityPath = "form/form-stdlib/bml/native-model-side-by-side.bml";
        field NMSSAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelSideBySide {
        field NMSSSchema = "native-model-side-by-side-v1";
        field NMSSUnknown = "unmeasured";
        field NMSSQwenId = "challenger.qwen38-flash-next-q2-metal";
        field NMSSDecodeFloor = 23922;
        field NMSSPrefillFloor = 286947;

        ref nmss-authority = NativeModelSideBySideAuthority;
        thought nmss-law = list("all-registry-rows", "explicit-unknowns", "evidence-not-promotion", "wall-rate-separate-from-parity");

        // capability row: tag, id, server dependency, native token evidence,
        // tokenizer, prefill state, decode state, wall milli-tok/s for each,
        // exact context, substate API, prefix reuse, long-context state, evidence.
        def nmss-capability(id, server, token, tokenizer, prefillState, decodeState, prefillRate, decodeRate, context, substate, prefix, longContext, evidence) {
            list("native-model-capability", id, server, token, tokenizer, prefillState, decodeState, prefillRate, decodeRate, context, substate, prefix, longContext, evidence);
        }

        def nmss-default-capability(id) {
            nmss-capability(id, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "no-direct-capability-measurement-in-comparison-overlay");
        }

        def nmss-capability-for(id) {
            if str_eq(id, NMSSQwenId()) then
                nmss-capability(id, "none", "proven-two-token-parity", "proven-gguf-byte-bpe", "native-sequential-vocab-on-final; token-batch-pending", "failing-90pct-gate", 12340, 12188, 2048, "proven-lookup-evaluate", "exact-and-append-reuse", "qsa-pending-beyond-2048", "token-9419-to-11-to-271-parity; decode64=12188-millitokps; prefill64-sequential=12340-millitokps; 1879/1876-dispatches-per-token; tokenizer-255; state-1023; generate-255")
            else if str_eq(id, "base.llama32-3b-metal") then
                nmss-capability(id, "none", "proven-24-token-parity", NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "registry-receipt-2026-07-21")
            else if str_eq(id, "challenger.deepseek-ds4-metal") then
                nmss-capability(id, "none", "proven-24-token-parity", NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "registry-reference-token-agreement")
            else if str_eq(id, "challenger.kat-coder-v25-metal") then
                nmss-capability(id, "none", "exit-path-only", NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "registry-exit-path-mechanism-witness")
            else if str_eq(id, "challenger.qwen38-27b-metal") then
                nmss-capability(id, "none", "generate-canary", NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "registry-form-native-generate-canary")
            else if str_eq(id, "llm.tinyllama-260k-native") then
                nmss-capability(id, "none", "proven-7-token-parity", NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), 0, 0, 0, NMSSUnknown(), NMSSUnknown(), NMSSUnknown(), "registry-native-generate-rope-receipt")
            else nmss-default-capability(id);
        }

        def nmss-cap-server(c) = nth(c, 2);
        def nmss-cap-token(c) = nth(c, 3);
        def nmss-cap-tokenizer(c) = nth(c, 4);
        def nmss-cap-prefill-state(c) = nth(c, 5);
        def nmss-cap-decode-state(c) = nth(c, 6);
        def nmss-cap-prefill-rate(c) = nth(c, 7);
        def nmss-cap-decode-rate(c) = nth(c, 8);
        def nmss-cap-context(c) = nth(c, 9);
        def nmss-cap-substate(c) = nth(c, 10);
        def nmss-cap-prefix(c) = nth(c, 11);
        def nmss-cap-long(c) = nth(c, 12);
        def nmss-cap-evidence(c) = nth(c, 13);

        // Projection retains every field a side-by-side decision needs, then
        // appends only the evidence-bound capability overlay.
        def nmss-form-action-state(envelope) {
            if or(eq(nmfte-envelope-prompt-admitted?(envelope), 1), eq(nmfte-envelope-native-admitted?(envelope), 1)) then "proposal-enabled-native-gated"
            else if eq(nmfte-envelope-local?(envelope), 1) then "assigned-blocked-or-nontext"
            else "not-local";
        }
        def nmss-symbol-role() = "reasoning-fallback";
        def nmss-project(row) {
            let cap = nmss-capability-for(nmcp-id(row));
            let envelope = nmfte-project(row);
            let feed = nmfss-feed(row, nmss-symbol-role());
            list("native-model-side-by-side", nmcp-id(row), nmcp-model-name(row), nmcp-lane(row), nmcp-modality(row), nmcp-class(row), nmcp-role(row), nmcp-status(row), nmcp-surface(row), nmcp-runtime(row), nmcp-score(row), nmcp-samples(row), nmcp-heldout(row), nmcp-priority(row), nmcp-active?(row), nmcp-artifact(row), nmcp-evidence(row), nmcp-metric(row), nmcp-next-action(row), nmss-cap-server(cap), nmss-cap-token(cap), nmss-cap-tokenizer(cap), nmss-cap-prefill-state(cap), nmss-cap-decode-state(cap), nmss-cap-prefill-rate(cap), nmss-cap-decode-rate(cap), nmss-cap-context(cap), nmss-cap-substate(cap), nmss-cap-prefix(cap), nmss-cap-long(cap), nmss-cap-evidence(cap), nmfte-envelope-local?(envelope), nmfte-envelope-prompt-admitted?(envelope), nmfte-envelope-native-admitted?(envelope), nmfte-envelope-mode(envelope), nmfte-envelope-controls(envelope), nmfte-envelope-state(envelope), nmfte-envelope-reason(envelope), nmfte-envelope-native-words(envelope), nmss-form-action-state(envelope), nmfss-feed-lane(feed), nmfss-feed-count(feed), nmfss-feed-admitted(feed), nmfss-feed-assemblage(feed));
        }

        def nmss-project-all(rows) = if eq(len(rows), 0) then list() else cons(nmss-project(head(rows)), nmss-project-all(tail(rows)));

        def nmss-row-id(row) = nth(row, 1);
        def nmss-row-cap-token(row) = nth(row, 20);
        def nmss-row-prefill-state(row) = nth(row, 22);
        def nmss-row-decode-state(row) = nth(row, 23);
        def nmss-row-prefill-rate(row) = nth(row, 24);
        def nmss-row-decode-rate(row) = nth(row, 25);
        def nmss-row-context(row) = nth(row, 26);
        def nmss-row-substate(row) = nth(row, 27);
        def nmss-row-form-local?(row) = nth(row, 31);
        def nmss-row-form-prompt-admitted?(row) = nth(row, 32);
        def nmss-row-form-native-admitted?(row) = nth(row, 33);
        def nmss-row-form-mode(row) = nth(row, 34);
        def nmss-row-form-controls(row) = nth(row, 35);
        def nmss-row-form-state(row) = nth(row, 36);
        def nmss-row-form-reason(row) = nth(row, 37);
        def nmss-row-form-native-words(row) = nth(row, 38);
        def nmss-row-form-action-state(row) = nth(row, 39);
        def nmss-row-form-query-lane(row) = nth(row, 40);
        def nmss-row-form-selected-symbols(row) = nth(row, 41);
        def nmss-row-form-admitted-symbols(row) = nth(row, 42);
        def nmss-row-form-assemblage(row) = nth(row, 43);

        def nmss-find(id, rows) = if eq(len(rows), 0) then list() else if str_eq(id, nmss-row-id(head(rows))) then head(rows) else nmss-find(id, tail(rows));

        def nmss-population-complete?(registry, projected) = if eq(len(registry), len(projected)) then if eq(nmcp-unique?(registry), 1) then 1 else 0 else 0;
        def nmss-qwen-performance-accepted?(row) = if ge(nmss-row-decode-rate(row), NMSSDecodeFloor()) then if ge(nmss-row-prefill-rate(row), NMSSPrefillFloor()) then 1 else 0 else 0;

        def nmss-field-string(value, numeric) = if numeric then int_to_str(value) else value;
        def nmss-line-fields(fields) = if eq(len(fields), 0) then "\n" else if eq(len(fields), 1) then str_concat(head(fields), "\n") else str_concat(head(fields), str_concat("\t", nmss-line-fields(tail(fields))));
        def nmss-line(row) {
            let fields = list(nth(row, 1), nth(row, 2), nth(row, 3), nth(row, 4), nth(row, 5), nth(row, 6), nth(row, 7), nth(row, 8), nth(row, 9), int_to_str(nth(row, 10)), int_to_str(nth(row, 11)), int_to_str(nth(row, 12)), int_to_str(nth(row, 13)), int_to_str(nth(row, 14)), nth(row, 15), nth(row, 16), nth(row, 17), nth(row, 18), nth(row, 19), nth(row, 20), nth(row, 21), nth(row, 22), nth(row, 23), int_to_str(nth(row, 24)), int_to_str(nth(row, 25)), int_to_str(nth(row, 26)), nth(row, 27), nth(row, 28), nth(row, 29), nth(row, 30), int_to_str(nth(row, 31)), int_to_str(nth(row, 32)), int_to_str(nth(row, 33)), nth(row, 34), int_to_str(nth(row, 35)), nth(row, 36), nth(row, 37), int_to_str(nth(row, 38)), nth(row, 39), nth(row, 40), int_to_str(nth(row, 41)), int_to_str(nth(row, 42)), nth(row, 43));
            nmss-line-fields(fields);
        }
        def nmss-render(rows) = if eq(len(rows), 0) then "" else str_concat(nmss-line(head(rows)), nmss-render(tail(rows)));
        def nmss-header() = "model_id\tmodel\tlane\tmodality\tclass\trole\tstatus\tsurface\truntime\tscore_ppm\tsamples\theldout\tpriority\tactive\tartifact\tregistry_evidence\tmetric\tnext_action\tserver_dependency\tnative_token_evidence\ttokenizer\tprefill_state\tdecode_state\tprefill_millitokps\tdecode_millitokps\texact_context\tsubstate_api\tprefix_reuse\tlong_context\tcapability_evidence\tform_local\tform_prompt_admitted\tform_native_admitted\tform_delivery_mode\tform_control_count\tform_token_state\tform_token_reason\tform_native_word_count\tform_action_state\tform_query_lane\tform_selected_symbols\tform_admitted_symbols\tform_assemblage\n";
        def nmss-report() {
            let rows = nmss-project-all(nmcp-registry());
            str_concat("schema=native-model-side-by-side-v1\n", str_concat("population=all-registry-rows\n", str_concat("authority_eligible=0\n", str_concat(nmss-header(), nmss-render(rows)))));
        }
        def nmss-print-report() = print_str(nmss-report());
    }
    0;
}
