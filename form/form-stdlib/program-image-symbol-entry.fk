// program-image-symbol-entry.fk -- Layer 8h8 symbol-to-entry resolver.
//
// This layer resolves embedded program-image symbol truth to a callable
// function-root entry. It is pure metadata resolution over a valid PIF
// envelope: no execution, no artifact IO, no presentation lens authority, and
// no host seed growth.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/program-image-fkb.fk
section [form.bml] {
    def pise-version() = "program-image-symbol-entry-v1";
    def pise-feature(name, status) = ["program-image-symbol-entry-feature", name, status];
    def pise-feature-name(f) = f[1];
    def pise-feature-status(f) = f[2];
    def program-image-symbol-entry-manifest() = [pise-feature("layer-8h8-symbol-entry-resolver", 1), pise-feature("pure-pif-metadata-resolution", 1), pise-feature("embedded-fkb-symbol-truth-only", 1), pise-feature("symbol-id-request", 1), pise-feature("canonical-key-request", 1), pise-feature("id-key-agreement-request", 1), pise-feature("diagnostic-node-request-not-calling-surface", 1), pise-feature("canonical-key-must-be-unambiguous", 1), pise-feature("node-symbol-row-required", 1), pise-feature("non-anonymous-defined-symbol-required", 1), pise-feature("defined-node-must-be-unique-function-root", 1), pise-feature("dependency-targets-carried-not-walked", 1), pise-feature("fkwu-native-kind-guards", 1), pise-feature("no-presentation-lens-authority", 1), pise-feature("no-artifact-io", 1), pise-feature("no-execution-or-trace-production", 1), pise-feature("no-generated-table-authority", 1), pise-feature("no-host-seed-growth", 1)];
    def program-image-symbol-entry-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) pise-feature-name(head(fs)) == name && (Comparable) pise-feature-status(head(fs)) == 1 ? 1 : program-image-symbol-entry-manifest-has?(name, tail(fs));
    // fkwu intentionally has no value_kind primitive.  Symbol-entry's public
    // inputs are already scannerless-decoded request/resolution *records*:
    // each is a Form list born by the constructors below or by a parser which
    // has established that schema.  Do not try to discover a list by calling
    // string or integer primitives on it: the fourth arm carries a Form list
    // while Go/Rust/TypeScript correctly reject that as a string.  Absence is
    // still a first-class refused record; field-kind checks happen only after
    // record shape has admitted the field position.
    def pise-string?(x) = str_len(x) > 0 || (String) x == "" ? 1 : 0;
    def pise-int?(x) = {
        let rendered = int_to_str(x);
        (Comparable) str_len(rendered) == 0 ? 0 : (Comparable) str_to_int(rendered) == x ? 1 : 0;
    };
    def pise-record-present?(x) = nothing?(x) ? 0 : 1;
    def pise-nonempty-string?(x) = pise-string?(x) ? str_len(x) > 0 : 0;
    def pise-mode-symbol-id() = "symbol-id";
    def pise-mode-canonical-key() = "canonical-key";
    def pise-mode-id-key() = "symbol-id-and-key";
    def pise-mode-diagnostic-node() = "diagnostic-node";
    def pise-status-ready() = "ready";
    def pise-status-investigate() = "investigate";
    def pise-status-refused() = "refused";
    def pise-reason-ready() = "symbol-entry-ready";
    def pise-reason-invalid-pif() = "invalid-pif-envelope";
    def pise-reason-malformed-request() = "malformed-request";
    def pise-reason-invalid-symbol-id() = "invalid-symbol-id";
    def pise-reason-empty-canonical-key() = "empty-canonical-key";
    def pise-reason-canonical-key-not-found() = "canonical-key-not-found";
    def pise-reason-duplicate-canonical-key() = "duplicate-canonical-key";
    def pise-reason-symbol-id-key-mismatch() = "symbol-id-key-mismatch";
    def pise-reason-symbol-not-defined-by-node() = "symbol-not-defined-by-node";
    def pise-reason-node-id-out-of-range() = "node-id-out-of-range";
    def pise-reason-node-symbol-row-not-found() = "node-symbol-row-not-found";
    def pise-reason-anonymous-node() = "anonymous-node";
    def pise-reason-defined-node-not-function-root() = "defined-node-not-function-root";
    def pise-reason-duplicate-function-root() = "duplicate-function-root";
    def pise-reason-manifest() = [pise-reason-ready(), pise-reason-invalid-pif(), pise-reason-malformed-request(), pise-reason-invalid-symbol-id(), pise-reason-empty-canonical-key(), pise-reason-canonical-key-not-found(), pise-reason-duplicate-canonical-key(), pise-reason-symbol-id-key-mismatch(), pise-reason-symbol-not-defined-by-node(), pise-reason-node-id-out-of-range(), pise-reason-node-symbol-row-not-found(), pise-reason-anonymous-node(), pise-reason-defined-node-not-function-root(), pise-reason-duplicate-function-root()];
    // request = ("program-image-symbol-entry-request" version mode
    //            symbol-id canonical-key node-id)
    def pise-request(mode, symbol-id, canonical-key, node-id) = ["program-image-symbol-entry-request", pise-version(), mode, symbol-id, canonical-key, node-id];
    def pise-request-by-symbol-id(symbol-id) = pise-request(pise-mode-symbol-id(), symbol-id, "", 0 - 1);
    def pise-request-by-canonical-key(key) = pise-request(pise-mode-canonical-key(), 0 - 1, key, 0 - 1);
    def pise-request-by-symbol-id-key(symbol-id, key) = pise-request(pise-mode-id-key(), symbol-id, key, 0 - 1);
    def pise-diagnostic-request-by-node(node-id) = pise-request(pise-mode-diagnostic-node(), 0 - 1, "", node-id);
    def pise-request?(r) = pise-record-present?(r) ? (Comparable) len(r) == 6 ? pise-string?(r[0]) ? (String) r[0] == "program-image-symbol-entry-request" ? (String) r[1] == pise-version() : 0 : 0 : 0 : 0;
    def pise-request-mode(r) = r[2];
    def pise-request-symbol-id(r) = r[3];
    def pise-request-canonical-key(r) = r[4];
    def pise-request-node-id(r) = r[5];
    def pise-known-mode?(mode) = (String) mode == pise-mode-symbol-id() ? 1 : (String) mode == pise-mode-canonical-key() ? 1 : (String) mode == pise-mode-id-key() ? 1 : (String) mode == pise-mode-diagnostic-node();
    def pise-no-symbol-row() = ["program-image-symbol-entry-no-symbol-row"];
    def pise-no-node-symbol-row() = ["program-image-symbol-entry-no-node-symbol-row"];
    def pise-no-dependency-targets() = empty();
    // resolution = ("program-image-symbol-entry-resolution" pif request
    //               symbol-id canonical-key symbol-row node-symbol-row
    //               dependency-targets entry-index root-node status reason)
    def pise-resolution(pif, request, symbol-id, canonical-key, symbol-row, node-symbol-row, dependency-targets, entry-index, root-node, status, reason) = ["program-image-symbol-entry-resolution", pif, request, symbol-id, canonical-key, symbol-row, node-symbol-row, dependency-targets, entry-index, root-node, status, reason];
    def pise-resolution?(r) = pise-record-present?(r) ? (Comparable) len(r) == 12 ? pise-string?(r[0]) ? (String) r[0] == "program-image-symbol-entry-resolution" : 0 : 0 : 0;
    def pise-resolution-pif(r) = r[1];
    def pise-resolution-request(r) = r[2];
    def pise-resolution-symbol-id(r) = r[3];
    def pise-resolution-canonical-key(r) = r[4];
    def pise-resolution-symbol-row(r) = r[5];
    def pise-resolution-node-symbol-row(r) = r[6];
    def pise-resolution-dependency-targets(r) = r[7];
    def pise-resolution-entry-index(r) = r[8];
    def pise-resolution-root-node(r) = r[9];
    def pise-resolution-status(r) = r[10];
    def pise-resolution-reason(r) = r[11];
    def pise-refused(pif, request, reason) = pise-resolution(pif, request, 0 - 1, "", pise-no-symbol-row(), pise-no-node-symbol-row(), pise-no-dependency-targets(), 0 - 1, 0 - 1, pise-status-refused(), reason);
    def pise-investigate(pif, request, symbol-id, canonical-key, symbol-row, node-symbol-row, dependency-targets, entry-index, root-node, reason) = pise-resolution(pif, request, symbol-id, canonical-key, symbol-row, node-symbol-row, dependency-targets, entry-index, root-node, pise-status-investigate(), reason);
    def pise-ready(pif, request, symbol-row, node-symbol-row, entry-index, root-node) = pise-resolution(pif, request, pif-symbol-row-id(symbol-row), pif-symbol-row-key(symbol-row), symbol-row, node-symbol-row, pif-node-symbol-row-dependency-targets(node-symbol-row), entry-index, root-node, pise-status-ready(), pise-reason-ready());
    def pise-symbol-id-valid?(pif, symbol-id) = pise-int?(symbol-id) ? pif-symbol-id-ref?(symbol-id, pif-symbol-image-count(pif-envelope-symbol-image(pif))) : 0;
    def pise-node-id-valid?(pif, node-id) = pise-int?(node-id) ? pif-node-id-ref?(node-id, pif-table-nr(pif-envelope-table(pif))) : 0;
    def pise-symbol-row-at(pif, symbol-id) = pif-symbol-image-rows(pif-envelope-symbol-image(pif))[symbol-id];
    def pise-symbol-row-key-match?(row, key) = (Comparable) len(row) == 2 ? (String) pif-symbol-row-key(row) == key : 0;
    def pise-symbol-key-match-count(rows, key) = nil?(rows) ? 0 : (pise-symbol-row-key-match?(head(rows), key) ? 1 : 0) + pise-symbol-key-match-count(tail(rows), key);
    def pise-symbol-row-for-key(rows, key) = nil?(rows) ? pise-no-symbol-row() : pise-symbol-row-key-match?(head(rows), key) ? head(rows) : pise-symbol-row-for-key(tail(rows), key);
    def pise-node-symbol-row-defines-symbol?(row, symbol-id) = (Comparable) len(row) == 3 ? (Comparable) pif-node-symbol-row-defined(row) == symbol-id : 0;
    def pise-node-symbol-define-count(rows, symbol-id) = nil?(rows) ? 0 : (pise-node-symbol-row-defines-symbol?(head(rows), symbol-id) ? 1 : 0) + pise-node-symbol-define-count(tail(rows), symbol-id);
    def pise-node-symbol-row-for-symbol(rows, symbol-id) = nil?(rows) ? pise-no-node-symbol-row() : pise-node-symbol-row-defines-symbol?(head(rows), symbol-id) ? head(rows) : pise-node-symbol-row-for-symbol(tail(rows), symbol-id);
    def pise-node-symbol-row-for-node(rows, node-id) = nil?(rows) ? pise-no-node-symbol-row() : (Comparable) len(head(rows)) == 3 && (Comparable) pif-node-symbol-row-node(head(rows)) == node-id ? head(rows) : pise-node-symbol-row-for-node(tail(rows), node-id);
    def pise-root-match-count(roots, node-id) = nil?(roots) ? 0 : ((Comparable) head(roots) == node-id ? 1 : 0) + pise-root-match-count(tail(roots), node-id);
    def pise-root-entry-index-loop(roots, node-id, index) = nil?(roots) ? 0 - 1 : (Comparable) head(roots) == node-id ? index : pise-root-entry-index-loop(tail(roots), node-id, index + 1);
    def pise-root-entry-index(pif, node-id) = pise-root-entry-index-loop(pif-table-fn-roots(pif-envelope-table(pif)), node-id, 0);
    def pise-resolve-node-symbol-row(pif, request, symbol-row, node-row) = {
        let node-id = pif-node-symbol-row-node(node-row);
        let roots = pif-table-fn-roots(pif-envelope-table(pif));
        let root-count = pise-root-match-count(roots, node-id);
        (Comparable) root-count == 0 ? pise-investigate(pif, request, pif-symbol-row-id(symbol-row), pif-symbol-row-key(symbol-row), symbol-row, node-row, pif-node-symbol-row-dependency-targets(node-row), 0 - 1, node-id, pise-reason-defined-node-not-function-root()) : root-count > 1 ? pise-investigate(pif, request, pif-symbol-row-id(symbol-row), pif-symbol-row-key(symbol-row), symbol-row, node-row, pif-node-symbol-row-dependency-targets(node-row), pise-root-entry-index(pif, node-id), node-id, pise-reason-duplicate-function-root()) : pise-ready(pif, request, symbol-row, node-row, pise-root-entry-index(pif, node-id), node-id);
    };
    def pise-resolve-symbol-row(pif, request, symbol-row) = {
        let symbol-id = pif-symbol-row-id(symbol-row);
        let rows = pif-symbol-image-node-rows(pif-envelope-symbol-image(pif));
        let count = pise-node-symbol-define-count(rows, symbol-id);
        (Comparable) count == 0 ? pise-investigate(pif, request, symbol-id, pif-symbol-row-key(symbol-row), symbol-row, pise-no-node-symbol-row(), pise-no-dependency-targets(), 0 - 1, 0 - 1, pise-reason-symbol-not-defined-by-node()) : pise-resolve-node-symbol-row(pif, request, symbol-row, pise-node-symbol-row-for-symbol(rows, symbol-id));
    };
    def pise-resolve-by-symbol-id(pif, request, symbol-id) = !pise-int?(symbol-id) ? pise-refused(pif, request, pise-reason-malformed-request()) : !pise-symbol-id-valid?(pif, symbol-id) ? pise-refused(pif, request, pise-reason-invalid-symbol-id()) : pise-resolve-symbol-row(pif, request, pise-symbol-row-at(pif, symbol-id));
    def pise-resolve-by-canonical-key(pif, request, key) = !pise-string?(key) ? pise-refused(pif, request, pise-reason-malformed-request()) : !pise-nonempty-string?(key) ? pise-refused(pif, request, pise-reason-empty-canonical-key()) : {
        let rows = pif-symbol-image-rows(pif-envelope-symbol-image(pif));
        let count = pise-symbol-key-match-count(rows, key);
        (Comparable) count == 0 ? pise-refused(pif, request, pise-reason-canonical-key-not-found()) : count > 1 ? pise-investigate(pif, request, 0 - 1, key, pise-no-symbol-row(), pise-no-node-symbol-row(), pise-no-dependency-targets(), 0 - 1, 0 - 1, pise-reason-duplicate-canonical-key()) : pise-resolve-symbol-row(pif, request, pise-symbol-row-for-key(rows, key));
    };
    def pise-resolve-by-symbol-id-key(pif, request, symbol-id, key) = !pise-int?(symbol-id) ? pise-refused(pif, request, pise-reason-malformed-request()) : !pise-string?(key) ? pise-refused(pif, request, pise-reason-malformed-request()) : !pise-symbol-id-valid?(pif, symbol-id) ? pise-refused(pif, request, pise-reason-invalid-symbol-id()) : !pise-nonempty-string?(key) ? pise-refused(pif, request, pise-reason-empty-canonical-key()) : {
        let row = pise-symbol-row-at(pif, symbol-id);
        !((String) pif-symbol-row-key(row) == key) ? pise-investigate(pif, request, symbol-id, key, row, pise-no-node-symbol-row(), pise-no-dependency-targets(), 0 - 1, 0 - 1, pise-reason-symbol-id-key-mismatch()) : pise-symbol-key-match-count(pif-symbol-image-rows(pif-envelope-symbol-image(pif)), key) > 1 ? pise-investigate(pif, request, symbol-id, key, row, pise-no-node-symbol-row(), pise-no-dependency-targets(), 0 - 1, 0 - 1, pise-reason-duplicate-canonical-key()) : pise-resolve-symbol-row(pif, request, row);
    };
    def pise-resolve-diagnostic-node(pif, request, node-id) = !pise-int?(node-id) ? pise-refused(pif, request, pise-reason-malformed-request()) : !pise-node-id-valid?(pif, node-id) ? pise-refused(pif, request, pise-reason-node-id-out-of-range()) : {
        let row = pise-node-symbol-row-for-node(pif-symbol-image-node-rows(pif-envelope-symbol-image(pif)), node-id);
        !((Comparable) len(row) == 3) ? pise-investigate(pif, request, 0 - 1, "", pise-no-symbol-row(), row, pise-no-dependency-targets(), 0 - 1, node-id, pise-reason-node-symbol-row-not-found()) : (Comparable) pif-node-symbol-row-defined(row) == 0 - 1 ? pise-investigate(pif, request, 0 - 1, "", pise-no-symbol-row(), row, pif-node-symbol-row-dependency-targets(row), 0 - 1, node-id, pise-reason-anonymous-node()) : pise-resolve-node-symbol-row(pif, request, pise-symbol-row-at(pif, pif-node-symbol-row-defined(row)), row);
    };
    def pise-resolve(pif, request) = !pif-envelope-valid?(pif) ? pise-refused(pif, request, pise-reason-invalid-pif()) : !pise-request?(request) ? pise-refused(pif, request, pise-reason-malformed-request()) : {
        let mode = pise-request-mode(request);
        !pise-known-mode?(mode) ? pise-refused(pif, request, pise-reason-malformed-request()) : (String) mode == pise-mode-symbol-id() ? pise-resolve-by-symbol-id(pif, request, pise-request-symbol-id(request)) : (String) mode == pise-mode-canonical-key() ? pise-resolve-by-canonical-key(pif, request, pise-request-canonical-key(request)) : (String) mode == pise-mode-id-key() ? pise-resolve-by-symbol-id-key(pif, request, pise-request-symbol-id(request), pise-request-canonical-key(request)) : pise-resolve-diagnostic-node(pif, request, pise-request-node-id(request));
    };
}
