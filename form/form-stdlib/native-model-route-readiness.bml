//////////////////////////////////////////////////////////////////////
//
// native-model-route-readiness.bml — executable current-route truth.
//
// Authority: form-stdlib/bml/native-model-route-readiness.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelRouteReadinessAuthority {
        field NMRRAuthorityPath = "form/form-stdlib/bml/native-model-route-readiness.bml";
        field NMRRAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelRouteReadiness {
        field NMRRSchema = "native-model-route-readiness-v2";
        field NMRROwnerLivenessId = "process.native-model-dual-resident";
        ref nmrr-authority = NativeModelRouteReadinessAuthority;
        thought nmrr-law = list("mapped-is-not-callable", "last-handle-is-not-current-readiness", "current-exact-owner-liveness", "aged-state-does-not-renew", "matching-owner-scoped-loaded-and-prefilled-handles", "parallel-availability-is-not-simultaneous-dispatch", "every-unavailable-fact-names-one-missing-door");

        def nmrr-fact(id, present, value, evidence, observedEpoch, reason, missingDoor) = list(NMRRSchema(), id, present, value, evidence, observedEpoch, reason, missingDoor);
        def nmrr-fact-id(fact) = nth(fact, 1);
        def nmrr-fact-present?(fact) = nth(fact, 2);
        def nmrr-fact-value(fact) = nth(fact, 3);
        def nmrr-fact-evidence(fact) = nth(fact, 4);
        def nmrr-fact-observed(fact) = nth(fact, 5);
        def nmrr-fact-reason(fact) = nth(fact, 6);
        def nmrr-fact-missing-door(fact) = nth(fact, 7);
        def nmrr-unavailable(id, observedEpoch, reason, missingDoor) = nmrr-fact(id, 0, 0, "unavailable", observedEpoch, reason, missingDoor);
        def nmrr-measured(id, value, observedEpoch, reason) = nmrr-fact(id, 1, value, "physical-live", observedEpoch, reason, "");
        def nmrr-derived(id, value, observedEpoch, reason) = nmrr-fact(id, 1, value, "derived-window", observedEpoch, reason, "");
        def nmrr-present-evidence?(evidence) = if str_eq(evidence, "physical-live") then 1 else if str_eq(evidence, "derived-window") then 1 else 0;
        def nmrr-fact-valid?(fact) = if not(eq(len(fact), 8)) then 0 else if not(str_eq(head(fact), NMRRSchema())) then 0 else if not(or(eq(nmrr-fact-present?(fact), 0), eq(nmrr-fact-present?(fact), 1))) then 0 else if lt(nmrr-fact-observed(fact), 0) then 0 else if eq(nmrr-fact-present?(fact), 0) then and(eq(nmrr-fact-value(fact), 0), and(str_eq(nmrr-fact-evidence(fact), "unavailable"), gt(str_len(nmrr-fact-missing-door(fact)), 0))) else and(or(eq(nmrr-fact-value(fact), 0), eq(nmrr-fact-value(fact), 1)), and(eq(nmrr-present-evidence?(nmrr-fact-evidence(fact)), 1), eq(str_len(nmrr-fact-missing-door(fact)), 0)));

        def nmrr-snapshot-age(snapshot, nowEpoch) = if not(eq(fgtm-snapshot-valid?(snapshot), 1)) then -1 else if ge(fgtm-snapshot-epoch(snapshot), nowEpoch) then 0 else sub(nowEpoch, fgtm-snapshot-epoch(snapshot));
        def nmrr-find-id(samples, id) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), id) then head(samples) else nmrr-find-id(tail(samples), id);
        def nmrr-find-kind(samples, kind) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-kind(head(samples)), kind) then head(samples) else nmrr-find-kind(tail(samples), kind);
        def nmrr-find-state(samples, parent, state) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-kind(head(samples)), "model-state"), and(eq(fgtm-field-present?(fgtm-sample-parent(head(samples))), 1), and(str_eq(fgtm-field-value(fgtm-sample-parent(head(samples))), parent), str_eq(fgtm-sample-purpose(head(samples)), state)))) then head(samples) else nmrr-find-state(tail(samples), parent, state);
        def nmrr-positive-handle?(sample) = if eq(len(sample), 0) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1)) then 0 else gt(fgtm-field-value(fgtm-sample-handle(sample)), 0);
        def nmrr-same-handle?(left, right) = if not(eq(nmrr-positive-handle?(left), 1)) then 0 else if not(eq(nmrr-positive-handle?(right), 1)) then 0 else eq(fgtm-field-value(fgtm-sample-handle(left)), fgtm-field-value(fgtm-sample-handle(right)));
        def nmrr-state-enabled?(sample) = if eq(len(sample), 0) then 0 else str_eq(fgtm-sample-lifecycle(sample), "active");
        def nmrr-owner-heartbeat-current?(snapshot, heartbeat) = if eq(len(heartbeat), 0) then 0 else if not(str_eq(fgtm-sample-owner(heartbeat), fgtm-snapshot-publisher(snapshot))) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-read-epoch(heartbeat)), 1)) then 0 else eq(fgtm-field-value(fgtm-sample-read-epoch(heartbeat)), fgtm-snapshot-epoch(snapshot));

        // Glass has already lease-filtered each publisher snapshot.  This
        // join still requires the independently sampled OS-liveness row to
        // correlate with the owner heartbeat by PID and process start, and
        // retains each state row's own event epoch rather than renewing it at the heartbeat epoch.
        def nmrr-current-physical?(sample) = if eq(len(sample), 0) then 0 else str_eq(fgtm-sample-evidence(sample), "physical-live");
        def nmrr-retained-state-evidence?(sample) = if eq(len(sample), 0) then 0 else if str_eq(fgtm-sample-evidence(sample), "physical-live") then 1 else if str_eq(fgtm-sample-evidence(sample), "derived-window") then 1 else 0;
        def nmrr-same-owner?(sample, heartbeat) = if eq(len(sample), 0) then 0 else if eq(len(heartbeat), 0) then 0 else str_eq(fgtm-sample-owner(sample), fgtm-sample-owner(heartbeat));
        def nmrr-present-number-equal?(left, right) = if not(eq(fgtm-field-present?(left), 1)) then 0 else if not(eq(fgtm-field-present?(right), 1)) then 0 else eq(fgtm-field-value(left), fgtm-field-value(right));
        def nmrr-current-owner-liveness(samples) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-id(head(samples)), NMRROwnerLivenessId()), and(eq(nmrr-current-physical?(head(samples)), 1), and(str_eq(fgtm-sample-lifecycle(head(samples)), "active"), str_eq(fgtm-sample-purpose(head(samples)), "os-process-lifetime-current")))) then head(samples) else nmrr-current-owner-liveness(tail(samples));
        def nmrr-retained-owner-heartbeat(samples) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-kind(head(samples)), "owner-heartbeat"), eq(nmrr-retained-state-evidence?(head(samples)), 1)) then head(samples) else nmrr-retained-owner-heartbeat(tail(samples));
        def nmrr-correlated-owner-heartbeat(samples, liveness) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-kind(head(samples)), "owner-heartbeat"), and(eq(nmrr-retained-state-evidence?(head(samples)), 1), and(eq(nmrr-present-number-equal?(fgtm-sample-handle(head(samples)), fgtm-sample-handle(liveness)), 1), eq(nmrr-present-number-equal?(fgtm-sample-write-epoch(head(samples)), fgtm-sample-write-epoch(liveness)), 1)))) then head(samples) else nmrr-correlated-owner-heartbeat(tail(samples), liveness);
        def nmrr-retained-id(samples, id, heartbeat) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-id(head(samples)), id), and(eq(nmrr-retained-state-evidence?(head(samples)), 1), eq(nmrr-same-owner?(head(samples), heartbeat), 1))) then head(samples) else nmrr-retained-id(tail(samples), id, heartbeat);
        def nmrr-retained-state-at(samples, parent, state, heartbeat) = if eq(len(samples), 0) then list() else if and(str_eq(fgtm-sample-kind(head(samples)), "model-state"), and(eq(nmrr-retained-state-evidence?(head(samples)), 1), and(eq(nmrr-same-owner?(head(samples), heartbeat), 1), and(eq(fgtm-field-present?(fgtm-sample-parent(head(samples))), 1), and(str_eq(fgtm-field-value(fgtm-sample-parent(head(samples))), parent), str_eq(fgtm-sample-purpose(head(samples)), state)))))) then head(samples) else nmrr-retained-state-at(tail(samples), parent, state, heartbeat);
        def nmrr-model-route-from-current-samples(samples, nowEpoch, modelId) {
            let liveness = nmrr-current-owner-liveness(samples);
            let anyHeartbeat = nmrr-retained-owner-heartbeat(samples);
            let heartbeat = if eq(len(liveness), 0) then list() else nmrr-correlated-owner-heartbeat(samples, liveness);
            let model = if eq(len(heartbeat), 0) then list() else nmrr-retained-id(samples, modelId, heartbeat);
            let loaded = if eq(len(heartbeat), 0) then list() else nmrr-retained-state-at(samples, modelId, "loaded", heartbeat);
            let prefilled = if eq(len(heartbeat), 0) then list() else nmrr-retained-state-at(samples, modelId, "prefilled", heartbeat);
            if eq(len(liveness), 0) then nmrr-unavailable(modelId, nowEpoch, "owner-process-liveness-absent-or-stale", "host.process.owner-liveness") else
            if eq(len(anyHeartbeat), 0) then nmrr-unavailable(modelId, nowEpoch, "owner-command-heartbeat-absent-or-stale", "native-model.owner-command-heartbeat") else
            if eq(len(heartbeat), 0) then nmrr-unavailable(modelId, nowEpoch, "owner-liveness-heartbeat-mismatch", "native-model.owner-binding") else
            if eq(len(model), 0) then nmrr-unavailable(modelId, nowEpoch, "model-sample-absent-or-stale", str_concat("native-model.owner-snapshot.", modelId)) else
            if or(eq(len(loaded), 0), eq(len(prefilled), 0)) then nmrr-unavailable(modelId, nowEpoch, "loaded-or-prefilled-state-absent-or-stale", str_concat("native-model.state.loaded-prefilled.", modelId)) else
            if not(and(eq(nmrr-same-handle?(model, loaded), 1), eq(nmrr-same-handle?(model, prefilled), 1))) then nmrr-unavailable(modelId, nowEpoch, "model-state-handle-mismatch", str_concat("native-model.state.handle-correlation.", modelId)) else
            nmrr-derived(modelId, if and(eq(nmrr-state-enabled?(loaded), 1), eq(nmrr-state-enabled?(prefilled), 1)) then 1 else 0, nowEpoch, if and(eq(nmrr-state-enabled?(loaded), 1), eq(nmrr-state-enabled?(prefilled), 1)) then "current-owner-retained-route-ready" else "current-owner-retained-route-not-ready");
        }

        def nmrr-model-route-current(snapshot, nowEpoch, modelId) {
            let samples = fgtm-snapshot-samples(snapshot);
            let heartbeat = nmrr-find-kind(samples, "owner-heartbeat");
            let model = if eq(len(heartbeat), 0) then list() else nmrr-retained-id(samples, modelId, heartbeat);
            let loaded = if eq(len(heartbeat), 0) then list() else nmrr-retained-state-at(samples, modelId, "loaded", heartbeat);
            let prefilled = if eq(len(heartbeat), 0) then list() else nmrr-retained-state-at(samples, modelId, "prefilled", heartbeat);
            if not(eq(nmrr-owner-heartbeat-current?(snapshot, heartbeat), 1)) then nmrr-unavailable(modelId, nowEpoch, "owner-command-heartbeat-absent-or-stale", "native-model.owner-command-heartbeat") else
            if eq(len(model), 0) then nmrr-unavailable(modelId, nowEpoch, "model-sample-absent", str_concat("native-model.owner-snapshot.", modelId)) else
            if or(eq(len(loaded), 0), eq(len(prefilled), 0)) then nmrr-unavailable(modelId, nowEpoch, "loaded-or-prefilled-state-absent", str_concat("native-model.state.loaded-prefilled.", modelId)) else
            if not(and(eq(nmrr-same-handle?(model, loaded), 1), eq(nmrr-same-handle?(model, prefilled), 1))) then nmrr-unavailable(modelId, nowEpoch, "model-state-handle-mismatch", str_concat("native-model.state.handle-correlation.", modelId)) else
            nmrr-derived(modelId, if and(eq(nmrr-state-enabled?(loaded), 1), eq(nmrr-state-enabled?(prefilled), 1)) then 1 else 0, nowEpoch, if and(eq(nmrr-state-enabled?(loaded), 1), eq(nmrr-state-enabled?(prefilled), 1)) then "current-owner-retained-route-ready" else "current-owner-retained-route-not-ready");
        }
        def nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, modelId) = if not(eq(fgtm-snapshot-valid?(snapshot), 1)) then nmrr-unavailable(modelId, nowEpoch, "owner-snapshot-invalid-or-absent", "glass.native-model-owner.snapshot") else if not(eq(ownerAlive, 1)) then nmrr-unavailable(modelId, nowEpoch, "owner-process-not-current", "host.process.owner-liveness") else if not(str_eq(ownerBinding, "exact-snapshot-owner")) then nmrr-unavailable(modelId, nowEpoch, "owner-snapshot-unbound", "native-model.owner-binding") else nmrr-model-route-current(snapshot, nowEpoch, modelId);

        def nmrr-parallel-route(qwenFact, threebFact, observedEpoch) = if not(and(eq(nmrr-fact-valid?(qwenFact), 1), eq(nmrr-fact-valid?(threebFact), 1))) then nmrr-unavailable("models.parallel-ready", observedEpoch, "route-fact-invalid", "native-model.route-fact") else if not(and(eq(nmrr-fact-present?(qwenFact), 1), eq(nmrr-fact-present?(threebFact), 1))) then nmrr-unavailable("models.parallel-ready", observedEpoch, "one-or-more-routes-unavailable", "native-model.route.qwen-and-3b") else nmrr-derived("models.parallel-ready", if and(eq(nmrr-fact-value(qwenFact), 1), eq(nmrr-fact-value(threebFact), 1)) then 1 else 0, observedEpoch, if and(eq(nmrr-fact-value(qwenFact), 1), eq(nmrr-fact-value(threebFact), 1)) then "both-contexts-current-owner-retained" else "one-or-more-routes-not-ready");
        def nmrr-last-handle-valid(snapshot, modelId) {
            let sample = nmrr-find-id(fgtm-snapshot-samples(snapshot), modelId);
            if eq(nmrr-positive-handle?(sample), 1) then fgtm-sample-handle(sample) else fgtm-absent();
        }
        def nmrr-last-handle(snapshot, modelId) = if not(eq(fgtm-snapshot-valid?(snapshot), 1)) then fgtm-absent() else nmrr-last-handle-valid(snapshot, modelId);
        def nmrr-assess(snapshot, ownerAlive, ownerBinding, nowEpoch, qwenId, threebId) {
            let qwen = nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, qwenId);
            let threeb = nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, threebId);
            let publisher = if eq(fgtm-snapshot-valid?(snapshot), 1) then fgtm-snapshot-publisher(snapshot) else "unavailable";
            list("native-model-route-assessment-v1", publisher, nmrr-snapshot-age(snapshot, nowEpoch), ownerAlive, ownerBinding, nmrr-last-handle(snapshot, qwenId), nmrr-last-handle(snapshot, threebId), qwen, threeb, nmrr-parallel-route(qwen, threeb, nowEpoch));
        }
    }
    0;
}
