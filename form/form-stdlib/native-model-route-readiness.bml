//////////////////////////////////////////////////////////////////////
//
// native-model-route-readiness.bml — executable current-route truth.
//
// Authority: form-stdlib/bml/native-model-route-readiness.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelRouteReadinessAuthority {
        field NMRRAuthorityPath = "form/form-stdlib/bml/native-model-route-readiness.bml";
        field NMRRAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelRouteReadiness {
        field NMRRSchema = "native-model-route-readiness-v2";
        field NMRROwnerLivenessId = "process.native-model-dual-resident";
        ref nmrr-authority = NativeModelRouteReadinessAuthority;
        thought nmrr-law = list("mapped-is-not-callable", "last-handle-is-not-current-readiness", "current-exact-owner-liveness", "aged-state-does-not-renew", "matching-owner-scoped-loaded-and-prefilled-handles", "parallel-availability-is-not-simultaneous-dispatch", "every-unavailable-fact-names-one-missing-door");

        def nmrr-fact(id, present, value, evidence, observedEpoch, reason, missingDoor) = list(NMRRSchema(), id, present, value, evidence, observedEpoch, reason, missingDoor);
        def nmrr-fact-id(fact) = fact[1];
        def nmrr-fact-present?(fact) = fact[2];
        def nmrr-fact-value(fact) = fact[3];
        def nmrr-fact-evidence(fact) = fact[4];
        def nmrr-fact-observed(fact) = fact[5];
        def nmrr-fact-reason(fact) = fact[6];
        def nmrr-fact-missing-door(fact) = fact[7];
        def nmrr-unavailable(id, observedEpoch, reason, missingDoor) = nmrr-fact(id, 0, 0, "unavailable", observedEpoch, reason, missingDoor);
        def nmrr-measured(id, value, observedEpoch, reason) = nmrr-fact(id, 1, value, "physical-live", observedEpoch, reason, "");
        def nmrr-derived(id, value, observedEpoch, reason) = nmrr-fact(id, 1, value, "derived-window", observedEpoch, reason, "");
        def nmrr-present-evidence?(evidence) = (String) evidence == "physical-live" ? 1 : (String) evidence == "derived-window" ? 1 : 0;
        def nmrr-fact-valid?(fact) = !((Comparable) len(fact) == 8) ? 0 : !((String) head(fact) == NMRRSchema()) ? 0 : !(((Comparable) nmrr-fact-present?(fact) == 0) || ((Comparable) nmrr-fact-present?(fact) == 1)) ? 0 : nmrr-fact-observed(fact) < 0 ? 0 : (Comparable) nmrr-fact-present?(fact) == 0 ? (((Comparable) nmrr-fact-value(fact) == 0) && (((String) nmrr-fact-evidence(fact) == "unavailable") && (str_len(nmrr-fact-missing-door(fact)) > 0))) : ((((Comparable) nmrr-fact-value(fact) == 0) || ((Comparable) nmrr-fact-value(fact) == 1)) && (((Comparable) nmrr-present-evidence?(nmrr-fact-evidence(fact)) == 1) && ((Comparable) str_len(nmrr-fact-missing-door(fact)) == 0)));

        def nmrr-snapshot-age(snapshot, nowEpoch) = !((Comparable) fgtm-snapshot-valid?(snapshot) == 1) ? -1 : fgtm-snapshot-epoch(snapshot) >= nowEpoch ? 0 : (nowEpoch - fgtm-snapshot-epoch(snapshot));
        def nmrr-find-id(samples, id) = (Comparable) len(samples) == 0 ? list() : (String) fgtm-sample-id(head(samples)) == id ? head(samples) : nmrr-find-id(tail(samples), id);
        def nmrr-find-kind(samples, kind) = (Comparable) len(samples) == 0 ? list() : (String) fgtm-sample-kind(head(samples)) == kind ? head(samples) : nmrr-find-kind(tail(samples), kind);
        def nmrr-find-state(samples, parent, state) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-kind(head(samples)) == "model-state") && (((Comparable) fgtm-field-present?(fgtm-sample-parent(head(samples))) == 1) && (((String) fgtm-field-value(fgtm-sample-parent(head(samples))) == parent) && ((String) fgtm-sample-purpose(head(samples)) == state))) ? head(samples) : nmrr-find-state(tail(samples), parent, state);
        def nmrr-positive-handle?(sample) = (Comparable) len(sample) == 0 ? 0 : !((Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1) ? 0 : (fgtm-field-value(fgtm-sample-handle(sample)) > 0);
        def nmrr-same-handle?(left, right) = !((Comparable) nmrr-positive-handle?(left) == 1) ? 0 : !((Comparable) nmrr-positive-handle?(right) == 1) ? 0 : ((Comparable) fgtm-field-value(fgtm-sample-handle(left)) == fgtm-field-value(fgtm-sample-handle(right)));
        def nmrr-state-enabled?(sample) = (Comparable) len(sample) == 0 ? 0 : ((String) fgtm-sample-lifecycle(sample) == "active");
        def nmrr-owner-heartbeat-current?(snapshot, heartbeat) = (Comparable) len(heartbeat) == 0 ? 0 : !((String) fgtm-sample-owner(heartbeat) == fgtm-snapshot-publisher(snapshot)) ? 0 : !((Comparable) fgtm-field-present?(fgtm-sample-read-epoch(heartbeat)) == 1) ? 0 : ((Comparable) fgtm-field-value(fgtm-sample-read-epoch(heartbeat)) == fgtm-snapshot-epoch(snapshot));

        // Glass has already lease-filtered each publisher snapshot.  This
        // join still requires the independently sampled OS-liveness row to
        // correlate with the owner heartbeat by PID and process start, and
        // retains each state row's own event epoch rather than renewing it at the heartbeat epoch.
        def nmrr-current-physical?(sample) = (Comparable) len(sample) == 0 ? 0 : ((String) fgtm-sample-evidence(sample) == "physical-live");
        def nmrr-retained-state-evidence?(sample) = (Comparable) len(sample) == 0 ? 0 : (String) fgtm-sample-evidence(sample) == "physical-live" ? 1 : (String) fgtm-sample-evidence(sample) == "derived-window" ? 1 : 0;
        def nmrr-same-owner?(sample, heartbeat) = (Comparable) len(sample) == 0 ? 0 : (Comparable) len(heartbeat) == 0 ? 0 : ((String) fgtm-sample-owner(sample) == fgtm-sample-owner(heartbeat));
        def nmrr-sample-observed(sample, fallback) = (Comparable) len(sample) == 0 ? fallback : (Comparable) fgtm-field-present?(fgtm-sample-read-epoch(sample)) == 1 ? fgtm-field-value(fgtm-sample-read-epoch(sample)) : fallback;
        def nmrr-oldest3(a, b, c) = a <= b ? (a <= c ? a : c) : b <= c ? b : c;
        def nmrr-route-observed(model, loaded, prefilled, fallback) = nmrr-oldest3(nmrr-sample-observed(model, fallback), nmrr-sample-observed(loaded, fallback), nmrr-sample-observed(prefilled, fallback));
        def nmrr-present-number-equal?(left, right) = !((Comparable) fgtm-field-present?(left) == 1) ? 0 : !((Comparable) fgtm-field-present?(right) == 1) ? 0 : ((Comparable) fgtm-field-value(left) == fgtm-field-value(right));
        def nmrr-current-owner-liveness(samples) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-id(head(samples)) == NMRROwnerLivenessId()) && (((Comparable) nmrr-current-physical?(head(samples)) == 1) && (((String) fgtm-sample-lifecycle(head(samples)) == "active") && ((String) fgtm-sample-purpose(head(samples)) == "os-process-lifetime-current"))) ? head(samples) : nmrr-current-owner-liveness(tail(samples));
        def nmrr-retained-owner-heartbeat(samples) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-kind(head(samples)) == "owner-heartbeat") && ((Comparable) nmrr-retained-state-evidence?(head(samples)) == 1) ? head(samples) : nmrr-retained-owner-heartbeat(tail(samples));
        def nmrr-correlated-owner-heartbeat(samples, liveness) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-kind(head(samples)) == "owner-heartbeat") && (((Comparable) nmrr-retained-state-evidence?(head(samples)) == 1) && (((Comparable) nmrr-present-number-equal?(fgtm-sample-handle(head(samples)), fgtm-sample-handle(liveness)) == 1) && ((Comparable) nmrr-present-number-equal?(fgtm-sample-write-epoch(head(samples)), fgtm-sample-write-epoch(liveness)) == 1))) ? head(samples) : nmrr-correlated-owner-heartbeat(tail(samples), liveness);
        def nmrr-retained-id(samples, id, heartbeat) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-id(head(samples)) == id) && (((Comparable) nmrr-retained-state-evidence?(head(samples)) == 1) && ((Comparable) nmrr-same-owner?(head(samples), heartbeat) == 1)) ? head(samples) : nmrr-retained-id(tail(samples), id, heartbeat);
        def nmrr-retained-state-at(samples, parent, state, heartbeat) = (Comparable) len(samples) == 0 ? list() : ((String) fgtm-sample-kind(head(samples)) == "model-state") && (((Comparable) nmrr-retained-state-evidence?(head(samples)) == 1) && (((Comparable) nmrr-same-owner?(head(samples), heartbeat) == 1) && (((Comparable) fgtm-field-present?(fgtm-sample-parent(head(samples))) == 1) && (((String) fgtm-field-value(fgtm-sample-parent(head(samples))) == parent) && ((String) fgtm-sample-purpose(head(samples)) == state))))) ? head(samples) : nmrr-retained-state-at(tail(samples), parent, state, heartbeat);
        def nmrr-model-route-from-current-samples(samples, nowEpoch, modelId) {
            let liveness = nmrr-current-owner-liveness(samples);
            let anyHeartbeat = nmrr-retained-owner-heartbeat(samples);
            let heartbeat = (Comparable) len(liveness) == 0 ? list() : nmrr-correlated-owner-heartbeat(samples, liveness);
            let model = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-id(samples, modelId, heartbeat);
            let loaded = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-state-at(samples, modelId, "loaded", heartbeat);
            let prefilled = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-state-at(samples, modelId, "prefilled", heartbeat);
            (Comparable) len(liveness) == 0 ? nmrr-unavailable(modelId, nowEpoch, "owner-process-liveness-absent-or-stale", "host.process.owner-liveness") :
            (Comparable) len(anyHeartbeat) == 0 ? nmrr-unavailable(modelId, nowEpoch, "owner-command-heartbeat-absent-or-stale", "native-model.owner-command-heartbeat") :
            (Comparable) len(heartbeat) == 0 ? nmrr-unavailable(modelId, nowEpoch, "owner-liveness-heartbeat-mismatch", "native-model.owner-binding") :
            (Comparable) len(model) == 0 ? nmrr-unavailable(modelId, nowEpoch, "model-sample-absent-or-stale", "native-model.owner-snapshot." ++ modelId) :
            ((Comparable) len(loaded) == 0) || ((Comparable) len(prefilled) == 0) ? nmrr-unavailable(modelId, nowEpoch, "loaded-or-prefilled-state-absent-or-stale", "native-model.state.loaded-prefilled." ++ modelId) :
            !(((Comparable) nmrr-same-handle?(model, loaded) == 1) && ((Comparable) nmrr-same-handle?(model, prefilled) == 1)) ? nmrr-unavailable(modelId, nowEpoch, "model-state-handle-mismatch", "native-model.state.handle-correlation." ++ modelId) :
            nmrr-derived(modelId, ((Comparable) nmrr-state-enabled?(loaded) == 1) && ((Comparable) nmrr-state-enabled?(prefilled) == 1) ? 1 : 0, nmrr-route-observed(model, loaded, prefilled, nowEpoch), ((Comparable) nmrr-state-enabled?(loaded) == 1) && ((Comparable) nmrr-state-enabled?(prefilled) == 1) ? "current-owner-retained-route-ready" : "current-owner-retained-route-not-ready");
        }

        def nmrr-model-route-current(snapshot, nowEpoch, modelId) {
            let samples = fgtm-snapshot-samples(snapshot);
            let heartbeat = nmrr-find-kind(samples, "owner-heartbeat");
            let model = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-id(samples, modelId, heartbeat);
            let loaded = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-state-at(samples, modelId, "loaded", heartbeat);
            let prefilled = (Comparable) len(heartbeat) == 0 ? list() : nmrr-retained-state-at(samples, modelId, "prefilled", heartbeat);
            !((Comparable) nmrr-owner-heartbeat-current?(snapshot, heartbeat) == 1) ? nmrr-unavailable(modelId, nowEpoch, "owner-command-heartbeat-absent-or-stale", "native-model.owner-command-heartbeat") :
            (Comparable) len(model) == 0 ? nmrr-unavailable(modelId, nowEpoch, "model-sample-absent", "native-model.owner-snapshot." ++ modelId) :
            ((Comparable) len(loaded) == 0) || ((Comparable) len(prefilled) == 0) ? nmrr-unavailable(modelId, nowEpoch, "loaded-or-prefilled-state-absent", "native-model.state.loaded-prefilled." ++ modelId) :
            !(((Comparable) nmrr-same-handle?(model, loaded) == 1) && ((Comparable) nmrr-same-handle?(model, prefilled) == 1)) ? nmrr-unavailable(modelId, nowEpoch, "model-state-handle-mismatch", "native-model.state.handle-correlation." ++ modelId) :
            nmrr-derived(modelId, ((Comparable) nmrr-state-enabled?(loaded) == 1) && ((Comparable) nmrr-state-enabled?(prefilled) == 1) ? 1 : 0, nmrr-route-observed(model, loaded, prefilled, nowEpoch), ((Comparable) nmrr-state-enabled?(loaded) == 1) && ((Comparable) nmrr-state-enabled?(prefilled) == 1) ? "current-owner-retained-route-ready" : "current-owner-retained-route-not-ready");
        }
        def nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, modelId) = !((Comparable) fgtm-snapshot-valid?(snapshot) == 1) ? nmrr-unavailable(modelId, nowEpoch, "owner-snapshot-invalid-or-absent", "glass.native-model-owner.snapshot") : !((Comparable) ownerAlive == 1) ? nmrr-unavailable(modelId, nowEpoch, "owner-process-not-current", "host.process.owner-liveness") : !((String) ownerBinding == "exact-snapshot-owner") ? nmrr-unavailable(modelId, nowEpoch, "owner-snapshot-unbound", "native-model.owner-binding") : nmrr-model-route-current(snapshot, nowEpoch, modelId);

        def nmrr-parallel-route(qwenFact, threebFact, observedEpoch) = !(((Comparable) nmrr-fact-valid?(qwenFact) == 1) && ((Comparable) nmrr-fact-valid?(threebFact) == 1)) ? nmrr-unavailable("models.parallel-ready", observedEpoch, "route-fact-invalid", "native-model.route-fact") : !(((Comparable) nmrr-fact-present?(qwenFact) == 1) && ((Comparable) nmrr-fact-present?(threebFact) == 1)) ? nmrr-unavailable("models.parallel-ready", observedEpoch, "one-or-more-routes-unavailable", "native-model.route.qwen-and-3b") : nmrr-derived("models.parallel-ready", ((Comparable) nmrr-fact-value(qwenFact) == 1) && ((Comparable) nmrr-fact-value(threebFact) == 1) ? 1 : 0, nmrr-fact-observed(qwenFact) <= nmrr-fact-observed(threebFact) ? nmrr-fact-observed(qwenFact) : nmrr-fact-observed(threebFact), ((Comparable) nmrr-fact-value(qwenFact) == 1) && ((Comparable) nmrr-fact-value(threebFact) == 1) ? "both-contexts-current-owner-retained" : "one-or-more-routes-not-ready");
        def nmrr-last-handle-valid(snapshot, modelId) {
            let sample = nmrr-find-id(fgtm-snapshot-samples(snapshot), modelId);
            (Comparable) nmrr-positive-handle?(sample) == 1 ? fgtm-sample-handle(sample) : fgtm-absent();
        }
        def nmrr-last-handle(snapshot, modelId) = !((Comparable) fgtm-snapshot-valid?(snapshot) == 1) ? fgtm-absent() : nmrr-last-handle-valid(snapshot, modelId);
        def nmrr-assess(snapshot, ownerAlive, ownerBinding, nowEpoch, qwenId, threebId) {
            let qwen = nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, qwenId);
            let threeb = nmrr-model-route(snapshot, ownerAlive, ownerBinding, nowEpoch, threebId);
            let publisher = (Comparable) fgtm-snapshot-valid?(snapshot) == 1 ? fgtm-snapshot-publisher(snapshot) : "unavailable";
            list("native-model-route-assessment-v1", publisher, nmrr-snapshot-age(snapshot, nowEpoch), ownerAlive, ownerBinding, nmrr-last-handle(snapshot, qwenId), nmrr-last-handle(snapshot, threebId), qwen, threeb, nmrr-parallel-route(qwen, threeb, nowEpoch));
        }
    }
    0;
}
