; nl-form-metal-token-weave-live.fk — print the weave so a human can watch it.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk form-stdlib/nl-form-metal-token-weave.fk

(do
    (defn nfw-show (w)
        (str_concat (nfw-w-nl w)
        (str_concat " | found=" (str_concat (int_to_str (nfw-w-found w))
        (str_concat " op=" (str_concat (nfw-w-op w)
        (str_concat " value=" (str_concat (int_to_str (nfw-w-value w))
        (str_concat " kind=" (str_concat (nfw-w-kind w)
        (str_concat " recipe=" (str_concat (nfw-w-recipe w)
        (str_concat " blueprint=" (str_concat (nfw-w-blueprint w)
        (str_concat " cell=" (str_concat (nfw-w-cell w)
        (str_concat " verdict=" (str_concat (int_to_str (nfw-w-verdict w))
        (str_concat " surface=" (str_concat (nfw-w-surface w)
        (str_concat " crossed=" (int_to_str (nfw-w-crossed w)))))))))))))))))))))))

    (print "nfw-live square: ")
    (print (nfw-show (nfw-walk "the square of 7" (empty))))
    (print "\n")
    (print "nfw-live kernel: ")
    (print (nfw-show (nfw-walk "emit matvec kernel" (empty))))
    (print "\n")
    (print "nfw-live cell-card: ")
    (print (nfw-show (nfw-walk "retrieve cell-card" (empty))))
    (print "\n")
    (print "nfw-live miss: ")
    (print (nfw-show (nfw-walk "what is the capital of France" (empty))))
    (print "\n")
    (print "nfw-live home: ")
    (print (nfw-show (nfw-walk "what is the capital of France" (list (nfw-teacher-france)))))
    (print "\n")
    (print "nfw-live disk-gguf surface=")
    (print (nfw-surface "disk-gguf"))
    (print " crossed=")
    (print (int_to_str (nfw-crossed? (nfw-surface "disk-gguf"))))
    (print "\n")
    (print "nfw-live kernel-swap token=")
    (print (int_to_str (dtrs-choice-token (nfw-pick-kernel))))
    (print " reason=")
    (print (dtrs-choice-reason (nfw-pick-kernel)))
    (print "\n")
    (print "nfw-live late-swap token=")
    (print (int_to_str (dtrs-choice-token (nfw-pick-late))))
    (print " state=")
    (print (dtrs-choice-alternative-state (nfw-pick-late)))
    (print "\n")
    (print "nfw-live check=")
    (print (int_to_str (nfw-check)))
    (print "\n")
    0)
