; living-world-tending.fk -- recurrence proposes; the field acknowledges.
;
; This is the second movement of the axiom-born world organ.  A bounded stream
; carries ordinary living-world offers and their offered action cells.  The
; stream is received through the existing consent membrane, then the organ
; observes exact recurrence: one content-addressed payload held by multiple
; active source attributions.  Recurrence may mint a proposal, never authority.
;
; The candidate's witnesses are the active attributions themselves.  Its
; coherence and resonance readings are therefore exact local counts, not an
; imported score or remote judgment.  Every participating source can offer a
; content-addressed response.  ONE acknowledges, ZERO dissents, NOTHING is an
; explicit abstention; absence remains missing.  Dissent dominates, missing or
; silence waits, and only unanimous active ONE responses may integrate the
; candidate.  Integration mints one candidate attribution per acknowledging
; participant, so the organ cannot own what the field did not authorize.
;
; Responses are ordinary offered cells.  Their source is never trusted from
; response payload: it is recovered from the living world's consented
; attribution edge.  A response may be revoked through that same edge, causing
; a new outcome while the earlier round remains content-addressed and intact.
;
; Honest floor: recurrence is exact-present-shape recurrence.  Structural
; resonance across different shapes, autonomous candidate search, durable
; process continuity, and natural-language expression remain next movements.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk

(let LWT-ENTRY               (bp "LWT-ENTRY"))
(let LWT-ROUND               (bp "LWT-ROUND"))
(let LWT-ORIGIN              (bp "LWT-ORIGIN"))
(let LWT-PROPOSAL            (bp "LWT-PROPOSAL"))
(let LWT-RESPONSE            (bp "LWT-RESPONSE"))
(let LWT-RESPONSE-DERIVATION (bp "LWT-RESPONSE-DERIVATION"))
(let LWT-OUTCOME             (bp "LWT-OUTCOME"))
(let LWT-ACKNOWLEDGED        (bp "LWT-ACKNOWLEDGED"))
(let LWT-DISSENTED           (bp "LWT-DISSENTED"))
(let LWT-WAITING             (bp "LWT-WAITING"))

; --- bounded input stream -------------------------------------------------
(defn lwt-entry (offer action) (intern_node LWT-ENTRY (list offer action)))
(defn lwt-entry-offer  (entry) (nth (node_children entry) 0))
(defn lwt-entry-action (entry) (nth (node_children entry) 1))

(defn lwt-receive-stream (world entries)
    (if (eq (len entries) 0) world
        (do
            (let transition
                (lwo-receive world
                    (lwt-entry-offer (head entries))
                    (lwt-entry-action (head entries))))
            (lwt-receive-stream (lwo-transition-world transition)
                                (tail entries)))))

; --- recurrence-derived proposals ----------------------------------------
(defn lwt-origin (world payload attributions)
    (intern_node LWT-ORIGIN (list world payload attributions)))

(defn lwt-sources-from-attributions (items acc)
    (if (eq (len items) 0) acc
        (lwt-sources-from-attributions (tail items)
            (lwo-field-add acc (lwo-attribution-source (head items))))))

(defn lwt-proposal (candidate participants origin)
    (intern_node LWT-PROPOSAL (list candidate participants origin)))
(defn lwt-proposal-candidate    (proposal) (nth (node_children proposal) 0))
(defn lwt-proposal-participants (proposal) (nth (node_children proposal) 1))
(defn lwt-proposal-origin       (proposal) (nth (node_children proposal) 2))

(defn lwt-proposal? (cell) (lwo-category? cell LWT-PROPOSAL))

(defn lwt-proposal-for (world payload threshold)
    (do
        (let attributions (lwo-active-attributions-for world payload))
        (if (or (eq (lwo-active? world payload) 0)
                (lt (lwo-field-size attributions) threshold))
            (lwo-none)
            (do
                (let count (lwo-field-size attributions))
                (let origin (lwt-origin world payload attributions))
                (let candidate
                    (lwo-emergent payload attributions
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int threshold)
                        origin))
                (let participants
                    (lwt-sources-from-attributions
                        (lwo-field-items attributions) (lwo-empty-field)))
                (lwt-proposal candidate participants origin)))))

(defn lwt-proposals-from-items (world items threshold acc)
    (if (eq (len items) 0) acc
        (do
            (let proposal (lwt-proposal-for world (head items) threshold))
            (let next
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal)))
            (lwt-proposals-from-items world (tail items) threshold next))))

(defn lwt-proposals (world threshold)
    (lwt-proposals-from-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

; --- tending round --------------------------------------------------------
; children: world, proposals, outcomes, prior-round
(defn lwt-round (world proposals outcomes prior)
    (intern_node LWT-ROUND (list world proposals outcomes prior)))
(defn lwt-round-world     (round) (nth (node_children round) 0))
(defn lwt-round-proposals (round) (nth (node_children round) 1))
(defn lwt-round-outcomes  (round) (nth (node_children round) 2))
(defn lwt-round-prior     (round) (nth (node_children round) 3))

(defn lwt-tend (world entries recurrence-threshold prior)
    (do
        (let received (lwt-receive-stream world entries))
        (lwt-round received (lwt-proposals received recurrence-threshold)
                   (lwo-empty-field) prior)))

(defn lwt-round-receive (round entries)
    (lwt-round
        (lwt-receive-stream (lwt-round-world round) entries)
        (lwt-round-proposals round)
        (lwo-empty-field)
        round))

; --- acknowledgment, dissent, silence, and missing -----------------------
; Source identity is deliberately absent.  The source is the attribution edge
; created when this response crosses the ordinary offer membrane.
(defn lwt-response (proposal ack provenance)
    (intern_node LWT-RESPONSE (list proposal ack provenance)))
(defn lwt-response-proposal (response) (nth (node_children response) 0))
(defn lwt-response-ack      (response) (nth (node_children response) 1))
(defn lwt-response? (cell) (lwo-category? cell LWT-RESPONSE))

(defn lwt-response-for? (cell proposal)
    (if (and (eq (lwt-response? cell) 1)
             (node_eq (lwt-response-proposal cell) proposal)) 1 0))

; status: 0 missing, 1 explicit NOTHING, 2 ONE, 3 ZERO.  Dissent is checked
; last and dominates any contradictory response by the same source.
(defn lwt-source-response-status-items
    (world items proposal source saw-nothing saw-one saw-zero)
    (if (eq (len items) 0)
        (if (eq saw-zero 1) 3
            (if (eq saw-one 1) 2
                (if (eq saw-nothing 1) 1 0)))
        (do
            (let response (head items))
            ; Shape first: eager and would ask the global attribution field
            ; about every unrelated cell.
            (if (eq (lwt-response-for? response proposal) 0)
                (lwt-source-response-status-items world (tail items)
                    proposal source saw-nothing saw-one saw-zero)
                (if (eq (lwo-active-by? world response source) 0)
                    (lwt-source-response-status-items world (tail items)
                        proposal source saw-nothing saw-one saw-zero)
                    (do
                        (let ack (lwt-response-ack response))
                        (lwt-source-response-status-items world (tail items)
                            proposal source
                            (if (eq (oac-nothing? ack) 1) 1 saw-nothing)
                            (if (eq (oac-one? ack) 1) 1 saw-one)
                            (if (eq (oac-zero? ack) 1) 1 saw-zero))))))))

(defn lwt-source-response-status (world proposal source)
    (lwt-source-response-status-items world
        (lwo-field-items (lwo-world-cells world)) proposal source 0 0 0))

; counts: yes, no, explicit-silence, missing
(defn lwt-response-counts (world proposal sources yes no silence missing)
    (if (eq (len sources) 0) (list yes no silence missing)
        (do
            (let status
                (lwt-source-response-status world proposal (head sources)))
            (lwt-response-counts world proposal (tail sources)
                (if (eq status 2) (add yes 1) yes)
                (if (eq status 3) (add no 1) no)
                (if (eq status 1) (add silence 1) silence)
                (if (eq status 0) (add missing 1) missing)))))

(defn lwt-response-derivation (response attributions)
    (intern_node LWT-RESPONSE-DERIVATION (list response attributions)))
(defn lwt-response-derivation-response (derivation)
    (nth (node_children derivation) 0))
(defn lwt-response-derivation-attributions (derivation)
    (nth (node_children derivation) 1))

(defn lwt-response-derivations-items (world items proposal acc)
    (if (eq (len items) 0) acc
        (do
            (let response (head items))
            (if (eq (lwt-response-for? response proposal) 0)
                (lwt-response-derivations-items
                    world (tail items) proposal acc)
                (do
                    ; One exact attribution snapshot proves both activity and
                    ; the source-local derivation.  Avoid a separate active?
                    ; scan before collecting the same attributions again.
                    (let attributions
                        (lwo-active-attributions-for world response))
                    (if (eq (lwo-field-size attributions) 0)
                        (lwt-response-derivations-items
                            world (tail items) proposal acc)
                        (lwt-response-derivations-items
                            world (tail items) proposal
                            (lwo-field-add acc
                                (lwt-response-derivation
                                    response attributions)))))))))

(defn lwt-response-derivations (world proposal)
    (lwt-response-derivations-items world
        (lwo-field-items (lwo-world-cells world)) proposal
        (lwo-empty-field)))

(defn lwt-attributions-held-by? (items source)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwo-attribution-source (head items)) source) 1
            (lwt-attributions-held-by? (tail items) source))))

; status: 0 missing, 1 explicit NOTHING, 2 ONE, 3 ZERO.  The derivation
; snapshot contains every active response attribution exactly once.  Reuse it
; for every participant instead of rescanning the whole world and attribution
; field once per participant.  ZERO still dominates ONE, which dominates
; explicit NOTHING for contradictory responses from one source.
(defn lwt-source-status-from-derivations
    (items source saw-nothing saw-one saw-zero)
    (if (eq (len items) 0)
        (if (eq saw-zero 1) 3
            (if (eq saw-one 1) 2
                (if (eq saw-nothing 1) 1 0)))
        (do
            (let derivation (head items))
            (if (eq (lwt-attributions-held-by?
                        (lwo-field-items
                            (lwt-response-derivation-attributions derivation))
                        source) 0)
                (lwt-source-status-from-derivations
                    (tail items) source saw-nothing saw-one saw-zero)
                (do
                    (let ack
                        (lwt-response-ack
                            (lwt-response-derivation-response derivation)))
                    (lwt-source-status-from-derivations
                        (tail items) source
                        (if (eq (oac-nothing? ack) 1) 1 saw-nothing)
                        (if (eq (oac-one? ack) 1) 1 saw-one)
                        (if (eq (oac-zero? ack) 1) 1 saw-zero)))))))

(defn lwt-response-counts-from-derivations
    (derivations sources yes no silence missing)
    (if (eq (len sources) 0) (list yes no silence missing)
        (do
            (let status
                (lwt-source-status-from-derivations
                    derivations (head sources) 0 0 0))
            (lwt-response-counts-from-derivations
                derivations (tail sources)
                (if (eq status 2) (add yes 1) yes)
                (if (eq status 3) (add no 1) no)
                (if (eq status 1) (add silence 1) silence)
                (if (eq status 0) (add missing 1) missing)))))

(defn lwt-status-acknowledged () (intern_node LWT-ACKNOWLEDGED (empty)))
(defn lwt-status-dissented    () (intern_node LWT-DISSENTED (empty)))
(defn lwt-status-waiting      () (intern_node LWT-WAITING (empty)))

; children: proposal, yes, no, explicit-silence, missing, status, derivations
(defn lwt-outcome
    (proposal yes no silence missing status derivations)
    (intern_node LWT-OUTCOME
        (list proposal (intern_trivial_int yes) (intern_trivial_int no)
              (intern_trivial_int silence) (intern_trivial_int missing)
              status derivations)))

(defn lwt-outcome-proposal    (outcome) (nth (node_children outcome) 0))
(defn lwt-outcome-yes         (outcome) (node_value (nth (node_children outcome) 1)))
(defn lwt-outcome-no          (outcome) (node_value (nth (node_children outcome) 2)))
(defn lwt-outcome-silence     (outcome) (node_value (nth (node_children outcome) 3)))
(defn lwt-outcome-missing     (outcome) (node_value (nth (node_children outcome) 4)))
(defn lwt-outcome-status      (outcome) (nth (node_children outcome) 5))
(defn lwt-outcome-derivations (outcome) (nth (node_children outcome) 6))

(defn lwt-evaluate-proposal (world proposal)
    (do
        (let participants (lwt-proposal-participants proposal))
        (let derivations (lwt-response-derivations world proposal))
        (let counts
            (lwt-response-counts-from-derivations
                (lwo-field-items derivations)
                (lwo-field-items participants) 0 0 0 0))
        (let yes (nth counts 0))
        (let no (nth counts 1))
        (let silence (nth counts 2))
        (let missing (nth counts 3))
        (let status
            (if (gt no 0) (lwt-status-dissented)
                (if (and (eq missing 0)
                         (and (eq silence 0)
                              (eq yes (lwo-field-size participants))))
                    (lwt-status-acknowledged)
                    (lwt-status-waiting))))
        (lwt-outcome proposal yes no silence missing status derivations)))

(defn lwt-evaluate-items (world proposals acc)
    (if (eq (len proposals) 0) acc
        (lwt-evaluate-items world (tail proposals)
            (lwo-field-add acc
                (lwt-evaluate-proposal world (head proposals))))))

(defn lwt-evaluate-round (round)
    (lwt-round (lwt-round-world round) (lwt-round-proposals round)
        (lwt-evaluate-items (lwt-round-world round)
            (lwo-field-items (lwt-round-proposals round))
            (lwo-empty-field))
        round))

(defn lwt-outcome-for-items (items proposal)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwt-outcome-proposal (head items)) proposal)
            (head items)
            (lwt-outcome-for-items (tail items) proposal))))

(defn lwt-outcome-for (round proposal)
    (lwt-outcome-for-items (lwo-field-items (lwt-round-outcomes round)) proposal))

; --- unanimously authorized integration ---------------------------------
(defn lwt-integration-fields
    (sources candidate action provenance attributions events)
    (if (eq (len sources) 0) (list attributions events)
        (do
            (let source (head sources))
            (let ack (oac-one candidate))
            (lwt-integration-fields (tail sources)
                candidate action provenance
                (lwo-field-add attributions
                    (lwo-attribution candidate source provenance))
                (lwo-field-add events
                    (lwo-boundary-event source action ack))))))

; Tending proposals always carry LWO-EMERGENT candidates.  After unanimous
; evaluation and readiness have succeeded, every participant crosses the same
; valid normal-offer membrane with the same candidate, action, and provenance.
; Build those exact per-source attributions and boundary events once, then
; intern one successor world.  This is identity-equivalent to rebuilding the
; whole world once per participant, while keeping every source and receipt.
(defn lwt-integrate-sources (world sources candidate action provenance)
    (do
        (let fields
            (lwt-integration-fields sources candidate action provenance
                (lwo-world-attributions world) (lwo-world-events world)))
        (lwo-world
            (lwo-field-add (lwo-world-cells world) candidate)
            (lwo-world-relations world)
            (nth fields 0)
            (lwo-world-revocations world)
            (nth fields 1))))

(defn lwt-integrate (round proposal action)
    (do
        (let outcome (lwt-evaluate-proposal (lwt-round-world round) proposal))
        (let candidate (lwt-proposal-candidate proposal))
        (if (and (node_eq (lwt-outcome-status outcome)
                          (lwt-status-acknowledged))
                 (eq (lwo-emergent-ready? (lwt-round-world round) candidate) 1))
            (lwt-round
                (lwt-integrate-sources (lwt-round-world round)
                    (lwo-field-items (lwt-proposal-participants proposal))
                    candidate action outcome)
                (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome)
                round)
            (lwt-round (lwt-round-world round)
                       (lwt-round-proposals round)
                       (lwo-field-add (lwo-empty-field) outcome)
                       round))))

0
