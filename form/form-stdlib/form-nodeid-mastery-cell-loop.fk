// form-nodeid-mastery-cell-loop.fk -- a public-source NodeID becomes a
// teachable, observable cell movement rather than a coverage integer.
//
// A mastery cell retains concept/source/entry identity, the attempt and request
// that met it, execution and answer observation, surprise/failure signals,
// lifecycle, bounded timeout, optional persistence, and the identities offered
// for a later cell/channel/mesh continuation.  Channel and mesh identities are
// carried with transported=0: this mechanism does not claim a crossing.
//
// A resident decoder may emit, as decoded bytes:
//   <|form:mastery-thought|>concept=KEY;attempt=LABEL<|/form:mastery-thought|>
// The immutable BMF cursor consumes those bytes with finite fuel.  No token
// list, vocabulary pass, flattening, operations table, C seed, model call, or
// native execution occurs here.
//
// `fmcl-retrieve-with` and `fmcl-execute-with` accept generic callbacks.  A
// callback returns typed evidence; it never gains authority merely by being
// called. `model-executed` is 0 unless execution evidence contains both the
// literal flag 1 and a supplied local-Qwen observation NodeID.  The mechanism
// cannot prove the physical provenance of that supplied observation; the live
// boundary must do so and receipt it.
//
// Present verdict 0, present verdict 1, and `nothing` are separate: presence is
// stored independently and `fmcl-observed-verdict` returns real `nothing` when
// no verdict arrived.
//
// This is an offered mechanism for learning, not a law or enforcement gate.
//
// categories 31.2.0.108..119:
// concept, attempt, request, execution, observation, signal, lifecycle, state,
// continuation, channel, mesh, persistence.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/bmf-core.fk
// preludes: form-stdlib/form-nodeid-mastery-cell-categories.fk
section [form.bml] {
    def fmcl-absent() = intern_trivial_string("fmcl:nothing");
    def fmcl-node-or-absent(node) = nothing?(node) ? fmcl-absent() : node;
    def fmcl-node-absent?(node) = node_eq(node, fmcl-absent());
    def fmcl-node-or-nothing(node) = (Comparable) fmcl-node-absent?(node) == 1 ? nothing() : node;
    // -- carried continuation, channel, mesh, persistence -------------
    def fmcl-channel(protocol, identity) = intern_node(fmcl-channel-category(), [intern_trivial_string(protocol), intern_trivial_string(identity), intern_trivial_int(0)]);
    def fmcl-channel-transported?(channel) = node_value(node_children(channel)[2]);
    def fmcl-mesh(identity, lenses) = intern_node(fmcl-mesh-category(), [intern_trivial_string(identity), intern_trivial_string(lenses), intern_trivial_int(0), intern_trivial_int(0)]);
    def fmcl-mesh-transported?(mesh) = node_value(node_children(mesh)[2]);
    def fmcl-mesh-broadcast?(mesh) = node_value(node_children(mesh)[3]);
    def fmcl-persistence-off() = intern_node(fmcl-persistence-category(), [intern_trivial_string("off"), intern_trivial_string(""), intern_trivial_int(0), intern_trivial_int(0), fmcl-absent()]);
    def fmcl-persistence-offer(target) = intern_node(fmcl-persistence-category(), [intern_trivial_string("offered"), intern_trivial_string(target), intern_trivial_int(1), intern_trivial_int(0), fmcl-absent()]);
    def fmcl-persistence-requested?(p) = node_value(node_children(p)[2]);
    def fmcl-persistence-observed?(p) = node_value(node_children(p)[3]);
    // This records a supplied observation; it performs no write.
    def fmcl-persistence-from-observation(p, observation) = nothing?(observation) ? p : intern_node(fmcl-persistence-category(), [intern_trivial_string("observed"), node_children(p)[1], intern_trivial_int(fmcl-persistence-requested?(p)), intern_trivial_int(1), observation]);
    def fmcl-continuation-none(channel, mesh) = intern_node(fmcl-continuation-category(), [fmcl-absent(), fmcl-absent(), channel, mesh, intern_trivial_int(0), intern_trivial_int(0)]);
    def fmcl-continuation(previous, previous-continuation, channel, mesh, generation) = intern_node(fmcl-continuation-category(), [previous, previous-continuation, channel, mesh, intern_trivial_int(generation), intern_trivial_int(0)]);
    def fmcl-continuation-generation(c) = node_value(node_children(c)[4]);
    def fmcl-continuation-transported?(c) = node_value(node_children(c)[5]);
    // -- concept and attempt identity --------------------------------
    def fmcl-concept(key, source, entry) = intern_node(fmcl-concept-category(), [intern_trivial_string(key), fmcl-node-or-absent(source), fmcl-node-or-absent(entry)]);
    def fmcl-concept-key(concept) = node_value(node_children(concept)[0]);
    def fmcl-concept-source(concept) = fmcl-node-or-nothing(node_children(concept)[1]);
    def fmcl-concept-entry(concept) = fmcl-node-or-nothing(node_children(concept)[2]);
    def fmcl-attempt(concept, label, ordinal, parent) = intern_node(fmcl-attempt-category(), [concept, intern_trivial_string(label), intern_trivial_int(ordinal), fmcl-node-or-absent(parent)]);
    def fmcl-attempt-concept(attempt) = node_children(attempt)[0];
    def fmcl-attempt-label(attempt) = node_value(node_children(attempt)[1]);
    def fmcl-attempt-ordinal(attempt) = node_value(node_children(attempt)[2]);
    // -- scannerless mastery-thought request --------------------------
    def fmcl-open() = "<|form:mastery-thought|>";
    def fmcl-close() = "<|/form:mastery-thought|>";
    def fmcl-max-concept-bytes() = 96;
    def fmcl-max-attempt-bytes() = 96;
    def fmcl-max-frame-bytes() = 17 + (str_len(fmcl-open()) + (fmcl-max-concept-bytes() + (fmcl-max-attempt-bytes() + str_len(fmcl-close()))));
    def fmcl-default-timeout-budget() = fmcl-max-frame-bytes();
    def fmcl-request-surface(concept-key, attempt-label) = str_concat(fmcl-open(), str_concat("concept=", str_concat(concept-key, str_concat(";attempt=", str_concat(attempt-label, fmcl-close())))));
    // scan = status reason consumed position concept-key attempt-label
    def fmcl-scan(status, reason, consumed, position, concept-key, attempt-label) = [status, reason, consumed, position, concept-key, attempt-label];
    def fmcl-scan-status(scan) = scan[0];
    def fmcl-scan-reason(scan) = scan[1];
    def fmcl-scan-consumed(scan) = scan[2];
    def fmcl-scan-position(scan) = scan[3];
    def fmcl-scan-concept(scan) = scan[4];
    def fmcl-scan-attempt(scan) = scan[5];
    def fmcl-fold(cursor, budget, consumed) = (Comparable) cur-eof?(cursor) == 1 ? ["complete", consumed, cur-pos(cursor)] : budget <= 0 ? ["timeout", consumed, cur-pos(cursor)] : fmcl-fold(cur-advance(cursor, 1), budget - 1, str_concat(consumed, byte_to_str(cur-peek(cursor))));
    def fmcl-parse-consumed(surface) = !((Comparable) str_find(surface, fmcl-open(), 0) == 0) ? fmcl-scan("nothing", "no-mastery-thought", surface, str_len(surface), "", "") : {
        let close-at = str_find(surface, fmcl-close(), str_len(fmcl-open()));
        close-at < 0 ? fmcl-scan("nothing", "held-incomplete", surface, str_len(surface), "", "") : !((Comparable) (close-at + str_len(fmcl-close())) == str_len(surface)) ? fmcl-scan("failure", "trailing-bytes", surface, str_len(surface), "", "") : {
            let payload = substring(surface, str_len(fmcl-open()), close-at);
            let split = str_find(payload, ";attempt=", 0);
            split < 0 || !((Comparable) str_find(payload, "concept=", 0) == 0) ? fmcl-scan("failure", "field-shape", surface, str_len(surface), "", "") : {
                let key = substring(payload, 8, split);
                let label = substring(payload, split + 9, str_len(payload));
                (Comparable) str_len(key) == 0 || str_len(key) > fmcl-max-concept-bytes() ? fmcl-scan("failure", "concept-budget", surface, str_len(surface), "", "") : (Comparable) str_len(label) == 0 || str_len(label) > fmcl-max-attempt-bytes() ? fmcl-scan("failure", "attempt-budget", surface, str_len(surface), "", "") : fmcl-scan("ready", "ready", surface, str_len(surface), key, label);
            };
        };
    };
    def fmcl-bmf-consume(surface, budget) = {
        let folded = fmcl-fold(cursor-str(surface), budget, "");
        (String) folded[0] == "timeout" ? fmcl-scan("timeout", "cursor-step-budget", folded[1], folded[2], "", "") : fmcl-parse-consumed(folded[1]);
    };
    def fmcl-request(attempt, surface, scan, lookup-door, execution-door, budget) = intern_node(fmcl-request-category(), [attempt, intern_trivial_string(surface), intern_trivial_string(fmcl-scan-status(scan)), intern_trivial_string(fmcl-scan-reason(scan)), intern_trivial_int(fmcl-scan-position(scan)), intern_trivial_int(budget), intern_trivial_string(lookup-door), intern_trivial_string(execution-door), intern_trivial_int(0), intern_trivial_int(1)]);
    def fmcl-request-attempt(request) = node_children(request)[0];
    def fmcl-request-status(request) = node_value(node_children(request)[2]);
    def fmcl-request-scannerless?(request) = node_value(node_children(request)[9]);
    def fmcl-request-pretokenized?(request) = node_value(node_children(request)[8]);
    def fmcl-request-from-surface(attempt, surface, lookup-door, execution-door, budget) = {
        let scan = fmcl-bmf-consume(surface, budget);
        (String) fmcl-scan-status(scan) == "ready" && ((String) fmcl-scan-concept(scan) == fmcl-concept-key(fmcl-attempt-concept(attempt)) && (String) fmcl-scan-attempt(scan) == fmcl-attempt-label(attempt)) ? fmcl-request(attempt, surface, scan, lookup-door, execution-door, budget) : fmcl-request(attempt, surface, (String) fmcl-scan-status(scan) == "ready" ? fmcl-scan("failure", "identity-mismatch", fmcl-scan-consumed(scan), fmcl-scan-position(scan), "", "") : scan, lookup-door, execution-door, budget);
    };
    // -- callback evidence -------------------------------------------
    // retrieval = status reason source entry observation lookup-count
    def fmcl-retrieval-evidence(status, reason, source, entry, observation, lookup-count) = [status, reason, source, entry, observation, lookup-count];
    def fmcl-retrieval-status(r) = r[0];
    def fmcl-retrieval-reason(r) = r[1];
    def fmcl-retrieval-source(r) = r[2];
    def fmcl-retrieval-entry(r) = r[3];
    def fmcl-retrieval-observation(r) = r[4];
    def fmcl-retrieval-lookup-count(r) = r[5];
    def fmcl-retrieval-status?(status) = (String) status == "hit" || (String) status == "miss" ? 1 : (String) status == "nothing" || (String) status == "stale" ? 1 : (String) status == "ambiguous" || (String) status == "timeout" ? 1 : (String) status == "failure" ? 1 : 0;
    def fmcl-retrieval-valid?(r) = !((Comparable) len(r) == 6) ? 0 : !((Comparable) fmcl-retrieval-status?(fmcl-retrieval-status(r)) == 1) ? 0 : fmcl-retrieval-lookup-count(r) < 0 || fmcl-retrieval-lookup-count(r) > 1 ? 0 : (String) fmcl-retrieval-status(r) == "hit" ? nothing?(fmcl-retrieval-source(r)) || nothing?(fmcl-retrieval-entry(r)) ? 0 : 1 : 1;
    // execution = status reason answer verdict-present verdict-value surprise
    //             failure model-executed model-observation execution-count
    //             timeout-spent
    def fmcl-execution-evidence(status, reason, answer, verdict-present, verdict-value, surprise, failure, model-executed, model-observation, execution-count, timeout-spent) = [status, reason, answer, verdict-present, verdict-value, surprise, failure, model-executed, model-observation, execution-count, timeout-spent];
    def fmcl-ee-status(e) = e[0];
    def fmcl-ee-reason(e) = e[1];
    def fmcl-ee-answer(e) = e[2];
    def fmcl-ee-verdict-present?(e) = e[3];
    def fmcl-ee-verdict-value(e) = e[4];
    def fmcl-ee-surprise?(e) = e[5];
    def fmcl-ee-failure?(e) = e[6];
    def fmcl-ee-model-executed?(e) = e[7];
    def fmcl-ee-model-observation(e) = e[8];
    def fmcl-ee-execution-count(e) = e[9];
    def fmcl-ee-timeout-spent(e) = e[10];
    def fmcl-bit?(x) = (Comparable) x == 0 || (Comparable) x == 1 ? 1 : 0;
    def fmcl-execution-status?(status) = (String) status == "value" || (String) status == "nothing" ? 1 : (String) status == "timeout" || (String) status == "failure" ? 1 : 0;
    def fmcl-execution-valid?(e, budget) = !((Comparable) len(e) == 11) ? 0 : !((Comparable) fmcl-execution-status?(fmcl-ee-status(e)) == 1) ? 0 : !((Comparable) fmcl-bit?(fmcl-ee-verdict-present?(e)) == 1) ? 0 : !((Comparable) fmcl-bit?(fmcl-ee-verdict-value(e)) == 1) ? 0 : !((Comparable) fmcl-bit?(fmcl-ee-surprise?(e)) == 1) ? 0 : !((Comparable) fmcl-bit?(fmcl-ee-failure?(e)) == 1) ? 0 : !((Comparable) fmcl-bit?(fmcl-ee-model-executed?(e)) == 1) ? 0 : fmcl-ee-execution-count(e) < 0 || fmcl-ee-execution-count(e) > 1 ? 0 : fmcl-ee-timeout-spent(e) < 0 || fmcl-ee-timeout-spent(e) > budget ? 0 : (Comparable) fmcl-ee-model-executed?(e) == 1 && nothing?(fmcl-ee-model-observation(e)) ? 0 : (Comparable) fmcl-ee-model-executed?(e) == 0 && !nothing?(fmcl-ee-model-observation(e)) ? 0 : 1;
    // -- observations, signals, lifecycle ----------------------------
    def fmcl-retrieval-observation-node(request, retrieval) = intern_node(fmcl-observation-category(), [intern_trivial_string("retrieval"), request, intern_trivial_string(fmcl-retrieval-status(retrieval)), intern_trivial_string(fmcl-retrieval-reason(retrieval)), fmcl-node-or-absent(fmcl-retrieval-observation(retrieval)), intern_trivial_int(fmcl-retrieval-lookup-count(retrieval))]);
    def fmcl-execution-node(request, evidence) = intern_node(fmcl-execution-category(), [request, intern_trivial_string(fmcl-ee-status(evidence)), intern_trivial_string(fmcl-ee-reason(evidence)), fmcl-node-or-absent(fmcl-ee-answer(evidence)), intern_trivial_int(fmcl-ee-verdict-present?(evidence)), intern_trivial_int(fmcl-ee-verdict-value(evidence)), intern_trivial_int(fmcl-ee-model-executed?(evidence)), fmcl-node-or-absent(fmcl-ee-model-observation(evidence)), intern_trivial_int(fmcl-ee-execution-count(evidence)), intern_trivial_int(fmcl-ee-timeout-spent(evidence))]);
    def fmcl-execution-answer(execution) = fmcl-node-or-nothing(node_children(execution)[3]);
    def fmcl-execution-verdict-present?(execution) = node_value(node_children(execution)[4]);
    def fmcl-execution-verdict-value(execution) = node_value(node_children(execution)[5]);
    def fmcl-execution-model-executed?(execution) = node_value(node_children(execution)[6]);
    def fmcl-observed-verdict(execution) = (Comparable) fmcl-execution-verdict-present?(execution) == 1 ? fmcl-execution-verdict-value(execution) : nothing();
    def fmcl-execution-observation-node(execution, evidence) = intern_node(fmcl-observation-category(), [intern_trivial_string("execution"), execution, fmcl-node-or-absent(fmcl-ee-answer(evidence)), intern_trivial_int(fmcl-ee-verdict-present?(evidence)), intern_trivial_int(fmcl-ee-verdict-value(evidence)), intern_trivial_int(fmcl-ee-surprise?(evidence)), intern_trivial_int(fmcl-ee-failure?(evidence)), intern_trivial_int(fmcl-ee-model-executed?(evidence)), fmcl-node-or-absent(fmcl-ee-model-observation(evidence))]);
    def fmcl-signal(observation, evidence) = intern_node(fmcl-signal-category(), [observation, intern_trivial_string((Comparable) fmcl-ee-failure?(evidence) == 1 ? "failure" : (Comparable) fmcl-ee-surprise?(evidence) == 1 ? "surprise" : (String) fmcl-ee-status(evidence) == "nothing" ? "nothing" : "observed"), intern_trivial_string(fmcl-ee-reason(evidence)), intern_trivial_int(fmcl-ee-surprise?(evidence)), intern_trivial_int(fmcl-ee-failure?(evidence))]);
    def fmcl-signal-kind(signal) = node_value(node_children(signal)[1]);
    def fmcl-event(stage, action, signal, ordinal) = intern_node(fmcl-lifecycle-category(), [intern_trivial_string("event"), intern_trivial_string(stage), intern_trivial_string(action), intern_trivial_string(signal), intern_trivial_int(ordinal)]);
    def fmcl-event-action(event) = node_value(node_children(event)[2]);
    def fmcl-trace(events) = intern_node(fmcl-lifecycle-category(), cons(intern_trivial_string("trace"), events));
    def fmcl-trace-events(trace) = tail(node_children(trace));
    def fmcl-trace-add(trace, event) = fmcl-trace(append(fmcl-trace-events(trace), [event]));
    def fmcl-trace-has?(trace, action) = fmcl-events-have?(fmcl-trace-events(trace), action);
    def fmcl-events-have?(events, action) = nil?(events) ? 0 : (String) fmcl-event-action(head(events)) == action ? 1 : fmcl-events-have?(tail(events), action);
    def fmcl-trace-actions-from(events) = nil?(events) ? "" : nil?(tail(events)) ? fmcl-event-action(head(events)) : str_concat(fmcl-event-action(head(events)), str_concat(",", fmcl-trace-actions-from(tail(events))));
    def fmcl-trace-actions(trace) = fmcl-trace-actions-from(fmcl-trace-events(trace));
    // -- mastery state ------------------------------------------------
    // stage status concept attempt request execution observation signal trace
    // budget persistence continuation channel mesh previous lookup-count
    // execution-count model-executed
    def fmcl-state(stage, status, concept, attempt, request, execution, observation, signal, trace, budget, persistence, continuation, channel, mesh, previous, lookup-count, execution-count, model-executed) = intern_node(fmcl-state-category(), [intern_trivial_string(stage), intern_trivial_string(status), concept, fmcl-node-or-absent(attempt), fmcl-node-or-absent(request), fmcl-node-or-absent(execution), fmcl-node-or-absent(observation), fmcl-node-or-absent(signal), trace, intern_trivial_int(budget), persistence, continuation, channel, mesh, fmcl-node-or-absent(previous), intern_trivial_int(lookup-count), intern_trivial_int(execution-count), intern_trivial_int(model-executed)]);
    def fmcl-stage(s) = node_value(node_children(s)[0]);
    def fmcl-status(s) = node_value(node_children(s)[1]);
    def fmcl-state-concept(s) = node_children(s)[2];
    def fmcl-state-attempt(s) = fmcl-node-or-nothing(node_children(s)[3]);
    def fmcl-state-request(s) = fmcl-node-or-nothing(node_children(s)[4]);
    def fmcl-state-execution(s) = fmcl-node-or-nothing(node_children(s)[5]);
    def fmcl-state-observation(s) = fmcl-node-or-nothing(node_children(s)[6]);
    def fmcl-state-signal(s) = fmcl-node-or-nothing(node_children(s)[7]);
    def fmcl-state-trace(s) = node_children(s)[8];
    def fmcl-state-budget(s) = node_value(node_children(s)[9]);
    def fmcl-state-persistence(s) = node_children(s)[10];
    def fmcl-state-continuation(s) = node_children(s)[11];
    def fmcl-state-channel(s) = node_children(s)[12];
    def fmcl-state-mesh(s) = node_children(s)[13];
    def fmcl-state-previous(s) = fmcl-node-or-nothing(node_children(s)[14]);
    def fmcl-state-lookup-count(s) = node_value(node_children(s)[15]);
    def fmcl-state-execution-count(s) = node_value(node_children(s)[16]);
    def fmcl-state-model-executed?(s) = node_value(node_children(s)[17]);
    def fmcl-discover(concept-key, budget, persistence, continuation, channel, mesh) = {
        let concept = fmcl-concept(concept-key, nothing(), nothing());
        let trace = fmcl-trace([fmcl-event("discover", "discover", concept-key, 0)]);
        fmcl-state("discover", "ready", concept, nothing(), nothing(), nothing(), nothing(), nothing(), trace, budget, persistence, continuation, channel, mesh, nothing(), 0, 0, 0);
    };
    def fmcl-choose(s, label) = {
        let attempt = fmcl-attempt(fmcl-state-concept(s), label, 1, nothing());
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("choose", "choice", label, 1));
        fmcl-state("choose", "ready", fmcl-state-concept(s), attempt, nothing(), nothing(), nothing(), nothing(), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, 0, 0, 0);
    };
    def fmcl-address(s, surface, lookup-door, execution-door) = {
        let request = fmcl-request-from-surface(fmcl-state-attempt(s), surface, lookup-door, execution-door, fmcl-state-budget(s));
        let action = (String) fmcl-request-status(request) == "ready" ? "request" : fmcl-request-status(request);
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("choose", action, fmcl-request-status(request), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("choose", fmcl-request-status(request), fmcl-state-concept(s), fmcl-state-attempt(s), request, nothing(), nothing(), nothing(), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, 0, 0, 0);
    };
    // lookup is called once only for a ready, scannerless request.
    def fmcl-retrieve-with(ctx, lookup, s) = nothing?(fmcl-state-request(s)) || !((String) fmcl-status(s) == "ready") ? s : {
        let retrieval = lookup(ctx, fmcl-state-request(s));
        !((Comparable) fmcl-retrieval-valid?(retrieval) == 1) ? {
            let bad = fmcl-retrieval-evidence("failure", "invalid-lookup-evidence", nothing(), nothing(), nothing(), 0);
            fmcl-after-retrieval(s, bad);
        } : fmcl-after-retrieval(s, retrieval);
    };
    def fmcl-after-retrieval(s, retrieval) = {
        let hit = (String) fmcl-retrieval-status(retrieval) == "hit";
        let concept = hit ? fmcl-concept(fmcl-concept-key(fmcl-state-concept(s)), fmcl-retrieval-source(retrieval), fmcl-retrieval-entry(retrieval)) : fmcl-state-concept(s);
        let observation = fmcl-retrieval-observation-node(fmcl-state-request(s), retrieval);
        let trace1 = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("retrieve", "retrieve", fmcl-retrieval-status(retrieval), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        let trace2 = hit ? fmcl-trace-add(trace1, fmcl-event("retrieve", "cut", "one-public-source", 1)) : fmcl-trace-add(trace1, fmcl-event("retrieve", "refine", fmcl-retrieval-reason(retrieval), 1));
        fmcl-state(hit ? "retrieve" : "refine", fmcl-retrieval-status(retrieval), concept, fmcl-state-attempt(s), fmcl-state-request(s), nothing(), observation, nothing(), trace2, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-retrieval-lookup-count(retrieval), 0, 0);
    };
    def fmcl-begin-attempt(s) = !((String) fmcl-stage(s) == "retrieve") ? s : {
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("attempt", "attempt", fmcl-attempt-label(fmcl-state-attempt(s)), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("attempt", "ready", fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), nothing(), fmcl-state-observation(s), nothing(), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), 0, 0);
    };
    // execute is called once only after a retrieved source became an attempt.
    def fmcl-execute-with(ctx, execute, s) = !((String) fmcl-stage(s) == "attempt") ? s : {
        let evidence = execute(ctx, s);
        !((Comparable) fmcl-execution-valid?(evidence, fmcl-state-budget(s)) == 1) ? fmcl-after-execution(s, fmcl-execution-evidence("failure", "invalid-execution-evidence", nothing(), 0, 0, 0, 1, 0, nothing(), 0, 0)) : fmcl-after-execution(s, evidence);
    };
    def fmcl-after-execution(s, evidence) = {
        let execution = fmcl-execution-node(fmcl-state-request(s), evidence);
        let observation = fmcl-execution-observation-node(execution, evidence);
        let signal = fmcl-signal(observation, evidence);
        let trace1 = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("execute", "execute", fmcl-ee-status(evidence), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        let trace2 = fmcl-trace-add(trace1, fmcl-event("observe", "observe", fmcl-signal-kind(signal), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("observe", fmcl-ee-status(evidence), fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), execution, observation, signal, trace2, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-ee-execution-count(evidence), fmcl-ee-model-executed?(evidence));
    };
    def fmcl-mastered?(s) = !((String) fmcl-stage(s) == "observe") ? 0 : {
        let execution = fmcl-state-execution(s);
        (String) fmcl-status(s) == "value" && ((Comparable) fmcl-execution-verdict-present?(execution) == 1 && (Comparable) fmcl-execution-verdict-value(execution) == 1) ? 1 : 0;
    };
    def fmcl-decide(s) = (Comparable) fmcl-mastered?(s) == 1 ? fmcl-crystallize(s) : fmcl-undo-refine(s);
    def fmcl-crystallize(s) = {
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("crystallize", "crystallize", "observed-verdict-1", fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("crystallize", "value", fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), fmcl-state-execution(s), fmcl-state-observation(s), fmcl-state-signal(s), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-state-execution-count(s), fmcl-state-model-executed?(s));
    };
    def fmcl-undo-refine(s) = {
        let trace1 = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("refine", "undo", fmcl-status(s), fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        let trace2 = fmcl-trace-add(trace1, fmcl-event("refine", "refine", fmcl-status(s), 1 + fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("refine", fmcl-status(s), fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), fmcl-state-execution(s), fmcl-state-observation(s), fmcl-state-signal(s), trace2, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-state-execution-count(s), fmcl-state-model-executed?(s));
    };
    def fmcl-next-attempt(s, label) = !((String) fmcl-stage(s) == "refine") ? s : {
        let old = fmcl-state-attempt(s);
        let attempt = fmcl-attempt(fmcl-state-concept(s), label, 1 + fmcl-attempt-ordinal(old), old);
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("choose", "choice", label, fmcl-attempt-ordinal(attempt)));
        fmcl-state("choose", "ready", fmcl-state-concept(s), attempt, nothing(), nothing(), nothing(), nothing(), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-state-execution-count(s), fmcl-state-model-executed?(s));
    };
    def fmcl-dissolve(s) = {
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("dissolve", "dissolve", "optional-release", fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("dissolve", fmcl-status(s), fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), fmcl-state-execution(s), fmcl-state-observation(s), fmcl-state-signal(s), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-state-execution-count(s), fmcl-state-model-executed?(s));
    };
    def fmcl-release(s) = {
        let trace = fmcl-trace-add(fmcl-state-trace(s), fmcl-event("release", "release", "cell-context", fmcl-attempt-ordinal(fmcl-state-attempt(s))));
        fmcl-state("release", fmcl-status(s), fmcl-state-concept(s), fmcl-state-attempt(s), fmcl-state-request(s), fmcl-state-execution(s), fmcl-state-observation(s), fmcl-state-signal(s), trace, fmcl-state-budget(s), fmcl-state-persistence(s), fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), s, fmcl-state-lookup-count(s), fmcl-state-execution-count(s), fmcl-state-model-executed?(s));
    };
    // A later cell inherits identities. Transport remains explicitly zero.
    def fmcl-continue-cell(s, new-concept-key, persistence) = {
        let generation = 1 + fmcl-continuation-generation(fmcl-state-continuation(s));
        let continuation = fmcl-continuation(s, fmcl-state-continuation(s), fmcl-state-channel(s), fmcl-state-mesh(s), generation);
        fmcl-discover(new-concept-key, fmcl-state-budget(s), persistence, continuation, fmcl-state-channel(s), fmcl-state-mesh(s));
    };
    0;
}
