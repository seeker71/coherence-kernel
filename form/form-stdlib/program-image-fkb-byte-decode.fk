            : record?(guard) && record_get(guard,"published") == 1 ? pifbd-v8-verify-published(held)
            : pifbd-v8-stage(record_get(state,"path"),record_get(state,"expected"),held);
            record_set(state,"result",result);
            pifbd-v8-publication-view(state);
        };
    };

    def pifbd-raw-cell-image(request) = !record?(request) ? pifbd-v8-refused("raw-cell-image-request-invalid",nothing(),request)
        : !pifbc-proj-fields?(request,["kind","catalog","path","mtime"]) ? pifbd-v8-refused("raw-cell-image-request-invalid",nothing(),request)
        : record_get(request,"kind") != "raw-cell-image" ? pifbd-v8-refused("raw-cell-image-request-invalid",nothing(),request)
        : record_has(request,"pending") ? value_kind(record_get(request,"pending")) == "closure" ? record_get(request,"pending")(nothing(),nothing())
            : pifbd-v8-refused("raw-cell-image-continuation-unavailable",nothing(),request) : {
        let catalog = record_get(request,"catalog"); let path = record_get(request,"path"); let pid = host_pid();
        let projection = pifbc-project(catalog,selection => pifbc-proj-int?(selection) ? kernel_ast(pid,selection)
            : selection[0] == "catalog" ? catalog : selection[0] == "function" ? kernel_ast(pid,["fnmeta",selection[1]])
            : selection[0] == "literal" ? kernel_ast(pid,["str",selection[1]]) : nothing());
        let encoded = pifbc-project-v9(projection,path,record_get(request,"mtime"));
        let owner = record_new(0,"kind","raw-cell-image-owner","path",path);
        record_get(projection,"status") != "projected" ? pifbd-v8-refused(record_get(projection,"reason"),owner,record_get(projection,"detail"))
        : record_get(encoded,"status") != "ready" ? pifbd-v8-refused(record_get(encoded,"reason"),owner,catalog) : {
            let bytes = record_get(encoded,"bytes");
            record_set(owner,"builder",record_get(catalog,"builder")); record_set(owner,"closure",record_get(catalog,"closure"));
            record_set(owner,"checksum",pifbd-v8-checksum(bytes)); record_set(owner,"bytes",len(bytes));
            let proof = record_new(0,"kind","raw-cell-image-projection","catalog",catalog,"relocation",record_get(projection,"relocation"));
            pifbd-v8-publish-patch(path,read_file(path),pifbd-v8-outcome("candidate-ready","",owner,proof,bytes));
        };
    };
    // Parsed-source caches carry syntax, never globals, initialized values or
    // a previous caller's lexical owner. Admission binds the retained syntax
    // in the current owner and uses this unit's existing publication care.
    def pifbd-cache-list(items) = fbc-data-list(items);
    def pifbd-cache-data(value) = fbc-data(value);
    def pifbd-cache-value(data) = fbc-data-value(data);
    def pifbd-cache-form?(node,path,bytes) = !fbc-proper?(node) ? 0 : len(node)!=6 ? 0
        : value_kind(node[3])!="int" || node[3]<0 || node[3]>len(bytes) || node[5]!=path || !fbc-proper?(node[2]) ? 0
        : !(node[0]=="int" && value_kind(node[1])=="int" || node[0]=="float" && value_kind(node[1])=="float" || (node[0]=="text" || node[0]=="name") && value_kind(node[1])=="string" || node[0]=="group" && nothing?(node[1])) ? 0
        : (node[0]=="group" || nil?(node[2])) && all?(child=>pifbd-cache-form?(child,path,bytes),node[2]) && (nothing?(node[4]) || pifbd-cache-form?(node[4],path,bytes));
    def pifbd-cache-load?(row) = !fbc-proper?(row) ? 0 : len(row)!=4 ? 0
        : value_kind(row[0])=="string" && value_kind(row[1])=="string" && value_kind(row[2])=="string" && value_kind(row[3])=="int" && (row[3]==0 || row[3]==1);
    def pifbd-cache-unit?(unit) = !fbc-proper?(unit) ? 0 : len(unit)!=4 ? 0
        : value_kind(unit[0])!="string" || value_kind(unit[1])!="string" || !fbc-proper?(unit[2]) || !fbc-proper?(unit[3]) ? 0
        : all?(form=>pifbd-cache-form?(form,unit[0],unit[1]),unit[2]) && all?(pifbd-cache-load?,unit[3]);
    def pifbd-cache-unambiguous?(units) {
        let seen=record_new(0);
        all?(unit=>record_has(seen,unit[0]) ? record_get(seen,unit[0])==unit : {record_set(seen,unit[0],unit);1;},units);
    }
    def pifbd-cache-packet?(packet,path) = !fbc-proper?(packet) ? 0 : len(packet)!=4 ? 0
        : packet[0]!="parsed-source-image-v1" || packet[1]!=kernel_ast(host_pid(),["syntax-builder"]) || packet[2]!=path || !fbc-proper?(packet[3]) || nil?(packet[3]) ? 0
        : all?(pifbd-cache-unit?,packet[3]) && packet[3][0][0]==path && pifbd-cache-unambiguous?(packet[3]);
    def pifbd-cache-current?(units) = all?(unit=>read_file(unit[0])==unit[1] && all?(load=>kernel_ast(host_pid(),["syntax-resolve",load[0],load[1]])==load[2],unit[3]),units);
    def pifbd-cache-diagnostic(path,observed,stage,health) = record_new(0,"organ","fkwu-compiler","aspect","image:"+path,"path",path,"observed",observed,"stage",stage,"health",health);
    // Reject an obsolete builder before materializing its entire syntax graph.
    // The checksum seals this envelope and the packet repeats the identity at
    // admission; the header is a cheap necessary condition, never a proof.
    def pifbd-cache-envelope() = "FORM-PARSED-SOURCE/3\n"+kernel_ast(host_pid(),["syntax-builder"])+"\n";
    def pifbd-cache-preflight(units) = map(unit=>[unit[0],unit[1],[],unit[3]],units);
    def pifbd-cache-profile(path,stage,began,units,bytes) = (host_getenv("FORM_IMAGE_PROFILE") ?? "")=="1" ? print(["parsed-source-cache",path,stage,"elapsed-ms",host_monotonic_ms()-began,"units",units,"bytes",bytes]) : 0;
    def pifbd-cache-stage(path,phase,body) {
        let stage=float_leaf(29,cons("parsed-source/"+phase,path));
        let state=record_new(0,"status","unfinished");
        defer float_leaf(30,[stage,record_get(state,"status"),0,0]);
        let result=body();record_set(state,"status","complete");result;
    }
    def pifbd-cache-decoded(path,stage,bytes) {
        let began=host_monotonic_ms();let decoded=pifbd-cache-stage(path,stage,()=>fbc-decode(bytes));
        pifbd-cache-profile(path,stage,began,0,len(bytes));decoded;
    }
    def pifbd-cache-read-payload(path,payload,offset) {
        let count=float_leaf(35,[3,substring(payload,offset,offset+8),"value"]);
        value_kind(count)!="int" || count<=0 || count>len(payload) - offset - 8 ? nothing() : {
            let start=offset+8;let end=start+count;
            let metadata=pifbd-cache-decoded(path,"preflight-decode",substring(payload,start,end));
            !fbc-good(metadata) ? nothing() : {
                let units=pifbd-cache-value(fbc-value(metadata));
                !fbc-proper?(units) || nil?(units) || !all?(pifbd-cache-unit?,units) || units[0][0]!=path || !all?(unit=>nil?(unit[2]),units) || !pifbd-cache-unambiguous?(units) ? nothing() : {
                    let began=host_monotonic_ms();let current=pifbd-cache-current?(units);
                    pifbd-cache-profile(path,current ? "preflight-current" : "preflight-stale",began,len(units),count);
                    !current ? nothing() : {
                        let decoded=pifbd-cache-decoded(path,"syntax-decode",substring(payload,end,len(payload)));
                        !fbc-good(decoded) ? nothing() : {
                            let materialize=host_monotonic_ms();let packet=pifbd-cache-value(fbc-value(decoded));
                            pifbd-cache-profile(path,"syntax-values",materialize,len(units),len(payload)-end);
                            let validate=host_monotonic_ms();
                            let valid=pifbd-cache-packet?(packet,path) && pifbd-cache-preflight(packet[3])==units && pifbd-cache-current?(packet[3]);
                            pifbd-cache-profile(path,"syntax-validation",validate,len(units),len(payload)-end);
                            valid ? packet[3] : nothing();
                        };
                    };
                };
            };
        };
    }
    def pifbd-cache-read(path) {
        let artifact=path+".cell.fkb"; let bytes=read_file(artifact);
        nothing?(bytes) ? record_new(0,"status","absent","units",nothing(),"diag",[]) : {
            let admitted=try {
                let envelope=pifbd-cache-envelope();
                len(bytes)<len(envelope)+16 || substring(bytes,0,len(envelope))!=envelope ? nothing() : {
                    let payload=substring(bytes,0,len(bytes)-8);
                    pifbd-v8-checksum(bytes)!=pifbc-v8-fold(payload) ? nothing() : pifbd-cache-read-payload(path,payload,len(envelope));
                };
            } catch nothing();
            nothing?(admitted) ? record_new(0,"status","refused","units",nothing(),"diag",[pifbd-cache-diagnostic(artifact,"image-admission-failed","observe",0)])
                : record_new(0,"status","admitted","units",admitted,"diag",[]);
        };
    }
    def pifbd-cache-unit-wire(pool,unit) {
        let prefix=fbc-emit-list-prefix(pool,4)+fbc-emit-data(pool,unit[0])+fbc-emit-data(pool,unit[1]);
        let roots=pifbd-cache-nodes-emit(pool,unit[2],fbc-put([],prefix));
        fbc-finish(fbc-put(roots,fbc-emit-data(pool,unit[3])),"");
    }
    // One balanced byte accumulator owns the unit's depth-first wire. A parent
    // never copies or retains its descendants' complete wire a second time.
    // Each scalar still enters the shared codec in canonical first-use order.
    def pifbd-cache-node-emit(pool,id,bins) {
        let node=kernel_ast(host_pid(),["syntax-node",id]);
        let prefix=fbc-emit-list-prefix(pool,6)+fbc-emit-data(pool,node[0])+fbc-emit-data(pool,node[1]);
        let children=pifbd-cache-nodes-emit(pool,node[2],fbc-put(bins,prefix));
        let offset=fbc-put(children,fbc-emit-data(pool,node[4]));
        let annotation=nothing?(node[5]) ? fbc-put(offset,fbc-emit-data(pool,nothing())) : pifbd-cache-node-emit(pool,node[5],offset);
        fbc-put(annotation,fbc-emit-data(pool,node[3]));
    }
    def pifbd-cache-nodes-emit(pool,ids,bins) = foldl((held,id)=>pifbd-cache-node-emit(pool,id,held),fbc-put(bins,fbc-emit-list-prefix(pool,len(ids))),ids);
    def pifbd-cache-units-wire(pool,units,bins) = nil?(units) ? fbc-finish(bins,"") : {
        let wire=pifbd-cache-unit-wire(pool,units[0]);
        nothing?(wire) ? nothing() : pifbd-cache-units-wire(pool,units[1:],fbc-put(bins,wire));
    }
    def pifbd-cache-wire(pool,path,builder,units) {
        let prefix=fbc-emit-list-prefix(pool,4)+fbc-emit-data(pool,"parsed-source-image-v1")
            +fbc-emit-data(pool,builder)+fbc-emit-data(pool,path);
        let header=fbc-emit-list-prefix(pool,len(units));
        nothing?(header) ? nothing() : pifbd-cache-units-wire(pool,units,fbc-put([],prefix+header));
    }
    def pifbd-cache-encode-units(path,builder,units) = fbc-encode-by(pool=>pifbd-cache-wire(pool,path,builder,units));
    def pifbd-cache-encode(path,builder) = pifbd-cache-encode-units(path,builder,kernel_ast(host_pid(),["syntax-cache-units"]));
    def pifbd-cache-publish(path) {
        let builder=kernel_ast(host_pid(),["syntax-builder"]);
        let units=kernel_ast(host_pid(),["syntax-cache-units"]);
        let began=host_monotonic_ms();let metadata=pifbd-cache-stage(path,"preflight-encode",()=>fbc-encode(pifbd-cache-data(pifbd-cache-preflight(units))));
        pifbd-cache-profile(path,"preflight-encode",began,len(units),fbc-good(metadata) ? len(fbc-value(metadata)) : 0);
        let started=host_monotonic_ms();let encoded=pifbd-cache-stage(path,"syntax-encode",()=>pifbd-cache-encode-units(path,builder,units));
        pifbd-cache-profile(path,"syntax-encode",started,len(units),fbc-good(encoded) ? len(fbc-value(encoded)) : 0);
        let artifact=path+".cell.fkb"; let owner=record_new(0,"kind","parsed-source-image-owner","path",artifact);
        !fbc-good(metadata) ? pifbd-v8-refused(fbc-error(metadata),owner,nothing()) : !fbc-good(encoded) ? pifbd-v8-refused(fbc-error(encoded),owner,nothing()) : {
            let meta=fbc-value(metadata);let sealing=host_monotonic_ms();
            let bytes=pifbd-cache-stage(path,"seal",()=>pifbc-v8-seal(pifbd-cache-envelope()+float_leaf(34,[3,len(meta)])+meta+fbc-value(encoded)));
            pifbd-cache-profile(path,"seal",sealing,len(units),len(bytes));
            record_set(owner,"builder",builder); record_set(owner,"checksum",pifbd-v8-checksum(bytes)); record_set(owner,"bytes",len(bytes));
            pifbd-cache-stage(path,"publish",()=>pifbd-v8-publish-patch(artifact,read_file(artifact),pifbd-v8-outcome("candidate-ready","",owner,"parsed sources; no execution state",bytes)));
        };
    }
    def pifbd-parsed-cell(request) = request[0]=="read" ? pifbd-cache-read(request[1])
        : request[0]=="publish" ? pifbd-cache-publish(request[1])
        : request[0]=="healed" ? pifbd-cache-diagnostic(request[1]+".cell.fkb","image-admitted","applied",1)
        : request[0]=="pending" ? record_get(request[1],"resume")(nothing(),nothing()) : nothing();
    cs-entry?("form/form-stdlib/program-image-fkb-byte-decode.fk") ? pifbd-raw-cell-image(cell_input()) : nothing();
}
