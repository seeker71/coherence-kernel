// form-recipe-birth-token.fk — scannerless raw-byte birth of an affine signed-
// i32 recipe, returning content identity as a typed observation.
//
// STREAM SURFACE
//
//   <|form:recipe-birth|>affine-i32;mul=-3;add=1<|/form:recipe-birth|>
//
// A local model may emit those bytes, but it does not create a recipe merely by
// saying them. frbt-feed-byte walks the frame one byte at a time with no token
// vocabulary or pre-step. A complete canonical payload is parsed by Form,
// interned as recipe content, and returned through a separate birth-observation
// NodeID. The raw surface is never reproduced by the renderer.
//
// DIRECT CONSTRUCTION. The affine grammar constructs meaning as tag, multiplier,
// addend, input shape, result shape and recipe-version node children.
// The stable accessors frbt-recipe-mul/frbt-recipe-add make that shape available
// to a later direct source emitter. This cell performs no arithmetic execution,
// native generation, persistence, carrier call, or model call.
//
// SIGNALS. A prefix or body still arriving is held. Ordinary non-envelope input
// is nothing. Malformed grammar is failure. Frame-budget exhaustion is timeout.
// Valid multiplier/addend 0 and 1 are ordinary present integers, never confused
// with nothing. Every terminal observation carries content-addressed lifecycle
// events; these name what the parser/reducer observed, not external effects.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
//
section [form.bml] {
    // ── fixed byte grammar and bounds ────────────────────────────────
    def frbt-open() = "<|form:recipe-birth|>";
    def frbt-close() = "<|/form:recipe-birth|>";
    def frbt-observation-open() = "<|form:recipe-birth-observation|>";
    def frbt-observation-close() = "<|/form:recipe-birth-observation|>";
    def frbt-kind() = "affine-i32";
    def frbt-mul-field() = "mul=";
    def frbt-add-field() = "add=";
    def frbt-max-payload-bytes() = 64;
    def frbt-max-int-bytes() = 11;
    def frbt-max-render-bytes() = 1024;
    def frbt-max-frame-bytes() = str_len(frbt-open()) + (frbt-max-payload-bytes() + str_len(frbt-close()));
    // ── content identities ──────────────────────────────────────────
    def frbt-recipe-category() = make_nodeid(31, 2, 0, 65);
    def frbt-birth-category() = make_nodeid(31, 2, 0, 66);
    def frbt-event-category() = make_nodeid(31, 2, 0, 67);
    def frbt-observation-category() = make_nodeid(31, 2, 0, 68);
    def frbt-absent-category() = make_nodeid(31, 2, 0, 69);
    def frbt-absent() = intern_node(frbt-absent-category(), list(intern_trivial_string("nothing")));
    // The first three children intentionally match the direct affine emitter
    // shape: semantic tag, multiplier, addend. The remaining children make the
    // signed width and birth version part of content identity.
    def frbt-affine-recipe(mul-value, add-value) = intern_node(frbt-recipe-category(), list(intern_trivial_string("affine-scalar-v1"), intern_trivial_int(mul-value), intern_trivial_int(add-value), intern_trivial_string("signed-i32"), intern_trivial_string("signed-i32"), intern_trivial_string("scannerless-recipe-birth-v1")));
    def frbt-recipe-tag(recipe) = node_value(nth(node_children(recipe), 0));
    def frbt-recipe-mul(recipe) = node_value(nth(node_children(recipe), 1));
    def frbt-recipe-add(recipe) = node_value(nth(node_children(recipe), 2));
    def frbt-i32?(v) = v >= 0 - 2147483648 && v <= 2147483647 ? 1 : 0;
    def frbt-recipe-shape?(recipe) = nothing?(recipe) ? 0 : !node_eq(node_category(recipe), frbt-recipe-category()) ? 0 : !((Comparable) len(node_children(recipe)) == 6) ? 0 : !((String) frbt-recipe-tag(recipe) == "affine-scalar-v1") ? 0 : !((Comparable) frbt-i32?(frbt-recipe-mul(recipe)) == 1) ? 0 : !((Comparable) frbt-i32?(frbt-recipe-add(recipe)) == 1) ? 0 : !((String) node_value(nth(node_children(recipe), 3)) == "signed-i32") ? 0 : !((String) node_value(nth(node_children(recipe), 4)) == "signed-i32") ? 0 : (String) node_value(nth(node_children(recipe), 5)) == "scannerless-recipe-birth-v1" ? 1 : 0;
    def frbt-node-key(node) = str_concat(int_to_str(node_pkg(node)), str_concat(".", str_concat(int_to_str(node_level(node)), str_concat(".", str_concat(int_to_str(node_type(node)), str_concat(".", int_to_str(node_inst(node))))))));
    // ── scannerless byte cursor ─────────────────────────────────────
    // cursor = (status reason bytes frame complete)
    def frbt-cursor() = list("held", "held-open", 0, "", 0);
    def frbt-cursor-status(c) = nth(c, 0);
    def frbt-cursor-reason(c) = nth(c, 1);
    def frbt-cursor-bytes(c) = nth(c, 2);
    def frbt-cursor-frame(c) = nth(c, 3);
    def frbt-cursor-complete?(c) = nth(c, 4);
    def frbt-prefix-of-open?(text) = str_len(text) > str_len(frbt-open()) ? 0 : (String) text == substring(frbt-open(), 0, str_len(text)) ? 1 : 0;
    def frbt-tail-close?(text) = {
        let n = str_len(text);
        let m = str_len(frbt-close());
        n < m ? 0 : (String) substring(text, n - m, n) == frbt-close() ? 1 : 0;
    };
    def frbt-cursor-terminal?(cursor) = (String) frbt-cursor-status(cursor) == "nothing" || ((String) frbt-cursor-status(cursor) == "failure" || (String) frbt-cursor-status(cursor) == "timeout") ? 1 : 0;
    def frbt-feed-byte(cursor, byte) = (Comparable) frbt-cursor-terminal?(cursor) == 1 ? cursor : (Comparable) frbt-cursor-complete?(cursor) == 1 ? list("failure", "trailing-bytes", frbt-cursor-bytes(cursor) + 1, frbt-cursor-frame(cursor), 0) : frbt-cursor-bytes(cursor) >= frbt-max-frame-bytes() ? list("timeout", "frame-budget-exceeded", frbt-cursor-bytes(cursor), frbt-cursor-frame(cursor), 0) : {
        let next = str_concat(frbt-cursor-frame(cursor), byte_to_str(byte));
        let bytes = frbt-cursor-bytes(cursor) + 1;
        bytes <= str_len(frbt-open()) && !((Comparable) frbt-prefix-of-open?(next) == 1) ? list("nothing", "no-birth-token", bytes, next, 0) : (Comparable) frbt-tail-close?(next) == 1 ? list("ready", "frame-complete", bytes, next, 1) : list("held", "held-frame", bytes, next, 0);
    };
    def frbt-feed-from(text, at, cursor) = at >= str_len(text) ? cursor : frbt-feed-from(text, at + 1, frbt-feed-byte(cursor, str_byte_at(text, at)));
    def frbt-feed-text(text) = frbt-feed-from(text, 0, frbt-cursor());
    // ── strict canonical signed-i32 payload ─────────────────────────
    def frbt-canonical-i32?(text) = (Comparable) str_len(text) == 0 || str_len(text) > frbt-max-int-bytes() ? 0 : {
        let value = str_to_int(text);
        (String) text == int_to_str(value) && (Comparable) frbt-i32?(value) == 1 ? 1 : 0;
    };
    // payload result = (status reason recipe)
    def frbt-payload-result(status, reason, recipe) = list(status, reason, recipe);
    def frbt-parse-payload(payload) = {
        let n = str_len(payload);
        let s1 = str_find(payload, ";", 0);
        let s2 = s1 < 0 ? -1 : str_find(payload, ";", s1 + 1);
        let s3 = s2 < 0 ? -1 : str_find(payload, ";", s2 + 1);
        s1 < 0 || (s2 < 0 || !(s3 < 0)) ? frbt-payload-result("failure", "field-shape", nothing()) : {
            let kind = substring(payload, 0, s1);
            let mul-field = substring(payload, s1 + 1, s2);
            let add-field = substring(payload, s2 + 1, n);
            !((String) kind == frbt-kind()) ? frbt-payload-result("failure", "recipe-kind", nothing()) : !((Comparable) str_find(mul-field, frbt-mul-field(), 0) == 0) ? frbt-payload-result("failure", "mul-field", nothing()) : !((Comparable) str_find(add-field, frbt-add-field(), 0) == 0) ? frbt-payload-result("failure", "add-field", nothing()) : {
                let mul-text = substring(mul-field, 4, str_len(mul-field));
                let add-text = substring(add-field, 4, str_len(add-field));
                !((Comparable) frbt-canonical-i32?(mul-text) == 1) ? frbt-payload-result("failure", "mul-integer", nothing()) : !((Comparable) frbt-canonical-i32?(add-text) == 1) ? frbt-payload-result("failure", "add-integer", nothing()) : frbt-payload-result("ready", "recipe-born", frbt-affine-recipe(str_to_int(mul-text), str_to_int(add-text)));
            };
        };
    };
    // birth result = (status reason recipe birth-token cursor pretokenized)
    def frbt-birth-token(recipe) = intern_node(frbt-birth-category(), list(recipe, intern_trivial_string("scannerless-affine-i32-v1"), intern_trivial_int(frbt-max-frame-bytes())));
    def frbt-result(status, reason, recipe, birth-token, cursor) = list(status, reason, recipe, birth-token, cursor, 0);
    def frbt-result-status(r) = nth(r, 0);
    def frbt-result-reason(r) = nth(r, 1);
    def frbt-result-recipe(r) = nth(r, 2);
    def frbt-result-birth-token(r) = nth(r, 3);
    def frbt-result-cursor(r) = nth(r, 4);
    def frbt-result-pretokenized?(r) = nth(r, 5);
    def frbt-parse-cursor(cursor) = {
        let status = frbt-cursor-status(cursor);
        (String) status == "ready" ? {
            let frame = frbt-cursor-frame(cursor);
            let payload = substring(frame, str_len(frbt-open()), str_len(frame) - str_len(frbt-close()));
            str_len(payload) > frbt-max-payload-bytes() ? frbt-result("timeout", "payload-budget-exceeded", nothing(), nothing(), cursor) : str_find(payload, frbt-open(), 0) >= 0 ? frbt-result("failure", "nested-birth-token", nothing(), nothing(), cursor) : {
                let parsed = frbt-parse-payload(payload);
                let parsed-status = nth(parsed, 0);
                let parsed-reason = nth(parsed, 1);
                let recipe = nth(parsed, 2);
                (String) parsed-status == "ready" ? frbt-result("ready", parsed-reason, recipe, frbt-birth-token(recipe), cursor) : frbt-result(parsed-status, parsed-reason, recipe, nothing(), cursor);
            };
        } : frbt-result(status, frbt-cursor-reason(cursor), nothing(), nothing(), cursor);
    };
    def frbt-parse-stream(surface) = frbt-parse-cursor(frbt-feed-text(surface));
    def frbt-surface(mul-value, add-value) = str_concat(frbt-open(), str_concat(frbt-kind(), str_concat(";mul=", str_concat(int_to_str(mul-value), str_concat(";add=", str_concat(int_to_str(add-value), frbt-close()))))));
    // ── observed lifecycle and typed birth observation ──────────────
    def frbt-result-node-or-absent(node) = nothing?(node) ? frbt-absent() : node;
    def frbt-event(result, action) = intern_node(frbt-event-category(), list(frbt-result-node-or-absent(frbt-result-birth-token(result)), frbt-result-node-or-absent(frbt-result-recipe(result)), intern_trivial_string(action), intern_trivial_string(frbt-result-status(result)), intern_trivial_string(frbt-result-reason(result)), intern_trivial_int(frbt-cursor-bytes(frbt-result-cursor(result)))));
    def frbt-event-action(event) = node_value(nth(node_children(event), 2));
    def frbt-trace-ready(result) = list(frbt-event(result, "choice"), frbt-event(result, "crystallize"), frbt-event(result, "dissolve"), frbt-event(result, "release"));
    def frbt-trace-held(result) = list(frbt-event(result, "choice"), frbt-event(result, "held"));
    def frbt-trace-nothing(result) = list(frbt-event(result, "choice"), frbt-event(result, "nothing"), frbt-event(result, "dissolve"), frbt-event(result, "release"));
    def frbt-trace-failure(result) = list(frbt-event(result, "choice"), frbt-event(result, "failure"), frbt-event(result, "undo"), frbt-event(result, "refine"), frbt-event(result, "release"));
    def frbt-trace-timeout(result) = list(frbt-event(result, "choice"), frbt-event(result, "timeout"), frbt-event(result, "cut"), frbt-event(result, "undo"), frbt-event(result, "refine"), frbt-event(result, "release"));
    def frbt-trace(result) = {
        let status = frbt-result-status(result);
        (String) status == "ready" ? frbt-trace-ready(result) : (String) status == "held" ? frbt-trace-held(result) : (String) status == "nothing" ? frbt-trace-nothing(result) : (String) status == "failure" ? frbt-trace-failure(result) : frbt-trace-timeout(result);
    };
    def frbt-trace-has?(trace, action) = (Comparable) len(trace) == 0 ? 0 : (String) frbt-event-action(head(trace)) == action ? 1 : frbt-trace-has?(tail(trace), action);
    def frbt-trace-actions(trace) = (Comparable) len(trace) == 0 ? "" : (Comparable) len(tail(trace)) == 0 ? frbt-event-action(head(trace)) : str_concat(frbt-event-action(head(trace)), str_concat(",", frbt-trace-actions(tail(trace))));
    // observation = (status reason recipe birth-token observation trace bytes
    //                pretokenized scannerless carrier-executed model-executed)
    def frbt-observation-node(result, trace) = intern_node(frbt-observation-category(), append(list(intern_trivial_string(frbt-result-status(result)), intern_trivial_string(frbt-result-reason(result)), frbt-result-node-or-absent(frbt-result-recipe(result)), frbt-result-node-or-absent(frbt-result-birth-token(result)), intern_trivial_int(frbt-cursor-bytes(frbt-result-cursor(result))), intern_trivial_int(0), intern_trivial_int(1), intern_trivial_int(0), intern_trivial_int(0)), trace));
    def frbt-observe(result) = {
        let trace = frbt-trace(result);
        let observation = frbt-observation-node(result, trace);
        list(frbt-result-status(result), frbt-result-reason(result), frbt-result-node-or-absent(frbt-result-recipe(result)), frbt-result-node-or-absent(frbt-result-birth-token(result)), observation, trace, frbt-cursor-bytes(frbt-result-cursor(result)), 0, 1, 0, 0);
    };
    def frbt-observation-status(o) = nth(o, 0);
    def frbt-observation-reason(o) = nth(o, 1);
    def frbt-observation-recipe(o) = nth(o, 2);
    def frbt-observation-birth-token(o) = nth(o, 3);
    def frbt-observation-token(o) = nth(o, 4);
    def frbt-observation-trace(o) = nth(o, 5);
    def frbt-observation-bytes(o) = nth(o, 6);
    def frbt-observation-pretokenized?(o) = nth(o, 7);
    def frbt-observation-scannerless?(o) = nth(o, 8);
    def frbt-observation-carrier-executed?(o) = nth(o, 9);
    def frbt-observation-model-executed?(o) = nth(o, 10);
    // ── bounded witness rendering ────────────────────────────────────
    def frbt-cat(parts) = (Comparable) len(parts) == 0 ? "" : str_concat(head(parts), frbt-cat(tail(parts)));
    def frbt-render(observation) = {
        let recipe = frbt-observation-recipe(observation);
        let present = node_eq(recipe, frbt-absent()) ? 0 : 1;
        let rendered = frbt-cat(list(frbt-observation-open(), "\nstatus=", frbt-observation-status(observation), "\nreason=", frbt-observation-reason(observation), "\nrecipe-present=", int_to_str(present), "\nrecipe-node=@", frbt-node-key(recipe), "\nbirth-node=@", frbt-node-key(frbt-observation-birth-token(observation)), "\nobservation-node=@", frbt-node-key(frbt-observation-token(observation)), "\nstream-bytes=", int_to_str(frbt-observation-bytes(observation)), "\npretokenized=", int_to_str(frbt-observation-pretokenized?(observation)), "\nscannerless=", int_to_str(frbt-observation-scannerless?(observation)), "\ncarrier-executed=", int_to_str(frbt-observation-carrier-executed?(observation)), "\nmodel-executed=", int_to_str(frbt-observation-model-executed?(observation)), "\nlifecycle=", frbt-trace-actions(frbt-observation-trace(observation)), "\n", frbt-observation-close()));
        str_len(rendered) <= frbt-max-render-bytes() ? rendered : "";
    };
    0;
}
