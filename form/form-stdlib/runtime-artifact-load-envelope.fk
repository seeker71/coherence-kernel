// runtime-artifact-load-envelope.fk -- Layer 9e runtime load request envelope.
//
// This layer re-joins selected runtime intent with the concrete source/fkb/dylib
// descriptor bundle and emits an explicit request envelope. It is still not the
// loader/executor: `request-ready` means the next layer has enough named data to
// attempt a load/walk/call, not that any artifact was loaded or succeeded.
//
// The descriptor route is used only as an identity rejoin. This cell does not
// consume `rap-plan`, re-run plan policy, choose fallbacks, read disk, hash
// bytes, reverify seals/proofs/callability, generate observations, load or walk
// `.fkb`, load or call `.dylib`, run source, emit compiler output, install a
// startup selector, or grow the C seed.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk
section [form.bml] {
    def rale-feature(name, status) = list("runtime-artifact-load-envelope-feature", name, status);
    def rale-feature-name(f) = nth(f, 1);
    def rale-feature-status(f) = nth(f, 2);
    def runtime-artifact-load-envelope-manifest() = list(rale-feature("load-envelope-not-execution", 1), rale-feature("identity-rejoin-via-sad-route-equality", 1), rale-feature("bundle-route-must-match-selection-route", 1), rale-feature("selection-or-retry-provenance", 1), rale-feature("retry-inherits-next-selection-route", 1), rale-feature("compile-source-uses-envelope-output-sentinel", 1), rale-feature("request-ready-is-not-load-success", 1), rale-feature("no-rap-plan-consumption", 1), rale-feature("no-plan-coherence-rederivation", 1), rale-feature("no-route-preference-or-fallback-policy", 1), rale-feature("no-disk-io", 1), rale-feature("no-byte-hashing", 1), rale-feature("no-seal-proof-callable-reverify", 1), rale-feature("no-observation-generation", 1), rale-feature("no-runtime-load-walk-call-exec", 1), rale-feature("no-admission-policy-or-c-seed-growth", 1));
    def runtime-artifact-load-envelope-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rale-feature-name(head(fs)) == name && (Comparable) rale-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-load-envelope-manifest-has?(name, tail(fs));
    def rale-status-request-ready() = "request-ready";
    def rale-status-investigate() = "investigate";
    def rale-status-refused() = "refused";
    def rale-reason-selected-native-envelope() = "selected-native-envelope";
    def rale-reason-selected-program-image-envelope() = "selected-program-image-envelope";
    def rale-reason-selected-compile-source-envelope() = "selected-compile-source-envelope";
    def rale-reason-retry-envelope() = "retry-envelope";
    def rale-reason-malformed-selection() = "malformed-selection";
    def rale-reason-selection-investigates() = "selection-investigates";
    def rale-reason-selection-refused() = "selection-refused";
    def rale-reason-non-selected-selection() = "non-selected-selection";
    def rale-reason-malformed-retry() = "malformed-retry";
    def rale-reason-retry-not-ready() = "retry-not-ready";
    def rale-reason-retry-next-selection-malformed() = "retry-next-selection-malformed";
    def rale-reason-invalid-descriptor-bundle() = "invalid-descriptor-bundle";
    def rale-reason-descriptor-route-mismatch() = "descriptor-route-mismatch";
    def rale-reason-route-action-mismatch() = "route-action-mismatch";
    def rale-reason-missing-artifact() = "missing-artifact";
    def rale-reason-unknown-route() = "unknown-route";
    def rale-kind-source() = "source-fk";
    def rale-kind-none() = "none";
    def rale-no-retry() = list("runtime-artifact-load-envelope-no-retry");
    def rale-no-retry?(r) = (Comparable) len(r) == 1 ? (String) nth(r, 0) == "runtime-artifact-load-envelope-no-retry" : 0;
    def rale-no-compile-output() = list("runtime-artifact-load-envelope-no-compile-output");
    def rale-no-compile-output?(o) = (Comparable) len(o) == 1 ? (String) nth(o, 0) == "runtime-artifact-load-envelope-no-compile-output" : 0;
    // envelope = ("runtime-artifact-load-envelope" source artifact action route
    //             artifact-kind artifact-path source-hash content-hash
    //             selection-provenance retry-provenance compile-output
    //             status reason)
    def rale-envelope(source, artifact, action, route, artifact-kind, artifact-path, source-hash, content-hash, selection, retry, compile-output, status, reason) = list("runtime-artifact-load-envelope", source, artifact, action, route, artifact-kind, artifact-path, source-hash, content-hash, selection, retry, compile-output, status, reason);
    def rale-envelope?(e) = (Comparable) len(e) == 14 ? (String) nth(e, 0) == "runtime-artifact-load-envelope" : 0;
    def rale-envelope-source(e) = nth(e, 1);
    def rale-envelope-artifact(e) = nth(e, 2);
    def rale-envelope-action(e) = nth(e, 3);
    def rale-envelope-route(e) = nth(e, 4);
    def rale-envelope-artifact-kind(e) = nth(e, 5);
    def rale-envelope-artifact-path(e) = nth(e, 6);
    def rale-envelope-source-hash(e) = nth(e, 7);
    def rale-envelope-content-hash(e) = nth(e, 8);
    def rale-envelope-selection(e) = nth(e, 9);
    def rale-envelope-retry(e) = nth(e, 10);
    def rale-envelope-compile-output(e) = nth(e, 11);
    def rale-envelope-status(e) = nth(e, 12);
    def rale-envelope-reason(e) = nth(e, 13);
    def rale-descriptor-kind(d) = sad-source?(d) ? rale-kind-source() : sad-artifact?(d) ? sad-artifact-kind(d) : rale-kind-none();
    def rale-descriptor-path(d) = sad-source?(d) ? sad-source-path(d) : sad-artifact?(d) ? sad-artifact-path(d) : "";
    def rale-descriptor-source-hash(d) = sad-source?(d) ? sad-source-hash(d) : sad-artifact?(d) ? sad-artifact-source-hash(d) : "";
    def rale-descriptor-content-hash(d) = sad-source?(d) ? sad-source-hash(d) : sad-artifact?(d) ? sad-artifact-content-hash(d) : "";
    def rale-empty-envelope(source, selection, retry, status, reason) = rale-envelope(source, sad-no-artifact(), rap-act-none(), sad-route-invalid(), rale-kind-none(), "", "", "", selection, retry, rale-no-compile-output(), status, reason);
    def rale-ready-envelope(source, artifact, action, route, selection, retry, reason) = rale-envelope(source, artifact, action, route, rale-descriptor-kind(artifact), rale-descriptor-path(artifact), rale-descriptor-source-hash(artifact), rale-descriptor-content-hash(artifact), selection, retry, rale-no-compile-output(), rale-status-request-ready(), reason);
    def rale-investigate-envelope(source, selection, retry, reason) = rale-empty-envelope(source, selection, retry, rale-status-investigate(), reason);
    def rale-refused-envelope(source, selection, retry, reason) = rale-empty-envelope(source, selection, retry, rale-status-refused(), reason);
    def rale-known-route?(route) = (Comparable) route == sac-run-dylib() ? 1 : (Comparable) route == sac-run-fkb() ? 1 : (Comparable) route == sac-run-source-compile() ? 1 : 0;
    def rale-route-action-match?(route, action) = (Comparable) route == sac-run-dylib() ? (String) action == rap-act-run-native() : (Comparable) route == sac-run-fkb() ? (String) action == rap-act-run-program-image() : (Comparable) route == sac-run-source-compile() ? (String) action == rap-act-compile-source() : 0;
    def rale-selection-readable?(selection) = (Comparable) len(selection) == 8 ? ras-selection?(selection) : 0;
    def rale-selected-reason(selection, retry) = !rale-no-retry?(retry) ? rale-reason-retry-envelope() : (String) ras-selection-selected(selection) == rap-act-run-native() ? rale-reason-selected-native-envelope() : (String) ras-selection-selected(selection) == rap-act-run-program-image() ? rale-reason-selected-program-image-envelope() : (String) ras-selection-selected(selection) == rap-act-compile-source() ? rale-reason-selected-compile-source-envelope() : rale-reason-route-action-mismatch();
    def rale-native-artifact-present?(dylib) = sad-artifact?(dylib) ? (String) sad-artifact-kind(dylib) == sad-kind-native-dylib() : 0;
    def rale-program-image-artifact-present?(fkb) = sad-artifact?(fkb) ? (String) sad-artifact-kind(fkb) == sad-kind-program-image-fkb() : 0;
    def rale-ready-from-route(source, fkb, dylib, route, action, selection, retry) = (Comparable) route == sac-run-dylib() ? rale-native-artifact-present?(dylib) ? rale-ready-envelope(source, dylib, action, route, selection, retry, rale-selected-reason(selection, retry)) : rale-investigate-envelope(source, selection, retry, rale-reason-missing-artifact()) : (Comparable) route == sac-run-fkb() ? rale-program-image-artifact-present?(fkb) ? rale-ready-envelope(source, fkb, action, route, selection, retry, rale-selected-reason(selection, retry)) : rale-investigate-envelope(source, selection, retry, rale-reason-missing-artifact()) : (Comparable) route == sac-run-source-compile() ? rale-ready-envelope(source, source, action, route, selection, retry, rale-selected-reason(selection, retry)) : rale-investigate-envelope(source, selection, retry, rale-reason-unknown-route());
    def rale-envelope-from-selected(source, fkb, dylib, selection, retry) = (Comparable) sad-valid?(source, fkb, dylib) == 1 ? {
        let route = sad-route(source, fkb, dylib);
        (Comparable) route == ras-selection-route(selection) ? (Comparable) rale-known-route?(route) == 1 ? (Comparable) rale-route-action-match?(route, ras-selection-selected(selection)) == 1 ? rale-ready-from-route(source, fkb, dylib, route, ras-selection-selected(selection), selection, retry) : rale-investigate-envelope(source, selection, retry, rale-reason-route-action-mismatch()) : rale-investigate-envelope(source, selection, retry, rale-reason-unknown-route()) : rale-investigate-envelope(source, selection, retry, rale-reason-descriptor-route-mismatch());
    } : rale-investigate-envelope(source, selection, retry, rale-reason-invalid-descriptor-bundle());
    def rale-envelope-from-selection(source, fkb, dylib, selection) = (Comparable) rale-selection-readable?(selection) == 1 ? ras-selected?(selection) ? rale-envelope-from-selected(source, fkb, dylib, selection, rale-no-retry()) : ras-investigate?(selection) ? rale-investigate-envelope(source, selection, rale-no-retry(), rale-reason-selection-investigates()) : ras-refused?(selection) ? rale-refused-envelope(source, selection, rale-no-retry(), rale-reason-selection-refused()) : rale-investigate-envelope(source, selection, rale-no-retry(), rale-reason-non-selected-selection()) : rale-refused-envelope(source, selection, rale-no-retry(), rale-reason-malformed-selection());
    def rale-retry-refused-status?(retry) = (String) rar-retry-status(retry) == rar-status-refused() ? 1 : (String) rar-retry-status(retry) == rar-status-terminal-refused() ? 1 : 0;
    def rale-envelope-from-retry-not-ready(source, retry) = (Comparable) rale-retry-refused-status?(retry) == 1 ? rale-refused-envelope(source, rar-retry-next-selection(retry), retry, rale-reason-retry-not-ready()) : rale-investigate-envelope(source, rar-retry-next-selection(retry), retry, rale-reason-retry-not-ready());
    def rale-envelope-from-retry(source, fkb, dylib, retry) = rar-retry?(retry) ? (String) rar-retry-status(retry) == rar-status-retry-ready() ? {
        let selection = rar-retry-next-selection(retry);
        (Comparable) rale-selection-readable?(selection) == 1 && ras-selected?(selection) ? rale-envelope-from-selected(source, fkb, dylib, selection, retry) : rale-investigate-envelope(source, selection, retry, rale-reason-retry-next-selection-malformed());
    } : rale-envelope-from-retry-not-ready(source, retry) : rale-refused-envelope(source, list("runtime-artifact-load-envelope-malformed-selection"), retry, rale-reason-malformed-retry());
}
