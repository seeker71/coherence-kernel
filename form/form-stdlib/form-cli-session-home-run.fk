; form-cli-session-home-run.fk — interned gifts seed the adapter; Qwen stays frozen.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-cli-local-ready.bml
; preludes: form-cli-one-turn.bml
; preludes: form-cli-session-local.bml
; preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-cli-lora-writer.bml
; preludes: form-stdlib/walk-home.fk
; preludes: form-cli-session-home.bml
; preludes: form-stdlib/form-cli-model-session.fk

(do
    (let fuel (fsh-fuel))
    (let wrote (fsh-write-from-fuel (fsh-path) fuel (Dim)))
    (print_str (str_concat "fsh check=" (str_concat (int_to_str (fsh-check)) "\n")))
    (print_str (str_concat "fsh fuel=" (str_concat fuel "\n")))
    (print_str (str_concat "fsh transcript-mark=" (str_concat (int_to_str (fsh-transcript-mark fuel)) "\n")))
    (print_str (str_concat "fsh written=" (str_concat (int_to_str (flw-written (fsh-path))) "\n")))
    (print_str (str_concat "fsh fqt-lora=" (str_concat (int_to_str (FqtLora)) "\n")))
    (print_str (str_concat "fsh reencode=" (str_concat (int_to_str (ReencodeTranscript)) "\n")))
    (print_str (str_concat "fsh home=" (str_concat (int_to_str (fsh-home 1 1 0 1)) "\n")))
    (print_str (str_concat "fsh ppm=" (str_concat (int_to_str (fsh-ppm (ThisNative) (ThisLocal) (ThisRemote))) "\n")))
    (print_str (str_concat "fsh encode-scope=" (str_concat (fcms-initial-encode-scope) "\n")))
    0)
