; form-program-image-full-pif-call-adapter.fk -- carry a full admitted PIF
; through the generic content-addressed CALL_BINDING / OFFER / ACK protocol.
;
; The landed compact protocol remains unchanged.  This companion uses the
; same category-132/133/134/135 call, registry, offer, and acknowledgement
; meanings with adapter-specific validators.  Each program binding retains
; the actual pirc recipe NodeID, never an executable compact proxy.  A receiver
; row retains the raw envelope/admission/request and proves that its admitted
; PIF recreates that exact recipe before invoking the existing full typed
; symbol walker.  No source symbol or full-PIF opcode becomes a compact
; evaluator branch.
;
; One OFFER value is one recursively typed full-PIF argument.  The outer
; fpcp list wrapper makes a successful full-PIF `nothing` a present output,
; distinct from ACK no-output.  Lists and native-node values retain the exact
; recursive rpmw kind tree rather than collapsing into fpcp kind 3 or 4.
;
; The adapter is pure Form.  It performs no filesystem, host, model, Metal,
; network, persistence, C, flatten, or global operation-table action.  Fuel is
; passed unchanged to rpsw; validation and registry traversal are not claimed
; as walker steps.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-ontology-bp.fk
; preludes: form-stdlib/source-artifact-cache.fk
; preludes: form-stdlib/source-artifact-descriptor.fk
; preludes: form-stdlib/runtime-artifact-plan.fk
; preludes: form-stdlib/runtime-artifact-selector.fk
; preludes: form-stdlib/runtime-artifact-outcome.fk
; preludes: form-stdlib/runtime-artifact-retry.fk
; preludes: form-stdlib/runtime-artifact-load-envelope.fk
; preludes: form-stdlib/program-image-fkb.fk
; preludes: form-stdlib/program-image-fkb-byte-container.fk
; preludes: form-stdlib/program-image-fkb-byte-file-witness.fk
; preludes: form-stdlib/program-image-fkb-byte-decode.fk
; preludes: form-stdlib/runtime-program-image-fkb-attempt.fk
; preludes: form-stdlib/program-image-symbol-entry.fk
; preludes: form-stdlib/runtime-program-image-fkb-walker-trace.fk
; preludes: form-stdlib/reason-coverage.fk
; preludes: form-stdlib/runtime-program-image-fkb-micro-walker.fk
; preludes: form-stdlib/runtime-program-image-fkb-symbol-walk.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk
; preludes: form-stdlib/form-program-image-call-protocol.fk
; Proven by: form-stdlib/tests/form-program-image-full-pif-call-adapter-band.fk

(do
    (defn fpcpf-version () "form-program-image-full-pif-call-adapter-v1")
    (defn fpcpf-kind-role () "full-pif-recursive-kind-v1")
    (defn fpcpf-binding-role () "full-pif-program-binding-v1")
    (defn fpcpf-no-walk ()
        (list "form-program-image-full-pif-call-no-symbol-walk"))
    (defn fpcpf-no-walk? (walk)
        (if (eq (len walk) 1)
            (str_eq (head walk)
                "form-program-image-full-pif-call-no-symbol-walk") 0))

    ; The exact PIRC address schema, factored locally because the historical
    ; carrierability cell also references value_kind (a foreign-lane gate).
    ; These constructors produce the same recipe NodeID as
    ; pirc-envelope-recipe without importing that unrelated validator.
    (defn fpcpf-pirc-bp (name) (bp name))
    (defn fpcpf-pirc-int-nodes (values)
        (if (nil? values) (empty)
            (cons (intern_trivial_int (head values))
                  (fpcpf-pirc-int-nodes (tail values)))))
    (defn fpcpf-pirc-node-row (row)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-NODE-ROW")
            (fpcpf-pirc-int-nodes row)))
    (defn fpcpf-pirc-node-row-list (rows)
        (if (nil? rows) (empty)
            (cons (fpcpf-pirc-node-row (head rows))
                  (fpcpf-pirc-node-row-list (tail rows)))))
    (defn fpcpf-pirc-string-row (row)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-STRING-ROW")
            (fpcpf-pirc-int-nodes row)))
    (defn fpcpf-pirc-string-row-list (rows)
        (if (nil? rows) (empty)
            (cons (fpcpf-pirc-string-row (head rows))
                  (fpcpf-pirc-string-row-list (tail rows)))))
    (defn fpcpf-pirc-symbol-row (row)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-SYMBOL-ROW")
            (list
                (intern_trivial_int (pif-symbol-row-id row))
                (intern_trivial_string (pif-symbol-row-key row)))))
    (defn fpcpf-pirc-symbol-row-list (rows)
        (if (nil? rows) (empty)
            (cons (fpcpf-pirc-symbol-row (head rows))
                  (fpcpf-pirc-symbol-row-list (tail rows)))))
    (defn fpcpf-pirc-dependency (target)
        (intern_node
            (fpcpf-pirc-bp
                "PROGRAM-IMAGE-RECIPE-SYMBOL-DEPENDENCY-TARGET")
            (list
                (intern_trivial_int
                    (pif-symbol-dependency-target-symbol target))
                (intern_trivial_int
                    (pif-symbol-dependency-target-node target)))))
    (defn fpcpf-pirc-dependency-list (targets)
        (if (nil? targets) (empty)
            (cons (fpcpf-pirc-dependency (head targets))
                  (fpcpf-pirc-dependency-list (tail targets)))))
    (defn fpcpf-pirc-dependencies (targets)
        (intern_node
            (fpcpf-pirc-bp
                "PROGRAM-IMAGE-RECIPE-SYMBOL-DEPENDENCY-TARGETS")
            (fpcpf-pirc-dependency-list targets)))
    (defn fpcpf-pirc-node-symbol-row (row)
        (intern_node
            (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-NODE-SYMBOL-ROW")
            (list
                (intern_trivial_int (pif-node-symbol-row-node row))
                (intern_trivial_int (pif-node-symbol-row-defined row))
                (fpcpf-pirc-dependencies
                    (pif-node-symbol-row-dependency-targets row)))))
    (defn fpcpf-pirc-node-symbol-row-list (rows)
        (if (nil? rows) (empty)
            (cons (fpcpf-pirc-node-symbol-row (head rows))
                  (fpcpf-pirc-node-symbol-row-list (tail rows)))))
    (defn fpcpf-pirc-symbol-image (image)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-SYMBOL-IMAGE")
            (list
                (intern_trivial_int (pif-symbol-image-count image))
                (intern_node
                    (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-SYMBOL-ROWS")
                    (fpcpf-pirc-symbol-row-list
                        (pif-symbol-image-rows image)))
                (intern_trivial_int (pif-symbol-image-node-count image))
                (intern_node
                    (fpcpf-pirc-bp
                        "PROGRAM-IMAGE-RECIPE-NODE-SYMBOL-ROWS")
                    (fpcpf-pirc-node-symbol-row-list
                        (pif-symbol-image-node-rows image))))))
    (defn fpcpf-pirc-table (table)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-TABLE")
            (list
                (intern_trivial_int (pif-table-nf table))
                (intern_node
                    (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-FN-ROOTS")
                    (fpcpf-pirc-int-nodes (pif-table-fn-roots table)))
                (intern_trivial_int (pif-table-nr table))
                (intern_node
                    (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-NODE-ROWS")
                    (fpcpf-pirc-node-row-list
                        (pif-table-node-rows table)))
                (intern_trivial_int (pif-table-ns table))
                (intern_node
                    (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-STRING-ROWS")
                    (fpcpf-pirc-string-row-list
                        (pif-table-string-byte-rows table))))))
    (defn fpcpf-pirc-envelope (pif)
        (intern_node (fpcpf-pirc-bp "PROGRAM-IMAGE-RECIPE-ENVELOPE")
            (list
                (intern_trivial_string (pif-envelope-version pif))
                (intern_trivial_string (pif-envelope-source-path pif))
                (intern_trivial_string (pif-envelope-source-hash pif))
                (intern_trivial_int (pif-envelope-source-mtime pif))
                (intern_trivial_string (pif-envelope-artifact-path pif))
                (intern_trivial_string (pif-envelope-content-hash pif))
                (intern_trivial_int (pif-envelope-artifact-mtime pif))
                (intern_trivial_int (pif-envelope-seal-ok pif))
                (fpcpf-pirc-table (pif-envelope-table pif))
                (fpcpf-pirc-symbol-image (pif-envelope-symbol-image pif)))))

    ; A recursively interned kind node is canonical iff decoding and
    ; re-encoding yields the identical NodeID.
    (defn fpcpf-kind-nodes (kinds)
        (if (nil? kinds) (empty)
            (cons (fpcpf-kind-node (head kinds))
                  (fpcpf-kind-nodes (tail kinds)))))
    (defn fpcpf-kind-node (kind)
        (if (not (rpmw-kind-valid? kind)) (nothing)
            (fcatw-sequence (fpcpf-kind-role)
                (cons (intern_trivial_string (rpmw-kind-name kind))
                      (fpcpf-kind-nodes (rpmw-kind-children kind))))))
    (defn fpcpf-kinds-from-nodes (nodes)
        (if (nil? nodes) (empty)
            (cons (fpcpf-kind-from-node (head nodes))
                  (fpcpf-kinds-from-nodes (tail nodes)))))
    (defn fpcpf-kind-from-node (node)
        (do
            (let values (fcatw-sequence-values node))
            (rpmw-kind-row (node_value (head values))
                (fpcpf-kinds-from-nodes (tail values)))))
    (defn fpcpf-kind-nodes-valid? (nodes)
        (if (nil? nodes) 1
            (if (eq (fpcpf-kind-node-valid? (head nodes)) 1)
                (fpcpf-kind-nodes-valid? (tail nodes)) 0)))
    (defn fpcpf-kind-node-valid? (node)
        (if (nothing? node) 0
        (if (eq (fcatw-sequence-is? node (fpcpf-kind-role)) 0) 0
            (do
                (let values (fcatw-sequence-values node))
                (if (nil? values) 0
                (if (not (eq (node_type (head values)) 2)) 0
                (if (eq (fpcpf-kind-nodes-valid? (tail values)) 0) 0
                    (do
                        (let kind (fpcpf-kind-from-node node))
                        (if (not (rpmw-kind-valid? kind)) 0
                            (if (node_eq node (fpcpf-kind-node kind))
                                1 0))))))))))

    (defn fpcpf-kinds-equal? (a b)
        (if (nil? a) (if (nil? b) 1 0)
        (if (nil? b) 0
            (if (rpmw-kind-equal? (head a) (head b))
                (fpcpf-kinds-equal? (tail a) (tail b)) 0))))
    (defn fpcpf-values-for-kinds (kinds values)
        (if (nil? kinds) (empty)
            (cons (fpcpf-value (head kinds) (head values))
                  (fpcpf-values-for-kinds
                    (tail kinds) (tail values)))))

    ; A full value is an ordinary valid fpcp list value containing exactly
    ; [canonical-kind-node, payload].  That keeps all existing OFFER and ACK
    ; structural guards active while extending type provenance in data.
    (defn fpcpf-value (kind value)
        (if (not (rpmw-kind-valid? kind)) (nothing)
        (if (rpmw-kind-named? kind "absent") (nothing)
            (do
                (let payload
                    (if (rpmw-kind-named? kind "int")
                        (fpcp-value (fcatw-kind-int) value)
                    (if (rpmw-kind-named? kind "string")
                        (fpcp-value (fcatw-kind-string) value)
                    (if (rpmw-kind-named? kind "nothing")
                        (fpcp-value (fcatw-kind-nothing) (nothing))
                    (if (rpmw-kind-named? kind "list")
                        (if (nothing? value) (nothing)
                        (if (eq (len (rpmw-kind-children kind)) (len value))
                            (fpcp-value (fcatw-kind-list)
                                (fpcpf-values-for-kinds
                                    (rpmw-kind-children kind) value))
                            (nothing)))
                    (if (rpmw-native-node? kind)
                        (fpcp-value (fcatw-kind-node) value)
                        (nothing)))))))
                (if (nothing? payload) (nothing)
                    (fpcp-value (fcatw-kind-list)
                        (list
                            (fpcp-value (fcatw-kind-node)
                                (fpcpf-kind-node kind))
                            payload)))))))
    (defn fpcpf-value-parts (value)
        (fcatw-sequence-values (fpcp-child value 1)))
    (defn fpcpf-value-kind-node (value)
        (fpcp-value-raw (head (fpcpf-value-parts value))))
    (defn fpcpf-value-kind (value)
        (fpcpf-kind-from-node (fpcpf-value-kind-node value)))
    (defn fpcpf-value-payload (value)
        (nth (fpcpf-value-parts value) 1))
    (defn fpcpf-value-list-raw (values)
        (if (nil? values) (empty)
            (cons (fpcpf-value-raw (head values))
                  (fpcpf-value-list-raw (tail values)))))
    (defn fpcpf-value-raw (value)
        (do
            (let kind (fpcpf-value-kind value))
            (let payload (fpcpf-value-payload value))
            (if (rpmw-kind-named? kind "list")
                (fpcpf-value-list-raw
                    (fcatw-sequence-values (fpcp-child payload 1)))
                (fpcp-value-raw payload))))

    (defn fpcpf-native-children-valid? (kinds children)
        (if (nil? kinds) (if (nil? children) 1 0)
        (if (nil? children) 0
            (if (fpcpf-native-value-valid? (head kinds) (head children))
                (fpcpf-native-children-valid?
                    (tail kinds) (tail children)) 0))))
    (defn fpcpf-native-value-valid? (kind value)
        (if (rpmw-nodeid? kind) 1
        (if (rpmw-trivial-int-node? kind)
            (if (and (eq (node_level value) 1)
                     (eq (node_type value) 1)) 1 0)
        (if (rpmw-trivial-string-node? kind)
            (if (and (eq (node_level value) 1)
                     (eq (node_type value) 2)) 1 0)
        (if (rpmw-composite-node? kind)
            (if (eq (node_level value) 1) 0
                (fpcpf-native-children-valid?
                    (rpmw-kind-children kind) (node_children value)))
            0)))))
    (defn fpcpf-list-values-valid? (kinds values)
        (if (nil? kinds) (if (nil? values) 1 0)
        (if (nil? values) 0
            (if (and (fpcpf-value-valid? (head values))
                     (rpmw-kind-equal?
                        (fpcpf-value-kind (head values)) (head kinds)))
                (fpcpf-list-values-valid?
                    (tail kinds) (tail values)) 0))))
    (defn fpcpf-value-valid-for-kind? (value kind)
        (if (eq (fpcp-value-valid? value) 0) 0
        (if (rpmw-kind-named? kind "int")
            (if (eq (fpcp-value-kind value) (fcatw-kind-int)) 1 0)
        (if (rpmw-kind-named? kind "string")
            (if (eq (fpcp-value-kind value) (fcatw-kind-string)) 1 0)
        (if (rpmw-kind-named? kind "nothing")
            (if (eq (fpcp-value-kind value) (fcatw-kind-nothing)) 1 0)
        (if (rpmw-kind-named? kind "list")
            (if (not (eq (fpcp-value-kind value) (fcatw-kind-list))) 0
                (fpcpf-list-values-valid?
                    (rpmw-kind-children kind)
                    (fcatw-sequence-values (fpcp-child value 1))))
        (if (rpmw-native-node? kind)
            (if (not (eq (fpcp-value-kind value) (fcatw-kind-node))) 0
                (fpcpf-native-value-valid? kind (fpcp-value-raw value)))
            0)))))))
    (defn fpcpf-value-valid? (value)
        (if (eq (fpcp-value-valid? value) 0) 0
        (if (not (eq (fpcp-value-kind value) (fcatw-kind-list))) 0
            (do
                (let parts (fpcpf-value-parts value))
                (if (not (eq (len parts) 2)) 0
                (if (not (eq (fpcp-value-kind (head parts))
                             (fcatw-kind-node))) 0
                (if (eq (fpcpf-kind-node-valid?
                            (fpcp-value-raw (head parts))) 0) 0
                    (do
                        (let kind (fpcpf-value-kind value))
                        (if (rpmw-kind-named? kind "absent") 0
                            (fpcpf-value-valid-for-kind?
                                (nth parts 1) kind))))))))))

    ; Binding is [symbol, actual recursively content-addressed PIF recipe].
    ; The receiver retains raw resources separately so an address never gains
    ; authority without revalidation against the body that produced it.
    (defn fpcpf-binding (symbol recipe)
        (fcatw-sequence (fpcpf-binding-role)
            (list (intern_trivial_string symbol) recipe)))
    (defn fpcpf-binding-symbol (binding)
        (node_value (head (fcatw-sequence-values binding))))
    (defn fpcpf-binding-recipe (binding)
        (nth (fcatw-sequence-values binding) 1))
    (defn fpcpf-binding-valid? (binding)
        (if (nothing? binding) 0
        (if (eq (fcatw-sequence-is? binding (fpcpf-binding-role)) 0) 0
            (do
                (let values (fcatw-sequence-values binding))
                (if (not (eq (len values) 2)) 0
                (if (not (eq (node_type (head values)) 2)) 0
                (if (not (gt (str_len (node_value (head values))) 0)) 0
                    (if (nothing? (nth values 1)) 0 1))))))))

    (defn fpcpf-call-binding (caller call-name callee capability)
        (intern_node (fpcp-category 132)
            (list caller (intern_trivial_string call-name)
                  callee capability)))
    (defn fpcpf-call-valid? (call)
        (if (nothing? call) 0
        (if (not (node_eq (node_category call) (fpcp-category 132))) 0
        (if (not (eq (len (node_children call)) 4)) 0
        (if (eq (fpcpf-binding-valid? (fpcp-child call 0)) 0) 0
        (if (not (eq (node_type (fpcp-child call 1)) 2)) 0
        (if (not (gt (str_len (node_value (fpcp-child call 1))) 0)) 0
        (if (eq (fpcpf-binding-valid? (fpcp-child call 2)) 0) 0
            (if (nothing? (fpcp-child call 3)) 0 1)))))))))
    (defn fpcpf-binding-present? (bindings binding)
        (if (nil? bindings) 0
            (if (node_eq (head bindings) binding) 1
                (fpcpf-binding-present? (tail bindings) binding))))
    (defn fpcpf-bindings-valid? (bindings)
        (if (nil? bindings) 1
            (if (fpcpf-binding-valid? (head bindings))
                (fpcpf-bindings-valid? (tail bindings)) 0)))
    (defn fpcpf-calls-valid? (calls bindings)
        (if (nil? calls) 1
            (if (and (fpcpf-call-valid? (head calls))
                (and (fpcpf-binding-present? bindings
                        (fpcp-child (head calls) 0))
                     (fpcpf-binding-present? bindings
                        (fpcp-child (head calls) 2))))
                (fpcpf-calls-valid? (tail calls) bindings) 0)))
    (defn fpcpf-registry (bindings grants calls)
        (intern_node (fpcp-category 133)
            (list
                (fcatw-sequence "full-pif-program-bindings-v1" bindings)
                (fcatw-sequence "call-capability-grants-v1" grants)
                (fcatw-sequence "full-pif-call-bindings-v1" calls))))
    (defn fpcpf-registry-bindings (registry)
        (fcatw-sequence-values (fpcp-child registry 0)))
    (defn fpcpf-registry-grants (registry)
        (fcatw-sequence-values (fpcp-child registry 1)))
    (defn fpcpf-registry-calls (registry)
        (fcatw-sequence-values (fpcp-child registry 2)))
    (defn fpcpf-registry-valid? (registry)
        (if (nothing? registry) 0
        (if (not (node_eq (node_category registry) (fpcp-category 133))) 0
        (if (not (eq (len (node_children registry)) 3)) 0
        (if (eq (fcatw-sequence-is? (fpcp-child registry 0)
                    "full-pif-program-bindings-v1") 0) 0
        (if (eq (fcatw-sequence-is? (fpcp-child registry 1)
                    "call-capability-grants-v1") 0) 0
        (if (eq (fcatw-sequence-is? (fpcp-child registry 2)
                    "full-pif-call-bindings-v1") 0) 0
            (do
                (let bindings (fpcpf-registry-bindings registry))
                (if (eq (fpcpf-bindings-valid? bindings) 0) 0
                    (fpcpf-calls-valid?
                        (fpcpf-registry-calls registry) bindings))))))))))
    (defn fpcpf-offer (call correlation values fuel)
        (intern_node (fpcp-category 134)
            (list call correlation
                (fcatw-sequence "call-offer-values-v1" values)
                (intern_trivial_int fuel))))
    (defn fpcpf-offer-valid? (offer)
        (if (nothing? offer) 0
        (if (not (node_eq (node_category offer) (fpcp-category 134))) 0
        (if (not (eq (len (node_children offer)) 4)) 0
        (if (eq (fpcpf-call-valid? (fpcp-child offer 0)) 0) 0
        (if (nothing? (fpcp-child offer 1)) 0
        (if (eq (fcatw-sequence-is? (fpcp-child offer 2)
                    "call-offer-values-v1") 0) 0
        (if (not (eq (node_type (fpcp-child offer 3)) 1)) 0
        (if (lt (node_value (fpcp-child offer 3)) 0) 0
            (fpcp-values-valid?
                (fcatw-sequence-values (fpcp-child offer 2))))))))))))
    (defn fpcpf-offer-values (offer)
        (fcatw-sequence-values (fpcp-child offer 2)))

    ; receiver = exact full binding plus the raw resources required to
    ; recompute it and execute.  The canonical-key request is the binding
    ; symbol, so a swapped request cannot borrow the same recipe address.
    (defn fpcpf-receiver (binding envelope admission request)
        (list "form-program-image-full-pif-call-receiver"
              binding envelope admission request))
    (defn fpcpf-receiver? (receiver)
        (if (eq (len receiver) 5)
            (str_eq (nth receiver 0)
                "form-program-image-full-pif-call-receiver") 0))
    (defn fpcpf-receiver-binding (receiver) (nth receiver 1))
    (defn fpcpf-receiver-envelope (receiver) (nth receiver 2))
    (defn fpcpf-receiver-admission (receiver) (nth receiver 3))
    (defn fpcpf-receiver-request (receiver) (nth receiver 4))
    (defn fpcpf-receiver-valid? (receiver)
        (if (not (fpcpf-receiver? receiver)) 0
            (do
                (let binding (fpcpf-receiver-binding receiver))
                (let envelope (fpcpf-receiver-envelope receiver))
                (let admission (fpcpf-receiver-admission receiver))
                (let request (fpcpf-receiver-request receiver))
                (if (not (fpcpf-binding-valid? binding)) 0
                (if (not (rale-envelope? envelope)) 0
                (if (not (pifbd-admission? admission)) 0
                (if (not (pise-request? request)) 0
                (if (not (str_eq (pise-request-mode request)
                                 (pise-mode-canonical-key))) 0
                (if (not (str_eq (pise-request-canonical-key request)
                                 (fpcpf-binding-symbol binding))) 0
                (if (not (rpmw-admission-status-admitted? admission)) 0
                (if (not (rpmw-admission-decode-decoded? admission)) 0
                (if (not (rpmw-admission-pif-valid? admission)) 0
                (if (not (rpmw-admission-decode-matches-pif? admission)) 0
                (if (not (rpmw-pif-matches-envelope? envelope
                            (pifbd-admission-pif admission))) 0
                    (if (node_eq (fpcpf-binding-recipe binding)
                            (fpcpf-pirc-envelope
                                (pifbd-admission-pif admission)))
                        1 0)))))))))))))))

    ; The companion receipt retains both the FPCP acknowledgement and the
    ; actual full symbol-walk.  The latter is evidence, not supplied authority:
    ; fpcpf-receipt-observed? recomputes the full call from receiver-held data.
    (defn fpcpf-receipt (protocol offer ack walk)
        (list (fpcpf-version) protocol offer ack walk))
    (defn fpcpf-receipt? (receipt)
        (if (eq (len receipt) 5)
            (str_eq (nth receipt 0) (fpcpf-version)) 0))
    (defn fpcpf-receipt-protocol (receipt) (nth receipt 1))
    (defn fpcpf-receipt-offer (receipt) (nth receipt 2))
    (defn fpcpf-receipt-ack (receipt) (nth receipt 3))
    (defn fpcpf-receipt-symbol-walk (receipt) (nth receipt 4))

    (defn fpcpf-empty-ack-value? (value)
        (if (fpcp-value-valid? value)
            (if (eq (fpcp-value-kind value) (fcatw-kind-nothing)) 1 0)
            0))
    (defn fpcpf-refusal-reason? (reason)
        (if (str_eq reason "offer-malformed") 1
        (if (str_eq reason "protocol-registry-malformed") 1
        (if (str_eq reason "capability-refused") 1
            (if (str_eq reason "offer-abi-refused") 1 0)))))
    (defn fpcpf-ack-fields-valid?
        (status reason value steps output trace)
        (if (str_eq status "returned")
            (if (not (str_eq reason "resident-thought-returned")) 0
            (if (not (eq output 1)) 0
            (if (not (fpcpf-value-valid? value)) 0
                (if (str_eq trace
                        "offer,resolve,call,return,ack,release") 1 0))))
        (if (not (fpcpf-empty-ack-value? value)) 0
        (if (not (eq output 0)) 0
        (if (str_eq status "refused")
            (if (not (fpcpf-refusal-reason? reason)) 0
            (if (not (eq steps 0)) 0
                (if (str_eq trace "offer,refused,ack,release") 1 0)))
        (if (str_eq status "nothing")
            (if (not (or (str_eq reason "call-binding-not-admitted")
                         (str_eq reason "symbol-not-found"))) 0
            (if (not (eq steps 0)) 0
                (if (str_eq trace "offer,nothing,ack,release") 1 0)))
        (if (str_eq status "choice")
            (if (not (str_eq reason "ambiguous-symbol")) 0
            (if (not (eq steps 0)) 0
                (if (str_eq trace "offer,choice,ack,release") 1 0)))
        (if (str_eq status "timeout")
            (if (not (str_eq reason "walker-fuel-exhausted")) 0
                (if (str_eq trace
                        "offer,resolve,call,timeout,ack,release") 1 0))
        (if (str_eq status "failure")
            (if (not (gt (str_len reason) 0)) 0
                (if (str_eq trace
                        "offer,resolve,call,failure,ack,release") 1 0))
            0)))))))))
    (defn fpcpf-ack-valid? (ack)
        (if (nothing? ack) 0
        (if (not (node_eq (node_category ack) (fpcp-category 135))) 0
        (if (not (eq (len (node_children ack)) 7)) 0
        (if (not (eq (node_type (fpcp-child ack 1)) 2)) 0
        (if (not (eq (node_type (fpcp-child ack 2)) 2)) 0
        (if (not (eq (node_type (fpcp-child ack 4)) 1)) 0
        (if (not (eq (node_type (fpcp-child ack 5)) 1)) 0
        (if (not (eq (node_type (fpcp-child ack 6)) 2)) 0
            (do
                (let offer (fpcp-child ack 0))
                (let status (fpcp-ack-status ack))
                (let reason (fpcp-ack-reason ack))
                (let steps (fpcp-ack-steps ack))
                (let malformed (and (str_eq status "refused")
                                     (str_eq reason "offer-malformed")))
                (if (not (or malformed (fpcpf-offer-valid? offer))) 0
                (if (not (if malformed (eq steps 0)
                        (and (ge steps 0)
                             (le steps
                                (node_value (fpcp-child offer 3)))))) 0
                    (fpcpf-ack-fields-valid? status reason
                        (fpcp-ack-value ack) steps
                        (fpcp-ack-output ack)
                        (fpcp-ack-trace ack))))))))))))))

    (defn fpcpf-empty-receipt (protocol offer status reason trace)
        (fpcpf-receipt protocol offer
            (fpcp-empty-ack offer status reason trace)
            (fpcpf-no-walk)))
    (defn fpcpf-result-receipt (protocol offer walk)
        (do
            (let micro (rpsw-receipt-micro-walk walk))
            (let trace (rpsw-receipt-trace walk))
            (let result (rpmw-receipt-result micro))
            (let steps (rpiwt-trace-steps-used trace))
            (if (str_eq (rpmw-result-trace-status result) (rao-obs-ok))
                (do
                    (let value (fpcpf-value
                        (rpmw-result-kind result)
                        (rpmw-result-value result)))
                    (if (eq (fpcpf-value-valid? value) 0)
                        (fpcpf-receipt protocol offer
                            (fpcp-ack offer "failure"
                                "full-pif-return-kind-mismatch"
                                (fpcp-value (fcatw-kind-nothing) (nothing))
                                steps 0
                                "offer,resolve,call,failure,ack,release")
                            walk)
                        (fpcpf-receipt protocol offer
                            (fpcp-ack offer "returned"
                                "resident-thought-returned" value
                                steps 1
                                "offer,resolve,call,return,ack,release")
                            walk)))
            (if (str_eq (rpmw-result-trace-status result)
                        (rao-obs-timeout))
                (fpcpf-receipt protocol offer
                    (fpcp-ack offer "timeout" "walker-fuel-exhausted"
                        (fpcp-value (fcatw-kind-nothing) (nothing))
                        steps 0
                        "offer,resolve,call,timeout,ack,release")
                    walk)
                (fpcpf-receipt protocol offer
                    (fpcp-ack offer "failure" (rpmw-result-reason result)
                        (fpcp-value (fcatw-kind-nothing) (nothing))
                        steps 0
                        "offer,resolve,call,failure,ack,release")
                    walk)))))
    (defn fpcpf-walk-receipt (protocol offer envelope admission request value)
        (do
            (let walk (rpsw-walk-symbol-with-kind
                envelope admission request
                (node_value (fpcp-child offer 3))
                (fpcpf-value-raw value)
                (fpcpf-value-kind value)))
            (if (not (rpsw-receipt? walk))
                (fpcpf-receipt protocol offer
                    (fpcp-empty-ack offer "failure"
                        "malformed-full-pif-symbol-walk"
                        "offer,resolve,call,failure,ack,release") walk)
            (if (str_eq (rpsw-receipt-status walk)
                        (rpsw-status-trace-produced))
                (if (rpsw-receipt-agrees? walk)
                    (fpcpf-result-receipt protocol offer walk)
                    (fpcpf-receipt protocol offer
                        (fpcp-empty-ack offer "failure"
                            "full-pif-symbol-walk-disagrees"
                            "offer,resolve,call,failure,ack,release") walk))
            (if (str_eq (rpsw-receipt-reason walk)
                        (pise-reason-canonical-key-not-found))
                (fpcpf-receipt protocol offer
                    (fpcp-empty-ack offer "nothing" "symbol-not-found"
                        "offer,nothing,ack,release") walk)
            (if (str_eq (rpsw-receipt-reason walk)
                        (pise-reason-duplicate-canonical-key))
                (fpcpf-receipt protocol offer
                    (fpcp-empty-ack offer "choice" "ambiguous-symbol"
                        "offer,choice,ack,release") walk)
            (if (str_eq (rpsw-receipt-status walk) (rpsw-status-refused))
                (fpcpf-receipt protocol offer
                    (fpcp-empty-ack offer "refused" "offer-abi-refused"
                        "offer,refused,ack,release") walk)
                (fpcpf-receipt protocol offer
                    (fpcp-empty-ack offer "failure"
                        (rpsw-receipt-reason walk)
                        "offer,resolve,call,failure,ack,release")
                    walk))))))))

    (defn fpcpf-binding-matches (bindings symbol)
        (if (nil? bindings) (empty)
            (if (and (fpcpf-binding-valid? (head bindings))
                     (str_eq (fpcpf-binding-symbol (head bindings)) symbol))
                (cons (head bindings)
                    (fpcpf-binding-matches (tail bindings) symbol))
                (fpcpf-binding-matches (tail bindings) symbol))))
    (defn fpcpf-resolve (registry symbol)
        (do
            (let matches (fpcpf-binding-matches
                (fpcpf-registry-bindings registry) symbol))
            (if (nil? matches) (list "nothing" "symbol-not-found" (nothing))
            (if (gt (len matches) 1)
                (list "choice" "ambiguous-symbol" (nothing))
                (list "ready" "full-pif-binding-resolved" (head matches))))))
    (defn fpcpf-call-present? (calls call)
        (if (nil? calls) 0
            (if (node_eq (head calls) call) 1
                (fpcpf-call-present? (tail calls) call))))

    (defn fpcpf-execute (protocol offer receiver)
        (if (nothing? offer) (nothing)
        (if (eq (fpcpf-offer-valid? offer) 0)
            (fpcpf-empty-receipt protocol offer "refused" "offer-malformed"
                "offer,refused,ack,release")
        (if (eq (fpcpf-registry-valid? protocol) 0)
            (fpcpf-empty-receipt protocol offer "refused"
                "protocol-registry-malformed" "offer,refused,ack,release")
            (do
                (let call (fpcp-child offer 0))
                (if (eq (fpcpf-call-present?
                        (fpcpf-registry-calls protocol) call) 0)
                    (fpcpf-empty-receipt protocol offer "nothing"
                        "call-binding-not-admitted"
                        "offer,nothing,ack,release")
                (if (eq (fpcpf-binding-present?
                        (fpcpf-registry-grants protocol)
                        (fpcp-child call 3)) 0)
                    (fpcpf-empty-receipt protocol offer "refused"
                        "capability-refused" "offer,refused,ack,release")
                    (do
                        (let callee (fpcp-child call 2))
                        (let resolution (fpcpf-resolve protocol
                            (fpcpf-binding-symbol callee)))
                        (if (str_eq (nth resolution 0) "choice")
                            (fpcpf-empty-receipt protocol offer "choice"
                                "ambiguous-symbol"
                                "offer,choice,ack,release")
                        (if (not (str_eq (nth resolution 0) "ready"))
                            (fpcpf-empty-receipt protocol offer
                                (nth resolution 0) (nth resolution 1)
                                (if (str_eq (nth resolution 0) "nothing")
                                    "offer,nothing,ack,release"
                                    "offer,resolve,call,failure,ack,release"))
                        (if (or (not (node_eq (nth resolution 2) callee))
                                (not (fpcpf-receiver-valid? receiver)))
                            (fpcpf-empty-receipt protocol offer
                                "failure" "full-pif-binding-mismatch"
                                "offer,resolve,call,failure,ack,release")
                        (if (not (node_eq
                                (fpcpf-receiver-binding receiver) callee))
                                    (fpcpf-empty-receipt protocol offer
                                        "failure" "full-pif-binding-mismatch"
                                        "offer,resolve,call,failure,ack,release")
                            (do
                                (let values (fpcpf-offer-values offer))
                                (if (not (eq (len values) 1))
                                    (fpcpf-empty-receipt protocol offer
                                        "refused" "offer-abi-refused"
                                        "offer,refused,ack,release")
                                (if (eq (fpcpf-value-valid?
                                        (head values)) 0)
                                    (fpcpf-empty-receipt protocol offer
                                        "refused" "offer-abi-refused"
                                        "offer,refused,ack,release")
                                    (fpcpf-walk-receipt protocol offer
                                        (fpcpf-receiver-envelope receiver)
                                        (fpcpf-receiver-admission receiver)
                                        (fpcpf-receiver-request receiver)
                                        (head values)))))))))))))))))

    ; Observation compares receiver-held inputs to a fresh full execution.
    ; Exact ACK identity closes correlation; full-walk agreement additionally
    ; prevents a caller from attaching unrelated trace/result evidence.
    (defn fpcpf-raw-values-equal? (kinds a b)
        (if (nil? kinds) (if (and (nil? a) (nil? b)) 1 0)
        (if (or (nil? a) (nil? b)) 0
            (if (fpcpf-raw-value-equal? (head kinds) (head a) (head b))
                (fpcpf-raw-values-equal?
                    (tail kinds) (tail a) (tail b)) 0))))
    (defn fpcpf-raw-value-equal? (kind a b)
        (if (rpmw-kind-named? kind "int") (if (eq a b) 1 0)
        (if (rpmw-kind-named? kind "string") (if (str_eq a b) 1 0)
        (if (rpmw-kind-named? kind "nothing")
            (if (and (nothing? a) (nothing? b)) 1 0)
        (if (rpmw-kind-named? kind "list")
            (fpcpf-raw-values-equal? (rpmw-kind-children kind) a b)
        (if (rpmw-native-node? kind) (if (node_eq a b) 1 0)
            0))))))
    (defn fpcpf-result-equal? (a b)
        (if (not (rpmw-result? a)) 0
        (if (not (rpmw-result? b)) 0
        (if (not (rpmw-kind-equal?
                    (rpmw-result-kind a) (rpmw-result-kind b))) 0
        (if (not (eq (rpmw-result-steps a) (rpmw-result-steps b))) 0
        (if (not (str_eq (rpmw-result-trace-status a)
                         (rpmw-result-trace-status b))) 0
        (if (not (str_eq (rpmw-result-stop-reason a)
                         (rpmw-result-stop-reason b))) 0
        (if (not (str_eq (rpmw-result-reason a)
                         (rpmw-result-reason b))) 0
            (fpcpf-raw-value-equal? (rpmw-result-kind a)
                (rpmw-result-value a) (rpmw-result-value b))))))))))
    (defn fpcpf-micro-equal? (a b)
        (if (not (rpmw-receipt? a)) 0
        (if (not (rpmw-receipt? b)) 0
        (if (not (eq (rpmw-receipt-entry-index a)
                     (rpmw-receipt-entry-index b))) 0
        (if (not (eq (rpmw-receipt-root-node a)
                     (rpmw-receipt-root-node b))) 0
        (if (not (eq (rpmw-receipt-step-budget a)
                     (rpmw-receipt-step-budget b))) 0
        (if (not (rpmw-kind-equal? (rpmw-receipt-input-kind a)
                                   (rpmw-receipt-input-kind b))) 0
        (if (not (fpcpf-raw-value-equal? (rpmw-receipt-input-kind a)
                    (rpmw-receipt-input-value a)
                    (rpmw-receipt-input-value b))) 0
        (if (not (str_eq (rpmw-receipt-status a)
                         (rpmw-receipt-status b))) 0
        (if (not (str_eq (rpmw-receipt-reason a)
                         (rpmw-receipt-reason b))) 0
        (if (not (rpsw-trace-fields-match?
                    (rpmw-receipt-trace a) (rpmw-receipt-trace b))) 0
            (fpcpf-result-equal?
                (rpmw-receipt-result a) (rpmw-receipt-result b)))))))))))))
    (defn fpcpf-resolution-equal? (a b)
        (if (rpsw-no-resolution? a)
            (if (rpsw-no-resolution? b) 1 0)
        (if (not (pise-resolution? a)) 0
        (if (not (pise-resolution? b)) 0
        (if (not (rpsw-pif-matches?
                    (pise-resolution-pif a) (pise-resolution-pif b))) 0
        (if (not (rpsw-request-matches?
                    (pise-resolution-request a)
                    (pise-resolution-request b))) 0
        (if (not (eq (pise-resolution-symbol-id a)
                     (pise-resolution-symbol-id b))) 0
        (if (not (str_eq (pise-resolution-canonical-key a)
                         (pise-resolution-canonical-key b))) 0
        (if (not (eq (pise-resolution-entry-index a)
                     (pise-resolution-entry-index b))) 0
        (if (not (eq (pise-resolution-root-node a)
                     (pise-resolution-root-node b))) 0
        (if (not (str_eq (pise-resolution-status a)
                         (pise-resolution-status b))) 0
            (if (str_eq (pise-resolution-reason a)
                        (pise-resolution-reason b)) 1 0))))))))))))
    (defn fpcpf-walk-equal? (a b)
        (if (fpcpf-no-walk? a) (if (fpcpf-no-walk? b) 1 0)
        (if (not (rpsw-receipt? a)) 0
        (if (not (rpsw-receipt? b)) 0
        (if (not (rpsw-envelope-identity-matches?
                    (rpsw-receipt-envelope a)
                    (rpsw-receipt-envelope b))) 0
        (if (not (rpsw-admission-pif-matches?
                    (rpsw-receipt-admission a)
                    (rpsw-receipt-admission b))) 0
        (if (not (rpsw-request-matches?
                    (rpsw-receipt-symbol-request a)
                    (rpsw-receipt-symbol-request b))) 0
        (if (not (eq (rpsw-receipt-step-budget a)
                     (rpsw-receipt-step-budget b))) 0
        (if (not (rpmw-kind-equal? (rpsw-receipt-input-kind a)
                                   (rpsw-receipt-input-kind b))) 0
        (if (not (fpcpf-raw-value-equal? (rpsw-receipt-input-kind a)
                    (rpsw-receipt-input-value a)
                    (rpsw-receipt-input-value b))) 0
        (if (not (str_eq (rpsw-receipt-status a)
                         (rpsw-receipt-status b))) 0
        (if (not (str_eq (rpsw-receipt-reason a)
                         (rpsw-receipt-reason b))) 0
        (if (not (fpcpf-resolution-equal?
                    (rpsw-receipt-symbol-resolution a)
                    (rpsw-receipt-symbol-resolution b))) 0
            (if (str_eq (rpsw-receipt-status a)
                        (rpsw-status-trace-produced))
                (if (not (rpsw-trace-fields-match?
                        (rpsw-receipt-trace a)
                        (rpsw-receipt-trace b))) 0
                    (fpcpf-micro-equal?
                        (rpsw-receipt-micro-walk a)
                        (rpsw-receipt-micro-walk b)))
                1))))))))))))))
    (defn fpcpf-receipt-observed? (protocol offer receiver receipt)
        (if (not (fpcpf-receipt? receipt)) 0
            (do
                (let fresh (fpcpf-execute protocol offer receiver))
                (if (not (fpcpf-receipt? fresh)) 0
                (if (not (fpcpf-ack-valid?
                        (fpcpf-receipt-ack receipt))) 0
                (if (not (node_eq (fpcpf-receipt-ack receipt)
                                  (fpcpf-receipt-ack fresh))) 0
                    (fpcpf-walk-equal?
                        (fpcpf-receipt-symbol-walk receipt)
                        (fpcpf-receipt-symbol-walk fresh))))))))

    0)
