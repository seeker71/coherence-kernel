; channel-wire.fk — the .fkb file door of a channel, split out of
; channel.fk 2026-08-28.
;
; preludes: form-stdlib/core.fk form-stdlib/channel.fk
;
; WHY THIS IS ITS OWN CELL. channel-create / channel-append / channel-read /
; channel-read-since are the only things in the channel layer that reach
; read_form_binary / write_form_binary, and those two are native on go / rust /
; ts and ABSENT on fkwu. Because they were named inside channel.fk, every chain
; that preluded channel.fk inherited the absence as four unresolved calls — and
; fkwu resolves every call site in a whole prelude chain while go / rust / ts
; bind lazily on execution, so a band that never touches a file still walls on
; the fourth arm. Measured cold 2026-08-28: mesh-organ-senses, mesh-quorum,
; organ-reading, fleet-fathom, gematria-channel and sanskrit-channel each
; carried exactly these four diagnostics, with the verdict already agreeing on
; all four arms — the number was right and the arm was red anyway.
;
; What stays behind in channel.fk is everything that is only shape: the four
; blueprints, node-children-skip, channel-message, channel-msg-payload, and the
; whole breath-gift / resonance-receipt practice. None of them opens a file, so
; anyone can hold them on any arm. What moves here is only the part that asks
; the host for bytes.
;
; This is the repair cache-binary.fk made for read_with_cache on 2026-08-14 and
; symbols-wire.fk made for the symbol table on 2026-08-28, made once at the
; source instead of once per consumer: a cell should not hand its callers a door
; they did not ask for and cannot open on their own arm. The door is not
; smaller — it is where its callers reach for it.
;
; Callers today: form-stdlib/boot.fk, form-stdlib/cell-registry.fk,
; form-stdlib/install-leaf.fk, form-stdlib/persistence.fk, the channel /
; chat / kv-store / multi-hop / pubsub / async-correlation / offers-in-flight /
; boot / cell-registry / text-summary-multi-source bands, and the cross-modal
; samples 23, 25, 26, 28, 37, 40, 41 and 48.

;; --- create --------------------------------------------------------

;; channel-create — initialize an empty channel at `path`. Writes a
;; CHANNEL-V0 Recipe with zero children. Overwrites any prior file.
;; Returns bytes-written (kernel native return) or -1 on error.
(defn channel-create (path)
    (write_form_binary path (intern_node CHANNEL-V0 (empty))))

;; --- append --------------------------------------------------------

;; channel-append — append `msg` to the channel at `path`. Reads
;; the existing channel, builds a new children list = old + msg,
;; rewrites the file. Returns the message COUNT after the append.
;;
;; Single-writer; concurrent appenders may overwrite each other.
(defn channel-append (path msg)
    (do
        (let existing (read_form_binary path))
        (let old-children (node_children existing))
        (let new-children (append old-children (list msg)))
        (let new-channel (intern_node CHANNEL-V0 new-children))
        (write_form_binary path new-channel)
        (len new-children)))

;; --- read ----------------------------------------------------------

;; channel-read — every message currently on the channel as a list
;; of CHANNEL-MSG Recipes (in append-order).
(defn channel-read (path)
    (node_children (read_form_binary path)))

;; channel-read-since — messages from index `n` onward (0-based).
;; Polling pattern: a cell remembers `seen = (len received)` and
;; asks for everything after that. With content-addressing, even
;; if the cell reconnects to a brand-new channel file containing
;; the same earlier payloads, NodeIDs match — dedup is automatic.
;;
;; node-children-skip stays in channel.fk: slicing a list is shape,
;; not a file, so it costs no arm anything to keep it where everyone
;; already holds it.
(defn channel-read-since (path n)
    (node-children-skip (channel-read path) n))

0
