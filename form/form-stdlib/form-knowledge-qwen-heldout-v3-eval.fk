    ; ── shape, freshness, and identity ───────────────────────────────
    (defn fkh3-count-string (x xs)
        (if (eq (len xs) 0) 0
            (add (if (str_eq x (head xs)) 1 0)
                 (fkh3-count-string x (tail xs)))))
    (defn fkh3-unique-strings? (xs)
        (if (eq (len xs) 0) 1
            (if (eq (fkh3-count-string (head xs) (tail xs)) 0)
                (fkh3-unique-strings? (tail xs)) 0)))
    (defn fkh3-map-field (rows at)
        (if (eq (len rows) 0) (list)
            (cons (nth (head rows) at) (fkh3-map-field (tail rows) at))))
    (defn fkh3-count-family (family rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq family (fkh3-family (head rows))) 1 0)
                 (fkh3-count-family family (tail rows)))))
    (defn fkh3-every-family-twice? (families rows)
        (if (eq (len families) 0) 1
            (if (eq (fkh3-count-family (head families) rows) 2)
                (fkh3-every-family-twice? (tail families) rows) 0)))
    (defn fkh3-family-coverage? (rows)
        (if (and (eq (len rows) (fkh3-row-count))
                 (and (eq (len (fkh3-families)) (fkh3-family-count))
                      (eq (fkh3-every-family-twice? (fkh3-families) rows) 1))) 1 0))
    (defn fkh3-rows-unique? (rows)
        (if (and (eq (fkh3-unique-strings? (fkh3-map-field rows 1)) 1)
            (and (eq (fkh3-unique-strings? (fkh3-map-field rows 3)) 1)
            (and (eq (fkh3-unique-strings? (fkh3-map-field rows 4)) 1)
            (and (eq (fkh3-unique-strings? (fkh3-map-field rows 6)) 1)
                 (eq (fkh3-unique-strings? (fkh3-map-field rows 8)) 1))))) 1 0))
    (defn fkh3-row-current? (r)
        (if (not (eq (fkh3-row? r) 1)) 0
            (if (and (gt (file_size (fkh3-source r)) 0)
                (and (eq (nmfe-sha256? (fkh3-source-sha r)) 1)
                (and (str_eq (nmfe-sha256 (read_file (fkh3-source r)))
                             (fkh3-source-sha r))
                (and (eq (nmfe-sha256? (fkh3-answer-sha r)) 1)
                (and (str_eq (nmfe-sha256 (fkh3-expected r))
                             (fkh3-answer-sha r))
                (and (eq (fkh3-verifier? (fkh3-row-verifier r)) 1)
                (and (str_eq (head (fkh3-verifier-variants
                                        (fkh3-row-verifier r)))
                             (fkh3-expected r))
                (and (str_eq (fkh3-row-split r) (fkh3-split))
                     (str_eq (fkh3-row-authored r) (fkh3-authored)))))))))) 1 0)))
    (defn fkh3-all-rows-current? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkh3-row-current? (head rows)) 1)
                (fkh3-all-rows-current? (tail rows)) 0)))

    (defn fkh3-row-message (r)
        (nmfe-fields
            (list "form-knowledge-qwen-heldout-row-v3-message"
                  (fkh3-id r) (fkh3-family r) (fkh3-concept r)
                  (fkh3-source r) (fkh3-source-sha r) (fkh3-prompt r)
                  (fkh3-expected r) (fkh3-answer-sha r)
                  (fkh3-verifier-message (fkh3-row-verifier r))
                  (fkh3-row-split r) (fkh3-row-authored r))))
    (defn fkh3-dataset-message-loop (rows)
        (if (eq (len rows) 0) ""
            (str_concat (nmfe-field (fkh3-row-message (head rows)))
                        (fkh3-dataset-message-loop (tail rows)))))
    (defn fkh3-authorship-message ()
        (nmfe-fields
            (list "form-knowledge-qwen-heldout-v3-authorship"
                  (fkh3-authored) (fkh3-authored-teach-source-sha)
                  (fkh3-authored-v1-source-sha)
                  (fkh3-authored-recipe-source-sha)
                  (fkhe-dataset-seal) "current-leakage-recomputed-at-report")))
    (defn fkh3-dataset-sha256 (rows)
        (nmfe-sha256
            (nmfe-fields
                (list "form-knowledge-qwen-heldout-dataset-v3"
                      (fkh3-authorship-message)
                      (fkh3-dataset-message-loop rows)))))
    ; Filled only after the pure manifest computes the message above.
    (defn fkh3-dataset-seal ()
        "31af3c7901d024d4772ab5466ac059e6db43e683262512cda67ac76a996ccf48")

    ; ── current leakage audit ────────────────────────────────────────
    (defn fkh3-pairs (rows)
        (if (eq (len rows) 0) (list)
            (cons (list (fkh3-prompt (head rows)) (fkh3-expected (head rows)))
                  (fkh3-pairs (tail rows)))))
    (defn fkh3-normalized-pairs (pairs)
        (if (eq (len pairs) 0) (list)
            (cons (list (nmfe-normalize (nth (head pairs) 0))
                        (nmfe-normalize (nth (head pairs) 1)))
                  (fkh3-normalized-pairs (tail pairs)))))
    (defn fkh3-answer-shas-of-pairs (pairs)
        (if (eq (len pairs) 0) (list)
            (cons (nmfe-sha256 (nth (head pairs) 1))
                  (fkh3-answer-shas-of-pairs (tail pairs)))))
    ; Direct recursive versions keep the source runner independent of lambdas.
    (defn fkh3-v1-concept? (concept rows)
        (if (eq (len rows) 0) 0
            (if (str_eq concept (fkhe-concept (head rows))) 1
                (fkh3-v1-concept? concept (tail rows)))))
    (defn fkh3-v1-source? (source rows)
        (if (eq (len rows) 0) 0
            (if (str_eq source (fkhe-source (head rows))) 1
                (fkh3-v1-source? source (tail rows)))))
    (defn fkh3-count-v1-concept-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fkh3-v1-concept? (fkh3-concept (head rows)) (fkhe-rows))
                 (fkh3-count-v1-concept-overlap (tail rows)))))
    (defn fkh3-count-v1-source-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fkh3-v1-source? (fkh3-source (head rows)) (fkhe-rows))
                 (fkh3-count-v1-source-overlap (tail rows)))))
    (defn fkh3-count-teach-concept-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fqt-has (fkh3-concept (head rows)))
                 (fkh3-count-teach-concept-overlap (tail rows)))))
    (defn fkh3-count-teach-source-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fkhe-source-is-taught? (fkh3-source (head rows))
                                         (fqt-semantic-sources))
                 (fkh3-count-teach-source-overlap (tail rows)))))
    (defn fkh3-recipe-concepts ()
        (list "recipe-exec" "affine-scalar-v1" "recipe-exec-lifecycle-v1"
              "node-coordinate" "carrier-choice" "native-code-generated"
              "recipe-observation" "recipe-request-token"))
    (defn fkh3-string-in? (s xs)
        (if (eq (len xs) 0) 0
            (if (str_eq s (head xs)) 1 (fkh3-string-in? s (tail xs)))))
    (defn fkh3-count-recipe-concept-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fkh3-string-in? (fkh3-concept (head rows))
                                  (fkh3-recipe-concepts))
                 (fkh3-count-recipe-concept-overlap (tail rows)))))
    (defn fkh3-count-recipe-source-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (fkh3-source (head rows))
                             (fkh3-recipe-source)) 1 0)
                 (fkh3-count-recipe-source-overlap (tail rows)))))
    (defn fkh3-duplicate-count (xs)
        (if (eq (len xs) 0) 0
            (add (if (gt (fkh3-count-string (head xs) (tail xs)) 0) 1 0)
                 (fkh3-duplicate-count (tail xs)))))
    (defn fkh3-current-teach-sha ()
        (nmfe-sha256 (read_file (fkh3-teach-source))))
    (defn fkh3-current-v1-sha ()
        (nmfe-sha256 (read_file (fkh3-v1-source))))
    (defn fkh3-current-recipe-sha ()
        (nmfe-sha256 (read_file (fkh3-recipe-source))))

    ; audit fields 1..20 are overlap/duplicate counts and must all be zero.
    ; Fields 21..23 are current surface identities; field 24 names the audit.
    (defn fkh3-leakage-audit (rows)
        (do
            (let held (fkh3-pairs rows))
            (let teach (fkhe-teach-pairs))
            (let old (fkhe-pairs (fkhe-rows)))
            (let held-normalized (fkh3-normalized-pairs held))
            (let teach-normalized (fkh3-normalized-pairs teach))
            (let old-normalized (fkh3-normalized-pairs old))
            (let held-pairs (nmfe-pair-sha256s held))
            (let teach-pairs (nmfe-pair-sha256s teach))
            (let old-pairs (nmfe-pair-sha256s old))
            (let held-prompts (nmfe-prompt-sha256s held))
            (let teach-prompts (nmfe-prompt-sha256s teach))
            (let old-prompts (nmfe-prompt-sha256s old))
            (let held-normal-pairs (nmfe-pair-sha256s held-normalized))
            (let teach-normal-pairs (nmfe-pair-sha256s teach-normalized))
            (let old-normal-pairs (nmfe-pair-sha256s old-normalized))
            (let held-normal-prompts (nmfe-prompt-sha256s held-normalized))
            (let teach-normal-prompts (nmfe-prompt-sha256s teach-normalized))
            (let old-normal-prompts (nmfe-prompt-sha256s old-normalized))
            (let held-answers (fkh3-answer-shas-of-pairs held))
            (let teach-answers (fkh3-answer-shas-of-pairs teach))
            (let old-answers (fkh3-answer-shas-of-pairs old))
            (list "form-knowledge-qwen-heldout-v3-leakage-audit"
                (nmfe-overlap-count held-pairs teach-pairs)
                (nmfe-overlap-count held-prompts teach-prompts)
                (nmfe-overlap-count held-normal-pairs teach-normal-pairs)
                (nmfe-overlap-count held-normal-prompts teach-normal-prompts)
                (nmfe-overlap-count held-answers teach-answers)
                (fkh3-count-teach-concept-overlap rows)
                (fkh3-count-teach-source-overlap rows)
                (nmfe-overlap-count held-pairs old-pairs)
                (nmfe-overlap-count held-prompts old-prompts)
                (nmfe-overlap-count held-normal-pairs old-normal-pairs)
                (nmfe-overlap-count held-normal-prompts old-normal-prompts)
                (nmfe-overlap-count held-answers old-answers)
                (fkh3-count-v1-concept-overlap rows)
                (fkh3-count-v1-source-overlap rows)
                (fkh3-count-recipe-concept-overlap rows)
                (fkh3-count-recipe-source-overlap rows)
                (fkh3-duplicate-count (fkh3-map-field rows 6))
                (fkh3-duplicate-count (fkh3-map-field rows 8))
                (fkh3-duplicate-count (fkh3-map-field rows 3))
                (fkh3-duplicate-count (fkh3-map-field rows 4))
                (fkh3-current-teach-sha)
                (fkh3-current-v1-sha)
                (fkh3-current-recipe-sha)
                (fkh3-authored))))
    (defn fkh3-audit-zero-loop? (audit at end)
        (if (gt at end) 1
            (if (eq (nth audit at) 0)
                (fkh3-audit-zero-loop? audit (add at 1) end) 0)))
    (defn fkh3-leakage-audit-valid? (audit)
        (if (and (eq (len audit) 25)
            (and (str_eq (nth audit 0)
                         "form-knowledge-qwen-heldout-v3-leakage-audit")
            (and (eq (fkh3-audit-zero-loop? audit 1 20) 1)
            (and (eq (nmfe-sha256? (nth audit 21)) 1)
            (and (eq (nmfe-sha256? (nth audit 22)) 1)
            (and (eq (nmfe-sha256? (nth audit 23)) 1)
                 (str_eq (nth audit 24) (fkh3-authored)))))))) 1 0))
    (defn fkh3-authorship-valid? ()
        (if (and (eq (nmfe-sha256? (fkh3-authored-teach-source-sha)) 1)
            (and (eq (nmfe-sha256? (fkh3-authored-v1-source-sha)) 1)
                 (eq (nmfe-sha256? (fkh3-authored-recipe-source-sha)) 1))) 1 0))
    (defn fkh3-dataset-valid-with? (rows audit)
        (if (and (eq (fkh3-family-coverage? rows) 1)
            (and (eq (fkh3-rows-unique? rows) 1)
            (and (eq (fkh3-all-rows-current? rows) 1)
            (and (eq (fkh3-authorship-valid?) 1)
            (and (eq (fkh3-leakage-audit-valid? audit) 1)
                 (str_eq (fkh3-dataset-sha256 rows)
                         (fkh3-dataset-seal))))))) 1 0))
    (defn fkh3-dataset-valid? ()
        (do
            (let rows (fkh3-rows))
            (fkh3-dataset-valid-with? rows (fkh3-leakage-audit rows))))

    ; ── private output parse and typed scoring ───────────────────────
    ; parsed = tag raw-sha answer error refusal.  Answer text is transient
    ; evaluator state and never enters a score or public report.
    (defn fkh3-output (raw-sha answer error refusal)
        (list "form-knowledge-qwen-heldout-v3-output" raw-sha answer error refusal))
    (defn fkh3-output-raw-sha (o) (nth o 1))
    (defn fkh3-output-answer (o) (nth o 2))
    (defn fkh3-output-error (o) (nth o 3))
    (defn fkh3-output-refusal (o) (nth o 4))
    (defn fkh3-refusal? (raw)
        (if (ge (str_find raw "generation refused:" 0) 0) 1 0))
    (defn fkh3-strip-complete-query (generated)
        (do
            (let open-at (str_find generated (fkqt-open) 0))
            (if (lt open-at 0) generated
                (do
                    (let close-at (str_find generated (fkqt-close)
                        (add open-at (str_len (fkqt-open)))))
                    (if (lt close-at 0) generated
                        (substring generated
                            (add close-at (str_len (fkqt-close)))
                            (str_len generated)))))))
    (defn fkh3-parse-resident-output (raw)
        (do
            (let refusal (fkh3-refusal? raw))
            (let marker "\ntext:\n")
            (let at (str_find raw marker 0))
            (if (lt at 0)
                (fkh3-output (nmfe-sha256 raw) "" 1 refusal)
                (do
                    (let generated
                        (substring raw (add at (str_len marker)) (str_len raw)))
                    (let answer (fkh3-strip-complete-query generated))
                    (fkh3-output (nmfe-sha256 raw) answer
                        (if (or (eq refusal 1)
                                (or (eq (str_len generated) 0)
                                    (eq (str_len answer) 0))) 1 0)
                        refusal)))))

    ; observation = tag prompt-sha expected-sha actual-sha exact f1 sequence
    ;               semantic promotion latency error
    (defn fkh3-observation (prompt expected actual verifier latency error)
        (do
            (let exact (if (eq error 0) (nmfe-exact-ppm expected actual) 0))
            (let f1 (if (eq error 0) (nmfe-token-f1-ppm expected actual) 0))
            (let sequence (if (eq error 0) (nmfe-sequence-ppm expected actual) 0))
            (let semantic (fkh3-semantic-ppm verifier actual error))
            (let lexical (nmfe-promotion-score f1 sequence))
            (let promotion (if (lt lexical semantic) lexical semantic))
            (list "form-knowledge-qwen-heldout-v3-observation"
                  (nmfe-sha256 prompt) (nmfe-sha256 expected)
                  (nmfe-sha256 actual) exact f1 sequence semantic promotion
                  latency error)))
    (defn fkh3-obs? (o)
        (if (and (eq (len o) 11)
                 (str_eq (nth o 0)
                         "form-knowledge-qwen-heldout-v3-observation")) 1 0))
    (defn fkh3-obs-exact (o) (nth o 4))
    (defn fkh3-obs-f1 (o) (nth o 5))
    (defn fkh3-obs-sequence (o) (nth o 6))
    (defn fkh3-obs-semantic (o) (nth o 7))
    (defn fkh3-obs-promotion (o) (nth o 8))
    (defn fkh3-obs-latency (o) (nth o 9))
    (defn fkh3-obs-error (o) (nth o 10))

    ; score contains identity hashes and scalar evidence only.
    ; tag id family source-sha prompt-sha answer-sha verifier-sha
    ; effective-prompt-sha raw-output-sha actual-sha refusal observation
    (defn fkh3-score (row effective-prompt parsed latency)
        (list "form-knowledge-qwen-heldout-v3-score"
              (fkh3-id row) (fkh3-family row) (fkh3-source-sha row)
              (nmfe-sha256 (fkh3-prompt row)) (fkh3-answer-sha row)
              (fkh3-verifier-sha (fkh3-row-verifier row))
              (nmfe-sha256 effective-prompt) (fkh3-output-raw-sha parsed)
              (nmfe-sha256 (fkh3-output-answer parsed))
              (fkh3-output-refusal parsed)
              (fkh3-observation effective-prompt (fkh3-expected row)
                  (fkh3-output-answer parsed) (fkh3-row-verifier row) latency
                  (fkh3-output-error parsed))))
    (defn fkh3-score-id (s) (nth s 1))
    (defn fkh3-score-family (s) (nth s 2))
    (defn fkh3-score-observation (s) (nth s 11))
    (defn fkh3-find-row (id rows)
        (if (eq (len rows) 0) (list)
            (if (str_eq id (fkh3-id (head rows))) (head rows)
                (fkh3-find-row id (tail rows)))))
    (defn fkh3-all-one? (bits)
        (if (eq (len bits) 0) 1
            (if (eq (head bits) 1)
                (fkh3-all-one? (tail bits)) 0)))
    (defn fkh3-score-valid? (s rows)
        (if (not (and (eq (len s) 12)
                      (str_eq (nth s 0)
                              "form-knowledge-qwen-heldout-v3-score")))
            0
            (do
                (let row (fkh3-find-row (fkh3-score-id s) rows))
                (if (eq (len row) 0)
                    0
                    (do
                        (let o (fkh3-score-observation s))
                        (fkh3-all-one?
                            (list
                                (str_eq (fkh3-score-family s)
                                        (fkh3-family row))
                                (str_eq (nth s 3) (fkh3-source-sha row))
                                (str_eq (nth s 4)
                                    (nmfe-sha256 (fkh3-prompt row)))
                                (str_eq (nth s 5) (fkh3-answer-sha row))
                                (str_eq (nth s 6)
                                    (fkh3-verifier-sha
                                        (fkh3-row-verifier row)))
                                (str_eq (nth s 7)
                                    (nmfe-sha256
                                        (fqt-knowledge-prompt
                                            (fkh3-prompt row))))
                                (nmfe-sha256? (nth s 8))
                                (nmfe-sha256? (nth s 9))
                                (fkh3-obs? o)
                                (str_eq (nth s 7) (nth o 1))
                                (str_eq (fkh3-answer-sha row) (nth o 2))
                                (str_eq (nth s 9) (nth o 3)))))))))
    (defn fkh3-all-scores-valid? (scores rows)
        (if (eq (len scores) 0) 1
            (if (eq (fkh3-score-valid? (head scores) rows) 1)
                (fkh3-all-scores-valid? (tail scores) rows) 0)))
    (defn fkh3-count-score-id (id scores)
        (if (eq (len scores) 0) 0
            (add (if (str_eq id (fkh3-score-id (head scores))) 1 0)
                 (fkh3-count-score-id id (tail scores)))))
    (defn fkh3-every-row-scored-once? (rows scores)
        (if (eq (len rows) 0) 1
            (if (eq (fkh3-count-score-id (fkh3-id (head rows)) scores) 1)
                (fkh3-every-row-scored-once? (tail rows) scores) 0)))
    (defn fkh3-complete-score-set? (scores rows)
        (if (and (eq (len scores) (len rows))
                 (and (eq (fkh3-all-scores-valid? scores rows) 1)
                      (eq (fkh3-every-row-scored-once? rows scores) 1))) 1 0))
    (defn fkh3-at-least95? (ppm)
        (if (ge ppm (fkh3-threshold-ppm)) 1 0))
    (defn fkh3-every-row-at-least95? (scores)
        (if (eq (len scores) 0) 1
            (if (eq (fkh3-at-least95?
                        (fkh3-obs-promotion
                            (fkh3-score-observation (head scores)))) 1)
                (fkh3-every-row-at-least95? (tail scores)) 0)))
    (defn fkh3-family-scores (family scores)
        (if (eq (len scores) 0) (list)
            (if (str_eq family (fkh3-score-family (head scores)))
                (cons (head scores) (fkh3-family-scores family (tail scores)))
                (fkh3-family-scores family (tail scores)))))
    (defn fkh3-score-observations (scores)
        (if (eq (len scores) 0) (list)
            (cons (fkh3-score-observation (head scores))
                  (fkh3-score-observations (tail scores)))))
    (defn fkh3-sum-observation-field (observations at)
        (if (eq (len observations) 0) 0
            (add (nth (head observations) at)
                 (fkh3-sum-observation-field (tail observations) at))))
    (defn fkh3-mean-observation-field (observations at)
        (if (eq (len observations) 0) 0
            (nmfe-round-div (fkh3-sum-observation-field observations at)
                            (len observations))))
    ; aggregate = samples exact f1 sequence semantic promotion latency errors
    (defn fkh3-aggregate (scores)
        (do
            (let os (fkh3-score-observations scores))
            (list (len os)
                  (fkh3-mean-observation-field os 4)
                  (fkh3-mean-observation-field os 5)
                  (fkh3-mean-observation-field os 6)
                  (fkh3-mean-observation-field os 7)
                  (fkh3-mean-observation-field os 8)
                  (fkh3-mean-observation-field os 9)
                  (fkh3-sum-observation-field os 10))))
    (defn fkh3-family-at-least95? (family scores)
        (do
            (let fs (fkh3-family-scores family scores))
            (if (not (eq (len fs) 2)) 0
                (if (and (eq (fkh3-every-row-at-least95? fs) 1)
                         (eq (fkh3-at-least95? (nth (fkh3-aggregate fs) 5)) 1))
                    1 0))))
    (defn fkh3-every-family-at-least95? (families scores)
        (if (eq (len families) 0) 1
            (if (eq (fkh3-family-at-least95? (head families) scores) 1)
                (fkh3-every-family-at-least95? (tail families) scores) 0)))

    ; report = tag scope model-id dataset-sha audit family-count row-count
    ;          scores aggregate model-executed release-ok overall95 family95
    ;          row95 live-credit
    (defn fkh3-report-with-audit
        (scope model-id model-executed release-ok scores audit)
        (do
            (let rows (fkh3-rows))
            (let aggregate (fkh3-aggregate scores))
            (let complete (fkh3-complete-score-set? scores rows))
            (let overall95 (if (eq complete 1)
                (if (and (eq (nth aggregate 7) 0)
                         (eq (fkh3-at-least95? (nth aggregate 5)) 1)) 1 0) 0))
            (let row95 (if (eq complete 1)
                (fkh3-every-row-at-least95? scores) 0))
            (let family95 (if (eq complete 1)
                (fkh3-every-family-at-least95? (fkh3-families) scores) 0))
            (let live
                (if (and (str_eq scope (fkh3-live-scope))
                    (and (gt (str_len model-id) 0)
                    (and (eq model-executed 1)
                    (and (eq release-ok 1)
                    (and (eq (fkh3-dataset-valid-with? rows audit) 1)
                    (and (eq (fkh3-leakage-audit-valid? audit) 1)
                    (and (eq complete 1)
                    (and (eq overall95 1)
                         (and (eq family95 1) (eq row95 1)))))))))) 1 0))
            (list "form-knowledge-qwen-heldout-report-v3" scope model-id
                  (fkh3-dataset-sha256 rows) audit (fkh3-family-count)
                  (fkh3-row-count) scores aggregate model-executed release-ok
                  overall95 family95 row95 live)))
    (defn fkh3-report (scope model-id model-executed release-ok scores)
        (fkh3-report-with-audit scope model-id model-executed release-ok scores
            (fkh3-leakage-audit (fkh3-rows))))
    (defn fkh3-report-audit (r) (nth r 4))
    (defn fkh3-report-scores (r) (nth r 7))
    (defn fkh3-report-aggregate (r) (nth r 8))
    (defn fkh3-report-overall95 (r) (nth r 11))
    (defn fkh3-report-family95 (r) (nth r 12))
    (defn fkh3-report-row95 (r) (nth r 13))
    (defn fkh3-report-live-credit (r) (nth r 14))

    ; ── bounded, content-redacted public rendering ───────────────────
    (defn fkh3-line (name value)
        (str_concat name (str_concat "=" (str_concat value "\n"))))
    (defn fkh3-score-lines (scores)
        (if (eq (len scores) 0) ""
            (do
                (let s (head scores))
                (let o (fkh3-score-observation s))
                (str_concat (fkh3-line "id" (fkh3-score-id s))
                (str_concat (fkh3-line "family" (fkh3-score-family s))
                (str_concat (fkh3-line "exact-ppm"
                    (int_to_str (fkh3-obs-exact o)))
                (str_concat (fkh3-line "f1-ppm"
                    (int_to_str (fkh3-obs-f1 o)))
                (str_concat (fkh3-line "sequence-ppm"
                    (int_to_str (fkh3-obs-sequence o)))
                (str_concat (fkh3-line "semantic-ppm"
                    (int_to_str (fkh3-obs-semantic o)))
                (str_concat (fkh3-line "promotion-ppm"
                    (int_to_str (fkh3-obs-promotion o)))
                (str_concat (fkh3-line "error"
                    (int_to_str (fkh3-obs-error o)))
                (str_concat (fkh3-line "latency-ms"
                    (int_to_str (fkh3-obs-latency o)))
                    (fkh3-score-lines (tail scores))))))))))))))
    (defn fkh3-audit-count-lines (audit at end)
        (if (gt at end) ""
            (str_concat (fkh3-line
                            (str_concat "leakage-count-" (int_to_str at))
                            (int_to_str (nth audit at)))
                        (fkh3-audit-count-lines audit (add at 1) end))))
    (defn fkh3-report-lines (report)
        (do
            (let a (fkh3-report-aggregate report))
            (str_concat (fkh3-line "dataset-sha256" (nth report 3))
            (str_concat (fkh3-line "families" (int_to_str (nth report 5)))
            (str_concat (fkh3-line "samples" (int_to_str (nth report 6)))
            (str_concat (fkh3-audit-count-lines (fkh3-report-audit report) 1 20)
            (str_concat (fkh3-score-lines (fkh3-report-scores report))
            (str_concat (fkh3-line "aggregate-exact-ppm" (int_to_str (nth a 1)))
            (str_concat (fkh3-line "aggregate-f1-ppm" (int_to_str (nth a 2)))
            (str_concat (fkh3-line "aggregate-sequence-ppm" (int_to_str (nth a 3)))
            (str_concat (fkh3-line "aggregate-semantic-ppm" (int_to_str (nth a 4)))
            (str_concat (fkh3-line "aggregate-promotion-ppm" (int_to_str (nth a 5)))
            (str_concat (fkh3-line "aggregate-latency-ms" (int_to_str (nth a 6)))
            (str_concat (fkh3-line "aggregate-errors" (int_to_str (nth a 7)))
            (str_concat (fkh3-line "overall95" (int_to_str (fkh3-report-overall95 report)))
            (str_concat (fkh3-line "family95" (int_to_str (fkh3-report-family95 report)))
            (str_concat (fkh3-line "row95" (int_to_str (fkh3-report-row95 report)))
                        (fkh3-line "live-credit"
                            (int_to_str (fkh3-report-live-credit report))))))))))))))))))))
    (defn fkh3-private-material-absent? (text rows)
        (if (eq (len rows) 0) 1
            (do
                (let row (head rows))
                (if (or (ge (str_find text (fkh3-prompt row) 0) 0)
                    (or (ge (str_find text (fkh3-source row) 0) 0)
                        (ge (str_find text (fkh3-answer-sha row) 0) 0))) 0
                    (fkh3-private-material-absent? text (tail rows))))))

    ; ── dataset-bound consent ────────────────────────────────────────
    (defn fkh3-consent-path ()
        ".form-knowledge-qwen-heldout-v3-consent")
    (defn fkh3-consent-token ()
        (str_concat "run-local-qwen-heldout-v3:"
            (str_concat (fkh3-dataset-seal)
                (str_concat ":" (str_concat (int_to_str (fkh3-row-count))
                    (str_concat ":" (int_to_str (fkh3-family-count))))))))
    (defn fkh3-consent-valid? (supplied)
        (if (str_eq supplied (fkh3-consent-token)) 1
            (if (str_eq supplied (str_concat (fkh3-consent-token) "\n")) 1 0)))

    0)
