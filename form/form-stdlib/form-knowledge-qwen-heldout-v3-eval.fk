; form-knowledge-qwen-heldout-v3-eval.fk -- blind, sealed, two-row-per-family audit.
;
; V3 is an independent denominator authored after the fifteen-row lexical set
; became development-visible.  Thirty current-source facts are held only in
; this cell: two for each of the same fifteen repository families.  Each row
; binds the present source bytes, prompt, answer, answer hash, typed verifier,
; split, and authorship snapshot into one dataset seal.
;
; This cell never runs a model.  Its public renderers carry only row ids,
; families, scalar evidence, counts, and dataset/audit hashes.  Prompts,
; expected text, source excerpts, source paths, answer hashes, and generated
; text remain inside the evaluator.  The adjacent live door is separately
; dataset-bound and consent-bound.
;
; Every row currently uses exact-normalized-v1: the whole normalized answer
; must be one of the variants authored and sealed here.  F1 and sequence stay
; visible diagnostics, but promotion is the minimum of their conservative
; score and the typed semantic score.  Thus lexical overlap cannot pass a row.
; No remote judge participates.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-eval.fk
; Proven by: form-stdlib/tests/form-knowledge-qwen-heldout-v3-eval-band.fk

(do
    (defn fkh3-threshold-ppm () 950000)
    (defn fkh3-live-scope () "live-local-qwen-heldout-v3")
    (defn fkh3-fixture-scope () "evaluation-fixture-v3-no-live-credit")
    (defn fkh3-split () "heldout-local-qwen-v3-blind")
    (defn fkh3-authored () "codex-blind-2026-08-24-before-v3-training")
    (defn fkh3-row-count () 30)
    (defn fkh3-family-count () 15)

    ; These are authorship-time identities, not requirements that later
    ; teaching remain byte-identical.  A later live report recomputes leakage
    ; against the then-current surfaces and must still find zero overlap.
    (defn fkh3-authored-teach-source-sha ()
        "d4750a042fb4235dc99988861b3793a91d0d6f47ade3adc54399bb8ad2d12d3e")
    (defn fkh3-authored-v1-source-sha ()
        "9d06e560df38b7366be5ffd9bda33f1f2c70616470aaca1f35ab00d5ac65dbc1")
    (defn fkh3-authored-recipe-source-sha ()
        "79240c80478f40fccd4526ac6c40650a3da676af37c6b592e5ebcbb28e09a2c4")
    (defn fkh3-recipe-source ()
        "form/form-stdlib/form-recipe-exec-token.fk")
    (defn fkh3-teach-source ()
        "form/form-stdlib/form-cli-qwen-teach-layer.fk")
    (defn fkh3-v1-source ()
        "form/form-stdlib/form-knowledge-qwen-heldout-eval.fk")

    ; verifier = tag mode accepted-variants requirements
    (defn fkh3-verifier (mode variants requirements)
        (list "form-knowledge-qwen-heldout-v3-verifier" mode variants requirements))
    (defn fkh3-exact-verifier (expected)
        (fkh3-verifier "exact-normalized-v1" (list expected)
            (list "whole-normalized-answer" "no-unlisted-variant")))
    (defn fkh3-verifier-mode (v) (nth v 1))
    (defn fkh3-verifier-variants (v) (nth v 2))
    (defn fkh3-verifier-requirements (v) (nth v 3))
    (defn fkh3-verifier? (v)
        (if (and (eq (len v) 4)
                 (and (str_eq (nth v 0)
                              "form-knowledge-qwen-heldout-v3-verifier")
                 (and (str_eq (fkh3-verifier-mode v) "exact-normalized-v1")
                 (and (eq (len (fkh3-verifier-variants v)) 1)
                      (eq (len (fkh3-verifier-requirements v)) 2))))) 1 0))
    (defn fkh3-verifier-message (v)
        (nmfe-fields
            (list "form-knowledge-qwen-heldout-v3-verifier-message"
                  (fkh3-verifier-mode v)
                  (nmfe-fields (fkh3-verifier-variants v))
                  (nmfe-fields (fkh3-verifier-requirements v)))))
    (defn fkh3-verifier-sha (v) (nmfe-sha256 (fkh3-verifier-message v)))
    (defn fkh3-variant-match? (actual variants)
        (if (eq (len variants) 0) 0
            (if (str_eq (nmfe-normalize actual)
                        (nmfe-normalize (head variants))) 1
                (fkh3-variant-match? actual (tail variants)))))
    (defn fkh3-semantic-ppm (verifier actual error)
        (if (not (eq error 0)) 0
            (if (not (eq (fkh3-verifier? verifier) 1)) 0
                (if (eq (fkh3-variant-match? actual
                            (fkh3-verifier-variants verifier)) 1)
                    1000000 0))))

    ; row = tag id family concept source source-sha prompt expected answer-sha
    ;       verifier split authored
    (defn fkh3-row (id family concept source source-sha prompt expected answer-sha)
        (list "form-knowledge-qwen-heldout-row-v3" id family concept source
              source-sha prompt expected answer-sha (fkh3-exact-verifier expected)
              (fkh3-split) (fkh3-authored)))
    (defn fkh3-row? (r)
        (if (and (eq (len r) 12)
                 (str_eq (nth r 0) "form-knowledge-qwen-heldout-row-v3")) 1 0))
    (defn fkh3-id (r) (nth r 1))
    (defn fkh3-family (r) (nth r 2))
    (defn fkh3-concept (r) (nth r 3))
    (defn fkh3-source (r) (nth r 4))
    (defn fkh3-source-sha (r) (nth r 5))
    (defn fkh3-prompt (r) (nth r 6))
    (defn fkh3-expected (r) (nth r 7))
    (defn fkh3-answer-sha (r) (nth r 8))
    (defn fkh3-row-verifier (r) (nth r 9))
    (defn fkh3-row-split (r) (nth r 10))
    (defn fkh3-row-authored (r) (nth r 11))

