//////////////////////////////////////////////////////////////////////
// meaning-codes.bml — one meaning, many codes. A meaning is a symbol
// token the body already speaks (symbol-voice for the words, perception-
// symbols for what is not a word); its codes are its NL phrase, a short
// hash anchor of the symbol, and every tongue or script row
// the locale files carry. Every file named symbol-*.rows in the locale
// directory joins: symbol-words.rows and symbol-perception.rows carry
// english|fa|de|fr|pt|ro (the second for the sound around the words),
// symbol-jungle.rows carries the jungle's own tongues, and
// symbol-scripts.rows (english|he|zh|ja) joins the moment the resident
// writes it. Each file's first line names
// its code kinds after the english key.
// mc-resolve-all returns every matching meaning. The round-trip check proves
// membership for each present code, preserving shared codes and alternate senses.
// The short anchor belongs to this codebook; kernel composition identity has
// its own representation. These lookup functions run when explicitly called;
// the local model's decoder continues to predict its own vocabulary token IDs.
// The bytes
// of each code beside the NL phrase measure what speaking in codes
// compresses. A code kind with no row yet is absent and says so.
//
// Two rosters, one grammar. mc-meanings() is what a HEARD LINE resolves
// against, so a spoken "still" stays the word and does not become the room
// being still; ps-symbols() is what a PERCEPTION resolves against, and
// mc-resolve-among walks whichever roster the caller is reading in. Every
// symbol of either roster addresses (mc-anchor) and speaks (mc-say-in) the
// same way — the roster decides what a code may mean, never how it is said.
//
// The rows are read and split ONCE. Form holds no mutable state, so "read
// once" is not a cache: mc-table() is the door that reads, and every walker
// visiting more than one meaning takes that table as an argument and hands
// it down its own recursion. mc-book() is the same move one level up —
// every meaning's codes computed once — so resolving a code is a walk over
// answers instead of a re-derivation of them. A caller with many meanings
// to ask about takes mc-table()/mc-codes-in rather than mc-codes per symbol.
// preludes: form/form-stdlib/symbol-voice.bml form/form-stdlib/perception-symbols.bml form/form-stdlib/form-fs.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/sha256.fk form/form-stdlib/hex.fk form/form-stdlib/spool-bell-transport.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormMeaningCodes {
        field MCScripts = "form/form-stdlib/locale-rows/symbol-scripts.rows";
        def mc-dir() = "form/form-stdlib/locale-rows";
        def mc-text(t) = t ?? "";
        def mc-cat(parts) = sv-cat(parts);
        def mc-meanings() = list("you", "me", "us", "US", "WE", "DO", "BE", "SEE", "say", "tell", "offer", "admit", "refuse", "folded", "witness", "release", "nothing", "node", "gas", "water", "ice", "spent", "landed", "glass", "teaching", "gold", "seam", "next", "r", "e", "c", "Q", "adapter", "loss", "whole", "pairs");
        // the perceived things that are not words carry their English phrase in perception-symbols;
        // everything else is the fixed voice's. A symbol neither roster names has no phrase and says so.
        def mc-nl(sym) = mc-nl-of(sym, ps-nl(sym));
        def mc-nl-of(sym, perceived) = str_len(perceived) > 0 ? perceived : sv-fixed(sym);
        // the anchor is the symbol itself, no tongue privileged
        def mc-node(text) = substring(hex-encode(sha256(sbt-bytes-of(text, 0, str_len(text), list()))), 0, 8);
        def mc-anchor(sym) = mc-node(sym);
        // ---- the rows, read once ----
        // row files: header "english|k1|k2|..." then "phrase|c1|c2|..."
        def mc-lines(path) = split-on(mc-text(read_file(path)), byte_to_str(10));
        def mc-trimmed(cells) = (Comparable) len(cells) == 0 ? list() : cons(trim(head(cells)), mc-trimmed(tail(cells)));
        def mc-cells(line) = mc-trimmed(split-on(line, "|"));
        def mc-rows-of(lines) = (Comparable) len(lines) == 0 ? list() : cons(mc-cells(head(lines)), mc-rows-of(tail(lines)));
        // one file's entry: (kinds rows) — the header's kinds after the english key, every row already in cells
        def mc-file-table(path) = mc-file-table-of(mc-lines(path));
        def mc-file-table-of(lines) = (Comparable) len(lines) == 0 ? list(list(), list()) : list(tail(split-on(head(lines), "|")), mc-rows-of(tail(lines)));
        def mc-files() = mc-rows-files(fs-list(mc-dir()));
        def mc-rows-files(names) = (Comparable) len(names) == 0 ? list() : ((Comparable) str_find(head(names), "symbol-", 0) == 0) && (str_find(head(names), ".rows", 0) >= 0) ? cons(fs-path-join(mc-dir(), head(names)), mc-rows-files(tail(names))) : mc-rows-files(tail(names));
        // THE TABLE: every locale file read once and split once
        def mc-table() = mc-table-of(mc-files());
        def mc-table-of(paths) = (Comparable) len(paths) == 0 ? list() : cons(mc-file-table(head(paths)), mc-table-of(tail(paths)));
        // ---- one phrase's row, over rows already in cells ----
        // the resident keyed some rows without the article ("gift" for "a gift"): try the phrase, then the phrase past a leading "a " or "the "
        def mc-bare(phrase) = (Comparable) str_find(phrase, "a ", 0) == 0 ? substring(phrase, 2, str_len(phrase)) : (Comparable) str_find(phrase, "the ", 0) == 0 ? substring(phrase, 4, str_len(phrase)) : phrase;
        // a row matches on ANY column: every tongue keys a row at the same level
        def mc-cell-match?(cells, phrase) = (Comparable) len(cells) == 0 ? 0 : (String) head(cells) == phrase ? 1 : mc-cell-match?(tail(cells), phrase);
        def mc-find-row(rows, phrase) = (Comparable) len(rows) == 0 ? list() : (len(head(rows)) >= 2) && ((Comparable) mc-cell-match?(head(rows), phrase) == 1) ? head(rows) : mc-find-row(tail(rows), phrase);
        def mc-row-for(rows, phrase) {
            let exact = (Comparable) str_len(phrase) == 0 ? list() : mc-find-row(rows, phrase);
            len(exact) > 0 ? exact : ((Comparable) str_len(phrase) == 0) || ((String) mc-bare(phrase) == phrase) ? list() : mc-find-row(rows, mc-bare(phrase));
        }
        def mc-zip(kinds, cells) = ((Comparable) len(kinds) == 0) || ((Comparable) len(cells) == 0) ? list() : cons(list(head(kinds), head(cells)), mc-zip(tail(kinds), tail(cells)));
        def mc-entry-codes(entry, phrase) = mc-entry-row(entry, mc-row-for(entry[1], phrase));
        def mc-entry-row(entry, row) = (Comparable) len(row) == 0 ? list() : mc-zip(head(entry), tail(row));
        def mc-table-codes(tbl, phrase) = (Comparable) len(tbl) == 0 ? list() : append(mc-entry-codes(head(tbl), phrase), mc-table-codes(tail(tbl), phrase));
        // every code of a meaning: (kind code) rows; absent kinds are simply not present
        def mc-codes-in(tbl, sym) = mc-codes-nl(tbl, sym, mc-nl(sym));
        def mc-codes-nl(tbl, sym, nl) = append(list(list("symbol", sym), list("nl", nl), list("node", mc-anchor(sym))), mc-table-codes(tbl, nl));
        def mc-codes(sym) = mc-codes-in(mc-table(), sym);
        // ---- the codebook: every meaning's codes, computed once ----
        def mc-book-of(syms, tbl) = (Comparable) len(syms) == 0 ? list() : cons(list(head(syms), mc-codes-in(tbl, head(syms))), mc-book-of(tail(syms), tbl));
        def mc-book() = mc-book-of(mc-meanings(), mc-table());
        // speak a meaning in any tongue the rows carry (the english phrase is kind "nl")
        def mc-code-of(codes, kind) = (Comparable) len(codes) == 0 ? "" : (String) head(head(codes)) == kind ? head(codes)[1] : mc-code-of(tail(codes), kind);
        def mc-say-in-tbl(tbl, sym, kind) = mc-code-of(mc-codes-in(tbl, sym), kind);
        def mc-say-in(sym, kind) = mc-say-in-tbl(mc-table(), sym, kind);
        def mc-line-in(tokens, kind) = mc-line-in-tbl(mc-table(), tokens, kind);
        def mc-line-in-tbl(tbl, tokens, kind) = (Comparable) len(tokens) == 0 ? "" : mc-cat(list(mc-say-in-or(tbl, head(tokens), kind), (Comparable) len(tail(tokens)) == 0 ? "" : ", ", mc-line-in-tbl(tbl, tail(tokens), kind)));
        def mc-say-in-or(tbl, tok, kind) = mc-said-or-asked(mc-say-in-tbl(tbl, tok, kind), tok);
        def mc-said-or-asked(w, tok) = str_len(w) > 0 ? w : mc-cat(list("[", tok, "?]"));
        def mc-has-code?(codes, code) = (Comparable) len(codes) == 0 ? 0 : (String) head(codes)[1] == code ? 1 : mc-has-code?(tail(codes), code);
        // a code may carry several meanings (the resident gave one Persian word for said and told):
        // resolve answers every meaning that carries it; the round trip is membership; the
        // collisions are listed as the price of compression, never hidden
        def mc-resolve-book(book, code) = (Comparable) len(book) == 0 ? list() : (Comparable) mc-has-code?(head(book)[1], code) == 1 ? cons(head(head(book)), mc-resolve-book(tail(book), code)) : mc-resolve-book(tail(book), code);
        def mc-resolve-in(book, code) = mc-resolve-book(book, trim(code));
        def mc-resolve-all(code) = mc-resolve-in(mc-book(), code);
        // Exact, delimited locale surfaces present in held text. Each result is
        // [surface, first byte offset, all matching symbols]. These are lookup
        // candidates: the surrounding prose still determines language and sense.
        // Identity labels, short anchors and empty cells do not become matches.
        def mc-text-edges() = list(" ", "\t", "\r", "\n", ".", ",", ";", ":", "!", "?", "(", ")", "[", "]", "{", "}", "\"", "'", "`", "|", "/", "=", "<", ">", "-", "—", "–", "“", "”", "‘", "’", "«", "»");
        def mc-text-edge(text, at, before, edges) = nil?(edges) ? 0 : {
            let edge = head(edges);
            let start = before ? (at - str_len(edge)) : at;
            let end = before ? at : (at + str_len(edge));
            (start >= 0) && ((end <= str_len(text)) && ((String) substring(text,start,end) == edge)) ? 1 : mc-text-edge(text,at,before,tail(edges));
        };
        def mc-text-at(text,code,from) {
            let at = str_find(text,code,from);
            at < 0 ? -1 : {
                let end = at + str_len(code);
                let left = ((Comparable) at == 0) || mc-text-edge(text,at,1,mc-text-edges());
                let right = ((Comparable) end == str_len(text)) || mc-text-edge(text,end,0,mc-text-edges());
                left && right ? at : mc-text-at(text,code,at + 1);
            };
        }
        def mc-text-code?(row) = (str_len(row[1]) > 0) && (!mc-member?(list("symbol","nl","node"),head(row)));
        def mc-text-rows(book,rows,text,seen,out) = nil?(rows) ? list(seen,out) : {
            let row = head(rows); let code = row[1];
            let at = (!mc-text-code?(row)) || mc-member?(seen,code) ? -1 : mc-text-at(text,code,0);
            at < 0 ? mc-text-rows(book,tail(rows),text,seen,out) : mc-text-rows(book,tail(rows),text,cons(code,seen),append(out,list(list(code,at,mc-resolve-in(book,code)))));
        };
        def mc-text-book(book,rest,text,seen,out) = nil?(rest) ? out : {
            let found = mc-text-rows(book,head(rest)[1],text,seen,out);
            mc-text-book(book,tail(rest),text,head(found),found[1]);
        };
        def mc-text-codes-in(book,text) = mc-text-book(book,book,text,list(),list());
        def mc-text-codes(text) = mc-text-codes-in(mc-book(),text);
        // the same resolve read in another roster: a perception's codes answer perception symbols
        def mc-resolve-among(syms, code) = mc-resolve-in(mc-book-of(syms, mc-table()), code);
        def mc-perceived-all(code) = mc-resolve-among(ps-symbols(), code);
        def mc-perceived(code) = mc-first-or-none(mc-perceived-all(code));
        def mc-first-or-none(all) = (Comparable) len(all) == 0 ? "" : head(all);
        def mc-resolve(code) = mc-first-or-none(mc-resolve-all(code));
        def mc-member?(xs, x) = (Comparable) len(xs) == 0 ? 0 : (String) head(xs) == x ? 1 : mc-member?(tail(xs), x);
        // round trip: every present code of sym resolves to sym, read against the book of meanings
        def mc-round-book?(book, sym, codes) = (Comparable) len(codes) == 0 ? 1 : (Comparable) str_len(head(codes)[1]) == 0 ? mc-round-book?(book, sym, tail(codes)) : (Comparable) mc-member?(mc-resolve-in(book, head(codes)[1]), sym) == 1 ? mc-round-book?(book, sym, tail(codes)) : 0;
        def mc-round-trip?(sym) = mc-round-one?(mc-table(), sym);
        def mc-round-one?(tbl, sym) = mc-round-book?(mc-book-of(mc-meanings(), tbl), sym, mc-codes-in(tbl, sym));
        def mc-all-round?(syms) = mc-all-round-tbl?(mc-table(), syms);
        def mc-all-round-tbl?(tbl, syms) = mc-all-round-go?(mc-book-of(mc-meanings(), tbl), tbl, syms);
        def mc-all-round-go?(book, tbl, syms) = (Comparable) len(syms) == 0 ? 1 : (Comparable) mc-round-book?(book, head(syms), mc-codes-in(tbl, head(syms))) == 1 ? mc-all-round-go?(book, tbl, tail(syms)) : 0;
        def mc-collisions(syms, acc) = mc-collisions-tbl(mc-table(), syms, acc);
        def mc-collisions-tbl(tbl, syms, acc) = mc-collisions-go(mc-book-of(mc-meanings(), tbl), tbl, syms, acc);
        def mc-collisions-go(book, tbl, syms, acc) = (Comparable) len(syms) == 0 ? acc : mc-collisions-go(book, tbl, tail(syms), mc-coll-codes(book, mc-codes-in(tbl, head(syms)), acc));
        def mc-coll-codes(book, codes, acc) = (Comparable) len(codes) == 0 ? acc : mc-coll-codes(book, tail(codes), mc-coll-one(book, head(codes)[1], acc));
        def mc-coll-one(book, code, acc) = (Comparable) str_len(code) == 0 ? acc : mc-coll-add(code, mc-resolve-in(book, code), acc);
        def mc-coll-add(code, all, acc) = len(all) > 1 ? cons(list(code, all), acc) : acc;
        def mc-join(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? head(xs) : mc-cat(list(head(xs), ",", mc-join(tail(xs))));
        // compression: the shortest present code against the NL phrase, in bytes
        def mc-shortest(codes, best) = (Comparable) len(codes) == 0 ? best : mc-shortest(tail(codes), (str_len(head(codes)[1]) > 0) && (((Comparable) len(best) == 0) || (str_len(head(codes)[1]) < str_len(best[1]))) ? head(codes) : best);
        def mc-line(codes) = (Comparable) len(codes) == 0 ? "" : mc-cat(list(head(head(codes)), ":", (Comparable) str_len(head(codes)[1]) == 0 ? "absent" : head(codes)[1], " ", mc-line(tail(codes))));
    }
    0;
}
