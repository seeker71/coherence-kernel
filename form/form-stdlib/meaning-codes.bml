//////////////////////////////////////////////////////////////////////
// meaning-codes.bml — one meaning, many codes. A meaning is a symbol
// token the body already speaks (symbol-voice for the words, perception-
// symbols for what is not a word); its codes are its NL phrase, a short
// hash anchor of the symbol, and every tongue or script row
// the locale files carry. Every file named symbol-*.rows in the locale
// directory joins: symbol-words.rows and symbol-perception.rows carry
// english|fa|de|fr|pt|ro (the second for the sound around the words),
// symbol-jungle.rows carries the jungle's own tongues, and
// symbol-scripts.rows (english|he|zh|ja) joins the moment the resident
// writes it. Each file's first line names
// its code kinds after the english key.
// mc-resolve-all returns every matching meaning. The round-trip check proves
// membership for each present code, preserving shared codes and alternate senses.
// The short anchor belongs to this codebook; kernel composition identity has
// its own representation. These lookup functions run when explicitly called;
// the local model's decoder continues to predict its own vocabulary token IDs.
// The bytes
// of each code beside the NL phrase measure what speaking in codes
// compresses. A code kind with no row yet is absent and says so.
//
// Two rosters, one grammar. mc-meanings() is what a HEARD LINE resolves
// against, so a spoken "still" stays the word and does not become the room
// being still; ps-symbols() is what a PERCEPTION resolves against, and
// mc-resolve-among walks whichever roster the caller is reading in. Every
// symbol of either roster addresses (mc-anchor) and speaks (mc-say-in) the
// same way — the roster decides what a code may mean, never how it is said.
//
// The rows are read and split ONCE. Form holds no mutable state, so "read
// once" is not a cache: mc-table() is the door that reads, and every walker
// visiting more than one meaning takes that table as an argument and hands
// it down its own recursion. mc-book() is the same move one level up —
// every meaning's codes computed once — so resolving a code is a walk over
// answers instead of a re-derivation of them. A caller with many meanings
// to ask about takes mc-table()/mc-codes-in rather than mc-codes per symbol.
import form/form-stdlib/symbol-voice.bml;
import form/form-stdlib/perception-symbols.bml;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/str-byte-at.fk;
import form/form-stdlib/sha256.fk;
import form/form-stdlib/hex.fk;
import form/form-stdlib/spool-bell-transport.fk;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormMeaningCodes {
        field MCScripts = "form/form-stdlib/locale-rows/symbol-scripts.rows";
        def mc-dir() = "form/form-stdlib/locale-rows";
        def mc-text(t) = if nothing?(t) then "" else t;
        def mc-cat(parts) = sv-cat(parts);
        def mc-meanings() = ["you", "me", "us", "US", "WE", "DO", "BE", "SEE", "say", "tell", "offer", "admit", "refuse", "folded", "witness", "release", "nothing", "node", "gas", "water", "ice", "spent", "landed", "glass", "teaching", "gold", "seam", "next", "r", "e", "c", "Q", "adapter", "loss", "whole", "pairs"];
        // the perceived things that are not words carry their English phrase in perception-symbols;
        // everything else is the fixed voice's. A symbol neither roster names has no phrase and says so.
        def mc-nl(sym) = mc-nl-of(sym, ps-nl(sym));
        def mc-nl-of(sym, perceived) = if (len(perceived) > 0) then perceived else sv-fixed(sym);
        // the anchor is the symbol itself, no tongue privileged
        def mc-node(text) = substring(hex-encode(sha256(sbt-bytes-of(text, 0, len(text), []))), 0, 8);
        def mc-anchor(sym) = mc-node(sym);
        // ---- the rows, read once ----
        // row files: header "english|k1|k2|..." then "phrase|c1|c2|..."
        def mc-lines(path) = split-on(mc-text(read_file(path)), byte_to_str(10));
        def mc-trimmed(cells) = if ((Comparable) len(cells) == 0) then [] else cons(trim(cells[0]), mc-trimmed(cells[1:]));
        def mc-cells(line) = mc-trimmed(split-on(line, "|"));
        def mc-rows-of(lines) = if ((Comparable) len(lines) == 0) then [] else cons(mc-cells(lines[0]), mc-rows-of(lines[1:]));
        // one file's entry: (kinds rows) — the header's kinds after the english key, every row already in cells
        def mc-file-table(path) = mc-file-table-of(mc-lines(path));
        def mc-file-table-of(lines) = if ((Comparable) len(lines) == 0) then [[], []] else [split-on(lines[0], "|")[1:], mc-rows-of(lines[1:])];
        def mc-files() = mc-rows-files(fs-list(mc-dir()));
        def mc-rows-files(names) = if ((Comparable) len(names) == 0) then [] else if (((Comparable) str_find(names[0], "symbol-", 0) == 0) && (str_find(names[0], ".rows", 0) >= 0)) then cons(fs-path-join(mc-dir(), names[0]), mc-rows-files(names[1:])) else mc-rows-files(names[1:]);
        // THE TABLE: every locale file read once and split once
        def mc-table() = mc-table-of(mc-files());
        def mc-table-of(paths) = if ((Comparable) len(paths) == 0) then [] else cons(mc-file-table(paths[0]), mc-table-of(paths[1:]));
        // ---- one phrase's row, over rows already in cells ----
        // the resident keyed some rows without the article ("gift" for "a gift"): try the phrase, then the phrase past a leading "a " or "the "
        def mc-bare(phrase) = if ((Comparable) str_find(phrase, "a ", 0) == 0) then substring(phrase, 2, len(phrase)) else if ((Comparable) str_find(phrase, "the ", 0) == 0) then substring(phrase, 4, len(phrase)) else phrase;
        // a row matches on ANY column: every tongue keys a row at the same level
        def mc-cell-match?(cells, phrase) = if ((Comparable) len(cells) == 0) then 0 else if ((String) cells[0] == phrase) then 1 else mc-cell-match?(cells[1:], phrase);
        def mc-find-row(rows, phrase) = if ((Comparable) len(rows) == 0) then [] else if ((len(rows[0]) >= 2) && ((Comparable) mc-cell-match?(rows[0], phrase) == 1)) then rows[0] else mc-find-row(rows[1:], phrase);
        def mc-row-for(rows, phrase) {
            let exact = if ((Comparable) len(phrase) == 0) then [] else mc-find-row(rows, phrase);
            if (len(exact) > 0) then exact else if (((Comparable) len(phrase) == 0) || ((String) mc-bare(phrase) == phrase)) then [] else mc-find-row(rows, mc-bare(phrase));
        }
        def mc-zip(kinds, cells) = if (((Comparable) len(kinds) == 0) || ((Comparable) len(cells) == 0)) then [] else cons([kinds[0], cells[0]], mc-zip(kinds[1:], cells[1:]));
        def mc-entry-codes(entry, phrase) = mc-entry-row(entry, mc-row-for(entry[1], phrase));
        def mc-entry-row(entry, row) = if ((Comparable) len(row) == 0) then [] else mc-zip(entry[0], row[1:]);
        def mc-table-codes(tbl, phrase) = if ((Comparable) len(tbl) == 0) then [] else append(mc-entry-codes(tbl[0], phrase), mc-table-codes(tbl[1:], phrase));
        // every code of a meaning: (kind code) rows; absent kinds are simply not present
        def mc-codes-in(tbl, sym) = mc-codes-nl(tbl, sym, mc-nl(sym));
        def mc-codes-nl(tbl, sym, nl) = append([["symbol", sym], ["nl", nl], ["node", mc-anchor(sym)]], mc-table-codes(tbl, nl));
        def mc-codes(sym) = mc-codes-in(mc-table(), sym);
        // ---- the codebook: every meaning's codes, computed once ----
        def mc-book-of(syms, tbl) = if ((Comparable) len(syms) == 0) then [] else cons([syms[0], mc-codes-in(tbl, syms[0])], mc-book-of(syms[1:], tbl));
        def mc-book() = mc-book-of(mc-meanings(), mc-table());
        // speak a meaning in any tongue the rows carry (the english phrase is kind "nl")
        def mc-code-of(codes, kind) = if ((Comparable) len(codes) == 0) then "" else if ((String) codes[0][0] == kind) then codes[0][1] else mc-code-of(codes[1:], kind);
        def mc-say-in-tbl(tbl, sym, kind) = mc-code-of(mc-codes-in(tbl, sym), kind);
        def mc-say-in(sym, kind) = mc-say-in-tbl(mc-table(), sym, kind);
        def mc-line-in(tokens, kind) = mc-line-in-tbl(mc-table(), tokens, kind);
        def mc-line-in-tbl(tbl, tokens, kind) = if ((Comparable) len(tokens) == 0) then "" else mc-say-in-or(tbl, tokens[0], kind) ++ (if ((Comparable) len(tokens[1:]) == 0) then "" else ", ") ++ mc-line-in-tbl(tbl, tokens[1:], kind);
        def mc-say-in-or(tbl, tok, kind) = mc-said-or-asked(mc-say-in-tbl(tbl, tok, kind), tok);
        def mc-said-or-asked(w, tok) = if (len(w) > 0) then w else "[" ++ tok ++ "?]";
        def mc-has-code?(codes, code) = if ((Comparable) len(codes) == 0) then 0 else if ((String) codes[0][1] == code) then 1 else mc-has-code?(codes[1:], code);
        // a code may carry several meanings (the resident gave one Persian word for said and told):
        // resolve answers every meaning that carries it; the round trip is membership; the
        // collisions are listed as the price of compression, never hidden
        def mc-resolve-book(book, code) = if ((Comparable) len(book) == 0) then [] else if ((Comparable) mc-has-code?(book[0][1], code) == 1) then cons(book[0][0], mc-resolve-book(book[1:], code)) else mc-resolve-book(book[1:], code);
        def mc-resolve-in(book, code) = mc-resolve-book(book, trim(code));
        def mc-resolve-all(code) = mc-resolve-in(mc-book(), code);
        // Exact, delimited locale surfaces present in held text. Each result is
        // [surface, first byte offset, all matching symbols]. These are lookup
        // candidates: the surrounding prose still determines language and sense.
        // Identity labels, short anchors and empty cells do not become matches.
        def mc-text-edges() = [" ", "\t", "\r", "\n", ".", ",", ";", ":", "!", "?", "(", ")", "[", "]", "{", "}", "\"", "'", "`", "|", "/", "=", "<", ">", "-", "—", "–", "“", "”", "‘", "’", "«", "»"];
        def mc-text-edge(text, at, before, edges) = if nil?(edges) then 0 else {
            let edge = edges[0];
            let start = if before then (at - len(edge)) else at;
            let end = if before then at else (at + len(edge));
            if ((start >= 0) && ((end <= len(text)) && ((String) substring(text,start,end) == edge))) then 1 else mc-text-edge(text,at,before,edges[1:]);
        };
        def mc-text-at(text,code,from) {
            let at = str_find(text,code,from);
            if (at < 0) then -1 else {
                let end = (at + len(code));
                let left = (((Comparable) at == 0) || mc-text-edge(text,at,1,mc-text-edges()));
                let right = (((Comparable) end == len(text)) || mc-text-edge(text,end,0,mc-text-edges()));
                if (left && right) then at else mc-text-at(text,code,(at + 1));
            };
        }
        def mc-text-code?(row) = ((len(row[1]) > 0) && (!mc-member?(["symbol","nl","node"],row[0])));
        def mc-text-rows(book,rows,text,seen,out) = if nil?(rows) then [seen,out] else {
            let row = rows[0]; let code = row[1];
            let at = if ((!mc-text-code?(row)) || mc-member?(seen,code)) then -1 else mc-text-at(text,code,0);
            if (at < 0) then mc-text-rows(book,rows[1:],text,seen,out) else mc-text-rows(book,rows[1:],text,cons(code,seen),append(out,[[code,at,mc-resolve-in(book,code)]]));
        };
        def mc-text-book(book,rest,text,seen,out) = if nil?(rest) then out else {
            let found = mc-text-rows(book,rest[0][1],text,seen,out);
            mc-text-book(book,rest[1:],text,found[0],found[1]);
        };
        def mc-text-codes-in(book,text) = mc-text-book(book,book,text,[],[]);
        def mc-text-codes(text) = mc-text-codes-in(mc-book(),text);
        // the same resolve read in another roster: a perception's codes answer perception symbols
        def mc-resolve-among(syms, code) = mc-resolve-in(mc-book-of(syms, mc-table()), code);
        def mc-perceived-all(code) = mc-resolve-among(ps-symbols(), code);
        def mc-perceived(code) = mc-first-or-none(mc-perceived-all(code));
        def mc-first-or-none(all) = if ((Comparable) len(all) == 0) then "" else all[0];
        def mc-resolve(code) = mc-first-or-none(mc-resolve-all(code));
        def mc-member?(xs, x) = if ((Comparable) len(xs) == 0) then 0 else if ((String) xs[0] == x) then 1 else mc-member?(xs[1:], x);
        // round trip: every present code of sym resolves to sym, read against the book of meanings
        def mc-round-book?(book, sym, codes) = if ((Comparable) len(codes) == 0) then 1 else if ((Comparable) len(codes[0][1]) == 0) then mc-round-book?(book, sym, codes[1:]) else if ((Comparable) mc-member?(mc-resolve-in(book, codes[0][1]), sym) == 1) then mc-round-book?(book, sym, codes[1:]) else 0;
        def mc-round-trip?(sym) = mc-round-one?(mc-table(), sym);
        def mc-round-one?(tbl, sym) = mc-round-book?(mc-book-of(mc-meanings(), tbl), sym, mc-codes-in(tbl, sym));
        def mc-all-round?(syms) = mc-all-round-tbl?(mc-table(), syms);
        def mc-all-round-tbl?(tbl, syms) = mc-all-round-go?(mc-book-of(mc-meanings(), tbl), tbl, syms);
        def mc-all-round-go?(book, tbl, syms) = if ((Comparable) len(syms) == 0) then 1 else if ((Comparable) mc-round-book?(book, syms[0], mc-codes-in(tbl, syms[0])) == 1) then mc-all-round-go?(book, tbl, syms[1:]) else 0;
        def mc-collisions(syms, acc) = mc-collisions-tbl(mc-table(), syms, acc);
        def mc-collisions-tbl(tbl, syms, acc) = mc-collisions-go(mc-book-of(mc-meanings(), tbl), tbl, syms, acc);
        def mc-collisions-go(book, tbl, syms, acc) = if ((Comparable) len(syms) == 0) then acc else mc-collisions-go(book, tbl, syms[1:], mc-coll-codes(book, mc-codes-in(tbl, syms[0]), acc));
        def mc-coll-codes(book, codes, acc) = if ((Comparable) len(codes) == 0) then acc else mc-coll-codes(book, codes[1:], mc-coll-one(book, codes[0][1], acc));
        def mc-coll-one(book, code, acc) = if ((Comparable) len(code) == 0) then acc else mc-coll-add(code, mc-resolve-in(book, code), acc);
        def mc-coll-add(code, all, acc) = if (len(all) > 1) then cons([code, all], acc) else acc;
        def mc-join(xs) = if ((Comparable) len(xs) == 0) then "" else if ((Comparable) len(xs[1:]) == 0) then xs[0] else xs[0] ++ "," ++ mc-join(xs[1:]);
        // compression: the shortest present code against the NL phrase, in bytes
        def mc-shortest(codes, best) = if ((Comparable) len(codes) == 0) then best else mc-shortest(codes[1:], if ((len(codes[0][1]) > 0) && (((Comparable) len(best) == 0) || (len(codes[0][1]) < len(best[1])))) then codes[0] else best);
        def mc-line(codes) = if ((Comparable) len(codes) == 0) then "" else codes[0][0] ++ ":" ++ (if ((Comparable) len(codes[0][1]) == 0) then "absent" else codes[0][1]) ++ " " ++ mc-line(codes[1:]);
    }
    0;
}
