// A local lift reads and writes through the file door and publishes through
// shared memory. Every other host door stays closed for this work.
// Widths and protocols are names. The template is the generic crossing.
// preludes: form-stdlib/host-os-membrane.fk form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template LiftCrossing<Protocol, Carrier> {
        member protocol : Protocol;
        member carrier : Carrier;
    }

    class FormLift {
        def fl-file() = "host:file";
        def fl-memory() = "host:memory";
        def fl-http() = "http:request";
        def fl-speech() = "speech:loopback";
        def fl-word() = 64;
        def fl-flag() = 1;
        def fl-no() = 0;
        def fl-kept?(protocol) = (((String) protocol == fl-file()) || ((String) protocol == fl-memory())) ? fl-flag() : fl-no();
        def fl-admit(protocol) = (fl-kept?(protocol) && (hom-door-body-owned?(protocol) && hom-door-local(hom-door-for(protocol)))) ? fl-flag() : fl-no();
        def fl-widths() = list(fl-word(), fl-flag(), fl-word());
        def fl-present(value) = value ?? fl-flag();
    }

    let offered = list(fl-file(), fl-http(), fl-memory(), fl-speech());
    let kept = offered |> filter(p => fl-admit(p));
    let bits = sum(fl-widths());
    let face = fl-admit(fl-file()) + fl-admit(fl-memory());
    let closed = fl-admit(fl-http()) + fl-admit(fl-speech());
    let absent = fl-present(nothing());
    let order = ((String) head(kept) == fl-file()) ? fl-flag() : fl-no();
    (len(kept) + (bits + (face + (closed + (absent + order)))));
}
