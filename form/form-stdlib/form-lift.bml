// A lift admits every door the catalog offers. File and shared memory are
// two of those doors. A name that is not a door stays absent.
// Widths are names. The template is the generic crossing.
// preludes: form-stdlib/host-os-membrane.fk form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template LiftCrossing<Protocol, Carrier> {
        member protocol : Protocol;
        member carrier : Carrier;
    }

    class FormLift {
        def fl-file() = "host:file";
        def fl-unnamed() = "no-such-door";
        def fl-word() = 64;
        def fl-flag() = 1;
        def fl-no() = 0;
        def fl-open?(protocol) = (hom-door-body-owned?(protocol) && hom-door-local(hom-door-for(protocol))) ? fl-flag() : fl-no();
        def fl-widths() = list(fl-word(), fl-flag(), fl-word());
        def fl-present(value) = value ?? fl-flag();
        def fl-protocols() = hom-doors() |> map(d => hom-door-protocol(d));
    }

    let protocols = fl-protocols();
    let kept = protocols |> filter(p => fl-open?(p));
    let bits = sum(fl-widths());
    let face = sum(protocols |> map(p => fl-open?(p)));
    let missing = fl-open?(fl-unnamed());
    let absent = fl-present(nothing());
    let whole = ((Comparable) len(kept) == len(protocols)) ? fl-flag() : fl-no();
    let order = ((String) head(kept) == fl-file()) ? fl-flag() : fl-no();
    (len(kept) + (bits + (face + (missing + (absent + (whole + order))))));
}
