//////////////////////////////////////////////////////////////////////
//
// ear-axes.bml — a heard line is a point, not a line.
//
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/meaning-codes.bml form/form-stdlib/rumi-glass.bml form/form-stdlib/bml/ear-transcript.bml
//
// The ear organ writes frames; the glass paints rows. Between them a heard
// line was one row of text, and that is the thinnest thing the body knows
// about a moment in the room. This cell gives the moment its axes: the room's
// level and which way it is moving, the ear's own state word, the line as it
// grows and the line when it closed, the tongue it was heard in and the doubt
// the pass reports, every tongue the dense lane said it in, the symbols the
// line resolves to and their node ids (the same line said in codes, and what
// that compresses), the verse the state touches, each stage's own latency, and
// the phase the ear's own rows sit in. Then the moments themselves, newest
// first, so the glass paints a stream and not a list.
//
// Cost is where a sensor lives or dies: this ear gives every 100 ms. So the
// two doors that read files -- the meaning table (mc-codes over every meaning,
// 168 ms measured) and the verse table (rg-find per state word, 8-12 ms on a
// hit, 746 ms on a miss) -- are walked ONCE at birth into ea-sense, and the
// give path is pure folding over strings already in hand. Nothing here opens
// a file, forks, or touches the GPU.
//
// The lifecycle each row carries is the phase the glass sorts it under
// (fgl-phase-index): "source" is gas -- the line still growing, uncommitted;
// "live" is water -- the room measured this instant; "stored" is ice -- what
// the spool holds and can be read again. The ear does not carry its own phase
// table; it chooses the words the glass already classifies, so ear.phase and
// the glass's own census cannot disagree.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormEarAxesAuthority {
        field EAAuthorityPath = "form/form-stdlib/ear-axes.bml";
        field EAAuthorityKind = "high-bml-interface-class-const";
    }

    class FormEarAxes {
        field EASchema = "ear-axes-v1";
        field EAOpen = "<|ear:frame|>";
        field EAClose = "<|/ear:frame|>";
        field EAStreamDepth = 6;
        field EADomain = "ear";
        field EAPlane = "organ";
        field EASource = "ear-organ";
        field EAChannel = "voice";
        ref ea-authority = FormEarAxesAuthority;
        thought ea-law = list("a-moment-is-a-point", "axes-not-one-row", "tables-once-at-birth", "lifecycle-is-the-phase-word", "absent-says-its-door", "newest-first");

        def ea-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), ea-cat(tail(parts)));
        def ea-text(t) = if nothing?(t) then "" else t;

        // ── the axes this stream carries, named once ───────────────────────
        def ea-axes() = list("state", "level", "trend", "latency", "growing", "grow", "hops", "closed", "tongue", "doubt", "words", "encode", "decode", "tokens", "commit", "said", "tongues", "symbols", "nodes", "compression", "verse", "poem", "phase", "stream");

        // ── frames: one <|ear:frame|> block is key=value lines ──────────────
        def ea-line-end(s, i) = if ge(i, str_len(s)) then i else if eq(str_byte_at(s, i), 10) then i else ea-line-end(s, add(i, 1));
        def ea-field(f, key) = ea-field-at(f, key, str_find(f, str_concat(byte_to_str(10), str_concat(key, "=")), 0), add(str_len(key), 2));
        def ea-field-at(f, key, at, skip) = if lt(at, 0) then "" else substring(f, add(at, skip), ea-line-end(f, add(at, skip)));
        def ea-has?(f, key) = if lt(str_find(f, str_concat(byte_to_str(10), str_concat(key, "=")), 0), 0) then 0 else 1;
        def ea-int(f, key) = ea-int-of(ea-field(f, key));
        def ea-int-of(v) = if eq(str_len(v), 0) then 0 else str_to_int(v);
        def ea-frames(text, from, acc) = ea-frames-at(text, from, acc, str_find(text, EAOpen(), from));
        def ea-frames-at(text, from, acc, o) = if lt(o, 0) then reverse(acc) else ea-frames-cut(text, acc, o, str_find(text, EAClose(), o));
        def ea-frames-cut(text, acc, o, c) = if lt(c, 0) then reverse(acc) else ea-frames(text, add(c, str_len(EAClose())), cons(substring(text, o, add(c, str_len(EAClose()))), acc));
        def ea-through(text, from, last) = ea-through-at(text, from, last, str_find(text, EAClose(), from));
        def ea-through-at(text, from, last, c) = if lt(c, 0) then last else ea-through(text, add(c, str_len(EAClose())), add(c, str_len(EAClose())));
        def ea-said?(f) = if str_eq(ea-field(f, "kind"), "said") then 1 else if str_eq(ea-field(f, "kind"), "saying") then 1 else 0;
        def ea-heard-kind?(f) = if str_eq(ea-field(f, "kind"), "heard") then 1 else ea-said?(f);
        // live keeps the newest frame that is NOT a commit: kinds live, quiet, born, done
        def ea-newest(frames, live, heard, said) = if eq(len(frames), 0) then list(live, heard, said) else ea-newest-one(head(frames), tail(frames), live, heard, said);
        def ea-newest-one(f, rest, live, heard, said) = ea-newest(rest, if eq(ea-heard-kind?(f), 1) then live else f, if str_eq(ea-field(f, "kind"), "heard") then f else heard, if eq(ea-said?(f), 1) then f else said);

        // ── words: bytes lowered, edges cleaned, so a code can be matched ───
        def ea-lower-byte(b) = if and(ge(b, 65), le(b, 90)) then add(b, 32) else b;
        def ea-lower-go(s, i, acc) = if ge(i, str_len(s)) then acc else ea-lower-go(s, add(i, 1), str_concat(acc, byte_to_str(ea-lower-byte(str_byte_at(s, i)))));
        def ea-lower(s) = ea-lower-go(s, 0, "");
        def ea-word-byte?(b) = if and(ge(b, 97), le(b, 122)) then 1 else if and(ge(b, 48), le(b, 57)) then 1 else if ge(b, 128) then 1 else 0;
        def ea-front(s, i) = if ge(i, str_len(s)) then i else if eq(ea-word-byte?(str_byte_at(s, i)), 1) then i else ea-front(s, add(i, 1));
        def ea-back(s, j) = if le(j, 0) then j else if eq(ea-word-byte?(str_byte_at(s, sub(j, 1))), 1) then j else ea-back(s, sub(j, 1));
        def ea-clean(w) = ea-clean-cut(w, ea-front(w, 0));
        def ea-clean-cut(w, a) = if ge(a, str_len(w)) then "" else substring(w, a, ea-back(w, str_len(w)));
        def ea-words-go(parts, acc) = if eq(len(parts), 0) then reverse(acc) else ea-words-go(tail(parts), ea-words-keep(ea-clean(head(parts)), acc));
        def ea-words-keep(w, acc) = if eq(str_len(w), 0) then acc else cons(w, acc);
        def ea-words(line) = if eq(str_len(line), 0) then list() else ea-words-go(split-on(ea-lower(line), " "), list());
        def ea-word-count(line) = len(ea-words(line));
        def ea-member?(xs, x) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), x) then 1 else ea-member?(tail(xs), x);

        // ── the meaning table: every meaning's codes, walked once at birth ──
        def ea-meaning-row(sym) = list(sym, mc-nl(sym), mc-anchor(sym), mc-codes(sym));
        def ea-meaning-sym(row) = head(row);
        def ea-meaning-node(row) = nth(row, 2);
        def ea-meaning-codes(row) = nth(row, 3);
        def ea-meaning-table-go(syms, acc) = if eq(len(syms), 0) then reverse(acc) else ea-meaning-table-go(tail(syms), cons(ea-meaning-row(head(syms)), acc));
        def ea-meaning-table() = ea-meaning-table-go(mc-meanings(), list());
        // a code of two bytes or more: one word matched whole, a phrase matched in the line
        def ea-one-code-hit?(code, words, line) = ea-one-code-at(ea-lower(trim(code)), words, line);
        def ea-one-code-at(c, words, line) = if lt(str_len(c), 2) then 0 else if ge(str_find(c, " ", 0), 0) then ea-phrase-hit?(line, c) else ea-member?(words, c);
        def ea-phrase-hit?(line, c) = if lt(str_find(line, c, 0), 0) then 0 else 1;
        def ea-code-hit?(codes, words, line) = if eq(len(codes), 0) then 0 else if eq(ea-one-code-hit?(nth(head(codes), 1), words, line), 1) then 1 else ea-code-hit?(tail(codes), words, line);
        def ea-symbols-go(table, words, line, acc) = if eq(len(table), 0) then reverse(acc) else ea-symbols-go(tail(table), words, line, if eq(ea-code-hit?(ea-meaning-codes(head(table)), words, line), 1) then cons(head(table), acc) else acc);
        def ea-symbols(table, line) = if eq(str_len(line), 0) then list() else ea-symbols-go(table, ea-words(line), ea-lower(line), list());
        def ea-join(xs, sep) = if eq(len(xs), 0) then "" else if eq(len(tail(xs)), 0) then head(xs) else ea-cat(list(head(xs), sep, ea-join(tail(xs), sep)));
        def ea-sym-names(hits) = if eq(len(hits), 0) then list() else cons(ea-meaning-sym(head(hits)), ea-sym-names(tail(hits)));
        def ea-node-names(hits) = if eq(len(hits), 0) then list() else cons(ea-meaning-node(head(hits)), ea-node-names(tail(hits)));
        def ea-sym-line(hits) = ea-join(ea-sym-names(hits), " ");
        def ea-node-line(hits) = ea-join(ea-node-names(hits), " ");
        // what saying the line in codes would cost against the words themselves
        def ea-compression(line, hits) = if eq(len(hits), 0) then 0 else sub(str_len(line), str_len(ea-sym-line(hits)));

        // ── the ear's own state word, and the verse it touches ─────────────
        def ea-states() = list("asleep", "deaf", "silent", "speaking", "heard");
        def ea-state-word(state) = if str_eq(state, "asleep") then "resting" else if str_eq(state, "deaf") then "blind" else if str_eq(state, "silent") then "silent" else if str_eq(state, "speaking") then "speaking" else "grown";
        def ea-state(awake, live, heard) = ea-state-of(awake, ea-field(live, "kind"), ea-int(live, "db"), ea-field(live, "live"), ea-field(heard, "heard"), ea-int(heard, "t"), ea-int(live, "t"));
        def ea-state-of(awake, kind, db, growing, closed, heardT, liveT) {
            if eq(awake, 0) then "asleep"
            else if str_eq(kind, "done") then "deaf"
            else if le(db, -120) then "deaf"
            else if gt(str_len(growing), 0) then "speaking"
            else if and(gt(str_len(closed), 0), ge(heardT, liveT)) then "heard"
            else "silent";
        }
        def ea-state-note(state) = if str_eq(state, "asleep") then "the marker is absent; the mic is closed and the lanes are down" else if str_eq(state, "deaf") then "the ear is wanted but the mic gives nothing: the lane is born or ended, or the host grant is not open" else if str_eq(state, "silent") then "the room is under the lane's speech floor; no line is open" else if str_eq(state, "speaking") then "a line is open and growing pass by pass" else "a line closed at a pause or a full window";
        def ea-verse-row(state) = ea-verse-found(state, rg-find(ea-state-word(state)));
        def ea-verse-found(state, found) = ea-verse-hit(state, nth(found, 1), head(head(found)));
        def ea-verse-hit(state, h, word) = if eq(len(h), 0) then list(state, word, "", "", 0) else list(state, word, rg-hit-line1(h), rg-hit-line2(h), ea-poem-id(h));
        def ea-poem-id(h) = ea-poem-int(rg-poem-id(h));
        def ea-poem-int(n) = if eq(sv-digits?(n, 0), 1) then ea-int-of(n) else 0;
        def ea-verse-table-go(states, acc) = if eq(len(states), 0) then reverse(acc) else ea-verse-table-go(tail(states), cons(ea-verse-row(head(states)), acc));
        def ea-verse-table() = ea-verse-table-go(ea-states(), list());
        def ea-verse-for(table, state) = if eq(len(table), 0) then list(state, "", "", "", 0) else if str_eq(head(head(table)), state) then head(table) else ea-verse-for(tail(table), state);
        def ea-verse-word(v) = nth(v, 1);
        def ea-verse-text(v) = if eq(str_len(nth(v, 2)), 0) then "" else ea-cat(list(nth(v, 2), "  ‖  ", nth(v, 3)));
        def ea-verse-poem(v) = nth(v, 4);

        // ── the room's level, and which way it is moving ───────────────────
        def ea-trend(db, prev) = if eq(len(prev), 0) then "first reading" else ea-trend-of(sub(db, head(prev)));
        def ea-trend-of(d) = if ge(d, 3) then ea-cat(list("rising +", int_to_str(d), " dB")) else if le(d, -3) then ea-cat(list("falling ", int_to_str(d), " dB")) else if eq(d, 0) then "steady" else ea-cat(list("steady (", int_to_str(d), " dB)"));

        // ── the sense the sensor carries between gives ─────────────────────
        // list(schema, meanings, verses, prevDb, prevGrowing, points, hops)
        def ea-sense(meanings, verses, prevDb, prevGrowing, points, hops) = list(EASchema(), meanings, verses, prevDb, prevGrowing, points, hops);
        def ea-sense-born() = ea-sense(ea-meaning-table(), ea-verse-table(), list(), "", list(), 0);
        def ea-sense-meanings(s) = nth(s, 1);
        def ea-sense-verses(s) = nth(s, 2);
        def ea-sense-prev-db(s) = nth(s, 3);
        def ea-sense-prev-growing(s) = nth(s, 4);
        def ea-sense-points(s) = nth(s, 5);
        def ea-sense-hops(s) = nth(s, 6);
        // a point of the stream: list(t, lang, text, commitMs, symbols)
        def ea-point(t, lang, text, ms, syms) = list(t, lang, text, ms, syms);
        def ea-point-t(p) = head(p);
        def ea-point-text(p) = nth(p, 2);
        def ea-take(xs, n) = if or(le(n, 0), eq(len(xs), 0)) then list() else cons(head(xs), ea-take(tail(xs), sub(n, 1)));
        def ea-push(points, p) = if and(gt(len(points), 0), str_eq(ea-point-text(head(points)), ea-point-text(p))) then points else ea-take(cons(p, points), EAStreamDepth());
        def ea-points-next(sense, heard, closed) = if eq(str_len(closed), 0) then ea-sense-points(sense) else ea-push(ea-sense-points(sense), ea-point(ea-int(heard, "t"), ea-field(heard, "lang"), closed, ea-int(heard, "heardms"), ea-sym-line(ea-symbols(ea-sense-meanings(sense), closed))));
        def ea-hops-next(hops, growing, prevGrowing) = if eq(str_len(growing), 0) then 0 else if str_eq(growing, prevGrowing) then hops else add(hops, 1);
        def ea-sense-step(sense, live, heard, said, awake) = ea-sense-stepped(sense, ea-int(live, "db"), ea-field(live, "live"), ea-field(heard, "heard"), heard);
        def ea-sense-stepped(sense, db, growing, closed, heard) = ea-sense(ea-sense-meanings(sense), ea-sense-verses(sense), list(db), growing, ea-points-next(sense, heard, closed), ea-hops-next(ea-sense-hops(sense), growing, ea-sense-prev-growing(sense)));

        // ── rows: the moment's axes, then the moments ──────────────────────
        def ea-row(id, label, value, lifecycle, note) = fgo-text(EADomain(), id, label, value, EAPlane(), "physical-live", EASource(), lifecycle, EAChannel(), note);
        def ea-row-or-absent(id, label, value, lifecycle, door, note) = if eq(fgo-blank-text-at?(value, 0), 1) then fgo-unavailable(EADomain(), id, label, "text", EAPlane(), door, EAChannel(), note) else ea-row(id, label, value, lifecycle, note);
        def ea-num(id, label, value, unit, lifecycle, note) = fgo-int(EADomain(), id, label, value, unit, 0, EAPlane(), "physical-live", EASource(), lifecycle, EAChannel(), note);
        def ea-num-or-absent(id, label, value, unit, lifecycle, door, note) = if le(value, 0) then fgo-unavailable(EADomain(), id, label, unit, EAPlane(), door, EAChannel(), note) else ea-num(id, label, value, unit, lifecycle, note);

        // the room, this instant
        def ea-room-rows(sense, live, heard, awake, state, verse) = list(
            ea-row("ear.state", "the ear", ea-cat(list(state, " — ", ea-verse-word(verse))), "live", ea-state-note(state)),
            ea-num("ear.level", "the room's level", ea-int(live, "db"), "dbfs", "live", "the mic organ's own measure over the last three chunks"),
            ea-row("ear.level.trend", "the room, moving", ea-trend(ea-int(live, "db"), ea-sense-prev-db(sense)), "live", "this level against the level of the give before it; three dB is the step that counts as movement"),
            ea-num("ear.latency", "last sample to this row", ea-int(live, "livems"), "ms", "live", "the ear's own hop: the newest sample through the whisper pass into this row"));

        // the line, growing
        def ea-growing-rows(sense, live) = list(
            ea-row-or-absent("ear.live", "the line as it grows", ea-live-text(live), "source", "ear.spool.live", "no line is open: the room is under the speech floor, or the pass has not answered yet"),
            ea-num("ear.grow", "the line's growth", ea-grow(ea-field(live, "live"), ea-sense-prev-growing(sense)), "bytes", "source", "bytes the open line gained since the give before it; a restart reads zero"),
            ea-num("ear.hops", "passes on this line", ea-sense-hops(sense), "passes", "source", "whisper passes since this line opened; the line is re-read whole each hop, so this is also how many times these words were heard"));
        def ea-live-text(live) = ea-with-lang(ea-field(live, "livelang"), ea-field(live, "live"));
        def ea-with-lang(lang, text) = if eq(str_len(text), 0) then "" else if eq(str_len(lang), 0) then text else ea-cat(list(lang, "  ", text));
        def ea-grow(growing, prevGrowing) = if le(str_len(growing), str_len(prevGrowing)) then 0 else sub(str_len(growing), str_len(prevGrowing));

        // the line, closed
        def ea-closed-rows(heard) = list(
            ea-row-or-absent("ear.heard", "the line when it closed", ea-with-lang(ea-field(heard, "lang"), ea-field(heard, "heard")), "stored", "ear.spool.heard", "no line has closed yet in this ear's lifetime"),
            ea-row-or-absent("ear.tongue", "the tongue it was heard in", ea-field(heard, "lang"), "stored", "ear.spool.lang", "the pass reported no language for the closed line"),
            ea-doubt-row(heard),
            ea-num-or-absent("ear.words", "words in the closed line", ea-word-count(ea-field(heard, "heard")), "words", "stored", "ear.spool.heard", "no closed line to count"));
        // the pass's own no-speech doubt: the door is read, and what it answered stands
        def ea-doubt-row(heard) = if eq(ea-has?(heard, "nsp"), 0) then fgo-unavailable(EADomain(), "ear.doubt", "the pass's own doubt", "per-mille", EAPlane(), "ear.spool.nsp", EAChannel(), "the frame carries no nsp field") else ea-doubt-value(ea-int(heard, "nsp"));
        def ea-doubt-value(nsp) = if gt(nsp, 0) then ea-num("ear.doubt", "the pass's own doubt", nsp, "per-mille", "stored", "whisper's no-speech probability for the closed line, in parts per thousand") else fgo-probed-absent(EADomain(), "ear.doubt", "the pass's own doubt", "per-mille", EAPlane(), "ear.spool.nsp", "0", EAChannel(), "the field is present and reads zero every frame: the live lane writes a constant, so whisper's own no_speech probability is not yet carried out of the pass");

        // each stage's own latency
        def ea-stage-rows(live, heard, said) = list(
            ea-num-or-absent("ear.encode", "whisper encode", ea-int(live, "encms"), "ms", "live", "ear.spool.encms", "no pass in this frame to time"),
            ea-num-or-absent("ear.decode", "whisper decode", ea-int(live, "decms"), "ms", "live", "ear.spool.decms", "no pass in this frame to time"),
            ea-num-or-absent("ear.tokens", "tokens in the pass", ea-int(live, "ntok"), "tokens", "live", "ear.spool.ntok", "no pass in this frame to count"),
            ea-num-or-absent("ear.commit", "pause to closed line", ea-int(heard, "heardms"), "ms", "stored", "ear.spool.heardms", "no line has closed yet"),
            ea-num-or-absent("ear.said", "closed line to tongues", ea-int(said, "saidms"), "ms", "stored", "ear.spool.saidms", "the dense lane has not answered this line yet"));

        // every tongue the dense lane said it in
        def ea-codes(said, wanted) = ea-codes-of(ea-field(said, "tongues"), wanted);
        def ea-codes-of(t, wanted) = if gt(str_len(t), 0) then split-on(t, " ") else if gt(str_len(wanted), 0) then split-on(wanted, " ") else list("en", "pt", "fa", "id");
        def ea-tongue-rows(said, codes) = if eq(len(codes), 0) then list() else cons(ea-tongue-row(said, head(codes)), ea-tongue-rows(said, tail(codes)));
        def ea-tongue-row(said, code) = ea-row-or-absent(str_concat("ear.tongue.", code), ea-cat(list("said in ", code)), ea-field(said, str_concat("t_", code)), "stored", str_concat("ear.spool.t_", code), "the dense lane has not offered this tongue for the line that stands");
        def ea-tongue-said(said, codes) = ea-tongue-count(said, codes, 0);
        def ea-tongue-count(said, codes, n) = if eq(len(codes), 0) then n else ea-tongue-count(said, tail(codes), if gt(str_len(ea-field(said, str_concat("t_", head(codes)))), 0) then add(n, 1) else n);

        // the meaning: the same line said in symbols, and their content addresses
        def ea-meaning-rows(sense, heard) = ea-meaning-rows-of(ea-field(heard, "heard"), ea-symbols(ea-sense-meanings(sense), ea-field(heard, "heard")));
        def ea-meaning-rows-of(closed, hits) = list(
            ea-row-or-absent("ear.symbols", "the line in symbols", ea-sym-line(hits), "stored", "meaning-codes.mc-codes", ea-meaning-absent-note(closed)),
            ea-row-or-absent("ear.nodes", "their node ids", ea-node-line(hits), "stored", "meaning-codes.mc-anchor", ea-meaning-absent-note(closed)),
            ea-num-or-absent("ear.compression", "what codes would save", ea-compression(closed, hits), "bytes", "stored", "meaning-codes.mc-codes", "no meaning of this body stands in the closed line, so there is nothing shorter to say it with"));
        def ea-meaning-absent-note(closed) = if eq(str_len(closed), 0) then "no line has closed yet" else "the closed line carries no word this body has a meaning for; the meanings are mc-meanings(), matched whole-word against every tongue and script the locale rows carry";

        // the verse the state touches
        def ea-verse-rows(verse) = list(
            ea-row-or-absent("ear.verse", "the verse this state touches", ea-verse-text(verse), "stored", "rumi-glass.rg-find", ea-cat(list("no couplet in the store carries ", ea-verse-word(verse), ", the Persian word for this state"))),
            ea-num-or-absent("ear.verse.poem", "the poem it stands in", ea-verse-poem(verse), "poem", "stored", "rumi-glass.rg-poem-id", "no couplet was found, so no poem to name"));

        // the stream about itself: the phase its own rows sit in, and how many axes it carries
        def ea-lifecycle-count(rows, want) = if eq(len(rows), 0) then 0 else add(if str_eq(fgo-lifecycle(head(rows)), want) then 1 else 0, ea-lifecycle-count(tail(rows), want));
        def ea-phase-text(rows) = ea-cat(list("gas ", int_to_str(ea-lifecycle-count(rows, "source")), " · water ", int_to_str(ea-lifecycle-count(rows, "live")), " · ice ", int_to_str(ea-lifecycle-count(rows, "stored")), " · absent ", int_to_str(ea-lifecycle-count(rows, "unknown"))));
        def ea-self-rows(rows) = list(
            ea-row("ear.phase", "the phase these rows sit in", ea-phase-text(rows), "live", "the ear's measured rows counted by the lifecycle word the glass sorts phases by: source is gas, live is water, stored is ice, unknown is a row whose door answered nothing. This row and ear.axes stand outside their own census — a row cannot count itself before it exists — so the glass's own phase triple reads two water higher than this line"),
            ea-num("ear.axes", "axes this stream carries", len(ea-axes()), "axes", "live", "one moment in the room, given on this many axes at once; the roster is ea-axes()"));

        // the moments themselves, newest first
        def ea-stream-rows(points, epoch, i) = if eq(len(points), 0) then list() else cons(ea-stream-row(head(points), epoch, i), ea-stream-rows(tail(points), epoch, add(i, 1)));
        def ea-stream-row(p, epoch, i) = ea-row(ea-cat(list("ear.stream.", int_to_str(i))), ea-cat(list(if eq(i, 0) then "newest" else int_to_str(i), " back")), ea-stream-text(p, epoch), "stored", "one closed line of the room, held newest first; the stream is six deep");
        def ea-stream-text(p, epoch) = ea-cat(list(ea-ago(epoch, ea-point-t(p)), "  ", nth(p, 1), "  ", ea-point-text(p), ea-stream-syms(nth(p, 4))));
        def ea-stream-syms(syms) = if eq(str_len(syms), 0) then "" else ea-cat(list("   · ", syms));
        def ea-ago(epoch, t) = if or(le(t, 0), lt(epoch, t)) then "now" else ea-ago-of(sub(epoch, t));
        def ea-ago-of(ms) = if lt(ms, 1000) then ea-cat(list(int_to_str(ms), " ms ago")) else ea-cat(list(int_to_str(div(ms, 1000)), " s ago"));

        // ── the whole point, in the order a stream is read ─────────────────
        def ea-rows(sense, live, heard, said, wanted, awake, epoch) = ea-rows-in(sense, live, heard, said, wanted, awake, epoch, ea-state(awake, live, heard));
        def ea-rows-in(sense, live, heard, said, wanted, awake, epoch, state) = ea-rows-built(sense, live, heard, said, wanted, epoch, state, ea-verse-for(ea-sense-verses(sense), state));
        def ea-rows-built(sense, live, heard, said, wanted, epoch, state, verse) = ea-rows-close(ea-rows-open(sense, live, heard, said, wanted, state, verse), ea-sense-points(sense), epoch);
        def ea-rows-open(sense, live, heard, said, wanted, state, verse) = append(ea-room-rows(sense, live, heard, 1, state, verse), append(ea-growing-rows(sense, live), append(ea-closed-rows(heard), append(ea-stage-rows(live, heard, said), append(ea-tongues-rows(said, ea-codes(said, wanted)), append(ea-meaning-rows(sense, heard), ea-verse-rows(verse)))))));
        def ea-tongues-rows(said, codes) = cons(ea-num-or-absent("ear.tongues", "tongues carrying this line", ea-tongue-said(said, codes), "tongues", "stored", "ear.spool.tongues", "the dense lane has not answered the line that stands"), ea-tongue-rows(said, codes));
        // the census is taken over everything measured — the axes AND the moments behind them —
        // and only then do the two rows about the stream itself stand, between them
        def ea-rows-close(rows, points, epoch) = ea-rows-joined(rows, ea-stream-rows(points, epoch, 0));
        // Original recognition and local model translations retain their own
        // source stamps. A lagging translation is not the new original line.
        def ea-transcript-original(frame, key, langKey, kind, lifecycle) = if eq(str_len(ea-field(frame, key)), 0) then list() else list(etr-row(kind, ea-field(frame, langKey), ea-field(frame, key), ea-int(frame, "t"), lifecycle, "original local speech recognition; timestamp is its source frame"));
        def ea-transcript-translations(said, codes) = if eq(len(codes), 0) then list() else append(ea-transcript-translation(said, head(codes)), ea-transcript-translations(said, tail(codes)));
        def ea-transcript-translation(said, code) = if or(str_eq(code, ea-field(said, "lang")), eq(str_len(ea-field(said, str_concat("t_", code))), 0)) then list() else list(etr-row(if str_eq(ea-field(said, "kind"), "saying") then "translation-growing" else "translation-closed", code, ea-field(said, str_concat("t_", code)), ea-int(said, "tend"), if str_eq(ea-field(said, "kind"), "saying") then "source" else "stored", "local model translation; source-segment end timestamp, may trail current original; quality not implied"));
        def ea-transcript-rows(live, heard, said, wanted) = append(ea-transcript-original(live, "live", "livelang", "original-growing", "source"), append(ea-transcript-original(heard, "heard", "lang", "original-closed", "stored"), ea-transcript-translations(said, ea-codes(said, wanted))));
        def ea-rows-joined(rows, stream) = append(rows, append(ea-self-rows(append(rows, stream)), stream));
        // asleep: one row saying so, and the axes still name themselves
        def ea-asleep-rows() = list(
            ea-row("ear.state", "the ear", "asleep — write .hearth/ear.wanted to wake it", "live", ea-state-note("asleep")),
            ea-num("ear.axes", "axes this stream carries", len(ea-axes()), "axes", "live", "the roster stands whether or not the mic is open; ea-axes() names it"));
    }
    0;
}
