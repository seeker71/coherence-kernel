//////////////////////////////////////////////////////////////////////
//
// ear-axes.bml — a heard line is a point, not a line.
//
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/meaning-codes.bml form/form-stdlib/rumi-glass.bml form/form-stdlib/bml/ear-transcript.bml form/form-stdlib/term-graphics.bml form/form-stdlib/counted-axis.bml
//
// The ear organ writes frames; the glass paints rows. Between them a heard
// line was one row of text, and that is the thinnest thing the body knows
// about a moment in the room. This cell gives the moment its axes: the room's
// level and which way it is moving, the ear's own state word, the line as it
// grows and the line when it closed, the tongue it was heard in and the doubt
// the pass reports, every tongue the dense lane said it in, the symbols the
// line resolves to and their node ids (the same line said in codes, and what
// that compresses), the verse the state touches, each stage's own latency, and
// the phase the ear's own rows sit in. Then the moments themselves, newest
// first, so the glass paints a stream and not a list.
//
// Three of the axes measure the LANES rather than the room, and they are here
// because every other axis reads the same whether the room is quiet or the
// lane behind it never opened its mouth. A lane born mute — a stdin that never
// answers, a model file that is not there, a compile that carried errors —
// paints an ear that is awake, level 0, silent, and entirely wrong. So the
// sensor hands over what stands (ear.lanes), the last line either lane wrote
// into its own log (ear.voice), and how many times it has had to stand one
// (ear.stands). A wound in the lane is now a row, not a silence.
//
// Cost is where a sensor lives or dies: this ear gives every 100 ms. So the
// two doors that read files -- the meaning table (mc-codes over every meaning,
// 168 ms measured) and the verse table (rg-find per state word, 8-12 ms on a
// hit, 746 ms on a miss) -- are walked ONCE at birth into ea-sense, and the
// give path is pure folding over strings already in hand. Nothing here opens
// a file, forks, or touches the GPU.
//
// The lifecycle each row carries is the phase the glass sorts it under
// (fgl-phase-index): "source" is gas -- the line still growing, uncommitted;
// "live" is water -- the room measured this instant; "stored" is ice -- what
// the spool holds and can be read again. The ear does not carry its own phase
// table; it chooses the words the glass already classifies, so ear.phase and
// the glass's own census cannot disagree.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormEarAxesAuthority {
        field EAAuthorityPath = "form/form-stdlib/ear-axes.bml";
        field EAAuthorityKind = "high-bml-interface-class-const";
    }

    class FormEarAxes {
        field EASchema = "ear-axes-v1";
        field EAOpen = "<|ear:frame|>";
        field EAClose = "<|/ear:frame|>";
        field EAStreamDepth = 6;
        field EADomain = "ear";
        field EAPlane = "organ";
        field EASource = "ear-organ";
        field EAChannel = "voice";
        ref ea-authority = FormEarAxesAuthority;
        thought ea-law = list("a-moment-is-a-point", "axes-not-one-row", "tables-once-at-birth", "lifecycle-is-the-phase-word", "absent-says-its-door", "newest-first");

        def ea-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ ea-cat(tail(parts));
        def ea-text(t) = t ?? "";

        // ── the axes this stream carries, named once ───────────────────────
        def ea-axes() = list("state", "level", "trend", "latency", "growing", "grow", "hops", "close", "stable", "gate", "phantom", "closed", "tongue", "doubt", "words", "encode", "decode", "tokens", "commit", "said", "tongues", "symbols", "nodes", "compression", "verse", "poem", "lanes", "voice", "stands", "phase", "stream");

        // ── frames: one <|ear:frame|> block is key=value lines ──────────────
        def ea-line-end(s, i) = i >= str_len(s) ? i : (Comparable) str_byte_at(s, i) == 10 ? i : ea-line-end(s, i + 1);
        def ea-field(f, key) = ea-field-at(f, key, str_find(f, byte_to_str(10) ++ key ++ "=", 0), str_len(key) + 2);
        def ea-field-at(f, key, at, skip) = at < 0 ? "" : substring(f, at + skip, ea-line-end(f, at + skip));
        def ea-has?(f, key) = str_find(f, byte_to_str(10) ++ key ++ "=", 0) < 0 ? 0 : 1;
        def ea-int(f, key) = ea-int-of(ea-field(f, key));
        def ea-int-of(v) = (Comparable) str_len(v) == 0 ? 0 : str_to_int(v);
        def ea-frames(text, from, acc) = ea-frames-at(text, from, acc, str_find(text, EAOpen(), from));
        def ea-frames-at(text, from, acc, o) = o < 0 ? reverse(acc) : ea-frames-cut(text, acc, o, str_find(text, EAClose(), o));
        def ea-frames-cut(text, acc, o, c) = c < 0 ? reverse(acc) : ea-frames(text, c + str_len(EAClose()), cons(substring(text, o, c + str_len(EAClose())), acc));
        def ea-through(text, from, last) = ea-through-at(text, from, last, str_find(text, EAClose(), from));
        def ea-through-at(text, from, last, c) = c < 0 ? last : ea-through(text, c + str_len(EAClose()), c + str_len(EAClose()));
        def ea-said?(f) = (String) ea-field(f, "kind") == "said" ? 1 : (String) ea-field(f, "kind") == "saying" ? 1 : 0;
        def ea-phantom?(f) = (String) ea-field(f, "kind") == "phantom" ? 1 : 0;
        // the mouth writes its own mark into this same spool when the body speaks (voice-say). It
        // is a note about the MOUTH and carries no live line, so letting it into the live slot
        // blanked the ear's open line every time the body opened its own.
        def ea-spoke?(f) = (String) ea-field(f, "kind") == "spoke" ? 1 : 0;
        def ea-heard-kind?(f) = (String) ea-field(f, "kind") == "heard" ? 1 : (Comparable) ea-phantom?(f) == 1 ? 1 : (Comparable) ea-spoke?(f) == 1 ? 1 : ea-said?(f);
        // live keeps the newest frame that is NOT a commit and NOT a refusal: kinds live, stable,
        // quiet, born, done. A phantom frame carries no line, so letting it into the live slot would
        // blank the open line every time the room made a sound the pass wanted to name.
        def ea-newest(frames, live, heard, said, ghost) = (Comparable) len(frames) == 0 ? list(live, heard, said, ghost) : ea-newest-one(head(frames), tail(frames), live, heard, said, ghost);
        def ea-newest-one(f, rest, live, heard, said, ghost) = ea-newest(rest, (Comparable) ea-heard-kind?(f) == 1 ? live : f, (String) ea-field(f, "kind") == "heard" ? f : heard, (Comparable) ea-said?(f) == 1 ? f : said, (Comparable) ea-phantom?(f) == 1 ? f : ghost);

        // ── words: bytes lowered, edges cleaned, so a code can be matched ───
        def ea-lower-byte(b) = (b >= 65) && (b <= 90) ? (b + 32) : b;
        def ea-lower(s) = 0 .. str_len(s) |> foldl((acc, i) => acc ++ byte_to_str(ea-lower-byte(str_byte_at(s, i))), "");
        def ea-word-byte?(b) = (b >= 97) && (b <= 122) ? 1 : (b >= 48) && (b <= 57) ? 1 : b >= 128 ? 1 : 0;
        def ea-front(s, i) = i >= str_len(s) ? i : (Comparable) ea-word-byte?(str_byte_at(s, i)) == 1 ? i : ea-front(s, i + 1);
        def ea-back(s, j) = j <= 0 ? j : (Comparable) ea-word-byte?(str_byte_at(s, j - 1)) == 1 ? j : ea-back(s, j - 1);
        def ea-clean(w) = ea-clean-cut(w, ea-front(w, 0));
        def ea-clean-cut(w, a) = a >= str_len(w) ? "" : substring(w, a, ea-back(w, str_len(w)));
        def ea-words-go(parts, acc) = (Comparable) len(parts) == 0 ? reverse(acc) : ea-words-go(tail(parts), ea-words-keep(ea-clean(head(parts)), acc));
        def ea-words-keep(w, acc) = (Comparable) str_len(w) == 0 ? acc : cons(w, acc);
        def ea-words(line) = (Comparable) str_len(line) == 0 ? list() : ea-words-go(split-on(ea-lower(line), " "), list());
        def ea-word-count(line) = len(ea-words(line));
        def ea-member?(xs, x) = (Comparable) len(xs) == 0 ? 0 : (String) head(xs) == x ? 1 : ea-member?(tail(xs), x);

        // ── the meaning table: every meaning's codes, walked once at birth ──
        def ea-meaning-row(sym) = list(sym, mc-nl(sym), mc-anchor(sym), mc-codes(sym));
        def ea-meaning-sym(row) = head(row);
        def ea-meaning-node(row) = row[2];
        def ea-meaning-codes(row) = row[3];
        def ea-meaning-table-go(syms, acc) = (Comparable) len(syms) == 0 ? reverse(acc) : ea-meaning-table-go(tail(syms), cons(ea-meaning-row(head(syms)), acc));
        def ea-meaning-table() = ea-meaning-table-go(mc-meanings(), list());
        // a code of two bytes or more: one word matched whole, a phrase matched in the line
        def ea-one-code-hit?(code, words, line) = ea-one-code-at(ea-lower(trim(code)), words, line);
        def ea-one-code-at(c, words, line) = str_len(c) < 2 ? 0 : str_find(c, " ", 0) >= 0 ? ea-phrase-hit?(line, c) : ea-member?(words, c);
        def ea-phrase-hit?(line, c) = str_find(line, c, 0) < 0 ? 0 : 1;
        def ea-code-hit?(codes, words, line) = (Comparable) len(codes) == 0 ? 0 : (Comparable) ea-one-code-hit?(head(codes)[1], words, line) == 1 ? 1 : ea-code-hit?(tail(codes), words, line);
        def ea-symbols-go(table, words, line, acc) = (Comparable) len(table) == 0 ? reverse(acc) : ea-symbols-go(tail(table), words, line, (Comparable) ea-code-hit?(ea-meaning-codes(head(table)), words, line) == 1 ? cons(head(table), acc) : acc);
        def ea-symbols(table, line) = (Comparable) str_len(line) == 0 ? list() : ea-symbols-go(table, ea-words(line), ea-lower(line), list());
        def ea-join(xs, sep) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? head(xs) : ea-cat(list(head(xs), sep, ea-join(tail(xs), sep)));
        def ea-sym-names(hits) = (Comparable) len(hits) == 0 ? list() : cons(ea-meaning-sym(head(hits)), ea-sym-names(tail(hits)));
        def ea-node-names(hits) = (Comparable) len(hits) == 0 ? list() : cons(ea-meaning-node(head(hits)), ea-node-names(tail(hits)));
        def ea-sym-line(hits) = ea-join(ea-sym-names(hits), " ");
        def ea-node-line(hits) = ea-join(ea-node-names(hits), " ");
        // what saying the line in codes would cost against the words themselves
        def ea-compression(line, hits) = (Comparable) len(hits) == 0 ? 0 : (str_len(line) - str_len(ea-sym-line(hits)));

        // ── the ear's own state word, and the verse it touches ─────────────
        def ea-states() = list("asleep", "deaf", "silent", "speaking", "heard");
        def ea-state-word(state) = match (String) state { "asleep" => "resting", "deaf" => "blind", "silent" => "silent", "speaking" => "speaking", _ => "grown" };
        def ea-state(awake, live, heard) = ea-state-of(awake, ea-field(live, "kind"), ea-int(live, "db"), ea-field(live, "live"), ea-field(heard, "heard"), ea-int(heard, "t"), ea-int(live, "t"));
        def ea-state-of(awake, kind, db, growing, closed, heardT, liveT) {
            (Comparable) awake == 0 ? "asleep"
            : (String) kind == "done" ? "deaf"
            : db <= -120 ? "deaf"
            : str_len(growing) > 0 ? "speaking"
            : (str_len(closed) > 0) && (heardT >= liveT) ? "heard"
            : "silent";
        }
        def ea-state-note(state) = (String) state == "asleep" ? "the marker is absent; the mic is closed and the lanes are down" : (String) state == "deaf" ? "the ear is wanted but the mic gives nothing: the lane is born or ended, or the host grant is not open" : (String) state == "silent" ? "the room is under the lane's speech floor; no line is open" : (String) state == "speaking" ? "a line is open and growing pass by pass" : "a line closed at a pause or a full window";
        def ea-verse-row(state) = ea-verse-found(state, rg-find(ea-state-word(state)));
        def ea-verse-found(state, found) = ea-verse-hit(state, found[1], head(head(found)));
        def ea-verse-hit(state, h, word) = (Comparable) len(h) == 0 ? list(state, word, "", "", 0) : list(state, word, rg-hit-line1(h), rg-hit-line2(h), ea-poem-id(h));
        def ea-poem-id(h) = ea-poem-int(rg-poem-id(h));
        def ea-poem-int(n) = (Comparable) sv-digits?(n, 0) == 1 ? ea-int-of(n) : 0;
        def ea-verse-table-go(states, acc) = (Comparable) len(states) == 0 ? reverse(acc) : ea-verse-table-go(tail(states), cons(ea-verse-row(head(states)), acc));
        def ea-verse-table() = ea-verse-table-go(ea-states(), list());
        def ea-verse-for(table, state) = (Comparable) len(table) == 0 ? list(state, "", "", "", 0) : (String) head(head(table)) == state ? head(table) : ea-verse-for(tail(table), state);
        def ea-verse-word(v) = v[1];
        def ea-verse-text(v) = (Comparable) str_len(v[2]) == 0 ? "" : ea-cat(list(v[2], "  ‖  ", v[3]));
        def ea-verse-poem(v) = v[4];

        // ── the room's level, and which way it is moving ───────────────────
        def ea-trend(db, prev) = (Comparable) len(prev) == 0 ? "first reading" : ea-trend-of(db - head(prev));
        def ea-trend-of(d) = d >= 3 ? ea-cat(list("rising +", int_to_str(d), " dB")) : d <= -3 ? ea-cat(list("falling ", int_to_str(d), " dB")) : (Comparable) d == 0 ? "steady" : ea-cat(list("steady (", int_to_str(d), " dB)"));

        // ── the sense the sensor carries between gives ─────────────────────
        // list(schema, meanings, verses, prevDb, prevGrowing, points, hops)
        def ea-sense(meanings, verses, prevDb, prevGrowing, points, hops) = list(EASchema(), meanings, verses, prevDb, prevGrowing, points, hops);
        def ea-sense-born() = ea-sense(ea-meaning-table(), ea-verse-table(), list(), "", list(), 0);
        def ea-sense-meanings(s) = s[1];
        def ea-sense-verses(s) = s[2];
        def ea-sense-prev-db(s) = s[3];
        def ea-sense-prev-growing(s) = s[4];
        def ea-sense-points(s) = s[5];
        def ea-sense-hops(s) = s[6];
        // a point of the stream: list(t, lang, text, commitMs, symbols)
        def ea-point(t, lang, text, ms, syms) = list(t, lang, text, ms, syms);
        def ea-point-t(p) = head(p);
        def ea-point-text(p) = p[2];
        def ea-take(xs, n) = (n <= 0) || ((Comparable) len(xs) == 0) ? list() : cons(head(xs), ea-take(tail(xs), n - 1));
        def ea-push(points, p) = (len(points) > 0) && ((String) ea-point-text(head(points)) == ea-point-text(p)) ? points : ea-take(cons(p, points), EAStreamDepth());
        def ea-points-next(sense, heard, closed) = (Comparable) str_len(closed) == 0 ? ea-sense-points(sense) : ea-push(ea-sense-points(sense), ea-point(ea-int(heard, "t"), ea-field(heard, "lang"), closed, ea-int(heard, "heardms"), ea-sym-line(ea-symbols(ea-sense-meanings(sense), closed))));
        def ea-hops-next(hops, growing, prevGrowing) = (Comparable) str_len(growing) == 0 ? 0 : (String) growing == prevGrowing ? hops : (hops + 1);
        def ea-sense-step(sense, live, heard, said, awake) = ea-sense-stepped(sense, ea-int(live, "db"), ea-field(live, "live"), ea-field(heard, "heard"), heard);
        def ea-sense-stepped(sense, db, growing, closed, heard) = ea-sense(ea-sense-meanings(sense), ea-sense-verses(sense), list(db), growing, ea-points-next(sense, heard, closed), ea-hops-next(ea-sense-hops(sense), growing, ea-sense-prev-growing(sense)));

        // ── rows: the moment's axes, then the moments ──────────────────────
        def ea-row(id, label, value, lifecycle, note) = fgo-text(EADomain(), id, label, value, EAPlane(), "physical-live", EASource(), lifecycle, EAChannel(), note);
        def ea-row-or-absent(id, label, value, lifecycle, door, note) = (Comparable) fgo-blank-text-at?(value, 0) == 1 ? fgo-unavailable(EADomain(), id, label, "text", EAPlane(), door, EAChannel(), note) : ea-row(id, label, value, lifecycle, note);
        def ea-num(id, label, value, unit, lifecycle, note) = fgo-int(EADomain(), id, label, value, unit, 0, EAPlane(), "physical-live", EASource(), lifecycle, EAChannel(), note);
        def ea-num-or-absent(id, label, value, unit, lifecycle, door, note) = value <= 0 ? fgo-unavailable(EADomain(), id, label, unit, EAPlane(), door, EAChannel(), note) : ea-num(id, label, value, unit, lifecycle, note);
        // A written field stays a measure at zero. Absence is only a missing field.
        def ea-counted(has, value, id, label, unit, lifecycle, door, absentNote, zeroNote) = has == 0 ? fgo-unavailable(EADomain(), id, label, unit, EAPlane(), door, EAChannel(), absentNote) : ea-num(id, label, value, unit, lifecycle, value == 0 ? zeroNote : "the field was written");
        def ea-counted-field(frame, key, id, label, unit, lifecycle, door, absentNote, zeroNote) = ea-counted(ea-has?(frame, key), ea-int(frame, key), id, label, unit, lifecycle, door, absentNote, zeroNote);

        // the room, this instant
        def ea-room-rows(sense, live, heard, awake, state, verse) = list(
            ea-row("ear.state", "the ear", ea-cat(list(state, " — ", ea-verse-word(verse))), "live", ea-state-note(state)),
            ea-num("ear.level", "the room's level", ea-int(live, "db"), "dbfs", "live", "the mic organ's own measure over the last three chunks"),
            ea-row("ear.level.trend", "the room, moving", ea-trend(ea-int(live, "db"), ea-sense-prev-db(sense)), "live", "this level against the level of the give before it; three dB is the step that counts as movement"),
            ea-num("ear.latency", "last sample to this row", ea-int(live, "livems"), "ms", "live", "the ear's own hop: the newest sample through the whisper pass into this row"));

        // ── the lanes behind the point, and their own voices ───────────────
        // Every axis above measures what the lanes WROTE. These three measure
        // the lanes themselves, because a lane born into a stdin that never
        // answers writes nothing and looks exactly like a silent room. The
        // sensor spawns each lane with its own log, and hands what it read
        // back here: what stands, what it last said, how often it was stood.
        // list(livePid, tonguePid, ageMs, stands, voice)
        def ea-lanes(livePid, tonguePid, ageMs, stands, voice) = list(livePid, tonguePid, ageMs, stands, voice);
        def ea-lanes-none() = ea-lanes(0, 0, 0, 0, "");
        def ea-lane-live-pid(l) = head(l);
        def ea-lane-tongue-pid(l) = l[1];
        def ea-lane-age(l) = l[2];
        def ea-lane-stands(l) = l[3];
        def ea-lane-voice(l) = l[4];
        def ea-age-text(ms) = ms < 1000 ? ea-cat(list(int_to_str(ms), " ms")) : ea-cat(list(int_to_str(ms / 1000), " s"));
        def ea-pid-text(p) = p <= 0 ? "gone" : "#" ++ int_to_str(p);
        def ea-lanes-text(l) = (ea-lane-live-pid(l) <= 0) && (ea-lane-tongue-pid(l) <= 0) ? "" : ea-cat(list("live ", ea-pid-text(ea-lane-live-pid(l)), " · tongue ", ea-pid-text(ea-lane-tongue-pid(l)), " · standing ", ea-age-text(ea-lane-age(l))));
        def ea-lane-rows(l) = list(
            ea-row-or-absent("ear.lanes", "the lanes behind this", ea-lanes-text(l), "live", "ear.lane.pid", "no lane stands: the ear is asleep, or the sensor has not stood one yet"),
            ea-row-or-absent("ear.voice", "what a lane last said", ea-lane-voice(l), "stored", "ear.lane.log", "neither lane has said a word since it was stood; each speaks its own stdout and stderr into .hearth/ear.lane.<name>.log, and this row is that log's last line"),
            ea-num("ear.stands", "times a lane was stood", ea-lane-stands(l), "stands", "live", "how often this sensor has had to stand a lane in its own life; one is a healthy standing, a number that climbs is a lane dying and being re-stood, and ear.voice says what it said on the way out"));

        // the line, growing
        def ea-growing-rows(sense, live, wanted) = list(
            ea-row-or-absent("ear.live", "the line as it grows", ea-live-text(live, wanted), "source", "ear.spool.live", "no line is open: the room is under the speech floor, or the pass has not answered yet"),
            ea-num("ear.grow", "the line's growth", ea-grow(ea-field(live, "live"), ea-sense-prev-growing(sense)), "bytes", "source", "bytes the open line gained since the give before it; a restart reads zero"),
            ea-num("ear.hops", "passes on this line", ea-sense-hops(sense), "passes", "source", "whisper passes since this line opened; the line is re-read whole each hop, so this is also how many times these words were heard"));
        def ea-admit-tongue(code, wanted) = str_len(code) == 0 ? "" : ea-member?(split-on(wanted, " "), code) == 1 ? code : "";
        def ea-live-text(live, wanted) = ea-with-lang(ea-admit-tongue(ea-field(live, "livelang"), wanted), ea-field(live, "live"));
        def ea-with-lang(lang, text) = (Comparable) str_len(text) == 0 ? "" : (Comparable) str_len(lang) == 0 ? text : ea-cat(list(lang, "  ", text));
        def ea-grow(growing, prevGrowing) = str_len(growing) <= str_len(prevGrowing) ? 0 : (str_len(growing) - str_len(prevGrowing));

        // ── what closed the line, how settled the open one is, what the room set the gate at ──
        // These four are the ear's own latency instruments. ear.close names which of the three
        // closes ended the line and how long the words had already been final when it fired —
        // the wait a reader did not have to take. ear.gate is the one row that would have found
        // the day's wound in a single look: a gate standing at the room's own quiet can never
        // fall silent, so no pause can ever close a line. ear.phantom shows a refusal as a
        // refusal, which is the whole of a phantom being honest.
        def ea-close-rows(live, heard, ghost) = list(
            ea-row-or-absent("ear.close", "what closed the line", ea-close-text(heard), "stored", "ear.spool.why", "no line has closed yet in this ear's lifetime"),
            ea-counted-field(live, "stable", "ear.stable", "passes the words held still", "passes", "source", "ear.spool.stable", "no open line to settle", "zero means the open line just changed; a climb means the same words held"),
            ea-row-or-absent("ear.gate", "the room's floor and the gate over it", ea-gate-text(live), "live", "ear.spool.gate", "no pass has measured the room yet"),
            ea-row-or-absent("ear.phantom", "the last sound named and refused", ea-cat(list(ea-field(ghost, "tags"), ea-review-text(ghost))), "stored", "ear.spool.phantom", "nothing refused: every line the pass answered carried words somebody said"));
        def ea-close-text(heard) = ea-cat(list(ea-close-of(ea-field(heard, "why"), ea-int(heard, "settled")), ea-review-text(heard)));
        def ea-review-text(frame) = (Comparable) str_len(ea-field(frame, "review")) == 0 ? "" : ea-cat(list(" · local re-listen ", ea-field(frame, "review"), " ", tg-dur(ea-int(frame, "reviewms")), " (", ea-field(frame, "firstlp"), " → ", ea-field(frame, "reviewlp"), " milli-LP)"));
        def ea-close-of(why, settled) = (Comparable) str_len(why) == 0 ? "" : settled <= 0 ? why : ea-cat(list(why, " · the words were already final ", int_to_str(settled), " ms before it"));
        def ea-gain-text(live) = (Comparable) ea-has?(live, "gainmilli") == 0 ? "" : ea-cat(list(" · gain ", float_to_str(str_to_float(ea-field(live, "gainmilli")) / 1000.0), "x"));
        def ea-gate-text(live) = (Comparable) ea-has?(live, "gate") == 0 ? "" : ea-cat(list("quiet ", ea-field(live, "floor"), " · candidate over ", ea-field(live, "gate"), ea-gain-text(live), (Comparable) ea-has?(live, "revision") == 1 ? " · revisable" : ""));

        // the line, closed
        def ea-closed-rows(heard, wanted) = list(
            ea-row-or-absent("ear.heard", "the line when it closed", ea-with-lang(ea-admit-tongue(ea-field(heard, "lang"), wanted), ea-field(heard, "heard")), "stored", "ear.spool.heard", "no line has closed yet in this ear's lifetime"),
            ea-row-or-absent("ear.tongue", "the tongue it was heard in", ea-admit-tongue(ea-field(heard, "lang"), wanted), "stored", "ear.spool.lang", "the pass named no tongue this ear was asked to hear"),
            ea-doubt-row(heard),
            ea-counted(ea-has?(heard, "heard"), ea-word-count(ea-field(heard, "heard")), "ear.words", "words in the closed line", "words", "stored", "ear.spool.heard", "no closed line to count", "the line closed with no words"));
        // the pass's own no-speech doubt: the door is read, and what it answered stands
        def ea-doubt-row(heard) = (Comparable) ea-has?(heard, "nsp") == 0 ? fgo-unavailable(EADomain(), "ear.doubt", "the pass's own doubt", "per-mille", EAPlane(), "ear.spool.nsp", EAChannel(), "the frame carries no nsp field") : ea-doubt-value(ea-int(heard, "nsp"));
        def ea-doubt-value(nsp) = nsp > 0 ? ea-num("ear.doubt", "the pass's own doubt", nsp, "per-mille", "stored", "whisper's no-speech probability for the closed line, in parts per thousand") : fgo-probed-absent(EADomain(), "ear.doubt", "the pass's own doubt", "per-mille", EAPlane(), "ear.spool.nsp", "0", EAChannel(), "the field is present and reads zero: the pass had no doubt to report for this line");

        // each stage's own latency
        def ea-stage-rows(live, heard, said) = list(
            ea-counted-field(live, "encms", "ear.encode", "whisper encode", "ms", "live", "ear.spool.encms", "no pass in this frame to time", "the pass encoded in no measurable time"),
            ea-counted-field(live, "decms", "ear.decode", "whisper decode", "ms", "live", "ear.spool.decms", "no pass in this frame to time", "the pass decoded in no measurable time"),
            ea-counted-field(live, "ntok", "ear.tokens", "tokens in the pass", "tokens", "live", "ear.spool.ntok", "no pass in this frame to count", "the pass carried no tokens"),
            ea-counted-field(heard, "heardms", "ear.commit", "pause to closed line", "ms", "stored", "ear.spool.heardms", "no line has closed yet", "the line closed with no pause"),
            ea-counted-field(said, "saidms", "ear.said", "closed line to tongues", "ms", "stored", "ear.spool.saidms", "the dense lane has not answered this line yet", "the tongues answered with no pause"));

        // every tongue the dense lane said it in
        def ea-codes(said, wanted) = ea-codes-of(ea-field(said, "tongues"), wanted);
        def ea-codes-of(t, wanted) = str_len(t) > 0 ? split-on(t, " ") : str_len(wanted) > 0 ? split-on(wanted, " ") : list("en", "pt", "fa", "id");
        def ea-tongue-rows(said, codes) = (Comparable) len(codes) == 0 ? list() : cons(ea-tongue-row(said, head(codes)), ea-tongue-rows(said, tail(codes)));
        def ea-tongue-row(said, code) = ea-row-or-absent("ear.tongue." ++ code, ea-cat(list("said in ", code)), ea-field(said, "t_" ++ code), "stored", "ear.spool.t_" ++ code, "the dense lane has not offered this tongue for the line that stands");
        def ea-tongue-said(said, codes) = ea-tongue-count(said, codes, 0);
        def ea-tongue-count(said, codes, n) = (Comparable) len(codes) == 0 ? n : ea-tongue-count(said, tail(codes), str_len(ea-field(said, "t_" ++ head(codes))) > 0 ? (n + 1) : n);

        // the meaning: the same line said in symbols, and their content addresses
        def ea-meaning-rows(sense, heard) = ea-meaning-rows-of(ea-field(heard, "heard"), ea-symbols(ea-sense-meanings(sense), ea-field(heard, "heard")));
        def ea-meaning-rows-of(closed, hits) = list(
            ea-row-or-absent("ear.symbols", "the line in symbols", ea-sym-line(hits), "stored", "meaning-codes.mc-codes", ea-meaning-absent-note(closed)),
            ea-row-or-absent("ear.nodes", "their node ids", ea-node-line(hits), "stored", "meaning-codes.mc-anchor", ea-meaning-absent-note(closed)),
            ea-num-or-absent("ear.compression", "what codes would save", ea-compression(closed, hits), "bytes", "stored", "meaning-codes.mc-codes", "no meaning of this body stands in the closed line, so there is nothing shorter to say it with"));
        def ea-meaning-absent-note(closed) = (Comparable) str_len(closed) == 0 ? "no line has closed yet" : "the closed line carries no word this body has a meaning for; the meanings are mc-meanings(), matched whole-word against every tongue and script the locale rows carry";

        // the verse the state touches
        def ea-verse-rows(verse) = list(
            ea-row-or-absent("ear.verse", "the verse this state touches", ea-verse-text(verse), "stored", "rumi-glass.rg-find", ea-cat(list("no couplet in the store carries ", ea-verse-word(verse), ", the Persian word for this state"))),
            ea-num-or-absent("ear.verse.poem", "the poem it stands in", ea-verse-poem(verse), "poem", "stored", "rumi-glass.rg-poem-id", "no couplet was found, so no poem to name"));

        // the stream about itself: the phase its own rows sit in, and how many axes it carries
        def ea-lifecycle-count(rows, want) = (Comparable) len(rows) == 0 ? 0 : (((String) fgo-lifecycle(head(rows)) == want ? 1 : 0) + ea-lifecycle-count(tail(rows), want));
        def ea-phase-text(rows) = ea-cat(list("gas ", int_to_str(ea-lifecycle-count(rows, "source")), " · water ", int_to_str(ea-lifecycle-count(rows, "live")), " · ice ", int_to_str(ea-lifecycle-count(rows, "stored")), " · absent ", int_to_str(ea-lifecycle-count(rows, "unknown"))));
        def ea-self-rows(rows) = list(
            ea-row("ear.phase", "the phase these rows sit in", ea-phase-text(rows), "live", "the ear's measured rows counted by the lifecycle word the glass sorts phases by: source is gas, live is water, stored is ice, unknown is a row whose door answered nothing. This row and ear.axes stand outside their own census — a row cannot count itself before it exists — so the glass's own phase triple reads two water higher than this line"),
            ea-num("ear.axes", "axes this stream carries", len(ea-axes()), "axes", "live", "one moment in the room, given on this many axes at once; the roster is ea-axes()"));

        // the moments themselves, newest first
        def ea-stream-rows(points, epoch, i) = (Comparable) len(points) == 0 ? list() : cons(ea-stream-row(head(points), epoch, i), ea-stream-rows(tail(points), epoch, i + 1));
        def ea-stream-row(p, epoch, i) = ea-row(ea-cat(list("ear.stream.", int_to_str(i))), ea-cat(list((Comparable) i == 0 ? "newest" : int_to_str(i), " back")), ea-stream-text(p, epoch), "stored", "one closed line of the room, held newest first; the stream is six deep");
        def ea-stream-text(p, epoch) = ea-cat(list(ea-ago(epoch, ea-point-t(p)), "  ", p[1], "  ", ea-point-text(p), ea-stream-syms(p[4])));
        def ea-stream-syms(syms) = (Comparable) str_len(syms) == 0 ? "" : ea-cat(list("   · ", syms));
        def ea-ago(epoch, t) = (t <= 0) || (epoch < t) ? "now" : ea-age-text(epoch - t) ++ " ago";

        // ── the whole point, in the order a stream is read ─────────────────
        def ea-rows(sense, live, heard, said, wanted, awake, epoch, lanes, ghost) = ea-rows-in(sense, live, heard, said, wanted, awake, epoch, lanes, ghost, ea-state(awake, live, heard));
        def ea-rows-in(sense, live, heard, said, wanted, awake, epoch, lanes, ghost, state) = ea-rows-built(sense, live, heard, said, wanted, epoch, lanes, ghost, state, ea-verse-for(ea-sense-verses(sense), state));
        def ea-rows-built(sense, live, heard, said, wanted, epoch, lanes, ghost, state, verse) = ea-rows-close(ea-rows-open(sense, live, heard, said, wanted, lanes, ghost, state, verse), ea-sense-points(sense), epoch);
        def ea-rows-open(sense, live, heard, said, wanted, lanes, ghost, state, verse) = append(ea-room-rows(sense, live, heard, 1, state, verse), append(ea-lane-rows(lanes), append(ea-growing-rows(sense, live, wanted), append(ea-close-rows(live, heard, ghost), append(ea-closed-rows(heard, wanted), append(ea-stage-rows(live, heard, said), append(ea-tongues-rows(said, ea-codes(said, wanted)), append(ea-meaning-rows(sense, heard), ea-verse-rows(verse)))))))));
        def ea-tongues-rows(said, codes) = cons(ea-counted(ea-has?(said, "tongues"), ea-tongue-said(said, codes), "ear.tongues", "tongues carrying this line", "tongues", "stored", "ear.spool.tongues", "the dense lane has not answered the line that stands", "the lane answered and carried none of these tongues"), ea-tongue-rows(said, codes));
        // the census is taken over everything measured — the axes AND the moments behind them —
        // and only then do the two rows about the stream itself stand, between them
        def ea-rows-close(rows, points, epoch) = ea-rows-joined(rows, ea-stream-rows(points, epoch, 0));
        // Original recognition and local model translations retain their own
        // source stamps. A lagging translation is not the new original line.
        def ea-transcript-original(frame, key, langKey, kind, lifecycle) = (Comparable) str_len(ea-field(frame, key)) == 0 ? list() : list(etr-row(kind, ea-field(frame, langKey), ea-field(frame, key), ea-int(frame, "t"), lifecycle, "original local speech recognition; timestamp is its source frame"));
        def ea-transcript-translations(said, codes) = (Comparable) len(codes) == 0 ? list() : append(ea-transcript-translation(said, head(codes)), ea-transcript-translations(said, tail(codes)));
        def ea-transcript-translation(said, code) = ((String) code == ea-field(said, "lang")) || ((Comparable) str_len(ea-field(said, "t_" ++ code)) == 0) ? list() : list(etr-row((String) ea-field(said, "kind") == "saying" ? "translation-growing" : "translation-closed", code, ea-field(said, "t_" ++ code), ea-int(said, "tend"), (String) ea-field(said, "kind") == "saying" ? "source" : "stored", "local model translation; source-segment end timestamp, may trail current original; quality not implied"));
        def ea-transcript-rows(live, heard, said, wanted) = append(ea-transcript-original(live, "live", "livelang", "original-growing", "source"), append(ea-transcript-original(heard, "heard", "lang", "original-closed", "stored"), ea-transcript-translations(said, ea-codes(said, wanted))));
        def ea-rows-joined(rows, stream) = append(rows, append(ea-self-rows(append(rows, stream)), stream));
        // asleep: one row saying so, the last words a lane left behind, and the axes still name themselves
        def ea-asleep-rows(lanes) = list(
            ea-row("ear.state", "the ear", "asleep — write .hearth/ear.wanted to wake it", "live", ea-state-note("asleep")),
            ea-row-or-absent("ear.voice", "what a lane last said", ea-lane-voice(lanes), "stored", "ear.lane.log", "no lane has spoken into its log in this checkout; a lane that died while the ear was awake leaves its last words here for the sleep that follows"),
            ea-num("ear.axes", "axes this stream carries", len(ea-axes()), "axes", "live", "the roster stands whether or not the mic is open; ea-axes() names it"));
    }
    0;
}
