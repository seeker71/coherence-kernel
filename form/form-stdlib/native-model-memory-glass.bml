//////////////////////////////////////////////////////////////////////
//
// native-model-memory-glass.bml — executable semantic memory map.
//
// Authority: form-stdlib/bml/native-model-memory-glass.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/native-model-glass.bml form/form-stdlib/native-model-resident-fleet.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelMemoryGlassAuthority {
        field NMMGAuthorityPath = "form/form-stdlib/bml/native-model-memory-glass.bml";
        field NMMGAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelMemoryGlass {
        field NMMGSchema = "native-model-memory-glass-v1";
        field NMMGEvent = "FORM-MODEL-MEMORY-V1";
        field NMMGWidth = 48;

        ref nmmg-authority = NativeModelMemoryGlassAuthority;
        thought nmmg-law = list("logical-byte-width", "callable-mapped-materialized-are-separate", "quiet-cadence-snapshot", "colour-is-concept", "fill-alpha-is-read-age", "edge-alpha-is-write-age", "symbols-survive-no-colour", "frontier-is-physical-action");

        // segment: tag, owner, concept, purpose, bytes, scaled, colour,
        // rgb, symbol, read/write age, fill/edge alpha, eviction rank,
        // physical evictability, next frontier, lifecycle, use evidence,
        // carrier handle, context position, note.
        def nmmg-segment(owner, concept, purpose, bytes, scaled, colour, red, green, blue, symbol, readAge, writeAge, fillAlpha, edgeAlpha, evictionRank, evictable, frontier, loaded, prefilled, active, uses, lastUsed, handle, position, note) {
            list("native-model-memory-segment", owner, concept, purpose, bytes, scaled, colour, red, green, blue, symbol, readAge, writeAge, fillAlpha, edgeAlpha, evictionRank, evictable, frontier, loaded, prefilled, active, uses, lastUsed, handle, position, note);
        }
        def nmmg-owner(segment) = nth(segment, 1);
        def nmmg-concept(segment) = nth(segment, 2);
        def nmmg-purpose(segment) = nth(segment, 3);
        def nmmg-bytes(segment) = nth(segment, 4);
        def nmmg-scaled?(segment) = nth(segment, 5);
        def nmmg-colour(segment) = nth(segment, 6);
        def nmmg-red(segment) = nth(segment, 7);
        def nmmg-green(segment) = nth(segment, 8);
        def nmmg-blue(segment) = nth(segment, 9);
        def nmmg-symbol(segment) = nth(segment, 10);
        def nmmg-read-age(segment) = nth(segment, 11);
        def nmmg-write-age(segment) = nth(segment, 12);
        def nmmg-fill-alpha(segment) = nth(segment, 13);
        def nmmg-edge-alpha(segment) = nth(segment, 14);
        def nmmg-eviction-rank(segment) = nth(segment, 15);
        def nmmg-evictable?(segment) = nth(segment, 16);
        def nmmg-frontier?(segment) = nth(segment, 17);
        def nmmg-loaded?(segment) = nth(segment, 18);
        def nmmg-prefilled?(segment) = nth(segment, 19);
        def nmmg-active?(segment) = nth(segment, 20);
        def nmmg-uses(segment) = nth(segment, 21);
        def nmmg-last-used(segment) = nth(segment, 22);
        def nmmg-handle(segment) = nth(segment, 23);
        def nmmg-position(segment) = nth(segment, 24);
        def nmmg-note(segment) = nth(segment, 25);

        def nmmg-age(clock, lastUsed) = if lt(lastUsed, 0) then -1 else if ge(clock, lastUsed) then sub(clock, lastUsed) else 0;
        def nmmg-alpha(age) = if lt(age, 0) then 48 else if eq(age, 0) then 255 else if eq(age, 1) then 216 else if eq(age, 2) then 176 else if eq(age, 3) then 136 else 96;
        def nmmg-age-glyph(age) = if le(age, 0) then "█" else if eq(age, 1) then "▓" else if eq(age, 2) then "▒" else "░";
        def nmmg-state-symbol(active, loaded, prefilled) = if eq(active, 1) then "▶" else if eq(prefilled, 1) then "✓" else if eq(loaded, 1) then "○" else "×";
        def nmmg-eviction-symbol(segment) = if eq(nmmg-frontier?(segment), 1) then "⇣" else if eq(nmmg-evictable?(segment), 1) then "·" else "⊘";
        def nmmg-colour-symbol(colour) = if str_eq(colour, "native-green") then "🟢" else if str_eq(colour, "dense-blue") then "🔵" else if str_eq(colour, "reason-purple") then "🟣" else if str_eq(colour, "expert-orange") then "🟠" else if str_eq(colour, "state-cyan") then "🔷" else "⚪";

        def nmmg-session-model(session, id) = nmg-find(id, nmg-models(session));
        def nmmg-session-active(session, id) {
            let model = nmmg-session-model(session, id);
            if eq(len(model), 0) then 0 else nmg-active?(model);
        }
        def nmmg-row-unit(row, active) = nmrf-unit(nmrf-id(row), "inactive-model", nmrf-bytes(row), nmrf-uses(row), nmrf-last-used(row), active, nmrf-loaded?(row));
        def nmmg-model-units(rows, session) = if eq(len(rows), 0) then list() else cons(nmmg-row-unit(head(rows), nmmg-session-active(session, nmrf-id(head(rows)))), nmmg-model-units(tail(rows), session));
        def nmmg-frontier-owner(fleet, session) {
            let next = nmrf-eviction-next(nmmg-model-units(nmrf-rows(fleet), session));
            if eq(len(next), 0) then "none" else nmrf-unit-owner(next);
        }
        def nmmg-ready?(owner, frontierOwner) = if str_eq(owner, frontierOwner) then 1 else 0;
        def nmmg-row-age(fleet, row) = nmmg-age(nmrf-clock(fleet), nmrf-last-used(row));

        def nmmg-native-segment(session) {
            let model = nmmg-session-model(session, NMGNative());
            nmmg-segment(NMGNative(), "native-world", "validate Form, evaluate world state, store and route", 0, 0, "native-green", 38, 166, 91, "◆", 0, 0, 255, 255, 9, 0, 0, nmg-loaded?(model), nmg-prefilled?(model), nmg-active?(model), 0, 0, 0, 0, "running fkwu process; process allocation bytes unavailable");
        }
        def nmmg-model-segment(fleet, session, row, purpose, colour, red, green, blue, frontierOwner, position) {
            let age = nmmg-row-age(fleet, row);
            let active = nmmg-session-active(session, nmrf-id(row));
            nmmg-segment(nmrf-id(row), "model-weight-artifact", purpose, nmrf-bytes(row), 1, colour, red, green, blue, "▰", age, -1, nmmg-alpha(age), nmmg-alpha(-1), 2, 1, nmmg-ready?(nmrf-id(row), frontierOwner), nmrf-loaded?(row), nmrf-prefilled?(row), active, nmrf-uses(row), nmrf-last-used(row), nmrf-handle(row), position, "logical catalog bytes; carrier handle proves callability only; context close is the release action");
        }
        def nmmg-overlay-segment(fleet, session, row, concept, purpose, colour, red, green, blue, symbol, position, note) {
            let age = nmmg-row-age(fleet, row);
            let active = nmmg-session-active(session, nmrf-id(row));
            nmmg-segment(nmrf-id(row), concept, purpose, 0, 0, colour, red, green, blue, symbol, age, age, nmmg-alpha(age), nmmg-alpha(age), if str_eq(concept, "packed-experts") then 0 else 1, 0, 0, nmrf-loaded?(row), nmrf-prefilled?(row), active, nmrf-uses(row), nmrf-last-used(row), nmrf-handle(row), position, note);
        }
        def nmmg-headroom-segment(fleet) {
            let bytes = sub(nmrf-budget(fleet), nmrf-resident-bytes(nmrf-rows(fleet)));
            nmmg-segment("wired-budget", "headroom", "admit another model or absorb KV growth", bytes, 1, "neutral", 128, 128, 128, "□", -1, -1, 48, 48, 9, 0, 0, 1, 0, 0, 0, -1, 0, 0, "logical headroom; host pressure telemetry is not yet correlated");
        }
        def nmmg-project(fleet, session, qwenPosition, threebPosition) {
            let qwen = nmrf-find(NMGQwen(), nmrf-rows(fleet));
            let threeb = nmrf-find(NMGThreeB(), nmrf-rows(fleet));
            let frontier = nmmg-frontier-owner(fleet, session);
            list(
                nmmg-native-segment(session),
                nmmg-model-segment(fleet, session, qwen, "reasoning and thinking fallback", "reason-purple", 145, 91, 255, frontier, qwenPosition),
                nmmg-overlay-segment(fleet, session, qwen, "packed-experts", "top-10 MoE expert lookup inside packed tensors", "expert-orange", 255, 145, 45, "◇", qwenPosition, "layout derives from packed tensors; per-expert materialized bytes and split release handles are unavailable"),
                nmmg-overlay-segment(fleet, session, qwen, "kv-substate", "attention KV plus recurrent model substate", "state-cyan", 41, 196, 224, "▤◈", qwenPosition, "retained prefix state is callable; allocated and materialized bytes and partial release handle are unavailable"),
                nmmg-model-segment(fleet, session, threeb, "open natural language to Form proposal", "dense-blue", 61, 126, 255, frontier, threebPosition),
                nmmg-overlay-segment(fleet, session, threeb, "kv-substate", "dense attention KV for the NL-to-Form lane", "state-cyan", 41, 196, 224, "▤", threebPosition, "retained prefix state is callable; allocated and materialized bytes and partial release handle are unavailable"),
                nmmg-headroom-segment(fleet));
        }

        def nmmg-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), nmmg-cat(tail(parts)));
        def nmmg-repeat(glyph, count) = if le(count, 0) then "" else str_concat(glyph, nmmg-repeat(glyph, sub(count, 1)));
        def nmmg-chunks(bytes, budget) {
            if le(bytes, 0) then 0 else if le(div(mul(bytes, NMMGWidth()), budget), 0) then 1 else div(mul(bytes, NMMGWidth()), budget);
        }
        def nmmg-capacity-line(fleet) {
            let qwen = nmrf-find(NMGQwen(), nmrf-rows(fleet));
            let threeb = nmrf-find(NMGThreeB(), nmrf-rows(fleet));
            let qchunks = nmmg-chunks(nmrf-bytes(qwen), nmrf-budget(fleet));
            let tchunks = nmmg-chunks(nmrf-bytes(threeb), nmrf-budget(fleet));
            let freechunks = sub(NMMGWidth(), add(qchunks, tchunks));
            nmmg-cat(list("CAPACITY |", nmmg-repeat("🟣", qchunks), nmmg-repeat("🔵", tchunks), nmmg-repeat("▫", freechunks), "| logical_artifacts=", int_to_str(nmrf-resident-bytes(nmrf-rows(fleet))), " policy_budget=", int_to_str(nmrf-budget(fleet)), " logical_headroom=", int_to_str(sub(nmrf-budget(fleet), nmrf-resident-bytes(nmrf-rows(fleet)))), "\n"));
        }
        def nmmg-render-segment(segment) {
            nmmg-cat(list("  ", nmmg-colour-symbol(nmmg-colour(segment)), nmmg-state-symbol(nmmg-active?(segment), nmmg-loaded?(segment), nmmg-prefilled?(segment)), nmmg-eviction-symbol(segment), nmmg-symbol(segment), nmmg-age-glyph(nmmg-read-age(segment)), " owner=", nmmg-owner(segment), " concept=", nmmg-concept(segment), " use=", nmmg-purpose(segment), " bytes=", int_to_str(nmmg-bytes(segment)), " scaled=", int_to_str(nmmg-scaled?(segment)), " read_age=", int_to_str(nmmg-read-age(segment)), " write_age=", int_to_str(nmmg-write-age(segment)), " fill_a=", int_to_str(nmmg-fill-alpha(segment)), " edge_a=", int_to_str(nmmg-edge-alpha(segment)), " loaded=", int_to_str(nmmg-loaded?(segment)), " prefilled=", int_to_str(nmmg-prefilled?(segment)), " active=", int_to_str(nmmg-active?(segment)), " uses=", int_to_str(nmmg-uses(segment)), " handle=", int_to_str(nmmg-handle(segment)), " pos=", int_to_str(nmmg-position(segment)), " note=", nmmg-note(segment), "\n"));
        }
        def nmmg-render-segments(segments) = if eq(len(segments), 0) then "" else str_concat(nmmg-render-segment(head(segments)), nmmg-render-segments(tail(segments)));
        def nmmg-render(fleet, session, segments) {
            nmmg-cat(list("GLASS MEMORY schema=", NMMGSchema(), " route=", nmg-route(session), " active=", nmg-active-id(session), " clock=", int_to_str(nmrf-clock(fleet)), " pressure=unobserved\n", nmmg-capacity-line(fleet), "EXTENTS callable=carrier-handle mapped_bytes=unavailable:model.carrier-per-model-mapped-bytes materialized_bytes=unavailable:model.carrier-per-model-materialized-bytes\n", "FLOW 🟢 native Form/world → 🔵 3B NL→Form → 🟢 validate/eval → 🟣 Qwen fallback\n", "AGE fill=read edge=write █ now  ▓ recent  ▒ aging  ░ older   EVICT ⇣ next  · eligible  ⊘ pinned\n", nmmg-render-segments(segments)));
        }

        def nmmg-frame(segment, sequence) {
            intern_node_at(bp(NMMGEvent()), list(
                intern_trivial_string(nmmg-owner(segment)),
                intern_trivial_string(nmmg-concept(segment)),
                intern_trivial_string(nmmg-purpose(segment)),
                intern_trivial_int(nmmg-bytes(segment)),
                intern_trivial_int(nmmg-scaled?(segment)),
                intern_trivial_string(nmmg-colour(segment)),
                intern_trivial_int(nmmg-red(segment)),
                intern_trivial_int(nmmg-green(segment)),
                intern_trivial_int(nmmg-blue(segment)),
                intern_trivial_string(nmmg-symbol(segment)),
                intern_trivial_int(nmmg-read-age(segment)),
                intern_trivial_int(nmmg-write-age(segment)),
                intern_trivial_int(nmmg-fill-alpha(segment)),
                intern_trivial_int(nmmg-edge-alpha(segment)),
                intern_trivial_int(nmmg-eviction-rank(segment)),
                intern_trivial_int(nmmg-evictable?(segment)),
                intern_trivial_int(nmmg-frontier?(segment)),
                intern_trivial_int(nmmg-loaded?(segment)),
                intern_trivial_int(nmmg-prefilled?(segment)),
                intern_trivial_int(nmmg-active?(segment)),
                intern_trivial_int(nmmg-uses(segment)),
                intern_trivial_int(nmmg-last-used(segment)),
                intern_trivial_int(nmmg-handle(segment)),
                intern_trivial_int(nmmg-position(segment)),
                intern_trivial_string(nmmg-note(segment)),
                intern_trivial_int(sequence)),
                "form/form-stdlib/native-model-memory-glass.bml", 1, 1);
        }
        def nmmg-frames(segments, sequence) = if eq(len(segments), 0) then list() else cons(nmmg-frame(head(segments), sequence), nmmg-frames(tail(segments), sequence));
        def nmmg-snapshot(fleet, session, qwenPosition, threebPosition) {
            let segments = nmmg-project(fleet, session, qwenPosition, threebPosition);
            let frames = nmmg-frames(segments, nmg-sequence(session));
            list("native-model-memory-glass-frame", segments, frames);
        }
        def nmmg-write-quiet(fleet, session, qwenPosition, threebPosition) = nmmg-snapshot(fleet, session, qwenPosition, threebPosition);
        def nmmg-write(fleet, session, qwenPosition, threebPosition) {
            let snapshot = nmmg-snapshot(fleet, session, qwenPosition, threebPosition);
            print_str(nmmg-render(fleet, session, nth(snapshot, 1)));
            snapshot;
        }
    }
    0;
}
