//////////////////////////////////////////////////////////////////////
//
// own-word.bml — the body says something about what it perceived, and
// only what it can stand behind.
//
// preludes: form/form-stdlib/perception-rows.bml form/form-stdlib/bml/transcript-languages.bml
//
// The ear hears, the axes hold what was heard, the rows carry a day into
// weights, and the mouth speaks. All four stand. What has never stood is
// the body ORIGINATING a line: everything it has said aloud so far was a
// rendering of a line someone else said, or an answer in the grammar of
// its own axes with the facts invented. This cell is the smallest honest
// thing that is neither.
//
// THE ASK IS THE BODY'S OWN WORDS. The question is not fresh prose. It is
// `pr-day-said` and `pr-recur-said-k` — the two sentences the perception
// rows already write about a room, already banded — plus one line asking
// for a short observation. So what the generative lane is completing is
// the body's own account of its own room, and nothing a rented mind wrote
// about that room reaches the prompt, because nothing a rented mind wrote
// about that room exists.
//
// THE ANSWER IS CHECKED, NOT TRUSTED. A generative lane given true
// readings will still invent: the perception adapter, asked to name a
// moment's shape from its source stamp, answers in the right grammar with
// the wrong facts. So every claim a candidate sentence makes is pulled out
// and held against the record:
//
//   number  a digit run, or a number word — must be a quantity the record
//           actually holds. A count the lane invented is not in the set.
//   tongue  a tongue named by code or by name — must be one the room was
//           actually heard in.
//   state   one of the body's own lane-state phrases — the kind it names
//           must be a kind the frames actually carry.
//   leak    a line the ROOM said, quoted back. Always refused. The room's
//           speech is not the body's to say, and perception-rows already
//           refuses to carry it into a row; a mouth must refuse it too.
//
// EVERY CLAIM BACKED, AND AT LEAST ONE. Both halves matter. All-backed
// alone passes "The room is calm and pleasant." — a sentence with nothing
// of this room in it, true of every room, checkable nowhere. A fold over
// no claims is a green computed over nothing (corpus row 955 is the same
// shape one level down). So a sentence stands only when it makes at least
// one claim about this record and the record backs every claim it makes.
//
// WHAT THE CHECKER CANNOT SEE, IT SAYS. It reads digit runs and the number
// words zero through twenty; "roughly a hundred" passes unchecked as
// prose. It reads tongue names and codes from the one shared catalog. It
// reads the seven lane-state phrases the body itself writes. Anything else
// in a sentence is unclaimed language, and `ow-check` reports the count of
// claims it found so a caller can see how much of a sentence was actually
// held. A sentence with one claim was checked in one place, and the door
// says so rather than calling it verified.
//
// AND THEN IT IS SAID, AND HEARD. What stands goes to `vs-say`, which
// signs the frame it writes with `who=` and a `src=` naming a mouth of
// this body. That signature is the whole loop: on every real spool the
// body has ever folded, `attested` was zero and every word in the room was
// dropped at the gate. A line the body originated, spoke, and heard back
// is the first word that gate has ever let through — and it is the body's
// own.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormOwnWordAuthority {
        field OWAuthorityPath = "form/form-stdlib/own-word.bml";
        field OWAuthorityKind = "high-bml-interface-class-const";
    }

    class FormOwnWord {
        field OWSchema = "own-word-v1";
        // how many recurring shapes the ask carries; the lane's cache is 256
        // positions and the readings must leave room for an answer
        field OWPromptShapes = 2;
        field OWMaxNew = 48;
        field OWInstruct = "Say in one short sentence what stands out in these readings, using only what they say.";
        field OWCue = "Observation:";
        ref ow-authority = FormOwnWordAuthority;
        thought ow-law = list("the-ask-is-the-bodys-own-words", "every-claim-is-held-against-the-record", "one-claim-at-least-or-it-is-about-no-room", "the-rooms-speech-is-never-the-bodys-to-say", "what-the-checker-cannot-see-it-says");

        def ow-cat(parts) = pr-cat(parts);
        def ow-nl() = byte_to_str(10);
        def ow-text(t) = if nothing?(t) then "" else t;

        // ── the record: what the body actually perceived ───────────────────
        // (day tongues kinds tops nshapes lines) — day is pr-day's own fold
        def ow-add-once(xs, x) = if eq(str_len(x), 0) then xs else if eq(pr-member?(xs, x), 1) then xs else append(xs, list(x));
        def ow-tongues-go(frames, acc) = if eq(len(frames), 0) then acc else ow-tongues-go(tail(frames), ow-add-once(acc, ow-tongue-of(head(frames))));
        // a frame with no line is in no tongue: pr-tongue answers its placeholder
        def ow-tongue-of(f) = if eq(pr-words(pr-line(f)), 0) then "" else pr-tongue(f);
        def ow-tongues(frames) = ow-tongues-go(frames, list());
        def ow-kinds-go(frames, acc) = if eq(len(frames), 0) then acc else ow-kinds-go(tail(frames), ow-add-once(acc, pr-field(head(frames), "kind")));
        def ow-kinds(frames) = ow-kinds-go(frames, list());
        def ow-record(frames) = list(pr-day(frames), ow-tongues(frames), ow-kinds(frames), pr-top(pr-shapes(frames), PRTopShapes()), len(pr-shapes(frames)), pr-lines(frames));
        def ow-r-day(r) = nth(r, 0);
        def ow-r-tongues(r) = nth(r, 1);
        def ow-r-kinds(r) = nth(r, 2);
        def ow-r-tops(r) = nth(r, 3);
        def ow-r-nshapes(r) = nth(r, 4);
        def ow-r-lines(r) = nth(r, 5);

        // ── the ask: the body's own two sentences, and one line asking ─────
        // how many recurring shapes the ask carries is the one dial a caller
        // has: the same room asked about with one, two or three shapes is
        // three different asks over one record, so a fraction that survives
        // is measured over more than a single draw of a greedy lane
        def ow-ask-k(frames, k) = ow-cat(list(pr-day-said(frames), " ", pr-recur-said-k(frames, k), ow-nl(), OWInstruct(), ow-nl(), OWCue(), " "));
        def ow-ask(frames) = ow-ask-k(frames, OWPromptShapes());

        // ── the quantities the record holds ────────────────────────────────
        // Every number the ask states, and the magnitudes of the two level
        // readings: "120 dBFS below" is the same reading as "-120 dBFS" and
        // refusing one while allowing the other would be a checker with an
        // opinion about phrasing rather than about truth.
        def ow-civil-nums(ms) = if le(ms, 0) then list() else pr-civil(div(ms, 86400000));
        def ow-day-nums(a) = list(head(a), nth(a, 5), nth(a, 6), nth(a, 7), nth(a, 3), nth(a, 4), sub(0, nth(a, 3)), sub(0, nth(a, 4)), ow-span-secs(a), pr-hour(nth(a, 1)), pr-hour(nth(a, 2)));
        def ow-span-secs(a) = if le(nth(a, 1), 0) then 0 else div(sub(nth(a, 2), nth(a, 1)), 1000);
        def ow-top-counts(tops) = if eq(len(tops), 0) then list() else cons(nth(head(tops), 2), ow-top-counts(tail(tops)));
        def ow-numbers(r) = append(ow-day-nums(ow-r-day(r)), append(ow-top-counts(ow-r-tops(r)), append(list(ow-r-nshapes(r)), append(ow-civil-nums(nth(ow-r-day(r), 1)), ow-civil-nums(nth(ow-r-day(r), 2))))));
        def ow-holds?(ns, n) = if eq(len(ns), 0) then 0 else if eq(head(ns), n) then 1 else ow-holds?(tail(ns), n);

        // ── reading a sentence: words, with their boundaries ───────────────
        def ow-alpha?(b) = if and(ge(b, 97), le(b, 122)) then 1 else if and(ge(b, 65), le(b, 90)) then 1 else 0;
        def ow-digit?(b) = if and(ge(b, 48), le(b, 57)) then 1 else 0;
        def ow-lower(s, i, acc) = if ge(i, str_len(s)) then acc else ow-lower(s, add(i, 1), str_concat(acc, byte_to_str(ow-lower-byte(str_byte_at(s, i)))));
        def ow-lower-byte(b) = if and(ge(b, 65), le(b, 90)) then add(b, 32) else b;
        def ow-low(s) = ow-lower(s, 0, "");
        def ow-left-free?(s, at) = if le(at, 0) then 1 else if eq(ow-alpha?(str_byte_at(s, sub(at, 1))), 1) then 0 else 1;
        def ow-right-free?(s, at, L) = if ge(add(at, L), str_len(s)) then 1 else if eq(ow-alpha?(str_byte_at(s, add(at, L))), 1) then 0 else 1;
        def ow-bound?(s, at, L) = if eq(ow-left-free?(s, at), 0) then 0 else ow-right-free?(s, at, L);
        def ow-find-word(s, w, from) = if ge(from, str_len(s)) then sub(0, 1) else ow-find-word-at(s, w, str_find(s, w, from));
        def ow-find-word-at(s, w, at) = if lt(at, 0) then sub(0, 1) else if eq(ow-bound?(s, at, str_len(w)), 1) then at else ow-find-word(s, w, add(at, 1));
        def ow-word?(s, w) = if lt(ow-find-word(s, w, 0), 0) then 0 else 1;
        def ow-has?(s, w) = if lt(str_find(s, w, 0), 0) then 0 else 1;

        // ── a claim: (kind value surface) ──────────────────────────────────
        def ow-claim(kind, value, surface) = list(kind, value, surface);
        def ow-c-kind(c) = nth(c, 0);
        def ow-c-value(c) = nth(c, 1);
        def ow-c-surface(c) = nth(c, 2);

        // numbers written as digits; a run preceded by a hyphen is negative
        def ow-num-end(s, i) = if ge(i, str_len(s)) then i else if eq(ow-digit?(str_byte_at(s, i)), 1) then ow-num-end(s, add(i, 1)) else i;
        def ow-signed(s, i, e) = if eq(ow-minus?(s, i), 1) then sub(0, str_to_int(substring(s, i, e))) else str_to_int(substring(s, i, e));
        def ow-minus?(s, i) = if le(i, 0) then 0 else if eq(str_byte_at(s, sub(i, 1)), 45) then 1 else 0;
        def ow-digit-claims-go(s, i, acc) {
            if ge(i, str_len(s)) then reverse(acc)
            else if eq(ow-digit?(str_byte_at(s, i)), 0) then ow-digit-claims-go(s, add(i, 1), acc)
            else ow-digit-claims-at(s, i, acc, ow-num-end(s, i));
        }
        def ow-digit-claims-at(s, i, acc, e) = ow-digit-claims-go(s, e, cons(ow-claim("number", ow-signed(s, i, e), substring(s, if eq(ow-minus?(s, i), 1) then sub(i, 1) else i, e)), acc));
        def ow-digit-claims(s) = ow-digit-claims-go(s, 0, list());

        // numbers written as words: the ones a short sentence about counts uses
        def ow-numwords-1() = list(list("zero", 0), list("one", 1), list("two", 2), list("three", 3), list("four", 4), list("five", 5), list("six", 6), list("seven", 7));
        def ow-numwords-2() = list(list("eight", 8), list("nine", 9), list("ten", 10), list("eleven", 11), list("twelve", 12), list("thirteen", 13), list("fourteen", 14), list("fifteen", 15));
        def ow-numwords-3() = list(list("sixteen", 16), list("seventeen", 17), list("eighteen", 18), list("nineteen", 19), list("twenty", 20));
        def ow-numwords() = append(ow-numwords-1(), append(ow-numwords-2(), ow-numwords-3()));
        def ow-word-claims-go(low, rows, acc) {
            if eq(len(rows), 0) then reverse(acc)
            else if eq(ow-word?(low, head(head(rows))), 0) then ow-word-claims-go(low, tail(rows), acc)
            else ow-word-claims-go(low, tail(rows), cons(ow-claim("number", nth(head(rows), 1), head(head(rows))), acc));
        }
        def ow-word-claims(low) = ow-word-claims-go(low, ow-numwords(), list());

        // tongues, by their name or by their code
        def ow-tongue-claims-go(low, rows, acc) {
            if eq(len(rows), 0) then reverse(acc)
            else if eq(ow-tongue-named?(low, head(rows)), 0) then ow-tongue-claims-go(low, tail(rows), acc)
            else ow-tongue-claims-go(low, tail(rows), cons(ow-claim("tongue", 0, head(head(rows))), acc));
        }
        // A tongue is claimed by its NAME, or by its code inside the body's own
        // shape notation. Never by the bare code: `it`, `he`, `hi`, `id` and
        // `no` are Italian, Hebrew, Hindi and Indonesian AND ordinary English
        // words, and a checker that refuses "carried out of it" because Italian
        // was not heard is a checker with an opinion about phrasing rather than
        // about truth. Witnessed on the first real ask this cell ever made.
        def ow-tongue-named?(low, row) = if eq(ow-word?(low, ow-low(nth(row, 1))), 1) then 1 else ow-has?(low, ow-cat(list("|", head(row), "|")));
        def ow-tongue-claims(low) = ow-tongue-claims-go(low, tln-rows(), list());

        // the body's own lane-state phrases, each standing for a frame kind
        def ow-states() = list(list("born", "just opened"), list("done", "ended"), list("quiet", "under the speech floor"), list("live", "holding a line that is still growing"), list("heard", "holding a line that closed"), list("saying", "rendering the line into its tongues"), list("said", "settled on its rendering"));
        def ow-state-claims-go(low, rows, acc) {
            if eq(len(rows), 0) then reverse(acc)
            else if eq(ow-has?(low, nth(head(rows), 1)), 0) then ow-state-claims-go(low, tail(rows), acc)
            else ow-state-claims-go(low, tail(rows), cons(ow-claim("state", 0, head(head(rows))), acc));
        }
        def ow-state-claims(low) = ow-state-claims-go(low, ow-states(), list());

        // the room's own lines, quoted back — never the body's to say
        def ow-leak-claims-go(text, lines, acc) {
            if eq(len(lines), 0) then reverse(acc)
            else if eq(ow-has?(text, head(lines)), 0) then ow-leak-claims-go(text, tail(lines), acc)
            else ow-leak-claims-go(text, tail(lines), cons(ow-claim("leak", 0, head(lines)), acc));
        }
        def ow-leak-claims(text, r) = ow-leak-claims-go(text, ow-r-lines(r), list());

        def ow-claims(r, text) = ow-claims-of(r, text, ow-low(text));
        def ow-claims-of(r, text, low) = append(ow-digit-claims(text), append(ow-word-claims(low), append(ow-tongue-claims(low), append(ow-state-claims(low), ow-leak-claims(text, r)))));

        // ── does the record back this claim? ───────────────────────────────
        def ow-backs?(r, c) {
            if str_eq(ow-c-kind(c), "number") then ow-holds?(ow-numbers(r), ow-c-value(c))
            else if str_eq(ow-c-kind(c), "tongue") then pr-member?(ow-r-tongues(r), ow-c-surface(c))
            else if str_eq(ow-c-kind(c), "state") then pr-member?(ow-r-kinds(r), ow-c-surface(c))
            else 0;
        }

        // ── the tally: (claims backed refused) ─────────────────────────────
        def ow-tally-go(r, cs, n, b) = if eq(len(cs), 0) then list(n, b, sub(n, b)) else ow-tally-go(r, tail(cs), add(n, 1), add(b, ow-backs?(r, head(cs))));
        def ow-check(r, text) = ow-tally-go(r, ow-claims(r, text), 0, 0);
        def ow-n-claims(t) = nth(t, 0);
        def ow-n-backed(t) = nth(t, 1);
        def ow-n-refused(t) = nth(t, 2);

        // A sentence stands when the record backs every claim it makes AND it
        // makes at least one. Without the second half a sentence about no room
        // at all passes, and a fold over no claims is a green over nothing.
        def ow-stands-of(t) = if eq(ow-n-claims(t), 0) then 0 else if eq(ow-n-refused(t), 0) then 1 else 0;
        def ow-stands?(r, text) = if eq(str_len(trim(text)), 0) then 0 else ow-stands-of(ow-check(r, text));

        // why a sentence did not stand, in the body's own words
        def ow-why(r, text) = ow-why-of(ow-check(r, text), ow-first-refused(r, ow-claims(r, text)));
        def ow-why-of(t, bad) {
            if eq(ow-n-claims(t), 0) then "it claims nothing of this room, so there is nothing in it this body perceived"
            else if eq(ow-n-refused(t), 0) then ow-cat(list("it stands: ", int_to_str(ow-n-backed(t)), " of ", int_to_str(ow-n-claims(t)), " claims held by the record"))
            else ow-cat(list("refused at ", ow-c-kind(bad), " ", ow-c-surface(bad), ": the record does not hold it (", int_to_str(ow-n-backed(t)), " of ", int_to_str(ow-n-claims(t)), " claims held)"));
        }
        def ow-first-refused(r, cs) = if eq(len(cs), 0) then ow-claim("none", 0, "") else if eq(ow-backs?(r, head(cs)), 0) then head(cs) else ow-first-refused(r, tail(cs));

        // ── the candidate, cut to one sentence ─────────────────────────────
        // A completion runs on. What the body offers is the first sentence,
        // and only if the lane finished it: a sentence cut at the caller's
        // token cap is the cap talking, not the body.
        def ow-cut-at(s, stop) = ow-cut-of(s, str_find(s, stop, 0), str_len(stop));
        def ow-cut-of(s, at, L) = if lt(at, 0) then s else substring(s, 0, add(at, L));
        def ow-min2(a, b) = if lt(a, 0) then b else if lt(b, 0) then a else if lt(a, b) then a else b;
        def ow-end-mark?(b) = if eq(b, 46) then 1 else if eq(b, 33) then 1 else if eq(b, 63) then 1 else 0;
        def ow-stop-at(s) = ow-min2(ow-min2(str_find(s, ".", 0), str_find(s, "!", 0)), str_find(s, "?", 0));
        def ow-first-sentence(s) = trim(ow-cut-of(trim(ow-cut-at(s, ow-nl())), ow-stop-at(trim(ow-cut-at(s, ow-nl()))), 1));
        def ow-whole?(s) = if eq(str_len(trim(s)), 0) then 0 else ow-end-mark?(str_byte_at(trim(s), sub(str_len(trim(s)), 1)));
        def ow-candidate(raw) = ow-candidate-of(ow-first-sentence(ow-text(raw)));
        def ow-candidate-of(s) = if eq(ow-whole?(s), 0) then "" else s;
    }
    0;
}
