//////////////////////////////////////////////////////////////////////
//
// qwen4exp-flash-next-acceptance.bml — executable acceptance contract.
//
// Authority: form-stdlib/bml/qwen4exp-flash-next-acceptance.bml
// The comparator is inclusive: exactly 90% is a pass.  llama.cpp may
// produce the oracle measurement, but it may never inhabit this runtime.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class Qwen4ExpFlashNextAcceptanceAuthority {
        field Q4AcceptanceAuthorityPath = "form/form-stdlib/bml/qwen4exp-flash-next-acceptance.bml";
        field Q4AcceptanceAuthorityKind = "high-bml-interface-class-const";
    }

    class Qwen4ExpFlashNextAcceptance {
        field Q4AcceptancePercent = 90;
        field Q4LlamaDecodeTokpsX1000 = 26580;
        field Q4LlamaPrefillTokpsX1000 = 318830;
        field Q4DecodeFloorTokpsX1000 = 23922;
        field Q4PrefillFloorTokpsX1000 = 286947;
        field Q4DecodeSampleTokens = 64;
        field Q4PrefillSampleTokens = 5632;
        field Q4FormDecodeTokpsX1000 = 12188;
        field Q4FormPrefillTokpsX1000 = 12340;

        ref q4a-authority = Qwen4ExpFlashNextAcceptanceAuthority;
        thought q4a-pattern = list("same-host", "same-model", "llama-oracle-only", "form-native-runtime", "inclusive-90-percent");

        def q4a-floor(rate) = div(mul(rate, Q4AcceptancePercent()), 100);
        def q4a-decode-accepted(tokps) = if ge(tokps, Q4DecodeFloorTokpsX1000()) then 1 else 0;
        def q4a-prefill-accepted(tokps) = if ge(tokps, Q4PrefillFloorTokpsX1000()) then 1 else 0;
        def q4a-runtime-accepted(backend, dependency) = if str_eq(backend, "form-native-metal-jit") then if str_eq(dependency, "none") then 1 else 0 else 0;
        def q4a-all-accepted(decodeTokps, prefillTokps, backend, dependency) = if q4a-decode-accepted(decodeTokps) then if q4a-prefill-accepted(prefillTokps) then q4a-runtime-accepted(backend, dependency) else 0 else 0;
        def q4a-current-accepted() = q4a-all-accepted(Q4FormDecodeTokpsX1000(), Q4FormPrefillTokpsX1000(), "form-native-metal-jit", "none");

        def q4a-bit(ok, bit) = if ok then bit else 0;
        def q4a-check() {
            let c0 = q4a-bit(eq(q4a-floor(Q4LlamaDecodeTokpsX1000()), Q4DecodeFloorTokpsX1000()), 1);
            let c1 = q4a-bit(eq(q4a-floor(Q4LlamaPrefillTokpsX1000()), Q4PrefillFloorTokpsX1000()), 2);
            let c2 = q4a-bit(if eq(q4a-decode-accepted(sub(Q4DecodeFloorTokpsX1000(), 1)), 0) then q4a-decode-accepted(Q4DecodeFloorTokpsX1000()) else 0, 4);
            let c3 = q4a-bit(if eq(q4a-prefill-accepted(sub(Q4PrefillFloorTokpsX1000(), 1)), 0) then q4a-prefill-accepted(Q4PrefillFloorTokpsX1000()) else 0, 8);
            let c4 = q4a-bit(if eq(q4a-runtime-accepted("form-native-metal-jit", "none"), 1) then if eq(q4a-runtime-accepted("llama.cpp", "llama-server"), 0) then if eq(q4a-runtime-accepted("form-native-metal-jit", "llama.cpp"), 0) then 1 else 0 else 0 else 0, 16);
            let c5 = q4a-bit(q4a-all-accepted(Q4DecodeFloorTokpsX1000(), Q4PrefillFloorTokpsX1000(), "form-native-metal-jit", "none"), 32);
            let c6 = q4a-bit(if eq(q4a-decode-accepted(Q4FormDecodeTokpsX1000()), 0) then if eq(q4a-prefill-accepted(Q4FormPrefillTokpsX1000()), 0) then eq(q4a-current-accepted(), 0) else 0 else 0, 64);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, c6))))));
        }
    }
    0;
}
