; native-model-session-grounding-native-reverse-cursor.fk -- one selected
; session's visible tail cursor, stopping at its newest completed pair.
; preludes: form-stdlib/native-model-session-grounding-native-reverse-line.fk form-stdlib/native-model-session-grounding-native-reverse-event.fk

(do
    (defn nmsgn-scan-session-reverse-loop
        (path cursor mode completion session-address started rows)
        (do
            (let line-end (nmsgn-trim-reverse-end path cursor))
            (if (le line-end 0) (nmsgn-empty-pairs)
                (do
                    (let reading
                        (nmsgn-pair-row-frame session-address "line-read"
                            rows line-end line-end
                            (add 50000 (mul rows 3)) started 12))
                    (let line-row
                        (nmsgn-read-previous-line path line-end session-address
                            rows started))
                    (let line (nmsgn-reverse-line-text line-row))
                    (let line-start (nmsgn-reverse-line-start line-row))
                    (let decoding
                        (nmsgn-pair-row-frame session-address "event-decode"
                            rows line-start (str_len line)
                            (add 50001 (mul rows 3)) started 21))
                    (let step (nmsgn-reverse-event-step mode completion line))
                    (let advancing
                        (nmsgn-pair-row-frame session-address "cursor-advance"
                            (add rows 1) line-start
                            (nmsgn-reverse-event-mode step)
                            (add 50002 (mul rows 3)) started 26))
                    (if (eq (nmsgn-reverse-event-found step) 1)
                        (nmsgn-pairs "" "" 1 0
                            (nmsgn-reverse-event-when step)
                            (nmsgn-reverse-event-query step) "" (list)
                            (nmsgn-reverse-event-completion step))
                        (nmsgn-scan-session-reverse-loop path line-start
                            (nmsgn-reverse-event-mode step)
                            (nmsgn-reverse-event-completion step)
                            session-address started (add rows 1)))))))
    0)
