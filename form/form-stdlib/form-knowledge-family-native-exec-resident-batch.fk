; form-knowledge-family-native-exec-resident-batch.fk -- one-residence
; current-family native execution scheduler and evidence ledger.
;
; The canonical family projection is `fkpfm-family-ids`, read fresh in its live
; census order. One batch schedule binds every current family to its exact
; current source, held-out challenge, native input, Metal recipe-exec bytes,
; ordinal, and a distinct run identity.  No row is inferred from another row.
;
; A capture retains the model's actual raw bytes, scannerless preparation,
; native result, exact typed frex bytes injected back to the resident context,
; exact post-observation acknowledgement, residence identity, and physical
; carrier-release signal.  Finalization happens only after the one context is
; released, so every retained v2 check/evidence/receipt carries the observed
; batch release rather than a promise made while the context is still open.
;
; This cell is pure.  It never opens a model or carrier.  The dormant live
; driver owns those effects and calls this ledger only after physical release.
; Nothing, failure, timeout, present integer 0, and present integer 1 have
; separate signal names.
; No remote call, operations table, flattening, or C seed is present here.
;
; preludes: form-stdlib/form-knowledge-family-native-exec-teach-check.fk
; Proven by: form-stdlib/tests/form-knowledge-family-native-exec-resident-batch-band.fk

(do
    (defn fkfnb-families () (fkpfm-family-ids))
    (defn fkfnb-family-count () (len (fkfnb-families)))
    (defn fkfnb-string-in? (value values)
        (if (nil? values) 0
            (if (str_eq value (head values)) 1
                (fkfnb-string-in? value (tail values)))))
    (defn fkfnb-all? (values)
        (if (nil? values) 1
            (if (head values) (fkfnb-all? (tail values)) 0)))

    ; ---- canonical schedule ---------------------------------------
    ; schedule row = tag batch ordinal family binding teach teach-sha run-id
    (defn fkfnb-run-id (batch-id ordinal family binding)
        (nmfe-sha256 (nmfe-fields (list
            "family-native-resident-run-v1" batch-id (int_to_str ordinal)
            family (fkfne-binding-source-sha binding)
            (fkfne-binding-challenge-sha binding)
            (fkfne-binding-sha binding)))))
    (defn fkfnb-schedule-row-record
        (batch-id ordinal family binding teach teach-sha run-id)
        (list "family-native-resident-schedule-v1" batch-id ordinal family
              binding teach teach-sha run-id))
    (defn fkfnb-schedule-row (batch-id ordinal family)
        (do
            (let binding (fkfne-binding-for-family family "metal"))
            (let teach (fkfne-teach-frame binding))
            (fkfnb-schedule-row-record batch-id ordinal family binding teach
                (nmfe-sha256 teach)
                (fkfnb-run-id batch-id ordinal family binding))))
    (defn fkfnb-schedule-batch-id (r) (nth r 1))
    (defn fkfnb-schedule-ordinal (r) (nth r 2))
    (defn fkfnb-schedule-family (r) (nth r 3))
    (defn fkfnb-schedule-binding (r) (nth r 4))
    (defn fkfnb-schedule-teach (r) (nth r 5))
    (defn fkfnb-schedule-teach-sha (r) (nth r 6))
    (defn fkfnb-schedule-run-id (r) (nth r 7))
    (defn fkfnb-family-at (families ordinal)
        (if (or (le ordinal 0) (gt ordinal (len families))) (nothing)
            (nth families (sub ordinal 1))))
    (defn fkfnb-schedule-row-valid? (r families)
        (if (not (eq (fkpfm-list? r) 1)) 0
        (if (not (eq (len r) 8)) 0
        (if (not (str_eq (head r)
                         "family-native-resident-schedule-v1")) 0
            (do
                (let batch-id (fkfnb-schedule-batch-id r))
                (let ordinal (fkfnb-schedule-ordinal r))
                (let family (fkfnb-schedule-family r))
                (let binding (fkfnb-schedule-binding r))
                (let expected-family (fkfnb-family-at families ordinal))
                (if (nothing? expected-family) 0
                (if (not (eq (fkfne-binding-valid? binding) 1)) 0
                    (fkfnb-all? (list
                        (eq (nmfe-sha256? batch-id) 1)
                        (str_eq family expected-family)
                        (str_eq family (fkfne-binding-family binding))
                        (str_eq (fkfne-binding-carrier binding) "metal")
                        (str_eq (fkfnb-schedule-teach r)
                            (fkfne-teach-frame binding))
                        (str_eq (fkfnb-schedule-teach-sha r)
                            (nmfe-sha256 (fkfnb-schedule-teach r)))
                        (str_eq (fkfnb-schedule-run-id r)
                            (fkfnb-run-id batch-id ordinal family binding)))))))))))
    (defn fkfnb-build-schedule-loop (batch-id families ordinal)
        (if (nil? families) (list)
            (cons (fkfnb-schedule-row batch-id ordinal (head families))
                  (fkfnb-build-schedule-loop batch-id (tail families)
                                             (add ordinal 1)))))
    (defn fkfnb-build-schedule (batch-id)
        (fkfnb-build-schedule-loop batch-id (fkfnb-families) 1))
    (defn fkfnb-binding-run-key (row)
        (nmfe-sha256 (nmfe-fields (list
            "family-source-challenge-binding-run-v1"
            (fkfnb-schedule-family row)
            (fkfne-binding-source-sha (fkfnb-schedule-binding row))
            (fkfne-binding-challenge-sha (fkfnb-schedule-binding row))
            (fkfne-binding-sha (fkfnb-schedule-binding row))
            (fkfnb-schedule-run-id row)))))
    (defn fkfnb-schedule-valid-loop
        (rows families ordinal batch-id run-ids binding-ids tuple-ids)
        (if (nil? rows)
            (if (nil? families) 1 0)
            (if (nil? families) 0
                (do
                    (let row (head rows))
                    (let run-id (fkfnb-schedule-run-id row))
                    (let binding-id
                        (fkfne-binding-sha (fkfnb-schedule-binding row)))
                    (let tuple-id (fkfnb-binding-run-key row))
                    (if (not (eq (fkfnb-schedule-row-valid?
                                      row (fkfnb-families)) 1)) 0
                    (if (not (str_eq (fkfnb-schedule-batch-id row)
                                     batch-id)) 0
                    (if (not (eq (fkfnb-schedule-ordinal row) ordinal)) 0
                    (if (not (str_eq (fkfnb-schedule-family row)
                                     (head families))) 0
                    (if (or (eq (fkfnb-string-in? run-id run-ids) 1)
                            (or (eq (fkfnb-string-in? binding-id binding-ids) 1)
                                (eq (fkfnb-string-in? tuple-id tuple-ids) 1))) 0
                        (fkfnb-schedule-valid-loop (tail rows)
                            (tail families) (add ordinal 1) batch-id
                            (cons run-id run-ids)
                            (cons binding-id binding-ids)
                            (cons tuple-id tuple-ids)))))))))))
    (defn fkfnb-schedule-valid? (rows batch-id)
        (if (not (eq (fkpfm-list? rows) 1)) 0
        (if (not (eq (len rows) (fkfnb-family-count))) 0
        (if (not (eq (nmfe-sha256? batch-id) 1)) 0
            (fkfnb-schedule-valid-loop rows (fkfnb-families) 1 batch-id
                (list) (list) (list))))))

    ; Exact acknowledgement proves that generation resumed after the typed
    ; observation, while remaining bound to this family/run.
    (defn fkfnb-ack (schedule-row)
        (fkfne-cat (list
            "<|form:family-native-exec-held|>"
            "\nfamily=" (fkfnb-schedule-family schedule-row)
            "\nbinding-sha="
                (fkfne-binding-sha (fkfnb-schedule-binding schedule-row))
            "\nrun-id=" (fkfnb-schedule-run-id schedule-row)
            "\n<|/form:family-native-exec-held|>")))

    ; ---- captured resident crossing -------------------------------
    ; capture = tag schedule raw prep result typed ack ack-sha residence
    ;           same-residence carrier-released capture-sha
    (defn fkfnb-capture-message
        (schedule raw prep result typed ack residence same carrier-released)
        (nmfe-fields (list "family-native-resident-capture-v1"
            (fkfnb-schedule-run-id schedule)
            (fkfne-binding-sha (fkfnb-schedule-binding schedule))
            (nmfe-sha256 raw) (fkfne-prep-emitted-sha prep)
            (fkfne-output-sha (fkfnb-schedule-binding schedule) prep result)
            (nmfe-sha256 typed) (nmfe-sha256 ack) residence
            (int_to_str same) (int_to_str carrier-released))))
    (defn fkfnb-capture-record
        (schedule raw prep result typed ack ack-sha residence same
         carrier-released capture-sha)
        (list "family-native-resident-capture-v1" schedule raw prep result
              typed ack ack-sha residence same carrier-released capture-sha))
    (defn fkfnb-capture
        (schedule raw prep result typed ack residence same carrier-released)
        (fkfnb-capture-record schedule raw prep result typed ack
            (nmfe-sha256 ack) residence same carrier-released
            (fkfnb-capture-message schedule raw prep result typed ack residence
                                  same carrier-released)))
    (defn fkfnb-capture-schedule (c) (nth c 1))
    (defn fkfnb-capture-raw (c) (nth c 2))
    (defn fkfnb-capture-prep (c) (nth c 3))
    (defn fkfnb-capture-result (c) (nth c 4))
    (defn fkfnb-capture-typed (c) (nth c 5))
    (defn fkfnb-capture-ack (c) (nth c 6))
    (defn fkfnb-capture-ack-sha (c) (nth c 7))
    (defn fkfnb-capture-residence (c) (nth c 8))
    (defn fkfnb-capture-same-residence? (c) (nth c 9))
    (defn fkfnb-capture-carrier-released? (c) (nth c 10))
    (defn fkfnb-capture-sha (c) (nth c 11))
    (defn fkfnb-result-signal-kind (result)
        (if (not (eq (fkpfm-list? result) 1)) "malformed"
        (if (not (eq (len result) 13)) "malformed"
        (if (eq (frex-result-value-present? result) 0)
            (if (str_eq (frex-result-status result) "timeout") "timeout"
            (if (str_eq (frex-result-status result) "failure") "failure"
            (if (str_eq (frex-result-status result) "nothing") "nothing"
                "absent-value")))
        (if (eq (frex-result-value result) 0) "zero"
        (if (eq (frex-result-value result) 1) "one" "value"))))))
    (defn fkfnb-capture-valid? (capture)
        (if (not (eq (fkpfm-list? capture) 1)) 0
        (if (not (eq (len capture) 12)) 0
        (if (not (str_eq (head capture)
                         "family-native-resident-capture-v1")) 0
            (do
                (let schedule (fkfnb-capture-schedule capture))
                (let raw (fkfnb-capture-raw capture))
                (let prep (fkfnb-capture-prep capture))
                (let result (fkfnb-capture-result capture))
                (let typed (fkfnb-capture-typed capture))
                (let ack (fkfnb-capture-ack capture))
                (if (not (eq (fkfnb-schedule-row-valid?
                                  schedule (fkfnb-families)) 1)) 0
                (if (not (eq (fkfne-preparation-valid? prep) 1)) 0
                (if (not (eq (fkfne-result-signal-valid? result) 1)) 0
                    (fkfnb-all? (list
                        (str_eq raw (fkfne-binding-query
                            (fkfnb-schedule-binding schedule)))
                        (str_eq (fkfne-prep-emitted-sha prep)
                            (nmfe-sha256 raw))
                        (str_eq (fkfne-binding-sha
                            (fkfne-prep-binding prep))
                            (fkfne-binding-sha
                                (fkfnb-schedule-binding schedule)))
                        (eq (fkfne-native-result-bound?
                            (fkfnb-schedule-binding schedule) prep result) 1)
                        (str_eq typed (frex-render result))
                        (eq (frxc-observation-valid? typed) 1)
                        (str_eq ack (fkfnb-ack schedule))
                        (str_eq (fkfnb-capture-ack-sha capture)
                            (nmfe-sha256 ack))
                        (eq (nmfe-sha256?
                            (fkfnb-capture-residence capture)) 1)
                        (eq (fkfnb-capture-same-residence? capture) 1)
                        (eq (fkfnb-capture-carrier-released? capture) 1)
                        (eq (fkfne-prep-model-requested? prep) 1)
                        (eq (fkfne-prep-scannerless? prep) 1)
                        (eq (fkfne-prep-pretokenized? prep) 0)
                        (str_eq (frex-result-status result) "value")
                        (eq (frex-result-value-present? result) 1)
                        (eq (frex-result-native-code-generated? result) 1)
                        (eq (frex-result-executed? result) 1)
                        (eq (frex-result-model-executed? result) 0)
                        (eq (frex-trace-has? (frex-result-trace result)
                                             "release") 1)
                        (str_eq (fkfnb-capture-sha capture)
                            (fkfnb-capture-message schedule raw prep result
                                typed ack (fkfnb-capture-residence capture)
                                (fkfnb-capture-same-residence? capture)
                                (fkfnb-capture-carrier-released?
                                    capture)))))))))))))

    ; ---- post-release v2 row --------------------------------------
    ; row = tag capture check row-sha
    (defn fkfnb-row-message (capture check)
        (nmfe-fields (list "family-native-resident-row-v1"
            (fkfnb-capture-sha capture)
            (fkfnb-schedule-run-id
                (fkfnb-capture-schedule capture))
            (fkfne-check-output-sha check)
            (fkpfm-receipt-sha (fkfne-check-receipt check)))))
    (defn fkfnb-row-record (capture check row-sha)
        (list "family-native-resident-row-v1" capture check row-sha))
    (defn fkfnb-finalize-capture (capture model-id context-release)
        (do
            (let schedule (fkfnb-capture-schedule capture))
            (let check (fkfne-check (fkfnb-schedule-binding schedule)
                (fkfnb-capture-prep capture) (fkfnb-capture-result capture)
                model-id (fkfnb-schedule-run-id schedule) 0
                (if (and (eq context-release 1)
                         (eq (fkfnb-capture-carrier-released? capture) 1))
                    1 0)))
            (fkfnb-row-record capture check
                (if (eq (fkfne-check-valid? check) 1)
                    (nmfe-sha256 (fkfnb-row-message capture check))
                    (nmfe-sha256 "family-native-resident-row-refused")))))
    (defn fkfnb-row-capture (r) (nth r 1))
    (defn fkfnb-row-check (r) (nth r 2))
    (defn fkfnb-row-sha (r) (nth r 3))
    (defn fkfnb-row-valid? (row model-id residence-id)
        (if (not (eq (fkpfm-list? row) 1)) 0
        (if (not (eq (len row) 4)) 0
        (if (not (str_eq (head row) "family-native-resident-row-v1")) 0
            (do
                (let capture (fkfnb-row-capture row))
                (let check (fkfnb-row-check row))
                (if (not (eq (fkfnb-capture-valid? capture) 1)) 0
                (if (not (eq (fkfne-check-valid? check) 1)) 0
                    (fkfnb-all? (list
                        (str_eq (fkfnb-capture-residence capture) residence-id)
                        (str_eq (fkfne-check-model-id check) model-id)
                        (str_eq (fkfne-check-run-id check)
                            (fkfnb-schedule-run-id
                                (fkfnb-capture-schedule capture)))
                        (str_eq (fkfne-binding-sha
                            (fkfne-check-binding check))
                            (fkfne-binding-sha (fkfnb-schedule-binding
                                (fkfnb-capture-schedule capture))))
                        (str_eq (fkfne-check-raw-query check)
                            (fkfnb-capture-raw capture))
                        (str_eq (fkfne-check-typed check)
                            (fkfnb-capture-typed capture))
                        (eq (fkfne-result-same? (fkfne-check-result check)
                            (fkfnb-capture-result capture)) 1)
                        (eq (fkfne-check-remote-calls check) 0)
                        (eq (fkfne-check-release-ok? check) 1)
                        (eq (fkpfm-execution-valid?
                            (fkfne-check-evidence check)) 1)
                        (eq (fkpfm-receipt-valid?
                            (fkfne-check-receipt check)) 1)
                        (str_eq (fkfnb-row-sha row)
                            (nmfe-sha256
                                (fkfnb-row-message capture check))))))))))))
    (defn fkfnb-finalize-captures (captures model-id context-release)
        (if (nil? captures) (list)
            (cons (fkfnb-finalize-capture
                    (head captures) model-id context-release)
                  (fkfnb-finalize-captures
                    (tail captures) model-id context-release))))

    ; ---- one-residence batch ledger -------------------------------
    ; ledger = tag batch model residence opens remote context-release
    ;          schedule captures rows ledger-sha
    (defn fkfnb-schedule-sha-loop (rows text)
        (if (nil? rows) (nmfe-sha256 text)
            (fkfnb-schedule-sha-loop (tail rows)
                (str_concat text (fkfnb-binding-run-key (head rows))))))
    (defn fkfnb-schedule-sha (rows)
        (fkfnb-schedule-sha-loop rows "family-native-schedule-v1"))
    (defn fkfnb-captures-sha-loop (captures text)
        (if (nil? captures) (nmfe-sha256 text)
            (fkfnb-captures-sha-loop (tail captures)
                (str_concat text (fkfnb-capture-sha (head captures))))))
    (defn fkfnb-captures-sha (captures)
        (fkfnb-captures-sha-loop captures "family-native-captures-v1"))
    (defn fkfnb-rows-sha-loop (rows text)
        (if (nil? rows) (nmfe-sha256 text)
            (fkfnb-rows-sha-loop (tail rows)
                (str_concat text (fkfnb-row-sha (head rows))))))
    (defn fkfnb-rows-sha (rows)
        (fkfnb-rows-sha-loop rows "family-native-rows-v1"))
    (defn fkfnb-ledger-message
        (batch-id model-id residence-id opens remote context-release
         schedule captures rows)
        (nmfe-fields (list "family-native-resident-batch-v1" batch-id model-id
            residence-id (int_to_str opens) (int_to_str remote)
            (int_to_str context-release) (fkfnb-schedule-sha schedule)
            (fkfnb-captures-sha captures) (fkfnb-rows-sha rows))))
    (defn fkfnb-ledger-record
        (batch-id model-id residence-id opens remote context-release
         schedule captures rows ledger-sha)
        (list "family-native-resident-batch-v1" batch-id model-id residence-id
              opens remote context-release schedule captures rows ledger-sha))
    (defn fkfnb-ledger
        (batch-id model-id residence-id opens remote context-release
         schedule captures)
        (do
            (let rows (fkfnb-finalize-captures captures model-id context-release))
            (fkfnb-ledger-record batch-id model-id residence-id opens remote
                context-release schedule captures rows
                (nmfe-sha256 (fkfnb-ledger-message batch-id model-id
                    residence-id opens remote context-release schedule captures
                    rows)))))
    (defn fkfnb-ledger-batch-id (r) (nth r 1))
    (defn fkfnb-ledger-model-id (r) (nth r 2))
    (defn fkfnb-ledger-residence-id (r) (nth r 3))
    (defn fkfnb-ledger-open-count (r) (nth r 4))
    (defn fkfnb-ledger-remote-calls (r) (nth r 5))
    (defn fkfnb-ledger-context-release? (r) (nth r 6))
    (defn fkfnb-ledger-schedule (r) (nth r 7))
    (defn fkfnb-ledger-captures (r) (nth r 8))
    (defn fkfnb-ledger-rows (r) (nth r 9))
    (defn fkfnb-ledger-sha (r) (nth r 10))
    (defn fkfnb-align-valid?
        (schedule captures rows model-id residence-id seen-rows seen-receipts)
        (if (nil? schedule)
            (if (and (nil? captures) (nil? rows)) 1 0)
            (if (or (nil? captures) (nil? rows)) 0
                (do
                    (let s (head schedule))
                    (let c (head captures))
                    (let r (head rows))
                    (let receipt-sha
                        (if (eq (fkfne-check-valid? (fkfnb-row-check r)) 1)
                            (fkpfm-receipt-sha
                                (fkfne-check-receipt (fkfnb-row-check r))) ""))
                    (if (not (eq (fkfnb-capture-valid? c) 1)) 0
                    (if (not (eq (fkfnb-row-valid? r model-id residence-id) 1)) 0
                    (if (not (str_eq (fkfnb-schedule-run-id s)
                        (fkfnb-schedule-run-id
                            (fkfnb-capture-schedule c)))) 0
                    (if (not (str_eq (fkfnb-capture-sha c)
                        (fkfnb-capture-sha (fkfnb-row-capture r)))) 0
                    (if (or (eq (fkfnb-string-in? (fkfnb-row-sha r)
                                                   seen-rows) 1)
                            (eq (fkfnb-string-in? receipt-sha
                                                   seen-receipts) 1)) 0
                        (fkfnb-align-valid? (tail schedule) (tail captures)
                            (tail rows) model-id residence-id
                            (cons (fkfnb-row-sha r) seen-rows)
                            (cons receipt-sha seen-receipts)))))))))))
    (defn fkfnb-ledger-valid? (ledger)
        (if (not (eq (fkpfm-list? ledger) 1)) 0
        (if (not (eq (len ledger) 11)) 0
        (if (not (str_eq (head ledger)
                         "family-native-resident-batch-v1")) 0
            (do
                (let batch-id (fkfnb-ledger-batch-id ledger))
                (let model-id (fkfnb-ledger-model-id ledger))
                (let residence-id (fkfnb-ledger-residence-id ledger))
                (let schedule (fkfnb-ledger-schedule ledger))
                (let captures (fkfnb-ledger-captures ledger))
                (let rows (fkfnb-ledger-rows ledger))
                (if (not (eq (fkfnb-schedule-valid? schedule batch-id) 1)) 0
                (if (not (and (eq (len captures) (fkfnb-family-count))
                              (eq (len rows) (fkfnb-family-count)))) 0
                    (fkfnb-all? (list
                        (eq (nmfe-sha256? batch-id) 1)
                        (gt (str_len model-id) 0)
                        (eq (nmfe-sha256? residence-id) 1)
                        (eq (fkfnb-ledger-open-count ledger) 1)
                        (eq (fkfnb-ledger-remote-calls ledger) 0)
                        (eq (fkfnb-ledger-context-release? ledger) 1)
                        (eq (fkfnb-align-valid? schedule captures rows model-id
                            residence-id (list) (list)) 1)
                        (str_eq (fkfnb-ledger-sha ledger)
                            (nmfe-sha256 (fkfnb-ledger-message batch-id model-id
                                residence-id (fkfnb-ledger-open-count ledger)
                                (fkfnb-ledger-remote-calls ledger)
                                (fkfnb-ledger-context-release? ledger)
                                schedule captures rows))))))))))))

    0)
