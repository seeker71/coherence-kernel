// equireach-gguf.fk — the GGUF reach path rewritten against an EQUIREACH byte source.
//
// gguf-read.fk and weight-load.fk are correct and four-way proven, and they are written against a byte
// LIST: `gg-le` reaches a field with `nth bytes off` (O(off)) and `wl-slice` carves a superblock with
// `take n (drop off bytes)` (O(off+n)). On a band fixture that is invisible. On llama3.2:3b it is the
// wall: the metadata KV block alone runs to byte 7 837 658, so gg-tinfo-start walks ~7.8M links per
// field read, and the bridge that would build that list at all (host-abi-string-to-bytes) costs
// ~1.5e-10*n^2 s — 166 s for 1 MB, PROJECTED ~2.5 hours for the header, and the 2 GB tensor block never.
//
// This cell is the SAME structure over equireach.fk's source: identical arithmetic, identical GGUF
// layout knowledge, identical Q6_K unpack — with the O(k) reach swapped for the O(1) one. Nothing here
// re-derives the format; the index math is q6k-dequant.fk's own (q6k-h / q6k-l / q6k-g / q6k-is /
// q6k-qlidx / q6k-s8 / q6k-pow4), so there is still exactly ONE Q6_K spine in the body and this cell is
// a second reach into it, not a second meaning.
//
// NAMING. `egg-*` mirrors `gg-*` (header/KV/tensor-info walk); `ewl-*` mirrors `wl-*` (superblock
// fields and dequantized weights). Offsets are LOCAL to the window the source was opened over — open
// the window at the file coordinate you care about and index from 0.
//
// WHAT IT BUYS, measured on the real 2 GB blob (3 runs each, .fkb cleared every run):
//   - locate a NAMED tensor by walking the file's own 7 837 658-byte header — 30 metadata KVs including
//     the tokenizer's 128 256-element string arrays, then 255 tensor-info records: 4.7 / 4.8 / 5.2 s,
//     answering blk.0.ffn_down.weight = type 14 (Q6_K), dims 8192x3072, absolute offset 331 055 328.
//     The list lane cannot do this AT ALL: the header would have to become a list first, and at the
//     measured ~1.5e-10*n^2 that is PROJECTED ~2.7 hours before the first field is read.
//   - dequant 65 536 weights (256 superblocks) whose base sits 11 760 / 994 770 / 16 723 350 bytes into
//     the window: 3.55 / 3.49 / 3.52 s — 18.5k weights/s, FLAT over a 1400x deeper base. The list lane
//     at the same shape degrades with depth. See the Stone-2 receipt for the full curve.
//
// Kin: equireach.fk (eqr-at — the O(1) reach this is built on), gguf-read.fk (gg-* — the list twin,
// still the four-way-proven spine for fixtures), weight-load.fk (wl-q6k-* / wl-q6k-at-flat — the list
// twin of the superblock carve and its 210-byte stride), q6k-dequant.fk (the index math, shared),
// f16-decode.fk (fd-f16 / fd-value — the super-scale and the F32 gains). The generation loop
// these weights feed reads them as row-major matrices (ewl-mat below).
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk
//
section [form.bml] {
    // ================= the GGUF header walk, equireach =================
    def egg-u8(src, off) = eqr-at(src, off);
    def egg-u32(src, off) = eqr-u32(src, off);
    def egg-u64(src, off) = eqr-u64(src, off);
    def egg-magic(src) = egg-u32(src, 0);
    def egg-magic-ok?(src) = (Comparable) egg-u32(src, 0) == 1179993927 ? 1 : 0;
    def egg-version(src) = egg-u32(src, 4);
    def egg-tensor-count(src) = egg-u64(src, 8);
    def egg-kv-count(src) = egg-u64(src, 16);
    // a GGUF string is (u64 length, then `length` bytes)
    def egg-str-len(src, off) = egg-u64(src, off);
    def egg-str-next(src, off) = off + 8 + egg-u64(src, off);
    // --- metadata KV walk (same value-type sizes and the same O(1) fixed-width array skip) ---
    def egg-vtype-size(t) = (Comparable) t == 0 || ((Comparable) t == 1 || (Comparable) t == 7) ? 1 : (Comparable) t == 2 || (Comparable) t == 3 ? 2 : (Comparable) t == 4 || ((Comparable) t == 5 || (Comparable) t == 6) ? 4 : 8;
    def egg-val-next(src, off, t) = (Comparable) t == 8 ? egg-str-next(src, off) : (Comparable) t == 9 ? egg-arr-skip(src, off + 12, egg-u32(src, off), egg-u64(src, off + 4)) : off + egg-vtype-size(t);
    def egg-arr-skip-var(src, off, et, count) = (Comparable) count == 0 ? off : egg-arr-skip-var(src, egg-val-next(src, off, et), et, count - 1);
    def egg-arr-skip(src, off, et, count) = (Comparable) et == 8 || (Comparable) et == 9 ? egg-arr-skip-var(src, off, et, count) : off + count * egg-vtype-size(et);
    def egg-kv-next(src, off) = egg-val-next(src, egg-str-next(src, off) + 4, egg-u32(src, egg-str-next(src, off)));
    def egg-kv-skip(src, off, n) = (Comparable) n == 0 ? off : egg-kv-skip(src, egg-kv-next(src, off), n - 1);
    def egg-tinfo-start(src) = egg-kv-skip(src, 24, egg-kv-count(src));
    // --- tensor-info walk ---
    def egg-ti-ndims(src, off) = egg-u32(src, egg-str-next(src, off));
    def egg-ti-dim(src, off, k) = egg-u64(src, egg-str-next(src, off) + 4 + k * 8);
    def egg-ti-dim0(src, off) = egg-ti-dim(src, off, 0);
    def egg-ti-tail(src, off) = egg-str-next(src, off) + 4 + egg-ti-ndims(src, off) * 8;
    def egg-ti-type(src, off) = egg-u32(src, egg-ti-tail(src, off));
    def egg-ti-dataoff(src, off) = egg-u64(src, egg-ti-tail(src, off) + 4);
    def egg-ti-next(src, off) = egg-ti-tail(src, off) + 12;
    def egg-ti-namelen(src, off) = egg-str-len(src, off);
    // --- find a tensor by NAME. The target is a host string, so both sides of the comparison are
    // equireach and the walk never builds a list. -1 means absent; the engine never invents a match. ---
    def egg-name-bytes-eq(src, boff, name, k, n) = (Comparable) k == n ? 1 : (Comparable) eqr-at(src, boff + k) == str_byte_at(name, k) ? egg-name-bytes-eq(src, boff, name, k + 1, n) : 0;
    def egg-name-eq(src, off, name) = (Comparable) egg-ti-namelen(src, off) == str_len(name) ? egg-name-bytes-eq(src, off + 8, name, 0, str_len(name)) : 0;
    def egg-find(src, off, remaining, name) = (Comparable) remaining == 0 ? 0 - 1 : (Comparable) egg-name-eq(src, off, name) == 1 ? off : egg-find(src, egg-ti-next(src, off), remaining - 1, name);
    def egg-find-tensor(src, name) = egg-find(src, egg-tinfo-start(src), egg-tensor-count(src), name);
    // --- the tensor-data region base, and a named tensor's ABSOLUTE file offset ---
    def egg-tinfo-walk(src, off, remaining) = (Comparable) remaining == 0 ? off : egg-tinfo-walk(src, egg-ti-next(src, off), remaining - 1);
    def egg-tinfo-end(src) = egg-tinfo-walk(src, egg-tinfo-start(src), egg-tensor-count(src));
    def egg-align-up(x, a) = (x + (a - 1)) / a * a;
    def egg-data-base(src, a) = egg-align-up(egg-tinfo-end(src), a);
    def egg-tensor-abs(src, a, name) = egg-data-base(src, a) + egg-ti-dataoff(src, egg-find-tensor(src, name));
    // ================= Q6_K weights, equireach =================
    // The Q6_K block at base `b` is ql[128] @b+0 · qh[64] @b+128 · scales[16] @b+192 · d f16 @b+208,
    // 210 bytes. The list lane SLICES those four fields out (three O(off+n) carves per weight lookup);
    // here each field byte is reached in place, so no slice, no copy, no list.
    def ewl-q6k-stride() = 210;
    def ewl-d(src, b) = fd-f16(eqr-u16(src, b + 208));
    // the three field reads, at the exact indices q6k-dequant.fk's own decomposition names
    def ewl-ql-byte(src, b, i) = eqr-at(src, b + q6k-qlidx(i));
    def ewl-qh-byte(src, b, i) = eqr-at(src, b + (128 + (q6k-h(i) * 32 + q6k-l(i))));
    def ewl-sc-byte(src, b, i) = eqr-at(src, b + (192 + (q6k-h(i) * 8 + (q6k-is(i) + 2 * q6k-g(i)))));
    def ewl-nib(src, b, i) = (Comparable) (q6k-g(i) / 2) == 0 ? q6k-mod(ewl-ql-byte(src, b, i), 16) : ewl-ql-byte(src, b, i) / 16;
    def ewl-hi(src, b, i) = q6k-mod(ewl-qh-byte(src, b, i) / q6k-pow4(q6k-g(i)), 4);
    def ewl-q(src, b, i) = ewl-nib(src, b, i) + ewl-hi(src, b, i) * 16 - 32;
    def ewl-sc(src, b, i) = q6k-s8(ewl-sc-byte(src, b, i));
    // one weight, index i INSIDE the block at base b — same wall, same refusal as q6k-at
    def ewl-at(src, b, i) = (Comparable) q6k-index-ok?(i) == 1 ? ewl-d(src, b) * ewl-sc(src, b, i) * ewl-q(src, b, i) : form_error("ewl-at: weight index outside the 256-weight Q6_K superblock -- use ewl-flat-at, which strides");
    // --- ewl-flat-at: weight `i` of a Q6_K TENSOR whose first superblock starts at `base`, ANY i, at
    // O(1) reach. This is the accessor a real width actually needs: llama3.2:3b's row is 3072 weights
    // = 12 superblocks, and the whole tensor is 25 165 824 weights. ---
    def ewl-flat-at(src, base, i) = ewl-at(src, base + ewl-q6k-stride() * (i / 256), q6k-mod(i, 256));
    // --- n consecutive dequantized weights as an f32 list, built once, in one O(n) pass. The d and the
    // three field bytes are re-reached per weight — each O(1), so the pass is linear in n and INDEPENDENT
    // of where in the file the window sits. That independence is the whole stone. ---
    def ewl-weights-loop(src, base, i, n, acc) = i >= n ? reverse(acc) : ewl-weights-loop(src, base, i + 1, n, cons(ewl-flat-at(src, base, i), acc));
    def ewl-weights(src, base, n) = ewl-weights-loop(src, base, 0, n, []);
    // --- a rows x cols matrix carved from the flat weight list, row-major (the GGUF tensor layout).
    // A caller goes source -> matrix here without the byte-list lane appearing anywhere in between. ---
    def ewl-take(xs, n) = (Comparable) n == 0 ? empty() : cons(head(xs), ewl-take(tail(xs), n - 1));
    def ewl-drop(xs, n) = (Comparable) n == 0 ? xs : ewl-drop(tail(xs), n - 1);
    def ewl-mat-from(ws, rows, cols, r) = (Comparable) r == rows ? empty() : cons(ewl-take(ws, cols), ewl-mat-from(ewl-drop(ws, cols), rows, cols, r + 1));
    def ewl-mat(ws, rows, cols) = ewl-mat-from(ws, rows, cols, 0);
    // --- REAL F32 tensors (the norm gains: attn_norm / ffn_norm / output_norm are stored unquantized).
    // f32 is f16-decode's one parameterized recipe at (eb 8, mb 23) — same field extraction, wider fields. ---
    def ewl-f32(src, off) = fd-value(eqr-le(src, off, 4), 8, 23);
    def ewl-gain-loop(src, off, i, n, acc) = i >= n ? reverse(acc) : ewl-gain-loop(src, off + 4, i + 1, n, cons(ewl-f32(src, off), acc));
    def ewl-gain(src, off, n) = ewl-gain-loop(src, off, 0, n, []);
    0;
}
