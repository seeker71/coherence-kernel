//////////////////////////////////////////////////////////////////////
//
// bml-bmf-stream-curriculum.bml -- executable BML curriculum body.
//
// High-grammar authority:
//   form/form-stdlib/bml/bml-bmf-stream-curriculum.bml
//
// This source is compiled through section [form.bml].  It constructs the
// custom BMF grammar and runs the scannerless streaming transducer.  The
// source chunk is never converted to a token list.
//
// preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml-bmf-stream-curriculum.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template StreamLesson<TGrammar> {
        member split: String;
        member grammar: TGrammar;
        member evidence: String;
    }

    class BmlBmfStreamCurriculum<T> {
        field AuthorityPath = "form/form-stdlib/bml/bml-bmf-stream-curriculum.bml";
        field ExecutablePath = "form/form-stdlib/bml-bmf-stream-curriculum.bml";
        field CursorRoute = "scannerless-byte-fold-no-tokenizer";
        field CaptureBound = 8;

        thought bbsc-bml-ground = list(
            "form/form-stdlib/bmf-core.fk",
            "form/form-stdlib/bmf-grammar.fk",
            "form/form-stdlib/bmf-byte-cursor.fk",
            "form/form-stdlib/file-byte-window.fk"
        );

        def bbsc-bml-grammar() = bbsc-heldout-grammar();

        def bbsc-bml-program() = bbsc-compile-grammar(
            bbsc-bml-grammar(),
            CaptureBound()
        );

        def bbsc-bml-execute(source) {
            let state = bbsc-open-program(bbsc-bml-program());
            let streamed = bbsc-feed-chunk(state, source);
            bbsc-finish(streamed);
        }

        def bbsc-bml-check() {
            let state = bbsc-bml-execute(bbsc-source());
            let c0 = if eq(bbsc-state-count(state), 2) then 1 else 0;
            let c1 = if str_eq(bbsc-state-status(state), "complete") then 2 else 0;
            let c2 = if eq(bbsc-feed-all-splits?(), 1) then 4 else 0;
            let c3 = if eq(bbsc-bmf-stream-equivalent?(), 1) then 8 else 0;
            add(c0, add(c1, add(c2, c3)));
        }
    }

    0;
}
