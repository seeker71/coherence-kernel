//////////////////////////////////////////////////////////////////////
//
// form-glass-launch.bml — content-addressed self-updating Glass door.
//
// Authority: form-stdlib/bml/form-glass-launch.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/native-model-evidence.fk form/form-stdlib/form-glass-staged-startup.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLaunchAuthority {
        field FGLUAuthorityPath = "form/form-stdlib/bml/form-glass-launch.bml";
    }

    class FormGlassLaunch {
        field FGLUSchema = "form-glass-launch-v2";
        // Both live under the hearth's one directory (hearth.bml HearthDir).
        def FGLUDigestPath() = str_concat(HearthDir(), "/form-glass-dependency.manifest");
        def FGLUSupervisorStatePath() = str_concat(HearthDir(), "/form-glass-supervisor.state");
        field FGLUAttentionMs = 5000;
        ref fglu-authority = FormGlassLaunchAuthority;

        def fglu-sources() = list("form/form-stdlib/form-glass-staged-startup.bml", "form/form-stdlib/form-terminal-canvas.bml", "form/form-stdlib/form-glass-telemetry-membrane.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/bml/form-glass-observation-v2.bml", "form/form-stdlib/form-glass-observer.bml", "form/form-stdlib/form-glass-dashboard.bml", "form/form-stdlib/form-glass-flow-ui.bml", "form/form-stdlib/form-glass-observation-ui.bml", "form/form-stdlib/form-glass-atlas-ui.bml", "form/form-stdlib/form-glass-layout-ui.bml", "form/form-stdlib/form-glass-live-ui.bml", "form/form-stdlib/hearth.bml", "form/form-stdlib/form-glass-live.bml", "observe/form-glass-live-run.fk", "form/form-stdlib/form-resource-governor.bml", "form/form-stdlib/form-resource-governor-glass.bml", "observe/form-resource-governor-glass-current-run.fk");
        def fglu-refresh-units() = list("form/form-stdlib/form-glass-staged-startup.bml", "form/form-stdlib/form-terminal-canvas.bml", "form/form-stdlib/form-glass-telemetry-membrane.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/bml/form-glass-observation-v2.bml", "form/form-stdlib/form-glass-observer.bml", "form/form-stdlib/form-glass-dashboard.bml", "form/form-stdlib/form-glass-flow-ui.bml", "form/form-stdlib/form-glass-observation-ui.bml", "form/form-stdlib/form-glass-atlas-ui.bml", "form/form-stdlib/form-glass-layout-ui.bml", "form/form-stdlib/form-glass-live-ui.bml", "form/form-stdlib/hearth.bml", "form/form-stdlib/form-resource-governor.bml", "form/form-stdlib/form-resource-governor-glass.bml");
        def fglu-consumer-sources() = list("form/form-stdlib/form-glass-launch.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/form-glass-live.bml", "observe/form-glass-live-run.fk", "observe/form-resource-governor-glass-current-run.fk");
        def fglu-images() = list("form/form-stdlib/form-glass-live.bml.fkb", "form/form-stdlib/form-glass-live.bml.sym", "observe/form-glass-live-run.fkb", "observe/form-glass-live-run.sym", "observe/form-resource-governor-glass-current-run.fkb", "observe/form-resource-governor-glass-current-run.sym");
        def fglu-line-end(text, start) {
            let found = str_find(text, "\n", start);
            if lt(found, 0) then str_len(text) else found;
        }
        def fglu-source-hash(path) {
            let sym = str_concat(path, ".sym");
            let headText = if lt(file_size(sym), 0) then "" else read_file_slice(sym, 0, 16384);
            let marker = "\nsource-hash ";
            let at = str_find(headText, marker, 0);
            if lt(at, 0) then "source-hash=missing" else substring(headText, add(at, 1), fglu-line-end(headText, add(at, 1)));
        }
        def fglu-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), fglu-cat(tail(parts)));
        def fglu-identity-line(path) = fglu-cat(list(path, "|bytes=", int_to_str(file_size(path)), "|mtime=", int_to_str(file_mtime(path)), "|", fglu-source-hash(path), "\n"));
        def fglu-digest(paths) = if eq(len(paths), 0) then "" else str_concat(fglu-identity-line(head(paths)), fglu-digest(tail(paths)));
        def fglu-stat-line(path) = fglu-cat(list(path, "|bytes=", int_to_str(file_size(path)), "|mtime=", int_to_str(file_mtime(path)), "|loader-validates-own-content\n"));
        def fglu-stat-digest(paths) = if eq(len(paths), 0) then "" else str_concat(fglu-stat-line(head(paths)), fglu-stat-digest(tail(paths)));
        def fglu-dependency-manifest() = str_concat(fglu-digest(fglu-refresh-units()), fglu-stat-digest(fglu-consumer-sources()));
        def fglu-supervisor-mark(state) {
            let made = fs-mkdir(HearthDir());
            let wrote = fs-write-text(FGLUSupervisorStatePath(), state);
            state;
        }
        def fglu-supervisor-state() = fs-read-text(FGLUSupervisorStatePath());
        def fglu-supervisor-restart-of(state) = if str_eq(state, "abstain") then 0 else 1;
        def fglu-supervisor-restart?() = fglu-supervisor-restart-of(fglu-supervisor-state());
        def fglu-refresh-one(path) {
            let started = now_unix_ms();
            let announced = print_str(str_concat("JIT CHECK unit=", str_concat(path, "\n")));
            let result = host-exec(str_concat("./fkwu ", path), "");
            let elapsed = sub(now_unix_ms(), started);
            let shown = print_str(fglu-cat(list("JIT MAP unit=", path, " elapsed-ms=", int_to_str(elapsed), " attention=", if gt(elapsed, FGLUAttentionMs()) then "close-attention" else "within-attention", "\n")));
            1;
        }
        def fglu-refresh(paths) = if eq(len(paths), 0) then 0 else add(fglu-refresh-one(head(paths)), fglu-refresh(tail(paths)));
        // An unchanged dependency identity does not justify fourteen eager
        // child processes.  The next full-view door still passes through
        // fkwu, whose image loader validates source identity and rejects a
        // missing, stale, or foreign image before dispatch.  A changed
        // identity refreshes the bounded units so their source-hash rows can
        // be recomputed before the new manifest is persisted.
        def fglu-refresh-plan(changed) = if eq(changed, 1) then "identity-changed-refresh" else "identity-current-loader-on-demand";
        def fglu-refresh-if-changed(changed) = if eq(changed, 1) then fglu-refresh(fglu-refresh-units()) else 0;
        def fglu-remove-images(paths) = if eq(len(paths), 0) then 0 else add(if eq(fs-exists?(head(paths)), 1) then if eq(fs-remove-file(head(paths)), 0) then 1 else 0 else 0, fglu-remove-images(tail(paths)));
        def fglu-join(paths) = if eq(len(paths), 0) then "" else if eq(len(tail(paths)), 0) then head(paths) else str_concat(head(paths), str_concat(",", fglu-join(tail(paths))));
        def fglu-launch-result(changed, invalidated, digest, elapsed) = list(FGLUSchema(), changed, invalidated, digest, elapsed, if gt(elapsed, FGLUAttentionMs()) then "close-attention" else "within-attention", "observe/form-glass-live-run.fk");
        def fglu-launch() {
            let started = now_unix_ms();
            let startup = fgls-live();
            let made = fs-mkdir(HearthDir());
            let observedDigest = fglu-dependency-manifest();
            let prior = read_file(FGLUDigestPath());
            let observedChanged = if str_eq(prior, observedDigest) then 0 else 1;
            let refreshPlan = fglu-refresh-plan(observedChanged);
            let refreshed = fglu-refresh-if-changed(observedChanged);
            // Refresh can replace a stale symbol row.  Persist the identity
            // observed after that bounded work, never the pre-refresh row.
            let digest = if eq(observedChanged, 1) then fglu-dependency-manifest() else observedDigest;
            let changed = if str_eq(prior, digest) then 0 else 1;
            let invalidated = if eq(changed, 1) then fglu-remove-images(fglu-images()) else 0;
            let persisted = if eq(changed, 1) then write_file_text(FGLUDigestPath(), digest) else 0;
            let elapsed = sub(now_unix_ms(), started);
            let result = fglu-launch-result(changed, invalidated, digest, elapsed);
            print_str(fglu-cat(list("GLASS ADMISSION dependency-changed=", int_to_str(changed), " invalidated-images=", int_to_str(invalidated), " identity=fkwu-source-hash-manifest identity-bytes=", int_to_str(str_len(digest)), " refresh-plan=", refreshPlan, " refreshed-units=", int_to_str(refreshed), " elapsed-ms=", int_to_str(elapsed), " attention-ms=5000 attention=", nth(result, 5), "\n")));
            print_str(fglu-cat(list("cache-map=", fglu-join(fglu-images()), "\nnext=observe/form-glass-live-run.fk\n")));
            result;
        }
    }
    0;
}
