//////////////////////////////////////////////////////////////////////
//
// form-glass-launch.bml — content-addressed self-updating Glass door.
//
// Authority: form-stdlib/bml/form-glass-launch.bml
import form/form-stdlib/core.fk;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/native-model-evidence.fk;
import form/form-stdlib/form-glass-staged-startup.bml;
import form/form-stdlib/hearth.bml;
import form/form-stdlib/bml/host-walk-sync.bml;
import form/form-stdlib/organ-care.bml;
import form/form-stdlib/form-glass-gift-frame.bml;
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLaunchAuthority {
        field FGLUAuthorityPath = "form/form-stdlib/bml/form-glass-launch.bml";
    }

    class FormGlassLaunch {
        field FGLUSchema = "form-glass-launch-v2";
        // Both live under the hearth's one directory (hearth.bml HearthDir).
        def FGLUDigestPath() = (HearthDir() + "/form-glass-dependency.manifest");
        def FGLUSupervisorStatePath() = (HearthDir() + "/form-glass-supervisor.state");
        field FGLUAttentionMs = 5000;
        ref fglu-authority = FormGlassLaunchAuthority;
        def fglu-view-support-sources() = ["form/form-stdlib/bml/glass-memory-accounting.bml", "form/form-stdlib/bml/glass-view-viewport.bml"];
        def fglu-health-spool() = HearthDir() + "/organ-health.jsonl";
        // The operation that recovered supplies a fresh observation for the
        // same aspect. Admission alone cannot settle a runner's old failure.
        def fglu-supervisor-observation(aspect, expected, observed, responder, delivery, evidence) {
            let prior = filter(row => (String) oh-str(row,"organ") == "glass" && (String) oh-str(row,"flow") == "glass-supervisor" && (String) oh-str(row,"aspect") == aspect,oh-read(fglu-health-spool()));
            let fresh = oh-reading("glass","glass-supervisor",aspect,json-node-string(expected),json-node-string(observed),json-node-int(1),[],[],evidence);
            nil?(prior) || !oh-pain(prior[0]) ? fresh : oh-set(oh-set(oh-set(fresh,"care_of",json-node-string(oh-str(prior[0],"id"))),"responder",json-node-string(responder)),"care_delivery",delivery);
        }

        // Platform observations need the checkout's native carrier. Repair this
        // dependency before sensors begin, in the launch that found it missing.
        // The existing compiler owns the build argv; care retains its evidence
        // and rechecks the artifact before the child readers are admitted.
        def fglu-carrier-source() = hw-carrier-argv()[5];
        def fglu-carrier-artifact() = hw-carrier-argv()[4];
        def fglu-carrier-current?() = hw-fresh?(fglu-carrier-artifact(), fglu-carrier-source());
        def fglu-carrier-reading(careOf) {
            let ready = fglu-carrier-current?();
            let row = oh-reading("glass", "glass-platform", "native-carrier", json-node-string("current"), json-node-string(ready ? "current" : "missing-or-stale"), json-node-int(ready), ready ? [] : [oh-need("native-platform-carrier", oh-reference(fglu-carrier-source()))], ready ? [] : ["build-native-carrier"], oh-reference(fglu-carrier-artifact()));
            len(careOf) == 0 ? row : oh-set(row, "care_of", json-node-string(careOf));
        }
        def fglu-carrier-emit(context, stage, row) {
            oh-voice(row);
            oh-emit(fglu-health-spool(), row);
        }
        def fglu-carrier-supply(context, reading, need) = json-node-object([oh-s("build", hw-carrier-at(context)), oh-s("evidence_directory", context)]);
        def fglu-carrier-reobserve(context, reading, delivery) = fglu-carrier-reading(oh-str(reading, "id"));
        def fglu-carrier-care() = (String) hch-read(["uname", "-s"]) != "Darwin" ? 1 : fglu-carrier-current?() ? 1 : {
            let context = hch-dir();
            let reading = fglu-carrier-reading("");
            let emitted = fglu-carrier-emit(context, "organ-health", reading);
            let result = oc-hear(context, reading, [oc-provider("checkout-native-compiler", ["native-platform-carrier"], "build-native-carrier", fglu-carrier-supply)], fglu-carrier-emit, fglu-carrier-reobserve);
            fglu-carrier-current?();
        };

        def fglu-sources() = append(["form/form-stdlib/form-glass-staged-startup.bml", "form/form-stdlib/form-terminal-canvas.bml", "form/form-stdlib/form-glass-telemetry-membrane.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/bml/form-glass-observation-v2.bml", "form/form-stdlib/form-glass-observer.bml", "form/form-stdlib/form-glass-dashboard.bml", "form/form-stdlib/form-glass-flow-ui.bml", "form/form-stdlib/form-glass-observation-ui.bml", "form/form-stdlib/form-glass-atlas-ui.bml", "form/form-stdlib/form-glass-layout-ui.bml", "form/form-stdlib/form-glass-live-ui.bml", "form/form-stdlib/hearth.bml", "form/form-stdlib/form-glass-live.bml", "observe/form-glass-live-run.fk", "form/form-stdlib/form-resource-governor.bml", "form/form-stdlib/form-resource-governor-glass.bml", "observe/form-resource-governor-glass-current-run.fk"], fglu-view-support-sources());
        def fglu-refresh-units() = ["form/form-stdlib/form-glass-staged-startup.bml", "form/form-stdlib/form-terminal-canvas.bml", "form/form-stdlib/form-glass-telemetry-membrane.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/bml/form-glass-observation-v2.bml", "form/form-stdlib/form-glass-observer.bml", "form/form-stdlib/form-glass-dashboard.bml", "form/form-stdlib/form-glass-flow-ui.bml", "form/form-stdlib/form-glass-observation-ui.bml", "form/form-stdlib/form-glass-atlas-ui.bml", "form/form-stdlib/form-glass-layout-ui.bml", "form/form-stdlib/form-glass-live-ui.bml", "form/form-stdlib/hearth.bml", "form/form-stdlib/form-resource-governor.bml", "form/form-stdlib/form-resource-governor-glass.bml"];
        def fglu-sensor-sources() = ["observe/form-glass-sensors-live.fk", "observe/form-glass-machine-live.fk", "observe/form-glass-organs-live.fk", "observe/form-glass-ear-live.fk", "observe/ear-live-native.fk", "observe/ear-tongue-native.fk", "form/form-stdlib/bml/ear-worker-life.bml", "form/form-stdlib/form-glass-sensor-rows.bml", "form/form-stdlib/born-under.bml", "form/form-stdlib/form-glass-gift-frame.bml", "form/form-stdlib/form-glass-organs.bml", "form/form-stdlib/bml/form-glass-awareness.bml", "form/form-stdlib/term-graphics.bml", "form/form-stdlib/bml/ear-listening.bml", "form/form-stdlib/ear-native.fk", "form/form-stdlib/ear-msl.fk", "form/form-stdlib/bml/ear-acoustic-review.bml"];
        def fglu-care-sources() = ["form/form-stdlib/organ-health.bml", "form/form-stdlib/bml/organ-health-values.bml", "form/form-stdlib/bml/organ-health-stream.bml", "form/form-stdlib/organ-care.bml"];
        def fglu-consumer-sources() = append(append(["form/form-stdlib/form-glass-launch.bml", "form/form-stdlib/form-glass-event-loop.bml", "form/form-stdlib/form-glass-live.bml", "form/form-stdlib/bml/form-glass-input.bml", "form/form-stdlib/form-glass-meaning-ui.bml", "form/form-stdlib/bml/transcript-languages.bml", "form/form-stdlib/bml/ear-transcript.bml", "form/form-stdlib/ear-axes.bml", "form/form-stdlib/perception-symbols.bml", "observe/form-glass-live-run.fk", "observe/form-resource-governor-glass-current-run.fk"], fglu-sensor-sources()), append(fglu-view-support-sources(), fglu-care-sources()));
        def fglu-images() = ["observe/form-glass-live-run.fk", "observe/form-resource-governor-glass-current-run.fk"] |> map(path=>[path+".fkb",path+".sym"]) |> foldl((paths,pair)=>append(paths,pair),[]);
        def fglu-line-end(text, start) {
            let found = str_find(text, "\n", start);
            if (found < 0) then len(text) else found;
        }
        def fglu-source-hash(path) {
            let sym = (path + ".sym");
            let headText = if (file_size(sym) < 0) then "" else read_file_slice(sym, 0, 16384);
            let marker = "\nsource-hash ";
            let at = str_find(headText, marker, 0);
            if (at < 0) then "source-hash=missing" else substring(headText, (at + 1), fglu-line-end(headText, (at + 1)));
        }
        def fglu-cat(parts) = if ((Comparable) len(parts) == 0) then "" else ((String) parts[0] + fglu-cat(parts[1:]));
        def fglu-identity-line(path) = fglu-cat([path, "|bytes=", file_size(path).str(), "|mtime=", file_mtime(path).str(), "|", fglu-source-hash(path), "\n"]);
        def fglu-digest(paths) = if ((Comparable) len(paths) == 0) then "" else ((String) fglu-identity-line(paths[0]) + fglu-digest(paths[1:]));
        def fglu-stat-line(path) = fglu-cat([path, "|bytes=", file_size(path).str(), "|mtime=", file_mtime(path).str(), "|loader-validates-own-content\n"]);
        def fglu-stat-digest(paths) = if ((Comparable) len(paths) == 0) then "" else ((String) fglu-stat-line(paths[0]) + fglu-stat-digest(paths[1:]));
        def fglu-dependency-manifest() = ((String) fglu-digest(fglu-refresh-units()) + fglu-stat-digest(fglu-consumer-sources()));
        // The state is a pulse, not a wish: the word, the pid that beats it and the
        // moment of that beat. A glass that ended with its carrier used to leave
        // `running` standing for as long as the file lasted, and every reader after it
        // was told an organ was alive. Now a reader asks host_alive before believing
        // the word, and an unattended state says plainly that its keeper is gone.
        def fglu-supervisor-mark(state) {
            let made = fs-mkdir(HearthDir());
            let wrote = len(ggf-output-scope()) > 0 ? 0 : fs-write-text(FGLUSupervisorStatePath(), fglu-cat([state, "|pid=", host_pid().str(), "|beat=", now_unix_ms().str()]));
            state;
        }
        def fglu-supervisor-text() = fglu-text-or-empty(fs-read-text(FGLUSupervisorStatePath()));
        def fglu-text-or-empty(text) = if nothing?(text) then "" else trim(text);
        def fglu-supervisor-state() = fglu-state-word(fglu-supervisor-text());
        def fglu-state-word(text) = fglu-state-word-at(text, str_find(text, "|", 0));
        def fglu-state-word-at(text, at) = if (at < 0) then text else substring(text, 0, at);
        def fglu-state-field(text, key) = fglu-state-field-at(text, str_find(text, key, 0), len(key));
        def fglu-state-field-at(text, at, n) = if (at < 0) then 0 else fglu-state-number(substring(text, (at + n), len(text)), 0, 0);
        def fglu-state-number(text, i, acc) = if (i >= len(text)) then acc else fglu-state-digit(text, i, acc, str_byte_at(text, i));
        def fglu-state-digit(text, i, acc, b) = if ((b < 48) || (b > 57)) then acc else fglu-state-number(text, (i + 1), ((acc * 10) + (b - 48)));
        def fglu-supervisor-pid() = fglu-state-field(fglu-supervisor-text(), "pid=");
        def fglu-supervisor-beat() = fglu-state-field(fglu-supervisor-text(), "beat=");
        // Standing is a word with a living keeper behind it; anything else is a state
        // that outlived its organ, and saying so is the whole of the repair.
        def fglu-supervisor-standing?() = (((String) fglu-supervisor-state() == "running") && ((Comparable) host_alive(fglu-supervisor-pid()) == 1));
        def fglu-supervisor-restart-of(state) = if ((String) state == "abstain") then 0 else 1;
        def fglu-supervisor-restart?() = fglu-supervisor-restart-of(fglu-supervisor-state());
        // This manifest is a watcher hint. The demanded loader owns source and
        // compiler identity; admission neither compiles units nor deletes images.
        def fglu-refresh-plan(changed) = changed == 1 ? "identity-changed-loader-on-demand" : "identity-current-loader-on-demand";
        def fglu-join(paths) = if ((Comparable) len(paths) == 0) then "" else if ((Comparable) len(paths[1:]) == 0) then paths[0] else (paths[0] + ("," + fglu-join(paths[1:])));
        def fglu-launch-result(changed, invalidated, digest, elapsed) = [FGLUSchema(), changed, invalidated, digest, elapsed, if (elapsed > FGLUAttentionMs()) then "close-attention" else "within-attention", "observe/form-glass-live-run.fk"];
        def fglu-launch() = fglu-launch-at(FGLUDigestPath());
        def fglu-launch-at(manifestPath) {
            let started = now_unix_ms();
            let startup = fgls-live();
            let made = fs-mkdir(HearthDir());
            let observedDigest = fglu-dependency-manifest();
            let prior = read_file(manifestPath);
            let observedChanged = if ((String) prior == observedDigest) then 0 else 1;
            let refreshPlan = fglu-refresh-plan(observedChanged);
            let digest = observedDigest;
            let changed = observedChanged;
            let persisted = changed == 1 ? (write_file(manifestPath, digest) == len(digest) ? 1 : form_error("Glass dependency hint not retained")) : 1;
            let elapsed = (now_unix_ms() - started);
            let result = fglu-launch-result(changed, 0, digest, elapsed);
            print_str(fglu-cat(["GLASS ADMISSION dependency-changed=", changed.str(), " invalidated-images=0 identity=watcher-hint identity-bytes=", len(digest).str(), " refresh-plan=", refreshPlan, " refreshed-units=0 elapsed-ms=", elapsed.str(), " attention-ms=", FGLUAttentionMs().str(), " attention=", result[5], "\n"]));
            print_str(fglu-cat(["cache-map=", fglu-join(fglu-images()), "\nnext=observe/form-glass-live-run.fk\n"]));
            result;
        }
    }
    0;
}
