// The host membrane, in the compact expression the grammar now runs.
//
// User asks. Kernel is the carrier the seed still owns. An adapter is a door.
// A driver is that door's carrier contract. The catalog of doors is the one
// singleton. A template names the generic shape; the body stays Form.
//
// preludes: form-stdlib/host-os-membrane.fk form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template Membrane<Protocol, Carrier> {
        member protocol : Protocol;
        member carrier : Carrier;
    }

    class HostMembrane {
        def hm-kept(n) = n > 0 ? n : 0;
        def hm-user(protocol) = hom-door-body-owned?(protocol) ? 1 : 0;
        def hm-kernel(stage) = hom-seed-c(hom-seed-stage-for(stage)) ? 1 : 0;
        def hm-recovered() = try nothing() else 3;
        def hm-chosen() = choose { nothing(); 4 };
    }

    // The half-open range maps to 2 + 4 + 6.
    let mapped = sum(1 .. 4 |> map(n => n * 2));
    let gate = hm-kept(5) + hm-kept(0 - 2);
    let ctrl = hm-recovered() + hm-chosen();
    let face = hm-user("host:file") + hm-kernel("checkout-c-seed");
    let absent = nothing() ?? 7;
    (mapped + (gate + (ctrl + (face + absent))));
}
