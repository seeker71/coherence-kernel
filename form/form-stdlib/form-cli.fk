// form-cli.fk — the native form-cli DISPATCH library (the verb-routing brain).
// preludes: form-stdlib/bml/form-cli-enrich.bml
// preludes: form-stdlib/bml/form-cli-response-synthesis.bml
// preludes: form-stdlib/bml/form-agent-tools.bml form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/bml/form-cli-cell-mesh-sovereign.bml form-stdlib/bml/form-cli-heal.bml form-stdlib/bml/form-cli-code-request.bml form-stdlib/bml/form-core-care.bml
// Definition-only libraries with no exported-symbol use in this dispatch stay
// independently loadable rather than inflating every direct-source CLI closure:
// form-cli-local-law, text-tokenize, ask-cost-receipt, host-kernel-carrier.
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/voice-traits.fk form-stdlib/nearest-shape.fk form-stdlib/co-learning.fk form-stdlib/co-learning-stream.fk form-stdlib/mesh-dispatch.fk form-stdlib/surprise-salience.fk form-stdlib/host-sense-organ.fk form-stdlib/speech-organ.fk form-stdlib/native-host-instance.fk form-stdlib/rag-embed.fk form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk form-stdlib/ask-native-lane.fk form-stdlib/hmac-sha256.fk form-stdlib/form-cli-staged-trace.fk form-stdlib/form-cli-request.fk form-stdlib/form-cli-carrier.fk form-stdlib/resource-port.fk form-stdlib/bml-native-interface-package-import.fk form-stdlib/hati-os-targets.fk form-stdlib/form-native-resource-interfaces.fk form-stdlib/form-fs.fk form-stdlib/storage-port.fk form-stdlib/fnri-standin.fk form-stdlib/fnri-receipt.fk form-stdlib/current-branch-landing.fk form-stdlib/form-cli-surface-inquiry.fk form-stdlib/form-cli-ask.fk form-stdlib/relational-inquiry-metabolism.fk form-stdlib/form-cli-inquiry.fk form-stdlib/form-cli-oracle-loop.fk form-stdlib/ds4-query-channel.fk form-stdlib/grammars/sanskrit-roots.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/form-cli-thought.fk form-stdlib/tool-channel.fk form-stdlib/bml/zvec-grep.bml
section [form.bml] {
    def fc-verb(cmd) = {
        let sp = str_find(cmd, " ", 0);
        sp < 0 ? cmd : substring(cmd, 0, sp);
    };
    def fc-arg(cmd) = {
        let sp = str_find(cmd, " ", 0);
        sp < 0 ? "" : substring(cmd, sp + 1, str_len(cmd));
    };
    def fc-part(parts, i, fallback) = len(parts) > i ? nth(parts, i) : fallback;
    def fc-part-int(parts, i, fallback) = str_to_int(fc-part(parts, i, int_to_str(fallback)));
    def fc-part-bool(parts, i) = fc-part-int(parts, i, 0) > 0;
    def fc-none-empty(s) = (String) s == "none" ? "" : s;
    def fc-learning-path() = ".form-native-learning.tsv";
    def fc-learned-line-result(line, word) = {
        let fields = split-on(line, "|");
        (Comparable) len(fields) == 4 && (String) nth(fields, 0) == word ? str_concat(nth(fields, 0), str_concat(" — root ", str_concat(nth(fields, 1), str_concat(" (", str_concat(nth(fields, 2), str_concat(") : ", nth(fields, 3))))))) : "";
    };
    // last match wins: the ledger is append-only history, and the newest
    // teaching answers — a re-taught word updates the reply without erasing
    // the rows that came before it.
    def fc-learned-find-loop(raw, word, pos, n, best) = pos >= n ? best : {
        let line-end = scan_run(raw, pos, 5);
        let next-pos = line-end < n ? line-end + 1 : n;
        let found = fc-learned-line-result(substring(raw, pos, line-end), word);
        fc-learned-find-loop(raw, word, next-pos, n, (String) found == "" ? best : found);
    };
    def fc-learned-find(word) = {
        let raw0 = read_file(fc-learning-path());
        let raw = nothing?(raw0) ? "" : raw0;
        fc-learned-find-loop(raw, word, 0, str_len(raw), "");
    };
    def fc-learn(arg) = {
        let result = fc-learn-native(arg);
        let fields = split-on(arg, "|");
        let learned = (Comparable) len(fields) == 4 && (Comparable) str_find(result, "learned=", 0) == 0 ? nsm-offer(hearth-session-learning(), nsm-id(), "native-vocabulary-teaching", "caller", str_concat("What does ", str_concat(nth(fields, 0), " mean?")), nth(fields, 3), "caller-teaching", "native-vocabulary-write-observed", 0) : list();
        result;
    };
    def fc-learn-native(arg) = {
        let fields = split-on(arg, "|");
        !((Comparable) len(fields) == 4) ? "usage: learn <surface>|<root>|<meaning>|<gloss>" : {
            let row = str_concat(arg, "\n");
            let wrote = fcr-append-string(fc-learning-path(), row);
            (Comparable) wrote == 0 ? str_concat("learned=", str_concat(nth(fields, 0), "\nstate-changed=1\nsource=form-native-local-observation")) : "learn:error:append-failed";
        };
    };
    def fc-improve(word) = (String) word == "" ? "usage: improve <word>" : {
        let learned = fc-learned-find(word);
        (String) learned == "" ? str_concat("improvement-source=form-native-dhatu\n", str_concat("input=", str_concat(word, str_concat("\nresult=", dhatu-answer(word))))) : str_concat("improvement-source=form-native-learned\n", str_concat("input=", str_concat(word, str_concat("\nresult=", learned))));
    };
    // The explicit frontier membrane. The twelve fields are compact identity,
    // outcome, capability and availability signals; prompt and answer content
    // are deliberately not representable. A posterior local-gap alone cannot
    // open this door.
    def fc-frontier-refusal(reason) = str_concat("frontier-admit=0\ndecision=stay-local\nfrontier-packet-bytes=0\nfrontier-packet=nothing\nreason=", reason);
    def fc-frontier-admission(arg) = {
        let parts = split-on(arg, "|");
        !((Comparable) len(parts) == 12) ? "usage: frontier-admit <attempt>|<request-nodeid>|<local-model>|<nothing|timeout|failure|bad-shape|unsupported>|<gap-nodeid>|<gap-capability>|<local-alternatives-left>|<capture-ready>|<provider>|<provider-capability>|<available>|<turns-used>" : !((Comparable) fsuf-uint?(nth(parts, 6)) == 1 && ((Comparable) fsuf-uint?(nth(parts, 7)) == 1 && ((Comparable) fsuf-uint?(nth(parts, 10)) == 1 && (Comparable) fsuf-uint?(nth(parts, 11)) == 1))) ? fc-frontier-refusal("malformed-numeric-field") : {
            let observation = fsuf-local-observation(nth(parts, 0), nth(parts, 1), nth(parts, 2), nth(parts, 3), nth(parts, 4), nth(parts, 5), str_to_int(nth(parts, 6)), str_to_int(nth(parts, 7)));
            let profile = fsuf-frontier-profile(nth(parts, 8), nth(parts, 9), str_to_int(nth(parts, 10)), str_to_int(nth(parts, 11)));
            let admitted = fsuf-frontier-admit?(observation, profile);
            let packet = fsuf-frontier-packet(observation, profile);
            str_concat("frontier-admit=", str_concat(int_to_str(admitted), str_concat("\ndecision=", str_concat((Comparable) admitted == 1 ? "frontier-once" : "stay-local", str_concat("\nfrontier-packet-bytes=", str_concat(int_to_str(str_len(packet)), str_concat("\nfrontier-packet=", (Comparable) admitted == 1 ? packet : "nothing")))))));
        };
    };
    def fc-native-host-row(r) = str_concat(nhi-rec-kind(r), str_concat("|", str_concat(nhi-rec-platform(r), str_concat("|", str_concat(int_to_str(nhi-rec-native?(r)), str_concat("|", str_concat(int_to_str(nhi-rec-listening?(r)), str_concat("|", str_concat(int_to_str(nhi-rec-sharing?(r)), str_concat("|", str_concat(int_to_str(nhi-rec-transcribe?(r)), str_concat("|", str_concat(int_to_str(nhi-rec-surprises(r)), str_concat("|", str_concat(int_to_str(nhi-rec-learned(r)), str_concat("|", str_concat(nhi-rec-decision(r), str_concat("|", nhi-rec-share-route(r)))))))))))))))))));
    def fc-native-host(arg) = {
        let parts = split-on(arg, " ");
        let platform = fc-part(parts, 0, "android");
        let mic = fc-part-int(parts, 1, 1);
        let cam = fc-part-int(parts, 2, 0);
        let screen = fc-part-int(parts, 3, 1);
        let gate = fc-part-int(parts, 4, 0);
        let freq = fc-part-int(parts, 5, 0);
        let surprise-count = fc-part-int(parts, 6, 0);
        let sample-count = fc-part-int(parts, 7, 0);
        let msg0 = fc-part(parts, 8, "");
        let msg = (String) msg0 == "gold" ? "gold clear" : msg0;
        let host = hso-receipt(200000, 0, 0, 0, 800000, mic, cam, screen);
        let speech = so-receipt(gate, freq, gate > 0 ? 55 : 0, platform);
        let surprises = surprise-count > 0 ? list(list("host-surprise", 72)) : empty();
        let samples = sample-count > 0 ? list(list(platform, list(sample-count, 0, 0))) : empty();
        fc-native-host-row(nhi-cycle(platform, host, speech, surprises, samples, msg));
    };
    def fc-fnri(arg) = (String) arg == "" ? str_concat("runtime=", str_concat(fnri-runtime(), str_concat(" no-go=", int_to_str(fnri-no-go-emission?())))) : {
        let parts = split-on(arg, " ");
        (String) head(parts) == "witness" ? fnri-witness-str() : (String) head(parts) == "know" ? fnri-know-line(fc-part(parts, 1, "")) : (String) head(parts) == "resolve" ? {
            let target = fc-part(parts, 1, "macos-arm64");
            let protocol = fc-part(parts, 2, "host:process");
            let resolved = fnri-resolve(target, protocol);
            let iface = fnri-resolve-interface(resolved);
            bnii-interface-name(iface);
        } : fnri-knowledge-line(arg);
    };
    // An absent index answers nothing with its reason; it is not an error to
    // measure the length of.
    def fc-rag-status() = {
        let raw0 = read_file(ra-default-index());
        nothing?(raw0) ? str_concat("rag-index signal=nothing reason=no-index-at ", ra-default-index()) : fc-rag-status-of(raw0, read_file(ra-staged-query()));
    };
    def fc-rag-status-of(raw, staged-query0) = {
        let staged-query = nothing?(staged-query0) ? "" : staged-query0;
        let first-end = scan_run(raw, 0, 5);
        let first-row = substring(raw, 0, first-end);
        let query-vec = re-semantic-vec(staged-query);
        let raw-len = str_len(raw);
        let query-len = str_len(staged-query);
        let schema-current = !(str_find(raw, "\"schema\":\"nodeid-rag-v2\"", 0) < 0) && !(str_find(raw, "\"embedding_kind\":\"form-semantic-v2\"", 0) < 0) ? 1 : 0;
        let grounded = ra-hit-output(ra-stream-hit(raw, staged-query));
        let a = str_concat("rag-index raw=", int_to_str(raw-len));
        let b = str_concat(a, str_concat(" query=", int_to_str(query-len)));
        let c = str_concat(b, str_concat(" schema-current=", int_to_str(schema-current)));
        let d = str_concat(c, str_concat(" first-row-ready=", int_to_str(ric-grounding-ready?(first-row))));
        let e = str_concat(d, str_concat(" first-row-node=", ric-node-id(first-row)));
        let f = str_concat(e, str_concat(" first-row-content=", ric-content-node-id(first-row)));
        let g = str_concat(f, str_concat(" first-row-vec=", int_to_str(len(ric-vec(first-row)))));
        let h = str_concat(g, str_concat(" query-features=", int_to_str(len(query-vec))));
        str_concat(h, str_concat(" ", grounded));
    };
    // One selected semantic hit feeds output, trace, and host verification. The
    // old exact-substring scan is removed: ask-staged now travels through the
    // typed NodeID RAG lane and cannot return a source path as grounding.
    def fc-grounded-staged-hit() = ra-grounded-hit-at(ra-default-index(), "");
    def fc-grounded-staged() = ra-hit-output(fc-grounded-staged-hit());
    def fc-ask-staged() = {
        let hit = fc-grounded-staged-hit();
        let grounded = ra-hit-output(hit);
        (String) grounded == "grounded:miss" ? "[ask: local fkwu RAG index has no grounded hit]" : grounded;
    };
    // The verifier arguments are interpreted against the same selected hit, and
    // certificate expiry is measured at this request's staged-query mtime.
    def fc-ask-staged-trace(arg) = {
        let query = read_file(ra-staged-query());
        let hit = ra-grounded-hit-at(ra-default-index(), query);
        let key-hex = fcr-strip-eol(read_file(fcr-key-path()));
        fcast-trace-hit-at(hit, arg, fcast-query-key(query), key-hex, fcr-now-seconds());
    };
    def fc-decoded-answer() = str_concat("answer-lane:fkwu-metal-decoded-prose-binding", str_concat("\nanswer-source:fkwu-native-form-cli", str_concat("\nanswer:local fkwu Metal model-cell observed; decoded answer binding active; full semantic quality remains receipt-scored.", "\nprose-generation:observed-decoded-prose-answer-binding")));
    def fc-synthesis-status() = str_concat("synthesis-lane:fkwu-metal-answer-bound", str_concat("\nreason:decoded-prose-answer-bound-to-ask-staged-local-model-cell", str_concat("\navailable:gguf-locate,gguf-model-cell,gguf-tensor-slice-math,gguf-tensor-set-cell,gguf-semantic-token-generation,gguf-fullwidth-logit-generation,sampler-min-p-four-way,weight-load,block-join,real-gguf-tensor-math-four-way,metal-matvec,metal-model-cell,metal-decode-step,tokenizer-carrier-four-way,llama3-pretokenizer-four-way,real-gguf-tensor-map,metal-weight-bytes-runtime,autoregressive-loop-four-way,ask-staged-model-call-witness,decoded-prose-answer-binding", str_concat("\nobserved:tokenizer-carrier,full-gguf-weight-map,named-real-gguf-tensor-math,full-gguf-named-tensor-slice-math,full-gguf-required-tensor-set-materialization,real-gguf-tokenizer-token-decode,semantic-token-generation,full-width-model-logit-generation,sampler-min-p-four-way,metal-weight-bytes-runtime,autoregressive-loop,ask-staged-model-call,decoded-prose-answer-binding", str_concat("\nwitnessed:full-real-llama-gguf-token-stream — the decode loop lives in a Form cell (native/metal/llama-token-handle.fk, greedy ids over the real llama3.2:3b blob, KV-cached, one sync per token)", str_concat("\nmissing:ask-to-decode-binding — no form-cli verb yet reaches that loop; the prompt-side tokenizer is longest-match, not merge-order BPE; and the Q4_K kernel's parity stone is still owed (1.6x of ggml, named in qk-matvec-slot.fk)", str_concat("\nboundary:ask-staged now returns a decoded local answer receipt; named real GGUF tensor slices enter native math, required tensor-set byte windows enter fkwu content-addressed materialization, a real GGUF tokenizer string row can be selected by Form argmax and decoded as a token, and the min-p sampler/draw path is four-way; the witnessed token stream above runs on the Metal handle door, fourth-arm only", "\nprose-generation:decoded-grounded-answer")))))));
    def fc-model-convergence() = str_concat("model-lane-convergence:one-wide-move", str_concat("\nobserved:grounded-rag,gguf-model-cell,full-gguf-weight-map,named-real-gguf-tensor-math,full-gguf-named-tensor-slice-math,full-gguf-required-tensor-set-materialization,real-gguf-tokenizer-token-decode,semantic-token-generation,full-width-model-logit-generation,sampler-min-p-four-way,metal-weight-bytes-runtime,autoregressive-loop,ask-staged-model-call,decoded-prose-answer-binding", str_concat("\nwide-move:complete-full-width-tensor-payload-staging,dequant-and-accelerator-buffer-placement,full-multilayer-gqa-hidden-state-loop,full-vocabulary-hidden-state-logits,real-token-id-decode,ask-answer-binding", str_concat("\nwitnessed:full-real-llama-gguf-token-stream — form/native/metal/llama-token-handle.fk on the one Metal-carrying fkwu", str_concat("\npending:ask-to-decode-binding — the loop is not yet reachable from any form-cli verb", "\nmethod:bind-ask-to-the-witnessed-loop-through-a-consented-verb")))));
    def fc-ds4-query(arg) = {
        let consent-token = fc-verb(arg);
        let after-consent = fc-arg(arg);
        let role-token = fc-verb(after-consent);
        dqc-stream(consent-token, role-token, arg);
    };
    def fc-ds4-stream(arg) = {
        let parts = split-on(arg, " ");
        let consent-token = fc-part(parts, 0, "consent:no");
        let bound = fc-part-int(parts, 1, 0);
        let events = len(parts) > 2 ? drop(2, parts) : list();
        dqc-native-token-stream(consent-token, bound, events);
    };
    def fc-land-readiness(arg) = {
        let parts = split-on(arg, " ");
        cbl-readiness-after-push(fc-part(parts, 0, "UNKNOWN"), fc-part-bool(parts, 1), fc-none-empty(fc-part(parts, 2, "none")), fc-part(parts, 3, "UNKNOWN"), fc-part-int(parts, 4, 0), fc-part-int(parts, 5, 0), fc-part-int(parts, 6, 0), fc-part-bool(parts, 7), fc-part-bool(parts, 8));
    };
    def fc-rim-evaluation(score, perspective) = rim-evaluation(score, score, score, score, score, score, score, score, (Comparable) perspective == rim-i() ? 1000 : 500, (Comparable) perspective == rim-we() ? 1000 : 500);
    def fc-rim-response(channel, node, score, perspective) = rim-response(channel, node, fc-rim-evaluation(score, perspective), list(channel, node));
    def fc-rim-line(trace) = str_concat("movement=", str_concat(int_to_str(nth(trace, 0)), str_concat(" lane=", str_concat(int_to_str(nth(trace, 1)), str_concat(" perspective=", str_concat(int_to_str(nth(trace, 2)), str_concat(" responses=", str_concat(int_to_str(nth(trace, 4)), str_concat(" chosen=", str_concat(int_to_str(nth(trace, 5)), str_concat(" agreement=", str_concat(int_to_str(nth(trace, 6)), str_concat(" alternatives=", str_concat(int_to_str(len(nth(trace, 7))), str_concat(" ack=", int_to_str(nth(trace, 8)))))))))))))))));
    // <lane> <perspective> <memory-node> <sensed-node> <subtle-node>
    // [memory-score sensed-score subtle-score]
    def fc-relational(movement, arg) = {
        let parts = split-on(arg, " ");
        let lane = fc-part-int(parts, 0, 0);
        let requested-perspective = fc-part-int(parts, 1, 0);
        let perspective = (Comparable) movement == rim-know-i() ? rim-i() : (Comparable) movement == rim-know-we() ? rim-we() : requested-perspective;
        let responses = list(fc-rim-response(rim-memory(), fc-part-int(parts, 2, 0), fc-part-int(parts, 5, 700), perspective), fc-rim-response(rim-sensed(), fc-part-int(parts, 3, 0), fc-part-int(parts, 6, 700), perspective), fc-rim-response(rim-subtle(), fc-part-int(parts, 4, 0), fc-part-int(parts, 7, 700), perspective));
        fc-rim-line(rim-interact(movement, lane, perspective, responses));
    };
    def fc-thought(arg) = {
        let parts = split-on(arg, " ");
        let verb = fc-part(parts, 0, "");
        fct-respond(verb, fc-part-int(parts, 1, 0), fc-part-int(parts, 2, 0), fc-part-int(parts, 3, 0));
    };
    // zg's corpus is assembled from values already held by this form-cli
    // image. The tool catalog row becomes one memory document; no source path
    // is opened and no process or storage port is consulted.
    def fc-zg-tool-text(tool) = str_concat(tc-tool-name(tool), str_concat(" ", str_concat(tc-tool-protocol(tool), str_concat(" ", str_concat(tc-tool-capability(tool), str_concat(" ", str_concat(tc-tool-op(tool), str_concat(" ", str_concat(tc-tool-projection(tool), str_concat(" ", str_concat(tc-tool-input(tool), str_concat(" ", tc-tool-output(tool)))))))))))));
    def fc-zg-tool-doc(tool) = zg-memory-doc(str_concat("tool:", tc-tool-name(tool)), str_concat("form-cli/tool/", tc-tool-name(tool)), fc-zg-tool-text(tool));
    def fc-zg-tool-docs(tools) = nil?(tools) ? empty() : cons(fc-zg-tool-doc(head(tools)), fc-zg-tool-docs(tail(tools)));
    def fc-zg-resident-docs() = fc-zg-tool-docs(tc-tools());
    def fc-zg(arg) = zg-render(zg-command(fc-zg-resident-docs(), arg));
    def fc-share-line() = "form-cli share live-measurement-required: run form/form-stdlib/form-cli-share-run.fk";
    // Response contracts remain exact. Share is an explicit verb/runner, not
    // an invisible prefix attached to every unrelated response.
    def fc-exact-response(body) = body;
    // The native child port has not been emitted.  Keep this boundary inside
    // Form and content-blind: no prompt is retained and no carrier is crossed.
    def fc-turn-native-capability-port-unavailable() = "schema=form-cli-native-turn-port-v1\nexecution=non-executable\ncapability-stage=native-pending-discovery\ndecision=refused-native-capability-port-unavailable";
    // In-process clients supply their own resident source/config rows and retain
    // fat-documents(result) after edits. The stateless text face cannot retain an
    // edit and therefore refuses it instead of announcing a discarded mutation.
    def fc-tool-call(docs, tool, args, input) = fat-call(docs, tool, args, input);
    def fc-tool-command(docs, command, input) = fat-command(docs, command, input);
    // The agent-facing entry is ordinary JSON data: {command,input,documents}.
    // It parses the command with the same bounded argv reader as the typed path
    // and returns stdout/stderr/next documents as JSON, never a host command.
    def fc-tool-wire(request) = fat-wire-call(request);
    def fc-tool-wire-request?(cmd) = str_len(fat-trim(cmd)) > 0 && (Comparable) fat-char(fat-trim(cmd), 0) == 123;
    def fc-tool-display(result) = (String) fat-error(result) == "" ? fat-out(result) : str_concat("form-tool error=", fat-error(result));
    def fc-respond(cmd) = (String) fc-verb(cmd) == "care" || (String) fc-verb(cmd) == "health" ? (String) fc-verb(cmd) == "care" ? occ-command(fc-arg(cmd)) : ohc-command(fc-arg(cmd)) : (String) fc-verb(cmd) == "session" ? nsm-command(fc-arg(cmd)) : fc-respond-dispatch(cmd);
    def fc-respond-dispatch(cmd) = (String) fc-verb(cmd) == "enrich" ? fce-command(fc-arg(cmd)) : (String) fc-verb(cmd) == "synthesize" || (String) fc-verb(cmd) == "response-repair" ? (String) fc-verb(cmd) == "synthesize" ? frsy-command(fc-arg(cmd)) : frr-query(fc-arg(cmd)) : (String) fc-verb(cmd) == "help" ? str_concat(frr-help(), str_concat("\n", str_concat(frsy-help(), str_concat("\n", fc-respond-core(cmd))))) : (String) fc-verb(cmd) == "code" ? fcaq-command(fc-arg(cmd)) : (String) fc-verb(cmd) == "heal" ? fh-command(fc-arg(cmd)) : fc-tool-wire-request?(cmd) ? fc-tool-wire(cmd) : (String) fc-verb(cmd) == "mesh-demo" ? fcm-demo-report() : fat-tool?(fc-verb(cmd)) ? (String) fc-verb(cmd) == "edit" || (String) fc-verb(cmd) == "write" ? "form-tool error=stateful-tool-requires-fc-tool-call" : fc-tool-display(fc-tool-command(fc-zg-resident-docs(), cmd, "")) : fc-respond-core(cmd);
    def fc-session-ask(question) = fc-session-ask-at(hearth-session-learning(), question, 0);
    def fc-session-ask-at(home, question, evaluation) = {
        let existing = fca-ask(question);
        !evaluation && ((String) fca-lane-of(question) == "quiet" && nsm-can(home, "dialogue")) ? {
            let proposal = nsm-model-proposal(home, question, 1);
