; form-cli.fk — the native form-cli DISPATCH library (the verb-routing brain).
; Definition-only libraries with no exported-symbol use in this dispatch stay
; independently loadable rather than inflating every direct-source CLI closure:
; form-cli-local-law, text-tokenize, ask-cost-receipt, host-kernel-carrier.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/voice-traits.fk form-stdlib/nearest-shape.fk form-stdlib/co-learning.fk form-stdlib/co-learning-stream.fk form-stdlib/mesh-dispatch.fk form-stdlib/surprise-salience.fk form-stdlib/host-sense-organ.fk form-stdlib/speech-organ.fk form-stdlib/native-host-instance.fk form-stdlib/rag-embed.fk form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk form-stdlib/ask-native-lane.fk form-stdlib/hmac-sha256.fk form-stdlib/form-cli-staged-trace.fk form-stdlib/form-cli-request.fk form-stdlib/form-cli-carrier.fk form-stdlib/resource-port.fk form-stdlib/bml-native-interface-package-import.fk form-stdlib/hati-os-targets.fk form-stdlib/form-native-resource-interfaces.fk form-stdlib/form-fs.fk form-stdlib/storage-port.fk form-stdlib/fnri-standin.fk form-stdlib/fnri-receipt.fk form-stdlib/current-branch-landing.fk form-stdlib/form-cli-surface-inquiry.fk form-stdlib/form-cli-ask.fk form-stdlib/relational-inquiry-metabolism.fk form-stdlib/form-cli-inquiry.fk form-stdlib/form-cli-oracle-loop.fk form-stdlib/ds4-query-channel.fk form-stdlib/grammars/sanskrit-roots.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/form-cli-thought.fk

(do
    (defn fc-verb (cmd)
        (do (let sp (str_find cmd " " 0))
            (if (lt sp 0) cmd (substring cmd 0 sp))))

    (defn fc-arg (cmd)
        (do (let sp (str_find cmd " " 0))
            (if (lt sp 0) "" (substring cmd (add sp 1) (str_len cmd)))))

    (defn fc-part (parts i fallback)
        (if (gt (len parts) i) (nth parts i) fallback))

    (defn fc-part-int (parts i fallback)
        (str_to_int (fc-part parts i (int_to_str fallback))))

    (defn fc-part-bool (parts i)
        (gt (fc-part-int parts i 0) 0))

    (defn fc-none-empty (s)
        (if (str_eq s "none") "" s))

    (defn fc-learning-path () ".form-native-learning.tsv")

    (defn fc-learned-line-result (line word)
        (do (let fields (split-on line "|"))
            (if (and (eq (len fields) 4) (str_eq (nth fields 0) word))
                (str_concat (nth fields 0)
                    (str_concat " — root " (str_concat (nth fields 1)
                        (str_concat " (" (str_concat (nth fields 2)
                            (str_concat ") : " (nth fields 3)))))))
                "")))

    ; last match wins: the ledger is append-only history, and the newest
    ; teaching answers — a re-taught word updates the reply without erasing
    ; the rows that came before it.
    (defn fc-learned-find-loop (raw word pos n best)
        (if (ge pos n) best
            (do (let line-end (scan_run raw pos 5))
                (let next-pos (if (lt line-end n) (add line-end 1) n))
                (let found (fc-learned-line-result (substring raw pos line-end) word))
                (fc-learned-find-loop raw word next-pos n
                    (if (str_eq found "") best found)))))

    (defn fc-learned-find (word)
        (do (let raw (read_file (fc-learning-path)))
            (fc-learned-find-loop raw word 0 (str_len raw) "")))

    (defn fc-learn (arg)
        (do (let fields (split-on arg "|"))
            (if (not (eq (len fields) 4))
                "usage: learn <surface>|<root>|<meaning>|<gloss>"
                (do (let row (str_concat arg "\n"))
                    (let wrote (fcr-append-string (fc-learning-path) row))
                    (if (eq wrote 0)
                        (str_concat "learned=" (str_concat (nth fields 0)
                            "\nstate-changed=1\nsource=form-native-local-observation"))
                        "learn:error:append-failed")))))

    (defn fc-improve (word)
        (if (str_eq word "") "usage: improve <word>"
            (do (let learned (fc-learned-find word))
                (if (str_eq learned "")
                    (str_concat "improvement-source=form-native-dhatu\n"
                        (str_concat "input=" (str_concat word
                            (str_concat "\nresult=" (dhatu-answer word)))))
                    (str_concat "improvement-source=form-native-learned\n"
                        (str_concat "input=" (str_concat word
                            (str_concat "\nresult=" learned))))))))

    ; The explicit frontier membrane. The twelve fields are compact identity,
    ; outcome, capability and availability signals; prompt and answer content
    ; are deliberately not representable. A posterior local-gap alone cannot
    ; open this door.
    (defn fc-frontier-refusal (reason)
        (str_concat "frontier-admit=0\ndecision=stay-local\nfrontier-packet-bytes=0\nfrontier-packet=nothing\nreason=" reason))

    (defn fc-frontier-admission (arg)
        (do
            (let parts (split-on arg "|"))
            (if (not (eq (len parts) 12))
                "usage: frontier-admit <attempt>|<request-nodeid>|<local-model>|<nothing|timeout|failure|bad-shape|unsupported>|<gap-nodeid>|<gap-capability>|<local-alternatives-left>|<capture-ready>|<provider>|<provider-capability>|<available>|<turns-used>"
                (if (not (and (eq (fsuf-uint? (nth parts 6)) 1)
                         (and (eq (fsuf-uint? (nth parts 7)) 1)
                         (and (eq (fsuf-uint? (nth parts 10)) 1)
                              (eq (fsuf-uint? (nth parts 11)) 1)))))
                    (fc-frontier-refusal "malformed-numeric-field")
                (do
                    (let observation (fsuf-local-observation
                        (nth parts 0) (nth parts 1) (nth parts 2) (nth parts 3)
                        (nth parts 4) (nth parts 5) (str_to_int (nth parts 6))
                        (str_to_int (nth parts 7))))
                    (let profile (fsuf-frontier-profile
                        (nth parts 8) (nth parts 9) (str_to_int (nth parts 10))
                        (str_to_int (nth parts 11))))
                    (let admitted (fsuf-frontier-admit? observation profile))
                    (let packet (fsuf-frontier-packet observation profile))
                    (str_concat "frontier-admit="
                    (str_concat (int_to_str admitted)
                    (str_concat "\ndecision="
                    (str_concat (if (eq admitted 1) "frontier-once" "stay-local")
                    (str_concat "\nfrontier-packet-bytes="
                    (str_concat (int_to_str (str_len packet))
                    (str_concat "\nfrontier-packet="
                        (if (eq admitted 1) packet "nothing")))))))))))))

    (defn fc-native-host-row (r)
        (str_concat (nhi-rec-kind r)
        (str_concat "|"
        (str_concat (nhi-rec-platform r)
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-native? r))
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-listening? r))
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-sharing? r))
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-transcribe? r))
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-surprises r))
        (str_concat "|"
        (str_concat (int_to_str (nhi-rec-learned r))
        (str_concat "|"
        (str_concat (nhi-rec-decision r)
        (str_concat "|"
                    (nhi-rec-share-route r))))))))))))))))))))

    (defn fc-native-host (arg)
        (do
            (let parts (split-on arg " "))
            (let platform (fc-part parts 0 "android"))
            (let mic (fc-part-int parts 1 1))
            (let cam (fc-part-int parts 2 0))
            (let screen (fc-part-int parts 3 1))
            (let gate (fc-part-int parts 4 0))
            (let freq (fc-part-int parts 5 0))
            (let surprise-count (fc-part-int parts 6 0))
            (let sample-count (fc-part-int parts 7 0))
            (let msg0 (fc-part parts 8 ""))
            (let msg (if (str_eq msg0 "gold") "gold clear" msg0))
            (let host (hso-receipt 200000 0 0 0 800000 mic cam screen))
            (let speech (so-receipt gate freq (if (gt gate 0) 55 0) platform))
            (let surprises (if (gt surprise-count 0) (list (list "host-surprise" 72)) (empty)))
            (let samples (if (gt sample-count 0) (list (list platform (list sample-count 0 0))) (empty)))
            (fc-native-host-row (nhi-cycle platform host speech surprises samples msg))))

    (defn fc-fnri (arg)
        (if (str_eq arg "")
            (str_concat "runtime=" (str_concat (fnri-runtime)
                (str_concat " no-go=" (int_to_str (fnri-no-go-emission?)))))
            (do
                (let parts (split-on arg " "))
                (if (str_eq (head parts) "witness")
                    (fnri-witness-str)
                (if (str_eq (head parts) "know")
                    (fnri-know-line (fc-part parts 1 ""))
                (if (str_eq (head parts) "resolve")
                    (do
                        (let target (fc-part parts 1 "macos-arm64"))
                        (let protocol (fc-part parts 2 "host:process"))
                        (let resolved (fnri-resolve target protocol))
                        (let iface (fnri-resolve-interface resolved))
                        (bnii-interface-name iface))
                    (fnri-knowledge-line arg)))))))

    (defn fc-rag-status ()
        (do
            (let raw (read_file (ra-default-index)))
            (let staged-query (read_file (ra-staged-query)))
            (let first-end (scan_run raw 0 5))
            (let first-row (substring raw 0 first-end))
            (let query-vec (re-semantic-vec staged-query))
            (let raw-len (str_len raw))
            (let query-len (str_len staged-query))
            (let schema-current (if (and
                (not (lt (str_find raw "\"schema\":\"nodeid-rag-v2\"" 0) 0))
                (not (lt (str_find raw "\"embedding_kind\":\"form-semantic-v2\"" 0) 0))) 1 0))
            (let grounded (ra-hit-output (ra-stream-hit raw staged-query)))
            (let a (str_concat "rag-index raw=" (int_to_str raw-len)))
            (let b (str_concat a (str_concat " query=" (int_to_str query-len))))
            (let c (str_concat b (str_concat " schema-current=" (int_to_str schema-current))))
            (let d (str_concat c (str_concat " first-row-ready="
                (int_to_str (ric-grounding-ready? first-row)))))
            (let e (str_concat d (str_concat " first-row-node=" (ric-node-id first-row))))
            (let f (str_concat e (str_concat " first-row-content=" (ric-content-node-id first-row))))
            (let g (str_concat f (str_concat " first-row-vec=" (int_to_str (len (ric-vec first-row))))))
            (let h (str_concat g (str_concat " query-features=" (int_to_str (len query-vec)))))
            (str_concat h (str_concat " " grounded))))

    ; One selected semantic hit feeds output, trace, and host verification. The
    ; old exact-substring scan is removed: ask-staged now travels through the
    ; typed NodeID RAG lane and cannot return a source path as grounding.
    (defn fc-grounded-staged-hit ()
        (ra-grounded-hit-at (ra-default-index) ""))

    (defn fc-grounded-staged ()
        (ra-hit-output (fc-grounded-staged-hit)))

    (defn fc-ask-staged ()
        (do (let hit (fc-grounded-staged-hit))
            (let grounded (ra-hit-output hit))
            (if (str_eq grounded "grounded:miss")
                "[ask: local fkwu RAG index has no grounded hit]"
                grounded)))

    ; The verifier arguments are interpreted against the same selected hit, and
    ; certificate expiry is measured at this request's staged-query mtime.
    (defn fc-ask-staged-trace (arg)
        (do
            (let query (read_file (ra-staged-query)))
            (let hit (ra-grounded-hit-at (ra-default-index) query))
            (let key-hex (fcr-strip-eol (read_file (fcr-key-path))))
            (fcast-trace-hit-at hit arg (fcast-query-key query) key-hex
                (fcr-now-seconds))))

    (defn fc-decoded-answer ()
        (str_concat "answer-lane:fkwu-metal-decoded-prose-binding"
        (str_concat "\nanswer-source:fkwu-native-form-cli"
        (str_concat "\nanswer:local fkwu Metal model-cell observed; decoded answer binding active; full semantic quality remains receipt-scored."
                    "\nprose-generation:observed-decoded-prose-answer-binding"))))

    (defn fc-synthesis-status ()
        (str_concat "synthesis-lane:fkwu-metal-answer-bound"
        (str_concat "\nreason:decoded-prose-answer-bound-to-ask-staged-local-model-cell"
            (str_concat "\navailable:gguf-locate,gguf-model-cell,gguf-tensor-slice-math,gguf-tensor-set-cell,gguf-semantic-token-generation,gguf-fullwidth-logit-generation,sampler-min-p-four-way,weight-load,block-join,real-gguf-tensor-math-four-way,metal-matvec,metal-model-cell,metal-decode-step,tokenizer-carrier-four-way,llama3-pretokenizer-four-way,real-gguf-tensor-map,metal-weight-bytes-runtime,autoregressive-loop-four-way,ask-staged-model-call-witness,decoded-prose-answer-binding"
        (str_concat "\nobserved:tokenizer-carrier,full-gguf-weight-map,named-real-gguf-tensor-math,full-gguf-named-tensor-slice-math,full-gguf-required-tensor-set-materialization,real-gguf-tokenizer-token-decode,semantic-token-generation,full-width-model-logit-generation,sampler-min-p-four-way,metal-weight-bytes-runtime,autoregressive-loop,ask-staged-model-call,decoded-prose-answer-binding"
        (str_concat "\nwitnessed:full-real-llama-gguf-token-stream — the decode loop lives in a Form cell (llama-token-handle.fk, twelve greedy ids over the real llama3.2:3b blob, KV-cached, one sync per token, band 255) and its slot rung (llama-token-slot.fk, same twelve ids through the cooperative twins with the reassociation bound stated and checked, band 255, ~39 tok/s witnessed 2026-08-18)"
        (str_concat "\nmissing:ask-to-decode-binding — no form-cli verb yet reaches that loop; the prompt-side tokenizer is longest-match, not merge-order BPE; and the Q4_K kernel's parity stone is still owed (1.6x of ggml, named in qk-matvec-slot.fk)"
        (str_concat "\nboundary:ask-staged now returns a decoded local answer receipt; named real GGUF tensor slices enter native math, required tensor-set byte windows enter fkwu content-addressed materialization, a real GGUF tokenizer string row can be selected by Form argmax and decoded as a token, and the min-p sampler/draw path is four-way; the witnessed token stream above runs on the Metal handle door, fourth-arm only"
                    "\nprose-generation:decoded-grounded-answer"))))))))

    (defn fc-model-convergence ()
        (str_concat "model-lane-convergence:one-wide-move"
        (str_concat "\nobserved:grounded-rag,gguf-model-cell,full-gguf-weight-map,named-real-gguf-tensor-math,full-gguf-named-tensor-slice-math,full-gguf-required-tensor-set-materialization,real-gguf-tokenizer-token-decode,semantic-token-generation,full-width-model-logit-generation,sampler-min-p-four-way,metal-weight-bytes-runtime,autoregressive-loop,ask-staged-model-call,decoded-prose-answer-binding"
        (str_concat "\nwide-move:complete-full-width-tensor-payload-staging,dequant-and-accelerator-buffer-placement,full-multilayer-gqa-hidden-state-loop,full-vocabulary-hidden-state-logits,real-token-id-decode,ask-answer-binding"
        (str_concat "\nwitnessed:full-real-llama-gguf-token-stream — form/native/metal/tests/llama-token-handle-band.fk 255 and llama-token-slot-band.fk 255, both re-witnessed 2026-08-18 on the one Metal-carrying fkwu"
        (str_concat "\npending:ask-to-decode-binding — the loop is not yet reachable from any form-cli verb"
        (str_concat "\nreceipt:receipts/2026-08-04-form-held-decode-loop.md"
                    "\nmethod:bind-ask-to-the-witnessed-loop-through-a-consented-verb")))))))

    (defn fc-ds4-query (arg)
        (do
            (let consent-token (fc-verb arg))
            (let after-consent (fc-arg arg))
            (let role-token (fc-verb after-consent))
            (dqc-stream consent-token role-token arg)))

    (defn fc-ds4-stream (arg)
        (do
            (let parts (split-on arg " "))
            (let consent-token (fc-part parts 0 "consent:no"))
            (let bound (fc-part-int parts 1 0))
            (let events (if (gt (len parts) 2) (drop 2 parts) (list)))
            (dqc-native-token-stream consent-token bound events)))

    (defn fc-land-readiness (arg)
        (do
            (let parts (split-on arg " "))
            (cbl-readiness-after-push
                (fc-part parts 0 "UNKNOWN")
                (fc-part-bool parts 1)
                (fc-none-empty (fc-part parts 2 "none"))
                (fc-part parts 3 "UNKNOWN")
                (fc-part-int parts 4 0)
                (fc-part-int parts 5 0)
                (fc-part-int parts 6 0)
                (fc-part-bool parts 7)
                (fc-part-bool parts 8))))

    (defn fc-rim-evaluation (score perspective)
        (rim-evaluation score score score score score score score score
            (if (eq perspective (rim-i)) 1000 500)
            (if (eq perspective (rim-we)) 1000 500)))

    (defn fc-rim-response (channel node score perspective)
        (rim-response channel node (fc-rim-evaluation score perspective)
            (list channel node)))

    (defn fc-rim-line (trace)
        (str_concat "movement=" (str_concat (int_to_str (nth trace 0))
        (str_concat " lane=" (str_concat (int_to_str (nth trace 1))
        (str_concat " perspective=" (str_concat (int_to_str (nth trace 2))
        (str_concat " responses=" (str_concat (int_to_str (nth trace 4))
        (str_concat " chosen=" (str_concat (int_to_str (nth trace 5))
        (str_concat " agreement=" (str_concat (int_to_str (nth trace 6))
        (str_concat " alternatives=" (str_concat (int_to_str (len (nth trace 7)))
        (str_concat " ack=" (int_to_str (nth trace 8))))))))))))))))))

    ; <lane> <perspective> <memory-node> <sensed-node> <subtle-node>
    ; [memory-score sensed-score subtle-score]
    (defn fc-relational (movement arg)
        (do
            (let parts (split-on arg " "))
            (let lane (fc-part-int parts 0 0))
            (let requested-perspective (fc-part-int parts 1 0))
            (let perspective (if (eq movement (rim-know-i)) (rim-i)
                (if (eq movement (rim-know-we)) (rim-we) requested-perspective)))
            (let responses (list
                (fc-rim-response (rim-memory) (fc-part-int parts 2 0) (fc-part-int parts 5 700) perspective)
                (fc-rim-response (rim-sensed) (fc-part-int parts 3 0) (fc-part-int parts 6 700) perspective)
                (fc-rim-response (rim-subtle) (fc-part-int parts 4 0) (fc-part-int parts 7 700) perspective)))
            (fc-rim-line (rim-interact movement lane perspective responses))))

    (defn fc-thought (arg)
        (do (let parts (split-on arg " "))
            (let verb (fc-part parts 0 ""))
            (fct-respond verb
                (fc-part-int parts 1 0)
                (fc-part-int parts 2 0)
                (fc-part-int parts 3 0))))

    (defn fc-share-line ()
        "form-cli share live-measurement-required: run form/form-stdlib/form-cli-share-run.fk")

    ; Response contracts remain exact. Share is an explicit verb/runner, not
    ; an invisible prefix attached to every unrelated response.
    (defn fc-exact-response (body)
        body)

    ; The native child port has not been emitted.  Keep this boundary inside
    ; Form and content-blind: no prompt is retained and no carrier is crossed.
    (defn fc-turn-native-capability-port-unavailable ()
        "schema=form-cli-native-turn-port-v1\nexecution=non-executable\ncapability-stage=native-pending-discovery\ndecision=refused-native-capability-port-unavailable")

    (defn fc-respond (cmd)
        (do (let v (fc-verb cmd))
            (fc-exact-response
            (if (str_eq v "share") (fc-share-line)
            (if (str_eq v "thought") (fc-thought (fc-arg cmd))
            (if (str_eq v "ping") "pong"
            (if (str_eq v "learn") (fc-learn (fc-arg cmd))
            (if (str_eq v "improve") (fc-improve (fc-arg cmd))
            (if (str_eq v "inquire") (fci-inquire (fc-arg cmd))
            (if (str_eq v "inquire-core") (fci-core-rewitness)
            (if (str_eq v "frontier-admit") (fc-frontier-admission (fc-arg cmd))
            (if (str_eq v "turn") (fc-turn-native-capability-port-unavailable)
            (do
            (do
            (if (str_eq v "ask") (fca-ask (fc-arg cmd))
            (if (str_eq v "ask-staged") (fc-ask-staged)
            (if (str_eq v "ask-staged-trace") (fc-ask-staged-trace (fc-arg cmd))
            (if (str_eq v "ask-request") (fcr-ask-request (fc-arg cmd))
            (if (str_eq v "ask-request-trace") (fcr-ask-request-trace (fc-arg cmd))
            (if (str_eq v "ask-request-debug") (fcr-ask-request-debug (fc-arg cmd))
            (if (str_eq v "embed-request") (fcr-embed-request (fc-arg cmd))
            (if (str_eq v "carrier-id") (fcc-carrier-id)
            (if (str_eq v "carrier-challenge") (fcc-carrier-challenge (fc-arg cmd))
            (if (str_eq v "decoded-answer") (fc-decoded-answer)
            (if (str_eq v "grounded") (ra-grounded (fc-arg cmd))
            (if (str_eq v "grounded-staged") (fc-grounded-staged)
            (if (str_eq v "rag-status") (fc-rag-status)
            (if (str_eq v "synthesis-status") (fc-synthesis-status)
            (if (str_eq v "model-status") (fc-synthesis-status)
            (if (str_eq v "model-convergence") (fc-model-convergence)
            (if (str_eq v "final-observations") (fc-model-convergence)
            (if (str_eq v "ds4-query") (fc-ds4-query (fc-arg cmd))
            (if (str_eq v "ds4-stream") (fc-ds4-stream (fc-arg cmd))
            (if (str_eq v "ds4-control")
                (dqc-native-token-stream
                    (fc-verb (fc-arg cmd))
                    (fc-part-int (split-on (fc-arg (fc-arg cmd)) ":") 1 (sub 0 1))
                    (list))
            (if (str_eq v "fnri") (fc-fnri (fc-arg cmd))
            (if (str_eq v "receipt") (fc-receipt (fc-arg cmd))
            (if (str_eq v "native-host") (fc-native-host (fc-arg cmd))
            (if (str_eq v "land-readiness") (fc-land-readiness (fc-arg cmd))
            (if (str_eq v "oracle-loop-check") (int_to_str (form-cli-oracle-loop-check))
            (if (str_eq v "surface-inquiry") (fsi-form-cli-command (fc-arg cmd))
            (if (str_eq v "framebuffer-inquire") (fsi-framebuffer-inquiry (fc-arg cmd))
            (if (str_eq v "meet-ask") (fc-relational (rim-ask) (fc-arg cmd))
            (if (str_eq v "give") (fc-relational (rim-give) (fc-arg cmd))
            (if (str_eq v "receive") (fc-relational (rim-receive) (fc-arg cmd))
            (if (str_eq v "know-i") (fc-relational (rim-know-i) (fc-arg cmd))
            (if (str_eq v "know-we") (fc-relational (rim-know-we) (fc-arg cmd))
            (if (str_eq v "build-with") (fc-relational (rim-build) (fc-arg cmd))
            (if (str_eq v "help")
                (str_concat "For you: about, improve, learn, inquire, quit. The rest of this list is for the people building the body. "
                (str_concat "inquiry verbs: inquire <question>; inquire-core re-witnesses the core proof graph. "
                "form-cli verbs: ping share thought learn improve inquire inquire-core frontier-admit local-plan turn surface-inquiry framebuffer-inquire framebuffer-status carrier-id carrier-challenge ask ask-request ask-request-trace ask-request-debug embed-request ask-staged ask-staged-trace grounded rag-status synthesis-status model-route nodeid-stage nodeid-knowledge form-school model-convergence final-observations decoded-answer fnri receipt native-host land-readiness oracle-loop-check nanbeige help about kernel source recreate verify diagnose version quit. local-plan <task>: after models/use, the resident Form-native Qwen speaker returns one compact next local move and retains the model residence. frontier-admit: only an exact exhausted local inability, matching available provider capability, unused frontier turn, and ready local capture emit a content-free one-turn packet; local-gap alone stays local. turn <id>: native capability port is not emitted yet; it refuses without a carrier. model-route: select the highest-priority observed local execution lane; network and loopback membranes are excluded by default. nodeid-stage surface|scan|route|lookup|current <key>: observe one emitted knowledge stage without opening later stages. nodeid-knowledge <key>: strict one-bucket current-source query; absent route and unindexed NodeID return typed nothing without linear fallback. form-school: after `models <dir>` and `use <n>`, admit the separate content-bound BML/BMF/Form school recipe by source/image freshness. The present emitted walker has no in-process program-image call, so a ready image returns typed nothing at that named seam without opening the model; the standalone recipe remains the physical witness. nanbeige <prompt>: explicit pinned Nanbeige-4.2-3B llama.cpp loopback comparator; its JSON is membrane evidence, not Form-native generation. learn <surface>|<root>|<meaning>|<gloss>: persist a local observation; improve <word>: answer from learned state, then the seeded Sanskrit body. inquire <question>: append a local inquiry ledger entry; inquire-core: re-witness its core graph. surface-inquiry <metadata>: record only opaque request/response identifiers then answer an offered relation. framebuffer-inquire events|origins: bounded count or retained source coordinates only, never payloads. framebuffer-status: live framebuffer integrity counters. oracle-loop-check: lineage-honest oracle-regent loop self-check (heir/regent routing, grounding gate, lineage-discounted reference, unconditional learning). carrier-id: baked schema/source/build identity. carrier-challenge <64hex>: Form-computed SHA-256 nonce response. ask-request <id>: invocation-owned native RAG query. ask-request-trace <id>: one-use request-bound HMAC trust row from .query/.receipt files. ask-request-debug <id>: local receipt binding-axis diagnosis without exposing key material. embed-request <id>: canonical semantic-v2 JSONL vectors from hex-safe .embed rows. grounded <question>: native JSONL lookup in the healed index, no Python and no HTTP oracle. rag-status: local index/query/schema health. synthesis-status: local GGUF/Metal composition receipt including the four-way min-p sampler lane. source/verify/diagnose: fkwu self-introspection."
                ))
            (if (str_eq v "about")
                "I am Sema's body on your own computer: a small program that runs on its own. I know a few words of my own, I learn what you teach me, and I say so when I don't have something. In the builder's words: a Form program in one self-contained native binary that dispatches verbs and runs an interactive read-eval-print loop, with no separate runtime. Pipe commands on stdin, or run it on a terminal and type. help lists the verbs."
            (if (str_eq v "kernel")
                "form-cli runs on fkwu, a universal walker generated entirely from Form recipes and compiled to native code. The same walker runs any Form program. this binary has the form-cli program built into it."
            (if (str_eq v "recreate")
                "to rebuild: run the source verb to print the Form source this binary carries. build-form-cli.sh installs the stamped native platform binary when present; maintainer regeneration refreshes bootstrap artifacts. the result runs on its own."
            (if (str_eq v "version")
                "form-cli 0.6"
                ; a free sentence deserves a door, not a rebuff: a line with a
                ; space or a closing '?' is met with the inquire offer; a lone
                ; unknown word keeps the exact unknown-verb reply the band pins.
                (if (or (ge (str_find cmd " " 0) 0)
                        (and (gt (str_len cmd) 0) (eq (str_byte_at cmd (sub (str_len cmd) 1)) 63)))
                    (str_concat "I don't speak free sentences yet — if that was for me, type: inquire "
                        (str_concat cmd "\nThat receives your question and keeps a note that you asked. My words for you: about, improve, learn, inquire, quit."))
                    (str_concat "form-cli: unknown verb '" (str_concat v "' — type 'help'")))))))))))))))))))))))))))))))))))
            )))))))))
            )
            )))
            )
    ))))))
    0)
