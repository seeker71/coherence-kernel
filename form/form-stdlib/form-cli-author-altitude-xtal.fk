
(let AltitudeRow (language-template-with-members "AltitudeRow" (list "TCount") (list (language-template-member "pictures" "TCount") (language-template-member "cells" "TCount") (language-template-member "bound" "TCount"))))
(defn AltitudeAuthorityPath () "form/form-stdlib/bml/form-cli-author-altitude.bml")
(defn AltitudeAuthorityKind () "high-bml-class-template-field")
(defn FormAuthorAltitudeAuthority () (list "abstraction" "FormAuthorAltitudeAuthority" (list) (list) (list "AltitudeAuthorityPath" "AltitudeAuthorityKind") (list) (list)))
(defn PicturesDir () "form/form-stdlib/bml")
(defn CellsDir () "form/form-stdlib")
(defn BindMark () "high-bml-class-template-field")
(defn aar-authority () FormAuthorAltitudeAuthority)
(defn aar-pattern () (list "pictures-with-warmth" "organs-welcome" "bindings-ripen"))
(defn aar-ends? (name suffix) (do (if (lt (str_len name) (str_len suffix)) 0 (if (str_eq (substring name (sub (str_len name) (str_len suffix)) (str_len name)) suffix) 1 0))))
(defn aar-count-suffix (names suffix acc) (if (eq (len names) 0) acc (aar-count-suffix (tail names) suffix (add acc (aar-ends? (head names) suffix)))))
(defn aar-bound? (path) (if (ge (str_find (read_file path) (BindMark) 0) 0) 1 0))
(defn aar-count-bound (dir names acc) (if (eq (len names) 0) acc (aar-count-bound dir (tail names) (add acc (if (eq (aar-ends? (head names) ".fk") 1) (aar-bound? (fs-path-join dir (head names))) 0)))))
(defn aar-pictures () (aar-count-suffix (fs-list (PicturesDir)) ".bml" 0))
(defn aar-cells () (aar-count-suffix (fs-list (CellsDir)) ".fk" 0))
(defn aar-bound () (aar-count-bound (CellsDir) (fs-list (CellsDir)) 0))
(defn aar-ppm (bound cells) (div (mul bound 1000000) (if (eq cells 0) 1 cells)))
(defn aar-fold (pictures bound cells) (add (mul pictures 10000000000) (add (mul bound 10000000) cells)))
(defn aar-run () (do (let pictures (aar-pictures)) (let cells (aar-cells)) (let bound (aar-bound)) (print (str_concat "pictures=" (int_to_str pictures))) (print (str_concat "cells=" (int_to_str cells))) (print (str_concat "bound-cells=" (int_to_str bound))) (print (str_concat "bound-ppm=" (int_to_str (aar-ppm bound cells)))) (aar-fold pictures bound cells)))
(defn aar-bit (ok bit) (if ok bit 0))
(defn aar-check () (do (let pictures (aar-pictures)) (let cells (aar-cells)) (let bound (aar-bound)) (let c0 (aar-bit (gt pictures 0) 1)) (let c1 (aar-bit (gt cells pictures) 2)) (let c2 (aar-bit (gt bound 0) 4)) (let c3 (aar-bit (eq (aar-fold pictures bound cells) (add (mul pictures 10000000000) (add (mul bound 10000000) cells))) 8)) (add c0 (add c1 (add c2 c3)))))
(defn FormAuthorAltitude () (list "abstraction" "FormAuthorAltitude" (list "T") (list "aar-ends?" "aar-count-suffix" "aar-bound?" "aar-count-bound" "aar-pictures" "aar-cells" "aar-bound" "aar-ppm" "aar-fold" "aar-run" "aar-bit" "aar-check") (list "PicturesDir" "CellsDir" "BindMark") (list "aar-authority") (list "aar-pattern")))
0
