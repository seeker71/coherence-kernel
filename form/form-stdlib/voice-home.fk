; voice-home.fk — the local mouth has crossed from capacity into utterance.
;
; `voice-home=1` means one Form-native, adapter-routed Qwen utterance exists
; on this body.  It is a present-tense state, not a quality score and not an
; audio claim.  Strengthening the voice happens by continuing to speak, fit,
; and listen from here.
;
; Proven by: form-stdlib/tests/voice-home-band.fk
; preludes: form-stdlib/qwen-lora-head.fk

(do
    (defn vhome-sample-path () ".form-qwen-lora-head-sample.txt")
    (defn vhome-local? (artifact utterance)
        (if (and (eq (qlh-whole? artifact) 1)
                 (gt (file_size utterance) 0))
            1 0))
    (defn vhome-now () (vhome-local? (qlh-path) (vhome-sample-path)))
    0)
