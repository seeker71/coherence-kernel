//////////////////////////////////////////////////////////////////////
//
// form-cli-movement.bml
//
// Executable BML. New high-level grammar: the MOVEMENT — a declarative
// table of witnesses the body walks itself. What a rented mind did as
// N tool calls and eyeballs (run band, read tail, compare to declared,
// repeat, summarize) is one row-walk here: a MovementRow names a band
// and its declared verdict; fmv-walk runs each through the runner's own
// door, reads the answering number off the tail, and folds ONE knowing:
// bits of agreement + a count. One command in, one line out — the lift
// ritual embodied, membrane crossings minimized to the walk itself.
//
// preludes: form-stdlib/core.fk form-stdlib/language-model.fk
//
// Proven by: form-stdlib/tests/form-cli-movement-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template MovementRow<TPath> {
        member band: TPath;
        member declared: int;
    }

    class FormMovement {
        thought fmv-pattern = list("declare", "walk", "answer", "fold", "one-knowing");

        def fmv-row(path, declared) = list(path, declared);
        def fmv-digitv(c) = if ge(ord(c), 48) then if le(ord(c), 57) then 1 else 0 else 0;
        def fmv-tail-scan(s, i, acc, live) = if lt(i, 0) then acc else if eq(ord(char_at(s, i)), 10) then if gt(live, 0) then acc else fmv-tail-scan(s, sub(i, 1), acc, 0) else if eq(fmv-digitv(char_at(s, i)), 1) then fmv-tail-scan(s, sub(i, 1), str_concat(char_at(s, i), acc), 1) else fmv-tail-scan(s, sub(i, 1), "", 0);
        def fmv-last-int(s) {
            let d = fmv-tail-scan(s, sub(str_len(s), 1), "", 0);
            if eq(str_len(d), 0) then sub(0, 1) else str_to_int(d);
        }
        def fmv-ask(path) = fmv-last-int(host-exec(str_concat("./fkwu ", path)));
        def fmv-walk(rows, bit, acc) = if eq(len(rows), 0) then acc else fmv-walk(tail(rows), mul(bit, 2), add(acc, if eq(fmv-ask(nth(head(rows), 0)), nth(head(rows), 1)) then bit else 0));
        def fmv-whole(rows) = fmv-walk(rows, 1, 0);
    }
    0;
}
