//////////////////////////////////////////////////////////////////////
//
// form-cli-movement.bml
//
// Executable BML. New high-level grammar: the MOVEMENT — a declarative
// table of witnesses the body walks itself. What a rented mind did as
// N tool calls and eyeballs (run band, read tail, compare to declared,
// repeat, summarize) is one row-walk here: fmv-row names a band
// and its declared verdict; fmv-walk runs each through the runner's own
// door, reads the answering number off the tail, and folds ONE knowing:
// bits of agreement + a count. One command in, one line out — the lift
// ritual embodied, membrane crossings minimized to the walk itself.
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormMovement {
        thought fmv-pattern = ["declare", "walk", "answer", "fold", "one-knowing"];

        def fmv-row(path, declared) = [path, declared];
        def fmv-digitv(c) = if (ord(c) >= 48) then if (ord(c) <= 57) then 1 else 0 else 0;
        def fmv-tail-scan(s, i, acc, live) = if (i < 0) then acc else if ((Comparable) ord(char_at(s, i)) == 10) then if (live > 0) then acc else fmv-tail-scan(s, (i - 1), acc, 0) else if ((Comparable) fmv-digitv(char_at(s, i)) == 1) then fmv-tail-scan(s, (i - 1), str_concat(char_at(s, i), acc), 1) else fmv-tail-scan(s, (i - 1), "", 0);
        def fmv-last-int(s) {
            let d = fmv-tail-scan(s, (str_len(s) - 1), "", 0);
            if ((Comparable) str_len(d) == 0) then (0 - 1) else str_to_int(d);
        }
        def fmv-ask(path) = fmv-last-int(host-exec(str_concat("./fkwu ", path), ""));
        def fmv-walk(rows, bit, acc) = if ((Comparable) len(rows) == 0) then acc else fmv-walk(tail(rows), (bit * 2), (acc + (if ((Comparable) fmv-ask(head(rows)[0]) == head(rows)[1]) then bit else 0)));
        def fmv-whole(rows) = fmv-walk(rows, 1, 0);

        def fmv-field-at(s, marker, at) = if (at < 0) then (0 - 1) else fmv-field-int(s, (at + str_len(marker)), 0, 0);
        def fmv-field-scan(s, marker) = fmv-field-at(s, marker, str_find(s, marker, 0));
        def fmv-field-end(seen, acc) = if (seen > 0) then acc else (0 - 1);
        def fmv-field-int(s, i, acc, seen) = if (i >= str_len(s)) then fmv-field-end(seen, acc) else if ((Comparable) fmv-digitv(char_at(s, i)) == 1) then fmv-field-int(s, (i + 1), ((acc * 10) + (ord(char_at(s, i)) - 48)), 1) else fmv-field-end(seen, acc);
        def fmv-field(out, name) = fmv-field-scan(out, str_concat(name, "="));
        def fmv-ask-field(path, name) = fmv-field(host-exec(str_concat("./fkwu ", path), ""), name);

        def pm-nl() = byte_to_str(10);
        def pm-line(a, b) = str_concat(a, str_concat(b, pm-nl()));
        def pm-menu() = str_concat(pm-line("door 1: walk the six proof bands and answer their folded agreement", ""), str_concat(pm-line("door 2: count the knowledge census sources fresh", ""), str_concat(pm-line("door 3: measure the native answering reach over the whole corpus", ""), str_concat(pm-line("door 4: read the authoring altitude mirror", ""), pm-line("door 5: LAND. you have enough. compose the closing floor report yourself", "")))));
        def pm-door-byte(b) = if (b >= 49) then if (b <= 53) then 1 else 0 else 0;
        def pm-parse-go(s, i, n) = if (i >= n) then 0 else if ((Comparable) pm-door-byte(str_byte_at(s, i)) == 1) then (str_byte_at(s, i) - 48) else pm-parse-go(s, (i + 1), n);
        def pm-parse(s) = pm-parse-go(s, 0, str_len(s));

        // Two carriers write the rented mind's output spend as JSONL rows.
        // A Codex rollout row counts its call-local `last_token_usage`
        // object; a rollout-level `total_token_usage` repeats prior
        // cumulative values and is never summed as a per-call quantity.
        // A Claude Code transcript row carries the assistant message's
        // `usage` and the `requestId` that billed it. That carrier writes one
        // row per content block of a response, each repeating the response's
        // usage, and can re-append earlier rows verbatim, so one request is
        // one spend, counted once. Its usage repeats `output_tokens` inside
        // `iterations`; the first one after `usage` is the response's own.
        def rtm-mark(name) = str_concat(str_concat(byte_to_str(34), name), str_concat(byte_to_str(34), ":"));
        def rtm-output-mark() = rtm-mark("output_tokens");
        def rtm-last-usage-mark() = rtm-mark("last_token_usage");
        def rtm-usage-mark() = rtm-mark("usage");
        def rtm-request-mark() = str_concat(rtm-mark("requestId"), byte_to_str(34));
        def rtm-seen-none() = ",";
        def rtm-seen-key(reqId) = str_concat(",", str_concat(reqId, ","));
        def rtm-row-output(text, markAt, rowEnd) {
            let outAt = str_find(text, rtm-output-mark(), markAt);
            let value = if ((outAt < 0) || (outAt >= rowEnd)) then 0 else fmv-field-int(text, (outAt + str_len(rtm-output-mark())), 0, 0);
            if (value < 0) then 0 else value;
        }
        // The request that billed a transcript row, or "" when the row names
        // none: a carrier-local synthetic message spends nothing.
        def rtm-row-request(text, usageAt, rowEnd) {
            let reqAt = str_find(text, rtm-request-mark(), usageAt);
            let outAt = str_find(text, rtm-output-mark(), usageAt);
            let idAt = (reqAt + str_len(rtm-request-mark()));
            let closeAt = if (reqAt < 0) then (0 - 1) else str_find(text, byte_to_str(34), idAt);
            if ((reqAt < 0) || (reqAt >= rowEnd)) then "" else if ((outAt < 0) || (outAt >= reqAt)) then "" else if ((closeAt < 0) || (closeAt >= rowEnd)) then "" else substring(text, idAt, closeAt);
        }
        def rtm-next-at(text, mark, cached, from) = if ((Comparable) cached == (0 - 1)) then cached else if (cached >= from) then cached else str_find(text, mark, from);
        def rtm-first-at(a, b) = if (a < 0) then b else if (b < 0) then a else if (a < b) then a else b;
        def rtm-rest-at(text, from) {
            let tailAt = (str_len(text) - rtm-over());
            if (from > tailAt) then from else tailAt;
        }
        // One self-recursive scanner walks a slice one whole row at a time
        // and answers list(sum, resume, seen). A row is decided once its
        // newline stands in the slice. A marked row still open stops the walk
        // and resume names its first mark, so the next slice, or the next
        // reading of a growing transcript, starts there and reads the row
        // once, whole. With no open row, resume holds back the last
        // rtm-over() bytes, where a mark may still be cut. The next Codex and
        // transcript mark positions ride along, so each mark is searched once.
        def rtm-scan-go(text, from, codexAt, usageAt, acc, seen) {
            let nextCodex = rtm-next-at(text, rtm-last-usage-mark(), codexAt, from);
            let nextUsage = rtm-next-at(text, rtm-usage-mark(), usageAt, from);
            let rowAt = rtm-first-at(nextCodex, nextUsage);
            let rowEnd = if (rowAt < 0) then (0 - 1) else str_find(text, "\n", rowAt);
            let isCodex = if (rowEnd < 0) then 0 else if (nextCodex < 0) then 0 else if (nextCodex < rowEnd) then 1 else 0;
            let reqId = if (rowEnd < 0) then "" else if ((Comparable) isCodex == 1) then "" else rtm-row-request(text, nextUsage, rowEnd);
            let isFresh = if ((String) reqId == "") then 0 else if (str_find(seen, rtm-seen-key(reqId), 0) >= 0) then 0 else 1;
            let spend = if ((Comparable) isCodex == 1) then rtm-row-output(text, nextCodex, rowEnd) else if ((Comparable) isFresh == 1) then rtm-row-output(text, nextUsage, rowEnd) else 0;
            if (rowAt < 0) then [acc, rtm-rest-at(text, from), seen] else if (rowEnd < 0) then [acc, rowAt, seen] else rtm-scan-go(text, (rowEnd + 1), nextCodex, nextUsage, (acc + spend), if ((Comparable) isFresh == 1) then str_concat(seen, str_concat(reqId, ",")) else seen);
        }
        def rtm-scan(text, acc, seen) = rtm-scan-go(text, 0, (0 - 2), (0 - 2), acc, seen);
        def rtm-sum(text) = rtm-scan(text, 0, rtm-seen-none())[0];
        def rtm-chunk() = 1048576;
        def rtm-over() = 32;
        // The walk answers list(sum, decided-extent, seen). Each slice after
        // the first begins where the previous one stopped deciding rows. The
        // tail call is direct, so a large private rollout retains one slice
        // at a time. Reads stop at the caller's observed extent. A marked row
        // larger than the current slice grows that slice without losing its
        // mark; a row incomplete at the observed extent waits for the next use.
        def rtm-file-go(path, size, off, acc, seen, chunk) {
            let slice = if (off >= size) then "" else read_file_slice(path, off, min2(chunk, (size - off)));
            let scanned = rtm-scan(slice, acc, seen);
            let resumeAt = scanned[1];
            let more = ((off + str_len(slice)) < size) && (str_len(slice) > 0);
            if (more && ((Comparable) resumeAt == 0)) then rtm-file-go(path, size, off, acc, seen, (chunk * 2))
            else if (more && (resumeAt > 0)) then rtm-file-go(path, size, (off + resumeAt), scanned[0], scanned[2], chunk)
            else [scanned[0], (off + resumeAt), scanned[2]];
        }

        // A meter state is caller-bound to one private rollout path. It keeps
        // the byte extent whose rows are decided, their exact cumulative
        // output-token sum, and the transcript requests already counted;
        // a changed path or a shrunk rollout deliberately begins again.
        field RtmStateTag = "form-cli-rented-turn-meter-state-v3";
        def rtm-state-tag() = RtmStateTag();
        def rtm-state(path, extent, total, seen) = [rtm-state-tag(), path, extent, total, seen];
        def rtm-state?(value) = if nothing?(value) then 0 else if (!((Comparable) len(value) == 5)) then 0 else ((String) value[0] == rtm-state-tag());
        def rtm-state-path(value) = value[1];
        def rtm-state-extent(value) = value[2];
        def rtm-state-total(value) = value[3];
        def rtm-state-seen(value) = value[4];
        def rtm-state-text(value) = str_concat(pm-line(rtm-state-tag(), ""), str_concat(pm-line(rtm-state-path(value), ""), str_concat(pm-line(int_to_str(rtm-state-extent(value)), ""), str_concat(pm-line(int_to_str(rtm-state-total(value)), ""), pm-line(rtm-state-seen(value), "")))));
        def rtm-state-from-text(text) {
            let rows = split-on(if nothing?(text) then "" else text, "\n");
            if (len(rows) < 5) then nothing() else if (!((String) rows[0] == rtm-state-tag())) then nothing() else rtm-state(rows[1], str_to_int(rows[2]), str_to_int(rows[3]), rows[4]);
        }
        def rtm-state-current?(value, path, size) = if ((Comparable) rtm-state?(value) == 0) then 0 else if (!((String) rtm-state-path(value) == path)) then 0 else if (rtm-state-extent(value) > size) then 0 else 1;
        def rtm-state-scan-start(value, path, size) = if ((Comparable) rtm-state-current?(value, path, size) == 1) then rtm-state-extent(value) else 0;
        def rtm-state-base-total(value, path, size) = if ((Comparable) rtm-state-current?(value, path, size) == 1) then rtm-state-total(value) else 0;
        def rtm-state-base-seen(value, path, size) = if ((Comparable) rtm-state-current?(value, path, size) == 1) then rtm-state-seen(value) else rtm-seen-none();
    }
    0;
}
