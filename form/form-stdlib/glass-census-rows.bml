//////////////////////////////////////////////////////////////////////
//
// glass-census-rows.bml — the kernel census on the glass, as its organs speak
// it.
//
// Urs, 2026-09-11: "being aware of what is running for what is vital", and at
// midday, "release bands and turn them into live organ events instead". The
// roster organ (kernel-roster.bml) and the pages organ (kernel-pages.bml) speak
// the census as organ-health readings; this unit turns each reading into one
// glass row, and the sensors organ (observe/form-glass-sensors-live.fk) gives
// those rows as the census frame every ten seconds:
//
//   census.kernel-roster.<aspect>   untracked, stale, orphans, errands, unpaged
//   census.kernel-pages.<aspect>    exit-burial, killed-pages, living-pages
//
// A row's value is how many the reading observed, and its note names the need
// with the pids it names, or "none". A reading over a read that did not answer
// is an unavailable row whose door is that read (page-read, roster-read,
// host-process-read, owner-walk). The rows are in the kernel domain, so the
// glass's kernel view shows them beside its live kernels.
//
// A tick takes the census once (about 35 ms, and 33 ms for the pages, on
// 2026-09-11) and settles it against the take before it, a tick apart, so a
// kernel is named only when two takes agree. The first tick has nothing to
// settle against and gives nothing; the glass shows the frame absent until the
// second.
//
// The rows carry pids and counts only, no process names and no command
// arguments, so they stand inside the observer's ProcessPrivacyRule
// (form-glass-observer.bml). What each kernel runs, and for whom, stays in the
// census's own lines.
//
// preludes: form/form-stdlib/kernel-roster.bml form/form-stdlib/kernel-pages.bml form/form-stdlib/form-glass-observer.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class GlassCensusRows {
        field GCRCadenceMs = 10000;
        // one take of both organs' reads: (census-take pages-take)
        def gcr-take() = list(rce-take(), kpg-take());
        // two takes a tick apart, settled, as both organs' readings
        def gcr-readings(prev, cur) = append(krs-readings(rce-settle(nth(prev, 0), nth(cur, 0))), kpg-readings(kpg-settle(nth(prev, 1), nth(cur, 1))));
        def gcr-ints-text(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then int_to_str(head(xs)) else str_concat(int_to_str(head(xs)), str_concat(",", gcr-ints-text(tail(xs))));
        def gcr-need-text(need) = str_concat(oh-str(need, "resource"), str_concat(": ", gcr-ints-text(oh-int-values(json-array-elements(oh-get(need, "detail"))))));
        def gcr-note(r) = if nil?(json-array-elements(oh-get(r, "needs"))) then "none" else gcr-need-text(oc-first-need(r));
        def gcr-id(r) = str_concat("census.", str_concat(oh-str(r, "organ"), str_concat(".", oh-str(r, "aspect"))));
        def gcr-label(r) = str_concat(oh-str(r, "organ"), str_concat(" ", oh-str(r, "aspect")));
        def gcr-unit(r) = if str_eq(oh-str(r, "organ"), "kernel-pages") then "pages" else "kernels";
        // a measured reading is its count; one over a read that did not answer is unavailable, its door that read
        def gcr-row(r) = if node_eq(oh-get(r, "health"), json-node-null()) then fgo-unavailable("kernel", gcr-id(r), gcr-label(r), gcr-unit(r), "cpu-arena", oh-str(oc-first-need(r), "resource"), "census", gcr-note(r)) else fgo-int("kernel", gcr-id(r), gcr-label(r), json-int-value(oh-get(r, "observed")), gcr-unit(r), 0, "cpu-arena", "physical-live", str_concat("organ-health:", oh-str(r, "organ")), "live", "census", gcr-note(r));
        def gcr-rows-of(readings) = if nil?(readings) then list() else cons(gcr-row(head(readings)), gcr-rows-of(tail(readings)));
        def gcr-rows(prev, cur) = gcr-rows-of(gcr-readings(prev, cur));
    }
    0;
}
