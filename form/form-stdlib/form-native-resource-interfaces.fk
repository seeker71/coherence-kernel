// form-native-resource-interfaces.fk — class-based Form-native resource interfaces
// wired to per-platform implementations. Runtime proof and receipt path is fkwu-only;
// no Go kernel emission for interface resolution or sovereignty knowledge lookup.
//
// preludes: form-stdlib/core.fk form-stdlib/resource-port.fk form-stdlib/bml-native-interface-package-import.fk form-stdlib/hati-os-targets.fk
//
section [form.bml] {
    def fnri-source() = bnii-source("form", "form/form-stdlib/form-native-resource-interfaces.fk", 1);
    def fnri-runtime() = "fkwu";
    def fnri-no-go-emission?() = 1;
    def fnri-primary-targets() = ["macos-arm64", "android-arm64", "windows-arm64"];
    // port slugs defer intern_node until lookup — friendlier to fkwu flatten tables
    def fnri-port-by-slug(slug) = (String) slug == "afferent-bytes" ? afferent-bytes() : (String) slug == "efferent-bytes" ? efferent-bytes() : (String) slug == "afferent-scalar" ? afferent-scalar() : (String) slug == "efferent-text" ? efferent-text() : (String) slug == "afferent-pixel" ? afferent-pixel() : (String) slug == "efferent-pixel" ? efferent-pixel() : afferent-bytes();
    // class row stores sense/act port slugs (strings), not port nodes
    def fnri-class(protocol, capability, sense-slug, act-slug, members, interface-name) = [protocol, capability, sense-slug, act-slug, members, interface-name];
    def fnri-class-protocol(row) = row[0];
    def fnri-class-capability(row) = row[1];
    def fnri-class-sense-slug(row) = row[2];
    def fnri-class-act-slug(row) = row[3];
    def fnri-class-sense-port(row) = fnri-port-by-slug(fnri-class-sense-slug(row));
    def fnri-class-act-port(row) = fnri-port-by-slug(fnri-class-act-slug(row));
    def fnri-class-members(row) = row[4];
    def fnri-class-interface-name(row) = row[5];
    def fnri-classes() = [fnri-class("host:process", "cap.host.process", "afferent-bytes", "efferent-text", ["Snapshot", "List"], "HostProcess"), fnri-class("host:usage", "cap.host.usage", "afferent-scalar", "efferent-text", ["Sample", "Pressure"], "HostUsage"), fnri-class("audio:pcm16", "cap.audio.sample", "afferent-bytes", "efferent-bytes", ["Capture", "Play"], "AudioPcm16"), fnri-class("video:rgba-time", "cap.video.frame", "afferent-pixel", "efferent-pixel", ["CaptureFrame", "PresentFrame"], "VideoRgbaTime"), fnri-class("sensor:signal", "cap.sensor.read", "afferent-scalar", "efferent-text", ["Read", "Subscribe"], "SensorSignal"), fnri-class("gpu:compute", "cap.compute.gpu", "afferent-bytes", "efferent-bytes", ["Dispatch", "Pressure"], "GpuCompute"), fnri-class("dsp:signal", "cap.compute.dsp", "afferent-bytes", "efferent-bytes", ["Transform", "Measure"], "DspSignal"), fnri-class("mlx:array", "cap.compute.mlx", "afferent-bytes", "efferent-bytes", ["Eval", "Materialize"], "MlxArray"), fnri-class("host:file", "cap.host.file", "afferent-bytes", "efferent-bytes", ["Read", "Write", "Stat"], "HostFile"), fnri-class("http:request", "cap.network.http", "afferent-bytes", "efferent-bytes", ["Get", "Post"], "HttpRequest")];
    def fnri-find-class(protocol, rows) = (Comparable) len(rows) == 0 ? fnri-class("", "", "afferent-bytes", "efferent-bytes", [], "") : (String) fnri-class-protocol(head(rows)) == protocol ? head(rows) : fnri-find-class(protocol, tail(rows));
    def fnri-class-for(protocol) = fnri-find-class(protocol, fnri-classes());
    def fnri-interface-for-class(class-row) = bnii-interface(fnri-class-interface-name(class-row), "HostResource", fnri-class-members(class-row), fnri-class-sense-port(class-row), fnri-source());
    def fnri-interface-for(protocol) = fnri-interface-for-class(fnri-class-for(protocol));
    // --- host-io dispatch: protocol -> native op family (fkwu table, no Go registerNative) ---
    def fnri-dispatch(protocol, sense-op, act-op, carrier) = [protocol, sense-op, act-op, carrier];
    def fnri-dispatch-protocol(row) = row[0];
    def fnri-dispatch-sense-op(row) = row[1];
    def fnri-dispatch-act-op(row) = row[2];
    def fnri-dispatch-carrier(row) = row[3];
    def fnri-dispatches() = [fnri-dispatch("host:process", "read_file", "write_file", "filesystem"), fnri-dispatch("host:usage", "read_file", "write_file", "filesystem"), fnri-dispatch("audio:pcm16", "read_file", "write_file", "filesystem"), fnri-dispatch("video:rgba-time", "read_file", "write_file", "filesystem"), fnri-dispatch("sensor:signal", "read_file", "write_file", "filesystem"), fnri-dispatch("gpu:compute", "read_file", "write_file", "host-kernel"), fnri-dispatch("dsp:signal", "read_file", "write_file", "filesystem"), fnri-dispatch("mlx:array", "read_file", "write_file", "filesystem"), fnri-dispatch("host:file", "read_file", "write_file", "filesystem"), fnri-dispatch("http:request", "socket_connect", "socket_send", "http-socket")];
    def fnri-find-dispatch(protocol, rows) = (Comparable) len(rows) == 0 ? fnri-dispatch("", "", "", "") : (String) fnri-dispatch-protocol(head(rows)) == protocol ? head(rows) : fnri-find-dispatch(protocol, tail(rows));
    def fnri-dispatch-for(protocol) = fnri-find-dispatch(protocol, fnri-dispatches());
    def fnri-binding(target, protocol) = [target, protocol, hos-impl-for(target, protocol), fnri-class-for(protocol), fnri-dispatch-for(protocol)];
    def fnri-binding-target(row) = row[0];
    def fnri-binding-protocol(row) = row[1];
    def fnri-binding-impl(row) = row[2];
    def fnri-binding-class(row) = row[3];
    def fnri-binding-dispatch(row) = row[4];
    def fnri-bindings-for(target) = [fnri-binding(target, "host:process"), fnri-binding(target, "host:usage"), fnri-binding(target, "audio:pcm16"), fnri-binding(target, "video:rgba-time"), fnri-binding(target, "sensor:signal"), fnri-binding(target, "gpu:compute"), fnri-binding(target, "dsp:signal"), fnri-binding(target, "mlx:array"), fnri-binding(target, "host:file"), fnri-binding(target, "http:request")];
    def fnri-count-bindings(rows) = len(rows);
    def fnri-resolve(target, protocol) = [fnri-interface-for(protocol), hos-impl-for(target, protocol), fnri-dispatch-for(protocol), fnri-runtime(), fnri-no-go-emission?()];
    def fnri-resolve-interface(resolved) = resolved[0];
    def fnri-resolve-impl(resolved) = resolved[1];
    def fnri-resolve-dispatch(resolved) = resolved[2];
    def fnri-resolve-runtime(resolved) = resolved[3];
    def fnri-knowledge(slug, path, query-kind) = [slug, path, query-kind];
    def fnri-knowledge-slug(row) = row[0];
    def fnri-knowledge-path(row) = row[1];
    def fnri-knowledge-kind(row) = row[2];
    def fnri-knowledge-cells() = [fnri-knowledge("form-native-resource-interfaces", "form/form-stdlib/form-native-resource-interfaces.fk", "structural"), fnri-knowledge("resource-port", "form/form-stdlib/resource-port.fk", "structural"), fnri-knowledge("hati-os-targets", "form/form-stdlib/hati-os-targets.fk", "structural"), fnri-knowledge("host-kernel", "axioms/host-kernel.form", "structural"), fnri-knowledge("standard-receipt", "teachings/standard-receipt.form", "structural"), fnri-knowledge("form-first-reasoning", "teachings/form-first-reasoning.form", "structural"), fnri-knowledge("bml-native-interface", "form/form-stdlib/bml-native-interface-package-import.fk", "structural"), fnri-knowledge("http-client", "form/form-stdlib/http-client.bml", "structural"), fnri-knowledge("form-fs", "form/form-stdlib/form-fs.fk", "structural"), fnri-knowledge("host-filesystem", "form/form-stdlib/host-filesystem.bml", "structural")];
    def fnri-find-knowledge(slug, rows) = (Comparable) len(rows) == 0 ? fnri-knowledge("", "", "") : (String) fnri-knowledge-slug(head(rows)) == slug ? head(rows) : fnri-find-knowledge(slug, tail(rows));
    def fnri-knowledge-for(slug) = fnri-find-knowledge(slug, fnri-knowledge-cells());
    def fnri-capability-matches?(class-row, impl-row) = (String) fnri-class-capability(class-row) == hos-impl-capability(impl-row) ? 1 : 0;
    // --- witness verdict (shared by proof band, fkwu_run.sh, and form-cli fnri) ---
    def fnri-witness-verdict() = {
        let c0 = (Comparable) len(fnri-classes()) == 10 ? 1 : 0;
        let c1 = (String) fnri-runtime() == "fkwu" ? (Comparable) fnri-no-go-emission?() == 1 ? 2 : 0 : 0;
        let mac-bindings = fnri-bindings-for("macos-arm64");
        let c2 = (Comparable) fnri-count-bindings(mac-bindings) == 10 ? 4 : 0;
        let android-bindings = fnri-bindings-for("android-arm64");
        let c3 = (Comparable) fnri-count-bindings(android-bindings) == 10 ? 8 : 0;
        let win-bindings = fnri-bindings-for("windows-arm64");
        let c4 = (Comparable) fnri-count-bindings(win-bindings) == 10 ? 16 : 0;
        let mac-resolved = fnri-resolve("macos-arm64", "host:process");
        let mac-iface = fnri-resolve-interface(mac-resolved);
        let mac-impl = fnri-resolve-impl(mac-resolved);
        let mac-dispatch = fnri-resolve-dispatch(mac-resolved);
        let c5 = (Comparable) bnii-interface?(mac-iface) == 1 ? (String) bnii-interface-name(mac-iface) == "HostProcess" ? (String) hos-impl-implementation(mac-impl) == "libproc+sysctl+proc_pidinfo" ? (String) fnri-dispatch-sense-op(mac-dispatch) == "read_file" ? 32 : 0 : 0 : 0 : 0;
        let audio-class = fnri-class-for("audio:pcm16");
        let c6 = (String) fnri-class-protocol(audio-class) == "audio:pcm16" ? (String) fnri-class-sense-slug(audio-class) == "afferent-bytes" ? 64 : 0 : 0;
        let android-resolved = fnri-resolve("android-arm64", "sensor:signal");
        let android-impl = fnri-resolve-impl(android-resolved);
        let c7 = (String) hos-impl-implementation(android-impl) == "SensorManager+LocationManager+GNSS-permission-gated" ? 128 : 0;
        let win-resolved = fnri-resolve("windows-arm64", "gpu:compute");
        let win-impl = fnri-resolve-impl(win-resolved);
        let c8 = (String) hos-impl-capability(win-impl) == "cap.compute.gpu" ? 256 : 0;
        let know = fnri-knowledge-for("form-native-resource-interfaces");
        let receipt = fnri-knowledge-for("standard-receipt");
        let c9 = (String) fnri-knowledge-path(know) == "form/form-stdlib/form-native-resource-interfaces.fk" ? (String) fnri-knowledge-kind(receipt) == "structural" ? 512 : 0 : 0;
        let targets = fnri-primary-targets();
        let c10 = (Comparable) len(targets) == 3 ? (String) head(targets) == "macos-arm64" ? 1024 : 0 : 0;
        let mlx-android = hos-impl-for("android-arm64", "mlx:array");
        let mlx-class = fnri-class-for("mlx:array");
        let c11 = (Comparable) fnri-capability-matches?(mlx-class, mlx-android) == 1 ? (String) hos-impl-implementation(mlx-android) == "unsupported-on-android" ? 2048 : 0 : 0;
        let dispatches = fnri-dispatches();
        let c12 = (Comparable) len(dispatches) == 10 ? (String) fnri-dispatch-carrier(fnri-dispatch-for("host:process")) == "filesystem" ? 4096 : 0 : 0;
        let file-resolved = fnri-resolve("macos-arm64", "host:file");
        let file-iface = fnri-resolve-interface(file-resolved);
        let file-dispatch = fnri-resolve-dispatch(file-resolved);
        let c13 = (String) bnii-interface-name(file-iface) == "HostFile" ? (String) fnri-dispatch-sense-op(file-dispatch) == "read_file" ? 8192 : 0 : 0;
        let http-resolved = fnri-resolve("android-arm64", "http:request");
        let http-iface = fnri-resolve-interface(http-resolved);
        let http-dispatch = fnri-resolve-dispatch(http-resolved);
        let c14 = (String) bnii-interface-name(http-iface) == "HttpRequest" ? (String) fnri-dispatch-carrier(http-dispatch) == "http-socket" ? 16384 : 0 : 0;
        sum([c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14]);
    };
    def fnri-witness-str() = int_to_str(fnri-witness-verdict());
    // fkwu band output coerces bare nth strings to ints — str_concat forces string carrier
    def fnri-know-line(slug) = str_concat("", fnri-knowledge-path(fnri-knowledge-for(slug)));
    def fnri-knowledge-line(slug) = {
        let k = fnri-knowledge-for(slug);
        str_concat(fnri-knowledge-slug(k), str_concat(":", str_concat("", fnri-knowledge-path(k))));
    };
    def fnri-resolve-line(target, protocol) = {
        let impl = fnri-resolve-impl(fnri-resolve(target, protocol));
        let disp = fnri-resolve-dispatch(fnri-resolve(target, protocol));
        str_concat(target, str_concat("|", str_concat(protocol, str_concat("|", str_concat(hos-impl-implementation(impl), str_concat("|", str_concat(fnri-dispatch-sense-op(disp), str_concat("|", fnri-dispatch-carrier(disp)))))))));
    };
    0;
}
