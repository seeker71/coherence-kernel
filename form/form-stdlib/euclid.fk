; euclid.fk — existing plane geometry in native Form.
;
; Integer coordinates. Distance is kept squared so 3-4-5 is exact: 9+16=25.
; Inverse-square falloff is k / r², nothing at r=0. Not a cosmology.
;
; witnessed: 2026-09-10 -> native-science-band 127
; preludes: form-stdlib/core.fk

(do
    (defn eu-point (x y) (list x y))
    (defn eu-x (p) (nth p 0))
    (defn eu-y (p) (nth p 1))
    (defn eu-sq (n) (mul n n))
    (defn eu-dist2 (a b)
        (add (eu-sq (sub (eu-x a) (eu-x b)))
             (eu-sq (sub (eu-y a) (eu-y b)))))
    (defn eu-right? (a b c)
        (eq (add (eu-sq a) (eu-sq b)) (eu-sq c)))
    (defn eu-area-right (a b) (div (mul a b) 2))
    (defn eu-inv-sq (k r)
        (if (eq r 0) (nothing) (div k (eu-sq r))))
    0)
