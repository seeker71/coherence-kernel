// speaker-embed.fk — the nearest-by-cosine DECISION over the oracle's NEURAL voice embeddings (the body). The embedding quality is the ECAPA oracle's; this proves the recognition decision over it.
//
// A crude formant voiceprint can't part two similar voices. This is the
// best recognizer we can build: it matches over the embedding of the best LOCAL oracle —
// an ECAPA-TDNN speaker model (SpeechBrain) that maps a voice to a 192-d vector where same-
// speaker vectors point the same way and different speakers point apart. The carrier
// runs that oracle and L2-normalizes + quantizes the
// embedding to ints; EVERY recognition decision is HERE.
//
// Metric: cosine similarity. Because the carrier L2-normalizes both vectors, cosine is just
// their dot product — nearest speaker = the roster vector with the MAX dot. A floor on that
// max returns "unknown" rather than forcing every window onto someone.
//
// Builtins only (mul/add/gt/ge/nth/head/tail/len).
section [form.bml] {
    def sp-name(s) = s[0];
    // roster cell = (name embedding-vector)
    def sp-vec(s) = s[1];
    // integer dot product over two equal-length quantized unit vectors = cosine·scale²
    def se-dot(a, b) = (Comparable) len(a) == 0 ? 0 : head(a) * head(b) + se-dot(tail(a), tail(b));
    // nearest speaker cell by MAX dot (most-aligned voice)
    def se-best(q, roster, best, bestsim) = (Comparable) len(roster) == 0 ? best : {
        let s = se-dot(q, sp-vec(head(roster)));
        s > bestsim ? se-best(q, tail(roster), head(roster), s) : se-best(q, tail(roster), best, bestsim);
    };
    def se-nearest(q, roster) = se-best(q, tail(roster), head(roster), se-dot(q, sp-vec(head(roster))));
    // the similarity behind the call (cosine·scale²) and the margin over the runner-up
    def se-sim(q, roster) = se-dot(q, sp-vec(se-nearest(q, roster)));
    // max dot EXCLUDING the winner — the FIXED top is threaded down so the skip is stable
    def se-second-loop(q, roster, top) = (Comparable) len(roster) == 0 ? 0 : {
        let s = se-dot(q, sp-vec(head(roster)));
        (Comparable) s == top ? se-second-loop(q, tail(roster), top) :         // skip the winner
s > se-second-loop(q, tail(roster), top) ? s : se-second-loop(q, tail(roster), top);
    };
    def se-second(q, roster) = se-second-loop(q, roster, se-sim(q, roster));
    // the call: nearest speaker's name, but only if it clears the floor AND beats the
    // runner-up by a margin — else "unknown" (honest no-match instead of a forced guess)
    def se-name(q, roster) = sp-name(se-nearest(q, roster));
    def se-confident?(q, roster, floor, margin) = {
        let top = se-sim(q, roster);
        let snd = se-second(q, roster);
        top >= floor ? top - snd >= margin ? 1 : 0 : 0;
    };
}
