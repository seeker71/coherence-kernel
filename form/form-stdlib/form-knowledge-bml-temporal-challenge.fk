; form-knowledge-bml-temporal-challenge.fk -- prompt and hidden native-source
; judge derived only after the temporal family was frozen and landed.
;
; The prompt names lifecycle semantics but never includes the frozen cases,
; source paths, hashes, or prior 59cb surfaces. Candidate BML is parsed by the
; canonical grammar, structurally admitted to exactly two pure functions, and
; lowered to ordinary Form source for inspection while the hidden calls execute
; directly over the admitted BMF AST in this resident Form context. This uses no
; fef operation table, flattening, HTTP, remote model, llama-server, generated
; registry, file materialization, shell, or child `fkwu`.
;
; Exact score 1023 acks one. Observed exit 0 with another score acks zero.
; Missing source/currentness/write/exit evidence acks nothing. The resident
; session therefore cuts, refines, or holds through three mechanically
; different moves.
;
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-knowledge-bml-temporal-witness-freeze.fk
; preludes: form-stdlib/form-bml-prefix-choice.fk

(defn fktwt-version () "form-bml-temporal-challenge-v1")
    (defn fktwt-score-all () 1023)
    (defn fktwt-execution-surface () "resident-form-bmf-ast")
    (defn fktwt-process-crossings () 0)
    (defn fktwt-network-crossings () 0)

    (defn fktwt-prompt ()
        (fked-cat (list
            "Return only one complete bounded form.bml section body. "
            "No prose, Markdown fence, import, bracket, colon, or return syntax. "
            "Define exactly these two pure functions and finish with the structural final statement 0;. "
            "fktw-verify(answered,value,when,deadline) returns 1 only for a timely answered value 1, returns 0 for a timely answered value 0, and returns sub(0,1) when unanswered or late. Timely includes equality with the deadline. "
            "fktw-stream(frame-present,kind,ack,elapsed,timeout) interprets an explicit frame before silence: with no frame it returns 0 before timeout and 4 at or after timeout; with a frame, kind 1 is stop and returns 1 when acknowledged or 6 when unacknowledged, kind 2 is handoff and returns 2 when acknowledged or 6 when unacknowledged, kind 4 returns 3 for offline, kind 5 returns 5 for explicit nothing, and other kinds return 0. An explicit frame wins over elapsed timeout. "
            "Use call-form primitives, BML if/then/else, and integers only.")))
    (defn fktwt-prompt-sha () (nmfe-sha256 (fktwt-prompt)))
    (defn fktwt-prompt-derived-after-freeze? ()
        (if (and (eq (fktwf-frozen-at) 20260826)
                 (eq (fktwf-sources-current?) 1)) 1 0))

    (defn fktwt-string-member? (needle values)
        (if (nil? values) 0
            (if (str_eq needle (head values)) 1
                (fktwt-string-member? needle (tail values)))))
    (defn fktwt-prompt-holds-bans? (bans)
        (if (nil? bans) 1
            (if (lt (str_find (fktwt-prompt) (head bans) 0) 0)
                (fktwt-prompt-holds-bans? (tail bans)) 0)))

    (defn fktwt-node-is? (node name) (fcbpc-ast-is? node name))
    (defn fktwt-ident-name (node)
        (node_value (nth (node_children node) 0)))
    (defn fktwt-param-names (fndef)
        (node_children (nth (node_children fndef) 1)))
    (defn fktwt-param-name-values (nodes)
        (if (nil? nodes) (empty)
            (cons (node_value (head nodes))
                (fktwt-param-name-values (tail nodes)))))
    (defn fktwt-names-exact? (actual expected)
        (if (nil? actual) (if (nil? expected) 1 0)
            (if (nil? expected) 0
                (if (str_eq (head actual) (head expected))
                    (fktwt-names-exact? (tail actual) (tail expected)) 0))))
    (defn fktwt-fndef-name (fndef)
        (node_value (nth (node_children fndef) 0)))
    (defn fktwt-fndef-body (fndef) (nth (node_children fndef) 2))

    ; This is an admission boundary, not an operation dispatcher. The child
    ; fkwu executes the admitted Form; these names only prevent model-authored
    ; source from reaching effects or unrelated calls.
    (defn fktwt-pure-call? (name arity)
        (if (and (str_eq name "not") (eq arity 1)) 1
        (if (and (str_eq name "eq") (eq arity 2)) 1
        (if (and (str_eq name "ne") (eq arity 2)) 1
        (if (and (str_eq name "le") (eq arity 2)) 1
        (if (and (str_eq name "lt") (eq arity 2)) 1
        (if (and (str_eq name "ge") (eq arity 2)) 1
        (if (and (str_eq name "gt") (eq arity 2)) 1
        (if (and (str_eq name "and") (eq arity 2)) 1
        (if (and (str_eq name "or") (eq arity 2)) 1
        (if (and (str_eq name "sub") (eq arity 2)) 1 0)))))))))))
    (defn fktwt-expr-safe? (node params)
        (do
            (let kids (node_children node))
            (if (nil? kids)
                (if (or (eq (node_type node) 1)
                        (eq (node_type node) 3)) 1 0)
            (if (eq (fktwt-node-is? node "ident") 1)
                (fktwt-string-member? (fktwt-ident-name node) params)
            (if (eq (fktwt-node-is? node "if") 1)
                (if (and (eq (len kids) 3)
                         (and (eq (fktwt-expr-safe? (nth kids 0) params) 1)
                         (and (eq (fktwt-expr-safe? (nth kids 1) params) 1)
                              (eq (fktwt-expr-safe? (nth kids 2) params) 1)))) 1 0)
            (if (eq (fktwt-node-is? node "fncall") 1)
                (do
                    (let callee (head kids))
                    (let args (tail kids))
                    (if (not (eq (fktwt-node-is? callee "ident") 1)) 0
                        (if (not (eq (fktwt-pure-call?
                                (fktwt-ident-name callee) (len args)) 1)) 0
                            (if (eq (len args) 1)
                                (fktwt-expr-safe? (nth args 0) params)
                                (if (and
                                    (eq (fktwt-expr-safe? (nth args 0) params) 1)
                                    (eq (fktwt-expr-safe? (nth args 1) params) 1))
                                    1 0)))))
                0))))))
    (defn fktwt-fndef-safe? (node expected-name expected-params)
        (if (not (eq (fktwt-node-is? node "fndef") 1)) 0
            (do
                (let params (fktwt-param-name-values
                    (fktwt-param-names node)))
                (if (and (str_eq (fktwt-fndef-name node) expected-name)
                         (and (eq (fktwt-names-exact? params expected-params) 1)
                              (eq (fktwt-expr-safe?
                                  (fktwt-fndef-body node) params) 1))) 1 0))))
    (defn fktwt-candidate-safe? (raw)
        (do
            (let ast (g-parse-full (form-bml-section-grammar) raw))
            (if (str_eq (node_value ast) "PARSE-FAIL") 0
            (if (not (eq (fcbpc-final-zero-ast? ast) 1)) 0
                (do
                    (let kids (node_children ast))
                    (if (not (eq (len kids) 3)) 0
                        (if (not (eq (fktwt-fndef-safe? (nth kids 0)
                            "fktw-verify"
                            (list "answered" "value" "when" "deadline")) 1)) 0
                            (fktwt-fndef-safe? (nth kids 1)
                                "fktw-stream"
                                (list "frame-present" "kind" "ack"
                                    "elapsed" "timeout")))))))))

    (defn fktwt-int-source (value)
        (if (lt value 0)
            (str_concat "(sub 0 "
                (str_concat (int_to_str (sub 0 value)) ")"))
            (int_to_str value)))
    (defn fktwt-args-source (args)
        (if (nil? args) ""
            (str_concat " " (str_concat (fktwt-int-source (head args))
                (fktwt-args-source (tail args))))))
    (defn fktwt-case-source (row bit)
        (str_concat "(if (eq ("
        (str_concat (if (str_eq (fktwf-case-family row) "verify")
            "fktw-verify" "fktw-stream")
        (str_concat (fktwt-args-source (fktwf-case-args row))
        (str_concat ") "
        (str_concat (fktwt-int-source (fktwf-case-expected row))
        (str_concat ") "
        (str_concat (int_to_str bit) " 0)"))))))))
    (defn fktwt-cases-source (rows bit)
        (if (nil? rows) "0"
            (if (nil? (tail rows))
                (fktwt-case-source (head rows) bit)
                (str_concat "(add "
                (str_concat (fktwt-case-source (head rows) bit)
                (str_concat " "
                (str_concat (fktwt-cases-source (tail rows) (mul bit 2))
                    ")")))))))
    (defn fktwt-score-source ()
        (fktwt-cases-source (fktwf-cases) 1))
    (defn fktwt-eval-source (raw)
        (if (not (eq (fktwt-candidate-safe? raw) 1)) (nothing)
            (do
                (let body (fkegt-form-body raw (fcbpc-default-material-cap)))
                (if (nothing? body) (nothing)
                    (str_concat "(do\n"
                    (str_concat (substring body 0 (sub (str_len body) 2))
                    (str_concat "\n" (str_concat
                        (fktwt-score-source) "\n)"))))))))

    ; Evaluation result keeps absence separate from every integer, including 0.
    ; result = schema present value reason
    (defn fktwt-value (present value reason)
        (list "form-bml-temporal-value-v1" present value reason))
    (defn fktwt-value-one (value) (fktwt-value 1 value ""))
    (defn fktwt-value-nothing (reason) (fktwt-value 0 0 reason))
    (defn fktwt-value-present? (v) (nth v 1))
    (defn fktwt-value-int (v) (nth v 2))
    (defn fktwt-value-reason (v) (nth v 3))

    ; env rows are (parameter-name integer). Candidate names have already been
    ; checked against the exact function parameter lists before this point.
    (defn fktwt-env-bind (params args)
        (if (nil? params) (empty)
            (cons (list (node_value (head params)) (head args))
                (fktwt-env-bind (tail params) (tail args)))))
    (defn fktwt-env-get (env name)
        (if (nil? env) (fktwt-value-nothing "unbound-identifier")
            (if (str_eq (nth (head env) 0) name)
                (fktwt-value-one (nth (head env) 1))
                (fktwt-env-get (tail env) name))))

    ; The same admitted call family is applied structurally. This is a bounded
    ; thought-kernel evaluator, not a general Form operation table.
    (defn fktwt-apply-one (name a)
        (if (str_eq name "not")
            (fktwt-value-one (if (eq a 0) 1 0))
            (fktwt-value-nothing "unsupported-unary-call")))
    (defn fktwt-apply-two (name a b)
        (if (str_eq name "eq") (fktwt-value-one (if (eq a b) 1 0))
        (if (str_eq name "ne") (fktwt-value-one (if (eq a b) 0 1))
        (if (str_eq name "le") (fktwt-value-one (if (le a b) 1 0))
        (if (str_eq name "lt") (fktwt-value-one (if (lt a b) 1 0))
        (if (str_eq name "ge") (fktwt-value-one (if (ge a b) 1 0))
        (if (str_eq name "gt") (fktwt-value-one (if (gt a b) 1 0))
        (if (str_eq name "and")
            (fktwt-value-one (if (and (not (eq a 0)) (not (eq b 0))) 1 0))
        (if (str_eq name "or")
            (fktwt-value-one (if (or (not (eq a 0)) (not (eq b 0))) 1 0))
        (if (str_eq name "sub") (fktwt-value-one (sub a b))
            (fktwt-value-nothing "unsupported-binary-call")))))))))))

    (defn fktwt-eval-call (node env)
        (do
            (let kids (node_children node))
            (let name (fktwt-ident-name (head kids)))
            (let args (tail kids))
            (let a (fktwt-eval-expr (head args) env))
            (if (not (eq (fktwt-value-present? a) 1)) a
                (if (eq (len args) 1)
                    (fktwt-apply-one name (fktwt-value-int a))
                    (do
                        (let b (fktwt-eval-expr (nth args 1) env))
                        (if (not (eq (fktwt-value-present? b) 1)) b
                            (fktwt-apply-two name (fktwt-value-int a)
                                (fktwt-value-int b))))))))
    (defn fktwt-eval-if (node env)
        (do
            (let kids (node_children node))
            (let condition (fktwt-eval-expr (nth kids 0) env))
            (if (not (eq (fktwt-value-present? condition) 1)) condition
                (if (eq (fktwt-value-int condition) 0)
                    (fktwt-eval-expr (nth kids 2) env)
                    (fktwt-eval-expr (nth kids 1) env)))))
    (defn fktwt-eval-expr (node env)
        (do
            (let kids (node_children node))
            (if (nil? kids)
                (if (or (eq (node_type node) 1) (eq (node_type node) 3))
                    (fktwt-value-one (node_value node))
                    (fktwt-value-nothing "unsupported-leaf"))
            (if (eq (fktwt-node-is? node "ident") 1)
                (fktwt-env-get env (fktwt-ident-name node))
            (if (eq (fktwt-node-is? node "if") 1)
                (fktwt-eval-if node env)
            (if (eq (fktwt-node-is? node "fncall") 1)
                (fktwt-eval-call node env)
                (fktwt-value-nothing "unsupported-expression")))))))
    (defn fktwt-eval-fndef (fndef args)
        (fktwt-eval-expr (fktwt-fndef-body fndef)
            (fktwt-env-bind (fktwt-param-names fndef) args)))
    (defn fktwt-case-value (row bit verify-fn stream-fn)
        (do
            (let answer (fktwt-eval-fndef
                (if (str_eq (fktwf-case-family row) "verify")
                    verify-fn stream-fn)
                (fktwf-case-args row)))
            (if (not (eq (fktwt-value-present? answer) 1)) answer
                (fktwt-value-one
                    (if (eq (fktwt-value-int answer)
                            (fktwf-case-expected row)) bit 0)))))
    (defn fktwt-score-native-go (rows bit verify-fn stream-fn score)
        (if (nil? rows) (fktwt-value-one score)
            (do
                (let value (fktwt-case-value (head rows) bit
                    verify-fn stream-fn))
                (if (not (eq (fktwt-value-present? value) 1)) value
                    (fktwt-score-native-go (tail rows) (mul bit 2)
                        verify-fn stream-fn
                        (add score (fktwt-value-int value)))))))
    (defn fktwt-native-score (raw)
        (if (not (eq (fktwt-candidate-safe? raw) 1))
            (fktwt-value-nothing "candidate-not-admitted")
            (do
                (let ast (g-parse-full (form-bml-section-grammar) raw))
                (let kids (node_children ast))
                (fktwt-score-native-go (fktwf-cases) 1
                    (nth kids 0) (nth kids 1) 0))))

    (defn fktwt-judge (raw)
        (if (not (eq (fktwt-prompt-derived-after-freeze?) 1)) (oac-nothing)
        (if (not (eq (fktwt-candidate-safe? raw) 1)) (oac-zero)
            (do
                (let score (fktwt-native-score raw))
                (if (not (eq (fktwt-value-present? score) 1)) (oac-nothing)
                    (if (eq (fktwt-value-int score) (fktwt-score-all))
                        (oac-one (intern_trivial_int (fktwt-score-all)))
                        (oac-zero)))))))
0
