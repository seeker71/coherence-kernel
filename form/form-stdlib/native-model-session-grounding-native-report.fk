; native-model-session-grounding-native-report.fk -- privacy-safe prior identity
; comparison, contract binding, and aggregate report projection.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/native-model-evidence-delta.fk form-stdlib/native-model-session-grounding-native-common.fk

(do
    ; Privacy-safe plain-text report access for immediate-prior comparison.
    (defn nmsgn-line-end (text start)
        (do
            (let p (str_find text "\n" start))
            (if (lt p 0) (str_len text) p)))
    (defn nmsgn-report-value (text key)
        (do
            (let prefix (str_concat key "="))
            (let at-first (if (nmsgn-prefix? text prefix) 0 -1))
            (let marker (str_concat "\n" prefix))
            (let found (if (ge at-first 0) at-first (str_find text marker 0)))
            (if (lt found 0) ""
                (do
                    (let start (if (eq found 0) (str_len prefix)
                        (add found (str_len marker))))
                    (substring text start (nmsgn-line-end text start))))))
    (defn nmsgn-report-int (text key missing)
        (do
            (let value (nmsgn-report-value text key))
            (if (str_eq value "") missing (str_to_int value))))
    (defn nmsgn-report-name? (path)
        (do
            (let base (fs-path-basename path))
            (if (and (eq (nmsgn-prefix? base "session-grounding-") 1)
                     (and (eq (nmsgn-prefix? base
                                "session-grounding-timeout-") 0)
                          (eq (nmsgn-suffix? base ".txt") 1))) 1 0)))
    (defn nmsgn-prior-loop (state-root rows best-path best-mtime)
        (if (eq (len rows) 0) best-path
            (do
                (let path (nmsgn-full-path state-root (head rows)))
                (let mtime (fs-stat-mtime path))
                (if (and (eq (nmsgn-report-name? path) 1)
                         (gt mtime best-mtime))
                    (nmsgn-prior-loop state-root (tail rows) path mtime)
                    (nmsgn-prior-loop state-root (tail rows)
                        best-path best-mtime)))))
    (defn nmsgn-prior-path (state-root)
        (if (eq (fs-is-dir? state-root) 0) ""
            (nmsgn-prior-loop state-root
                (fs-list state-root) "" -1)))

    ; Contract identity binds the exact native carrier, evaluator, embedding,
    ; and distance sources.  The minimized living-world handoff is a distinct
    ; contract so this private scanner reaches its first causal cell quickly.
    (defn nmsgn-contract-digest (repo-root)
        (nmsgn-sha256 (nmsgn-cat (list
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-common.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-json-string.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-candidate.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-session.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-discovery.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-minimize.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-reverse-line.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-reverse-state.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-reverse-event.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-reverse-cursor.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-reverse.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-report.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding-native-cli.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/native-model-session-grounding.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/rag-embed.fk"))
            (fs-read-text (fs-path-join repo-root
                "form/form-stdlib/rag-retrieve.fk"))))))

    ; Observation result: report text, report path, prior path, world cells,
    ; attributions, and scalar report/result rows.
    (defn nmsgn-result (text path prior cells attributions report results)
        (list "native-session-grounding-native-result-v1" text path prior
              cells attributions report results))

    (defn nmsgn-render-report
        (source-files root-files unchanged-files changed-files completed labeled
         source-index admitted
         report rank query-digest candidate-digest dataset-digest contract-digest
         prior-path prior-text comparison evidence-state candidate-changed
         dataset-changed contract-changed cells attributions execution-ms
         lens expiry-ms default-kind report-path)
        (do
            (let replayed (nth report 2))
            (let hit1 (nth report 4))
            (let hit3 (nth report 5))
            (let hit5 (nth report 6))
            (let top1-ppm (nth report 7))
            (let top3-ppm (nth report 8))
            (let top5-ppm (nth report 9))
            (let mrr (nth report 10))
            (let previous-top5 (if (str_eq prior-text "") -1
                (nmsgn-report-int prior-text "top5_ppm" -1)))
            (let previous-mrr (if (str_eq prior-text "") -1
                (nmsgn-report-int prior-text "mrr5_ppm" -1)))
            (nmsgn-cat (list
                "schema=native-model-session-grounding-report-v2\n"
                "source=real-root-codex-reverse-latest-pair-bounded-index-replay\n"
                "execution_mode=form-native-direct-private-replay\n"
                "diagnostic_non_promotion=1\nremote_oracle_calls=0\n"
                "raw_query_persisted=0\nraw_completion_persisted=0\n"
                (nmsgn-kvi "source_session_files" source-files)
                (nmsgn-kvi "root_session_files" root-files)
                (nmsgn-kvi "unchanged_session_files_admitted" unchanged-files)
                (nmsgn-kvi "changing_session_files_abstained" changed-files)
                (nmsgn-kvi "completed_pairs_scanned" completed)
                (nmsgn-kvi "labeled_pairs_observed" labeled)
                (nmsgn-kvi "source_index_candidates" source-index)
                "source_index_count_contract=valid-public-index-rows-observed\n"
                "pair_selection_contract=latest-completed-pair-per-unchanged-selected-session-reverse-cursor\n"
                "completed_pair_count_contract=latest-completed-pairs-observed-across-unchanged-selected-sessions\n"
                "candidate_selection_contract=stream-cited-ids-plus-lexical-fallback\n"
                (nmsgn-kvi "admitted_candidates" admitted)
                (nmsgn-kvi "replayed_queries" replayed)
                (nmsgn-kvi "path_labels" (nth report 3))
                (nmsgn-kvi "top1_hits" hit1)
                (nmsgn-kvi "top3_hits" hit3)
                (nmsgn-kvi "top5_hits" hit5)
                (nmsgn-kvi "top1_ppm" top1-ppm)
                (nmsgn-kvi "top3_ppm" top3-ppm)
                (nmsgn-kvi "top5_ppm" top5-ppm)
                (nmsgn-kvi "mrr5_ppm" mrr)
                (nmsgn-kvi "observed_first_hit_rank" rank)
                (nmsgn-kvi "replay_valid" (nth report 13))
                "timeout=0\n"
                (nmsgn-kvs "query_sha256" query-digest)
                (nmsgn-kvs "candidate_set_sha256" candidate-digest)
                (nmsgn-kvs "dataset_sha256" dataset-digest)
                (nmsgn-kvs "evaluation_contract_sha256" contract-digest)
                (nmsgn-kvs "prior_report_path" prior-path)
                (nmsgn-kvi "previous_top5_ppm" previous-top5)
                (nmsgn-kvi "previous_mrr5_ppm" previous-mrr)
                (nmsgn-kvi "candidate_identity_changed" candidate-changed)
                (nmsgn-kvi "dataset_identity_changed" dataset-changed)
                (nmsgn-kvi "contract_identity_changed" contract-changed)
                (nmsgn-kvs "evidence_state" evidence-state)
                (nmsgn-kvi "comparison_admissible" comparison)
                (nmsgn-kvi "top5_delta_ppm"
                    (if (eq comparison 1) (sub top5-ppm previous-top5) -1))
                (nmsgn-kvi "mrr5_delta_ppm"
                    (if (eq comparison 1) (sub mrr previous-mrr) -1))
                "living_world_observation=pending-minimized-form-native-handoff\n"
                (nmsgn-kvs "declared_lens" lens)
                (nmsgn-kvi "declared_expiry_ms" expiry-ms)
                (nmsgn-kvs "declared_expiry_default" default-kind)
                "authority_movement=none\nquality_claim=current-sample-placement-only\n"
                "bounded_corpus_caveat=completed_pairs_scanned counts at most one reverse-observed latest completed pair per selected session whose filesystem mtime remains identical to its metadata snapshot; changing or unsealed tails abstain instead of condensing to NOTHING, and a tail that changes during scanning is discarded; labeled_pairs_observed covers only the newest of admitted local observations; historical pairs before each local latest pair are intentionally not counted; the public index is streamed once and retains only cited rows plus bounded lexical fallback before at most four candidates are replayed; lexical placement is not general language understanding\n"
                "ranker=form-native-re-vec64-stable-one-pass-l1-top5\n"
                (nmsgn-kvi "execution_elapsed_ms" execution-ms)
                (nmsgn-kvs "report_path" report-path)))))

    0)
