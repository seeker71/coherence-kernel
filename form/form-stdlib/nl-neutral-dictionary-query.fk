; nl-neutral-dictionary-query.fk — query the form-neutral dictionary:
; symbols, surfaces in every seated tongue, descriptions, Form recipes,
; and the relation between words and tokens.
;
; ALL WORDS, ALL SYMBOLS, ALL LANGUAGES is the north star. This cell is
; the door and the query engine. New tongues are new columns. New words
; and symbols enter as admitted rows (axiom-3: the old dictionary stays
; referenced). Today's seed is the closed 64, a handful of Form symbols,
; and a few overlay words — not a dump of every language.
;
; A WORD is a surface that maps to a meaning symbol.
; A TOKEN is a unit of a stream (here: an English character of that
; surface, or a whole-word unigram). A word is composed of tokens;
; a token may belong to many words. Query walks both directions.
;
; A DESCRIPTION is the purified how-sentence (core tokens).
; A RECIPE is a Form operator the meaning can run (and, or, not, if, eq).
;
; preludes: form-stdlib/core.fk ../control/offer-ack-core.fk form-stdlib/core-lexicon.fk form-stdlib/core-dictionary-neutral-field.fk
;
; Proven by: form-stdlib/tests/nl-neutral-dictionary-query-band.fk
; witnessed: 2026-08-14 -> band 8191

(do
    (defn nnd-rel-surface () 0)
    (defn nnd-rel-describe () 1)
    (defn nnd-rel-recipe () 2)
    (defn nnd-rel-compose () 3)
    (defn nnd-rel-token-of () 4)
    (defn nnd-rel-same () 5)

    (defn nnd-kind-word () 0)
    (defn nnd-kind-symbol () 1)
    (defn nnd-kind-token () 2)

    ; entry = (id kind tongue text description recipe)
    ; id: core word index 0..63, or 1000+ for symbols, or 2000+ overlay
    (defn nnd-entry (id kind tongue text desc recipe)
        (list id kind tongue text desc recipe))
    (defn nnd-id    (e) (nth e 0))
    (defn nnd-kind  (e) (nth e 1))
    (defn nnd-tongue (e) (nth e 2))
    (defn nnd-text  (e) (nth e 3))
    (defn nnd-desc  (e) (nth e 4))
    (defn nnd-recipe (e) (nth e 5))

    (defn nnd-edge (from rel to) (list from rel to))
    (defn nnd-from (e) (nth e 0))
    (defn nnd-rel  (e) (nth e 1))
    (defn nnd-to   (e) (nth e 2))

    ; ── seed: one entry per core word in each seated tongue ──────────
    (defn nnd-core-entry (i tongue)
        (nnd-entry i (nnd-kind-word) tongue
            (cdnf-surface i tongue)
            (cdnf-h-how (cdnf-health-at i))
            (cl-word (cl-at i))))

    (defn nnd-core-tongue-loop (i tongues acc)
        (if (eq (len tongues) 0) acc
            (nnd-core-tongue-loop i (tail tongues)
                (cons (nnd-core-entry i (head tongues)) acc))))
    (defn nnd-core-loop (i n tongues acc)
        (if (eq i n) acc
            (nnd-core-loop (add i 1) n tongues
                (nnd-core-tongue-loop i tongues acc))))
    (defn nnd-core-entries ()
        (nnd-core-loop 0 (cl-count) (cdnf-tongues) (empty)))

    ; Form symbols — not NL words. They still have descriptions and recipes.
    (defn nnd-symbol-entries ()
        (list
            (nnd-entry 1000 (nnd-kind-symbol) "form" "("
                (list "a" "thing" "begin") "begin")
            (nnd-entry 1001 (nnd-kind-symbol) "form" ")"
                (list "a" "thing" "end") "end")
            (nnd-entry 1002 (nnd-kind-symbol) "form" "+"
                (list "make" "more") "add")
            (nnd-entry 1003 (nnd-kind-symbol) "form" "="
                (list "this" "and" "that" "are" "the" "same") "eq")))

    ; Overlay words that the closed 64 does not hold, admitted as new rows.
    (defn nnd-overlay-entries ()
        (list
            (nnd-entry 2000 (nnd-kind-word) "en" "trust"
                (list "you" "know" "more") "observe")
            (nnd-entry 2001 (nnd-kind-word) "en" "cell"
                (list "a" "thing" "that" "is") "cell")
            (nnd-entry 2002 (nnd-kind-word) "en" "recipe"
                (list "the" "way" "a" "thing" "do") "recipe")))

    (defn nnd-cat (a b)
        (if (eq (len a) 0) b (cons (head a) (nnd-cat (tail a) b))))
    (defn nnd-seed ()
        (nnd-cat (nnd-core-entries)
            (nnd-cat (nnd-symbol-entries) (nnd-overlay-entries))))

    ; ── query ────────────────────────────────────────────────────────
    (defn nnd-by-surface-loop (es tongue text)
        (if (eq (len es) 0) (empty)
            (if (and (str_eq (nnd-tongue (head es)) tongue)
                     (str_eq (nnd-text (head es)) text))
                (head es)
                (nnd-by-surface-loop (tail es) tongue text))))
    (defn nnd-by-surface (dict tongue text)
        (nnd-by-surface-loop dict tongue text))
    (defn nnd-surface-ids-loop (es tongue text acc)
        (if (eq (len es) 0) acc
            (if (and (str_eq (nnd-tongue (head es)) tongue)
                     (str_eq (nnd-text (head es)) text))
                (nnd-surface-ids-loop (tail es) tongue text
                    (cons (nnd-id (head es)) acc))
                (nnd-surface-ids-loop (tail es) tongue text acc))))
    (defn nnd-surface-ids (dict tongue text)
        (nnd-surface-ids-loop dict tongue text (empty)))
    (defn nnd-homonym? (dict tongue text)
        (if (gt (len (nnd-surface-ids dict tongue text)) 1) 1 0))

    (defn nnd-by-id-loop (es id acc)
        (if (eq (len es) 0) acc
            (if (eq (nnd-id (head es)) id)
                (nnd-by-id-loop (tail es) id (cons (head es) acc))
                (nnd-by-id-loop (tail es) id acc))))
    (defn nnd-by-id (dict id) (nnd-by-id-loop dict id (empty)))

    (defn nnd-id-of (dict tongue text)
        (do (let e (nnd-by-surface dict tongue text))
            (if (eq (len e) 0) (sub 0 1) (nnd-id e))))

    ; same-symbol: two surfaces name one id
    (defn nnd-same-symbol? (dict t1 s1 t2 s2)
        (do (let a (nnd-id-of dict t1 s1))
            (let b (nnd-id-of dict t2 s2))
            (if (and (ge a 0) (eq a b)) 1 0)))

    ; description of a meaning (any tongue's entry shares the same desc)
    (defn nnd-description (dict id)
        (do (let es (nnd-by-id dict id))
            (if (eq (len es) 0) (empty) (nnd-desc (head es)))))
    (defn nnd-recipe-of (dict id)
        (do (let es (nnd-by-id dict id))
            (if (eq (len es) 0) "" (nnd-recipe (head es)))))

    ; Form recipe run for the four seated operators
    (defn nnd-run (op a b)
        (if (str_eq op "and") (and a b)
            (if (str_eq op "or") (or a b)
                (if (str_eq op "not") (if (eq a 0) 1 0)
                    (if (str_eq op "eq") (if (eq a b) 1 0)
                        (if (str_eq op "add") (add a b)
                            (sub 0 1)))))))

    ; ── tokens of a word (English surface characters) ────────────────
    (defn nnd-rev (xs acc)
        (if (eq (len xs) 0) acc (nnd-rev (tail xs) (cons (head xs) acc))))
    (defn nnd-chars-loop (s i n acc)
        (if (ge i n) (nnd-rev acc (empty))
            (nnd-chars-loop s (add i 1) n
                (cons (substring s i (add i 1)) acc))))
    (defn nnd-chars (s) (nnd-chars-loop s 0 (str_len s) (empty)))

    (defn nnd-word-tokens (dict id)
        (do (let e (nnd-by-surface dict "en" (cl-word (cl-at id))))
            (if (eq (len e) 0) (empty) (nnd-chars (nnd-text e)))))

    ; which seeded English words contain this character-token
    (defn nnd-has-char? (chars ch)
        (if (eq (len chars) 0) 0
            (if (str_eq (head chars) ch) 1 (nnd-has-char? (tail chars) ch))))
    (defn nnd-token-words-loop (i n ch acc)
        (if (eq i n) acc
            (if (eq (nnd-has-char? (nnd-chars (cl-word (cl-at i))) ch) 1)
                (nnd-token-words-loop (add i 1) n ch (cons i acc))
                (nnd-token-words-loop (add i 1) n ch acc))))
    (defn nnd-token-words (ch) (nnd-token-words-loop 0 (cl-count) ch (empty)))

    ; ── relations as an explicit edge list, plus derived walks ───────
    (defn nnd-seed-edges ()
        (list
            (nnd-edge 0 (nnd-rel-same) 0)
            (nnd-edge 5 (nnd-rel-recipe) 5)
            (nnd-edge 2000 (nnd-rel-describe) 2000)
            (nnd-edge 1002 (nnd-rel-recipe) 1002)))
    (defn nnd-related-loop (es id rel acc)
        (if (eq (len es) 0) acc
            (if (and (eq (nnd-from (head es)) id) (eq (nnd-rel (head es)) rel))
                (nnd-related-loop (tail es) id rel (cons (nnd-to (head es)) acc))
                (nnd-related-loop (tail es) id rel acc))))
    (defn nnd-related (edges id rel)
        (nnd-related-loop edges id rel (empty)))

    ; ── admit: new dictionary, old one still referenced ──────────────
    (defn nnd-admit (dict entry) (cons entry dict))
    (defn nnd-count (dict) (len dict))

    ; unknown tongue is nothing, not an error
    (defn nnd-unknown-tongue? (dict tongue)
        (if (eq (len (nnd-by-surface dict tongue "nothing")) 0) 1 0))

    (defn nndk (cond bit) (if cond bit 0))
    (defn nnd-check ()
        (do
            (let d (nnd-seed))
            (let nothing-en (nnd-by-surface d "en" "nothing"))
            (let nothing-id (nnd-by-surface d "id" "kosong"))
            (let and-e (nnd-by-surface d "en" "and"))
            (let plus (nnd-by-surface d "form" "+"))
            (let grown (nnd-admit d (nnd-entry 3000 (nnd-kind-word) "en" "vitality"
                            (list "the" "whole" "is" "more") "vitality")))
            (let toks (nnd-word-tokens d 0))
            (let n-words (nnd-token-words "n"))
            (add (add (add (add (add (add (add (add (add (add (add (add
                (nndk (eq (nnd-id nothing-en) 0) 1)
                (nndk (eq (nnd-same-symbol? d "en" "nothing" "id" "kosong") 1) 2))
                (nndk (and (eq (nnd-same-symbol? d "en" "nothing" "es" "nada") 1)
                           (eq (nnd-homonym? d "sw" "hakuna") 1)) 4))
                (nndk (gt (len (nnd-description d 0)) 0) 8))
                (nndk (str_eq (nnd-recipe and-e) "and") 16))
                (nndk (eq (nnd-run (nnd-recipe and-e) 1 1) 1) 32))
                (nndk (eq (nnd-run (nnd-recipe plus) 2 3) 5) 64))
                (nndk (eq (len toks) 7) 128))
                (nndk (gt (len n-words) 1) 256))
                (nndk (and (gt (nnd-count grown) (nnd-count d))
                           (eq (nnd-id (nnd-by-surface grown "en" "vitality")) 3000)) 512))
                (nndk (eq (nnd-unknown-tongue? d "tlh") 1) 1024))
                (nndk (eq (nnd-kind plus) (nnd-kind-symbol)) 2048))
                (nndk (eq (nnd-id (nnd-by-surface d "en" "trust")) 2000) 4096))))

    0)
