                    (lwrt-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwrt-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrt-candidate-current? world candidate) 1)) 1 0))
(defn lwrt-integrate (round proposal action)
    (if (eq (lwrt-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrt-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "blueprints:" (int_to_str
                (lwo-field-size (lwrt-field-blueprints field)))
            ":compatible:" (int_to_str
                (lwo-field-size (lwrt-field-compatible field)))
            ":divergent:" (int_to_str
                (lwo-field-size (lwrt-field-divergent field)))
            ":unresolved:" (int_to_str
                (lwo-field-size (lwrt-field-unresolved field)))))))

