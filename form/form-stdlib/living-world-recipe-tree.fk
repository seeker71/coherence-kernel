; living-world-recipe-tree.fk -- offered cells may compose a new Recipe tree.
;
; This organ owns no task, taxonomy, operator list, variable vocabulary,
; literal set, answer table, or remote route.  Participants offer every safe
; reference name, integer cell, evaluator token, ordered application, and root
; blueprint.  The only fixed surface is a minimal executable tree codec.
;
; A recurrent blueprint is compiled locally into one exact Recipe and executed
; against every retained placement of one current contradicted tissue.  Zero,
; one, or many compatible compositions remain OPEN, READY, or PLURAL without a
; representative.  Admission makes the composition field current evidence; it
; does not promote the Recipe into hypothesis tissue or grant answer authority.
; Optional declaration, lens, alternatives, unknown, choice, and timeout stay
; separate, revocable cells.  History is retained when any dependency moves.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-revision-nursery.fk

(let LWRT-REFERENCE   (bp "LWRT-REFERENCE"))
(let LWRT-LITERAL     (bp "LWRT-LITERAL"))
(let LWRT-OPERATOR    (bp "LWRT-OPERATOR"))
(let LWRT-ARGUMENTS   (bp "LWRT-ARGUMENTS"))
(let LWRT-APPLICATION (bp "LWRT-APPLICATION"))
(let LWRT-RENDER-TREE (bp "LWRT-RENDER-TREE"))
(let LWRT-RENDER-ARGS (bp "LWRT-RENDER-ARGS"))
(let LWRT-BLUEPRINT   (bp "LWRT-BLUEPRINT"))
(let LWRT-COMPOSITION (bp "LWRT-COMPOSITION"))
(let LWRT-FIELD       (bp "LWRT-FIELD"))
(let LWRT-ORIGIN      (bp "LWRT-ORIGIN"))

; --- minimal tree codec -----------------------------------------------

(defn lwrt-reference (name evidence)
    (intern_node LWRT-REFERENCE
        (list (intern_trivial_string name) evidence (lwo-local-path))))
(defn lwrt-reference? (cell) (lwo-category? cell LWRT-REFERENCE))
(defn lwrt-reference-name-cell (reference)
    (nth (node_children reference) 0))
(defn lwrt-reference-name (reference)
    (node_value (lwrt-reference-name-cell reference)))
(defn lwrt-reference-evidence (reference)
    (nth (node_children reference) 1))

(defn lwrt-literal (value evidence)
    (intern_node LWRT-LITERAL
        (list value evidence (lwo-local-path))))
(defn lwrt-literal? (cell) (lwo-category? cell LWRT-LITERAL))
(defn lwrt-literal-value (literal) (nth (node_children literal) 0))
(defn lwrt-literal-evidence (literal) (nth (node_children literal) 1))

; A tree operator belongs only to this target-scoped interface.  It does not
; become an lwph-operator and therefore cannot silently expand or stale the
; incumbent simple-hypothesis field.
(defn lwrt-operator (target token evidence)
    (intern_node LWRT-OPERATOR
        (list target (intern_trivial_string token) evidence
              (lwo-local-path))))
(defn lwrt-operator? (cell) (lwo-category? cell LWRT-OPERATOR))
(defn lwrt-operator-target (operator) (nth (node_children operator) 0))
(defn lwrt-operator-token-cell (operator) (nth (node_children operator) 1))
(defn lwrt-operator-token (operator)
    (node_value (lwrt-operator-token-cell operator)))
(defn lwrt-operator-evidence (operator) (nth (node_children operator) 2))
(defn lwrt-operator-valid? (operator)
    (if (and (eq (lwrt-operator? operator) 1)
             (and (eq (lwht-candidate?
                        (lwrt-operator-target operator)) 1)
                  (eq (lwph-source-name-safe?
                        (lwrt-operator-token operator)) 1))) 1 0))

(defn lwrt-arguments (items) (intern_node LWRT-ARGUMENTS items))
(defn lwrt-arguments? (cell) (lwo-category? cell LWRT-ARGUMENTS))
(defn lwrt-argument-items (arguments) (node_children arguments))

(defn lwrt-application (operator arguments evidence)
    (intern_node LWRT-APPLICATION
        (list operator arguments evidence (lwo-local-path))))
(defn lwrt-application? (cell) (lwo-category? cell LWRT-APPLICATION))
(defn lwrt-application-operator (application)
    (nth (node_children application) 0))
(defn lwrt-application-arguments (application)
    (nth (node_children application) 1))
(defn lwrt-application-evidence (application)
    (nth (node_children application) 2))

(defn lwrt-tree-items-valid? (items)
    (if (eq (len items) 0) 1
        (do
            (let tree (head items))
            (if (eq (lwrt-reference? tree) 1)
                (if (eq (lwph-source-name-safe?
                            (lwrt-reference-name tree)) 1)
                    (lwrt-tree-items-valid? (tail items)) 0)
                (if (eq (lwrt-literal? tree) 1)
                    (if (eq (node_type (lwrt-literal-value tree)) 1)
                        (lwrt-tree-items-valid? (tail items)) 0)
                    (if (eq (lwrt-application? tree) 0) 0
                        (if (or (eq (lwrt-operator-valid?
                                        (lwrt-application-operator tree)) 0)
                                (or (eq (lwrt-arguments?
                                          (lwrt-application-arguments tree)) 0)
                                    (eq (len
                                          (lwrt-argument-items
                                            (lwrt-application-arguments tree)))
                                        0))) 0
                            (lwrt-tree-items-valid?
                                (append
                                    (lwrt-argument-items
                                        (lwrt-application-arguments tree))
                                    (tail items))))))))))
(defn lwrt-tree-valid? (tree)
    (lwrt-tree-items-valid? (list tree)))

(defn lwrt-render-tree (tree prefix)
    (intern_node LWRT-RENDER-TREE
        (list tree (intern_trivial_string prefix))))
(defn lwrt-render-tree? (work) (lwo-category? work LWRT-RENDER-TREE))
(defn lwrt-render-tree-cell (work) (nth (node_children work) 0))
(defn lwrt-render-tree-prefix (work)
    (node_value (nth (node_children work) 1)))
(defn lwrt-render-args (arguments)
    (intern_node LWRT-RENDER-ARGS (list arguments)))
(defn lwrt-render-args? (work) (lwo-category? work LWRT-RENDER-ARGS))
(defn lwrt-render-args-cell (work) (nth (node_children work) 0))
(defn lwrt-integer-source (value)
    (if (lt value 0)
        (str_concat "(sub 0 "
            (str_concat (int_to_str (sub 0 value)) ")"))
        (int_to_str value)))
(defn lwrt-source-work (work output)
    (if (eq (len work) 0) output
        (do
            (let item (head work))
            (if (eq (lwrt-render-tree? item) 1)
                (do
                    (let tree (lwrt-render-tree-cell item))
                    (let prefix (lwrt-render-tree-prefix item))
                    (if (eq (lwrt-reference? tree) 1)
                        (lwrt-source-work (tail work)
                            (str_concat output
                                (str_concat prefix
                                    (lwrt-reference-name tree))))
                        (if (eq (lwrt-literal? tree) 1)
                            (lwrt-source-work (tail work)
                                (str_concat output
                                    (str_concat prefix
                                        (lwrt-integer-source
                                            (node_value
                                                (lwrt-literal-value tree))))))
                            (lwrt-source-work
                                (cons
                                    (lwrt-render-args
                                        (lwrt-application-arguments tree))
                                    (tail work))
                                (str_concat output
                                    (str_concat prefix
                                        (str_concat "("
                                            (lwrt-operator-token
                                                (lwrt-application-operator
                                                    tree)))))))))
                (do
                    (let arguments (lwrt-render-args-cell item))
                    (let items (lwrt-argument-items arguments))
                    (if (eq (len items) 0)
                        (lwrt-source-work (tail work)
                            (str_concat output ")"))
                        (lwrt-source-work
                            (cons (lwrt-render-tree (head items) " ")
                                (cons
                                    (lwrt-render-args
                                        (lwrt-arguments (tail items)))
                                    (tail work)))
                            output)))))))
(defn lwrt-source-for (tree)
    (lwrt-source-work (list (lwrt-render-tree tree "")) ""))

; --- target-scoped currentness ----------------------------------------

(defn lwrt-binding-name-in-items? (items name)
    (if (eq (len items) 0) 0
        (if (eq (lwre-binding-name (head items)) name) 1
            (lwrt-binding-name-in-items? (tail items) name))))
(defn lwrt-reference-covered-by-placements? (items name)
    (if (eq (len items) 0) 1
        (do
            (let placement (lwo-emergent-shape (head items)))
            (let probe (lwph-placement-probe placement))
            (if (eq (lwrt-binding-name-in-items?
                        (lwre-binding-items (lwph-probe-bindings probe))
                        name) 1)
                (lwrt-reference-covered-by-placements? (tail items) name) 0))))
(defn lwrt-recurrent-cell? (world cell threshold)
    (if (and (eq (lwo-active? world cell) 1)
             (ge (lwph-active-source-count world cell) threshold)) 1 0))
(defn lwrt-optional-cell-current? (world cell threshold)
    (if (node_eq cell (lwo-none)) 1
        (lwrt-recurrent-cell? world cell threshold)))
(defn lwrt-tree-items-current? (world items target threshold)
    (if (eq (len items) 0) 1
        (do
            (let tree (head items))
            (if (or (eq (lwrt-tree-valid? tree) 0)
                    (eq (lwrt-recurrent-cell?
                            world tree threshold) 0)) 0
                (if (eq (lwrt-reference? tree) 1)
                    (if (and
                            (eq (lwrt-reference-covered-by-placements?
                                    (lwo-field-items
                                        (lwht-tissue-placements
                                            (lwo-emergent-shape target)))
                                    (lwrt-reference-name tree)) 1)
                            (eq (lwrt-optional-cell-current? world
                                    (lwrt-reference-evidence tree)
                                    threshold) 1))
                        (lwrt-tree-items-current?
                            world (tail items) target threshold) 0)
                    (if (eq (lwrt-literal? tree) 1)
                        (if (and
                                (eq (lwrt-recurrent-cell? world
                                        (lwrt-literal-value tree)
                                        threshold) 1)
                                (eq (lwrt-optional-cell-current? world
                                        (lwrt-literal-evidence tree)
                                        threshold) 1))
                            (lwrt-tree-items-current?
                                world (tail items) target threshold) 0)
                        (do
                            (let operator (lwrt-application-operator tree))
                            (if (and
                                    (and (eq (lwrt-operator-valid? operator) 1)
                                         (node_eq
                                            (lwrt-operator-target operator)
                                            target))
                                    (and (eq (lwrt-recurrent-cell? world
                                                operator threshold) 1)
                                         (and (eq (lwrt-recurrent-cell? world
                                                    (lwrt-application-arguments
                                                        tree) threshold) 1)
                                              (eq (lwrt-optional-cell-current?
                                                    world
                                                    (lwrt-application-evidence
                                                        tree)
                                                    threshold) 1))))
                                (lwrt-tree-items-current? world
                                    (append
                                        (lwrt-argument-items
                                            (lwrt-application-arguments tree))
                                        (tail items))
                                    target threshold) 0))))))))
(defn lwrt-tree-current? (world tree target threshold)
    (lwrt-tree-items-current? world (list tree) target threshold))

(defn lwrt-field-items-current? (world items threshold)
    (if (eq (len items) 0) 1
        (if (eq (lwrt-recurrent-cell? world (head items) threshold) 1)
            (lwrt-field-items-current? world (tail items) threshold) 0)))

; children: contradicted target, exact root tree, optional declaration, optional
; lens, alternatives, optional unknown/choice/timeout, evidence, local path
(defn lwrt-blueprint
    (target root declaration lens alternatives unknown choice timeout evidence)
    (intern_node LWRT-BLUEPRINT
        (list target root declaration lens alternatives unknown choice timeout
              evidence (lwo-local-path))))
(defn lwrt-blueprint? (cell) (lwo-category? cell LWRT-BLUEPRINT))
(defn lwrt-blueprint-target (blueprint) (nth (node_children blueprint) 0))
(defn lwrt-blueprint-root (blueprint) (nth (node_children blueprint) 1))
(defn lwrt-blueprint-declaration (blueprint)
    (nth (node_children blueprint) 2))
(defn lwrt-blueprint-lens (blueprint) (nth (node_children blueprint) 3))
(defn lwrt-blueprint-alternatives (blueprint)
    (nth (node_children blueprint) 4))
(defn lwrt-blueprint-unknown (blueprint) (nth (node_children blueprint) 5))
(defn lwrt-blueprint-choice (blueprint) (nth (node_children blueprint) 6))
(defn lwrt-blueprint-timeout (blueprint) (nth (node_children blueprint) 7))
(defn lwrt-blueprint-evidence (blueprint) (nth (node_children blueprint) 8))

(defn lwrt-blueprint-valid? (blueprint)
    (if (eq (lwrt-blueprint? blueprint) 0) 0
        (if (eq (lwht-candidate?
                    (lwrt-blueprint-target blueprint)) 0) 0
            (if (eq (lwrt-tree-valid?
                        (lwrt-blueprint-root blueprint)) 0) 0
                (if (eq (lwhrn-optional-declaration-valid?
                            (lwrt-blueprint-declaration blueprint)) 0) 0
                    (if (eq (lwhrn-optional-lens-valid?
                                (lwrt-blueprint-lens blueprint)) 0) 0
                        (if (eq (lwo-category?
                                    (lwrt-blueprint-alternatives blueprint)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwhrn-optional-unknown-valid?
                                        (lwrt-blueprint-unknown blueprint)) 0) 0
                                (if (eq (lwlc-choice-valid?
                                            (lwrt-blueprint-choice blueprint)) 0) 0
                                    (lwhrn-optional-timeout-valid?
                                        (lwrt-blueprint-timeout
                                            blueprint)))))))))))
(defn lwrt-blueprint-current? (world blueprint target threshold)
    (if (or (lt threshold 1)
            (or (eq (lwrt-blueprint-valid? blueprint) 0)
                (not (node_eq
                    (lwrt-blueprint-target blueprint) target)))) 0
        (if (or (eq (lwht-integrated-current? world target) 0)
                (eq (lwht-contradicted?
                        (lwht-tissue-status
                            (lwo-emergent-shape target))) 0)) 0
            (if (or (eq (lwrt-recurrent-cell?
                            world blueprint threshold) 0)
                    (eq (lwrt-tree-current? world
                            (lwrt-blueprint-root blueprint)
                            target threshold) 0)) 0
                (if (eq (lwrt-field-items-current? world
                            (lwo-field-items
                                (lwrt-blueprint-alternatives blueprint))
                            threshold) 0) 0
                    (if (eq (lwrt-optional-cell-current? world
                                (lwrt-blueprint-declaration blueprint)
                                threshold) 0) 0
                        (if (eq (lwrt-optional-cell-current? world
                                    (lwrt-blueprint-lens blueprint)
                                    threshold) 0) 0
                            (if (eq (lwrt-optional-cell-current? world
                                        (lwrt-blueprint-unknown blueprint)
                                        threshold) 0) 0
                                (if (eq (lwrt-optional-cell-current? world
                                            (lwrt-blueprint-choice blueprint)
                                            threshold) 0) 0
                                    (if (eq (lwrt-optional-cell-current? world
                                                (lwrt-blueprint-timeout blueprint)
                                                threshold) 0) 0
                                        (lwrt-optional-cell-current? world
                                            (lwrt-blueprint-evidence blueprint)
                                            threshold)))))))))))

; --- recurrent blueprints become evaluated compositions ---------------

(defn lwrt-collect-blueprints (world items target threshold field)
    (if (eq (len items) 0) field
        (lwrt-collect-blueprints world (tail items) target threshold
            (if (eq (lwrt-blueprint-current?
                        world (head items) target threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwrt-blueprints-for (world target threshold)
    (lwrt-collect-blueprints world
        (lwo-field-items (lwo-world-cells world))
        target threshold (lwo-empty-field)))

(defn lwrt-recipe-for (blueprint)
    (lwre-recipe (lwrt-source-for (lwrt-blueprint-root blueprint))
        (lwre-bound-form-contract 512 blueprint) blueprint))

; children: exact blueprint, generated Recipe, every placement evaluation,
; state, alternatives, unknowns, local path
(defn lwrt-composition (blueprint recipe evaluations state alternatives unknowns)
    (intern_node LWRT-COMPOSITION
        (list blueprint recipe evaluations state alternatives unknowns
              (lwo-local-path))))
(defn lwrt-composition? (cell) (lwo-category? cell LWRT-COMPOSITION))
(defn lwrt-composition-blueprint (composition)
    (nth (node_children composition) 0))
(defn lwrt-composition-recipe (composition)
    (nth (node_children composition) 1))
(defn lwrt-composition-evaluations (composition)
    (nth (node_children composition) 2))
(defn lwrt-composition-state (composition)
    (nth (node_children composition) 3))
(defn lwrt-composition-alternatives (composition)
    (nth (node_children composition) 4))
(defn lwrt-composition-unknowns (composition)
    (nth (node_children composition) 5))
(defn lwrt-composition-for (target blueprint)
    (do
        (let recipe (lwrt-recipe-for blueprint))
        (let evaluations
            (lwhrn-evaluations-items recipe
                (lwo-field-items
                    (lwht-tissue-placements (lwo-emergent-shape target)))
                (lwo-empty-field)))
        (let unknown (lwrt-blueprint-unknown blueprint))
        (lwrt-composition blueprint recipe evaluations
            (lwhrn-evaluation-state-items
                (lwo-field-items evaluations) 0 0 0)
            (lwrt-blueprint-alternatives blueprint)
            (if (node_eq unknown (lwo-none)) (lwo-empty-field)
                (lwo-field (list unknown))))))
(defn lwrt-compositions-items (target items field)
    (if (eq (len items) 0) field
        (lwrt-compositions-items target (tail items)
            (lwo-field-add field
                (lwrt-composition-for target (head items))))))
(defn lwrt-filter-compositions (items state field)
    (if (eq (len items) 0) field
        (lwrt-filter-compositions (tail items) state
            (if (node_eq (lwrt-composition-state (head items)) state)
                (lwo-field-add field (head items)) field))))

; --- provenance and representative-free field -------------------------

(defn lwrt-attributions (world cell field)
    (lwph-field-union-items
        (lwo-field-items (lwo-active-attributions-for world cell)) field))
(defn lwrt-optional-witnesses (world cell field)
    (if (node_eq cell (lwo-none)) field
        (lwrt-attributions world cell field)))
(defn lwrt-tree-witnesses (world items field)
    (if (eq (len items) 0) field
        (do
            (let tree (head items))
            (let with-tree (lwrt-attributions world tree field))
            (if (eq (lwrt-reference? tree) 1)
                (lwrt-tree-witnesses world (tail items)
                    (lwrt-optional-witnesses world
                        (lwrt-reference-evidence tree) with-tree))
                (if (eq (lwrt-literal? tree) 1)
                    (lwrt-tree-witnesses world (tail items)
                        (lwrt-optional-witnesses world
                            (lwrt-literal-evidence tree)
                            (lwrt-attributions world
                                (lwrt-literal-value tree) with-tree)))
                    (do
                        (let with-operator
                            (lwrt-attributions world
                                (lwrt-application-operator tree) with-tree))
                        (let with-arguments
                            (lwrt-attributions world
                                (lwrt-application-arguments tree)
                                with-operator))
                        (lwrt-tree-witnesses world
                            (append
                                (lwrt-argument-items
                                    (lwrt-application-arguments tree))
                                (tail items))
                            (lwrt-optional-witnesses world
                                (lwrt-application-evidence tree)
                                with-arguments))))))))
(defn lwrt-attribution-items (world items field)
    (if (eq (len items) 0) field
        (lwrt-attribution-items world (tail items)
            (lwrt-attributions world (head items) field))))
(defn lwrt-blueprint-witnesses (world blueprint field)
    (do
        (let with-blueprint (lwrt-attributions world blueprint field))
        (let with-tree
            (lwrt-tree-witnesses world
                (list (lwrt-blueprint-root blueprint)) with-blueprint))
        (let with-alternatives
            (lwrt-attribution-items world
                (lwo-field-items
                    (lwrt-blueprint-alternatives blueprint)) with-tree))
        (let with-declaration
            (lwrt-optional-witnesses world
                (lwrt-blueprint-declaration blueprint) with-alternatives))
        (let with-lens
            (lwrt-optional-witnesses world
                (lwrt-blueprint-lens blueprint) with-declaration))
        (let with-unknown
            (lwrt-optional-witnesses world
                (lwrt-blueprint-unknown blueprint) with-lens))
        (let with-choice
            (lwrt-optional-witnesses world
                (lwrt-blueprint-choice blueprint) with-unknown))
        (let with-timeout
            (lwrt-optional-witnesses world
                (lwrt-blueprint-timeout blueprint) with-choice))
        (lwrt-optional-witnesses world
            (lwrt-blueprint-evidence blueprint) with-timeout)))
(defn lwrt-blueprints-witnesses (world items field)
    (if (eq (len items) 0) field
        (lwrt-blueprints-witnesses world (tail items)
            (lwrt-blueprint-witnesses world (head items) field))))

; children: target, current blueprints, compositions, compatible, divergent,
; unresolved, OPEN/READY/PLURAL, alternatives, unknowns, witnesses, threshold,
; local path
(defn lwrt-field-cell
    (target blueprints compositions compatible divergent unresolved status
     alternatives unknowns witnesses threshold)
    (intern_node LWRT-FIELD
        (list target blueprints compositions compatible divergent unresolved
              status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwrt-field? (cell) (lwo-category? cell LWRT-FIELD))
(defn lwrt-field-target (field) (nth (node_children field) 0))
(defn lwrt-field-blueprints (field) (nth (node_children field) 1))
(defn lwrt-field-compositions (field) (nth (node_children field) 2))
(defn lwrt-field-compatible (field) (nth (node_children field) 3))
(defn lwrt-field-divergent (field) (nth (node_children field) 4))
(defn lwrt-field-unresolved (field) (nth (node_children field) 5))
(defn lwrt-field-status (field) (nth (node_children field) 6))
(defn lwrt-field-alternatives (field) (nth (node_children field) 7))
(defn lwrt-field-unknowns (field) (nth (node_children field) 8))
(defn lwrt-field-witnesses (field) (nth (node_children field) 9))
(defn lwrt-field-threshold (field)
    (node_value (nth (node_children field) 10)))

(defn lwrt-composition-options (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (lwrt-composition-options (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwrt-composition-alternatives (head items))) alternatives)
            (lwph-field-union-items
                (lwo-field-items
                    (lwrt-composition-unknowns (head items))) unknowns))))
(defn lwrt-field-for (world target threshold)
    (if (or (lt threshold 1)
            (or (eq (lwht-integrated-current? world target) 0)
                (eq (lwht-contradicted?
                        (lwht-tissue-status
                            (lwo-emergent-shape target))) 0))) (lwo-none)
        (do
            (let blueprints (lwrt-blueprints-for world target threshold))
            (let compositions
                (lwrt-compositions-items target
                    (lwo-field-items blueprints) (lwo-empty-field)))
            (let compatible
                (lwrt-filter-compositions
                    (lwo-field-items compositions)
                    (lwph-consistent) (lwo-empty-field)))
            (let divergent
                (lwrt-filter-compositions
                    (lwo-field-items compositions)
                    (lwph-divergent) (lwo-empty-field)))
            (let unresolved
                (lwrt-filter-compositions
                    (lwo-field-items compositions)
                    (lwph-unresolved) (lwo-empty-field)))
            (let count (lwo-field-size compatible))
            (let status
                (if (eq count 1) (lwhrn-ready)
                    (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
            (let options
                (lwrt-composition-options
                    (lwo-field-items compositions)
                    (lwht-tissue-alternatives (lwo-emergent-shape target))
                    (lwht-tissue-unknowns (lwo-emergent-shape target))))
            (let witnesses
                (lwrt-blueprints-witnesses world
                    (lwo-field-items blueprints)
