(defn lwrt-proposal-for (world target threshold)
    (do
        (let field (lwrt-field-for world target threshold))
        (lwrt-proposal-from-field field)))
(defn lwrt-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrt-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrt-candidate-current? (world candidate)
    (if (eq (lwrt-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
