                    (lwrt-field-threshold field)))
            (let candidate
                (lwo-emergent field witnesses
                    (intern_trivial_int
                        (lwo-field-size
                            (lwrt-field-compositions field)))
                    (intern_trivial_int
                        (lwo-field-size
                            (lwrt-field-compatible field)))
                    (intern_trivial_int
                        (lwo-field-size witnesses)) origin))
