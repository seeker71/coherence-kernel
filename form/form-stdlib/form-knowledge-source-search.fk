// form-knowledge-source-search.fk — current-body retrieval over the live source
// tree, through bounded byte windows rather than a tokenizer or flattened index.
//
// The model supplies already-parsed query atoms.  Parsing the heedmark stream is
// a grammar concern and lives above this cell.  This cell never tokenizes source:
// it walks the current body with source_inventory, searches each eligible source
// through 4096-byte windows, overlaps windows by the atom length so a match split
// at any boundary is still visible, and returns only one bounded source span.
//
// Identity is honest and deliberately separate from nodeid-rag-v2.  A selected
// source is a source artifact, not a registered substrate REF.  Its SHA-256 is
// folded window by window in Form and named `sha256:<hex>`; no REF or CTOR is
// fabricated.  nodeid-rag-v2 remains the stronger grounded lane when it hits.
//
// Query cost is proportional to the current eligible source bytes times the
// small number of query atoms.  That is the truthful no-index floor.  A Form-
// native CPU/GPU/Metal/MLX JIT may accelerate the same window law without
// changing its result.  No preflattened ops table is a dependency.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk
//
// Proven by: form-stdlib/tests/form-knowledge-source-search-band.fk
section [form.bml] {
    def fkss-schema() = "source-artifact-stream-v1";
    def fkss-route() = "source_inventory+bounded-byte-window+form-sha256-stream";
    def fkss-window-size() = fbw-max-window();
    def fkss-answer-limit() = 768;
    def fkss-max-query-atom() = 128;
    def fkss-skip-dirs() = list(".git", ".coherence-network", ".cache", "node_modules", "target", "dist", "build", "models", ".venv", "__pycache__");
    def fkss-knowledge-extension?(path) = {
        let ext = fs-path-extension(path);
        (String) ext == ".fk" || ((String) ext == ".bml" || ((String) ext == ".form" || ((String) ext == ".grammar" || ((String) ext == ".bmf" || (String) ext == ".md")))) ? 1 : 0;
    };
    def fkss-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    // Case-insensitive ASCII byte comparison.  UTF-8 bytes compare exactly.
    def fkss-match-at-loop(hay, needle, hi, ni) = ni >= str_len(needle) ? 1 : hi >= str_len(hay) ? 0 : (Comparable) fkss-lower-byte(str_byte_at(hay, hi)) == fkss-lower-byte(str_byte_at(needle, ni)) ? fkss-match-at-loop(hay, needle, hi + 1, ni + 1) : 0;
    def fkss-match-at?(hay, needle, at) = at < 0 || (Comparable) str_len(needle) == 0 ? 0 : fkss-match-at-loop(hay, needle, at, 0);
    def fkss-find-ci-loop(hay, needle, at) = at + str_len(needle) > str_len(hay) ? -1 : (Comparable) fkss-match-at?(hay, needle, at) == 1 ? at : fkss-find-ci-loop(hay, needle, at + 1);
    def fkss-find-ci(hay, needle) = (Comparable) str_len(needle) == 0 ? -1 : fkss-find-ci-loop(hay, needle, 0);
    def fkss-min(a, b) = a < b ? a : b;
    def fkss-max(a, b) = a > b ? a : b;
    def fkss-window-overlap(atom) = fkss-min(fkss-window-size() - 1, fkss-max(0, str_len(atom) - 1));
    def fkss-window-step(atom) = fkss-window-size() - fkss-window-overlap(atom);
    // Find one atom in one file without materializing the file.  A short final
    // window closes the scan; overlap makes every cross-boundary start visible.
    def fkss-find-file-loop(path, atom, offset) = {
        let window = fbw-read-window(path, offset, fkss-window-size());
        let observed = fbw-window-observed-len(window);
        let local = fkss-find-ci(fbw-window-slice(window), atom);
        local >= 0 ? offset + local : observed < fkss-window-size() ? -1 : fkss-find-file-loop(path, atom, offset + fkss-window-step(atom));
    };
    def fkss-find-file(path, atom) = (Comparable) str_len(atom) == 0 || str_len(atom) > fkss-max-query-atom() ? -1 : fkss-find-file-loop(path, atom, 0);
    // observation = (matched-atom-count first-match-offset)
    def fkss-observe-atoms-loop(path, atoms, matched, first) = nil?(atoms) ? list(matched, first) : {
        let at = fkss-find-file(path, head(atoms));
        fkss-observe-atoms-loop(path, tail(atoms), matched + (at >= 0 ? 1 : 0), first < 0 && at >= 0 ? at : first);
    };
    def fkss-observe-atoms(path, atoms) = fkss-observe-atoms-loop(path, atoms, 0, -1);
    def fkss-query-valid-loop(atoms) = nil?(atoms) ? 1 : (Comparable) str_len(head(atoms)) == 0 || str_len(head(atoms)) > fkss-max-query-atom() ? 0 : fkss-query-valid-loop(tail(atoms));
    def fkss-query-valid?(atoms) = nil?(atoms) ? 0 : fkss-query-valid-loop(atoms);
    // candidate = (relative-path full-path matched first-offset size)
    def fkss-candidate(relative, full, matched, first, size) = list(relative, full, matched, first, size);
    def fkss-candidate-relative(c) = nth(c, 0);
    def fkss-candidate-full(c) = nth(c, 1);
    def fkss-candidate-matched(c) = nth(c, 2);
    def fkss-candidate-first(c) = nth(c, 3);
    def fkss-candidate-size(c) = nth(c, 4);
    def fkss-empty-candidate() = fkss-candidate("", "", 0, -1, -1);
    def fkss-str-less-loop(a, b, i, n) = i >= n ? str_len(a) < str_len(b) ? 1 : 0 : {
        let aa = str_byte_at(a, i);
        let bb = str_byte_at(b, i);
        aa < bb ? 1 : aa > bb ? 0 : fkss-str-less-loop(a, b, i + 1, n);
    };
    def fkss-str-less?(a, b) = fkss-str-less-loop(a, b, 0, fkss-min(str_len(a), str_len(b)));
    // More matched atoms wins.  Equal evidence prefers the smaller source,
    // then lexical path order, so filesystem traversal order cannot choose truth.
    def fkss-candidate-better?(candidate, best) = fkss-candidate-matched(candidate) > fkss-candidate-matched(best) ? 1 : fkss-candidate-matched(candidate) < fkss-candidate-matched(best) ? 0 : fkss-candidate-size(best) < 0 || fkss-candidate-size(candidate) < fkss-candidate-size(best) ? 1 : fkss-candidate-size(candidate) > fkss-candidate-size(best) ? 0 : fkss-str-less?(fkss-candidate-relative(candidate), fkss-candidate-relative(best));
    // scan = (best inventory-count eligible-count accessible-count)
    def fkss-scan(best, inventory, eligible, accessible) = list(best, inventory, eligible, accessible);
    def fkss-scan-best(s) = nth(s, 0);
    def fkss-scan-inventory(s) = nth(s, 1);
    def fkss-scan-eligible(s) = nth(s, 2);
    def fkss-scan-accessible(s) = nth(s, 3);
    def fkss-search-rows-loop(root, rows, atoms, best, inventory, eligible, accessible) = nil?(rows) ? fkss-scan(best, inventory, eligible, accessible) : {
        let relative = nth(head(rows), 0);
        let full = fs-path-join(root, relative);
        let is-source = fkss-knowledge-extension?(relative);
        (Comparable) is-source == 0 ? fkss-search-rows-loop(root, tail(rows), atoms, best, inventory + 1, eligible, accessible) : {
            let size = fs-stat-size(full);
            let can-read = size >= 0 ? 1 : 0;
            let observed = (Comparable) can-read == 1 ? fkss-observe-atoms(full, atoms) : list(0, -1);
            let candidate = fkss-candidate(relative, full, nth(observed, 0), nth(observed, 1), size);
            let next-best = nth(observed, 0) > 0 && (Comparable) fkss-candidate-better?(candidate, best) == 1 ? candidate : best;
            fkss-search-rows-loop(root, tail(rows), atoms, next-best, inventory + 1, eligible + 1, accessible + can-read);
        };
    };
    def fkss-search-rows(root, rows, atoms) = fkss-search-rows-loop(root, rows, atoms, fkss-empty-candidate(), 0, 0, 0);
    // Fold SHA-256 directly over bounded source slices.  The partial state is
    // at most 63 bytes; the current file is never converted to a byte list.
    def fkss-hash-file-loop(path, offset, state) = {
        let window = fbw-read-window(path, offset, fkss-window-size());
        let observed = fbw-window-observed-len(window);
        let next = sha256-stream-fold-string-from(state, fbw-window-slice(window));
        observed < fkss-window-size() ? sha256-stream-finalize(next) : fkss-hash-file-loop(path, offset + observed, next);
    };
    def fkss-source-id(path) = str_concat("sha256:", hex-encode(fkss-hash-file-loop(path, 0, sha256-stream-initial())));
    def fkss-answer-start(first, size) = fkss-min(size, fkss-max(0, first - 128));
    def fkss-answer-for(candidate) = {
        let start = fkss-answer-start(fkss-candidate-first(candidate), fkss-candidate-size(candidate));
        fs-read-slice(fkss-candidate-full(candidate), start, fkss-min(fkss-answer-limit(), fkss-candidate-size(candidate) - start));
    };
    // result = (kind status reason schema source-id source-path matched first
    //           answer inventory eligible accessible coverage-percent route
    //           model-executed source-size answer-start)
    def fkss-result(status, reason, source-id, source-path, matched, first, answer, inventory, eligible, accessible, source-size, answer-start) = list("form-knowledge-source-search-v1", status, reason, fkss-schema(), source-id, source-path, matched, first, answer, inventory, eligible, accessible, eligible <= 0 ? 0 : accessible * 100 / eligible, fkss-route(), 0, source-size, answer-start);
    def fkss-status(r) = nth(r, 1);
    def fkss-reason(r) = nth(r, 2);
    def fkss-source-id-of(r) = nth(r, 4);
    def fkss-source-path(r) = nth(r, 5);
    def fkss-matched(r) = nth(r, 6);
    def fkss-first-offset(r) = nth(r, 7);
    def fkss-answer(r) = nth(r, 8);
    def fkss-inventory-count(r) = nth(r, 9);
    def fkss-eligible-count(r) = nth(r, 10);
    def fkss-accessible-count(r) = nth(r, 11);
    def fkss-coverage-percent(r) = nth(r, 12);
    def fkss-result-route(r) = nth(r, 13);
    def fkss-model-executed(r) = nth(r, 14);
    def fkss-source-size(r) = nth(r, 15);
    def fkss-result-answer-start(r) = nth(r, 16);
    def fkss-answer-cut?(r) = !((String) fkss-status(r) == "hit") ? 0 : fkss-result-answer-start(r) > 0 || fkss-result-answer-start(r) + str_len(fkss-answer(r)) < fkss-source-size(r) ? 1 : 0;
    def fkss-search-at(root, atoms) = (Comparable) fkss-query-valid?(atoms) == 0 ? fkss-result("nothing", "invalid-query-atoms", "", "", 0, -1, "", 0, 0, 0, -1, 0) : {
        let rows = source_inventory(root, "", fkss-skip-dirs());
        let scan = fkss-search-rows(root, rows, atoms);
        let best = fkss-scan-best(scan);
        fkss-candidate-matched(best) <= 0 ? fkss-result("miss", "no-current-source-match", "", "", 0, -1, "", fkss-scan-inventory(scan), fkss-scan-eligible(scan), fkss-scan-accessible(scan), -1, 0) : fkss-result("hit", "current-source-match", fkss-source-id(fkss-candidate-full(best)), fkss-candidate-relative(best), fkss-candidate-matched(best), fkss-candidate-first(best), fkss-answer-for(best), fkss-scan-inventory(scan), fkss-scan-eligible(scan), fkss-scan-accessible(scan), fkss-candidate-size(best), fkss-answer-start(fkss-candidate-first(best), fkss-candidate-size(best)));
    };
    0;
}
