; form-cli-peer-local-source-answer.fk -- source-prefixed peer tasks become
; native current-source answers.  This is a fixed caller-owned effect: task
; text may select a concept or NodeID surface, never the body root, artifact,
; or world-admission authority.
;
; preludes: form-stdlib/form-cli-peer-direct-source-action.fk form-stdlib/form-cli-peer-source-symbol-action.fk form-stdlib/form-cli-peer-live-grammar.fk
; Proven by: form-stdlib/tests/form-cli-peer-local-source-answer-band.fk

(do
    (defn fcpalsa-version () "form-cli-peer-local-source-answer-v1")
    (defn fcpalsa-provenance () "form-cli-peer-live-source-prefix")
    (defn fcpalsa-call-id (turn)
        (str_concat "peer-local-source-" (int_to_str turn)))
    (defn fcpalsa-source-task? (kind)
        (if (eq (fcpdsa-kind-source? kind) 1) 1
            (if (str_eq kind "source-symbol") 1 0)))

    ; This is called at process birth, once.  The selected source action below
    ; receives this exact value and contains no ambient-root door.  The
    ; snapshot makes later explicit `symbol ` queries hot and model-free.
    (defn fcpalsa-source-context (root artifact snapshot epoch)
        (if (str_eq root "") (nothing)
            (list root artifact 0 (fknq-max-frame-bytes) snapshot epoch)))
    (defn fcpalsa-source-index (source-ctx)
        (if (or (nothing? source-ctx) (lt (len source-ctx) 5))
            (nothing) (nth source-ctx 4)))
    (defn fcpalsa-source-epoch (source-ctx)
        (if (or (nothing? source-ctx) (lt (len source-ctx) 6))
            0 (nth source-ctx 5)))
    (defn fcpalsa-live-source-context ()
        (do
            (let root (fhcs-default-root))
            (let artifact (fknq-default-artifact))
            (let epoch (now_unix_ms))
            (if (str_eq root "") (nothing)
                (fcpalsa-source-context root artifact
                    (sof-snapshot-build epoch
                        (list (str_concat root "/form/form-stdlib"))) epoch))))

    ; No model observation, forward, injection, or context mutation occurs in
    ; this action.  fcpdsa retains the raw strict result, PIF receipt and
    ; source-world message beside the peer ABI.
    (defn fcpalsa-run (session kind task source-ctx turn)
        (if (str_eq kind "source-symbol")
            (fcpssa-run session kind task source-ctx
                (fcpalsa-source-epoch source-ctx))
            (fcpdsa-run session kind task source-ctx (fcpalsa-call-id turn)
                (fcpalsa-provenance))))
    (defn fcpalsa-peer (result)
        (if (eq (fcpdsa-result? result) 1)
            (fcpdsa-peer result)
            (fcpssa-peer result)))
    (defn fcpalsa-signal (result)
        (if (eq (fcpdsa-result? result) 1)
            (fcpdsa-signal result) (fcpssa-signal result)))
    (defn fcpalsa-reason (result)
        (if (eq (fcpdsa-result? result) 1)
            (fcpdsa-reason result) (fcpssa-reason result)))
    (defn fcpalsa-knowledge-contribution (result)
        (if (eq (fcpdsa-result? result) 1)
            (fcpdsa-knowledge-contribution result)
            (fcpssa-knowledge-contribution result)))
    (defn fcpalsa-mutation-contribution (result)
        (if (eq (fcpdsa-result? result) 1)
            (fcpdsa-mutation-contribution result) 0))
    0)
