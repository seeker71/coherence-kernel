; living-world-shared-field-live.fk -- direct stdin cells enter one continuing
; shared field without a name registry, source fixture, or remote answer path.
;
; Input is lowercase hex over canonical cell-coordinate-stream roots.  A small
; root may occupy one line.  A larger root travels as bounded canonical chunk
; cells, one per line, because the temporary host read_line carrier has a
; finite line window.  Every chunk is identity-, order-, and size-checked and
; framebuffer-visible before exact reassembly.  Hex keeps arbitrary string
; bytes, including newlines, inside the canonical carrier.  CCS restores exact
; content identity and consults no Blueprint-name registry.  Malformed,
; noncanonical, unknown-shaped, and mismatched-action inputs remain explicit
; refusals rather than invented cells.
;
; The first cell is process configuration: recurrence threshold, arbitrary
; offered action, optional inert continuity image plus exact fresh restore
; entries, optional append-new persistence prefix, optional exact close cell,
; and evidence.  Configuration grants no semantic authority.  A prior image
; remains inert unless the existing fresh-holder restore membrane returns ONE.
;
; Every later cell crosses living-world-shared-field-channel.  A consented
; generative-continuation request additionally reconstructs its answer from the
; successor world.  An optional projection cell requests a hex CCS projection
; of that trace; absence emits only privacy-safe counts.  Each input may leave
; an append-new image `<prefix>.<ordinal>.ccs`; no snapshot is overwritten.
;
; The live loop emits an attributed framebuffer cell before waiting for every
; line, after open, after admission, during every continuation turn, and at
; close.  Its text status never contains offered payload or rendered voice.
; witnessed: 2026-08-09 -> live 2097151, atomic 63
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-session-observation.fk form-stdlib/living-world-session-learning.fk form-stdlib/living-world-shared-field-channel.fk form-stdlib/living-world-shared-field-continuity.fk form-stdlib/living-world-generative-continuation.fk

(let LWSFL-OPEN    (bp "LWSFL-OPEN"))
(let LWSFL-SESSION (bp "LWSFL-SESSION"))
(let LWSFL-RECEIPT (bp "LWSFL-RECEIPT"))
(let LWSFL-CHUNK   (bp "LWSFL-CHUNK"))

(defn lwsfl-hex-digit (byte)
    (if (and (ge byte 48) (le byte 57)) (sub byte 48)
        (if (and (ge byte 97) (le byte 102))
            (add (sub byte 97) 10) (sub 0 1))))
(defn lwsfl-hex-valid-loop (text at)
    (if (ge at (str_len text)) 1
        (if (lt (lwsfl-hex-digit (str_byte_at text at)) 0) 0
            (lwsfl-hex-valid-loop text (add at 1)))))
(defn lwsfl-hex-valid? (text)
    (if (and (gt (str_len text) 0)
             (eq (mod (str_len text) 2) 0))
        (lwsfl-hex-valid-loop text 0) 0))
(defn lwsfl-hex-char (value)
    (if (lt value 10) (byte_to_str (add 48 value))
        (byte_to_str (add 87 value))))
(defn lwsfl-hex-encode (bytes text)
    (if (eq (len bytes) 0) text
        (do
            (let byte (head bytes))
            (lwsfl-hex-encode (tail bytes)
                (str_concat text
                    (str_concat (lwsfl-hex-char (div byte 16))
                        (lwsfl-hex-char (mod byte 16))))))))
(defn lwsfl-hex-decode-loop (text at bytes)
    (if (ge at (str_len text)) (reverse bytes)
        (lwsfl-hex-decode-loop text (add at 2)
            (cons (add
                    (mul (lwsfl-hex-digit (str_byte_at text at)) 16)
                    (lwsfl-hex-digit (str_byte_at text (add at 1))))
                bytes))))
(defn lwsfl-hex-decode (text)
    (lwsfl-hex-decode-loop text 0 (empty)))

(defn lwsfl-string-bytes-loop (text at acc)
    (if (ge at (str_len text)) (reverse acc)
        (lwsfl-string-bytes-loop text (add at 1)
            (cons (str_byte_at text at) acc))))
(defn lwsfl-string-bytes (text)
    (lwsfl-string-bytes-loop text 0 (empty)))
(defn lwsfl-bytes-string (bytes text)
    (if (eq (len bytes) 0) text
        (lwsfl-bytes-string (tail bytes)
            (str_concat text (byte_to_str (head bytes))))))
(defn lwsfl-hex-cell (cell)
    (lwsfl-hex-encode (lwsfl-string-bytes (ccs-emit cell)) ""))

; Result: canonical?, decoded cell or none, decoded CCS text or empty.
(defn lwsfl-decode-line (line)
    (if (or (eq (str_len line) 0)
            (eq (lwsfl-hex-valid? line) 0))
        (list 0 (lwo-none) "")
        (do
            (let bytes (lwsfl-hex-decode line))
            (let canonical-hex (lwsfl-hex-encode bytes ""))
            (let text (lwsfl-bytes-string bytes ""))
            (if (or (not (str_eq canonical-hex line))
                    (eq (ccs-canonical? text) 0))
                (list 0 (lwo-none) "")
                (list 1 (ccs-decode text) text)))))
(defn lwsfl-decoded-canonical? (decoded) (nth decoded 0))
(defn lwsfl-decoded-cell (decoded) (nth decoded 1))

; A chunk carries only an opaque fragment of an enclosing canonical hex root.
; The transfer cell is arbitrary and has no semantic authority.  Exact
; transfer identity, ordinal continuity, a 0/1 final bit, lowercase hex, and a
; conservative 1024-byte fragment ceiling are all required before assembly.
(defn lwsfl-chunk (transfer ordinal final fragment)
    (intern_node LWSFL-CHUNK
        (list transfer (intern_trivial_int ordinal)
            (intern_trivial_int final) (intern_trivial_string fragment)
            (lwo-local-path))))
(defn lwsfl-chunk? (cell)
    (if (and (eq (lwo-category? cell LWSFL-CHUNK) 1)
             (eq (len (node_children cell)) 5)) 1 0))
(defn lwsfl-chunk-transfer (chunk) (nth (node_children chunk) 0))
(defn lwsfl-chunk-ordinal-cell (chunk) (nth (node_children chunk) 1))
(defn lwsfl-chunk-final-cell (chunk) (nth (node_children chunk) 2))
(defn lwsfl-chunk-fragment-cell (chunk) (nth (node_children chunk) 3))
(defn lwsfl-chunk-ordinal (chunk)
    (node_value (lwsfl-chunk-ordinal-cell chunk)))
(defn lwsfl-chunk-final (chunk)
    (node_value (lwsfl-chunk-final-cell chunk)))
(defn lwsfl-chunk-fragment (chunk)
    (node_value (lwsfl-chunk-fragment-cell chunk)))
(defn lwsfl-chunk-cells-valid? (chunk)
    (if (eq (lwsg-int-cell? (lwsfl-chunk-ordinal-cell chunk)) 0) 0
        (if (eq (lwsg-int-cell? (lwsfl-chunk-final-cell chunk)) 0) 0
            (lwsfl-string-cell? (lwsfl-chunk-fragment-cell chunk)))))
(defn lwsfl-chunk-meta-valid? (chunk)
    (if (lt (lwsfl-chunk-ordinal chunk) 0) 0
        (if (or (eq (lwsfl-chunk-final chunk) 0)
                (eq (lwsfl-chunk-final chunk) 1)) 1 0)))
(defn lwsfl-chunk-fragment-valid? (chunk)
    (if (gt (str_len (lwsfl-chunk-fragment chunk)) 1024) 0
        (lwsfl-hex-valid? (lwsfl-chunk-fragment chunk))))
(defn lwsfl-chunk-valid? (chunk)
    (if (eq (lwsfl-chunk? chunk) 0) 0
        (if (eq (lwsfl-chunk-cells-valid? chunk) 0) 0
            (if (eq (lwsfl-chunk-meta-valid? chunk) 0) 0
                (lwsfl-chunk-fragment-valid? chunk)))))

; Result: eof?, decoded root, accepted carrier-frame count, assembled hex bytes.
(defn lwsfl-carrier-result (eof decoded frames bytes)
    (list eof decoded frames bytes))
(defn lwsfl-carrier-eof? (result) (nth result 0))
(defn lwsfl-carrier-decoded (result) (nth result 1))
(defn lwsfl-carrier-frames (result) (nth result 2))
(defn lwsfl-carrier-bytes (result) (nth result 3))

(defn lwsfl-invalid-decoded () (list 0 (lwo-none) ""))

(defn lwsfl-chunk-progress (ordinal bytes)
    (lcfb-cat (list
        "chunk:" (int_to_str ordinal)
        ":hex-bytes:" (int_to_str bytes))))

(defn lwsfl-carrier-invalid (frames assembled)
    (lwsfl-carrier-result 0 (lwsfl-invalid-decoded)
        frames (str_len assembled)))

(defn lwsfl-expected-chunk? (chunk transfer expected)
    (if (eq (lwsfl-chunk-valid? chunk) 0) 0
        (if (not (node_eq (lwsfl-chunk-transfer chunk) transfer)) 0
            (if (eq (lwsfl-chunk-ordinal chunk) expected) 1 0))))

(defn lwsfl-observe-chunk (ordinal bytes started source-ordinal modifier)
    (lcfb-call-stream "living-world-shared-field-live" "carrier"
        "modify" "form-native" modifier
        (lwsfl-chunk-progress ordinal bytes) source-ordinal started
        "form/form-stdlib/living-world-shared-field-live.fk"
        164 5))

(defn lwsfl-finish-chunk
    (chunk transfer expected next frames started base-ordinal)
    (if (eq (lwsfl-chunk-final chunk) 1)
        (lwsfl-carrier-result 0 (lwsfl-decode-line next)
            (add frames 1) (str_len next))
        (lwsfl-read-next-chunk transfer (add expected 1) next
            (add frames 1) started base-ordinal)))

(defn lwsfl-accept-next-chunk
    (chunk transfer expected assembled frames started base-ordinal)
    (do
        (let next (str_concat assembled (lwsfl-chunk-fragment chunk)))
        (let observed
            (lwsfl-observe-chunk expected (str_len next) started
                (add base-ordinal (add (mul expected 2) 1))
                "lwsfl-accept-next-chunk"))
        (lwsfl-finish-chunk chunk transfer expected next frames
            started base-ordinal)))

(defn lwsfl-handle-next-decoded
    (decoded transfer expected assembled frames started base-ordinal)
    (if (eq (lwsfl-decoded-canonical? decoded) 0)
        (lwsfl-carrier-invalid frames assembled)
        (do
            (let chunk (lwsfl-decoded-cell decoded))
            (if (eq (lwsfl-expected-chunk?
                        chunk transfer expected) 0)
                (lwsfl-carrier-invalid frames assembled)
                (lwsfl-accept-next-chunk chunk transfer expected
                    assembled frames started base-ordinal)))))

(defn lwsfl-read-next-chunk
    (transfer expected assembled frames started base-ordinal)
    (do
        (let awaiting
            (lcfb-call-stream "living-world-shared-field-live" "carrier"
                "enter" "form-native" "read-line"
                (lcfb-cat (list "await-chunk:" (int_to_str expected)))
                (add base-ordinal (mul expected 2)) started
                "form/form-stdlib/living-world-shared-field-live.fk"
                205 13))
        (let raw (read_line))
        (if (lt raw 0)
            (lwsfl-carrier-result 1 (lwsfl-invalid-decoded)
                frames (str_len assembled))
            (lwsfl-handle-next-decoded (lwsfl-decode-line raw)
                transfer expected assembled frames started base-ordinal))))

(defn lwsfl-start-chunk (chunk started base-ordinal)
    (do
        (let assembled (lwsfl-chunk-fragment chunk))
        (let observed
            (lwsfl-observe-chunk 0 (str_len assembled) started
                (add base-ordinal 1) "lwsfl-start-chunk"))
        (lwsfl-finish-chunk chunk (lwsfl-chunk-transfer chunk) 0
            assembled 0 started (add base-ordinal 2))))

(defn lwsfl-handle-first-decoded (decoded raw started base-ordinal)
    (if (eq (lwsfl-decoded-canonical? decoded) 0)
        (lwsfl-carrier-result 0 decoded 1 (str_len raw))
        (do
            (let cell (lwsfl-decoded-cell decoded))
            (if (eq (lwsfl-chunk? cell) 0)
                (lwsfl-carrier-result 0 decoded 1 (str_len raw))
                (if (eq (lwsfl-chunk-valid? cell) 0)
                    (lwsfl-carrier-invalid 0 "")
                    (if (not (eq (lwsfl-chunk-ordinal cell) 0))
                        (lwsfl-carrier-invalid 0 "")
                        (lwsfl-start-chunk cell started base-ordinal)))))))

(defn lwsfl-read-first-line (raw started base-ordinal)
    (lwsfl-handle-first-decoded (lwsfl-decode-line raw)
        raw started base-ordinal))

(defn lwsfl-read-cell (started base-ordinal target)
    (do
        (let awaiting
            (lcfb-call-stream "living-world-shared-field-live" "carrier"
                "enter" "form-native" "read-line" target base-ordinal
                started "form/form-stdlib/living-world-shared-field-live.fk"
                247 13))
        (let raw (read_line))
        (if (lt raw 0)
            (lwsfl-carrier-result 1 (lwsfl-invalid-decoded) 0 0)
            (lwsfl-read-first-line raw started (add base-ordinal 1)))))

(defn lwsfl-frame-end (at length)
    (if (gt (add at 1024) length) length (add at 1024)))
(defn lwsfl-emit-framed-hex-loop (hex transfer at ordinal)
    (do
        (let length (str_len hex))
        (let end (lwsfl-frame-end at length))
        (let final (if (eq end length) 1 0))
        (let fragment (substring hex at end))
        (let emitted
            (print_str
                (lwsfl-hex-cell
                    (lwsfl-chunk transfer ordinal final fragment))))
        (if (eq final 1) (add ordinal 1)
            (lwsfl-emit-framed-hex-loop
                hex transfer end (add ordinal 1)))))
(defn lwsfl-emit-framed-cell (cell transfer)
    (lwsfl-emit-framed-hex-loop
        (lwsfl-hex-cell cell) transfer 0 0))
(defn lwsfl-emit-cell (cell transfer)
    (do
        (let hex (lwsfl-hex-cell cell))
        (if (le (str_len hex) 4096)
            (do
                (let emitted (print_str hex))
                1)
            (lwsfl-emit-framed-hex-loop hex transfer 0 0))))

; children: threshold, arbitrary action, optional inert image, optional image
; entry, fresh response-entry field, optional persistence-prefix string,
; optional exact close cell, evidence, local path
(defn lwsfl-open
    (threshold action image image-entry responses persist-prefix close evidence)
    (intern_node LWSFL-OPEN
        (list (intern_trivial_int threshold) action image image-entry responses
              persist-prefix close evidence (lwo-local-path))))
(defn lwsfl-open? (cell)
    (if (and (eq (lwo-category? cell LWSFL-OPEN) 1)
             (eq (len (node_children cell)) 9)) 1 0))
(defn lwsfl-open-threshold-cell (open) (nth (node_children open) 0))
(defn lwsfl-open-threshold (open)
    (node_value (lwsfl-open-threshold-cell open)))
(defn lwsfl-open-action (open) (nth (node_children open) 1))
(defn lwsfl-open-image (open) (nth (node_children open) 2))
(defn lwsfl-open-image-entry (open) (nth (node_children open) 3))
(defn lwsfl-open-responses (open) (nth (node_children open) 4))
(defn lwsfl-open-persist-prefix (open) (nth (node_children open) 5))
(defn lwsfl-open-close (open) (nth (node_children open) 6))
(defn lwsfl-open-evidence (open) (nth (node_children open) 7))
(defn lwsfl-string-cell? (cell)
    (if (and (eq (node_level cell) 1) (eq (node_type cell) 2)) 1 0))
(defn lwsfl-prefix-valid? (prefix)
    (if (node_eq prefix (lwo-none)) 1
        (if (and (eq (lwsfl-string-cell? prefix) 1)
                 (gt (str_len (node_value prefix)) 0)) 1 0)))
(defn lwsfl-open-valid? (open)
    (if (eq (lwsfl-open? open) 0) 0
        (if (eq (lwsg-int-cell? (lwsfl-open-threshold-cell open)) 0) 0
            (if (lt (lwsfl-open-threshold open) 1) 0
                (if (eq (lwo-category?
                            (lwsfl-open-responses open) LWO-FIELD) 0) 0
                    (lwsfl-prefix-valid?
                        (lwsfl-open-persist-prefix open)))))))

; children: current state or none, exact open cell, effective ack, optional
; restore result, local path
(defn lwsfl-session (state open ack restore)
    (intern_node LWSFL-SESSION
        (list state open ack restore (lwo-local-path))))
(defn lwsfl-session? (cell) (lwo-category? cell LWSFL-SESSION))
(defn lwsfl-session-state (session) (nth (node_children session) 0))
(defn lwsfl-session-open (session) (nth (node_children session) 1))
(defn lwsfl-session-ack (session) (nth (node_children session) 2))
(defn lwsfl-session-restore (session) (nth (node_children session) 3))

(defn lwsfl-open-cell (open)
    (if (eq (lwsfl-open-valid? open) 0)
        (lwsfl-session (lwo-none) open (oac-zero) (lwo-none))
        (if (node_eq (lwsfl-open-image open) (lwo-none))
            (do
                (let state
                    (lwsf-open (lwsfl-open-threshold open)
                        (lwsfl-open-action open)))
                (lwsfl-session state open (oac-one state) (lwo-none)))
            (do
                (let restored
                    (lwsfc-restore (lwsfl-open-image open)
                        (lwsfl-open-image-entry open)
                        (lwo-field-items (lwsfl-open-responses open))
                        (lwsfl-open-threshold open)
                        (lwsfl-open-action open)))
                (lwsfl-session (lwsfc-result-state restored) open
                    (lwsfc-result-ack restored) restored)))))

(defn lwsfl-open-decoded (decoded)
    (if (eq (lwsfl-decoded-canonical? decoded) 0)
        (lwsfl-session (lwo-none) (lwo-none) (oac-zero) (lwo-none))
        (lwsfl-open-cell (lwsfl-decoded-cell decoded))))

(defn lwsfl-open-line (line)
    (lwsfl-open-decoded (lwsfl-decode-line line)))

(defn lwsfl-open-progress (session)
    (lcfb-cat (list
        "shape:" (int_to_str
            (lwsfl-open? (lwsfl-session-open session)))
        ":valid:" (int_to_str
            (lwsfl-open-valid? (lwsfl-session-open session)))
        ":"
        "ack:" (int_to_str (oac-kind (lwsfl-session-ack session)))
        ":state:" (if (node_eq (lwsfl-session-state session) (lwo-none))
            "0" "1")
        ":restored:" (if (node_eq (lwsfl-session-restore session) (lwo-none))
            "0" "1"))))

(defn lwsfl-carrier-suffix (carrier)
    (lcfb-cat (list
        ":carrier-frames:" (int_to_str (lwsfl-carrier-frames carrier))
        ":carrier-hex-bytes:" (int_to_str (lwsfl-carrier-bytes carrier)))))

(defn lwsfl-open-observed (carrier started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-shared-field-live" "open" "enter"
                "form-native" "lwsfl-open-decoded" "hex-ccs-open-cell" ordinal
                started "form/form-stdlib/living-world-shared-field-live.fk"
                378 13))
        (let session
            (lwsfl-open-decoded (lwsfl-carrier-decoded carrier)))
        (let left
            (lcfb-call-stream "living-world-shared-field-live" "open" "leave"
                "form-native" "lwsfl-open-cell"
                (lcfb-cat (list (lwsfl-open-progress session)
                    (lwsfl-carrier-suffix carrier)))
                (add ordinal 1) started
                "form/form-stdlib/living-world-shared-field-live.fk"
                385 13))
        session))

(defn lwsfl-step-request (step)
    (if (or (node_eq step (lwo-none))
            (eq (lwsf-world-entry? (lwsf-step-input step)) 0))
        (lwo-none)
        (if (eq (oac-one? (lwsf-step-ack step)) 0) (lwo-none)
            (do
                (let payload
                    (lwo-offer-payload
                        (lwt-entry-offer (lwsf-step-input step))))
                (if (eq (lwsg-request? payload) 1) payload (lwo-none))))))

(defn lwsfl-snapshot-path (open ordinal)
    (if (node_eq (lwsfl-open-persist-prefix open) (lwo-none)) ""
        (str_concat (node_value (lwsfl-open-persist-prefix open))
            (str_concat "."
                (str_concat (int_to_str ordinal) ".ccs")))))
(defn lwsfl-persist (session ordinal)
    (do
        (let path (lwsfl-snapshot-path (lwsfl-session-open session) ordinal))
        (if (str_eq path "") (lwo-none)
            (lwcd-save-new path
                (lwsfc-image (lwsfl-session-state session))
                (lwsfl-open-evidence (lwsfl-session-open session))))))

; children: canonical flag, decoded input or none, prior session, successor
; session, step or none, generative trace or none, persistence result or none,
; local path
(defn lwsfl-receipt
    (canonical input prior session step trace persistence)
    (intern_node LWSFL-RECEIPT
        (list (intern_trivial_int canonical) input prior session step trace
              persistence (lwo-local-path))))
(defn lwsfl-receipt? (cell) (lwo-category? cell LWSFL-RECEIPT))
(defn lwsfl-receipt-canonical? (receipt)
    (node_value (nth (node_children receipt) 0)))
(defn lwsfl-receipt-input (receipt) (nth (node_children receipt) 1))
(defn lwsfl-receipt-prior (receipt) (nth (node_children receipt) 2))
(defn lwsfl-receipt-session (receipt) (nth (node_children receipt) 3))
(defn lwsfl-receipt-step (receipt) (nth (node_children receipt) 4))
(defn lwsfl-receipt-trace (receipt) (nth (node_children receipt) 5))
(defn lwsfl-receipt-persistence (receipt) (nth (node_children receipt) 6))
(defn lwsfl-receipt-ack (receipt)
    (if (node_eq (lwsfl-receipt-step receipt) (lwo-none)) (oac-zero)
        (lwsf-step-ack (lwsfl-receipt-step receipt))))

(defn lwsfl-refused-receipt (session)
    (lwsfl-receipt 0 (lwo-none) session session (lwo-none) (lwo-none)
        (lwo-none)))

(defn lwsfl-accept-decoded (session input started ordinal)
    (do
        (let step
            (lwsf-apply-observed (lwsfl-session-state session) input started
                (mul ordinal 16)))
        (let next-state (lwsf-step-state step))
        (let next-session
            (lwsfl-session next-state (lwsfl-session-open session)
                (lwsf-step-ack step) (lwsfl-session-restore session)))
        (let request (lwsfl-step-request step))
        (let trace
            (if (node_eq request (lwo-none)) (lwo-none)
                (lwsg-generate-observed (lwsf-state-world next-state)
                    request started (add (mul ordinal 32) 2))))
        (let persistence (lwsfl-persist next-session ordinal))
        (lwsfl-receipt 1 input session next-session step trace persistence)))

(defn lwsfl-accept-line (session line started ordinal)
    (do
        (let decoded (lwsfl-decode-line line))
        (if (eq (lwsfl-decoded-canonical? decoded) 0)
            (lwsfl-refused-receipt session)
            (lwsfl-accept-decoded session
                (lwsfl-decoded-cell decoded) started ordinal))))

(defn lwsfl-trace-ack-kind (trace)
    (if (node_eq trace (lwo-none)) 0
        (oac-kind (lwsg-trace-ack trace))))
(defn lwsfl-trace-turn-count (trace)
    (if (node_eq trace (lwo-none)) 0
        (len (lwsg-turn-items (lwsg-trace-turns trace)))))
(defn lwsfl-trace-voice-bytes (trace)
    (if (node_eq trace (lwo-none)) 0
        (str_len (lwsg-trace-rendered trace))))
(defn lwsfl-persisted? (persistence)
    (if (node_eq persistence (lwo-none)) 0
        (lwcd-saved? persistence)))
(defn lwsfl-receipt-target (receipt)
    (do
        (let state
            (lwsfl-session-state (lwsfl-receipt-session receipt)))
        (let trace (lwsfl-receipt-trace receipt))
        (lcfb-cat (list
            "canonical:" (int_to_str (lwsfl-receipt-canonical? receipt))
            ":ack:" (int_to_str (oac-kind (lwsfl-receipt-ack receipt)))
            ":cells:" (int_to_str (lwo-field-size
                (lwo-world-cells (lwsf-state-world state))))
            ":trace-ack:" (int_to_str (lwsfl-trace-ack-kind trace))
            ":turns:" (int_to_str (lwsfl-trace-turn-count trace))
            ":voice-bytes:" (int_to_str (lwsfl-trace-voice-bytes trace))
            ":persisted:" (int_to_str
                (lwsfl-persisted? (lwsfl-receipt-persistence receipt)))))))
(defn lwsfl-status-line (phase ordinal target)
    (lcfb-cat (list
        "living-world-live|schema=v1|phase=" phase
        "|ordinal=" (int_to_str ordinal)
        "|" target)))

(defn lwsfl-project (trace)
    (if (or (node_eq trace (lwo-none))
            (node_eq
                (lwsg-request-projection (lwsg-trace-request trace))
                (lwo-none))) 0
        (print_str (str_concat "living-world-projection|schema=v1|hex-ccs="
            (lwsfl-hex-cell trace)))))

(defn lwsfl-close-offered? (session input)
    (do
        (let close (lwsfl-open-close (lwsfl-session-open session)))
        (if (node_eq close (lwo-none)) 0
            (if (node_eq close input) 1 0))))

(defn lwsfl-close-live (ordinal started target status-target)
    (do
        (let left
            (lcfb-call-stream "living-world-shared-field-live" "ingress"
                "leave" "form-native" "read-line" target
                (add (mul ordinal 64) 1) started
                "form/form-stdlib/living-world-shared-field-live.fk"
                518 13))
        (let emitted
            (print_str (lwsfl-status-line "closed" ordinal status-target)))
        ordinal))

(defn lwsfl-live-receipt (session decoded started ordinal)
    (if (eq (lwsfl-decoded-canonical? decoded) 0)
        (lwsfl-refused-receipt session)
        (lwsfl-accept-decoded session (lwsfl-decoded-cell decoded)
            started ordinal)))

(defn lwsfl-continue-live (session decoded carrier ordinal started)
    (do
        (let receipt (lwsfl-live-receipt session decoded started ordinal))
        (let target
            (lcfb-cat (list (lwsfl-receipt-target receipt)
                (lwsfl-carrier-suffix carrier))))
        (let modified
            (lcfb-call-stream "living-world-shared-field-live" "ingress"
                "modify" "form-native" "lwsfl-accept-line" target
                (add (mul ordinal 64) 1) started
                "form/form-stdlib/living-world-shared-field-live.fk"
                540 13))
        (let emitted
            (print_str (lwsfl-status-line "accepted" ordinal target)))
        (let projection (lwsfl-project (lwsfl-receipt-trace receipt)))
        (lwsfl-loop (lwsfl-receipt-session receipt)
            (add ordinal 1) started)))

(defn lwsfl-handle-live-carrier (session carrier ordinal started)
    (do
        (let decoded (lwsfl-carrier-decoded carrier))
        (let close
            (if (eq (lwsfl-decoded-canonical? decoded) 1)
                (lwsfl-close-offered? session
                    (lwsfl-decoded-cell decoded)) 0))
        (if (eq close 1)
            (lwsfl-close-live ordinal started "offered-close-cell"
                "carrier:offered-cell")
            (lwsfl-continue-live session decoded carrier ordinal started))))

(defn lwsfl-loop (session ordinal started)
    (do
        (let carrier
            (lwsfl-read-cell started (mul ordinal 1024)
                "await-hex-ccs-cell"))
        (if (eq (lwsfl-carrier-eof? carrier) 1)
            (lwsfl-close-live ordinal started "carrier-eof" "carrier:eof")
            (lwsfl-handle-live-carrier session carrier ordinal started))))

(defn lwsfl-live ()
    (do
        (let started
            (lcfb-open-stream "living-world-shared-field-live"
                "form-native" "lwsfl-live" "await-open-cell"
                "form/form-stdlib/living-world-shared-field-live.fk"
                575 13))
        (let announced
            (print_str (lwsfl-status-line "await-open" 0
                "carrier:hex-ccs")))
        (let carrier
            (lwsfl-read-cell started 1 "await-open-cell"))
        (if (eq (lwsfl-carrier-eof? carrier) 1) 0
            (do
                (let session (lwsfl-open-observed carrier started 128))
                (let emitted
                    (print_str (lwsfl-status-line "opened" 0
                        (lcfb-cat (list (lwsfl-open-progress session)
                            (lwsfl-carrier-suffix carrier))))))
                (if (node_eq (lwsfl-session-state session) (lwo-none)) 0
                    (lwsfl-loop session 1 started))))))

0
