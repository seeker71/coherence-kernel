; form-cli-lora-cover-run.fk — train overlay, sweep N, print remaining.
;
; Lens curve at tn=1 and tn=2 (heldout 72). Lane at tn=1 (heldout 369).
; Full lens corpus 12/4 trains overlay and reseeds A/B. fqt-lora? stays 0.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint-xtal.fk
; preludes: form-stdlib/form-cli-lane-mint-xtal.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk
; preludes: form-stdlib/form-cli-lora-corpus-xtal.fk
; preludes: form-stdlib/form-cli-lora-cover-xtal.fk

(do
    (let a1 (fco-lens-at 1))
    (let a2 (fco-lens-at 2))
    (let lane (fco-lane-at 1))
    (let rows (fls-corpus 12 4))
    (let trained (fls-heldout-correct rows))
    (let held (fls-count-split rows (SplitHeldout)))
    (let fuel (flc-fuel rows))
    (let pair (flw-from-sample fuel (flc-dim)))
    (let w (flw-write (AdapterPath) (nth pair 0) (nth pair 1)))
    (print_str (str_concat "fco lens-tn1=" (str_concat (int_to_str (fco-nth a1 0)) (str_concat " n=" (str_concat (int_to_str (fco-nth a1 1)) (str_concat " hit=" (str_concat (int_to_str (fco-nth a1 2)) (str_concat "/" (str_concat (int_to_str (fco-nth a1 3)) (str_concat " ppm=" (str_concat (int_to_str (fco-nth a1 4)) "\n")))))))))))
    (print_str (str_concat "fco lens-tn2=" (str_concat (int_to_str (fco-nth a2 0)) (str_concat " n=" (str_concat (int_to_str (fco-nth a2 1)) (str_concat " hit=" (str_concat (int_to_str (fco-nth a2 2)) (str_concat "/" (str_concat (int_to_str (fco-nth a2 3)) (str_concat " ppm=" (str_concat (int_to_str (fco-nth a2 4)) "\n")))))))))))
    (print_str (str_concat "fco lane-tn1=" (str_concat (int_to_str (fco-nth lane 0)) (str_concat " n=" (str_concat (int_to_str (fco-nth lane 1)) (str_concat " hit=" (str_concat (int_to_str (fco-nth lane 2)) (str_concat "/" (str_concat (int_to_str (fco-nth lane 3)) (str_concat " ppm=" (str_concat (int_to_str (fco-nth lane 4)) "\n")))))))))))
    (print_str (str_concat "fco lens-train-12-4 hit=" (str_concat (int_to_str trained) (str_concat "/" (str_concat (int_to_str held) (str_concat " ppm=" (str_concat (int_to_str (fco-ppm trained held)) "\n")))))))
    (print_str (str_concat "fco more-tn-most=" (str_concat (int_to_str (fco-more-tn (fco-nth a1 4) (fco-nth a2 4) 1 2 (TargetMostPpm))) "\n")))
    (print_str (str_concat "fco more-tn-local=" (str_concat (int_to_str (fco-more-tn (fco-nth a1 4) (fco-nth a2 4) 1 2 (TargetLocalPpm))) "\n")))
    (print_str (str_concat "fco lane-need-hits-990k=" (str_concat (int_to_str (fco-need-hits (fco-nth lane 2) (fco-nth lane 3) (TargetLocalPpm))) "\n")))
    (print_str (str_concat "fco session-ppm=" (str_concat (int_to_str (fco-session-ppm)) "\n")))
    (print_str (str_concat "fco session-need-events=" (str_concat (int_to_str (fco-need-events)) "\n")))
    (print_str (str_concat "fco adapter=" (str_concat (int_to_str (flw-written (AdapterPath))) "\n")))
    (print_str (str_concat "fco fqt-lora=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "fco check=" (str_concat (int_to_str (fco-check)) "\n")))
    0)
