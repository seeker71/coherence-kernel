; living-world-native-voice.fk -- consented symbols give composition a surface.
;
; The emitter owns no vocabulary, language taxonomy, grammar table, or answer
; set. A symbol is an offered cell binding an exact referent, optional
; coordinate, and exact surface segment. This compatibility emitter selects
; only the numeric-position lens from an authority-minimized context, sorts it,
; refuses duplicate positions, and joins the surfaces. Relational voice is free
; to compose the same symbols without numeric coordinates.
;
; An utterance retains the integrated execution basis, referent, ordered symbol
; sequence, rendered text, complete minimized context, alternatives, unknowable
; remainder, choice, and evidence. Rendering is local Form composition, not a
; remote model call. Admission is a separate unanimous boundary governed by
; every active basis holder, symbol holder, and capability holder. Revoking a
; grant makes the prior context and utterance proposal stale without erasing it.
;
; This is a native text-surface floor, not yet an autonomous generative mind.
; living-world-symbol-learning can now supply current recurrence-derived symbol
; candidates, but the underlying surface observations and absolute positions
; still arrive from participants. Relative-order/grammar relations and plans
; learned from interaction remain the next movement.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk

(let LWNV-SEQUENCE  (bp "LWNV-SEQUENCE"))
(let LWNV-UTTERANCE (bp "LWNV-UTTERANCE"))
(let LWNV-ORIGIN    (bp "LWNV-ORIGIN"))

(defn lwnv-symbol-from-cell (world cell)
    (if (and (eq (lwnv-positioned-symbol-valid? cell) 1)
             (eq (lwo-active? world cell) 1)) cell
        (if (eq (lwsl-integrated-current? world cell) 1)
            (if (eq (lwnv-positioned-symbol-valid?
                       (lwo-emergent-shape cell)) 1)
                (lwo-emergent-shape cell) (lwo-none))
            (lwo-none))))

(defn lwnv-symbols-for-items (world items referent acc)
    (if (eq (len items) 0) acc
        (do
            (let cell (head items))
            (let symbol (lwnv-symbol-from-cell world cell))
            (lwnv-symbols-for-items world (tail items) referent
                (if (and (not (node_eq symbol (lwo-none)))
                         (and (node_eq
                                (lwnv-symbol-referent symbol) referent)
                              (eq (lwo-member? acc symbol) 0)))
                    (cons symbol acc) acc)))))

(defn lwnv-insert-symbol (symbol items)
    (if (eq (len items) 0) (list symbol)
        (if (lt (lwnv-symbol-position symbol)
                (lwnv-symbol-position (head items)))
            (cons symbol items)
            (cons (head items)
                (lwnv-insert-symbol symbol (tail items))))))

(defn lwnv-sort-symbols (items acc)
    (if (eq (len items) 0) acc
        (lwnv-sort-symbols (tail items)
            (lwnv-insert-symbol (head items) acc))))

(defn lwnv-unique-positions? (items)
    (if (or (eq (len items) 0)
            (eq (len (tail items)) 0)) 1
        (if (eq (lwnv-symbol-position (head items))
                (lwnv-symbol-position (head (tail items)))) 0
            (lwnv-unique-positions? (tail items)))))

(defn lwnv-sequence (items) (intern_node LWNV-SEQUENCE items))
(defn lwnv-sequence? (cell) (lwo-category? cell LWNV-SEQUENCE))
(defn lwnv-sequence-items (sequence) (node_children sequence))

(defn lwnv-sequence-for (world referent)
    (do
        (let items
            (lwnv-sort-symbols
                (lwnv-symbols-for-items world
                    (lwo-field-items (lwo-world-cells world))
                    referent (list))
                (list)))
        (if (or (eq (len items) 0)
                (eq (lwnv-unique-positions? items) 0))
            (lwo-none) (lwnv-sequence items))))

(defn lwnv-render-items (items text)
    (if (eq (len items) 0) text
        (lwnv-render-items (tail items)
            (str_concat text
                (lwnv-symbol-surface (head items))))))

(defn lwnv-render (sequence)
    (lwnv-render-items (lwnv-sequence-items sequence) ""))

(defn lwnv-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwnv-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwnv-symbol-attributions (world symbol)
    (if (eq (lwo-active? world symbol) 1)
        (lwo-active-attributions-for world symbol)
        (do
            (let candidate
                (lwsl-current-candidate-for-symbol world symbol))
            (if (node_eq candidate (lwo-none)) (lwo-empty-field)
                (lwo-active-attributions-for world candidate)))))

(defn lwnv-symbol-witnesses (world items field)
    (if (eq (len items) 0) field
        (lwnv-symbol-witnesses world (tail items)
            (lwnv-field-union-items
                (lwo-field-items
                    (lwnv-symbol-attributions world (head items)))
                field))))

; A minimized context can deliberately omit later, ungranted observations.
; Freshness therefore checks every learned candidate against the full world as
; well as against the context that supplied its surface.
(defn lwnv-symbol-ground-current? (world context-world symbol)
    (if (eq (lwo-active? context-world symbol) 1)
        (if (eq (lwo-active? world symbol) 1) 1 0)
        (do
            (let candidate
                (lwsl-current-candidate-for-symbol context-world symbol))
            (if (and (not (node_eq candidate (lwo-none)))
                     (eq (lwsl-integrated-current?
                            world candidate) 1)) 1 0))))

(defn lwnv-sequence-ground-current? (world context-world items)
    (if (eq (len items) 0) 1
        (if (eq (lwnv-symbol-ground-current?
                    world context-world (head items)) 1)
            (lwnv-sequence-ground-current?
                world context-world (tail items)) 0)))

(defn lwnv-witnesses (context basis sequence)
    (do
        (let world (lwcp-context-world context))
        (let with-basis
            (lwnv-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world basis))
                (lwo-empty-field)))
        (let with-symbols
            (lwnv-symbol-witnesses world
                (lwnv-sequence-items sequence) with-basis))
        (lwnv-field-union-items
            (lwo-field-items
                (lwcp-context-capability-attributions context))
            with-symbols)))

; children: execution basis, exact referent, ordered symbols, rendered surface,
;           minimized context, alternatives, unknown, choice, witnesses,
;           evidence, local path
(defn lwnv-utterance
    (basis referent sequence surface context alternatives unknown choice
     witnesses evidence)
    (intern_node LWNV-UTTERANCE
        (list basis referent sequence (intern_trivial_string surface)
              context alternatives unknown choice witnesses evidence
              (lwo-local-path))))
(defn lwnv-utterance? (cell) (lwo-category? cell LWNV-UTTERANCE))
(defn lwnv-utterance-basis (utterance) (nth (node_children utterance) 0))
(defn lwnv-utterance-referent (utterance) (nth (node_children utterance) 1))
(defn lwnv-utterance-sequence (utterance) (nth (node_children utterance) 2))
(defn lwnv-utterance-surface-cell (utterance) (nth (node_children utterance) 3))
(defn lwnv-utterance-surface (utterance)
    (node_value (lwnv-utterance-surface-cell utterance)))
(defn lwnv-utterance-context (utterance) (nth (node_children utterance) 4))
(defn lwnv-utterance-alternatives (utterance) (nth (node_children utterance) 5))
(defn lwnv-utterance-unknown (utterance) (nth (node_children utterance) 6))
(defn lwnv-utterance-choice (utterance) (nth (node_children utterance) 7))
(defn lwnv-utterance-witnesses (utterance) (nth (node_children utterance) 8))
(defn lwnv-utterance-evidence (utterance) (nth (node_children utterance) 9))
(defn lwnv-utterance-path (utterance) (nth (node_children utterance) 10))

(defn lwnv-execution-basis? (world basis referent)
    (if (and (eq (lwo-category? basis LWO-EMERGENT) 1)
             (and (eq (lwre-trace?
                           (lwo-emergent-shape basis)) 1)
                  (and (eq (lwo-active? world basis) 1)
                       (and (eq (lwre-trace-current? world
                                   (lwo-emergent-shape basis)) 1)
                            (node_eq
                                (lwre-result-primary
                                  (lwre-trace-result
                                    (lwo-emergent-shape basis)))
                                referent))))) 1 0))

(defn lwnv-emit
    (context basis referent alternatives unknown choice evidence)
    (if (or (eq (lwcp-context? context) 0)
            (or (eq (lwo-category? alternatives LWO-FIELD) 0)
                (or (and (not (node_eq unknown (lwo-none)))
                         (eq (lwlc-unknown? unknown) 0))
                    (eq (lwlc-choice-valid? choice) 0))))
        (lwo-none)
        (do
            (let world (lwcp-context-world context))
            (if (eq (lwnv-execution-basis? world basis referent) 0)
                (lwo-none)
                (do
                    (let sequence (lwnv-sequence-for world referent))
                    (if (node_eq sequence (lwo-none)) (lwo-none)
                        (lwnv-utterance basis referent sequence
                            (lwnv-render sequence) context alternatives unknown
                            choice (lwnv-witnesses context basis sequence)
                            evidence)))))))

(defn lwnv-utterance-current? (world utterance)
    (if (eq (lwnv-utterance? utterance) 0) 0
        (do
            (let context (lwnv-utterance-context utterance))
            (let context-world (lwcp-context-world context))
            (if (and (eq (lwcp-context-current? world context) 1)
                     (and (eq (lwnv-sequence-ground-current? world context-world
                                      (lwnv-sequence-items
                                        (lwnv-utterance-sequence utterance))) 1)
                          (node_eq utterance
                            (lwnv-emit context
                                (lwnv-utterance-basis utterance)
                                (lwnv-utterance-referent utterance)
                                (lwnv-utterance-alternatives utterance)
                                (lwnv-utterance-unknown utterance)
                                (lwnv-utterance-choice utterance)
                                (lwnv-utterance-evidence utterance))))) 1 0))))

(defn lwnv-origin (utterance)
    (intern_node LWNV-ORIGIN (list utterance (lwo-local-path))))

(defn lwnv-proposal
    (context basis referent alternatives unknown choice evidence)
    (do
        (let utterance
            (lwnv-emit context basis referent alternatives unknown
                choice evidence))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwnv-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwnv-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwnv-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwnv-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))

(defn lwnv-integrate (round proposal action)
    (if (eq (lwnv-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
