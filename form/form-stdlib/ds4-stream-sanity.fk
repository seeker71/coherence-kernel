; ds4-stream-sanity.fk — three readings of an emitted token stream, and the streams
; that taught each one.
;
; WHY THIS EXISTS. On 2026-08-04 the DS4 lane answered "The largest planet in our
; solar system is" with " the name, the<|place_holder_mm_span_0155|> detection
; device detection device detection…" while metal_dsv4_stack.sh reported
; VERDICT PASS 107 gates and validate.sh reported 54 gates, 0 FAIL. Every one of
; those gates reads SHAPE — that a buffer changed, that a row count is right, that
; no entry is non-finite. Not one of them reads the STREAM. A model can emit a
; nine-fold repetition of one token and a reserved placeholder marker with every
; structural witness green, because nothing was looking at the words.
;
; The cause was not arithmetic. The lane was open on the wrong weights: the
; harness default was `~/models/ds4/ds4flash-v5mx-reap25-…`, a 25%-expert-REAPED
; development specimen (receipts/2026-07-22-deepseek-manifest.md: "192 experts,
; 25% reaped — the file name's reap25"), while every fluent DS4 receipt since
; 2026-07-30 rests on the mainline chat-v2-imatrix file. Pointed at the mainline
; blob, the SAME COMMIT answers " Jupiter. It is so big that you could fit all the
; other planets in the solar system into it." So this cell is not a check on the
; arithmetic — it is the check that says WHICH WEIGHTS ANSWERED, by reading what
; came out. A body that cannot tell its own specimens apart from their output has
; no way to notice it is quoting the wrong one.
;
; THE THREE READINGS, and why three. A single reading is a single way to be blind.
;
;   RESERVED   — this vocabulary's ids 128000..129279 are placeholders and control
;                markers, never ordinary text. Witnessed at both edges through the
;                body's own tokenizer on 2026-08-04:
;                  127999 -> 屋檐          (ordinary text, the last of it)
;                  128000 -> <|place_holder_no_0|>
;                  128001 -> <|place_holder_no_1|>
;                  128981 -> <|place_holder_mm_span_0155|>
;                  128805 -> <|EOT|>
;                  129279 -> <|image|>     (the last id; vocab is 129280)
;                ask_ds4.sh declares NO chat template and NO stop token, so a
;                base-model continuation has no business anywhere in that block.
;
;   MULTIPLICITY — no single id may hold more than a quarter of the stream. The
;                reaped specimen emitted id 11347 nine times in 33 steps.
;
;   TWO-CYCLE  — an alternating a·b·a·b run of six or more. The reaped specimen ran
;                11347·5291·11347·5291·11347 — seven long.
;
; THE READINGS ARE INDEPENDENT, and the 0730 fixture is why that is asserted rather
; than assumed: the stream recorded in receipts/2026-07-30-head-to-head-and-a-logit
; -oracle.md (" the capital in France and and its, capital and", from the MAINLINE
; blob but before the Jul-31 kernel repairs) carries NO reserved id and NO two-cycle.
; Only multiplicity catches it. A gate built on the placeholder marker alone — the
; most visible symptom, the one a reader notices first — would have passed it.
;
; WHAT THIS DOES NOT PROVE. Not that the answer is TRUE, and not that it matches
; ds4 token for token. It refutes a class — repetition, cycling, reserved-block
; emission — and a fluent, confident, wrong sentence passes every reading here.
; The oracle for truth is ~/models/ds4-engine/ds4 and it is a different instrument.
;
; preludes: form-stdlib/core.fk

(do
    ; ── the vocabulary's own edges, witnessed, not assumed ──────────────────────
    (defn dss-reserved-floor () 128000)
    (defn dss-vocab-size     () 129280)
    (defn dss-last-ordinary  () 127999)

    ; ── the thresholds ─────────────────────────────────────────────────────────
    ; Below dss-min-len the repetition readings are silent: a three-token stream in
    ; which one token appears twice is not evidence of anything, and a reading that
    ; fires there would cry at every short answer until nobody read it.
    (defn dss-min-len     () 8)
    (defn dss-mult-share  () 4)
    (defn dss-cycle-limit () 6)

    (defn dss-bigger (a b) (if (gt a b) a b))

    ; ── reading one: the reserved block ────────────────────────────────────────
    (defn dss-reserved-walk (ids i acc)
        (if (ge i (len ids)) acc
            (dss-reserved-walk ids (add i 1)
                (if (ge (nth ids i) (dss-reserved-floor)) (add acc 1) acc))))
    (defn dss-reserved-count (ids) (dss-reserved-walk ids 0 0))

    ; ── reading two: multiplicity ──────────────────────────────────────────────
    (defn dss-count-of (ids v i acc)
        (if (ge i (len ids)) acc
            (dss-count-of ids v (add i 1)
                (if (eq (nth ids i) v) (add acc 1) acc))))
    (defn dss-max-mult-walk (ids i best)
        (if (ge i (len ids)) best
            (dss-max-mult-walk ids (add i 1)
                (dss-bigger best (dss-count-of ids (nth ids i) 0 0)))))
    (defn dss-max-mult (ids) (if (eq (len ids) 0) 0 (dss-max-mult-walk ids 0 0)))

    ; ── reading three: the alternating run ─────────────────────────────────────
    ; Length of the a·b·a·b run beginning at i. It starts at 2 (any two adjacent
    ; ids are trivially the first two of some alternation) and extends while each
    ; further id equals the one two before it.
    (defn dss-cycle-from (ids i n)
        (if (ge (add i n) (len ids)) n
            (if (eq (nth ids (add i n)) (nth ids (sub (add i n) 2)))
                (dss-cycle-from ids i (add n 1))
                n)))
    (defn dss-cycle-walk (ids i best)
        (if (gt (add i 2) (sub (len ids) 1)) best
            (dss-cycle-walk ids (add i 1) (dss-bigger best (dss-cycle-from ids i 2)))))
    (defn dss-longest-two-cycle (ids)
        (if (lt (len ids) 3) 0 (dss-cycle-walk ids 0 0)))

    ; ── the three verdicts, each answerable on its own ─────────────────────────
    (defn dss-reserved-trip? (ids)
        (if (gt (dss-reserved-count ids) 0) 1 0))
    (defn dss-mult-trip? (ids)
        (if (lt (len ids) (dss-min-len)) 0
            (if (gt (mul (dss-mult-share) (dss-max-mult ids)) (len ids)) 1 0)))
    (defn dss-cycle-trip? (ids)
        (if (lt (len ids) (dss-min-len)) 0
            (if (ge (dss-longest-two-cycle ids) (dss-cycle-limit)) 1 0)))

    (defn dss-trip-count (ids)
        (add (dss-reserved-trip? ids)
             (add (dss-mult-trip? ids) (dss-cycle-trip? ids))))
    (defn dss-degenerate? (ids)
        (if (gt (dss-trip-count ids) 0) 1 0))

    ; ── the streams, each one witnessed and dated ──────────────────────────────
    ; 2026-08-04, mainline blob (DeepSeek-V4-Flash-IQ2XXS-…-chat-v2-imatrix.gguf),
    ; ask_ds4.sh "The largest planet in our solar system is", 40 steps:
    ;   " Jupiter. It is so big that you could fit all the other planets in the
    ;     solar system into it. Jupiter is also covered with clouds and has a big
    ;     red spot"
    (defn dss-mainline-stream ()
        (list 49475 16 983 344 832 3734 396 440 1494 7377 710 270 915 35454 295
              270 11250 1487 1055 436 16 49475 344 990 10077 418 26316 305 769
              260 3734 4332 9917))

    ; 2026-08-04, reaped specimen (ds4flash-v5mx-reap25-…), the SAME commit and the
    ; same prompt:
    ;   " the name, the<|place_holder_mm_span_0155|> detection device detection
    ;     device detection device detection was the…"
    (defn dss-reap25-stream ()
        (list 270 2329 14 270 128981 11347 5291 11347 5291 11347 5291 11347 515
              270 271 63654 117506 13564 270 128981 13564 270 11347 5291 11347
              5291 11347 270 11347 5291 67411 270 11347))

    ; 2026-07-30, MAINLINE blob but before the Jul-31 kernel repairs, recorded in
    ; receipts/2026-07-30-head-to-head-and-a-logit-oracle.md:
    ;   " the capital in France and and its, capital and"
    ; Degenerate, and invisible to the reserved reading. This is the fixture that
    ; makes the other two readings earn their place.
    (defn dss-0730-stream () (list 270 6102 295 8760 305 305 1009 14 6102 305))

    ; the short-stream guard's two ends
    (defn dss-one-ordinary () (list 270))
    (defn dss-one-reserved () (list 128981)))
