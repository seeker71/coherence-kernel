//////////////////////////////////////////////////////////////////////
//
// form-choice-flow-glass.bml — the choices give themselves into a frame.
//
// form-choice-flow-sources.bml reads the body's real decisions; this shard
// puts them where a reader can take them, beside the organs frame and by the
// same manners: one publisher in the live telemetry space, one snapshot a
// tick, every row carrying the frame it came from and the sequence it landed
// at, so a reader renders shm:/fg-xxxxxxxx#seq for a choice exactly as it
// does for an organ.
//
// Four kinds of row:
//   choice.<point>    one per choice point: its flow, restriction and holding,
//                     its offers, and its options as the row's own channels
//   finding.<kind>.<point>  one per gap and wound the points carry, the ask
//                     travelling as the row's purpose
//   choice.play       the sequence walked in order: its NARROWEST flow, the
//                     step that restricts most, the worth it carries
//   choice.next       the point that most wants a reader's attention
//
// A reading the body does not have stays absent: a point that has never been
// offered publishes no flow rather than a zero, because zero flow and no
// reading are not the same thing and only one of them is a wound.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-choice-flow-sources.bml

section [form.bml] {
    class FormChoiceFlowGlass {
        field FCFGPublisher = "choices";
        field FCFGCadenceMs = 1000;
        // a frame not given for this many of its own cadences is standing, not giving
        field FCFGSilentFactor = 3;
        field FCFGOrgansPublisher = "organs";
        field FCFGGovernorPublisher = "resource.governor";

        // ---- a label a frame will accept, made from whatever text arrived ----
        // The findings carry their ask as a sentence. A row's purpose takes ids,
        // not sentences, so the sentence is folded down here rather than being
        // written a second time in this file: one truth, two shapes.
        def fcfg-slug-char(text, i) = if eq(fgtm-id-byte?(str_byte_at(text, i)), 1) then substring(text, i, add(i, 1)) else "-";
        def fcfg-slug-from(text, i, count, acc) = if ge(i, count) then acc else fcfg-slug-from(text, add(i, 1), count, str_concat(acc, fcfg-slug-char(text, i)));
        def fcfg-slug(text) = if lt(str_len(text), 1) then "unnamed" else fcfg-slug-from(text, 0, str_len(text), "");
        def fcfg-label(text) = if eq(fgtm-label?(fcfg-slug(text)), 1) then fcfg-slug(text) else "unnamed";
        def fcfg-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), fcfg-cat(tail(parts)));
        // a reading the body does not have is absent, never zero
        def fcfg-reading(value) = if lt(value, 0) then fgtm-absent() else fgtm-present(value);
        def fcfg-number(value) = if lt(value, 0) then "none" else int_to_str(value);

        def fcfg-sample(id, kind, purpose, capacity, lifecycle, heat, now, seq, frameLabel, channels) = fgtm-sample(id, fgtm-absent(), kind, "membrane", FCFGPublisher(), "choice", purpose, fgtm-absent(), capacity, lifecycle, fgtm-present(now), fgtm-present(now), heat, fgtm-present(seq), "never", "physical-live", frameLabel, channels);

        // ---- one point, one row ----------------------------------------------
        // A point that has never been offered is "ready", not idle: nothing has
        // gone wrong there yet, it has simply never been reached.
        def fcfg-point-lifecycle(p) = if eq(fcf-dark?(p), 1) then "ready" else if eq(fcf-restricting?(p), 1) then "failed" else if gt(fcf-flow(p), 0) then "active" else "idle";
        def fcfg-point-purpose(p) = fcfg-cat(list("flow-", fcfg-number(fcf-flow(p)), "-restrict-", fcfg-number(fcf-restriction(p)), "-hold-", fcfg-number(fcf-holding(p))));
        // ---- the wire a reader decodes back into a point ---------------------
        // Channels are LABELS: lowercase, digits, - . _ and nothing else, at most
        // 16 of them, at most 64 bytes each. So the point travels as label-shaped
        // entries, and an entry that will not fit the grammar is dropped rather
        // than published malformed -- a frame stays readable, a reader sees one
        // option fewer. Prose (a point's question, an option's offer) cannot
        // cross this membrane at all, and the view names ids and numbers.
        def fcfg-keep-channel(text) = if eq(fgtm-label?(text), 1) then 1 else 0;
        def fcfg-valid-channels(cs) = if eq(len(cs), 0) then list() else if eq(fcfg-keep-channel(head(cs)), 1) then cons(head(cs), fcfg-valid-channels(tail(cs))) else fcfg-valid-channels(tail(cs));
        def fcfg-take(n, cs) = if or(le(n, 0), eq(len(cs), 0)) then list() else cons(head(cs), fcfg-take(sub(n, 1), tail(cs)));
        def fcfg-led-channel(l) = fcfg-cat(list("led.", int_to_str(fcf-ledger-offered(l)), ".", int_to_str(fcf-ledger-taken(l)), ".", int_to_str(fcf-ledger-held(l)), ".", int_to_str(fcf-ledger-declined(l)), ".", int_to_str(fcf-ledger-wait(l))));
        def fcfg-opt-channel(o) = fcfg-cat(list("opt.", fcfg-label(fcf-option-id(o)), ".", int_to_str(fcf-option-cost(o)), ".", int_to_str(fcf-option-reward(o))));
        def fcfg-opt-channels(os) = if eq(len(os), 0) then list() else cons(fcfg-opt-channel(head(os)), fcfg-opt-channels(tail(os)));
        def fcfg-point-channels(p) = cons("choice", cons(fcfg-led-channel(fcf-point-ledger(p)), fcfg-take(sub(FGTMMaxChannels(), 2), fcfg-valid-channels(fcfg-opt-channels(fcf-point-options(p))))));
        def fcfg-point-row(p, now, seq, frameLabel) = fcfg-sample(str_concat("choice.", fcfg-label(fcf-point-id(p))), "choice", fcfg-point-purpose(p), fgtm-present(fcf-ledger-offered(fcf-point-ledger(p))), fcfg-point-lifecycle(p), fcfg-reading(fcf-flow(p)), now, seq, frameLabel, fcfg-point-channels(p));
        def fcfg-point-rows(points, now, seq, frameLabel) = if eq(len(points), 0) then list() else cons(fcfg-point-row(head(points), now, seq, frameLabel), fcfg-point-rows(tail(points), now, seq, frameLabel));

        // ---- one finding, one row, carrying what it asks for -----------------
        // A gap is not a failure. A choice never offered is idle, any other gap
        // is an offer standing (ready), and only a wound -- a choice that closes
        // more than it opens, or a held offer whose clock is not falling --
        // publishes as failed. Every kind but the two named gaps used to
        // publish failed, so a new gap arrived on the glass wearing a wound's word.
        def fcfg-gap-kind?(kind) = if str_eq(kind, "gap-dark") then 1 else if str_eq(kind, "gap-corridor") then 1 else if str_eq(kind, "gap-unclocked") then 1 else 0;
        def fcfg-finding-lifecycle(f) = if str_eq(fcf-finding-kind(f), "gap-dark") then "idle" else if eq(fcfg-gap-kind?(fcf-finding-kind(f)), 1) then "ready" else "failed";
        def fcfg-finding-row(f, now, seq, frameLabel) = fcfg-sample(fcfg-cat(list("finding.", fcfg-label(fcf-finding-kind(f)), ".", fcfg-label(fcf-finding-point(f)))), "finding", fcfg-label(fcf-finding-asks(f)), fgtm-absent(), fcfg-finding-lifecycle(f), fgtm-absent(), now, seq, frameLabel, list("choice", "finding", fcfg-label(fcf-finding-kind(f))));
        def fcfg-finding-rows(findings, now, seq, frameLabel) = if eq(len(findings), 0) then list() else cons(fcfg-finding-row(head(findings), now, seq, frameLabel), fcfg-finding-rows(tail(findings), now, seq, frameLabel));

        // ---- the play and the next choice ------------------------------------
        def fcfg-play-lifecycle(pl) = if lt(fcf-play-flow(pl), 0) then "ready" else if eq(fcf-play-flow(pl), 0) then "idle" else "active";
        def fcfg-play-purpose(pl) = fcfg-cat(list("narrow-", fcfg-number(fcf-play-flow(pl)), "-at-", fcfg-label(fcf-play-narrowest(pl))));
        def fcfg-play-row(pl, now, seq, frameLabel) = fcfg-sample("choice.play", "play", fcfg-play-purpose(pl), fcfg-reading(fcf-play-worth(pl)), fcfg-play-lifecycle(pl), fcfg-reading(fcf-play-flow(pl)), now, seq, frameLabel, list("choice", "play", "sequence"));
        def fcfg-next-row(p, now, seq, frameLabel) = fcfg-sample("choice.next", "next", fcfg-label(fcf-point-id(p)), fgtm-present(fcf-attention(p)), fcfg-point-lifecycle(p), fcfg-reading(fcf-attention(p)), now, seq, frameLabel, list("choice", "next", "attention"));
        def fcfg-findings-row(pl, now, seq, frameLabel) = fcfg-sample("choice.findings", "findings", fcfg-cat(list("open-", int_to_str(len(fcf-play-findings(pl))))), fgtm-present(len(fcf-play-findings(pl))), if eq(len(fcf-play-findings(pl)), 0) then "idle" else "active", fgtm-present(len(fcf-play-findings(pl))), now, seq, frameLabel, list("choice", "finding", "open"));

        def fcfg-rows(points, now, seq, frameLabel) {
            let pl = fcf-play(points);
            let next = fcf-next-choice(points, list());
            let head3 = list(fcfg-play-row(pl, now, seq, frameLabel), fcfg-findings-row(pl, now, seq, frameLabel));
            let nextRows = if eq(len(next), 0) then list() else list(fcfg-next-row(next, now, seq, frameLabel));
            append(head3, append(nextRows, append(fcfg-point-rows(points, now, seq, frameLabel), fcfg-finding-rows(fcf-play-findings(pl), now, seq, frameLabel))));
        }

        // ---- reading the two frames this lane feeds from ---------------------
        // These rows become LEDGER LEGS -- attempts, carried, admissions -- so a
        // frame that is merely standing must not feed them. A giver that stopped
        // an hour ago would otherwise keep pouring its last counts into a point
        // every tick, and the point would read steady rather than silent.
        def fcfg-given-window() = mul(FCFGSilentFactor(), FCFGCadenceMs());
        def fcfg-samples-of(root, publisher) = fgtm-read-samples-within(fgtm-read-current(root, publisher), now_unix_ms(), fcfg-given-window());

        // ---- the frame this lane gives into ----------------------------------
        def fcfg-frame-name(root) = ggf-name(fgtm-space(root, FCFGPublisher()));
        def fcfg-frame-label(frameName) = substring(frameName, 1, str_len(frameName));
        // this process is the frame's writer, so the seqlock moves from what it reads by two
        def fcfg-next-seq(root) {
            let key = fgtm-read-key(root, FCFGPublisher());
            if lt(key, 0) then 2 else add(key, 2);
        }

        // ---- the state between ticks -----------------------------------------
        // Only one thing has to be remembered: the governor's admission ledger,
        // which grows one outcome a tick through the body's own fcf-ledger-note.
        // Every other point reads whole from a counter that is already standing.
        def fcfg-state(tick, admission, published) = list(tick, admission, published);
        def fcfg-state-empty() = fcfg-state(0, fcf-ledger-empty(), list());
        def fcfg-state-tick(s) = nth(s, 0);
        def fcfg-state-admission(s) = nth(s, 1);
        def fcfg-state-published(s) = nth(s, 2);

        def fcfg-points(root, state) {
            let organs = fcfg-samples-of(root, FCFGOrgansPublisher());
            let governor = fcfg-samples-of(root, FCFGGovernorPublisher());
            fcfs-points(host_pid(), root, organs, governor, fcfg-state-admission(state), FCFGCadenceMs());
        }

        def fcfg-tick(root, now, state) {
            let tick = add(fcfg-state-tick(state), 1);
            let seq = fcfg-next-seq(root);
            let frameLabel = fcfg-frame-label(fcfg-frame-name(root));
            let points = fcfg-points(root, state);
            let admission = fcf-point-ledger(fcfs-find-point(points, "governor.metal-admission"));
            let published = fgtm-publish-snapshot(root, FCFGPublisher(), now, fcfg-rows(points, now, seq, frameLabel));
            fcfg-state(tick, admission, published);
        }
        def fcfg-loop(root, state) {
            let next = fcfg-tick(root, now_unix_ms(), state);
            let rested = host_sleep_ms(FCFGCadenceMs());
            fcfg-loop(root, next);
        }
        def fcfg-run-ticks(root, ticks, state) = if le(ticks, 0) then state else fcfg-run-ticks-rest(root, sub(ticks, 1), fcfg-tick(root, now_unix_ms(), state));
        def fcfg-run-ticks-rest(root, ticks, state) {
            let rested = if gt(ticks, 0) then host_sleep_ms(FCFGCadenceMs()) else 0;
            fcfg-run-ticks(root, ticks, state);
        }
    }
    0;
}
