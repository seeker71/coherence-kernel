; hd-activation-lane.fk — an activation knows how it got here.
;
; THE PROBLEM THIS SOLVES. The bodygraph needs thirteen bodies. This body
; computes eleven of them (ephemeris-sun/moon/nodes + the Keplerian planets),
; and cannot compute Pluto: JPL removed it from the mean-element table when it
; was reclassified, and its elements survive only in a table whose extra terms
; this engine does not carry. So a complete reading has two kinds of number in
; it, and the difference is exactly the difference this whole body exists to
; keep: one it DERIVED, one it was TOLD.
;
; The wrong repair is to type Pluto's elements from memory, or to quietly paste
; a longitude in beside the computed ones. Both make a reading that looks
; uniform and is not. The right repair is a LANE: every activation carries how
; it arrived, a witnessed one must name its authority and the day it was read,
; and the reading prints the difference rather than smoothing it.
;
; Borrowed unchanged from learn/gender-three-lanes.fk's law — the lane order IS
; the law, and comparison is on the numbers, never on a name. Here COMPUTED
; ranks above WITNESSED, because a value this body can re-derive on its own
; outlives the source that supplied it; a witnessed value is only as fresh as
; its reading. That ordering is not a slight on the witness. It is what lets a
; witnessed row be replaced, without argument, the day the body can compute it.
;
; WITNESSED, 2026-08-30, and recorded here as data rather than prose: JPL
; Horizons (ssd.jpl.nasa.gov/api/horizons.api, geocentric observer ecliptic
; longitude) also served as an independent check on what this body computes.
; For 1971-10-06 08:15 UT the engine agreed with Horizons to 0.0017 deg on the
; Sun, 0.0051 on Uranus, 0.0020 on Neptune and 0.131 on Saturn — every one
; inside a line (0.9375 deg), so every gate and line was identical from both
; longitudes. That is the first external witness this ephemeris has had for a
; 1971 date, and it is why the witnessed Pluto row below is trusted from the
; same source.
;
; preludes: form-stdlib/core.fk form-stdlib/hd-bodygraph.fk
;
; Proven by: form-stdlib/tests/hd-activation-lane-band.fk

(do
    ;; ── the lanes. The order is the law. ────────────────────────────
    (defn hal-computed () 1)
    (defn hal-witnessed () 2)
    (defn hal-lane-order? ()
        (if (lt (hal-computed) (hal-witnessed)) 1 0))
    (defn hal-lane-name (l)
        (if (eq l 1) "computed" (if (eq l 2) "witnessed" "unknown")))

    ;; ── an activation: (body gate line lane authority day) ──────────
    ;; a computed row carries no authority and no day; a witnessed row
    ;; must carry both, and hal-well-formed? is where that is enforced.
    (defn hal-act (body gate line lane authority day)
        (list body gate line lane authority day))
    (defn hal-body (a) (nth a 0))
    (defn hal-gate (a) (nth a 1))
    (defn hal-line (a) (nth a 2))
    (defn hal-lane (a) (nth a 3))
    (defn hal-authority (a) (nth a 4))
    (defn hal-day (a) (nth a 5))

    (defn hal-computed-act (body gate line)
        (hal-act body gate line (hal-computed) "" 0))
    (defn hal-witnessed-act (body gate line authority day)
        (hal-act body gate line (hal-witnessed) authority day))

    ;; ── THE LAW: a witnessed row names who and when; a computed row
    ;; claims neither. A row that says nothing about where it came from
    ;; while carrying an authority is the shape this cell forbids. ──
    (defn hal-row-ok? (a)
        (if (eq (hal-lane a) (hal-witnessed))
            (if (and (gt (str_len (hal-authority a)) 0) (gt (hal-day a) 0)) 1 0)
            (if (eq (hal-lane a) (hal-computed))
                (if (and (eq (str_len (hal-authority a)) 0) (eq (hal-day a) 0)) 1 0)
                0)))
    (defn hal-well-loop (as)
        (if (eq (len as) 0) 1
            (if (eq (hal-row-ok? (head as)) 1) (hal-well-loop (tail as)) 0)))
    (defn hal-well-formed? (as) (hal-well-loop as))

    ;; ── the witnessed rows this body currently holds ────────────────
    ;; Pluto only. Everything else in a reading is computed, and the day
    ;; this body can compute Pluto this row is deleted, not amended.
    (defn hal-jpl () "jpl-horizons-geocentric-ecliptic")
    (defn hal-pluto-1971-10-06 ()
        (hal-witnessed-act "pluto" 46 2 (hal-jpl) 20260830))
    ;; the design moment of the same chart, 91.157 days earlier, read from
    ;; the same authority on the same day
    (defn hal-pluto-1971-07-07 ()
        (hal-witnessed-act "design-pluto" 6 5 (hal-jpl) 20260830))
    (defn hal-witnessed-rows ()
        (list (hal-pluto-1971-10-06) (hal-pluto-1971-07-07)))
    (defn hal-witnessed-count () (len (hal-witnessed-rows)))

    ;; ── counting a reading honestly ─────────────────────────────────
    (defn hal-count-lane-loop (as l n)
        (if (eq (len as) 0) n
            (hal-count-lane-loop (tail as) l
                (add n (if (eq (hal-lane (head as)) l) 1 0)))))
    (defn hal-computed-count (as) (hal-count-lane-loop as (hal-computed) 0))
    (defn hal-witnessed-in (as) (hal-count-lane-loop as (hal-witnessed) 0))
    ;; a reading is FULLY DERIVED only when nothing in it was merely told
    (defn hal-fully-derived? (as)
        (if (eq (hal-witnessed-in as) 0) 1 0))

    ;; ── the gates a set of activations contributes, lane-blind, so the
    ;; bodygraph derivation can consume computed and witnessed alike ──
    (defn hal-gates-loop (as acc)
        (if (eq (len as) 0) acc
            (hal-gates-loop (tail as) (append acc (list (hal-gate (head as)))))))
    (defn hal-gates (as) (hal-gates-loop as (list)))
    0)
