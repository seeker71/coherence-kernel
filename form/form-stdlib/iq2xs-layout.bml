//////////////////////////////////////////////////////////////////////
//
// iq2xs-layout.bml
//
// Executable BML. Authority:
// form-stdlib/iq2xs-layout.bml
//
// Only address and bit-field geometry lives here. The 512x8 trained
// magnitude table is a lower constant-data surface because form.bml
// cannot yet express or crystallize a 4096-element field without
// turning it into authored low-level noise.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ2XSLayoutAuthority {
        field IQ2XSAuthorityPath = "form/form-stdlib/iq2xs-layout.bml";
        field IQ2XSAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ2XSLayout {
        field IQ2XSGGMLType = 17;
        field IQ2XSBlockElements = 256;
        field IQ2XSBlockBytes = 74;
        field IQ2XSScaleOffset = 66;
        field IQ2XSScaleBytes = 8;
        field IQ2XSQuantWords = 32;
        field IQ2XSGridEntries = 512;
        field IQ2XSGridWidth = 8;
        field IQ2XSSignEntries = 128;
        field IQ2XSSIMDWidth = 32;
        field IQ2XSSlotRows = 4;
        field IQ2XSGroupsPerBlock = 8;
        field IQ2XSGroupElements = 32;

        ref iq2x-authority = IQ2XSLayoutAuthority;
        thought iq2x-pattern = list("type17", "256-elements", "74-bytes", "u16-grid-sign", "paired-nibble-scale", "slot4-one-simdgroup", "bounded-refusal");

        def iq2x-mod(x, n) = x - ((x / n) * n);
        def iq2x-block-of(i) = i / IQ2XSBlockElements();
        def iq2x-within(i) = iq2x-mod(i, IQ2XSBlockElements());
        def iq2x-ib32(i) = iq2x-within(i) / 32;
        def iq2x-rem32(i) = iq2x-mod(iq2x-within(i), 32);
        def iq2x-l(i) = iq2x-rem32(i) / IQ2XSGridWidth();
        def iq2x-j(i) = iq2x-mod(iq2x-rem32(i), IQ2XSGridWidth());
        def iq2x-qword-index(i) = (iq2x-ib32(i) * 4) + iq2x-l(i);
        def iq2x-qword-offset(base, i) = (base + 2) + (iq2x-qword-index(i) * 2);
        def iq2x-scale-offset(base, i) = (base + IQ2XSScaleOffset()) + iq2x-ib32(i);
        def iq2x-scale-code(scaleByte, i) = iq2x-l(i) < 2 ? iq2x-mod(scaleByte, 16) : (scaleByte / 16);
        def iq2x-grid-index(packedWord) = iq2x-mod(packedWord, IQ2XSGridEntries());
        def iq2x-sign-index(packedWord) = packedWord / IQ2XSGridEntries();
        def iq2x-slot-row0(threadIndex) = (threadIndex / IQ2XSSIMDWidth()) * IQ2XSSlotRows();
        def iq2x-slot-block(groupIndex) = groupIndex / IQ2XSGroupsPerBlock();
        def iq2x-slot-group(groupIndex) = iq2x-mod(groupIndex, IQ2XSGroupsPerBlock());
        def iq2x-slot-threads(rows) = ((rows + (IQ2XSSlotRows() - 1)) / IQ2XSSlotRows()) * IQ2XSSIMDWidth();
        def iq2x-slot-admissible(rows, cols) = rows < 1 ? 0 : (Comparable) iq2x-mod(cols, IQ2XSBlockElements()) == 0 ? 1 : 0;
        def iq2x-within-block(i) = i < 0 ? 0 : i < IQ2XSBlockElements() ? 1 : 0;

        def iq2x-bit(ok, bit) = ok ? bit : 0;
        def iq2x-check() {
            let c0 = iq2x-bit((Comparable) IQ2XSGGMLType() == 17 ? ((Comparable) IQ2XSBlockElements() == 256 ? ((Comparable) IQ2XSBlockBytes() == 74) : 0) : 0, 1);
            let c1 = iq2x-bit((Comparable) iq2x-qword-offset(0, 0) == 2 ? ((Comparable) iq2x-qword-offset(0, 255) == 64) : 0, 2);
            let c2 = iq2x-bit((Comparable) iq2x-scale-offset(0, 0) == 66 ? ((Comparable) iq2x-scale-offset(0, 255) == 73) : 0, 4);
            let c3 = iq2x-bit((Comparable) iq2x-grid-index(65535) == 511 ? ((Comparable) iq2x-sign-index(65535) == 127) : 0, 8);
            let c4 = iq2x-bit((Comparable) iq2x-scale-code(163, 0) == 3 ? ((Comparable) iq2x-scale-code(163, 31) == 10) : 0, 16);
            let c5 = iq2x-bit((Comparable) iq2x-ib32(255) == 7 ? ((Comparable) iq2x-l(255) == 3 ? ((Comparable) iq2x-j(255) == 7) : 0) : 0, 32);
            let c6 = iq2x-bit((Comparable) iq2x-within-block(255) == 1 ? ((Comparable) iq2x-within-block(256) == 0 ? ((Comparable) iq2x-within-block(0 - 1) == 0) : 0) : 0, 64);
            let c7 = iq2x-bit((Comparable) iq2x-block-of(513) == 2 ? ((Comparable) iq2x-within(513) == 1) : 0, 128);
            let c8 = iq2x-bit((Comparable) iq2x-slot-row0(31) == 0 ? ((Comparable) iq2x-slot-row0(32) == 4 ? ((Comparable) iq2x-slot-block(15) == 1 ? ((Comparable) iq2x-slot-group(15) == 7 ? ((Comparable) iq2x-slot-threads(641) == 5152 ? ((Comparable) iq2x-slot-admissible(640, 2560) == 1 ? ((Comparable) iq2x-slot-admissible(640, 2559) == 0) : 0) : 0) : 0) : 0) : 0) : 0, 256);
            c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + (c7 + c8)))))));
        }
    }
    0;
}
