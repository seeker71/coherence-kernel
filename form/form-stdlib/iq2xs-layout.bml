//////////////////////////////////////////////////////////////////////
//
// iq2xs-layout.bml
//
// Executable BML. Authority:
// form-stdlib/bml/iq2xs-layout.bml
//
// Only address and bit-field geometry lives here. The 512x8 trained
// magnitude table is a lower constant-data surface because form.bml
// cannot yet express or crystallize a 4096-element field without
// turning it into authored low-level noise.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ2XSLayoutAuthority {
        field IQ2XSAuthorityPath = "form/form-stdlib/bml/iq2xs-layout.bml";
        field IQ2XSAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ2XSLayout {
        field IQ2XSGGMLType = 17;
        field IQ2XSBlockElements = 256;
        field IQ2XSBlockBytes = 74;
        field IQ2XSScaleOffset = 66;
        field IQ2XSScaleBytes = 8;
        field IQ2XSQuantWords = 32;
        field IQ2XSGridEntries = 512;
        field IQ2XSGridWidth = 8;
        field IQ2XSSignEntries = 128;
        field IQ2XSSIMDWidth = 32;
        field IQ2XSSlotRows = 4;
        field IQ2XSGroupsPerBlock = 8;
        field IQ2XSGroupElements = 32;

        ref iq2x-authority = IQ2XSLayoutAuthority;
        thought iq2x-pattern = list("type17", "256-elements", "74-bytes", "u16-grid-sign", "paired-nibble-scale", "slot4-one-simdgroup", "bounded-refusal");

        def iq2x-mod(x, n) = sub(x, mul(div(x, n), n));
        def iq2x-block-of(i) = div(i, IQ2XSBlockElements());
        def iq2x-within(i) = iq2x-mod(i, IQ2XSBlockElements());
        def iq2x-ib32(i) = div(iq2x-within(i), 32);
        def iq2x-rem32(i) = iq2x-mod(iq2x-within(i), 32);
        def iq2x-l(i) = div(iq2x-rem32(i), IQ2XSGridWidth());
        def iq2x-j(i) = iq2x-mod(iq2x-rem32(i), IQ2XSGridWidth());
        def iq2x-qword-index(i) = add(mul(iq2x-ib32(i), 4), iq2x-l(i));
        def iq2x-qword-offset(base, i) = add(add(base, 2), mul(iq2x-qword-index(i), 2));
        def iq2x-scale-offset(base, i) = add(add(base, IQ2XSScaleOffset()), iq2x-ib32(i));
        def iq2x-scale-code(scaleByte, i) = if lt(iq2x-l(i), 2) then iq2x-mod(scaleByte, 16) else div(scaleByte, 16);
        def iq2x-grid-index(packedWord) = iq2x-mod(packedWord, IQ2XSGridEntries());
        def iq2x-sign-index(packedWord) = div(packedWord, IQ2XSGridEntries());
        def iq2x-slot-row0(threadIndex) = mul(div(threadIndex, IQ2XSSIMDWidth()), IQ2XSSlotRows());
        def iq2x-slot-block(groupIndex) = div(groupIndex, IQ2XSGroupsPerBlock());
        def iq2x-slot-group(groupIndex) = iq2x-mod(groupIndex, IQ2XSGroupsPerBlock());
        def iq2x-slot-threads(rows) = mul(div(add(rows, sub(IQ2XSSlotRows(), 1)), IQ2XSSlotRows()), IQ2XSSIMDWidth());
        def iq2x-slot-admissible(rows, cols) = if lt(rows, 1) then 0 else if eq(iq2x-mod(cols, IQ2XSBlockElements()), 0) then 1 else 0;
        def iq2x-within-block(i) = if lt(i, 0) then 0 else if lt(i, IQ2XSBlockElements()) then 1 else 0;

        def iq2x-bit(ok, bit) = if ok then bit else 0;
        def iq2x-check() {
            let c0 = iq2x-bit(if eq(IQ2XSGGMLType(), 17) then if eq(IQ2XSBlockElements(), 256) then eq(IQ2XSBlockBytes(), 74) else 0 else 0, 1);
            let c1 = iq2x-bit(if eq(iq2x-qword-offset(0, 0), 2) then eq(iq2x-qword-offset(0, 255), 64) else 0, 2);
            let c2 = iq2x-bit(if eq(iq2x-scale-offset(0, 0), 66) then eq(iq2x-scale-offset(0, 255), 73) else 0, 4);
            let c3 = iq2x-bit(if eq(iq2x-grid-index(65535), 511) then eq(iq2x-sign-index(65535), 127) else 0, 8);
            let c4 = iq2x-bit(if eq(iq2x-scale-code(163, 0), 3) then eq(iq2x-scale-code(163, 31), 10) else 0, 16);
            let c5 = iq2x-bit(if eq(iq2x-ib32(255), 7) then if eq(iq2x-l(255), 3) then eq(iq2x-j(255), 7) else 0 else 0, 32);
            let c6 = iq2x-bit(if eq(iq2x-within-block(255), 1) then if eq(iq2x-within-block(256), 0) then eq(iq2x-within-block(sub(0, 1)), 0) else 0 else 0, 64);
            let c7 = iq2x-bit(if eq(iq2x-block-of(513), 2) then eq(iq2x-within(513), 1) else 0, 128);
            let c8 = iq2x-bit(if eq(iq2x-slot-row0(31), 0) then if eq(iq2x-slot-row0(32), 4) then if eq(iq2x-slot-block(15), 1) then if eq(iq2x-slot-group(15), 7) then if eq(iq2x-slot-threads(641), 5152) then if eq(iq2x-slot-admissible(640, 2560), 1) then eq(iq2x-slot-admissible(640, 2559), 0) else 0 else 0 else 0 else 0 else 0 else 0, 256);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, add(c7, c8))))))));
        }
    }
    0;
}
