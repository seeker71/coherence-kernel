//////////////////////////////////////////////////////////////////////
//
// form-cli-heedmark.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-heedmark.bml
//
// A heedmark is a Form-native execution token: the model writes it into
// its own output as ordinary text, the carrier heeds it, Form looks the
// query up, and the answer re-enters as prefill at the current position.
//
// LogitsExecuted stays 0. A forward pass produces a distribution over ids
// and nothing else. The model asked; the carrier answered.
//
// Proven by: form-stdlib/tests/form-cli-heedmark-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template HeedRequest<TQuery> {
        member query: TQuery;
        member outcome: int;
        member attribution: String;
    }

    class FormHeedmarkAuthority {
        field HeedAuthorityPath = "form/form-stdlib/bml/form-cli-heedmark.bml";
        field HeedAuthorityKind = "high-bml-class-template-field";
    }

    class FormHeedmark<T> {
        field HeedOpen = "<form-ask>";
        field HeedClose = "</form-ask>";
        field MaxHeeds = 2;
        field LogitsExecuted = 0;
        field OutHit = 1;
        field OutMiss = 2;
        field OutNothing = 3;
        field OutSpent = 4;

        ref fhm-authority = FormHeedmarkAuthority;
        thought fhm-pattern = list("mark", "heed", "lookup", "prefill", "resume");
        thought fhm-outcomes = list("hit", "miss", "nothing", "spent");

        // ── the carrier's decision, once per completed mark ──────────────
        // Budget first: an exhausted turn does not look anything up, and the
        // mark stays plain text. Then readiness and lateness — axiom-1, a
        // window that closed without an answer is nothing, not an error.
        def fhm-outcome(left, ready, late, hits) = if le(left, 0) then OutSpent() else if eq(ready, 0) then OutNothing() else if eq(late, 1) then OutNothing() else if gt(hits, 0) then OutHit() else OutMiss();

        // Spent is the only outcome where no lookup was attempted.
        def fhm-heeded(o) = if eq(o, OutSpent()) then 0 else 1;

        // A span enters for hit and for miss. Miss enters a NAMED status so
        // the model is not left to invent a row the body does not hold.
        def fhm-injects-span(o) = if eq(o, OutHit()) then 1 else if eq(o, OutMiss()) then 1 else 0;

        // Knowledge enters only on a hit. Miss carries status, not content.
        def fhm-injects-knowledge(o) = if eq(o, OutHit()) then 1 else 0;

        // A hit without a source is refused.
        def fhm-attribution-required(o) = fhm-injects-knowledge(o);
        def fhm-admits-hit(o, attribution) = if eq(fhm-attribution-required(o), 0) then 1 else if str_eq(attribution, "") then 0 else 1;

        def fhm-miss-text() = "no grounded row";
        def fhm-span-text(o, body, attribution) = if eq(o, OutHit()) then str_concat(body, str_concat(" [", str_concat(attribution, "]"))) else if eq(o, OutMiss()) then fhm-miss-text() else "";

        // ── the prefix seam ─────────────────────────────────────────────
        // The answer enters through prefill at the current position, so the
        // positions before it keep the KV rows they were written with. Cost
        // is the span. A carrier that rebuilt the context would pay both.
        def fhm-prefill-cost(prefix, span) = span;
        def fhm-naive-cost(prefix, span) = add(prefix, span);
        def fhm-forwards-saved(prefix, span) = sub(fhm-naive-cost(prefix, span), fhm-prefill-cost(prefix, span));
        def fhm-prefix-preserved() = 1;

        // ── the bound ───────────────────────────────────────────────────
        def fhm-budget-after(o, left) = if eq(fhm-heeded(o), 1) then sub(left, 1) else left;

        def fhm-walk(marks, i, left, acc) = if eq(i, marks) then acc else fhm-walk(marks, add(i, 1), fhm-budget-after(fhm-outcome(left, 1, 0, 1), left), add(acc, if eq(fhm-outcome(left, 1, 0, 1), OutHit()) then 1 else 0));

        def fhm-bounded(marks) = fhm-walk(marks, 0, MaxHeeds(), 0);

        // ── the marks ───────────────────────────────────────────────────
        def fhm-marks-distinct() = if str_eq(HeedOpen(), HeedClose()) then 0 else 1;
        def fhm-logits-executed() = LogitsExecuted();

        def fhm-bit(ok, bit) = if ok then bit else 0;

        def fhm-check() {
            let hit = fhm-outcome(2, 1, 0, 3);
            let miss = fhm-outcome(2, 1, 0, 0);
            let late = fhm-outcome(2, 1, 1, 3);
            let bare = fhm-outcome(2, 0, 0, 3);
            let spent = fhm-outcome(0, 1, 0, 3);
            let c0 = fhm-bit(eq(fhm-logits-executed(), 0), 1);
            let c1 = fhm-bit(and(and(eq(hit, OutHit()), eq(miss, OutMiss())), and(eq(late, OutNothing()), and(eq(bare, OutNothing()), eq(spent, OutSpent())))), 2);
            let c2 = fhm-bit(and(and(eq(fhm-heeded(hit), 1), eq(fhm-heeded(late), 1)), eq(fhm-heeded(spent), 0)), 4);
            let c3 = fhm-bit(and(and(eq(fhm-injects-span(hit), 1), eq(fhm-injects-span(miss), 1)), and(eq(fhm-injects-span(late), 0), eq(fhm-injects-span(spent), 0))), 8);
            let c4 = fhm-bit(and(and(eq(fhm-injects-knowledge(hit), 1), eq(fhm-injects-knowledge(miss), 0)), and(eq(fhm-admits-hit(hit, ""), 0), eq(fhm-admits-hit(hit, "cell:1"), 1))), 16);
            let c5 = fhm-bit(and(and(eq(fhm-bounded(5), MaxHeeds()), eq(fhm-bounded(1), 1)), eq(fhm-bounded(0), 0)), 32);
            let c6 = fhm-bit(and(and(eq(fhm-prefill-cost(1000, 12), 12), eq(fhm-naive-cost(1000, 12), 1012)), and(eq(fhm-forwards-saved(1000, 12), 1000), eq(fhm-prefix-preserved(), 1))), 64);
            let c7 = fhm-bit(and(eq(fhm-marks-distinct(), 1), and(str_eq(fhm-span-text(miss, "x", "y"), fhm-miss-text()), str_eq(fhm-span-text(hit, "body", "cell:1"), "body [cell:1]"))), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
