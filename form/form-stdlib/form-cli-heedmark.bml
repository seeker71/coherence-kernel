//////////////////////////////////////////////////////////////////////
//
// form-cli-heedmark.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-heedmark.bml
//
// A heedmark is a Form-native execution token: the model writes it into
// its own output as ordinary text, the carrier heeds it, Form looks the
// query up, and the answer re-enters as prefill at the current position.
//
// LogitsExecuted stays 0. A forward pass produces a distribution over ids
// and nothing else. The model asked; the carrier answered.
//
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template HeedRequest<TQuery> {
        member query: TQuery;
        member outcome: int;
        member attribution: String;
    }

    class FormHeedmarkAuthority {
        field HeedAuthorityPath = "form/form-stdlib/bml/form-cli-heedmark.bml";
        field HeedAuthorityKind = "high-bml-class-template-field";
    }

    class FormHeedmark<T> {
        field HeedOpen = "<|form:knowledge-query|>";
        field HeedClose = "<|/form:knowledge-query|>";
        field ObsOpen = "<|form:knowledge-observation|>";
        field ObsClose = "<|/form:knowledge-observation|>";
        field NeutralMark = "[mark-neutralized]";
        field MaxQueryBytes = 256;
        field MaxHeeds = 2;
        field LookupLateMs = 2000;
        field QueryBudget = 48;
        field AnswerReserve = 32;
        field PhaseQuery = 1;
        field PhaseAnswer = 2;
        field LogitsExecuted = 0;
        field OutHit = 1;
        field OutMiss = 2;
        field OutNothing = 3;
        field OutSpent = 4;

        ref fhm-authority = FormHeedmarkAuthority;
        thought fhm-pattern = list("mark", "heed", "lookup", "prefill", "resume");
        thought fhm-outcomes = list("hit", "miss", "nothing", "spent");
        thought fhm-states = list("none", "held", "complete", "over-budget");
        thought fhm-framings = list("clip-left-silent", "hold-refuse-typed", "hold-truncate-lookup");

        // ── the carrier's decision, once per completed mark ──────────────
        // Budget first: an exhausted turn does not look anything up, and the
        // mark stays plain text. Then readiness and lateness — axiom-1, a
        // window that closed without an answer is nothing, not an error.
        def fhm-outcome(left, ready, late, hits) = if (left <= 0) then OutSpent() else if ((Comparable) ready == 0) then OutNothing() else if ((Comparable) late == 1) then OutNothing() else if (hits > 0) then OutHit() else OutMiss();

        // Spent is the only outcome where no lookup was attempted.
        def fhm-heeded(o) = if ((Comparable) o == OutSpent()) then 0 else 1;

        // A span enters for hit and for miss. Miss enters a NAMED status so
        // the model is not left to invent a row the body does not hold.
        def fhm-injects-span(o) = if ((Comparable) o == OutHit()) then 1 else if ((Comparable) o == OutMiss()) then 1 else 0;

        // Knowledge enters only on a hit. Miss carries status, not content.
        def fhm-injects-knowledge(o) = if ((Comparable) o == OutHit()) then 1 else 0;

        // A hit without a source is refused.
        def fhm-attribution-required(o) = fhm-injects-knowledge(o);
        def fhm-admits-hit(o, attribution) = if ((Comparable) fhm-attribution-required(o) == 0) then 1 else if ((String) attribution == "") then 0 else 1;

        def fhm-miss-text() = "no grounded row";
        def fhm-span-text(o, body, attribution) = if ((Comparable) o == OutHit()) then str_concat(body, str_concat(" [", str_concat(attribution, "]"))) else if ((Comparable) o == OutMiss()) then fhm-miss-text() else "";

        // ── the prefix seam ─────────────────────────────────────────────
        // The answer enters through prefill at the current position, so the
        // positions before it keep the KV rows they were written with. Cost
        // is the span. A carrier that rebuilt the context would pay both.
        def fhm-prefill-cost(prefix, span) = span;
        def fhm-naive-cost(prefix, span) = (prefix + span);
        def fhm-forwards-saved(prefix, span) = (fhm-naive-cost(prefix, span) - fhm-prefill-cost(prefix, span));
        def fhm-prefix-preserved() = 1;

        // ── the bound ───────────────────────────────────────────────────
        def fhm-budget-after(o, left) = if ((Comparable) fhm-heeded(o) == 1) then (left - 1) else left;

        def fhm-walk(marks, i, left, acc) = if ((Comparable) i == marks) then acc else fhm-walk(marks, (i + 1), fhm-budget-after(fhm-outcome(left, 1, 0, 1), left), (acc + (if ((Comparable) fhm-outcome(left, 1, 0, 1) == OutHit()) then 1 else 0)));

        def fhm-bounded(marks) = fhm-walk(marks, 0, MaxHeeds(), 0);

        // ── the marks, and the two bounded windows a streaming cursor needs ──
        // FrameCap is the widest a legal envelope can be. HoldCap is the most
        // that can be HELD before a close mark must appear — open plus the
        // largest legal query. A cursor bounded by these cannot grow into a
        // materialized table however long the stream runs, and that is the
        // whole no-pre-materialization guarantee: two numbers, no table.
        //
        // The distinction is load-bearing. Clipping to FrameCap from the left
        // silently eats the open mark of an over-long query, and the frame then
        // never completes: the model asked and heard nothing back, with no
        // reason and no status. HoldCap lets the cursor SEE that the query
        // outran its budget and say so.
        def fhm-frame-cap() = (str_len(HeedOpen()) + (MaxQueryBytes() + str_len(HeedClose())));
        def fhm-hold-cap() = (str_len(HeedOpen()) + MaxQueryBytes());

        // Enough tail to let an open mark split across tokens still form.
        def fhm-detect-cap() = str_len(HeedOpen());

        // ── the four streaming states ──────────────────────────────────────
        def fhm-state-none() = "none";
        def fhm-state-held() = "held";
        def fhm-state-complete() = "complete";
        def fhm-state-over() = "over-budget";
        def fhm-over-reason() = "query-budget-exceeded";

        // Over budget only when NO close has arrived and the held bytes already
        // exceed open+MaxQueryBytes. A close arriving late in one large token
        // is NOT refused here — the envelope completes and the parser answers
        // query-budget-exceeded itself, which is the same named nothing from
        // the one place that owns query length.
        def fhm-over-budget?(held, has_close) = if ((Comparable) has_close == 1) then 0 else if (held > fhm-hold-cap()) then 1 else 0;

        // ── timeout is a named observation carrying its measurement ─────────
        // Not a bit. A late lookup reports how late, so a witness can see the
        // margin rather than a verdict someone already collapsed.
        def fhm-late?(elapsed_ms) = if (elapsed_ms > LookupLateMs()) then 1 else 0;
        def fhm-late-reason(elapsed_ms) = str_concat("lookup-late-", str_concat(int_to_str(elapsed_ms), "ms"));
        def fhm-late-observation(elapsed_ms) = list("timeout", int_to_str(elapsed_ms), fhm-late-reason(elapsed_ms));

        // ── comparing candidate framings before cutting ─────────────────────
        // Three ways to meet an over-long query. Scored on four observable
        // criteria, so the cut is made against evidence rather than taste.
        //   names-reason   does the model receive a named reason?
        //   no-io          does an over-budget frame avoid the lookup?
        //   bounded        is held memory bounded?
        //   no-fabrication does it avoid looking up a query the model never wrote?
        def fhm-framing-names-reason(f) = if ((String) f == "clip-left-silent") then 0 else 1;
        def fhm-framing-no-io(f) = if ((String) f == "hold-truncate-lookup") then 0 else 1;
        def fhm-framing-bounded(f) = 1;
        def fhm-framing-no-fabrication(f) = if ((String) f == "hold-truncate-lookup") then 0 else 1;
        def fhm-framing-score(f) = (fhm-framing-names-reason(f) + (fhm-framing-no-io(f) + (fhm-framing-bounded(f) + fhm-framing-no-fabrication(f))));

        def fhm-best-of(fs, best, bestv) = if ((Comparable) len(fs) == 0) then best else if (fhm-framing-score(head(fs)) > bestv) then fhm-best-of(tail(fs), head(fs), fhm-framing-score(head(fs))) else fhm-best-of(tail(fs), best, bestv);
        def fhm-best-framing() = fhm-best-of(fhm-framings(), "", 0);

        // ── the two-phase ledger ───────────────────────────────────────────
        // ONE fungible step budget is the defect. If a valid query closes on the
        // last slot, the observation is injected and the model has nothing left
        // to answer with — the scorer reads an empty answer and calls it a miss
        // the model never made. Verbosity in the query silently eats the answer.
        //
        // Two ledgers, and the second is NON-BORROWABLE. QueryBudget spends
        // while the model composes its query. AnswerReserve is untouchable until
        // a typed hit or miss observation has ACTUALLY been injected; then it
        // opens at full size, whatever is left of the query budget is CUT rather
        // than carried, and the answer is written from a reserve query verbosity
        // could never have reached.
        //
        // Running out of query budget while still holding an unclosed frame is
        // NOT exhaustion. It is a named observation — the decode timed out and
        // the answer alternative was never tried. Those are different facts and
        // a scorer that cannot tell them apart is measuring the wrong thing.
        def fhm-query-budget() = QueryBudget();
        def fhm-answer-reserve() = AnswerReserve();
        // Ordinary generation carries the caller's response allowance across
        // a lookup. The default remains a floor for short requests.
        def fhm-caller-answer-reserve(requested) = if (requested > AnswerReserve()) then requested else AnswerReserve();
        def fhm-caller-budget-text(requested) = str_concat("For this ordinary generation call, the query or direct-answer allowance is ", str_concat(int_to_str(requested), str_concat(" generated tokens. After a native lookup, the separate answer allowance is ", str_concat(int_to_str(fhm-caller-answer-reserve(requested)), " generated tokens. Finish the requested answer within that allowance."))));
        def fhm-timeout-reason() = "knowledge-query-decode-timeout";
        def fhm-timeout-alternative() = "timeout-answer-alternative-untried";

        // Only a status that actually put a span in the stream opens the reserve.
        def fhm-opens-reserve(o) = fhm-injects-span(o);

        // nothing spends no reserve and cuts nothing.
        def fhm-spends-reserve(o) = fhm-opens-reserve(o);
        def fhm-cuts-query-fuel(o) = fhm-opens-reserve(o);

        // ── the curriculum: anchor first, path second ──────────────────────
        // An observation is read by its ANCHOR — the content address that fixes
        // which cell answered — before its PATH, which only says where a copy of
        // that cell was found today. A reader that leads with the path binds to
        // a location; a reader that leads with the anchor binds to the meaning
        // and can survive the file moving.
        thought fhu-read-order = list("anchor", "path");
        def fhu-anchor-first() = nth(fhu-read-order(), 0);
        def fhu-path-second() = nth(fhu-read-order(), 1);
        def fhu-anchor-before-path() = if ((String) fhu-anchor-first() == "anchor") then if ((String) fhu-path-second() == "path") then 1 else 0 else 0;

        // ── the curriculum: six kinds that a bit cannot carry ──────────────
        // Every one of these is routinely collapsed to 0/1, and every collapse
        // throws away the part a reader needs. Named here so the local model can
        // be taught the distinction rather than guessing it.
        thought fhu-kinds = list("choice", "lanes", "cut", "undo", "timeout", "nothing");
        def fhu-is-boolean(kind) = 0;
        def fhu-carries(kind) = if ((String) kind == "choice") then "the alternatives, and whose consent selects" else if ((String) kind == "lanes") then "which lane answered: native, local, or remote" else if ((String) kind == "cut") then "what was pruned, and on what observation" else if ((String) kind == "undo") then "the prior state, exactly, to restore into" else if ((String) kind == "timeout") then "how long was waited before the window closed" else "the reason there is nothing, which is not failure";
        def fhu-collapsed-loses(kind) = if ((String) fhu-carries(kind) == "") then 0 else 1;
        def fhu-all-carry(ks) = if ((Comparable) len(ks) == 0) then 1 else if ((Comparable) fhu-collapsed-loses(head(ks)) == 1) then fhu-all-carry(tail(ks)) else 0;
        def fhu-none-boolean(ks) = if ((Comparable) len(ks) == 0) then 1 else if ((Comparable) fhu-is-boolean(head(ks)) == 0) then fhu-none-boolean(tail(ks)) else 0;
        def fhu-curriculum-ok() = if ((Comparable) fhu-anchor-before-path() == 1) then if ((Comparable) fhu-all-carry(fhu-kinds()) == 1) then fhu-none-boolean(fhu-kinds()) else 0 else 0;

        // ── the cuckoomark rule ────────────────────────────────────────────
        // A retrieved answer is a slice of somebody's source, and the corpus is
        // this repository — so the answer can contain the very marks that frame
        // it. Left alone, a slice carrying ObsClose forges a premature end and
        // everything after it reads as though it were outside the observation:
        // source content wearing the carrier's own structure, with the READER
        // doing the forging, faithfully.
        //
        // Every mark occurring inside retrieved content is neutralized before it
        // is rendered, and the count of substitutions is reported. Silent
        // sanitizing would be its own dishonesty — a witness must be able to see
        // that the body altered what it quotes.
        def fhm-neutral-mark() = NeutralMark();
        def fhm-sanitize-required(o) = fhm-injects-knowledge(o);

        def fhm-marks-distinct() = if ((String) HeedOpen() == HeedClose()) then 0 else 1;
        def fhm-obs-marks-distinct() = if ((String) ObsOpen() == ObsClose()) then 0 else 1;
        def fhm-mark-families-distinct() = if ((String) HeedOpen() == ObsOpen()) then 0 else 1;
        def fhm-logits-executed() = LogitsExecuted();

        def fhm-bit(ok, bit) = if ok then bit else 0;

        def fhm-check() {
            let hit = fhm-outcome(2, 1, 0, 3);
            let miss = fhm-outcome(2, 1, 0, 0);
            let late = fhm-outcome(2, 1, 1, 3);
            let bare = fhm-outcome(2, 0, 0, 3);
            let spent = fhm-outcome(0, 1, 0, 3);
            let c0 = fhm-bit(((Comparable) fhm-logits-executed() == 0), 1);
            let c1 = fhm-bit(((((Comparable) hit == OutHit()) && ((Comparable) miss == OutMiss())) && (((Comparable) late == OutNothing()) && (((Comparable) bare == OutNothing()) && ((Comparable) spent == OutSpent())))), 2);
            let c2 = fhm-bit(((((Comparable) fhm-heeded(hit) == 1) && ((Comparable) fhm-heeded(late) == 1)) && ((Comparable) fhm-heeded(spent) == 0)), 4);
            let c3 = fhm-bit(((((Comparable) fhm-injects-span(hit) == 1) && ((Comparable) fhm-injects-span(miss) == 1)) && (((Comparable) fhm-injects-span(late) == 0) && ((Comparable) fhm-injects-span(spent) == 0))), 8);
            let c4 = fhm-bit(((((Comparable) fhm-injects-knowledge(hit) == 1) && ((Comparable) fhm-injects-knowledge(miss) == 0)) && (((Comparable) fhm-admits-hit(hit, "") == 0) && ((Comparable) fhm-admits-hit(hit, "cell:1") == 1))), 16);
            let c5 = fhm-bit(((((Comparable) fhm-bounded(5) == MaxHeeds()) && ((Comparable) fhm-bounded(1) == 1)) && ((Comparable) fhm-bounded(0) == 0)), 32);
            let c6 = fhm-bit(((((Comparable) fhm-prefill-cost(1000, 12) == 12) && ((Comparable) fhm-naive-cost(1000, 12) == 1012)) && (((Comparable) fhm-forwards-saved(1000, 12) == 1000) && ((Comparable) fhm-prefix-preserved() == 1))), 64);
            let c7 = fhm-bit(((((Comparable) fhm-marks-distinct() == 1) && ((Comparable) fhm-frame-cap() == 305)) && (((String) fhm-span-text(miss, "x", "y") == fhm-miss-text()) && ((String) fhm-span-text(hit, "body", "cell:1") == "body [cell:1]"))), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
