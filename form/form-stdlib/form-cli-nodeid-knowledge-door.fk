// form-cli-nodeid-knowledge-door.fk — the small path-free current-source door
// that form-cli can speak without opening a model or accepting a source path.
//
// A bare key becomes the scannerless concept envelope. A leading @ remains a
// NodeID envelope. The routed executor performs at most one persisted registry
// lookup and one bounded current-source read.  An absent concept route or a
// NodeID without a direct persisted route returns typed nothing with zero
// lookups; the built door never falls through to the linear compatibility
// walk.  This cell normalizes input and renders the already-typed result
// without flattening its identities.
//
// `fcnkd-query` is effectful. `fcnkd-surface` and `fcnkd-render` are pure and
// are the surfaces exercised by the band.
//
// preludes: form-stdlib/form-nodeid-knowledge-routed-query.fk
section [form.bml] {
    def fcnkd-input-valid?(input) = str_len(input) > 0 ? 1 : 0;
    def fcnkd-surface(input) = !((Comparable) fcnkd-input-valid?(input) == 1) ? "" : (Comparable) str_byte_at(input, 0) == 64 ? fknq-nodeid-surface(input) : fknq-concept-surface(input);
    def fcnkd-line(acc, key, value) = str_concat(acc, str_concat("\n", str_concat(key, str_concat("=", value))));
    def fcnkd-render(result) = {
        let r0 = fcnkd-line("nodeid-knowledge", "status", fknq-status(result));
        let rmode = fcnkd-line(r0, "route-mode", "strict-one-bucket");
        let r1 = fcnkd-line(rmode, "reason", fknq-reason(result));
        let r2 = fcnkd-line(r1, "source", fknq-node-key(fknq-source(result)));
        let r3 = fcnkd-line(r2, "entry", fknq-node-key(fknq-entry(result)));
        let r4 = fcnkd-line(r3, "path", fknq-source-path(result));
        let r5 = fcnkd-line(r4, "lookup-count", int_to_str(fknq-lookup-count(result)));
        let r6 = fcnkd-line(r5, "scannerless", int_to_str(fknq-scannerless?(result)));
        let r7 = fcnkd-line(r6, "model-executed", int_to_str(fknq-model-executed?(result)));
        fcnkd-line(r7, "answer", fknq-answer(result));
    };
    // Emitted-stage observation keeps the scanner, route store, registry
    // lookup, current-source read, and final typed observation separable.  A
    // physical carrier can therefore cut at the first growing stage instead of
    // repeating the whole query and guessing which organ held the bytes.
    def fcnkd-stage-head(stage) = fcnkd-line("nodeid-stage", "stage", stage);
    def fcnkd-stage-surface(input) = fcnkd-line(fcnkd-stage-head("surface"), "surface", fcnkd-surface(input));
    def fcnkd-stage-scan(input) = {
        let scan = fknq-bmf-consume-default(fcnkd-surface(input));
        let r0 = fcnkd-line(fcnkd-stage-head("scan"), "status", fknq-scan-status(scan));
        let r1 = fcnkd-line(r0, "reason", fknq-scan-reason(scan));
        let r2 = fcnkd-line(r1, "consumed-bytes", int_to_str(str_len(fknq-scan-consumed(scan))));
        let r3 = fcnkd-line(r2, "cursor-position", int_to_str(fknq-scan-position(scan)));
        fcnkd-line(r3, "scannerless", int_to_str(fknq-scan-scannerless?(scan)));
    };
    def fcnkd-stage-route(input) = {
        let scan = fknq-bmf-consume-default(fcnkd-surface(input));
        !((String) fknq-scan-status(scan) == "ready") ? fcnkd-stage-scan(input) : {
            let request = fknq-scan-request(scan);
            let artifact = fknq-default-artifact();
            let bucket = fknqr-concept-bucket-at(artifact, request);
            let r0 = fcnkd-line(fcnkd-stage-head("route"), "artifact", artifact);
            let r1 = fcnkd-line(r0, "bucket", bucket);
            fcnkd-line(r1, "present", int_to_str(fknqr-concept-bucket-present?(artifact, request)));
        };
    };
    def fcnkd-stage-lookup(input) = {
        let scan = fknq-bmf-consume-default(fcnkd-surface(input));
        !((String) fknq-scan-status(scan) == "ready") ? fcnkd-stage-scan(input) : {
            let request = fknq-scan-request(scan);
            let root = fhcs-default-root();
            let artifact = fknq-default-artifact();
            let registry = fknqr-strict-registry-lookup-at(root, artifact, artifact, request);
            let r0 = fcnkd-line(fcnkd-stage-head("lookup"), "status", fknq-registry-status(registry));
            let r1 = fcnkd-line(r0, "reason", fknq-registry-reason(registry));
            let r2 = fcnkd-line(r1, "path", fknq-registry-path(registry));
            fcnkd-line(r2, "lookup-count", int_to_str(fknq-registry-lookup-count(registry)));
        };
    };
    def fcnkd-stage-current(input) = {
        let scan = fknq-bmf-consume-default(fcnkd-surface(input));
        !((String) fknq-scan-status(scan) == "ready") ? fcnkd-stage-scan(input) : {
            let request = fknq-scan-request(scan);
            let root = fhcs-default-root();
            let artifact = fknq-default-artifact();
            let registry = fknqr-strict-registry-lookup-at(root, artifact, artifact, request);
            let current = (String) fknq-registry-status(registry) == "hit" ? fknq-current-source-result-at(root, registry, request) : fknq-empty-current-result(fknq-registry-reason(registry));
            let r0 = fcnkd-line(fcnkd-stage-head("current"), "status", fkss-status(current));
            let r1 = fcnkd-line(r0, "reason", fkss-reason(current));
            fcnkd-line(r1, "answer-bytes", int_to_str(str_len(fkss-answer(current))));
        };
    };
    def fcnkd-stage(stage, input) = !((Comparable) fcnkd-input-valid?(input) == 1) ? "usage: nodeid-stage surface|scan|route|lookup|current <concept-key|@p.l.t.i>" : (String) stage == "surface" ? fcnkd-stage-surface(input) : (String) stage == "scan" ? fcnkd-stage-scan(input) : (String) stage == "route" ? fcnkd-stage-route(input) : (String) stage == "lookup" ? fcnkd-stage-lookup(input) : (String) stage == "current" ? fcnkd-stage-current(input) : "usage: nodeid-stage surface|scan|route|lookup|current <concept-key|@p.l.t.i>";
    def fcnkd-query(input) = !((Comparable) fcnkd-input-valid?(input) == 1) ? "usage: nodeid-knowledge <concept-key|@p.l.t.i>" : {
        let rendered = fcnkd-render(fknqr-execute-strict(fcnkd-surface(input), 1));
        fcnkd-line(rendered, "artifact", fknq-default-artifact());
    };
    0;
}
