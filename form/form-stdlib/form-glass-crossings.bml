//////////////////////////////////////////////////////////////////////
//
// form-glass-crossings.bml — what actually crosses the membrane, by
// type, shape, volume, time and source.
//
// Urs, 2026-09-09: "glass can see membrane crossing by type shape volume
// time and source where different histograms can illuminate where
// attention can heal being truly home."
//
// A crossing leaves five facts behind and every one of them is already
// kept — this lens invents none of them:
//
//   SOURCE  the frame's own name in the space (root|publisher)
//   TYPE    what kind of surface it is: a snapshot publisher, a control
//           inbox, or a control ack — told apart by the membrane's own
//           suffixes, never by a list written here
//   VOLUME  the frame's SEQUENCE is how many times it has been given,
//           and the snapshot's own sample count is how many rows ride
//           each give. Their product is the real traffic: row-crossings.
//   SHAPE   the kinds the rows carry, counted — a frame that gives the
//           same ninety-five recipe rows every tick says so here
//   TIME    how long since the surface last spoke, taken from the roster's
//           own stamp -- the one clock that covers every slot, including a
//           control frame that carries no epoch of its own
//
// The histograms are folds over those five, and the finding is a
// question rather than a verdict: attention pays most where the largest
// traffic meets the least change, because that is a body carrying the
// same thing across itself over and over.
//
import form/form-stdlib/core.fk;
import form/form-stdlib/form-glass-telemetry-membrane.bml;

section [form.bml] {
    class FormGlassCrossings {
        field FGXSchema = "form-glass-crossing-v1";
        field FGXSlotSchema = "form-glass-slot-v1";
        // a crossing older than this has stopped; it is counted apart so a
        // corpse's lifetime traffic never reads as present load
        field FGXSilentMs = 3000;
        // volume buckets, in row-crossings: the powers a reader can hold
        field FGXBucketSmall = 1000;
        field FGXBucketMedium = 100000;
        field FGXBucketLarge = 10000000;

        // ---- one crossing surface --------------------------------------------
        def fgx-crossing(source, kind, gives, rows, ageMs, shapes) = [FGXSchema(), source, kind, gives, rows, ageMs, shapes];
        def fgx-source(c) = c[1];
        def fgx-type(c) = c[2];
        def fgx-gives(c) = c[3];
        def fgx-rows(c) = c[4];
        def fgx-age(c) = c[5];
        def fgx-shapes(c) = c[6];
        def fgx-crossing?(c) = if (len(c) < 7) then 0 else if ((String) c[0] == FGXSchema()) then 1 else 0;
        // the real traffic: every give carries every row
        def fgx-row-crossings(c) = (fgx-gives(c) * fgx-rows(c));
        // a surface whose last give is inside the window is still carrying
        def fgx-live?(c) = if (fgx-age(c) < 0) then 0 else if (fgx-age(c) > FGXSilentMs()) then 0 else 1;

        // ---- a histogram: (label count) pairs, in first-seen order ------------
        def fgx-bump(h, label, by) = if ((Comparable) len(h) == 0) then [[label, by]] else if ((String) h[0][0] == label) then cons([label, (h[0][1] + by)], h[1:]) else cons(h[0], fgx-bump(h[1:], label, by));
        def fgx-bin-label(b) = b[0];
        def fgx-bin-count(b) = b[1];
        def fgx-bin-of(h, label) = if ((Comparable) len(h) == 0) then 0 else if ((String) h[0][0] == label) then h[0][1] else fgx-bin-of(h[1:], label);
        def fgx-total(h) = if ((Comparable) len(h) == 0) then 0 else (fgx-bin-count(h[0]) + fgx-total(h[1:]));
        def fgx-largest(h, held) = if ((Comparable) len(h) == 0) then held else if ((Comparable) len(held) == 0) then fgx-largest(h[1:], h[0]) else if (fgx-bin-count(h[0]) > fgx-bin-count(held)) then fgx-largest(h[1:], h[0]) else fgx-largest(h[1:], held);

        // ---- the five histograms ---------------------------------------------
        // BY TYPE: how the traffic divides between telemetry and control
        def fgx-by-type(cs, h) = if ((Comparable) len(cs) == 0) then h else fgx-by-type(cs[1:], fgx-bump(h, fgx-type(cs[0]), fgx-row-crossings(cs[0])));
        // BY SOURCE: which giver carries how much
        def fgx-by-source(cs, h) = if ((Comparable) len(cs) == 0) then h else fgx-by-source(cs[1:], fgx-bump(h, fgx-source(cs[0]), fgx-row-crossings(cs[0])));
        // BY SHAPE: which KINDS of row cross, weighted by how often their frame is given
        def fgx-shape-fold(shapes, gives, h) = if ((Comparable) len(shapes) == 0) then h else fgx-shape-fold(shapes[1:], gives, fgx-bump(h, fgx-bin-label(shapes[0]), (fgx-bin-count(shapes[0]) * gives)));
        def fgx-by-shape(cs, h) = if ((Comparable) len(cs) == 0) then h else fgx-by-shape(cs[1:], fgx-shape-fold(fgx-shapes(cs[0]), fgx-gives(cs[0]), h));
        // BY VOLUME: each surface in the bucket its traffic falls in
        def fgx-volume-bucket(n) = if (n < FGXBucketSmall()) then "under-1k" else if (n < FGXBucketMedium()) then "under-100k" else if (n < FGXBucketLarge()) then "under-10m" else "over-10m";
        def fgx-by-volume(cs, h) = if ((Comparable) len(cs) == 0) then h else fgx-by-volume(cs[1:], fgx-bump(h, fgx-volume-bucket(fgx-row-crossings(cs[0])), 1));
        // BY TIME: how long since each surface last crossed
        def fgx-age-bucket(ms) = if (ms < 0) then "never" else if (ms <= 1000) then "this-second" else if (ms <= 60000) then "this-minute" else if (ms <= 3600000) then "this-hour" else "older";
        def fgx-by-time(cs, h) = if ((Comparable) len(cs) == 0) then h else fgx-by-time(cs[1:], fgx-bump(h, fgx-age-bucket(fgx-age(cs[0])), 1));

        // ---- reading the space -----------------------------------------------
        def fgx-surface-type(name) = if ((Comparable) fgtm-suffix?(name, FGTMInboxSuffix()) == 1) then "control-inbox" else if ((Comparable) fgtm-suffix?(name, FGTMAckSuffix()) == 1) then "control-ack" else "snapshot";
        def fgx-kinds(ss, h) = if ((Comparable) len(ss) == 0) then h else fgx-kinds(ss[1:], fgx-bump(h, fgtm-sample-kind(ss[0]), 1));
        def fgx-gives-of(root, name) {
            let handle = ggf-receive(fgtm-space(root, name));
            let seq = ggf-seq(handle);
            let released = ggf-release(handle);
            if (seq < 0) then 0 else seq;
        }
        // TIME comes from the roster's own stamp, and from nowhere else. The
        // roster records the moment a name last registered, which a publisher
        // does on every publish, so it is the one clock that covers EVERY
        // surface: a control inbox carries no epoch of its own, and a snapshot
        // that outlives its giver carries an epoch that says when it was
        // written, not that anyone is still writing. One time source, one
        // answer -- a frame with no roster row has never spoken here, and that
        // reads -1, which is not an age of zero.
        def fgx-age-since(spokeMs, now) = if (spokeMs < 0) then -1 else if (spokeMs > now) then 0 else (now - spokeMs);
        def fgx-read-crossing(root, name, spokeMs, now) {
            let reading = fgtm-read-current(root, name);
            let samples = if ((String) fgtm-read-state-status(reading) == "current") then fgtm-snapshot-samples(fgtm-field-value(fgtm-read-state-value(reading))) else [];
            fgx-crossing(name, fgx-surface-type(name), fgx-gives-of(root, name), len(samples), fgx-age-since(spokeMs, now), fgx-kinds(samples, []));
        }
        def fgx-of-spoken(root, spoken, now) = if ((Comparable) len(spoken) == 0) then [] else cons(fgx-read-crossing(root, spoken[0][0], spoken[0][1], now), fgx-of-spoken(root, spoken[1:], now));
        def fgx-of-space(root, now) = fgx-of-spoken(root, fgtm-spoken-in-space(gift_roster_names(), root), now);

        // ---- the staleness census: every slot in the body, no frame opened ----
        // "Is this stale, and where?" is a question about the whole roster, not
        // about one space, and the roster answers it alone: a name and when it
        // last spoke. No frame is opened, nothing is parsed, and a surface in a
        // space this reader has never heard of is counted the same as its own.
        // The BOUND is the reader's -- fgx-slots-silent takes it as an argument
        // rather than deciding for anyone what counts as too long ago.
        def fgx-slot(name, spokeMs, ageMs) = [FGXSlotSchema(), name, spokeMs, ageMs];
        def fgx-slot-name(s) = s[1];
        def fgx-slot-spoke(s) = s[2];
        def fgx-slot-age(s) = s[3];
        def fgx-slots-of(rows, now) = if ((Comparable) len(rows) == 0) then [] else cons(fgx-slot(fgtm-roster-row-name(rows[0]), fgtm-roster-row-spoke(rows[0]), fgtm-roster-row-age(rows[0], now)), fgx-slots-of(rows[1:], now));
        def fgx-roster-slots(now) = fgx-slots-of(gift_roster_names(), now);
        def fgx-slots-by-time(ss, h) = if ((Comparable) len(ss) == 0) then h else fgx-slots-by-time(ss[1:], fgx-bump(h, fgx-age-bucket(fgx-slot-age(ss[0])), 1));
        def fgx-slots-silent(ss, ms) = if ((Comparable) len(ss) == 0) then [] else if (fgx-slot-age(ss[0]) > ms) then cons(ss[0], fgx-slots-silent(ss[1:], ms)) else fgx-slots-silent(ss[1:], ms);
        def fgx-oldest-slot(ss, held) = if ((Comparable) len(ss) == 0) then held else if ((Comparable) len(held) == 0) then fgx-oldest-slot(ss[1:], ss[0]) else if (fgx-slot-age(ss[0]) > fgx-slot-age(held)) then fgx-oldest-slot(ss[1:], ss[0]) else fgx-oldest-slot(ss[1:], held);

        // ---- the heartbeat: alive is MOVEMENT, not recency -------------------
        // An age says how long ago a name spoke; it cannot say whether that name
        // ever intends to speak again. A band that published once and finished
        // is done, and a witness that was meant to keep giving and stopped is a
        // wound, and after an hour the two read exactly alike. So do not ask the
        // stamp how old it is -- watch whether it MOVES. Two censuses a window
        // apart, and a slot whose stamp advanced spoke inside that window with
        // nobody having to know its cadence. A name present only in the second
        // census has just arrived, which is speech; a name present only in the
        // first did not move.
        //
        // The reading is one-sided, and saying so is the whole honesty of it:
        // MOVEMENT PROVES ALIVE, STILLNESS PROVES NOTHING. A window narrower
        // than a publisher's cadence shows it still while it is perfectly well,
        // and the stamp is milliseconds, so two gives inside one millisecond
        // leave it unchanged -- witnessed 2026-09-09: the same publisher read
        // 1788934128031 twice across two gives, and moved to ...035 only once
        // three milliseconds stood between the censuses. So fgx-still is named
        // for what it saw, not for a verdict: these did not move in THIS
        // window. Widen the window past the cadence you are asking about, and
        // then stillness begins to mean something.
        def fgx-spoke-of(ss, name) = if ((Comparable) len(ss) == 0) then -1 else if ((String) fgx-slot-name(ss[0]) == name) then fgx-slot-spoke(ss[0]) else fgx-spoke-of(ss[1:], name);
        def fgx-moved?(before, s) = if (fgx-slot-spoke(s) > fgx-spoke-of(before, fgx-slot-name(s))) then 1 else 0;
        def fgx-beating(before, after) = if ((Comparable) len(after) == 0) then [] else if ((Comparable) fgx-moved?(before, after[0]) == 1) then cons(after[0], fgx-beating(before, after[1:])) else fgx-beating(before, after[1:]);
        def fgx-still(before, after) = if ((Comparable) len(after) == 0) then [] else if ((Comparable) fgx-moved?(before, after[0]) == 1) then fgx-still(before, after[1:]) else cons(after[0], fgx-still(before, after[1:]));

        // ---- where attention pays --------------------------------------------
        // The largest traffic that is still LIVE: a corpse's lifetime count is
        // history, not load, so it never wins this. A body carrying the same
        // rows across itself over and over is the site worth looking at, and
        // this names it without claiming to know what should change there.
        def fgx-live-only(cs) = if ((Comparable) len(cs) == 0) then [] else if ((Comparable) fgx-live?(cs[0]) == 1) then cons(cs[0], fgx-live-only(cs[1:])) else fgx-live-only(cs[1:]);
        def fgx-heaviest(cs, held) = if ((Comparable) len(cs) == 0) then held else if ((Comparable) len(held) == 0) then fgx-heaviest(cs[1:], cs[0]) else if (fgx-row-crossings(cs[0]) > fgx-row-crossings(held)) then fgx-heaviest(cs[1:], cs[0]) else fgx-heaviest(cs[1:], held);
        def fgx-attention(cs) = fgx-heaviest(fgx-live-only(cs), []);
        def fgx-live-traffic(cs) = fgx-total(fgx-by-source(fgx-live-only(cs), []));
        def fgx-standing-traffic(cs) = fgx-total(fgx-by-source(cs, []));
    }
    0;
}
