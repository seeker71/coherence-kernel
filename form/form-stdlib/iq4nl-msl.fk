; iq4nl-msl.fk — Form-emitted Metal lowering for GGML IQ4_NL type 20.
;
; preludes: form-stdlib/core.fk form-stdlib/iq4nl-layout.bml form-stdlib/iq4nl-dequant.fk

(do
    (defn iq4nlsm-values ()
        "constant char iq4nl_values[16] = { -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113 }; ")
    (defn iq4nlsm-weight ()
        "static inline float iq4nl_w(device const uchar* qb, ulong idx) { ulong blk = idx / 32ul; uint i = uint(idx - blk * 32ul); ulong b = blk * 18ul; uint by = uint(qb[b + 2ul + ulong(i & 15u)]); uint q = (i < 16u) ? (by & 15u) : (by >> 4u); ushort hb = (ushort)qb[b] | ((ushort)qb[b + 1ul] << 8); return float(as_type<half>(hb)) * float(iq4nl_values[q]); } ")
    (defn iq4nlsm-row-gather-body (fname)
        (str_concat "kernel void " (str_concat fname
            " (device const uchar* qb [[buffer(0)]], device const uint* ids [[buffer(1)]], device float* out [[buffer(2)]], constant uint& width [[buffer(3)]], constant uint& nrows [[buffer(4)]], uint gid [[thread_position_in_grid]]) { uint row = gid / width; if (row >= nrows) return; uint col = gid - row * width; uint id = ids[row]; out[row * width + col] = iq4nl_w(qb, ulong(id) * ulong(width) + ulong(col)); }")))
    (defn iq4nlsm-msl-helpers ()
        (str_concat (iq4nlsm-values) (iq4nlsm-weight)))
    0)
