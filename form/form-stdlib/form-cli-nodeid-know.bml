// Executable BML. Authority: form-stdlib/bml/form-cli-nodeid-know.bml
//
// kra-answer wraps as a node-id offer. Unknown is nothing. Ask replies
// outside the stream. Catalog growth on kra grows this door.
// The .fk organ stays; fnkb-agree witnesses they answer as one.
//
// Proven by: form-stdlib/tests/form-cli-nodeid-know-bml-band.fk
//
// preludes: form-stdlib/form-cli-nodeid-answer.fk form-stdlib/knowledge-rest-answer.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNodeidKnowAuthority {
        field KnowAuthorityPath = "form/form-stdlib/bml/form-cli-nodeid-know.bml";
        field KnowAuthorityKind = "high-bml-class-template-field";
    }

    class FormNodeidKnow {
        ref fnkb-authority = FormNodeidKnowAuthority;
        thought fnkb-pattern = list("kra-lookup", "offer-wrap", "ask-outside", "agree-with-organ");

        def fnkb-from-rest-operand(x) = if ((Comparable) lg-defer?(x) == 1) then fnid-recipe(nth(x, 1), fnkb-from-rest-operand(nth(x, 2)), fnkb-from-rest-operand(nth(x, 3))) else x;
        def fnkb-know(q) {
            let rest = kra-answer(q);
            if nothing?(rest) then nothing() else fnkb-from-rest-operand(rest);
        }
        def fnkb-know-reply(q) {
            let p = fnkb-know(q);
            if nothing?(p) then nothing() else fnid-reply(fnid-ask(p));
        }
        def fnkb-row-agrees(row) {
            let q = nth(row, 0);
            let p = fnkb-know(q);
            if nothing?(p) then 0 else if ((Comparable) nothing?(fnid-reply(p)) == 0) then 0 else if ((Comparable) fnkb-know-reply(q) == lg-force(nth(row, 1))) then 1 else 0;
        }
        def fnkb-catalog-agrees(rows) = if ((Comparable) len(rows) == 0) then 1 else if ((Comparable) fnkb-row-agrees(head(rows)) == 0) then 0 else fnkb-catalog-agrees(tail(rows));
        def fnkb-catalog-ok() = if ((Comparable) len(kra-registry()) == 0) then 0 else fnkb-catalog-agrees(kra-registry());
        def fnkbk(cond, bit) = if cond then bit else 0;
        def fnkb-check() {
            (fnkbk(nothing?(fnkb-know("no-such-query")), 1) + (fnkbk(nothing?(fnid-reply(fnkb-know("bootstrap/ground"))), 2) + (fnkbk(((Comparable) fnkb-know-reply("bootstrap/ground") == 42), 4) + (fnkbk(((Comparable) fnkb-know-reply("ground twice") == 84), 8) + (fnkbk(((Comparable) fnkb-catalog-ok() == 1), 16) + (fnkbk(((Comparable) fnid-cost(fnkb-know("bootstrap/ground")) == fnid-cost-outside()), 32) + (fnkbk(((Comparable) fnid-kind(fnkb-know("bootstrap/ground")) == fnid-kind-recipe()), 64) + fnkbk(((Comparable) lg-defer?(fnkb-know("bootstrap/ground")) == 0), 128))))))));
        }
    }
    0;
}
