; form-knowledge-family-native-exec-teach-check.fk -- family-bound teaching
; and checking for one model-requested native recipe execution.
;
; A binding joins one canonical mastery family to its current source/challenge
; hashes and one concrete recipe/input/carrier request.  The teaching frame may
; show the resident model that exact request.  Admission is stricter: the
; model's complete decoded output must equal the canonical request byte for
; byte.  Leading prose, trailing whitespace, duplicate frames, altered input,
; altered carrier, partial frames and unknown NodeIDs never reach a carrier.
;
; `frexl-stream-parse` walks those emitted bytes one at a time.  There is no
; tokenizer grammar pass.  Once exactness and family binding are established,
; a separate live owner may call the existing `frexl-execute-request` Metal
; door.  This pure cell never calls it.  It checks the returned compact typed
; frex result, including request identity, expected value, value-present,
; executed=1, native-code-generated=1, model-executed=0 and lifecycle identity,
; then constructs the existing `fkpfm-execution-evidence` row.
;
; SIGNAL HONESTY. A successful value trace carries choice, crystallize,
; dissolve and release. Failure carries failure/undo/refine/release. Timeout
; carries timeout/cut/undo/refine/release. Nothing remains present=0. These
; incompatible observations are never inserted into a successful trace merely
; to satisfy a vocabulary list; the adversarial band witnesses all outcomes.
;
; CARRIER SEAM. The current concrete frex native executor is Metal. CPU and MLX
; remain valid request names and valid future family bindings, but neither has
; a frex-compatible generated-native executor with physical result flags today.
; This organ returns executable-now=0 for them and cannot issue mastery evidence
; on their behalf. No operations table, flattening, or C growth closes that gap.
;
; No model, carrier, registry, generated artifact or remote lane runs here.
; witnessed: 2026-08-25 -> direct fkwu adversarial band
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk form-stdlib/form-recipe-exec-token-live.fk form-stdlib/form-cli-recipe-exec-cursor.fk

(do
    (defn fkfne-all? (values)
        (if (nil? values) 1
            (if (head values) (fkfne-all? (tail values)) 0)))
    (defn fkfne-cat (parts)
        (if (nil? parts) ""
            (str_concat (head parts) (fkfne-cat (tail parts)))))

    ; ---- family/source/challenge/request binding --------------------
    ; binding = tag family source-sha challenge-sha recipe input carrier
    ;           exact-query binding-sha
    (defn fkfne-binding-message
        (family source-sha challenge-sha recipe input carrier query)
        (nmfe-fields (list "family-native-recipe-binding-v1" family
            source-sha challenge-sha (frex-node-coordinate recipe)
            (int_to_str input) carrier query)))
    (defn fkfne-binding
        (family source-sha challenge-sha recipe input carrier)
        (do
            (let query (frex-surface recipe input carrier))
            (list "family-native-recipe-binding-v1" family source-sha
                challenge-sha recipe input carrier query
                (nmfe-sha256 (fkfne-binding-message family source-sha
                    challenge-sha recipe input carrier query)))))
    (defn fkfne-binding-for (family input carrier)
        (fkfne-binding family (fkpfm-family-source-sha family)
            (fkpfm-family-challenge-sha family) (frex-recipe) input carrier))
    (defn fkfne-binding-for-family (family carrier)
        (fkfne-binding-for family (fkpfm-family-native-input family) carrier))
    (defn fkfne-binding-family (b) (nth b 1))
    (defn fkfne-binding-source-sha (b) (nth b 2))
    (defn fkfne-binding-challenge-sha (b) (nth b 3))
    (defn fkfne-binding-recipe (b) (nth b 4))
    (defn fkfne-binding-input (b) (nth b 5))
    (defn fkfne-binding-carrier (b) (nth b 6))
    (defn fkfne-binding-query (b) (nth b 7))
    (defn fkfne-binding-sha (b) (nth b 8))
    (defn fkfne-concrete-carrier? (carrier)
        (if (or (str_eq carrier "metal")
                (or (str_eq carrier "mlx")
                    (str_eq carrier "cpu"))) 1 0))
    (defn fkfne-carrier-executable-now? (carrier)
        ; frexl-execute-request is presently a concrete Metal door only.
        (if (str_eq carrier "metal") 1 0))
    (defn fkfne-carrier-seam ()
        "metal has concrete generated-native frex execution; cpu and mlx bindings remain non-crediting until equivalent physical frex executors exist")
    (defn fkfne-binding-valid? (b)
        (if (not (eq (fkpfm-list? b) 1)) 0
        (if (not (eq (len b) 9)) 0
        (if (not (str_eq (head b) "family-native-recipe-binding-v1")) 0
            (do
                (let family (fkfne-binding-family b))
                (let source-sha (fkfne-binding-source-sha b))
                (let challenge-sha (fkfne-binding-challenge-sha b))
                (let recipe (fkfne-binding-recipe b))
                (let input (fkfne-binding-input b))
                (let carrier (fkfne-binding-carrier b))
                (let query (fkfne-binding-query b))
                (let expected-message (fkfne-binding-message family source-sha
                    challenge-sha recipe input carrier query))
                (fkfne-all? (list
                    (eq (fkpfm-family? family) 1)
                    (str_eq source-sha (fkpfm-family-source-sha family))
                    (str_eq challenge-sha
                        (fkpfm-family-challenge-sha family))
                    (eq (frex-recipe-valid? recipe) 1)
                    (eq (frexl-i32? input) 1)
                    (eq input (fkpfm-family-native-input family))
                    (eq (fkfne-concrete-carrier? carrier) 1)
                    (str_eq query (frex-surface recipe input carrier))
                    (str_eq (fkfne-binding-sha b)
                        (nmfe-sha256 expected-message)))))))))

    ; ---- typed teaching ---------------------------------------------
    (defn fkfne-teach-open () "<|form:family-native-exec-teach|>")
    (defn fkfne-teach-close () "<|/form:family-native-exec-teach|>")
    (defn fkfne-teach-frame (binding)
        (if (not (eq (fkfne-binding-valid? binding) 1)) ""
            (fkfne-cat (list
                (fkfne-teach-open)
                "\nfamily=" (fkfne-binding-family binding)
                "\nsource-sha=" (fkfne-binding-source-sha binding)
                "\nchallenge-sha=" (fkfne-binding-challenge-sha binding)
                "\nbinding-sha=" (fkfne-binding-sha binding)
                "\nrequest exactly these bytes with no leading or trailing byte:"
                "\n" (fkfne-binding-query binding)
                "\nForm, not the model, will JIT and execute the recipe."
                "\n" (fkfne-teach-close)))))

    ; ---- exact raw-byte preparation ---------------------------------
    ; preparation = tag status reason binding emitted-sha request cursor
    ;               exact scannerless pretokenized model-requested
    (defn fkfne-preparation
        (status reason binding emitted-sha request cursor exact scannerless
         pretokenized model-requested)
        (list "family-native-recipe-preparation-v1" status reason binding
              emitted-sha request cursor exact scannerless pretokenized
              model-requested))
    (defn fkfne-prep-status (p) (nth p 1))
    (defn fkfne-prep-reason (p) (nth p 2))
    (defn fkfne-prep-binding (p) (nth p 3))
    (defn fkfne-prep-emitted-sha (p) (nth p 4))
    (defn fkfne-prep-request (p) (nth p 5))
    (defn fkfne-prep-cursor (p) (nth p 6))
    (defn fkfne-prep-exact? (p) (nth p 7))
    (defn fkfne-prep-scannerless? (p) (nth p 8))
    (defn fkfne-prep-pretokenized? (p) (nth p 9))
    (defn fkfne-prep-model-requested? (p) (nth p 10))
    (defn fkfne-request-shape? (request)
        (if (not (eq (fkpfm-list? request) 1)) 0
            (if (eq (len request) 6) 1 0)))
    (defn fkfne-cursor-shape? (cursor)
        (if (not (eq (fkpfm-list? cursor) 1)) 0
            (if (eq (len cursor) 4) 1 0)))
    (defn fkfne-request-bound? (binding request)
        (if (not (eq (fkfne-request-shape? request) 1)) 0
        (if (not (eq (frex-request-ready? request) 1)) 0
            (fkfne-all? (list
                (node_eq (frex-request-recipe request)
                         (fkfne-binding-recipe binding))
                (eq (frex-request-input request)
                    (fkfne-binding-input binding))
                (str_eq (frex-request-carrier request)
                    (fkfne-binding-carrier binding))
                    (node_eq (frex-request-token request)
                    (frex-request-node (fkfne-binding-recipe binding)
                        (fkfne-binding-input binding)
                        (fkfne-binding-carrier binding))))))))
    (defn fkfne-prepare (binding emitted)
        (do
            ; This is the one-byte scannerless path. Parsing happens even for
            ; rejected output, but no carrier callback exists in this cell.
            (let streamed (frexl-stream-parse emitted))
            (let request (frexl-stream-request streamed))
            (let cursor (frexl-stream-cursor streamed))
            (let binding-ok (fkfne-binding-valid? binding))
            (let exact (if (and (eq binding-ok 1)
                (str_eq emitted (fkfne-binding-query binding))) 1 0))
            (let ready (if (and (eq exact 1)
                (and (eq (frexl-cursor-complete? cursor) 1)
                     (eq (fkfne-request-bound? binding request) 1))) 1 0))
            (let reason
                (if (not (eq binding-ok 1)) "family-binding-refused"
                (if (not (eq exact 1)) "exact-query-refused"
                (if (not (eq (frexl-cursor-complete? cursor) 1))
                    "scannerless-frame-incomplete"
                (if (not (eq (fkfne-request-bound? binding request) 1))
                    "request-binding-refused" "ready")))))
            (fkfne-preparation
                (if (eq ready 1) "ready" "nothing") reason binding
                (nmfe-sha256 emitted) request cursor exact 1
                (frexl-stream-pretokenized? streamed) ready)))
    (defn fkfne-preparation-valid? (p)
        (if (not (eq (fkpfm-list? p) 1)) 0
        (if (not (eq (len p) 11)) 0
        (if (not (str_eq (head p)
                         "family-native-recipe-preparation-v1")) 0
        (if (not (str_eq (fkfne-prep-status p) "ready")) 0
        (if (not (eq (fkfne-binding-valid? (fkfne-prep-binding p)) 1)) 0
        (if (not (eq (fkfne-request-shape? (fkfne-prep-request p)) 1)) 0
        (if (not (eq (fkfne-cursor-shape? (fkfne-prep-cursor p)) 1)) 0
            (fkfne-all? (list
                (eq (fkfne-prep-exact? p) 1)
                (eq (fkfne-prep-scannerless? p) 1)
                (eq (fkfne-prep-pretokenized? p) 0)
                (eq (fkfne-prep-model-requested? p) 1)
                (eq (frexl-cursor-overflow?
                    (fkfne-prep-cursor p)) 0)
                (eq (frexl-cursor-complete?
                    (fkfne-prep-cursor p)) 1)
                (eq (frexl-cursor-bytes (fkfne-prep-cursor p))
                    (str_len (fkfne-binding-query
                        (fkfne-prep-binding p))))
                (eq (fkfne-request-bound? (fkfne-prep-binding p)
                    (fkfne-prep-request p)) 1)))))))))))

    ; ---- result and mastery-evidence check --------------------------
    (defn fkfne-result-signal-valid? (result)
        (if (not (eq (fkpfm-list? result) 1)) 0
        (if (not (eq (len result) 13)) 0
        (if (not (eq (frex-result-model-executed? result) 0)) 0
            (if (str_eq (frex-result-status result) "value")
                (if (eq (frex-result-value-present? result) 1) 1 0)
                (if (and (eq (frex-result-value-present? result) 0)
                    (or (str_eq (frex-result-status result) "nothing")
                    (or (str_eq (frex-result-status result) "failure")
                        (str_eq (frex-result-status result) "timeout")))) 1 0))))))
    (defn fkfne-native-result-bound? (binding prep result)
        (if (not (and (eq (fkfne-binding-valid? binding) 1)
                      (eq (fkfne-preparation-valid? prep) 1))) 0
            (fkfne-all? (list
                (eq (fkfne-carrier-executable-now?
                    (fkfne-binding-carrier binding)) 1)
                (eq (fkpfm-native-result-valid? result) 1)
                (eq (fkpfm-native-result-family-bound?
                    (fkfne-binding-family binding) result) 1)
                (node_eq (frex-result-request result)
                    (frex-request-token (fkfne-prep-request prep)))
                (node_eq (frex-result-recipe result)
                    (fkfne-binding-recipe binding))
                (str_eq (frex-result-carrier result)
                    (fkfne-binding-carrier binding))
                (eq (frex-result-value-present? result) 1)
                (eq (frex-result-value result)
                    (frexl-recipe-expected (fkfne-binding-recipe binding)
                        (fkfne-binding-input binding)))
                (eq (frex-result-executed? result) 1)
                (eq (frex-result-model-executed? result) 0)
                (eq (frex-result-native-code-generated? result) 1)))))
    (defn fkfne-output-message (binding prep result)
        (nmfe-fields (list "family-native-recipe-output-v1"
            (fkfne-binding-sha binding) (fkfne-prep-emitted-sha prep)
            (frex-node-key (frex-result-request result))
            (frex-node-key (frex-result-observation result))
            (frex-result-carrier result)
            (int_to_str (frex-result-value-present? result))
            (int_to_str (frex-result-value result))
            (frex-trace-actions (frex-result-trace result)))))
    (defn fkfne-output-sha (binding prep result)
        (nmfe-sha256 (fkfne-output-message binding prep result)))

    (defn fkfne-result-same? (a b)
        (if (not (eq (fkpfm-list? a) 1)) 0
        (if (not (eq (fkpfm-list? b) 1)) 0
        (if (not (eq (len a) 13)) 0
        (if (not (eq (len b) 13)) 0
            (fkfne-all? (list
                (str_eq (frex-result-status a) (frex-result-status b))
                (str_eq (frex-result-reason a) (frex-result-reason b))
                (node_eq (frex-result-request a) (frex-result-request b))
                (node_eq (frex-result-recipe a) (frex-result-recipe b))
                (str_eq (frex-result-carrier a) (frex-result-carrier b))
                (eq (frex-result-value a) (frex-result-value b))
                (eq (frex-result-value-present? a)
                    (frex-result-value-present? b))
                (eq (fkpfm-node-list-eq? (frex-result-trace a)
                    (frex-result-trace b)) 1)
                (node_eq (frex-result-observation a)
                    (frex-result-observation b))
                (eq (frex-result-executed? a) (frex-result-executed? b))
                (eq (frex-result-model-executed? a)
                    (frex-result-model-executed? b))
                (eq (frex-result-native-code-generated? a)
                    (frex-result-native-code-generated? b))
                (eq (frex-result-attempts a) (frex-result-attempts b)))))))))

    ; check = tag status reason binding prep result typed output-sha evidence
    ;         structured-receipt raw-query model-id run-id remote release
    (defn fkfne-check-row
        (status reason binding prep result typed output-sha evidence receipt
         raw-query model-id run-id remote-calls release-ok)
        (list "family-native-recipe-check-v2" status reason binding prep result
              typed output-sha evidence receipt raw-query model-id run-id
              remote-calls release-ok))
    (defn fkfne-check-status (c) (nth c 1))
    (defn fkfne-check-reason (c) (nth c 2))
    (defn fkfne-check-binding (c) (nth c 3))
    (defn fkfne-check-prep (c) (nth c 4))
    (defn fkfne-check-result (c) (nth c 5))
    (defn fkfne-check-typed (c) (nth c 6))
    (defn fkfne-check-output-sha (c) (nth c 7))
    (defn fkfne-check-evidence (c) (nth c 8))
    (defn fkfne-check-receipt (c) (nth c 9))
    (defn fkfne-check-raw-query (c) (nth c 10))
    (defn fkfne-check-model-id (c) (nth c 11))
    (defn fkfne-check-run-id (c) (nth c 12))
    (defn fkfne-check-remote-calls (c) (nth c 13))
    (defn fkfne-check-release-ok? (c) (nth c 14))
    (defn fkfne-check
        (binding prep result model-id run-id remote-calls release-ok)
        (do
            (let result-bound
                (fkfne-native-result-bound? binding prep result))
            (let typed (if (eq result-bound 1) (frex-render result) ""))
            (let raw-query (if (eq (fkfne-binding-valid? binding) 1)
                (fkfne-binding-query binding) ""))
            (let output-sha (nmfe-sha256 typed))
            (let base-ok (fkfne-all? (list
                (eq result-bound 1)
                (gt (str_len model-id) 0)
                (eq (nmfe-sha256? run-id) 1)
                (eq remote-calls 0)
                (eq release-ok 1)
                (eq (frxc-observation-valid? typed) 1))))
            ; The preparation carries the emitted digest, not the bytes.
            ; Re-state that relation explicitly before constructing a receipt.
            (let bytes-bound (if (eq base-ok 1)
                (str_eq (fkfne-prep-emitted-sha prep)
                    (nmfe-sha256 raw-query)) 0))
            (let receipt
                (if (and (eq base-ok 1) (eq bytes-bound 1))
                    (fkpfm-execution-receipt
                        (fkfne-binding-family binding) model-id run-id
                        raw-query result)
                    (nothing)))
            (let evidence
                (if (and (eq base-ok 1) (eq bytes-bound 1))
                    (fkpfm-execution-evidence
                        (fkfne-binding-family binding) model-id receipt
                        raw-query (fkfne-prep-model-requested? prep)
                        remote-calls release-ok result)
                    (nothing)))
            (let admitted
                (if (nothing? evidence) (nothing) (fkpfm-admit evidence)))
            (if (nothing? admitted)
                (fkfne-check-row "nothing" "mastery-evidence-refused"
                    binding prep result typed output-sha evidence receipt
                    raw-query model-id run-id remote-calls release-ok)
                (fkfne-check-row "value" "family-native-execution-admitted"
                    binding prep result typed output-sha admitted receipt
                    raw-query model-id run-id remote-calls release-ok))))
    (defn fkfne-check-valid? (check)
        (if (not (eq (fkpfm-list? check) 1)) 0
        (if (not (eq (len check) 15)) 0
        (if (not (str_eq (head check) "family-native-recipe-check-v2")) 0
        (if (not (str_eq (fkfne-check-status check) "value")) 0
            (do
                (let binding (fkfne-check-binding check))
                (let prep (fkfne-check-prep check))
                (let result (fkfne-check-result check))
                (let typed (fkfne-check-typed check))
                (let output-sha (fkfne-check-output-sha check))
                (let evidence (fkfne-check-evidence check))
                (let receipt (fkfne-check-receipt check))
                (let raw-query (fkfne-check-raw-query check))
                (let model-id (fkfne-check-model-id check))
                (let run-id (fkfne-check-run-id check))
                (let remote (fkfne-check-remote-calls check))
                (let release (fkfne-check-release-ok? check))
                (if (not (eq (fkfne-native-result-bound?
                    binding prep result) 1)) 0
                (if (not (eq (fkpfm-receipt-valid? receipt) 1)) 0
                (if (not (eq (fkpfm-execution-valid? evidence) 1)) 0
                (fkfne-all? (list
                (str_eq (fkfne-check-reason check)
                    "family-native-execution-admitted")
                (eq (fkfne-native-result-bound?
                    binding prep result) 1)
                (str_eq typed (frex-render result))
                (eq (frxc-observation-valid? typed) 1)
                (str_eq output-sha (nmfe-sha256 typed))
                (str_eq raw-query (fkfne-binding-query binding))
                (str_eq (fkfne-prep-emitted-sha prep)
                    (nmfe-sha256 raw-query))
                (str_eq model-id (nth evidence 3))
                (str_eq run-id (nth evidence 14))
                (str_eq (fkfne-binding-family binding) (nth evidence 2))
                (eq (fkpfm-equal? receipt (nth evidence 4)) 1)
                (str_eq output-sha (nth evidence 5))
                (str_eq raw-query (nth evidence 9))
                (eq (fkfne-result-same? result (nth evidence 13)) 1)
                (str_eq (fkpfm-receipt-kind receipt) "execution")
                (str_eq (fkpfm-receipt-family receipt)
                    (fkfne-binding-family binding))
                (str_eq (fkpfm-receipt-model-id receipt) model-id)
                (str_eq (fkpfm-receipt-run-id receipt) run-id)
                (str_eq (fkpfm-receipt-model-output receipt) raw-query)
                (str_eq (fkpfm-receipt-model-output-sha receipt)
                    (nmfe-sha256 raw-query))
                (str_eq (fkpfm-receipt-artifact-output receipt) typed)
                (str_eq (fkpfm-receipt-artifact-output-sha receipt)
                    output-sha)
                (eq (fkpfm-receipt-model-requested? receipt)
                    (fkfne-prep-model-requested? prep))
                (eq remote 0)
                (eq release 1)
                (eq remote (nth evidence 11))
                (eq release (nth evidence 12))
                (eq remote (fkpfm-receipt-remote-calls receipt))
                (eq release (fkpfm-receipt-release-ok? receipt)))))))))))))

    0)
