  }
  // one planned chunk: [path, byte offset, source samples, source rate, rest flag]; [] when the id has no audio
  def vmm-chunk-plan(pcm-dir, wav-dir, id, flag, sr) {
   let pp = pcm-dir ++ "/" ++ id.str() ++ ".pcm";
   let wp = wav-dir ++ "/" ++ id.str() ++ ".wav";
   let ps = file_size(pp);
   let wi = ps > 0 ? [] : vmm-wav-info(wp);
   ps > 0 ? [pp, 0, ps / 2, sr, flag] : ((nil?(wi)) ? [] : ((((Comparable) wi[3] == 1) && (((Comparable) wi[4] == 16) && ((Comparable) wi[5] == 1))) ? [wp, wi[0], wi[1] / 2, wi[2], flag] : []));
  }
  def vmm-map-flags(s, i, acc) = i >= len(s) ? reverse(acc) : vmm-map-flags(s, i + 1, (str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 50) ? cons(str_byte_at(s, i) - 48, acc) : acc);
  def vmm-plan-go(pcm-dir, wav-dir, flags, i, sr, acc) = nil?(flags) ? reverse(acc) : vmm-plan-go(pcm-dir, wav-dir, flags[1:], i + 1, sr, (nil?(vmm-chunk-plan(pcm-dir, wav-dir, 1000 + i, flags[0], sr))) ? acc : cons(vmm-chunk-plan(pcm-dir, wav-dir, 1000 + i, flags[0], sr), acc));
  def vmm-plan(pcm-dir, wav-dir, map-path, sr) = vmm-plan-go(pcm-dir, wav-dir, vmm-map-flags(read_file(map-path), 0, []), 0, sr, []);
  // length of a chunk at the track's rate: ceil(ns * sr / rate)
  def vmm-out-len(c, sr) = ((c[2] * sr) + (c[3] - 1)) / c[3];
  def vmm-plan-total(plan, sr) = nil?(plan) ? 0 : (vmm-out-len(plan[0], sr) + vmm-rest-samples(sr, plan[0][4]) + vmm-plan-total(plan[1:], sr));
  // place every chunk: map the file, find its peak after the fades, write it normalised at its offset.
  // Returns the mapped handles (the caller frees them after the sync).
  def vmm-place-go(ps, plan, out, pkb, k, pos, sr, fin, fout, acc) {
   let c = plan[0];
   let n = vmm-out-len(c, sr);
   let h = metal_buf_from_file(c[0], c[1], c[2] * 2);
   let okh = h <= 0 ? form_error("voice-master: could not map " ++ c[0]) : h;
   let pk = vmm-go1(ps, vmm-pi-peak(), [okh, pkb], [c[2], n, k, fin, fout, c[3], sr]);
   let pl = vmm-go(ps, vmm-pi-place(), [okh, out, pkb], [c[2], n, k, pos, fin, fout, c[3], sr, vmm-cf(0.1)], n);
   nil?(plan[1:]) ? cons(okh, acc) : vmm-place-go(ps, plan[1:], out, pkb, k + 1, pos + n + vmm-rest-samples(sr, c[4]), sr, fin, fout, cons(okh, acc));
  }
  // the whole assembly into `out` (n floats, zeroed here); returns [mapped handles, peak buffer]
  def vmm-assemble(ps, out, n, plan, sr) {
   let z = vmm-zero(ps, out, n);
   let pkb = vmm-falloc(len(plan) + 1);
   let hs = nil?(plan) ? [] : vmm-place-go(ps, plan, out, pkb, 0, 0, sr, vmm-round(sr * 0.03), vmm-round(sr * 0.06), []);
   [hs, pkb];
  }

  // ================= dynamics =================
  def vmm-comp-pieces-buf(pieces) = vmm-fput(vmm-flat(pieces));
  // the follower over [0, n) in slices, then the gain; x -> y (y may not alias x or env)
  def vmm-env-slices(ps, x, env, st, from, n, slice, ra, rd) {
   let cnt = vmm-min(slice, n - from);
   let r = vmm-go1(ps, vmm-pi-env(), [x, env, st], [from, cnt, vmm-cf(ra), vmm-cf(rd)]);
   let sy = vmm-sync();
   (from + cnt) >= n ? 1 : vmm-env-slices(ps, x, env, st, from + cnt, n, slice, ra, rd);
  }
  def vmm-compress(ps, x, env, y, n, sr, pieces, makeup, attack, decay, initial-db, delay-s) {
   let st = vmm-fput([vmm-undb(initial-db), 0.0, 0.0, 0.0]);
   let pc = vmm-comp-pieces-buf(pieces);
   let ra = math_exp(0.0 - (1.0 / (sr * attack)));
   let rd = math_exp(0.0 - (1.0 / (sr * decay)));
   let e = vmm-env-slices(ps, x, env, st, 0, n, 4194304, ra, rd);
   let g = vmm-go(ps, vmm-pi-comp(), [x, env, y, pc], [n, vmm-round(sr * delay-s), len(pieces), vmm-cf(makeup)], n);
   let sy = vmm-sync();
   let f = vmm-free([st, pc]);
   g;
  }

  // ================= room =================
  def vmm-room-comb-base() = [1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617];
  def vmm-room-ap-base() = [556, 441, 341, 225];
  // early reflections: delay in ms, gain (signs alternate so the line colours the sound little)
  def vmm-room-er-ms() = [7.3, 11.9, 17.1, 23.7, 29.3, 36.1, 43.9, 52.3];
  def vmm-room-er-gain() = [0.5, 0.0 - 0.42, 0.36, 0.0 - 0.3, 0.26, 0.0 - 0.22, 0.18, 0.0 - 0.15];
  def vmm-scale-list(xs, f) = nil?(xs) ? [] : cons(vmm-max(1, vmm-round(xs[0] * f)), vmm-scale-list(xs[1:], f));
  def vmm-ms-list(xs, sr, f) = nil?(xs) ? [] : cons(vmm-max(1, vmm-round(xs[0] * sr * f / 1000.0)), vmm-ms-list(xs[1:], sr, f));
  def vmm-sum-i(xs) = nil?(xs) ? 0 : (xs[0] + vmm-sum-i(xs[1:]));
  def vmm-comb-feedback(ds, sr, rt60) = nil?(ds) ? [] : cons(math_pow(10.0, (0.0 - 3.0) * ds[0] / (rt60 * sr)), vmm-comb-feedback(ds[1:], sr, rt60));
  // geometry: [geo uints, gain floats, ring floats per thread]. `room` scales every delay (1.0 is Freeverb's own at this rate).
  def vmm-room-geometry(sr, room, rt60, damp, wet) {
   let f = sr / 44100.0 * room;
   let cd = vmm-scale-list(vmm-room-comb-base(), f);
   let ad = vmm-scale-list(vmm-room-ap-base(), f);
   let ed = vmm-ms-list(vmm-room-er-ms(), sr, room);
   [vmm-flat([[8], cd, [4], ad, [8], ed]), vmm-flat([vmm-comb-feedback(cd, sr, rt60), [damp, 0.5], vmm-room-er-gain(), [wet]]), vmm-sum-i(cd) + vmm-sum-i(ad)];
  }
  // the room over x -> y with `dry` mixed; wet is gp[18]. blk 0 runs it as one thread (warm is then ignored).
  def vmm-room-run(ps, x, y, n, geo, gpv, ring, blk, warm, dry) {
   let gb = vmm-uput(geo);
   let pb = vmm-fput(gpv);
   let threads = vmm-ceil-div(n, blk);
   let sc = vmm-falloc(threads * ring);
   let r = vmm-go(ps, vmm-pi-room(), [x, y, sc, gb, pb], [n, blk, warm, ring, vmm-cf(dry)], threads);
   let sy = vmm-sync();
   let f = vmm-free([gb, pb, sc]);
   r;
  }
  def vmm-with-wet(gpv, wet) = vmm-cat(vmm-take(gpv, 18), [wet]);
  // the wet path's impulse-response energy (sum h^2 with the wet gain at 1), measured by running an impulse through it
  def vmm-room-energy(ps, geo, gpv, ring, sr, rt60) {
   let m = vmm-round(sr * rt60 * 5.0) + vmm-round(sr * 0.2);
   let x = vmm-falloc(m);
   let y = vmm-falloc(m);
   let z = vmm-zero(ps, x, m);
   let one = vmm-fill-at(ps, x, 0, 1, 1.0);
   let r = vmm-room-run(ps, x, y, m, geo, vmm-with-wet(gpv, 1.0), ring, m, 0, 0.0);
   let st = vmm-stats(ps, y, 0, m);
   let f = vmm-free([x, y]);
   st[0] * m;
  }
  // the wet gain that puts the wet path at wet_db relative to unit-energy: wet power / white-noise dry power = wet_db
  def vmm-room-wet-gain(energy, wet-db) = vmm-undb(wet-db) / math_sqrt(energy);

  // ================= ends, loudness, peaks, spectrum =================
  def vmm-ramp(ps, y, n, fin, fout) = vmm-go(ps, vmm-pi-ramp(), [y], [n, fin, fout], n);
  def vmm-hop-samples(sr) = vmm-round(sr * 0.1);
  // [integrated LUFS, relative gate, gated blocks, LRA, L10, L95, ST gate, ST count, abs-gated blocks]
  def vmm-loudness(ps, x, scratch, n, sr) {
   let hs = vmm-hop-samples(sr);
   let nh = n / hs;
   let k = vmm-iir(ps, x, scratch, n, vmm-k-chain(sr), 16384, 16384);
   let hb = vmm-falloc(nh + 4);
   let h = vmm-go(ps, vmm-pi-hop(), [scratch, hb], [hs, nh], nh);
   let ob = vmm-falloc(12);
   let g = vmm-go1(ps, vmm-pi-gate(), [hb, ob], [nh, hs]);
   let sy = vmm-sync();
   let r = vmm-read(ob, 0, 9);
   let f = vmm-free([hb, ob]);
   r;
  }
  // the 4x oversampling taps: three phases of a 24-tap Hann-windowed sinc
  def vmm-tp-tap(k, p) {
   let a = ((k - 11) * 1.0) - ((p + 1) * 0.25);
   let s = (Comparable) a == 0.0 ? 1.0 : vmm-sin(vmm-pi() * a) / (vmm-pi() * a);
   s * (0.5 + (0.5 * vmm-cos(vmm-pi() * a / 12.5)));
  }
  def vmm-tp-taps-go(i, acc) = i >= 72 ? reverse(acc) : vmm-tp-taps-go(i + 1, cons(vmm-tp-tap(i % 24, i / 24), acc));
  // [sample peak, true peak] as linear amplitudes
  def vmm-peaks(ps, x, n) {
   let ob = vmm-falloc(4);
   let zb = vmm-put(ob, 0, vmm-u32s([0, 0, 0, 0]));
   let tb = vmm-fput(vmm-tp-taps-go(0, []));
   let per = 4096;
   let r = vmm-go(ps, vmm-pi-peaks(), [x, ob, tb], [n, per], vmm-ceil-div(n, per));
   let sy = vmm-sync();
   let v = vmm-read(ob, 0, 2);
   let f = vmm-free([ob, tb]);
   v;
  }
  // The centroid, in Hz, of the squared MEAN-MAGNITUDE spectrum: nf frames of L samples spread evenly across the
  // track, a DFT of each (rectangular window, or Hann), the magnitude averaged per bin across frames, then squared —
  // the quantity the sleep-track assessment reads. L is a power of two (an FFT, Stockham radix-2, 15 dispatches for
  // every frame at once), so 1 Hz bins are not on offer; the centroid does not need them.
  def vmm-fft-run(ps, a, b, L, nf, ns) {
   let r = ns >= L ? 0 : vmm-go(ps, vmm-pi-fftstage(), [a, b], [L, ns, nf * (L / 2)], nf * (L / 2));
   ns >= L ? a : vmm-fft-run(ps, b, a, L, nf, ns * 2);
  }
  def vmm-pow2-ceil(n, p) = p >= n ? p : vmm-pow2-ceil(n, p * 2);
  def vmm-centroid-frames(ps, x, n, sr, L, nf, hann) {
   let stride = nf > 1 ? ((n - L) / (nf - 1)) : 0;
   let nb = (L / 2) + 1;
   let fa = vmm-falloc(nf * L * 2);
   let fb = vmm-falloc(nf * L * 2);
   let pw = vmm-falloc(nb);
   let out = vmm-falloc(2);
   let a = vmm-go(ps, vmm-pi-fftload(), [x, fa], [n, nf, stride, L, hann], nf * L);
   let res = vmm-fft-run(ps, fa, fb, L, nf, 1);
   let m = vmm-go(ps, vmm-pi-fftmag(), [res, pw], [nf, L], nb);
   let c = vmm-go1(ps, vmm-pi-cent(), [pw, out], [nb, vmm-cf((sr * 1.0) / L)]);
   let sy = vmm-sync();
   let r = vmm-read(out, 0, 1);
   let f = vmm-free([fa, fb, pw, out]);
   r[0];
  }
  def vmm-centroid-nf(n, L) = n < (2 * L) ? 1 : vmm-min(120, ((n - L) / L) + 1);
  def vmm-centroid(ps, x, n, sr) {
   let L = vmm-pow2-ceil(sr, 1);
   vmm-centroid-frames(ps, x, n, sr, L, vmm-centroid-nf(n, L), 0);
  }

  // ================= the file =================
  // header and samples built on the device in one buffer, read back once, written once
  def vmm-emit(ps, x, n, gain, dither, sr, path) {
   let total = 44 + (n * 2);
   let o = vmm-alloc(total);
   let hd = vmm-put(o, 0, vmm-wav-header(sr, n));
   let p = vmm-go(ps, vmm-pi-pack(), [x, o], [n, 44, vmm-cf(gain), dither], n);
   let sy = vmm-sync();
   let s = metal_buf_read(o, 0, total);
   let w = nothing?(s) ? form_error("voice-master: read of the packed file refused") : write_file(path, s);
   let f = vmm-free([o]);
   w < 0 ? form_error("voice-master: could not write " ++ path) : w;
  }

  // ================= measuring a file that already exists =================
  // loudness, loudness range, peaks and centroid of n floats in x (scratch is a second n-float buffer)
  def vmm-measure-buf(ps, x, scratch, n, sr) {
   let ld = vmm-loudness(ps, x, scratch, n, sr);
   let pk = vmm-peaks(ps, x, n);
   let ce = vmm-centroid(ps, x, n, sr);
   [["seconds", vmm-r2(n * 1.0 / sr)], ["lufs", vmm-r3(ld[0])], ["lra", vmm-r3(ld[3])], ["l10", vmm-r3(ld[4])], ["l95", vmm-r3(ld[5])], ["sample_peak_dbfs", vmm-r3(vmm-db(pk[0]))], ["true_peak_dbtp", vmm-r3(vmm-db(pk[1]))], ["centroid_hz", vmm-r2(ce)]];
  }
  // a mono 16-bit PCM WAV, mapped and measured on the device. [] rows when it is some other file.
  def vmm-measure-wav(ps, path) {
   let wi = vmm-wav-info(path);
   (nil?(wi)) ? [] : vmm-measure-wav-go(ps, path, wi);
  }
  def vmm-measure-wav-go(ps, path, wi) {
   let n = wi[1] / 2;
   let m = metal_buf_from_file(path, wi[0], n * 2);
   let a = vmm-falloc(n);
   let b = vmm-falloc(n);
   let u = vmm-go(ps, vmm-pi-unpack(), [m, a], [n], n);
   let sy = vmm-sync();
   let rows = (((Comparable) wi[3] == 1) && ((Comparable) wi[4] == 16)) ? vmm-measure-buf(ps, a, b, n, wi[2]) : [];
   let f = vmm-free([a, b, m]);
   rows;
  }

  // ================= one GPU at a time =================
  // concurrent Metal clients wedge in uninterruptible waits, so a run that touches the device holds the GPU lease
  // (gpu-lease.bml): a lock with an owner, so a live holder is waited for (20 minutes), a dead one is taken over,
  // and only the holder gives it back. The take answers data (["held" token] ["waited" ms token]
  // ["took-over-stale" prev token] ["refused" reason ...]); the give takes that answer and gives back only a lease
  // this answer holds.
  def vmm-lock-path() = gpu-lease-path();
  def vmm-gpu-lock(label) = gpu-lease-take(vmm-lock-path(), label, gpl-wait-ms());
  def vmm-gpu-held?(lease) = gpu-lease-held?(lease);
  def vmm-gpu-unlock(lease) = gpu-lease-give(vmm-lock-path(), lease);

  // ================= the recipe, end to end =================
  def vmm-tone-blk() = 16384;
  def vmm-tone-warm() = 8192;
  def vmm-target-lufs() = 0.0 - 30.0;
  def vmm-target-tp() = 0.0 - 8.0;
  def vmm-room-rt60() = 0.7;
  def vmm-room-wet-db() = 0.0 - 6.0;
  def vmm-room-damp() = 0.4;
  def vmm-tail-seconds() = 1.5;
  def vmm-now() = host_monotonic_ms();
  // The mastered track. plan comes from vmm-plan; the report is a list of [name, value] rows.
  def vmm-master(ps, plan, out-path, sr) = vmm-master-profile(ps, plan, out-path, sr, "gentle");
  def vmm-master-profile(ps, plan, out-path, sr, profile) {
   let t0 = vmm-now();
   let n-asm = vmm-plan-total(plan, sr);
   let delay = vmm-round(sr * vmm-comp-delay());
   let n = n-asm + delay + vmm-round(sr * vmm-tail-seconds());
   let A = vmm-falloc(n);
   let B = vmm-falloc(n);
   let C = vmm-falloc(n);
   let as = vmm-assemble(ps, A, n, plan, sr);
   let sy1 = vmm-sync();
   let fr1 = vmm-free(cons(as[1], as[0]));
   let t1 = vmm-now();
   let tone = vmm-iir(ps, A, B, n, vmm-tone-chain(sr), vmm-tone-blk(), vmm-tone-warm());
   let t2 = vmm-now();
   let cm = vmm-compress(ps, B, C, A, n, sr, vmm-pieces(vmm-comp-points-of(profile)), vmm-comp-makeup(), vmm-comp-attack(), vmm-comp-decay(), vmm-comp-initial-db(), vmm-comp-delay());
   let t3 = vmm-now();
   let geom = vmm-room-geometry(sr, 1.0, vmm-room-rt60(), vmm-room-damp(), 1.0);
   let en = vmm-room-energy(ps, geom[0], geom[1], geom[2], sr, vmm-room-rt60());
   let wet = vmm-room-wet-gain(en, vmm-room-wet-db());
   let warm = vmm-round(sr * vmm-room-rt60() * 2.0);
   let rm = vmm-room-run(ps, A, B, n, geom[0], vmm-with-wet(geom[1], wet), geom[2], 32768, warm, 1.0);
   let t4 = vmm-now();
   let ld0 = vmm-loudness(ps, A, C, n, sr);
   let ld1 = vmm-loudness(ps, B, C, n, sr);
   let rp = vmm-ramp(ps, B, n, vmm-round(sr * 6.0), vmm-round(sr * 15.0));
   let sy2 = vmm-sync();
   let ld = vmm-loudness(ps, B, C, n, sr);
   let pk = vmm-peaks(ps, B, n);
   let sane = pk[1] > 100.0 ? form_error("voice-master: the signal is not finite (a NaN or an infinity reached the peak meter)") : 1;
   let t5 = vmm-now();
   let g-loud = vmm-undb(vmm-target-lufs() - ld[0]);
   let g-tp = vmm-undb(vmm-target-tp()) / pk[1];
   let gain = vmm-min(g-loud, g-tp);
   let ce = vmm-centroid(ps, B, n, sr);
   let wr = vmm-emit(ps, B, n, gain, 1, sr, out-path);
   let t6 = vmm-now();
   let fr2 = vmm-free([A, B, C]);
   [["chunks", len(plan)], ["samples", n], ["seconds", vmm-r2(n * 1.0 / sr)], ["bytes", wr], ["assemble_ms", t1 - t0], ["tone_ms", t2 - t1], ["compress_ms", t3 - t2], ["room_ms", t4 - t3], ["measure_ms", t5 - t4], ["write_ms", t6 - t5], ["total_ms", t6 - t0], ["room_wet_energy", vmm-r3(en)], ["room_adds_lu", vmm-r3(ld1[0] - ld0[0])], ["pre_lufs", vmm-r3(ld[0])], ["pre_lra", vmm-r3(ld[3])], ["gain_db", vmm-r3(vmm-db(gain))], ["limited_by_peak", g-tp < g-loud ? 1 : 0], ["lufs", vmm-r3(ld[0] + vmm-db(gain))], ["lra", vmm-r3(ld[3])], ["sample_peak_dbfs", vmm-r3(vmm-db(pk[0] * gain))], ["true_peak_dbtp", vmm-r3(vmm-db(pk[1] * gain))], ["centroid_hz", vmm-r2(ce)]];
  }
 }
 0;
}
