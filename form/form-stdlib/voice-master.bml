  // a WAV chunk: [data offset, data bytes, rate, channels, bits, tag], or [] when it is not a RIFF
  def vmm-wav-walk(path, at, size, fmt) {
   let h = (at + 8) > size ? "" : read_file_slice(path, at, 8);
   let id = len(h) < 8 ? "" : substring(h, 0, 4);
   let n = len(h) < 8 ? 0 : vmm-u32(h, 4);
