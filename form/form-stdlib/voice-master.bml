kernel void vmm_fft_load(device const float* x [[buffer(0)]], device float* buf [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& nf [[buffer(3)]], constant uint& stride [[buffer(4)]], constant uint& L [[buffer(5)]], constant uint& hann [[buffer(6)]], uint gid [[thread_position_in_grid]]) {
