//////////////////////////////////////////////////////////////////////
// voice-master.bml — the body masters its own sleep track, on its own metal, with no tool beside it.
//
// A narration made of sentence chunks is not yet a track. This is the stage that makes it one, and it
// replaces the sox + ffmpeg chain the first sleep tracks were mastered with:
//
//   assemble  chunks joined with rests (clause 0.5 s, sentence 1.2 s, paragraph 3.4 s); each chunk takes a
//             30 ms half-sine fade-in and a 60 ms fade-out and is peak-normalised to -20 dBFS (sox `fade h`,
//             `norm -20`); a WAV chunk at another rate is resampled by a Hann-windowed sinc (the ear's own shape)
//   tone      highpass 70 Hz, lowpass 5800 Hz, low shelf +3 dB at 180 Hz, treble shelf -4 dB at 3200 Hz,
//             low shelf +2 dB at 120 Hz — the RBJ biquads sox builds, in float32, in overlapped blocks
//   dynamics  sox `compand 0.08,0.6 6:-70,-60,-25 -6 -90 0.2`: a peak follower on |x| (attack 0.08 s, decay
//             0.6 s), the transfer curve read as sox reads it, a 0.2 s look-ahead delay on the signal.
//             SOX READS "-70,-60,-25" AS THE POINTS (-70,-70), (-60,-25) and the assumed (0,0) — an omitted
//             out-dB defaults to in-dB — so the curve is an UPWARD compressor, not a gentle trim: a -50 dBFS
//             envelope leaves at -26.8, -40 at -22.7, -20 at -14.3, -3 at -7.2 (each includes the -6 makeup).
//             The knee rounds a corner over +-min(6 dB, half the shorter neighbouring segment); the speech
//             levels sit on the straight segment, far from either corner.
//   room      a small warm room: eight damped combs and four allpasses (the Freeverb network sox's reverb
//             is built on) plus a sparse early-reflection tap line, wet level set against the network's own
//             measured impulse-response energy, not against a constant somebody remembered
//   ends      linear fade-in 6 s, linear fade-out 15 s (sox `fade t 6 0 15`)
//   loudness  ITU-R BS.1770 K-weighted, gated integrated loudness, EBU R128 loudness range, sample and
//             4x true peak — measured on the device, applied as one gain to land the target LUFS
//   write     one 16-bit mono WAV, header and samples built on the device, read back once and written once
//
// WHY THE SHAPE IS WHAT IT IS. A track is 46–59 minutes, up to 60 million samples. An interpreted
// per-sample loop is the wrong place for any of it, and so is a one-thread loop over the whole line:
//
//   * A RECURSIVE FILTER IS PARALLEL IF ITS MEMORY IS SHORT. Every IIR here forgets its state: the
//     slowest pole of the tone chain decays by e^-115 in 8192 samples. So each GPU thread owns a block,
//     starts `warm` samples EARLIER with a zero state, and writes only its own block. The seam is
//     below float32 and the band proves it against the same filter run in one piece.
//   * THE FOLLOWER IS THE ONE TRULY SEQUENTIAL THING (a nonlinear one-pole with two time constants).
//     It runs as ONE simdgroup: 32 lanes load 1024 samples coalesced into threadgroup memory, lane 0
//     walks them, 32 lanes store. The gain curve (a log and an exp per sample) is then parallel.
//   * THE ROOM'S memory is its reverberation time, so it takes the same blocked shape with two RT60 of
//     warm-up; each thread keeps its delay lines in its own slice of a scratch buffer.
//   * THE FILE LEAVES IN ONE PIECE. metal_buf_read answers a whole region as one string and write_file
//     writes one string; 120 MB moved in 0.14 s. Nothing is joined, so nothing can be quadratic.
//
// Float32 on the device, doubles in Form: every coefficient, curve table and reference number is
// designed in Form (its own sine and cosine, below) and handed over as float32 bytes. No `using
// namespace metal;` — emitted units qualify with metal::.
//
// Proven by: form/form-stdlib/tests/voice-master-band.fk  ·  run it: observe/voice-master-run.fk
// preflight-exec: forbidden
import form/form-stdlib/core.fk;
import form/form-stdlib/metal-door.fk;
import form/form-stdlib/gpu-lease.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
 class FormVoiceMaster {

  // ================= numbers: the body's own sine, in doubles =================
  def vmm-pi() = 3.141592653589793;
  def vmm-twopi() = 6.283185307179586;
  def vmm-wrap(x) = x - (float_to_int((x / vmm-twopi()) + (x < 0.0 ? (0.0 - 0.5) : 0.5)) * vmm-twopi());
  def vmm-sin-go(r2, term, n, acc) = n > 13 ? acc : vmm-sin-go(r2, (term * (0.0 - r2)) / (((2 * n) + 2) * (((2 * n) + 3) * 1.0)), n + 1, acc + term);
  def vmm-sin(x) {
   let r = vmm-wrap(x);
   vmm-sin-go(r * r, r, 0, 0.0);
  }
  def vmm-cos(x) = vmm-sin(x + (vmm-pi() * 0.5));
  def vmm-tan(x) = vmm-sin(x) / vmm-cos(x);
  def vmm-log10(x) = math_log(x) / math_log(10.0);
  def vmm-db(x) = 20.0 * vmm-log10(x);
  def vmm-undb(d) = math_pow(10.0, d / 20.0);
  def vmm-round(x) = float_to_int(x + 0.5);
  def vmm-ceil-div(a, b) = (a + (b - 1)) / b;
  def vmm-min(a, b) = a < b ? a : b;
  def vmm-max(a, b) = a > b ? a : b;
  def vmm-r3(x) = round_ndigits(x, 3);
  def vmm-r2(x) = round_ndigits(x, 2);
  // list join (`++` joins strings only)
  def vmm-cat(xs, ys) = nil?(xs) ? ys : cons(xs[0], vmm-cat(xs[1:], ys));
  def vmm-flat(xss) = nil?(xss) ? [] : vmm-cat(xss[0], vmm-flat(xss[1:]));
  def vmm-take(xs, k) = k <= 0 ? [] : cons(xs[0], vmm-take(xs[1:], k - 1));

  // ================= biquads: RBJ cookbook, the forms sox's highpass/lowpass/bass/treble use =================
  // a coefficient set is [b0, b1, b2, a1, a2] with a0 divided out
  def vmm-bq-norm(b0, b1, b2, a0, a1, a2) = [b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0];
  def vmm-bq-hp(fs, f, q) {
   let w = vmm-twopi() * f / fs;
   let cw = vmm-cos(w);
   let al = vmm-sin(w) / (2.0 * q);
   vmm-bq-norm((1.0 + cw) / 2.0, 0.0 - (1.0 + cw), (1.0 + cw) / 2.0, 1.0 + al, 0.0 - (2.0 * cw), 1.0 - al);
  }
  def vmm-bq-lp(fs, f, q) {
   let w = vmm-twopi() * f / fs;
   let cw = vmm-cos(w);
   let al = vmm-sin(w) / (2.0 * q);
   vmm-bq-norm((1.0 - cw) / 2.0, 1.0 - cw, (1.0 - cw) / 2.0, 1.0 + al, 0.0 - (2.0 * cw), 1.0 - al);
  }
  // shelf with slope S (sox's default width is 0.5 slope); hi = 0 low shelf, 1 high shelf
  def vmm-bq-shelf(fs, f, gdb, s, hi) {
   let w = vmm-twopi() * f / fs;
   let cw = vmm-cos(w);
   let A = math_pow(10.0, gdb / 40.0);
   let al = vmm-sin(w) / 2.0 * math_sqrt(((A + (1.0 / A)) * ((1.0 / s) - 1.0)) + 2.0);
   let t = 2.0 * math_sqrt(A) * al;
   (Comparable) hi == 0 ? vmm-bq-norm(A * ((A + 1.0) - ((A - 1.0) * cw) + t), 2.0 * A * ((A - 1.0) - ((A + 1.0) * cw)), A * ((A + 1.0) - ((A - 1.0) * cw) - t), (A + 1.0) + ((A - 1.0) * cw) + t, 0.0 - (2.0 * ((A - 1.0) + ((A + 1.0) * cw))), (A + 1.0) + ((A - 1.0) * cw) - t) : vmm-bq-norm(A * ((A + 1.0) + ((A - 1.0) * cw) + t), 0.0 - (2.0 * A * ((A - 1.0) + ((A + 1.0) * cw))), A * ((A + 1.0) + ((A - 1.0) * cw) - t), (A + 1.0) - ((A - 1.0) * cw) + t, 2.0 * ((A - 1.0) - ((A + 1.0) * cw)), (A + 1.0) - ((A - 1.0) * cw) - t);
  }
  // the tone chain, every number sox was given
  def vmm-tone-chain(fs) = [vmm-bq-hp(fs, 70.0, 0.7071067811865476), vmm-bq-lp(fs, 5800.0, 0.7071067811865476), vmm-bq-shelf(fs, 180.0, 3.0, 0.5, 0), vmm-bq-shelf(fs, 3200.0, 0.0 - 4.0, 0.5, 1), vmm-bq-shelf(fs, 120.0, 2.0, 0.5, 0)];
  // BS.1770-4 K-weighting at any rate: the high shelf then the RLB highpass, from the standard's own
  // analogue prototypes (the 48 kHz table is the band's witness)
  def vmm-k-stage1(fs) {
   let K = vmm-tan(vmm-pi() * 1681.974450955533 / fs);
   let Q = 0.7071752369554196;
   let Vh = math_pow(10.0, 3.999843853973347 / 20.0);
   let Vb = math_pow(Vh, 0.4996667741545416);
   let d = 1.0 + (K / Q) + (K * K);
   [(Vh + (Vb * K / Q) + (K * K)) / d, 2.0 * ((K * K) - Vh) / d, (Vh - (Vb * K / Q) + (K * K)) / d, 2.0 * ((K * K) - 1.0) / d, (1.0 - (K / Q) + (K * K)) / d];
  }
  def vmm-k-stage2(fs) {
   let K = vmm-tan(vmm-pi() * 38.13547087602444 / fs);
   let Q = 0.5003270373238773;
   let d = 1.0 + (K / Q) + (K * K);
   [1.0, 0.0 - 2.0, 1.0, 2.0 * ((K * K) - 1.0) / d, (1.0 - (K / Q) + (K * K)) / d];
  }
  def vmm-k-chain(fs) = [vmm-k-stage1(fs), vmm-k-stage2(fs)];
  // analytic response |H(e^jw)| of one stage and of a chain, in dB — the truth the device is held against
  def vmm-bq-db(c, fs, f) {
   let w = vmm-twopi() * f / fs;
   let nr = c[0] + (c[1] * vmm-cos(w)) + (c[2] * vmm-cos(2.0 * w));
   let ni = 0.0 - ((c[1] * vmm-sin(w)) + (c[2] * vmm-sin(2.0 * w)));
   let dr = 1.0 + (c[3] * vmm-cos(w)) + (c[4] * vmm-cos(2.0 * w));
   let di = 0.0 - ((c[3] * vmm-sin(w)) + (c[4] * vmm-sin(2.0 * w)));
   10.0 * vmm-log10(((nr * nr) + (ni * ni)) / ((dr * dr) + (di * di)));
  }
  def vmm-chain-db(cs, fs, f) = nil?(cs) ? 0.0 : (vmm-bq-db(cs[0], fs, f) + vmm-chain-db(cs[1:], fs, f));
  // the same biquad in doubles, direct form II transposed — the reference a float32 pass is held to
  def vmm-ref-stage(c, xs, z1, z2, acc) {
   let x = xs[0];
   let o = (c[0] * x) + z1;
   nil?(xs[1:]) ? reverse(cons(o, acc)) : vmm-ref-stage(c, xs[1:], (c[1] * x) - (c[3] * o) + z2, (c[2] * x) - (c[4] * o), cons(o, acc));
  }
  def vmm-ref-chain(cs, xs) = nil?(cs) ? xs : vmm-ref-chain(cs[1:], vmm-ref-stage(cs[0], xs, 0.0, 0.0, []));

  // ================= the compressor's transfer curve, as sox reads it =================
  // points are [in_dB, out_dB]; an omitted out defaults to in; the point 0,0 is assumed. Below the first
  // point the line has slope 1. Corners are rounded by a quadratic over +-radius dB (radius capped at half
  // the shorter neighbouring segment). A piece is [x_start, y_start, a, b]: y = ys + t*(b + a*t), t = x - xs.
  def vmm-knee-width() = 6.0;
  def vmm-slope(p, q) = (q[1] - p[1]) / (q[0] - p[0]);
  def vmm-knee-r(pts, k, knee) {
   let right = (pts[k + 1][0] - pts[k][0]) / 2.0;
   let left = (Comparable) k == 0 ? knee : ((pts[k][0] - pts[k - 1][0]) / 2.0);
   vmm-min(knee, vmm-min(left, right));
  }
  def vmm-pieces-go(pts, k, mprev, acc) {
   let m = vmm-slope(pts[k], pts[k + 1]);
   let r = vmm-knee-r(pts, k, vmm-knee-width());
   let x = pts[k][0];
   let y = pts[k][1];
   let acc2 = r > 0.0 ? cons([x + r, y + (m * r), 0.0, m], cons([x - r, y - (mprev * r), (m - mprev) / (4.0 * r), mprev], acc)) : cons([x, y, 0.0, m], acc);
   (k + 2) >= len(pts) ? reverse(acc2) : vmm-pieces-go(pts, k + 1, m, acc2);
  }
  def vmm-with-origin(pts) = pts[len(pts) - 1][0] < 0.0 ? vmm-cat(pts, [[0.0, 0.0]]) : pts;
  def vmm-pieces(pts0) {
   let pts = vmm-with-origin(pts0);
   cons([0.0 - 400.0, 0.0 - 400.0, 0.0, 1.0], vmm-pieces-go(pts, 0, 1.0, []));
  }
  def vmm-curve-go(ps, L, best) = nil?(ps) ? best : vmm-curve-go(ps[1:], L, L >= ps[0][0] ? ps[0] : best);
  def vmm-curve(ps, L) {
   let p = vmm-curve-go(ps[1:], L, ps[0]);
   let t = L - p[0];
   p[1] + (t * (p[3] + (p[2] * t)));
  }
  // THE COMPRESSION PROFILE is a named choice, because the first one was a reading and not a decision.
  //   lift    what sox was given: compand 0.08,0.6 6:-70,-60,-25 -6 -90 0.2. Read as sox reads it (an omitted last
  //           point is (0,0)), the table is an UPWARD compressor: a passage at -50 dBFS leaves at about -27, one at -20
  //           at about -14 (each with the -6 dB makeup), so quiet speech, breaths and the room's tail are raised toward
  //           the loud. It is what the delivered tracks carry: loudness range 3.3-3.7 LU, level jumps 5-6 dB.
  //   gentle  an ordinary downward compressor: identity below -35 dBFS, 2:1 above (0 dBFS leaves at -17.5), so the
  //           loud end is held down and the quiet end is left alone.
  // Measured on the English track (2026-10-04): the same -30 LUFS and the same 6.45 dB level jumps, peaks 1.8 dB lower
  // under `gentle` (-13.3 against -11.6 dBFS) and loudness range 0.3 LU wider (3.9 against 3.6). The numbers do not
  // decide between them, so the word decides: the brief was a gentle track, and `gentle` is the default. `lift` stays
  // for anyone who wants the quiet end raised; the door takes the profile as the third word of its target
  // (`master en lift`).
  def vmm-comp-points-of(profile) = (String) profile == "gentle" ? [[0.0 - 70.0, 0.0 - 70.0], [0.0 - 35.0, 0.0 - 35.0], [0.0, 0.0 - 17.5]] : [[0.0 - 70.0, 0.0 - 70.0], [0.0 - 60.0, 0.0 - 25.0]];
  def vmm-comp-points() = vmm-comp-points-of("lift");
  def vmm-comp-makeup() = 0.0 - 6.0;
  def vmm-comp-attack() = 0.08;
  def vmm-comp-decay() = 0.6;
  def vmm-comp-initial-db() = 0.0 - 90.0;
  def vmm-comp-delay() = 0.2;

  // ================= bytes: float32 and u32 in, float32 out =================
  def vmm-f32-chunks(xs, acc) = nil?(xs) ? acc : vmm-f32-chunks(xs[1:], cons(md-le32(md-f32-bits(xs[0])), acc));
  def vmm-f32s(xs) = nil?(xs) ? "" : str-join-reversed(vmm-f32-chunks(xs, []));
  def vmm-u32-chunks(xs, acc) = nil?(xs) ? acc : vmm-u32-chunks(xs[1:], cons(md-le32(xs[0]), acc));
  def vmm-u32s(xs) = nil?(xs) ? "" : str-join-reversed(vmm-u32-chunks(xs, []));
  def vmm-cf(x) = md-f32-bits(x);
  def vmm-f32-at(s, o) {
   let b0 = str_byte_at(s, o);
   let b1 = str_byte_at(s, o + 1);
   let b2 = str_byte_at(s, o + 2);
   let b3 = str_byte_at(s, o + 3);
   let e = ((b3 % 128) * 2) + (b2 / 128);
   let m = ((b2 % 128) * 65536) + (b1 * 256) + b0;
   let v = (Comparable) e == 0 ? 0.0 : ((1.0 + ((m * 1.0) / 8388608.0)) * math_pow(2.0, (e - 127) * 1.0));
   b3 >= 128 ? (0.0 - v) : v;
  }
  def vmm-f32-go(s, i, n, acc) = i >= n ? reverse(acc) : vmm-f32-go(s, i + 1, n, cons(vmm-f32-at(s, i * 4), acc));
  def vmm-u16(s, o) = str_byte_at(s, o) + (str_byte_at(s, o + 1) * 256);
  def vmm-u32(s, o) = vmm-u16(s, o) + (vmm-u16(s, o + 2) * 65536);
  // the 44-byte RIFF/WAVE header of a mono 16-bit PCM file of n frames
  def vmm-wav-header(sr, n) {
   let data = n * 2;
   "RIFF" ++ md-le32(36 + data) ++ "WAVEfmt " ++ md-le32(16) ++ md-le16(1) ++ md-le16(1) ++ md-le32(sr) ++ md-le32(sr * 2) ++ md-le16(2) ++ md-le16(16) ++ "data" ++ md-le32(data);
  }

  // ================= the metal: every kernel qualifies with metal:: =================
  def vmm-msl-head() = "#include <metal_stdlib>
inline float vmm_s16(device const uchar* p, ulong i) { ushort w = (ushort)(p[2 * i] | (p[2 * i + 1] << 8)); return (float)as_type<short>(w) / 32768.0f; }
inline uint vmm_hash(uint v) { uint s = v * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
inline float vmm_fadeh(uint i, uint n, uint fin, uint fout) {
  float w = 1.0f;
  if (i < fin) w *= 0.5f - 0.5f * metal::cos(3.14159265358979f * (float)i / (float)fin);
  uint r = n - 1u - i;
  if (r < fout) w *= 0.5f - 0.5f * metal::cos(3.14159265358979f * (float)r / (float)fout);
  return w; }
inline float vmm_rs(device const uchar* p, uint ns, uint j, uint num, uint den) {
  if (num == den) return vmm_s16(p, j);
  ulong ph = (ulong)j * num; long c = (long)(ph / den); float fr = (float)(ph % den) / (float)den;
  float cut = metal::min(1.0f, (float)den / (float)num); int rad = (int)metal::ceil(16.0f / cut); float acc = 0.0f; float wsum = 0.0f;
  for (int k = -rad + 1; k <= rad; k++) {
    float x = (float)k - fr; float u = x * cut;
    float s = metal::fabs(u) < 1e-6f ? 1.0f : metal::sin(3.14159265358979f * u) / (3.14159265358979f * u);
    float w = 0.5f + 0.5f * metal::cos(3.14159265358979f * x / (float)rad); float h = cut * s * w;
    long idx = c + k; if (idx >= 0 && idx < (long)ns) acc += h * vmm_s16(p, (ulong)idx); wsum += h; }
  return acc / wsum; }
";
  // fills and probes
  def vmm-msl-gen() = "kernel void vmm_zero(device float* y [[buffer(0)]], constant uint& n [[buffer(1)]], uint gid [[thread_position_in_grid]]) { if (gid >= n) return; y[gid] = 0.0f; }
kernel void vmm_fill(device float* y [[buffer(0)]], constant uint& off [[buffer(1)]], constant uint& n [[buffer(2)]], constant float& v [[buffer(3)]], uint gid [[thread_position_in_grid]]) { if (gid >= n) return; y[off + gid] = v; }
kernel void vmm_sine(device float* y [[buffer(0)]], constant uint& off [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& f [[buffer(3)]], constant uint& sr [[buffer(4)]], constant float& amp [[buffer(5)]], uint gid [[thread_position_in_grid]]) {
  if (gid >= n) return; ulong ph = ((ulong)gid * f) % sr; y[off + gid] = amp * metal::sin(6.28318530717959f * (float)ph / (float)sr); }
kernel void vmm_noise(device float* y [[buffer(0)]], constant uint& off [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& seed [[buffer(3)]], constant float& amp [[buffer(4)]], uint gid [[thread_position_in_grid]]) {
  if (gid >= n) return; uint h = vmm_hash(gid + seed * 2654435761u); y[off + gid] = amp * ((float)(h >> 8) * (1.0f / 8388608.0f) - 1.0f); }
kernel void vmm_stats(device const float* x [[buffer(0)]], device float* out [[buffer(1)]], constant uint& from [[buffer(2)]], constant uint& cnt [[buffer(3)]], uint lane [[thread_index_in_simdgroup]]) {
  float ss = 0.0f; float mx = 0.0f; float sm = 0.0f;
  for (uint i = lane; i < cnt; i += 32u) { float v = x[from + i]; ss += v * v; sm += v; mx = metal::max(mx, metal::fabs(v)); }
  ss = metal::simd_sum(ss); sm = metal::simd_sum(sm); mx = metal::simd_max(mx);
  if (lane == 0u) { out[0] = ss / (float)cnt; out[1] = mx; out[2] = sm / (float)cnt; } }
";
  // assembly: a chunk's peak after its fades, and the chunk placed at its offset, normalised
  def vmm-msl-asm() = "kernel void vmm_peak(device const uchar* src [[buffer(0)]], device float* pk [[buffer(1)]], constant uint& ns [[buffer(2)]], constant uint& n [[buffer(3)]], constant uint& k [[buffer(4)]], constant uint& fin [[buffer(5)]], constant uint& fout [[buffer(6)]], constant uint& num [[buffer(7)]], constant uint& den [[buffer(8)]], uint lane [[thread_index_in_simdgroup]]) {
  float m = 0.0f;
  for (uint i = lane; i < n; i += 32u) { float v = metal::fabs(vmm_rs(src, ns, i, num, den)) * vmm_fadeh(i, n, fin, fout); m = metal::max(m, v); }
  m = metal::simd_max(m); if (lane == 0u) pk[k] = m; }
kernel void vmm_place(device const uchar* src [[buffer(0)]], device float* dst [[buffer(1)]], device const float* pk [[buffer(2)]], constant uint& ns [[buffer(3)]], constant uint& n [[buffer(4)]], constant uint& k [[buffer(5)]], constant uint& off [[buffer(6)]], constant uint& fin [[buffer(7)]], constant uint& fout [[buffer(8)]], constant uint& num [[buffer(9)]], constant uint& den [[buffer(10)]], constant float& target [[buffer(11)]], uint gid [[thread_position_in_grid]]) {
  if (gid >= n) return; float p = pk[k]; float g = p > 0.0f ? target / p : 0.0f;
  dst[off + gid] = vmm_rs(src, ns, gid, num, den) * vmm_fadeh(gid, n, fin, fout) * g; }
";
  // the tone chain: overlapped blocks, direct form II transposed, up to eight stages
  def vmm-msl-iir() = "kernel void vmm_iir(device const float* x [[buffer(0)]], device float* y [[buffer(1)]], device const float* c [[buffer(2)]], constant uint& n [[buffer(3)]], constant uint& ns [[buffer(4)]], constant uint& blk [[buffer(5)]], constant uint& warm [[buffer(6)]], uint t [[thread_position_in_grid]]) {
  ulong b0 = (ulong)t * blk; if (b0 >= n) return; ulong end = metal::min((ulong)n, b0 + blk); ulong s = b0 > warm ? b0 - warm : 0ul;
