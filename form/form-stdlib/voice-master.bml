  def vmm-pi-zero() = 0;
  def vmm-pi-fill() = 1;
  def vmm-pi-sine() = 2;
  def vmm-pi-noise() = 3;
  def vmm-pi-stats() = 4;
  def vmm-pi-peak() = 5;
  def vmm-pi-place() = 6;
  def vmm-pi-iir() = 7;
  def vmm-pi-env() = 8;
  def vmm-pi-comp() = 9;
  def vmm-pi-room() = 10;
  def vmm-pi-ramp() = 11;
  def vmm-pi-hop() = 12;
  def vmm-pi-gate() = 13;
  def vmm-pi-peaks() = 14;
  def vmm-pi-fftload() = 15;
  def vmm-pi-fftstage() = 16;
