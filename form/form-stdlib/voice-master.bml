  def vmm-msl-room() = "kernel void vmm_room(device const float* x [[buffer(0)]], device float* y [[buffer(1)]], device float* sc [[buffer(2)]], device const uint* geo [[buffer(3)]], device const float* gp [[buffer(4)]], constant uint& n [[buffer(5)]], constant uint& blk [[buffer(6)]], constant uint& warm [[buffer(7)]], constant uint& S [[buffer(8)]], constant float& dry [[buffer(9)]], uint t [[thread_position_in_grid]]) {
  ulong b0 = (ulong)t * blk; if (b0 >= n) return; ulong end = metal::min((ulong)n, b0 + blk); ulong s = b0 > warm ? b0 - warm : 0ul;
