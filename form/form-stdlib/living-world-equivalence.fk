; living-world-equivalence.fk -- exact return is evidence, not synonymy.
;
; Two active recursive mappings may propose a structural equivalence only
; when their source and target skeletons face one another and every admitted
; supporting correspondence returns exactly to its origin through the other
; mapping.  The witness is symmetric: both directions must contribute at
; least the offered threshold and any failed bridge or return blocks the
; proposal.  Success and failure cells retain the concrete correspondence,
; both observed transformations, their attributions, uncertainties, and the
; local Form path.  No endpoint name, semantic class, or imported vocabulary
; is installed.
;
; Equivalence is a governed candidate, not authority.  All current holders of
; both mappings participate.  Integration re-observes the complete round-trip
; evidence; changed evidence, revocation, or a reopened mapping refuses the
; old proposal without deleting it.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk

(let LWEQ-DIRECTION (bp "LWEQ-DIRECTION"))
(let LWEQ-RETURN    (bp "LWEQ-RETURN"))
(let LWEQ-EVIDENCE  (bp "LWEQ-EVIDENCE"))
(let LWEQ-SHAPE     (bp "LWEQ-SHAPE"))
(let LWEQ-ORIGIN    (bp "LWEQ-ORIGIN"))

(defn lweq-direction (first-candidate second-candidate)
    (intern_node LWEQ-DIRECTION (list first-candidate second-candidate)))

; children: direction, supporting evidence, source, expected bridge,
;           observed bridge, observed return, ack, uncertainty pair,
;           attribution field, local path
(defn lweq-return
    (direction evidence source expected bridge returned ack uncertainties)
    (intern_node LWEQ-RETURN
        (list direction evidence source expected bridge returned ack
              uncertainties (lwrr-evidence-attributions evidence)
              (lwo-local-path))))
(defn lweq-return? (cell) (lwo-category? cell LWEQ-RETURN))
(defn lweq-return-direction (result) (nth (node_children result) 0))
(defn lweq-return-evidence (result) (nth (node_children result) 1))
(defn lweq-return-source (result) (nth (node_children result) 2))
(defn lweq-return-expected-bridge (result) (nth (node_children result) 3))
(defn lweq-return-observed-bridge (result) (nth (node_children result) 4))
(defn lweq-return-observed-return (result) (nth (node_children result) 5))
(defn lweq-return-ack (result) (nth (node_children result) 6))
(defn lweq-return-uncertainties (result) (nth (node_children result) 7))
(defn lweq-return-attributions (result) (nth (node_children result) 8))
(defn lweq-return-path (result) (nth (node_children result) 9))

(defn lweq-mapping-signature (candidate)
    (lwrr-mapping-signature (lwo-emergent-shape candidate)))
(defn lweq-mapping-uncertainty (candidate)
    (lwrr-mapping-uncertainty (lwo-emergent-shape candidate)))

(defn lweq-inverse-domains? (world first-candidate second-candidate)
    (if (and (not (node_eq first-candidate second-candidate))
             (and (eq (lwrl-steady? world first-candidate) 1)
                  (eq (lwrl-steady? world second-candidate) 1)))
        (do
            (let first (lweq-mapping-signature first-candidate))
            (let second (lweq-mapping-signature second-candidate))
            (if (and
                    (node_eq (lwrr-signature-source-skeleton first)
                             (lwrr-signature-target-skeleton second))
                    (node_eq (lwrr-signature-target-skeleton first)
                             (lwrr-signature-source-skeleton second))) 1 0))
        0))

(defn lweq-return-for (first-candidate second-candidate evidence)
    (do
        (let correspondence (lwrr-evidence-correspondence evidence))
        (let source (lwr-correspondence-source correspondence))
        (let expected (lwr-correspondence-target correspondence))
        (let first-signature (lweq-mapping-signature first-candidate))
        (let second-signature (lweq-mapping-signature second-candidate))
        (let bridge (lwrr-apply-signature first-signature source))
        (let returned
            (if (node_eq bridge (lwo-none)) (lwo-none)
                (lwrr-apply-signature second-signature bridge)))
        (let exact
            (if (and (node_eq bridge expected)
                     (node_eq returned source)) 1 0))
        (lweq-return
            (lweq-direction first-candidate second-candidate)
            evidence source expected bridge returned
            (if (eq exact 1) (oac-one returned) (oac-zero))
            (lwo-field
                (list (lweq-mapping-uncertainty first-candidate)
                      (lweq-mapping-uncertainty second-candidate))))))

(defn lweq-returns-items (first second items acc)
    (if (eq (len items) 0) acc
        (lweq-returns-items first second (tail items)
            (lwo-field-add acc
                (lweq-return-for first second (head items))))))

(defn lweq-direction-returns (first second)
    (lweq-returns-items first second
        (lwo-field-items
            (lwrr-mapping-supports (lwo-emergent-shape first)))
        (lwo-empty-field)))

(defn lweq-return-success? (result)
    (if (eq (oac-one? (lweq-return-ack result)) 1) 1 0))

(defn lweq-all-success? (items)
    (if (eq (len items) 0) 1
        (if (eq (lweq-return-success? (head items)) 1)
            (lweq-all-success? (tail items)) 0)))

(defn lweq-failures-items (items acc)
    (if (eq (len items) 0) acc
        (lweq-failures-items (tail items)
            (if (eq (lweq-return-success? (head items)) 1) acc
                (lwo-field-add acc (head items))))))

; children: first-direction returns, second-direction returns, failures
(defn lweq-evidence (first-returns second-returns)
    (intern_node LWEQ-EVIDENCE
        (list first-returns second-returns
              (lweq-failures-items
                  (lwo-field-items second-returns)
                  (lweq-failures-items
                      (lwo-field-items first-returns)
                      (lwo-empty-field))))))
(defn lweq-evidence-first-returns (evidence)
    (nth (node_children evidence) 0))
(defn lweq-evidence-second-returns (evidence)
    (nth (node_children evidence) 1))
(defn lweq-evidence-failures (evidence)
    (nth (node_children evidence) 2))

(defn lweq-evidence-for (first second)
    (lweq-evidence
        (lweq-direction-returns first second)
        (lweq-direction-returns second first)))

(defn lweq-evidence-ready? (evidence threshold)
    (if (and
            (ge (lwo-field-size (lweq-evidence-first-returns evidence))
                threshold)
            (and
                (ge (lwo-field-size (lweq-evidence-second-returns evidence))
                    threshold)
                (eq (lwo-field-size
                        (lweq-evidence-failures evidence)) 0))) 1 0))

(defn lweq-return-witnesses-items (items acc)
    (if (eq (len items) 0) acc
        (lweq-return-witnesses-items (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lweq-return-attributions (head items))) acc))))

(defn lweq-witnesses (world first second evidence)
    (do
        (let mapping-witnesses
            (lwr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world second))
                (lwo-active-attributions-for world first)))
        (let first-witnesses
            (lweq-return-witnesses-items
                (lwo-field-items
                    (lweq-evidence-first-returns evidence))
                mapping-witnesses))
        (lweq-return-witnesses-items
            (lwo-field-items
                (lweq-evidence-second-returns evidence))
            first-witnesses)))

; children: candidate pair, inverse endpoint skeletons, complete round-trip
;           evidence, uncertainty pair, local path
(defn lweq-shape (first second evidence threshold)
    (do
        (let first-signature (lweq-mapping-signature first))
        (intern_node LWEQ-SHAPE
            (list first second
                  (lwrr-signature-source-skeleton first-signature)
                  (lwrr-signature-target-skeleton first-signature)
                  evidence
                  (lwo-field
                    (list (lweq-mapping-uncertainty first)
                          (lweq-mapping-uncertainty second)))
                  (lwo-local-path)
                  (intern_trivial_int threshold)))))
(defn lweq-shape? (cell) (lwo-category? cell LWEQ-SHAPE))
(defn lweq-shape-first (shape) (nth (node_children shape) 0))
(defn lweq-shape-second (shape) (nth (node_children shape) 1))
(defn lweq-shape-source-skeleton (shape) (nth (node_children shape) 2))
(defn lweq-shape-target-skeleton (shape) (nth (node_children shape) 3))
(defn lweq-shape-evidence (shape) (nth (node_children shape) 4))
(defn lweq-shape-uncertainties (shape) (nth (node_children shape) 5))
(defn lweq-shape-path (shape) (nth (node_children shape) 6))
(defn lweq-shape-threshold (shape)
    (node_value (nth (node_children shape) 7)))

(defn lweq-origin (shape witnesses threshold)
    (intern_node LWEQ-ORIGIN
        (list shape witnesses (intern_trivial_int threshold))))

(defn lweq-proposal (world first second threshold)
    (if (eq (lweq-inverse-domains? world first second) 0) (lwo-none)
        (do
            (let evidence (lweq-evidence-for first second))
            (if (eq (lweq-evidence-ready? evidence threshold) 0)
                (lwo-none)
                (do
                    (let witnesses
                        (lweq-witnesses world first second evidence))
                    (let shape (lweq-shape first second evidence threshold))
                    (let origin (lweq-origin shape witnesses threshold))
                    (let candidate
                        (lwo-emergent shape witnesses
                            (intern_trivial_int
                                (add
                                    (lwo-field-size
                                        (lweq-evidence-first-returns evidence))
                                    (lwo-field-size
                                        (lweq-evidence-second-returns evidence))))
                            (intern_trivial_int 2)
                            (intern_trivial_int
                                (lwo-field-size witnesses)) origin))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items witnesses) (lwo-empty-field))
                        origin))))))

(defn lweq-proposals-with-first (world first seconds threshold acc)
    (if (eq (len seconds) 0) acc
        (do
            (let proposal
                (lweq-proposal world first (head seconds) threshold))
            (lweq-proposals-with-first world first (tail seconds) threshold
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

; Pair each candidate only with the tail.  Symmetry belongs inside one
; evidence cell rather than appearing as two differently ordered proposals.
(defn lweq-proposals-items (world firsts threshold acc)
    (if (eq (len firsts) 0) acc
        (lweq-proposals-items world (tail firsts) threshold
            (lweq-proposals-with-first
                world (head firsts) (tail firsts) threshold acc))))

(defn lweq-proposals (world threshold)
    (lweq-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lweq-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lweq-shape? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lweq-current? (world candidate)
    (if (eq (lweq-candidate? candidate) 0) 0
        (do
            (let shape (lwo-emergent-shape candidate))
            (let fresh
                (lweq-proposal world
                    (lweq-shape-first shape)
                    (lweq-shape-second shape)
                    (lweq-shape-threshold shape)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))

(defn lweq-steady? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lweq-current? world candidate) 1)) 1 0))

(defn lweq-integrate (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lweq-current? (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
