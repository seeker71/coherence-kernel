; living-world-relation-hypothesis.fk -- corrections may offer, never grant, relations.
;
; A ZERO composition outcome can be named by a separate hypothesis offer. The
; offer carries an optional relation, optional lens, alternatives, unknown, and
; evidence. It derives adjacent pairs present in the observed sequence but not
; the current primary sequence, while retaining displaced primary pairs.
;
; The resulting hypothesis crosses its own ordinary unanimous admission
; boundary. It is still not a relation observation or edge. Independent sources
; may later offer attestations. An attestation can be rendered as an ordinary
; LWRL observation only with the same source attribution on both cells and only
; when that source did not author the correction. Ordinary relation recurrence,
; threshold, tending, and integration remain a second, untouched authority
; boundary.
;
; Once independently re-observed and admitted, an edge stands on those new
; observations rather than borrowing correction authority. Revoking a bridge
; offer or correction stales the hypothesis before that second boundary.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk

(let LWRH-OFFER          (bp "LWRH-OFFER"))
(let LWRH-OFFER-EVIDENCE (bp "LWRH-OFFER-EVIDENCE"))
(let LWRH-PAIR           (bp "LWRH-PAIR"))
(let LWRH-HYPOTHESIS     (bp "LWRH-HYPOTHESIS"))
(let LWRH-ATTESTATION    (bp "LWRH-ATTESTATION"))
(let LWRH-ORIGIN         (bp "LWRH-ORIGIN"))

; children: left, right, local path
(defn lwrh-pair (left right)
    (intern_node LWRH-PAIR (list left right (lwo-local-path))))
(defn lwrh-pair? (cell) (lwo-category? cell LWRH-PAIR))
(defn lwrh-pair-left (pair) (nth (node_children pair) 0))
(defn lwrh-pair-right (pair) (nth (node_children pair) 1))
(defn lwrh-pair-path (pair) (nth (node_children pair) 2))

(defn lwrh-adjacent-pairs (items field)
    (if (or (eq (len items) 0)
            (eq (len (tail items)) 0)) field
        (lwrh-adjacent-pairs (tail items)
            (lwo-field-add field
                (lwrh-pair (head items) (head (tail items)))))))
(defn lwrh-sequence-pairs (sequence)
    (lwrh-adjacent-pairs
        (lwrp-sequence-items sequence) (lwo-empty-field)))
(defn lwrh-field-difference-items (items excluded result)
    (if (eq (len items) 0) result
        (lwrh-field-difference-items (tail items) excluded
            (if (eq (lwo-field-has? excluded (head items)) 1) result
                (lwo-field-add result (head items))))))
(defn lwrh-field-difference (source excluded)
    (lwrh-field-difference-items (lwo-field-items source) excluded
        (lwo-empty-field)))

; children: correction observation, optional relation, optional lens,
;           alternatives, optional unknown, evidence, local path
(defn lwrh-offer
    (correction relation lens alternatives unknown evidence)
    (intern_node LWRH-OFFER
        (list correction relation lens alternatives unknown evidence
              (lwo-local-path))))
(defn lwrh-offer? (cell) (lwo-category? cell LWRH-OFFER))
(defn lwrh-offer-correction (offer) (nth (node_children offer) 0))
(defn lwrh-offer-relation (offer) (nth (node_children offer) 1))
(defn lwrh-offer-lens (offer) (nth (node_children offer) 2))
(defn lwrh-offer-alternatives (offer) (nth (node_children offer) 3))
(defn lwrh-offer-unknown (offer) (nth (node_children offer) 4))
(defn lwrh-offer-offered-evidence (offer) (nth (node_children offer) 5))
(defn lwrh-offer-path (offer) (nth (node_children offer) 6))

(defn lwrh-optional-lens-valid? (lens)
    (if (or (node_eq lens (lwo-none))
            (eq (lwlc-lens? lens) 1)) 1 0))
(defn lwrh-relation-lens-coherent? (offer)
    (do
        (let relation (lwrh-offer-relation offer))
        (let lens (lwrh-offer-lens offer))
        (if (node_eq lens (lwo-none)) 1
            (if (node_eq relation (lwo-none)) 0
                (if (node_eq relation
                        (lwlc-lens-payload lens)) 1 0)))))
(defn lwrh-offer-valid? (offer)
    (if (and (eq (lwrh-offer? offer) 1)
             (and (eq (lwco-observation-valid?
                         (lwrh-offer-correction offer)) 1)
                  (and (eq (oac-zero?
                             (lwco-observation-ack
                               (lwrh-offer-correction offer))) 1)
                       (and (eq (lwrh-optional-lens-valid?
                                 (lwrh-offer-lens offer)) 1)
                            (and (eq (lwo-category?
                                      (lwrh-offer-alternatives offer)
                                      LWO-FIELD) 1)
                                 (and (eq (lwco-optional-unknown-valid?
                                           (lwrh-offer-unknown offer)) 1)
                                      (eq (lwrh-relation-lens-coherent?
                                           offer) 1))))))) 1 0))

(defn lwrh-offer-for? (offer correction relation)
    (if (and (eq (lwrh-offer-valid? offer) 1)
             (and (node_eq (lwrh-offer-correction offer) correction)
                  (node_eq (lwrh-offer-relation offer) relation))) 1 0))

(defn lwrh-offer-evidence (offer attributions)
    (intern_node LWRH-OFFER-EVIDENCE (list offer attributions)))
(defn lwrh-offer-evidence-offer (evidence) (nth (node_children evidence) 0))
(defn lwrh-offer-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwrh-collect-offers (world items correction relation field)
    (if (eq (len items) 0) field
        (do
            (let offer (head items))
            (if (and (eq (lwrh-offer-for?
                              offer correction relation) 1)
                     (eq (lwo-active? world offer) 1))
                (lwrh-collect-offers world (tail items) correction relation
                    (lwo-field-add field
                        (lwrh-offer-evidence offer
                            (lwo-active-attributions-for world offer))))
                (lwrh-collect-offers world (tail items) correction relation
                    field)))))
(defn lwrh-offer-evidence-for (world correction relation)
    (lwrh-collect-offers world
        (lwo-field-items (lwo-world-cells world)) correction relation
        (lwo-empty-field)))

(defn lwrh-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwrh-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwrh-offer-witnesses-items (items witnesses)
    (if (eq (len items) 0) witnesses
        (lwrh-offer-witnesses-items (tail items)
            (lwrh-field-union-items
                (lwo-field-items
                    (lwrh-offer-evidence-attributions (head items)))
                witnesses))))
(defn lwrh-witnesses (world correction offer-evidence)
    (lwrh-offer-witnesses-items (lwo-field-items offer-evidence)
        (lwo-active-attributions-for world correction)))

; children: correction, optional relation, optional lens, proposed pairs,
;           displaced primary pairs, offer evidence, alternatives,
;           optional unknown, witnesses, local path
(defn lwrh-hypothesis-cell
    (correction relation lens proposed displaced offer-evidence alternatives
     unknown witnesses)
    (intern_node LWRH-HYPOTHESIS
        (list correction relation lens proposed displaced offer-evidence
              alternatives unknown witnesses (lwo-local-path))))
(defn lwrh-hypothesis? (cell) (lwo-category? cell LWRH-HYPOTHESIS))
(defn lwrh-hypothesis-correction (hypothesis) (nth (node_children hypothesis) 0))
(defn lwrh-hypothesis-relation (hypothesis) (nth (node_children hypothesis) 1))
(defn lwrh-hypothesis-lens (hypothesis) (nth (node_children hypothesis) 2))
(defn lwrh-hypothesis-proposed-pairs (hypothesis)
    (nth (node_children hypothesis) 3))
(defn lwrh-hypothesis-displaced-pairs (hypothesis)
    (nth (node_children hypothesis) 4))
(defn lwrh-hypothesis-offer-evidence (hypothesis)
    (nth (node_children hypothesis) 5))
(defn lwrh-hypothesis-alternatives (hypothesis)
    (nth (node_children hypothesis) 6))
(defn lwrh-hypothesis-unknown (hypothesis) (nth (node_children hypothesis) 7))
(defn lwrh-hypothesis-witnesses (hypothesis) (nth (node_children hypothesis) 8))
(defn lwrh-hypothesis-path (hypothesis) (nth (node_children hypothesis) 9))

(defn lwrh-hypothesis-for (world offer)
    (if (or (eq (lwrh-offer-valid? offer) 0)
            (or (eq (lwo-active? world offer) 0)
                (eq (lwo-active? world
                      (lwrh-offer-correction offer)) 0)))
        (lwo-none)
        (do
            (let correction (lwrh-offer-correction offer))
            (let relation (lwrh-offer-relation offer))
            (let bundle (lwco-observation-bundle correction))
            (if (eq (lwmp-bundle-current? world bundle) 0) (lwo-none)
                (do
                    (let primary-pairs
                        (lwrh-sequence-pairs
                            (lwmp-bundle-primary-sequence bundle)))
                    (let observed-pairs
                        (lwrh-sequence-pairs
                            (lwco-observation-observed correction)))
                    (let proposed
                        (lwrh-field-difference observed-pairs primary-pairs))
                    (let displaced
                        (lwrh-field-difference primary-pairs observed-pairs))
                    (let offer-evidence
                        (lwrh-offer-evidence-for
                            world correction relation))
                    (let witnesses
                        (lwrh-witnesses world correction offer-evidence))
                    (if (or (eq (lwo-field-size proposed) 0)
                            (eq (lwo-field-size offer-evidence) 0))
                        (lwo-none)
                        (lwrh-hypothesis-cell correction relation
                            (lwrh-offer-lens offer) proposed displaced
                            offer-evidence (lwrh-offer-alternatives offer)
                            (lwrh-offer-unknown offer) witnesses)))))))

(defn lwrh-origin (hypothesis)
    (intern_node LWRH-ORIGIN (list hypothesis (lwo-local-path))))
(defn lwrh-proposal-for (world offer)
    (do
        (let hypothesis (lwrh-hypothesis-for world offer))
        (if (node_eq hypothesis (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwrh-hypothesis-witnesses hypothesis))
                (let count (lwo-field-size witnesses))
                (let origin (lwrh-origin hypothesis))
                (let candidate
                    (lwo-emergent hypothesis witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwrh-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrh-hypothesis?
                   (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrh-candidate-current? (world candidate)
    (if (eq (lwrh-candidate? candidate) 0) 0
        (do
            (let hypothesis (lwo-emergent-shape candidate))
            (let offer-evidence (lwrh-hypothesis-offer-evidence hypothesis))
            (let offer
                (lwrh-offer-evidence-offer
                    (head (lwo-field-items offer-evidence))))
            (let current (lwrh-hypothesis-for world offer))
            (if (and (node_eq hypothesis current)
                     (node_eq (lwo-emergent-witnesses candidate)
                              (lwrh-hypothesis-witnesses current))) 1 0))))
(defn lwrh-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrh-candidate-current? world candidate) 1)) 1 0))
(defn lwrh-integrate (round proposal action)
    (if (eq (lwrh-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; children: integrated hypothesis candidate, exact proposed pair, ack,
;           alternatives, optional unknown, evidence, local path
(defn lwrh-attestation
    (hypothesis-candidate pair ack alternatives unknown evidence)
    (intern_node LWRH-ATTESTATION
        (list hypothesis-candidate pair ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwrh-attestation? (cell) (lwo-category? cell LWRH-ATTESTATION))
(defn lwrh-attestation-hypothesis (attestation)
    (nth (node_children attestation) 0))
(defn lwrh-attestation-pair (attestation) (nth (node_children attestation) 1))
(defn lwrh-attestation-ack (attestation) (nth (node_children attestation) 2))
(defn lwrh-attestation-alternatives (attestation)
    (nth (node_children attestation) 3))
(defn lwrh-attestation-unknown (attestation) (nth (node_children attestation) 4))
(defn lwrh-attestation-evidence (attestation) (nth (node_children attestation) 5))
(defn lwrh-attestation-path (attestation) (nth (node_children attestation) 6))

(defn lwrh-attestation-valid-shape? (attestation)
    (if (and (eq (lwrh-attestation? attestation) 1)
             (and (eq (lwrh-candidate?
                         (lwrh-attestation-hypothesis attestation)) 1)
                  (and (eq (lwrh-pair?
                             (lwrh-attestation-pair attestation)) 1)
                       (and (eq (oac-valid-ack?
                                 (lwrh-attestation-ack attestation)) 1)
                            (and (eq (lwo-category?
                                      (lwrh-attestation-alternatives attestation)
                                      LWO-FIELD) 1)
                                 (eq (lwco-optional-unknown-valid?
                                       (lwrh-attestation-unknown attestation))
                                     1)))))) 1 0))

(defn lwrh-source-in-attributions? (items source)
    (if (eq (len items) 0) 0
        (if (node_eq (lwo-attribution-source (head items)) source) 1
            (lwrh-source-in-attributions? (tail items) source))))
(defn lwrh-attestation-sources-independent?
    (attestation-items correction-attributions)
    (if (eq (len attestation-items) 0) 1
        (if (eq (lwrh-source-in-attributions? correction-attributions
                    (lwo-attribution-source (head attestation-items))) 1) 0
            (lwrh-attestation-sources-independent?
                (tail attestation-items) correction-attributions))))

(defn lwrh-attestation-current? (world attestation)
    (if (or (eq (lwrh-attestation-valid-shape? attestation) 0)
            (eq (lwo-active? world attestation) 0)) 0
        (do
            (let candidate (lwrh-attestation-hypothesis attestation))
            (let hypothesis (lwo-emergent-shape candidate))
            (let correction (lwrh-hypothesis-correction hypothesis))
            (if (and (eq (lwrh-integrated-current? world candidate) 1)
                     (and (eq (lwo-field-has?
                                (lwrh-hypothesis-proposed-pairs hypothesis)
                                (lwrh-attestation-pair attestation)) 1)
                          (eq (lwrh-attestation-sources-independent?
                                (lwo-field-items
                                    (lwo-active-attributions-for
                                        world attestation))
                                (lwo-field-items
                                    (lwo-active-attributions-for
                                        world correction))) 1))) 1 0))))

(defn lwrh-derived-observation (attestation)
    (do
        (let candidate (lwrh-attestation-hypothesis attestation))
        (let hypothesis (lwo-emergent-shape candidate))
        (let pair (lwrh-attestation-pair attestation))
        (lwrl-observation
            (lwrh-hypothesis-relation hypothesis)
            (lwrh-pair-left pair) (lwrh-pair-right pair)
            (lwrh-hypothesis-lens hypothesis)
            (lwrh-attestation-ack attestation)
            (lwrh-attestation-alternatives attestation)
            (lwrh-attestation-unknown attestation) attestation)))

(defn lwrh-same-holder-sources? (world left right)
    (do
        (let left-attributions (lwo-active-attributions-for world left))
        (let right-attributions (lwo-active-attributions-for world right))
        (if (and (eq (lwo-field-size left-attributions)
                     (lwo-field-size right-attributions))
                 (node_eq (lwt-sources-from-attributions
                            (lwo-field-items left-attributions)
                            (lwo-empty-field))
                          (lwt-sources-from-attributions
                            (lwo-field-items right-attributions)
                            (lwo-empty-field)))) 1 0)))

(defn lwrh-observation-current? (world observation attestation)
    (if (and (eq (lwrh-attestation-current? world attestation) 1)
             (and (node_eq observation
                    (lwrh-derived-observation attestation))
                  (and (eq (lwo-active? world observation) 1)
                       (eq (lwrh-same-holder-sources?
                            world observation attestation) 1)))) 1 0))

0
