; form-cli-e2e-flow-run.fk — observe the flow: cell, framebuffer, metal door.
;
; walk_recipe is a sibling seam; the interned add recipe is executed as Form.
; Metal is observed, not claimed as this recipe's executor.
; Framebuffer carries ids and phases, never prompt text.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-e2e-flow-xtal.fk form-stdlib/substrate-phase.fk observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed e2e-flow\n")
    (print "form-cli check=")
    (print (int_to_str (fee-check)))
    (print " choice-exec=")
    (print (int_to_str (fee-exec (fee-choice) (fee-branch 2 3) 7 9)))
    (print " undo=")
    (print (int_to_str (fee-exec (fee-undo) 5 7 9)))
    (print " restore=")
    (print (int_to_str (fee-exec (fee-restore) 5 7 9)))
    (print " timeout=")
    (print (int_to_str (fee-exec (fee-timeout) 5 7 9)))
    (print "\nform-cli xpath-names=")
    (print (head (fee-xpath-names (fee-flow-choice))))
    (print ",")
    (print (head (tail (fee-xpath-names (fee-flow-choice)))))
    (print ",")
    (print (head (tail (tail (fee-xpath-names (fee-flow-choice))))))
    (print ",")
    (print (head (tail (tail (tail (fee-xpath-names (fee-flow-choice)))))))
    (print "\nform-cli xpath-phases=")
    (print (int_to_str (head (fee-xpath-phases (fee-flow-choice)))))
    (print ",")
    (print (int_to_str (head (tail (fee-xpath-phases (fee-flow-choice))))))
    (print ",")
    (print (int_to_str (head (tail (tail (fee-xpath-phases (fee-flow-choice)))))))
    (print ",")
    (print (int_to_str (head (tail (tail (tail (fee-xpath-phases (fee-flow-choice))))))))
    (print "\nform-cli gas-op=")
    (print (fee-gas-op (fee-gas-ir)))
    (print " gas-phase=")
    (print (int_to_str (fee-gas)))
    (print "\nform-cli cell-children=")
    (print (int_to_str (len (node_children (intern_node (bp "add") (list (intern_trivial_int 2) (intern_trivial_int 3)))))))
    (print " cell-value=")
    (print (int_to_str (fee-branch 2 3)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli metal=")
    (print (metal_status))
    (print "\n")
    0)
