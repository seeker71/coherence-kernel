; form-cli-turn-evidence-grok-run.fk — refresh Grok session share from the bound dir.
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-turn-evidence-grok.bml

(do
    (let session (fctg-bound-session))
    (if (eq (str_len session) 0)
        (do (print_str "turn-evidence-refresh=unavailable reason=no-grok-session-binding\n") 1)
        (do (print_str (fctg-refresh-once session)) 0)))
