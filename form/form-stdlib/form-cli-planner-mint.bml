//////////////////////////////////////////////////////////////////////
//
// form-cli-planner-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-planner-mint.bml
//
// Eight planner organs from this sitting's remote turns, counted
// without prompt bytes. Overlay class is the planner move.
// Cartesian n = 8 skills * 9 lanes * (tn+hn).
//
// Proven by: form-stdlib/tests/form-cli-planner-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
    }

    class FormPlannerMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-planner-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormPlannerMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NeedEvents = 95;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fpl-authority = FormPlannerMintAuthority;
        thought fpl-pattern = list("ground", "walk", "one-turn", "tool", "observe", "land", "no-transcript", "pending");
        thought fpl-lanes = list("when", "where", "which", "what", "who", "how", "why", "knowledge-query", "walk");
        thought fpl-skills = list("ground-first", "walk-lane", "one-turn", "tool-pick", "mill-observe", "land", "no-transcript", "pending-honest");
        thought fpl-sources = list("AGENTS.md", "form/form-stdlib/form-cli-local-ready.bml", "form/form-stdlib/form-cli-one-turn.bml", "form/form-stdlib/form-cli-session-local.bml", "form/form-stdlib/land-cadence.fk", "observe/preflight.fk", "ingest/name-build-observe.fk", "docs/live-dynamic-diagnostics.md");

        def fpl-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fpl-ground-stems() = list("read the cell before speaking a structural answer", "a miss is honest say it is not here rather than inventing", "relay what you find attributed to where it lives", "form-first before the rented voice");
        def fpl-walk-stems() = list("native then local then remote form-cli first", "fcr-walk hit ready selects lane 0 or 1 or 2", "unknown miss stays remote a known Form repair is local-ready", "water answers only gaps");
        def fpl-turn-stems() = list("one local turn is the request remote reviews at most once", "a third remote is leak not another attempt", "remote absent is timeout stop after local", "fot-next-drop when remote-present is 0");
        def fpl-tool-stems() = list("form-run wraps observed shells so the framebuffer keeps the receipt", "grep the body before writing a sibling cell", "read the organ then write the mill", "host rg and ls are local-ready not a remote oracle");
        def fpl-observe-stems() = list("name then write BML then compile then band then keep only if the kernel stops objecting", "a green number with nonzero exit is a fold over nothing", "delete stale fkb before believing a verdict", "preflight before you trust the band");
        def fpl-land-stems() = list("fetch origin rebase push no force", "unexplained deletions stay unstaged", "even and clean is a clear picture nothing to land this breath", "quiet water turns push into silence");
        def fpl-quiet-stems() = list("never store private prompt or answer in the framebuffer", "count tools and lanes not the words of the turn", "serialized-tool-output-span-bytes stays 0", "learn the shape of the planner not the chat");
        def fpl-pending-stems() = list("fqt-lora stays 0 until generate loads tensors", "pending is honest a named gap is a work order", "do not dress a declared offering as a counted share", "Qwen GGUF stays frozen");

        def fpl-stems(class) = if str_eq(class, "ground-first") then fpl-ground-stems() else if str_eq(class, "walk-lane") then fpl-walk-stems() else if str_eq(class, "one-turn") then fpl-turn-stems() else if str_eq(class, "tool-pick") then fpl-tool-stems() else if str_eq(class, "mill-observe") then fpl-observe-stems() else if str_eq(class, "land") then fpl-land-stems() else if str_eq(class, "no-transcript") then fpl-quiet-stems() else fpl-pending-stems();

        def fpl-ask(lane, gloss) = if str_eq(lane, "when") then str_concat("When is this computable: ", gloss) else if str_eq(lane, "where") then str_concat("Where is the NodeID for: ", gloss) else if str_eq(lane, "which") then str_concat("Which cell answers: ", gloss) else if str_eq(lane, "what") then str_concat("What is: ", gloss) else if str_eq(lane, "who") then str_concat("Who offers: ", gloss) else if str_eq(lane, "how") then str_concat("How does the body: ", gloss) else if str_eq(lane, "why") then str_concat("Why does Form: ", gloss) else if str_eq(lane, "knowledge-query") then str_concat("Emit knowledge-query envelope ANCHOR PATH for: ", gloss) else str_concat("Walk native then local then remote for: ", gloss);

        def fpl-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fpl-situation(skill, lane, i, split) {
            let stems = fpl-stems(skill);
            let stem = nth(stems, fpl-mix(i, len(stems)));
            str_concat(fpl-prefix(split), str_concat(fpl-ask(lane, stem), str_concat(" case ", int_to_str(i))));
        }

        def fpl-row(skill, lane, i, split) = list(split, skill, fpl-situation(skill, lane, i, split));

        def fpl-i-rows(skill, lane, i, n, split, acc) = if eq(i, n) then acc else fpl-i-rows(skill, lane, add(i, 1), n, split, cons(fpl-row(skill, lane, i, split), acc));

        def fpl-lane-rows(skill, lanes, n, split, acc) = if eq(len(lanes), 0) then acc else fpl-lane-rows(skill, tail(lanes), n, split, fpl-i-rows(skill, head(lanes), 0, n, split, acc));

        def fpl-skill-rows(skills, tn, hn, acc) = if eq(len(skills), 0) then acc else fpl-skill-rows(tail(skills), tn, hn, fpl-lane-rows(head(skills), fpl-lanes(), hn, SplitHeldout(), fpl-lane-rows(head(skills), fpl-lanes(), tn, SplitTrain(), acc)));

        def fpl-corpus(tn, hn) = fpl-skill-rows(fpl-skills(), tn, hn, tail(list("x")));

        def fpl-n(tn, hn) = mul(len(fpl-skills()), mul(len(fpl-lanes()), add(tn, hn)));

        def fpl-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fpl-has-situation(tail(rows), s);

        def fpl-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fpl-train-only(tail(rows), cons(head(rows), acc)) else fpl-train-only(tail(rows), acc);

        def fpl-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fpl-has-situation(fpl-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fpl-leakage-loop(all, tail(rows)));

        def fpl-leakage(rows) = fpl-leakage-loop(rows, rows);

        def fpl-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fpl-has-situation(seen, nth(head(rows), 2)), 1) then fpl-unique-loop(tail(rows), seen) else fpl-unique-loop(tail(rows), cons(head(rows), seen));

        def fpl-unique(rows) = fpl-unique-loop(rows, tail(list("x")));

        def fpl-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fpl-count-split(tail(rows), split));

        def fpl-lora-writer() = LoraWriter();

        def fpl-mix-diverse() = if eq(fpl-mix(0, 9), fpl-mix(1, 9)) then 0 else 1;

        def fpl-pair-hit(rows, skill, lane) = fpl-has-situation(rows, fpl-situation(skill, lane, 0, SplitTrain()));

        def fpl-lane-cover(rows, skill, lanes) = if eq(len(lanes), 0) then 1 else if eq(fpl-pair-hit(rows, skill, head(lanes)), 0) then 0 else fpl-lane-cover(rows, skill, tail(lanes));

        def fpl-skill-cover(rows, skills) = if eq(len(skills), 0) then 1 else if eq(fpl-lane-cover(rows, head(skills), fpl-lanes()), 0) then 0 else fpl-skill-cover(rows, tail(skills));

        def fpl-covers-all(rows) = fpl-skill-cover(rows, fpl-skills());

        def fpl-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fpl-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fpl-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fpl-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fpl-heldout-hit(models, names, head(rows)), fpl-heldout-correct-loop(models, names, tail(rows)));

        def fpl-heldout-correct(rows) {
            let names = fpl-skills();
            let models = fqt-fit(rows, names);
            fpl-heldout-correct-loop(models, names, rows);
        }

        def fpl-bit(ok, bit) = if ok then bit else 0;

        def fpl-check() {
            let rows = fpl-corpus(1, 1);
            let n = fpl-n(1, 1);
            let correct = fpl-heldout-correct(rows);
            let c0 = fpl-bit(eq(n, 144), 1);
            let c1 = fpl-bit(eq(fpl-mix-diverse(), 1), 2);
            let c2 = fpl-bit(eq(fpl-leakage(rows), 0), 4);
            let c3 = fpl-bit(eq(fpl-unique(rows), n), 8);
            let c4 = fpl-bit(and(eq(fpl-count-split(rows, SplitTrain()), 72), eq(fpl-count-split(rows, SplitHeldout()), 72)), 16);
            let c5 = fpl-bit(ge(correct, 54), 32);
            let c6 = fpl-bit(and(eq(fpl-lora-writer(), 0), eq(NeedEvents(), 95)), 64);
            let c7 = fpl-bit(eq(fpl-covers-all(rows), 1), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
