; form-cli-lora-writer-run.fk — write a Form-knowledge A/B; Qwen stays frozen.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk

(do
    (let sample "heedmark is a token a carrier honors as a request")
    (let pair (flw-from-sample sample 8))
    (let A (nth pair 0))
    (let B (nth pair 1))
    (let wrote (flw-write (flw-path) A B))
    (print_str (str_concat "flw check=" (str_concat (int_to_str (flw-check)) "\n")))
    (print_str (str_concat "flw path=" (str_concat (flw-path) "\n")))
    (print_str (str_concat "flw written=" (str_concat (int_to_str (flw-written (flw-path))) "\n")))
    (print_str (str_concat "flw ready=" (str_concat (int_to_str (flw-ready (flw-path))) "\n")))
    (print_str (str_concat "flw dim=" (str_concat (int_to_str (len A)) "\n")))
    (print_str (str_concat "flw rank=" (str_concat (int_to_str (Rank)) "\n")))
    (print_str (str_concat "flw qwen-lora-flag=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "flw emit=" (str_concat (flw-emit A B) "\n")))
    0)
