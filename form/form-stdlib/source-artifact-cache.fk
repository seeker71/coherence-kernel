// source-artifact-cache.fk -- target route for source-owned execution artifacts.
//
// The source door should become a compiler front door. A `.fk` source is
// canonical. In this synthetic target
// route, a content-current program-image `.fkb` is the parsed image cache (including the
// `.tbl`-shaped node/function/string table), and a current verified `.dylib` is the
// native execution cache. The eventual runtime selector chooses the strongest
// current artifact:
//
//   current verified .dylib -> run native
//   current .fkb            -> run parsed image
//   changed/missing cache   -> compile .fk, then write .fkb and maybe .dylib
//
// The executing source runner uses content-bound `.fkb` images and RAM JIT.
// It never discovers a sibling `.dylib`; direct library execution requires an
// explicit path. This future native descriptor contract does not install that
// retired timestamp route or prove a native artifact's admission.
//
// This cell is the policy contract over synthetic state rows. It does not read
// disk artifacts, run a program-image `.fkb`, or load a `.dylib`. The
// host/compiler implementation remains a later layer: it must satisfy this route
// without growing the temporary C seed.
//
import form-stdlib/core.fk;
section [form.bml] {
    def sac-run-source-compile() = 1;
    def sac-run-fkb() = 2;
    def sac-run-dylib() = 3;
    def sac-feature(name, status) = ["source-artifact-cache-feature", name, status];
    def sac-feature-name(f) = f[1];
    def sac-feature-status(f) = f[2];
    def source-artifact-cache-manifest() = [sac-feature("source-authority", 1), sac-feature("program-image-fkb-cache", 1), sac-feature("program-image-includes-tbl", 1), sac-feature("dylib-native-cache", 1), sac-feature("content-identity-freshness", 1), sac-feature("artifact-local-integrity", 1), sac-feature("compile-on-stale", 1), sac-feature("no-c-seed-growth", 1)];
    def sac-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) sac-feature-name(fs[0]) == name && (Comparable) sac-feature-status(fs[0]) == 1 ? 1 : sac-manifest-has?(name, fs[1:]);
    // Each artifact's status already includes its own kind, version, source
    // identity and integrity. An unusable optional native image cannot spoil
    // a current parsed image. Timestamps remain descriptor provenance.
    // state = ("source-artifact-state" fkb-ok dylib-ok dylib-callable native-proof)
    def sac-state(fkb-ok, dylib-ok, dylib-callable, native-proof) = ["source-artifact-state", fkb-ok, dylib-ok, dylib-callable, native-proof];
    def sac-fkb-ok(s) = s[1];
    def sac-dylib-ok(s) = s[2];
    def sac-dylib-callable(s) = s[3];
    def sac-native-proof(s) = s[4];
    def sac-fkb-ready?(s) = (Comparable) sac-fkb-ok(s) == 1;
    // Native readiness also retains a current parsed image as its deopt
    // anchor. A failed admission remains with its owner for repair; the anchor
    // does not authorize executing a substitute answer.
    def sac-dylib-ready?(s) = (Comparable) sac-fkb-ready?(s) == 1 ? (Comparable) sac-dylib-ok(s) == 1 ? (Comparable) sac-dylib-callable(s) == 1 ? (Comparable) sac-native-proof(s) == 1 : 0 : 0 : 0;
    def sac-route(s) = (Comparable) sac-dylib-ready?(s) == 1 ? sac-run-dylib() : (Comparable) sac-fkb-ready?(s) == 1 ? sac-run-fkb() : sac-run-source-compile();
    def sac-skips-parse?(s) = (Comparable) sac-route(s) == sac-run-source-compile() ? 0 : 1;
    def sac-skips-recompute?(s) = (Comparable) sac-route(s) == sac-run-dylib() ? 1 : 0;
    // compile-output = ("source-compile-output" writes-fkb writes-dylib includes-tbl no-c-growth)
    def sac-compile-output(lowerable, native-proof) = ["source-compile-output", 1, (Comparable) lowerable == 1 ? (Comparable) native-proof == 1 ? 1 : 0 : 0, 1, 1];
    def sac-output-writes-fkb(o) = o[1];
    def sac-output-writes-dylib(o) = o[2];
    def sac-output-includes-tbl(o) = o[3];
    def sac-output-no-c-growth(o) = o[4];
}
