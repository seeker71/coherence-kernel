// source-artifact-cache.fk -- target route for source-owned execution artifacts.
//
// The direct the source door path should become a compiler front door, not the permanent
// runtime path for every invocation. A `.fk` source is canonical. In the target
// route, a fresh program-image `.fkb` is the parsed image cache (including the
// `.tbl`-shaped node/function/string table), and a fresh verified `.dylib` is the
// native execution cache. The eventual runtime selector chooses the strongest
// current artifact:
//
//   fresh verified .dylib -> run native
//   fresh .fkb            -> run parsed image
//   stale/missing cache   -> compile .fk, then write .fkb and maybe .dylib
//
// This cell is the policy contract over synthetic state rows. It does not read
// disk artifacts, run a program-image `.fkb`, or load a `.dylib`. The
// host/compiler implementation remains a later layer: it must satisfy this route
// without growing the temporary C seed.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def sac-run-source-compile() = 1;
    def sac-run-fkb() = 2;
    def sac-run-dylib() = 3;
    def sac-feature(name, status) = ["source-artifact-cache-feature", name, status];
    def sac-feature-name(f) = f[1];
    def sac-feature-status(f) = f[2];
    def source-artifact-cache-manifest() = [sac-feature("source-authority", 1), sac-feature("program-image-fkb-cache", 1), sac-feature("program-image-includes-tbl", 1), sac-feature("dylib-native-cache", 1), sac-feature("mtime-signature-freshness", 1), sac-feature("compile-on-stale", 1), sac-feature("no-c-seed-growth", 1)];
    def sac-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) sac-feature-name(head(fs)) == name && (Comparable) sac-feature-status(head(fs)) == 1 ? 1 : sac-manifest-has?(name, tail(fs));
    // state = ("source-artifact-state" source-mtime fkb-mtime dylib-mtime
    //          fkb-ok dylib-ok dylib-callable native-proof lowerable sig-ok)
    def sac-state(source-mtime, fkb-mtime, dylib-mtime, fkb-ok, dylib-ok, dylib-callable, native-proof, lowerable, sig-ok) = ["source-artifact-state", source-mtime, fkb-mtime, dylib-mtime, fkb-ok, dylib-ok, dylib-callable, native-proof, lowerable, sig-ok];
    def sac-source-mtime(s) = s[1];
    def sac-fkb-mtime(s) = s[2];
    def sac-dylib-mtime(s) = s[3];
    def sac-fkb-ok(s) = s[4];
    def sac-dylib-ok(s) = s[5];
    def sac-dylib-callable(s) = s[6];
    def sac-native-proof(s) = s[7];
    def sac-lowerable(s) = s[8];
    def sac-sig-ok(s) = s[9];
    def sac-fresh?(source-mtime, artifact-mtime, sig-ok) = source-mtime > 0 ? artifact-mtime >= source-mtime ? (Comparable) sig-ok == 1 ? 1 : 0 : 0 : 0;
    def sac-fkb-ready?(s) = (Comparable) sac-fkb-ok(s) == 1 ? sac-fresh?(sac-source-mtime(s), sac-fkb-mtime(s), sac-sig-ok(s)) : 0;
    // A native artifact must not strand the runtime without a current parsed
    // image fallback. The target selector can check dylib first, but policy
    // readiness still requires the program-image fkb to be current too.
    def sac-dylib-ready?(s) = (Comparable) sac-fkb-ready?(s) == 1 ? (Comparable) sac-dylib-ok(s) == 1 ? (Comparable) sac-dylib-callable(s) == 1 ? (Comparable) sac-native-proof(s) == 1 ? sac-fresh?(sac-source-mtime(s), sac-dylib-mtime(s), sac-sig-ok(s)) : 0 : 0 : 0 : 0;
    def sac-route(s) = (Comparable) sac-dylib-ready?(s) == 1 ? sac-run-dylib() : (Comparable) sac-fkb-ready?(s) == 1 ? sac-run-fkb() : sac-run-source-compile();
    def sac-skips-parse?(s) = (Comparable) sac-route(s) == sac-run-source-compile() ? 0 : 1;
    def sac-skips-recompute?(s) = (Comparable) sac-route(s) == sac-run-dylib() ? 1 : 0;
    // compile-output = ("source-compile-output" writes-fkb writes-dylib includes-tbl no-c-growth)
    def sac-compile-output(lowerable, native-proof) = ["source-compile-output", 1, (Comparable) lowerable == 1 ? (Comparable) native-proof == 1 ? 1 : 0 : 0, 1, 1];
    def sac-output-writes-fkb(o) = o[1];
    def sac-output-writes-dylib(o) = o[2];
    def sac-output-includes-tbl(o) = o[3];
    def sac-output-no-c-growth(o) = o[4];
}
