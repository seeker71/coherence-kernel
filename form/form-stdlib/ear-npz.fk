// ear-npz.fk — a model file read, natively: the tensor table of a numpy .npz (a stored zip of
// .npy members) so that each tensor becomes a metal buffer mapped straight off the file
// (metal_buf_from_file at the member's data offset) — no copy, no host tool, no python.
// A row is (name offset bytes dtype shape): dtype is the npy descr ("<f2" half, "<f4" float),
// shape a list of ints. Only stored (uncompressed) members are honest here; a deflated member
// answers with bytes -1 so nothing reads garbage as weights.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
section [form.bml] {
    def en-text(t) = nothing?(t) ? "" : t;
    def en-u16(s, i) = str_byte_at(s, i) + 256 * str_byte_at(s, i + 1);
    def en-u32(s, i) = en-u16(s, i) + 65536 * en-u16(s, i + 2);
    def en-slice(path, off, n) = en-text(read_file_slice(path, off, n));
    // the end-of-central-directory record is the last 22 bytes when the archive has no comment (numpy writes none)
    def en-eocd(path) = en-slice(path, file_size(path) - 22, 22);
    def en-cd-count(e) = en-u16(e, 10);
    def en-cd-size(e) = en-u32(e, 12);
    def en-cd-off(e) = en-u32(e, 16);
    // a central-directory entry: sizes and the local header it points at
    def en-ce-method(cd, e) = en-u16(cd, e + 10);
    def en-ce-csize(cd, e) = en-u32(cd, e + 20);
    def en-ce-nlen(cd, e) = en-u16(cd, e + 28);
    def en-ce-xlen(cd, e) = en-u16(cd, e + 30);
    def en-ce-clen(cd, e) = en-u16(cd, e + 32);
    def en-ce-lho(cd, e) = en-u32(cd, e + 42);
    def en-ce-name(cd, e) = substring(cd, e + 46, e + 46 + en-ce-nlen(cd, e));
    def en-ce-next(cd, e) = e + 46 + (en-ce-nlen(cd, e) + (en-ce-xlen(cd, e) + en-ce-clen(cd, e)));
    // the member's bytes start after its local header (30 + name + extra); the npy header after that
    def en-member-data(path, lho) = {
        let lh = en-slice(path, lho, 30);
        lho + (30 + (en-u16(lh, 26) + en-u16(lh, 28)));
    };
    def en-npy-hlen(h) = (Comparable) str_byte_at(h, 6) == 1 ? 10 + en-u16(h, 8) : 12 + en-u32(h, 8);
    def en-after(h, key) = {
        let at = str_find(h, key, 0);
        at < 0 ? "" : substring(h, at + str_len(key), str_len(h));
    };
    def en-upto(s, stop) = {
        let at = str_find(s, stop, 0);
        at < 0 ? s : substring(s, 0, at);
    };
    def en-descr(h) = en-upto(en-after(h, "'descr': '"), "'");
    def en-shape-ints(s) = (Comparable) str_len(trim(s)) == 0 ? list() : {
        let at = str_find(s, ",", 0);
        at < 0 ? list(str_to_int(trim(s))) : cons(str_to_int(trim(substring(s, 0, at))), en-shape-ints(substring(s, at + 1, str_len(s))));
    };
    def en-shape(h) = en-shape-ints(en-upto(en-after(h, "'shape': ("), ")"));
    def en-row(path, cd, e) = {
        let data = en-member-data(path, en-ce-lho(cd, e));
        let h = en-slice(path, data, 256);
        let hl = en-npy-hlen(h);
        list(substring(en-ce-name(cd, e), 0, str_len(en-ce-name(cd, e)) - 4), data + hl, (Comparable) en-ce-method(cd, e) == 0 ? en-ce-csize(cd, e) - hl : 0 - 1, en-descr(h), en-shape(h));
    };
    def en-rows-go(path, cd, e, n, acc) = n <= 0 ? reverse(acc) : en-rows-go(path, cd, en-ce-next(cd, e), n - 1, cons(en-row(path, cd, e), acc));
    // IS IT A ZIP AT ALL. The end-of-central-directory record opens with PK\x05\x06, and without that check the
    // door read the last 22 bytes of ANY file as one: pointed at whisper-large-v3-turbo's 1.6 GB safetensors —
    // a u64 header length and JSON, no zip anywhere in it — the table answered 7720 confident rows of nothing
    // on 2026-09-07. Not a refusal, not an error: a plausible number a caller would have mapped as weights.
    // A file with no members is honestly an empty table; a file that is not an archive is the same empty answer
    // rather than an invented one. (This inherits the no-comment assumption above: numpy writes none, so the
    // record is the last 22 bytes or it is not there.)
    def en-zip?(e) = str_len(e) < 22 ? 0 : (Comparable) str_byte_at(e, 0) == 80 ? (Comparable) str_byte_at(e, 1) == 75 ? (Comparable) str_byte_at(e, 2) == 5 ? (Comparable) str_byte_at(e, 3) == 6 ? 1 : 0 : 0 : 0 : 0;
    // the table: one row per member, in archive order
    def en-table(path) = {
        let e = en-eocd(path);
        (Comparable) en-zip?(e) == 1 ? {
            let cd = en-slice(path, en-cd-off(e), en-cd-size(e));
            en-rows-go(path, cd, 0, en-cd-count(e), list());
        } : list();
    };
    def en-find(rows, name) = (Comparable) len(rows) == 0 ? list() : (String) head(head(rows)) == name ? head(rows) : en-find(tail(rows), name);
    def en-off(row) = nth(row, 1);
    def en-bytes(row) = nth(row, 2);
    def en-dtype(row) = nth(row, 3);
    def en-shape-of(row) = nth(row, 4);
    def en-dim(row, i) = nth(en-shape-of(row), i);
    // the tensor as a resident metal buffer, mapped off the file at its data offset
    def en-buf(path, row) = metal_buf_from_file(path, en-off(row), en-bytes(row));
    def en-shape-text(xs) = (Comparable) len(xs) == 0 ? "" : str_concat(int_to_str(head(xs)), str_concat((Comparable) len(tail(xs)) == 0 ? "" : "x", en-shape-text(tail(xs))));
    def en-row-text(r) = str_concat(head(r), str_concat(" @", str_concat(int_to_str(en-off(r)), str_concat(" +", str_concat(int_to_str(en-bytes(r)), str_concat(" ", str_concat(en-dtype(r), str_concat(" ", en-shape-text(en-shape-of(r))))))))));
    0;
}
