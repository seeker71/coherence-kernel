; form-cli-share-run.fk — form-cli speaks this turn: share, path, walk, answer.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-offline.fk form-stdlib/form-cli-router.fk

(do
    (defn fcl-turn-walks () (list (fcr-walk 1 1) (fcr-walk 0 1) (fcr-walk 0 0)))
    ; Both readings print, and each says which sort it is. The walked tally is
    ; counted from the lanes this run actually took; the offered one is declared.
    (print "form-cli share WALKED (counted, kind=observed) native=")
    (print (int_to_str (fcl-sh-native (fcl-share-walked (fcl-turn-walks)))))
    (print " local=")
    (print (int_to_str (fcl-sh-local (fcl-share-walked (fcl-turn-walks)))))
    (print " remote=")
    (print (int_to_str (fcl-sh-remote (fcl-share-walked (fcl-turn-walks)))))
    (print "  walked-ok=")
    (print (int_to_str (fcl-walked-ok? (fcl-turn-walks))))
    (print "\n")
    (print "form-cli share INTENDED (a stated estimate, not a count) native=")
    (print (int_to_str (fcl-sh-native (fcl-share-intended))))
    (print " local=")
    (print (int_to_str (fcl-sh-local (fcl-share-intended))))
    (print " remote=")
    (print (int_to_str (fcl-sh-remote (fcl-share-intended))))
    (print "\n")
    (print "form-cli path: native then local then remote\n")
    (print "form-cli walk hit=1 ready=1 -> lane=")
    (print (int_to_str (fcr-walk 1 1)))
    (print " (0 native)\n")
    (print "form-cli walk hit=0 ready=1 -> lane=")
    (print (int_to_str (fcr-walk 0 1)))
    (print " (1 local)\n")
    (print "form-cli walk hit=0 ready=0 -> lane=")
    (print (int_to_str (fcr-walk 0 0)))
    (print " (2 remote)\n")
    (print "form-cli share-ok=")
    (print (int_to_str (fcl-share-ok? (fcl-this-turn))))
    (print " offered-home=")
    (print (int_to_str (add (fcl-sh-native (fcl-this-turn)) (fcl-sh-local (fcl-this-turn)))))
    (print " water=1\n")
    (print (fcl-spoken-answer))
    (print "\n")
    0)
