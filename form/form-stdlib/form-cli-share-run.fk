; form-cli-share-run.fk — form-cli speaks this turn: share, path, walk, answer.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-offline.fk form-stdlib/form-cli-router.fk

(do
    (print "form-cli share kind=")
    (print (fcl-share-kind-name (fcl-this-kind)))
    (print " offered native=")
    (print (int_to_str (fcl-sh-native (fcl-this-turn))))
    (print " local=")
    (print (int_to_str (fcl-sh-local (fcl-this-turn))))
    (print " remote=")
    (print (int_to_str (fcl-sh-remote (fcl-this-turn))))
    (print "\n")
    (print "form-cli path: native then local then remote\n")
    (print "form-cli walk hit=1 ready=1 -> lane=")
    (print (int_to_str (fcr-walk 1 1)))
    (print " (0 native)\n")
    (print "form-cli walk hit=0 ready=1 -> lane=")
    (print (int_to_str (fcr-walk 0 1)))
    (print " (1 local)\n")
    (print "form-cli walk hit=0 ready=0 -> lane=")
    (print (int_to_str (fcr-walk 0 0)))
    (print " (2 remote)\n")
    (print "form-cli share-ok=")
    (print (int_to_str (fcl-share-ok? (fcl-this-turn))))
    (print " offered-home=")
    (print (int_to_str (add (fcl-sh-native (fcl-this-turn)) (fcl-sh-local (fcl-this-turn)))))
    (print " water=1\n")
    (print (fcl-spoken-answer))
    (print "\n")
    0)
