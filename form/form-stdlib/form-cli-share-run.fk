// form-cli-share-run.fk — measured completed-turn share, path, walk, answer.
//
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/form-cli-local-law.fk;
import form-stdlib/form-cli-router.fk;
import form-stdlib/form-cli-turn-evidence.fk;
import form-stdlib/form-cli-turn-evidence-live.fk;
import form-stdlib/form-cli-turn-evidence-grok.bml;
import form-stdlib/bml/form-cli-turn-evidence-cursor.bml;
import form-stdlib/bml/form-cli-share-health.bml;
import form-stdlib/form-glass-telemetry-membrane.bml;
import form-stdlib/bml/form-cli-share-glass.bml;
import form-stdlib/bml/form-cli-token-glass.bml;
section [form.bml] {
    def fctes-join(parts) = (Comparable) len(parts) == 0 ? "" : ((String) parts[0] + fctes-join(parts[1:]));
    def fctes-flag(bit) = (Comparable) bit == 1 ? "1" : "0";
    // A remote count with an empty token total is a speech boundary. Provider
    // usage is carried when the call count matches and the provider's own total
    // is present, or when that lane is empty.
    def fctes-usage-carried?(e) = (Comparable) fcte-model-calls(e) == fcte-remote-events(e) && (fcte-total-tokens(e) > 0 || (Comparable) fcte-remote-events(e) == 0) ? 1 : 0;
    def fctes-tokens-reconciled?(e) = (Comparable) fcte-token-valid?(e) == 1 && (Comparable) fctes-usage-carried?(e) == 1 ? 1 : 0;
    def fctes-observed(e) = {
        let share = fcte-boundary-share(e);
        fctes-join([fctes-join(["turn=", fcte-turn-id(e), " thread=", fcte-thread-id(e), " model=", fcte-model-provider(e), "/", fcte-model(e), " duration-ms=", fcte-duration-ms(e).str(), " ttft-ms=", fcte-ttft-ms(e).str(), " final-output-bytes=", fcte-final-output-bytes(e).str(), "\n"]), fctes-join(["events native=", fcte-native-commands(e).str(), " local=", fcte-local-events(e).str(), " remote=", fcte-remote-events(e).str(), " total=", fcte-total-events(e).str(), "\n"]), fctes-join(["share native=", share[0].str(), " local=", share[1].str(), " remote=", share[2].str(), " sum=", sum(share).str(), "\n"]), fctes-join(["remote provider-usage-events=", fcte-model-calls(e).str(), " token-volume=not-used-for-share\n"]), fctes-join(["remote tokens input=", fcte-input-tokens(e).str(), " cached-input=", fcte-cached-input-tokens(e).str(), " uncached-input=", fcte-uncached-input-tokens(e).str(), " cache-write-input=", fcte-cache-write-input-tokens(e).str(), " output=", fcte-output-tokens(e).str(), " reasoning-output=", fcte-reasoning-output-tokens(e).str(), " unattributed=", fcte-unattributed-tokens(e).str(), " total=", fcte-total-tokens(e).str(), "\n"]), fctes-join(["local tool-calls=", fcte-tool-calls(e).str(), " tool-outputs=", fcte-tool-outputs(e).str(), " serialized-tool-output-span-bytes=", fcte-tool-output-bytes(e).str(), " form-commands=", fcte-form-commands(e).str(), " form-failures=", fcte-form-failures(e).str(), " patch-events=", fcte-patch-events(e).str(), " tool-wall-time=not-used-for-share\n"]), fctes-join(["native fkwu-commands=", fcte-native-commands(e).str(), " fkwu-failures=", fcte-native-failures(e).str(), " form-stdout-bytes=", fcte-form-stdout-bytes(e).str(), " form-stderr-bytes=", fcte-form-stderr-bytes(e).str(), " form-shown-bytes=", fcte-form-shown-bytes(e).str(), "\n"]), fctes-join(["coverage source-bound=1 carrier-identity=1 carrier-timestamps=1 source-coordinates=1 carrier-size=", fcte-carrier-size(e).str(), " start-byte=", fcte-start-at(e).str(), " complete-byte=", fcte-complete-at(e).str(), " turn-complete=1 provider-call-usage=", fctes-flag(fctes-usage-carried?(e)), " provider-token-total-reconciled=", fctes-flag(fctes-tokens-reconciled?(e)), " attribution-gap-explicit=1 tools-reconciled=1 form-receipt-window=512-tail-bytes bytes-reconciled=1 lanes-reconciled=1\n"]), "measurement-health=observed semantic-contribution=not-measured\n"]);
    };
    // An active task has no settled share. Its most recent provider call may still
    // be measured; the result is pressure, never a percentage or completed claim.
    // The source is the explicit binding where one stands, and otherwise the agent
    // transcript this body discovers for its own working tree, so the reading exists
    // on a host where nobody has written a binding by hand. The line names which
    // source answered, so a reader never has to guess where a count came from.
    def fctes-token-absent-reason(reading) = (String) fctel-token-reading-path(reading) == "" ? fctd-discovered-reason() : "no-completed-provider-call-in-native-tail";
    def fctes-active-provider-tokens(reading) = {
        let path = fctel-token-reading-path(reading);
        let state = fctel-token-reading-state(reading);
        (String) path == "" ? ("remote-token-pressure=unavailable reason=" + (fctes-token-absent-reason(reading) + "\n")) : {
            (Comparable) state[6] == 0 ? (String) fctel-token-reading-kind(reading) == "cursor-session-transcript" ? "remote-token-pressure=attention reason=provider-usage-not-in-transcript\n" : "remote-token-pressure=unavailable reason=no-completed-provider-call-in-native-tail\n" : fctes-join(["remote-token-pressure kind=last-completed-provider-call scope=open-task source=", fctel-token-reading-kind(reading), "\n", "remote tokens input=", state[1].str(), " cached-input=", state[2].str(), " uncached-input=", (state[1] - state[2]).str(), " cache-write-input=", state[3].str(), " output=", state[4].str(), " reasoning-output=", state[5].str(), " total=", state[6].str(), "\n"]);
        };
    };
    def fctes-route() = fctes-join(["form-cli path: native then local then remote\n", "form-cli walk hit=1 ready=1 -> lane=", fcr-walk(1, 1).str(), " (0 native)\n", "form-cli walk hit=0 ready=1 -> lane=", fcr-walk(0, 1).str(), " (1 local)\n", "form-cli walk hit=0 ready=0 -> lane=", fcr-walk(0, 0).str(), " (2 remote)\n"]);
    // The live collector's one-slice discovery is a continuation, so a cache read
    // must not turn "not in this slice" into "stale".  The high-BML cursor walks
    // byte coordinates only and returns the actual nearest terminal turn.
    def fctes-codex-source-reconciled?(e, path) = fctec-codex-source-reconciled?(e, path);
    def fctes-unmeasured-clear-validation() = {
        write_file_text(fctel-latest-validation-path(), "");
        fcte-parse("unmeasured");
    };
    // A row that has been physically disproved as latest is expired from the
    // current-value cache. Keeping it there made every later invocation rescan the
    // same append tail before advancing the new turn's durable cursor.
    def fctes-unmeasured-expire-stale() = {
        fctec-expire-current-stale();
        fcte-parse("unmeasured");
    };
    def fctes-cached-evidence() = file_size(fctel-observed-row-path()) <= 0 ? fctes-unmeasured-clear-validation() : {
        let row = fctel-trim-end(read_file(fctel-observed-row-path()));
        let evidence = fcte-parse(row);
        (Comparable) fcte-valid?(evidence) == 0 ? fctes-unmeasured-clear-validation() : (String) fcte-source(evidence) == fcte-source-kind-grok() ? evidence : !((String) fcte-source(evidence) == fcte-source-kind()) ? fctes-unmeasured-clear-validation() : {
            let path = fctel-bound-path();
            (String) path == "" ? fctes-unmeasured-clear-validation() : (Comparable) fctes-codex-source-reconciled?(evidence, path) == 0 ? fctes-unmeasured-clear-validation() : {
                let latest = fctec-advance-latest(evidence, path);
                (Comparable) fctec-latest?(latest) == 1 ? evidence : (Comparable) fctec-latest-progress?(latest) == 1 ? fcte-parse("unmeasured") : fctes-unmeasured-expire-stale();
            };
        };
    };
    {
        let grok-session = fctg-bound-session();
        let grok-refreshed = (Comparable) len(grok-session) == 0 ? fctg-attend-unbound() : fctg-refresh-once(grok-session);
        let refresh-start-ms = now_unix_ms();
        let observed-row-before = file_size(fctel-observed-row-path()) > 0;
        let before = fctes-cached-evidence();
        let stale-expired = observed-row-before && (Comparable) file_size(fctel-observed-row-path()) == 0;
        // A share read also advances one bounded native continuation when the
        // previous completed turn has not settled yet.  Re-entry is durable; an
        // observed row pays no refresh work.
        let validating = file_size(fctel-latest-validation-path()) > 0;
        let action = fctec-invocation-action(fcte-valid?(before), validating, stale-expired);
        let refresh = (String) action == "advance" ? fctec-refresh-bound() : fctec-invocation-status(action);
        // One invocation owns one evidence movement. A refresh that finishes a
        // candidate does not immediately spend a second slice validating it; the
        // following invocation reads and validates that durable row.
        let evidence = before;
        // The attention clock closes only after the atomic Glass snapshot write,
        // so it covers the whole evidence movement visible to another process.
        let share-published = fcsg-publish-evidence(now_unix_ms(), evidence);
        // One traversal answers both the printed line and the glass, so the reading
        // a reader sees on the frame is the reading the receipt names.
        let token-reading = fctel-token-reading();
        let tokens-published = fctg-publish(now_unix_ms(), fctel-token-reading-state(token-reading), fctel-token-reading-kind(token-reading), fctes-token-absent-reason(token-reading));
        let refresh-ms = now_unix_ms() - refresh-start-ms;
        print_str(fctes-join(["measurement-refresh=", refresh, "\n", "measurement-refresh-ms=", refresh-ms.str(), " normal-slice-bytes=", fctec-processing-bytes().str(), " whole-row-cap-bytes=", fctr-row-limit(fctec-processing-bytes()).str(), " attention-ms=", fctec-attention-ms().str(), " measurement-attention=", fctec-attention-state(refresh-ms), "\n", "glass-share=", fcsg-publish-status(share-published), "\n", "glass-tokens=", fctg-publish-status(tokens-published), "\n", "form-cli share kind=", fcte-kind-name(evidence), " scope=", (Comparable) fcte-valid?(evidence) == 1 ? (String) fcte-source(evidence) == fcte-source-kind-grok() ? "grok-session-form-receipts" : "previous-completed-turn" : "unmeasured", " basis=observed-boundary-event-counts-v1\n", (Comparable) fcte-valid?(evidence) == 1 ? fctes-observed(evidence) : fctes-join([fcsh-after-refresh(refresh), "semantic-contribution=not-measured\n"]), fctes-active-provider-tokens(token-reading), fctes-route(), fcl-spoken-answer()]));
        0;
    };
}
