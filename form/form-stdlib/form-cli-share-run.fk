; form-cli-share-run.fk — measured completed-turn share, path, walk, answer.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-local-law.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(defn fctes-join (parts)
    (if (eq (len parts) 0) ""
        (str_concat (head parts) (fctes-join (tail parts)))))

(defn fctes-observed (e)
    (do
        (let share (fcte-boundary-share e))
        (fctes-join (list
            (fctes-join (list "turn=" (fcte-turn-id e)
                " thread=" (fcte-thread-id e)
                " model=" (fcte-model-provider e) "/" (fcte-model e)
                " duration-ms=" (int_to_str (fcte-duration-ms e))
                " ttft-ms=" (int_to_str (fcte-ttft-ms e))
                " final-output-bytes=" (int_to_str (fcte-final-output-bytes e)) "\n"))
            (fctes-join (list "events native=" (int_to_str (fcte-native-commands e))
                " local=" (int_to_str (fcte-local-events e))
                " remote=" (int_to_str (fcte-remote-events e))
                " total=" (int_to_str (fcte-total-events e)) "\n"))
            (fctes-join (list "share native=" (int_to_str (nth share 0))
                " local=" (int_to_str (nth share 1))
                " remote=" (int_to_str (nth share 2))
                " sum=" (int_to_str (sum share)) "\n"))
            (fctes-join (list "remote provider-usage-events="
                (int_to_str (fcte-model-calls e))
                " token-volume=not-used-for-share\n"))
            (fctes-join (list "remote tokens input="
                (int_to_str (fcte-input-tokens e))
                " cached-input=" (int_to_str (fcte-cached-input-tokens e))
                " uncached-input=" (int_to_str (fcte-uncached-input-tokens e))
                " cache-write-input=" (int_to_str (fcte-cache-write-input-tokens e))
                " output=" (int_to_str (fcte-output-tokens e))
                " reasoning-output=" (int_to_str (fcte-reasoning-output-tokens e))
                " total=" (int_to_str (fcte-total-tokens e)) "\n"))
            (fctes-join (list "local tool-calls=" (int_to_str (fcte-tool-calls e))
                " tool-outputs=" (int_to_str (fcte-tool-outputs e))
                " serialized-tool-output-span-bytes=" (int_to_str (fcte-tool-output-bytes e))
                " form-commands=" (int_to_str (fcte-form-commands e))
                " form-failures=" (int_to_str (fcte-form-failures e))
                " patch-events=" (int_to_str (fcte-patch-events e))
                " tool-wall-time=not-used-for-share\n"))
            (fctes-join (list "native fkwu-commands=" (int_to_str (fcte-native-commands e))
                " fkwu-failures=" (int_to_str (fcte-native-failures e))
                " form-stdout-bytes=" (int_to_str (fcte-form-stdout-bytes e))
                " form-stderr-bytes=" (int_to_str (fcte-form-stderr-bytes e))
                " form-shown-bytes=" (int_to_str (fcte-form-shown-bytes e)) "\n"))
            "coverage source-bound=1 turn-complete=1 provider-usage=1 tools-reconciled=1 form-receipt-window=512-tail-bytes bytes-reconciled=1 lanes-reconciled=1\n"
            "measurement-health=observed semantic-contribution=not-measured\n"))))

; An active task has no settled share.  Its most recent provider call may still
; be measured; the result is pressure, never a percentage or completed claim.
(defn fctes-active-provider-tokens ()
    (do
        (let path (fctel-bound-path))
        (if (str_eq path "") "remote-token-pressure=withheld no-bound-rollout\n"
            (do
                (let state (fctel-last-usage-state path))
                (if (eq (nth state 6) 0)
                    "remote-token-pressure=withheld no-completed-provider-call-in-native-tail\n"
                    (fctes-join (list
                        "remote-token-pressure kind=last-completed-provider-call scope=open-task\n"
                        "remote tokens input=" (int_to_str (nth state 1))
                        " cached-input=" (int_to_str (nth state 2))
                        " uncached-input=" (int_to_str (sub (nth state 1) (nth state 2)))
                        " cache-write-input=" (int_to_str (nth state 3))
                        " output=" (int_to_str (nth state 4))
                        " reasoning-output=" (int_to_str (nth state 5))
                        " total=" (int_to_str (nth state 6)) "\n")))))))

(defn fctes-route ()
    (fctes-join (list
        "form-cli path: native then local then remote\n"
        "form-cli walk hit=1 ready=1 -> lane=" (int_to_str (fcr-walk 1 1)) " (0 native)\n"
        "form-cli walk hit=0 ready=1 -> lane=" (int_to_str (fcr-walk 0 1)) " (1 local)\n"
        "form-cli walk hit=0 ready=0 -> lane=" (int_to_str (fcr-walk 0 0)) " (2 remote)\n")))

(do
    (let evidence (fctel-evidence))
    (print_str (fctes-join (list
        "form-cli share kind=" (fcte-kind-name evidence)
        " scope=" (if (eq (fcte-valid? evidence) 1)
            (if (str_eq (fcte-source evidence) (fcte-source-kind-grok))
                "grok-session-form-receipts" "previous-completed-turn")
            "unmeasured")
        " basis=observed-boundary-event-counts-v1\n"
        (if (eq (fcte-valid? evidence) 1) (fctes-observed evidence)
            "measurement-health=unreconciled share=withheld semantic-contribution=not-measured\n")
        (fctes-active-provider-tokens)
        (fctes-route)
        (fcl-spoken-answer))))
    0)
