// form-table-text.fk — native serialization of the universal table image.
//
// preludes: form-stdlib/core.fk
//
// The image contains a count, reverse-built roots and reverse-built rows,
// separated by single ASCII spaces. Canonical order:
//   - the outer root and row lists are reverse-built, so their tail is emitted
//     first;
//   - a row's own values are emitted in its present (head-first) order;
//   - typed integer fields, including negative literals, use signed decimal
//     rendering without interpreting their words as mutable record handles.
//
// `form_table_text` receives proper Form lists, as `fkc-flatten-many` produces.
// Empty roots/rows remain the two-token image "0 0".
// Consume a balanced subtree and return its text plus the remaining list.
// Each byte participates in logarithmically many joins, each list cell once.
section [form.bml] {
    def ftt-join-count(parts, count) = (Comparable) count == 0 ? ["", parts] : (Comparable) count == 1 ? [head(parts), tail(parts)] : ftt-join-left(ftt-join-count(parts, count / 2), count - count / 2);
    def ftt-join-left(left, count) = ftt-join-right(head(left), ftt-join-count(left[1], count));
    def ftt-join-right(left, right) = [str_concat(left, head(right)), right[1]];
    def ftt-join(parts) = head(ftt-join-count(parts, len(parts)));
    def ftt-ints-parts(xs, parts) = (Comparable) len(xs) == 0 ? parts : ftt-ints-parts(tail(xs), cons(str_concat(" ", fstr-int-to-str(head(xs))), parts));
    def ftt-tail-first-ints(xs) = ftt-join(ftt-ints-parts(xs, []));
    def ftt-row-head-first(row) = (Comparable) len(row) == 0 ? "" : str_concat(" ", str_concat(fstr-int-to-str(head(row)), ftt-row-head-first(tail(row))));
    def ftt-rows-parts(rows, parts) = (Comparable) len(rows) == 0 ? parts : ftt-rows-parts(tail(rows), cons(ftt-row-head-first(head(rows)), parts));
    def ftt-tail-first-rows(rows) = ftt-join(ftt-rows-parts(rows, []));
    def form_table_text(roots, rows) = str_concat(fstr-int-to-str(len(roots)), str_concat(ftt-tail-first-ints(roots), str_concat(" ", str_concat(fstr-int-to-str(len(rows)), ftt-tail-first-rows(rows)))));
}
