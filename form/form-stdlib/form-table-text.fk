; form-table-text.fk — the source-runner binding for the universal table image.
;
; preludes: form-stdlib/core.fk
;
; The emitted universal walker owns tag 207 (`form_table_text`) as a native
; fast path.  The direct fkwu source runner deliberately does not expose that
; tag, which left `fkc-table-file` as an unresolved cross-lane name even though
; its representation is plain Form: a count, then reverse-built roots and
; reverse-built rows, separated by single ASCII spaces.
;
; This cell is the source-native binding.  It keeps the emitted serializer's
; canonical order exactly:
;   - the outer root and row lists are reverse-built, so their tail is emitted
;     first;
;   - a row's own values are emitted in its present (head-first) order;
;   - all integers, including negative literals, pass through core's decimal
;     renderer rather than through a host command or a C-seed exception.
;
; `form_table_text` receives proper Form lists, as `fkc-flatten-many` produces.
; Empty roots/rows remain the two-token image "0 0".

(defn ftt-tail-first-ints (xs)
    (if (eq (len xs) 0) ""
        (str_concat (ftt-tail-first-ints (tail xs))
                    (str_concat " " (int_to_str (head xs))))))

(defn ftt-row-head-first (row)
    (if (eq (len row) 0) ""
        (str_concat " "
                    (str_concat (int_to_str (head row))
                                (ftt-row-head-first (tail row))))))

(defn ftt-tail-first-rows (rows)
    (if (eq (len rows) 0) ""
        (str_concat (ftt-tail-first-rows (tail rows))
                    (ftt-row-head-first (head rows)))))

(defn form_table_text (roots rows)
    (str_concat (int_to_str (len roots))
                (str_concat (ftt-tail-first-ints roots)
                            (str_concat " "
                                        (str_concat (int_to_str (len rows))
                                                    (ftt-tail-first-rows rows))))))
