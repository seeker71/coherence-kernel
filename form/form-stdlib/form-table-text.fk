// form-table-text.fk — native serialization of the universal table image.
//
import form-stdlib/core.fk;
//
// The image contains a count, reverse-built roots and reverse-built rows,
// separated by single ASCII spaces. Canonical order:
//   - the outer root and row lists are reverse-built, so their tail is emitted
//     first;
//   - a row's own values are emitted in its present (head-first) order;
//   - typed integer fields, including negative literals, use signed decimal
//     rendering without interpreting their words as mutable record handles.
//
// `form_table_text` receives proper Form lists, as `fkc-flatten-many` produces.
// Empty roots/rows remain the two-token image "0 0".
// Consume a balanced subtree and return its text plus the remaining list.
// Each byte participates in logarithmically many joins, each list cell once.
section [form.bml] {
    def ftt-join-count(parts, count) = (Comparable) count == 0 ? ["", parts] : (Comparable) count == 1 ? [parts[0], parts[1:]] : ftt-join-left(ftt-join-count(parts, count / 2), count - count / 2);
    def ftt-join-left(left, count) = ftt-join-right(left[0], ftt-join-count(left[1], count));
    def ftt-join-right(left, right) = [((String) left + right[0]), right[1]];
    def ftt-join(parts) = ftt-join-count(parts, len(parts))[0];
    def ftt-ints-parts(xs, parts) = (Comparable) len(xs) == 0 ? parts : ftt-ints-parts(xs[1:], cons((" " + fstr-int-to-str(xs[0])), parts));
    def ftt-tail-first-ints(xs) = ftt-join(ftt-ints-parts(xs, []));
    def ftt-row-head-first(row) = (Comparable) len(row) == 0 ? "" : (" " + ((String) fstr-int-to-str(row[0]) + ftt-row-head-first(row[1:])));
    def ftt-rows-parts(rows, parts) = (Comparable) len(rows) == 0 ? parts : ftt-rows-parts(rows[1:], cons(ftt-row-head-first(rows[0]), parts));
    def ftt-tail-first-rows(rows) = ftt-join(ftt-rows-parts(rows, []));
    def form_table_text(roots, rows) = (fstr-int-to-str(len(roots)) + (ftt-tail-first-ints(roots) + (" " + ((String) fstr-int-to-str(len(rows)) + ftt-tail-first-rows(rows)))));
}
