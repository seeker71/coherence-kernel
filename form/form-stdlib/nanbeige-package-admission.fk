; nanbeige-package-admission.fk — Form owns the pinned local package identity.
;
; Host code may compute file sizes and SHA-256 values; only this cell decides
; whether those observations describe the released package.
; preludes: form-stdlib/core.fk

(do
    (defn nbpa-revision ()
        "5ff54fb7ed86ce8e216d78bff5417ab9981de3d4")
    (defn nbpa-shard1-size () 4973547960)
    (defn nbpa-shard2-size () 3366076760)
    (defn nbpa-shard1-sha ()
        "09d265d5ec837bc64462796b7f8c110be9a135a55ed7a6eb5d07e0e90c976a94")
    (defn nbpa-shard2-sha ()
        "31019e7870a044f44bc3f7e981f8c5ecd42d341e5ca6cfdbfd07fb95d95be389")
    (defn nbpa-config-sha ()
        "f6cb15b22847664f3a6049dc4b58fdd10f1650d112ac99a1da3d051f17c2ca19")
    (defn nbpa-tokenizer-sha ()
        "fb41d04798b714520a9b075727b0226538b7330254299062742c50ec8374bc36")
    (defn nbpa-index-sha ()
        "30d8da0fa8b97abc6d9eddfd017a0cb7a649bcbd58caa57804c56c767db5c0f1")

    (defn nbpa-admit?
        (revision shard1-size shard1-sha shard2-size shard2-sha
         config-sha tokenizer-sha index-sha)
        (if (str_eq revision (nbpa-revision))
            (if (and (eq shard1-size (nbpa-shard1-size))
                     (str_eq shard1-sha (nbpa-shard1-sha)))
                (if (and (eq shard2-size (nbpa-shard2-size))
                         (str_eq shard2-sha (nbpa-shard2-sha)))
                    (if (and (str_eq config-sha (nbpa-config-sha))
                             (str_eq tokenizer-sha (nbpa-tokenizer-sha)))
                        (if (str_eq index-sha (nbpa-index-sha)) 1 0)
                        0)
                    0)
                0)
            0))
    0)
