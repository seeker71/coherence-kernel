; stdin-source.fk — a door's input as one source, read by bytes, never by lines.
;
; read_line cuts its input at every newline and at 8191 bytes, handing the rest back as
; the next "line"; a door that reads its arguments that way cannot take a value that is
; longer or spans lines. stdin-text reads fd 0 in 64 KiB chunks through file_read until
; the stream ends and joins them by halving, so the door holds its whole input as one
; string: the source a cursor grammar (or parse-json) transmutes into Form in one pass.
; An empty stdin is "", and a closed one the same.
;
; A door host surface: fkwu carries file_read on fd 0.
;
; preludes: form-stdlib/core.fk

(do
    (defn stdin-chunks (acc)
        (do (let chunk (file_read 0 65536))
            (if (eq (str_len chunk) 0) acc (stdin-chunks (cons chunk acc)))))
    (defn stdin-text () (str-join-reversed (stdin-chunks (list))))
    0)
