; core-lexicon-growth.fk — the 64 as a SEED, asked what it can grow.
;
; preludes: form-stdlib/core-lexicon.fk
;
; Asked 2026-08-17, after Urs read a day of my work and said it seemed limiting
; and restricting instead of an unfolding from the core in a healthy blossoming
; way. He was right, and the pattern was uniform: everything built that day was
; a checkpoint. A hold that refuses to advance, a shadowing sentinel, a census
; that refuses, four holders and a consent gate, closure checks, well-foundedness
; refusals, "a word enters ONLY if". Even the vitality overlay beside this one is
; a promotion committee — admit, decline, hold the unmeasured.
;
; Nobody had ever asked the 64 to GROW.
;
; THE TURN: not "does this candidate pass?" but "what can these words reach?"
; The north star says an organic intelligence that runs from the inside OUT.
; Admission control runs outside-in. This cell runs the other direction: start
; at one word, follow its definition outward, and see how much of the body
; blooms from that single point.
;
; WHAT THE FIRST UNFOLDING FOUND, AND IT WAS NOT WHAT ANYONE EXPECTED
;   core-lexicon.fk proves its 64 are CLOSED — every definition token is in the
;   set or in the twelve glue words, and cl-closed? has been green for a long
;   time. Closure says the words hold each other up. It says nothing about
;   whether you can WALK them.
;
;   You cannot. Unfolding definitions outward:
;
;     from `nothing` (the ground, family 0 index 0)    30 of 64
;     from `is`      (the hub, in-degree 62)           29 of 64
;     from `kind`    (the best root in the whole set)  39 of 64
;     words that reach all 64                           0
;
;   Twenty-five concepts are unreachable from ANY single starting word. To
;   arrive at them you must already know them. The dictionary is consistent
;   without being connected — coherent, and not yet alive.
;
;   That is a far more interesting finding than a gate could ever produce, and
;   no gate would ever have produced it: a check asks "is this allowed", and
;   allowed was never the problem.
;
; THE SEED'S ANATOMY, measured rather than assumed
;   494 definition tokens across the 64.
;   `is` carries in-degree 62 — used by 62 of the other 63 definitions.
;   `thing` 25, `self` 11.
;   18 words sit on the RIM: no other definition reaches them at all.
;
;   The rim is not a defect. It is where the vocabulary is free — a word
;   nothing depends on can grow without disturbing anything. The rim is the
;   growing edge, and clg-rim-words names it so it can be walked instead of
;   guarded.
;
; GROWTH AS A MEASURED GAIN, WHICH IS THE WHOLE POINT
;   clg-gain asks a generative question: if the body held TWO words instead of
;   one, how much more of itself could it reach? That is not admission and it
;   cannot refuse anything — it returns a number of newly reachable concepts.
;   clg-best-companion runs it across the rim and answers which single word,
;   held alongside the best root, opens the most new ground.
;
;   The body finds its own next step. Nothing here is a hand-typed row.
;
; HONEST FLOOR: reachability here is definitional unfolding only — token
; membership in definitions, nothing semantic. A high reach does not mean a
; word is important and the rim does not mean a word is weak. What is claimed
; is exactly what is walked.
;
; Proof: form-stdlib/tests/core-lexicon-growth-band.fk

(do
    ;; ── the definition of a word, or an empty list ──────────────────
    (defn clg-defn-of-loop (rs w)
        (if (eq (len rs) 0) (list)
            (if (str_eq (cl-word (head rs)) w) (cl-def (head rs))
                (clg-defn-of-loop (tail rs) w))))
    (defn clg-defn-of (w) (clg-defn-of-loop (cl-lexicon) w))

    ;; ── unfolding outward ───────────────────────────────────────────
    ;; absorb every CORE word of a definition into the held set
    (defn clg-absorb (toks acc)
        (if (eq (len toks) 0) acc
            (clg-absorb (tail toks)
                (if (and (eq (cl-is-word? (head toks)) 1)
                         (eq (cl-in-list? acc (head toks)) 0))
                    (cons (head toks) acc) acc))))
    (defn clg-step-loop (frontier acc)
        (if (eq (len frontier) 0) acc
            (clg-step-loop (tail frontier) (clg-absorb (clg-defn-of (head frontier)) acc))))
    ;; grow to fixpoint, bounded — stops as soon as a step adds nothing
    (defn clg-grow (acc n)
        (if (eq n 0) acc
            (do (let nxt (clg-step-loop acc acc))
                (if (eq (len nxt) (len acc)) acc (clg-grow nxt (sub n 1))))))

    (defn clg-bloom (w) (clg-grow (list w) 14))
    (defn clg-reach (w) (len (clg-bloom w)))
    ;; and from a PAIR of words held together
    (defn clg-bloom2 (a b) (clg-grow (list a b) 14))
    (defn clg-reach2 (a b) (len (clg-bloom2 a b)))

    ;; ── the seed's anatomy ──────────────────────────────────────────
    (defn clg-indeg-loop (rs w n)
        (if (eq (len rs) 0) n
            (clg-indeg-loop (tail rs) w
                (add n (if (str_eq (cl-word (head rs)) w) 0
                           (cl-in-list? (cl-def (head rs)) w))))))
    ;; how many OTHER definitions reach this word
    (defn clg-indeg (w) (clg-indeg-loop (cl-lexicon) w 0))

    ;; the RIM: words no other definition reaches — the growing edge
    (defn clg-rim-loop (rs acc)
        (if (eq (len rs) 0) acc
            (clg-rim-loop (tail rs)
                (if (eq (clg-indeg (cl-word (head rs))) 0)
                    (cons (cl-word (head rs)) acc) acc))))
    (defn clg-rim-words () (clg-rim-loop (cl-lexicon) (list)))
    (defn clg-rim-count () (len (clg-rim-words)))

    ;; the hub: the highest in-degree in the set
    (defn clg-hub-loop (rs best bestw)
        (if (eq (len rs) 0) (list best bestw)
            (do (let d (clg-indeg (cl-word (head rs))))
                (clg-hub-loop (tail rs) (if (gt d best) d best)
                    (if (gt d best) (cl-word (head rs)) bestw)))))
    (defn clg-hub () (clg-hub-loop (cl-lexicon) 0 ""))
    (defn clg-hub-word () (head (tail (clg-hub))))
    (defn clg-hub-degree () (head (clg-hub)))

    ;; ── the best single root ────────────────────────────────────────
    (defn clg-best-root-loop (rs best bestw)
        (if (eq (len rs) 0) (list best bestw)
            (do (let r (clg-reach (cl-word (head rs))))
                (clg-best-root-loop (tail rs) (if (gt r best) r best)
                    (if (gt r best) (cl-word (head rs)) bestw)))))
    (defn clg-best-root () (clg-best-root-loop (cl-lexicon) 0 ""))
    (defn clg-max-reach () (head (clg-best-root)))
    (defn clg-best-root-word () (head (tail (clg-best-root))))

    ;; does ANY word unfold to the whole body?
    (defn clg-any-reaches-all? () (if (eq (clg-max-reach) (cl-count)) 1 0))
    ;; how much of itself the seed cannot reach from its best point
    (defn clg-unreached () (sub (cl-count) (clg-max-reach)))

    ;; ── GROWTH: the gain of holding one more word ───────────────────
    ;; Generative, and it cannot refuse: the count of concepts newly reachable
    ;; when `companion` is held alongside `root`. Zero means no new ground,
    ;; never "rejected".
    (defn clg-gain (root companion)
        (sub (clg-reach2 root companion) (clg-reach root)))

    ;; walked across the RIM, because a rim word is the free edge: nothing
    ;; depends on it, so pairing with it disturbs nothing
    (defn clg-companion-loop (ws root best bestw)
        (if (eq (len ws) 0) (list best bestw)
            (do (let g (clg-gain root (head ws)))
                (clg-companion-loop (tail ws) root (if (gt g best) g best)
                    (if (gt g best) (head ws) bestw)))))
    (defn clg-best-companion (root) (clg-companion-loop (clg-rim-words) root 0 ""))
    (defn clg-best-gain (root) (head (clg-best-companion root)))
    (defn clg-best-companion-word (root) (head (tail (clg-best-companion root))))

    ;; the body's own next step: the strongest pair it can hold
    (defn clg-two-root-reach ()
        (clg-reach2 (clg-best-root-word) (clg-best-companion-word (clg-best-root-word))))

    ;; ── MONOTONE: holding more never reaches less ───────────────────
    ;; The mathematical form of "this organ cannot refuse". A gate's answer
    ;; can go down; growth's cannot. clg-gain returns 0 for a companion that
    ;; opens no new ground — a number, never a rejection — and never a
    ;; negative, because a second root cannot un-reach what the first reached.
    (defn clg-monotone-loop (ws root)
        (if (eq (len ws) 0) 1
            (if (ge (clg-reach2 root (head ws)) (clg-reach root))
                (clg-monotone-loop (tail ws) root) 0)))
    (defn clg-monotone? () (clg-monotone-loop (clg-rim-words) (clg-best-root-word)))

    ;; ── THE ASK-LANE, WIRED ─────────────────────────────────────────
    ;; core-lexicon.fk defines eight query lanes and `which` asks for the next
    ;; one of many. Until now nothing could be ASKED anything — the dictionary
    ;; held its lanes as vocabulary and answered no questions with them.
    ;;
    ;; This is the body answering `which` about ITSELF: which word do I grow
    ;; next? The answer is not stored anywhere. It is computed by unfolding,
    ;; so it changes the moment the vocabulary does, and it needs no one to
    ;; maintain it.
    ;;
    ;; The lane's arm is `node` (axiom-5): `which` asks for a thing, and a
    ;; thing is a cell, so the conversation can go on from the answer.
    (defn clg-which-next () (clg-best-companion-word (clg-best-root-word)))
    (defn clg-which-root () (clg-best-root-word))
    ;; and `how many` — the gain that answer is worth
    (defn clg-how-much-next () (clg-best-gain (clg-best-root-word)))

    0)
