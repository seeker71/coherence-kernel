; form-cli-e2e-flow.bml — one end-to-end flow in form.lift.
;
; Yes asked for choice/cut/stop/undo/restore/timeout/nothing, BML to
; token, generated recipe, substrate cell, framebuffer, xpath inspect,
; and gas/water thoughts that never freeze. walk_recipe is a sibling
; lane; this cell executes as Form. Metal/MLX/JIT are named doors,
; observed in the live runner, not claimed as the executor here.
;
; Authority is this section.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-e2e-flow-band.fk
; witnessed: 2026-08-19 -> 1023

section [form.lift] {
    def fee-nothing() = 0;
    def fee-cut() = 1;
    def fee-stop() = 2;
    def fee-timeout() = 3;
    def fee-choice() = 4;
    def fee-undo() = 5;
    def fee-restore() = 6;

    def fee-id(name) = if str_eq(name, "nothing") then 0 else if str_eq(name, "cut") then 1 else if str_eq(name, "stop") then 2 else if str_eq(name, "timeout") then 3 else if str_eq(name, "choice") then 4 else if str_eq(name, "undo") then 5 else if str_eq(name, "restore") then 6 else 0;

    def fee-gas() = 0;
    def fee-water() = 1;
    def fee-ice() = 2;

    def fee-phase(id) = if id == 0 then 0 else if id == 6 then 2 else 1;

    def fee-branch(a, b) = a + b;

    def fee-exec(id, kept, prev, orig) = if id == 0 then 0 else if id == 1 then kept else if id == 2 then prev else if id == 3 then 0 else if id == 4 then kept else if id == 5 then prev else if id == 6 then orig else 0;

    def fee-stage(name, phase, tid, value) = list(name, phase, tid, value);

    def fee-q-name(stage) = nth(stage, 0);
    def fee-q-phase(stage) = nth(stage, 1);
    def fee-q-tid(stage) = nth(stage, 2);
    def fee-q-value(stage) = nth(stage, 3);

    def fee-flow-choice() = list(fee-stage("bml", 1, 4, 0), fee-stage("token", 0, 4, 4), fee-stage("exec", 1, 4, 5), fee-stage("cell", 2, 4, 5));

    def fee-xpath-phases(flow) = if len(flow) == 0 then empty else cons(fee-q-phase(head(flow)), fee-xpath-phases(tail(flow)));

    def fee-xpath-names(flow) = if len(flow) == 0 then empty else cons(fee-q-name(head(flow)), fee-xpath-names(tail(flow)));

    def fee-gas-ir() = list("add", list("add", 1, 1), 1);

    def fee-gas-op(ir) = nth(ir, 0);

    def fee-check() = add(if fee-id("nothing") == 0 then 1 else 0, add(if fee-id("choice") == 4 then 2 else 0, add(if fee-exec(0, 5, 7, 9) == 0 then 4 else 0, add(if fee-exec(4, 5, 7, 9) == 5 then 8 else 0, add(if fee-exec(5, 5, 7, 9) == 7 then 16 else 0, add(if fee-exec(6, 5, 7, 9) == 9 then 32 else 0, add(if fee-phase(0) == 0 then 64 else 0, add(if fee-phase(6) == 2 then 128 else 0, add(if str_eq(fee-q-name(nth(fee-flow-choice(), 2)), "exec") then 256 else 0, if str_eq(fee-gas-op(fee-gas-ir()), "add") then 512 else 0)))))))));
    0;
}
