; vedic-chat-run.fk — the runnable door for vedic-chat.fk: one question on stdin, the reading out.
;
; Direct-source Form does not read argv, and a fixed /tmp file would let two askers replace
; each other's question between write and read (observe/preflight-stdin-run.fk names the
; seam). So the question arrives as one stdin line and this process owns it:
;
;   echo "where is my moon?" | ./fkwu form/form-stdlib/vedic-chat-run.fk
;   echo "which dasha runs now?" | ./fkwu form/form-stdlib/vedic-chat-run.fk
;
; The chart is Urs's attested birth-moment (vedic-chat.fk). "now" is read from the host
; clock (now_unix_ms) so the running dasha is the one running today; a year written in the
; question wins over the clock. The answer is PRINTED, not merely returned, so every
; kernel renders the text rather than an interned pool index.
;
; PROOF LEVEL: FOURTH-ARM ONLY — this door reads stdin and the host clock (read_line,
; now_unix_ms); the body it calls (vedic-chat.fk) is four-way at tests/vedic-chat-band.fk.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/celestial-pole-channel.fk form-stdlib/trig.fk form-stdlib/ephemeris-sun.fk form-stdlib/ephemeris-moon.fk form-stdlib/ephemeris-nodes.fk form-stdlib/ephemeris-planets.fk form-stdlib/iching-channel.fk form-stdlib/hd-mandala-wheel.fk form-stdlib/genekey-profile.fk form-stdlib/zodiac-channel.fk form-stdlib/vedic-chat.fk

(do
    (defn vcr-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n") (vcr-trim-loop s (sub n 1))
                (if (str_eq (substring s (sub n 1) n) "\r") (vcr-trim-loop s (sub n 1))
                    (substring s 0 n)))))
    (defn vcr-question (raw)
        (if (nothing? raw) "" (vcr-trim-loop raw (str_len raw))))
    ;; the decimal year now: Unix ms -> years since 1970 at the mean Gregorian year
    (defn vcr-year-now ()
        (add 1970.0 (div (div (mul 1.0 (now_unix_ms)) 1000.0) 31556952.0)))
    (let q (vcr-question (read_line)))
    (let answer
        (if (eq (str_len q) 0)
            (vedic-respond-in "help" (vcr-year-now))
            (vedic-respond-in q (vcr-year-now))))
    (print_str answer)
    0)
