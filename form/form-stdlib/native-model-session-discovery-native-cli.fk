; native-model-session-discovery-native-cli.fk -- consented, read-only,
; privacy-safe isolation of the real Form-native session directory cursor.
; It never scans pair language, opens the RAG index, writes a report, or grants
; training, promotion, relationship-memory, or answer authority.
;
; stdin, one line each:
; consent token, owner surface, repo root, Codex home, file limit, optional lens.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk observe/live-call-framebuffer.fk form-stdlib/native-model-session-grounding-native-common.fk form-stdlib/native-model-session-grounding-native-json-string.fk form-stdlib/native-model-session-grounding-native-candidate.fk form-stdlib/native-model-session-grounding-native-session.fk form-stdlib/native-model-session-grounding-native-discovery.fk

(do
    (let started
        (lcfb-open-stream "native-session-discovery" "form-native"
            "read-only-resource-witness" "consent-request"
            "form/form-stdlib/native-model-session-discovery-native-cli.fk"
            13 9))
    (let consent-token (read_line))
    (let owner-surface (read_line))
    (let repo-root (read_line))
    (let codex-home (read_line))
    (let file-limit (str_to_int (read_line)))
    (let lens (read_line))
    (let request-observed
        (lcfb-call-stream "native-session-discovery" "consent-request"
            "leave" "form-native" "validate-local-scope"
            (lcfb-resource-target "scoped-diagnostic-request") 1 started
            "form/form-stdlib/native-model-session-discovery-native-cli.fk"
            24 9))
    (if (or (not (str_eq consent-token
                    "diagnostic-observation-consent-v1"))
            (or (lt file-limit 1)
                (or (eq (fs-is-dir? repo-root) 0)
                    (eq (fs-is-dir? codex-home) 0))))
        (do
            (print_str
                "schema=native-model-session-discovery-witness-v1\nexecution_success=0\nreason=missing-or-invalid-explicit-consent-or-local-input\n")
            0)
        (do
            (let entered
                (lcfb-call-stream "native-session-discovery"
                    "session-discovery" "enter" "form-native"
                    "root-session-select"
                    (lcfb-resource-target "private-metadata-only") 2 started
                    "form/form-stdlib/native-model-session-discovery-native-cli.fk"
                    40 17))
            (let state
                (nmsgn-select-sessions codex-home repo-root file-limit
                    (div (now_unix_ms) 1000) started))
            (let selected (nmsgn-selection-selected state))
            (let left
                (lcfb-call-stream "native-session-discovery"
                    "session-discovery" "leave" "form-native"
                    "root-session-select"
                    (lcfb-resource-target
                        (nmsgn-cat (list "metadata-only:"
                            (int_to_str (nmsgn-selection-source-count state))
                            ":" (int_to_str (len selected)) ":"
                            (int_to_str (nmsgn-selection-dirs state)) ":"
                            (int_to_str (nmsgn-selection-entries state)))))
                    3 started
                    "form/form-stdlib/native-model-session-discovery-native-cli.fk"
                    51 17))
            (print_str
                (nmsgn-cat (list
                    "schema=native-model-session-discovery-witness-v1\n"
                    "execution_success=1\n"
                    "source_session_count="
                    (int_to_str (nmsgn-selection-source-count state)) "\n"
                    "selected_session_count=" (int_to_str (len selected)) "\n"
                    "directories_observed="
                    (int_to_str (nmsgn-selection-dirs state)) "\n"
                    "entries_observed="
                    (int_to_str (nmsgn-selection-entries state)) "\n"
                    "lens_present="
                    (if (gt (str_len lens) 0) "1\n" "0\n")
                    "authority=none\n")))
            0)))
