; form-teach-layer.fk — a removable Form teaching layer any local model can wear.
;
; The base tensors stay themselves. This cell is the latch's other hand: it
; writes the situation the live door sees. No gradient into a GGUF.
;
; WHAT IS SHAREABLE. The eleven substrate nouns and the eight native control
; tags are Form's own text. Any chat model that will take a system turn can
; wear them. That is the model-independent layer. A single GGUF LoRA cannot
; sit on both 27B Qwen and 43-layer DS4 — the ranks and hidden sizes differ —
; so the tensor writer is per-arch when it exists. lora-adapter.fk already
; proved the low-rank identity is architecture-agnostic; emitting per-arch
; A/B from that identity is named, not claimed.
;
;   system-prefix   shareable text. qwen35, llama, qwen35moe, and any later
;                   chat arch that will take a system turn.
;   control-logit   DS4's reserved bank at 128000. The five-float file is
;                   that arch's other hand, not a second teaching meaning.
;
; Qwen has no CONTROL bank at 128000. Timeout is nothing (axiom-1).
; A logit-latch at q38-head is named, not claimed.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-teach-layer-band.fk
; witnessed: 2026-08-19 -> 1023

(do
    (defn ftl-latch-path () ".form-teach-layer")
    (defn ftl-legacy-latch-path () ".form-qwen-form-layer")

    (defn ftl-control (name tag gloss) (list name tag gloss))
    (defn ftl-ctl-name (r) (nth r 0))
    (defn ftl-ctl-tag (r) (nth r 1))
    (defn ftl-ctl-gloss (r) (nth r 2))

    (defn ftl-concept (name gloss) (list name gloss))
    (defn ftl-name (r) (nth r 0))
    (defn ftl-gloss (r) (nth r 1))

    ; eight native control invites. nothing is timeout's other face, not a ninth.
    (defn ftl-controls ()
        (list
            (ftl-control "choice" "<CHOICE>" "walk more than one path; first non-nothing wins")
            (ftl-control "cut" "<CUT>" "the boundary drops what will not be kept")
            (ftl-control "fail" "<FAIL>" "the nothing-ack itself; the offer is not admitted")
            (ftl-control "stop" "<STOP>" "the turn ends here")
            (ftl-control "undo" "<UNDO>" "restore the last kept checkpoint")
            (ftl-control "store" "<STORE>" "keep a value, content-addressed, not a mutation")
            (ftl-control "restore" "<RESTORE>" "hand a stored value back")
            (ftl-control "timeout" "<TIMEOUT>" "silence; timeout is nothing")))

    (defn ftl-concepts ()
        (list
            (ftl-concept "form" "the body's language: cells and recipes that run as themselves")
            (ftl-concept "form-language" "lists, names, and calls; meaning lives in the cell")
            (ftl-concept "form-substrate" "the walker, the Metal organ, the files this host holds")
            (ftl-concept "NL-to-form" "natural language arrives; Form is what can be run")
            (ftl-concept "form-cli" "the local door: ping generate models use learn choose form-layer")
            (ftl-concept "form-tokens" "BPE pieces from the sealed GGUF; nothing is compiled in")
            (ftl-concept "execution-tokens" "the control tags below; they invite acts, they are not prose")
            (ftl-concept "Node-ID" "a coordinate of meaning; make_nodeid level type inst, never a fake")
            (ftl-concept "Blueprint" "the shape a node wears; (bp NAME) asks the registry")
            (ftl-concept "Recipe" "a Form cell that can be run; data as the program")
            (ftl-concept "Cell" "one .fk body; a prelude chain; a band that can refuse")))

    (defn ftl-find-loop (rs name)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (ftl-name (head rs)) name) (head rs)
                (ftl-find-loop (tail rs) name))))
    (defn ftl-locate (name) (ftl-find-loop (ftl-concepts) name))
    (defn ftl-has? (name) (if (eq (len (ftl-locate name)) 0) 0 1))

    (defn ftl-ctl-find-loop (rs name)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (ftl-ctl-name (head rs)) name) (head rs)
                (ftl-ctl-find-loop (tail rs) name))))
    (defn ftl-ctl-locate (name) (ftl-ctl-find-loop (ftl-controls) name))

    (defn ftl-concept-line (r)
        (str_concat (ftl-name r) (str_concat " — " (ftl-gloss r))))
    (defn ftl-concept-lines (rs)
        (if (eq (len rs) 0) ""
            (str_concat (ftl-concept-line (head rs))
                (str_concat "\n" (ftl-concept-lines (tail rs))))))
    (defn ftl-ctl-line (r)
        (str_concat (ftl-ctl-tag r) (str_concat " " (ftl-ctl-gloss r))))
    (defn ftl-ctl-lines (rs)
        (if (eq (len rs) 0) ""
            (str_concat (ftl-ctl-line (head rs))
                (str_concat "\n" (ftl-ctl-lines (tail rs))))))

    (defn ftl-system-text ()
        (str_concat "You are Sema's body on this machine. Answer from Form.\n"
        (str_concat (ftl-concept-lines (ftl-concepts))
        (str_concat "\nWhen you mean a control act, write the tag. Timeout is nothing.\n"
                    (ftl-ctl-lines (ftl-controls))))))

    (defn ftl-wrapped-prompt (prompt)
        (str_concat (ftl-system-text) (str_concat "\n---\n" prompt)))

    ; The tensor-shaped writer is per-arch. The teaching meaning is one.
    (defn ftl-writer-kind (arch)
        (if (str_eq arch "deepseek4") "control-logit" "system-prefix"))
    (defn ftl-shareable? (arch)
        (if (str_eq (ftl-writer-kind arch) "system-prefix") 1 0))
    (defn ftl-writer-payload (arch)
        (if (str_eq arch "deepseek4")
            "form/native/metal/artifacts/dsv4-control-logit-adapter.f32"
            (ftl-system-text)))

    (defn ftl-on-text? (s)
        (if (or (str_eq s "on") (str_eq s "on\n")) 1 0))
    (defn ftl-armed? ()
        (if (eq (ftl-on-text? (read_file (ftl-latch-path))) 1) 1
            (ftl-on-text? (read_file (ftl-legacy-latch-path)))))

    (defn ftl-status-text ()
        (str_concat "form-layer="
        (str_concat (if (eq (ftl-armed?) 1) "on" "off")
        (str_concat " controls="
        (str_concat (int_to_str (len (ftl-controls)))
        (str_concat " concepts="
        (str_concat (int_to_str (len (ftl-concepts)))
        (str_concat " shareable-writer=" "system-prefix"))))))))

    (defn ftl-arg-is (arg a b)
        (or (str_eq arg a) (str_eq arg b)))

    (defn ftl-cli (arg)
        (if (or (str_eq arg "") (ftl-arg-is arg "status" "status\n"))
            (ftl-status-text)
            (if (ftl-arg-is arg "on" "on\n")
                (do (write_file_text (ftl-latch-path) "on\n") (ftl-status-text))
                (if (ftl-arg-is arg "off" "off\n")
                    (do (write_file_text (ftl-latch-path) "off\n") (ftl-status-text))
                    "usage: form-layer [on|off|status]"))))

    0)
