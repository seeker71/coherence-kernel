; situated-lens-authorized-control.fk — gate evidence-changing actions through
; the sovereign situated evidence membrane before actuating the field.
;
; Continue and abstain do not admit evidence, so they pass through without an
; authority demand. Request-evidence and revise can change the evidence field;
; they therefore require an admitted authority outcome before the existing
; exact-coordinate actuator may run.
;
; Decision:
;   [authority-outcome, actuated-state]
;
; The state remains the established:
;   [field, selected-node, action, accepted]
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk form-stdlib/situated-lens-conclusion-control.fk form-stdlib/situated-evidence-authority.fk
; witnessed: 2026-07-26 -> 262143 four-way

(do
    (defn slac-authority-required? (action)
        (if (or (eq action 2) (eq action 4)) 1 0))
    (defn slac-admission
        (action offered endorsements policy now)
        (if (eq (slac-authority-required? action) 1)
            (sea-admit offered endorsements policy now)
            (sea-not-required)))

    (defn slac-decision-pair (authority state)
        (list authority state))
    (defn slac-d-authority (decision) (nth decision 0))
    (defn slac-d-state (decision) (nth decision 1))

    (defn slac-decide
        (action field offered time lens current-node alternative
            endorsements policy now)
        (do
            (let authority
                (slac-admission action offered endorsements policy now))
            (let state
                (if (and (eq (slac-authority-required? action) 1)
                         (eq (sea-o-admitted authority) 0))
                    (slcc-state field alternative action 0)
                    (slcc-apply-action action field offered time lens
                        current-node alternative)))
            (slac-decision-pair authority state)))

    0)
