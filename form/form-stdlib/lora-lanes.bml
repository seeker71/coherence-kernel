// One frozen-base rank-one lane for every model the registry names, plus the mouth.
// The Llama 3B session school remains the only full trainer. Every other lane
// mints A and B beside the base and stays unpromoted. A width of 0 means the
// model's own shape has not been read, so no adapter bytes are invented.
import form-stdlib/lora-adapter.bml;
import form-stdlib/qwen-lora-train.fk;
import form-stdlib/kat-coder-embed.fk;
import form-stdlib/ear-geometry.bml;
import form-stdlib/role-prompts.bml;
section [form.bml] {
 class LoraLanes {
  def ll-source() = "form native observation carries a local voice home";
  def ll-a-name() = "model.output.weight.lora_a";
  def ll-b-name() = "model.output.weight.lora_b";
  def ll-home() = ".form-lora";
  def ll-session-home() = "form/form-stdlib/adapters/llama-3.2-3b-voice";
  def ll-byte(s, i) = str_byte_at(s, i % len(s));
  def ll-a-value(s, i) = ((ll-byte(s, i) + i) % 31 - 15 + 0.0) / 1048576.0;
  def ll-b-value(s, i) = ((ll-byte(s, i + 97) + i * 3) % 31 - 15 + 0.0) / 16777216.0;
  def ll-values-go(s, kind, i, n, acc) = i >= n ? reverse(acc) : ll-values-go(s, kind, i + 1, n, cons((Comparable) kind == 0 ? ll-a-value(s, i) : ll-b-value(s, i), acc));
  def ll-values(s, kind, n) = ll-values-go(s, kind, 0, n, []);
  def ll-artifact(name) = ll-home() + "/" + name + ".safetensors";
  def ll-rows() = [ll-row("llama32-3b-mlx-4bit", "llama-session", 0, ll-session-home(), "native-lora-train"), ll-row("qwen38-q8", "qwen-rank1", qlh-width(), ll-artifact("qwen38-q8"), "qwen-lora-train"), ll-row("qwen38-q4", "qwen-rank1", qlh-width(), ll-artifact("qwen38-q4"), "qwen-lora-train"), ll-row("katcoder", "rank1-frozen", kce-embed-ne0(), ll-artifact("katcoder"), "rank1-fit"), ll-row("form-llama-q4", "llama-gguf", 0, ll-artifact("form-llama-q4"), "shape-unread"), ll-row("qwen38-flash-next-q2", "qwen-flash", 0, ll-artifact("qwen38-flash-next-q2"), "shape-unread"), ll-row("ds4flash", "deepseek", 0, ll-artifact("ds4flash"), "shape-unread"), ll-row("whisper-large-v3-turbo", "whisper-rank1", 0, ll-artifact("whisper-large-v3-turbo"), "whisper-shape"), ll-row("whisper-large-v3-turbo-safetensors", "whisper-rank1", 0, ll-artifact("whisper-large-v3-turbo-safetensors"), "whisper-shape"), ll-row("whisper-tiny-fixture", "whisper-rank1", eng-D(eng-state(eng-tiny())), ll-artifact("whisper-tiny-fixture"), "whisper-shape"), ll-row("llama32-3b", "llama-gguf", 0, ll-artifact("llama32-3b"), "shape-unread"), ll-row("llama32-1b", "llama-gguf", 0, ll-artifact("llama32-1b"), "shape-unread"), ll-row("mouth", "mouth-rank1", 0, ll-artifact("mouth"), "voice-pass")];
  def ll-row(name, family, width, path, trainer) = [name, family, width, path, trainer];
  def ll-find(rows, name) = (Comparable) len(rows) == 0 ? [] : (String) rows[0][0] == name ? rows[0] : ll-find(rows[1:], name);
  def ll-has?(name) = (Comparable) len(ll-find(ll-rows(), name)) == 5 ? 1 : 0;
  def ll-prompt(name) = rp-prompt(name);
  def ll-promoted(name) = 0;
  def ll-whisper-large-width() = {
   let cfg = mr-path(mr-find("whisper-large-v3-turbo-safetensors")) + "/config.json";
   file_size(cfg) <= 0 ? 0 : eng-config(cfg)[0];
  };
  def ll-width(row) = row[2] > 0 ? row[2] : (String) row[0] == "whisper-large-v3-turbo-safetensors" ? ll-whisper-large-width() : 0;
  // With A=h/n, s=A·h. For nonzero s, B=target/s is the exact least-squares minimizer over B for this observed state:
  // B*(A·h)=target. The lane's own since qwen-lora-train.fk let its copy go (a0a2a33db).
  def ll-scale-go(xs, k, acc) = (Comparable) len(xs) == 0 ? reverse(acc) : ll-scale-go(xs[1:], k, cons(xs[0] * k, acc));
  def ll-scale(xs, k) = ll-scale-go(xs, k, empty());
  def ll-fit(h, target) {
   let a = ll-scale(h, 1.0 / (len(h) + 0.0));
   let s = qlt-dot(a, h);
   let b = (Comparable) s == 0.0 ? ll-scale(target, 0.0) : ll-scale(target, 1.0 / s);
   [a, b, s];
  }
  // the squared error of B·s against the target, summed; the lane's own since qwen-lora-train.fk let its copy go (a0a2a33db)
  def ll-sqerr-go(target, b, s, acc) = (Comparable) len(target) == 0 ? acc : ll-sqerr-go(target[1:], b[1:], s, acc + (b[0] * s - target[0]) * (b[0] * s - target[0]));
  def ll-loss(target, b, s) = ll-sqerr-go(target, b, s, 0.0);
  def ll-write-fit(name, hidden) = {
   let row = ll-find(ll-rows(), name);
   let width = (Comparable) len(row) == 5 ? ll-width(row) : 0;
   (Comparable) len(row) == 5 && (width > 0 && (Comparable) len(hidden) == width) ? {
    let fit = ll-fit(hidden, ll-values(ll-source(), 1, width));
    let made = host_dir_mkdir(ll-home());
    ln-write(row[3], [[ll-a-name(), [width, 1], fit[0]], [ll-b-name(), [1, width], fit[1]]]);
    fit;
   } : [];
  };
  def ll-tensor-bytes(path, name, width) = {
   let h = la-header(path);
   let start = ln-tensor-begin(h, name);
   start < 0 ? "" : read_file_slice(path, 8 + (la-header-len(path) + start), width * 4);
  };
  def ll-whole?(path, width) = file_size(path) <= 0 ? 0 : {
   let a = ll-tensor-bytes(path, ll-a-name(), width);
   let b = ll-tensor-bytes(path, ll-b-name(), width);
   (Comparable) len(a) == width * 4 && (Comparable) len(b) == width * 4 ? 1 : 0;
  };
  def ll-mint(path, width) = {
   let made = host_dir_mkdir(ll-home());
   ln-write(path, [[ll-a-name(), [width, 1], ll-values(ll-source(), 0, width)], [ll-b-name(), [1, width], ll-values(ll-source(), 1, width)]]);
  };
  def ll-ensure-row(row) = {
   let width = ll-width(row);
   (String) row[1] == "llama-session" ? file_size(row[3]) : width <= 0 ? 0 : (Comparable) ll-whole?(row[3], width) == 1 ? file_size(row[3]) : ll-mint(row[3], width);
  };
  def ll-ensure-go(rows, n) = (Comparable) len(rows) == 0 ? n : ll-ensure-go(rows[1:], n + ((Comparable) ll-ensure-row(rows[0]) > 0 ? 1 : 0));
  def ll-ensure() = ll-ensure-go(ll-rows(), 0);
  def ll-line(row) = row[0] + " family=" + row[1] + " width=" + ll-width(row).str() + " promoted=0 trainer=" + row[4] + " prompt=" + len(ll-prompt(row[0])).str() + " " + row[3];
  def ll-report-go(rows) = (Comparable) len(rows) == 0 ? "" : ll-line(rows[0]) + "\n" + ll-report-go(rows[1:]);
  def ll-report() = ll-report-go(ll-rows());
 }
 0;
}
