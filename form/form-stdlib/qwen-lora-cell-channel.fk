; qwen-lora-cell-channel.fk — a small Form-native channel between living cells.
;
; Inbound:  cell|turn|body
; Outbound: reply|cell|turn|body
; Glass:    state|phase|cell|turn|position|tokens|voice-home
;
; A body owns everything after its second separator, so symbols may use `|`
; freely.  The reply is flattened to one line so another cell can read it from
; the same native stream without a shell or HTTP parser.
;
; Proven by: form-stdlib/tests/qwen-lora-cell-channel-band.fk
; preludes: form-stdlib/core.fk

(do
    (defn qch-sep () "|")
    (defn qch-glass-path () ".form-qwen-lora-resident.glass")
    (defn qch-decode (line)
        (do
            (let a (str_find line (qch-sep) 0))
            (let b (if (lt a 0) -1 (str_find line (qch-sep) (add a 1))))
            (if (if (le a 0) 1 (if (le b a) 1 0))
                (list 0 "" 0 "")
                (list 1 (substring line 0 a)
                      (str_to_int (substring line (add a 1) b))
                      (substring line (add b 1) (str_len line))))))
    (defn qch-inbound (line fallback-turn)
        (do
            (let parsed (qch-decode line))
            (if (eq (nth parsed 0) 1) parsed
                (list 1 "stdin" fallback-turn line))))
    (defn qch-clean-go (text i acc)
        (if (ge i (str_len text)) acc
            (do
                (let cp (ord (char_at text i)))
                (let safe (if (or (eq cp 10) (or (eq cp 13) (eq cp 124))) " "
                              (char_at text i)))
                (qch-clean-go text (add i 1) (str_concat acc safe)))))
    (defn qch-clean (text) (qch-clean-go text 0 ""))
    (defn qch-reply (cell turn text)
        (str_concat "reply|" (str_concat cell
            (str_concat "|" (str_concat (int_to_str turn)
                (str_concat "|" (qch-clean text)))))))
    (defn qch-state (phase cell turn pos tokens home)
        (str_concat "state|" (str_concat phase
            (str_concat "|" (str_concat cell
            (str_concat "|" (str_concat (int_to_str turn)
            (str_concat "|" (str_concat (int_to_str pos)
            (str_concat "|" (str_concat (int_to_str tokens)
            (str_concat "|" (int_to_str home)))))))))))))
    (defn qch-publish (phase cell turn pos tokens home)
        (write_file (qch-glass-path) (qch-state phase cell turn pos tokens home)))
    0)
