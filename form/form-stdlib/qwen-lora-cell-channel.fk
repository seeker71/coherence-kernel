; qwen-lora-cell-channel.fk — a small Form-native channel between living cells.
;
; Inbound:  cell|turn|body
; Outbound: reply|cell|turn|body
; Glass:    a tagged Form event, rendered whole, followed by its `nl=` line.
;
; A body owns everything after its second separator, so symbols may use `|`
; freely.  The reply is flattened to one line so another cell can read it from
; the same native stream without a shell or HTTP parser.
;
; Proven by: form-stdlib/tests/qwen-lora-cell-channel-band.fk
; preludes: form-stdlib/core.fk

(do
    (defn qch-sep () "|")
    (defn qch-glass-path () ".form-qwen-lora-resident.glass")
    (defn qch-decode (line)
        (do
            (let a (str_find line (qch-sep) 0))
            (let b (if (lt a 0) -1 (str_find line (qch-sep) (add a 1))))
            (if (if (le a 0) 1 (if (le b a) 1 0))
                (list 0 "" 0 "")
                (list 1 (substring line 0 a)
                      (str_to_int (substring line (add a 1) b))
                      (substring line (add b 1) (str_len line))))))
    (defn qch-inbound (line fallback-turn)
        (do
            (let parsed (qch-decode line))
            (if (eq (nth parsed 0) 1) parsed
                (list 1 "stdin" fallback-turn line))))
    (defn qch-clean-go (text i acc)
        (if (ge i (str_len text)) acc
            (do
                (let cp (ord (char_at text i)))
                (let safe (if (or (eq cp 10) (or (eq cp 13) (eq cp 124))) " "
                              (char_at text i)))
                (qch-clean-go text (add i 1) (str_concat acc safe)))))
    (defn qch-clean (text) (qch-clean-go text 0 ""))
    (defn qch-join (xs)
        (if (eq (len xs) 0) ""
            (if (eq (len xs) 1) (head xs)
                (str_concat (head xs) (str_concat (qch-sep) (qch-join (tail xs)))))))
    (defn qch-token-text-go (ids acc)
        (if (eq (len ids) 0) acc
            (qch-token-text-go (tail ids)
                (str_concat acc (str_concat (if (eq (str_len acc) 0) "" ",")
                    (int_to_str (head ids)))))))
    (defn qch-token-text (ids) (qch-token-text-go ids ""))
    ; The event's native Form symbols and token ids become a real inspectable
    ; NodeID, without depending on a label supplied from outside the body.
    (defn qch-node-text (cell turn tokens)
        (do
            (let n (intern_trivial_string
                (str_concat "qwen-lora-cell:" (str_concat cell
                    (str_concat ":" (str_concat (int_to_str turn)
                        (str_concat ":" tokens)))))))
            (str_concat (int_to_str (node_pkg n))
                (str_concat "." (str_concat (int_to_str (node_level n))
                    (str_concat "." (str_concat (int_to_str (node_type n))
                        (str_concat "." (int_to_str (node_inst n))))))))))
    (defn qch-symbols (cell turn input output)
        (str_concat "cell=" (str_concat cell
            (str_concat ";turn=" (str_concat (int_to_str turn)
                (str_concat ";in=" (str_concat (qch-token-text input)
                    (str_concat ";out=" (qch-token-text output)))))))))
    (defn qch-recipe () "q38-prefill-adapted>q38-generate-adapted>rank1-head")
    (defn qch-reply (cell turn text)
        (str_concat "reply|" (str_concat cell
            (str_concat "|" (str_concat (int_to_str turn)
                (str_concat "|" (qch-clean text)))))))
    ; A native event is a dynamic list of named Form pairs.  Its decoder looks
    ; up a symbol, never a field position.  The file boundary presently carries
    ; its tagged rendering because fkwu has no read_form_binary primitive yet.
    (defn qch-field (name value) (list name value))
    (defn qch-field-name (field) (nth field 0))
    (defn qch-field-value (field) (nth field 1))
    (defn qch-event-get (event name)
        (if (eq (len event) 0) (qch-field name "")
            (if (str_eq (qch-field-name (head event)) name) (head event)
                (qch-event-get (tail event) name))))
    (defn qch-render-field (field)
        (str_concat (qch-field-name field)
            (str_concat "=" (qch-clean (qch-field-value field)))))
    (defn qch-render-event-go (event acc)
        (if (eq (len event) 0) acc
            (qch-render-event-go (tail event)
                (str_concat acc (str_concat (if (eq (str_len acc) 0) "" "|")
                    (qch-render-field (head event)))))))
    (defn qch-render-event (event) (qch-render-event-go event ""))
    (defn qch-render-public-go (event acc)
        (if (eq (len event) 0) acc
            (if (str_eq (qch-field-name (head event)) "nl")
                (qch-render-public-go (tail event) acc)
                (qch-render-public-go (tail event)
                    (str_concat acc (str_concat (if (eq (str_len acc) 0) "" "|")
                        (qch-render-field (head event))))))))
    (defn qch-render-public (event) (qch-render-public-go event ""))
    (defn qch-event (phase cell turn pos input output home nl)
        (do
            (let in (qch-token-text input))
            (let out (qch-token-text output))
            (let tokens (str_concat "in:" (str_concat in (str_concat ";out:" out))))
            (list (qch-field "event" "qwen-lora-resident")
                  (qch-field "phase" phase)
                  (qch-field "cell" cell)
                  (qch-field "turn" (int_to_str turn))
                  (qch-field "position" (int_to_str pos))
                  (qch-field "tokens.in" in)
                  (qch-field "tokens.out" out)
                  (qch-field "symbols" (qch-symbols cell turn input output))
                  (qch-field "node-id" (qch-node-text cell turn tokens))
                  (qch-field "recipe" (qch-recipe))
                  (qch-field "resolved" "1")
                  (qch-field "voice-home" (int_to_str home))
                  (qch-field "nl" nl))))
    (defn qch-state (phase cell turn pos input output home nl)
        (do
            (let event (qch-event phase cell turn pos input output home nl))
            (str_concat (qch-render-public event)
                (str_concat "\nnl=" (qch-clean (qch-field-value
                    (qch-event-get event "nl")))))))
    (defn qch-publish-event (phase cell turn pos input output home nl)
        (write_file (qch-glass-path)
            (qch-state phase cell turn pos input output home nl)))
    (defn qch-publish (phase cell turn pos tokens home)
        (qch-publish-event phase cell turn pos (empty) (empty) home ""))
    0)
