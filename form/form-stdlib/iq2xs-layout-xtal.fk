
(defn IQ2XSAuthorityPath () "form/form-stdlib/bml/iq2xs-layout.bml")
(defn IQ2XSAuthorityKind () "high-bml-interface-class-const")
(defn IQ2XSLayoutAuthority () (list "abstraction" "IQ2XSLayoutAuthority" (list) (list) (list "IQ2XSAuthorityPath" "IQ2XSAuthorityKind") (list) (list)))
(defn IQ2XSGGMLType () 17)
(defn IQ2XSBlockElements () 256)
(defn IQ2XSBlockBytes () 74)
(defn IQ2XSScaleOffset () 66)
(defn IQ2XSScaleBytes () 8)
(defn IQ2XSQuantWords () 32)
(defn IQ2XSGridEntries () 512)
(defn IQ2XSGridWidth () 8)
(defn IQ2XSSignEntries () 128)
(defn IQ2XSSIMDWidth () 32)
(defn IQ2XSSlotRows () 4)
(defn IQ2XSGroupsPerBlock () 8)
(defn IQ2XSGroupElements () 32)
(defn iq2x-authority () IQ2XSLayoutAuthority)
(defn iq2x-pattern () (list "type17" "256-elements" "74-bytes" "u16-grid-sign" "paired-nibble-scale" "slot4-one-simdgroup" "bounded-refusal"))
(defn iq2x-mod (x n) (sub x (mul (div x n) n)))
(defn iq2x-block-of (i) (div i (IQ2XSBlockElements)))
(defn iq2x-within (i) (iq2x-mod i (IQ2XSBlockElements)))
(defn iq2x-ib32 (i) (div (iq2x-within i) 32))
(defn iq2x-rem32 (i) (iq2x-mod (iq2x-within i) 32))
(defn iq2x-l (i) (div (iq2x-rem32 i) (IQ2XSGridWidth)))
(defn iq2x-j (i) (iq2x-mod (iq2x-rem32 i) (IQ2XSGridWidth)))
(defn iq2x-qword-index (i) (add (mul (iq2x-ib32 i) 4) (iq2x-l i)))
(defn iq2x-qword-offset (base i) (add (add base 2) (mul (iq2x-qword-index i) 2)))
(defn iq2x-scale-offset (base i) (add (add base (IQ2XSScaleOffset)) (iq2x-ib32 i)))
(defn iq2x-scale-code (scaleByte i) (if (lt (iq2x-l i) 2) (iq2x-mod scaleByte 16) (div scaleByte 16)))
(defn iq2x-grid-index (packedWord) (iq2x-mod packedWord (IQ2XSGridEntries)))
(defn iq2x-sign-index (packedWord) (div packedWord (IQ2XSGridEntries)))
(defn iq2x-slot-row0 (threadIndex) (mul (div threadIndex (IQ2XSSIMDWidth)) (IQ2XSSlotRows)))
(defn iq2x-slot-block (groupIndex) (div groupIndex (IQ2XSGroupsPerBlock)))
(defn iq2x-slot-group (groupIndex) (iq2x-mod groupIndex (IQ2XSGroupsPerBlock)))
(defn iq2x-slot-threads (rows) (mul (div (add rows (sub (IQ2XSSlotRows) 1)) (IQ2XSSlotRows)) (IQ2XSSIMDWidth)))
(defn iq2x-slot-admissible (rows cols) (if (lt rows 1) 0 (if (eq (iq2x-mod cols (IQ2XSBlockElements)) 0) 1 0)))
(defn iq2x-within-block (i) (if (lt i 0) 0 (if (lt i (IQ2XSBlockElements)) 1 0)))
(defn iq2x-bit (ok bit) (if ok bit 0))
(defn iq2x-check () (do (let c0 (iq2x-bit (if (eq (IQ2XSGGMLType) 17) (if (eq (IQ2XSBlockElements) 256) (eq (IQ2XSBlockBytes) 74) 0) 0) 1)) (let c1 (iq2x-bit (if (eq (iq2x-qword-offset 0 0) 2) (eq (iq2x-qword-offset 0 255) 64) 0) 2)) (let c2 (iq2x-bit (if (eq (iq2x-scale-offset 0 0) 66) (eq (iq2x-scale-offset 0 255) 73) 0) 4)) (let c3 (iq2x-bit (if (eq (iq2x-grid-index 65535) 511) (eq (iq2x-sign-index 65535) 127) 0) 8)) (let c4 (iq2x-bit (if (eq (iq2x-scale-code 163 0) 3) (eq (iq2x-scale-code 163 31) 10) 0) 16)) (let c5 (iq2x-bit (if (eq (iq2x-ib32 255) 7) (if (eq (iq2x-l 255) 3) (eq (iq2x-j 255) 7) 0) 0) 32)) (let c6 (iq2x-bit (if (eq (iq2x-within-block 255) 1) (if (eq (iq2x-within-block 256) 0) (eq (iq2x-within-block (sub 0 1)) 0) 0) 0) 64)) (let c7 (iq2x-bit (if (eq (iq2x-block-of 513) 2) (eq (iq2x-within 513) 1) 0) 128)) (let c8 (iq2x-bit (if (eq (iq2x-slot-row0 31) 0) (if (eq (iq2x-slot-row0 32) 4) (if (eq (iq2x-slot-block 15) 1) (if (eq (iq2x-slot-group 15) 7) (if (eq (iq2x-slot-threads 641) 5152) (if (eq (iq2x-slot-admissible 640 2560) 1) (eq (iq2x-slot-admissible 640 2559) 0) 0) 0) 0) 0) 0) 0) 256)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 c8))))))))))
(defn IQ2XSLayout () (list "abstraction" "IQ2XSLayout" (list) (list "iq2x-mod" "iq2x-block-of" "iq2x-within" "iq2x-ib32" "iq2x-rem32" "iq2x-l" "iq2x-j" "iq2x-qword-index" "iq2x-qword-offset" "iq2x-scale-offset" "iq2x-scale-code" "iq2x-grid-index" "iq2x-sign-index" "iq2x-slot-row0" "iq2x-slot-block" "iq2x-slot-group" "iq2x-slot-threads" "iq2x-slot-admissible" "iq2x-within-block" "iq2x-bit" "iq2x-check") (list "IQ2XSGGMLType" "IQ2XSBlockElements" "IQ2XSBlockBytes" "IQ2XSScaleOffset" "IQ2XSScaleBytes" "IQ2XSQuantWords" "IQ2XSGridEntries" "IQ2XSGridWidth" "IQ2XSSignEntries" "IQ2XSSIMDWidth" "IQ2XSSlotRows" "IQ2XSGroupsPerBlock" "IQ2XSGroupElements") (list "iq2x-authority") (list "iq2x-pattern")))
0
