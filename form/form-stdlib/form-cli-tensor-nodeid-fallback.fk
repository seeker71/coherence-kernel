; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/core.fk form-stdlib/form-recipe-exec-token.fk
; Proven by: form-stdlib/tests/form-cli-tensor-nodeid-fallback-band.fk

(do
    (defn fmnf-unknown-line ()
        "last_error=unknown tensor token; offer NodeID JIT\n")
    (defn fmnf-none-line () "last_error=none\n")
    (defn fmnf-linked-line () "tensor_backend=native-metal\n")
    (defn fmnf-status-has? (status line)
        (if (ge (str_find status line 0) 0) 1 0))
    (defn fmnf-status-ok? (status)
        (if (and (eq (fmnf-status-has? status (fmnf-linked-line)) 1)
                 (and (eq (fmnf-status-has? status (fmnf-none-line)) 1)
                      (eq (fmnf-status-has? status "value_present=1\n") 1))) 1 0))
    (defn fmnf-status-unknown? (status)
        (if (and (eq (fmnf-status-has? status (fmnf-linked-line)) 1)
                 (eq (fmnf-status-has? status (fmnf-unknown-line)) 1)) 1 0))
    (defn fmnf-i32? (value)
        (if (and (ge value (sub 0 2147483648))
                 (le value 2147483647)) 1 0))

    (defn fmnf-node-program (recipe input)
        (str_concat (int_to_str input)
            (str_concat " " (frex-node-coordinate recipe))))

    (defn fmnf-ready-request (recipe input)
        (frex-request "ready" "tensor-seam-unknown" recipe input "auto"
            (frex-request-node recipe input "auto")))

    (defn fmnf-attempt
        (kind reason value present request offer status program-bytes)
        (list kind reason value present request offer status program-bytes))
    (defn fmnf-attempt-kind (a) (nth a 0))
    (defn fmnf-attempt-reason (a) (nth a 1))
    (defn fmnf-attempt-value (a) (nth a 2))
    (defn fmnf-attempt-value-present? (a) (nth a 3))
    (defn fmnf-attempt-request (a) (nth a 4))
    (defn fmnf-attempt-offer (a) (nth a 5))
    (defn fmnf-attempt-status (a) (nth a 6))
    (defn fmnf-attempt-program-bytes (a) (nth a 7))
    (defn fmnf-attempt-request? (a)
        (if (str_eq (fmnf-attempt-kind a) "request") 1 0))

    (defn fmnf-classify (recipe input value status program-bytes)
        (if (eq (fmnf-status-ok? status) 1)
            (fmnf-attempt "value" "tensor-value" value 1
                (frex-nothing-request "not-requested")
                (frex-offer "metal" "value" value "tensor-value")
                status program-bytes)
        (if (eq (fmnf-status-unknown? status) 1)
            (if (and (eq (frex-recipe-valid? recipe) 1)
                     (eq (fmnf-i32? input) 1))
                (do
                    (let request (fmnf-ready-request recipe input))
                    (fmnf-attempt "request" "tensor-seam-unknown" 0 0
                        request
                        (frex-offer "metal" "failure" 0
                            "unknown-tensor-token")
                        status program-bytes))
                (fmnf-attempt "failure" "recipe-not-admitted" 0 0
                    (frex-nothing-request "recipe-not-admitted")
                    (frex-offer "metal" "failure" 0
                        "unknown-without-admitted-recipe")
                    status program-bytes))
            (fmnf-attempt "failure" "tensor-carrier-failure" 0 0
                (frex-nothing-request "tensor-carrier-failure")
                (frex-offer "metal" "failure" 0 "tensor-carrier-failure")
                status program-bytes))))

    (defn fmnf-settle-with-flags
        (attempt carrier status reason value present
         executed model-executed native-generated)
        (if (not (eq (fmnf-attempt-request? attempt) 1))
            (frex-result "nothing" "no-jit-request"
                (fmnf-attempt-request attempt) "" 0 0 (empty) 0)
            (do
                (let request (fmnf-attempt-request attempt))
                (let later (frex-offer carrier status value reason))
                (let pure (frex-choice request
                    (list (fmnf-attempt-offer attempt) later)))
                (frex-result-with-flags
                    (frex-result-status pure)
                    (frex-result-reason pure)
                    request
                    (frex-result-carrier pure)
                    (frex-result-value pure)
                    (frex-result-value-present? pure)
                    (frex-result-trace pure)
                    (frex-result-attempts pure)
                    executed model-executed native-generated))))
    0)
