; form-cli-free-remote-live.fk — touch one free outbound membrane.
;
; GET /openai/v1/models on Groq. No key is sent. Witnessed 2026-08-19:
; status 401, empty error. The face is reachable and still host-owed.
; That is not a chat completion.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-free-remote.fk

(do
    (print "ffr live check=")
    (print (int_to_str (ffr-check)))
    (print "\n")
    (let r (http_get "https://api.groq.com/openai/v1/models" (list) 15000))
    (print "ffr groq-models status=")
    (print (int_to_str (_get r "status_code")))
    (print " error=")
    (print (_get r "error"))
    (print "\n")
    0)
