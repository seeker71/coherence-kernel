; form-knowledge-qwen-heldout-v3-manifest-run.fk -- safe no-model seal witness.
;
; This renderer exposes only counts, current surface hashes, leakage counts,
; and dataset identities.  Held-out prompts, answers, sources, answer hashes,
; and excerpts never cross stdout.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v3-eval.fk

(do
    (defn fkh3m-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn fkh3m-audit-counts (audit at end)
        (if (gt at end) 0
            (do
                (fkh3m-line (str_concat "leakage-count-" (int_to_str at))
                            (int_to_str (nth audit at)))
                (fkh3m-audit-counts audit (add at 1) end))))
    (let rows (fkh3-rows))
    (let current (fkh3-dataset-sha256 rows))
    (fkh3m-line "rows" (int_to_str (len rows)))
    (fkh3m-line "families" (int_to_str (len (fkh3-families))))
    (fkh3m-line "family-coverage" (int_to_str (fkh3-family-coverage? rows)))
    (fkh3m-line "source-freshness" (int_to_str (fkh3-all-rows-current? rows)))
    (fkh3m-line "row-identity-unique" (int_to_str (fkh3-rows-unique? rows)))
    (fkh3m-line "dataset-current-sha256" current)
    (fkh3m-line "dataset-sealed-sha256" (fkh3-dataset-seal))
    (let audit (fkh3-leakage-audit rows))
    (fkh3m-audit-counts audit 1 20)
    (fkh3m-line "teach-current-sha256" (nth audit 21))
    (fkh3m-line "v1-current-sha256" (nth audit 22))
    (fkh3m-line "recipe-current-sha256" (nth audit 23))
    (fkh3m-line "dataset-valid"
        (int_to_str (fkh3-dataset-valid-with? rows audit)))
    0)
