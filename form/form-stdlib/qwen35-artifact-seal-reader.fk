// qwen35-artifact-seal-reader.fk -- read-only admission for resident Qwen.
//
// Artifact movement, range acquisition, resume state, and seal publication live
// in the fetch organ.  The running form-cli only reads an existing seal
// and asks the native SHA organ to compare it with the resident file.  This cell
// is that smaller meaning, kept in-process and Form-native.
//
// A verdict of 2 remains explicit nothing-about-the-artifact: it means the
// digest instrument did not answer.  It is never collapsed into seal failure.
//
// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk native/metal/sha256-arm64-jit.fk
section [form.bml] {
    def qaf-hex-digit(n) = substring("0123456789abcdef", n, n + 1);
    def qaf-hex-byte(b) = str_concat(qaf-hex-digit(b / 16), qaf-hex-digit(b % 16));
    def qaf-string-hex-from(raw, index, acc) = (Comparable) index == str_len(raw) ? acc : qaf-string-hex-from(raw, index + 1, str_concat(acc, qaf-hex-byte(str_byte_at(raw, index))));
    def qaf-string-hex(raw) = qaf-string-hex-from(raw, 0, "");
    def qaf-seal-prefix() = "qaf-seal1:";
    def qaf-seal-path-for(path) = str_concat(path, ".form-seal");
    def qaf-seal-fields(path) = !((Comparable) fs-exists?(qaf-seal-path-for(path)) == 1) ? list(-1, "") : {
        let text = fs-read-text(qaf-seal-path-for(path));
        !(str_len(text) >= str_len(qaf-seal-prefix()) + 66 && (String) substring(text, 0, str_len(qaf-seal-prefix())) == qaf-seal-prefix()) ? list(-1, "") : {
            let colon = str_find(text, ":", str_len(qaf-seal-prefix()));
            colon < 0 ? list(-1, "") : list(str_to_int(substring(text, str_len(qaf-seal-prefix()), colon)), substring(text, colon + 1, str_len(text)));
        };
    };
    def qaf-seal-valid?(path) = {
        let fields = qaf-seal-fields(path);
        (Comparable) file_size(path) == nth(fields, 0) && (Comparable) str_len(nth(fields, 1)) == 64 ? 1 : 0;
    };
    def qaf-seal-verdict(path) = !((Comparable) qaf-seal-valid?(path) == 1) ? 0 : {
        let fields = qaf-seal-fields(path);
        let digest = saj-file-digest(path, nth(fields, 0));
        (Comparable) str_len(digest) == 0 ? 2 : (String) qaf-string-hex(digest) == nth(fields, 1) ? 1 : 0;
    };
    def qaf-verify-sealed-file(path) = (Comparable) qaf-seal-verdict(path) == 1 ? 1 : 0;
    0;
}
