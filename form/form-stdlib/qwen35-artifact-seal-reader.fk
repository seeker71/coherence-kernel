; qwen35-artifact-seal-reader.fk -- read-only admission for resident Qwen.
;
; Artifact movement, range acquisition, resume state, and seal publication live
; in qwen35-artifact-fetch.fk.  The running form-cli only reads an existing seal
; and asks the native SHA organ to compare it with the resident file.  This cell
; is that smaller meaning, kept in-process and Form-native.
;
; A verdict of 2 remains explicit nothing-about-the-artifact: it means the
; digest instrument did not answer.  It is never collapsed into seal failure.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk native/metal/sha256-arm64-jit.fk
; The writer/reader contract is proven by: form-stdlib/tests/qwen35-artifact-seal-band.fk

(do
    (defn qaf-hex-digit (n)
        (substring "0123456789abcdef" n (add n 1)))
    (defn qaf-hex-byte (b)
        (str_concat (qaf-hex-digit (div b 16))
                    (qaf-hex-digit (mod b 16))))
    (defn qaf-string-hex-from (raw index acc)
        (if (eq index (str_len raw)) acc
            (qaf-string-hex-from raw (add index 1)
                (str_concat acc (qaf-hex-byte (str_byte_at raw index))))))
    (defn qaf-string-hex (raw) (qaf-string-hex-from raw 0 ""))

    (defn qaf-seal-prefix () "qaf-seal1:")
    (defn qaf-seal-path-for (path) (str_concat path ".form-seal"))
    (defn qaf-seal-fields (path)
        (if (not (eq (fs-exists? (qaf-seal-path-for path)) 1))
            (list -1 "")
            (do
                (let text (fs-read-text (qaf-seal-path-for path)))
                (if (not (and
                        (ge (str_len text) (add (str_len (qaf-seal-prefix)) 66))
                        (str_eq (substring text 0 (str_len (qaf-seal-prefix)))
                                (qaf-seal-prefix))))
                    (list -1 "")
                    (do
                        (let colon (str_find text ":" (str_len (qaf-seal-prefix))))
                        (if (lt colon 0) (list -1 "")
                            (list
                                (str_to_int (substring text
                                    (str_len (qaf-seal-prefix)) colon))
                                (substring text (add colon 1)
                                    (str_len text)))))))))
    (defn qaf-seal-valid? (path)
        (do
            (let fields (qaf-seal-fields path))
            (if (and (eq (file_size path) (nth fields 0))
                     (eq (str_len (nth fields 1)) 64)) 1 0)))
    (defn qaf-seal-verdict (path)
        (if (not (eq (qaf-seal-valid? path) 1)) 0
            (do
                (let fields (qaf-seal-fields path))
                (let digest (saj-file-digest path (nth fields 0)))
                (if (eq (str_len digest) 0) 2
                    (if (str_eq (qaf-string-hex digest) (nth fields 1)) 1 0)))))
    (defn qaf-verify-sealed-file (path)
        (if (eq (qaf-seal-verdict path) 1) 1 0))

    0)
