//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-writer.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lora-writer.bml
//
// General-d rank-1 LoRA: identity W, forward x + B*(A·x). Emit one
// line, write, read back. Sample string seeds A and B. Qwen GGUF
// is not modified. fqt-lora? remains 0.
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template AdapterPair<TVec> {
        member a: TVec;
        member b: TVec;
        member rank: int;
        member scale: int;
    }

    class FormLoraWriterAuthority {
        field LoraWriterAuthorityPath = "form/form-stdlib/bml/form-cli-lora-writer.bml";
        field LoraWriterAuthorityKind = "high-bml-class-template-field";
    }

    class FormLoraWriter<T> {
        field Scale = 1000;
        field Rank = 1;
        field Tag = "lora-v1";
        field AdapterPath = ".form-lora-adapter";
        field Pipe = "|";
        field Comma = ",";

        ref flw-authority = FormLoraWriterAuthority;
        thought flw-pattern = list("dot", "forward", "emit", "write");

        def flw-none() = tail(list(0));
        def flw-scale() = Scale();
        def flw-path() = AdapterPath();

        def flw-dot(a, b) = if ((Comparable) len(a) == 0) then 0 else (((head(a) * head(b)) / Scale()) + flw-dot(tail(a), tail(b)));
        def flw-scale-vec(v, s) = if ((Comparable) len(v) == 0) then flw-none() else cons(((head(v) * s) / Scale()), flw-scale-vec(tail(v), s));
        def flw-add(a, b) = if ((Comparable) len(a) == 0) then flw-none() else cons((head(a) + head(b)), flw-add(tail(a), tail(b)));
        def flw-eq-vec(a, b) = if (((Comparable) len(a) == 0) && ((Comparable) len(b) == 0)) then 1 else if ((Comparable) len(a) == len(b)) then if ((Comparable) head(a) == head(b)) then flw-eq-vec(tail(a), tail(b)) else 0 else 0;

        def flw-id-forward(B, A, x) = flw-add(x, flw-scale-vec(B, flw-dot(A, x)));

        def flw-join-ints(xs) = if ((Comparable) len(xs) == 0) then "" else if ((Comparable) len(tail(xs)) == 0) then int_to_str(head(xs)) else str_concat(int_to_str(head(xs)), str_concat(Comma(), flw-join-ints(tail(xs))));

        def flw-emit(A, B) = str_concat(Tag(), str_concat(Pipe(), str_concat(int_to_str(len(A)), str_concat(Pipe(), str_concat(int_to_str(Rank()), str_concat(Pipe(), str_concat(int_to_str(Scale()), str_concat(Pipe(), str_concat(flw-join-ints(A), str_concat(Pipe(), flw-join-ints(B)))))))))));

        def flw-parse-ints(xs) = if ((Comparable) len(xs) == 0) then flw-none() else cons(str_to_int(head(xs)), flw-parse-ints(tail(xs)));

        def flw-parse(s) {
            let parts = split-on(s, Pipe());
            let A = flw-parse-ints(split-on(nth(parts, 4), Comma()));
            let B = flw-parse-ints(split-on(nth(parts, 5), Comma()));
            list(nth(parts, 0), str_to_int(nth(parts, 1)), str_to_int(nth(parts, 2)), str_to_int(nth(parts, 3)), A, B);
        }

        def flw-write(path, A, B) = write_file_text(path, flw-emit(A, B));

        def flw-written(path) = if (file_size(path) <= 0) then 0 else if (str_find(read_file(path), Tag(), 0) >= 0) then 1 else 0;

        def flw-byte(s, i) = if (i >= str_len(s)) then 0 else ord(char_at(s, i));

        def flw-fill(s, i, n, acc) = if ((Comparable) n == 0) then acc else flw-fill(s, (i + 1), (n - 1), cons(((flw-byte(s, i) + 1) * 4), acc));

        def flw-from-sample(s, d) {
            let A = flw-fill(s, 0, d, flw-none());
            let B = flw-fill(s, d, d, flw-none());
            list(A, B);
        }

        def flw-ready(path) = flw-written(path);

        def flw-bit(ok, bit) = if ok then bit else 0;

        def flw-check() {
            let x = list(1000, 2000, 1000);
            let A = list(1000, 0, 0);
            let B = list(0, 0, 2000);
            let fwd = flw-id-forward(B, A, x);
            let path = str_concat(fs-temp-dir(), "/fk-lora-writer.txt");
            let w = flw-write(path, A, B);
            let parsed = flw-parse(read_file(path));
            let x8 = list(1000, 0, 0, 0, 0, 0, 0, 0);
            let pair8 = flw-from-sample("heedmark is a token a carrier honors as a request", 8);
            let fwd8 = flw-id-forward(nth(pair8, 1), nth(pair8, 0), x8);
            let pair8b = flw-from-sample("heedmark is a token a carrier honors as a request", 8);
            let c0 = flw-bit((((Comparable) nth(fwd, 0) == 1000) && (((Comparable) nth(fwd, 1) == 2000) && ((Comparable) nth(fwd, 2) == 3000))), 1);
            let c1 = flw-bit((!((Comparable) nth(fwd, 2) == nth(x, 2))), 2);
            let c2 = flw-bit((((Comparable) flw-written(path) == 1) && ((String) nth(parsed, 0) == Tag())), 4);
            let c3 = flw-bit((flw-eq-vec(nth(parsed, 4), A) && flw-eq-vec(nth(parsed, 5), B)), 8);
            let c4 = flw-bit(((len(A) + len(B)) < (3 * 3)), 16);
            let c5 = flw-bit(((Comparable) len(nth(pair8, 0)) == 8), 32);
            let c6 = flw-bit((!flw-eq-vec(fwd8, x8)), 64);
            let c7 = flw-bit(flw-eq-vec(nth(pair8, 0), nth(pair8b, 0)), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
