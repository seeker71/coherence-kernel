//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-writer.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lora-writer.bml
//
// General-d rank-1 LoRA: identity W, forward x + B*(A·x). Emit one
// line, write, read back. Sample string seeds A and B. Qwen GGUF
// is not modified. fqt-lora? remains 0.
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template AdapterPair<TVec> {
        member a: TVec;
        member b: TVec;
        member rank: int;
        member scale: int;
    }

    class FormLoraWriterAuthority {
        field LoraWriterAuthorityPath = "form/form-stdlib/bml/form-cli-lora-writer.bml";
        field LoraWriterAuthorityKind = "high-bml-class-template-field";
    }

    class FormLoraWriter<T> {
        field Scale = 1000;
        field Rank = 1;
        field Tag = "lora-v1";
        field AdapterPath = ".form-lora-adapter";
        field Pipe = "|";
        field Comma = ",";

        ref flw-authority = FormLoraWriterAuthority;
        thought flw-pattern = list("dot", "forward", "emit", "write");

        def flw-none() = tail(list(0));
        def flw-scale() = Scale();
        def flw-path() = AdapterPath();

        def flw-dot(a, b) = (Comparable) len(a) == 0 ? 0 : (((head(a) * head(b)) / Scale()) + flw-dot(tail(a), tail(b)));
        def flw-scale-vec(v, s) = (Comparable) len(v) == 0 ? flw-none() : cons((head(v) * s) / Scale(), flw-scale-vec(tail(v), s));
        def flw-add(a, b) = (Comparable) len(a) == 0 ? flw-none() : cons(head(a) + head(b), flw-add(tail(a), tail(b)));
        def flw-eq-vec(a, b) = ((Comparable) len(a) == 0) && ((Comparable) len(b) == 0) ? 1 : (Comparable) len(a) == len(b) ? ((Comparable) head(a) == head(b) ? flw-eq-vec(tail(a), tail(b)) : 0) : 0;

        def flw-id-forward(B, A, x) = flw-add(x, flw-scale-vec(B, flw-dot(A, x)));

        def flw-join-ints(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? int_to_str(head(xs)) : int_to_str(head(xs)) ++ Comma() ++ flw-join-ints(tail(xs));

        def flw-emit(A, B) = Tag() ++ Pipe() ++ int_to_str(len(A)) ++ Pipe() ++ int_to_str(Rank()) ++ Pipe() ++ int_to_str(Scale()) ++ Pipe() ++ flw-join-ints(A) ++ Pipe() ++ flw-join-ints(B);

        def flw-parse-ints(xs) = (Comparable) len(xs) == 0 ? flw-none() : cons(str_to_int(head(xs)), flw-parse-ints(tail(xs)));

        def flw-parse(s) {
            let parts = split-on(s, Pipe());
            let A = flw-parse-ints(split-on(parts[4], Comma()));
            let B = flw-parse-ints(split-on(parts[5], Comma()));
            list(parts[0], str_to_int(parts[1]), str_to_int(parts[2]), str_to_int(parts[3]), A, B);
        }

        def flw-write(path, A, B) = write_file_text(path, flw-emit(A, B));

        def flw-written(path) = file_size(path) <= 0 ? 0 : str_find(read_file(path), Tag(), 0) >= 0 ? 1 : 0;

        def flw-byte(s, i) = i >= str_len(s) ? 0 : ord(char_at(s, i));

        def flw-fill(s, i, n, acc) = (Comparable) n == 0 ? acc : flw-fill(s, i + 1, n - 1, cons((flw-byte(s, i) + 1) * 4, acc));

        def flw-from-sample(s, d) {
            let A = flw-fill(s, 0, d, flw-none());
            let B = flw-fill(s, d, d, flw-none());
            list(A, B);
        }

        def flw-ready(path) = flw-written(path);

        def flw-bit(ok, bit) = ok ? bit : 0;

        def flw-check() {
            let x = list(1000, 2000, 1000);
            let A = list(1000, 0, 0);
            let B = list(0, 0, 2000);
            let fwd = flw-id-forward(B, A, x);
            let path = fs-temp-dir() ++ "/fk-lora-writer.txt";
            let w = flw-write(path, A, B);
            let parsed = flw-parse(read_file(path));
            let x8 = list(1000, 0, 0, 0, 0, 0, 0, 0);
            let pair8 = flw-from-sample("heedmark is a token a carrier honors as a request", 8);
            let fwd8 = flw-id-forward(pair8[1], pair8[0], x8);
            let pair8b = flw-from-sample("heedmark is a token a carrier honors as a request", 8);
            let c0 = flw-bit(((Comparable) fwd[0] == 1000) && (((Comparable) fwd[1] == 2000) && ((Comparable) fwd[2] == 3000)), 1);
            let c1 = flw-bit(!((Comparable) fwd[2] == x[2]), 2);
            let c2 = flw-bit(((Comparable) flw-written(path) == 1) && ((String) parsed[0] == Tag()), 4);
            let c3 = flw-bit(flw-eq-vec(parsed[4], A) && flw-eq-vec(parsed[5], B), 8);
            let c4 = flw-bit((len(A) + len(B)) < (3 * 3), 16);
            let c5 = flw-bit((Comparable) len(pair8[0]) == 8, 32);
            let c6 = flw-bit(!flw-eq-vec(fwd8, x8), 64);
            let c7 = flw-bit(flw-eq-vec(pair8[0], pair8b[0]), 128);
            c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7))))));
        }
    }
    0;
}
