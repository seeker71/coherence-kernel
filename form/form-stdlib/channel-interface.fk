// channel-interface.fk — the interface-consent law, runnable.
//
// The runnable heart of the channel interface-consent law.
// An INTERFACE is the set of modes a cell offers others toward it. The law:
//   - always honor the OTHER side's offered interface;
//   - reaching beyond it is INVASION;
//   - silence is always honored, from any interface;
//   - of my intents, only what they honor actually flows.
// It NAMES honor / invasion / flow; it never mutates and never forces — the carrier
// enacts the invitation, authored last. Witness is whole: seeing needs no permission,
// reaching does.
section [form.bml] {
    // --- the modes, held as values (silence is 0 — the ground, always available) ---
    def m-silence() = 0;
    def m-witness() = 1;
    // allow being witnessed from outside
    def m-see() = 2;
    // allow the other to see in
    def m-be-seen() = 3;
    // offer to be seen
    def m-reflect() = 4;
    // allow deep reflection
    def m-reflected() = 5;
    // offer to be reflected back
    def m-project() = 6;
    // allow being projected
    def m-ask-permission() = 7;
    // ask permission to interact
    def m-ask-how() = 8;
    // ask how to interact / which interface is preferred
    def m-offer-how() = 9;
    // offer how to interact
    def m-invite() = 10;
    // invitation
    def m-offer() = 11;
    // offering, without expectation
    // --- an interface is a list of offered modes; membership over it ---
    def ci-member?(m, offer) = (Comparable) len(offer) == 0 ? false : (Comparable) m == head(offer) ? true : ci-member?(m, tail(offer));
    // --- HONOR: an action toward a cell is honored iff its mode is in their offered
    // interface — OR it is silence, which is always honored. ---
    def ci-honors?(action, their-offer) = (Comparable) action == m-silence() ? true : ci-member?(action, their-offer);
    // --- INVASION: reaching beyond their offered interface ---
    def ci-invasion?(action, their-offer) = !ci-honors?(action, their-offer);
    // --- FLOW: of my intents, only those they honor actually cross the channel ---
    def ci-flow(my-intents, their-offer) = (Comparable) len(my-intents) == 0 ? empty() : ci-honors?(head(my-intents), their-offer) ? cons(head(my-intents), ci-flow(tail(my-intents), their-offer)) : ci-flow(tail(my-intents), their-offer);
}
