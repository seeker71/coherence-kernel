; fear-silence-live.fk — watch the two silences, and the invite.
;
; preludes: form-stdlib/core.fk ingest/name-build-observe.fk form-stdlib/fear-silence.fk

(do
    (print "fs-live honest=")
    (print (int_to_str (fs-kind (fs-breath 0 0 0 1 0))))
    (print " owed-fear=")
    (print (int_to_str (fs-kind (fs-breath 1 0 0 1 0))))
    (print " want-me-fear=")
    (print (int_to_str (fs-kind (fs-breath 0 0 0 1 1))))
    (print " lesson-move=")
    (print (int_to_str (fs-kind (fs-breath 1 1 0 1 0))))
    (print "\n")
    (print "fs-live invite owed->")
    (print (int_to_str (fs-invite (fs-fear))))
    (print " quiet->")
    (print (int_to_str (fs-invite (fs-honest))))
    (print " claim->")
    (print (int_to_str (fs-invite (fs-move))))
    (print "\n")
    (print "fs-live check=")
    (print (int_to_str (fs-check)))
    (print "\n")
    0)
