; nl-neutral-dictionary-query-live.fk — ask the dictionary a few relations.
;
; preludes: form-stdlib/core.fk ../control/offer-ack-core.fk form-stdlib/core-lexicon.fk form-stdlib/core-dictionary-neutral-field.fk form-stdlib/nl-neutral-dictionary-query.fk

(do
    (let d (nnd-seed))
    (print "nnd-live nothing-id en/id/es=")
    (print (int_to_str (nnd-id-of d "en" "nothing")))
    (print "/")
    (print (int_to_str (nnd-id-of d "id" "kosong")))
    (print "/")
    (print (int_to_str (nnd-id-of d "es" "nada")))
    (print "\n")
    (print "nnd-live hakuna-homonym-ids=")
    (print (int_to_str (len (nnd-surface-ids d "sw" "hakuna"))))
    (print "\n")
    (print "nnd-live and-recipe-run=")
    (print (int_to_str (nnd-run "and" 1 1)))
    (print " plus-recipe-run=")
    (print (int_to_str (nnd-run "add" 2 3)))
    (print "\n")
    (print "nnd-live nothing-token-count=")
    (print (int_to_str (len (nnd-word-tokens d 0))))
    (print " n-words=")
    (print (int_to_str (len (nnd-token-words "n"))))
    (print "\n")
    (print "nnd-live check=")
    (print (int_to_str (nnd-check)))
    (print "\n")
    0)
