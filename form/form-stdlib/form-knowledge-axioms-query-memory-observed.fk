(do
    (defn fkaqmo-path () "axioms/core-axioms.form")
    (defn fkaqmo-anchor () "resting point")
    (defn fkaqmo-question ()
        "How many axioms are held as the resting point in core-axioms.form? Reply with only the English number.")
    (defn fkaqmo-evidence-sha ()
        "4d7db831fdb44d9a7dbc7cc934c1177e94117f3f94852219bdc51153a2d0ac50")
    (defn fkaqmo-receipt-path ()
        "receipts/2026-08-25-axioms-query-token-rag-transfer.md")
