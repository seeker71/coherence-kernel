; nine-fold.fk — digital root and the doubling circuit.
;
; What is observed: every positive integer folds to 1..9 by repeated digit
; sum, which is n mod 9 with 9 standing for 0. Doubling walks
; 1-2-4-8-7-5 and repeats. 3 and 6 trade. 9 stays.
; Complements to 9: 1↔8, 2↔7, 4↔5, 3↔6, 9↔9.
; A living triple can be folded as a reading, not a law.
; What is not claimed: a physics, a Tesla sentence, a source code of the
; universe. Those costumes were composted in ingest/frequency-ingest-369-keys.fk.
;
; witnessed: 2026-09-10 -> band 255
; preludes: form-stdlib/core.fk

(do
    (defn nf-fold (n)
        (if (le n 0) 0
            (do
                (let r (mod n 9))
                (if (eq r 0) 9 r))))
    (defn nf-double (n) (nf-fold (mul n 2)))
    (defn nf-walk (n k)
        (if (eq k 0) (list)
            (cons n (nf-walk (nf-double n) (sub k 1)))))
    (defn nf-circuit () (nf-walk 1 6))
    (defn nf-threes () (nf-walk 3 4))
    (defn nf-nines () (nf-walk 9 3))
    (defn nf-axis? (n)
        (if (or (eq (nf-fold n) 3)
                (or (eq (nf-fold n) 6) (eq (nf-fold n) 9))) 1 0))
    (defn nf-opp (n)
        (do
            (let f (nf-fold n))
            (if (or (eq f 0) (eq f 9)) f (sub 9 f))))
    (defn nf-pair-nine? (n)
        (if (eq (nf-fold (add (nf-fold n) (nf-opp n))) 9) 1 0))
    (defn nf-read (native local remote)
        (list (nf-fold native) (nf-fold local) (nf-fold remote)
              (nf-fold (add native (add local remote)))))
    0)
