; form-cli-bootstrap-emit-cli.fk — emit the self-contained native form-cli.
;
; The complete flattened body crosses through read_file as data.  The path
; arrives on stdin, keeping both the path and the 2.5 MiB table out of this
; source cell.  That makes this one fixed cell cacheable while still allowing
; an unpublished candidate table to be emitted atomically.
;
; preludes: form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/host-io-fs-fkwu-emit.fk form-stdlib/fkc-table-serialize.fk form-stdlib/hati-os-kernel-emit.fk

(do
    ; Optional serializer door: present for eager fkwu name resolution; this
    ; emission lane never invokes it.
    (defn form_table_text (roots rows) "")

    (defn fcbe-table-stop-at (table n)
        (if (eq n 0) 0
            (do (let b (str_byte_at table (sub n 1)))
                (if (or (eq b 10) (eq b 13))
                    (fcbe-table-stop-at table (sub n 1))
                    n))))
    (defn fcbe-table-stop (table)
        (fcbe-table-stop-at table (str_len table)))
    (defn fcbe-print-table-chunks (table at stop)
        (if (ge at stop) 0
            (do (let candidate (add at 16384))
                (let end (if (lt candidate stop) candidate stop))
                (let written (print_str
                    (str_concat "\"" (str_concat (substring table at end) "\""))))
                (fcbe-print-table-chunks table end stop))))

    (let table-path (read_line))
    (let table (read_file table-path))
    (let p0 (print_str (fkc-pr-text)))
    (let p1 (print_str (fkc-decl-universal-text)))
    (let p2 (print_str (fkc-typed-stdout-text)))
    (let p3 (print_str (fkc-walk-many-text)))
    (let p4 (print_str "static const char fk_prog[] ="))
    (let p5 (fcbe-print-table-chunks table 0 (fcbe-table-stop table)))
    (let tail (fkc-main-baked-repl-tail-text))
    ; Every table chunk is already a closed adjacent C string literal, so the
    ; leading quote used by the monolithic emitter is removed from the tail.
    (let p6 (print_str (substring tail 1 (str_len tail))))
    "")
