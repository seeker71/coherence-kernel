; living-world-composite-answer.fk -- held-out use observes every generated
; composite profile without promoting any generated Recipe to an action.
;
; ONE, NODE, and NOTHING describe immediate output geometry.  Sender-authored
; timeout condensation remains a separate observation.  Alternatives,
; unknowable remainder, choice, and timeout are independently optional.
;
; witnessed: 2026-08-07 -> answer band 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk form-stdlib/living-world-composite-recipe.fk

(let LWOEC-QUERY       (bp "LWOEC-QUERY"))
(let LWOEC-QUERY-EVAL  (bp "LWOEC-QUERY-EVAL"))
(let LWOEC-ANSWER      (bp "LWOEC-ANSWER"))

; children: integrated composite field, opaque-role values, alternatives,
;           optional unknown/choice/timeout, evidence, local path
(defn lwoec-query
    (candidate values alternatives unknown choice timeout evidence)
    (intern_node LWOEC-QUERY
        (list candidate values alternatives unknown choice timeout evidence
              (lwo-local-path))))
(defn lwoec-query? (cell) (lwo-category? cell LWOEC-QUERY))
(defn lwoec-query-candidate (query) (nth (node_children query) 0))
(defn lwoec-query-values (query) (nth (node_children query) 1))
(defn lwoec-query-alternatives (query) (nth (node_children query) 2))
(defn lwoec-query-unknown (query) (nth (node_children query) 3))
(defn lwoec-query-choice (query) (nth (node_children query) 4))
(defn lwoec-query-timeout (query) (nth (node_children query) 5))
(defn lwoec-query-evidence (query) (nth (node_children query) 6))
(defn lwoec-query-path (query) (nth (node_children query) 7))
(defn lwoec-query-valid? (query)
    (if (eq (lwoec-query? query) 0) 0
        (if (eq (lwoec-candidate?
                    (lwoec-query-candidate query)) 0) 0
            (if (eq (lwo-category?
                        (lwoec-query-values query) LWO-FIELD) 0) 0
                (if (eq (lwoe-values-valid-items?
                            (lwo-field-items
                                (lwoec-query-values query))) 0) 0
                    (if (eq (lwo-category?
                                (lwoec-query-alternatives query)
                                LWO-FIELD) 0) 0
                        (if (eq (lwph-optional-unknown-valid?
                                    (lwoec-query-unknown query)) 0) 0
                            (if (eq (lwlc-choice-valid?
                                        (lwoec-query-choice query)) 0) 0
                                (lwac-optional-timeout-valid?
                                    (lwoec-query-timeout query))))))))))
(defn lwoec-query-profiles-complete? (items values)
    (if (eq (len items) 0) 1
        (do
            (let surface (lwoec-profile-surface (head items)))
            (let blueprint (lwoec-surface-blueprint surface))
            (let carrier
                (lwoe-profile-carrier
                    (lwoec-surface-component-profile surface)))
            (if (eq (lwsr-application-complete-items?
                        (lwsr-role-items (lwoe-carrier-roles carrier))
                        (list) (lwoec-blueprint-codecs blueprint) values) 1)
                (lwoec-query-profiles-complete? (tail items) values) 0))))
(defn lwoec-query-current? (world query threshold)
    (if (or (le threshold 0)
            (eq (lwoec-query-valid? query) 0)) 0
        (do
            (let candidate (lwoec-query-candidate query))
            (let field (lwo-emergent-shape candidate))
            (if (and (eq (lwoec-integrated-current?
                             world candidate) 1)
                     (and (eq (lwo-active? world query) 1)
                          (and (ge (lwph-active-source-count
                                     world query) threshold)
                               (and (eq (lwoe-values-current-items?
                                          world
                                          (lwo-field-items
                                            (lwoec-query-values query))) 1)
                                    (eq (lwoec-query-profiles-complete?
                                          (lwo-field-items
                                            (lwoec-field-compatible field))
                                          (lwoec-query-values query)) 1)))))
                1 0))))

; children: exact composite profile, generated Recipe, bindings, output,
;           local path
(defn lwoec-query-eval (profile recipe bindings output)
    (intern_node LWOEC-QUERY-EVAL
        (list profile recipe bindings output (lwo-local-path))))
(defn lwoec-query-eval? (cell) (lwo-category? cell LWOEC-QUERY-EVAL))
(defn lwoec-query-eval-profile (evaluation)
    (nth (node_children evaluation) 0))
(defn lwoec-query-eval-recipe (evaluation)
    (nth (node_children evaluation) 1))
(defn lwoec-query-eval-bindings (evaluation)
    (nth (node_children evaluation) 2))
(defn lwoec-query-eval-output (evaluation)
    (nth (node_children evaluation) 3))
(defn lwoec-query-evaluate-items (items values field)
    (if (eq (len items) 0) field
        (do
            (let profile (head items))
            (let surface (lwoec-profile-surface profile))
            (let component
                (lwoec-surface-component-profile surface))
            (let carrier (lwoe-profile-carrier component))
            (let blueprint (lwoec-surface-blueprint surface))
            (let recipe (lwoec-surface-recipe surface))
            (let bindings
                (lwoe-bindings-for carrier
                    (lwoec-blueprint-codecs blueprint) values))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe bindings)))
            (lwoec-query-evaluate-items (tail items) values
                (lwo-field-add field
                    (lwoec-query-eval profile recipe bindings output))))))
(defn lwoec-query-output-items (items field)
    (if (eq (len items) 0) field
        (lwoec-query-output-items (tail items)
            (lwo-field-add field
                (lwoec-query-eval-output (head items))))))
(defn lwoec-answer-immediate (outputs)
    (if (eq (lwo-field-size outputs) 0) (oac-nothing)
        (if (eq (lwo-field-size outputs) 1)
            (oac-one (head (lwo-field-items outputs)))
            (oac-node outputs))))
(defn lwoec-answer-time (query observed-time)
    (if (or (node_eq
              (lwoec-query-timeout query) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwoec-query-timeout query) observed-time)))
(defn lwoec-answer-witnesses (world query)
    (do
        (let candidate (lwoec-query-candidate query))
        (let with-candidate
            (lwoec-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world candidate))
                (lwo-emergent-witnesses candidate)))
        (let with-query
            (lwoec-attributions world query with-candidate))
        (lwsr-codec-value-witnesses world
            (lwo-field-items (lwoec-query-values query)) with-query)))

; children: exact query, every compatible evaluation, unique outputs,
;           immediate ack, separate time observation, alternatives, unknowns,
;           witnesses, observed time, threshold, local path
(defn lwoec-answer
    (query evaluations outputs immediate time alternatives unknowns witnesses
     observed-time threshold)
    (intern_node LWOEC-ANSWER
        (list query evaluations outputs immediate time alternatives unknowns
              witnesses observed-time (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwoec-answer? (cell) (lwo-category? cell LWOEC-ANSWER))
(defn lwoec-answer-query (answer) (nth (node_children answer) 0))
(defn lwoec-answer-evaluations (answer) (nth (node_children answer) 1))
(defn lwoec-answer-outputs (answer) (nth (node_children answer) 2))
(defn lwoec-answer-immediate-ack (answer) (nth (node_children answer) 3))
(defn lwoec-answer-time-observation (answer) (nth (node_children answer) 4))
(defn lwoec-answer-alternatives (answer) (nth (node_children answer) 5))
(defn lwoec-answer-unknowns (answer) (nth (node_children answer) 6))
(defn lwoec-answer-witnesses-field (answer) (nth (node_children answer) 7))
(defn lwoec-answer-observed-time (answer) (nth (node_children answer) 8))
(defn lwoec-answer-threshold (answer)
    (node_value (nth (node_children answer) 9)))
(defn lwoec-answer-path (answer) (nth (node_children answer) 10))
(defn lwoec-answer-for (world query threshold observed-time)
    (if (eq (lwoec-query-current?
                world query threshold) 0) (lwo-none)
        (do
            (let candidate (lwoec-query-candidate query))
            (let field (lwo-emergent-shape candidate))
            (let evaluations
                (lwoec-query-evaluate-items
                    (lwo-field-items
                        (lwoec-field-compatible field))
                    (lwoec-query-values query) (lwo-empty-field)))
            (let outputs
                (lwoec-query-output-items
                    (lwo-field-items evaluations) (lwo-empty-field)))
            (let alternatives
                (lwoec-union-items
                    (lwo-field-items
                        (lwoec-field-alternatives field))
                    (lwoec-query-alternatives query)))
            (let unknowns
                (lwo-field-add
                    (lwoec-union-items
                        (lwo-field-items
                            (lwoec-field-unknowns field))
                        (if (node_eq
                              (lwoec-query-unknown query) (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwoec-query-unknown query))))
                    (lwlc-unknown outputs)))
            (lwoec-answer query evaluations outputs
                (lwoec-answer-immediate outputs)
                (lwoec-answer-time query observed-time)
                alternatives unknowns
                (lwoec-answer-witnesses world query)
                observed-time threshold))))
(defn lwoec-answer-current? (world answer)
    (if (eq (lwoec-answer? answer) 0) 0
        (node_eq answer
            (lwoec-answer-for world
                (lwoec-answer-query answer)
                (lwoec-answer-threshold answer)
                (lwoec-answer-observed-time answer)))))

0
