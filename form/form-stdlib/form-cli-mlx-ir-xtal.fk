; form-cli-mlx-ir.fk — MLX shapes as Form trees, not kernel C ops.
;
; Yes asked to leave predetermined mlx_add behind: generate, intern, learn,
; adapt. A node is (c v) or (op left right). Emit is postfix. mlx_run is
; the one door. mul and compose are recipes; they have no C opcode.
;
; Authority is this section. Crystallize with form-cli-mlx-ir-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-mlx-ir-band.fk
; witnessed: 2026-08-20 -> 255

(do (defn mlg-c (v) (list "c" v)) (defn mlg-op (name a b) (list name a b)) (defn mlg-atom (n) (if (str_eq (nth n 0) "c") 1 0)) (defn mlg-spc () " ") (defn mlg-emit (n) (if (eq (mlg-atom n) 1) (int_to_str (nth n 1)) (str_concat (mlg-emit (nth n 1)) (str_concat (mlg-spc) (str_concat (mlg-emit (nth n 2)) (str_concat (mlg-spc) (nth n 0))))))) (defn mlg-add2 () (mlg-op "add" (mlg-c 2) (mlg-c 3))) (defn mlg-mul2 () (mlg-op "mul" (mlg-c 2) (mlg-c 3))) (defn mlg-times4 () (mlg-op "mul" (mlg-add2) (mlg-c 4))) (defn mlg-has (book name) (if (eq (len book) 0) 0 (if (str_eq (head book) name) 1 (mlg-has (tail book) name)))) (defn mlg-learn (book name) (if (eq (mlg-has book name) 1) book (cons name book))) (defn mlg-seed () (list "add")) (defn mlg-after () (mlg-learn (mlg-learn (mlg-seed) "mul") "sub")) (defn mlg-check () (add (if (str_eq (mlg-emit (mlg-add2)) "2 3 add") 1 0) (add (if (str_eq (mlg-emit (mlg-mul2)) "2 3 mul") 2 0) (add (if (str_eq (mlg-emit (mlg-times4)) "2 3 add 4 mul") 4 0) (add (if (eq (mlg-has (mlg-seed) "mul") 0) 8 0) (add (if (eq (mlg-has (mlg-after) "mul") 1) 16 0) (if (eq (len (mlg-after)) 3) 32 0))))))) 0)
