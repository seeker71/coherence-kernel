; form-nodeid-knowledge-query-run.fk -- read-only live witness against the
; persisted public-source concept shard registry.
;
; The offered local-stream surface contains only a concept coordinate.  Any
; source path printed below was resolved by the registry, not supplied by the
; caller.  This driver performs filesystem effects and is intentionally not a
; preflight target.
;
; PROOF LEVEL: FOURTH-ARM ONLY (persisted registry + current source bytes; print_str pf-arm-mask 8, probed 2026-09-03)
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-source-search.fk
; preludes: form-stdlib/form-cli-heed-current-source.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/public-source-concept-shards.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk

(do
    (defn fknqrr-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))
    (defn fknqrr-int (name value) (fknqrr-line name (int_to_str value)))

    (let surface (fknq-concept-surface "defn-psci-schema"))
    (let result (fknq-execute-at "." (fknq-default-artifact) surface 0
        (fknq-max-frame-bytes)))
    (fknqrr-line "surface" surface)
    (fknqrr-line "status" (fknq-status result))
    (fknqrr-line "reason" (fknq-reason result))
    (fknqrr-line "source-node" (fknq-node-key (fknq-source-original-of result)))
    (fknqrr-line "entry-node" (fknq-node-key (fknq-entry-original-of result)))
    (fknqrr-line "bridge-source-node" (fknq-node-key (fknq-source result)))
    (fknqrr-line "bridge-entry-node" (fknq-node-key (fknq-entry result)))
    (fknqrr-line "request-node" (fknq-node-key (fknq-request result)))
    (fknqrr-line "executor-node" (fknq-node-key (fknq-executor result)))
    (fknqrr-line "observation-node" (fknq-node-key (fknq-observation result)))
    (fknqrr-line "current-observation-node"
        (fknq-node-key (fknq-existing-current-observation result)))
    (fknqrr-line "resolved-source-path" (fknq-source-path result))
    (fknqrr-line "trace" (fknq-trace-actions (fknq-trace result)))
    (fknqrr-int "fresh" (fknq-fresh? result))
    (fknqrr-int "rebuild-needed" (fknq-rebuild? result))
    (fknqrr-int "lookup-count" (fknq-lookup-count result))
    (fknqrr-int "hit-count" (fknq-hit-count result))
    (fknqrr-int "executed" (fknq-executed? result))
    (fknqrr-int "model-executed" (fknq-model-executed? result))
    (fknqrr-int "pretokenized" (fknq-pretokenized? result))
    (fknqrr-int "scannerless" (fknq-scannerless? result))
    (fknqrr-int "caller-supplied-path"
        (if (and (gt (str_len (fknq-source-path result)) 0)
                 (ge (str_find surface (fknq-source-path result) 0) 0)) 1 0))
    0)
