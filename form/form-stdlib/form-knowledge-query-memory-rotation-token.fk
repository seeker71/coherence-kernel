; form-knowledge-query-memory-rotation-token.fk -- a small resident walker
; boundary for answer-free memory rotation recipe data.
;
; The temporary C source seed has a fixed function arena.  This cell does not
; turn that arena into an architectural limit: the reusable walker stays small,
; while each learned movement arrives as content-addressed recipe/request data.
; A carrier can inspect the NodeID children, generate its needed source/JIT path
; on demand, and return a content-addressed choice without importing the whole
; curriculum or evaluation closure into its resident image.
;
; The recipe binds memory, rollback, offer, source, question, query, lane and
; provenance.  It contains no answer.  The request binds the existing action
; identity 31.2.0.109 and records scannerless=1, pretokenized=0.  The choice
; preserves keep, undo, timeout and cut; value-present is independent from a
; generated count of 0 or 1; malformed input stays exact nothing.
;
; No model call, execution, JIT, registry, operations table, flattening, file
; access, or C growth occurs here.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-knowledge-query-memory-rotation-token-band.fk

(do
    (defn fkqmrt-plan-schema ()
        "form-knowledge-query-memory-rotation-plan-v1")
    (defn fkqmrt-recipe-schema ()
        "form-knowledge-query-memory-rotation-recipe-v1")
    (defn fkqmrt-request-schema ()
        "form-knowledge-query-memory-rotation-request-v1")
    (defn fkqmrt-action-node () (make_nodeid 31 2 0 109))
    ; 127 is the bounded query-memory data cell; its executable projection,
    ; request and returned choice occupy the next three distinct identities.
    (defn fkqmrt-recipe-category () (make_nodeid 31 2 0 128))
    (defn fkqmrt-request-category () (make_nodeid 31 2 0 129))
    (defn fkqmrt-choice-category () (make_nodeid 31 2 0 130))
    (defn fkqmrt-bit? (x) (if (or (eq x 0) (eq x 1)) 1 0))
    (defn fkqmrt-signal? (signal)
        (if (or (str_eq signal "keep") (str_eq signal "undo")) 1
            (if (or (str_eq signal "timeout") (str_eq signal "cut")) 1 0)))

    ; plan positions are defined by the rotation organ.  The small walker asks
    ; only for the identities and credits necessary to make the token honest.
    (defn fkqmrt-plan-shaped? (plan)
        (if (or (nothing? plan) (not (eq (len plan) 25))) 0
            (if (not (str_eq (nth plan 0) (fkqmrt-plan-schema))) 0
            (if (or (nothing? (nth plan 1)) (nothing? (nth plan 3))) 0
            (if (nothing? (nth plan 15)) 0
            (if (not (eq (nth plan 17) 1)) 0
            (if (not (eq (nth plan 18) 1)) 0
            (if (not (eq (nth plan 19) 0)) 0
            (if (not (eq (nth plan 20) 0)) 0
            (if (not (eq (nth plan 21) 0)) 0
                (if (eq (nth plan 22) 0) 1 0)))))))))))

    (defn fkqmrt-recipe (plan)
        (if (not (eq (fkqmrt-plan-shaped? plan) 1)) (nothing)
            (intern_node (fkqmrt-recipe-category)
                (list
                    (intern_trivial_string (fkqmrt-recipe-schema))
                    (nth plan 1)
                    (nth plan 3)
                    (nth plan 15)
                    (intern_trivial_string (nth plan 5))
                    (intern_trivial_string (nth plan 11))
                    (intern_trivial_string (nth plan 12))
                    (intern_trivial_string (nth plan 14))
                    (intern_trivial_string (nth plan 6))
                    (intern_trivial_string (nth plan 8))
                    (intern_trivial_int (nth plan 17))
                    (intern_trivial_int (nth plan 18))
                    (intern_trivial_int (nth plan 19))
                    (intern_trivial_int (nth plan 20))
                    (intern_trivial_int (nth plan 21))
                    (intern_trivial_int (nth plan 22))))))
    (defn fkqmrt-recipe-valid? (recipe plan)
        (if (or (nothing? recipe) (nothing? plan)) 0
            (if (not (node_eq (node_category recipe)
                              (fkqmrt-recipe-category))) 0
                (node_eq recipe (fkqmrt-recipe plan)))))

    (defn fkqmrt-request-token (plan)
        (do
            (let recipe (fkqmrt-recipe plan))
            (if (nothing? recipe) (nothing)
                (intern_node (fkqmrt-request-category)
                    (list
                        (intern_trivial_string (fkqmrt-request-schema))
                        (fkqmrt-action-node)
                        recipe
                        (nth plan 1)
                        (nth plan 3)
                        (intern_trivial_string (nth plan 6))
                        (intern_trivial_string (nth plan 8))
                        (intern_trivial_int 0)
                        (intern_trivial_int 1))))))
    (defn fkqmrt-request-valid? (request plan)
        (if (or (nothing? request) (nothing? plan)) 0
            (if (not (node_eq (node_category request)
                              (fkqmrt-request-category))) 0
                (node_eq request (fkqmrt-request-token plan)))))

    (defn fkqmrt-next-node-valid? (plan signal next-node)
        (if (str_eq signal "undo")
            (node_eq next-node (nth plan 3))
            (node_eq next-node (nth plan 1))))
    (defn fkqmrt-signal-state-valid?
        (signal timeout state-release residence-release)
        (if (str_eq signal "timeout")
            (eq timeout 1)
        (if (str_eq signal "cut")
            (if (and (eq timeout 0)
                     (or (eq state-release 0)
                         (eq residence-release 0))) 1 0)
            (if (and (eq timeout 0)
                     (and (eq state-release 1)
                          (eq residence-release 1))) 1 0))))

    (defn fkqmrt-choice-token
        (plan signal next-node generated present timeout state-release
         residence-release)
        (if (not (eq (fkqmrt-plan-shaped? plan) 1)) (nothing)
        (if (not (eq (fkqmrt-signal? signal) 1)) (nothing)
        (if (nothing? next-node) (nothing)
        (if (lt generated 0) (nothing)
        (if (not (eq present 1)) (nothing)
        (if (not (eq (fkqmrt-bit? timeout) 1)) (nothing)
        (if (not (eq (fkqmrt-bit? state-release) 1)) (nothing)
        (if (not (eq (fkqmrt-bit? residence-release) 1)) (nothing)
        (if (not (eq (fkqmrt-next-node-valid? plan signal next-node) 1))
            (nothing)
        (if (not (eq (fkqmrt-signal-state-valid? signal timeout
                          state-release residence-release) 1))
            (nothing)
            (intern_node (fkqmrt-choice-category)
                (list
                    (fkqmrt-request-token plan)
                    (intern_trivial_string signal)
                    next-node
                    (nth plan 1)
                    (nth plan 3)
                    (intern_trivial_int generated)
                    (intern_trivial_int present)
                    (intern_trivial_int timeout)
                    (intern_trivial_int state-release)
                    (intern_trivial_int residence-release))))))))))))))
    (defn fkqmrt-choice-token-signal (token)
        (if (nothing? token) (nothing)
            (node_value (nth (node_children token) 1))))
    (defn fkqmrt-choice-token-node (token)
        (if (nothing? token) (nothing)
            (nth (node_children token) 2)))
    (defn fkqmrt-choice-token-generated (token)
        (if (nothing? token) (nothing)
            (node_value (nth (node_children token) 5))))
    (defn fkqmrt-choice-token-present? (token)
        (if (nothing? token) 0
            (node_value (nth (node_children token) 6))))
    0)
