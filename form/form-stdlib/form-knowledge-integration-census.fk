// form-knowledge-integration-census.fk -- honest local Form-knowledge measure.
//
// A prompt prefix, a training-row count, and a paraphrased holdout do not show
// integration.  This cell keeps three denominators visible:
//   1. source files in the scoped body census,
//   2. registered concepts mapped onto those sources,
//   3. independently held-out observations that cross the whole local path.
//
// An observation counts only when ALL of these agree:
//   local model evidence (remote calls 0); a non-paraphrase heldout audit;
//   an emitted Form knowledge-query observation; native token execution bound
//   to the currently accessible registered source; fkwu execution exit 0 with
//   the expected value; and a reasoning key citing the same source. Duplicate observations never raise
//   coverage because the fold walks census concepts and sources, not outputs.
//
// The >=95% verdict additionally requires every scoped source to have at least
// one registered concept and every nonempty source family to meet 95%.  A large
// family therefore cannot hide an untouched small family.
//
// The live seed registry below is deliberately only a cross-family beginning.
// It does NOT close the live census and no live model observations are supplied,
// so the live run honestly reports ready95=0.  The band proves the gate can pass
// at exactly 95%, and proves leakage, missing lookup, execution, reasoning,
// registry, duplicate, and family-blindness failures change the verdict.
//
// Authority: form/form-stdlib/bml/form-knowledge-integration-census.bml
// preludes: form-stdlib/core.fk
// preludes: form-stdlib/form-knowledge-query-token.fk
// preludes: form-stdlib/form-knowledge-source-search.fk
// Proven by: form-stdlib/tests/form-knowledge-integration-census-band.fk
// witnessed: 2026-09-29 -> band 1048575; live repository-ready95 0, current access 100 percent
section [form.bml] {
    def fki-threshold-percent() = 95;
    def fki-evidence-basis() = "current-source+source-artifact-sha256+grounded-nodeid-rag+provenance+prefix+weights-v1";
    // ---- scope and live source census -----------------------------------
    def fki-family(id, root) = ["knowledge-family-v1", id, root];
    def fki-family-id(f) = f[1];
    def fki-family-root(f) = f[2];
    def fki-families() = [fki-family("axioms", "axioms"), fki-family("bootstrap", "bootstrap"), fki-family("form-stdlib", "form/form-stdlib"), fki-family("grammars", "grammars"), fki-family("cognition", "cognition"), fki-family("learn", "learn"), fki-family("observe", "observe"), fki-family("teachings", "teachings"), fki-family("receipts", "receipts"), fki-family("model", "model"), fki-family("proof", "proof"), fki-family("control", "control"), fki-family("ingest", "ingest"), fki-family("presence", "presence"), fki-family("docs", "docs")];
    def fki-ends-with?(s, suffix) = str_len(s) < str_len(suffix) ? 0 : (String) substring(s, str_len(s) - str_len(suffix), str_len(s)) == suffix ? 1 : 0;
    def fki-hidden-name?(name) = (Comparable) str_len(name) == 0 ? 1 : (String) substring(name, 0, 1) == "." ? 1 : 0;
    def fki-dir?(path) = len(fs_list(path)) > 0 ? 1 : 0;
    def fki-source-extension?(path) = (Comparable) fki-ends-with?(path, ".fk") == 1 || ((Comparable) fki-ends-with?(path, ".bml") == 1 || ((Comparable) fki-ends-with?(path, ".bmf") == 1 || ((Comparable) fki-ends-with?(path, ".form") == 1 || (Comparable) fki-ends-with?(path, ".md") == 1))) ? 1 : 0;
    def fki-generated-source?(path) =     // Crystallized mirrors are executable caches of a higher authority,
    // not additional knowledge units.
(Comparable) fki-ends-with?(path, "-xtal.fk") == 1 ? 1 : 0;
    def fki-source-path?(path) = (Comparable) fki-source-extension?(path) == 1 && (Comparable) fki-generated-source?(path) == 0 ? 1 : 0;
    def fki-collect-paths-loop(dir, names, acc) = (Comparable) len(names) == 0 ? acc : {
        let name = head(names);
        let path = str_concat(dir, str_concat("/", name));
        fki-collect-paths-loop(dir, tail(names), (Comparable) fki-hidden-name?(name) == 1 ? acc : (Comparable) fki-dir?(path) == 1 ? fki-collect-paths-loop(path, fs_list(path), acc) : (Comparable) fki-source-path?(path) == 1 ? cons(path, acc) : acc);
    };
    def fki-collect-paths(root) = fki-collect-paths-loop(root, fs_list(root), empty());
    // The access mark is deliberately not called a cryptographic signature: it
    // proves the source is readable now and catches ordinary stale/truncated
    // rows (size plus boundary bytes), but a same-size interior rewrite needs
    // the query organ's content-ref/source-key freshness evidence.
    def fki-source-access-mark(path) = {
        let n = file_size(path);
        n <= 0 ? ["source-access-mark-v1", 0, 0, 0] : ["source-access-mark-v1", n, str_byte_at(read_file_slice(path, 0, 1), 0), str_byte_at(read_file_slice(path, n - 1, 1), 0)];
    };
    def fki-source(path, family) = ["knowledge-source-v1", path, family, fki-source-access-mark(path)];
    def fki-source-path(s) = s[1];
    def fki-source-family(s) = s[2];
    def fki-source-access-mark-of(s) = s[3];
    def fki-source-current-access?(s) = !((Comparable) len(s) == 4) ? 0 : {
        let held = fki-source-access-mark-of(s);
        let now = fki-source-access-mark(fki-source-path(s));
        held[1] > 0 && ((Comparable) held[1] == now[1] && ((Comparable) held[2] == now[2] && (Comparable) held[3] == now[3])) ? 1 : 0;
    };
    def fki-source-units-loop(paths, family, acc) = (Comparable) len(paths) == 0 ? acc : fki-source-units-loop(tail(paths), family, cons(fki-source(head(paths), family), acc));
    def fki-live-source-units-loop(families, acc) = (Comparable) len(families) == 0 ? acc : {
        let family = head(families);
        let next = fki-source-units-loop(fki-collect-paths(fki-family-root(family)), fki-family-id(family), acc);
        fki-live-source-units-loop(tail(families), next);
    };
    def fki-live-source-units() = fki-live-source-units-loop(fki-families(), empty());
    // ---- concept registry ------------------------------------------------
    def fki-concept(id, family, source-path) = ["knowledge-concept-v1", id, family, source-path];
    def fki-concept-id(c) = c[1];
    def fki-concept-family(c) = c[2];
    def fki-concept-source-path(c) = c[3];
    // A cross-family seed, explicitly not a claim of registry closure.
    def fki-seed-concepts() = list(fki-concept("nothing-is-whole", "axioms", "axioms/core-axioms.form"), fki-concept("direct-source-ground", "bootstrap", "bootstrap/ground.fk"), fki-concept("one-form-kernel", "form-stdlib", "form/form-stdlib/core.fk"), fki-concept("grammar-loader", "grammars", "grammars/grammar-loader.fk"), fki-concept("frequency-attunement", "cognition", "cognition/text-frequency.fk"), fki-concept("distillation-ontogeny", "learn", "learn/homecoming-distillation-corpus.fk"), fki-concept("preflight-before-verdict", "observe", "observe/preflight.fk"), fki-concept("service-over-engagement", "teachings", "teachings/uplifting-dialogue.md"), fki-concept("share-is-computed", "receipts", "receipts/2026-08-23-share-is-computed-apply-is-one.md"), fki-concept("form-neutral-token-space", "model", "model/form-neutral-token-space.fk"), fki-concept("four-way-witness", "proof", "proof/four-way-run-recipe42.fk"), fki-concept("choice-is-consent", "control", "control/choice-lane-core.fk"), fki-concept("name-build-observe", "ingest", "ingest/name-build-observe.fk"), fki-concept("equivalent-source-storage", "form-stdlib", "form/form-stdlib/form-knowledge-ingest-public-curriculum.fk"), fki-concept("knowledge-depth-threshold", "form-stdlib", "form/form-stdlib/form-knowledge-ingest-public-curriculum.fk"), fki-concept("inquiry-planes", "presence", "presence/inquiry-planes.fk"), fki-concept("live-dynamic-diagnostics", "docs", "docs/live-dynamic-diagnostics.md"),     // rows registered 2026-08-24 by the sitting that wrote and witnessed
    // their sources on this branch — each concept names one teaching the
    // cell carries, not merely the cell:
fki-concept("seal-keyed-derivation", "form-stdlib", "form/native/metal/qwen35-crystal.fk"), fki-concept("ice-priced-out-by-string-law", "form-stdlib", "form/form-stdlib/qwen35-tokfast-v2.fk"), fki-concept("occupancy-hole", "receipts", "receipts/2026-08-24-twenty-four-threads-held-the-attention.md"), fki-concept("reuse-beats-optimization", "receipts", "receipts/2026-08-24-reuse-instead-of-double-spending.md"), fki-concept("choice-cut-undo-observable", "receipts", "receipts/2026-08-24-reuse-instead-of-double-spending.md"), fki-concept("delta-ids-continuation", "receipts", "receipts/2026-08-24-reuse-instead-of-double-spending.md"), fki-concept("radius-bound-inherited", "receipts", "receipts/2026-08-24-the-bound-inherited-and-the-ice-that-waits.md"), fki-concept("visit-count-testifies", "receipts", "receipts/2026-08-24-the-program-was-nineteen-times-larger.md"));
    def fki-find-concept(id, concepts) = (Comparable) len(concepts) == 0 ? empty() : (String) fki-concept-id(head(concepts)) == id ? head(concepts) : fki-find-concept(id, tail(concepts));
    def fki-source-member?(path, family, sources) = (Comparable) len(sources) == 0 ? 0 : (String) fki-source-path(head(sources)) == path && (String) fki-source-family(head(sources)) == family ? 1 : fki-source-member?(path, family, tail(sources));
    def fki-find-source(path, family, sources) = (Comparable) len(sources) == 0 ? empty() : (String) fki-source-path(head(sources)) == path && (String) fki-source-family(head(sources)) == family ? head(sources) : fki-find-source(path, family, tail(sources));
    def fki-current-source-member?(path, family, sources) = {
        let s = fki-find-source(path, family, sources);
        (Comparable) len(s) == 0 ? 0 : fki-source-current-access?(s);
    };
    def fki-current-source-path-member?(path, sources) = (Comparable) len(sources) == 0 ? 0 : (String) fki-source-path(head(sources)) == path && (Comparable) fki-source-current-access?(head(sources)) == 1 ? 1 : fki-current-source-path-member?(path, tail(sources));
    def fki-concept-member?(id, family, path, concepts) = {
        let c = fki-find-concept(id, concepts);
        (Comparable) len(c) == 0 ? 0 : (String) fki-concept-family(c) == family && (String) fki-concept-source-path(c) == path ? 1 : 0;
    };
    // ---- observation adapter for the Form-native stream-token organ ------
    // The query-token ABI has its own cell and adversarial proof band.  This
    // census does not invent a second envelope or execute a second lookup.  It
    // consumes a stable observation-shaped adapter so that the token organ may
    // evolve concurrently without making its evidence disappear into prose.
    // Hold the completed fkqt ABI whole: the exact emitted surface and typed
    // 20-field result.  Accessors below are owned by the query-token cell.
    def fki-query-observation(surface, fkqt-result) = ["form-query-observation-v1", surface, fkqt-result];
    def fki-query-grounded?(q, source-path) = !((Comparable) len(q) == 3) ? 0 : {
        let surface = q[1];
        let result = q[2];
        let request = fkqt-parse(surface);
        (String) q[0] == "form-query-observation-v1" && ((Comparable) fkqt-request-ready?(request) == 1 && ((String) fkqt-status(result) == "hit" && ((Comparable) ric-node-id-valid?(fkqt-source-ref(result)) == 1 && ((Comparable) ric-node-id-valid?(fkqt-content-ref(result)) == 1 && ((String) fkqt-source-path(result) == source-path && ((Comparable) fkqt-executed?(result) == 1 && ((Comparable) fkqt-model-executed?(result) == 0 && ((Comparable) fkqt-lookup-count(result) == 1 && ((Comparable) fkqt-hit-count(result) == 1 && (node_eq(fkqt-request-token(request), fkqt-result-request-token(result)) && node_eq(fkqt-executor(result), fkqt-executor-token()))))))))))) ? 1 : 0;
    };
    def fki-query-provenance?(q, source-path) = (Comparable) fki-query-grounded?(q, source-path) == 0 ? 0 : {
        let result = q[2];
        let checks = [(Comparable) str_len(fkqt-source-key(result)) == 64 ? 1 : 0, hex-valid?(fkqt-source-key(result)), (Comparable) str_len(fkqt-answer-key(result)) == 64 ? 1 : 0, hex-valid?(fkqt-answer-key(result)), (String) fkqt-source-path(result) == source-path ? 1 : 0];
        (Comparable) sum(checks) == 5 ? 1 : 0;
    };
    def fki-query-observation-valid?(q, source-path) = (Comparable) fki-query-grounded?(q, source-path) == 1 && (Comparable) fki-query-provenance?(q, source-path) == 1 ? 1 : 0;
    // ---- current-source artifact stream, separate from NodeID RAG -------
    // This lane proves current path + fresh Form SHA-256 + bounded answer
    // provenance.  It fabricates no REF/CTOR and carries no claim about model
    // reasoning, prefix exposure, or learned weights.
    def fki-source-artifact-full-path(root, result) = fs-path-join(root, fkss-source-path(result));
    def fki-source-artifact-id-shape?(source-id) = !((Comparable) str_len(source-id) == 71) ? 0 : !((String) substring(source-id, 0, 7) == "sha256:") ? 0 : hex-valid?(substring(source-id, 7, 71));
    def fki-any-atom-in-answer?(atoms, answer) = (Comparable) len(atoms) == 0 ? 0 : fkss-find-ci(answer, head(atoms)) >= 0 ? 1 : fki-any-atom-in-answer?(tail(atoms), answer);
    def fki-source-artifact-expected-answer(full-path, first) = {
        let size = file_size(full-path);
        let start = fkss-answer-start(first, size);
        fs-read-slice(full-path, start, fkss-min(fkss-answer-limit(), size - start));
    };
    def fki-source-artifact-current?(root, atoms, result) = (Comparable) str_len(root) == 0 || (Comparable) fkss-query-valid?(atoms) == 0 ? 0 : {
        let full-path = fki-source-artifact-full-path(root, result);
        let source-id = fkss-source-id-of(result);
        let expected-answer = file_size(full-path) > 0 ? fki-source-artifact-expected-answer(full-path, fkss-first-offset(result)) : "";
        let checks = [(String) fkss-status(result) == "hit" ? 1 : 0, (String) fkss-reason(result) == "current-source-match" ? 1 : 0, (String) result[3] == "source-artifact-stream-v1" ? 1 : 0, file_size(full-path) > 0 ? 1 : 0, fki-source-artifact-id-shape?(source-id), (String) source-id == fkss-source-id(full-path) ? 1 : 0, fkss-matched(result) > 0 ? 1 : 0, fkss-first-offset(result) >= 0 && fkss-first-offset(result) < file_size(full-path) ? 1 : 0, str_len(fkss-answer(result)) > 0 && str_len(fkss-answer(result)) <= fkss-answer-limit() ? 1 : 0, (String) fkss-answer(result) == expected-answer ? 1 : 0, fki-any-atom-in-answer?(atoms, fkss-answer(result)), fkss-eligible-count(result) > 0 && (Comparable) fkss-accessible-count(result) == fkss-eligible-count(result) ? 1 : 0, (Comparable) fkss-coverage-percent(result) == 100 ? 1 : 0, (String) fkss-result-route(result) == "source_inventory+bounded-byte-window+form-sha256-stream" ? 1 : 0, (Comparable) fkss-model-executed(result) == 0 ? 1 : 0];
        (Comparable) sum(checks) == 15 ? 1 : 0;
    };
    // heldout source-retrieval observation: no model/prefix/reasoning fields.
    def fki-source-retrieval-observation(source-path, concept-id, family, split, leakage-audit, root, atoms, result, witness-id) = ["source-retrieval-observation-v1", source-path, concept-id, family, split, leakage-audit, root, atoms, result, witness-id];
    def fki-source-retrieval-observation-valid?(o, sources, concepts) = !((Comparable) len(o) == 10) ? 0 : {
        let path = o[1];
        let id = o[2];
        let family = o[3];
        let root = o[6];
        let atoms = o[7];
        let result = o[8];
        let checks = [(String) o[0] == "source-retrieval-observation-v1" ? 1 : 0, fki-current-source-member?(path, family, sources), fki-concept-member?(id, family, path, concepts), (String) o[4] == "heldout" ? 1 : 0, fki-leakage-audit-valid?(o[5]), (String) path == fki-source-artifact-full-path(root, result) ? 1 : 0, fki-source-artifact-current?(root, atoms, result), str_len(o[9]) > 0 ? 1 : 0];
        (Comparable) sum(checks) == 8 ? 1 : 0;
    };
    // ---- heldout evidence rows -----------------------------------------
    def fki-leakage-audit(train-hash, heldout-hash, exact-overlap, paraphrase-overlap, common-generator) = ["heldout-leakage-audit-v1", train-hash, heldout-hash, exact-overlap, paraphrase-overlap, common-generator];
    def fki-leakage-audit-valid?(a) = !((Comparable) len(a) == 6) ? 0 : (String) a[0] == "heldout-leakage-audit-v1" && (str_len(a[1]) > 0 && (str_len(a[2]) > 0 && (!((String) a[1] == a[2]) && ((Comparable) a[3] == 0 && ((Comparable) a[4] == 0 && (Comparable) a[5] == 0))))) ? 1 : 0;
    def fki-heldout-family?(name) = (String) name == "counterexample" || ((String) name == "cross-operation" || ((String) name == "novel-program" || (String) name == "adversarial-boundary")) ? 1 : 0;
    def fki-native-execution(carrier, exit-code, actual, expected) = ["form-native-execution-v1", carrier, exit-code, actual, expected];
    def fki-native-execution-valid?(x) = !((Comparable) len(x) == 5) ? 0 : (String) x[0] == "form-native-execution-v1" && ((String) x[1] == "fkwu" && ((Comparable) x[2] == 0 && (Comparable) x[3] == x[4])) ? 1 : 0;
    def fki-reasoning-verdict(actual, expected, citation-path) = ["form-reasoning-verdict-v1", actual, expected, citation-path];
    def fki-reasoning-valid?(r, source-path) = !((Comparable) len(r) == 4) ? 0 : (String) r[0] == "form-reasoning-verdict-v1" && ((String) r[1] == r[2] && (String) r[3] == source-path) ? 1 : 0;
    // Prefix exposure is distinct from RAG and learned weights.  It means the
    // local model actually received the current teaching/query protocol prefix.
    def fki-teaching-exposure(source-path, prefix-node, prefix-bytes, exposed) = ["teaching-prefix-exposure-v1", source-path, prefix-node, prefix-bytes, exposed];
    def fki-teaching-exposure-valid?(t, sources) = !((Comparable) len(t) == 5) ? 0 : (String) t[0] == "teaching-prefix-exposure-v1" && ((Comparable) fki-current-source-path-member?(t[1], sources) == 1 && ((Comparable) ric-node-id-valid?(t[2]) == 1 && (t[3] > 0 && (Comparable) t[4] == 1))) ? 1 : 0;
    // mode is rag or hybrid.  weights-learned is kept as a separate fact: RAG
    // integration must never be reported as a learned tensor delta.
    def fki-local-model-evidence(model-id, locality, remote-calls, output-hash, mode, weights-learned, adaptation-hash, teaching-exposure) = ["local-model-evidence-v1", model-id, locality, remote-calls, output-hash, mode, weights-learned, adaptation-hash, teaching-exposure];
    def fki-local-model-valid?(m) = !((Comparable) len(m) == 9) ? 0 : {
        let weight-shape = (Comparable) m[6] == 0 || (Comparable) m[6] == 1 ? 1 : 0;
        let adaptation-shape = (Comparable) m[6] == 1 ? str_len(m[7]) > 0 ? 1 : 0 : (String) m[7] == "none" ? 1 : 0;
        let checks = [(String) m[0] == "local-model-evidence-v1" ? 1 : 0, str_len(m[1]) > 0 ? 1 : 0, (String) m[2] == "local" ? 1 : 0, (Comparable) m[3] == 0 ? 1 : 0, str_len(m[4]) > 0 ? 1 : 0, (String) m[5] == "rag" || (String) m[5] == "hybrid" ? 1 : 0, weight-shape, adaptation-shape];
        (Comparable) sum(checks) == 8 ? 1 : 0;
    };
    def fki-local-model-weights-learned?(m) = (Comparable) fki-local-model-valid?(m) == 1 ? m[6] : 0;
    def fki-local-model-teaching(m) = m[8];
    // observation fields: tag source concept family split train-family
    // heldout-family leakage-audit query-observation retrieved-path native-execution
    // reasoning-verdict local-model-evidence witness-id
    def fki-observation(source-path, concept-id, family, split, train-family, heldout-family, leakage-audit, query-observation, retrieved-path, native-execution, reasoning-verdict, local-model-evidence, witness-id) = ["knowledge-integration-observation-v1", source-path, concept-id, family, split, train-family, heldout-family, leakage-audit, query-observation, retrieved-path, native-execution, reasoning-verdict, local-model-evidence, witness-id];
    def fki-observation-source(o) = o[1];
    def fki-observation-concept(o) = o[2];
    def fki-observation-family(o) = o[3];
    def fki-observation-valid?(o, sources, concepts) = !((Comparable) len(o) == 14) ? 0 : {
        let path = o[1];
        let id = o[2];
        let family = o[3];
        let checks = [(String) o[0] == "knowledge-integration-observation-v1" ? 1 : 0, fki-current-source-member?(path, family, sources), fki-concept-member?(id, family, path, concepts), (String) o[4] == "heldout" ? 1 : 0, (String) o[5] == o[6] ? 0 : 1, fki-heldout-family?(o[6]), fki-leakage-audit-valid?(o[7]), fki-query-observation-valid?(o[8], path), (String) o[9] == path ? 1 : 0, fki-native-execution-valid?(o[10]), fki-reasoning-valid?(o[11], path), fki-local-model-valid?(o[12]), fki-teaching-exposure-valid?(fki-local-model-teaching(o[12]), sources), str_len(o[13]) > 0 ? 1 : 0];
        (Comparable) sum(checks) == 14 ? 1 : 0;
    };
    // ---- coverage fold --------------------------------------------------
    def fki-concept-has-valid-observation?(concept, observations, sources, concepts) = (Comparable) len(observations) == 0 ? 0 : (String) fki-observation-concept(head(observations)) == fki-concept-id(concept) && ((String) fki-observation-family(head(observations)) == fki-concept-family(concept) && (Comparable) fki-observation-valid?(head(observations), sources, concepts) == 1) ? 1 : fki-concept-has-valid-observation?(concept, tail(observations), sources, concepts);
    def fki-integrated-concepts-loop(remaining, observations, sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-integrated-concepts-loop(tail(remaining), observations, sources, all-concepts, n + fki-concept-has-valid-observation?(head(remaining), observations, sources, all-concepts));
    def fki-integrated-concepts(sources, concepts, observations) = fki-integrated-concepts-loop(concepts, observations, sources, concepts, 0);
    def fki-concept-has-learned-weights?(concept, observations, sources, concepts) = (Comparable) len(observations) == 0 ? 0 : (String) fki-observation-concept(head(observations)) == fki-concept-id(concept) && ((Comparable) fki-observation-valid?(head(observations), sources, concepts) == 1 && (Comparable) fki-local-model-weights-learned?(head(observations)[12]) == 1) ? 1 : fki-concept-has-learned-weights?(concept, tail(observations), sources, concepts);
    def fki-learned-weight-concepts-loop(remaining, observations, sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-learned-weight-concepts-loop(tail(remaining), observations, sources, all-concepts, n + fki-concept-has-learned-weights?(head(remaining), observations, sources, all-concepts));
    def fki-learned-weight-concepts(sources, concepts, observations) = fki-learned-weight-concepts-loop(concepts, observations, sources, concepts, 0);
    def fki-concept-has-source-retrieval?(concept, source-observations, sources, concepts) = (Comparable) len(source-observations) == 0 ? 0 : (String) head(source-observations)[2] == fki-concept-id(concept) && ((String) head(source-observations)[3] == fki-concept-family(concept) && (Comparable) fki-source-retrieval-observation-valid?(head(source-observations), sources, concepts) == 1) ? 1 : fki-concept-has-source-retrieval?(concept, tail(source-observations), sources, concepts);
    def fki-source-retrieval-concepts-loop(remaining, source-observations, sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-source-retrieval-concepts-loop(tail(remaining), source-observations, sources, all-concepts, n + fki-concept-has-source-retrieval?(head(remaining), source-observations, sources, all-concepts));
    def fki-source-retrieval-concepts(sources, concepts, source-observations) = fki-source-retrieval-concepts-loop(concepts, source-observations, sources, concepts, 0);
    def fki-source-mapped?(source, concepts) = (Comparable) len(concepts) == 0 ? 0 : (String) fki-source-path(source) == fki-concept-source-path(head(concepts)) && (String) fki-source-family(source) == fki-concept-family(head(concepts)) ? 1 : fki-source-mapped?(source, tail(concepts));
    def fki-source-integrated?(source, concepts, observations, sources, all-concepts) = (Comparable) len(concepts) == 0 ? 0 : (String) fki-source-path(source) == fki-concept-source-path(head(concepts)) && ((String) fki-source-family(source) == fki-concept-family(head(concepts)) && (Comparable) fki-concept-has-valid-observation?(head(concepts), observations, sources, all-concepts) == 1) ? 1 : fki-source-integrated?(source, tail(concepts), observations, sources, all-concepts);
    def fki-count-mapped-sources-loop(remaining, concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-count-mapped-sources-loop(tail(remaining), concepts, n + fki-source-mapped?(head(remaining), concepts));
    def fki-count-mapped-sources(sources, concepts) = fki-count-mapped-sources-loop(sources, concepts, 0);
    def fki-count-integrated-sources-loop(remaining, concepts, observations, all-sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-count-integrated-sources-loop(tail(remaining), concepts, observations, all-sources, all-concepts, n + fki-source-integrated?(head(remaining), concepts, observations, all-sources, all-concepts));
    def fki-count-integrated-sources(sources, concepts, observations) = fki-count-integrated-sources-loop(sources, concepts, observations, sources, concepts, 0);
    def fki-count-current-sources(sources) = (Comparable) len(sources) == 0 ? 0 : fki-source-current-access?(head(sources)) + fki-count-current-sources(tail(sources));
    def fki-source-has-source-retrieval?(source, concepts, source-observations, sources, all-concepts) = (Comparable) len(concepts) == 0 ? 0 : (String) fki-source-path(source) == fki-concept-source-path(head(concepts)) && ((String) fki-source-family(source) == fki-concept-family(head(concepts)) && (Comparable) fki-concept-has-source-retrieval?(head(concepts), source-observations, sources, all-concepts) == 1) ? 1 : fki-source-has-source-retrieval?(source, tail(concepts), source-observations, sources, all-concepts);
    def fki-count-source-retrieval-sources-loop(remaining, concepts, source-observations, all-sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-count-source-retrieval-sources-loop(tail(remaining), concepts, source-observations, all-sources, all-concepts, n + fki-source-has-source-retrieval?(head(remaining), concepts, source-observations, all-sources, all-concepts));
    def fki-count-source-retrieval-sources(sources, concepts, source-observations) = fki-count-source-retrieval-sources-loop(sources, concepts, source-observations, sources, concepts, 0);
    def fki-count-family-sources(family, sources) = (Comparable) len(sources) == 0 ? 0 : ((String) fki-source-family(head(sources)) == family ? 1 : 0) + fki-count-family-sources(family, tail(sources));
    def fki-count-family-integrated-loop(family, remaining, concepts, observations, all-sources, all-concepts, n) = (Comparable) len(remaining) == 0 ? n : fki-count-family-integrated-loop(family, tail(remaining), concepts, observations, all-sources, all-concepts, n + ((String) fki-source-family(head(remaining)) == family && (Comparable) fki-source-integrated?(head(remaining), concepts, observations, all-sources, all-concepts) == 1 ? 1 : 0));
    def fki-count-family-integrated(family, sources, concepts, observations) = fki-count-family-integrated-loop(family, sources, concepts, observations, sources, concepts, 0);
    def fki-percent(n, total) = (Comparable) total == 0 ? 0 : n * 100 / total;
    def fki-meets-threshold?(n, total) = (Comparable) total == 0 ? 0 : n * 100 >= total * fki-threshold-percent() ? 1 : 0;
    def fki-all-families-meet?(families, sources, concepts, observations) = (Comparable) len(families) == 0 ? 1 : {
        let id = fki-family-id(head(families));
        let total = fki-count-family-sources(id, sources);
        let integrated = fki-count-family-integrated(id, sources, concepts, observations);
        (Comparable) fki-meets-threshold?(integrated, total) == 0 ? 0 : fki-all-families-meet?(tail(families), sources, concepts, observations);
    };
    // report fields: tag scope source-total mapped-sources concept-total
    // integrated-sources integrated-concepts source-percent concept-percent
    // registry-closed family-gate integration-ready95 repository-ready95
    // current-access-percent grounded-rag-percent provenance-percent
    // teaching-prefix-percent learned-weight-concepts learned-weight-percent
    // source-retrieval-sources source-retrieval-source-percent
    // source-retrieval-concepts source-retrieval-concept-percent
