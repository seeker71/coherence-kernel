        let source-total = len(sources);
        let mapped = fki-count-mapped-sources(sources, concepts);
        let concept-total = len(concepts);
        let integrated-sources = fki-count-integrated-sources(sources, concepts, observations);
        let integrated-concepts = fki-integrated-concepts(sources, concepts, observations);
        let current-sources = fki-count-current-sources(sources);
        let learned-weights = fki-learned-weight-concepts(sources, concepts, observations);
        let source-retrieval-sources = fki-count-source-retrieval-sources(sources, concepts, source-observations);
        let source-retrieval-concepts = fki-source-retrieval-concepts(sources, concepts, source-observations);
        let registry-closed = source-total > 0 && (Comparable) mapped == source-total ? 1 : 0;
        let family-gate = fki-all-families-meet?(families, sources, concepts, observations);
        let ready = (Comparable) current-sources == source-total && ((Comparable) registry-closed == 1 && ((Comparable) fki-meets-threshold?(integrated-sources, source-total) == 1 && ((Comparable) fki-meets-threshold?(integrated-concepts, concept-total) == 1 && (Comparable) family-gate == 1))) ? 1 : 0;
        let repository-ready = (String) scope == "repository-live-census" && (Comparable) ready == 1 ? 1 : 0;
        ["form-knowledge-integration-report-v1", scope, source-total, mapped, concept-total, integrated-sources, integrated-concepts, fki-percent(integrated-sources, source-total), fki-percent(integrated-concepts, concept-total), registry-closed, family-gate, ready, repository-ready, fki-percent(current-sources, source-total), fki-percent(integrated-concepts, concept-total), fki-percent(integrated-concepts, concept-total), fki-percent(integrated-concepts, concept-total), learned-weights, fki-percent(learned-weights, concept-total), source-retrieval-sources, fki-percent(source-retrieval-sources, source-total), source-retrieval-concepts, fki-percent(source-retrieval-concepts, concept-total), fki-percent(source-retrieval-sources, source-total), fki-evidence-basis()];
    };
    def fki-report-for-scope(scope, families, sources, concepts, observations) = fki-report-with-source-retrieval(scope, families, sources, concepts, observations, empty());
    def fki-report(families, sources, concepts, observations) = fki-report-for-scope("evaluation-fixture", families, sources, concepts, observations);
    def fki-report-with-retrieval(families, sources, concepts, observations, source-observations) = fki-report-with-source-retrieval("evaluation-fixture", families, sources, concepts, observations, source-observations);
    def fki-repository-report(concepts, observations) = fki-report-for-scope("repository-live-census", fki-families(), fki-live-source-units(), concepts, observations);
    def fki-repository-report-with-retrieval(concepts, observations, source-observations) = fki-report-with-source-retrieval("repository-live-census", fki-families(), fki-live-source-units(), concepts, observations, source-observations);
    def fki-report-scope(r) = r[1];
    def fki-report-source-total(r) = r[2];
    def fki-report-mapped-sources(r) = r[3];
    def fki-report-concept-total(r) = r[4];
    def fki-report-integrated-sources(r) = r[5];
    def fki-report-integrated-concepts(r) = r[6];
    def fki-report-source-percent(r) = r[7];
    def fki-report-concept-percent(r) = r[8];
    def fki-report-registry-closed?(r) = r[9];
    def fki-report-family-gate?(r) = r[10];
    def fki-report-ready95?(r) = r[11];
    def fki-report-repository-ready95?(r) = r[12];
    def fki-report-current-access-percent(r) = r[13];
    def fki-report-grounded-rag-percent(r) = r[14];
    def fki-report-provenance-percent(r) = r[15];
    def fki-report-teaching-prefix-percent(r) = r[16];
    def fki-report-learned-weight-concepts(r) = r[17];
    def fki-report-learned-weight-percent(r) = r[18];
    def fki-report-source-retrieval-sources(r) = r[19];
    def fki-report-source-retrieval-source-percent(r) = r[20];
    def fki-report-source-retrieval-concepts(r) = r[21];
    def fki-report-source-retrieval-concept-percent(r) = r[22];
    def fki-report-current-source-hash-percent(r) = r[23];
    def fki-report-basis(r) = r[24];
    0;
}
