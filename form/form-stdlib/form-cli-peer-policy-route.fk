// form-cli-peer-policy-route.fk -- a scannerless, hot-swappable policy image
// selects the already-born peer actions without taking ownership of Qwen/KV.
//
// A policy is an ordinary JIT-once-born op-tag program.  It receives a compact
// task-intent integer and returns an action integer.  The image can arrive as
// raw task bytes, is reconstructed by a byte cursor (never a tokenizer), and
// is published through the existing leased resident ingress.  The selected
// action remains a caller-born source effect: model/KV, source knowledge, and
// guarded patch authority therefore never enter an arriving image merely
// because its NodeID is valid.  The one model session remains outside this
// policy host.
//
// `nothing` from a policy is absence; an unknown present integer is a choice;
// zero and one are ordinary present program values.  No fk_fn table or static
// function-slot registry participates.
//
// The initial identity image is itself JITable.  It reproduces the native task
// intent, while a later published image may select another admitted action for
// each following task.  Existing unbound historical residences retain their
// declared legacy action until they are renewed; this compatibility state is
// explicit in the selection receipt rather than being mistaken for a swap.
//
// preludes: form-stdlib/form-cli-peer-append-turnwheel.fk
section [form.bml] {
    // Intent/action integers are image data at the selection boundary, not
    // names in a fixed function table.  Their source effects remain below the
    // boundary where capability and session ownership are already explicit.
    def fcpr-intent-model() = 1;
    def fcpr-intent-source-knowledge() = 2;
    def fcpr-intent-repo-patch() = 3;
    def fcpr-intent-source-symbol() = 4;
    def fcpr-intent-direct-answer() = 5;
    def fcpr-intent-hearth-telemetry() = 6;
    def fcpr-intent-provider-receipt() = 7;
    def fcpr-task-intent(task) = (String) fcpsi-task-kind(task) == "hearth-telemetry" ? fcpr-intent-hearth-telemetry() : (String) fcpsi-task-kind(task) == "provider-receipt" ? fcpr-intent-provider-receipt() : (String) fcpsi-task-kind(task) == "direct-answer" ? fcpr-intent-direct-answer() : (String) fcpsi-task-kind(task) == "repo-patch" ? fcpr-intent-repo-patch() : (String) fcpsi-task-kind(task) == "source-concept" || (String) fcpsi-task-kind(task) == "source-nodeid" ? fcpr-intent-source-knowledge() : (String) fcpsi-task-kind(task) == "source-symbol" ? fcpr-intent-source-symbol() : fcpr-intent-model();
    def fcpr-action-name(code) = (Comparable) code == fcpr-intent-model() ? "model" : (Comparable) code == fcpr-intent-source-knowledge() ? "source-knowledge" : (Comparable) code == fcpr-intent-repo-patch() ? "repo-patch" : (Comparable) code == fcpr-intent-source-symbol() ? "source-symbol" : (Comparable) code == fcpr-intent-direct-answer() ? "direct-answer" : (Comparable) code == fcpr-intent-hearth-telemetry() ? "hearth-telemetry" : (Comparable) code == fcpr-intent-provider-receipt() ? "provider-receipt" : nothing();
    // The JIT program `input` gives the resident a live default policy.  It is
    // deliberately tiny because its task is to preserve the native intent, not
    // to hide route choice in another source conditional.
    def fcpr-default-program() = list(list(2));
    def fcpr-default-route(epoch) = {
        let program = fcpr-default-program();
        fcrt-route("peer-action-policy/default", jonb-identity(program, 0, epoch), program, 0);
    };
    // A byte-cursor grammar for one policy image carried inside an already
    // scannerless peer task:
    //
    // <|form:policy-program|>\n
    // symbol=<descriptive name>\n
    // root=<canonical integer>\n
    // program=<comma-separated row>;<comma-separated row>...\n
    // <|/form:policy-program|>
    //
    // It accepts no whitespace, no missing rows, no trailing bytes, and no
    // caller-supplied NodeID.  The route identity is recomputed from the exact
    // rows and the resident registry's meaning epoch.
    def fcpr-open() = "<|form:policy-program|>";
    def fcpr-close() = "<|/form:policy-program|>";
    def fcpr-symbol-prefix() = "symbol=";
    def fcpr-root-prefix() = "\nroot=";
    def fcpr-program-prefix() = "\nprogram=";
    def fcpr-canonical-int?(text) = (String) int_to_str(str_to_int(text)) == text;
    def fcpr-split-go(text, separator, at, out) = {
        let found = str_find(text, separator, at);
        found < 0 ? reverse(cons(substring(text, at, str_len(text)), out)) : fcpr-split-go(text, separator, found + str_len(separator), cons(substring(text, at, found), out));
    };
    def fcpr-split(text, separator) = fcpr-split-go(text, separator, 0, list());
    def fcpr-row-values-go(parts, out) = nil?(parts) ? reverse(out) : (String) head(parts) == "" || (Comparable) fcpr-canonical-int?(head(parts)) == 0 ? nothing() : {
        let rest = fcpr-row-values-go(tail(parts), cons(str_to_int(head(parts)), out));
        nothing?(rest) ? nothing() : rest;
    };
    def fcpr-row-parse(text) = (String) text == "" ? nothing() : fcpr-row-values-go(fcpr-split(text, ","), list());
    def fcpr-program-rows-go(parts, out) = nil?(parts) ? reverse(out) : {
        let row = fcpr-row-parse(head(parts));
        nothing?(row) ? nothing() : {
            let rest = fcpr-program-rows-go(tail(parts), cons(row, out));
            nothing?(rest) ? nothing() : rest;
        };
    };
    def fcpr-program-parse(text) = (String) text == "" ? nothing() : fcpr-program-rows-go(fcpr-split(text, ";"), list());
    // parsed = symbol, root, rows.  The three fields are ordered, which makes
    // every byte either accounted for or refused; no generic key/value map can
    // silently reinterpret an image.
    def fcpr-parse(text) = {
        let open = fcpr-open();
        let close = fcpr-close();
        let open-n = str_len(open);
        let close-at = str_len(text) - str_len(close);
        !((Comparable) str_find(text, open, 0) == 0) || (close-at < open-n || !((Comparable) str_find(text, close, open-n) == close-at)) ? nothing() : {
            let body = substring(text, open-n, close-at);
            let root-at = str_find(body, fcpr-root-prefix(), 0);
            let program-at = root-at < 0 ? -1 : str_find(body, fcpr-program-prefix(), root-at);
            !((Comparable) str_find(body, fcpr-symbol-prefix(), 0) == 0) || (root-at < 0 || program-at < 0) ? nothing() : {
                let symbol = substring(body, str_len(fcpr-symbol-prefix()), root-at);
                let root-text = substring(body, root-at + str_len(fcpr-root-prefix()), program-at);
                let rows = fcpr-program-parse(substring(body, program-at + str_len(fcpr-program-prefix()), str_len(body)));
                (String) symbol == "" || (!((Comparable) str_find(symbol, "\n", 0) == -1) || ((Comparable) fcpr-canonical-int?(root-text) == 0 || nothing?(rows))) ? nothing() : {
                    let root = str_to_int(root-text);
                    root < 0 || root >= len(rows) ? nothing() : list(symbol, root, rows);
                };
            };
        };
    };
    // A route is born only from the parsed image and current registry epoch;
    // a task cannot nominate an unrelated NodeID to borrow its authority.
    def fcpr-route-from-text(host, text) = {
        let parsed = fcpr-parse(text);
        nothing?(parsed) ? nothing() : {
            let shared = wt-sctx(le-w(fcrt-lw(host)));
            let epoch = jonb-epoch(fcrt-shared-registry(shared));
            let program = nth(parsed, 2);
            let root = nth(parsed, 1);
            fcrt-route(nth(parsed, 0), jonb-identity(program, root, epoch), program, root);
        };
    };
    // A route invocation may retain a newly JITted page in `shared`.  Preserve
    // that fact in the same host without changing rows, pins, or event history.
    def fcpr-host-with-shared(host, shared) = {
        let lw = fcrt-lw(host);
        fcrt-host(list(wt-wheel(wt-rows(le-w(lw)), shared), le-tbl(lw), le-cur(lw), le-ledger(lw)), fcrt-events(host));
    };
    def fcpr-transport-with-join(transport, join) = fcpat-with(transport, join, fcpat-peer(transport), fcpat-reader-row(transport), fcpat-pending(transport), fcpat-acks(transport), fcpat-events(transport), fcpat-released?(transport));
    // A policy image owns only the JIT registry seat.  This witness keeps the
    // live model context and tokenizer crystal explicit across a policy epoch:
    // a changed registry is expected; reopening either residence value is not.
    def fcpr-residence-retained?(before, after) = (String) fcrt-shared-path(before) == fcrt-shared-path(after) && ((String) fcrt-shared-src(before) == fcrt-shared-src(after) && ((Comparable) ((Value) fcrt-shared-ctx(before) == fcrt-shared-ctx(after)) == 1 && ((Comparable) ((Value) fcrt-shared-x(before) == fcrt-shared-x(after)) == 1 && ((Comparable) fcrt-shared-maxpos(before) == fcrt-shared-maxpos(after) && (Comparable) fcrt-shared-prefill-quanta(before) == fcrt-shared-prefill-quanta(after)))));
    // result = transport, signal, present, value, action, route-node, reason.
    // The selected integer is retained even when no source action names it, so
    // `choice` is inspectable rather than folded into absence.
    def fcpr-selection(transport, signal, present, value, action, route-node, reason) = list("form-cli-peer-policy-selection-v1", transport, signal, present, value, action, route-node, reason);
    def fcpr-selection-transport(r) = nth(r, 1);
    def fcpr-selection-signal(r) = nth(r, 2);
    def fcpr-selection-present?(r) = nth(r, 3);
    def fcpr-selection-value(r) = nth(r, 4);
    def fcpr-selection-action(r) = nth(r, 5);
    def fcpr-selection-route-node(r) = nth(r, 6);
    def fcpr-selection-reason(r) = nth(r, 7);
    def fcpr-select(transport, task) = {
        let join = fcpat-join(transport);
        let host = ritj-host(join);
        let lw = fcrt-lw(host);
        let route = le-recipes(le-tbl(lw), le-cur(lw));
        let intent = fcpr-task-intent(task);
        nothing?(route) || nothing?(fcrt-route-identity(route)) ? fcpr-selection(transport, "legacy", 1, intent, fcpr-action-name(intent), nothing(), "policy-route-unbound") : {
            let moved = fcrt-route-invoke(route, wt-sctx(le-w(lw)), intent);
            let host2 = fcpr-host-with-shared(host, fcrt-route-shared(moved));
            let join2 = fcpat-join-with-host(join, host2);
            let transport2 = fcpr-transport-with-join(transport, join2);
            !((String) fcrt-route-signal(moved) == "returned") ? fcpr-selection(transport2, fcrt-route-signal(moved), 0, nothing(), nothing(), fcrt-route-identity(route), fcrt-route-reason(moved)) : {
                let code = fcrt-route-value(moved);
                let action = fcpr-action-name(code);
                nothing?(action) ? fcpr-selection(transport2, "choice", 1, code, nothing(), fcrt-route-identity(route), "policy-action-not-admitted") : fcpr-selection(transport2, "returned", 1, code, action, fcrt-route-identity(route), fcrt-route-reason(moved));
            };
        };
    };
    // A publish remains a pure state transition until the contribution wheel
    // stages and durably appends its receipt.  `next-swap` comes from the live
    // lease, so two same-epoch images cannot overwrite each other by a task
    // supplied counter.
    def fcpr-publish(transport, task, now) = {
        let join = fcpat-join(transport);
        let host = ritj-host(join);
        let route = fcpr-route-from-text(host, fcpsi-task-text(task));
        nothing?(route) ? fcpr-selection(transport, "refused", 0, nothing(), nothing(), nothing(), "policy-image-malformed") : {
            let eid = le-cur(fcrt-lw(host));
            let offered = fcpat-offer-join(join, rai-envelope(fcpsi-task-channel(task), fcpsi-task-sequence(task), fcpsi-task-exchange(task), "publish", list(nth(eid, 0) + 1, nth(eid, 1), route), nothing(), -1), now);
            let transport2 = fcpr-transport-with-join(transport, ritj-result-state(offered));
            fcpr-selection(transport2, ritj-result-signal(offered), ritj-result-present?(offered), ritj-result-value(offered), nothing(), fcrt-route-identity(route), ritj-result-detail(offered));
        };
    };
    // Content-free egress projection.  It carries structural task/route
    // identity and typed policy outcome, never task prompt or model response.
    def fcpr-frame(task, selection, phase) = str_concat("<|form:peer-policy|>", str_concat(fcpat-field("task-node", fcpat-node-text(fcpsi-task-node(task))), str_concat(fcpat-field("phase", phase), str_concat(fcpat-field("signal", fcpr-selection-signal(selection)), str_concat(fcpat-field("present", int_to_str(fcpr-selection-present?(selection))), str_concat(fcpat-field("action", nothing?(fcpr-selection-action(selection)) ? "" : fcpr-selection-action(selection)), str_concat(fcpat-field("value", (Comparable) fcpr-selection-present?(selection) == 1 ? int_to_str(fcpr-selection-value(selection)) : ""), str_concat(fcpat-field("route-node", nothing?(fcpr-selection-route-node(selection)) ? "" : fcpat-node-text(fcpr-selection-route-node(selection))), str_concat(fcpat-field("reason", fcpr-selection-reason(selection)), "\n<|/form:peer-policy|>\n")))))))));
    0;
}
