//////////////////////////////////////////////////////////////////////
//
// hearth.bml
//
// Executable BML. The HEARTH: the serving floor that outlives sessions.
//
// THE INTERFACE, AS IT IS. One resident form-cli process is the agent
// server (observe/form-cli-peer-contribution-live.fk): startup stdin
// names the sealed GGUF, task spool, reply spool, fifo bell, channel,
// and budgets; born capabilities are ANNOUNCED BEFORE model admission
// (source-action-v1, direct-answer-v1); one model admission per
// lifetime; a hot-swappable JIT policy may select any born capability
// without reopening the model. Clients are just cells: append ONE
// length-safe task frame (fcpa-task-frame turn kind body) to the task
// spool, ring the bell once (observe/peer-ask-send.fk). The bell wake
// DRAINS ALL WORK PRESENT — that law, not threads, is what serves many
// parallel requests: concurrent appends interleave safely and replies
// land durable in arrival order, keyed by turn. A single `release`
// byte on the bell closes model and state handles cleanly. Witnessed
// 2026-08-31: six clients in one breath, one PID, zero typed errors —
// and the crowdfade capacity law (answers thin as shared context fills;
// the named stone is per-turn context recycling in the turnwheel).
//
// NO REBUILD, EVERYTHING WARM. A new session rebuilds nothing except
// when the freshness band refuses (binary-freshness-band != 31 is the
// ONLY rebuild trigger). Every unit rides its .fkb ice keyed to builder
// and source; .bml surfaces lower in memory and freeze beside the
// source as .bml.fkb; warm runs are milliseconds; hot leaf recipes
// crystallize to native through the heat gate. The universality law
// (alldown) points the rest of the way.
//
// OPEN CHANNELS, ANY REQUEST. The hearth paths below are STABLE and
// session-free, so any session, sibling, or cell can speak to the same
// living server without knowing who birthed it. The board file names
// what stands: pid, spools, capabilities, born-at. Any request kind a
// birth announced is allowed; an unknown kind rides the direct-answer
// route and is served (witnessed 2026-08-31, turn 9005: kind
// direct-answer-never-announced answered in 20s, signal=candidate) —
// the open channel is openness in the flesh; a typed per-kind verdict
// is a named stone. New patterns that recur become doors with lawfaces
// and corpus rows — that is how access generalizes across sessions:
// crystallize, don't re-explain.
//
// preludes: form-stdlib/core.fk form-stdlib/form-cli-movement.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-cli-peer-agent.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearth {
        field HearthDir = ".hearth";
        thought hearth-pattern = list("stable-paths", "board", "one-admission", "drain-all", "typed-release");

        def hearth-task() = str_concat(HearthDir(), "/task.spool");
        def hearth-reply() = str_concat(HearthDir(), "/reply.spool");
        def hearth-bell() = str_concat(HearthDir(), "/bell");
        def hearth-board() = str_concat(HearthDir(), "/board");
        def hearth-out() = str_concat(HearthDir(), "/server.out");
        def hearth-ledger() = str_concat(HearthDir(), "/ledger");
        def hearth-maxpos() = 4096;
        def hearth-counsel() = str_concat(HearthDir(), "/counsel.last");
        def hearth-lat-lo() = 1000;
        def hearth-lat-hi() = 5000;
        def hearth-fill-lo() = 50;
        def hearth-fill-hi() = 80;
        def hearth-kind-answer() = "direct-answer";
        def hearth-send(turn, kind, body) = if eq(hearth-standing(), 0) then 0 else hearth-send-go(turn, kind, body);
        def hearth-send-go(turn, kind, body) = hearth-send-rung(sbt-append(hearth-task(), str_concat(fcpa-task-frame(turn, kind, body), byte_to_str(10))), sbt-ring(hearth-bell()));
        def hearth-send-rung(appended, rung) = 1;

        def hearth-kv(k, v) = str_concat(k, str_concat("=", str_concat(v, byte_to_str(10))));
        def hearth-board-text(pid, capabilities) = str_concat(hearth-kv("pid", int_to_str(pid)), str_concat(hearth-kv("task", hearth-task()), str_concat(hearth-kv("reply", hearth-reply()), str_concat(hearth-kv("bell", hearth-bell()), hearth-kv("capabilities", capabilities)))));
        def hearth-board-write(pid, capabilities) = write_file_text(hearth-board(), hearth-board-text(pid, capabilities));
        def hearth-board-read() = read_file(hearth-board());
        def hearth-board-pid() = fmv-field(hearth-board-read(), "pid");
        def hearth-alive(pid) = if le(pid, 0) then 0 else if ge(str_find(host-exec(str_concat("ps -o pid= -p ", int_to_str(pid)), ""), int_to_str(pid), 0), 0) then 1 else 0;
        def hearth-standing() = hearth-alive(hearth-board-pid());
    }
    0;
}
