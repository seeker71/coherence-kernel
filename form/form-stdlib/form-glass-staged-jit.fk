; form-glass-staged-jit.fk — the smallest runnable later-view JIT precursor.
;
; This cell is deliberately absent from the first-frame prelude.  The first
; selected full view may enter here: its finite route selector crystallizes as
; one native leaf, addressed by structural NodeID, and later requests in the
; same resident process reuse that RAM page.  It does NOT claim that an
; arbitrary whole Glass program image can be invoked in-process; that runtime
; door is still named by form-glass-staged-startup.bml.
;
; preludes: form-stdlib/jit-once-born.fk

(do
    (defn fgsj-schema () "form-glass-staged-jit-v1")
    (defn fgsj-missing-full-call () "runtime.full-program-image.call")

    ; View tags are intentionally tiny: native work here chooses a lane; it
    ; does not render the lane.  Valid tags map to stable route codes 10..40.
    (defn fgsj-view-tag (view)
        (if (str_eq view "overview") 0
        (if (str_eq view "memory") 1
        (if (str_eq view "flow") 2
        (if (str_eq view "recipes") 3 -1)))))
    (defn fgsj-route-program ()
        (list (list 1 10) (list 2) (list 5 0 1) (list 1 10)
              (list 3 2 3)))
    (defn fgsj-route-root () 4)

    (defn fgsj-registry ()
        (jonb-registry (file_mtime
            "form/form-stdlib/form-glass-staged-jit.fk")))

    ; result: schema, status, view, code, execution route, next registry,
    ; born bit, and the still-missing whole-program call door.
    (defn fgsj-request (registry view)
        (do (let tag (fgsj-view-tag view))
            (if (lt tag 0)
                (list (fgsj-schema) "refused" view 0 "none" registry 0
                      (fgsj-missing-full-call))
                (do (let answer (jonb-request registry
                        (fgsj-route-program) (fgsj-route-root) tag))
                    (list (fgsj-schema) "selected" view (nth answer 0)
                          (nth answer 1) (nth answer 2) (nth answer 3)
                          (fgsj-missing-full-call))))))
    (defn fgsj-status (result) (nth result 1))
    (defn fgsj-code (result) (nth result 3))
    (defn fgsj-execution-route (result) (nth result 4))
    (defn fgsj-next-registry (result) (nth result 5))
    (defn fgsj-born (result) (nth result 6))

    (defn fgsj-live ()
        (do (let first (fgsj-request (fgsj-registry) "memory"))
            (let second (fgsj-request (fgsj-next-registry first) "memory"))
            (print_str (str_concat
                "form-glass-staged-jit view=memory first-born="
                (str_concat (int_to_str (fgsj-born first))
                (str_concat " second-born="
                (str_concat (int_to_str (fgsj-born second))
                (str_concat " route="
                (str_concat (fgsj-execution-route second)
                " full-program-call=unavailable\n")))))))
            (list (fgsj-schema) first second)))
    0)
