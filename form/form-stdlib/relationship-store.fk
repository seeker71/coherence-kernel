// One durable file per relationship field. The caller owns consent and verifies
// its requested effect. Native truncating writes replace the whole value;
// failure to remove an old file must never append a new value to it.
import form-stdlib/core.fk;
section [form.bml] {
    // --- one file per remembered handle ---
    def rs-path(dir, handle) = (dir + ("/" + (handle + ".rel")));
    // remember — the ONLY write path. Called only when consent is open
    // (the relationship-memory consent); never a default.
    def rs-remember(dir, handle, description) = {
        fs_mkdir(dir);
        write_file_text(rs-path(dir, handle), description);
    };
    // known? — has this handle been remembered before (in ANY prior breath)?
    def rs-known?(dir, handle) = fs_exists(rs-path(dir, handle));
    // recall — the description remembered for this handle. Ask rs-known?
    // first; an unknown handle's absent file answers nothing (2026-08-27),
    // named here so recall keeps answering "" for never-remembered.
    def rs-recall(dir, handle) = {
        let s = read_file(rs-path(dir, handle));
        nothing?(s) ? "" : s;
    };
    // forget — honors revocation (consent is revocable, always). Removing the
    // file is the whole of forgetting here — there is no secondary copy.
    def rs-forget(dir, handle) = fs_remove(rs-path(dir, handle));
}
