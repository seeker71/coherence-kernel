; living-world-experience.fk -- interaction can become offered evidence.
;
; An experience addresses one observed recursive signature and carries an
; input, a locally observed output, and the source's acknowledgment.  ONE says
; the observed output confirms the locally derived output.  ZERO says the
; observed output differs and offers a correction.  NOTHING is first-class
; silence and carries no invented output.  No experience enters authority by
; itself; ordinary living-world attribution and later tending still govern it.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk

(let LWX-EXPERIENCE (bp "LWX-EXPERIENCE"))

; children: addressed signature, input, observed output, acknowledgment,
;           offered evidence, local derivation path
(defn lwx-experience (signature input observed acknowledgment evidence)
    (intern_node LWX-EXPERIENCE
        (list signature input observed acknowledgment evidence
              (lwo-local-path))))
(defn lwx-experience? (cell) (lwo-category? cell LWX-EXPERIENCE))
(defn lwx-experience-signature (experience)
    (nth (node_children experience) 0))
(defn lwx-experience-input (experience)
    (nth (node_children experience) 1))
(defn lwx-experience-observed (experience)
    (nth (node_children experience) 2))
(defn lwx-experience-ack (experience)
    (nth (node_children experience) 3))
(defn lwx-experience-evidence (experience)
    (nth (node_children experience) 4))
(defn lwx-experience-path (experience)
    (nth (node_children experience) 5))

(defn lwx-experience-ack-valid? (ack)
    (if (or (eq (oac-one? ack) 1)
            (or (eq (oac-zero? ack) 1)
                (eq (oac-nothing? ack) 1))) 1 0))

(defn lwx-experience-input-valid? (experience)
    (node_eq
        (lwrr-skeleton (lwx-experience-input experience))
        (lwrr-signature-source-skeleton
            (lwx-experience-signature experience))))

(defn lwx-experience-output-valid? (experience)
    (do
        (let ack (lwx-experience-ack experience))
        (let observed (lwx-experience-observed experience))
        (if (eq (oac-nothing? ack) 1)
            (if (node_eq observed (lwo-none)) 1 0)
            (if (node_eq observed (lwo-none)) 0
                (if (node_eq
                        (lwrr-skeleton observed)
                        (lwrr-signature-target-skeleton
                            (lwx-experience-signature experience))) 1 0)))))

(defn lwx-experience-ack-coherent? (experience)
    (do
        (let ack (lwx-experience-ack experience))
        (if (eq (oac-nothing? ack) 1) 1
            (do
                (let predicted
                    (lwrr-apply-signature
                        (lwx-experience-signature experience)
                        (lwx-experience-input experience)))
                (if (node_eq predicted (lwo-none)) 0
                    (if (eq (oac-one? ack) 1)
                        (if (node_eq predicted
                                    (lwx-experience-observed experience)) 1 0)
                        (if (eq (oac-zero? ack) 1)
                            (if (node_eq predicted
                                        (lwx-experience-observed experience)) 0 1)
                            0)))))))

(defn lwx-experience-valid? (experience)
    (if (and (eq (lwx-experience? experience) 1)
             (and (eq (lwrr-signature-valid?
                           (lwx-experience-signature experience)) 1)
                  (and (eq (lwx-experience-ack-valid?
                                (lwx-experience-ack experience)) 1)
                       (and (eq (lwx-experience-input-valid? experience) 1)
                            (and (eq (lwx-experience-output-valid?
                                         experience) 1)
                                 (eq (lwx-experience-ack-coherent?
                                         experience) 1)))))) 1 0))

(defn lwx-experience-bearing? (experience)
    (if (and (eq (lwx-experience-valid? experience) 1)
             (eq (oac-nothing? (lwx-experience-ack experience)) 0)) 1 0))

(defn lwx-experience-correspondence (experience)
    (if (eq (lwx-experience-bearing? experience) 0) (lwo-none)
        (lwr-correspondence (lwx-experience-input experience)
                            (lwx-experience-observed experience))))
