; form-cli-bml-ice-run.fk — use the crystallized BML feature.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-bml-ice-xtal.fk

(do
    (print "form-cli executed bml-ice\n")
    (print "form-cli anyone-ice=")
    (print (int_to_str (fbi-anyone-ice)))
    (print " cursor-free=")
    (print (int_to_str (fbi-client-free "cursor")))
    (print " ingest-fear=")
    (print (int_to_str (fbi-ingest 5 1)))
    (print " check=")
    (print (int_to_str (fbi-check)))
    (print "\n")
    0)
