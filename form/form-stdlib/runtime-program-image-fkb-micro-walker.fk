    def rpmw-program-image-envelope?(envelope) = rale-envelope?(envelope) ? (String) rale-envelope-status(envelope) == rale-status-request-ready() ? (String) rale-envelope-action(envelope) == rap-act-run-program-image() ? (Comparable) rale-envelope-route(envelope) == sac-run-fkb() ? (String) rale-envelope-artifact-kind(envelope) == sad-kind-program-image-fkb() : 0 : 0 : 0 : 0;
