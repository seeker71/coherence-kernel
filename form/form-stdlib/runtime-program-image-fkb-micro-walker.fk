    def rpmw-reason-malformed-input-kind() = "malformed-input-kind";
    def rpmw-reason-manifest() = [rpmw-reason-walk-completed(), rpmw-reason-step-budget-exhausted(), rpmw-reason-unsupported-tag(), rpmw-reason-child-out-of-range(), rpmw-reason-call-target-out-of-range(), rpmw-reason-negative-list-index(), rpmw-reason-string-pool-index-out-of-range(), rpmw-reason-string-value-required(), rpmw-reason-integer-value-required(), rpmw-reason-list-value-required(), rpmw-reason-negative-frame-offset(), rpmw-reason-negative-frame-reserve(), rpmw-reason-frame-slot-out-of-range(), rpmw-reason-frame-slot-uninitialized(), rpmw-reason-nodeid-components-required(), rpmw-reason-nodeid-coordinate-integer-required(), rpmw-reason-node-value-required(), rpmw-reason-composite-node-required(), rpmw-reason-trivial-node-required(), rpmw-reason-node-children-required(), rpmw-reason-string-byte-index-out-of-range(), rpmw-reason-substring-bounds-invalid(), rpmw-reason-malformed-envelope(), rpmw-reason-non-program-image-envelope(), rpmw-reason-malformed-admission(), rpmw-reason-non-admitted-admission(), rpmw-reason-admission-decode-not-decoded(), rpmw-reason-admission-invalid-pif(), rpmw-reason-admission-decode-pif-mismatch(), rpmw-reason-artifact-identity-mismatch(), rpmw-reason-negative-entry-index(), rpmw-reason-entry-index-out-of-range(), rpmw-reason-root-node-out-of-range(), rpmw-reason-negative-step-budget(), rpmw-reason-malformed-input-kind()];
