no-supplied-run-or-trace-input", 1), rpmw-feature("no-bridge-or-join-consumption", 1), rpmw-feature("no-artifact-io", 1), rpmw-feature("no-host-or-native-execution", 1), rpmw-feature("no-generated-table-authority", 1), rpmw-feature("no-selector-storage-or-champion-mutation", 1), rpmw-feature("no-c-seed-growth", 1)];
