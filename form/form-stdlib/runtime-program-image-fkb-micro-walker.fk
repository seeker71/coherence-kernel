        !rpmw-int?(rpmw-result-kind(size-result)) ? rpmw-result-error(spent-size, rpmw-reason-integer-value-required()) : rpmw-result-value(size-result) < 0 ? rpmw-result-error(spent-size, rpmw-reason-negative-frame-reserve()) : {
            let remaining = budget - spent-size;
            remaining <= 0 ? rpmw-result-timeout(spent-size) : rpmw-result-add-prefix(rpmw-eval-node(table, rpmw-row-b(row), remaining, rpmw-frame-reserve(frame, rpmw-result-value(size-result)), input-kind), spent-size);
        };
    };
    def rpmw-eval-frame-reserve(table, row, budget, frame, input-kind) = !rpmw-binary-child-valid?(table, row) ? rpmw-result-error(1, rpmw-reason-child-out-of-range()) : rpmw-eval-frame-reserve-after-size(table, row, budget, frame, input-kind, rpmw-eval-node(table, rpmw-row-a(row), budget - 1, frame, input-kind));
    // Tag 12 is the source runner's one-argument direct call. The PIF keeps
    // function roots in its own admitted table, so this crossing spends no
    // global fk_fn seat: evaluate the argument, bind it as the callee input,
    // and continue at the target root under the remaining budget.
    def rpmw-eval-call-after-argument(table, row, budget, argument) = !rpmw-result-ok?(argument) ? rpmw-result-add-parent(argument) : {
        let spent-with-call = 1 + rpmw-result-steps(argument);
        let remaining = budget - spent-with-call;
        remaining <= 0 ? rpmw-result-timeout(spent-with-call) : {
            let target-root = pif-table-fn-roots(table)[rpmw-row-a(row)];
            !rpmw-node-id-valid?(table, target-root) ? rpmw-result-error(spent-with-call, rpmw-reason-root-node-out-of-range()) : {
                let out = rpmw-eval-node(table, target-root, remaining, rpmw-frame-one(rpmw-result-value(argument), rpmw-result-kind(argument)), rpmw-kind-absent());
                rpmw-result-row(rpmw-result-value(out), rpmw-result-kind(out), spent-with-call + rpmw-result-steps(out), rpmw-result-trace-status(out), rpmw-result-stop-reason(out), rpmw-result-reason(out), rpmw-result-detail(out));
            };
        };
    };
    def rpmw-eval-call(table, row, budget, input-value, input-kind) = !rpmw-entry-index-valid?(table, rpmw-row-a(row)) ? rpmw-result-error(1, rpmw-reason-call-target-out-of-range()) : !rpmw-node-id-valid?(table, rpmw-row-b(row)) ? rpmw-result-error(1, rpmw-reason-child-out-of-range()) : rpmw-eval-call-after-argument(table, row, budget, rpmw-eval-node(table, rpmw-row-b(row), budget - 1, input-value, input-kind));
    def rpmw-eval-node(table, node-id, budget, input-value, input-kind) = budget <= 0 ? rpmw-result-timeout(0) : !rpmw-node-id-valid?(table, node-id) ? rpmw-result-error(0, rpmw-reason-child-out-of-range()) : {
        let row = rpmw-node-row(table, node-id);
        let tag = rpmw-row-tag(row);
        (Comparable) tag == 1 ? rpmw-result-ok(rpmw-row-a(row), rpmw-kind-int(), 1) : (Comparable) tag == 2 ? rpmw-frame-read-result(input-value, 0, 1) : (Comparable) tag == 12 ? rpmw-eval-call(table, row, budget, input-value, input-kind) : (Comparable) tag == 18 ? rpmw-result-ok(empty(), rpmw-kind-list(empty()), 1) : (Comparable) tag == 24 ? rpmw-eval-string-literal(table, row) : (Comparable) tag == 137 ? rpmw-result-ok(nothing(), rpmw-kind-nothing(), 1) : rpmw-list-pair-supported?(tag) ? rpmw-eval-list-pair(table, row, budget, input-value, input-kind) : rpmw-list-unary-supported?(tag) ? rpmw-eval-list-unary(table, row, budget, input-value, input-kind) : (Comparable) tag == 69 ? rpmw-eval-sequence(table, row, budget, input-value, input-kind) : rpmw-node-unary-supported?(tag) ? rpmw-eval-node-unary(table, row, budget, input-value, input-kind) : rpmw-node-binary-supported?(tag) ? rpmw-eval-node-binary(table, row, budget, input-value, input-kind) : rpmw-string-unary-supported?(tag) ? rpmw-eval-string-unary(table, row, budget, input-value, input-kind) : rpmw-string-binary-supported?(tag) ? rpmw-eval-string-binary(table, row, budget, input-value, input-kind) : rpmw-string-ternary-supported?(tag) ? rpmw-eval-string-ternary(table, row, budget, input-value, input-kind) : rpmw-binary-supported?(tag) ? rpmw-eval-binary(table, row, budget, input-value, input-kind) : (Comparable) tag == 6 ? rpmw-eval-if(table, row, budget, input-value, input-kind) : (Comparable) tag == 109 ? rpmw-eval-frame-store(table, row, budget, input-value, input-kind) : (Comparable) tag == 110 ? rpmw-eval-frame-read(table, row, budget, input-value, input-kind) : (Comparable) tag == 111 ? rpmw-eval-frame-reserve(table, row, budget, input-value, input-kind) : rpmw-result-error(1, rpmw-reason-unsupported-tag());
    };
    def rpmw-trace-from-result(envelope, pif, entry-index, root-node, step-budget, result) = rpiwt-trace(rale-envelope-artifact-path(envelope), pif-envelope-source-hash(pif), pif-envelope-content-hash(pif), rpiwt-entry-kind-function-root(), entry-index, root-node, step-budget, rpmw-result-steps(result), rpmw-result-ok?(result) ? 1 : 0, rpmw-result-ok?(result) ? rpmw-result-value(result) : 0, rpmw-result-ok?(result) ? 0 : (String) rpmw-result-trace-status(result) == rao-obs-timeout() ? 124 : 1, rpmw-result-trace-status(result), rpmw-result-stop-reason(result), rpmw-result-detail(result));
    def rpmw-walk-after-valid-entry-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, pif, root-node) = {
        let result = rpmw-eval-node(pif-envelope-table(pif), root-node, step-budget, rpmw-frame-one(input-value, input-kind), rpmw-kind-absent());
        let trace = rpmw-trace-from-result(envelope, pif, entry-index, root-node, step-budget, result);
        rpmw-produced-with-kind(envelope, admission, entry-index, root-node, step-budget, input-value, input-kind, trace, result);
    };
    def rpmw-walk-after-ready-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind) = {
        let pif = pifbd-admission-pif(admission);
        let table = pif-envelope-table(pif);
        entry-index < 0 ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-negative-entry-index()) : !rpmw-entry-index-valid?(table, entry-index) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-entry-index-out-of-range()) : {
            let root-node = pif-table-fn-roots(table)[entry-index];
            !rpmw-node-id-valid?(table, root-node) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-root-node-out-of-range()) : step-budget < 0 ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-negative-step-budget()) : rpmw-walk-after-valid-entry-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, pif, root-node);
        };
    };
    def rpmw-walk-entry-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind) = !rpmw-kind-valid?(input-kind) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-malformed-input-kind()) : !rale-envelope?(envelope) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-malformed-envelope()) : !rpmw-program-image-envelope?(envelope) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-non-program-image-envelope()) : !pifbd-admission?(admission) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-malformed-admission()) : !rpmw-admission-status-admitted?(admission) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-non-admitted-admission()) : !rpmw-admission-decode-decoded?(admission) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-admission-decode-not-decoded()) : !rpmw-admission-pif-valid?(admission) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-admission-invalid-pif()) : !rpmw-admission-decode-matches-pif?(admission) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-admission-decode-pif-mismatch()) : !rpmw-pif-matches-envelope?(envelope, pifbd-admission-pif(admission)) ? rpmw-refused-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind, rpmw-reason-artifact-identity-mismatch()) : rpmw-walk-after-ready-with-kind(envelope, admission, entry-index, step-budget, input-value, input-kind);
    def rpmw-walk-entry(envelope, admission, entry-index, step-budget, input-value) = rpmw-walk-entry-with-kind(envelope, admission, entry-index, step-budget, input-value, rpmw-kind-int());
}
