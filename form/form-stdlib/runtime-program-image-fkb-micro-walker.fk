    def rpmw-receipt-row-v2(envelope, admission, entry-index, root-node, step-budget, input-value, trace, result, status, reason, input-kind) = append(rpmw-receipt-row(envelope, admission, entry-index, root-node, step-budget, input-value, trace, result, status, reason), [input-kind]);
    def rpmw-receipt?(r) = (Comparable) len(r) == 11 || (Comparable) len(r) == 12 ? (String) r[0] == "runtime-program-image-fkb-micro-walker" : 0;
    def rpmw-receipt-envelope(r) = r[1];
