    def rpmw-kind-row(name, children) = ["runtime-program-image-fkb-value-kind", name, children];
    def rpmw-kind-int() = rpmw-kind-row("int", empty());
    def rpmw-kind-string() = rpmw-kind-row("string", empty());
    def rpmw-kind-nothing() = rpmw-kind-row("nothing", empty());
    def rpmw-kind-absent() = rpmw-kind-row("absent", empty());
    def rpmw-kind-list(children) = rpmw-kind-row("list", children);
    def rpmw-kind-nodeid() = rpmw-kind-row("nodeid", empty());
