    def rpmw-result-timeout(steps) = rpmw-result-row(0, rpmw-kind-absent(), steps, rao-obs-timeout(), rpiwt-stop-timeout(), rpmw-reason-step-budget-exhausted(), rpmw-detail(rpmw-reason-step-budget-exhausted()));
