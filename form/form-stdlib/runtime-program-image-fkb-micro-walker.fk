    } : 0;
    def rpmw-pif-matches-envelope?(envelope, pif) = pif-envelope-valid?(pif) ? (String) pif-envelope-artifact-path(pif) == rale-envelope-artifact-path(envelope) ? (String) pif-envelope-source-hash(pif) == rale-envelope-source-hash(envelope) ? (String) pif-envelope-content-hash(pif) == rale-envelope-content-hash(envelope) : 0 : 0 : 0;
    def rpmw-node-row(table, node-id) = pif-table-node-rows(table)[node-id];
    def rpmw-row-tag(row) = row[0];
