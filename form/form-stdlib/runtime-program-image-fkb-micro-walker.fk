; runtime-program-image-fkb-micro-walker.fk -- Layer 9h5 real PIF trace producer.
;
; Layer 9h5 is the first real trace producer after the terminal supplied-
; evidence 9h4 join. It consumes a request-ready program-image envelope plus an
; admitted byte-decoded PIF admission, walks the admitted in-memory PIF table
; with bounded fuel, and emits an existing rpiwt trace row plus a micro-walk
; receipt. It does not accept supplied runs, supplied traces, bridges, joins,
; host execution, artifact IO, selector mutation, or C-seed growth.
;
; preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/runtime-artifact-selector.fk form-stdlib/runtime-artifact-outcome.fk form-stdlib/runtime-artifact-retry.fk form-stdlib/runtime-artifact-load-envelope.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-fkb-byte-container.fk form-stdlib/program-image-fkb-byte-file-witness.fk form-stdlib/program-image-fkb-byte-decode.fk form-stdlib/runtime-program-image-fkb-walker-trace.fk

(do
    (defn rpmw-version () "runtime-program-image-fkb-micro-walker-v1")

    (defn rpmw-feature (name status) (list "runtime-program-image-fkb-micro-walker-feature" name status))
    (defn rpmw-feature-name (f) (nth f 1))
    (defn rpmw-feature-status (f) (nth f 2))
    (defn runtime-program-image-fkb-micro-walker-manifest ()
        (list
            (rpmw-feature "layer-9h5-first-real-trace-producer-after-9h4" 1)
            (rpmw-feature "9h4-remains-terminal-supplied-evidence-join" 1)
            (rpmw-feature "consumes-9e-envelope-and-8h6-admission-only" 1)
            (rpmw-feature "computes-trace-from-admitted-pif-table" 1)
            (rpmw-feature "bounded-fuel-every-recursive-walk" 1)
            (rpmw-feature "function-root-entry-only" 1)
            (rpmw-feature "flat-row-semantics-pinned" 1)
            (rpmw-feature "lit-add-sub-mul-le-if-subset" 1)
            (rpmw-feature "tag-12-multi-function-call" 1)
            (rpmw-feature "call-target-range-errors-are-loud" 1)
            (rpmw-feature "tag-18-23-packed-list-values" 1)
            (rpmw-feature "tag-137-138-exact-nothing-values" 1)
            (rpmw-feature "explicit-nothing-retains-one-output" 1)
            (rpmw-feature "packed-multi-parameter-call-values" 1)
            (rpmw-feature "tag-24-30-and-32-typed-string-values" 1)
            (rpmw-feature "string-pool-bytes-decode-to-form-strings" 1)
            (rpmw-feature "string-child-kinds-and-bounds-refused-loudly" 1)
            (rpmw-feature "explicit-result-value-kind-provenance" 1)
            (rpmw-feature "typed-entry-kind-retained" 1)
            (rpmw-feature "legacy-integer-entry-wrapper-preserved" 1)
            (rpmw-feature "tag-109-110-111-sparse-explicit-frames" 1)
            (rpmw-feature "frame-bindings-retain-value-kind-and-occupancy" 1)
            (rpmw-feature "logical-frame-reserve-allocates-no-global-seats" 1)
            (rpmw-feature "tag-91-four-coordinate-nodeid-values" 1)
            (rpmw-feature "tag-43-46-47-typed-native-node-values" 1)
            (rpmw-feature "tag-48-49-92-node-readers" 1)
            (rpmw-feature "tag-80-structural-node-equality" 1)
            (rpmw-feature "composite-child-kinds-retained" 1)
            (rpmw-feature "tag-69-sequence-retains-right-kind" 1)
            (rpmw-feature "tag-102-103-single-evaluation-comparisons" 1)
            (rpmw-feature "unsupported-tags-are-loud-errors" 1)
            (rpmw-feature "child-range-errors-are-loud" 1)
            (rpmw-feature "budget-exhaustion-is-timeout-trace" 1)
            (rpmw-feature "emits-rpiwt-trace-row" 1)
            (rpmw-feature "emits-micro-walk-receipt" 1)
            (rpmw-feature "no-supplied-run-or-trace-input" 1)
            (rpmw-feature "no-bridge-or-join-consumption" 1)
            (rpmw-feature "no-artifact-io" 1)
            (rpmw-feature "no-host-or-native-execution" 1)
            (rpmw-feature "no-generated-table-authority" 1)
            (rpmw-feature "no-selector-storage-or-champion-mutation" 1)
            (rpmw-feature "no-c-seed-growth" 1)))
    (defn runtime-program-image-fkb-micro-walker-manifest-has? (name fs)
        (if (nil? fs)
            0
            (if (and (str_eq (rpmw-feature-name (head fs)) name)
                     (eq (rpmw-feature-status (head fs)) 1))
                1
                (runtime-program-image-fkb-micro-walker-manifest-has? name (tail fs)))))

    (defn rpmw-status-trace-produced () "trace-produced")
    (defn rpmw-status-refused () "refused")

    (defn rpmw-reason-walk-completed () "walk-completed")
    (defn rpmw-reason-step-budget-exhausted () "step-budget-exhausted")
    (defn rpmw-reason-unsupported-tag () "unsupported-tag")
    (defn rpmw-reason-child-out-of-range () "child-out-of-range")
    (defn rpmw-reason-call-target-out-of-range () "call-target-out-of-range")
    (defn rpmw-reason-negative-list-index () "negative-list-index")
    (defn rpmw-reason-string-pool-index-out-of-range () "string-pool-index-out-of-range")
    (defn rpmw-reason-string-value-required () "string-value-required")
    (defn rpmw-reason-integer-value-required () "integer-value-required")
    (defn rpmw-reason-list-value-required () "list-value-required")
    (defn rpmw-reason-negative-frame-offset () "negative-frame-offset")
    (defn rpmw-reason-negative-frame-reserve () "negative-frame-reserve")
    (defn rpmw-reason-frame-slot-out-of-range () "frame-slot-out-of-range")
    (defn rpmw-reason-frame-slot-uninitialized () "frame-slot-uninitialized")
    (defn rpmw-reason-nodeid-components-required () "nodeid-components-required")
    (defn rpmw-reason-nodeid-coordinate-integer-required () "nodeid-coordinate-integer-required")
    (defn rpmw-reason-node-value-required () "node-value-required")
    (defn rpmw-reason-composite-node-required () "composite-node-required")
    (defn rpmw-reason-trivial-node-required () "trivial-node-required")
    (defn rpmw-reason-node-children-required () "node-children-required")
    (defn rpmw-reason-string-byte-index-out-of-range () "string-byte-index-out-of-range")
    (defn rpmw-reason-substring-bounds-invalid () "substring-bounds-invalid")
    (defn rpmw-reason-malformed-envelope () "malformed-envelope")
    (defn rpmw-reason-non-program-image-envelope () "non-program-image-envelope")
    (defn rpmw-reason-malformed-admission () "malformed-admission")
    (defn rpmw-reason-non-admitted-admission () "non-admitted-admission")
    (defn rpmw-reason-admission-decode-not-decoded () "admission-decode-not-decoded")
    (defn rpmw-reason-admission-invalid-pif () "admission-invalid-pif")
    (defn rpmw-reason-admission-decode-pif-mismatch () "admission-decode-pif-mismatch")
    (defn rpmw-reason-artifact-identity-mismatch () "artifact-identity-mismatch")
    (defn rpmw-reason-negative-entry-index () "negative-entry-index")
    (defn rpmw-reason-entry-index-out-of-range () "entry-index-out-of-range")
    (defn rpmw-reason-root-node-out-of-range () "root-node-out-of-range")
    (defn rpmw-reason-negative-step-budget () "negative-step-budget")
    (defn rpmw-reason-malformed-input-kind () "malformed-input-kind")
    (defn rpmw-reason-manifest ()
        (list
            (rpmw-reason-walk-completed)
            (rpmw-reason-step-budget-exhausted)
            (rpmw-reason-unsupported-tag)
            (rpmw-reason-child-out-of-range)
            (rpmw-reason-call-target-out-of-range)
            (rpmw-reason-negative-list-index)
            (rpmw-reason-string-pool-index-out-of-range)
            (rpmw-reason-string-value-required)
            (rpmw-reason-integer-value-required)
            (rpmw-reason-list-value-required)
            (rpmw-reason-negative-frame-offset)
            (rpmw-reason-negative-frame-reserve)
            (rpmw-reason-frame-slot-out-of-range)
            (rpmw-reason-frame-slot-uninitialized)
            (rpmw-reason-nodeid-components-required)
            (rpmw-reason-nodeid-coordinate-integer-required)
            (rpmw-reason-node-value-required)
            (rpmw-reason-composite-node-required)
            (rpmw-reason-trivial-node-required)
            (rpmw-reason-node-children-required)
            (rpmw-reason-string-byte-index-out-of-range)
            (rpmw-reason-substring-bounds-invalid)
            (rpmw-reason-malformed-envelope)
            (rpmw-reason-non-program-image-envelope)
            (rpmw-reason-malformed-admission)
            (rpmw-reason-non-admitted-admission)
            (rpmw-reason-admission-decode-not-decoded)
            (rpmw-reason-admission-invalid-pif)
            (rpmw-reason-admission-decode-pif-mismatch)
            (rpmw-reason-artifact-identity-mismatch)
            (rpmw-reason-negative-entry-index)
            (rpmw-reason-entry-index-out-of-range)
            (rpmw-reason-root-node-out-of-range)
            (rpmw-reason-negative-step-budget)
            (rpmw-reason-malformed-input-kind)))

    (defn rpmw-no-trace () (list "runtime-program-image-fkb-micro-walker-no-trace"))
    (defn rpmw-no-result () (list "runtime-program-image-fkb-micro-walker-no-result"))
    (defn rpmw-marker () "program-image-fkb-micro-walker")
    (defn rpmw-detail (reason)
        (str_concat (rpmw-marker) (str_concat " reason=" reason)))

    ; Value kinds are carried by this Form evaluator, not guessed from the host
    ; representation. List kinds retain one child-kind per value so NTH can
    ; recover exact provenance after a packed call.
    (defn rpmw-kind-row (name children)
        (list "runtime-program-image-fkb-value-kind" name children))
    (defn rpmw-kind-int () (rpmw-kind-row "int" (empty)))
    (defn rpmw-kind-string () (rpmw-kind-row "string" (empty)))
    (defn rpmw-kind-nothing () (rpmw-kind-row "nothing" (empty)))
    (defn rpmw-kind-absent () (rpmw-kind-row "absent" (empty)))
    (defn rpmw-kind-list (children) (rpmw-kind-row "list" children))
    (defn rpmw-kind-nodeid () (rpmw-kind-row "nodeid" (empty)))
    (defn rpmw-kind-trivial-int-node ()
        (rpmw-kind-row "trivial-int-node" (empty)))
    (defn rpmw-kind-trivial-string-node ()
        (rpmw-kind-row "trivial-string-node" (empty)))
    (defn rpmw-kind-composite-node (children)
        (rpmw-kind-row "composite-node" children))
    (defn rpmw-kind-name (kind) (nth kind 1))
    (defn rpmw-kind-children (kind) (nth kind 2))
    (defn rpmw-kind-leaf-name? (name)
        (if (str_eq name "int") 1
        (if (str_eq name "string") 1
        (if (str_eq name "nothing") 1
        (if (str_eq name "absent") 1
        (if (str_eq name "nodeid") 1
        (if (str_eq name "trivial-int-node") 1
            (if (str_eq name "trivial-string-node") 1 0))))))))
    (defn rpmw-kind-children-valid? (children)
        (if (nil? children) 1
            (if (rpmw-kind-valid? (head children))
                (rpmw-kind-children-valid? (tail children)) 0)))
    (defn rpmw-kind-valid? (kind)
        (if (nothing? kind) 0
        (if (not (eq (len kind) 3)) 0
        (if (not (str_eq (nth kind 0)
                         "runtime-program-image-fkb-value-kind")) 0
            (do
                (let name (rpmw-kind-name kind))
                (let children (rpmw-kind-children kind))
                (if (rpmw-kind-leaf-name? name)
                    (if (nil? children) 1 0)
                    (if (or (str_eq name "list")
                            (str_eq name "composite-node"))
                        (rpmw-kind-children-valid? children) 0)))))))
    (defn rpmw-kind-children-equal? (a b)
        (if (nil? a)
            (if (nil? b) 1 0)
            (if (nil? b)
                0
                (if (rpmw-kind-equal? (head a) (head b))
                    (rpmw-kind-children-equal? (tail a) (tail b))
                    0))))
    (defn rpmw-kind-equal? (a b)
        (if (not (rpmw-kind-valid? a)) 0
        (if (not (rpmw-kind-valid? b)) 0
            (and (str_eq (rpmw-kind-name a) (rpmw-kind-name b))
                 (rpmw-kind-children-equal?
                    (rpmw-kind-children a) (rpmw-kind-children b))))))
    (defn rpmw-kind-named? (kind name)
        (if (rpmw-kind-valid? kind)
            (str_eq (rpmw-kind-name kind) name) 0))
    (defn rpmw-nodeid? (kind) (rpmw-kind-named? kind "nodeid"))
    (defn rpmw-trivial-int-node? (kind)
        (rpmw-kind-named? kind "trivial-int-node"))
    (defn rpmw-trivial-string-node? (kind)
        (rpmw-kind-named? kind "trivial-string-node"))
    (defn rpmw-composite-node? (kind)
        (rpmw-kind-named? kind "composite-node"))
    (defn rpmw-native-node? (kind)
        (if (rpmw-nodeid? kind) 1
            (if (rpmw-trivial-int-node? kind) 1
                (if (rpmw-trivial-string-node? kind) 1
                    (if (rpmw-composite-node? kind) 1 0)))))
    (defn rpmw-native-node-kinds? (kinds)
        (if (nil? kinds)
            1
            (if (rpmw-native-node? (head kinds))
                (rpmw-native-node-kinds? (tail kinds)) 0)))
    (defn rpmw-int-kinds? (kinds)
        (if (nil? kinds)
            1
            (if (rpmw-kind-named? (head kinds) "int")
                (rpmw-int-kinds? (tail kinds)) 0)))

    ; A resident frame is sparse Form data, never a preallocated global slot
    ; arena. Capacity is a logical bound established by RESERVE; bindings name
    ; only occupied offsets. This makes a large reserve constant-space and lets
    ; FARG distinguish an uninitialized slot from a slot containing `nothing`,
    ; integer 0, or integer 1.
    ; frame = ("runtime-program-image-fkb-frame" capacity bindings)
    ; binding = (offset value kind)
    (defn rpmw-frame-row (capacity bindings)
        (list "runtime-program-image-fkb-frame" capacity bindings))
    (defn rpmw-frame? (frame)
        (if (eq (len frame) 3)
            (str_eq (nth frame 0) "runtime-program-image-fkb-frame")
            0))
    (defn rpmw-frame-capacity (frame) (nth frame 1))
    (defn rpmw-frame-bindings (frame) (nth frame 2))
    (defn rpmw-frame-binding (offset value kind) (list offset value kind))
    (defn rpmw-frame-binding-offset (binding) (nth binding 0))
    (defn rpmw-frame-binding-value (binding) (nth binding 1))
    (defn rpmw-frame-binding-kind (binding) (nth binding 2))
    (defn rpmw-frame-find (bindings offset)
        (if (nil? bindings)
            (nothing)
            (if (eq (rpmw-frame-binding-offset (head bindings)) offset)
                (head bindings)
                (rpmw-frame-find (tail bindings) offset))))
    (defn rpmw-frame-put-binding (bindings binding)
        (if (nil? bindings)
            (list binding)
            (if (eq (rpmw-frame-binding-offset (head bindings))
                    (rpmw-frame-binding-offset binding))
                (cons binding (tail bindings))
                (cons (head bindings)
                      (rpmw-frame-put-binding (tail bindings) binding)))))
    (defn rpmw-frame-one (value kind)
        (rpmw-frame-row 1 (list (rpmw-frame-binding 0 value kind))))
    (defn rpmw-frame-reserve (frame let-slots)
        (do
            (let needed (add 1 let-slots))
            (rpmw-frame-row
                (if (gt needed (rpmw-frame-capacity frame))
                    needed (rpmw-frame-capacity frame))
                (rpmw-frame-bindings frame))))
    (defn rpmw-frame-put (frame offset value kind)
        (rpmw-frame-row (rpmw-frame-capacity frame)
            (rpmw-frame-put-binding (rpmw-frame-bindings frame)
                                    (rpmw-frame-binding offset value kind))))

    ; result = ("runtime-program-image-fkb-micro-walker-result" value kind
    ;           steps trace-status stop-reason reason detail)
    (defn rpmw-result-row (value kind steps trace-status stop-reason reason detail)
        (list "runtime-program-image-fkb-micro-walker-result"
              value kind steps trace-status stop-reason reason detail))
    (defn rpmw-result? (r)
        (if (eq (len r) 8)
            (str_eq (nth r 0) "runtime-program-image-fkb-micro-walker-result")
            0))
    (defn rpmw-result-value (r) (nth r 1))
    (defn rpmw-result-kind (r) (nth r 2))
    (defn rpmw-result-steps (r) (nth r 3))
    (defn rpmw-result-trace-status (r) (nth r 4))
    (defn rpmw-result-stop-reason (r) (nth r 5))
    (defn rpmw-result-reason (r) (nth r 6))
    (defn rpmw-result-detail (r) (nth r 7))
    (defn rpmw-result-ok? (r)
        (if (rpmw-result? r)
            (str_eq (rpmw-result-trace-status r) (rao-obs-ok))
            0))
    (defn rpmw-result-ok (value kind steps)
        (rpmw-result-row value kind steps (rao-obs-ok) (rpiwt-stop-completed)
                         (rpmw-reason-walk-completed)
                         (rpmw-detail (rpmw-reason-walk-completed))))
    (defn rpmw-result-timeout (steps)
        (rpmw-result-row 0 (rpmw-kind-absent) steps (rao-obs-timeout) (rpiwt-stop-timeout)
                         (rpmw-reason-step-budget-exhausted)
                         (rpmw-detail (rpmw-reason-step-budget-exhausted))))
    (defn rpmw-result-error (steps reason)
        (rpmw-result-row 0 (rpmw-kind-absent) steps (rao-obs-error) (rpiwt-stop-error)
                         reason (rpmw-detail reason)))
    (defn rpmw-result-add-parent (r)
        (rpmw-result-row (rpmw-result-value r)
                         (rpmw-result-kind r)
                         (add 1 (rpmw-result-steps r))
                         (rpmw-result-trace-status r)
                         (rpmw-result-stop-reason r)
                         (rpmw-result-reason r)
                         (rpmw-result-detail r)))
    (defn rpmw-result-add-prefix (r prefix-steps)
        (rpmw-result-row (rpmw-result-value r)
                         (rpmw-result-kind r)
                         (add prefix-steps (rpmw-result-steps r))
                         (rpmw-result-trace-status r)
                         (rpmw-result-stop-reason r)
                         (rpmw-result-reason r)
                         (rpmw-result-detail r)))

    ; v1 receipt = ("runtime-program-image-fkb-micro-walker" envelope admission
    ;               entry-index root-node step-budget input-value trace result
    ;               status reason)
    ; v2 appends input-kind. Every v1 coordinate stays fixed; a held v1 row
    ; therefore remains an integer-input witness instead of changing meaning.
    (defn rpmw-receipt-row (envelope admission entry-index root-node step-budget input-value trace result status reason)
        (list "runtime-program-image-fkb-micro-walker"
              envelope admission entry-index root-node step-budget input-value
              trace result status reason))
    (defn rpmw-receipt-row-v2 (envelope admission entry-index root-node step-budget input-value trace result status reason input-kind)
        (append
            (rpmw-receipt-row envelope admission entry-index root-node
                step-budget input-value trace result status reason)
            (list input-kind)))
    (defn rpmw-receipt? (r)
        (if (or (eq (len r) 11) (eq (len r) 12))
            (str_eq (nth r 0) "runtime-program-image-fkb-micro-walker")
            0))
    (defn rpmw-receipt-envelope (r) (nth r 1))
    (defn rpmw-receipt-admission (r) (nth r 2))
    (defn rpmw-receipt-entry-index (r) (nth r 3))
    (defn rpmw-receipt-root-node (r) (nth r 4))
    (defn rpmw-receipt-step-budget (r) (nth r 5))
    (defn rpmw-receipt-input-value (r) (nth r 6))
    (defn rpmw-receipt-trace (r) (nth r 7))
    (defn rpmw-receipt-result (r) (nth r 8))
    (defn rpmw-receipt-status (r) (nth r 9))
    (defn rpmw-receipt-reason (r) (nth r 10))
    (defn rpmw-receipt-input-kind (r)
        (if (eq (len r) 12) (nth r 11) (rpmw-kind-int)))
    (defn rpmw-refused (envelope admission entry-index step-budget input-value reason)
        (rpmw-receipt-row envelope admission entry-index -1 step-budget input-value
                          (rpmw-no-trace) (rpmw-no-result)
                          (rpmw-status-refused) reason))
    (defn rpmw-produced (envelope admission entry-index root-node step-budget input-value trace result)
        (rpmw-receipt-row envelope admission entry-index root-node step-budget input-value
                          trace result (rpmw-status-trace-produced)
                          (rpmw-result-reason result)))
    (defn rpmw-refused-with-kind (envelope admission entry-index step-budget input-value input-kind reason)
        (rpmw-receipt-row-v2 envelope admission entry-index -1 step-budget
            input-value (rpmw-no-trace) (rpmw-no-result)
            (rpmw-status-refused) reason input-kind))
    (defn rpmw-produced-with-kind (envelope admission entry-index root-node step-budget input-value input-kind trace result)
        (rpmw-receipt-row-v2 envelope admission entry-index root-node step-budget
            input-value trace result (rpmw-status-trace-produced)
            (rpmw-result-reason result) input-kind))

    (defn rpmw-program-image-envelope? (envelope)
        (if (rale-envelope? envelope)
            (if (str_eq (rale-envelope-status envelope) (rale-status-request-ready))
                (if (str_eq (rale-envelope-action envelope) (rap-act-run-program-image))
                    (if (eq (rale-envelope-route envelope) (sac-run-fkb))
                        (str_eq (rale-envelope-artifact-kind envelope) (sad-kind-program-image-fkb))
                        0)
                    0)
                0)
            0))
    (defn rpmw-admission-status-admitted? (admission)
        (if (pifbd-admission? admission)
            (and (str_eq (pifbd-admission-status admission) (pifbd-status-admitted))
                 (str_eq (pifbd-admission-reason admission) (pifbd-reason-admitted)))
            0))
    (defn rpmw-admission-decode-decoded? (admission)
        (if (pifbd-admission? admission)
            (pifbd-decoded? (pifbd-admission-decode admission))
            0))
    (defn rpmw-admission-pif-valid? (admission)
        (if (pifbd-admission? admission)
            (pif-envelope-valid? (pifbd-admission-pif admission))
            0))
    (defn rpmw-admission-decode-matches-pif? (admission)
        (if (and (rpmw-admission-decode-decoded? admission)
                 (rpmw-admission-pif-valid? admission))
            (do
                (let payload (pifbd-decode-payload (pifbd-admission-decode admission)))
                (let pif (pifbd-admission-pif admission))
                (and (pifbd-payload-source-matches-pif? payload pif)
                (and (pifbd-payload-artifact-path-matches-pif? payload pif)
                (and (pifbd-payload-seal-matches-pif? payload pif)
                (and (pifbd-payload-table-matches-pif? payload pif)
                     (pifbd-payload-symbol-matches-pif? payload pif))))))
            0))
    (defn rpmw-pif-matches-envelope? (envelope pif)
        (if (pif-envelope-valid? pif)
            (if (str_eq (pif-envelope-artifact-path pif) (rale-envelope-artifact-path envelope))
                (if (str_eq (pif-envelope-source-hash pif) (rale-envelope-source-hash envelope))
                    (str_eq (pif-envelope-content-hash pif) (rale-envelope-content-hash envelope))
                    0)
                0)
            0))

    (defn rpmw-node-row (table node-id)
        (nth (pif-table-node-rows table) node-id))
    (defn rpmw-row-tag (row) (nth row 0))
    (defn rpmw-row-a (row) (nth row 1))
    (defn rpmw-row-b (row) (nth row 2))
    (defn rpmw-row-c (row) (nth row 3))
    (defn rpmw-node-id-valid? (table node-id)
        (if (ge node-id 0)
            (lt node-id (pif-table-nr table))
            0))
    (defn rpmw-entry-index-valid? (table entry-index)
        (if (ge entry-index 0)
            (lt entry-index (pif-table-nf table))
            0))
    (defn rpmw-binary-child-valid? (table row)
        (and (rpmw-node-id-valid? table (rpmw-row-a row))
             (rpmw-node-id-valid? table (rpmw-row-b row))))
    (defn rpmw-if-child-valid? (table row)
        (and (rpmw-node-id-valid? table (rpmw-row-a row))
        (and (rpmw-node-id-valid? table (rpmw-row-b row))
             (rpmw-node-id-valid? table (rpmw-row-c row)))))
    (defn rpmw-binary-value (tag left right)
        (if (eq tag 3)
            (add left right)
            (if (eq tag 4)
                (sub left right)
                (if (eq tag 42)
                    (mul left right)
                    (if (eq tag 5)
                        (if (le left right) 1 0)
                        (if (eq tag 102)
                            (if (eq left right) 1 0)
                            (if (eq tag 103)
                                (if (lt left right) 1 0)
                                0)))))))
    (defn rpmw-binary-supported? (tag)
        (if (eq tag 3) 1
            (if (eq tag 4) 1
                (if (eq tag 42) 1
                    (if (eq tag 5) 1
                        (if (eq tag 102) 1
                            (if (eq tag 103) 1 0)))))))

    (defn rpmw-eval-binary-after-left (table row budget input-value input-kind left)
        (if (not (rpmw-result-ok? left))
            (rpmw-result-add-parent left)
            (do
                (let remaining (sub (sub budget 1) (rpmw-result-steps left)))
                (if (le remaining 0)
                    (rpmw-result-timeout (add 1 (rpmw-result-steps left)))
                    (do
                        (let right (rpmw-eval-node table (rpmw-row-b row) remaining input-value input-kind))
                        (if (not (rpmw-result-ok? right))
                            (rpmw-result-row (rpmw-result-value right)
                                             (rpmw-result-kind right)
                                             (add 1 (add (rpmw-result-steps left) (rpmw-result-steps right)))
                                             (rpmw-result-trace-status right)
                                             (rpmw-result-stop-reason right)
                                             (rpmw-result-reason right)
                                             (rpmw-result-detail right))
                            (do
                                (let spent
                                    (add 1 (add (rpmw-result-steps left)
                                                (rpmw-result-steps right))))
                                (if (or (not (rpmw-int? (rpmw-result-kind left)))
                                        (not (rpmw-int? (rpmw-result-kind right))))
                                    (rpmw-result-error spent
                                        (rpmw-reason-integer-value-required))
                                    (rpmw-result-ok
                                        (rpmw-binary-value (rpmw-row-tag row)
                                            (rpmw-result-value left)
                                            (rpmw-result-value right))
                                        (rpmw-kind-int) spent)))))))))
    (defn rpmw-eval-binary (table row budget input-value input-kind)
        (if (not (rpmw-binary-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-binary-after-left table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    ; Packed multi-parameter calls already arrive as ordinary Form lists:
    ; EMPTY/CONS construct the one call argument and NTH recovers a callee
    ; parameter.  These values stay in the admitted resident walk; the legacy
    ; supplied-run bridge remains integer-only and is not involved here.
    (defn rpmw-list-pair-supported? (tag)
        (if (eq tag 19) 1 (if (eq tag 23) 1 0)))
    (defn rpmw-eval-list-pair-after-left (table row budget input-value input-kind left)
        (if (not (rpmw-result-ok? left))
            (rpmw-result-add-parent left)
            (do
                (let remaining (sub (sub budget 1) (rpmw-result-steps left)))
                (if (le remaining 0)
                    (rpmw-result-timeout (add 1 (rpmw-result-steps left)))
                    (do
                        (let right (rpmw-eval-node table (rpmw-row-b row)
                                                   remaining input-value input-kind))
                        (if (not (rpmw-result-ok? right))
                            (rpmw-result-row
                                (rpmw-result-value right)
                                (rpmw-result-kind right)
                                (add 1 (add (rpmw-result-steps left)
                                            (rpmw-result-steps right)))
                                (rpmw-result-trace-status right)
                                (rpmw-result-stop-reason right)
                                (rpmw-result-reason right)
                                (rpmw-result-detail right))
                            (do
                                (let spent (add 1
                                    (add (rpmw-result-steps left)
                                         (rpmw-result-steps right))))
                                (if (eq (rpmw-row-tag row) 19)
                                    (if (not (rpmw-list? (rpmw-result-kind right)))
                                        (rpmw-result-error spent
                                            (rpmw-reason-list-value-required))
                                        (rpmw-result-ok
                                            (cons (rpmw-result-value left)
                                                  (rpmw-result-value right))
                                            (rpmw-kind-list
                                                (cons (rpmw-result-kind left)
                                                    (rpmw-kind-children
                                                        (rpmw-result-kind right))))
                                            spent))
                                    ; Refuse invalid raw PIF NTH kinds and
                                    ; coordinates before host nth can reinterpret
                                    ; malformed values. Positive misses remain
                                    ; successful, present nothing.
                                    (if (not (rpmw-list? (rpmw-result-kind left)))
                                        (rpmw-result-error spent
                                            (rpmw-reason-list-value-required))
                                        (if (not (rpmw-int? (rpmw-result-kind right)))
                                            (rpmw-result-error spent
                                                (rpmw-reason-integer-value-required))
                                            (if (lt (rpmw-result-value right) 0)
                                                (rpmw-result-error spent
                                                    (rpmw-reason-negative-list-index))
                                                (if (ge (rpmw-result-value right)
                                                        (len (rpmw-result-value left)))
                                                    (rpmw-result-ok (nothing)
                                                        (rpmw-kind-nothing) spent)
                                                    (rpmw-result-ok
                                                        (nth (rpmw-result-value left)
                                                             (rpmw-result-value right))
                                                        (nth (rpmw-kind-children
                                                                (rpmw-result-kind left))
                                                             (rpmw-result-value right))
                                                        spent)))))))))))))
    (defn rpmw-eval-list-pair (table row budget input-value input-kind)
        (if (not (rpmw-binary-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-list-pair-after-left table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    (defn rpmw-list-unary-supported? (tag)
        (if (eq tag 20) 1
            (if (eq tag 21) 1
                (if (eq tag 22) 1
                    (if (eq tag 138) 1 0)))))
    (defn rpmw-list-unary-value (tag value kind)
        (if (eq tag 20) (if (eq (len value) 0) (empty) (head value))
            (if (eq tag 21) (tail value)
                (if (eq tag 22) (len value)
                    (if (rpmw-kind-named? kind "nothing") 1 0)))))
    (defn rpmw-list-unary-kind (tag value kind)
        (if (eq tag 20)
            (if (eq (len value) 0)
                (rpmw-kind-list (empty))
                (head (rpmw-kind-children kind)))
            (if (eq tag 21)
                (rpmw-kind-list (tail (rpmw-kind-children kind)))
                (rpmw-kind-int))))
    (defn rpmw-eval-list-unary (table row budget input-value input-kind)
        (if (not (rpmw-node-id-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (do
                (let child (rpmw-eval-node table (rpmw-row-a row)
                                           (sub budget 1) input-value input-kind))
                (if (not (rpmw-result-ok? child))
                    (rpmw-result-add-parent child)
                    (do
                        (let spent (add 1 (rpmw-result-steps child)))
                        (if (and (not (eq (rpmw-row-tag row) 138))
                                 (not (rpmw-list? (rpmw-result-kind child))))
                            (rpmw-result-error spent
                                (rpmw-reason-list-value-required))
                            (rpmw-result-ok
                                (rpmw-list-unary-value (rpmw-row-tag row)
                                    (rpmw-result-value child)
                                    (rpmw-result-kind child))
                                (rpmw-list-unary-kind (rpmw-row-tag row)
                                    (rpmw-result-value child)
                                    (rpmw-result-kind child))
                                spent)))))))

    ; The admitted PIF carries each literal as one byte row.  Resident walks
    ; decode those bytes into the host kernel's real Form string value; emitted
    ; siblings may use pool ids internally, but that machine representation
    ; never leaks into this typed trace.
    (defn rpmw-string? (kind) (rpmw-kind-named? kind "string"))
    (defn rpmw-int? (kind) (rpmw-kind-named? kind "int"))
    (defn rpmw-list? (kind) (rpmw-kind-named? kind "list"))
    (defn rpmw-string-pool-index-valid? (table pool-index)
        (if (ge pool-index 0)
            (lt pool-index (pif-table-ns table))
            0))
    (defn rpmw-string-pool-value (table pool-index)
        (pifbd-bytes-to-string
            (nth (pif-table-string-byte-rows table) pool-index)))
    (defn rpmw-eval-string-literal (table row)
        (if (rpmw-string-pool-index-valid? table (rpmw-row-a row))
            (rpmw-result-ok
                (rpmw-string-pool-value table (rpmw-row-a row))
                (rpmw-kind-string) 1)
            (rpmw-result-error 1
                (rpmw-reason-string-pool-index-out-of-range))))

    (defn rpmw-string-unary-supported? (tag)
        (if (eq tag 25) 1 (if (eq tag 32) 1 0)))
    (defn rpmw-string-unary-kind-valid? (tag kind)
        (if (eq tag 25) (rpmw-string? kind) (rpmw-int? kind)))
    (defn rpmw-string-unary-kind-reason (tag)
        (if (eq tag 25)
            (rpmw-reason-string-value-required)
            (rpmw-reason-integer-value-required)))
    (defn rpmw-string-unary-value (tag value)
        (if (eq tag 25) (str_len value) (int_to_str value)))
    (defn rpmw-eval-string-unary (table row budget input-value input-kind)
        (if (not (rpmw-node-id-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (do
                (let child (rpmw-eval-node table (rpmw-row-a row)
                                           (sub budget 1) input-value input-kind))
                (if (not (rpmw-result-ok? child))
                    (rpmw-result-add-parent child)
                    (do
                        (let spent (add 1 (rpmw-result-steps child)))
                        (if (rpmw-string-unary-kind-valid?
                                (rpmw-row-tag row)
                                (rpmw-result-kind child))
                            (rpmw-result-ok
                                (rpmw-string-unary-value
                                    (rpmw-row-tag row)
                                    (rpmw-result-value child))
                                (if (eq (rpmw-row-tag row) 25)
                                    (rpmw-kind-int)
                                    (rpmw-kind-string))
                                spent)
                            (rpmw-result-error spent
                                (rpmw-string-unary-kind-reason
                                    (rpmw-row-tag row)))))))))

    (defn rpmw-string-binary-supported? (tag)
        (if (eq tag 26) 1
            (if (eq tag 27) 1
                (if (eq tag 28) 1 0))))
    (defn rpmw-string-binary-after-values
        (tag left left-kind right right-kind spent)
        (if (not (rpmw-string? left-kind))
            (rpmw-result-error spent (rpmw-reason-string-value-required))
            (if (eq tag 28)
                (if (not (rpmw-int? right-kind))
                    (rpmw-result-error spent
                        (rpmw-reason-integer-value-required))
                    (if (or (lt right 0) (ge right (str_len left)))
                        (rpmw-result-error spent
                            (rpmw-reason-string-byte-index-out-of-range))
                        (rpmw-result-ok (str_byte_at left right)
                            (rpmw-kind-int) spent)))
                (if (not (rpmw-string? right-kind))
                    (rpmw-result-error spent
                        (rpmw-reason-string-value-required))
                    (if (eq tag 26)
                        (rpmw-result-ok (if (str_eq left right) 1 0)
                            (rpmw-kind-int) spent)
                        (rpmw-result-ok (str_concat left right)
                            (rpmw-kind-string) spent))))))
    (defn rpmw-eval-string-binary-after-left
        (table row budget input-value input-kind left)
        (if (not (rpmw-result-ok? left))
            (rpmw-result-add-parent left)
            (do
                (let remaining
                    (sub (sub budget 1) (rpmw-result-steps left)))
                (if (le remaining 0)
                    (rpmw-result-timeout (add 1 (rpmw-result-steps left)))
                    (do
                        (let right (rpmw-eval-node table (rpmw-row-b row)
                                                   remaining input-value input-kind))
                        (if (not (rpmw-result-ok? right))
                            (rpmw-result-row
                                (rpmw-result-value right)
                                (rpmw-result-kind right)
                                (add 1 (add (rpmw-result-steps left)
                                            (rpmw-result-steps right)))
                                (rpmw-result-trace-status right)
                                (rpmw-result-stop-reason right)
                                (rpmw-result-reason right)
                                (rpmw-result-detail right))
                            (rpmw-string-binary-after-values
                                (rpmw-row-tag row)
                                (rpmw-result-value left)
                                (rpmw-result-kind left)
                                (rpmw-result-value right)
                                (rpmw-result-kind right)
                                (add 1 (add (rpmw-result-steps left)
                                            (rpmw-result-steps right))))))))))
    (defn rpmw-eval-string-binary (table row budget input-value input-kind)
        (if (not (rpmw-binary-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-string-binary-after-left table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    (defn rpmw-string-ternary-supported? (tag)
        (if (eq tag 29) 1 (if (eq tag 30) 1 0)))
    (defn rpmw-string-ternary-after-values
        (tag first first-kind second second-kind third third-kind spent)
        (if (not (rpmw-string? first-kind))
            (rpmw-result-error spent (rpmw-reason-string-value-required))
            (if (eq tag 29)
                (if (or (not (rpmw-int? second-kind))
                        (not (rpmw-int? third-kind)))
                    (rpmw-result-error spent
                        (rpmw-reason-integer-value-required))
                    (if (or (lt second 0)
                        (or (lt third second)
                            (gt third (str_len first))))
                        (rpmw-result-error spent
                            (rpmw-reason-substring-bounds-invalid))
                        (rpmw-result-ok
                            (substring first second third)
                            (rpmw-kind-string) spent)))
                (if (not (rpmw-string? second-kind))
                    (rpmw-result-error spent
                        (rpmw-reason-string-value-required))
                    (if (not (rpmw-int? third-kind))
                        (rpmw-result-error spent
                            (rpmw-reason-integer-value-required))
                        (rpmw-result-ok
                            (str_find first second
                                (if (lt third 0) 0 third))
                            (rpmw-kind-int)
                            spent))))))
    (defn rpmw-eval-string-ternary-after-second
        (table row budget input-value input-kind first second)
        (if (not (rpmw-result-ok? second))
            (rpmw-result-row
                (rpmw-result-value second)
                (rpmw-result-kind second)
                (add 1 (add (rpmw-result-steps first)
                            (rpmw-result-steps second)))
                (rpmw-result-trace-status second)
                (rpmw-result-stop-reason second)
                (rpmw-result-reason second)
                (rpmw-result-detail second))
            (do
                (let spent-two (add 1 (add (rpmw-result-steps first)
                                           (rpmw-result-steps second))))
                (let remaining (sub budget spent-two))
                (if (le remaining 0)
                    (rpmw-result-timeout spent-two)
                    (do
                        (let third (rpmw-eval-node table (rpmw-row-c row)
                                                   remaining input-value input-kind))
                        (if (not (rpmw-result-ok? third))
                            (rpmw-result-row
                                (rpmw-result-value third)
                                (rpmw-result-kind third)
                                (add spent-two (rpmw-result-steps third))
                                (rpmw-result-trace-status third)
                                (rpmw-result-stop-reason third)
                                (rpmw-result-reason third)
                                (rpmw-result-detail third))
                            (rpmw-string-ternary-after-values
                                (rpmw-row-tag row)
                                (rpmw-result-value first)
                                (rpmw-result-kind first)
                                (rpmw-result-value second)
                                (rpmw-result-kind second)
                                (rpmw-result-value third)
                                (rpmw-result-kind third)
                                (add spent-two
                                    (rpmw-result-steps third)))))))))
    (defn rpmw-eval-string-ternary-after-first
        (table row budget input-value input-kind first)
        (if (not (rpmw-result-ok? first))
            (rpmw-result-add-parent first)
            (do
                (let remaining
                    (sub (sub budget 1) (rpmw-result-steps first)))
                (if (le remaining 0)
                    (rpmw-result-timeout (add 1 (rpmw-result-steps first)))
                    (rpmw-eval-string-ternary-after-second
                        table row budget input-value input-kind first
                        (rpmw-eval-node table (rpmw-row-b row)
                                        remaining input-value input-kind))))))
    (defn rpmw-eval-string-ternary (table row budget input-value input-kind)
        (if (not (rpmw-if-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-string-ternary-after-first table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    (defn rpmw-eval-if-after-cond (table row budget input-value input-kind cond)
        (if (not (rpmw-result-ok? cond))
            (rpmw-result-add-parent cond)
            (do
                (let spent-cond (add 1 (rpmw-result-steps cond)))
                (if (not (rpmw-int? (rpmw-result-kind cond)))
                    (rpmw-result-error spent-cond
                        (rpmw-reason-integer-value-required))
                    (do
                        (let remaining (sub budget spent-cond))
                        (if (le remaining 0)
                            (rpmw-result-timeout spent-cond)
                            (do
                                (let branch (if (eq (rpmw-result-value cond) 0)
                                                (rpmw-row-c row) (rpmw-row-b row)))
                                (let out (rpmw-eval-node table branch remaining
                                                        input-value input-kind))
                                (if (not (rpmw-result-ok? out))
                                    (rpmw-result-row (rpmw-result-value out)
                                        (rpmw-result-kind out)
                                        (add spent-cond (rpmw-result-steps out))
                                        (rpmw-result-trace-status out)
                                        (rpmw-result-stop-reason out)
                                        (rpmw-result-reason out)
                                        (rpmw-result-detail out))
                                    (rpmw-result-ok (rpmw-result-value out)
                                        (rpmw-result-kind out)
                                        (add spent-cond
                                            (rpmw-result-steps out)))))))))))
    (defn rpmw-eval-if (table row budget input-value input-kind)
        (if (not (rpmw-if-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-if-after-cond table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    ; Native Form nodes stay native across the resident image.  The host
    ; value is never inspected to rediscover its subtype: every constructor
    ; creates an exact kind, composite kinds retain their child kinds, and
    ; readers recover provenance from that lineage.
    (defn rpmw-node-unary-supported? (tag)
        (if (eq tag 43) 1
            (if (eq tag 46) 1
                (if (eq tag 48) 1
                    (if (eq tag 49) 1
                        (if (eq tag 91) 1
                            (if (eq tag 92) 1 0)))))))
    (defn rpmw-node-binary-supported? (tag)
        (if (eq tag 47) 1 (if (eq tag 80) 1 0)))
    (defn rpmw-eval-node-unary-after-child (row child)
        (if (not (rpmw-result-ok? child))
            (rpmw-result-add-parent child)
            (do
                (let spent (add 1 (rpmw-result-steps child)))
                (let tag (rpmw-row-tag row))
                (if (eq tag 91)
                    (if (not (rpmw-list? (rpmw-result-kind child)))
                        (rpmw-result-error spent
                            (rpmw-reason-nodeid-components-required))
                        (if (not (eq (len (rpmw-result-value child)) 4))
                            (rpmw-result-error spent
                                (rpmw-reason-nodeid-components-required))
                            (if (not (rpmw-int-kinds?
                                        (rpmw-kind-children
                                            (rpmw-result-kind child))))
                                (rpmw-result-error spent
                                    (rpmw-reason-nodeid-coordinate-integer-required))
                                (rpmw-result-ok
                                    (make_nodeid
                                        (nth (rpmw-result-value child) 0)
                                        (nth (rpmw-result-value child) 1)
                                        (nth (rpmw-result-value child) 2)
                                        (nth (rpmw-result-value child) 3))
                                    (rpmw-kind-nodeid) spent))))
                    (if (eq tag 43)
                        (if (not (rpmw-int? (rpmw-result-kind child)))
                            (rpmw-result-error spent
                                (rpmw-reason-integer-value-required))
                            (rpmw-result-ok
                                (intern_trivial_int (rpmw-result-value child))
                                (rpmw-kind-trivial-int-node) spent))
                        (if (eq tag 46)
                            (if (not (rpmw-string? (rpmw-result-kind child)))
                                (rpmw-result-error spent
                                    (rpmw-reason-string-value-required))
                                (rpmw-result-ok
                                    (intern_trivial_string
                                        (rpmw-result-value child))
                                    (rpmw-kind-trivial-string-node) spent))
                            (if (eq tag 48)
                                (if (not (rpmw-composite-node?
                                            (rpmw-result-kind child)))
                                    (rpmw-result-error spent
                                        (rpmw-reason-composite-node-required))
                                    (rpmw-result-ok
                                        (node_children
                                            (rpmw-result-value child))
                                        (rpmw-kind-list
                                            (rpmw-kind-children
                                                (rpmw-result-kind child)))
                                        spent))
                                (if (eq tag 49)
                                    (if (rpmw-trivial-int-node?
                                            (rpmw-result-kind child))
                                        (rpmw-result-ok
                                            (node_value
                                                (rpmw-result-value child))
                                            (rpmw-kind-int) spent)
                                        (if (rpmw-trivial-string-node?
                                                (rpmw-result-kind child))
                                            (rpmw-result-ok
                                                (node_value
                                                    (rpmw-result-value child))
                                                (rpmw-kind-string) spent)
                                            (rpmw-result-error spent
                                                (rpmw-reason-trivial-node-required))))
                                    (if (not (rpmw-composite-node?
                                                (rpmw-result-kind child)))
                                        (rpmw-result-error spent
                                            (rpmw-reason-composite-node-required))
                                        (rpmw-result-ok
                                            (node_category
                                                (rpmw-result-value child))
                                            (rpmw-kind-nodeid) spent))))))))))
    (defn rpmw-eval-node-unary
        (table row budget input-value input-kind)
        (if (not (rpmw-node-id-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-node-unary-after-child row
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    (defn rpmw-eval-node-binary-after-left
        (table row budget input-value input-kind left)
        (if (not (rpmw-result-ok? left))
            (rpmw-result-add-parent left)
            (do
                (let remaining
                    (sub (sub budget 1) (rpmw-result-steps left)))
                (if (le remaining 0)
                    (rpmw-result-timeout
                        (add 1 (rpmw-result-steps left)))
                    (do
                        (let right
                            (rpmw-eval-node table (rpmw-row-b row) remaining
                                            input-value input-kind))
                        (if (not (rpmw-result-ok? right))
                            (rpmw-result-row
                                (rpmw-result-value right)
                                (rpmw-result-kind right)
                                (add 1 (add (rpmw-result-steps left)
                                            (rpmw-result-steps right)))
                                (rpmw-result-trace-status right)
                                (rpmw-result-stop-reason right)
                                (rpmw-result-reason right)
                                (rpmw-result-detail right))
                            (do
                                (let spent
                                    (add 1 (add (rpmw-result-steps left)
                                                (rpmw-result-steps right))))
                                (if (eq (rpmw-row-tag row) 47)
                                    (if (not (rpmw-nodeid?
                                                (rpmw-result-kind left)))
                                        (rpmw-result-error spent
                                            (rpmw-reason-node-value-required))
                                        (if (not (rpmw-list?
                                                    (rpmw-result-kind right)))
                                            (rpmw-result-error spent
                                                (rpmw-reason-node-children-required))
                                            (if (not (rpmw-native-node-kinds?
                                                        (rpmw-kind-children
                                                            (rpmw-result-kind right))))
                                                (rpmw-result-error spent
                                                    (rpmw-reason-node-children-required))
                                                (rpmw-result-ok
                                                    (intern_node
                                                        (rpmw-result-value left)
                                                        (rpmw-result-value right))
                                                    (rpmw-kind-composite-node
                                                        (rpmw-kind-children
                                                            (rpmw-result-kind right)))
                                                    spent))))
                                    (if (or
                                            (not (rpmw-native-node?
                                                    (rpmw-result-kind left)))
                                            (not (rpmw-native-node?
                                                    (rpmw-result-kind right))))
                                        (rpmw-result-error spent
                                            (rpmw-reason-node-value-required))
                                        (rpmw-result-ok
                                            (if (node_eq
                                                    (rpmw-result-value left)
                                                    (rpmw-result-value right))
                                                1 0)
                                            (rpmw-kind-int) spent))))))))))
    (defn rpmw-eval-node-binary
        (table row budget input-value input-kind)
        (if (not (rpmw-binary-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-node-binary-after-left
                table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    ; SEQ spends the first child's complete observation, then returns the
    ; second child's exact value and kind. A failed or timed-out first child
    ; stops the sequence; neither state is converted into a zero-shaped value.
    (defn rpmw-eval-sequence-after-left
        (table row budget input-value input-kind left)
        (if (not (rpmw-result-ok? left))
            (rpmw-result-add-parent left)
            (do
                (let spent-left (add 1 (rpmw-result-steps left)))
                (let remaining (sub budget spent-left))
                (if (le remaining 0)
                    (rpmw-result-timeout spent-left)
                    (if (not (rpmw-node-id-valid? table (rpmw-row-b row)))
                        (rpmw-result-error spent-left
                            (rpmw-reason-child-out-of-range))
                        (rpmw-result-add-prefix
                            (rpmw-eval-node table (rpmw-row-b row) remaining
                                            input-value input-kind)
                            spent-left))))))
    (defn rpmw-eval-sequence
        (table row budget input-value input-kind)
        (if (not (rpmw-node-id-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-sequence-after-left
                table row budget input-value input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                input-value input-kind))))

    ; Explicit source frames. The evaluator carries one immutable sparse frame
    ; through a function walk. LETF gives only its body the updated binding;
    ; returning or timing out therefore releases it without a mutation path.
    (defn rpmw-frame-read-result (frame offset spent)
        (if (not (rpmw-frame? frame))
            (rpmw-result-error spent (rpmw-reason-frame-slot-out-of-range))
            (if (lt offset 0)
                (rpmw-result-error spent (rpmw-reason-negative-frame-offset))
                (if (ge offset (rpmw-frame-capacity frame))
                    (rpmw-result-error spent (rpmw-reason-frame-slot-out-of-range))
                    (do
                        (let binding (rpmw-frame-find
                            (rpmw-frame-bindings frame) offset))
                        (if (nothing? binding)
                            (rpmw-result-error spent
                                (rpmw-reason-frame-slot-uninitialized))
                            (rpmw-result-ok
                                (rpmw-frame-binding-value binding)
                                (rpmw-frame-binding-kind binding)
                                spent)))))))
    (defn rpmw-eval-frame-read-after-offset (frame offset-result)
        (if (not (rpmw-result-ok? offset-result))
            (rpmw-result-add-parent offset-result)
            (do
                (let spent (add 1 (rpmw-result-steps offset-result)))
                (if (not (rpmw-int? (rpmw-result-kind offset-result)))
                    (rpmw-result-error spent
                        (rpmw-reason-integer-value-required))
                    (rpmw-frame-read-result frame
                        (rpmw-result-value offset-result) spent)))))
    (defn rpmw-eval-frame-read (table row budget frame input-kind)
        (if (not (rpmw-node-id-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-frame-read-after-offset frame
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                frame input-kind))))

    (defn rpmw-eval-frame-store-after-value
        (table row budget frame input-kind offset-result spent-offset value-result)
        (if (not (rpmw-result-ok? value-result))
            (rpmw-result-add-prefix value-result spent-offset)
            (do
                (let spent-value
                    (add spent-offset (rpmw-result-steps value-result)))
                (let remaining (sub budget spent-value))
                (if (le remaining 0)
                    (rpmw-result-timeout spent-value)
                    (rpmw-result-add-prefix
                        (rpmw-eval-node table (rpmw-row-c row) remaining
                            (rpmw-frame-put frame
                                (rpmw-result-value offset-result)
                                (rpmw-result-value value-result)
                                (rpmw-result-kind value-result))
                            input-kind)
                        spent-value)))))
    (defn rpmw-eval-frame-store-after-offset
        (table row budget frame input-kind offset-result)
        (if (not (rpmw-result-ok? offset-result))
            (rpmw-result-add-parent offset-result)
            (do
                (let spent-offset (add 1 (rpmw-result-steps offset-result)))
                (if (not (rpmw-int? (rpmw-result-kind offset-result)))
                    (rpmw-result-error spent-offset
                        (rpmw-reason-integer-value-required))
                    (if (lt (rpmw-result-value offset-result) 0)
                        (rpmw-result-error spent-offset
                            (rpmw-reason-negative-frame-offset))
                        (if (ge (rpmw-result-value offset-result)
                                (rpmw-frame-capacity frame))
                            (rpmw-result-error spent-offset
                                (rpmw-reason-frame-slot-out-of-range))
                            (do
                                (let remaining (sub budget spent-offset))
                                (if (le remaining 0)
                                    (rpmw-result-timeout spent-offset)
                                    (rpmw-eval-frame-store-after-value
                                        table row budget frame input-kind
                                        offset-result spent-offset
                                        (rpmw-eval-node table (rpmw-row-b row)
                                            remaining frame input-kind))))))))))
    (defn rpmw-eval-frame-store (table row budget frame input-kind)
        (if (not (rpmw-if-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-frame-store-after-offset
                table row budget frame input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                frame input-kind))))

    (defn rpmw-eval-frame-reserve-after-size
        (table row budget frame input-kind size-result)
        (if (not (rpmw-result-ok? size-result))
            (rpmw-result-add-parent size-result)
            (do
                (let spent-size (add 1 (rpmw-result-steps size-result)))
                (if (not (rpmw-int? (rpmw-result-kind size-result)))
                    (rpmw-result-error spent-size
                        (rpmw-reason-integer-value-required))
                    (if (lt (rpmw-result-value size-result) 0)
                        (rpmw-result-error spent-size
                            (rpmw-reason-negative-frame-reserve))
                        (do
                            (let remaining (sub budget spent-size))
                            (if (le remaining 0)
                                (rpmw-result-timeout spent-size)
                                (rpmw-result-add-prefix
                                    (rpmw-eval-node table (rpmw-row-b row)
                                        remaining
                                        (rpmw-frame-reserve frame
                                            (rpmw-result-value size-result))
                                        input-kind)
                                    spent-size))))))))
    (defn rpmw-eval-frame-reserve (table row budget frame input-kind)
        (if (not (rpmw-binary-child-valid? table row))
            (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
            (rpmw-eval-frame-reserve-after-size
                table row budget frame input-kind
                (rpmw-eval-node table (rpmw-row-a row) (sub budget 1)
                                frame input-kind))))

    ; Tag 12 is the source runner's one-argument direct call. The PIF keeps
    ; function roots in its own admitted table, so this crossing spends no
    ; global fk_fn seat: evaluate the argument, bind it as the callee input,
    ; and continue at the target root under the remaining budget.
    (defn rpmw-eval-call-after-argument (table row budget argument)
        (if (not (rpmw-result-ok? argument))
            (rpmw-result-add-parent argument)
            (do
                (let spent-with-call (add 1 (rpmw-result-steps argument)))
                (let remaining (sub budget spent-with-call))
                (if (le remaining 0)
                    (rpmw-result-timeout spent-with-call)
                    (do
                        (let target-root (nth (pif-table-fn-roots table) (rpmw-row-a row)))
                        (if (not (rpmw-node-id-valid? table target-root))
                            (rpmw-result-error spent-with-call (rpmw-reason-root-node-out-of-range))
                            (do
                                (let out (rpmw-eval-node table target-root remaining
                                        (rpmw-frame-one
                                            (rpmw-result-value argument)
                                            (rpmw-result-kind argument))
                                        (rpmw-kind-absent)))
                                (rpmw-result-row
                                    (rpmw-result-value out)
                                    (rpmw-result-kind out)
                                    (add spent-with-call (rpmw-result-steps out))
                                    (rpmw-result-trace-status out)
                                    (rpmw-result-stop-reason out)
                                    (rpmw-result-reason out)
                                    (rpmw-result-detail out)))))))))
    (defn rpmw-eval-call (table row budget input-value input-kind)
        (if (not (rpmw-entry-index-valid? table (rpmw-row-a row)))
            (rpmw-result-error 1 (rpmw-reason-call-target-out-of-range))
            (if (not (rpmw-node-id-valid? table (rpmw-row-b row)))
                (rpmw-result-error 1 (rpmw-reason-child-out-of-range))
                (rpmw-eval-call-after-argument
                    table row budget
                    (rpmw-eval-node table (rpmw-row-b row) (sub budget 1)
                                    input-value input-kind)))))

    (defn rpmw-eval-node (table node-id budget input-value input-kind)
        (if (le budget 0)
            (rpmw-result-timeout 0)
            (if (not (rpmw-node-id-valid? table node-id))
                (rpmw-result-error 0 (rpmw-reason-child-out-of-range))
                (do
                    (let row (rpmw-node-row table node-id))
                    (let tag (rpmw-row-tag row))
                    (if (eq tag 1)
                        (rpmw-result-ok (rpmw-row-a row) (rpmw-kind-int) 1)
                        (if (eq tag 2)
                            (rpmw-frame-read-result input-value 0 1)
                            (if (eq tag 12)
                                (rpmw-eval-call table row budget input-value input-kind)
                                (if (eq tag 18)
                                    (rpmw-result-ok (empty)
                                        (rpmw-kind-list (empty)) 1)
                                    (if (eq tag 24)
                                        (rpmw-eval-string-literal table row)
                                        (if (eq tag 137)
                                            (rpmw-result-ok (nothing)
                                                (rpmw-kind-nothing) 1)
                                            (if (rpmw-list-pair-supported? tag)
                                                (rpmw-eval-list-pair table row budget input-value input-kind)
                                                (if (rpmw-list-unary-supported? tag)
                                                    (rpmw-eval-list-unary table row budget input-value input-kind)
                                                    (if (eq tag 69)
                                                        (rpmw-eval-sequence table row budget input-value input-kind)
                                                        (if (rpmw-node-unary-supported? tag)
                                                            (rpmw-eval-node-unary table row budget input-value input-kind)
                                                            (if (rpmw-node-binary-supported? tag)
                                                                (rpmw-eval-node-binary table row budget input-value input-kind)
                                                                (if (rpmw-string-unary-supported? tag)
                                                                    (rpmw-eval-string-unary table row budget input-value input-kind)
                                                                    (if (rpmw-string-binary-supported? tag)
                                                                        (rpmw-eval-string-binary table row budget input-value input-kind)
                                                                        (if (rpmw-string-ternary-supported? tag)
                                                                            (rpmw-eval-string-ternary table row budget input-value input-kind)
                                                                            (if (rpmw-binary-supported? tag)
                                                                                (rpmw-eval-binary table row budget input-value input-kind)
                                                                                (if (eq tag 6)
                                                                                    (rpmw-eval-if table row budget input-value input-kind)
                                                                                    (if (eq tag 109)
                                                                                        (rpmw-eval-frame-store table row budget input-value input-kind)
                                                                                        (if (eq tag 110)
                                                                                            (rpmw-eval-frame-read table row budget input-value input-kind)
                                                                                            (if (eq tag 111)
                                                                                                (rpmw-eval-frame-reserve table row budget input-value input-kind)
                                                                                                (rpmw-result-error 1 (rpmw-reason-unsupported-tag)))))))))))))))))))))))))

    (defn rpmw-trace-from-result (envelope pif entry-index root-node step-budget result)
        (rpiwt-trace (rale-envelope-artifact-path envelope)
                     (pif-envelope-source-hash pif)
                     (pif-envelope-content-hash pif)
                     (rpiwt-entry-kind-function-root)
                     entry-index
                     root-node
                     step-budget
                     (rpmw-result-steps result)
                     (if (rpmw-result-ok? result) 1 0)
                     (if (rpmw-result-ok? result) (rpmw-result-value result) 0)
                     (if (rpmw-result-ok? result) 0 (if (str_eq (rpmw-result-trace-status result) (rao-obs-timeout)) 124 1))
                     (rpmw-result-trace-status result)
                     (rpmw-result-stop-reason result)
                     (rpmw-result-detail result)))

    (defn rpmw-walk-after-valid-entry-with-kind
        (envelope admission entry-index step-budget input-value input-kind pif root-node)
        (do
            (let result (rpmw-eval-node (pif-envelope-table pif) root-node
                                        step-budget
                                        (rpmw-frame-one input-value input-kind)
                                        (rpmw-kind-absent)))
            (let trace (rpmw-trace-from-result envelope pif entry-index root-node step-budget result))
            (rpmw-produced-with-kind envelope admission entry-index root-node
                step-budget input-value input-kind trace result)))
    (defn rpmw-walk-after-ready-with-kind
        (envelope admission entry-index step-budget input-value input-kind)
        (do
            (let pif (pifbd-admission-pif admission))
            (let table (pif-envelope-table pif))
            (if (lt entry-index 0)
                (rpmw-refused-with-kind envelope admission entry-index step-budget
                    input-value input-kind (rpmw-reason-negative-entry-index))
                (if (not (rpmw-entry-index-valid? table entry-index))
                    (rpmw-refused-with-kind envelope admission entry-index step-budget
                        input-value input-kind (rpmw-reason-entry-index-out-of-range))
                    (do
                        (let root-node (nth (pif-table-fn-roots table) entry-index))
                        (if (not (rpmw-node-id-valid? table root-node))
                            (rpmw-refused-with-kind envelope admission entry-index step-budget
                                input-value input-kind (rpmw-reason-root-node-out-of-range))
                            (if (lt step-budget 0)
                                (rpmw-refused-with-kind envelope admission entry-index step-budget
                                    input-value input-kind (rpmw-reason-negative-step-budget))
                                (rpmw-walk-after-valid-entry-with-kind envelope admission
                                    entry-index step-budget input-value input-kind
                                    pif root-node))))))))

    (defn rpmw-walk-entry-with-kind
        (envelope admission entry-index step-budget input-value input-kind)
        (if (not (rpmw-kind-valid? input-kind))
            (rpmw-refused-with-kind envelope admission entry-index step-budget
                input-value input-kind (rpmw-reason-malformed-input-kind))
        (if (not (rale-envelope? envelope))
            (rpmw-refused-with-kind envelope admission entry-index step-budget
                input-value input-kind (rpmw-reason-malformed-envelope))
            (if (not (rpmw-program-image-envelope? envelope))
                (rpmw-refused-with-kind envelope admission entry-index step-budget
                    input-value input-kind (rpmw-reason-non-program-image-envelope))
                (if (not (pifbd-admission? admission))
                    (rpmw-refused-with-kind envelope admission entry-index step-budget
                        input-value input-kind (rpmw-reason-malformed-admission))
                    (if (not (rpmw-admission-status-admitted? admission))
                        (rpmw-refused-with-kind envelope admission entry-index step-budget
                            input-value input-kind (rpmw-reason-non-admitted-admission))
                        (if (not (rpmw-admission-decode-decoded? admission))
                            (rpmw-refused-with-kind envelope admission entry-index step-budget
                                input-value input-kind (rpmw-reason-admission-decode-not-decoded))
                            (if (not (rpmw-admission-pif-valid? admission))
                                (rpmw-refused-with-kind envelope admission entry-index step-budget
                                    input-value input-kind (rpmw-reason-admission-invalid-pif))
                                (if (not (rpmw-admission-decode-matches-pif? admission))
                                    (rpmw-refused-with-kind envelope admission entry-index step-budget
                                        input-value input-kind (rpmw-reason-admission-decode-pif-mismatch))
                                    (if (not (rpmw-pif-matches-envelope? envelope (pifbd-admission-pif admission)))
                                        (rpmw-refused-with-kind envelope admission entry-index step-budget
                                            input-value input-kind (rpmw-reason-artifact-identity-mismatch))
                                        (rpmw-walk-after-ready-with-kind envelope admission
                                            entry-index step-budget input-value input-kind)))))))))))
    (defn rpmw-walk-entry (envelope admission entry-index step-budget input-value)
        (rpmw-walk-entry-with-kind envelope admission entry-index step-budget
            input-value (rpmw-kind-int)))
)
