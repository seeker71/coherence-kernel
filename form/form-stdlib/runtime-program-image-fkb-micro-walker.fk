    def rpmw-frame-put(frame, offset, value, kind) = rpmw-frame-row(rpmw-frame-capacity(frame), rpmw-frame-put-binding(rpmw-frame-bindings(frame), rpmw-frame-binding(offset, value, kind)));
    // result = ("runtime-program-image-fkb-micro-walker-result" value kind
    //           steps trace-status stop-reason reason detail)
    def rpmw-result-row(value, kind, steps, trace-status, stop-reason, reason, detail) = ["runtime-program-image-fkb-micro-walker-result", value, kind, steps, trace-status, stop-reason, reason, detail];
    def rpmw-result?(r) = (Comparable) len(r) == 8 ? (String) r[0] == "runtime-program-image-fkb-micro-walker-result" : 0;
