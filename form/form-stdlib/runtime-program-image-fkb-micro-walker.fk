    def rpmw-admitted-table?(table) = len(table) == 2 ? (String) table[0] == "runtime-program-image-fkb-admitted-table" : 0;
    def rpmw-admitted-table() = ["runtime-program-image-fkb-admitted-table", record_new(0, "pid", host_pid(), "nodes", record_new(0), "functions", record_new(0), "strings", record_new(0), "ledger", [])];
    def rpmw-admitted-read(table, selection) = kernel_ast(record_get(table[1], "pid"), selection);
    def rpmw-admitted-row(table, node-id) {
        let cache = record_get(table[1], "nodes");
        let key = node-id.str();
        record_has(cache, key) ? record_get(cache, key) : {
            let raw = rpmw-admitted-read(table, node-id);
