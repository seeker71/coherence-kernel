    def rpmw-eval-initializer(table, row, budget) = rpmw-result-add-parent(rpmw-eval-node(table, rpmw-row-a(row), rpmw-budget-after(budget, 1), rpmw-frame-many([], []), rpmw-kind-absent()));
    def rpmw-admitted-ambient-tag?(tag) = (tag == 29) || (tag == 32) || rpmw-node-unary-supported?(tag) || (rpmw-node-binary-supported?(tag) && tag != 80);
    def rpmw-eval-node(table, node-id, budget, input-value, input-kind) = rpmw-budget-ended?(budget) ? rpmw-result-timeout(0) : !rpmw-node-id-valid?(table, node-id) ? rpmw-result-error(0, rpmw-reason-child-out-of-range()) : {
