// structured-codec.fk - generic text <-> cell codec runtime.
//
// This file is format-neutral machinery. A codec source declares delimiters,
// literals, and cell categories; this runtime walks that spec. JSON-specific
// source lives in json-codec.bml as data, not as parser/emitter algorithm code.
// preludes: form-stdlib/core.fk
section [form.bml] {
    def structured_codec_spec(name, media_type, object_cat, array_cat, pair_cat, null_cat, object_open, object_close, array_open, array_close, pair_sep, item_sep, true_lit, false_lit, null_lit, quote_char, escape_char) = [name, media_type, object_cat, array_cat, pair_cat, null_cat, object_open, object_close, array_open, array_close, pair_sep, item_sep, true_lit, false_lit, null_lit, quote_char, escape_char];
    def sc-name(spec) = spec[0];
    def sc-media-type(spec) = spec[1];
    def sc-object-cat(spec) = spec[2];
    def sc-array-cat(spec) = spec[3];
    def sc-pair-cat(spec) = spec[4];
    def sc-null-cat(spec) = spec[5];
    def sc-object-open(spec) = spec[6];
    def sc-object-close(spec) = spec[7];
    def sc-array-open(spec) = spec[8];
    def sc-array-close(spec) = spec[9];
    def sc-pair-sep(spec) = spec[10];
    def sc-item-sep(spec) = spec[11];
    def sc-true-lit(spec) = spec[12];
    def sc-false-lit(spec) = spec[13];
    def sc-null-lit(spec) = spec[14];
    def sc-quote-char(spec) = spec[15];
    def sc-escape-token(spec) = spec[16];
    def sc-result(cell, next) = [cell, next];
    def sc-result-cell(result) = result[0];
    def sc-result-next(result) = result[1];
    def sc-reverse-loop(xs, acc) = nil?(xs) ? acc : sc-reverse-loop(tail(xs), cons(head(xs), acc));
    def sc-reverse(xs) = sc-reverse-loop(xs, empty());
    def sc-token-at-len?(s, token, token-len, i, j) = (Comparable) j == token-len ? true : i + j >= str_len(s) ? false : (String) char_at(s, i + j) == char_at(token, j) ? sc-token-at-len?(s, token, token-len, i, j + 1) : false;
    def sc-token-at?(s, token, i) = sc-token-at-len?(s, token, str_len(token), i, 0);
    def sc-skip-ws(s, i) = scan_run(s, i, 0);
    def sc-number-cp?(cp) = cp >= 48 && cp <= 57 || ((Comparable) cp == 45 || ((Comparable) cp == 43 || ((Comparable) cp == 46 || ((Comparable) cp == 69 || (Comparable) cp == 101))));
    def sc-number-end(s, i) = i >= str_len(s) ? i : sc-number-cp?(ord(char_at(s, i))) ? sc-number-end(s, i + 1) : i;
    def sc-number-float?(text) = str_find(text, ".", 0) >= 0 || (str_find(text, "e", 0) >= 0 || str_find(text, "E", 0) >= 0);
    def sc-number-cell(text) = sc-number-float?(text) ? intern_trivial_float(text) : intern_trivial_int(str_to_int(text));
    def sc-hex-value-cp(cp) = cp >= 48 && cp <= 57 ? cp - 48 : cp >= 65 && cp <= 70 ? 10 + (cp - 65) : cp >= 97 && cp <= 102 ? 10 + (cp - 97) : 0;
    def sc-hex4(s, i) = sc-hex-value-cp(ord(char_at(s, i))) * 4096 + (sc-hex-value-cp(ord(char_at(s, i + 1))) * 256 + (sc-hex-value-cp(ord(char_at(s, i + 2))) * 16 + sc-hex-value-cp(ord(char_at(s, i + 3)))));
    def sc-high-surrogate?(cp) = cp >= 55296 && cp <= 56319;
    def sc-low-surrogate?(cp) = cp >= 56320 && cp <= 57343;
    def sc-surrogate-pair-cp(hi, lo) = 65536 + ((hi - 55296) * 1024 + (lo - 56320));
    def sc-codepoint-to-utf8(cp) = cp < 128 ? byte_to_str(cp) : cp < 2048 ? str_concat(byte_to_str(192 + cp / 64), byte_to_str(128 + cp % 64)) : cp < 65536 ? str_concat(byte_to_str(224 + cp / 4096), str_concat(byte_to_str(128 + cp / 64 % 64), byte_to_str(128 + cp % 64))) : str_concat(byte_to_str(240 + cp / 262144), str_concat(byte_to_str(128 + cp / 4096 % 64), str_concat(byte_to_str(128 + cp / 64 % 64), byte_to_str(128 + cp % 64))));
    def sc-unescape-basic-cp(cp) = (Comparable) cp == 34 ? "\"" : (Comparable) cp == 47 ? "/" : (Comparable) cp == 92 ? "\\" : (Comparable) cp == 98 ? byte_to_str(8) : (Comparable) cp == 102 ? byte_to_str(12) : (Comparable) cp == 110 ? byte_to_str(10) : (Comparable) cp == 114 ? byte_to_str(13) : (Comparable) cp == 116 ? byte_to_str(9) : byte_to_str(cp);
    def sc-unescape-loop(s, i, acc) = {
        let n = str_len(s);
        let slash = str_find(s, "\\", i);
        slash < 0 ? str_concat(acc, substring(s, i, n)) : {
            let acc2 = str_concat(acc, substring(s, i, slash));
            slash + 1 >= n ? str_concat(acc2, "\\") : {
                let esc-cp = ord(char_at(s, slash + 1));
                (Comparable) esc-cp == 117 && slash + 5 <= n - 1 ? {
                    let cp = sc-hex4(s, slash + 2);
                    sc-high-surrogate?(cp) && (slash + 11 <= n - 1 && ((Comparable) ord(char_at(s, slash + 6)) == 92 && (Comparable) ord(char_at(s, slash + 7)) == 117)) ? {
                        let lo = sc-hex4(s, slash + 8);
                        sc-low-surrogate?(lo) ? sc-unescape-loop(s, slash + 12, str_concat(acc2, sc-codepoint-to-utf8(sc-surrogate-pair-cp(cp, lo)))) : sc-unescape-loop(s, slash + 6, str_concat(acc2, sc-codepoint-to-utf8(cp)));
                    } : sc-unescape-loop(s, slash + 6, str_concat(acc2, sc-codepoint-to-utf8(cp)));
                } : sc-unescape-loop(s, slash + 2, str_concat(acc2, sc-unescape-basic-cp(esc-cp)));
            };
        };
    };
    def sc-unescape-string(s) = sc-unescape-loop(s, 0, "");
    def sc-string-end-loop(spec, s, j) = {
        let k = scan_run(s, j, 4);
        (Comparable) k == str_len(s) ? k : (String) char_at(s, k) == sc-escape-token(spec) ? sc-string-end-loop(spec, s, k + 2) : k;
    };
    def sc-parse-string(spec, s, i) = {
        let body-start = i + str_len(sc-quote-char(spec));
        let body-end = sc-string-end-loop(spec, s, body-start);
        sc-result(intern_trivial_string(sc-unescape-string(substring(s, body-start, body-end))), body-end + str_len(sc-quote-char(spec)));
    };
    def sc-parse-number(spec, s, i) = {
        let end = sc-number-end(s, i);
        sc-result(sc-number-cell(substring(s, i, end)), end);
    };
    def sc-pair-node(spec, key, value, path) = intern_node_at(sc-pair-cat(spec), [key, value], path, 1, 1);
    def sc-null-node(spec, path) = intern_node_at(sc-null-cat(spec), empty(), path, 1, 1);
    def sc-parse-array(spec, path, s, i) = {
        let start = sc-skip-ws(s, i + str_len(sc-array-open(spec)));
        sc-token-at?(s, sc-array-close(spec), start) ? sc-result(intern_node_at(sc-array-cat(spec), empty(), path, 1, 1), start + str_len(sc-array-close(spec))) : sc-parse-array-loop(spec, path, s, start, empty());
    };
    def sc-parse-array-loop(spec, path, s, i, acc) = {
        let item = sc-parse-value-at(spec, path, s, i);
        let acc2 = cons(sc-result-cell(item), acc);
        let next = sc-skip-ws(s, sc-result-next(item));
        sc-token-at?(s, sc-item-sep(spec), next) ? sc-parse-array-loop(spec, path, s, sc-skip-ws(s, next + str_len(sc-item-sep(spec))), acc2) : sc-result(intern_node_at(sc-array-cat(spec), sc-reverse(acc2), path, 1, 1), next + str_len(sc-array-close(spec)));
    };
    def sc-parse-object(spec, path, s, i) = {
        let start = sc-skip-ws(s, i + str_len(sc-object-open(spec)));
        sc-token-at?(s, sc-object-close(spec), start) ? sc-result(intern_node_at(sc-object-cat(spec), empty(), path, 1, 1), start + str_len(sc-object-close(spec))) : sc-parse-object-loop(spec, path, s, start, empty());
    };
    def sc-parse-object-loop(spec, path, s, i, acc) = {
        let key-result = sc-parse-string(spec, s, i);
        let after-key = sc-skip-ws(s, sc-result-next(key-result));
        let after-sep = sc-skip-ws(s, after-key + str_len(sc-pair-sep(spec)));
        let val-result = sc-parse-value-at(spec, path, s, after-sep);
        let pair = sc-pair-node(spec, sc-result-cell(key-result), sc-result-cell(val-result), path);
        let acc2 = cons(pair, acc);
        let next = sc-skip-ws(s, sc-result-next(val-result));
        sc-token-at?(s, sc-item-sep(spec), next) ? sc-parse-object-loop(spec, path, s, sc-skip-ws(s, next + str_len(sc-item-sep(spec))), acc2) : sc-result(intern_node_at(sc-object-cat(spec), sc-reverse(acc2), path, 1, 1), next + str_len(sc-object-close(spec)));
    };
    def sc-parse-value-at(spec, path, s, i) = {
        let p = sc-skip-ws(s, i);
        sc-token-at?(s, sc-object-open(spec), p) ? sc-parse-object(spec, path, s, p) : sc-token-at?(s, sc-array-open(spec), p) ? sc-parse-array(spec, path, s, p) : sc-token-at?(s, sc-quote-char(spec), p) ? sc-parse-string(spec, s, p) : sc-token-at?(s, sc-true-lit(spec), p) ? sc-result(intern_trivial_bool(true), p + str_len(sc-true-lit(spec))) : sc-token-at?(s, sc-false-lit(spec), p) ? sc-result(intern_trivial_bool(false), p + str_len(sc-false-lit(spec))) : sc-token-at?(s, sc-null-lit(spec), p) ? sc-result(sc-null-node(spec, path), p + str_len(sc-null-lit(spec))) : sc-parse-number(spec, s, p);
    };
    def structured_codec_parse(spec, path, text) = sc-result-cell(sc-parse-value-at(spec, path, text, 0));
    def sc-hex-digit(n) = n < 10 ? byte_to_str(48 + n) : byte_to_str(87 + n);
    def sc-u00(cp) = str_concat("\\u00", str_concat(sc-hex-digit(cp / 16), sc-hex-digit(cp % 16)));
    def sc-escape-char(spec, ch) = {
        let cp = ord(ch);
        (String) ch == sc-quote-char(spec) ? "\\\"" : (String) ch == sc-escape-token(spec) ? "\\\\" : (Comparable) cp == 8 ? "\\b" : (Comparable) cp == 9 ? "\\t" : (Comparable) cp == 10 ? "\\n" : (Comparable) cp == 12 ? "\\f" : (Comparable) cp == 13 ? "\\r" : cp < 32 ? sc-u00(cp) : ch;
    };
    def sc-escape-loop(spec, s, i, acc) = (Comparable) i == str_len(s) ? acc : {
        let j = scan_run(s, i, 6);
        let acc2 = j > i ? str_concat(acc, substring(s, i, j)) : acc;
        (Comparable) j == str_len(s) ? acc2 : sc-escape-loop(spec, s, j + 1, str_concat(acc2, sc-escape-char(spec, char_at(s, j))));
    };
    def sc-quote-string(spec, s) = str_concat(sc-quote-char(spec), str_concat(sc-escape-loop(spec, s, 0, ""), sc-quote-char(spec)));
    def sc-emit-pair-node(spec, pair-node) = str_concat(sc-quote-string(spec, node_value(head(node_children(pair-node)))), str_concat(sc-pair-sep(spec), structured_codec_emit(spec, head(tail(node_children(pair-node))))));
    def sc-emit-pair-list(spec, pairs) = nil?(pairs) ? "" : nil?(tail(pairs)) ? sc-emit-pair-node(spec, head(pairs)) : str_concat(sc-emit-pair-node(spec, head(pairs)), str_concat(sc-item-sep(spec), sc-emit-pair-list(spec, tail(pairs))));
    def sc-emit-array-items(spec, items) = nil?(items) ? "" : nil?(tail(items)) ? structured_codec_emit(spec, head(items)) : str_concat(structured_codec_emit(spec, head(items)), str_concat(sc-item-sep(spec), sc-emit-array-items(spec, tail(items))));
    def sc-emit-leaf-rest(spec, node, ty) = (Comparable) ty == 3 ? node_eq(node, intern_trivial_bool(true)) ? sc-true-lit(spec) : sc-false-lit(spec) : (Comparable) ty == 4 ? sc-null-lit(spec) : (Comparable) ty == 7 ? float_to_str(node_value(node)) : (Comparable) ty == 6 ? int_to_str(node_value(node)) : head(empty());
    def sc-emit-leaf(spec, node) = {
        let ty = node_type(node);
        (Comparable) ty == 1 ? int_to_str(node_value(node)) : (Comparable) ty == 2 ? sc-quote-string(spec, node_value(node)) : sc-emit-leaf-rest(spec, node, ty);
    };
    def sc-emit-node-with-category(spec, node, cat) = node_eq(cat, sc-object-cat(spec)) ? str_concat(sc-object-open(spec), str_concat(sc-emit-pair-list(spec, node_children(node)), sc-object-close(spec))) : node_eq(cat, sc-array-cat(spec)) ? str_concat(sc-array-open(spec), str_concat(sc-emit-array-items(spec, node_children(node)), sc-array-close(spec))) : node_eq(cat, sc-pair-cat(spec)) ? sc-emit-pair-node(spec, node) : node_eq(cat, sc-null-cat(spec)) ? sc-null-lit(spec) : head(empty());
    def structured_codec_emit(spec, node) = (Comparable) node_level(node) == 1 ? sc-emit-leaf(spec, node) : sc-emit-node-with-category(spec, node, node_category(node));
    0;
}
