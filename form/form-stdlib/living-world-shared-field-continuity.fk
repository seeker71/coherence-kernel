; living-world-shared-field-continuity.fk -- inert channel images return only
; through explicit current-holder offers.
;
; The exact world inside a shared-field state uses the existing registry-free
; cell-coordinate continuity image and append-new durable carrier.  Loading is
; evidence, never activation.  A caller supplies one ordinary image entry and
; ordinary response entries for the exact restore proposal.  Every entry must
; use the channel's offered action; historical participants are recovered from
; the image, and the existing continuity organ requires their fresh unanimous
; ONE before a new shared-field state exists.
;
; Threshold and action are offered process configuration, not stored semantic
; truth.  No response is generated here, no absent holder is impersonated, and
; no loaded image answers a question before restoration.
; witnessed: 2026-08-09 -> 2097151
;
; preludes: form-stdlib/core.fk form-stdlib/living-world-continuity-durable.fk form-stdlib/living-world-shared-field-channel.fk

(let LWSFC-RESULT (bp "LWSFC-RESULT"))

(defn lwsfc-image (state)
    (if (eq (lwsf-state? state) 0) (lwo-none)
        (lwcn-image (lwsf-state-world state))))

(defn lwsfc-entry-action? (entry action)
    (if (eq (lwsf-world-entry? entry) 0) 0
        (if (node_eq (lwt-entry-action entry) action) 1 0)))
(defn lwsfc-response-actions? (items action)
    (if (eq (len items) 0) 1
        (if (eq (lwsfc-entry-action? (head items) action) 1)
            (lwsfc-response-actions? (tail items) action) 0)))
(defn lwsfc-image-entry? (entry image action)
    (if (eq (lwsfc-entry-action? entry action) 0) 0
        (if (node_eq
                (lwo-offer-payload (lwt-entry-offer entry)) image) 1 0)))

; children: optional successor state, effective ack, optional proposal,
; optional outcome, inert loaded image, admission world, integration round.
(defn lwsfc-result (state ack proposal outcome image admission round)
    (intern_node LWSFC-RESULT
        (list state ack proposal outcome image admission round
              (lwo-local-path))))
(defn lwsfc-result? (cell) (lwo-category? cell LWSFC-RESULT))
(defn lwsfc-result-state (result) (nth (node_children result) 0))
(defn lwsfc-result-ack (result) (nth (node_children result) 1))
(defn lwsfc-result-proposal (result) (nth (node_children result) 2))
(defn lwsfc-result-outcome (result) (nth (node_children result) 3))
(defn lwsfc-result-image (result) (nth (node_children result) 4))
(defn lwsfc-result-admission (result) (nth (node_children result) 5))
(defn lwsfc-result-round (result) (nth (node_children result) 6))

(defn lwsfc-refused (image)
    (lwsfc-result (lwo-none) (oac-zero) (lwo-none) (lwo-none)
        image (lwo-empty-world) (lwo-none)))

(defn lwsfc-outcome-ack (outcome state)
    (if (node_eq (lwt-outcome-status outcome)
                 (lwt-status-acknowledged))
        (oac-one state)
        (if (node_eq (lwt-outcome-status outcome)
                     (lwt-status-dissented))
            (oac-zero) (oac-nothing))))

(defn lwsfc-restore-inputs? (image image-entry response-entries threshold action)
    (if (eq (lwcn-image-valid? image) 0) 0
        (if (lt threshold 1) 0
            (if (eq (lwsfc-image-entry? image-entry image action) 0) 0
                (lwsfc-response-actions? response-entries action)))))

(defn lwsfc-restored-state (round proposal threshold action)
    (do
        (let world (lwt-round-world round))
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwcn-restored? world candidate) 1)
            (lwsf-state world threshold action (lwo-none))
            (lwo-none))))

(defn lwsfc-answer-restore
    (image admission proposal response-entries threshold action)
    (do
        (let answered
            (lwt-round-receive
                (lwt-round admission (lwo-field (list proposal))
                    (lwo-empty-field) (lwo-none))
                response-entries))
        (let outcome
            (lwt-evaluate-proposal (lwt-round-world answered) proposal))
        (let restored (lwcn-integrate-restore answered proposal action))
        (let state
            (lwsfc-restored-state restored proposal threshold action))
        (lwsfc-result state (lwsfc-outcome-ack outcome state)
            proposal outcome image admission restored)))

(defn lwsfc-restore-admitted
    (image image-entry response-entries threshold action)
    (do
        (let admission
            (lwt-receive-stream (lwo-empty-world) (list image-entry)))
        (let proposal (lwcn-restore-proposal admission image))
        (if (node_eq proposal (lwo-none))
            (lwsfc-result (lwo-none) (oac-zero) proposal (lwo-none)
                image admission (lwo-none))
            (lwsfc-answer-restore image admission proposal
                response-entries threshold action))))

(defn lwsfc-restore (image image-entry response-entries threshold action)
    (if (eq (lwsfc-restore-inputs? image image-entry response-entries
                threshold action) 1)
        (lwsfc-restore-admitted image image-entry response-entries
            threshold action)
        (lwsfc-refused image)))

(defn lwsfc-progress-target (result)
    (do
        (let outcome (lwsfc-result-outcome result))
        (lcfb-cat (list
            "ack:" (int_to_str (oac-kind (lwsfc-result-ack result)))
            ":participants:"
                (if (node_eq (lwsfc-result-proposal result) (lwo-none)) "0"
                    (int_to_str (lwo-field-size
                        (lwt-proposal-participants
                            (lwsfc-result-proposal result)))))
            ":yes:"
                (if (node_eq outcome (lwo-none)) "0"
                    (int_to_str (lwt-outcome-yes outcome)))
            ":no:"
                (if (node_eq outcome (lwo-none)) "0"
                    (int_to_str (lwt-outcome-no outcome)))
            ":silence:"
                (if (node_eq outcome (lwo-none)) "0"
                    (int_to_str (lwt-outcome-silence outcome)))
            ":missing:"
                (if (node_eq outcome (lwo-none)) "0"
                    (int_to_str (lwt-outcome-missing outcome)))))))

(defn lwsfc-restore-observed
    (image image-entry response-entries threshold action started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-shared-field-continuity"
                "restore" "enter" "form-native" "lwsfc-restore"
                "inert-image-and-explicit-responses" (mul ordinal 2) started
                "form/form-stdlib/living-world-shared-field-continuity.fk"
                146 13))
        (let result
            (lwsfc-restore image image-entry response-entries threshold action))
        (let left
            (lcfb-call-stream "living-world-shared-field-continuity"
                "restore" "leave" "form-native" "lwsfc-restore"
                (lwsfc-progress-target result) (add (mul ordinal 2) 1) started
                "form/form-stdlib/living-world-shared-field-continuity.fk"
                150 17))
        result))

0
