// program-image-fkb-byte-file-witness.fk -- bounded file witness for 8h4 bytes.
//
// Layer 8h5 proves one narrow thing: a ready 8h4 program-image byte container
// can be placed at its own artifact path and read back byte-identically through
// the current bounded file-window floor.
//
// This is immediate file witness evidence, not atomic durable persistence, not
// cache freshness admission, not source-compiler persistence, and not runtime
// selection or loading. The layer replays the embedded PIF and content vouch
// before any mutation, writes only through form-fs append after removing the old
// file, and reads back only through file-byte-window.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/source-artifact-probe.fk form-stdlib/source-artifact-identity.fk form-stdlib/program-image-fkb.fk form-stdlib/program-image-fkb-byte-container.fk
section [form.bml] {
    def pifbf-version() = "program-image-fkb-byte-file-witness-v1";
    def pifbf-max-bytes() = fbw-max-window();
    def pifbf-feature(name, status) = ["program-image-fkb-byte-file-witness-feature", name, status];
    def pifbf-feature-name(f) = f[1];
    def pifbf-feature-status(f) = f[2];
    def program-image-fkb-byte-file-witness-manifest() = [pifbf-feature("file-witness-for-ready-byte-container", 1), pifbf-feature("replays-embedded-pif-before-write", 1), pifbf-feature("rechecks-content-vouch-before-write", 1), pifbf-feature("artifact-path-owned-by-pif", 1), pifbf-feature("rejects-empty-target-path", 1), pifbf-feature("rejects-directory-target", 1), pifbf-feature("rejects-empty-payload-bytes", 1), pifbf-feature("one-window-readback-cap", 1), pifbf-feature("too-large-refused-before-write", 1), pifbf-feature("remove-before-append", 1), pifbf-feature("post-remove-absence-check", 1), pifbf-feature("write-count-checked", 1), pifbf-feature("observed-size-carried", 1), pifbf-feature("file-window-readback", 1), pifbf-feature("readback-byte-equality", 1), pifbf-feature("readback-content-vouch", 1), pifbf-feature("no-form-binary-io", 1), pifbf-feature("no-whole-file-byte-io", 1), pifbf-feature("no-table-text-bridge", 1), pifbf-feature("no-source-compiler-persistence", 1), pifbf-feature("no-program-image-load", 1), pifbf-feature("no-attempt-observation", 1), pifbf-feature("no-selector-install", 1), pifbf-feature("no-c-seed-growth", 1)];
    def program-image-fkb-byte-file-witness-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) pifbf-feature-name(head(fs)) == name && (Comparable) pifbf-feature-status(head(fs)) == 1 ? 1 : program-image-fkb-byte-file-witness-manifest-has?(name, tail(fs));
    def pifbf-status-ready() = "file-witness-ready";
    def pifbf-status-investigate() = "investigate";
    def pifbf-status-refused() = "refused";
    def pifbf-reason-ready() = "file-witness-ready";
    def pifbf-reason-malformed-container() = "malformed-container";
    def pifbf-reason-non-ready-container() = "non-ready-container";
    def pifbf-reason-container-drift() = "container-drift";
    def pifbf-reason-empty-target-path() = "empty-target-path";
    def pifbf-reason-target-is-directory() = "target-is-directory";
    def pifbf-reason-empty-payload() = "empty-payload-bytes";
    def pifbf-reason-too-large() = "too-large-for-one-window";
    def pifbf-reason-remove-failed() = "remove-failed";
    def pifbf-reason-append-failed() = "append-failed";
    def pifbf-reason-size-mismatch() = "size-mismatch";
    def pifbf-reason-readback-window-failed() = "readback-window-failed";
    def pifbf-reason-readback-bytes-mismatch() = "readback-bytes-mismatch";
    def pifbf-reason-readback-hash-mismatch() = "readback-hash-mismatch";
    def pifbf-bytes-eq?(a, b) = (Comparable) len(a) == len(b) ? nil?(a) ? 1 : (Comparable) head(a) == head(b) ? pifbf-bytes-eq?(tail(a), tail(b)) : 0 : 0;
    def pifbf-empty-window(path) = fbw-window(path, 0, 0, 0, fbw-status-missing(), "", fbw-evidence-route());
    def pifbf-empty-vouch(path) = sai-vouch(sai-target-content-hash(), path, sai-evidence-supplied-bytes(), "", "", sai-status-unobserved(), 0, 0);
    def pifbf-container-path(container) = pifbc-container?(container) ? pif-envelope?(pifbc-container-pif(container)) ? pif-envelope-artifact-path(pifbc-container-pif(container)) : "" : "";
    def pifbf-vouch-replay-ok?(pif, bytes, vouch) = {
        let expected = sai-vouch-content-bytes(pif-envelope-artifact-path(pif), pif-envelope-content-hash(pif), bytes);
        sai-vouch-match?(vouch) && (sai-vouch-match?(expected) && ((String) sai-vouch-target(vouch) == sai-vouch-target(expected) && ((String) sai-vouch-path(vouch) == sai-vouch-path(expected) && ((String) sai-vouch-evidence-kind(vouch) == sai-vouch-evidence-kind(expected) && ((String) sai-vouch-expected-hash(vouch) == sai-vouch-expected-hash(expected) && ((String) sai-vouch-actual-hash(vouch) == sai-vouch-actual-hash(expected) && ((String) sai-vouch-status(vouch) == sai-vouch-status(expected) && ((Comparable) sai-vouch-observed-size(vouch) == len(bytes) && ((Comparable) sai-vouch-material-size(vouch) == len(bytes) && ((Comparable) sai-vouch-observed-size(expected) == len(bytes) && (Comparable) sai-vouch-material-size(expected) == len(bytes)))))))))));
    };
    def pifbf-container-replay-ok?(container) = pifbc-container?(container) ? {
        let pif = pifbc-container-pif(container);
        let bytes = pifbc-container-bytes(container);
        let vouch = pifbc-container-vouch(container);
        let fresh = pifbc-container-from-envelope(pif);
        pif-envelope-valid?(pif) ? pifbc-ready?(fresh) ? len(bytes) > 0 ? pifbf-bytes-eq?(bytes, pifbc-container-bytes(fresh)) ? pifbf-vouch-replay-ok?(pif, bytes, vouch) : 0 : 0 : 0 : 0;
    } : 0;
    // row = ("program-image-fkb-byte-file-witness" container path wrote
    //        observed-size window readback-vouch status reason)
    def pifbf-witness(container, path, wrote, observed-size, window, readback-vouch, status, reason) = ["program-image-fkb-byte-file-witness", container, path, wrote, observed-size, window, readback-vouch, status, reason];
    def pifbf-witness?(w) = (Comparable) len(w) == 9 ? (String) w[0] == "program-image-fkb-byte-file-witness" : 0;
    def pifbf-witness-container(w) = w[1];
    def pifbf-witness-path(w) = w[2];
    def pifbf-witness-wrote(w) = w[3];
    def pifbf-witness-observed-size(w) = w[4];
    def pifbf-witness-window(w) = w[5];
    def pifbf-witness-readback-vouch(w) = w[6];
    def pifbf-witness-status(w) = w[7];
    def pifbf-witness-reason(w) = w[8];
    def pifbf-row(container, wrote, observed-size, window, vouch, status, reason) = pifbf-witness(container, pifbf-container-path(container), wrote, observed-size, window, vouch, status, reason);
    def pifbf-refused-row(container, reason) = pifbf-row(container, 0, -1, pifbf-empty-window(pifbf-container-path(container)), pifbf-empty-vouch(pifbf-container-path(container)), pifbf-status-refused(), reason);
    def pifbf-investigate-row(container, wrote, observed-size, window, vouch, reason) = pifbf-row(container, wrote, observed-size, window, vouch, pifbf-status-investigate(), reason);
    def pifbf-ready-row(container, wrote, observed-size, window, vouch) = pifbf-row(container, wrote, observed-size, window, vouch, pifbf-status-ready(), pifbf-reason-ready());
    def pifbf-file-witness-from-container(container) = !pifbc-container?(container) ? pifbf-refused-row(container, pifbf-reason-malformed-container()) : !pifbc-ready?(container) ? pifbf-refused-row(container, pifbf-reason-non-ready-container()) : {
        let pif = pifbc-container-pif(container);
        let bytes = pifbc-container-bytes(container);
        let path = pifbf-container-path(container);
        let byte-count = len(bytes);
        (Comparable) str_len(path) == 0 ? pifbf-refused-row(container, pifbf-reason-empty-target-path()) : (Comparable) fs-is-dir?(path) == 1 ? pifbf-refused-row(container, pifbf-reason-target-is-directory()) : byte-count > pifbf-max-bytes() ? pifbf-refused-row(container, pifbf-reason-too-large()) : (Comparable) byte-count == 0 ? pifbf-refused-row(container, pifbf-reason-empty-payload()) : !pifbf-container-replay-ok?(container) ? pifbf-investigate-row(container, 0, fs-stat-size(path), pifbf-empty-window(path), pifbf-empty-vouch(path), pifbf-reason-container-drift()) : {
            let _rm = fs-remove-file(path);
            (Comparable) fs-exists?(path) == 1 ? pifbf-investigate-row(container, 0, fs-stat-size(path), pifbf-empty-window(path), pifbf-empty-vouch(path), pifbf-reason-remove-failed()) : {
                let wrote = fs-append-bytes(path, bytes);
                let observed = fs-stat-size(path);
                !((Comparable) wrote == byte-count) ? pifbf-investigate-row(container, wrote, observed, pifbf-empty-window(path), pifbf-empty-vouch(path), pifbf-reason-append-failed()) : !((Comparable) observed == byte-count) ? pifbf-investigate-row(container, wrote, observed, pifbf-empty-window(path), pifbf-empty-vouch(path), pifbf-reason-size-mismatch()) : {
                    let window = fbw-read-window(path, 0, byte-count);
                    !((String) fbw-window-status(window) == fbw-status-ready()) ? pifbf-investigate-row(container, wrote, observed, window, pifbf-empty-vouch(path), pifbf-reason-readback-window-failed()) : {
                        let readback = fbw-window-bytes(window);
                        let read-vouch = sai-vouch-content-bytes(path, pif-envelope-content-hash(pif), readback);
                        !pifbf-bytes-eq?(readback, bytes) ? pifbf-investigate-row(container, wrote, observed, window, read-vouch, pifbf-reason-readback-bytes-mismatch()) : !sai-vouch-match?(read-vouch) ? pifbf-investigate-row(container, wrote, observed, window, read-vouch, pifbf-reason-readback-hash-mismatch()) : pifbf-ready-row(container, wrote, observed, window, read-vouch);
                    };
                };
            };
        };
    };
}
