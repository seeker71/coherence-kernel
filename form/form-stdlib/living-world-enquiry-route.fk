; living-world-enquiry-route.fk -- one locally derivable path through a gap.
;
; A route is not a named task.  It is the present meeting of one admitted,
; steady mapping or chain with one explicitly offered enquiry focus.  It
; retains the exact local derivation, output, uncertainty, attribution
; witnesses, and source/target
; skeletons.  Flat learned mappings and admitted expression chains use the
; same category/arity-only shape carrier, so newer composition tissue may
; enter enquiry without installing grammatical roles.  No host, model,
; vocabulary, or oracle participates.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk

(let LWEN-STEP        (bp "LWEN-STEP"))
(let LWEN-ROUTE       (bp "LWEN-ROUTE"))
(let LWEN-UNCERTAINTY (bp "LWEN-UNCERTAINTY"))
(let LWEN-FOCUS       (bp "LWEN-FOCUS"))
(let LWEN-FLAT-SHAPE  (bp "LWEN-FLAT-SHAPE"))

; An input becomes autonomous enquiry material only through this explicitly
; offered focus cell.  Merely being present in the world grants no such use.
(defn lwen-focus (input evidence)
    (intern_node LWEN-FOCUS (list input evidence)))
(defn lwen-raw-focus? (cell) (lwo-category? cell LWEN-FOCUS))
(defn lwen-focus? (cell)
    (if (eq (lwen-raw-focus? cell) 1) 1
        (if (and (eq (lwo-category? cell LWO-EMERGENT) 1)
                 (eq (lwen-raw-focus?
                        (lwo-emergent-shape cell)) 1)) 1 0)))
(defn lwen-focus-shape (focus)
    (if (eq (lwen-raw-focus? focus) 1) focus
        (if (eq (lwen-focus? focus) 1)
            (lwo-emergent-shape focus) (lwo-none))))
(defn lwen-focus-input (focus)
    (nth (node_children (lwen-focus-shape focus)) 0))
(defn lwen-focus-evidence (focus)
    (nth (node_children (lwen-focus-shape focus)) 1))
(defn lwen-focus-current? (world focus)
    (if (eq (lwen-focus? focus) 0) 0
        (if (eq (lwo-active? world focus) 0) 0
            (if (eq (lwen-raw-focus? focus) 1) 1
                (lwo-emergent-ready? world focus)))))

(defn lwen-flat-shape (category arity)
    (intern_node LWEN-FLAT-SHAPE
        (list category (intern_trivial_int arity))))

; children: mapping candidate, signature, input, output, local path
(defn lwen-step (candidate signature input output)
    (intern_node LWEN-STEP
        (list candidate signature input output (lwo-local-path))))
(defn lwen-step? (cell) (lwo-category? cell LWEN-STEP))
(defn lwen-step-candidate (step) (nth (node_children step) 0))
(defn lwen-step-signature (step) (nth (node_children step) 1))
(defn lwen-step-input (step) (nth (node_children step) 2))
(defn lwen-step-output (step) (nth (node_children step) 3))
(defn lwen-step-path (step) (nth (node_children step) 4))

(defn lwen-path-candidate? (candidate)
    (if (or (eq (lwrl-recursive-candidate? candidate) 1)
            (or (eq (lwcx-chain-candidate? candidate) 1)
                (or (eq (lwr-mapping-candidate? candidate) 1)
                    (eq (lwxc-chain-candidate? candidate) 1)))) 1 0))

(defn lwen-path-steady? (world candidate)
    (if (eq (lwrl-recursive-candidate? candidate) 1)
        (lwrl-steady? world candidate)
        (if (eq (lwcx-chain-candidate? candidate) 1)
            (lwcx-chain-steady? world candidate)
            (if (eq (lwr-mapping-candidate? candidate) 1)
                (lwxb-mapping-current? world candidate)
                (if (eq (lwxc-chain-candidate? candidate) 1)
                    (lwxc-chain-integrated-current? world candidate) 0)))))

(defn lwen-path-source-skeleton (candidate)
    (if (eq (lwrl-recursive-candidate? candidate) 1)
        (lwrr-signature-source-skeleton
            (lwrr-mapping-signature (lwo-emergent-shape candidate)))
        (if (eq (lwcx-chain-candidate? candidate) 1)
            (lwcx-chain-source-skeleton (lwo-emergent-shape candidate))
            (if (eq (lwr-mapping-candidate? candidate) 1)
                (do
                    (let signature
                        (lwr-mapping-signature
                            (lwo-emergent-shape candidate)))
                    (lwen-flat-shape
                        (lwr-signature-source-category signature)
                        (lwr-signature-source-arity signature)))
                (if (eq (lwxc-chain-candidate? candidate) 1)
                    (do
                        (let signature
                            (lwxc-chain-first-signature
                                (lwo-emergent-shape candidate)))
                        (lwen-flat-shape
                            (lwr-signature-source-category signature)
                            (lwr-signature-source-arity signature)))
                    (lwo-none))))))

(defn lwen-path-input-matches? (candidate input)
    (if (or (eq (lwr-mapping-candidate? candidate) 1)
            (eq (lwxc-chain-candidate? candidate) 1))
        (node_eq
            (lwen-flat-shape
                (node_category input) (len (node_children input)))
            (lwen-path-source-skeleton candidate))
        (node_eq (lwrr-skeleton input)
            (lwen-path-source-skeleton candidate))))

(defn lwen-path-target-skeleton (candidate)
    (if (eq (lwrl-recursive-candidate? candidate) 1)
        (lwrr-signature-target-skeleton
            (lwrr-mapping-signature (lwo-emergent-shape candidate)))
        (if (eq (lwcx-chain-candidate? candidate) 1)
            (lwcx-chain-target-skeleton (lwo-emergent-shape candidate))
            (if (eq (lwr-mapping-candidate? candidate) 1)
                (do
                    (let signature
                        (lwr-mapping-signature
                            (lwo-emergent-shape candidate)))
                    (lwen-flat-shape
                        (lwr-signature-target-category signature)
                        (lwr-signature-target-arity signature)))
                (if (eq (lwxc-chain-candidate? candidate) 1)
                    (do
                        (let signature
                            (lwxc-chain-second-signature
                                (lwo-emergent-shape candidate)))
                        (lwen-flat-shape
                            (lwr-signature-target-category signature)
                            (lwr-signature-target-arity signature)))
                    (lwo-none))))))

(defn lwen-path-uncertainty (candidate)
    (if (eq (lwrl-recursive-candidate? candidate) 1)
        (intern_node LWEN-UNCERTAINTY
            (list (lwrr-mapping-uncertainty
                    (lwo-emergent-shape candidate))))
        (if (eq (lwcx-chain-candidate? candidate) 1)
            (do
                (let chain (lwo-emergent-shape candidate))
                (intern_node LWEN-UNCERTAINTY
                    (list (lwcx-chain-first-uncertainty chain)
                          (lwcx-chain-second-uncertainty chain))))
            (if (eq (lwr-mapping-candidate? candidate) 1)
                (intern_node LWEN-UNCERTAINTY
                    (list (lwr-mapping-uncertainty
                            (lwo-emergent-shape candidate))))
                (if (eq (lwxc-chain-candidate? candidate) 1)
                    (do
                        (let chain (lwo-emergent-shape candidate))
                        (intern_node LWEN-UNCERTAINTY
                            (list (lwxc-chain-first-uncertainty chain)
                                  (lwxc-chain-second-uncertainty chain))))
                    (intern_node LWEN-UNCERTAINTY (empty)))))))

(defn lwen-path-derive (candidate input)
    (if (eq (lwrl-recursive-candidate? candidate) 1)
        (do
            (let signature
                (lwrr-mapping-signature
                    (lwo-emergent-shape candidate)))
            (let output (lwrr-apply-signature signature input))
            (if (node_eq output (lwo-none)) (lwo-none)
                (lwen-step candidate signature input output)))
        (if (eq (lwcx-chain-candidate? candidate) 1)
            (lwcx-derive-chain (lwo-emergent-shape candidate) input)
            (if (eq (lwr-mapping-candidate? candidate) 1)
                (do
                    (let mapping (lwo-emergent-shape candidate))
                    (let signature (lwr-mapping-signature mapping))
                    (let output (lwr-apply-mapping mapping input))
                    (if (node_eq output (lwo-none)) (lwo-none)
                        (lwen-step candidate signature input output)))
                (if (eq (lwxc-chain-candidate? candidate) 1)
                    (lwxc-derive (lwo-emergent-shape candidate) input)
                    (lwo-none))))))

(defn lwen-derivation-output (derivation)
    (if (eq (lwen-step? derivation) 1)
        (lwen-step-output derivation)
        (if (eq (lwcx-derivation? derivation) 1)
            (lwcx-derivation-output derivation)
            (if (eq (lwxc-derivation? derivation) 1)
                (lwxc-derivation-output derivation)
                (lwo-none)))))

(defn lwen-route-witnesses (world candidate witness-cell)
    (lwr-field-union-items
        (lwo-field-items
            (lwo-active-attributions-for world witness-cell))
        (lwo-active-attributions-for world candidate)))

; children: path candidate, input, source skeleton, target skeleton,
;           derivation, output, uncertainty, witnesses, local path, focus
(defn lwen-route
    (candidate input derivation uncertainty witnesses focus)
    (intern_node LWEN-ROUTE
        (list candidate input
              (lwen-path-source-skeleton candidate)
              (lwen-path-target-skeleton candidate)
              derivation (lwen-derivation-output derivation)
              uncertainty witnesses (lwo-local-path) focus)))
(defn lwen-route? (cell) (lwo-category? cell LWEN-ROUTE))
(defn lwen-route-candidate (route) (nth (node_children route) 0))
(defn lwen-route-input (route) (nth (node_children route) 1))
(defn lwen-route-source-skeleton (route) (nth (node_children route) 2))
(defn lwen-route-target-skeleton (route) (nth (node_children route) 3))
(defn lwen-route-derivation (route) (nth (node_children route) 4))
(defn lwen-route-output (route) (nth (node_children route) 5))
(defn lwen-route-uncertainty (route) (nth (node_children route) 6))
(defn lwen-route-witness-field (route) (nth (node_children route) 7))
(defn lwen-route-path (route) (nth (node_children route) 8))
(defn lwen-route-focus (route) (nth (node_children route) 9))

(defn lwen-route-for (world candidate input)
    ; Reject non-paths and structural misses before lifecycle evaluation.
    ; Discovery may inspect every active world cell; asking each miss to rescan
    ; the complete mapping evidence turns a bounded question into cubic work.
    (if (eq (lwen-path-candidate? candidate) 0)
        (lwo-none)
        (if (eq (lwo-active? world input) 0) (lwo-none)
            (if (eq (lwen-path-input-matches? candidate input) 0)
                (lwo-none)
                (if (eq (lwen-path-steady? world candidate) 0)
                    (lwo-none)
                    (do
                        (let derivation
                            (lwen-path-derive candidate input))
                        (if (node_eq derivation (lwo-none)) (lwo-none)
                            (lwen-route candidate input derivation
                                (lwen-path-uncertainty candidate)
                                (lwen-route-witnesses
                                    world candidate input)
                                (lwo-none)))))))))

(defn lwen-route-for-focus (world candidate focus)
    (if (or (eq (lwen-focus? focus) 0)
            (eq (lwen-focus-current? world focus) 0))
        (lwo-none)
        (do
            (let input (lwen-focus-input focus))
            (if (eq (lwen-path-candidate? candidate) 0) (lwo-none)
                (if (eq (lwen-path-input-matches? candidate input) 0)
                    (lwo-none)
                    (if (eq (lwen-path-steady? world candidate) 0)
                        (lwo-none)
                        (do
                            (let derivation
                                (lwen-path-derive candidate input))
                            (if (node_eq derivation (lwo-none)) (lwo-none)
                                (lwen-route candidate input derivation
                                    (lwen-path-uncertainty candidate)
                                    (lwen-route-witnesses
                                        world candidate focus)
                                    focus)))))))))

(defn lwen-route-current? (world route)
    (node_eq route
        (if (node_eq (lwen-route-focus route) (lwo-none))
            (lwen-route-for world
                (lwen-route-candidate route) (lwen-route-input route))
            (lwen-route-for-focus world
                (lwen-route-candidate route) (lwen-route-focus route)))))
