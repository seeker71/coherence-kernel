; hex-encode-only.fk — lowercase byte-list encoding without decode ontology.
;
; preludes: form-stdlib/core.fk

(do
    (defn heo-digit (n)
        (substring "0123456789abcdef" n (add n 1)))
    (defn heo-loop (bytes acc)
        (if (eq (len bytes) 0) acc
            (do
                (let b (head bytes))
                (heo-loop (tail bytes)
                    (str_concat acc
                        (str_concat (heo-digit (div b 16))
                                    (heo-digit (mod b 16))))))))
    (defn hex-encode-only (bytes) (heo-loop bytes ""))
    0)
