//////////////////////////////////////////////////////////////////////
//
// lane-drive.bml
//
// Executable BML. The LANE DRIVE: the body drives its own observation.
// Rows of real asks go through the hearth's own send capability, the
// drive waits on the last turn's arrival (the witnessed parallel-serving way
// says replies land in arrival order, so the last arrival implies the
// drain), and the lane-motion witness reports which data points moved.
// No shell orchestration, no foreign driver: sampling, driving,
// waiting and reporting are all the same grammar.
//
// Sequencing rides strict argument evaluation: each stage is the
// argument of the next stage's carrier def, so burst completes before
// await begins, and await before the second sample.
//
// preludes: form-stdlib/core.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
// Proven by: form-stdlib/tests/lane-motion-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneDrive {
        thought lane-drive-pattern = list("body-drives-own-observation", "arrival-order-drain", "stage-by-argument");

        def ld-row(turn, kind, body) = list(turn, kind, body);
        def ld-send(row) = hearth-send(nth(row, 0), nth(row, 1), nth(row, 2));
        def ld-burst-go(rows, acc) = if eq(len(rows), 0) then acc else ld-burst-go(tail(rows), add(acc, ld-send(head(rows))));
        def ld-burst(rows) = ld-burst-go(rows, 0);
        def ld-last(rows) = if le(len(rows), 1) then head(rows) else ld-last(tail(rows));
        def ld-arrived(turn) = if ge(str_find(lms-rsp(), str_concat(lms-mark-turn(), int_to_str(turn)), 0), 0) then 1 else 0;
        def ld-await-tick(z, turn, cap) = ld-await(turn, sub(cap, 1));
        def ld-await(turn, cap) = if le(cap, 0) then 0 else if eq(ld-arrived(turn), 1) then 1 else ld-await-tick(host-exec("sleep 1", ""), turn, cap);
        def ld-next-turn() = add(lms-max-turn(read_file(hearth-task())), 1);
        def ld-head-line(sent, arrived) = str_concat("sent=", str_concat(int_to_str(sent), str_concat(" last-arrived=", str_concat(int_to_str(arrived), tg-nl()))));
        def ld-drive2b(a, sent, rows, cap) = ld-drive3(a, sent, ld-await(nth(ld-last(rows), 0), cap));
        def ld-drive2(a, rows, cap) = ld-drive2b(a, ld-burst(rows), rows, cap);
        def ld-drive3(a, sent, arrived) = str_concat(ld-head-line(sent, arrived), lms-report(a, lms-snap()));
        def ld-drive(rows, cap) = ld-drive2(lms-snap(), rows, cap);
    }
    0;
}
