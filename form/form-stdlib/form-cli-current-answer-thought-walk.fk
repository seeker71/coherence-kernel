; form-cli-current-answer-thought-walk.fk -- the resident, bounded execution
; side of the current-answer recipe, small enough to live in form-cli today.
;
; The full program-image walker has broad decoding, symbol, frame, and receipt
; surfaces which do not belong in the already-large REPL closure.  This cell
; admits only the eight semantics used by the immutable 60-node current-answer
; thought: INT, ARG, NTH, STRING, STR_EQ, MUL, NODE_EQ, and INT_EQ.  Rows,
; strings, ABI, and root are children of one immutable, content-addressed image
; NodeID.  Symbols live in separate binding NodeIDs which retain the actual
; image object, never a coordinate pretending it can be dereferenced.  The
; registry admits bindings as data and reports absence, ambiguity, malformed
; content, and readiness distinctly.  Another recipe using these semantics
; adds an image and binding, not a global function seat or dispatch branch.
; No flattened table or generated operations registry exists.
;
; Input shape belongs to each image's ABI child.  The current image carries the
; sixteen held/current kinds used by source, answer, status, reason, lookup,
; hit, executed, and lifecycle, while a newly born image can carry a different
; arity without changing this reducer.  Nothing is refusal before a walk,
; disagreement is present 0, agreement is present 1, malformed evaluation is
; failure, and fuel exhaustion is timeout with no output.  The strict query
; producer is not claimed here: this is its callable resident execution half.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-current-answer-thought-walk-band.fk

(do
    (defn fcatw-version () "form-cli-current-answer-thought-walk-v2")
    (defn fcatw-symbol () "knowledge/current-answer-outcome-bound")

    (defn fcatw-kind-nothing () 0)
    (defn fcatw-kind-int () 1)
    (defn fcatw-kind-string () 2)
    (defn fcatw-kind-node () 3)
    (defn fcatw-kind-list () 4)

    ; result = status reason value kind steps.  Status is text so a timeout or
    ; failure cannot be confused with a present scalar result.
    (defn fcatw-result (status reason value kind steps)
        (list status reason value kind steps))
    (defn fcatw-status (r) (nth r 0))
    (defn fcatw-reason (r) (nth r 1))
    (defn fcatw-value (r) (nth r 2))
    (defn fcatw-kind (r) (nth r 3))
    (defn fcatw-steps (r) (nth r 4))
    (defn fcatw-ok? (r) (if (str_eq (fcatw-status r) "returned") 1 0))
    (defn fcatw-returned (value kind steps)
        (fcatw-result "returned" "resident-thought-returned" value kind steps))
    (defn fcatw-timeout (steps)
        (fcatw-result "timeout" "walker-fuel-exhausted" (nothing)
            (fcatw-kind-nothing) steps))
    (defn fcatw-failure (reason steps)
        (fcatw-result "failure" reason (nothing) (fcatw-kind-nothing) steps))
    (defn fcatw-output-count (r) (if (eq (fcatw-ok? r) 1) 1 0))

    ; Five deliberately distinct NodeID families.  31.2.0.91..95 were empty
    ; in the repository-wide category census when witnessed on 2026-08-26.
    (defn fcatw-row-category () (make_nodeid 31 2 0 91))
    (defn fcatw-sequence-category () (make_nodeid 31 2 0 92))
    (defn fcatw-image-category () (make_nodeid 31 2 0 93))
    (defn fcatw-binding-category () (make_nodeid 31 2 0 94))
    (defn fcatw-registry-category () (make_nodeid 31 2 0 95))

    (defn fcatw-row (tag a b c)
        (intern_node (fcatw-row-category)
            (list (intern_trivial_int tag) (intern_trivial_int a)
                  (intern_trivial_int b) (intern_trivial_int c))))
    (defn fcatw-row-child (row at) (node_value (nth (node_children row) at)))
    (defn fcatw-tag (row) (fcatw-row-child row 0))
    (defn fcatw-a (row) (fcatw-row-child row 1))
    (defn fcatw-b (row) (fcatw-row-child row 2))

    ; Byte-for-byte the same node coordinates as the canonical 60-node PIF;
    ; only the envelope/decoder furniture is absent from this resident organ.
    (defn fcatw-nodes ()
        (list
            (fcatw-row 2 0 0 0)
            (fcatw-row 1 0 0 0) (fcatw-row 1 1 0 0)
            (fcatw-row 1 2 0 0) (fcatw-row 1 3 0 0)
            (fcatw-row 1 4 0 0) (fcatw-row 1 5 0 0)
            (fcatw-row 1 6 0 0) (fcatw-row 1 7 0 0)
            (fcatw-row 1 8 0 0) (fcatw-row 1 9 0 0)
            (fcatw-row 1 10 0 0) (fcatw-row 1 11 0 0)
            (fcatw-row 1 12 0 0) (fcatw-row 1 13 0 0)
            (fcatw-row 1 14 0 0) (fcatw-row 1 15 0 0)
            (fcatw-row 23 0 1 0) (fcatw-row 23 0 2 0)
            (fcatw-row 23 0 3 0) (fcatw-row 23 0 4 0)
            (fcatw-row 23 0 5 0) (fcatw-row 23 0 6 0)
            (fcatw-row 23 0 7 0) (fcatw-row 23 0 8 0)
            (fcatw-row 23 0 9 0) (fcatw-row 23 0 10 0)
            (fcatw-row 23 0 11 0) (fcatw-row 23 0 12 0)
            (fcatw-row 23 0 13 0) (fcatw-row 23 0 14 0)
            (fcatw-row 23 0 15 0) (fcatw-row 23 0 16 0)
            (fcatw-row 24 0 0 0) (fcatw-row 24 1 0 0)
            (fcatw-row 80 17 18 0)
            (fcatw-row 26 19 20 0) (fcatw-row 26 21 22 0)
            (fcatw-row 26 21 33 0) (fcatw-row 26 23 24 0)
            (fcatw-row 102 25 26 0) (fcatw-row 102 25 2 0)
            (fcatw-row 102 27 28 0) (fcatw-row 102 27 2 0)
            (fcatw-row 102 29 30 0) (fcatw-row 102 29 2 0)
            (fcatw-row 26 31 32 0) (fcatw-row 26 31 34 0)
            (fcatw-row 42 35 36 0) (fcatw-row 42 48 37 0)
            (fcatw-row 42 49 38 0) (fcatw-row 42 50 39 0)
            (fcatw-row 42 51 40 0) (fcatw-row 42 52 41 0)
            (fcatw-row 42 53 42 0) (fcatw-row 42 54 43 0)
            (fcatw-row 42 55 44 0) (fcatw-row 42 56 45 0)
            (fcatw-row 42 57 46 0) (fcatw-row 42 58 47 0)))

    (defn fcatw-strings ()
        (list "hit" "choice,cut,release"))
    (defn fcatw-root () 59)
    ; sequence children begin with a text role and then carry actual nodes.
    ; The role is inside identity, so rows/strings/ABI cannot be exchanged.
    (defn fcatw-sequence (role children)
        (intern_node (fcatw-sequence-category)
            (cons (intern_trivial_string role) children)))
    (defn fcatw-sequence-role (sequence)
        (node_value (head (node_children sequence))))
    (defn fcatw-sequence-values (sequence) (tail (node_children sequence)))
    (defn fcatw-sequence-is? (sequence role)
        (if (nothing? sequence) 0
        (if (not (node_eq (node_category sequence)
                          (fcatw-sequence-category))) 0
        (if (eq (len (node_children sequence)) 0) 0
            (if (str_eq (fcatw-sequence-role sequence) role) 1 0)))))

    (defn fcatw-int-nodes (xs)
        (if (nil? xs) (empty)
            (cons (intern_trivial_int (head xs))
                  (fcatw-int-nodes (tail xs)))))
    (defn fcatw-string-nodes (xs)
        (if (nil? xs) (empty)
            (cons (intern_trivial_string (head xs))
                  (fcatw-string-nodes (tail xs)))))
    (defn fcatw-kinds-from-nodes (nodes)
        (if (nil? nodes) (empty)
            (cons (node_value (head nodes))
                  (fcatw-kinds-from-nodes (tail nodes)))))
    (defn fcatw-abi (kinds)
        (fcatw-sequence "typed-value-abi-v1" (fcatw-int-nodes kinds)))
    (defn fcatw-rows-node (rows) (fcatw-sequence "rows" rows))
    (defn fcatw-strings-node (strings)
        (fcatw-sequence "strings" (fcatw-string-nodes strings)))

    ; Image identity is the recursively interned content itself.  No held hash
    ; field can drift from it and no printable coordinate is treated as data.
    (defn fcatw-image-schema () "form-thought-program-image-v2")
    (defn fcatw-image (abi-kinds nodes strings root)
        (intern_node (fcatw-image-category)
            (list (intern_trivial_string (fcatw-image-schema))
                  (fcatw-abi abi-kinds)
                  (fcatw-rows-node nodes)
                  (fcatw-strings-node strings)
                  (intern_trivial_int root))))
    (defn fcatw-image-child (image at) (nth (node_children image) at))
    (defn fcatw-image-abi (image) (fcatw-image-child image 1))
    (defn fcatw-image-nodes (image)
        (fcatw-sequence-values (fcatw-image-child image 2)))
    (defn fcatw-image-string-nodes (image)
        (fcatw-sequence-values (fcatw-image-child image 3)))
    (defn fcatw-image-strings (image)
        (if (nil? (fcatw-image-string-nodes image)) (empty)
            (cons (node_value (head (fcatw-image-string-nodes image)))
                  (fcatw-image-strings-tail
                    (tail (fcatw-image-string-nodes image))))))
    (defn fcatw-image-strings-tail (nodes)
        (if (nil? nodes) (empty)
            (cons (node_value (head nodes))
                  (fcatw-image-strings-tail (tail nodes)))))
    (defn fcatw-image-root (image) (node_value (fcatw-image-child image 4)))
    (defn fcatw-image-kinds (image)
        (fcatw-kinds-from-nodes
            (fcatw-sequence-values (fcatw-image-abi image))))
    (defn fcatw-node-at (image node-id)
        (nth (fcatw-image-nodes image) node-id))

    (defn fcatw-supported-tag? (tag)
        (if (or (eq tag 1) (or (eq tag 2) (or (eq tag 23)
            (or (eq tag 24) (or (eq tag 26) (or (eq tag 42)
            (or (eq tag 80) (eq tag 102)))))))) 1 0))
    (defn fcatw-ref-valid? (at count) (if (and (ge at 0) (lt at count)) 1 0))
    (defn fcatw-row-valid? (row node-count string-count)
        (if (nothing? row) 0
        (if (not (node_eq (node_category row) (fcatw-row-category))) 0
        (if (not (eq (len (node_children row)) 4)) 0
        (if (eq (fcatw-supported-tag? (fcatw-tag row)) 0) 0
        (if (eq (fcatw-tag row) 24)
            (fcatw-ref-valid? (fcatw-a row) string-count)
        (if (or (eq (fcatw-tag row) 23) (or (eq (fcatw-tag row) 26)
            (or (eq (fcatw-tag row) 42) (or (eq (fcatw-tag row) 80)
                                             (eq (fcatw-tag row) 102)))))
            (if (and (eq (fcatw-ref-valid? (fcatw-a row) node-count) 1)
                     (eq (fcatw-ref-valid? (fcatw-b row) node-count) 1)) 1 0)
            1)))))))
    (defn fcatw-rows-valid? (rows node-count string-count)
        (if (nil? rows) 1
            (if (eq (fcatw-row-valid? (head rows) node-count string-count) 1)
                (fcatw-rows-valid? (tail rows) node-count string-count) 0)))
    (defn fcatw-string-nodes-valid? (nodes)
        (if (nil? nodes) 1
            (if (eq (node_type (head nodes)) 2)
                (fcatw-string-nodes-valid? (tail nodes)) 0)))
    (defn fcatw-kind-value-valid? (kind)
        (if (and (ge kind (fcatw-kind-nothing))
                 (le kind (fcatw-kind-list))) 1 0))
    (defn fcatw-kind-nodes-valid? (nodes)
        (if (nil? nodes) 1
            (if (and (eq (node_type (head nodes)) 1)
                     (eq (fcatw-kind-value-valid? (node_value (head nodes))) 1))
                (fcatw-kind-nodes-valid? (tail nodes)) 0)))
    (defn fcatw-image-valid? (image)
        (if (nothing? image) 0
        (if (not (node_eq (node_category image) (fcatw-image-category))) 0
        (if (not (eq (len (node_children image)) 5)) 0
        (if (not (str_eq (node_value (fcatw-image-child image 0))
                         (fcatw-image-schema))) 0
        (if (eq (fcatw-sequence-is? (fcatw-image-child image 1)
                                    "typed-value-abi-v1") 0) 0
        (if (eq (fcatw-sequence-is? (fcatw-image-child image 2) "rows") 0) 0
        (if (eq (fcatw-sequence-is? (fcatw-image-child image 3) "strings") 0) 0
        (if (not (eq (node_type (fcatw-image-child image 4)) 1)) 0
        (if (not (gt (len (fcatw-image-nodes image)) 0)) 0
        (if (eq (fcatw-ref-valid? (fcatw-image-root image)
                                  (len (fcatw-image-nodes image))) 0) 0
        (if (eq (fcatw-kind-nodes-valid?
                    (fcatw-sequence-values (fcatw-image-abi image))) 0) 0
        (if (eq (fcatw-string-nodes-valid?
                    (fcatw-image-string-nodes image)) 0) 0
            (fcatw-rows-valid? (fcatw-image-nodes image)
                (len (fcatw-image-nodes image))
                (len (fcatw-image-string-nodes image))))))))))))))))

    (defn fcatw-kinds-equal? (expected actual)
        (if (nil? expected) (if (nil? actual) 1 0)
        (if (nil? actual) 0
        (if (eq (head expected) (head actual))
            (fcatw-kinds-equal? (tail expected) (tail actual)) 0))))
    (defn fcatw-input-valid? (image values kinds)
        (if (not (eq (len values) (len (fcatw-image-kinds image)))) 0
            (fcatw-kinds-equal? (fcatw-image-kinds image) kinds)))

    ; A binding holds the actual image NodeID, so resolution can read its
    ; children.  registry-admit is idempotent for an exact replay.
    (defn fcatw-binding (symbol image)
        (intern_node (fcatw-binding-category)
            (list (intern_trivial_string symbol) image)))
    (defn fcatw-binding-symbol (binding)
        (node_value (head (node_children binding))))
    (defn fcatw-binding-image (binding) (nth (node_children binding) 1))
    (defn fcatw-binding-valid? (binding)
        (if (nothing? binding) 0
        (if (not (node_eq (node_category binding) (fcatw-binding-category))) 0
        (if (not (eq (len (node_children binding)) 2)) 0
        (if (not (eq (node_type (head (node_children binding))) 2)) 0
        (if (not (gt (str_len (fcatw-binding-symbol binding)) 0)) 0
            (fcatw-image-valid? (fcatw-binding-image binding))))))))
    (defn fcatw-registry (bindings)
        (intern_node (fcatw-registry-category) bindings))
    (defn fcatw-registry-bindings (registry) (node_children registry))
    (defn fcatw-binding-present? (bindings binding)
        (if (nil? bindings) 0
            (if (node_eq (head bindings) binding) 1
                (fcatw-binding-present? (tail bindings) binding))))
    ; movement = status reason changed-registry prior-registry changed?
    (defn fcatw-movement (status reason registry prior changed)
        (list status reason registry prior changed))
    (defn fcatw-movement-status (movement) (nth movement 0))
    (defn fcatw-movement-reason (movement) (nth movement 1))
    (defn fcatw-movement-registry (movement) (nth movement 2))
    (defn fcatw-movement-prior (movement) (nth movement 3))
    (defn fcatw-movement-changed (movement) (nth movement 4))
    (defn fcatw-admit (registry binding)
        (if (eq (fcatw-binding-valid? binding) 0)
            (fcatw-movement "failure" "binding-malformed" registry registry 0)
            (if (eq (fcatw-binding-present?
                    (fcatw-registry-bindings registry) binding) 1)
                (fcatw-movement "returned" "exact-replay" registry registry 0)
                (fcatw-movement "returned" "binding-admitted"
                    (fcatw-registry
                        (cons binding (fcatw-registry-bindings registry)))
                    registry 1))))
    (defn fcatw-registry-admit (registry binding)
        (fcatw-movement-registry (fcatw-admit registry binding)))
    (defn fcatw-binding-matches (bindings symbol)
        (if (nil? bindings) (empty)
            (if (and (eq (fcatw-binding-valid? (head bindings)) 1)
                     (str_eq (fcatw-binding-symbol (head bindings)) symbol))
                (cons (head bindings)
                      (fcatw-binding-matches (tail bindings) symbol))
                (fcatw-binding-matches (tail bindings) symbol))))
    ; resolution = status reason image dispatch-count choice-count
    (defn fcatw-resolution (status reason image dispatch choices)
        (list status reason image dispatch choices))
    (defn fcatw-resolution-status (r) (nth r 0))
    (defn fcatw-resolution-reason (r) (nth r 1))
    (defn fcatw-resolution-image (r) (nth r 2))
    (defn fcatw-resolution-dispatch (r) (nth r 3))
    (defn fcatw-resolution-choices (r) (nth r 4))
    (defn fcatw-resolve (registry symbol)
        (if (or (nothing? registry)
                (not (node_eq (node_category registry)
                              (fcatw-registry-category))))
            (fcatw-resolution "failure" "registry-malformed" (nothing) 0 0)
            (do
                (let matches (fcatw-binding-matches
                    (fcatw-registry-bindings registry) symbol))
                (if (eq (len matches) 0)
                    (fcatw-resolution "nothing" "symbol-not-found"
                        (nothing) 0 0)
                (if (gt (len matches) 1)
                    (fcatw-resolution "choice" "ambiguous-symbol"
                        (nothing) 0 (len matches))
                    (fcatw-resolution "ready" "image-node-resolved"
                        (fcatw-binding-image (head matches)) 1 1))))))

    (defn fcatw-image-offered? (bindings image)
        (if (nil? bindings) 0
            (if (node_eq (fcatw-binding-image (head bindings)) image) 1
                (fcatw-image-offered? (tail bindings) image))))
    (defn fcatw-bindings-without-symbol (bindings symbol)
        (if (nil? bindings) (empty)
            (if (and (eq (fcatw-binding-valid? (head bindings)) 1)
                     (str_eq (fcatw-binding-symbol (head bindings)) symbol))
                (fcatw-bindings-without-symbol (tail bindings) symbol)
                (cons (head bindings)
                      (fcatw-bindings-without-symbol (tail bindings) symbol)))))
    ; Cut is explicit and reversible.  It cannot manufacture an unoffered
    ; image or silently decide a non-choice.  Undo returns the prior root.
    (defn fcatw-cut (registry symbol image)
        (do
            (let matches (fcatw-binding-matches
                (fcatw-registry-bindings registry) symbol))
            (if (le (len matches) 1)
                (fcatw-movement "nothing" "cut-needs-choice"
                    registry registry 0)
            (if (eq (fcatw-image-offered? matches image) 0)
                (fcatw-movement "failure" "cut-image-not-offered"
                    registry registry 0)
                (fcatw-movement "returned" "choice-cut"
                    (fcatw-registry
                        (cons (fcatw-binding symbol image)
                              (fcatw-bindings-without-symbol
                                (fcatw-registry-bindings registry) symbol)))
                    registry 1)))))
    (defn fcatw-undo (movement) (fcatw-movement-prior movement))

    ; One resident binding is the current producer data, not a branch in the
    ; reducer.  Tests admit images created after this source was compiled.
    (defn fcatw-current-kinds ()
        (list
            (fcatw-kind-node) (fcatw-kind-node)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-string) (fcatw-kind-string)
            (fcatw-kind-int) (fcatw-kind-int)
            (fcatw-kind-int) (fcatw-kind-int)
            (fcatw-kind-int) (fcatw-kind-int)
            (fcatw-kind-string) (fcatw-kind-string)))
    (defn fcatw-current-image ()
        (fcatw-image (fcatw-current-kinds) (fcatw-nodes) (fcatw-strings)
            (fcatw-root)))
    (defn fcatw-current-binding ()
        (fcatw-binding (fcatw-symbol) (fcatw-current-image)))
    (defn fcatw-current-registry ()
        (fcatw-registry (list (fcatw-current-binding))))

    (defn fcatw-with-parent (r left-steps)
        (fcatw-result (fcatw-status r) (fcatw-reason r) (fcatw-value r)
            (fcatw-kind r) (add 1 (add left-steps (fcatw-steps r)))))

    (defn fcatw-eval-binary-right
        (image tag right-id remaining values kinds left)
        (do
            (let right (fcatw-eval image right-id remaining values kinds))
            (if (eq (fcatw-ok? right) 0)
                (fcatw-with-parent right (fcatw-steps left))
                (do
                    (let steps (add 1 (add (fcatw-steps left)
                                            (fcatw-steps right))))
                    (if (eq tag 42)
                        (if (and (eq (fcatw-kind left) (fcatw-kind-int))
                                 (eq (fcatw-kind right) (fcatw-kind-int)))
                            (fcatw-returned
                                (mul (fcatw-value left) (fcatw-value right))
                                (fcatw-kind-int) steps)
                            (fcatw-failure "integer-values-required" steps))
                    (if (eq tag 102)
                        (if (and (eq (fcatw-kind left) (fcatw-kind-int))
                                 (eq (fcatw-kind right) (fcatw-kind-int)))
                            (fcatw-returned
                                (if (eq (fcatw-value left)
                                        (fcatw-value right)) 1 0)
                                (fcatw-kind-int) steps)
                            (fcatw-failure "integer-values-required" steps))
                    (if (eq tag 26)
                        (if (and (eq (fcatw-kind left) (fcatw-kind-string))
                                 (eq (fcatw-kind right) (fcatw-kind-string)))
                            (fcatw-returned
                                (if (str_eq (fcatw-value left)
                                            (fcatw-value right)) 1 0)
                                (fcatw-kind-int) steps)
                            (fcatw-failure "string-values-required" steps))
                    (if (eq tag 80)
                        (if (and (eq (fcatw-kind left) (fcatw-kind-node))
                                 (eq (fcatw-kind right) (fcatw-kind-node)))
                            (fcatw-returned
                                (if (node_eq (fcatw-value left)
                                             (fcatw-value right)) 1 0)
                                (fcatw-kind-int) steps)
                            (fcatw-failure "node-values-required" steps))
                        (fcatw-failure "unsupported-binary-tag" steps)))))))))

    (defn fcatw-eval-binary (image row budget values kinds)
        (do
            (let left (fcatw-eval image (fcatw-a row) (sub budget 1)
                values kinds))
            (if (eq (fcatw-ok? left) 0) (fcatw-with-parent left 0)
                (do
                    (let remaining (sub (sub budget 1) (fcatw-steps left)))
                    (if (le remaining 0)
                        (fcatw-timeout (add 1 (fcatw-steps left)))
                        (fcatw-eval-binary-right image (fcatw-tag row)
                            (fcatw-b row) remaining values kinds left))))))

    (defn fcatw-eval-nth (image row budget values kinds)
        (do
            (let left (fcatw-eval image (fcatw-a row) (sub budget 1)
                values kinds))
            (if (eq (fcatw-ok? left) 0) (fcatw-with-parent left 0)
                (do
                    (let remaining (sub (sub budget 1) (fcatw-steps left)))
                    (if (le remaining 0)
                        (fcatw-timeout (add 1 (fcatw-steps left)))
                        (do
                            (let right (fcatw-eval image (fcatw-b row) remaining
                                values kinds))
                            (if (eq (fcatw-ok? right) 0)
                                (fcatw-with-parent right (fcatw-steps left))
                                (do
                                    (let steps (add 1 (add (fcatw-steps left)
                                        (fcatw-steps right))))
                                    (let at (fcatw-value right))
                                    (if (not (eq (fcatw-kind left)
                                                 (fcatw-kind-list)))
                                        (fcatw-failure "list-value-required" steps)
                                    (if (not (eq (fcatw-kind right)
                                                 (fcatw-kind-int)))
                                        (fcatw-failure "integer-index-required" steps)
                                    (if (or (lt at 0) (ge at (len values)))
                                        (fcatw-failure "list-index-out-of-range" steps)
                                        (fcatw-returned (nth values at)
                                            (nth kinds at) steps))))))))))))

    (defn fcatw-eval (image node-id budget values kinds)
        (if (le budget 0) (fcatw-timeout 0)
        (if (or (lt node-id 0)
                (ge node-id (len (fcatw-image-nodes image))))
            (fcatw-failure "child-out-of-range" 0)
            (do
                (let row (fcatw-node-at image node-id))
                (let tag (fcatw-tag row))
                (if (eq tag 1)
                    (fcatw-returned (fcatw-a row) (fcatw-kind-int) 1)
                (if (eq tag 2)
                    (fcatw-returned values (fcatw-kind-list) 1)
                (if (eq tag 24)
                    (if (or (lt (fcatw-a row) 0)
                            (ge (fcatw-a row)
                                (len (fcatw-image-strings image))))
                        (fcatw-failure "string-index-out-of-range" 1)
                        (fcatw-returned
                            (nth (fcatw-image-strings image) (fcatw-a row))
                            (fcatw-kind-string) 1))
                (if (eq tag 23)
                    (fcatw-eval-nth image row budget values kinds)
                (if (or (eq tag 26) (or (eq tag 42)
                    (or (eq tag 80) (eq tag 102))))
                    (fcatw-eval-binary image row budget values kinds)
                    (fcatw-failure "unsupported-tag" 1))))))))))

    ; Missing or malformed capability declines before execution.  This keeps
    ; absence distinct from a resident disagreement (returned value 0).
    (defn fcatw-run-image (image values kinds fuel)
        (if (not (eq (fcatw-image-valid? image) 1)) (nothing)
        (if (eq (fcatw-input-valid? image values kinds) 0) (nothing)
            (fcatw-eval image (fcatw-image-root image) fuel values kinds))))
    (defn fcatw-run-by-symbol (registry symbol values kinds fuel)
        (do
            (let resolution (fcatw-resolve registry symbol))
            (if (not (str_eq (fcatw-resolution-status resolution) "ready"))
                (nothing)
                (fcatw-run-image (fcatw-resolution-image resolution)
                    values kinds fuel))))
    (defn fcatw-run (values kinds fuel)
        (fcatw-run-by-symbol (fcatw-current-registry) (fcatw-symbol)
            values kinds fuel))

    0)
