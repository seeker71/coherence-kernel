; form-cli-lane-mint-run.fk — mint skill x lane samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lane-mint-xtal.fk

(do
    (let rows (fln-corpus 1 1))
    (let n (fln-n 1 1))
    (let correct (fln-heldout-correct rows))
    (print_str (str_concat "fln n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fln unique=" (str_concat (int_to_str (fln-unique rows)) "\n")))
    (print_str (str_concat "fln leakage=" (str_concat (int_to_str (fln-leakage rows)) "\n")))
    (print_str (str_concat "fln heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fln heldout-n=" (str_concat (int_to_str (fln-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fln covers-all=" (str_concat (int_to_str (fln-covers-all rows)) "\n")))
    (print_str (str_concat "fln lora-writer=" (str_concat (int_to_str (fln-lora-writer)) "\n")))
    (print_str (str_concat "fln check=" (str_concat (int_to_str (fln-check)) "\n")))
    (print_str (str_concat "fln scale-2-1=" (str_concat (int_to_str (fln-n 2 1)) "\n")))
    (print_str (str_concat "fln sample-how=" (str_concat (nth (fln-row "assemblage" "how" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fln sample-when=" (str_concat (nth (fln-row "timeout" "when" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fln sample-query=" (str_concat (nth (fln-row "axiom" "knowledge-query" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fln sample-walk=" (str_concat (nth (fln-row "bml" "walk" 0 (SplitTrain)) 2) "\n")))
    0)
