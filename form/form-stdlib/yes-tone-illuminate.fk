; yes-tone-illuminate.fk — a Shamballa Light tone lights a name.
;
; Yes said the twelve tones could illuminate a blueprint recipe, a
; cell, a symbol, or a locale name. The dictionary already holds most
; of these digits as Light codes. Two do not: 77777 and 108 — honest
; absence, not a new row invented to fill the stream.
;
; Four kinds. The caller names the kind. The tone does not mean the
; name it lights. The correspondence is a declared draw (digit-sum
; modulo table length), the same honesty as light-codes-bootstrap.
; Surface stays the dictionary. The light is a separate face.
;
; Tables are small and already in the body:
;   recipe  Form constructor names (add, do, let, if, fndef)
;   cell    living paths in this organ
;   symbol  the four publicly attested Shamballa symbol names
;   locale  Helvellyn — the only place the Light sheet names
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/yes-tone-stream.fk form-stdlib/grammars/shamballa-light-codes.fk
; Proven by: form-stdlib/tests/yes-tone-illuminate-band.fk
; witnessed: 2026-08-15 -> 4095

(do
    (defn yti-kind-recipe () 0)
    (defn yti-kind-cell   () 1)
    (defn yti-kind-symbol () 2)
    (defn yti-kind-locale () 3)

    (defn yti-code (i)
        (if (eq (yts-at i) 0) "000" (int_to_str (yts-at i))))

    (defn yti-surface (i) (slc-answer (yti-code i)))
    (defn yti-attested? (i)
        (slc-known? (slc-decode (yti-code i))))

    (defn yti-recipes () (list "add" "do" "let" "if" "fndef"))
    (defn yti-cells ()
        (list "form/form-stdlib/yes-tone-stream.fk"
              "form/form-stdlib/agent-gate.fk"
              "form/form-stdlib/land-cadence.fk"
              "form/form-stdlib/light-codes-bootstrap.fk"))
    (defn yti-symbols ()
        (list "Mer Ka Fa Ka Lish Ma"
              "Atlantean Dai Ko Myo"
              "Ho Ka O iLi iLi"
              "Shamballa Crystal"))
    (defn yti-locales () (list "Helvellyn"))

    (defn yti-table (kind)
        (if (eq kind (yti-kind-recipe)) (yti-recipes)
            (if (eq kind (yti-kind-cell)) (yti-cells)
                (if (eq kind (yti-kind-symbol)) (yti-symbols)
                    (yti-locales)))))

    (defn yti-digit-sum-from (s i n acc)
        (if (ge i n) acc
            (yti-digit-sum-from s (add i 1) n (add acc (str_byte_at s i)))))
    (defn yti-digit-sum (s) (yti-digit-sum-from s 0 (str_len s) 0))

    (defn yti-nth (xs i)
        (if (eq i 0) (head xs) (yti-nth (tail xs) (sub i 1))))

    (defn yti-draw (i kind)
        (do
            (let tbl (yti-table kind))
            (yti-nth tbl (mod (yti-digit-sum (yti-code i)) (len tbl)))))

    (defn yti-disclaimer ()
        "[draw: deterministic over the named table, NOT a meaning of the code]")

    (defn yti-seam () " || light (declared draw, not meaning): ")

    (defn yti-light (i kind)
        (str_concat (yti-surface i)
            (str_concat (yti-seam)
                (str_concat (yti-disclaimer)
                    (str_concat " " (yti-draw i kind))))))

    (defn ytik (cond bit) (if cond bit 0))
    (defn yti-check ()
        (do
            (add (add (add (add (add (add (add (add (add (add (add
                (ytik (str_eq (yti-code 8) "000") 1)
                (ytik (eq (yti-attested? 0) 1) 2))
                (ytik (eq (yti-attested? 1) 1) 4))
                (ytik (eq (yti-attested? 2) 0) 8))
                (ytik (eq (yti-attested? 9) 0) 16))
                (ytik (eq (yti-attested? 6) 1) 32))
                (ytik (eq (yti-attested? 7) 1) 64))
                (ytik (eq (yti-attested? 5) 1) 128))
                (ytik (str_eq (yti-draw 0 (yti-kind-recipe))
                              (yti-draw 0 (yti-kind-recipe))) 256))
                (ytik (str_eq (yti-draw 0 (yti-kind-locale)) "Helvellyn") 512))
                (ytik (if (eq (str_find (yti-light 0 (yti-kind-cell)) (yti-disclaimer) 0) -1)
                          0 1) 1024))
                (ytik (eq (len (yti-symbols)) 4) 2048))))

    0)
