; qwen-lora-head.fk — local Qwen-width rank-one adapter artifact and admission.
;
; A and B are float32 safetensors, both width 5120: Qwen3.8's declared
; output-normalized hidden width.  The bytes are minted entirely by Form from
; the already-local corpus, then handed to q38-lora-rank1-open.  That opens
; independent Metal buffers; it cannot write the GGUF mmap or output.weight.
;
; This is an explicitly untrained seed, not a quality or voice claim.  It gives
; the future native trainer one concrete Qwen-shaped artifact and the exact
; admission door its measured rows must cross.
;
; Proven by: form-stdlib/tests/qwen-lora-head-band.fk
; preludes: form-stdlib/lora-adapter.bml native/metal/qwen35-dense-token-handle.fk

(do
    (defn qlh-width () 5120)
    (defn qlh-rank () 1)
    (defn qlh-path () ".form-qwen-lora-head.safetensors")
    (defn qlh-corpus-path () ".form-lora-corpus")
    (defn qlh-a-name () "model.output.weight.lora_a")
    (defn qlh-b-name () "model.output.weight.lora_b")
    (defn qlh-fallback () "form native observation carries a local voice home")
    (defn qlh-source ()
        (if (gt (file_size (qlh-corpus-path)) 0)
            (read_file (qlh-corpus-path))
            (qlh-fallback)))
    (defn qlh-byte (s i)
        (str_byte_at s (mod i (str_len s))))
    ; Both vectors remain small: the seed proves physical admission without
    ; presenting a corpus hash as a learned gradient.
    (defn qlh-a-value (s i)
        (div (str_to_float (int_to_str (sub (mod (add (qlh-byte s i) i) 31) 15)))
             1048576.0))
    (defn qlh-b-value (s i)
        (div (str_to_float (int_to_str (sub (mod (add (qlh-byte s (add i 97)) (mul i 3)) 31) 15)))
             16777216.0))
    (defn qlh-values-go (s kind i n acc)
        (if (ge i n) (reverse acc)
            (qlh-values-go s kind (add i 1) n
                (cons (if (eq kind 0) (qlh-a-value s i) (qlh-b-value s i)) acc))))
    (defn qlh-values (s kind) (qlh-values-go s kind 0 (qlh-width) (empty)))
    (defn qlh-tensors (s)
        (list (list (qlh-a-name) (list (qlh-width) (qlh-rank)) (qlh-values s 0))
              (list (qlh-b-name) (list (qlh-rank) (qlh-width)) (qlh-values s 1))))
    (defn qlh-write (path source) (ln-write path (qlh-tensors source)))
    (defn qlh-tensor-bytes (path name)
        (do
            (let h (la-header path))
            (let start (ln-tensor-begin h name))
            (if (lt start 0) ""
                (read_file_slice path
                    (add 8 (add (la-header-len path) start))
                    (mul (qlh-width) 4)))))
    (defn qlh-whole? (path)
        (do
            (let c (la-census path))
            (if (and (eq (nth c 1) 1)
                     (and (eq (nth c 2) 1)
                          (and (str_eq (nth c 3) "f32")
                               (and (eq (nth c 7) 1)
                                    (and (eq (str_len (qlh-tensor-bytes path (qlh-a-name))) (mul (qlh-width) 4))
                                         (eq (str_len (qlh-tensor-bytes path (qlh-b-name))) (mul (qlh-width) 4)))))))
                1 0)))
    (defn qlh-admit (path)
        (if (eq (qlh-whole? path) 1)
            (q38-lora-rank1-open
                (qlh-tensor-bytes path (qlh-a-name))
                (qlh-tensor-bytes path (qlh-b-name))
                (qlh-width) (md-f32-bits 1.0))
            (empty)))
    (defn qlh-admitted? (adapter)
        (q38-lora-rank1-valid? adapter (qlh-width)))
    (defn qlh-close (adapter) (q38-lora-rank1-close adapter))
    0)
