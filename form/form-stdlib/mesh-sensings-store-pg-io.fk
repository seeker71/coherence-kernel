; mesh-sensings-store-pg-io.fk — the libpq boundary of the cross-machine
; sensings store, split out of mesh-sensings-store-pg.fk 2026-08-28.
;
; preludes: form-stdlib/obs-verify.fk form-stdlib/trust-decay.fk form-stdlib/channel-interface.fk form-stdlib/satsang.fk form-stdlib/satsang-field.fk form-stdlib/persistence.fk form-stdlib/world-module-model.fk form-stdlib/world-model-growth.fk form-stdlib/organ-reading.fk form-stdlib/mesh-quorum.fk form-stdlib/mesh-sensings.fk form-stdlib/mesh-sensings-store-pg.fk
;
; WHY THIS IS ITS OWN CELL. mesh-sensings-store-pg.fk already named its own
; standing wall in its header — "the ONLY host-io is the two boundary calls
; pg_exec / pg_query" — and named it honestly. Naming a wall is not the same as
; keeping it off the neighbours' shoulders. pg_exec and pg_query are native on
; go / rust / ts and ABSENT on fkwu, and fkwu resolves every call site in a
; whole prelude chain while go / rust / ts bind lazily on execution, so
; tests/mesh-sensings-store-pg-band.fk — which proves the SQL builders and the
; whole decode pipeline with a pure fixture and never opens a connection —
; carried three unresolved calls it never makes. Measured 2026-08-28 before this
; split: the band answered 4095 on all four arms with fourth-rc=1 diagnostics=7.
;
; Everything the band asks for — msp-ddl-sql, msp-insert-sql, msp-select-sql,
; msp-decode and the column codec beneath it — stays in mesh-sensings-store-pg.fk
; where every arm can hold it. Only the boundary lives here.
;
; This is the repair cache-binary.fk made for read_form_binary /
; write_form_binary on 2026-08-14, made once at the source instead of once per
; consumer: a cell should not hand its callers a door they did not ask for and
; cannot open on their own arm. The wall is not lowered by this move — it is put
; where the presences who cross it stand.
;
; Callers today: form-stdlib/mesh-sensings-route.fk and its deployment mirror
; routers/mesh-sensings-route.fk.

(do
    ;; (msp-ensure-table conn) → conn. Idempotent sensing_readings DDL.
    (defn msp-ensure-table (conn) (do (pg_exec conn (msp-ddl-sql)) conn))

    ;; (msp-persist conn presence rd) → conn. Upsert one reading; last-write-wins
    ;; per (presence, subject) is the database's own ON CONFLICT.
    (defn msp-persist (conn presence rd) (do (pg_exec conn (msp-insert-sql presence rd)) conn))

    ;; (msp-load conn) → reading list. The decode pipeline itself is four-way in
    ;; the parent cell; only the pg_query that feeds it lives here.
    (defn msp-load (conn) (msp-decode (pg_query conn (msp-select-sql))))

    ;; the durable cross-machine consensus — read every presence's persisted
    ;; readings, quorum each
    (defn msp-durable-map (conn k) (sensings-consensus-map (msp-load conn) k))
    (defn msp-durable-consensus (conn name k) (sensings-consensus (msp-load conn) name k))

    0)
