; corpus-self-question.fk — the corpus reads its own weave and poses its own
; frontier question.
;
; Every distillation row carries a fresh word the frontier minted. Some of
; those words were re-used by LATER questions — they became vocabulary, the
; weave. Some were never spoken again — orphans, teachings the body accepted
; but never leaned on. This organ computes both, then inverts the daily
; ritual: instead of the rented mind asking the body, the body emits its own
; question — join the most-woven teaching with the oldest orphan — as a
; token list in its own question shape. Each answered row changes the weave,
; which changes the next question the body asks: a loop steered by the
; corpus's own accumulating state, not by any one mind's plan.
;
; Rows arrive as the corpus's own plain shape:
;   (meaning-id date-int question-tokens answer-word fresh-word source)
; This organ carries its own nth accessors so it stays pure over any row
; list — the live door hands it hdc-rows; the band hands it synthetic rows.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/corpus-self-question-band.fk

(do
    (defn csq-row-mid (r) (nth r 0))
    (defn csq-row-tokens (r) (nth r 2))
    (defn csq-row-fresh (r) (nth r 4))

    (defn csq-token-in? (w tokens)
        (if (eq (len tokens) 0) 0
            (if (str_eq (head tokens) w) 1
                (csq-token-in? w (tail tokens)))))

    ; how many OTHER rows speak this word in their question — the weave count
    (defn csq-uses-go (w self-mid rows n)
        (if (eq (len rows) 0) n
            (csq-uses-go w self-mid (tail rows)
                (add n (if (eq (csq-row-mid (head rows)) self-mid) 0
                    (csq-token-in? w (csq-row-tokens (head rows))))))))
    (defn csq-uses (w self-mid rows) (csq-uses-go w self-mid rows 0))

    ; weave = (best-word best-count orphan-word orphan-mid orphan-count)
    ; best: the fresh word most re-used by later questions (first wins ties);
    ; orphan: the EARLIEST fresh word never re-used (lowest meaning-id).
    (defn csq-weave-go (rows all best-w best-n orph-w orph-mid orph-n)
        (if (eq (len rows) 0)
            (list best-w best-n orph-w orph-mid orph-n)
            (do (let r (head rows))
                (let n (csq-uses (csq-row-fresh r) (csq-row-mid r) all))
                (csq-weave-go (tail rows) all
                    (if (gt n best-n) (csq-row-fresh r) best-w)
                    (if (gt n best-n) n best-n)
                    (if (and (eq n 0)
                             (or (eq orph-mid 0)
                                 (lt (csq-row-mid r) orph-mid)))
                        (csq-row-fresh r) orph-w)
                    (if (and (eq n 0)
                             (or (eq orph-mid 0)
                                 (lt (csq-row-mid r) orph-mid)))
                        (csq-row-mid r) orph-mid)
                    (add orph-n (if (eq n 0) 1 0))))))
    (defn csq-weave (rows) (csq-weave-go rows rows "" 0 "" 0 0))
    (defn csq-best-word (w) (nth w 0))
    (defn csq-best-count (w) (nth w 1))
    (defn csq-orphan-word (w) (nth w 2))
    (defn csq-orphan-mid (w) (nth w 3))
    (defn csq-orphan-count (w) (nth w 4))

    ; the body's own question, in the corpus's own token shape
    (defn csq-question (best orphan)
        (list "what" "movement" "joins" best "with" orphan))
    0)
