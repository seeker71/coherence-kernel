; form-knowledge-condition-e-observation.fk -- the sealed fused-authoring
; lineage meets the unchanged 59cb scannerless admission door.
;
; Invalid candidate bytes are not compelled into the executable harness.
; Present-invalid therefore retains lowering=nothing, harness-ran=0 and
; semantic=nothing rather than wearing the counterfeit score 0/511.
;
; preludes: form-stdlib/form-knowledge-exec-grammar-transport.fk
; preludes: form-stdlib/form-knowledge-exec-diagnostic-harness.fk
; preludes: form-stdlib/form-knowledge-heldout-authority.fk
; Proven by: form-stdlib/tests/form-knowledge-condition-e-observation-band.fk

(do
    (defn fkceo-schema () "form-knowledge-condition-e-observation-v1")
    ; tag path expected-sha actual-sha current bytes parse-signal parse-reason
    ; lowered harness-ran semantic semantic-max model-calls http remote
    (defn fkceo-observe ()
        (do
            (let raw (read_file (fkceo-path)))
            (let actual (if (nothing? raw) "" (nmfe-sha256 raw)))
            (let current (if (str_eq actual (fkceo-expected-sha)) 1 0))
            (if (eq current 0)
                (list (fkceo-schema) (fkceo-path) (fkceo-expected-sha)
                    actual 0 0 (nothing) "stale-or-absent" (nothing) 0
                    (nothing) (fkedh-perfect) 0 0 0)
                (do
                    (let signal (fkegt-parse-signal raw (fkegt-max-bytes)))
                    (let lowered (fkegt-form-source raw (fkegt-max-bytes)))
                    (list (fkceo-schema) (fkceo-path) (fkceo-expected-sha)
                        actual 1 (str_len raw) signal
                        (fkegt-parse-reason raw (fkegt-max-bytes))
                        lowered 0 (nothing) (fkedh-perfect) 0 0 0)))))

    (defn fkceo-current? (o) (nth o 4))
    (defn fkceo-bytes (o) (nth o 5))
    (defn fkceo-parse-signal (o) (nth o 6))
    (defn fkceo-parse-reason (o) (nth o 7))
    (defn fkceo-lowered (o) (nth o 8))
    (defn fkceo-harness-ran? (o) (nth o 9))
    (defn fkceo-semantic (o) (nth o 10))
    (defn fkceo-semantic-max (o) (nth o 11))
    0)
