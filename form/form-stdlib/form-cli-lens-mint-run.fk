; form-cli-lens-mint-run.fk — mint lens x lane samples, fit overlay, print lift.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint.bml

(do
    (let rows (fls-corpus 1 1))
    (let n (fls-n 1 1))
    (let correct (fls-heldout-correct rows))
    (print_str (str_concat "fls n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "fls unique=" (str_concat (int_to_str (fls-unique rows)) "\n")))
    (print_str (str_concat "fls leakage=" (str_concat (int_to_str (fls-leakage rows)) "\n")))
    (print_str (str_concat "fls heldout-correct=" (str_concat (int_to_str correct) "\n")))
    (print_str (str_concat "fls heldout-n=" (str_concat (int_to_str (fls-count-split rows (SplitHeldout))) "\n")))
    (print_str (str_concat "fls covers-all=" (str_concat (int_to_str (fls-covers-all rows)) "\n")))
    (print_str (str_concat "fls lora-writer=" (str_concat (int_to_str (fls-lora-writer)) "\n")))
    (print_str (str_concat "fls check=" (str_concat (int_to_str (fls-check)) "\n")))
    (print_str (str_concat "fls scale-2-1=" (str_concat (int_to_str (fls-n 2 1)) "\n")))
    (print_str (str_concat "fls sample-stake=" (str_concat (nth (fls-row "stake" "how" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fls sample-move=" (str_concat (nth (fls-row "lens-move" "why" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fls sample-jac=" (str_concat (nth (fls-row "jacobian" "when" 0 (SplitTrain)) 2) "\n")))
    (print_str (str_concat "fls sample-perc=" (str_concat (nth (fls-row "perception" "what" 0 (SplitTrain)) 2) "\n")))
    0)
