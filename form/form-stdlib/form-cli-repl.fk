// form-cli-repl.fk — the interactive TTY front door on the fkwu source runtime.
//
// The INTERACTIVE surface (the headless one reads fk_src):
// a read-eval-print loop over real fd 0. read_line (walker tag 114) reads one
// line of stdin, fc-respond (form-cli.fk, proven) dispatches the verb,
// print_str (tag 115) writes the response, and the loop recurses. isatty (tag
// 116) gates an interactive prompt so a piped session stays clean. The loop ends
// on EOF (read_line returns a negative sentinel) or the quit/exit verb.
//
// Deterministic and testable: output is a pure function of the stdin bytes —
// pipe a fixed transcript, get a fixed response stream (form_cli_test.go).
// read_line/print_str/isatty are host-io ops the emitted walker carries (tags
// 114/115/116); they are fkwu-native, the same way input_byte (tag 17) is. One native engine, both surfaces.
//
import form/form-stdlib/core.fk;
import form/form-stdlib/str-byte-at.fk;
import form/form-stdlib/sha256.fk;
import form/form-stdlib/hex.fk;
import form/form-stdlib/gguf-meta.fk;
import form/form-stdlib/model-discovery.fk;
import form/form-stdlib/native-model-native-hierarchy.fk;
import form/form-stdlib/native-model-control-plane.fk;
import form/form-stdlib/ask-lane-router.fk;
import form/form-stdlib/form-cli.fk;
import form/form-stdlib/form-cli-gguf-cell.fk;
import form/form-stdlib/form-cli-model-generate.fk;
import form/form-stdlib/form-cli-nodeid-knowledge-resident.fk;
import form/form-stdlib/form-cli-current-answer-thought-witness.fk;
import form/form-stdlib/form-cli-native-agent-orient.fk;
import form/form-stdlib/form-cli-nodeid-answer.fk;
import form/form-stdlib/form-cli-nodeid-know.fk;
import form/form-stdlib/form-cli-author-high.bml;
import form/form-stdlib/native-model-owner-request-flow.bml;
import form/form-stdlib/cell-channel-glass.bml;
import form/form-stdlib/meaning-codes.bml;
import form-stdlib/bml/form-cli-generate-command.bml;
section [form.bml] {
    // 'diagnose' reads the live framebuffer the walker is born with — fk_arms[t]
    // per-op dispatch counts plus the node/string/arena/value-stack/float
    // high-water — back into this running program through kernel_stat (a fkwu-only
    // op, tag 127, the read twin of self_source). The readout is the kernel
    // inspecting itself mid-session: what it is computing, how big its substrate
    // has grown, where its time is going. fkwu-only, so it sits beside source/
    // verify in the runtime wrapper, never in the shared dispatch.
    def fc-diagnose() = ("fkwu live | ops=" + (kernel_stat(0).str() + (" distinct=" + (kernel_stat(1).str() + (" hottest=tag" + (kernel_stat(2).str() + ("x" + (kernel_stat(3).str() + (" nodes=" + (kernel_stat(4).str() + (" strings=" + (kernel_stat(5).str() + (" cons=" + (kernel_stat(6).str() + (" vstack=" + (kernel_stat(7).str() + (" floats=" + kernel_stat(8).str())))))))))))))))));
    // The live framebuffer is a distinct observation channel from aggregate
    // walker statistics.  Keep its roots and four native arms visible together
    // so an inquiry can prove that a record was emitted, retained, and read.
    def fc-framebuffer-status() = {
        let events = framebuffer-events();
        ("framebuffer live | events=" + (len(events).str() + (" roots=" + (kernel_stat(9).str() + (" attributed=" + (kernel_stat(10).str() + (" rejected=" + (kernel_stat(11).str() + (" entered=" + (kernel_stat(12).str() + (" accepted=" + (kernel_stat(13).str() + (" last-index=" + (kernel_stat(14).str() + (" fb_record=" + (kernel_stat(228).str() + (" events_read=" + (kernel_stat(229).str() + (" source_read=" + (kernel_stat(230).str() + (" clears=" + kernel_stat(231).str())))))))))))))))))))));
    };
    def fc-metal-matvec(arg) = {
        let parts = split-on(arg, " ");
        let msl-path = fc-part(parts, 0, "");
        let kernel = fc-part(parts, 1, "form_fkwu_generic_matvec_f32");
        let model-path = fc-part(parts, 2, "");
        (String) msl-path == "" || (String) model-path == "" ? "usage: metal-matvec <msl-path> <kernel-name> <model-path>" : metal_matvec_f32(read_file(msl-path), kernel, read_file(model-path));
    };
    // `models <dir>` — the body looks, instead of being told. This is the runtime half of the
    // distinction: a static switch names one file before the binary runs; this names a place and asks
    // the host what is actually in it. The root is an argument because fkwu has no getenv door, so a
    // cell cannot expand `~` — that is a missing door, not a setting.
    def fc-models(arg) = {
        // fc-strip-eol is defined further down this cell and a forward reference binds
        // numb-empty here, so the trim is done in place rather than borrowed upward.
        let n0 = len(arg);
        let n1 = n0 > 0 && (Comparable) str-byte-at(arg, n0 - 1) == 10 ? n0 - 1 : n0;
        let n2 = n1 > 0 && (Comparable) str-byte-at(arg, n1 - 1) == 13 ? n1 - 1 : n1;
        let root = substring(arg, 0, n2);
        (String) root == "" ? "usage: models <directory>   (e.g. models /Users/you/models)" : fs_is_dir(root) ? ("found " + (md-list(root).str() + " model(s) — none is compiled in")) : ("no such directory: " + root);
    };
    def fc-strip-last-byte-if(s, code) = {
        let n = len(s);
        n > 0 && (Comparable) str-byte-at(s, n - 1) == code ? substring(s, 0, n - 1) : s;
    };
    def fc-strip-eol(s) = fc-strip-last-byte-if(fc-strip-last-byte-if(s, 10), 13);
    def fc-json-escape(s) = json-escape-string(s);
    def fc-http-body(response) = {
        let boundary = str_find(response, "\r\n\r\n", 0);
        boundary < 0 ? response : substring(response, (Number) boundary + (Number) 4, len(response));
    };
    // Nanbeige is a native-only voice door: Form owns the verb, ChatML
    // envelope, JSON request, raw HTTP request, and response projection.  The
    // pinned author-branch llama.cpp server performs dense tensor execution
    // behind the already-emitted fkwu socket membrane. This is an explicit
    // comparator, not the native route. JSON is retained only as evidence at
    // that loopback membrane; native execution does not need the envelope.
    def fc-nanbeige(prompt) = (String) prompt == "" ? "usage: nanbeige <prompt>" : {
        let full = ("<|im_start|>user\n" + (prompt + "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"));
        let body = ("{\"prompt\":\"" + (fc-json-escape(full) + "\",\"n_predict\":256,\"temperature\":0,\"seed\":1}"));
        let request = ("POST /completion HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: " + (len(body).str() + ("\r\n\r\n" + body)));
        let response0 = sock_request("127.0.0.1", "18082", request);
        let response = nothing?(response0) ? "" : response0;
        (String) response == "" ? "nanbeige:error:local-runtime-unreachable:127.0.0.1:18082" : fc-http-body(response);
    };
    def fc-string-bytes-loop(s, i, n, acc) = i >= n ? acc : fc-string-bytes-loop(s, (Number) i + (Number) 1, n, append(acc, [str-byte-at(s, i)]));
    def fc-string-bytes(s) = fc-string-bytes-loop(s, 0, len(s), []);
    def fc-model-cell-digest(bytes) = hex-encode(sha256(fc-string-bytes(bytes)));
    def fc-metal-model-cell(arg) = (String) arg == "" ? "usage: metal-model-cell <manifest-path>" : {
        let manifest = fc-strip-eol(read_file(arg));
        let parts = split-on(manifest, " ");
        let kind = fc-part(parts, 0, "");
        let expected-sha = fc-part(parts, 1, "");
        let model-path = fc-part(parts, 2, "");
        let msl-path = fc-part(parts, 3, "");
        let kernel = fc-part(parts, 4, "form_fkwu_generic_matvec_f32");
        (String) kind == "" || (String) expected-sha == "" || ((String) model-path == "" || (String) msl-path == "") ? "FAIL model-cell manifest expected: model-cell-v1 <sha256> <model-path> <msl-path> <kernel-name>" : (String) kind == "model-cell-v1" ? {
            let model-bytes = read_file(model-path);
            let actual-sha = fc-model-cell-digest(model-bytes);
            (String) actual-sha == expected-sha ? ("model_cell_verified=true\n" + ("model_cell_source=content-addressed-manifest\n" + ("model_cell_format=f32-matvec-v1\n" + ("model_cell_sha256=" + (actual-sha + ("\n" + metal_matvec_f32(read_file(msl-path), kernel, model-bytes))))))) : ("FAIL model-cell sha256 mismatch\nmodel_cell_verified=false\nmodel_cell_expected_sha256=" + (expected-sha + ("\nmodel_cell_sha256=" + actual-sha)));
        } : ("FAIL model-cell manifest kind=" + kind);
    };
    // ---- models -> use -> route: the runtime door onto ask-lane-router.fk ----------------------
    //
    // WHAT WAS MISSING. ask-lane-router.fk decides which lane carries a request, proven at
    // 4095, and nothing called it. A cell nothing calls is a drawing of a door. These three verbs are
    // the door: `models <dir>` asks the host what is actually on it, `use <n>` picks one of the files
    // it named, `route <request>` hands that pick to the router and reports what the router said.
    //
    // WHY THIS IS A RUNTIME CHOICE AND NOT A SWITCH. Nothing here is chosen before the binary runs.
    // The directory arrives in conversation, the index arrives in conversation, and every other input
    // the router needs is READ rather than declared: today comes from now_unix_ms, the Metal answer
    // comes from asking the linked carrier, the architecture comes from the GGUF's own header, the
    // carriers come from fs_exists on this host. No environment variable, no flag, no default
    // quietly decides.
    //
    // WHAT THE ROUTE DOES NOT DO, said out loud rather than implied. fkwu's op table carries no
    // process door (form-flatten.fk flt-ops, read 2026-08-03), so a carried route NAMES the hand and
    // does not move it. That is unfinished work with a short next step — the emitted C already
    // declares fork/execvp/waitpid for the JIT — and not a limit.
    // The host reports the day; nothing tells it. now_unix_ms (tag 15) is the one clock fkwu carries,
    // and the walk below is the era-arithmetic civil calendar, exact for every day after 1970 because
    // no division ever meets a negative. It reads UTC: at UTC+8 this body's day turns over eight hours
    // early, which a thirty-day witness TTL cannot feel — named here rather than left to be found.
    def fc-civil(days) = {
        let z = (Number) days + (Number) 719468;
        let era = z / 146097;
        let doe = z - era * 146097;
        let yoe = ((Number) (doe - doe / 1460) + (Number) (doe / 36524) - doe / 146096) / 365;
        let y0 = (Number) yoe + (Number) (era * 400);
        let doy = doe - ((Number) (365 * yoe) + (Number) (yoe / 4 - yoe / 100));
        let mp = ((Number) (5 * doy) + (Number) 2) / 153;
        let d = (Number) (doy - ((Number) (153 * mp) + (Number) 2) / 5) + (Number) 1;
        let m = mp < 10 ? (Number) mp + (Number) 3 : mp - 9;
        let y = m <= 2 ? (Number) y0 + (Number) 1 : y0;
        (Number) (y * 10000) + (Number) ((Number) (m * 100) + (Number) d);
    };
    def fc-today() = fc-civil(now_unix_ms() / 86400000);
    // Metal is asked, not assumed: the linked carrier answers for itself, and a host without one
    // says so in the same breath instead of being described by a constant in this cell.
    def fc-metal-here?() = str_find(metal_matvec_fixture(), "metal_loaded=true", 0) >= 0 ? 1 : 0;
    // A carrier path is relative, and form-cli is run both from the repo root and from form/, so both
    // are probed and the one that exists is the one reported. A path nobody checked is a rumour.
    def fc-file-here(a, b) = (Comparable) fs_exists(a) == 1 ? a : (Comparable) fs_exists(b) == 1 ? b : "";
    def fc-carrier-here(rel, arch, acc) = {
        let p = fc-file-here(rel, ("form/" + rel));
        (String) p == "" ? acc : cons(alr-carrier(p, arch), acc);
    };
    def fc-carriers() = fc-carrier-here("../observe/metal-ask-run.bml", "llama", fc-carrier-here("form-stdlib/ds4-query-channel.fk", "deepseek4", fc-carrier-here("form-stdlib/form-cli-model-generate.fk", "qwen35", fc-carrier-here("native/metal/kat-token-handle.fk", "qwen35moe", []))));
    // Only runtimes this body can see are claimed. "host-process" is absent on purpose: fkwu has no
    // process door today, so a lane that needs one is honestly unfinished rather than quietly carried.
    def fc-runtimes() = (String) fc-file-here("/opt/homebrew/bin/ollama", "/usr/local/bin/ollama") == "" ? [] : ["ollama"];
    // The architecture comes out of the file's own header, the same read `models` already does.
    def fc-blob-at(path) = {
        let src = read_file_slice(path, 0, md-header-bytes());
        let arch = md-arch(src);
        (String) arch == "" ? alr-blob(path, "", 0) : alr-blob(path, arch, md-nlayer(src, arch));
    };
    // Which registry row vouches for THIS file — architecture and key together, so a deepseek4 file
    // the ds4 lane was never witnessed against does not inherit the ds4 lane's proof.
    def fc-bind-for(blob, binds) = (Comparable) len(binds) == 0 ? alr-no-bind() : (Comparable) alr-blob-answers?(blob, binds[0]) == 1 ? binds[0] : fc-bind-for(blob, binds[1:]);
    def fc-digits?(s, i, n) = i >= n ? (Comparable) n == 0 ? 0 : 1 : str-byte-at(s, i) >= 48 && str-byte-at(s, i) <= 57 ? fc-digits?(s, (Number) i + (Number) 1, n) : 0;
    def fc-nth-path(paths, i) = (Comparable) len(paths) == 0 ? "" : i <= 0 ? paths[0] : fc-nth-path(paths[1:], i - 1);
    // `use <n>` re-walks the directory rather than remembering the last listing, so the index means
    // what the host holds now and not what it held a minute ago. md-find is order-stable, so the
    // number the person read from `models` is the number they get.
    def fc-pick(root, nstr) = (String) root == "" ? "" : (Comparable) fc-digits?(nstr, 0, len(nstr)) == 0 ? "" : fc-nth-path(md-find(root), str_to_int(nstr));
    def fc-root-of(arg, old) = (String) arg == "" ? old : (Comparable) fs_is_dir(arg) == 1 ? arg : old;
    def fc-needs-str(xs, acc) = (Comparable) len(xs) == 0 ? acc : fc-needs-str(xs[1:], (acc + (" " + xs[0])));
    def fc-hand-note(r) = (Comparable) alr-carried?(r) == 1 ? "\n    hand    fkwu carries no process door yet, so this names the hand and does not move it" : "";
    def fc-route-say(r, request) = ("— route: " + (alr-route-status(r) + ("\n    row     " + (alr-route-id(r) + ("\n    arch    " + (alr-route-arch(r) + ("\n    model   " + (fc-model-name(alr-route-blob(r)) + ("\n    blob    " + (alr-route-blob(r) + ("\n    carrier " + (alr-route-carrier(r) + ("\n    needs  " + (fc-needs-str(alr-route-needs(r), "") + ("\n    request " + (request + ("\n    because " + ((String) alr-route-reason(r) + fc-hand-note(r)))))))))))))))))));
    def fc-use(root, nstr, sel) = (String) root == "" ? "no directory has been looked at yet — run `models <dir>`, then `use <n>`" : (String) sel == "" ? ("no model at index " + (nstr + (" under " + root))) : {
        let blob = fc-blob-at(sel);
        ("using " + (sel + ("   name=" + (md-name(read_file_slice(sel, 0, md-header-bytes())) + ("  arch=" + (alr-blob-arch(blob) + ("  layers=" + (alr-blob-layers(blob).str() + "\n  now: generate <prompt> | choose <prompt> | form-layer [on|off] | model-bandwidth | route <request>"))))))));
    };
    def fc-route(sel, text) = (String) sel == "" ? "no model is picked — run `models <dir>`, then `use <n>`, then `route <request>`" : (String) text == "" ? "usage: route <request>   (after `models <dir>` and `use <n>`)" : {
        let blob = fc-blob-at(sel);
        let binds = alr-bindings();
        let bind = fc-bind-for(blob, binds);
        let registry = nmcp-registry();
        (String) alr-bind-id(bind) == "" ? ("— route: unfinished\n    blob    " + (sel + ("\n    arch    " + (alr-blob-arch(blob) + ("\n    model   " + (fc-model-name(sel) + ("\n    request " + (text + "\n    because this host can run that architecture and no registry row vouches for this file — unfinished work, and the row is the work")))))))) : {
            let row = alr-row-by-id(registry, alr-bind-id(bind));
            let host = alr-host(fc-today(), fc-metal-here?(), [blob], fc-carriers(), fc-runtimes());
            let a = alr-ask(nmcp-lane(row), nmcp-modality(row), 40, 1, 0);
            fc-route-say(alr-ask-door-by-id(registry, a, host, binds, alr-bind-id(bind)), text);
        };
    };
    // the native-only verbs read this binary's own baked source via self_source
    // (a fkwu-only op), so they live here in the runtime wrapper rather than in
    // the shared dispatch: 'source' prints the Form source the binary was built
    // from; 'verify' reports that the binary carries its own source (self-coherence);
    // 'diagnose' surfaces the live framebuffer/observability state (see above).
    // 'metal-fixture' crosses the same fkwu-only door into a linked native
    // Metal carrier when the proof binary supplies one; otherwise it reports a
    // skip instead of pretending the bridge exists.
    // 'metal-matvec' is the generic successor: MSL source bytes, kernel name, and
    // model bytes cross the same fkwu-native door into a linked carrier.
    // 'metal-model-cell' proves the model bytes are content-addressed by Form
    // before the same native Metal carrier sees them. 'gguf-model-cell'
    // proves the same content address gate for GGUF bytes, then parses tensor
    // metadata through the GGUF reader shape mirrored inside this fkwu program.
    // 'gguf-tensor-slice-math' reads one content-addressed real GGUF tensor
    // byte window and runs Q6_K Form math over that slice. 'gguf-tensor-set-cell'
    // reads a required-tensor row set from the same full GGUF through fkwu
    // read_file_slice and verifies each row's content hash in Form.
    // 'gguf-semantic-token-cell' reads one real tokenizer string row from the
    // full GGUF, selects a token from manifest logits using Form argmax, and
    // emits the decoded token text without HTTP/Ollama.
    // 'gguf-fullwidth-logits-cell' walks the full tokenizer width through
    // real GGUF token-embedding rows, computes the Q6_K dot4 projection in
    // Form, then decodes the argmax token.
    // Everything else routes to fc-respond, the proven brain.
    // seal-check <path> — the artifact instrument.  A refusal that says "no current
    // seal" is a sentence about a FILE, and on 2026-08-19 it was twice spoken when
    // the truth was about the reader: once under a stale fkwu-metal whose CPU-JIT
    // door answered 0, and once inside this binary, whose emitted carrier hashes
    // the same bytes to a different digest than the source runner does.  This verb
    // shows both halves — what the seal claims, what this binary computes, and what
    // the Metal door has to say — so the next such divergence is read, not guessed.
    // The heavy digest crosses as an ARGUMENT, not a `let`.  An argument is
    // evaluated once at the call; a `let` used twice was answering twice — the
    // first run of this instrument spent 25 s and three engine passes to print one
    // hash.  Both facts are worth keeping: the cost, and what it says about a
    // single-use binding that is not single-use.
    def fc-seal-shape(path, f, digest) = ("seal_size=" + (f[0].str() + ("\nfile_size=" + (file_size(path).str() + ("\nseal_valid=" + (qaf-seal-valid?(path).str() + ("\nseal_sha=" + (f[1] + ("\ncomputed=" + (digest + ("\ncomputed_len=" + (len(digest).str() + ("\nsaj_code_len=" + (len(saj-code()).str() + ("\ninitial_state=" + (qaf-string-hex(saj-initial-state-bytes()) + ("\nabc_expected=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" + ("\nabc_computed=" + (qaf-string-hex(saj-file-digest("/tmp/saj-abc.bin", 3)) + ("\n" + metal_status()))))))))))))))))))));
    // sha-selftest — the SHA-256 door taken apart, one 64-byte block, no file.
    // The built binary and the source runner disagree on the digest of the three
    // bytes "abc" (2026-08-19): one answers ba7816bf…, the other thirty-two zeros,
    // from the same 580-byte Form-emitted ARM64 image over the same initial state.
    // Every step of that one block is printed here so the disagreement is read at
    // the step where it starts rather than at the end where it shows.
    def fc-sha-say(k, v, acc) = (acc + ("\n" + (k + ("=" + v))));
    def fc-sha-selftest() = {
        let state = metal_buf_alloc(32);
        let rounds = metal_buf_alloc(256);
        let msg = metal_buf_alloc(64);
        // The one payload here that is NOT built at runtime.  Everything the
        // SHA door hands the buffer write — the initial state, the round
        // constants, the padding block — is composed by str_concat and
        // byte_to_str while running.  This literal travels the same call with
        // nothing composed, so a divergence that spares it names WHICH strings
        // are lost, and one that takes it too says the loss is not about that.
        let lit = metal_buf_alloc(16);
        let lw = metal_buf_write(lit, 0, "ABCDEFGH");
        let lr = metal_buf_read(lit, 0, 8);
        let pad = saj-padding-block("abc", 3);
        let sw = metal_buf_write(state, 0, saj-initial-state-bytes());
        let kw = metal_buf_write(rounds, 0, saj-round-constant-bytes());
        let mw = metal_buf_write(msg, 0, pad);
        let pipeline = metal_pipeline(saj-code(), "form_cpu_jit");
        let ran = metal_enqueue(pipeline, md-bind([msg, state, rounds], [1]), 1);
        let raw = metal_buf_read(state, 0, 32);
        let back = metal_buf_read(msg, 0, 64);
        fc-sha-say("literal_write", lw.str(), fc-sha-say("literal_readback", qaf-string-hex(lr), fc-sha-say("literal_expected", "4142434445464748", fc-sha-say("state_handle", state.str(), fc-sha-say("rounds_handle", rounds.str(), fc-sha-say("msg_handle", msg.str(), fc-sha-say("pad_len", len(pad).str(), fc-sha-say("state_write", sw.str(), fc-sha-say("rounds_write", kw.str(), fc-sha-say("msg_write", mw.str(), fc-sha-say("pipeline", pipeline.str(), fc-sha-say("enqueue", ran.str(), fc-sha-say("state_readback_len", len(raw).str(), fc-sha-say("state_readback", qaf-string-hex(raw), fc-sha-say("msg_readback", qaf-string-hex(back), fc-sha-say("digest", qaf-string-hex(saj-state-digest(raw)), fc-sha-say("expected", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", fc-sha-say("status", metal_status(), "sha-selftest"))))))))))))))))));
    };
    def fc-seal-check(path) = (String) path == "" ? "usage: seal-check <path>" : fc-seal-shape(path, qaf-seal-fields(path), qaf-string-hex(saj-file-digest(path, qaf-seal-fields(path)[0])));
    def fc-heldout-live() = {
        let t0 = now_unix_ms();
        let status = metal_status();
        let elapsed = now_unix_ms() - t0;
        let timeout-named = str_find(status, "timeout", 0) < 0 ? 0 : 1;
        fnao-heldout-speak-of(fnao-live-row(elapsed, timeout-named, len(status), 0, 0));
    };
    def fc-native(line) = (String) fc-verb(line) == "thought-kernel" ? fcatww-live() : (String) fc-verb(line) == "sha-selftest" ? fc-sha-selftest() : (String) fc-verb(line) == "seal-check" ? fc-seal-check(fc-strip-eol(fc-arg(line))) : (String) fc-verb(line) == "source" ? self_source() : (String) fc-verb(line) == "verify" ? ("coherent: this binary carries " + (len(self_source()).str() + " bytes of its own Form source (run 'source' to print it); program running native on fkwu.")) : (String) fc-verb(line) == "diagnose" ? fc-diagnose() : (String) fc-verb(line) == "framebuffer-status" ? fc-framebuffer-status() : (String) fc-verb(line) == "models" ? fc-models(fc-arg(line)) : (String) fc-verb(line) == "metal-fixture" ? metal_matvec_fixture() : (String) fc-verb(line) == "metal-matvec" ? fc-metal-matvec(fc-arg(line)) : (String) fc-verb(line) == "metal-model-cell" ? fc-metal-model-cell(fc-arg(line)) : (String) fc-verb(line) == "gguf-model-cell" ? fc-gguf-model-cell(fc-arg(line)) : (String) fc-verb(line) == "gguf-tensor-set-cell" ? fc-gguf-tensor-set-cell(fc-arg(line)) : (String) fc-verb(line) == "gguf-semantic-token-cell" ? fc-gguf-semantic-token-cell(fc-arg(line)) : (String) fc-verb(line) == "gguf-fullwidth-logits-cell" ? fc-gguf-fullwidth-logits-cell(fc-arg(line)) : (String) fc-verb(line) == "gguf-tensor-slice-math" ? fc-gguf-tensor-slice-math(fc-arg(line)) : (String) fc-verb(line) == "model-route" ? nmnh-default-id() : (String) fc-verb(line) == "nanbeige" ? fc-nanbeige(fc-arg(line)) : (String) fc-verb(line) == "orient" ? fnao-speak() : (String) fc-verb(line) == "design" ? fnao-design-speak() : (String) fc-verb(line) == "answer-generate" ? fnao-answer-generate-speak() : (String) fc-verb(line) == "held-out" ? fnao-heldout-speak() : (String) fc-verb(line) == "held-out-live" ? fc-heldout-live() : (String) fc-verb(line) == "node-id" ? fnid-speak() : (String) fc-verb(line) == "node-id-ask" ? fnid-ask-speak() : (String) fc-verb(line) == "node-id-tree" ? fnid-tree-speak() : (String) fc-verb(line) == "node-id-scale" ? fnid-scale-speak() : (String) fc-verb(line) == "node-id-know" ? fnk-know-speak() : (String) fc-verb(line) == "author-high" ? fah-speak() : fc-respond(line);
    // THE LAST PAREN ON THE LINE ABOVE closes `defn fc-native`, and until 2026-08-03 it was not there.
    // Sixteen closers shut the fifteen `if`s and left the defn open, so everything below — the repl
    // itself and the call that starts it — was reading as extra body forms INSIDE fc-native. It ran
    // anyway: the flattener lifts `defn` out of wherever it finds it, so the shape was wrong and the
    // answer was right, which is the only kind of wrong that survives. It surfaced the moment a second
    // recipe joined that swallowed region: `ping` began answering a bare number instead of pong, the
    // same number for every input including `quit`, because no loop was reading stdin at all. Counting
    // sixteen identical characters is not a practice; if you add an arm here, add its closer here too,
    // and let the voice canary — not the byte size — say whether the carrier still speaks.
    def fc-model-name(path) = (String) path == "" ? "" : md-name(read_file_slice(path, 0, md-header-bytes()));
    def fc-choose(sel, text) = (String) text == "" ? "usage: choose <prompt>   (the router names a local arch; choose-observe updates it)" : {
        let arch = (String) sel == "" ? "" : alr-blob-arch(fc-blob-at(sel));
        lmc-say(text, arch, fc-model-name(sel));
    };
    def fc-choose-observe(arg) = {
        let parts = split-on(fc-strip-eol(arg), " ");
        let task = fc-part(parts, 0, "");
        let arch = fc-part(parts, 1, "");
        let outcome = fc-part(parts, 2, "");
        (String) task == "" || (String) arch == "" ? "usage: choose-observe <task> <arch> win|lose" : lmc-cli-observe(task, arch, outcome);
    };
    def fc-nodeid-stage(arg) = {
        let parts = split-on(fc-strip-eol(arg), " ");
        fcnkr-stage(fc-part(parts, 0, ""), fc-part(parts, 1, ""));
    };
    // `use`, `route`, `local-plan`, `generate`, `nodeid-knowledge`, `choose`,
    // `form-layer`, and `model-bandwidth` consume the
    // model memory carried between
    // turns, so they ride here rather
    // than inside fc-native: fc-native is a pure function of one line, and keeping it that way is why
    // a piped transcript still answers the same bytes every time.
    // Every turn begins with what to say and what the session is still holding.
    // local-plan also retains its typed offer at index 2; the REPL consumes the
    // stable first two fields while an addressed action binder can consume it.
    // What it holds is a model already admitted — the seal verified, the tensors
    // mapped, the kernels compiled — because on this machine that admission costs
    // four times what answering a sentence costs, and it was being paid again on
    // every `generate`.  Only `generate` can change it: it is the only verb that
    // admits a model, and it is the same verb that releases one that no longer
    // matches the selection.  Every other arm hands back untouched what it was
    // given, so there is no second path and nothing to be in the middle of.
    // channel: a native channel between two cells with a shared field, on
    // glass (cell-channel.bml). The root is the hearth's channel seat.
    //   channel open <name> <a> <b>          open it (board, seed grammar, three bells)
    //   channel say|tell|offer <name> <from> <form>   one frame from <from>, peers rung
    //   channel stat <name>                  the census from the spools
    //   channel mesh                         every channel under the seat
    // Live cells are their own processes; a heard symbol is evaluated far from them, in
    // observe/cell-channel-eval-run.fk, under the caller's patience.
    def fc-channel-after-spaces(s, n, i) = n <= 0 ? substring(s, i, len(s)) : {
        let sp = str_find(s, " ", i);
        sp < 0 ? "" : fc-channel-after-spaces(s, n - 1, (Number) sp + (Number) 1);
    };
    def fc-channel-open(root, name, a, b) = {
        let o = cc-open(root, name, a, b);
        cc-cat(["channel open name=", name, " ok=", cc-open-ok(o).str(), " seed=", cc-short(cc-open-seed-id(o)), " dir=", cc-dir(root, name)]);
    };
    def fc-channel-send(root, kind, name, from, body) = {
        let s = cc-send(root, name, from, kind, body);
        (Comparable) cc-sent-ok?(s) == 1 ? cc-cat(["channel ", kind, " turn=", cc-sent-turn(s).str(), " id=", cc-short(cc-sent-id(s)), " rung=", cc-sent-rung(s).str()]) : cc-cat(["channel ", kind, " refused=", cc-sent-id(s)]);
    };
    def fc-channel-stat(root, name) = {
        let s = cc-stat(root, name);
        cc-cat(["channel stat name=", name, " a-frames=", cc-stat-a-frames(s).str(), " b-frames=", cc-stat-b-frames(s).str(), " field-frames=", cc-stat-field-frames(s).str(), " said=", cc-stat-said(s).str(), " heard=", cc-stat-heard(s).str(), " admitted=", cc-stat-admitted(s).str(), " refused=", cc-stat-refused(s).str(), " grammar=", cc-short(cc-stat-grammar-id(s)), " a-pid=", cc-stat-pid-a(s).str(), " b-pid=", cc-stat-pid-b(s).str(), " field-pid=", cc-stat-pid-field(s).str()]);
    };
    def fc-channel-mesh-names(names) = (Comparable) len(names) == 0 ? "" : (" " + ((String) names[0] + fc-channel-mesh-names(names[1:])));
    def fc-channel-mesh(root) = {
        let names = cc-mesh-names(root);
        cc-cat(["channel mesh root=", root, " channels=", len(names).str(), fc-channel-mesh-names(names)]);
    };
    def fc-channel(arg) = {
        let w = split-on(arg, " ");
        let sub = fc-part(w, 0, "");
        let root = cc-root-default();
        (String) sub == "open" ? fc-channel-open(root, fc-part(w, 1, ""), fc-part(w, 2, "a"), fc-part(w, 3, "b")) : (String) sub == "say" || ((String) sub == "tell" || (String) sub == "offer") ? fc-channel-send(root, sub, fc-part(w, 1, ""), fc-part(w, 2, ""), fc-channel-after-spaces(arg, 3, 0)) : (String) sub == "stat" ? fc-channel-stat(root, fc-part(w, 1, "")) : (String) sub == "mesh" ? fc-channel-mesh(root) : "channel: open <name> <a> <b> | say|tell|offer <name> <from> <form> | stat <name> | mesh";
    };
    def fc-said(text, res) = [text, res];
    // code: any code in (symbol, phrase, node id, a tongue or script word), every code out
    def fc-code-each(syms) = (Comparable) len(syms) == 0 ? "" : (mc-cat([syms[0], " | ", mc-line(mc-codes(syms[0]))]) + ("\n" + fc-code-each(syms[1:])));
    def fc-code(arg) = {
        let syms = mc-resolve-all(arg);
        (Comparable) len(syms) == 0 ? ("code " + (arg + " resolves to nothing (offer a row)")) : fc-code-each(syms);
    };
    def fc-code-request?(arg) = arg == "" || arg == "help" || str_find(arg, "{", 0) == 0 || str_find(arg, "@", 0) == 0;
    def fc-turn(line, root, sel, res) = (String) fc-verb(line) == "code" ? fc-said(fc-code-request?(trim(fc-arg(line))) ? fc-respond(line) : fc-code(fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "channel" ? fc-said(fc-channel(fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "model-flow" ? fc-said(nmof-summary(nmof-run-current()), res) : (String) fc-verb(line) == "help" ? fc-said((fgc-help() + ("channel: open <name> <a> <b> | say|tell|offer <name> <from> <form> | stat <name> | mesh -- a native channel between two cells with a shared field, on Glass.\nmodel-flow: advance one token through the current resident Qwen owner and publish its Q>T>L>X>E>M>F>G resource path to Form Glass.\n" + fc-native(line))), res) : (String) fc-verb(line) == "use" ? fc-said(fc-use(root, fc-strip-eol(fc-arg(line)), sel), res) : (String) fc-verb(line) == "route" ? fc-said(fc-route(sel, fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "nodeid-stage" ? fc-said(fc-nodeid-stage(fc-arg(line)), res) : (String) fc-verb(line) == "nodeid-knowledge" ? fc-said(fcnkr-query(fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "local-plan" ? fcmg-local-plan-resident(res, sel, fc-strip-eol(fc-arg(line))) : (String) fc-verb(line) == "generate" ? fgc-run(res, sel, fc-strip-eol(fc-arg(line))) : (String) fc-verb(line) == "model-bandwidth" ? fc-said(fcmg-bandwidth(sel), res) : (String) fc-verb(line) == "form-layer" ? fc-said(ftl-cli(fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "choose" ? fc-said(fc-choose(sel, fc-strip-eol(fc-arg(line))), res) : (String) fc-verb(line) == "choose-observe" ? fc-said(fc-choose-observe(fc-arg(line)), res) : fc-said(fc-native(line), res);
    // Leaving is a release, and a release that does not account for every handle
    // says so rather than dying quietly with the process.
    def fc-farewell(res) = (Comparable) fcmr-release-ok?(res) == 1 ? "" : "the resident model did not release every handle";
    // one self-recursive loop: prompt (only on a real tty), read a line, and
    // either stop (EOF / quit / exit) or respond and loop. read_line is a stored
    // let (an effect op) so it fires exactly once per turn, not once per use.
    //
    // The loop now carries two strings, and they are the whole of the runtime switch: `root` is the
    // directory the person last asked the body to look at, `sel` the file they last picked out of what
    // it saw. Both start empty — a fresh binary knows no directory and no model — and both are set
    // only by something said in the session. That is what makes this a conversation rather than a
    // configuration: the state lives in the turn, not in the environment, and it dies with the session.
    def repl(root, sel, res) = repl-session(root, sel, res, nsm-id(), 0, host_monotonic_ms());
    def repl-session-close(res, id, turns, started, health) = {
        ohc-close(health);
        let released = fc-farewell(res);
        let learned = nsm-session-close(hearth-session-learning(), id, turns, started);
        let settled = turns > 0 ? nsm-session-settle(hearth-session-learning()) : 0;
        released;
    };
    def repl-session(root, sel, res, id, turns, started) = repl-session-health(root, sel, res, id, turns, started, ohc-open());
    def repl-session-health(root, sel, res, id, turns, started, health) =     // Prompt only on a real terminal. The same retained owner reads all
    // care and health commands during this session.
{
        (Comparable) isatty() == 1 ? print_str("form-cli> ") : 0;
        let line = read_line();
        // End of input is the typed value nothing. String encodings are
        // private to the runtime and do not determine control flow here.
        nothing?(line) ? repl-session-close(res, id, turns, started, health) : (String) fc-verb(line) == "quit" ? repl-session-close(res, id, turns, started, health) : (String) fc-verb(line) == "exit" ? repl-session-close(res, id, turns, started, health) : {
            let root2 = (String) fc-verb(line) == "models" ? fc-root-of(fc-strip-eol(fc-arg(line)), root) : root;
            let sel2 = (String) fc-verb(line) == "use" ? fc-pick(root2, fc-strip-eol(fc-arg(line))) : sel;
            let said = (String) fc-verb(line) == "care" || (String) fc-verb(line) == "health" ? fc-said((String) fc-verb(line) == "care" ? occ-command-at(health, fc-strip-eol(fc-arg(line))) : ohc-command-at(health, fc-strip-eol(fc-arg(line))), res) : fc-turn(line, root2, sel2, res);
            print_str(said[0]);
            repl-session-health(root2, sel2, said[1], id, (Number) turns + (Number) 1, started, health);
        };
    };
    // The greeting and session are one entry expression. Piped input receives
    // command responses without an interactive greeting or prompt.
    {
        (Comparable) isatty() == 1 ? print_str("Hello — I am Sema's body. My words for you: about, improve, learn, inquire, quit. Type one and press return.") : 0;
        repl("", "", fcmr-none());
    };
}
