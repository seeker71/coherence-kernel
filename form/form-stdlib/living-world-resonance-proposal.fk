; living-world-resonance-proposal.fk -- recurrence proposes a structural lens.
;
; A mapping needs at least the offered number of distinct supporting
; correspondences.  Support, counterexamples, uncertainty, and every active
; contributing attribution become the proposal's inspectable origin.  Every
; contributing source participates; readiness grants no authority.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk

(let LWR-ORIGIN (bp "LWR-ORIGIN"))

(defn lwr-origin (signature evidence-set witnesses)
    (intern_node LWR-ORIGIN
        (list signature (lwr-evidence-supports evidence-set)
              (lwr-evidence-counterexamples evidence-set) witnesses)))

(defn lwr-uncertainty-for (signature evidence-set)
    (do
        (let template (lwr-signature-template signature))
        (lwr-uncertainty
            (lwo-field-size (lwr-evidence-counterexamples evidence-set))
            (lwr-template-ambiguous-count template)
            (lwr-unused-source-count template
                (lwr-signature-source-arity signature)))))

(defn lwr-mapping-for (signature evidence-set)
    (lwr-mapping signature
        (lwr-evidence-supports evidence-set)
        (lwr-evidence-counterexamples evidence-set)
        (lwr-uncertainty-for signature evidence-set)))

(defn lwr-proposal-evidence-ready? (signature evidence-set threshold)
    (if (and (eq (lwr-signature-valid? signature) 1)
             (ge (lwo-field-size (lwr-evidence-supports evidence-set))
                 threshold)) 1 0))

(defn lwr-proposal-from-evidence (signature evidence-set threshold)
    (do
        (let witnesses (lwr-evidence-witnesses evidence-set))
        (let mapping (lwr-mapping-for signature evidence-set))
        (let origin (lwr-origin signature evidence-set witnesses))
        (let candidate
            (lwo-emergent mapping witnesses
                (intern_trivial_int
                    (lwo-field-size (lwr-evidence-supports evidence-set)))
                (intern_trivial_int
                    (lwr-template-slot-count
                        (lwr-signature-template signature)))
                (intern_trivial_int threshold) origin))
        (lwt-proposal candidate
            (lwt-sources-from-attributions
                (lwo-field-items witnesses) (lwo-empty-field))
            origin)))

(defn lwr-proposal-for (world correspondence threshold)
    (if (or (eq (lwr-correspondence? correspondence) 0)
            (eq (lwo-active? world correspondence) 0))
        (lwo-none)
        (do
            (let signature (lwr-signature-for correspondence))
            (let evidence-set (lwr-evidence-set-for world signature))
            (if (eq (lwr-proposal-evidence-ready?
                        signature evidence-set threshold) 0)
                (lwo-none)
                (lwr-proposal-from-evidence
                    signature evidence-set threshold)))))

(defn lwr-proposals-items (world items threshold acc)
    (if (eq (len items) 0) acc
        (do
            (let proposal (lwr-proposal-for world (head items) threshold))
            (lwr-proposals-items world (tail items) threshold
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwr-proposals (world threshold)
    (lwr-proposals-items world
        (lwo-field-items (lwo-world-cells world)) threshold
        (lwo-empty-field)))

(defn lwr-tend (world entries threshold prior)
    (do
        (let received (lwt-receive-stream world entries))
        (lwt-round received (lwr-proposals received threshold)
                   (lwo-empty-field) prior)))
