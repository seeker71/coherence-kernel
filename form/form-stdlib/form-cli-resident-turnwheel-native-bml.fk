// form-cli-resident-turnwheel-native-bml.fk -- high-grammar BML into one
// retained Form-native decision image per resident meaning.
//
// The source of truth is the high-grammar BML declaration.  At resident birth
// this cell reads that declaration through a scannerless byte cursor, derives
// its signal and phase alphabets,
// and constructs only native-lowerable Form decision programs.  `jonb-request`
// gives each program a structural NodeID and retains the in-RAM JIT page in the
// existing resident registry.  A missing parser, malformed declaration, or
// unavailable native page returns a typed refusal; it never falls back to an
// emitted source mirror or an interpreted compatibility path.
//
// preludes: form-stdlib/core.fk
// preludes: form-stdlib/form-asm.fk
// preludes: form-stdlib/form-lower.fk
// preludes: form-stdlib/jit-once-born.fk
//
section [form.bml] {
    def fcrtn-version() = "form-cli-resident-turnwheel-native-bml-v1";
    def fcrtn-source-path() = file_size("form/form-stdlib/bml/form-cli-resident-turnwheel.bml") >= 0 ? "form/form-stdlib/bml/form-cli-resident-turnwheel.bml" : "form-stdlib/bml/form-cli-resident-turnwheel.bml";
    def fcrtn-ready-tag() = "form-cli-resident-turnwheel-native-cache-v1";
    def fcrtn-refused-tag() = "form-cli-resident-turnwheel-native-cache-refused-v1";
    def fcrtn-terminal-selector() = "terminal-code";
    def fcrtn-phase-selector() = "phase-runnable-code";
    def fcrtn-stop-selector() = "stop-carries-code";
    // These are BML grammar terminals, not a second policy table.  `build`
    // verifies that the current high-BML declaration carries each exact surface
    // before a resident can retain its native pages.
    def fcrtn-phase-program() = "program";
    def fcrtn-phase-prefill() = "prefill";
    def fcrtn-phase-model() = "model";
    def fcrtn-phase-returned() = "returned";
    def fcrtn-phase-prefill-error() = "prefill-error";
    // cache = tag, source-node, signal-map, phase-map, terminal-program,
    // terminal-root, phase-program, phase-root, stop-program, stop-root.
    // A cache grows structurally.  It is deliberately one program row rather
    // than a nine-seat compiler ABI: adding a native decision never changes a
    // function ceiling or recompiles callers that only carry the row.
    def fcrtn-cache(parts) = cons(fcrtn-ready-tag(), parts);
    def fcrtn-refused(reason) = [fcrtn-refused-tag(), reason];
    def fcrtn-cache-ready?(cache) = (Comparable) len(cache) == 10 ? (String) head(cache) == fcrtn-ready-tag() : 0;
    def fcrtn-cache-refused?(cache) = (Comparable) len(cache) == 2 ? (String) head(cache) == fcrtn-refused-tag() : 0;
    def fcrtn-cache-reason(cache) = fcrtn-cache-refused?(cache) ? cache[1] : "native-bml-cache-malformed";
    def fcrtn-cache-source(cache) = cache[1];
    def fcrtn-cache-signals(cache) = cache[2];
    def fcrtn-cache-phases(cache) = cache[3];
    def fcrtn-cache-terminal-program(cache) = cache[4];
    def fcrtn-cache-terminal-root(cache) = cache[5];
    def fcrtn-cache-phase-program(cache) = cache[6];
    def fcrtn-cache-phase-root(cache) = cache[7];
    def fcrtn-cache-stop-program(cache) = cache[8];
    def fcrtn-cache-stop-root(cache) = cache[9];
    // This is deliberately a cursor, not a tokenizing compatibility layer.
    // `str_find` is a kernel-native byte search; every declaration has one
    // exact high-BML surface and a changed surface refuses before a native page
    // can be born.  The full declaration grammar remains a compiler-stage
    // organ; this fresh-kernel floor cannot borrow its compiled cache.
    def fcrtn-field-after(source, prefix) = {
        let at = str_find(source, prefix, 0);
        at < 0 ? nothing() : {
            let start = at + str_len(prefix);
            let end = str_find(source, ";", start);
            end < 0 ? nothing() : substring(source, start, end);
        };
    };
    def fcrtn-string(source, name) = {
        let raw = fcrtn-field-after(source, str_concat("const String ", str_concat(name, " = \"")));
        nothing?(raw) ? nothing() : str_len(raw) < 1 ? nothing() : substring(raw, 0, str_len(raw) - 1);
    };
    def fcrtn-code(source, name) = {
        let raw = fcrtn-field-after(source, str_concat("const int ", str_concat(name, " = ")));
        nothing?(raw) ? nothing() : str_to_int(raw);
    };
    def fcrtn-pair(source, surface, code-name) = {
        let signal = fcrtn-string(source, surface);
        let code = fcrtn-code(source, code-name);
        nothing?(signal) || nothing?(code) ? nothing() : [signal, code];
    };
    def fcrtn-pairs-ready?(pairs) = nil?(pairs) ? 1 : nothing?(head(pairs)) ? 0 : fcrtn-pairs-ready?(tail(pairs));
    def fcrtn-map-code(pairs, surface) = nil?(pairs) ? 0 : (String) head(pairs)[0] == surface ? head(pairs)[1] : fcrtn-map-code(tail(pairs), surface);
    def fcrtn-map-has-surface?(pairs, surface) = nil?(pairs) ? 0 : (String) head(pairs)[0] == surface ? 1 : fcrtn-map-has-surface?(tail(pairs), surface);
    // The native program alphabet is already understood by form-lower:
    // ARG=2, LIT=1, EQ=14, COND=6.  A decision is data, not a generated
    // function seat.  The cached NodeID route is therefore unconstrained by a
    // function table and the hot call reaches native bytes.
    def fcrtn-eq-program(match, yes, no) = [[2], [1, match], [14, 0, 1], [1, yes], [1, no], [6, 2, 3, 4]];
    def fcrtn-eq-root() = 5;
    def fcrtn-exclude-two-program(first, second, no, yes) = [[2], [1, first], [14, 0, 1], [1, no], [1, second], [14, 0, 4], [6, 5, 3, 7], [1, yes], [6, 2, 3, 6]];
    def fcrtn-exclude-two-root() = 8;
    def fcrtn-signal-map(source) = [fcrtn-pair(source, "SignalLive", "SignalLiveCode"), fcrtn-pair(source, "SignalUndo", "SignalUndoCode"), fcrtn-pair(source, "SignalReturned", "SignalReturnedCode"), fcrtn-pair(source, "SignalDone", "SignalDoneCode"), fcrtn-pair(source, "SignalNothing", "SignalNothingCode"), fcrtn-pair(source, "SignalChoice", "SignalChoiceCode"), fcrtn-pair(source, "SignalCut", "SignalCutCode"), fcrtn-pair(source, "SignalTimeout", "SignalTimeoutCode"), fcrtn-pair(source, "SignalFailure", "SignalFailureCode"), fcrtn-pair(source, "SignalRefused", "SignalRefusedCode"), fcrtn-pair(source, "SignalRelease", "SignalReleaseCode")];
    def fcrtn-phase-map(source) = [fcrtn-pair(source, "PhaseProgram", "PhaseProgramCode"), fcrtn-pair(source, "PhasePrefill", "PhasePrefillCode"), fcrtn-pair(source, "PhaseModel", "PhaseModelCode"), fcrtn-pair(source, "PhaseReturned", "PhaseReturnedCode"), fcrtn-pair(source, "PhasePrefillError", "PhasePrefillErrorCode")];
    def fcrtn-source-node(source) = intern_node(make_nodeid(31, 2, 0, 182), [intern_trivial_string(fcrtn-version()), intern_trivial_string(source)]);
    def fcrtn-program-literal(program, row) = program[row][1];
    def fcrtn-values-present?(values) = nil?(values) ? 1 : nothing?(head(values)) ? 0 : fcrtn-values-present?(tail(values));
    def fcrtn-all-true?(bits) = nil?(bits) ? 1 : (Comparable) head(bits) == 0 ? 0 : fcrtn-all-true?(tail(bits));
    def fcrtn-cache-codes-present?(cache) = {
        let terminal = fcrtn-cache-terminal-program(cache);
        let phase = fcrtn-cache-phase-program(cache);
        let stop = fcrtn-cache-stop-program(cache);
        fcrtn-values-present?([fcrtn-program-literal(terminal, 1), fcrtn-program-literal(terminal, 3), fcrtn-program-literal(terminal, 4), fcrtn-program-literal(terminal, 7), fcrtn-program-literal(phase, 1), fcrtn-program-literal(phase, 3), fcrtn-program-literal(phase, 4), fcrtn-program-literal(stop, 1), fcrtn-program-literal(stop, 3), fcrtn-program-literal(stop, 4)]);
    };
    def fcrtn-cache-declaration-valid?(source, cache) = fcrtn-all-true?([str_find(source, "class FormCliResidentTurnwheel", 0) >= 0, fcrtn-pairs-ready?(fcrtn-cache-signals(cache)), fcrtn-pairs-ready?(fcrtn-cache-phases(cache)), fcrtn-map-has-surface?(fcrtn-cache-phases(cache), fcrtn-phase-program()), fcrtn-map-has-surface?(fcrtn-cache-phases(cache), fcrtn-phase-prefill()), fcrtn-map-has-surface?(fcrtn-cache-phases(cache), fcrtn-phase-model()), fcrtn-map-has-surface?(fcrtn-cache-phases(cache), fcrtn-phase-returned()), fcrtn-map-has-surface?(fcrtn-cache-phases(cache), fcrtn-phase-prefill-error()), fcrtn-cache-codes-present?(cache)]);
    def fcrtn-finish-cache(source, cache) = fcrtn-cache-declaration-valid?(source, cache) ? cache : fcrtn-refused("high-bml-native-declaration-incomplete");
    // The compiler carries the declaration as one source value, never through a
    // fixed function-seat table.  Each binding is a source coordinate or a
    // scalar declared by the high grammar; the resulting program is structural
    // data handed straight to the resident native registry.
    def fcrtn-build-source(source) = {
        let source-node = fcrtn-source-node(source);
        let signals = fcrtn-signal-map(source);
        let phases = fcrtn-phase-map(source);
        let live = fcrtn-code(source, "SignalLiveCode");
        let undo = fcrtn-code(source, "SignalUndoCode");
        let inactive = fcrtn-code(source, "PhaseInactiveCode");
        let false-value = fcrtn-code(source, "TerminalFalseCode");
        let true-value = fcrtn-code(source, "TerminalTrueCode");
        let not-carried = fcrtn-code(source, "StopNotCarriedCode");
        let carried = fcrtn-code(source, "StopCarriedCode");
        fcrtn-finish-cache(source, fcrtn-cache([source-node, signals, phases, fcrtn-exclude-two-program(live, undo, false-value, true-value), fcrtn-exclude-two-root(), fcrtn-eq-program(inactive, false-value, true-value), fcrtn-eq-root(), fcrtn-eq-program(carried, carried, not-carried), fcrtn-eq-root()]));
    };
    def fcrtn-build() = fcrtn-build-source(read_file(fcrtn-source-path()));
    def fcrtn-selector-program(cache, selector) = (String) selector == fcrtn-terminal-selector() ? [fcrtn-cache-terminal-program(cache), fcrtn-cache-terminal-root(cache)] : (String) selector == fcrtn-phase-selector() ? [fcrtn-cache-phase-program(cache), fcrtn-cache-phase-root(cache)] : (String) selector == fcrtn-stop-selector() ? [fcrtn-cache-stop-program(cache), fcrtn-cache-stop-root(cache)] : nothing();
    // call = tag, status, value, registry', route, born, reason.  The cache
    // itself remains resident-owned separately, and unknown surface vocabulary
    // maps to its declared nonterminal/inactive zero code.
    def fcrtn-call(status, value, registry, route, born, reason) = ["form-cli-resident-bml-native-call-v1", status, value, registry, route, born, reason];
    def fcrtn-call-status(call) = call[1];
    def fcrtn-call-value(call) = call[2];
    def fcrtn-call-registry(call) = call[3];
    def fcrtn-call-route(call) = call[4];
    def fcrtn-call-born(call) = call[5];
    def fcrtn-call-reason(call) = call[6];
    def fcrtn-invoke(cache, registry, selector, code) = !fcrtn-cache-ready?(cache) ? fcrtn-call("refused", nothing(), registry, "none", 0, fcrtn-cache-reason(cache)) : {
        let selected = fcrtn-selector-program(cache, selector);
        nothing?(selected) ? fcrtn-call("refused", nothing(), registry, "none", 0, "high-bml-native-selector-absent") : {
            let moved = jonb-request(registry, selected[0], selected[1], code);
            (String) moved[1] == "native" ? fcrtn-call("returned", moved[0], moved[2], moved[1], moved[3], "high-bml-native-nodeid-invoked") : fcrtn-call("refused", nothing(), moved[2], moved[1], moved[3], "high-bml-native-page-unavailable");
        };
    };
    def fcrtn-terminal-code(cache, signal) = fcrtn-map-code(fcrtn-cache-signals(cache), signal);
    def fcrtn-phase-code(cache, phase) = fcrtn-map-code(fcrtn-cache-phases(cache), phase);
    0;
}
