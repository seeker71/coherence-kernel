; form-program-image-call-protocol.fk -- generic content-addressed calls from
; a bound requester identity to admitted resident program images.
;
; CALL_BINDING is a relation, not a function or operations table.  It retains
; the actual caller binding, a call name, the actual callee binding, and an
; explicit capability node.  A protocol registry retains the admitted image
; registry plus the exact call relations it accepts.  OFFER carries that exact
; relation, a correlation node, typed values, and evaluator fuel.  ACK returns
; the same offer with a typed value and distinct returned, refused, nothing,
; choice, failure, or timeout status.  New requesters, callees, values, and
; relations arrive as interned data; no query-stage or application symbol
; becomes an evaluator branch.  The requester image is retained as the
; initiating identity; this cell does not claim to execute that image yet.
;
; This is the program-image observation envelope around the existing Form
; offer/ack practice, not a second invocation mechanism.  The inner returned
; value still preserves exact nothing/0/1/node meaning.  The outer ACK also
; retains `timeout` as lifecycle evidence with output-count 0, so a timed walk
; is not mistaken for refusal or nothing.  Fuel bounds the callee reducer; the
; pure validation and content-registry traversal around it are not claimed as
; fuel-metered work.
;
; The protocol is pure Form.  It performs no host-exec, HTTP, model, Metal,
; filesystem, or persistence effect.  Choice is surfaced without dispatch;
; the existing explicit fcatw-cut/fcatw-undo movement can select and restore an
; image registry, after which the same immutable offer can be re-observed.
;
; Categories 31.2.0.131..136 are typed value, call binding, protocol registry,
; offer, acknowledgement, and exact absence.  They were unoccupied in the
; repository-wide source census on 2026-08-26.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk
; Proven by: form-stdlib/tests/form-program-image-call-protocol-band.fk

(do
    ; One generic category and child constructor keep the protocol expressed
    ; as data without six category seats or three envelope-specific accessors.
    (defn fpcp-category (instance) (make_nodeid 31 2 0 instance))
    (defn fpcp-child (node at) (nth (node_children node) at))
    (defn fpcp-absent ()
        (intern_node (fpcp-category 136)
            (list (intern_trivial_string "nothing"))))

    ; A typed value is [kind, payload].  Lists recursively retain typed value
    ; nodes so a present empty list never collapses into exact absence.
    (defn fpcp-value (kind value)
        (do
            (let payload
                (if (eq kind (fcatw-kind-nothing)) (fpcp-absent)
                (if (eq kind (fcatw-kind-int)) (intern_trivial_int value)
                (if (eq kind (fcatw-kind-string)) (intern_trivial_string value)
                (if (eq kind (fcatw-kind-node)) value
                (if (eq kind (fcatw-kind-list))
                    (fcatw-sequence "call-list-values-v1" value)
                    (nothing)))))))
            (if (nothing? payload) (nothing)
                (intern_node (fpcp-category 131)
                    (list (intern_trivial_int kind) payload)))))
    (defn fpcp-value-kind (value)
        (node_value (head (node_children value))))
    (defn fpcp-values-valid? (values)
        (if (nil? values) 1
            (if (eq (fpcp-value-valid? (head values)) 1)
                (fpcp-values-valid? (tail values)) 0)))
    (defn fpcp-value-valid? (value)
        (if (nothing? value) 0
        (if (not (node_eq (node_category value) (fpcp-category 131))) 0
        (if (not (eq (len (node_children value)) 2)) 0
        (if (not (eq (node_type (head (node_children value))) 1)) 0
            (do
                (let kind (fpcp-value-kind value))
                (let payload (fpcp-child value 1))
                (if (eq (fcatw-kind-value-valid? kind) 0) 0
                (if (eq kind (fcatw-kind-nothing))
                    (if (node_eq payload (fpcp-absent)) 1 0)
                (if (eq kind (fcatw-kind-int))
                    (if (eq (node_type payload) 1) 1 0)
                (if (eq kind (fcatw-kind-string))
                    (if (eq (node_type payload) 2) 1 0)
                (if (eq kind (fcatw-kind-node)) 1
                (if (eq (fcatw-sequence-is? payload
                            "call-list-values-v1") 0) 0
                    (fpcp-values-valid?
                        (fcatw-sequence-values payload))))))))))))))
    (defn fpcp-value-raw (value)
        (do
            (let kind (fpcp-value-kind value))
            (let payload (fpcp-child value 1))
            (if (eq kind (fcatw-kind-nothing)) (nothing)
            (if (eq kind (fcatw-kind-int)) (node_value payload)
            (if (eq kind (fcatw-kind-string)) (node_value payload)
            (if (eq kind (fcatw-kind-node)) payload
                (fpcp-values-raw (fcatw-sequence-values payload))))))))
    (defn fpcp-values-raw (values)
        (if (nil? values) (empty)
            (cons (fpcp-value-raw (head values))
                (fpcp-values-raw (tail values)))))
    (defn fpcp-values-kinds (values)
        (if (nil? values) (empty)
            (cons (fpcp-value-kind (head values))
                (fpcp-values-kinds (tail values)))))

    ; CALL_BINDING retains actual image bindings at both ends.  Capability is
    ; explicit content, then the whole relation itself must be admitted.
    (defn fpcp-call-binding (caller call-name callee capability)
        (intern_node (fpcp-category 132)
            (list caller (intern_trivial_string call-name) callee capability)))
    (defn fpcp-call-valid? (call)
        (if (nothing? call) 0
        (if (not (node_eq (node_category call) (fpcp-category 132))) 0
        (if (not (eq (len (node_children call)) 4)) 0
        (if (eq (fcatw-binding-valid? (fpcp-child call 0)) 0) 0
        (if (not (eq (node_type (fpcp-child call 1)) 2)) 0
        (if (not (gt (str_len (node_value (fpcp-child call 1))) 0)) 0
        (if (eq (fcatw-binding-valid? (fpcp-child call 2)) 0) 0
            (if (nothing? (fpcp-child call 3)) 0 1)))))))))

    ; The registry is immutable content:
    ; [image-registry, granted-capability-sequence, admitted-call...].  Exact
    ; call admission and capability grant are deliberately separate: an
    ; unknown relation is nothing, while a known relation without its grant is
    ; an explicit refusal.
    (defn fpcp-image-bindings-valid? (bindings)
        (if (nil? bindings) 1
            (if (eq (fcatw-binding-valid? (head bindings)) 1)
                (fpcp-image-bindings-valid? (tail bindings)) 0)))
    (defn fpcp-calls-valid? (calls image-registry)
        (if (nil? calls) 1
            (if (and (eq (fpcp-call-valid? (head calls)) 1)
                (and (eq (fcatw-binding-present?
                    (fcatw-registry-bindings image-registry)
                    (fpcp-child (head calls) 0)) 1)
                     (eq (fcatw-binding-present?
                    (fcatw-registry-bindings image-registry)
                    (fpcp-child (head calls) 2)) 1)))
                (fpcp-calls-valid? (tail calls) image-registry) 0)))
    (defn fpcp-registry (image-registry grants calls)
        (intern_node (fpcp-category 133)
            (cons image-registry
                (cons (fcatw-sequence "call-capability-grants-v1" grants)
                      calls))))
    (defn fpcp-registry-valid? (registry)
        (if (nothing? registry) 0
        (if (not (node_eq (node_category registry) (fpcp-category 133))) 0
        (if (lt (len (node_children registry)) 2) 0
            (do
                (let images (head (node_children registry)))
                (if (not (node_eq (node_category images)
                                  (fcatw-registry-category))) 0
                (if (eq (fcatw-sequence-is?
                        (nth (node_children registry) 1)
                        "call-capability-grants-v1") 0) 0
                (if (eq (fpcp-image-bindings-valid?
                        (fcatw-registry-bindings images)) 0) 0
                    (fpcp-calls-valid?
                        (tail (tail (node_children registry)))
                        images)))))))))
    (defn fpcp-registry-images (registry) (head (node_children registry)))
    (defn fpcp-registry-calls (registry)
        (tail (tail (node_children registry))))
    (defn fpcp-call-present? (calls call)
        (if (nil? calls) 0
            (if (node_eq (head calls) call) 1
                (fpcp-call-present? (tail calls) call))))
    (defn fpcp-registry-with-images (registry images)
        (fpcp-registry images
            (fcatw-sequence-values (nth (node_children registry) 1))
            (fpcp-registry-calls registry)))

    ; OFFER carries no ambient root, path, or authority.  Everything needed to
    ; resolve and call is content beneath the offer and protocol registry.
    (defn fpcp-offer (call correlation values fuel)
        (intern_node (fpcp-category 134)
            (list call correlation
                (fcatw-sequence "call-offer-values-v1" values)
                (intern_trivial_int fuel))))
    (defn fpcp-offer-valid? (offer)
        (if (nothing? offer) 0
        (if (not (node_eq (node_category offer) (fpcp-category 134))) 0
        (if (not (eq (len (node_children offer)) 4)) 0
        (if (eq (fpcp-call-valid? (fpcp-child offer 0)) 0) 0
        (if (nothing? (fpcp-child offer 1)) 0
        (if (eq (fcatw-sequence-is? (fpcp-child offer 2)
                                    "call-offer-values-v1") 0) 0
        (if (not (eq (node_type (fpcp-child offer 3)) 1)) 0
        (if (lt (node_value (fpcp-child offer 3)) 0) 0
            (fpcp-values-valid?
                (fcatw-sequence-values (fpcp-child offer 2))))))))))))
    (defn fpcp-offer-values (offer)
        (fcatw-sequence-values (fpcp-child offer 2)))

    ; ACK retains the exact offer, so correlation and call identity cannot be
    ; replaced between request and observation.
    (defn fpcp-ack (offer status reason value steps output trace)
        (intern_node (fpcp-category 135)
            (list offer (intern_trivial_string status)
                (intern_trivial_string reason) value
                (intern_trivial_int steps) (intern_trivial_int output)
                (intern_trivial_string trace))))
    (defn fpcp-ack-status (ack) (node_value (fpcp-child ack 1)))
    (defn fpcp-ack-reason (ack) (node_value (fpcp-child ack 2)))
    (defn fpcp-ack-value (ack) (fpcp-child ack 3))
    (defn fpcp-ack-steps (ack) (node_value (fpcp-child ack 4)))
    (defn fpcp-ack-output (ack) (node_value (fpcp-child ack 5)))
    (defn fpcp-ack-trace (ack) (node_value (fpcp-child ack 6)))
    (defn fpcp-ack-correlation (ack)
        (fpcp-child (fpcp-child ack 0) 1))
    ; ack-valid? closes the structural status/value/output/fuel contract.
    ; ack-observed? below additionally recomputes the exact deterministic ACK
    ; for the registry and OFFER a receiver actually holds; that is the guard
    ; against a structurally plausible forged, swapped, or stale ACK.
    (defn fpcp-ack-valid? (ack)
        (if (nothing? ack) 0
        (if (not (node_eq (node_category ack) (fpcp-category 135))) 0
        (if (not (eq (len (node_children ack)) 7)) 0
        (if (not (eq (node_type (fpcp-child ack 1)) 2)) 0
        (if (not (eq (node_type (fpcp-child ack 2)) 2)) 0
        (if (eq (fpcp-value-valid? (fpcp-child ack 3)) 0) 0
        (if (not (eq (node_type (fpcp-child ack 4)) 1)) 0
        (if (not (eq (node_type (fpcp-child ack 5)) 1)) 0
        (if (not (eq (node_type (fpcp-child ack 6)) 2)) 0
            (do
                (let offer (fpcp-child ack 0))
                (let status (fpcp-ack-status ack))
                (let reason (fpcp-ack-reason ack))
                (let value (fpcp-ack-value ack))
                (let steps (fpcp-ack-steps ack))
                (let output (fpcp-ack-output ack))
                (let trace (fpcp-ack-trace ack))
                (let malformed-offer-refusal (and
                    (str_eq status "refused")
                    (str_eq reason "offer-malformed")))
                (let offer-ok (or malformed-offer-refusal
                    (eq (fpcp-offer-valid? offer) 1)))
                (let fuel-ok (if malformed-offer-refusal
                    (eq steps 0)
                    (and (ge steps 0)
                         (le steps (node_value (fpcp-child offer 3))))))
                (let value-is-nothing
                    (eq (fpcp-value-kind value) (fcatw-kind-nothing)))
                (let status-ok
                    (if (str_eq status "returned")
                        (and (str_eq reason "resident-thought-returned")
                        (and (eq output 1)
                        (and (not value-is-nothing)
                             (str_eq trace
                                "offer,resolve,call,return,ack,release"))))
                    (if (str_eq status "refused")
                        (and (or (str_eq reason "offer-malformed")
                             (or (str_eq reason "protocol-registry-malformed")
                             (or (str_eq reason "capability-refused")
                             (or (str_eq reason "offer-abi-refused")
                                 (str_eq reason
                                    "return-list-kind-unavailable")))))
                        (and (eq output 0)
                        (and value-is-nothing
                        (if (str_eq reason "return-list-kind-unavailable")
                            (and (gt steps 0)
                                 (str_eq trace
                                    "offer,resolve,call,refused,ack,release"))
                            (and (eq steps 0)
                                 (str_eq trace
                                    "offer,refused,ack,release"))))))
                    (if (str_eq status "nothing")
                        (and (or (str_eq reason "call-binding-not-admitted")
                                 (str_eq reason "symbol-not-found"))
                        (and (eq output 0)
                        (and value-is-nothing
                             (str_eq trace
                                "offer,nothing,ack,release"))))
                    (if (str_eq status "choice")
                        (and (str_eq reason "ambiguous-symbol")
                        (and (eq output 0)
                        (and value-is-nothing
                             (str_eq trace
                                "offer,choice,ack,release"))))
                    (if (str_eq status "timeout")
                        (and (str_eq reason "walker-fuel-exhausted")
                        (and (eq output 0)
                        (and value-is-nothing
                             (str_eq trace
                                "offer,resolve,call,timeout,ack,release"))))
                    (if (str_eq status "failure")
                        (and (gt (str_len reason) 0)
                        (and (eq output 0)
                        (and value-is-nothing
                             (str_eq trace
                                "offer,resolve,call,failure,ack,release"))))
                        0)))))))
                (if (and offer-ok (and fuel-ok status-ok)) 1 0))))))))))))
    (defn fpcp-empty-ack (offer status reason trace)
        (fpcp-ack offer status reason
            (fpcp-value (fcatw-kind-nothing) (nothing)) 0 0 trace))
    (defn fpcp-result-ack (offer result image)
        (if (nothing? result)
            (fpcp-empty-ack offer "refused" "offer-abi-refused"
                "offer,refused,ack,release")
        (if (and (eq (fcatw-kind result) (fcatw-kind-list))
                 (not (eq (fcatw-tag (fcatw-node-at image
                        (fcatw-image-root image))) 2)))
            (fpcp-ack offer "refused" "return-list-kind-unavailable"
                (fpcp-value (fcatw-kind-nothing) (nothing))
                (fcatw-steps result) 0
                "offer,resolve,call,refused,ack,release")
            (fpcp-ack offer (fcatw-status result) (fcatw-reason result)
                (if (eq (fcatw-kind result) (fcatw-kind-list))
                    (fpcp-value (fcatw-kind-list)
                        (fpcp-offer-values offer))
                    (fpcp-value (fcatw-kind result) (fcatw-value result)))
                (fcatw-steps result) (fcatw-output-count result)
                (if (str_eq (fcatw-status result) "returned")
                    "offer,resolve,call,return,ack,release"
                (if (str_eq (fcatw-status result) "timeout")
                    "offer,resolve,call,timeout,ack,release"
                    "offer,resolve,call,failure,ack,release"))))))

    (defn fpcp-execute (registry offer)
        (if (nothing? offer) (nothing)
        (if (eq (fpcp-offer-valid? offer) 0)
            (fpcp-empty-ack offer "refused" "offer-malformed"
                "offer,refused,ack,release")
        (if (eq (fpcp-registry-valid? registry) 0)
            (fpcp-empty-ack offer "refused" "protocol-registry-malformed"
                "offer,refused,ack,release")
            (do
                (let call (fpcp-child offer 0))
                (if (eq (fpcp-call-present?
                        (fpcp-registry-calls registry) call) 0)
                    (fpcp-empty-ack offer "nothing"
                        "call-binding-not-admitted"
                        "offer,nothing,ack,release")
                (if (eq (fcatw-binding-present?
                        (fcatw-sequence-values
                            (nth (node_children registry) 1))
                        (fpcp-child call 3)) 0)
                    (fpcp-empty-ack offer "refused"
                        "capability-refused"
                        "offer,refused,ack,release")
                    (do
                        (let images (fpcp-registry-images registry))
                        (let callee (fpcp-child call 2))
                        (let resolution (fcatw-resolve images
                            (fcatw-binding-symbol callee)))
                        (if (str_eq (fcatw-resolution-status resolution)
                                    "choice")
                            (fpcp-empty-ack offer "choice"
                                (fcatw-resolution-reason resolution)
                                "offer,choice,ack,release")
                        (if (not (str_eq
                                (fcatw-resolution-status resolution) "ready"))
                            (fpcp-empty-ack offer
                                (fcatw-resolution-status resolution)
                                (fcatw-resolution-reason resolution)
                                (if (str_eq
                                    (fcatw-resolution-status resolution)
                                    "nothing")
                                    "offer,nothing,ack,release"
                                    "offer,resolve,call,failure,ack,release"))
                        (if (not (node_eq
                                (fcatw-resolution-image resolution)
                                (fcatw-binding-image callee)))
                            (fpcp-empty-ack offer "failure"
                                "resolved-image-mismatch"
                                "offer,resolve,call,failure,ack,release")
                            (do
                                (let values (fpcp-offer-values offer))
                                (fpcp-result-ack offer
                                    (fcatw-run-image
                                        (fcatw-resolution-image resolution)
                                        (fpcp-values-raw values)
                                        (fpcp-values-kinds values)
                                        (node_value
                                            (fpcp-child offer 3)))
                                    (fcatw-resolution-image
                                        resolution))))))))))))))

    (defn fpcp-ack-observed? (registry offer ack)
        (if (eq (fpcp-ack-valid? ack) 0) 0
            (if (node_eq ack (fpcp-execute registry offer)) 1 0)))

    0)
