// form-program-image-call-protocol.fk -- generic content-addressed calls from
// a bound requester identity to admitted resident program images.
//
// CALL_BINDING is a relation, not a function or operations table.  It retains
// the actual caller binding, a call name, the actual callee binding, and an
// explicit capability node.  A protocol registry retains the admitted image
// registry plus the exact call relations it accepts.  OFFER carries that exact
// relation, a correlation node, typed values, and evaluator fuel.  ACK returns
// the same offer with a typed value and distinct returned, refused, nothing,
// choice, failure, or timeout status.  New requesters, callees, values, and
// relations arrive as interned data; no query-stage or application symbol
// becomes an evaluator branch.  The requester image is retained as the
// initiating identity; this cell does not claim to execute that image yet.
//
// This is the program-image observation envelope around the existing Form
// offer/ack practice, not a second invocation mechanism.  The inner returned
// value still preserves exact nothing/0/1/node meaning.  The outer ACK also
// retains `timeout` as lifecycle evidence with output-count 0, so a timed walk
// is not mistaken for refusal or nothing.  Fuel bounds the callee reducer; the
// pure validation and content-registry traversal around it are not claimed as
// fuel-metered work.
//
// The protocol is pure Form.  It performs no host-exec, HTTP, model, Metal,
// filesystem, or persistence effect.  Choice is surfaced without dispatch;
// the existing explicit fcatw-cut/fcatw-undo movement can select and restore an
// image registry, after which the same immutable offer can be re-observed.
//
// Categories 31.2.0.131..136 are typed value, call binding, protocol registry,
// offer, acknowledgement, and exact absence.  They were unoccupied in the
// repository-wide source census on 2026-08-26.
//
// preludes: form-stdlib/core.fk
// preludes: form-stdlib/form-cli-current-answer-thought-walk.fk
section [form.bml] {
    // One generic category and child constructor keep the protocol expressed
    // as data without six category seats or three envelope-specific accessors.
    def fpcp-category(instance) = make_nodeid(31, 2, 0, instance);
    def fpcp-child(node, at) = node_children(node)[at];
    def fpcp-absent() = intern_node(fpcp-category(136), [intern_trivial_string("nothing")]);
    // A typed value is [kind, payload].  Lists recursively retain typed value
    // nodes so a present empty list never collapses into exact absence.
    def fpcp-value(kind, value) = {
        let payload = (Comparable) kind == fcatw-kind-nothing() ? fpcp-absent() : (Comparable) kind == fcatw-kind-int() ? intern_trivial_int(value) : (Comparable) kind == fcatw-kind-string() ? intern_trivial_string(value) : (Comparable) kind == fcatw-kind-node() ? value : (Comparable) kind == fcatw-kind-list() ? fcatw-sequence("call-list-values-v1", value) : nothing();
        nothing?(payload) ? nothing() : intern_node(fpcp-category(131), [intern_trivial_int(kind), payload]);
    };
    def fpcp-value-kind(value) = node_value(head(node_children(value)));
    def fpcp-values-valid?(values) = nil?(values) ? 1 : (Comparable) fpcp-value-valid?(head(values)) == 1 ? fpcp-values-valid?(tail(values)) : 0;
    def fpcp-value-valid?(value) = nothing?(value) ? 0 : !node_eq(node_category(value), fpcp-category(131)) ? 0 : !((Comparable) len(node_children(value)) == 2) ? 0 : !((Comparable) node_type(head(node_children(value))) == 1) ? 0 : {
        let kind = fpcp-value-kind(value);
        let payload = fpcp-child(value, 1);
        (Comparable) fcatw-kind-value-valid?(kind) == 0 ? 0 : (Comparable) kind == fcatw-kind-nothing() ? node_eq(payload, fpcp-absent()) ? 1 : 0 : (Comparable) kind == fcatw-kind-int() ? (Comparable) node_type(payload) == 1 ? 1 : 0 : (Comparable) kind == fcatw-kind-string() ? (Comparable) node_type(payload) == 2 ? 1 : 0 : (Comparable) kind == fcatw-kind-node() ? 1 : (Comparable) fcatw-sequence-is?(payload, "call-list-values-v1") == 0 ? 0 : fpcp-values-valid?(fcatw-sequence-values(payload));
    };
    def fpcp-value-raw(value) = {
        let kind = fpcp-value-kind(value);
        let payload = fpcp-child(value, 1);
        (Comparable) kind == fcatw-kind-nothing() ? nothing() : (Comparable) kind == fcatw-kind-int() ? node_value(payload) : (Comparable) kind == fcatw-kind-string() ? node_value(payload) : (Comparable) kind == fcatw-kind-node() ? payload : fpcp-values-raw(fcatw-sequence-values(payload));
    };
    def fpcp-values-raw(values) = nil?(values) ? empty() : cons(fpcp-value-raw(head(values)), fpcp-values-raw(tail(values)));
    def fpcp-values-kinds(values) = nil?(values) ? empty() : cons(fpcp-value-kind(head(values)), fpcp-values-kinds(tail(values)));
    // CALL_BINDING retains actual image bindings at both ends.  Capability is
    // explicit content, then the whole relation itself must be admitted.
    def fpcp-call-binding(caller, call-name, callee, capability) = intern_node(fpcp-category(132), [caller, intern_trivial_string(call-name), callee, capability]);
    def fpcp-call-valid?(call) = nothing?(call) ? 0 : !node_eq(node_category(call), fpcp-category(132)) ? 0 : !((Comparable) len(node_children(call)) == 4) ? 0 : (Comparable) fcatw-binding-valid?(fpcp-child(call, 0)) == 0 ? 0 : !((Comparable) node_type(fpcp-child(call, 1)) == 2) ? 0 : !(str_len(node_value(fpcp-child(call, 1))) > 0) ? 0 : (Comparable) fcatw-binding-valid?(fpcp-child(call, 2)) == 0 ? 0 : nothing?(fpcp-child(call, 3)) ? 0 : 1;
    // The registry is immutable content:
    // [image-registry, granted-capability-sequence, admitted-call...].  Exact
    // call admission and capability grant are deliberately separate: an
    // unknown relation is nothing, while a known relation without its grant is
    // an explicit refusal.
    def fpcp-image-bindings-valid?(bindings) = nil?(bindings) ? 1 : (Comparable) fcatw-binding-valid?(head(bindings)) == 1 ? fpcp-image-bindings-valid?(tail(bindings)) : 0;
    def fpcp-calls-valid?(calls, image-registry) = nil?(calls) ? 1 : (Comparable) fpcp-call-valid?(head(calls)) == 1 && ((Comparable) fcatw-binding-present?(fcatw-registry-bindings(image-registry), fpcp-child(head(calls), 0)) == 1 && (Comparable) fcatw-binding-present?(fcatw-registry-bindings(image-registry), fpcp-child(head(calls), 2)) == 1) ? fpcp-calls-valid?(tail(calls), image-registry) : 0;
    def fpcp-registry(image-registry, grants, calls) = intern_node(fpcp-category(133), cons(image-registry, cons(fcatw-sequence("call-capability-grants-v1", grants), calls)));
    def fpcp-registry-valid?(registry) = nothing?(registry) ? 0 : !node_eq(node_category(registry), fpcp-category(133)) ? 0 : len(node_children(registry)) < 2 ? 0 : {
        let images = head(node_children(registry));
        !node_eq(node_category(images), fcatw-registry-category()) ? 0 : (Comparable) fcatw-sequence-is?(node_children(registry)[1], "call-capability-grants-v1") == 0 ? 0 : (Comparable) fpcp-image-bindings-valid?(fcatw-registry-bindings(images)) == 0 ? 0 : fpcp-calls-valid?(tail(tail(node_children(registry))), images);
    };
    def fpcp-registry-images(registry) = head(node_children(registry));
    def fpcp-registry-calls(registry) = tail(tail(node_children(registry)));
    def fpcp-call-present?(calls, call) = nil?(calls) ? 0 : node_eq(head(calls), call) ? 1 : fpcp-call-present?(tail(calls), call);
    def fpcp-registry-with-images(registry, images) = fpcp-registry(images, fcatw-sequence-values(node_children(registry)[1]), fpcp-registry-calls(registry));
    // OFFER carries no ambient root, path, or authority.  Everything needed to
    // resolve and call is content beneath the offer and protocol registry.
    def fpcp-offer(call, correlation, values, fuel) = intern_node(fpcp-category(134), [call, correlation, fcatw-sequence("call-offer-values-v1", values), intern_trivial_int(fuel)]);
    def fpcp-offer-valid?(offer) = nothing?(offer) ? 0 : !node_eq(node_category(offer), fpcp-category(134)) ? 0 : !((Comparable) len(node_children(offer)) == 4) ? 0 : (Comparable) fpcp-call-valid?(fpcp-child(offer, 0)) == 0 ? 0 : nothing?(fpcp-child(offer, 1)) ? 0 : (Comparable) fcatw-sequence-is?(fpcp-child(offer, 2), "call-offer-values-v1") == 0 ? 0 : !((Comparable) node_type(fpcp-child(offer, 3)) == 1) ? 0 : node_value(fpcp-child(offer, 3)) < 0 ? 0 : fpcp-values-valid?(fcatw-sequence-values(fpcp-child(offer, 2)));
    def fpcp-offer-values(offer) = fcatw-sequence-values(fpcp-child(offer, 2));
    // ACK retains the exact offer, so correlation and call identity cannot be
    // replaced between request and observation.
    def fpcp-ack(offer, status, reason, value, steps, output, trace) = intern_node(fpcp-category(135), [offer, intern_trivial_string(status), intern_trivial_string(reason), value, intern_trivial_int(steps), intern_trivial_int(output), intern_trivial_string(trace)]);
    def fpcp-ack-status(ack) = node_value(fpcp-child(ack, 1));
    def fpcp-ack-reason(ack) = node_value(fpcp-child(ack, 2));
    def fpcp-ack-value(ack) = fpcp-child(ack, 3);
    def fpcp-ack-steps(ack) = node_value(fpcp-child(ack, 4));
    def fpcp-ack-output(ack) = node_value(fpcp-child(ack, 5));
    def fpcp-ack-trace(ack) = node_value(fpcp-child(ack, 6));
    def fpcp-ack-correlation(ack) = fpcp-child(fpcp-child(ack, 0), 1);
    // ack-valid? closes the structural status/value/output/fuel contract.
    // ack-observed? below additionally recomputes the exact deterministic ACK
    // for the registry and OFFER a receiver actually holds; that is the guard
    // against a structurally plausible forged, swapped, or stale ACK.
    def fpcp-ack-valid?(ack) = nothing?(ack) ? 0 : !node_eq(node_category(ack), fpcp-category(135)) ? 0 : !((Comparable) len(node_children(ack)) == 7) ? 0 : !((Comparable) node_type(fpcp-child(ack, 1)) == 2) ? 0 : !((Comparable) node_type(fpcp-child(ack, 2)) == 2) ? 0 : (Comparable) fpcp-value-valid?(fpcp-child(ack, 3)) == 0 ? 0 : !((Comparable) node_type(fpcp-child(ack, 4)) == 1) ? 0 : !((Comparable) node_type(fpcp-child(ack, 5)) == 1) ? 0 : !((Comparable) node_type(fpcp-child(ack, 6)) == 2) ? 0 : {
        let offer = fpcp-child(ack, 0);
        let status = fpcp-ack-status(ack);
        let reason = fpcp-ack-reason(ack);
        let value = fpcp-ack-value(ack);
        let steps = fpcp-ack-steps(ack);
        let output = fpcp-ack-output(ack);
        let trace = fpcp-ack-trace(ack);
        let malformed-offer-refusal = (String) status == "refused" && (String) reason == "offer-malformed";
        let offer-ok = malformed-offer-refusal || (Comparable) fpcp-offer-valid?(offer) == 1;
        let fuel-ok = malformed-offer-refusal ? (Comparable) steps == 0 : steps >= 0 && steps <= node_value(fpcp-child(offer, 3));
        let value-is-nothing = (Comparable) fpcp-value-kind(value) == fcatw-kind-nothing();
        let status-ok = (String) status == "returned" ? (String) reason == "resident-thought-returned" && ((Comparable) output == 1 && (!value-is-nothing && (String) trace == "offer,resolve,call,return,ack,release")) : (String) status == "refused" ? ((String) reason == "offer-malformed" || ((String) reason == "protocol-registry-malformed" || ((String) reason == "capability-refused" || ((String) reason == "offer-abi-refused" || (String) reason == "return-list-kind-unavailable")))) && ((Comparable) output == 0 && (value-is-nothing && ((String) reason == "return-list-kind-unavailable" ? steps > 0 && (String) trace == "offer,resolve,call,refused,ack,release" : (Comparable) steps == 0 && (String) trace == "offer,refused,ack,release"))) : (String) status == "nothing" ? ((String) reason == "call-binding-not-admitted" || (String) reason == "symbol-not-found") && ((Comparable) output == 0 && (value-is-nothing && (String) trace == "offer,nothing,ack,release")) : (String) status == "choice" ? (String) reason == "ambiguous-symbol" && ((Comparable) output == 0 && (value-is-nothing && (String) trace == "offer,choice,ack,release")) : (String) status == "timeout" ? (String) reason == "walker-fuel-exhausted" && ((Comparable) output == 0 && (value-is-nothing && (String) trace == "offer,resolve,call,timeout,ack,release")) : (String) status == "failure" ? str_len(reason) > 0 && ((Comparable) output == 0 && (value-is-nothing && (String) trace == "offer,resolve,call,failure,ack,release")) : 0;
        offer-ok && (fuel-ok && status-ok) ? 1 : 0;
    };
    def fpcp-empty-ack(offer, status, reason, trace) = fpcp-ack(offer, status, reason, fpcp-value(fcatw-kind-nothing(), nothing()), 0, 0, trace);
    def fpcp-result-ack(offer, result, image) = nothing?(result) ? fpcp-empty-ack(offer, "refused", "offer-abi-refused", "offer,refused,ack,release") : (Comparable) fcatw-kind(result) == fcatw-kind-list() && !((Comparable) fcatw-tag(fcatw-node-at(image, fcatw-image-root(image))) == 2) ? fpcp-ack(offer, "refused", "return-list-kind-unavailable", fpcp-value(fcatw-kind-nothing(), nothing()), fcatw-steps(result), 0, "offer,resolve,call,refused,ack,release") : fpcp-ack(offer, fcatw-status(result), fcatw-reason(result), (Comparable) fcatw-kind(result) == fcatw-kind-list() ? fpcp-value(fcatw-kind-list(), fpcp-offer-values(offer)) : fpcp-value(fcatw-kind(result), fcatw-value(result)), fcatw-steps(result), fcatw-output-count(result), (String) fcatw-status(result) == "returned" ? "offer,resolve,call,return,ack,release" : (String) fcatw-status(result) == "timeout" ? "offer,resolve,call,timeout,ack,release" : "offer,resolve,call,failure,ack,release");
    def fpcp-execute(registry, offer) = nothing?(offer) ? nothing() : (Comparable) fpcp-offer-valid?(offer) == 0 ? fpcp-empty-ack(offer, "refused", "offer-malformed", "offer,refused,ack,release") : (Comparable) fpcp-registry-valid?(registry) == 0 ? fpcp-empty-ack(offer, "refused", "protocol-registry-malformed", "offer,refused,ack,release") : {
        let call = fpcp-child(offer, 0);
        (Comparable) fpcp-call-present?(fpcp-registry-calls(registry), call) == 0 ? fpcp-empty-ack(offer, "nothing", "call-binding-not-admitted", "offer,nothing,ack,release") : (Comparable) fcatw-binding-present?(fcatw-sequence-values(node_children(registry)[1]), fpcp-child(call, 3)) == 0 ? fpcp-empty-ack(offer, "refused", "capability-refused", "offer,refused,ack,release") : {
            let images = fpcp-registry-images(registry);
            let callee = fpcp-child(call, 2);
            let resolution = fcatw-resolve(images, fcatw-binding-symbol(callee));
            (String) fcatw-resolution-status(resolution) == "choice" ? fpcp-empty-ack(offer, "choice", fcatw-resolution-reason(resolution), "offer,choice,ack,release") : !((String) fcatw-resolution-status(resolution) == "ready") ? fpcp-empty-ack(offer, fcatw-resolution-status(resolution), fcatw-resolution-reason(resolution), (String) fcatw-resolution-status(resolution) == "nothing" ? "offer,nothing,ack,release" : "offer,resolve,call,failure,ack,release") : !node_eq(fcatw-resolution-image(resolution), fcatw-binding-image(callee)) ? fpcp-empty-ack(offer, "failure", "resolved-image-mismatch", "offer,resolve,call,failure,ack,release") : {
                let values = fpcp-offer-values(offer);
                fpcp-result-ack(offer, fcatw-run-image(fcatw-resolution-image(resolution), fpcp-values-raw(values), fpcp-values-kinds(values), node_value(fpcp-child(offer, 3))), fcatw-resolution-image(resolution));
            };
        };
    };
    def fpcp-ack-observed?(registry, offer, ack) = (Comparable) fpcp-ack-valid?(ack) == 0 ? 0 : node_eq(ack, fpcp-execute(registry, offer)) ? 1 : 0;
    0;
}
