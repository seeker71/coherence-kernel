//////////////////////////////////////////////////////////////////////
//
// form-cli-flow.bml
//
// Executable BML for the form-cli flow. High-grammar authority:
//   form-stdlib/bml/form-cli-flow.bml
//
// Generic class FormCliFlow<T> — FileIO<T> door: methods hoist to bare
// fndefs, type parameter erases, class name mints an abstraction
// descriptor. Named constants ride `field`. Choice / cut / restore
// are reusable methods, not inlined magic. Templates name the shapes
// a backend, a walk, and an ingest unit share.
//
// Proven by: form-stdlib/tests/form-cli-flow-bml-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template WalkCell<THit, TReady> {
        member native: THit;
        member local: TReady;
        member remote: THit;
    }

    template BackendCell<TName> {
        member name: TName;
        member sovereignty: int;
        member trust: int;
        member capability: int;
        member confidence: int;
    }

    template IngestCell<TUnit> {
        member depth: TUnit;
        member fear: TUnit;
    }

    class FormCliFlowAuthority {
        field Path = "form/form-stdlib/bml/form-cli-flow.bml";
        field Kind = "high-bml-class-template-field";
    }

    class FormCliFlow<T> {
        // ---- named constants (grains, lanes, weights) -----------------
        field Ice = 2;
        field Liquid = 1;
        field Compost = 0;
        field LaneNative = 0;
        field LaneLocal = 1;
        field LaneRemote = 2;
        field DepthFloor = 3;
        field WeightSovereignty = 2;
        field WeightTrust = 2;
        field WeightCapability = 1;
        field WeightConfidence = 1;
        field WeightDivisor = 6;
        field NameNative = "form-native";
        field NameAgent = "agent-cli";
        field Nothing = -1;

        ref fcf-authority = FormCliFlowAuthority;
        thought fcf-pattern = list("choice", "cut", "restore", "walk", "ingest");

        // ---- Form primitives as reusable methods ----------------------
        // choice: first non-nothing wins (native, then local, then remote)
        def fcf-choice(first, rest) = if eq(first, Nothing()) then rest else first;
        def fcf-ready(flag, lane) = if eq(flag, 1) then lane else Nothing();
        def fcf-cut(capability, score) = if eq(capability, 0) then 0 else score;
        def fcf-restore(checkpoint) = checkpoint;
        def fcf-walk(native-hit, local-ready) = fcf-choice(fcf-ready(native-hit, LaneNative()), fcf-choice(fcf-ready(local-ready, LaneLocal()), LaneRemote()));

        // ---- backend shape (BackendCell members as a list) ------------
        def fcf-backend(name, sovereignty, trust, capability, confidence) = list(name, sovereignty, trust, capability, confidence);
        def fcf-name(b) = nth(b, 0);
        def fcf-sovereignty(b) = nth(b, 1);
        def fcf-trust(b) = nth(b, 2);
        def fcf-capability(b) = nth(b, 3);
        def fcf-confidence(b) = nth(b, 4);

        // score is the weighted sum; fitness is score after cut
        def fcf-score(b) {
            let s = mul(WeightSovereignty(), fcf-sovereignty(b));
            let t = mul(WeightTrust(), fcf-trust(b));
            let c = mul(WeightCapability(), fcf-capability(b));
            let n = mul(WeightConfidence(), fcf-confidence(b));
            div(add(add(s, t), add(c, n)), WeightDivisor());
        }
        def fcf-fitness(b) = fcf-cut(fcf-capability(b), fcf-score(b));
        def fcf-route(form-native, agent-cli) = if ge(fcf-fitness(form-native), fcf-fitness(agent-cli)) then fcf-name(form-native) else fcf-name(agent-cli);
        def fcf-flips-local?(fn-before, fn-after, agent-cli) {
            let before = fcf-route(fn-before, agent-cli);
            let after = fcf-route(fn-after, agent-cli);
            if str_eq(before, NameAgent()) then if str_eq(after, NameNative()) then 1 else 0 else 0;
        }

        // ---- ingest: named grains, never 2/1/0 at the call site -------
        def fcf-ingest(depth, fear) = if ge(depth, DepthFloor()) then if eq(fear, 0) then Ice() else Liquid() else Compost();

        def fcf-check() {
            let fn-strong = fcf-backend(NameNative(), 100, 80, 80, 80);
            let fn-blind = fcf-backend(NameNative(), 100, 100, 0, 100);
            let fn-weak = fcf-backend(NameNative(), 100, 20, 50, 20);
            let cli = fcf-backend(NameAgent(), 50, 90, 100, 100);
            let b0 = if eq(Ice(), 2) then if eq(Liquid(), 1) then if eq(Compost(), 0) then 1 else 0 else 0 else 0;
            let b1 = if eq(fcf-walk(1, 1), LaneNative()) then if eq(fcf-walk(0, 1), LaneLocal()) then if eq(fcf-walk(0, 0), LaneRemote()) then 2 else 0 else 0 else 0;
            let b2 = if eq(fcf-ingest(5, 0), Ice()) then if eq(fcf-ingest(5, 1), Liquid()) then if eq(fcf-ingest(1, 0), Compost()) then 4 else 0 else 0 else 0;
            let b3 = if eq(fcf-fitness(fn-blind), 0) then 8 else 0;
            let b4 = if str_eq(fcf-route(fn-strong, cli), NameNative()) then 16 else 0;
            let b5 = if str_eq(fcf-route(fn-blind, cli), NameAgent()) then 32 else 0;
            let b6 = if eq(fcf-flips-local?(fn-blind, fn-strong, cli), 1) then 64 else 0;
            let b7 = if str_eq(fcf-route(fn-weak, cli), NameAgent()) then 128 else 0;
            add(b0, add(b1, add(b2, add(b3, add(b4, add(b5, add(b6, b7)))))));
        }
    }
    0;
}
