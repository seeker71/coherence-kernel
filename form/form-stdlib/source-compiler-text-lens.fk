; source-compiler-text-lens.fk — executable Form text view of compiled sections.
;
; The primary source-compiler door emits a durable .fkb image plus its explicit
; walk_recipe_here loader.  Text consumers such as the direct fkwu source arm
; need the same compiled Recipe expressed in Form source, so this late module
; narrows that boundary without changing the primary runtime-image path.
;
; A compiled section is rooted at DO. Emitting that root as one `(do ...)`
; changes module bindings into lexical bindings: a BML top-level `let tag = ...`
; then becomes invisible inside the section's defns. Emit the root children as
; top-level forms instead. This is a source lens over the same Recipe, not a
; flattened table or a second BML lowering.
;
; Load after source-compiler.fk.  Its fsc-compile-section definition deliberately
; shadows the runtime-image definition for this one compiler chain.
;
; preludes: form-stdlib/source-compiler.fk

(do
    (defn fsc-source-emit-module-loop (recipes)
        (if (fsc-empty? recipes) ""
            (str_concat
                (fsc-source-emit-recipe (head recipes))
                (str_concat "\n"
                    (fsc-source-emit-module-loop (tail recipes))))))

    (defn fsc-source-emit-module (recipe)
        (if (node_eq (node_category recipe) fsc-rec-DO-CAT)
            (fsc-source-emit-module-loop (node_children recipe))
            (str_concat (fsc-source-emit-recipe recipe) "\n")))

    (defn fsc-compile-section (dialect-name body out-path)
        (fsc-source-emit-module
            (fsc-compile-section-recipe dialect-name body)))
    0)
