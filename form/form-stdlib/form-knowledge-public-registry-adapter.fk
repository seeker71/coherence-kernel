; form-knowledge-public-registry-adapter.fk -- join public addressability to
; the knowledge-integration census without calling it model mastery.
;
; The public shard report can already prove that a current source owns a
; valid PSCI entry and at least its unique scannerless concept coordinate.
; That is useful retrieval evidence, but it is not a heldout answer, local
; model execution, teaching-prefix exposure, reasoning, or learned weights.
; This companion therefore leaves form-knowledge-integration-report-v1 whole
; and copies its five model-facing axes without alteration.
;
; A public query cohort is operational evidence only.  Each counted row must
; round-trip through the scannerless BMF surface, return current PSCI source
; and entry identities, execute exactly one lookup, and say model-executed=0.
; The fold walks distinct offered cohort keys, so duplicate outputs never
; increase the count.  Nothing here admits a row to fki-observation-valid?.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/file-byte-window.fk form-stdlib/sha256.fk
; preludes: form-stdlib/hex.fk form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-source-search.fk
; preludes: form-stdlib/form-cli-heed-current-source.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/public-source-concept-shards.fk
; preludes: form-stdlib/public-source-concept-key-routes.fk
; preludes: form-stdlib/form-nodeid-knowledge-query.fk
; preludes: form-stdlib/form-nodeid-knowledge-routed-query.fk
; preludes: form-stdlib/form-knowledge-integration-census.fk
; Proven by: form-stdlib/tests/form-knowledge-public-registry-adapter-band.fk

(do
    (defn fkipr-schema () "form-knowledge-public-registry-report-v1")
    (defn fkipr-query-evidence-schema ()
        "public-registry-query-token-evidence-v1")
    (defn fkipr-basis ()
        "live-census+current-psci-shards+scannerless-public-query-cohort-v1")

    ; Evidence is deliberately only surface + existing typed result + witness.
    ; There are no model, heldout, teaching, reasoning, or weight fields to
    ; accidentally reinterpret.
    (defn fkipr-query-evidence (surface result witness-id)
        (list (fkipr-query-evidence-schema) surface result witness-id))
    (defn fkipr-query-evidence-surface (e) (nth e 1))
    (defn fkipr-query-evidence-result (e) (nth e 2))
    (defn fkipr-query-evidence-witness (e) (nth e 3))

    (defn fkipr-trace-hit-shape? (trace)
        (if (and (eq (fknq-trace-has? trace "choice") 1)
            (and (eq (fknq-trace-has? trace "cut") 1)
            (and (eq (fknq-trace-has? trace "release") 1)
            (and (eq (fknq-trace-has? trace "timeout") 0)
            (and (eq (fknq-trace-has? trace "failure") 0)
                 (eq (fknq-trace-has? trace "undo") 0)))))) 1 0))

    (defn fkipr-query-evidence-valid? (root sources e)
        (if (not (eq (len e) 4)) 0
        (if (not (str_eq (nth e 0) (fkipr-query-evidence-schema))) 0
        (if (eq (str_len (fkipr-query-evidence-witness e)) 0) 0
            (do
                (let surface (fkipr-query-evidence-surface e))
                (let result (fkipr-query-evidence-result e))
                (let scan (fknq-bmf-consume-default surface))
                (if (not (eq (len result) 22)) 0
                (if (not (str_eq (fknq-scan-status scan) "ready")) 0
                (if (not (str_eq (fknq-scan-consumed scan) surface)) 0
                (if (not (node_eq (fknq-scan-request scan)
                                   (fknq-request result))) 0
                (if (or (eq (psci-source-node-valid?
                                (fknq-source-original-of result)) 0)
                        (eq (psci-entry-valid?
                                (fknq-entry-original-of result)) 0)) 0
                    (do
                        (let source (fknq-source-original-of result))
                        (let entry (fknq-entry-original-of result))
                        (let path (psci-source-path source))
                        (let family (psci-source-family source))
                        (let checks (list
                            (if (str_eq (fknq-status result) "hit") 1 0)
                            (if (str_eq (fknq-reason result)
                                    "concept-registry-current-source-hit") 1 0)
                            (fknq-source-token-valid? (fknq-source result))
                            (fknq-entry-token-valid? (fknq-entry result))
                            (if (node_eq (fknq-source-original
                                    (fknq-source result)) source) 1 0)
                            (if (node_eq (fknq-entry-original
                                    (fknq-entry result)) entry) 1 0)
                            (if (node_eq (psci-entry-source entry) source) 1 0)
                            (if (node_eq (fknq-executor result)
                                    (fknq-executor-token)) 1 0)
                            (if (node_eq (node_category
                                    (fknq-observation result))
                                    (fknq-observation-category)) 1 0)
                            (if (str_eq (fknq-source-path result) path) 1 0)
                            (fki-current-source-member? path family sources)
                            (psci-entry-current-at? root entry)
                            (if (eq (fknq-fresh? result) 1) 1 0)
                            (if (eq (fknq-rebuild? result) 0) 1 0)
                            (if (eq (fknq-match-count result) 1) 1 0)
                            (if (eq (fknq-lookup-count result) 1) 1 0)
                            (if (eq (fknq-hit-count result) 1) 1 0)
                            (if (eq (fknq-executed? result) 1) 1 0)
                            (if (eq (fknq-model-executed? result) 0) 1 0)
                            (if (eq (fknq-pretokenized? result) 0) 1 0)
                            (if (eq (fknq-scannerless? result) 1) 1 0)
                            (if (and (gt (str_len (fknq-answer result)) 0)
                                     (le (str_len (fknq-answer result))
                                         (fkss-answer-limit))) 1 0)
                            (fkipr-trace-hit-shape? (fknq-trace result))))
                        (if (eq (sum checks) 23) 1 0))))))))))))

    (defn fkipr-query-key-from-surface (surface)
        (do
            (let scan (fknq-bmf-consume-default surface))
            (if (not (str_eq (fknq-scan-status scan) "ready")) ""
                (do
                    (let request (fknq-scan-request scan))
                    (str_concat (fknq-request-kind request)
                        (str_concat "="
                            (fknq-request-coordinate request)))))))
    (defn fkipr-query-evidence-key (e)
        (if (not (eq (len e) 4)) ""
            (fkipr-query-key-from-surface
                (fkipr-query-evidence-surface e))))
    (defn fkipr-string-member? (value rows)
        (if (nil? rows) 0
            (if (str_eq value (head rows)) 1
                (fkipr-string-member? value (tail rows)))))
    (defn fkipr-distinct-loop (rows acc)
        (if (nil? rows) (reverse acc)
            (fkipr-distinct-loop (tail rows)
                (if (or (eq (str_len (head rows)) 0)
                        (eq (fkipr-string-member? (head rows) acc) 1)) acc
                    (cons (head rows) acc)))))
    (defn fkipr-distinct (rows)
        (fkipr-distinct-loop rows (empty)))
    (defn fkipr-key-has-valid-evidence? (root sources key evidence)
        (if (nil? evidence) 0
            (if (and (str_eq key
                        (fkipr-query-evidence-key (head evidence)))
                     (eq (fkipr-query-evidence-valid? root sources
                            (head evidence)) 1)) 1
                (fkipr-key-has-valid-evidence? root sources key
                    (tail evidence)))))
    (defn fkipr-count-valid-query-cohort-loop
            (root sources cohort evidence n)
        (if (nil? cohort) n
            (fkipr-count-valid-query-cohort-loop root sources (tail cohort)
                evidence (add n (fkipr-key-has-valid-evidence? root sources
                    (head cohort) evidence)))))
    (defn fkipr-count-valid-query-cohort (root sources cohort evidence)
        (fkipr-count-valid-query-cohort-loop root sources
            (fkipr-distinct cohort) evidence 0))

    (defn fkipr-shard-report-shape? (r)
        (if (not (eq (len r) 17)) 0
            (if (not (str_eq (nth r 0)
                    "public-source-concept-shard-report-v1")) 0
                (if (and (ge (pscish-report-denominator r) 0)
                    (and (ge (pscish-report-planned r) 0)
                    (and (ge (pscish-report-indexed r) 0)
                    (and (ge (pscish-report-current r) 0)
                    (and (le (pscish-report-current r)
                             (pscish-report-indexed r))
                         (le (pscish-report-indexed r)
                             (pscish-report-planned r))))))) 1 0))))
    (defn fkipr-shard-fault-free? (r)
        (if (eq (fkipr-shard-report-shape? r) 0) 0
            (if (and (eq (pscish-report-failures r) 0)
                (and (eq (pscish-report-ambiguities r) 0)
                (and (eq (pscish-report-stale r) 0)
                (and (eq (pscish-report-missing r) 0)
                (and (eq (pscish-report-invalid r) 0)
                     (eq (pscish-report-model-executed? r) 0)))))) 1 0)))
    (defn fkipr-shard-census-aligned? (census-total shard)
        (if (eq (fkipr-shard-report-shape? shard) 0) 0
            (if (eq (pscish-report-denominator shard) census-total) 1 0)))
    (defn fkipr-shard-current-closure? (census-total shard)
        (if (eq (fkipr-shard-report-shape? shard) 0) 0
            (if (and (eq (fkipr-shard-census-aligned?
                                census-total shard) 1)
                (and (eq (pscish-report-planned shard)
                         (pscish-report-denominator shard))
                (and (eq (add (pscish-report-indexed shard)
                              (pscish-report-over-budget shard))
                         (pscish-report-planned shard))
                (and (eq (pscish-report-current shard)
                         (pscish-report-indexed shard))
                (and (eq (fkipr-shard-fault-free? shard) 1)
                (and (eq (pscish-report-plan-current? shard) 1)
                     (eq (pscish-report-rebuild-needed? shard) 0))))))) 1 0)))
    (defn fkipr-percent (part whole)
        (if (le whole 0) 0 (div (mul part 100) whole)))

    ; report fields:
    ; tag scope census-total shard-denominator shard-indexed shard-current
    ; concept-bearing-current-minimum registry-source-percent
    ; concept-bearing-source-percent shard-threshold95 census-aligned
    ; current-closure query-cohort-total distinct-valid-query-tokens
    ; query-cohort-percent executable-query-gate
    ; base-heldout-integrated-percent base-grounded-rag-percent
    ; base-provenance-percent base-teaching-prefix-percent
    ; base-learned-weight-percent base-integration-ready95
    ; base-repository-ready95 adapter-repository-ready95
    ; registry-model-executed basis
    (defn fkipr-report (root sources base shard cohort evidence)
        (do
            (let census-total (fki-report-source-total base))
            (let shard-valid (fkipr-shard-report-shape? shard))
            (let denominator (if (eq shard-valid 1)
                (pscish-report-denominator shard) 0))
            (let indexed (if (eq shard-valid 1)
                (pscish-report-indexed shard) 0))
            (let current (if (eq shard-valid 1)
                (pscish-report-current shard) 0))
            ; Every current validated PSCI record contains its unique key.
            ; This is a lower bound on addressable coordinates, not a count of
            ; semantic concepts learned by a model.
            (let concept-bearing-minimum current)
            (let distinct-cohort (fkipr-distinct cohort))
            (let query-total (len distinct-cohort))
            (let query-valid (fkipr-count-valid-query-cohort root sources
                distinct-cohort evidence))
            (let query-gate (if (and (gt query-total 0)
                                     (eq query-valid query-total)) 1 0))
            (let aligned (fkipr-shard-census-aligned?
                census-total shard))
            (let closure (fkipr-shard-current-closure?
                census-total shard))
            (let adapter-ready (if (and
                    (eq (fki-report-repository-ready95? base) 1)
                    (and (eq closure 1)
                    (and (eq (if (eq shard-valid 1)
                            (pscish-report-threshold95? shard) 0) 1)
                         (eq query-gate 1)))) 1 0))
            (list (fkipr-schema) (fki-report-scope base) census-total
                denominator indexed current concept-bearing-minimum
                (fkipr-percent current census-total)
                (fkipr-percent concept-bearing-minimum census-total)
                (if (eq shard-valid 1)
                    (pscish-report-threshold95? shard) 0)
                aligned closure query-total query-valid
                (fkipr-percent query-valid query-total) query-gate
                (fki-report-concept-percent base)
                (fki-report-grounded-rag-percent base)
                (fki-report-provenance-percent base)
                (fki-report-teaching-prefix-percent base)
                (fki-report-learned-weight-percent base)
                (fki-report-ready95? base)
                (fki-report-repository-ready95? base)
                adapter-ready
                (if (eq shard-valid 1)
                    (pscish-report-model-executed? shard) 0)
                (fkipr-basis))))

    (defn fkipr-report-scope (r) (nth r 1))
    (defn fkipr-report-census-total (r) (nth r 2))
    (defn fkipr-report-shard-denominator (r) (nth r 3))
    (defn fkipr-report-shard-indexed (r) (nth r 4))
    (defn fkipr-report-shard-current (r) (nth r 5))
    (defn fkipr-report-concept-bearing-minimum (r) (nth r 6))
    (defn fkipr-report-registry-source-percent (r) (nth r 7))
    (defn fkipr-report-concept-bearing-percent (r) (nth r 8))
    (defn fkipr-report-shard-threshold95? (r) (nth r 9))
    (defn fkipr-report-census-aligned? (r) (nth r 10))
    (defn fkipr-report-current-closure? (r) (nth r 11))
    (defn fkipr-report-query-cohort-total (r) (nth r 12))
    (defn fkipr-report-valid-query-tokens (r) (nth r 13))
    (defn fkipr-report-query-cohort-percent (r) (nth r 14))
    (defn fkipr-report-executable-query-gate? (r) (nth r 15))
    (defn fkipr-report-base-heldout-percent (r) (nth r 16))
    (defn fkipr-report-base-grounded-rag-percent (r) (nth r 17))
    (defn fkipr-report-base-provenance-percent (r) (nth r 18))
    (defn fkipr-report-base-teaching-prefix-percent (r) (nth r 19))
    (defn fkipr-report-base-learned-weight-percent (r) (nth r 20))
    (defn fkipr-report-base-integration-ready95? (r) (nth r 21))
    (defn fkipr-report-base-repository-ready95? (r) (nth r 22))
    (defn fkipr-report-adapter-repository-ready95? (r) (nth r 23))
    (defn fkipr-report-registry-model-executed? (r) (nth r 24))
    (defn fkipr-report-basis (r) (nth r 25))

    0)
