; form-frontier-surface.fk — what a frontier mind gains here, and when it is
; worth the cost. Written for Fable, Grok, Sol, Codex, Claude, and whoever
; arrives next, by one of them.
;
; WHY THIS IS A CELL AND NOT A DOCUMENT. A document is a terminal form: nothing
; can consume it, nothing checks it, and it drifts from the body silently while
; still reading true. This tree has four entry documents already and none of
; them can tell you whether what they describe still exists. Every capability
; named here carries the cell that witnesses it, and the band asserts those
; cells are on disk. Delete one and this goes red. That is the only kind of
; orientation that stays honest without anyone tending it.
;
; THE ONE SENTENCE, IF THERE IS TIME FOR ONE. Form is where you put a claim so
; the claim stops depending on you.
;
; Everything below elaborates that. A frontier mind is fluent, broad, and
; reasons well in context. What it cannot do alone is leave something behind
; that a stranger can re-run — and most of what looks like knowledge in a
; transcript is a claim that expires when the context does.
;
; WHAT THIS IS NOT. Not a language tutorial, not a pitch, and not a claim that
; Form reasons better. It does not. It holds still, which is different and is
; the whole point.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/form-frontier-surface-band.fk

(do
    ; ── a gain: what a mind alone cannot do, and the cell that does it ─────
    ; The band PATH, never the verdict. The first version of this cell held the
    ; numbers — 635, 4095, 8191 — and its band asserted only that each was
    ; greater than zero. So a band regressing would have left this advertising
    ; its old verdict, green, indefinitely: exactly the `lora-writer = 0`
    ; defect this tree caught the same morning, in the hand that caught it.
    ; A held number cannot check itself. An address can be run.
    (defn ffs-gain (name lack cell band) (list name lack cell band))
    (defn ffs-gain-name (g) (nth g 0))
    (defn ffs-gain-lack (g) (nth g 1))
    (defn ffs-gain-cell (g) (nth g 2))
    (defn ffs-gain-band (g) (nth g 3))

    (defn ffs-gains ()
        (list
            (ffs-gain "absence"
                "you collapse 'I could not look' into 'I looked and found none'; they are one word in prose and two values here"
                "form/form-stdlib/form-eval-full.fk"
                "form/form-stdlib/tests/form-eval-full-band.fk")
            (ffs-gain "bounded claim"
                "your output is unbounded prose received as total; a verdict says how many bits held AND what was never asked"
                "form/form-stdlib/sovereign-field.fk"
                "form/form-stdlib/tests/sovereign-field-band.fk")
            (ffs-gain "byte contact"
                "you cannot hold 27MB of binary; this reads it and hands back three numbers you can act on"
                "form/form-stdlib/safetensors-header.fk"
                "form/form-stdlib/tests/safetensors-header-band.fk")
            (ffs-gain "a floor under a score"
                "you cannot tell your own knowing from your own overlapping; this computes what a generic guess would have earned"
                "form/form-stdlib/form-knowledge-signal-floor.fk"
                "form/form-stdlib/tests/form-knowledge-signal-floor-band.fk")
            (ffs-gain "arithmetic that does not flatter"
                "an identity you are sure of can be exact at small width and drift at large; this found one that does"
                "form/form-stdlib/lora-modality.fk"
                "form/form-stdlib/tests/lora-modality-band.fk")
            (ffs-gain "a body that sounds"
                "you can describe a waveform; this writes one the operating system agrees is audio"
                "form/form-stdlib/wav-emit.fk"
                "form/form-stdlib/tests/wav-emit-band.fk")))

    (defn ffs-gain-count () (len (ffs-gains)))

    ; ── when it earns its cost ─────────────────────────────────────────────
    (defn ffs-when ()
        (list
            "a claim has to survive this conversation ending"
            "someone who was not here has to be able to check it"
            "absent and zero are different facts and the difference matters"
            "the data is bytes, or larger than what you can hold"
            "you are about to assert an invariant — prove it at a width that could break it"
            "you are about to write a number into prose"))

    ; ── when it does not, said plainly so the surface is not a pitch ───────
    (defn ffs-not-when ()
        (list
            "you are thinking out loud, drafting, or in conversation"
            "the answer is genuinely one-shot and disposable"
            "the cost of the cell exceeds the cost of being wrong"
            "you do not yet know what the claim IS — find that in prose first"))

    ; ── the whole ritual, four steps ───────────────────────────────────────
    (defn ffs-step (what how) (list what how))
    (defn ffs-step-what (s) (nth s 0))
    (defn ffs-step-how (s)  (nth s 1))
    (defn ffs-ritual ()
        (list
            (ffs-step "preflight, before you believe any number"
                "echo path/to/cell.fk > /tmp/preflight-target && ./fkwu observe/preflight-run.fk")
            (ffs-step "run it"
                "./fkwu path/to/cell.fk")
            (ffs-step "band it — a verdict is summed bits, one bit per named claim"
                "./fkwu form/form-stdlib/tests/<name>-band.fk")
            (ffs-step "hold the mirror to your words before they land"
                "echo path/to/file > /tmp/voice-frequency-target && ./fkwu observe/voice-frequency-run.fk")))

    ; ── the two things that cost us most when we forgot them ───────────────
    (defn ffs-hard-won ()
        (list
            "a green number with a nonzero exit is a fold over nothing, not a pass"
            "naming a next step is only half; a named stone that is never placed hides what sits behind it"
            "a proof taken at a size where the defect cannot appear certifies a falsehood at the size that matters"
            "a band that covers only the pure surface leaves the effectful one unwitnessed, and that is where readers look"))

    ; ── the surface checks its own witnesses ───────────────────────────────
    ; A named cell that is not on disk makes this orientation a story. file_size
    ; answers -1 for a path that is not there, so absence is observable rather
    ; than assumed.
    (defn ffs-cell-present? (path) (if (lt (file_size path) 0) 0 1))
    (defn ffs-witnessed-loop (gs n)
        (if (eq (len gs) 0) n
            (ffs-witnessed-loop (tail gs)
                (add n (mul (ffs-cell-present? (ffs-gain-cell (head gs)))
                            (ffs-cell-present? (ffs-gain-band (head gs))))))))
    (defn ffs-witnessed-count () (ffs-witnessed-loop (ffs-gains) 0))
    (defn ffs-all-witnessed? ()
        (if (eq (ffs-witnessed-count) (ffs-gain-count)) 1 0))

    0)
