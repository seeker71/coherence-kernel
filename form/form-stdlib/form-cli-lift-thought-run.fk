; form-cli-lift-thought-run.fk — unfold the micro-thoughts.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-lift-thought.bml observe/bidirectional-framebuffer-channel.fk

(do
    (print "form-cli executed lift-thought\n")
    (print "form-cli tokens nothing=")
    (print (int_to_str (nth (flt-tokens) 0)))
    (print " cut=")
    (print (int_to_str (nth (flt-tokens) 1)))
    (print " choice=")
    (print (int_to_str (nth (flt-tokens) 4)))
    (print " undo=")
    (print (int_to_str (nth (flt-tokens) 5)))
    (print " restore=")
    (print (int_to_str (nth (flt-tokens) 6)))
    (print "\nform-cli exec choice=")
    (print (int_to_str (flt-exec (nth (flt-tokens) 4) 5 7 9)))
    (print " undo=")
    (print (int_to_str (flt-exec (nth (flt-tokens) 5) 5 7 9)))
    (print " nothing=")
    (print (int_to_str (flt-exec (nth (flt-tokens) 0) 5 7 9)))
    (print " restore=")
    (print (int_to_str (flt-exec (nth (flt-tokens) 6) 5 7 9)))
    (print "\nform-cli names=")
    (print (head (flt-names (flt-flow))))
    (print ",")
    (print (head (tail (flt-names (flt-flow)))))
    (print ",")
    (print (head (tail (tail (flt-names (flt-flow))))))
    (print ",")
    (print (head (tail (tail (tail (flt-names (flt-flow)))))))
    (print "\nform-cli phases=")
    (print (int_to_str (head (flt-phases (flt-flow)))))
    (print ",")
    (print (int_to_str (head (tail (flt-phases (flt-flow))))))
    (print ",")
    (print (int_to_str (head (tail (tail (flt-phases (flt-flow)))))))
    (print ",")
    (print (int_to_str (head (tail (tail (tail (flt-phases (flt-flow))))))))
    (print "\nform-cli pulse=")
    (print (int_to_str (flt-pulse (flt-flow))))
    (print " gas-count=")
    (print (int_to_str (flt-gas-count (flt-flow))))
    (print " check=")
    (print (int_to_str (flt-check)))
    (print "\n")
    (framebuffer-clear)
    (print "form-cli fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\n")
    0)
