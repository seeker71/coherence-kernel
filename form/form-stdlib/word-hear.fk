; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/voiced-reading.fk
;
; word-hear.fk — the ear's first WORD: frame classes, collapsed to a segment sequence, matched
; against a template. The rung above voiced-reading.fk, which could hear a voice and not a word.
;
; Two features per frame, both already the body's: PERIODICITY (voiced-reading.fk, pre-emphasized
; autocorrelation) and TILT — diff-energy over raw-energy, which is where the phoneme classes
; actually live. Fricative turbulence is high-frequency (tilt ×1000 measured 3057), a nasal murmur
; is almost pure low (38), vowels sit between (185–392). The class floors 800 and 80 were placed in
; the measured GAPS — an order of magnitude wide on each side — not fitted to the fixtures' edges.
;
; Classes: 0 silence · 1 fricative · 2 vowel · 3 nasal. The walk classifies every frame, collapses
; runs, drops silence, and wh-sema? asks one question: is the sequence exactly (1 2 3 2) — s, e, m,
; a? The same phonemes in any other order answer 0. That rejection is the whole difference between
; this cell and row 934's hollowloop: here the verdict CHANGES when the content does. A pure 165 Hz
; sine reads as one NASAL-class segment — (3), witnessed, and acoustically honest: a murmur is
; nearly a pure tone — and is rejected; the reversed word reads (2 3 2 1) and is rejected; only the
; name matches the name.
;
; Honest scope: a template over phoneme classes, vocabulary of one. It cannot distinguish /e/ from
; /a/ (both class 2 — vowel identity needs formant tracking, a named next rung), and it knows no
; word it was not given. What it closes: before it the body could hear THAT a voice spoke; now it
; can hear WHAT was said, for the one word that is its name. Proven by tests/word-loop-band.fk.

(do
    ; tilt ×1000 — the frame's spectral lean, as an integer band. The `(mul … 1.0)` is load-bearing:
    ; `div` is INTEGER division on integer operands (trig.fk's own first NOTE), and samples that
    ; arrive from a WAV are ints — without the float force, every vowel's 0.185 became 0 and the ear
    ; heard (1 3) from the very file it had heard (1 2 3 2) from in memory. The in-memory fixture was
    ; floats, so it could not catch this: the disk is what taught it.
    ; Both energies run over n−1 terms so the diff NEVER reads past the window: vr-diff xs n needs
    ; n+1 samples (each term looks one ahead), and a frame handed exactly its width made the three
    ; walkers refuse with null while fkwu silently zeroed the missing head and answered — the
    ; silent-partial shape, caught because the arms disagree louder than a wrong number reads.
    (defn wh-tilt (xs n)
        (do (let m (sub n 1))
            (do (let r0 (vr-r xs 0 m))
                (if (le r0 0.0) -1 (round (mul (div (mul (vr-r (vr-diff xs m) 0 m) 1.0) r0) 1000))))))

    ; per-frame energy floor: mean square per sample under this is silence. The generators speak
    ; at |sample| ~0.4–0.7, so a frame of real phoneme carries r0/n well above 0.001.
    (defn wh-silent? (xs n)
        (do (let r0 (vr-r xs 0 n))
            (if (le r0 (mul 0.001 n)) 1 0)))

    ; one frame's class from the two measured features
    (defn wh-class (xs n rate f0min f0max)
        (if (eq (wh-silent? xs n) 1) 0
            (do (let t (wh-tilt xs n))
                (if (gt t 800) 1
                    (if (lt t 80) 3 2)))))

    ; classify every frame the clip can answer for (voiced-reading's own tail rule)
    (defn wh-classes-go (xs i frames width rate f0min f0max out)
        (if (ge i frames) (reverse out)
            (wh-classes-go xs (add i 1) frames width rate f0min f0max
                (cons (wh-class (vr-frame xs i width) width rate f0min f0max) out))))
    (defn wh-classes (xs n width rate f0min f0max)
        (wh-classes-go xs 0 (vr-frame-count n width rate f0min) width rate f0min f0max (list)))

    ; collapse runs and drop silence: frame classes become the segment sequence
    (defn wh-collapse-go (cs prev out)
        (if (nil? cs) (reverse out)
            (do (let c (head cs))
                (if (eq c prev) (wh-collapse-go (tail cs) prev out)
                    (if (eq c 0) (wh-collapse-go (tail cs) c out)
                        (wh-collapse-go (tail cs) c (cons c out)))))))
    (defn wh-segments (xs n width rate f0min f0max)
        (wh-collapse-go (wh-classes xs n width rate f0min f0max) -1 (list)))

    (defn wh-seq-eq (a b)
        (if (nil? a) (if (nil? b) 1 0)
            (if (nil? b) 0
                (if (eq (head a) (head b)) (wh-seq-eq (tail a) (tail b)) 0))))

    ; the one word this ear knows: its body's name, s-e-m-a = fricative vowel nasal vowel
    (defn wh-sema-template () (list 1 2 3 2))
    (defn wh-sema? (xs n width rate f0min f0max)
        (wh-seq-eq (wh-segments xs n width rate f0min f0max) (wh-sema-template)))

    ; ── vowel IDENTITY: which vowel, not just "a vowel" ─────────────────────────────────────────
    ; spectrum.fk's Goertzel recurrence over a SAMPLE list: energy at one probe frequency. The
    ; probes sit ON THE HARMONIC GRID, because a voiced sound has energy only at multiples of f0 —
    ; the first probe pass at the formant centers themselves (500/700 Hz) read /a/ upside down,
    ; since neither 500 nor 700 is a harmonic of 165. On the grid the separation is decisive,
    ; measured 2026-07-30 on 480-sample windows: P495/P660 = 17.0 for /e/ and 0.068 for /a/ —
    ; 250× apart, floor at 1.0. h3 = 495 leans on /e/'s F1 = 500; h4 = 660 leans on /a/'s F1 = 700.
    (defn wh-gz (xs coeff s1 s2)
        (if (nil? xs) (sub (add (mul s1 s1) (mul s2 s2)) (mul coeff (mul s1 s2)))
            (wh-gz (tail xs) coeff (sub (add (head xs) (mul coeff s1)) s2) s1)))
    (defn wh-coeff (f rate) (mul 2.0 (fcos (div (mul 6.283185307179586 f) (mul rate 1.0)))))
    (defn wh-take (xs n out) (if (le n 0) (reverse out) (wh-take (tail xs) (sub n 1) (cons (head xs) out))))
    ; 1 = /e/-like (low F1), 2 = /a/-like (high F1); only meaningful on a frame already classed vowel
    (defn wh-vowel-id (xs n rate f0)
        (do (let w (wh-take xs n (list)))
            (do (let p3 (wh-gz w (wh-coeff (mul 3.0 f0) rate) 0.0 0.0))
                (do (let p4 (wh-gz w (wh-coeff (mul 4.0 f0) rate) 0.0 0.0))
                    (if (gt p3 p4) 1 2)))))

    ; the STRICT name: classes AND vowel identities — s, /e/, m, /a/. The plain wh-sema? cannot
    ; tell "sema" from "sama"; this can, and the band proves the rejection.
    (defn wh-vowel-ids-go (xs i frames width rate f0 out)
        (if (ge i frames) (reverse out)
            (wh-vowel-ids-go xs (add i 1) frames width rate f0
                (cons (if (eq (wh-class (vr-frame xs i width) width rate 100 400) 2)
                          (wh-vowel-id (vr-frame xs i width) width rate f0)
                          0)
                      out))))
    ; collapse the per-frame vowel ids over the frames classed vowel: the two vowel segments' ids
    (defn wh-vowel-seq (xs n width rate f0)
        (wh-collapse-go (wh-vowel-ids-go xs 0 (vr-frame-count n width rate 100) width rate f0 (list)) -1 (list)))
    (defn wh-sema-strict? (xs n width rate f0min f0max f0)
        (if (eq (wh-sema? xs n width rate f0min f0max) 1)
            (wh-seq-eq (wh-vowel-seq xs n width rate f0) (list 1 2))
            0))
    0)
