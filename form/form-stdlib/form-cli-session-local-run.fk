; form-cli-session-local-run.fk — print the census, never content.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-cli-local-ready.bml
; preludes: form-cli-one-turn.bml
; preludes: form-cli-session-local.bml

(do
    (print_str (str_concat "fsl check=" (str_concat (int_to_str (fsl-check)) "\n")))
    (print_str (str_concat "fsl event-local-ppm=" (str_concat (int_to_str (fsl-event-local-ppm (ThisNative) (ThisLocal) (ThisRemote))) "\n")))
    (print_str (str_concat "fsl leak-this=" (str_concat (int_to_str (fsl-leak (ThisRemote) (OneTurn))) "\n")))
    (print_str (str_concat "fsl leak-logs=" (str_concat (int_to_str (fsl-leak (LogAsst) (LogUsers))) "\n")))
    (print_str (str_concat "fsl census-rule=" (str_concat (CensusRule) "\n")))
    (print_str (str_concat "fsl census-events=" (str_concat
        (int_to_str (add (ThisNative) (add (ThisLocal) (ThisRemote)))) "\n")))
    (print_str (str_concat "fsl train-mint=" (str_concat (TrainMint) "\n")))
    (print_str (str_concat "fsl claude-leak=" (str_concat (int_to_str (fsl-leak (ClaudeAsst) (ClaudeUsers))) "\n")))
    (print_str (str_concat "fsl claude-tool-coverable-ppm=" (str_concat (int_to_str (fsl-tool-coverable-ppm (ClaudeTools) (ClaudeWeb))) "\n")))
    0)
