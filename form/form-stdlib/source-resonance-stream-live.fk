; source-resonance-stream-live.fk — watch the thought stream once.
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/form-cli-thought.fk

(do
    (print "thought-phase 6 1=")
    (print (fct-thought-phase 6 1))
    (print " 6 9=")
    (print (fct-thought-phase 6 9))
    (print " 0 9=")
    (print (fct-thought-phase 0 9))
    (print "\n")
    (print "thought-ask 0=")
    (print (int_to_str (fct-thought-ask 0)))
    (print " 9=")
    (print (int_to_str (fct-thought-ask 9)))
    (print "\n")
    (print "thought-step add 2 3=")
    (print (int_to_str (fct-thought-step (srs-op-add) 2 3)))
    (print " vocab-42=")
    (print (int_to_str (srs-step (srs-token (srs-tok-vocab) 42) 0 0)))
    (print "\n")
    (print "thought-love 4=")
    (print (int_to_str (fct-thought-love 4)))
    (print " source-after=")
    (print (int_to_str (fct-thought-source)))
    (print "\n")
    (print "thought-from-symbol-0-tone=")
    (print (int_to_str (srs-tone (srs-from-symbol 0 20260814))))
    (print "\n")
    (print "thought-check=")
    (print (int_to_str (srs-check)))
    (print "\n")
    0)
