; living-world-recipe-tree-revision-trial.fk -- composition-scoped independent
; trials that do not perturb the historical global revision nursery.
;
; Offers name one exact admitted composition and exact Recipe.  Recurrent offer
; sources must be disjoint from the full tree/trial/prospective/composition
; ancestry.  A trial re-executes both retained placements and the resolved
; prospective cases carried by that composition.  Nothing here activates a
; Recipe, answer, voice, or promotion authority.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk

(let LWRTRT-OFFER              (bp "LWRTRT-OFFER"))
(let LWRTRT-CANDIDATE          (bp "LWRTRT-CANDIDATE"))
(let LWRTRT-CANDIDATE-EVIDENCE (bp "LWRTRT-CANDIDATE-EVIDENCE"))
(let LWRTRT-TRIAL              (bp "LWRTRT-TRIAL"))
(let LWRTRT-FIELD              (bp "LWRTRT-FIELD"))
(let LWRTRT-ORIGIN             (bp "LWRTRT-ORIGIN"))

(defn lwrtrt-construction-sources (world composition)
    (do
        (let blueprint (lwrtr-composition-blueprint composition))
        (lwrtr-union-items
            (lwo-field-items (lwrth-direct-sources world blueprint))
            (lwrtr-ancestor-sources world
                (lwrtr-blueprint-match blueprint)
                (lwrtr-blueprint-suite blueprint)))))

; children: exact composition candidate/composition/Recipe, optional channel
; declarations, evidence, local path.
(defn lwrtrt-offer
    (composition-candidate composition recipe declaration lens alternatives
     unknown choice timeout evidence)
    (intern_node LWRTRT-OFFER
        (list composition-candidate composition recipe declaration lens
              alternatives unknown choice timeout evidence (lwo-local-path))))
(defn lwrtrt-offer? (cell) (lwo-category? cell LWRTRT-OFFER))
(defn lwrtrt-offer-composition-candidate (offer)
    (nth (node_children offer) 0))
(defn lwrtrt-offer-composition (offer) (nth (node_children offer) 1))
(defn lwrtrt-offer-recipe (offer) (nth (node_children offer) 2))
(defn lwrtrt-offer-declaration (offer) (nth (node_children offer) 3))
(defn lwrtrt-offer-lens (offer) (nth (node_children offer) 4))
(defn lwrtrt-offer-alternatives (offer) (nth (node_children offer) 5))
(defn lwrtrt-offer-unknown (offer) (nth (node_children offer) 6))
(defn lwrtrt-offer-choice (offer) (nth (node_children offer) 7))
(defn lwrtrt-offer-timeout (offer) (nth (node_children offer) 8))
(defn lwrtrt-offer-evidence (offer) (nth (node_children offer) 9))

(defn lwrtrt-offer-valid? (offer)
    (if (eq (lwrtrt-offer? offer) 0) 0
        (do
            (let parent (lwrtrt-offer-composition-candidate offer))
            (let composition (lwrtrt-offer-composition offer))
            (if (or (eq (lwrtr-candidate? parent) 0)
                    (or (eq (lwrtr-composition? composition) 0)
                        (or (eq (lwo-field-has?
                                    (lwrtr-field-compatible
                                        (lwo-emergent-shape parent))
                                    composition) 0)
                            (not (node_eq
                                (lwrtrt-offer-recipe offer)
                                (lwrtr-composition-recipe composition))))))
                0
                (if (eq (lwhrn-optional-recipe-valid?
                            (lwrtrt-offer-recipe offer)) 0) 0
                    (if (eq (lwhrn-optional-declaration-valid?
                                (lwrtrt-offer-declaration offer)) 0) 0
                        (if (eq (lwhrn-optional-lens-valid?
                                    (lwrtrt-offer-lens offer)) 0) 0
                            (if (eq (lwo-category?
                                        (lwrtrt-offer-alternatives offer)
                                        LWO-FIELD) 0) 0
                                (if (eq (lwhrn-optional-unknown-valid?
                                            (lwrtrt-offer-unknown offer)) 0) 0
                                    (if (eq (lwlc-choice-valid?
                                                (lwrtrt-offer-choice offer)) 0)
                                        0
                                        (lwhrn-optional-timeout-valid?
                                            (lwrtrt-offer-timeout
                                                offer))))))))))))

; Evidence/source is absent from candidate identity.
(defn lwrtrt-candidate-for-offer (offer)
    (if (eq (lwrtrt-offer-valid? offer) 0) (lwo-none)
        (intern_node LWRTRT-CANDIDATE
            (list (lwrtrt-offer-composition-candidate offer)
                  (lwrtrt-offer-composition offer)
                  (lwrtrt-offer-recipe offer)
                  (lwrtrt-offer-declaration offer)
                  (lwrtrt-offer-lens offer)
                  (lwrtrt-offer-alternatives offer)
                  (lwrtrt-offer-unknown offer)
                  (lwrtrt-offer-choice offer)
                  (lwrtrt-offer-timeout offer) (lwo-local-path)))))
(defn lwrtrt-candidate? (cell) (lwo-category? cell LWRTRT-CANDIDATE))
(defn lwrtrt-candidate-parent (candidate) (nth (node_children candidate) 0))
(defn lwrtrt-candidate-composition (candidate)
    (nth (node_children candidate) 1))
(defn lwrtrt-candidate-recipe (candidate) (nth (node_children candidate) 2))
(defn lwrtrt-candidate-declaration (candidate)
    (nth (node_children candidate) 3))
(defn lwrtrt-candidate-lens (candidate) (nth (node_children candidate) 4))
(defn lwrtrt-candidate-alternatives (candidate)
    (nth (node_children candidate) 5))
(defn lwrtrt-candidate-unknown (candidate) (nth (node_children candidate) 6))
(defn lwrtrt-candidate-choice (candidate) (nth (node_children candidate) 7))
(defn lwrtrt-candidate-timeout (candidate) (nth (node_children candidate) 8))

(defn lwrtrt-offer-current-ready? (world offer parent composition)
    (if (and (eq (lwrtrt-offer-valid? offer) 1)
             (and (node_eq (lwrtrt-offer-composition-candidate offer) parent)
                  (and (node_eq (lwrtrt-offer-composition offer) composition)
                       (eq (lwo-active? world offer) 1)))) 1 0))
(defn lwrtrt-collect-offers-ready
    (world items parent composition field)
    (if (eq (len items) 0) field
        (lwrtrt-collect-offers-ready world (tail items) parent composition
            (if (eq (lwrtrt-offer-current-ready?
                        world (head items) parent composition) 1)
                (lwo-field-add field (head items)) field))))
(defn lwrtrt-offers-for-ready (world parent composition)
    (lwrtrt-collect-offers-ready world
        (lwo-field-items (lwo-world-cells world)) parent composition
        (lwo-empty-field)))

(defn lwrtrt-candidate-evidence (candidate offers witnesses)
    (intern_node LWRTRT-CANDIDATE-EVIDENCE
        (list candidate offers witnesses)))
(defn lwrtrt-evidence-candidate (evidence) (nth (node_children evidence) 0))
(defn lwrtrt-evidence-offers (evidence) (nth (node_children evidence) 1))
(defn lwrtrt-evidence-witnesses (evidence) (nth (node_children evidence) 2))
(defn lwrtrt-candidates-have? (items candidate)
    (if (eq (len items) 0) 0
        (if (node_eq (lwrtrt-evidence-candidate (head items)) candidate) 1
            (lwrtrt-candidates-have? (tail items) candidate))))
(defn lwrtrt-evidence-for-candidate-items
    (world items candidate offers witnesses)
    (if (eq (len items) 0)
        (lwrtrt-candidate-evidence candidate offers witnesses)
        (do
            (let offer (head items))
            (if (node_eq (lwrtrt-candidate-for-offer offer) candidate)
                (lwrtrt-evidence-for-candidate-items world (tail items) candidate
                    (lwo-field-add offers offer)
                    (lwrtr-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world offer)) witnesses))
                (lwrtrt-evidence-for-candidate-items world (tail items) candidate
                    offers witnesses)))))
(defn lwrtrt-collect-candidates (world all remaining field)
    (if (eq (len remaining) 0) field
        (do
            (let candidate (lwrtrt-candidate-for-offer (head remaining)))
            (lwrtrt-collect-candidates world all (tail remaining)
                (if (eq (lwrtrt-candidates-have?
                            (lwo-field-items field) candidate) 1) field
                    (lwo-field-add field
                        (lwrtrt-evidence-for-candidate-items world all candidate
                            (lwo-empty-field) (lwo-empty-field))))))))
(defn lwrtrt-candidates-for (world offers)
    (do
        (let items (lwo-field-items offers))
        (lwrtrt-collect-candidates world items items (lwo-empty-field))))

(defn lwrtrt-evidence-sources (world evidence)
    (lwrth-offer-source-items world
        (lwo-field-items (lwrtrt-evidence-offers evidence))
        (lwo-empty-field)))
(defn lwrtrt-candidate-recurrent? (world evidence threshold)
    (do
        (let candidate (lwrtrt-evidence-candidate evidence))
        (let composition (lwrtrt-candidate-composition candidate))
        (let construction-sources
            (lwrtrt-construction-sources world composition))
        (let trial-sources (lwrtrt-evidence-sources world evidence))
        (if (and (ge (lwo-field-size trial-sources) threshold)
                 (eq (lwrth-fields-disjoint?
                        construction-sources trial-sources) 1)) 1 0)))
(defn lwrtrt-recurrent-items (world items threshold field)
    (if (eq (len items) 0) field
        (lwrtrt-recurrent-items world (tail items) threshold
            (if (eq (lwrtrt-candidate-recurrent?
                        world (head items) threshold) 1)
                (lwo-field-add field (head items)) field))))

; children: candidate evidence, fresh retained evaluations, fresh prospective
; placements/metrics, state, construction/trial source sets, local path.
(defn lwrtrt-trial
    (evidence retained prospective metrics state construction-sources
     trial-sources)
    (intern_node LWRTRT-TRIAL
        (list evidence retained prospective metrics state construction-sources
              trial-sources (lwo-local-path))))
(defn lwrtrt-trial? (cell) (lwo-category? cell LWRTRT-TRIAL))
(defn lwrtrt-trial-evidence (trial) (nth (node_children trial) 0))
(defn lwrtrt-trial-retained (trial) (nth (node_children trial) 1))
(defn lwrtrt-trial-prospective (trial) (nth (node_children trial) 2))
(defn lwrtrt-trial-metrics (trial) (nth (node_children trial) 3))
(defn lwrtrt-trial-state (trial) (nth (node_children trial) 4))
(defn lwrtrt-trial-construction-sources (trial)
    (nth (node_children trial) 5))
(defn lwrtrt-trial-sources (trial) (nth (node_children trial) 6))

(defn lwrtrt-trial-for (world evidence)
    (do
        (let candidate (lwrtrt-evidence-candidate evidence))
        (let parent (lwrtrt-candidate-parent candidate))
        (let composition (lwrtrt-candidate-composition candidate))
        (let recipe (lwrtrt-candidate-recipe candidate))
        (let successor (lwrtr-field-successor (lwo-emergent-shape parent)))
        (let target (lwrtep-target-for successor))
        (let suite
            (lwrtr-blueprint-suite
                (lwrtr-composition-blueprint composition)))
        (let retained
            (lwhrn-evaluations-items recipe
                (lwo-field-items
                    (lwht-tissue-placements (lwo-emergent-shape target)))
                (lwo-empty-field)))
        (let retained-state
            (lwhrn-evaluation-state-items
                (lwo-field-items retained) 0 0 0))
        (let prospective
            (lwrtr-place-case-items
                (lwo-field-items
                    (lwps-dataset-cases (lwps-suite-dataset suite)))
                recipe (lwo-empty-field)))
        (let metrics (lwps-metrics-for prospective))
        (let state
            (if (and (eq (lwph-consistent? retained-state) 1)
                     (and (eq (lwps-metrics-value metrics 2)
                                (lwps-metrics-value metrics 1))
                          (and (eq (lwps-metrics-value metrics 4) 0)
                               (eq (lwps-metrics-value metrics 5) 0))))
                (lwph-consistent) (lwph-divergent)))
        (lwrtrt-trial evidence retained prospective metrics state
            (lwrtrt-construction-sources world composition)
            (lwrtrt-evidence-sources world evidence))))
(defn lwrtrt-trials-items (world items field)
    (if (eq (len items) 0) field
        (lwrtrt-trials-items world (tail items)
            (lwo-field-add field (lwrtrt-trial-for world (head items))))))
(defn lwrtrt-filter-trials (items state field)
    (if (eq (len items) 0) field
        (lwrtrt-filter-trials (tail items) state
            (if (node_eq (lwrtrt-trial-state (head items)) state)
                (lwo-field-add field (head items)) field))))

; children: exact parent/composition, recurrent candidates, all/viable/
; divergent trials, status, alternatives, unknowns, witnesses, threshold/path.
(defn lwrtrt-field-cell
    (parent composition candidates trials viable divergent status alternatives
     unknowns witnesses threshold)
    (intern_node LWRTRT-FIELD
        (list parent composition candidates trials viable divergent status
              alternatives unknowns witnesses (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwrtrt-field? (cell) (lwo-category? cell LWRTRT-FIELD))
(defn lwrtrt-field-parent (field) (nth (node_children field) 0))
(defn lwrtrt-field-composition (field) (nth (node_children field) 1))
(defn lwrtrt-field-candidates (field) (nth (node_children field) 2))
(defn lwrtrt-field-trials (field) (nth (node_children field) 3))
(defn lwrtrt-field-viable (field) (nth (node_children field) 4))
(defn lwrtrt-field-divergent (field) (nth (node_children field) 5))
(defn lwrtrt-field-status (field) (nth (node_children field) 6))
(defn lwrtrt-field-alternatives (field) (nth (node_children field) 7))
(defn lwrtrt-field-unknowns (field) (nth (node_children field) 8))
(defn lwrtrt-field-witnesses (field) (nth (node_children field) 9))
(defn lwrtrt-field-threshold (field)
    (node_value (nth (node_children field) 10)))

(defn lwrtrt-options-items (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (do
            (let candidate (lwrtrt-evidence-candidate (head items)))
            (let unknown (lwrtrt-candidate-unknown candidate))
            (lwrtrt-options-items (tail items)
                (lwrtr-union-items
                    (lwo-field-items
                        (lwrtrt-candidate-alternatives candidate)) alternatives)
                (if (node_eq unknown (lwo-none)) unknowns
                    (lwo-field-add unknowns unknown))))))
(defn lwrtrt-witnesses-items (items field)
    (if (eq (len items) 0) field
        (lwrtrt-witnesses-items (tail items)
            (lwrtr-union-items
                (lwo-field-items
                    (lwrtrt-evidence-witnesses (head items))) field))))
(defn lwrtrt-field-for-ready (world parent composition threshold)
    (do
        (let offers (lwrtrt-offers-for-ready world parent composition))
        (let all (lwrtrt-candidates-for world offers))
        (let candidates
            (lwrtrt-recurrent-items world (lwo-field-items all) threshold
                (lwo-empty-field)))
        (let trials
            (lwrtrt-trials-items world (lwo-field-items candidates)
                (lwo-empty-field)))
        (let viable
            (lwrtrt-filter-trials (lwo-field-items trials)
                (lwph-consistent) (lwo-empty-field)))
        (let divergent
            (lwrtrt-filter-trials (lwo-field-items trials)
                (lwph-divergent) (lwo-empty-field)))
        (let count (lwo-field-size viable))
        (let status
            (if (eq count 1) (lwhrn-ready)
                (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
        (let options
            (lwrtrt-options-items (lwo-field-items candidates)
                (lwrtr-composition-alternatives composition)
                (lwrtr-composition-unknowns composition)))
        (let witnesses
            (lwrtrt-witnesses-items (lwo-field-items candidates)
                (lwrtr-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world parent))
                    (lwo-empty-field))))
        (lwrtrt-field-cell parent composition candidates trials viable divergent
            status (nth options 0)
            (lwo-field-add (nth options 1) (lwlc-unknown trials)) witnesses
            threshold)))
(defn lwrtrt-field-for (world parent composition threshold)
    (if (or (lt threshold 1)
            (or (eq (lwrtr-integrated-current? world parent) 0)
                (eq (lwo-field-has?
                        (lwrtr-field-compatible (lwo-emergent-shape parent))
                        composition) 0)))
        (lwo-none)
        (lwrtrt-field-for-ready world parent composition threshold)))

(defn lwrtrt-origin (parent composition threshold)
    (intern_node LWRTRT-ORIGIN
        (list parent composition (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwrtrt-origin-parent (origin) (nth (node_children origin) 0))
(defn lwrtrt-origin-composition (origin) (nth (node_children origin) 1))
(defn lwrtrt-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwrtrt-proposal-from-field (field)
    (if (or (node_eq field (lwo-none))
            (eq (lwo-field-size (lwrtrt-field-candidates field)) 0))
        (lwo-none)
        (do
            (let witnesses (lwrtrt-field-witnesses field))
            (let origin
                (lwrtrt-origin (lwrtrt-field-parent field)
                    (lwrtrt-field-composition field)
                    (lwrtrt-field-threshold field)))
            (let candidate
                (lwo-emergent field witnesses
                    (intern_trivial_int
                        (lwo-field-size (lwrtrt-field-candidates field)))
                    (intern_trivial_int
                        (lwo-field-size (lwrtrt-field-trials field)))
                    (intern_trivial_int (lwo-field-size witnesses)) origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field)) origin))))
(defn lwrtrt-proposal-for (world parent composition threshold)
    (lwrtrt-proposal-from-field
        (lwrtrt-field-for world parent composition threshold)))
(defn lwrtrt-local-current-ready? (world candidate)
    (do
        (let origin (lwo-emergent-provenance candidate))
        (let fresh
            (lwrtrt-proposal-from-field
                (lwrtrt-field-for-ready world
                    (lwrtrt-origin-parent origin)
                    (lwrtrt-origin-composition origin)
                    (lwrtrt-origin-threshold origin))))
        (if (node_eq fresh (lwo-none)) 0
            (node_eq candidate (lwt-proposal-candidate fresh)))))
(defn lwrtrt-candidate-current? (world candidate)
    (if (or (eq (lwo-category? candidate LWO-EMERGENT) 0)
            (eq (lwrtrt-field?
                    (lwo-emergent-shape candidate)) 0)) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            ; Local revocation closes before the deep parent graph is revisited.
            (if (eq (lwrtrt-local-current-ready? world candidate) 0) 0
                (lwrtr-integrated-current? world
                    (lwrtrt-origin-parent origin))))))
(defn lwrtrt-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrtrt-candidate-current? world candidate) 1)) 1 0))
(defn lwrtrt-integrate (round proposal action)
    (if (eq (lwrtrt-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrtrt-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "candidates:" (int_to_str
                (lwo-field-size (lwrtrt-field-candidates field)))
            ":viable:" (int_to_str
                (lwo-field-size (lwrtrt-field-viable field)))
            ":divergent:" (int_to_str
                (lwo-field-size (lwrtrt-field-divergent field)))))))

; witnessed: 2026-08-09 -> 2147483647 (31/31) on fkwu
