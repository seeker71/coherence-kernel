; form-agent-source-world-model.fk -- a current source hit enters the Form
; agent's world without becoming a mutation claim or replaying source bytes.
;
; The current-answer capability already proves that the strict query result,
; its observation node, held source identity, current source identity and
; scannerless one-lookup trace agree.  This adapter accepts only that contract.
; It projects one compact world entity and offers it through the existing agent
; tool-result shape.  Progress stages remain diagnostics; only the terminal,
; source-bound hit enters the world.
;
; embedding: hit, fresh, rebuild, lookups, executed, model-executed,
;            scannerless, elapsed-ms, injected-bytes
; position:  repository-relative path, current source identity, answer bytes
;
; Read-only retrieval is grounded contribution to the agent's knowledge, but
; it is not a repository mutation.  The two predicates stay separate.
;
; preludes: form-stdlib/runtime-program-image-fkb-current-answer-capability.fk
; preludes: form-stdlib/world-model.fk form-stdlib/form-agent-protocol.fk
; Proven by: form-stdlib/tests/form-agent-source-world-model-band.fk

import "runtime-program-image-fkb-current-answer-capability.fk"
import "world-model.fk"
import "form-agent-protocol.fk"

(do
    (defn faswm-admitted? (result)
        (rpica-hit-contract? result))
    (defn faswm-knowledge-contribution? (result)
        (faswm-admitted? result))
    (defn faswm-mutation-contribution? (result) 0)

    (defn faswm-entity-id (result provenance)
        (str_concat provenance
            (str_concat ":" (fknq-node-key
                (fknq-source-original-of result)))))
    (defn faswm-embedding (result elapsed-ms injected-bytes)
        (list (fknq-hit-count result)
              (fknq-fresh? result)
              (fknq-rebuild? result)
              (fknq-lookup-count result)
              (fknq-executed? result)
              (fknq-model-executed? result)
              (fknq-scannerless? result)
              elapsed-ms injected-bytes))
    (defn faswm-position (result)
        (list (fknq-source-path result)
              (fknq-current-source-id-of result)
              (str_len (fknq-answer result))))
    (defn faswm-entity (result elapsed-ms injected-bytes provenance)
        (if (eq (faswm-admitted? result) 0) (nothing)
            (wm-ent "source-knowledge"
                (faswm-embedding result elapsed-ms injected-bytes)
                (faswm-position result) 1
                (faswm-entity-id result provenance))))
    (defn faswm-world (result elapsed-ms injected-bytes provenance)
        (do
            (let entity (faswm-entity result elapsed-ms injected-bytes provenance))
            (if (nothing? entity) (nothing) (list entity))))
    (defn faswm-world-image (result elapsed-ms injected-bytes provenance)
        (do
            (let world (faswm-world result elapsed-ms injected-bytes provenance))
            (if (nothing? world) (nothing) (wm-model world))))

    (defn faswm-guide (result elapsed-ms injected-bytes provenance)
        (do
            (let world (faswm-world-image result elapsed-ms injected-bytes provenance))
            (if (nothing? world) (nothing)
                (list "form-agent-source-world-guide-v1" world
                    "grounded-hit" "answer-from-current-source"))))
    (defn faswm-guide-world (guide) (nth guide 1))
    (defn faswm-guide-status (guide) (nth guide 2))
    (defn faswm-guide-action (guide) (nth guide 3))
    (defn faswm-agent-message
        (call-id result elapsed-ms injected-bytes provenance)
        (do
            (let guide (faswm-guide result elapsed-ms injected-bytes provenance))
            (if (nothing? guide) (nothing)
                (ap-msg "tool" (list
                    (ap-tool-result call-id "world-model-observe-source"
                        guide))))))
    0)
