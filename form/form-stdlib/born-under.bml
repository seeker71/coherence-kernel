//////////////////////////////////////////////////////////////////////
//
// born-under.bml — a kernel notes the parent it was started under, and
// asks whether that parent is still its parent.
//
// The glass carrier starts its organs with host_spawn_quiet and ends them
// in fgr-end, which a carrier ended by a signal never reaches. On
// 2026-09-11 three organs of a fleet a Codex session had started, and then
// ended with `kill -TERM` on the carrier, had run five hours under pid 1:
// nobody waiting for them, one at a quarter of a core, one a second reader
// of the accelerator gauge that is consumed on read. No organ asked whether
// its carrier lived. Each asks now, every two seconds.
//
// The parent is read once, at birth, from the host's own process table
// (host_processes' sixth field), so the question later is one comparison
// and a reused pid cannot answer for a dead carrier. A kernel born under
// pid 1 (launchd) is supervised there and always held; so is one whose row
// cannot be read, then or now — an unread table is not an ended parent.
// The birth read has to come before the parent can end: a child whose
// parent ended before it asked reads pid 1, and is held for good.
//
// preludes: form/form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class BornUnder {
        def bun-parent-in(rows, me) = if nil?(rows) then sub(0, 1) else if eq(head(head(rows)), me) then nth(head(rows), 5) else bun-parent-in(tail(rows), me);
        // the parent this kernel runs under now; -1 when its row cannot be read
        def bun-parent() = bun-parent-in(host_processes("fkwu"), host_pid());
        // 1 held, 0 the parent it was born under is no longer its parent
        def bun-held-by(now, born) = if le(born, 1) then 1 else if lt(now, 0) then 1 else if eq(now, born) then 1 else 0;
        def bun-held?(born) = bun-held-by(bun-parent(), born);
    }
    0;
}
