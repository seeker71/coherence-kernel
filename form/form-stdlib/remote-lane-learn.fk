; remote-lane-learn.fk — learn from the remote share lane as status, not prose.
;
; Remote events are turn_started counts in the bound Grok session. They are
; this rented voice. Session-learning trains Llama 3B from explicit local
; corrections; it does not intercept host model calls or ingest transcripts.
; Learning from remote=5 is interned status: the remainder to shrink, folded,
; offered with no how and no prompt bytes.
;
; preludes: form-stdlib/core.fk form-stdlib/nine-fold.fk form-stdlib/walk-home.fk
; witnessed: 2026-09-10 -> remote-lane-learn-band 15

(do
    (defn rll-identity () "remote-share-lane")
    (defn rll-fold (remote) (nf-fold remote))
    (defn rll-offer (remote)
        (wh-contribution "ourselves" "offering" (rll-identity)))
    (defn rll-transcript? (offer)
        (if (eq (len offer) 3) 0 1))
    (defn rll-read (native local remote)
        (list (nf-read native local remote)
              (rll-fold remote)
              (rll-offer remote)
              (rll-transcript? (rll-offer remote))))
    0)
