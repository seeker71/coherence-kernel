//////////////////////////////////////////////////////////////////////
//
// form-glass-observer.bml — executable whole-body observation rows.
//
// Authority: form-stdlib/bml/form-glass-observer.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassObserverAuthority {
        field FGOAuthorityPath = "form/form-stdlib/bml/form-glass-observer.bml";
        field FGOAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassObserver {
        field FGOSchema = "form-glass-observer-v2";
        field FGOEvent = "FORM-GLASS-OBSERVATION-V1";
        field FGOProjectionEvent = "FORM-GLASS-METRIC-FIELD-V2";
        field FGOValueEvent = "form-glass-value-event-v2";

        ref fgo-authority = FormGlassObserverAuthority;
        thought fgo-law = list("presence-before-value", "planes-never-collapse", "process-local-is-named", "bounded-process-no-argv", "storage-is-not-residence", "observer-tax-is-visible");

        // metric: tag, domain, id, label, value kind, int value, text value,
        // present, unit, capacity, capacity present, heat, age, memory plane,
        // evidence, source, lifecycle, channel, note, stable field NodeID,
        // observed epoch, and observation sequence.  The NodeID identifies the
        // field, never a reading of the field: values and time live in the
        // melt-managed row/event record so a changing counter cannot grow the
        // permanent NodeID arena.
        def fgo-metric(domain, id, label, valueKind, intValue, textValue, present, unit, capacity, capacityPresent, heat, age, plane, evidence, source, lifecycle, channel, note) {
            let truthClass = if str_eq(evidence, "observed") then if str_eq(lifecycle, "stored") then "catalog" else "physical-live" else evidence;
            let projection = intern_node_at(bp(FGOProjectionEvent()), list(intern_trivial_string("glass.monitor"), intern_trivial_string(domain), intern_trivial_string(id), intern_trivial_string(valueKind), intern_trivial_string(unit), intern_trivial_string(plane), intern_trivial_string(channel)), "form/form-stdlib/form-glass-observer.bml", 1, 1);
            list("form-glass-metric-v2", domain, id, label, valueKind, intValue, textValue, present, unit, capacity, capacityPresent, heat, age, plane, truthClass, source, lifecycle, channel, note, projection, -1, -1);
        }
        def fgo-domain(row) = nth(row, 1);
        def fgo-id(row) = nth(row, 2);
        def fgo-label(row) = nth(row, 3);
        def fgo-value-kind(row) = nth(row, 4);
        def fgo-int-value(row) = nth(row, 5);
        def fgo-text-value(row) = nth(row, 6);
        def fgo-present?(row) = nth(row, 7);
        def fgo-unit(row) = nth(row, 8);
        def fgo-capacity(row) = nth(row, 9);
        def fgo-capacity-present?(row) = nth(row, 10);
        def fgo-heat(row) = nth(row, 11);
        def fgo-age(row) = nth(row, 12);
        def fgo-plane(row) = nth(row, 13);
        def fgo-evidence(row) = nth(row, 14);
        def fgo-source(row) = nth(row, 15);
        def fgo-lifecycle(row) = nth(row, 16);
        def fgo-channel(row) = nth(row, 17);
        def fgo-note(row) = nth(row, 18);

        def fgo-int(domain, id, label, value, unit, heat, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "int", value, "", 1, unit, 0, 0, heat, 0, plane, evidence, source, lifecycle, channel, note);
        }
        def fgo-sized(domain, id, label, value, unit, capacity, heat, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "int", value, "", 1, unit, capacity, 1, heat, 0, plane, evidence, source, lifecycle, channel, note);
        }
        def fgo-text(domain, id, label, value, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "text", 0, value, 1, "", 0, 0, 0, 0, plane, evidence, source, lifecycle, channel, note);
        }
        def fgo-whitespace-byte?(byte) = if eq(byte, 32) then 1 else if eq(byte, 9) then 1 else if eq(byte, 10) then 1 else if eq(byte, 13) then 1 else 0;
        def fgo-blank-text-at?(value, index) = if ge(index, str_len(value)) then 1 else if eq(fgo-whitespace-byte?(str_byte_at(value, index)), 1) then fgo-blank-text-at?(value, add(index, 1)) else 0;
        def fgo-text-or-unavailable(domain, id, label, value, plane, evidence, source, lifecycle, channel, note) = if eq(fgo-blank-text-at?(value, 0), 1) then fgo-unavailable(domain, id, label, "text", plane, source, channel, note) else fgo-text(domain, id, label, value, plane, evidence, source, lifecycle, channel, note);
        // On an unavailable row `source` is the exact missing observation
        // door, never a generic "missing carrier" bucket.  This keeps the v1
        // metric stream compatible while giving every question mark a place
        // that can actually be built or instrumented.
        def fgo-unavailable(domain, id, label, unit, plane, missingDoor, channel, reason) {
            fgo-metric(domain, id, label, "absent", 0, "", 0, unit, 0, 0, 0, -1, plane, "unavailable", missingDoor, "unknown", channel, reason);
        }
        // Every local metric value has a real Glass-owned observation node.
        // That projection identity is deliberately separate from the external
        // producer NodeID, which remains unbound unless the framebuffer row
        // carries the actual source node object.
        def fgo-projection-node(row) = if lt(len(row), 20) then nothing() else nth(row, 19);
        def fgo-nodeid-bound?(row) = if nothing?(fgo-projection-node(row)) then 0 else 1;
        def fgo-nodeid-state(row) = if eq(fgo-nodeid-bound?(row), 1) then "bound-glass-projection" else "unbound";
        def fgo-nodeid-value(row) = if eq(fgo-nodeid-bound?(row), 1) then fgo-node-id(fgo-projection-node(row)) else "";
        def fgo-nodeid-door(row) = if eq(fgo-nodeid-bound?(row), 1) then "glass.metric-projection" else "telemetry.nodeid-owner-binding";
        def fgo-observed-epoch(row) = if lt(len(row), 21) then -1 else nth(row, 20);
        def fgo-observation-sequence(row) = if lt(len(row), 22) then -1 else nth(row, 21);
        def fgo-source-node(row) = if lt(len(row), 23) then nothing() else nth(row, 22);
        def fgo-source-nodeid-bound?(row) = if nothing?(fgo-source-node(row)) then 0 else 1;
        def fgo-source-nodeid-value(row) = if eq(fgo-source-nodeid-bound?(row), 1) then fgo-node-id(fgo-source-node(row)) else "";
        def fgo-source-nodeid-door(row) = if eq(fgo-source-nodeid-bound?(row), 1) then "framebuffer.interned-node" else "telemetry.nodeid-owner-binding";

        // Re-materialize the value record while retaining the stable field
        // NodeID and any real source node.  These are ordinary Form lists and
        // therefore travel through the existing melt-managed arena.
        def fgo-row-at(row, age, observedEpoch, sequence) {
            let base = list("form-glass-metric-v2", fgo-domain(row), fgo-id(row), fgo-label(row), fgo-value-kind(row), fgo-int-value(row), fgo-text-value(row), fgo-present?(row), fgo-unit(row), fgo-capacity(row), fgo-capacity-present?(row), fgo-heat(row), age, fgo-plane(row), fgo-evidence(row), fgo-source(row), fgo-lifecycle(row), fgo-channel(row), fgo-note(row), fgo-projection-node(row), observedEpoch, sequence);
            if eq(fgo-source-nodeid-bound?(row), 1) then append(base, list(fgo-source-node(row))) else base;
        }
        def fgo-observe-row(row, observedEpoch, sequence) = if eq(fgo-present?(row), 0) then fgo-row-at(row, -1, -1, sequence) else fgo-row-at(row, 0, observedEpoch, sequence);
        def fgo-observe-rows(rows, observedEpoch, sequence) = if eq(len(rows), 0) then list() else cons(fgo-observe-row(head(rows), observedEpoch, sequence), fgo-observe-rows(tail(rows), observedEpoch, sequence));
        def fgo-age-at(row, epoch) = if or(eq(fgo-present?(row), 0), lt(fgo-observed-epoch(row), 0)) then -1 else if ge(epoch, fgo-observed-epoch(row)) then sub(epoch, fgo-observed-epoch(row)) else -2;
        def fgo-age-row-at(row, epoch) = fgo-row-at(row, fgo-age-at(row, epoch), fgo-observed-epoch(row), fgo-observation-sequence(row));
        def fgo-age-rows-at(rows, epoch) = if eq(len(rows), 0) then list() else cons(fgo-age-row-at(head(rows), epoch), fgo-age-rows-at(tail(rows), epoch));
        def fgo-value-event(row) = list(FGOValueEvent(), fgo-projection-node(row), fgo-observed-epoch(row), fgo-observation-sequence(row), fgo-value-kind(row), fgo-int-value(row), fgo-text-value(row), fgo-present?(row), fgo-capacity(row), fgo-capacity-present?(row), fgo-heat(row), fgo-evidence(row), fgo-lifecycle(row), fgo-source(row), fgo-note(row), fgo-source-node(row));

        def fgo-status-start(status, name) {
            let key = str_concat(name, "=");
            let laterKey = str_concat("\n", key);
            let atFirst = str_find(status, key, 0);
            let atLater = str_find(status, laterKey, 0);
            if eq(atFirst, 0) then str_len(key) else if lt(atLater, 0) then -1 else add(atLater, str_len(laterKey));
        }
        def fgo-status-text(status, name) {
            let start = fgo-status-start(status, name);
            if lt(start, 0) then "" else fgo-status-text-found(status, start);
        }
        def fgo-status-text-found(status, start) {
            let stop = str_find(status, "\n", start);
            if lt(stop, 0) then substring(status, start, str_len(status)) else substring(status, start, stop);
        }
        def fgo-status-int(status, name) {
            let value = fgo-status-text(status, name);
            if eq(str_len(value), 0) then -1 else str_to_int(value);
        }
        def fgo-status-int-row(domain, id, label, status, field, unit, plane, source, channel, note) {
            let value = fgo-status-int(status, field);
            if lt(value, 0) then fgo-unavailable(domain, id, label, unit, plane, str_concat(source, str_concat(".", field)), channel, note) else fgo-int(domain, id, label, value, unit, value, plane, "physical-live", source, "live", channel, note);
        }
        def fgo-status-semantic-row(domain, id, label, status, field, unit, plane, source, channel, zeroState, zeroNote, activeNote) {
            let value = fgo-status-int(status, field);
            if lt(value, 0) then fgo-unavailable(domain, id, label, unit, plane, str_concat(source, str_concat(".", field)), channel, activeNote) else if eq(value, 0) then fgo-int(domain, id, label, value, unit, 0, plane, "physical-live", source, zeroState, channel, zeroNote) else fgo-int(domain, id, label, value, unit, value, plane, "physical-live", source, "live", channel, activeNote);
        }

        def fgo-kernel-rows() {
            let cells = kernel_stat(4);
            let strings = kernel_stat(5);
            let floats = kernel_stat(8);
            list(
                fgo-int("kernel", "dispatch-total", "primitive dispatches", kernel_stat(0), "calls", kernel_stat(0), "cpu-arena", "physical-live", "kernel_stat:0", "live", "kernel", "current fkwu process"),
                fgo-int("kernel", "dispatch-distinct", "distinct primitives", kernel_stat(1), "tags", kernel_stat(1), "cpu-arena", "physical-live", "kernel_stat:1", "live", "kernel", "current fkwu process"),
                fgo-int("kernel", "hottest-tag", "hottest primitive tag", kernel_stat(2), "tag", kernel_stat(3), "cpu-arena", "physical-live", "kernel_stat:2", "live", "primitive", "observer may become hot"),
                fgo-int("kernel", "hottest-count", "hottest primitive calls", kernel_stat(3), "calls", kernel_stat(3), "cpu-arena", "physical-live", "kernel_stat:3", "live", "primitive", "current fkwu process"),
                fgo-int("memory", "cells", "runtime NodeIDs (this Glass)", cells, "nodes", cells, "cpu-arena", "physical-live", "kernel_stat:4", if eq(cells, 0) then "empty" else "resident", "cell", if eq(cells, 0) then "semantic-zero=empty; current Glass process has minted no NodeIDs; not BML, AST, catalog, or model-process absence; bytes unavailable" else "current Glass process interned NodeID count; bytes unavailable"),
                fgo-int("memory", "strings", "interned strings", strings, "strings", strings, "cpu-arena", "physical-live", "kernel_stat:5", "resident", "string", "current Glass process string count; bytes unavailable; temporal growth and selfmolt threshold are separate live rows; missing door=kernel.ephemeral-render-string"),
                fgo-int("memory", "cons", "arena cons cells", kernel_stat(6), "cons", kernel_stat(6), "cpu-arena", "physical-live", "kernel_stat:6", "resident", "list", "arena pointer; not bytes"),
                fgo-int("memory", "value-stack", "value stack depth", kernel_stat(7), "values", kernel_stat(7), "cpu-stack", "physical-live", "kernel_stat:7", "live", "stack", "current depth; high-water unavailable"),
                fgo-int("memory", "floats", "float values", floats, "values", floats, "cpu-arena", "physical-live", "kernel_stat:8", if eq(floats, 0) then "empty" else "resident", "float", if eq(floats, 0) then "semantic-zero=empty; current Glass process boxed-float pool has no values; bytes unavailable" else "current Glass process boxed-float count; bytes unavailable"),
                fgo-unavailable("memory", "blueprint-bytes", "blueprint allocation bytes", "bytes", "unknown", "kernel.blueprint-byte-ledger", "blueprint", "kernel exposes NodeID structure but no per-blueprint allocation byte ledger"),
                fgo-unavailable("memory", "recipe-bytes", "recipe allocation bytes", "bytes", "unknown", "kernel.recipe-byte-ledger", "recipe", "recipe count and byte ownership are not separately exposed"),
                fgo-unavailable("memory", "cell-bytes", "per-cell allocation bytes", "bytes", "unknown", "kernel.cell-byte-ledger", "cell", "cell shape is inspectable for framebuffer roots; allocation bytes are not"));
        }

        def fgo-event-attributed?(node) = if eq(len(node_source(node)), 0) then 0 else 1;
        def fgo-count-attributed(events) = if eq(len(events), 0) then 0 else add(fgo-event-attributed?(head(events)), fgo-count-attributed(tail(events)));
        def fgo-framebuffer-count-row(id, label, value, emptyNote, liveNote) = fgo-int("framebuffer", id, label, value, "roots", value, "cpu-arena", "physical-live", "framebuffer-events", if eq(value, 0) then "empty" else "live", "framebuffer", if eq(value, 0) then emptyNote else liveNote);
        def fgo-framebuffer-rows(events) {
            let count = len(events);
            let attributed = fgo-count-attributed(events);
            list(
                fgo-framebuffer-count-row("events", "event roots", count, "semantic-zero=empty; bounded current-process framebuffer event list contains no roots", "bounded current-process framebuffer roots"),
                fgo-framebuffer-count-row("roots", "visible roots", count, "semantic-zero=empty; framebuffer-events currently holds no roots", "visible registered roots from framebuffer-events; kernel_stat:9 remains a separate table-walker door"),
                fgo-framebuffer-count-row("attributed", "source-attributed roots", attributed, "semantic-zero=empty; no visible root currently carries a source node", "visible roots whose node_source is nonempty"),
                fgo-unavailable("framebuffer", "rejected", "rejected roots", "roots", "cpu-arena", "fkc-table-serialize.kernel_stat:11", "framebuffer", "rejected roots never enter framebuffer-events; the table-walker counter remains the missing door"),
                fgo-framebuffer-count-row("entered", "entered roots", count, "semantic-zero=empty; no root has entered the current-process event list", "visible roots that entered framebuffer-events this process"),
                fgo-framebuffer-count-row("accepted", "accepted roots", count, "semantic-zero=empty; no accepted root is currently visible", "visible accepted roots from framebuffer-events; this is the Glass F-stage count"),
                fgo-int("framebuffer", "last-index", "last root index", if eq(count, 0) then 0 else sub(count, 1), "index", if eq(count, 0) then 0 else sub(count, 1), "cpu-arena", "physical-live", "framebuffer-events", if eq(count, 0) then "empty" else "live", "framebuffer", if eq(count, 0) then "semantic-zero=empty; no last index while the event list is empty" else "index of the newest visible framebuffer-events root"));
        }

        def fgo-node-id(node) {
            str_concat("@", str_concat(int_to_str(node_pkg(node)), str_concat(".", str_concat(int_to_str(node_level(node)), str_concat(".", str_concat(int_to_str(node_type(node)), str_concat(".", int_to_str(node_inst(node)))))))));
        }
        def fgo-event-row(node) {
            let source = node_source(node);
            let sourceText = if eq(len(source), 0) then "unattributed" else nth(source, 0);
            append(fgo-sized("cell", fgo-node-id(node), "framebuffer cell shape", len(node_children(node)), "children", node_level(node), len(node_children(node)), "cpu-arena", "physical-live", sourceText, "live", "cell", str_concat("type=", int_to_str(node_type(node)))), list(node));
        }
        def fgo-event-rows-go(events, remaining) {
            if or(eq(len(events), 0), le(remaining, 0)) then list() else cons(fgo-event-row(head(events)), fgo-event-rows-go(tail(events), sub(remaining, 1)));
        }
        def fgo-event-rows(events) = fgo-event-rows-go(events, 8);

        def fgo-metal-rows(status) {
            list(
                fgo-text-or-unavailable("metal", "device", "Metal device", fgo-status-text(status, "device"), "unified-gpu", "physical-live", "metal_status.device", "live", "metal", "current fkwu process"),
                fgo-status-semantic-row("metal", "buffers", "Glass Metal buffers", status, "buffers", "handles", "unified-gpu", "metal_status", "metal", "empty", "semantic-zero=empty; this Glass process owns no Metal buffer handles", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "mapped", "Glass mmap buffers", status, "mmap_nocopy_buffers", "handles", "mapped-file", "metal_status", "metal", "empty", "semantic-zero=empty; this Glass process owns no mmap no-copy buffers", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "pipelines", "Glass Metal pipelines", status, "pipelines", "handles", "unified-gpu", "metal_status", "metal", "empty", "semantic-zero=empty; this Glass process owns no Metal pipelines", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "dispatch", "Glass Metal dispatches", status, "total_dispatch", "dispatches", "unified-gpu", "metal_status", "metal", "idle", "semantic-zero=idle; this Glass process has submitted no Metal dispatch", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "inflight", "Glass Metal in-flight batches", status, "in_flight", "batches", "unified-gpu", "metal_status", "metal", "idle", "semantic-zero=idle; this Glass process has no Metal batch in flight", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "sync", "Glass Metal syncs", status, "total_sync", "syncs", "unified-gpu", "metal_status", "metal", "idle", "semantic-zero=idle; this Glass process has performed no Metal synchronization", "scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "gpu-busy", "Glass GPU busy", status, "gpu_busy_us_total", "microseconds", "unified-gpu", "metal_status", "metal", "idle", "semantic-zero=idle; this Glass process recorded no command-buffer GPU time", "device command-buffer time; scope=glass.monitor process"),
                fgo-status-semantic-row("metal", "cpu-jit-busy", "Glass CPU JIT time", status, "cpu_jit_busy_us_total", "microseconds", "cpu-arena", "metal_status", "jit", "idle", "semantic-zero=idle; this Glass process recorded no CPU JIT dispatch time", "scope=glass.monitor process"),
                fgo-text-or-unavailable("health", "metal-error", "Metal last error", fgo-status-text(status, "last_error"), "unified-gpu", "physical-live", "metal_status.last_error", "live", "health", "none means carrier reported none"),
                fgo-unavailable("metal", "allocated-bytes", "Metal allocated bytes", "bytes", "unified-gpu", "metal_status.allocated_bytes", "metal", "current carrier exposes handle counts, not per-buffer bytes"),
                fgo-unavailable("metal", "working-set", "Metal recommended working set", "bytes", "unified-gpu", "metal_status.recommended_max_working_set_bytes", "metal", "recommendedMaxWorkingSetSize is not exposed"));
        }

        def fgo-mlx-rows(status) {
            list(
                fgo-text-or-unavailable("mlx", "device", "MLX device", fgo-status-text(status, "mlx_device"), "unified-gpu", "physical-live", "mlx_status.mlx_device", "live", "mlx", "current process"),
                fgo-text-or-unavailable("mlx", "version", "MLX version", fgo-status-text(status, "mlx_version"), "disk-cache", "physical-live", "mlx_status.mlx_version", "loaded", "mlx", "linked library version"),
                fgo-status-semantic-row("mlx", "ops", "Glass MLX ops", status, "mlx_ops", "ops", "unified-gpu", "mlx_status", "mlx", "empty", "semantic-zero=empty; this Glass process exposes no MLX operations", "available carrier operations; scope=glass.monitor process"),
                fgo-status-semantic-row("mlx", "dispatch", "Glass MLX dispatches", status, "mlx_dispatch", "dispatches", "unified-gpu", "mlx_status", "mlx", "idle", "semantic-zero=idle; this Glass process has issued no MLX dispatch", "scope=glass.monitor process"),
                fgo-text-or-unavailable("health", "mlx-error", "MLX last error", fgo-status-text(status, "last_error"), "unified-gpu", "physical-live", "mlx_status.last_error", "live", "health", "none means carrier reported none"),
                fgo-unavailable("mlx", "allocated-bytes", "MLX allocated bytes", "bytes", "unified-gpu", "mlx_status.allocated_bytes", "mlx", "MLX carrier does not expose allocator bytes"));
        }

        def fgo-colon-skip-space(text, index) = if ge(index, str_len(text)) then index else if eq(fgo-ps-space?(str_byte_at(text, index)), 1) then fgo-colon-skip-space(text, add(index, 1)) else index;
        def fgo-colon-digits-end(text, index) = if ge(index, str_len(text)) then index else if and(ge(str_byte_at(text, index), 48), le(str_byte_at(text, index), 57)) then fgo-colon-digits-end(text, add(index, 1)) else index;
        def fgo-colon-int(status, key) {
            let at = str_find(status, key, 0);
            if lt(at, 0) then -1 else fgo-colon-int-at(status, fgo-colon-skip-space(status, add(at, str_len(key))));
        }
        def fgo-colon-int-at(status, start) {
            let stop = fgo-colon-digits-end(status, start);
            if le(stop, start) then -1 else str_to_int(substring(status, start, stop));
        }
        // ---- host memory: Mach vm_statistics64 read in-process (host_vm_stat) -- no memory_pressure, no vm_stat ----
        // list(page, memsize, free, active, inactive, wired, speculative, purgeable, compressor, pageins, pageouts, compressions, decompressions, swapins, swapouts, external, internal)
        def fgo-vm-valid?(vm) = if lt(len(vm), 17) then 0 else if le(nth(vm, 0), 0) then 0 else if le(nth(vm, 1), 0) then 0 else 1;
        def fgo-vm-used-bytes(vm) = mul(add(nth(vm, 5), add(nth(vm, 3), nth(vm, 8))), nth(vm, 0));
        def fgo-host-free-percent(vm) = if eq(fgo-vm-valid?(vm), 0) then -1 else sub(100, div(mul(fgo-vm-used-bytes(vm), 100), nth(vm, 1)));
        def fgo-host-total-bytes(vm) = if eq(fgo-vm-valid?(vm), 0) then -1 else nth(vm, 1);
        def fgo-vm-count-row(id, label, value, source, note) = if lt(value, 0) then fgo-unavailable("host", id, label, "pages", "os-memory", source, "health", "the Mach VM statistics door did not answer") else fgo-int("host", id, label, value, "pages", value, "os-memory", "physical-live", source, "live", "health", note);
        def fgo-vmstat-rows(vm) = if eq(fgo-vm-valid?(vm), 0) then list(fgo-vm-count-row("pageins", "Mach pageins", -1, "mach.vm_statistics64.pageins", "")) else list(fgo-vm-count-row("pageins", "Mach pageins", nth(vm, 9), "mach.vm_statistics64.pageins", "cumulative since boot; the delta row is what moves"), fgo-vm-count-row("compressions", "compressor puts", nth(vm, 11), "mach.vm_statistics64.compressions", "cumulative since boot"), fgo-vm-count-row("decompressions", "compressor gets", nth(vm, 12), "mach.vm_statistics64.decompressions", "cumulative since boot"), fgo-vm-count-row("file-backed-pages", "file-backed pages", nth(vm, 15), "mach.vm_statistics64.external_page_count", "resident pages backed by files"), fgo-vm-count-row("compressor-pages", "compressor occupancy", nth(vm, 8), "mach.vm_statistics64.compressor_page_count", "pages held by the compressor"));
        // ---- host load: getloadavg, thousandths kept as tenths ----
        def fgo-loadavg-row(id, label, thousandths) = if lt(thousandths, 0) then fgo-unavailable("host", id, label, "tenths", "cpu-scheduler", "getloadavg", "cpu", "the load average door did not answer") else fgo-int("host", id, label, div(thousandths, 100), "tenths", div(thousandths, 100), "cpu-scheduler", "physical-live", "getloadavg", "live", "cpu", "run-queue length averaged by the kernel, in tenths");
        def fgo-loadavg-rows(load) = if lt(len(load), 3) then list(fgo-loadavg-row("load-1", "load average 1m", -1)) else list(fgo-loadavg-row("load-1", "load average 1m", nth(load, 0)), fgo-loadavg-row("load-5", "load average 5m", nth(load, 1)), fgo-loadavg-row("load-15", "load average 15m", nth(load, 2)));
        // ---- host disk: every IOBlockStorageDriver's cumulative statistics; a rate is the reader's own delta ----
        def fgo-disk-count-row(id, label, value, unit, note) = fgo-int("host", id, label, value, unit, 0, "disk", "physical-live", "IOBlockStorageDriver.Statistics", "live", "health", note);
        def fgo-disk-rows(disk) = if lt(len(disk), 4) then list(fgo-unavailable("host", "disk-bytes-read", "disk bytes read", "bytes", "disk", "IOBlockStorageDriver.Statistics", "health", "no block storage driver answered")) else list(fgo-disk-count-row("disk-bytes-read", "disk bytes read", nth(disk, 0), "bytes", "cumulative since boot over every block storage driver"), fgo-disk-count-row("disk-bytes-written", "disk bytes written", nth(disk, 1), "bytes", "cumulative since boot over every block storage driver"), fgo-disk-count-row("disk-ops", "disk operations", add(nth(disk, 2), nth(disk, 3)), "ops", "reads + writes, cumulative since boot"));
        def fgo-host-rows(vm) {
            let free = fgo-host-free-percent(vm);
            let total = fgo-host-total-bytes(vm);
            append(list(if lt(free, 0) then fgo-unavailable("host", "memory-free", "system memory free", "percent", "os-memory", "mach.host_statistics64.vm_statistics64", "health", "the Mach VM statistics door did not answer") else fgo-sized("host", "memory-free", "system memory free", free, "percent", 100, sub(100, free), "os-memory", "physical-live", "mach.host_statistics64: 100 - (wired+active+compressor)/memsize", "live", "health", "free = memory the host can hand out without reclaim; wired, active and compressed pages count as used"), if lt(total, 0) then fgo-unavailable("host", "memory-total", "physical memory", "bytes", "os-memory", "sysctl.hw.memsize", "health", "the memsize door did not answer") else fgo-int("host", "memory-total", "physical memory", total, "bytes", 0, "os-memory", "physical-live", "sysctl.hw.memsize", "live", "health", "system-wide physical bytes")), append(fgo-loadavg-rows(host_load_avg()), append(fgo-vmstat-rows(vm), fgo-disk-rows(host_disk_stat()))));
        }
        // ---- processes: libproc, no ps, no pgrep -- tuples (pid, rss bytes, cpu microseconds, elapsed seconds) ----
        def fgo-processes-from(tuples, remaining) = if or(eq(len(tuples), 0), le(remaining, 0)) then list() else if lt(len(head(tuples)), 4) then fgo-processes-from(tail(tuples), remaining) else cons(append(fgo-ps-process(nth(head(tuples), 0), nth(head(tuples), 1), nth(head(tuples), 2), nth(head(tuples), 3)), list(if ge(len(head(tuples)), 5) then nth(head(tuples), 4) else 0)), fgo-processes-from(tail(tuples), sub(remaining, 1)));
        def fgo-fkwu-processes() = fgo-processes-from(host_processes("fkwu"), fgo-ps-max-processes());
        def fgo-process-by-pid(processes, pid) = if eq(len(processes), 0) then list() else if eq(fgo-ps-pid(head(processes)), pid) then head(processes) else fgo-process-by-pid(tail(processes), pid);
        def fgo-process-read(pid) = fgo-process-by-pid(fgo-fkwu-processes(), pid);
        def fgo-process-metrics(process) {
            let processLabel = str_concat("fkwu ", int_to_str(fgo-ps-pid(process)));
            let rss = fgo-int("process", fgo-process-id(process, "rss"), str_concat(processLabel, " RSS"), fgo-ps-rss-bytes(process), "bytes", fgo-ps-rss-bytes(process), "os-memory", "physical-live", "libproc.proc_pidinfo.task.resident_size", "live", "process", "resident bytes of one fkwu process");
            let cpu = fgo-int("process", fgo-process-id(process, "cpu"), str_concat(processLabel, " CPU"), fgo-ps-cpu(process), "microseconds", fgo-ps-cpu(process), "cpu-scheduler", "physical-live", "libproc.proc_pidinfo.task.total_user+system", if eq(fgo-ps-cpu(process), 0) then "quiet" else "live", "process", "user + system time since start; a rate is the reader's delta");
            let elapsed = fgo-int("process", fgo-process-id(process, "elapsed"), str_concat(processLabel, " elapsed"), fgo-ps-elapsed(process), "seconds", 0, "process-time", "physical-live", "libproc.proc_pidinfo.bsd.start", "live", "process", "elapsed since process start");
            list(rss, cpu, elapsed);
        }
        def fgo-process-rows(tuples) = fgo-process-rows-from(fgo-processes-from(tuples, fgo-ps-max-processes()));
        def fgo-live-process-rows() = fgo-process-rows-from(fgo-fkwu-processes());

        // executable name, not argv.  The local command token is consumed only
        def fgo-ps-max-processes() = 32;
        def fgo-ps-space?(byte) = if eq(byte, 32) then 1 else if eq(byte, 9) then 1 else 0;
        def fgo-ps-skip-space(text, index) = if ge(index, str_len(text)) then index else if eq(fgo-ps-space?(str_byte_at(text, index)), 1) then fgo-ps-skip-space(text, add(index, 1)) else index;
        def fgo-ps-token-end(text, index) = if ge(index, str_len(text)) then index else if eq(fgo-ps-space?(str_byte_at(text, index)), 1) then index else fgo-ps-token-end(text, add(index, 1));
        def fgo-ps-token(text, index) {
            let start = fgo-ps-skip-space(text, index);
            let stop = fgo-ps-token-end(text, start);
            list(substring(text, start, stop), stop);
        }
        def fgo-ps-rtrim(text, end) = if le(end, 0) then 0 else if eq(fgo-ps-space?(str_byte_at(text, sub(end, 1))), 1) then fgo-ps-rtrim(text, sub(end, 1)) else end;
        def fgo-ps-digits?(text, index) = if ge(index, str_len(text)) then 1 else if and(ge(str_byte_at(text, index), 48), le(str_byte_at(text, index), 57)) then fgo-ps-digits?(text, add(index, 1)) else 0;
        def fgo-ps-uint?(text) = if lt(str_len(text), 1) then 0 else if gt(str_len(text), 19) then 0 else if not(eq(fgo-ps-digits?(text, 0), 1)) then 0 else if and(gt(str_len(text), 1), eq(str_byte_at(text, 0), 48)) then 0 else str_eq(int_to_str(str_to_int(text)), text);
        def fgo-ps-decimal?(text) = if lt(str_len(text), 1) then 0 else if gt(str_len(text), 10) then 0 else fgo-ps-digits?(text, 0);
        def fgo-ps-command-fkwu?(command) = if str_eq(command, "fkwu") then 1 else if lt(str_len(command), 5) then 0 else str_eq(substring(command, sub(str_len(command), 5), str_len(command)), "/fkwu");
        // process: tag, pid, RSS bytes, CPU tenths-percent, elapsed seconds.
        def fgo-ps-process(pid, rssBytes, cpuTenths, elapsedSeconds) = list("fgo-ps-process-v1", pid, rssBytes, cpuTenths, elapsedSeconds);
        def fgo-ps-pid(process) = nth(process, 1);
        def fgo-ps-rss-bytes(process) = nth(process, 2);
        def fgo-ps-cpu(process) = nth(process, 3);
        def fgo-ps-elapsed(process) = nth(process, 4);
        def fgo-ps-nice(process) = if lt(len(process), 6) then -1 else nth(process, 5);
        def fgo-process-id(process, suffix) = str_concat("fkwu-", str_concat(int_to_str(fgo-ps-pid(process)), str_concat("-", suffix)));
        def fgo-process-rows-from(processes) = if eq(len(processes), 0) then list() else append(fgo-process-metrics(head(processes)), fgo-process-rows-from(tail(processes)));

        def fgo-tag-name(tag) {
            if eq(tag, 1) then "int-literal" else if eq(tag, 3) then "add" else if eq(tag, 5) then "le" else if eq(tag, 6) then "choice-if" else if eq(tag, 15) then "now_unix_ms" else if eq(tag, 43) then "intern-int" else if eq(tag, 45) then "blueprint" else if eq(tag, 46) then "intern-string" else if eq(tag, 47) then "intern-node" else if eq(tag, 83) then "jit-compile" else if eq(tag, 102) then "eq" else if eq(tag, 105) then "http-get" else if eq(tag, 110) then "frame-slot-read" else if eq(tag, 111) then "frame-reserve" else if eq(tag, 118) then "socket-request" else if eq(tag, 127) then "kernel-stat-observer" else if eq(tag, 128) then "framebuffer-record" else if eq(tag, 129) then "framebuffer-read" else if eq(tag, 136) then "host-exec" else if eq(tag, 143) then "mlx-status" else if eq(tag, 145) then "mlx-run" else if eq(tag, 146) then "jit-leaf-inram" else if eq(tag, 215) then "jit-arm64" else if eq(tag, 241) then "variadic-call" else if eq(tag, 245) then "metal-pipeline" else if eq(tag, 246) then "metal-alloc" else if eq(tag, 247) then "metal-map" else if eq(tag, 249) then "metal-enqueue" else if eq(tag, 252) then "metal-status" else str_concat("tag-", int_to_str(tag));
        }
        def fgo-primitive-row(tag, count) {
            fgo-int("primitive", fgo-tag-name(tag), fgo-tag-name(tag), count, "calls", count, "cpu-arena", "physical-live", str_concat("kernel_stat:", int_to_str(add(100, tag))), "live", "primitive", if eq(tag, 127) then "observer tax" else "current fkwu process");
        }
        def fgo-hotter?(a, b) = if gt(fgo-int-value(a), fgo-int-value(b)) then 1 else 0;
        def fgo-hot-insert(row, rows) {
            if eq(len(rows), 0) then list(row) else if eq(fgo-hotter?(row, head(rows)), 1) then cons(row, rows) else cons(head(rows), fgo-hot-insert(row, tail(rows)));
        }
        def fgo-take(rows, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(head(rows), fgo-take(tail(rows), sub(count, 1)));
        def fgo-heat-scan(tag, top) {
            if gt(tag, 255) then fgo-take(top, 12) else fgo-heat-scan-next(tag, top, kernel_stat(add(100, tag)));
        }
        def fgo-heat-scan-next(tag, top, count) {
            let next = if le(count, 0) then top else fgo-hot-insert(fgo-primitive-row(tag, count), top);
            fgo-heat-scan(add(tag, 1), fgo-take(next, 12));
        }
        def fgo-primitive-heat() = fgo-heat-scan(1, list());

        def fgo-file-bytes(paths) = if eq(len(paths), 0) then 0 else add(file_size(head(paths)), fgo-file-bytes(tail(paths)));
        def fgo-file-newest(paths) = if eq(len(paths), 0) then 0 else fgo-file-newest-go(tail(paths), file_mtime(head(paths)));
        def fgo-file-newest-go(paths, best) {
            if eq(len(paths), 0) then best else fgo-file-newest-go(tail(paths), if gt(file_mtime(head(paths)), best) then file_mtime(head(paths)) else best);
        }
        def fgo-dispatch-candidate-at(sourceMtime, artifactMtime) = if lt(sourceMtime, 0) then "unavailable" else if lt(artifactMtime, sourceMtime) then "source" else "image";
        def fgo-artifact-presence-at(artifactMtime) = if lt(artifactMtime, 0) then "absent" else "present";
        def fgo-root-compatibility-at(sourceMtime, artifactMtime) = if lt(sourceMtime, 0) then "source-missing" else if lt(artifactMtime, 0) then "absent" else if lt(artifactMtime, sourceMtime) then "stale" else "current";
        def fgo-specialization-row(id, label, source, artifact) {
            let sourceMtime = file_mtime(source);
            let artifactMtime = file_mtime(artifact);
            let candidate = fgo-dispatch-candidate-at(sourceMtime, artifactMtime);
            let presence = fgo-artifact-presence-at(artifactMtime);
            let compatibility = fgo-root-compatibility-at(sourceMtime, artifactMtime);
            let display = str_concat("admit=whole-sync candidate=", str_concat(candidate, str_concat(" artifact=", str_concat(presence, str_concat(" root=", compatibility)))));
            if str_eq(candidate, "unavailable") then fgo-unavailable("storage", id, label, "state", "disk-cache", "file_mtime", "cache", "source authority is missing") else fgo-text("storage", id, label, display, "disk-cache", "catalog", "source+artifact root mtime plus current admission contract", candidate, "cache", "root-only candidate; loader acceptance, dependency digest, and resumable installation are named seams");
        }
        def fgo-storage-kind(root, suffix, id, label, plane) {
            let paths = source_inventory(root, suffix, list());
            let count = len(paths);
            let bytes = fgo-file-bytes(paths);
            list(
                fgo-int("storage", str_concat(id, "-count"), str_concat(label, " count"), count, "files", count, plane, "catalog", "source_inventory", if eq(count, 0) then "empty" else "stored", "cache", if eq(count, 0) then "semantic-zero=empty; catalog contains no matching files" else suffix),
                fgo-int("storage", str_concat(id, "-bytes"), str_concat(label, " bytes"), bytes, "bytes", bytes, plane, "catalog", "file_size", if eq(count, 0) then "empty" else "stored", "cache", if eq(count, 0) then "semantic-zero=empty; no matching files, therefore storage bytes are exactly zero; not residence" else "storage bytes; not residence"),
                if eq(count, 0) then fgo-text("storage", str_concat(id, "-newest"), str_concat(label, " newest"), "none(empty catalog)", plane, "catalog", "file_mtime", "empty", "cache", "no timestamp exists because the measured catalog is empty") else fgo-int("storage", str_concat(id, "-newest"), str_concat(label, " newest"), fgo-file-newest(paths), "unix-seconds", 0, plane, "catalog", "file_mtime", "stored", "cache", "freshness coordinate"));
        }
        def fgo-storage(root) {
            if not(eq(fs_is_dir(root), 1)) then list(fgo-unavailable("storage", "root", "storage root", "path", "disk-cache", "fs_is_dir", "cache", root)) else append(fgo-storage-kind(root, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-storage-kind(root, ".sym", "sym", "specialization symbols", "disk-cache"), append(fgo-storage-kind(root, ".dylib", "dylib", "native specialization library", "disk-cache"), append(fgo-storage-kind(root, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-storage-kind(root, ".fk", "form", "Form organ/source", "mapped-file")))));
        }
        def fgo-cache-storage(root) = if not(eq(fs_is_dir(root), 1)) then list(fgo-unavailable("storage", "cache-root", "cache root", "path", "disk-cache", "fs_is_dir", "cache", root)) else append(fgo-storage-kind(root, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-storage-kind(root, ".sym", "sym", "specialization symbols", "disk-cache"), fgo-storage-kind(root, ".dylib", "dylib", "native specialization library", "disk-cache")));
        def fgo-source-storage(root) = if not(eq(fs_is_dir(root), 1)) then list(fgo-unavailable("storage", "source-root", "source root", "path", "mapped-file", "fs_is_dir", "cache", root)) else append(fgo-storage-kind(root, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-storage-kind(root, ".fk", "form", "Form organ/source", "mapped-file"));

        // A recursive source_inventory must hold its whole C-local listing and
        // cannot melt safely.  The live catalog therefore folds explicitly
        // named immediate directories into three integers, never accepting a
        // truncated whole-tree list.
        def fgo-suffix?(name, suffix) {
            let nameBytes = str_len(name);
            let suffixBytes = str_len(suffix);
            if lt(nameBytes, suffixBytes) then 0 else if str_eq(substring(name, sub(nameBytes, suffixBytes), nameBytes), suffix) then 1 else 0;
        }
        def fgo-join(root, name) = str_concat(root, str_concat("/", name));
        def fgo-flat-stats-names(root, names, suffix, count, bytes, newest) = if eq(len(names), 0) then list(count, bytes, newest) else fgo-flat-stats-name(root, names, suffix, count, bytes, newest, head(names));
        def fgo-flat-stats-name(root, names, suffix, count, bytes, newest, name) {
            let matched = fgo-suffix?(name, suffix);
            let path = fgo-join(root, name);
            let size = if eq(matched, 1) then file_size(path) else 0;
            let modified = if eq(matched, 1) then file_mtime(path) else 0;
            fgo-flat-stats-names(root, tail(names), suffix, add(count, matched), add(bytes, size), if gt(modified, newest) then modified else newest);
        }
        def fgo-flat-stats-root(root, suffix) = if not(eq(fs_is_dir(root), 1)) then list(0, 0, 0) else fgo-flat-stats-names(root, fs_list(root), suffix, 0, 0, 0);
        def fgo-add-stats(left, right) = list(add(nth(left, 0), nth(right, 0)), add(nth(left, 1), nth(right, 1)), if gt(nth(left, 2), nth(right, 2)) then nth(left, 2) else nth(right, 2));
        def fgo-flat-stats-roots(roots, suffix, held) = if eq(len(roots), 0) then held else fgo-flat-stats-roots(tail(roots), suffix, fgo-add-stats(held, fgo-flat-stats-root(head(roots), suffix)));
        def fgo-flat-kind(roots, suffix, id, label, plane) {
            let stats = fgo-flat-stats-roots(roots, suffix, list(0, 0, 0));
            let count = nth(stats, 0);
            list(fgo-int("storage", str_concat(id, "-count"), str_concat(label, " count"), count, "files", count, plane, "catalog", "fs_list+file_size", if eq(count, 0) then "empty" else "stored", "cache", if eq(count, 0) then "semantic-zero=empty; explicit immediate-root catalog has no matching files" else "explicit immediate roots"), fgo-int("storage", str_concat(id, "-bytes"), str_concat(label, " bytes"), nth(stats, 1), "bytes", nth(stats, 1), plane, "catalog", "fs_list+file_size", if eq(count, 0) then "empty" else "stored", "cache", if eq(count, 0) then "semantic-zero=empty; no matching files, therefore catalog bytes are exactly zero; not residence" else "storage bytes; not residence"), if eq(count, 0) then fgo-text("storage", str_concat(id, "-newest"), str_concat(label, " newest"), "none(empty catalog)", plane, "catalog", "fs_list+file_mtime", "empty", "cache", "no timestamp exists because the measured catalog is empty") else fgo-int("storage", str_concat(id, "-newest"), str_concat(label, " newest"), nth(stats, 2), "unix-seconds", 0, plane, "catalog", "fs_list+file_mtime", "stored", "cache", "explicit immediate roots"));
        }
        def fgo-flat-cache-storage(roots) = append(fgo-flat-kind(roots, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-flat-kind(roots, ".sym", "sym", "specialization symbols", "disk-cache"), fgo-flat-kind(roots, ".dylib", "dylib", "native specialization library", "disk-cache")));
        def fgo-flat-source-storage(roots) = append(fgo-flat-kind(roots, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-flat-kind(roots, ".fk", "form", "Form organ/source", "mapped-file"));

        def fgo-snapshot(root) {
            let epoch = now_unix_ms();
            let events = framebuffer-events();
            let metal = metal_status();
            let mlx = mlx_status();
            let vm = host_vm_stat();
            let kernelRows = fgo-kernel-rows();
            let framebufferRows = fgo-framebuffer-rows(events);
            let metalRows = fgo-metal-rows(metal);
            let mlxRows = fgo-mlx-rows(mlx);
            let hostRows = fgo-host-rows(vm);
            let processRows = fgo-live-process-rows();
            let heatRows = fgo-primitive-heat();
            let eventRows = fgo-event-rows(events);
            let storageRows = fgo-storage(root);
            let rows = append(kernelRows, append(framebufferRows, append(metalRows, append(mlxRows, append(hostRows, append(processRows, append(heatRows, append(eventRows, storageRows))))))));
            list(FGOSchema(), epoch, fgo-observe-rows(rows, epoch, 0), "current-process-plus-host-ports", "cross-process-metrics-bounded-no-argv");
        }
        def fgo-snapshot-rows(snapshot) = nth(snapshot, 2);

        def fgo-frame-row(row, sequence) {
            intern_node_at(bp(FGOEvent()), list(
                intern_trivial_string(fgo-domain(row)),
                intern_trivial_string(fgo-id(row)),
                intern_trivial_string(fgo-label(row)),
                intern_trivial_string(fgo-value-kind(row)),
                intern_trivial_int(fgo-int-value(row)),
                intern_trivial_int(fgo-present?(row)),
                intern_trivial_string(fgo-unit(row)),
                intern_trivial_int(fgo-capacity(row)),
                intern_trivial_int(fgo-capacity-present?(row)),
                intern_trivial_int(fgo-heat(row)),
                intern_trivial_int(fgo-age(row)),
                intern_trivial_string(fgo-plane(row)),
                intern_trivial_string(fgo-evidence(row)),
                intern_trivial_string(fgo-source(row)),
                intern_trivial_string(fgo-lifecycle(row)),
                intern_trivial_string(fgo-channel(row)),
                intern_trivial_string(fgo-note(row)),
                intern_trivial_int(sequence)),
                "form/form-stdlib/form-glass-observer.bml", 1, 1);
        }
        def fgo-frame-rows(rows, sequence) = if eq(len(rows), 0) then list() else cons(fgo-frame-row(head(rows), sequence), fgo-frame-rows(tail(rows), sequence));
        def fgo-write(snapshot) {
            let frames = fgo-frame-rows(fgo-snapshot-rows(snapshot), nth(snapshot, 1));
            list("form-glass-observation-frame", snapshot, frames);
        }
    }
    0;
}
