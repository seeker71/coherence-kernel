//////////////////////////////////////////////////////////////////////
//
// form-glass-observer.bml — executable whole-body observation rows.
//
// Authority: form-stdlib/bml/form-glass-observer.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk form/form-stdlib/bml/glass-memory-accounting.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassObserverAuthority {
        field FGOAuthorityPath = "form/form-stdlib/bml/form-glass-observer.bml";
        field FGOAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassObserver {
        field FGOSchema = "form-glass-observer-v2";
        // The glass family's categories, minted where the registry places them, so every kernel
        // reads one NodeID: FORM-GLASS-OBSERVATION-V1 1/2/99/1758, FORM-GLASS-METRIC-FIELD-V2 1/2/99/1759.
        def fgo-observation-category() = make_nodeid(1, 2, 99, 1758);
        def fgo-metric-field-category() = make_nodeid(1, 2, 99, 1759);
        field FGOValueEvent = "form-glass-value-event-v2";

        ref fgo-authority = FormGlassObserverAuthority;
        thought fgo-law = list("presence-before-value", "planes-never-collapse", "process-local-is-named", "bounded-process-no-argv", "storage-is-not-residence", "observer-tax-is-visible");

        // metric: tag, domain, id, label, value kind, int value, text value,
        // present, unit, capacity, capacity present, heat, age, memory plane,
        // evidence, source, lifecycle, channel, note, stable field NodeID,
        // observed epoch, and observation sequence.  The NodeID identifies the
        // field, never a reading of the field: values and time live in the
        // melt-managed row/event record so a changing counter cannot grow the
        // permanent NodeID arena.
        // A field node is the FIELD, never the instance: its kids are the shape a
        // row belongs to (domain, kind, unit, plane, channel), and the row itself
        // carries the id. Keyed by id, a per-kernel row minted two permanent cells
        // for every pid the host ever ran (453 events in 40 s, witnessed 2026-09-07
        // through the per-defn mint ledger), so the arena grew with the number of
        // kernels ever seen. A field node is attributed once. intern_node_at records a framebuffer
        // root on every call, so re-minting the same field each frame grew the
        // root list by one root per row per frame and the glass walked that list
        // quadratically every tick (fieldonce); a field already carrying its
        // source is returned as it stands.
        def fgo-field-node(cat, kids, file, line, col) {
            let node = intern_node(cat, kids);
            (Comparable) len(node_source(node)) == 0 ? intern_node_at(cat, kids, file, line, col) : node;
        }
        def fgo-metric(domain, id, label, valueKind, intValue, textValue, present, unit, capacity, capacityPresent, heat, age, plane, evidence, source, lifecycle, channel, note) {
            let truthClass = (String) evidence == "observed" ? ((String) lifecycle == "stored" ? "catalog" : "physical-live") : evidence;
            let projection = fgo-field-node(fgo-metric-field-category(), list(intern_trivial_string("glass.monitor"), intern_trivial_string(domain), intern_trivial_string(valueKind), intern_trivial_string(unit), intern_trivial_string(plane), intern_trivial_string(channel)), "form/form-stdlib/form-glass-observer.bml", 1, 1);
            list("form-glass-metric-v2", domain, id, label, valueKind, intValue, textValue, present, unit, capacity, capacityPresent, heat, age, plane, truthClass, source, lifecycle, channel, note, projection, -1, -1);
        }
        def fgo-domain(row) = row[1];
        def fgo-id(row) = row[2];
        def fgo-label(row) = row[3];
        def fgo-value-kind(row) = row[4];
        def fgo-int-value(row) = row[5];
        def fgo-text-value(row) = row[6];
        def fgo-present?(row) = row[7];
        def fgo-unit(row) = row[8];
        def fgo-capacity(row) = row[9];
        def fgo-capacity-present?(row) = row[10];
        def fgo-heat(row) = row[11];
        def fgo-age(row) = row[12];
        def fgo-plane(row) = row[13];
        def fgo-evidence(row) = row[14];
        def fgo-source(row) = row[15];
        def fgo-lifecycle(row) = row[16];
        def fgo-channel(row) = row[17];
        def fgo-note(row) = row[18];

        def fgo-int(domain, id, label, value, unit, heat, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "int", value, "", 1, unit, 0, 0, heat, 0, plane, evidence, source, lifecycle, channel, note);
        }
        // a figure the host did not tell arrives as nothing and stands as an unavailable row, the door it was asked at in source
        def fgo-int-or-unavailable(domain, id, label, value, unit, heat, plane, evidence, source, lifecycle, channel, note, withheld) = nothing?(value) ? fgo-unavailable(domain, id, label, unit, plane, source, channel, withheld) : fgo-int(domain, id, label, value, unit, heat, plane, evidence, source, lifecycle, channel, note);
        def fgo-sized(domain, id, label, value, unit, capacity, heat, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "int", value, "", 1, unit, capacity, 1, heat, 0, plane, evidence, source, lifecycle, channel, note);
        }
        def fgo-text(domain, id, label, value, plane, evidence, source, lifecycle, channel, note) {
            fgo-metric(domain, id, label, "text", 0, value, 1, "", 0, 0, 0, 0, plane, evidence, source, lifecycle, channel, note);
        }
        def fgo-whitespace-byte?(byte) = (Comparable) byte == 32 ? 1 : (Comparable) byte == 9 ? 1 : (Comparable) byte == 10 ? 1 : (Comparable) byte == 13 ? 1 : 0;
        def fgo-blank-text-at?(value, index) = index >= str_len(value) ? 1 : (Comparable) fgo-whitespace-byte?(str_byte_at(value, index)) == 1 ? fgo-blank-text-at?(value, index + 1) : 0;
        def fgo-text-or-unavailable(domain, id, label, value, plane, evidence, source, lifecycle, channel, note) = (Comparable) fgo-blank-text-at?(value, 0) == 1 ? fgo-unavailable(domain, id, label, "text", plane, source, channel, note) : fgo-text(domain, id, label, value, plane, evidence, source, lifecycle, channel, note);
        // On an unavailable row `source` is the exact missing observation
        // door, never a generic "missing carrier" bucket.  This keeps the v1
        // metric stream compatible while giving every question mark a place
        // that can actually be built or instrumented.
        def fgo-unavailable(domain, id, label, unit, plane, missingDoor, channel, reason) {
            fgo-metric(domain, id, label, "absent", 0, "", 0, unit, 0, 0, 0, -1, plane, "unavailable", missingDoor, "unknown", channel, reason);
        }
        // A gauge nobody asked for and a gauge that was asked and answered
        // nothing are different absences.  This row is the second one: the door
        // that was tried stands in `source`, and what that door said stands at
        // the head of the note, so a reader sees the probe instead of a shrug.
        // It renders exactly like an unavailable row -- the truth machinery is
        // unchanged -- and it carries its own witness.
        def fgo-probed-absent(domain, id, label, unit, plane, doorTried, doorAnswer, channel, reason) {
            fgo-unavailable(domain, id, label, unit, plane, doorTried, channel, "probed: " ++ doorAnswer ++ "; " ++ reason);
        }
        // Every local metric value has a real Glass-owned observation node.
        // That projection identity is deliberately separate from the external
        // producer NodeID, which remains unbound unless the framebuffer row
        // carries the actual source node object.
        def fgo-projection-node(row) = len(row) < 20 ? nothing() : row[19];
        def fgo-nodeid-bound?(row) = nothing?(fgo-projection-node(row)) ? 0 : 1;
        def fgo-nodeid-state(row) = (Comparable) fgo-nodeid-bound?(row) == 1 ? "bound-glass-projection" : "unbound";
        def fgo-nodeid-value(row) = (Comparable) fgo-nodeid-bound?(row) == 1 ? fgo-node-id(fgo-projection-node(row)) : "";
        def fgo-nodeid-door(row) = (Comparable) fgo-nodeid-bound?(row) == 1 ? "glass.metric-projection" : "telemetry.nodeid-owner-binding";
        // The row's clock columns -- age (12), observed epoch (20), sequence (21) -- carry -1 for "not observed" and
        // -2 for a clock that ran backwards. That is form-glass-metric-v2's wire shape: interned as trivial ints in
        // fgo-frame-row, carried in gift frames, and ordered by eight sibling readers; nothing there is a v3 row.
        def fgo-observed-epoch(row) = len(row) < 21 ? -1 : row[20];
        def fgo-observation-sequence(row) = len(row) < 22 ? -1 : row[21];
        def fgo-source-node(row) = len(row) < 23 ? nothing() : row[22];
        def fgo-source-nodeid-bound?(row) = nothing?(fgo-source-node(row)) ? 0 : 1;
        def fgo-source-nodeid-value(row) = (Comparable) fgo-source-nodeid-bound?(row) == 1 ? fgo-node-id(fgo-source-node(row)) : "";
        def fgo-source-nodeid-door(row) = (Comparable) fgo-source-nodeid-bound?(row) == 1 ? "framebuffer.interned-node" : "telemetry.nodeid-owner-binding";

        // Re-materialize the value record while retaining the stable field
        // NodeID and any real source node.  These are ordinary Form lists and
        // therefore travel through the existing melt-managed arena.
        def fgo-row-at(row, age, observedEpoch, sequence) {
            // This encoding owns the slot layout; repacking need not dispatch
            // an accessor for every unchanged slot on every observed row.
            let base = list("form-glass-metric-v2", row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8], row[9], row[10], row[11], age, row[13], row[14], row[15], row[16], row[17], row[18], fgo-projection-node(row), observedEpoch, sequence);
            let source = fgo-source-node(row);
            nothing?(source) ? base : append(base, list(source));
        }
        def fgo-observe-row(row, observedEpoch, sequence) = (Comparable) fgo-present?(row) == 0 ? fgo-row-at(row, -1, -1, sequence) : fgo-row-at(row, 0, observedEpoch, sequence);
        // the same row under another truth: the frame it was read from fell silent, or its gauge is consumed by
        // another reader. The value and its observation stay as they were; evidence and lifecycle name the state,
        // so a lane fed by this row renders the state instead of a confident number.
        def fgo-row-with-truth(row, evidence, lifecycle) {
            let base = list("form-glass-metric-v2", fgo-domain(row), fgo-id(row), fgo-label(row), fgo-value-kind(row), fgo-int-value(row), fgo-text-value(row), fgo-present?(row), fgo-unit(row), fgo-capacity(row), fgo-capacity-present?(row), fgo-heat(row), fgo-age(row), fgo-plane(row), evidence, fgo-source(row), lifecycle, fgo-channel(row), fgo-note(row), fgo-projection-node(row), fgo-observed-epoch(row), fgo-observation-sequence(row));
            (Comparable) fgo-source-nodeid-bound?(row) == 1 ? append(base, list(fgo-source-node(row))) : base;
        }
        def fgo-rows-with-truth(rows, evidence, lifecycle) = (Comparable) len(rows) == 0 ? list() : cons(fgo-row-with-truth(head(rows), evidence, lifecycle), fgo-rows-with-truth(tail(rows), evidence, lifecycle));
        def fgo-observe-rows(rows, observedEpoch, sequence) = (Comparable) len(rows) == 0 ? list() : cons(fgo-observe-row(head(rows), observedEpoch, sequence), fgo-observe-rows(tail(rows), observedEpoch, sequence));
        def fgo-age-at(row, epoch) = (Comparable) fgo-present?(row) == 0 ? -1 : fgo-age-stamp(fgo-observed-epoch(row), epoch);
        def fgo-age-stamp(observed, epoch) = observed < 0 ? -1 : epoch >= observed ? (epoch - observed) : -2;
        // Fresh local and unavailable rows already carry their exact age.
        // Retain those native values; only changed ages need a new record.
        def fgo-age-row-at(row, epoch) = fgo-age-row-value(row, fgo-age-at(row, epoch));
        def fgo-age-row-value(row, age) = ((Comparable) age == fgo-age(row)) && fgo-age-reusable?(row) ? row : fgo-row-at(row, age, fgo-observed-epoch(row), fgo-observation-sequence(row));
        def fgo-age-reusable?(row) = !((String) head(row) == "form-glass-metric-v2") ? 0 : (Comparable) len(row) == 22 ? 1 : (Comparable) len(row) == 23 ? fgo-source-nodeid-bound?(row) : 0;
        def fgo-age-rows-at(rows, epoch) = (Comparable) len(rows) == 0 ? list() : cons(fgo-age-row-at(head(rows), epoch), fgo-age-rows-at(tail(rows), epoch));
        def fgo-value-event(row) = list(FGOValueEvent(), fgo-projection-node(row), fgo-observed-epoch(row), fgo-observation-sequence(row), fgo-value-kind(row), fgo-int-value(row), fgo-text-value(row), fgo-present?(row), fgo-capacity(row), fgo-capacity-present?(row), fgo-heat(row), fgo-evidence(row), fgo-lifecycle(row), fgo-source(row), fgo-note(row), fgo-source-node(row));

        // A `key=value` status line: a key the text does not carry, or carries empty, is nothing -- never a number.
        // str_find's -1 is the primitive's own answer for "not found", read once here and nowhere past it.
        def fgo-status-start(status, name) {
            let key = name ++ "=";
            let laterKey = "\n" ++ key;
            let atFirst = str_find(status, key, 0);
            let atLater = str_find(status, laterKey, 0);
            (Comparable) atFirst == 0 ? str_len(key) : atLater < 0 ? nothing() : (atLater + str_len(laterKey));
        }
        def fgo-status-text(status, name) {
            let start = fgo-status-start(status, name);
            nothing?(start) ? nothing() : fgo-status-text-found(status, start);
        }
        def fgo-status-text-found(status, start) {
            let stop = str_find(status, "\n", start);
            stop < 0 ? substring(status, start, str_len(status)) : substring(status, start, stop);
        }
        def fgo-status-int(status, name) {
            let value = fgo-status-text(status, name);
            nothing?(value) ? nothing() : (Comparable) str_len(value) == 0 ? nothing() : str_to_int(value);
        }

        // ---- arena bytes: the seed's own column widths over the seed's own counts ----
        // The value-cell table is a set of parallel columns indexed by cell handle.
        // Ten native words occupy 80 logical bytes per node. Private roots,
        // native admission metadata and the intern index are accounted separately.
        def FGOCellColumnBytes() = CellColumnBytes();
        // The identity is generated directly into one native 64-bit word.
        def FGOBlueprintColumnBytes() = BlueprintColumnBytes();
        // fk_fn_reserve holds ten parallel 8-byte columns per recipe: fk_fn,
        // fk_fnar, fk_fnsym_s, fk_fnsym_n, fk_fnidx, fk_fn_heat, fk_fn_fbox,
        // fk_fn_unbox, fk_fn_native, fk_fn_mint. The recipe BODIES stand in the AST table,
        // which this width does not count.
        def FGORecipeColumnBytes() = RecipeColumnBytes();

        def fgo-kernel-rows() {
            let cells = kernel_stat(4);
            let strings = kernel_stat(5);
            let floats = kernel_stat(8);
            let recipes = kernel_stat(43);
            list(
                fgo-int("kernel", "dispatch-total", "primitive dispatches", kernel_stat(0), "calls", kernel_stat(0), "cpu-arena", "physical-live", "kernel_stat:0", "live", "kernel", "current fkwu process"),
                fgo-int("kernel", "dispatch-distinct", "distinct primitives", kernel_stat(1), "tags", kernel_stat(1), "cpu-arena", "physical-live", "kernel_stat:1", "live", "kernel", "current fkwu process"),
                fgo-int("kernel", "hottest-tag", "hottest primitive tag", kernel_stat(2), "tag", kernel_stat(3), "cpu-arena", "physical-live", "kernel_stat:2", "live", "primitive", "observer may become hot"),
                fgo-int("kernel", "hottest-count", "hottest primitive calls", kernel_stat(3), "calls", kernel_stat(3), "cpu-arena", "physical-live", "kernel_stat:3", "live", "primitive", "current fkwu process"),
                fgo-int("memory", "cells", "runtime NodeIDs (this Glass)", cells, "nodes", cells, "cpu-arena", "physical-live", "kernel_stat:4", (Comparable) cells == 0 ? "empty" : "resident", "cell", (Comparable) cells == 0 ? "semantic-zero=empty; current Glass process has minted no NodeIDs; not BML, AST, catalog, or model-process absence; the bytes stand as memory.cell-bytes" : "current Glass process interned NodeID count; the bytes stand as memory.cell-bytes"),
                fgo-int("memory", "strings", "interned strings", strings, "strings", strings, "cpu-arena", "physical-live", "kernel_stat:5", "resident", "string", "current Glass process string count; the interned byte pool has no live-size stat in kernel_stat, so its bytes are their own missing door; temporal growth and selfmolt threshold are separate live rows; missing door=kernel.ephemeral-render-string"),
                fgo-int("memory", "cons", "arena cons cells", kernel_stat(6), "cons", kernel_stat(6), "cpu-arena", "physical-live", "kernel_stat:6", "resident", "list", "arena pointer; not bytes"),
                fgo-int("memory", "value-stack", "value stack depth", kernel_stat(7), "values", kernel_stat(7), "cpu-stack", "physical-live", "kernel_stat:7", "live", "stack", "current depth; high-water unavailable"),
                fgo-int("memory", "floats", "float values", floats, "values", floats, "cpu-arena", "physical-live", "kernel_stat:8", (Comparable) floats == 0 ? "empty" : "resident", "float", (Comparable) floats == 0 ? "semantic-zero=empty; current Glass process boxed-float pool has no values; the pool has no live-size stat in kernel_stat" : "current Glass process boxed-float count; the pool has no live-size stat in kernel_stat"),
                fgo-int("memory", "blueprint-bytes", "identity column (cell subset)", fgma-blueprint-bytes(cells), "bytes", 0, "cpu-arena", "derived-window", "kernel_stat:4 x native-node-word", "logical", "blueprint", "One 64-bit identity per node, included in the node columns"),
                fgo-int("memory", "recipe-bytes", "recipe columns (logical fill)", fgma-recipe-bytes(recipes), "bytes", 0, "cpu-arena", "derived-window", "kernel_stat:43 x ten recipe columns", "logical", "recipe", "includes mint column; excludes AST bodies, spare capacity and allocator overhead"),
                fgo-int("memory", "cell-bytes", "cell columns (logical fill)", fgma-cell-bytes(cells), "bytes", 0, "cpu-arena", "derived-window", "kernel_stat:4 x tracked cell column widths", "logical", "cell", "tracked column fill, not RSS; excludes fbroots and platform-specific auxiliary tables"));
        }

        def fgo-event-attributed?(node) = (Comparable) len(node_source(node)) == 0 ? 0 : 1;
        def fgo-count-attributed(events) = (Comparable) len(events) == 0 ? 0 : (fgo-event-attributed?(head(events)) + fgo-count-attributed(tail(events)));
        def fgo-framebuffer-count-row(id, label, value, emptyNote, liveNote) = fgo-int("framebuffer", id, label, value, "roots", value, "cpu-arena", "physical-live", "framebuffer-events", (Comparable) value == 0 ? "empty" : "live", "framebuffer", (Comparable) value == 0 ? emptyNote : liveNote);
        def fgo-framebuffer-rows(events) {
            let count = len(events);
            let attributed = fgo-count-attributed(events);
            list(
                fgo-framebuffer-count-row("events", "event roots", count, "semantic-zero=empty; bounded current-process framebuffer event list contains no roots", "bounded current-process framebuffer roots"),
                fgo-framebuffer-count-row("roots", "visible roots", count, "semantic-zero=empty; framebuffer-events currently holds no roots", "visible registered roots from framebuffer-events; kernel_stat:9 remains a separate table-walker door"),
                fgo-framebuffer-count-row("attributed", "source-attributed roots", attributed, "semantic-zero=empty; no visible root currently carries a source node", "visible roots whose node_source is nonempty"),
                fgo-probed-absent("framebuffer", "rejected", "rejected roots", "roots", "cpu-arena", "kernel_stat:11", "kernel_stat 11 answers 0, and so do kernel_stat 99 and kernel_stat 255 -- keys this seed does not carry -- so 0 here is the no-such-key answer, not a count", "framebuffer", "framebuffer_register refuses a value that is not a live cell handle and keeps no tally of the refusals; the seed's own comment reserves keys 9..14 for the table-walker lane and leaves them clear. The door to build: kernel_stat 11 = registrations refused, kernel_stat 9 = cumulative fk_fbn"),
                fgo-framebuffer-count-row("entered", "entered roots", count, "semantic-zero=empty; no root has entered the current-process event list", "visible roots that entered framebuffer-events this process"),
                fgo-framebuffer-count-row("accepted", "accepted roots", count, "semantic-zero=empty; no accepted root is currently visible", "visible accepted roots from framebuffer-events; this is the Glass F-stage count"),
                fgo-int("framebuffer", "last-index", "last root index", (Comparable) count == 0 ? 0 : (count - 1), "index", (Comparable) count == 0 ? 0 : (count - 1), "cpu-arena", "physical-live", "framebuffer-events", (Comparable) count == 0 ? "empty" : "live", "framebuffer", (Comparable) count == 0 ? "semantic-zero=empty; no last index while the event list is empty" : "index of the newest visible framebuffer-events root"));
        }

        def fgo-node-id(node) {
            ("@" ++ int_to_str(node_pkg(node)) ++ "." ++ int_to_str(node_level(node)) ++ "." ++ int_to_str(node_type(node)) ++ "." ++ int_to_str(node_inst(node)));
        }
        def fgo-event-row(node) {
            let source = node_source(node);
            let sourceText = (Comparable) len(source) == 0 ? "unattributed" : source[0];
            append(fgo-sized("cell", fgo-node-id(node), "framebuffer cell shape", len(node_children(node)), "children", node_level(node), len(node_children(node)), "cpu-arena", "physical-live", sourceText, "live", "cell", "type=" ++ int_to_str(node_type(node))), list(node));
        }
        def fgo-event-rows-go(events, remaining) {
            ((Comparable) len(events) == 0) || (remaining <= 0) ? list() : cons(fgo-event-row(head(events)), fgo-event-rows-go(tail(events), remaining - 1));
        }
        def fgo-event-rows(events) = fgo-event-rows-go(events, 8);

        // ---- Metal, as words: metal_live -> 0 linked 1 unified 2 buffers 3 pipelines 4 nocopy 5 pending 6 in flight 7 dispatch 8 sync 9 cpu-jit dispatch 10 cpu-jit busy us 11 gpu busy us 12 wait ms 13 deadline 14 shelf ----
        // A word the carrier did not answer is nothing: metal_live answers nil when Metal is not up, and a negative
        // word is the carrier's own "the device did not speak". Both become nothing here, at the first touch.
        def fgo-metal-word(live, k) = len(live) < 20 ? nothing() : fgo-metal-reading(live[k]);
        def fgo-metal-reading(word) = word < 0 ? nothing() : word;
        def fgo-metal-semantic-row(id, label, value, unit, plane, channel, zeroState, zeroNote, activeNote) = fgo-metal-count-row(id, label, value, unit, plane, channel, zeroState, zeroNote, activeNote);
        def fgo-metal-count-row(id, label, value, unit, plane, channel, zeroState, zeroNote, activeNote) = nothing?(value) ? fgo-unavailable("metal", id, label, unit, plane, "metal_live", channel, "Metal is not up in this process") : (Comparable) value == 0 ? fgo-int("metal", id, label, 0, unit, 0, plane, "physical-live", "metal_live", zeroState, channel, zeroNote) : fgo-int("metal", id, label, value, unit, value, plane, "physical-live", "metal_live", "live", channel, activeNote);
        // The device's byte ledger rides in metal_live words 18 and 19 since
        // 2026-09-06: the carrier, the seed's array and its loop moved together.
        // Before that the two gauges parsed metal_status text by byte, which cost
        // 559K dispatches a tick on the live glass.
        def fgo-metal-rows(live, status) = list(
            fgo-metal-count-row("loaded", "Metal loaded", fgo-metal-word(live, 0), "flag", "unified-gpu", "metal", "unloaded", "Metal is not up in this process", "the carrier answers"),
            fgo-metal-count-row("buffers", "Glass Metal buffers", fgo-metal-word(live, 2), "handles", "unified-gpu", "metal", "empty", "semantic-zero=empty; this Glass process owns no Metal buffer handles", "scope=glass.monitor process"),
            fgo-metal-count-row("mapped", "Glass mmap buffers", fgo-metal-word(live, 4), "handles", "mapped-file", "metal", "empty", "semantic-zero=empty; this Glass process owns no mmap no-copy buffers", "scope=glass.monitor process"),
            fgo-metal-count-row("pipelines", "Glass Metal pipelines", fgo-metal-word(live, 3), "handles", "unified-gpu", "metal", "empty", "semantic-zero=empty; this Glass process owns no Metal pipelines", "scope=glass.monitor process"),
            fgo-metal-count-row("dispatch", "Glass Metal dispatches", fgo-metal-word(live, 7), "dispatches", "unified-gpu", "metal", "idle", "semantic-zero=idle; this Glass process has submitted no Metal dispatch", "scope=glass.monitor process"),
            fgo-metal-count-row("inflight", "Glass Metal in-flight batches", fgo-metal-word(live, 6), "batches", "unified-gpu", "metal", "idle", "semantic-zero=idle; this Glass process has no Metal batch in flight", "scope=glass.monitor process"),
            fgo-metal-count-row("sync", "Glass Metal syncs", fgo-metal-word(live, 8), "syncs", "unified-gpu", "metal", "idle", "semantic-zero=idle; this Glass process has performed no Metal synchronization", "scope=glass.monitor process"),
            fgo-metal-count-row("gpu-busy", "Glass GPU busy", fgo-metal-word(live, 11), "microseconds", "unified-gpu", "metal", "idle", "semantic-zero=idle; this Glass process recorded no command-buffer GPU time", "device command-buffer time; scope=glass.monitor process"),
            fgo-metal-count-row("cpu-jit-busy", "Glass CPU JIT time", fgo-metal-word(live, 10), "microseconds", "cpu-arena", "jit", "idle", "semantic-zero=idle; this Glass process recorded no CPU JIT dispatch time", "scope=glass.monitor process"),
            fgo-metal-count-row("pending", "Glass Metal pending", fgo-metal-word(live, 5), "dispatches", "unified-gpu", "metal", "idle", "semantic-zero=idle; nothing queued for the GPU in this process", "scope=glass.monitor process"),
            fgo-metal-semantic-row("allocated-bytes", "Metal allocated bytes", fgo-metal-word(live, 18), "bytes", "unified-gpu", "metal", "empty", "semantic-zero=empty; the device answered and this process's Metal resources hold no device bytes", "MTLDevice.currentAllocatedSize: the device bytes this process's Metal resources hold right now; the handle rows say how many buffers stand, this says how large they are"),
            fgo-metal-count-row("working-set", "Metal recommended working set", fgo-metal-word(live, 19), "bytes", "unified-gpu", "metal", "empty", "semantic-zero=empty; the device reported no recommended working set", "MTLDevice.recommendedMaxWorkingSetSize: the device bytes the system suggests this process stay under before it pays for eviction; a ceiling, not an allocation"));

        // ---- host memory: Mach vm_statistics64 read in-process (host_vm_stat) -- no memory_pressure, no vm_stat ----
        // list(page, memsize, free, active, inactive, wired, speculative, purgeable, compressor, pageins, pageouts, compressions, decompressions, swapins, swapouts, external, internal)
        // A snapshot the door did not give whole answers nothing, never a number a reader must know to distrust.
        def fgo-vm-valid?(vm) = len(vm) < 17 ? 0 : vm[0] <= 0 ? 0 : vm[1] <= 0 ? 0 : 1;
        def fgo-vm-used-bytes(vm) = (vm[5] + (vm[3] + vm[8])) * vm[0];
        def fgo-host-free-percent(vm) = (Comparable) fgo-vm-valid?(vm) == 0 ? nothing() : (100 - ((fgo-vm-used-bytes(vm) * 100) / vm[1]));
        def fgo-host-total-bytes(vm) = (Comparable) fgo-vm-valid?(vm) == 0 ? nothing() : vm[1];
        def fgo-vm-byte-row(vm, id, label, slot) = (Comparable) fgo-vm-valid?(vm) == 0 ? fgo-unavailable("host", id, label, "bytes", "os-memory", "host_vm_stat", "memory", "native VM snapshot unavailable") : fgo-int("host", id, label, vm[slot] * vm[0], "bytes", 0, "os-memory", "physical-live", "host_vm_stat.pages slot=" ++ int_to_str(slot), "live", "memory", "system-wide page-category bytes; categories may overlap, do not sum as a process allocation");
        def fgo-vm-byte-rows(vm) = list(fgo-vm-byte-row(vm, "vm-free-bytes", "host free pages", 2), fgo-vm-byte-row(vm, "vm-active-bytes", "host active pages", 3), fgo-vm-byte-row(vm, "vm-inactive-bytes", "host inactive pages", 4), fgo-vm-byte-row(vm, "vm-wired-bytes", "host wired pages", 5), fgo-vm-byte-row(vm, "vm-compressor-bytes", "host compressor storage", 8));
        def fgo-vm-count-row(id, label, value, source, note) = nothing?(value) ? fgo-unavailable("host", id, label, "pages", "os-memory", source, "health", "the Mach VM statistics door did not answer") : fgo-int("host", id, label, value, "pages", value, "os-memory", "physical-live", source, "live", "health", note);
        def fgo-vmstat-rows(vm) = (Comparable) fgo-vm-valid?(vm) == 0 ? list(fgo-vm-count-row("pageins", "Mach pageins", nothing(), "mach.vm_statistics64.pageins", "")) : list(fgo-vm-count-row("pageins", "Mach pageins", vm[9], "mach.vm_statistics64.pageins", "cumulative since boot; the delta row is what moves"), fgo-vm-count-row("compressions", "compressor puts", vm[11], "mach.vm_statistics64.compressions", "cumulative since boot"), fgo-vm-count-row("decompressions", "compressor gets", vm[12], "mach.vm_statistics64.decompressions", "cumulative since boot"), fgo-vm-count-row("file-backed-pages", "file-backed pages", vm[15], "mach.vm_statistics64.external_page_count", "resident pages backed by files"), fgo-vm-count-row("compressor-pages", "compressor occupancy", vm[8], "mach.vm_statistics64.compressor_page_count", "pages held by the compressor"));
        // ---- host load: getloadavg, thousandths kept as tenths; host_load_avg answers nil when getloadavg does not ----
        def fgo-loadavg-row(id, label, thousandths) = nothing?(thousandths) ? fgo-unavailable("host", id, label, "tenths", "cpu-scheduler", "getloadavg", "cpu", "the load average door did not answer") : fgo-int("host", id, label, thousandths / 100, "tenths", thousandths / 100, "cpu-scheduler", "physical-live", "getloadavg", "live", "cpu", "run-queue length averaged by the kernel, in tenths");
        def fgo-loadavg-rows(load) = len(load) < 3 ? list(fgo-loadavg-row("load-1", "load average 1m", nothing())) : list(fgo-loadavg-row("load-1", "load average 1m", load[0]), fgo-loadavg-row("load-5", "load average 5m", load[1]), fgo-loadavg-row("load-15", "load average 15m", load[2]));
        // ---- host disk: every IOBlockStorageDriver's cumulative statistics; a rate is the reader's own delta ----
        def fgo-disk-count-row(id, label, value, unit, note) = fgo-int("host", id, label, value, unit, 0, "disk", "physical-live", "IOBlockStorageDriver.Statistics", "live", "health", note);
        def fgo-disk-rows(disk) = len(disk) < 4 ? list(fgo-unavailable("host", "disk-bytes-read", "disk bytes read", "bytes", "disk", "IOBlockStorageDriver.Statistics", "health", "no block storage driver answered")) : list(fgo-disk-count-row("disk-bytes-read", "disk bytes read", disk[0], "bytes", "cumulative since boot over every block storage driver"), fgo-disk-count-row("disk-bytes-written", "disk bytes written", disk[1], "bytes", "cumulative since boot over every block storage driver"), fgo-disk-count-row("disk-ops", "disk operations", disk[2] + disk[3], "ops", "reads + writes, cumulative since boot"));
        def fgo-host-rows(vm) {
            let free = fgo-host-free-percent(vm);
            let total = fgo-host-total-bytes(vm);
            append(list(nothing?(free) ? fgo-unavailable("host", "memory-free", "host reclaimable headroom", "percent", "os-memory", "mach.host_statistics64.vm_statistics64", "health", "the Mach VM statistics door did not answer") : fgo-sized("host", "memory-free", "host reclaimable headroom", free, "percent", 100, 100 - free, "os-memory", "derived-window", "mach.host_statistics64: 100 - (wired+active+compressor)/memsize", "live", "health", "complement of active, wired and compressor storage; includes reclaimable pages, not literal free pages"), nothing?(total) ? fgo-unavailable("host", "memory-total", "physical memory", "bytes", "os-memory", "sysctl.hw.memsize", "health", "the memsize door did not answer") : fgo-int("host", "memory-total", "physical memory", total, "bytes", 0, "os-memory", "physical-live", "sysctl.hw.memsize", "live", "health", "system-wide physical bytes")), append(fgo-vm-byte-rows(vm), append(fgo-loadavg-rows(host_load_avg()), append(fgo-vmstat-rows(vm), fgo-disk-rows(host_disk_stat())))));
        }
        // ---- processes: libproc, no ps, no pgrep -- tuples (pid, rss bytes, cpu microseconds, elapsed seconds, nice, ppid); a figure the host did not tell is nothing, and so is a nice a short tuple lacks ----
        def fgo-processes-from(tuples, remaining) = ((Comparable) len(tuples) == 0) || (remaining <= 0) ? list() : len(head(tuples)) < 4 ? fgo-processes-from(tail(tuples), remaining) : cons(append(fgo-ps-process(head(tuples)[0], head(tuples)[1], head(tuples)[2], head(tuples)[3]), list(len(head(tuples)) >= 5 ? head(tuples)[4] : nothing())), fgo-processes-from(tail(tuples), remaining - 1));
        def fgo-fkwu-processes() = fgo-processes-from(host_processes("fkwu"), fgo-ps-max-processes());
        def fgo-process-by-pid(processes, pid) = (Comparable) len(processes) == 0 ? list() : (Comparable) fgo-ps-pid(head(processes)) == pid ? head(processes) : fgo-process-by-pid(tail(processes), pid);
        def fgo-process-read(pid) = fgo-process-by-pid(fgo-fkwu-processes(), pid);
        def fgo-process-metrics(process) {
            let processLabel = "fkwu " ++ int_to_str(fgo-ps-pid(process));
            let rss = fgo-int-or-unavailable("process", fgo-process-id(process, "rss"), processLabel ++ " RSS", fgo-ps-rss-bytes(process), "bytes", fgo-ps-rss-bytes(process), "os-memory", "physical-live", "libproc.proc_pidinfo.task.resident_size", "live", "process", "resident bytes of one fkwu process", "the host withheld this process's task info");
            let cpu = fgo-int-or-unavailable("process", fgo-process-id(process, "cpu"), processLabel ++ " CPU", fgo-ps-cpu(process), "microseconds", fgo-ps-cpu(process), "cpu-scheduler", "physical-live", "libproc.proc_pidinfo.task.total_user+system", nothing?(fgo-ps-cpu(process)) ? "live" : (Comparable) fgo-ps-cpu(process) == 0 ? "quiet" : "live", "process", "user + system time since start; a rate is the reader's delta", "the host withheld this process's task info");
            let elapsed = fgo-int-or-unavailable("process", fgo-process-id(process, "elapsed"), processLabel ++ " elapsed", fgo-ps-elapsed(process), "seconds", 0, "process-time", "physical-live", "libproc.proc_pidinfo.bsd.start", "live", "process", "elapsed since process start", "the host withheld this process's start");
            list(rss, cpu, elapsed);
        }
        def fgo-process-rows(tuples) = fgo-process-rows-from(fgo-processes-from(tuples, fgo-ps-max-processes()));
        def fgo-live-process-rows() = fgo-process-rows-from(fgo-fkwu-processes());

        def fgo-ps-max-processes() = 32;
        // process: tag, pid, RSS bytes, CPU microseconds, elapsed seconds, and nice when the host told it.
        def fgo-ps-process(pid, rssBytes, cpuMicros, elapsedSeconds) = list("fgo-ps-process-v1", pid, rssBytes, cpuMicros, elapsedSeconds);
        def fgo-ps-pid(process) = process[1];
        def fgo-ps-rss-bytes(process) = process[2];
        def fgo-ps-cpu(process) = process[3];
        def fgo-ps-elapsed(process) = process[4];
        def fgo-ps-nice(process) = len(process) < 6 ? nothing() : process[5];
        def fgo-process-id(process, suffix) = "fkwu-" ++ int_to_str(fgo-ps-pid(process)) ++ "-" ++ suffix;
        def fgo-process-rows-from(processes) = (Comparable) len(processes) == 0 ? list() : append(fgo-process-metrics(head(processes)), fgo-process-rows-from(tail(processes)));

        def fgo-tag-name(tag) {
            (Comparable) tag == 1 ? "int-literal" : (Comparable) tag == 3 ? "add" : (Comparable) tag == 5 ? "le" : (Comparable) tag == 6 ? "choice-if" : (Comparable) tag == 15 ? "now_unix_ms" : (Comparable) tag == 43 ? "intern-int" : (Comparable) tag == 45 ? "blueprint" : (Comparable) tag == 46 ? "intern-string" : (Comparable) tag == 47 ? "intern-node" : (Comparable) tag == 102 ? "eq" : (Comparable) tag == 105 ? "http-get" : (Comparable) tag == 110 ? "frame-slot-read" : (Comparable) tag == 111 ? "frame-reserve" : (Comparable) tag == 118 ? "socket-request" : (Comparable) tag == 127 ? "kernel-stat-observer" : (Comparable) tag == 128 ? "framebuffer-record" : (Comparable) tag == 129 ? "framebuffer-read" : (Comparable) tag == 136 ? "host-exec" : (Comparable) tag == 146 ? "jit-leaf-inram" : (Comparable) tag == 215 ? "jit-arm64" : (Comparable) tag == 241 ? "variadic-call" : (Comparable) tag == 245 ? "metal-pipeline" : (Comparable) tag == 246 ? "metal-alloc" : (Comparable) tag == 247 ? "metal-map" : (Comparable) tag == 249 ? "metal-enqueue" : (Comparable) tag == 252 ? "metal-status" : "tag-" ++ int_to_str(tag);
        }
        def fgo-primitive-row(tag, count) {
            fgo-int("primitive", fgo-tag-name(tag), fgo-tag-name(tag), count, "calls", count, "cpu-arena", "physical-live", "kernel_stat:" ++ int_to_str(100 + tag), "live", "primitive", (Comparable) tag == 127 ? "observer tax" : "current fkwu process");
        }
        def fgo-hotter?(a, b) = fgo-int-value(a) > fgo-int-value(b) ? 1 : 0;
        def fgo-hot-insert(row, rows) {
            (Comparable) len(rows) == 0 ? list(row) : (Comparable) fgo-hotter?(row, head(rows)) == 1 ? cons(row, rows) : cons(head(rows), fgo-hot-insert(row, tail(rows)));
        }
        def fgo-take(rows, count) = (count <= 0) || ((Comparable) len(rows) == 0) ? list() : cons(head(rows), fgo-take(tail(rows), count - 1));
        def fgo-heat-scan(tag, top) {
            tag > 255 ? fgo-take(top, 12) : fgo-heat-scan-next(tag, top, kernel_stat(100 + tag));
        }
        def fgo-heat-scan-next(tag, top, count) {
            let next = count <= 0 ? top : fgo-hot-insert(fgo-primitive-row(tag, count), top);
            fgo-heat-scan(tag + 1, fgo-take(next, 12));
        }
        def fgo-primitive-heat() = fgo-heat-scan(1, list());

        def fgo-file-bytes(paths) = (Comparable) len(paths) == 0 ? 0 : (file_size(head(paths)) + fgo-file-bytes(tail(paths)));
        def fgo-file-newest(paths) = (Comparable) len(paths) == 0 ? 0 : fgo-file-newest-go(tail(paths), file_mtime(head(paths)));
        def fgo-file-newest-go(paths, best) {
            (Comparable) len(paths) == 0 ? best : fgo-file-newest-go(tail(paths), file_mtime(head(paths)) > best ? file_mtime(head(paths)) : best);
        }
        def fgo-dispatch-candidate-at(sourceMtime, artifactMtime) = sourceMtime < 0 ? "unavailable" : artifactMtime < sourceMtime ? "source" : "image";
        def fgo-artifact-presence-at(artifactMtime) = artifactMtime < 0 ? "absent" : "present";
        def fgo-root-compatibility-at(sourceMtime, artifactMtime) = sourceMtime < 0 ? "source-missing" : artifactMtime < 0 ? "absent" : artifactMtime < sourceMtime ? "stale" : "current";
        def fgo-specialization-row(id, label, source, artifact) {
            let sourceMtime = file_mtime(source);
            let artifactMtime = file_mtime(artifact);
            let candidate = fgo-dispatch-candidate-at(sourceMtime, artifactMtime);
            let presence = fgo-artifact-presence-at(artifactMtime);
            let compatibility = fgo-root-compatibility-at(sourceMtime, artifactMtime);
            let display = "admit=whole-sync candidate=" ++ candidate ++ " artifact=" ++ presence ++ " root=" ++ compatibility;
            (String) candidate == "unavailable" ? fgo-unavailable("storage", id, label, "state", "disk-cache", "file_mtime", "cache", "source authority is missing") : fgo-text("storage", id, label, display, "disk-cache", "catalog", "source+artifact root mtime plus current admission contract", candidate, "cache", "root-only candidate; loader acceptance, dependency digest, and resumable installation are named seams");
        }
        def fgo-storage-kind(root, suffix, id, label, plane) {
            let paths = source_inventory(root, suffix, list());
            let count = len(paths);
            let bytes = fgo-file-bytes(paths);
            list(
                fgo-int("storage", id ++ "-count", label ++ " count", count, "files", count, plane, "catalog", "source_inventory", (Comparable) count == 0 ? "empty" : "stored", "cache", (Comparable) count == 0 ? "semantic-zero=empty; catalog contains no matching files" : suffix),
                fgo-int("storage", id ++ "-bytes", label ++ " bytes", bytes, "bytes", bytes, plane, "catalog", "file_size", (Comparable) count == 0 ? "empty" : "stored", "cache", (Comparable) count == 0 ? "semantic-zero=empty; no matching files, therefore storage bytes are exactly zero; not residence" : "storage bytes; not residence"),
                (Comparable) count == 0 ? fgo-text("storage", id ++ "-newest", label ++ " newest", "none(empty catalog)", plane, "catalog", "file_mtime", "empty", "cache", "no timestamp exists because the measured catalog is empty") : fgo-int("storage", id ++ "-newest", label ++ " newest", fgo-file-newest(paths), "unix-seconds", 0, plane, "catalog", "file_mtime", "stored", "cache", "freshness coordinate"));
        }
        def fgo-storage(root) {
            !((Comparable) fs_is_dir(root) == 1) ? list(fgo-unavailable("storage", "root", "storage root", "path", "disk-cache", "fs_is_dir", "cache", root)) : append(fgo-storage-kind(root, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-storage-kind(root, ".sym", "sym", "specialization symbols", "disk-cache"), append(fgo-storage-kind(root, ".dylib", "dylib", "native specialization library", "disk-cache"), append(fgo-storage-kind(root, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-storage-kind(root, ".fk", "form", "Form organ/source", "mapped-file")))));
        }
        def fgo-cache-storage(root) = !((Comparable) fs_is_dir(root) == 1) ? list(fgo-unavailable("storage", "cache-root", "cache root", "path", "disk-cache", "fs_is_dir", "cache", root)) : append(fgo-storage-kind(root, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-storage-kind(root, ".sym", "sym", "specialization symbols", "disk-cache"), fgo-storage-kind(root, ".dylib", "dylib", "native specialization library", "disk-cache")));
        def fgo-source-storage(root) = !((Comparable) fs_is_dir(root) == 1) ? list(fgo-unavailable("storage", "source-root", "source root", "path", "mapped-file", "fs_is_dir", "cache", root)) : append(fgo-storage-kind(root, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-storage-kind(root, ".fk", "form", "Form organ/source", "mapped-file"));

        // A recursive source_inventory must hold its whole C-local listing and
        // cannot melt safely.  The live catalog therefore folds explicitly
        // named immediate directories into three integers, never accepting a
        // truncated whole-tree list.
        def fgo-suffix?(name, suffix) {
            let nameBytes = str_len(name);
            let suffixBytes = str_len(suffix);
            nameBytes < suffixBytes ? 0 : (String) substring(name, nameBytes - suffixBytes, nameBytes) == suffix ? 1 : 0;
        }
        def fgo-join(root, name) = root ++ "/" ++ name;
        def fgo-flat-stats-names(root, names, suffix, count, bytes, newest) = (Comparable) len(names) == 0 ? list(count, bytes, newest) : fgo-flat-stats-name(root, names, suffix, count, bytes, newest, head(names));
        def fgo-flat-stats-name(root, names, suffix, count, bytes, newest, name) {
            let matched = fgo-suffix?(name, suffix);
            let path = fgo-join(root, name);
            let size = (Comparable) matched == 1 ? file_size(path) : 0;
            let modified = (Comparable) matched == 1 ? file_mtime(path) : 0;
            fgo-flat-stats-names(root, tail(names), suffix, count + matched, bytes + size, modified > newest ? modified : newest);
        }
        def fgo-flat-stats-root(root, suffix) = !((Comparable) fs_is_dir(root) == 1) ? list(0, 0, 0) : fgo-flat-stats-names(root, fs_list(root), suffix, 0, 0, 0);
        def fgo-add-stats(left, right) = list(left[0] + right[0], left[1] + right[1], left[2] > right[2] ? left[2] : right[2]);
        def fgo-flat-stats-roots(roots, suffix, held) = (Comparable) len(roots) == 0 ? held : fgo-flat-stats-roots(tail(roots), suffix, fgo-add-stats(held, fgo-flat-stats-root(head(roots), suffix)));
        def fgo-flat-kind(roots, suffix, id, label, plane) {
            let stats = fgo-flat-stats-roots(roots, suffix, list(0, 0, 0));
            let count = stats[0];
            list(fgo-int("storage", id ++ "-count", label ++ " count", count, "files", count, plane, "catalog", "fs_list+file_size", (Comparable) count == 0 ? "empty" : "stored", "cache", (Comparable) count == 0 ? "semantic-zero=empty; explicit immediate-root catalog has no matching files" : "explicit immediate roots"), fgo-int("storage", id ++ "-bytes", label ++ " bytes", stats[1], "bytes", stats[1], plane, "catalog", "fs_list+file_size", (Comparable) count == 0 ? "empty" : "stored", "cache", (Comparable) count == 0 ? "semantic-zero=empty; no matching files, therefore catalog bytes are exactly zero; not residence" : "storage bytes; not residence"), (Comparable) count == 0 ? fgo-text("storage", id ++ "-newest", label ++ " newest", "none(empty catalog)", plane, "catalog", "fs_list+file_mtime", "empty", "cache", "no timestamp exists because the measured catalog is empty") : fgo-int("storage", id ++ "-newest", label ++ " newest", stats[2], "unix-seconds", 0, plane, "catalog", "fs_list+file_mtime", "stored", "cache", "explicit immediate roots"));
        }
        def fgo-flat-cache-storage(roots) = append(fgo-flat-kind(roots, ".fkb", "fkb", "Form specialization image", "disk-cache"), append(fgo-flat-kind(roots, ".sym", "sym", "specialization symbols", "disk-cache"), fgo-flat-kind(roots, ".dylib", "dylib", "native specialization library", "disk-cache")));
        def fgo-flat-source-storage(roots) = append(fgo-flat-kind(roots, ".bml", "bml", "BML authority/source", "mapped-file"), fgo-flat-kind(roots, ".fk", "form", "Form organ/source", "mapped-file"));

        def fgo-snapshot(root) {
            let epoch = now_unix_ms();
            let events = framebuffer-events();
            let metal = metal_live();
            let vm = host_vm_stat();
            let kernelRows = fgo-kernel-rows();
            let framebufferRows = fgo-framebuffer-rows(events);
            let metalRows = fgo-metal-rows(metal, metal_status());
            let hostRows = fgo-host-rows(vm);
            let processRows = fgo-live-process-rows();
            let heatRows = fgo-primitive-heat();
            let eventRows = fgo-event-rows(events);
            let storageRows = fgo-storage(root);
            let rows = append(kernelRows, append(framebufferRows, append(metalRows, append(hostRows, append(processRows, append(heatRows, append(eventRows, storageRows)))))));
            list(FGOSchema(), epoch, fgo-observe-rows(rows, epoch, 0), "current-process-plus-host-ports", "cross-process-metrics-bounded-no-argv");
        }
        def fgo-snapshot-rows(snapshot) = snapshot[2];

        def fgo-frame-row(row, sequence) {
            intern_node_at(fgo-observation-category(), list(
                intern_trivial_string(fgo-domain(row)),
                intern_trivial_string(fgo-id(row)),
                intern_trivial_string(fgo-label(row)),
                intern_trivial_string(fgo-value-kind(row)),
                intern_trivial_int(fgo-int-value(row)),
                intern_trivial_int(fgo-present?(row)),
                intern_trivial_string(fgo-unit(row)),
                intern_trivial_int(fgo-capacity(row)),
                intern_trivial_int(fgo-capacity-present?(row)),
                intern_trivial_int(fgo-heat(row)),
                intern_trivial_int(fgo-age(row)),
                intern_trivial_string(fgo-plane(row)),
                intern_trivial_string(fgo-evidence(row)),
                intern_trivial_string(fgo-source(row)),
                intern_trivial_string(fgo-lifecycle(row)),
                intern_trivial_string(fgo-channel(row)),
                intern_trivial_string(fgo-note(row)),
                intern_trivial_int(sequence)),
                "form/form-stdlib/form-glass-observer.bml", 1, 1);
        }
        def fgo-frame-rows(rows, sequence) = (Comparable) len(rows) == 0 ? list() : cons(fgo-frame-row(head(rows), sequence), fgo-frame-rows(tail(rows), sequence));
        def fgo-write(snapshot) {
            let frames = fgo-frame-rows(fgo-snapshot-rows(snapshot), snapshot[1]);
            list("form-glass-observation-frame", snapshot, frames);
        }
    }
    0;
}
