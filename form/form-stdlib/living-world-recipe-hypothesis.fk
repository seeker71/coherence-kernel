; living-world-recipe-hypothesis.fk -- observations may grow plural Recipes.
;
; A separately offered enquiry, operator cells, and recurrent examples form an
; executable hypothesis field.  The body has no embedded task, domain, answer,
; or operator list: every operator token arrives as an offered cell.  Binding
; names come from the observed examples.  For each recurrent operator the body
; composes both role orientations as exact Recipe source, executes every Recipe
; against every recurrent example, and retains consistent, refuted, and
; unresolved hypotheses together.  No list order, NodeID, score, majority, or
; remote oracle appoints a winner.
;
; The whole field crosses an ordinary unanimous boundary as evidence, never as
; promotion authority.  A separately offered held-out probe executes every
; consistent hypothesis.  Before observation it may BRANCH; a later observation
; may DISCRIMINATE, COHERE, CONTRADICT, or remain OPEN.  Every Recipe, output,
; failure, alternative, unknown, witness, and path remains inspectable, and
; revocation makes dependent tissue stale without erasing history.
;
; Source composition here is a minimal Form codec over offered safe tokens and
; role names.  Numeric values still enter only through scoped bindings; they are
; never interpolated into Recipe text.  The evaluator remains source-budgeted
; but not gas-bounded.
;
; witnessed: 2026-08-07 -> plural field and held-out probe bands 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk

(let LWPH-ENQUIRY         (bp "LWPH-ENQUIRY"))
(let LWPH-OPERATOR        (bp "LWPH-OPERATOR"))
(let LWPH-EXAMPLE         (bp "LWPH-EXAMPLE"))
(let LWPH-EVALUATION      (bp "LWPH-EVALUATION"))
(let LWPH-HYPOTHESIS      (bp "LWPH-HYPOTHESIS"))
(let LWPH-FIELD           (bp "LWPH-FIELD"))
(let LWPH-OPEN            (bp "LWPH-OPEN"))
(let LWPH-PLURAL          (bp "LWPH-PLURAL"))
(let LWPH-SINGULAR        (bp "LWPH-SINGULAR"))
(let LWPH-REFUTED         (bp "LWPH-REFUTED"))
(let LWPH-CONSISTENT      (bp "LWPH-CONSISTENT"))
(let LWPH-DIVERGENT       (bp "LWPH-DIVERGENT"))
(let LWPH-UNRESOLVED      (bp "LWPH-UNRESOLVED"))
(let LWPH-ORIGIN          (bp "LWPH-ORIGIN"))
(let LWPH-PROBE           (bp "LWPH-PROBE"))
(let LWPH-PROBE-EVAL      (bp "LWPH-PROBE-EVAL"))
(let LWPH-PLACEMENT       (bp "LWPH-PLACEMENT"))
(let LWPH-UNOBSERVED      (bp "LWPH-UNOBSERVED"))
(let LWPH-BRANCH          (bp "LWPH-BRANCH"))
(let LWPH-DISCRIMINATED   (bp "LWPH-DISCRIMINATED"))
(let LWPH-COHERENT        (bp "LWPH-COHERENT"))
(let LWPH-CONTRADICTED    (bp "LWPH-CONTRADICTED"))
(let LWPH-PROBE-ORIGIN    (bp "LWPH-PROBE-ORIGIN"))

(defn lwph-state (kind) (intern_node kind (empty)))
(defn lwph-open () (lwph-state LWPH-OPEN))
(defn lwph-plural () (lwph-state LWPH-PLURAL))
(defn lwph-singular () (lwph-state LWPH-SINGULAR))
(defn lwph-refuted () (lwph-state LWPH-REFUTED))
(defn lwph-consistent () (lwph-state LWPH-CONSISTENT))
(defn lwph-divergent () (lwph-state LWPH-DIVERGENT))
(defn lwph-unresolved () (lwph-state LWPH-UNRESOLVED))
(defn lwph-unobserved () (lwph-state LWPH-UNOBSERVED))
(defn lwph-branch () (lwph-state LWPH-BRANCH))
(defn lwph-discriminated () (lwph-state LWPH-DISCRIMINATED))
(defn lwph-coherent () (lwph-state LWPH-COHERENT))
(defn lwph-contradicted () (lwph-state LWPH-CONTRADICTED))
(defn lwph-open? (state) (if (node_eq state (lwph-open)) 1 0))
(defn lwph-plural? (state) (if (node_eq state (lwph-plural)) 1 0))
(defn lwph-singular? (state) (if (node_eq state (lwph-singular)) 1 0))
(defn lwph-refuted? (state) (if (node_eq state (lwph-refuted)) 1 0))
(defn lwph-consistent? (state)
    (if (node_eq state (lwph-consistent)) 1 0))
(defn lwph-divergent? (state)
    (if (node_eq state (lwph-divergent)) 1 0))
(defn lwph-unresolved? (state)
    (if (node_eq state (lwph-unresolved)) 1 0))
(defn lwph-unobserved? (state)
    (if (node_eq state (lwph-unobserved)) 1 0))
(defn lwph-branch? (state) (if (node_eq state (lwph-branch)) 1 0))
(defn lwph-discriminated? (state)
    (if (node_eq state (lwph-discriminated)) 1 0))
(defn lwph-coherent? (state)
    (if (node_eq state (lwph-coherent)) 1 0))
(defn lwph-contradicted? (state)
    (if (node_eq state (lwph-contradicted)) 1 0))

(defn lwph-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwph-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwph-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwph-source-name-char-safe? (code)
    (if (or (and (ge code 65) (le code 90))
            (or (and (ge code 97) (le code 122))
                (or (and (ge code 48) (le code 57))
                    (or (eq code 33)
                        (or (eq code 42)
                            (or (eq code 43)
                                (or (eq code 45)
                                    (or (eq code 47)
                                        (or (eq code 60)
                                            (or (eq code 61)
                                                (or (eq code 62)
                                                    (or (eq code 63)
                                                        (eq code 95)))))))))))) 1 0))
(defn lwph-source-name-chars-safe? (name pos)
    (if (ge pos (str_len name)) 1
        (if (eq (lwph-source-name-char-safe?
                    (ord (char_at name pos))) 1)
            (lwph-source-name-chars-safe? name (add pos 1)) 0)))
(defn lwph-source-name-safe? (name)
    (if (eq (str_len name) 0) 0
        (do
            (let first (ord (char_at name 0)))
            (if (and (not (and (ge first 48) (le first 57)))
                     (eq (lwph-source-name-chars-safe? name 0) 1)) 1 0))))

; --- offered enquiry and operator surface ------------------------------

; children: arbitrary focus, alternatives, optional unknowable remainder,
;           evidence, local path
(defn lwph-enquiry (focus alternatives unknown evidence)
    (intern_node LWPH-ENQUIRY
        (list focus alternatives unknown evidence (lwo-local-path))))
(defn lwph-enquiry? (cell) (lwo-category? cell LWPH-ENQUIRY))
(defn lwph-enquiry-focus (enquiry) (nth (node_children enquiry) 0))
(defn lwph-enquiry-alternatives (enquiry) (nth (node_children enquiry) 1))
(defn lwph-enquiry-unknown (enquiry) (nth (node_children enquiry) 2))
(defn lwph-enquiry-evidence (enquiry) (nth (node_children enquiry) 3))
(defn lwph-enquiry-path (enquiry) (nth (node_children enquiry) 4))
(defn lwph-enquiry-valid? (enquiry)
    (if (and (eq (lwph-enquiry? enquiry) 1)
             (and (not (node_eq
                          (lwph-enquiry-focus enquiry) (lwo-none)))
                  (and (eq (lwo-category?
                              (lwph-enquiry-alternatives enquiry)
                              LWO-FIELD) 1)
                       (eq (lwph-optional-unknown-valid?
                              (lwph-enquiry-unknown enquiry)) 1)))) 1 0))
(defn lwph-enquiry-current? (world enquiry)
    (if (and (eq (lwph-enquiry-valid? enquiry) 1)
             (and (eq (lwo-active? world enquiry) 1)
                  (eq (lwo-active? world
                        (lwph-enquiry-focus enquiry)) 1))) 1 0))

; children: enquiry, offered safe evaluator token, evidence, local path
(defn lwph-operator (enquiry token evidence)
    (intern_node LWPH-OPERATOR
        (list enquiry (intern_trivial_string token) evidence
              (lwo-local-path))))
(defn lwph-operator? (cell) (lwo-category? cell LWPH-OPERATOR))
(defn lwph-operator-enquiry (operator) (nth (node_children operator) 0))
(defn lwph-operator-token-cell (operator) (nth (node_children operator) 1))
(defn lwph-operator-token (operator)
    (node_value (lwph-operator-token-cell operator)))
(defn lwph-operator-evidence (operator) (nth (node_children operator) 2))
(defn lwph-operator-path (operator) (nth (node_children operator) 3))
(defn lwph-operator-valid? (operator)
    (if (and (eq (lwph-operator? operator) 1)
             (and (eq (lwph-enquiry-valid?
                          (lwph-operator-enquiry operator)) 1)
                  (eq (lwph-source-name-safe?
                          (lwph-operator-token operator)) 1))) 1 0))
(defn lwph-operator-current? (world operator enquiry)
    (if (and (eq (lwph-operator-valid? operator) 1)
             (and (node_eq (lwph-operator-enquiry operator) enquiry)
                  (and (eq (lwph-enquiry-current? world enquiry) 1)
                       (eq (lwo-active? world operator) 1)))) 1 0))

; --- recurrent observations -------------------------------------------

; children: enquiry, exact bindings, optional observed integer, ack,
;           alternatives, optional unknown, evidence, local path
(defn lwph-example
    (enquiry bindings observed ack alternatives unknown evidence)
    (intern_node LWPH-EXAMPLE
        (list enquiry bindings observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwph-example? (cell) (lwo-category? cell LWPH-EXAMPLE))
(defn lwph-example-enquiry (example) (nth (node_children example) 0))
(defn lwph-example-bindings (example) (nth (node_children example) 1))
(defn lwph-example-observed (example) (nth (node_children example) 2))
(defn lwph-example-ack (example) (nth (node_children example) 3))
(defn lwph-example-alternatives (example) (nth (node_children example) 4))
(defn lwph-example-unknown (example) (nth (node_children example) 5))
(defn lwph-example-evidence (example) (nth (node_children example) 6))
(defn lwph-example-path (example) (nth (node_children example) 7))
(defn lwph-example-observed-valid? (example)
    (if (or (node_eq (lwph-example-observed example) (lwo-none))
            (eq (node_type (lwph-example-observed example)) 1)) 1 0))
(defn lwph-example-ack-coherent? (example)
    (do
        (let observed (lwph-example-observed example))
        (let ack (lwph-example-ack example))
        (if (eq (oac-one? ack) 1)
            (if (and (not (node_eq observed (lwo-none)))
                     (node_eq (oac-payload ack) observed)) 1 0)
            (if (eq (oac-nothing? ack) 1)
                (if (node_eq observed (lwo-none)) 1 0)
                (if (eq (oac-alternative-ack? ack) 1)
                    (if (node_eq
                          (oac-alternative-offered (oac-payload ack))
                          observed) 1 0)
                    (if (eq (oac-node? ack) 1)
                        (node_eq (oac-payload ack) observed)
                        1))))))
(defn lwph-example-valid? (example)
    (if (and (eq (lwph-example? example) 1)
             (and (eq (lwph-enquiry-valid?
                          (lwph-example-enquiry example)) 1)
                  (and (eq (lwre-bindings-valid?
                              (lwph-example-bindings example)) 1)
                       (and (eq (lwph-example-observed-valid? example) 1)
                            (and (eq (oac-valid-ack?
                                      (lwph-example-ack example)) 1)
                                 (and (eq (lwo-category?
                                           (lwph-example-alternatives example)
                                           LWO-FIELD) 1)
                                      (and (eq (lwph-optional-unknown-valid?
                                                (lwph-example-unknown example))
                                              1)
                                           (eq (lwph-example-ack-coherent?
                                                example) 1)))))))) 1 0))
(defn lwph-example-scored? (example)
    (if (and (eq (lwph-example-valid? example) 1)
             (eq (oac-one? (lwph-example-ack example)) 1)) 1 0))
(defn lwph-example-current? (world example enquiry)
    (if (and (eq (lwph-example-valid? example) 1)
             (and (node_eq (lwph-example-enquiry example) enquiry)
                  (and (eq (lwph-enquiry-current? world enquiry) 1)
                       (and (eq (lwo-active? world example) 1)
                            (eq (lwre-bindings-current? world
                                  (lwph-example-bindings example)) 1))))) 1 0))

(defn lwph-active-source-count (world cell)
    (lwo-field-size
        (lwt-sources-from-attributions
            (lwo-field-items (lwo-active-attributions-for world cell))
            (lwo-empty-field))))
(defn lwph-operator-recurrent? (world operator enquiry threshold)
    (if (and (gt threshold 0)
             (and (eq (lwph-operator-current? world operator enquiry) 1)
                  (ge (lwph-active-source-count world operator)
                      threshold))) 1 0))
(defn lwph-example-recurrent? (world example enquiry threshold)
    (if (and (gt threshold 0)
             (and (eq (lwph-example-current? world example enquiry) 1)
                  (ge (lwph-active-source-count world example)
                      threshold))) 1 0))

(defn lwph-collect-operators (world items enquiry threshold field)
    (if (eq (len items) 0) field
        (lwph-collect-operators world (tail items) enquiry threshold
            (if (eq (lwph-operator-recurrent?
                        world (head items) enquiry threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwph-operators-for (world enquiry threshold)
    (lwph-collect-operators world
        (lwo-field-items (lwo-world-cells world)) enquiry threshold
        (lwo-empty-field)))
(defn lwph-collect-examples (world items enquiry threshold field)
    (if (eq (len items) 0) field
        (lwph-collect-examples world (tail items) enquiry threshold
            (if (eq (lwph-example-recurrent?
                        world (head items) enquiry threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwph-examples-for (world enquiry threshold)
    (lwph-collect-examples world
        (lwo-field-items (lwo-world-cells world)) enquiry threshold
        (lwo-empty-field)))

; --- source composition and example evaluation ------------------------

(defn lwph-source-for (operator left-name right-name)
    (str_concat "("
        (str_concat (lwph-operator-token operator)
            (str_concat " "
                (str_concat left-name
                    (str_concat " "
                        (str_concat right-name ")")))))))
(defn lwph-recipe-for (operator left-name right-name)
    (lwre-recipe (lwph-source-for operator left-name right-name)
        (lwre-bound-form-contract 128 operator) operator))

; children: example, exact output, comparison ack, state, local path
(defn lwph-evaluation (example output comparison state)
    (intern_node LWPH-EVALUATION
        (list example output comparison state (lwo-local-path))))
(defn lwph-evaluation? (cell) (lwo-category? cell LWPH-EVALUATION))
(defn lwph-evaluation-example (evaluation) (nth (node_children evaluation) 0))
(defn lwph-evaluation-output (evaluation) (nth (node_children evaluation) 1))
(defn lwph-evaluation-comparison (evaluation)
    (nth (node_children evaluation) 2))
(defn lwph-evaluation-state (evaluation) (nth (node_children evaluation) 3))
(defn lwph-evaluation-path (evaluation) (nth (node_children evaluation) 4))
(defn lwph-evaluate-example (recipe example)
    (do
        (let output
            (intern_trivial_int
                (lwre-evaluate-bound recipe
                    (lwph-example-bindings example))))
        (if (eq (lwph-example-scored? example) 0)
            (lwph-evaluation example output (oac-nothing)
                (lwph-unresolved))
            (do
                (let observed (lwph-example-observed example))
                (if (node_eq output observed)
                    (lwph-evaluation example output (oac-one output)
                        (lwph-consistent))
                    (lwph-evaluation example output
                        (oac-alternative-ack observed output example)
                        (lwph-divergent)))))))
(defn lwph-evaluate-examples (recipe items results)
    (if (eq (len items) 0) results
        (lwph-evaluate-examples recipe (tail items)
            (lwo-field-add results
                (lwph-evaluate-example recipe (head items))))))
(defn lwph-evaluations-state-items (items any-consistent any-divergent any-open)
    (if (eq (len items) 0)
        (if (eq any-divergent 1) (lwph-divergent)
            (if (and (eq any-consistent 1) (eq any-open 0))
                (lwph-consistent) (lwph-unresolved)))
        (do
            (let state (lwph-evaluation-state (head items)))
            (lwph-evaluations-state-items (tail items)
                (if (eq (lwph-consistent? state) 1) 1 any-consistent)
                (if (eq (lwph-divergent? state) 1) 1 any-divergent)
                (if (eq (lwph-unresolved? state) 1) 1 any-open)))))
(defn lwph-evaluations-state (evaluations)
    (lwph-evaluations-state-items
        (lwo-field-items evaluations) 0 0 0))

; children: operator, ordered role-name cells, exact generated Recipe,
;           evaluations, state, alternatives, unknowns, local path
(defn lwph-hypothesis
    (operator left-name right-name recipe evaluations state alternatives unknowns)
    (intern_node LWPH-HYPOTHESIS
        (list operator (intern_trivial_string left-name)
              (intern_trivial_string right-name) recipe evaluations state
              alternatives unknowns (lwo-local-path))))
(defn lwph-hypothesis? (cell) (lwo-category? cell LWPH-HYPOTHESIS))
(defn lwph-hypothesis-operator (hypothesis) (nth (node_children hypothesis) 0))
(defn lwph-hypothesis-left-cell (hypothesis) (nth (node_children hypothesis) 1))
(defn lwph-hypothesis-left (hypothesis)
    (node_value (lwph-hypothesis-left-cell hypothesis)))
(defn lwph-hypothesis-right-cell (hypothesis) (nth (node_children hypothesis) 2))
(defn lwph-hypothesis-right (hypothesis)
    (node_value (lwph-hypothesis-right-cell hypothesis)))
(defn lwph-hypothesis-recipe (hypothesis) (nth (node_children hypothesis) 3))
(defn lwph-hypothesis-evaluations (hypothesis) (nth (node_children hypothesis) 4))
(defn lwph-hypothesis-state (hypothesis) (nth (node_children hypothesis) 5))
(defn lwph-hypothesis-alternatives (hypothesis) (nth (node_children hypothesis) 6))
(defn lwph-hypothesis-unknowns (hypothesis) (nth (node_children hypothesis) 7))
(defn lwph-hypothesis-path (hypothesis) (nth (node_children hypothesis) 8))

(defn lwph-example-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwph-example-alternatives-items (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwph-example-alternatives (head items))) field))))
(defn lwph-example-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown (lwph-example-unknown (head items)))
            (lwph-example-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwph-hypothesis-for
    (operator left-name right-name examples enquiry)
    (do
        (let recipe (lwph-recipe-for operator left-name right-name))
        (let evaluations
            (lwph-evaluate-examples recipe
                (lwo-field-items examples) (lwo-empty-field)))
        (let state (lwph-evaluations-state evaluations))
        (let alternatives
            (lwo-field-add
                (lwph-example-alternatives-items
                    (lwo-field-items examples)
                    (lwph-enquiry-alternatives enquiry))
                recipe))
        (let unknowns
            (lwph-example-unknowns-items
                (lwo-field-items examples)
                (if (node_eq (lwph-enquiry-unknown enquiry) (lwo-none))
                    (lwo-empty-field)
                    (lwo-field-add (lwo-empty-field)
                        (lwph-enquiry-unknown enquiry)))))
        (lwph-hypothesis operator left-name right-name recipe evaluations
            state alternatives
            (if (eq (lwph-consistent? state) 1) unknowns
                (lwo-field-add unknowns (lwlc-unknown evaluations))))))

(defn lwph-first-two-binding-names (examples)
    (if (eq (lwo-field-size examples) 0) (list)
        (do
            (let bindings
                (lwre-binding-items
                    (lwph-example-bindings
                        (head (lwo-field-items examples)))))
            (if (lt (len bindings) 2) (list)
                (do
                    (let left (lwre-binding-name (nth bindings 0)))
                    (let right (lwre-binding-name (nth bindings 1)))
                    (if (and (eq (lwph-source-name-safe? left) 1)
                             (eq (lwph-source-name-safe? right) 1))
                        (list left right) (list)))))))
(defn lwph-hypotheses-for-operators
    (items left-name right-name examples enquiry field)
    (if (eq (len items) 0) field
        (do
            (let operator (head items))
            (let forward
                (lwph-hypothesis-for operator left-name right-name
                    examples enquiry))
            (let reverse
                (lwph-hypothesis-for operator right-name left-name
                    examples enquiry))
            (lwph-hypotheses-for-operators (tail items)
                left-name right-name examples enquiry
                (lwo-field-add (lwo-field-add field forward) reverse)))))
(defn lwph-filter-hypotheses (items wanted field)
    (if (eq (len items) 0) field
        (lwph-filter-hypotheses (tail items) wanted
            (if (node_eq (lwph-hypothesis-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))

; --- plural hypothesis field and unanimous admission ------------------

(defn lwph-cell-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwph-cell-witnesses-items world (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items))) field))))
(defn lwph-example-binding-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwph-example-binding-witnesses-items world (tail items)
            (lwph-field-union-items
                (lwo-field-items
                    (lwre-binding-witnesses world
                        (lwph-example-bindings (head items)))) field))))
(defn lwph-field-witnesses (world enquiry operators examples)
    (do
        (let with-enquiry
            (lwph-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world enquiry))
                (lwo-active-attributions-for world
                    (lwph-enquiry-focus enquiry))))
        (let with-operators
            (lwph-cell-witnesses-items world
                (lwo-field-items operators) with-enquiry))
        (let with-examples
            (lwph-cell-witnesses-items world
                (lwo-field-items examples) with-operators))
        (lwph-example-binding-witnesses-items world
            (lwo-field-items examples) with-examples)))

; children: enquiry, recurrent operators/examples, all hypotheses,
;           consistent/refuted/unresolved subsets, status, alternatives,
;           unknowns, witnesses, recurrence threshold, local path
(defn lwph-field
    (enquiry operators examples hypotheses consistent refuted unresolved
     status alternatives unknowns witnesses threshold)
    (intern_node LWPH-FIELD
        (list enquiry operators examples hypotheses consistent refuted
              unresolved status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwph-field? (cell) (lwo-category? cell LWPH-FIELD))
(defn lwph-field-enquiry (field) (nth (node_children field) 0))
(defn lwph-field-operators (field) (nth (node_children field) 1))
(defn lwph-field-examples (field) (nth (node_children field) 2))
(defn lwph-field-hypotheses (field) (nth (node_children field) 3))
(defn lwph-field-consistent (field) (nth (node_children field) 4))
(defn lwph-field-refuted (field) (nth (node_children field) 5))
(defn lwph-field-unresolved (field) (nth (node_children field) 6))
(defn lwph-field-status (field) (nth (node_children field) 7))
(defn lwph-field-alternatives (field) (nth (node_children field) 8))
(defn lwph-field-unknowns (field) (nth (node_children field) 9))
(defn lwph-field-witness-field (field) (nth (node_children field) 10))
(defn lwph-field-threshold-cell (field) (nth (node_children field) 11))
(defn lwph-field-threshold (field)
    (node_value (lwph-field-threshold-cell field)))
(defn lwph-field-path (field) (nth (node_children field) 12))

(defn lwph-field-for (world enquiry threshold)
    (if (or (le threshold 0)
            (eq (lwph-enquiry-current? world enquiry) 0)) (lwo-none)
        (do
            (let operators (lwph-operators-for world enquiry threshold))
            (let examples (lwph-examples-for world enquiry threshold))
            (let names (lwph-first-two-binding-names examples))
            (let hypotheses
                (if (eq (len names) 2)
                    (lwph-hypotheses-for-operators
                        (lwo-field-items operators)
                        (nth names 0) (nth names 1) examples enquiry
                        (lwo-empty-field))
                    (lwo-empty-field)))
            (let consistent
                (lwph-filter-hypotheses
                    (lwo-field-items hypotheses)
                    (lwph-consistent) (lwo-empty-field)))
            (let refuted
                (lwph-filter-hypotheses
                    (lwo-field-items hypotheses)
                    (lwph-divergent) (lwo-empty-field)))
            (let unresolved
                (lwph-filter-hypotheses
                    (lwo-field-items hypotheses)
                    (lwph-unresolved) (lwo-empty-field)))
            (let count (lwo-field-size consistent))
            (let status
                (if (eq (lwo-field-size hypotheses) 0) (lwph-open)
                    (if (gt count 1) (lwph-plural)
                        (if (eq count 1) (lwph-singular)
                            (lwph-refuted)))))
            (let alternatives
                (lwph-field-union-items
                    (lwo-field-items hypotheses)
                    (lwph-enquiry-alternatives enquiry)))
            (let unknowns
                (do
                    (let base
                        (if (node_eq
                              (lwph-enquiry-unknown enquiry) (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwph-enquiry-unknown enquiry))))
                    (if (eq (lwph-singular? status) 1) base
                        (lwo-field-add base
                            (lwlc-unknown hypotheses)))))
            (let witnesses
                (lwph-field-witnesses world enquiry operators examples))
            (lwph-field enquiry operators examples hypotheses consistent
                refuted unresolved status alternatives unknowns witnesses
                threshold))))

(defn lwph-origin (enquiry threshold)
    (intern_node LWPH-ORIGIN
        (list enquiry (intern_trivial_int threshold) (lwo-local-path))))
(defn lwph-origin-enquiry (origin) (nth (node_children origin) 0))
(defn lwph-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwph-proposal (world enquiry threshold)
    (do
        (let field (lwph-field-for world enquiry threshold))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size
                        (lwph-field-hypotheses field)) 0)) (lwo-none)
            (do
                (let witnesses (lwph-field-witness-field field))
                (let count (lwo-field-size witnesses))
                (let origin (lwph-origin enquiry threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwph-field-consistent field)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwph-field-hypotheses field)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwph-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwph-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwph-candidate-current? (world candidate)
    (if (eq (lwph-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwph-proposal world (lwph-origin-enquiry origin)
                    (lwph-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwph-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwph-candidate-current? world candidate) 1)) 1 0))
(defn lwph-integrate (round proposal action)
    (if (eq (lwph-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- held-out probe and non-winning differentiation -------------------

; children: integrated hypothesis field, bindings, optional observed integer,
;           ack, alternatives, optional unknown, evidence, local path
(defn lwph-probe
    (candidate bindings observed ack alternatives unknown evidence)
    (intern_node LWPH-PROBE
        (list candidate bindings observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwph-probe? (cell) (lwo-category? cell LWPH-PROBE))
(defn lwph-probe-candidate (probe) (nth (node_children probe) 0))
(defn lwph-probe-bindings (probe) (nth (node_children probe) 1))
(defn lwph-probe-observed (probe) (nth (node_children probe) 2))
(defn lwph-probe-ack (probe) (nth (node_children probe) 3))
(defn lwph-probe-alternatives (probe) (nth (node_children probe) 4))
(defn lwph-probe-unknown (probe) (nth (node_children probe) 5))
(defn lwph-probe-evidence (probe) (nth (node_children probe) 6))
(defn lwph-probe-path (probe) (nth (node_children probe) 7))
(defn lwph-probe-shape-valid? (probe)
    (if (and (eq (lwph-probe? probe) 1)
             (and (eq (lwph-candidate?
                          (lwph-probe-candidate probe)) 1)
                  (and (eq (lwre-bindings-valid?
                              (lwph-probe-bindings probe)) 1)
                       (and (or (node_eq
                                  (lwph-probe-observed probe) (lwo-none))
                                (eq (node_type
                                      (lwph-probe-observed probe)) 1))
                            (and (eq (oac-valid-ack?
                                      (lwph-probe-ack probe)) 1)
                                 (and (eq (lwo-category?
                                           (lwph-probe-alternatives probe)
                                           LWO-FIELD) 1)
                                      (eq (lwph-optional-unknown-valid?
                                            (lwph-probe-unknown probe)) 1)))))))
        (do
            (let observed (lwph-probe-observed probe))
            (let ack (lwph-probe-ack probe))
            (if (eq (oac-one? ack) 1)
                (if (and (not (node_eq observed (lwo-none)))
                         (node_eq (oac-payload ack) observed)) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    1))) 0))
(defn lwph-probe-current? (world probe threshold)
    (if (and (gt threshold 0)
             (and (eq (lwph-probe-shape-valid? probe) 1)
                  (and (eq (lwph-integrated-current? world
                              (lwph-probe-candidate probe)) 1)
                       (and (eq (lwo-active? world probe) 1)
                            (and (eq (lwre-bindings-current? world
                                      (lwph-probe-bindings probe)) 1)
                                 (ge (lwph-active-source-count world probe)
                                     threshold)))))) 1 0))

; children: hypothesis, exact probe identity, output, comparison, state,
; local path.  The probe is part of evidence identity: equal outputs observed
; on distinct placements are recurrence, not one deduplicated observation.
(defn lwph-probe-eval (hypothesis probe output comparison state)
    (intern_node LWPH-PROBE-EVAL
        (list hypothesis probe output comparison state (lwo-local-path))))
(defn lwph-probe-eval? (cell) (lwo-category? cell LWPH-PROBE-EVAL))
(defn lwph-probe-eval-hypothesis (evaluation)
    (nth (node_children evaluation) 0))
(defn lwph-probe-eval-probe (evaluation) (nth (node_children evaluation) 1))
(defn lwph-probe-eval-output (evaluation) (nth (node_children evaluation) 2))
(defn lwph-probe-eval-comparison (evaluation)
    (nth (node_children evaluation) 3))
(defn lwph-probe-eval-state (evaluation) (nth (node_children evaluation) 4))
(defn lwph-probe-eval-path (evaluation) (nth (node_children evaluation) 5))
(defn lwph-evaluate-probe-hypothesis (hypothesis probe)
    (do
        (let output
            (intern_trivial_int
                (lwre-evaluate-bound
                    (lwph-hypothesis-recipe hypothesis)
                    (lwph-probe-bindings probe))))
        (let observed (lwph-probe-observed probe))
        (let ack (lwph-probe-ack probe))
        (if (or (node_eq observed (lwo-none))
                (eq (oac-nothing? ack) 1))
            (lwph-probe-eval hypothesis probe output (oac-nothing)
                (lwph-unobserved))
            (if (eq (oac-one? ack) 1)
                (if (node_eq output observed)
                    (lwph-probe-eval hypothesis probe output (oac-one output)
                        (lwph-consistent))
                    (lwph-probe-eval hypothesis probe output
                        (oac-alternative-ack observed output probe)
                        (lwph-divergent)))
                (lwph-probe-eval hypothesis probe output ack
                    (lwph-unresolved))))))
(defn lwph-evaluate-probe-items (items probe field)
    (if (eq (len items) 0) field
        (lwph-evaluate-probe-items (tail items) probe
            (lwo-field-add field
                (lwph-evaluate-probe-hypothesis (head items) probe)))))
(defn lwph-filter-probe-evals (items wanted field)
    (if (eq (len items) 0) field
        (lwph-filter-probe-evals (tail items) wanted
            (if (node_eq (lwph-probe-eval-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))
(defn lwph-probe-outputs-items (items field)
    (if (eq (len items) 0) field
        (lwph-probe-outputs-items (tail items)
            (lwo-field-add field
                (lwph-probe-eval-output (head items))))))
(defn lwph-probe-witnesses (world candidate probe)
    (do
        (let with-candidate
            (lwph-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world candidate))
                (lwo-emergent-witnesses candidate)))
        (let with-probe
            (lwph-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world probe))
                with-candidate))
        (lwph-field-union-items
            (lwo-field-items
                (lwre-binding-witnesses world
                    (lwph-probe-bindings probe))) with-probe)))

; children: field candidate, probe, evaluations, output set,
;           confirmed/diverged/unresolved subsets, status, optional predicted
;           output, alternatives, unknowns, witnesses, local path
(defn lwph-placement
    (candidate probe evaluations outputs confirmed diverged unresolved status
     predicted alternatives unknowns witnesses)
    (intern_node LWPH-PLACEMENT
        (list candidate probe evaluations outputs confirmed diverged unresolved
              status predicted alternatives unknowns witnesses
              (lwo-local-path))))
(defn lwph-placement? (cell) (lwo-category? cell LWPH-PLACEMENT))
(defn lwph-placement-candidate (placement) (nth (node_children placement) 0))
(defn lwph-placement-probe (placement) (nth (node_children placement) 1))
(defn lwph-placement-evaluations (placement) (nth (node_children placement) 2))
(defn lwph-placement-outputs (placement) (nth (node_children placement) 3))
(defn lwph-placement-confirmed (placement) (nth (node_children placement) 4))
(defn lwph-placement-diverged (placement) (nth (node_children placement) 5))
(defn lwph-placement-unresolved (placement) (nth (node_children placement) 6))
(defn lwph-placement-status (placement) (nth (node_children placement) 7))
(defn lwph-placement-predicted (placement) (nth (node_children placement) 8))
(defn lwph-placement-alternatives (placement) (nth (node_children placement) 9))
(defn lwph-placement-unknowns (placement) (nth (node_children placement) 10))
(defn lwph-placement-witnesses (placement) (nth (node_children placement) 11))
(defn lwph-placement-path (placement) (nth (node_children placement) 12))

(defn lwph-placement-for (world probe threshold)
    (if (eq (lwph-probe-current? world probe threshold) 0) (lwo-none)
        (do
            (let candidate (lwph-probe-candidate probe))
            (let field (lwo-emergent-shape candidate))
            (let hypotheses (lwph-field-consistent field))
            (let evaluations
                (lwph-evaluate-probe-items
                    (lwo-field-items hypotheses) probe (lwo-empty-field)))
            (let outputs
                (lwph-probe-outputs-items
                    (lwo-field-items evaluations) (lwo-empty-field)))
            (let confirmed
                (lwph-filter-probe-evals
                    (lwo-field-items evaluations)
                    (lwph-consistent) (lwo-empty-field)))
            (let diverged
                (lwph-filter-probe-evals
                    (lwo-field-items evaluations)
                    (lwph-divergent) (lwo-empty-field)))
            (let unresolved
                (lwph-filter-probe-evals
                    (lwo-field-items evaluations)
                    (lwph-unresolved) (lwo-empty-field)))
            (let observed (lwph-probe-observed probe))
            (let status
                (if (eq (lwo-field-size evaluations) 0) (lwph-open)
                    (if (node_eq observed (lwo-none))
                        (if (gt (lwo-field-size outputs) 1)
                            (lwph-branch) (lwph-coherent))
                        (if (gt (lwo-field-size unresolved) 0) (lwph-open)
                            (if (and (gt (lwo-field-size confirmed) 0)
                                     (gt (lwo-field-size diverged) 0))
                                (lwph-discriminated)
                                (if (gt (lwo-field-size confirmed) 0)
                                    (lwph-coherent)
                                    (lwph-contradicted)))))))
            (let predicted
                (if (and (node_eq observed (lwo-none))
                         (eq (lwo-field-size outputs) 1))
                    (head (lwo-field-items outputs)) (lwo-none)))
            (let alternatives
                (lwph-field-union-items
                    (lwo-field-items evaluations)
                    (lwph-field-union-items
                        (lwo-field-items outputs)
                        (lwph-probe-alternatives probe))))
            (let unknowns
                (do
                    (let base
                        (if (node_eq
                              (lwph-probe-unknown probe) (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwph-probe-unknown probe))))
                    (if (or (eq (lwph-branch? status) 1)
                            (or (eq (lwph-discriminated? status) 1)
                                (eq (lwph-contradicted? status) 1)))
                        (lwo-field-add base (lwlc-unknown evaluations))
                        base)))
            (let witnesses (lwph-probe-witnesses world candidate probe))
            (lwph-placement candidate probe evaluations outputs confirmed
                diverged unresolved status predicted alternatives unknowns
                witnesses))))

(defn lwph-probe-origin (probe threshold)
    (intern_node LWPH-PROBE-ORIGIN
        (list probe (intern_trivial_int threshold) (lwo-local-path))))
(defn lwph-probe-origin-probe (origin) (nth (node_children origin) 0))
(defn lwph-probe-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwph-probe-proposal (world probe threshold)
    (do
        (let placement (lwph-placement-for world probe threshold))
        (if (node_eq placement (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwph-placement-witnesses placement))
                (let count (lwo-field-size witnesses))
                (let origin (lwph-probe-origin probe threshold))
                (let candidate
                    (lwo-emergent placement witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwph-placement-evaluations placement)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwph-placement-outputs placement)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwph-probe-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwph-placement?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwph-probe-candidate-current? (world candidate)
    (if (eq (lwph-probe-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwph-probe-proposal world
                    (lwph-probe-origin-probe origin)
                    (lwph-probe-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwph-probe-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwph-probe-candidate-current? world candidate) 1)) 1 0))
(defn lwph-probe-integrate (round proposal action)
    (if (eq (lwph-probe-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))
