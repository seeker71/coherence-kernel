//////////////////////////////////////////////////////////////////////
// voice-track.bml — a track rendered by the body, kept alive by the host's manager, watched by the body.
//
// Two jobs that were shell scripts the first time, and are Form now. The body begins no process for either.
//
// THE WORKER is a SERVICE (docs/launchd/earth.hati.voice-track-worker.plist: the host's manager starts it, and starts it again
// when it dies). It renders the pieces of the tongue named in .hearth/voice-track/worker.request
// (.hearth/voice-track/<tongue>-chunks.txt) with the body's own mouth: phonemes from the body's tables (voice-g2p.bml — no process,
// no oracle), ids from the voice's own table, the whole VITS on this Mac's metal, the samples written beside it as
// .hearth/voice-track/pcm-<tongue>/NNNN.pcm. A piece whose words the body has not been taught is not guessed at: it gets an
// NNNN.untaught marker holding its text, and the track reports it. A piece already rendered is not rendered again, so a worker the
// host cut short resumes where it stopped. The files are the durable result. How far it has got is a RECORD in the shared field
// (voice-track-record.bml): the worker gives {pid, seq, stage, done, total, begun_ms, beat_ms, state} when a piece begins and
// when it lands, and the supervisor reads it as a value.
//
// THE SUPERVISOR never begins the worker and never waits on it as a child. It looks at the record. The GPU wait wedges now
// and then (the process sits in an uninterruptible state at 0% CPU; two clients at once make it likely, one client at a time almost
// never), and a wedged worker looks exactly like a busy one except that no beat comes. When a worker that says it is working has given
// no beat for `VTRIdleMs`, the supervisor ends it with host_signal (SIGTERM, a grace window, SIGKILL) and goes on looking: the next
// worker is the manager's, and it is met as a new pid with a fresh beat. No record at all is the answer "service absent", as
// data: the supervisor says so and, after VTRTries looks without a service, gives up (-1); it does not start one. It is done when
// every piece has its sound or its marker.
//
// THE GPU LEASE (gpu-lease.bml, /tmp/form-gpu.lock, machine-wide) is held by the WORKER and only the worker, for the length of one
// request: vtr-leased-work takes it before the voice opens and gives it back when the request is done. The supervisor never holds
// it. A worker that is ended (or that dies) leaves its lease standing with a dead owner, and the next worker takes it over and says
// so; a supervisor holding the lease across that restart would make every worker wait on its own parent. A worker waiting for the
// lease has given no "working" beat, so it is never judged stalled for waiting its turn.
//////////////////////////////////////////////////////////////////////
import form/form-stdlib/voice-say.bml;
import form/form-stdlib/voice-master.bml;
import form/form-stdlib/gpu-lease.bml;
import form/form-stdlib/voice-track-record.bml;
section [form.bml] {
    class FormVoiceTrack {
        field VTRDir = ".hearth/voice-track";
        field VTRIdleMs = 150000;
        field VTRPollMs = 10000;
        field VTRTermMs = 5000;
        field VTRTries = 30;
        field VTRBatch = 100000;
        field VTRServeMs = 2000;
        field VTRRetryMs = 30000;
        def vtr-pcm-dir(code) = vg-cat([VTRDir(), "/pcm-", code]);
        def vtr-stem(code, i) = vg-cat([vtr-pcm-dir(code), "/", (1000 + i).str()]);
        def vtr-chunks(code) = vg-drop-empty(split-on(read_file(vg-cat([VTRDir(), "/", code, "-chunks.txt"])), vg-nl()));
        // a slower voice than the page's own: how long each tongue is drawn out (VITS length scale)
        def vtr-scale(code) = if ((String) code == "en") then 1.65 else 1.6;
        // ---- the record the worker gives: b is [begun_ms, total]; seq is 2*piece+1 when a piece begins and 2*piece+2 when it lands ----
        def vtr-beat(code, b, stage, done, seq, state) = vtq-give(VTRDir(), code, vtq-new(host_pid(), seq, stage, done, b[1], b[0], now_unix_ms(), state));
        // ---- the worker ----
        def vtr-one(st, cfg, ltab, wtab, mtab, code, i, text) {
            let heard = vg-phonemes(ltab, wtab, mtab, text);
            let ids = if (nothing?(heard)) then [] else if ((Comparable) len(heard) == 0) then [] else vp-ids(cfg, heard);
            if ((Comparable) len(ids) == 0) then vtr-mark-untaught(code, i, text) else vtr-sound(st, code, i, ids);
        }
        def vtr-mark-untaught(code, i, text) {
            let w = write_file(vg-cat([vtr-stem(code, i), ".untaught"]), text);
            print_str(vg-cat([code, " ", i.str(), " untaught"]));
            0;
        }
        // A render allocates its intermediate tensors on the device; the pass entered every one in its ledger and
        // vv-release gives them back once the samples are read, so the carrier's count of live buffers is the same
        // after piece 1 and piece 1000 (voice-pass-leak-band.fk). Before the ledger the pass freed none, and after
        // ~160 renders in one process the allocations answered empty and a render read as zero samples — silently,
        // and the first track wrote those as empty files and called them done (found 2026-10-03). The batch cap and
        // the exit-and-restart stay as a safety net, and an empty rendering is still never written down.
        def vtr-sound(st, code, i, ids) {
            let o = vv-render(st, ids, vtr-scale(code));
            let pcm = vv-pcm(st, o);
            vtr-landed-after(vv-release(st), code, i, pcm);
        }
        // the release's answer is read here, never dropped: a piece is written only after its buffers are given back
        def vtr-landed-after(left, code, i, pcm) = if (left < 0) then form_error("voice-track: the release answered a refusal") else if ((Comparable) len(pcm) == 0) then vtr-silent(code, i) else vtr-write(code, i, pcm);
        def vtr-silent(code, i) {
            print_str(vg-cat([code, " ", i.str(), " rendered no samples"]));
            0;
        }
        def vtr-write(code, i, pcm) {
            let w = write_file(vg-cat([vtr-stem(code, i), ".pcm"]), pcm);
            print_str(vg-cat([code, " ", i.str(), " ", len(pcm).str()]));
            1;
        }
        def vtr-have?(code, i) = if (file_size(vg-cat([vtr-stem(code, i), ".pcm"])) > 0) then 1 else if (file_size(vg-cat([vtr-stem(code, i), ".untaught"])) >= 0) then 1 else 0;
        // a piece the worker has to render gives a beat before it (the render may be the wedge) and one after it (it landed)
        def vtr-render(st, cfg, ltab, wtab, mtab, code, i, text, b) {
            let began = vtr-beat(code, b, "render", i, ((2 * i) + 1), "working");
            let rendered = vtr-one(st, cfg, ltab, wtab, mtab, code, i, text);
            let landed = vtr-beat(code, b, "landed", (i + 1), ((2 * i) + 2), "working");
            rendered;
        }
        def vtr-walk(st, cfg, ltab, wtab, mtab, code, i, xs, budget, b) {
            if ((Comparable) len(xs) == 0) then 0
                else if ((Comparable) budget <= 0) then 0
                else vtr-walk-step(st, cfg, ltab, wtab, mtab, code, i, xs, budget, b, if ((Comparable) vtr-have?(code, i) == 1) then 0 else vtr-render(st, cfg, ltab, wtab, mtab, code, i, xs[0], b));
        }
        def vtr-walk-step(st, cfg, ltab, wtab, mtab, code, i, xs, budget, b, rendered) = vtr-walk(st, cfg, ltab, wtab, mtab, code, (i + 1), xs[1:], (budget - rendered), b);
        // one request, rendered to the end (or to the batch cap). Answers 0 when the voice opened and the walk ended, 1 when the voice would not open.
        def vtr-work(code, begun) {
            let made = fs-mkdir(vtr-pcm-dir(code));
            let b = [begun, len(vtr-chunks(code))];
            let opening = vtr-beat(code, b, "open", vtr-landed(code), 0, "working");
            let name = vs-voice(code);
            let cfg = vp-cfg(name);
            let st = vv-open(vp-model-path(name));
            if ((Comparable) vv-open-ok?(st) == 0) then vtr-refused(code, b, vv-open-why(st))
                else vtr-walked(vtr-walk(st, cfg, vg-load(code, "line"), vg-load(code, "word"), vg-load(code, "model"), code, 0, vtr-chunks(code), VTRBatch(), b));
        }
        def vtr-refused(code, b, why) {
            let said = print_str(vg-cat([code, " voice does not open natively: ", why]));
            1;
        }
        def vtr-walked(walked) = 0;
        // the worker's whole request under the GPU lease; a refused take stops the worker aloud before the device opens
        def vtr-leased-work(code, begun) {
            let lease = gpu-lease-door-held("voice-track-worker");
            let w = vtr-work(code, begun);
            let gave = gpu-lease-door-end(lease);
            w;
        }
        // ---- the service: wait for a request, render it under the lease, say so, wait again. The manager restarts it if it ends. ----
        def vtr-requested() {
            let r = read_file(vg-cat([VTRDir(), "/worker.request"]));
            if (nothing?(r)) then "" else trim(r);
        }
        def vtr-serve() = vtr-serve-loop(now_unix_ms());
        def vtr-serve-loop(begun) = vtr-serve-code(begun, vtr-requested());
        // a request with nothing prepared behind it (no <tongue>-chunks.txt yet) is waited on, not rendered and not a crash
        def vtr-prepared?(code) = if ((Comparable) file_size(vg-cat([VTRDir(), "/", code, "-chunks.txt"])) >= 0) then 1 else 0;
        def vtr-serve-code(begun, code) = if ((Comparable) len(code) == 0) then vtr-serve-rest(begun, VTRServeMs()) else if ((Comparable) vtr-prepared?(code) == 0) then vtr-serve-rest(begun, VTRServeMs()) else vtr-serve-request(begun, code);
        def vtr-serve-request(begun, code) = if ((Comparable) vtr-done?(code) == 1) then vtr-serve-said(begun, code, "done", VTRServeMs()) else vtr-serve-worked(begun, code, vtr-leased-work(code, begun));
        def vtr-serve-worked(begun, code, refused) = if ((Comparable) refused == 1) then vtr-serve-said(begun, code, "refused", VTRRetryMs()) else vtr-serve-said(begun, code, if ((Comparable) vtr-done?(code) == 1) then "done" else "idle", VTRServeMs());
        def vtr-serve-said(begun, code, state, rest) {
            let b = [begun, len(vtr-chunks(code))];
            let gave = vtr-beat(code, b, "idle", vtr-landed(code), 0, state);
            vtr-serve-rest(begun, rest);
        }
        def vtr-serve-rest(begun, ms) {
            let slept = host_sleep_ms(ms);
            vtr-serve-loop(begun);
        }
        // ---- the pieces as WAV, for the ear: the master's own header in front of the samples ----
        def vtr-wav-one(code, i) {
            let p = vg-cat([vtr-stem(code, i), ".pcm"]);
            let pcm = if (file_size(p) > 0) then read_file(p) else "";
            if ((Comparable) len(pcm) == 0) then 0 else vtr-wav-write(code, i, pcm);
        }
        def vtr-wav-write(code, i, pcm) {
            let w = write_file(vg-cat([vtr-stem(code, i), ".wav"]), vg-cat([vmm-wav-header(22050, (len(pcm) / 2)), pcm]));
            1;
        }
        def vtr-wav-go(code, i, n, done) = if (i >= n) then done else vtr-wav-go(code, (i + 1), n, (done + vtr-wav-one(code, i)));
        def vtr-wav-all(code) = vtr-wav-go(code, 0, len(vtr-chunks(code)), 0);
        // ---- the supervisor: it reads the record, it begins nothing ----
        // a piece has landed when its file holds something (an untaught marker holds the text that was refused)
        def vtr-count-go(dir, names, n) = if ((Comparable) len(names) == 0) then n else vtr-count-go(dir, names[1:], if (file_size(vg-cat([dir, "/", names[0]])) > 0) then (n + 1) else n);
        def vtr-landed(code) = vtr-count-go(vtr-pcm-dir(code), fs-list(vtr-pcm-dir(code)), 0);
        def vtr-done?(code) = if ((Comparable) vtr-landed(code) >= len(vtr-chunks(code))) then 1 else 0;
        def vtr-request(code) = write_file(vg-cat([VTRDir(), "/worker.request"]), code);
        // the door functions the pure judgment is handed: the signal door, the aliveness question, the nap
        def vtr-signal-door() = (p, s) => host_signal(p, s);
        def vtr-alive-door() = p => host_alive(p);
        def vtr-nap-door() = ms => host_sleep_ms(ms);
        // the record, read; the writer's pid asked after; the finding as data (vtq-judge): absent, settled, refused, dead, stalled, live
        def vtr-alive-of(reading) = if ((String) reading[0] == "absent") then 0 else host_alive(reading[1][0]);
        def vtr-finding(code, reading) = vtq-judge(reading, now_unix_ms(), VTRIdleMs(), vtr-alive-of(reading));
        def vtr-look(code) = vtr-finding(code, vtq-read(VTRDir(), code));
        // A stalled worker is asked to end (SIGTERM) and, if it has not gone in VTRTermMs, ended (SIGKILL): a process stuck in the GPU
        // wait answers only SIGKILL. It is not waited for -- it is not ours; its parent is the manager, which starts the next. Its GPU
        // lease stays behind with a dead owner; the next worker takes it over (gpu-lease.bml). SIGKILL goes through the host_signal
        // door, the seed's own syscall; no foreign program is run to send it. The answer is the outcome as data (vtq-end).
        def vtr-end(pid) = vtq-end(pid, vtr-signal-door(), vtr-alive-door(), vtr-nap-door(), VTRTermMs());
        // the grace window and what follows it: a worker the SIGTERM did not reach has VTRTermMs to go, then it is ended with SIGKILL.
        // Answers the SIGKILL's own answer (0 sent, -1 the host refused, -2 never a pid of ours), or 0 when it went in the window.
        def vtr-escalate(pid) = vtr-escalated(vtq-grace(pid, vtr-signal-door(), vtr-alive-door(), vtr-nap-door(), VTRTermMs(), nothing()));
        def vtr-escalated(outcome) = if ((String) vtq-outcome-kind(outcome) == "killed") then vtq-last-answer(outcome) else 0;
        // Whether this seed carries the host_signal door. A binary without it names the missing binding when the file is
        // lowered and answers nothing for the call; pid 0 is refused by the door (-2) and signals no process, so asking
        // costs nothing. A run that would reach for SIGKILL hours from now asks first.
        def vtr-door?() = if (nothing?(host_signal(0, 9))) then 0 else 1;
        def vtr-door-missing() = form_error("voice-track: this seed has no host_signal door (runtime/fkwu-uni.c, host door mode 34); rebuild it: cc -O2 -o fkwu.new runtime/fkwu-uni.c && mv fkwu.new fkwu");
        // run a tongue to the end; the count of wedges it took is the answer, -1 when no service was there for VTRTries looks. The door is asked once, before the first look.
        def vtr-supervise(code, tries, wedges) = if ((Comparable) vtr-door?() == 0) then vtr-door-missing() else vtr-supervise-asked(code, tries, wedges, vtr-request(code));
        def vtr-supervise-asked(code, tries, wedges, asked) = vtr-supervise-go(code, tries, wedges);
        // tries counts the looks in a row that found no worker rendering; a worker that breathes while it renders makes it 0 again
        def vtr-supervise-go(code, tries, wedges) {
            if ((Comparable) vtr-done?(code) == 1) then wedges
                else if ((Comparable) tries >= VTRTries()) then vtr-gave-up(code, wedges)
                else vtr-supervise-step(code, tries, wedges, vtr-look(code));
        }
        def vtr-gave-up(code, wedges) {
            let said = print_str(vg-cat([code, " service absent: no worker has given a record or a beat in ", (VTRTries() * VTRPollMs()).str(), " ms; the host's manager starts it (docs/in-process-cells.md), the body does not"]));
            (0 - 1);
        }
        def vtr-supervise-step(code, tries, wedges, finding) {
            if ((String) vtq-kind(finding) == "stalled") then vtr-supervise-ended(code, wedges, finding, vtr-end(vtq-finding-pid(finding)))
                else if ((String) vtq-kind(finding) == "live" && (String) finding[2] == "working") then vtr-supervise-rest(code, 0, wedges)
                else vtr-supervise-rest(code, (tries + 1), wedges);
        }
        def vtr-supervise-ended(code, wedges, finding, outcome) {
            let said = print_str(vg-cat([code, " worker ", vtq-finding-pid(finding).str(), " gave no beat for ", finding[2].str(), " ms; ended: ", (String) vtq-outcome-kind(outcome)]));
            vtr-supervise-rest(code, 0, (wedges + 1));
        }
        def vtr-supervise-rest(code, tries, wedges) {
            let slept = host_sleep_ms(VTRPollMs());
            vtr-supervise-go(code, tries, wedges);
        }
    }
    0;
}
