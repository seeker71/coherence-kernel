; form-knowledge-axioms-one-family-crossing.fk -- the smallest complete
; public/local crossing for one canonical family.
;
; This cell joins three independently executable inputs for `axioms`:
; two public heldout presentation trials (fresh stream lanes a/b), one public
; generative row with no more than one supervised repair, and one family-bound
; native recipe execution check.  All three must name the same local model and
; run, and every state/context/carrier release must be observed.
;
; Honest finalizer seam: public-family-heldout-evidence-v2 is deliberately a
; whole-current-census object.  Its live family/trial count is a fresh
; denominator, not a permanent target.  Therefore this
; cell retains the two valid axioms trials as a typed
; one-family heldout input and leaves canonical heldout evidence as `nothing`.
; It never manufactures a global report.  Generative and execution evidence
; are already family-local and remain canonical fkpfm v2 rows.
;
; The diagnostic membrane carries ids, counters, hashes and source coordinates
; only.  Prompt and answer bytes do not enter its envelopes.  Its actuator
; admits continue, branch, revise, abstain and request-evidence as real next
; states, and correlation mismatch selects the offered alternative.
;
; Pure only.  The dormant physical door is
; observe/qwen38-axioms-one-family-complete-live-run.fk.
;
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk
; preludes: form-stdlib/form-knowledge-public-generative-school.fk
; preludes: form-stdlib/form-knowledge-family-native-exec-teach-check.fk
; preludes: form-stdlib/form-knowledge-axioms-vertical-finalizer.fk
; preludes: observe/bidirectional-framebuffer-channel.fk
; Proven by: form-stdlib/tests/form-knowledge-axioms-one-family-crossing-band.fk

(do
    (defn fka1-family () "axioms")
    (defn fka1-heldout-seam ()
        "canonical heldout evidence waits for the complete current-census report; the two axioms trials are retained without freezing the census or inventing that report")
    (defn fka1-bit? (n) (if (or (eq n 0) (eq n 1)) 1 0))
    (defn fka1-trial-family (t)
        (fkp30-presentation-family (fkp30-trial-presentation t)))
    (defn fka1-trial-lane (t)
        (fkp30-presentation-lane (fkp30-trial-presentation t)))
    (defn fka1-trial-score95? (t)
        (fkhe-at-least95?
            (nmfe-obs-promotion
                (fkhe-score-observation (fkp30-trial-score t)))))

    ; heldout input = tag family trial-a trial-b pair-sha canonical-evidence seam
    (defn fka1-heldout-message (a b)
        (nmfe-fields (list "axioms-one-family-heldout-pair-v1"
            (fkp30-trial-model-id a) (fkp30-trial-run-id a)
            (fkp30-trial-session-id a)
            (fkp30-presentation-trial-id (fkp30-trial-presentation a))
            (fkp30-trial-output-sha a) (fkp30-trial-family-nonce a)
            (fkp30-trial-content-sha a)
            (fkp30-presentation-trial-id (fkp30-trial-presentation b))
            (fkp30-trial-output-sha b) (fkp30-trial-family-nonce b)
            (fkp30-trial-content-sha b))))
    (defn fka1-heldout-input (a b)
        (list "axioms-one-family-heldout-input-v1" (fka1-family) a b
            (nmfe-sha256 (fka1-heldout-message a b))
            (nothing) (fka1-heldout-seam)))
    (defn fka1-heldout-a (h) (nth h 2))
    (defn fka1-heldout-b (h) (nth h 3))
    (defn fka1-heldout-pair-sha (h) (nth h 4))
    (defn fka1-heldout-canonical-evidence (h) (nth h 5))
    ; Observed baseline validity retains a well-bound failed score instead of
    ; erasing it. Mastery validity is the stricter wrapper immediately below.
    (defn fka1-heldout-input-observed? (h)
        (if (not (eq (fkpfm-list? h) 1)) 0
        (if (not (eq (len h) 7)) 0
        (if (not (str_eq (head h)
                         "axioms-one-family-heldout-input-v1")) 0
            (do
                (let a (fka1-heldout-a h))
                (let b (fka1-heldout-b h))
                (if (not (eq (fkp30-trial-valid? a) 1)) 0
                (if (not (eq (fkp30-trial-valid? b) 1)) 0
                (fkfne-all? (list
                    (str_eq (nth h 1) (fka1-family))
                    (str_eq (fka1-trial-family a) (fka1-family))
                    (str_eq (fka1-trial-family b) (fka1-family))
                    (str_eq (fka1-trial-lane a) "a")
                    (str_eq (fka1-trial-lane b) "b")
                    (str_eq (fkp30-presentation-row-id
                                (fkp30-trial-presentation a))
                            (fkp30-presentation-row-id
                                (fkp30-trial-presentation b)))
                    (str_eq (fkp30-trial-model-id a)
                            (fkp30-trial-model-id b))
                    (str_eq (fkp30-trial-run-id a)
                            (fkp30-trial-run-id b))
                    (str_eq (fkp30-trial-session-id a)
                            (fkp30-trial-session-id b))
                    (not (str_eq (fkp30-trial-output-sha a)
                                 (fkp30-trial-output-sha b)))
                    (not (str_eq (fkp30-trial-family-nonce a)
                                 (fkp30-trial-family-nonce b)))
                    (eq (fkp30-trial-model-executed a) 1)
                    (eq (fkp30-trial-model-executed b) 1)
                    (eq (fkp30-trial-state-released a) 1)
                    (eq (fkp30-trial-state-released b) 1)
                    (eq (fkp30-trial-same-residence a) 1)
                    (eq (fkp30-trial-same-residence b) 1)
                    (eq (fkp30-trial-telemetry-present? a) 1)
                    (eq (fkp30-trial-telemetry-present? b) 1)
                    (str_eq (fka1-heldout-pair-sha h)
                            (nmfe-sha256 (fka1-heldout-message a b)))
                    (nothing? (fka1-heldout-canonical-evidence h))
                    (str_eq (nth h 6) (fka1-heldout-seam)))))))))))
    (defn fka1-heldout-input-valid? (h)
        (if (not (eq (fka1-heldout-input-observed? h) 1)) 0
            (if (and (eq (fka1-trial-score95? (fka1-heldout-a h)) 1)
                     (eq (fka1-trial-score95? (fka1-heldout-b h)) 1)) 1 0)))

    ; Residence continuity is an in-process handle-equality witness. It binds
    ; stage transitions and releases to the declared model/run but does not
    ; cryptographically authenticate GPU silicon or model weights.
    (defn fka1-residence-auth-seam ()
        "in-process q38 handle continuity is observed; physical hardware/model authenticity is not cryptographically attested")
    (defn fka1-residence-transition
        (stage same-context fresh-state state-released)
        (list "axioms-residence-transition-v1" stage same-context
              fresh-state state-released))
    (defn fka1-residence-transition-valid? (t)
        (if (not (eq (fkpfm-list? t) 1)) 0
        (if (not (eq (len t) 5)) 0
        (if (not (str_eq (head t) "axioms-residence-transition-v1")) 0
            (if (and (gt (str_len (nth t 1)) 0)
                 (and (eq (fka1-bit? (nth t 2)) 1)
                 (and (eq (fka1-bit? (nth t 3)) 1)
                      (eq (fka1-bit? (nth t 4)) 1)))) 1 0)))))
    (defn fka1-residence-transitions-valid? (rows)
        (if (not (eq (fkpfm-list? rows) 1)) 0
        (if (not (or (eq (len rows) 4) (eq (len rows) 5))) 0
        (if (not (eq (fka1-residence-transitions-valid-tail? rows) 1)) 0
            (if (and
                    (str_eq (nth (nth rows 0) 1) "heldout-a")
                    (and
                        (str_eq (nth (nth rows 1) 1) "heldout-b")
                        (and
                            (str_eq (nth (nth rows 2) 1)
                                    "generative-attempt")
                            (if (eq (len rows) 4)
                                (str_eq (nth (nth rows 3) 1)
                                        "native-request")
                                (and
                                    (str_eq (nth (nth rows 3) 1)
                                            "generative-repair")
                                    (str_eq (nth (nth rows 4) 1)
                                            "native-request")))))) 1 0)))))
    (defn fka1-residence-transitions-valid-tail? (rows)
        (if (eq (len rows) 0) 1
            (if (and (eq (fka1-residence-transition-valid? (head rows)) 1)
                 (and (eq (nth (head rows) 2) 1)
                 (and (eq (nth (head rows) 3) 1)
                      (eq (nth (head rows) 4) 1))))
                (fka1-residence-transitions-valid-tail? (tail rows)) 0)))
    (defn fka1-residence-message
        (model-id run-id transitions opens reopens release-ok authenticated)
        (fkpfm-canonical (list "axioms-residence-witness-v1" model-id run-id
            transitions opens reopens release-ok authenticated
            (fka1-residence-auth-seam))))
    ; witness = tag model run transitions opens reopens release authenticated
    ;           auth-seam witness-sha
    (defn fka1-residence-witness
        (model-id run-id transitions opens reopens release-ok)
        (list "axioms-residence-witness-v1" model-id run-id transitions
            opens reopens release-ok 0 (fka1-residence-auth-seam)
            (nmfe-sha256 (fka1-residence-message model-id run-id transitions
                opens reopens release-ok 0))))
    (defn fka1-residence-witness-valid? (w)
        (if (not (eq (fkpfm-list? w) 1)) 0
        (if (not (eq (len w) 10)) 0
        (if (not (str_eq (head w) "axioms-residence-witness-v1")) 0
            (if (and (gt (str_len (nth w 1)) 0)
                 (and (eq (nmfe-sha256? (nth w 2)) 1)
                 (and (eq (fka1-residence-transitions-valid? (nth w 3)) 1)
                 (and (eq (nth w 4) 1)
                 (and (eq (nth w 5) 0)
                 (and (eq (nth w 6) 1)
                 (and (eq (nth w 7) 0)
                 (and (str_eq (nth w 8) (fka1-residence-auth-seam))
                      (str_eq (nth w 9)
                        (nmfe-sha256 (fka1-residence-message
                            (nth w 1) (nth w 2) (nth w 3) (nth w 4)
                            (nth w 5) (nth w 6) (nth w 7)))))))))))) 1 0)))))

    ; Dynamic post-crossing projection. Exact current IDs plus a bounded source
    ; access mark make ordinary census drift observable without embedding a
    ; literal target count. This is deliberately not a full source digest: the
    ; current Form sha256 recipe is O(n^2) over this source-sized input.
    (defn fka1-census-source ()
        "form/form-stdlib/form-knowledge-public-family-mastery.fk")
    (defn fka1-census-freshness-seam ()
        "bounded size+mtime+edge-byte mark; a same-size interior rewrite with preserved mtime can escape this mark")
    ; freshness = tag size mtime first-byte last-byte honest-seam
    (defn fka1-census-source-freshness ()
        (do
            (let source (fka1-census-source))
            (let size (file_size source))
            (let mtime (file_mtime source))
            (let first (if (gt size 0)
                (str_byte_at (read_file_slice source 0 1) 0) -1))
            (let last (if (gt size 0)
                (str_byte_at (read_file_slice source (sub size 1) 1) 0) -1))
            (list "axioms-census-bounded-freshness-v1" size mtime first last
                (fka1-census-freshness-seam))))
    (defn fka1-census-source-freshness-valid? (f)
        (if (not (eq (fkpfm-list? f) 1)) 0
        (if (not (eq (len f) 6)) 0
        (if (not (str_eq (head f)
                         "axioms-census-bounded-freshness-v1")) 0
            (if (and (gt (nth f 1) 0)
                 (and (ge (nth f 2) 0)
                 (and (ge (nth f 3) 0)
                 (and (ge (nth f 4) 0)
                      (str_eq (nth f 5)
                              (fka1-census-freshness-seam)))))) 1 0)))))
    (defn fka1-census-message (ids total source freshness)
        (fkpfm-canonical (list "axioms-post-crossing-census-v1" ids total
            source freshness)))
    (defn fka1-census-snapshot ()
        (do
            (let ids (fkpfm-family-ids))
            (let source (fka1-census-source))
            (let freshness (fka1-census-source-freshness))
            (list "axioms-post-crossing-census-v1" ids (len ids) source
                freshness (nmfe-sha256
                    (fka1-census-message ids (len ids) source freshness)))))
    (defn fka1-census-snapshot-valid? (s)
        (if (not (eq (fkpfm-list? s) 1)) 0
        (if (not (eq (len s) 6)) 0
        (if (not (str_eq (head s) "axioms-post-crossing-census-v1")) 0
            (if (eq (fkfne-all? (list
                    (eq (fkpfm-list? (nth s 1)) 1)
                    (eq (fkpfm-equal? (nth s 1)
                        (fkpfm-family-ids)) 1)
                    (eq (nth s 2) (len (nth s 1)))
                    (str_eq (nth s 3) (fka1-census-source))
                    (eq (fka1-census-source-freshness-valid? (nth s 4)) 1)
                    (eq (fkpfm-equal? (nth s 4)
                        (fka1-census-source-freshness)) 1)
                    (str_eq (nth s 5) (nmfe-sha256
                        (fka1-census-message (nth s 1) (nth s 2)
                            (nth s 3) (nth s 4)))))) 1) 1 0)))))

    ; Diagnostics. issue: 0=none, 1=surprise, 2=nothing, 3=timeout,
    ; 4=refusal.  The payload contains no content bytes.
    (defn fka1-diag-action (phase issue)
        (if (eq issue 0) 0
        (if (eq issue 1) 1
        (if (eq issue 2) 4
        (if (eq issue 3)
            (if (or (str_eq phase "heldout-a")
                    (str_eq phase "heldout-b")) 4 3)
        (if (and (eq issue 4) (str_eq phase "generative-attempt")) 2
            3))))))
    (defn fka1-diag-out
        (exchange phase issue source-sha observed-sha before after alternative)
        (bfc-envelope 0 exchange 0
            (list phase issue source-sha observed-sha before after 0)
            alternative))
    (defn fka1-diag-in (out phase issue)
        (bfc-control out (fka1-diag-action phase issue)))
    (defn fka1-diag-response-valid? (out in)
        (if (or (nothing? in)
            (or (not (eq (bfc-direction in) 1))
            (or (not (eq (bfc-kind in) 1))
                (not (eq (bfc-exchange out) (bfc-exchange in)))))) 0 1))
    (defn fka1-diag-next (out in phase current alternative)
        (if (eq (fka1-diag-response-valid? out in) 0) alternative
            (do
                (let action (bfc-payload in))
                (if (eq action 0) current
                (if (eq action 1) alternative
                (if (eq action 2)
                    (if (str_eq phase "generative-attempt")
                        "repair" alternative)
                (if (eq action 3) "release"
                (if (eq action 4) "request-evidence" alternative))))))))

    ; Public heldout misses are baselines, not stop signs. A correlated
    ; surprise branches after both lanes into the curriculum experiment.
    ; Nothing/timeout request evidence and take that same branch only when the
    ; public packet is usable. Refusal still releases. The exposed packet is
    ; never relabeled heldout evidence.
    (defn fka1-heldout-learning-route (phase issue packet-usable)
        (do
            (let current (if (str_eq phase "heldout-a")
                "heldout-b" "generative"))
            (let alternative (if (str_eq phase "heldout-a")
                "heldout-b+curriculum" "curriculum"))
            (let out (fka1-diag-out 1901 phase issue
                (nmfe-sha256 "public-heldout-source")
                (nmfe-sha256 "opaque-baseline") 0 0 alternative))
            (let in (fka1-diag-in out phase issue))
            (let selected (fka1-diag-next out in phase current alternative))
            (if (str_eq selected "request-evidence")
                (if (eq packet-usable 1) alternative "release")
                (if (or (str_eq selected alternative)
                        (str_eq selected "heldout-b+curriculum"))
                    (if (eq packet-usable 1) selected "release") selected))))

    ; diag summary = tag phase observations controls reobservations frames
    ;                private-content-bytes
    (defn fka1-diag-summary
        (phases observations controls reobservations frames private-bytes)
        (list "axioms-one-family-diagnostics-v1" phases observations
              controls reobservations frames private-bytes))
    (defn fka1-diag-summary-valid? (d)
        (if (not (eq (fkpfm-list? d) 1)) 0
        (if (not (eq (len d) 7)) 0
        (if (not (str_eq (head d) "axioms-one-family-diagnostics-v1")) 0
            (if (and (ge (nth d 1) 11)
                 (and (ge (nth d 2) (nth d 1))
                 (and (ge (nth d 3) 0)
                 (and (eq (nth d 4) (nth d 3))
                 (and (ge (nth d 5)
                          (add (nth d 2) (nth d 3)))
                      (eq (nth d 6) 0)))))) 1 0)))))

    ; crossing = tag family heldout generative-row generative-evidence
    ;            native-check execution-evidence model run open reopens remote
    ;            release diagnostics residence-witness census-snapshot
    ;            vertical-result local-complete canonical-finalizer-ready
    (defn fka1-crossing
        (heldout generative-row generative-evidence native-check
         execution-evidence model-id run-id opens reopens remote-calls
         release-ok diagnostics residence-witness census-snapshot
         vertical-result)
        (list "axioms-one-family-crossing-v1" (fka1-family) heldout
              generative-row generative-evidence native-check execution-evidence
              model-id run-id opens reopens remote-calls release-ok diagnostics
              residence-witness census-snapshot vertical-result 1 0))
    (defn fka1-crossing-heldout (c) (nth c 2))
    (defn fka1-crossing-generative-row (c) (nth c 3))
    (defn fka1-crossing-generative-evidence (c) (nth c 4))
    (defn fka1-crossing-native-check (c) (nth c 5))
    (defn fka1-crossing-execution-evidence (c) (nth c 6))
    (defn fka1-crossing-model-id (c) (nth c 7))
    (defn fka1-crossing-run-id (c) (nth c 8))
    (defn fka1-crossing-diagnostics (c) (nth c 13))
    (defn fka1-crossing-residence-witness (c) (nth c 14))
    (defn fka1-crossing-census-snapshot (c) (nth c 15))
    (defn fka1-crossing-vertical-result (c) (nth c 16))
    (defn fka1-three-inputs (c)
        (list (fka1-crossing-heldout c)
              (fka1-crossing-generative-evidence c)
              (fka1-crossing-execution-evidence c)))
    (defn fka1-crossing-valid? (c)
        (if (not (eq (fkpfm-list? c) 1)) 0
        (if (not (eq (len c) 19)) 0
        (if (not (str_eq (head c) "axioms-one-family-crossing-v1")) 0
        (if (not (eq (fka1-heldout-input-valid?
                          (fka1-crossing-heldout c)) 1)) 0
        (if (not (eq (fkpfm-list?
                          (fka1-crossing-generative-row c)) 1)) 0
        (if (not (eq (len (fka1-crossing-generative-row c)) 7)) 0
        (if (not (eq (fkpfm-generative-valid?
                          (fka1-crossing-generative-evidence c)) 1)) 0
        (if (not (eq (fkfne-check-valid?
                          (fka1-crossing-native-check c)) 1)) 0
        (if (not (eq (fkpfm-execution-valid?
                          (fka1-crossing-execution-evidence c)) 1)) 0
            (do
                (let held (fka1-crossing-heldout c))
                (let a (fka1-heldout-a held))
                (let gen-row (fka1-crossing-generative-row c))
                (let gen (fka1-crossing-generative-evidence c))
                (let native (fka1-crossing-native-check c))
                (let exec (fka1-crossing-execution-evidence c))
                (let vertical (fka1-crossing-vertical-result c))
                (let residence (fka1-crossing-residence-witness c))
                (let census (fka1-crossing-census-snapshot c))
                (let final-attempt (fkg15-row-final-attempt gen-row))
                (fkfne-all? (list
                    (str_eq (nth c 1) (fka1-family))
                    (eq (fkg15-row-valid? gen-row) 1)
                    (str_eq (fkg15-plan-family (fkg15-row-plan gen-row))
                            (fka1-family))
                    (eq (fkpfm-equal? gen
                            (fkg15-evidence-for-row gen-row 1)) 1)
                    (str_eq (fkfne-binding-family
                                (fkfne-check-binding native))
                            (fka1-family))
                    (eq (fkpfm-equal? exec
                            (fkfne-check-evidence native)) 1)
                    (str_eq (nth c 7) (fkp30-trial-model-id a))
                    (str_eq (nth c 7)
                            (fkg15-attempt-model-id final-attempt))
                    (str_eq (nth c 7) (fkfne-check-model-id native))
                    (str_eq (nth c 8) (fkp30-trial-run-id a))
                    (str_eq (nth c 8)
                            (fkg15-attempt-run-id final-attempt))
                    (str_eq (nth c 8) (fkfne-check-run-id native))
                    (eq (nth c 9) 1)
                    (eq (nth c 10) 0)
                    (eq (nth c 11) 0)
                    (eq (nth c 12) 1)
                    (eq (fka1-diag-summary-valid? (nth c 13)) 1)
                    (eq (fka1-residence-witness-valid? residence) 1)
                    (str_eq (nth residence 1) (nth c 7))
                    (str_eq (nth residence 2) (nth c 8))
                    (eq (nth residence 4) (nth c 9))
                    (eq (nth residence 5) (nth c 10))
                    (eq (nth residence 6) (nth c 12))
                    (eq (fka1-census-snapshot-valid? census) 1)
                    (eq (fkav-result-valid? vertical) 1)
                    (eq (fkpfm-equal? vertical
                        (fkav-result (list (fka1-heldout-a held)
                                          (fka1-heldout-b held)) gen exec)) 1)
                    (eq (fkav-result-ready? vertical) 1)
                    (eq (nth c 17) 1)
                    (eq (nth c 18) 0))))))))))))))

    (defn fka1-local-complete? (c) (fka1-crossing-valid? c))
    (defn fka1-canonical-finalizer-ready? (c)
        ; The global heldout report has not been fabricated.
        (if (eq (fka1-crossing-valid? c) 1) 0 0))

    0)
