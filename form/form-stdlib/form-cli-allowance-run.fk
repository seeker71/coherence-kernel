; form-cli-allowance-run.fk — watch Allowance express, live.
;
; Kernel framebuffer is written DURING the walk (ala-fb-pulse).
; Metal/JIT/MLX are named doors. Form-CPU intern is the body gas asked for.
; No prompt text in the organ.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-allowance-xtal.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn ala-fb-pulse (flow step)
        (if (eq (len flow) 0) 0
            (do
                (fb_record (intern_trivial_int step) "form-cli-allowance-run.fk" step)
                (ala-fb-pulse (tail flow) (add step 1)))))
    (print "form-cli executed allowance\n")
    (print "form-cli live-len=")
    (print (int_to_str (len (ala-live))))
    (print " gas-born=")
    (print (int_to_str (ala-gas-born (ala-live))))
    (print " gas-value=")
    (print (int_to_str (ala-gas-value (ala-live))))
    (print " gas-token=")
    (print (int_to_str (ala-gas-token (ala-live))))
    (print "\nform-cli evolved-token=")
    (print (int_to_str (ala-gas-token (ala-evolved))))
    (print " evo=")
    (print (int_to_str (ala-evo)))
    (print " express-live=")
    (print (int_to_str (ala-express (ala-live) 1 (ala-evo))))
    (print " express-canned=")
    (print (int_to_str (ala-express (ala-canned) 0 0)))
    (print "\nform-cli door-metal=")
    (print (int_to_str (ala-door 1 0)))
    (print " door-cpu=")
    (print (int_to_str (ala-door 0 0)))
    (print " door-jit=")
    (print (int_to_str (ala-door 1 5)))
    (print " cell-children=")
    (print (int_to_str (len (node_children (intern_node (bp "add") (list (intern_trivial_int 2) (intern_trivial_int 3)))))))
    (print " check=")
    (print (int_to_str (ala-check)))
    (print "\n")
    (framebuffer-clear)
    (ala-fb-pulse (ala-flow) 0)
    (print "form-cli fb-live=")
    (print (int_to_str (len (framebuffer-events))))
    (print " fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli metal=")
    (print (metal_status))
    (print "\n")
    0)
