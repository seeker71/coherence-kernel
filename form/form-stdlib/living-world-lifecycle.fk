; living-world-lifecycle.fk -- admitted meaning reopens when its ground moves.
;
; Integration is not permanent authority.  A recursive mapping is STEADY only
; while its entire evidence snapshot is content-identical and every original
; witness remains active.  New support, new contradiction, attribution change,
; or witness release moves it to REOPEN.  Candidate release is named
; separately.  A reopened mapping cannot act; it may only form a fresh
; proposal whose participants include the current evidence field and the
; holders of the earlier candidate.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk

(let LWRL-STATE         (bp "LWRL-STATE"))
(let LWRL-STEADY        (bp "LWRL-STEADY"))
(let LWRL-REOPEN        (bp "LWRL-REOPEN"))
(let LWRL-RELEASED      (bp "LWRL-RELEASED"))
(let LWRL-REOPEN-ORIGIN (bp "LWRL-REOPEN-ORIGIN"))

(defn lwrl-steady () (intern_node LWRL-STEADY (empty)))
(defn lwrl-reopen () (intern_node LWRL-REOPEN (empty)))
(defn lwrl-released () (intern_node LWRL-RELEASED (empty)))

(defn lwrl-recursive-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrr-mapping? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwrl-current-mapping (world candidate)
    (do
        (let prior (lwo-emergent-shape candidate))
        (let signature (lwrr-mapping-signature prior))
        (lwrr-mapping-for signature
            (lwrr-evidence-set-for world signature))))

; children: candidate, prior mapping, current mapping, support delta,
;           counterexample delta, status
(defn lwrl-state-node (candidate prior current support-delta counter-delta status)
    (intern_node LWRL-STATE
        (list candidate prior current
              (intern_trivial_int support-delta)
              (intern_trivial_int counter-delta) status)))
(defn lwrl-state-candidate (state) (nth (node_children state) 0))
(defn lwrl-state-prior-mapping (state) (nth (node_children state) 1))
(defn lwrl-state-current-mapping (state) (nth (node_children state) 2))
(defn lwrl-state-support-delta (state)
    (node_value (nth (node_children state) 3)))
(defn lwrl-state-counterexample-delta (state)
    (node_value (nth (node_children state) 4)))
(defn lwrl-state-status (state) (nth (node_children state) 5))

(defn lwrl-mapping-support-count (mapping)
    (lwo-field-size (lwrr-mapping-supports mapping)))
(defn lwrl-mapping-counter-count (mapping)
    (lwo-field-size (lwrr-mapping-counterexamples mapping)))

(defn lwrl-state (world candidate)
    (if (eq (lwrl-recursive-candidate? candidate) 0)
        (lwrl-state-node candidate (lwo-none) (lwo-none) 0 0
                         (lwrl-released))
        (do
            (let prior (lwo-emergent-shape candidate))
            (let current (lwrl-current-mapping world candidate))
            (let support-delta
                (sub (lwrl-mapping-support-count current)
                     (lwrl-mapping-support-count prior)))
            (let counter-delta
                (sub (lwrl-mapping-counter-count current)
                     (lwrl-mapping-counter-count prior)))
            (let status
                (if (eq (lwo-active? world candidate) 0)
                    (lwrl-released)
                    (if (and (node_eq prior current)
                             (eq (lwo-emergent-ready? world candidate) 1))
                        (lwrl-steady)
                        (lwrl-reopen))))
            (lwrl-state-node candidate prior current
                             support-delta counter-delta status))))

(defn lwrl-steady? (world candidate)
    (if (node_eq (lwrl-state-status (lwrl-state world candidate))
                 (lwrl-steady)) 1 0))

(defn lwrl-old-participants (world candidate)
    (lwt-sources-from-attributions
        (lwo-field-items (lwo-active-attributions-for world candidate))
        (lwo-empty-field)))

(defn lwrl-reopen-origin (old-candidate fresh-proposal state)
    (intern_node LWRL-REOPEN-ORIGIN
        (list old-candidate fresh-proposal state)))

(defn lwrl-reopen-from-fresh (world old-candidate fresh-proposal state)
    (do
        (let fresh-candidate (lwt-proposal-candidate fresh-proposal))
        (let origin (lwrl-reopen-origin old-candidate fresh-proposal state))
        (let candidate
            (lwo-emergent
                (lwo-emergent-shape fresh-candidate)
                (lwo-emergent-witnesses fresh-candidate)
                (intern_trivial_int (lwo-emergent-coherence fresh-candidate))
                (intern_trivial_int (lwo-emergent-resonance fresh-candidate))
                (intern_trivial_int (lwo-emergent-threshold fresh-candidate))
                origin))
        (let participants
            (lwr-field-union-items
                (lwo-field-items (lwrl-old-participants world old-candidate))
                (lwt-proposal-participants fresh-proposal)))
        (lwt-proposal candidate participants origin)))

(defn lwrl-fresh-proposal (world state threshold)
    (do
        (let signature
            (lwrr-mapping-signature
                (lwrl-state-current-mapping state)))
        (let evidence-set (lwrr-evidence-set-for world signature))
        (if (eq (lwrr-proposal-evidence-ready?
                    signature evidence-set threshold) 0)
            (lwo-none)
            (lwrr-proposal-from-evidence
                signature evidence-set threshold))))

(defn lwrl-reopen-proposal (world old-candidate threshold)
    (do
        (let state (lwrl-state world old-candidate))
        (if (not (node_eq (lwrl-state-status state) (lwrl-reopen)))
            (lwo-none)
            (do
                (let fresh (lwrl-fresh-proposal world state threshold))
                (if (node_eq fresh (lwo-none)) (lwo-none)
                    (lwrl-reopen-from-fresh
                        world old-candidate fresh state))))))
