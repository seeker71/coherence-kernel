        !pise-resolution?(resolution) ? rpsw-investigate-micro-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, rpsw-no-micro-walk(), rpsw-no-trace(), rpsw-reason-malformed-symbol-resolution()) : !((String) pise-resolution-status(resolution) == pise-status-ready()) ? rpsw-terminal-resolution-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution) : {
            let micro-walk = rpmw-walk-entry-with-kind(envelope, admission, pise-resolution-entry-index(resolution), step-budget, input-value, input-kind);
            !rpmw-receipt?(micro-walk) ? rpsw-investigate-micro-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, micro-walk, rpsw-no-trace(), rpsw-reason-malformed-micro-walk-receipt()) : (String) rpmw-receipt-status(micro-walk) == rpmw-status-refused() ? rpsw-micro-terminal-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, micro-walk) : !((String) rpmw-receipt-status(micro-walk) == rpmw-status-trace-produced()) ? rpsw-investigate-micro-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, micro-walk, rpmw-receipt-trace(micro-walk), rpsw-reason-malformed-micro-walk-receipt()) : {
                let trace = rpmw-receipt-trace(micro-walk);
                let agreement = rpsw-produced-agreement-reason(envelope, admission, symbol-request, resolution, micro-walk, trace, step-budget, input-value, input-kind);
                (String) agreement == rpsw-reason-agreement-ready() ? rpsw-produced-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, micro-walk, trace) : rpsw-investigate-micro-with-kind(envelope, admission, symbol-request, step-budget, input-value, input-kind, resolution, micro-walk, trace, agreement);
            };
        };
    };
    def rpsw-walk-symbol(envelope, admission, symbol-request, step-budget, input-value) = rpsw-walk-symbol-with-kind(envelope, admission, symbol-request, step-budget, input-value, rpmw-kind-int());
}
