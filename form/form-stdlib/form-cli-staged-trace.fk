// form-cli-staged-trace.fk — one selected hit, protected grounding/frequency
// attestations, and one native trust/result row.
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/sha256.fk form-stdlib/hmac-sha256.fk form-stdlib/hex.fk
// preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk
// preludes: form-stdlib/rag-ask.fk form-stdlib/form-cli-router.fk
// preludes: form-stdlib/form-cli-judge.fk form-stdlib/form-cli-sufficiency.fk
// preludes: form-stdlib/form-freq-check.fk form-stdlib/trust-row.fk
// preludes: form-stdlib/form-cli-ask-gate.fk
//
// A public SHA over caller-controlled fields proves only self-consistency. It is
// not evidence that the database or WITNESS was observed. The live request lane
// therefore reads a private 32-byte key and passes it here to verify two HMAC
// attestations. The 18 pipe-delimited receipt fields are:
//
//   0 REF                 10 certificate REF
//   1 content CTOR       11 certificate CTOR
//   2 source key         12 certificate answer SHA-256
//   3 source path        13 certificate evidence key
//   4 answer SHA-256     14 certificate issued epoch
//   5 persisted-content  15 certificate expiry epoch
//     SHA-256            16 certificate result
//   6 query SHA-256      17 certificate HMAC-SHA-256
//   7 grounding issued
//   8 grounding expiry
//   9 grounding HMAC
//
// Both attestations bind the request id, current selected hit, and actual native wall clock.
// They allow 30 seconds of clock skew and at most five minutes of life. Missing
// key/MAC, future issuance, expiry, replay onto another query, or any one-field
// mutation closes trust. Unkeyed SHA remains only the query content identifier.
section [form.bml] {
    def fcast-part(parts, i, fallback) = len(parts) > i ? nth(parts, i) : fallback;
    def fcast-arg(arg, i, fallback) = fcast-part(split-on(arg, "|"), i, fallback);
    def fcast-receipt-shape?(arg) = (Comparable) len(split-on(arg, "|")) == 18 && (str_find(arg, byte_to_str(10), 0) < 0 && str_find(arg, byte_to_str(13), 0) < 0) ? 1 : 0;
    def fcast-request-id-shape?(request-id) = str_len(request-id) > 0 && (str_len(request-id) <= 128 && (str_find(request-id, "|", 0) < 0 && (str_find(request-id, byte_to_str(10), 0) < 0 && str_find(request-id, byte_to_str(13), 0) < 0))) ? 1 : 0;
    def fcast-percent(n, total) = (Comparable) total == 0 ? 0 : n * 100 / total > 100 ? 100 : n * 100 / total;
    // The canonical streaming SHA/HMAC recipes own the byte fold, bounded
    // partial block, padding, and compression.  This trust surface only names
    // their hex-shaped protocol adapters; it carries no second crypto engine.
    def fcast-sha256-bytes(s) = sha256-stream-string(s);
    def fcast-sha256-hex(s) = hex-encode(fcast-sha256-bytes(s));
    def fcast-query-key(query) = fcast-sha256-hex(query);
    def fcast-cat(parts) = (Comparable) len(parts) == 0 ? "" : str_concat(head(parts), fcast-cat(tail(parts)));
    def fcast-key-valid?(key-hex) = (Comparable) str_len(key-hex) == 64 && (Comparable) hex-valid?(key-hex) == 1 ? 1 : 0;
    def fcast-mac-valid-shape?(mac) = (Comparable) str_len(mac) == 64 && (Comparable) hex-valid?(mac) == 1 ? 1 : 0;
    def fcast-hmac-sha256-string(key-bytes, message) = hmac-sha256-string-key32(key-bytes, message);
    def fcast-hmac-hex(key-hex, message) = (Comparable) fcast-key-valid?(key-hex) == 0 ? "" : hex-encode(fcast-hmac-sha256-string(hex-decode(key-hex), message));
    // Compare every byte when lengths agree. This is the recipe-level timing
    // floor; no first-mismatch branch leaks which MAC prefix was correct.
    def fcast-diff-loop(a, b, i, diff) = i >= str_len(a) ? diff : fcast-diff-loop(a, b, i + 1, diff + ((Comparable) str_byte_at(a, i) == str_byte_at(b, i) ? 0 : 1));
    def fcast-secure-eq?(a, b) = !((Comparable) str_len(a) == str_len(b)) ? 0 : (Comparable) fcast-diff-loop(a, b, 0, 0) == 0 ? 1 : 0;
    def fcast-clock-skew-seconds() = 30;
    def fcast-max-attestation-seconds() = 300;
    def fcast-time-valid?(issued, expires, now) = now > 0 && (issued > 0 && (expires >= issued && (issued <= now + fcast-clock-skew-seconds() && (now <= expires && expires - issued <= fcast-max-attestation-seconds())))) ? 1 : 0;
    def fcast-named-cell-ref?(node-id) = (Comparable) ric-node-id-valid?(node-id) == 1 && (Comparable) str_find(node-id, "@1.1.9.", 0) == 0 ? 1 : 0;
    def fcast-answer-bound?(hit) = ra-output-answer-binds-hit?(ra-hit-output(hit), hit);
    def fcast-grounding-canonical-for(request-id, arg) = fcast-cat(list("grounding-attestation-v2\n", request-id, "\n", fcast-arg(arg, 0, ""), "\n", fcast-arg(arg, 1, ""), "\n", fcast-arg(arg, 2, ""), "\n", fcast-arg(arg, 3, ""), "\n", fcast-arg(arg, 4, ""), "\n", fcast-arg(arg, 5, ""), "\n", fcast-arg(arg, 6, ""), "\n", fcast-arg(arg, 7, ""), "\n", fcast-arg(arg, 8, "")));
    def fcast-grounding-canonical(arg) = fcast-grounding-canonical-for("staged", arg);
    def fcast-grounding-mac-for(key-hex, request-id, arg) = fcast-hmac-hex(key-hex, fcast-grounding-canonical-for(request-id, arg));
    def fcast-grounding-mac(key-hex, arg) = fcast-grounding-mac-for(key-hex, "staged", arg);
    def fcast-grounding-bits-for-at(hit, arg, request-id, query-key, key-hex, now) = {
        let issued = str_to_int(fcast-arg(arg, 7, "0"));
        let expires = str_to_int(fcast-arg(arg, 8, "0"));
        let supplied-mac = fcast-arg(arg, 9, "");
        let hit-ready = (Comparable) ra-hit?(hit) == 1 && (Comparable) ra-hit-admitted?(hit) == 1;
        let identity-bound = (String) fcast-arg(arg, 0, "") == ra-hit-node-id(hit) && (String) fcast-arg(arg, 1, "") == ra-hit-content-node-id(hit);
        let source-bound = (String) fcast-arg(arg, 2, "") == ra-hit-key(hit) && ((String) fcast-arg(arg, 3, "") == ra-hit-source-path(hit) && (String) fcast-arg(arg, 5, "") == ra-hit-persisted-source-sha256(hit));
        let payload-bound = (String) fcast-arg(arg, 4, "") == ra-hit-answer-key(hit) && (String) fcast-arg(arg, 6, "") == query-key;
        let time-bound = (Comparable) fcast-time-valid?(issued, expires, now) == 1;
        let mac-bound = (Comparable) fcast-mac-valid-shape?(supplied-mac) == 1 && (Comparable) fcast-secure-eq?(supplied-mac, fcast-grounding-mac-for(key-hex, request-id, arg)) == 1;
        sum(list((Comparable) fcast-receipt-shape?(arg) == 1 ? 1 : 0, (Comparable) fcast-request-id-shape?(request-id) == 1 ? 2 : 0, (Comparable) fcast-key-valid?(key-hex) == 1 ? 4 : 0, hit-ready ? 8 : 0, identity-bound ? 16 : 0, source-bound ? 32 : 0, payload-bound ? 64 : 0, time-bound ? 128 : 0, mac-bound ? 256 : 0));
    };
    def fcast-grounding-attested-for-at?(hit, arg, request-id, query-key, key-hex, now) = (Comparable) fcast-grounding-bits-for-at(hit, arg, request-id, query-key, key-hex, now) == 511 ? 1 : 0;
    def fcast-grounding-attested-at?(hit, arg, query-key, key-hex, now) = fcast-grounding-attested-for-at?(hit, arg, "staged", query-key, key-hex, now);
    // Local diagnostic row for a failed protected receipt. It reveals which
    // binding axis failed without printing the private key or expected MAC.
    def fcast-grounding-debug-for-at(hit, arg, request-id, query-key, key-hex, now) = str_concat("grounding-debug bits:", str_concat(int_to_str(fcast-grounding-bits-for-at(hit, arg, request-id, query-key, key-hex, now)), str_concat("\nquery-key:", str_concat(query-key, str_concat("\nreceipt-query-key:", str_concat(fcast-arg(arg, 6, ""), str_concat("\nnow:", str_concat(int_to_str(now), str_concat("\nissued:", str_concat(fcast-arg(arg, 7, ""), str_concat("\nexpires:", fcast-arg(arg, 8, ""))))))))))));
    def fcast-frequency-canonical-for(request-id, arg) = fcast-cat(list("frequency-attestation-v2\n", request-id, "\n", fcast-arg(arg, 10, ""), "\n", fcast-arg(arg, 11, ""), "\n", fcast-arg(arg, 12, ""), "\n", fcast-arg(arg, 13, ""), "\n", fcast-arg(arg, 14, ""), "\n", fcast-arg(arg, 15, ""), "\n", fcast-arg(arg, 16, "")));
    def fcast-frequency-canonical(arg) = fcast-frequency-canonical-for("staged", arg);
    def fcast-frequency-mac-for(key-hex, request-id, arg) = fcast-hmac-hex(key-hex, fcast-frequency-canonical-for(request-id, arg));
    def fcast-frequency-mac(key-hex, arg) = fcast-frequency-mac-for(key-hex, "staged", arg);
    // A frequency certificate is deterministic evidence about ordinary Form
    // content, independent of the short-lived query attestation carrying it.
    // Field 13 is therefore the SHA-256 key of these stable subject fields;
    // fields 14/15 remain the separate HMAC-bound query issuance window.
    def fcast-frequency-certificate-canonical-for(cert-ref, subject-ctor, answer-key, result) = fcast-cat(list("frequency-cert-v1\n", cert-ref, "\n", subject-ctor, "\n", answer-key, "\n", result));
    def fcast-frequency-certificate-key-for(cert-ref, subject-ctor, answer-key, result) = fcast-sha256-hex(fcast-frequency-certificate-canonical-for(cert-ref, subject-ctor, answer-key, result));
    def fcast-frequency-certificate-key(arg) = fcast-frequency-certificate-key-for(fcast-arg(arg, 10, ""), fcast-arg(arg, 11, ""), fcast-arg(arg, 12, ""), fcast-arg(arg, 16, ""));
    def fcast-frequency-certificate-valid?(arg) = {
        let cert-ref = fcast-arg(arg, 10, "");
        let subject-ctor = fcast-arg(arg, 11, "");
        let answer-key = fcast-arg(arg, 12, "");
        let evidence-key = fcast-arg(arg, 13, "");
        let result = fcast-arg(arg, 16, "");
        (Comparable) ric-node-id-valid?(cert-ref) == 1 && ((Comparable) ric-node-id-valid?(subject-ctor) == 1 && ((Comparable) fcast-mac-valid-shape?(answer-key) == 1 && ((Comparable) fcast-mac-valid-shape?(evidence-key) == 1 && ((String) result == "success" && (Comparable) fcast-secure-eq?(evidence-key, fcast-frequency-certificate-key-for(cert-ref, subject-ctor, answer-key, result)) == 1)))) ? 1 : 0;
    };
    def fcast-frequency-attested-for-at?(hit, arg, request-id, key-hex, now) = {
        let issued = str_to_int(fcast-arg(arg, 14, "0"));
        let expires = str_to_int(fcast-arg(arg, 15, "0"));
        let supplied-mac = fcast-arg(arg, 17, "");
        let subject-bound = (String) fcast-arg(arg, 10, "") == ra-hit-node-id(hit) && ((String) fcast-arg(arg, 11, "") == ra-hit-content-node-id(hit) && (String) fcast-arg(arg, 12, "") == ra-hit-answer-key(hit));
        let certificate-bound = (Comparable) fcast-frequency-certificate-valid?(arg) == 1;
        let time-bound = (Comparable) fcast-time-valid?(issued, expires, now) == 1;
        let mac-bound = (Comparable) fcast-mac-valid-shape?(supplied-mac) == 1 && (Comparable) fcast-secure-eq?(supplied-mac, fcast-frequency-mac-for(key-hex, request-id, arg)) == 1;
        (Comparable) fcast-receipt-shape?(arg) == 1 && ((Comparable) fcast-request-id-shape?(request-id) == 1 && ((Comparable) ra-hit?(hit) == 1 && (subject-bound && (certificate-bound && (time-bound && (mac-bound && (Comparable) fcast-answer-bound?(hit) == 1)))))) ? 1 : 0;
    };
    def fcast-frequency-attested-at?(hit, arg, key-hex, now) = fcast-frequency-attested-for-at?(hit, arg, "staged", key-hex, now);
    def fcast-grounding-for-at(hit, arg, request-id, query-key, key-hex, now) = fca-grounding(fcast-named-cell-ref?(ra-hit-node-id(hit)), ra-hit-resolves?(hit), fcast-grounding-attested-for-at?(hit, arg, request-id, query-key, key-hex, now), fcast-answer-bound?(hit));
    def fcast-grounding-at(hit, arg, query-key, key-hex, now) = fcast-grounding-for-at(hit, arg, "staged", query-key, key-hex, now);
    def fcast-trust-score-for-at(hit, arg, request-id, query-key, key-hex, now) = (Comparable) ra-hit-admitted?(hit) == 1 && ((Comparable) ra-hit-resolves?(hit) == 1 && ((Comparable) fcast-grounding-attested-for-at?(hit, arg, request-id, query-key, key-hex, now) == 1 && (Comparable) fcast-answer-bound?(hit) == 1)) ? 100 : 0;
    def fcast-trust-score-at(hit, arg, query-key, key-hex, now) = fcast-trust-score-for-at(hit, arg, "staged", query-key, key-hex, now);
    def fcast-sufficiency-signals-for-at(hit, arg, request-id, query-key, key-hex, now) = fca-ask-signals(ra-hit?(hit), ra-output-valid?(ra-hit-output(hit)), fcast-percent(ra-hit-score(hit), ra-hit-query-total(hit)), ra-hit-confidence(hit), fcast-trust-score-for-at(hit, arg, request-id, query-key, key-hex, now), 0);
    def fcast-sufficiency-signals-at(hit, arg, query-key, key-hex, now) = fcast-sufficiency-signals-for-at(hit, arg, "staged", query-key, key-hex, now);
    def fcast-frequency-reading-for-at(hit, arg, request-id, key-hex, now) = (Comparable) fcast-frequency-attested-for-at?(hit, arg, request-id, key-hex, now) == 1 ? fc-certified-form-reading(1, fcast-answer-bound?(hit)) : fc-unmeasured-reading();
    def fcast-frequency-reading-at(hit, arg, key-hex, now) = fcast-frequency-reading-for-at(hit, arg, "staged", key-hex, now);
    // Compute the expensive grounding HMAC once per trace. The earlier helper
    // composition verified it independently for grounding and trust, which is
    // pure but doubled the emitted walker's SHA/HMAC arena pressure on every
    // request.
    def fcast-result-from-ground-bits-for-at(hit, arg, request-id, key-hex, now, grounding-bits) = {
        let attested = (Comparable) grounding-bits == 511 ? 1 : 0;
        let answer-bound = fcast-answer-bound?(hit);
        let trust-score = (Comparable) ra-hit-admitted?(hit) == 1 && ((Comparable) ra-hit-resolves?(hit) == 1 && ((Comparable) attested == 1 && (Comparable) answer-bound == 1)) ? 100 : 0;
        let signals = fca-ask-signals(ra-hit?(hit), ra-output-valid?(ra-hit-output(hit)), fcast-percent(ra-hit-score(hit), ra-hit-query-total(hit)), ra-hit-confidence(hit), trust-score, 0);
        fca-ask-result(ra-hit?(hit), fca-grounding(fcast-named-cell-ref?(ra-hit-node-id(hit)), ra-hit-resolves?(hit), attested, answer-bound), fcast-frequency-reading-for-at(hit, arg, request-id, key-hex, now), signals);
    };
    def fcast-result-for-at(hit, arg, request-id, query-key, key-hex, now) = fcast-result-from-ground-bits-for-at(hit, arg, request-id, key-hex, now, fcast-grounding-bits-for-at(hit, arg, request-id, query-key, key-hex, now));
    def fcast-result-at(hit, arg, query-key, key-hex, now) = fcast-result-for-at(hit, arg, "staged", query-key, key-hex, now);
    def fcast-trace-hit-for-at(hit, arg, request-id, query-key, key-hex, now) = str_concat(fca-ask-trace-row(fcast-result-for-at(hit, arg, request-id, query-key, key-hex, now)), str_concat("\n", ra-hit-output(hit)));
    def fcast-trace-hit-at(hit, arg, query-key, key-hex, now) = fcast-trace-hit-for-at(hit, arg, "staged", query-key, key-hex, now);
    0;
}
