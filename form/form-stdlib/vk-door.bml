//////////////////////////////////////////////////////////////////////
//
// vk-door.bml — Form's hands on the Vulkan lane: mint a compute shader
// from GLSL text, lay out a plan of buffers and dispatches, run it through
// the Vulkan carrier (.hearth/vk/run_vk), and read the answer back as floats.
//
// Words cross as unsigned decimals, so a float travels as its f32 bits
// (md-f32-bits out, ln-f32-decode back) and nothing is rounded through
// text. The judge is always the Form recipe a band names, never the
// carrier: the carrier only moves words and dispatches.
//
// The carrier and the minted shaders live in .hearth/vk, which git
// ignores. The carrier is a compiled program staged once per host; this
// tree carries no source for it, and vk-carrier.bml names it missing while
// it is absent. The Vulkan implementation the carrier opens is the
// libMoltenVK.dylib Docker ships. glslangValidator mints SPIR-V the way
// nvrtc mints a cubin: authoring, not runtime.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/metal-door.fk form/form-stdlib/lora-adapter.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class VulkanDoor {
        def vkd-home() = ".hearth/vk";
        def vkd-runner() = vkd-home() ++ "/run_vk";
        def vkd-path(name, ext) = vkd-home() ++ "/" ++ name ++ ext;
        def vkd-ready?() = fs_exists(vkd-runner());

        // mint: "" when SPIR-V was written, otherwise the compiler's own words
        def vkd-mint(name, glsl) {
            let w = write_file_text(vkd-path(name, ".comp"), glsl);
            let said = host-exec("PATH=/opt/homebrew/bin:/usr/local/bin:$PATH glslangValidator -V " ++ vkd-path(name, ".comp") ++ " -o " ++ vkd-path(name, ".spv") ++ " 2>&1", "");
            w < 1 ? "the shader text did not reach the disk" : str_find(said, "ERROR", 0) >= 0 ? said : "";
        }

        // ---- the plan, one line per word the carrier reads ----
        def vkd-words(ns) = nil?(ns) ? "" : " " ++ int_to_str(head(ns)) ++ vkd-words(tail(ns));
        def vkd-bits(xs) = xs |> map(md-f32-bits);
        def vkd-f(x) = md-f32-bits(x);
        def vkd-spv(name) = "spv " ++ vkd-path(name, ".spv") ++ "\n";
        def vkd-buf(xs) = "buf " ++ int_to_str(len(xs)) ++ vkd-words(vkd-bits(xs)) ++ "\n";
        def vkd-bufu(ns) = "buf " ++ int_to_str(len(ns)) ++ vkd-words(ns) ++ "\n";
        def vkd-zero(n) = "zero " ++ int_to_str(n) ++ "\n";
        def vkd-run(k, binds, push, gx) = "run " ++ int_to_str(k) ++ " " ++ int_to_str(len(binds)) ++ vkd-words(binds) ++ " " ++ int_to_str(len(push)) ++ vkd-words(push) ++ " " ++ int_to_str(gx) ++ " 1 1\n";
        def vkd-read(b) = "read " ++ int_to_str(b) ++ "\n";
        // a plan is its lines in order: spv lines, then buf/zero lines, then runs, then reads
        def vkd-plan(parts) = nil?(parts) ? "" : head(parts) ++ vkd-plan(tail(parts));
        def vkd-groups(n) = ((n - 1) / 64) + 1;

        def vkd-exec(tag, plan) {
            let w = write_file_text(vkd-path("plan-" ++ tag, ".txt"), plan);
            host-exec(vkd-runner() ++ " " ++ vkd-path("plan-" ++ tag, ".txt") ++ " 2>&1", "");
        }

        // ---- the answer: "buf <b> <n> <w0> ..." read back without leaving the string ----
        def vkd-num(s, i) = i >= str_len(s) ? list(0, i) : vkd-num-at(s, i);
        def vkd-num-at(s, i) = (Comparable) str_byte_at(s, i) == 32 ? vkd-num(s, i + 1) : vkd-num-go(s, i, 0);
        def vkd-num-go(s, i, acc) = i >= str_len(s) ? list(acc, i) : vkd-num-digit(s, i, acc, str_byte_at(s, i));
        def vkd-num-digit(s, i, acc, c) = (c >= 48) && (c <= 57) ? vkd-num-go(s, i + 1, (acc * 10) + (c - 48)) : list(acc, i);
        def vkd-nums(s, i, n, acc) = n <= 0 ? reverse(acc) : vkd-nums-step(s, n, acc, vkd-num(s, i));
        def vkd-nums-step(s, n, acc, r) = vkd-nums(s, r[1], n - 1, cons(r[0], acc));
        def vkd-words-count(out, r) = vkd-nums(out, r[1], r[0], list());
        def vkd-words-of(out, b) {
            let mark = "buf " ++ int_to_str(b) ++ " ";
            let at = str_find(out, mark, 0);
            at < 0 ? list() : vkd-words-count(out, vkd-num(out, at + str_len(mark)));
        }
        def vkd-floats(ws) = ws |> map(ln-f32-decode);
        def vkd-read-floats(out, b) = vkd-floats(vkd-words-of(out, b));
        def vkd-device(out) {
            let at = str_find(out, "device=", 0);
            at < 0 ? "" : substring(out, at + 7, str_find(out, "\n", at));
        }

        // ---- judging against a recipe ----
        def vkd-cat(a, b) = nil?(a) ? b : cons(head(a), vkd-cat(tail(a), b));
        def vkd-flat(rows) = nil?(rows) ? list() : vkd-cat(head(rows), vkd-flat(tail(rows)));
        def vkd-close?(a, b, tol) = abs(a - b) < tol;
        def vkd-empty?(ys) = nil?(ys) ? 1 : 0;
        def vkd-agree?(xs, ys, tol) = nil?(xs) ? vkd-empty?(ys) : nil?(ys) ? 0 : vkd-close?(head(xs), head(ys), tol) ? vkd-agree?(tail(xs), tail(ys), tol) : 0;
        def vkd-moved?(xs, ys) = nil?(xs) || nil?(ys) ? 0 : vkd-close?(head(xs), head(ys), 0.0000305) ? vkd-moved?(tail(xs), tail(ys)) : 1;
        def vkd-eps() = 0.0000305;
    }
    0;
}
