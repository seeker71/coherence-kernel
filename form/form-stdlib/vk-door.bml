//////////////////////////////////////////////////////////////////////
//
// vk-door.bml — Form's hands on the Vulkan lane, the parts that are Form: the GLSL text a recipe
// emits, the plan of buffers and dispatches laid out one line per word, the f32 words a float
// travels as, and the reader that turns a carrier's answer back into floats to be judged against
// the Form recipe a band names.
//
// WHAT THIS BODY DOES NOT CARRY. A compute shader becomes SPIR-V in an external compiler
// (glslangValidator) and a plan runs in an external program (the Vulkan carrier over Docker's
// MoltenVK). Neither is Form, and the rule of this body is that no program runs but the seed's own
// build and git. So the door starts nothing: vkd-mint and vkd-exec answer a NAMED ABSENCE
// (vkd-absent) and vkd-ready? reads 0. Nothing is guessed in place of a device's answer: with no
// answer there are no floats, and a band that asks for them reads 0 for that claim.
//
// Words cross as unsigned decimals, so a float travels as its f32 bits (md-f32-bits out,
// ln-f32-decode back) and nothing is rounded through text. The judge is always the Form recipe a
// band names. When the body carries a Vulkan runner of its own, vkd-mint and vkd-exec are the two
// definitions that change; the plan, the words and the reader below are already the protocol.
//
import form/form-stdlib/core.fk;
import form/form-stdlib/metal-door.fk;
import form/form-stdlib/lora-adapter.bml;
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class VulkanDoor {
        def vkd-home() = ".hearth/vk";
        def vkd-path(name, ext) = vkd-home() + ("/" + ((String) name + ext));
        // the absence, by name: what every call that would need a compiler or a runner answers
        def vkd-absent() = "vulkan-runner-absent: this body carries no Vulkan runner and no GLSL-to-SPIR-V compiler; no shader was minted, no plan was run, nothing was begun";
        def vkd-absent?(text) = (Comparable) str_find((String) text, "vulkan-runner-absent:", 0) == 0 ? 1 : 0;
        def vkd-ready?() = 0;

        // mint: "" when SPIR-V was written, otherwise the words of why it was not. Here a shader's text is
        // checked to be a shader (a #version line and a main) and the absence is the answer.
        def vkd-source-ok?(glsl) = nothing?(glsl) ? 0 : ((Comparable) str_find(glsl, "#version", 0) >= 0) && ((Comparable) str_find(glsl, "void main", 0) >= 0) ? 1 : 0;
        def vkd-mint(name, glsl) = (Comparable) vkd-source-ok?(glsl) == 1 ? vkd-absent() : "the shader text is not a shader: it has no #version line or no main";

        // ---- the plan, one line per word the carrier reads ----
        def vkd-words(ns) = nil?(ns) ? "" : (" " + (ns[0].str() + vkd-words(ns[1:])));
        def vkd-bits(xs) = xs |> map(md-f32-bits);
        def vkd-f(x) = md-f32-bits(x);
        def vkd-spv(name) = "spv " + (vkd-path(name, ".spv") + "\n");
        def vkd-buf(xs) = "buf " + (len(xs).str() + (vkd-words(vkd-bits(xs)) + "\n"));
        def vkd-bufu(ns) = "buf " + (len(ns).str() + (vkd-words(ns) + "\n"));
        def vkd-zero(n) = "zero " + (n.str() + "\n");
        def vkd-run(k, binds, push, gx) = "run " + (k.str() + (" " + (len(binds).str() + (vkd-words(binds) + (" " + (len(push).str() + (vkd-words(push) + (" " + (gx.str() + " 1 1\n")))))))));
        def vkd-read(b) = "read " + (b.str() + "\n");
        // a plan is its lines in order: spv lines, then buf/zero lines, then runs, then reads
        def vkd-plan(parts) = nil?(parts) ? "" : ((String) parts[0] + vkd-plan(parts[1:]));
        def vkd-groups(n) = ((n - 1) / 64) + 1;
        // how many lines of a plan begin with a verb (spv, buf, zero, run, read)
        def vkd-lines-of(plan, verb) = vkd-count-lines(plan, verb + " ", 0, 0);
        def vkd-count-lines(plan, mark, from, n) {
            let at = str_find(plan, mark, from);
            at < 0 ? n : (at == 0) || ((Comparable) str_byte_at(plan, at - 1) == 10) ? vkd-count-lines(plan, mark, at + len(mark), n + 1) : vkd-count-lines(plan, mark, at + len(mark), n);
        }

        // exec: the answer a runner gave to a plan. This body has no runner: the absence, by name.
        def vkd-exec(tag, plan) = vkd-absent();

        // ---- the answer: "buf <b> <n> <w0> ..." read back without leaving the string ----
        def vkd-num(s, i) = i >= len(s) ? [0, i] : vkd-num-at(s, i);
        def vkd-num-at(s, i) = (Comparable) str_byte_at(s, i) == 32 ? vkd-num(s, i + 1) : vkd-num-go(s, i, 0);
        def vkd-num-go(s, i, acc) = i >= len(s) ? [acc, i] : vkd-num-digit(s, i, acc, str_byte_at(s, i));
        def vkd-num-digit(s, i, acc, c) = (c >= 48) && (c <= 57) ? vkd-num-go(s, i + 1, (acc * 10) + (c - 48)) : [acc, i];
        def vkd-nums(s, i, n, acc) = n <= 0 ? reverse(acc) : vkd-nums-step(s, n, acc, vkd-num(s, i));
        def vkd-nums-step(s, n, acc, r) = vkd-nums(s, r[1], n - 1, cons(r[0], acc));
        def vkd-words-count(out, r) = vkd-nums(out, r[1], r[0], []);
        def vkd-words-of(out, b) {
            let mark = "buf " + (b.str() + " ");
            let at = str_find(out, mark, 0);
            at < 0 ? [] : vkd-words-count(out, vkd-num(out, at + len(mark)));
        }
        def vkd-floats(ws) = ws |> map(ln-f32-decode);
        def vkd-read-floats(out, b) = vkd-floats(vkd-words-of(out, b));
        def vkd-device(out) {
            let at = str_find(out, "device=", 0);
            at < 0 ? "" : substring(out, at + 7, str_find(out, "\n", at));
        }

        // ---- judging against a recipe ----
        def vkd-cat(a, b) = nil?(a) ? b : cons(a[0], vkd-cat(a[1:], b));
        def vkd-flat(rows) = nil?(rows) ? [] : vkd-cat(rows[0], vkd-flat(rows[1:]));
        def vkd-close?(a, b, tol) = abs(a - b) < tol;
        def vkd-empty?(ys) = nil?(ys) ? 1 : 0;
        def vkd-agree?(xs, ys, tol) = nil?(xs) ? vkd-empty?(ys) : nil?(ys) ? 0 : vkd-close?(xs[0], ys[0], tol) ? vkd-agree?(xs[1:], ys[1:], tol) : 0;
        def vkd-moved?(xs, ys) = nil?(xs) || nil?(ys) ? 0 : vkd-close?(xs[0], ys[0], 0.0000305) ? vkd-moved?(xs[1:], ys[1:]) : 1;
        def vkd-eps() = 0.0000305;
        // a plan's reads are agreed with recipe rows only when there are floats to agree: an empty answer agrees with no non-empty recipe
        def vkd-nonempty?(xs) = nil?(xs) ? 0 : 1;
        // a stand-in answer in the carrier's own wire shape, for a band to hold the reader against: device line, then one buffer
        def vkd-sample-answer(floats) = "device=sample\nbuf 7 " + (len(floats).str() + (vkd-words(vkd-bits(floats)) + "\n"));
    }
    0;
}
