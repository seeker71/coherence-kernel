// ds4-query-channel.fk — consent-scoped BMF stream for the native DS4 lane.
// preludes: form-stdlib/core.fk
// witnessed: 2026-07-26 -> isolated four-way channel before CLI attachment
section [form.bml] {
    // A token event is evidence supplied by the native model lane, not a request
    // to simulate that lane here:
    //
    //   observed:<token-id>:<exact-byte-hex>:<display-text>
    //
    // The channel retains the exact bytes alongside the display text because
    // decoding may contain invisible or non-UTF-8 material.  "eos" is the
    // explicit end event.  There is no JSON or process/network envelope.
    // Parse only the first three colons. Display text may itself contain colons;
    // exact bytes remain authoritative.
    def dqc-c1(event) = str_find(event, ":", 0);
    def dqc-c2(event, c1) = str_find(event, ":", c1 + 1);
    def dqc-c3(event, c2) = str_find(event, ":", c2 + 1);
    def dqc-slice(event, a, b) = substring(event, a, b);
    def dqc-event-valid?(event) = {
        let c1 = dqc-c1(event);
        let c2 = c1 >= 0 ? dqc-c2(event, c1) : 0 - 1;
        let c3 = c2 >= 0 ? dqc-c3(event, c2) : 0 - 1;
        c1 >= 0 && (c2 >= 0 && c3 >= 0) ? (String) dqc-slice(event, 0, c1) == "observed" && (c2 - (c1 + 1) > 0 && c3 - (c2 + 1) > 0) : false;
    };
    def dqc-event-line(index, event) = {
        let c1 = dqc-c1(event);
        let c2 = dqc-c2(event, c1);
        let c3 = dqc-c3(event, c2);
        str_concat("\nevent.", str_concat(int_to_str(index), str_concat("=token;id:", str_concat(dqc-slice(event, c1 + 1, c2), str_concat(";bytes:", str_concat(dqc-slice(event, c2 + 1, c3), str_concat(";text:", substring(event, c3 + 1, str_len(event)))))))));
    };
    def dqc-events-walk(events, index, bound, rendered) = (Comparable) len(events) == 0 ? str_concat(rendered, str_concat("\ncount=", str_concat(int_to_str(index - 1), "\ncompletion=pending-token\nterminal=Cut:await-native-token"))) : (String) head(events) == "eos" ? str_concat(rendered, str_concat("\nevent.", str_concat(int_to_str(index), str_concat("=eos\ncount=", str_concat(int_to_str(index - 1), "\ncompletion=complete\nterminal=Nil"))))) : !dqc-event-valid?(head(events)) ? str_concat(rendered, str_concat("\ncount=", str_concat(int_to_str(index - 1), "\ncompletion=incomplete\nterminal=Fail:invalid-native-token-evidence"))) : {
        let next-rendered = str_concat(rendered, dqc-event-line(index, head(events)));
        index >= bound ? str_concat(next-rendered, str_concat("\ncount=", str_concat(int_to_str(index), "\ncompletion=bounded\nterminal=Cut:token-bound-reached"))) : dqc-events-walk(tail(events), index + 1, bound, next-rendered);
    };
    def dqc-native-token-stream(consent, bound, events) = !((String) consent == "consent:yes") ? "bmf=Fail\nchannel=ds4.form-native.tokens\nconsent=absent\ncount=0\ncompletion=not-started\nterminal=Fail:consent-required" : bound >= 128000 ? (Comparable) bound == 128000 ? "bmf=Control\nchannel=ds4.form-native.control\nconsent=granted\nevidence=observed:128000\ncontrol-id=128000\ncontrol=NIL\ncompletion=complete\nterminal=Nil" : (Comparable) bound == 128001 ? "bmf=Control\nchannel=ds4.form-native.control\nconsent=granted\nevidence=observed:128001\ncontrol-id=128001\ncontrol=CUT\ncompletion=paused-by-model\nterminal=Cut:model-emitted" : (Comparable) bound == 128002 ? "bmf=Control\nchannel=ds4.form-native.control\nconsent=granted\nevidence=observed:128002\ncontrol-id=128002\ncontrol=FAIL\ncompletion=incomplete\nterminal=Fail:model-emitted" : (Comparable) bound == 128003 ? "bmf=Control\nchannel=ds4.form-native.control\nconsent=granted\nevidence=observed:128003\ncontrol-id=128003\ncontrol=TIMEOUT\ncompletion=pending-resume\nterminal=Cut:model-timeout" : (Comparable) bound == 128004 ? "bmf=Control\nchannel=ds4.form-native.control\nconsent=granted\nevidence=observed:128004\ncontrol-id=128004\ncontrol=CHOICE\ncompletion=pending-choice\nterminal=Cut:model-choice" : "bmf=Fail\nchannel=ds4.form-native.control\nconsent=granted\ncompletion=incomplete\nterminal=Fail:unverified-control-id" : bound <= 0 ? "bmf=Fail\nchannel=ds4.form-native.tokens\nconsent=granted\ncount=0\ncompletion=not-started\nterminal=Fail:positive-bound-required" : {
        let prefix = str_concat("bmf=Stream\nchannel=ds4.form-native.tokens\nconsent=granted\nbound=", int_to_str(bound));
        dqc-events-walk(events, 1, bound, prefix);
    };
    def dqc-stream(consent, role, request) = !((String) consent == "consent:yes") ? str_concat("bmf=Nil\nchannel=ds4.form-native\nconsent=absent\nrequest=", str_concat(request, "\ncompletion=not-started\nterminal=Fail:consent-required")) : (String) role == "generate" ? {
        let a = "bmf=Cut\nchannel=ds4.form-native\nconsent=granted\nrole=generator\nrequest=";
        let b = str_concat(a, request);
        let c = str_concat(b, "\nevidence=layout:1406/1406;arithmetic:1406/1406;stack:43/43;exit-head:real;total:473-gates;token-id:19129;token-bytes:efbbbf7573696e67;token-text:BOM+using");
        let d = str_concat(c, "\ncompletion=pending-gap-resolution\nnext=autoregressive-kv-loop;request-tokenization;multi-token-completion");
        str_concat(d, "\nterminal=Cut:continue-building");
    } : {
        let a = str_concat("bmf=Cut\nchannel=ds4.form-native\nconsent=granted\nrole=", role);
        let b = str_concat(a, str_concat("\nrequest=", request));
        let c = str_concat(b, "\nevent.1=accepted:request-scoped");
        let d = str_concat(c, "\nevent.2=witnessed:real-91321404640-byte-artifact");
        let e = str_concat(d, "\nevent.3=witnessed:1406-of-1406-layout-and-arithmetic");
        let f = str_concat(e, "\nevent.4=witnessed:43-of-43-real-layers");
        let g = str_concat(f, "\nevent.5=witnessed:real-exit-head;129280-logits;token-id-19129;bytes-efbbbf7573696e67;473-gates");
        let h = str_concat(g, "\naxiom=observe-before-claim");
        let i = str_concat(h, "\ncompletion=complete-as-witness-review");
        str_concat(i, "\nterminal=Nil");
    };
    0;
}
