; form-local-axioms-nodeid-actuator-observed.fk -- exact physical actuation.
;
; The health pulse selected `axioms-resident-one-family-crossing`; its exact
; Form-native action NodeID 31.2.0.109 opened the owned local Qwen residence and
; carried the complete one-family recipe through heldout observation, supervised
; scannerless BML/BMF/Form repair, generated Metal JIT execution, reinjection,
; projection and release.  The actuator applied; mastery did not cross.  Those
; are different signals and remain different here.
;
; No prompt or answer bytes are retained.  Fresh heldout misses stay 0, the
; supervised executable repair stays 1, and `not-yet` never becomes `nothing`,
; 0, 1, heldout credit or learned-weight credit.
;
; witnessed: 2026-08-25 -> exact NodeID actuator applied; crossing not-yet
; preludes: form-stdlib/form-local-axioms-actuator-request.fk
; Proven by: form-stdlib/tests/form-local-axioms-nodeid-actuator-observed-band.fk

import "./form-local-axioms-actuator-request.fk"

(do
    (defn flanao-schema () "form-local-axioms-nodeid-actuator-observed-v1")
    (defn flanao-nodeid () "31.2.0.109")
    (defn flanao-model-id () "Qwen3.8-27B-Q8_0-local")
    (defn flanao-run-id ()
        "1885fd3dffe68c50c08211b4a223500baed757413bad1759839a7641c54778aa")
    (defn flanao-heldout-a-sha ()
        "217b968efcd4e5260998387c98a353dfa5e3e876a4beccb684b29004a56049d9")
    (defn flanao-heldout-b-sha ()
        "77b2d912ec895dab4306f8ed28ad5eefc299663a0f14be87f8733c6509ca7a07")
    (defn flanao-curriculum-source-id ()
        "sha256:893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad")
    (defn flanao-generative-final-sha ()
        "57a1ac258894937c25935a1b986cc934c354342416d3db8cb03855cefb1ee119")
    (defn flanao-native-request-sha ()
        "a545df732a121c641feabb79009c59e76080558f595d9eb15155240c9cab35aa")
    (defn flanao-native-result-sha ()
        "0b9995a3f39bbca11d24e197ee29bbd1a0c7e5d17da3e0ebee81155d1c73b75b")
    (defn flanao-residence-witness-sha ()
        "91b2ebd47c11cbf6b5052f76aa87f2c69e6836ea2be91dc573e5ebc03b7f3256")
    (defn flanao-projection-sha ()
        "b2a9b02de4010e3b58e83c97a77d2b38541be19ec512d524994c27088ba88ae7")

    ; record = schema target node model run heldout-a heldout-b
    ;          ha-cursor hb-cursor ha95 hb95 repair curriculum-node
    ;          curriculum-source curriculum-valid generative-sha generative-cursor
    ;          generative-pass request-sha result-sha opens reopens native-live
    ;          same-context same-state native-check remote release events controls
    ;          reobservations residence family-count projection fkav crossing
    ;          actuator-status actuator-present actuator-valid local supervised
    ;          heldout-credit learned-credit
    (defn flanao-record-with
        (ha95 hb95 generative-pass native-check crossing actuator-valid
         heldout-credit learned-credit)
        (list (flanao-schema) (flar-target) (flanao-nodeid) (flanao-model-id)
              (flanao-run-id) (flanao-heldout-a-sha) (flanao-heldout-b-sha)
              1 1 ha95 hb95 1 "0.2.0.37" (flanao-curriculum-source-id) 1
              (flanao-generative-final-sha) 1 generative-pass
              (flanao-native-request-sha) (flanao-native-result-sha)
              2 1 1 1 1 native-check 0 1 34 3 3
              (flanao-residence-witness-sha) 15 (flanao-projection-sha)
              1 crossing "applied" 1 actuator-valid 1 1
              heldout-credit learned-credit))
    (defn flanao-observation () (flanao-record-with 0 0 1 1 0 0 0 0))

    (defn flanao-identity-valid? (o)
        (if (and (eq (len o) 43)
            (and (str_eq (nth o 0) (flanao-schema))
            (and (str_eq (nth o 1) (flar-target))
            (and (str_eq (nth o 2) (flanao-nodeid))
            (and (str_eq (nth o 3) (flanao-model-id))
            (and (str_eq (nth o 4) (flanao-run-id))
            (and (str_eq (nth o 5) (flanao-heldout-a-sha))
                 (str_eq (nth o 6) (flanao-heldout-b-sha))))))))) 1 0))
    (defn flanao-learning-valid? (o)
        (if (and (eq (nth o 7) 1)
            (and (eq (nth o 8) 1)
            (and (eq (nth o 9) 0)
            (and (eq (nth o 10) 0)
            (and (eq (nth o 11) 1)
            (and (str_eq (nth o 12) "0.2.0.37")
            (and (str_eq (nth o 13) (flanao-curriculum-source-id))
            (and (eq (nth o 14) 1)
            (and (str_eq (nth o 15) (flanao-generative-final-sha))
            (and (eq (nth o 16) 1)
                 (eq (nth o 17) 1))))))))))) 1 0))
    (defn flanao-native-valid? (o)
        (if (and (str_eq (nth o 18) (flanao-native-request-sha))
            (and (str_eq (nth o 19) (flanao-native-result-sha))
            (and (eq (nth o 20) 2)
            (and (eq (nth o 21) 1)
            (and (eq (nth o 22) 1)
            (and (eq (nth o 23) 1)
            (and (eq (nth o 24) 1)
            (and (eq (nth o 25) 1)
            (and (eq (nth o 26) 0)
                 (eq (nth o 27) 1)))))))))) 1 0))
    (defn flanao-observer-valid? (o)
        (if (and (eq (nth o 28) 34)
            (and (eq (nth o 29) 3)
            (and (eq (nth o 30) 3)
            (and (str_eq (nth o 31) (flanao-residence-witness-sha))
            (and (eq (nth o 32) 15)
            (and (str_eq (nth o 33) (flanao-projection-sha))
                 (eq (nth o 34) 1))))))) 1 0))
    (defn flanao-credit-valid? (o)
        (if (and (eq (nth o 35) 0)
            (and (str_eq (nth o 36) "applied")
            (and (eq (nth o 37) 1)
            (and (eq (nth o 38) 0)
            (and (eq (nth o 39) 1)
            (and (eq (nth o 40) 1)
            (and (eq (nth o 41) 0)
                 (eq (nth o 42) 0)))))))) 1 0))
    (defn flanao-actuation-observed? (o)
        (if (and (eq (flanao-identity-valid? o) 1)
            (and (eq (flanao-learning-valid? o) 1)
            (and (eq (flanao-native-valid? o) 1)
            (and (eq (flanao-observer-valid? o) 1)
                 (eq (flanao-credit-valid? o) 1))))) 1 0))
    (defn flanao-crossing-observed? (o)
        (if (and (eq (flanao-actuation-observed? o) 1)
                 (and (eq (nth o 9) 1)
                      (and (eq (nth o 10) 1)
                           (and (eq (nth o 35) 1)
                                (eq (nth o 38) 1))))) 1 0))
    (defn flanao-phase (o)
        (if (eq (flanao-actuation-observed? o) 0) (nothing)
            (if (eq (flanao-crossing-observed? o) 1) "crossed" "not-yet")))
    0)
