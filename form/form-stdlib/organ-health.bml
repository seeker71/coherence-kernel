// One language for an organ's live reading, need, response and changed state.
// The organ supplies health and meaning. This carrier knows no error names,
// model families, resource catalogue, thresholds or expected verdict numbers.
// preludes: form-stdlib/bml/organ-health-values.bml form-stdlib/spool-bell-transport.fk form-stdlib/line-grammar.fk
section [form.bml] {
 class OrganHealth {
  def oh-s(key,value) = json-node-pair(key,json-node-string(value));
  def oh-n(key,value) = json-node-pair(key,json-node-int(value));
  def oh-get(row,key) = json-object-get(row,key);
  def oh-str(row,key) = json-string-value(oh-get(row,key));
  def oh-has(values,value) = nil?(values) ? 0 : (((String) head(values) == value) || oh-has(tail(values),value));
  def oh-strings(values) = values |> map(json-node-string);
  def oh-values(nodes) = nodes |> map(json-string-value);
  def oh-ints(values) = values |> map(json-node-int);
  def oh-int-values(nodes) = nodes |> map(json-int-value);
  def oh-without(pairs,key) = nil?(pairs) ? list() : (String) json-pair-key(head(pairs)) == key ? oh-without(tail(pairs),key) : cons(head(pairs),oh-without(tail(pairs),key));
  def oh-set(row,key,value) = json-node-object(append(oh-without(json-object-pairs(row),key),list(json-node-pair(key,value))));
  def oh-need(resource,detail) = json-node-object(list(oh-s("resource",resource),json-node-pair("detail",detail)));
  def oh-reference(path) = json-node-object(list(oh-s("path",path),oh-n("bytes",file_size(path)),oh-n("observed_unix_ms",now_unix_ms())));
  def oh-reading(organ,flow,aspect,expected,observed,health,needs,offers,evidence) = jv-materialize(ohv-reading(organ,flow,aspect,jv-node(expected),jv-node(observed),jv-node(health),jv-wrap(needs),offers,jv-node(evidence)));
  // An organ may already own a unique, retained event identity. Carry it
  // explicitly when process introspection is unavailable in its host scope.
  // The caller owns uniqueness and replay identity; no process birth is inferred.
  def oh-reading-with-id(id,organ,flow,aspect,expected,observed,health,needs,offers,evidence) = jv-materialize(ohv-reading-with-id(id,organ,flow,aspect,jv-node(expected),jv-node(observed),jv-node(health),jv-wrap(needs),offers,jv-node(evidence)));
  def oh-text(row,key) = ((Comparable) node_type(oh-get(row,key)) == 2) && (str_len(oh-str(row,key)) > 0);
  def oh-health-value(value) = node_eq(value,json-node-null()) || (node_eq(value,json-node-int(0)) || node_eq(value,json-node-int(1)));
  def oh-array(row,key) = node_eq(node_category(oh-get(row,key)),JSON-ARRAY());
  def oh-valid(row) = ohv-valid(jv-node(row));
  def oh-pain(row) = ohv-pain(jv-node(row));
  def oh-unease(row) = ohv-unease(jv-node(row));
  def oh-response(reading,selected) = oh-set(oh-set(oh-set(reading,"stage",json-node-string("response")),"selected",json-node-string(selected)),"at_ms",json-node-int(now_unix_ms()));
  def oh-select(reading,response,fallback) = !oh-valid(response) ? fallback : !(((String) oh-key(reading) == oh-key(response)) && (((String) oh-str(reading,"id") == oh-str(response,"id")) && (((String) oh-str(response,"stage") == "response") && oh-has(oh-values(json-array-elements(oh-get(reading,"offers"))),oh-str(response,"selected"))))) ? fallback : oh-str(response,"selected");
  // Applied describes an action, never a repaired health reading.
  def oh-applied(reading,selected,result) = oh-set(oh-set(oh-set(oh-response(reading,selected),"stage",json-node-string("applied")),"result",result),"at_ms",json-node-int(now_unix_ms()));
  def oh-frame(row) = ohv-frame(jv-node(row));
  def oh-emit(path,row) {
   !oh-valid(row) ? form_error("organ health event has no complete identity or observation") : oh-emit-valid(path,row);
  }
  def oh-emit-valid(path,row) {
   let text = json-emit-precise(row) ++ "\n";
   let wrote = sbt-append-count(path,text);
   let frame = oh-frame(row);
   // The byte-count door confirms this complete event. Absent and incomplete
   // writes keep their refusal through the shared transport.
   nothing?(wrote) || ((Comparable) wrote != str_len(text)) ? form_error("organ health event transport is incomplete") : row;
  }
  // Answers the row it spoke, as oh-voice-all answers its rows. It used to answer
  // its own printing, and a reading handed straight from it to oh-emit was an
  // integer where a row belonged — the same slip twice in four days, in the glass
  // supervisor and in the movement's own beginning. A door whose shape invites one
  // mistake twice is the thing to change.
  def oh-voice(row) {
   let frame = oh-frame(row);
   let said = print_str("form-organ health " ++ json-emit-precise(row) ++ "\n");
   row;
  }
  // every reading speaks, in order, and comes back as it was
  def oh-voice-all(rows) = nil?(rows) ? rows : oh-voice-then(oh-voice(head(rows)),rows);
  def oh-voice-then(said,rows) = cons(head(rows),oh-voice-all(tail(rows)));
  def oh-extract(row) = jv-materialize(ohv-extract(jv-node(row)));
  def oh-key(row) = ohv-key(jv-node(row));
  def oh-replace(rows,row) = jv-materialize-items(ohv-replace(jv-wrap(rows),jv-node(row)));
  def oh-observed(row) = jv-materialize(ohv-observed(jv-node(row)));
  def oh-find(rows,row) = jv-materialize(ohv-find(jv-wrap(rows),jv-node(row)));
  // Attention annotates an already observed identity. It never replaces the
  // organ's measured content, and a delayed annotation cannot revive old pain.
  def oh-attentions(rows,attention) = jv-materialize-items(ohv-attentions(jv-wrap(rows),jv-node(attention)));
  def oh-attention-reading(held,row) = jv-materialize-items(ohv-attention-reading(jv-wrap(held),jv-node(row)));
  def oh-control-metadata(held,row) = jv-materialize(ohv-control-metadata(jv-node(held),jv-node(row)));
  def oh-control-reading(held,row) = jv-materialize-items(ohv-control-reading(jv-wrap(held),jv-node(row)));
  def oh-current(rows,held) = jv-materialize-items(ohv-current(jv-wrap(rows),jv-wrap(held)));
  def oh-lines(lines,held) = nil?(lines) ? held : (String) head(lines) == "" ? oh-lines(tail(lines),held) : oh-lines(tail(lines),oh-current(list(parse-json("organ-health-flow",head(lines))),held));
  // One transport chunk and the unfinished event are held while the file flows.
  // The current map grows with distinct organ/flow/aspect identities, not tokens.
  def oh-age(rows,now) = jv-materialize-items(ohv-age(jv-wrap(rows),now));
  def oh-read(path) = oh-age(oh-read-from(path,0,"",list()),now_unix_ms());
  def oh-read-from(path,offset,pending,held) = offset >= file_size(path) ? ((String) pending == "" ? held : oh-lines(list(pending),held)) : oh-read-chunk(path,offset,pending,held,read_file_slice(path,offset,65536));
  def oh-read-chunk(path,offset,pending,held,chunk) {
   let lines = split-on(pending ++ chunk,"\n");
   let reversed = reverse(lines);
   (Comparable) str_len(chunk) == 0 ? held : oh-read-from(path,offset + str_len(chunk),head(reversed),oh-lines(reverse(tail(reversed)),held));
  }
 }
 0;
}
