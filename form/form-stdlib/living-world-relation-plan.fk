; living-world-relation-plan.fk -- current relation edges form bounded plans.
;
; A caller offers an exact relation cell and a non-empty field of current
; learned-symbol candidates. The organ gathers only current admitted edges of
; that relation whose endpoints are inside the offered field. It then performs
; one local, inspectable topological observation:
;
;   READY     exactly one zero-incoming node exists at every step;
;   AMBIGUOUS more than one next node is locally possible;
;   CYCLE     no next node is possible while nodes remain.
;
; AMBIGUOUS is not failure and CYCLE is not silence. Alternatives are retained
; only when observed, an unknowable remainder is explicit only when needed,
; and READY leaves both optional fields empty. No arbitrary tie-break, fixed
; grammar, or global ontology enters the derivation.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk

(let LWRP-GROUP     (bp "LWRP-GROUP"))
(let LWRP-SEQUENCE  (bp "LWRP-SEQUENCE"))
(let LWRP-PLAN      (bp "LWRP-PLAN"))
(let LWRP-READY     (bp "LWRP-READY"))
(let LWRP-AMBIGUOUS (bp "LWRP-AMBIGUOUS"))
(let LWRP-CYCLE     (bp "LWRP-CYCLE"))

(defn lwrp-ready () (intern_node LWRP-READY (empty)))
(defn lwrp-ambiguous () (intern_node LWRP-AMBIGUOUS (empty)))
(defn lwrp-cycle () (intern_node LWRP-CYCLE (empty)))
(defn lwrp-ready? (cell) (lwo-category? cell LWRP-READY))
(defn lwrp-ambiguous? (cell) (lwo-category? cell LWRP-AMBIGUOUS))
(defn lwrp-cycle? (cell) (lwo-category? cell LWRP-CYCLE))

(defn lwrp-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwrp-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwrp-all-nodes-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwsl-integrated-current? world (head items)) 1)
            (lwrp-all-nodes-current? world (tail items)) 0)))

(defn lwrp-edge-in-group? (edge relation nodes)
    (if (and (node_eq (lwrl-edge-relation edge) relation)
             (and (eq (lwo-field-has? nodes (lwrl-edge-left edge)) 1)
                  (eq (lwo-field-has? nodes
                        (lwrl-edge-right edge)) 1))) 1 0))

(defn lwrp-collect-edges (world items relation nodes edges)
    (if (eq (len items) 0) edges
        (do
            (let candidate (head items))
            ; Form call arguments are eager: reject unrelated cells before
            ; invoking relation currentness, which re-observes endpoint and
            ; evidence state.
            (if (eq (lwrl-candidate? candidate) 0)
                (lwrp-collect-edges
                    world (tail items) relation nodes edges)
                (if (eq (lwrp-edge-in-group?
                            (lwo-emergent-shape candidate)
                            relation nodes) 0)
                    (lwrp-collect-edges
                        world (tail items) relation nodes edges)
                    (if (eq (lwrl-integrated-current?
                                world candidate) 0)
                        (lwrp-collect-edges
                            world (tail items) relation nodes edges)
                        (lwrp-collect-edges world (tail items) relation nodes
                            (lwo-field-add edges candidate))))))))

(defn lwrp-attribution-witnesses (world items witnesses)
    (if (eq (len items) 0) witnesses
        (lwrp-attribution-witnesses world (tail items)
            (lwrp-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                witnesses))))

; children: offered relation, exact node field, current edge field, witnesses,
;           local path
(defn lwrp-group-cell (relation nodes edges witnesses)
    (intern_node LWRP-GROUP
        (list relation nodes edges witnesses (lwo-local-path))))
(defn lwrp-group? (cell) (lwo-category? cell LWRP-GROUP))
(defn lwrp-group-relation (group) (nth (node_children group) 0))
(defn lwrp-group-nodes (group) (nth (node_children group) 1))
(defn lwrp-group-edges (group) (nth (node_children group) 2))
(defn lwrp-group-witnesses (group) (nth (node_children group) 3))
(defn lwrp-group-path (group) (nth (node_children group) 4))

(defn lwrp-group-for (world relation nodes)
    (if (or (eq (lwo-category? nodes LWO-FIELD) 0)
            (or (eq (lwo-field-size nodes) 0)
                (eq (lwrp-all-nodes-current?
                      world (lwo-field-items nodes)) 0)))
        (lwo-none)
        (do
            (let edges
                (lwrp-collect-edges world
                    (lwo-field-items (lwo-world-cells world))
                    relation nodes (lwo-empty-field)))
            (let node-witnesses
                (lwrp-attribution-witnesses world
                    (lwo-field-items nodes) (lwo-empty-field)))
            (let witnesses
                (lwrp-attribution-witnesses world
                    (lwo-field-items edges) node-witnesses))
            (lwrp-group-cell relation nodes edges witnesses))))

(defn lwrp-sequence (items) (intern_node LWRP-SEQUENCE items))
(defn lwrp-sequence? (cell) (lwo-category? cell LWRP-SEQUENCE))
(defn lwrp-sequence-items (sequence) (node_children sequence))

; children: group, ordered sequence, remaining nodes, status, alternatives,
;           optional unknown, local evidence, local path
(defn lwrp-plan-cell
    (group ordered remaining status alternatives unknown evidence)
    (intern_node LWRP-PLAN
        (list group (lwrp-sequence ordered) remaining status alternatives
              unknown evidence (lwo-local-path))))
(defn lwrp-plan? (cell) (lwo-category? cell LWRP-PLAN))
(defn lwrp-plan-group (plan) (nth (node_children plan) 0))
(defn lwrp-plan-sequence (plan) (nth (node_children plan) 1))
(defn lwrp-plan-remaining (plan) (nth (node_children plan) 2))
(defn lwrp-plan-status (plan) (nth (node_children plan) 3))
(defn lwrp-plan-alternatives (plan) (nth (node_children plan) 4))
(defn lwrp-plan-unknown (plan) (nth (node_children plan) 5))
(defn lwrp-plan-evidence (plan) (nth (node_children plan) 6))
(defn lwrp-plan-path (plan) (nth (node_children plan) 7))

(defn lwrp-edge-in-remaining? (edge remaining)
    (if (and (eq (lwo-member? remaining (lwrl-edge-left edge)) 1)
             (eq (lwo-member? remaining
                    (lwrl-edge-right edge)) 1)) 1 0))

(defn lwrp-node-has-incoming-items? (node remaining edge-items)
    (if (eq (len edge-items) 0) 0
        (do
            (let edge (lwo-emergent-shape (head edge-items)))
            (if (and (eq (lwrp-edge-in-remaining? edge remaining) 1)
                     (node_eq (lwrl-edge-right edge) node)) 1
                (lwrp-node-has-incoming-items?
                    node remaining (tail edge-items))))))

(defn lwrp-zero-incoming-items (items remaining edge-items acc)
    (if (eq (len items) 0) acc
        (lwrp-zero-incoming-items (tail items) remaining edge-items
            (if (eq (lwrp-node-has-incoming-items?
                       (head items) remaining edge-items) 1)
                acc (cons (head items) acc)))))

(defn lwrp-remove-node (items wanted)
    (if (eq (len items) 0) (empty)
        (if (node_eq (head items) wanted)
            (lwrp-remove-node (tail items) wanted)
            (cons (head items)
                (lwrp-remove-node (tail items) wanted)))))

(defn lwrp-derive (group remaining ordered)
    (if (eq (len remaining) 0)
        (lwrp-plan-cell group ordered (lwo-empty-field)
            (lwrp-ready) (lwo-empty-field) (lwo-none) group)
        (do
            (let edge-items
                (lwo-field-items (lwrp-group-edges group)))
            (let zeroes
                (lwrp-zero-incoming-items remaining remaining edge-items
                    (empty)))
            (if (eq (len zeroes) 0)
                (lwrp-plan-cell group ordered (lwo-field remaining)
                    (lwrp-cycle) (lwo-empty-field)
                    (lwlc-unknown group) group)
                (if (gt (len zeroes) 1)
                    (lwrp-plan-cell group ordered (lwo-field remaining)
                        (lwrp-ambiguous) (lwo-field zeroes)
                        (lwlc-unknown group) group)
                    (do
                        (let chosen (head zeroes))
                        (lwrp-derive group
                            (lwrp-remove-node remaining chosen)
                            (append ordered (list chosen)))))))))

(defn lwrp-plan-for (world relation nodes)
    (do
        (let group (lwrp-group-for world relation nodes))
        (if (node_eq group (lwo-none)) (lwo-none)
            (lwrp-derive group (lwo-field-items nodes) (empty)))))

(defn lwrp-plan-current? (world plan)
    (if (eq (lwrp-plan? plan) 0) 0
        (do
            (let group (lwrp-plan-group plan))
            (if (node_eq plan
                    (lwrp-plan-for world
                        (lwrp-group-relation group)
                        (lwrp-group-nodes group))) 1 0))))

0
