; trust-row.fk — render the per-step trust matrix as one human-readable line (the live "field").
;
; preludes: form-stdlib/core.fk
;
; The canonical format for the per-step trust rows AGENTS.md asks for (route reasoning through form-cli,
; report trust per step). It turns the four signals — path / grounded / freq / suffic — into
; a single line a reader scans at a glance: which step came from the native body, and how fully it is
; trusted. path / grounded / suffic are bits. Frequency is ternary: 0 no, 1 yes,
; 2 unknown. Unknown is deliberately not flattened to "no": an unavailable semantic
; sensor is different from a measured fear-frequency answer. Each signal remains visible
; even on a rented step; path alone says who produced the final answer.
;
; Proven by: form-stdlib/tests/trust-row-band.fk (four-way at validate.sh)

(do
    (defn tr-mark      (b) (if (eq b 1) "yes" (if (eq b 0) "no" "unknown")))
    (defn tr-path-name (p) (if (eq p 1) "native" "rented"))
    ; Count exact positive readings. A ternary unknown (=2) must never inflate the
    ; score to four and accidentally manufacture an observation.
    (defn tr-positive  (b) (if (eq b 1) 1 0))
    (defn tr-score     (p g f s)
        (add (tr-positive p) (add (tr-positive g) (add (tr-positive f) (tr-positive s)))))

    ; full native trust: all four signals must independently read exactly yes.
    (defn tr-observed? (p g f s)
        (if (and (eq p 1) (and (eq g 1) (and (eq f 1) (eq s 1)))) 1 0))

    ; the verdict word: OBSERVED (full native trust), native-partial (native but not fully verified),
    ; or rented (the oracle answered)
    (defn tr-verdict (p g f s)
        (if (eq (tr-observed? p g f s) 1) "OBSERVED"
            (if (eq p 1) "native-partial" "rented")))

    ; the one-line field
    (defn tr-row (p g f s)
        (str_concat "trust  path:"
        (str_concat (tr-path-name p)
        (str_concat "  grounded:"
        (str_concat (tr-mark g)
        (str_concat "  freq:"
        (str_concat (tr-mark f)
        (str_concat "  suffic:"
        (str_concat (tr-mark s)
        (str_concat "  -> " (tr-verdict p g f s)))))))))))

    ; Stable parseable result row for the ask carrier. The frequency source is
    ; explicit so a general semantic reading can never be confused with a
    ; certified deterministic Form excerpt or an absent sensor.
    (defn tr-row-with-source (p g f source s)
        (str_concat "trust  path:"
        (str_concat (tr-path-name p)
        (str_concat "  grounded:"
        (str_concat (tr-mark g)
        (str_concat "  freq:"
        (str_concat (tr-mark f)
        (str_concat "  freq-source:"
        (str_concat source
        (str_concat "  suffic:"
        (str_concat (tr-mark s)
        (str_concat "  observed:"
        (str_concat (tr-mark (tr-observed? p g f s))
        (str_concat "  -> " (tr-verdict p g f s)))))))))))))))

    ; Lossless trace-funnel word. The display row is expanded only at the edge.
    ; Layout, low to high: path:1 ground:1 freq:2 source:2 suffic:1
    ; observed:1 verdict:2 reason:3 ack-kind:2 = 15 bits, transported as two
    ; bytes. Ack kind is 0 nothing, 1 zero, 2 one, 3 node. A node ack carries
    ; its NodeID separately (or as a shared-dictionary reference); the other
    ; three kinds carry no payload.
    ; `observed` is derivable but retained as a corruption check.
    (defn tr-pack (p g f source s observed verdict reason ack-kind)
        (add p
        (add (mul g 2)
        (add (mul f 4)
        (add (mul source 16)
        (add (mul s 64)
        (add (mul observed 128)
        (add (mul verdict 256)
        (add (mul reason 1024) (mul ack-kind 8192))))))))
    (defn tr-unpack-path     (word) (mod word 2))
    (defn tr-unpack-grounded (word) (mod (div word 2) 2))
    (defn tr-unpack-freq     (word) (mod (div word 4) 4))
    (defn tr-unpack-source   (word) (mod (div word 16) 4))
    (defn tr-unpack-suffic   (word) (mod (div word 64) 2))
    (defn tr-unpack-observed (word) (mod (div word 128) 2))
    (defn tr-unpack-verdict  (word) (mod (div word 256) 4))
    (defn tr-unpack-reason   (word) (mod (div word 1024) 8))
    (defn tr-unpack-ack-kind (word) (mod (div word 8192) 4))
    (defn tr-pack-consistent? (word)
        (eq (tr-unpack-observed word)
            (tr-observed? (tr-unpack-path word) (tr-unpack-grounded word)
                          (tr-unpack-freq word) (tr-unpack-suffic word))))
    (defn tr-pack-bytes (word)
        (str_concat (byte_to_str (mod word 256))
                    (byte_to_str (mod (div word 256) 256))))
    (defn tr-unpack-bytes (bytes)
        (add (str_byte_at bytes 0) (mul (str_byte_at bytes 1) 256)))

    0)
