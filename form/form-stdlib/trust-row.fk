// trust-row.fk — render the answer's attributed observations in one line.
//
import form-stdlib/core.fk;
//
// Path names the responding lane. Grounding names source/answer binding.
// Frequency and sufficiency remain their own readings, never a whole-answer trust
// verdict. A language reading cannot erase observed source binding or decide
// whether a person may receive an answer. Unknown frequency stays unknown.
//
section [form.bml] {
    def tr-mark(b) = (Comparable) b == 1 ? "yes" : (Comparable) b == 0 ? "no" : "unknown";
    def tr-path-name(p) = (Comparable) p == 1 ? "native" : "rented";
    // `observed` has this narrow scope: source/answer binding was observed.
    // It establishes neither answer quality nor the person's felt experience.
    def tr-observed?(g) = (Comparable) g == 1 ? 1 : 0;
    def tr-verdict(g) = (Comparable) tr-observed?(g) == 1 ? "SOURCE-BOUND" : "SOURCE-UNBOUND";
    // the one-line field
    def tr-row(p, g, f, s) = ("evidence  path:" + (tr-path-name(p) + ("  grounded:" + (tr-mark(g) + ("  freq:" + (tr-mark(f) + ("  suffic:" + (tr-mark(s) + ("  -> " + tr-verdict(g))))))))));
    // Stable parseable result row for the ask carrier. The frequency source is
    // explicit so a general semantic reading can never be confused with a
    // certified deterministic Form excerpt or an absent sensor.
    def tr-row-with-source(p, g, f, source, s) = ("evidence  path:" + (tr-path-name(p) + ("  grounded:" + (tr-mark(g) + ("  freq:" + (tr-mark(f) + ("  freq-source:" + (source + ("  suffic:" + (tr-mark(s) + ("  observed:" + (tr-mark(tr-observed?(g)) + ("  -> " + tr-verdict(g))))))))))))));
    0;
}
