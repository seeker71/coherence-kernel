        def fgl-kept-take(kept, publisher) = ggf-kept-handle(kept, publisher, "take");
        def fgl-kept-give(kept, publisher) = ggf-kept-handle(kept, publisher, "give");
        def fgl-sensor-take-held(kept, sensor, held) {
            let entry = ggf-kept-find(kept, fgsr-publisher(sensor), "take");
            if eq(len(entry), 0) then fgsr-take(sensor, held) else fgsr-take-held(ggf-kept-handle-of(entry), ggf-kept-name(entry), held);
        }
        def fgl-cadence-last-save-held(kept, workMs, waitMs, budgetMs) = fgl-last-give-held(fgl-kept-give(kept, fgl-last-name("cadence")), list(workMs, waitMs, budgetMs));
        def fgl-loop-stopped(kept, frame, mark, count) {
