            let waitTargetMs = fgl-schedule-wait-ms(activeSchedule, workEnded);
            let watchNames = fgl-wait-frame-names(fgl-cache-roster(cache));
            let handles = ggf-kept-handles(fgl-cache-kept(cache), watchNames, "take");
            let rested = fgl-wait-rest(waitTargetMs, handles);
            let waitEnded = now_unix_ms();
            let waitMs = fgl-frame-elapsed-ms(workEnded, waitEnded);
            let wake = fgl-wait-wake(rested, watchNames, handles, waitEnded, activeSchedule);
            let plan = fgel-plan-wake(activeSchedule, frameBuffer, wake, nextFrame);
            let nextBuffer = fgl-present-observed(frameBuffer, plan, fgl-cache-kept(cache), frameStarted);
            let completeWorkMs = workMs + fgl-frame-elapsed-ms(waitEnded, now_unix_ms());
            let cadenceSaved = fgl-cadence-last-save-held(fgl-cache-kept(cache), completeWorkMs, waitMs, budgetMs);
            fgl-loop(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, nextBuffer, fgel-plan-schedule(plan), surface, dependencyIdentity, stringBaseline, nodeBaseline, completeWorkMs, waitMs, budgetMs, cache);
        }
        def fgl-jit-hold-enter(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, schedule, surface, dependencyIdentity, stringBaseline, nodeBaseline, faultFrame, fault, cache) {
            let plan = fgel-plan-wake(schedule, frameBuffer, fgl-jit-fault-wake(fault), faultFrame);
            let shownBuffer = fgl-present-plan(frameBuffer, plan);
            fgl-jit-hold(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, shownBuffer, plan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        // During a refusal Glass reads only the exact JIT publisher and its
        // control inbox. It does not collect host, storage, model inventory,
        // or render ordinary frames. The 250 ms wait remains explicitly the
        // wall-clock compatibility seam until the monotonic event door exists.
        def fgl-jit-hold(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) {
            let epoch = now_unix_ms();
            let jitSamples = fgl-jit-current-samples();
            let healed = fgl-jit-healed-for(jitSamples, fault);
            let remoteControl = fgl-poll-control-full(controlState, jitSamples, epoch);
            let control = fgl-input-poll(fgl-input-with(remoteControl, fgl-input-state(controlState)), jitSamples, epoch);
            (Comparable) fgl-control-quit?(control) == 1 ? fgl-loop-stopped(fgl-cache-kept(cache), frame, fglu-supervisor-mark("abstain"), len(history)) : len(healed) > 0 ? fgl-jit-hold-resume(control, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed, cache) : fgl-jit-hold-wait(control, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        def fgl-jit-hold-wait(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) {
            let waited = fgl-sleep-ms(250);
            fgl-jit-hold(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        def fgl-jit-hold-resume(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed, cache) {
            let resumed = fgel-resume-held(heldPlan, fgl-jit-healed-wake(healed));
            !((String) fgel-plan-disposition(resumed) == "present") ? fgl-jit-hold(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) : fgl-loop(controlState, frame, ownerHeld, hostHeld, queueHeld, storageHeld, heatRows, history, frameBuffer, fgel-plan-schedule(resumed), surface, dependencyIdentity, stringBaseline, nodeBaseline, 0, 0, fgel-schedule-budget(fgel-plan-schedule(resumed)), cache);
        }
        def fgl-live() {
            let inputOpened = fgki-open();
            let retired = fgl-retire-self-publisher();
            let state = fglu-supervisor-mark("running");
            let stringBaseline = kernel_stat(5);
            let nodeBaseline = kernel_stat(4);
            let epoch = now_unix_ms();
            let surface = fgl-surface(epoch);
            fgl-loop(fgl-control-start-state(fgtm-read-control-ack(FGLRoot(), FGLControlChannel())), 0, list(), list(), list(), list(), list(), list(), fgel-buffer-empty(), fgel-schedule-start(epoch, fgl-frame-budget-ms(FGLQuietHz())), surface, fglu-dependency-manifest(), stringBaseline, nodeBaseline, -1, -1, -1, fgl-cache-empty());
        }

        def fgl-control-argument(text) = is-blank?(text) ? fgtm-absent() : fgtm-present(trim(text));
        def fgl-control-matching-ack(read, offer) {
            (len(read) < 4) || (!((String) read[2] == "ack")) ? list() : !((Comparable) fgtm-field-present?(read[3]) == 1) ? list() : fgl-control-matching-ack-value(fgtm-field-value(read[3]), offer);
        }
        def fgl-control-matching-ack-value(ack, offer) {
            !((Comparable) fgtm-ack-valid?(ack) == 1) ? list() : !((String) fgtm-ack-offer-id(ack) == fgtm-offer-id(offer)) ? list() : !((String) fgtm-ack-evidence(ack) == "physical-live") ? list() : !((String) fgtm-ack-source(ack) == "glass.monitor") ? list() : fgtm-ack-epoch(ack) < fgtm-offer-epoch(offer) ? list() : ack;
        }
        def fgl-control-await(offer, attempts) {
            let read = fgtm-read-control-ack(FGLRoot(), FGLControlChannel());
            let ack = fgl-control-matching-ack(read, offer);
            len(ack) > 0 ? list("glass-control-result-v1", fgtm-ack-disposition(ack), offer, ack) : attempts <= 0 ? list("glass-control-result-v1", "timeout", "missing-door=glass.monitor.control-ack", offer, read) : fgl-control-await-after-wait(offer, attempts);
        }
        def fgl-control-await-after-wait(offer, attempts) {
            let waited = fgl-sleep-ms(250);
            fgl-control-await(offer, attempts - 1);
        }
        def fgl-control-offer-and-await(offer) {
            let wrote = fgtm-offer-control(FGLRoot(), offer);
            (len(wrote) >= 2) && ((String) wrote[1] == "offered") ? fgl-control-await(offer, 8) : list("glass-control-result-v1", "not-offered", "missing-door=glass.monitor.control-inbox", offer, wrote);
        }
        def fgl-control-key-view(key) = (String) key == "h" ? "help" : (String) key == "s" ? "meaning" : (String) key == "k" ? "kernel" : (String) key == "v" ? "events" : (String) key == "n" ? "channels" : (String) key == "a" ? "atlas" : (String) key == "t" ? "raster" : (String) key == "o" ? "overview" : (String) key == "m" ? "memory" : (String) key == "f" ? "flow" : (String) key == "j" ? "recipes" : (String) key == "d" ? "choice" : "";
        def fgl-control-key-lang(key) = (String) key == "0" ? "none" : ((Comparable) str_len(key) == 1) && ((str_byte_at(key, 0) >= 49) && (str_byte_at(key, 0) <= 52)) ? head(tln-defaults()[str_byte_at(key, 0) - 49]) : "";
        // r is the room: the ear's own domain, held as a focus and not a view, because the ear gives
        // metric rows and not telemetry samples — fgl-control-selector-valid? lets that focus stand.
        def fgl-control-key-domain(key) = (String) key == "r" ? FGLEarDomain() : "";
        // z is the ear's own key. It is free -- a t o m f j s k v n d h are views, r is the room,
        // 1-4 and 0 are tongues, l i e c q g y w are actions -- and of the letters still free
        // (b p u x z) it is the only one that already MEANS sleep everywhere a person has read a
        // page, which is exactly the state it moves the ear between: awake by default, asleep by
        // a choice. It carries no argument: an ear is open or it is not.
        def fgl-control-key-action(key) = (String) key == "l" ? "languages" : str_len(fgl-control-key-lang(key)) > 0 ? "focus" : str_len(fgl-control-key-view(key)) > 0 ? "focus" : str_len(fgl-control-key-domain(key)) > 0 ? "focus" : (String) key == "i" ? "inspect" : (String) key == "e" ? "request-evidence" : (String) key == "c" ? "continue" : (String) key == "q" ? "abstain" : (String) key == "g" ? "step" : (String) key == "y" ? "take" : (String) key == "w" ? "hold" : (String) key == "z" ? "ear" : key;
        def fgl-control-key-needs-argument?(key, action) = str_len(fgl-control-key-lang(key)) > 0 ? 0 : str_len(fgl-control-key-view(key)) > 0 ? 0 : str_len(fgl-control-key-domain(key)) > 0 ? 0 : (String) action == "continue" ? 0 : (String) action == "abstain" ? 0 : (String) action == "ear" ? 0 : (Comparable) fgl-choice-walk?(action) == 1 ? 0 : 1;
        def fgl-control-key-argument(key, entered) = str_len(fgl-control-key-lang(key)) > 0 ? fgl-control-key-lang(key) : str_len(fgl-control-key-view(key)) > 0 ? fgl-control-key-view(key) : str_len(fgl-control-key-domain(key)) > 0 ? fgl-control-key-domain(key) : entered;
        def fgl-control-interactive() {
            let p0 = say-line("FORM GLASS CONTROL channel=glass-monitor");
            let p1 = say-line("key h help | a atlas | t raster | o overview | m memory | f flow | j recipes | s transcripts | k kernel | v events | n channels | d choice | r room | z ear awake/asleep | 1-4 natural languages | l language codes | 0 none | i inspect | e evidence | c reset | g step | y take | w hold | q abstain; or full action:");
            let actionRaw = read_line();
            let key = nothing?(actionRaw) ? "" : trim(actionRaw);
            let action = fgl-control-key-action(key);
            let needsArgument = fgl-control-key-needs-argument?(key, action);
            let p2 = (Comparable) needsArgument == 1 ? say-line((String) action == "languages" ? "natural-language codes joined by + (en+de), all, or none:" : "argument view|channel|cell|metric id:") : 0;
            let argumentRaw = (Comparable) needsArgument == 1 ? read_line() : "";
            let argumentEntered = argumentRaw ?? "";
            let argument = fgl-control-key-argument(key, argumentEntered);
            let epoch = now_unix_ms();
            let offer = fgtm-control-offer(FGLControlChannel(), "offer." ++ int_to_str(epoch), epoch, action, fgl-control-argument(argument), "declared", "terminal.operator");
            fgl-control-offer-and-await(offer);
        }
    }
    0;
}
