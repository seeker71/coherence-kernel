            let released = ggf-kept-release-all(kept);
            list("form-glass-live-stopped", frame, mark, count);
        }
        def fgl-wait-woke(rested) = if lt(len(rested), 2) then -1 else nth(rested, 1);
        def fgl-wait-woke-seq(rested, woke) = if lt(len(rested), 4) then -1 else if ge(woke, len(nth(rested, 3))) then -1 else nth(nth(rested, 3), woke);
        def fgl-wait-wake(rested, names, handles, waitEnded, schedule) {
            let woke = fgl-wait-woke(rested);
            let liveNames = fgl-wait-live-names(names, handles);
            let source = if or(lt(woke, 0), ge(woke, len(liveNames))) then "" else nth(liveNames, woke);
            let kind = if str_eq(source, fgl-wait-inbox-name()) then "control" else "telemetry";
            if eq(woke, -2) then fgel-wake("control", waitEnded, "terminal.keyboard", str_concat("key.", int_to_str(waitEnded))) else if eq(str_len(source), 0) then fgel-wake("deadline", waitEnded, "wall-clock-compatibility", str_concat("deadline.", int_to_str(fgel-schedule-deadline(schedule)))) else fgel-wake(kind, waitEnded, source, str_concat("seq.", int_to_str(fgl-wait-woke-seq(rested, woke))));
        }
        def fgl-sleep(samples) = if eq(fgl-any-active?(samples), 1) then fgl-sleep-hz(FGLActiveHz()) else fgl-sleep-hz(FGLQuietHz());
        def fgl-cadence-unavailable-row(id, label) = fgo-unavailable("glass", id, label, "milliseconds", "cpu-scheduler", str_concat("glass.deadline.completed-predecessor.", id), "glass", "first frame has no completed predecessor");
        def fgl-cadence-live-row(id, label, value, budget, note) = fgo-sized("glass", id, label, value, "milliseconds", budget, value, "cpu-scheduler", "physical-live", "now_unix_ms+deadline remainder", "live", "glass", note);
        def fgl-cadence-last-save(workMs, waitMs, budgetMs) = fgl-last-give("cadence", list(workMs, waitMs, budgetMs));
        def fgl-cadence-last-load() {
            let cell = fgl-last-take("cadence");
            if nothing?(cell) then list() else if lt(len(cell), 3) then list() else cell;
        }
        def fgl-cadence-measured-rows(workMs, waitMs, budgetMs) = list(fgl-cadence-live-row("frame-work-ms", "previous frame observation work", workMs, budgetMs, "all collection render and control work before wait"), fgl-cadence-live-row("frame-wait-ms", "previous frame deadline wait", waitMs, budgetMs, "actual host wait; measured zero means the frame exceeded its target"), fgl-cadence-live-row("frame-budget-ms", "previous frame target", budgetMs, budgetMs, "250ms active or moving; 500ms quiet"), fgl-cadence-live-row("frame-cycle-ms", "previous frame work plus wait", add(workMs, waitMs), budgetMs, "physical completed-frame cadence excluding recursive call overhead"));
        def fgl-cadence-persisted-rows() {
            let last = fgl-cadence-last-load();
            if eq(len(last), 0) then list() else fgl-cadence-measured-rows(nth(last, 0), nth(last, 1), nth(last, 2));
        }
        def fgl-cadence-rows(frame, workMs, waitMs, budgetMs) = if or(lt(workMs, 0), or(lt(waitMs, 0), lt(budgetMs, 0))) then list() else fgl-cadence-measured-rows(workMs, waitMs, budgetMs);
        def fgl-frame-fast-rows(frame, workMs, waitMs, budgetMs, changingRows) = append(fgl-cadence-rows(frame, workMs, waitMs, budgetMs), changingRows);
        def fgl-projection(width, height, epoch, focus, metrics, samples, publishers, status) {
            let frame = fgd-segment-frame(width, height, epoch, focus, metrics, samples, publishers, status);
            ftc-cat(list(ftc-terminal-home(), fgd-segment-project(frame), ftc-terminal-erase-rest()));
        }
        def fgl-render-new(projection) {
            let shown = say(projection);
            projection;
        }
        def fgl-render-changed(projection, priorProjection) = if str_eq(projection, priorProjection) then projection else fgl-render-new(projection);

        def fgl-frame-same-size?(previous, nextFrame) = if or(eq(len(previous), 0), eq(len(nextFrame), 0)) then 0 else if not(eq(fgd-segment-frame-width(previous), fgd-segment-frame-width(nextFrame))) then 0 else if not(eq(fgd-segment-frame-height(previous), fgd-segment-frame-height(nextFrame))) then 0 else 1;
        def fgl-frame-patch(previous, nextFrame) = if eq(fgl-frame-same-size?(previous, nextFrame), 0) then ftc-cat(list(ftc-terminal-home(), fgd-segment-project(nextFrame), ftc-terminal-erase-rest())) else ftc-segment-lines-diff(fgd-segment-frame-lines(previous), fgd-segment-frame-lines(nextFrame));
        def fgl-render-frame(previous, nextFrame) {
            let patch = if eq(fgl-frame-same-size?(previous, nextFrame), 0) then ftcb-screen-frame(fgd-segment-frame-lines(nextFrame)) else ftcb-screen-diff(fgd-segment-frame-lines(previous), fgd-segment-frame-lines(nextFrame));
            ftcb-write-stdout(ftcb-display-patch(patch));
        }
        def fgl-render-buffer(buffer, nextFrame) {
            let staged = fgel-buffer-stage(buffer, nextFrame);
            let shown = fgl-render-frame(fgel-buffer-front(staged), fgel-buffer-back(staged));
            if lt(shown, 0) then buffer else fgel-buffer-commit(staged);
        }
        def fgl-present-plan(buffer, plan) {
            let planned = fgel-plan-buffer(plan);
            let shown = fgl-render-frame(fgel-buffer-front(buffer), fgel-buffer-front(planned));
            fgl-render-commit(shown, buffer, planned);
        }
        def fgl-render-commit(writeResult, prior, planned) = if lt(writeResult, 0) then prior else planned;
        def fgl-schedule-for-hz(schedule, epoch, hz) {
            let budget = fgl-frame-budget-ms(hz);
            if not(eq(fgel-schedule-valid?(schedule), 1)) then fgel-schedule-start(epoch, budget) else if not(eq(fgel-schedule-budget(schedule), budget)) then fgel-schedule-start(epoch, budget) else schedule;
        }
        def fgl-schedule-wait-ms(schedule, epoch) = if ge(epoch, fgel-schedule-deadline(schedule)) then 0 else sub(fgel-schedule-deadline(schedule), epoch);
        def fgl-dashboard-frame(width, height, epoch, hz, frame, control, metrics, samples, publishers, history, observations) = fgd-live-segment-frame(width, height, epoch, hz, frame, fgl-control-view(control), fgl-control-focus(control), fgl-control-filter(control), fgl-control-selected(control), fgl-control-evidence-open?(control), metrics, samples, publishers, fgl-control-status(control), history, observations, fgl-input-caption(control));

        // One bounded physical frame is the inspection door for agents and
        // receipts.  It shares every collector and renderer with the resident
        // loop, but fixes the requested view instead of relying on terminal
        // control state held by another process.
        // The same bounded frame with the focus handed in: a receipt about one
        // lane (a channel tag such as `mesh`) reads that lane and nothing else.
        def fgl-bounded-current-frame-focus(view, focus, width, height) = fgl-bounded-current-frame-focus-filter(view, focus, "all", width, height);
        // the same bounded frame with the row filter handed in as well: a focus names what the
        // frame is ABOUT, and the filter is what the view's own metric picker is allowed to see —
        // the interactive path sets both from one key, and a receipt about one lane wants both too
        def fgl-bounded-current-frame-focus-filter(view, focus, filter, width, height) {
            let epoch0 = now_unix_ms();
            let inventory0 = fgtm-inventory(FGLRoot());
            let samples0 = fgl-external-samples(fgl-inventory-samples-at(inventory0, epoch0));
            let poke = fgl-poke-owner-status(samples0, epoch0);
            let waited = if eq(poke, 1) then int_to_str(host_sleep_ms(350)) else "held";
            let epoch = now_unix_ms();
            let frameNumber = 0;
            let inventoryPair = fgtm-inventory-cached(FGLRoot(), fgl-cache-snapshots(fgl-cache-empty()));
            let inventory = nth(inventoryPair, 0);
            let inventoryMoved = if ge(len(inventoryPair), 2) then fgtm-inventory-moved(inventoryPair, fgl-cache-snapshots(fgl-cache-empty())) else 1;
            let inventorySamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(fgl-cache-empty())), 0)) then fgl-cache-samples(fgl-cache-empty()) else fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let externalSamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(fgl-cache-empty())), 0)) then fgl-cache-samples(fgl-cache-empty()) else fgl-dedupe-samples(append(fgl-jit-current-samples(), inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostRows = append(fgsr-rows-or-absent("machine", fgsr-take("machine", list())), fgsr-rows-or-absent("host", fgsr-take("host", list())));
            let ownerRows = fgsr-rows-or-absent("owner", fgsr-take("owner", list()));
            let queueRows = fgsr-rows-or-absent("queue", fgsr-take("queue", list()));
            let storageRows = fgsr-rows-or-absent("storage", fgsr-take("storage", list()));
            let earRows = fgsr-rows-or-absent("ear", fgsr-take("ear", list()));
            let heatRows = fgl-heat-rows-at(frameNumber, list(), epoch);
            let lastCadence = fgl-cadence-last-load();
            let cadenceRows = if eq(len(lastCadence), 0) then list() else fgl-cadence-measured-rows(nth(lastCadence, 0), nth(lastCadence, 1), nth(lastCadence, 2));
            let localRows = append(fgo-observe-rows(append(cadenceRows, fgl-fast-rows(frameNumber, list(), list())), epoch, frameNumber), append(heatRows, fgo-observe-rows(cons(fgl-gpu-estimate-row(append(ownerRows, hostRows), fgo-metal-word(metal_live(), 11)), fgl-kernel-rows()), epoch, frameNumber)));
            let gaveGlass = fgsr-give("glass", epoch, localRows);
            let fastRows = fgsr-rows-or-absent("glass", fgsr-take("glass", list()));
            let growthRows = fgo-observe-rows(list(fgl-string-growth-row(kernel_stat(5)), fgl-node-growth-row(kernel_stat(4))), epoch, frameNumber);
            let metricsObserved = fgl-ear-first(earRows, append(append(fastRows, append(ownerRows, append(hostRows, append(queueRows, append(storageRows, growthRows))))), fgl-model-route-rows(samples, epoch, frameNumber)));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let governorRefresh = fgl-refresh-governor(frameNumber);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = fgl-v2-observations(epoch, frameNumber, samples);
            let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
            let history = fgl-flow-history-with-last(point);
            let control = fgl-control-state-full(focus, "bounded-current", 0, "held", view, filter, "all", 0);
            fgl-dashboard-frame(width, height, epoch, FGLQuietHz(), frameNumber, control, metrics, samples, publishers, history, observations);
        }
        // ── the ear's stream, painted ──────────────────────────────────────────
        // The ear does not give one row of transcript; it gives a point on many axes and the
        // moments behind it, already in the order a stream is read (the room now, the line, the
        // stages, the tongues, the meaning, the verse, then newest-first what closed before).
        // Row order survives every path the glass takes -- fgd-filter-metrics and the focus body
        // keep what they are handed -- so the ear's rows LEAD the frame rather than sitting after
        // storage: the newest awareness paints first, and the machine's steady numbers follow it.
        def fgl-ear-first(earRows, rest) = append(earRows, rest);
        // One bounded frame of nothing but the room, for a receipt or a band. The atlas is the view
        // that hands its rows through whole (fglui-view-metrics), so it is the one that can paint a
        // stream; the overview picks its rows by name and would show the room nothing. The key `r`
        // sets focus AND filter to the ear the same way, so what an operator sees after pressing it
        // is what this door renders.
        def fgl-ear-stream-frame(width, height) = fgl-bounded-current-frame-focus-filter("atlas", FGLEarDomain(), FGLEarDomain(), width, height);
        def fgl-bounded-current-frame(view, width, height) {
            let epoch0 = now_unix_ms();
            let inventory0 = fgtm-inventory(FGLRoot());
            let samples0 = fgl-external-samples(fgl-inventory-samples-at(inventory0, epoch0));
            let poke = fgl-poke-owner-status(samples0, epoch0);
            let waited = if eq(poke, 1) then int_to_str(host_sleep_ms(350)) else "held";
            let epoch = now_unix_ms();
            let frameNumber = 0;
            let inventoryPair = fgtm-inventory-cached(FGLRoot(), fgl-cache-snapshots(fgl-cache-empty()));
            let inventory = nth(inventoryPair, 0);
            let inventoryMoved = if ge(len(inventoryPair), 2) then fgtm-inventory-moved(inventoryPair, fgl-cache-snapshots(fgl-cache-empty())) else 1;
            let inventorySamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(fgl-cache-empty())), 0)) then fgl-cache-samples(fgl-cache-empty()) else fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let externalSamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(fgl-cache-empty())), 0)) then fgl-cache-samples(fgl-cache-empty()) else fgl-dedupe-samples(append(fgl-jit-current-samples(), inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostRows = append(fgsr-rows-or-absent("machine", fgsr-take("machine", list())), fgsr-rows-or-absent("host", fgsr-take("host", list())));
            let ownerRows = fgsr-rows-or-absent("owner", fgsr-take("owner", list()));
            let queueRows = fgsr-rows-or-absent("queue", fgsr-take("queue", list()));
            let storageRows = fgsr-rows-or-absent("storage", fgsr-take("storage", list()));
            let earRows = fgsr-rows-or-absent("ear", fgsr-take("ear", list()));
            let heatRows = fgl-heat-rows-at(frameNumber, list(), epoch);
            let lastCadence = fgl-cadence-last-load();
            let cadenceRows = if eq(len(lastCadence), 0) then list() else fgl-cadence-measured-rows(nth(lastCadence, 0), nth(lastCadence, 1), nth(lastCadence, 2));
            let localRows = append(fgo-observe-rows(append(cadenceRows, fgl-fast-rows(frameNumber, list(), list())), epoch, frameNumber), append(heatRows, fgo-observe-rows(cons(fgl-gpu-estimate-row(append(ownerRows, hostRows), fgo-metal-word(metal_live(), 11)), fgl-kernel-rows()), epoch, frameNumber)));
            let gaveGlass = fgsr-give("glass", epoch, localRows);
            let fastRows = fgsr-rows-or-absent("glass", fgsr-take("glass", list()));
            let growthRows = fgo-observe-rows(list(fgl-string-growth-row(kernel_stat(5)), fgl-node-growth-row(kernel_stat(4))), epoch, frameNumber);
            let metricsObserved = fgl-ear-first(earRows, append(append(fastRows, append(ownerRows, append(hostRows, append(queueRows, append(storageRows, growthRows))))), fgl-model-route-rows(samples, epoch, frameNumber)));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let governorRefresh = fgl-refresh-governor(frameNumber);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = fgl-v2-observations(epoch, frameNumber, samples);
            let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
            let history = fgl-flow-history-with-last(point);
            let control = fgl-control-state-full("all", "bounded-current", 0, "held", view, "all", "all", 0);
            fgl-dashboard-frame(width, height, epoch, FGLQuietHz(), frameNumber, control, metrics, samples, publishers, history, observations);
        }

        // ---- the kernel, live and in-process: gift frames, function count, and the
        // hottest defns with their source pointers (kernel_hot, one pass, microseconds) ----
        def fgl-hot-cell-boxes(cell) = if lt(len(cell), 7) then 0 else nth(cell, 5);
        def fgl-hot-cell-unboxes(cell) = if lt(len(cell), 7) then 0 else nth(cell, 6);
        // the file name after the last slash of a unit path, built byte by byte (str_byte_at needs a length first).
        // str_find and substring are recipes that walk per byte and halve-and-concat: cut through them this walk
        // cost four times what it costs here (fstr-find-loop 2.3M calls in 600 ticks, witnessed 2026-09-06)
        def fgl-unit-leaf(path) = if nothing?(path) then "?" else fgl-unit-leaf-from(path, fgl-unit-leaf-start(path, str_len(path)));
        def fgl-unit-leaf-start(path, i) = if le(i, 0) then 0 else if eq(str_byte_at(path, sub(i, 1)), 47) then i else fgl-unit-leaf-start(path, sub(i, 1));
        def fgl-unit-leaf-from(path, i) = if ge(i, str_len(path)) then "" else str_concat(byte_to_str(str_byte_at(path, i)), fgl-unit-leaf-from(path, add(i, 1)));
        // the eighth field of a hot row: 1 when the defn stands as an f64 leaf (crystallized on its own box ledger), 2 when it stands as a native loop (crystallized on heat)
        def fgl-hot-cell-native(cell) = if lt(len(cell), 8) then "" else if eq(nth(cell, 7), 1) then " native" else if eq(nth(cell, 7), 2) then " native loop" else if eq(nth(cell, 7), 3) then " twin" else "";
        def fgl-kernel-hot-row(cell) = if lt(len(cell), 5) then list() else fgo-int("kernel", str_concat("hot.", nth(cell, 1)), fgd-cat(list(nth(cell, 1), " ", fgl-unit-leaf(nth(cell, 2)), ":", int_to_str(nth(cell, 3)), " box ", int_to_str(fgl-hot-cell-boxes(cell)), " unbox ", int_to_str(fgl-hot-cell-unboxes(cell)), fgl-hot-cell-native(cell))), nth(cell, 0), "calls", nth(cell, 0), "cpu-arena", "physical-live", "kernel_hot_rows", "live", "jit", fgd-cat(list(nth(cell, 2), ":", int_to_str(nth(cell, 3)), ":", int_to_str(nth(cell, 4)), " heat-lane calls; box = float pool slots this defn minted, unbox = float slots it read")));
        // the unboxing worklist: the defns minting the most float boxes -- what an unboxed lane would take first
        def fgl-kernel-box-row(cell) = if lt(len(cell), 7) then list() else fgo-int("jit", str_concat("box.", nth(cell, 1)), fgd-cat(list(nth(cell, 1), " mints ", int_to_str(nth(cell, 5)), " reads ", int_to_str(nth(cell, 6)), " ", fgl-unit-leaf(nth(cell, 2)), ":", int_to_str(nth(cell, 3)))), nth(cell, 5), "boxes", nth(cell, 5), "cpu-arena", "physical-live", "kernel_box_rows", "live", "jit", "float pool slots this defn allocated; an unboxed float lane would spare every one");
        def fgl-kernel-box-rows(cells) = if eq(len(cells), 0) then list() else fgl-kernel-box-rows-next(fgl-kernel-box-row(head(cells)), tail(cells));
        def fgl-kernel-box-rows-next(row, rest) = if eq(len(row), 0) then fgl-kernel-box-rows(rest) else cons(row, fgl-kernel-box-rows(rest));
        def fgl-jit-rows() = list(
            fgo-int("jit", "jit-boxes", "float boxes minted", kernel_stat(45), "boxes", 0, "cpu-arena", "physical-live", "kernel_stat.45", if eq(kernel_stat(45), 0) then "idle" else "live", "jit", "every float result allocates a pool slot; ints ride unboxed as tagged words"),
            fgo-int("jit", "jit-unboxes", "float boxes read", kernel_stat(46), "reads", 0, "cpu-arena", "physical-live", "kernel_stat.46", if eq(kernel_stat(46), 0) then "idle" else "live", "jit", "a pool slot dereferenced per float operand"),
            fgo-int("jit", "jit-native-calls", "native arm64 leaf calls", kernel_stat(47), "calls", 0, "cpu-arena", "physical-live", "kernel_stat.47", if eq(kernel_stat(47), 0) then "idle" else "live", "jit", "calls that ran as machine code from an in-RAM leaf image instead of the tree walk"),
            fgo-int("jit", "jit-crystallized", "defns crystallized on boxing heat", kernel_stat(48), "defns", 0, "cpu-arena", "physical-live", "kernel_stat.48", if eq(kernel_stat(48), 0) then "idle" else "live", "jit", "float bodies whose box ledger crossed 1024 boxes: emitted as arm64 f64 leaves, intermediates folded into d-registers, one box per call"),
            fgo-int("cell", "nodes-minted", "value nodes minted", kernel_stat(53), "nodes", 0, "cpu-arena", "physical-live", "kernel_stat.53", if eq(kernel_stat(53), 0) then "idle" else "live", "cell", "fresh cells this kernel interned into the permanent arena: the rate the shared field grows by, counted where a cell is minted"),
            fgo-int("jit", "jit-unroll", "native loops, unrolled by two", kernel_stat(49), "loops", 0, "cpu-arena", "physical-live", "kernel_stat.49", if eq(kernel_stat(49), 0) then "idle" else "live", "jit", "self-tail-call bodies crystallized on heat as arm64 loops: parameters in registers, compare and branch, the body emitted twice per pass with its own exit test in each copy"),
            fgo-int("jit", "jit-loop-iterations", "iterations run inside native loops", kernel_stat(50), "iterations", 0, "cpu-arena", "physical-live", "kernel_stat.50", if eq(kernel_stat(50), 0) then "idle" else "live", "jit", "loop passes the machine ran without the tree walk; the walker ran every one of these before the loop crystallized"));
        def fgl-kernel-hot-rows(cells) = if eq(len(cells), 0) then list() else fgl-kernel-hot-rows-next(fgl-kernel-hot-row(head(cells)), tail(cells));
        def fgl-kernel-hot-rows-next(row, rest) = if eq(len(row), 0) then fgl-kernel-hot-rows(rest) else cons(row, fgl-kernel-hot-rows(rest));
        // ---- every live kernel's page: /fg-k<pid>, the counters the kernel writes in place every 1024 dispatches ----
        // words: 0 magic 1 pid 2 start-ms 3 seq 4 dispatches 5 heat calls 6 nodes 7 strings 8 cons 9 fns 10 gift frames 11 gift bytes 12 node cap 13 heap cap 14 stack 15 floats 16 hottest tag 17 hottest count 18 cpu us 19 alive 20 distinct arms
        def fgl-kernel-page-source(pid) = str_concat("shm:/fg-k", str_concat(int_to_str(pid), "#"));
        // the pid's text and the page's source are rendered once per kernel and shared by its eleven rows
        def fgl-kernel-page-row(pidText, source, w, id, label, k, unit, channel) = fgo-int("kernel", str_concat("k.", str_concat(pidText, str_concat(".", id))), str_concat("kernel ", str_concat(pidText, str_concat(" ", label))), nth(w, k), unit, 0, "cpu-arena", "physical-live", source, "live", channel, "read from the kernel's own live page, no wire");
        def fgl-kernel-page-rows(pid) = fgl-kernel-page-rows-with(pid, kernel_live(pid));
        def fgl-kernel-page-rows-with(pid, w) = if lt(len(w), 34) then list() else fgl-kernel-page-rows-named(int_to_str(pid), str_concat(fgl-kernel-page-source(pid), int_to_str(nth(w, 3))), w);
        def fgl-kernel-page-rows-named(pidText, source, w) = list(fgl-kernel-page-row(pidText, source, w, "dispatches", "dispatches", 4, "calls", "kernel"), fgl-kernel-page-row(pidText, source, w, "heat", "heat-lane calls", 5, "calls", "jit"), fgl-kernel-page-row(pidText, source, w, "nodes", "nodes", 6, "nodes", "cell"), fgl-kernel-page-row(pidText, source, w, "fns", "fns", 9, "fns", "kernel"), fgl-kernel-page-row(pidText, source, w, "cpu-us", "cpu time", 18, "microseconds", "kernel"), fgl-kernel-page-row(pidText, source, w, "gifts", "gift frames", 10, "frames", "gift"), fgl-kernel-page-row(pidText, source, w, "store-shared", "store in shared memory", 22, "flag", "cell"), fgl-kernel-page-row(pidText, source, w, "melts", "heap melts", 21, "melts", "cell"), fgl-kernel-page-row(pidText, source, w, "mints", "value nodes minted", 33, "nodes", "cell"));
        // every live kernel's hottest defns, read from its own page ledgers and names -- no scan, no wire. The row's id is
        // the rank (k.<pid>.hot.0, .1, .2), the defn's name lives in the label: an id carrying the name gave every name a
        // kernel ever had in its top three a permanent field node and a framebuffer root (three a tick across the
        // fleet), and the glass walked those roots every frame (rankseat)
        def fgl-kernel-page-hot-row(pidText, source, cell, rank) = if lt(len(cell), 7) then list() else fgo-int("kernel", str_concat("k.", str_concat(pidText, str_concat(".hot.", int_to_str(rank)))), str_concat("k", str_concat(pidText, str_concat(" ", str_concat(nth(cell, 1), str_concat(" ", str_concat(fgl-unit-leaf(nth(cell, 2)), str_concat(":", str_concat(int_to_str(nth(cell, 3)), str_concat(" box ", str_concat(int_to_str(nth(cell, 5)), str_concat(" unbox ", str_concat(int_to_str(nth(cell, 6)), fgl-hot-cell-native(cell))))))))))))), nth(cell, 0), "calls", nth(cell, 0), "cpu-arena", "physical-live", source, "live", "jit", "read from that kernel live page: heat, float boxes minted, float boxes read");
        def fgl-kernel-page-hot-rows(pid, cells) = fgl-kernel-page-hot-rows-named(int_to_str(pid), fgl-kernel-page-source(pid), cells, 0);
        def fgl-kernel-page-hot-rows-named(pidText, source, cells, rank) = if eq(len(cells), 0) then list() else fgl-kernel-page-hot-next(pidText, source, fgl-kernel-page-hot-row(pidText, source, head(cells), rank), tail(cells), rank);
        def fgl-kernel-page-hot-next(pidText, source, row, rest, rank) = if eq(len(row), 0) then fgl-kernel-page-hot-rows-named(pidText, source, rest, rank) else cons(row, fgl-kernel-page-hot-rows-named(pidText, source, rest, add(rank, 1)));
        def fgl-kernels-rows(pids) = fgl-kernels-rows-with(pids, fgl-kernel-lives(pids));
        // every live kernel's page is read once a frame (fgl-kernel-lives) and the four sums and the per-kernel rows share that reading
        def fgl-kernel-lives(pids) = if eq(len(pids), 0) then list() else cons(kernel_live(head(pids)), fgl-kernel-lives(tail(pids)));
        def fgl-kernels-rows-with(pids, lives) = if eq(len(pids), 0) then list() else append(fgl-kernel-page-rows-with(head(pids), head(lives)), append(fgl-kernel-page-hot-rows(head(pids), kernel_page_hot(head(pids), 3)), fgl-kernels-rows-with(tail(pids), tail(lives))));
        def fgl-kernels-sum(pids, k, acc) = fgl-lives-sum(fgl-kernel-lives(pids), k, acc);
        def fgl-lives-sum(lives, k, acc) = if eq(len(lives), 0) then acc else fgl-lives-sum(tail(lives), k, add(acc, fgl-kernel-word(head(lives), k)));
        def fgl-kernel-word(w, k) = if lt(len(w), 24) then 0 else nth(w, k);
        def fgl-kernels-sum-row(pids, id, label, k, unit, channel, note) = fgl-lives-sum-row(pids, fgl-kernel-lives(pids), id, label, k, unit, channel, note);
        def fgl-lives-sum-row(pids, lives, id, label, k, unit, channel, note) = fgo-int("kernel", id, label, fgl-lives-sum(lives, k, 0), unit, 0, "cpu-arena", "physical-live", str_concat("shm:/fg-kernels#", int_to_str(len(pids))), if eq(len(pids), 0) then "empty" else "live", channel, note);
        def fgl-kernel-rows() {
            let pids = kernel_live_pids();
            let lives = fgl-kernel-lives(pids);
            append(list(
                fgl-lives-sum-row(pids, lives, "kernels-count", "live kernels", 19, "kernels", "kernel", "fkwu processes whose live page says alive"),
                fgl-lives-sum-row(pids, lives, "kernels-dispatches", "dispatches, every live kernel", 4, "calls", "kernel", "the D gauge is its per-frame delta"),
                fgl-lives-sum-row(pids, lives, "kernels-heat-calls", "heat-lane calls, every live kernel", 5, "calls", "jit", "the J gauge is its per-frame delta"),
                fgl-lives-sum-row(pids, lives, "kernels-cpu-us", "cpu time, every live kernel", 18, "microseconds", "kernel", "process clocks summed"),
                fgo-int("kernel", "gift-frames", "gift frames mapped", kernel_stat(41), "frames", 0, "unified", "physical-live", "kernel_stat.41", if eq(kernel_stat(41), 0) then "empty" else "live", "kernel", "shared-memory frames this process holds open"),
                fgo-int("kernel", "gift-bytes", "gift bytes mapped", kernel_stat(42), "bytes", 0, "unified", "physical-live", "kernel_stat.42", if eq(kernel_stat(42), 0) then "empty" else "live", "kernel", "bytes of shared memory mapped by this process"),
                fgo-int("kernel", "fns", "functions defined", kernel_stat(43), "fns", 0, "cpu-arena", "physical-live", "kernel_stat.43", "live", "kernel", "defns in this process symbol map")),
                append(fgl-kernels-rows-with(pids, lives), append(fgl-jit-rows(), append(fgl-kernel-box-rows(kernel_box_rows(4)), fgl-kernel-hot-rows(kernel_hot_rows(8))))));
        }
        // the accelerator's PerformanceStatistics dictionary, read once on this host (2026-09-06): Device / Renderer / Tiler
        // Utilization %, Alloc system memory, In use system memory (driver), Allocated PB Size, TiledSceneBytes, SplitSceneCount,
        // recoveryCount, lastRecoveryTime -- three gauges consumed on read and memory sizes; no cumulative busy time stands there.
        // So when the gauge answers 0 while another reader of it stands (Activity Monitor), the level is contended, not idle.
        def fgl-gpu-gauge-contended?(level, readers) = if not(eq(level, 0)) then 0 else if eq(len(readers), 0) then 0 else 1;
        def fgl-gpu-reader-pid(readers) = if eq(len(readers), 0) then 0 else nth(head(readers), 0);
        def fgl-gpu-contended-note(readers) = fgd-cat(list("another reader consumes the gauge: Activity Monitor pid ", int_to_str(fgl-gpu-reader-pid(readers)), "; the accelerator hands Device Utilization % to whoever asks first, about once a second, and PerformanceStatistics carries no cumulative busy counter to read instead"));
        def fgl-gpu-level-live-row-at(level, readers) = if lt(level, 0) then fgo-unavailable("machine", "gpu-utilization", "host GPU device utilization", "percent", "unified-gpu", "IOAccelerator.PerformanceStatistics", "metal", "the accelerator door is absent in this build or on this host") else if eq(fgl-gpu-gauge-contended?(level, readers), 1) then fgo-sized("machine", "gpu-utilization", "host GPU device utilization", 0, "percent", 100, 0, "unified-gpu", "contended", "IOAccelerator.PerformanceStatistics.Device Utilization %", "contended", "metal", fgl-gpu-contended-note(readers)) else fgo-sized("machine", "gpu-utilization", "host GPU device utilization", level, "percent", 100, level, "unified-gpu", "physical-live", "IOAccelerator.PerformanceStatistics.Device Utilization %", if eq(level, 0) then "idle" else "live", "metal", "whole-host GPU level read by the sensor process, the host one accelerator reader");
        def fgl-gpu-level-live-row(level) = fgl-gpu-level-live-row-at(level, list());
        def fgl-gpu-busy-live-row-at(busy, contended) = fgo-int("machine", "gpu-busy-us", "host GPU busy time", busy, "microseconds", 0, "unified-gpu", if eq(contended, 1) then "contended" else "derived-window", "IOAccelerator.Device Utilization %.integrated", if eq(contended, 1) then "contended" else if eq(busy, 0) then "idle" else "live", "metal", if eq(contended, 1) then "the integral stands still while another reader consumes the gauge; the G lane renders contended, not 0" else "the accelerator level integrated by the sensor process over its own clock gaps, every process on the host; the G gauge is its per-frame delta");
        def fgl-gpu-reader-row(readers) = if eq(len(readers), 0) then fgo-int("machine", "gpu-gauge-reader", "other accelerator gauge reader", 0, "pid", 0, "unified-gpu", "physical-live", "libproc.host_processes.Activity Monitor", "none", "metal", "no Activity Monitor process stands; the sensor is the host's one reader of Device Utilization %") else fgo-int("machine", "gpu-gauge-reader", "other accelerator gauge reader", fgl-gpu-reader-pid(readers), "pid", 0, "unified-gpu", "physical-live", "libproc.host_processes.Activity Monitor", "contended", "metal", "Activity Monitor reads the same PerformanceStatistics dictionary; each of its reads consumes the level the sensor would have read");
        // the machine frame: given by the sensor process every 50 ms -- the host GPU level and its integral (the sensor is the host's one accelerator reader), host CPU busy time over every core, and the sensor's own kernel counters; readers = host_processes "Activity Monitor", refreshed by the sensor every 2 s
        def fgl-machine-rows-at(readers) {
            let level = host_gpu_utilization();
            let contended = fgl-gpu-gauge-contended?(level, readers);
            list(
                fgl-gpu-level-live-row-at(level, readers),
                fgl-gpu-busy-live-row-at(host_gpu_busy_us(), contended),
                fgl-gpu-reader-row(readers),
                fgo-int("machine", "cpu-busy-us", "host CPU busy time, all cores", host_cpu_busy_us(), "microseconds", 0, "cpu", "physical-live", "mach.host_statistics.HOST_CPU_LOAD_INFO", "live", "kernel", "user+system+nice ticks of every core since boot; the C gauge is its per-frame delta"),
                fgo-int("kernel", "jit-heat-calls", "heat-lane calls (sensor process)", kernel_stat(44), "calls", 0, "cpu-arena", "physical-live", "kernel_stat.44 sensor", "live", "jit", "the sensor process own heat-lane calls; the J gauge sums every process that gives a frame"));
        }
        def fgl-machine-rows() = fgl-machine-rows-at(list());
        // the glass's own GPU busy estimate: Metal command-buffer time recorded by every process that gives a frame (this glass, the owner's
        // Metal queue) -- no accelerator gauge, nobody else consumes it; the second lane beside a gauge another reader may hold
        def fgl-gpu-busy-row-id?(id) = if str_eq(id, "gpu-busy") then 1 else if str_eq(id, "gpu.owner.busy-us-total") then 1 else if str_eq(id, "jit.owner.metal-busy-us-total") then 1 else 0;
        def fgl-gpu-estimate-sum(rows, sum) = if eq(len(rows), 0) then sum else fgl-gpu-estimate-sum(tail(rows), if and(eq(fgl-gpu-busy-row-id?(fgo-id(head(rows))), 1), and(eq(fgo-present?(head(rows)), 1), str_eq(fgo-value-kind(head(rows)), "int"))) then add(sum, fgo-int-value(head(rows))) else sum);
        def fgl-gpu-estimate-row(rows, ownBusyUs) = fgo-int("machine", "gpu-busy-estimate-us", "GPU busy estimate, Metal timing of every frame-giving process", add(ownBusyUs, fgl-gpu-estimate-sum(rows, 0)), "microseconds", 0, "unified-gpu", "derived-window", "metal_live.gpu-busy-us summed over frames", if eq(add(ownBusyUs, fgl-gpu-estimate-sum(rows, 0)), 0) then "idle" else "live", "metal", "command-buffer GPU time measured by the processes themselves; uncontended, but only the processes that give frames are counted");
        // the frame cache: the inventory read-state per publisher keyed by gift seq or file mtime, and the observations held between their every-fourth-frame refresh
        def fgl-cache(snapshots, observations) = list(snapshots, observations, list(), list());
        def fgl-cache-with-samples(snapshots, observations, samples) = list(snapshots, observations, samples, list());
        def fgl-cache-full(snapshots, observations, samples, roster) = list(snapshots, observations, samples, roster);
        // the loop's cache also carries the kept frame handles (ggf-kept-*), one per (publisher, mode) for the loop's life
        def fgl-cache-full-kept(snapshots, observations, samples, roster, kept) = list(snapshots, observations, samples, roster, kept);
        def fgl-cache-kept(c) = if ge(len(c), 5) then nth(c, 4) else list();
        def fgl-cache-roster(c) = if ge(len(c), 4) then nth(c, 3) else list();
        def fgl-cache-samples(c) = if ge(len(c), 3) then nth(c, 2) else list();
        def fgl-cache-empty() = fgl-cache(list(), list());
        def fgl-cache-snapshots(c) = nth(c, 0);
        def fgl-cache-observations(c) = nth(c, 1);
        def fgl-loop(controlState, frame, heldFast, heldHost, heldQueue, heldStorage, heldHeat, history, frameBuffer, schedule, surface, dependencyIdentity, stringBaseline, nodeBaseline, priorWorkMs, priorWaitMs, priorBudgetMs, cache) {
            let epoch = now_unix_ms();
            let liveSurface = fgl-surface-at(surface, epoch);
            let roster = if or(eq(len(fgl-cache-roster(cache)), 0), eq(fgl-cycle?(frame, 10), 1)) then fgtm-inventory-roster(FGLRoot()) else fgl-cache-roster(cache);
            let kept = fgl-kept-for(fgl-cache-kept(cache), roster, frame);
            let inventoryPair = fgtm-inventory-cached-held(FGLRoot(), roster, fgl-cache-snapshots(cache), kept);
            let inventory = nth(inventoryPair, 0);
            let inventoryMoved = if ge(len(inventoryPair), 2) then fgtm-inventory-moved(inventoryPair, fgl-cache-snapshots(cache)) else 1;
            // decoded only when the next let will read it: an unmoved inventory with cached samples takes the cache below
            let inventorySamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(cache)), 0)) then list() else fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let jitSamples = fgl-jit-current-samples-held(fgl-kept-take(kept, fgtm-space(FGLRoot(), FGLJitPublisher())));
            let externalSamples = if and(eq(inventoryMoved, 0), gt(len(fgl-cache-samples(cache)), 0)) then fgl-cache-samples(cache) else fgl-dedupe-samples(append(jitSamples, inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostHeld = fgl-sensor-take-held(kept, "host", heldHost);
            let hostRows = append(fgsr-rows-or-absent("machine", fgl-sensor-take-held(kept, "machine", list())), fgsr-rows-or-absent("host", hostHeld));
            let ownerHeld = fgl-sensor-take-held(kept, "owner", heldFast);
            let ownerRows = fgsr-rows-or-absent("owner", ownerHeld);
            let queueHeld = fgl-sensor-take-held(kept, "queue", heldQueue);
            let queueRows = fgsr-rows-or-absent("queue", queueHeld);
            let storageHeld = fgl-sensor-take-held(kept, "storage", heldStorage);
            let storageRows = fgsr-rows-or-absent("storage", storageHeld);
            let earHeld = fgl-sensor-take-held(kept, "ear", list());
            let earRows = fgsr-rows-or-absent("ear", earHeld);
            let heatRows = fgl-heat-rows-at(frame, heldHeat, epoch);
            let localRows = append(fgo-observe-rows(fgl-frame-fast-rows(frame, priorWorkMs, priorWaitMs, priorBudgetMs, fgl-fast-rows(frame, heldFast, list())), epoch, frame), append(heatRows, fgo-observe-rows(cons(fgl-gpu-estimate-row(append(ownerRows, hostRows), fgo-metal-word(metal_live(), 11)), fgl-kernel-rows()), epoch, frame)));
            let gaveGlass = fgsr-give-held(fgl-kept-give(kept, fgsr-publisher("glass")), "glass", epoch, localRows);
            let fastRows = append(fgsr-rows-or-absent("glass", fgl-sensor-take-held(kept, "glass", list())), ownerRows);
            let baseMetricsObserved = fgl-ear-first(earRows, append(fgo-observe-rows(list(fgl-string-growth-row(stringBaseline), fgl-node-growth-row(nodeBaseline)), epoch, frame), append(fastRows, append(hostRows, append(queueRows, storageRows)))));
            let governorRefresh = fgl-refresh-governor(frame);
            let metricsObserved = append(baseMetricsObserved, fgl-model-route-rows(samples, epoch, frame));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let index = fgd-metric-index(metrics);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = if or(eq(len(fgl-cache-observations(cache)), 0), eq(fgl-cycle?(frame, 4), 1)) then fgl-v2-observations(epoch, frame, samples) else fgl-cache-observations(cache);
            let nextCache = fgl-cache-full-kept(nth(inventoryPair, 1), observations, externalSamples, roster, kept);
            let point = fgl-flow-point-current-full-in(epoch, metrics, observations, samples, index);
            let poke = fgl-poke-owner-status(samples, epoch);
            let saved = fgl-last-give-held(fgl-kept-give(kept, fgl-last-name("flow-point")), point);
            let hz = fgl-refresh-hz(samples, history, point);
            let nextHistory = ftc-ring-push(history, point, FGLHistoryCapacity());
            let remoteControl = fgl-poll-control-full-held(controlState, samples, epoch, fgl-kept-take(kept, fgl-wait-inbox-name()));
            let control = fgl-input-poll(fgl-input-with(remoteControl, fgl-input-state(controlState)), samples, epoch);
            let nextFrame = fgl-dashboard-frame(nth(liveSurface, 0), nth(liveSurface, 1), epoch, hz, frame, control, metrics, samples, publishers, nextHistory, observations);
            let jitFault = fgl-jit-fault-sample(jitSamples, list());
            if eq(fgl-control-quit?(control), 1) then fgl-loop-stopped(kept, frame, fglu-supervisor-mark("abstain"), len(nextHistory)) else if eq(fgl-dependency-changed?(dependencyIdentity, frame), 1) then fgl-loop-stopped(kept, frame, fglu-supervisor-mark("selfmolt"), len(nextHistory)) else if eq(fgl-pool-selfmolt?(stringBaseline, nodeBaseline, frame), 1) then fgl-loop-stopped(kept, frame, fglu-supervisor-mark("selfmolt"), len(nextHistory)) else if gt(len(jitFault), 0) then fgl-jit-hold-enter(control, add(frame, 1), fastRows, hostRows, queueRows, storageRows, heatRows, nextHistory, frameBuffer, fgl-schedule-for-hz(schedule, epoch, hz), liveSurface, dependencyIdentity, stringBaseline, nodeBaseline, nextFrame, jitFault, nextCache) else fgl-loop-after(control, add(frame, 1), fastRows, hostRows, queueRows, storageRows, heatRows, nextHistory, frameBuffer, schedule, liveSurface, nextFrame, hz, dependencyIdentity, stringBaseline, nodeBaseline, epoch, nextCache);
        }
        def fgl-loop-after(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, schedule, surface, nextFrame, hz, dependencyIdentity, stringBaseline, nodeBaseline, frameStarted, cache) {
            let workEnded = now_unix_ms();
            let workMs = fgl-frame-elapsed-ms(frameStarted, workEnded);
            let activeSchedule = fgl-schedule-for-hz(schedule, frameStarted, hz);
            let budgetMs = fgel-schedule-budget(activeSchedule);
            let waitTargetMs = fgl-schedule-wait-ms(activeSchedule, workEnded);
            let watchNames = fgl-wait-frame-names(fgl-cache-roster(cache));
            let handles = ggf-kept-handles(fgl-cache-kept(cache), watchNames, "take");
            let rested = fgl-wait-rest(waitTargetMs, handles);
            let waitEnded = now_unix_ms();
            let waitMs = fgl-frame-elapsed-ms(workEnded, waitEnded);
            let cadenceSaved = fgl-cadence-last-save-held(fgl-cache-kept(cache), workMs, waitMs, budgetMs);
            let wake = fgl-wait-wake(rested, watchNames, handles, waitEnded, activeSchedule);
            let plan = fgel-plan-wake(activeSchedule, frameBuffer, wake, nextFrame);
            let nextBuffer = fgl-present-plan(frameBuffer, plan);
            fgl-loop(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, nextBuffer, fgel-plan-schedule(plan), surface, dependencyIdentity, stringBaseline, nodeBaseline, workMs, waitMs, budgetMs, cache);
        }
        def fgl-jit-hold-enter(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, schedule, surface, dependencyIdentity, stringBaseline, nodeBaseline, faultFrame, fault, cache) {
            let plan = fgel-plan-wake(schedule, frameBuffer, fgl-jit-fault-wake(fault), faultFrame);
            let shownBuffer = fgl-present-plan(frameBuffer, plan);
            fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, shownBuffer, plan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        // During a refusal Glass reads only the exact JIT publisher and its
        // control inbox. It does not collect host, storage, model inventory,
        // or render ordinary frames. The 250 ms wait remains explicitly the
        // wall-clock compatibility seam until the monotonic event door exists.
        def fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) {
            let epoch = now_unix_ms();
            let jitSamples = fgl-jit-current-samples();
            let healed = fgl-jit-healed-for(jitSamples, fault);
            let remoteControl = fgl-poll-control-full(controlState, jitSamples, epoch);
            let control = fgl-input-poll(fgl-input-with(remoteControl, fgl-input-state(controlState)), jitSamples, epoch);
            if eq(fgl-control-quit?(control), 1) then fgl-loop-stopped(fgl-cache-kept(cache), frame, fglu-supervisor-mark("abstain"), len(history)) else if gt(len(healed), 0) then fgl-jit-hold-resume(control, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed, cache) else fgl-jit-hold-wait(control, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        def fgl-jit-hold-wait(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) {
            let waited = fgl-sleep-ms(250);
            fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache);
        }
        def fgl-jit-hold-resume(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed, cache) {
            let resumed = fgel-resume-held(heldPlan, fgl-jit-healed-wake(healed));
            if not(str_eq(fgel-plan-disposition(resumed), "present")) then fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, cache) else fgl-loop(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, fgel-plan-schedule(resumed), surface, dependencyIdentity, stringBaseline, nodeBaseline, 0, 0, fgel-schedule-budget(fgel-plan-schedule(resumed)), cache);
        }
        def fgl-live() {
            let inputOpened = fgki-open();
            let retired = fgl-retire-self-publisher();
            let state = fglu-supervisor-mark("running");
            let stringBaseline = kernel_stat(5);
            let nodeBaseline = kernel_stat(4);
            let epoch = now_unix_ms();
            let surface = fgl-surface(epoch);
            fgl-loop(fgl-control-start-state(fgtm-read-control-ack(FGLRoot(), FGLControlChannel())), 0, list(), list(), list(), list(), list(), list(), fgel-buffer-empty(), fgel-schedule-start(epoch, fgl-frame-budget-ms(FGLQuietHz())), surface, fglu-dependency-manifest(), stringBaseline, nodeBaseline, -1, -1, -1, fgl-cache-empty());
        }

        def fgl-control-argument(text) = if is-blank?(text) then fgtm-absent() else fgtm-present(trim(text));
        def fgl-control-matching-ack(read, offer) {
            if or(lt(len(read), 4), not(str_eq(nth(read, 2), "ack"))) then list() else if not(eq(fgtm-field-present?(nth(read, 3)), 1)) then list() else fgl-control-matching-ack-value(fgtm-field-value(nth(read, 3)), offer);
        }
        def fgl-control-matching-ack-value(ack, offer) {
            if not(eq(fgtm-ack-valid?(ack), 1)) then list() else if not(str_eq(fgtm-ack-offer-id(ack), fgtm-offer-id(offer))) then list() else if not(str_eq(fgtm-ack-evidence(ack), "physical-live")) then list() else if not(str_eq(fgtm-ack-source(ack), "glass.monitor")) then list() else if lt(fgtm-ack-epoch(ack), fgtm-offer-epoch(offer)) then list() else ack;
        }
        def fgl-control-await(offer, attempts) {
            let read = fgtm-read-control-ack(FGLRoot(), FGLControlChannel());
            let ack = fgl-control-matching-ack(read, offer);
            if gt(len(ack), 0) then list("glass-control-result-v1", fgtm-ack-disposition(ack), offer, ack) else if le(attempts, 0) then list("glass-control-result-v1", "timeout", "missing-door=glass.monitor.control-ack", offer, read) else fgl-control-await-after-wait(offer, attempts);
        }
        def fgl-control-await-after-wait(offer, attempts) {
            let waited = fgl-sleep-ms(250);
            fgl-control-await(offer, sub(attempts, 1));
        }
        def fgl-control-offer-and-await(offer) {
            let wrote = fgtm-offer-control(FGLRoot(), offer);
            if and(ge(len(wrote), 2), str_eq(nth(wrote, 1), "offered")) then fgl-control-await(offer, 8) else list("glass-control-result-v1", "not-offered", "missing-door=glass.monitor.control-inbox", offer, wrote);
        }
        def fgl-control-key-view(key) = if str_eq(key, "h") then "help" else if str_eq(key, "s") then "meaning" else if str_eq(key, "k") then "kernel" else if str_eq(key, "v") then "events" else if str_eq(key, "n") then "channels" else if str_eq(key, "a") then "atlas" else if str_eq(key, "t") then "raster" else if str_eq(key, "o") then "overview" else if str_eq(key, "m") then "memory" else if str_eq(key, "f") then "flow" else if str_eq(key, "j") then "recipes" else if str_eq(key, "d") then "choice" else "";
        def fgl-control-key-lang(key) = if str_eq(key, "1") then "go" else if str_eq(key, "2") then "py" else if str_eq(key, "3") then "rs" else if str_eq(key, "4") then "ts" else if str_eq(key, "0") then "none" else "";
        // r is the room: the ear's own domain, held as a focus and not a view, because the ear gives
        // metric rows and not telemetry samples — fgl-control-selector-valid? lets that focus stand.
        def fgl-control-key-domain(key) = if str_eq(key, "r") then FGLEarDomain() else "";
        def fgl-control-key-action(key) = if gt(str_len(fgl-control-key-lang(key)), 0) then "focus" else if gt(str_len(fgl-control-key-view(key)), 0) then "focus" else if gt(str_len(fgl-control-key-domain(key)), 0) then "focus" else if str_eq(key, "i") then "inspect" else if str_eq(key, "e") then "request-evidence" else if str_eq(key, "c") then "continue" else if str_eq(key, "q") then "abstain" else if str_eq(key, "g") then "step" else if str_eq(key, "y") then "take" else if str_eq(key, "w") then "hold" else key;
        def fgl-control-key-needs-argument?(key, action) = if gt(str_len(fgl-control-key-lang(key)), 0) then 0 else if gt(str_len(fgl-control-key-view(key)), 0) then 0 else if gt(str_len(fgl-control-key-domain(key)), 0) then 0 else if str_eq(action, "continue") then 0 else if str_eq(action, "abstain") then 0 else if eq(fgl-choice-walk?(action), 1) then 0 else 1;
        def fgl-control-key-argument(key, entered) = if gt(str_len(fgl-control-key-lang(key)), 0) then fgl-control-key-lang(key) else if gt(str_len(fgl-control-key-view(key)), 0) then fgl-control-key-view(key) else if gt(str_len(fgl-control-key-domain(key)), 0) then fgl-control-key-domain(key) else entered;
        def fgl-control-interactive() {
            let p0 = say-line("FORM GLASS CONTROL channel=glass-monitor");
            let p1 = say-line("key h help | a atlas | t raster | o overview | m memory | f flow | j recipes | s meaning | k kernel | v events | n channels | d choice | r room | 1-4 dialect | 0 none | i inspect | e evidence | c reset | g step | y take | w hold | q abstain; or full action:");
            let actionRaw = read_line();
            let key = if nothing?(actionRaw) then "" else trim(actionRaw);
            let action = fgl-control-key-action(key);
            let needsArgument = fgl-control-key-needs-argument?(key, action);
            let p2 = if eq(needsArgument, 1) then say-line("argument view|channel|cell|metric id:") else 0;
            let argumentRaw = if eq(needsArgument, 1) then read_line() else "";
            let argumentEntered = if nothing?(argumentRaw) then "" else argumentRaw;
            let argument = fgl-control-key-argument(key, argumentEntered);
            let epoch = now_unix_ms();
            let offer = fgtm-control-offer(FGLControlChannel(), str_concat("offer.", int_to_str(epoch)), epoch, action, fgl-control-argument(argument), "declared", "terminal.operator");
            fgl-control-offer-and-await(offer);
        }
    }
    0;
}
