        def fgl-kernel-hot-row(cell) = len(cell) < 5 ? list() : fgo-int("kernel", "hot." ++ cell[1], fgd-cat(list(cell[1], " ", fgl-unit-leaf(cell[2]), ":", int_to_str(cell[3]), " box ", int_to_str(fgl-hot-cell-boxes(cell)), " unbox ", int_to_str(fgl-hot-cell-unboxes(cell)), fgl-hot-cell-native(cell))), cell[0], "calls", cell[0], "cpu-arena", "physical-live", "kernel_hot_rows", "live", "jit", fgd-cat(list(cell[2], ":", int_to_str(cell[3]), ":", int_to_str(cell[4]), " heat-lane calls; box = float pool slots this defn minted, unbox = float slots it read")));
