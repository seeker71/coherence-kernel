        def fgl-inspection-observations(epoch, samples) = fgl-v2-observations-with(fgl-inspection-provenance(epoch), samples);
        def fgl-inspection-rows(sensors, epoch) = (Comparable) len(sensors) == 0 ? list() : append(fgsr-rows-or-absent-at(head(sensors), fgsr-take(head(sensors), list()), epoch), fgl-inspection-rows(tail(sensors), epoch));
        def fgl-inspection-snapshot() {
