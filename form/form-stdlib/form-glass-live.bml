//////////////////////////////////////////////////////////////////////
//
// form-glass-live.bml — self-updating Form glass and control adapter.
// Its dependency identity is sampled in-process; source movement returns
// `selfmolt` to the foreground carrier instead of leaving an old display alive.
//
// Authority: form-stdlib/bml/form-glass-live.bml
// preludes: observe/say.fk form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-observer.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/form-glass-event-loop.bml form/form-stdlib/native-model-route-readiness.bml form/form-stdlib/native-model-tensor-ledger.bml form/form-stdlib/native-model-dual-telemetry.bml form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/form-glass-live-ui.bml form/form-stdlib/hearth.bml form/form-stdlib/form-glass-launch.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassLiveAuthority {
        field FGLAuthorityPath = "form/form-stdlib/bml/form-glass-live.bml";
        field FGLAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassLive {
        field FGLSchema = "form-glass-live-v2";
        def FGLRoot() = hearth-telemetry-root();
        field FGLPublisher = "glass.monitor";
        field FGLControlChannel = "glass-monitor";
        field FGLFreshLeaseMs = 5000;
        field FGLOwnerRefreshMs = 15000;
        field FGLFlowLastName = "glass.monitor.flow-last";
        field FGLControlFreshMs = 30000;
        field FGLHistoryCapacity = 128;
        field FGLActiveHz = 4;
        field FGLQuietHz = 2;
        field FGLStringMoltGrowth = 262144;
        field FGLNodeMoltGrowth = 262144;
        field FGLQwenRouteId = "model.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLThreeBRouteId = "model.llama-3.2-3b-instruct";
        field FGLQwenWeightId = "weights.qwen3.8-flash-next.ud-q2_k_xl.unsloth";
        field FGLThreeBWeightId = "weights.llama-3.2-3b-instruct";
        field FGLJitPublisher = "jit.bml-demand";
        field FGLJitHealedId = "jit.bml-demand.healed";
        ref fgl-authority = FormGlassLiveAuthority;
        thought fgl-law = list("owner-publishes", "one-persistent-process", "poll-dimensions", "observed-frame-ring", "four-transient-attention-two-quiet", "front-back-frame-buffer", "event-wait-door-named", "row-diff", "cursor-visible", "correlate-controls", "input-seam-visible", "observer-tax-visible");

        def fgl-dependency-changed?(held, frame) = if not(eq(fgl-cycle?(frame, 4), 1)) then 0 else if str_eq(held, fglu-dependency-manifest()) then 0 else 1;

        def fgl-current-reading-samples(reading) {
            let field = fgtm-read-state-value(reading);
            if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else if not(eq(fgtm-field-present?(field), 1)) then list() else fgtm-snapshot-samples(fgtm-field-value(field));
        }
        def fgl-jit-current-samples-at(root) = fgl-current-reading-samples(fgtm-read-current(root, FGLJitPublisher()));
        def fgl-jit-current-samples() = fgl-jit-current-samples-at(FGLRoot());
        def fgl-sample-stale?(sample) = if str_eq(fgtm-sample-source(sample), "glass.stale-snapshot") then 1 else if str_eq(fgtm-sample-source(sample), "glass.projection-stale") then 1 else fgd-has-channel(fgtm-sample-channels(sample), "snapshot-stale");
        def fgl-honest-sample(sample) = sample;
        def fgl-honest-samples(samples) = if eq(len(samples), 0) then list() else cons(fgl-honest-sample(head(samples)), fgl-honest-samples(tail(samples)));
        def fgl-stale-sample(sample) = fgtm-sample(fgtm-sample-id(sample), fgtm-sample-parent(sample), fgtm-sample-kind(sample), fgtm-sample-plane(sample), fgtm-sample-owner(sample), fgtm-sample-lane(sample), fgtm-sample-purpose(sample), fgtm-sample-bytes(sample), fgtm-sample-capacity(sample), fgtm-sample-lifecycle(sample), fgtm-sample-read-epoch(sample), fgtm-sample-write-epoch(sample), fgtm-sample-heat(sample), fgtm-sample-handle(sample), fgtm-sample-evictability(sample), if str_eq(fgtm-sample-evidence(sample), "physical-live") then "derived-window" else fgtm-sample-evidence(sample), fgtm-sample-source(sample), if eq(fgd-has-channel(fgtm-sample-channels(sample), "snapshot-stale"), 1) then fgtm-sample-channels(sample) else append(fgtm-sample-channels(sample), list("snapshot-stale")));
        def fgl-stale-samples(samples) = if eq(len(samples), 0) then list() else cons(fgl-stale-sample(head(samples)), fgl-stale-samples(tail(samples)));
        def fgl-snapshot-fresh?(snapshot, epoch) = if ge(fgtm-snapshot-epoch(snapshot), epoch) then 1 else if le(sub(epoch, fgtm-snapshot-epoch(snapshot)), FGLFreshLeaseMs()) then 1 else 0;
        def fgl-current-reading-samples-at(reading, epoch) {
            let field = fgtm-read-state-value(reading);
            if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else if not(eq(fgtm-field-present?(field), 1)) then list() else if or(eq(fgl-snapshot-fresh?(fgtm-field-value(field), epoch), 1), eq(fgl-incarnated-dual-publisher?(nth(reading, 1)), 1)) then fgl-honest-samples(fgtm-snapshot-samples(fgtm-field-value(field))) else fgl-stale-samples(fgl-honest-samples(fgtm-snapshot-samples(fgtm-field-value(field))));
        }
        def fgl-reading-samples-at(readings, epoch) = if eq(len(readings), 0) then list() else append(fgl-current-reading-samples-at(head(readings), epoch), fgl-reading-samples-at(tail(readings), epoch));
        def fgl-sample-id-held?(held, id) = if eq(len(held), 0) then 0 else if str_eq(fgtm-sample-id(head(held)), id) then 1 else fgl-sample-id-held?(tail(held), id);
        def fgl-dedupe-samples-go(samples, held) = if eq(len(samples), 0) then held else if eq(fgl-sample-id-held?(held, fgtm-sample-id(head(samples))), 1) then fgl-dedupe-samples-go(tail(samples), held) else fgl-dedupe-samples-go(tail(samples), append(held, list(head(samples))));
        def fgl-dedupe-samples(samples) = fgl-dedupe-samples-go(samples, list());
        def fgl-sample-entry(snapshotEpoch, publisher, sample) = list("glass-sample-entry-v2", snapshotEpoch, publisher, sample);
        def fgl-entry-epoch(entry) = nth(entry, 1);
        def fgl-entry-publisher(entry) = nth(entry, 2);
        def fgl-entry-sample(entry) = nth(entry, 3);
        def fgl-wrap-sample-entries(snapshotEpoch, publisher, samples) = if eq(len(samples), 0) then list() else cons(fgl-sample-entry(snapshotEpoch, publisher, head(samples)), fgl-wrap-sample-entries(snapshotEpoch, publisher, tail(samples)));
        def fgl-reading-sample-entries-at(readings, epoch) = if eq(len(readings), 0) then list() else append(fgl-current-reading-entries-at(head(readings), epoch), fgl-reading-sample-entries-at(tail(readings), epoch));
        def fgl-current-reading-entries-at(reading, epoch) {
            let field = fgtm-read-state-value(reading);
            if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else if not(eq(fgtm-field-present?(field), 1)) then list() else fgl-wrap-sample-entries(fgtm-snapshot-epoch(fgtm-field-value(field)), nth(reading, 1), fgl-current-reading-samples-at(reading, epoch));
        }
        def fgl-same-physical-model?(left, right) = if not(str_eq(fgtm-sample-kind(left), "model")) then 0 else if not(str_eq(fgtm-sample-kind(right), "model")) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-handle(left)), 1)) then 0 else if not(eq(fgtm-field-present?(fgtm-sample-handle(right)), 1)) then 0 else eq(fgtm-field-value(fgtm-sample-handle(left)), fgtm-field-value(fgtm-sample-handle(right)));
        def fgl-same-entry-identity?(left, right) = if not(str_eq(fgl-entry-publisher(left), fgl-entry-publisher(right))) then 0 else if str_eq(fgtm-sample-id(fgl-entry-sample(left)), fgtm-sample-id(fgl-entry-sample(right))) then 1 else fgl-same-physical-model?(fgl-entry-sample(left), fgl-entry-sample(right));
        def fgl-insert-newest-entry(entry, held) = if eq(len(held), 0) then list(entry) else if eq(fgl-same-entry-identity?(entry, head(held)), 1) then if gt(fgl-entry-epoch(entry), fgl-entry-epoch(head(held))) then cons(entry, tail(held)) else held else cons(head(held), fgl-insert-newest-entry(entry, tail(held)));
        def fgl-newest-entries(entries, held) = if eq(len(entries), 0) then held else fgl-newest-entries(tail(entries), fgl-insert-newest-entry(head(entries), held));
        def fgl-entry-samples(entries) = if eq(len(entries), 0) then list() else cons(fgl-entry-sample(head(entries)), fgl-entry-samples(tail(entries)));
        def fgl-newest-samples-by-snapshot(entries) = fgl-entry-samples(fgl-newest-entries(entries, list()));
        def fgl-incarnated-dual-publisher?(publisher) = eq(str_find(publisher, "models.dual-resident.i", 0), 0);
        def fgl-has-incarnated-dual-publisher?(publishers) = if eq(len(publishers), 0) then 0 else if eq(fgl-incarnated-dual-publisher?(head(publishers)), 1) then 1 else fgl-has-incarnated-dual-publisher?(tail(publishers));
        def fgl-current-readings(readings, suppressLegacyDual) = if eq(len(readings), 0) then list() else if and(eq(suppressLegacyDual, 1), str_eq(nth(head(readings), 1), "models.dual-resident")) then fgl-current-readings(tail(readings), suppressLegacyDual) else cons(head(readings), fgl-current-readings(tail(readings), suppressLegacyDual));
        def fgl-inventory-samples-at(inventory, epoch) = if not(str_eq(nth(inventory, 2), "current")) then list() else fgl-newest-samples-by-snapshot(fgl-reading-sample-entries-at(fgl-current-readings(nth(inventory, 4), fgl-has-incarnated-dual-publisher?(nth(inventory, 3))), epoch));
        def fgl-inventory-publishers(inventory) = if not(str_eq(nth(inventory, 2), "current")) then list() else nth(inventory, 3);

        def fgl-owner-liveness-row?(sample) = if and(str_eq(fgtm-sample-kind(sample), "owner-liveness"), and(str_eq(fgtm-sample-lifecycle(sample), "active"), and(str_eq(fgtm-sample-purpose(sample), "os-process-lifetime-current"), str_eq(fgtm-sample-evidence(sample), "physical-live")))) then 1 else if and(str_eq(fgtm-sample-kind(sample), "owner-heartbeat"), eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1)) then 1 else 0;
        def fgl-owner-liveness(samples) = if eq(len(samples), 0) then list() else if eq(fgl-owner-liveness-row?(head(samples)), 1) then head(samples) else fgl-owner-liveness(tail(samples));
        def fgl-owner-process(samples) {
            let owner = fgl-owner-liveness(samples);
            if eq(len(owner), 0) then list() else if not(eq(fgtm-field-present?(fgtm-sample-handle(owner)), 1)) then list() else fgl-owner-process-read(fgtm-field-value(fgtm-sample-handle(owner)));
        }
        def fgl-owner-process-read(pid) {
            let command = fgo-pid-ps-command(int_to_str(pid));
            let processes = if is-blank?(command) then list() else fgo-ps-processes(host-exec(command, ""));
            if eq(len(processes), 1) then head(processes) else list();
        }
        def fgl-owner-nice(pid) {
            let value = trim(host-exec(str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o ni=")), ""));
            if eq(fgo-ps-uint?(value), 1) then str_to_int(value) else -1;
        }
        def fgl-owner-process-rows(samples) {
            let process = fgl-owner-process(samples);
            if eq(len(process), 0) then fgl-owner-absent-rows(samples) else fgl-owner-process-rows-present(process, fgl-owner-nice(fgo-ps-pid(process)));
        }
        def fgl-owner-absent-rows(samples) {
            let owner = fgl-owner-liveness(samples);
            if eq(len(owner), 0) then list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness sample", "empty", "model", "semantic-zero=empty; no owner-liveness publication in the current inventory")) else if not(eq(fgtm-field-present?(fgtm-sample-handle(owner)), 1)) then list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness handle", "empty", "model", "semantic-zero=empty; owner-liveness row has no pid handle")) else list(fgo-int("process", "model-owner-present", "Model owner present", 0, "ready", 0, "process-time", "physical-live", "owner-liveness exact pid/start + /bin/ps", "released", "model", str_concat("owner pid=", str_concat(int_to_str(fgtm-field-value(fgtm-sample-handle(owner))), " is not a live process; last snapshot remains inspectable with age"))));
        }
        def fgl-owner-process-rows-present(process, nice) {
            let pid = fgo-ps-pid(process);
            list(
                fgo-int("process", "model-owner-present", "Model owner present", 1, "ready", 1, "process-time", "physical-live", "owner-liveness exact pid/start + /bin/ps", "live", "model", str_concat("owner pid=", int_to_str(pid))),
                fgo-int("process", "model-owner-rss", "Model owner RSS", fgo-ps-rss-bytes(process), "bytes", fgo-ps-rss-bytes(process), "os-memory", "physical-live", "owner-liveness exact pid/start + /bin/ps", "live", "model", str_concat("Qwen3.8-Flash-Next + Llama-3.2-3B owner pid=", int_to_str(pid))),
                fgo-int("process", "model-owner-cpu", "Model owner CPU", fgo-ps-cpu(process), "tenths-percent", fgo-ps-cpu(process), "cpu-scheduler", "physical-live", "owner-liveness exact pid/start + /bin/ps", if eq(fgo-ps-cpu(process), 0) then "quiet" else "live", "cpu", str_concat("semantic-zero=quiet at 0.1% precision; owner pid=", int_to_str(pid))),
                fgo-int("process", "model-owner-elapsed", "Model owner elapsed", fgo-ps-elapsed(process), "seconds", fgo-ps-elapsed(process), "process-time", "physical-live", "owner-liveness exact pid/start + /bin/ps", "live", "model", str_concat("owner pid=", int_to_str(pid))),
                if ge(nice, 0) then fgo-int("process", "model-owner-nice", "Model owner nice", nice, "nice", nice, "cpu-scheduler", "physical-live", "owner-liveness exact pid/start + /bin/ps -o ni", "live", "cpu", str_concat("cooperative scheduling priority; owner pid=", int_to_str(pid))) else fgo-unavailable("process", "model-owner-nice", "Model owner nice", "nice", "cpu-scheduler", "host.ps.owner-nice", "cpu", str_concat("exact owner pid=", int_to_str(pid))));
        }
        def fgl-owner-metric?(row) = if str_eq(fgo-id(row), "model-owner-present") then 1 else if str_eq(fgo-id(row), "model-owner-rss") then 1 else if str_eq(fgo-id(row), "model-owner-cpu") then 1 else if str_eq(fgo-id(row), "model-owner-elapsed") then 1 else str_eq(fgo-id(row), "model-owner-nice");
        def fgl-held-owner-rows(rows) = if eq(len(rows), 0) then list() else if eq(fgl-owner-metric?(head(rows)), 1) then cons(head(rows), fgl-held-owner-rows(tail(rows))) else fgl-held-owner-rows(tail(rows));
        // Exact owner process observation is useful at least once per second;
        // spawning two ps children at every 250 ms frame displaced the model
        // work Glass exists to reveal. A two-frame cadence is 500 ms at 4 Hz
        // and one second at 2 Hz. Retained rows keep their original observation
        // epoch so their visible age grows between observations.
        def fgl-owner-rows-at(frame, heldFast, samples, epoch) {
            let held = fgl-held-owner-rows(heldFast);
            if or(eq(len(held), 0), eq(fgl-cycle?(frame, 2), 1)) then fgo-observe-rows(fgl-owner-process-rows(samples), epoch, frame) else held;
        }

        def fgl-terminal-number(command, fallback, low, high) {
            let raw = trim(host-exec(command, ""));
            let value = if is-blank?(raw) then fallback else str_to_int(raw);
            if or(lt(value, low), gt(value, high)) then fallback else value;
        }
        def fgl-terminal-width() = fgl-terminal-number("/usr/bin/tput cols", 100, 1, 1000);
        def fgl-terminal-height() = fgl-terminal-number("/usr/bin/tput lines", 30, 1, 300);
        def fgl-surface(epoch) = list(fgl-terminal-width(), fgl-terminal-height(), epoch);
        // Resize awareness is a one-second observation, independent of frame
        // rate. The terminal probes never sit on the 250 ms render path.
        def fgl-surface-at(surface, epoch) = if or(lt(len(surface), 3), ge(sub(epoch, nth(surface, 2)), 1000)) then fgl-surface(epoch) else surface;

        def fgl-cycle?(frame, cadence) = eq(mul(div(frame, cadence), cadence), frame);
        def fgl-observe-fast-rows(heatRows) {
            let events = framebuffer-events();
            append(fgo-kernel-rows(), append(fgo-framebuffer-rows(events), append(fgo-metal-rows(metal_status()), append(fgo-mlx-rows(mlx_status()), append(heatRows, fgo-event-rows(events))))));
        }
        def fgl-fast-rows(frame, held, heatRows) = fgl-observe-fast-rows(heatRows);
        def fgl-observe-host-rows() {
            let memoryRows = fgo-host-rows(host-exec("/usr/bin/memory_pressure -Q", ""));
            let processRows = fgo-live-process-rows();
            append(memoryRows, processRows);
        }
        def fgl-host-last-path() = fs-path-join(FGLRoot(), "glass.monitor.host-last.txt");
        def fgl-host-last-save(pageins) {
            let made = fs-mkdir(FGLRoot());
            fs-write-text(fgl-host-last-path(), fgd-cat(list("glass-host-last-v1", "|", int_to_str(pageins))));
        }
        def fgl-host-last-parse(fields) = if lt(len(fields), 2) then -1 else if not(str_eq(head(fields), "glass-host-last-v1")) then -1 else str_to_int(nth(fields, 1));
        def fgl-host-last-load() {
            let path = fgl-host-last-path();
            if eq(fs-exists?(path), 0) then -1 else fgl-host-last-parse(split-on(fs-read-text(path), "|"));
        }
        def fgl-pageins-delta-row(held, current) {
            let prevHeld = fgl-number-for(held, list("pageins"));
            let prev = if ge(prevHeld, 0) then prevHeld else fgl-host-last-load();
            let cur = fgl-number-for(current, list("pageins"));
            let delta = if or(lt(prev, 0), lt(cur, 0)) then -1 else if lt(cur, prev) then 0 else sub(cur, prev);
            let saved = if ge(cur, 0) then fgl-host-last-save(cur) else 0;
            if lt(delta, 0) then fgo-unavailable("host", "pageins-delta", "Mach pageins since last host sample", "pages", "os-memory", "glass.monitor.host-last.pageins", "health", "no prior pageins sample to subtract") else fgo-int("host", "pageins-delta", "Mach pageins since last host sample", delta, "pages", delta, "os-memory", "physical-live", "vm_stat.Pageins-delta", if eq(delta, 0) then "quiet" else "live", "health", "rising during a token stall is disk-backed page-in, not idle");
        }
        def fgl-observe-host-rows-with-delta(held) {
            let current = fgl-observe-host-rows();
            cons(fgl-pageins-delta-row(held, current), current);
        }
        def fgl-host-rows-at(frame, held, epoch) = if or(eq(len(held), 0), eq(fgl-cycle?(frame, 4), 1)) then fgo-observe-rows(fgl-observe-host-rows-with-delta(held), epoch, frame) else held;
        def fgl-host-rows(frame, held) = fgl-host-rows-at(frame, held, 0);
        def fgl-cache-roots() = list("form/form-stdlib", "form/form-stdlib/tests", "form/form-stdlib/bml", "form/native/metal", "form/native/metal/tests", "observe");
        def fgl-source-roots() = list("form/form-stdlib", "form/form-stdlib/bml", "form/native/metal", "observe");
        def fgl-catalog-stats-names(root, names, needle, suffix, count, bytes, newest) = if eq(len(names), 0) then list(count, bytes, newest) else fgl-catalog-stats-name(root, tail(names), needle, suffix, count, bytes, newest, head(names));
        def fgl-catalog-stats-name(root, rest, needle, suffix, count, bytes, newest, name) {
            let matched = if and(ge(str_find(name, needle, 0), 0), eq(fgo-suffix?(name, suffix), 1)) then 1 else 0;
            let path = fgo-join(root, name);
            let size = if eq(matched, 1) then file_size(path) else 0;
            let modified = if eq(matched, 1) then file_mtime(path) else 0;
            fgl-catalog-stats-names(root, rest, needle, suffix, add(count, matched), add(bytes, size), if gt(modified, newest) then modified else newest);
        }
        def fgl-catalog-stats-root(root, needle, suffix) = if not(eq(fs_is_dir(root), 1)) then list(0, 0, 0) else fgl-catalog-stats-names(root, fs_list(root), needle, suffix, 0, 0, 0);
        def fgl-catalog-stats-roots(roots, needle, suffix, held) = if eq(len(roots), 0) then held else fgl-catalog-stats-roots(tail(roots), needle, suffix, fgo-add-stats(held, fgl-catalog-stats-root(head(roots), needle, suffix)));
        def fgl-catalog-source-stats(roots, needle) = fgo-add-stats(fgl-catalog-stats-roots(roots, needle, ".fk", list(0, 0, 0)), fgl-catalog-stats-roots(roots, needle, ".bml", list(0, 0, 0)));
        def fgl-catalog-row(id, label, stats) = fgo-int("storage", id, label, nth(stats, 0), "files", nth(stats, 0), "mapped-file", "catalog", "fs_list+file_size", if eq(nth(stats, 0), 0) then "empty" else "stored", "recipe", if eq(nth(stats, 0), 0) then "semantic-zero=empty; explicit immediate Form roots contain no matching catalog entries; not runtime allocation" else "explicit immediate Form roots; catalog not runtime allocation");
        def fgl-form-catalog-rows() {
            let roots = fgl-cache-roots();
            let recipeSource = fgl-catalog-source-stats(roots, "recipe");
            let recipeImages = fgl-catalog-stats-roots(roots, "recipe", ".fkb", list(0, 0, 0));
            let blueprintSource = fgl-catalog-source-stats(roots, "blueprint");
            let blueprintImages = fgl-catalog-stats-roots(roots, "blueprint", ".fkb", list(0, 0, 0));
            list(fgl-catalog-row("recipe-source-count", "recipe source catalog", recipeSource), fgl-catalog-row("recipe-image-count", "recipe crystallized images", recipeImages), fgl-catalog-row("blueprint-source-count", "blueprint source catalog", blueprintSource), fgl-catalog-row("blueprint-image-count", "blueprint crystallized images", blueprintImages));
        }
        def fgl-storage-rows-at(frame, held, epoch) = if or(eq(len(held), 0), eq(fgl-cycle?(frame, 20), 1)) then fgo-observe-rows(cons(fgo-specialization-row("glass-program-image", "Glass image", "form/form-stdlib/form-glass-live.bml", "form/form-stdlib/form-glass-live.bml.fkb"), append(fgl-form-catalog-rows(), append(fgo-flat-cache-storage(fgl-cache-roots()), fgo-flat-source-storage(fgl-source-roots())))), epoch, frame) else held;
        def fgl-storage-rows(frame, held) = fgl-storage-rows-at(frame, held, 0);
        def fgl-heat-rows-at(frame, held, epoch) = if or(eq(len(held), 0), eq(fgl-cycle?(frame, 4), 1)) then fgo-observe-rows(fgo-primitive-heat(), epoch, frame) else held;
        def fgl-heat-rows(frame, held) = fgl-heat-rows-at(frame, held, 0);

        def fgl-count-substring-go(text, needle, position, count) {
            let found = str_find(text, needle, position);
            if lt(found, 0) then count else fgl-count-substring-go(text, needle, add(found, str_len(needle)), add(count, 1));
        }
