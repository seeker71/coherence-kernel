                fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(identitiesPresent, 1)) then list(
                    fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-artifact-identity-not-published", ownerEpoch, "model.owner.open-artifact-identity", list("process", "model", "memory", "tensor", "health")),
                    fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(identitiesMatch, 1)) then list(
                        fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-artifact-identity-mismatch", ownerEpoch, "model.owner.open-artifact-identity-match", list("process", "model", "memory", "tensor", "health")),
                        fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongProfiles, 1)) then list(
                            fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-not-published", ownerEpoch, "model.owner.open-artifact-content-identity", list("process", "model", "memory", "tensor", "health")),
                            fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongIdentitiesPresent, 1)) then list(
                                fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-not-published", ownerEpoch, "model.owner.open-artifact-content-identity", list("process", "model", "memory", "tensor", "health")),
                                fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else if not(eq(strongIdentitiesMatch, 1)) then list(
                                    fgl-ledger-gap-sample("tensor.owner.artifact-join", "models", owner, "open-time-content-identity-mismatch", ownerEpoch, "model.owner.open-artifact-content-identity-match", list("process", "model", "memory", "tensor", "health")),
                                    fgl-owner-mlx-model-path-sample(owner, ownerEpoch)) else fgl-owner-derived-ledger-profile(externalSamples, owner, ownerEpoch, qprofile, tprofile);
        }
        def fgl-owner-derived-ledger-profile(externalSamples, owner, epoch, qprofile, tprofile) {
            let qscratch = nmtl-sum(nmtl-qwen-scratch-sizes(128));
            let qstateSizes = nmtl-qwen-all-state-sizes(0, 48, 4, 128);
            let qstate = nmtl-sum(qstateSizes);
            let tscratch = nmtl-sum(nmtl-llama-scratch-sizes(3072, 8192, 128256, 24, 128));
            let tcache = mul(nmtl-llama-cache-bytes(1024, 128), 56);
            let profiles = list(qprofile, tprofile);
            let qm = nmtl-layout-profile-mapped-bytes(qprofile);
            let qmh = nmtl-layout-profile-mapped-handles(qprofile);
            let qa = nmtl-layout-profile-allocated-bytes(qprofile);
            let qah = nmtl-layout-profile-allocated-handles(qprofile);
            let tm = nmtl-layout-profile-mapped-bytes(tprofile);
            let tmh = nmtl-layout-profile-mapped-handles(tprofile);
            let ta = nmtl-layout-profile-allocated-bytes(tprofile);
            let tah = nmtl-layout-profile-allocated-handles(tprofile);
            let mappedHandles = nmtl-profiles-mapped-handles(profiles);
            let allocatedHandles = nmtl-profiles-allocated-handles(profiles);
            let observedMapped = fgl-owner-counter-number(externalSamples, "mapping.owner.mmap-buffer-handles");
            let observedBuffers = fgl-owner-counter-number(externalSamples, "metal.owner.buffers");
            let mappedEpoch = if le(nmtl-layout-profile-witnessed(qprofile), nmtl-layout-profile-witnessed(tprofile)) then nmtl-layout-profile-witnessed(qprofile) else nmtl-layout-profile-witnessed(tprofile);
            list(
                fgl-ledger-sample("tensor.qwen38.mapped", FGLQwenRouteId(), owner, "mapped-tensors", "disk", "gguf-record-mapped-extents", qm, qmh, "mapped", nmtl-layout-profile-witnessed(qprofile), "derived-window", "native-model-mapped-layout-run", list("model", "memory", "tensor", "metal", "gpu", "layer")),
                fgl-ledger-sample("tensor.qwen38.scratch", FGLQwenRouteId(), owner, "allocated-tensors", "unified", "reusable-scratch-buffer-extents", qscratch, 49, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "scratch")),
                fgl-ledger-sample("tensor.qwen38.state", FGLQwenRouteId(), owner, "allocated-state", "unified", "recurrent-and-kv-buffer-extents", qstate, len(qstateSizes), "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "substate", "layer")),
                fgl-ledger-sample("tensor.qwen38.allocated", FGLQwenRouteId(), owner, "model-allocation", "unified", "reusable-scratch-and-state", qa, qah, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.llama32-3b.mapped", FGLThreeBRouteId(), owner, "mapped-tensors", "disk", "gguf-record-mapped-extents", tm, tmh, "mapped", nmtl-layout-profile-witnessed(tprofile), "derived-window", "native-model-mapped-layout-run", list("model", "memory", "tensor", "metal", "gpu", "layer")),
                fgl-ledger-sample("tensor.llama32-3b.scratch", FGLThreeBRouteId(), owner, "allocated-tensors", "unified", "reusable-scratch-buffer-extents", tscratch, 17, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "scratch")),
                fgl-ledger-sample("tensor.llama32-3b.kv", FGLThreeBRouteId(), owner, "allocated-state", "unified", "kv-cache-buffer-extents", tcache, 56, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "substate", "layer")),
                fgl-ledger-sample("tensor.llama32-3b.allocated", FGLThreeBRouteId(), owner, "model-allocation", "unified", "reusable-scratch-and-kv", ta, tah, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.mapped", "models", owner, "tensor-ledger", "disk", "gguf-record-mapped-extents", nmtl-profiles-mapped-bytes(profiles), mappedHandles, "mapped", mappedEpoch, "derived-window", "native-model-mapped-layout-run", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.allocated", "models", owner, "tensor-ledger", "unified", "reusable-scratch-state-kv-extents", nmtl-profiles-allocated-bytes(profiles), allocatedHandles, "resident", epoch, "derived-window", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-sample("tensor.owner.ledger", "models", owner, "tensor-ledger", "unified", "all-buffer-handle-count", -1, add(mappedHandles, allocatedHandles), "resident", epoch, "derived-window", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-reconciliation-sample("tensor.owner.mapped-reconciliation", "tensor.owner.mapped", owner, "disk", mappedHandles, observedMapped, epoch, "metal_status.mmap_nocopy_buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-ledger-reconciliation-sample("tensor.owner.buffer-reconciliation", "tensor.owner.ledger", owner, "unified", add(mappedHandles, allocatedHandles), observedBuffers, epoch, "owner.snapshot.metal_status.buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                fgl-owner-mlx-model-path-sample(owner, epoch));
        }
        def fgl-projection-sample?(sample) = if str_eq(fgtm-sample-source(sample), "glass.projection") then 1 else if str_eq(fgtm-sample-source(sample), "glass.projection-stale") then 1 else 0;
        def fgl-external-sample?(sample) = if str_eq(fgtm-sample-id(sample), "process.form-glass") then 0 else if str_eq(fgtm-sample-owner(sample), FGLPublisher()) then 0 else if eq(fgl-projection-sample?(sample), 1) then 0 else 1;
        def fgl-external-samples(samples) = if eq(len(samples), 0) then list() else if eq(fgl-external-sample?(head(samples)), 1) then cons(head(samples), fgl-external-samples(tail(samples))) else fgl-external-samples(tail(samples));
        def fgl-external-publishers(publishers) = if eq(len(publishers), 0) then list() else if str_eq(head(publishers), FGLPublisher()) then fgl-external-publishers(tail(publishers)) else cons(head(publishers), fgl-external-publishers(tail(publishers)));
        def fgl-local-samples(externalSamples, epoch) = cons(fgl-monitor-sample(epoch), append(fgl-owner-derived-ledger-samples(externalSamples, epoch), externalSamples));
        def fgl-route-metric-id(fact) = str_concat("route.", nmrr-fact-id(fact));
        def fgl-route-row(fact, label) = if eq(nmrr-fact-present?(fact), 1) then fgo-sized("model", fgl-route-metric-id(fact), label, nmrr-fact-value(fact), "ready", 1, mul(nmrr-fact-value(fact), 1000), "metal", nmrr-fact-evidence(fact), "native-model.route-readiness", if eq(nmrr-fact-value(fact), 1) then "ready" else "idle", "query-lane", nmrr-fact-reason(fact)) else fgo-unavailable("model", fgl-route-metric-id(fact), label, "ready", "metal", nmrr-fact-missing-door(fact), "query-lane", nmrr-fact-reason(fact));
        def fgl-route-row-at(fact, label, sequence) = if eq(nmrr-fact-present?(fact), 1) then fgo-observe-row(fgl-route-row(fact, label), nmrr-fact-observed(fact), sequence) else fgo-observe-row(fgl-route-row(fact, label), -1, sequence);
        def fgl-model-route-rows(samples, epoch, sequence) {
            let qwen = nmrr-model-route-from-current-samples(samples, epoch, FGLQwenRouteId());
            let threeb = nmrr-model-route-from-current-samples(samples, epoch, FGLThreeBRouteId());
            let parallel = nmrr-parallel-route(qwen, threeb, epoch);
            list(fgl-route-row-at(qwen, "Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth) route", sequence), fgl-route-row-at(threeb, "Llama-3.2-3B-Instruct route", sequence), fgl-route-row-at(parallel, "Qwen + 3B parallel availability", sequence));
        }
        def fgl-retire-self-publisher() {
            let finalRemoved = fs-remove-file(fgtm-snapshot-path(FGLRoot(), FGLPublisher()));
            let candidateRemoved = fs-remove-file(fgtm-snapshot-candidate-path(FGLRoot(), FGLPublisher()));
            list("glass-self-publisher-retired", finalRemoved, candidateRemoved);
        }

        def fgl-control-state-full(focus, lastOffer, quit, status, view, filter, selected, evidenceOpen) = list("glass-live-control-state-v2", focus, lastOffer, quit, status, view, filter, selected, evidenceOpen);
        def fgl-control-state(focus, lastOffer, quit, status) = fgl-control-state-full(focus, lastOffer, quit, status, "atlas", "all", "none", 0);
        def fgl-control-focus(state) = nth(state, 1);
        def fgl-control-last-offer(state) = nth(state, 2);
        def fgl-control-quit?(state) = nth(state, 3);
        def fgl-control-status(state) = nth(state, 4);
        def fgl-control-view(state) = nth(state, 5);
        def fgl-control-filter(state) = nth(state, 6);
        def fgl-control-selected(state) = nth(state, 7);
        def fgl-control-evidence-open?(state) = nth(state, 8);
        def fgl-control-supported?(action) = if str_eq(action, "focus") then 1 else if str_eq(action, "inspect") then 1 else if str_eq(action, "continue") then 1 else if str_eq(action, "request-evidence") then 1 else if str_eq(action, "abstain") then 1 else 0;
        def fgl-control-selector-valid?(samples, argument) = if not(eq(fgtm-field-present?(argument), 1)) then 0 else if eq(fgd-view?(fgtm-field-value(argument)), 1) then 1 else if gt(fgd-count-visible(samples, fgtm-field-value(argument)), 0) then 1 else 0;
        def fgl-control-offer-applicable?(samples, offer) {
            let action = fgtm-offer-action(offer);
            if not(eq(fgl-control-supported?(action), 1)) then 0 else if str_eq(action, "focus") then fgl-control-selector-valid?(samples, fgtm-offer-argument(offer)) else if str_eq(action, "inspect") then fgtm-field-present?(fgtm-offer-argument(offer)) else 1;
        }
        def fgl-control-applied-state(focus, offer, samples) {
            let action = fgtm-offer-action(offer);
            let argument = fgtm-offer-argument(offer);
            let applicable = fgl-control-offer-applicable?(samples, offer);
            let nextFocus = if not(eq(applicable, 1)) then focus else if str_eq(action, "continue") then "all" else if str_eq(action, "focus") then fgtm-field-value(argument) else if str_eq(action, "request-evidence") then "health" else focus;
            let quit = if and(eq(applicable, 1), str_eq(action, "abstain")) then 1 else 0;
            fgl-control-state(nextFocus, fgtm-offer-id(offer), quit, if eq(applicable, 1) then action else "refused");
        }
        def fgl-control-write-acknowledged?(writeResult) = if lt(len(writeResult), 2) then 0 else if str_eq(nth(writeResult, 1), "acknowledged") then 1 else 0;
        def fgl-control-ack-epoch(offeredEpoch, observedEpoch) = fgd-max(offeredEpoch, observedEpoch);
        def fgl-control-commit(previous, proposed, writeResult) = if eq(fgl-control-write-acknowledged?(writeResult), 1) then proposed else fgl-control-state(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "ack-failed");

        def fgl-control-proposed(previous, offer, samples) {
            let action = fgtm-offer-action(offer);
            let argument = fgtm-offer-argument(offer);
            let applicable = fgl-control-offer-applicable?(samples, offer);
            let argumentText = if eq(fgtm-field-present?(argument), 1) then fgtm-field-value(argument) else "none";
            let isView = if eq(fgtm-field-present?(argument), 1) then fgd-view?(argumentText) else 0;
            let nextView = if not(eq(applicable, 1)) then fgl-control-view(previous) else if and(str_eq(action, "focus"), eq(isView, 1)) then argumentText else if str_eq(action, "continue") then "overview" else fgl-control-view(previous);
            let nextFocus = if not(eq(applicable, 1)) then fgl-control-focus(previous) else if str_eq(action, "continue") then "all" else if and(str_eq(action, "focus"), eq(isView, 0)) then argumentText else fgl-control-focus(previous);
            let nextFilter = if str_eq(action, "continue") then "all" else if and(str_eq(action, "focus"), eq(isView, 0)) then argumentText else fgl-control-filter(previous);
            let nextSelected = if and(eq(applicable, 1), str_eq(action, "inspect")) then argumentText else if and(eq(applicable, 1), str_eq(action, "request-evidence")) then if eq(fgtm-field-present?(argument), 1) then argumentText else fgl-control-selected(previous) else fgl-control-selected(previous);
            let evidenceOpen = if and(eq(applicable, 1), str_eq(action, "request-evidence")) then 1 else if and(eq(applicable, 1), str_eq(action, "inspect")) then 0 else fgl-control-evidence-open?(previous);
            let quit = if and(eq(applicable, 1), str_eq(action, "abstain")) then 1 else 0;
            fgl-control-state-full(nextFocus, fgtm-offer-id(offer), quit, if eq(applicable, 1) then action else "refused", nextView, nextFilter, nextSelected, evidenceOpen);
        }
        def fgl-control-commit-full(previous, proposed, writeResult) = if eq(fgl-control-write-acknowledged?(writeResult), 1) then proposed else fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "ack-failed", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous));
        def fgl-control-apply-full(previous, offer, samples, epoch) {
            let proposed = fgl-control-proposed(previous, offer, samples);
            let disposition = if str_eq(fgl-control-status(proposed), "refused") then "refused" else "applied";
            let ackEpoch = fgl-control-ack-epoch(fgtm-offer-epoch(offer), now_unix_ms());
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), ackEpoch, disposition, "physical-live", "glass.monitor");
            fgl-control-commit-full(previous, proposed, fgtm-acknowledge-control(FGLRoot(), ack));
        }
        def fgl-control-stale-full(previous, offer, epoch) {
            let proposed = fgl-control-state-full(fgl-control-focus(previous), fgtm-offer-id(offer), 0, "stale", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous));
            let ackEpoch = fgl-control-ack-epoch(fgtm-offer-epoch(offer), now_unix_ms());
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), ackEpoch, "stale", "physical-live", "glass.monitor");
            fgl-control-commit-full(previous, proposed, fgtm-acknowledge-control(FGLRoot(), ack));
        }
        def fgl-control-from-offer(previous, offer, samples, epoch) = if str_eq(fgtm-offer-id(offer), fgl-control-last-offer(previous)) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "held", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else if eq(fgl-control-offer-fresh?(offer, epoch), 1) then fgl-control-apply-full(previous, offer, samples, epoch) else fgl-control-stale-full(previous, offer, epoch);
        def fgl-control-polled-full(previous, poll, samples, epoch) {
            let field = nth(poll, 3);
            if not(str_eq(nth(poll, 2), "offer")) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, nth(poll, 2), fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else if not(eq(fgtm-field-present?(field), 1)) then fgl-control-state-full(fgl-control-focus(previous), fgl-control-last-offer(previous), 0, "absent", fgl-control-view(previous), fgl-control-filter(previous), fgl-control-selected(previous), fgl-control-evidence-open?(previous)) else fgl-control-from-offer(previous, fgtm-field-value(field), samples, epoch);
        }
        def fgl-poll-control-full(previous, samples, epoch) = fgl-control-polled-full(previous, fgtm-poll-control(FGLRoot(), FGLControlChannel()), samples, epoch);
        def fgl-control-applied(focus, lastOffer, offer, samples) {
            let previous = fgl-control-state(focus, lastOffer, 0, "held");
            let proposed = fgl-control-applied-state(focus, offer, samples);
            let disposition = if str_eq(fgl-control-status(proposed), "refused") then "refused" else "applied";
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), now_unix_ms(), disposition, "physical-live", "glass.monitor");
            let wrote = fgtm-acknowledge-control(FGLRoot(), ack);
            fgl-control-commit(previous, proposed, wrote);
        }
        def fgl-control-offer-fresh?(offer, epoch) = if gt(fgtm-offer-epoch(offer), epoch) then le(sub(fgtm-offer-epoch(offer), epoch), FGLFreshLeaseMs()) else le(sub(epoch, fgtm-offer-epoch(offer)), FGLControlFreshMs());
        def fgl-control-stale-state(focus, offer) = fgl-control-state(focus, fgtm-offer-id(offer), 0, "stale");
        def fgl-control-stale(focus, lastOffer, offer, epoch) {
            let previous = fgl-control-state(focus, lastOffer, 0, "held");
            let proposed = fgl-control-stale-state(focus, offer);
            let ack = fgtm-control-ack(fgtm-offer-channel(offer), fgtm-offer-id(offer), epoch, "stale", "physical-live", "glass.monitor");
            let wrote = fgtm-acknowledge-control(FGLRoot(), ack);
            fgl-control-commit(previous, proposed, wrote);
        }
        def fgl-control-new(focus, lastOffer, offer, samples, epoch) = if str_eq(fgtm-offer-id(offer), lastOffer) then fgl-control-state(focus, lastOffer, 0, "held") else if eq(fgl-control-offer-fresh?(offer, epoch), 1) then fgl-control-applied(focus, lastOffer, offer, samples) else fgl-control-stale(focus, lastOffer, offer, epoch);
        def fgl-control-polled(focus, lastOffer, poll, samples, epoch) {
            let field = nth(poll, 3);
            if not(str_eq(nth(poll, 2), "offer")) then fgl-control-state(focus, lastOffer, 0, nth(poll, 2)) else if not(eq(fgtm-field-present?(field), 1)) then fgl-control-state(focus, lastOffer, 0, "absent") else fgl-control-new(focus, lastOffer, fgtm-field-value(field), samples, epoch);
        }
        def fgl-poll-control(focus, lastOffer, samples, epoch) = fgl-control-polled(focus, lastOffer, fgtm-poll-control(FGLRoot(), FGLControlChannel()), samples, epoch);
        def fgl-control-start-last-offer(ackRead) {
            let field = if lt(len(ackRead), 4) then fgtm-absent() else nth(ackRead, 3);
            if and(str_eq(if lt(len(ackRead), 3) then "malformed" else nth(ackRead, 2), "ack"), eq(fgtm-field-present?(field), 1)) then fgtm-ack-offer-id(fgtm-field-value(field)) else "none";
        }
        def fgl-control-start-state(ackRead) = fgl-control-state("all", fgl-control-start-last-offer(ackRead), 0, "absent");

        // Loaded/prefilled model state, owner heartbeats, caches, mappings and
        // monotonic counters describe readiness, not attention.  Only a live
        // request or the owner's transient `model-state/active` row raises the
        // monitor from 2 Hz to 4 Hz; the completed flow then remains visible
        // without making observation compete permanently with inference.
        def fgl-attention-active-sample?(sample) = if not(str_eq(fgtm-sample-lifecycle(sample), "active")) then 0 else if not(str_eq(fgtm-sample-evidence(sample), "physical-live")) then 0 else if str_eq(fgtm-sample-kind(sample), "request") then 1 else if str_eq(fgtm-sample-kind(sample), "model-state") then str_eq(fgtm-sample-purpose(sample), "active") else 0;
        def fgl-any-active?(samples) = if eq(len(samples), 0) then 0 else if eq(fgl-attention-active-sample?(head(samples)), 1) then 1 else fgl-any-active?(tail(samples));
        def fgl-frame-budget-ms(hz) = if le(hz, 0) then div(1000, FGLQuietHz()) else div(1000, hz);
        def fgl-frame-elapsed-ms(started, finished) = if ge(finished, started) then sub(finished, started) else 0;
        def fgl-frame-wait-ms(hz, started, finished) = fgd-max(0, sub(fgl-frame-budget-ms(hz), fgl-frame-elapsed-ms(started, finished)));
        def fgl-millisecond-digits(value) = if lt(value, 10) then str_concat("00", int_to_str(value)) else if lt(value, 100) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fgl-sleep-ms-command(milliseconds) = str_concat("/bin/sleep ", str_concat(int_to_str(div(milliseconds, 1000)), str_concat(".", fgl-millisecond-digits(mod(milliseconds, 1000)))));
        def fgl-sleep-ms(milliseconds) = if le(milliseconds, 0) then "deadline-reached" else host-exec(fgl-sleep-ms-command(milliseconds), "");
        def fgl-sleep-hz(hz) = fgl-sleep-ms(fgl-frame-budget-ms(hz));
        def fgl-sleep(samples) = if eq(fgl-any-active?(samples), 1) then fgl-sleep-hz(FGLActiveHz()) else fgl-sleep-hz(FGLQuietHz());
        def fgl-cadence-unavailable-row(id, label) = fgo-unavailable("glass", id, label, "milliseconds", "cpu-scheduler", str_concat("glass.deadline.completed-predecessor.", id), "glass", "first frame has no completed predecessor");
        def fgl-cadence-live-row(id, label, value, budget, note) = fgo-sized("glass", id, label, value, "milliseconds", budget, value, "cpu-scheduler", "physical-live", "now_unix_ms+deadline remainder", "live", "glass", note);
        def fgl-cadence-last-path() = fs-path-join(FGLRoot(), "glass.monitor.cadence-last.txt");
        def fgl-cadence-last-save(workMs, waitMs, budgetMs) {
            let made = fs-mkdir(FGLRoot());
            fs-write-text(fgl-cadence-last-path(), fgd-cat(list("glass-cadence-last-v1", "|", int_to_str(workMs), "|", int_to_str(waitMs), "|", int_to_str(budgetMs))));
        }
        def fgl-cadence-last-parse(fields) = if lt(len(fields), 4) then list() else if not(str_eq(head(fields), "glass-cadence-last-v1")) then list() else list(str_to_int(nth(fields, 1)), str_to_int(nth(fields, 2)), str_to_int(nth(fields, 3)));
        def fgl-cadence-last-load() {
            let path = fgl-cadence-last-path();
            if eq(fs-exists?(path), 0) then list() else fgl-cadence-last-parse(split-on(fs-read-text(path), "|"));
        }
        def fgl-cadence-measured-rows(workMs, waitMs, budgetMs) = list(fgl-cadence-live-row("frame-work-ms", "previous frame observation work", workMs, budgetMs, "all collection render and control work before wait"), fgl-cadence-live-row("frame-wait-ms", "previous frame deadline wait", waitMs, budgetMs, "actual host wait; measured zero means the frame exceeded its target"), fgl-cadence-live-row("frame-budget-ms", "previous frame target", budgetMs, budgetMs, "250ms active or moving; 500ms quiet"), fgl-cadence-live-row("frame-cycle-ms", "previous frame work plus wait", add(workMs, waitMs), budgetMs, "physical completed-frame cadence excluding recursive call overhead"));
        def fgl-cadence-persisted-rows() {
            let last = fgl-cadence-last-load();
            if eq(len(last), 0) then list() else fgl-cadence-measured-rows(nth(last, 0), nth(last, 1), nth(last, 2));
        }
        def fgl-cadence-rows(frame, workMs, waitMs, budgetMs) = if or(lt(workMs, 0), or(lt(waitMs, 0), lt(budgetMs, 0))) then list() else fgl-cadence-measured-rows(workMs, waitMs, budgetMs);
        def fgl-frame-fast-rows(frame, workMs, waitMs, budgetMs, changingRows) = append(fgl-cadence-rows(frame, workMs, waitMs, budgetMs), changingRows);
        def fgl-projection(width, height, epoch, focus, metrics, samples, publishers, status) {
            let frame = fgd-segment-frame(width, height, epoch, focus, metrics, samples, publishers, status);
            ftc-cat(list(ftc-terminal-home(), fgd-segment-project(frame), ftc-terminal-erase-rest()));
        }
        def fgl-render-new(projection) {
            let shown = say(projection);
            projection;
        }
        def fgl-render-changed(projection, priorProjection) = if str_eq(projection, priorProjection) then projection else fgl-render-new(projection);

        def fgl-frame-same-size?(previous, nextFrame) = if or(eq(len(previous), 0), eq(len(nextFrame), 0)) then 0 else if not(eq(fgd-segment-frame-width(previous), fgd-segment-frame-width(nextFrame))) then 0 else if not(eq(fgd-segment-frame-height(previous), fgd-segment-frame-height(nextFrame))) then 0 else 1;
        def fgl-frame-patch(previous, nextFrame) = if eq(fgl-frame-same-size?(previous, nextFrame), 0) then ftc-cat(list(ftc-terminal-home(), fgd-segment-project(nextFrame), ftc-terminal-erase-rest())) else ftc-segment-lines-diff(fgd-segment-frame-lines(previous), fgd-segment-frame-lines(nextFrame));
        def fgl-render-frame(previous, nextFrame) {
            let patch = if eq(fgl-frame-same-size?(previous, nextFrame), 0) then ftcb-full-frame(fgd-segment-frame-lines(nextFrame)) else ftcb-segment-lines-diff(fgd-segment-frame-lines(previous), fgd-segment-frame-lines(nextFrame));
            ftcb-write-stdout(patch);
        }
        def fgl-render-buffer(buffer, nextFrame) {
            let staged = fgel-buffer-stage(buffer, nextFrame);
            let shown = fgl-render-frame(fgel-buffer-front(staged), fgel-buffer-back(staged));
            if lt(shown, 0) then buffer else fgel-buffer-commit(staged);
        }
        def fgl-present-plan(buffer, plan) {
            let planned = fgel-plan-buffer(plan);
            let shown = fgl-render-frame(fgel-buffer-front(buffer), fgel-buffer-front(planned));
            fgl-render-commit(shown, buffer, planned);
        }
        def fgl-render-commit(writeResult, prior, planned) = if lt(writeResult, 0) then prior else planned;
        def fgl-schedule-for-hz(schedule, epoch, hz) {
            let budget = fgl-frame-budget-ms(hz);
            if not(eq(fgel-schedule-valid?(schedule), 1)) then fgel-schedule-start(epoch, budget) else if not(eq(fgel-schedule-budget(schedule), budget)) then fgel-schedule-start(epoch, budget) else schedule;
        }
        def fgl-schedule-wait-ms(schedule, epoch) = if ge(epoch, fgel-schedule-deadline(schedule)) then 0 else sub(fgel-schedule-deadline(schedule), epoch);
        def fgl-dashboard-frame(width, height, epoch, hz, frame, control, metrics, samples, publishers, history, observations) = fgd-live-segment-frame(width, height, epoch, hz, frame, fgl-control-view(control), fgl-control-focus(control), fgl-control-filter(control), fgl-control-selected(control), fgl-control-evidence-open?(control), metrics, samples, publishers, fgl-control-status(control), history, observations, fgl-carrier-seam());

        // One bounded physical frame is the inspection door for agents and
        // receipts.  It shares every collector and renderer with the resident
        // loop, but fixes the requested view instead of relying on terminal
        // control state held by another process.
        // The same bounded frame with the focus handed in: a receipt about one
        // lane (a channel tag such as `mesh`) reads that lane and nothing else.
        def fgl-bounded-current-frame-focus(view, focus, width, height) {
            let epoch0 = now_unix_ms();
            let inventory0 = fgtm-inventory(FGLRoot());
            let samples0 = fgl-external-samples(fgl-inventory-samples-at(inventory0, epoch0));
            let poke = fgl-poke-owner-status(samples0, epoch0);
            let waited = if eq(poke, 1) then host-exec("/bin/sleep 0.35", "") else "held";
            let epoch = now_unix_ms();
            let frameNumber = 0;
            let inventory = fgtm-inventory(FGLRoot());
            let inventorySamples = fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let externalSamples = fgl-dedupe-samples(append(fgl-jit-current-samples(), inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostRows = fgl-host-rows-at(frameNumber, list(), epoch);
            let ownerRows = fgo-observe-rows(fgl-owner-process-rows(samples), epoch, frameNumber);
            let queueRows = fgl-queue-rows-at(frameNumber, list(), epoch);
            let storageRows = fgl-storage-rows-at(frameNumber, list(), epoch);
            let heatRows = fgl-heat-rows-at(frameNumber, list(), epoch);
            let lastCadence = fgl-cadence-last-load();
            let cadenceRows = if eq(len(lastCadence), 0) then list() else fgl-cadence-measured-rows(nth(lastCadence, 0), nth(lastCadence, 1), nth(lastCadence, 2));
            let fastRows = append(fgo-observe-rows(append(cadenceRows, fgl-fast-rows(frameNumber, list(), list())), epoch, frameNumber), heatRows);
            let growthRows = fgo-observe-rows(list(fgl-string-growth-row(kernel_stat(5)), fgl-node-growth-row(kernel_stat(4))), epoch, frameNumber);
            let metricsObserved = append(append(fastRows, append(ownerRows, append(hostRows, append(queueRows, append(storageRows, growthRows))))), fgl-model-route-rows(samples, epoch, frameNumber));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let governorRefresh = fgl-refresh-governor(frameNumber);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = fgl-v2-observations(epoch, frameNumber, samples);
            let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
            let history = fgl-flow-history-with-last(point);
            let control = fgl-control-state-full(focus, "bounded-current", 0, "held", view, "all", "all", 0);
            fgl-dashboard-frame(width, height, epoch, FGLQuietHz(), frameNumber, control, metrics, samples, publishers, history, observations);
        }
        def fgl-bounded-current-frame(view, width, height) {
            let epoch0 = now_unix_ms();
            let inventory0 = fgtm-inventory(FGLRoot());
            let samples0 = fgl-external-samples(fgl-inventory-samples-at(inventory0, epoch0));
            let poke = fgl-poke-owner-status(samples0, epoch0);
            let waited = if eq(poke, 1) then host-exec("/bin/sleep 0.35", "") else "held";
            let epoch = now_unix_ms();
            let frameNumber = 0;
            let inventory = fgtm-inventory(FGLRoot());
            let inventorySamples = fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let externalSamples = fgl-dedupe-samples(append(fgl-jit-current-samples(), inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostRows = fgl-host-rows-at(frameNumber, list(), epoch);
            let ownerRows = fgo-observe-rows(fgl-owner-process-rows(samples), epoch, frameNumber);
            let queueRows = fgl-queue-rows-at(frameNumber, list(), epoch);
            let storageRows = fgl-storage-rows-at(frameNumber, list(), epoch);
            let heatRows = fgl-heat-rows-at(frameNumber, list(), epoch);
            let lastCadence = fgl-cadence-last-load();
            let cadenceRows = if eq(len(lastCadence), 0) then list() else fgl-cadence-measured-rows(nth(lastCadence, 0), nth(lastCadence, 1), nth(lastCadence, 2));
            let fastRows = append(fgo-observe-rows(append(cadenceRows, fgl-fast-rows(frameNumber, list(), list())), epoch, frameNumber), heatRows);
            let growthRows = fgo-observe-rows(list(fgl-string-growth-row(kernel_stat(5)), fgl-node-growth-row(kernel_stat(4))), epoch, frameNumber);
            let metricsObserved = append(append(fastRows, append(ownerRows, append(hostRows, append(queueRows, append(storageRows, growthRows))))), fgl-model-route-rows(samples, epoch, frameNumber));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let governorRefresh = fgl-refresh-governor(frameNumber);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = fgl-v2-observations(epoch, frameNumber, samples);
            let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
            let history = fgl-flow-history-with-last(point);
            let control = fgl-control-state-full("all", "bounded-current", 0, "held", view, "all", "all", 0);
            fgl-dashboard-frame(width, height, epoch, FGLQuietHz(), frameNumber, control, metrics, samples, publishers, history, observations);
        }

        def fgl-loop(controlState, frame, heldFast, heldHost, heldQueue, heldStorage, heldHeat, history, frameBuffer, schedule, surface, dependencyIdentity, stringBaseline, nodeBaseline, priorWorkMs, priorWaitMs, priorBudgetMs) {
            let epoch = now_unix_ms();
            let liveSurface = fgl-surface-at(surface, epoch);
            let inventory = fgtm-inventory(FGLRoot());
            let inventorySamples = fgl-external-samples(fgl-inventory-samples-at(inventory, epoch));
            let externalSamples = fgl-dedupe-samples(append(fgl-jit-current-samples(), inventorySamples));
            let samples = fgl-local-samples(externalSamples, epoch);
            let hostRows = fgl-host-rows-at(frame, heldHost, epoch);
            let ownerRows = fgl-owner-rows-at(frame, heldFast, samples, epoch);
            let queueRows = fgl-queue-rows-at(frame, heldQueue, epoch);
            let storageRows = fgl-storage-rows-at(frame, heldStorage, epoch);
            let heatRows = fgl-heat-rows-at(frame, heldHeat, epoch);
            let fastRows = append(fgo-observe-rows(fgl-frame-fast-rows(frame, priorWorkMs, priorWaitMs, priorBudgetMs, fgl-fast-rows(frame, heldFast, list())), epoch, frame), append(heatRows, ownerRows));
            let baseMetricsObserved = append(fgo-observe-rows(list(fgl-string-growth-row(stringBaseline), fgl-node-growth-row(nodeBaseline)), epoch, frame), append(fastRows, append(hostRows, append(queueRows, storageRows))));
            let governorRefresh = fgl-refresh-governor(frame);
            let metricsObserved = append(baseMetricsObserved, fgl-model-route-rows(samples, epoch, frame));
            let metrics = fgo-age-rows-at(metricsObserved, epoch);
            let publishers = fgl-external-publishers(fgl-inventory-publishers(inventory));
            let observations = fgl-v2-observations(epoch, frame, samples);
            let point = fgl-flow-point-current-full(epoch, metrics, observations, samples);
            let poke = fgl-poke-owner-status(samples, epoch);
            let saved = fgl-flow-last-save(point);
            let hz = fgl-refresh-hz(samples, history, point);
            let nextHistory = ftc-ring-push(history, point, FGLHistoryCapacity());
            let control = fgl-poll-control-full(controlState, samples, epoch);
            let nextFrame = fgl-dashboard-frame(nth(liveSurface, 0), nth(liveSurface, 1), epoch, hz, frame, control, metrics, samples, publishers, nextHistory, observations);
            let jitFault = fgl-jit-fault-sample(fgl-jit-current-samples(), list());
            if eq(fgl-control-quit?(control), 1) then list("form-glass-live-stopped", frame, fglu-supervisor-mark("abstain"), len(nextHistory)) else if eq(fgl-dependency-changed?(dependencyIdentity, frame), 1) then list("form-glass-live-stopped", frame, fglu-supervisor-mark("selfmolt"), len(nextHistory)) else if eq(fgl-pool-selfmolt?(stringBaseline, nodeBaseline, frame), 1) then list("form-glass-live-stopped", frame, fglu-supervisor-mark("selfmolt"), len(nextHistory)) else if gt(len(jitFault), 0) then fgl-jit-hold-enter(control, add(frame, 1), fastRows, hostRows, queueRows, storageRows, heatRows, nextHistory, frameBuffer, fgl-schedule-for-hz(schedule, epoch, hz), liveSurface, dependencyIdentity, stringBaseline, nodeBaseline, nextFrame, jitFault) else fgl-loop-after(control, add(frame, 1), fastRows, hostRows, queueRows, storageRows, heatRows, nextHistory, frameBuffer, schedule, liveSurface, nextFrame, hz, dependencyIdentity, stringBaseline, nodeBaseline, epoch);
        }
        def fgl-loop-after(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, schedule, surface, nextFrame, hz, dependencyIdentity, stringBaseline, nodeBaseline, frameStarted) {
            let workEnded = now_unix_ms();
            let workMs = fgl-frame-elapsed-ms(frameStarted, workEnded);
            let activeSchedule = fgl-schedule-for-hz(schedule, frameStarted, hz);
            let budgetMs = fgel-schedule-budget(activeSchedule);
            let waitTargetMs = fgl-schedule-wait-ms(activeSchedule, workEnded);
            let slept = fgl-sleep-ms(waitTargetMs);
            let waitEnded = now_unix_ms();
            let waitMs = fgl-frame-elapsed-ms(workEnded, waitEnded);
            let cadenceSaved = fgl-cadence-last-save(workMs, waitMs, budgetMs);
            let wake = fgel-wake("deadline", waitEnded, "wall-clock-compatibility", str_concat("deadline.", int_to_str(fgel-schedule-deadline(activeSchedule))));
            let plan = fgel-plan-wake(activeSchedule, frameBuffer, wake, nextFrame);
            let nextBuffer = fgl-present-plan(frameBuffer, plan);
            fgl-loop(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, nextBuffer, fgel-plan-schedule(plan), surface, dependencyIdentity, stringBaseline, nodeBaseline, workMs, waitMs, budgetMs);
        }
        def fgl-jit-hold-enter(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, schedule, surface, dependencyIdentity, stringBaseline, nodeBaseline, faultFrame, fault) {
            let plan = fgel-plan-wake(schedule, frameBuffer, fgl-jit-fault-wake(fault), faultFrame);
            let shownBuffer = fgl-present-plan(frameBuffer, plan);
            fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, shownBuffer, plan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault);
        }
        // During a refusal Glass reads only the exact JIT publisher and its
        // control inbox. It does not collect host, storage, model inventory,
        // or render ordinary frames. The 250 ms wait remains explicitly the
        // wall-clock compatibility seam until the monotonic event door exists.
        def fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault) {
            let epoch = now_unix_ms();
            let jitSamples = fgl-jit-current-samples();
            let healed = fgl-jit-healed-for(jitSamples, fault);
            let control = fgl-poll-control-full(controlState, jitSamples, epoch);
            if eq(fgl-control-quit?(control), 1) then list("form-glass-live-stopped", frame, fglu-supervisor-mark("abstain"), len(history)) else if gt(len(healed), 0) then fgl-jit-hold-resume(control, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed) else fgl-jit-hold-wait(control, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault);
        }
        def fgl-jit-hold-wait(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault) {
            let waited = fgl-sleep-ms(250);
            fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault);
        }
        def fgl-jit-hold-resume(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault, healed) {
            let resumed = fgel-resume-held(heldPlan, fgl-jit-healed-wake(healed));
            if not(str_eq(fgel-plan-disposition(resumed), "present")) then fgl-jit-hold(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, heldPlan, surface, dependencyIdentity, stringBaseline, nodeBaseline, fault) else fgl-loop(controlState, frame, fastRows, hostRows, queueRows, storageRows, heatRows, history, frameBuffer, fgel-plan-schedule(resumed), surface, dependencyIdentity, stringBaseline, nodeBaseline, 0, 0, fgel-schedule-budget(fgel-plan-schedule(resumed)));
        }
        def fgl-live() {
            let opened = ftcb-write-stdout(ftcb-terminal-safe-open());
            let retired = fgl-retire-self-publisher();
            let state = fglu-supervisor-mark("running");
            let stringBaseline = kernel_stat(5);
            let nodeBaseline = kernel_stat(4);
            let epoch = now_unix_ms();
            let surface = fgl-surface(epoch);
            fgl-loop(fgl-control-start-state(fgtm-read-control-ack(FGLRoot(), FGLControlChannel())), 0, list(), list(), list(), list(), list(), list(), fgel-buffer-empty(), fgel-schedule-start(epoch, fgl-frame-budget-ms(FGLQuietHz())), surface, fglu-dependency-manifest(), stringBaseline, nodeBaseline, -1, -1, -1);
        }

        def fgl-control-argument(text) = if is-blank?(text) then fgtm-absent() else fgtm-present(trim(text));
        def fgl-control-matching-ack(read, offer) {
            if or(lt(len(read), 4), not(str_eq(nth(read, 2), "ack"))) then list() else if not(eq(fgtm-field-present?(nth(read, 3)), 1)) then list() else fgl-control-matching-ack-value(fgtm-field-value(nth(read, 3)), offer);
        }
        def fgl-control-matching-ack-value(ack, offer) {
            if not(eq(fgtm-ack-valid?(ack), 1)) then list() else if not(str_eq(fgtm-ack-offer-id(ack), fgtm-offer-id(offer))) then list() else if not(str_eq(fgtm-ack-evidence(ack), "physical-live")) then list() else if not(str_eq(fgtm-ack-source(ack), "glass.monitor")) then list() else if lt(fgtm-ack-epoch(ack), fgtm-offer-epoch(offer)) then list() else ack;
        }
        def fgl-control-await(offer, attempts) {
            let read = fgtm-read-control-ack(FGLRoot(), FGLControlChannel());
            let ack = fgl-control-matching-ack(read, offer);
            if gt(len(ack), 0) then list("glass-control-result-v1", fgtm-ack-disposition(ack), offer, ack) else if le(attempts, 0) then list("glass-control-result-v1", "timeout", "missing-door=glass.monitor.control-ack", offer, read) else fgl-control-await-after-wait(offer, attempts);
        }
        def fgl-control-await-after-wait(offer, attempts) {
            let waited = fgl-sleep-ms(250);
            fgl-control-await(offer, sub(attempts, 1));
        }
        def fgl-control-offer-and-await(offer) {
            let wrote = fgtm-offer-control(FGLRoot(), offer);
            if and(ge(len(wrote), 2), str_eq(nth(wrote, 1), "offered")) then fgl-control-await(offer, 8) else list("glass-control-result-v1", "not-offered", "missing-door=glass.monitor.control-inbox", offer, wrote);
        }
        def fgl-control-key-view(key) = if str_eq(key, "h") then "help" else if str_eq(key, "a") then "atlas" else if str_eq(key, "t") then "raster" else if str_eq(key, "o") then "overview" else if str_eq(key, "m") then "memory" else if str_eq(key, "f") then "flow" else if str_eq(key, "j") then "recipes" else "";
        def fgl-control-key-action(key) = if gt(str_len(fgl-control-key-view(key)), 0) then "focus" else if str_eq(key, "i") then "inspect" else if str_eq(key, "e") then "request-evidence" else if str_eq(key, "c") then "continue" else if str_eq(key, "q") then "abstain" else key;
        def fgl-control-key-needs-argument?(key, action) = if gt(str_len(fgl-control-key-view(key)), 0) then 0 else if str_eq(action, "continue") then 0 else if str_eq(action, "abstain") then 0 else 1;
        def fgl-control-key-argument(key, entered) = if gt(str_len(fgl-control-key-view(key)), 0) then fgl-control-key-view(key) else entered;
        def fgl-control-interactive() {
            let p0 = say-line("FORM GLASS CONTROL channel=glass-monitor");
            let p1 = say-line("key h help | a atlas | t raster | o overview | m memory | f flow | j recipes | i inspect | e evidence | c continue | q abstain; or full action:");
            let actionRaw = read_line();
            let key = if nothing?(actionRaw) then "" else trim(actionRaw);
            let action = fgl-control-key-action(key);
            let needsArgument = fgl-control-key-needs-argument?(key, action);
            let p2 = if eq(needsArgument, 1) then say-line("argument view|channel|cell|metric id:") else 0;
            let argumentRaw = if eq(needsArgument, 1) then read_line() else "";
            let argumentEntered = if nothing?(argumentRaw) then "" else argumentRaw;
            let argument = fgl-control-key-argument(key, argumentEntered);
            let epoch = now_unix_ms();
            let offer = fgtm-control-offer(FGLControlChannel(), str_concat("offer.", int_to_str(epoch)), epoch, action, fgl-control-argument(argument), "declared", "terminal.operator");
            fgl-control-offer-and-await(offer);
        }
    }
    0;
}
