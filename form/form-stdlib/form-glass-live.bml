        def fgl-kernel-page-rows-named(pidText, source, w) = list(fgl-kernel-page-row(pidText, source, w, "dispatches", "dispatches", 4, "calls", "kernel"), fgl-kernel-page-row(pidText, source, w, "heat", "heat-lane calls", 5, "calls", "jit"), fgl-kernel-page-row(pidText, source, w, "nodes", "nodes", 6, "nodes", "cell"), fgl-kernel-page-row(pidText, source, w, "fns", "fns", 9, "fns", "kernel"), fgl-kernel-page-row(pidText, source, w, "cpu-us", "cpu time", 18, "microseconds", "kernel"), fgl-kernel-page-row(pidText, source, w, "gifts", "gift frames", 10, "frames", "gift"), fgl-kernel-page-row(pidText, source, w, "store-shared", "store in shared memory", 22, "flag", "cell"), fgl-kernel-page-row(pidText, source, w, "melts", "heap melts", 21, "melts", "cell"), fgl-kernel-page-row(pidText, source, w, "mints", "value nodes minted", 33, "nodes", "cell"));
