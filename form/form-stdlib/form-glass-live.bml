        def fgl-dashboard-frame-in(width, height, epoch, hz, frame, control, metrics, samples, publishers, history, observations, index) = fgd-live-segment-frame-in(width, height, epoch, hz, frame, fgl-control-view(control), fgl-control-focus(control), fgl-control-filter(control), fgl-control-selected(control), fgl-control-evidence-open?(control), metrics, samples, publishers, fgl-control-status(control), history, observations, fgl-input-caption(control, metrics), index);

