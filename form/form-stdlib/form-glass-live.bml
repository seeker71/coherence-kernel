        }
        def fgl-input-index(rows, selected, index) = if eq(len(rows), 0) then -1 else if eq(fglui-sample-selected?(head(rows), selected), 1) then index else fgl-input-index(tail(rows), selected, add(index, 1));
        def fgl-input-move(control, samples, direction, epoch) {
            let rows = fgd-take(fglui-view-samples(samples, fgl-control-view(control)), 128);
            let index = fgl-input-index(rows, fgl-control-selected(control), 0);
            let next = if lt(index, 0) then if lt(direction, 0) then sub(len(rows), 1) else 0 else mod(add(add(index, direction), len(rows)), len(rows));
            if eq(len(rows), 0) then control else fgl-input-apply(control, samples, "inspect", fglui-sample-selection-id(nth(rows, next)), epoch);
        }
        def fgl-input-key(control, samples, key, epoch) {
            let action = fgl-control-key-action(key);
            if or(str_eq(key, "i"), str_eq(key, "e")) then
                if str_eq(fgl-control-selected(control), "none") then fgl-input-with(control, fgki-prompt(fgl-input-state(control), action))
                else fgl-input-apply(control, samples, action, fgl-control-selected(control), epoch)
            else if eq(fgl-control-key-needs-argument?(key, action), 0) then fgl-input-apply(control, samples, action, fgl-control-key-argument(key, ""), epoch)
            else control;
        }
        def fgl-input-event(control, samples, result, epoch) {
            let state = fgl-input-with(control, nth(result, 0));
            let kind = nth(result, 1);
            let value = nth(result, 2);
            if str_eq(kind, "key") then fgl-input-key(state, samples, value, epoch)
            else if str_eq(kind, "move") then fgl-input-move(state, samples, value, epoch)
            else if or(str_eq(kind, "inspect"), str_eq(kind, "request-evidence")) then if eq(str_len(value), 0) then state else fgl-input-apply(state, samples, kind, value, epoch)
            else state;
        }
        def fgl-input-feed(control, samples, bytes, at, epoch) = if or(ge(at, str_len(bytes)), eq(fgl-control-quit?(control), 1)) then control else fgl-input-feed(fgl-input-event(control, samples, fgki-byte(fgl-input-state(control), str_byte_at(bytes, at), epoch), epoch), samples, bytes, add(at, 1), epoch);
        def fgl-input-feed-live(control, samples, bytes, at, epoch) = if or(ge(at, str_len(bytes)), eq(fgl-control-quit?(control), 1)) then control else fgl-input-feed-live-next(control, samples, bytes, at, epoch);
        def fgl-input-feed-live-next(control, samples, bytes, at, epoch) {
            let proposed = fgl-input-event(control, samples, fgki-byte(fgl-input-state(control), str_byte_at(bytes, at), epoch), epoch);
            let offer = fgtm-control-offer(FGLControlChannel(), fgl-control-last-offer(proposed), epoch, fgl-control-status(proposed), fgtm-absent(), "physical-live", "terminal.keyboard");
            let next = if str_eq(fgl-control-last-offer(control), fgl-control-last-offer(proposed)) then proposed else fgl-input-with(fgl-choice-effect(control, proposed, offer, samples, epoch), fgl-input-state(proposed));
            fgl-input-feed-live(next, samples, bytes, add(at, 1), epoch);
        }
        def fgl-input-poll(control, samples, epoch) {
            let previous = fgl-input-with(control, fgki-expire(fgl-input-state(control), epoch));
            let bytes = fgki-read();
            let proposed = if nothing?(bytes) then previous else fgl-input-feed-live(previous, samples, bytes, 0, epoch);
            let changed = not(str_eq(fgl-control-last-offer(previous), fgl-control-last-offer(proposed)));
            let ack = if eq(changed, 0) then list("held", "acknowledged") else fgtm-acknowledge-control(FGLRoot(), fgtm-control-ack(FGLControlChannel(), fgl-control-last-offer(proposed), now_unix_ms(), if str_eq(fgl-control-status(proposed), "refused") then "refused" else "applied", "physical-live", "glass.monitor"));
            let committed = fgl-input-with(fgl-control-commit-full(previous, proposed, ack), fgl-input-state(proposed));
            let observed = if eq(fgki-serial(fgl-input-state(control)), fgki-serial(fgl-input-state(committed))) then 0 else fgl-last-give("input-state", list("glass-input-v1", host_pid(), epoch, fgl-control-view(committed), fgl-control-filter(committed), fgl-control-selected(committed), fgl-control-last-offer(committed), fgki-active(), fgki-serial(fgl-input-state(committed))));
            committed;
        }
        def fgl-input-caption(control) = if eq(str_len(fgki-mode(fgl-input-state(control))), 0) then fgl-carrier-seam() else fgtm-cat(list(fgki-mode(fgl-input-state(control)), "> ", fgki-text(fgl-input-state(control)), "_  Enter submit | Esc cancel"));

        // Loaded/prefilled model state, owner heartbeats, caches, mappings and
        // monotonic counters describe readiness, not attention.  Only a live
        // request or the owner's transient `model-state/active` row raises the
        // monitor from 2 Hz to 4 Hz; the completed flow then remains visible
        // without making observation compete permanently with inference.
        def fgl-attention-active-sample?(sample) = if not(str_eq(fgtm-sample-lifecycle(sample), "active")) then 0 else if not(str_eq(fgtm-sample-evidence(sample), "physical-live")) then 0 else if str_eq(fgtm-sample-kind(sample), "request") then 1 else if str_eq(fgtm-sample-kind(sample), "model-state") then str_eq(fgtm-sample-purpose(sample), "active") else 0;
        def fgl-any-active?(samples) = if eq(len(samples), 0) then 0 else if eq(fgl-attention-active-sample?(head(samples)), 1) then 1 else fgl-any-active?(tail(samples));
        def fgl-frame-budget-ms(hz) = if le(hz, 0) then div(1000, FGLQuietHz()) else div(1000, hz);
        def fgl-frame-elapsed-ms(started, finished) = if ge(finished, started) then sub(finished, started) else 0;
        def fgl-frame-wait-ms(hz, started, finished) = fgd-max(0, sub(fgl-frame-budget-ms(hz), fgl-frame-elapsed-ms(started, finished)));
        def fgl-millisecond-digits(value) = if lt(value, 10) then str_concat("00", int_to_str(value)) else if lt(value, 100) then str_concat("0", int_to_str(value)) else int_to_str(value);
        def fgl-sleep-ms-command(milliseconds) = str_concat("/bin/sleep ", str_concat(int_to_str(div(milliseconds, 1000)), str_concat(".", fgl-millisecond-digits(mod(milliseconds, 1000)))));
        def fgl-sleep-ms(milliseconds) = if le(milliseconds, 0) then "deadline-reached" else int_to_str(host_sleep_ms(milliseconds));
        def fgl-sleep-hz(hz) = fgl-sleep-ms(fgl-frame-budget-ms(hz));
        // the wait door (FGELWaitDoor): the rest is host_sleep_ms over the frames whose seq words can end it early --
        // the control inbox first (a wake there presents at once), then every publisher in the roster (a wake there
        // stages a frame and the deadline presents it). Frames are opened for the rest and released after it.
        def fgl-wait-inbox-name() = fgtm-space(FGLRoot(), fgtm-control-frame(FGLControlChannel(), FGTMInboxSuffix()));
        def fgl-wait-frame-names(roster) = cons(fgl-wait-inbox-name(), fgl-wait-publisher-names(roster));
        def fgl-wait-publisher-names(roster) = if eq(len(roster), 0) then list() else cons(fgtm-space(FGLRoot(), head(roster)), fgl-wait-publisher-names(tail(roster)));
        def fgl-wait-open(names) = if eq(len(names), 0) then list() else cons(ggf-receive(head(names)), fgl-wait-open(tail(names)));
        def fgl-wait-live-handles(handles) = if eq(len(handles), 0) then list() else if nothing?(head(handles)) then fgl-wait-live-handles(tail(handles)) else cons(head(handles), fgl-wait-live-handles(tail(handles)));
        def fgl-wait-live-names(names, handles) = if eq(len(handles), 0) then list() else if nothing?(head(handles)) then fgl-wait-live-names(tail(names), tail(handles)) else cons(head(names), fgl-wait-live-names(tail(names), tail(handles)));
        def fgl-wait-rest(ms, handles) = if le(ms, 0) then list(0, -1, 0, list()) else host_sleep_ms(cons(ms, fgl-wait-live-handles(handles)));
        def fgl-wait-release(handles) = if eq(len(handles), 0) then 0 else add(ggf-release(head(handles)), fgl-wait-release(tail(handles)));
        // ---- the kept frames: every frame the loop takes or gives each tick, opened once and held for the loop's life (ggf-kept-*) ----
        // The wants are the control inbox, the jit publisher, every roster publisher, the six sensor frames and the glass's own
        // give frames. They are ensured on the first tick and at the roster cadence (every tenth tick), when an absent frame is
        // asked for again and a frame no want names any more is released; between those ticks a handle is only looked up.
        def fgl-kept-sensor-wants(sensors) = if eq(len(sensors), 0) then list() else cons(list(fgsr-publisher(head(sensors)), "take", 0), fgl-kept-sensor-wants(tail(sensors)));
        def fgl-kept-wants(roster) = append(list(list(fgl-wait-inbox-name(), "take", 0), list(fgtm-space(FGLRoot(), FGLJitPublisher()), "take", 0), list(fgsr-publisher("glass"), "give", FGSRFrameBytes()), list(fgl-last-name("cadence"), "give", 65536), list(fgl-last-name("flow-point"), "give", 65536)), append(fgl-kept-sensor-wants(list("host", "machine", "owner", "queue", "storage", "glass", "ear")), fgtm-roster-wants(FGLRoot(), roster)));
        def fgl-kept-refresh(kept, roster) {
